{
  "expo": {
    "name": "shahname",
    "slug": "shahname",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "shahname",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo.png",
        "backgroundColor": "#f0bf7d"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.aliaslani.mm.shahname"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Logo.png",
      "splash": {
        "image": "./assets/images/Logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#f0bf7d"
      },
      "pwa": {
        "name": "مسیر خرد",
        "shortName": "مسیر خرد",
        "themeColor": "#f0bf7d",
        "backgroundColor": "#f0bf7d",
        "display": "standalone",
        "scope": "/",
        "startUrl": "/",
        "preferRelatedApplications": true
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#f0bf7d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "045d8b5e-39fe-4e7e-b966-c6f556c1b74c"
      }
    }
  }
}
