[
  {
    "poem_id": 1415,
    "vorder": 1,
    "position": 0,
    "text": "فرستاده نزدیک دستان رسید"
  },
  {
    "poem_id": 1415,
    "vorder": 2,
    "position": 1,
    "text": "به کردار آتش دلش بردمید"
  },
  {
    "poem_id": 1415,
    "vorder": 3,
    "position": 0,
    "text": "سوی گرد مهراب بنهاد روی"
  },
  {
    "poem_id": 1415,
    "vorder": 4,
    "position": 1,
    "text": "همی تاخت با لشکری جنگجوی"
  },
  {
    "poem_id": 1415,
    "vorder": 5,
    "position": 0,
    "text": "چو مهراب را پای بر جای دید"
  },
  {
    "poem_id": 1415,
    "vorder": 6,
    "position": 1,
    "text": "به سرش اندرون دانش و رای دید"
  },
  {
    "poem_id": 1415,
    "vorder": 7,
    "position": 0,
    "text": "به دل گفت کاکنون ز لشکر چه باک"
  },
  {
    "poem_id": 1415,
    "vorder": 8,
    "position": 1,
    "text": "چه پیشم خزروان چه یک مشت خاک"
  },
  {
    "poem_id": 1415,
    "vorder": 9,
    "position": 0,
    "text": "پس آنگه سوی شهر بنهاد روی"
  },
  {
    "poem_id": 1415,
    "vorder": 10,
    "position": 1,
    "text": "چو آمد به شهر اندرون نامجوی"
  },
  {
    "poem_id": 1415,
    "vorder": 11,
    "position": 0,
    "text": "به مهراب گفت ای هشیوار مرد"
  },
  {
    "poem_id": 1415,
    "vorder": 12,
    "position": 1,
    "text": "پسندیده اندر همه کارکرد"
  },
  {
    "poem_id": 1415,
    "vorder": 13,
    "position": 0,
    "text": "کنون من شوم در شب تیره‌گون"
  },
  {
    "poem_id": 1415,
    "vorder": 14,
    "position": 1,
    "text": "یکی دست یازم بریشان به خون"
  },
  {
    "poem_id": 1415,
    "vorder": 15,
    "position": 0,
    "text": "شوند آگه از من که بازآمدم"
  },
  {
    "poem_id": 1415,
    "vorder": 16,
    "position": 1,
    "text": "دل آگنده و کینه ساز آمدم"
  },
  {
    "poem_id": 1415,
    "vorder": 17,
    "position": 0,
    "text": "کمانی به بازو در افگند سخت"
  },
  {
    "poem_id": 1415,
    "vorder": 18,
    "position": 1,
    "text": "یکی تیر برسان شاخ درخت"
  },
  {
    "poem_id": 1415,
    "vorder": 19,
    "position": 0,
    "text": "نگه کرد تا جای گردان کجاست"
  },
  {
    "poem_id": 1415,
    "vorder": 20,
    "position": 1,
    "text": "خدنگی به چرخ اندرون راند راست"
  },
  {
    "poem_id": 1415,
    "vorder": 21,
    "position": 0,
    "text": "بینداخت سه جای سه چوبه تیر"
  },
  {
    "poem_id": 1415,
    "vorder": 22,
    "position": 1,
    "text": "برآمد خروشیدن دار و گیر"
  },
  {
    "poem_id": 1415,
    "vorder": 23,
    "position": 0,
    "text": "چو شب روز شد انجمن شد سپاه"
  },
  {
    "poem_id": 1415,
    "vorder": 24,
    "position": 1,
    "text": "بران تیر کردند هر کس نگاه"
  },
  {
    "poem_id": 1415,
    "vorder": 25,
    "position": 0,
    "text": "بگفتند کاین تیر زالست و بس"
  },
  {
    "poem_id": 1415,
    "vorder": 26,
    "position": 1,
    "text": "نراند چنین در کمان تیر کس"
  },
  {
    "poem_id": 1415,
    "vorder": 27,
    "position": 0,
    "text": "چو خورشید تابان ز بالا بگشت"
  },
  {
    "poem_id": 1415,
    "vorder": 28,
    "position": 1,
    "text": "خروش تبیره برآمد ز دشت"
  },
  {
    "poem_id": 1415,
    "vorder": 29,
    "position": 0,
    "text": "به شهر اندرون کوس با کرنای"
  },
  {
    "poem_id": 1415,
    "vorder": 30,
    "position": 1,
    "text": "خروشیدن زنگ و هندی درای"
  },
  {
    "poem_id": 1415,
    "vorder": 31,
    "position": 0,
    "text": "برآمد سپه را به هامون کشید"
  },
  {
    "poem_id": 1415,
    "vorder": 32,
    "position": 1,
    "text": "سراپرده و پیل بیرون کشید"
  },
  {
    "poem_id": 1415,
    "vorder": 33,
    "position": 0,
    "text": "سپاه اندرآورد پیش سپاه"
  },
  {
    "poem_id": 1415,
    "vorder": 34,
    "position": 1,
    "text": "چو هامون شد از گرد کوه سیاه"
  },
  {
    "poem_id": 1415,
    "vorder": 35,
    "position": 0,
    "text": "خزروان دمان با عمود و سپر"
  },
  {
    "poem_id": 1415,
    "vorder": 36,
    "position": 1,
    "text": "یکی تاختن کرد بر زال زر"
  },
  {
    "poem_id": 1415,
    "vorder": 37,
    "position": 0,
    "text": "عمودی بزد بر بر روشنش"
  },
  {
    "poem_id": 1415,
    "vorder": 38,
    "position": 1,
    "text": "گسسته شد آن نامور جوشنش"
  },
  {
    "poem_id": 1415,
    "vorder": 39,
    "position": 0,
    "text": "چو شد تافته شاه زابلستان"
  },
  {
    "poem_id": 1415,
    "vorder": 40,
    "position": 1,
    "text": "برفتند گردان کابلستان"
  },
  {
    "poem_id": 1415,
    "vorder": 41,
    "position": 0,
    "text": "یکی درع پوشید زال دلیر"
  },
  {
    "poem_id": 1415,
    "vorder": 42,
    "position": 1,
    "text": "به جنگ اندر آمد به کردار شیر"
  },
  {
    "poem_id": 1415,
    "vorder": 43,
    "position": 0,
    "text": "به دست اندرون داشت گُرز پدر"
  },
  {
    "poem_id": 1415,
    "vorder": 44,
    "position": 1,
    "text": "سرش گشته پر خشم و پر خون جگر"
  },
  {
    "poem_id": 1415,
    "vorder": 45,
    "position": 0,
    "text": "بزد بر سرش گُرزهٔ گاورنگ"
  },
  {
    "poem_id": 1415,
    "vorder": 46,
    "position": 1,
    "text": "زمین شد ز خونش چو پشت پلنگ"
  },
  {
    "poem_id": 1415,
    "vorder": 47,
    "position": 0,
    "text": "بیفگند و بسپرد و زو درگذشت"
  },
  {
    "poem_id": 1415,
    "vorder": 48,
    "position": 1,
    "text": "ز پیش سپاه اندر آمد به دشت"
  },
  {
    "poem_id": 1415,
    "vorder": 49,
    "position": 0,
    "text": "شماساس را خواست کاید برون"
  },
  {
    "poem_id": 1415,
    "vorder": 50,
    "position": 1,
    "text": "نیامد برون کش بخوشید خون"
  },
  {
    "poem_id": 1415,
    "vorder": 51,
    "position": 0,
    "text": "به گرد اندرون یافت کلباد را"
  },
  {
    "poem_id": 1415,
    "vorder": 52,
    "position": 1,
    "text": "به گردن برآورد پولاد را"
  },
  {
    "poem_id": 1415,
    "vorder": 53,
    "position": 0,
    "text": "چو شمشیرزن گُرز دستان بدید"
  },
  {
    "poem_id": 1415,
    "vorder": 54,
    "position": 1,
    "text": "همی کرد ازو خویشتن ناپدید"
  },
  {
    "poem_id": 1415,
    "vorder": 55,
    "position": 0,
    "text": "کمان را به زه کرد زال سوار"
  },
  {
    "poem_id": 1415,
    "vorder": 56,
    "position": 1,
    "text": "خدنگی بدو اندرون راند خوار"
  },
  {
    "poem_id": 1415,
    "vorder": 57,
    "position": 0,
    "text": "بزد بر کمربند کلباد بر"
  },
  {
    "poem_id": 1415,
    "vorder": 58,
    "position": 1,
    "text": "بران بند زنجیر پولاد بر"
  },
  {
    "poem_id": 1415,
    "vorder": 59,
    "position": 0,
    "text": "میانش ابا کوههٔ زین بدوخت"
  },
  {
    "poem_id": 1415,
    "vorder": 60,
    "position": 1,
    "text": "سپه را به کلباد بر دل بسوخت"
  },
  {
    "poem_id": 1415,
    "vorder": 61,
    "position": 0,
    "text": "چو این دو سرافگنده شد در نبرد"
  },
  {
    "poem_id": 1415,
    "vorder": 62,
    "position": 1,
    "text": "شماساس شد بی‌دل و روی زرد"
  },
  {
    "poem_id": 1415,
    "vorder": 63,
    "position": 0,
    "text": "شماساس و آن لشکر رزم ساز"
  },
  {
    "poem_id": 1415,
    "vorder": 64,
    "position": 1,
    "text": "پراگنده از رزم گشتند باز"
  },
  {
    "poem_id": 1415,
    "vorder": 65,
    "position": 0,
    "text": "پس اندر دلیران زاولستان"
  },
  {
    "poem_id": 1415,
    "vorder": 66,
    "position": 1,
    "text": "برفتند با شاه کابلستان"
  },
  {
    "poem_id": 1415,
    "vorder": 67,
    "position": 0,
    "text": "چنان شد ز بس کشته در رزمگاه"
  },
  {
    "poem_id": 1415,
    "vorder": 68,
    "position": 1,
    "text": "که گفتی جهان تنگ شد بر سپاه"
  },
  {
    "poem_id": 1415,
    "vorder": 69,
    "position": 0,
    "text": "سوی شاه ترکان نهادند سر"
  },
  {
    "poem_id": 1415,
    "vorder": 70,
    "position": 1,
    "text": "گشاده سلیح و گسسته کمر"
  },
  {
    "poem_id": 1415,
    "vorder": 71,
    "position": 0,
    "text": "شماساس چون در بیابان رسید"
  },
  {
    "poem_id": 1415,
    "vorder": 72,
    "position": 1,
    "text": "ز ره قارن کاوه آمد پدید"
  },
  {
    "poem_id": 1415,
    "vorder": 73,
    "position": 0,
    "text": "که از لشکر ویسه برگشته بود"
  },
  {
    "poem_id": 1415,
    "vorder": 74,
    "position": 1,
    "text": "به خواری گرامیش را کشته بود"
  },
  {
    "poem_id": 1415,
    "vorder": 75,
    "position": 0,
    "text": "به هم بازخوردند هر دو سپاه"
  },
  {
    "poem_id": 1415,
    "vorder": 76,
    "position": 1,
    "text": "شماساس با قارن کینه‌خواه"
  },
  {
    "poem_id": 1415,
    "vorder": 77,
    "position": 0,
    "text": "بدانست قارن که ایشان کیند"
  },
  {
    "poem_id": 1415,
    "vorder": 78,
    "position": 1,
    "text": "ز زاولستان ساخته بر چیند"
  },
  {
    "poem_id": 1415,
    "vorder": 79,
    "position": 0,
    "text": "بزد نای رویین و بگرفت راه"
  },
  {
    "poem_id": 1415,
    "vorder": 80,
    "position": 1,
    "text": "به پیش سپاه اندر آمد سپاه"
  },
  {
    "poem_id": 1415,
    "vorder": 81,
    "position": 0,
    "text": "ازان لشکر خسته و بسته مرد"
  },
  {
    "poem_id": 1415,
    "vorder": 82,
    "position": 1,
    "text": "به خورشید تابان برآورد گرد"
  },
  {
    "poem_id": 1415,
    "vorder": 83,
    "position": 0,
    "text": "گریزان شماساس با چند مرد"
  },
  {
    "poem_id": 1415,
    "vorder": 84,
    "position": 1,
    "text": "برفتند ازان تیره گرد نبرد"
  }
]