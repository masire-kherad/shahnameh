[
  {
    "poem_id": 1727,
    "vorder": 1,
    "position": 0,
    "text": "چو بهرام بنشست بر تخت زر"
  },
  {
    "poem_id": 1727,
    "vorder": 2,
    "position": 1,
    "text": "دل و مغز جوشان ز مرگ پدر"
  },
  {
    "poem_id": 1727,
    "vorder": 3,
    "position": 0,
    "text": "همه نامداران ایرانیان"
  },
  {
    "poem_id": 1727,
    "vorder": 4,
    "position": 1,
    "text": "برفتند پیشش کمر بر میان"
  },
  {
    "poem_id": 1727,
    "vorder": 5,
    "position": 0,
    "text": "برو خواندند آفرین خدای"
  },
  {
    "poem_id": 1727,
    "vorder": 6,
    "position": 1,
    "text": "که تا جای باشد تو مانی به جای"
  },
  {
    "poem_id": 1727,
    "vorder": 7,
    "position": 0,
    "text": "که تاج کیی تارکت را سزاست"
  },
  {
    "poem_id": 1727,
    "vorder": 8,
    "position": 1,
    "text": "پدر بر پدر پادشاهی تراست"
  },
  {
    "poem_id": 1727,
    "vorder": 9,
    "position": 0,
    "text": "رخ بدسگالان تو زرد باد"
  },
  {
    "poem_id": 1727,
    "vorder": 10,
    "position": 1,
    "text": "وزان رفته جان تو بی‌درد باد"
  },
  {
    "poem_id": 1727,
    "vorder": 11,
    "position": 0,
    "text": "چنین داد پاسخ که ای مهتران"
  },
  {
    "poem_id": 1727,
    "vorder": 12,
    "position": 1,
    "text": "سواران جنگی و کنداوران"
  },
  {
    "poem_id": 1727,
    "vorder": 13,
    "position": 0,
    "text": "ز دهقان وز مرد خسروپرست"
  },
  {
    "poem_id": 1727,
    "vorder": 14,
    "position": 1,
    "text": "به گیتی سوی بد میازید دست"
  },
  {
    "poem_id": 1727,
    "vorder": 15,
    "position": 0,
    "text": "بدانید کاین چرخ ناپایدار"
  },
  {
    "poem_id": 1727,
    "vorder": 16,
    "position": 1,
    "text": "نه پرورده داند نه پروردگار"
  },
  {
    "poem_id": 1727,
    "vorder": 17,
    "position": 0,
    "text": "سراسر ببندید دست از هوا"
  },
  {
    "poem_id": 1727,
    "vorder": 18,
    "position": 1,
    "text": "هوا را مدارید فرمانروا"
  },
  {
    "poem_id": 1727,
    "vorder": 19,
    "position": 0,
    "text": "کسی کو بپرهیزد از بدکنش"
  },
  {
    "poem_id": 1727,
    "vorder": 20,
    "position": 1,
    "text": "نیالاید اندر بدیها تنش"
  },
  {
    "poem_id": 1727,
    "vorder": 21,
    "position": 0,
    "text": "بدین سوی همواره خرم بود"
  },
  {
    "poem_id": 1727,
    "vorder": 22,
    "position": 1,
    "text": "گه رفتن آیدش بی‌غم بود"
  },
  {
    "poem_id": 1727,
    "vorder": 23,
    "position": 0,
    "text": "پناهی بود گنج را پادشا"
  },
  {
    "poem_id": 1727,
    "vorder": 24,
    "position": 1,
    "text": "نوازندهٔ مردم پارسا"
  },
  {
    "poem_id": 1727,
    "vorder": 25,
    "position": 0,
    "text": "تن شاه دین را پناهی بود"
  },
  {
    "poem_id": 1727,
    "vorder": 26,
    "position": 1,
    "text": "که دین بر سر او کلاهی بود"
  },
  {
    "poem_id": 1727,
    "vorder": 27,
    "position": 0,
    "text": "خنک آنک در خشم هشیارتر"
  },
  {
    "poem_id": 1727,
    "vorder": 28,
    "position": 1,
    "text": "همان بر زمین او بی‌آزارتر"
  },
  {
    "poem_id": 1727,
    "vorder": 29,
    "position": 0,
    "text": "گه دست تنگی دلی شاد و راد"
  },
  {
    "poem_id": 1727,
    "vorder": 30,
    "position": 1,
    "text": "جهان بی‌تن مرد دانا مباد"
  },
  {
    "poem_id": 1727,
    "vorder": 31,
    "position": 0,
    "text": "چو بر دشمنی بر توانا بود"
  },
  {
    "poem_id": 1727,
    "vorder": 32,
    "position": 1,
    "text": "به پی نسپرد ویژه دانا بود"
  },
  {
    "poem_id": 1727,
    "vorder": 33,
    "position": 0,
    "text": "ستیزه نه نیک آید از نامجوی"
  },
  {
    "poem_id": 1727,
    "vorder": 34,
    "position": 1,
    "text": "بپرهیز و گرد ستیزه مپوی"
  },
  {
    "poem_id": 1727,
    "vorder": 35,
    "position": 0,
    "text": "سپاهی و دهقان و بیکار شاه"
  },
  {
    "poem_id": 1727,
    "vorder": 36,
    "position": 1,
    "text": "چنان دان که هر سه ندارند راه"
  },
  {
    "poem_id": 1727,
    "vorder": 37,
    "position": 0,
    "text": "به خواب اندرست آنک بیکار بود"
  },
  {
    "poem_id": 1727,
    "vorder": 38,
    "position": 1,
    "text": "پشیمان شود پس چو بیدار بود"
  },
  {
    "poem_id": 1727,
    "vorder": 39,
    "position": 0,
    "text": "ز گفتار نیکو و کردار زشت"
  },
  {
    "poem_id": 1727,
    "vorder": 40,
    "position": 1,
    "text": "ستایش نیابی نه خرم بهشت"
  },
  {
    "poem_id": 1727,
    "vorder": 41,
    "position": 0,
    "text": "همه نام جویید و نیکی کنید"
  },
  {
    "poem_id": 1727,
    "vorder": 42,
    "position": 1,
    "text": "دل نیک پی مردمان مشکنید"
  },
  {
    "poem_id": 1727,
    "vorder": 43,
    "position": 0,
    "text": "مرا گنج و دینار بسیار هست"
  },
  {
    "poem_id": 1727,
    "vorder": 44,
    "position": 1,
    "text": "بزرگی و شاهی و نیروی دست"
  },
  {
    "poem_id": 1727,
    "vorder": 45,
    "position": 0,
    "text": "خورید آنک دارید و آن را که نیست"
  },
  {
    "poem_id": 1727,
    "vorder": 46,
    "position": 1,
    "text": "بداند که با گنج ما او یکیست"
  },
  {
    "poem_id": 1727,
    "vorder": 47,
    "position": 0,
    "text": "سر بدرهٔ ما گشادست باز"
  },
  {
    "poem_id": 1727,
    "vorder": 48,
    "position": 1,
    "text": "نباید نشستن کس اندر نیاز"
  }
]