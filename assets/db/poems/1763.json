[
  {
    "poem_id": 1763,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد به بهرام گور"
  },
  {
    "poem_id": 1763,
    "vorder": 2,
    "position": 1,
    "text": "که از چرخ شد تخت را آب شور"
  },
  {
    "poem_id": 1763,
    "vorder": 3,
    "position": 0,
    "text": "پدرت آن سرافراز شاهان بمرد"
  },
  {
    "poem_id": 1763,
    "vorder": 4,
    "position": 1,
    "text": "به مرد و همه نام شاهی ببرد"
  },
  {
    "poem_id": 1763,
    "vorder": 5,
    "position": 0,
    "text": "یکی مرد بر گاه بنشاندند"
  },
  {
    "poem_id": 1763,
    "vorder": 6,
    "position": 1,
    "text": "به شاهی همی خسروش خواندند"
  },
  {
    "poem_id": 1763,
    "vorder": 7,
    "position": 0,
    "text": "بخوردند سوگند یکسر سپاه"
  },
  {
    "poem_id": 1763,
    "vorder": 8,
    "position": 1,
    "text": "کزان تخمه هرگز نخواهیم شاه"
  },
  {
    "poem_id": 1763,
    "vorder": 9,
    "position": 0,
    "text": "که بهرام فرزند او همچو اوست"
  },
  {
    "poem_id": 1763,
    "vorder": 10,
    "position": 1,
    "text": "از آب پدر یافت او مغز و پوست"
  },
  {
    "poem_id": 1763,
    "vorder": 11,
    "position": 0,
    "text": "چو بشنید بهرام رخ را بکند"
  },
  {
    "poem_id": 1763,
    "vorder": 12,
    "position": 1,
    "text": "ز مرگ پدر شد دلش مستمند"
  },
  {
    "poem_id": 1763,
    "vorder": 13,
    "position": 0,
    "text": "برآمد دو هفته ز شهر یمن"
  },
  {
    "poem_id": 1763,
    "vorder": 14,
    "position": 1,
    "text": "خروشیدن کودک و مرد و زن"
  },
  {
    "poem_id": 1763,
    "vorder": 15,
    "position": 0,
    "text": "چو یک ماه بنشست با سوک شاه"
  },
  {
    "poem_id": 1763,
    "vorder": 16,
    "position": 1,
    "text": "سر ماه نو را بیاراست گاه"
  },
  {
    "poem_id": 1763,
    "vorder": 17,
    "position": 0,
    "text": "برفتند نعمان و منذر بهم"
  },
  {
    "poem_id": 1763,
    "vorder": 18,
    "position": 1,
    "text": "همه تازیان یمن بیش و کم"
  },
  {
    "poem_id": 1763,
    "vorder": 19,
    "position": 0,
    "text": "همه زار و با شاه گریان شدند"
  },
  {
    "poem_id": 1763,
    "vorder": 20,
    "position": 1,
    "text": "ابی آتش از درد بریان شدند"
  },
  {
    "poem_id": 1763,
    "vorder": 21,
    "position": 0,
    "text": "زبان برگشادند زان پس ز بند"
  },
  {
    "poem_id": 1763,
    "vorder": 22,
    "position": 1,
    "text": "که ای پرهنر شهریار بلند"
  },
  {
    "poem_id": 1763,
    "vorder": 23,
    "position": 0,
    "text": "همه در جهان خاک را آمدیم"
  },
  {
    "poem_id": 1763,
    "vorder": 24,
    "position": 1,
    "text": "نه جویای تریاک را آمدیم"
  },
  {
    "poem_id": 1763,
    "vorder": 25,
    "position": 0,
    "text": "بمیرد کسی کو ز مادر بزاد"
  },
  {
    "poem_id": 1763,
    "vorder": 26,
    "position": 1,
    "text": "زهش چون ستم بینم و مرگ داد"
  },
  {
    "poem_id": 1763,
    "vorder": 27,
    "position": 0,
    "text": "به منذر چنین گفت بهرام گور"
  },
  {
    "poem_id": 1763,
    "vorder": 28,
    "position": 1,
    "text": "که اکنون چو شد روز ما تار و تور"
  },
  {
    "poem_id": 1763,
    "vorder": 29,
    "position": 0,
    "text": "ازین تخمه گر نام شاهنشهی"
  },
  {
    "poem_id": 1763,
    "vorder": 30,
    "position": 1,
    "text": "گسسته شود بگسلد فرهی"
  },
  {
    "poem_id": 1763,
    "vorder": 31,
    "position": 0,
    "text": "ز دشت سواران برآرند خاک"
  },
  {
    "poem_id": 1763,
    "vorder": 32,
    "position": 1,
    "text": "شود جای بر تازیان بر مغاک"
  },
  {
    "poem_id": 1763,
    "vorder": 33,
    "position": 0,
    "text": "پراندیشه باشید و یاری کنید"
  },
  {
    "poem_id": 1763,
    "vorder": 34,
    "position": 1,
    "text": "به مرگ پدر سوگواری کنید"
  },
  {
    "poem_id": 1763,
    "vorder": 35,
    "position": 0,
    "text": "ز بهرام بشنید منذر سخن"
  },
  {
    "poem_id": 1763,
    "vorder": 36,
    "position": 1,
    "text": "به مردی یکی پاسخ افگند بن"
  },
  {
    "poem_id": 1763,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت کاین روزگار منست"
  },
  {
    "poem_id": 1763,
    "vorder": 38,
    "position": 1,
    "text": "برین دشت روز شکار منست"
  },
  {
    "poem_id": 1763,
    "vorder": 39,
    "position": 0,
    "text": "تو بر تخت بنشین و نظاره باش"
  },
  {
    "poem_id": 1763,
    "vorder": 40,
    "position": 1,
    "text": "همه ساله با تاج و با یاره باش"
  },
  {
    "poem_id": 1763,
    "vorder": 41,
    "position": 0,
    "text": "همه نامداران برین هم‌سخن"
  },
  {
    "poem_id": 1763,
    "vorder": 42,
    "position": 1,
    "text": "که نعمان و منذر فگندند بن"
  },
  {
    "poem_id": 1763,
    "vorder": 43,
    "position": 0,
    "text": "ز پیش جهانجوی برخاستند"
  },
  {
    "poem_id": 1763,
    "vorder": 44,
    "position": 1,
    "text": "همه تاختن را بیاراستند"
  },
  {
    "poem_id": 1763,
    "vorder": 45,
    "position": 0,
    "text": "بفرمود منذر به نعمان که رو"
  },
  {
    "poem_id": 1763,
    "vorder": 46,
    "position": 1,
    "text": "یکی لشکری ساز شیران نو"
  },
  {
    "poem_id": 1763,
    "vorder": 47,
    "position": 0,
    "text": "ز شیبان و از قیسیان ده هزار"
  },
  {
    "poem_id": 1763,
    "vorder": 48,
    "position": 1,
    "text": "فرازآر گرد از در کارزار"
  },
  {
    "poem_id": 1763,
    "vorder": 49,
    "position": 0,
    "text": "من ایرانیان را نمایم که شاه"
  },
  {
    "poem_id": 1763,
    "vorder": 50,
    "position": 1,
    "text": "کدامست با تاج و گنج و سپاه"
  },
  {
    "poem_id": 1763,
    "vorder": 51,
    "position": 0,
    "text": "بیاورد نعمان سپاهی گران"
  },
  {
    "poem_id": 1763,
    "vorder": 52,
    "position": 1,
    "text": "همه تیغ‌داران و نیزه‌وران"
  },
  {
    "poem_id": 1763,
    "vorder": 53,
    "position": 0,
    "text": "بفرمود تا تاختنها برند"
  },
  {
    "poem_id": 1763,
    "vorder": 54,
    "position": 1,
    "text": "همه روی کشور به پی بسپرند"
  },
  {
    "poem_id": 1763,
    "vorder": 55,
    "position": 0,
    "text": "ره شورستان تا در طیسفون"
  },
  {
    "poem_id": 1763,
    "vorder": 56,
    "position": 1,
    "text": "زمین خیره شد زیر نعل اندرون"
  },
  {
    "poem_id": 1763,
    "vorder": 57,
    "position": 0,
    "text": "زن و کودک و مرد بردند اسیر"
  },
  {
    "poem_id": 1763,
    "vorder": 58,
    "position": 1,
    "text": "کس آن رنجها را نبد دستگیر"
  },
  {
    "poem_id": 1763,
    "vorder": 59,
    "position": 0,
    "text": "پر از غارت و سوختن شد جهان"
  },
  {
    "poem_id": 1763,
    "vorder": 60,
    "position": 1,
    "text": "چو بیکار شد تخت شاهنشهان"
  },
  {
    "poem_id": 1763,
    "vorder": 61,
    "position": 0,
    "text": "پس آگاهی آمد به روم و به چین"
  },
  {
    "poem_id": 1763,
    "vorder": 62,
    "position": 1,
    "text": "به ترک و به هند و به مکران زمین"
  },
  {
    "poem_id": 1763,
    "vorder": 63,
    "position": 0,
    "text": "که شد تخت ایران ز خسرو تهی"
  },
  {
    "poem_id": 1763,
    "vorder": 64,
    "position": 1,
    "text": "کسی نیست زیبای شاهنشهی"
  },
  {
    "poem_id": 1763,
    "vorder": 65,
    "position": 0,
    "text": "همه تاختن را بیاراستند"
  },
  {
    "poem_id": 1763,
    "vorder": 66,
    "position": 1,
    "text": "به بیدادی از جای برخاستند"
  },
  {
    "poem_id": 1763,
    "vorder": 67,
    "position": 0,
    "text": "چو از تخم شاهنشهان کس نبود"
  },
  {
    "poem_id": 1763,
    "vorder": 68,
    "position": 1,
    "text": "که یارست تخت کیی را بسود"
  },
  {
    "poem_id": 1763,
    "vorder": 69,
    "position": 0,
    "text": "به ایران همی هرکسی دست آخت"
  },
  {
    "poem_id": 1763,
    "vorder": 70,
    "position": 1,
    "text": "به شاهنشهی تیز گردن فراخت"
  }
]