[
  {
    "poem_id": 1465,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاه شد دختر گژدهم"
  },
  {
    "poem_id": 1465,
    "vorder": 2,
    "position": 1,
    "text": "که سالار آن انجمن گشت کم"
  },
  {
    "poem_id": 1465,
    "vorder": 3,
    "position": 0,
    "text": "زنی بود برسان گردی سوار"
  },
  {
    "poem_id": 1465,
    "vorder": 4,
    "position": 1,
    "text": "همیشه به جنگ اندرون نامدار"
  },
  {
    "poem_id": 1465,
    "vorder": 5,
    "position": 0,
    "text": "کجا نام او بود گردآفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 6,
    "position": 1,
    "text": "زمانه ز مادر چنین ناورید"
  },
  {
    "poem_id": 1465,
    "vorder": 7,
    "position": 0,
    "text": "چنان ننگش آمد ز کار هجیر"
  },
  {
    "poem_id": 1465,
    "vorder": 8,
    "position": 1,
    "text": "که شد لاله رنگش به کردار قیر"
  },
  {
    "poem_id": 1465,
    "vorder": 9,
    "position": 0,
    "text": "بپوشید درع سواران جنگ"
  },
  {
    "poem_id": 1465,
    "vorder": 10,
    "position": 1,
    "text": "نبود اندر آن کار جای درنگ"
  },
  {
    "poem_id": 1465,
    "vorder": 11,
    "position": 0,
    "text": "نهان کرد گیسو به زیر زره"
  },
  {
    "poem_id": 1465,
    "vorder": 12,
    "position": 1,
    "text": "بزد بر سر ترگ رومی گره"
  },
  {
    "poem_id": 1465,
    "vorder": 13,
    "position": 0,
    "text": "فرود آمد از دژ به کردار شیر"
  },
  {
    "poem_id": 1465,
    "vorder": 14,
    "position": 1,
    "text": "کمر بر میان بادپایی به زیر"
  },
  {
    "poem_id": 1465,
    "vorder": 15,
    "position": 0,
    "text": "به پیش سپاه اندر آمد چو گرد"
  },
  {
    "poem_id": 1465,
    "vorder": 16,
    "position": 1,
    "text": "چو رعد خروشان یکی ویله کرد"
  },
  {
    "poem_id": 1465,
    "vorder": 17,
    "position": 0,
    "text": "که گردان کدامند و جنگ‌آوران"
  },
  {
    "poem_id": 1465,
    "vorder": 18,
    "position": 1,
    "text": "دلیران و کارآزموده سران"
  },
  {
    "poem_id": 1465,
    "vorder": 19,
    "position": 0,
    "text": "چو سهراب شیراوژن او را بدید"
  },
  {
    "poem_id": 1465,
    "vorder": 20,
    "position": 1,
    "text": "بخندید و لب را به دندان گزید"
  },
  {
    "poem_id": 1465,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت کامد دگر باره گور"
  },
  {
    "poem_id": 1465,
    "vorder": 22,
    "position": 1,
    "text": "به دام خداوند شمشیر و زور"
  },
  {
    "poem_id": 1465,
    "vorder": 23,
    "position": 0,
    "text": "بپوشید خفتان و بر سر نهاد"
  },
  {
    "poem_id": 1465,
    "vorder": 24,
    "position": 1,
    "text": "یکی ترگ چینی به کردار باد"
  },
  {
    "poem_id": 1465,
    "vorder": 25,
    "position": 0,
    "text": "بیامد دمان پیش گرد آفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 26,
    "position": 1,
    "text": "چو دخت کمندافگن او را بدید"
  },
  {
    "poem_id": 1465,
    "vorder": 27,
    "position": 0,
    "text": "کمان را بزه کرد و بگشاد بر"
  },
  {
    "poem_id": 1465,
    "vorder": 28,
    "position": 1,
    "text": "نبد مرغ را پیش تیرش گذر"
  },
  {
    "poem_id": 1465,
    "vorder": 29,
    "position": 0,
    "text": "به سهراب بر تیر باران گرفت"
  },
  {
    "poem_id": 1465,
    "vorder": 30,
    "position": 1,
    "text": "چپ و راست جنگ سواران گرفت"
  },
  {
    "poem_id": 1465,
    "vorder": 31,
    "position": 0,
    "text": "نگه کرد سهراب و آمدش ننگ"
  },
  {
    "poem_id": 1465,
    "vorder": 32,
    "position": 1,
    "text": "برآشفت و تیز اندر آمد به جنگ"
  },
  {
    "poem_id": 1465,
    "vorder": 33,
    "position": 0,
    "text": "سپر بر سر آورد و بنهاد روی"
  },
  {
    "poem_id": 1465,
    "vorder": 34,
    "position": 1,
    "text": "ز پیگار خون اندر آمد به جوی"
  },
  {
    "poem_id": 1465,
    "vorder": 35,
    "position": 0,
    "text": "چو سهراب را دید گردآفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 36,
    "position": 1,
    "text": "که برسان آتش همی بردمید"
  },
  {
    "poem_id": 1465,
    "vorder": 37,
    "position": 0,
    "text": "کمان بزه را به بازو فگند"
  },
  {
    "poem_id": 1465,
    "vorder": 38,
    "position": 1,
    "text": "سمندش برآمد به ابر بلند"
  },
  {
    "poem_id": 1465,
    "vorder": 39,
    "position": 0,
    "text": "سر نیزه را سوی سهراب کرد"
  },
  {
    "poem_id": 1465,
    "vorder": 40,
    "position": 1,
    "text": "عنان و سنان را پر از تاب کرد"
  },
  {
    "poem_id": 1465,
    "vorder": 41,
    "position": 0,
    "text": "برآشفت سهراب و شد چون پلنگ"
  },
  {
    "poem_id": 1465,
    "vorder": 42,
    "position": 1,
    "text": "چو بدخواه او چاره گر بد به جنگ"
  },
  {
    "poem_id": 1465,
    "vorder": 43,
    "position": 0,
    "text": "عنان برگرایید و برگاشت اسپ"
  },
  {
    "poem_id": 1465,
    "vorder": 44,
    "position": 1,
    "text": "بیامد به کردار آذرگشسپ"
  },
  {
    "poem_id": 1465,
    "vorder": 45,
    "position": 0,
    "text": "زدوده سنان آنگهی درربود"
  },
  {
    "poem_id": 1465,
    "vorder": 46,
    "position": 1,
    "text": "درآمد بدو هم به کردار دود"
  },
  {
    "poem_id": 1465,
    "vorder": 47,
    "position": 0,
    "text": "بزد بر کمربند گردآفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 48,
    "position": 1,
    "text": "زره بر برش یک به یک بردرید"
  },
  {
    "poem_id": 1465,
    "vorder": 49,
    "position": 0,
    "text": "ز زین برگرفتش به کردار گوی"
  },
  {
    "poem_id": 1465,
    "vorder": 50,
    "position": 1,
    "text": "چو چوگان به زخم اندر آید بدوی"
  },
  {
    "poem_id": 1465,
    "vorder": 51,
    "position": 0,
    "text": "چو بر زین بپیچید گرد آفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 52,
    "position": 1,
    "text": "یکی تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 1465,
    "vorder": 53,
    "position": 0,
    "text": "بزد نیزهٔ او به دو نیم کرد"
  },
  {
    "poem_id": 1465,
    "vorder": 54,
    "position": 1,
    "text": "نشست از بر اسپ و برخاست گرد"
  },
  {
    "poem_id": 1465,
    "vorder": 55,
    "position": 0,
    "text": "به آورد با او بسنده نبود"
  },
  {
    "poem_id": 1465,
    "vorder": 56,
    "position": 1,
    "text": "بپیچید ازو روی و برگاشت زود"
  },
  {
    "poem_id": 1465,
    "vorder": 57,
    "position": 0,
    "text": "سپهبد عنان اژدها را سپرد"
  },
  {
    "poem_id": 1465,
    "vorder": 58,
    "position": 1,
    "text": "به خشم از جهان روشنایی ببرد"
  },
  {
    "poem_id": 1465,
    "vorder": 59,
    "position": 0,
    "text": "چو آمد خروشان به تنگ اندرش"
  },
  {
    "poem_id": 1465,
    "vorder": 60,
    "position": 1,
    "text": "بجنبید و برداشت خود از سرش"
  },
  {
    "poem_id": 1465,
    "vorder": 61,
    "position": 0,
    "text": "رها شد ز بند زره موی اوی"
  },
  {
    "poem_id": 1465,
    "vorder": 62,
    "position": 1,
    "text": "درفشان چو خورشید شد روی اوی"
  },
  {
    "poem_id": 1465,
    "vorder": 63,
    "position": 0,
    "text": "بدانست سهراب کاو دخترست"
  },
  {
    "poem_id": 1465,
    "vorder": 64,
    "position": 1,
    "text": "سر و موی او ازدر افسرست"
  },
  {
    "poem_id": 1465,
    "vorder": 65,
    "position": 0,
    "text": "شگفت آمدش گفت از ایران سپاه"
  },
  {
    "poem_id": 1465,
    "vorder": 66,
    "position": 1,
    "text": "چنین دختر آید به آوردگاه"
  },
  {
    "poem_id": 1465,
    "vorder": 67,
    "position": 0,
    "text": "سواران جنگی به روز نبرد"
  },
  {
    "poem_id": 1465,
    "vorder": 68,
    "position": 1,
    "text": "همانا به ابر اندر آرند گرد"
  },
  {
    "poem_id": 1465,
    "vorder": 69,
    "position": 0,
    "text": "ز فتراک بگشاد پیچان کمند"
  },
  {
    "poem_id": 1465,
    "vorder": 70,
    "position": 1,
    "text": "بینداخت و آمد میانش ببند"
  },
  {
    "poem_id": 1465,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت کز من رهایی مجوی"
  },
  {
    "poem_id": 1465,
    "vorder": 72,
    "position": 1,
    "text": "چرا جنگ جویی تو ای ماهروی"
  },
  {
    "poem_id": 1465,
    "vorder": 73,
    "position": 0,
    "text": "نیامد بدامم بسان تو گور"
  },
  {
    "poem_id": 1465,
    "vorder": 74,
    "position": 1,
    "text": "ز چنگم رهایی نیابی مشور"
  },
  {
    "poem_id": 1465,
    "vorder": 75,
    "position": 0,
    "text": "بدانست کاویخت گردآفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 76,
    "position": 1,
    "text": "مر آن را جز از چاره درمان ندید"
  },
  {
    "poem_id": 1465,
    "vorder": 77,
    "position": 0,
    "text": "بدو روی بنمود و گفت ای دلیر"
  },
  {
    "poem_id": 1465,
    "vorder": 78,
    "position": 1,
    "text": "میان دلیران به کردار شیر"
  },
  {
    "poem_id": 1465,
    "vorder": 79,
    "position": 0,
    "text": "دو لشکر نظاره برین جنگ ما"
  },
  {
    "poem_id": 1465,
    "vorder": 80,
    "position": 1,
    "text": "برین گرز و شمشیر و آهنگ ما"
  },
  {
    "poem_id": 1465,
    "vorder": 81,
    "position": 0,
    "text": "کنون من گشایم چنین روی و موی"
  },
  {
    "poem_id": 1465,
    "vorder": 82,
    "position": 1,
    "text": "سپاه تو گردد پر از گفت‌وگوی"
  },
  {
    "poem_id": 1465,
    "vorder": 83,
    "position": 0,
    "text": "که با دختری او به دشت نبرد"
  },
  {
    "poem_id": 1465,
    "vorder": 84,
    "position": 1,
    "text": "بدین سان به ابر اندر آورد گرد"
  },
  {
    "poem_id": 1465,
    "vorder": 85,
    "position": 0,
    "text": "نهانی بسازیم بهتر بود"
  },
  {
    "poem_id": 1465,
    "vorder": 86,
    "position": 1,
    "text": "خرد داشتن کار مهتر بود"
  },
  {
    "poem_id": 1465,
    "vorder": 87,
    "position": 0,
    "text": "ز بهر من آهو ز هر سو مخواه"
  },
  {
    "poem_id": 1465,
    "vorder": 88,
    "position": 1,
    "text": "میان دو صف برکشیده سپاه"
  },
  {
    "poem_id": 1465,
    "vorder": 89,
    "position": 0,
    "text": "کنون لشکر و دژ به فرمان تست"
  },
  {
    "poem_id": 1465,
    "vorder": 90,
    "position": 1,
    "text": "نباید برین آشتی جنگ جست"
  },
  {
    "poem_id": 1465,
    "vorder": 91,
    "position": 0,
    "text": "دژ و گنج و دژبان سراسر تراست"
  },
  {
    "poem_id": 1465,
    "vorder": 92,
    "position": 1,
    "text": "چو آیی بدان ساز کت دل هواست"
  },
  {
    "poem_id": 1465,
    "vorder": 93,
    "position": 0,
    "text": "چو رخساره بنمود سهراب را"
  },
  {
    "poem_id": 1465,
    "vorder": 94,
    "position": 1,
    "text": "ز خوشاب بگشاد عناب را"
  },
  {
    "poem_id": 1465,
    "vorder": 95,
    "position": 0,
    "text": "یکی بوستان بد در اندر بهشت"
  },
  {
    "poem_id": 1465,
    "vorder": 96,
    "position": 1,
    "text": "به بالای او سرو دهقان نکشت"
  },
  {
    "poem_id": 1465,
    "vorder": 97,
    "position": 0,
    "text": "دو چشمش گوزن و دو ابرو کمان"
  },
  {
    "poem_id": 1465,
    "vorder": 98,
    "position": 1,
    "text": "تو گفتی همی بشکفد هر زمان"
  },
  {
    "poem_id": 1465,
    "vorder": 99,
    "position": 0,
    "text": "بدو گفت کاکنون ازین برمگرد"
  },
  {
    "poem_id": 1465,
    "vorder": 100,
    "position": 1,
    "text": "که دیدی مرا روزگار نبرد"
  },
  {
    "poem_id": 1465,
    "vorder": 101,
    "position": 0,
    "text": "برین بارهٔ دژ دل اندر مبند"
  },
  {
    "poem_id": 1465,
    "vorder": 102,
    "position": 1,
    "text": "که این نیست برتر ز ابر بلند"
  },
  {
    "poem_id": 1465,
    "vorder": 103,
    "position": 0,
    "text": "بپای آورد زخم کوپال من"
  },
  {
    "poem_id": 1465,
    "vorder": 104,
    "position": 1,
    "text": "نراندکسی نیزه بر یال من"
  },
  {
    "poem_id": 1465,
    "vorder": 105,
    "position": 0,
    "text": "عنان را بپیچید گرد آفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 106,
    "position": 1,
    "text": "سمند سرافراز بر دژ کشید"
  },
  {
    "poem_id": 1465,
    "vorder": 107,
    "position": 0,
    "text": "همی رفت و سهراب با او به هم"
  },
  {
    "poem_id": 1465,
    "vorder": 108,
    "position": 1,
    "text": "بیامد به درگاه دژ گژدهم"
  },
  {
    "poem_id": 1465,
    "vorder": 109,
    "position": 0,
    "text": "درِ باره بگشاد گرد آفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 110,
    "position": 1,
    "text": "تن خسته و بسته بر دژ کشید"
  },
  {
    "poem_id": 1465,
    "vorder": 111,
    "position": 0,
    "text": "در دژ ببستند و غمگین شدند"
  },
  {
    "poem_id": 1465,
    "vorder": 112,
    "position": 1,
    "text": "پر از غم دل و دیده خونین شدند"
  },
  {
    "poem_id": 1465,
    "vorder": 113,
    "position": 0,
    "text": "ز آزار گردآفرید و هجیر"
  },
  {
    "poem_id": 1465,
    "vorder": 114,
    "position": 1,
    "text": "پر از درد بودند برنا و پیر"
  },
  {
    "poem_id": 1465,
    "vorder": 115,
    "position": 0,
    "text": "بگفتند کای نیکدل شیرزن"
  },
  {
    "poem_id": 1465,
    "vorder": 116,
    "position": 1,
    "text": "پر از غم بد از تو دل انجمن"
  },
  {
    "poem_id": 1465,
    "vorder": 117,
    "position": 0,
    "text": "که هم رزم جستی هم افسون و رنگ"
  },
  {
    "poem_id": 1465,
    "vorder": 118,
    "position": 1,
    "text": "نیامد ز کار تو بر دوده ننگ"
  },
  {
    "poem_id": 1465,
    "vorder": 119,
    "position": 0,
    "text": "بخندید بسیار گرد آفرید"
  },
  {
    "poem_id": 1465,
    "vorder": 120,
    "position": 1,
    "text": "به باره برآمد سپه بنگرید"
  },
  {
    "poem_id": 1465,
    "vorder": 121,
    "position": 0,
    "text": "چو سهراب را دید بر پشت زین"
  },
  {
    "poem_id": 1465,
    "vorder": 122,
    "position": 1,
    "text": "چنین گفت کای شاه ترکان چین"
  },
  {
    "poem_id": 1465,
    "vorder": 123,
    "position": 0,
    "text": "چرا رنجه گشتی کنون بازگرد"
  },
  {
    "poem_id": 1465,
    "vorder": 124,
    "position": 1,
    "text": "هم از آمدن هم ز دشت نبرد"
  },
  {
    "poem_id": 1465,
    "vorder": 125,
    "position": 0,
    "text": "بخندید و او را به افسوس گفت"
  },
  {
    "poem_id": 1465,
    "vorder": 126,
    "position": 1,
    "text": "که ترکان ز ایران نیابند جفت"
  },
  {
    "poem_id": 1465,
    "vorder": 127,
    "position": 0,
    "text": "چنین بود و روزی نبودت ز من"
  },
  {
    "poem_id": 1465,
    "vorder": 128,
    "position": 1,
    "text": "بدین درد غمگین مکن خویشتن"
  },
  {
    "poem_id": 1465,
    "vorder": 129,
    "position": 0,
    "text": "همانا که تو خود ز ترکان نه‌ای"
  },
  {
    "poem_id": 1465,
    "vorder": 130,
    "position": 1,
    "text": "که جز بآفرین بزرگان نه‌ای"
  },
  {
    "poem_id": 1465,
    "vorder": 131,
    "position": 0,
    "text": "بدان زور و بازوی و آن کتف و یال"
  },
  {
    "poem_id": 1465,
    "vorder": 132,
    "position": 1,
    "text": "نداری کس از پهلوانان همال"
  },
  {
    "poem_id": 1465,
    "vorder": 133,
    "position": 0,
    "text": "ولیکن چو آگاهی آید به شاه"
  },
  {
    "poem_id": 1465,
    "vorder": 134,
    "position": 1,
    "text": "که آورد گردی ز توران سپاه"
  },
  {
    "poem_id": 1465,
    "vorder": 135,
    "position": 0,
    "text": "شهنشاه و رستم بجنبد ز جای"
  },
  {
    "poem_id": 1465,
    "vorder": 136,
    "position": 1,
    "text": "شما با تهمتن ندارید پای"
  },
  {
    "poem_id": 1465,
    "vorder": 137,
    "position": 0,
    "text": "نماند یکی زنده از لشکرت"
  },
  {
    "poem_id": 1465,
    "vorder": 138,
    "position": 1,
    "text": "ندانم چه آید ز بد بر سرت"
  },
  {
    "poem_id": 1465,
    "vorder": 139,
    "position": 0,
    "text": "دریغ آیدم کاین چنین یال و سفت"
  },
  {
    "poem_id": 1465,
    "vorder": 140,
    "position": 1,
    "text": "همی از پلنگان بباید نهفت"
  },
  {
    "poem_id": 1465,
    "vorder": 141,
    "position": 0,
    "text": "ترا بهتر آید که فرمان کنی"
  },
  {
    "poem_id": 1465,
    "vorder": 142,
    "position": 1,
    "text": "رخ نامور سوی توران کنی"
  },
  {
    "poem_id": 1465,
    "vorder": 143,
    "position": 0,
    "text": "نباشی بس ایمن به بازوی خویش"
  },
  {
    "poem_id": 1465,
    "vorder": 144,
    "position": 1,
    "text": "خورد گاو نادان ز پهلوی خویش"
  },
  {
    "poem_id": 1465,
    "vorder": 145,
    "position": 0,
    "text": "چو بشنید سهراب ننگ آمدش"
  },
  {
    "poem_id": 1465,
    "vorder": 146,
    "position": 1,
    "text": "که آسان همی دژ به چنگ آمدش"
  },
  {
    "poem_id": 1465,
    "vorder": 147,
    "position": 0,
    "text": "به زیر دژ اندر یکی جای بود"
  },
  {
    "poem_id": 1465,
    "vorder": 148,
    "position": 1,
    "text": "کجا دژ بدان جای بر پای بود"
  },
  {
    "poem_id": 1465,
    "vorder": 149,
    "position": 0,
    "text": "به تاراج داد آن همه بوم و رست"
  },
  {
    "poem_id": 1465,
    "vorder": 150,
    "position": 1,
    "text": "به یکبارگی دست بد را بشست"
  },
  {
    "poem_id": 1465,
    "vorder": 151,
    "position": 0,
    "text": "چنین گفت کامروز بیگاه گشت"
  },
  {
    "poem_id": 1465,
    "vorder": 152,
    "position": 1,
    "text": "ز پیگارمان دست کوتاه گشت"
  },
  {
    "poem_id": 1465,
    "vorder": 153,
    "position": 0,
    "text": "برآرم به شبگیر ازین باره گرد"
  },
  {
    "poem_id": 1465,
    "vorder": 154,
    "position": 1,
    "text": "ببینند آسیب روز نبرد"
  }
]