[
  {
    "poem_id": 88105,
    "vorder": 1,
    "position": 0,
    "text": "و زآن پس بخوردند چیزی که بود"
  },
  {
    "poem_id": 88105,
    "vorder": 2,
    "position": 1,
    "text": "ز خوردن سوی خواب رفتند زود"
  },
  {
    "poem_id": 88105,
    "vorder": 3,
    "position": 0,
    "text": "هم آنگه برآمد یکی باد و ابر"
  },
  {
    "poem_id": 88105,
    "vorder": 4,
    "position": 1,
    "text": "هوا گشت بر سان چشم هژبر"
  },
  {
    "poem_id": 88105,
    "vorder": 5,
    "position": 0,
    "text": "چو برف از زمین بادبان برکشید"
  },
  {
    "poem_id": 88105,
    "vorder": 6,
    "position": 1,
    "text": "نبد نیزهٔ نامداران پدید"
  },
  {
    "poem_id": 88105,
    "vorder": 7,
    "position": 0,
    "text": "یکایک به برف اندرون ماندند"
  },
  {
    "poem_id": 88105,
    "vorder": 8,
    "position": 1,
    "text": "ندانم بدان جای چون ماندند"
  },
  {
    "poem_id": 88105,
    "vorder": 9,
    "position": 0,
    "text": "زمانی تپیدند در زیر برف"
  },
  {
    "poem_id": 88105,
    "vorder": 10,
    "position": 1,
    "text": "یکی چاه شد کنده هر جای ژرف"
  },
  {
    "poem_id": 88105,
    "vorder": 11,
    "position": 0,
    "text": "نماند ایچ کس را از ایشان توان"
  },
  {
    "poem_id": 88105,
    "vorder": 12,
    "position": 1,
    "text": "برآمد به فرجام شیرین روان"
  },
  {
    "poem_id": 88105,
    "vorder": 13,
    "position": 0,
    "text": "همی بود رستم بر آن کوهسار"
  },
  {
    "poem_id": 88105,
    "vorder": 14,
    "position": 1,
    "text": "همان زال و گودرز و چندی سوار"
  },
  {
    "poem_id": 88105,
    "vorder": 15,
    "position": 0,
    "text": "بدان کوه بودند یکسر سه روز"
  },
  {
    "poem_id": 88105,
    "vorder": 16,
    "position": 1,
    "text": "چهارم چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 88105,
    "vorder": 17,
    "position": 0,
    "text": "بگفتند کاین کار شد با درنگ"
  },
  {
    "poem_id": 88105,
    "vorder": 18,
    "position": 1,
    "text": "چنین چند باشیم بر کوه و سنگ"
  },
  {
    "poem_id": 88105,
    "vorder": 19,
    "position": 0,
    "text": "اگر شاه شد از جهان ناپدید"
  },
  {
    "poem_id": 88105,
    "vorder": 20,
    "position": 1,
    "text": "چو باد هوا از میان بردمید"
  },
  {
    "poem_id": 88105,
    "vorder": 21,
    "position": 0,
    "text": "دگر نامداران کجا رفته‌اند"
  },
  {
    "poem_id": 88105,
    "vorder": 22,
    "position": 1,
    "text": "مگر پند خسرو نپذرفته‌اند"
  },
  {
    "poem_id": 88105,
    "vorder": 23,
    "position": 0,
    "text": "ببودند یک هفته بر پشت کوه"
  },
  {
    "poem_id": 88105,
    "vorder": 24,
    "position": 1,
    "text": "سر هفته گشتند یکسر ستوه"
  },
  {
    "poem_id": 88105,
    "vorder": 25,
    "position": 0,
    "text": "بدیشان همه زار و گریان شدند"
  },
  {
    "poem_id": 88105,
    "vorder": 26,
    "position": 1,
    "text": "بر آن آتش درد بریان شدند"
  },
  {
    "poem_id": 88105,
    "vorder": 27,
    "position": 0,
    "text": "همی کند گودرز کشواد موی"
  },
  {
    "poem_id": 88105,
    "vorder": 28,
    "position": 1,
    "text": "همی ریخت آب و همی خست روی"
  },
  {
    "poem_id": 88105,
    "vorder": 29,
    "position": 0,
    "text": "همی گفت گودرز کاین کس ندید"
  },
  {
    "poem_id": 88105,
    "vorder": 30,
    "position": 1,
    "text": "که از تخم کاووس بر من رسید"
  },
  {
    "poem_id": 88105,
    "vorder": 31,
    "position": 0,
    "text": "نبیره پسر داشتم لشکری"
  },
  {
    "poem_id": 88105,
    "vorder": 32,
    "position": 1,
    "text": "جهاندار و بر هر سری افسری"
  },
  {
    "poem_id": 88105,
    "vorder": 33,
    "position": 0,
    "text": "به کین سیاوش همه کشته شد"
  },
  {
    "poem_id": 88105,
    "vorder": 34,
    "position": 1,
    "text": "همه دوده زیر و زبر گشته شد"
  },
  {
    "poem_id": 88105,
    "vorder": 35,
    "position": 0,
    "text": "کنون دیگر از چشم شد ناپدید"
  },
  {
    "poem_id": 88105,
    "vorder": 36,
    "position": 1,
    "text": "که دید این شگفتی که بر من رسید"
  },
  {
    "poem_id": 88105,
    "vorder": 37,
    "position": 0,
    "text": "سخنهای دیرینه دستان بگفت"
  },
  {
    "poem_id": 88105,
    "vorder": 38,
    "position": 1,
    "text": "که با داد یزدان خرد باد جفت"
  },
  {
    "poem_id": 88105,
    "vorder": 39,
    "position": 0,
    "text": "چو از برف پیدا شود راه شاه"
  },
  {
    "poem_id": 88105,
    "vorder": 40,
    "position": 1,
    "text": "مگر بازگردند و یابند راه"
  },
  {
    "poem_id": 88105,
    "vorder": 41,
    "position": 0,
    "text": "نشاید بدین کوه سر بر بدن"
  },
  {
    "poem_id": 88105,
    "vorder": 42,
    "position": 1,
    "text": "خورش نیست ز ایدر بباید شدن"
  },
  {
    "poem_id": 88105,
    "vorder": 43,
    "position": 0,
    "text": "پیاده فرستیم چندی به راه"
  },
  {
    "poem_id": 88105,
    "vorder": 44,
    "position": 1,
    "text": "بیابند روزی نشان سپاه"
  },
  {
    "poem_id": 88105,
    "vorder": 45,
    "position": 0,
    "text": "برفتند زان کوه گریان به درد"
  },
  {
    "poem_id": 88105,
    "vorder": 46,
    "position": 1,
    "text": "همی هر کسی از کسی یاد کرد"
  },
  {
    "poem_id": 88105,
    "vorder": 47,
    "position": 0,
    "text": "ز فرزند و خویشان وز دوستان"
  },
  {
    "poem_id": 88105,
    "vorder": 48,
    "position": 1,
    "text": "و زآن شاه چون سرو در بوستان"
  },
  {
    "poem_id": 88105,
    "vorder": 49,
    "position": 0,
    "text": "جهان را چنین است آیین و دین"
  },
  {
    "poem_id": 88105,
    "vorder": 50,
    "position": 1,
    "text": "نماندست همواره در به گزین"
  },
  {
    "poem_id": 88105,
    "vorder": 51,
    "position": 0,
    "text": "یکی را ز خاک سیه برکشد"
  },
  {
    "poem_id": 88105,
    "vorder": 52,
    "position": 1,
    "text": "یکی را ز تخت کیان درکشد"
  },
  {
    "poem_id": 88105,
    "vorder": 53,
    "position": 0,
    "text": "نه ز این شاد باشد نه ز آن دردمند"
  },
  {
    "poem_id": 88105,
    "vorder": 54,
    "position": 1,
    "text": "چنین است رسم سرای گزند"
  },
  {
    "poem_id": 88105,
    "vorder": 55,
    "position": 0,
    "text": "کجا آن یلان و کیان جهان"
  },
  {
    "poem_id": 88105,
    "vorder": 56,
    "position": 1,
    "text": "از اندیشه دل دور کن تا توان"
  }
]