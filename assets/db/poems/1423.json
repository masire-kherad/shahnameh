[
  {
    "poem_id": 1423,
    "vorder": 1,
    "position": 0,
    "text": "به رستم چنین گفت فرخنده زال"
  },
  {
    "poem_id": 1423,
    "vorder": 2,
    "position": 1,
    "text": "که برگیر کوپال و بفراز یال"
  },
  {
    "poem_id": 1423,
    "vorder": 3,
    "position": 0,
    "text": "برو تازیان تا به البرز کوه"
  },
  {
    "poem_id": 1423,
    "vorder": 4,
    "position": 1,
    "text": "گزین کن یکی لشکر همگروه"
  },
  {
    "poem_id": 1423,
    "vorder": 5,
    "position": 0,
    "text": "ابر کیقباد آفرین کن یکی"
  },
  {
    "poem_id": 1423,
    "vorder": 6,
    "position": 1,
    "text": "مکن پیش او بر درنگ اندکی"
  },
  {
    "poem_id": 1423,
    "vorder": 7,
    "position": 0,
    "text": "به دو هفته باید که ایدر بوی"
  },
  {
    "poem_id": 1423,
    "vorder": 8,
    "position": 1,
    "text": "گه و بیگه از تاختن نغنوی"
  },
  {
    "poem_id": 1423,
    "vorder": 9,
    "position": 0,
    "text": "بگویی که لشکر ترا خواستند"
  },
  {
    "poem_id": 1423,
    "vorder": 10,
    "position": 1,
    "text": "همی تخت شاهی بیاراستند"
  },
  {
    "poem_id": 1423,
    "vorder": 11,
    "position": 0,
    "text": "که در خورد تاج کیان جز تو کس"
  },
  {
    "poem_id": 1423,
    "vorder": 12,
    "position": 1,
    "text": "نبینیم شاها تو فریادرس"
  },
  {
    "poem_id": 1423,
    "vorder": 13,
    "position": 0,
    "text": "تهمتن زمین را به مژگان برفت"
  },
  {
    "poem_id": 1423,
    "vorder": 14,
    "position": 1,
    "text": "کمر برمیان بست و چون باد تفت"
  }
]