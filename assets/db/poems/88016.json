[
  {
    "poem_id": 88016,
    "vorder": 1,
    "position": 0,
    "text": "چو آمد بر شاه کهترنواز"
  },
  {
    "poem_id": 88016,
    "vorder": 2,
    "position": 1,
    "text": "نوان پیش او رفت و بردش نماز"
  },
  {
    "poem_id": 88016,
    "vorder": 3,
    "position": 0,
    "text": "ستایش کنان پیش خسرو دوید"
  },
  {
    "poem_id": 88016,
    "vorder": 4,
    "position": 1,
    "text": "که مهر و ستایش مر او را سزید"
  },
  {
    "poem_id": 88016,
    "vorder": 5,
    "position": 0,
    "text": "برآورد سر آفرین کرد و گفت"
  },
  {
    "poem_id": 88016,
    "vorder": 6,
    "position": 1,
    "text": "مبادت جز از بخت پیروز جفت"
  },
  {
    "poem_id": 88016,
    "vorder": 7,
    "position": 0,
    "text": "چو هرمزد بادت بدین پایگاه"
  },
  {
    "poem_id": 88016,
    "vorder": 8,
    "position": 1,
    "text": "چو بهمن نگهبان فرخ کلاه"
  },
  {
    "poem_id": 88016,
    "vorder": 9,
    "position": 0,
    "text": "همه ساله اردیبهشت هژیر"
  },
  {
    "poem_id": 88016,
    "vorder": 10,
    "position": 1,
    "text": "نگهبان تو با هش و رای پیر"
  },
  {
    "poem_id": 88016,
    "vorder": 11,
    "position": 0,
    "text": "چو شهریورت باد پیروزگر"
  },
  {
    "poem_id": 88016,
    "vorder": 12,
    "position": 1,
    "text": "بنام بزرگی و فر و هنر"
  },
  {
    "poem_id": 88016,
    "vorder": 13,
    "position": 0,
    "text": "سفندارمذ پاسبان تو باد"
  },
  {
    "poem_id": 88016,
    "vorder": 14,
    "position": 1,
    "text": "خرد جان روشن روان تو باد"
  },
  {
    "poem_id": 88016,
    "vorder": 15,
    "position": 0,
    "text": "چو خردادت از یاوران بر دهاد"
  },
  {
    "poem_id": 88016,
    "vorder": 16,
    "position": 1,
    "text": "ز مرداد باش از بر و بوم شاد"
  },
  {
    "poem_id": 88016,
    "vorder": 17,
    "position": 0,
    "text": "دی و اورمزدت خجسته بواد"
  },
  {
    "poem_id": 88016,
    "vorder": 18,
    "position": 1,
    "text": "در هر بدی بر تو بسته بواد"
  },
  {
    "poem_id": 88016,
    "vorder": 19,
    "position": 0,
    "text": "دیت آذر افروز و فرخنده روز"
  },
  {
    "poem_id": 88016,
    "vorder": 20,
    "position": 1,
    "text": "تو شادان و تاج تو گیتی فروز"
  },
  {
    "poem_id": 88016,
    "vorder": 21,
    "position": 0,
    "text": "چو این آفرین کرد رستم بپای"
  },
  {
    "poem_id": 88016,
    "vorder": 22,
    "position": 1,
    "text": "بپرسید و کردش بر خویش جای"
  },
  {
    "poem_id": 88016,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت خسرو درست آمدی"
  },
  {
    "poem_id": 88016,
    "vorder": 24,
    "position": 1,
    "text": "که از جان تو دور بادا بدی"
  },
  {
    "poem_id": 88016,
    "vorder": 25,
    "position": 0,
    "text": "توی پهلوان کیان جهان"
  },
  {
    "poem_id": 88016,
    "vorder": 26,
    "position": 1,
    "text": "نهان آشکار آشکارت نهان"
  },
  {
    "poem_id": 88016,
    "vorder": 27,
    "position": 0,
    "text": "گزین کیانی و پشت سپاه"
  },
  {
    "poem_id": 88016,
    "vorder": 28,
    "position": 1,
    "text": "نگهدار ایران و لشکر پناه"
  },
  {
    "poem_id": 88016,
    "vorder": 29,
    "position": 0,
    "text": "مرا شاد کردی بدیدار خویش"
  },
  {
    "poem_id": 88016,
    "vorder": 30,
    "position": 1,
    "text": "بدین پر هنر جان بیدار خویش"
  },
  {
    "poem_id": 88016,
    "vorder": 31,
    "position": 0,
    "text": "زواره فرامرز و دستان سام"
  },
  {
    "poem_id": 88016,
    "vorder": 32,
    "position": 1,
    "text": "درستند ازیشان چه داری پیام"
  },
  {
    "poem_id": 88016,
    "vorder": 33,
    "position": 0,
    "text": "فرو بود رستم ببوسید تخت"
  },
  {
    "poem_id": 88016,
    "vorder": 34,
    "position": 1,
    "text": "که ای نامور خسرو نیکبخت"
  },
  {
    "poem_id": 88016,
    "vorder": 35,
    "position": 0,
    "text": "ببخت تو هر سه درستند و شاد"
  },
  {
    "poem_id": 88016,
    "vorder": 36,
    "position": 1,
    "text": "انوشه کسی کش کند شاه یاد"
  },
  {
    "poem_id": 88016,
    "vorder": 37,
    "position": 0,
    "text": "بسالار نوبت بفرمود شاه"
  },
  {
    "poem_id": 88016,
    "vorder": 38,
    "position": 1,
    "text": "که گودرز و طوس و گوان را بخواه"
  },
  {
    "poem_id": 88016,
    "vorder": 39,
    "position": 0,
    "text": "در باغ بگشاد سالار بار"
  },
  {
    "poem_id": 88016,
    "vorder": 40,
    "position": 1,
    "text": "نشستنگهی بود بس شاهوار"
  },
  {
    "poem_id": 88016,
    "vorder": 41,
    "position": 0,
    "text": "بفرمود تا تاج زرین و تخت"
  },
  {
    "poem_id": 88016,
    "vorder": 42,
    "position": 1,
    "text": "نهادند زیر گلفشان درخت"
  },
  {
    "poem_id": 88016,
    "vorder": 43,
    "position": 0,
    "text": "همه دیبهٔ خسروانی بباغ"
  },
  {
    "poem_id": 88016,
    "vorder": 44,
    "position": 1,
    "text": "بگسترد و شد گلستان چون چراغ"
  },
  {
    "poem_id": 88016,
    "vorder": 45,
    "position": 0,
    "text": "درختی زدند از بر گاه شاه"
  },
  {
    "poem_id": 88016,
    "vorder": 46,
    "position": 1,
    "text": "کجا سایه گسترد بر تاج و گاه"
  },
  {
    "poem_id": 88016,
    "vorder": 47,
    "position": 0,
    "text": "تنش سیم و شاخش ز یاقوت و زر"
  },
  {
    "poem_id": 88016,
    "vorder": 48,
    "position": 1,
    "text": "برو گونه‌گون خوشه‌های گهر"
  },
  {
    "poem_id": 88016,
    "vorder": 49,
    "position": 0,
    "text": "عقیق و زمرد همه برگ و بار"
  },
  {
    "poem_id": 88016,
    "vorder": 50,
    "position": 1,
    "text": "فروهشته از تاج چون گوشوار"
  },
  {
    "poem_id": 88016,
    "vorder": 51,
    "position": 0,
    "text": "همه بار زرین ترنج و بهی"
  },
  {
    "poem_id": 88016,
    "vorder": 52,
    "position": 1,
    "text": "میان ترنج و بهیها تهی"
  },
  {
    "poem_id": 88016,
    "vorder": 53,
    "position": 0,
    "text": "بدو اندرون مشک سوده بمی"
  },
  {
    "poem_id": 88016,
    "vorder": 54,
    "position": 1,
    "text": "همه پیکرش سفته برسان نی"
  },
  {
    "poem_id": 88016,
    "vorder": 55,
    "position": 0,
    "text": "کرا شاه بر گاه بنشاندی"
  },
  {
    "poem_id": 88016,
    "vorder": 56,
    "position": 1,
    "text": "برو باد ازو مشک بفشاندی"
  },
  {
    "poem_id": 88016,
    "vorder": 57,
    "position": 0,
    "text": "همه میگساران بیپش اندرا"
  },
  {
    "poem_id": 88016,
    "vorder": 58,
    "position": 1,
    "text": "همه بر سران افسر از گوهرا"
  },
  {
    "poem_id": 88016,
    "vorder": 59,
    "position": 0,
    "text": "ز دیبای زربفت چینی قبای"
  },
  {
    "poem_id": 88016,
    "vorder": 60,
    "position": 1,
    "text": "همه پیش گاه سپهبد بپای"
  },
  {
    "poem_id": 88016,
    "vorder": 61,
    "position": 0,
    "text": "همه طوق بربسته و گوشوار"
  },
  {
    "poem_id": 88016,
    "vorder": 62,
    "position": 1,
    "text": "بریشان همه جامه گوهرنگار"
  },
  {
    "poem_id": 88016,
    "vorder": 63,
    "position": 0,
    "text": "همه رخ چو دیبای رومی برنگ"
  },
  {
    "poem_id": 88016,
    "vorder": 64,
    "position": 1,
    "text": "فروزنده عود و خروشنده چنگ"
  },
  {
    "poem_id": 88016,
    "vorder": 65,
    "position": 0,
    "text": "همه دل پر از شادی و می بدست"
  },
  {
    "poem_id": 88016,
    "vorder": 66,
    "position": 1,
    "text": "رخان ارغوانی و نابوده مست"
  },
  {
    "poem_id": 88016,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود تا رستم آمد بتخت"
  },
  {
    "poem_id": 88016,
    "vorder": 68,
    "position": 1,
    "text": "نشست از بر گاه زیر درخت"
  },
  {
    "poem_id": 88016,
    "vorder": 69,
    "position": 0,
    "text": "برستم چنین گفت پس شهریار"
  },
  {
    "poem_id": 88016,
    "vorder": 70,
    "position": 1,
    "text": "که ای نیک پیوند و به روزگار"
  },
  {
    "poem_id": 88016,
    "vorder": 71,
    "position": 0,
    "text": "ز هر بد توی پیش ایران سپر"
  },
  {
    "poem_id": 88016,
    "vorder": 72,
    "position": 1,
    "text": "همیشه چو سیمرغ گسترده پر"
  },
  {
    "poem_id": 88016,
    "vorder": 73,
    "position": 0,
    "text": "چه درگاه ایران چه پیش کیان"
  },
  {
    "poem_id": 88016,
    "vorder": 74,
    "position": 1,
    "text": "همه بر در رنج بندی میان"
  },
  {
    "poem_id": 88016,
    "vorder": 75,
    "position": 0,
    "text": "شناسی تو کردار گودرزیان"
  },
  {
    "poem_id": 88016,
    "vorder": 76,
    "position": 1,
    "text": "به آسانی و رنج و سود و زیان"
  },
  {
    "poem_id": 88016,
    "vorder": 77,
    "position": 0,
    "text": "میان بسته دارند پیشم بپای"
  },
  {
    "poem_id": 88016,
    "vorder": 78,
    "position": 1,
    "text": "همیشه بنیکی مرا رهنمای"
  },
  {
    "poem_id": 88016,
    "vorder": 79,
    "position": 0,
    "text": "بتنها تن گیو کز انجمن"
  },
  {
    "poem_id": 88016,
    "vorder": 80,
    "position": 1,
    "text": "ز هر بد سپر بود در پیش من"
  },
  {
    "poem_id": 88016,
    "vorder": 81,
    "position": 0,
    "text": "چنین غم بدین دوده نامد بنیز"
  },
  {
    "poem_id": 88016,
    "vorder": 82,
    "position": 1,
    "text": "غم و درد فرزند برتر ز چیز"
  },
  {
    "poem_id": 88016,
    "vorder": 83,
    "position": 0,
    "text": "بدین کار گر تو ببندی میان"
  },
  {
    "poem_id": 88016,
    "vorder": 84,
    "position": 1,
    "text": "پذیره نیایدت شیر ژیان"
  },
  {
    "poem_id": 88016,
    "vorder": 85,
    "position": 0,
    "text": "کنون چارهٔ کار بیژن بجوی"
  },
  {
    "poem_id": 88016,
    "vorder": 86,
    "position": 1,
    "text": "که او را ز توران بد آمد بروی"
  },
  {
    "poem_id": 88016,
    "vorder": 87,
    "position": 0,
    "text": "ز گردان و اسبان و شمشیر و گنج"
  },
  {
    "poem_id": 88016,
    "vorder": 88,
    "position": 1,
    "text": "ببر هرچ باید مدار این برنج"
  },
  {
    "poem_id": 88016,
    "vorder": 89,
    "position": 0,
    "text": "چو رستم ز کیخسرو ایدون شنید"
  },
  {
    "poem_id": 88016,
    "vorder": 90,
    "position": 1,
    "text": "زمین را ببوسید و دم درکشید"
  },
  {
    "poem_id": 88016,
    "vorder": 91,
    "position": 0,
    "text": "برو آفرین کرد کای نیک نام"
  },
  {
    "poem_id": 88016,
    "vorder": 92,
    "position": 1,
    "text": "چو خورشید هر جای گسترده کام"
  },
  {
    "poem_id": 88016,
    "vorder": 93,
    "position": 0,
    "text": "ز تو دور بادا دو چشم نیاز"
  },
  {
    "poem_id": 88016,
    "vorder": 94,
    "position": 1,
    "text": "دل بدسگالت بگرم و گداز"
  },
  {
    "poem_id": 88016,
    "vorder": 95,
    "position": 0,
    "text": "توی بر جهان شاه و سالار و کی"
  },
  {
    "poem_id": 88016,
    "vorder": 96,
    "position": 1,
    "text": "کیان جهان مر ترا خاک پی"
  },
  {
    "poem_id": 88016,
    "vorder": 97,
    "position": 0,
    "text": "که چون تو ندیدست یک شاه گاه"
  },
  {
    "poem_id": 88016,
    "vorder": 98,
    "position": 1,
    "text": "نه تابنده خروشید و گردنده ماه"
  },
  {
    "poem_id": 88016,
    "vorder": 99,
    "position": 0,
    "text": "بدان را ز نیکان تو کردی جدا"
  },
  {
    "poem_id": 88016,
    "vorder": 100,
    "position": 1,
    "text": "تو داری بافسون و بند اژدها"
  },
  {
    "poem_id": 88016,
    "vorder": 101,
    "position": 0,
    "text": "بکندم دل دیو مازندران"
  },
  {
    "poem_id": 88016,
    "vorder": 102,
    "position": 1,
    "text": "بفر کیانی و گرز گران"
  },
  {
    "poem_id": 88016,
    "vorder": 103,
    "position": 0,
    "text": "مرامادر از بهر رنج تو زاد"
  },
  {
    "poem_id": 88016,
    "vorder": 104,
    "position": 1,
    "text": "تو باید که باشی بآرام و شاد"
  },
  {
    "poem_id": 88016,
    "vorder": 105,
    "position": 0,
    "text": "منم گوش داده بفرمان تو"
  },
  {
    "poem_id": 88016,
    "vorder": 106,
    "position": 1,
    "text": "نگردم بهرسان ز پیمان تو"
  },
  {
    "poem_id": 88016,
    "vorder": 107,
    "position": 0,
    "text": "دل و جان نهاده بسوی کلاه"
  },
  {
    "poem_id": 88016,
    "vorder": 108,
    "position": 1,
    "text": "بران ره روم کم بفرمود شاه"
  },
  {
    "poem_id": 88016,
    "vorder": 109,
    "position": 0,
    "text": "و نیز از پی گیو اگر بر سرم"
  },
  {
    "poem_id": 88016,
    "vorder": 110,
    "position": 1,
    "text": "هوا بارد آتش بدو ننگرم"
  },
  {
    "poem_id": 88016,
    "vorder": 111,
    "position": 0,
    "text": "رسیده بمژگانم اندر سنان"
  },
  {
    "poem_id": 88016,
    "vorder": 112,
    "position": 1,
    "text": "ز فرمان خسرو نتابم عنان"
  },
  {
    "poem_id": 88016,
    "vorder": 113,
    "position": 0,
    "text": "برآرم ببخت تو این کار کرد"
  },
  {
    "poem_id": 88016,
    "vorder": 114,
    "position": 1,
    "text": "سپهبد نخواهم نه مردان مرد"
  },
  {
    "poem_id": 88016,
    "vorder": 115,
    "position": 0,
    "text": "کلید چنین بند باشد فریب"
  },
  {
    "poem_id": 88016,
    "vorder": 116,
    "position": 1,
    "text": "نه هنگام گرزست و روز نهیب"
  },
  {
    "poem_id": 88016,
    "vorder": 117,
    "position": 0,
    "text": "چو رستم چنین گفت گودرز و گیو"
  },
  {
    "poem_id": 88016,
    "vorder": 118,
    "position": 1,
    "text": "فریبرز و فرهاد و شاپور نیو"
  },
  {
    "poem_id": 88016,
    "vorder": 119,
    "position": 0,
    "text": "بزرگان لشکر برو آفرین"
  },
  {
    "poem_id": 88016,
    "vorder": 120,
    "position": 1,
    "text": "همی خواندند از جهان آفرین"
  },
  {
    "poem_id": 88016,
    "vorder": 121,
    "position": 0,
    "text": "بمی دست بردند با شهریار"
  },
  {
    "poem_id": 88016,
    "vorder": 122,
    "position": 1,
    "text": "گشاده بشادی در نوبهار"
  }
]