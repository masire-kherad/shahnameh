[
  {
    "poem_id": 1821,
    "vorder": 1,
    "position": 0,
    "text": "بیامد یکی مرد مزدک به نام"
  },
  {
    "poem_id": 1821,
    "vorder": 2,
    "position": 1,
    "text": "سخنگوی با دانش و رای و کام"
  },
  {
    "poem_id": 1821,
    "vorder": 3,
    "position": 0,
    "text": "گرانمایه مردی و دانش فروش"
  },
  {
    "poem_id": 1821,
    "vorder": 4,
    "position": 1,
    "text": "قباد دلاور بدو داد گوش"
  },
  {
    "poem_id": 1821,
    "vorder": 5,
    "position": 0,
    "text": "به نزد جهاندار دستور گشت"
  },
  {
    "poem_id": 1821,
    "vorder": 6,
    "position": 1,
    "text": "نگهبان آن گنج و گنجور گشت"
  },
  {
    "poem_id": 1821,
    "vorder": 7,
    "position": 0,
    "text": "ز خشکی خورش تنگ شد در جهان"
  },
  {
    "poem_id": 1821,
    "vorder": 8,
    "position": 1,
    "text": "میان کهان و میان مهان"
  },
  {
    "poem_id": 1821,
    "vorder": 9,
    "position": 0,
    "text": "ز روی هوا ابر شد ناپدید"
  },
  {
    "poem_id": 1821,
    "vorder": 10,
    "position": 1,
    "text": "به ایران کسی برف و باران ندید"
  },
  {
    "poem_id": 1821,
    "vorder": 11,
    "position": 0,
    "text": "مهان جهان بر در کیقباد"
  },
  {
    "poem_id": 1821,
    "vorder": 12,
    "position": 1,
    "text": "همی هر کسی آب و نان کرد یاد"
  },
  {
    "poem_id": 1821,
    "vorder": 13,
    "position": 0,
    "text": "بدیشان چنین گفت مزدک که شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 14,
    "position": 1,
    "text": "نماید شما را به امید راه"
  },
  {
    "poem_id": 1821,
    "vorder": 15,
    "position": 0,
    "text": "دوان اندر آمد بر شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 16,
    "position": 1,
    "text": "چنین گفت کای نامور شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 17,
    "position": 0,
    "text": "به گیتی سخن پرسم از تو یکی"
  },
  {
    "poem_id": 1821,
    "vorder": 18,
    "position": 1,
    "text": "گر ایدون که پاسخ دهی اندکی"
  },
  {
    "poem_id": 1821,
    "vorder": 19,
    "position": 0,
    "text": "قباد سراینده گفتش بگوی"
  },
  {
    "poem_id": 1821,
    "vorder": 20,
    "position": 1,
    "text": "به من تازه کن در سخن آبروی"
  },
  {
    "poem_id": 1821,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت آن کس که مارش گزید"
  },
  {
    "poem_id": 1821,
    "vorder": 22,
    "position": 1,
    "text": "همی از تنش جان بخواهد پرید"
  },
  {
    "poem_id": 1821,
    "vorder": 23,
    "position": 0,
    "text": "یکی دیگری را بود پای زهر"
  },
  {
    "poem_id": 1821,
    "vorder": 24,
    "position": 1,
    "text": "گزیده نیابد ز تریاک بهر"
  },
  {
    "poem_id": 1821,
    "vorder": 25,
    "position": 0,
    "text": "سزای چنین مرد گویی که چیست"
  },
  {
    "poem_id": 1821,
    "vorder": 26,
    "position": 1,
    "text": "که تریاک دارد درم سنگ بیست"
  },
  {
    "poem_id": 1821,
    "vorder": 27,
    "position": 0,
    "text": "چنین داد پاسخ ورا شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 28,
    "position": 1,
    "text": "که خونی‌ست این مرد تریاک‌دار"
  },
  {
    "poem_id": 1821,
    "vorder": 29,
    "position": 0,
    "text": "به خون گزیده ببایدش کشت"
  },
  {
    "poem_id": 1821,
    "vorder": 30,
    "position": 1,
    "text": "به درگاه چون دشمن آمد به مشت"
  },
  {
    "poem_id": 1821,
    "vorder": 31,
    "position": 0,
    "text": "چو بشنید برخاست از پیش شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 32,
    "position": 1,
    "text": "بیامد به نزدیک فریادخواه"
  },
  {
    "poem_id": 1821,
    "vorder": 33,
    "position": 0,
    "text": "بدیشان چنین گفت کز شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 34,
    "position": 1,
    "text": "سخن کردم از هر دری خواستار"
  },
  {
    "poem_id": 1821,
    "vorder": 35,
    "position": 0,
    "text": "بباشید تا بامداد پگاه"
  },
  {
    "poem_id": 1821,
    "vorder": 36,
    "position": 1,
    "text": "نمایم شما را سوی داد راه"
  },
  {
    "poem_id": 1821,
    "vorder": 37,
    "position": 0,
    "text": "برفتند و شبگیر باز آمدند"
  },
  {
    "poem_id": 1821,
    "vorder": 38,
    "position": 1,
    "text": "شخوده رخ و پرگداز آمدند"
  },
  {
    "poem_id": 1821,
    "vorder": 39,
    "position": 0,
    "text": "چو مزدک ز در آن گره را بدید"
  },
  {
    "poem_id": 1821,
    "vorder": 40,
    "position": 1,
    "text": "ز درگه سوی شاه ایران دوید"
  },
  {
    "poem_id": 1821,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت کای شاه پیروزبخت"
  },
  {
    "poem_id": 1821,
    "vorder": 42,
    "position": 1,
    "text": "سخنگوی و بیدار و زیبای تخت"
  },
  {
    "poem_id": 1821,
    "vorder": 43,
    "position": 0,
    "text": "سخن گفتم و پاسخش دادی‌ام"
  },
  {
    "poem_id": 1821,
    "vorder": 44,
    "position": 1,
    "text": "به پاسخ در بسته بگشادی‌ام"
  },
  {
    "poem_id": 1821,
    "vorder": 45,
    "position": 0,
    "text": "گر ایدون که دستور باشد کنون"
  },
  {
    "poem_id": 1821,
    "vorder": 46,
    "position": 1,
    "text": "بگوید سخن پیش تو رهنمون"
  },
  {
    "poem_id": 1821,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت برگوی و لب را مبند"
  },
  {
    "poem_id": 1821,
    "vorder": 48,
    "position": 1,
    "text": "که گفتار باشد مرا سودمند"
  },
  {
    "poem_id": 1821,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت کای نامور شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 50,
    "position": 1,
    "text": "کسی را که بندی به بند استوار"
  },
  {
    "poem_id": 1821,
    "vorder": 51,
    "position": 0,
    "text": "خورش بازگیرند زو تا بمرد"
  },
  {
    "poem_id": 1821,
    "vorder": 52,
    "position": 1,
    "text": "به بیچارگی جان و تن را سپرد"
  },
  {
    "poem_id": 1821,
    "vorder": 53,
    "position": 0,
    "text": "مکافات آن کس که نان داشت او"
  },
  {
    "poem_id": 1821,
    "vorder": 54,
    "position": 1,
    "text": "مر این بسته را خوار بگذاشت او"
  },
  {
    "poem_id": 1821,
    "vorder": 55,
    "position": 0,
    "text": "چه باشد بگوید مرا پادشا؟"
  },
  {
    "poem_id": 1821,
    "vorder": 56,
    "position": 1,
    "text": "که این مرد دانا بد و پارسا"
  },
  {
    "poem_id": 1821,
    "vorder": 57,
    "position": 0,
    "text": "چنین داد پاسخ که می‌کن بنش"
  },
  {
    "poem_id": 1821,
    "vorder": 58,
    "position": 1,
    "text": "که خونی‌ست ناکرده بر گردنش"
  },
  {
    "poem_id": 1821,
    "vorder": 59,
    "position": 0,
    "text": "چو بشنید مزدک زمین بوس داد"
  },
  {
    "poem_id": 1821,
    "vorder": 60,
    "position": 1,
    "text": "خرامان بیامد ز پیش قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 61,
    "position": 0,
    "text": "به درگاه او شد به انبوه گفت"
  },
  {
    "poem_id": 1821,
    "vorder": 62,
    "position": 1,
    "text": "که جایی که گندم بود در نهفت"
  },
  {
    "poem_id": 1821,
    "vorder": 63,
    "position": 0,
    "text": "دهید آن به تاراج در کوی و شهر"
  },
  {
    "poem_id": 1821,
    "vorder": 64,
    "position": 1,
    "text": "بدان تا یکایک بیابید بهر"
  },
  {
    "poem_id": 1821,
    "vorder": 65,
    "position": 0,
    "text": "دویدند هرکس که بد گُرسِنِه"
  },
  {
    "poem_id": 1821,
    "vorder": 66,
    "position": 1,
    "text": "به تاراج گندم شدند از بنِه"
  },
  {
    "poem_id": 1821,
    "vorder": 67,
    "position": 0,
    "text": "چه انبار شهری چه آنِ قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 68,
    "position": 1,
    "text": "ز یک دانه گندم نبودند شاد"
  },
  {
    "poem_id": 1821,
    "vorder": 69,
    "position": 0,
    "text": "چو دیدند رفتند کارآگهان"
  },
  {
    "poem_id": 1821,
    "vorder": 70,
    "position": 1,
    "text": "به نزدیک بیدار شاه جهان"
  },
  {
    "poem_id": 1821,
    "vorder": 71,
    "position": 0,
    "text": "که تاراج کردند انبار شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 72,
    "position": 1,
    "text": "به مزدک همی‌بازگردد گناه"
  },
  {
    "poem_id": 1821,
    "vorder": 73,
    "position": 0,
    "text": "قباد آن سخن‌گوی را پیش خواند"
  },
  {
    "poem_id": 1821,
    "vorder": 74,
    "position": 1,
    "text": "ز تاراج انبار چندی براند"
  },
  {
    "poem_id": 1821,
    "vorder": 75,
    "position": 0,
    "text": "چنین داد پاسخ کانوشه بدی"
  },
  {
    "poem_id": 1821,
    "vorder": 76,
    "position": 1,
    "text": "خرد را به گفتار توشه بدی"
  },
  {
    "poem_id": 1821,
    "vorder": 77,
    "position": 0,
    "text": "سخن هرچه بشنیدم از شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 78,
    "position": 1,
    "text": "بگفتم به بازاریان خوارخوار"
  },
  {
    "poem_id": 1821,
    "vorder": 79,
    "position": 0,
    "text": "به شاه جهان گفتم از مار و زهر"
  },
  {
    "poem_id": 1821,
    "vorder": 80,
    "position": 1,
    "text": "از آن کس که تریاک دارد به شهر"
  },
  {
    "poem_id": 1821,
    "vorder": 81,
    "position": 0,
    "text": "بدین بنده پاسخ چنین داد شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 82,
    "position": 1,
    "text": "که تریاک‌دارست مرد گناه"
  },
  {
    "poem_id": 1821,
    "vorder": 83,
    "position": 0,
    "text": "اگر خون این مرد تریاک‌دار"
  },
  {
    "poem_id": 1821,
    "vorder": 84,
    "position": 1,
    "text": "بریزد کسی نیست با او شمار"
  },
  {
    "poem_id": 1821,
    "vorder": 85,
    "position": 0,
    "text": "چو شد گرسنه نان بود پای زهر"
  },
  {
    "poem_id": 1821,
    "vorder": 86,
    "position": 1,
    "text": "به سیری نخواهد ز تریاک بهر"
  },
  {
    "poem_id": 1821,
    "vorder": 87,
    "position": 0,
    "text": "اگر دادگر باشی ای شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 88,
    "position": 1,
    "text": "به انبار گندم نیاید به کار"
  },
  {
    "poem_id": 1821,
    "vorder": 89,
    "position": 0,
    "text": "شکم گرسنه چند مردم بمرد"
  },
  {
    "poem_id": 1821,
    "vorder": 90,
    "position": 1,
    "text": "که انبار را سود جانش نبرد"
  },
  {
    "poem_id": 1821,
    "vorder": 91,
    "position": 0,
    "text": "ز گفتار او تنگ‌دل شد قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 92,
    "position": 1,
    "text": "بشد تیز مغزش ز گفتار داد"
  },
  {
    "poem_id": 1821,
    "vorder": 93,
    "position": 0,
    "text": "وز آن پس بپرسید و پاسخ شنید"
  },
  {
    "poem_id": 1821,
    "vorder": 94,
    "position": 1,
    "text": "دل و جان او پر ز گفتار دید"
  },
  {
    "poem_id": 1821,
    "vorder": 95,
    "position": 0,
    "text": "ز چیزی که گفتند پیغمبران"
  },
  {
    "poem_id": 1821,
    "vorder": 96,
    "position": 1,
    "text": "همان دادگر موبدان و ردان"
  },
  {
    "poem_id": 1821,
    "vorder": 97,
    "position": 0,
    "text": "به گفتار مزدک همه کژ گشت"
  },
  {
    "poem_id": 1821,
    "vorder": 98,
    "position": 1,
    "text": "سخنهاش ز اندازه اندر گذشت"
  },
  {
    "poem_id": 1821,
    "vorder": 99,
    "position": 0,
    "text": "بر او انجمن شد فراوان سپاه"
  },
  {
    "poem_id": 1821,
    "vorder": 100,
    "position": 1,
    "text": "بسی کس به بیراهی آمد ز راه"
  },
  {
    "poem_id": 1821,
    "vorder": 101,
    "position": 0,
    "text": "همی‌گفت هر کاو توانگر بود"
  },
  {
    "poem_id": 1821,
    "vorder": 102,
    "position": 1,
    "text": "تهیدست با او برابر بود"
  },
  {
    "poem_id": 1821,
    "vorder": 103,
    "position": 0,
    "text": "نباید که باشد کسی برفزود"
  },
  {
    "poem_id": 1821,
    "vorder": 104,
    "position": 1,
    "text": "توانگر بود تار و درویش پود"
  },
  {
    "poem_id": 1821,
    "vorder": 105,
    "position": 0,
    "text": "جهان راست باید که باشد به چیز"
  },
  {
    "poem_id": 1821,
    "vorder": 106,
    "position": 1,
    "text": "فزونی توانگر چرا جست نیز"
  },
  {
    "poem_id": 1821,
    "vorder": 107,
    "position": 0,
    "text": "زن و خانه و چیز بخشیدنی‌ست"
  },
  {
    "poem_id": 1821,
    "vorder": 108,
    "position": 1,
    "text": "تهی‌دست کس با توانگر یکی‌ست"
  },
  {
    "poem_id": 1821,
    "vorder": 109,
    "position": 0,
    "text": "من این را کنم راست با دین پاک"
  },
  {
    "poem_id": 1821,
    "vorder": 110,
    "position": 1,
    "text": "شود ویژه پیدا بلند از مغاک"
  },
  {
    "poem_id": 1821,
    "vorder": 111,
    "position": 0,
    "text": "هر آن کس که او جز بر این دین بود"
  },
  {
    "poem_id": 1821,
    "vorder": 112,
    "position": 1,
    "text": "ز یزدان وز منش نفرین بود"
  },
  {
    "poem_id": 1821,
    "vorder": 113,
    "position": 0,
    "text": "ببد هرکه درویش با او یکی"
  },
  {
    "poem_id": 1821,
    "vorder": 114,
    "position": 1,
    "text": "اگر مرد بودند اگر کودکی"
  },
  {
    "poem_id": 1821,
    "vorder": 115,
    "position": 0,
    "text": "از این بستدی چیز و دادی بدان"
  },
  {
    "poem_id": 1821,
    "vorder": 116,
    "position": 1,
    "text": "فرو مانده بُد زان سخن بخردان"
  },
  {
    "poem_id": 1821,
    "vorder": 117,
    "position": 0,
    "text": "چو بشنید در دین او شد قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 118,
    "position": 1,
    "text": "ز گیتی به گفتار او بود شاد"
  },
  {
    "poem_id": 1821,
    "vorder": 119,
    "position": 0,
    "text": "ورا شاه بنشاند بر دست راست"
  },
  {
    "poem_id": 1821,
    "vorder": 120,
    "position": 1,
    "text": "ندانست لشکر که موبد کجاست"
  },
  {
    "poem_id": 1821,
    "vorder": 121,
    "position": 0,
    "text": "بر او شد آن کس که درویش بود"
  },
  {
    "poem_id": 1821,
    "vorder": 122,
    "position": 1,
    "text": "وگر نانش از کوشش خویش بود"
  },
  {
    "poem_id": 1821,
    "vorder": 123,
    "position": 0,
    "text": "به گرد جهان تازه شد دین او"
  },
  {
    "poem_id": 1821,
    "vorder": 124,
    "position": 1,
    "text": "نیارست جستن کسی کین او"
  },
  {
    "poem_id": 1821,
    "vorder": 125,
    "position": 0,
    "text": "توانگر همی سر ز تنگی نگاشت"
  },
  {
    "poem_id": 1821,
    "vorder": 126,
    "position": 1,
    "text": "سپردی به درویش چیزی که داشت"
  },
  {
    "poem_id": 1821,
    "vorder": 127,
    "position": 0,
    "text": "چنان بد که یک روز مزدک پگاه"
  },
  {
    "poem_id": 1821,
    "vorder": 128,
    "position": 1,
    "text": "ز خانه بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 129,
    "position": 0,
    "text": "چنین گفت کز دین پرستان ما"
  },
  {
    "poem_id": 1821,
    "vorder": 130,
    "position": 1,
    "text": "همان پاکدل زیردستان ما"
  },
  {
    "poem_id": 1821,
    "vorder": 131,
    "position": 0,
    "text": "فراوان ز گیتی سران بر درند"
  },
  {
    "poem_id": 1821,
    "vorder": 132,
    "position": 1,
    "text": "فرود آوری گر ز در بگذرند"
  },
  {
    "poem_id": 1821,
    "vorder": 133,
    "position": 0,
    "text": "ز مزدک شنید این سخن‌ها قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 134,
    "position": 1,
    "text": "به سالار فرمود تا بار داد"
  },
  {
    "poem_id": 1821,
    "vorder": 135,
    "position": 0,
    "text": "چنین گفت مزدک به پرمایه شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 136,
    "position": 1,
    "text": "که این جای تنگست و چندان سپاه"
  },
  {
    "poem_id": 1821,
    "vorder": 137,
    "position": 0,
    "text": "همانا نگنجند در پیش شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 138,
    "position": 1,
    "text": "به هامون خرامد کندشان نگاه"
  },
  {
    "poem_id": 1821,
    "vorder": 139,
    "position": 0,
    "text": "بفرمود تا تخت بیرون برند"
  },
  {
    "poem_id": 1821,
    "vorder": 140,
    "position": 1,
    "text": "ز ایوان شاهی به هامون برند"
  },
  {
    "poem_id": 1821,
    "vorder": 141,
    "position": 0,
    "text": "به دشت آمد از مزدکی صدهزار"
  },
  {
    "poem_id": 1821,
    "vorder": 142,
    "position": 1,
    "text": "برفتند شادان بر شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 143,
    "position": 0,
    "text": "چنین گفت مزدک به شاه زمین"
  },
  {
    "poem_id": 1821,
    "vorder": 144,
    "position": 1,
    "text": "که ای برتر از دانشِ بآفرین"
  },
  {
    "poem_id": 1821,
    "vorder": 145,
    "position": 0,
    "text": "چنان دان که کسری نه بر دین ماست"
  },
  {
    "poem_id": 1821,
    "vorder": 146,
    "position": 1,
    "text": "ز دین سر کشیدن ورا کی سزاست"
  },
  {
    "poem_id": 1821,
    "vorder": 147,
    "position": 0,
    "text": "یکی خط دستش بباید ستد"
  },
  {
    "poem_id": 1821,
    "vorder": 148,
    "position": 1,
    "text": "که سر بازگرداند از راه بد"
  },
  {
    "poem_id": 1821,
    "vorder": 149,
    "position": 0,
    "text": "بپیچاند از راستی پنج چیز"
  },
  {
    "poem_id": 1821,
    "vorder": 150,
    "position": 1,
    "text": "که دانا بر این پنج نفزود نیز"
  },
  {
    "poem_id": 1821,
    "vorder": 151,
    "position": 0,
    "text": "کجا رشک و کین است و خشم و نیاز"
  },
  {
    "poem_id": 1821,
    "vorder": 152,
    "position": 1,
    "text": "به پنجم که گردد بر او چیره آز"
  },
  {
    "poem_id": 1821,
    "vorder": 153,
    "position": 0,
    "text": "تو چون چیره باشی بر این پنج دیو"
  },
  {
    "poem_id": 1821,
    "vorder": 154,
    "position": 1,
    "text": "پدید آیدت راه کیهان خدیو"
  },
  {
    "poem_id": 1821,
    "vorder": 155,
    "position": 0,
    "text": "از این پنج ما را زن و خواسته است"
  },
  {
    "poem_id": 1821,
    "vorder": 156,
    "position": 1,
    "text": "که دین بهی در جهان کاسته است"
  },
  {
    "poem_id": 1821,
    "vorder": 157,
    "position": 0,
    "text": "زن و خواسته باشد اندر میان"
  },
  {
    "poem_id": 1821,
    "vorder": 158,
    "position": 1,
    "text": "چو دین بهی را نخواهی زیان"
  },
  {
    "poem_id": 1821,
    "vorder": 159,
    "position": 0,
    "text": "کز این دو بود رشک و آز و نیاز"
  },
  {
    "poem_id": 1821,
    "vorder": 160,
    "position": 1,
    "text": "که با خشم و کین اندر آید به راز"
  },
  {
    "poem_id": 1821,
    "vorder": 161,
    "position": 0,
    "text": "همی دیو پیچد سر بخردان"
  },
  {
    "poem_id": 1821,
    "vorder": 162,
    "position": 1,
    "text": "بباید نهاد این دو اندر میان"
  },
  {
    "poem_id": 1821,
    "vorder": 163,
    "position": 0,
    "text": "چو این گفته شد دست کسری گرفت"
  },
  {
    "poem_id": 1821,
    "vorder": 164,
    "position": 1,
    "text": "بدو مانده بد شاه ایران شگفت"
  },
  {
    "poem_id": 1821,
    "vorder": 165,
    "position": 0,
    "text": "از او نامور دست بستد به خشم"
  },
  {
    "poem_id": 1821,
    "vorder": 166,
    "position": 1,
    "text": "به تندی ز مزدک بخوابید چشم"
  },
  {
    "poem_id": 1821,
    "vorder": 167,
    "position": 0,
    "text": "به مزدک چنین گفت خندان قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 168,
    "position": 1,
    "text": "که از دین کسری چه داری به یاد؟"
  },
  {
    "poem_id": 1821,
    "vorder": 169,
    "position": 0,
    "text": "چنین گفت مزدک که این راه راست"
  },
  {
    "poem_id": 1821,
    "vorder": 170,
    "position": 1,
    "text": "نهانی نداند نه بر دین ماست"
  },
  {
    "poem_id": 1821,
    "vorder": 171,
    "position": 0,
    "text": "همانگه ز کسری بپرسید شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 172,
    "position": 1,
    "text": "که از دین به بگذری نیست راه"
  },
  {
    "poem_id": 1821,
    "vorder": 173,
    "position": 0,
    "text": "بدو گفت کسری چو یابم زمان"
  },
  {
    "poem_id": 1821,
    "vorder": 174,
    "position": 1,
    "text": "بگویم که کژ است یکسر گمان"
  },
  {
    "poem_id": 1821,
    "vorder": 175,
    "position": 0,
    "text": "چو پیدا شود کژی و کاستی"
  },
  {
    "poem_id": 1821,
    "vorder": 176,
    "position": 1,
    "text": "درفشان شود پیش تو راستی"
  },
  {
    "poem_id": 1821,
    "vorder": 177,
    "position": 0,
    "text": "بدو گفت مزدک زمان چند روز"
  },
  {
    "poem_id": 1821,
    "vorder": 178,
    "position": 1,
    "text": "همی‌خواهی از شاه گیتی‌فروز"
  },
  {
    "poem_id": 1821,
    "vorder": 179,
    "position": 0,
    "text": "ورا گفت کسری زمان پنج ماه"
  },
  {
    "poem_id": 1821,
    "vorder": 180,
    "position": 1,
    "text": "ششم را همه بازگویم به شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 181,
    "position": 0,
    "text": "بر این برنهادند و گشتند باز"
  },
  {
    "poem_id": 1821,
    "vorder": 182,
    "position": 1,
    "text": "به ایوان بشد شاه گردن‌فراز"
  },
  {
    "poem_id": 1821,
    "vorder": 183,
    "position": 0,
    "text": "فرستاد کسری به هر جای کس"
  },
  {
    "poem_id": 1821,
    "vorder": 184,
    "position": 1,
    "text": "که داننده‌ای دید و فریادرس"
  },
  {
    "poem_id": 1821,
    "vorder": 185,
    "position": 0,
    "text": "کس آمد سوی خره اردشیر"
  },
  {
    "poem_id": 1821,
    "vorder": 186,
    "position": 1,
    "text": "که آنجا بد از داد هرمزد پیر"
  },
  {
    "poem_id": 1821,
    "vorder": 187,
    "position": 0,
    "text": "ز اصطخر مهرآذر پارسی"
  },
  {
    "poem_id": 1821,
    "vorder": 188,
    "position": 1,
    "text": "بیامد بدرگاه با یار سی"
  },
  {
    "poem_id": 1821,
    "vorder": 189,
    "position": 0,
    "text": "نشستند دانش‌پژوهان به هم"
  },
  {
    "poem_id": 1821,
    "vorder": 190,
    "position": 1,
    "text": "سخن رفت هرگونه از بیش و کم"
  },
  {
    "poem_id": 1821,
    "vorder": 191,
    "position": 0,
    "text": "به کسری سپردند یکسر سخن"
  },
  {
    "poem_id": 1821,
    "vorder": 192,
    "position": 1,
    "text": "خردمند و دانندگان کهن"
  },
  {
    "poem_id": 1821,
    "vorder": 193,
    "position": 0,
    "text": "چو بشنید کسری به نزد قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 194,
    "position": 1,
    "text": "بیامد ز مزدک سخن کرد یاد"
  },
  {
    "poem_id": 1821,
    "vorder": 195,
    "position": 0,
    "text": "که اکنون فراز آمد آن روزگار"
  },
  {
    "poem_id": 1821,
    "vorder": 196,
    "position": 1,
    "text": "که دین بهی را کنم خواستار"
  },
  {
    "poem_id": 1821,
    "vorder": 197,
    "position": 0,
    "text": "گر ایدون که او را بود راستی"
  },
  {
    "poem_id": 1821,
    "vorder": 198,
    "position": 1,
    "text": "شود دین زردشت بر کاستی"
  },
  {
    "poem_id": 1821,
    "vorder": 199,
    "position": 0,
    "text": "پذیرم من آن پاک دین ورا"
  },
  {
    "poem_id": 1821,
    "vorder": 200,
    "position": 1,
    "text": "به جان برگزینم گزین ورا"
  },
  {
    "poem_id": 1821,
    "vorder": 201,
    "position": 0,
    "text": "چو راه فریدون شود نادرست"
  },
  {
    "poem_id": 1821,
    "vorder": 202,
    "position": 1,
    "text": "عزیر مسیحی و هم زند و است"
  },
  {
    "poem_id": 1821,
    "vorder": 203,
    "position": 0,
    "text": "سخن گفتن مزدک آید به جای"
  },
  {
    "poem_id": 1821,
    "vorder": 204,
    "position": 1,
    "text": "نباید به گیتی جز او رهنمای"
  },
  {
    "poem_id": 1821,
    "vorder": 205,
    "position": 0,
    "text": "ور ایدون که او کژ گوید همی"
  },
  {
    "poem_id": 1821,
    "vorder": 206,
    "position": 1,
    "text": "ره پاک یزدان نجوید همی"
  },
  {
    "poem_id": 1821,
    "vorder": 207,
    "position": 0,
    "text": "به من ده ورا و آنکه در دین اوست"
  },
  {
    "poem_id": 1821,
    "vorder": 208,
    "position": 1,
    "text": "مبادا یکی را به تن مغز و پوست"
  },
  {
    "poem_id": 1821,
    "vorder": 209,
    "position": 0,
    "text": "گوا کرد زرمهر و خرداد را"
  },
  {
    "poem_id": 1821,
    "vorder": 210,
    "position": 1,
    "text": "فرایین و بندوی و بهزاد را"
  },
  {
    "poem_id": 1821,
    "vorder": 211,
    "position": 0,
    "text": "وز آن جایگه شد به ایوان خویش"
  },
  {
    "poem_id": 1821,
    "vorder": 212,
    "position": 1,
    "text": "نگه داشت آن راست پیمان خویش"
  },
  {
    "poem_id": 1821,
    "vorder": 213,
    "position": 0,
    "text": "به شبگیر چون شید بنمود تاج"
  },
  {
    "poem_id": 1821,
    "vorder": 214,
    "position": 1,
    "text": "زمین شد به کردار دریای عاج"
  },
  {
    "poem_id": 1821,
    "vorder": 215,
    "position": 0,
    "text": "همی‌راند فرزند شاه جهان"
  },
  {
    "poem_id": 1821,
    "vorder": 216,
    "position": 1,
    "text": "سخن‌گوی با موبدان و ردان"
  },
  {
    "poem_id": 1821,
    "vorder": 217,
    "position": 0,
    "text": "به آیین به ایوان شاه آمدند"
  },
  {
    "poem_id": 1821,
    "vorder": 218,
    "position": 1,
    "text": "سخن‌گوی و جوینده راه آمدند"
  },
  {
    "poem_id": 1821,
    "vorder": 219,
    "position": 0,
    "text": "دلارای مزدک سوی کیقباد"
  },
  {
    "poem_id": 1821,
    "vorder": 220,
    "position": 1,
    "text": "بیامد سخن را در اندرگشاد"
  },
  {
    "poem_id": 1821,
    "vorder": 221,
    "position": 0,
    "text": "چنین گفت کسری به پیش گروه"
  },
  {
    "poem_id": 1821,
    "vorder": 222,
    "position": 1,
    "text": "به مزدک که ای مرد دانش‌پژوه"
  },
  {
    "poem_id": 1821,
    "vorder": 223,
    "position": 0,
    "text": "یکی دین نو ساختی پر زیان"
  },
  {
    "poem_id": 1821,
    "vorder": 224,
    "position": 1,
    "text": "نهادی زن و خواسته در میان"
  },
  {
    "poem_id": 1821,
    "vorder": 225,
    "position": 0,
    "text": "چه داند پسر کش که باشد پدر؟"
  },
  {
    "poem_id": 1821,
    "vorder": 226,
    "position": 1,
    "text": "پدر همچنین چون شناسد پسر؟"
  },
  {
    "poem_id": 1821,
    "vorder": 227,
    "position": 0,
    "text": "چو مردم سراسر بود در جهان"
  },
  {
    "poem_id": 1821,
    "vorder": 228,
    "position": 1,
    "text": "نباشند پیدا کهان و مهان"
  },
  {
    "poem_id": 1821,
    "vorder": 229,
    "position": 0,
    "text": "که باشد که جوید در کهتری؟"
  },
  {
    "poem_id": 1821,
    "vorder": 230,
    "position": 1,
    "text": "چگونه توان یافتن مهتری؟"
  },
  {
    "poem_id": 1821,
    "vorder": 231,
    "position": 0,
    "text": "کسی کاو مرد جای و چیزش که راست؟"
  },
  {
    "poem_id": 1821,
    "vorder": 232,
    "position": 1,
    "text": "که شد کارجو بنده با شاه راست"
  },
  {
    "poem_id": 1821,
    "vorder": 233,
    "position": 0,
    "text": "جهان ز این سخن پاک ویران شود"
  },
  {
    "poem_id": 1821,
    "vorder": 234,
    "position": 1,
    "text": "نباید که این بد به ایران شود"
  },
  {
    "poem_id": 1821,
    "vorder": 235,
    "position": 0,
    "text": "همه کدخدایند و مزدور کیست؟"
  },
  {
    "poem_id": 1821,
    "vorder": 236,
    "position": 1,
    "text": "همه گنج دارند و گنجور کیست؟"
  },
  {
    "poem_id": 1821,
    "vorder": 237,
    "position": 0,
    "text": "ز دین‌آوران این سخن کس نگفت"
  },
  {
    "poem_id": 1821,
    "vorder": 238,
    "position": 1,
    "text": "تو دیوانگی داشتی در نهفت"
  },
  {
    "poem_id": 1821,
    "vorder": 239,
    "position": 0,
    "text": "همه مردمان را به دوزخ بری"
  },
  {
    "poem_id": 1821,
    "vorder": 240,
    "position": 1,
    "text": "همی کار بد را به بد نشمری"
  },
  {
    "poem_id": 1821,
    "vorder": 241,
    "position": 0,
    "text": "چو بشنید گفتار موبد قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 242,
    "position": 1,
    "text": "برآشفت و اندر سخن داد داد"
  },
  {
    "poem_id": 1821,
    "vorder": 243,
    "position": 0,
    "text": "گرانمایه کسری ورا یار گشت"
  },
  {
    "poem_id": 1821,
    "vorder": 244,
    "position": 1,
    "text": "دل مرد بی‌دین پرآزار گشت"
  },
  {
    "poem_id": 1821,
    "vorder": 245,
    "position": 0,
    "text": "پرآواز گشت انجمن سر به سر"
  },
  {
    "poem_id": 1821,
    "vorder": 246,
    "position": 1,
    "text": "که مزدک مبادا بر تاجور"
  },
  {
    "poem_id": 1821,
    "vorder": 247,
    "position": 0,
    "text": "همی‌دارد او دین یزدان تباه"
  },
  {
    "poem_id": 1821,
    "vorder": 248,
    "position": 1,
    "text": "مباد اندر این نامور بارگاه"
  },
  {
    "poem_id": 1821,
    "vorder": 249,
    "position": 0,
    "text": "از آن دین جهاندار بیزار شد"
  },
  {
    "poem_id": 1821,
    "vorder": 250,
    "position": 1,
    "text": "ز کرده سرش پر ز تیمار شد"
  },
  {
    "poem_id": 1821,
    "vorder": 251,
    "position": 0,
    "text": "به کسری سپردش همانگاه شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 252,
    "position": 1,
    "text": "ابا هرکه او داشت آیین و راه"
  },
  {
    "poem_id": 1821,
    "vorder": 253,
    "position": 0,
    "text": "بدو گفت هر کاو بر این دین اوست"
  },
  {
    "poem_id": 1821,
    "vorder": 254,
    "position": 1,
    "text": "مبادا یکی را به تن مغز و پوست"
  },
  {
    "poem_id": 1821,
    "vorder": 255,
    "position": 0,
    "text": "بدان راه بد نامور صدهزار"
  },
  {
    "poem_id": 1821,
    "vorder": 256,
    "position": 1,
    "text": "به فرزند گفت آن زمان شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 257,
    "position": 0,
    "text": "که با این سران هرچه خواهی بکن"
  },
  {
    "poem_id": 1821,
    "vorder": 258,
    "position": 1,
    "text": "از این پس ز مزدک مگردان سخن"
  },
  {
    "poem_id": 1821,
    "vorder": 259,
    "position": 0,
    "text": "به درگاه کسری یکی باغ بود"
  },
  {
    "poem_id": 1821,
    "vorder": 260,
    "position": 1,
    "text": "که دیوار او برتر از راغ بود"
  },
  {
    "poem_id": 1821,
    "vorder": 261,
    "position": 0,
    "text": "همی گرد بر گرد او کنده کرد"
  },
  {
    "poem_id": 1821,
    "vorder": 262,
    "position": 1,
    "text": "مر این مردمان را پراگنده کرد"
  },
  {
    "poem_id": 1821,
    "vorder": 263,
    "position": 0,
    "text": "بکشتندشان هم به سان درخت"
  },
  {
    "poem_id": 1821,
    "vorder": 264,
    "position": 1,
    "text": "زبر پای و زیرش سرآگنده سخت"
  },
  {
    "poem_id": 1821,
    "vorder": 265,
    "position": 0,
    "text": "به مزدک چنین گفت کسری که رو"
  },
  {
    "poem_id": 1821,
    "vorder": 266,
    "position": 1,
    "text": "به درگاه باغ گرانمایه شو"
  },
  {
    "poem_id": 1821,
    "vorder": 267,
    "position": 0,
    "text": "درختان ببین آنکه هر کس ندید"
  },
  {
    "poem_id": 1821,
    "vorder": 268,
    "position": 1,
    "text": "نه از کاردانان پیشین شنید"
  },
  {
    "poem_id": 1821,
    "vorder": 269,
    "position": 0,
    "text": "بشد مزدک از باغ و بگشاد در"
  },
  {
    "poem_id": 1821,
    "vorder": 270,
    "position": 1,
    "text": "که بیند مگر بر چمن بارور"
  },
  {
    "poem_id": 1821,
    "vorder": 271,
    "position": 0,
    "text": "همانگه که دید از تنش رفت هوش"
  },
  {
    "poem_id": 1821,
    "vorder": 272,
    "position": 1,
    "text": "برآمد به ناکام زو یک خروش"
  },
  {
    "poem_id": 1821,
    "vorder": 273,
    "position": 0,
    "text": "یکی دار فرمود کسری بلند"
  },
  {
    "poem_id": 1821,
    "vorder": 274,
    "position": 1,
    "text": "فروهشت از دار پیچان کمند"
  },
  {
    "poem_id": 1821,
    "vorder": 275,
    "position": 0,
    "text": "نگون‌بخت را زنده بر دار کرد"
  },
  {
    "poem_id": 1821,
    "vorder": 276,
    "position": 1,
    "text": "سر مرد بی‌دین نگون‌سار کرد"
  },
  {
    "poem_id": 1821,
    "vorder": 277,
    "position": 0,
    "text": "از آن پس بکشتش به باران تیر"
  },
  {
    "poem_id": 1821,
    "vorder": 278,
    "position": 1,
    "text": "تو گر باهشی راه مزدک مگیر"
  },
  {
    "poem_id": 1821,
    "vorder": 279,
    "position": 0,
    "text": "بزرگان شدند ایمن از خواسته"
  },
  {
    "poem_id": 1821,
    "vorder": 280,
    "position": 1,
    "text": "زن و زاده و باغ آراسته"
  },
  {
    "poem_id": 1821,
    "vorder": 281,
    "position": 0,
    "text": "همی‌بود با شرم چندی قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 282,
    "position": 1,
    "text": "ز نفرین مزدک همی‌کرد یاد"
  },
  {
    "poem_id": 1821,
    "vorder": 283,
    "position": 0,
    "text": "به درویش بخشید بسیار چیز"
  },
  {
    "poem_id": 1821,
    "vorder": 284,
    "position": 1,
    "text": "بر آتشکده خلعت افگند نیز"
  },
  {
    "poem_id": 1821,
    "vorder": 285,
    "position": 0,
    "text": "ز کسری چنان شاد شد شهریار"
  },
  {
    "poem_id": 1821,
    "vorder": 286,
    "position": 1,
    "text": "که شاخش همی گوهر آورد بار"
  },
  {
    "poem_id": 1821,
    "vorder": 287,
    "position": 0,
    "text": "از آن پس همه رای با او زدی"
  },
  {
    "poem_id": 1821,
    "vorder": 288,
    "position": 1,
    "text": "سخن هرچه گفتی از او بشندی"
  },
  {
    "poem_id": 1821,
    "vorder": 289,
    "position": 0,
    "text": "ز شاهیش چون سال شد بر چهل"
  },
  {
    "poem_id": 1821,
    "vorder": 290,
    "position": 1,
    "text": "غم روز مرگ اندر آمد به دل"
  },
  {
    "poem_id": 1821,
    "vorder": 291,
    "position": 0,
    "text": "یکی نامه بنوشت پس بر حریر"
  },
  {
    "poem_id": 1821,
    "vorder": 292,
    "position": 1,
    "text": "بر آن خط شایسته خود بد دبیر"
  },
  {
    "poem_id": 1821,
    "vorder": 293,
    "position": 0,
    "text": "نخست آفرین کرد بر دادگر"
  },
  {
    "poem_id": 1821,
    "vorder": 294,
    "position": 1,
    "text": "که دارد از او دین و هم زو هنر"
  },
  {
    "poem_id": 1821,
    "vorder": 295,
    "position": 0,
    "text": "بباشد همه بی‌گمان هرچه گفت"
  },
  {
    "poem_id": 1821,
    "vorder": 296,
    "position": 1,
    "text": "چه بر آشکار و چه اندر نهفت"
  },
  {
    "poem_id": 1821,
    "vorder": 297,
    "position": 0,
    "text": "سر پادشاهیش را کس ندید"
  },
  {
    "poem_id": 1821,
    "vorder": 298,
    "position": 1,
    "text": "نشد خوار هرکس که او را گزید"
  },
  {
    "poem_id": 1821,
    "vorder": 299,
    "position": 0,
    "text": "هر آن کس که بینید خط قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 300,
    "position": 1,
    "text": "به جز پند کسری مگیرید یاد"
  },
  {
    "poem_id": 1821,
    "vorder": 301,
    "position": 0,
    "text": "به کسری سپردم سزاوار تخت"
  },
  {
    "poem_id": 1821,
    "vorder": 302,
    "position": 1,
    "text": "پس از مرگ ما او بود نیک‌بخت"
  },
  {
    "poem_id": 1821,
    "vorder": 303,
    "position": 0,
    "text": "که یزدان از این پور خشنود باد"
  },
  {
    "poem_id": 1821,
    "vorder": 304,
    "position": 1,
    "text": "دل بدسگالش پر از دود باد"
  },
  {
    "poem_id": 1821,
    "vorder": 305,
    "position": 0,
    "text": "ز گفتار او هیچ مپراگنید"
  },
  {
    "poem_id": 1821,
    "vorder": 306,
    "position": 1,
    "text": "بدو شاد باشید و گنج آگنید"
  },
  {
    "poem_id": 1821,
    "vorder": 307,
    "position": 0,
    "text": "بر آن نامه بر مُهر زرین نهاد"
  },
  {
    "poem_id": 1821,
    "vorder": 308,
    "position": 1,
    "text": "بر موبد رام برزین نهاد"
  },
  {
    "poem_id": 1821,
    "vorder": 309,
    "position": 0,
    "text": "به هشتاد شد سالیان قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 310,
    "position": 1,
    "text": "نبد روز پیری هم از مرگ شاد"
  },
  {
    "poem_id": 1821,
    "vorder": 311,
    "position": 0,
    "text": "بمرد و جهان مردری ماند از اوی"
  },
  {
    "poem_id": 1821,
    "vorder": 312,
    "position": 1,
    "text": "شد از چهر و بیناییش رنگ و بوی"
  },
  {
    "poem_id": 1821,
    "vorder": 313,
    "position": 0,
    "text": "تنش را به دیبا بیاراستند"
  },
  {
    "poem_id": 1821,
    "vorder": 314,
    "position": 1,
    "text": "گل و مشک و کافور و می خواستند"
  },
  {
    "poem_id": 1821,
    "vorder": 315,
    "position": 0,
    "text": "یکی دخمه کردند شاهنشهی"
  },
  {
    "poem_id": 1821,
    "vorder": 316,
    "position": 1,
    "text": "یکی تاج شاهی و تخت مهی"
  },
  {
    "poem_id": 1821,
    "vorder": 317,
    "position": 0,
    "text": "نهادند بر تخت زر شاه را"
  },
  {
    "poem_id": 1821,
    "vorder": 318,
    "position": 1,
    "text": "ببستند تا جاودان راه را"
  },
  {
    "poem_id": 1821,
    "vorder": 319,
    "position": 0,
    "text": "چو موبد بپردخت از سوگ شاه"
  },
  {
    "poem_id": 1821,
    "vorder": 320,
    "position": 1,
    "text": "نهاد آن کیی نامه بر پیشگاه"
  },
  {
    "poem_id": 1821,
    "vorder": 321,
    "position": 0,
    "text": "بر آن انجمن نامه برخواندند"
  },
  {
    "poem_id": 1821,
    "vorder": 322,
    "position": 1,
    "text": "ولیعهد را شاد بنشاندند"
  },
  {
    "poem_id": 1821,
    "vorder": 323,
    "position": 0,
    "text": "چو کسری نشست از بر گاه نو"
  },
  {
    "poem_id": 1821,
    "vorder": 324,
    "position": 1,
    "text": "همی‌خواندندی ورا شاه نو"
  },
  {
    "poem_id": 1821,
    "vorder": 325,
    "position": 0,
    "text": "به شاهی بر او آفرین خواندند"
  },
  {
    "poem_id": 1821,
    "vorder": 326,
    "position": 1,
    "text": "به سر برش گوهر برافشاندند"
  },
  {
    "poem_id": 1821,
    "vorder": 327,
    "position": 0,
    "text": "ورا نام کردند نوشین روان"
  },
  {
    "poem_id": 1821,
    "vorder": 328,
    "position": 1,
    "text": "که مهتر جوان بود و دولت جوان"
  },
  {
    "poem_id": 1821,
    "vorder": 329,
    "position": 0,
    "text": "به سر شد کنون داستان قباد"
  },
  {
    "poem_id": 1821,
    "vorder": 330,
    "position": 1,
    "text": "ز کسری کنم ز این سپس نام یاد"
  },
  {
    "poem_id": 1821,
    "vorder": 331,
    "position": 0,
    "text": "همش داد بود و همش رای و نام"
  },
  {
    "poem_id": 1821,
    "vorder": 332,
    "position": 1,
    "text": "به داد و دهش یافته نام و کام"
  },
  {
    "poem_id": 1821,
    "vorder": 333,
    "position": 0,
    "text": "الا ای دلارای سرو بلند"
  },
  {
    "poem_id": 1821,
    "vorder": 334,
    "position": 1,
    "text": "چه بودت که گشتی چنین مستمند؟"
  },
  {
    "poem_id": 1821,
    "vorder": 335,
    "position": 0,
    "text": "بدان شادمانی و آن فر و زیب"
  },
  {
    "poem_id": 1821,
    "vorder": 336,
    "position": 1,
    "text": "چرا شد دل روشنت پرنهیب؟"
  },
  {
    "poem_id": 1821,
    "vorder": 337,
    "position": 0,
    "text": "چنین گفت پرسنده را سروبن"
  },
  {
    "poem_id": 1821,
    "vorder": 338,
    "position": 1,
    "text": "که شادان بدم تا نبودم کهن"
  },
  {
    "poem_id": 1821,
    "vorder": 339,
    "position": 0,
    "text": "چنین سست گشتم ز نیروی شست"
  },
  {
    "poem_id": 1821,
    "vorder": 340,
    "position": 1,
    "text": "به پرهیز و با او مساو ایچ دست"
  },
  {
    "poem_id": 1821,
    "vorder": 341,
    "position": 0,
    "text": "دم اژدها دارد و چنگ شیر"
  },
  {
    "poem_id": 1821,
    "vorder": 342,
    "position": 1,
    "text": "بخاید کسی را که آرد به زیر"
  },
  {
    "poem_id": 1821,
    "vorder": 343,
    "position": 0,
    "text": "هم‌آواز رعدست و هم زور کرگ"
  },
  {
    "poem_id": 1821,
    "vorder": 344,
    "position": 1,
    "text": "به یک دست رنج و به یک دست مرگ"
  },
  {
    "poem_id": 1821,
    "vorder": 345,
    "position": 0,
    "text": "ز سرو دلارای چنبر کند"
  },
  {
    "poem_id": 1821,
    "vorder": 346,
    "position": 1,
    "text": "سمن برگ را رنگ عنبر کند"
  },
  {
    "poem_id": 1821,
    "vorder": 347,
    "position": 0,
    "text": "گل ارغوان را کند زعفران"
  },
  {
    "poem_id": 1821,
    "vorder": 348,
    "position": 1,
    "text": "پس زعفران رنجهای گران"
  },
  {
    "poem_id": 1821,
    "vorder": 349,
    "position": 0,
    "text": "شود بسته بی‌بند پای نوند"
  },
  {
    "poem_id": 1821,
    "vorder": 350,
    "position": 1,
    "text": "وز او خوار گردد تن ارجمند"
  },
  {
    "poem_id": 1821,
    "vorder": 351,
    "position": 0,
    "text": "مرا در خوشاب سستی گرفت"
  },
  {
    "poem_id": 1821,
    "vorder": 352,
    "position": 1,
    "text": "همان سرو آزاد پستی گرفت"
  },
  {
    "poem_id": 1821,
    "vorder": 353,
    "position": 0,
    "text": "خروشان شد آن نرگسان دژم"
  },
  {
    "poem_id": 1821,
    "vorder": 354,
    "position": 1,
    "text": "همان سرو آزاده شد پشت خم"
  },
  {
    "poem_id": 1821,
    "vorder": 355,
    "position": 0,
    "text": "دل شاد و بی غم پر از درد گشت"
  },
  {
    "poem_id": 1821,
    "vorder": 356,
    "position": 1,
    "text": "چنین روز ما ناجوانمرد گشت"
  },
  {
    "poem_id": 1821,
    "vorder": 357,
    "position": 0,
    "text": "بدانگه که مردم شود سیر شیر"
  },
  {
    "poem_id": 1821,
    "vorder": 358,
    "position": 1,
    "text": "شتاب آورد مرگ و خواندش پیر"
  },
  {
    "poem_id": 1821,
    "vorder": 359,
    "position": 0,
    "text": "چل و هشت بد عهد نوشین روان"
  },
  {
    "poem_id": 1821,
    "vorder": 360,
    "position": 1,
    "text": "تو بر شست رفتی نمانی جوان"
  }
]