[
  {
    "poem_id": 1430,
    "vorder": 1,
    "position": 0,
    "text": "درخت برومند چون شد بلند"
  },
  {
    "poem_id": 1430,
    "vorder": 2,
    "position": 1,
    "text": "گر آید ز گردون برو بر گزند"
  },
  {
    "poem_id": 1430,
    "vorder": 3,
    "position": 0,
    "text": "شود برگ پژمرده و بیخ سست"
  },
  {
    "poem_id": 1430,
    "vorder": 4,
    "position": 1,
    "text": "سرش سوی پستی گراید نخست"
  },
  {
    "poem_id": 1430,
    "vorder": 5,
    "position": 0,
    "text": "چو از جایگه بگسلد پای خویش"
  },
  {
    "poem_id": 1430,
    "vorder": 6,
    "position": 1,
    "text": "به شاخ نو آیین دهد جای خویش"
  },
  {
    "poem_id": 1430,
    "vorder": 7,
    "position": 0,
    "text": "مراو را سپارد گل و برگ و باغ"
  },
  {
    "poem_id": 1430,
    "vorder": 8,
    "position": 1,
    "text": "بهاری به کردار روشن چراغ"
  },
  {
    "poem_id": 1430,
    "vorder": 9,
    "position": 0,
    "text": "اگر شاخ بد خیزد از بیخ نیک"
  },
  {
    "poem_id": 1430,
    "vorder": 10,
    "position": 1,
    "text": "تو با شاخ تندی میاغاز ریک"
  },
  {
    "poem_id": 1430,
    "vorder": 11,
    "position": 0,
    "text": "پدر چون به فرزند ماند جهان"
  },
  {
    "poem_id": 1430,
    "vorder": 12,
    "position": 1,
    "text": "کند آشکارا برو بر نهان"
  },
  {
    "poem_id": 1430,
    "vorder": 13,
    "position": 0,
    "text": "گر او بفگند فر و نام پدر"
  },
  {
    "poem_id": 1430,
    "vorder": 14,
    "position": 1,
    "text": "تو بیگانه خوانش مخوانش پسر"
  },
  {
    "poem_id": 1430,
    "vorder": 15,
    "position": 0,
    "text": "کرا گم شود راه آموزگار"
  },
  {
    "poem_id": 1430,
    "vorder": 16,
    "position": 1,
    "text": "سزد گر جفا بیند از روزگار"
  },
  {
    "poem_id": 1430,
    "vorder": 17,
    "position": 0,
    "text": "چنین است رسم سرای کهن"
  },
  {
    "poem_id": 1430,
    "vorder": 18,
    "position": 1,
    "text": "سرش هیچ پیدا نبینی ز بن"
  },
  {
    "poem_id": 1430,
    "vorder": 19,
    "position": 0,
    "text": "چو رسم بدش بازداند کسی"
  },
  {
    "poem_id": 1430,
    "vorder": 20,
    "position": 1,
    "text": "نخواهد که ماند به گیتی بسی"
  },
  {
    "poem_id": 1430,
    "vorder": 21,
    "position": 0,
    "text": "چو کاووس بگرفت گاه پدر"
  },
  {
    "poem_id": 1430,
    "vorder": 22,
    "position": 1,
    "text": "مر او را جهان بنده شد سر به سر"
  },
  {
    "poem_id": 1430,
    "vorder": 23,
    "position": 0,
    "text": "همان تخت و هم طوق و هم گوشوار"
  },
  {
    "poem_id": 1430,
    "vorder": 24,
    "position": 1,
    "text": "همان تاج زرین زبرجد نگار"
  },
  {
    "poem_id": 1430,
    "vorder": 25,
    "position": 0,
    "text": "همان تازی اسپان آگنده یال"
  },
  {
    "poem_id": 1430,
    "vorder": 26,
    "position": 1,
    "text": "به گیتی ندانست کس را همال"
  },
  {
    "poem_id": 1430,
    "vorder": 27,
    "position": 0,
    "text": "چنان بد که در گلشن زرنگار"
  },
  {
    "poem_id": 1430,
    "vorder": 28,
    "position": 1,
    "text": "همی خورد روزی می خوشگوار"
  },
  {
    "poem_id": 1430,
    "vorder": 29,
    "position": 0,
    "text": "یکی تخت زرین بلورینش پای"
  },
  {
    "poem_id": 1430,
    "vorder": 30,
    "position": 1,
    "text": "نشسته بروبر جهان کدخدای"
  },
  {
    "poem_id": 1430,
    "vorder": 31,
    "position": 0,
    "text": "ابا پهلوانان ایران به هم"
  },
  {
    "poem_id": 1430,
    "vorder": 32,
    "position": 1,
    "text": "همی رای زد شاه بر بیش و کم"
  },
  {
    "poem_id": 1430,
    "vorder": 33,
    "position": 0,
    "text": "چو رامشگری دیو زی پرده‌دار"
  },
  {
    "poem_id": 1430,
    "vorder": 34,
    "position": 1,
    "text": "بیامد که خواهد بر شاه بار"
  },
  {
    "poem_id": 1430,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت کز شهر مازندران"
  },
  {
    "poem_id": 1430,
    "vorder": 36,
    "position": 1,
    "text": "یکی خوشنوازم ز رامشگران"
  },
  {
    "poem_id": 1430,
    "vorder": 37,
    "position": 0,
    "text": "اگر در خورم بندگی شاه را"
  },
  {
    "poem_id": 1430,
    "vorder": 38,
    "position": 1,
    "text": "گشاید بر تخت او راه را"
  },
  {
    "poem_id": 1430,
    "vorder": 39,
    "position": 0,
    "text": "برفت از بر پرده سالار بار"
  },
  {
    "poem_id": 1430,
    "vorder": 40,
    "position": 1,
    "text": "خرامان بیامد بر شهریار"
  },
  {
    "poem_id": 1430,
    "vorder": 41,
    "position": 0,
    "text": "بگفتا که رامشگری بر درست"
  },
  {
    "poem_id": 1430,
    "vorder": 42,
    "position": 1,
    "text": "ابا بربط و نغز رامشگرست"
  },
  {
    "poem_id": 1430,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود تا پیش او خواندند"
  },
  {
    "poem_id": 1430,
    "vorder": 44,
    "position": 1,
    "text": "بر رود سازانش بنشاندند"
  },
  {
    "poem_id": 1430,
    "vorder": 45,
    "position": 0,
    "text": "به بربط چو بایست بر ساخت رود"
  },
  {
    "poem_id": 1430,
    "vorder": 46,
    "position": 1,
    "text": "برآورد مازندرانی سرود"
  },
  {
    "poem_id": 1430,
    "vorder": 47,
    "position": 0,
    "text": "که مازندران شهر ما یاد باد"
  },
  {
    "poem_id": 1430,
    "vorder": 48,
    "position": 1,
    "text": "همیشه بر و بومش آباد باد"
  },
  {
    "poem_id": 1430,
    "vorder": 49,
    "position": 0,
    "text": "که در بوستانش همیشه گلست"
  },
  {
    "poem_id": 1430,
    "vorder": 50,
    "position": 1,
    "text": "به کوه اندرون لاله و سنبلست"
  },
  {
    "poem_id": 1430,
    "vorder": 51,
    "position": 0,
    "text": "هوا خوشگوار و زمین پرنگار"
  },
  {
    "poem_id": 1430,
    "vorder": 52,
    "position": 1,
    "text": "نه گرم و نه سرد و همیشه بهار"
  },
  {
    "poem_id": 1430,
    "vorder": 53,
    "position": 0,
    "text": "نوازنده بلبل به باغ اندرون"
  },
  {
    "poem_id": 1430,
    "vorder": 54,
    "position": 1,
    "text": "گرازنده آهو به راغ اندرون"
  },
  {
    "poem_id": 1430,
    "vorder": 55,
    "position": 0,
    "text": "همیشه بیاساید از خفت و خوی"
  },
  {
    "poem_id": 1430,
    "vorder": 56,
    "position": 1,
    "text": "همه ساله هرجای رنگست و بوی"
  },
  {
    "poem_id": 1430,
    "vorder": 57,
    "position": 0,
    "text": "گلابست گویی به جویش روان"
  },
  {
    "poem_id": 1430,
    "vorder": 58,
    "position": 1,
    "text": "همی شاد گردد ز بویش روان"
  },
  {
    "poem_id": 1430,
    "vorder": 59,
    "position": 0,
    "text": "دی و بهمن و آذر و فرودین"
  },
  {
    "poem_id": 1430,
    "vorder": 60,
    "position": 1,
    "text": "همیشه پر از لاله بینی زمین"
  },
  {
    "poem_id": 1430,
    "vorder": 61,
    "position": 0,
    "text": "همه ساله خندان لب جویبار"
  },
  {
    "poem_id": 1430,
    "vorder": 62,
    "position": 1,
    "text": "به هر جای باز شکاری به کار"
  },
  {
    "poem_id": 1430,
    "vorder": 63,
    "position": 0,
    "text": "سراسر همه کشور آراسته"
  },
  {
    "poem_id": 1430,
    "vorder": 64,
    "position": 1,
    "text": "ز دیبا و دینار وز خواسته"
  },
  {
    "poem_id": 1430,
    "vorder": 65,
    "position": 0,
    "text": "بتان پرستنده با تاج زر"
  },
  {
    "poem_id": 1430,
    "vorder": 66,
    "position": 1,
    "text": "همه نامداران به زرین کمر"
  },
  {
    "poem_id": 1430,
    "vorder": 67,
    "position": 0,
    "text": "چو کاووس بشنید از او این سخن"
  },
  {
    "poem_id": 1430,
    "vorder": 68,
    "position": 1,
    "text": "یکی تازه اندیشه افگند بن"
  },
  {
    "poem_id": 1430,
    "vorder": 69,
    "position": 0,
    "text": "دل رزمجویش ببست اندران"
  },
  {
    "poem_id": 1430,
    "vorder": 70,
    "position": 1,
    "text": "که لشکر کشد سوی مازندران"
  },
  {
    "poem_id": 1430,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت با سرفرازان رزم"
  },
  {
    "poem_id": 1430,
    "vorder": 72,
    "position": 1,
    "text": "که ما سر نهادیم یکسر به بزم"
  },
  {
    "poem_id": 1430,
    "vorder": 73,
    "position": 0,
    "text": "اگر کاهلی پیشه گیرد دلیر"
  },
  {
    "poem_id": 1430,
    "vorder": 74,
    "position": 1,
    "text": "نگردد ز آسایش و کام سیر"
  },
  {
    "poem_id": 1430,
    "vorder": 75,
    "position": 0,
    "text": "من از جم و ضحاک و از کیقباد"
  },
  {
    "poem_id": 1430,
    "vorder": 76,
    "position": 1,
    "text": "فزونم به بخت و به فر و به داد"
  },
  {
    "poem_id": 1430,
    "vorder": 77,
    "position": 0,
    "text": "فزون بایدم زان ایشان هنر"
  },
  {
    "poem_id": 1430,
    "vorder": 78,
    "position": 1,
    "text": "جهانجوی باید سر تاجور"
  },
  {
    "poem_id": 1430,
    "vorder": 79,
    "position": 0,
    "text": "سخن چون به گوش بزرگان رسید"
  },
  {
    "poem_id": 1430,
    "vorder": 80,
    "position": 1,
    "text": "ازیشان کس این رای فرخ ندید"
  },
  {
    "poem_id": 1430,
    "vorder": 81,
    "position": 0,
    "text": "همه زرد گشتند و پرچین بروی"
  },
  {
    "poem_id": 1430,
    "vorder": 82,
    "position": 1,
    "text": "کسی جنگ دیوان نکرد آرزوی"
  },
  {
    "poem_id": 1430,
    "vorder": 83,
    "position": 0,
    "text": "کسی راست پاسخ نیارست کرد"
  },
  {
    "poem_id": 1430,
    "vorder": 84,
    "position": 1,
    "text": "نهانی روان‌شان پر از باد سرد"
  },
  {
    "poem_id": 1430,
    "vorder": 85,
    "position": 0,
    "text": "چو طوس و چو گودرز کشواد و گیو"
  },
  {
    "poem_id": 1430,
    "vorder": 86,
    "position": 1,
    "text": "چو خراد و گرگین و رهام نیو"
  },
  {
    "poem_id": 1430,
    "vorder": 87,
    "position": 0,
    "text": "به آواز گفتند ما کهتریم"
  },
  {
    "poem_id": 1430,
    "vorder": 88,
    "position": 1,
    "text": "زمین جز به فرمان تو نسپریم"
  },
  {
    "poem_id": 1430,
    "vorder": 89,
    "position": 0,
    "text": "ازان پس یکی انجمن ساختند"
  },
  {
    "poem_id": 1430,
    "vorder": 90,
    "position": 1,
    "text": "ز گفتار او دل بپرداختند"
  },
  {
    "poem_id": 1430,
    "vorder": 91,
    "position": 0,
    "text": "نشستند و گفتند با یکدگر"
  },
  {
    "poem_id": 1430,
    "vorder": 92,
    "position": 1,
    "text": "که از بخت ما را چه آمد به سر"
  },
  {
    "poem_id": 1430,
    "vorder": 93,
    "position": 0,
    "text": "اگر شهریار این سخنها که گفت"
  },
  {
    "poem_id": 1430,
    "vorder": 94,
    "position": 1,
    "text": "به می خوردن اندر نخواهد نهفت"
  },
  {
    "poem_id": 1430,
    "vorder": 95,
    "position": 0,
    "text": "ز ما و ز ایران برآمد هلاگ"
  },
  {
    "poem_id": 1430,
    "vorder": 96,
    "position": 1,
    "text": "نماند برین بوم و بر آب و خاک"
  },
  {
    "poem_id": 1430,
    "vorder": 97,
    "position": 0,
    "text": "که جمشید با فر و انگشتری"
  },
  {
    "poem_id": 1430,
    "vorder": 98,
    "position": 1,
    "text": "به فرمان او دیو و مرغ و پری"
  },
  {
    "poem_id": 1430,
    "vorder": 99,
    "position": 0,
    "text": "ز مازندران یاد هرگز نکرد"
  },
  {
    "poem_id": 1430,
    "vorder": 100,
    "position": 1,
    "text": "نجست از دلیران دیوان نبرد"
  },
  {
    "poem_id": 1430,
    "vorder": 101,
    "position": 0,
    "text": "فریدون پردانش و پرفسون"
  },
  {
    "poem_id": 1430,
    "vorder": 102,
    "position": 1,
    "text": "همین را روانش نبد رهنمون"
  },
  {
    "poem_id": 1430,
    "vorder": 103,
    "position": 0,
    "text": "اگر شایدی بردن این بد بسر"
  },
  {
    "poem_id": 1430,
    "vorder": 104,
    "position": 1,
    "text": "به مردی و گنج و به نام و هنر"
  },
  {
    "poem_id": 1430,
    "vorder": 105,
    "position": 0,
    "text": "منوچهر کردی بدین پیشدست"
  },
  {
    "poem_id": 1430,
    "vorder": 106,
    "position": 1,
    "text": "نکردی برین بر دل خویش پست"
  },
  {
    "poem_id": 1430,
    "vorder": 107,
    "position": 0,
    "text": "یکی چاره باید کنون اندرین"
  },
  {
    "poem_id": 1430,
    "vorder": 108,
    "position": 1,
    "text": "که این بد بگردد ز ایران زمین"
  },
  {
    "poem_id": 1430,
    "vorder": 109,
    "position": 0,
    "text": "چنین گفت پس طوس با مهتران"
  },
  {
    "poem_id": 1430,
    "vorder": 110,
    "position": 1,
    "text": "که ای رزم دیده دلاور سران"
  },
  {
    "poem_id": 1430,
    "vorder": 111,
    "position": 0,
    "text": "مراین بند را چاره اکنون یکیست"
  },
  {
    "poem_id": 1430,
    "vorder": 112,
    "position": 1,
    "text": "بسازیم و این کار دشوار نیست"
  },
  {
    "poem_id": 1430,
    "vorder": 113,
    "position": 0,
    "text": "هیونی تکاور بر زال سام"
  },
  {
    "poem_id": 1430,
    "vorder": 114,
    "position": 1,
    "text": "بباید فرستاد و دادن پیام"
  },
  {
    "poem_id": 1430,
    "vorder": 115,
    "position": 0,
    "text": "که گر سر به گل داری اکنون مشوی"
  },
  {
    "poem_id": 1430,
    "vorder": 116,
    "position": 1,
    "text": "یکی تیز کن مغز و بنمای روی"
  },
  {
    "poem_id": 1430,
    "vorder": 117,
    "position": 0,
    "text": "مگر کاو گشاید لب پندمند"
  },
  {
    "poem_id": 1430,
    "vorder": 118,
    "position": 1,
    "text": "سخن بر دل شهریار بلند"
  },
  {
    "poem_id": 1430,
    "vorder": 119,
    "position": 0,
    "text": "بگوید که این اهرمن داد یاد"
  },
  {
    "poem_id": 1430,
    "vorder": 120,
    "position": 1,
    "text": "در دیو هرگز نباید گشاد"
  },
  {
    "poem_id": 1430,
    "vorder": 121,
    "position": 0,
    "text": "مگر زالش آرد ازین گفته باز"
  },
  {
    "poem_id": 1430,
    "vorder": 122,
    "position": 1,
    "text": "وگرنه سرآمد نشان فراز"
  },
  {
    "poem_id": 1430,
    "vorder": 123,
    "position": 0,
    "text": "سخنها ز هر گونه برساختند"
  },
  {
    "poem_id": 1430,
    "vorder": 124,
    "position": 1,
    "text": "هیونی تکاور برون تاختند"
  },
  {
    "poem_id": 1430,
    "vorder": 125,
    "position": 0,
    "text": "رونده همی تاخت تا نیمروز"
  },
  {
    "poem_id": 1430,
    "vorder": 126,
    "position": 1,
    "text": "چو آمد بر زال گیتی فروز"
  },
  {
    "poem_id": 1430,
    "vorder": 127,
    "position": 0,
    "text": "چنین داد از نامداران پیام"
  },
  {
    "poem_id": 1430,
    "vorder": 128,
    "position": 1,
    "text": "که ای نامور با گهر پور سام"
  },
  {
    "poem_id": 1430,
    "vorder": 129,
    "position": 0,
    "text": "یکی کار پیش آمد اکنون شگفت"
  },
  {
    "poem_id": 1430,
    "vorder": 130,
    "position": 1,
    "text": "که آسانش اندازه نتوان گرفت"
  },
  {
    "poem_id": 1430,
    "vorder": 131,
    "position": 0,
    "text": "برین کار گر تو نبندی کمر"
  },
  {
    "poem_id": 1430,
    "vorder": 132,
    "position": 1,
    "text": "نه تن ماند ایدر نه بوم و نه بر"
  },
  {
    "poem_id": 1430,
    "vorder": 133,
    "position": 0,
    "text": "یکی شاه را بر دل اندیشه خاست"
  },
  {
    "poem_id": 1430,
    "vorder": 134,
    "position": 1,
    "text": "بپیچیدش آهرمن از راه راست"
  },
  {
    "poem_id": 1430,
    "vorder": 135,
    "position": 0,
    "text": "به رنج نیاگانش از باستان"
  },
  {
    "poem_id": 1430,
    "vorder": 136,
    "position": 1,
    "text": "نخواهد همی بود همداستان"
  },
  {
    "poem_id": 1430,
    "vorder": 137,
    "position": 0,
    "text": "همی گنج بی‌رنج بگزایدش"
  },
  {
    "poem_id": 1430,
    "vorder": 138,
    "position": 1,
    "text": "چراگاه مازندران بایدش"
  },
  {
    "poem_id": 1430,
    "vorder": 139,
    "position": 0,
    "text": "اگر هیچ سرخاری از آمدن"
  },
  {
    "poem_id": 1430,
    "vorder": 140,
    "position": 1,
    "text": "سپهبد همی زود خواهد شدن"
  },
  {
    "poem_id": 1430,
    "vorder": 141,
    "position": 0,
    "text": "همی رنج تو داد خواهد به باد"
  },
  {
    "poem_id": 1430,
    "vorder": 142,
    "position": 1,
    "text": "که بردی ز آغاز باکیقباد"
  },
  {
    "poem_id": 1430,
    "vorder": 143,
    "position": 0,
    "text": "تو با رستم شیر ناخورده سیر"
  },
  {
    "poem_id": 1430,
    "vorder": 144,
    "position": 1,
    "text": "میان را ببستی چو شیر دلیر"
  },
  {
    "poem_id": 1430,
    "vorder": 145,
    "position": 0,
    "text": "کنون آن همه باد شد پیش اوی"
  },
  {
    "poem_id": 1430,
    "vorder": 146,
    "position": 1,
    "text": "بپیچید جان بداندیش اوی"
  },
  {
    "poem_id": 1430,
    "vorder": 147,
    "position": 0,
    "text": "چو بشنید دستان بپیچید سخت"
  },
  {
    "poem_id": 1430,
    "vorder": 148,
    "position": 1,
    "text": "تنش گشت لرزان بسان درخت"
  },
  {
    "poem_id": 1430,
    "vorder": 149,
    "position": 0,
    "text": "همی گفت کاووس خودکامه مرد"
  },
  {
    "poem_id": 1430,
    "vorder": 150,
    "position": 1,
    "text": "نه گرم آزموده ز گیتی نه سرد"
  },
  {
    "poem_id": 1430,
    "vorder": 151,
    "position": 0,
    "text": "کسی کاو بود در جهان پیش گاه"
  },
  {
    "poem_id": 1430,
    "vorder": 152,
    "position": 1,
    "text": "برو بگذرد سال و خورشید و ماه"
  },
  {
    "poem_id": 1430,
    "vorder": 153,
    "position": 0,
    "text": "که ماند که از تیغ او در جهان"
  },
  {
    "poem_id": 1430,
    "vorder": 154,
    "position": 1,
    "text": "بلرزند یکسر کهان و مهان"
  },
  {
    "poem_id": 1430,
    "vorder": 155,
    "position": 0,
    "text": "نباشد شگفت ار بمن نگرود"
  },
  {
    "poem_id": 1430,
    "vorder": 156,
    "position": 1,
    "text": "شوم خسته گر پند من نشنود"
  },
  {
    "poem_id": 1430,
    "vorder": 157,
    "position": 0,
    "text": "ورین رنج آسان کنم بر دلم"
  },
  {
    "poem_id": 1430,
    "vorder": 158,
    "position": 1,
    "text": "از اندیشهٔ شاه دل بگسلم"
  },
  {
    "poem_id": 1430,
    "vorder": 159,
    "position": 0,
    "text": "نه از من پسندد جهان‌آفرین"
  },
  {
    "poem_id": 1430,
    "vorder": 160,
    "position": 1,
    "text": "نه شاه و نه گردان ایران زمین"
  },
  {
    "poem_id": 1430,
    "vorder": 161,
    "position": 0,
    "text": "شوم گویمش هرچ آید ز پند"
  },
  {
    "poem_id": 1430,
    "vorder": 162,
    "position": 1,
    "text": "ز من گر پذیرد بود سودمند"
  },
  {
    "poem_id": 1430,
    "vorder": 163,
    "position": 0,
    "text": "وگر تیز گردد گشادست راه"
  },
  {
    "poem_id": 1430,
    "vorder": 164,
    "position": 1,
    "text": "تهمتن هم ایدر بود با سپاه"
  },
  {
    "poem_id": 1430,
    "vorder": 165,
    "position": 0,
    "text": "پر اندیشه بود آن شب دیرباز"
  },
  {
    "poem_id": 1430,
    "vorder": 166,
    "position": 1,
    "text": "چو خورشید بنمود تاج از فراز"
  },
  {
    "poem_id": 1430,
    "vorder": 167,
    "position": 0,
    "text": "کمر بست و بنهاد سر سوی شاه"
  },
  {
    "poem_id": 1430,
    "vorder": 168,
    "position": 1,
    "text": "بزرگان برفتند با او به راه"
  },
  {
    "poem_id": 1430,
    "vorder": 169,
    "position": 0,
    "text": "خبر شد به طوس و به گودرز و گیو"
  },
  {
    "poem_id": 1430,
    "vorder": 170,
    "position": 1,
    "text": "به رهام و گرگین و گردان نیو"
  },
  {
    "poem_id": 1430,
    "vorder": 171,
    "position": 0,
    "text": "که دستان به نزدیک ایران رسید"
  },
  {
    "poem_id": 1430,
    "vorder": 172,
    "position": 1,
    "text": "درفش همایونش آمد پدید"
  },
  {
    "poem_id": 1430,
    "vorder": 173,
    "position": 0,
    "text": "پذیره شدندش سران سپاه"
  },
  {
    "poem_id": 1430,
    "vorder": 174,
    "position": 1,
    "text": "سری کاو کشد پهلوانی کلاه"
  },
  {
    "poem_id": 1430,
    "vorder": 175,
    "position": 0,
    "text": "چو دستان سام اندر آمد به تنگ"
  },
  {
    "poem_id": 1430,
    "vorder": 176,
    "position": 1,
    "text": "پذیره شدندنش همه بی‌درنگ"
  },
  {
    "poem_id": 1430,
    "vorder": 177,
    "position": 0,
    "text": "برو سرکشان آفرین خواندند"
  },
  {
    "poem_id": 1430,
    "vorder": 178,
    "position": 1,
    "text": "سوی شاه با او همی راندند"
  },
  {
    "poem_id": 1430,
    "vorder": 179,
    "position": 0,
    "text": "بدو گفت طوس ای گو سرفراز"
  },
  {
    "poem_id": 1430,
    "vorder": 180,
    "position": 1,
    "text": "کشیدی چنین رنج راه دراز"
  },
  {
    "poem_id": 1430,
    "vorder": 181,
    "position": 0,
    "text": "ز بهر بزرگان ایران زمین"
  },
  {
    "poem_id": 1430,
    "vorder": 182,
    "position": 1,
    "text": "برآرامش این رنج کردی گزین"
  },
  {
    "poem_id": 1430,
    "vorder": 183,
    "position": 0,
    "text": "همه سر به سر نیک خواه توایم"
  },
  {
    "poem_id": 1430,
    "vorder": 184,
    "position": 1,
    "text": "ستوده به فر کلاه توایم"
  },
  {
    "poem_id": 1430,
    "vorder": 185,
    "position": 0,
    "text": "ابا نامداران چنین گفت زال"
  },
  {
    "poem_id": 1430,
    "vorder": 186,
    "position": 1,
    "text": "که هر کس که او را نفرسود سال"
  },
  {
    "poem_id": 1430,
    "vorder": 187,
    "position": 0,
    "text": "همه پند پیرانش آید به یاد"
  },
  {
    "poem_id": 1430,
    "vorder": 188,
    "position": 1,
    "text": "ازان پس دهد چرخ گردانش داد"
  },
  {
    "poem_id": 1430,
    "vorder": 189,
    "position": 0,
    "text": "نشاید که گیریم ازو پند باز"
  },
  {
    "poem_id": 1430,
    "vorder": 190,
    "position": 1,
    "text": "کزین پند ما نیست خود بی‌نیاز"
  },
  {
    "poem_id": 1430,
    "vorder": 191,
    "position": 0,
    "text": "ز پند و خرد گر بگردد سرش"
  },
  {
    "poem_id": 1430,
    "vorder": 192,
    "position": 1,
    "text": "پشیمانی آید ز گیتی برش"
  },
  {
    "poem_id": 1430,
    "vorder": 193,
    "position": 0,
    "text": "به آواز گفتند ما با توایم"
  },
  {
    "poem_id": 1430,
    "vorder": 194,
    "position": 1,
    "text": "ز تو بگذرد پند کس نشنویم"
  },
  {
    "poem_id": 1430,
    "vorder": 195,
    "position": 0,
    "text": "همه یکسره نزد شاه آمدند"
  },
  {
    "poem_id": 1430,
    "vorder": 196,
    "position": 1,
    "text": "بر نامور تخت گاه آمدند"
  }
]