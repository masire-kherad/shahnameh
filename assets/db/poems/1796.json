[
  {
    "poem_id": 1796,
    "vorder": 1,
    "position": 0,
    "text": "سپهبد فرستاده را پیش خواند"
  },
  {
    "poem_id": 1796,
    "vorder": 2,
    "position": 1,
    "text": "بران نامور پیشگاهش نشاند"
  },
  {
    "poem_id": 1796,
    "vorder": 3,
    "position": 0,
    "text": "چو بشنید بیدار شاه جهان"
  },
  {
    "poem_id": 1796,
    "vorder": 4,
    "position": 1,
    "text": "فرستاده را خواند پیش مهان"
  },
  {
    "poem_id": 1796,
    "vorder": 5,
    "position": 0,
    "text": "بیامد جهاندیده دانای پیر"
  },
  {
    "poem_id": 1796,
    "vorder": 6,
    "position": 1,
    "text": "سخن‌گوی و بادانش و یادگیر"
  },
  {
    "poem_id": 1796,
    "vorder": 7,
    "position": 0,
    "text": "به کش کرده دست و سرافگنده پست"
  },
  {
    "poem_id": 1796,
    "vorder": 8,
    "position": 1,
    "text": "بر تخت شاهی به زانو نشست"
  },
  {
    "poem_id": 1796,
    "vorder": 9,
    "position": 0,
    "text": "بپرسید بهرام و بنواختش"
  },
  {
    "poem_id": 1796,
    "vorder": 10,
    "position": 1,
    "text": "بر تخت پیروزه بنشاختش"
  },
  {
    "poem_id": 1796,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت کایدر بماندی تو دیر"
  },
  {
    "poem_id": 1796,
    "vorder": 12,
    "position": 1,
    "text": "ز دیدار این مرز ناگشته سیر"
  },
  {
    "poem_id": 1796,
    "vorder": 13,
    "position": 0,
    "text": "مرا رزم خاقان ز تو باز داشت"
  },
  {
    "poem_id": 1796,
    "vorder": 14,
    "position": 1,
    "text": "به گیتی مرا همچو انباز داشت"
  },
  {
    "poem_id": 1796,
    "vorder": 15,
    "position": 0,
    "text": "کنون روزگار توام تازه شد"
  },
  {
    "poem_id": 1796,
    "vorder": 16,
    "position": 1,
    "text": "ترا بودن ایدر بی‌اندازه شد"
  },
  {
    "poem_id": 1796,
    "vorder": 17,
    "position": 0,
    "text": "سخن هرچ گویی تو پاسخ دهیم"
  },
  {
    "poem_id": 1796,
    "vorder": 18,
    "position": 1,
    "text": "وز آواز تو روز فرخ نهیم"
  },
  {
    "poem_id": 1796,
    "vorder": 19,
    "position": 0,
    "text": "فرستادهٔ پیر کرد آفرین"
  },
  {
    "poem_id": 1796,
    "vorder": 20,
    "position": 1,
    "text": "که بی‌تو مبادا زمان و زمین"
  },
  {
    "poem_id": 1796,
    "vorder": 21,
    "position": 0,
    "text": "هران پادشاهی که دارد خرد"
  },
  {
    "poem_id": 1796,
    "vorder": 22,
    "position": 1,
    "text": "ز گفت خردمند رامش برد"
  },
  {
    "poem_id": 1796,
    "vorder": 23,
    "position": 0,
    "text": "به یزدان خردمند نزدیک‌تر"
  },
  {
    "poem_id": 1796,
    "vorder": 24,
    "position": 1,
    "text": "بداندیش را روز تاریک‌تر"
  },
  {
    "poem_id": 1796,
    "vorder": 25,
    "position": 0,
    "text": "تو بر مهتران جهان مهتری"
  },
  {
    "poem_id": 1796,
    "vorder": 26,
    "position": 1,
    "text": "که هم مهتر و شاه و هم بهتری"
  },
  {
    "poem_id": 1796,
    "vorder": 27,
    "position": 0,
    "text": "ترا دانش و هوش و دادست و فر"
  },
  {
    "poem_id": 1796,
    "vorder": 28,
    "position": 1,
    "text": "بر آیین شاهان پیروزگر"
  },
  {
    "poem_id": 1796,
    "vorder": 29,
    "position": 0,
    "text": "همانت خرد هست و پاکیزه رای"
  },
  {
    "poem_id": 1796,
    "vorder": 30,
    "position": 1,
    "text": "بر هوشمندان توی کدخدای"
  },
  {
    "poem_id": 1796,
    "vorder": 31,
    "position": 0,
    "text": "که جاوید بادی تن و جان درست"
  },
  {
    "poem_id": 1796,
    "vorder": 32,
    "position": 1,
    "text": "مبیناد گردون میان تو سست"
  },
  {
    "poem_id": 1796,
    "vorder": 33,
    "position": 0,
    "text": "زبانت ترازوست و گفتن گهر"
  },
  {
    "poem_id": 1796,
    "vorder": 34,
    "position": 1,
    "text": "گهر سخته هرگز که بیند به زر"
  },
  {
    "poem_id": 1796,
    "vorder": 35,
    "position": 0,
    "text": "اگر چه فرستادهٔ قیصرم"
  },
  {
    "poem_id": 1796,
    "vorder": 36,
    "position": 1,
    "text": "همان چاکر شاه را چاکرم"
  },
  {
    "poem_id": 1796,
    "vorder": 37,
    "position": 0,
    "text": "درودی رسانم ز قیصر به شاه"
  },
  {
    "poem_id": 1796,
    "vorder": 38,
    "position": 1,
    "text": "که جاوید باد این سر و تاج و گاه"
  },
  {
    "poem_id": 1796,
    "vorder": 39,
    "position": 0,
    "text": "و دیگر که فرمود تا هفت چیز"
  },
  {
    "poem_id": 1796,
    "vorder": 40,
    "position": 1,
    "text": "بپرسم ز دانندگان تو نیز"
  },
  {
    "poem_id": 1796,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت شاه این سخنها بگوی"
  },
  {
    "poem_id": 1796,
    "vorder": 42,
    "position": 1,
    "text": "سخن‌گوی را بیشتر آب‌روی"
  },
  {
    "poem_id": 1796,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود تا موبد موبدان"
  },
  {
    "poem_id": 1796,
    "vorder": 44,
    "position": 1,
    "text": "بشد پیش با مهتران و ردان"
  },
  {
    "poem_id": 1796,
    "vorder": 45,
    "position": 0,
    "text": "بشد موبد و هرکه دانا بدند"
  },
  {
    "poem_id": 1796,
    "vorder": 46,
    "position": 1,
    "text": "به هر دانشی‌بر توانا بدند"
  },
  {
    "poem_id": 1796,
    "vorder": 47,
    "position": 0,
    "text": "سخن‌گوی بگشاد راز از نهفت"
  },
  {
    "poem_id": 1796,
    "vorder": 48,
    "position": 1,
    "text": "سخنهای قیصر به موبد بگفت"
  },
  {
    "poem_id": 1796,
    "vorder": 49,
    "position": 0,
    "text": "به موبد چنین گفت کای رهنمون"
  },
  {
    "poem_id": 1796,
    "vorder": 50,
    "position": 1,
    "text": "چه چیز آنک خوانی همی اندرون"
  },
  {
    "poem_id": 1796,
    "vorder": 51,
    "position": 0,
    "text": "دگر آنک بیرونش خوانی همی"
  },
  {
    "poem_id": 1796,
    "vorder": 52,
    "position": 1,
    "text": "جزین نیز نامش ندانی همی"
  },
  {
    "poem_id": 1796,
    "vorder": 53,
    "position": 0,
    "text": "زبر چیست ای مهتر و زیر چیست"
  },
  {
    "poem_id": 1796,
    "vorder": 54,
    "position": 1,
    "text": "همان بیکرانه چه و خوار کیست"
  },
  {
    "poem_id": 1796,
    "vorder": 55,
    "position": 0,
    "text": "چه چیز آنک نامش فراوان بود"
  },
  {
    "poem_id": 1796,
    "vorder": 56,
    "position": 1,
    "text": "مر او را به هر جای فرمان بود"
  },
  {
    "poem_id": 1796,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت موبد به فرزانه مرد"
  },
  {
    "poem_id": 1796,
    "vorder": 58,
    "position": 1,
    "text": "که مشتاب وز راه دانش مگرد"
  },
  {
    "poem_id": 1796,
    "vorder": 59,
    "position": 0,
    "text": "مر این را که گفتی تو پاسخ یکیست"
  },
  {
    "poem_id": 1796,
    "vorder": 60,
    "position": 1,
    "text": "سخن در درون و برون اندکیست"
  },
  {
    "poem_id": 1796,
    "vorder": 61,
    "position": 0,
    "text": "برون آسمان و درونش هواست"
  },
  {
    "poem_id": 1796,
    "vorder": 62,
    "position": 1,
    "text": "زبر فر یزدان فرمانرواست"
  },
  {
    "poem_id": 1796,
    "vorder": 63,
    "position": 0,
    "text": "همان بیکران در جهان ایزدست"
  },
  {
    "poem_id": 1796,
    "vorder": 64,
    "position": 1,
    "text": "اگر تاب گیری به دانش بدست"
  },
  {
    "poem_id": 1796,
    "vorder": 65,
    "position": 0,
    "text": "زبر چون بهشتست و دوزخ به زیر"
  },
  {
    "poem_id": 1796,
    "vorder": 66,
    "position": 1,
    "text": "بد آن را که باشد به یزدان دلیر"
  },
  {
    "poem_id": 1796,
    "vorder": 67,
    "position": 0,
    "text": "دگر آنک بسیار نامش بود"
  },
  {
    "poem_id": 1796,
    "vorder": 68,
    "position": 1,
    "text": "رونده به هر جای کامش بود"
  },
  {
    "poem_id": 1796,
    "vorder": 69,
    "position": 0,
    "text": "خرد دارد ای پیر بسیار نام"
  },
  {
    "poem_id": 1796,
    "vorder": 70,
    "position": 1,
    "text": "رساند خرد پادشا را به کام"
  },
  {
    "poem_id": 1796,
    "vorder": 71,
    "position": 0,
    "text": "یکی مهر خوانند و دیگر وفا"
  },
  {
    "poem_id": 1796,
    "vorder": 72,
    "position": 1,
    "text": "خرد دور شد درد ماند و جفا"
  },
  {
    "poem_id": 1796,
    "vorder": 73,
    "position": 0,
    "text": "زبان‌آوری راستی خواندش"
  },
  {
    "poem_id": 1796,
    "vorder": 74,
    "position": 1,
    "text": "بلنداختری زیرکی داندش"
  },
  {
    "poem_id": 1796,
    "vorder": 75,
    "position": 0,
    "text": "گهی بردبار و گهی رازدار"
  },
  {
    "poem_id": 1796,
    "vorder": 76,
    "position": 1,
    "text": "که باشد سخن نزد او پایدار"
  },
  {
    "poem_id": 1796,
    "vorder": 77,
    "position": 0,
    "text": "پراگنده اینست نام خرد"
  },
  {
    "poem_id": 1796,
    "vorder": 78,
    "position": 1,
    "text": "از اندازه‌ها نام او بگذرد"
  },
  {
    "poem_id": 1796,
    "vorder": 79,
    "position": 0,
    "text": "تو چیزی مدان کز خرد برترست"
  },
  {
    "poem_id": 1796,
    "vorder": 80,
    "position": 1,
    "text": "خرد بر همه نیکویها سرست"
  },
  {
    "poem_id": 1796,
    "vorder": 81,
    "position": 0,
    "text": "خرد جوید آگنده راز جهان"
  },
  {
    "poem_id": 1796,
    "vorder": 82,
    "position": 1,
    "text": "که چشم سر ما نبیند نهان"
  },
  {
    "poem_id": 1796,
    "vorder": 83,
    "position": 0,
    "text": "دگر آنک دارد جهاندار خوار"
  },
  {
    "poem_id": 1796,
    "vorder": 84,
    "position": 1,
    "text": "به هر دانش از کردهٔ کردگار"
  },
  {
    "poem_id": 1796,
    "vorder": 85,
    "position": 0,
    "text": "ستاره‌ست رخشان ز چرخ بلند"
  },
  {
    "poem_id": 1796,
    "vorder": 86,
    "position": 1,
    "text": "که بینا شمارش بداند که چند"
  },
  {
    "poem_id": 1796,
    "vorder": 87,
    "position": 0,
    "text": "بلند آسمان را که فرسنگ نیست"
  },
  {
    "poem_id": 1796,
    "vorder": 88,
    "position": 1,
    "text": "کسی را بدو راه و آهنگ نیست"
  },
  {
    "poem_id": 1796,
    "vorder": 89,
    "position": 0,
    "text": "همی خوار گیری شمار ورا"
  },
  {
    "poem_id": 1796,
    "vorder": 90,
    "position": 1,
    "text": "همان گردش روزگار ورا"
  },
  {
    "poem_id": 1796,
    "vorder": 91,
    "position": 0,
    "text": "کسی کو ببیند ز پرتاب تیر"
  },
  {
    "poem_id": 1796,
    "vorder": 92,
    "position": 1,
    "text": "بماند شگفت اندرو تیز ویر"
  },
  {
    "poem_id": 1796,
    "vorder": 93,
    "position": 0,
    "text": "ستاره همی بشمرد ز آسمان"
  },
  {
    "poem_id": 1796,
    "vorder": 94,
    "position": 1,
    "text": "ازین خوارتر چیست ای شادمان"
  },
  {
    "poem_id": 1796,
    "vorder": 95,
    "position": 0,
    "text": "من این دانم ار هست پاسخ جزین"
  },
  {
    "poem_id": 1796,
    "vorder": 96,
    "position": 1,
    "text": "فراخست رای جهان‌آفرین"
  },
  {
    "poem_id": 1796,
    "vorder": 97,
    "position": 0,
    "text": "سخن‌دان قیصر چو پاسخ شنید"
  },
  {
    "poem_id": 1796,
    "vorder": 98,
    "position": 1,
    "text": "زمین را ببوسید و فرمان گزید"
  },
  {
    "poem_id": 1796,
    "vorder": 99,
    "position": 0,
    "text": "به بهرام گفت ای جهاندار شاه"
  },
  {
    "poem_id": 1796,
    "vorder": 100,
    "position": 1,
    "text": "ز یزدان برین‌بر فزونی مخواه"
  },
  {
    "poem_id": 1796,
    "vorder": 101,
    "position": 0,
    "text": "که گیتی سراسر به فرمان تست"
  },
  {
    "poem_id": 1796,
    "vorder": 102,
    "position": 1,
    "text": "سر سرکشان زیر پیمان تست"
  },
  {
    "poem_id": 1796,
    "vorder": 103,
    "position": 0,
    "text": "پسند بزرگان فرخ‌نژاد"
  },
  {
    "poem_id": 1796,
    "vorder": 104,
    "position": 1,
    "text": "ندارد جهان چون تو شاهی به یاد"
  },
  {
    "poem_id": 1796,
    "vorder": 105,
    "position": 0,
    "text": "همان نیز دستورت از موبدان"
  },
  {
    "poem_id": 1796,
    "vorder": 106,
    "position": 1,
    "text": "به دانش فزونست از بخردان"
  },
  {
    "poem_id": 1796,
    "vorder": 107,
    "position": 0,
    "text": "همه فیلسوفان ورا بنده‌اند"
  },
  {
    "poem_id": 1796,
    "vorder": 108,
    "position": 1,
    "text": "به دانایی او سرافگنده‌اند"
  },
  {
    "poem_id": 1796,
    "vorder": 109,
    "position": 0,
    "text": "چو بهرام بشنید شادی نمود"
  },
  {
    "poem_id": 1796,
    "vorder": 110,
    "position": 1,
    "text": "به دلش اندرون روشنایی فزود"
  },
  {
    "poem_id": 1796,
    "vorder": 111,
    "position": 0,
    "text": "به موبدم درم داد ده بدره نیز"
  },
  {
    "poem_id": 1796,
    "vorder": 112,
    "position": 1,
    "text": "همان جامه و اسپ و بسیار چیز"
  },
  {
    "poem_id": 1796,
    "vorder": 113,
    "position": 0,
    "text": "وزانجا خرامان بیامد بدر"
  },
  {
    "poem_id": 1796,
    "vorder": 114,
    "position": 1,
    "text": "خرد یافته موبد پرهنر"
  },
  {
    "poem_id": 1796,
    "vorder": 115,
    "position": 0,
    "text": "فرستادهٔ قیصر نامدار"
  },
  {
    "poem_id": 1796,
    "vorder": 116,
    "position": 1,
    "text": "سوی خانه رفت از بر شهریار"
  }
]