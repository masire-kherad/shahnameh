[
  {
    "poem_id": 1480,
    "vorder": 1,
    "position": 0,
    "text": "کنون ای سخن‌گوی بیدارمغز"
  },
  {
    "poem_id": 1480,
    "vorder": 2,
    "position": 1,
    "text": "یکی داستانی بیارای نغز"
  },
  {
    "poem_id": 1480,
    "vorder": 3,
    "position": 0,
    "text": "سخن چون برابر شود با خرد"
  },
  {
    "poem_id": 1480,
    "vorder": 4,
    "position": 1,
    "text": "روان سراینده رامش برد"
  },
  {
    "poem_id": 1480,
    "vorder": 5,
    "position": 0,
    "text": "کسی را که اندیشه ناخَوش بود"
  },
  {
    "poem_id": 1480,
    "vorder": 6,
    "position": 1,
    "text": "بدان ناخوشی رای او گَش بود"
  },
  {
    "poem_id": 1480,
    "vorder": 7,
    "position": 0,
    "text": "همی خویشتن را چلیپا کند"
  },
  {
    "poem_id": 1480,
    "vorder": 8,
    "position": 1,
    "text": "به پیش خردمند رسوا کند"
  },
  {
    "poem_id": 1480,
    "vorder": 9,
    "position": 0,
    "text": "ولیکن نبیند کس آهوی خویش"
  },
  {
    "poem_id": 1480,
    "vorder": 10,
    "position": 1,
    "text": "ترا روشن آید همه خوی خویش"
  },
  {
    "poem_id": 1480,
    "vorder": 11,
    "position": 0,
    "text": "اگر داد باید که ماند بجای"
  },
  {
    "poem_id": 1480,
    "vorder": 12,
    "position": 1,
    "text": "بیارای ازین پس بدانا نمای"
  },
  {
    "poem_id": 1480,
    "vorder": 13,
    "position": 0,
    "text": "چو دانا پسندد پسندیده گشت"
  },
  {
    "poem_id": 1480,
    "vorder": 14,
    "position": 1,
    "text": "به جوی تو در، آب چون دیده گشت"
  },
  {
    "poem_id": 1480,
    "vorder": 15,
    "position": 0,
    "text": "ز گفتار دهقان کنون داستان"
  },
  {
    "poem_id": 1480,
    "vorder": 16,
    "position": 1,
    "text": "تو برخوان و برگوی با راستان"
  },
  {
    "poem_id": 1480,
    "vorder": 17,
    "position": 0,
    "text": "کهن‌گشته این داستانها ز من"
  },
  {
    "poem_id": 1480,
    "vorder": 18,
    "position": 1,
    "text": "همی نو شود بر سر انجمن"
  },
  {
    "poem_id": 1480,
    "vorder": 19,
    "position": 0,
    "text": "اگر زندگانی بود دیریاز"
  },
  {
    "poem_id": 1480,
    "vorder": 20,
    "position": 1,
    "text": "برین دین خرم بمانم دراز"
  },
  {
    "poem_id": 1480,
    "vorder": 21,
    "position": 0,
    "text": "یکی میوه‌داری بماند ز من"
  },
  {
    "poem_id": 1480,
    "vorder": 22,
    "position": 1,
    "text": "که بارد همی بار او بر چمن"
  },
  {
    "poem_id": 1480,
    "vorder": 23,
    "position": 0,
    "text": "ازان پس که بنمود پنچاه و هشت"
  },
  {
    "poem_id": 1480,
    "vorder": 24,
    "position": 1,
    "text": "بسر بر فراوان شگفتی گذشت"
  },
  {
    "poem_id": 1480,
    "vorder": 25,
    "position": 0,
    "text": "همی آز کمتر نگردد بسال"
  },
  {
    "poem_id": 1480,
    "vorder": 26,
    "position": 1,
    "text": "همی روز جوید بتقویم و فال"
  },
  {
    "poem_id": 1480,
    "vorder": 27,
    "position": 0,
    "text": "چه گفتست آن موبد پیش‌رو"
  },
  {
    "poem_id": 1480,
    "vorder": 28,
    "position": 1,
    "text": "که هرگز نگردد کهن‌گشته نو"
  },
  {
    "poem_id": 1480,
    "vorder": 29,
    "position": 0,
    "text": "تو چندان که گویی سخن‌گوی باش"
  },
  {
    "poem_id": 1480,
    "vorder": 30,
    "position": 1,
    "text": "خردمند باش و جهانجوی باش"
  },
  {
    "poem_id": 1480,
    "vorder": 31,
    "position": 0,
    "text": "چو رفتی سر و کار با ایزدست"
  },
  {
    "poem_id": 1480,
    "vorder": 32,
    "position": 1,
    "text": "اگر نیک باشدت جای ار بَدَست"
  },
  {
    "poem_id": 1480,
    "vorder": 33,
    "position": 0,
    "text": "نگر تا چه کاری، همان بدروی"
  },
  {
    "poem_id": 1480,
    "vorder": 34,
    "position": 1,
    "text": "سخن هرچه گویی، همان بشنوی"
  },
  {
    "poem_id": 1480,
    "vorder": 35,
    "position": 0,
    "text": "درشتی ز کس نشنود نرم‌گوی"
  },
  {
    "poem_id": 1480,
    "vorder": 36,
    "position": 1,
    "text": "به جز نیکوی در زمانه مجوی"
  },
  {
    "poem_id": 1480,
    "vorder": 37,
    "position": 0,
    "text": "به گفتار دهقان کنون بازگرد"
  },
  {
    "poem_id": 1480,
    "vorder": 38,
    "position": 1,
    "text": "نگر تا چه گوید سراینده مرد"
  }
]