[
  {
    "poem_id": 1704,
    "vorder": 1,
    "position": 0,
    "text": "به جهرم یکی مرد بد بدنژاد"
  },
  {
    "poem_id": 1704,
    "vorder": 2,
    "position": 1,
    "text": "کجا نام او مهرک نوش‌زاد"
  },
  {
    "poem_id": 1704,
    "vorder": 3,
    "position": 0,
    "text": "چو آگه شد از رفتن اردشیر"
  },
  {
    "poem_id": 1704,
    "vorder": 4,
    "position": 1,
    "text": "وزان ماندن او بران آبگیر"
  },
  {
    "poem_id": 1704,
    "vorder": 5,
    "position": 0,
    "text": "ز تنگی که بد اندر آن رزمگاه"
  },
  {
    "poem_id": 1704,
    "vorder": 6,
    "position": 1,
    "text": "ز بهر خورشها برو بسته راه"
  },
  {
    "poem_id": 1704,
    "vorder": 7,
    "position": 0,
    "text": "ز جهرم بیامد به ایوان شاه"
  },
  {
    "poem_id": 1704,
    "vorder": 8,
    "position": 1,
    "text": "ز هر سو بیاورد بی‌مر سپاه"
  },
  {
    "poem_id": 1704,
    "vorder": 9,
    "position": 0,
    "text": "همه گنج او را به تاراج داد"
  },
  {
    "poem_id": 1704,
    "vorder": 10,
    "position": 1,
    "text": "به لشکر بسی بدره و تاج داد"
  },
  {
    "poem_id": 1704,
    "vorder": 11,
    "position": 0,
    "text": "چو آگاهی آمد به شاه اردشیر"
  },
  {
    "poem_id": 1704,
    "vorder": 12,
    "position": 1,
    "text": "پراندیشه شد بر لب آبگیر"
  },
  {
    "poem_id": 1704,
    "vorder": 13,
    "position": 0,
    "text": "همی گفت ناساخته خانه را"
  },
  {
    "poem_id": 1704,
    "vorder": 14,
    "position": 1,
    "text": "چرا ساختم رزم بیگانه را"
  },
  {
    "poem_id": 1704,
    "vorder": 15,
    "position": 0,
    "text": "بزرگان لشکرش را پیش خواند"
  },
  {
    "poem_id": 1704,
    "vorder": 16,
    "position": 1,
    "text": "ز مهرک فراوان سخنها براند"
  },
  {
    "poem_id": 1704,
    "vorder": 17,
    "position": 0,
    "text": "چه بینید گفت ای سران سپاه"
  },
  {
    "poem_id": 1704,
    "vorder": 18,
    "position": 1,
    "text": "که ما را چنین تنگ شد دستگاه"
  },
  {
    "poem_id": 1704,
    "vorder": 19,
    "position": 0,
    "text": "چشیدم بسی تلخی روزگار"
  },
  {
    "poem_id": 1704,
    "vorder": 20,
    "position": 1,
    "text": "نبد رنج مهرک مرا در شمار"
  },
  {
    "poem_id": 1704,
    "vorder": 21,
    "position": 0,
    "text": "به آواز گفتند کای شهریار"
  },
  {
    "poem_id": 1704,
    "vorder": 22,
    "position": 1,
    "text": "مبیناد چشمت بد روزگار"
  },
  {
    "poem_id": 1704,
    "vorder": 23,
    "position": 0,
    "text": "چو مهرک بود دشمن اندر نهان"
  },
  {
    "poem_id": 1704,
    "vorder": 24,
    "position": 1,
    "text": "چرا جست باید به سختی جهان"
  },
  {
    "poem_id": 1704,
    "vorder": 25,
    "position": 0,
    "text": "تو داری بزرگی و گیهان تراست"
  },
  {
    "poem_id": 1704,
    "vorder": 26,
    "position": 1,
    "text": "همه بندگانیم و فرمان تراست"
  },
  {
    "poem_id": 1704,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود تا خوان بیاراستند"
  },
  {
    "poem_id": 1704,
    "vorder": 28,
    "position": 1,
    "text": "می و جام و رامشگران خواستند"
  },
  {
    "poem_id": 1704,
    "vorder": 29,
    "position": 0,
    "text": "به خوان بر نهادند چندی بره"
  },
  {
    "poem_id": 1704,
    "vorder": 30,
    "position": 1,
    "text": "به خوردن نهادند سر یکسره"
  },
  {
    "poem_id": 1704,
    "vorder": 31,
    "position": 0,
    "text": "چو نان را به خوردن گرفت اردشیر"
  },
  {
    "poem_id": 1704,
    "vorder": 32,
    "position": 1,
    "text": "همانگه بیامد یکی تیز تیر"
  },
  {
    "poem_id": 1704,
    "vorder": 33,
    "position": 0,
    "text": "نشست اندران پاک فربه بره"
  },
  {
    "poem_id": 1704,
    "vorder": 34,
    "position": 1,
    "text": "که تیر اندرو غرقه شد یکسره"
  },
  {
    "poem_id": 1704,
    "vorder": 35,
    "position": 0,
    "text": "بزرگان فرزانهٔ رزمساز"
  },
  {
    "poem_id": 1704,
    "vorder": 36,
    "position": 1,
    "text": "ز نان داشتند آن زمان دست باز"
  },
  {
    "poem_id": 1704,
    "vorder": 37,
    "position": 0,
    "text": "بدیدند نقشی بران تیز تیر"
  },
  {
    "poem_id": 1704,
    "vorder": 38,
    "position": 1,
    "text": "بخواند آنک بد زان بزرگان دبیر"
  },
  {
    "poem_id": 1704,
    "vorder": 39,
    "position": 0,
    "text": "ز غم هرکسی از جگر خون کشید"
  },
  {
    "poem_id": 1704,
    "vorder": 40,
    "position": 1,
    "text": "یکی از بره تیر بیرون کشید"
  },
  {
    "poem_id": 1704,
    "vorder": 41,
    "position": 0,
    "text": "نوشته بران تیر بر پهلوی"
  },
  {
    "poem_id": 1704,
    "vorder": 42,
    "position": 1,
    "text": "که ای شاه داننده گر بشنوی"
  },
  {
    "poem_id": 1704,
    "vorder": 43,
    "position": 0,
    "text": "چنین تیز تیر آمد از بام دژ"
  },
  {
    "poem_id": 1704,
    "vorder": 44,
    "position": 1,
    "text": "که از بخت کرمست آرام دژ"
  },
  {
    "poem_id": 1704,
    "vorder": 45,
    "position": 0,
    "text": "گر انداختیمی بر اردشیر"
  },
  {
    "poem_id": 1704,
    "vorder": 46,
    "position": 1,
    "text": "بروبر گذر یافتی پر تیر"
  },
  {
    "poem_id": 1704,
    "vorder": 47,
    "position": 0,
    "text": "نباید که چون او یکی شهریار"
  },
  {
    "poem_id": 1704,
    "vorder": 48,
    "position": 1,
    "text": "کند پست کرم اندرین روزگار"
  },
  {
    "poem_id": 1704,
    "vorder": 49,
    "position": 0,
    "text": "بران موبدان نامدار اردشیر"
  },
  {
    "poem_id": 1704,
    "vorder": 50,
    "position": 1,
    "text": "نوشته همی خواند آن چوب تیر"
  },
  {
    "poem_id": 1704,
    "vorder": 51,
    "position": 0,
    "text": "ز دژ تا بر او دو فرسنگ بود"
  },
  {
    "poem_id": 1704,
    "vorder": 52,
    "position": 1,
    "text": "دل مهتران زان سخن تنگ بود"
  },
  {
    "poem_id": 1704,
    "vorder": 53,
    "position": 0,
    "text": "همی هر کسی خواندند آفرین"
  },
  {
    "poem_id": 1704,
    "vorder": 54,
    "position": 1,
    "text": "ز دادار بر فر شاه زمین"
  }
]