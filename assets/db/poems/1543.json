[
  {
    "poem_id": 1543,
    "vorder": 1,
    "position": 0,
    "text": "بدو داد پس شاه بهزاد را"
  },
  {
    "poem_id": 1543,
    "vorder": 2,
    "position": 1,
    "text": "سپه جوشن و خود پولاد را"
  },
  {
    "poem_id": 1543,
    "vorder": 3,
    "position": 0,
    "text": "پس شاه کشته میان را ببست"
  },
  {
    "poem_id": 1543,
    "vorder": 4,
    "position": 1,
    "text": "سیه رنگ بهزاد را برنشست"
  },
  {
    "poem_id": 1543,
    "vorder": 5,
    "position": 0,
    "text": "خرامید تا رزمگاه سپاه"
  },
  {
    "poem_id": 1543,
    "vorder": 6,
    "position": 1,
    "text": "نشسته بران خوب رنگ سیاه"
  },
  {
    "poem_id": 1543,
    "vorder": 7,
    "position": 0,
    "text": "به پیش صف دشمنان ایستاد"
  },
  {
    "poem_id": 1543,
    "vorder": 8,
    "position": 1,
    "text": "همی برکشید از جگر سرد باد"
  },
  {
    "poem_id": 1543,
    "vorder": 9,
    "position": 0,
    "text": "منم گفت بستور پور زریر"
  },
  {
    "poem_id": 1543,
    "vorder": 10,
    "position": 1,
    "text": "پذیره نیاید مرا نره شیر"
  },
  {
    "poem_id": 1543,
    "vorder": 11,
    "position": 0,
    "text": "کجا باشد آن جادوی بیدرفش"
  },
  {
    "poem_id": 1543,
    "vorder": 12,
    "position": 1,
    "text": "که بردست آن جمشیدی درفش"
  },
  {
    "poem_id": 1543,
    "vorder": 13,
    "position": 0,
    "text": "چو پاسخ ندادند آزاد را"
  },
  {
    "poem_id": 1543,
    "vorder": 14,
    "position": 1,
    "text": "برانگیخت شبرنگ بهزاد را"
  },
  {
    "poem_id": 1543,
    "vorder": 15,
    "position": 0,
    "text": "بکشت از تگینان لشکر بسی"
  },
  {
    "poem_id": 1543,
    "vorder": 16,
    "position": 1,
    "text": "پذیره نیامد مر او را کسی"
  },
  {
    "poem_id": 1543,
    "vorder": 17,
    "position": 0,
    "text": "وزان سوی دیگر گو اسفندیار"
  },
  {
    "poem_id": 1543,
    "vorder": 18,
    "position": 1,
    "text": "همی کشتشان بی‌مر و بی‌شمار"
  },
  {
    "poem_id": 1543,
    "vorder": 19,
    "position": 0,
    "text": "چو سالار چین دید بستور را"
  },
  {
    "poem_id": 1543,
    "vorder": 20,
    "position": 1,
    "text": "کیان زاده آن پهلوان پور را"
  },
  {
    "poem_id": 1543,
    "vorder": 21,
    "position": 0,
    "text": "به لشکر بگفت این که شاید بدن"
  },
  {
    "poem_id": 1543,
    "vorder": 22,
    "position": 1,
    "text": "کزین سان همی نیزه داند زدن"
  },
  {
    "poem_id": 1543,
    "vorder": 23,
    "position": 0,
    "text": "بکشت از تگینان من بی‌شمار"
  },
  {
    "poem_id": 1543,
    "vorder": 24,
    "position": 1,
    "text": "مگر گشت زنده زریر سوار"
  },
  {
    "poem_id": 1543,
    "vorder": 25,
    "position": 0,
    "text": "که نزد من آمد زریر از نخست"
  },
  {
    "poem_id": 1543,
    "vorder": 26,
    "position": 1,
    "text": "برین سان همی تاخت باره درست"
  },
  {
    "poem_id": 1543,
    "vorder": 27,
    "position": 0,
    "text": "کجا رفت آن بیدرفش گزین"
  },
  {
    "poem_id": 1543,
    "vorder": 28,
    "position": 1,
    "text": "هم‌اکنون سوی منش خوانید هین"
  },
  {
    "poem_id": 1543,
    "vorder": 29,
    "position": 0,
    "text": "بخواندند و آمد دمان بیدرفش"
  },
  {
    "poem_id": 1543,
    "vorder": 30,
    "position": 1,
    "text": "گرفته به دست آن درفش بنفش"
  },
  {
    "poem_id": 1543,
    "vorder": 31,
    "position": 0,
    "text": "نشسته بران بارهٔ خسروی"
  },
  {
    "poem_id": 1543,
    "vorder": 32,
    "position": 1,
    "text": "بپوشیده آن جوشن پهلوی"
  },
  {
    "poem_id": 1543,
    "vorder": 33,
    "position": 0,
    "text": "خرامید تا پیش لشکر ز شاه"
  },
  {
    "poem_id": 1543,
    "vorder": 34,
    "position": 1,
    "text": "نگهبان مرز و نگهبان گاه"
  },
  {
    "poem_id": 1543,
    "vorder": 35,
    "position": 0,
    "text": "گرفته همان تیغ زهر آبدار"
  },
  {
    "poem_id": 1543,
    "vorder": 36,
    "position": 1,
    "text": "که افگنده بد آن زریر سوار"
  },
  {
    "poem_id": 1543,
    "vorder": 37,
    "position": 0,
    "text": "بگشتند هر دو به ژوپین و تیر"
  },
  {
    "poem_id": 1543,
    "vorder": 38,
    "position": 1,
    "text": "سر جادوان ترک و پور زریر"
  },
  {
    "poem_id": 1543,
    "vorder": 39,
    "position": 0,
    "text": "پس آگاه کردند زان کارزار"
  },
  {
    "poem_id": 1543,
    "vorder": 40,
    "position": 1,
    "text": "پس شاه را فرخ اسفندیار"
  },
  {
    "poem_id": 1543,
    "vorder": 41,
    "position": 0,
    "text": "همی تاختش تا بدیشان رسید"
  },
  {
    "poem_id": 1543,
    "vorder": 42,
    "position": 1,
    "text": "سر جادوان چون مر او را بدید"
  },
  {
    "poem_id": 1543,
    "vorder": 43,
    "position": 0,
    "text": "برافگند اسپ از میان نبرد"
  },
  {
    "poem_id": 1543,
    "vorder": 44,
    "position": 1,
    "text": "بدانست کش بر سر افتاد مرد"
  },
  {
    "poem_id": 1543,
    "vorder": 45,
    "position": 0,
    "text": "بینداخت آن زهر خورده به روی"
  },
  {
    "poem_id": 1543,
    "vorder": 46,
    "position": 1,
    "text": "مگر کس کند زشت رخشنده روی"
  },
  {
    "poem_id": 1543,
    "vorder": 47,
    "position": 0,
    "text": "نیامد برو تیغ زهر آبدار"
  },
  {
    "poem_id": 1543,
    "vorder": 48,
    "position": 1,
    "text": "گرفتش همان تیغ شاه استوار"
  },
  {
    "poem_id": 1543,
    "vorder": 49,
    "position": 0,
    "text": "زدش پهلوانی یکی بر جگر"
  },
  {
    "poem_id": 1543,
    "vorder": 50,
    "position": 1,
    "text": "چنان کز دگر سو برون کرد سر"
  },
  {
    "poem_id": 1543,
    "vorder": 51,
    "position": 0,
    "text": "چو آهو ز باره در افتاد و مرد"
  },
  {
    "poem_id": 1543,
    "vorder": 52,
    "position": 1,
    "text": "بدید از کیان زادگان دستبرد"
  },
  {
    "poem_id": 1543,
    "vorder": 53,
    "position": 0,
    "text": "فرود آمد از باره اسفندیار"
  },
  {
    "poem_id": 1543,
    "vorder": 54,
    "position": 1,
    "text": "سلیح زریر آن گزیده سوار"
  },
  {
    "poem_id": 1543,
    "vorder": 55,
    "position": 0,
    "text": "ازان جادوی پیر بیرون کشید"
  },
  {
    "poem_id": 1543,
    "vorder": 56,
    "position": 1,
    "text": "سرش را ز نیمه‌تن اندر برید"
  },
  {
    "poem_id": 1543,
    "vorder": 57,
    "position": 0,
    "text": "نکو رنگ بارهٔ زریر و درفش"
  },
  {
    "poem_id": 1543,
    "vorder": 58,
    "position": 1,
    "text": "ببرد و سر بی‌هنر بیدرفش"
  },
  {
    "poem_id": 1543,
    "vorder": 59,
    "position": 0,
    "text": "سپاه کیان بانگ برداشتند"
  },
  {
    "poem_id": 1543,
    "vorder": 60,
    "position": 1,
    "text": "همی نعره از ابر بگذاشتند"
  },
  {
    "poem_id": 1543,
    "vorder": 61,
    "position": 0,
    "text": "که پیروز شد شاه و دشمن فگند"
  },
  {
    "poem_id": 1543,
    "vorder": 62,
    "position": 1,
    "text": "بشد بازآورد اسپ سمند"
  },
  {
    "poem_id": 1543,
    "vorder": 63,
    "position": 0,
    "text": "شد آن شاهزاده سوار دلیر"
  },
  {
    "poem_id": 1543,
    "vorder": 64,
    "position": 1,
    "text": "سوی شاه برد آن سمند زریر"
  },
  {
    "poem_id": 1543,
    "vorder": 65,
    "position": 0,
    "text": "سر پیر جادوش بنهاد پیش"
  },
  {
    "poem_id": 1543,
    "vorder": 66,
    "position": 1,
    "text": "کشنده بکشت اینت آیین و کیش"
  }
]