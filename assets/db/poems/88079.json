[
  {
    "poem_id": 88079,
    "vorder": 1,
    "position": 0,
    "text": "وز آن پس بیامد خرامان دبیر"
  },
  {
    "poem_id": 88079,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد قرطاس و مشک و عبیر"
  },
  {
    "poem_id": 88079,
    "vorder": 3,
    "position": 0,
    "text": "نبشتند نامه که از کردگار"
  },
  {
    "poem_id": 88079,
    "vorder": 4,
    "position": 1,
    "text": "به دادیم و خشنود از روزگار"
  },
  {
    "poem_id": 88079,
    "vorder": 5,
    "position": 0,
    "text": "که فرزند ما گشت پیروزبخت"
  },
  {
    "poem_id": 88079,
    "vorder": 6,
    "position": 1,
    "text": "سزای مهی وز در تاج و تخت"
  },
  {
    "poem_id": 88079,
    "vorder": 7,
    "position": 0,
    "text": "بدی را که گیتی همی ننگ داشت"
  },
  {
    "poem_id": 88079,
    "vorder": 8,
    "position": 1,
    "text": "جهان را پر از غارت و جنگ داشت"
  },
  {
    "poem_id": 88079,
    "vorder": 9,
    "position": 0,
    "text": "ز دست تو آواره شد در جهان"
  },
  {
    "poem_id": 88079,
    "vorder": 10,
    "position": 1,
    "text": "نگویند نامش جز اندر نهان"
  },
  {
    "poem_id": 88079,
    "vorder": 11,
    "position": 0,
    "text": "همه ساله تا بود خونریز بود"
  },
  {
    "poem_id": 88079,
    "vorder": 12,
    "position": 1,
    "text": "به بدنامی و زشتی آویز بود"
  },
  {
    "poem_id": 88079,
    "vorder": 13,
    "position": 0,
    "text": "بزد گردن نوذر تاجدار"
  },
  {
    "poem_id": 88079,
    "vorder": 14,
    "position": 1,
    "text": "ز شاهان وز راستان یادگار"
  },
  {
    "poem_id": 88079,
    "vorder": 15,
    "position": 0,
    "text": "برادرکش و بدتن و شاه کش"
  },
  {
    "poem_id": 88079,
    "vorder": 16,
    "position": 1,
    "text": "بداندیش و بدراه و آشفته هش"
  },
  {
    "poem_id": 88079,
    "vorder": 17,
    "position": 0,
    "text": "پی او ممان تا نهد بر زمین"
  },
  {
    "poem_id": 88079,
    "vorder": 18,
    "position": 1,
    "text": "به توران و مکران و دریای چین"
  },
  {
    "poem_id": 88079,
    "vorder": 19,
    "position": 0,
    "text": "جهان را مگر زو رهایی بود"
  },
  {
    "poem_id": 88079,
    "vorder": 20,
    "position": 1,
    "text": "سر بی بهایش بهایی بود"
  },
  {
    "poem_id": 88079,
    "vorder": 21,
    "position": 0,
    "text": "اگر داور دادگر یک خدای"
  },
  {
    "poem_id": 88079,
    "vorder": 22,
    "position": 1,
    "text": "همی بود خواهد ترا رهنمای"
  },
  {
    "poem_id": 88079,
    "vorder": 23,
    "position": 0,
    "text": "که گیتی بشویی ز رنج بدان"
  },
  {
    "poem_id": 88079,
    "vorder": 24,
    "position": 1,
    "text": "ز گفتار و کردار نابخردان"
  },
  {
    "poem_id": 88079,
    "vorder": 25,
    "position": 0,
    "text": "بداد جهان آفرین شاد باش"
  },
  {
    "poem_id": 88079,
    "vorder": 26,
    "position": 1,
    "text": "جهان را یکی تازه بنیاد باش"
  },
  {
    "poem_id": 88079,
    "vorder": 27,
    "position": 0,
    "text": "مگر باز بینم تو را شادمان"
  },
  {
    "poem_id": 88079,
    "vorder": 28,
    "position": 1,
    "text": "پر از درد گردد دل بدگمان"
  },
  {
    "poem_id": 88079,
    "vorder": 29,
    "position": 0,
    "text": "وز این پس جز از پیش یزدان پاک"
  },
  {
    "poem_id": 88079,
    "vorder": 30,
    "position": 1,
    "text": "نباشم کز اویست امید و باک"
  },
  {
    "poem_id": 88079,
    "vorder": 31,
    "position": 0,
    "text": "بدان تا تو پیروز باشی و شاد"
  },
  {
    "poem_id": 88079,
    "vorder": 32,
    "position": 1,
    "text": "سرت سبز باد و دلت پر ز داد"
  },
  {
    "poem_id": 88079,
    "vorder": 33,
    "position": 0,
    "text": "جهان آفرین رهنمای تو باد"
  },
  {
    "poem_id": 88079,
    "vorder": 34,
    "position": 1,
    "text": "همیشه سر تخت جای تو باد"
  },
  {
    "poem_id": 88079,
    "vorder": 35,
    "position": 0,
    "text": "نهادند بر نامه بر مهر شاه"
  },
  {
    "poem_id": 88079,
    "vorder": 36,
    "position": 1,
    "text": "بر ایوان شه گیو بگزید راه"
  },
  {
    "poem_id": 88079,
    "vorder": 37,
    "position": 0,
    "text": "به ره بر نبودش به جایی درنگ"
  },
  {
    "poem_id": 88079,
    "vorder": 38,
    "position": 1,
    "text": "به نزدیک کیخسرو آمد به گنگ"
  },
  {
    "poem_id": 88079,
    "vorder": 39,
    "position": 0,
    "text": "بر او آفرین کرد و نامه بداد"
  },
  {
    "poem_id": 88079,
    "vorder": 40,
    "position": 1,
    "text": "پیام نیا پیش او کرد یاد"
  },
  {
    "poem_id": 88079,
    "vorder": 41,
    "position": 0,
    "text": "ز گفتار او شاد شد شهریار"
  },
  {
    "poem_id": 88079,
    "vorder": 42,
    "position": 1,
    "text": "می‌ آورد و رامشگر و میگسار"
  },
  {
    "poem_id": 88079,
    "vorder": 43,
    "position": 0,
    "text": "همی خورد پیروز و شادان سه روز"
  },
  {
    "poem_id": 88079,
    "vorder": 44,
    "position": 1,
    "text": "چهارم چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 88079,
    "vorder": 45,
    "position": 0,
    "text": "سپه را همه ترک و جوشن بداد"
  },
  {
    "poem_id": 88079,
    "vorder": 46,
    "position": 1,
    "text": "پیام نیا پیششان کرد یاد"
  },
  {
    "poem_id": 88079,
    "vorder": 47,
    "position": 0,
    "text": "مر آن را به گستهم نوذر سپرد"
  },
  {
    "poem_id": 88079,
    "vorder": 48,
    "position": 1,
    "text": "یکی لشکری نامبردار و گرد"
  },
  {
    "poem_id": 88079,
    "vorder": 49,
    "position": 0,
    "text": "ز گنگ گزین راه چین برگرفت"
  },
  {
    "poem_id": 88079,
    "vorder": 50,
    "position": 1,
    "text": "جهان را به شمشیر در بر گرفت"
  },
  {
    "poem_id": 88079,
    "vorder": 51,
    "position": 0,
    "text": "نبد روز بیکار و تیره شبان"
  },
  {
    "poem_id": 88079,
    "vorder": 52,
    "position": 1,
    "text": "طلایه به روز و به شب پاسبان"
  },
  {
    "poem_id": 88079,
    "vorder": 53,
    "position": 0,
    "text": "بدین گونه تا شارستان پدر"
  },
  {
    "poem_id": 88079,
    "vorder": 54,
    "position": 1,
    "text": "همی رفت گریان و پر کینه سر"
  },
  {
    "poem_id": 88079,
    "vorder": 55,
    "position": 0,
    "text": "همی گرد باغ سیاوش بگشت"
  },
  {
    "poem_id": 88079,
    "vorder": 56,
    "position": 1,
    "text": "به جایی که بنهاد خونریز تشت"
  },
  {
    "poem_id": 88079,
    "vorder": 57,
    "position": 0,
    "text": "همی گفت کز داور یک خدای"
  },
  {
    "poem_id": 88079,
    "vorder": 58,
    "position": 1,
    "text": "بخواهم که باشد مرا رهنمای"
  },
  {
    "poem_id": 88079,
    "vorder": 59,
    "position": 0,
    "text": "مگر همچنین خون افراسیاب"
  },
  {
    "poem_id": 88079,
    "vorder": 60,
    "position": 1,
    "text": "هم ایدر بریزم به کردار آب"
  },
  {
    "poem_id": 88079,
    "vorder": 61,
    "position": 0,
    "text": "و ز آن جایگه شد سوی تخت باز"
  },
  {
    "poem_id": 88079,
    "vorder": 62,
    "position": 1,
    "text": "همی گفت با داور پاک راز"
  },
  {
    "poem_id": 88079,
    "vorder": 63,
    "position": 0,
    "text": "ز لشکر فرستادگان برگزید"
  },
  {
    "poem_id": 88079,
    "vorder": 64,
    "position": 1,
    "text": "که گویند و دانند گفت و شنید"
  },
  {
    "poem_id": 88079,
    "vorder": 65,
    "position": 0,
    "text": "فرستاد کس نزد خاقان چین"
  },
  {
    "poem_id": 88079,
    "vorder": 66,
    "position": 1,
    "text": "به فغفور و سالار مکران زمین"
  },
  {
    "poem_id": 88079,
    "vorder": 67,
    "position": 0,
    "text": "که گر داد گیرید و فرمان کنید"
  },
  {
    "poem_id": 88079,
    "vorder": 68,
    "position": 1,
    "text": "ز کردار بد دل پشیمان کنید"
  },
  {
    "poem_id": 88079,
    "vorder": 69,
    "position": 0,
    "text": "خورشها فرستید نزد سپاه"
  },
  {
    "poem_id": 88079,
    "vorder": 70,
    "position": 1,
    "text": "ببینید ناچار ما را به راه"
  },
  {
    "poem_id": 88079,
    "vorder": 71,
    "position": 0,
    "text": "کسی کو بتابد ز فرمان من"
  },
  {
    "poem_id": 88079,
    "vorder": 72,
    "position": 1,
    "text": "و گر دور باشد ز پیمان من"
  },
  {
    "poem_id": 88079,
    "vorder": 73,
    "position": 0,
    "text": "بیاراست باید سپه را به رزم"
  },
  {
    "poem_id": 88079,
    "vorder": 74,
    "position": 1,
    "text": "هر آن کس که بگریزد از راه بزم"
  },
  {
    "poem_id": 88079,
    "vorder": 75,
    "position": 0,
    "text": "فرستاده آمد به هر کشوری"
  },
  {
    "poem_id": 88079,
    "vorder": 76,
    "position": 1,
    "text": "به هر جا که بد نامور مهتری"
  },
  {
    "poem_id": 88079,
    "vorder": 77,
    "position": 0,
    "text": "غمی گشت فغفور و خاقان چین"
  },
  {
    "poem_id": 88079,
    "vorder": 78,
    "position": 1,
    "text": "بزرگان هر کشوری همچنین"
  },
  {
    "poem_id": 88079,
    "vorder": 79,
    "position": 0,
    "text": "فرستاده را چند گفتند گرم"
  },
  {
    "poem_id": 88079,
    "vorder": 80,
    "position": 1,
    "text": "سخنهای شیرین به آواز نرم"
  },
  {
    "poem_id": 88079,
    "vorder": 81,
    "position": 0,
    "text": "که ما شاه را سر به سر کهتریم"
  },
  {
    "poem_id": 88079,
    "vorder": 82,
    "position": 1,
    "text": "زمین جز به فرمان او نسپریم"
  },
  {
    "poem_id": 88079,
    "vorder": 83,
    "position": 0,
    "text": "گذرها که راه دلیران بدست"
  },
  {
    "poem_id": 88079,
    "vorder": 84,
    "position": 1,
    "text": "ببینیم تا چند ویران شدست"
  },
  {
    "poem_id": 88079,
    "vorder": 85,
    "position": 0,
    "text": "کنیم از سر آباد با خوردنی"
  },
  {
    "poem_id": 88079,
    "vorder": 86,
    "position": 1,
    "text": "بباشیم و آریمش آوردنی"
  },
  {
    "poem_id": 88079,
    "vorder": 87,
    "position": 0,
    "text": "همی گفت هر کس که بودش خرد"
  },
  {
    "poem_id": 88079,
    "vorder": 88,
    "position": 1,
    "text": "که گر بی زیان او به ما بگذرد"
  },
  {
    "poem_id": 88079,
    "vorder": 89,
    "position": 0,
    "text": "به درویش بخشیم بسیار چیز"
  },
  {
    "poem_id": 88079,
    "vorder": 90,
    "position": 1,
    "text": "نثار و خورشها بسازیم نیز"
  },
  {
    "poem_id": 88079,
    "vorder": 91,
    "position": 0,
    "text": "فرستاده را بی‌کران هدیه داد"
  },
  {
    "poem_id": 88079,
    "vorder": 92,
    "position": 1,
    "text": "بیامد به درگاه پیروز و شاد"
  },
  {
    "poem_id": 88079,
    "vorder": 93,
    "position": 0,
    "text": "دگر نامور چون به مکران رسید"
  },
  {
    "poem_id": 88079,
    "vorder": 94,
    "position": 1,
    "text": "دل شاه مکران دگرگونه دید"
  },
  {
    "poem_id": 88079,
    "vorder": 95,
    "position": 0,
    "text": "بر تخت او رفت و نامه بداد"
  },
  {
    "poem_id": 88079,
    "vorder": 96,
    "position": 1,
    "text": "بگفت از پیام آنچه بودش بیاد"
  },
  {
    "poem_id": 88079,
    "vorder": 97,
    "position": 0,
    "text": "سبک مر فرستاده را خوار کرد"
  },
  {
    "poem_id": 88079,
    "vorder": 98,
    "position": 1,
    "text": "دل انجمن پر ز تیمار کرد"
  },
  {
    "poem_id": 88079,
    "vorder": 99,
    "position": 0,
    "text": "بدو گفت با شاه ایران بگوی"
  },
  {
    "poem_id": 88079,
    "vorder": 100,
    "position": 1,
    "text": "که نادیده بر ما فزونی مجوی"
  },
  {
    "poem_id": 88079,
    "vorder": 101,
    "position": 0,
    "text": "زمانه همه زیر تخت منست"
  },
  {
    "poem_id": 88079,
    "vorder": 102,
    "position": 1,
    "text": "جهان روشن از فر بخت منست"
  },
  {
    "poem_id": 88079,
    "vorder": 103,
    "position": 0,
    "text": "چو خورشید تابان شود بر سپهر"
  },
  {
    "poem_id": 88079,
    "vorder": 104,
    "position": 1,
    "text": "نخستین بر این بوم تابد به مهر"
  },
  {
    "poem_id": 88079,
    "vorder": 105,
    "position": 0,
    "text": "همم دانش و گنج آباد هست"
  },
  {
    "poem_id": 88079,
    "vorder": 106,
    "position": 1,
    "text": "بزرگی و مردی و نیروی دست"
  },
  {
    "poem_id": 88079,
    "vorder": 107,
    "position": 0,
    "text": "گر از من همی راه جوید رواست"
  },
  {
    "poem_id": 88079,
    "vorder": 108,
    "position": 1,
    "text": "که هر جانور بر زمین پادشاست"
  },
  {
    "poem_id": 88079,
    "vorder": 109,
    "position": 0,
    "text": "نبندیم اگر بگذری بر تو راه"
  },
  {
    "poem_id": 88079,
    "vorder": 110,
    "position": 1,
    "text": "زیانی مکن بر گذر با سپاه"
  },
  {
    "poem_id": 88079,
    "vorder": 111,
    "position": 0,
    "text": "ور ایدون که با لشکر آیی به شهر"
  },
  {
    "poem_id": 88079,
    "vorder": 112,
    "position": 1,
    "text": "بر این پادشاهی ترا نیست بهر"
  },
  {
    "poem_id": 88079,
    "vorder": 113,
    "position": 0,
    "text": "نمانم که بر بوم من بگذری"
  },
  {
    "poem_id": 88079,
    "vorder": 114,
    "position": 1,
    "text": "وز این مرز جایی به پی بسپری"
  },
  {
    "poem_id": 88079,
    "vorder": 115,
    "position": 0,
    "text": "نمانم که مانی تو پیروزگر"
  },
  {
    "poem_id": 88079,
    "vorder": 116,
    "position": 1,
    "text": "وگر یابی از اختر نیک بر"
  },
  {
    "poem_id": 88079,
    "vorder": 117,
    "position": 0,
    "text": "بر این گونه چون شاه پاسخ شنید"
  },
  {
    "poem_id": 88079,
    "vorder": 118,
    "position": 1,
    "text": "از آن جایگه لشکر اندر کشید"
  },
  {
    "poem_id": 88079,
    "vorder": 119,
    "position": 0,
    "text": "بیامد گرازان به سوی ختن"
  },
  {
    "poem_id": 88079,
    "vorder": 120,
    "position": 1,
    "text": "جهاندار با نامدار انجمن"
  },
  {
    "poem_id": 88079,
    "vorder": 121,
    "position": 0,
    "text": "برفتند فغفور و خاقان چین"
  },
  {
    "poem_id": 88079,
    "vorder": 122,
    "position": 1,
    "text": "بر شاه با پوزش و آفرین"
  },
  {
    "poem_id": 88079,
    "vorder": 123,
    "position": 0,
    "text": "سه منزل ز چین پیش شاه آمدند"
  },
  {
    "poem_id": 88079,
    "vorder": 124,
    "position": 1,
    "text": "خود و نامداران به راه آمدند"
  },
  {
    "poem_id": 88079,
    "vorder": 125,
    "position": 0,
    "text": "همه راه آباد کرده چو دست"
  },
  {
    "poem_id": 88079,
    "vorder": 126,
    "position": 1,
    "text": "در و دشت چون جایگاه نشست"
  },
  {
    "poem_id": 88079,
    "vorder": 127,
    "position": 0,
    "text": "همه بوم و بر پوشش و خوردنی"
  },
  {
    "poem_id": 88079,
    "vorder": 128,
    "position": 1,
    "text": "از آرایش بزم و گستردنی"
  },
  {
    "poem_id": 88079,
    "vorder": 129,
    "position": 0,
    "text": "چو نزدیک شاه اندر آمد سپاه"
  },
  {
    "poem_id": 88079,
    "vorder": 130,
    "position": 1,
    "text": "ببستند آذین به بیراه و راه"
  },
  {
    "poem_id": 88079,
    "vorder": 131,
    "position": 0,
    "text": "به دیوار دیبا برآویختند"
  },
  {
    "poem_id": 88079,
    "vorder": 132,
    "position": 1,
    "text": "ز بر زعفران و درم ریختند"
  },
  {
    "poem_id": 88079,
    "vorder": 133,
    "position": 0,
    "text": "چو با شاه فغفور گستاخ شد"
  },
  {
    "poem_id": 88079,
    "vorder": 134,
    "position": 1,
    "text": "به پیش اندر آمد سوی کاخ شد"
  },
  {
    "poem_id": 88079,
    "vorder": 135,
    "position": 0,
    "text": "بدو گفت ما شاه را کهتریم"
  },
  {
    "poem_id": 88079,
    "vorder": 136,
    "position": 1,
    "text": "اگر کهتری را خود اندر خوریم"
  },
  {
    "poem_id": 88079,
    "vorder": 137,
    "position": 0,
    "text": "جهانی به بخت تو آباد گشت"
  },
  {
    "poem_id": 88079,
    "vorder": 138,
    "position": 1,
    "text": "دل دوستداران تو شاد گشت"
  },
  {
    "poem_id": 88079,
    "vorder": 139,
    "position": 0,
    "text": "گر ایوان ما در خور شاه نیست"
  },
  {
    "poem_id": 88079,
    "vorder": 140,
    "position": 1,
    "text": "گمانم که هم بدتر از راه نیست"
  },
  {
    "poem_id": 88079,
    "vorder": 141,
    "position": 0,
    "text": "به کاخ اندر آمد سرافراز شاه"
  },
  {
    "poem_id": 88079,
    "vorder": 142,
    "position": 1,
    "text": "نشست از بر نامور پیشگاه"
  },
  {
    "poem_id": 88079,
    "vorder": 143,
    "position": 0,
    "text": "ز دینار چینی ز بهر نثار"
  },
  {
    "poem_id": 88079,
    "vorder": 144,
    "position": 1,
    "text": "بیاورد فغفور چین صد هزار"
  },
  {
    "poem_id": 88079,
    "vorder": 145,
    "position": 0,
    "text": "همی بود بر پیش او بر به پای"
  },
  {
    "poem_id": 88079,
    "vorder": 146,
    "position": 1,
    "text": "ابا مرزبانان فرخنده رای"
  },
  {
    "poem_id": 88079,
    "vorder": 147,
    "position": 0,
    "text": "به چین اندرون بود خسرو سه ماه"
  },
  {
    "poem_id": 88079,
    "vorder": 148,
    "position": 1,
    "text": "ابا نامداران ایران سپاه"
  },
  {
    "poem_id": 88079,
    "vorder": 149,
    "position": 0,
    "text": "پرستنده فغفور هر بامداد"
  },
  {
    "poem_id": 88079,
    "vorder": 150,
    "position": 1,
    "text": "همی نو به نو شاه را هدیه داد"
  },
  {
    "poem_id": 88079,
    "vorder": 151,
    "position": 0,
    "text": "چهارم ز چین شاه ایران براند"
  },
  {
    "poem_id": 88079,
    "vorder": 152,
    "position": 1,
    "text": "به مکران شد و رستم آنجا بماند"
  },
  {
    "poem_id": 88079,
    "vorder": 153,
    "position": 0,
    "text": "بیامد چو نزدیک مکران رسید"
  },
  {
    "poem_id": 88079,
    "vorder": 154,
    "position": 1,
    "text": "ز لشکر جهاندیده‌ای برگزید"
  },
  {
    "poem_id": 88079,
    "vorder": 155,
    "position": 0,
    "text": "بر شاه مکران فرستاد و گفت"
  },
  {
    "poem_id": 88079,
    "vorder": 156,
    "position": 1,
    "text": "که با شهریاران خرد باد جفت"
  },
  {
    "poem_id": 88079,
    "vorder": 157,
    "position": 0,
    "text": "خورش ساز راه سپاه مرا"
  },
  {
    "poem_id": 88079,
    "vorder": 158,
    "position": 1,
    "text": "به خوبی بیارای گاه مرا"
  },
  {
    "poem_id": 88079,
    "vorder": 159,
    "position": 0,
    "text": "نگه کن که ما از کجا رفته‌ایم"
  },
  {
    "poem_id": 88079,
    "vorder": 160,
    "position": 1,
    "text": "نه مستیم و بیراه و نه خفته‌ایم"
  },
  {
    "poem_id": 88079,
    "vorder": 161,
    "position": 0,
    "text": "جهان روشن از تاج و بخت منست"
  },
  {
    "poem_id": 88079,
    "vorder": 162,
    "position": 1,
    "text": "سر مهتران زیر تخت منست"
  },
  {
    "poem_id": 88079,
    "vorder": 163,
    "position": 0,
    "text": "برند آنگهی دست چیز کسان"
  },
  {
    "poem_id": 88079,
    "vorder": 164,
    "position": 1,
    "text": "مگر من نباشم به هر کس رسان"
  },
  {
    "poem_id": 88079,
    "vorder": 165,
    "position": 0,
    "text": "علف چون نیابند جنگ آورند"
  },
  {
    "poem_id": 88079,
    "vorder": 166,
    "position": 1,
    "text": "جهان بر بداندیش تنگ آورند"
  },
  {
    "poem_id": 88079,
    "vorder": 167,
    "position": 0,
    "text": "ور ایدون که گفتار من نشنوی"
  },
  {
    "poem_id": 88079,
    "vorder": 168,
    "position": 1,
    "text": "به خون فراوان کس اندر شوی"
  },
  {
    "poem_id": 88079,
    "vorder": 169,
    "position": 0,
    "text": "همه شهر مکران تو ویران کنی"
  },
  {
    "poem_id": 88079,
    "vorder": 170,
    "position": 1,
    "text": "چو بر کینه آهنگ شیران کنی"
  },
  {
    "poem_id": 88079,
    "vorder": 171,
    "position": 0,
    "text": "فرستاده آمد پیامش بداد"
  },
  {
    "poem_id": 88079,
    "vorder": 172,
    "position": 1,
    "text": "نبد بر دلش جای پیغام و داد"
  },
  {
    "poem_id": 88079,
    "vorder": 173,
    "position": 0,
    "text": "سر بی خرد زان سخن خیره شد"
  },
  {
    "poem_id": 88079,
    "vorder": 174,
    "position": 1,
    "text": "بجوشید و مغزش از آن تیره شد"
  },
  {
    "poem_id": 88079,
    "vorder": 175,
    "position": 0,
    "text": "پراگنده لشکر همه گرد کرد"
  },
  {
    "poem_id": 88079,
    "vorder": 176,
    "position": 1,
    "text": "بیاراست بر دشت جای نبرد"
  },
  {
    "poem_id": 88079,
    "vorder": 177,
    "position": 0,
    "text": "فرستاده را گفت برگرد و رو"
  },
  {
    "poem_id": 88079,
    "vorder": 178,
    "position": 1,
    "text": "به نزدیک آن بدگمان باز شو"
  },
  {
    "poem_id": 88079,
    "vorder": 179,
    "position": 0,
    "text": "بگویش که از گردش تیره روز"
  },
  {
    "poem_id": 88079,
    "vorder": 180,
    "position": 1,
    "text": "تو گشتی چنین شاد و گیتی فروز"
  },
  {
    "poem_id": 88079,
    "vorder": 181,
    "position": 0,
    "text": "ببینی چو آیی ز ما دستبرد"
  },
  {
    "poem_id": 88079,
    "vorder": 182,
    "position": 1,
    "text": "بدانی که مردان کدامند و گرد"
  }
]