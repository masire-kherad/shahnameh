[
  {
    "poem_id": 87981,
    "vorder": 1,
    "position": 0,
    "text": "درم داد و روزی‌دهان را بخواند"
  },
  {
    "poem_id": 87981,
    "vorder": 2,
    "position": 1,
    "text": "بسی با سپهبد سخنها براند"
  },
  {
    "poem_id": 87981,
    "vorder": 3,
    "position": 0,
    "text": "همان رای زد با تهمتن بر آن"
  },
  {
    "poem_id": 87981,
    "vorder": 4,
    "position": 1,
    "text": "چنین تا رخ روز شد در نهان"
  },
  {
    "poem_id": 87981,
    "vorder": 5,
    "position": 0,
    "text": "چو خورشید بر زد سنان از نشیب"
  },
  {
    "poem_id": 87981,
    "vorder": 6,
    "position": 1,
    "text": "شتاب آمد از رفتن با نهیب"
  },
  {
    "poem_id": 87981,
    "vorder": 7,
    "position": 0,
    "text": "سپهبد بیامد به نزدیک شاه"
  },
  {
    "poem_id": 87981,
    "vorder": 8,
    "position": 1,
    "text": "ابا گیو گودرز و چندی سپاه"
  },
  {
    "poem_id": 87981,
    "vorder": 9,
    "position": 0,
    "text": "بدو داد شاه اختر کاویان"
  },
  {
    "poem_id": 87981,
    "vorder": 10,
    "position": 1,
    "text": "بران سان که بودی به رسم کیان"
  },
  {
    "poem_id": 87981,
    "vorder": 11,
    "position": 0,
    "text": "ز اختر یکی روز فرخ بجست"
  },
  {
    "poem_id": 87981,
    "vorder": 12,
    "position": 1,
    "text": "که بیرون شدن را کی آید درست"
  },
  {
    "poem_id": 87981,
    "vorder": 13,
    "position": 0,
    "text": "همی رفت با کوس خسرو بدشت"
  },
  {
    "poem_id": 87981,
    "vorder": 14,
    "position": 1,
    "text": "بدان تا سپهبد بدو برگذشت"
  },
  {
    "poem_id": 87981,
    "vorder": 15,
    "position": 0,
    "text": "یکی لشکری همچو کوه سیاه"
  },
  {
    "poem_id": 87981,
    "vorder": 16,
    "position": 1,
    "text": "گذشتند بر پیش بیدار شاه"
  },
  {
    "poem_id": 87981,
    "vorder": 17,
    "position": 0,
    "text": "پس لشکر اندر سپهدار طوس"
  },
  {
    "poem_id": 87981,
    "vorder": 18,
    "position": 1,
    "text": "بیامد بر شه زمین داد بوس"
  },
  {
    "poem_id": 87981,
    "vorder": 19,
    "position": 0,
    "text": "برو آفرین کرد و بر شد خروش"
  },
  {
    "poem_id": 87981,
    "vorder": 20,
    "position": 1,
    "text": "جهان آمد از بانگ اسپان بجوش"
  },
  {
    "poem_id": 87981,
    "vorder": 21,
    "position": 0,
    "text": "یکی ابر بست از بر گرد سم"
  },
  {
    "poem_id": 87981,
    "vorder": 22,
    "position": 1,
    "text": "برآمد خروشیدن گاو دم"
  },
  {
    "poem_id": 87981,
    "vorder": 23,
    "position": 0,
    "text": "ز بس جوشن و کاویانی درفش"
  },
  {
    "poem_id": 87981,
    "vorder": 24,
    "position": 1,
    "text": "شده روی گیتی سراسر بنفش"
  },
  {
    "poem_id": 87981,
    "vorder": 25,
    "position": 0,
    "text": "تو خورشید گفتی به آب اندر است"
  },
  {
    "poem_id": 87981,
    "vorder": 26,
    "position": 1,
    "text": "سپهر و ستاره بخواب اندر است"
  },
  {
    "poem_id": 87981,
    "vorder": 27,
    "position": 0,
    "text": "نهاد از بر پیل پیروزه مهد"
  },
  {
    "poem_id": 87981,
    "vorder": 28,
    "position": 1,
    "text": "همی رفت زین گونه تا رود شهد"
  },
  {
    "poem_id": 87981,
    "vorder": 29,
    "position": 0,
    "text": "هیونی بکردار باد دمان"
  },
  {
    "poem_id": 87981,
    "vorder": 30,
    "position": 1,
    "text": "بدش نزد پیران هم اندر زمان"
  },
  {
    "poem_id": 87981,
    "vorder": 31,
    "position": 0,
    "text": "که من جنگ را گردن افراخته"
  },
  {
    "poem_id": 87981,
    "vorder": 32,
    "position": 1,
    "text": "سوی رود شهد آمدم ساخته"
  },
  {
    "poem_id": 87981,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید پیران غمی گشت سخت"
  },
  {
    "poem_id": 87981,
    "vorder": 34,
    "position": 1,
    "text": "فروبست بر پیل ناکام رخت"
  },
  {
    "poem_id": 87981,
    "vorder": 35,
    "position": 0,
    "text": "برون رفت با نامداران خویش"
  },
  {
    "poem_id": 87981,
    "vorder": 36,
    "position": 1,
    "text": "گزیده دلاور سواران خویش"
  },
  {
    "poem_id": 87981,
    "vorder": 37,
    "position": 0,
    "text": "که ایران سپه را ببیند که چیست"
  },
  {
    "poem_id": 87981,
    "vorder": 38,
    "position": 1,
    "text": "سرافراز چندست و با طوس کیست"
  },
  {
    "poem_id": 87981,
    "vorder": 39,
    "position": 0,
    "text": "رده برکشیدند زان سوی رود"
  },
  {
    "poem_id": 87981,
    "vorder": 40,
    "position": 1,
    "text": "فرستاد نزد سپهبد درود"
  },
  {
    "poem_id": 87981,
    "vorder": 41,
    "position": 0,
    "text": "وزین روی لشکر بیاورد طوس"
  },
  {
    "poem_id": 87981,
    "vorder": 42,
    "position": 1,
    "text": "درفش همایون و پیلان و کوس"
  },
  {
    "poem_id": 87981,
    "vorder": 43,
    "position": 0,
    "text": "سپهدار پیران یکی چرپ گوی"
  },
  {
    "poem_id": 87981,
    "vorder": 44,
    "position": 1,
    "text": "ز ترکان فرستاد نزدیک اوی"
  },
  {
    "poem_id": 87981,
    "vorder": 45,
    "position": 0,
    "text": "بگفت آنک من با فرنگیس و شاه"
  },
  {
    "poem_id": 87981,
    "vorder": 46,
    "position": 1,
    "text": "چه کردم ز خوبی بهر جایگاه"
  },
  {
    "poem_id": 87981,
    "vorder": 47,
    "position": 0,
    "text": "ز درد سیاوش خروشان بدم"
  },
  {
    "poem_id": 87981,
    "vorder": 48,
    "position": 1,
    "text": "چو بر آتش تیز جوشان بدم"
  },
  {
    "poem_id": 87981,
    "vorder": 49,
    "position": 0,
    "text": "کنون بار تریاک زهر آمدست"
  },
  {
    "poem_id": 87981,
    "vorder": 50,
    "position": 1,
    "text": "مرا زو همه رنج بهر آمدست"
  },
  {
    "poem_id": 87981,
    "vorder": 51,
    "position": 0,
    "text": "دل طوس غمگین شد از کار اوی"
  },
  {
    "poem_id": 87981,
    "vorder": 52,
    "position": 1,
    "text": "بپیچید زان درد و پیکار اوی"
  },
  {
    "poem_id": 87981,
    "vorder": 53,
    "position": 0,
    "text": "چنین داد پاسخ که از مهر تو"
  },
  {
    "poem_id": 87981,
    "vorder": 54,
    "position": 1,
    "text": "فراوان نشانست بر چهر تو"
  },
  {
    "poem_id": 87981,
    "vorder": 55,
    "position": 0,
    "text": "سر آزاد کن دور شو زین میان"
  },
  {
    "poem_id": 87981,
    "vorder": 56,
    "position": 1,
    "text": "ببند این در بیم و راه زیان"
  },
  {
    "poem_id": 87981,
    "vorder": 57,
    "position": 0,
    "text": "بر شاه ایران شوی با سپاه"
  },
  {
    "poem_id": 87981,
    "vorder": 58,
    "position": 1,
    "text": "مکافات یابی به نیکی ز شاه"
  },
  {
    "poem_id": 87981,
    "vorder": 59,
    "position": 0,
    "text": "بایران ترا پهلوانی دهد"
  },
  {
    "poem_id": 87981,
    "vorder": 60,
    "position": 1,
    "text": "همان افسر خسروانی دهد"
  },
  {
    "poem_id": 87981,
    "vorder": 61,
    "position": 0,
    "text": "چو یاد آیدش خوب کردار تو"
  },
  {
    "poem_id": 87981,
    "vorder": 62,
    "position": 1,
    "text": "دلش رنجه گردد ز تیمار تو"
  },
  {
    "poem_id": 87981,
    "vorder": 63,
    "position": 0,
    "text": "چنین گفت گودرز و گیو و سران"
  },
  {
    "poem_id": 87981,
    "vorder": 64,
    "position": 1,
    "text": "بزرگان و تیمارکش مهتران"
  },
  {
    "poem_id": 87981,
    "vorder": 65,
    "position": 0,
    "text": "سرایندهٔ پاسخ آمد چو باد"
  },
  {
    "poem_id": 87981,
    "vorder": 66,
    "position": 1,
    "text": "بنزدیک پیران ویسه نژاد"
  },
  {
    "poem_id": 87981,
    "vorder": 67,
    "position": 0,
    "text": "بگفت آنچ بشنید با پهلوان"
  },
  {
    "poem_id": 87981,
    "vorder": 68,
    "position": 1,
    "text": "ز طوس و ز گودرز روشن‌روان"
  },
  {
    "poem_id": 87981,
    "vorder": 69,
    "position": 0,
    "text": "چنین داد پاسخ که من روز و شب"
  },
  {
    "poem_id": 87981,
    "vorder": 70,
    "position": 1,
    "text": "بیاد سپهبد گشایم دو لب"
  },
  {
    "poem_id": 87981,
    "vorder": 71,
    "position": 0,
    "text": "شوم هرچ هستند پیوند من"
  },
  {
    "poem_id": 87981,
    "vorder": 72,
    "position": 1,
    "text": "خردمند کو بشنود پند من"
  },
  {
    "poem_id": 87981,
    "vorder": 73,
    "position": 0,
    "text": "بایران گذارم بر و بوم و رخت"
  },
  {
    "poem_id": 87981,
    "vorder": 74,
    "position": 1,
    "text": "سر نامور بهتر از تاج و تخت"
  },
  {
    "poem_id": 87981,
    "vorder": 75,
    "position": 0,
    "text": "وزین گفتتها بود مغزش تهی"
  },
  {
    "poem_id": 87981,
    "vorder": 76,
    "position": 1,
    "text": "همی جست نو روزگار بهی"
  },
  {
    "poem_id": 87981,
    "vorder": 77,
    "position": 0,
    "text": "هیونی برافگند هنگام خواب"
  },
  {
    "poem_id": 87981,
    "vorder": 78,
    "position": 1,
    "text": "فرستاد نزدیک افراسیاب"
  },
  {
    "poem_id": 87981,
    "vorder": 79,
    "position": 0,
    "text": "کزایران سپاه آمد و پیل و کوس"
  },
  {
    "poem_id": 87981,
    "vorder": 80,
    "position": 1,
    "text": "همان گیو و گودرز و رهام و طوس"
  },
  {
    "poem_id": 87981,
    "vorder": 81,
    "position": 0,
    "text": "فراوان فریبش فرستاده‌ام"
  },
  {
    "poem_id": 87981,
    "vorder": 82,
    "position": 1,
    "text": "ز هر گونه‌ای بندها داده‌ام"
  },
  {
    "poem_id": 87981,
    "vorder": 83,
    "position": 0,
    "text": "سپاهی ز جنگاوران برگزین"
  },
  {
    "poem_id": 87981,
    "vorder": 84,
    "position": 1,
    "text": "که بر زین شتابش بیاید ز کین"
  },
  {
    "poem_id": 87981,
    "vorder": 85,
    "position": 0,
    "text": "مگر بومشان از بنه برکنیم"
  },
  {
    "poem_id": 87981,
    "vorder": 86,
    "position": 1,
    "text": "بتخت و بگنج آتش اندر زنیم"
  },
  {
    "poem_id": 87981,
    "vorder": 87,
    "position": 0,
    "text": "وگر نه ز کین سیاوش سپاه"
  },
  {
    "poem_id": 87981,
    "vorder": 88,
    "position": 1,
    "text": "نیاساید از جنگ هرگز نه شاه"
  },
  {
    "poem_id": 87981,
    "vorder": 89,
    "position": 0,
    "text": "چو بشنید افراسیاب این سخن"
  },
  {
    "poem_id": 87981,
    "vorder": 90,
    "position": 1,
    "text": "سران را بخواند از همه انجمن"
  },
  {
    "poem_id": 87981,
    "vorder": 91,
    "position": 0,
    "text": "یکی لشکری ساخت افراسیاب"
  },
  {
    "poem_id": 87981,
    "vorder": 92,
    "position": 1,
    "text": "که تاریک شد چشمهٔ آفتاب"
  },
  {
    "poem_id": 87981,
    "vorder": 93,
    "position": 0,
    "text": "دهم روز لشکر بپیران رسید"
  },
  {
    "poem_id": 87981,
    "vorder": 94,
    "position": 1,
    "text": "سپاهی کزو شد زمین ناپدید"
  },
  {
    "poem_id": 87981,
    "vorder": 95,
    "position": 0,
    "text": "چو لشکر بیاسود روزی بداد"
  },
  {
    "poem_id": 87981,
    "vorder": 96,
    "position": 1,
    "text": "سپه برگرفت و بنه برنهاد"
  },
  {
    "poem_id": 87981,
    "vorder": 97,
    "position": 0,
    "text": "ز پیمان بگردید وز یاد عهد"
  },
  {
    "poem_id": 87981,
    "vorder": 98,
    "position": 1,
    "text": "بیامد دمان تا لب رود شهد"
  },
  {
    "poem_id": 87981,
    "vorder": 99,
    "position": 0,
    "text": "طلایه بیامد بنزدیک طوس"
  },
  {
    "poem_id": 87981,
    "vorder": 100,
    "position": 1,
    "text": "که بربند بر کوههٔ پیل کوس"
  },
  {
    "poem_id": 87981,
    "vorder": 101,
    "position": 0,
    "text": "که پیران نداند سخن جز فریب"
  },
  {
    "poem_id": 87981,
    "vorder": 102,
    "position": 1,
    "text": "چو داند که تنگ اندر آمد نهیب"
  },
  {
    "poem_id": 87981,
    "vorder": 103,
    "position": 0,
    "text": "درفش جفا پیشه آمد پدید"
  },
  {
    "poem_id": 87981,
    "vorder": 104,
    "position": 1,
    "text": "سپه بر لب رود صف برکشید"
  },
  {
    "poem_id": 87981,
    "vorder": 105,
    "position": 0,
    "text": "بیاراست لشکر سپهدار طوس"
  },
  {
    "poem_id": 87981,
    "vorder": 106,
    "position": 1,
    "text": "بهامون کشیدند پیلان و کوس"
  },
  {
    "poem_id": 87981,
    "vorder": 107,
    "position": 0,
    "text": "دو رویه سپاه اندر آمد چو کوه"
  },
  {
    "poem_id": 87981,
    "vorder": 108,
    "position": 1,
    "text": "سواران ترکان و ایران گروه"
  },
  {
    "poem_id": 87981,
    "vorder": 109,
    "position": 0,
    "text": "چنان شد ز گرد سپاه آفتاب"
  },
  {
    "poem_id": 87981,
    "vorder": 110,
    "position": 1,
    "text": "که آتش برآمد ز دریای آب"
  },
  {
    "poem_id": 87981,
    "vorder": 111,
    "position": 0,
    "text": "درخشیدن تیغ و ژوپین و خشت"
  },
  {
    "poem_id": 87981,
    "vorder": 112,
    "position": 1,
    "text": "تو گفتی شب اندر هوا لاله کشت"
  },
  {
    "poem_id": 87981,
    "vorder": 113,
    "position": 0,
    "text": "ز بس ترگ زرین و زرین سپر"
  },
  {
    "poem_id": 87981,
    "vorder": 114,
    "position": 1,
    "text": "ز جوشن سواران زرین کمر"
  },
  {
    "poem_id": 87981,
    "vorder": 115,
    "position": 0,
    "text": "برآمد یکی ابر چون سندروس"
  },
  {
    "poem_id": 87981,
    "vorder": 116,
    "position": 1,
    "text": "زمین گشت از گرد چون آبنوس"
  },
  {
    "poem_id": 87981,
    "vorder": 117,
    "position": 0,
    "text": "سر سروران زیر گرز گران"
  },
  {
    "poem_id": 87981,
    "vorder": 118,
    "position": 1,
    "text": "چو سندان شد و پتک آهنگران"
  },
  {
    "poem_id": 87981,
    "vorder": 119,
    "position": 0,
    "text": "ز خون رود گفتی میستان شدست"
  },
  {
    "poem_id": 87981,
    "vorder": 120,
    "position": 1,
    "text": "ز نیزه هوا چون نیستان شدست"
  },
  {
    "poem_id": 87981,
    "vorder": 121,
    "position": 0,
    "text": "بسی سر گرفتار دام کمند"
  },
  {
    "poem_id": 87981,
    "vorder": 122,
    "position": 1,
    "text": "بسی خوار گشته تن ارجمند"
  },
  {
    "poem_id": 87981,
    "vorder": 123,
    "position": 0,
    "text": "کفن جوشن و بستر از خون و خاک"
  },
  {
    "poem_id": 87981,
    "vorder": 124,
    "position": 1,
    "text": "تن نازدیده بشمشیر چاک"
  },
  {
    "poem_id": 87981,
    "vorder": 125,
    "position": 0,
    "text": "زمین ارغوان و زمان سندروس"
  },
  {
    "poem_id": 87981,
    "vorder": 126,
    "position": 1,
    "text": "سپهر و ستاره پرآوای کوس"
  },
  {
    "poem_id": 87981,
    "vorder": 127,
    "position": 0,
    "text": "اگر تاج جوید جهانجوی مرد"
  },
  {
    "poem_id": 87981,
    "vorder": 128,
    "position": 1,
    "text": "وگر خاک گردد بروز نبرد"
  },
  {
    "poem_id": 87981,
    "vorder": 129,
    "position": 0,
    "text": "بناکام می‌رفت باید ز دهر"
  },
  {
    "poem_id": 87981,
    "vorder": 130,
    "position": 1,
    "text": "چه زو بهر تریاک یابی چه زهر"
  },
  {
    "poem_id": 87981,
    "vorder": 131,
    "position": 0,
    "text": "ندانم سرانجام و فرجام چیست"
  },
  {
    "poem_id": 87981,
    "vorder": 132,
    "position": 1,
    "text": "برین رفتن اکنون بباید گریست"
  },
  {
    "poem_id": 87981,
    "vorder": 133,
    "position": 0,
    "text": "یکی نامداری بد ارژنگ نام"
  },
  {
    "poem_id": 87981,
    "vorder": 134,
    "position": 1,
    "text": "بابر اندر آورده از جنگ نام"
  },
  {
    "poem_id": 87981,
    "vorder": 135,
    "position": 0,
    "text": "برآورد از دشت آورد گرد"
  },
  {
    "poem_id": 87981,
    "vorder": 136,
    "position": 1,
    "text": "از ایرانیان جست چندی نبرد"
  },
  {
    "poem_id": 87981,
    "vorder": 137,
    "position": 0,
    "text": "چو از دور طوس سپهبد بدید"
  },
  {
    "poem_id": 87981,
    "vorder": 138,
    "position": 1,
    "text": "بغرید و تیغ از میان برکشید"
  },
  {
    "poem_id": 87981,
    "vorder": 139,
    "position": 0,
    "text": "بپور زره گفت نام تو چیست"
  },
  {
    "poem_id": 87981,
    "vorder": 140,
    "position": 1,
    "text": "ز ترکان جنگی ترا یار کیست"
  },
  {
    "poem_id": 87981,
    "vorder": 141,
    "position": 0,
    "text": "بدو گفت ارژنگ جنگی منم"
  },
  {
    "poem_id": 87981,
    "vorder": 142,
    "position": 1,
    "text": "سرافراز و شیر درنگی منم"
  },
  {
    "poem_id": 87981,
    "vorder": 143,
    "position": 0,
    "text": "کنون خاک را از تو رخشان کنم"
  },
  {
    "poem_id": 87981,
    "vorder": 144,
    "position": 1,
    "text": "به آوردگه برسرافشان کنم"
  },
  {
    "poem_id": 87981,
    "vorder": 145,
    "position": 0,
    "text": "چو گفتار پور زره شد ببن"
  },
  {
    "poem_id": 87981,
    "vorder": 146,
    "position": 1,
    "text": "سپهدار ایران شنید این سخن"
  },
  {
    "poem_id": 87981,
    "vorder": 147,
    "position": 0,
    "text": "بپاسخ ندید ایچ رای درنگ"
  },
  {
    "poem_id": 87981,
    "vorder": 148,
    "position": 1,
    "text": "همان آبداری که بودش بچنگ"
  },
  {
    "poem_id": 87981,
    "vorder": 149,
    "position": 0,
    "text": "بزد بر سر و ترگ آن نامدار"
  },
  {
    "poem_id": 87981,
    "vorder": 150,
    "position": 1,
    "text": "تو گفتی تنش سر نیاورد بار"
  },
  {
    "poem_id": 87981,
    "vorder": 151,
    "position": 0,
    "text": "برآمد ز ایران سپه بوق و کوس"
  },
  {
    "poem_id": 87981,
    "vorder": 152,
    "position": 1,
    "text": "که پیروز بادا سرافراز طوس"
  },
  {
    "poem_id": 87981,
    "vorder": 153,
    "position": 0,
    "text": "غمی گشت پیران ز توران سپاه"
  },
  {
    "poem_id": 87981,
    "vorder": 154,
    "position": 1,
    "text": "ز ترکان تهی ماند آوردگاه"
  },
  {
    "poem_id": 87981,
    "vorder": 155,
    "position": 0,
    "text": "دلیران توران و کنداوران"
  },
  {
    "poem_id": 87981,
    "vorder": 156,
    "position": 1,
    "text": "کشیدند شمشیر و گرز گران"
  },
  {
    "poem_id": 87981,
    "vorder": 157,
    "position": 0,
    "text": "که یکسر بکوشیم و جنگ آوریم"
  },
  {
    "poem_id": 87981,
    "vorder": 158,
    "position": 1,
    "text": "جهان بر دل طوس تنگ آوریم"
  },
  {
    "poem_id": 87981,
    "vorder": 159,
    "position": 0,
    "text": "چنین گفت هومان که امروز جنگ"
  },
  {
    "poem_id": 87981,
    "vorder": 160,
    "position": 1,
    "text": "بسازید و دل را مدارید تنگ"
  },
  {
    "poem_id": 87981,
    "vorder": 161,
    "position": 0,
    "text": "گر ایدونک زیشان یکی نامور"
  },
  {
    "poem_id": 87981,
    "vorder": 162,
    "position": 1,
    "text": "ز لشکر برارد به پیکار سر"
  },
  {
    "poem_id": 87981,
    "vorder": 163,
    "position": 0,
    "text": "پذیره فرستیم گردی دمان"
  },
  {
    "poem_id": 87981,
    "vorder": 164,
    "position": 1,
    "text": "ببینیم تا بر که گردد زمان"
  },
  {
    "poem_id": 87981,
    "vorder": 165,
    "position": 0,
    "text": "وزیشان بتندی نجویید جنگ"
  },
  {
    "poem_id": 87981,
    "vorder": 166,
    "position": 1,
    "text": "بباید یک امروز کردن درنگ"
  },
  {
    "poem_id": 87981,
    "vorder": 167,
    "position": 0,
    "text": "بدانگه که لشکر بجنبد ز جای"
  },
  {
    "poem_id": 87981,
    "vorder": 168,
    "position": 1,
    "text": "تبیره برآید ز پرده‌سرای"
  },
  {
    "poem_id": 87981,
    "vorder": 169,
    "position": 0,
    "text": "همه یکسره گرزها برکشیم"
  },
  {
    "poem_id": 87981,
    "vorder": 170,
    "position": 1,
    "text": "یکی از لب رود برتر کشیم"
  },
  {
    "poem_id": 87981,
    "vorder": 171,
    "position": 0,
    "text": "بانبوه رزمی بسازیم سخت"
  },
  {
    "poem_id": 87981,
    "vorder": 172,
    "position": 1,
    "text": "اگر یار باشد جهاندار و بخت"
  }
]