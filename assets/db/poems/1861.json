[
  {
    "poem_id": 1861,
    "vorder": 1,
    "position": 0,
    "text": "بدو گفت قیصر که جاوید زی"
  },
  {
    "poem_id": 1861,
    "vorder": 2,
    "position": 1,
    "text": "که دستور شاهنشهان را سزی"
  },
  {
    "poem_id": 1861,
    "vorder": 3,
    "position": 0,
    "text": "یکی خانه دارم در ایوان شگفت"
  },
  {
    "poem_id": 1861,
    "vorder": 4,
    "position": 1,
    "text": "کزین برتر اندازه نتوان گرفت"
  },
  {
    "poem_id": 1861,
    "vorder": 5,
    "position": 0,
    "text": "یکی اسب و مردی برو بر سوار"
  },
  {
    "poem_id": 1861,
    "vorder": 6,
    "position": 1,
    "text": "کز آنجا شگفتی شود هوشیار"
  },
  {
    "poem_id": 1861,
    "vorder": 7,
    "position": 0,
    "text": "چو بینی ندانی که این بند چیست"
  },
  {
    "poem_id": 1861,
    "vorder": 8,
    "position": 1,
    "text": "طلسم است گر کردهٔ ایزدی‌ست"
  },
  {
    "poem_id": 1861,
    "vorder": 9,
    "position": 0,
    "text": "چو خراد برزین شنید این سخن"
  },
  {
    "poem_id": 1861,
    "vorder": 10,
    "position": 1,
    "text": "بیامد بر آن جایگاه کهن"
  },
  {
    "poem_id": 1861,
    "vorder": 11,
    "position": 0,
    "text": "بدیدش یکی جای کرده بلند"
  },
  {
    "poem_id": 1861,
    "vorder": 12,
    "position": 1,
    "text": "سوار ایستاده در او ارجمند"
  },
  {
    "poem_id": 1861,
    "vorder": 13,
    "position": 0,
    "text": "کجا چشم بیننده چونان ندید"
  },
  {
    "poem_id": 1861,
    "vorder": 14,
    "position": 1,
    "text": "بدان سان توگفتی خدای آفرید"
  },
  {
    "poem_id": 1861,
    "vorder": 15,
    "position": 0,
    "text": "بدید ایستاده معلق سوار"
  },
  {
    "poem_id": 1861,
    "vorder": 16,
    "position": 1,
    "text": "بیامد برِ قیصر نامدار"
  },
  {
    "poem_id": 1861,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت کز آهن است آن سوار"
  },
  {
    "poem_id": 1861,
    "vorder": 18,
    "position": 1,
    "text": "همه خانه از گوهر شاهوار"
  },
  {
    "poem_id": 1861,
    "vorder": 19,
    "position": 0,
    "text": "که دانا ورا مغنیاطیس خواند"
  },
  {
    "poem_id": 1861,
    "vorder": 20,
    "position": 1,
    "text": "که رومیش بر اسپ هندی نشاند"
  },
  {
    "poem_id": 1861,
    "vorder": 21,
    "position": 0,
    "text": "هرآنکس که او دفتر هندوان"
  },
  {
    "poem_id": 1861,
    "vorder": 22,
    "position": 1,
    "text": "بخوانَد شود شاد و روشن‌روان"
  },
  {
    "poem_id": 1861,
    "vorder": 23,
    "position": 0,
    "text": "بپرسید قیصر که هندی ز راه"
  },
  {
    "poem_id": 1861,
    "vorder": 24,
    "position": 1,
    "text": "همی تا کجا برکشد پایگاه"
  },
  {
    "poem_id": 1861,
    "vorder": 25,
    "position": 0,
    "text": "ز دین پرستندگان برچِنَد"
  },
  {
    "poem_id": 1861,
    "vorder": 26,
    "position": 1,
    "text": "همه بت پرستند گر خود کند"
  },
  {
    "poem_id": 1861,
    "vorder": 27,
    "position": 0,
    "text": "چنین گفت خراد برزین که راه"
  },
  {
    "poem_id": 1861,
    "vorder": 28,
    "position": 1,
    "text": "به هند اندرون گاو شاه است و ماه"
  },
  {
    "poem_id": 1861,
    "vorder": 29,
    "position": 0,
    "text": "به یزدان نگروند و گردان سپهر"
  },
  {
    "poem_id": 1861,
    "vorder": 30,
    "position": 1,
    "text": "ندارد کسی بر تن خویش مهر"
  },
  {
    "poem_id": 1861,
    "vorder": 31,
    "position": 0,
    "text": "ز خورشید گردنده بر بگذرند"
  },
  {
    "poem_id": 1861,
    "vorder": 32,
    "position": 1,
    "text": "چو ما را ز دانندگان نشمرند"
  },
  {
    "poem_id": 1861,
    "vorder": 33,
    "position": 0,
    "text": "هرآنکس که او آتشی برفروخت"
  },
  {
    "poem_id": 1861,
    "vorder": 34,
    "position": 1,
    "text": "شد اندر میان خویشتن را بسوخت"
  },
  {
    "poem_id": 1861,
    "vorder": 35,
    "position": 0,
    "text": "یکی آتشی داند اندر هوا"
  },
  {
    "poem_id": 1861,
    "vorder": 36,
    "position": 1,
    "text": "به فرمان یزدان فرمان‌روا"
  },
  {
    "poem_id": 1861,
    "vorder": 37,
    "position": 0,
    "text": "که دانای هندوش خوانَد اثیر"
  },
  {
    "poem_id": 1861,
    "vorder": 38,
    "position": 1,
    "text": "سخنهای نغز آورَد دلپذیر"
  },
  {
    "poem_id": 1861,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت کآتش به آتش رسید"
  },
  {
    "poem_id": 1861,
    "vorder": 40,
    "position": 1,
    "text": "گناهش ز کردار شد ناپدید"
  },
  {
    "poem_id": 1861,
    "vorder": 41,
    "position": 0,
    "text": "از آن ناگزیر آتش افروختن"
  },
  {
    "poem_id": 1861,
    "vorder": 42,
    "position": 1,
    "text": "همان راستی خواند این سوختن"
  },
  {
    "poem_id": 1861,
    "vorder": 43,
    "position": 0,
    "text": "همان گفت‌وگوی شما نیست راست"
  },
  {
    "poem_id": 1861,
    "vorder": 44,
    "position": 1,
    "text": "بر این بر روان مسیحا گواست"
  },
  {
    "poem_id": 1861,
    "vorder": 45,
    "position": 0,
    "text": "نبینی که عیسی مریم چه گفت"
  },
  {
    "poem_id": 1861,
    "vorder": 46,
    "position": 1,
    "text": "بدانگه که بگشاد راز از نهفت"
  },
  {
    "poem_id": 1861,
    "vorder": 47,
    "position": 0,
    "text": "که پیراهنت گر ستانَد کسی"
  },
  {
    "poem_id": 1861,
    "vorder": 48,
    "position": 1,
    "text": "میاویز با او به تندی بسی"
  },
  {
    "poem_id": 1861,
    "vorder": 49,
    "position": 0,
    "text": "وگر برزند کف به رخسار تو"
  },
  {
    "poem_id": 1861,
    "vorder": 50,
    "position": 1,
    "text": "شود تیره زآن زخم دیدار تو"
  },
  {
    "poem_id": 1861,
    "vorder": 51,
    "position": 0,
    "text": "مزن همچنان تا بماندت نام"
  },
  {
    "poem_id": 1861,
    "vorder": 52,
    "position": 1,
    "text": "خردمند را نام بهتر ز کام"
  },
  {
    "poem_id": 1861,
    "vorder": 53,
    "position": 0,
    "text": "بسوتام را بس کن از خوردنی"
  },
  {
    "poem_id": 1861,
    "vorder": 54,
    "position": 1,
    "text": "مجو ار نباشدت گستردنی"
  },
  {
    "poem_id": 1861,
    "vorder": 55,
    "position": 0,
    "text": "بدین سر بدی را به بد مشمرید"
  },
  {
    "poem_id": 1861,
    "vorder": 56,
    "position": 1,
    "text": "بی‌آزار از این تیرگی بگذرید"
  },
  {
    "poem_id": 1861,
    "vorder": 57,
    "position": 0,
    "text": "شما را هوا بر خرد شاه گشت"
  },
  {
    "poem_id": 1861,
    "vorder": 58,
    "position": 1,
    "text": "دل از آز بسیار بیراه گشت"
  },
  {
    "poem_id": 1861,
    "vorder": 59,
    "position": 0,
    "text": "که ایوانهاتان به کیوان رسید"
  },
  {
    "poem_id": 1861,
    "vorder": 60,
    "position": 1,
    "text": "شماری که شد گنجتان را کلید"
  },
  {
    "poem_id": 1861,
    "vorder": 61,
    "position": 0,
    "text": "ابا گنجتان نیز چندان سپاه"
  },
  {
    "poem_id": 1861,
    "vorder": 62,
    "position": 1,
    "text": "زره‌های رومی و رومی کلاه"
  },
  {
    "poem_id": 1861,
    "vorder": 63,
    "position": 0,
    "text": "به هر جای بیداد لشکر کشید"
  },
  {
    "poem_id": 1861,
    "vorder": 64,
    "position": 1,
    "text": "ز آسودگی تیغها برکشید"
  },
  {
    "poem_id": 1861,
    "vorder": 65,
    "position": 0,
    "text": "همی چشمه گردد بیابان ز خون"
  },
  {
    "poem_id": 1861,
    "vorder": 66,
    "position": 1,
    "text": "مسیحا نبود اندر این رهنمون"
  },
  {
    "poem_id": 1861,
    "vorder": 67,
    "position": 0,
    "text": "یکی بینوا مرد درویش بود"
  },
  {
    "poem_id": 1861,
    "vorder": 68,
    "position": 1,
    "text": "که نانش ز رنج تن خویش بود"
  },
  {
    "poem_id": 1861,
    "vorder": 69,
    "position": 0,
    "text": "جز از ترف و شیرش نبودی خورش"
  },
  {
    "poem_id": 1861,
    "vorder": 70,
    "position": 1,
    "text": "فزونیش رخبین بُدی پرورش"
  },
  {
    "poem_id": 1861,
    "vorder": 71,
    "position": 0,
    "text": "چو آورد مرد جهودش به مشت"
  },
  {
    "poem_id": 1861,
    "vorder": 72,
    "position": 1,
    "text": "چو بی‌یار و بیچاره دیدش بکشت"
  },
  {
    "poem_id": 1861,
    "vorder": 73,
    "position": 0,
    "text": "همان کشته را نیز بر دار کرد"
  },
  {
    "poem_id": 1861,
    "vorder": 74,
    "position": 1,
    "text": "بر آن دار بر مر ورا خوار کرد"
  },
  {
    "poem_id": 1861,
    "vorder": 75,
    "position": 0,
    "text": "چو روشن‌روان گشت و دانش‌پذیر"
  },
  {
    "poem_id": 1861,
    "vorder": 76,
    "position": 1,
    "text": "سخن‌گوی و داننده و یادگیر"
  },
  {
    "poem_id": 1861,
    "vorder": 77,
    "position": 0,
    "text": "به پیغمبری نیز هنگام یافت"
  },
  {
    "poem_id": 1861,
    "vorder": 78,
    "position": 1,
    "text": "به برنایی از زیرکی کام یافت"
  },
  {
    "poem_id": 1861,
    "vorder": 79,
    "position": 0,
    "text": "تو گویی که فرزند یزدان بُد اوی"
  },
  {
    "poem_id": 1861,
    "vorder": 80,
    "position": 1,
    "text": "بر آن دار برگشته خندان بُد اوی"
  },
  {
    "poem_id": 1861,
    "vorder": 81,
    "position": 0,
    "text": "بخندد بر این بر خردمند مرد"
  },
  {
    "poem_id": 1861,
    "vorder": 82,
    "position": 1,
    "text": "تو گر بخردی گِردِ این فن مگرد"
  },
  {
    "poem_id": 1861,
    "vorder": 83,
    "position": 0,
    "text": "که هست او ز فرزند و زن بی‌نیاز"
  },
  {
    "poem_id": 1861,
    "vorder": 84,
    "position": 1,
    "text": "به نزدیک او آشکار است راز"
  },
  {
    "poem_id": 1861,
    "vorder": 85,
    "position": 0,
    "text": "چه پیچی ز دین کیومرّثی"
  },
  {
    "poem_id": 1861,
    "vorder": 86,
    "position": 1,
    "text": "هم از راه و آیین طهمورثی"
  },
  {
    "poem_id": 1861,
    "vorder": 87,
    "position": 0,
    "text": "که گویند دارای گیهان یکی‌ست"
  },
  {
    "poem_id": 1861,
    "vorder": 88,
    "position": 1,
    "text": "جز از بندگی کردنت رای نیست"
  },
  {
    "poem_id": 1861,
    "vorder": 89,
    "position": 0,
    "text": "جهاندار دهقان یزدان‌پرست"
  },
  {
    "poem_id": 1861,
    "vorder": 90,
    "position": 1,
    "text": "چو بر واژه برسم بگیرد به دست"
  },
  {
    "poem_id": 1861,
    "vorder": 91,
    "position": 0,
    "text": "نشاید چشیدن یکی قطره آب"
  },
  {
    "poem_id": 1861,
    "vorder": 92,
    "position": 1,
    "text": "گر از تشنگی آب بیند به خواب"
  },
  {
    "poem_id": 1861,
    "vorder": 93,
    "position": 0,
    "text": "به یزدان پناهند به روز نبرد"
  },
  {
    "poem_id": 1861,
    "vorder": 94,
    "position": 1,
    "text": "نخواهد به جنگ اندرون آب سرد"
  },
  {
    "poem_id": 1861,
    "vorder": 95,
    "position": 0,
    "text": "همان قبله‌شان برترین گوهر است"
  },
  {
    "poem_id": 1861,
    "vorder": 96,
    "position": 1,
    "text": "که از آب و خاک و هوا برتر است"
  },
  {
    "poem_id": 1861,
    "vorder": 97,
    "position": 0,
    "text": "نباشند شاهان ما دین‌فروش"
  },
  {
    "poem_id": 1861,
    "vorder": 98,
    "position": 1,
    "text": "به فرمان دارنده دارند گوش"
  },
  {
    "poem_id": 1861,
    "vorder": 99,
    "position": 0,
    "text": "به دینار و گوهر نباشند شاد"
  },
  {
    "poem_id": 1861,
    "vorder": 100,
    "position": 1,
    "text": "نجویند نام و نشان جز به داد"
  },
  {
    "poem_id": 1861,
    "vorder": 101,
    "position": 0,
    "text": "ببخشیدن کاخ‌های بلند"
  },
  {
    "poem_id": 1861,
    "vorder": 102,
    "position": 1,
    "text": "دگر شاد کردن دل مستمند"
  },
  {
    "poem_id": 1861,
    "vorder": 103,
    "position": 0,
    "text": "سدیگر کسی کو به روز نبرد"
  },
  {
    "poem_id": 1861,
    "vorder": 104,
    "position": 1,
    "text": "بپوشد رخ شید گردان به گَرد"
  },
  {
    "poem_id": 1861,
    "vorder": 105,
    "position": 0,
    "text": "بروبوم دارد ز دشمن نگاه"
  },
  {
    "poem_id": 1861,
    "vorder": 106,
    "position": 1,
    "text": "جز این را نخواهد خردمند شاه"
  },
  {
    "poem_id": 1861,
    "vorder": 107,
    "position": 0,
    "text": "جز از راستی هرک جوید ز دین"
  },
  {
    "poem_id": 1861,
    "vorder": 108,
    "position": 1,
    "text": "بر او باد نفرین بی‌آفرین"
  },
  {
    "poem_id": 1861,
    "vorder": 109,
    "position": 0,
    "text": "چو بشنید قیصر پسند آمدش"
  },
  {
    "poem_id": 1861,
    "vorder": 110,
    "position": 1,
    "text": "سخن‌های او سودمند آمدش"
  },
  {
    "poem_id": 1861,
    "vorder": 111,
    "position": 0,
    "text": "بدو گفت آن‌کو جهان آفرید"
  },
  {
    "poem_id": 1861,
    "vorder": 112,
    "position": 1,
    "text": "تو را نامدار مِهان آفرید"
  },
  {
    "poem_id": 1861,
    "vorder": 113,
    "position": 0,
    "text": "سخن‌های پاک از تو باید شنید"
  },
  {
    "poem_id": 1861,
    "vorder": 114,
    "position": 1,
    "text": "تو داری درِ رازها را کلید"
  },
  {
    "poem_id": 1861,
    "vorder": 115,
    "position": 0,
    "text": "کسی را کز این گونه کهتر بُوَد"
  },
  {
    "poem_id": 1861,
    "vorder": 116,
    "position": 1,
    "text": "سرش ز افسر ماه برتر بُوَد"
  },
  {
    "poem_id": 1861,
    "vorder": 117,
    "position": 0,
    "text": "درم خواست از گنج و دینار خواست"
  },
  {
    "poem_id": 1861,
    "vorder": 118,
    "position": 1,
    "text": "یکی افسری نامبردار خواست"
  },
  {
    "poem_id": 1861,
    "vorder": 119,
    "position": 0,
    "text": "بدو داد و بسیار کرد آفرین"
  },
  {
    "poem_id": 1861,
    "vorder": 120,
    "position": 1,
    "text": "که آباد باد از تو ایران زمین"
  }
]