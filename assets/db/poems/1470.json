[
  {
    "poem_id": 1470,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید گشت از جهان ناپدید"
  },
  {
    "poem_id": 1470,
    "vorder": 2,
    "position": 1,
    "text": "شب تیره بر دشت، لشکر کشید"
  },
  {
    "poem_id": 1470,
    "vorder": 3,
    "position": 0,
    "text": "تهمتن بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1470,
    "vorder": 4,
    "position": 1,
    "text": "میان بستهٔ جنگ و دل، کینه‌خواه"
  },
  {
    "poem_id": 1470,
    "vorder": 5,
    "position": 0,
    "text": "که دستور باشد مرا تاجور"
  },
  {
    "poem_id": 1470,
    "vorder": 6,
    "position": 1,
    "text": "از ایدر شوم بی‌کلاه و کمر"
  },
  {
    "poem_id": 1470,
    "vorder": 7,
    "position": 0,
    "text": "ببینم که این نوجهاندار کیست"
  },
  {
    "poem_id": 1470,
    "vorder": 8,
    "position": 1,
    "text": "بزرگان کدامند و سالار کیست"
  },
  {
    "poem_id": 1470,
    "vorder": 9,
    "position": 0,
    "text": "بدو گفت کاووس، کین کار تست"
  },
  {
    "poem_id": 1470,
    "vorder": 10,
    "position": 1,
    "text": "که بیداردل بادی و تن‌درست"
  },
  {
    "poem_id": 1470,
    "vorder": 11,
    "position": 0,
    "text": "تهمتن یکی جامهٔ تُرکوار"
  },
  {
    "poem_id": 1470,
    "vorder": 12,
    "position": 1,
    "text": "بپوشید و آمد دوان تا حصار"
  },
  {
    "poem_id": 1470,
    "vorder": 13,
    "position": 0,
    "text": "بیامد چو نزدیکیِ دژ رسید"
  },
  {
    "poem_id": 1470,
    "vorder": 14,
    "position": 1,
    "text": "خروشیدنِ نوشِ تُرکان شنید"
  },
  {
    "poem_id": 1470,
    "vorder": 15,
    "position": 0,
    "text": "بران دژ درون رفت، مردِ دلیر"
  },
  {
    "poem_id": 1470,
    "vorder": 16,
    "position": 1,
    "text": "چنان چون سوی آهوان، نره‌شیر"
  },
  {
    "poem_id": 1470,
    "vorder": 17,
    "position": 0,
    "text": "چو سهراب را دید بر تختِ بزم"
  },
  {
    "poem_id": 1470,
    "vorder": 18,
    "position": 1,
    "text": "نشسته به یک دست او ژنده‌رزم"
  },
  {
    "poem_id": 1470,
    "vorder": 19,
    "position": 0,
    "text": "به دیگر چو هومان سوار دلیر"
  },
  {
    "poem_id": 1470,
    "vorder": 20,
    "position": 1,
    "text": "دگر بارمان نام‌بُردار شیر"
  },
  {
    "poem_id": 1470,
    "vorder": 21,
    "position": 0,
    "text": "تو گفتی همه تخت سهراب بود"
  },
  {
    "poem_id": 1470,
    "vorder": 22,
    "position": 1,
    "text": "بسان یکی سروِ شاداب بود"
  },
  {
    "poem_id": 1470,
    "vorder": 23,
    "position": 0,
    "text": "دو بازو به کردار ران هَیون"
  },
  {
    "poem_id": 1470,
    "vorder": 24,
    "position": 1,
    "text": "بَرش چون بَرِ پیل و چهره چو خون"
  },
  {
    "poem_id": 1470,
    "vorder": 25,
    "position": 0,
    "text": "ز تُرکان بگرد اندرش صد دلیر"
  },
  {
    "poem_id": 1470,
    "vorder": 26,
    "position": 1,
    "text": "جوان و سرافراز چون نره‌شیر"
  },
  {
    "poem_id": 1470,
    "vorder": 27,
    "position": 0,
    "text": "پرستار، پنجاه با دست‌بند"
  },
  {
    "poem_id": 1470,
    "vorder": 28,
    "position": 1,
    "text": "به پیش دل‌افروز تخت بلند"
  },
  {
    "poem_id": 1470,
    "vorder": 29,
    "position": 0,
    "text": "همی یک به یک خواندند آفرین"
  },
  {
    "poem_id": 1470,
    "vorder": 30,
    "position": 1,
    "text": "بران بُرز و بالا و تیغ و نگین"
  },
  {
    "poem_id": 1470,
    "vorder": 31,
    "position": 0,
    "text": "همی دید رستم مَر او را ز دور"
  },
  {
    "poem_id": 1470,
    "vorder": 32,
    "position": 1,
    "text": "نشست و نگه کرد مردانِ سور"
  },
  {
    "poem_id": 1470,
    "vorder": 33,
    "position": 0,
    "text": "به شایسته‌کاری برون رفت، ژند"
  },
  {
    "poem_id": 1470,
    "vorder": 34,
    "position": 1,
    "text": "گَوی دید بَرسان سروِ بلند"
  },
  {
    "poem_id": 1470,
    "vorder": 35,
    "position": 0,
    "text": "بدان لشکر اندر چُنو کس نبود"
  },
  {
    "poem_id": 1470,
    "vorder": 36,
    "position": 1,
    "text": "بَرِ رستم آمد بپرسید زود"
  },
  {
    "poem_id": 1470,
    "vorder": 37,
    "position": 0,
    "text": "چه مردی؟ بدو گفت با من بگوی"
  },
  {
    "poem_id": 1470,
    "vorder": 38,
    "position": 1,
    "text": "سوی روشنی آی و بِنْمای روی"
  },
  {
    "poem_id": 1470,
    "vorder": 39,
    "position": 0,
    "text": "تهمتن یکی مشت بر گردنش"
  },
  {
    "poem_id": 1470,
    "vorder": 40,
    "position": 1,
    "text": "بزد تیز و برشد روان از تنش"
  },
  {
    "poem_id": 1470,
    "vorder": 41,
    "position": 0,
    "text": "بدان جایگه خشک شد ژنده‌رزم"
  },
  {
    "poem_id": 1470,
    "vorder": 42,
    "position": 1,
    "text": "نشد ژنده‌رزم آنگهی سوی بزم"
  },
  {
    "poem_id": 1470,
    "vorder": 43,
    "position": 0,
    "text": "زمانی همی بود سهراب دیر"
  },
  {
    "poem_id": 1470,
    "vorder": 44,
    "position": 1,
    "text": "نیامد به نزدیک او ژند شیر"
  },
  {
    "poem_id": 1470,
    "vorder": 45,
    "position": 0,
    "text": "بپرسید سهراب تا ژنده‌رزم"
  },
  {
    "poem_id": 1470,
    "vorder": 46,
    "position": 1,
    "text": "کجا شد که جایش تهی شد ز بزم؟"
  },
  {
    "poem_id": 1470,
    "vorder": 47,
    "position": 0,
    "text": "برفتند و دیدنْش افگنده خوار"
  },
  {
    "poem_id": 1470,
    "vorder": 48,
    "position": 1,
    "text": "برآسوده از بزم و از کارزار"
  },
  {
    "poem_id": 1470,
    "vorder": 49,
    "position": 0,
    "text": "خروشان ازان درد بازآمدند"
  },
  {
    "poem_id": 1470,
    "vorder": 50,
    "position": 1,
    "text": "شگفتیْ فرو مانده از کارِ ژَند"
  },
  {
    "poem_id": 1470,
    "vorder": 51,
    "position": 0,
    "text": "به سهراب گفتند شد ژنده‌رزم"
  },
  {
    "poem_id": 1470,
    "vorder": 52,
    "position": 1,
    "text": "سرآمد بَرو روزِ پیگار و بزم"
  },
  {
    "poem_id": 1470,
    "vorder": 53,
    "position": 0,
    "text": "چو بشنید سهراب برجست زود"
  },
  {
    "poem_id": 1470,
    "vorder": 54,
    "position": 1,
    "text": "بیامد بَرِ ژنده برسان دود"
  },
  {
    "poem_id": 1470,
    "vorder": 55,
    "position": 0,
    "text": "اباچاکر و شمع و خنیاگران"
  },
  {
    "poem_id": 1470,
    "vorder": 56,
    "position": 1,
    "text": "بیامد وُرا دید مُرده چنان"
  },
  {
    "poem_id": 1470,
    "vorder": 57,
    "position": 0,
    "text": "شگفت آمدش سخت و خیره بماند"
  },
  {
    "poem_id": 1470,
    "vorder": 58,
    "position": 1,
    "text": "دلیران و گردن‌کشان را بخواند"
  },
  {
    "poem_id": 1470,
    "vorder": 59,
    "position": 0,
    "text": "چنین گفت کامشب نباید غُنود"
  },
  {
    "poem_id": 1470,
    "vorder": 60,
    "position": 1,
    "text": "همه‌شب همی نیزه باید بسود"
  },
  {
    "poem_id": 1470,
    "vorder": 61,
    "position": 0,
    "text": "که گرگ اندر آمد میان رمه"
  },
  {
    "poem_id": 1470,
    "vorder": 62,
    "position": 1,
    "text": "سگ و مرد را آزمودش همه"
  },
  {
    "poem_id": 1470,
    "vorder": 63,
    "position": 0,
    "text": "اگر یار باشد جهان‌آفرین"
  },
  {
    "poem_id": 1470,
    "vorder": 64,
    "position": 1,
    "text": "چو نعل سمندم بساید زمین"
  },
  {
    "poem_id": 1470,
    "vorder": 65,
    "position": 0,
    "text": "ز فِتراک زین برگشایم کمند"
  },
  {
    "poem_id": 1470,
    "vorder": 66,
    "position": 1,
    "text": "بخواهم از ایرانیان کینِ ژند"
  },
  {
    "poem_id": 1470,
    "vorder": 67,
    "position": 0,
    "text": "بیامد نشست از برِ گاه خویش"
  },
  {
    "poem_id": 1470,
    "vorder": 68,
    "position": 1,
    "text": "گرانمایگان را همه خوانْد پیش"
  },
  {
    "poem_id": 1470,
    "vorder": 69,
    "position": 0,
    "text": "که گر کم شد از تخت من ژنده‌رزم"
  },
  {
    "poem_id": 1470,
    "vorder": 70,
    "position": 1,
    "text": "نیامد همی سیر، جانم ز بزم"
  },
  {
    "poem_id": 1470,
    "vorder": 71,
    "position": 0,
    "text": "چو برگشت رستم برِ شهریار"
  },
  {
    "poem_id": 1470,
    "vorder": 72,
    "position": 1,
    "text": "از ایران سپه گیو بد پاسدار"
  },
  {
    "poem_id": 1470,
    "vorder": 73,
    "position": 0,
    "text": "به ره بر گو پیلتن را بدید"
  },
  {
    "poem_id": 1470,
    "vorder": 74,
    "position": 1,
    "text": "بزد دست و گرز از میان برکشید"
  },
  {
    "poem_id": 1470,
    "vorder": 75,
    "position": 0,
    "text": "یکی بر خروشید چون پیل مست"
  },
  {
    "poem_id": 1470,
    "vorder": 76,
    "position": 1,
    "text": "سپر بر سر آورد و بنمود دست"
  },
  {
    "poem_id": 1470,
    "vorder": 77,
    "position": 0,
    "text": "بدانست رستم کز ایران سپاه"
  },
  {
    "poem_id": 1470,
    "vorder": 78,
    "position": 1,
    "text": "به شب گیو باشد طلایه به راه"
  },
  {
    "poem_id": 1470,
    "vorder": 79,
    "position": 0,
    "text": "بخندید و زان پس فغان برکشید"
  },
  {
    "poem_id": 1470,
    "vorder": 80,
    "position": 1,
    "text": "طلایه چو آواز رستم شنید"
  },
  {
    "poem_id": 1470,
    "vorder": 81,
    "position": 0,
    "text": "بیامد پیاده به نزدیک اوی"
  },
  {
    "poem_id": 1470,
    "vorder": 82,
    "position": 1,
    "text": "چنین گفت کای مهتر جنگجوی"
  },
  {
    "poem_id": 1470,
    "vorder": 83,
    "position": 0,
    "text": "پیاده کجا بوده‌ای تیره شب"
  },
  {
    "poem_id": 1470,
    "vorder": 84,
    "position": 1,
    "text": "تهمتن به گفتار بگشاد لب"
  },
  {
    "poem_id": 1470,
    "vorder": 85,
    "position": 0,
    "text": "بگفتش به گیو آن کجا کرده بود"
  },
  {
    "poem_id": 1470,
    "vorder": 86,
    "position": 1,
    "text": "چنان شیرمردی که آزرده بود"
  },
  {
    "poem_id": 1470,
    "vorder": 87,
    "position": 0,
    "text": "وزان جایگه رفت نزدیک شاه"
  },
  {
    "poem_id": 1470,
    "vorder": 88,
    "position": 1,
    "text": "ز ترکان سخن گفت وز بزم‌گاه"
  },
  {
    "poem_id": 1470,
    "vorder": 89,
    "position": 0,
    "text": "ز سهراب و از برز و بالای اوی"
  },
  {
    "poem_id": 1470,
    "vorder": 90,
    "position": 1,
    "text": "ز بازوی و کتف دلارای اوی"
  },
  {
    "poem_id": 1470,
    "vorder": 91,
    "position": 0,
    "text": "که هرگز ز ترکان چنین کس نخاست"
  },
  {
    "poem_id": 1470,
    "vorder": 92,
    "position": 1,
    "text": "بکردار سروست بالاش راست"
  },
  {
    "poem_id": 1470,
    "vorder": 93,
    "position": 0,
    "text": "به توران و ایران نماند به کس"
  },
  {
    "poem_id": 1470,
    "vorder": 94,
    "position": 1,
    "text": "تو گویی که سام سوارست و بس"
  },
  {
    "poem_id": 1470,
    "vorder": 95,
    "position": 0,
    "text": "وزان مشت بر گردن ژنده‌رزم"
  },
  {
    "poem_id": 1470,
    "vorder": 96,
    "position": 1,
    "text": "کزان پس نیامد به رزم و به بزم"
  },
  {
    "poem_id": 1470,
    "vorder": 97,
    "position": 0,
    "text": "بگفتند و پس رود و می خواستند"
  },
  {
    "poem_id": 1470,
    "vorder": 98,
    "position": 1,
    "text": "همه شب همی لشکر آراستند"
  }
]