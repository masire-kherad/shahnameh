[
  {
    "poem_id": 1461,
    "vorder": 1,
    "position": 0,
    "text": "چو نزدیک شهر سمنگان رسید"
  },
  {
    "poem_id": 1461,
    "vorder": 2,
    "position": 1,
    "text": "خبر زو بشاه و بزرگان رسید"
  },
  {
    "poem_id": 1461,
    "vorder": 3,
    "position": 0,
    "text": "که آمد پیاده‌ گو تاج‌بخش"
  },
  {
    "poem_id": 1461,
    "vorder": 4,
    "position": 1,
    "text": "به نخچیرگه زو رمیدست رخش"
  },
  {
    "poem_id": 1461,
    "vorder": 5,
    "position": 0,
    "text": "پذیره شدندش بزرگان و شاه"
  },
  {
    "poem_id": 1461,
    "vorder": 6,
    "position": 1,
    "text": "کسی کاو بسر بر نهادی کلاه"
  },
  {
    "poem_id": 1461,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت شاه سمنگان چه بود"
  },
  {
    "poem_id": 1461,
    "vorder": 8,
    "position": 1,
    "text": "که یارست با تو نبرد آزمود"
  },
  {
    "poem_id": 1461,
    "vorder": 9,
    "position": 0,
    "text": "درین شهر ما نیکخواه توایم"
  },
  {
    "poem_id": 1461,
    "vorder": 10,
    "position": 1,
    "text": "ستاده بفرمان و راه توایم"
  },
  {
    "poem_id": 1461,
    "vorder": 11,
    "position": 0,
    "text": "تن و خواسته زیر فرمان تست"
  },
  {
    "poem_id": 1461,
    "vorder": 12,
    "position": 1,
    "text": "سر ارجمندان و جان آن تست"
  },
  {
    "poem_id": 1461,
    "vorder": 13,
    "position": 0,
    "text": "چو رستم به گفتار او بنگرید"
  },
  {
    "poem_id": 1461,
    "vorder": 14,
    "position": 1,
    "text": "ز بدها گمانیش کوتاه دید"
  },
  {
    "poem_id": 1461,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت رخشم بدین مرغزار"
  },
  {
    "poem_id": 1461,
    "vorder": 16,
    "position": 1,
    "text": "ز من دور شد بی‌لگام و فسار"
  },
  {
    "poem_id": 1461,
    "vorder": 17,
    "position": 0,
    "text": "کنون تا سمنگان نشان پی است"
  },
  {
    "poem_id": 1461,
    "vorder": 18,
    "position": 1,
    "text": "وز آنجا کجا جویبار و نی است"
  },
  {
    "poem_id": 1461,
    "vorder": 19,
    "position": 0,
    "text": "ترا باشد ار بازجویی سپاس"
  },
  {
    "poem_id": 1461,
    "vorder": 20,
    "position": 1,
    "text": "بباشم بپاداش نیکی شناس"
  },
  {
    "poem_id": 1461,
    "vorder": 21,
    "position": 0,
    "text": "گر ایدون که ماند ز من ناپدید"
  },
  {
    "poem_id": 1461,
    "vorder": 22,
    "position": 1,
    "text": "سران را بسی سر بباید برید"
  },
  {
    "poem_id": 1461,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت شاه ای سزاوار مرد"
  },
  {
    "poem_id": 1461,
    "vorder": 24,
    "position": 1,
    "text": "نیارد کسی با تو این کار کرد"
  },
  {
    "poem_id": 1461,
    "vorder": 25,
    "position": 0,
    "text": "تو مهمان من باش و تندی مکن"
  },
  {
    "poem_id": 1461,
    "vorder": 26,
    "position": 1,
    "text": "به کام تو گردد سراسر سخن"
  },
  {
    "poem_id": 1461,
    "vorder": 27,
    "position": 0,
    "text": "یک امشب به می شاد داریم دل"
  },
  {
    "poem_id": 1461,
    "vorder": 28,
    "position": 1,
    "text": "وز اندیشه آزاد داریم دل"
  },
  {
    "poem_id": 1461,
    "vorder": 29,
    "position": 0,
    "text": "نماند پی رخش فرخ نهان"
  },
  {
    "poem_id": 1461,
    "vorder": 30,
    "position": 1,
    "text": "چنان بارهٔ نامدار جهان"
  },
  {
    "poem_id": 1461,
    "vorder": 31,
    "position": 0,
    "text": "تهمتن به گفتار او شاد شد"
  },
  {
    "poem_id": 1461,
    "vorder": 32,
    "position": 1,
    "text": "روانش ز اندیشه آزاد شد"
  },
  {
    "poem_id": 1461,
    "vorder": 33,
    "position": 0,
    "text": "سزا دید رفتن سوی خان او"
  },
  {
    "poem_id": 1461,
    "vorder": 34,
    "position": 1,
    "text": "شد از مژده دلشاد مهمان او"
  },
  {
    "poem_id": 1461,
    "vorder": 35,
    "position": 0,
    "text": "سپهبد بدو داد در کاخ جای"
  },
  {
    "poem_id": 1461,
    "vorder": 36,
    "position": 1,
    "text": "همی بود در پیش او بر به پای"
  },
  {
    "poem_id": 1461,
    "vorder": 37,
    "position": 0,
    "text": "ز شهر و ز لشکر مهانرا بخواند"
  },
  {
    "poem_id": 1461,
    "vorder": 38,
    "position": 1,
    "text": "سزاوار با او به شادی نشاند"
  },
  {
    "poem_id": 1461,
    "vorder": 39,
    "position": 0,
    "text": "گسارندهٔ باده آورد ساز"
  },
  {
    "poem_id": 1461,
    "vorder": 40,
    "position": 1,
    "text": "سیه چشم و گلرخ بتان طراز"
  },
  {
    "poem_id": 1461,
    "vorder": 41,
    "position": 0,
    "text": "نشستند با رودسازان به هم"
  },
  {
    "poem_id": 1461,
    "vorder": 42,
    "position": 1,
    "text": "بدان تا تهمتن نباشد دژم"
  },
  {
    "poem_id": 1461,
    "vorder": 43,
    "position": 0,
    "text": "چو شد مست و هنگام خواب آمدش"
  },
  {
    "poem_id": 1461,
    "vorder": 44,
    "position": 1,
    "text": "همی از نشستن شتاب آمدش"
  },
  {
    "poem_id": 1461,
    "vorder": 45,
    "position": 0,
    "text": "سزاوار او جای آرام و خواب"
  },
  {
    "poem_id": 1461,
    "vorder": 46,
    "position": 1,
    "text": "بیاراست و بنهاد مشک و گلاب"
  }
]