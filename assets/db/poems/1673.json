[
  {
    "poem_id": 1673,
    "vorder": 1,
    "position": 0,
    "text": "سکندر سوی روشنایی رسید"
  },
  {
    "poem_id": 1673,
    "vorder": 2,
    "position": 1,
    "text": "یکی بر شد کوه رخشنده دید"
  },
  {
    "poem_id": 1673,
    "vorder": 3,
    "position": 0,
    "text": "زده بر سر کوه خارا عمود"
  },
  {
    "poem_id": 1673,
    "vorder": 4,
    "position": 1,
    "text": "سرش تا به ابر اندر از چوب عود"
  },
  {
    "poem_id": 1673,
    "vorder": 5,
    "position": 0,
    "text": "بر هر عمودی کنامی بزرگ"
  },
  {
    "poem_id": 1673,
    "vorder": 6,
    "position": 1,
    "text": "نشسته برو سبز مرغی سترگ"
  },
  {
    "poem_id": 1673,
    "vorder": 7,
    "position": 0,
    "text": "به آواز رومی سخن راندند"
  },
  {
    "poem_id": 1673,
    "vorder": 8,
    "position": 1,
    "text": "جهاندار پیروز را خواندند"
  },
  {
    "poem_id": 1673,
    "vorder": 9,
    "position": 0,
    "text": "چو آواز بشنید قیصر برفت"
  },
  {
    "poem_id": 1673,
    "vorder": 10,
    "position": 1,
    "text": "به نزدیک مرغان خرامید تفت"
  },
  {
    "poem_id": 1673,
    "vorder": 11,
    "position": 0,
    "text": "بدو مرغ گفت ای دلارای رنج"
  },
  {
    "poem_id": 1673,
    "vorder": 12,
    "position": 1,
    "text": "چه جویی همی زین سرای سپنج"
  },
  {
    "poem_id": 1673,
    "vorder": 13,
    "position": 0,
    "text": "اگر سر برآری به چرخ بلند"
  },
  {
    "poem_id": 1673,
    "vorder": 14,
    "position": 1,
    "text": "همان بازگردی ازو مستمند"
  },
  {
    "poem_id": 1673,
    "vorder": 15,
    "position": 0,
    "text": "کنون کامدی هیچ دیدی زنا"
  },
  {
    "poem_id": 1673,
    "vorder": 16,
    "position": 1,
    "text": "وگر کرده از خشت پخته بنا"
  },
  {
    "poem_id": 1673,
    "vorder": 17,
    "position": 0,
    "text": "چنین داد پاسخ کزین هر دو هست"
  },
  {
    "poem_id": 1673,
    "vorder": 18,
    "position": 1,
    "text": "زنا و برین گونه جای نشست"
  },
  {
    "poem_id": 1673,
    "vorder": 19,
    "position": 0,
    "text": "چو بشنید پاسخ فروتر نشست"
  },
  {
    "poem_id": 1673,
    "vorder": 20,
    "position": 1,
    "text": "درو خیره شد مرد یزدان‌پرست"
  },
  {
    "poem_id": 1673,
    "vorder": 21,
    "position": 0,
    "text": "بپرسید کاندر جهان بانگ رود"
  },
  {
    "poem_id": 1673,
    "vorder": 22,
    "position": 1,
    "text": "شنیدی و آوای مست و سرود"
  },
  {
    "poem_id": 1673,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد پاسخ که هر کو ز دهر"
  },
  {
    "poem_id": 1673,
    "vorder": 24,
    "position": 1,
    "text": "ز شادی همی برنگیرند بهر"
  },
  {
    "poem_id": 1673,
    "vorder": 25,
    "position": 0,
    "text": "ورا شاد مردم نخواند همی"
  },
  {
    "poem_id": 1673,
    "vorder": 26,
    "position": 1,
    "text": "وگر جان و دل برفشاند همی"
  },
  {
    "poem_id": 1673,
    "vorder": 27,
    "position": 0,
    "text": "به خاک آمد از بر شده چوب عمود"
  },
  {
    "poem_id": 1673,
    "vorder": 28,
    "position": 1,
    "text": "تهی ماند زان مرغ رنگین عمود"
  },
  {
    "poem_id": 1673,
    "vorder": 29,
    "position": 0,
    "text": "بپرسید دانایی و راستی"
  },
  {
    "poem_id": 1673,
    "vorder": 30,
    "position": 1,
    "text": "فزونست اگر کمی و کاستی"
  },
  {
    "poem_id": 1673,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد پاسخ که دانش پژوه"
  },
  {
    "poem_id": 1673,
    "vorder": 32,
    "position": 1,
    "text": "همی سرفرازد ز هر دو گروه"
  },
  {
    "poem_id": 1673,
    "vorder": 33,
    "position": 0,
    "text": "به سوی عمود آمد از تیره خاک"
  },
  {
    "poem_id": 1673,
    "vorder": 34,
    "position": 1,
    "text": "به منقار چنگالها کرد پاک"
  },
  {
    "poem_id": 1673,
    "vorder": 35,
    "position": 0,
    "text": "ز قیصر بپرسید یزدان‌پرست"
  },
  {
    "poem_id": 1673,
    "vorder": 36,
    "position": 1,
    "text": "به شهر تو بر کوه دارد نشست"
  },
  {
    "poem_id": 1673,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت چون مرد شد پاک‌رای"
  },
  {
    "poem_id": 1673,
    "vorder": 38,
    "position": 1,
    "text": "بیابد پرستنده بر کوه جای"
  },
  {
    "poem_id": 1673,
    "vorder": 39,
    "position": 0,
    "text": "ازان چوب جوینده شد بر کنام"
  },
  {
    "poem_id": 1673,
    "vorder": 40,
    "position": 1,
    "text": "جهانجوی روشن‌دل و شادکام"
  },
  {
    "poem_id": 1673,
    "vorder": 41,
    "position": 0,
    "text": "به چنگال می‌کرد منقار تیز"
  },
  {
    "poem_id": 1673,
    "vorder": 42,
    "position": 1,
    "text": "چو ایمن شد از گردش رستخیز"
  },
  {
    "poem_id": 1673,
    "vorder": 43,
    "position": 0,
    "text": "به قیصر بفرمود تا بی‌گروه"
  },
  {
    "poem_id": 1673,
    "vorder": 44,
    "position": 1,
    "text": "پیاده شود بر سر تیغ کوه"
  },
  {
    "poem_id": 1673,
    "vorder": 45,
    "position": 0,
    "text": "ببیند که تا بر سر کوه چیست"
  },
  {
    "poem_id": 1673,
    "vorder": 46,
    "position": 1,
    "text": "کزو شادمان را بباید گریست"
  }
]