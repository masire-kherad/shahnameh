[
  {
    "poem_id": 1408,
    "vorder": 1,
    "position": 0,
    "text": "چو دشت از گیا گشت چون پرنیان"
  },
  {
    "poem_id": 1408,
    "vorder": 2,
    "position": 1,
    "text": "ببستند گردان توران میان"
  },
  {
    "poem_id": 1408,
    "vorder": 3,
    "position": 0,
    "text": "سپاهی بیامد ز ترکان و چین"
  },
  {
    "poem_id": 1408,
    "vorder": 4,
    "position": 1,
    "text": "هم از گرزداران خاور زمین"
  },
  {
    "poem_id": 1408,
    "vorder": 5,
    "position": 0,
    "text": "که آن را میان و کرانه نبود"
  },
  {
    "poem_id": 1408,
    "vorder": 6,
    "position": 1,
    "text": "همان بخت نوذر جوانه نبود"
  },
  {
    "poem_id": 1408,
    "vorder": 7,
    "position": 0,
    "text": "چو لشکر به نزدیک جیحون رسید"
  },
  {
    "poem_id": 1408,
    "vorder": 8,
    "position": 1,
    "text": "خبر نزد پور فریدون رسید"
  },
  {
    "poem_id": 1408,
    "vorder": 9,
    "position": 0,
    "text": "سپاه جهاندار بیرون شدند"
  },
  {
    "poem_id": 1408,
    "vorder": 10,
    "position": 1,
    "text": "ز کاخ همایون به هامون شدند"
  },
  {
    "poem_id": 1408,
    "vorder": 11,
    "position": 0,
    "text": "به راه دهستان نهادند روی"
  },
  {
    "poem_id": 1408,
    "vorder": 12,
    "position": 1,
    "text": "سپهدارشان قارن رزم‌جوی"
  },
  {
    "poem_id": 1408,
    "vorder": 13,
    "position": 0,
    "text": "شهنشاه نوذر پس پشت اوی"
  },
  {
    "poem_id": 1408,
    "vorder": 14,
    "position": 1,
    "text": "جهانی سراسر پر از گفت و گوی"
  },
  {
    "poem_id": 1408,
    "vorder": 15,
    "position": 0,
    "text": "چو لشکر به پیش دهستان رسید"
  },
  {
    "poem_id": 1408,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی که خورشید شد ناپدید"
  },
  {
    "poem_id": 1408,
    "vorder": 17,
    "position": 0,
    "text": "سراپردهٔ نوذر شهریار"
  },
  {
    "poem_id": 1408,
    "vorder": 18,
    "position": 1,
    "text": "کشیدند بر دشت پیش حصار"
  },
  {
    "poem_id": 1408,
    "vorder": 19,
    "position": 0,
    "text": "خود اندر دهستان نیاراست جنگ"
  },
  {
    "poem_id": 1408,
    "vorder": 20,
    "position": 1,
    "text": "برین بر نیامد زمانی درنگ"
  },
  {
    "poem_id": 1408,
    "vorder": 21,
    "position": 0,
    "text": "که افراسیاب اندر ایران زمین"
  },
  {
    "poem_id": 1408,
    "vorder": 22,
    "position": 1,
    "text": "دو سالار کرد از بزرگان گزین"
  },
  {
    "poem_id": 1408,
    "vorder": 23,
    "position": 0,
    "text": "شماساس و دیگر خزروان گرد"
  },
  {
    "poem_id": 1408,
    "vorder": 24,
    "position": 1,
    "text": "ز لشکر سواران بدیشان سپرد"
  },
  {
    "poem_id": 1408,
    "vorder": 25,
    "position": 0,
    "text": "ز جنگ آوران مرد چون سی هزار"
  },
  {
    "poem_id": 1408,
    "vorder": 26,
    "position": 1,
    "text": "برفتند شایستهٔ کارزار"
  },
  {
    "poem_id": 1408,
    "vorder": 27,
    "position": 0,
    "text": "سوی زابلستان نهادند روی"
  },
  {
    "poem_id": 1408,
    "vorder": 28,
    "position": 1,
    "text": "ز کینه به دستان نهادند روی"
  },
  {
    "poem_id": 1408,
    "vorder": 29,
    "position": 0,
    "text": "خبر شد که سام نریمان بمرد"
  },
  {
    "poem_id": 1408,
    "vorder": 30,
    "position": 1,
    "text": "همی دخمه سازد ورا زال گرد"
  },
  {
    "poem_id": 1408,
    "vorder": 31,
    "position": 0,
    "text": "ازان سخت شادان شد افراسیاب"
  },
  {
    "poem_id": 1408,
    "vorder": 32,
    "position": 1,
    "text": "بدید آنکه بخت اندر آمد به خواب"
  },
  {
    "poem_id": 1408,
    "vorder": 33,
    "position": 0,
    "text": "بیامد چو پیش دهستان رسید"
  },
  {
    "poem_id": 1408,
    "vorder": 34,
    "position": 1,
    "text": "برابر سراپرده‌ای برکشید"
  },
  {
    "poem_id": 1408,
    "vorder": 35,
    "position": 0,
    "text": "سپه را که دانست کردن شمار!"
  },
  {
    "poem_id": 1408,
    "vorder": 36,
    "position": 1,
    "text": "برو چارصد بار بشمر هزار"
  },
  {
    "poem_id": 1408,
    "vorder": 37,
    "position": 0,
    "text": "بجوشید گفتی همه ریگ و شخ"
  },
  {
    "poem_id": 1408,
    "vorder": 38,
    "position": 1,
    "text": "بیابان سراسر چو مور و ملخ"
  },
  {
    "poem_id": 1408,
    "vorder": 39,
    "position": 0,
    "text": "ابا شاه نوذر صد و چل هزار"
  },
  {
    "poem_id": 1408,
    "vorder": 40,
    "position": 1,
    "text": "همانا که بودند جنگی سوار"
  },
  {
    "poem_id": 1408,
    "vorder": 41,
    "position": 0,
    "text": "به لشکر نگه کرد افراسیاب"
  },
  {
    "poem_id": 1408,
    "vorder": 42,
    "position": 1,
    "text": "هیونی برافگند هنگام خواب"
  },
  {
    "poem_id": 1408,
    "vorder": 43,
    "position": 0,
    "text": "یکی نامه بنوشت سوی پشنگ"
  },
  {
    "poem_id": 1408,
    "vorder": 44,
    "position": 1,
    "text": "که جستیم نیکی و آمد به چنگ"
  },
  {
    "poem_id": 1408,
    "vorder": 45,
    "position": 0,
    "text": "همه لشکر نوذر ار بشکریم"
  },
  {
    "poem_id": 1408,
    "vorder": 46,
    "position": 1,
    "text": "شکارند و در زیر پی بسپریم"
  },
  {
    "poem_id": 1408,
    "vorder": 47,
    "position": 0,
    "text": "دگر سام رفت از در شهریار"
  },
  {
    "poem_id": 1408,
    "vorder": 48,
    "position": 1,
    "text": "همانا نیاید بدین کارزار"
  },
  {
    "poem_id": 1408,
    "vorder": 49,
    "position": 0,
    "text": "ستودان همی سازدش زال زر"
  },
  {
    "poem_id": 1408,
    "vorder": 50,
    "position": 1,
    "text": "ندارد همی جنگ را پای و پر"
  },
  {
    "poem_id": 1408,
    "vorder": 51,
    "position": 0,
    "text": "مرا بیم ازو بُد به ایران زمین"
  },
  {
    "poem_id": 1408,
    "vorder": 52,
    "position": 1,
    "text": "چو او شد، ز ایران بجوییم کین!"
  },
  {
    "poem_id": 1408,
    "vorder": 53,
    "position": 0,
    "text": "همانا شماساس در نیمروز"
  },
  {
    "poem_id": 1408,
    "vorder": 54,
    "position": 1,
    "text": "نشستست با تاج گیتی فروز"
  },
  {
    "poem_id": 1408,
    "vorder": 55,
    "position": 0,
    "text": "به هنگام هر کار جستن نکوست"
  },
  {
    "poem_id": 1408,
    "vorder": 56,
    "position": 1,
    "text": "زدن رای با مرد هشیار و دوست"
  },
  {
    "poem_id": 1408,
    "vorder": 57,
    "position": 0,
    "text": "چو کاهل شود مرد هنگام کار"
  },
  {
    "poem_id": 1408,
    "vorder": 58,
    "position": 1,
    "text": "ازان پس نیابد چنان روزگار"
  },
  {
    "poem_id": 1408,
    "vorder": 59,
    "position": 0,
    "text": "هیون تکاور برآورد پر"
  },
  {
    "poem_id": 1408,
    "vorder": 60,
    "position": 1,
    "text": "بشد نزد سالار خورشید فر"
  }
]