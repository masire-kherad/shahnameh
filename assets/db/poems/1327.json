[
  {
    "poem_id": 1327,
    "vorder": 1,
    "position": 0,
    "text": "تو را دانش و دین رهاند درست"
  },
  {
    "poem_id": 1327,
    "vorder": 2,
    "position": 1,
    "text": "در رستگاری ببایدت جست"
  },
  {
    "poem_id": 1327,
    "vorder": 3,
    "position": 0,
    "text": "وگر دل نخواهی که باشد نژند"
  },
  {
    "poem_id": 1327,
    "vorder": 4,
    "position": 1,
    "text": "نخواهی که دائم بُوی مستمند"
  },
  {
    "poem_id": 1327,
    "vorder": 5,
    "position": 0,
    "text": "به گفتار پیغمبرت راه جوی"
  },
  {
    "poem_id": 1327,
    "vorder": 6,
    "position": 1,
    "text": "دل از تیرگی‌ها بدین آب شوی"
  },
  {
    "poem_id": 1327,
    "vorder": 7,
    "position": 0,
    "text": "چه گفت آن خداوند تنزیل و وحی"
  },
  {
    "poem_id": 1327,
    "vorder": 8,
    "position": 1,
    "text": "خداوند امر و خداوند نهی"
  },
  {
    "poem_id": 1327,
    "vorder": 9,
    "position": 0,
    "text": "که خورشید بعد از رسولان مه"
  },
  {
    "poem_id": 1327,
    "vorder": 10,
    "position": 1,
    "text": "نتابید بر کس ز بوبکر به"
  },
  {
    "poem_id": 1327,
    "vorder": 11,
    "position": 0,
    "text": "عمر کرد اسلام را آشکار"
  },
  {
    "poem_id": 1327,
    "vorder": 12,
    "position": 1,
    "text": "بیاراست گیتی چو باغ بهار"
  },
  {
    "poem_id": 1327,
    "vorder": 13,
    "position": 0,
    "text": "پس از هر دو آن بود عثمان گزین"
  },
  {
    "poem_id": 1327,
    "vorder": 14,
    "position": 1,
    "text": "خداوند شرم و خداوند دین"
  },
  {
    "poem_id": 1327,
    "vorder": 15,
    "position": 0,
    "text": "چهارم علی بود جفت بتول"
  },
  {
    "poem_id": 1327,
    "vorder": 16,
    "position": 1,
    "text": "که او را به خوبی ستاید رسول"
  },
  {
    "poem_id": 1327,
    "vorder": 17,
    "position": 0,
    "text": "که من شهر علمم علیم در است"
  },
  {
    "poem_id": 1327,
    "vorder": 18,
    "position": 1,
    "text": "درست این سخن قول پیغمبر است"
  },
  {
    "poem_id": 1327,
    "vorder": 19,
    "position": 0,
    "text": "گواهی دهم کاین سخن‌ها از اوست"
  },
  {
    "poem_id": 1327,
    "vorder": 20,
    "position": 1,
    "text": "تو گویی دو گوشم پر آواز اوست"
  },
  {
    "poem_id": 1327,
    "vorder": 21,
    "position": 0,
    "text": "علی را چنین گفت و دیگر همین"
  },
  {
    "poem_id": 1327,
    "vorder": 22,
    "position": 1,
    "text": "کز ایشان قوی شد به هر گونه دین"
  },
  {
    "poem_id": 1327,
    "vorder": 23,
    "position": 0,
    "text": "نبی آفتاب و صحابان چو ماه"
  },
  {
    "poem_id": 1327,
    "vorder": 24,
    "position": 1,
    "text": "به هم بستهٔ یک‌دگر راست راه"
  },
  {
    "poem_id": 1327,
    "vorder": 25,
    "position": 0,
    "text": "منم بندهٔ اهل بیت نبی"
  },
  {
    "poem_id": 1327,
    "vorder": 26,
    "position": 1,
    "text": "ستایندهٔ خاک پای وصی"
  },
  {
    "poem_id": 1327,
    "vorder": 27,
    "position": 0,
    "text": "حکیم این جهان را چو دریا نهاد"
  },
  {
    "poem_id": 1327,
    "vorder": 28,
    "position": 1,
    "text": "برانگیخته موج از او تندباد"
  },
  {
    "poem_id": 1327,
    "vorder": 29,
    "position": 0,
    "text": "چو هفتاد کشتی بر او ساخته"
  },
  {
    "poem_id": 1327,
    "vorder": 30,
    "position": 1,
    "text": "همه بادبان‌ها بر افراخته"
  },
  {
    "poem_id": 1327,
    "vorder": 31,
    "position": 0,
    "text": "یکی پهن کشتی به سان عروس"
  },
  {
    "poem_id": 1327,
    "vorder": 32,
    "position": 1,
    "text": "بیاراسته همچو چشم خروس"
  },
  {
    "poem_id": 1327,
    "vorder": 33,
    "position": 0,
    "text": "محمّد بدو اندرون با علی"
  },
  {
    "poem_id": 1327,
    "vorder": 34,
    "position": 1,
    "text": "همان اهل بیت نبی و ولی"
  },
  {
    "poem_id": 1327,
    "vorder": 35,
    "position": 0,
    "text": "خردمند کز دور دریا بدید"
  },
  {
    "poem_id": 1327,
    "vorder": 36,
    "position": 1,
    "text": "کرانه نه پیدا و بن ناپدید"
  },
  {
    "poem_id": 1327,
    "vorder": 37,
    "position": 0,
    "text": "بدانست کو موج خواهد زدن"
  },
  {
    "poem_id": 1327,
    "vorder": 38,
    "position": 1,
    "text": "کس از غرق بیرون نخواهد شدن"
  },
  {
    "poem_id": 1327,
    "vorder": 39,
    "position": 0,
    "text": "به دل گفت اگر با نبی و وصی"
  },
  {
    "poem_id": 1327,
    "vorder": 40,
    "position": 1,
    "text": "شوم غرقه دارم دو یار وفی"
  },
  {
    "poem_id": 1327,
    "vorder": 41,
    "position": 0,
    "text": "همانا که باشد مرا دستگیر"
  },
  {
    "poem_id": 1327,
    "vorder": 42,
    "position": 1,
    "text": "خداوند تاج و لوا و سریر"
  },
  {
    "poem_id": 1327,
    "vorder": 43,
    "position": 0,
    "text": "خداوند جوی می و انگبین"
  },
  {
    "poem_id": 1327,
    "vorder": 44,
    "position": 1,
    "text": "همان چشمهٔ شیر و ماء معین"
  },
  {
    "poem_id": 1327,
    "vorder": 45,
    "position": 0,
    "text": "اگر چشم داری به دیگر سرای"
  },
  {
    "poem_id": 1327,
    "vorder": 46,
    "position": 1,
    "text": "به نزد نبی و علی گیر جای"
  },
  {
    "poem_id": 1327,
    "vorder": 47,
    "position": 0,
    "text": "گرت زین بد آید گناه من است"
  },
  {
    "poem_id": 1327,
    "vorder": 48,
    "position": 1,
    "text": "چنین است و این دین و راه من است"
  },
  {
    "poem_id": 1327,
    "vorder": 49,
    "position": 0,
    "text": "بر این زادم و هم بر این بگذرم"
  },
  {
    "poem_id": 1327,
    "vorder": 50,
    "position": 1,
    "text": "چنان دان که خاک پی حیدرم"
  },
  {
    "poem_id": 1327,
    "vorder": 51,
    "position": 0,
    "text": "دلت گر به راه خطا مایل است"
  },
  {
    "poem_id": 1327,
    "vorder": 52,
    "position": 1,
    "text": "تو را دشمن اندر جهان خود دل است"
  },
  {
    "poem_id": 1327,
    "vorder": 53,
    "position": 0,
    "text": "نباشد جز از بی‌پدر دشمنش"
  },
  {
    "poem_id": 1327,
    "vorder": 54,
    "position": 1,
    "text": "که یزدان به آتش بسوزد تنش"
  },
  {
    "poem_id": 1327,
    "vorder": 55,
    "position": 0,
    "text": "هر آنکس که در جانش بغض علی‌ست"
  },
  {
    "poem_id": 1327,
    "vorder": 56,
    "position": 1,
    "text": "از او زارتر در جهان زار کیست؟"
  },
  {
    "poem_id": 1327,
    "vorder": 57,
    "position": 0,
    "text": "نگر تا نداری به بازی جهان"
  },
  {
    "poem_id": 1327,
    "vorder": 58,
    "position": 1,
    "text": "نه برگردی از نیک‌ پی همرهان"
  },
  {
    "poem_id": 1327,
    "vorder": 59,
    "position": 0,
    "text": "همه نیکی‌ات باید آغاز کرد"
  },
  {
    "poem_id": 1327,
    "vorder": 60,
    "position": 1,
    "text": "چو با نیک‌نامان بُوی هم‌نورد"
  },
  {
    "poem_id": 1327,
    "vorder": 61,
    "position": 0,
    "text": "از این در سخن چند رانم همی"
  },
  {
    "poem_id": 1327,
    "vorder": 62,
    "position": 1,
    "text": "همانا کرانش ندانم همی"
  }
]