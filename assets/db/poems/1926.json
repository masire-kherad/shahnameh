[
  {
    "poem_id": 1926,
    "vorder": 1,
    "position": 0,
    "text": "فرستادهٔ نیز چون برق و رعد"
  },
  {
    "poem_id": 1926,
    "vorder": 2,
    "position": 1,
    "text": "فرستاد تازان به نزدیک سعد"
  },
  {
    "poem_id": 1926,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامه‌ای بر حریر سپید"
  },
  {
    "poem_id": 1926,
    "vorder": 4,
    "position": 1,
    "text": "نویسنده بنوشت تابان چو شید"
  },
  {
    "poem_id": 1926,
    "vorder": 5,
    "position": 0,
    "text": "به عنوان بر از پور هرمزد شاه"
  },
  {
    "poem_id": 1926,
    "vorder": 6,
    "position": 1,
    "text": "جهان پهلوان رستم نیک خواه"
  },
  {
    "poem_id": 1926,
    "vorder": 7,
    "position": 0,
    "text": "سوی سعدِ وَقاص جوینده جنگ"
  },
  {
    "poem_id": 1926,
    "vorder": 8,
    "position": 1,
    "text": "جهان کرده بر خویشتن تار و تنگ"
  },
  {
    "poem_id": 1926,
    "vorder": 9,
    "position": 0,
    "text": "سرنامه گفت از جهاندار پاک"
  },
  {
    "poem_id": 1926,
    "vorder": 10,
    "position": 1,
    "text": "بباید که باشیم با بیم و باک"
  },
  {
    "poem_id": 1926,
    "vorder": 11,
    "position": 0,
    "text": "کزویست بر پای گردان سپهر"
  },
  {
    "poem_id": 1926,
    "vorder": 12,
    "position": 1,
    "text": "همه پادشاهیش دادست و مهر"
  },
  {
    "poem_id": 1926,
    "vorder": 13,
    "position": 0,
    "text": "ازو باد بر شهریار آفرین"
  },
  {
    "poem_id": 1926,
    "vorder": 14,
    "position": 1,
    "text": "که زیبای تاجست و تخت و نگین"
  },
  {
    "poem_id": 1926,
    "vorder": 15,
    "position": 0,
    "text": "که دارد به فر اهرمن راببند"
  },
  {
    "poem_id": 1926,
    "vorder": 16,
    "position": 1,
    "text": "خداوند شمشیر و تاج بلند"
  },
  {
    "poem_id": 1926,
    "vorder": 17,
    "position": 0,
    "text": "به پیش آمد این ناپسندیده کار"
  },
  {
    "poem_id": 1926,
    "vorder": 18,
    "position": 1,
    "text": "به بیهوده این رنج و این کارزار"
  },
  {
    "poem_id": 1926,
    "vorder": 19,
    "position": 0,
    "text": "به من بازگوی آنک شاه تو کیست"
  },
  {
    "poem_id": 1926,
    "vorder": 20,
    "position": 1,
    "text": "چه مردی و آیین و راه تو چیست"
  },
  {
    "poem_id": 1926,
    "vorder": 21,
    "position": 0,
    "text": "به نزد که جویی همی دستگاه"
  },
  {
    "poem_id": 1926,
    "vorder": 22,
    "position": 1,
    "text": "برهنه سپهبد برهنه سپاه"
  },
  {
    "poem_id": 1926,
    "vorder": 23,
    "position": 0,
    "text": "به نانی تو سیری و هم گرسنه"
  },
  {
    "poem_id": 1926,
    "vorder": 24,
    "position": 1,
    "text": "نه پیل و نه تخت و نه بار و بنه"
  },
  {
    "poem_id": 1926,
    "vorder": 25,
    "position": 0,
    "text": "به ایران تو را زندگانی بس است"
  },
  {
    "poem_id": 1926,
    "vorder": 26,
    "position": 1,
    "text": "که تاج و نگین بهر دیگر کس است"
  },
  {
    "poem_id": 1926,
    "vorder": 27,
    "position": 0,
    "text": "که با پیل و گنجست و با فروجاه"
  },
  {
    "poem_id": 1926,
    "vorder": 28,
    "position": 1,
    "text": "پدر بر پدر نامبردار شاه"
  },
  {
    "poem_id": 1926,
    "vorder": 29,
    "position": 0,
    "text": "به دیدار او بر فلک ماه نیست"
  },
  {
    "poem_id": 1926,
    "vorder": 30,
    "position": 1,
    "text": "به بالای او بر زمین شاه نیست"
  },
  {
    "poem_id": 1926,
    "vorder": 31,
    "position": 0,
    "text": "هر آن گه که در بزم خندان شود"
  },
  {
    "poem_id": 1926,
    "vorder": 32,
    "position": 1,
    "text": "گشاده لب و سیم دندان شود"
  },
  {
    "poem_id": 1926,
    "vorder": 33,
    "position": 0,
    "text": "به بخشد بهای سر تازیان"
  },
  {
    "poem_id": 1926,
    "vorder": 34,
    "position": 1,
    "text": "که بر گنج او زان نیاید زیان"
  },
  {
    "poem_id": 1926,
    "vorder": 35,
    "position": 0,
    "text": "سگ و یوز و بازش ده و دو هزار"
  },
  {
    "poem_id": 1926,
    "vorder": 36,
    "position": 1,
    "text": "که با زنگ و زرند و با گوشوار"
  },
  {
    "poem_id": 1926,
    "vorder": 37,
    "position": 0,
    "text": "به سالی همه دشت نیزه وران"
  },
  {
    "poem_id": 1926,
    "vorder": 38,
    "position": 1,
    "text": "نیابند خورد از کران تا کران"
  },
  {
    "poem_id": 1926,
    "vorder": 39,
    "position": 0,
    "text": "که او را به باید به یوز و به سگ"
  },
  {
    "poem_id": 1926,
    "vorder": 40,
    "position": 1,
    "text": "که در دشت نخچیر گیرد به تگ"
  },
  {
    "poem_id": 1926,
    "vorder": 41,
    "position": 0,
    "text": "سگ و یوز او بیشتر زان خورد"
  },
  {
    "poem_id": 1926,
    "vorder": 42,
    "position": 1,
    "text": "که شاه آن به چیزی همی‌نشمرد"
  },
  {
    "poem_id": 1926,
    "vorder": 43,
    "position": 0,
    "text": "شما را به دیده درون شرم نیست"
  },
  {
    "poem_id": 1926,
    "vorder": 44,
    "position": 1,
    "text": "ز راه خرد مهر و آزرم نیست"
  },
  {
    "poem_id": 1926,
    "vorder": 45,
    "position": 0,
    "text": "بدان چهره و زاد و آن مهر و خوی"
  },
  {
    "poem_id": 1926,
    "vorder": 46,
    "position": 1,
    "text": "چنین تاج و تخت آمدت آرزوی"
  },
  {
    "poem_id": 1926,
    "vorder": 47,
    "position": 0,
    "text": "جهان گر بر اندازه جویی همی"
  },
  {
    "poem_id": 1926,
    "vorder": 48,
    "position": 1,
    "text": "سخن بر گزافه نگویی همی"
  },
  {
    "poem_id": 1926,
    "vorder": 49,
    "position": 0,
    "text": "سخن گوی مردی برِ ما فرست"
  },
  {
    "poem_id": 1926,
    "vorder": 50,
    "position": 1,
    "text": "جهاندیده و گرد و زیبا فرست"
  },
  {
    "poem_id": 1926,
    "vorder": 51,
    "position": 0,
    "text": "بدان تا بگوید که رای تو چیست"
  },
  {
    "poem_id": 1926,
    "vorder": 52,
    "position": 1,
    "text": "به تخت کیان رهنمای تو کیست"
  },
  {
    "poem_id": 1926,
    "vorder": 53,
    "position": 0,
    "text": "سواری فرستیم نزدیک شاه"
  },
  {
    "poem_id": 1926,
    "vorder": 54,
    "position": 1,
    "text": "بخواهیم ازو هرچ خواهی بخواه"
  },
  {
    "poem_id": 1926,
    "vorder": 55,
    "position": 0,
    "text": "تو جنگ چنان پادشاهی مجوی"
  },
  {
    "poem_id": 1926,
    "vorder": 56,
    "position": 1,
    "text": "که فرجام کارانده آید بروی"
  },
  {
    "poem_id": 1926,
    "vorder": 57,
    "position": 0,
    "text": "نبیره جهاندار نوشین روان"
  },
  {
    "poem_id": 1926,
    "vorder": 58,
    "position": 1,
    "text": "که با داد او پیرگردد جوان"
  },
  {
    "poem_id": 1926,
    "vorder": 59,
    "position": 0,
    "text": "پدر بر پدر شاه و خود شهریار"
  },
  {
    "poem_id": 1926,
    "vorder": 60,
    "position": 1,
    "text": "زمانه ندارد چنو یادگار"
  },
  {
    "poem_id": 1926,
    "vorder": 61,
    "position": 0,
    "text": "جهانی مکن پر ز نفرین خویش"
  },
  {
    "poem_id": 1926,
    "vorder": 62,
    "position": 1,
    "text": "مشو بد گمان اندر آیین خویش"
  },
  {
    "poem_id": 1926,
    "vorder": 63,
    "position": 0,
    "text": "به تخت کیان تا نباشد نژاد"
  },
  {
    "poem_id": 1926,
    "vorder": 64,
    "position": 1,
    "text": "نجوید خداوند فرهنگ و داد"
  },
  {
    "poem_id": 1926,
    "vorder": 65,
    "position": 0,
    "text": "نگه کن بدین نامهٔ پندمند"
  },
  {
    "poem_id": 1926,
    "vorder": 66,
    "position": 1,
    "text": "مکن چشم و گوش و خرد را ببند"
  },
  {
    "poem_id": 1926,
    "vorder": 67,
    "position": 0,
    "text": "چو نامه به مهر اندر آمد به داد"
  },
  {
    "poem_id": 1926,
    "vorder": 68,
    "position": 1,
    "text": "به پیروز شاپور فرخ نژاد"
  },
  {
    "poem_id": 1926,
    "vorder": 69,
    "position": 0,
    "text": "بر سعد وقاص شد پهلوان"
  },
  {
    "poem_id": 1926,
    "vorder": 70,
    "position": 1,
    "text": "از ایران بزرگان روشن روان"
  },
  {
    "poem_id": 1926,
    "vorder": 71,
    "position": 0,
    "text": "همه غرقه در جوشن و سیم و زر"
  },
  {
    "poem_id": 1926,
    "vorder": 72,
    "position": 1,
    "text": "سپرهای زرین و زرین کمر"
  }
]