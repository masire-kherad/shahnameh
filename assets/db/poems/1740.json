[
  {
    "poem_id": 1740,
    "vorder": 1,
    "position": 0,
    "text": "ببود آن شب و خورد و گفت و شنید"
  },
  {
    "poem_id": 1740,
    "vorder": 2,
    "position": 1,
    "text": "سپیده چو از کوه سر بر کشید"
  },
  {
    "poem_id": 1740,
    "vorder": 3,
    "position": 0,
    "text": "چو زرین درفشی برآورد راغ"
  },
  {
    "poem_id": 1740,
    "vorder": 4,
    "position": 1,
    "text": "بر میهمان شد خداوند باغ"
  },
  {
    "poem_id": 1740,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت روز تو فرخنده باد"
  },
  {
    "poem_id": 1740,
    "vorder": 6,
    "position": 1,
    "text": "سرت برتر از بر بارنده باد"
  },
  {
    "poem_id": 1740,
    "vorder": 7,
    "position": 0,
    "text": "سزای تومان جایگاهی نبود"
  },
  {
    "poem_id": 1740,
    "vorder": 8,
    "position": 1,
    "text": "به آرام شایسته گاهی نبود"
  },
  {
    "poem_id": 1740,
    "vorder": 9,
    "position": 0,
    "text": "چو مهمان درویش باشی خورش"
  },
  {
    "poem_id": 1740,
    "vorder": 10,
    "position": 1,
    "text": "نیابی نه پوشیدن و پرورش"
  },
  {
    "poem_id": 1740,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت شاپور کای نیک‌بخت"
  },
  {
    "poem_id": 1740,
    "vorder": 12,
    "position": 1,
    "text": "من این خانه بگزیدم از تاج و تخت"
  },
  {
    "poem_id": 1740,
    "vorder": 13,
    "position": 0,
    "text": "یکی زند و اُست آر با بَرسَمَت"
  },
  {
    "poem_id": 1740,
    "vorder": 14,
    "position": 1,
    "text": "به زمزم یکی پاسخی پرسمت"
  },
  {
    "poem_id": 1740,
    "vorder": 15,
    "position": 0,
    "text": "بیاورد هرچش بفرمود شاه"
  },
  {
    "poem_id": 1740,
    "vorder": 16,
    "position": 1,
    "text": "بیفزود نزدیک شه پایگاه"
  },
  {
    "poem_id": 1740,
    "vorder": 17,
    "position": 0,
    "text": "به زمزم بدو گفت برگوی راست"
  },
  {
    "poem_id": 1740,
    "vorder": 18,
    "position": 1,
    "text": "کجا موبد موبد اکنون کجاست"
  },
  {
    "poem_id": 1740,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ ورا باغبان"
  },
  {
    "poem_id": 1740,
    "vorder": 20,
    "position": 1,
    "text": "که ای پاک‌دل مرد شیرین‌زبان"
  },
  {
    "poem_id": 1740,
    "vorder": 21,
    "position": 0,
    "text": "دو چشمم ز جایی که دارم نشست"
  },
  {
    "poem_id": 1740,
    "vorder": 22,
    "position": 1,
    "text": "بدان خانهٔ موبدان موبه دست"
  },
  {
    "poem_id": 1740,
    "vorder": 23,
    "position": 0,
    "text": "نهانی به پالیزبان گفت شاه"
  },
  {
    "poem_id": 1740,
    "vorder": 24,
    "position": 1,
    "text": "که از مهتر ده گل مهره خواه"
  },
  {
    "poem_id": 1740,
    "vorder": 25,
    "position": 0,
    "text": "چو بشنید زو این سخن باغبان"
  },
  {
    "poem_id": 1740,
    "vorder": 26,
    "position": 1,
    "text": "گل و مشک و می خواست و آمد دمان"
  },
  {
    "poem_id": 1740,
    "vorder": 27,
    "position": 0,
    "text": "جهاندار بنهاد بر گل نگین"
  },
  {
    "poem_id": 1740,
    "vorder": 28,
    "position": 1,
    "text": "بدان باغبان داد و کرد آفرین"
  },
  {
    "poem_id": 1740,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت کین گل به موبد سپار"
  },
  {
    "poem_id": 1740,
    "vorder": 30,
    "position": 1,
    "text": "نگر تا چه گوید همه گوش دار"
  },
  {
    "poem_id": 1740,
    "vorder": 31,
    "position": 0,
    "text": "سپیده دمان مرد با مهر شاه"
  },
  {
    "poem_id": 1740,
    "vorder": 32,
    "position": 1,
    "text": "بر موبد موبد آمد پگاه"
  },
  {
    "poem_id": 1740,
    "vorder": 33,
    "position": 0,
    "text": "چو نزدیک درگاه موبد رسید"
  },
  {
    "poem_id": 1740,
    "vorder": 34,
    "position": 1,
    "text": "پراگنده گردان و در بسته دید"
  },
  {
    "poem_id": 1740,
    "vorder": 35,
    "position": 0,
    "text": "به آواز زان بارگه بار خواست"
  },
  {
    "poem_id": 1740,
    "vorder": 36,
    "position": 1,
    "text": "چو بگشاد در باغبان رفت راست"
  },
  {
    "poem_id": 1740,
    "vorder": 37,
    "position": 0,
    "text": "چو آمد به نزدیک موبد فراز"
  },
  {
    "poem_id": 1740,
    "vorder": 38,
    "position": 1,
    "text": "بدو مهر بنمود و بردش نماز"
  },
  {
    "poem_id": 1740,
    "vorder": 39,
    "position": 0,
    "text": "چو موبد نگه کرد و آن مهره دید"
  },
  {
    "poem_id": 1740,
    "vorder": 40,
    "position": 1,
    "text": "ز شادی دل رای‌زن بردمید"
  },
  {
    "poem_id": 1740,
    "vorder": 41,
    "position": 0,
    "text": "وزان پس بران نام چندی گریست"
  },
  {
    "poem_id": 1740,
    "vorder": 42,
    "position": 1,
    "text": "بدان باغبان گفت کاین مهر کیست"
  },
  {
    "poem_id": 1740,
    "vorder": 43,
    "position": 0,
    "text": "چنین داد پاسخ که ای نامدار"
  },
  {
    "poem_id": 1740,
    "vorder": 44,
    "position": 1,
    "text": "نشسته به خان منست این سوار"
  },
  {
    "poem_id": 1740,
    "vorder": 45,
    "position": 0,
    "text": "یکی ماه با وی چو سرو سهی"
  },
  {
    "poem_id": 1740,
    "vorder": 46,
    "position": 1,
    "text": "خردمند و با زیب و با فرهی"
  },
  {
    "poem_id": 1740,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت موبد که ای نامجوی"
  },
  {
    "poem_id": 1740,
    "vorder": 48,
    "position": 1,
    "text": "نشان که دارد به بالا و روی"
  },
  {
    "poem_id": 1740,
    "vorder": 49,
    "position": 0,
    "text": "بدو باغبان گفت هرکو بهار"
  },
  {
    "poem_id": 1740,
    "vorder": 50,
    "position": 1,
    "text": "بدیدست سرو از لب جویبار"
  },
  {
    "poem_id": 1740,
    "vorder": 51,
    "position": 0,
    "text": "دو بازو به کردار ران هیون"
  },
  {
    "poem_id": 1740,
    "vorder": 52,
    "position": 1,
    "text": "برش چون بر شیر و چهرش چو خون"
  },
  {
    "poem_id": 1740,
    "vorder": 53,
    "position": 0,
    "text": "همی رنگ شرم آید از مهر اوی"
  },
  {
    "poem_id": 1740,
    "vorder": 54,
    "position": 1,
    "text": "همی زیب تاج آید از چهر اوی"
  }
]