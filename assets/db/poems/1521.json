[
  {
    "poem_id": 1521,
    "vorder": 1,
    "position": 0,
    "text": "بشد اهرن و هرچ گشتاسپ خواست"
  },
  {
    "poem_id": 1521,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد چون کارها گشت راست"
  },
  {
    "poem_id": 1521,
    "vorder": 3,
    "position": 0,
    "text": "ز دریا به زین اندر آورد پای"
  },
  {
    "poem_id": 1521,
    "vorder": 4,
    "position": 1,
    "text": "برفتند یارانش با او ز جای"
  },
  {
    "poem_id": 1521,
    "vorder": 5,
    "position": 0,
    "text": "چو هیشوی کوه سقیلا بدید"
  },
  {
    "poem_id": 1521,
    "vorder": 6,
    "position": 1,
    "text": "به انگشت بنمود و خود را کشید"
  },
  {
    "poem_id": 1521,
    "vorder": 7,
    "position": 0,
    "text": "خود و اهرن از جای گشتند باز"
  },
  {
    "poem_id": 1521,
    "vorder": 8,
    "position": 1,
    "text": "چو خورشید برزد سنان از فراز"
  },
  {
    "poem_id": 1521,
    "vorder": 9,
    "position": 0,
    "text": "جهانجوی بر پیش آن کوه بود"
  },
  {
    "poem_id": 1521,
    "vorder": 10,
    "position": 1,
    "text": "که آرام آن مار نستوه بود"
  },
  {
    "poem_id": 1521,
    "vorder": 11,
    "position": 0,
    "text": "چو آن اژدهابرز او را بدید"
  },
  {
    "poem_id": 1521,
    "vorder": 12,
    "position": 1,
    "text": "به دم سوی خویشش همی درکشید"
  },
  {
    "poem_id": 1521,
    "vorder": 13,
    "position": 0,
    "text": "چو از پیش زین اندر آویخت ترگ"
  },
  {
    "poem_id": 1521,
    "vorder": 14,
    "position": 1,
    "text": "برو تیر بارید همچون تگرگ"
  },
  {
    "poem_id": 1521,
    "vorder": 15,
    "position": 0,
    "text": "چو تنگ اندر آمد بران اژدها"
  },
  {
    "poem_id": 1521,
    "vorder": 16,
    "position": 1,
    "text": "همی جست مرد جوان زو رها"
  },
  {
    "poem_id": 1521,
    "vorder": 17,
    "position": 0,
    "text": "سبک خنجر اندر دهانش نهاد"
  },
  {
    "poem_id": 1521,
    "vorder": 18,
    "position": 1,
    "text": "ز دادار نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1521,
    "vorder": 19,
    "position": 0,
    "text": "بزد تیز دندان بدان خنجرش"
  },
  {
    "poem_id": 1521,
    "vorder": 20,
    "position": 1,
    "text": "همه تیغها شد به کام اندرش"
  },
  {
    "poem_id": 1521,
    "vorder": 21,
    "position": 0,
    "text": "به زهر و به خون کوه یکسر بشست"
  },
  {
    "poem_id": 1521,
    "vorder": 22,
    "position": 1,
    "text": "همی ریخت زو زهر تا گشت سست"
  },
  {
    "poem_id": 1521,
    "vorder": 23,
    "position": 0,
    "text": "به شمشیر برد آن زمان دست شیر"
  },
  {
    "poem_id": 1521,
    "vorder": 24,
    "position": 1,
    "text": "بزد بر سر اژدهای دلیر"
  },
  {
    "poem_id": 1521,
    "vorder": 25,
    "position": 0,
    "text": "همی ریخت مغزش بران سنگ سخت"
  },
  {
    "poem_id": 1521,
    "vorder": 26,
    "position": 1,
    "text": "ز باره درآمد گو نیکبخت"
  },
  {
    "poem_id": 1521,
    "vorder": 27,
    "position": 0,
    "text": "بکند از دهانش دو دندان نخست"
  },
  {
    "poem_id": 1521,
    "vorder": 28,
    "position": 1,
    "text": "پس آنگه بیامد سر و تن بشست"
  },
  {
    "poem_id": 1521,
    "vorder": 29,
    "position": 0,
    "text": "خروشان بغلتید بر خاک بر"
  },
  {
    "poem_id": 1521,
    "vorder": 30,
    "position": 1,
    "text": "به پیش خداوند پیروزگر"
  },
  {
    "poem_id": 1521,
    "vorder": 31,
    "position": 0,
    "text": "کجا داد آن دستگاه بزرگ"
  },
  {
    "poem_id": 1521,
    "vorder": 32,
    "position": 1,
    "text": "بران گرگ و آن اژدهای سترگ"
  },
  {
    "poem_id": 1521,
    "vorder": 33,
    "position": 0,
    "text": "همی گفت لهراسپ و فرخ زریر"
  },
  {
    "poem_id": 1521,
    "vorder": 34,
    "position": 1,
    "text": "شدند از تن و جان گشتاسپ سیر"
  },
  {
    "poem_id": 1521,
    "vorder": 35,
    "position": 0,
    "text": "به روشن روان و دل و زور و تاب"
  },
  {
    "poem_id": 1521,
    "vorder": 36,
    "position": 1,
    "text": "همانا نبینند ما را به خواب"
  },
  {
    "poem_id": 1521,
    "vorder": 37,
    "position": 0,
    "text": "بجز رنج و سختی نبینم ز دهر"
  },
  {
    "poem_id": 1521,
    "vorder": 38,
    "position": 1,
    "text": "پراگنده بر جای تریاک زهر"
  },
  {
    "poem_id": 1521,
    "vorder": 39,
    "position": 0,
    "text": "مگر زندگانی دهد کردگار"
  },
  {
    "poem_id": 1521,
    "vorder": 40,
    "position": 1,
    "text": "که بینم یکی روی آن شهریار"
  },
  {
    "poem_id": 1521,
    "vorder": 41,
    "position": 0,
    "text": "دگر چهر فرخ برادر زریر"
  },
  {
    "poem_id": 1521,
    "vorder": 42,
    "position": 1,
    "text": "بگویم که گشتم من از تاج سیر"
  },
  {
    "poem_id": 1521,
    "vorder": 43,
    "position": 0,
    "text": "بگویم که بر من چه آمد ز بخت"
  },
  {
    "poem_id": 1521,
    "vorder": 44,
    "position": 1,
    "text": "همی تخت جستم که گم گشت تخت"
  },
  {
    "poem_id": 1521,
    "vorder": 45,
    "position": 0,
    "text": "پر از آب رخ بارگی برنشست"
  },
  {
    "poem_id": 1521,
    "vorder": 46,
    "position": 1,
    "text": "همان خنجر آب داده به دست"
  },
  {
    "poem_id": 1521,
    "vorder": 47,
    "position": 0,
    "text": "چو نزدیک هیشوی و اهرن رسید"
  },
  {
    "poem_id": 1521,
    "vorder": 48,
    "position": 1,
    "text": "همه یاد کرد آن شگفتی که دید"
  },
  {
    "poem_id": 1521,
    "vorder": 49,
    "position": 0,
    "text": "به اهرن چنین گفت کان اژدها"
  },
  {
    "poem_id": 1521,
    "vorder": 50,
    "position": 1,
    "text": "بدین خنجر تیز شد بی‌بها"
  },
  {
    "poem_id": 1521,
    "vorder": 51,
    "position": 0,
    "text": "شما از دم اژدهای بزرگ"
  },
  {
    "poem_id": 1521,
    "vorder": 52,
    "position": 1,
    "text": "پر از بیم گشتید از کار گرگ"
  },
  {
    "poem_id": 1521,
    "vorder": 53,
    "position": 0,
    "text": "مرا کارزار دلاور سران"
  },
  {
    "poem_id": 1521,
    "vorder": 54,
    "position": 1,
    "text": "سرافراز با گرزهای گران"
  },
  {
    "poem_id": 1521,
    "vorder": 55,
    "position": 0,
    "text": "بسی تیز آید ز جنگ نهنگ"
  },
  {
    "poem_id": 1521,
    "vorder": 56,
    "position": 1,
    "text": "که از ژرف برآید به جنگ"
  },
  {
    "poem_id": 1521,
    "vorder": 57,
    "position": 0,
    "text": "چنین اژدها من بسی دیده‌ام"
  },
  {
    "poem_id": 1521,
    "vorder": 58,
    "position": 1,
    "text": "که از رزم او سر نپیچیده‌ام"
  },
  {
    "poem_id": 1521,
    "vorder": 59,
    "position": 0,
    "text": "شنیدند هیشوی و اهرن سخن"
  },
  {
    "poem_id": 1521,
    "vorder": 60,
    "position": 1,
    "text": "ازان نو به گفتار دانش کهن"
  },
  {
    "poem_id": 1521,
    "vorder": 61,
    "position": 0,
    "text": "چو آواز او آن دو گردن‌فراز"
  },
  {
    "poem_id": 1521,
    "vorder": 62,
    "position": 1,
    "text": "شنیدند و بردند پیشش نماز"
  },
  {
    "poem_id": 1521,
    "vorder": 63,
    "position": 0,
    "text": "به گشتاسپ گفتند کی نره شیر"
  },
  {
    "poem_id": 1521,
    "vorder": 64,
    "position": 1,
    "text": "که چون تو نزاید ز مادر دلیر"
  },
  {
    "poem_id": 1521,
    "vorder": 65,
    "position": 0,
    "text": "بیاورد اهرن بسی خواسته"
  },
  {
    "poem_id": 1521,
    "vorder": 66,
    "position": 1,
    "text": "گرانمایه اسپان آراسته"
  },
  {
    "poem_id": 1521,
    "vorder": 67,
    "position": 0,
    "text": "یکی تیغ برداشت و یک باره جنگ"
  },
  {
    "poem_id": 1521,
    "vorder": 68,
    "position": 1,
    "text": "کمانی و سه چوبه تیر خدنگ"
  },
  {
    "poem_id": 1521,
    "vorder": 69,
    "position": 0,
    "text": "به هیشوی داد آن دگر هرچ بود"
  },
  {
    "poem_id": 1521,
    "vorder": 70,
    "position": 1,
    "text": "ز دینار وز جامهٔ نابسود"
  },
  {
    "poem_id": 1521,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت گشتاسپ با سرکشان"
  },
  {
    "poem_id": 1521,
    "vorder": 72,
    "position": 1,
    "text": "کزین کس نباید که دارد نشان"
  },
  {
    "poem_id": 1521,
    "vorder": 73,
    "position": 0,
    "text": "نه از من که نر اژدها دیده‌ام"
  },
  {
    "poem_id": 1521,
    "vorder": 74,
    "position": 1,
    "text": "گر آواز آن گرگ بشنیده‌ام"
  },
  {
    "poem_id": 1521,
    "vorder": 75,
    "position": 0,
    "text": "وزان جایگه شاد و خرم برفت"
  },
  {
    "poem_id": 1521,
    "vorder": 76,
    "position": 1,
    "text": "به سوی کتایون خرامید تفت"
  },
  {
    "poem_id": 1521,
    "vorder": 77,
    "position": 0,
    "text": "بشد اهرن و گاو گردون ببرد"
  },
  {
    "poem_id": 1521,
    "vorder": 78,
    "position": 1,
    "text": "تن اژدها کهتران را سپرد"
  },
  {
    "poem_id": 1521,
    "vorder": 79,
    "position": 0,
    "text": "که این را به درگاه قیصر برید"
  },
  {
    "poem_id": 1521,
    "vorder": 80,
    "position": 1,
    "text": "به پیش بزرگان لشگر برید"
  },
  {
    "poem_id": 1521,
    "vorder": 81,
    "position": 0,
    "text": "خود از پیش گاوان و گردون برفت"
  },
  {
    "poem_id": 1521,
    "vorder": 82,
    "position": 1,
    "text": "به نزدیک قیصر خرامید تفت"
  },
  {
    "poem_id": 1521,
    "vorder": 83,
    "position": 0,
    "text": "به روم اندرون آگهی یافتند"
  },
  {
    "poem_id": 1521,
    "vorder": 84,
    "position": 1,
    "text": "جهاندیدگان پیش بشتافتند"
  },
  {
    "poem_id": 1521,
    "vorder": 85,
    "position": 0,
    "text": "چو گاو اندر آمد به هامون ز کوه"
  },
  {
    "poem_id": 1521,
    "vorder": 86,
    "position": 1,
    "text": "خروشی بد اندر میان گروه"
  },
  {
    "poem_id": 1521,
    "vorder": 87,
    "position": 0,
    "text": "ازان زخم و آن اژدهای دژم"
  },
  {
    "poem_id": 1521,
    "vorder": 88,
    "position": 1,
    "text": "کزان بود بر گاو گردون ستم"
  },
  {
    "poem_id": 1521,
    "vorder": 89,
    "position": 0,
    "text": "همی آمد از چرخ بانگ چکاو"
  },
  {
    "poem_id": 1521,
    "vorder": 90,
    "position": 1,
    "text": "تو گفتی ندارد تن گاو تاو"
  },
  {
    "poem_id": 1521,
    "vorder": 91,
    "position": 0,
    "text": "هرانکس که آن زخم شمشیر دید"
  },
  {
    "poem_id": 1521,
    "vorder": 92,
    "position": 1,
    "text": "خروشیدن گاو گردون شنید"
  },
  {
    "poem_id": 1521,
    "vorder": 93,
    "position": 0,
    "text": "همی گفت کاین خنجر اهرنست"
  },
  {
    "poem_id": 1521,
    "vorder": 94,
    "position": 1,
    "text": "وگر زخم شیراوژن آهرمنست"
  },
  {
    "poem_id": 1521,
    "vorder": 95,
    "position": 0,
    "text": "همانگاه قیصر ز ایوان براند"
  },
  {
    "poem_id": 1521,
    "vorder": 96,
    "position": 1,
    "text": "بزرگان و فرزانگان را بخواند"
  },
  {
    "poem_id": 1521,
    "vorder": 97,
    "position": 0,
    "text": "بران اژدها بر یکی جشن کرد"
  },
  {
    "poem_id": 1521,
    "vorder": 98,
    "position": 1,
    "text": "ز شبگیر تا شد جهان لاژورد"
  },
  {
    "poem_id": 1521,
    "vorder": 99,
    "position": 0,
    "text": "چو خورشید بنهاد بر چرخ تاج"
  },
  {
    "poem_id": 1521,
    "vorder": 100,
    "position": 1,
    "text": "به کردار زر آب شد روی عاج"
  },
  {
    "poem_id": 1521,
    "vorder": 101,
    "position": 0,
    "text": "فرستاده قیصر سقف را بخواند"
  },
  {
    "poem_id": 1521,
    "vorder": 102,
    "position": 1,
    "text": "بپرسید و بر تخت زرین نشاند"
  },
  {
    "poem_id": 1521,
    "vorder": 103,
    "position": 0,
    "text": "ز بطریق وز جاثلیقان شهر"
  },
  {
    "poem_id": 1521,
    "vorder": 104,
    "position": 1,
    "text": "هرانکس کش از مردمی بود بهر"
  },
  {
    "poem_id": 1521,
    "vorder": 105,
    "position": 0,
    "text": "به پیش سکوبا شدند انجمن"
  },
  {
    "poem_id": 1521,
    "vorder": 106,
    "position": 1,
    "text": "جهاندیده با قیصر و رای زن"
  },
  {
    "poem_id": 1521,
    "vorder": 107,
    "position": 0,
    "text": "به اهرن سپردند پس دخترش"
  },
  {
    "poem_id": 1521,
    "vorder": 108,
    "position": 1,
    "text": "به دستوری مهربان مادرش"
  },
  {
    "poem_id": 1521,
    "vorder": 109,
    "position": 0,
    "text": "ز ایوان چو مردم پراکنده شد"
  },
  {
    "poem_id": 1521,
    "vorder": 110,
    "position": 1,
    "text": "دل نامور زان سخن زنده شد"
  },
  {
    "poem_id": 1521,
    "vorder": 111,
    "position": 0,
    "text": "چنین گفت کامروز روز منست"
  },
  {
    "poem_id": 1521,
    "vorder": 112,
    "position": 1,
    "text": "بلند آسمان دلفروز منست"
  },
  {
    "poem_id": 1521,
    "vorder": 113,
    "position": 0,
    "text": "که کس چون دو داماد من در جهان"
  },
  {
    "poem_id": 1521,
    "vorder": 114,
    "position": 1,
    "text": "نبینند بیش از کهان و مهان"
  },
  {
    "poem_id": 1521,
    "vorder": 115,
    "position": 0,
    "text": "نوشتند نامه به هر مهتری"
  },
  {
    "poem_id": 1521,
    "vorder": 116,
    "position": 1,
    "text": "کجا داشتی تخت گر افسری"
  },
  {
    "poem_id": 1521,
    "vorder": 117,
    "position": 0,
    "text": "که نر اژدها با سرافراز گرگ"
  },
  {
    "poem_id": 1521,
    "vorder": 118,
    "position": 1,
    "text": "تبه شد به دست دو مرد سترگ"
  },
  {
    "poem_id": 1521,
    "vorder": 119,
    "position": 0,
    "text": "یکی منظری پیش ایوان خویش"
  },
  {
    "poem_id": 1521,
    "vorder": 120,
    "position": 1,
    "text": "برآورده چون تخت رخشان خویش"
  },
  {
    "poem_id": 1521,
    "vorder": 121,
    "position": 0,
    "text": "به میدان شدندی دو داماد اوی"
  },
  {
    "poem_id": 1521,
    "vorder": 122,
    "position": 1,
    "text": "بیاراستندی دل شاد اوی"
  },
  {
    "poem_id": 1521,
    "vorder": 123,
    "position": 0,
    "text": "به تیر و به چوگان و زخم سنان"
  },
  {
    "poem_id": 1521,
    "vorder": 124,
    "position": 1,
    "text": "بهر دانشی گرد کرده عنان"
  },
  {
    "poem_id": 1521,
    "vorder": 125,
    "position": 0,
    "text": "همی تاختندی چپ و دست راست"
  },
  {
    "poem_id": 1521,
    "vorder": 126,
    "position": 1,
    "text": "که گفتی سواری بدیشان سزاست"
  },
  {
    "poem_id": 1521,
    "vorder": 127,
    "position": 0,
    "text": "چنین تا برآمد برین روزگار"
  },
  {
    "poem_id": 1521,
    "vorder": 128,
    "position": 1,
    "text": "بیامد کتایون آموزگار"
  },
  {
    "poem_id": 1521,
    "vorder": 129,
    "position": 0,
    "text": "به گشتاسپ گفت ای نشسته دژم"
  },
  {
    "poem_id": 1521,
    "vorder": 130,
    "position": 1,
    "text": "چه داری ز اندیشه دل را به غم"
  },
  {
    "poem_id": 1521,
    "vorder": 131,
    "position": 0,
    "text": "به روم از بزرگان دو مهتر بدند"
  },
  {
    "poem_id": 1521,
    "vorder": 132,
    "position": 1,
    "text": "که با تاج و با گنج و افسر بدند"
  },
  {
    "poem_id": 1521,
    "vorder": 133,
    "position": 0,
    "text": "یکی آنک نر اژدها را بکشت"
  },
  {
    "poem_id": 1521,
    "vorder": 134,
    "position": 1,
    "text": "فراوان بلا دید و ننمود پشت"
  },
  {
    "poem_id": 1521,
    "vorder": 135,
    "position": 0,
    "text": "دگر آنک بر گرگ بدرید پوست"
  },
  {
    "poem_id": 1521,
    "vorder": 136,
    "position": 1,
    "text": "همه روم یکسر پرآواز اوست"
  },
  {
    "poem_id": 1521,
    "vorder": 137,
    "position": 0,
    "text": "به میدان قیصر به ننگ و نبرد"
  },
  {
    "poem_id": 1521,
    "vorder": 138,
    "position": 1,
    "text": "همی به آسمان اندر آرند گرد"
  },
  {
    "poem_id": 1521,
    "vorder": 139,
    "position": 0,
    "text": "نظاره شو انجا که قیصر بود"
  },
  {
    "poem_id": 1521,
    "vorder": 140,
    "position": 1,
    "text": "مگر بر دلت رنج کمتر بود"
  },
  {
    "poem_id": 1521,
    "vorder": 141,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای خوب چهر"
  },
  {
    "poem_id": 1521,
    "vorder": 142,
    "position": 1,
    "text": "ز قیصر مرا کی بود داد و مهر"
  },
  {
    "poem_id": 1521,
    "vorder": 143,
    "position": 0,
    "text": "ترا با من از شهر بیرون کند"
  },
  {
    "poem_id": 1521,
    "vorder": 144,
    "position": 1,
    "text": "چو بیند مرا مردمی چون کند"
  },
  {
    "poem_id": 1521,
    "vorder": 145,
    "position": 0,
    "text": "ولیکن ترا گر چنین است رای"
  },
  {
    "poem_id": 1521,
    "vorder": 146,
    "position": 1,
    "text": "نپیچم ز رای تو ای رهنمای"
  },
  {
    "poem_id": 1521,
    "vorder": 147,
    "position": 0,
    "text": "بیامد به میدان قیصر رسید"
  },
  {
    "poem_id": 1521,
    "vorder": 148,
    "position": 1,
    "text": "همی بود تا زخم چوگان بدید"
  },
  {
    "poem_id": 1521,
    "vorder": 149,
    "position": 0,
    "text": "ازیشان یکی گوی و چوگان بخواست"
  },
  {
    "poem_id": 1521,
    "vorder": 150,
    "position": 1,
    "text": "میان سواران برافگند راست"
  },
  {
    "poem_id": 1521,
    "vorder": 151,
    "position": 0,
    "text": "برانگیخت آن بارگی را ز جای"
  },
  {
    "poem_id": 1521,
    "vorder": 152,
    "position": 1,
    "text": "یلان را همه کند شد دست و پای"
  },
  {
    "poem_id": 1521,
    "vorder": 153,
    "position": 0,
    "text": "به میدان کسی نیز گویی ندید"
  },
  {
    "poem_id": 1521,
    "vorder": 154,
    "position": 1,
    "text": "شد از زخم او در جهان ناپدید"
  },
  {
    "poem_id": 1521,
    "vorder": 155,
    "position": 0,
    "text": "سواران کجا گوی او یافتند"
  },
  {
    "poem_id": 1521,
    "vorder": 156,
    "position": 1,
    "text": "به چوگان زدن نیز نشتافتند"
  },
  {
    "poem_id": 1521,
    "vorder": 157,
    "position": 0,
    "text": "شدند آن زمان رومیان زردروی"
  },
  {
    "poem_id": 1521,
    "vorder": 158,
    "position": 1,
    "text": "همه پاک با غلغل و گفت و گوی"
  },
  {
    "poem_id": 1521,
    "vorder": 159,
    "position": 0,
    "text": "کمان برگرفتند و تیر خدنگ"
  },
  {
    "poem_id": 1521,
    "vorder": 160,
    "position": 1,
    "text": "برفتند چندی سواران جنگ"
  },
  {
    "poem_id": 1521,
    "vorder": 161,
    "position": 0,
    "text": "چو آن دید گشتاسپ برخاست و گفت"
  },
  {
    "poem_id": 1521,
    "vorder": 162,
    "position": 1,
    "text": "که اکنون هنرها نشاید نهفت"
  },
  {
    "poem_id": 1521,
    "vorder": 163,
    "position": 0,
    "text": "بیفگند چوگان کمان برگرفت"
  },
  {
    "poem_id": 1521,
    "vorder": 164,
    "position": 1,
    "text": "زه و توز ازو دست بر سر گرفت"
  },
  {
    "poem_id": 1521,
    "vorder": 165,
    "position": 0,
    "text": "نگه کرد قیصر بران سرفراز"
  },
  {
    "poem_id": 1521,
    "vorder": 166,
    "position": 1,
    "text": "بدان چنگ و یال و رکیب دراز"
  },
  {
    "poem_id": 1521,
    "vorder": 167,
    "position": 0,
    "text": "بپرسید و گفت این سوار از کجاست"
  },
  {
    "poem_id": 1521,
    "vorder": 168,
    "position": 1,
    "text": "که چندین بپیچد چپ و دست راست"
  },
  {
    "poem_id": 1521,
    "vorder": 169,
    "position": 0,
    "text": "سرافراز گردان بسی دیده‌ام"
  },
  {
    "poem_id": 1521,
    "vorder": 170,
    "position": 1,
    "text": "سواری بدین گونه نشنیده‌ام"
  },
  {
    "poem_id": 1521,
    "vorder": 171,
    "position": 0,
    "text": "بخوانید تا زو بپرسم که کیست"
  },
  {
    "poem_id": 1521,
    "vorder": 172,
    "position": 1,
    "text": "فرشتست گر همچو ما آدمیست"
  },
  {
    "poem_id": 1521,
    "vorder": 173,
    "position": 0,
    "text": "بخواندند گشتاسپ را پیش اوی"
  },
  {
    "poem_id": 1521,
    "vorder": 174,
    "position": 1,
    "text": "بپیچید جان بداندیش اوی"
  },
  {
    "poem_id": 1521,
    "vorder": 175,
    "position": 0,
    "text": "به گشتاسپ گفت ای نبرده سوار"
  },
  {
    "poem_id": 1521,
    "vorder": 176,
    "position": 1,
    "text": "سر سرکشان افسر کارزار"
  },
  {
    "poem_id": 1521,
    "vorder": 177,
    "position": 0,
    "text": "چه نامی بمن گوی شهر و نژاد"
  },
  {
    "poem_id": 1521,
    "vorder": 178,
    "position": 1,
    "text": "ورا زین سخن هیچ پاسخ نداد"
  },
  {
    "poem_id": 1521,
    "vorder": 179,
    "position": 0,
    "text": "چنین گفت کان خوار بیگانه مرد"
  },
  {
    "poem_id": 1521,
    "vorder": 180,
    "position": 1,
    "text": "که از شهرقیصر ورا دور کرد"
  },
  {
    "poem_id": 1521,
    "vorder": 181,
    "position": 0,
    "text": "چو داماد گشتم ز شهرم براند"
  },
  {
    "poem_id": 1521,
    "vorder": 182,
    "position": 1,
    "text": "کس از دفترش نام من بر نخواند"
  },
  {
    "poem_id": 1521,
    "vorder": 183,
    "position": 0,
    "text": "ز قیصر ستم بر کتایون رسید"
  },
  {
    "poem_id": 1521,
    "vorder": 184,
    "position": 1,
    "text": "که مردی غریب از میان برگزید"
  },
  {
    "poem_id": 1521,
    "vorder": 185,
    "position": 0,
    "text": "نرفت اندرین جز به آیین شهر"
  },
  {
    "poem_id": 1521,
    "vorder": 186,
    "position": 1,
    "text": "ازان راستی خواری آمدش بهر"
  },
  {
    "poem_id": 1521,
    "vorder": 187,
    "position": 0,
    "text": "به بیشه درون آن زیانکار گرگ"
  },
  {
    "poem_id": 1521,
    "vorder": 188,
    "position": 1,
    "text": "به کوه بزرگ اژدهای سترگ"
  },
  {
    "poem_id": 1521,
    "vorder": 189,
    "position": 0,
    "text": "سرانشان به زخم من آمد به پای"
  },
  {
    "poem_id": 1521,
    "vorder": 190,
    "position": 1,
    "text": "بران کار هیشوی بد رهنمای"
  },
  {
    "poem_id": 1521,
    "vorder": 191,
    "position": 0,
    "text": "که دندانهاشان بخان منست"
  },
  {
    "poem_id": 1521,
    "vorder": 192,
    "position": 1,
    "text": "همان زخم خنجر نشان منست"
  },
  {
    "poem_id": 1521,
    "vorder": 193,
    "position": 0,
    "text": "ز هیشوی قیصر بپرسد سخن"
  },
  {
    "poem_id": 1521,
    "vorder": 194,
    "position": 1,
    "text": "نوست این نگشتست باری کهن"
  },
  {
    "poem_id": 1521,
    "vorder": 195,
    "position": 0,
    "text": "چو هیشوی شد پیش دندان ببرد"
  },
  {
    "poem_id": 1521,
    "vorder": 196,
    "position": 1,
    "text": "گذشته سخنها برو بر شمرد"
  },
  {
    "poem_id": 1521,
    "vorder": 197,
    "position": 0,
    "text": "به پوزش بیاراست قیصر زبان"
  },
  {
    "poem_id": 1521,
    "vorder": 198,
    "position": 1,
    "text": "بدو گفت بیداد رفت ای جوان"
  },
  {
    "poem_id": 1521,
    "vorder": 199,
    "position": 0,
    "text": "کنون آن گرامی کتایون کجاست"
  },
  {
    "poem_id": 1521,
    "vorder": 200,
    "position": 1,
    "text": "مرا گر ستمگاره خواند رواست"
  },
  {
    "poem_id": 1521,
    "vorder": 201,
    "position": 0,
    "text": "ز میرین و اهرن برآشفت و گفت"
  },
  {
    "poem_id": 1521,
    "vorder": 202,
    "position": 1,
    "text": "که هرگز نماند سخن در نهفت"
  },
  {
    "poem_id": 1521,
    "vorder": 203,
    "position": 0,
    "text": "همانگه نشست از بر بادپای"
  },
  {
    "poem_id": 1521,
    "vorder": 204,
    "position": 1,
    "text": "به پوزش بیامد بر پاک رای"
  },
  {
    "poem_id": 1521,
    "vorder": 205,
    "position": 0,
    "text": "بسی آفرین کرد فرزند را"
  },
  {
    "poem_id": 1521,
    "vorder": 206,
    "position": 1,
    "text": "مران پاک دامن خردمند را"
  },
  {
    "poem_id": 1521,
    "vorder": 207,
    "position": 0,
    "text": "بدو گفت قیصر که ای ماهروی"
  },
  {
    "poem_id": 1521,
    "vorder": 208,
    "position": 1,
    "text": "گزیدی تو اندر خور خویش شوی"
  },
  {
    "poem_id": 1521,
    "vorder": 209,
    "position": 0,
    "text": "همه دوده را سر برافراختی"
  },
  {
    "poem_id": 1521,
    "vorder": 210,
    "position": 1,
    "text": "برین نیکبختی که تو ساختی"
  },
  {
    "poem_id": 1521,
    "vorder": 211,
    "position": 0,
    "text": "به پرسش بدو گفت ز انباز خویش"
  },
  {
    "poem_id": 1521,
    "vorder": 212,
    "position": 1,
    "text": "مگر بر تو پیدا کند راز خویش"
  },
  {
    "poem_id": 1521,
    "vorder": 213,
    "position": 0,
    "text": "که آرام و شهر و نژادش کجاست"
  },
  {
    "poem_id": 1521,
    "vorder": 214,
    "position": 1,
    "text": "بگوید مگر مر ترا گفت راست"
  },
  {
    "poem_id": 1521,
    "vorder": 215,
    "position": 0,
    "text": "چنین داد پاسخ که پرسیدمش"
  },
  {
    "poem_id": 1521,
    "vorder": 216,
    "position": 1,
    "text": "نه بر دامن راستی دیدمش"
  },
  {
    "poem_id": 1521,
    "vorder": 217,
    "position": 0,
    "text": "نگوید همی پیش من راز خویش"
  },
  {
    "poem_id": 1521,
    "vorder": 218,
    "position": 1,
    "text": "نهان دارد از هرکس آواز خویش"
  },
  {
    "poem_id": 1521,
    "vorder": 219,
    "position": 0,
    "text": "گمانم که هست از نژاد بزرگ"
  },
  {
    "poem_id": 1521,
    "vorder": 220,
    "position": 1,
    "text": "که پرخاش جویست و گرد و سترگ"
  },
  {
    "poem_id": 1521,
    "vorder": 221,
    "position": 0,
    "text": "ز هرچش بپرسم نگوید تمام"
  },
  {
    "poem_id": 1521,
    "vorder": 222,
    "position": 1,
    "text": "فرخ‌زاد گوید که هستم به نام"
  },
  {
    "poem_id": 1521,
    "vorder": 223,
    "position": 0,
    "text": "وزان جایگه سوی ایوان گذشت"
  },
  {
    "poem_id": 1521,
    "vorder": 224,
    "position": 1,
    "text": "سپهر اندرین نیز چندی بگشت"
  },
  {
    "poem_id": 1521,
    "vorder": 225,
    "position": 0,
    "text": "چو گشتاسپ برخاست از بامداد"
  },
  {
    "poem_id": 1521,
    "vorder": 226,
    "position": 1,
    "text": "سر پرخرد سوی قیصر نهاد"
  },
  {
    "poem_id": 1521,
    "vorder": 227,
    "position": 0,
    "text": "چو قیصر ورا دید خامش بماند"
  },
  {
    "poem_id": 1521,
    "vorder": 228,
    "position": 1,
    "text": "بران نامور پیشگاهش نشاند"
  },
  {
    "poem_id": 1521,
    "vorder": 229,
    "position": 0,
    "text": "کمر خواست از گنج و انگشتری"
  },
  {
    "poem_id": 1521,
    "vorder": 230,
    "position": 1,
    "text": "یکی نامور افسری مهتری"
  },
  {
    "poem_id": 1521,
    "vorder": 231,
    "position": 0,
    "text": "ببوسید و پس بر سر او نهاد"
  },
  {
    "poem_id": 1521,
    "vorder": 232,
    "position": 1,
    "text": "ز کار گذشته بسی کرد یاد"
  },
  {
    "poem_id": 1521,
    "vorder": 233,
    "position": 0,
    "text": "چنین گفت با هرک بد یادگیر"
  },
  {
    "poem_id": 1521,
    "vorder": 234,
    "position": 1,
    "text": "که بیدار باشید برنا و پیر"
  },
  {
    "poem_id": 1521,
    "vorder": 235,
    "position": 0,
    "text": "فرخ‌زاد را جمله فرمان برید"
  },
  {
    "poem_id": 1521,
    "vorder": 236,
    "position": 1,
    "text": "ز گفتار و کردار او مگذرید"
  },
  {
    "poem_id": 1521,
    "vorder": 237,
    "position": 0,
    "text": "ازان آگهی شد به هر کشوری"
  },
  {
    "poem_id": 1521,
    "vorder": 238,
    "position": 1,
    "text": "به هر پادشاهی و هر مهتری"
  }
]