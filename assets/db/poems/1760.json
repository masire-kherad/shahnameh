[
  {
    "poem_id": 1760,
    "vorder": 1,
    "position": 0,
    "text": "وزان پس غم و شادی یزدگرد"
  },
  {
    "poem_id": 1760,
    "vorder": 2,
    "position": 1,
    "text": "چنان گشت بر پور چون باد ارد"
  },
  {
    "poem_id": 1760,
    "vorder": 3,
    "position": 0,
    "text": "برین نیز چندی زمان برگذشت"
  },
  {
    "poem_id": 1760,
    "vorder": 4,
    "position": 1,
    "text": "به ایران پدر پور فرخ به دشت"
  },
  {
    "poem_id": 1760,
    "vorder": 5,
    "position": 0,
    "text": "ز شاهی پراندیشه شد یزدگرد"
  },
  {
    "poem_id": 1760,
    "vorder": 6,
    "position": 1,
    "text": "ز هر کشوری موبدان کرد گرد"
  },
  {
    "poem_id": 1760,
    "vorder": 7,
    "position": 0,
    "text": "به اخترشناسان بفرمود شاه"
  },
  {
    "poem_id": 1760,
    "vorder": 8,
    "position": 1,
    "text": "که تا کردهر یک به اختر نگاه"
  },
  {
    "poem_id": 1760,
    "vorder": 9,
    "position": 0,
    "text": "که تا کی بود در جهان مرگ اوی"
  },
  {
    "poem_id": 1760,
    "vorder": 10,
    "position": 1,
    "text": "کجا تیره گردد سر و ترگ اوی"
  },
  {
    "poem_id": 1760,
    "vorder": 11,
    "position": 0,
    "text": "چه باشد کجا باشد آن روزگار"
  },
  {
    "poem_id": 1760,
    "vorder": 12,
    "position": 1,
    "text": "که پژمرده گردد گل شهریار"
  },
  {
    "poem_id": 1760,
    "vorder": 13,
    "position": 0,
    "text": "ستاره‌شمر گفت کاین خود مباد"
  },
  {
    "poem_id": 1760,
    "vorder": 14,
    "position": 1,
    "text": "که شاه جهان گیرد از مرگ یاد"
  },
  {
    "poem_id": 1760,
    "vorder": 15,
    "position": 0,
    "text": "چو بخت شهنشاه بدرو شود"
  },
  {
    "poem_id": 1760,
    "vorder": 16,
    "position": 1,
    "text": "از ایدر سوی چشمهٔ سو شود"
  },
  {
    "poem_id": 1760,
    "vorder": 17,
    "position": 0,
    "text": "فراز آورد لشکر و بوق و کوس"
  },
  {
    "poem_id": 1760,
    "vorder": 18,
    "position": 1,
    "text": "به شادی نظاره شود سوی طوس"
  },
  {
    "poem_id": 1760,
    "vorder": 19,
    "position": 0,
    "text": "بر آن جایگه بر بود هوش اوی"
  },
  {
    "poem_id": 1760,
    "vorder": 20,
    "position": 1,
    "text": "چو این راز بگذشت بر گوش اوی"
  },
  {
    "poem_id": 1760,
    "vorder": 21,
    "position": 0,
    "text": "ازین دانش ار یادگیری به دست"
  },
  {
    "poem_id": 1760,
    "vorder": 22,
    "position": 1,
    "text": "که این راز در پردهٔ ایزدست"
  },
  {
    "poem_id": 1760,
    "vorder": 23,
    "position": 0,
    "text": "چو بشنید زو شاه سوگند خورد"
  },
  {
    "poem_id": 1760,
    "vorder": 24,
    "position": 1,
    "text": "به خراد برزین و خورشید زرد"
  },
  {
    "poem_id": 1760,
    "vorder": 25,
    "position": 0,
    "text": "که من چشمهٔ سو نبینم به چشم"
  },
  {
    "poem_id": 1760,
    "vorder": 26,
    "position": 1,
    "text": "نه هنگام شادی نه هنگام خشم"
  },
  {
    "poem_id": 1760,
    "vorder": 27,
    "position": 0,
    "text": "برین نیز برگشت گردون سه ماه"
  },
  {
    "poem_id": 1760,
    "vorder": 28,
    "position": 1,
    "text": "زمانه به جوش آمد از خون شاه"
  },
  {
    "poem_id": 1760,
    "vorder": 29,
    "position": 0,
    "text": "چو بیدادگر شد شبان با رمه"
  },
  {
    "poem_id": 1760,
    "vorder": 30,
    "position": 1,
    "text": "بدو بازگردد بدیها همه"
  },
  {
    "poem_id": 1760,
    "vorder": 31,
    "position": 0,
    "text": "ز بینیش بگشاد یک روز خون"
  },
  {
    "poem_id": 1760,
    "vorder": 32,
    "position": 1,
    "text": "پزشک آمد از هر سوی رهنمون"
  },
  {
    "poem_id": 1760,
    "vorder": 33,
    "position": 0,
    "text": "به دارو چو یک هفته بستی پزشک"
  },
  {
    "poem_id": 1760,
    "vorder": 34,
    "position": 1,
    "text": "دگر هفته خون آمدی چون سرشک"
  }
]