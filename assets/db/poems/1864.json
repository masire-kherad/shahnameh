[
  {
    "poem_id": 1864,
    "vorder": 1,
    "position": 0,
    "text": "چوآمد به بهرام زین آگهی"
  },
  {
    "poem_id": 1864,
    "vorder": 2,
    "position": 1,
    "text": "که تازه شد آن فر شاهنشهی"
  },
  {
    "poem_id": 1864,
    "vorder": 3,
    "position": 0,
    "text": "همانگه ز لشکر یکی نامجوی"
  },
  {
    "poem_id": 1864,
    "vorder": 4,
    "position": 1,
    "text": "نگه کرد با دانش و آب روی"
  },
  {
    "poem_id": 1864,
    "vorder": 5,
    "position": 0,
    "text": "کجا نام او بود داناپناه"
  },
  {
    "poem_id": 1864,
    "vorder": 6,
    "position": 1,
    "text": "که بهرام را او بدی نیک خواه"
  },
  {
    "poem_id": 1864,
    "vorder": 7,
    "position": 0,
    "text": "دبیر سرافراز را پیش خواند"
  },
  {
    "poem_id": 1864,
    "vorder": 8,
    "position": 1,
    "text": "سخنهای بایسته چندی براند"
  },
  {
    "poem_id": 1864,
    "vorder": 9,
    "position": 0,
    "text": "بفرمود تا نامه‌های بزرگ"
  },
  {
    "poem_id": 1864,
    "vorder": 10,
    "position": 1,
    "text": "نویسد بران مهتران سترگ"
  },
  {
    "poem_id": 1864,
    "vorder": 11,
    "position": 0,
    "text": "بگستهم و گردوی و بندوی گرد"
  },
  {
    "poem_id": 1864,
    "vorder": 12,
    "position": 1,
    "text": "که از مهتران نام گردی ببرد"
  },
  {
    "poem_id": 1864,
    "vorder": 13,
    "position": 0,
    "text": "چو شاپور و چون اندیان سوار"
  },
  {
    "poem_id": 1864,
    "vorder": 14,
    "position": 1,
    "text": "هرآنکس که بود از یلان نامدار"
  },
  {
    "poem_id": 1864,
    "vorder": 15,
    "position": 0,
    "text": "سرنامه گفت از جهان آفرین"
  },
  {
    "poem_id": 1864,
    "vorder": 16,
    "position": 1,
    "text": "همی‌خواهم اندر نهان آفرین"
  },
  {
    "poem_id": 1864,
    "vorder": 17,
    "position": 0,
    "text": "چوبیدار گردید یکسر ز خواب"
  },
  {
    "poem_id": 1864,
    "vorder": 18,
    "position": 1,
    "text": "نگیرید بر بد ازین سان شتاب"
  },
  {
    "poem_id": 1864,
    "vorder": 19,
    "position": 0,
    "text": "که تا درجهان تخم ساسانیان"
  },
  {
    "poem_id": 1864,
    "vorder": 20,
    "position": 1,
    "text": "پدید آمد اندر کنار و میان"
  },
  {
    "poem_id": 1864,
    "vorder": 21,
    "position": 0,
    "text": "ازیشان نرفتست جزبرتری"
  },
  {
    "poem_id": 1864,
    "vorder": 22,
    "position": 1,
    "text": "بگرد جهان گشتن و داوری"
  },
  {
    "poem_id": 1864,
    "vorder": 23,
    "position": 0,
    "text": "نخست از سر بابکان اردشیر"
  },
  {
    "poem_id": 1864,
    "vorder": 24,
    "position": 1,
    "text": "که اندر جهان تازه شد داروگیر"
  },
  {
    "poem_id": 1864,
    "vorder": 25,
    "position": 0,
    "text": "زمانه ز شمشیر او تیره گشت"
  },
  {
    "poem_id": 1864,
    "vorder": 26,
    "position": 1,
    "text": "سر نامداران همه خیره گشت"
  },
  {
    "poem_id": 1864,
    "vorder": 27,
    "position": 0,
    "text": "نخستین سخن گویم از اردوان"
  },
  {
    "poem_id": 1864,
    "vorder": 28,
    "position": 1,
    "text": "ازان نامداران روشن روان"
  },
  {
    "poem_id": 1864,
    "vorder": 29,
    "position": 0,
    "text": "شنیدی که بر نامور سوفزای"
  },
  {
    "poem_id": 1864,
    "vorder": 30,
    "position": 1,
    "text": "چه آمد ز پیروز ناپاک رای"
  },
  {
    "poem_id": 1864,
    "vorder": 31,
    "position": 0,
    "text": "رها کردن ازبند پای قباد"
  },
  {
    "poem_id": 1864,
    "vorder": 32,
    "position": 1,
    "text": "وزان مهتران دادن او را بباد"
  },
  {
    "poem_id": 1864,
    "vorder": 33,
    "position": 0,
    "text": "قباد بد اندیش نیرو گرفت"
  },
  {
    "poem_id": 1864,
    "vorder": 34,
    "position": 1,
    "text": "هنرها بشست از دل آهو گرفت"
  },
  {
    "poem_id": 1864,
    "vorder": 35,
    "position": 0,
    "text": "چنان نامور نیک دل را بکشت"
  },
  {
    "poem_id": 1864,
    "vorder": 36,
    "position": 1,
    "text": "برو شد دل نامداران درشت"
  },
  {
    "poem_id": 1864,
    "vorder": 37,
    "position": 0,
    "text": "کسی کو نشاید به پیوند خویش"
  },
  {
    "poem_id": 1864,
    "vorder": 38,
    "position": 1,
    "text": "هوا بر گزیند ز فرزند خویش"
  },
  {
    "poem_id": 1864,
    "vorder": 39,
    "position": 0,
    "text": "به بیگانگان هم نشاید بنیز"
  },
  {
    "poem_id": 1864,
    "vorder": 40,
    "position": 1,
    "text": "نجوید کسی عاج از چوب شیز"
  },
  {
    "poem_id": 1864,
    "vorder": 41,
    "position": 0,
    "text": "بساسانیان تا ندارید امید"
  },
  {
    "poem_id": 1864,
    "vorder": 42,
    "position": 1,
    "text": "مجویید یاقوت از سرخ بید"
  },
  {
    "poem_id": 1864,
    "vorder": 43,
    "position": 0,
    "text": "چواین نامه آرند نزد شما"
  },
  {
    "poem_id": 1864,
    "vorder": 44,
    "position": 1,
    "text": "که فرخنده باد اورمزد شما"
  },
  {
    "poem_id": 1864,
    "vorder": 45,
    "position": 0,
    "text": "به نزدیک من جایتان روشنست"
  },
  {
    "poem_id": 1864,
    "vorder": 46,
    "position": 1,
    "text": "برو آستی هم ز پیراهنست"
  },
  {
    "poem_id": 1864,
    "vorder": 47,
    "position": 0,
    "text": "بیک جای مان بود آرام و خواب"
  },
  {
    "poem_id": 1864,
    "vorder": 48,
    "position": 1,
    "text": "اگر تیره بد گر بلند آفتاب"
  },
  {
    "poem_id": 1864,
    "vorder": 49,
    "position": 0,
    "text": "چو آیید یکسر به نزدیک من"
  },
  {
    "poem_id": 1864,
    "vorder": 50,
    "position": 1,
    "text": "شود روشن این جان تاریک من"
  },
  {
    "poem_id": 1864,
    "vorder": 51,
    "position": 0,
    "text": "نیندیشم از روم وز شاهشان"
  },
  {
    "poem_id": 1864,
    "vorder": 52,
    "position": 1,
    "text": "بپای اندر آرم سر و گاهشان"
  },
  {
    "poem_id": 1864,
    "vorder": 53,
    "position": 0,
    "text": "نهادند برنامه‌ها مهر اوی"
  },
  {
    "poem_id": 1864,
    "vorder": 54,
    "position": 1,
    "text": "بیامد فرستاده راه جوی"
  },
  {
    "poem_id": 1864,
    "vorder": 55,
    "position": 0,
    "text": "بکردار بازارگانان برفت"
  },
  {
    "poem_id": 1864,
    "vorder": 56,
    "position": 1,
    "text": "بدرگاه خسرو خرامید تفت"
  },
  {
    "poem_id": 1864,
    "vorder": 57,
    "position": 0,
    "text": "یکی کاروانی ز هرگونه چیز"
  },
  {
    "poem_id": 1864,
    "vorder": 58,
    "position": 1,
    "text": "ابا نامه‌ها هدیه‌ها داشت نیز"
  },
  {
    "poem_id": 1864,
    "vorder": 59,
    "position": 0,
    "text": "بدید آن بزرگی و چندان سپاه"
  },
  {
    "poem_id": 1864,
    "vorder": 60,
    "position": 1,
    "text": "که گفتی مگر بر زمین نیست راه"
  },
  {
    "poem_id": 1864,
    "vorder": 61,
    "position": 0,
    "text": "به دل گفت با این چنین شهریار"
  },
  {
    "poem_id": 1864,
    "vorder": 62,
    "position": 1,
    "text": "نخواهد ز بهرام یل زینهار"
  },
  {
    "poem_id": 1864,
    "vorder": 63,
    "position": 0,
    "text": "یکی مرد بی‌دشمنم پارسی"
  },
  {
    "poem_id": 1864,
    "vorder": 64,
    "position": 1,
    "text": "همان بار دارم شتروار سی"
  },
  {
    "poem_id": 1864,
    "vorder": 65,
    "position": 0,
    "text": "چراخویشتن کرد باید هلاک"
  },
  {
    "poem_id": 1864,
    "vorder": 66,
    "position": 1,
    "text": "بلندی پدیدار گشت ازمغاک"
  },
  {
    "poem_id": 1864,
    "vorder": 67,
    "position": 0,
    "text": "شوم نامه نزدیک خسروبرم"
  },
  {
    "poem_id": 1864,
    "vorder": 68,
    "position": 1,
    "text": "به نزدیک او هدیهٔ نوبرم"
  },
  {
    "poem_id": 1864,
    "vorder": 69,
    "position": 0,
    "text": "باندیشه آمد به نزدیک شاه"
  },
  {
    "poem_id": 1864,
    "vorder": 70,
    "position": 1,
    "text": "ابا هدیه و نامه ونیک خواه"
  },
  {
    "poem_id": 1864,
    "vorder": 71,
    "position": 0,
    "text": "درم برد و با نامه‌ها هدیه برد"
  },
  {
    "poem_id": 1864,
    "vorder": 72,
    "position": 1,
    "text": "سخنهاش برشاه گیتی شمرد"
  },
  {
    "poem_id": 1864,
    "vorder": 73,
    "position": 0,
    "text": "جهاندار چون نامه‌ها را بخواند"
  },
  {
    "poem_id": 1864,
    "vorder": 74,
    "position": 1,
    "text": "مر او را بکرسی زرین نشاند"
  },
  {
    "poem_id": 1864,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت کای مرد بسیاردان"
  },
  {
    "poem_id": 1864,
    "vorder": 76,
    "position": 1,
    "text": "تو بهرام را نزد من خوار دان"
  },
  {
    "poem_id": 1864,
    "vorder": 77,
    "position": 0,
    "text": "کنون ز آنچ کردی رسیدی بکام"
  },
  {
    "poem_id": 1864,
    "vorder": 78,
    "position": 1,
    "text": "فزون‌تر مجو اندرین کار نام"
  },
  {
    "poem_id": 1864,
    "vorder": 79,
    "position": 0,
    "text": "بفرمود تا نزد او شد دبیر"
  },
  {
    "poem_id": 1864,
    "vorder": 80,
    "position": 1,
    "text": "مران پاسخ نامه را ناگزیر"
  },
  {
    "poem_id": 1864,
    "vorder": 81,
    "position": 0,
    "text": "نوشت اندران نامه‌های دراز"
  },
  {
    "poem_id": 1864,
    "vorder": 82,
    "position": 1,
    "text": "که این مهتر گرد گردن فراز"
  },
  {
    "poem_id": 1864,
    "vorder": 83,
    "position": 0,
    "text": "همه نامه‌های تو برخواندیم"
  },
  {
    "poem_id": 1864,
    "vorder": 84,
    "position": 1,
    "text": "فرستاده را پیش بنشاندیم"
  },
  {
    "poem_id": 1864,
    "vorder": 85,
    "position": 0,
    "text": "به گفتار بیکار با خسرویم"
  },
  {
    "poem_id": 1864,
    "vorder": 86,
    "position": 1,
    "text": "به دل با تو همچون بهار نویم"
  },
  {
    "poem_id": 1864,
    "vorder": 87,
    "position": 0,
    "text": "چولشکر بیاری بدین مرز وبوم"
  },
  {
    "poem_id": 1864,
    "vorder": 88,
    "position": 1,
    "text": "که اندیشد از گرز مردان روم"
  },
  {
    "poem_id": 1864,
    "vorder": 89,
    "position": 0,
    "text": "همه پاک شمشیرها برکشیم"
  },
  {
    "poem_id": 1864,
    "vorder": 90,
    "position": 1,
    "text": "به جنگ اندورن رومیان را کشیم"
  },
  {
    "poem_id": 1864,
    "vorder": 91,
    "position": 0,
    "text": "چو خسرو ببیند سپاه تو را"
  },
  {
    "poem_id": 1864,
    "vorder": 92,
    "position": 1,
    "text": "همان مردی و پایگاه تو را"
  },
  {
    "poem_id": 1864,
    "vorder": 93,
    "position": 0,
    "text": "دلش زود بیکار ولرزان شود"
  },
  {
    "poem_id": 1864,
    "vorder": 94,
    "position": 1,
    "text": "زپیشت چو روبه گریزان شود"
  },
  {
    "poem_id": 1864,
    "vorder": 95,
    "position": 0,
    "text": "بدان نامه‌ها مهر بنهاد شاه"
  },
  {
    "poem_id": 1864,
    "vorder": 96,
    "position": 1,
    "text": "ببرد ان پسندیدهٔ نیک خواه"
  },
  {
    "poem_id": 1864,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت شاه ای خردمند مرد"
  },
  {
    "poem_id": 1864,
    "vorder": 98,
    "position": 1,
    "text": "برش گنج یابی ازین کارکرد"
  },
  {
    "poem_id": 1864,
    "vorder": 99,
    "position": 0,
    "text": "مرو را گهر داد و دینار داد"
  },
  {
    "poem_id": 1864,
    "vorder": 100,
    "position": 1,
    "text": "گرانمایه یاقوت بسیار داد"
  },
  {
    "poem_id": 1864,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت کاین نزد چوبینه بر"
  },
  {
    "poem_id": 1864,
    "vorder": 102,
    "position": 1,
    "text": "شنیده سخنها برو بر شمر"
  }
]