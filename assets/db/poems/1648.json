[
  {
    "poem_id": 1648,
    "vorder": 1,
    "position": 0,
    "text": "فرستاده آمد به کردار باد"
  },
  {
    "poem_id": 1648,
    "vorder": 2,
    "position": 1,
    "text": "بگفت آنچ بشنید و نامه بداد"
  },
  {
    "poem_id": 1648,
    "vorder": 3,
    "position": 0,
    "text": "سکندر فرستاده از گفت رو"
  },
  {
    "poem_id": 1648,
    "vorder": 4,
    "position": 1,
    "text": "به نزدیک آن نامور بازشو"
  },
  {
    "poem_id": 1648,
    "vorder": 5,
    "position": 0,
    "text": "بگویش که آن چیست کاندر جهان"
  },
  {
    "poem_id": 1648,
    "vorder": 6,
    "position": 1,
    "text": "کسی را نبود آشکار و نهان"
  },
  {
    "poem_id": 1648,
    "vorder": 7,
    "position": 0,
    "text": "بدیدند خود بودنی هرچ بود"
  },
  {
    "poem_id": 1648,
    "vorder": 8,
    "position": 1,
    "text": "سپهر آفرینش نخواهد فزود"
  },
  {
    "poem_id": 1648,
    "vorder": 9,
    "position": 0,
    "text": "بیامد فرستاده را نزد شاه"
  },
  {
    "poem_id": 1648,
    "vorder": 10,
    "position": 1,
    "text": "به کردار آتش بپیمود راه"
  },
  {
    "poem_id": 1648,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت با کید کاین چار چیز"
  },
  {
    "poem_id": 1648,
    "vorder": 12,
    "position": 1,
    "text": "که کس را به گیتی نبودست نیز"
  },
  {
    "poem_id": 1648,
    "vorder": 13,
    "position": 0,
    "text": "همی شاه خواهد که داند که چیست"
  },
  {
    "poem_id": 1648,
    "vorder": 14,
    "position": 1,
    "text": "که نادیدنی پاک نابود نیست"
  },
  {
    "poem_id": 1648,
    "vorder": 15,
    "position": 0,
    "text": "چو بشنید کید آن ز بیگانه جای"
  },
  {
    "poem_id": 1648,
    "vorder": 16,
    "position": 1,
    "text": "بپردخت و بنشست با رهنمای"
  },
  {
    "poem_id": 1648,
    "vorder": 17,
    "position": 0,
    "text": "فرستاده را پیش بنشاختند"
  },
  {
    "poem_id": 1648,
    "vorder": 18,
    "position": 1,
    "text": "ز هر در فراوانش بنواختند"
  },
  {
    "poem_id": 1648,
    "vorder": 19,
    "position": 0,
    "text": "ازان پس فرستاده را شاه گفت"
  },
  {
    "poem_id": 1648,
    "vorder": 20,
    "position": 1,
    "text": "که من دختری دارم اندر نهفت"
  },
  {
    "poem_id": 1648,
    "vorder": 21,
    "position": 0,
    "text": "که گر بیندش آفتاب بلند"
  },
  {
    "poem_id": 1648,
    "vorder": 22,
    "position": 1,
    "text": "شود تیره از روی آن ارجمند"
  },
  {
    "poem_id": 1648,
    "vorder": 23,
    "position": 0,
    "text": "کمندست گیسوش همرنگ قیر"
  },
  {
    "poem_id": 1648,
    "vorder": 24,
    "position": 1,
    "text": "همی آید از دو لبش بوی شیر"
  },
  {
    "poem_id": 1648,
    "vorder": 25,
    "position": 0,
    "text": "خم آرد ز بالای او سرو بن"
  },
  {
    "poem_id": 1648,
    "vorder": 26,
    "position": 1,
    "text": "گلفشان شود چو سراید سخن"
  },
  {
    "poem_id": 1648,
    "vorder": 27,
    "position": 0,
    "text": "ز دیدار و چهرش سخن بگذرد"
  },
  {
    "poem_id": 1648,
    "vorder": 28,
    "position": 1,
    "text": "همی داستان را خرد پرورد"
  },
  {
    "poem_id": 1648,
    "vorder": 29,
    "position": 0,
    "text": "چو خامش بود جان شرمست و بس"
  },
  {
    "poem_id": 1648,
    "vorder": 30,
    "position": 1,
    "text": "چنو در زمانه ندیدست کس"
  },
  {
    "poem_id": 1648,
    "vorder": 31,
    "position": 0,
    "text": "سپهبد نژادست و یزدان‌پرست"
  },
  {
    "poem_id": 1648,
    "vorder": 32,
    "position": 1,
    "text": "دل شرم و پرهیز دارد به دست"
  },
  {
    "poem_id": 1648,
    "vorder": 33,
    "position": 0,
    "text": "دگر جام دارم که پر می‌کنی"
  },
  {
    "poem_id": 1648,
    "vorder": 34,
    "position": 1,
    "text": "وگر آب سر اندرو افگنی"
  },
  {
    "poem_id": 1648,
    "vorder": 35,
    "position": 0,
    "text": "به ده سال اگر با ندیمان به هم"
  },
  {
    "poem_id": 1648,
    "vorder": 36,
    "position": 1,
    "text": "نشیند نگردد می از جام کم"
  },
  {
    "poem_id": 1648,
    "vorder": 37,
    "position": 0,
    "text": "همت می دهد جام هم آب سرد"
  },
  {
    "poem_id": 1648,
    "vorder": 38,
    "position": 1,
    "text": "شگفت آنک کمی نگیرد ز خورد"
  },
  {
    "poem_id": 1648,
    "vorder": 39,
    "position": 0,
    "text": "سوم آنک دارم یکی نو پزشک"
  },
  {
    "poem_id": 1648,
    "vorder": 40,
    "position": 1,
    "text": "که علت بگوید چو بیند سرشک"
  },
  {
    "poem_id": 1648,
    "vorder": 41,
    "position": 0,
    "text": "اگر باشد او سالیان پیش گاه"
  },
  {
    "poem_id": 1648,
    "vorder": 42,
    "position": 1,
    "text": "ز دردی نپیچد جهاندار شاه"
  },
  {
    "poem_id": 1648,
    "vorder": 43,
    "position": 0,
    "text": "چهارم نهان دارم از انجمن"
  },
  {
    "poem_id": 1648,
    "vorder": 44,
    "position": 1,
    "text": "یکی فیلسوفست نزدیک من"
  },
  {
    "poem_id": 1648,
    "vorder": 45,
    "position": 0,
    "text": "همه بودنیها بگوید به شاه"
  },
  {
    "poem_id": 1648,
    "vorder": 46,
    "position": 1,
    "text": "ز گردنده خورشید و رخشنده ماه"
  },
  {
    "poem_id": 1648,
    "vorder": 47,
    "position": 0,
    "text": "فرستادهٔ نامور بازگشت"
  },
  {
    "poem_id": 1648,
    "vorder": 48,
    "position": 1,
    "text": "پی باره با باد انباز گشت"
  },
  {
    "poem_id": 1648,
    "vorder": 49,
    "position": 0,
    "text": "بیامد چو پیش سکندر بگفت"
  },
  {
    "poem_id": 1648,
    "vorder": 50,
    "position": 1,
    "text": "دل شاه گیتی چو گل بر شگفت"
  },
  {
    "poem_id": 1648,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت اگر باشد این گفته راست"
  },
  {
    "poem_id": 1648,
    "vorder": 52,
    "position": 1,
    "text": "بدین چار چیز او جهان را بهاست"
  },
  {
    "poem_id": 1648,
    "vorder": 53,
    "position": 0,
    "text": "چو اینها فرستد به نزدیک من"
  },
  {
    "poem_id": 1648,
    "vorder": 54,
    "position": 1,
    "text": "درخشان شود جان تاریک من"
  },
  {
    "poem_id": 1648,
    "vorder": 55,
    "position": 0,
    "text": "بر و بوم او را نکوبم به پای"
  },
  {
    "poem_id": 1648,
    "vorder": 56,
    "position": 1,
    "text": "برین نیکویی باز گردم به جای"
  }
]