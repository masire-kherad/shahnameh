[
  {
    "poem_id": 1617,
    "vorder": 1,
    "position": 0,
    "text": "گرامی پشوتن که دستور بود"
  },
  {
    "poem_id": 1617,
    "vorder": 2,
    "position": 1,
    "text": "ز کشتن دلش سخت رنجور بود"
  },
  {
    "poem_id": 1617,
    "vorder": 3,
    "position": 0,
    "text": "به پیش جهاندار بر پای خاست"
  },
  {
    "poem_id": 1617,
    "vorder": 4,
    "position": 1,
    "text": "چنین گفت کای خسرو داد و راست"
  },
  {
    "poem_id": 1617,
    "vorder": 5,
    "position": 0,
    "text": "اگر کینه بودت به دل خواستی"
  },
  {
    "poem_id": 1617,
    "vorder": 6,
    "position": 1,
    "text": "پدید آمد از کاستی راستی"
  },
  {
    "poem_id": 1617,
    "vorder": 7,
    "position": 0,
    "text": "کنون غارت و کشتن و جنگ و جوش"
  },
  {
    "poem_id": 1617,
    "vorder": 8,
    "position": 1,
    "text": "مفرمای و مپسند چندین خروش"
  },
  {
    "poem_id": 1617,
    "vorder": 9,
    "position": 0,
    "text": "ز یزدان بترس و ز ما شرم‌دار"
  },
  {
    "poem_id": 1617,
    "vorder": 10,
    "position": 1,
    "text": "نگه کن بدین گردش روزگار"
  },
  {
    "poem_id": 1617,
    "vorder": 11,
    "position": 0,
    "text": "یکی را برآرد به ابر بلند"
  },
  {
    "poem_id": 1617,
    "vorder": 12,
    "position": 1,
    "text": "یکی زو شود زار و خوار و نژند"
  },
  {
    "poem_id": 1617,
    "vorder": 13,
    "position": 0,
    "text": "پدرت آن جهانگیر لشکر فروز"
  },
  {
    "poem_id": 1617,
    "vorder": 14,
    "position": 1,
    "text": "نه تابوت را شد سوی نیمروز"
  },
  {
    "poem_id": 1617,
    "vorder": 15,
    "position": 0,
    "text": "نه رستم به کابل به نخچیرگاه"
  },
  {
    "poem_id": 1617,
    "vorder": 16,
    "position": 1,
    "text": "بدان شد که تا نیست گردد به چاه"
  },
  {
    "poem_id": 1617,
    "vorder": 17,
    "position": 0,
    "text": "تو تا باشی ای خسرو پاک و راد"
  },
  {
    "poem_id": 1617,
    "vorder": 18,
    "position": 1,
    "text": "مرنجان کسی را که دارد نژاد"
  },
  {
    "poem_id": 1617,
    "vorder": 19,
    "position": 0,
    "text": "چو فرزند سام نریمان ز بند"
  },
  {
    "poem_id": 1617,
    "vorder": 20,
    "position": 1,
    "text": "بنالد به پروردگار بلند"
  },
  {
    "poem_id": 1617,
    "vorder": 21,
    "position": 0,
    "text": "بپیچی ازان گرچه نیک‌اختری"
  },
  {
    "poem_id": 1617,
    "vorder": 22,
    "position": 1,
    "text": "چو با کردگار افگند داوری"
  },
  {
    "poem_id": 1617,
    "vorder": 23,
    "position": 0,
    "text": "چو رستم نگهدار تخت کیان"
  },
  {
    "poem_id": 1617,
    "vorder": 24,
    "position": 1,
    "text": "همی بر در رنج بستی میان"
  },
  {
    "poem_id": 1617,
    "vorder": 25,
    "position": 0,
    "text": "تو این تاج ازو یافتی یادگار"
  },
  {
    "poem_id": 1617,
    "vorder": 26,
    "position": 1,
    "text": "نه از راه گشتاسپ و اسفندیار"
  },
  {
    "poem_id": 1617,
    "vorder": 27,
    "position": 0,
    "text": "ز هنگامهٔ کی قباد اندرآی"
  },
  {
    "poem_id": 1617,
    "vorder": 28,
    "position": 1,
    "text": "چنین تا به کیخسرو پاک‌رای"
  },
  {
    "poem_id": 1617,
    "vorder": 29,
    "position": 0,
    "text": "بزرگی به شمشیر او داشتند"
  },
  {
    "poem_id": 1617,
    "vorder": 30,
    "position": 1,
    "text": "مهان را همه زیر او داشتند"
  },
  {
    "poem_id": 1617,
    "vorder": 31,
    "position": 0,
    "text": "ازو بند بردار گر بخردی"
  },
  {
    "poem_id": 1617,
    "vorder": 32,
    "position": 1,
    "text": "دلت بازگردان ز راه بدی"
  },
  {
    "poem_id": 1617,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید شاه از پشوتن سخن"
  },
  {
    "poem_id": 1617,
    "vorder": 34,
    "position": 1,
    "text": "پشیمان شد از درد و کین کهن"
  },
  {
    "poem_id": 1617,
    "vorder": 35,
    "position": 0,
    "text": "خروشی برآمد ز پرده‌سرای"
  },
  {
    "poem_id": 1617,
    "vorder": 36,
    "position": 1,
    "text": "که ای پهلوانان با داد و رای"
  },
  {
    "poem_id": 1617,
    "vorder": 37,
    "position": 0,
    "text": "بسیچیدن بازگشتن کنید"
  },
  {
    "poem_id": 1617,
    "vorder": 38,
    "position": 1,
    "text": "مبادا که تاراج و کشتن کنید"
  },
  {
    "poem_id": 1617,
    "vorder": 39,
    "position": 0,
    "text": "بفرمود تا پای دستان ز بند"
  },
  {
    "poem_id": 1617,
    "vorder": 40,
    "position": 1,
    "text": "گشادند و دادند بسیار پند"
  },
  {
    "poem_id": 1617,
    "vorder": 41,
    "position": 0,
    "text": "تن کشته را دخمه کردند جای"
  },
  {
    "poem_id": 1617,
    "vorder": 42,
    "position": 1,
    "text": "به گفتار دستور پاکیزه‌رای"
  },
  {
    "poem_id": 1617,
    "vorder": 43,
    "position": 0,
    "text": "ز زندان به ایوان گذر کرد زال"
  },
  {
    "poem_id": 1617,
    "vorder": 44,
    "position": 1,
    "text": "برو زار بگریست فرخ همال"
  },
  {
    "poem_id": 1617,
    "vorder": 45,
    "position": 0,
    "text": "که زارا دلیرا گوا رستما"
  },
  {
    "poem_id": 1617,
    "vorder": 46,
    "position": 1,
    "text": "نبیرهٔ گو نامور نیرما"
  },
  {
    "poem_id": 1617,
    "vorder": 47,
    "position": 0,
    "text": "تو تا زنده‌بودی که آگاه بود"
  },
  {
    "poem_id": 1617,
    "vorder": 48,
    "position": 1,
    "text": "که گشتاسپ اندر جهان شاه بود"
  },
  {
    "poem_id": 1617,
    "vorder": 49,
    "position": 0,
    "text": "کنون گنج تاراج و دستان اسیر"
  },
  {
    "poem_id": 1617,
    "vorder": 50,
    "position": 1,
    "text": "پسر زار کشته به پیکان تیر"
  },
  {
    "poem_id": 1617,
    "vorder": 51,
    "position": 0,
    "text": "مبیناد چشم کس این روزگار"
  },
  {
    "poem_id": 1617,
    "vorder": 52,
    "position": 1,
    "text": "زمین باد بی‌تخم اسفندیار"
  },
  {
    "poem_id": 1617,
    "vorder": 53,
    "position": 0,
    "text": "ازان آگهی سوی بهمن رسید"
  },
  {
    "poem_id": 1617,
    "vorder": 54,
    "position": 1,
    "text": "به نزدیک فرخ پشوتن رسید"
  },
  {
    "poem_id": 1617,
    "vorder": 55,
    "position": 0,
    "text": "پشوتن ز رودابه پردرد شد"
  },
  {
    "poem_id": 1617,
    "vorder": 56,
    "position": 1,
    "text": "ازان شیون او رخش زرد شد"
  },
  {
    "poem_id": 1617,
    "vorder": 57,
    "position": 0,
    "text": "به بهمن چنین گفت کای شاه نو"
  },
  {
    "poem_id": 1617,
    "vorder": 58,
    "position": 1,
    "text": "چو بر نیمهٔ آسمان ماه نو"
  },
  {
    "poem_id": 1617,
    "vorder": 59,
    "position": 0,
    "text": "به شبگیر ازین مرز لشکر بران"
  },
  {
    "poem_id": 1617,
    "vorder": 60,
    "position": 1,
    "text": "که این کار دشوار گشت و گران"
  },
  {
    "poem_id": 1617,
    "vorder": 61,
    "position": 0,
    "text": "ز تاج تو چشم بدان دور باد"
  },
  {
    "poem_id": 1617,
    "vorder": 62,
    "position": 1,
    "text": "همه روزگاران تو سور باد"
  },
  {
    "poem_id": 1617,
    "vorder": 63,
    "position": 0,
    "text": "بدین خانهٔ زال سام دلیر"
  },
  {
    "poem_id": 1617,
    "vorder": 64,
    "position": 1,
    "text": "سزد گر نماند شهنشاه دیر"
  },
  {
    "poem_id": 1617,
    "vorder": 65,
    "position": 0,
    "text": "چو شد کوه بر گونهٔ سندروس"
  },
  {
    "poem_id": 1617,
    "vorder": 66,
    "position": 1,
    "text": "ز درگاه برخاست آوای کوس"
  },
  {
    "poem_id": 1617,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود پس بهمن کینه‌خواه"
  },
  {
    "poem_id": 1617,
    "vorder": 68,
    "position": 1,
    "text": "کزانجا برانند یکسر سپاه"
  },
  {
    "poem_id": 1617,
    "vorder": 69,
    "position": 0,
    "text": "هم‌انگه برآمد ز پرده‌سرای"
  },
  {
    "poem_id": 1617,
    "vorder": 70,
    "position": 1,
    "text": "تبیره ابا بوق و هندی درای"
  },
  {
    "poem_id": 1617,
    "vorder": 71,
    "position": 0,
    "text": "از آنجا به ایران نهادند روی"
  },
  {
    "poem_id": 1617,
    "vorder": 72,
    "position": 1,
    "text": "به گفتار دستور آزاده‌خوی"
  },
  {
    "poem_id": 1617,
    "vorder": 73,
    "position": 0,
    "text": "سپه را ز زابل به ایران کشید"
  },
  {
    "poem_id": 1617,
    "vorder": 74,
    "position": 1,
    "text": "به نزدیک شهر دلیران کشید"
  },
  {
    "poem_id": 1617,
    "vorder": 75,
    "position": 0,
    "text": "برآسود و بر تخت بنشست شاد"
  },
  {
    "poem_id": 1617,
    "vorder": 76,
    "position": 1,
    "text": "جهان را همی داشت با رسم و داد"
  },
  {
    "poem_id": 1617,
    "vorder": 77,
    "position": 0,
    "text": "به درویش بخشید چندی درم"
  },
  {
    "poem_id": 1617,
    "vorder": 78,
    "position": 1,
    "text": "ازو چند شادان و چندی دژم"
  },
  {
    "poem_id": 1617,
    "vorder": 79,
    "position": 0,
    "text": "جهانا چه خواهی ز پروردگان"
  },
  {
    "poem_id": 1617,
    "vorder": 80,
    "position": 1,
    "text": "چه پروردگان داغ دل بردگان"
  }
]