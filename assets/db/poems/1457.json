    "text": "چنان برگرفتند لشکر ز جای"
  },
  {
    "poem_id": 1457,
    "vorder": 130,
    "position": 1,
    "text": "که پیدا نیامد همی سر ز پای"
  },
  {
    "poem_id": 1457,
    "vorder": 131,
    "position": 0,
    "text": "بکشتند چندان ز جنگ‌آوران"
