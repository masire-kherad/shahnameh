[
  {
    "poem_id": 1457,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت پس گیو با پهلوان"
  },
  {
    "poem_id": 1457,
    "vorder": 2,
    "position": 1,
    "text": "که ای نازش شهریار و گوان"
  },
  {
    "poem_id": 1457,
    "vorder": 3,
    "position": 0,
    "text": "شوم ره بگیرم به افراسیاب"
  },
  {
    "poem_id": 1457,
    "vorder": 4,
    "position": 1,
    "text": "نمانم که آید بدین روی آب"
  },
  {
    "poem_id": 1457,
    "vorder": 5,
    "position": 0,
    "text": "سر پل بگیرم بدان بدگمان"
  },
  {
    "poem_id": 1457,
    "vorder": 6,
    "position": 1,
    "text": "بدارمش ازان سوی پل یک زمان"
  },
  {
    "poem_id": 1457,
    "vorder": 7,
    "position": 0,
    "text": "بدان تا بپوشند گردان سلیح"
  },
  {
    "poem_id": 1457,
    "vorder": 8,
    "position": 1,
    "text": "که بر ما سرآمد نشاط و مزیح"
  },
  {
    "poem_id": 1457,
    "vorder": 9,
    "position": 0,
    "text": "بشد تازیان تا سر پل دمان"
  },
  {
    "poem_id": 1457,
    "vorder": 10,
    "position": 1,
    "text": "به زه بر نهاده دو زاغ کمان"
  },
  {
    "poem_id": 1457,
    "vorder": 11,
    "position": 0,
    "text": "چنین تا به نزدیکی پل رسید"
  },
  {
    "poem_id": 1457,
    "vorder": 12,
    "position": 1,
    "text": "چو آمد درفش جفا پیشه دید"
  },
  {
    "poem_id": 1457,
    "vorder": 13,
    "position": 0,
    "text": "که بگذشته بود او ازین روی آب"
  },
  {
    "poem_id": 1457,
    "vorder": 14,
    "position": 1,
    "text": "به پیش سپاه اندر افراسیاب"
  },
  {
    "poem_id": 1457,
    "vorder": 15,
    "position": 0,
    "text": "تهمتن بپوشید ببر بیان"
  },
  {
    "poem_id": 1457,
    "vorder": 16,
    "position": 1,
    "text": "نشست از بر ژنده پیل ژیان"
  },
  {
    "poem_id": 1457,
    "vorder": 17,
    "position": 0,
    "text": "چو در جوشن افراسیابش بدید"
  },
  {
    "poem_id": 1457,
    "vorder": 18,
    "position": 1,
    "text": "تو گفتی که هوش از دلش بر پرید"
  },
  {
    "poem_id": 1457,
    "vorder": 19,
    "position": 0,
    "text": "ز چنگ و بر و بازو و یال او"
  },
  {
    "poem_id": 1457,
    "vorder": 20,
    "position": 1,
    "text": "به گردن برآوردهٔ گوپال او"
  },
  {
    "poem_id": 1457,
    "vorder": 21,
    "position": 0,
    "text": "چو طوس و چو گودرز نیزه‌گذار"
  },
  {
    "poem_id": 1457,
    "vorder": 22,
    "position": 1,
    "text": "چو گرگین و چون گیو گرد و سوار"
  },
  {
    "poem_id": 1457,
    "vorder": 23,
    "position": 0,
    "text": "چو بهرام و چون زنگهٔ شادروان"
  },
  {
    "poem_id": 1457,
    "vorder": 24,
    "position": 1,
    "text": "چو فرهاد و برزین جنگ‌آوران"
  },
  {
    "poem_id": 1457,
    "vorder": 25,
    "position": 0,
    "text": "چنین لشکری سرفرازان جنگ"
  },
  {
    "poem_id": 1457,
    "vorder": 26,
    "position": 1,
    "text": "همه نیزه و تیغ هندی به چنگ"
  },
  {
    "poem_id": 1457,
    "vorder": 27,
    "position": 0,
    "text": "همه یکسر از جای برخاستند"
  },
  {
    "poem_id": 1457,
    "vorder": 28,
    "position": 1,
    "text": "بسان پلنگان بیاراستند"
  },
  {
    "poem_id": 1457,
    "vorder": 29,
    "position": 0,
    "text": "بدان‌گونه شد گیو در کارزار"
  },
  {
    "poem_id": 1457,
    "vorder": 30,
    "position": 1,
    "text": "چو شیری که گم کرده باشد شکار"
  },
  {
    "poem_id": 1457,
    "vorder": 31,
    "position": 0,
    "text": "پس و پیش هر سو همی کوفت گرز"
  },
  {
    "poem_id": 1457,
    "vorder": 32,
    "position": 1,
    "text": "دو تا کرد بسیار بالای برز"
  },
  {
    "poem_id": 1457,
    "vorder": 33,
    "position": 0,
    "text": "رمیدند ازو رزمسازان چین"
  },
  {
    "poem_id": 1457,
    "vorder": 34,
    "position": 1,
    "text": "بشد خیره سالار توران زمین"
  },
  {
    "poem_id": 1457,
    "vorder": 35,
    "position": 0,
    "text": "ز رستم بترسید افراسیاب"
  },
  {
    "poem_id": 1457,
    "vorder": 36,
    "position": 1,
    "text": "نکرد ایچ بر کینه جستن شتاب"
  },
  {
    "poem_id": 1457,
    "vorder": 37,
    "position": 0,
    "text": "پس لشکر اندر همی راند گرم"
  },
  {
    "poem_id": 1457,
    "vorder": 38,
    "position": 1,
    "text": "گوان را ز لشکر همی خواند نرم"
  },
  {
    "poem_id": 1457,
    "vorder": 39,
    "position": 0,
    "text": "ز توران فراوان سران کشته شد"
  },
  {
    "poem_id": 1457,
    "vorder": 40,
    "position": 1,
    "text": "سر بخت گردنکشان گشته شد"
  },
  {
    "poem_id": 1457,
    "vorder": 41,
    "position": 0,
    "text": "ز پیران بپرسید افراسیاب"
  },
  {
    "poem_id": 1457,
    "vorder": 42,
    "position": 1,
    "text": "که این دشت رزم‌ست گر جای خواب"
  },
  {
    "poem_id": 1457,
    "vorder": 43,
    "position": 0,
    "text": "که در رزم جستن دلیران بدیم"
  },
  {
    "poem_id": 1457,
    "vorder": 44,
    "position": 1,
    "text": "سگالش گرفتیم و شیران بدیم"
  },
  {
    "poem_id": 1457,
    "vorder": 45,
    "position": 0,
    "text": "کنون دشت روباه بینم همی"
  },
  {
    "poem_id": 1457,
    "vorder": 46,
    "position": 1,
    "text": "ز رزم آز کوتاه بینم همی"
  },
  {
    "poem_id": 1457,
    "vorder": 47,
    "position": 0,
    "text": "ز مردان توران خنیده تویی"
  },
  {
    "poem_id": 1457,
    "vorder": 48,
    "position": 1,
    "text": "جهان‌جوی و هم رزمدیده تویی"
  },
  {
    "poem_id": 1457,
    "vorder": 49,
    "position": 0,
    "text": "سنان را به تندی یکی برگرای"
  },
  {
    "poem_id": 1457,
    "vorder": 50,
    "position": 1,
    "text": "برو زود زیشان بپرداز جای"
  },
  {
    "poem_id": 1457,
    "vorder": 51,
    "position": 0,
    "text": "چو پیروزگر باشی ایران تراست"
  },
  {
    "poem_id": 1457,
    "vorder": 52,
    "position": 1,
    "text": "تن پیل و چنگال شیران تراست"
  },
  {
    "poem_id": 1457,
    "vorder": 53,
    "position": 0,
    "text": "چو پیران ز افراسیاب این شنید"
  },
  {
    "poem_id": 1457,
    "vorder": 54,
    "position": 1,
    "text": "چو از باد آتش دلش بردمید"
  },
  {
    "poem_id": 1457,
    "vorder": 55,
    "position": 0,
    "text": "بسیچید با نامور ده‌هزار"
  },
  {
    "poem_id": 1457,
    "vorder": 56,
    "position": 1,
    "text": "ز ترکان دلیران خنجرگذار"
  },
  {
    "poem_id": 1457,
    "vorder": 57,
    "position": 0,
    "text": "چو آتش بیامد بر پیلتن"
  },
  {
    "poem_id": 1457,
    "vorder": 58,
    "position": 1,
    "text": "کزو بود نیروی جنگ و شکن"
  },
  {
    "poem_id": 1457,
    "vorder": 59,
    "position": 0,
    "text": "تهمتن به لبها برآورده کف"
  },
  {
    "poem_id": 1457,
    "vorder": 60,
    "position": 1,
    "text": "تو گفتی که بستد ز خورشید تف"
  },
  {
    "poem_id": 1457,
    "vorder": 61,
    "position": 0,
    "text": "برانگیخت اسپ و برآمد خروش"
  },
  {
    "poem_id": 1457,
    "vorder": 62,
    "position": 1,
    "text": "بران سان که دریا برآید بجوش"
  },
  {
    "poem_id": 1457,
    "vorder": 63,
    "position": 0,
    "text": "سپر بر سر و تیغ هندی به مشت"
  },
  {
    "poem_id": 1457,
    "vorder": 64,
    "position": 1,
    "text": "ازان نامداران دو بهره بکشت"
  },
  {
    "poem_id": 1457,
    "vorder": 65,
    "position": 0,
    "text": "نگه کرد افراسیاب از کران"
  },
  {
    "poem_id": 1457,
    "vorder": 66,
    "position": 1,
    "text": "چنین گفت با نامور مهتران"
  },
  {
    "poem_id": 1457,
    "vorder": 67,
    "position": 0,
    "text": "که گر تا شب این جنگ هم زین نشان"
  },
  {
    "poem_id": 1457,
    "vorder": 68,
    "position": 1,
    "text": "میان دلیران و گردنکشان"
  },
  {
    "poem_id": 1457,
    "vorder": 69,
    "position": 0,
    "text": "بماند نماند سواری به جای"
  },
  {
    "poem_id": 1457,
    "vorder": 70,
    "position": 1,
    "text": "نبایست کردن بدین رزم رای"
  },
  {
    "poem_id": 1457,
    "vorder": 71,
    "position": 0,
    "text": "بپرسید کالکوس جنگی کجاست"
  },
  {
    "poem_id": 1457,
    "vorder": 72,
    "position": 1,
    "text": "که چندین همی رزم شیران بخواست"
  },
  {
    "poem_id": 1457,
    "vorder": 73,
    "position": 0,
    "text": "به مستی همی گیو را خواستی"
  },
  {
    "poem_id": 1457,
    "vorder": 74,
    "position": 1,
    "text": "همه جنگ با رستم آراستی"
  },
  {
    "poem_id": 1457,
    "vorder": 75,
    "position": 0,
    "text": "همیشه از ایران بدی یاد اوی"
  },
  {
    "poem_id": 1457,
    "vorder": 76,
    "position": 1,
    "text": "کجا شد چنان آتش و باد اوی"
  },
  {
    "poem_id": 1457,
    "vorder": 77,
    "position": 0,
    "text": "به الکوس رفت آگهی زین سخن"
  },
  {
    "poem_id": 1457,
    "vorder": 78,
    "position": 1,
    "text": "که سالار توران چه افگند بن"
  },
  {
    "poem_id": 1457,
    "vorder": 79,
    "position": 0,
    "text": "برانگیخت الکوس شبرنگ را"
  },
  {
    "poem_id": 1457,
    "vorder": 80,
    "position": 1,
    "text": "به خون شسته بد بی‌گمان چنگ را"
  },
  {
    "poem_id": 1457,
    "vorder": 81,
    "position": 0,
    "text": "برون رفت با او ز لشکر سوار"
  },
  {
    "poem_id": 1457,
    "vorder": 82,
    "position": 1,
    "text": "ز مردان جنگی فزون از هزار"
  },
  {
    "poem_id": 1457,
    "vorder": 83,
    "position": 0,
    "text": "همه با سنان سرافشان شدند"
  },
  {
    "poem_id": 1457,
    "vorder": 84,
    "position": 1,
    "text": "ابا جوشن و گرز و خفتان شدند"
  },
  {
    "poem_id": 1457,
    "vorder": 85,
    "position": 0,
    "text": "زواره پدیدار بد جنگجوی"
  },
  {
    "poem_id": 1457,
    "vorder": 86,
    "position": 1,
    "text": "بدو تیز الکوس بنهاد روی"
  },
  {
    "poem_id": 1457,
    "vorder": 87,
    "position": 0,
    "text": "گمانی چنان برد کو رستم‌ست"
  },
  {
    "poem_id": 1457,
    "vorder": 88,
    "position": 1,
    "text": "بدانست کز تخمهٔ نیرم‌ست"
  },
  {
    "poem_id": 1457,
    "vorder": 89,
    "position": 0,
    "text": "زواره برآویخت با او به هم"
  },
  {
    "poem_id": 1457,
    "vorder": 90,
    "position": 1,
    "text": "چو پیل سرافراز و شیر دژم"
  },
  {
    "poem_id": 1457,
    "vorder": 91,
    "position": 0,
    "text": "سناندار نیزه به دو نیم کرد"
  },
  {
    "poem_id": 1457,
    "vorder": 92,
    "position": 1,
    "text": "دل شیر چنگی پر از بیم کرد"
  },
  {
    "poem_id": 1457,
    "vorder": 93,
    "position": 0,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 1457,
    "vorder": 94,
    "position": 1,
    "text": "ز گرد سران شد زمین ناپدید"
  },
  {
    "poem_id": 1457,
    "vorder": 95,
    "position": 0,
    "text": "ز کین‌آوران تیغ بر هم شکست"
  },
  {
    "poem_id": 1457,
    "vorder": 96,
    "position": 1,
    "text": "سوی گرز بردند چون باد دست"
  },
  {
    "poem_id": 1457,
    "vorder": 97,
    "position": 0,
    "text": "بینداخت الکوس گرزی چو کوه"
  },
  {
    "poem_id": 1457,
    "vorder": 98,
    "position": 1,
    "text": "که از بیم او شد زواره ستوه"
  },
  {
    "poem_id": 1457,
    "vorder": 99,
    "position": 0,
    "text": "به زین اندر از زخم بی‌توش گشت"
  },
  {
    "poem_id": 1457,
    "vorder": 100,
    "position": 1,
    "text": "ز اسپ اندر افتاد و بیهوش گشت"
  },
  {
    "poem_id": 1457,
    "vorder": 101,
    "position": 0,
    "text": "فرود آمد الکوس تنگ از برش"
  },
  {
    "poem_id": 1457,
    "vorder": 102,
    "position": 1,
    "text": "همی خواست از تن بریدن سرش"
  },
  {
    "poem_id": 1457,
    "vorder": 103,
    "position": 0,
    "text": "چو رستم برادر بران‌گونه دید"
  },
  {
    "poem_id": 1457,
    "vorder": 104,
    "position": 1,
    "text": "به کردار آتش سوی او دوید"
  },
  {
    "poem_id": 1457,
    "vorder": 105,
    "position": 0,
    "text": "به الکوس بر زد یکی بانگ تند"
  },
  {
    "poem_id": 1457,
    "vorder": 106,
    "position": 1,
    "text": "کجا دست شد سست و شمشیر کند"
  },
  {
    "poem_id": 1457,
    "vorder": 107,
    "position": 0,
    "text": "چو الکوس آوای رستم شنید"
  },
  {
    "poem_id": 1457,
    "vorder": 108,
    "position": 1,
    "text": "دلش گفتی از پوست آمد پدید"
  },
  {
    "poem_id": 1457,
    "vorder": 109,
    "position": 0,
    "text": "به زین اندر آمد به کردار باد"
  },
  {
    "poem_id": 1457,
    "vorder": 110,
    "position": 1,
    "text": "ز مردی بدل در نیامدش یاد"
  },
  {
    "poem_id": 1457,
    "vorder": 111,
    "position": 0,
    "text": "بدو گفت رستم که چنگال شیر"
  },
  {
    "poem_id": 1457,
    "vorder": 112,
    "position": 1,
    "text": "نپیموده‌ای زان شدستی دلیر"
  },
  {
    "poem_id": 1457,
    "vorder": 113,
    "position": 0,
    "text": "زواره به درد از بر زین نشست"
  },
  {
    "poem_id": 1457,
    "vorder": 114,
    "position": 1,
    "text": "پر از خون تن و تیغ مانده به دست"
  },
  {
    "poem_id": 1457,
    "vorder": 115,
    "position": 0,
    "text": "برآویخت الکوس با پیلتن"
  },
  {
    "poem_id": 1457,
    "vorder": 116,
    "position": 1,
    "text": "بپوشید بر زین توزی کفن"
  },
  {
    "poem_id": 1457,
    "vorder": 117,
    "position": 0,
    "text": "یکی نیزه زد بر کمربند اوی"
  },
  {
    "poem_id": 1457,
    "vorder": 118,
    "position": 1,
    "text": "ز دامن نشد دور پیوند اوی"
  },
  {
    "poem_id": 1457,
    "vorder": 119,
    "position": 0,
    "text": "تهمتن یکی نیزه زد بر برش"
  },
  {
    "poem_id": 1457,
    "vorder": 120,
    "position": 1,
    "text": "به خون جگر غرقه شد مغفرش"
  },
  {
    "poem_id": 1457,
    "vorder": 121,
    "position": 0,
    "text": "به نیزه همیدون ز زین برگرفت"
  },
  {
    "poem_id": 1457,
    "vorder": 122,
    "position": 1,
    "text": "دو لشکر بمانده بدو در شگفت"
  },
  {
    "poem_id": 1457,
    "vorder": 123,
    "position": 0,
    "text": "زدش بر زمین همچو یک لخت کوه"
  },
  {
    "poem_id": 1457,
    "vorder": 124,
    "position": 1,
    "text": "پر از بیم شد جان توران گروه"
  },
  {
    "poem_id": 1457,
    "vorder": 125,
    "position": 0,
    "text": "برین همنشان هفت گرد دلیر"
  },
  {
    "poem_id": 1457,
    "vorder": 126,
    "position": 1,
    "text": "کشیدند شمشیر برسان شیر"
  },
  {
    "poem_id": 1457,
    "vorder": 127,
