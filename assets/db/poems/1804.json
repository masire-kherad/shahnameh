[
  {
    "poem_id": 1804,
    "vorder": 1,
    "position": 0,
    "text": "یکی کرگ بود اندران شهر شاه"
  },
  {
    "poem_id": 1804,
    "vorder": 2,
    "position": 1,
    "text": "ز بالای او بسته بر باد راه"
  },
  {
    "poem_id": 1804,
    "vorder": 3,
    "position": 0,
    "text": "ازان بیشه بگریختی شیر نر"
  },
  {
    "poem_id": 1804,
    "vorder": 4,
    "position": 1,
    "text": "هم از آسمان کرگس تیرپر"
  },
  {
    "poem_id": 1804,
    "vorder": 5,
    "position": 0,
    "text": "یکایک همه هند زو پر خروش"
  },
  {
    "poem_id": 1804,
    "vorder": 6,
    "position": 1,
    "text": "از آواز او کر شدی تیز گوش"
  },
  {
    "poem_id": 1804,
    "vorder": 7,
    "position": 0,
    "text": "به بهرام گفت ای پسندیده مرد"
  },
  {
    "poem_id": 1804,
    "vorder": 8,
    "position": 1,
    "text": "برآید به دست تو این کارکرد"
  },
  {
    "poem_id": 1804,
    "vorder": 9,
    "position": 0,
    "text": "به نزدیک آن کرگ باید شدن"
  },
  {
    "poem_id": 1804,
    "vorder": 10,
    "position": 1,
    "text": "همه چرم او را به تیر آژدن"
  },
  {
    "poem_id": 1804,
    "vorder": 11,
    "position": 0,
    "text": "اگر زو تهی گردد این بوم و بر"
  },
  {
    "poem_id": 1804,
    "vorder": 12,
    "position": 1,
    "text": "به فر تو این مرد پیروزگر"
  },
  {
    "poem_id": 1804,
    "vorder": 13,
    "position": 0,
    "text": "یکی دست باشدت نزدیک من"
  },
  {
    "poem_id": 1804,
    "vorder": 14,
    "position": 1,
    "text": "چه نزدیک این نامدار انجمن"
  },
  {
    "poem_id": 1804,
    "vorder": 15,
    "position": 0,
    "text": "که جاوید در کشور هندوان"
  },
  {
    "poem_id": 1804,
    "vorder": 16,
    "position": 1,
    "text": "بود زنده نام تو تا جاودان"
  },
  {
    "poem_id": 1804,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت بهرام پاکیزه‌رای"
  },
  {
    "poem_id": 1804,
    "vorder": 18,
    "position": 1,
    "text": "که با من بباید یکی رهنمای"
  },
  {
    "poem_id": 1804,
    "vorder": 19,
    "position": 0,
    "text": "چو بینم به نیروی یزدان تنش"
  },
  {
    "poem_id": 1804,
    "vorder": 20,
    "position": 1,
    "text": "ببینی به خون غرقه پیراهنش"
  },
  {
    "poem_id": 1804,
    "vorder": 21,
    "position": 0,
    "text": "بدو داد شنگل یکی رهنمای"
  },
  {
    "poem_id": 1804,
    "vorder": 22,
    "position": 1,
    "text": "که او را نشیمن بدانست و جای"
  },
  {
    "poem_id": 1804,
    "vorder": 23,
    "position": 0,
    "text": "همی رفت با نیک‌دل رهنمون"
  },
  {
    "poem_id": 1804,
    "vorder": 24,
    "position": 1,
    "text": "بدان بیشهٔ کرگ ریزنده خون"
  },
  {
    "poem_id": 1804,
    "vorder": 25,
    "position": 0,
    "text": "همی گفت چندی ز آرام اوی"
  },
  {
    "poem_id": 1804,
    "vorder": 26,
    "position": 1,
    "text": "ز بالا و پهنا و اندام اوی"
  },
  {
    "poem_id": 1804,
    "vorder": 27,
    "position": 0,
    "text": "چو بنمود و برگشت و بهرام رفت"
  },
  {
    "poem_id": 1804,
    "vorder": 28,
    "position": 1,
    "text": "خرامان بدان بیشهٔ کرگ تفت"
  },
  {
    "poem_id": 1804,
    "vorder": 29,
    "position": 0,
    "text": "پس پشت او چند ایرانیان"
  },
  {
    "poem_id": 1804,
    "vorder": 30,
    "position": 1,
    "text": "به پیکار آن کرگ بسته میان"
  },
  {
    "poem_id": 1804,
    "vorder": 31,
    "position": 0,
    "text": "چو از دور دیدند خرطوم اوی"
  },
  {
    "poem_id": 1804,
    "vorder": 32,
    "position": 1,
    "text": "ز هنگش همی پست شد بوم اوی"
  },
  {
    "poem_id": 1804,
    "vorder": 33,
    "position": 0,
    "text": "بدو هرکسی گفت شاها مکن"
  },
  {
    "poem_id": 1804,
    "vorder": 34,
    "position": 1,
    "text": "ز مردی همی بگذرد این سخن"
  },
  {
    "poem_id": 1804,
    "vorder": 35,
    "position": 0,
    "text": "نکردست کس جنگ با کوه و سنگ"
  },
  {
    "poem_id": 1804,
    "vorder": 36,
    "position": 1,
    "text": "وگرچه دلیرست خسرو به چنگ"
  },
  {
    "poem_id": 1804,
    "vorder": 37,
    "position": 0,
    "text": "به شنگل چنین گوی کاین راه نیست"
  },
  {
    "poem_id": 1804,
    "vorder": 38,
    "position": 1,
    "text": "بدین جنگ دستوری شاه نیست"
  },
  {
    "poem_id": 1804,
    "vorder": 39,
    "position": 0,
    "text": "چنین داد پاسخ که یزدان پاک"
  },
  {
    "poem_id": 1804,
    "vorder": 40,
    "position": 1,
    "text": "مرا گر به هندوستان داد خاک"
  },
  {
    "poem_id": 1804,
    "vorder": 41,
    "position": 0,
    "text": "به جای دگر مرگ من چون بود"
  },
  {
    "poem_id": 1804,
    "vorder": 42,
    "position": 1,
    "text": "که اندیشه ز اندازه بیرون بود"
  },
  {
    "poem_id": 1804,
    "vorder": 43,
    "position": 0,
    "text": "کمان را به زه کرد مرد جوان"
  },
  {
    "poem_id": 1804,
    "vorder": 44,
    "position": 1,
    "text": "تو گفتی همی خوار گیرد روان"
  },
  {
    "poem_id": 1804,
    "vorder": 45,
    "position": 0,
    "text": "بیامد دوان تا به نزدیک کرگ"
  },
  {
    "poem_id": 1804,
    "vorder": 46,
    "position": 1,
    "text": "پر از خشم سر دل نهاده به مرگ"
  },
  {
    "poem_id": 1804,
    "vorder": 47,
    "position": 0,
    "text": "کمان کیانی گرفته به چنگ"
  },
  {
    "poem_id": 1804,
    "vorder": 48,
    "position": 1,
    "text": "ز ترکش برآورد تیر خدنگ"
  },
  {
    "poem_id": 1804,
    "vorder": 49,
    "position": 0,
    "text": "همی تیر بارید همچون تگرگ"
  },
  {
    "poem_id": 1804,
    "vorder": 50,
    "position": 1,
    "text": "برین همنشان تا غمین گشت کرگ"
  },
  {
    "poem_id": 1804,
    "vorder": 51,
    "position": 0,
    "text": "چو دانست کو را سرآمد زمان"
  },
  {
    "poem_id": 1804,
    "vorder": 52,
    "position": 1,
    "text": "برآهیخت خنجر به جای کمان"
  },
  {
    "poem_id": 1804,
    "vorder": 53,
    "position": 0,
    "text": "سر کرگ را راست ببرید و گفت"
  },
  {
    "poem_id": 1804,
    "vorder": 54,
    "position": 1,
    "text": "به نام خداوند بی‌یار و جفت"
  },
  {
    "poem_id": 1804,
    "vorder": 55,
    "position": 0,
    "text": "که او داد چندین مرا فر و زور"
  },
  {
    "poem_id": 1804,
    "vorder": 56,
    "position": 1,
    "text": "به فرمان او تابد از چرخ هور"
  },
  {
    "poem_id": 1804,
    "vorder": 57,
    "position": 0,
    "text": "بفرمود تا گاو و گردون برند"
  },
  {
    "poem_id": 1804,
    "vorder": 58,
    "position": 1,
    "text": "سر کرگ زان بیشه بیرون برند"
  },
  {
    "poem_id": 1804,
    "vorder": 59,
    "position": 0,
    "text": "ببردند چون دید شنگل ز دور"
  },
  {
    "poem_id": 1804,
    "vorder": 60,
    "position": 1,
    "text": "به دیبا بیاراست ایوان سور"
  },
  {
    "poem_id": 1804,
    "vorder": 61,
    "position": 0,
    "text": "چو بر تخت بنشست پرمایه شاه"
  },
  {
    "poem_id": 1804,
    "vorder": 62,
    "position": 1,
    "text": "نشاندند بهرام را پیش گاه"
  },
  {
    "poem_id": 1804,
    "vorder": 63,
    "position": 0,
    "text": "همی کرد هر کس برو آفرین"
  },
  {
    "poem_id": 1804,
    "vorder": 64,
    "position": 1,
    "text": "بزرگان هند و سواران چنین"
  },
  {
    "poem_id": 1804,
    "vorder": 65,
    "position": 0,
    "text": "برفتند هر مهتری با نثار"
  },
  {
    "poem_id": 1804,
    "vorder": 66,
    "position": 1,
    "text": "به بهرام گفتند کای نامدار"
  },
  {
    "poem_id": 1804,
    "vorder": 67,
    "position": 0,
    "text": "کسی را سزای تو کردار نیست"
  },
  {
    "poem_id": 1804,
    "vorder": 68,
    "position": 1,
    "text": "به کردار تو راه دیدار نیست"
  },
  {
    "poem_id": 1804,
    "vorder": 69,
    "position": 0,
    "text": "ازو شادمان شنگل و دل به غم"
  },
  {
    "poem_id": 1804,
    "vorder": 70,
    "position": 1,
    "text": "گهی تازه‌روی و زمانی دژم"
  }
]