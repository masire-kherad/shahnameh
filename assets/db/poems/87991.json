[
  {
    "poem_id": 87991,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید بر گنبد لاژورد"
  },
  {
    "poem_id": 87991,
    "vorder": 2,
    "position": 1,
    "text": "سراپرده‌ای زد ز دیبای زرد"
  },
  {
    "poem_id": 87991,
    "vorder": 3,
    "position": 0,
    "text": "خروشی بلند آمد از دیده‌گاه"
  },
  {
    "poem_id": 87991,
    "vorder": 4,
    "position": 1,
    "text": "بگودرز کای پهلوان سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 5,
    "position": 0,
    "text": "سپاه آمد و راه نزدیک شد"
  },
  {
    "poem_id": 87991,
    "vorder": 6,
    "position": 1,
    "text": "ز گرد سپه روز تاریک شد"
  },
  {
    "poem_id": 87991,
    "vorder": 7,
    "position": 0,
    "text": "بجنبید گودرز از جای خویش"
  },
  {
    "poem_id": 87991,
    "vorder": 8,
    "position": 1,
    "text": "بیاورد پوینده بالای خویش"
  },
  {
    "poem_id": 87991,
    "vorder": 9,
    "position": 0,
    "text": "سوی گرد تاریک بنهاد روی"
  },
  {
    "poem_id": 87991,
    "vorder": 10,
    "position": 1,
    "text": "همی شد خلیده دل و راه‌جوی"
  },
  {
    "poem_id": 87991,
    "vorder": 11,
    "position": 0,
    "text": "بیامد چو نزدیک ایشان رسید"
  },
  {
    "poem_id": 87991,
    "vorder": 12,
    "position": 1,
    "text": "درفش فریبرز کاوس دید"
  },
  {
    "poem_id": 87991,
    "vorder": 13,
    "position": 0,
    "text": "که او بد بایران سپه پیش‌رو"
  },
  {
    "poem_id": 87991,
    "vorder": 14,
    "position": 1,
    "text": "پسندیده و خویش سالار نو"
  },
  {
    "poem_id": 87991,
    "vorder": 15,
    "position": 0,
    "text": "پیاده شد از اسپ گودرز پیر"
  },
  {
    "poem_id": 87991,
    "vorder": 16,
    "position": 1,
    "text": "همان لشکر افروز دانش‌پذیر"
  },
  {
    "poem_id": 87991,
    "vorder": 17,
    "position": 0,
    "text": "گرفتند مر یکدگر را کنار"
  },
  {
    "poem_id": 87991,
    "vorder": 18,
    "position": 1,
    "text": "خروشی برآمد ز هر دو بزار"
  },
  {
    "poem_id": 87991,
    "vorder": 19,
    "position": 0,
    "text": "فریبرز گفت ای سپهدار پیر"
  },
  {
    "poem_id": 87991,
    "vorder": 20,
    "position": 1,
    "text": "همیشه بجنگ اندری ناگزیر"
  },
  {
    "poem_id": 87991,
    "vorder": 21,
    "position": 0,
    "text": "ز کین سیاوش تو داری زیان"
  },
  {
    "poem_id": 87991,
    "vorder": 22,
    "position": 1,
    "text": "دریغا سواران گودرزیان"
  },
  {
    "poem_id": 87991,
    "vorder": 23,
    "position": 0,
    "text": "ازیشان ترا مزد بسیار باد"
  },
  {
    "poem_id": 87991,
    "vorder": 24,
    "position": 1,
    "text": "سر بخت دشمن نگونسار باد"
  },
  {
    "poem_id": 87991,
    "vorder": 25,
    "position": 0,
    "text": "سپاس از خداوند خورشید و ماه"
  },
  {
    "poem_id": 87991,
    "vorder": 26,
    "position": 1,
    "text": "که دیدم ترا زنده بر جایگاه"
  },
  {
    "poem_id": 87991,
    "vorder": 27,
    "position": 0,
    "text": "ازیشان ببارید گودرز خون"
  },
  {
    "poem_id": 87991,
    "vorder": 28,
    "position": 1,
    "text": "که بودند کشته بخاک اندرون"
  },
  {
    "poem_id": 87991,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت بنگر که از بخت بد"
  },
  {
    "poem_id": 87991,
    "vorder": 30,
    "position": 1,
    "text": "همی بر سرم هر زمان بد رسد"
  },
  {
    "poem_id": 87991,
    "vorder": 31,
    "position": 0,
    "text": "درین جنگ پور و نبیره نماند"
  },
  {
    "poem_id": 87991,
    "vorder": 32,
    "position": 1,
    "text": "سپاه و درفش و تبیره نماند"
  },
  {
    "poem_id": 87991,
    "vorder": 33,
    "position": 0,
    "text": "فرامش شدم کار آن کارزار"
  },
  {
    "poem_id": 87991,
    "vorder": 34,
    "position": 1,
    "text": "کنونست رزم و کنونست کار"
  },
  {
    "poem_id": 87991,
    "vorder": 35,
    "position": 0,
    "text": "سپاهست چندان برین دشت و راغ"
  },
  {
    "poem_id": 87991,
    "vorder": 36,
    "position": 1,
    "text": "که روی زمین گشت چون پر زاغ"
  },
  {
    "poem_id": 87991,
    "vorder": 37,
    "position": 0,
    "text": "همه لشکر طوس با این سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 38,
    "position": 1,
    "text": "چو تیره شبانست با نور ماه"
  },
  {
    "poem_id": 87991,
    "vorder": 39,
    "position": 0,
    "text": "ز چین و ز سقلاب وز هند و روم"
  },
  {
    "poem_id": 87991,
    "vorder": 40,
    "position": 1,
    "text": "ز ویران گیتی و آباد بوم"
  },
  {
    "poem_id": 87991,
    "vorder": 41,
    "position": 0,
    "text": "همانا نماندست یک جانور"
  },
  {
    "poem_id": 87991,
    "vorder": 42,
    "position": 1,
    "text": "مگر بسته بر جنگ ما بر کمر"
  },
  {
    "poem_id": 87991,
    "vorder": 43,
    "position": 0,
    "text": "کنون تا نگویی که رستم کجاست"
  },
  {
    "poem_id": 87991,
    "vorder": 44,
    "position": 1,
    "text": "ز غمها نگردد مرا پشت راست"
  },
  {
    "poem_id": 87991,
    "vorder": 45,
    "position": 0,
    "text": "فریبرز گفت از پس من ز جای"
  },
  {
    "poem_id": 87991,
    "vorder": 46,
    "position": 1,
    "text": "بیامد نبودش جز از رزم رای"
  },
  {
    "poem_id": 87991,
    "vorder": 47,
    "position": 0,
    "text": "شب تیره را تا سپیده دمان"
  },
  {
    "poem_id": 87991,
    "vorder": 48,
    "position": 1,
    "text": "بیاید بره بر نجوید زمان"
  },
  {
    "poem_id": 87991,
    "vorder": 49,
    "position": 0,
    "text": "کنون من کجا گیرم آرامگاه"
  },
  {
    "poem_id": 87991,
    "vorder": 50,
    "position": 1,
    "text": "کجا رانم این خوار مایه سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت گودرز رستم چه گفت"
  },
  {
    "poem_id": 87991,
    "vorder": 52,
    "position": 1,
    "text": "که گفتار او را نشاید نهفت"
  },
  {
    "poem_id": 87991,
    "vorder": 53,
    "position": 0,
    "text": "فریبرز گفت ای جهاندیده مرد"
  },
  {
    "poem_id": 87991,
    "vorder": 54,
    "position": 1,
    "text": "تهمتن نفرمود ما را نبرد"
  },
  {
    "poem_id": 87991,
    "vorder": 55,
    "position": 0,
    "text": "بباشید گفت اندران رزمگاه"
  },
  {
    "poem_id": 87991,
    "vorder": 56,
    "position": 1,
    "text": "نباید شدن پیش روی سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 57,
    "position": 0,
    "text": "بباید بدان رزمگاه آرمید"
  },
  {
    "poem_id": 87991,
    "vorder": 58,
    "position": 1,
    "text": "یکی تا درفش من آید پدید"
  },
  {
    "poem_id": 87991,
    "vorder": 59,
    "position": 0,
    "text": "برفت او و گودرز با او برفت"
  },
  {
    "poem_id": 87991,
    "vorder": 60,
    "position": 1,
    "text": "براه هماون خرامید تفت"
  },
  {
    "poem_id": 87991,
    "vorder": 61,
    "position": 0,
    "text": "چو لشکر پدید آمد از دیده‌گاه"
  },
  {
    "poem_id": 87991,
    "vorder": 62,
    "position": 1,
    "text": "بشد دیده‌بان پیش توران سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 63,
    "position": 0,
    "text": "کز ایران یکی لشکر آمد بدشت"
  },
  {
    "poem_id": 87991,
    "vorder": 64,
    "position": 1,
    "text": "ازان روی سوی هماون گذشت"
  },
  {
    "poem_id": 87991,
    "vorder": 65,
    "position": 0,
    "text": "سپهبد بشد پیش خاقان چین"
  },
  {
    "poem_id": 87991,
    "vorder": 66,
    "position": 1,
    "text": "که آمد سپاهی ز ایران زمین"
  },
  {
    "poem_id": 87991,
    "vorder": 67,
    "position": 0,
    "text": "ندانیم چندست و سالار کیست"
  },
  {
    "poem_id": 87991,
    "vorder": 68,
    "position": 1,
    "text": "چه سازیم و درمان این کار چیست"
  },
  {
    "poem_id": 87991,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت کاموس رزم آزمای"
  },
  {
    "poem_id": 87991,
    "vorder": 70,
    "position": 1,
    "text": "بجایی که مهتر تو باشی بپای"
  },
  {
    "poem_id": 87991,
    "vorder": 71,
    "position": 0,
    "text": "بزرگان درگاه افراسیاب"
  },
  {
    "poem_id": 87991,
    "vorder": 72,
    "position": 1,
    "text": "سپاهی بکردار دریای آب"
  },
  {
    "poem_id": 87991,
    "vorder": 73,
    "position": 0,
    "text": "تو دانی چه کردی بدین پنج ماه"
  },
  {
    "poem_id": 87991,
    "vorder": 74,
    "position": 1,
    "text": "برین دشت با خوار مایه سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 75,
    "position": 0,
    "text": "کنون چون زمین سربسر لشکرست"
  },
  {
    "poem_id": 87991,
    "vorder": 76,
    "position": 1,
    "text": "چو خاقان و منشور کنداورست"
  },
  {
    "poem_id": 87991,
    "vorder": 77,
    "position": 0,
    "text": "بمان تا هنرها پدید آوریم"
  },
  {
    "poem_id": 87991,
    "vorder": 78,
    "position": 1,
    "text": "تو در بستی و ما کلید آوریم"
  },
  {
    "poem_id": 87991,
    "vorder": 79,
    "position": 0,
    "text": "گر از کابل و زابل و مای و هند"
  },
  {
    "poem_id": 87991,
    "vorder": 80,
    "position": 1,
    "text": "شود روی گیتی چو رومی پرند"
  },
  {
    "poem_id": 87991,
    "vorder": 81,
    "position": 0,
    "text": "همانا به تنها تن من نیند"
  },
  {
    "poem_id": 87991,
    "vorder": 82,
    "position": 1,
    "text": "نگویی که ایرانیان خود کیند"
  },
  {
    "poem_id": 87991,
    "vorder": 83,
    "position": 0,
    "text": "تو ترسانی از رستم نامدار"
  },
  {
    "poem_id": 87991,
    "vorder": 84,
    "position": 1,
    "text": "نخستین ازو من برآرم دمار"
  },
  {
    "poem_id": 87991,
    "vorder": 85,
    "position": 0,
    "text": "گرش یک زمان اندر آرم بدام"
  },
  {
    "poem_id": 87991,
    "vorder": 86,
    "position": 1,
    "text": "نمانم که ماند بگیتیش نام"
  },
  {
    "poem_id": 87991,
    "vorder": 87,
    "position": 0,
    "text": "تو از لشکر سیستان خسته‌ای"
  },
  {
    "poem_id": 87991,
    "vorder": 88,
    "position": 1,
    "text": "دل خویش در جنگشان بسته‌ای"
  },
  {
    "poem_id": 87991,
    "vorder": 89,
    "position": 0,
    "text": "یکی بار دست من اندر نبرد"
  },
  {
    "poem_id": 87991,
    "vorder": 90,
    "position": 1,
    "text": "نگه کن که برخیزد از دشت گرد"
  },
  {
    "poem_id": 87991,
    "vorder": 91,
    "position": 0,
    "text": "بدانی که اندر جهان مرد کیست"
  },
  {
    "poem_id": 87991,
    "vorder": 92,
    "position": 1,
    "text": "دلیران کدامند و پیکار چیست"
  },
  {
    "poem_id": 87991,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت پیران کانوشه بدی"
  },
  {
    "poem_id": 87991,
    "vorder": 94,
    "position": 1,
    "text": "همیشه ز تو دور دست بدی"
  },
  {
    "poem_id": 87991,
    "vorder": 95,
    "position": 0,
    "text": "بپیران چنین گفت خاقان چین"
  },
  {
    "poem_id": 87991,
    "vorder": 96,
    "position": 1,
    "text": "که کاموس را راه دادی بکین"
  },
  {
    "poem_id": 87991,
    "vorder": 97,
    "position": 0,
    "text": "بکردار پیش آورد هرچ گفت"
  },
  {
    "poem_id": 87991,
    "vorder": 98,
    "position": 1,
    "text": "که با کوه یارست و با پیل جفت"
  },
  {
    "poem_id": 87991,
    "vorder": 99,
    "position": 0,
    "text": "از ایرانیان نیست چندین سخن"
  },
  {
    "poem_id": 87991,
    "vorder": 100,
    "position": 1,
    "text": "دل جنگجویان چنین بد مکن"
  },
  {
    "poem_id": 87991,
    "vorder": 101,
    "position": 0,
    "text": "بایران نمانیم یک سرفراز"
  },
  {
    "poem_id": 87991,
    "vorder": 102,
    "position": 1,
    "text": "برآریم گرد از نشیب و فراز"
  },
  {
    "poem_id": 87991,
    "vorder": 103,
    "position": 0,
    "text": "هرانکس که هستند با جاه و آب"
  },
  {
    "poem_id": 87991,
    "vorder": 104,
    "position": 1,
    "text": "فرستیم نزدیک افراسیاب"
  },
  {
    "poem_id": 87991,
    "vorder": 105,
    "position": 0,
    "text": "همه پای کرده به بندگران"
  },
  {
    "poem_id": 87991,
    "vorder": 106,
    "position": 1,
    "text": "وزیشان فگنده فراوان سران"
  },
  {
    "poem_id": 87991,
    "vorder": 107,
    "position": 0,
    "text": "بایران نمانیم برگ درخت"
  },
  {
    "poem_id": 87991,
    "vorder": 108,
    "position": 1,
    "text": "نه گاه و نه شاه و نه تاج و نه تخت"
  },
  {
    "poem_id": 87991,
    "vorder": 109,
    "position": 0,
    "text": "بخندید پیران و کرد آفرین"
  },
  {
    "poem_id": 87991,
    "vorder": 110,
    "position": 1,
    "text": "بران نامداران و خاقان چین"
  },
  {
    "poem_id": 87991,
    "vorder": 111,
    "position": 0,
    "text": "بلشکر گه آمد دلی شادمان"
  },
  {
    "poem_id": 87991,
    "vorder": 112,
    "position": 1,
    "text": "برفتند ترکان هم اندر زمان"
  },
  {
    "poem_id": 87991,
    "vorder": 113,
    "position": 0,
    "text": "چو هومان و لهاک و فرشیدورد"
  },
  {
    "poem_id": 87991,
    "vorder": 114,
    "position": 1,
    "text": "بزرگان و شیران روز نبرد"
  },
  {
    "poem_id": 87991,
    "vorder": 115,
    "position": 0,
    "text": "بگفتند کامد ز ایران سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 116,
    "position": 1,
    "text": "یکی پیش رو با درفشی سیاه"
  },
  {
    "poem_id": 87991,
    "vorder": 117,
    "position": 0,
    "text": "ز کارآگهان نامداری دمان"
  },
  {
    "poem_id": 87991,
    "vorder": 118,
    "position": 1,
    "text": "برفت و بیامد هم اندر زمان"
  },
  {
    "poem_id": 87991,
    "vorder": 119,
    "position": 0,
    "text": "فریبرز کاوس گفتند هست"
  },
  {
    "poem_id": 87991,
    "vorder": 120,
    "position": 1,
    "text": "سپاهی سرافراز و خسروپرست"
  },
  {
    "poem_id": 87991,
    "vorder": 121,
    "position": 0,
    "text": "چو رستم نباشد ازو باک نیست"
  },
  {
    "poem_id": 87991,
    "vorder": 122,
    "position": 1,
    "text": "دم او برین زهر تریاک نیست"
  },
  {
    "poem_id": 87991,
    "vorder": 123,
    "position": 0,
    "text": "ابا آنک کاموس روز نبرد"
  },
  {
    "poem_id": 87991,
    "vorder": 124,
    "position": 1,
    "text": "همی پیلتن را ندارد بمرد"
  },
  {
    "poem_id": 87991,
    "vorder": 125,
    "position": 0,
    "text": "مبادا که او آید ایدر بجنگ"
  },
  {
    "poem_id": 87991,
    "vorder": 126,
    "position": 1,
    "text": "وگر چند کاموس گردد نهنگ"
  },
  {
    "poem_id": 87991,
    "vorder": 127,
    "position": 0,
    "text": "نه رستم نه از سیستان لشکرست"
  },
  {
    "poem_id": 87991,
    "vorder": 128,
    "position": 1,
    "text": "فریبرز را خاک و خون ایدرست"
  },
  {
    "poem_id": 87991,
    "vorder": 129,
    "position": 0,
    "text": "چنین گفت پیران که از تخت و گاه"
  },
  {
    "poem_id": 87991,
    "vorder": 130,
    "position": 1,
    "text": "شدم سیر و بیزارم از هور و ماه"
  },
  {
    "poem_id": 87991,
    "vorder": 131,
    "position": 0,
    "text": "که چون من شنیدم کز ایران سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 132,
    "position": 1,
    "text": "خرامید و آمد بدین رزمگاه"
  },
  {
    "poem_id": 87991,
    "vorder": 133,
    "position": 0,
    "text": "بشد جان و مغز سرم پر ز درد"
  },
  {
    "poem_id": 87991,
    "vorder": 134,
    "position": 1,
    "text": "برآمد یکی از دلم باد سرد"
  },
  {
    "poem_id": 87991,
    "vorder": 135,
    "position": 0,
    "text": "بدو گفت کلباد کین درد چیست"
  },
  {
    "poem_id": 87991,
    "vorder": 136,
    "position": 1,
    "text": "چرا باید از طوس و رستم گریست"
  },
  {
    "poem_id": 87991,
    "vorder": 137,
    "position": 0,
    "text": "ز بس گرز و شمشیر و پیل و سپاه"
  },
  {
    "poem_id": 87991,
    "vorder": 138,
    "position": 1,
    "text": "میان اندرون باد را نیست راه"
  },
  {
    "poem_id": 87991,
    "vorder": 139,
    "position": 0,
    "text": "چه ایرانیان پیش ما در چه خاک"
  },
  {
    "poem_id": 87991,
    "vorder": 140,
    "position": 1,
    "text": "ز کیخسرو و طوس و رستم چه باک"
  },
  {
    "poem_id": 87991,
    "vorder": 141,
    "position": 0,
    "text": "پراگنده گشتند ازان جایگاه"
  },
  {
    "poem_id": 87991,
    "vorder": 142,
    "position": 1,
    "text": "سوی خیمهٔ خویش کردند راه"
  },
  {
    "poem_id": 87991,
    "vorder": 143,
    "position": 0,
    "text": "ازان پس چو آگاهی آمد به طوس"
  },
  {
    "poem_id": 87991,
    "vorder": 144,
    "position": 1,
    "text": "که شد روی کشور پر آوای کوس"
  },
  {
    "poem_id": 87991,
    "vorder": 145,
    "position": 0,
    "text": "از ایران بیامد گو پیلتن"
  },
  {
    "poem_id": 87991,
    "vorder": 146,
    "position": 1,
    "text": "فریبرز کاوس و آن انجمن"
  },
  {
    "poem_id": 87991,
    "vorder": 147,
    "position": 0,
    "text": "بفرمود تا برکشیدند کوس"
  },
  {
    "poem_id": 87991,
    "vorder": 148,
    "position": 1,
    "text": "ز گرد سپه کوه گشت آبنوس"
  },
  {
    "poem_id": 87991,
    "vorder": 149,
    "position": 0,
    "text": "ز کوه هماون برآمد خروش"
  },
  {
    "poem_id": 87991,
    "vorder": 150,
    "position": 1,
    "text": "زمین آمد از بانگ اسپان بجوش"
  },
  {
    "poem_id": 87991,
    "vorder": 151,
    "position": 0,
    "text": "سپهبد بریشان زبان برگشاد"
  },
  {
    "poem_id": 87991,
    "vorder": 152,
    "position": 1,
    "text": "ز مازندران کرد بسیار یاد"
  },
  {
    "poem_id": 87991,
    "vorder": 153,
    "position": 0,
    "text": "که با دیو در جنگ رستم چه کرد"
  },
  {
    "poem_id": 87991,
    "vorder": 154,
    "position": 1,
    "text": "بریشان چه آورد روز نبرد"
  },
  {
    "poem_id": 87991,
    "vorder": 155,
    "position": 0,
    "text": "سپاه آفرین خواند بر پهلوان"
  },
  {
    "poem_id": 87991,
    "vorder": 156,
    "position": 1,
    "text": "که بیدار دل باش و روشن‌روان"
  },
  {
    "poem_id": 87991,
    "vorder": 157,
    "position": 0,
    "text": "بدین مژده گر دیده‌خواهی رواست"
  },
  {
    "poem_id": 87991,
    "vorder": 158,
    "position": 1,
    "text": "که این مژده آرایش جان ماست"
  },
  {
    "poem_id": 87991,
    "vorder": 159,
    "position": 0,
    "text": "کنون چون تهمتن بیامد بجنگ"
  },
  {
    "poem_id": 87991,
    "vorder": 160,
    "position": 1,
    "text": "ندارند پا این سپه با نهنگ"
  },
  {
    "poem_id": 87991,
    "vorder": 161,
    "position": 0,
    "text": "یکایک بران گونه رزمی کنیم"
  },
  {
    "poem_id": 87991,
    "vorder": 162,
    "position": 1,
    "text": "که این ننگ از ایرانیان بفگنیم"
  },
  {
    "poem_id": 87991,
    "vorder": 163,
    "position": 0,
    "text": "درفش سرافراز خاقان و تاج"
  },
  {
    "poem_id": 87991,
    "vorder": 164,
    "position": 1,
    "text": "سپرهای زرین و آن تخت عاج"
  },
  {
    "poem_id": 87991,
    "vorder": 165,
    "position": 0,
    "text": "همان افسر پیلبانان بزر"
  },
  {
    "poem_id": 87991,
    "vorder": 166,
    "position": 1,
    "text": "سنانهای زرین و زرین کمر"
  },
  {
    "poem_id": 87991,
    "vorder": 167,
    "position": 0,
    "text": "همان زنگ زرین و زرین جرس"
  },
  {
    "poem_id": 87991,
    "vorder": 168,
    "position": 1,
    "text": "که اندر جهان آن ندیدست کس"
  },
  {
    "poem_id": 87991,
    "vorder": 169,
    "position": 0,
    "text": "همان چتر کز دم طاوس نر"
  },
  {
    "poem_id": 87991,
    "vorder": 170,
    "position": 1,
    "text": "برو بافتستند چندان گهر"
  },
  {
    "poem_id": 87991,
    "vorder": 171,
    "position": 0,
    "text": "جزین نیز چندی بچنگ آوریم"
  },
  {
    "poem_id": 87991,
    "vorder": 172,
    "position": 1,
    "text": "چو جان را بکوشیم و جنگ آوریم"
  },
  {
    "poem_id": 87991,
    "vorder": 173,
    "position": 0,
    "text": "بلشکر چنین گفت بیدار طوس"
  },
  {
    "poem_id": 87991,
    "vorder": 174,
    "position": 1,
    "text": "که هم با هراسیم و هم با فسوس"
  },
  {
    "poem_id": 87991,
    "vorder": 175,
    "position": 0,
    "text": "همه دامن کوه پر لشکرست"
  },
  {
    "poem_id": 87991,
    "vorder": 176,
    "position": 1,
    "text": "سر نامداران ببند اندرست"
  },
  {
    "poem_id": 87991,
    "vorder": 177,
    "position": 0,
    "text": "چو رستم بیاید نکوهش کند"
  },
  {
    "poem_id": 87991,
    "vorder": 178,
    "position": 1,
    "text": "مگر کین سخن را پژوهش کند"
  },
  {
    "poem_id": 87991,
    "vorder": 179,
    "position": 0,
    "text": "که چون مرغ پیچیده بودم بدام"
  },
  {
    "poem_id": 87991,
    "vorder": 180,
    "position": 1,
    "text": "همه کار ناکام و پیکار خام"
  },
  {
    "poem_id": 87991,
    "vorder": 181,
    "position": 0,
    "text": "سپهبد همان بود و لشکر همان"
  },
  {
    "poem_id": 87991,
    "vorder": 182,
    "position": 1,
    "text": "کسی را ندیدم ز گردان دمان"
  },
  {
    "poem_id": 87991,
    "vorder": 183,
    "position": 0,
    "text": "یکی حمله آریم چون شیر نر"
  },
  {
    "poem_id": 87991,
    "vorder": 184,
    "position": 1,
    "text": "شوند از بن که مگر زاستر"
  },
  {
    "poem_id": 87991,
    "vorder": 185,
    "position": 0,
    "text": "سپه گفت کین برتری خود مجوی"
  },
  {
    "poem_id": 87991,
    "vorder": 186,
    "position": 1,
    "text": "سخن زین نشان هیچ گونه مگوی"
  },
  {
    "poem_id": 87991,
    "vorder": 187,
    "position": 0,
    "text": "کزین کوه کس پیشتر نگذرد"
  },
  {
    "poem_id": 87991,
    "vorder": 188,
    "position": 1,
    "text": "مگر رستم این رزمگه بنگرد"
  },
  {
    "poem_id": 87991,
    "vorder": 189,
    "position": 0,
    "text": "بباشیم بر پیش یزدان بپای"
  },
  {
    "poem_id": 87991,
    "vorder": 190,
    "position": 1,
    "text": "که اویست بر نیکوی رهنمای"
  },
  {
    "poem_id": 87991,
    "vorder": 191,
    "position": 0,
    "text": "بفرمان دارندهٔ هور و ماه"
  },
  {
    "poem_id": 87991,
    "vorder": 192,
    "position": 1,
    "text": "تهمتن بیاید بدین رزمگاه"
  },
  {
    "poem_id": 87991,
    "vorder": 193,
    "position": 0,
    "text": "چه داری دژم اختر خویش را"
  },
  {
    "poem_id": 87991,
    "vorder": 194,
    "position": 1,
    "text": "درم بخش و دینار درویش را"
  },
  {
    "poem_id": 87991,
    "vorder": 195,
    "position": 0,
    "text": "بشادی ز گردان ایران گروه"
  },
  {
    "poem_id": 87991,
    "vorder": 196,
    "position": 1,
    "text": "خروشی برآمد ز بالای کوه"
  }
]