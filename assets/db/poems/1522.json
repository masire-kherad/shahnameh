[
  {
    "poem_id": 1522,
    "vorder": 1,
    "position": 0,
    "text": "به قیصر خزر بود نزدیکتر"
  },
  {
    "poem_id": 1522,
    "vorder": 2,
    "position": 1,
    "text": "وزیشان بدش روز تاریکتر"
  },
  {
    "poem_id": 1522,
    "vorder": 3,
    "position": 0,
    "text": "به مرز خزر مهتر الیاس بود"
  },
  {
    "poem_id": 1522,
    "vorder": 4,
    "position": 1,
    "text": "که پور جهاندار مهراس بود"
  },
  {
    "poem_id": 1522,
    "vorder": 5,
    "position": 0,
    "text": "به الیاس قیصر یکی نامه کرد"
  },
  {
    "poem_id": 1522,
    "vorder": 6,
    "position": 1,
    "text": "تو گفتی که خون بر سر خامه کرد"
  },
  {
    "poem_id": 1522,
    "vorder": 7,
    "position": 0,
    "text": "که چندین به افسوس خوردی خزر"
  },
  {
    "poem_id": 1522,
    "vorder": 8,
    "position": 1,
    "text": "کنون روز آسایش آمد بسر"
  },
  {
    "poem_id": 1522,
    "vorder": 9,
    "position": 0,
    "text": "اگر ساو و باژست و گنج گران"
  },
  {
    "poem_id": 1522,
    "vorder": 10,
    "position": 1,
    "text": "گروگان ازان مرز چندی سران"
  },
  {
    "poem_id": 1522,
    "vorder": 11,
    "position": 0,
    "text": "وگرنه فرخ‌زاد چون پیل مست"
  },
  {
    "poem_id": 1522,
    "vorder": 12,
    "position": 1,
    "text": "بیاید کند کشورت را چو دست"
  },
  {
    "poem_id": 1522,
    "vorder": 13,
    "position": 0,
    "text": "چو الیاس بر خواند آن نامه را"
  },
  {
    "poem_id": 1522,
    "vorder": 14,
    "position": 1,
    "text": "به زهر آب در زد سر خامه را"
  },
  {
    "poem_id": 1522,
    "vorder": 15,
    "position": 0,
    "text": "چنین داد پاسخ که چندین هنر"
  },
  {
    "poem_id": 1522,
    "vorder": 16,
    "position": 1,
    "text": "نبودی به روم اندرون سربسر"
  },
  {
    "poem_id": 1522,
    "vorder": 17,
    "position": 0,
    "text": "اگر من نخواهم همی باژ روم"
  },
  {
    "poem_id": 1522,
    "vorder": 18,
    "position": 1,
    "text": "شما شاد باشید زان مرز و بوم"
  },
  {
    "poem_id": 1522,
    "vorder": 19,
    "position": 0,
    "text": "چنین دل گرفتید از یک سوار"
  },
  {
    "poem_id": 1522,
    "vorder": 20,
    "position": 1,
    "text": "که نزد شما یافت او زینهار"
  },
  {
    "poem_id": 1522,
    "vorder": 21,
    "position": 0,
    "text": "چنان دان که او دام آهرمنست"
  },
  {
    "poem_id": 1522,
    "vorder": 22,
    "position": 1,
    "text": "و گر کوه آهن همان یکتنست"
  },
  {
    "poem_id": 1522,
    "vorder": 23,
    "position": 0,
    "text": "تو او را بدین جنگ رنجه مکن"
  },
  {
    "poem_id": 1522,
    "vorder": 24,
    "position": 1,
    "text": "که من بین درازی نمانم سخن"
  },
  {
    "poem_id": 1522,
    "vorder": 25,
    "position": 0,
    "text": "سخن چون به میرین و اهرن رسید"
  },
  {
    "poem_id": 1522,
    "vorder": 26,
    "position": 1,
    "text": "ز الیاس و آن دام کو گسترید"
  },
  {
    "poem_id": 1522,
    "vorder": 27,
    "position": 0,
    "text": "فرستاد میرین به قیصر پیام"
  },
  {
    "poem_id": 1522,
    "vorder": 28,
    "position": 1,
    "text": "که این اژدها نیست کاید به دام"
  },
  {
    "poem_id": 1522,
    "vorder": 29,
    "position": 0,
    "text": "نه گرگست کز چاره بیجان شود"
  },
  {
    "poem_id": 1522,
    "vorder": 30,
    "position": 1,
    "text": "ز آلودن زهر پیچان شود"
  },
  {
    "poem_id": 1522,
    "vorder": 31,
    "position": 0,
    "text": "چو الیاس در جنگ خشم آورد"
  },
  {
    "poem_id": 1522,
    "vorder": 32,
    "position": 1,
    "text": "جهانجوی را خون به چشم آورد"
  },
  {
    "poem_id": 1522,
    "vorder": 33,
    "position": 0,
    "text": "نگه کن کنون کاین سرافراز مرد"
  },
  {
    "poem_id": 1522,
    "vorder": 34,
    "position": 1,
    "text": "ازو چند پیچد به دشت نبرد"
  },
  {
    "poem_id": 1522,
    "vorder": 35,
    "position": 0,
    "text": "غمی گشت قیصر ز گفتارشان"
  },
  {
    "poem_id": 1522,
    "vorder": 36,
    "position": 1,
    "text": "چو بشنید زان گونه بازارشان"
  },
  {
    "poem_id": 1522,
    "vorder": 37,
    "position": 0,
    "text": "فرخ‌زاد را گفت پر مایه‌ای"
  },
  {
    "poem_id": 1522,
    "vorder": 38,
    "position": 1,
    "text": "همی روم را همچو پیرایه‌ای"
  },
  {
    "poem_id": 1522,
    "vorder": 39,
    "position": 0,
    "text": "چنان دان که الیاس شیراوژن است"
  },
  {
    "poem_id": 1522,
    "vorder": 40,
    "position": 1,
    "text": "چو اسپ افگند پیل رویین‌تن است"
  },
  {
    "poem_id": 1522,
    "vorder": 41,
    "position": 0,
    "text": "اگر تاب داری به جنگش بگوی"
  },
  {
    "poem_id": 1522,
    "vorder": 42,
    "position": 1,
    "text": "و گرنه مبر اندرین آب روی"
  },
  {
    "poem_id": 1522,
    "vorder": 43,
    "position": 0,
    "text": "اگر جنگ او را نداری تو پای"
  },
  {
    "poem_id": 1522,
    "vorder": 44,
    "position": 1,
    "text": "بسازیم با او یکی خوب رای"
  },
  {
    "poem_id": 1522,
    "vorder": 45,
    "position": 0,
    "text": "به خوبی ز ره بازگردانمش"
  },
  {
    "poem_id": 1522,
    "vorder": 46,
    "position": 1,
    "text": "سخن با هزینه برافشانمش"
  },
  {
    "poem_id": 1522,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت گشتاسپ کین جست و جوی"
  },
  {
    "poem_id": 1522,
    "vorder": 48,
    "position": 1,
    "text": "چرا باید و چیست این گفت و گوی"
  },
  {
    "poem_id": 1522,
    "vorder": 49,
    "position": 0,
    "text": "چو من باره اندر جهانم به خاک"
  },
  {
    "poem_id": 1522,
    "vorder": 50,
    "position": 1,
    "text": "ندارم ز مرز خزر هیچ باک"
  },
  {
    "poem_id": 1522,
    "vorder": 51,
    "position": 0,
    "text": "ولیکن نباید که روز نبرد"
  },
  {
    "poem_id": 1522,
    "vorder": 52,
    "position": 1,
    "text": "ز میرین و اهرن بود یاد کرد"
  },
  {
    "poem_id": 1522,
    "vorder": 53,
    "position": 0,
    "text": "که ایشان به رزم اندر از دشمنی"
  },
  {
    "poem_id": 1522,
    "vorder": 54,
    "position": 1,
    "text": "برآرند کژی و آهرمنی"
  },
  {
    "poem_id": 1522,
    "vorder": 55,
    "position": 0,
    "text": "چو لشکر بیاید ز مرز خزر"
  },
  {
    "poem_id": 1522,
    "vorder": 56,
    "position": 1,
    "text": "نگهبان من باش با یک پسر"
  },
  {
    "poem_id": 1522,
    "vorder": 57,
    "position": 0,
    "text": "به نیروی پیروزگر یک خدای"
  },
  {
    "poem_id": 1522,
    "vorder": 58,
    "position": 1,
    "text": "چو من با سپاه اندر آیم ز جای"
  },
  {
    "poem_id": 1522,
    "vorder": 59,
    "position": 0,
    "text": "نه الیاس مانم نه با او سپاه"
  },
  {
    "poem_id": 1522,
    "vorder": 60,
    "position": 1,
    "text": "نه چندن بزرگی و تخت و کلاه"
  },
  {
    "poem_id": 1522,
    "vorder": 61,
    "position": 0,
    "text": "کمربند گیرمش وز پشت زین"
  },
  {
    "poem_id": 1522,
    "vorder": 62,
    "position": 1,
    "text": "به ابر اندر آرم زنم بر زمین"
  },
  {
    "poem_id": 1522,
    "vorder": 63,
    "position": 0,
    "text": "دگر روز چون بردمید آفتاب"
  },
  {
    "poem_id": 1522,
    "vorder": 64,
    "position": 1,
    "text": "چو زرین سپر می‌نمود اندر آب"
  },
  {
    "poem_id": 1522,
    "vorder": 65,
    "position": 0,
    "text": "ز سوی خزر نای رویین بخاست"
  },
  {
    "poem_id": 1522,
    "vorder": 66,
    "position": 1,
    "text": "همی گرد بر شد سوی چرخ راست"
  },
  {
    "poem_id": 1522,
    "vorder": 67,
    "position": 0,
    "text": "سرافراز قیصر به گشتاسپ گفت"
  },
  {
    "poem_id": 1522,
    "vorder": 68,
    "position": 1,
    "text": "که اکنون جدا کن سپاه از نهفت"
  },
  {
    "poem_id": 1522,
    "vorder": 69,
    "position": 0,
    "text": "بگفت این و لشکر به بیرون کشید"
  },
  {
    "poem_id": 1522,
    "vorder": 70,
    "position": 1,
    "text": "گوان و یلان را به هامون کشید"
  },
  {
    "poem_id": 1522,
    "vorder": 71,
    "position": 0,
    "text": "همی گشت با گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1522,
    "vorder": 72,
    "position": 1,
    "text": "چو سرو بلند از بر کوهسار"
  },
  {
    "poem_id": 1522,
    "vorder": 73,
    "position": 0,
    "text": "همی جست بر دشت جای نبرد"
  },
  {
    "poem_id": 1522,
    "vorder": 74,
    "position": 1,
    "text": "ز هامون به ابر اندر آورد گرد"
  },
  {
    "poem_id": 1522,
    "vorder": 75,
    "position": 0,
    "text": "چو الیاس دید آن بر و یال اوی"
  },
  {
    "poem_id": 1522,
    "vorder": 76,
    "position": 1,
    "text": "چنان گردش چنگ و گوپال اوی"
  },
  {
    "poem_id": 1522,
    "vorder": 77,
    "position": 0,
    "text": "سواری فرستاد نزدیک اوی"
  },
  {
    "poem_id": 1522,
    "vorder": 78,
    "position": 1,
    "text": "که بفریبد ان رای تاریک اوی"
  },
  {
    "poem_id": 1522,
    "vorder": 79,
    "position": 0,
    "text": "بیامد بدو گفت کای سرفراز"
  },
  {
    "poem_id": 1522,
    "vorder": 80,
    "position": 1,
    "text": "ز قیصر بدین گونه سر کم فراز"
  },
  {
    "poem_id": 1522,
    "vorder": 81,
    "position": 0,
    "text": "کزین لشکر اکنون سوارش تویی"
  },
  {
    "poem_id": 1522,
    "vorder": 82,
    "position": 1,
    "text": "بهارش تویی نامدارش تویی"
  },
  {
    "poem_id": 1522,
    "vorder": 83,
    "position": 0,
    "text": "به یکسو گرای از میان دو صف"
  },
  {
    "poem_id": 1522,
    "vorder": 84,
    "position": 1,
    "text": "چه داری چنین بر لب آورده کف"
  },
  {
    "poem_id": 1522,
    "vorder": 85,
    "position": 0,
    "text": "که الیاس شیر است روز نبرد"
  },
  {
    "poem_id": 1522,
    "vorder": 86,
    "position": 1,
    "text": "پذیره درآید سبک‌تر ز گرد"
  },
  {
    "poem_id": 1522,
    "vorder": 87,
    "position": 0,
    "text": "اگر هدیه خواهی ورا گنج هست"
  },
  {
    "poem_id": 1522,
    "vorder": 88,
    "position": 1,
    "text": "مسای از پی چیز با رنج دست"
  },
  {
    "poem_id": 1522,
    "vorder": 89,
    "position": 0,
    "text": "ز گیتی گزین کن یکی بهره‌ای"
  },
  {
    "poem_id": 1522,
    "vorder": 90,
    "position": 1,
    "text": "تو باشی بران بهره در شهره‌ای"
  },
  {
    "poem_id": 1522,
    "vorder": 91,
    "position": 0,
    "text": "همت یار باشم همت کهترم"
  },
  {
    "poem_id": 1522,
    "vorder": 92,
    "position": 1,
    "text": "که هرگز ز پیمان تو نگذرم"
  },
  {
    "poem_id": 1522,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت گشتاسپ کاین سرد گشت"
  },
  {
    "poem_id": 1522,
    "vorder": 94,
    "position": 1,
    "text": "سخنها ز اندازه اندر گذشت"
  },
  {
    "poem_id": 1522,
    "vorder": 95,
    "position": 0,
    "text": "تو کردی بدین داوری دست پیش"
  },
  {
    "poem_id": 1522,
    "vorder": 96,
    "position": 1,
    "text": "کنون بازگشتی ز گفتار خویش"
  },
  {
    "poem_id": 1522,
    "vorder": 97,
    "position": 0,
    "text": "سخن گفتن اکنون نیاید به کار"
  },
  {
    "poem_id": 1522,
    "vorder": 98,
    "position": 1,
    "text": "گه جنگ و آویزش کارزار"
  },
  {
    "poem_id": 1522,
    "vorder": 99,
    "position": 0,
    "text": "فرستاده برگشت و آمد چو باد"
  },
  {
    "poem_id": 1522,
    "vorder": 100,
    "position": 1,
    "text": "همی کرد پاسخ به الیاس یاد"
  }
]