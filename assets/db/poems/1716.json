[
  {
    "poem_id": 1716,
    "vorder": 1,
    "position": 0,
    "text": "کنون از خردمندی اردشیر"
  },
  {
    "poem_id": 1716,
    "vorder": 2,
    "position": 1,
    "text": "سخن بشنو و یک به یک یادگیر"
  },
  {
    "poem_id": 1716,
    "vorder": 3,
    "position": 0,
    "text": "بکوشید و آیین نیکو نهاد"
  },
  {
    "poem_id": 1716,
    "vorder": 4,
    "position": 1,
    "text": "بگسترد بر هر سوی مهر و داد"
  },
  {
    "poem_id": 1716,
    "vorder": 5,
    "position": 0,
    "text": "به درگاه چون خواست لشکر فزون"
  },
  {
    "poem_id": 1716,
    "vorder": 6,
    "position": 1,
    "text": "فرستاد بر هر سوی رهنمون"
  },
  {
    "poem_id": 1716,
    "vorder": 7,
    "position": 0,
    "text": "که تا هرکسی را که دارد پسر"
  },
  {
    "poem_id": 1716,
    "vorder": 8,
    "position": 1,
    "text": "نماند که بالا کند بی‌هنر"
  },
  {
    "poem_id": 1716,
    "vorder": 9,
    "position": 0,
    "text": "سواری بیاموزد و رسم جنگ"
  },
  {
    "poem_id": 1716,
    "vorder": 10,
    "position": 1,
    "text": "به گرز و کمان و به تیر خدنگ"
  },
  {
    "poem_id": 1716,
    "vorder": 11,
    "position": 0,
    "text": "چو کودک ز کوشش به مردی شدی"
  },
  {
    "poem_id": 1716,
    "vorder": 12,
    "position": 1,
    "text": "بهر بخششی در بی آهو بدی"
  },
  {
    "poem_id": 1716,
    "vorder": 13,
    "position": 0,
    "text": "ز کشور به درگاه شاه آمدند"
  },
  {
    "poem_id": 1716,
    "vorder": 14,
    "position": 1,
    "text": "بدان نامور بارگاه آمدند"
  },
  {
    "poem_id": 1716,
    "vorder": 15,
    "position": 0,
    "text": "نوشتی عرض نام دیوان اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 16,
    "position": 1,
    "text": "بیاراستی کاخ و ایوان اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 17,
    "position": 0,
    "text": "چو جنگ آمدی نورسیده جوان"
  },
  {
    "poem_id": 1716,
    "vorder": 18,
    "position": 1,
    "text": "برفتی ز درگاه با پهلوان"
  },
  {
    "poem_id": 1716,
    "vorder": 19,
    "position": 0,
    "text": "یکی موبدان را ز کارآگهان"
  },
  {
    "poem_id": 1716,
    "vorder": 20,
    "position": 1,
    "text": "که بودی خریدار کار جهان"
  },
  {
    "poem_id": 1716,
    "vorder": 21,
    "position": 0,
    "text": "ابر هر هزاری یکی کارجوی"
  },
  {
    "poem_id": 1716,
    "vorder": 22,
    "position": 1,
    "text": "برفتی نگه داشتی کار اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 23,
    "position": 0,
    "text": "هرانکس که در جنگ سست آمدی"
  },
  {
    "poem_id": 1716,
    "vorder": 24,
    "position": 1,
    "text": "به آورد ناتن‌درست آمدی"
  },
  {
    "poem_id": 1716,
    "vorder": 25,
    "position": 0,
    "text": "شهنشاه را نامه کردی بران"
  },
  {
    "poem_id": 1716,
    "vorder": 26,
    "position": 1,
    "text": "هم از بی‌هنر هم ز جنگ‌آوران"
  },
  {
    "poem_id": 1716,
    "vorder": 27,
    "position": 0,
    "text": "جهاندار چون نامه برخواندی"
  },
  {
    "poem_id": 1716,
    "vorder": 28,
    "position": 1,
    "text": "فرستاده را پیش بنشاندی"
  },
  {
    "poem_id": 1716,
    "vorder": 29,
    "position": 0,
    "text": "هنرمند را خلعت آراستی"
  },
  {
    "poem_id": 1716,
    "vorder": 30,
    "position": 1,
    "text": "ز گنج آنچ پرمایه‌تر خواستی"
  },
  {
    "poem_id": 1716,
    "vorder": 31,
    "position": 0,
    "text": "چو کردی نگاه اندران بی‌هنر"
  },
  {
    "poem_id": 1716,
    "vorder": 32,
    "position": 1,
    "text": "نبستی میان جنگ را بیشتر"
  },
  {
    "poem_id": 1716,
    "vorder": 33,
    "position": 0,
    "text": "چنین تا سپاهش بدانجا رسید"
  },
  {
    "poem_id": 1716,
    "vorder": 34,
    "position": 1,
    "text": "که پهنای ایشان ستاره ندید"
  },
  {
    "poem_id": 1716,
    "vorder": 35,
    "position": 0,
    "text": "ازیشان کسی را که بد رای‌زن"
  },
  {
    "poem_id": 1716,
    "vorder": 36,
    "position": 1,
    "text": "برافراختندی سرش ز انجمن"
  },
  {
    "poem_id": 1716,
    "vorder": 37,
    "position": 0,
    "text": "که هرکس که خشنودی شاه جست"
  },
  {
    "poem_id": 1716,
    "vorder": 38,
    "position": 1,
    "text": "زمین را به خوان دلیران بشست"
  },
  {
    "poem_id": 1716,
    "vorder": 39,
    "position": 0,
    "text": "بیابد ز من خلعت شهریار"
  },
  {
    "poem_id": 1716,
    "vorder": 40,
    "position": 1,
    "text": "بود در جهان نام او یادگار"
  },
  {
    "poem_id": 1716,
    "vorder": 41,
    "position": 0,
    "text": "به لشکر بیاراست گیتی همه"
  },
  {
    "poem_id": 1716,
    "vorder": 42,
    "position": 1,
    "text": "شبان گشت و پرخاش‌جویان رمه"
  },
  {
    "poem_id": 1716,
    "vorder": 43,
    "position": 0,
    "text": "به دیوانش کارآگهان داشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 44,
    "position": 1,
    "text": "به بی‌دانشی کار نگذاشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 45,
    "position": 0,
    "text": "بلاغت نگه داشتندی و خط"
  },
  {
    "poem_id": 1716,
    "vorder": 46,
    "position": 1,
    "text": "کسی کو بدی چیره بر یک نقط"
  },
  {
    "poem_id": 1716,
    "vorder": 47,
    "position": 0,
    "text": "چو برداشتی آن سخن رهنمون"
  },
  {
    "poem_id": 1716,
    "vorder": 48,
    "position": 1,
    "text": "شهنشاه کردیش روزی فزون"
  },
  {
    "poem_id": 1716,
    "vorder": 49,
    "position": 0,
    "text": "کسی را که کمتر بدی خط و ویر"
  },
  {
    "poem_id": 1716,
    "vorder": 50,
    "position": 1,
    "text": "نرفتی به دیوان شاه اردشیر"
  },
  {
    "poem_id": 1716,
    "vorder": 51,
    "position": 0,
    "text": "سوی کارداران شدندی به کار"
  },
  {
    "poem_id": 1716,
    "vorder": 52,
    "position": 1,
    "text": "قلم‌زن بماندی بر شهریار"
  },
  {
    "poem_id": 1716,
    "vorder": 53,
    "position": 0,
    "text": "شناسنده بد شهریار اردشیر"
  },
  {
    "poem_id": 1716,
    "vorder": 54,
    "position": 1,
    "text": "چو دیدی به درگاه مرد دبیر"
  },
  {
    "poem_id": 1716,
    "vorder": 55,
    "position": 0,
    "text": "نویسنده گفتی که گنج آگنید"
  },
  {
    "poem_id": 1716,
    "vorder": 56,
    "position": 1,
    "text": "هم از رای او رنج بپراگنید"
  },
  {
    "poem_id": 1716,
    "vorder": 57,
    "position": 0,
    "text": "بدو باشد آباد شهر و سپاه"
  },
  {
    "poem_id": 1716,
    "vorder": 58,
    "position": 1,
    "text": "همان زیردستان فریادخواه"
  },
  {
    "poem_id": 1716,
    "vorder": 59,
    "position": 0,
    "text": "دبیران چو پیوند جان منند"
  },
  {
    "poem_id": 1716,
    "vorder": 60,
    "position": 1,
    "text": "همه پادشا بر نهان منند"
  },
  {
    "poem_id": 1716,
    "vorder": 61,
    "position": 0,
    "text": "چو رفتی سوی کشور کاردار"
  },
  {
    "poem_id": 1716,
    "vorder": 62,
    "position": 1,
    "text": "بدو شاه گفتی درم خوار دار"
  },
  {
    "poem_id": 1716,
    "vorder": 63,
    "position": 0,
    "text": "نباید که مردم فروشی به گنج"
  },
  {
    "poem_id": 1716,
    "vorder": 64,
    "position": 1,
    "text": "که برکس نماند سرای سپنج"
  },
  {
    "poem_id": 1716,
    "vorder": 65,
    "position": 0,
    "text": "همه راستی جوی و فرزانگی"
  },
  {
    "poem_id": 1716,
    "vorder": 66,
    "position": 1,
    "text": "ز تو دور باد آز و دیوانگی"
  },
  {
    "poem_id": 1716,
    "vorder": 67,
    "position": 0,
    "text": "ز پیوند و خویشان مبر هیچ‌کس"
  },
  {
    "poem_id": 1716,
    "vorder": 68,
    "position": 1,
    "text": "سپاه آنچ من یار دادمت بس"
  },
  {
    "poem_id": 1716,
    "vorder": 69,
    "position": 0,
    "text": "درم بخش هر ماه درویش را"
  },
  {
    "poem_id": 1716,
    "vorder": 70,
    "position": 1,
    "text": "مده چیز مرد بداندیش را"
  },
  {
    "poem_id": 1716,
    "vorder": 71,
    "position": 0,
    "text": "اگر کشور آباد داری به داد"
  },
  {
    "poem_id": 1716,
    "vorder": 72,
    "position": 1,
    "text": "بمانی تو آباد وز داد شاد"
  },
  {
    "poem_id": 1716,
    "vorder": 73,
    "position": 0,
    "text": "و گر هیچ درویش خسپد به بیم"
  },
  {
    "poem_id": 1716,
    "vorder": 74,
    "position": 1,
    "text": "همی جان فروشی به زر و به سیم"
  },
  {
    "poem_id": 1716,
    "vorder": 75,
    "position": 0,
    "text": "هرانکس که رفتی به درگاه شاه"
  },
  {
    "poem_id": 1716,
    "vorder": 76,
    "position": 1,
    "text": "به شایسته کاری و گر دادخواه"
  },
  {
    "poem_id": 1716,
    "vorder": 77,
    "position": 0,
    "text": "بدندی به سر استواران اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 78,
    "position": 1,
    "text": "بپرسیدن از کارداران اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 79,
    "position": 0,
    "text": "که دادست ازیشان و بگرفت چیز"
  },
  {
    "poem_id": 1716,
    "vorder": 80,
    "position": 1,
    "text": "وزیشان که خسپد به تیمار نیز"
  },
  {
    "poem_id": 1716,
    "vorder": 81,
    "position": 0,
    "text": "دگر آنک در شهر دانا که‌اند"
  },
  {
    "poem_id": 1716,
    "vorder": 82,
    "position": 1,
    "text": "گر از نیستی ناتوانا که‌اند"
  },
  {
    "poem_id": 1716,
    "vorder": 83,
    "position": 0,
    "text": "دگر کیست آنک از در پادشاست"
  },
  {
    "poem_id": 1716,
    "vorder": 84,
    "position": 1,
    "text": "جهاندیده پیرست و گر پارساست"
  },
  {
    "poem_id": 1716,
    "vorder": 85,
    "position": 0,
    "text": "شهنشاه گوید که از رنج من"
  },
  {
    "poem_id": 1716,
    "vorder": 86,
    "position": 1,
    "text": "مبادا کسی شاد بی‌گنج من"
  },
  {
    "poem_id": 1716,
    "vorder": 87,
    "position": 0,
    "text": "مگر مرد با دانش و یادگیر"
  },
  {
    "poem_id": 1716,
    "vorder": 88,
    "position": 1,
    "text": "چه نیکوتر از مرد دانا و پیر"
  },
  {
    "poem_id": 1716,
    "vorder": 89,
    "position": 0,
    "text": "جهاندیدگان را همه خواستار"
  },
  {
    "poem_id": 1716,
    "vorder": 90,
    "position": 1,
    "text": "جوان و پسندیده و بردبار"
  },
  {
    "poem_id": 1716,
    "vorder": 91,
    "position": 0,
    "text": "جوانان دانا و دانش‌پذیر"
  },
  {
    "poem_id": 1716,
    "vorder": 92,
    "position": 1,
    "text": "سزد گر نشینند بر جای پیر"
  },
  {
    "poem_id": 1716,
    "vorder": 93,
    "position": 0,
    "text": "چو لشکرش رفتی به جایی به جنگ"
  },
  {
    "poem_id": 1716,
    "vorder": 94,
    "position": 1,
    "text": "خرد یار کردی و رای و درنگ"
  },
  {
    "poem_id": 1716,
    "vorder": 95,
    "position": 0,
    "text": "فرستاده‌ای برگزیدی دبیر"
  },
  {
    "poem_id": 1716,
    "vorder": 96,
    "position": 1,
    "text": "خردمند و با دانش و یادگیر"
  },
  {
    "poem_id": 1716,
    "vorder": 97,
    "position": 0,
    "text": "پیامی به دادی به آیین و چرب"
  },
  {
    "poem_id": 1716,
    "vorder": 98,
    "position": 1,
    "text": "بدان تا نباشد به بیداد حرب"
  },
  {
    "poem_id": 1716,
    "vorder": 99,
    "position": 0,
    "text": "فرستاده رفتی بر دشمنش"
  },
  {
    "poem_id": 1716,
    "vorder": 100,
    "position": 1,
    "text": "که بشناختی راز پیراهنش"
  },
  {
    "poem_id": 1716,
    "vorder": 101,
    "position": 0,
    "text": "شنیدی سخن گر خرد داشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 102,
    "position": 1,
    "text": "غم و رنج بد را به بد داشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 103,
    "position": 0,
    "text": "بدان یافت او خلعت شهریار"
  },
  {
    "poem_id": 1716,
    "vorder": 104,
    "position": 1,
    "text": "همان عهد و منشور با گوشوار"
  },
  {
    "poem_id": 1716,
    "vorder": 105,
    "position": 0,
    "text": "وگر تاب بودی به سرش اندرون"
  },
  {
    "poem_id": 1716,
    "vorder": 106,
    "position": 1,
    "text": "به دل کین و اندر جگر جوش خون"
  },
  {
    "poem_id": 1716,
    "vorder": 107,
    "position": 0,
    "text": "سپه را بدادی سراسر درم"
  },
  {
    "poem_id": 1716,
    "vorder": 108,
    "position": 1,
    "text": "بدان تا نباشند یک تن دژم"
  },
  {
    "poem_id": 1716,
    "vorder": 109,
    "position": 0,
    "text": "یکی پهلوان خواستی نامجوی"
  },
  {
    "poem_id": 1716,
    "vorder": 110,
    "position": 1,
    "text": "خردمند و بیدار و آرامجوی"
  },
  {
    "poem_id": 1716,
    "vorder": 111,
    "position": 0,
    "text": "دبیری به آیین و با دستگاه"
  },
  {
    "poem_id": 1716,
    "vorder": 112,
    "position": 1,
    "text": "که دارد ز بیداد لشکر نگاه"
  },
  {
    "poem_id": 1716,
    "vorder": 113,
    "position": 0,
    "text": "وزان پس یکی مرد بر پشت پیل"
  },
  {
    "poem_id": 1716,
    "vorder": 114,
    "position": 1,
    "text": "نشستی که رفتی خروشش دو میل"
  },
  {
    "poem_id": 1716,
    "vorder": 115,
    "position": 0,
    "text": "زدی بانگ کای نامداران جنگ"
  },
  {
    "poem_id": 1716,
    "vorder": 116,
    "position": 1,
    "text": "هرانکس که دارد دل و نام و ننگ"
  },
  {
    "poem_id": 1716,
    "vorder": 117,
    "position": 0,
    "text": "نباید که بر هیچ درویش رنج"
  },
  {
    "poem_id": 1716,
    "vorder": 118,
    "position": 1,
    "text": "رسد گر بر آنکس بود نام و گنج"
  },
  {
    "poem_id": 1716,
    "vorder": 119,
    "position": 0,
    "text": "به هر منزلی در خورید و دهید"
  },
  {
    "poem_id": 1716,
    "vorder": 120,
    "position": 1,
    "text": "بران زیردستان سپاسی نهید"
  },
  {
    "poem_id": 1716,
    "vorder": 121,
    "position": 0,
    "text": "به چیز کسان کس میازید دست"
  },
  {
    "poem_id": 1716,
    "vorder": 122,
    "position": 1,
    "text": "هرانکس که او هست یزدان‌پرست"
  },
  {
    "poem_id": 1716,
    "vorder": 123,
    "position": 0,
    "text": "به دشمن هرانکس که بنمود پشت"
  },
  {
    "poem_id": 1716,
    "vorder": 124,
    "position": 1,
    "text": "شود زان سپس روزگارش درشت"
  },
  {
    "poem_id": 1716,
    "vorder": 125,
    "position": 0,
    "text": "اگر دخمه باشد به چنگال اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 126,
    "position": 1,
    "text": "وگر بند ساید بر و یال اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 127,
    "position": 0,
    "text": "ز دیوان دگر نام او کرده پاک"
  },
  {
    "poem_id": 1716,
    "vorder": 128,
    "position": 1,
    "text": "خورش خاک و رفتنش بر تیره خاک"
  },
  {
    "poem_id": 1716,
    "vorder": 129,
    "position": 0,
    "text": "به سالار گفتی که سستی مکن"
  },
  {
    "poem_id": 1716,
    "vorder": 130,
    "position": 1,
    "text": "همان تیز و پیش دستی مکن"
  },
  {
    "poem_id": 1716,
    "vorder": 131,
    "position": 0,
    "text": "همیشه به پیش سپه دار پیل"
  },
  {
    "poem_id": 1716,
    "vorder": 132,
    "position": 1,
    "text": "طلایه پراگنده بر چار میل"
  },
  {
    "poem_id": 1716,
    "vorder": 133,
    "position": 0,
    "text": "نخستین یکی گرد لشکر به گرد"
  },
  {
    "poem_id": 1716,
    "vorder": 134,
    "position": 1,
    "text": "چو پیش آیدت روز ننگ و نبرد"
  },
  {
    "poem_id": 1716,
    "vorder": 135,
    "position": 0,
    "text": "به لشکر چنین گوی کاین خود کیند"
  },
  {
    "poem_id": 1716,
    "vorder": 136,
    "position": 1,
    "text": "بدین رزمگاه اندرون برچیند"
  },
  {
    "poem_id": 1716,
    "vorder": 137,
    "position": 0,
    "text": "از ایشان صد اسپ افگن از ما یکی"
  },
  {
    "poem_id": 1716,
    "vorder": 138,
    "position": 1,
    "text": "همان صد به پیش یکی اندکی"
  },
  {
    "poem_id": 1716,
    "vorder": 139,
    "position": 0,
    "text": "شما را همه پاک برنا و پیر"
  },
  {
    "poem_id": 1716,
    "vorder": 140,
    "position": 1,
    "text": "ستانم همه خلعت از اردشیر"
  },
  {
    "poem_id": 1716,
    "vorder": 141,
    "position": 0,
    "text": "چو اسپ افگند لشکر از هر دو روی"
  },
  {
    "poem_id": 1716,
    "vorder": 142,
    "position": 1,
    "text": "نباید که گردان پرخاشجوی"
  },
  {
    "poem_id": 1716,
    "vorder": 143,
    "position": 0,
    "text": "بیاید که ماند تهی قلب گاه"
  },
  {
    "poem_id": 1716,
    "vorder": 144,
    "position": 1,
    "text": "وگر چند بسیار باشد سپاه"
  },
  {
    "poem_id": 1716,
    "vorder": 145,
    "position": 0,
    "text": "چنان کن که با میمنه میسره"
  },
  {
    "poem_id": 1716,
    "vorder": 146,
    "position": 1,
    "text": "بکوشند جنگ‌آوران یکسره"
  },
  {
    "poem_id": 1716,
    "vorder": 147,
    "position": 0,
    "text": "همان نیز با میسره میمنه"
  },
  {
    "poem_id": 1716,
    "vorder": 148,
    "position": 1,
    "text": "بکوشند و دلها همه بر بنه"
  },
  {
    "poem_id": 1716,
    "vorder": 149,
    "position": 0,
    "text": "بود لشکر قلب بر جای خویش"
  },
  {
    "poem_id": 1716,
    "vorder": 150,
    "position": 1,
    "text": "کس از قلبگه نگسلد پای خویش"
  },
  {
    "poem_id": 1716,
    "vorder": 151,
    "position": 0,
    "text": "وگر قلب ایشان بجنبد ز جای"
  },
  {
    "poem_id": 1716,
    "vorder": 152,
    "position": 1,
    "text": "تو با لشکر از قلب‌گاه اندر آی"
  },
  {
    "poem_id": 1716,
    "vorder": 153,
    "position": 0,
    "text": "چو پیروز گردی ز کس خون مریز"
  },
  {
    "poem_id": 1716,
    "vorder": 154,
    "position": 1,
    "text": "که شد دشمن بدکنش در گریز"
  },
  {
    "poem_id": 1716,
    "vorder": 155,
    "position": 0,
    "text": "چو خواهد ز دشمن کسی زینهار"
  },
  {
    "poem_id": 1716,
    "vorder": 156,
    "position": 1,
    "text": "تو زنهارده باش و کینه مدار"
  },
  {
    "poem_id": 1716,
    "vorder": 157,
    "position": 0,
    "text": "چو تو پشت دشمن ببینی به چیز"
  },
  {
    "poem_id": 1716,
    "vorder": 158,
    "position": 1,
    "text": "مپرداز و مگذر هم از جای نیز"
  },
  {
    "poem_id": 1716,
    "vorder": 159,
    "position": 0,
    "text": "نباید که ایمن شوید از کمین"
  },
  {
    "poem_id": 1716,
    "vorder": 160,
    "position": 1,
    "text": "سپه باشد اندر در و دشت کین"
  },
  {
    "poem_id": 1716,
    "vorder": 161,
    "position": 0,
    "text": "هرآنگه که از دشمن ایمن شوی"
  },
  {
    "poem_id": 1716,
    "vorder": 162,
    "position": 1,
    "text": "سخن گفتن کس همی نشنوی"
  },
  {
    "poem_id": 1716,
    "vorder": 163,
    "position": 0,
    "text": "غنیمت بدان بخش کو جنگ جست"
  },
  {
    "poem_id": 1716,
    "vorder": 164,
    "position": 1,
    "text": "به مردی دل از جان شیرین بشست"
  },
  {
    "poem_id": 1716,
    "vorder": 165,
    "position": 0,
    "text": "هرانکس که گردد به دستت اسیر"
  },
  {
    "poem_id": 1716,
    "vorder": 166,
    "position": 1,
    "text": "بدین بارگاه آورش ناگزیر"
  },
  {
    "poem_id": 1716,
    "vorder": 167,
    "position": 0,
    "text": "من از بهر ایشان یکی شارستان"
  },
  {
    "poem_id": 1716,
    "vorder": 168,
    "position": 1,
    "text": "برآرم به بومی که بد خارستان"
  },
  {
    "poem_id": 1716,
    "vorder": 169,
    "position": 0,
    "text": "ازین پندها هیچ گونه مگرد"
  },
  {
    "poem_id": 1716,
    "vorder": 170,
    "position": 1,
    "text": "چو خواهی که مانی تو بی‌رنج و درد"
  },
  {
    "poem_id": 1716,
    "vorder": 171,
    "position": 0,
    "text": "به پیروزی اندر به یزدان گرای"
  },
  {
    "poem_id": 1716,
    "vorder": 172,
    "position": 1,
    "text": "که او باشدت بی‌گمان رهنمای"
  },
  {
    "poem_id": 1716,
    "vorder": 173,
    "position": 0,
    "text": "ز جایی که آمد فرستاده‌ای"
  },
  {
    "poem_id": 1716,
    "vorder": 174,
    "position": 1,
    "text": "ز ترکی و رومی و آزاده‌ای"
  },
  {
    "poem_id": 1716,
    "vorder": 175,
    "position": 0,
    "text": "ازو مرزبان آگهی داشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 176,
    "position": 1,
    "text": "چنین کارها خوار نگذاشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 177,
    "position": 0,
    "text": "بره بر بدی خان او ساخته"
  },
  {
    "poem_id": 1716,
    "vorder": 178,
    "position": 1,
    "text": "کنارنگ زان کار پرداخته"
  },
  {
    "poem_id": 1716,
    "vorder": 179,
    "position": 0,
    "text": "ز پوشیدنیها و از خوردنی"
  },
  {
    "poem_id": 1716,
    "vorder": 180,
    "position": 1,
    "text": "نیازش نبودی به گستردنی"
  },
  {
    "poem_id": 1716,
    "vorder": 181,
    "position": 0,
    "text": "چو آگه شدی زان سخن کاردار"
  },
  {
    "poem_id": 1716,
    "vorder": 182,
    "position": 1,
    "text": "که او بر چه آمد بر شهریار"
  },
  {
    "poem_id": 1716,
    "vorder": 183,
    "position": 0,
    "text": "هیونی سرافراز و مردی دبیر"
  },
  {
    "poem_id": 1716,
    "vorder": 184,
    "position": 1,
    "text": "برفتی به نزدیک شاه اردشیر"
  },
  {
    "poem_id": 1716,
    "vorder": 185,
    "position": 0,
    "text": "بدان تا پذیره شدندی سپاه"
  },
  {
    "poem_id": 1716,
    "vorder": 186,
    "position": 1,
    "text": "بیاراستی تخت پیروز شاه"
  },
  {
    "poem_id": 1716,
    "vorder": 187,
    "position": 0,
    "text": "کشیدی پرستنده هر سو رده"
  },
  {
    "poem_id": 1716,
    "vorder": 188,
    "position": 1,
    "text": "همه جامه‌هاشان به زر آژده"
  },
  {
    "poem_id": 1716,
    "vorder": 189,
    "position": 0,
    "text": "فرستاده را پیش خود خواندی"
  },
  {
    "poem_id": 1716,
    "vorder": 190,
    "position": 1,
    "text": "به نزدیکی تخت بنشاندی"
  },
  {
    "poem_id": 1716,
    "vorder": 191,
    "position": 0,
    "text": "به پرسش گرفتی همه راز اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 192,
    "position": 1,
    "text": "ز نیک و بد و نام و آواز اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 193,
    "position": 0,
    "text": "ز داد و ز بیداد وز کشورش"
  },
  {
    "poem_id": 1716,
    "vorder": 194,
    "position": 1,
    "text": "ز آیین وز شاه وز لشکرش"
  },
  {
    "poem_id": 1716,
    "vorder": 195,
    "position": 0,
    "text": "به ایوانش بردی فرستاده‌وار"
  },
  {
    "poem_id": 1716,
    "vorder": 196,
    "position": 1,
    "text": "بیاراستی هرچ بودی به کار"
  },
  {
    "poem_id": 1716,
    "vorder": 197,
    "position": 0,
    "text": "وزان پس به خوان و میش خواندی"
  },
  {
    "poem_id": 1716,
    "vorder": 198,
    "position": 1,
    "text": "بر تخت زرینش بنشاندی"
  },
  {
    "poem_id": 1716,
    "vorder": 199,
    "position": 0,
    "text": "به نخچیر بردیش با خویشتن"
  },
  {
    "poem_id": 1716,
    "vorder": 200,
    "position": 1,
    "text": "شدی لشکر بیشمار انجمن"
  },
  {
    "poem_id": 1716,
    "vorder": 201,
    "position": 0,
    "text": "کسی کردنش را فرستاده‌وار"
  },
  {
    "poem_id": 1716,
    "vorder": 202,
    "position": 1,
    "text": "بیاراستی خلعت شهریار"
  },
  {
    "poem_id": 1716,
    "vorder": 203,
    "position": 0,
    "text": "به هر سو فرستاد پس موبدان"
  },
  {
    "poem_id": 1716,
    "vorder": 204,
    "position": 1,
    "text": "بی‌آزار و بیداردل بخردان"
  },
  {
    "poem_id": 1716,
    "vorder": 205,
    "position": 0,
    "text": "که تا هر سوی شهرها ساختند"
  },
  {
    "poem_id": 1716,
    "vorder": 206,
    "position": 1,
    "text": "بدین نیز گنجی بپرداختند"
  },
  {
    "poem_id": 1716,
    "vorder": 207,
    "position": 0,
    "text": "بدان تا کسی را که بی‌خانه بود"
  },
  {
    "poem_id": 1716,
    "vorder": 208,
    "position": 1,
    "text": "نبودش نوا بخت بیگانه بود"
  },
  {
    "poem_id": 1716,
    "vorder": 209,
    "position": 0,
    "text": "همان تا فراوان شود زیردست"
  },
  {
    "poem_id": 1716,
    "vorder": 210,
    "position": 1,
    "text": "خورش ساخت با جایگاه نشست"
  },
  {
    "poem_id": 1716,
    "vorder": 211,
    "position": 0,
    "text": "ازو نام نیکی بود در جهان"
  },
  {
    "poem_id": 1716,
    "vorder": 212,
    "position": 1,
    "text": "چه بر آشکار و چه اندر نهان"
  },
  {
    "poem_id": 1716,
    "vorder": 213,
    "position": 0,
    "text": "چو او در جهان شهریاری نبود"
  },
  {
    "poem_id": 1716,
    "vorder": 214,
    "position": 1,
    "text": "پس از مرگ او یادگاری نبود"
  },
  {
    "poem_id": 1716,
    "vorder": 215,
    "position": 0,
    "text": "منم ویژه زنده کن نام اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 216,
    "position": 1,
    "text": "مبادا جز از نیکی انجام اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 217,
    "position": 0,
    "text": "فراوان سخن در نهان داشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 218,
    "position": 1,
    "text": "به هر جای کارآگهان داشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 219,
    "position": 0,
    "text": "چو بی‌مایه گشتی یکی مایه‌دار"
  },
  {
    "poem_id": 1716,
    "vorder": 220,
    "position": 1,
    "text": "ازان آگهی یافتی شهریار"
  },
  {
    "poem_id": 1716,
    "vorder": 221,
    "position": 0,
    "text": "چو بایست برساختی کار اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 222,
    "position": 1,
    "text": "نماندی چنان تیره بازار اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 223,
    "position": 0,
    "text": "زمین برومند و جای نشست"
  },
  {
    "poem_id": 1716,
    "vorder": 224,
    "position": 1,
    "text": "پرستیدن مردم زیردست"
  },
  {
    "poem_id": 1716,
    "vorder": 225,
    "position": 0,
    "text": "بیاراستی چون ببایست کار"
  },
  {
    "poem_id": 1716,
    "vorder": 226,
    "position": 1,
    "text": "نگشتی نهانش به کس آشکار"
  },
  {
    "poem_id": 1716,
    "vorder": 227,
    "position": 0,
    "text": "تهی‌دست را مایه دادی بسی"
  },
  {
    "poem_id": 1716,
    "vorder": 228,
    "position": 1,
    "text": "بدو شاد کردی دل هرکسی"
  },
  {
    "poem_id": 1716,
    "vorder": 229,
    "position": 0,
    "text": "همان کودکان را به فرهنگیان"
  },
  {
    "poem_id": 1716,
    "vorder": 230,
    "position": 1,
    "text": "سپردی چو بودی ورا هنگ آن"
  },
  {
    "poem_id": 1716,
    "vorder": 231,
    "position": 0,
    "text": "به هر برزنی در دبستان بدی"
  },
  {
    "poem_id": 1716,
    "vorder": 232,
    "position": 1,
    "text": "همان جای آتش‌پرستان بدی"
  },
  {
    "poem_id": 1716,
    "vorder": 233,
    "position": 0,
    "text": "نماندی که بودی کسی را نیاز"
  },
  {
    "poem_id": 1716,
    "vorder": 234,
    "position": 1,
    "text": "نگه داشتی سختی خویش راز"
  },
  {
    "poem_id": 1716,
    "vorder": 235,
    "position": 0,
    "text": "به میدان شدی بامداد پگاه"
  },
  {
    "poem_id": 1716,
    "vorder": 236,
    "position": 1,
    "text": "برفتی کسی کو بدی دادخواه"
  },
  {
    "poem_id": 1716,
    "vorder": 237,
    "position": 0,
    "text": "نچستی بداد اندر آزرم کس"
  },
  {
    "poem_id": 1716,
    "vorder": 238,
    "position": 1,
    "text": "چه کهتر چه فرزند فریادرس"
  },
  {
    "poem_id": 1716,
    "vorder": 239,
    "position": 0,
    "text": "چه کهتر چه مهتر به نزدیک اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 240,
    "position": 1,
    "text": "نجستی همی رای تاریک اوی"
  },
  {
    "poem_id": 1716,
    "vorder": 241,
    "position": 0,
    "text": "ز دادش جهان یکسر آباد کرد"
  },
  {
    "poem_id": 1716,
    "vorder": 242,
    "position": 1,
    "text": "دل زیردستان به خود شاد کرد"
  },
  {
    "poem_id": 1716,
    "vorder": 243,
    "position": 0,
    "text": "جهاندار چون گشت با داد جفت"
  },
  {
    "poem_id": 1716,
    "vorder": 244,
    "position": 1,
    "text": "زمانه پی او نیارد نهفت"
  },
  {
    "poem_id": 1716,
    "vorder": 245,
    "position": 0,
    "text": "فرستاده بودی به گرد جهان"
  },
  {
    "poem_id": 1716,
    "vorder": 246,
    "position": 1,
    "text": "خردمند و بیدار کارآگهان"
  },
  {
    "poem_id": 1716,
    "vorder": 247,
    "position": 0,
    "text": "به جایی که بودی زمینی خراب"
  },
  {
    "poem_id": 1716,
    "vorder": 248,
    "position": 1,
    "text": "وگر تنگ بودی به رود اندر آب"
  },
  {
    "poem_id": 1716,
    "vorder": 249,
    "position": 0,
    "text": "خراج اندر آن بوم برداشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 250,
    "position": 1,
    "text": "زمین کسان خوار نگذاشتی"
  },
  {
    "poem_id": 1716,
    "vorder": 251,
    "position": 0,
    "text": "گر ایدونک دهقان بدی تنگ دست"
  },
  {
    "poem_id": 1716,
    "vorder": 252,
    "position": 1,
    "text": "سوی نیستی گشته کارش ز هست"
  },
  {
    "poem_id": 1716,
    "vorder": 253,
    "position": 0,
    "text": "بدادی ز گنج آلت و چارپای"
  },
  {
    "poem_id": 1716,
    "vorder": 254,
    "position": 1,
    "text": "نماندی که پایش برفتی ز جای"
  },
  {
    "poem_id": 1716,
    "vorder": 255,
