[
  {
    "poem_id": 1557,
    "vorder": 1,
    "position": 0,
    "text": "چو شب شد چو آهرمن کینه‌خواه"
  },
  {
    "poem_id": 1557,
    "vorder": 2,
    "position": 1,
    "text": "خروش جرس خاست از بارگاه"
  },
  {
    "poem_id": 1557,
    "vorder": 3,
    "position": 0,
    "text": "بران بارهٔ پهلوی برنشست"
  },
  {
    "poem_id": 1557,
    "vorder": 4,
    "position": 1,
    "text": "یکی تیغ هندی گرفته به دست"
  },
  {
    "poem_id": 1557,
    "vorder": 5,
    "position": 0,
    "text": "چو نوشاذر و بهمن و مهرنوش"
  },
  {
    "poem_id": 1557,
    "vorder": 6,
    "position": 1,
    "text": "برفتند یکسر پر از جنگ و جوش"
  },
  {
    "poem_id": 1557,
    "vorder": 7,
    "position": 0,
    "text": "ورا راهبر پیش جاماسپ بود"
  },
  {
    "poem_id": 1557,
    "vorder": 8,
    "position": 1,
    "text": "که دستور فرخنده گشتاسپ بود"
  },
  {
    "poem_id": 1557,
    "vorder": 9,
    "position": 0,
    "text": "ازان بارهٔ دژ چو بیرون شدند"
  },
  {
    "poem_id": 1557,
    "vorder": 10,
    "position": 1,
    "text": "سواران جنگی به هامون شدند"
  },
  {
    "poem_id": 1557,
    "vorder": 11,
    "position": 0,
    "text": "سپهبد سوی آسمان کرد روی"
  },
  {
    "poem_id": 1557,
    "vorder": 12,
    "position": 1,
    "text": "چنین گفت کای داور راست‌گوی"
  },
  {
    "poem_id": 1557,
    "vorder": 13,
    "position": 0,
    "text": "توی آفریننده و کامگار"
  },
  {
    "poem_id": 1557,
    "vorder": 14,
    "position": 1,
    "text": "فروزندهٔ جان اسفندیار"
  },
  {
    "poem_id": 1557,
    "vorder": 15,
    "position": 0,
    "text": "تو دانی که از خون فرشیدورد"
  },
  {
    "poem_id": 1557,
    "vorder": 16,
    "position": 1,
    "text": "دلم گشت پر درد و رخساره زرد"
  },
  {
    "poem_id": 1557,
    "vorder": 17,
    "position": 0,
    "text": "گر ایدونک پیروز گردم به جنگ"
  },
  {
    "poem_id": 1557,
    "vorder": 18,
    "position": 1,
    "text": "کنم روی گیتی بر ارجاسپ تنگ"
  },
  {
    "poem_id": 1557,
    "vorder": 19,
    "position": 0,
    "text": "بخواهیم ازو کین لهراسپ شاه"
  },
  {
    "poem_id": 1557,
    "vorder": 20,
    "position": 1,
    "text": "همان کین چندین سر بیگناه"
  },
  {
    "poem_id": 1557,
    "vorder": 21,
    "position": 0,
    "text": "برادر جهان بین من سی و هشت"
  },
  {
    "poem_id": 1557,
    "vorder": 22,
    "position": 1,
    "text": "که از خونشان لعل شد خاک دشت"
  },
  {
    "poem_id": 1557,
    "vorder": 23,
    "position": 0,
    "text": "پذیرفتم از داور دادگر"
  },
  {
    "poem_id": 1557,
    "vorder": 24,
    "position": 1,
    "text": "که کینه نگیرم ز بند پدر"
  },
  {
    "poem_id": 1557,
    "vorder": 25,
    "position": 0,
    "text": "به گیتی صد آتشکده نو کنم"
  },
  {
    "poem_id": 1557,
    "vorder": 26,
    "position": 1,
    "text": "جهان از ستمگاره بی‌خو کنم"
  },
  {
    "poem_id": 1557,
    "vorder": 27,
    "position": 0,
    "text": "نبیند کسی پای من بر بساط"
  },
  {
    "poem_id": 1557,
    "vorder": 28,
    "position": 1,
    "text": "مگر در بیابان کنم صد رباط"
  },
  {
    "poem_id": 1557,
    "vorder": 29,
    "position": 0,
    "text": "به شاخی که کرگس برو نگذرد"
  },
  {
    "poem_id": 1557,
    "vorder": 30,
    "position": 1,
    "text": "بدو گور و نخچیر پی نسپرد"
  },
  {
    "poem_id": 1557,
    "vorder": 31,
    "position": 0,
    "text": "کنم چاه آب اندرو صدهزار"
  },
  {
    "poem_id": 1557,
    "vorder": 32,
    "position": 1,
    "text": "توانگر کنم مردم خیش کار"
  },
  {
    "poem_id": 1557,
    "vorder": 33,
    "position": 0,
    "text": "همه بی‌رهان را بدین آورم"
  },
  {
    "poem_id": 1557,
    "vorder": 34,
    "position": 1,
    "text": "سر جادوان بر زمین آورم"
  },
  {
    "poem_id": 1557,
    "vorder": 35,
    "position": 0,
    "text": "بگفت این و برگاشت اسپ نبرد"
  },
  {
    "poem_id": 1557,
    "vorder": 36,
    "position": 1,
    "text": "بیامد به نزدیک فرشیدورد"
  },
  {
    "poem_id": 1557,
    "vorder": 37,
    "position": 0,
    "text": "ورا از بر جامه بر خفته دید"
  },
  {
    "poem_id": 1557,
    "vorder": 38,
    "position": 1,
    "text": "تن خسته در جامه بنهفته دید"
  },
  {
    "poem_id": 1557,
    "vorder": 39,
    "position": 0,
    "text": "ز دیده ببارید چندان سرشک"
  },
  {
    "poem_id": 1557,
    "vorder": 40,
    "position": 1,
    "text": "که با درد او آشنا شد پزشک"
  },
  {
    "poem_id": 1557,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت کای شاه پرخاشجوی"
  },
  {
    "poem_id": 1557,
    "vorder": 42,
    "position": 1,
    "text": "ترا این گزند از که آمد به روی"
  },
  {
    "poem_id": 1557,
    "vorder": 43,
    "position": 0,
    "text": "کزو کین تو باز خواهم به جنگ"
  },
  {
    "poem_id": 1557,
    "vorder": 44,
    "position": 1,
    "text": "اگر شیر جنگیست او گر پلنگ"
  },
  {
    "poem_id": 1557,
    "vorder": 45,
    "position": 0,
    "text": "چنین داد پاسخ که ای پهلوان"
  },
  {
    "poem_id": 1557,
    "vorder": 46,
    "position": 1,
    "text": "ز گشتاسپم من خلیده‌روان"
  },
  {
    "poem_id": 1557,
    "vorder": 47,
    "position": 0,
    "text": "چو پای ترا او نکردی به بند"
  },
  {
    "poem_id": 1557,
    "vorder": 48,
    "position": 1,
    "text": "ز ترکان بما نامدی این گزند"
  },
  {
    "poem_id": 1557,
    "vorder": 49,
    "position": 0,
    "text": "همان شاه لهراسپ با پیر سر"
  },
  {
    "poem_id": 1557,
    "vorder": 50,
    "position": 1,
    "text": "همه بلخ ازو گشت زیر و زبر"
  },
  {
    "poem_id": 1557,
    "vorder": 51,
    "position": 0,
    "text": "ز گفت گُرَزم آنچ بر ما رسید"
  },
  {
    "poem_id": 1557,
    "vorder": 52,
    "position": 1,
    "text": "ندیدست هرگز کسی نه شنید"
  },
  {
    "poem_id": 1557,
    "vorder": 53,
    "position": 0,
    "text": "بدرد من اکنون تو خرسند باش"
  },
  {
    "poem_id": 1557,
    "vorder": 54,
    "position": 1,
    "text": "به گیتی درخت برومند باش"
  },
  {
    "poem_id": 1557,
    "vorder": 55,
    "position": 0,
    "text": "که من رفتنی‌ام به دیگر سرای"
  },
  {
    "poem_id": 1557,
    "vorder": 56,
    "position": 1,
    "text": "تو باید که باشی همیشه به جای"
  },
  {
    "poem_id": 1557,
    "vorder": 57,
    "position": 0,
    "text": "چو رفتم ز گیتی مرا یاددار"
  },
  {
    "poem_id": 1557,
    "vorder": 58,
    "position": 1,
    "text": "به بخشش روان مرا شاددار"
  },
  {
    "poem_id": 1557,
    "vorder": 59,
    "position": 0,
    "text": "تو پدرود باش ای جهان پهلوان"
  },
  {
    "poem_id": 1557,
    "vorder": 60,
    "position": 1,
    "text": "که جاوید بادی و روشن‌روان"
  },
  {
    "poem_id": 1557,
    "vorder": 61,
    "position": 0,
    "text": "بگفت این و رخسارگان کرد زرد"
  },
  {
    "poem_id": 1557,
    "vorder": 62,
    "position": 1,
    "text": "شد آن نامور شاه فرشیدورد"
  },
  {
    "poem_id": 1557,
    "vorder": 63,
    "position": 0,
    "text": "بزد دست بر جامه اسفندیار"
  },
  {
    "poem_id": 1557,
    "vorder": 64,
    "position": 1,
    "text": "همه پرنیان بر تنش گشت خار"
  },
  {
    "poem_id": 1557,
    "vorder": 65,
    "position": 0,
    "text": "همی گفت کای پاک برتر خدای"
  },
  {
    "poem_id": 1557,
    "vorder": 66,
    "position": 1,
    "text": "به نیکی تو باشی مرا رهنمای"
  },
  {
    "poem_id": 1557,
    "vorder": 67,
    "position": 0,
    "text": "که پیش آورم کین فرشیدورد"
  },
  {
    "poem_id": 1557,
    "vorder": 68,
    "position": 1,
    "text": "برانگیزم از رود وز کوه گرد"
  },
  {
    "poem_id": 1557,
    "vorder": 69,
    "position": 0,
    "text": "بریزم ز تن خون ارجاسپ را"
  },
  {
    "poem_id": 1557,
    "vorder": 70,
    "position": 1,
    "text": "شکیبا کنم جان لهراسپ را"
  },
  {
    "poem_id": 1557,
    "vorder": 71,
    "position": 0,
    "text": "برادرش را مرده بر زین نهاد"
  },
  {
    "poem_id": 1557,
    "vorder": 72,
    "position": 1,
    "text": "دلی پر ز کینه لبی پر ز باد"
  },
  {
    "poem_id": 1557,
    "vorder": 73,
    "position": 0,
    "text": "ز هامون بیامد به کوه بلند"
  },
  {
    "poem_id": 1557,
    "vorder": 74,
    "position": 1,
    "text": "برادرش بسته بر اسپ سمند"
  },
  {
    "poem_id": 1557,
    "vorder": 75,
    "position": 0,
    "text": "همی گفت کاکنون چه سازم ترا"
  },
  {
    "poem_id": 1557,
    "vorder": 76,
    "position": 1,
    "text": "یکی دخمه چون برفرازم ترا"
  },
  {
    "poem_id": 1557,
    "vorder": 77,
    "position": 0,
    "text": "نه چیزست با من نه سیم و نه زر"
  },
  {
    "poem_id": 1557,
    "vorder": 78,
    "position": 1,
    "text": "نه خشت و نه آب و نه دیوارگر"
  },
  {
    "poem_id": 1557,
    "vorder": 79,
    "position": 0,
    "text": "به زیر درختی که بد سایه‌دار"
  },
  {
    "poem_id": 1557,
    "vorder": 80,
    "position": 1,
    "text": "نهادش بدان جایگه نامدار"
  },
  {
    "poem_id": 1557,
    "vorder": 81,
    "position": 0,
    "text": "برآهیخت خفتان جنگ از تنش"
  },
  {
    "poem_id": 1557,
    "vorder": 82,
    "position": 1,
    "text": "کفن کرد دستار و پیراهنش"
  },
  {
    "poem_id": 1557,
    "vorder": 83,
    "position": 0,
    "text": "وزانجا بیامد بدان جایگاه"
  },
  {
    "poem_id": 1557,
    "vorder": 84,
    "position": 1,
    "text": "کجا شاه گشتاسپ گم کرد راه"
  },
  {
    "poem_id": 1557,
    "vorder": 85,
    "position": 0,
    "text": "بسی مرد ز ایرانیان کشته دید"
  },
  {
    "poem_id": 1557,
    "vorder": 86,
    "position": 1,
    "text": "شده خاک و ریگ از جهان ناپدید"
  },
  {
    "poem_id": 1557,
    "vorder": 87,
    "position": 0,
    "text": "همی زار بگریست بر کشتگان"
  },
  {
    "poem_id": 1557,
    "vorder": 88,
    "position": 1,
    "text": "پر از درد دل شد ازان خستگان"
  },
  {
    "poem_id": 1557,
    "vorder": 89,
    "position": 0,
    "text": "به جایی کجا کرده بودند رزم"
  },
  {
    "poem_id": 1557,
    "vorder": 90,
    "position": 1,
    "text": "به چشم آمدش زرد روی گُرَزم"
  },
  {
    "poem_id": 1557,
    "vorder": 91,
    "position": 0,
    "text": "به نزدیک او اسپش افگنده بود"
  },
  {
    "poem_id": 1557,
    "vorder": 92,
    "position": 1,
    "text": "برو خاک چندی پراگنده بود"
  },
  {
    "poem_id": 1557,
    "vorder": 93,
    "position": 0,
    "text": "چنین گفت با کشته اسفندیار"
  },
  {
    "poem_id": 1557,
    "vorder": 94,
    "position": 1,
    "text": "که ای مرد نادان بد روزگار"
  },
  {
    "poem_id": 1557,
    "vorder": 95,
    "position": 0,
    "text": "نگه کن که دانای ایران چه گفت"
  },
  {
    "poem_id": 1557,
    "vorder": 96,
    "position": 1,
    "text": "بدانگه که بگشاد راز از نهفت"
  },
  {
    "poem_id": 1557,
    "vorder": 97,
    "position": 0,
    "text": "که دشمن که دانا بود به ز دوست"
  },
  {
    "poem_id": 1557,
    "vorder": 98,
    "position": 1,
    "text": "ابا دشمن و دوست دانش نکوست"
  },
  {
    "poem_id": 1557,
    "vorder": 99,
    "position": 0,
    "text": "براندیشد آنکس که دانا بود"
  },
  {
    "poem_id": 1557,
    "vorder": 100,
    "position": 1,
    "text": "به کاری که بر وی توانا بود"
  },
  {
    "poem_id": 1557,
    "vorder": 101,
    "position": 0,
    "text": "ز چیزی که افتد بران ناتوان"
  },
  {
    "poem_id": 1557,
    "vorder": 102,
    "position": 1,
    "text": "به جستنش رنجه ندارد روان"
  },
  {
    "poem_id": 1557,
    "vorder": 103,
    "position": 0,
    "text": "از ایران همی جای من خواستی"
  },
  {
    "poem_id": 1557,
    "vorder": 104,
    "position": 1,
    "text": "برافگندی اندر جهان کاستی"
  },
  {
    "poem_id": 1557,
    "vorder": 105,
    "position": 0,
    "text": "ببردی ازین پادشاهی فروغ"
  },
  {
    "poem_id": 1557,
    "vorder": 106,
    "position": 1,
    "text": "همی چاره جستی بگفت دروغ"
  },
  {
    "poem_id": 1557,
    "vorder": 107,
    "position": 0,
    "text": "بدین رزم خونی که شد ریخته"
  },
  {
    "poem_id": 1557,
    "vorder": 108,
    "position": 1,
    "text": "تو باشی بدان گیتی آویخته"
  },
  {
    "poem_id": 1557,
    "vorder": 109,
    "position": 0,
    "text": "وزان دشت گریان سراندر کشید"
  },
  {
    "poem_id": 1557,
    "vorder": 110,
    "position": 1,
    "text": "به انبوه گردان ترکان رسید"
  },
  {
    "poem_id": 1557,
    "vorder": 111,
    "position": 0,
    "text": "سپه دید بر هفت فرسنگ دشت"
  },
  {
    "poem_id": 1557,
    "vorder": 112,
    "position": 1,
    "text": "کزیشان همی آسمان تیره گشت"
  },
  {
    "poem_id": 1557,
    "vorder": 113,
    "position": 0,
    "text": "یکی کنده کرده به گرد اندرون"
  },
  {
    "poem_id": 1557,
    "vorder": 114,
    "position": 1,
    "text": "به پهنای پرتاب تیری فزون"
  },
  {
    "poem_id": 1557,
    "vorder": 115,
    "position": 0,
    "text": "ز کنده به صد چاره اندر گذشت"
  },
  {
    "poem_id": 1557,
    "vorder": 116,
    "position": 1,
    "text": "عنان را نهاده بران سوی دشت"
  },
  {
    "poem_id": 1557,
    "vorder": 117,
    "position": 0,
    "text": "طلایه ز ترکان چو هشتاد مرد"
  },
  {
    "poem_id": 1557,
    "vorder": 118,
    "position": 1,
    "text": "همی گشت بر گرد دشت نبرد"
  },
  {
    "poem_id": 1557,
    "vorder": 119,
    "position": 0,
    "text": "برآهیخت شمشیر و اندر نهاد"
  },
  {
    "poem_id": 1557,
    "vorder": 120,
    "position": 1,
    "text": "همی کرد از رزم گشتاسپ یاد"
  },
  {
    "poem_id": 1557,
    "vorder": 121,
    "position": 0,
    "text": "بیفگند زیشان فراوان به راه"
  },
  {
    "poem_id": 1557,
    "vorder": 122,
    "position": 1,
    "text": "وزان جایگه رفت نزدیک شاه"
  }
]