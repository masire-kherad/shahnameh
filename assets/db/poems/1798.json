[
  {
    "poem_id": 1798,
    "vorder": 1,
    "position": 0,
    "text": "چو از کار رومی بپردخت شاه"
  },
  {
    "poem_id": 1798,
    "vorder": 2,
    "position": 1,
    "text": "دلش گشت پیچان ز کار سپاه"
  },
  {
    "poem_id": 1798,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا موبد رای‌زن"
  },
  {
    "poem_id": 1798,
    "vorder": 4,
    "position": 1,
    "text": "بشد با یکی نامدار انجمن"
  },
  {
    "poem_id": 1798,
    "vorder": 5,
    "position": 0,
    "text": "ببخشید روی زمین سربسر"
  },
  {
    "poem_id": 1798,
    "vorder": 6,
    "position": 1,
    "text": "ابر پهلوانان پرخاشخر"
  },
  {
    "poem_id": 1798,
    "vorder": 7,
    "position": 0,
    "text": "درم داد و اسپ و نگین و کلاه"
  },
  {
    "poem_id": 1798,
    "vorder": 8,
    "position": 1,
    "text": "گرانمایه را کشور و تاج و گاه"
  },
  {
    "poem_id": 1798,
    "vorder": 9,
    "position": 0,
    "text": "پر از راستی کرد یکسر جهان"
  },
  {
    "poem_id": 1798,
    "vorder": 10,
    "position": 1,
    "text": "وزو شادمانه کهان و مهان"
  },
  {
    "poem_id": 1798,
    "vorder": 11,
    "position": 0,
    "text": "هرانکس که بیداد بد دور کرد"
  },
  {
    "poem_id": 1798,
    "vorder": 12,
    "position": 1,
    "text": "به نادادن چیز و گفتار سرد"
  },
  {
    "poem_id": 1798,
    "vorder": 13,
    "position": 0,
    "text": "وزان پس چنین گفت با موبدان"
  },
  {
    "poem_id": 1798,
    "vorder": 14,
    "position": 1,
    "text": "که ای پرهنر پاک‌دل بخردان"
  },
  {
    "poem_id": 1798,
    "vorder": 15,
    "position": 0,
    "text": "جهان را ز هرگونه دارید یاد"
  },
  {
    "poem_id": 1798,
    "vorder": 16,
    "position": 1,
    "text": "ز کردار شاهان بیداد و داد"
  },
  {
    "poem_id": 1798,
    "vorder": 17,
    "position": 0,
    "text": "بسی دست شاهان ز بیداد و آز"
  },
  {
    "poem_id": 1798,
    "vorder": 18,
    "position": 1,
    "text": "تهی ماند و هم تن ز آرام و ناز"
  },
  {
    "poem_id": 1798,
    "vorder": 19,
    "position": 0,
    "text": "جهان از بداندیش در بیم بود"
  },
  {
    "poem_id": 1798,
    "vorder": 20,
    "position": 1,
    "text": "دل نیک‌مردان به دو نیم بود"
  },
  {
    "poem_id": 1798,
    "vorder": 21,
    "position": 0,
    "text": "همه دست کرده به کار بدی"
  },
  {
    "poem_id": 1798,
    "vorder": 22,
    "position": 1,
    "text": "کسی را نبد کوشش ایزدی"
  },
  {
    "poem_id": 1798,
    "vorder": 23,
    "position": 0,
    "text": "نبد بر زن و زاده کس پادشا"
  },
  {
    "poem_id": 1798,
    "vorder": 24,
    "position": 1,
    "text": "پر از غم دل مردم پارسا"
  },
  {
    "poem_id": 1798,
    "vorder": 25,
    "position": 0,
    "text": "به هر جای گستردن دست دیو"
  },
  {
    "poem_id": 1798,
    "vorder": 26,
    "position": 1,
    "text": "بریده دل از بیم گیهان خدیو"
  },
  {
    "poem_id": 1798,
    "vorder": 27,
    "position": 0,
    "text": "سر نیکویها و دست بدیست"
  },
  {
    "poem_id": 1798,
    "vorder": 28,
    "position": 1,
    "text": "در دانش و کوشش بخردیست"
  },
  {
    "poem_id": 1798,
    "vorder": 29,
    "position": 0,
    "text": "همه پاک در گردن پادشاست"
  },
  {
    "poem_id": 1798,
    "vorder": 30,
    "position": 1,
    "text": "که پیدا شود زو همه کژ و راست"
  },
  {
    "poem_id": 1798,
    "vorder": 31,
    "position": 0,
    "text": "پدر گر به بیداد یازید دست"
  },
  {
    "poem_id": 1798,
    "vorder": 32,
    "position": 1,
    "text": "نبد پاک و دانا و یزدان‌پرست"
  },
  {
    "poem_id": 1798,
    "vorder": 33,
    "position": 0,
    "text": "مدارید کردار او بس شگفت"
  },
  {
    "poem_id": 1798,
    "vorder": 34,
    "position": 1,
    "text": "که روشن دلش رنگ آتش گرفت"
  },
  {
    "poem_id": 1798,
    "vorder": 35,
    "position": 0,
    "text": "ببینید تا جم و کاوس شاه"
  },
  {
    "poem_id": 1798,
    "vorder": 36,
    "position": 1,
    "text": "چه کردند کز دیو جستند راه"
  },
  {
    "poem_id": 1798,
    "vorder": 37,
    "position": 0,
    "text": "پدر همچنان راه ایشان بجست"
  },
  {
    "poem_id": 1798,
    "vorder": 38,
    "position": 1,
    "text": "به آب خرد جان تیره نشست"
  },
  {
    "poem_id": 1798,
    "vorder": 39,
    "position": 0,
    "text": "همه زیردستانش پیچان شدند"
  },
  {
    "poem_id": 1798,
    "vorder": 40,
    "position": 1,
    "text": "فراوان ز تندیش بیجان شدند"
  },
  {
    "poem_id": 1798,
    "vorder": 41,
    "position": 0,
    "text": "کنون رفت و زو نام بد ماند و بس"
  },
  {
    "poem_id": 1798,
    "vorder": 42,
    "position": 1,
    "text": "همی آفرین او نیابد ز کس"
  },
  {
    "poem_id": 1798,
    "vorder": 43,
    "position": 0,
    "text": "ز ما باد بر جان او آفرین"
  },
  {
    "poem_id": 1798,
    "vorder": 44,
    "position": 1,
    "text": "مبادا که پیچد روانش ز کین"
  },
  {
    "poem_id": 1798,
    "vorder": 45,
    "position": 0,
    "text": "کنون بر نشستم بر گاه اوی"
  },
  {
    "poem_id": 1798,
    "vorder": 46,
    "position": 1,
    "text": "به مینو کشد بی‌گمان راه اوی"
  },
  {
    "poem_id": 1798,
    "vorder": 47,
    "position": 0,
    "text": "همی خواهم از کردگار جهان"
  },
  {
    "poem_id": 1798,
    "vorder": 48,
    "position": 1,
    "text": "که نیرو دهد آشکار و نهان"
  },
  {
    "poem_id": 1798,
    "vorder": 49,
    "position": 0,
    "text": "که با زیردستان مدارا کنیم"
  },
  {
    "poem_id": 1798,
    "vorder": 50,
    "position": 1,
    "text": "ز خاک سیه مشک سارا کنیم"
  },
  {
    "poem_id": 1798,
    "vorder": 51,
    "position": 0,
    "text": "که با خاک چون جفت گردد تنم"
  },
  {
    "poem_id": 1798,
    "vorder": 52,
    "position": 1,
    "text": "نگیرد ستمدیده‌ای دامنم"
  },
  {
    "poem_id": 1798,
    "vorder": 53,
    "position": 0,
    "text": "شما همچنین چادر راستی"
  },
  {
    "poem_id": 1798,
    "vorder": 54,
    "position": 1,
    "text": "بپوشید شسته دل از کاستی"
  },
  {
    "poem_id": 1798,
    "vorder": 55,
    "position": 0,
    "text": "که جز مرگ را کس ز مادر نزاد"
  },
  {
    "poem_id": 1798,
    "vorder": 56,
    "position": 1,
    "text": "ز دهقان و تازی و رومی نژاد"
  },
  {
    "poem_id": 1798,
    "vorder": 57,
    "position": 0,
    "text": "به کردار شیرست آهنگ اوی"
  },
  {
    "poem_id": 1798,
    "vorder": 58,
    "position": 1,
    "text": "نپیچد کسی گردن از چنگ اوی"
  },
  {
    "poem_id": 1798,
    "vorder": 59,
    "position": 0,
    "text": "همان شیر درنده را بشکرد"
  },
  {
    "poem_id": 1798,
    "vorder": 60,
    "position": 1,
    "text": "به خواری تن اژدها بسپرد"
  },
  {
    "poem_id": 1798,
    "vorder": 61,
    "position": 0,
    "text": "کجا آن سر و تاج شاهنشهان"
  },
  {
    "poem_id": 1798,
    "vorder": 62,
    "position": 1,
    "text": "کجا آن بزرگان و فرخ مهان"
  },
  {
    "poem_id": 1798,
    "vorder": 63,
    "position": 0,
    "text": "کجا آن سواران گردنکشان"
  },
  {
    "poem_id": 1798,
    "vorder": 64,
    "position": 1,
    "text": "کزیشان نبینم به گیتی نشان"
  },
  {
    "poem_id": 1798,
    "vorder": 65,
    "position": 0,
    "text": "کجا ان پری چهرگان جهان"
  },
  {
    "poem_id": 1798,
    "vorder": 66,
    "position": 1,
    "text": "کزیشان بدی شاد جان مهان"
  },
  {
    "poem_id": 1798,
    "vorder": 67,
    "position": 0,
    "text": "هرانکس که رخ زیر چادر نهفت"
  },
  {
    "poem_id": 1798,
    "vorder": 68,
    "position": 1,
    "text": "چنان دان که گشتست با خاک جفت"
  },
  {
    "poem_id": 1798,
    "vorder": 69,
    "position": 0,
    "text": "همه دست پاکی و نیکی بریم"
  },
  {
    "poem_id": 1798,
    "vorder": 70,
    "position": 1,
    "text": "جهان را به کردار بد نشمریم"
  },
  {
    "poem_id": 1798,
    "vorder": 71,
    "position": 0,
    "text": "به یزدان دارنده کو داد فر"
  },
  {
    "poem_id": 1798,
    "vorder": 72,
    "position": 1,
    "text": "به تاج و به تخت و نژاد و گهر"
  },
  {
    "poem_id": 1798,
    "vorder": 73,
    "position": 0,
    "text": "که گر کارداری به یک مشک خاک"
  },
  {
    "poem_id": 1798,
    "vorder": 74,
    "position": 1,
    "text": "زیان جوید اندر بلند و مغاک"
  },
  {
    "poem_id": 1798,
    "vorder": 75,
    "position": 0,
    "text": "هم‌انجا بسوزم به آتش تنش"
  },
  {
    "poem_id": 1798,
    "vorder": 76,
    "position": 1,
    "text": "کنم بر سر دار پیراهنش"
  },
  {
    "poem_id": 1798,
    "vorder": 77,
    "position": 0,
    "text": "وگر در گذشته ز شب چند پاس"
  },
  {
    "poem_id": 1798,
    "vorder": 78,
    "position": 1,
    "text": "بدزدد ز درویش دزدی پلاس"
  },
  {
    "poem_id": 1798,
    "vorder": 79,
    "position": 0,
    "text": "به تاوانش دیبا فرستم ز گنج"
  },
  {
    "poem_id": 1798,
    "vorder": 80,
    "position": 1,
    "text": "بشویم دل غمگنان را ز رنج"
  },
  {
    "poem_id": 1798,
    "vorder": 81,
    "position": 0,
    "text": "وگر گوسفندی برند از رمه"
  },
  {
    "poem_id": 1798,
    "vorder": 82,
    "position": 1,
    "text": "به تیره شب و روزگار دمه"
  },
  {
    "poem_id": 1798,
    "vorder": 83,
    "position": 0,
    "text": "یکی اسپ پرمایه تاوان دهم"
  },
  {
    "poem_id": 1798,
    "vorder": 84,
    "position": 1,
    "text": "مبادا که بر وی سپاسی نهم"
  },
  {
    "poem_id": 1798,
    "vorder": 85,
    "position": 0,
    "text": "چو با دشمنم کارزاری بود"
  },
  {
    "poem_id": 1798,
    "vorder": 86,
    "position": 1,
    "text": "وزان جنگ خسته سواری بود"
  },
  {
    "poem_id": 1798,
    "vorder": 87,
    "position": 0,
    "text": "فرستمش یکساله زر و درم"
  },
  {
    "poem_id": 1798,
    "vorder": 88,
    "position": 1,
    "text": "نداریم فرزند او را دژم"
  },
  {
    "poem_id": 1798,
    "vorder": 89,
    "position": 0,
    "text": "ز دادار دارنده یکسر سپاس"
  },
  {
    "poem_id": 1798,
    "vorder": 90,
    "position": 1,
    "text": "که اویست جاوید نیکی‌شناس"
  },
  {
    "poem_id": 1798,
    "vorder": 91,
    "position": 0,
    "text": "به آب و به آتش میازید دست"
  },
  {
    "poem_id": 1798,
    "vorder": 92,
    "position": 1,
    "text": "مگر هیربد مرد آتش‌پرست"
  },
  {
    "poem_id": 1798,
    "vorder": 93,
    "position": 0,
    "text": "مریزید هم خون گاوان ورز"
  },
  {
    "poem_id": 1798,
    "vorder": 94,
    "position": 1,
    "text": "که ننگست در گاو کشتن به مرز"
  },
  {
    "poem_id": 1798,
    "vorder": 95,
    "position": 0,
    "text": "ز پیری مگر گاو بیکار شد"
  },
  {
    "poem_id": 1798,
    "vorder": 96,
    "position": 1,
    "text": "به چشم خداوند خود خوار شد"
  },
  {
    "poem_id": 1798,
    "vorder": 97,
    "position": 0,
    "text": "نباید ز بن کشت گاو زهی"
  },
  {
    "poem_id": 1798,
    "vorder": 98,
    "position": 1,
    "text": "که از مرز بیرون شود فرهی"
  },
  {
    "poem_id": 1798,
    "vorder": 99,
    "position": 0,
    "text": "همه رای با مرد دانا زنید"
  },
  {
    "poem_id": 1798,
    "vorder": 100,
    "position": 1,
    "text": "دل کودک بی‌پدر مشکنید"
  },
  {
    "poem_id": 1798,
    "vorder": 101,
    "position": 0,
    "text": "از اندیشهٔ دیو باشید دور"
  },
  {
    "poem_id": 1798,
    "vorder": 102,
    "position": 1,
    "text": "گه جنگ دشمن مجویید سور"
  },
  {
    "poem_id": 1798,
    "vorder": 103,
    "position": 0,
    "text": "اگر خواهم از زیردستان خراج"
  },
  {
    "poem_id": 1798,
    "vorder": 104,
    "position": 1,
    "text": "ز دارنده بیزارم و تخت عاج"
  },
  {
    "poem_id": 1798,
    "vorder": 105,
    "position": 0,
    "text": "اگر بدکنش بد پدر یزدگرد"
  },
  {
    "poem_id": 1798,
    "vorder": 106,
    "position": 1,
    "text": "به پاداش آن داد کردیم گرد"
  },
  {
    "poem_id": 1798,
    "vorder": 107,
    "position": 0,
    "text": "همه دل ز کردار او خوش کنید"
  },
  {
    "poem_id": 1798,
    "vorder": 108,
    "position": 1,
    "text": "به آزادی آهنگ آتش کنید"
  },
  {
    "poem_id": 1798,
    "vorder": 109,
    "position": 0,
    "text": "ببخشد مگر کردگارش گناه"
  },
  {
    "poem_id": 1798,
    "vorder": 110,
    "position": 1,
    "text": "ز دوزخ به مینو نمایدش راه"
  },
  {
    "poem_id": 1798,
    "vorder": 111,
    "position": 0,
    "text": "کسی کو جوانست شادی کنید"
  },
  {
    "poem_id": 1798,
    "vorder": 112,
    "position": 1,
    "text": "دل مردمان جوان مشکنید"
  },
  {
    "poem_id": 1798,
    "vorder": 113,
    "position": 0,
    "text": "به پیری به مستی میازید دست"
  },
  {
    "poem_id": 1798,
    "vorder": 114,
    "position": 1,
    "text": "که همواره رسوا بود پیر مست"
  },
  {
    "poem_id": 1798,
    "vorder": 115,
    "position": 0,
    "text": "گنهکار یزدان مباشید هیچ"
  },
  {
    "poem_id": 1798,
    "vorder": 116,
    "position": 1,
    "text": "به پیری به آید به رفتن بسیچ"
  },
  {
    "poem_id": 1798,
    "vorder": 117,
    "position": 0,
    "text": "چو خشنود گردد ز ما کردگار"
  },
  {
    "poem_id": 1798,
    "vorder": 118,
    "position": 1,
    "text": "به هستی غم روز فردا مدار"
  },
  {
    "poem_id": 1798,
    "vorder": 119,
    "position": 0,
    "text": "دل زیردستان به ما شاد باد"
  },
  {
    "poem_id": 1798,
    "vorder": 120,
    "position": 1,
    "text": "سر سرکشان از غم آزاد باد"
  },
  {
    "poem_id": 1798,
    "vorder": 121,
    "position": 0,
    "text": "همه نامداران چو گفتار شاه"
  },
  {
    "poem_id": 1798,
    "vorder": 122,
    "position": 1,
    "text": "شنیدند و کردند نیکو نگاه"
  },
  {
    "poem_id": 1798,
    "vorder": 123,
    "position": 0,
    "text": "همه دیده کردند پیشش پر آب"
  },
  {
    "poem_id": 1798,
    "vorder": 124,
    "position": 1,
    "text": "ازان شاه پردانش و زودیاب"
  },
  {
    "poem_id": 1798,
    "vorder": 125,
    "position": 0,
    "text": "خروشان برو آفرین خواندند"
  },
  {
    "poem_id": 1798,
    "vorder": 126,
    "position": 1,
    "text": "ورا پادشا زمین خواندند"
  }
]