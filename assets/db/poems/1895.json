[
  {
    "poem_id": 1895,
    "vorder": 1,
    "position": 0,
    "text": "چنین تا بیامد مه فرودین"
  },
  {
    "poem_id": 1895,
    "vorder": 2,
    "position": 1,
    "text": "بیاراست گلبرگ روی زمین"
  },
  {
    "poem_id": 1895,
    "vorder": 3,
    "position": 0,
    "text": "جهان از نم ابر پر ژاله شد"
  },
  {
    "poem_id": 1895,
    "vorder": 4,
    "position": 1,
    "text": "همه کوه وهامون پراز لاله شد"
  },
  {
    "poem_id": 1895,
    "vorder": 5,
    "position": 0,
    "text": "بزرگان به بازی به باغ آمدند"
  },
  {
    "poem_id": 1895,
    "vorder": 6,
    "position": 1,
    "text": "همه میش و آهو به راغ آمدند"
  },
  {
    "poem_id": 1895,
    "vorder": 7,
    "position": 0,
    "text": "چو خسرو گشاده در باغ دید"
  },
  {
    "poem_id": 1895,
    "vorder": 8,
    "position": 1,
    "text": "همه چشمهٔ باغ پر ماغ دید"
  },
  {
    "poem_id": 1895,
    "vorder": 9,
    "position": 0,
    "text": "بفرمود تا دردمیدند بوق"
  },
  {
    "poem_id": 1895,
    "vorder": 10,
    "position": 1,
    "text": "بیاورد پس جامهای خلوق"
  },
  {
    "poem_id": 1895,
    "vorder": 11,
    "position": 0,
    "text": "نشستند بر سبزه می خواستند"
  },
  {
    "poem_id": 1895,
    "vorder": 12,
    "position": 1,
    "text": "به شادی زبان را بیاراستند"
  },
  {
    "poem_id": 1895,
    "vorder": 13,
    "position": 0,
    "text": "بیاورد پس گردیه گربکی"
  },
  {
    "poem_id": 1895,
    "vorder": 14,
    "position": 1,
    "text": "که پیدا نبد گربه از کودکی"
  },
  {
    "poem_id": 1895,
    "vorder": 15,
    "position": 0,
    "text": "بر اسپی نشانده ستامی بزر"
  },
  {
    "poem_id": 1895,
    "vorder": 16,
    "position": 1,
    "text": "به زر اندرون چند گونه گهر"
  },
  {
    "poem_id": 1895,
    "vorder": 17,
    "position": 0,
    "text": "فروهشته از گوش او گوشوار"
  },
  {
    "poem_id": 1895,
    "vorder": 18,
    "position": 1,
    "text": "به ناخن بر از لاله کرده نگار"
  },
  {
    "poem_id": 1895,
    "vorder": 19,
    "position": 0,
    "text": "بدیده چوقار و به رخ چون بهار"
  },
  {
    "poem_id": 1895,
    "vorder": 20,
    "position": 1,
    "text": "چو می‌خواره بد چشم او پر خمار"
  },
  {
    "poem_id": 1895,
    "vorder": 21,
    "position": 0,
    "text": "همی‌تاخت چون کودکی گرد باغ"
  },
  {
    "poem_id": 1895,
    "vorder": 22,
    "position": 1,
    "text": "فروهشته از باره زرین جناغ"
  },
  {
    "poem_id": 1895,
    "vorder": 23,
    "position": 0,
    "text": "لب شاه ایران پر از خنده شد"
  },
  {
    "poem_id": 1895,
    "vorder": 24,
    "position": 1,
    "text": "همه کهتران خنده را بنده شد"
  },
  {
    "poem_id": 1895,
    "vorder": 25,
    "position": 0,
    "text": "ابا گردیه گفت کز آرزوی"
  },
  {
    "poem_id": 1895,
    "vorder": 26,
    "position": 1,
    "text": "چه باید بگو ای زن خوب روی"
  },
  {
    "poem_id": 1895,
    "vorder": 27,
    "position": 0,
    "text": "زن چاره گر برد پیشش نماز"
  },
  {
    "poem_id": 1895,
    "vorder": 28,
    "position": 1,
    "text": "بدو گفت کای شاه گردن فراز"
  },
  {
    "poem_id": 1895,
    "vorder": 29,
    "position": 0,
    "text": "بمن بخش ری را خرد یاد کن"
  },
  {
    "poem_id": 1895,
    "vorder": 30,
    "position": 1,
    "text": "دل غمگنان از غم آزاد کن"
  },
  {
    "poem_id": 1895,
    "vorder": 31,
    "position": 0,
    "text": "ز ری مردک شوم رابازخوان"
  },
  {
    "poem_id": 1895,
    "vorder": 32,
    "position": 1,
    "text": "ورا مرد بد کیش و بد ساز دان"
  },
  {
    "poem_id": 1895,
    "vorder": 33,
    "position": 0,
    "text": "همی گربه از خانه بیرون کند"
  },
  {
    "poem_id": 1895,
    "vorder": 34,
    "position": 1,
    "text": "دگر ناودان یک به یک بشکند"
  },
  {
    "poem_id": 1895,
    "vorder": 35,
    "position": 0,
    "text": "بخندید خسرو ز گفتار زن"
  },
  {
    "poem_id": 1895,
    "vorder": 36,
    "position": 1,
    "text": "بدو گفت کای ماه لشکرشکن"
  },
  {
    "poem_id": 1895,
    "vorder": 37,
    "position": 0,
    "text": "ز ری باز خوان آن بد اندیش را"
  },
  {
    "poem_id": 1895,
    "vorder": 38,
    "position": 1,
    "text": "چو آهرمن آن مرد بد کیش را"
  },
  {
    "poem_id": 1895,
    "vorder": 39,
    "position": 0,
    "text": "فرستاد کس زشت رخ رابخواند"
  },
  {
    "poem_id": 1895,
    "vorder": 40,
    "position": 1,
    "text": "همان خشم بهرام با او براند"
  },
  {
    "poem_id": 1895,
    "vorder": 41,
    "position": 0,
    "text": "بکشتند او را به زاری و درد"
  },
  {
    "poem_id": 1895,
    "vorder": 42,
    "position": 1,
    "text": "کجا بد بد اندیش و بیکار مرد"
  },
  {
    "poem_id": 1895,
    "vorder": 43,
    "position": 0,
    "text": "هممی هر زمانش فزون بود بخت"
  },
  {
    "poem_id": 1895,
    "vorder": 44,
    "position": 1,
    "text": "ازان تاجور خسروانی درخت"
  }
]