[
  {
    "poem_id": 52174,
    "vorder": 1,
    "position": 0,
    "text": "ستاره شمر گفت بهرام را"
  },
  {
    "poem_id": 52174,
    "vorder": 2,
    "position": 1,
    "text": "که در چارشنبه مزن گام را"
  },
  {
    "poem_id": 52174,
    "vorder": 3,
    "position": 0,
    "text": "اگر زین به پیچی گزند آیدت"
  },
  {
    "poem_id": 52174,
    "vorder": 4,
    "position": 1,
    "text": "همه کار ناسودمند آیدت"
  },
  {
    "poem_id": 52174,
    "vorder": 5,
    "position": 0,
    "text": "یکی باغ بد در میان سپاه"
  },
  {
    "poem_id": 52174,
    "vorder": 6,
    "position": 1,
    "text": "ازین روی و زان روی بد رزم‌گاه"
  },
  {
    "poem_id": 52174,
    "vorder": 7,
    "position": 0,
    "text": "بشد چارشنبه هم از بامداد"
  },
  {
    "poem_id": 52174,
    "vorder": 8,
    "position": 1,
    "text": "بدان باغ کامروز باشیم شاد"
  },
  {
    "poem_id": 52174,
    "vorder": 9,
    "position": 0,
    "text": "ببردند پرمایه گستردنی"
  },
  {
    "poem_id": 52174,
    "vorder": 10,
    "position": 1,
    "text": "می و رود و رامشگر و خوردنی"
  },
  {
    "poem_id": 52174,
    "vorder": 11,
    "position": 0,
    "text": "بیامد بدان باغ و می درکشید"
  },
  {
    "poem_id": 52174,
    "vorder": 12,
    "position": 1,
    "text": "چوپاسی ز تیره شب اندر کشید"
  },
  {
    "poem_id": 52174,
    "vorder": 13,
    "position": 0,
    "text": "طلایه بیامد بپرموده گفت"
  },
  {
    "poem_id": 52174,
    "vorder": 14,
    "position": 1,
    "text": "که بهرام را جام و باغست جفت"
  },
  {
    "poem_id": 52174,
    "vorder": 15,
    "position": 0,
    "text": "سپهدار ازان جنگیان شش هزار"
  },
  {
    "poem_id": 52174,
    "vorder": 16,
    "position": 1,
    "text": "زلشکر گزین کرد گرد و سوار"
  },
  {
    "poem_id": 52174,
    "vorder": 17,
    "position": 0,
    "text": "فرستاد تا گرد بر گرد باغ"
  },
  {
    "poem_id": 52174,
    "vorder": 18,
    "position": 1,
    "text": "بگیرند گردنکشان بی‌چراغ"
  },
  {
    "poem_id": 52174,
    "vorder": 19,
    "position": 0,
    "text": "چو بهرام آگه شد از کارشان"
  },
  {
    "poem_id": 52174,
    "vorder": 20,
    "position": 1,
    "text": "ز رای جهانجوی و بازارشان"
  },
  {
    "poem_id": 52174,
    "vorder": 21,
    "position": 0,
    "text": "یلان سینه را گفت کای سرافراز"
  },
  {
    "poem_id": 52174,
    "vorder": 22,
    "position": 1,
    "text": "بدیوار باغ اندرون رخنه ساز"
  },
  {
    "poem_id": 52174,
    "vorder": 23,
    "position": 0,
    "text": "پس آنگاه بهرام و ایزد گشسب"
  },
  {
    "poem_id": 52174,
    "vorder": 24,
    "position": 1,
    "text": "نشستند با جنگجویان بر اسب"
  },
  {
    "poem_id": 52174,
    "vorder": 25,
    "position": 0,
    "text": "ازان رخنه باغ بیرون شدند"
  },
  {
    "poem_id": 52174,
    "vorder": 26,
    "position": 1,
    "text": "که دانست کان سرکشان چون شدند"
  },
  {
    "poem_id": 52174,
    "vorder": 27,
    "position": 0,
    "text": "برآمد ز در نالهٔ کرنای"
  },
  {
    "poem_id": 52174,
    "vorder": 28,
    "position": 1,
    "text": "سپهبد باسب اندر آورد پای"
  },
  {
    "poem_id": 52174,
    "vorder": 29,
    "position": 0,
    "text": "سبک رخنهٔ دیگر اندر زدند"
  },
  {
    "poem_id": 52174,
    "vorder": 30,
    "position": 1,
    "text": "سپه را یکایک بهم بر زدند"
  },
  {
    "poem_id": 52174,
    "vorder": 31,
    "position": 0,
    "text": "هم تاخت بهرام خشتی بدست"
  },
  {
    "poem_id": 52174,
    "vorder": 32,
    "position": 1,
    "text": "چناچون بود مردم نیم مست"
  },
  {
    "poem_id": 52174,
    "vorder": 33,
    "position": 0,
    "text": "نجستند گردان کس از دست اوی"
  },
  {
    "poem_id": 52174,
    "vorder": 34,
    "position": 1,
    "text": "به خون گشت یازان سر شست اوی"
  },
  {
    "poem_id": 52174,
    "vorder": 35,
    "position": 0,
    "text": "برآمد چکاچاک و بانگ سران"
  },
  {
    "poem_id": 52174,
    "vorder": 36,
    "position": 1,
    "text": "چو پولاد را پتک آهنگران"
  },
  {
    "poem_id": 52174,
    "vorder": 37,
    "position": 0,
    "text": "ازان باغ تا جای پرموده شاه"
  },
  {
    "poem_id": 52174,
    "vorder": 38,
    "position": 1,
    "text": "تن بی‌سران بد فگنده به راه"
  },
  {
    "poem_id": 52174,
    "vorder": 39,
    "position": 0,
    "text": "چوآمد بلشکر گه خویش باز"
  },
  {
    "poem_id": 52174,
    "vorder": 40,
    "position": 1,
    "text": "شبیخون سگالید گردن فراز"
  },
  {
    "poem_id": 52174,
    "vorder": 41,
    "position": 0,
    "text": "چو نیمی زتیره شب اندر گذشت"
  },
  {
    "poem_id": 52174,
    "vorder": 42,
    "position": 1,
    "text": "سپهدار جنگی برون شد به دشت"
  },
  {
    "poem_id": 52174,
    "vorder": 43,
    "position": 0,
    "text": "سپهبد بران سوی لشکر کشید"
  },
  {
    "poem_id": 52174,
    "vorder": 44,
    "position": 1,
    "text": "زترکان طلایه کس او را ندید"
  },
  {
    "poem_id": 52174,
    "vorder": 45,
    "position": 0,
    "text": "چو آمد به نزدیک‌ی رزمگاه"
  },
  {
    "poem_id": 52174,
    "vorder": 46,
    "position": 1,
    "text": "دم نای رویین برآمد ز راه"
  },
  {
    "poem_id": 52174,
    "vorder": 47,
    "position": 0,
    "text": "چو آواز کوس آمد و کرنای"
  },
  {
    "poem_id": 52174,
    "vorder": 48,
    "position": 1,
    "text": "بجستند ترکان جنگی ز جای"
  },
  {
    "poem_id": 52174,
    "vorder": 49,
    "position": 0,
    "text": "زلشکر بران سان برآمد خروش"
  },
  {
    "poem_id": 52174,
    "vorder": 50,
    "position": 1,
    "text": "که شیر ژیان را بدرید گوش"
  },
  {
    "poem_id": 52174,
    "vorder": 51,
    "position": 0,
    "text": "به تاریکی اندر دهاده بخاست"
  },
  {
    "poem_id": 52174,
    "vorder": 52,
    "position": 1,
    "text": "ز دست چپ لشکر و دست راست"
  },
  {
    "poem_id": 52174,
    "vorder": 53,
    "position": 0,
    "text": "یکی مر دگر را ندانست باز"
  },
  {
    "poem_id": 52174,
    "vorder": 54,
    "position": 1,
    "text": "شب تیره و نیزه‌های دراز"
  },
  {
    "poem_id": 52174,
    "vorder": 55,
    "position": 0,
    "text": "بخنجر همی آتش افروختند"
  },
  {
    "poem_id": 52174,
    "vorder": 56,
    "position": 1,
    "text": "زمین و هوا را همی‌سوختند"
  },
  {
    "poem_id": 52174,
    "vorder": 57,
    "position": 0,
    "text": "ز ترکان جنگی فراوان نماند"
  },
  {
    "poem_id": 52174,
    "vorder": 58,
    "position": 1,
    "text": "ز خون سنگها جز به مرجان نماند"
  },
  {
    "poem_id": 52174,
    "vorder": 59,
    "position": 0,
    "text": "گریزان همی‌رفت مهتر چو گرد"
  },
  {
    "poem_id": 52174,
    "vorder": 60,
    "position": 1,
    "text": "دهن خشک و لبها شده لاجورد"
  },
  {
    "poem_id": 52174,
    "vorder": 61,
    "position": 0,
    "text": "چنین تا سپیده‌دمان بردمید"
  },
  {
    "poem_id": 52174,
    "vorder": 62,
    "position": 1,
    "text": "شب تیره گون دامن اندر کشید"
  },
  {
    "poem_id": 52174,
    "vorder": 63,
    "position": 0,
    "text": "سپهدار ایران بترکان رسید"
  },
  {
    "poem_id": 52174,
    "vorder": 64,
    "position": 1,
    "text": "خروشی چوشیر ژیان برکشید"
  },
  {
    "poem_id": 52174,
    "vorder": 65,
    "position": 0,
    "text": "بپرموده گفت ای گریزنده مرد"
  },
  {
    "poem_id": 52174,
    "vorder": 66,
    "position": 1,
    "text": "تو گرد دلیران جنگی مگرد"
  },
  {
    "poem_id": 52174,
    "vorder": 67,
    "position": 0,
    "text": "نه مردی هنوز ای پسر کودکی"
  },
  {
    "poem_id": 52174,
    "vorder": 68,
    "position": 1,
    "text": "روا باشد ار شیرمادر مکی"
  },
  {
    "poem_id": 52174,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت شاه ای گراینده شیر"
  },
  {
    "poem_id": 52174,
    "vorder": 70,
    "position": 1,
    "text": "به خون ریختن چند باشی دلیر"
  },
  {
    "poem_id": 52174,
    "vorder": 71,
    "position": 0,
    "text": "زخون سران سیر شد روز جنگ"
  },
  {
    "poem_id": 52174,
    "vorder": 72,
    "position": 1,
    "text": "بخشکی پلنگ و بدریا نهنگ"
  },
  {
    "poem_id": 52174,
    "vorder": 73,
    "position": 0,
    "text": "نخواهی شد از خون مردم تو سیر"
  },
  {
    "poem_id": 52174,
    "vorder": 74,
    "position": 1,
    "text": "برآنم که هستی تو درنده شیر"
  },
  {
    "poem_id": 52174,
    "vorder": 75,
    "position": 0,
    "text": "بریده سر ساوه شاه آنک مهر"
  },
  {
    "poem_id": 52174,
    "vorder": 76,
    "position": 1,
    "text": "برو داشت تا بود گردان سپهر"
  },
  {
    "poem_id": 52174,
    "vorder": 77,
    "position": 0,
    "text": "سپاهی بران گونه کردی تباه"
  },
  {
    "poem_id": 52174,
    "vorder": 78,
    "position": 1,
    "text": "که بخشایش آورد خورشید و ماه"
  },
  {
    "poem_id": 52174,
    "vorder": 79,
    "position": 0,
    "text": "ازان شاه جنگی منم یادگار"
  },
  {
    "poem_id": 52174,
    "vorder": 80,
    "position": 1,
    "text": "مراهم چنان دان که کشتی بزار"
  },
  {
    "poem_id": 52174,
    "vorder": 81,
    "position": 0,
    "text": "ز مادر همه مرگ را زاده‌ایم"
  },
  {
    "poem_id": 52174,
    "vorder": 82,
    "position": 1,
    "text": "ار ای دون که ترکیم ار آزاده‌ایم"
  },
  {
    "poem_id": 52174,
    "vorder": 83,
    "position": 0,
    "text": "گریزانم و تو پس اندر دمان"
  },
  {
    "poem_id": 52174,
    "vorder": 84,
    "position": 1,
    "text": "نیابی مرا تا نیاید زمان"
  },
  {
    "poem_id": 52174,
    "vorder": 85,
    "position": 0,
    "text": "اگر باز گردم سلیحی بچنگ"
  },
  {
    "poem_id": 52174,
    "vorder": 86,
    "position": 1,
    "text": "مگر من شوم کشته گر تو به جنگ"
  },
  {
    "poem_id": 52174,
    "vorder": 87,
    "position": 0,
    "text": "مکن تیز مغزی و آتش سری"
  },
  {
    "poem_id": 52174,
    "vorder": 88,
    "position": 1,
    "text": "نه زین سان بود مهتر لشکری"
  },
  {
    "poem_id": 52174,
    "vorder": 89,
    "position": 0,
    "text": "من ایدون شوم سوی خرگاه خویش"
  },
  {
    "poem_id": 52174,
    "vorder": 90,
    "position": 1,
    "text": "یکی بازجویم سر راه خویش"
  },
  {
    "poem_id": 52174,
    "vorder": 91,
    "position": 0,
    "text": "نویسم یکی نامه زی شهریار"
  },
  {
    "poem_id": 52174,
    "vorder": 92,
    "position": 1,
    "text": "مگر زو شوم ایمن از روزگار"
  },
  {
    "poem_id": 52174,
    "vorder": 93,
    "position": 0,
    "text": "گر ای دون که اندر پذیرد مرا"
  },
  {
    "poem_id": 52174,
    "vorder": 94,
    "position": 1,
    "text": "ازین ساختن پس گزیرد مرا"
  },
  {
    "poem_id": 52174,
    "vorder": 95,
    "position": 0,
    "text": "من آن بارگه رایکی بنده‌ام"
  },
  {
    "poem_id": 52174,
    "vorder": 96,
    "position": 1,
    "text": "دل از مهتری پاک برکنده‌ام"
  },
  {
    "poem_id": 52174,
    "vorder": 97,
    "position": 0,
    "text": "ز سرکینه وجنگ را دورکن"
  },
  {
    "poem_id": 52174,
    "vorder": 98,
    "position": 1,
    "text": "بخوبی منش بریکی سورکن"
  },
  {
    "poem_id": 52174,
    "vorder": 99,
    "position": 0,
    "text": "چوبشنید بهرام زو بازگشت"
  },
  {
    "poem_id": 52174,
    "vorder": 100,
    "position": 1,
    "text": "که برساز شاهی خوش آواز گشت"
  },
  {
    "poem_id": 52174,
    "vorder": 101,
    "position": 0,
    "text": "چو از جنگ آن لشکر آسوده شد"
  },
  {
    "poem_id": 52174,
    "vorder": 102,
    "position": 1,
    "text": "بلشکر گه شاه پرموده شد"
  },
  {
    "poem_id": 52174,
    "vorder": 103,
    "position": 0,
    "text": "همی‌گشت بر گرد دشت نبرد"
  },
  {
    "poem_id": 52174,
    "vorder": 104,
    "position": 1,
    "text": "سرسرکشان را زتن دورکرد"
  },
  {
    "poem_id": 52174,
    "vorder": 105,
    "position": 0,
    "text": "چوبرهم نهاده بد انبوه گشت"
  },
  {
    "poem_id": 52174,
    "vorder": 106,
    "position": 1,
    "text": "ببالا و پهنا یکی کوه گشت"
  },
  {
    "poem_id": 52174,
    "vorder": 107,
    "position": 0,
    "text": "مرآن جای را نامداران یل"
  },
  {
    "poem_id": 52174,
    "vorder": 108,
    "position": 1,
    "text": "همی هرکسی خواند بهرام تل"
  },
  {
    "poem_id": 52174,
    "vorder": 109,
    "position": 0,
    "text": "سلیح سواران وچیزی که دید"
  },
  {
    "poem_id": 52174,
    "vorder": 110,
    "position": 1,
    "text": "بجایی که بد سوی آن تل کشید"
  },
  {
    "poem_id": 52174,
    "vorder": 111,
    "position": 0,
    "text": "یکی نامه بنوشت زی شهریار"
  },
  {
    "poem_id": 52174,
    "vorder": 112,
    "position": 1,
    "text": "ز پر موده و لشکر بی‌شمار"
  },
  {
    "poem_id": 52174,
    "vorder": 113,
    "position": 0,
    "text": "بگفت آنک ما را چه آمد بروی"
  },
  {
    "poem_id": 52174,
    "vorder": 114,
    "position": 1,
    "text": "ز ترکان و آن شاه پرخاشجوی"
  },
  {
    "poem_id": 52174,
    "vorder": 115,
    "position": 0,
    "text": "که از بیم تیغ او سوی چاره شد"
  },
  {
    "poem_id": 52174,
    "vorder": 116,
    "position": 1,
    "text": "وزان جایگه شد خوار و آواره شد"
  },
  {
    "poem_id": 52174,
    "vorder": 117,
    "position": 0,
    "text": "وزین روی خاقان در دز ببست"
  },
  {
    "poem_id": 52174,
    "vorder": 118,
    "position": 1,
    "text": "بانبوه و اندیشه اندر نشست"
  },
  {
    "poem_id": 52174,
    "vorder": 119,
    "position": 0,
    "text": "بگشتند گرد در دز بسی"
  },
  {
    "poem_id": 52174,
    "vorder": 120,
    "position": 1,
    "text": "ندانست سامان جنگش کسی"
  },
  {
    "poem_id": 52174,
    "vorder": 121,
    "position": 0,
    "text": "چنین گفت زان پس که سامان جنگ"
  },
  {
    "poem_id": 52174,
    "vorder": 122,
    "position": 1,
    "text": "کنون نیست در کارکردن درنگ"
  },
  {
    "poem_id": 52174,
    "vorder": 123,
    "position": 0,
    "text": "یلان سینه راگفت تا سه هزار"
  },
  {
    "poem_id": 52174,
    "vorder": 124,
    "position": 1,
    "text": "ازان جنگیان برگزیند سوار"
  },
  {
    "poem_id": 52174,
    "vorder": 125,
    "position": 0,
    "text": "چهار از یلان نیز آذرگشسب"
  },
  {
    "poem_id": 52174,
    "vorder": 126,
    "position": 1,
    "text": "ازان جنگیان برنشاند بر اسب"
  },
  {
    "poem_id": 52174,
    "vorder": 127,
    "position": 0,
    "text": "بفرمود تا هر که را یافتند"
  },
  {
    "poem_id": 52174,
    "vorder": 128,
    "position": 1,
    "text": "بگردن زدن تیز بشتافتند"
  },
  {
    "poem_id": 52174,
    "vorder": 129,
    "position": 0,
    "text": "مگر نامدار از دز آید برون"
  },
  {
    "poem_id": 52174,
    "vorder": 130,
    "position": 1,
    "text": "چوبیند همه دشت را رود خون"
  },
  {
    "poem_id": 52174,
    "vorder": 131,
    "position": 0,
    "text": "ببد بر در دز ازین سان سه روز"
  },
  {
    "poem_id": 52174,
    "vorder": 132,
    "position": 1,
    "text": "چهارم چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 52174,
    "vorder": 133,
    "position": 0,
    "text": "پیامی فرستاد پرموده را"
  },
  {
    "poem_id": 52174,
    "vorder": 134,
    "position": 1,
    "text": "مر آن مهتر کشور و دوده را"
  },
  {
    "poem_id": 52174,
    "vorder": 135,
    "position": 0,
    "text": "که‌ای مهتر و شاه ترکان چین"
  },
  {
    "poem_id": 52174,
    "vorder": 136,
    "position": 1,
    "text": "زگیتی چرا کردی این دز گزین"
  },
  {
    "poem_id": 52174,
    "vorder": 137,
    "position": 0,
    "text": "کجا آن جهان جستن ساوه شاه"
  },
  {
    "poem_id": 52174,
    "vorder": 138,
    "position": 1,
    "text": "کجا آن همه گنج و آن دستگاه"
  },
  {
    "poem_id": 52174,
    "vorder": 139,
    "position": 0,
    "text": "کجا آن همه پیل و برگستوان"
  },
  {
    "poem_id": 52174,
    "vorder": 140,
    "position": 1,
    "text": "کجا آن بزرگان روشن روان"
  },
  {
    "poem_id": 52174,
    "vorder": 141,
    "position": 0,
    "text": "کجا آن همه تنبل و جادوی"
  },
  {
    "poem_id": 52174,
    "vorder": 142,
    "position": 1,
    "text": "که اکنون از ایشان تو بر یکسوی"
  },
  {
    "poem_id": 52174,
    "vorder": 143,
    "position": 0,
    "text": "همی شهر ترکان تو را بس نبود"
  },
  {
    "poem_id": 52174,
    "vorder": 144,
    "position": 1,
    "text": "چو باب تو اندر جهان کس نبود"
  },
  {
    "poem_id": 52174,
    "vorder": 145,
    "position": 0,
    "text": "نشستی برین باره بر چون زنان"
  },
  {
    "poem_id": 52174,
    "vorder": 146,
    "position": 1,
    "text": "پرازخون دل ودست بر سر زنان"
  },
  {
    "poem_id": 52174,
    "vorder": 147,
    "position": 0,
    "text": "درباره بگشای و زنهار خواه"
  },
  {
    "poem_id": 52174,
    "vorder": 148,
    "position": 1,
    "text": "برشاه کشور مرا یارخواه"
  },
  {
    "poem_id": 52174,
    "vorder": 149,
    "position": 0,
    "text": "ز دز گنج دینار بیرون فرست"
  },
  {
    "poem_id": 52174,
    "vorder": 150,
    "position": 1,
    "text": "بگیتی نخورد آنک برپای بست"
  },
  {
    "poem_id": 52174,
    "vorder": 151,
    "position": 0,
    "text": "اگرگنج داری ز کشور بیار"
  },
  {
    "poem_id": 52174,
    "vorder": 152,
    "position": 1,
    "text": "که دینار خوارست برشهریار"
  },
  {
    "poem_id": 52174,
    "vorder": 153,
    "position": 0,
    "text": "به درگاه شاهت میانجی منم"
  },
  {
    "poem_id": 52174,
    "vorder": 154,
    "position": 1,
    "text": "که بر شهر ایران گوانجی منم"
  },
  {
    "poem_id": 52174,
    "vorder": 155,
    "position": 0,
    "text": "تو را بر همه مهتران مه کنم"
  },
  {
    "poem_id": 52174,
    "vorder": 156,
    "position": 1,
    "text": "از اندیشه و رای تو به کنم"
  },
  {
    "poem_id": 52174,
    "vorder": 157,
    "position": 0,
    "text": "ور ایدون که رازی‌ست نزدیک تو"
  },
  {
    "poem_id": 52174,
    "vorder": 158,
    "position": 1,
    "text": "که روشن کند جان تاریک تو"
  },
  {
    "poem_id": 52174,
    "vorder": 159,
    "position": 0,
    "text": "گشاده کن آن راز و با من بگوی"
  },
  {
    "poem_id": 52174,
    "vorder": 160,
    "position": 1,
    "text": "چوکارت چنین گشت دوری مجوی"
  },
  {
    "poem_id": 52174,
    "vorder": 161,
    "position": 0,
    "text": "وگر جنگ را یار داری کسی"
  },
  {
    "poem_id": 52174,
    "vorder": 162,
    "position": 1,
    "text": "همان گنج و دینار داری بسی"
  },
  {
    "poem_id": 52174,
    "vorder": 163,
    "position": 0,
    "text": "بزن کوس و این کینها بازخواه"
  },
  {
    "poem_id": 52174,
    "vorder": 164,
    "position": 1,
    "text": "بود خواسته تنگ ناید سپاه"
  },
  {
    "poem_id": 52174,
    "vorder": 165,
    "position": 0,
    "text": "چوآمد فرستاده داد این پیام"
  },
  {
    "poem_id": 52174,
    "vorder": 166,
    "position": 1,
    "text": "چوبشنید زو مرد جوینده کام"
  },
  {
    "poem_id": 52174,
    "vorder": 167,
    "position": 0,
    "text": "چنین داد پاسخ که او را بگوی"
  },
  {
    "poem_id": 52174,
    "vorder": 168,
    "position": 1,
    "text": "که راز جهان تا توانی مجوی"
  },
  {
    "poem_id": 52174,
    "vorder": 169,
    "position": 0,
    "text": "تو گستاخ گشتی بگیتی مگر"
  },
  {
    "poem_id": 52174,
    "vorder": 170,
    "position": 1,
    "text": "که رنج نخستینت آمد ببر"
  },
  {
    "poem_id": 52174,
    "vorder": 171,
    "position": 0,
    "text": "به پیروزی اندر تو کشی مکن"
  },
  {
    "poem_id": 52174,
    "vorder": 172,
    "position": 1,
    "text": "اگر تو نوی هست گیتی کهن"
  },
  {
    "poem_id": 52174,
    "vorder": 173,
    "position": 0,
    "text": "نداند کسی راز گردان سپهر"
  },
  {
    "poem_id": 52174,
    "vorder": 174,
    "position": 1,
    "text": "نه هرگز نماید بما نیز چهر"
  },
  {
    "poem_id": 52174,
    "vorder": 175,
    "position": 0,
    "text": "زمهتر نه خوبست کردن فسوس"
  },
  {
    "poem_id": 52174,
    "vorder": 176,
    "position": 1,
    "text": "مرا هم سپه بود و هم پیل وکوس"
  },
  {
    "poem_id": 52174,
    "vorder": 177,
    "position": 0,
    "text": "دروغ آزمایست چرخ بلند"
  },
  {
    "poem_id": 52174,
    "vorder": 178,
    "position": 1,
    "text": "تودل را بگستاخی اندر مبند"
  },
  {
    "poem_id": 52174,
    "vorder": 179,
    "position": 0,
    "text": "پدرم آن دلیر جهاندیده مرد"
  },
  {
    "poem_id": 52174,
    "vorder": 180,
    "position": 1,
    "text": "که دیدی ورا روزگار نبرد"
  },
  {
    "poem_id": 52174,
    "vorder": 181,
    "position": 0,
    "text": "زمین سم اسب ورا بنده بود"
  },
  {
    "poem_id": 52174,
    "vorder": 182,
    "position": 1,
    "text": "برایش فلک نیز پوینده بود"
  },
  {
    "poem_id": 52174,
    "vorder": 183,
    "position": 0,
    "text": "بجست آنک اورا نبایست جست"
  },
  {
    "poem_id": 52174,
    "vorder": 184,
    "position": 1,
    "text": "بپیچید ز اندیشه نادرست"
  },
  {
    "poem_id": 52174,
    "vorder": 185,
    "position": 0,
    "text": "هنر زیرافسوس پنهان شود"
  },
  {
    "poem_id": 52174,
    "vorder": 186,
    "position": 1,
    "text": "همان دشمن از دوست خندان شود"
  },
  {
    "poem_id": 52174,
    "vorder": 187,
    "position": 0,
    "text": "دگر آنک گفتی شمار سپهر"
  },
  {
    "poem_id": 52174,
    "vorder": 188,
    "position": 1,
    "text": "فزونست از تابش هور ومهر"
  },
  {
    "poem_id": 52174,
    "vorder": 189,
    "position": 0,
    "text": "ستوران و پیلان چوتخم گیا"
  },
  {
    "poem_id": 52174,
    "vorder": 190,
    "position": 1,
    "text": "شد اندر دم پرهٔ آسیا"
  },
  {
    "poem_id": 52174,
    "vorder": 191,
    "position": 0,
    "text": "بران کو چنین بود برگشت روز"
  },
  {
    "poem_id": 52174,
    "vorder": 192,
    "position": 1,
    "text": "نمانی توهم شاد و گیتی فروز"
  },
  {
    "poem_id": 52174,
    "vorder": 193,
    "position": 0,
    "text": "همی ترس ازین برگراینده دهر"
  },
  {
    "poem_id": 52174,
    "vorder": 194,
    "position": 1,
    "text": "مگر زهر سازد بدین پای زهر"
  },
  {
    "poem_id": 52174,
    "vorder": 195,
    "position": 0,
    "text": "کسی را که خون ریختن پیشه گشت"
  },
  {
    "poem_id": 52174,
    "vorder": 196,
    "position": 1,
    "text": "دل دشمنان پر ز اندیشه گشت"
  },
  {
    "poem_id": 52174,
    "vorder": 197,
    "position": 0,
    "text": "بریزند خونش بران هم نشان"
  },
  {
    "poem_id": 52174,
    "vorder": 198,
    "position": 1,
    "text": "که او ریخت خون سر سرکشان"
  },
  {
    "poem_id": 52174,
    "vorder": 199,
    "position": 0,
    "text": "گر از شهر ترکان برآری دمار"
  },
  {
    "poem_id": 52174,
    "vorder": 200,
    "position": 1,
    "text": "همی کین بخواهند فرجام کار"
  },
  {
    "poem_id": 52174,
    "vorder": 201,
    "position": 0,
    "text": "نیایم همان پیش تو ناگهان"
  },
  {
    "poem_id": 52174,
    "vorder": 202,
    "position": 1,
    "text": "بترسم که برمن سرآید زمان"
  },
  {
    "poem_id": 52174,
    "vorder": 203,
    "position": 0,
    "text": "یکی بنده‌ای من یکی شهریار"
  },
  {
    "poem_id": 52174,
    "vorder": 204,
    "position": 1,
    "text": "بربنده من کی شوم زار وخوار"
  },
  {
    "poem_id": 52174,
    "vorder": 205,
    "position": 0,
    "text": "به جنگ‌ت نیایم همان بی‌سپاه"
  },
  {
    "poem_id": 52174,
    "vorder": 206,
    "position": 1,
    "text": "که دیوانه خواند مرا نیکخواه"
  },
  {
    "poem_id": 52174,
    "vorder": 207,
    "position": 0,
    "text": "اگر خواهم از شاه تو زینهار"
  },
  {
    "poem_id": 52174,
    "vorder": 208,
    "position": 1,
    "text": "چوتنگی بروی آیدم نیست عار"
  },
  {
    "poem_id": 52174,
    "vorder": 209,
    "position": 0,
    "text": "وزان پس در گنج و دز مر تو راست"
  },
  {
    "poem_id": 52174,
    "vorder": 210,
    "position": 1,
    "text": "بدین نامور بوم کامت رواست"
  },
  {
    "poem_id": 52174,
    "vorder": 211,
    "position": 0,
    "text": "فرستاده آمد بگفت این پیام"
  },
  {
    "poem_id": 52174,
    "vorder": 212,
    "position": 1,
    "text": "زپیغام بهرام شد شادکام"
  },
  {
    "poem_id": 52174,
    "vorder": 213,
    "position": 0,
    "text": "نبشتند پس نامه سودمند"
  },
  {
    "poem_id": 52174,
    "vorder": 214,
    "position": 1,
    "text": "به نزدیک پیروز شاه بلند"
  },
  {
    "poem_id": 52174,
    "vorder": 215,
    "position": 0,
    "text": "که خاقان چین زینهاری شدست"
  },
  {
    "poem_id": 52174,
    "vorder": 216,
    "position": 1,
    "text": "ز جنگ درازم حصاری شدست"
  },
  {
    "poem_id": 52174,
    "vorder": 217,
    "position": 0,
    "text": "یکی مهر و منشور باید همی"
  },
  {
    "poem_id": 52174,
    "vorder": 218,
    "position": 1,
    "text": "بدین مژده بر سور باید همی"
  },
  {
    "poem_id": 52174,
    "vorder": 219,
    "position": 0,
    "text": "که خاقان زما زینهاری شود"
  },
  {
    "poem_id": 52174,
    "vorder": 220,
    "position": 1,
    "text": "ازان برتری سوی خواری شود"
  },
  {
    "poem_id": 52174,
    "vorder": 221,
    "position": 0,
    "text": "چونامه بیامد به نزدیک شاه"
  },
  {
    "poem_id": 52174,
    "vorder": 222,
    "position": 1,
    "text": "بابر اندر آورد فرخ کلاه"
  },
  {
    "poem_id": 52174,
    "vorder": 223,
    "position": 0,
    "text": "فرستاد و ایرانیان رابخواند"
  },
  {
    "poem_id": 52174,
    "vorder": 224,
    "position": 1,
    "text": "برنامور تخت شاهی نشاند"
  },
  {
    "poem_id": 52174,
    "vorder": 225,
    "position": 0,
    "text": "بفرمود تا نامه برخواندند"
  },
  {
    "poem_id": 52174,
    "vorder": 226,
    "position": 1,
    "text": "بخواننده بر گوهر افشاندند"
  },
  {
    "poem_id": 52174,
    "vorder": 227,
    "position": 0,
    "text": "به آزادگان گفت یزدان سپاس"
  },
  {
    "poem_id": 52174,
    "vorder": 228,
    "position": 1,
    "text": "نیاش کنم من بپیشش سه پاس"
  },
  {
    "poem_id": 52174,
    "vorder": 229,
    "position": 0,
    "text": "که خاقان چین کهتر ما بود"
  },
  {
    "poem_id": 52174,
    "vorder": 230,
    "position": 1,
    "text": "سپهر بلند افسر ما بود"
  },
  {
    "poem_id": 52174,
    "vorder": 231,
    "position": 0,
    "text": "همی سر به چرخ فلک بر فراخت"
  },
  {
    "poem_id": 52174,
    "vorder": 232,
    "position": 1,
    "text": "همی خویشتن شاه گیتی شناخت"
  },
  {
    "poem_id": 52174,
    "vorder": 233,
    "position": 0,
    "text": "کنون پیش برترمنش بنده‌ای"
  },
  {
    "poem_id": 52174,
    "vorder": 234,
    "position": 1,
    "text": "سپهبد سری گرد و جوینده‌ای"
  },
  {
    "poem_id": 52174,
    "vorder": 235,
    "position": 0,
    "text": "چنان شد که بر ما کند آفرین"
  },
  {
    "poem_id": 52174,
    "vorder": 236,
    "position": 1,
    "text": "سپهدار سالار ترکان چین"
  },
  {
    "poem_id": 52174,
    "vorder": 237,
    "position": 0,
    "text": "سپاس از خداوند خورشید وماه"
  },
  {
    "poem_id": 52174,
    "vorder": 238,
    "position": 1,
    "text": "کجا داد بر بهتری دستگاه"
  },
  {
    "poem_id": 52174,
    "vorder": 239,
    "position": 0,
    "text": "بدرویش بخشیم گنج کهن"
  },
  {
    "poem_id": 52174,
    "vorder": 240,
    "position": 1,
    "text": "چو پیدا شود راستی زین سخن"
  },
  {
    "poem_id": 52174,
    "vorder": 241,
    "position": 0,
    "text": "شما هم به یزدان نیایش کنید"
  },
  {
    "poem_id": 52174,
    "vorder": 242,
    "position": 1,
    "text": "همه نیکویی در فزایش کنید"
  },
  {
    "poem_id": 52174,
    "vorder": 243,
    "position": 0,
    "text": "فرستادهٔ پهلوان را بخواند"
  },
  {
    "poem_id": 52174,
    "vorder": 244,
    "position": 1,
    "text": "بچربی سخنها فراوان براند"
  },
  {
    "poem_id": 52174,
    "vorder": 245,
    "position": 0,
    "text": "کمر خواست پرگوهر شاهوار"
  },
  {
    "poem_id": 52174,
    "vorder": 246,
    "position": 1,
    "text": "یکی باره و جامه زرنگار"
  },
  {
    "poem_id": 52174,
    "vorder": 247,
    "position": 0,
    "text": "ستامی بران بارگی پر ز زر"
  },
  {
    "poem_id": 52174,
    "vorder": 248,
    "position": 1,
    "text": "به مهر مهره‌ای بر نشانده گهر"
  },
  {
    "poem_id": 52174,
    "vorder": 249,
    "position": 0,
    "text": "فرستاده را نیز دینار داد"
  },
  {
    "poem_id": 52174,
    "vorder": 250,
    "position": 1,
    "text": "یکی بدره و چیز بسیار داد"
  },
  {
    "poem_id": 52174,
    "vorder": 251,
    "position": 0,
    "text": "چو خلعت بدان مرد دانا سپرد"
  },
  {
    "poem_id": 52174,
    "vorder": 252,
    "position": 1,
    "text": "ورا مهتر پهلوانان شمرد"
  },
  {
    "poem_id": 52174,
    "vorder": 253,
    "position": 0,
    "text": "بفرمود پس تا بیامد دبیر"
  },
  {
    "poem_id": 52174,
    "vorder": 254,
    "position": 1,
    "text": "نبشتند زو نامه‌ای بر حریر"
  },
  {
    "poem_id": 52174,
    "vorder": 255,
    "position": 0,
    "text": "که پرموده خاقان چویار منست"
  },
  {
    "poem_id": 52174,
    "vorder": 256,
    "position": 1,
    "text": "بهرمزد در زینهار منست"
  },
  {
    "poem_id": 52174,
    "vorder": 257,
    "position": 0,
    "text": "برین مهر و منشور یزدان گواست"
  },
  {
    "poem_id": 52174,
    "vorder": 258,
    "position": 1,
    "text": "که ما بندگانیم و او پادشاست"
  },
  {
    "poem_id": 52174,
    "vorder": 259,
    "position": 0,
    "text": "جهانجوی را نیز پاسخ نبشت"
  },
  {
    "poem_id": 52174,
    "vorder": 260,
    "position": 1,
    "text": "پر از آرزو نامه‌ای چون بهشت"
  },
  {
    "poem_id": 52174,
    "vorder": 261,
    "position": 0,
    "text": "بدو گفت پرموده را با سپاه"
  },
  {
    "poem_id": 52174,
    "vorder": 262,
    "position": 1,
    "text": "گسی کن بخوبی بدین بارگاه"
  },
  {
    "poem_id": 52174,
    "vorder": 263,
    "position": 0,
    "text": "غنیمت که ازلشکرش یافتی"
  },
  {
    "poem_id": 52174,
    "vorder": 264,
    "position": 1,
    "text": "بدان بندگی تیز بشتافتی"
  },
  {
    "poem_id": 52174,
    "vorder": 265,
    "position": 0,
    "text": "بدرگه فرست آنچ اندر خورست"
  },
  {
    "poem_id": 52174,
    "vorder": 266,
    "position": 1,
    "text": "تو را کردگار جهان یاورست"
  },
  {
    "poem_id": 52174,
    "vorder": 267,
    "position": 0,
    "text": "نگه کن بجایی که دشمن بود"
  },
  {
    "poem_id": 52174,
    "vorder": 268,
    "position": 1,
    "text": "وگر دشمنی را نشیمن بود"
  },
  {
    "poem_id": 52174,
    "vorder": 269,
    "position": 0,
    "text": "بگیر ونگه دار وخانش بسوز"
  },
  {
    "poem_id": 52174,
    "vorder": 270,
    "position": 1,
    "text": "به فرخ پی وفال گیتی فروز"
  },
  {
    "poem_id": 52174,
    "vorder": 271,
    "position": 0,
    "text": "گر ای دون که لشکر فزون بایدت"
  },
  {
    "poem_id": 52174,
    "vorder": 272,
    "position": 1,
    "text": "فزونتر بود رنج بگزایدت"
  },
  {
    "poem_id": 52174,
    "vorder": 273,
    "position": 0,
    "text": "بدین نامهٔ دیگر از من بخواه"
  },
  {
    "poem_id": 52174,
    "vorder": 274,
    "position": 1,
    "text": "فرستیم چندانک باید سپاه"
  },
  {
    "poem_id": 52174,
    "vorder": 275,
    "position": 0,
    "text": "وز ایرانیان هرکه نزدیک تست"
  },
  {
    "poem_id": 52174,
    "vorder": 276,
    "position": 1,
    "text": "که کردی همه راستی را درست"
  },
  {
    "poem_id": 52174,
    "vorder": 277,
    "position": 0,
    "text": "بدین نامه در نام ایشان ببر"
  },
  {
    "poem_id": 52174,
    "vorder": 278,
    "position": 1,
    "text": "ز رنجی که بردند یابند بر"
  },
  {
    "poem_id": 52174,
    "vorder": 279,
    "position": 0,
    "text": "سپاه تو را مرزبانی دهم"
  },
  {
    "poem_id": 52174,
    "vorder": 280,
    "position": 1,
    "text": "تو را افسر و پهلوانی دهم"
  },
  {
    "poem_id": 52174,
    "vorder": 281,
    "position": 0,
    "text": "چو نامه بیامد بر پهلوان"
  },
  {
    "poem_id": 52174,
    "vorder": 282,
    "position": 1,
    "text": "دل پهلو نامور شد جوان"
  },
  {
    "poem_id": 52174,
    "vorder": 283,
    "position": 0,
    "text": "ازان نامه اندر شگفتی بماند"
  },
  {
    "poem_id": 52174,
    "vorder": 284,
    "position": 1,
    "text": "فرستاده و ایرانیان را بخواند"
  },
  {
    "poem_id": 52174,
    "vorder": 285,
    "position": 0,
    "text": "همان خلعت شاه پیش آورید"
  },
  {
    "poem_id": 52174,
    "vorder": 286,
    "position": 1,
    "text": "برو آفرین کرد هرکس که دید"
  },
  {
    "poem_id": 52174,
    "vorder": 287,
    "position": 0,
    "text": "سخنهای ایرانیان هرچ بود"
  },
  {
    "poem_id": 52174,
    "vorder": 288,
    "position": 1,
    "text": "بران نامه اندر بدیشان نمود"
  },
  {
    "poem_id": 52174,
    "vorder": 289,
    "position": 0,
    "text": "ز گردان برآمد یکی آفرین"
  },
  {
    "poem_id": 52174,
    "vorder": 290,
    "position": 1,
    "text": "که گفتی بجنبید روی زمین"
  },
  {
    "poem_id": 52174,
    "vorder": 291,
    "position": 0,
    "text": "همان نامور نامهٔ زینهار"
  },
  {
    "poem_id": 52174,
    "vorder": 292,
    "position": 1,
    "text": "که پرموده را آمد از شهریار"
  },
  {
    "poem_id": 52174,
    "vorder": 293,
    "position": 0,
    "text": "بدان دز فرستاد نزدیک اوی"
  },
  {
    "poem_id": 52174,
    "vorder": 294,
    "position": 1,
    "text": "درخشنده شد جان تاریک اوی"
  },
  {
    "poem_id": 52174,
    "vorder": 295,
    "position": 0,
    "text": "فرود آمد از بارهٔ نامدار"
  },
  {
    "poem_id": 52174,
    "vorder": 296,
    "position": 1,
    "text": "بسی آفرین خواند برشهریار"
  },
  {
    "poem_id": 52174,
    "vorder": 297,
    "position": 0,
    "text": "همه خواسته هرچ بد در حصار"
  },
  {
    "poem_id": 52174,
    "vorder": 298,
    "position": 1,
    "text": "نبشتند چیزی که آید به کار"
  },
  {
    "poem_id": 52174,
    "vorder": 299,
    "position": 0,
    "text": "فرود آمد از دز سرافراز مرد"
  },
  {
    "poem_id": 52174,
    "vorder": 300,
    "position": 1,
    "text": "باسب نبرد اندر آمد چوگرد"
  },
  {
    "poem_id": 52174,
    "vorder": 301,
    "position": 0,
    "text": "همی‌رفت با لشکر از دز به راه"
  },
  {
    "poem_id": 52174,
    "vorder": 302,
    "position": 1,
    "text": "نکرد ایچ بهرام یل را نگاه"
  },
  {
    "poem_id": 52174,
    "vorder": 303,
    "position": 0,
    "text": "چوآن دید بهرام ننگ آمدش"
  },
  {
    "poem_id": 52174,
    "vorder": 304,
    "position": 1,
    "text": "وگر چند شاهی بچنگ آمدش"
  },
  {
    "poem_id": 52174,
    "vorder": 305,
    "position": 0,
    "text": "فرستاد و او را همانگه ز راه"
  },
  {
    "poem_id": 52174,
    "vorder": 306,
    "position": 1,
    "text": "پیاده بیاورد پیش سپاه"
  },
  {
    "poem_id": 52174,
    "vorder": 307,
    "position": 0,
    "text": "چنین گفت پرموده او را که من"
  },
  {
    "poem_id": 52174,
    "vorder": 308,
    "position": 1,
    "text": "سرافراز بودم بهر انجمن"
  },
  {
    "poem_id": 52174,
    "vorder": 309,
    "position": 0,
    "text": "کنون بی‌منش زینهاری شدم"
  },
  {
    "poem_id": 52174,
    "vorder": 310,
    "position": 1,
    "text": "ز ارج بلندی بخواری شدم"
  },
  {
    "poem_id": 52174,
    "vorder": 311,
    "position": 0,
    "text": "بدین روز خود نیستی خوش منش"
  },
  {
    "poem_id": 52174,
    "vorder": 312,
    "position": 1,
    "text": "که پیش آمدم ای بد بد کنش"
  },
  {
    "poem_id": 52174,
    "vorder": 313,
    "position": 0,
    "text": "کنون یافتم نامهٔ زینهار"
  },
  {
    "poem_id": 52174,
    "vorder": 314,
    "position": 1,
    "text": "همی‌رفت خواهم بر شهریار"
  },
  {
    "poem_id": 52174,
    "vorder": 315,
    "position": 0,
    "text": "مگر با من او چون برادر شود"
  },
  {
    "poem_id": 52174,
    "vorder": 316,
    "position": 1,
    "text": "ازو رنج بر من سبکتر شود"
  },
  {
    "poem_id": 52174,
    "vorder": 317,
    "position": 0,
    "text": "تو را با من اکنون چه کارست نیز"
  },
  {
    "poem_id": 52174,
    "vorder": 318,
    "position": 1,
    "text": "سپردم تو را تخت شاهی و چیز"
  }
]