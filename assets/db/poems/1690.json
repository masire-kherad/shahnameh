[
  {
    "poem_id": 1690,
    "vorder": 1,
    "position": 0,
    "text": "چو نه ماه بگذشت بر ماه‌چهر"
  },
  {
    "poem_id": 1690,
    "vorder": 2,
    "position": 1,
    "text": "یکی کودک آمد چو تابنده مهر"
  },
  {
    "poem_id": 1690,
    "vorder": 3,
    "position": 0,
    "text": "به مانندهٔ نامدار اردشیر"
  },
  {
    "poem_id": 1690,
    "vorder": 4,
    "position": 1,
    "text": "فزاینده و فرخ و دلپذیر"
  },
  {
    "poem_id": 1690,
    "vorder": 5,
    "position": 0,
    "text": "همان اردشیرش پدر کرد نام"
  },
  {
    "poem_id": 1690,
    "vorder": 6,
    "position": 1,
    "text": "نیا شد به دیدار او شادکام"
  },
  {
    "poem_id": 1690,
    "vorder": 7,
    "position": 0,
    "text": "همی پروریدش به بربر به ناز"
  },
  {
    "poem_id": 1690,
    "vorder": 8,
    "position": 1,
    "text": "برآمد برین روزگاری دراز"
  },
  {
    "poem_id": 1690,
    "vorder": 9,
    "position": 0,
    "text": "مر او را کنون مردم تیزویر"
  },
  {
    "poem_id": 1690,
    "vorder": 10,
    "position": 1,
    "text": "همی خواندش بابکان اردشیر"
  },
  {
    "poem_id": 1690,
    "vorder": 11,
    "position": 0,
    "text": "بیاموختندش هنر هرچ بود"
  },
  {
    "poem_id": 1690,
    "vorder": 12,
    "position": 1,
    "text": "هنر نیز بر گوهرش بر فزود"
  },
  {
    "poem_id": 1690,
    "vorder": 13,
    "position": 0,
    "text": "چنان شد به دیدار و فرهنگ و چهر"
  },
  {
    "poem_id": 1690,
    "vorder": 14,
    "position": 1,
    "text": "که گفتی همی زو فروزد سپهر"
  },
  {
    "poem_id": 1690,
    "vorder": 15,
    "position": 0,
    "text": "پس آگاهی آمد سوی اردوان"
  },
  {
    "poem_id": 1690,
    "vorder": 16,
    "position": 1,
    "text": "ز فرهنگ وز دانش آن جوان"
  },
  {
    "poem_id": 1690,
    "vorder": 17,
    "position": 0,
    "text": "که شیر ژیانست هنگام رزم"
  },
  {
    "poem_id": 1690,
    "vorder": 18,
    "position": 1,
    "text": "به ناهید ماند همی روز بزم"
  },
  {
    "poem_id": 1690,
    "vorder": 19,
    "position": 0,
    "text": "یکی نامه بنوشت پس اردوان"
  },
  {
    "poem_id": 1690,
    "vorder": 20,
    "position": 1,
    "text": "سوی بابک نامور پهلوان"
  },
  {
    "poem_id": 1690,
    "vorder": 21,
    "position": 0,
    "text": "که ای مرد بادانش و رهنمای"
  },
  {
    "poem_id": 1690,
    "vorder": 22,
    "position": 1,
    "text": "سخن‌گوی و با نام و پاکیزه‌رای"
  },
  {
    "poem_id": 1690,
    "vorder": 23,
    "position": 0,
    "text": "شنیدم که فرزند تو اردشیر"
  },
  {
    "poem_id": 1690,
    "vorder": 24,
    "position": 1,
    "text": "سواریست گوینده و یادگیر"
  },
  {
    "poem_id": 1690,
    "vorder": 25,
    "position": 0,
    "text": "چو نامه بخوانی هم‌اندر زمان"
  },
  {
    "poem_id": 1690,
    "vorder": 26,
    "position": 1,
    "text": "فرستش به نزدیک ما شادمان"
  },
  {
    "poem_id": 1690,
    "vorder": 27,
    "position": 0,
    "text": "ز بایسته‌ها بی‌نیازش کنم"
  },
  {
    "poem_id": 1690,
    "vorder": 28,
    "position": 1,
    "text": "میان یلان سرفرازش کنم"
  },
  {
    "poem_id": 1690,
    "vorder": 29,
    "position": 0,
    "text": "چو باشد به نزدیک فرزند ما"
  },
  {
    "poem_id": 1690,
    "vorder": 30,
    "position": 1,
    "text": "نگوییم کو نیست پیوند ما"
  },
  {
    "poem_id": 1690,
    "vorder": 31,
    "position": 0,
    "text": "چو آن نامهٔ شاه بابک بخواند"
  },
  {
    "poem_id": 1690,
    "vorder": 32,
    "position": 1,
    "text": "بسی خون مژگان به رخ برفشاند"
  },
  {
    "poem_id": 1690,
    "vorder": 33,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1690,
    "vorder": 34,
    "position": 1,
    "text": "همان نورسیده جوان اردشیر"
  },
  {
    "poem_id": 1690,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت کاین نامهٔ اردوان"
  },
  {
    "poem_id": 1690,
    "vorder": 36,
    "position": 1,
    "text": "بخوان و نگه‌کن به روشن روان"
  },
  {
    "poem_id": 1690,
    "vorder": 37,
    "position": 0,
    "text": "من اینک یکی نامه نزدیک شاه"
  },
  {
    "poem_id": 1690,
    "vorder": 38,
    "position": 1,
    "text": "نویسم فرستم یکی نیک‌خواه"
  },
  {
    "poem_id": 1690,
    "vorder": 39,
    "position": 0,
    "text": "بگویم که اینک دل و دیده را"
  },
  {
    "poem_id": 1690,
    "vorder": 40,
    "position": 1,
    "text": "دلاور جوان پسندیده را"
  },
  {
    "poem_id": 1690,
    "vorder": 41,
    "position": 0,
    "text": "فرستادم و دادمش نیز پند"
  },
  {
    "poem_id": 1690,
    "vorder": 42,
    "position": 1,
    "text": "چو آید بدان بارگاه بلند"
  },
  {
    "poem_id": 1690,
    "vorder": 43,
    "position": 0,
    "text": "تو آن کن که از رسم شاهان سزد"
  },
  {
    "poem_id": 1690,
    "vorder": 44,
    "position": 1,
    "text": "نباید که بادی برو بر وزد"
  },
  {
    "poem_id": 1690,
    "vorder": 45,
    "position": 0,
    "text": "در گنج بگشاد بابک چو باد"
  },
  {
    "poem_id": 1690,
    "vorder": 46,
    "position": 1,
    "text": "جوان را ز هرگونه‌ای کرد شاد"
  },
  {
    "poem_id": 1690,
    "vorder": 47,
    "position": 0,
    "text": "ز زرین ستام و ز گوپال و تیغ"
  },
  {
    "poem_id": 1690,
    "vorder": 48,
    "position": 1,
    "text": "ز فرزند چیزش نیامد دریغ"
  },
  {
    "poem_id": 1690,
    "vorder": 49,
    "position": 0,
    "text": "ز دینار و دیبا و اسپ و رهی"
  },
  {
    "poem_id": 1690,
    "vorder": 50,
    "position": 1,
    "text": "ز چینی و زربفت شاهنشهی"
  },
  {
    "poem_id": 1690,
    "vorder": 51,
    "position": 0,
    "text": "بیاورد و بنهاد پیش جوان"
  },
  {
    "poem_id": 1690,
    "vorder": 52,
    "position": 1,
    "text": "جوان شد پرستندهٔ اردوان"
  },
  {
    "poem_id": 1690,
    "vorder": 53,
    "position": 0,
    "text": "بسی هدیه‌ها نیز با اردشیر"
  },
  {
    "poem_id": 1690,
    "vorder": 54,
    "position": 1,
    "text": "ز دیبا و دینار و مشک و عبیر"
  },
  {
    "poem_id": 1690,
    "vorder": 55,
    "position": 0,
    "text": "ز پیش نیا کودک نیک پی"
  },
  {
    "poem_id": 1690,
    "vorder": 56,
    "position": 1,
    "text": "به درگاه شاه اردوان شد بری"
  }
]