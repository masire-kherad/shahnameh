[
  {
    "poem_id": 1726,
    "vorder": 1,
    "position": 0,
    "text": "چو دانست کز مرگ نتوان گریخت"
  },
  {
    "poem_id": 1726,
    "vorder": 2,
    "position": 1,
    "text": "بسی آب خونین ز دیده بریخت"
  },
  {
    "poem_id": 1726,
    "vorder": 3,
    "position": 0,
    "text": "بگسترد فرش اندر ایوان خویش"
  },
  {
    "poem_id": 1726,
    "vorder": 4,
    "position": 1,
    "text": "بفرمود کامدش بهرام پیش"
  },
  {
    "poem_id": 1726,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کای پاک‌زاده پسر"
  },
  {
    "poem_id": 1726,
    "vorder": 6,
    "position": 1,
    "text": "به مردی و دانش برآورده سر"
  },
  {
    "poem_id": 1726,
    "vorder": 7,
    "position": 0,
    "text": "به من پادشاهی نهادست روی"
  },
  {
    "poem_id": 1726,
    "vorder": 8,
    "position": 1,
    "text": "که رنگ رخم کرد همرنگ موی"
  },
  {
    "poem_id": 1726,
    "vorder": 9,
    "position": 0,
    "text": "خم آورد بالای سرو سهی"
  },
  {
    "poem_id": 1726,
    "vorder": 10,
    "position": 1,
    "text": "گل سرخ را داد رنگ بهی"
  },
  {
    "poem_id": 1726,
    "vorder": 11,
    "position": 0,
    "text": "چو روز تو آمد جهاندار باش"
  },
  {
    "poem_id": 1726,
    "vorder": 12,
    "position": 1,
    "text": "خردمند باش و بی‌آزار باش"
  },
  {
    "poem_id": 1726,
    "vorder": 13,
    "position": 0,
    "text": "نگر تا نپیچی سر از دادخواه"
  },
  {
    "poem_id": 1726,
    "vorder": 14,
    "position": 1,
    "text": "نبخشی ستمکارگان را گناه"
  },
  {
    "poem_id": 1726,
    "vorder": 15,
    "position": 0,
    "text": "زبان را مگردان به گرد دروغ"
  },
  {
    "poem_id": 1726,
    "vorder": 16,
    "position": 1,
    "text": "چو خواهی که تاج از تو گیرد فروغ"
  },
  {
    "poem_id": 1726,
    "vorder": 17,
    "position": 0,
    "text": "روانت خرد باد و دستور شرم"
  },
  {
    "poem_id": 1726,
    "vorder": 18,
    "position": 1,
    "text": "سخن گفتن خوب و آواز نرم"
  },
  {
    "poem_id": 1726,
    "vorder": 19,
    "position": 0,
    "text": "خداوند پیروز یار تو باد"
  },
  {
    "poem_id": 1726,
    "vorder": 20,
    "position": 1,
    "text": "دل زیردستان شکار تو باد"
  },
  {
    "poem_id": 1726,
    "vorder": 21,
    "position": 0,
    "text": "بنه کینه و دور باش از هوا"
  },
  {
    "poem_id": 1726,
    "vorder": 22,
    "position": 1,
    "text": "مبادا هوا بر تو فرمانروا"
  },
  {
    "poem_id": 1726,
    "vorder": 23,
    "position": 0,
    "text": "سخن چین و بی‌دانش و چاره‌گر"
  },
  {
    "poem_id": 1726,
    "vorder": 24,
    "position": 1,
    "text": "نباید که یابد به پیشت گذر"
  },
  {
    "poem_id": 1726,
    "vorder": 25,
    "position": 0,
    "text": "ز نادان نیابی جز از بتری"
  },
  {
    "poem_id": 1726,
    "vorder": 26,
    "position": 1,
    "text": "نگر سوی بی‌دانشان ننگری"
  },
  {
    "poem_id": 1726,
    "vorder": 27,
    "position": 0,
    "text": "چنان دان که بی‌شرم و بسیارگوی"
  },
  {
    "poem_id": 1726,
    "vorder": 28,
    "position": 1,
    "text": "نبیند به نزد کسی آب‌روی"
  },
  {
    "poem_id": 1726,
    "vorder": 29,
    "position": 0,
    "text": "خرد را مه و خشم را بنده‌دار"
  },
  {
    "poem_id": 1726,
    "vorder": 30,
    "position": 1,
    "text": "مشو تیز با مرد پرهیزگار"
  },
  {
    "poem_id": 1726,
    "vorder": 31,
    "position": 0,
    "text": "نگر تا نگردد به گرد تو آز"
  },
  {
    "poem_id": 1726,
    "vorder": 32,
    "position": 1,
    "text": "که آز آورد خشم و بیم و نیاز"
  },
  {
    "poem_id": 1726,
    "vorder": 33,
    "position": 0,
    "text": "همه بردباری کن و راستی"
  },
  {
    "poem_id": 1726,
    "vorder": 34,
    "position": 1,
    "text": "جدا کن ز دل کژی و کاستی"
  },
  {
    "poem_id": 1726,
    "vorder": 35,
    "position": 0,
    "text": "بپرهیز تا بد نگرددت نام"
  },
  {
    "poem_id": 1726,
    "vorder": 36,
    "position": 1,
    "text": "که بدنام گیتی نبیند به کام"
  },
  {
    "poem_id": 1726,
    "vorder": 37,
    "position": 0,
    "text": "ز راه خرد ایچ گونه متاب"
  },
  {
    "poem_id": 1726,
    "vorder": 38,
    "position": 1,
    "text": "پشیمانی آرد دلت را شتاب"
  },
  {
    "poem_id": 1726,
    "vorder": 39,
    "position": 0,
    "text": "درنگ آورد راستیها پدید"
  },
  {
    "poem_id": 1726,
    "vorder": 40,
    "position": 1,
    "text": "ز راه خرد سر نباید کشید"
  },
  {
    "poem_id": 1726,
    "vorder": 41,
    "position": 0,
    "text": "سر بردباران نیاید به خشم"
  },
  {
    "poem_id": 1726,
    "vorder": 42,
    "position": 1,
    "text": "ز نابودنیها بخوابند چشم"
  },
  {
    "poem_id": 1726,
    "vorder": 43,
    "position": 0,
    "text": "وگر بردباری ز حد بگذرد"
  },
  {
    "poem_id": 1726,
    "vorder": 44,
    "position": 1,
    "text": "دلاور گمانی به سستی برد"
  },
  {
    "poem_id": 1726,
    "vorder": 45,
    "position": 0,
    "text": "هرانکس که باشد خداوند گاه"
  },
  {
    "poem_id": 1726,
    "vorder": 46,
    "position": 1,
    "text": "میانجی خرد را کند بر دو راه"
  },
  {
    "poem_id": 1726,
    "vorder": 47,
    "position": 0,
    "text": "نه سستی نه تیزی به کاراندرون"
  },
  {
    "poem_id": 1726,
    "vorder": 48,
    "position": 1,
    "text": "خرد باد جان ترا رهنمون"
  },
  {
    "poem_id": 1726,
    "vorder": 49,
    "position": 0,
    "text": "نگه دار تا مردم عیب‌جوی"
  },
  {
    "poem_id": 1726,
    "vorder": 50,
    "position": 1,
    "text": "نجوید به نزدیک تو آب‌روی"
  },
  {
    "poem_id": 1726,
    "vorder": 51,
    "position": 0,
    "text": "ز دشمن مکن دوستی خواستار"
  },
  {
    "poem_id": 1726,
    "vorder": 52,
    "position": 1,
    "text": "وگر چند خواند ترا شهریار"
  },
  {
    "poem_id": 1726,
    "vorder": 53,
    "position": 0,
    "text": "درختی بود سبز و بارش کبست"
  },
  {
    "poem_id": 1726,
    "vorder": 54,
    "position": 1,
    "text": "وگر پای گیری سر آید به دست"
  },
  {
    "poem_id": 1726,
    "vorder": 55,
    "position": 0,
    "text": "اگر در فرازی و گر در نشیب"
  },
  {
    "poem_id": 1726,
    "vorder": 56,
    "position": 1,
    "text": "نباید نهادن سر اندر فریب"
  },
  {
    "poem_id": 1726,
    "vorder": 57,
    "position": 0,
    "text": "به دل نیز اندیشهٔ بد مدار"
  },
  {
    "poem_id": 1726,
    "vorder": 58,
    "position": 1,
    "text": "بداندیش را بد بود روزگار"
  },
  {
    "poem_id": 1726,
    "vorder": 59,
    "position": 0,
    "text": "سپهبد کجا گشت پیمان‌شکن"
  },
  {
    "poem_id": 1726,
    "vorder": 60,
    "position": 1,
    "text": "بخندد بدو نامدار انجمن"
  },
  {
    "poem_id": 1726,
    "vorder": 61,
    "position": 0,
    "text": "خردگیر کآرایش جان تست"
  },
  {
    "poem_id": 1726,
    "vorder": 62,
    "position": 1,
    "text": "نگهدار گفتار و پیمان تست"
  },
  {
    "poem_id": 1726,
    "vorder": 63,
    "position": 0,
    "text": "هم آرایش تاج و گنج و سپاه"
  },
  {
    "poem_id": 1726,
    "vorder": 64,
    "position": 1,
    "text": "نمایندهٔ گردش هور و ماه"
  },
  {
    "poem_id": 1726,
    "vorder": 65,
    "position": 0,
    "text": "نگر تا نسازی ز بازوی گنج"
  },
  {
    "poem_id": 1726,
    "vorder": 66,
    "position": 1,
    "text": "که بر تو سرآید سرای سپنج"
  },
  {
    "poem_id": 1726,
    "vorder": 67,
    "position": 0,
    "text": "مزن رای جز با خردمند مرد"
  },
  {
    "poem_id": 1726,
    "vorder": 68,
    "position": 1,
    "text": "از آیین شاهان پیشی مگرد"
  },
  {
    "poem_id": 1726,
    "vorder": 69,
    "position": 0,
    "text": "به لشکر بترسان بداندیش را"
  },
  {
    "poem_id": 1726,
    "vorder": 70,
    "position": 1,
    "text": "به ژرفی نگه کن پس و پیش را"
  },
  {
    "poem_id": 1726,
    "vorder": 71,
    "position": 0,
    "text": "ستاینده‌ای کو ز بهر هوا"
  },
  {
    "poem_id": 1726,
    "vorder": 72,
    "position": 1,
    "text": "ستاید کسی را همی ناسزا"
  },
  {
    "poem_id": 1726,
    "vorder": 73,
    "position": 0,
    "text": "شکست تو جوید همی زان سخن"
  },
  {
    "poem_id": 1726,
    "vorder": 74,
    "position": 1,
    "text": "ممان تا به پیش تو گردد کهن"
  },
  {
    "poem_id": 1726,
    "vorder": 75,
    "position": 0,
    "text": "کسی کش ستایش بیاید به کار"
  },
  {
    "poem_id": 1726,
    "vorder": 76,
    "position": 1,
    "text": "تو او را ز گیتی به مردم مدار"
  },
  {
    "poem_id": 1726,
    "vorder": 77,
    "position": 0,
    "text": "که یزدان ستایش نخواهد همی"
  },
  {
    "poem_id": 1726,
    "vorder": 78,
    "position": 1,
    "text": "نکوهیده را دل بکاهد همی"
  },
  {
    "poem_id": 1726,
    "vorder": 79,
    "position": 0,
    "text": "هرانکس که او از گنهکار چشم"
  },
  {
    "poem_id": 1726,
    "vorder": 80,
    "position": 1,
    "text": "بخوابید و آسان فرو برد خشم"
  },
  {
    "poem_id": 1726,
    "vorder": 81,
    "position": 0,
    "text": "فزونیش هر روز افزون شود"
  },
  {
    "poem_id": 1726,
    "vorder": 82,
    "position": 1,
    "text": "شتاب آورد دل پر از خون شود"
  },
  {
    "poem_id": 1726,
    "vorder": 83,
    "position": 0,
    "text": "هرانکس که با آب دریا نبرد"
  },
  {
    "poem_id": 1726,
    "vorder": 84,
    "position": 1,
    "text": "بجوید نباشد خردمند مرد"
  },
  {
    "poem_id": 1726,
    "vorder": 85,
    "position": 0,
    "text": "کمان دار دل را زبانت چو تیر"
  },
  {
    "poem_id": 1726,
    "vorder": 86,
    "position": 1,
    "text": "تو این گفته‌های من آسان مگیر"
  },
  {
    "poem_id": 1726,
    "vorder": 87,
    "position": 0,
    "text": "گشاد پرت باشد و دست راست"
  },
  {
    "poem_id": 1726,
    "vorder": 88,
    "position": 1,
    "text": "نشانه بنه زان نشان کت هواست"
  },
  {
    "poem_id": 1726,
    "vorder": 89,
    "position": 0,
    "text": "زبان و خرد با دلت راست کن"
  },
  {
    "poem_id": 1726,
    "vorder": 90,
    "position": 1,
    "text": "همی ران ازان سان که خواهی سخن"
  },
  {
    "poem_id": 1726,
    "vorder": 91,
    "position": 0,
    "text": "هرانکس که اندر سرش مغز بود"
  },
  {
    "poem_id": 1726,
    "vorder": 92,
    "position": 1,
    "text": "همه رای و گفتار او نغز بود"
  },
  {
    "poem_id": 1726,
    "vorder": 93,
    "position": 0,
    "text": "هرانگه که باشی تو با رای‌زن"
  },
  {
    "poem_id": 1726,
    "vorder": 94,
    "position": 1,
    "text": "سخنها بیارای بی‌انجمن"
  },
  {
    "poem_id": 1726,
    "vorder": 95,
    "position": 0,
    "text": "گرت رای با آزمایش بود"
  },
  {
    "poem_id": 1726,
    "vorder": 96,
    "position": 1,
    "text": "همه روزت اندر فزایش بود"
  },
  {
    "poem_id": 1726,
    "vorder": 97,
    "position": 0,
    "text": "شود جانت از دشمن آژیرتر"
  },
  {
    "poem_id": 1726,
    "vorder": 98,
    "position": 1,
    "text": "دل و مغز و رایت جهانگیرتر"
  },
  {
    "poem_id": 1726,
    "vorder": 99,
    "position": 0,
    "text": "کسی را کجا پیش رو شد هوا"
  },
  {
    "poem_id": 1726,
    "vorder": 100,
    "position": 1,
    "text": "چنان دان که رایش نگیرد نوا"
  },
  {
    "poem_id": 1726,
    "vorder": 101,
    "position": 0,
    "text": "اگر دوست یابد ترا تازه‌روی"
  },
  {
    "poem_id": 1726,
    "vorder": 102,
    "position": 1,
    "text": "بیفزاید این نام را رنگ و بوی"
  },
  {
    "poem_id": 1726,
    "vorder": 103,
    "position": 0,
    "text": "تو با دشمنت رو پر آژنگ دار"
  },
  {
    "poem_id": 1726,
    "vorder": 104,
    "position": 1,
    "text": "بداندیش را چهره بی‌رنگ دار"
  },
  {
    "poem_id": 1726,
    "vorder": 105,
    "position": 0,
    "text": "به ارزانیان بخش هرچت هواست"
  },
  {
    "poem_id": 1726,
    "vorder": 106,
    "position": 1,
    "text": "که گنج تو ارزانیان را سزاست"
  },
  {
    "poem_id": 1726,
    "vorder": 107,
    "position": 0,
    "text": "بکش جان و دل تا توانی ز رشک"
  },
  {
    "poem_id": 1726,
    "vorder": 108,
    "position": 1,
    "text": "که رشک آورد گرم و خونین سرشک"
  },
  {
    "poem_id": 1726,
    "vorder": 109,
    "position": 0,
    "text": "هرانگه که رشک آورد پادشا"
  },
  {
    "poem_id": 1726,
    "vorder": 110,
    "position": 1,
    "text": "نکوهش کند مردم پارسا"
  },
  {
    "poem_id": 1726,
    "vorder": 111,
    "position": 0,
    "text": "چو اندرز بنوشت فرخ دبیر"
  },
  {
    "poem_id": 1726,
    "vorder": 112,
    "position": 1,
    "text": "بیاورد و بنهاد پیش وزیر"
  },
  {
    "poem_id": 1726,
    "vorder": 113,
    "position": 0,
    "text": "جهاندار برزد یکی باد سرد"
  },
  {
    "poem_id": 1726,
    "vorder": 114,
    "position": 1,
    "text": "پس آن لعل رخسارگان کرد زرد"
  },
  {
    "poem_id": 1726,
    "vorder": 115,
    "position": 0,
    "text": "چو رنگین رخ تاجور تیره شد"
  },
  {
    "poem_id": 1726,
    "vorder": 116,
    "position": 1,
    "text": "ازان درد بهرام دل خیره شد"
  },
  {
    "poem_id": 1726,
    "vorder": 117,
    "position": 0,
    "text": "چهل روز بد سوکوار و نژند"
  },
  {
    "poem_id": 1726,
    "vorder": 118,
    "position": 1,
    "text": "پر از گرد و بیکار تخت بلند"
  },
  {
    "poem_id": 1726,
    "vorder": 119,
    "position": 0,
    "text": "چنین بود تا بود گردان سپهر"
  },
  {
    "poem_id": 1726,
    "vorder": 120,
    "position": 1,
    "text": "گهی پر ز درد و گهی پر ز مهر"
  },
  {
    "poem_id": 1726,
    "vorder": 121,
    "position": 0,
    "text": "تو گر باهشی مشمر او را به دوست"
  },
  {
    "poem_id": 1726,
    "vorder": 122,
    "position": 1,
    "text": "کجا دست یابد بدردت پوست"
  },
  {
    "poem_id": 1726,
    "vorder": 123,
    "position": 0,
    "text": "شب اورمزد آمد و ماه دی"
  },
  {
    "poem_id": 1726,
    "vorder": 124,
    "position": 1,
    "text": "ز گفتن بیاسای و بردار می"
  },
  {
    "poem_id": 1726,
    "vorder": 125,
    "position": 0,
    "text": "کنون کار دیهیم بهرام ساز"
  },
  {
    "poem_id": 1726,
    "vorder": 126,
    "position": 1,
    "text": "که در پادشاهی نماند دراز"
  }
]