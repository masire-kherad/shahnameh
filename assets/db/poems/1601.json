[
  {
    "poem_id": 1601,
    "vorder": 1,
    "position": 0,
    "text": "سپیده همانگه ز که بر دمید"
  },
  {
    "poem_id": 1601,
    "vorder": 2,
    "position": 1,
    "text": "میان شب تیره اندر چمید"
  },
  {
    "poem_id": 1601,
    "vorder": 3,
    "position": 0,
    "text": "بپوشید رستم سلیح نبرد"
  },
  {
    "poem_id": 1601,
    "vorder": 4,
    "position": 1,
    "text": "همی از جهان آفرین یاد کرد"
  },
  {
    "poem_id": 1601,
    "vorder": 5,
    "position": 0,
    "text": "چو آمد بر لشکر نامدار"
  },
  {
    "poem_id": 1601,
    "vorder": 6,
    "position": 1,
    "text": "که کین جوید از رزم اسفندیار"
  },
  {
    "poem_id": 1601,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت برخیز ازین خواب خوش"
  },
  {
    "poem_id": 1601,
    "vorder": 8,
    "position": 1,
    "text": "برآویز با رستم کینه‌کش"
  },
  {
    "poem_id": 1601,
    "vorder": 9,
    "position": 0,
    "text": "چو بشنید آوازش اسفندیار"
  },
  {
    "poem_id": 1601,
    "vorder": 10,
    "position": 1,
    "text": "سلیح جهان پیش او گشت خوار"
  },
  {
    "poem_id": 1601,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت پس با پشوتن که شیر"
  },
  {
    "poem_id": 1601,
    "vorder": 12,
    "position": 1,
    "text": "بپیچد ز چنگال مرد دلیر"
  },
  {
    "poem_id": 1601,
    "vorder": 13,
    "position": 0,
    "text": "گمانی نبردم که رستم ز راه"
  },
  {
    "poem_id": 1601,
    "vorder": 14,
    "position": 1,
    "text": "به ایوان کشد ببر و گبر و کلاه"
  },
  {
    "poem_id": 1601,
    "vorder": 15,
    "position": 0,
    "text": "همان بارکش رخش زیراندرش"
  },
  {
    "poem_id": 1601,
    "vorder": 16,
    "position": 1,
    "text": "ز پیکان نبود ایچ پیدا برش"
  },
  {
    "poem_id": 1601,
    "vorder": 17,
    "position": 0,
    "text": "شنیدم که دستان جادوپرست"
  },
  {
    "poem_id": 1601,
    "vorder": 18,
    "position": 1,
    "text": "به هنگام یازد به خورشید دست"
  },
  {
    "poem_id": 1601,
    "vorder": 19,
    "position": 0,
    "text": "چو خشم آرد از جادوان بگذرد"
  },
  {
    "poem_id": 1601,
    "vorder": 20,
    "position": 1,
    "text": "برابر نکردم پس این با خرد"
  },
  {
    "poem_id": 1601,
    "vorder": 21,
    "position": 0,
    "text": "پشوتن بدو گفت پر آب چشم"
  },
  {
    "poem_id": 1601,
    "vorder": 22,
    "position": 1,
    "text": "که بر دشمنت باد تیمار و خشم"
  },
  {
    "poem_id": 1601,
    "vorder": 23,
    "position": 0,
    "text": "چه بودت که امروز پژمرده‌ای"
  },
  {
    "poem_id": 1601,
    "vorder": 24,
    "position": 1,
    "text": "همانا به شب خواب نشمرده‌ای"
  },
  {
    "poem_id": 1601,
    "vorder": 25,
    "position": 0,
    "text": "میان جهان این دو یل را چه بود"
  },
  {
    "poem_id": 1601,
    "vorder": 26,
    "position": 1,
    "text": "که چندین همی رنج باید فزود"
  },
  {
    "poem_id": 1601,
    "vorder": 27,
    "position": 0,
    "text": "بدانم که بخت تو شد کندرو"
  },
  {
    "poem_id": 1601,
    "vorder": 28,
    "position": 1,
    "text": "که کین آورد هر زمان نو به نو"
  },
  {
    "poem_id": 1601,
    "vorder": 29,
    "position": 0,
    "text": "بپوشید جوشن یل اسفندیار"
  },
  {
    "poem_id": 1601,
    "vorder": 30,
    "position": 1,
    "text": "بیامد بر رستم نامدار"
  },
  {
    "poem_id": 1601,
    "vorder": 31,
    "position": 0,
    "text": "خروشید چون روی رستم بدید"
  },
  {
    "poem_id": 1601,
    "vorder": 32,
    "position": 1,
    "text": "که نام تو باد از جهان ناپدید"
  },
  {
    "poem_id": 1601,
    "vorder": 33,
    "position": 0,
    "text": "فراموش کردی تو سگزی مگر"
  },
  {
    "poem_id": 1601,
    "vorder": 34,
    "position": 1,
    "text": "کمان و بر مرد پرخاشخر"
  },
  {
    "poem_id": 1601,
    "vorder": 35,
    "position": 0,
    "text": "ز نیرنگ زالی بدین سان درست"
  },
  {
    "poem_id": 1601,
    "vorder": 36,
    "position": 1,
    "text": "وگرنه که پایت همی گور جست"
  },
  {
    "poem_id": 1601,
    "vorder": 37,
    "position": 0,
    "text": "بکوبمت زین گونه امروز یال"
  },
  {
    "poem_id": 1601,
    "vorder": 38,
    "position": 1,
    "text": "کزین پس نبیند ترا زنده زال"
  },
  {
    "poem_id": 1601,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت رستم به اسفندیار"
  },
  {
    "poem_id": 1601,
    "vorder": 40,
    "position": 1,
    "text": "که ای سیر ناگشته از کارزار"
  },
  {
    "poem_id": 1601,
    "vorder": 41,
    "position": 0,
    "text": "بترس از جهاندار یزدان پاک"
  },
  {
    "poem_id": 1601,
    "vorder": 42,
    "position": 1,
    "text": "خرد را مکن با دل اندر مغاک"
  },
  {
    "poem_id": 1601,
    "vorder": 43,
    "position": 0,
    "text": "من امروز نز بهر جنگ آمدم"
  },
  {
    "poem_id": 1601,
    "vorder": 44,
    "position": 1,
    "text": "پی پوزش و نام و ننگ آمدم"
  },
  {
    "poem_id": 1601,
    "vorder": 45,
    "position": 0,
    "text": "تو با من به بیداد کوشی همی"
  },
  {
    "poem_id": 1601,
    "vorder": 46,
    "position": 1,
    "text": "دو چشم خرد را بپوشی همی"
  },
  {
    "poem_id": 1601,
    "vorder": 47,
    "position": 0,
    "text": "به خورشید و ماه و به استا و زند"
  },
  {
    "poem_id": 1601,
    "vorder": 48,
    "position": 1,
    "text": "که دل را نرانی به راه گزند"
  },
  {
    "poem_id": 1601,
    "vorder": 49,
    "position": 0,
    "text": "نگیری به یاد آن سخنها که رفت"
  },
  {
    "poem_id": 1601,
    "vorder": 50,
    "position": 1,
    "text": "وگر پوست بر تن کسی را بکفت"
  },
  {
    "poem_id": 1601,
    "vorder": 51,
    "position": 0,
    "text": "بیابی ببینی یکی خان من"
  },
  {
    "poem_id": 1601,
    "vorder": 52,
    "position": 1,
    "text": "روندست کام تو بر جان من"
  },
  {
    "poem_id": 1601,
    "vorder": 53,
    "position": 0,
    "text": "گشایم در گنج دیرینه باز"
  },
  {
    "poem_id": 1601,
    "vorder": 54,
    "position": 1,
    "text": "کجا گرد کردم به سال دراز"
  },
  {
    "poem_id": 1601,
    "vorder": 55,
    "position": 0,
    "text": "کنم بار بر بارگیهای خویش"
  },
  {
    "poem_id": 1601,
    "vorder": 56,
    "position": 1,
    "text": "به گنجور ده تا براند ز پیش"
  },
  {
    "poem_id": 1601,
    "vorder": 57,
    "position": 0,
    "text": "برابر همی با تو آیم به راه"
  },
  {
    "poem_id": 1601,
    "vorder": 58,
    "position": 1,
    "text": "کنم هرچ فرمان دهی پیش شاه"
  },
  {
    "poem_id": 1601,
    "vorder": 59,
    "position": 0,
    "text": "اگر کشتنیم او کشد شایدم"
  },
  {
    "poem_id": 1601,
    "vorder": 60,
    "position": 1,
    "text": "همان نیز اگر بند فرمایدم"
  },
  {
    "poem_id": 1601,
    "vorder": 61,
    "position": 0,
    "text": "همی چاره جویم که تا روزگار"
  },
  {
    "poem_id": 1601,
    "vorder": 62,
    "position": 1,
    "text": "ترا سیر گرداند از کارزار"
  },
  {
    "poem_id": 1601,
    "vorder": 63,
    "position": 0,
    "text": "نگه کن که دانای پیشی چه گفت"
  },
  {
    "poem_id": 1601,
    "vorder": 64,
    "position": 1,
    "text": "که هرگز مباد اختر شوم جفت"
  },
  {
    "poem_id": 1601,
    "vorder": 65,
    "position": 0,
    "text": "چنین داد پاسخ که مرد فریب"
  },
  {
    "poem_id": 1601,
    "vorder": 66,
    "position": 1,
    "text": "نیم روز پرخاش و روز نهیب"
  },
  {
    "poem_id": 1601,
    "vorder": 67,
    "position": 0,
    "text": "اگر زنده خواهی که ماند به جای"
  },
  {
    "poem_id": 1601,
    "vorder": 68,
    "position": 1,
    "text": "نخستین سخن بند بر نه به پای"
  },
  {
    "poem_id": 1601,
    "vorder": 69,
    "position": 0,
    "text": "از ایوان و خان چند گویی همی"
  },
  {
    "poem_id": 1601,
    "vorder": 70,
    "position": 1,
    "text": "رخ آشتی را بشویی همی"
  },
  {
    "poem_id": 1601,
    "vorder": 71,
    "position": 0,
    "text": "دگر باره رستم زبان برگشاد"
  },
  {
    "poem_id": 1601,
    "vorder": 72,
    "position": 1,
    "text": "مکن شهریارا ز بیداد یاد"
  },
  {
    "poem_id": 1601,
    "vorder": 73,
    "position": 0,
    "text": "مکن نام من در جهان زشت و خوار"
  },
  {
    "poem_id": 1601,
    "vorder": 74,
    "position": 1,
    "text": "که جز بد نیاید ازین کارزار"
  },
  {
    "poem_id": 1601,
    "vorder": 75,
    "position": 0,
    "text": "هزارانت گوهر دهم شاهوار"
  },
  {
    "poem_id": 1601,
    "vorder": 76,
    "position": 1,
    "text": "همان یارهٔ زر با گوشوار"
  },
  {
    "poem_id": 1601,
    "vorder": 77,
    "position": 0,
    "text": "هزارانت بنده دهم نوش‌لب"
  },
  {
    "poem_id": 1601,
    "vorder": 78,
    "position": 1,
    "text": "پرستنده باشد ترا روز و شب"
  },
  {
    "poem_id": 1601,
    "vorder": 79,
    "position": 0,
    "text": "هزارت کنیزک دهم خلخی"
  },
  {
    "poem_id": 1601,
    "vorder": 80,
    "position": 1,
    "text": "که زیبای تاج‌اند با فرخی"
  },
  {
    "poem_id": 1601,
    "vorder": 81,
    "position": 0,
    "text": "دگر گنج سام نریمان و زال"
  },
  {
    "poem_id": 1601,
    "vorder": 82,
    "position": 1,
    "text": "گشایم به پیش تو ای بی‌همال"
  },
  {
    "poem_id": 1601,
    "vorder": 83,
    "position": 0,
    "text": "همه پاک پیش تو گرد آورم"
  },
  {
    "poem_id": 1601,
    "vorder": 84,
    "position": 1,
    "text": "ز زابلستان نیز مرد آورم"
  },
  {
    "poem_id": 1601,
    "vorder": 85,
    "position": 0,
    "text": "که تا مر ترا نیز فرمان کنند"
  },
  {
    "poem_id": 1601,
    "vorder": 86,
    "position": 1,
    "text": "روان را به فرمان گروگان کنند"
  },
  {
    "poem_id": 1601,
    "vorder": 87,
    "position": 0,
    "text": "ازان پس به پیشت پرستاروار"
  },
  {
    "poem_id": 1601,
    "vorder": 88,
    "position": 1,
    "text": "دوان با تو آیم بر شهریار"
  },
  {
    "poem_id": 1601,
    "vorder": 89,
    "position": 0,
    "text": "ز دل دور کن شهریارا تو کین"
  },
  {
    "poem_id": 1601,
    "vorder": 90,
    "position": 1,
    "text": "مکن دیو را با خرد همنشین"
  },
  {
    "poem_id": 1601,
    "vorder": 91,
    "position": 0,
    "text": "جز از بند دیگر ترا دست هست"
  },
  {
    "poem_id": 1601,
    "vorder": 92,
    "position": 1,
    "text": "بمن بر که شاهی و یزدان پرست"
  },
  {
    "poem_id": 1601,
    "vorder": 93,
    "position": 0,
    "text": "که از بند تا جاودان نام بد"
  },
  {
    "poem_id": 1601,
    "vorder": 94,
    "position": 1,
    "text": "بماند به من وز تو انجام بد"
  },
  {
    "poem_id": 1601,
    "vorder": 95,
    "position": 0,
    "text": "به رستم چنین گفت اسفندیار"
  },
  {
    "poem_id": 1601,
    "vorder": 96,
    "position": 1,
    "text": "که تا چندگویی سخن نابکار"
  },
  {
    "poem_id": 1601,
    "vorder": 97,
    "position": 0,
    "text": "مرا گویی از راه یزدان بگرد"
  },
  {
    "poem_id": 1601,
    "vorder": 98,
    "position": 1,
    "text": "ز فرمان شاه جهانبان بگرد"
  },
  {
    "poem_id": 1601,
    "vorder": 99,
    "position": 0,
    "text": "که هرکو ز فرمان شاه جهان"
  },
  {
    "poem_id": 1601,
    "vorder": 100,
    "position": 1,
    "text": "بگردد سرآید بدو بر زمان"
  },
  {
    "poem_id": 1601,
    "vorder": 101,
    "position": 0,
    "text": "جز از بند گر کوشش (و) کارزار"
  },
  {
    "poem_id": 1601,
    "vorder": 102,
    "position": 1,
    "text": "به پیشم دگرگونه پاسخ میار"
  },
  {
    "poem_id": 1601,
    "vorder": 103,
    "position": 0,
    "text": "به تندی به پاسخ گو نامدار"
  },
  {
    "poem_id": 1601,
    "vorder": 104,
    "position": 1,
    "text": "چنین گفت کای پرهنر شهریار"
  },
  {
    "poem_id": 1601,
    "vorder": 105,
    "position": 0,
    "text": "همی خوار داری تو گفتار من"
  },
  {
    "poem_id": 1601,
    "vorder": 106,
    "position": 1,
    "text": "به خیره بجویی تو آزار من"
  },
  {
    "poem_id": 1601,
    "vorder": 107,
    "position": 0,
    "text": "چنین داد پاسخ که چند از فریب"
  },
  {
    "poem_id": 1601,
    "vorder": 108,
    "position": 1,
    "text": "همانا به تنگ اندر آمد نشیب"
  }
]