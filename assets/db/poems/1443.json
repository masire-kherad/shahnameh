[
  {
    "poem_id": 1443,
    "vorder": 1,
    "position": 0,
    "text": "چو نامه به مهر اندر آورد شاه"
  },
  {
    "poem_id": 1443,
    "vorder": 2,
    "position": 1,
    "text": "جهانجوی رستم بپیموده راه"
  },
  {
    "poem_id": 1443,
    "vorder": 3,
    "position": 0,
    "text": "به زین اندر افگند گرز گران"
  },
  {
    "poem_id": 1443,
    "vorder": 4,
    "position": 1,
    "text": "چو آمد به نزدیک مازندران"
  },
  {
    "poem_id": 1443,
    "vorder": 5,
    "position": 0,
    "text": "به شاه آگهی شد که کاووس کی"
  },
  {
    "poem_id": 1443,
    "vorder": 6,
    "position": 1,
    "text": "فرستادن نامه افگند پی"
  },
  {
    "poem_id": 1443,
    "vorder": 7,
    "position": 0,
    "text": "فرستاده‌ای چون هژبر دژم"
  },
  {
    "poem_id": 1443,
    "vorder": 8,
    "position": 1,
    "text": "کمندی به فتراک بر شست خم"
  },
  {
    "poem_id": 1443,
    "vorder": 9,
    "position": 0,
    "text": "به زیر اندرون باره‌ای گامزن"
  },
  {
    "poem_id": 1443,
    "vorder": 10,
    "position": 1,
    "text": "یکی ژنده پیلست گویی به تن"
  },
  {
    "poem_id": 1443,
    "vorder": 11,
    "position": 0,
    "text": "چو بشنید سالار مازندران"
  },
  {
    "poem_id": 1443,
    "vorder": 12,
    "position": 1,
    "text": "ز گردان گزین کرد چندی سران"
  },
  {
    "poem_id": 1443,
    "vorder": 13,
    "position": 0,
    "text": "بفرمودشان تا چَپیره شدند"
  },
  {
    "poem_id": 1443,
    "vorder": 14,
    "position": 1,
    "text": "هژبر ژیان را پذیره شدند"
  },
  {
    "poem_id": 1443,
    "vorder": 15,
    "position": 0,
    "text": "چو چشم تهمتن بدیشان رسید"
  },
  {
    "poem_id": 1443,
    "vorder": 16,
    "position": 1,
    "text": "به ره بر درختی گشن شاخ دید"
  },
  {
    "poem_id": 1443,
    "vorder": 17,
    "position": 0,
    "text": "بکند و چو ژوپین به کف برگرفت"
  },
  {
    "poem_id": 1443,
    "vorder": 18,
    "position": 1,
    "text": "بماندند لشکر همه در شگفت"
  },
  {
    "poem_id": 1443,
    "vorder": 19,
    "position": 0,
    "text": "بینداخت چون نزد ایشان رسید"
  },
  {
    "poem_id": 1443,
    "vorder": 20,
    "position": 1,
    "text": "سواران بسی زیر شاخ آورید"
  },
  {
    "poem_id": 1443,
    "vorder": 21,
    "position": 0,
    "text": "یکی دست بگرفت و بفشاردش"
  },
  {
    "poem_id": 1443,
    "vorder": 22,
    "position": 1,
    "text": "همی آزمون را بیازاردش"
  },
  {
    "poem_id": 1443,
    "vorder": 23,
    "position": 0,
    "text": "بخندید ازو رستم پیلتن"
  },
  {
    "poem_id": 1443,
    "vorder": 24,
    "position": 1,
    "text": "شده خیره زو چشم آن انجمن"
  },
  {
    "poem_id": 1443,
    "vorder": 25,
    "position": 0,
    "text": "بدان خنده اندر بیفشارد چنگ"
  },
  {
    "poem_id": 1443,
    "vorder": 26,
    "position": 1,
    "text": "ببردش رگ از دست وز روی رنگ"
  },
  {
    "poem_id": 1443,
    "vorder": 27,
    "position": 0,
    "text": "بشد هوش از آن مرد رزم آزمای"
  },
  {
    "poem_id": 1443,
    "vorder": 28,
    "position": 1,
    "text": "ز بالای اسب اندر آمد به پای"
  },
  {
    "poem_id": 1443,
    "vorder": 29,
    "position": 0,
    "text": "یکی شد بر شاه مازندران"
  },
  {
    "poem_id": 1443,
    "vorder": 30,
    "position": 1,
    "text": "بگفت آنچ دید از کران تا کران"
  },
  {
    "poem_id": 1443,
    "vorder": 31,
    "position": 0,
    "text": "سواری که نامش کلاهور بود"
  },
  {
    "poem_id": 1443,
    "vorder": 32,
    "position": 1,
    "text": "که مازندران زو پر از شور بود"
  },
  {
    "poem_id": 1443,
    "vorder": 33,
    "position": 0,
    "text": "بسان پلنگ ژیان بد به خوی"
  },
  {
    "poem_id": 1443,
    "vorder": 34,
    "position": 1,
    "text": "نکردی به جز جنگ چیز آرزوی"
  },
  {
    "poem_id": 1443,
    "vorder": 35,
    "position": 0,
    "text": "پذیره شدن را فرا پیش خواند"
  },
  {
    "poem_id": 1443,
    "vorder": 36,
    "position": 1,
    "text": "به مردیش بر چرخ گردان نشاند"
  },
  {
    "poem_id": 1443,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت پیش فرستاده شو"
  },
  {
    "poem_id": 1443,
    "vorder": 38,
    "position": 1,
    "text": "هنرها پدیدار کن نو به نو"
  },
  {
    "poem_id": 1443,
    "vorder": 39,
    "position": 0,
    "text": "چنان کن که گردد رخش پر ز شرم"
  },
  {
    "poem_id": 1443,
    "vorder": 40,
    "position": 1,
    "text": "به چشم اندر آرد ز شرم آب گرم"
  },
  {
    "poem_id": 1443,
    "vorder": 41,
    "position": 0,
    "text": "بیامد کلاهور چون نره شیر"
  },
  {
    "poem_id": 1443,
    "vorder": 42,
    "position": 1,
    "text": "به پیش جهاندار مرد دلیر"
  },
  {
    "poem_id": 1443,
    "vorder": 43,
    "position": 0,
    "text": "بپرسید پرسیدنی چون پلنگ"
  },
  {
    "poem_id": 1443,
    "vorder": 44,
    "position": 1,
    "text": "دژم روی زانپس بدو داد چنگ"
  },
  {
    "poem_id": 1443,
    "vorder": 45,
    "position": 0,
    "text": "بیفشارد چنگ سرافراز پیل"
  },
  {
    "poem_id": 1443,
    "vorder": 46,
    "position": 1,
    "text": "شد از درد دستش به کردار نیل"
  },
  {
    "poem_id": 1443,
    "vorder": 47,
    "position": 0,
    "text": "بپیچید و اندیشه زو دورداشت"
  },
  {
    "poem_id": 1443,
    "vorder": 48,
    "position": 1,
    "text": "به مردی ز خورشید منشور داشت"
  },
  {
    "poem_id": 1443,
    "vorder": 49,
    "position": 0,
    "text": "بیفشارد چنگ کلاهور سخت"
  },
  {
    "poem_id": 1443,
    "vorder": 50,
    "position": 1,
    "text": "فرو ریخت ناخن چو برگ از درخت"
  },
  {
    "poem_id": 1443,
    "vorder": 51,
    "position": 0,
    "text": "کلاهور با دست آویخته"
  },
  {
    "poem_id": 1443,
    "vorder": 52,
    "position": 1,
    "text": "پی و پوست و ناخن فروریخته"
  },
  {
    "poem_id": 1443,
    "vorder": 53,
    "position": 0,
    "text": "بیاورد و بنمود و با شاه گفت"
  },
  {
    "poem_id": 1443,
    "vorder": 54,
    "position": 1,
    "text": "که بر خویشتن درد نتوان نهفت"
  },
  {
    "poem_id": 1443,
    "vorder": 55,
    "position": 0,
    "text": "ترا آشتی بهتر آید ز جنگ"
  },
  {
    "poem_id": 1443,
    "vorder": 56,
    "position": 1,
    "text": "فراخی مکن بر دل خویش تنگ"
  },
  {
    "poem_id": 1443,
    "vorder": 57,
    "position": 0,
    "text": "ترا با چنین پهلوان تاو نیست"
  },
  {
    "poem_id": 1443,
    "vorder": 58,
    "position": 1,
    "text": "اگر رام گردد به از ساو نیست"
  },
  {
    "poem_id": 1443,
    "vorder": 59,
    "position": 0,
    "text": "پذیریم از شهر مازندران"
  },
  {
    "poem_id": 1443,
    "vorder": 60,
    "position": 1,
    "text": "ببخشیم بر کهتر و مهتران"
  },
  {
    "poem_id": 1443,
    "vorder": 61,
    "position": 0,
    "text": "چنین رنج دشوار آسان کنیم"
  },
  {
    "poem_id": 1443,
    "vorder": 62,
    "position": 1,
    "text": "به آید که جان را هراسان کنیم"
  },
  {
    "poem_id": 1443,
    "vorder": 63,
    "position": 0,
    "text": "تهمتن بیامد هم اندر زمان"
  },
  {
    "poem_id": 1443,
    "vorder": 64,
    "position": 1,
    "text": "بر شاه برسان شیر ژیان"
  },
  {
    "poem_id": 1443,
    "vorder": 65,
    "position": 0,
    "text": "نگه کرد و بنشاند اندر خورش"
  },
  {
    "poem_id": 1443,
    "vorder": 66,
    "position": 1,
    "text": "ز کاووس پرسید و از لشکرش"
  },
  {
    "poem_id": 1443,
    "vorder": 67,
    "position": 0,
    "text": "سخن راند از راه و رنج دراز"
  },
  {
    "poem_id": 1443,
    "vorder": 68,
    "position": 1,
    "text": "که چون راندی اندر نشیب و فراز"
  },
  {
    "poem_id": 1443,
    "vorder": 69,
    "position": 0,
    "text": "ازان پس بدو گفت رستم توی"
  },
  {
    "poem_id": 1443,
    "vorder": 70,
    "position": 1,
    "text": "که داری بر و بازوی پهلوی"
  },
  {
    "poem_id": 1443,
    "vorder": 71,
    "position": 0,
    "text": "چنین داد پاسخ که من چاکرم"
  },
  {
    "poem_id": 1443,
    "vorder": 72,
    "position": 1,
    "text": "اگر چاکری را خود اندر خورم"
  },
  {
    "poem_id": 1443,
    "vorder": 73,
    "position": 0,
    "text": "کجا او بود من نیایم به کار"
  },
  {
    "poem_id": 1443,
    "vorder": 74,
    "position": 1,
    "text": "که او پهلوانست و گرد و سوار"
  },
  {
    "poem_id": 1443,
    "vorder": 75,
    "position": 0,
    "text": "بدو داد پس نامور نامه را"
  },
  {
    "poem_id": 1443,
    "vorder": 76,
    "position": 1,
    "text": "پیام جهانجوی خودکامه را"
  },
  {
    "poem_id": 1443,
    "vorder": 77,
    "position": 0,
    "text": "بگفت آنک شمشیر بار آورد"
  },
  {
    "poem_id": 1443,
    "vorder": 78,
    "position": 1,
    "text": "سر سرکشان در کنار آورد"
  },
  {
    "poem_id": 1443,
    "vorder": 79,
    "position": 0,
    "text": "چو پیغام بشنید و نامه بخواند"
  },
  {
    "poem_id": 1443,
    "vorder": 80,
    "position": 1,
    "text": "دژم گشت و اندر شگفتی بماند"
  },
  {
    "poem_id": 1443,
    "vorder": 81,
    "position": 0,
    "text": "به رستم چنین گفت کاین جست و جوی"
  },
  {
    "poem_id": 1443,
    "vorder": 82,
    "position": 1,
    "text": "چه باید همی خیره این گفت‌وگوی"
  },
  {
    "poem_id": 1443,
    "vorder": 83,
    "position": 0,
    "text": "بگویش که سالار ایران تویی"
  },
  {
    "poem_id": 1443,
    "vorder": 84,
    "position": 1,
    "text": "اگرچه دل و چنگ شیران تویی"
  },
  {
    "poem_id": 1443,
    "vorder": 85,
    "position": 0,
    "text": "منم شاه مازندران با سپاه"
  },
  {
    "poem_id": 1443,
    "vorder": 86,
    "position": 1,
    "text": "بر اورنگ زرین و بر سر کلاه"
  },
  {
    "poem_id": 1443,
    "vorder": 87,
    "position": 0,
    "text": "مرا بیهده خواندن پیش خویش"
  },
  {
    "poem_id": 1443,
    "vorder": 88,
    "position": 1,
    "text": "نه رسم کیان بد نه آیین پیش"
  },
  {
    "poem_id": 1443,
    "vorder": 89,
    "position": 0,
    "text": "براندیش و تخت بزرگان مجوی"
  },
  {
    "poem_id": 1443,
    "vorder": 90,
    "position": 1,
    "text": "کزین برتری خواری آید بروی"
  },
  {
    "poem_id": 1443,
    "vorder": 91,
    "position": 0,
    "text": "سوی گاه ایران بگردان عنان"
  },
  {
    "poem_id": 1443,
    "vorder": 92,
    "position": 1,
    "text": "وگرنه زمانت سرآرد سنان"
  },
  {
    "poem_id": 1443,
    "vorder": 93,
    "position": 0,
    "text": "اگر با سپه من بجنبم ز جای"
  },
  {
    "poem_id": 1443,
    "vorder": 94,
    "position": 1,
    "text": "تو پیدا نبینی سرت را ز پای"
  },
  {
    "poem_id": 1443,
    "vorder": 95,
    "position": 0,
    "text": "تو افتاده‌ای بی‌گمان در گمان"
  },
  {
    "poem_id": 1443,
    "vorder": 96,
    "position": 1,
    "text": "یکی راه برگیر و بفگن کمان"
  },
  {
    "poem_id": 1443,
    "vorder": 97,
    "position": 0,
    "text": "چو من تنگ روی اندر آرم بروی"
  },
  {
    "poem_id": 1443,
    "vorder": 98,
    "position": 1,
    "text": "سرآید شما را همه گفت‌وگوی"
  },
  {
    "poem_id": 1443,
    "vorder": 99,
    "position": 0,
    "text": "نگه کرد رستم به روشن روان"
  },
  {
    "poem_id": 1443,
    "vorder": 100,
    "position": 1,
    "text": "به شاه و سپاه و رد و پهلوان"
  },
  {
    "poem_id": 1443,
    "vorder": 101,
    "position": 0,
    "text": "نیامدش با مغز گفتار اوی"
  },
  {
    "poem_id": 1443,
    "vorder": 102,
    "position": 1,
    "text": "سرش تیزتر شد به پیکار اوی"
  },
  {
    "poem_id": 1443,
    "vorder": 103,
    "position": 0,
    "text": "تهمتن چو برخاست کاید به راه"
  },
  {
    "poem_id": 1443,
    "vorder": 104,
    "position": 1,
    "text": "بفرمود تا خلعت آرند شاه"
  },
  {
    "poem_id": 1443,
    "vorder": 105,
    "position": 0,
    "text": "نپذرفت ازو جامه و اسپ و زر"
  },
  {
    "poem_id": 1443,
    "vorder": 106,
    "position": 1,
    "text": "که ننگ آمدش زان کلاه و کمر"
  },
  {
    "poem_id": 1443,
    "vorder": 107,
    "position": 0,
    "text": "بیامد دژم از بر گاه اوی"
  },
  {
    "poem_id": 1443,
    "vorder": 108,
    "position": 1,
    "text": "همه تیره دید اختر و ماه اوی"
  },
  {
    "poem_id": 1443,
    "vorder": 109,
    "position": 0,
    "text": "برون آمد از شهر مازندران"
  },
  {
    "poem_id": 1443,
    "vorder": 110,
    "position": 1,
    "text": "سرش گشته بد زان سخنها گران"
  },
  {
    "poem_id": 1443,
    "vorder": 111,
    "position": 0,
    "text": "چو آمد به نزدیک شاه اندرون"
  },
  {
    "poem_id": 1443,
    "vorder": 112,
    "position": 1,
    "text": "دل کینه‌دارش پر از جوش خون"
  },
  {
    "poem_id": 1443,
    "vorder": 113,
    "position": 0,
    "text": "ز مازندران هرچ دید و شنید"
  },
  {
    "poem_id": 1443,
    "vorder": 114,
    "position": 1,
    "text": "همه کرد بر شاه ایران پدید"
  },
  {
    "poem_id": 1443,
    "vorder": 115,
    "position": 0,
    "text": "وزان پس ورا گفت مندیش هیچ"
  },
  {
    "poem_id": 1443,
    "vorder": 116,
    "position": 1,
    "text": "دلیری کن و رزم دیوان بسیچ"
  },
  {
    "poem_id": 1443,
    "vorder": 117,
    "position": 0,
    "text": "دلیران و گردان آن انجمن"
  },
  {
    "poem_id": 1443,
    "vorder": 118,
    "position": 1,
    "text": "چنان دان که خوارند بر چشم من"
  }
]