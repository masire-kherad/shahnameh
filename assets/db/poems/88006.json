[
  {
    "poem_id": 88006,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد بافراسیاب"
  },
  {
    "poem_id": 88006,
    "vorder": 2,
    "position": 1,
    "text": "که آتش برآمد ز دریای آب"
  },
  {
    "poem_id": 88006,
    "vorder": 3,
    "position": 0,
    "text": "ز کاموس و منشور و خاقان چین"
  },
  {
    "poem_id": 88006,
    "vorder": 4,
    "position": 1,
    "text": "شکستی نو آمد بتوران زمین"
  },
  {
    "poem_id": 88006,
    "vorder": 5,
    "position": 0,
    "text": "از ایران یکی لشکر آمد بجنگ"
  },
  {
    "poem_id": 88006,
    "vorder": 6,
    "position": 1,
    "text": "که شد چرخ گردنده را راه تنگ"
  },
  {
    "poem_id": 88006,
    "vorder": 7,
    "position": 0,
    "text": "چهل روز یکسان همی جنگ بود"
  },
  {
    "poem_id": 88006,
    "vorder": 8,
    "position": 1,
    "text": "شب و روز گیتی بیک رنگ بود"
  },
  {
    "poem_id": 88006,
    "vorder": 9,
    "position": 0,
    "text": "ز گرد سواران نبود آفتاب"
  },
  {
    "poem_id": 88006,
    "vorder": 10,
    "position": 1,
    "text": "چو بیدار بخت اندر آمد بخواب"
  },
  {
    "poem_id": 88006,
    "vorder": 11,
    "position": 0,
    "text": "سرانجام زان لشکر بیشمار"
  },
  {
    "poem_id": 88006,
    "vorder": 12,
    "position": 1,
    "text": "سواری نماند از در کارزار"
  },
  {
    "poem_id": 88006,
    "vorder": 13,
    "position": 0,
    "text": "بزرگان و آن نامور مهتران"
  },
  {
    "poem_id": 88006,
    "vorder": 14,
    "position": 1,
    "text": "ببستند یکسر ببند گران"
  },
  {
    "poem_id": 88006,
    "vorder": 15,
    "position": 0,
    "text": "بخواری فگندند بر پشت پیل"
  },
  {
    "poem_id": 88006,
    "vorder": 16,
    "position": 1,
    "text": "سپه بود گرد آمده بر دو میل"
  },
  {
    "poem_id": 88006,
    "vorder": 17,
    "position": 0,
    "text": "ز کشته چنان بد که در رزمگاه"
  },
  {
    "poem_id": 88006,
    "vorder": 18,
    "position": 1,
    "text": "کسی را نبد جای رفتن براه"
  },
  {
    "poem_id": 88006,
    "vorder": 19,
    "position": 0,
    "text": "وزین روی پیران براه ختن"
  },
  {
    "poem_id": 88006,
    "vorder": 20,
    "position": 1,
    "text": "بشد با یکی نامدار انجمن"
  },
  {
    "poem_id": 88006,
    "vorder": 21,
    "position": 0,
    "text": "کشانی و شگنی و وهری نماند"
  },
  {
    "poem_id": 88006,
    "vorder": 22,
    "position": 1,
    "text": "که منشور شمشیر رستم نخواند"
  },
  {
    "poem_id": 88006,
    "vorder": 23,
    "position": 0,
    "text": "وزین روی تنگ اندر آمد سپاه"
  },
  {
    "poem_id": 88006,
    "vorder": 24,
    "position": 1,
    "text": "بپیش اندرون رستم کینه‌خواه"
  },
  {
    "poem_id": 88006,
    "vorder": 25,
    "position": 0,
    "text": "گر آیند زی ما برزم آن گروه"
  },
  {
    "poem_id": 88006,
    "vorder": 26,
    "position": 1,
    "text": "شود کوه هامون و هامون چو کوه"
  },
  {
    "poem_id": 88006,
    "vorder": 27,
    "position": 0,
    "text": "چو افراسیاب این سخنها شنود"
  },
  {
    "poem_id": 88006,
    "vorder": 28,
    "position": 1,
    "text": "دلش گشت پر درد و سر پر ز دود"
  },
  {
    "poem_id": 88006,
    "vorder": 29,
    "position": 0,
    "text": "همه موبدان و ردان را بخواند"
  },
  {
    "poem_id": 88006,
    "vorder": 30,
    "position": 1,
    "text": "ز کار گذشته فراوان براند"
  },
  {
    "poem_id": 88006,
    "vorder": 31,
    "position": 0,
    "text": "کز ایران یکی لشکری جنگجوی"
  },
  {
    "poem_id": 88006,
    "vorder": 32,
    "position": 1,
    "text": "بدان نامداران نهادست روی"
  },
  {
    "poem_id": 88006,
    "vorder": 33,
    "position": 0,
    "text": "شکسته شدست آن سپاه گران"
  },
  {
    "poem_id": 88006,
    "vorder": 34,
    "position": 1,
    "text": "چنان ساز و آن لشکر بی‌کران"
  },
  {
    "poem_id": 88006,
    "vorder": 35,
    "position": 0,
    "text": "ز اندوه کاموس و خاقان چین"
  },
  {
    "poem_id": 88006,
    "vorder": 36,
    "position": 1,
    "text": "ببستند گفتی مرا بر زمین"
  },
  {
    "poem_id": 88006,
    "vorder": 37,
    "position": 0,
    "text": "سپاهی چنان بسته و خسته شد"
  },
  {
    "poem_id": 88006,
    "vorder": 38,
    "position": 1,
    "text": "دو بهره ز گردنکشان بسته شد"
  },
  {
    "poem_id": 88006,
    "vorder": 39,
    "position": 0,
    "text": "بایران کشیدند بر پشت پیل"
  },
  {
    "poem_id": 88006,
    "vorder": 40,
    "position": 1,
    "text": "زمین پر ز خون بود تا چند میل"
  },
  {
    "poem_id": 88006,
    "vorder": 41,
    "position": 0,
    "text": "چه سازیم و این را چه درمان کنیم"
  },
  {
    "poem_id": 88006,
    "vorder": 42,
    "position": 1,
    "text": "نشاید که این بر دل آسان کنیم"
  },
  {
    "poem_id": 88006,
    "vorder": 43,
    "position": 0,
    "text": "گر ایدونک رستم بود پیش رو"
  },
  {
    "poem_id": 88006,
    "vorder": 44,
    "position": 1,
    "text": "نماند برین بوم و بر خار و خو"
  },
  {
    "poem_id": 88006,
    "vorder": 45,
    "position": 0,
    "text": "که من دستبرد ورا دیده‌ام"
  },
  {
    "poem_id": 88006,
    "vorder": 46,
    "position": 1,
    "text": "ز کار آگهان نیز بشنیده‌ام"
  },
  {
    "poem_id": 88006,
    "vorder": 47,
    "position": 0,
    "text": "که او با بزرگان ایران زمین"
  },
  {
    "poem_id": 88006,
    "vorder": 48,
    "position": 1,
    "text": "چه کردست از نیکوی روز کین"
  },
  {
    "poem_id": 88006,
    "vorder": 49,
    "position": 0,
    "text": "چه کردست با شاه مازندران"
  },
  {
    "poem_id": 88006,
    "vorder": 50,
    "position": 1,
    "text": "ز گرزش چه آمد بران مهتران"
  },
  {
    "poem_id": 88006,
    "vorder": 51,
    "position": 0,
    "text": "گرانمایگان پاسخ آراستند"
  },
  {
    "poem_id": 88006,
    "vorder": 52,
    "position": 1,
    "text": "همه یکسر از جای برخاستند"
  },
  {
    "poem_id": 88006,
    "vorder": 53,
    "position": 0,
    "text": "که گر نامداران سقلاب و چین"
  },
  {
    "poem_id": 88006,
    "vorder": 54,
    "position": 1,
    "text": "بایران همی رزم جستند و کین"
  },
  {
    "poem_id": 88006,
    "vorder": 55,
    "position": 0,
    "text": "نه از لشکر ما کسی کم شدست"
  },
  {
    "poem_id": 88006,
    "vorder": 56,
    "position": 1,
    "text": "نه این کشور از خون دمادم شدست"
  },
  {
    "poem_id": 88006,
    "vorder": 57,
    "position": 0,
    "text": "ز رستم چرا بیم داری همی"
  },
  {
    "poem_id": 88006,
    "vorder": 58,
    "position": 1,
    "text": "چنین کام دشمن بخاری همی"
  },
  {
    "poem_id": 88006,
    "vorder": 59,
    "position": 0,
    "text": "ز مادر همه مرگ را زاده‌ایم"
  },
  {
    "poem_id": 88006,
    "vorder": 60,
    "position": 1,
    "text": "میان تا ببستیم نگشاده‌ایم"
  },
  {
    "poem_id": 88006,
    "vorder": 61,
    "position": 0,
    "text": "اگر خاک ما را بپی بسپرند"
  },
  {
    "poem_id": 88006,
    "vorder": 62,
    "position": 1,
    "text": "ازین کردهٔ خویش کیفر برند"
  },
  {
    "poem_id": 88006,
    "vorder": 63,
    "position": 0,
    "text": "بکین گر ببندیم زین پس میان"
  },
  {
    "poem_id": 88006,
    "vorder": 64,
    "position": 1,
    "text": "نماند کسی زنده ز ایرانیان"
  },
  {
    "poem_id": 88006,
    "vorder": 65,
    "position": 0,
    "text": "ز پرمایگان شاه پاسخ شنید"
  },
  {
    "poem_id": 88006,
    "vorder": 66,
    "position": 1,
    "text": "ز لشکر زبان‌آوری برگزید"
  },
  {
    "poem_id": 88006,
    "vorder": 67,
    "position": 0,
    "text": "دلیران و گردنکشان را بخواند"
  },
  {
    "poem_id": 88006,
    "vorder": 68,
    "position": 1,
    "text": "ز خواب و ز آرام و خوردن بماند"
  },
  {
    "poem_id": 88006,
    "vorder": 69,
    "position": 0,
    "text": "در گنج بگشاد و دینار داد"
  },
  {
    "poem_id": 88006,
    "vorder": 70,
    "position": 1,
    "text": "روان را بخون دل آهار داد"
  },
  {
    "poem_id": 88006,
    "vorder": 71,
    "position": 0,
    "text": "چنان شد ز گردان جنگی زمین"
  },
  {
    "poem_id": 88006,
    "vorder": 72,
    "position": 1,
    "text": "که گفتی سپهر اندر آمد بکین"
  },
  {
    "poem_id": 88006,
    "vorder": 73,
    "position": 0,
    "text": "چو این بند بد را سر آمد کلید"
  },
  {
    "poem_id": 88006,
    "vorder": 74,
    "position": 1,
    "text": "فریبرز نزدیک رستم رسید"
  },
  {
    "poem_id": 88006,
    "vorder": 75,
    "position": 0,
    "text": "بدل شاد با خلعت شهریار"
  },
  {
    "poem_id": 88006,
    "vorder": 76,
    "position": 1,
    "text": "بدو اندرون تاج گوهر نگار"
  },
  {
    "poem_id": 88006,
    "vorder": 77,
    "position": 0,
    "text": "ازان شادمان شد گو پیلتن"
  },
  {
    "poem_id": 88006,
    "vorder": 78,
    "position": 1,
    "text": "بزرگان لشکر شدند انجمن"
  },
  {
    "poem_id": 88006,
    "vorder": 79,
    "position": 0,
    "text": "گرفتند بر پهلوان آفرین"
  },
  {
    "poem_id": 88006,
    "vorder": 80,
    "position": 1,
    "text": "که آباد بادا برستم زمین"
  },
  {
    "poem_id": 88006,
    "vorder": 81,
    "position": 0,
    "text": "بدو جان شاه جهان شاد باد"
  },
  {
    "poem_id": 88006,
    "vorder": 82,
    "position": 1,
    "text": "بر و بوم ایرانش آباد باد"
  },
  {
    "poem_id": 88006,
    "vorder": 83,
    "position": 0,
    "text": "همه مر ترا چاکر و بنده‌ایم"
  },
  {
    "poem_id": 88006,
    "vorder": 84,
    "position": 1,
    "text": "بفرمان و رایت سرافگنده‌ایم"
  },
  {
    "poem_id": 88006,
    "vorder": 85,
    "position": 0,
    "text": "وزان جایگه شاد لشکر براند"
  },
  {
    "poem_id": 88006,
    "vorder": 86,
    "position": 1,
    "text": "بیامد بسغد و دو هفته بماند"
  },
  {
    "poem_id": 88006,
    "vorder": 87,
    "position": 0,
    "text": "بنخچیر گور و بمی دست برد"
  },
  {
    "poem_id": 88006,
    "vorder": 88,
    "position": 1,
    "text": "ازین گونه یک چند خورد و شمرد"
  }
]