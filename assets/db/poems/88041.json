[
  {
    "poem_id": 88041,
    "vorder": 1,
    "position": 0,
    "text": "پر از کینه سالار توران سپاه"
  },
  {
    "poem_id": 88041,
    "vorder": 2,
    "position": 1,
    "text": "خروشان بیامد به آوردگاه"
  },
  {
    "poem_id": 88041,
    "vorder": 3,
    "position": 0,
    "text": "چو گودرز کشوادگان را بدید"
  },
  {
    "poem_id": 88041,
    "vorder": 4,
    "position": 1,
    "text": "سخن گفت بسیار و پاسخ شنید"
  },
  {
    "poem_id": 88041,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کای پر خرد پهلوان"
  },
  {
    "poem_id": 88041,
    "vorder": 6,
    "position": 1,
    "text": "به رنج اندرون چند پیچی روان"
  },
  {
    "poem_id": 88041,
    "vorder": 7,
    "position": 0,
    "text": "روان سیاووش را زان چه سود"
  },
  {
    "poem_id": 88041,
    "vorder": 8,
    "position": 1,
    "text": "که از شهر توران برآری تو دود"
  },
  {
    "poem_id": 88041,
    "vorder": 9,
    "position": 0,
    "text": "بدان گیتی او جای نیکان گزید"
  },
  {
    "poem_id": 88041,
    "vorder": 10,
    "position": 1,
    "text": "نگیری تو آرام کو آرمید"
  },
  {
    "poem_id": 88041,
    "vorder": 11,
    "position": 0,
    "text": "دو لشکر چنین پاک با یکدگر"
  },
  {
    "poem_id": 88041,
    "vorder": 12,
    "position": 1,
    "text": "فگنده چو پیلان ز تن دور سر"
  },
  {
    "poem_id": 88041,
    "vorder": 13,
    "position": 0,
    "text": "سپاه دو کشور همه شد تباه"
  },
  {
    "poem_id": 88041,
    "vorder": 14,
    "position": 1,
    "text": "گه آمد که برداری این کینه‌گاه"
  },
  {
    "poem_id": 88041,
    "vorder": 15,
    "position": 0,
    "text": "جهان سر به سر پاک بی‌مرد گشت"
  },
  {
    "poem_id": 88041,
    "vorder": 16,
    "position": 1,
    "text": "بر این کینه پیکار ما سرد گشت"
  },
  {
    "poem_id": 88041,
    "vorder": 17,
    "position": 0,
    "text": "ور ایدونک هستی چنین کینه‌دار"
  },
  {
    "poem_id": 88041,
    "vorder": 18,
    "position": 1,
    "text": "از آن کوهپایه سپاه اندرآر"
  },
  {
    "poem_id": 88041,
    "vorder": 19,
    "position": 0,
    "text": "تو از لشکر خویش بیرون خرام"
  },
  {
    "poem_id": 88041,
    "vorder": 20,
    "position": 1,
    "text": "مگر خود برآیدت ز این کینه کام"
  },
  {
    "poem_id": 88041,
    "vorder": 21,
    "position": 0,
    "text": "به تنها من و تو بر این دشت کین"
  },
  {
    "poem_id": 88041,
    "vorder": 22,
    "position": 1,
    "text": "بگردیم و کین‌آوران همچنین"
  },
  {
    "poem_id": 88041,
    "vorder": 23,
    "position": 0,
    "text": "ز ما هرک او هست پیروزبخت"
  },
  {
    "poem_id": 88041,
    "vorder": 24,
    "position": 1,
    "text": "رسد خود به کام و نشیند به تخت"
  },
  {
    "poem_id": 88041,
    "vorder": 25,
    "position": 0,
    "text": "اگر من به دست تو گردم تباه"
  },
  {
    "poem_id": 88041,
    "vorder": 26,
    "position": 1,
    "text": "نجویند کینه ز توران سپاه"
  },
  {
    "poem_id": 88041,
    "vorder": 27,
    "position": 0,
    "text": "به پیش تو آیند و فرمان کنند"
  },
  {
    "poem_id": 88041,
    "vorder": 28,
    "position": 1,
    "text": "به پیمان روان را گروگان کنند"
  },
  {
    "poem_id": 88041,
    "vorder": 29,
    "position": 0,
    "text": "وگر تو شوی کشته بر دست من"
  },
  {
    "poem_id": 88041,
    "vorder": 30,
    "position": 1,
    "text": "کسی را نیازارم از انجمن"
  },
  {
    "poem_id": 88041,
    "vorder": 31,
    "position": 0,
    "text": "مرا با سپاه تو پیکار نیست"
  },
  {
    "poem_id": 88041,
    "vorder": 32,
    "position": 1,
    "text": "بر ایشان ز من نیز تیمار نیست"
  },
  {
    "poem_id": 88041,
    "vorder": 33,
    "position": 0,
    "text": "چو گودرز گفتار پیران شنید"
  },
  {
    "poem_id": 88041,
    "vorder": 34,
    "position": 1,
    "text": "از اختر همی بخت وارونه دید"
  },
  {
    "poem_id": 88041,
    "vorder": 35,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 88041,
    "vorder": 36,
    "position": 1,
    "text": "دگر یاد کرد از شه نامدار"
  },
  {
    "poem_id": 88041,
    "vorder": 37,
    "position": 0,
    "text": "به پیران چنین گفت کای نامور"
  },
  {
    "poem_id": 88041,
    "vorder": 38,
    "position": 1,
    "text": "شنیدیم گفتار تو سر به سر"
  },
  {
    "poem_id": 88041,
    "vorder": 39,
    "position": 0,
    "text": "ز خون سیاوش به افراسیاب"
  },
  {
    "poem_id": 88041,
    "vorder": 40,
    "position": 1,
    "text": "چه سودست از داد سر برمتاب"
  },
  {
    "poem_id": 88041,
    "vorder": 41,
    "position": 0,
    "text": "که چون گوسفندش ببرید سر"
  },
  {
    "poem_id": 88041,
    "vorder": 42,
    "position": 1,
    "text": "پر از خون دل از درد خسته جگر"
  },
  {
    "poem_id": 88041,
    "vorder": 43,
    "position": 0,
    "text": "از آن پس برآورد ز ایران خروش"
  },
  {
    "poem_id": 88041,
    "vorder": 44,
    "position": 1,
    "text": "ز بس کشتن و غارت و جنگ و جوش"
  },
  {
    "poem_id": 88041,
    "vorder": 45,
    "position": 0,
    "text": "سیاوش به سوگند تو سر بداد"
  },
  {
    "poem_id": 88041,
    "vorder": 46,
    "position": 1,
    "text": "تو دادی به خیره مر او را به باد"
  },
  {
    "poem_id": 88041,
    "vorder": 47,
    "position": 0,
    "text": "از آن پس که نزد تو فرزند من"
  },
  {
    "poem_id": 88041,
    "vorder": 48,
    "position": 1,
    "text": "بیامد کشیدی سر از پند من"
  },
  {
    "poem_id": 88041,
    "vorder": 49,
    "position": 0,
    "text": "شتابیدی و جنگ را ساختی"
  },
  {
    "poem_id": 88041,
    "vorder": 50,
    "position": 1,
    "text": "به کردار آتش همی تاختی"
  },
  {
    "poem_id": 88041,
    "vorder": 51,
    "position": 0,
    "text": "مرا حاجت از کردگار جهان"
  },
  {
    "poem_id": 88041,
    "vorder": 52,
    "position": 1,
    "text": "بر این گونه بود آشکار و نهان"
  },
  {
    "poem_id": 88041,
    "vorder": 53,
    "position": 0,
    "text": "که روزی تو پیش من آیی بجنگ"
  },
  {
    "poem_id": 88041,
    "vorder": 54,
    "position": 1,
    "text": "کنون آمدی نیست جای درنگ"
  },
  {
    "poem_id": 88041,
    "vorder": 55,
    "position": 0,
    "text": "به پیران سر اکنون به آوردگاه"
  },
  {
    "poem_id": 88041,
    "vorder": 56,
    "position": 1,
    "text": "بگردیم یک با دگر بی‌سپاه"
  }
]