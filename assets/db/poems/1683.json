[
  {
    "poem_id": 1683,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاه شد لشکر از درد شاه"
  },
  {
    "poem_id": 1683,
    "vorder": 2,
    "position": 1,
    "text": "جهان گشت بر نامداران سیاه"
  },
  {
    "poem_id": 1683,
    "vorder": 3,
    "position": 0,
    "text": "به تخت بزرگی نهادند روی"
  },
  {
    "poem_id": 1683,
    "vorder": 4,
    "position": 1,
    "text": "جهان شد سراسر پر از گفت‌وگوی"
  },
  {
    "poem_id": 1683,
    "vorder": 5,
    "position": 0,
    "text": "سکندر چو از لشکر آگاه شد"
  },
  {
    "poem_id": 1683,
    "vorder": 6,
    "position": 1,
    "text": "بدانست کش روز کوتاه شد"
  },
  {
    "poem_id": 1683,
    "vorder": 7,
    "position": 0,
    "text": "بفرمود تا تخت بیرون برند"
  },
  {
    "poem_id": 1683,
    "vorder": 8,
    "position": 1,
    "text": "از ایوان شاهی به هامون برند"
  },
  {
    "poem_id": 1683,
    "vorder": 9,
    "position": 0,
    "text": "ز بیماری او غمی شد سپاه"
  },
  {
    "poem_id": 1683,
    "vorder": 10,
    "position": 1,
    "text": "که بی‌رنگ دیدند رخسار شاه"
  },
  {
    "poem_id": 1683,
    "vorder": 11,
    "position": 0,
    "text": "همه دشت یکسر خروشان شدند"
  },
  {
    "poem_id": 1683,
    "vorder": 12,
    "position": 1,
    "text": "چو بر آتش تیز جوشان شدند"
  },
  {
    "poem_id": 1683,
    "vorder": 13,
    "position": 0,
    "text": "همی گفت هرکس که بد روزگار"
  },
  {
    "poem_id": 1683,
    "vorder": 14,
    "position": 1,
    "text": "که از رومیان کم شود شهریار"
  },
  {
    "poem_id": 1683,
    "vorder": 15,
    "position": 0,
    "text": "فرازآمد آن گردش بخت شوم"
  },
  {
    "poem_id": 1683,
    "vorder": 16,
    "position": 1,
    "text": "که ویران شود زین سپس مرز روم"
  },
  {
    "poem_id": 1683,
    "vorder": 17,
    "position": 0,
    "text": "همه دشمنان کام دل یافتند"
  },
  {
    "poem_id": 1683,
    "vorder": 18,
    "position": 1,
    "text": "رسیدند جایی که بشتافتند"
  },
  {
    "poem_id": 1683,
    "vorder": 19,
    "position": 0,
    "text": "بمابر کنون تلخ گردد جهان"
  },
  {
    "poem_id": 1683,
    "vorder": 20,
    "position": 1,
    "text": "خروشان شویم آشکار و نهان"
  },
  {
    "poem_id": 1683,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت قیصر به آوای نرم"
  },
  {
    "poem_id": 1683,
    "vorder": 22,
    "position": 1,
    "text": "که ترسنده باشید با رای و شرم"
  },
  {
    "poem_id": 1683,
    "vorder": 23,
    "position": 0,
    "text": "ز اندرز من سربسر مگذرید"
  },
  {
    "poem_id": 1683,
    "vorder": 24,
    "position": 1,
    "text": "چو خواهید کز جان و تن برخورید"
  },
  {
    "poem_id": 1683,
    "vorder": 25,
    "position": 0,
    "text": "پس از من شما را همینست کار"
  },
  {
    "poem_id": 1683,
    "vorder": 26,
    "position": 1,
    "text": "نه با من همی بد کند روزگار"
  },
  {
    "poem_id": 1683,
    "vorder": 27,
    "position": 0,
    "text": "بگفت این و جانش برآمد ز تن"
  },
  {
    "poem_id": 1683,
    "vorder": 28,
    "position": 1,
    "text": "شد آن نامور شاه لشکرشکن"
  },
  {
    "poem_id": 1683,
    "vorder": 29,
    "position": 0,
    "text": "ز لشکر سراسر برآمد خروش"
  },
  {
    "poem_id": 1683,
    "vorder": 30,
    "position": 1,
    "text": "ز فریاد لشکر بدرید گوش"
  },
  {
    "poem_id": 1683,
    "vorder": 31,
    "position": 0,
    "text": "همه خاک بر سر همی بیختند"
  },
  {
    "poem_id": 1683,
    "vorder": 32,
    "position": 1,
    "text": "ز مژگان همی خون دل ریختند"
  },
  {
    "poem_id": 1683,
    "vorder": 33,
    "position": 0,
    "text": "زدند آتش اندر سرای نشست"
  },
  {
    "poem_id": 1683,
    "vorder": 34,
    "position": 1,
    "text": "هزار اسپ را دم بریدند پست"
  },
  {
    "poem_id": 1683,
    "vorder": 35,
    "position": 0,
    "text": "نهاده بر اسپان نگونسار زین"
  },
  {
    "poem_id": 1683,
    "vorder": 36,
    "position": 1,
    "text": "تو گفتی همی برخروشد زمین"
  },
  {
    "poem_id": 1683,
    "vorder": 37,
    "position": 0,
    "text": "ببردند صندوق زرین به دشت"
  },
  {
    "poem_id": 1683,
    "vorder": 38,
    "position": 1,
    "text": "همی ناله از آسمان برگذشت"
  },
  {
    "poem_id": 1683,
    "vorder": 39,
    "position": 0,
    "text": "سکوبا بشستش به روشن گلاب"
  },
  {
    "poem_id": 1683,
    "vorder": 40,
    "position": 1,
    "text": "پراگند بر تنش کافور ناب"
  },
  {
    "poem_id": 1683,
    "vorder": 41,
    "position": 0,
    "text": "ز دیبای زربفت کردش کفن"
  },
  {
    "poem_id": 1683,
    "vorder": 42,
    "position": 1,
    "text": "خروشان بران شهریار انجمن"
  },
  {
    "poem_id": 1683,
    "vorder": 43,
    "position": 0,
    "text": "تن نامور زیر دیبای چین"
  },
  {
    "poem_id": 1683,
    "vorder": 44,
    "position": 1,
    "text": "نهادند تا پای در انگبین"
  },
  {
    "poem_id": 1683,
    "vorder": 45,
    "position": 0,
    "text": "سر تنگ تابوت کردند سخت"
  },
  {
    "poem_id": 1683,
    "vorder": 46,
    "position": 1,
    "text": "شد آن سایه گستر دلاور درخت"
  },
  {
    "poem_id": 1683,
    "vorder": 47,
    "position": 0,
    "text": "نمانی همی در سرای سپنج"
  },
  {
    "poem_id": 1683,
    "vorder": 48,
    "position": 1,
    "text": "چه یازی به تخت و چه نازی به گنج"
  },
  {
    "poem_id": 1683,
    "vorder": 49,
    "position": 0,
    "text": "چو تابوت زان دشت برداشتند"
  },
  {
    "poem_id": 1683,
    "vorder": 50,
    "position": 1,
    "text": "همه دست بر دست بگذاشتند"
  },
  {
    "poem_id": 1683,
    "vorder": 51,
    "position": 0,
    "text": "دو آواز شد رومی و پارسی"
  },
  {
    "poem_id": 1683,
    "vorder": 52,
    "position": 1,
    "text": "سخنشان ز تابوت بد یک بسی"
  },
  {
    "poem_id": 1683,
    "vorder": 53,
    "position": 0,
    "text": "هرانکس که او پارسی بود گفت"
  },
  {
    "poem_id": 1683,
    "vorder": 54,
    "position": 1,
    "text": "که او را جز ایدر نباید نهفت"
  },
  {
    "poem_id": 1683,
    "vorder": 55,
    "position": 0,
    "text": "چو ایدر بود خاک شاهنشهان"
  },
  {
    "poem_id": 1683,
    "vorder": 56,
    "position": 1,
    "text": "چه تازند تابوت گرد جهان"
  },
  {
    "poem_id": 1683,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت رومی یکی رهنمای"
  },
  {
    "poem_id": 1683,
    "vorder": 58,
    "position": 1,
    "text": "که ایدر نهفتن ورا نیست رای"
  },
  {
    "poem_id": 1683,
    "vorder": 59,
    "position": 0,
    "text": "اگر بشنوید آنچ گویم درست"
  },
  {
    "poem_id": 1683,
    "vorder": 60,
    "position": 1,
    "text": "سکندر در آن خاک ریزد که رست"
  },
  {
    "poem_id": 1683,
    "vorder": 61,
    "position": 0,
    "text": "یکی پارسی نیز گفت این سخن"
  },
  {
    "poem_id": 1683,
    "vorder": 62,
    "position": 1,
    "text": "که گر چندگویی نیاید به بن"
  },
  {
    "poem_id": 1683,
    "vorder": 63,
    "position": 0,
    "text": "نمایم شما را یکی مرغزار"
  },
  {
    "poem_id": 1683,
    "vorder": 64,
    "position": 1,
    "text": "ز شاهان و پیشینگان یادگار"
  },
  {
    "poem_id": 1683,
    "vorder": 65,
    "position": 0,
    "text": "ورا جرم خواند جهاندیده پیر"
  },
  {
    "poem_id": 1683,
    "vorder": 66,
    "position": 1,
    "text": "بدو اندرون بیشه و آبگیر"
  },
  {
    "poem_id": 1683,
    "vorder": 67,
    "position": 0,
    "text": "چو پرسی ترا پاسخ آید ز کوه"
  },
  {
    "poem_id": 1683,
    "vorder": 68,
    "position": 1,
    "text": "که آواز او بشنود هر گروه"
  },
  {
    "poem_id": 1683,
    "vorder": 69,
    "position": 0,
    "text": "بیارید مر پیر فرتوت را"
  },
  {
    "poem_id": 1683,
    "vorder": 70,
    "position": 1,
    "text": "هم ایدر بدارید تابوت را"
  },
  {
    "poem_id": 1683,
    "vorder": 71,
    "position": 0,
    "text": "بپرسید اگر کوه پاسخ دهد"
  },
  {
    "poem_id": 1683,
    "vorder": 72,
    "position": 1,
    "text": "شما را بدین رای فرخ نهد"
  },
  {
    "poem_id": 1683,
    "vorder": 73,
    "position": 0,
    "text": "برفتند پویان به کردار غرم"
  },
  {
    "poem_id": 1683,
    "vorder": 74,
    "position": 1,
    "text": "بدان بیشه کش باز خوانند جرم"
  },
  {
    "poem_id": 1683,
    "vorder": 75,
    "position": 0,
    "text": "بگفتند پاسخ چنین داد باز"
  },
  {
    "poem_id": 1683,
    "vorder": 76,
    "position": 1,
    "text": "که تابوت شاهان چه دارید راز"
  },
  {
    "poem_id": 1683,
    "vorder": 77,
    "position": 0,
    "text": "که خاک سکندر به اسکندریست"
  },
  {
    "poem_id": 1683,
    "vorder": 78,
    "position": 1,
    "text": "کجا کرده بد روزگاری که زیست"
  },
  {
    "poem_id": 1683,
    "vorder": 79,
    "position": 0,
    "text": "چو آواز بشنید لشکر برفت"
  },
  {
    "poem_id": 1683,
    "vorder": 80,
    "position": 1,
    "text": "ببردند زان بیشه صندوق تفت"
  }
]