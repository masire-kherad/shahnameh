[
  {
    "poem_id": 1370,
    "vorder": 1,
    "position": 0,
    "text": "به سلم و به تور آمد این آگهی"
  },
  {
    "poem_id": 1370,
    "vorder": 2,
    "position": 1,
    "text": "که شد روشن آن تخت شاهنشهی"
  },
  {
    "poem_id": 1370,
    "vorder": 3,
    "position": 0,
    "text": "دل هر دو بیدادگر پر نهیب"
  },
  {
    "poem_id": 1370,
    "vorder": 4,
    "position": 1,
    "text": "که اختر همی رفت سوی نشیب"
  },
  {
    "poem_id": 1370,
    "vorder": 5,
    "position": 0,
    "text": "نشستند هر دو به اندیشگان"
  },
  {
    "poem_id": 1370,
    "vorder": 6,
    "position": 1,
    "text": "شده تیره روز جفاپیشگان"
  },
  {
    "poem_id": 1370,
    "vorder": 7,
    "position": 0,
    "text": "یکایک بران رایشان شد درست"
  },
  {
    "poem_id": 1370,
    "vorder": 8,
    "position": 1,
    "text": "کزان روی شان چاره بایست جست"
  },
  {
    "poem_id": 1370,
    "vorder": 9,
    "position": 0,
    "text": "که سوی فریدون فرستند کس"
  },
  {
    "poem_id": 1370,
    "vorder": 10,
    "position": 1,
    "text": "به پوزش کجا چاره این بود بس"
  },
  {
    "poem_id": 1370,
    "vorder": 11,
    "position": 0,
    "text": "بجستند از آن انجمن هردوان"
  },
  {
    "poem_id": 1370,
    "vorder": 12,
    "position": 1,
    "text": "یکی پاک دل مرد چیره‌زبان"
  },
  {
    "poem_id": 1370,
    "vorder": 13,
    "position": 0,
    "text": "بدان مرد باهوش و با رای و شرم"
  },
  {
    "poem_id": 1370,
    "vorder": 14,
    "position": 1,
    "text": "بگفتند با لابه بسیار گرم"
  },
  {
    "poem_id": 1370,
    "vorder": 15,
    "position": 0,
    "text": "در گنج خاور گشادند باز"
  },
  {
    "poem_id": 1370,
    "vorder": 16,
    "position": 1,
    "text": "بدیدند هول نشیب از فراز"
  },
  {
    "poem_id": 1370,
    "vorder": 17,
    "position": 0,
    "text": "ز گنج گهر تاج زر خواستند"
  },
  {
    "poem_id": 1370,
    "vorder": 18,
    "position": 1,
    "text": "همی پشت پیلان بیاراستند"
  },
  {
    "poem_id": 1370,
    "vorder": 19,
    "position": 0,
    "text": "به گردونه‌ها بر چه مشک و عبیر"
  },
  {
    "poem_id": 1370,
    "vorder": 20,
    "position": 1,
    "text": "چه دیبا و دینار و خز و حریر"
  },
  {
    "poem_id": 1370,
    "vorder": 21,
    "position": 0,
    "text": "ابا پیل گردونکش و رنگ و بوی"
  },
  {
    "poem_id": 1370,
    "vorder": 22,
    "position": 1,
    "text": "ز خاور به ایران نهادند روی"
  },
  {
    "poem_id": 1370,
    "vorder": 23,
    "position": 0,
    "text": "هر آنکس که بد بر در شهریار"
  },
  {
    "poem_id": 1370,
    "vorder": 24,
    "position": 1,
    "text": "یکایک فرستادشان یادگار"
  },
  {
    "poem_id": 1370,
    "vorder": 25,
    "position": 0,
    "text": "چو پردخته‌شان شد دل از خواسته"
  },
  {
    "poem_id": 1370,
    "vorder": 26,
    "position": 1,
    "text": "فرستاده آمد برآراسته"
  },
  {
    "poem_id": 1370,
    "vorder": 27,
    "position": 0,
    "text": "بدادند نزد فریدون پیام"
  },
  {
    "poem_id": 1370,
    "vorder": 28,
    "position": 1,
    "text": "نخست از جهاندار بردند نام"
  },
  {
    "poem_id": 1370,
    "vorder": 29,
    "position": 0,
    "text": "که جاوید باد آفریدون گرد"
  },
  {
    "poem_id": 1370,
    "vorder": 30,
    "position": 1,
    "text": "همه فرهی ایزد او را سپرد"
  },
  {
    "poem_id": 1370,
    "vorder": 31,
    "position": 0,
    "text": "سرش سبز باد و تنش ارجمند"
  },
  {
    "poem_id": 1370,
    "vorder": 32,
    "position": 1,
    "text": "منش برگذشته ز چرخ بلند"
  },
  {
    "poem_id": 1370,
    "vorder": 33,
    "position": 0,
    "text": "بدان کان دو بدخواه بیدادگر"
  },
  {
    "poem_id": 1370,
    "vorder": 34,
    "position": 1,
    "text": "پر از آب دیده ز شرم پدر"
  },
  {
    "poem_id": 1370,
    "vorder": 35,
    "position": 0,
    "text": "پشیمان شده داغ دل بر گناه"
  },
  {
    "poem_id": 1370,
    "vorder": 36,
    "position": 1,
    "text": "همی سوی پوزش نمایند راه"
  },
  {
    "poem_id": 1370,
    "vorder": 37,
    "position": 0,
    "text": "چه گفتند دانندگان خرد"
  },
  {
    "poem_id": 1370,
    "vorder": 38,
    "position": 1,
    "text": "که هر کس که بد کرد کیفر برد"
  },
  {
    "poem_id": 1370,
    "vorder": 39,
    "position": 0,
    "text": "بماند به تیمار و دل پر ز درد"
  },
  {
    "poem_id": 1370,
    "vorder": 40,
    "position": 1,
    "text": "چو ما مانده‌ایم ای شه رادمرد"
  },
  {
    "poem_id": 1370,
    "vorder": 41,
    "position": 0,
    "text": "نوشته چنین بودمان از بوش"
  },
  {
    "poem_id": 1370,
    "vorder": 42,
    "position": 1,
    "text": "به رسم بوش اندر آمد روش"
  },
  {
    "poem_id": 1370,
    "vorder": 43,
    "position": 0,
    "text": "هژبر جهانسوز و نر اژدها"
  },
  {
    "poem_id": 1370,
    "vorder": 44,
    "position": 1,
    "text": "ز دام قضا هم نیابد رها"
  },
  {
    "poem_id": 1370,
    "vorder": 45,
    "position": 0,
    "text": "و دیگر که فرمان ناپاک دیو"
  },
  {
    "poem_id": 1370,
    "vorder": 46,
    "position": 1,
    "text": "ببرد دل از ترس گیهان خدیو"
  },
  {
    "poem_id": 1370,
    "vorder": 47,
    "position": 0,
    "text": "به ما بر چنین خیره شد رای بد"
  },
  {
    "poem_id": 1370,
    "vorder": 48,
    "position": 1,
    "text": "که مغز دو فرزند شد جای بد"
  },
  {
    "poem_id": 1370,
    "vorder": 49,
    "position": 0,
    "text": "همی چشم داریم از آن تاجور"
  },
  {
    "poem_id": 1370,
    "vorder": 50,
    "position": 1,
    "text": "که بخشایش آرد به ما بر مگر"
  },
  {
    "poem_id": 1370,
    "vorder": 51,
    "position": 0,
    "text": "اگر چه بزرگست ما را گناه"
  },
  {
    "poem_id": 1370,
    "vorder": 52,
    "position": 1,
    "text": "به بی‌دانشی برنهد پیشگاه"
  },
  {
    "poem_id": 1370,
    "vorder": 53,
    "position": 0,
    "text": "و دیگر بهانه سپهر بلند"
  },
  {
    "poem_id": 1370,
    "vorder": 54,
    "position": 1,
    "text": "که گاهی پناهست و گاهی گزند"
  },
  {
    "poem_id": 1370,
    "vorder": 55,
    "position": 0,
    "text": "سوم دیو کاندر میان چون نوند"
  },
  {
    "poem_id": 1370,
    "vorder": 56,
    "position": 1,
    "text": "میان بسته دارد ز بهر گزند"
  },
  {
    "poem_id": 1370,
    "vorder": 57,
    "position": 0,
    "text": "اگر پادشا را سر از کین ما"
  },
  {
    "poem_id": 1370,
    "vorder": 58,
    "position": 1,
    "text": "شود پاک و روشن شود دین ما"
  },
  {
    "poem_id": 1370,
    "vorder": 59,
    "position": 0,
    "text": "منوچهر را با سپاه گران"
  },
  {
    "poem_id": 1370,
    "vorder": 60,
    "position": 1,
    "text": "فرستد به نزدیک خواهشگران"
  },
  {
    "poem_id": 1370,
    "vorder": 61,
    "position": 0,
    "text": "بدان تا چو بنده به پیشش به پای"
  },
  {
    "poem_id": 1370,
    "vorder": 62,
    "position": 1,
    "text": "بباشیم جاوید و اینست رای"
  },
  {
    "poem_id": 1370,
    "vorder": 63,
    "position": 0,
    "text": "مگر کان درختی کزین کین برست"
  },
  {
    "poem_id": 1370,
    "vorder": 64,
    "position": 1,
    "text": "به آب دو دیده توانیم شست"
  },
  {
    "poem_id": 1370,
    "vorder": 65,
    "position": 0,
    "text": "بپوییم تا آب و رنجش دهیم"
  },
  {
    "poem_id": 1370,
    "vorder": 66,
    "position": 1,
    "text": "چو تازه شود تاج و گنجش دهیم"
  },
  {
    "poem_id": 1370,
    "vorder": 67,
    "position": 0,
    "text": "فرستاده آمد دلی پر سخن"
  },
  {
    "poem_id": 1370,
    "vorder": 68,
    "position": 1,
    "text": "سخن را نه سر بود پیدا نه بن"
  },
  {
    "poem_id": 1370,
    "vorder": 69,
    "position": 0,
    "text": "ابا پیل و با گنج و با خواسته"
  },
  {
    "poem_id": 1370,
    "vorder": 70,
    "position": 1,
    "text": "به درگاه شاه آمد آراسته"
  },
  {
    "poem_id": 1370,
    "vorder": 71,
    "position": 0,
    "text": "به شاه آفریدون رسید آگهی"
  },
  {
    "poem_id": 1370,
    "vorder": 72,
    "position": 1,
    "text": "بفرمود تا تخت شاهنشهی"
  },
  {
    "poem_id": 1370,
    "vorder": 73,
    "position": 0,
    "text": "به دیبای چینی بیاراستند"
  },
  {
    "poem_id": 1370,
    "vorder": 74,
    "position": 1,
    "text": "کلاه کیانی بپیراستند"
  },
  {
    "poem_id": 1370,
    "vorder": 75,
    "position": 0,
    "text": "نشست از بر تخت پیروزه شاه"
  },
  {
    "poem_id": 1370,
    "vorder": 76,
    "position": 1,
    "text": "چو سرو سهی بر سرش گرد ماه"
  },
  {
    "poem_id": 1370,
    "vorder": 77,
    "position": 0,
    "text": "ابا تاج و با طوق و باگوشوار"
  },
  {
    "poem_id": 1370,
    "vorder": 78,
    "position": 1,
    "text": "چنان چون بود در خور شهریار"
  },
  {
    "poem_id": 1370,
    "vorder": 79,
    "position": 0,
    "text": "خجسته منوچهر بر دست شاه"
  },
  {
    "poem_id": 1370,
    "vorder": 80,
    "position": 1,
    "text": "نشسته نهاده به سر بر کلاه"
  },
  {
    "poem_id": 1370,
    "vorder": 81,
    "position": 0,
    "text": "به زرین عمود و به زرین کمر"
  },
  {
    "poem_id": 1370,
    "vorder": 82,
    "position": 1,
    "text": "زمین کرده خورشیدگون سر به سر"
  },
  {
    "poem_id": 1370,
    "vorder": 83,
    "position": 0,
    "text": "دو رویه بزرگان کشیده رده"
  },
  {
    "poem_id": 1370,
    "vorder": 84,
    "position": 1,
    "text": "سراپای یکسر به زر آژده"
  },
  {
    "poem_id": 1370,
    "vorder": 85,
    "position": 0,
    "text": "به یک دست بربسته شیر و پلنگ"
  },
  {
    "poem_id": 1370,
    "vorder": 86,
    "position": 1,
    "text": "به دست دگر ژنده پیلان جنگ"
  },
  {
    "poem_id": 1370,
    "vorder": 87,
    "position": 0,
    "text": "برون شد ز درگاه شاپور گرد"
  },
  {
    "poem_id": 1370,
    "vorder": 88,
    "position": 1,
    "text": "فرستادهٔ سلم را پیش برد"
  },
  {
    "poem_id": 1370,
    "vorder": 89,
    "position": 0,
    "text": "فرستاده چون دید درگاه شاه"
  },
  {
    "poem_id": 1370,
    "vorder": 90,
    "position": 1,
    "text": "پیاده دوان اندر آمد ز راه"
  },
  {
    "poem_id": 1370,
    "vorder": 91,
    "position": 0,
    "text": "چو نزدیک شاه آفریدون رسید"
  },
  {
    "poem_id": 1370,
    "vorder": 92,
    "position": 1,
    "text": "سر و تخت و تاج بلندش بدید"
  },
  {
    "poem_id": 1370,
    "vorder": 93,
    "position": 0,
    "text": "ز بالا فرو برد سر پیش اوی"
  },
  {
    "poem_id": 1370,
    "vorder": 94,
    "position": 1,
    "text": "همی بر زمین بر بمالید روی"
  },
  {
    "poem_id": 1370,
    "vorder": 95,
    "position": 0,
    "text": "گرانمایه شاه جهان کدخدای"
  },
  {
    "poem_id": 1370,
    "vorder": 96,
    "position": 1,
    "text": "به کرسی زرین ورا کرد جای"
  },
  {
    "poem_id": 1370,
    "vorder": 97,
    "position": 0,
    "text": "فرستاده بر شاه کرد آفرین"
  },
  {
    "poem_id": 1370,
    "vorder": 98,
    "position": 1,
    "text": "که ای نازش تاج و تخت و نگین"
  },
  {
    "poem_id": 1370,
    "vorder": 99,
    "position": 0,
    "text": "زمین گلشن از پایهٔ تخت تست"
  },
  {
    "poem_id": 1370,
    "vorder": 100,
    "position": 1,
    "text": "زمان روشن از مایهٔ بخت تست"
  },
  {
    "poem_id": 1370,
    "vorder": 101,
    "position": 0,
    "text": "همه بندهٔ خاک پای توایم"
  },
  {
    "poem_id": 1370,
    "vorder": 102,
    "position": 1,
    "text": "همه پاک زنده به رای توایم"
  },
  {
    "poem_id": 1370,
    "vorder": 103,
    "position": 0,
    "text": "پیام دو خونی به گفتن گرفت"
  },
  {
    "poem_id": 1370,
    "vorder": 104,
    "position": 1,
    "text": "همه راستیها نهفتن گرفت"
  },
  {
    "poem_id": 1370,
    "vorder": 105,
    "position": 0,
    "text": "گشاده زبان مرد بسیار هوش"
  },
  {
    "poem_id": 1370,
    "vorder": 106,
    "position": 1,
    "text": "بدو داده شاه جهاندار گوش"
  },
  {
    "poem_id": 1370,
    "vorder": 107,
    "position": 0,
    "text": "ز کردار بد پوزش آراستن"
  },
  {
    "poem_id": 1370,
    "vorder": 108,
    "position": 1,
    "text": "منوچهر را نزد خود خواستن"
  },
  {
    "poem_id": 1370,
    "vorder": 109,
    "position": 0,
    "text": "میان بستن او را بسان رهی"
  },
  {
    "poem_id": 1370,
    "vorder": 110,
    "position": 1,
    "text": "سپردن بدو تاج و تخت مهی"
  },
  {
    "poem_id": 1370,
    "vorder": 111,
    "position": 0,
    "text": "خریدن ازو باز خون پدر"
  },
  {
    "poem_id": 1370,
    "vorder": 112,
    "position": 1,
    "text": "بدینار و دیبا و تاج و کمر"
  },
  {
    "poem_id": 1370,
    "vorder": 113,
    "position": 0,
    "text": "فرستاده گفت و سپهبد شنید"
  },
  {
    "poem_id": 1370,
    "vorder": 114,
    "position": 1,
    "text": "مر آن بند را پاسخ آمد کلید"
  },
  {
    "poem_id": 1370,
    "vorder": 115,
    "position": 0,
    "text": "چو بشنید شاه جهان کدخدای"
  },
  {
    "poem_id": 1370,
    "vorder": 116,
    "position": 1,
    "text": "پیام دو فرزند ناپاک رای"
  },
  {
    "poem_id": 1370,
    "vorder": 117,
    "position": 0,
    "text": "یکایک بمرد گرانمایه گفت"
  },
  {
    "poem_id": 1370,
    "vorder": 118,
    "position": 1,
    "text": "که خورشید را چون توانی نهفت"
  },
  {
    "poem_id": 1370,
    "vorder": 119,
    "position": 0,
    "text": "نهان دل آن دو مرد پلید"
  },
  {
    "poem_id": 1370,
    "vorder": 120,
    "position": 1,
    "text": "ز خورشید روشن‌تر آمد پدید"
  },
  {
    "poem_id": 1370,
    "vorder": 121,
    "position": 0,
    "text": "شنیدم همه هر چه گفتی سخن"
  },
  {
    "poem_id": 1370,
    "vorder": 122,
    "position": 1,
    "text": "نگه کن که پاسخ چه یابی ز بن"
  },
  {
    "poem_id": 1370,
    "vorder": 123,
    "position": 0,
    "text": "بگو آن دو بی‌شرم ناپاک را"
  },
  {
    "poem_id": 1370,
    "vorder": 124,
    "position": 1,
    "text": "دو بیداد و بد مهر و ناباک را"
  },
  {
    "poem_id": 1370,
    "vorder": 125,
    "position": 0,
    "text": "که گفتار خیره نیرزد به چیز"
  },
  {
    "poem_id": 1370,
    "vorder": 126,
    "position": 1,
    "text": "ازین در سخن خود نرانیم نیز"
  },
  {
    "poem_id": 1370,
    "vorder": 127,
    "position": 0,
    "text": "اگر بر منوچهرتان مهر خاست"
  },
  {
    "poem_id": 1370,
    "vorder": 128,
    "position": 1,
    "text": "تن ایرج نامورتان کجاست"
  },
  {
    "poem_id": 1370,
    "vorder": 129,
    "position": 0,
    "text": "که کام دد و دام بودش نهفت"
  },
  {
    "poem_id": 1370,
    "vorder": 130,
    "position": 1,
    "text": "سرش را یکی تنگ تابوت جفت"
  },
  {
    "poem_id": 1370,
    "vorder": 131,
    "position": 0,
    "text": "کنون چون ز ایرج بپرداختید"
  },
  {
    "poem_id": 1370,
    "vorder": 132,
    "position": 1,
    "text": "به کین منوچهر بر ساختید"
  },
  {
    "poem_id": 1370,
    "vorder": 133,
    "position": 0,
    "text": "نبینید رویش مگر با سپاه"
  },
  {
    "poem_id": 1370,
    "vorder": 134,
    "position": 1,
    "text": "ز پولاد بر سر نهاده کلاه"
  },
  {
    "poem_id": 1370,
    "vorder": 135,
    "position": 0,
    "text": "ابا گرز و با کاویانی درفش"
  },
  {
    "poem_id": 1370,
    "vorder": 136,
    "position": 1,
    "text": "زمین کرده از سم اسپان بنفش"
  },
  {
    "poem_id": 1370,
    "vorder": 137,
    "position": 0,
    "text": "سپهدار چون قارن رزم زن"
  },
  {
    "poem_id": 1370,
    "vorder": 138,
    "position": 1,
    "text": "چو شاپور و نستوه شمشیر زن"
  },
  {
    "poem_id": 1370,
    "vorder": 139,
    "position": 0,
    "text": "به یک دست شیدوش جنگی به پای"
  },
  {
    "poem_id": 1370,
    "vorder": 140,
    "position": 1,
    "text": "چو شیروی شیراوژن رهنمای"
  },
  {
    "poem_id": 1370,
    "vorder": 141,
    "position": 0,
    "text": "چو سام نریمان و سرو یمن"
  },
  {
    "poem_id": 1370,
    "vorder": 142,
    "position": 1,
    "text": "به پیش سپاه اندرون رای زن"
  },
  {
    "poem_id": 1370,
    "vorder": 143,
    "position": 0,
    "text": "درختی که از کین ایرج برست"
  },
  {
    "poem_id": 1370,
    "vorder": 144,
    "position": 1,
    "text": "به خون برگ و بارش بخواهیم شست"
  },
  {
    "poem_id": 1370,
    "vorder": 145,
    "position": 0,
    "text": "از آن تاکنون کین او کس نخواست"
  },
  {
    "poem_id": 1370,
    "vorder": 146,
    "position": 1,
    "text": "که پشت زمانه ندیدیم راست"
  },
  {
    "poem_id": 1370,
    "vorder": 147,
    "position": 0,
    "text": "نه خوب آمدی با دو فرزند خویش"
  },
  {
    "poem_id": 1370,
    "vorder": 148,
    "position": 1,
    "text": "کجا جنگ را کردمی دست پیش"
  },
  {
    "poem_id": 1370,
    "vorder": 149,
    "position": 0,
    "text": "کنون زان درختی که دشمن بکند"
  },
  {
    "poem_id": 1370,
    "vorder": 150,
    "position": 1,
    "text": "برومند شاخی برآمد بلند"
  },
  {
    "poem_id": 1370,
    "vorder": 151,
    "position": 0,
    "text": "بیاید کنون چون هژبر ژیان"
  },
  {
    "poem_id": 1370,
    "vorder": 152,
    "position": 1,
    "text": "به کین پدر تنگ بسته میان"
  },
  {
    "poem_id": 1370,
    "vorder": 153,
    "position": 0,
    "text": "فرستاده آن هول گفتار دید"
  },
  {
    "poem_id": 1370,
    "vorder": 154,
    "position": 1,
    "text": "نشست منوچهر سالار دید"
  },
  {
    "poem_id": 1370,
    "vorder": 155,
    "position": 0,
    "text": "بپژمرد و برخاست لرزان ز جای"
  },
  {
    "poem_id": 1370,
    "vorder": 156,
    "position": 1,
    "text": "هم آنگه به زین اندر آورد پای"
  },
  {
    "poem_id": 1370,
    "vorder": 157,
    "position": 0,
    "text": "همه بودنیها به روشن روان"
  },
  {
    "poem_id": 1370,
    "vorder": 158,
    "position": 1,
    "text": "بدید آن گرانمایه مرد جوان"
  },
  {
    "poem_id": 1370,
    "vorder": 159,
    "position": 0,
    "text": "که با سلم و با تور گردان سپهر"
  },
  {
    "poem_id": 1370,
    "vorder": 160,
    "position": 1,
    "text": "نه بس دیر چین اندر آرد بچهر"
  },
  {
    "poem_id": 1370,
    "vorder": 161,
    "position": 0,
    "text": "بیامد به کردار باد دمان"
  },
  {
    "poem_id": 1370,
    "vorder": 162,
    "position": 1,
    "text": "سری پر ز پاسخ دلی پرگمان"
  },
  {
    "poem_id": 1370,
    "vorder": 163,
    "position": 0,
    "text": "ز دیدار چون خاور آمد پدید"
  },
  {
    "poem_id": 1370,
    "vorder": 164,
    "position": 1,
    "text": "به هامون کشیده سراپرده دید"
  },
  {
    "poem_id": 1370,
    "vorder": 165,
    "position": 0,
    "text": "بیامد به درگاه پرده سرای"
  },
  {
    "poem_id": 1370,
    "vorder": 166,
    "position": 1,
    "text": "به پرده درون بود خاور خدای"
  },
  {
    "poem_id": 1370,
    "vorder": 167,
    "position": 0,
    "text": "یکی خیمهٔ پرنیان ساخته"
  },
  {
    "poem_id": 1370,
    "vorder": 168,
    "position": 1,
    "text": "ستاره زده جای پرداخته"
  },
  {
    "poem_id": 1370,
    "vorder": 169,
    "position": 0,
    "text": "دو شاه دو کشور نشسته به راز"
  },
  {
    "poem_id": 1370,
    "vorder": 170,
    "position": 1,
    "text": "بگفتند کامد فرستاده باز"
  },
  {
    "poem_id": 1370,
    "vorder": 171,
    "position": 0,
    "text": "بیامد هم آنگاه سالار بار"
  },
  {
    "poem_id": 1370,
    "vorder": 172,
    "position": 1,
    "text": "فرستاده را برد زی شهریار"
  },
  {
    "poem_id": 1370,
    "vorder": 173,
    "position": 0,
    "text": "نشستنگهی نو بیاراستند"
  },
  {
    "poem_id": 1370,
    "vorder": 174,
    "position": 1,
    "text": "ز شاه نو آیین خبر خواستند"
  },
  {
    "poem_id": 1370,
    "vorder": 175,
    "position": 0,
    "text": "بجستند هر گونه‌ای آگهی"
  },
  {
    "poem_id": 1370,
    "vorder": 176,
    "position": 1,
    "text": "ز دیهیم و از تخت شاهنشهی"
  },
  {
    "poem_id": 1370,
    "vorder": 177,
    "position": 0,
    "text": "ز شاه آفریدون و از لشکرش"
  },
  {
    "poem_id": 1370,
    "vorder": 178,
    "position": 1,
    "text": "ز گردان جنگی و از کشورش"
  },
  {
    "poem_id": 1370,
    "vorder": 179,
    "position": 0,
    "text": "و دیگر ز کردار گردان سپهر"
  },
  {
    "poem_id": 1370,
    "vorder": 180,
    "position": 1,
    "text": "که دارد همی بر منوچهر مهر"
  },
  {
    "poem_id": 1370,
    "vorder": 181,
    "position": 0,
    "text": "بزرگان کدامند و دستور کیست"
  },
  {
    "poem_id": 1370,
    "vorder": 182,
    "position": 1,
    "text": "چه مایستشان گنج و گنجور کیست"
  },
  {
    "poem_id": 1370,
    "vorder": 183,
    "position": 0,
    "text": "فرستاده گفت آنکه روشن بهار"
  },
  {
    "poem_id": 1370,
    "vorder": 184,
    "position": 1,
    "text": "بدید و ببیند در شهریار"
  },
  {
    "poem_id": 1370,
    "vorder": 185,
    "position": 0,
    "text": "بهاری ست خرم در اردیبهشت"
  },
  {
    "poem_id": 1370,
    "vorder": 186,
    "position": 1,
    "text": "همه خاک عنبر همه زر خشت"
  },
  {
    "poem_id": 1370,
    "vorder": 187,
    "position": 0,
    "text": "سپهر برین کاخ و میدان اوست"
  },
  {
    "poem_id": 1370,
    "vorder": 188,
    "position": 1,
    "text": "بهشت برین روی خندان اوست"
  },
  {
    "poem_id": 1370,
    "vorder": 189,
    "position": 0,
    "text": "به بالای ایوان او راغ نیست"
  },
  {
    "poem_id": 1370,
    "vorder": 190,
    "position": 1,
    "text": "به پهنای میدان او باغ نیست"
  },
  {
    "poem_id": 1370,
    "vorder": 191,
    "position": 0,
    "text": "چو رفتم به نزدیک ایوان فراز"
  },
  {
    "poem_id": 1370,
    "vorder": 192,
    "position": 1,
    "text": "سرش با ستاره همی گفت راز"
  },
  {
    "poem_id": 1370,
    "vorder": 193,
    "position": 0,
    "text": "به یک دست پیل و به یک دست شیر"
  },
  {
    "poem_id": 1370,
    "vorder": 194,
    "position": 1,
    "text": "جهان را به تخت اندر آورده زیر"
  },
  {
    "poem_id": 1370,
    "vorder": 195,
    "position": 0,
    "text": "ابر پشت پیلانش بر تخت زر"
  },
  {
    "poem_id": 1370,
    "vorder": 196,
    "position": 1,
    "text": "ز گوهر همه طوق شیران نر"
  },
  {
    "poem_id": 1370,
    "vorder": 197,
    "position": 0,
    "text": "تبیره زنان پیش پیلان به پای"
  },
  {
    "poem_id": 1370,
    "vorder": 198,
    "position": 1,
    "text": "ز هر سو خروشیدن کره نای"
  },
  {
    "poem_id": 1370,
    "vorder": 199,
    "position": 0,
    "text": "تو گفتی که میدان بجوشد همی"
  },
  {
    "poem_id": 1370,
    "vorder": 200,
    "position": 1,
    "text": "زمین به آسمان بر خروشد همی"
  },
  {
    "poem_id": 1370,
    "vorder": 201,
    "position": 0,
    "text": "خرامان شدم پیش آن ارجمند"
  },
  {
    "poem_id": 1370,
    "vorder": 202,
    "position": 1,
    "text": "یکی تخت پیروزه دیدم بلند"
  },
  {
    "poem_id": 1370,
    "vorder": 203,
    "position": 0,
    "text": "نشسته برو شهریاری چو ماه"
  },
  {
    "poem_id": 1370,
    "vorder": 204,
    "position": 1,
    "text": "ز یاقوت رخشان به سر بر کلاه"
  },
  {
    "poem_id": 1370,
    "vorder": 205,
    "position": 0,
    "text": "چو کافور موی و چو گلبرگ روی"
  },
  {
    "poem_id": 1370,
    "vorder": 206,
    "position": 1,
    "text": "دل آزرم جوی و زبان چرب‌گوی"
  },
  {
    "poem_id": 1370,
    "vorder": 207,
    "position": 0,
    "text": "جهان را ازو دل به بیم و امید"
  },
  {
    "poem_id": 1370,
    "vorder": 208,
    "position": 1,
    "text": "تو گفتی مگر زنده شد جمشید"
  },
  {
    "poem_id": 1370,
    "vorder": 209,
    "position": 0,
    "text": "منوچهر چون زاد سرو بلند"
  },
  {
    "poem_id": 1370,
    "vorder": 210,
    "position": 1,
    "text": "به کردار طهمورث دیوبند"
  },
  {
    "poem_id": 1370,
    "vorder": 211,
    "position": 0,
    "text": "نشسته بر شاه بر دست راست"
  },
  {
    "poem_id": 1370,
    "vorder": 212,
    "position": 1,
    "text": "تو گویی زبان و دل پادشاست"
  },
  {
    "poem_id": 1370,
    "vorder": 213,
    "position": 0,
    "text": "به پیش اندرون قارن رزم زن"
  },
  {
    "poem_id": 1370,
    "vorder": 214,
    "position": 1,
    "text": "به دست چپش سرو شاه یمن"
  },
  {
    "poem_id": 1370,
    "vorder": 215,
    "position": 0,
    "text": "چو شاه یمن سرو دستورشان"
  },
  {
    "poem_id": 1370,
    "vorder": 216,
    "position": 1,
    "text": "چو پیروز گرشاسپ گنجورشان"
  },
  {
    "poem_id": 1370,
    "vorder": 217,
    "position": 0,
    "text": "شمار در گنجها ناپدید"
  },
  {
    "poem_id": 1370,
    "vorder": 218,
    "position": 1,
    "text": "کس اندر جهان آن بزرگی ندید"
  },
  {
    "poem_id": 1370,
    "vorder": 219,
    "position": 0,
    "text": "همه گرد ایوان دو رویه سپاه"
  },
  {
    "poem_id": 1370,
    "vorder": 220,
    "position": 1,
    "text": "به زرین عمود و به زرین کلاه"
  },
  {
    "poem_id": 1370,
    "vorder": 221,
    "position": 0,
    "text": "سپهدار چون قارن کاوگان"
  },
  {
    "poem_id": 1370,
    "vorder": 222,
    "position": 1,
    "text": "به پیش سپاه اندرون آوگان"
  },
  {
    "poem_id": 1370,
    "vorder": 223,
    "position": 0,
    "text": "مبارز چو شیروی درنده شیر"
  },
  {
    "poem_id": 1370,
    "vorder": 224,
    "position": 1,
    "text": "چو شاپور یل ژنده پیل دلیر"
  },
  {
    "poem_id": 1370,
    "vorder": 225,
    "position": 0,
    "text": "چنو بست بر کوههٔ پیل کوس"
  },
  {
    "poem_id": 1370,
    "vorder": 226,
    "position": 1,
    "text": "هوا گردد از گرد چون آبنوس"
  },
  {
    "poem_id": 1370,
    "vorder": 227,
    "position": 0,
    "text": "گر آیند زی ما به جنگ آن گروه"
  },
  {
    "poem_id": 1370,
    "vorder": 228,
    "position": 1,
    "text": "شود کوه هامون و هامون کوه"
  },
  {
    "poem_id": 1370,
    "vorder": 229,
    "position": 0,
    "text": "همه دل پر از کین و پرچین بروی"
  },
  {
    "poem_id": 1370,
    "vorder": 230,
    "position": 1,
    "text": "به جز جنگشان نیست چیز آرزوی"
  },
  {
    "poem_id": 1370,
    "vorder": 231,
    "position": 0,
    "text": "بریشان همه برشمرد آنچه دید"
  },
  {
    "poem_id": 1370,
    "vorder": 232,
    "position": 1,
    "text": "سخن نیز کز آفریدون شنید"
  },
  {
    "poem_id": 1370,
    "vorder": 233,
    "position": 0,
    "text": "دو مرد جفا پیشه را دل ز درد"
  },
  {
    "poem_id": 1370,
    "vorder": 234,
    "position": 1,
    "text": "بپیچید و شد رویشان لاژورد"
  },
  {
    "poem_id": 1370,
    "vorder": 235,
    "position": 0,
    "text": "نشستند و جستند هرگونه رای"
  },
  {
    "poem_id": 1370,
    "vorder": 236,
    "position": 1,
    "text": "سخن را نه سر بود پیدا نه پای"
  },
  {
    "poem_id": 1370,
    "vorder": 237,
    "position": 0,
    "text": "به سلم بزرگ آنگهی تور گفت"
  },
  {
    "poem_id": 1370,
    "vorder": 238,
    "position": 1,
    "text": "که آرام و شادی بباید نهفت"
  },
  {
    "poem_id": 1370,
    "vorder": 239,
    "position": 0,
    "text": "نباید که آن بچهٔ نره‌شیر"
  },
  {
    "poem_id": 1370,
    "vorder": 240,
    "position": 1,
    "text": "شود تیزدندان و گردد دلیر"
  },
  {
    "poem_id": 1370,
    "vorder": 241,
    "position": 0,
    "text": "چنان نامور بی‌هنر چون بود"
  },
  {
    "poem_id": 1370,
    "vorder": 242,
    "position": 1,
    "text": "کش آموزگار آفریدون بود"
  },
  {
    "poem_id": 1370,
    "vorder": 243,
    "position": 0,
    "text": "نبیره چو شد رای زن با نیا"
  },
  {
    "poem_id": 1370,
    "vorder": 244,
    "position": 1,
    "text": "ازان جایگه بردمد کیمیا"
  },
  {
    "poem_id": 1370,
    "vorder": 245,
    "position": 0,
    "text": "بباید بسیچید ما را بجنگ"
  },
  {
    "poem_id": 1370,
    "vorder": 246,
    "position": 1,
    "text": "شتاب آوریدن به جای درنگ"
  },
  {
    "poem_id": 1370,
    "vorder": 247,
    "position": 0,
    "text": "ز لشکر سواران برون تاختند"
  },
  {
    "poem_id": 1370,
    "vorder": 248,
    "position": 1,
    "text": "ز چین و ز خاور سپه ساختند"
  },
  {
    "poem_id": 1370,
    "vorder": 249,
    "position": 0,
    "text": "فتاد اندران بوم و بر گفت‌گوی"
  },
  {
    "poem_id": 1370,
    "vorder": 250,
    "position": 1,
    "text": "جهانی بدیشان نهادند روی"
  },
  {
    "poem_id": 1370,
    "vorder": 251,
    "position": 0,
    "text": "سپاهی که آن را کرانه نبود"
  },
  {
    "poem_id": 1370,
    "vorder": 252,
    "position": 1,
    "text": "بدان بد که اختر جوانه نبود"
  },
  {
    "poem_id": 1370,
    "vorder": 253,
    "position": 0,
    "text": "ز خاور دو لشکر به ایران کشید"
  },
  {
    "poem_id": 1370,
    "vorder": 254,
    "position": 1,
