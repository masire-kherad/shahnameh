[
  {
    "poem_id": 1451,
    "vorder": 1,
    "position": 0,
    "text": "دگر روز لشکر بیاراستند"
  },
  {
    "poem_id": 1451,
    "vorder": 2,
    "position": 1,
    "text": "درفش از دو رویه بپیراستند"
  },
  {
    "poem_id": 1451,
    "vorder": 3,
    "position": 0,
    "text": "به هاماوران بود صد ژنده پیل"
  },
  {
    "poem_id": 1451,
    "vorder": 4,
    "position": 1,
    "text": "یکی لشکری ساخته بر دو میل"
  },
  {
    "poem_id": 1451,
    "vorder": 5,
    "position": 0,
    "text": "از آوای گردان بتوفید کوه"
  },
  {
    "poem_id": 1451,
    "vorder": 6,
    "position": 1,
    "text": "زمین آمد از نعل اسپان ستوه"
  },
  {
    "poem_id": 1451,
    "vorder": 7,
    "position": 0,
    "text": "تو گفتی جهان سر به سر آهن‌ست"
  },
  {
    "poem_id": 1451,
    "vorder": 8,
    "position": 1,
    "text": "وگر کوه البرز در جوشن‌ست"
  },
  {
    "poem_id": 1451,
    "vorder": 9,
    "position": 0,
    "text": "پس پشت پیلان درفشان درفش"
  },
  {
    "poem_id": 1451,
    "vorder": 10,
    "position": 1,
    "text": "بگرد اندرون سرخ و زرد و بنفش"
  },
  {
    "poem_id": 1451,
    "vorder": 11,
    "position": 0,
    "text": "بدرید چنگ و دل شیر نر"
  },
  {
    "poem_id": 1451,
    "vorder": 12,
    "position": 1,
    "text": "عقاب دلاور بیفگند پر"
  },
  {
    "poem_id": 1451,
    "vorder": 13,
    "position": 0,
    "text": "همی ابر بگداخت اندر هوا"
  },
  {
    "poem_id": 1451,
    "vorder": 14,
    "position": 1,
    "text": "برابر که دید ایستادن روا"
  },
  {
    "poem_id": 1451,
    "vorder": 15,
    "position": 0,
    "text": "سپهبد چو لشکر به هامون کشید"
  },
  {
    "poem_id": 1451,
    "vorder": 16,
    "position": 1,
    "text": "سپاه سه شاه و سه کشور بدید"
  },
  {
    "poem_id": 1451,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت با لشکر سرفراز"
  },
  {
    "poem_id": 1451,
    "vorder": 18,
    "position": 1,
    "text": "که از نیزهٔ مژگان مدارید باز"
  },
  {
    "poem_id": 1451,
    "vorder": 19,
    "position": 0,
    "text": "بش و یال بینید و اسپ و عنان"
  },
  {
    "poem_id": 1451,
    "vorder": 20,
    "position": 1,
    "text": "دو دیده نهاده به نوک سنان"
  },
  {
    "poem_id": 1451,
    "vorder": 21,
    "position": 0,
    "text": "اگر صدهزارند و ما صدسوار"
  },
  {
    "poem_id": 1451,
    "vorder": 22,
    "position": 1,
    "text": "فزونی لشکر نیاید به کار"
  },
  {
    "poem_id": 1451,
    "vorder": 23,
    "position": 0,
    "text": "برآمد درخشیدن تیر و خشت"
  },
  {
    "poem_id": 1451,
    "vorder": 24,
    "position": 1,
    "text": "تو گفتی هوا بر زمین لاله کشت"
  },
  {
    "poem_id": 1451,
    "vorder": 25,
    "position": 0,
    "text": "ز خون دشت گفتی میستان شدست"
  },
  {
    "poem_id": 1451,
    "vorder": 26,
    "position": 1,
    "text": "ز نیزه هوا چون نیستان شدست"
  },
  {
    "poem_id": 1451,
    "vorder": 27,
    "position": 0,
    "text": "بریده ز هر سو سر ترک‌دار"
  },
  {
    "poem_id": 1451,
    "vorder": 28,
    "position": 1,
    "text": "پراگنده خفتان همه دشت و غار"
  },
  {
    "poem_id": 1451,
    "vorder": 29,
    "position": 0,
    "text": "تهمتن مران رخش را تیز کرد"
  },
  {
    "poem_id": 1451,
    "vorder": 30,
    "position": 1,
    "text": "ز خون فرومایه پرهیز کرد"
  },
  {
    "poem_id": 1451,
    "vorder": 31,
    "position": 0,
    "text": "همی تاخت اندر پی شاه شام"
  },
  {
    "poem_id": 1451,
    "vorder": 32,
    "position": 1,
    "text": "بینداخت از باد خمیده خام"
  },
  {
    "poem_id": 1451,
    "vorder": 33,
    "position": 0,
    "text": "میانش به حلقه درآورد گرد"
  },
  {
    "poem_id": 1451,
    "vorder": 34,
    "position": 1,
    "text": "تو گفتی خم اندر میانش فسرد"
  },
  {
    "poem_id": 1451,
    "vorder": 35,
    "position": 0,
    "text": "ز زین برگرفتش به کردار گوی"
  },
  {
    "poem_id": 1451,
    "vorder": 36,
    "position": 1,
    "text": "چو چوگان به زخم اندر آمد بدوی"
  },
  {
    "poem_id": 1451,
    "vorder": 37,
    "position": 0,
    "text": "بیفگند و فرهاد دستش ببست"
  },
  {
    "poem_id": 1451,
    "vorder": 38,
    "position": 1,
    "text": "گرفتار شد نامبردار شست"
  },
  {
    "poem_id": 1451,
    "vorder": 39,
    "position": 0,
    "text": "ز خون خاک دریا شد و دشت کوه"
  },
  {
    "poem_id": 1451,
    "vorder": 40,
    "position": 1,
    "text": "ز بس کشته افگنده از هر گروه"
  },
  {
    "poem_id": 1451,
    "vorder": 41,
    "position": 0,
    "text": "شه بربرستان بچنگ گراز"
  },
  {
    "poem_id": 1451,
    "vorder": 42,
    "position": 1,
    "text": "گرفتار شد با چهل رزم‌ساز"
  },
  {
    "poem_id": 1451,
    "vorder": 43,
    "position": 0,
    "text": "ز کشته زمین گشت مانند کوه"
  },
  {
    "poem_id": 1451,
    "vorder": 44,
    "position": 1,
    "text": "همان شاه هاماوران شد ستوه"
  },
  {
    "poem_id": 1451,
    "vorder": 45,
    "position": 0,
    "text": "به پیمان که کاووس را با سران"
  },
  {
    "poem_id": 1451,
    "vorder": 46,
    "position": 1,
    "text": "بر رستم آرد ز هاماوران"
  },
  {
    "poem_id": 1451,
    "vorder": 47,
    "position": 0,
    "text": "سراپرده و گنج و تاج و گهر"
  },
  {
    "poem_id": 1451,
    "vorder": 48,
    "position": 1,
    "text": "پرستنده و تخت و زرین کمر"
  },
  {
    "poem_id": 1451,
    "vorder": 49,
    "position": 0,
    "text": "برین بر نهادند و برخاستند"
  },
  {
    "poem_id": 1451,
    "vorder": 50,
    "position": 1,
    "text": "سه کشور سراسر بیاراستند"
  },
  {
    "poem_id": 1451,
    "vorder": 51,
    "position": 0,
    "text": "چو از دژ رها کرد کاووس را"
  },
  {
    "poem_id": 1451,
    "vorder": 52,
    "position": 1,
    "text": "همان گیو و گودرز و هم طوس را"
  },
  {
    "poem_id": 1451,
    "vorder": 53,
    "position": 0,
    "text": "سلیح سه کشور سه گنج سه شاه"
  },
  {
    "poem_id": 1451,
    "vorder": 54,
    "position": 1,
    "text": "سراپرده و لشکر و تاج و گاه"
  },
  {
    "poem_id": 1451,
    "vorder": 55,
    "position": 0,
    "text": "سپهبد جزین خواسته هرچ دید"
  },
  {
    "poem_id": 1451,
    "vorder": 56,
    "position": 1,
    "text": "بگنج سپهدار ایران کشید"
  },
  {
    "poem_id": 1451,
    "vorder": 57,
    "position": 0,
    "text": "بیاراست کاووس خورشید فر"
  },
  {
    "poem_id": 1451,
    "vorder": 58,
    "position": 1,
    "text": "بدیبای رومی یکی مهد زر"
  },
  {
    "poem_id": 1451,
    "vorder": 59,
    "position": 0,
    "text": "ز پیروزه پیکر ز یاقوت گاه"
  },
  {
    "poem_id": 1451,
    "vorder": 60,
    "position": 1,
    "text": "گهر بافته بر جلیل سیاه"
  },
  {
    "poem_id": 1451,
    "vorder": 61,
    "position": 0,
    "text": "یکی اسپ رهوار زیراندرش"
  },
  {
    "poem_id": 1451,
    "vorder": 62,
    "position": 1,
    "text": "لگامی به زر آژده بر سرش"
  },
  {
    "poem_id": 1451,
    "vorder": 63,
    "position": 0,
    "text": "همه چوب بالاش از عود تر"
  },
  {
    "poem_id": 1451,
    "vorder": 64,
    "position": 1,
    "text": "برو بافته چندگونه گهر"
  },
  {
    "poem_id": 1451,
    "vorder": 65,
    "position": 0,
    "text": "بسودابه فرمود کاندر نشین"
  },
  {
    "poem_id": 1451,
    "vorder": 66,
    "position": 1,
    "text": "نشست و به خورشید کرد آفرین"
  },
  {
    "poem_id": 1451,
    "vorder": 67,
    "position": 0,
    "text": "به لشکرگه آورد لشکر ز شهر"
  },
  {
    "poem_id": 1451,
    "vorder": 68,
    "position": 1,
    "text": "ز گیتی برین گونه جویند بهر"
  },
  {
    "poem_id": 1451,
    "vorder": 69,
    "position": 0,
    "text": "سپاهش فزون شد ز سیصدهزار"
  },
  {
    "poem_id": 1451,
    "vorder": 70,
    "position": 1,
    "text": "زره‌دار و برگستوانور سوار"
  },
  {
    "poem_id": 1451,
    "vorder": 71,
    "position": 0,
    "text": "برو انجمن شد ز بربر سوار"
  },
  {
    "poem_id": 1451,
    "vorder": 72,
    "position": 1,
    "text": "ز مصر و ز هاماوران صدهزار"
  },
  {
    "poem_id": 1451,
    "vorder": 73,
    "position": 0,
    "text": "بیامد گران لشکری بربری"
  },
  {
    "poem_id": 1451,
    "vorder": 74,
    "position": 1,
    "text": "سواران جنگ‌آور لشکری"
  }
]