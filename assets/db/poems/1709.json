[
  {
    "poem_id": 1709,
    "vorder": 1,
    "position": 0,
    "text": "بدانگه که شاه اردوان را بکشت"
  },
  {
    "poem_id": 1709,
    "vorder": 2,
    "position": 1,
    "text": "ز خون وی آورد گیتی به مشت"
  },
  {
    "poem_id": 1709,
    "vorder": 3,
    "position": 0,
    "text": "بدان فر و اورند شاه اردشیر"
  },
  {
    "poem_id": 1709,
    "vorder": 4,
    "position": 1,
    "text": "شده شادمان مرد برنا و پیر"
  },
  {
    "poem_id": 1709,
    "vorder": 5,
    "position": 0,
    "text": "که بنوشت بیدادی اردوان"
  },
  {
    "poem_id": 1709,
    "vorder": 6,
    "position": 1,
    "text": "ز داد وی آبادتر شد جهان"
  },
  {
    "poem_id": 1709,
    "vorder": 7,
    "position": 0,
    "text": "چنو کشته شد دخترش را بخواست"
  },
  {
    "poem_id": 1709,
    "vorder": 8,
    "position": 1,
    "text": "بدان تا بگوید که گنجش کجاست"
  },
  {
    "poem_id": 1709,
    "vorder": 9,
    "position": 0,
    "text": "دو فرزند او شد به هندوستان"
  },
  {
    "poem_id": 1709,
    "vorder": 10,
    "position": 1,
    "text": "به هر نیک و بد گشته همداستان"
  },
  {
    "poem_id": 1709,
    "vorder": 11,
    "position": 0,
    "text": "دو ایدر به زندان شاه اندرون"
  },
  {
    "poem_id": 1709,
    "vorder": 12,
    "position": 1,
    "text": "دو دیده پر از آب و دل پر ز خون"
  },
  {
    "poem_id": 1709,
    "vorder": 13,
    "position": 0,
    "text": "به هندوستان بود مهتر پسر"
  },
  {
    "poem_id": 1709,
    "vorder": 14,
    "position": 1,
    "text": "که بهمن بدی نام آن نامور"
  },
  {
    "poem_id": 1709,
    "vorder": 15,
    "position": 0,
    "text": "فرستاده‌ای جست با رای و هوش"
  },
  {
    "poem_id": 1709,
    "vorder": 16,
    "position": 1,
    "text": "جوانی که دارد به گفتار گوش"
  },
  {
    "poem_id": 1709,
    "vorder": 17,
    "position": 0,
    "text": "چو از پادشاهی ندید ایچ بهر"
  },
  {
    "poem_id": 1709,
    "vorder": 18,
    "position": 1,
    "text": "بدو داد ناگه یکی پاره زهر"
  },
  {
    "poem_id": 1709,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت رو پیش خواهر بگوی"
  },
  {
    "poem_id": 1709,
    "vorder": 20,
    "position": 1,
    "text": "که از دشمن این مهربانی مجوی"
  },
  {
    "poem_id": 1709,
    "vorder": 21,
    "position": 0,
    "text": "برادر دو داری به هندوستان"
  },
  {
    "poem_id": 1709,
    "vorder": 22,
    "position": 1,
    "text": "به رنج و بلا گشته همداستان"
  },
  {
    "poem_id": 1709,
    "vorder": 23,
    "position": 0,
    "text": "دو در بند و زندان شاه اردشیر"
  },
  {
    "poem_id": 1709,
    "vorder": 24,
    "position": 1,
    "text": "پدر کشته و زنده خسته به تیر"
  },
  {
    "poem_id": 1709,
    "vorder": 25,
    "position": 0,
    "text": "تو از ما گسسته بدین گونه مهر"
  },
  {
    "poem_id": 1709,
    "vorder": 26,
    "position": 1,
    "text": "پسندد چنین کردگار سپهر؟"
  },
  {
    "poem_id": 1709,
    "vorder": 27,
    "position": 0,
    "text": "چو خواهی که بانوی ایران شوی"
  },
  {
    "poem_id": 1709,
    "vorder": 28,
    "position": 1,
    "text": "به گیتی پسند دلیران شوی"
  },
  {
    "poem_id": 1709,
    "vorder": 29,
    "position": 0,
    "text": "هلاهل چنین زهر هندی بگیر"
  },
  {
    "poem_id": 1709,
    "vorder": 30,
    "position": 1,
    "text": "به کار آر یکپار بر اردشیر"
  },
  {
    "poem_id": 1709,
    "vorder": 31,
    "position": 0,
    "text": "فرستاده آمد بهنگام شام"
  },
  {
    "poem_id": 1709,
    "vorder": 32,
    "position": 1,
    "text": "به دخت گرامی بداد آن پیام"
  },
  {
    "poem_id": 1709,
    "vorder": 33,
    "position": 0,
    "text": "ورا جان و دل بر برادر بسوخت"
  },
  {
    "poem_id": 1709,
    "vorder": 34,
    "position": 1,
    "text": "به کردار آتش رخش برفروخت"
  },
  {
    "poem_id": 1709,
    "vorder": 35,
    "position": 0,
    "text": "ز اندوه بستد گرانمایه زهر"
  },
  {
    "poem_id": 1709,
    "vorder": 36,
    "position": 1,
    "text": "بدان بد که بردارد از کام بهر"
  },
  {
    "poem_id": 1709,
    "vorder": 37,
    "position": 0,
    "text": "چنان بد که یک روز شاه اردشیر"
  },
  {
    "poem_id": 1709,
    "vorder": 38,
    "position": 1,
    "text": "به نخچیر بر گور بگشاد تیر"
  },
  {
    "poem_id": 1709,
    "vorder": 39,
    "position": 0,
    "text": "چو بگذشت نیمی ز روز دراز"
  },
  {
    "poem_id": 1709,
    "vorder": 40,
    "position": 1,
    "text": "سپهبد ز نخچیرگه گشت باز"
  },
  {
    "poem_id": 1709,
    "vorder": 41,
    "position": 0,
    "text": "سوی دختر اردوان شد ز راه"
  },
  {
    "poem_id": 1709,
    "vorder": 42,
    "position": 1,
    "text": "دوان ماه چهره بشد نزد شاه"
  },
  {
    "poem_id": 1709,
    "vorder": 43,
    "position": 0,
    "text": "بیاورد جامی ز یاقوت زرد"
  },
  {
    "poem_id": 1709,
    "vorder": 44,
    "position": 1,
    "text": "پر از شکر و پست با آب سرد"
  },
  {
    "poem_id": 1709,
    "vorder": 45,
    "position": 0,
    "text": "بیامیخت با شکر و پست زهر"
  },
  {
    "poem_id": 1709,
    "vorder": 46,
    "position": 1,
    "text": "که بهمن مگر یابد از کام بهر"
  },
  {
    "poem_id": 1709,
    "vorder": 47,
    "position": 0,
    "text": "چو بگرفت شاه اردشیر آن به دست"
  },
  {
    "poem_id": 1709,
    "vorder": 48,
    "position": 1,
    "text": "ز دستش بیفتاد و بشکست پست"
  },
  {
    "poem_id": 1709,
    "vorder": 49,
    "position": 0,
    "text": "شد آن پادشا بچه لرزان ز بیم"
  },
  {
    "poem_id": 1709,
    "vorder": 50,
    "position": 1,
    "text": "هم‌اندر زمان شد دلش به دو نیم"
  },
  {
    "poem_id": 1709,
    "vorder": 51,
    "position": 0,
    "text": "جهاندار زان لرزه شد بدگمان"
  },
  {
    "poem_id": 1709,
    "vorder": 52,
    "position": 1,
    "text": "پراندیشه از گردش آسمان"
  },
  {
    "poem_id": 1709,
    "vorder": 53,
    "position": 0,
    "text": "بفرمود تا خانگی مرغ چار"
  },
  {
    "poem_id": 1709,
    "vorder": 54,
    "position": 1,
    "text": "پرستنده آرد بر شهریار"
  },
  {
    "poem_id": 1709,
    "vorder": 55,
    "position": 0,
    "text": "چو آن مرغ بر پست بگذاشتند"
  },
  {
    "poem_id": 1709,
    "vorder": 56,
    "position": 1,
    "text": "گمانی همی خیره پنداشتند"
  },
  {
    "poem_id": 1709,
    "vorder": 57,
    "position": 0,
    "text": "هم‌انگاه مرغ آن بخورد و بمرد"
  },
  {
    "poem_id": 1709,
    "vorder": 58,
    "position": 1,
    "text": "گمان بردن از راه نیکی ببرد"
  },
  {
    "poem_id": 1709,
    "vorder": 59,
    "position": 0,
    "text": "بفرمود تا موبد و کدخدای"
  },
  {
    "poem_id": 1709,
    "vorder": 60,
    "position": 1,
    "text": "بیامد بر خسرو پاک‌رای"
  },
  {
    "poem_id": 1709,
    "vorder": 61,
    "position": 0,
    "text": "ز دستور ایران بپرسید شاه"
  },
  {
    "poem_id": 1709,
    "vorder": 62,
    "position": 1,
    "text": "که بدخواه را برنشانی به گاه"
  },
  {
    "poem_id": 1709,
    "vorder": 63,
    "position": 0,
    "text": "شود در نوازش بران‌گونه مست"
  },
  {
    "poem_id": 1709,
    "vorder": 64,
    "position": 1,
    "text": "که بیهوده یازد به جان تو دست"
  },
  {
    "poem_id": 1709,
    "vorder": 65,
    "position": 0,
    "text": "چه بادافره‌ست این برآورده را"
  },
  {
    "poem_id": 1709,
    "vorder": 66,
    "position": 1,
    "text": "چه سازیم درمان خودکرده را"
  },
  {
    "poem_id": 1709,
    "vorder": 67,
    "position": 0,
    "text": "چنین داد پاسخ که مهترپرست"
  },
  {
    "poem_id": 1709,
    "vorder": 68,
    "position": 1,
    "text": "چو یازد بجان جهاندار دست"
  },
  {
    "poem_id": 1709,
    "vorder": 69,
    "position": 0,
    "text": "سرش بر گنه بر بباید برید"
  },
  {
    "poem_id": 1709,
    "vorder": 70,
    "position": 1,
    "text": "کسی پند گوید نباید شنید"
  },
  {
    "poem_id": 1709,
    "vorder": 71,
    "position": 0,
    "text": "بفرمود کز دختر اردوان"
  },
  {
    "poem_id": 1709,
    "vorder": 72,
    "position": 1,
    "text": "چنان کن که هرگز نبیند روان"
  },
  {
    "poem_id": 1709,
    "vorder": 73,
    "position": 0,
    "text": "بشد موبد وپیش او دخت شاه"
  },
  {
    "poem_id": 1709,
    "vorder": 74,
    "position": 1,
    "text": "همی رفت لرزان و دل پرگناه"
  },
  {
    "poem_id": 1709,
    "vorder": 75,
    "position": 0,
    "text": "به موبد چنین گفت کای پرخرد"
  },
  {
    "poem_id": 1709,
    "vorder": 76,
    "position": 1,
    "text": "مرا و ترا روز هم بگذرد"
  },
  {
    "poem_id": 1709,
    "vorder": 77,
    "position": 0,
    "text": "اگر کشت خواهی مرا ناگزیر"
  },
  {
    "poem_id": 1709,
    "vorder": 78,
    "position": 1,
    "text": "یکی کودکی دارم از اردشیر"
  },
  {
    "poem_id": 1709,
    "vorder": 79,
    "position": 0,
    "text": "اگر من سزایم به خون ریختن"
  },
  {
    "poem_id": 1709,
    "vorder": 80,
    "position": 1,
    "text": "ز دار بلند اندر آویختن"
  },
  {
    "poem_id": 1709,
    "vorder": 81,
    "position": 0,
    "text": "چو این گردد از پاک مادر جدا"
  },
  {
    "poem_id": 1709,
    "vorder": 82,
    "position": 1,
    "text": "بکن هرچ فرمان دهد پادشا"
  },
  {
    "poem_id": 1709,
    "vorder": 83,
    "position": 0,
    "text": "ز ره باز شد موبد تیزویر"
  },
  {
    "poem_id": 1709,
    "vorder": 84,
    "position": 1,
    "text": "بگفت آنچ بشنید با اردشیر"
  },
  {
    "poem_id": 1709,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت زو نیز مشنو سخن"
  },
  {
    "poem_id": 1709,
    "vorder": 86,
    "position": 1,
    "text": "کمند آر و بادافره او بکن"
  }
]