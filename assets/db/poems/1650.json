[
  {
    "poem_id": 1650,
    "vorder": 1,
    "position": 0,
    "text": "فرستاده برگشت زان مرز و بوم"
  },
  {
    "poem_id": 1650,
    "vorder": 2,
    "position": 1,
    "text": "بیامد به نزدیک پیران روم"
  },
  {
    "poem_id": 1650,
    "vorder": 3,
    "position": 0,
    "text": "چو آن موبدان پاسخ شهریار"
  },
  {
    "poem_id": 1650,
    "vorder": 4,
    "position": 1,
    "text": "بدیدند با رنج دیده سوار"
  },
  {
    "poem_id": 1650,
    "vorder": 5,
    "position": 0,
    "text": "از ایوان به نزدیک شاه آمدند"
  },
  {
    "poem_id": 1650,
    "vorder": 6,
    "position": 1,
    "text": "بران نامور بارگاه آمدند"
  },
  {
    "poem_id": 1650,
    "vorder": 7,
    "position": 0,
    "text": "سپهدار هندوستان شاد شد"
  },
  {
    "poem_id": 1650,
    "vorder": 8,
    "position": 1,
    "text": "که از رنج اسکندر آزاد شد"
  },
  {
    "poem_id": 1650,
    "vorder": 9,
    "position": 0,
    "text": "بروبر بخواندند پس نامه را"
  },
  {
    "poem_id": 1650,
    "vorder": 10,
    "position": 1,
    "text": "چو پیغام آن شاه خودکامه را"
  },
  {
    "poem_id": 1650,
    "vorder": 11,
    "position": 0,
    "text": "گزین کرد پیران صد از هندوان"
  },
  {
    "poem_id": 1650,
    "vorder": 12,
    "position": 1,
    "text": "خردمند و گویا و روشن‌روان"
  },
  {
    "poem_id": 1650,
    "vorder": 13,
    "position": 0,
    "text": "در گنج بی‌رنج بگشاد شاه"
  },
  {
    "poem_id": 1650,
    "vorder": 14,
    "position": 1,
    "text": "گزین کرد ازان یاره و تاج و گاه"
  },
  {
    "poem_id": 1650,
    "vorder": 15,
    "position": 0,
    "text": "همان گوهر و جامهٔ نابرید"
  },
  {
    "poem_id": 1650,
    "vorder": 16,
    "position": 1,
    "text": "ز چیزی که شایسته‌تر برگزید"
  },
  {
    "poem_id": 1650,
    "vorder": 17,
    "position": 0,
    "text": "ببردند سیصد شتروار بار"
  },
  {
    "poem_id": 1650,
    "vorder": 18,
    "position": 1,
    "text": "همان جامه و گوهر شاهوار"
  },
  {
    "poem_id": 1650,
    "vorder": 19,
    "position": 0,
    "text": "صد اشتر همه بار دینار بود"
  },
  {
    "poem_id": 1650,
    "vorder": 20,
    "position": 1,
    "text": "صد اشتر ز گنج درم بار بود"
  },
  {
    "poem_id": 1650,
    "vorder": 21,
    "position": 0,
    "text": "یکی مهد پرمایه از عود تر"
  },
  {
    "poem_id": 1650,
    "vorder": 22,
    "position": 1,
    "text": "برو بافته زر و چندی گهر"
  },
  {
    "poem_id": 1650,
    "vorder": 23,
    "position": 0,
    "text": "به ده پیل بر تخت زرین نهاد"
  },
  {
    "poem_id": 1650,
    "vorder": 24,
    "position": 1,
    "text": "به پیلی گرانمایه‌تر زین نهاد"
  },
  {
    "poem_id": 1650,
    "vorder": 25,
    "position": 0,
    "text": "فغستان ببارید خونین سرشک"
  },
  {
    "poem_id": 1650,
    "vorder": 26,
    "position": 1,
    "text": "همی رفت با فیلسوف و پزشک"
  },
  {
    "poem_id": 1650,
    "vorder": 27,
    "position": 0,
    "text": "قدح هم چنان نامداری به دست"
  },
  {
    "poem_id": 1650,
    "vorder": 28,
    "position": 1,
    "text": "همه سرکشان از می جام مست"
  },
  {
    "poem_id": 1650,
    "vorder": 29,
    "position": 0,
    "text": "فغستان چو آمد به مشکوی شاه"
  },
  {
    "poem_id": 1650,
    "vorder": 30,
    "position": 1,
    "text": "یکی تاج بر سر ز مشک سیاه"
  },
  {
    "poem_id": 1650,
    "vorder": 31,
    "position": 0,
    "text": "بسان گل زرد بر ارغوان"
  },
  {
    "poem_id": 1650,
    "vorder": 32,
    "position": 1,
    "text": "ز دیدار او شاد شد ناتوان"
  },
  {
    "poem_id": 1650,
    "vorder": 33,
    "position": 0,
    "text": "چو سرو سهی بر سرش گرد ماه"
  },
  {
    "poem_id": 1650,
    "vorder": 34,
    "position": 1,
    "text": "نشایست کردن به مه بر نگاه"
  },
  {
    "poem_id": 1650,
    "vorder": 35,
    "position": 0,
    "text": "دو ابرو کمان و دو نرگس دژم"
  },
  {
    "poem_id": 1650,
    "vorder": 36,
    "position": 1,
    "text": "سر زلف را تاب داده به خم"
  },
  {
    "poem_id": 1650,
    "vorder": 37,
    "position": 0,
    "text": "دو چشمش چو دو نرگس اندر بهشت"
  },
  {
    "poem_id": 1650,
    "vorder": 38,
    "position": 1,
    "text": "تو گفتی که از ناز دارد سرشت"
  },
  {
    "poem_id": 1650,
    "vorder": 39,
    "position": 0,
    "text": "سکندر نگه کرد بالای اوی"
  },
  {
    "poem_id": 1650,
    "vorder": 40,
    "position": 1,
    "text": "همان موی و روی و سر و پای اوی"
  },
  {
    "poem_id": 1650,
    "vorder": 41,
    "position": 0,
    "text": "همی گفت کاینت چراغ جهان"
  },
  {
    "poem_id": 1650,
    "vorder": 42,
    "position": 1,
    "text": "همی آفرین خواند اندر نهان"
  },
  {
    "poem_id": 1650,
    "vorder": 43,
    "position": 0,
    "text": "بدان دادگر کو سپهر آفرید"
  },
  {
    "poem_id": 1650,
    "vorder": 44,
    "position": 1,
    "text": "بران گونه بالا و چهر آفرید"
  },
  {
    "poem_id": 1650,
    "vorder": 45,
    "position": 0,
    "text": "بفرمود تا هرک بخرد بدند"
  },
  {
    "poem_id": 1650,
    "vorder": 46,
    "position": 1,
    "text": "بران لشکر روم موبد بدند"
  },
  {
    "poem_id": 1650,
    "vorder": 47,
    "position": 0,
    "text": "نشستند و او را به آیین بخواست"
  },
  {
    "poem_id": 1650,
    "vorder": 48,
    "position": 1,
    "text": "به رسم مسیحا و پیوند راست"
  },
  {
    "poem_id": 1650,
    "vorder": 49,
    "position": 0,
    "text": "برو ریخت دینار چندان ز گنج"
  },
  {
    "poem_id": 1650,
    "vorder": 50,
    "position": 1,
    "text": "که شد ماه را راه رفتن به رنج"
  }
]