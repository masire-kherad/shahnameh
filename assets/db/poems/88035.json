[
  {
    "poem_id": 88035,
    "vorder": 1,
    "position": 0,
    "text": "دبیر خردمند را پیش خواند"
  },
  {
    "poem_id": 88035,
    "vorder": 2,
    "position": 1,
    "text": "سخنهای بایسته با او براند"
  },
  {
    "poem_id": 88035,
    "vorder": 3,
    "position": 0,
    "text": "چو آن نامه را زود پاسخ نوشت"
  },
  {
    "poem_id": 88035,
    "vorder": 4,
    "position": 1,
    "text": "پدید آورید اندر او خوب و زشت"
  },
  {
    "poem_id": 88035,
    "vorder": 5,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 88035,
    "vorder": 6,
    "position": 1,
    "text": "کز او دید نیک و بد روزگار"
  },
  {
    "poem_id": 88035,
    "vorder": 7,
    "position": 0,
    "text": "دگر آفرین کرد بر پهلوان"
  },
  {
    "poem_id": 88035,
    "vorder": 8,
    "position": 1,
    "text": "که جاوید بادی و روشن‌روان"
  },
  {
    "poem_id": 88035,
    "vorder": 9,
    "position": 0,
    "text": "خجسته سپهدار بسیار هوش"
  },
  {
    "poem_id": 88035,
    "vorder": 10,
    "position": 1,
    "text": "همه رای و دانش همه جنگ و جوش"
  },
  {
    "poem_id": 88035,
    "vorder": 11,
    "position": 0,
    "text": "خداوند گوپال و تیغ بنفش"
  },
  {
    "poem_id": 88035,
    "vorder": 12,
    "position": 1,
    "text": "فروزندهٔ کاویانی درفش"
  },
  {
    "poem_id": 88035,
    "vorder": 13,
    "position": 0,
    "text": "سپاس از جهاندار یزدان ما"
  },
  {
    "poem_id": 88035,
    "vorder": 14,
    "position": 1,
    "text": "که پیروز بودند گردان ما"
  },
  {
    "poem_id": 88035,
    "vorder": 15,
    "position": 0,
    "text": "از اختر ترا روشنایی نمود"
  },
  {
    "poem_id": 88035,
    "vorder": 16,
    "position": 1,
    "text": "ز دشمن برآورد ناگاه دود"
  },
  {
    "poem_id": 88035,
    "vorder": 17,
    "position": 0,
    "text": "نخست آنک گفتی که مر گیو را"
  },
  {
    "poem_id": 88035,
    "vorder": 18,
    "position": 1,
    "text": "بزرگان فرزانه و نیو را"
  },
  {
    "poem_id": 88035,
    "vorder": 19,
    "position": 0,
    "text": "به نزدیک پیران فرستاده‌ام"
  },
  {
    "poem_id": 88035,
    "vorder": 20,
    "position": 1,
    "text": "چه مایه ورا پندها داده‌ام"
  },
  {
    "poem_id": 88035,
    "vorder": 21,
    "position": 0,
    "text": "نپذرفت از آن پس خود او پند من"
  },
  {
    "poem_id": 88035,
    "vorder": 22,
    "position": 1,
    "text": "نجست اندر این کار پیوند من"
  },
  {
    "poem_id": 88035,
    "vorder": 23,
    "position": 0,
    "text": "سپهبد یکی داستان زد بر این"
  },
  {
    "poem_id": 88035,
    "vorder": 24,
    "position": 1,
    "text": "چو دستور پیشین برآورد کین"
  },
  {
    "poem_id": 88035,
    "vorder": 25,
    "position": 0,
    "text": "که هر مهتری کو روان کاستست"
  },
  {
    "poem_id": 88035,
    "vorder": 26,
    "position": 1,
    "text": "ز نیکی به بخت بد آراستست"
  },
  {
    "poem_id": 88035,
    "vorder": 27,
    "position": 0,
    "text": "مرا زان سخن پیش بود آگهی"
  },
  {
    "poem_id": 88035,
    "vorder": 28,
    "position": 1,
    "text": "که پیران دل از کین نخواهد تهی"
  },
  {
    "poem_id": 88035,
    "vorder": 29,
    "position": 0,
    "text": "ولیکن از آن خوب کردار او"
  },
  {
    "poem_id": 88035,
    "vorder": 30,
    "position": 1,
    "text": "نجستم همی ژرف پیکار او"
  },
  {
    "poem_id": 88035,
    "vorder": 31,
    "position": 0,
    "text": "کنون آشکارا نمود این سپهر"
  },
  {
    "poem_id": 88035,
    "vorder": 32,
    "position": 1,
    "text": "که پیران به توران گراید به مهر"
  },
  {
    "poem_id": 88035,
    "vorder": 33,
    "position": 0,
    "text": "کنون چون نبیند جز افراسیاب"
  },
  {
    "poem_id": 88035,
    "vorder": 34,
    "position": 1,
    "text": "دلش را تو از مهر او برمتاب"
  },
  {
    "poem_id": 88035,
    "vorder": 35,
    "position": 0,
    "text": "گر او بر خرد برگزیند هوا"
  },
  {
    "poem_id": 88035,
    "vorder": 36,
    "position": 1,
    "text": "به کوشش نروید ز خارا گیا"
  },
  {
    "poem_id": 88035,
    "vorder": 37,
    "position": 0,
    "text": "تو با دشمن ار خوب گویی رواست"
  },
  {
    "poem_id": 88035,
    "vorder": 38,
    "position": 1,
    "text": "از آزادگان خوب گفتن سزاست"
  },
  {
    "poem_id": 88035,
    "vorder": 39,
    "position": 0,
    "text": "و دیگر ز پیکار جنگ‌آوران"
  },
  {
    "poem_id": 88035,
    "vorder": 40,
    "position": 1,
    "text": "کجا یاد کردی به گرز گران"
  },
  {
    "poem_id": 88035,
    "vorder": 41,
    "position": 0,
    "text": "ز نیک‌اختر و گردش هور و ماه"
  },
  {
    "poem_id": 88035,
    "vorder": 42,
    "position": 1,
    "text": "ز کوشش نمودن بر آن رزمگاه"
  },
  {
    "poem_id": 88035,
    "vorder": 43,
    "position": 0,
    "text": "مرا این درست است کز کارکرد"
  },
  {
    "poem_id": 88035,
    "vorder": 44,
    "position": 1,
    "text": "تو پیروز باشی به روز نبرد"
  },
  {
    "poem_id": 88035,
    "vorder": 45,
    "position": 0,
    "text": "نبیره کجا چون تو دارد نیا"
  },
  {
    "poem_id": 88035,
    "vorder": 46,
    "position": 1,
    "text": "به جنگ اندرون باشدش کیمیا"
  },
  {
    "poem_id": 88035,
    "vorder": 47,
    "position": 0,
    "text": "ز شیران چه زاید مگر نره شیر"
  },
  {
    "poem_id": 88035,
    "vorder": 48,
    "position": 1,
    "text": "چنان چون بود نامدار و دلیر"
  },
  {
    "poem_id": 88035,
    "vorder": 49,
    "position": 0,
    "text": "به بیداد بر نیست این کار تو"
  },
  {
    "poem_id": 88035,
    "vorder": 50,
    "position": 1,
    "text": "بسنده است یزدان نگهدار تو"
  },
  {
    "poem_id": 88035,
    "vorder": 51,
    "position": 0,
    "text": "تو زور و دلیری ز یزدان شناس"
  },
  {
    "poem_id": 88035,
    "vorder": 52,
    "position": 1,
    "text": "از او دار تا زنده باشی سپاس"
  },
  {
    "poem_id": 88035,
    "vorder": 53,
    "position": 0,
    "text": "سه دیگر که گفتی که افراسیاب"
  },
  {
    "poem_id": 88035,
    "vorder": 54,
    "position": 1,
    "text": "سپه را همی بگذارند ز آب"
  },
  {
    "poem_id": 88035,
    "vorder": 55,
    "position": 0,
    "text": "ز پیران فرستاده شد نزد اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 56,
    "position": 1,
    "text": "سپاهش به ایران نهادست روی"
  },
  {
    "poem_id": 88035,
    "vorder": 57,
    "position": 0,
    "text": "همان است یکسر که گفتی سخن"
  },
  {
    "poem_id": 88035,
    "vorder": 58,
    "position": 1,
    "text": "کنون باز پاسخ فگندیم بن"
  },
  {
    "poem_id": 88035,
    "vorder": 59,
    "position": 0,
    "text": "بدان ای پر اندیشه سالار من"
  },
  {
    "poem_id": 88035,
    "vorder": 60,
    "position": 1,
    "text": "به هر کار شایستهٔ کار من"
  },
  {
    "poem_id": 88035,
    "vorder": 61,
    "position": 0,
    "text": "که او بر لب رود جیحون درنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 62,
    "position": 1,
    "text": "نه زان کرد کآید بر ما به جنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 63,
    "position": 0,
    "text": "که خاقان بر او لشکر آرد ز چین"
  },
  {
    "poem_id": 88035,
    "vorder": 64,
    "position": 1,
    "text": "فراز آمدش از دو رویه کمین"
  },
  {
    "poem_id": 88035,
    "vorder": 65,
    "position": 0,
    "text": "و دیگر که از لشکران گران"
  },
  {
    "poem_id": 88035,
    "vorder": 66,
    "position": 1,
    "text": "پراگنده بر گرد توران سران"
  },
  {
    "poem_id": 88035,
    "vorder": 67,
    "position": 0,
    "text": "بدو دشمن آمد ز هر سو پدید"
  },
  {
    "poem_id": 88035,
    "vorder": 68,
    "position": 1,
    "text": "از آن بر لب رود جیحون کشید"
  },
  {
    "poem_id": 88035,
    "vorder": 69,
    "position": 0,
    "text": "به پنجم سخن که آگهی خواستی"
  },
  {
    "poem_id": 88035,
    "vorder": 70,
    "position": 1,
    "text": "به مهر گوان دل بیاراستی"
  },
  {
    "poem_id": 88035,
    "vorder": 71,
    "position": 0,
    "text": "چو لهراسب و چون اشکش تیزچنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 72,
    "position": 1,
    "text": "چو رستم سپهبد دمنده نهنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 73,
    "position": 0,
    "text": "بدان ای سپهدار و آگاه باش"
  },
  {
    "poem_id": 88035,
    "vorder": 74,
    "position": 1,
    "text": "به هر کار با بخت همراه باش"
  },
  {
    "poem_id": 88035,
    "vorder": 75,
    "position": 0,
    "text": "کزان سو که شد رستم شیرمرد"
  },
  {
    "poem_id": 88035,
    "vorder": 76,
    "position": 1,
    "text": "ز کشمیر و کابل برآورد گرد"
  },
  {
    "poem_id": 88035,
    "vorder": 77,
    "position": 0,
    "text": "وز آن سو که شد اشکش تیزهوش"
  },
  {
    "poem_id": 88035,
    "vorder": 78,
    "position": 1,
    "text": "برآمد ز خوارزم یکسر خروش"
  },
  {
    "poem_id": 88035,
    "vorder": 79,
    "position": 0,
    "text": "به رزم اندرون شیده برگشت از اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 80,
    "position": 1,
    "text": "سوی شهر گرگان نهادست روی"
  },
  {
    "poem_id": 88035,
    "vorder": 81,
    "position": 0,
    "text": "وز آن سو که لهراسب شد با سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 82,
    "position": 1,
    "text": "همه مهتران برگشادند راه"
  },
  {
    "poem_id": 88035,
    "vorder": 83,
    "position": 0,
    "text": "الانان و غز گشت پرداخته"
  },
  {
    "poem_id": 88035,
    "vorder": 84,
    "position": 1,
    "text": "شد آن پادشاهی همه ساخته"
  },
  {
    "poem_id": 88035,
    "vorder": 85,
    "position": 0,
    "text": "گر افراسیاب اندر آید به راه"
  },
  {
    "poem_id": 88035,
    "vorder": 86,
    "position": 1,
    "text": "ز جیحون بدین سو گذارد سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 87,
    "position": 0,
    "text": "بگیرند گردان پس پشت اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 88,
    "position": 1,
    "text": "نماند به جز باد در مشت اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 89,
    "position": 0,
    "text": "تو بشناس کو شهر آباد خویش"
  },
  {
    "poem_id": 88035,
    "vorder": 90,
    "position": 1,
    "text": "بر و بوم و فرخنده بنیاد خویش"
  },
  {
    "poem_id": 88035,
    "vorder": 91,
    "position": 0,
    "text": "به گفتار پیران نماند بجای"
  },
  {
    "poem_id": 88035,
    "vorder": 92,
    "position": 1,
    "text": "به دشمن سپارد نهد پیش پای"
  },
  {
    "poem_id": 88035,
    "vorder": 93,
    "position": 0,
    "text": "نجنباند او داستان را دو لب"
  },
  {
    "poem_id": 88035,
    "vorder": 94,
    "position": 1,
    "text": "که ناید خبر زو به من روز و شب"
  },
  {
    "poem_id": 88035,
    "vorder": 95,
    "position": 0,
    "text": "بدان روز هرگز مبادا درود"
  },
  {
    "poem_id": 88035,
    "vorder": 96,
    "position": 1,
    "text": "که او بگذراند سپه را ز رود"
  },
  {
    "poem_id": 88035,
    "vorder": 97,
    "position": 0,
    "text": "به ما برکند پیشدستی به جنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 98,
    "position": 1,
    "text": "نبیند کس این روز تاریک و تنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 99,
    "position": 0,
    "text": "بفرمایم اکنون که بر پیل کوس"
  },
  {
    "poem_id": 88035,
    "vorder": 100,
    "position": 1,
    "text": "ببندد دمنده سپهدار طوس"
  },
  {
    "poem_id": 88035,
    "vorder": 101,
    "position": 0,
    "text": "دهستان و گرگان و آن بوم و بر"
  },
  {
    "poem_id": 88035,
    "vorder": 102,
    "position": 1,
    "text": "بگیرد برآرد به خورشید سر"
  },
  {
    "poem_id": 88035,
    "vorder": 103,
    "position": 0,
    "text": "من اندر پی طوس با پیل و گاه"
  },
  {
    "poem_id": 88035,
    "vorder": 104,
    "position": 1,
    "text": "به یاری بیایم به پشت سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 105,
    "position": 0,
    "text": "تو از جنگ پیران مبرتاب روی"
  },
  {
    "poem_id": 88035,
    "vorder": 106,
    "position": 1,
    "text": "سپه را بیارای و زو کینه‌جوی"
  },
  {
    "poem_id": 88035,
    "vorder": 107,
    "position": 0,
    "text": "چو هومان و نستیهن از پشت اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 108,
    "position": 1,
    "text": "جدا ماند شد باد در مشت اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 109,
    "position": 0,
    "text": "گر از نامداران ایران نبرد"
  },
  {
    "poem_id": 88035,
    "vorder": 110,
    "position": 1,
    "text": "بخواهد بفرما وز آن برمگرد"
  },
  {
    "poem_id": 88035,
    "vorder": 111,
    "position": 0,
    "text": "چو پیران نبرد تو جوید دلیر"
  },
  {
    "poem_id": 88035,
    "vorder": 112,
    "position": 1,
    "text": "مکن بددلی پیش او شو چو شیر"
  },
  {
    "poem_id": 88035,
    "vorder": 113,
    "position": 0,
    "text": "به پیکار مندیش ز افراسیاب"
  },
  {
    "poem_id": 88035,
    "vorder": 114,
    "position": 1,
    "text": "به جای آر دل روی از او برمتاب"
  },
  {
    "poem_id": 88035,
    "vorder": 115,
    "position": 0,
    "text": "چو آید به جنگ اندرون جنگجوی"
  },
  {
    "poem_id": 88035,
    "vorder": 116,
    "position": 1,
    "text": "نباید که برتابی از جنگ روی"
  },
  {
    "poem_id": 88035,
    "vorder": 117,
    "position": 0,
    "text": "بر ایشان تو پیروز باشی بجنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 118,
    "position": 1,
    "text": "نگر دل نداری بدین کار تنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 119,
    "position": 0,
    "text": "چنین دارم اومید از کردگار"
  },
  {
    "poem_id": 88035,
    "vorder": 120,
    "position": 1,
    "text": "که پیروز باشی تو در کارزار"
  },
  {
    "poem_id": 88035,
    "vorder": 121,
    "position": 0,
    "text": "همیدون گمانم که چون من ز راه"
  },
  {
    "poem_id": 88035,
    "vorder": 122,
    "position": 1,
    "text": "به پشت سپاه اندر آرم سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 123,
    "position": 0,
    "text": "بر ایشان شما رانده باشید کام"
  },
  {
    "poem_id": 88035,
    "vorder": 124,
    "position": 1,
    "text": "به خورشید تابان برآورده نام"
  },
  {
    "poem_id": 88035,
    "vorder": 125,
    "position": 0,
    "text": "ز کاوس وز طوس نزد سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 126,
    "position": 1,
    "text": "درود فراوان فرستاد شاه"
  },
  {
    "poem_id": 88035,
    "vorder": 127,
    "position": 0,
    "text": "بر آن نامه بنهاد خسرو نگین"
  },
  {
    "poem_id": 88035,
    "vorder": 128,
    "position": 1,
    "text": "فرستاده را داد و کرد آفرین"
  },
  {
    "poem_id": 88035,
    "vorder": 129,
    "position": 0,
    "text": "چو از پیش خسرو برون شد هجیر"
  },
  {
    "poem_id": 88035,
    "vorder": 130,
    "position": 1,
    "text": "سپهبد همی رای زد با وزیر"
  },
  {
    "poem_id": 88035,
    "vorder": 131,
    "position": 0,
    "text": "ز بس مهربانی که بد بر سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 132,
    "position": 1,
    "text": "سراسر همه رزم بد رای شاه"
  },
  {
    "poem_id": 88035,
    "vorder": 133,
    "position": 0,
    "text": "همی گفت اگر لشکر افراسیاب"
  },
  {
    "poem_id": 88035,
    "vorder": 134,
    "position": 1,
    "text": "بجنباند از جای و بگذارد آب"
  },
  {
    "poem_id": 88035,
    "vorder": 135,
    "position": 0,
    "text": "سپاه مرا بگسلاند ز جای"
  },
  {
    "poem_id": 88035,
    "vorder": 136,
    "position": 1,
    "text": "مرا رفت باید همینست رای"
  },
  {
    "poem_id": 88035,
    "vorder": 137,
    "position": 0,
    "text": "همانگه شه نوذران را بخواند"
  },
  {
    "poem_id": 88035,
    "vorder": 138,
    "position": 1,
    "text": "بفرمود تا تیز لشکر براند"
  },
  {
    "poem_id": 88035,
    "vorder": 139,
    "position": 0,
    "text": "به سوی دهستان سپه برکشید"
  },
  {
    "poem_id": 88035,
    "vorder": 140,
    "position": 1,
    "text": "همه دشت خوارزم لشکر کشید"
  },
  {
    "poem_id": 88035,
    "vorder": 141,
    "position": 0,
    "text": "نگهبان لشکر بود روز جنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 142,
    "position": 1,
    "text": "به جنگ اندر آید به سان پلنگ"
  },
  {
    "poem_id": 88035,
    "vorder": 143,
    "position": 0,
    "text": "تبیره برآمد ز درگاه طوس"
  },
  {
    "poem_id": 88035,
    "vorder": 144,
    "position": 1,
    "text": "خروشیدن نای رویین و کوس"
  },
  {
    "poem_id": 88035,
    "vorder": 145,
    "position": 0,
    "text": "سپاه و سپهبد برفتن گرفت"
  },
  {
    "poem_id": 88035,
    "vorder": 146,
    "position": 1,
    "text": "زمین سم اسبان نهفتن گرفت"
  },
  {
    "poem_id": 88035,
    "vorder": 147,
    "position": 0,
    "text": "تو گفتی که خورشید تابان به جای"
  },
  {
    "poem_id": 88035,
    "vorder": 148,
    "position": 1,
    "text": "بماند از نهیب سواران به پای"
  },
  {
    "poem_id": 88035,
    "vorder": 149,
    "position": 0,
    "text": "دو هفته همی رفت ز آن سان سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 150,
    "position": 1,
    "text": "بشد روشنایی ز خورشید و ماه"
  },
  {
    "poem_id": 88035,
    "vorder": 151,
    "position": 0,
    "text": "پراگنده بر گرد کشور خبر"
  },
  {
    "poem_id": 88035,
    "vorder": 152,
    "position": 1,
    "text": "ز جنبیدن شاه پیروزگر"
  },
  {
    "poem_id": 88035,
    "vorder": 153,
    "position": 0,
    "text": "چو طوس از در شاه ایران برفت"
  },
  {
    "poem_id": 88035,
    "vorder": 154,
    "position": 1,
    "text": "سبک شاه رفتن بسیچید تفت"
  },
  {
    "poem_id": 88035,
    "vorder": 155,
    "position": 0,
    "text": "ابا ده هزار از گزیده سران"
  },
  {
    "poem_id": 88035,
    "vorder": 156,
    "position": 1,
    "text": "همه نامداران و کنداوران"
  },
  {
    "poem_id": 88035,
    "vorder": 157,
    "position": 0,
    "text": "به نزدیک گودرز بنهاد روی"
  },
  {
    "poem_id": 88035,
    "vorder": 158,
    "position": 1,
    "text": "ابا نامداران پرخاشجوی"
  },
  {
    "poem_id": 88035,
    "vorder": 159,
    "position": 0,
    "text": "ابا پیل و با کوس و با فرهی"
  },
  {
    "poem_id": 88035,
    "vorder": 160,
    "position": 1,
    "text": "ابا تخت و با تاج شاهنشهی"
  },
  {
    "poem_id": 88035,
    "vorder": 161,
    "position": 0,
    "text": "هجیر آمد از پیش خسرو دمان"
  },
  {
    "poem_id": 88035,
    "vorder": 162,
    "position": 1,
    "text": "گرازان و خندان و دل شادمان"
  },
  {
    "poem_id": 88035,
    "vorder": 163,
    "position": 0,
    "text": "ابا خلعت و خوبی و خرمی"
  },
  {
    "poem_id": 88035,
    "vorder": 164,
    "position": 1,
    "text": "تو گفتی همی برنوردد زمی"
  },
  {
    "poem_id": 88035,
    "vorder": 165,
    "position": 0,
    "text": "چو آمد به نزدیک پرده‌سرای"
  },
  {
    "poem_id": 88035,
    "vorder": 166,
    "position": 1,
    "text": "برآمد خروشیدن کرنای"
  },
  {
    "poem_id": 88035,
    "vorder": 167,
    "position": 0,
    "text": "پذیره شدندش سران سر به سر"
  },
  {
    "poem_id": 88035,
    "vorder": 168,
    "position": 1,
    "text": "زمین پر ز آهن هوا پر ز زر"
  },
  {
    "poem_id": 88035,
    "vorder": 169,
    "position": 0,
    "text": "چو خیزد به چرخ اندرون داوری"
  },
  {
    "poem_id": 88035,
    "vorder": 170,
    "position": 1,
    "text": "ز ماه و ز ناهید وز مشتری"
  },
  {
    "poem_id": 88035,
    "vorder": 171,
    "position": 0,
    "text": "بیاراست لشکر چو چشم خروس"
  },
  {
    "poem_id": 88035,
    "vorder": 172,
    "position": 1,
    "text": "ابا زنگ زرین و پیلان و کوس"
  },
  {
    "poem_id": 88035,
    "vorder": 173,
    "position": 0,
    "text": "چو آمد بر نامور پهلوان"
  },
  {
    "poem_id": 88035,
    "vorder": 174,
    "position": 1,
    "text": "بگفت آنچ دید از شه خسروان"
  },
  {
    "poem_id": 88035,
    "vorder": 175,
    "position": 0,
    "text": "نوازیدن شاه و پیوند اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 176,
    "position": 1,
    "text": "همی گفت از رادی و پند اوی"
  },
  {
    "poem_id": 88035,
    "vorder": 177,
    "position": 0,
    "text": "که چون بر سپه گستریده است مهر"
  },
  {
    "poem_id": 88035,
    "vorder": 178,
    "position": 1,
    "text": "چگونه ز پیغام بگشاد چهر"
  },
  {
    "poem_id": 88035,
    "vorder": 179,
    "position": 0,
    "text": "پس آن نامهٔ شهریار جهان"
  },
  {
    "poem_id": 88035,
    "vorder": 180,
    "position": 1,
    "text": "به گودرز داد و درود مهان"
  },
  {
    "poem_id": 88035,
    "vorder": 181,
    "position": 0,
    "text": "نوازیدن شاه بشنید ازوی"
  },
  {
    "poem_id": 88035,
    "vorder": 182,
    "position": 1,
    "text": "بمالید بر نامه بر چشم و روی"
  },
  {
    "poem_id": 88035,
    "vorder": 183,
    "position": 0,
    "text": "چو بگشاد مهرش به خواننده داد"
  },
  {
    "poem_id": 88035,
    "vorder": 184,
    "position": 1,
    "text": "سخنها بر او کرد خواننده یاد"
  },
  {
    "poem_id": 88035,
    "vorder": 185,
    "position": 0,
    "text": "سپهدار بر شاه کرد آفرین"
  },
  {
    "poem_id": 88035,
    "vorder": 186,
    "position": 1,
    "text": "به فرمان ببوسید روی زمین"
  },
  {
    "poem_id": 88035,
    "vorder": 187,
    "position": 0,
    "text": "ببود آن شب و رای زد با پسر"
  },
  {
    "poem_id": 88035,
    "vorder": 188,
    "position": 1,
    "text": "به شبگیر بنشست و بگشاد در"
  },
  {
    "poem_id": 88035,
    "vorder": 189,
    "position": 0,
    "text": "همه نامداران لشگر پگاه"
  },
  {
    "poem_id": 88035,
    "vorder": 190,
    "position": 1,
    "text": "برفتند بر سر نهاده کلاه"
  },
  {
    "poem_id": 88035,
    "vorder": 191,
    "position": 0,
    "text": "پس آن نامهٔ شاه، فرخ هجیر"
  },
  {
    "poem_id": 88035,
    "vorder": 192,
    "position": 1,
    "text": "بیاورد و بنهاد پیش دبیر"
  },
  {
    "poem_id": 88035,
    "vorder": 193,
    "position": 0,
    "text": "دبیر آن زمان پند و فرمان شاه"
  },
  {
    "poem_id": 88035,
    "vorder": 194,
    "position": 1,
    "text": "ز نامه همی خواند پیش سپاه"
  },
  {
    "poem_id": 88035,
    "vorder": 195,
    "position": 0,
    "text": "سپهدار روزی‌دهان را بخواند"
  },
  {
    "poem_id": 88035,
    "vorder": 196,
    "position": 1,
    "text": "بدیوان دینار دادن نشاند"
  },
  {
    "poem_id": 88035,
    "vorder": 197,
    "position": 0,
    "text": "ز اسبان گله هرچ بودش به کوه"
  },
  {
    "poem_id": 88035,
    "vorder": 198,
    "position": 1,
    "text": "به لشکرگه آورد یکسر گروه"
  },
  {
    "poem_id": 88035,
    "vorder": 199,
    "position": 0,
    "text": "در گنج دینار و تیغ و کمر"
  },
  {
    "poem_id": 88035,
    "vorder": 200,
    "position": 1,
    "text": "همان مایه‌ور جوشن و خود زر"
  },
  {
    "poem_id": 88035,
    "vorder": 201,
    "position": 0,
    "text": "به روزی‌دهان داد یکسر کلید"
  },
  {
    "poem_id": 88035,
    "vorder": 202,
    "position": 1,
    "text": "چو آمد گه نام جستن پدید"
  },
  {
    "poem_id": 88035,
    "vorder": 203,
    "position": 0,
    "text": "برافشاند بر لشکر آن خواسته"
  },
  {
    "poem_id": 88035,
    "vorder": 204,
    "position": 1,
    "text": "سوار و پیاده شد آراسته"
  },
  {
    "poem_id": 88035,
    "vorder": 205,
    "position": 0,
    "text": "یکی لشکری گشن بر سان کوه"
  },
  {
    "poem_id": 88035,
    "vorder": 206,
    "position": 1,
    "text": "زمین از پی بادپایان ستوه"
  },
  {
    "poem_id": 88035,
    "vorder": 207,
    "position": 0,
    "text": "دل شیر غران از ایشان به بیم"
  },
  {
    "poem_id": 88035,
    "vorder": 208,
    "position": 1,
    "text": "همه غرقه در آهن و زر و سیم"
  },
  {
    "poem_id": 88035,
    "vorder": 209,
    "position": 0,
    "text": "بفرمودشان جنگ را ساختن"
  },
  {
    "poem_id": 88035,
    "vorder": 210,
    "position": 1,
    "text": "دل و گوش دادن به کین آختن"
  },
  {
    "poem_id": 88035,
    "vorder": 211,
    "position": 0,
    "text": "برفتند پیش سپهبد گروه"
  },
  {
    "poem_id": 88035,
    "vorder": 212,
    "position": 1,
    "text": "بر انبوه لشکر به کردار کوه"
  },
  {
    "poem_id": 88035,
    "vorder": 213,
    "position": 0,
    "text": "بر ایشان نگه کرد سالار مرد"
  },
  {
    "poem_id": 88035,
    "vorder": 214,
    "position": 1,
    "text": "زمین تیره دید آسمان لاژورد"
  },
  {
    "poem_id": 88035,
    "vorder": 215,
    "position": 0,
    "text": "چنین گفت کز گاه رزم پشین"
  },
  {
    "poem_id": 88035,
    "vorder": 216,
    "position": 1,
    "text": "نیاراست کس رزمگاهی چنین"
  },
  {
    "poem_id": 88035,
    "vorder": 217,
    "position": 0,
    "text": "به اسب و سلیح و به سیم و به زر"
  },
  {
    "poem_id": 88035,
    "vorder": 218,
    "position": 1,
    "text": "به پیلان جنگی و شیران نر"
  },
  {
    "poem_id": 88035,
    "vorder": 219,
    "position": 0,
    "text": "اگر یار باشد جهان‌آفرین"
  },
  {
    "poem_id": 88035,
    "vorder": 220,
    "position": 1,
    "text": "نپیچیم از ایدر عنان تا به چین"
  },
  {
    "poem_id": 88035,
    "vorder": 221,
    "position": 0,
    "text": "چو بنشست فرزانگان را بخواند"
  },
  {
    "poem_id": 88035,
    "vorder": 222,
    "position": 1,
    "text": "ابا نامداران به رامش نشاند"
  },
  {
    "poem_id": 88035,
    "vorder": 223,
    "position": 0,
    "text": "همی خورد شادی‌کنان دل به جای"
  },
  {
    "poem_id": 88035,
    "vorder": 224,
    "position": 1,
    "text": "همی با یلان جنگ را کرد رای"
  },
  {
    "poem_id": 88035,
    "vorder": 225,
    "position": 0,
    "text": "به پیران رسید آگهی ز این سخن"
  },
  {
    "poem_id": 88035,
    "vorder": 226,
    "position": 1,
    "text": "که سالار ایران چه افگند بن"
  },
  {
    "poem_id": 88035,
    "vorder": 227,
    "position": 0,
    "text": "از آن آگهی شد دلش پرنهیب"
  },
  {
    "poem_id": 88035,
    "vorder": 228,
    "position": 1,
    "text": "سوی چاره برگشت و بند و فریب"
  },
  {
    "poem_id": 88035,
    "vorder": 229,
    "position": 0,
    "text": "ز دستور فرخنده رای آنگهی"
  },
  {
    "poem_id": 88035,
    "vorder": 230,
    "position": 1,
    "text": "بجست اندر آن کینه جستن رهی"
  }
]