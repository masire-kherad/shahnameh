[
  {
    "poem_id": 1752,
    "vorder": 1,
    "position": 0,
    "text": "خردمند و شایسته بهرامشاه"
  },
  {
    "poem_id": 1752,
    "vorder": 2,
    "position": 1,
    "text": "همی داشت سوک پدر چندگاه"
  },
  {
    "poem_id": 1752,
    "vorder": 3,
    "position": 0,
    "text": "چو بنشست بر جایگاه مهی"
  },
  {
    "poem_id": 1752,
    "vorder": 4,
    "position": 1,
    "text": "چنین گفت بر تخت شاهنشهی"
  },
  {
    "poem_id": 1752,
    "vorder": 5,
    "position": 0,
    "text": "که هر شاه کز داد گنج آگند"
  },
  {
    "poem_id": 1752,
    "vorder": 6,
    "position": 1,
    "text": "بدانید کان گنج نپراگند"
  },
  {
    "poem_id": 1752,
    "vorder": 7,
    "position": 0,
    "text": "ز ما ایزد پاک خشنود باد"
  },
  {
    "poem_id": 1752,
    "vorder": 8,
    "position": 1,
    "text": "بداندیش را دل پر از دود باد"
  },
  {
    "poem_id": 1752,
    "vorder": 9,
    "position": 0,
    "text": "همه دانش اوراست ما بنده‌ایم"
  },
  {
    "poem_id": 1752,
    "vorder": 10,
    "position": 1,
    "text": "که کاهنده و هم فزاینده‌ایم"
  },
  {
    "poem_id": 1752,
    "vorder": 11,
    "position": 0,
    "text": "جهاندار یزدان بود داد و راست"
  },
  {
    "poem_id": 1752,
    "vorder": 12,
    "position": 1,
    "text": "که نفزود در پادشاهی نه کاست"
  },
  {
    "poem_id": 1752,
    "vorder": 13,
    "position": 0,
    "text": "کسی کو به بخشش توانا بود"
  },
  {
    "poem_id": 1752,
    "vorder": 14,
    "position": 1,
    "text": "خردمند و بیدار و دانا بود"
  },
  {
    "poem_id": 1752,
    "vorder": 15,
    "position": 0,
    "text": "نباید که بندد در گنج سخت"
  },
  {
    "poem_id": 1752,
    "vorder": 16,
    "position": 1,
    "text": "به ویژه خداوند دیهیم و تخت"
  },
  {
    "poem_id": 1752,
    "vorder": 17,
    "position": 0,
    "text": "وگر چند بخشی ز گنج سخن"
  },
  {
    "poem_id": 1752,
    "vorder": 18,
    "position": 1,
    "text": "برافشان که دانش نیاید به بن"
  },
  {
    "poem_id": 1752,
    "vorder": 19,
    "position": 0,
    "text": "ز نیک و بدیها به یزدان گرای"
  },
  {
    "poem_id": 1752,
    "vorder": 20,
    "position": 1,
    "text": "چو خواهی که نیکیت ماند به جای"
  },
  {
    "poem_id": 1752,
    "vorder": 21,
    "position": 0,
    "text": "اگر زو شناسی همه خوب و زشت"
  },
  {
    "poem_id": 1752,
    "vorder": 22,
    "position": 1,
    "text": "بیابی به پاداش خرم بهشت"
  },
  {
    "poem_id": 1752,
    "vorder": 23,
    "position": 0,
    "text": "وگر برگزینی ز گیتی هوا"
  },
  {
    "poem_id": 1752,
    "vorder": 24,
    "position": 1,
    "text": "بمانی به چنگ هوا بی‌نوا"
  },
  {
    "poem_id": 1752,
    "vorder": 25,
    "position": 0,
    "text": "چو داردت یزدان بدو دست یاز"
  },
  {
    "poem_id": 1752,
    "vorder": 26,
    "position": 1,
    "text": "بدان تا نمانی به گرم و گداز"
  },
  {
    "poem_id": 1752,
    "vorder": 27,
    "position": 0,
    "text": "چنین است امیدم به یزدان پاک"
  },
  {
    "poem_id": 1752,
    "vorder": 28,
    "position": 1,
    "text": "که چون سر بیارم بدین تیره‌خاک"
  },
  {
    "poem_id": 1752,
    "vorder": 29,
    "position": 0,
    "text": "جهاندار پیروز دارد مرا"
  },
  {
    "poem_id": 1752,
    "vorder": 30,
    "position": 1,
    "text": "همان گیتی افروز دارد مرا"
  },
  {
    "poem_id": 1752,
    "vorder": 31,
    "position": 0,
    "text": "گر اندر جهان داد بپراگنم"
  },
  {
    "poem_id": 1752,
    "vorder": 32,
    "position": 1,
    "text": "ازان به که بیداد گنج آگنم"
  },
  {
    "poem_id": 1752,
    "vorder": 33,
    "position": 0,
    "text": "که ایدر بماند همه رنج ما"
  },
  {
    "poem_id": 1752,
    "vorder": 34,
    "position": 1,
    "text": "به دشمن رسد بی‌گمان گنج ما"
  },
  {
    "poem_id": 1752,
    "vorder": 35,
    "position": 0,
    "text": "که تخت بزرگی نماند به کس"
  },
  {
    "poem_id": 1752,
    "vorder": 36,
    "position": 1,
    "text": "جهاندار باشد ترا یار بس"
  },
  {
    "poem_id": 1752,
    "vorder": 37,
    "position": 0,
    "text": "بد و نیک ماند ز ما یادگار"
  },
  {
    "poem_id": 1752,
    "vorder": 38,
    "position": 1,
    "text": "تو تخم بدی تا توانی مکار"
  },
  {
    "poem_id": 1752,
    "vorder": 39,
    "position": 0,
    "text": "چو شد سال آن پادشا بر دو هفت"
  },
  {
    "poem_id": 1752,
    "vorder": 40,
    "position": 1,
    "text": "به پالیز آن سرو یازان بخفت"
  },
  {
    "poem_id": 1752,
    "vorder": 41,
    "position": 0,
    "text": "به یک چندگه دیر بیمار بود"
  },
  {
    "poem_id": 1752,
    "vorder": 42,
    "position": 1,
    "text": "دل کهتران پر ز تیمار بود"
  },
  {
    "poem_id": 1752,
    "vorder": 43,
    "position": 0,
    "text": "نبودش پسر پنج دخترش بود"
  },
  {
    "poem_id": 1752,
    "vorder": 44,
    "position": 1,
    "text": "یکی کهتر از وی برادرش بود"
  },
  {
    "poem_id": 1752,
    "vorder": 45,
    "position": 0,
    "text": "بدو داد ناگاه گنج و سپاه"
  },
  {
    "poem_id": 1752,
    "vorder": 46,
    "position": 1,
    "text": "همان مهر شاهی و تخت و کلاه"
  },
  {
    "poem_id": 1752,
    "vorder": 47,
    "position": 0,
    "text": "جهاندار برنا ز گیتی برفت"
  },
  {
    "poem_id": 1752,
    "vorder": 48,
    "position": 1,
    "text": "برو سالیان برگذشته دو هفت"
  },
  {
    "poem_id": 1752,
    "vorder": 49,
    "position": 0,
    "text": "ایا شست و سه ساله مرد کهن"
  },
  {
    "poem_id": 1752,
    "vorder": 50,
    "position": 1,
    "text": "تو از باد تا چند رانی سخن"
  },
  {
    "poem_id": 1752,
    "vorder": 51,
    "position": 0,
    "text": "همان روز تو ناگهان بگذرد"
  },
  {
    "poem_id": 1752,
    "vorder": 52,
    "position": 1,
    "text": "در توبه بگزین و راه خرد"
  },
  {
    "poem_id": 1752,
    "vorder": 53,
    "position": 0,
    "text": "جهاندار زین پیر خشنود باد"
  },
  {
    "poem_id": 1752,
    "vorder": 54,
    "position": 1,
    "text": "خرد مایه باد و سخن سود باد"
  },
  {
    "poem_id": 1752,
    "vorder": 55,
    "position": 0,
    "text": "اگر در سخن موی کافد همی"
  },
  {
    "poem_id": 1752,
    "vorder": 56,
    "position": 1,
    "text": "به تاریکی اندر ببافد همی"
  },
  {
    "poem_id": 1752,
    "vorder": 57,
    "position": 0,
    "text": "گر او این سخن‌ها که اندرگرفت"
  },
  {
    "poem_id": 1752,
    "vorder": 58,
    "position": 1,
    "text": "به پیری سرآرد نباشد شگفت"
  },
  {
    "poem_id": 1752,
    "vorder": 59,
    "position": 0,
    "text": "به نام شهنشاه شمشیرزن"
  },
  {
    "poem_id": 1752,
    "vorder": 60,
    "position": 1,
    "text": "به بالا سرش برتر از انجمن"
  },
  {
    "poem_id": 1752,
    "vorder": 61,
    "position": 0,
    "text": "زمانه به کام شهنشاه باد"
  },
  {
    "poem_id": 1752,
    "vorder": 62,
    "position": 1,
    "text": "سر تخت او افسر ماه باد"
  },
  {
    "poem_id": 1752,
    "vorder": 63,
    "position": 0,
    "text": "کزویست کام و بدویست نام"
  },
  {
    "poem_id": 1752,
    "vorder": 64,
    "position": 1,
    "text": "ورا باد تاج کیی شادکام"
  },
  {
    "poem_id": 1752,
    "vorder": 65,
    "position": 0,
    "text": "بزرگی و دانش ورا راه باد"
  },
  {
    "poem_id": 1752,
    "vorder": 66,
    "position": 1,
    "text": "وزو دست بدخواه کوتاه باد"
  }
]