[
  {
    "poem_id": 1532,
    "vorder": 1,
    "position": 0,
    "text": "بپیچید و نامه بکردش نشان"
  },
  {
    "poem_id": 1532,
    "vorder": 2,
    "position": 1,
    "text": "بدادش بدان هر دو گردنکشان"
  },
  {
    "poem_id": 1532,
    "vorder": 3,
    "position": 0,
    "text": "بفرمودشان گفت بخرد بوید"
  },
  {
    "poem_id": 1532,
    "vorder": 4,
    "position": 1,
    "text": "به ایوان او با هم اندر شوید"
  },
  {
    "poem_id": 1532,
    "vorder": 5,
    "position": 0,
    "text": "چو او را ببینید بر تخت و گاه"
  },
  {
    "poem_id": 1532,
    "vorder": 6,
    "position": 1,
    "text": "کنید آن زمان خویشتن را دو تاه"
  },
  {
    "poem_id": 1532,
    "vorder": 7,
    "position": 0,
    "text": "بر آیین شاهان نمازش برید"
  },
  {
    "poem_id": 1532,
    "vorder": 8,
    "position": 1,
    "text": "بر تاج و بر تخت او مگذرید"
  },
  {
    "poem_id": 1532,
    "vorder": 9,
    "position": 0,
    "text": "چو هر دو نشینید در پیش اوی"
  },
  {
    "poem_id": 1532,
    "vorder": 10,
    "position": 1,
    "text": "سوی تاج تابنده‌ش آرید روی"
  },
  {
    "poem_id": 1532,
    "vorder": 11,
    "position": 0,
    "text": "گزارید پیغام فرخش را"
  },
  {
    "poem_id": 1532,
    "vorder": 12,
    "position": 1,
    "text": "ازو گوش دارید پاسخش را"
  },
  {
    "poem_id": 1532,
    "vorder": 13,
    "position": 0,
    "text": "چو پاسخ ازو سر بسر بشنوید"
  },
  {
    "poem_id": 1532,
    "vorder": 14,
    "position": 1,
    "text": "زمین را ببوسید و بیرون شوید"
  },
  {
    "poem_id": 1532,
    "vorder": 15,
    "position": 0,
    "text": "چو از پیش او کینه‌ور بیدرفش"
  },
  {
    "poem_id": 1532,
    "vorder": 16,
    "position": 1,
    "text": "سوی بلخ بامی کشیدش درفش"
  },
  {
    "poem_id": 1532,
    "vorder": 17,
    "position": 0,
    "text": "ابا یار خود خیره سر نام خواست"
  },
  {
    "poem_id": 1532,
    "vorder": 18,
    "position": 1,
    "text": "که او بفگند آن نکو راه راست"
  },
  {
    "poem_id": 1532,
    "vorder": 19,
    "position": 0,
    "text": "چو از شهر توران به بلخ آمدند"
  },
  {
    "poem_id": 1532,
    "vorder": 20,
    "position": 1,
    "text": "به درگاه او بر پیاده شدند"
  },
  {
    "poem_id": 1532,
    "vorder": 21,
    "position": 0,
    "text": "پیاده برفتند تا پیش اوی"
  },
  {
    "poem_id": 1532,
    "vorder": 22,
    "position": 1,
    "text": "براین آستانه نهادند روی"
  },
  {
    "poem_id": 1532,
    "vorder": 23,
    "position": 0,
    "text": "چو رویش بدیدند بر گاه بر"
  },
  {
    "poem_id": 1532,
    "vorder": 24,
    "position": 1,
    "text": "چو خورشید و تیر از بر ماه بر"
  },
  {
    "poem_id": 1532,
    "vorder": 25,
    "position": 0,
    "text": "نیایش نمودند چون بندگان"
  },
  {
    "poem_id": 1532,
    "vorder": 26,
    "position": 1,
    "text": "به پیش گزین شاه فرخندگان"
  },
  {
    "poem_id": 1532,
    "vorder": 27,
    "position": 0,
    "text": "بدادندش آن نامهٔ خسروی"
  },
  {
    "poem_id": 1532,
    "vorder": 28,
    "position": 1,
    "text": "نوشته درو بر خط یبغوی"
  },
  {
    "poem_id": 1532,
    "vorder": 29,
    "position": 0,
    "text": "چو شاه جهان نامه را باز کرد"
  },
  {
    "poem_id": 1532,
    "vorder": 30,
    "position": 1,
    "text": "برآشفت و پیچیدن آغاز کرد"
  },
  {
    "poem_id": 1532,
    "vorder": 31,
    "position": 0,
    "text": "بخواند آن زمان پیر جاماسپ را"
  },
  {
    "poem_id": 1532,
    "vorder": 32,
    "position": 1,
    "text": "کجا راهبر بود گشتاسپ را"
  },
  {
    "poem_id": 1532,
    "vorder": 33,
    "position": 0,
    "text": "گزینان ایران و اسپهبدان"
  },
  {
    "poem_id": 1532,
    "vorder": 34,
    "position": 1,
    "text": "گوان جهان دیده و موبدان"
  },
  {
    "poem_id": 1532,
    "vorder": 35,
    "position": 0,
    "text": "بخواند آن همه آذران پیش خویش"
  },
  {
    "poem_id": 1532,
    "vorder": 36,
    "position": 1,
    "text": "بیاورد استا و بنهاد پیش"
  },
  {
    "poem_id": 1532,
    "vorder": 37,
    "position": 0,
    "text": "پیمبرش را خواند و موبدش را"
  },
  {
    "poem_id": 1532,
    "vorder": 38,
    "position": 1,
    "text": "زریر گزیده سپهبدش را"
  },
  {
    "poem_id": 1532,
    "vorder": 39,
    "position": 0,
    "text": "زریر سپهبد برادرش بود"
  },
  {
    "poem_id": 1532,
    "vorder": 40,
    "position": 1,
    "text": "که سالار گردان لشکرش بود"
  },
  {
    "poem_id": 1532,
    "vorder": 41,
    "position": 0,
    "text": "جهان پهلوان بود آن روزگار"
  },
  {
    "poem_id": 1532,
    "vorder": 42,
    "position": 1,
    "text": "که کودک بد اسفندیار سوار"
  },
  {
    "poem_id": 1532,
    "vorder": 43,
    "position": 0,
    "text": "پناه سپه بود و پشت سپاه"
  },
  {
    "poem_id": 1532,
    "vorder": 44,
    "position": 1,
    "text": "سپهدار لشکر نگهدار گاه"
  },
  {
    "poem_id": 1532,
    "vorder": 45,
    "position": 0,
    "text": "جهان از بدی ویژه او داشتی"
  },
  {
    "poem_id": 1532,
    "vorder": 46,
    "position": 1,
    "text": "به رزم اندرون نیژه او داشتی"
  },
  {
    "poem_id": 1532,
    "vorder": 47,
    "position": 0,
    "text": "جهانجوی گفتا به فرخ زریر"
  },
  {
    "poem_id": 1532,
    "vorder": 48,
    "position": 1,
    "text": "به فرخنده جاماسپ و پور دلیر"
  },
  {
    "poem_id": 1532,
    "vorder": 49,
    "position": 0,
    "text": "که ارجاسپ سالار ترکان چین"
  },
  {
    "poem_id": 1532,
    "vorder": 50,
    "position": 1,
    "text": "یکی نامه کردست زی من چنین"
  },
  {
    "poem_id": 1532,
    "vorder": 51,
    "position": 0,
    "text": "بدیشان نمود آن سخنهای زشت"
  },
  {
    "poem_id": 1532,
    "vorder": 52,
    "position": 1,
    "text": "که نزدیک او شاه ترکان نوشت"
  },
  {
    "poem_id": 1532,
    "vorder": 53,
    "position": 0,
    "text": "چه بینید گفتا بدین اندرون"
  },
  {
    "poem_id": 1532,
    "vorder": 54,
    "position": 1,
    "text": "چه گویید کاین را سرانجام چون"
  },
  {
    "poem_id": 1532,
    "vorder": 55,
    "position": 0,
    "text": "که ناخوش بود دوستی با کسی"
  },
  {
    "poem_id": 1532,
    "vorder": 56,
    "position": 1,
    "text": "که مایه ندارد ز دانش بسی"
  },
  {
    "poem_id": 1532,
    "vorder": 57,
    "position": 0,
    "text": "من از تخمهٔ ایرج پاک زاد"
  },
  {
    "poem_id": 1532,
    "vorder": 58,
    "position": 1,
    "text": "وی از تخمهٔ تور جادو نژاد"
  },
  {
    "poem_id": 1532,
    "vorder": 59,
    "position": 0,
    "text": "چگونه بود در میان آشتی"
  },
  {
    "poem_id": 1532,
    "vorder": 60,
    "position": 1,
    "text": "ولیکن مرا بود پنداشتی"
  },
  {
    "poem_id": 1532,
    "vorder": 61,
    "position": 0,
    "text": "کسی کش بود نام و ماند بسی"
  },
  {
    "poem_id": 1532,
    "vorder": 62,
    "position": 1,
    "text": "سخن گفت بایدش با هرکسی"
  }
]