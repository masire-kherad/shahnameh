[
  {
    "poem_id": 1729,
    "vorder": 1,
    "position": 0,
    "text": "چو بهرام در سوک بهرامشاه"
  },
  {
    "poem_id": 1729,
    "vorder": 2,
    "position": 1,
    "text": "چهل روز ننهاد بر سر کلاه"
  },
  {
    "poem_id": 1729,
    "vorder": 3,
    "position": 0,
    "text": "برفتند گردان بسیار هوش"
  },
  {
    "poem_id": 1729,
    "vorder": 4,
    "position": 1,
    "text": "پر از درد با ناله و با خروش"
  },
  {
    "poem_id": 1729,
    "vorder": 5,
    "position": 0,
    "text": "نشستند با او به سوک و به درد"
  },
  {
    "poem_id": 1729,
    "vorder": 6,
    "position": 1,
    "text": "دو رخ زرد و لبها شده لاژورد"
  },
  {
    "poem_id": 1729,
    "vorder": 7,
    "position": 0,
    "text": "وزان پس بشد موبد پاک‌رای"
  },
  {
    "poem_id": 1729,
    "vorder": 8,
    "position": 1,
    "text": "که گیرد مگر شاه بر گاه جای"
  },
  {
    "poem_id": 1729,
    "vorder": 9,
    "position": 0,
    "text": "به یک هفته با او بکوشید سخت"
  },
  {
    "poem_id": 1729,
    "vorder": 10,
    "position": 1,
    "text": "همی بود تا بر نشست او به تخت"
  },
  {
    "poem_id": 1729,
    "vorder": 11,
    "position": 0,
    "text": "چو بنشست بهرام بر تخت داد"
  },
  {
    "poem_id": 1729,
    "vorder": 12,
    "position": 1,
    "text": "برسم کیان تاج بر سر نهاد"
  },
  {
    "poem_id": 1729,
    "vorder": 13,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1729,
    "vorder": 14,
    "position": 1,
    "text": "فروزندهٔ گردش روزگار"
  },
  {
    "poem_id": 1729,
    "vorder": 15,
    "position": 0,
    "text": "فزایندهٔ دانش و راستی"
  },
  {
    "poem_id": 1729,
    "vorder": 16,
    "position": 1,
    "text": "گزایندهٔ کژی و کاستی"
  },
  {
    "poem_id": 1729,
    "vorder": 17,
    "position": 0,
    "text": "خداوند کیوان و گردان سپهر"
  },
  {
    "poem_id": 1729,
    "vorder": 18,
    "position": 1,
    "text": "ز بنده نخواهد به جز داد و مهر"
  },
  {
    "poem_id": 1729,
    "vorder": 19,
    "position": 0,
    "text": "ازان پس چنین گفت کای بخردان"
  },
  {
    "poem_id": 1729,
    "vorder": 20,
    "position": 1,
    "text": "جهاندیده و پاک‌دل موبدان"
  },
  {
    "poem_id": 1729,
    "vorder": 21,
    "position": 0,
    "text": "شما هرک دارید دانش بزرگ"
  },
  {
    "poem_id": 1729,
    "vorder": 22,
    "position": 1,
    "text": "مباشید با شهریاران سترگ"
  },
  {
    "poem_id": 1729,
    "vorder": 23,
    "position": 0,
    "text": "به فرهنگ یازد کسی کش خرد"
  },
  {
    "poem_id": 1729,
    "vorder": 24,
    "position": 1,
    "text": "بود روشن و مردمی پرورد"
  },
  {
    "poem_id": 1729,
    "vorder": 25,
    "position": 0,
    "text": "سر مردمی بردباری بود"
  },
  {
    "poem_id": 1729,
    "vorder": 26,
    "position": 1,
    "text": "چو تندی کند تن به خواری بود"
  },
  {
    "poem_id": 1729,
    "vorder": 27,
    "position": 0,
    "text": "هرانکس که گشت ایمن او شاد شد"
  },
  {
    "poem_id": 1729,
    "vorder": 28,
    "position": 1,
    "text": "غم و رنج با ایمنی باد شد"
  },
  {
    "poem_id": 1729,
    "vorder": 29,
    "position": 0,
    "text": "توانگرتر آن کو دلی راد داشت"
  },
  {
    "poem_id": 1729,
    "vorder": 30,
    "position": 1,
    "text": "درم گرد کردن به دل باد داشت"
  },
  {
    "poem_id": 1729,
    "vorder": 31,
    "position": 0,
    "text": "اگر نیستت چیز لختی بورز"
  },
  {
    "poem_id": 1729,
    "vorder": 32,
    "position": 1,
    "text": "که بی‌چیز کس را ندارند ارز"
  },
  {
    "poem_id": 1729,
    "vorder": 33,
    "position": 0,
    "text": "مروت نیابد کرا چیز نیست"
  },
  {
    "poem_id": 1729,
    "vorder": 34,
    "position": 1,
    "text": "همان جاه نزد کسش نیز نیست"
  },
  {
    "poem_id": 1729,
    "vorder": 35,
    "position": 0,
    "text": "چو خشنود باشی تن‌آسان شوی"
  },
  {
    "poem_id": 1729,
    "vorder": 36,
    "position": 1,
    "text": "وگر آز ورزی هراسان شوی"
  },
  {
    "poem_id": 1729,
    "vorder": 37,
    "position": 0,
    "text": "نه کوشیدنی کان برآرد به رنج"
  },
  {
    "poem_id": 1729,
    "vorder": 38,
    "position": 1,
    "text": "روان را به پیچاند از آز گنج"
  },
  {
    "poem_id": 1729,
    "vorder": 39,
    "position": 0,
    "text": "ز کار زمانه میانه گزین"
  },
  {
    "poem_id": 1729,
    "vorder": 40,
    "position": 1,
    "text": "چو خواهی که یابی بداد آفرین"
  },
  {
    "poem_id": 1729,
    "vorder": 41,
    "position": 0,
    "text": "چو خشنود داری جهان را به داد"
  },
  {
    "poem_id": 1729,
    "vorder": 42,
    "position": 1,
    "text": "توانگر بمانی و از داد شاد"
  },
  {
    "poem_id": 1729,
    "vorder": 43,
    "position": 0,
    "text": "همه ایمنی باید و راستی"
  },
  {
    "poem_id": 1729,
    "vorder": 44,
    "position": 1,
    "text": "نباید به داد اندرون کاستی"
  },
  {
    "poem_id": 1729,
    "vorder": 45,
    "position": 0,
    "text": "چو شادی بکاهی بکاهد روان"
  },
  {
    "poem_id": 1729,
    "vorder": 46,
    "position": 1,
    "text": "خرد گردد اندر میان ناتوان"
  },
  {
    "poem_id": 1729,
    "vorder": 47,
    "position": 0,
    "text": "چو شد پادشاهیش بر سال بیست"
  },
  {
    "poem_id": 1729,
    "vorder": 48,
    "position": 1,
    "text": "یکی کم برو زندگانی گریست"
  },
  {
    "poem_id": 1729,
    "vorder": 49,
    "position": 0,
    "text": "شد آن تاجور شاه با خاک جفت"
  },
  {
    "poem_id": 1729,
    "vorder": 50,
    "position": 1,
    "text": "ز خرم جهان دخمه بودش نهفت"
  },
  {
    "poem_id": 1729,
    "vorder": 51,
    "position": 0,
    "text": "جهان را چنین است آیین و ساز"
  },
  {
    "poem_id": 1729,
    "vorder": 52,
    "position": 1,
    "text": "ندارد به مرگ از کسی چنگ باز"
  },
  {
    "poem_id": 1729,
    "vorder": 53,
    "position": 0,
    "text": "پسر بود او را یکی شادکام"
  },
  {
    "poem_id": 1729,
    "vorder": 54,
    "position": 1,
    "text": "که بهرام بهرامیان داشت نام"
  },
  {
    "poem_id": 1729,
    "vorder": 55,
    "position": 0,
    "text": "بیامد نشست از بر تخت شاد"
  },
  {
    "poem_id": 1729,
    "vorder": 56,
    "position": 1,
    "text": "کلاه کیانی به سر بر نهاد"
  },
  {
    "poem_id": 1729,
    "vorder": 57,
    "position": 0,
    "text": "کنون کار بهرام بهرامیان"
  },
  {
    "poem_id": 1729,
    "vorder": 58,
    "position": 1,
    "text": "بگویم تو بشنو به جان و روان"
  }
]