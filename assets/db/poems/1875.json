[
  {
    "poem_id": 1875,
    "vorder": 1,
    "position": 0,
    "text": "چوشب دامن تیره اندر کشید"
  },
  {
    "poem_id": 1875,
    "vorder": 2,
    "position": 1,
    "text": "سپیده ز کوه سیه بر دمید"
  },
  {
    "poem_id": 1875,
    "vorder": 3,
    "position": 0,
    "text": "مقاتوره پوشید خفتان جنگ"
  },
  {
    "poem_id": 1875,
    "vorder": 4,
    "position": 1,
    "text": "بیامد یکی تیغ توری به چنگ"
  },
  {
    "poem_id": 1875,
    "vorder": 5,
    "position": 0,
    "text": "چو بهرام بشنید بالای خواست"
  },
  {
    "poem_id": 1875,
    "vorder": 6,
    "position": 1,
    "text": "یکی جوشن خسرو آرای خواست"
  },
  {
    "poem_id": 1875,
    "vorder": 7,
    "position": 0,
    "text": "گزیدند جایی که هرگز پلنگ"
  },
  {
    "poem_id": 1875,
    "vorder": 8,
    "position": 1,
    "text": "بر آن شخ بی‌آب ننهاد چنگ"
  },
  {
    "poem_id": 1875,
    "vorder": 9,
    "position": 0,
    "text": "چو خاقان شنید این سخن برنشست"
  },
  {
    "poem_id": 1875,
    "vorder": 10,
    "position": 1,
    "text": "برفتند ترکان خسرو پرست"
  },
  {
    "poem_id": 1875,
    "vorder": 11,
    "position": 0,
    "text": "بدان کار تا زین دو شیر دمان"
  },
  {
    "poem_id": 1875,
    "vorder": 12,
    "position": 1,
    "text": "کرا پیشتر خواهد آمد زمان"
  },
  {
    "poem_id": 1875,
    "vorder": 13,
    "position": 0,
    "text": "مقاتوره چون شد به دشت نبرد"
  },
  {
    "poem_id": 1875,
    "vorder": 14,
    "position": 1,
    "text": "ز هامون به ابر اندر آورد گرد"
  },
  {
    "poem_id": 1875,
    "vorder": 15,
    "position": 0,
    "text": "به بهرام گردنکش آواز داد"
  },
  {
    "poem_id": 1875,
    "vorder": 16,
    "position": 1,
    "text": "که اکنون ز مردی چه داری بیاد"
  },
  {
    "poem_id": 1875,
    "vorder": 17,
    "position": 0,
    "text": "تو تازی بدین جنگ بر پیشدست"
  },
  {
    "poem_id": 1875,
    "vorder": 18,
    "position": 1,
    "text": "و گر شیردل ترک خاقان پرست"
  },
  {
    "poem_id": 1875,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت بهرام پیشی تو کن"
  },
  {
    "poem_id": 1875,
    "vorder": 20,
    "position": 1,
    "text": "کجا پی تو افگنده‌ای این سخن"
  },
  {
    "poem_id": 1875,
    "vorder": 21,
    "position": 0,
    "text": "مقاتوره کرد از جهاندار یاد"
  },
  {
    "poem_id": 1875,
    "vorder": 22,
    "position": 1,
    "text": "دو زاغ کمان را به زه برنهاد"
  },
  {
    "poem_id": 1875,
    "vorder": 23,
    "position": 0,
    "text": "زه و تیر بگرفت شادان بدست"
  },
  {
    "poem_id": 1875,
    "vorder": 24,
    "position": 1,
    "text": "چو شد غرق پیکانش بگشاد شست"
  },
  {
    "poem_id": 1875,
    "vorder": 25,
    "position": 0,
    "text": "بزد بر کمربند مرد سوار"
  },
  {
    "poem_id": 1875,
    "vorder": 26,
    "position": 1,
    "text": "نسفت آهن از آهن آبدار"
  },
  {
    "poem_id": 1875,
    "vorder": 27,
    "position": 0,
    "text": "زمانی همی‌بود بهرام دیر"
  },
  {
    "poem_id": 1875,
    "vorder": 28,
    "position": 1,
    "text": "که تاشد مقاتوره از رزم سیر"
  },
  {
    "poem_id": 1875,
    "vorder": 29,
    "position": 0,
    "text": "مقاتوره پنداشت کو شد تباه"
  },
  {
    "poem_id": 1875,
    "vorder": 30,
    "position": 1,
    "text": "خروشید و برگشت زان رزمگاه"
  },
  {
    "poem_id": 1875,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت بهرام کای جنگجوی"
  },
  {
    "poem_id": 1875,
    "vorder": 32,
    "position": 1,
    "text": "نکشتی مرا سوی خرگه مپوی"
  },
  {
    "poem_id": 1875,
    "vorder": 33,
    "position": 0,
    "text": "تو گفتی سخن باش و پاسخ شنو"
  },
  {
    "poem_id": 1875,
    "vorder": 34,
    "position": 1,
    "text": "اگر بشنوی زنده مانی برو"
  },
  {
    "poem_id": 1875,
    "vorder": 35,
    "position": 0,
    "text": "گزین کرد جوشن گذاری خدنگ"
  },
  {
    "poem_id": 1875,
    "vorder": 36,
    "position": 1,
    "text": "که آهن شدی پیش او نرم و سنگ"
  },
  {
    "poem_id": 1875,
    "vorder": 37,
    "position": 0,
    "text": "بزد بر میان سوار دلیر"
  },
  {
    "poem_id": 1875,
    "vorder": 38,
    "position": 1,
    "text": "سپهبد شد از رزم و دینار سیر"
  },
  {
    "poem_id": 1875,
    "vorder": 39,
    "position": 0,
    "text": "مقاتوره چون جنگ را برنشست"
  },
  {
    "poem_id": 1875,
    "vorder": 40,
    "position": 1,
    "text": "برادر دو پایش بزین بر ببست"
  },
  {
    "poem_id": 1875,
    "vorder": 41,
    "position": 0,
    "text": "بروی اندر آمد دو دیده پرآب"
  },
  {
    "poem_id": 1875,
    "vorder": 42,
    "position": 1,
    "text": "همان زین توری شدش جای خواب"
  },
  {
    "poem_id": 1875,
    "vorder": 43,
    "position": 0,
    "text": "به خاقان چنین گفت کای کامجوی"
  },
  {
    "poem_id": 1875,
    "vorder": 44,
    "position": 1,
    "text": "همی گورکن خواهد آن نامجوی"
  },
  {
    "poem_id": 1875,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت خاقان که بهتر ببین"
  },
  {
    "poem_id": 1875,
    "vorder": 46,
    "position": 1,
    "text": "کجا زنده خفتست بر پشت زین"
  },
  {
    "poem_id": 1875,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت بهرام کای برمنش"
  },
  {
    "poem_id": 1875,
    "vorder": 48,
    "position": 1,
    "text": "هم اکنون به خاک اندر آید تنش"
  },
  {
    "poem_id": 1875,
    "vorder": 49,
    "position": 0,
    "text": "تن دشمن تو چنین خفته باد"
  },
  {
    "poem_id": 1875,
    "vorder": 50,
    "position": 1,
    "text": "که او خفت بر اسپ توری نژاد"
  },
  {
    "poem_id": 1875,
    "vorder": 51,
    "position": 0,
    "text": "سواری فرستاد خاقان دلیر"
  },
  {
    "poem_id": 1875,
    "vorder": 52,
    "position": 1,
    "text": "به نزدیک آن نامبردار شیر"
  },
  {
    "poem_id": 1875,
    "vorder": 53,
    "position": 0,
    "text": "ورا بسته و کشته دیدند خوار"
  },
  {
    "poem_id": 1875,
    "vorder": 54,
    "position": 1,
    "text": "بر آسوده از گردش روزگار"
  },
  {
    "poem_id": 1875,
    "vorder": 55,
    "position": 0,
    "text": "بخندید خاقان به دل در نهان"
  },
  {
    "poem_id": 1875,
    "vorder": 56,
    "position": 1,
    "text": "شگفت آمدش زان سوار جهان"
  },
  {
    "poem_id": 1875,
    "vorder": 57,
    "position": 0,
    "text": "پر اندیشه بد تا بایوان رسید"
  },
  {
    "poem_id": 1875,
    "vorder": 58,
    "position": 1,
    "text": "کلاهش ز شادی به کیوان رسید"
  },
  {
    "poem_id": 1875,
    "vorder": 59,
    "position": 0,
    "text": "سلیح و درم خواست و اسپ ورهی"
  },
  {
    "poem_id": 1875,
    "vorder": 60,
    "position": 1,
    "text": "همان تاج و هم تخت شاهنشهی"
  },
  {
    "poem_id": 1875,
    "vorder": 61,
    "position": 0,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1875,
    "vorder": 62,
    "position": 1,
    "text": "ز هرگونه‌ای آلت کار زار"
  },
  {
    "poem_id": 1875,
    "vorder": 63,
    "position": 0,
    "text": "فرستاده از پیش خاقان ببرد"
  },
  {
    "poem_id": 1875,
    "vorder": 64,
    "position": 1,
    "text": "به گنجور بهرام جنگی سپرد"
  }
]