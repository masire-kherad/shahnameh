[
  {
    "poem_id": 1418,
    "vorder": 1,
    "position": 0,
    "text": "چو اغریرث آمد ز آمل به ری"
  },
  {
    "poem_id": 1418,
    "vorder": 2,
    "position": 1,
    "text": "وزان کارها آگهی یافت کی"
  },
  {
    "poem_id": 1418,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت کاین چیست کانگیختی"
  },
  {
    "poem_id": 1418,
    "vorder": 4,
    "position": 1,
    "text": "که با شهد حنظل برآمیختی"
  },
  {
    "poem_id": 1418,
    "vorder": 5,
    "position": 0,
    "text": "بفرمودمت کای برادر به کش"
  },
  {
    "poem_id": 1418,
    "vorder": 6,
    "position": 1,
    "text": "که جای خرد نیست و هنگام هش"
  },
  {
    "poem_id": 1418,
    "vorder": 7,
    "position": 0,
    "text": "به دانش نیاید سر جنگجوی"
  },
  {
    "poem_id": 1418,
    "vorder": 8,
    "position": 1,
    "text": "نباید به جنگ اندرون آبروی"
  },
  {
    "poem_id": 1418,
    "vorder": 9,
    "position": 0,
    "text": "سر مرد جنگی خرد نسپرد"
  },
  {
    "poem_id": 1418,
    "vorder": 10,
    "position": 1,
    "text": "که هرگز نیامیخت کین با خرد"
  },
  {
    "poem_id": 1418,
    "vorder": 11,
    "position": 0,
    "text": "چنین داد پاسخ به افراسیاب"
  },
  {
    "poem_id": 1418,
    "vorder": 12,
    "position": 1,
    "text": "که لختی بباید همی شرم و آب"
  },
  {
    "poem_id": 1418,
    "vorder": 13,
    "position": 0,
    "text": "هر آنگه کت آید به بد دسترس"
  },
  {
    "poem_id": 1418,
    "vorder": 14,
    "position": 1,
    "text": "ز یزدان بترس و مکن بد به کس"
  },
  {
    "poem_id": 1418,
    "vorder": 15,
    "position": 0,
    "text": "که تاج و کمر چون تو بیند بسی"
  },
  {
    "poem_id": 1418,
    "vorder": 16,
    "position": 1,
    "text": "نخواهد شدن رام با هر کسی"
  },
  {
    "poem_id": 1418,
    "vorder": 17,
    "position": 0,
    "text": "یکی پر ز آتش یکی پر‌خرد"
  },
  {
    "poem_id": 1418,
    "vorder": 18,
    "position": 1,
    "text": "خرد با سر دیو کی درخورد‌؟"
  },
  {
    "poem_id": 1418,
    "vorder": 19,
    "position": 0,
    "text": "سپهبد برآشفت چون پیل مست"
  },
  {
    "poem_id": 1418,
    "vorder": 20,
    "position": 1,
    "text": "به پاسخ به شمشیر یازید دست"
  },
  {
    "poem_id": 1418,
    "vorder": 21,
    "position": 0,
    "text": "میان برادر به دو‌نیم کرد"
  },
  {
    "poem_id": 1418,
    "vorder": 22,
    "position": 1,
    "text": "چنان سنگدل ناهشیوار مرد"
  },
  {
    "poem_id": 1418,
    "vorder": 23,
    "position": 0,
    "text": "چو از کار اغریرث نامدار"
  },
  {
    "poem_id": 1418,
    "vorder": 24,
    "position": 1,
    "text": "خبر شد به نزدیک زال سوار"
  },
  {
    "poem_id": 1418,
    "vorder": 25,
    "position": 0,
    "text": "چنین گفت که‌اکنون سر بخت اوی"
  },
  {
    "poem_id": 1418,
    "vorder": 26,
    "position": 1,
    "text": "شود تار و ویران‌شود تخت اوی"
  },
  {
    "poem_id": 1418,
    "vorder": 27,
    "position": 0,
    "text": "بزد نای رویین و بربست کوس"
  },
  {
    "poem_id": 1418,
    "vorder": 28,
    "position": 1,
    "text": "بیاراست لشکر چو چشم خروس"
  },
  {
    "poem_id": 1418,
    "vorder": 29,
    "position": 0,
    "text": "سپهبد سوی پارس بنهاد روی"
  },
  {
    "poem_id": 1418,
    "vorder": 30,
    "position": 1,
    "text": "همی‌رفت پر‌خشم و دل کینه‌جوی"
  },
  {
    "poem_id": 1418,
    "vorder": 31,
    "position": 0,
    "text": "ز دریا به دریا همی مرد بود"
  },
  {
    "poem_id": 1418,
    "vorder": 32,
    "position": 1,
    "text": "رخ ماه و خورشید پر گرد بود"
  },
  {
    "poem_id": 1418,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید افراسیاب این سخن"
  },
  {
    "poem_id": 1418,
    "vorder": 34,
    "position": 1,
    "text": "که دستان جنگی چه افگند بن"
  },
  {
    "poem_id": 1418,
    "vorder": 35,
    "position": 0,
    "text": "بیاورد لشکر سوی خوار ری"
  },
  {
    "poem_id": 1418,
    "vorder": 36,
    "position": 1,
    "text": "بیاراست جنگ و بیفشارد پی"
  },
  {
    "poem_id": 1418,
    "vorder": 37,
    "position": 0,
    "text": "طلایه شب و روز در جنگ بود"
  },
  {
    "poem_id": 1418,
    "vorder": 38,
    "position": 1,
    "text": "تو گفتی که گیتی بر او تنگ بود"
  },
  {
    "poem_id": 1418,
    "vorder": 39,
    "position": 0,
    "text": "مبارز بسی کشته شد بر دو روی"
  },
  {
    "poem_id": 1418,
    "vorder": 40,
    "position": 1,
    "text": "همه نامداران پرخاشجوی"
  }
]