[
  {
    "poem_id": 1910,
    "vorder": 1,
    "position": 0,
    "text": "همان زاد فرخ بدرگاه بر"
  },
  {
    "poem_id": 1910,
    "vorder": 2,
    "position": 1,
    "text": "همی‌بود و کس را ندادی گذر"
  },
  {
    "poem_id": 1910,
    "vorder": 3,
    "position": 0,
    "text": "که آگه شدی زان سخن شهریار"
  },
  {
    "poem_id": 1910,
    "vorder": 4,
    "position": 1,
    "text": "به درگاه بر بود چون پرده دار"
  },
  {
    "poem_id": 1910,
    "vorder": 5,
    "position": 0,
    "text": "چو پژمرده شد چادر آفتاب"
  },
  {
    "poem_id": 1910,
    "vorder": 6,
    "position": 1,
    "text": "همی‌ساخت هر مهتری جای خواب"
  },
  {
    "poem_id": 1910,
    "vorder": 7,
    "position": 0,
    "text": "بفرمود تا پاسبانان شهر"
  },
  {
    "poem_id": 1910,
    "vorder": 8,
    "position": 1,
    "text": "هر آنکس که از مهتری داشت بهر"
  },
  {
    "poem_id": 1910,
    "vorder": 9,
    "position": 0,
    "text": "برفتند یکسر سوی بارگاه"
  },
  {
    "poem_id": 1910,
    "vorder": 10,
    "position": 1,
    "text": "بدان جای شادی و آرام شاه"
  },
  {
    "poem_id": 1910,
    "vorder": 11,
    "position": 0,
    "text": "بدیشان چنین گفت کامشب خروش"
  },
  {
    "poem_id": 1910,
    "vorder": 12,
    "position": 1,
    "text": "دگرگونه‌تر کرد باید ز دوش"
  },
  {
    "poem_id": 1910,
    "vorder": 13,
    "position": 0,
    "text": "همه پاسبانان بنام قباد"
  },
  {
    "poem_id": 1910,
    "vorder": 14,
    "position": 1,
    "text": "همی‌کرد باید بهر پاس یاد"
  },
  {
    "poem_id": 1910,
    "vorder": 15,
    "position": 0,
    "text": "چنین داد پاسخ که ای دون کنم"
  },
  {
    "poem_id": 1910,
    "vorder": 16,
    "position": 1,
    "text": "ز سر نام پرویز بیرون کنم"
  },
  {
    "poem_id": 1910,
    "vorder": 17,
    "position": 0,
    "text": "چو شب چادر قیرگون کرد نو"
  },
  {
    "poem_id": 1910,
    "vorder": 18,
    "position": 1,
    "text": "ز شهر و ز بازار برخاست غو"
  },
  {
    "poem_id": 1910,
    "vorder": 19,
    "position": 0,
    "text": "همه پاسبانان بنام قباد"
  },
  {
    "poem_id": 1910,
    "vorder": 20,
    "position": 1,
    "text": "چو آواز دادند کردند یاد"
  },
  {
    "poem_id": 1910,
    "vorder": 21,
    "position": 0,
    "text": "شب تیره شاه جهان خفته بود"
  },
  {
    "poem_id": 1910,
    "vorder": 22,
    "position": 1,
    "text": "چو شیرین به بالینش بر جفته بود"
  },
  {
    "poem_id": 1910,
    "vorder": 23,
    "position": 0,
    "text": "چو آواز آن پاسبانان شنید"
  },
  {
    "poem_id": 1910,
    "vorder": 24,
    "position": 1,
    "text": "غمی گشت و زیشان دلش بردمید"
  },
  {
    "poem_id": 1910,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت شاها چه شاید بدن"
  },
  {
    "poem_id": 1910,
    "vorder": 26,
    "position": 1,
    "text": "برین داستانی بباید زدن"
  },
  {
    "poem_id": 1910,
    "vorder": 27,
    "position": 0,
    "text": "از آواز او شاه بیدار شد"
  },
  {
    "poem_id": 1910,
    "vorder": 28,
    "position": 1,
    "text": "دلش زان سخن پر ز آزار شد"
  },
  {
    "poem_id": 1910,
    "vorder": 29,
    "position": 0,
    "text": "به شیرین چنین گفت کای ماه روی"
  },
  {
    "poem_id": 1910,
    "vorder": 30,
    "position": 1,
    "text": "چه داری بخواب اندرون گفت وگوی"
  },
  {
    "poem_id": 1910,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت شیرین که بگشای گوش"
  },
  {
    "poem_id": 1910,
    "vorder": 32,
    "position": 1,
    "text": "خروشیدن پاسبانان نیوش"
  },
  {
    "poem_id": 1910,
    "vorder": 33,
    "position": 0,
    "text": "چو خسرو بدان گونه آوا شنید"
  },
  {
    "poem_id": 1910,
    "vorder": 34,
    "position": 1,
    "text": "به رخساره شد چون گل شنبلید"
  },
  {
    "poem_id": 1910,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت کز شب گذشته سه پاس"
  },
  {
    "poem_id": 1910,
    "vorder": 36,
    "position": 1,
    "text": "بیابید گفتار اخترشناس"
  },
  {
    "poem_id": 1910,
    "vorder": 37,
    "position": 0,
    "text": "که این بد گهر تا ز مادر بزاد"
  },
  {
    "poem_id": 1910,
    "vorder": 38,
    "position": 1,
    "text": "نهانی و را نام کردم قباد"
  },
  {
    "poem_id": 1910,
    "vorder": 39,
    "position": 0,
    "text": "به آواز شیرویه گفتم همی"
  },
  {
    "poem_id": 1910,
    "vorder": 40,
    "position": 1,
    "text": "دگر نامش اندر نهفتم همی"
  },
  {
    "poem_id": 1910,
    "vorder": 41,
    "position": 0,
    "text": "ورا نام شیروی بد آشکار"
  },
  {
    "poem_id": 1910,
    "vorder": 42,
    "position": 1,
    "text": "قبادش همی‌خواند این پیشکار"
  },
  {
    "poem_id": 1910,
    "vorder": 43,
    "position": 0,
    "text": "شب تیره باید شدن سوی چین"
  },
  {
    "poem_id": 1910,
    "vorder": 44,
    "position": 1,
    "text": "وگر سوی ما چین و مکران زمین"
  },
  {
    "poem_id": 1910,
    "vorder": 45,
    "position": 0,
    "text": "بریشان به افسون بگیریم راه"
  },
  {
    "poem_id": 1910,
    "vorder": 46,
    "position": 1,
    "text": "ز فغفور چینی بخواهم سپاه"
  },
  {
    "poem_id": 1910,
    "vorder": 47,
    "position": 0,
    "text": "ازان کاخترش به آسمان تیره بود"
  },
  {
    "poem_id": 1910,
    "vorder": 48,
    "position": 1,
    "text": "سخنهای او بر زمین خیره بود"
  },
  {
    "poem_id": 1910,
    "vorder": 49,
    "position": 0,
    "text": "شب تیره افسون نیامد به کار"
  },
  {
    "poem_id": 1910,
    "vorder": 50,
    "position": 1,
    "text": "همی‌آمدش کار دشوار خوار"
  },
  {
    "poem_id": 1910,
    "vorder": 51,
    "position": 0,
    "text": "به شیرین چنین گفت که آمد زمان"
  },
  {
    "poem_id": 1910,
    "vorder": 52,
    "position": 1,
    "text": "بر افسون ما چیره شد بدگمان"
  },
  {
    "poem_id": 1910,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت شیرین که نوشه بدی"
  },
  {
    "poem_id": 1910,
    "vorder": 54,
    "position": 1,
    "text": "همیشه ز تو دور دست بدی"
  },
  {
    "poem_id": 1910,
    "vorder": 55,
    "position": 0,
    "text": "بدانش کنون چارهٔ خویش ساز"
  },
  {
    "poem_id": 1910,
    "vorder": 56,
    "position": 1,
    "text": "مبادا که آید به دشمن نیاز"
  },
  {
    "poem_id": 1910,
    "vorder": 57,
    "position": 0,
    "text": "چو روشن شود دشمن چاره جوی"
  },
  {
    "poem_id": 1910,
    "vorder": 58,
    "position": 1,
    "text": "نهد بی‌گمان سوی این کاخ روی"
  },
  {
    "poem_id": 1910,
    "vorder": 59,
    "position": 0,
    "text": "هم آنگه زره خواست از گنج شاه"
  },
  {
    "poem_id": 1910,
    "vorder": 60,
    "position": 1,
    "text": "دو شمشیر هندی و رومی کلاه"
  },
  {
    "poem_id": 1910,
    "vorder": 61,
    "position": 0,
    "text": "همان ترکش تیرو زرین سپر"
  },
  {
    "poem_id": 1910,
    "vorder": 62,
    "position": 1,
    "text": "یکی بندهٔ گرد و پرخاشخر"
  },
  {
    "poem_id": 1910,
    "vorder": 63,
    "position": 0,
    "text": "شب تیره‌گون اندر آمد به باغ"
  },
  {
    "poem_id": 1910,
    "vorder": 64,
    "position": 1,
    "text": "بدان گه که برخیزد ازخواب زاغ"
  },
  {
    "poem_id": 1910,
    "vorder": 65,
    "position": 0,
    "text": "به باغ بزرگ اندر از بس درخت"
  },
  {
    "poem_id": 1910,
    "vorder": 66,
    "position": 1,
    "text": "نبد شاه را در چمن جای تخت"
  },
  {
    "poem_id": 1910,
    "vorder": 67,
    "position": 0,
    "text": "بیاویخت از شاخ زرین سپر"
  },
  {
    "poem_id": 1910,
    "vorder": 68,
    "position": 1,
    "text": "بجایی کزو دور بودی گذر"
  },
  {
    "poem_id": 1910,
    "vorder": 69,
    "position": 0,
    "text": "نشست از برنرگس و زعفران"
  },
  {
    "poem_id": 1910,
    "vorder": 70,
    "position": 1,
    "text": "یکی تیغ در زیر زانو گران"
  },
  {
    "poem_id": 1910,
    "vorder": 71,
    "position": 0,
    "text": "چو خورشید برزد سنان از فراز"
  },
  {
    "poem_id": 1910,
    "vorder": 72,
    "position": 1,
    "text": "سوی کاخ شد دشمن دیو ساز"
  },
  {
    "poem_id": 1910,
    "vorder": 73,
    "position": 0,
    "text": "یکایک بگشتند گرد سرای"
  },
  {
    "poem_id": 1910,
    "vorder": 74,
    "position": 1,
    "text": "تهی بد ز شاه سرافراز جای"
  },
  {
    "poem_id": 1910,
    "vorder": 75,
    "position": 0,
    "text": "به تاراج دادند گنج ورا"
  },
  {
    "poem_id": 1910,
    "vorder": 76,
    "position": 1,
    "text": "نکرد ایچ کس یاد رنج ورا"
  },
  {
    "poem_id": 1910,
    "vorder": 77,
    "position": 0,
    "text": "همه باز گشتنددیده پرآب"
  },
  {
    "poem_id": 1910,
    "vorder": 78,
    "position": 1,
    "text": "گرفته ز کار زمانه شتاب"
  },
  {
    "poem_id": 1910,
    "vorder": 79,
    "position": 0,
    "text": "چه جوییم ازین گنبد تیزگرد"
  },
  {
    "poem_id": 1910,
    "vorder": 80,
    "position": 1,
    "text": "که هرگز نیاساید از کارکرد"
  },
  {
    "poem_id": 1910,
    "vorder": 81,
    "position": 0,
    "text": "یک را همی تاج شاهی دهد"
  },
  {
    "poem_id": 1910,
    "vorder": 82,
    "position": 1,
    "text": "یکی رابه دریا به ماهی دهد"
  },
  {
    "poem_id": 1910,
    "vorder": 83,
    "position": 0,
    "text": "یکی را برهنه سر و پای و سفت"
  },
  {
    "poem_id": 1910,
    "vorder": 84,
    "position": 1,
    "text": "نه آرام و خورد و نه جای نهفت"
  },
  {
    "poem_id": 1910,
    "vorder": 85,
    "position": 0,
    "text": "یکی را دهد نوشه و شهد و شیر"
  },
  {
    "poem_id": 1910,
    "vorder": 86,
    "position": 1,
    "text": "بپوشد به دیبا و خز و حریر"
  },
  {
    "poem_id": 1910,
    "vorder": 87,
    "position": 0,
    "text": "سرانجام هردو به خاک اندرند"
  },
  {
    "poem_id": 1910,
    "vorder": 88,
    "position": 1,
    "text": "به تاریک دام هلاک اندرند"
  },
  {
    "poem_id": 1910,
    "vorder": 89,
    "position": 0,
    "text": "اگر خود نزادی خردمند مرد"
  },
  {
    "poem_id": 1910,
    "vorder": 90,
    "position": 1,
    "text": "نبودی ورا روز ننگ و نبرد"
  },
  {
    "poem_id": 1910,
    "vorder": 91,
    "position": 0,
    "text": "ندیدی جهان از بنه به بدی"
  },
  {
    "poem_id": 1910,
    "vorder": 92,
    "position": 1,
    "text": "اگر که بدی مرد اگر مه بدی"
  },
  {
    "poem_id": 1910,
    "vorder": 93,
    "position": 0,
    "text": "کنون رنج در کار خسرو بریم"
  },
  {
    "poem_id": 1910,
    "vorder": 94,
    "position": 1,
    "text": "بخواننده آگاهی نوبریم"
  }
]