[
  {
    "poem_id": 1593,
    "vorder": 1,
    "position": 0,
    "text": "چنین پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1593,
    "vorder": 2,
    "position": 1,
    "text": "که گفتار بیشی نیاید به کار"
  },
  {
    "poem_id": 1593,
    "vorder": 3,
    "position": 0,
    "text": "شکم گرسنه روز نیمی گذشت"
  },
  {
    "poem_id": 1593,
    "vorder": 4,
    "position": 1,
    "text": "ز گفتار پیکار بسیار گشت"
  },
  {
    "poem_id": 1593,
    "vorder": 5,
    "position": 0,
    "text": "بیارید چیزی که دارید خوان"
  },
  {
    "poem_id": 1593,
    "vorder": 6,
    "position": 1,
    "text": "کسی را که بسیار گوید مخوان"
  },
  {
    "poem_id": 1593,
    "vorder": 7,
    "position": 0,
    "text": "چو بنهاد رستم به خوردن گرفت"
  },
  {
    "poem_id": 1593,
    "vorder": 8,
    "position": 1,
    "text": "بماند اندر آن خوردن اندر شگفت"
  },
  {
    "poem_id": 1593,
    "vorder": 9,
    "position": 0,
    "text": "یل اسفندیار و گوان یکسره"
  },
  {
    "poem_id": 1593,
    "vorder": 10,
    "position": 1,
    "text": "ز هر سو نهادند پیشش بره"
  },
  {
    "poem_id": 1593,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود مهتر که جام آورید"
  },
  {
    "poem_id": 1593,
    "vorder": 12,
    "position": 1,
    "text": "به جای می پخته خام آورید"
  },
  {
    "poem_id": 1593,
    "vorder": 13,
    "position": 0,
    "text": "ببینیم تا رستم اکنون ز می"
  },
  {
    "poem_id": 1593,
    "vorder": 14,
    "position": 1,
    "text": "چه گوید چه آرد ز کاوس کی"
  },
  {
    "poem_id": 1593,
    "vorder": 15,
    "position": 0,
    "text": "بیاورد یک جام می میگسار"
  },
  {
    "poem_id": 1593,
    "vorder": 16,
    "position": 1,
    "text": "که کشتی بکردی بروبر گذار"
  },
  {
    "poem_id": 1593,
    "vorder": 17,
    "position": 0,
    "text": "به یاد شهنشاه رستم بخورد"
  },
  {
    "poem_id": 1593,
    "vorder": 18,
    "position": 1,
    "text": "برآورد ازان چشمهٔ زرد گرد"
  },
  {
    "poem_id": 1593,
    "vorder": 19,
    "position": 0,
    "text": "همان جام را کودک میگسار"
  },
  {
    "poem_id": 1593,
    "vorder": 20,
    "position": 1,
    "text": "بیاورد پر بادهٔ شاهوار"
  },
  {
    "poem_id": 1593,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت پس با پشوتن به راز"
  },
  {
    "poem_id": 1593,
    "vorder": 22,
    "position": 1,
    "text": "که بر می نیاید به آبت نیاز"
  },
  {
    "poem_id": 1593,
    "vorder": 23,
    "position": 0,
    "text": "چرا آب بر جام می بفگنی"
  },
  {
    "poem_id": 1593,
    "vorder": 24,
    "position": 1,
    "text": "که تیزی نبید کهن بشکنی"
  },
  {
    "poem_id": 1593,
    "vorder": 25,
    "position": 0,
    "text": "پشوتن چنین گفت با میگسار"
  },
  {
    "poem_id": 1593,
    "vorder": 26,
    "position": 1,
    "text": "که بی‌آب جامی می افگن بیار"
  },
  {
    "poem_id": 1593,
    "vorder": 27,
    "position": 0,
    "text": "می آورد و رامشگران را بخواند"
  },
  {
    "poem_id": 1593,
    "vorder": 28,
    "position": 1,
    "text": "ز رستم همی در شگفتی بماند"
  },
  {
    "poem_id": 1593,
    "vorder": 29,
    "position": 0,
    "text": "چو هنگامهٔ رفتن آمد فراز"
  },
  {
    "poem_id": 1593,
    "vorder": 30,
    "position": 1,
    "text": "ز می لعل شد رستم سرفراز"
  },
  {
    "poem_id": 1593,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت با او یل اسفندیار"
  },
  {
    "poem_id": 1593,
    "vorder": 32,
    "position": 1,
    "text": "که شادان بدی تا بود روزگار"
  },
  {
    "poem_id": 1593,
    "vorder": 33,
    "position": 0,
    "text": "می و هرچ خوردی ترا نوش باد"
  },
  {
    "poem_id": 1593,
    "vorder": 34,
    "position": 1,
    "text": "روان دلاور پر از توش باد"
  },
  {
    "poem_id": 1593,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت رستم که ای نامدار"
  },
  {
    "poem_id": 1593,
    "vorder": 36,
    "position": 1,
    "text": "همیشه خرد بادت آموزگار"
  },
  {
    "poem_id": 1593,
    "vorder": 37,
    "position": 0,
    "text": "هران می که با تو خورم نوش گشت"
  },
  {
    "poem_id": 1593,
    "vorder": 38,
    "position": 1,
    "text": "روان خردمند را توش گشت"
  },
  {
    "poem_id": 1593,
    "vorder": 39,
    "position": 0,
    "text": "گر این کینه از مغز بیرون کنی"
  },
  {
    "poem_id": 1593,
    "vorder": 40,
    "position": 1,
    "text": "بزرگی و دانش برافزون کنی"
  },
  {
    "poem_id": 1593,
    "vorder": 41,
    "position": 0,
    "text": "ز دشت اندرآیی سوی خان من"
  },
  {
    "poem_id": 1593,
    "vorder": 42,
    "position": 1,
    "text": "بوی شاد یک چند مهمان من"
  },
  {
    "poem_id": 1593,
    "vorder": 43,
    "position": 0,
    "text": "سخن هرچ گفتم بجای آورم"
  },
  {
    "poem_id": 1593,
    "vorder": 44,
    "position": 1,
    "text": "خرد پیش تو رهنمای آورم"
  },
  {
    "poem_id": 1593,
    "vorder": 45,
    "position": 0,
    "text": "بیاسای چندی و با بد مکوش"
  },
  {
    "poem_id": 1593,
    "vorder": 46,
    "position": 1,
    "text": "سوی مردمی یاز و بازآر هوش"
  },
  {
    "poem_id": 1593,
    "vorder": 47,
    "position": 0,
    "text": "چنین گفت با او یل اسفندیار"
  },
  {
    "poem_id": 1593,
    "vorder": 48,
    "position": 1,
    "text": "که تخمی که هرگز نروید مکار"
  },
  {
    "poem_id": 1593,
    "vorder": 49,
    "position": 0,
    "text": "تو فردا ببینی ز مردان هنر"
  },
  {
    "poem_id": 1593,
    "vorder": 50,
    "position": 1,
    "text": "چو من تاختن را ببندم کمر"
  },
  {
    "poem_id": 1593,
    "vorder": 51,
    "position": 0,
    "text": "تن خویش را نیز مستای هیچ"
  },
  {
    "poem_id": 1593,
    "vorder": 52,
    "position": 1,
    "text": "به ایوان شو و کار فردا بسیچ"
  },
  {
    "poem_id": 1593,
    "vorder": 53,
    "position": 0,
    "text": "ببینی که من در صف کارزار"
  },
  {
    "poem_id": 1593,
    "vorder": 54,
    "position": 1,
    "text": "چنانم چو با باده و میگسار"
  },
  {
    "poem_id": 1593,
    "vorder": 55,
    "position": 0,
    "text": "چو از شهر زاول به ایران شوم"
  },
  {
    "poem_id": 1593,
    "vorder": 56,
    "position": 1,
    "text": "به نزدیک شاه و دلیران شوم"
  },
  {
    "poem_id": 1593,
    "vorder": 57,
    "position": 0,
    "text": "هنر بیش بینی ز گفتار من"
  },
  {
    "poem_id": 1593,
    "vorder": 58,
    "position": 1,
    "text": "مجوی اندرین کار تیمار من"
  },
  {
    "poem_id": 1593,
    "vorder": 59,
    "position": 0,
    "text": "دل رستم از غم پراندیشه شد"
  },
  {
    "poem_id": 1593,
    "vorder": 60,
    "position": 1,
    "text": "جهان پیش او چون یکی بیشه شد"
  },
  {
    "poem_id": 1593,
    "vorder": 61,
    "position": 0,
    "text": "که گر من دهم دست بند ورا"
  },
  {
    "poem_id": 1593,
    "vorder": 62,
    "position": 1,
    "text": "وگر سر فرازم گزند ورا"
  },
  {
    "poem_id": 1593,
    "vorder": 63,
    "position": 0,
    "text": "دو کارست هر دو به نفرین و بد"
  },
  {
    "poem_id": 1593,
    "vorder": 64,
    "position": 1,
    "text": "گزاینده رسمی نو آیین و بد"
  },
  {
    "poem_id": 1593,
    "vorder": 65,
    "position": 0,
    "text": "هم از بند او بد شود نام من"
  },
  {
    "poem_id": 1593,
    "vorder": 66,
    "position": 1,
    "text": "بد آید ز گشتاسپ انجام من"
  },
  {
    "poem_id": 1593,
    "vorder": 67,
    "position": 0,
    "text": "به گرد جهان هرک راند سخن"
  },
  {
    "poem_id": 1593,
    "vorder": 68,
    "position": 1,
    "text": "نکوهیدن من نگردد کهن"
  },
  {
    "poem_id": 1593,
    "vorder": 69,
    "position": 0,
    "text": "که رستم ز دست جوانی بخست"
  },
  {
    "poem_id": 1593,
    "vorder": 70,
    "position": 1,
    "text": "به زاول شد و دست او را ببست"
  },
  {
    "poem_id": 1593,
    "vorder": 71,
    "position": 0,
    "text": "همان نام من بازگردد به ننگ"
  },
  {
    "poem_id": 1593,
    "vorder": 72,
    "position": 1,
    "text": "نماند ز من در جهان بوی و رنگ"
  },
  {
    "poem_id": 1593,
    "vorder": 73,
    "position": 0,
    "text": "وگر کشته آید به دشت نبرد"
  },
  {
    "poem_id": 1593,
    "vorder": 74,
    "position": 1,
    "text": "شود نزد شاهان مرا روی زرد"
  },
  {
    "poem_id": 1593,
    "vorder": 75,
    "position": 0,
    "text": "که او شهریاری جوان را بکشت"
  },
  {
    "poem_id": 1593,
    "vorder": 76,
    "position": 1,
    "text": "بدان کو سخن گفت با او درشت"
  },
  {
    "poem_id": 1593,
    "vorder": 77,
    "position": 0,
    "text": "برین بر پس از مرگ نفرین بود"
  },
  {
    "poem_id": 1593,
    "vorder": 78,
    "position": 1,
    "text": "همان نام من نیز بی‌دین بود"
  },
  {
    "poem_id": 1593,
    "vorder": 79,
    "position": 0,
    "text": "وگر من شوم کشته بر دست اوی"
  },
  {
    "poem_id": 1593,
    "vorder": 80,
    "position": 1,
    "text": "نماند به زاولستان رنگ و بوی"
  },
  {
    "poem_id": 1593,
    "vorder": 81,
    "position": 0,
    "text": "شکسته شود نام دستان سام"
  },
  {
    "poem_id": 1593,
    "vorder": 82,
    "position": 1,
    "text": "ز زابل نگیرد کسی نیز نام"
  },
  {
    "poem_id": 1593,
    "vorder": 83,
    "position": 0,
    "text": "ولیکن همی خوب گفتار من"
  },
  {
    "poem_id": 1593,
    "vorder": 84,
    "position": 1,
    "text": "ازین پس بگویند بر انجمن"
  },
  {
    "poem_id": 1593,
    "vorder": 85,
    "position": 0,
    "text": "چنین گفت پس با سرافراز مرد"
  },
  {
    "poem_id": 1593,
    "vorder": 86,
    "position": 1,
    "text": "که اندیشه روی مرا زرد کرد"
  },
  {
    "poem_id": 1593,
    "vorder": 87,
    "position": 0,
    "text": "که چندین بگویی تو از کار بند"
  },
  {
    "poem_id": 1593,
    "vorder": 88,
    "position": 1,
    "text": "مرا بند و رای تو آید گزند"
  },
  {
    "poem_id": 1593,
    "vorder": 89,
    "position": 0,
    "text": "مگر کاسمانی سخن دیگرست"
  },
  {
    "poem_id": 1593,
    "vorder": 90,
    "position": 1,
    "text": "که چرخ روان از گمان برترست"
  },
  {
    "poem_id": 1593,
    "vorder": 91,
    "position": 0,
    "text": "همه پند دیوان پذیری همی"
  },
  {
    "poem_id": 1593,
    "vorder": 92,
    "position": 1,
    "text": "ز دانش سخن برنگیری همی"
  },
  {
    "poem_id": 1593,
    "vorder": 93,
    "position": 0,
    "text": "ترا سال برنامد از روزگار"
  },
  {
    "poem_id": 1593,
    "vorder": 94,
    "position": 1,
    "text": "ندانی فریب بد شهریار"
  },
  {
    "poem_id": 1593,
    "vorder": 95,
    "position": 0,
    "text": "تو یکتادلی و ندیده‌جهان"
  },
  {
    "poem_id": 1593,
    "vorder": 96,
    "position": 1,
    "text": "جهانبان به مرگ تو کوشد نهان"
  },
  {
    "poem_id": 1593,
    "vorder": 97,
    "position": 0,
    "text": "گر ایدونک گشتاسپ از روی بخت"
  },
  {
    "poem_id": 1593,
    "vorder": 98,
    "position": 1,
    "text": "نیابد همی سیری از تاج و تخت"
  },
  {
    "poem_id": 1593,
    "vorder": 99,
    "position": 0,
    "text": "به گرد جهان بر دواند ترا"
  },
  {
    "poem_id": 1593,
    "vorder": 100,
    "position": 1,
    "text": "بهر سختئی پروراند ترا"
  },
  {
    "poem_id": 1593,
    "vorder": 101,
    "position": 0,
    "text": "به روی زمین یکسر اندیشه کرد"
  },
  {
    "poem_id": 1593,
    "vorder": 102,
    "position": 1,
    "text": "خرد چون تبر هوش چون تیشه کرد"
  },
  {
    "poem_id": 1593,
    "vorder": 103,
    "position": 0,
    "text": "که تا کیست اندر جهان نامدار"
  },
  {
    "poem_id": 1593,
    "vorder": 104,
    "position": 1,
    "text": "کجا سر نپیچاند از کارزار"
  },
  {
    "poem_id": 1593,
    "vorder": 105,
    "position": 0,
    "text": "کزان نامور بر تو آید گزند"
  },
  {
    "poem_id": 1593,
    "vorder": 106,
    "position": 1,
    "text": "بماند بدو تاج و تخت بلند"
  },
  {
    "poem_id": 1593,
    "vorder": 107,
    "position": 0,
    "text": "که شاید که بر تاج نفرین کنیم"
  },
  {
    "poem_id": 1593,
    "vorder": 108,
    "position": 1,
    "text": "وزین داستان خاک بالین کنیم"
  },
  {
    "poem_id": 1593,
    "vorder": 109,
    "position": 0,
    "text": "همی جان من در نکوهش کنی"
  },
  {
    "poem_id": 1593,
    "vorder": 110,
    "position": 1,
    "text": "چرا دل نه اندر پژوهش کنی"
  },
  {
    "poem_id": 1593,
    "vorder": 111,
    "position": 0,
    "text": "به تن رنج کاری تو بر دست خویش"
  },
  {
    "poem_id": 1593,
    "vorder": 112,
    "position": 1,
    "text": "جز از بدگمانی نیایدت پیش"
  },
  {
    "poem_id": 1593,
    "vorder": 113,
    "position": 0,
    "text": "مکن شهریارا جوانی مکن"
  },
  {
    "poem_id": 1593,
    "vorder": 114,
    "position": 1,
    "text": "چنین بر بلا کامرانی مکن"
  },
  {
    "poem_id": 1593,
    "vorder": 115,
    "position": 0,
    "text": "دل ما مکن شهریارا نژند"
  },
  {
    "poem_id": 1593,
    "vorder": 116,
    "position": 1,
    "text": "میاور به جان خود و من گزند"
  },
  {
    "poem_id": 1593,
    "vorder": 117,
    "position": 0,
    "text": "ز یزدان و از روی من شرم‌دار"
  },
  {
    "poem_id": 1593,
    "vorder": 118,
    "position": 1,
    "text": "مخور بر تن خویشتن زینهار"
  },
  {
    "poem_id": 1593,
    "vorder": 119,
    "position": 0,
    "text": "ترا بی‌نیازیست از جنگ من"
  },
  {
    "poem_id": 1593,
    "vorder": 120,
    "position": 1,
    "text": "وزین کوشش و کردن آهنگ من"
  },
  {
    "poem_id": 1593,
    "vorder": 121,
    "position": 0,
    "text": "زمانه همی تاختت با سپاه"
  },
  {
    "poem_id": 1593,
    "vorder": 122,
    "position": 1,
    "text": "که بر دست من گشت خواهی تباه"
  },
  {
    "poem_id": 1593,
    "vorder": 123,
    "position": 0,
    "text": "بماند به گیتی ز من نام بد"
  },
  {
    "poem_id": 1593,
    "vorder": 124,
    "position": 1,
    "text": "به گشتاسپ بادا سرانجام بد"
  },
  {
    "poem_id": 1593,
    "vorder": 125,
    "position": 0,
    "text": "چو بشنید گردنکش اسفندیار"
  },
  {
    "poem_id": 1593,
    "vorder": 126,
    "position": 1,
    "text": "بدو گفت کای رستم نامدار"
  },
  {
    "poem_id": 1593,
    "vorder": 127,
    "position": 0,
    "text": "به دانای پیشی نگر تا چه گفت"
  },
  {
    "poem_id": 1593,
    "vorder": 128,
    "position": 1,
    "text": "بدانگه که جان با خرد کرد جفت"
  },
  {
    "poem_id": 1593,
    "vorder": 129,
    "position": 0,
    "text": "که پیر فریبنده کانا بود"
  },
  {
    "poem_id": 1593,
    "vorder": 130,
    "position": 1,
    "text": "وگر چند پیروز و دانا بود"
  },
  {
    "poem_id": 1593,
    "vorder": 131,
    "position": 0,
    "text": "تو چندین همی بر من افسون کنی"
  },
  {
    "poem_id": 1593,
    "vorder": 132,
    "position": 1,
    "text": "که تا چنبر از یال بیرون کنی"
  },
  {
    "poem_id": 1593,
    "vorder": 133,
    "position": 0,
    "text": "تو خواهی که هرکس که این بشنود"
  },
  {
    "poem_id": 1593,
    "vorder": 134,
    "position": 1,
    "text": "بدین خوب گفتار تو بگرود"
  },
  {
    "poem_id": 1593,
    "vorder": 135,
    "position": 0,
    "text": "مرا پاک خوانند ناپاک رای"
  },
  {
    "poem_id": 1593,
    "vorder": 136,
    "position": 1,
    "text": "ترا مرد هشیار نیکی‌فزای"
  },
  {
    "poem_id": 1593,
    "vorder": 137,
    "position": 0,
    "text": "بگویند کو با خرام و نوید"
  },
  {
    "poem_id": 1593,
    "vorder": 138,
    "position": 1,
    "text": "بیامد ورا کرد چندی امید"
  },
  {
    "poem_id": 1593,
    "vorder": 139,
    "position": 0,
    "text": "سپهبد ز گفتار او سر بتافت"
  },
  {
    "poem_id": 1593,
    "vorder": 140,
    "position": 1,
    "text": "ازان پس که جز جنگ کاری نیافت"
  },
  {
    "poem_id": 1593,
    "vorder": 141,
    "position": 0,
    "text": "همی خواهش او همه خوار داشت"
  },
  {
    "poem_id": 1593,
    "vorder": 142,
    "position": 1,
    "text": "زبانی پر از تلخ گفتار داشت"
  },
  {
    "poem_id": 1593,
    "vorder": 143,
    "position": 0,
    "text": "بدانی که من سر ز فرمان شاه"
  },
  {
    "poem_id": 1593,
    "vorder": 144,
    "position": 1,
    "text": "نتابم نه از بهر تخت و کلاه"
  },
  {
    "poem_id": 1593,
    "vorder": 145,
    "position": 0,
    "text": "بدو یابم اندر جهان خوب و زشت"
  },
  {
    "poem_id": 1593,
    "vorder": 146,
    "position": 1,
    "text": "بدویست دوزخ بدو هم بهشت"
  },
  {
    "poem_id": 1593,
    "vorder": 147,
    "position": 0,
    "text": "ترا هرچ خوردی فزاینده باد"
  },
  {
    "poem_id": 1593,
    "vorder": 148,
    "position": 1,
    "text": "بداندیشگان را گزاینده باد"
  },
  {
    "poem_id": 1593,
    "vorder": 149,
    "position": 0,
    "text": "تو اکنون به خوبی به ایوان بپوی"
  },
  {
    "poem_id": 1593,
    "vorder": 150,
    "position": 1,
    "text": "سخن هرچ دیدی به دستان بگوی"
  },
  {
    "poem_id": 1593,
    "vorder": 151,
    "position": 0,
    "text": "سلیحت همه جنگ را ساز کن"
  },
  {
    "poem_id": 1593,
    "vorder": 152,
    "position": 1,
    "text": "ازین پس مپیمای با من سخن"
  },
  {
    "poem_id": 1593,
    "vorder": 153,
    "position": 0,
    "text": "پگاه آی در جنگ من چاره‌ساز"
  },
  {
    "poem_id": 1593,
    "vorder": 154,
    "position": 1,
    "text": "مکن زین سپس کار بر خود دراز"
  },
  {
    "poem_id": 1593,
    "vorder": 155,
    "position": 0,
    "text": "تو فردا ببینی به آوردگاه"
  },
  {
    "poem_id": 1593,
    "vorder": 156,
    "position": 1,
    "text": "که گیتی شود پیش چشمت سیاه"
  },
  {
    "poem_id": 1593,
    "vorder": 157,
    "position": 0,
    "text": "بدانی که پیکار مردان مرد"
  },
  {
    "poem_id": 1593,
    "vorder": 158,
    "position": 1,
    "text": "چگونه بود روز جنگ و نبرد"
  },
  {
    "poem_id": 1593,
    "vorder": 159,
    "position": 0,
    "text": "بدو گفت رستم که ای شیرخوی"
  },
  {
    "poem_id": 1593,
    "vorder": 160,
    "position": 1,
    "text": "ترا گر چنین آمدست آرزوی"
  },
  {
    "poem_id": 1593,
    "vorder": 161,
    "position": 0,
    "text": "ترا بر تگ رخش مهمان کنم"
  },
  {
    "poem_id": 1593,
    "vorder": 162,
    "position": 1,
    "text": "سرت را به گوپال درمان کنم"
  },
  {
    "poem_id": 1593,
    "vorder": 163,
    "position": 0,
    "text": "تو در پهلوی خویش بشنیده‌ای"
  },
  {
    "poem_id": 1593,
    "vorder": 164,
    "position": 1,
    "text": "به گفتار ایشان بگرویده‌ای"
  },
  {
    "poem_id": 1593,
    "vorder": 165,
    "position": 0,
    "text": "که تیغ دلیران بر اسفندیار"
  },
  {
    "poem_id": 1593,
    "vorder": 166,
    "position": 1,
    "text": "به آوردگه بر، نیاید به کار"
  },
  {
    "poem_id": 1593,
    "vorder": 167,
    "position": 0,
    "text": "ببینی تو فردا سنان مرا"
  },
  {
    "poem_id": 1593,
    "vorder": 168,
    "position": 1,
    "text": "همان گرد کرده عنان مرا"
  },
  {
    "poem_id": 1593,
    "vorder": 169,
    "position": 0,
    "text": "که تا نیز با نامداران مرد"
  },
  {
    "poem_id": 1593,
    "vorder": 170,
    "position": 1,
    "text": "به خویی به آوردگه بر، نبرد"
  },
  {
    "poem_id": 1593,
    "vorder": 171,
    "position": 0,
    "text": "لب مرد برنا پر از خنده شد"
  },
  {
    "poem_id": 1593,
    "vorder": 172,
    "position": 1,
    "text": "همی گوهر آن خنده را بنده شد"
  },
  {
    "poem_id": 1593,
    "vorder": 173,
    "position": 0,
    "text": "به رستم چنین گفت کای نامجوی"
  },
  {
    "poem_id": 1593,
    "vorder": 174,
    "position": 1,
    "text": "چرا تیز گشتی بدین گفت و گوی"
  },
  {
    "poem_id": 1593,
    "vorder": 175,
    "position": 0,
    "text": "چو فردا بیابی به دشت نبرد"
  },
  {
    "poem_id": 1593,
    "vorder": 176,
    "position": 1,
    "text": "ببینی تو آورد مردان مرد"
  },
  {
    "poem_id": 1593,
    "vorder": 177,
    "position": 0,
    "text": "نه من کوهم و زیرم اسپی چوکوه"
  },
  {
    "poem_id": 1593,
    "vorder": 178,
    "position": 1,
    "text": "یگانه یکی مردمم چون گروه"
  },
  {
    "poem_id": 1593,
    "vorder": 179,
    "position": 0,
    "text": "گر از گرز من باد یابد سرت"
  },
  {
    "poem_id": 1593,
    "vorder": 180,
    "position": 1,
    "text": "بگرید به درد جگر مادرت"
  },
  {
    "poem_id": 1593,
    "vorder": 181,
    "position": 0,
    "text": "وگر کشته آیی به آوردگاه"
  },
  {
    "poem_id": 1593,
    "vorder": 182,
    "position": 1,
    "text": "ببندمت بر زین برم نزد شاه"
  },
  {
    "poem_id": 1593,
    "vorder": 183,
    "position": 0,
    "text": "بدان تا دگر بنده با شهریار"
  },
  {
    "poem_id": 1593,
    "vorder": 184,
    "position": 1,
    "text": "نجوید به آوردگه کارزار"
  }
]