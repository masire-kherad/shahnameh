[
  {
    "poem_id": 1784,
    "vorder": 1,
    "position": 0,
    "text": "بخفت آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1784,
    "vorder": 2,
    "position": 1,
    "text": "بیامد سوی دشت نخچیرگاه"
  },
  {
    "poem_id": 1784,
    "vorder": 3,
    "position": 0,
    "text": "همه راه و بی‌راه لشکر گذشت"
  },
  {
    "poem_id": 1784,
    "vorder": 4,
    "position": 1,
    "text": "چنان شد که یک ماه ماند او به دشت"
  },
  {
    "poem_id": 1784,
    "vorder": 5,
    "position": 0,
    "text": "سراپرده و خیمه‌ها ساختند"
  },
  {
    "poem_id": 1784,
    "vorder": 6,
    "position": 1,
    "text": "ز نخچیر دشتی بپرداختند"
  },
  {
    "poem_id": 1784,
    "vorder": 7,
    "position": 0,
    "text": "کسی را نیامد بران دشت خواب"
  },
  {
    "poem_id": 1784,
    "vorder": 8,
    "position": 1,
    "text": "می و گوشت نخچیر و چنگ و رباب"
  },
  {
    "poem_id": 1784,
    "vorder": 9,
    "position": 0,
    "text": "بیابان همی آتش افروختند"
  },
  {
    "poem_id": 1784,
    "vorder": 10,
    "position": 1,
    "text": "تر و خشک هیزم بسی سوختند"
  },
  {
    "poem_id": 1784,
    "vorder": 11,
    "position": 0,
    "text": "برفتند بسیار مردم ز شهر"
  },
  {
    "poem_id": 1784,
    "vorder": 12,
    "position": 1,
    "text": "کسی کش ز دینار بایست بهر"
  },
  {
    "poem_id": 1784,
    "vorder": 13,
    "position": 0,
    "text": "همی بود چندی خرید و فروخت"
  },
  {
    "poem_id": 1784,
    "vorder": 14,
    "position": 1,
    "text": "بیابان ز لشکر همی برفروخت"
  },
  {
    "poem_id": 1784,
    "vorder": 15,
    "position": 0,
    "text": "ز نخچیر دشت و ز مرغان آب"
  },
  {
    "poem_id": 1784,
    "vorder": 16,
    "position": 1,
    "text": "همی یافت خواهنده چندان کباب"
  },
  {
    "poem_id": 1784,
    "vorder": 17,
    "position": 0,
    "text": "که بردی به خروار تا خان خویش"
  },
  {
    "poem_id": 1784,
    "vorder": 18,
    "position": 1,
    "text": "بر کودک خرد و مهمان خویش"
  },
  {
    "poem_id": 1784,
    "vorder": 19,
    "position": 0,
    "text": "چو ماهی برآمد شتاب آمدش"
  },
  {
    "poem_id": 1784,
    "vorder": 20,
    "position": 1,
    "text": "همی با بتان رای خواب آمدش"
  },
  {
    "poem_id": 1784,
    "vorder": 21,
    "position": 0,
    "text": "بیاورد لشکر ز نخچیرگاه"
  },
  {
    "poem_id": 1784,
    "vorder": 22,
    "position": 1,
    "text": "ز گرد سواران ندیدند راه"
  },
  {
    "poem_id": 1784,
    "vorder": 23,
    "position": 0,
    "text": "همی رفت لشکر به کردار گرد"
  },
  {
    "poem_id": 1784,
    "vorder": 24,
    "position": 1,
    "text": "چنین تا رخ روز شد لاژورد"
  },
  {
    "poem_id": 1784,
    "vorder": 25,
    "position": 0,
    "text": "یکی شارستان پیشش آمد به راه"
  },
  {
    "poem_id": 1784,
    "vorder": 26,
    "position": 1,
    "text": "پر از برزن و کوی و بازارگاه"
  },
  {
    "poem_id": 1784,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود تا لشکرش با بنه"
  },
  {
    "poem_id": 1784,
    "vorder": 28,
    "position": 1,
    "text": "گذارند و ماند خود او یک تنه"
  },
  {
    "poem_id": 1784,
    "vorder": 29,
    "position": 0,
    "text": "بپرسید تا مهتر ده کجاست"
  },
  {
    "poem_id": 1784,
    "vorder": 30,
    "position": 1,
    "text": "سر اندر کشید و همی رفت راست"
  },
  {
    "poem_id": 1784,
    "vorder": 31,
    "position": 0,
    "text": "شکسته دری دید پهن و دراز"
  },
  {
    "poem_id": 1784,
    "vorder": 32,
    "position": 1,
    "text": "بیامد خداوند و بردش نماز"
  },
  {
    "poem_id": 1784,
    "vorder": 33,
    "position": 0,
    "text": "بپرسید کاین خانه ویران کراست"
  },
  {
    "poem_id": 1784,
    "vorder": 34,
    "position": 1,
    "text": "میان ده این جای ویران چراست"
  },
  {
    "poem_id": 1784,
    "vorder": 35,
    "position": 0,
    "text": "خداوند گفت این سرای منست"
  },
  {
    "poem_id": 1784,
    "vorder": 36,
    "position": 1,
    "text": "همین بخت بد رهنمای منست"
  },
  {
    "poem_id": 1784,
    "vorder": 37,
    "position": 0,
    "text": "نه گاو ستم ایدر نه پوشش نه خر"
  },
  {
    "poem_id": 1784,
    "vorder": 38,
    "position": 1,
    "text": "نه دانش نه مردی نه پای و نه پر"
  },
  {
    "poem_id": 1784,
    "vorder": 39,
    "position": 0,
    "text": "مرا دیدی اکنون سرایم ببین"
  },
  {
    "poem_id": 1784,
    "vorder": 40,
    "position": 1,
    "text": "بدین خانه نفرین به از آفرین"
  },
  {
    "poem_id": 1784,
    "vorder": 41,
    "position": 0,
    "text": "ز اسپ اندر آمد بدید آن سرای"
  },
  {
    "poem_id": 1784,
    "vorder": 42,
    "position": 1,
    "text": "جهاندار را سست شد دست و پای"
  },
  {
    "poem_id": 1784,
    "vorder": 43,
    "position": 0,
    "text": "همه خانه سرگین بد از گوسفند"
  },
  {
    "poem_id": 1784,
    "vorder": 44,
    "position": 1,
    "text": "یکی طاق بر پای و جای بلند"
  },
  {
    "poem_id": 1784,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت چیزی ز بهر نشست"
  },
  {
    "poem_id": 1784,
    "vorder": 46,
    "position": 1,
    "text": "فراز آور ای مرد مهمان‌پرست"
  },
  {
    "poem_id": 1784,
    "vorder": 47,
    "position": 0,
    "text": "چنین داد پاسخ که بر میزبان"
  },
  {
    "poem_id": 1784,
    "vorder": 48,
    "position": 1,
    "text": "به خیره چرا خندی ای مرزبان"
  },
  {
    "poem_id": 1784,
    "vorder": 49,
    "position": 0,
    "text": "گر افگندنی هیچ بودی مرا"
  },
  {
    "poem_id": 1784,
    "vorder": 50,
    "position": 1,
    "text": "مگر مرد مهمان ستودی مرا"
  },
  {
    "poem_id": 1784,
    "vorder": 51,
    "position": 0,
    "text": "نه افگندنی هست و نه خوردنی"
  },
  {
    "poem_id": 1784,
    "vorder": 52,
    "position": 1,
    "text": "نه پوشیدنی و نه گستردنی"
  },
  {
    "poem_id": 1784,
    "vorder": 53,
    "position": 0,
    "text": "به جای دگر خانه جویی رواست"
  },
  {
    "poem_id": 1784,
    "vorder": 54,
    "position": 1,
    "text": "که ایدر همه کارها بی‌نواست"
  },
  {
    "poem_id": 1784,
    "vorder": 55,
    "position": 0,
    "text": "ورا گفت بالش نگه کن یکی"
  },
  {
    "poem_id": 1784,
    "vorder": 56,
    "position": 1,
    "text": "که تا برنشینم برو اندکی"
  },
  {
    "poem_id": 1784,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت ایدر نه جای نکوست"
  },
  {
    "poem_id": 1784,
    "vorder": 58,
    "position": 1,
    "text": "همانا ترا شیر مرغ آرزوست"
  },
  {
    "poem_id": 1784,
    "vorder": 59,
    "position": 0,
    "text": "پس‌انگاه گفتش که شیر آر گرم"
  },
  {
    "poem_id": 1784,
    "vorder": 60,
    "position": 1,
    "text": "چنان چون بیابی یکی نان نرم"
  },
  {
    "poem_id": 1784,
    "vorder": 61,
    "position": 0,
    "text": "چنین داد پاسخ که ایدو گمان"
  },
  {
    "poem_id": 1784,
    "vorder": 62,
    "position": 1,
    "text": "که خوردی و گشتی ازو شادمان"
  },
  {
    "poem_id": 1784,
    "vorder": 63,
    "position": 0,
    "text": "اگر نان بدی در تنم جان بدی"
  },
  {
    "poem_id": 1784,
    "vorder": 64,
    "position": 1,
    "text": "اگر چند جانم به از نان بدی"
  },
  {
    "poem_id": 1784,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت گر نیستت گوسفند"
  },
  {
    "poem_id": 1784,
    "vorder": 66,
    "position": 1,
    "text": "که آمد به خان تو سرگین فگند"
  },
  {
    "poem_id": 1784,
    "vorder": 67,
    "position": 0,
    "text": "چنین داد پاسخ که شب تیره شد"
  },
  {
    "poem_id": 1784,
    "vorder": 68,
    "position": 1,
    "text": "مرا سر ز گفتار تو خیره شد"
  },
  {
    "poem_id": 1784,
    "vorder": 69,
    "position": 0,
    "text": "یکی خانه بگزین که یابی پلاس"
  },
  {
    "poem_id": 1784,
    "vorder": 70,
    "position": 1,
    "text": "خداوند آن خانه دارد سپاس"
  },
  {
    "poem_id": 1784,
    "vorder": 71,
    "position": 0,
    "text": "چه باشی به نزدیکی شوربخت"
  },
  {
    "poem_id": 1784,
    "vorder": 72,
    "position": 1,
    "text": "که بستر کند شب ز برگ درخت"
  },
  {
    "poem_id": 1784,
    "vorder": 73,
    "position": 0,
    "text": "به زر تیغ داری به زربر رکیب"
  },
  {
    "poem_id": 1784,
    "vorder": 74,
    "position": 1,
    "text": "نباید که آید ز دزدت نهیب"
  },
  {
    "poem_id": 1784,
    "vorder": 75,
    "position": 0,
    "text": "ز یزدان بترس و ز من دور باش"
  },
  {
    "poem_id": 1784,
    "vorder": 76,
    "position": 1,
    "text": "به هر کار چون من تو رنجور باش"
  },
  {
    "poem_id": 1784,
    "vorder": 77,
    "position": 0,
    "text": "چو خانه برین‌گونه ویران بود"
  },
  {
    "poem_id": 1784,
    "vorder": 78,
    "position": 1,
    "text": "گذرگاه دزدان و شیران بود"
  },
  {
    "poem_id": 1784,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت اگر دزد شمشیر من"
  },
  {
    "poem_id": 1784,
    "vorder": 80,
    "position": 1,
    "text": "ببردی کنون نیستی زیر من"
  },
  {
    "poem_id": 1784,
    "vorder": 81,
    "position": 0,
    "text": "کدیور بدو گفت زین در مرنج"
  },
  {
    "poem_id": 1784,
    "vorder": 82,
    "position": 1,
    "text": "که در خان من کس نیابد سپنج"
  },
  {
    "poem_id": 1784,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت شاه ای خردمند پیر"
  },
  {
    "poem_id": 1784,
    "vorder": 84,
    "position": 1,
    "text": "چه باشی به پیشم همی خیره خیر"
  },
  {
    "poem_id": 1784,
    "vorder": 85,
    "position": 0,
    "text": "چنانچون گمانم هم از آب سرد"
  },
  {
    "poem_id": 1784,
    "vorder": 86,
    "position": 1,
    "text": "ببخشای ای مرد آزادمرد"
  },
  {
    "poem_id": 1784,
    "vorder": 87,
    "position": 0,
    "text": "کدیور بدو گفت کان آبگیر"
  },
  {
    "poem_id": 1784,
    "vorder": 88,
    "position": 1,
    "text": "به پیش است کمتر ز پرتاب تیر"
  },
  {
    "poem_id": 1784,
    "vorder": 89,
    "position": 0,
    "text": "بخور چند خواهی و بردار نیز"
  },
  {
    "poem_id": 1784,
    "vorder": 90,
    "position": 1,
    "text": "چه جویی بدین بی‌نوا خانه چیز"
  },
  {
    "poem_id": 1784,
    "vorder": 91,
    "position": 0,
    "text": "همانا بدیدی تو درویش مرد"
  },
  {
    "poem_id": 1784,
    "vorder": 92,
    "position": 1,
    "text": "ز پیری فرومانده از کارکرد"
  },
  {
    "poem_id": 1784,
    "vorder": 93,
    "position": 0,
    "text": "چنین داد پاسخ که گر مهتری"
  },
  {
    "poem_id": 1784,
    "vorder": 94,
    "position": 1,
    "text": "نداری مکن جنگ با لشکری"
  },
  {
    "poem_id": 1784,
    "vorder": 95,
    "position": 0,
    "text": "چه نامی بدو گفت فرشیدورد"
  },
  {
    "poem_id": 1784,
    "vorder": 96,
    "position": 1,
    "text": "نه بوم و نه پوشش نه خواب و نه خورد"
  },
  {
    "poem_id": 1784,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت بهرام با کام خویش"
  },
  {
    "poem_id": 1784,
    "vorder": 98,
    "position": 1,
    "text": "چرا نان نجویی بدین نام خویش"
  },
  {
    "poem_id": 1784,
    "vorder": 99,
    "position": 0,
    "text": "کدیور بدو گفت کز کردگار"
  },
  {
    "poem_id": 1784,
    "vorder": 100,
    "position": 1,
    "text": "سرآید مگر بر من این روزگار"
  },
  {
    "poem_id": 1784,
    "vorder": 101,
    "position": 0,
    "text": "نیایش کنم پیش یزدان خویش"
  },
  {
    "poem_id": 1784,
    "vorder": 102,
    "position": 1,
    "text": "ببینم مگر بی‌تو ویران خویش"
  },
  {
    "poem_id": 1784,
    "vorder": 103,
    "position": 0,
    "text": "چرا آمدی در سرای تهی"
  },
  {
    "poem_id": 1784,
    "vorder": 104,
    "position": 1,
    "text": "که هرگز نبینی مهی و بهی"
  },
  {
    "poem_id": 1784,
    "vorder": 105,
    "position": 0,
    "text": "بگفت این و بگریست چندان به زار"
  },
  {
    "poem_id": 1784,
    "vorder": 106,
    "position": 1,
    "text": "که بگریخت ز آواز او شهریار"
  },
  {
    "poem_id": 1784,
    "vorder": 107,
    "position": 0,
    "text": "بخندید زان پیر و آمد به راه"
  },
  {
    "poem_id": 1784,
    "vorder": 108,
    "position": 1,
    "text": "دمادم بیامد پس او سپاه"
  },
  {
    "poem_id": 1784,
    "vorder": 109,
    "position": 0,
    "text": "چو بیرون شد از نامور شارستان"
  },
  {
    "poem_id": 1784,
    "vorder": 110,
    "position": 1,
    "text": "به پیش اندر آمد یکی خارستان"
  },
  {
    "poem_id": 1784,
    "vorder": 111,
    "position": 0,
    "text": "تبر داشت مردی همی کند خار"
  },
  {
    "poem_id": 1784,
    "vorder": 112,
    "position": 1,
    "text": "ز لشکر بشد پیش او شهریار"
  },
  {
    "poem_id": 1784,
    "vorder": 113,
    "position": 0,
    "text": "بدو گفت مهتر بدین شارستان"
  },
  {
    "poem_id": 1784,
    "vorder": 114,
    "position": 1,
    "text": "کرا دانی ای دشمن خارستان"
  },
  {
    "poem_id": 1784,
    "vorder": 115,
    "position": 0,
    "text": "چنین داد پاسخ که فرشیدورد"
  },
  {
    "poem_id": 1784,
    "vorder": 116,
    "position": 1,
    "text": "بماند همه ساله بی‌خواب و خورد"
  },
  {
    "poem_id": 1784,
    "vorder": 117,
    "position": 0,
    "text": "مگر گوسفندش بود صدهزار"
  },
  {
    "poem_id": 1784,
    "vorder": 118,
    "position": 1,
    "text": "همان اسپ و استر بود زین شمار"
  },
  {
    "poem_id": 1784,
    "vorder": 119,
    "position": 0,
    "text": "زمین پر ز آگنده دینار اوست"
  },
  {
    "poem_id": 1784,
    "vorder": 120,
    "position": 1,
    "text": "که مه مغز بادش بتن‌بر مه پوست"
  },
  {
    "poem_id": 1784,
    "vorder": 121,
    "position": 0,
    "text": "شکم گرسنه مانده تن برهنه"
  },
  {
    "poem_id": 1784,
    "vorder": 122,
    "position": 1,
    "text": "نه فرزند و خویش نه‌بار و بنه"
  },
  {
    "poem_id": 1784,
    "vorder": 123,
    "position": 0,
    "text": "اگر کشتمندش فروشد به زر"
  },
  {
    "poem_id": 1784,
    "vorder": 124,
    "position": 1,
    "text": "یکی خانه بومش کند پر گهر"
  },
  {
    "poem_id": 1784,
    "vorder": 125,
    "position": 0,
    "text": "شبانش همی گوشت جوشد به شیر"
  },
  {
    "poem_id": 1784,
    "vorder": 126,
    "position": 1,
    "text": "خود او نان ارزن خورد با پنیر"
  },
  {
    "poem_id": 1784,
    "vorder": 127,
    "position": 0,
    "text": "دو جامه ندیدست هرگز به هم"
  },
  {
    "poem_id": 1784,
    "vorder": 128,
    "position": 1,
    "text": "ازویست هم بر تن او ستم"
  },
  {
    "poem_id": 1784,
    "vorder": 129,
    "position": 0,
    "text": "چنین گفت با خارزن شهریار"
  },
  {
    "poem_id": 1784,
    "vorder": 130,
    "position": 1,
    "text": "که گر گوسفندش ندانی شمار"
  },
  {
    "poem_id": 1784,
    "vorder": 131,
    "position": 0,
    "text": "بدانی همانا کجا دارد اوی"
  },
  {
    "poem_id": 1784,
    "vorder": 132,
    "position": 1,
    "text": "شمارش بتو گفت کی یارد اوی"
  },
  {
    "poem_id": 1784,
    "vorder": 133,
    "position": 0,
    "text": "چنین گفت کای رزم دیده سوار"
  },
  {
    "poem_id": 1784,
    "vorder": 134,
    "position": 1,
    "text": "ازان خواسته کس نداند شمار"
  },
  {
    "poem_id": 1784,
    "vorder": 135,
    "position": 0,
    "text": "بدان خارزن داد دینار چند"
  },
  {
    "poem_id": 1784,
    "vorder": 136,
    "position": 1,
    "text": "بدو گفت کاکنون شدی ارجمند"
  },
  {
    "poem_id": 1784,
    "vorder": 137,
    "position": 0,
    "text": "بفرمود تا از میان سپاه"
  },
  {
    "poem_id": 1784,
    "vorder": 138,
    "position": 1,
    "text": "بیاید یکی مرد دانا به راه"
  },
  {
    "poem_id": 1784,
    "vorder": 139,
    "position": 0,
    "text": "کجا نام آن مرد بهرام بود"
  },
  {
    "poem_id": 1784,
    "vorder": 140,
    "position": 1,
    "text": "سواری دلیر و دلارام بود"
  },
  {
    "poem_id": 1784,
    "vorder": 141,
    "position": 0,
    "text": "فرستاد با نامور سی سوار"
  },
  {
    "poem_id": 1784,
    "vorder": 142,
    "position": 1,
    "text": "گزین کرده شایسته مردان کار"
  },
  {
    "poem_id": 1784,
    "vorder": 143,
    "position": 0,
    "text": "دبیری گزین کرد پرهیزگار"
  },
  {
    "poem_id": 1784,
    "vorder": 144,
    "position": 1,
    "text": "بدان‌سان که دانست کردن شمار"
  },
  {
    "poem_id": 1784,
    "vorder": 145,
    "position": 0,
    "text": "بدان خارزن گفت ز ایدر برو"
  },
  {
    "poem_id": 1784,
    "vorder": 146,
    "position": 1,
    "text": "همی خارکندی کنون زر درو"
  },
  {
    "poem_id": 1784,
    "vorder": 147,
    "position": 0,
    "text": "ازان خواسته ده یکی مر تراست"
  },
  {
    "poem_id": 1784,
    "vorder": 148,
    "position": 1,
    "text": "بدین مردمان راه بنمای راست"
  },
  {
    "poem_id": 1784,
    "vorder": 149,
    "position": 0,
    "text": "دل افرزو بد نام آن خارزن"
  },
  {
    "poem_id": 1784,
    "vorder": 150,
    "position": 1,
    "text": "گرازنده مردی به نیروی تن"
  },
  {
    "poem_id": 1784,
    "vorder": 151,
    "position": 0,
    "text": "گرانمایه اسپی بدو داد و گفت"
  },
  {
    "poem_id": 1784,
    "vorder": 152,
    "position": 1,
    "text": "که با باد باید که گردی تو جفت"
  },
  {
    "poem_id": 1784,
    "vorder": 153,
    "position": 0,
    "text": "دل‌افروز بد گیتی افروز شد"
  },
  {
    "poem_id": 1784,
    "vorder": 154,
    "position": 1,
    "text": "چو آمد به درگاه پیروز شد"
  },
  {
    "poem_id": 1784,
    "vorder": 155,
    "position": 0,
    "text": "بیاورد لشکر به کوه و به دشت"
  },
  {
    "poem_id": 1784,
    "vorder": 156,
    "position": 1,
    "text": "همی گوسفند از عدد برگذشت"
  },
  {
    "poem_id": 1784,
    "vorder": 157,
    "position": 0,
    "text": "شتر بود بر کوه ده کاروان"
  },
  {
    "poem_id": 1784,
    "vorder": 158,
    "position": 1,
    "text": "به هر کاروان بر یکی ساروان"
  },
  {
    "poem_id": 1784,
    "vorder": 159,
    "position": 0,
    "text": "ز گاوان ورز و ز گاوان شیر"
  },
  {
    "poem_id": 1784,
    "vorder": 160,
    "position": 1,
    "text": "ز پشم و ز روغن ز کشت و پنیر"
  },
  {
    "poem_id": 1784,
    "vorder": 161,
    "position": 0,
    "text": "همه دشت و کوه و بیابان کنام"
  },
  {
    "poem_id": 1784,
    "vorder": 162,
    "position": 1,
    "text": "کس او را به گیتی ندانست نام"
  },
  {
    "poem_id": 1784,
    "vorder": 163,
    "position": 0,
    "text": "بیابان سراسر همه کنده سم"
  },
  {
    "poem_id": 1784,
    "vorder": 164,
    "position": 1,
    "text": "همان روغن گاو در سم به خم"
  },
  {
    "poem_id": 1784,
    "vorder": 165,
    "position": 0,
    "text": "ز شیراز وز ترف سیصدهراز"
  },
  {
    "poem_id": 1784,
    "vorder": 166,
    "position": 1,
    "text": "شتروار بد بر لب جویبار"
  },
  {
    "poem_id": 1784,
    "vorder": 167,
    "position": 0,
    "text": "یکی نامه بنوشت بهرام هور"
  },
  {
    "poem_id": 1784,
    "vorder": 168,
    "position": 1,
    "text": "به نزد شهنشاه بهرام گور"
  },
  {
    "poem_id": 1784,
    "vorder": 169,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1784,
    "vorder": 170,
    "position": 1,
    "text": "که اویست پیروز و پروردگار"
  },
  {
    "poem_id": 1784,
    "vorder": 171,
    "position": 0,
    "text": "دگر آفرین بر شهنشاه کرد"
  },
  {
    "poem_id": 1784,
    "vorder": 172,
    "position": 1,
    "text": "که کیش بدی (را) نگونسار کرد"
  },
  {
    "poem_id": 1784,
    "vorder": 173,
    "position": 0,
    "text": "چنین گفت کای شهریار جهان"
  },
  {
    "poem_id": 1784,
    "vorder": 174,
    "position": 1,
    "text": "ز تو شاد یکسر کهان و مهان"
  },
  {
    "poem_id": 1784,
    "vorder": 175,
    "position": 0,
    "text": "کز اندازه دادت همی بگذرد"
  },
  {
    "poem_id": 1784,
    "vorder": 176,
    "position": 1,
    "text": "ازین خامشی گنج کیفر برد"
  },
  {
    "poem_id": 1784,
    "vorder": 177,
    "position": 0,
    "text": "همه کار گیتی به اندازه به"
  },
  {
    "poem_id": 1784,
    "vorder": 178,
    "position": 1,
    "text": "دل شاه ز اندیشه‌ها تازه به"
  },
  {
    "poem_id": 1784,
    "vorder": 179,
    "position": 0,
    "text": "یکی گم شده نام فرشیدورد"
  },
  {
    "poem_id": 1784,
    "vorder": 180,
    "position": 1,
    "text": "نه در بزمگاه و نه اندر نبرد"
  },
  {
    "poem_id": 1784,
    "vorder": 181,
    "position": 0,
    "text": "ندانست کس نام او در جهان"
  },
  {
    "poem_id": 1784,
    "vorder": 182,
    "position": 1,
    "text": "میان کهان و میان مهان"
  },
  {
    "poem_id": 1784,
    "vorder": 183,
    "position": 0,
    "text": "نه خسروپرست و نه یزدان‌شناس"
  },
  {
    "poem_id": 1784,
    "vorder": 184,
    "position": 1,
    "text": "ندانست کردن به چیزی سپاس"
  },
  {
    "poem_id": 1784,
    "vorder": 185,
    "position": 0,
    "text": "چنین خواسته گسترد در جهان"
  },
  {
    "poem_id": 1784,
    "vorder": 186,
    "position": 1,
    "text": "تهی‌دست و پر غم نشسته نهان"
  },
  {
    "poem_id": 1784,
    "vorder": 187,
    "position": 0,
    "text": "به بیداد ماند همی داد شاه"
  },
  {
    "poem_id": 1784,
    "vorder": 188,
    "position": 1,
    "text": "منه پند گفتار من بر گناه"
  },
  {
    "poem_id": 1784,
    "vorder": 189,
    "position": 0,
    "text": "پی افگن یکی گنج زین خواسته"
  },
  {
    "poem_id": 1784,
    "vorder": 190,
    "position": 1,
    "text": "سیوم سال را گردد آراسته"
  },
  {
    "poem_id": 1784,
    "vorder": 191,
    "position": 0,
    "text": "دبیران داننده را خواندم"
  },
  {
    "poem_id": 1784,
    "vorder": 192,
    "position": 1,
    "text": "برین کوه آباد بنشاندم"
  },
  {
    "poem_id": 1784,
    "vorder": 193,
    "position": 0,
    "text": "شمارش پدیدار نامد هنوز"
  },
  {
    "poem_id": 1784,
    "vorder": 194,
    "position": 1,
    "text": "نویسنده را پشت برگشت کوز"
  },
  {
    "poem_id": 1784,
    "vorder": 195,
    "position": 0,
    "text": "چنین گفت گوینده کاندر زمین"
  },
  {
    "poem_id": 1784,
    "vorder": 196,
    "position": 1,
    "text": "ورا زر و گوهر فزونست زین"
  },
  {
    "poem_id": 1784,
    "vorder": 197,
    "position": 0,
    "text": "برین کوهسارم دو دیده به راه"
  },
  {
    "poem_id": 1784,
    "vorder": 198,
    "position": 1,
    "text": "بدان تا چه فرمان دهد پیشگاه"
  },
  {
    "poem_id": 1784,
    "vorder": 199,
    "position": 0,
    "text": "ز من باد بر شاه ایران درود"
  },
  {
    "poem_id": 1784,
    "vorder": 200,
    "position": 1,
    "text": "بمان زنده تا نام تارست و پود"
  },
  {
    "poem_id": 1784,
    "vorder": 201,
    "position": 0,
    "text": "هیونی برافگند پویان به راه"
  },
  {
    "poem_id": 1784,
    "vorder": 202,
    "position": 1,
    "text": "بدان تا برد نامه نزدیک شاه"
  },
  {
    "poem_id": 1784,
    "vorder": 203,
    "position": 0,
    "text": "چو آن نامه برخواند بهرام‌گور"
  },
  {
    "poem_id": 1784,
    "vorder": 204,
    "position": 1,
    "text": "به دلش اندر افتارد زان کار شور"
  },
  {
    "poem_id": 1784,
    "vorder": 205,
    "position": 0,
    "text": "دژم گشت و دیده پر از آب کرد"
  },
  {
    "poem_id": 1784,
    "vorder": 206,
    "position": 1,
    "text": "بروهای جنگی پر از تاب کرد"
  },
  {
    "poem_id": 1784,
    "vorder": 207,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1784,
    "vorder": 208,
    "position": 1,
    "text": "قلم خواست رومی و چینی حریر"
  },
  {
    "poem_id": 1784,
    "vorder": 209,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1784,
    "vorder": 210,
    "position": 1,
    "text": "خداوند پیروز و به روزگار"
  },
  {
    "poem_id": 1784,
    "vorder": 211,
    "position": 0,
    "text": "خداوند دانایی و فرهی"
  },
  {
    "poem_id": 1784,
    "vorder": 212,
    "position": 1,
    "text": "خداوند دیهیم شاهنشهی"
  },
  {
    "poem_id": 1784,
    "vorder": 213,
    "position": 0,
    "text": "نبشت آن که گر دادگر بودمی"
  },
  {
    "poem_id": 1784,
    "vorder": 214,
    "position": 1,
    "text": "همین مرد را رنج ننمودمی"
  },
  {
    "poem_id": 1784,
    "vorder": 215,
    "position": 0,
    "text": "نیاورد گرد این ز دزدی و خون"
  },
  {
    "poem_id": 1784,
    "vorder": 216,
    "position": 1,
    "text": "نبد هم کسی را به بد رهنمون"
  },
  {
    "poem_id": 1784,
    "vorder": 217,
    "position": 0,
    "text": "همی بد که این مرد بد ناسپاس"
  },
  {
    "poem_id": 1784,
    "vorder": 218,
    "position": 1,
    "text": "ز یزدان نبودش به دل در هراس"
  },
  {
    "poem_id": 1784,
    "vorder": 219,
    "position": 0,
    "text": "یکی پاسبان بد برین خواسته"
  },
  {
    "poem_id": 1784,
    "vorder": 220,
    "position": 1,
    "text": "دل و جان ز افزون شدن کاسته"
  },
  {
    "poem_id": 1784,
    "vorder": 221,
    "position": 0,
    "text": "بدین دشت چه گرگ و چه گوسفند"
  },
  {
    "poem_id": 1784,
    "vorder": 222,
    "position": 1,
    "text": "چو باشد به پیکار و ناسودمند"
  },
  {
    "poem_id": 1784,
    "vorder": 223,
    "position": 0,
    "text": "به زیر زمین در چه گوهر چه سنگ"
  },
  {
    "poem_id": 1784,
    "vorder": 224,
    "position": 1,
    "text": "کزو خورد و پوشش نیاید به چنگ"
  },
  {
    "poem_id": 1784,
    "vorder": 225,
    "position": 0,
    "text": "نسازیم ازان رنج بنیاد گنج"
  },
  {
    "poem_id": 1784,
    "vorder": 226,
    "position": 1,
    "text": "نبندیم دل در سرای سپنج"
  },
  {
    "poem_id": 1784,
    "vorder": 227,
    "position": 0,
    "text": "فریدون نه پیداست اندر جهان"
  },
  {
    "poem_id": 1784,
    "vorder": 228,
    "position": 1,
    "text": "همان ایرج و سلم و تور از مهان"
  },
  {
    "poem_id": 1784,
    "vorder": 229,
    "position": 0,
    "text": "همان جم و کاوس با کیقباد"
  },
  {
    "poem_id": 1784,
    "vorder": 230,
    "position": 1,
    "text": "جزین نامداران که داریم یاد"
  },
  {
    "poem_id": 1784,
    "vorder": 231,
    "position": 0,
    "text": "پدرم آنک زو دل پر از درد بود"
  },
  {
    "poem_id": 1784,
    "vorder": 232,
    "position": 1,
    "text": "نبد دادگر ناجوانمرد بود"
  },
  {
    "poem_id": 1784,
    "vorder": 233,
    "position": 0,
    "text": "کسی زین بزرگان پدیدار نیست"
  },
  {
    "poem_id": 1784,
    "vorder": 234,
    "position": 1,
    "text": "بدین با خداوند پیکار نیست"
  },
  {
    "poem_id": 1784,
    "vorder": 235,
    "position": 0,
    "text": "تو آن خواسته گرد کن هرچ هست"
  },
  {
    "poem_id": 1784,
    "vorder": 236,
    "position": 1,
    "text": "ببخش و مبر زان به یک چیز دست"
  },
  {
    "poem_id": 1784,
    "vorder": 237,
    "position": 0,
    "text": "کسی را که پوشیده دارد نیاز"
  },
  {
    "poem_id": 1784,
    "vorder": 238,
    "position": 1,
    "text": "که از بد همی دیر یابد جواز"
  },
  {
    "poem_id": 1784,
    "vorder": 239,
    "position": 0,
    "text": "همان نیز پیری که بیکار گشت"
  },
  {
    "poem_id": 1784,
    "vorder": 240,
    "position": 1,
    "text": "به چشم گرانمایگان خوار گشت"
  },
  {
    "poem_id": 1784,
    "vorder": 241,
    "position": 0,
    "text": "دگر هرک چیزیش بود و بخورد"
  },
  {
    "poem_id": 1784,
    "vorder": 242,
    "position": 1,
    "text": "کنون ماند با درد و با بادسرد"
  },
  {
    "poem_id": 1784,
    "vorder": 243,
    "position": 0,
    "text": "کسی را که نامست و دینار نیست"
  },
  {
    "poem_id": 1784,
    "vorder": 244,
    "position": 1,
    "text": "به بازارگانی کسش یار نیست"
  },
  {
    "poem_id": 1784,
    "vorder": 245,
    "position": 0,
    "text": "دگر کودکانی که بینی یتیم"
  },
  {
    "poem_id": 1784,
    "vorder": 246,
    "position": 1,
    "text": "پدر مرده و مانده بی زر و سیم"
  },
  {
    "poem_id": 1784,
    "vorder": 247,
    "position": 0,
    "text": "زنانی که بی‌شوی و بی‌پوشش‌اند"
  },
  {
    "poem_id": 1784,
    "vorder": 248,
    "position": 1,
    "text": "که کاری ندانند و بی‌کوشش‌اند"
  },
  {
    "poem_id": 1784,
    "vorder": 249,
    "position": 0,
    "text": "بریشان ببخش این همه خواسته"
  },
  {
    "poem_id": 1784,
    "vorder": 250,
    "position": 1,
    "text": "برافروز جان و روان کاسته"
  },
  {
    "poem_id": 1784,
    "vorder": 251,
    "position": 0,
    "text": "تو با آنک رفتی سوی گنج باد"
  },
  {
    "poem_id": 1784,
    "vorder": 252,
    "position": 1,
    "text": "همه داد و پرهیزگاریت باد"
  },
  {
    "poem_id": 1784,
    "vorder": 253,
    "position": 0,
    "text": "نهان کرده دینار فرشیدورد"
  },
  {
    "poem_id": 1784,
    "vorder": 254,
    "position": 1,
    "text": "بدو مان همی تا نماند به درد"
  },
  {
    "poem_id": 1784,
    "vorder": 255,
    "position": 0,
    "text": "مر او را چه دینار و گوهر چه خاک"
  },
  {
    "poem_id": 1784,
    "vorder": 256,
    "position": 1,
    "text": "چو بایست کردن همی در مغاک"
  },
  {
    "poem_id": 1784,
    "vorder": 257,
    "position": 0,
    "text": "سپهر گراینده یار تو باد"
  },
  {
    "poem_id": 1784,
    "vorder": 258,
    "position": 1,
    "text": "همان داد و پرهیز کار تو باد"
  },
  {
    "poem_id": 1784,
    "vorder": 259,
    "position": 0,
    "text": "نهادند بر نامه‌بر مهر شاه"
  },
  {
    "poem_id": 1784,
    "vorder": 260,
    "position": 1,
    "text": "فرستاد برگشت و آمد به راه"
  }
]