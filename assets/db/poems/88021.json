[
  {
    "poem_id": 88021,
    "vorder": 1,
    "position": 0,
    "text": "برفتند با رستم آن هفت گرد"
  },
  {
    "poem_id": 88021,
    "vorder": 2,
    "position": 1,
    "text": "بنه اشکش تیزهش را سپرد"
  },
  {
    "poem_id": 88021,
    "vorder": 3,
    "position": 0,
    "text": "عنانها فگندند بر پیش زین"
  },
  {
    "poem_id": 88021,
    "vorder": 4,
    "position": 1,
    "text": "کشیدند یکسر همه تیغ کین"
  },
  {
    "poem_id": 88021,
    "vorder": 5,
    "position": 0,
    "text": "بشد تا بدرگاه افراسیاب"
  },
  {
    "poem_id": 88021,
    "vorder": 6,
    "position": 1,
    "text": "بهنگام سستی و آرام و خواب"
  },
  {
    "poem_id": 88021,
    "vorder": 7,
    "position": 0,
    "text": "برآمد ز ناگه ده و دار و گیر"
  },
  {
    "poem_id": 88021,
    "vorder": 8,
    "position": 1,
    "text": "درخشیدن تیغ و باران تیر"
  },
  {
    "poem_id": 88021,
    "vorder": 9,
    "position": 0,
    "text": "سران را بسی سر جدا شد ز تن"
  },
  {
    "poem_id": 88021,
    "vorder": 10,
    "position": 1,
    "text": "پر از خاک ریش و پر از خون دهن"
  },
  {
    "poem_id": 88021,
    "vorder": 11,
    "position": 0,
    "text": "ز دهلیز در رستم آواز داد"
  },
  {
    "poem_id": 88021,
    "vorder": 12,
    "position": 1,
    "text": "که خواب تو خوش باد و گردانت شاد"
  },
  {
    "poem_id": 88021,
    "vorder": 13,
    "position": 0,
    "text": "بخفتی تو بر گاه و بیژن بچاه"
  },
  {
    "poem_id": 88021,
    "vorder": 14,
    "position": 1,
    "text": "مگر باره دیدی ز آهن براه"
  },
  {
    "poem_id": 88021,
    "vorder": 15,
    "position": 0,
    "text": "منم رستم زابلی پور زال"
  },
  {
    "poem_id": 88021,
    "vorder": 16,
    "position": 1,
    "text": "نه هنگام خوابست و آرام و هال"
  },
  {
    "poem_id": 88021,
    "vorder": 17,
    "position": 0,
    "text": "شکستم در بند زندان تو"
  },
  {
    "poem_id": 88021,
    "vorder": 18,
    "position": 1,
    "text": "که سنگ گران بد نگهبان تو"
  },
  {
    "poem_id": 88021,
    "vorder": 19,
    "position": 0,
    "text": "رها شد سر و پای بیژن ز بند"
  },
  {
    "poem_id": 88021,
    "vorder": 20,
    "position": 1,
    "text": "بداماد بر کس نسازد گزند"
  },
  {
    "poem_id": 88021,
    "vorder": 21,
    "position": 0,
    "text": "ترا رزم و کین سیاوخش بس"
  },
  {
    "poem_id": 88021,
    "vorder": 22,
    "position": 1,
    "text": "بدین دشت گردیدن رخش بس"
  },
  {
    "poem_id": 88021,
    "vorder": 23,
    "position": 0,
    "text": "همیدون برآورد بیژن خروش"
  },
  {
    "poem_id": 88021,
    "vorder": 24,
    "position": 1,
    "text": "که ای ترک بدگوهر تیره هوش"
  },
  {
    "poem_id": 88021,
    "vorder": 25,
    "position": 0,
    "text": "براندیش زان تخت فرخنده‌جای"
  },
  {
    "poem_id": 88021,
    "vorder": 26,
    "position": 1,
    "text": "مرا بسته در پیش کرده بپای"
  },
  {
    "poem_id": 88021,
    "vorder": 27,
    "position": 0,
    "text": "همی رزم جستی بسان پلنگ"
  },
  {
    "poem_id": 88021,
    "vorder": 28,
    "position": 1,
    "text": "مرا دست بسته بکردار سنگ"
  },
  {
    "poem_id": 88021,
    "vorder": 29,
    "position": 0,
    "text": "کنونم گشاده بهامون ببین"
  },
  {
    "poem_id": 88021,
    "vorder": 30,
    "position": 1,
    "text": "که با من نجوید ژیان شیر کین"
  },
  {
    "poem_id": 88021,
    "vorder": 31,
    "position": 0,
    "text": "بزد دست بر جامه افراسیاب"
  },
  {
    "poem_id": 88021,
    "vorder": 32,
    "position": 1,
    "text": "که جنگ‌آوران را ببستست خواب"
  },
  {
    "poem_id": 88021,
    "vorder": 33,
    "position": 0,
    "text": "بفرمود زان پس که گیرند راه"
  },
  {
    "poem_id": 88021,
    "vorder": 34,
    "position": 1,
    "text": "بدان نامداران جوینده گاه"
  },
  {
    "poem_id": 88021,
    "vorder": 35,
    "position": 0,
    "text": "ز هر سو خروش تکاپوی خاست"
  },
  {
    "poem_id": 88021,
    "vorder": 36,
    "position": 1,
    "text": "ز خون ریختن بر درش جوی خاست"
  },
  {
    "poem_id": 88021,
    "vorder": 37,
    "position": 0,
    "text": "هرآنکس که آمد ز توران سپاه"
  },
  {
    "poem_id": 88021,
    "vorder": 38,
    "position": 1,
    "text": "زمانه تهی ماند زو جایگاه"
  },
  {
    "poem_id": 88021,
    "vorder": 39,
    "position": 0,
    "text": "گرفتند بر کینه جستن شتاب"
  },
  {
    "poem_id": 88021,
    "vorder": 40,
    "position": 1,
    "text": "ازان خانه بگریخت افراسیاب"
  },
  {
    "poem_id": 88021,
    "vorder": 41,
    "position": 0,
    "text": "بکاخ اندر آمد خداوند رخش"
  },
  {
    "poem_id": 88021,
    "vorder": 42,
    "position": 1,
    "text": "همه فرش و دیبای او کرد بخش"
  },
  {
    "poem_id": 88021,
    "vorder": 43,
    "position": 0,
    "text": "پریچهرگان سپهبدپرست"
  },
  {
    "poem_id": 88021,
    "vorder": 44,
    "position": 1,
    "text": "گرفته همه دست گردان بدست"
  },
  {
    "poem_id": 88021,
    "vorder": 45,
    "position": 0,
    "text": "گرانمایه اسبان و زین پلنگ"
  },
  {
    "poem_id": 88021,
    "vorder": 46,
    "position": 1,
    "text": "نشانده گهر در جناغ خدنگ"
  },
  {
    "poem_id": 88021,
    "vorder": 47,
    "position": 0,
    "text": "ازان پس ز ایوان ببستند بار"
  },
  {
    "poem_id": 88021,
    "vorder": 48,
    "position": 1,
    "text": "بتوران نکردند بس روزگار"
  },
  {
    "poem_id": 88021,
    "vorder": 49,
    "position": 0,
    "text": "ز بهر بنه تاخت اسبان بزور"
  },
  {
    "poem_id": 88021,
    "vorder": 50,
    "position": 1,
    "text": "بدان تا نخیزد ازان کار شور"
  },
  {
    "poem_id": 88021,
    "vorder": 51,
    "position": 0,
    "text": "چنان رنجه بد رستم از رنج راه"
  },
  {
    "poem_id": 88021,
    "vorder": 52,
    "position": 1,
    "text": "که بر سرش بر درد بود از کلاه"
  },
  {
    "poem_id": 88021,
    "vorder": 53,
    "position": 0,
    "text": "سواران ز بس رنج و اسبان ز تگ"
  },
  {
    "poem_id": 88021,
    "vorder": 54,
    "position": 1,
    "text": "یکی را بتن بر نجنبید رگ"
  },
  {
    "poem_id": 88021,
    "vorder": 55,
    "position": 0,
    "text": "بلشکر فرستاد رستم پیام"
  },
  {
    "poem_id": 88021,
    "vorder": 56,
    "position": 1,
    "text": "که شمشیر کین بر کشید از نیام"
  },
  {
    "poem_id": 88021,
    "vorder": 57,
    "position": 0,
    "text": "که من بیگمانم کزین پس بکین"
  },
  {
    "poem_id": 88021,
    "vorder": 58,
    "position": 1,
    "text": "سیه گردد از سم اسبان زمین"
  },
  {
    "poem_id": 88021,
    "vorder": 59,
    "position": 0,
    "text": "گشن لشکری سازد افراسیاب"
  },
  {
    "poem_id": 88021,
    "vorder": 60,
    "position": 1,
    "text": "بنیزه بپوشد رخ آفتاب"
  },
  {
    "poem_id": 88021,
    "vorder": 61,
    "position": 0,
    "text": "برفتند یکسر سواران جنگ"
  },
  {
    "poem_id": 88021,
    "vorder": 62,
    "position": 1,
    "text": "همه رزم را تیز کردند چنگ"
  },
  {
    "poem_id": 88021,
    "vorder": 63,
    "position": 0,
    "text": "همه نیزه‌داران زدوده سنان"
  },
  {
    "poem_id": 88021,
    "vorder": 64,
    "position": 1,
    "text": "همه جنگ را گرد کرده عنان"
  },
  {
    "poem_id": 88021,
    "vorder": 65,
    "position": 0,
    "text": "منیژه نشسته بخیمه درون"
  },
  {
    "poem_id": 88021,
    "vorder": 66,
    "position": 1,
    "text": "پرستنده بر پیش او رهنمون"
  },
  {
    "poem_id": 88021,
    "vorder": 67,
    "position": 0,
    "text": "یکی داستان زد تهمتن بروی"
  },
  {
    "poem_id": 88021,
    "vorder": 68,
    "position": 1,
    "text": "که گر می بریزد نریزدش بوی"
  },
  {
    "poem_id": 88021,
    "vorder": 69,
    "position": 0,
    "text": "چنینست رسم سرای سپنج"
  },
  {
    "poem_id": 88021,
    "vorder": 70,
    "position": 1,
    "text": "گهی ناز و نوش و گهی درد و رنج"
  }
]