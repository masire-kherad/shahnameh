[
  {
    "poem_id": 1883,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید خاقان که بهرام را"
  },
  {
    "poem_id": 1883,
    "vorder": 2,
    "position": 1,
    "text": "چه آمد بروی از پی نام را"
  },
  {
    "poem_id": 1883,
    "vorder": 3,
    "position": 0,
    "text": "چوآن نامه نزدیک خاقان رسید"
  },
  {
    "poem_id": 1883,
    "vorder": 4,
    "position": 1,
    "text": "شد از درد گریان هران کان شنید"
  },
  {
    "poem_id": 1883,
    "vorder": 5,
    "position": 0,
    "text": "از آن آگهی شد دلش پر ز درد"
  },
  {
    "poem_id": 1883,
    "vorder": 6,
    "position": 1,
    "text": "دو دیده پر از خون و رخ لاژورد"
  },
  {
    "poem_id": 1883,
    "vorder": 7,
    "position": 0,
    "text": "ازان کار او در شگفتی بماند"
  },
  {
    "poem_id": 1883,
    "vorder": 8,
    "position": 1,
    "text": "جهاندیدگان را همه پیش خواند"
  },
  {
    "poem_id": 1883,
    "vorder": 9,
    "position": 0,
    "text": "بگفت آنک بهرام یل را رسید"
  },
  {
    "poem_id": 1883,
    "vorder": 10,
    "position": 1,
    "text": "بشد زار و گریان هران کوشنید"
  },
  {
    "poem_id": 1883,
    "vorder": 11,
    "position": 0,
    "text": "همه چین برو زار و گریان شدند"
  },
  {
    "poem_id": 1883,
    "vorder": 12,
    "position": 1,
    "text": "ابی آتش تیز بریان شدند"
  },
  {
    "poem_id": 1883,
    "vorder": 13,
    "position": 0,
    "text": "یکایک همه کار او را بساخت"
  },
  {
    "poem_id": 1883,
    "vorder": 14,
    "position": 1,
    "text": "نگه کرد کاین بدبریشان که تاخت"
  },
  {
    "poem_id": 1883,
    "vorder": 15,
    "position": 0,
    "text": "قلون را به توران دو فرزند بود"
  },
  {
    "poem_id": 1883,
    "vorder": 16,
    "position": 1,
    "text": "ز هر گونه‌ای خویش و پیوند بود"
  },
  {
    "poem_id": 1883,
    "vorder": 17,
    "position": 0,
    "text": "چو دانسته شد آتشی بر فروخت"
  },
  {
    "poem_id": 1883,
    "vorder": 18,
    "position": 1,
    "text": "سرای و همه بر زن او بسوخت"
  },
  {
    "poem_id": 1883,
    "vorder": 19,
    "position": 0,
    "text": "دو فرزند او را بر آتش نهاد"
  },
  {
    "poem_id": 1883,
    "vorder": 20,
    "position": 1,
    "text": "همه چیز او را به تاراج داد"
  },
  {
    "poem_id": 1883,
    "vorder": 21,
    "position": 0,
    "text": "ازان پس چو نوبت به خاتون رسید"
  },
  {
    "poem_id": 1883,
    "vorder": 22,
    "position": 1,
    "text": "ز پرده به گیسوش بیرون کشید"
  },
  {
    "poem_id": 1883,
    "vorder": 23,
    "position": 0,
    "text": "به ایوان کشید آن همه گنج اوی"
  },
  {
    "poem_id": 1883,
    "vorder": 24,
    "position": 1,
    "text": "نکرد ایچ یاد از در رنج اوی"
  },
  {
    "poem_id": 1883,
    "vorder": 25,
    "position": 0,
    "text": "فرستاد هرسو هیونان مست"
  },
  {
    "poem_id": 1883,
    "vorder": 26,
    "position": 1,
    "text": "نیامدش خراد برزین بدست"
  },
  {
    "poem_id": 1883,
    "vorder": 27,
    "position": 0,
    "text": "همه هرچ در چین و را بنده بود"
  },
  {
    "poem_id": 1883,
    "vorder": 28,
    "position": 1,
    "text": "به پوشیدشان جامه‌های کبود"
  },
  {
    "poem_id": 1883,
    "vorder": 29,
    "position": 0,
    "text": "بیک چند با سوک بهرام بود"
  },
  {
    "poem_id": 1883,
    "vorder": 30,
    "position": 1,
    "text": "که خاقان ازان کار بدنام بود"
  }
]