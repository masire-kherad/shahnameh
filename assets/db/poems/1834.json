[
  {
    "poem_id": 1834,
    "vorder": 1,
    "position": 0,
    "text": "بخندید تموز بر سرخ سیب"
  },
  {
    "poem_id": 1834,
    "vorder": 2,
    "position": 1,
    "text": "همی‌کرد با بار و برگش عتیب"
  },
  {
    "poem_id": 1834,
    "vorder": 3,
    "position": 0,
    "text": "که آن دسته گل بوقت بهار"
  },
  {
    "poem_id": 1834,
    "vorder": 4,
    "position": 1,
    "text": "بمستی همی‌داشتی درکنار"
  },
  {
    "poem_id": 1834,
    "vorder": 5,
    "position": 0,
    "text": "همی باد شرم آمد از رنگ اوی"
  },
  {
    "poem_id": 1834,
    "vorder": 6,
    "position": 1,
    "text": "همی یاد یار آمد از چنگ اوی"
  },
  {
    "poem_id": 1834,
    "vorder": 7,
    "position": 0,
    "text": "چه کردی که بودت خریدار آن"
  },
  {
    "poem_id": 1834,
    "vorder": 8,
    "position": 1,
    "text": "کجا یافتی تیز بازار آن"
  },
  {
    "poem_id": 1834,
    "vorder": 9,
    "position": 0,
    "text": "عقیق و زبرجد که دادت بهم"
  },
  {
    "poem_id": 1834,
    "vorder": 10,
    "position": 1,
    "text": "ز بار گران شاخ تو هم بخم"
  },
  {
    "poem_id": 1834,
    "vorder": 11,
    "position": 0,
    "text": "همانا که گل را بها خواستی"
  },
  {
    "poem_id": 1834,
    "vorder": 12,
    "position": 1,
    "text": "بدان رنگ رخ را بیاراستی"
  },
  {
    "poem_id": 1834,
    "vorder": 13,
    "position": 0,
    "text": "همی رنگ شرم آید از گردنت"
  },
  {
    "poem_id": 1834,
    "vorder": 14,
    "position": 1,
    "text": "همی مشک بوید ز پیراهنت"
  },
  {
    "poem_id": 1834,
    "vorder": 15,
    "position": 0,
    "text": "مگر جامه از مشتری بستدی"
  },
  {
    "poem_id": 1834,
    "vorder": 16,
    "position": 1,
    "text": "به لوئلؤ بر از خون نقط برزدی"
  },
  {
    "poem_id": 1834,
    "vorder": 17,
    "position": 0,
    "text": "زبرجدت برگست و چرمت بنفش"
  },
  {
    "poem_id": 1834,
    "vorder": 18,
    "position": 1,
    "text": "سرت برتر از کاویانی درفش"
  },
  {
    "poem_id": 1834,
    "vorder": 19,
    "position": 0,
    "text": "بپیرایه زرد وسرخ وسپید"
  },
  {
    "poem_id": 1834,
    "vorder": 20,
    "position": 1,
    "text": "مرا کردی از برگ گل ناامید"
  },
  {
    "poem_id": 1834,
    "vorder": 21,
    "position": 0,
    "text": "نگارا بهارا کجا رفته‌ای"
  },
  {
    "poem_id": 1834,
    "vorder": 22,
    "position": 1,
    "text": "که آرایش باغ بنهفته‌ای"
  },
  {
    "poem_id": 1834,
    "vorder": 23,
    "position": 0,
    "text": "همی مهرگان بوید از باد تو"
  },
  {
    "poem_id": 1834,
    "vorder": 24,
    "position": 1,
    "text": "بجام می‌اندر کنم یاد تو"
  },
  {
    "poem_id": 1834,
    "vorder": 25,
    "position": 0,
    "text": "چورنگت شود سبز بستایمت"
  },
  {
    "poem_id": 1834,
    "vorder": 26,
    "position": 1,
    "text": "چو دیهیم هرمز بیارایمت"
  },
  {
    "poem_id": 1834,
    "vorder": 27,
    "position": 0,
    "text": "که امروز تیزست بازار من"
  },
  {
    "poem_id": 1834,
    "vorder": 28,
    "position": 1,
    "text": "نبینی پس از مرگ آثار من"
  }
]