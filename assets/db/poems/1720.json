[
  {
    "poem_id": 1720,
    "vorder": 1,
    "position": 0,
    "text": "الا ای خریدار مغز سخن"
  },
  {
    "poem_id": 1720,
    "vorder": 2,
    "position": 1,
    "text": "دلت برگسل زین سرای کهن"
  },
  {
    "poem_id": 1720,
    "vorder": 3,
    "position": 0,
    "text": "کجا چون من و چون تو بسیار دید"
  },
  {
    "poem_id": 1720,
    "vorder": 4,
    "position": 1,
    "text": "نخواهد همی با کسی آرمید"
  },
  {
    "poem_id": 1720,
    "vorder": 5,
    "position": 0,
    "text": "اگر شهریاری و گر پیشکار"
  },
  {
    "poem_id": 1720,
    "vorder": 6,
    "position": 1,
    "text": "تو ناپایداری و او پایدار"
  },
  {
    "poem_id": 1720,
    "vorder": 7,
    "position": 0,
    "text": "چه با رنج باشی چه با تاج و تخت"
  },
  {
    "poem_id": 1720,
    "vorder": 8,
    "position": 1,
    "text": "ببایدت بستن به فرجام رخت"
  },
  {
    "poem_id": 1720,
    "vorder": 9,
    "position": 0,
    "text": "اگر ز آهنی چرخ بگدازدت"
  },
  {
    "poem_id": 1720,
    "vorder": 10,
    "position": 1,
    "text": "چو گشتی کهن نیز ننوازدت"
  },
  {
    "poem_id": 1720,
    "vorder": 11,
    "position": 0,
    "text": "چو سرو دلارای گردد به خم"
  },
  {
    "poem_id": 1720,
    "vorder": 12,
    "position": 1,
    "text": "خروشان شود نرگسان دژم"
  },
  {
    "poem_id": 1720,
    "vorder": 13,
    "position": 0,
    "text": "همان چهرهٔ ارغوان زعفران"
  },
  {
    "poem_id": 1720,
    "vorder": 14,
    "position": 1,
    "text": "سبک مردم شاد گردد گران"
  },
  {
    "poem_id": 1720,
    "vorder": 15,
    "position": 0,
    "text": "اگر شهریاری و گر زیردست"
  },
  {
    "poem_id": 1720,
    "vorder": 16,
    "position": 1,
    "text": "بجز خاک تیره نیابی نشست"
  },
  {
    "poem_id": 1720,
    "vorder": 17,
    "position": 0,
    "text": "کجا آن بزرگان با تاج و تخت"
  },
  {
    "poem_id": 1720,
    "vorder": 18,
    "position": 1,
    "text": "کجا آن سواران پیروزبخت"
  },
  {
    "poem_id": 1720,
    "vorder": 19,
    "position": 0,
    "text": "کجا آن خردمند کندآوران"
  },
  {
    "poem_id": 1720,
    "vorder": 20,
    "position": 1,
    "text": "کجا آن سرافراز و جنگی سران"
  },
  {
    "poem_id": 1720,
    "vorder": 21,
    "position": 0,
    "text": "کجا آن گزیده نیاکان ما"
  },
  {
    "poem_id": 1720,
    "vorder": 22,
    "position": 1,
    "text": "کجا آن دلیران و پاکان ما"
  },
  {
    "poem_id": 1720,
    "vorder": 23,
    "position": 0,
    "text": "همه خاک دارند بالین و خشت"
  },
  {
    "poem_id": 1720,
    "vorder": 24,
    "position": 1,
    "text": "خنک آنک جز تخم نیکی نکشت"
  },
  {
    "poem_id": 1720,
    "vorder": 25,
    "position": 0,
    "text": "نشان بس بود شهریار اردشیر"
  },
  {
    "poem_id": 1720,
    "vorder": 26,
    "position": 1,
    "text": "چو از من سخن بشنوی یادگیر"
  }
]