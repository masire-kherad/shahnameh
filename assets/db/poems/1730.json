[
  {
    "poem_id": 1730,
    "vorder": 1,
    "position": 0,
    "text": "چو بنشست بهرام بهرامیان"
  },
  {
    "poem_id": 1730,
    "vorder": 2,
    "position": 1,
    "text": "ببست از پی داد و بخشش میان"
  },
  {
    "poem_id": 1730,
    "vorder": 3,
    "position": 0,
    "text": "به تاجش زبرجد برافشاندند"
  },
  {
    "poem_id": 1730,
    "vorder": 4,
    "position": 1,
    "text": "همی نام کرمان شهش خواندند"
  },
  {
    "poem_id": 1730,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کز دادگر یک خدای"
  },
  {
    "poem_id": 1730,
    "vorder": 6,
    "position": 1,
    "text": "خرد بادمان بهره و داد و رای"
  },
  {
    "poem_id": 1730,
    "vorder": 7,
    "position": 0,
    "text": "سرای سپنجی نماند به کس"
  },
  {
    "poem_id": 1730,
    "vorder": 8,
    "position": 1,
    "text": "ترا نیکوی باد فریادرس"
  },
  {
    "poem_id": 1730,
    "vorder": 9,
    "position": 0,
    "text": "به نیکی گراییم و فرمان کنیم"
  },
  {
    "poem_id": 1730,
    "vorder": 10,
    "position": 1,
    "text": "به داد و دهش دل گروگان کنیم"
  },
  {
    "poem_id": 1730,
    "vorder": 11,
    "position": 0,
    "text": "که خوبی و زشتی ز ما یادگار"
  },
  {
    "poem_id": 1730,
    "vorder": 12,
    "position": 1,
    "text": "بماند تو جز تخم نیکی مکار"
  },
  {
    "poem_id": 1730,
    "vorder": 13,
    "position": 0,
    "text": "چو شد پادشاهیش بر چار ماه"
  },
  {
    "poem_id": 1730,
    "vorder": 14,
    "position": 1,
    "text": "برو زار بگریست تخت و کلاه"
  },
  {
    "poem_id": 1730,
    "vorder": 15,
    "position": 0,
    "text": "زمانه برین سان همی بگذرد"
  },
  {
    "poem_id": 1730,
    "vorder": 16,
    "position": 1,
    "text": "پیش مردم آزور بشمرد"
  },
  {
    "poem_id": 1730,
    "vorder": 17,
    "position": 0,
    "text": "می لعل پیش آور ای روزبه"
  },
  {
    "poem_id": 1730,
    "vorder": 18,
    "position": 1,
    "text": "چو شد سال گوینده بر شست و سه"
  },
  {
    "poem_id": 1730,
    "vorder": 19,
    "position": 0,
    "text": "چو بهرام دانست کامدش مرگ"
  },
  {
    "poem_id": 1730,
    "vorder": 20,
    "position": 1,
    "text": "نهنگی کجا بشکرد پیل و کرگ"
  },
  {
    "poem_id": 1730,
    "vorder": 21,
    "position": 0,
    "text": "جهان را به فرزند بسپرد و گفت"
  },
  {
    "poem_id": 1730,
    "vorder": 22,
    "position": 1,
    "text": "که با مهتران آفرین باد جفت"
  },
  {
    "poem_id": 1730,
    "vorder": 23,
    "position": 0,
    "text": "بنوش و بباز و بناز و ببخش"
  },
  {
    "poem_id": 1730,
    "vorder": 24,
    "position": 1,
    "text": "مکن روز بر تاج و بر تخت دخش"
  },
  {
    "poem_id": 1730,
    "vorder": 25,
    "position": 0,
    "text": "چو برگشت بهرام را روز و بخت"
  },
  {
    "poem_id": 1730,
    "vorder": 26,
    "position": 1,
    "text": "به نرسی سپرد آن زمان تاج و تخت"
  },
  {
    "poem_id": 1730,
    "vorder": 27,
    "position": 0,
    "text": "چنین است و این را بی‌اندازه دان"
  },
  {
    "poem_id": 1730,
    "vorder": 28,
    "position": 1,
    "text": "گزاف فلک هر زمان تازه دان"
  },
  {
    "poem_id": 1730,
    "vorder": 29,
    "position": 0,
    "text": "کنون کار نرسی بگویم همی"
  },
  {
    "poem_id": 1730,
    "vorder": 30,
    "position": 1,
    "text": "ز دل زنگ و زنگار شویم همی"
  }
]