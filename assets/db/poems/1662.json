[
  {
    "poem_id": 1662,
    "vorder": 1,
    "position": 0,
    "text": "جهانجوی ده نامور برگزید"
  },
  {
    "poem_id": 1662,
    "vorder": 2,
    "position": 1,
    "text": "ز مردان رومی چنانچون سزید"
  },
  {
    "poem_id": 1662,
    "vorder": 3,
    "position": 0,
    "text": "که بودند یکسر هم‌آواز اوی"
  },
  {
    "poem_id": 1662,
    "vorder": 4,
    "position": 1,
    "text": "نگه داشتندی همه راز اوی"
  },
  {
    "poem_id": 1662,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کاکنون به راه اندرون"
  },
  {
    "poem_id": 1662,
    "vorder": 6,
    "position": 1,
    "text": "مخوانید ما را جز از بیقطون"
  },
  {
    "poem_id": 1662,
    "vorder": 7,
    "position": 0,
    "text": "همی رفت پیش اندرون قیدروش"
  },
  {
    "poem_id": 1662,
    "vorder": 8,
    "position": 1,
    "text": "سکندر سپرده بدو چشم و گوش"
  },
  {
    "poem_id": 1662,
    "vorder": 9,
    "position": 0,
    "text": "چو آتش همی راند مهتر ستور"
  },
  {
    "poem_id": 1662,
    "vorder": 10,
    "position": 1,
    "text": "به کوهی رسیدند سنگش بلور"
  },
  {
    "poem_id": 1662,
    "vorder": 11,
    "position": 0,
    "text": "بدودر ز هرگونه‌ای میوه‌دار"
  },
  {
    "poem_id": 1662,
    "vorder": 12,
    "position": 1,
    "text": "فراوان گیا بود بر کوهسار"
  },
  {
    "poem_id": 1662,
    "vorder": 13,
    "position": 0,
    "text": "برفتند زانگونه پویان به راه"
  },
  {
    "poem_id": 1662,
    "vorder": 14,
    "position": 1,
    "text": "برآن بوم و بر کاندرو بود شاه"
  },
  {
    "poem_id": 1662,
    "vorder": 15,
    "position": 0,
    "text": "چو قیدافه آگه شد از قیدروش"
  },
  {
    "poem_id": 1662,
    "vorder": 16,
    "position": 1,
    "text": "ز بهر پسر پهن بگشاد گوش"
  },
  {
    "poem_id": 1662,
    "vorder": 17,
    "position": 0,
    "text": "پذیره شدش با سپاهی گران"
  },
  {
    "poem_id": 1662,
    "vorder": 18,
    "position": 1,
    "text": "همه نامداران و نیک اختران"
  },
  {
    "poem_id": 1662,
    "vorder": 19,
    "position": 0,
    "text": "پسر نیز چون مادرش را بدید"
  },
  {
    "poem_id": 1662,
    "vorder": 20,
    "position": 1,
    "text": "پیاده شد و آفرین گسترید"
  },
  {
    "poem_id": 1662,
    "vorder": 21,
    "position": 0,
    "text": "بفرمود قیدافه تا برنشست"
  },
  {
    "poem_id": 1662,
    "vorder": 22,
    "position": 1,
    "text": "همی راند و دستش گرفته به دست"
  },
  {
    "poem_id": 1662,
    "vorder": 23,
    "position": 0,
    "text": "بدو قیدروش آنچ دید و شنید"
  },
  {
    "poem_id": 1662,
    "vorder": 24,
    "position": 1,
    "text": "همی گفت و رنگ رخش ناپدید"
  },
  {
    "poem_id": 1662,
    "vorder": 25,
    "position": 0,
    "text": "که بر شهر فریان چه آمد ز رنج"
  },
  {
    "poem_id": 1662,
    "vorder": 26,
    "position": 1,
    "text": "نماند افسر و تخت و لشکر نه گنج"
  },
  {
    "poem_id": 1662,
    "vorder": 27,
    "position": 0,
    "text": "مرا این که آمد همی با عروس"
  },
  {
    "poem_id": 1662,
    "vorder": 28,
    "position": 1,
    "text": "رها کرد ز اسکندر فیلقوس"
  },
  {
    "poem_id": 1662,
    "vorder": 29,
    "position": 0,
    "text": "وگرنه بفرمود تا گردنم"
  },
  {
    "poem_id": 1662,
    "vorder": 30,
    "position": 1,
    "text": "زنند و به آتش بسوزد تنم"
  },
  {
    "poem_id": 1662,
    "vorder": 31,
    "position": 0,
    "text": "کنون هرچ باید به خوبی بکن"
  },
  {
    "poem_id": 1662,
    "vorder": 32,
    "position": 1,
    "text": "برو هیچ مشکن بخواهش سخن"
  },
  {
    "poem_id": 1662,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید قیدافه این از پسر"
  },
  {
    "poem_id": 1662,
    "vorder": 34,
    "position": 1,
    "text": "دلش گشت زان درد زیر و زبر"
  },
  {
    "poem_id": 1662,
    "vorder": 35,
    "position": 0,
    "text": "از ایوان فرستاده را پیش خواند"
  },
  {
    "poem_id": 1662,
    "vorder": 36,
    "position": 1,
    "text": "به تخت گرانمایگان برنشاند"
  },
  {
    "poem_id": 1662,
    "vorder": 37,
    "position": 0,
    "text": "فراوان بپرسید و بنواختش"
  },
  {
    "poem_id": 1662,
    "vorder": 38,
    "position": 1,
    "text": "یکی مایه‌ور جایگه ساختش"
  },
  {
    "poem_id": 1662,
    "vorder": 39,
    "position": 0,
    "text": "فرستاد هرگونه‌ای خوردنی"
  },
  {
    "poem_id": 1662,
    "vorder": 40,
    "position": 1,
    "text": "ز پوشیدنی هم ز گستردنی"
  },
  {
    "poem_id": 1662,
    "vorder": 41,
    "position": 0,
    "text": "بشد آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1662,
    "vorder": 42,
    "position": 1,
    "text": "به پرسش بیامد به درگاه شاه"
  },
  {
    "poem_id": 1662,
    "vorder": 43,
    "position": 0,
    "text": "پرستندگان پرده برداشتند"
  },
  {
    "poem_id": 1662,
    "vorder": 44,
    "position": 1,
    "text": "بر اسپش ز درگاه بگذاشتند"
  },
  {
    "poem_id": 1662,
    "vorder": 45,
    "position": 0,
    "text": "چو قیدافه را دید بر تخت عاج"
  },
  {
    "poem_id": 1662,
    "vorder": 46,
    "position": 1,
    "text": "ز یاقوت و پیروزه بر سرش تاج"
  },
  {
    "poem_id": 1662,
    "vorder": 47,
    "position": 0,
    "text": "ز زربفت پوشیده چینی قبای"
  },
  {
    "poem_id": 1662,
    "vorder": 48,
    "position": 1,
    "text": "فراوان پرستنده گردش به پای"
  },
  {
    "poem_id": 1662,
    "vorder": 49,
    "position": 0,
    "text": "رخ شاه تابان به کردار هور"
  },
  {
    "poem_id": 1662,
    "vorder": 50,
    "position": 1,
    "text": "نشستن گهش را ستونها بلور"
  },
  {
    "poem_id": 1662,
    "vorder": 51,
    "position": 0,
    "text": "زبر پوششی جزع بسته به زر"
  },
  {
    "poem_id": 1662,
    "vorder": 52,
    "position": 1,
    "text": "برو بافته دانه‌های گهر"
  },
  {
    "poem_id": 1662,
    "vorder": 53,
    "position": 0,
    "text": "پرستنده با طوق و با گوشوار"
  },
  {
    "poem_id": 1662,
    "vorder": 54,
    "position": 1,
    "text": "به پای اندر آن گلشن زرنگار"
  },
  {
    "poem_id": 1662,
    "vorder": 55,
    "position": 0,
    "text": "سکندر بدان درشگفتی بماند"
  },
  {
    "poem_id": 1662,
    "vorder": 56,
    "position": 1,
    "text": "فراوان نهان نام یزدان بخواند"
  },
  {
    "poem_id": 1662,
    "vorder": 57,
    "position": 0,
    "text": "نشستن گهی دید مهتر که نیز"
  },
  {
    "poem_id": 1662,
    "vorder": 58,
    "position": 1,
    "text": "نیامد ورا روم و ایران به چیز"
  },
  {
    "poem_id": 1662,
    "vorder": 59,
    "position": 0,
    "text": "بر مهتر آمد زمین داد بوس"
  },
  {
    "poem_id": 1662,
    "vorder": 60,
    "position": 1,
    "text": "چنانچون بود مردم چاپلوس"
  },
  {
    "poem_id": 1662,
    "vorder": 61,
    "position": 0,
    "text": "ورا دید قیدافه بنواختش"
  },
  {
    "poem_id": 1662,
    "vorder": 62,
    "position": 1,
    "text": "بپرسید بسیار و بنشاختش"
  },
  {
    "poem_id": 1662,
    "vorder": 63,
    "position": 0,
    "text": "چو خورشید تابان ز گنبد بگشت"
  },
  {
    "poem_id": 1662,
    "vorder": 64,
    "position": 1,
    "text": "گه بار بیگانه اندر گذشت"
  },
  {
    "poem_id": 1662,
    "vorder": 65,
    "position": 0,
    "text": "بفرمود تا خوان بیاراستند"
  },
  {
    "poem_id": 1662,
    "vorder": 66,
    "position": 1,
    "text": "پرستندهٔ رود و می خواستند"
  },
  {
    "poem_id": 1662,
    "vorder": 67,
    "position": 0,
    "text": "نهادند یک خانه خوانهای ساج"
  },
  {
    "poem_id": 1662,
    "vorder": 68,
    "position": 1,
    "text": "همه پیکرش زر و کوکبش عاج"
  },
  {
    "poem_id": 1662,
    "vorder": 69,
    "position": 0,
    "text": "خورشهای بسیار آورده شد"
  },
  {
    "poem_id": 1662,
    "vorder": 70,
    "position": 1,
    "text": "می آورد و چون خوردنی خورده شد"
  },
  {
    "poem_id": 1662,
    "vorder": 71,
    "position": 0,
    "text": "طبقهای زرین و سیمین نهاد"
  },
  {
    "poem_id": 1662,
    "vorder": 72,
    "position": 1,
    "text": "نخستین ز قیدافه کردند یاد"
  },
  {
    "poem_id": 1662,
    "vorder": 73,
    "position": 0,
    "text": "به می خوردن اندر گرانمایه شاه"
  },
  {
    "poem_id": 1662,
    "vorder": 74,
    "position": 1,
    "text": "فزون کرد سوی سکندر نگاه"
  },
  {
    "poem_id": 1662,
    "vorder": 75,
    "position": 0,
    "text": "به گنجور گفت آن درخشان حریر"
  },
  {
    "poem_id": 1662,
    "vorder": 76,
    "position": 1,
    "text": "نوشته برو صورت دلپذیر"
  },
  {
    "poem_id": 1662,
    "vorder": 77,
    "position": 0,
    "text": "به پیش من آور چنان هم که هست"
  },
  {
    "poem_id": 1662,
    "vorder": 78,
    "position": 1,
    "text": "به تندی برو هیچ مبسای دست"
  },
  {
    "poem_id": 1662,
    "vorder": 79,
    "position": 0,
    "text": "بیاورد گنجور و بنهاد پیش"
  },
  {
    "poem_id": 1662,
    "vorder": 80,
    "position": 1,
    "text": "چو دیدش نگه کرد ز اندازه بیش"
  },
  {
    "poem_id": 1662,
    "vorder": 81,
    "position": 0,
    "text": "بدانست قیدافه کو قیصرست"
  },
  {
    "poem_id": 1662,
    "vorder": 82,
    "position": 1,
    "text": "بران لشکر نامور مهترست"
  },
  {
    "poem_id": 1662,
    "vorder": 83,
    "position": 0,
    "text": "فرستاده‌ای کرده از خویشتن"
  },
  {
    "poem_id": 1662,
    "vorder": 84,
    "position": 1,
    "text": "دلیر آمدست اندرین انجمن"
  },
  {
    "poem_id": 1662,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت کای مرد گسترده کام"
  },
  {
    "poem_id": 1662,
    "vorder": 86,
    "position": 1,
    "text": "بگو تا سکندر چه دادت پیام"
  },
  {
    "poem_id": 1662,
    "vorder": 87,
    "position": 0,
    "text": "چنین داد پاسخ که شاه جهان"
  },
  {
    "poem_id": 1662,
    "vorder": 88,
    "position": 1,
    "text": "سخن گفت با من میان مهان"
  },
  {
    "poem_id": 1662,
    "vorder": 89,
    "position": 0,
    "text": "که قیدافهٔ پاکدل را بگوی"
  },
  {
    "poem_id": 1662,
    "vorder": 90,
    "position": 1,
    "text": "که جز راستی در زمانه مجوی"
  },
  {
    "poem_id": 1662,
    "vorder": 91,
    "position": 0,
    "text": "نگر سر نپیچی ز فرمان من"
  },
  {
    "poem_id": 1662,
    "vorder": 92,
    "position": 1,
    "text": "نگه دار بیدار پیمان من"
  },
  {
    "poem_id": 1662,
    "vorder": 93,
    "position": 0,
    "text": "وگر هیچ تاب اندر آری به دل"
  },
  {
    "poem_id": 1662,
    "vorder": 94,
    "position": 1,
    "text": "بیارم یکی لشکری دل گسل"
  },
  {
    "poem_id": 1662,
    "vorder": 95,
    "position": 0,
    "text": "نشان هنرهای تو یافتم"
  },
  {
    "poem_id": 1662,
    "vorder": 96,
    "position": 1,
    "text": "به جنگ آمدن تیز نشتافتم"
  },
  {
    "poem_id": 1662,
    "vorder": 97,
    "position": 0,
    "text": "خردمندی و شرم نزدیک تست"
  },
  {
    "poem_id": 1662,
    "vorder": 98,
    "position": 1,
    "text": "جهان ایمن از رای باریک تست"
  },
  {
    "poem_id": 1662,
    "vorder": 99,
    "position": 0,
    "text": "کنون گر نتابی سر از باژ و ساو"
  },
  {
    "poem_id": 1662,
    "vorder": 100,
    "position": 1,
    "text": "بدانی که با ما نداری تو تاو"
  },
  {
    "poem_id": 1662,
    "vorder": 101,
    "position": 0,
    "text": "نبینی به جز خوبی و راستی"
  },
  {
    "poem_id": 1662,
    "vorder": 102,
    "position": 1,
    "text": "چو پیچی سر از کژی و کاستی"
  },
  {
    "poem_id": 1662,
    "vorder": 103,
    "position": 0,
    "text": "برآشفت قیدافه چون این شنید"
  },
  {
    "poem_id": 1662,
    "vorder": 104,
    "position": 1,
    "text": "بجز خامشی چارهٔ آن ندید"
  },
  {
    "poem_id": 1662,
    "vorder": 105,
    "position": 0,
    "text": "بدو گفت کاکنون ره خانه گیر"
  },
  {
    "poem_id": 1662,
    "vorder": 106,
    "position": 1,
    "text": "بیاسای با مردم دلپذیر"
  },
  {
    "poem_id": 1662,
    "vorder": 107,
    "position": 0,
    "text": "چو فردا بیایی تو پاسخ دهم"
  },
  {
    "poem_id": 1662,
    "vorder": 108,
    "position": 1,
    "text": "به بر گشتنت رای فرخ نهم"
  },
  {
    "poem_id": 1662,
    "vorder": 109,
    "position": 0,
    "text": "سکندر بیامد سوی خان خویش"
  },
  {
    "poem_id": 1662,
    "vorder": 110,
    "position": 1,
    "text": "همه شب همی ساخت درمان خویش"
  },
  {
    "poem_id": 1662,
    "vorder": 111,
    "position": 0,
    "text": "چو بر زد سر از کوه روشن چراغ"
  },
  {
    "poem_id": 1662,
    "vorder": 112,
    "position": 1,
    "text": "چو دیبا فروزنده شد دشت و راغ"
  },
  {
    "poem_id": 1662,
    "vorder": 113,
    "position": 0,
    "text": "سکندر بیامد بران بارگاه"
  },
  {
    "poem_id": 1662,
    "vorder": 114,
    "position": 1,
    "text": "دو لب پر ز خنده دل از غم تباه"
  },
  {
    "poem_id": 1662,
    "vorder": 115,
    "position": 0,
    "text": "فرستاده را دید سالار بار"
  },
  {
    "poem_id": 1662,
    "vorder": 116,
    "position": 1,
    "text": "بپرسید و بردش بر شهریار"
  },
  {
    "poem_id": 1662,
    "vorder": 117,
    "position": 0,
    "text": "همه کاخ او پر ز بیگانه بود"
  },
  {
    "poem_id": 1662,
    "vorder": 118,
    "position": 1,
    "text": "نشستن بلورین یکی خانه بود"
  },
  {
    "poem_id": 1662,
    "vorder": 119,
    "position": 0,
    "text": "عقیق و زبرجد بروبر نگار"
  },
  {
    "poem_id": 1662,
    "vorder": 120,
    "position": 1,
    "text": "میان اندرون گوهر شاهوار"
  },
  {
    "poem_id": 1662,
    "vorder": 121,
    "position": 0,
    "text": "زمینش همه صندل و چوب عود"
  },
  {
    "poem_id": 1662,
    "vorder": 122,
    "position": 1,
    "text": "ز جزع و ز پیروزه او را عمود"
  },
  {
    "poem_id": 1662,
    "vorder": 123,
    "position": 0,
    "text": "سکندر فروماند زان جایگاه"
  },
  {
    "poem_id": 1662,
    "vorder": 124,
    "position": 1,
    "text": "ازان فر و اورنگ و آن دستگاه"
  },
  {
    "poem_id": 1662,
    "vorder": 125,
    "position": 0,
    "text": "همی گفت کاینت سرای نشست"
  },
  {
    "poem_id": 1662,
    "vorder": 126,
    "position": 1,
    "text": "نبیند چنین جای یزدان پرست"
  },
  {
    "poem_id": 1662,
    "vorder": 127,
    "position": 0,
    "text": "خرامان بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1662,
    "vorder": 128,
    "position": 1,
    "text": "نهادند زرین یکی زیرگاه"
  },
  {
    "poem_id": 1662,
    "vorder": 129,
    "position": 0,
    "text": "بدو گفت قیدافه ای بیطقون"
  },
  {
    "poem_id": 1662,
    "vorder": 130,
    "position": 1,
    "text": "چرا خیره ماندی به جزع اندرون"
  },
  {
    "poem_id": 1662,
    "vorder": 131,
    "position": 0,
    "text": "همانا که چونین نباشد به روم"
  },
  {
    "poem_id": 1662,
    "vorder": 132,
    "position": 1,
    "text": "که آسیمه گشتی بدین مایه بوم"
  },
  {
    "poem_id": 1662,
    "vorder": 133,
    "position": 0,
    "text": "سکندر بدو گفت کای شهریار"
  },
  {
    "poem_id": 1662,
    "vorder": 134,
    "position": 1,
    "text": "تو این خانه را خوارمایه مدار"
  },
  {
    "poem_id": 1662,
    "vorder": 135,
    "position": 0,
    "text": "ز ایوان شاهان سرش برترست"
  },
  {
    "poem_id": 1662,
    "vorder": 136,
    "position": 1,
    "text": "که ایوان تو معدن گوهرست"
  },
  {
    "poem_id": 1662,
    "vorder": 137,
    "position": 0,
    "text": "بخندید قیدافه از کار اوی"
  },
  {
    "poem_id": 1662,
    "vorder": 138,
    "position": 1,
    "text": "دلش گشت خرم به بازار اوی"
  },
  {
    "poem_id": 1662,
    "vorder": 139,
    "position": 0,
    "text": "ازان پس بدر کرد کسهای خویش"
  },
  {
    "poem_id": 1662,
    "vorder": 140,
    "position": 1,
    "text": "فرستاده را تنگ بنشاند پیش"
  },
  {
    "poem_id": 1662,
    "vorder": 141,
    "position": 0,
    "text": "بدو گفت کای زادهٔ فیلقوس"
  },
  {
    "poem_id": 1662,
    "vorder": 142,
    "position": 1,
    "text": "همت بزم و رزمست و هم نعم و بوس"
  },
  {
    "poem_id": 1662,
    "vorder": 143,
    "position": 0,
    "text": "سکندر ز گفتار او گشت زرد"
  },
  {
    "poem_id": 1662,
    "vorder": 144,
    "position": 1,
    "text": "روان پر ز درد و رخان لاژورد"
  },
  {
    "poem_id": 1662,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت کای مهتر پرخرد"
  },
  {
    "poem_id": 1662,
    "vorder": 146,
    "position": 1,
    "text": "چنین گفتن از تو نه اندر خورد"
  },
  {
    "poem_id": 1662,
    "vorder": 147,
    "position": 0,
    "text": "منم بیطقون کدخدای جهان"
  },
  {
    "poem_id": 1662,
    "vorder": 148,
    "position": 1,
    "text": "چنین تخمهٔ فیلقوسم مخوان"
  },
  {
    "poem_id": 1662,
    "vorder": 149,
    "position": 0,
    "text": "سپاسم ز یزدان پروردگار"
  },
  {
    "poem_id": 1662,
    "vorder": 150,
    "position": 1,
    "text": "که با من نبد مهتری نامدار"
  },
  {
    "poem_id": 1662,
    "vorder": 151,
    "position": 0,
    "text": "که بردی به شاه جهان آگهی"
  },
  {
    "poem_id": 1662,
    "vorder": 152,
    "position": 1,
    "text": "تنم را ز جان زود کردی تهی"
  },
  {
    "poem_id": 1662,
    "vorder": 153,
    "position": 0,
    "text": "بدو گفت قیدافه کز داوری"
  },
  {
    "poem_id": 1662,
    "vorder": 154,
    "position": 1,
    "text": "لبت را بپرداز کاسکندری"
  },
  {
    "poem_id": 1662,
    "vorder": 155,
    "position": 0,
    "text": "اگر چهرهٔ خویش بینی به چشم"
  },
  {
    "poem_id": 1662,
    "vorder": 156,
    "position": 1,
    "text": "ز چاره بیاسای و منمای خشم"
  },
  {
    "poem_id": 1662,
    "vorder": 157,
    "position": 0,
    "text": "بیاورد و بنهاد پیشش حریر"
  },
  {
    "poem_id": 1662,
    "vorder": 158,
    "position": 1,
    "text": "نوشته برو صورت دلپذیر"
  },
  {
    "poem_id": 1662,
    "vorder": 159,
    "position": 0,
    "text": "که گر هیچ جنبش بدی در نگار"
  },
  {
    "poem_id": 1662,
    "vorder": 160,
    "position": 1,
    "text": "نبودی جز اسکندر شهریار"
  },
  {
    "poem_id": 1662,
    "vorder": 161,
    "position": 0,
    "text": "سکندر چو دید آن بخایید لب"
  },
  {
    "poem_id": 1662,
    "vorder": 162,
    "position": 1,
    "text": "برو تیره شد روز چون تیره شب"
  },
  {
    "poem_id": 1662,
    "vorder": 163,
    "position": 0,
    "text": "چنین گفت بی‌خنجری در نهان"
  },
  {
    "poem_id": 1662,
    "vorder": 164,
    "position": 1,
    "text": "مبادا که باشد کس اندر جهان"
  },
  {
    "poem_id": 1662,
    "vorder": 165,
    "position": 0,
    "text": "بدو گفت قیدافه گر خنجرت"
  },
  {
    "poem_id": 1662,
    "vorder": 166,
    "position": 1,
    "text": "حمایل بدی پیش من بر برت"
  },
  {
    "poem_id": 1662,
    "vorder": 167,
    "position": 0,
    "text": "نه نیروت بودی نه شمشیر تیز"
  },
  {
    "poem_id": 1662,
    "vorder": 168,
    "position": 1,
    "text": "نه جای نبرد و نه راه گریز"
  },
  {
    "poem_id": 1662,
    "vorder": 169,
    "position": 0,
    "text": "سکندر بدو گفت هر کز مهان"
  },
  {
    "poem_id": 1662,
    "vorder": 170,
    "position": 1,
    "text": "به مردی بود خواستار جهان"
  },
  {
    "poem_id": 1662,
    "vorder": 171,
    "position": 0,
    "text": "نباید که پیچد ز راه گزند"
  },
  {
    "poem_id": 1662,
    "vorder": 172,
    "position": 1,
    "text": "که بد دل به گیتی نگردد بلند"
  },
  {
    "poem_id": 1662,
    "vorder": 173,
    "position": 0,
    "text": "اگر با منستی سلیحم کنون"
  },
  {
    "poem_id": 1662,
    "vorder": 174,
    "position": 1,
    "text": "همه خانه گشتی چو دریای خون"
  },
  {
    "poem_id": 1662,
    "vorder": 175,
    "position": 0,
    "text": "ترا کشتمی گر جگرگاه خویش"
  },
  {
    "poem_id": 1662,
    "vorder": 176,
    "position": 1,
    "text": "بدریدمی پیش بدخواه خویش"
  }
]