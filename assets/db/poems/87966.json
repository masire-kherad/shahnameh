[
  {
    "poem_id": 87966,
    "vorder": 1,
    "position": 0,
    "text": "همی گفت و جوشن همی بست گرم"
  },
  {
    "poem_id": 87966,
    "vorder": 2,
    "position": 1,
    "text": "همی بر تنش بر بدرید چرم"
  },
  {
    "poem_id": 87966,
    "vorder": 3,
    "position": 0,
    "text": "نشست از بر اژدهای دژم"
  },
  {
    "poem_id": 87966,
    "vorder": 4,
    "position": 1,
    "text": "خرامان بیامد براه چرم"
  },
  {
    "poem_id": 87966,
    "vorder": 5,
    "position": 0,
    "text": "فرود سیاوش چو او را بدید"
  },
  {
    "poem_id": 87966,
    "vorder": 6,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 87966,
    "vorder": 7,
    "position": 0,
    "text": "همی گفت کین لشکر رزمساز"
  },
  {
    "poem_id": 87966,
    "vorder": 8,
    "position": 1,
    "text": "ندانند راه نشیب و فراز"
  },
  {
    "poem_id": 87966,
    "vorder": 9,
    "position": 0,
    "text": "همه یک ز دیگر دلاورترند"
  },
  {
    "poem_id": 87966,
    "vorder": 10,
    "position": 1,
    "text": "چو خورشید تابان بدو پیکرند"
  },
  {
    "poem_id": 87966,
    "vorder": 11,
    "position": 0,
    "text": "ولیکن خرد نیست با پهلوان"
  },
  {
    "poem_id": 87966,
    "vorder": 12,
    "position": 1,
    "text": "سر بی‌خرد چون تن بی‌روان"
  },
  {
    "poem_id": 87966,
    "vorder": 13,
    "position": 0,
    "text": "نباشند پیروز ترسم بکین"
  },
  {
    "poem_id": 87966,
    "vorder": 14,
    "position": 1,
    "text": "مگر خسرو آید بتوران زمین"
  },
  {
    "poem_id": 87966,
    "vorder": 15,
    "position": 0,
    "text": "بکین پدر جمله پشت آوریم"
  },
  {
    "poem_id": 87966,
    "vorder": 16,
    "position": 1,
    "text": "مگر دشمنان را به مشت آوریم"
  },
  {
    "poem_id": 87966,
    "vorder": 17,
    "position": 0,
    "text": "بگوکین سوار سرافراز کیست"
  },
  {
    "poem_id": 87966,
    "vorder": 18,
    "position": 1,
    "text": "که بر دست و تیغش بباید گریست"
  },
  {
    "poem_id": 87966,
    "vorder": 19,
    "position": 0,
    "text": "نگه کرد ز افراز بالا تخوار"
  },
  {
    "poem_id": 87966,
    "vorder": 20,
    "position": 1,
    "text": "ببی دانشی بر چمن رست خار"
  },
  {
    "poem_id": 87966,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت کین اژدهای دژم"
  },
  {
    "poem_id": 87966,
    "vorder": 22,
    "position": 1,
    "text": "که مرغ از هوا اندر آرد بدم"
  },
  {
    "poem_id": 87966,
    "vorder": 23,
    "position": 0,
    "text": "که دست نیای تو پیران ببست"
  },
  {
    "poem_id": 87966,
    "vorder": 24,
    "position": 1,
    "text": "دو لشکر ز ترکان بهم برشکست"
  },
  {
    "poem_id": 87966,
    "vorder": 25,
    "position": 0,
    "text": "بسی بی‌پدر کرد فرزند خرد"
  },
  {
    "poem_id": 87966,
    "vorder": 26,
    "position": 1,
    "text": "بسی کوه و رود و بیابان سپرد"
  },
  {
    "poem_id": 87966,
    "vorder": 27,
    "position": 0,
    "text": "پدر نیز ازو شد بسی بی‌پسر"
  },
  {
    "poem_id": 87966,
    "vorder": 28,
    "position": 1,
    "text": "بپی بسپرد گردن شیر نر"
  },
  {
    "poem_id": 87966,
    "vorder": 29,
    "position": 0,
    "text": "بایران برادرت را او کشید"
  },
  {
    "poem_id": 87966,
    "vorder": 30,
    "position": 1,
    "text": "بجیحون گذر کرد و کشتی ندید"
  },
  {
    "poem_id": 87966,
    "vorder": 31,
    "position": 0,
    "text": "وراگیو خوانند پیلست و بس"
  },
  {
    "poem_id": 87966,
    "vorder": 32,
    "position": 1,
    "text": "که در رزم دریای نیلست و بس"
  },
  {
    "poem_id": 87966,
    "vorder": 33,
    "position": 0,
    "text": "چو بر زه بشست اندر آری گره"
  },
  {
    "poem_id": 87966,
    "vorder": 34,
    "position": 1,
    "text": "خدنگت نیابد گذر بر زره"
  },
  {
    "poem_id": 87966,
    "vorder": 35,
    "position": 0,
    "text": "سلیح سیاوش بپوشد بجنگ"
  },
  {
    "poem_id": 87966,
    "vorder": 36,
    "position": 1,
    "text": "نترسد ز پیکان تیر خدنگ"
  },
  {
    "poem_id": 87966,
    "vorder": 37,
    "position": 0,
    "text": "بکش چرخ و پیکان سوی اسپ ران"
  },
  {
    "poem_id": 87966,
    "vorder": 38,
    "position": 1,
    "text": "مگر خسته گردد هیون گران"
  },
  {
    "poem_id": 87966,
    "vorder": 39,
    "position": 0,
    "text": "پیاده شود بازگردد مگر"
  },
  {
    "poem_id": 87966,
    "vorder": 40,
    "position": 1,
    "text": "کشان چون سپهبد بگردن سپر"
  },
  {
    "poem_id": 87966,
    "vorder": 41,
    "position": 0,
    "text": "کمان را بزه کرد جنگی فرود"
  },
  {
    "poem_id": 87966,
    "vorder": 42,
    "position": 1,
    "text": "پس آن قبضهٔ چرخ بر کف بسود"
  },
  {
    "poem_id": 87966,
    "vorder": 43,
    "position": 0,
    "text": "بزد تیر بر سینهٔ اسپ گیو"
  },
  {
    "poem_id": 87966,
    "vorder": 44,
    "position": 1,
    "text": "فرود آمد از باره برگشت نیو"
  },
  {
    "poem_id": 87966,
    "vorder": 45,
    "position": 0,
    "text": "ز بام سپد کوه خنده بخاست"
  },
  {
    "poem_id": 87966,
    "vorder": 46,
    "position": 1,
    "text": "همی مغز گیو از گواژه بکاست"
  },
  {
    "poem_id": 87966,
    "vorder": 47,
    "position": 0,
    "text": "برفتند گردان همه پیش گیو"
  },
  {
    "poem_id": 87966,
    "vorder": 48,
    "position": 1,
    "text": "که یزدان سپاس ای سپهدار نیو"
  },
  {
    "poem_id": 87966,
    "vorder": 49,
    "position": 0,
    "text": "که اسپ است خسته تو خسته نه‌ای"
  },
  {
    "poem_id": 87966,
    "vorder": 50,
    "position": 1,
    "text": "توان شد دگر بار بسته نه‌ای"
  },
  {
    "poem_id": 87966,
    "vorder": 51,
    "position": 0,
    "text": "برگیو شد بیژن شیر مرد"
  },
  {
    "poem_id": 87966,
    "vorder": 52,
    "position": 1,
    "text": "فراوان سخنها بگفت از نبرد"
  },
  {
    "poem_id": 87966,
    "vorder": 53,
    "position": 0,
    "text": "که ای باب شیراوژن تیزچنگ"
  },
  {
    "poem_id": 87966,
    "vorder": 54,
    "position": 1,
    "text": "کجا پیل با تو نرفتی بجنگ"
  },
  {
    "poem_id": 87966,
    "vorder": 55,
    "position": 0,
    "text": "چرا دید پشت ترا یک سوار"
  },
  {
    "poem_id": 87966,
    "vorder": 56,
    "position": 1,
    "text": "که دست تو بودی بهر کارزار"
  },
  {
    "poem_id": 87966,
    "vorder": 57,
    "position": 0,
    "text": "ز ترکی چنین اسپ خسته بدست"
  },
  {
    "poem_id": 87966,
    "vorder": 58,
    "position": 1,
    "text": "برفتی سراسیمه برسان مست"
  },
  {
    "poem_id": 87966,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت چون کشته شد بارگی"
  },
  {
    "poem_id": 87966,
    "vorder": 60,
    "position": 1,
    "text": "بدو دادمی سر به یکبارگی"
  },
  {
    "poem_id": 87966,
    "vorder": 61,
    "position": 0,
    "text": "همی گفت گفتارهای درشت"
  },
  {
    "poem_id": 87966,
    "vorder": 62,
    "position": 1,
    "text": "چو بیژن چنان دید بنمود پشت"
  },
  {
    "poem_id": 87966,
    "vorder": 63,
    "position": 0,
    "text": "برآشفت گیو از گشاد برش"
  },
  {
    "poem_id": 87966,
    "vorder": 64,
    "position": 1,
    "text": "یکی تازیانه بزد بر سرش"
  },
  {
    "poem_id": 87966,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت نشنیدی از رهنمای"
  },
  {
    "poem_id": 87966,
    "vorder": 66,
    "position": 1,
    "text": "که با رزمت اندیشه باید بجای"
  },
  {
    "poem_id": 87966,
    "vorder": 67,
    "position": 0,
    "text": "نه تو مغز داری نه رای و خرد"
  },
  {
    "poem_id": 87966,
    "vorder": 68,
    "position": 1,
    "text": "چنین گفت را کس بکیفر برد"
  },
  {
    "poem_id": 87966,
    "vorder": 69,
    "position": 0,
    "text": "دل بیژن آمد ز تندی بدرد"
  },
  {
    "poem_id": 87966,
    "vorder": 70,
    "position": 1,
    "text": "بدادار دارنده سوگند خورد"
  },
  {
    "poem_id": 87966,
    "vorder": 71,
    "position": 0,
    "text": "که زین را نگردانم از پشت اسپ"
  },
  {
    "poem_id": 87966,
    "vorder": 72,
    "position": 1,
    "text": "مگر کشته آیم بکین زرسپ"
  },
  {
    "poem_id": 87966,
    "vorder": 73,
    "position": 0,
    "text": "وزآنجا بیامد دلی پر ز غم"
  },
  {
    "poem_id": 87966,
    "vorder": 74,
    "position": 1,
    "text": "سری پر ز کینه بر گستهم"
  },
  {
    "poem_id": 87966,
    "vorder": 75,
    "position": 0,
    "text": "کز اسپان تو باره‌ای دستکش"
  },
  {
    "poem_id": 87966,
    "vorder": 76,
    "position": 1,
    "text": "کجا بر خرامد بافراز خوش"
  },
  {
    "poem_id": 87966,
    "vorder": 77,
    "position": 0,
    "text": "بده تا بپوشم سلیح نبرد"
  },
  {
    "poem_id": 87966,
    "vorder": 78,
    "position": 1,
    "text": "یکی تا پدید آید از مردمرد"
  },
  {
    "poem_id": 87966,
    "vorder": 79,
    "position": 0,
    "text": "یکی ترک رفتست بر تیغ کوه"
  },
  {
    "poem_id": 87966,
    "vorder": 80,
    "position": 1,
    "text": "بدین سان نظاره برو بر گروه"
  },
  {
    "poem_id": 87966,
    "vorder": 81,
    "position": 0,
    "text": "چنین داد پاسخ که این نیست روی"
  },
  {
    "poem_id": 87966,
    "vorder": 82,
    "position": 1,
    "text": "ابر خیره گرد بلاها مپوی"
  },
  {
    "poem_id": 87966,
    "vorder": 83,
    "position": 0,
    "text": "زرسپ سپهدار چون ریونیز"
  },
  {
    "poem_id": 87966,
    "vorder": 84,
    "position": 1,
    "text": "سپهبد که گیتی ندارد بچیز"
  },
  {
    "poem_id": 87966,
    "vorder": 85,
    "position": 0,
    "text": "پدرت آنکه پیل ژیان بشکرد"
  },
  {
    "poem_id": 87966,
    "vorder": 86,
    "position": 1,
    "text": "بگردنده گردون همی ننگرد"
  },
  {
    "poem_id": 87966,
    "vorder": 87,
    "position": 0,
    "text": "ازو بازگشتند دل پر ز درد"
  },
  {
    "poem_id": 87966,
    "vorder": 88,
    "position": 1,
    "text": "کس آورد با کوه خارا نکرد"
  },
  {
    "poem_id": 87966,
    "vorder": 89,
    "position": 0,
    "text": "مگر پر کرگس بود رهنمای"
  },
  {
    "poem_id": 87966,
    "vorder": 90,
    "position": 1,
    "text": "وگرنه بران دژ که پوید بپای"
  },
  {
    "poem_id": 87966,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت بیژن که مشکن دلم"
  },
  {
    "poem_id": 87966,
    "vorder": 92,
    "position": 1,
    "text": "کنون یال و بازو ز هم بگسلم"
  },
  {
    "poem_id": 87966,
    "vorder": 93,
    "position": 0,
    "text": "یکی سخت سوگند خوردم بماه"
  },
  {
    "poem_id": 87966,
    "vorder": 94,
    "position": 1,
    "text": "بدادار گیهان و دیهیم شاه"
  },
  {
    "poem_id": 87966,
    "vorder": 95,
    "position": 0,
    "text": "کزین ترک من برنگردانم اسپ"
  },
  {
    "poem_id": 87966,
    "vorder": 96,
    "position": 1,
    "text": "زمانم سراید مگر چون زرسپ"
  },
  {
    "poem_id": 87966,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت پس گستهم راه نیست"
  },
  {
    "poem_id": 87966,
    "vorder": 98,
    "position": 1,
    "text": "خرد خود از این تیزی آگاه نیست"
  },
  {
    "poem_id": 87966,
    "vorder": 99,
    "position": 0,
    "text": "جهان پرفراز و نشیبست و دشت"
  },
  {
    "poem_id": 87966,
    "vorder": 100,
    "position": 1,
    "text": "گر ایدونک زینجا بباید گذشت"
  },
  {
    "poem_id": 87966,
    "vorder": 101,
    "position": 0,
    "text": "مرا بارگیر اینک جوشن کشد"
  },
  {
    "poem_id": 87966,
    "vorder": 102,
    "position": 1,
    "text": "دو ماندست اگر زین یکی را کشد"
  },
  {
    "poem_id": 87966,
    "vorder": 103,
    "position": 0,
    "text": "نیابم دگر نیز همتای او"
  },
  {
    "poem_id": 87966,
    "vorder": 104,
    "position": 1,
    "text": "برنگ و تگ و زور و بالای اوی"
  },
  {
    "poem_id": 87966,
    "vorder": 105,
    "position": 0,
    "text": "بدو گفت بیژن بکین زرسپ"
  },
  {
    "poem_id": 87966,
    "vorder": 106,
    "position": 1,
    "text": "پیاده بپویم نخواهم خود اسپ"
  },
  {
    "poem_id": 87966,
    "vorder": 107,
    "position": 0,
    "text": "چنین داد پاسخ بدو گستهم"
  },
  {
    "poem_id": 87966,
    "vorder": 108,
    "position": 1,
    "text": "که مویی نخواهم ز تو بیش و کم"
  },
  {
    "poem_id": 87966,
    "vorder": 109,
    "position": 0,
    "text": "مرا گر بود بارگی ده هزار"
  },
  {
    "poem_id": 87966,
    "vorder": 110,
    "position": 1,
    "text": "همه دم پر از گوهر شاهوار"
  },
  {
    "poem_id": 87966,
    "vorder": 111,
    "position": 0,
    "text": "ندارم بدین از تو آن را دریغ"
  },
  {
    "poem_id": 87966,
    "vorder": 112,
    "position": 1,
    "text": "نه گنج و نه جان و نه اسپ و نه تیغ"
  },
  {
    "poem_id": 87966,
    "vorder": 113,
    "position": 0,
    "text": "برو یک بیک بارگیها ببین"
  },
  {
    "poem_id": 87966,
    "vorder": 114,
    "position": 1,
    "text": "کدامت به آید یکی برگزین"
  },
  {
    "poem_id": 87966,
    "vorder": 115,
    "position": 0,
    "text": "بفرمای تا زین بر آن کت هواست"
  },
  {
    "poem_id": 87966,
    "vorder": 116,
    "position": 1,
    "text": "بسازند اگر کشته آید رواست"
  },
  {
    "poem_id": 87966,
    "vorder": 117,
    "position": 0,
    "text": "یکی رخش بودش بکردار گرگ"
  },
  {
    "poem_id": 87966,
    "vorder": 118,
    "position": 1,
    "text": "کشیده زهار و بلند و سترگ"
  },
  {
    "poem_id": 87966,
    "vorder": 119,
    "position": 0,
    "text": "ز بهر جهانجوی مرد جوان"
  },
  {
    "poem_id": 87966,
    "vorder": 120,
    "position": 1,
    "text": "برو برفگندند برگستوان"
  },
  {
    "poem_id": 87966,
    "vorder": 121,
    "position": 0,
    "text": "دل گیو شد زان سخن پر ز دود"
  },
  {
    "poem_id": 87966,
    "vorder": 122,
    "position": 1,
    "text": "چو اندیشه کرد از گشاد فرود"
  },
  {
    "poem_id": 87966,
    "vorder": 123,
    "position": 0,
    "text": "فرستاد و مر گستهم را بخواند"
  },
  {
    "poem_id": 87966,
    "vorder": 124,
    "position": 1,
    "text": "بسی داستانهای نیکو براند"
  },
  {
    "poem_id": 87966,
    "vorder": 125,
    "position": 0,
    "text": "فرستاد درع سیاوش برش"
  },
  {
