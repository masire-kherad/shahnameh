[
  {
    "poem_id": 1710,
    "vorder": 1,
    "position": 0,
    "text": "به دل گفت موبد که بد روزگار"
  },
  {
    "poem_id": 1710,
    "vorder": 2,
    "position": 1,
    "text": "که فرمان چنین آمد از شهریار"
  },
  {
    "poem_id": 1710,
    "vorder": 3,
    "position": 0,
    "text": "همه مرگ راییم برنا و پیر"
  },
  {
    "poem_id": 1710,
    "vorder": 4,
    "position": 1,
    "text": "ندارد پسر شهریار اردشیر"
  },
  {
    "poem_id": 1710,
    "vorder": 5,
    "position": 0,
    "text": "گر او بی‌عدد سالیان بشمرد"
  },
  {
    "poem_id": 1710,
    "vorder": 6,
    "position": 1,
    "text": "به دشمن رسد تخت چون بگذرد"
  },
  {
    "poem_id": 1710,
    "vorder": 7,
    "position": 0,
    "text": "همان به کزین کار ناسودمند"
  },
  {
    "poem_id": 1710,
    "vorder": 8,
    "position": 1,
    "text": "به مردی یکی کار سازم بلند"
  },
  {
    "poem_id": 1710,
    "vorder": 9,
    "position": 0,
    "text": "ز کشتن رهانم مر این ماه را"
  },
  {
    "poem_id": 1710,
    "vorder": 10,
    "position": 1,
    "text": "مگر زین پشیمان کنم شاه را"
  },
  {
    "poem_id": 1710,
    "vorder": 11,
    "position": 0,
    "text": "هرانگه کزو بچه گردد جدا"
  },
  {
    "poem_id": 1710,
    "vorder": 12,
    "position": 1,
    "text": "به جای آرم این گفتهٔ پادشا"
  },
  {
    "poem_id": 1710,
    "vorder": 13,
    "position": 0,
    "text": "نه کاریست کز دل همی بگذرد"
  },
  {
    "poem_id": 1710,
    "vorder": 14,
    "position": 1,
    "text": "خردمند باشم به از بی‌خرد"
  },
  {
    "poem_id": 1710,
    "vorder": 15,
    "position": 0,
    "text": "بیاراست جایی به ایوان خویش"
  },
  {
    "poem_id": 1710,
    "vorder": 16,
    "position": 1,
    "text": "که دارد ورا چون تن و جان خویش"
  },
  {
    "poem_id": 1710,
    "vorder": 17,
    "position": 0,
    "text": "به زن گفت اگر هیچ باد هوا"
  },
  {
    "poem_id": 1710,
    "vorder": 18,
    "position": 1,
    "text": "ببیند ورا من ندارم روا"
  },
  {
    "poem_id": 1710,
    "vorder": 19,
    "position": 0,
    "text": "پس اندیشه کرد آنک دشمن بسیست"
  },
  {
    "poem_id": 1710,
    "vorder": 20,
    "position": 1,
    "text": "گمان بد و نیک با هرکسیست"
  },
  {
    "poem_id": 1710,
    "vorder": 21,
    "position": 0,
    "text": "یکی چاره سازم که بدگوی من"
  },
  {
    "poem_id": 1710,
    "vorder": 22,
    "position": 1,
    "text": "نراند به زشت آب در جوی من"
  },
  {
    "poem_id": 1710,
    "vorder": 23,
    "position": 0,
    "text": "به خانه شد و خایه ببرید پست"
  },
  {
    "poem_id": 1710,
    "vorder": 24,
    "position": 1,
    "text": "برو داغ و دارو نهاد و ببست"
  },
  {
    "poem_id": 1710,
    "vorder": 25,
    "position": 0,
    "text": "به خایه نمک بر پراگند زود"
  },
  {
    "poem_id": 1710,
    "vorder": 26,
    "position": 1,
    "text": "به حقه در آگند بر سان دود"
  },
  {
    "poem_id": 1710,
    "vorder": 27,
    "position": 0,
    "text": "هم‌اندر زمان حقه را مهر کرد"
  },
  {
    "poem_id": 1710,
    "vorder": 28,
    "position": 1,
    "text": "بیامد خروشان و رخساره زرد"
  },
  {
    "poem_id": 1710,
    "vorder": 29,
    "position": 0,
    "text": "چو آمد به نزدیک تخت بلند"
  },
  {
    "poem_id": 1710,
    "vorder": 30,
    "position": 1,
    "text": "همان حقه بنهاد با مهر و بند"
  },
  {
    "poem_id": 1710,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت با شاه کین زینهار"
  },
  {
    "poem_id": 1710,
    "vorder": 32,
    "position": 1,
    "text": "سپارد به گنجور خود شهریار"
  },
  {
    "poem_id": 1710,
    "vorder": 33,
    "position": 0,
    "text": "نوشته بر آن حقه تاریخ آن"
  },
  {
    "poem_id": 1710,
    "vorder": 34,
    "position": 1,
    "text": "پدیدار کرده بن و بیخ آن"
  }
]