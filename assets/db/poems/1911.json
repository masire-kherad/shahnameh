[
  {
    "poem_id": 1911,
    "vorder": 1,
    "position": 0,
    "text": "همی‌بود خسرو بران مرغزار"
  },
  {
    "poem_id": 1911,
    "vorder": 2,
    "position": 1,
    "text": "درخت بلند ازبرش سایه دار"
  },
  {
    "poem_id": 1911,
    "vorder": 3,
    "position": 0,
    "text": "چو بگذشت نیمی ز روز دراز"
  },
  {
    "poem_id": 1911,
    "vorder": 4,
    "position": 1,
    "text": "بنان آمد آن پادشا رانیاز"
  },
  {
    "poem_id": 1911,
    "vorder": 5,
    "position": 0,
    "text": "به باغ اندرون بد یکی پایکار"
  },
  {
    "poem_id": 1911,
    "vorder": 6,
    "position": 1,
    "text": "که نشناختی چهرهٔ شهریار"
  },
  {
    "poem_id": 1911,
    "vorder": 7,
    "position": 0,
    "text": "پرستنده راگفت خورشید فش"
  },
  {
    "poem_id": 1911,
    "vorder": 8,
    "position": 1,
    "text": "که شاخی گهر زین کمر بازکش"
  },
  {
    "poem_id": 1911,
    "vorder": 9,
    "position": 0,
    "text": "بران شاخ برمهرهٔ زر پنج"
  },
  {
    "poem_id": 1911,
    "vorder": 10,
    "position": 1,
    "text": "ز هرگونه مهره بسی برده رنج"
  },
  {
    "poem_id": 1911,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت با باغبان شهریار"
  },
  {
    "poem_id": 1911,
    "vorder": 12,
    "position": 1,
    "text": "که این مهره‌ها تا کت آید به کار"
  },
  {
    "poem_id": 1911,
    "vorder": 13,
    "position": 0,
    "text": "به بازار شو بهره‌ای گوشت خر"
  },
  {
    "poem_id": 1911,
    "vorder": 14,
    "position": 1,
    "text": "دگر نان و بی‌راه جایی گذر"
  },
  {
    "poem_id": 1911,
    "vorder": 15,
    "position": 0,
    "text": "مرآن گوهران را بها سی هزار"
  },
  {
    "poem_id": 1911,
    "vorder": 16,
    "position": 1,
    "text": "درم بد کسی را که بودی به کار"
  },
  {
    "poem_id": 1911,
    "vorder": 17,
    "position": 0,
    "text": "سوی نانبا شد سبک باغبان"
  },
  {
    "poem_id": 1911,
    "vorder": 18,
    "position": 1,
    "text": "بدان شاخ زرین ازو خواست نان"
  },
  {
    "poem_id": 1911,
    "vorder": 19,
    "position": 0,
    "text": "بدو نانوا گفت کاین رابها"
  },
  {
    "poem_id": 1911,
    "vorder": 20,
    "position": 1,
    "text": "ندانم نیارمت کردن رها"
  },
  {
    "poem_id": 1911,
    "vorder": 21,
    "position": 0,
    "text": "ببردند هر دو به گوهر فروش"
  },
  {
    "poem_id": 1911,
    "vorder": 22,
    "position": 1,
    "text": "که این را بها کن بدانش بکوش"
  },
  {
    "poem_id": 1911,
    "vorder": 23,
    "position": 0,
    "text": "چو داننده آن مهره‌ها رابدید"
  },
  {
    "poem_id": 1911,
    "vorder": 24,
    "position": 1,
    "text": "بدو گفت کاین را که یارد خرید"
  },
  {
    "poem_id": 1911,
    "vorder": 25,
    "position": 0,
    "text": "چنین شاخ در گنج خسرو بدی"
  },
  {
    "poem_id": 1911,
    "vorder": 26,
    "position": 1,
    "text": "برین گونه هر سال صد نوبدی"
  },
  {
    "poem_id": 1911,
    "vorder": 27,
    "position": 0,
    "text": "تو این گوهران از که دزدیده‌ای"
  },
  {
    "poem_id": 1911,
    "vorder": 28,
    "position": 1,
    "text": "گر از بنده خفته ببریده‌ای"
  },
  {
    "poem_id": 1911,
    "vorder": 29,
    "position": 0,
    "text": "سوی زاد فرخ شدند آن سه مرد"
  },
  {
    "poem_id": 1911,
    "vorder": 30,
    "position": 1,
    "text": "ابا گوهر و زر و با کارکرد"
  },
  {
    "poem_id": 1911,
    "vorder": 31,
    "position": 0,
    "text": "چو آن گوهران زاد فرخ بدید"
  },
  {
    "poem_id": 1911,
    "vorder": 32,
    "position": 1,
    "text": "سوی شهریار نو اندر کشید"
  },
  {
    "poem_id": 1911,
    "vorder": 33,
    "position": 0,
    "text": "به شیروی بنمود زان سان گهر"
  },
  {
    "poem_id": 1911,
    "vorder": 34,
    "position": 1,
    "text": "بریده یکی شاخ زرین کمر"
  },
  {
    "poem_id": 1911,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت شیروی با باغبان"
  },
  {
    "poem_id": 1911,
    "vorder": 36,
    "position": 1,
    "text": "که گر زین خداوند گوهر نشان"
  },
  {
    "poem_id": 1911,
    "vorder": 37,
    "position": 0,
    "text": "نگویی هم اکنون ببرم سرت"
  },
  {
    "poem_id": 1911,
    "vorder": 38,
    "position": 1,
    "text": "همان را که او باشد از گوهرت"
  },
  {
    "poem_id": 1911,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت شاها به باغ اندرست"
  },
  {
    "poem_id": 1911,
    "vorder": 40,
    "position": 1,
    "text": "زره پوش مردی کمانی بدست"
  },
  {
    "poem_id": 1911,
    "vorder": 41,
    "position": 0,
    "text": "ببالا چو سرو و به رخ چون بهار"
  },
  {
    "poem_id": 1911,
    "vorder": 42,
    "position": 1,
    "text": "بهر چیز مانندهٔ شهریار"
  },
  {
    "poem_id": 1911,
    "vorder": 43,
    "position": 0,
    "text": "سراسر همه باغ زو روشنست"
  },
  {
    "poem_id": 1911,
    "vorder": 44,
    "position": 1,
    "text": "چو خورشید تابنده در جوشنست"
  },
  {
    "poem_id": 1911,
    "vorder": 45,
    "position": 0,
    "text": "فروهشته از شاخ زرین سپر"
  },
  {
    "poem_id": 1911,
    "vorder": 46,
    "position": 1,
    "text": "یکی بنده در پیش او با کمر"
  },
  {
    "poem_id": 1911,
    "vorder": 47,
    "position": 0,
    "text": "برید این چنین شاخ گوهر ازوی"
  },
  {
    "poem_id": 1911,
    "vorder": 48,
    "position": 1,
    "text": "مراداد و گفتا کز ایدر بپوی"
  },
  {
    "poem_id": 1911,
    "vorder": 49,
    "position": 0,
    "text": "ز بازار نان آور و نان خورش"
  },
  {
    "poem_id": 1911,
    "vorder": 50,
    "position": 1,
    "text": "هم اکنون برفتم چو باد از برش"
  },
  {
    "poem_id": 1911,
    "vorder": 51,
    "position": 0,
    "text": "بدانست شیروی کو خسروست"
  },
  {
    "poem_id": 1911,
    "vorder": 52,
    "position": 1,
    "text": "که دیدار او در زمانه نوست"
  },
  {
    "poem_id": 1911,
    "vorder": 53,
    "position": 0,
    "text": "ز درگاه رفتند سیصد سوار"
  },
  {
    "poem_id": 1911,
    "vorder": 54,
    "position": 1,
    "text": "چو باد دمان تا لب جویبار"
  },
  {
    "poem_id": 1911,
    "vorder": 55,
    "position": 0,
    "text": "چو خسرو ز دور آن سپه را بدید"
  },
  {
    "poem_id": 1911,
    "vorder": 56,
    "position": 1,
    "text": "به پژمرد و شمشیر کین برکشید"
  },
  {
    "poem_id": 1911,
    "vorder": 57,
    "position": 0,
    "text": "چو روی شهنشاه دید آن سپاه"
  },
  {
    "poem_id": 1911,
    "vorder": 58,
    "position": 1,
    "text": "همه باز گشتند گریان ز راه"
  },
  {
    "poem_id": 1911,
    "vorder": 59,
    "position": 0,
    "text": "یکایک بر زاد فرخ شدند"
  },
  {
    "poem_id": 1911,
    "vorder": 60,
    "position": 1,
    "text": "بسی هر کسی داستانی زدند"
  },
  {
    "poem_id": 1911,
    "vorder": 61,
    "position": 0,
    "text": "که ما بندگانیم و او خسروست"
  },
  {
    "poem_id": 1911,
    "vorder": 62,
    "position": 1,
    "text": "بدان شاه روز بد اکنون نوست"
  },
  {
    "poem_id": 1911,
    "vorder": 63,
    "position": 0,
    "text": "نیارد برو زد کسی باد سرد"
  },
  {
    "poem_id": 1911,
    "vorder": 64,
    "position": 1,
    "text": "چه در باغ باشد چه اندر نبرد"
  },
  {
    "poem_id": 1911,
    "vorder": 65,
    "position": 0,
    "text": "بشد زاد فرخ به نزدیک شاه"
  },
  {
    "poem_id": 1911,
    "vorder": 66,
    "position": 1,
    "text": "ز درگاه او برد چندی سپاه"
  },
  {
    "poem_id": 1911,
    "vorder": 67,
    "position": 0,
    "text": "چو نزدیک او رفت تنها ببود"
  },
  {
    "poem_id": 1911,
    "vorder": 68,
    "position": 1,
    "text": "فراوان سخن گفت و خسرو شنود"
  },
  {
    "poem_id": 1911,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت اگر شاه بارم دهد"
  },
  {
    "poem_id": 1911,
    "vorder": 70,
    "position": 1,
    "text": "برین کرده‌ها زینهارم دهد"
  },
  {
    "poem_id": 1911,
    "vorder": 71,
    "position": 0,
    "text": "بیایم بگویم سخن هرچ هست"
  },
  {
    "poem_id": 1911,
    "vorder": 72,
    "position": 1,
    "text": "وگرنه بپویم به سوی نشست"
  },
  {
    "poem_id": 1911,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت خسرو چه گفتی بگوی"
  },
  {
    "poem_id": 1911,
    "vorder": 74,
    "position": 1,
    "text": "نه انده گساری نه پیکارجوی"
  },
  {
    "poem_id": 1911,
    "vorder": 75,
    "position": 0,
    "text": "چنین گفت پس مرد گویا به شاه"
  },
  {
    "poem_id": 1911,
    "vorder": 76,
    "position": 1,
    "text": "که در کار هشیارتر کن نگاه"
  },
  {
    "poem_id": 1911,
    "vorder": 77,
    "position": 0,
    "text": "بر آن نه که کشتی تو جنگی هزار"
  },
  {
    "poem_id": 1911,
    "vorder": 78,
    "position": 1,
    "text": "سرانجام سیرآیی از کارزار"
  },
  {
    "poem_id": 1911,
    "vorder": 79,
    "position": 0,
    "text": "همه شهر ایران تو را دشمنند"
  },
  {
    "poem_id": 1911,
    "vorder": 80,
    "position": 1,
    "text": "به پیکار تو یک دل و یک تنند"
  },
  {
    "poem_id": 1911,
    "vorder": 81,
    "position": 0,
    "text": "بپا تا چه خواهد نمودن سپهر"
  },
  {
    "poem_id": 1911,
    "vorder": 82,
    "position": 1,
    "text": "مگر کینها بازگردد به مهر"
  },
  {
    "poem_id": 1911,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت خسرو که آری رواست"
  },
  {
    "poem_id": 1911,
    "vorder": 84,
    "position": 1,
    "text": "همه بیمم از مردم ناسزاست"
  },
  {
    "poem_id": 1911,
    "vorder": 85,
    "position": 0,
    "text": "که پیش من آیند و خواری کنند"
  },
  {
    "poem_id": 1911,
    "vorder": 86,
    "position": 1,
    "text": "برم بر مگر کامگاری کنند"
  },
  {
    "poem_id": 1911,
    "vorder": 87,
    "position": 0,
    "text": "چو بشنید از زاد فرخ سخن"
  },
  {
    "poem_id": 1911,
    "vorder": 88,
    "position": 1,
    "text": "دلش بد شد از روزگار کهن"
  },
  {
    "poem_id": 1911,
    "vorder": 89,
    "position": 0,
    "text": "که او را ستاره شمر گفته بود"
  },
  {
    "poem_id": 1911,
    "vorder": 90,
    "position": 1,
    "text": "ز گفتار ایشان برآشفته بود"
  },
  {
    "poem_id": 1911,
    "vorder": 91,
    "position": 0,
    "text": "که مرگ توباشد میان دو کوه"
  },
  {
    "poem_id": 1911,
    "vorder": 92,
    "position": 1,
    "text": "بدست یکی بنده دور از گروه"
  },
  {
    "poem_id": 1911,
    "vorder": 93,
    "position": 0,
    "text": "یکی کوه زرین یکی کوه سیم"
  },
  {
    "poem_id": 1911,
    "vorder": 94,
    "position": 1,
    "text": "نشسته تو اندر میان دل به بیم"
  },
  {
    "poem_id": 1911,
    "vorder": 95,
    "position": 0,
    "text": "ز بر آسمان تو زرین بود"
  },
  {
    "poem_id": 1911,
    "vorder": 96,
    "position": 1,
    "text": "زمین آهنین بخت پرکین بود"
  },
  {
    "poem_id": 1911,
    "vorder": 97,
    "position": 0,
    "text": "کنون این زره چون زمین منست"
  },
  {
    "poem_id": 1911,
    "vorder": 98,
    "position": 1,
    "text": "سپر آسمان زرین منست"
  },
  {
    "poem_id": 1911,
    "vorder": 99,
    "position": 0,
    "text": "دو کوه این دو گنج نهاده به باغ"
  },
  {
    "poem_id": 1911,
    "vorder": 100,
    "position": 1,
    "text": "کزین گنجها بد دلم چون چراغ"
  },
  {
    "poem_id": 1911,
    "vorder": 101,
    "position": 0,
    "text": "همانا سرآمد کنون روز من"
  },
  {
    "poem_id": 1911,
    "vorder": 102,
    "position": 1,
    "text": "کجا اختر گیتی افروز من"
  },
  {
    "poem_id": 1911,
    "vorder": 103,
    "position": 0,
    "text": "کجا آن همه کام و آرام من"
  },
  {
    "poem_id": 1911,
    "vorder": 104,
    "position": 1,
    "text": "که بر تاجها بر بدی نام من"
  },
  {
    "poem_id": 1911,
    "vorder": 105,
    "position": 0,
    "text": "ببردند پیلی به نزدیک اوی"
  },
  {
    "poem_id": 1911,
    "vorder": 106,
    "position": 1,
    "text": "پر از درد شد جان تاریک اوی"
  },
  {
    "poem_id": 1911,
    "vorder": 107,
    "position": 0,
    "text": "بر آن کوههٔ پیل بنشست شاه"
  },
  {
    "poem_id": 1911,
    "vorder": 108,
    "position": 1,
    "text": "ز باغش بیاورد لشکر به راه"
  },
  {
    "poem_id": 1911,
    "vorder": 109,
    "position": 0,
    "text": "چنین گفت زان پیل بر پهلوی"
  },
  {
    "poem_id": 1911,
    "vorder": 110,
    "position": 1,
    "text": "که ای گنج اگر دشمن خسروی"
  },
  {
    "poem_id": 1911,
    "vorder": 111,
    "position": 0,
    "text": "مکن دوستی نیز با دشمنم"
  },
  {
    "poem_id": 1911,
    "vorder": 112,
    "position": 1,
    "text": "که امروز در دست آهرمنم"
  },
  {
    "poem_id": 1911,
    "vorder": 113,
    "position": 0,
    "text": "به سختی نبودیم فریادرس"
  },
  {
    "poem_id": 1911,
    "vorder": 114,
    "position": 1,
    "text": "نهان باش و منمای رویت به کس"
  },
  {
    "poem_id": 1911,
    "vorder": 115,
    "position": 0,
    "text": "به دستور فرمود زان پس قباد"
  },
  {
    "poem_id": 1911,
    "vorder": 116,
    "position": 1,
    "text": "کزو هیچ بر بد مکن نیز یاد"
  },
  {
    "poem_id": 1911,
    "vorder": 117,
    "position": 0,
    "text": "بگو تا سوی طیسفونش برند"
  },
  {
    "poem_id": 1911,
    "vorder": 118,
    "position": 1,
    "text": "بدان خانهٔ رهنمونش برند"
  },
  {
    "poem_id": 1911,
    "vorder": 119,
    "position": 0,
    "text": "بباشد به آرام ما روز چند"
  },
  {
    "poem_id": 1911,
    "vorder": 120,
    "position": 1,
    "text": "نباید که‌دارد کس او را گزند"
  },
  {
    "poem_id": 1911,
    "vorder": 121,
    "position": 0,
    "text": "برو بر موکل کنند استوار"
  },
  {
    "poem_id": 1911,
    "vorder": 122,
    "position": 1,
    "text": "گلینوش را با سواری هزار"
  },
  {
    "poem_id": 1911,
    "vorder": 123,
    "position": 0,
    "text": "چو گردنده گردون به سر بر بگشت"
  },
  {
    "poem_id": 1911,
    "vorder": 124,
    "position": 1,
    "text": "شد آن شاه را سال بر سی و هشت"
  },
  {
    "poem_id": 1911,
    "vorder": 125,
    "position": 0,
    "text": "کجا ماه آذر بُدی روز دی"
  },
  {
    "poem_id": 1911,
    "vorder": 126,
    "position": 1,
    "text": "گه آتش و مرغ بریان و می"
  },
  {
    "poem_id": 1911,
    "vorder": 127,
    "position": 0,
    "text": "قباد آمد و تاج بر سر نهاد"
  },
  {
    "poem_id": 1911,
    "vorder": 128,
    "position": 1,
    "text": "به آرام بر تخت بنشست شاد"
  },
  {
    "poem_id": 1911,
    "vorder": 129,
    "position": 0,
