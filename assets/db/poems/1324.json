[
  {
    "poem_id": 1324,
    "vorder": 1,
    "position": 0,
    "text": "چو زین بُگذَری مَردُم آمد پَدید"
  },
  {
    "poem_id": 1324,
    "vorder": 2,
    "position": 1,
    "text": "شد این بَندها را سَراسَر کِلید"
  },
  {
    "poem_id": 1324,
    "vorder": 3,
    "position": 0,
    "text": "سَرش راست بَر شُد چو سَروِ بُلَند"
  },
  {
    "poem_id": 1324,
    "vorder": 4,
    "position": 1,
    "text": "به گفتارِ خوب و خِرَد کار بَند"
  },
  {
    "poem_id": 1324,
    "vorder": 5,
    "position": 0,
    "text": "پذیرندهٔ هوش و رای و خِرَد"
  },
  {
    "poem_id": 1324,
    "vorder": 6,
    "position": 1,
    "text": "مَر او را دَد و دام فَرمان بَرَد"
  },
  {
    "poem_id": 1324,
    "vorder": 7,
    "position": 0,
    "text": "زِ راهِ خِرَد بِنگَری اَندکی"
  },
  {
    "poem_id": 1324,
    "vorder": 8,
    "position": 1,
    "text": "که مَردُم به مَعنی چه باشَد یکی"
  },
  {
    "poem_id": 1324,
    "vorder": 9,
    "position": 0,
    "text": "مگر مَردُمی خیره خوانی هَمی"
  },
  {
    "poem_id": 1324,
    "vorder": 10,
    "position": 1,
    "text": "جز این را نشانی نَدانی هَمی"
  },
  {
    "poem_id": 1324,
    "vorder": 11,
    "position": 0,
    "text": "تو را از دو گیتی بَر آوَرده‌اَند"
  },
  {
    "poem_id": 1324,
    "vorder": 12,
    "position": 1,
    "text": "به چَندین میانچی بِپَروَردِه‌اَند"
  },
  {
    "poem_id": 1324,
    "vorder": 13,
    "position": 0,
    "text": "نُخُستینِ فِطرَت پَسینِ شُمار"
  },
  {
    "poem_id": 1324,
    "vorder": 14,
    "position": 1,
    "text": "تویی خویشتَن را به بازی مَدار"
  },
  {
    "poem_id": 1324,
    "vorder": 15,
    "position": 0,
    "text": "شِنیدَم زِ دانا دِگرگونه زین"
  },
  {
    "poem_id": 1324,
    "vorder": 16,
    "position": 1,
    "text": "چه دانیم رازِ جَهان آفرین"
  },
  {
    "poem_id": 1324,
    "vorder": 17,
    "position": 0,
    "text": "نِگَه کُن سَرانجامِ خود را ببین"
  },
  {
    "poem_id": 1324,
    "vorder": 18,
    "position": 1,
    "text": "چو کاری بیابی اَز این بِه گُزین"
  },
  {
    "poem_id": 1324,
    "vorder": 19,
    "position": 0,
    "text": "به رَنج اَندر آری تَنَت را رَواست"
  },
  {
    "poem_id": 1324,
    "vorder": 20,
    "position": 1,
    "text": "که خود رَنج بُردن به دانش سِزاست"
  },
  {
    "poem_id": 1324,
    "vorder": 21,
    "position": 0,
    "text": "چو خواهی که یابی زِ هَر بَد رَها"
  },
  {
    "poem_id": 1324,
    "vorder": 22,
    "position": 1,
    "text": "سَر اَندر نَیاری به دامِ بَلا"
  },
  {
    "poem_id": 1324,
    "vorder": 23,
    "position": 0,
    "text": "نِگه کُن بِدین گُنبدِ تیزگَرد"
  },
  {
    "poem_id": 1324,
    "vorder": 24,
    "position": 1,
    "text": "که دَرمان اَزوی اَست و زویَست دَرد"
  },
  {
    "poem_id": 1324,
    "vorder": 25,
    "position": 0,
    "text": "نه گَشت‌ِ زَمانه بِفَرسایَدَش"
  },
  {
    "poem_id": 1324,
    "vorder": 26,
    "position": 1,
    "text": "نه آن رَنج وُ تیمار بِگزایَدَش"
  },
  {
    "poem_id": 1324,
    "vorder": 27,
    "position": 0,
    "text": "نه از جُنبش آرام گیرَد هَمی"
  },
  {
    "poem_id": 1324,
    "vorder": 28,
    "position": 1,
    "text": "نه چون ما تَباهی پَذیرَد هَمی"
  },
  {
    "poem_id": 1324,
    "vorder": 29,
    "position": 0,
    "text": "اَز او دان فُزونی اَز او هَم شُمار"
  },
  {
    "poem_id": 1324,
    "vorder": 30,
    "position": 1,
    "text": "بَد و نیک نَزدیکِ او آشکار"
  }
]