[
  {
    "poem_id": 1450,
    "vorder": 1,
    "position": 0,
    "text": "یکی مرد بیدار جوینده راه"
  },
  {
    "poem_id": 1450,
    "vorder": 2,
    "position": 1,
    "text": "فرستاد نزدیک کاووس شاه"
  },
  {
    "poem_id": 1450,
    "vorder": 3,
    "position": 0,
    "text": "به نزدیک سالار هاماوران"
  },
  {
    "poem_id": 1450,
    "vorder": 4,
    "position": 1,
    "text": "بشد نامداری ز کندآوران"
  },
  {
    "poem_id": 1450,
    "vorder": 5,
    "position": 0,
    "text": "یکی نامه بنوشت با گیر و دار"
  },
  {
    "poem_id": 1450,
    "vorder": 6,
    "position": 1,
    "text": "پر از گرز و شمشیر و پرکارزار"
  },
  {
    "poem_id": 1450,
    "vorder": 7,
    "position": 0,
    "text": "که بر شاه ایران کمین ساختی"
  },
  {
    "poem_id": 1450,
    "vorder": 8,
    "position": 1,
    "text": "بپیوستن اندر بد انداختی"
  },
  {
    "poem_id": 1450,
    "vorder": 9,
    "position": 0,
    "text": "نه مردی بود چاره جستن به جنگ"
  },
  {
    "poem_id": 1450,
    "vorder": 10,
    "position": 1,
    "text": "نرفتن به رسم دلاور پلنگ"
  },
  {
    "poem_id": 1450,
    "vorder": 11,
    "position": 0,
    "text": "که در جنگ هرگز نسازد کمین"
  },
  {
    "poem_id": 1450,
    "vorder": 12,
    "position": 1,
    "text": "اگر چند باشد دلش پر ز کین"
  },
  {
    "poem_id": 1450,
    "vorder": 13,
    "position": 0,
    "text": "اگر شاه کاووس یابد رها"
  },
  {
    "poem_id": 1450,
    "vorder": 14,
    "position": 1,
    "text": "تو رستی ز چنگ و دم اژدها"
  },
  {
    "poem_id": 1450,
    "vorder": 15,
    "position": 0,
    "text": "وگرنه بیارای جنگ مرا"
  },
  {
    "poem_id": 1450,
    "vorder": 16,
    "position": 1,
    "text": "به گردن بپیمای هنگ مرا"
  },
  {
    "poem_id": 1450,
    "vorder": 17,
    "position": 0,
    "text": "فرستاده شد نزد هاماوران"
  },
  {
    "poem_id": 1450,
    "vorder": 18,
    "position": 1,
    "text": "بدادش پیام یکایک سران"
  },
  {
    "poem_id": 1450,
    "vorder": 19,
    "position": 0,
    "text": "چو پیغام بشنید و نامه بخواند"
  },
  {
    "poem_id": 1450,
    "vorder": 20,
    "position": 1,
    "text": "ز کردار خود در شگفتی بماند"
  },
  {
    "poem_id": 1450,
    "vorder": 21,
    "position": 0,
    "text": "چو برخواند نامه سرش خیره شد"
  },
  {
    "poem_id": 1450,
    "vorder": 22,
    "position": 1,
    "text": "جهان پیش چشمش همه تیره شد"
  },
  {
    "poem_id": 1450,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد پاسخ که کاووس کی"
  },
  {
    "poem_id": 1450,
    "vorder": 24,
    "position": 1,
    "text": "به هامون دگر نسپرد نیز پی"
  },
  {
    "poem_id": 1450,
    "vorder": 25,
    "position": 0,
    "text": "تو هرگه که آیی به بربرستان"
  },
  {
    "poem_id": 1450,
    "vorder": 26,
    "position": 1,
    "text": "نبینی مگر تیغ و گرز گران"
  },
  {
    "poem_id": 1450,
    "vorder": 27,
    "position": 0,
    "text": "همین بند و زندانت آراستست"
  },
  {
    "poem_id": 1450,
    "vorder": 28,
    "position": 1,
    "text": "اگر رایت این آرزو خواستست"
  },
  {
    "poem_id": 1450,
    "vorder": 29,
    "position": 0,
    "text": "بیایم بجنگ تو من با سپاه"
  },
  {
    "poem_id": 1450,
    "vorder": 30,
    "position": 1,
    "text": "برین گونه سازیم آیین و راه"
  },
  {
    "poem_id": 1450,
    "vorder": 31,
    "position": 0,
    "text": "چو بشنید پاسخ‌گو پیلتن"
  },
  {
    "poem_id": 1450,
    "vorder": 32,
    "position": 1,
    "text": "دلیران لشکر شدند انجمن"
  },
  {
    "poem_id": 1450,
    "vorder": 33,
    "position": 0,
    "text": "سوی راه دریا بیامد به جنگ"
  },
  {
    "poem_id": 1450,
    "vorder": 34,
    "position": 1,
    "text": "که بر خشک بر بود ره با درنگ"
  },
  {
    "poem_id": 1450,
    "vorder": 35,
    "position": 0,
    "text": "به کشتی و زورق سپاهی گران"
  },
  {
    "poem_id": 1450,
    "vorder": 36,
    "position": 1,
    "text": "بشد تا سر مرز هاماوران"
  },
  {
    "poem_id": 1450,
    "vorder": 37,
    "position": 0,
    "text": "به تاراج و کشتن نهادند روی"
  },
  {
    "poem_id": 1450,
    "vorder": 38,
    "position": 1,
    "text": "ز خون روی کشور شده جوی جوی"
  },
  {
    "poem_id": 1450,
    "vorder": 39,
    "position": 0,
    "text": "خبر شد به شاه هماور ازین"
  },
  {
    "poem_id": 1450,
    "vorder": 40,
    "position": 1,
    "text": "که رستم نهادست بر رخش زین"
  },
  {
    "poem_id": 1450,
    "vorder": 41,
    "position": 0,
    "text": "ببایست تا گاهش آمد به جنگ"
  },
  {
    "poem_id": 1450,
    "vorder": 42,
    "position": 1,
    "text": "نبد روزگار سکون و درنگ"
  },
  {
    "poem_id": 1450,
    "vorder": 43,
    "position": 0,
    "text": "چو بیرون شد از شهر خود با سپاه"
  },
  {
    "poem_id": 1450,
    "vorder": 44,
    "position": 1,
    "text": "به روز درخشان شب آمد سیاه"
  },
  {
    "poem_id": 1450,
    "vorder": 45,
    "position": 0,
    "text": "چپ و راست لشکر بیاراستند"
  },
  {
    "poem_id": 1450,
    "vorder": 46,
    "position": 1,
    "text": "به جنگ اندرون نامور خواستند"
  },
  {
    "poem_id": 1450,
    "vorder": 47,
    "position": 0,
    "text": "گو پیلتن گفت جنگی منم"
  },
  {
    "poem_id": 1450,
    "vorder": 48,
    "position": 1,
    "text": "به آوردگه بر درنگی منم"
  },
  {
    "poem_id": 1450,
    "vorder": 49,
    "position": 0,
    "text": "برآورد گرز گران را به دوش"
  },
  {
    "poem_id": 1450,
    "vorder": 50,
    "position": 1,
    "text": "برانگیخت رخش و برآمد خروش"
  },
  {
    "poem_id": 1450,
    "vorder": 51,
    "position": 0,
    "text": "چو دیدند لشکر بر و یال اوی"
  },
  {
    "poem_id": 1450,
    "vorder": 52,
    "position": 1,
    "text": "به چنگ اندرون گرز و گوپال اوی"
  },
  {
    "poem_id": 1450,
    "vorder": 53,
    "position": 0,
    "text": "تو گفتی که دلشان برآمد ز تن"
  },
  {
    "poem_id": 1450,
    "vorder": 54,
    "position": 1,
    "text": "ز هولش پراگنده شد انجمن"
  },
  {
    "poem_id": 1450,
    "vorder": 55,
    "position": 0,
    "text": "همان شاه با نامور سرکشان"
  },
  {
    "poem_id": 1450,
    "vorder": 56,
    "position": 1,
    "text": "ز رستم چو دیدند یک یک نشان"
  },
  {
    "poem_id": 1450,
    "vorder": 57,
    "position": 0,
    "text": "گریزان بیامد به هاماوران"
  },
  {
    "poem_id": 1450,
    "vorder": 58,
    "position": 1,
    "text": "ز پیش تهمتن سپاهی گران"
  },
  {
    "poem_id": 1450,
    "vorder": 59,
    "position": 0,
    "text": "چو بنشست سالار با رایزن"
  },
  {
    "poem_id": 1450,
    "vorder": 60,
    "position": 1,
    "text": "دو مرد جوان خواست از انجمن"
  },
  {
    "poem_id": 1450,
    "vorder": 61,
    "position": 0,
    "text": "بدان تا فرستد هم اندر زمان"
  },
  {
    "poem_id": 1450,
    "vorder": 62,
    "position": 1,
    "text": "به مصر و به بربر چو باد دمان"
  },
  {
    "poem_id": 1450,
    "vorder": 63,
    "position": 0,
    "text": "یکی نامه هر یک به چنگ اندرون"
  },
  {
    "poem_id": 1450,
    "vorder": 64,
    "position": 1,
    "text": "نوشته به درد دل از آب خون"
  },
  {
    "poem_id": 1450,
    "vorder": 65,
    "position": 0,
    "text": "کزین پادشاهی بدان نیست دور"
  },
  {
    "poem_id": 1450,
    "vorder": 66,
    "position": 1,
    "text": "بهم بود نیک و بد و جنگ و سور"
  },
  {
    "poem_id": 1450,
    "vorder": 67,
    "position": 0,
    "text": "گرایدونک باشید با من یکی"
  },
  {
    "poem_id": 1450,
    "vorder": 68,
    "position": 1,
    "text": "ز رستم نترسم به جنگ اندکی"
  },
  {
    "poem_id": 1450,
    "vorder": 69,
    "position": 0,
    "text": "وگرنه بدان پادشاهی رسد"
  },
  {
    "poem_id": 1450,
    "vorder": 70,
    "position": 1,
    "text": "درازست بر هر سویی دست بد"
  },
  {
    "poem_id": 1450,
    "vorder": 71,
    "position": 0,
    "text": "چو نامه به نزدیک ایشان رسید"
  },
  {
    "poem_id": 1450,
    "vorder": 72,
    "position": 1,
    "text": "که رستم بدین دشت لشکر کشید"
  },
  {
    "poem_id": 1450,
    "vorder": 73,
    "position": 0,
    "text": "همه دل پر از بیم برخاستند"
  },
  {
    "poem_id": 1450,
    "vorder": 74,
    "position": 1,
    "text": "سپاهی ز کشور بیاراستند"
  },
  {
    "poem_id": 1450,
    "vorder": 75,
    "position": 0,
    "text": "نهادند سر سوی هاماوران"
  },
  {
    "poem_id": 1450,
    "vorder": 76,
    "position": 1,
    "text": "زمین کوه گشت از کران تا کران"
  },
  {
    "poem_id": 1450,
    "vorder": 77,
    "position": 0,
    "text": "سپه کوه تا کوه صف برکشید"
  },
  {
    "poem_id": 1450,
    "vorder": 78,
    "position": 1,
    "text": "پی مور شد بر زمین ناپدید"
  },
  {
    "poem_id": 1450,
    "vorder": 79,
    "position": 0,
    "text": "چو رستم چنان دید نزدیک شاه"
  },
  {
    "poem_id": 1450,
    "vorder": 80,
    "position": 1,
    "text": "نهانی برافگند مردی به راه"
  },
  {
    "poem_id": 1450,
    "vorder": 81,
    "position": 0,
    "text": "که شاه سه کشور برآراستند"
  },
  {
    "poem_id": 1450,
    "vorder": 82,
    "position": 1,
    "text": "بر این گونه از جای برخاستند"
  },
  {
    "poem_id": 1450,
    "vorder": 83,
    "position": 0,
    "text": "اگر جنگ را من بجنبم ز جای"
  },
  {
    "poem_id": 1450,
    "vorder": 84,
    "position": 1,
    "text": "ندانند سر را بدین کین ز پای"
  },
  {
    "poem_id": 1450,
    "vorder": 85,
    "position": 0,
    "text": "نباید کزین کین به تو بد رسد"
  },
  {
    "poem_id": 1450,
    "vorder": 86,
    "position": 1,
    "text": "که کار بد از مردم بد رسد"
  },
  {
    "poem_id": 1450,
    "vorder": 87,
    "position": 0,
    "text": "مرا تخت بربر نیاید به کار"
  },
  {
    "poem_id": 1450,
    "vorder": 88,
    "position": 1,
    "text": "اگر بد رسد بر تن شهریار"
  },
  {
    "poem_id": 1450,
    "vorder": 89,
    "position": 0,
    "text": "فرستاده بشنید و آمد دوان"
  },
  {
    "poem_id": 1450,
    "vorder": 90,
    "position": 1,
    "text": "به نزدیک کاووس کی شد نهان"
  },
  {
    "poem_id": 1450,
    "vorder": 91,
    "position": 0,
    "text": "پیام تهمتن همه باز راند"
  },
  {
    "poem_id": 1450,
    "vorder": 92,
    "position": 1,
    "text": "چو بشنید کاووس خیره بماند"
  },
  {
    "poem_id": 1450,
    "vorder": 93,
    "position": 0,
    "text": "چنین داد پاسخ که مندیش ازین"
  },
  {
    "poem_id": 1450,
    "vorder": 94,
    "position": 1,
    "text": "نه گسترده از بهر من شد زمین"
  },
  {
    "poem_id": 1450,
    "vorder": 95,
    "position": 0,
    "text": "چنین بود تا بود گردان سپهر"
  },
  {
    "poem_id": 1450,
    "vorder": 96,
    "position": 1,
    "text": "که با نوش زهرست با جنگ مهر"
  },
  {
    "poem_id": 1450,
    "vorder": 97,
    "position": 0,
    "text": "و دیگر که دارنده یار منست"
  },
  {
    "poem_id": 1450,
    "vorder": 98,
    "position": 1,
    "text": "بزرگی و مهرش حصار منست"
  },
  {
    "poem_id": 1450,
    "vorder": 99,
    "position": 0,
    "text": "تو رخش درخشنده را ده عنان"
  },
  {
    "poem_id": 1450,
    "vorder": 100,
    "position": 1,
    "text": "بیارای گوشش به نوک سنان"
  },
  {
    "poem_id": 1450,
    "vorder": 101,
    "position": 0,
    "text": "ازیشان یکی زنده اندر جهان"
  },
  {
    "poem_id": 1450,
    "vorder": 102,
    "position": 1,
    "text": "ممان آشکارا نه اندر نهان"
  },
  {
    "poem_id": 1450,
    "vorder": 103,
    "position": 0,
    "text": "فرستاده پاسخ بیاورد زود"
  },
  {
    "poem_id": 1450,
    "vorder": 104,
    "position": 1,
    "text": "بر رستم زال زر شد چو دود"
  },
  {
    "poem_id": 1450,
    "vorder": 105,
    "position": 0,
    "text": "تهمتن چو بشنید گفتار اوی"
  },
  {
    "poem_id": 1450,
    "vorder": 106,
    "position": 1,
    "text": "بسیچید و زی جنگ بنهاد روی"
  }
]