[
  {
    "poem_id": 1394,
    "vorder": 1,
    "position": 0,
    "text": "چو شد ساخته کار خود بر نشست"
  },
  {
    "poem_id": 1394,
    "vorder": 2,
    "position": 1,
    "text": "چو گردی به مردی میان را ببست"
  },
  {
    "poem_id": 1394,
    "vorder": 3,
    "position": 0,
    "text": "یکی ترگ رومی به سر بر نهاد"
  },
  {
    "poem_id": 1394,
    "vorder": 4,
    "position": 1,
    "text": "یکی باره زیراندرش همچو باد"
  },
  {
    "poem_id": 1394,
    "vorder": 5,
    "position": 0,
    "text": "بیامد گرازان به درگاه سام"
  },
  {
    "poem_id": 1394,
    "vorder": 6,
    "position": 1,
    "text": "نه آواز داد و نه برگفت نام"
  },
  {
    "poem_id": 1394,
    "vorder": 7,
    "position": 0,
    "text": "به کار آگهان گفت تا ناگهان"
  },
  {
    "poem_id": 1394,
    "vorder": 8,
    "position": 1,
    "text": "بگویند با سرفراز جهان"
  },
  {
    "poem_id": 1394,
    "vorder": 9,
    "position": 0,
    "text": "که آمد فرستاده‌ای کابلی"
  },
  {
    "poem_id": 1394,
    "vorder": 10,
    "position": 1,
    "text": "به نزد سپهبد یل زابلی"
  },
  {
    "poem_id": 1394,
    "vorder": 11,
    "position": 0,
    "text": "ز مهراب گرد آوریده پیام"
  },
  {
    "poem_id": 1394,
    "vorder": 12,
    "position": 1,
    "text": "به نزد سپهبد جهانگیر سام"
  },
  {
    "poem_id": 1394,
    "vorder": 13,
    "position": 0,
    "text": "بیامد بر سام یل پرده‌دار"
  },
  {
    "poem_id": 1394,
    "vorder": 14,
    "position": 1,
    "text": "بگفت و بفرمود تا داد بار"
  },
  {
    "poem_id": 1394,
    "vorder": 15,
    "position": 0,
    "text": "فرود آمد از اسپ سیندخت و رفت"
  },
  {
    "poem_id": 1394,
    "vorder": 16,
    "position": 1,
    "text": "به پیش سپهبد خرامید تفت"
  },
  {
    "poem_id": 1394,
    "vorder": 17,
    "position": 0,
    "text": "زمین را ببوسید و کرد آفرین"
  },
  {
    "poem_id": 1394,
    "vorder": 18,
    "position": 1,
    "text": "ابر شاه و بر پهلوان زمین"
  },
  {
    "poem_id": 1394,
    "vorder": 19,
    "position": 0,
    "text": "نثار و پرستنده و اسپ و پیل"
  },
  {
    "poem_id": 1394,
    "vorder": 20,
    "position": 1,
    "text": "رده بر کشیده ز در تا دو میل"
  },
  {
    "poem_id": 1394,
    "vorder": 21,
    "position": 0,
    "text": "یکایک همه پیش سام آورید"
  },
  {
    "poem_id": 1394,
    "vorder": 22,
    "position": 1,
    "text": "سر پهلوان خیره شد کان بدید"
  },
  {
    "poem_id": 1394,
    "vorder": 23,
    "position": 0,
    "text": "پر اندیشه بنشست برسان مست"
  },
  {
    "poem_id": 1394,
    "vorder": 24,
    "position": 1,
    "text": "بکش کرده دست و سرافگنده پست"
  },
  {
    "poem_id": 1394,
    "vorder": 25,
    "position": 0,
    "text": "که جایی کجا مایه چندین بود"
  },
  {
    "poem_id": 1394,
    "vorder": 26,
    "position": 1,
    "text": "فرستادن زن چه آیین بود"
  },
  {
    "poem_id": 1394,
    "vorder": 27,
    "position": 0,
    "text": "گراین خواسته زو پذیرم همه"
  },
  {
    "poem_id": 1394,
    "vorder": 28,
    "position": 1,
    "text": "ز من گردد آزرده شاه رمه"
  },
  {
    "poem_id": 1394,
    "vorder": 29,
    "position": 0,
    "text": "و گر بازگردانم از پیش زال"
  },
  {
    "poem_id": 1394,
    "vorder": 30,
    "position": 1,
    "text": "برآرد به کردار سیمرغ بال"
  },
  {
    "poem_id": 1394,
    "vorder": 31,
    "position": 0,
    "text": "برآورد سر گفت کاین خواسته"
  },
  {
    "poem_id": 1394,
    "vorder": 32,
    "position": 1,
    "text": "غلامان و پیلان آراسته"
  },
  {
    "poem_id": 1394,
    "vorder": 33,
    "position": 0,
    "text": "برید این به گنجور دستان دهید"
  },
  {
    "poem_id": 1394,
    "vorder": 34,
    "position": 1,
    "text": "به نام مه کابلستان دهید"
  },
  {
    "poem_id": 1394,
    "vorder": 35,
    "position": 0,
    "text": "پری روی سیندخت بر پیش سام"
  },
  {
    "poem_id": 1394,
    "vorder": 36,
    "position": 1,
    "text": "زبان کرد گویا و دل شادکام"
  },
  {
    "poem_id": 1394,
    "vorder": 37,
    "position": 0,
    "text": "چو آن هدیه‌ها را پذیرفته دید"
  },
  {
    "poem_id": 1394,
    "vorder": 38,
    "position": 1,
    "text": "رسیده بهی و بدی رفته دید"
  },
  {
    "poem_id": 1394,
    "vorder": 39,
    "position": 0,
    "text": "سه بت روی با او به یک جا بدند"
  },
  {
    "poem_id": 1394,
    "vorder": 40,
    "position": 1,
    "text": "سمن پیکر و سرو بالا بدند"
  },
  {
    "poem_id": 1394,
    "vorder": 41,
    "position": 0,
    "text": "گرفته یکی جام هر یک به دست"
  },
  {
    "poem_id": 1394,
    "vorder": 42,
    "position": 1,
    "text": "بفرمود کامد به جای نشست"
  },
  {
    "poem_id": 1394,
    "vorder": 43,
    "position": 0,
    "text": "به پیش سپهبد فرو ریختند"
  },
  {
    "poem_id": 1394,
    "vorder": 44,
    "position": 1,
    "text": "همه یک به دیگر برآمیختند"
  },
  {
    "poem_id": 1394,
    "vorder": 45,
    "position": 0,
    "text": "چو با پهلوان کار بر ساختند"
  },
  {
    "poem_id": 1394,
    "vorder": 46,
    "position": 1,
    "text": "ز بیگانه خانه بپرداختند"
  },
  {
    "poem_id": 1394,
    "vorder": 47,
    "position": 0,
    "text": "چنین گفت سیندخت با پهلوان"
  },
  {
    "poem_id": 1394,
    "vorder": 48,
    "position": 1,
    "text": "که با رای تو پیر گردد جوان"
  },
  {
    "poem_id": 1394,
    "vorder": 49,
    "position": 0,
    "text": "بزرگان ز تو دانش آموختند"
  },
  {
    "poem_id": 1394,
    "vorder": 50,
    "position": 1,
    "text": "به تو تیرگیها برافروختند"
  },
  {
    "poem_id": 1394,
    "vorder": 51,
    "position": 0,
    "text": "به مهر تو شد بسته دست بدی"
  },
  {
    "poem_id": 1394,
    "vorder": 52,
    "position": 1,
    "text": "به گرزت گشاده ره ایزدی"
  },
  {
    "poem_id": 1394,
    "vorder": 53,
    "position": 0,
    "text": "گنهکار گر بود مهراب بود"
  },
  {
    "poem_id": 1394,
    "vorder": 54,
    "position": 1,
    "text": "ز خون دلش دیده سیراب بود"
  },
  {
    "poem_id": 1394,
    "vorder": 55,
    "position": 0,
    "text": "سر بیگناهان کابل چه کرد"
  },
  {
    "poem_id": 1394,
    "vorder": 56,
    "position": 1,
    "text": "کجا اندر آورد باید بگرد"
  },
  {
    "poem_id": 1394,
    "vorder": 57,
    "position": 0,
    "text": "همه شهر زنده برای تواند"
  },
  {
    "poem_id": 1394,
    "vorder": 58,
    "position": 1,
    "text": "پرستنده و خاک پای تواند"
  },
  {
    "poem_id": 1394,
    "vorder": 59,
    "position": 0,
    "text": "ازان ترس کو هوش و زور آفرید"
  },
  {
    "poem_id": 1394,
    "vorder": 60,
    "position": 1,
    "text": "درخشنده ناهید و هور آفرید"
  },
  {
    "poem_id": 1394,
    "vorder": 61,
    "position": 0,
    "text": "نیاید چنین کارش از تو پسند"
  },
  {
    "poem_id": 1394,
    "vorder": 62,
    "position": 1,
    "text": "میان را به خون ریختن در مبند"
  },
  {
    "poem_id": 1394,
    "vorder": 63,
    "position": 0,
    "text": "بدو سام یل گفت با من بگوی"
  },
  {
    "poem_id": 1394,
    "vorder": 64,
    "position": 1,
    "text": "ازان کت بپرسم بهانه مجوی"
  },
  {
    "poem_id": 1394,
    "vorder": 65,
    "position": 0,
    "text": "تو مهراب را کهتری گر همال"
  },
  {
    "poem_id": 1394,
    "vorder": 66,
    "position": 1,
    "text": "مر آن دخت او را کجا دید زال"
  },
  {
    "poem_id": 1394,
    "vorder": 67,
    "position": 0,
    "text": "به روی و به موی و به خوی و خرد"
  },
  {
    "poem_id": 1394,
    "vorder": 68,
    "position": 1,
    "text": "به من گوی تا باکی اندر خورد"
  },
  {
    "poem_id": 1394,
    "vorder": 69,
    "position": 0,
    "text": "ز بالا و دیدار و فرهنگ اوی"
  },
  {
    "poem_id": 1394,
    "vorder": 70,
    "position": 1,
    "text": "بران سان که دیدی یکایک بگوی"
  },
  {
    "poem_id": 1394,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت سیندخت کای پهلوان"
  },
  {
    "poem_id": 1394,
    "vorder": 72,
    "position": 1,
    "text": "سر پهلوانان و پشت گوان"
  },
  {
    "poem_id": 1394,
    "vorder": 73,
    "position": 0,
    "text": "یکی سخت پیمانت خواهم نخست"
  },
  {
    "poem_id": 1394,
    "vorder": 74,
    "position": 1,
    "text": "که لرزان شود زو بر و بوم و رست"
  },
  {
    "poem_id": 1394,
    "vorder": 75,
    "position": 0,
    "text": "که از تو نیاید به جانم گزند"
  },
  {
    "poem_id": 1394,
    "vorder": 76,
    "position": 1,
    "text": "نه آنکس که بر من بود ارجمند"
  },
  {
    "poem_id": 1394,
    "vorder": 77,
    "position": 0,
    "text": "مرا کاخ و ایوان آباد هست"
  },
  {
    "poem_id": 1394,
    "vorder": 78,
    "position": 1,
    "text": "همان گنج و خویشان و بنیاد هست"
  },
  {
    "poem_id": 1394,
    "vorder": 79,
    "position": 0,
    "text": "چو ایمن شوم هر چه گویی بگوی"
  },
  {
    "poem_id": 1394,
    "vorder": 80,
    "position": 1,
    "text": "بگویم بجویم بدین آب روی"
  },
  {
    "poem_id": 1394,
    "vorder": 81,
    "position": 0,
    "text": "نهفته همه گنج کابلستان"
  },
  {
    "poem_id": 1394,
    "vorder": 82,
    "position": 1,
    "text": "بکوشم رسانم به زابلستان"
  },
  {
    "poem_id": 1394,
    "vorder": 83,
    "position": 0,
    "text": "جزین نیز هر چیز کاندر خورد"
  },
  {
    "poem_id": 1394,
    "vorder": 84,
    "position": 1,
    "text": "ببیند ز من مهتر پر خرد"
  },
  {
    "poem_id": 1394,
    "vorder": 85,
    "position": 0,
    "text": "گرفت آن زمان سام دستش به دست"
  },
  {
    "poem_id": 1394,
    "vorder": 86,
    "position": 1,
    "text": "ورا نیک بنواخت و پیمان ببست"
  },
  {
    "poem_id": 1394,
    "vorder": 87,
    "position": 0,
    "text": "چو بشنید سیندخت سوگند او"
  },
  {
    "poem_id": 1394,
    "vorder": 88,
    "position": 1,
    "text": "همان راست گفتار و پیوند او"
  },
  {
    "poem_id": 1394,
    "vorder": 89,
    "position": 0,
    "text": "زمین را ببوسید و بر پای خاست"
  },
  {
    "poem_id": 1394,
    "vorder": 90,
    "position": 1,
    "text": "بگفت آنچه اندر نهان بود راست"
  },
  {
    "poem_id": 1394,
    "vorder": 91,
    "position": 0,
    "text": "که من خویش ضحاکم ای پهلوان"
  },
  {
    "poem_id": 1394,
    "vorder": 92,
    "position": 1,
    "text": "زن گرد مهراب روشن روان"
  },
  {
    "poem_id": 1394,
    "vorder": 93,
    "position": 0,
    "text": "همان مام رودابهٔ ماه روی"
  },
  {
    "poem_id": 1394,
    "vorder": 94,
    "position": 1,
    "text": "که دستان همی جان فشاند بروی"
  },
  {
    "poem_id": 1394,
    "vorder": 95,
    "position": 0,
    "text": "همه دودمان پیش یزدان پاک"
  },
  {
    "poem_id": 1394,
    "vorder": 96,
    "position": 1,
    "text": "شب تیره تا برکشد روز چاک"
  },
  {
    "poem_id": 1394,
    "vorder": 97,
    "position": 0,
    "text": "همی بر تو بر خواندیم آفرین"
  },
  {
    "poem_id": 1394,
    "vorder": 98,
    "position": 1,
    "text": "همان بر جهاندار شاه زمین"
  },
  {
    "poem_id": 1394,
    "vorder": 99,
    "position": 0,
    "text": "کنون آمدم تا هوای تو چیست"
  },
  {
    "poem_id": 1394,
    "vorder": 100,
    "position": 1,
    "text": "ز کابل ترا دشمن و دوست کیست"
  },
  {
    "poem_id": 1394,
    "vorder": 101,
    "position": 0,
    "text": "اگر ما گنهکار و بدگوهریم"
  },
  {
    "poem_id": 1394,
    "vorder": 102,
    "position": 1,
    "text": "بدین پادشاهی نه اندر خوریم"
  },
  {
    "poem_id": 1394,
    "vorder": 103,
    "position": 0,
    "text": "من اینک به پیش توام مستمند"
  },
  {
    "poem_id": 1394,
    "vorder": 104,
    "position": 1,
    "text": "بکش گر کشی ور ببندی ببند"
  },
  {
    "poem_id": 1394,
    "vorder": 105,
    "position": 0,
    "text": "دل بیگناهان کابل مسوز"
  },
  {
    "poem_id": 1394,
    "vorder": 106,
    "position": 1,
    "text": "کجا تیره روز اندر آید به روز"
  },
  {
    "poem_id": 1394,
    "vorder": 107,
    "position": 0,
    "text": "سخنها چو بشنید ازو پهلوان"
  },
  {
    "poem_id": 1394,
    "vorder": 108,
    "position": 1,
    "text": "زنی دید با رای و روشن روان"
  },
  {
    "poem_id": 1394,
    "vorder": 109,
    "position": 0,
    "text": "به رخ چون بهار و به بالا چو سرو"
  },
  {
    "poem_id": 1394,
    "vorder": 110,
    "position": 1,
    "text": "میانش چو غرو و به رفتن تذرو"
  },
  {
    "poem_id": 1394,
    "vorder": 111,
    "position": 0,
    "text": "چنین داد پاسخ که پیمان من"
  },
  {
    "poem_id": 1394,
    "vorder": 112,
    "position": 1,
    "text": "درست است اگر بگسلد جان من"
  },
  {
    "poem_id": 1394,
    "vorder": 113,
    "position": 0,
    "text": "تو با کابل و هر که پیوند تست"
  },
  {
    "poem_id": 1394,
    "vorder": 114,
    "position": 1,
    "text": "بمانید شادان دل و تن‌درست"
  },
  {
    "poem_id": 1394,
    "vorder": 115,
    "position": 0,
    "text": "بدین نیز همداستانم که زال"
  },
  {
    "poem_id": 1394,
    "vorder": 116,
    "position": 1,
    "text": "ز گیتی چو رودابه جوید همال"
  },
  {
    "poem_id": 1394,
    "vorder": 117,
    "position": 0,
    "text": "شما گرچه از گوهر دیگرید"
  },
  {
    "poem_id": 1394,
    "vorder": 118,
    "position": 1,
    "text": "همان تاج و اورنگ را در خورید"
  },
  {
    "poem_id": 1394,
    "vorder": 119,
    "position": 0,
    "text": "چنین است گیتی وزین ننگ نیست"
  },
  {
    "poem_id": 1394,
    "vorder": 120,
    "position": 1,
    "text": "ابا کردگار جهان جنگ نیست"
  },
  {
    "poem_id": 1394,
    "vorder": 121,
    "position": 0,
    "text": "چنان آفریند که آیدش رای"
  },
  {
    "poem_id": 1394,
    "vorder": 122,
    "position": 1,
    "text": "نمانیم و ماندیم با های های"
  },
  {
    "poem_id": 1394,
    "vorder": 123,
    "position": 0,
    "text": "یکی بر فراز و یکی در نشیب"
  },
  {
    "poem_id": 1394,
    "vorder": 124,
    "position": 1,
    "text": "یکی با فزونی یکی با نهیب"
  },
  {
    "poem_id": 1394,
    "vorder": 125,
    "position": 0,
    "text": "یکی از فزایش دل آراسته"
  },
  {
    "poem_id": 1394,
    "vorder": 126,
    "position": 1,
    "text": "ز کمی دل دیگری کاسته"
  },
  {
    "poem_id": 1394,
    "vorder": 127,
    "position": 0,
    "text": "یکی نامه با لابهٔ دردمند"
  },
  {
    "poem_id": 1394,
    "vorder": 128,
    "position": 1,
    "text": "نبشتم به نزدیک شاه بلند"
  },
  {
    "poem_id": 1394,
    "vorder": 129,
    "position": 0,
    "text": "به نزد منوچهر شد زال زر"
  },
  {
    "poem_id": 1394,
    "vorder": 130,
    "position": 1,
    "text": "چنان شد که گفتی برآورده پر"
  },
  {
    "poem_id": 1394,
    "vorder": 131,
    "position": 0,
    "text": "به زین اندر آمد که زین را ندید"
  },
  {
    "poem_id": 1394,
    "vorder": 132,
    "position": 1,
    "text": "همان نعل اسپش زمین را ندید"
  },
  {
    "poem_id": 1394,
    "vorder": 133,
    "position": 0,
    "text": "بدین زال را شاه پاسخ دهد"
  },
  {
    "poem_id": 1394,
    "vorder": 134,
    "position": 1,
    "text": "چو خندان شود رای فرخ نهد"
  },
  {
    "poem_id": 1394,
    "vorder": 135,
    "position": 0,
    "text": "که پروردهٔ مرغ بی‌دل شدست"
  },
  {
    "poem_id": 1394,
    "vorder": 136,
    "position": 1,
    "text": "از آب مژه پای در گل شدست"
  },
  {
    "poem_id": 1394,
    "vorder": 137,
    "position": 0,
    "text": "عروس ار به مهر اندرون همچو اوست"
  },
  {
    "poem_id": 1394,
    "vorder": 138,
    "position": 1,
    "text": "سزد گر برآیند هر دو ز پوست"
  },
  {
    "poem_id": 1394,
    "vorder": 139,
    "position": 0,
    "text": "یکی روی آن بچهٔ اژدها"
  },
  {
    "poem_id": 1394,
    "vorder": 140,
    "position": 1,
    "text": "مرا نیز بنمای و بستان بها"
  },
  {
    "poem_id": 1394,
    "vorder": 141,
    "position": 0,
    "text": "بدو گفت سیندخت اگر پهلوان"
  },
  {
    "poem_id": 1394,
    "vorder": 142,
    "position": 1,
    "text": "کند بنده را شاد و روشن روان"
  },
  {
    "poem_id": 1394,
    "vorder": 143,
    "position": 0,
    "text": "چماند به کاخ من اندر سمند"
  },
  {
    "poem_id": 1394,
    "vorder": 144,
    "position": 1,
    "text": "سرم بر شود به آسمان بلند"
  },
  {
    "poem_id": 1394,
    "vorder": 145,
    "position": 0,
    "text": "به کابل چنو شهریار آوریم"
  },
  {
    "poem_id": 1394,
    "vorder": 146,
    "position": 1,
    "text": "همه پیش او جان نثار آوریم"
  },
  {
    "poem_id": 1394,
    "vorder": 147,
    "position": 0,
    "text": "لب سام سیندخت پرخنده دید"
  },
  {
    "poem_id": 1394,
    "vorder": 148,
    "position": 1,
    "text": "همه بیخ کین از دلش کنده دید"
  },
  {
    "poem_id": 1394,
    "vorder": 149,
    "position": 0,
    "text": "نوندی دلاور به کردار باد"
  },
  {
    "poem_id": 1394,
    "vorder": 150,
    "position": 1,
    "text": "برافگند و مهراب را مژده داد"
  },
  {
    "poem_id": 1394,
    "vorder": 151,
    "position": 0,
    "text": "کز اندیشهٔ بد مکن یاد هیچ"
  },
  {
    "poem_id": 1394,
    "vorder": 152,
    "position": 1,
    "text": "دلت شاد کن کار مهمان بسیچ"
  },
  {
    "poem_id": 1394,
    "vorder": 153,
    "position": 0,
    "text": "من اینک پس نامه اندر دمان"
  },
  {
    "poem_id": 1394,
    "vorder": 154,
    "position": 1,
    "text": "بیایم نجویم به ره بر زمان"
  },
  {
    "poem_id": 1394,
    "vorder": 155,
    "position": 0,
    "text": "دوم روز چون چشمهٔ آفتاب"
  },
  {
    "poem_id": 1394,
    "vorder": 156,
    "position": 1,
    "text": "بجنبید و بیدار شد سر ز خواب"
  },
  {
    "poem_id": 1394,
    "vorder": 157,
    "position": 0,
    "text": "گرانمایه سیندخت بنهاد روی"
  },
  {
    "poem_id": 1394,
    "vorder": 158,
    "position": 1,
    "text": "به درگاه سالار دیهیم جوی"
  },
  {
    "poem_id": 1394,
    "vorder": 159,
    "position": 0,
    "text": "روارو برآمد ز درگاه سام"
  },
  {
    "poem_id": 1394,
    "vorder": 160,
    "position": 1,
    "text": "مه بانوان خواندندش به نام"
  },
  {
    "poem_id": 1394,
    "vorder": 161,
    "position": 0,
    "text": "بیامد بر سام و بردش نماز"
  },
  {
    "poem_id": 1394,
    "vorder": 162,
    "position": 1,
    "text": "سخن گفت بااو زمانی دراز"
  },
  {
    "poem_id": 1394,
    "vorder": 163,
    "position": 0,
    "text": "به دستوری بازگشتن به جای"
  },
  {
    "poem_id": 1394,
    "vorder": 164,
    "position": 1,
    "text": "شدن شادمان سوی کابل خدای"
  },
  {
    "poem_id": 1394,
    "vorder": 165,
    "position": 0,
    "text": "دگر ساختن کار مهمان نو"
  },
  {
    "poem_id": 1394,
    "vorder": 166,
    "position": 1,
    "text": "نمودن به داماد پیمان نو"
  },
  {
    "poem_id": 1394,
    "vorder": 167,
    "position": 0,
    "text": "ورا سام یل گفت برگرد و رو"
  },
  {
    "poem_id": 1394,
    "vorder": 168,
    "position": 1,
    "text": "بگو آنچه دیدی به مهراب گو"
  },
  {
    "poem_id": 1394,
    "vorder": 169,
    "position": 0,
    "text": "سزاوار او خلعت آراستند"
  },
  {
    "poem_id": 1394,
    "vorder": 170,
    "position": 1,
    "text": "ز گنج آنچه پرمایه‌تر خواستند"
  },
  {
    "poem_id": 1394,
    "vorder": 171,
    "position": 0,
    "text": "بکابل دگر سام را هر چه بود"
  },
  {
    "poem_id": 1394,
    "vorder": 172,
    "position": 1,
    "text": "ز کاخ و زباغ و زکشت و درود"
  },
  {
    "poem_id": 1394,
    "vorder": 173,
    "position": 0,
    "text": "دگر چارپایان دوشیدنی"
  },
  {
    "poem_id": 1394,
    "vorder": 174,
    "position": 1,
    "text": "ز گستردنی هم ز پوشیدنی"
  },
  {
    "poem_id": 1394,
    "vorder": 175,
    "position": 0,
    "text": "به سیندخت بخشید و دستش بدست"
  },
  {
    "poem_id": 1394,
    "vorder": 176,
    "position": 1,
    "text": "گرفت و یکی نیز پیمان ببست"
  },
  {
    "poem_id": 1394,
    "vorder": 177,
    "position": 0,
    "text": "پذیرفت مر دخت او را بزال"
  },
  {
    "poem_id": 1394,
    "vorder": 178,
    "position": 1,
    "text": "که باشند هر دو بشادی همال"
  },
  {
    "poem_id": 1394,
    "vorder": 179,
    "position": 0,
    "text": "سرافراز گردی و مردی دویست"
  },
  {
    "poem_id": 1394,
    "vorder": 180,
    "position": 1,
    "text": "بدو داد و گفتش که ایدر مایست"
  },
  {
    "poem_id": 1394,
    "vorder": 181,
    "position": 0,
    "text": "به کابل بباش و به شادی بمان"
  },
  {
    "poem_id": 1394,
    "vorder": 182,
    "position": 1,
    "text": "ازین پس مترس از بد بدگمان"
  },
  {
    "poem_id": 1394,
    "vorder": 183,
    "position": 0,
    "text": "شگفته شد آن روی پژمرده ماه"
  },
  {
    "poem_id": 1394,
    "vorder": 184,
    "position": 1,
    "text": "به نیک اختری برگرفتند راه"
  }
]