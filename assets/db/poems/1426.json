[
  {
    "poem_id": 1426,
    "vorder": 1,
    "position": 0,
    "text": "چو رستم بدید آنک قارن چه کرد"
  },
  {
    "poem_id": 1426,
    "vorder": 2,
    "position": 1,
    "text": "چه‌گونه بود ساز ننگ و نبرد"
  },
  {
    "poem_id": 1426,
    "vorder": 3,
    "position": 0,
    "text": "به پیش پدر شد بپرسید از وی"
  },
  {
    "poem_id": 1426,
    "vorder": 4,
    "position": 1,
    "text": "که با من جهان پهلوانا بگوی"
  },
  {
    "poem_id": 1426,
    "vorder": 5,
    "position": 0,
    "text": "که افراسیاب آن بد اندیش مرد"
  },
  {
    "poem_id": 1426,
    "vorder": 6,
    "position": 1,
    "text": "کجا جای گیرد به روز نبرد"
  },
  {
    "poem_id": 1426,
    "vorder": 7,
    "position": 0,
    "text": "چه پوشد کجا برافرازد درفش"
  },
  {
    "poem_id": 1426,
    "vorder": 8,
    "position": 1,
    "text": "که پیداست تابان درفش بنفش"
  },
  {
    "poem_id": 1426,
    "vorder": 9,
    "position": 0,
    "text": "من امروز بند کمرگاه اوی"
  },
  {
    "poem_id": 1426,
    "vorder": 10,
    "position": 1,
    "text": "بگیرم کشانش بیارم بروی"
  },
  {
    "poem_id": 1426,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت زال ای پسر گوش‌دار"
  },
  {
    "poem_id": 1426,
    "vorder": 12,
    "position": 1,
    "text": "یک امروز با خویشتن هوش‌دار"
  },
  {
    "poem_id": 1426,
    "vorder": 13,
    "position": 0,
    "text": "که آن ترک در جنگ نر اژدهاست"
  },
  {
    "poem_id": 1426,
    "vorder": 14,
    "position": 1,
    "text": "در آهنگ و در کینه اَبر بلاست"
  },
  {
    "poem_id": 1426,
    "vorder": 15,
    "position": 0,
    "text": "درفشش سیاهست و خفتان سیاه"
  },
  {
    "poem_id": 1426,
    "vorder": 16,
    "position": 1,
    "text": "ز آهنش ساعد ز آهن کلاه"
  },
  {
    "poem_id": 1426,
    "vorder": 17,
    "position": 0,
    "text": "همه روی آهن گرفته به زر"
  },
  {
    "poem_id": 1426,
    "vorder": 18,
    "position": 1,
    "text": "نشانی سیه بسته بر خود بر"
  },
  {
    "poem_id": 1426,
    "vorder": 19,
    "position": 0,
    "text": "ازو خویشتن را نگه‌دار سخت"
  },
  {
    "poem_id": 1426,
    "vorder": 20,
    "position": 1,
    "text": "که مردی دلیرست و پیروز بخت"
  },
  {
    "poem_id": 1426,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت رستم که ای پهلوان"
  },
  {
    "poem_id": 1426,
    "vorder": 22,
    "position": 1,
    "text": "تو از من مدار ایچ رنجه روان"
  },
  {
    "poem_id": 1426,
    "vorder": 23,
    "position": 0,
    "text": "جهان آفریننده یار منست"
  },
  {
    "poem_id": 1426,
    "vorder": 24,
    "position": 1,
    "text": "دل و تیغ و بازو حصار منست"
  },
  {
    "poem_id": 1426,
    "vorder": 25,
    "position": 0,
    "text": "برانگیخت آن رخش رویینه سم"
  },
  {
    "poem_id": 1426,
    "vorder": 26,
    "position": 1,
    "text": "برآمد خروشیدن گاو دم"
  },
  {
    "poem_id": 1426,
    "vorder": 27,
    "position": 0,
    "text": "چو افراسیابش به هامون بدید"
  },
  {
    "poem_id": 1426,
    "vorder": 28,
    "position": 1,
    "text": "شگفتید ازان کودک نارسید"
  },
  {
    "poem_id": 1426,
    "vorder": 29,
    "position": 0,
    "text": "ز ترکان بپرسید کین اژدها"
  },
  {
    "poem_id": 1426,
    "vorder": 30,
    "position": 1,
    "text": "بدین گونه از بند گشته رها"
  },
  {
    "poem_id": 1426,
    "vorder": 31,
    "position": 0,
    "text": "کدامست کین را ندانم به نام"
  },
  {
    "poem_id": 1426,
    "vorder": 32,
    "position": 1,
    "text": "یکی گفت کاین پور دستان سام"
  },
  {
    "poem_id": 1426,
    "vorder": 33,
    "position": 0,
    "text": "نبینی که با گرز سام آمدست"
  },
  {
    "poem_id": 1426,
    "vorder": 34,
    "position": 1,
    "text": "جوانست و جویای نام آمدست"
  },
  {
    "poem_id": 1426,
    "vorder": 35,
    "position": 0,
    "text": "به پیش سپاه آمد افراسیاب"
  },
  {
    "poem_id": 1426,
    "vorder": 36,
    "position": 1,
    "text": "چو کشتی که موجش برآرد ز آب"
  },
  {
    "poem_id": 1426,
    "vorder": 37,
    "position": 0,
    "text": "چو رستم ورا دید بفشارد ران"
  },
  {
    "poem_id": 1426,
    "vorder": 38,
    "position": 1,
    "text": "بگردن برآورد گرز گران"
  },
  {
    "poem_id": 1426,
    "vorder": 39,
    "position": 0,
    "text": "چو تنگ اندر آورد با او زمین"
  },
  {
    "poem_id": 1426,
    "vorder": 40,
    "position": 1,
    "text": "فرو کرد گرز گران را به زین"
  },
  {
    "poem_id": 1426,
    "vorder": 41,
    "position": 0,
    "text": "به بند کمرش اندر آورد چنگ"
  },
  {
    "poem_id": 1426,
    "vorder": 42,
    "position": 1,
    "text": "جدا کردش از پشت زین پلنگ"
  },
  {
    "poem_id": 1426,
    "vorder": 43,
    "position": 0,
    "text": "همی خواست بردنش پیش قباد"
  },
  {
    "poem_id": 1426,
    "vorder": 44,
    "position": 1,
    "text": "دهد روز جنگ نخستینش داد"
  },
  {
    "poem_id": 1426,
    "vorder": 45,
    "position": 0,
    "text": "ز هنگ سپهدار و چنگ سوار"
  },
  {
    "poem_id": 1426,
    "vorder": 46,
    "position": 1,
    "text": "نیامد دوال کمر پایدار"
  },
  {
    "poem_id": 1426,
    "vorder": 47,
    "position": 0,
    "text": "گسست و به خاک اندر آمد سرش"
  },
  {
    "poem_id": 1426,
    "vorder": 48,
    "position": 1,
    "text": "سواران گرفتند گرد اندرش"
  },
  {
    "poem_id": 1426,
    "vorder": 49,
    "position": 0,
    "text": "سپهبد چو از چنگ رستم بجست"
  },
  {
    "poem_id": 1426,
    "vorder": 50,
    "position": 1,
    "text": "بخائید رستم همی پشت دست"
  },
  {
    "poem_id": 1426,
    "vorder": 51,
    "position": 0,
    "text": "چرا گفت نگرفتمش زیرکش"
  },
  {
    "poem_id": 1426,
    "vorder": 52,
    "position": 1,
    "text": "همی بر کمر ساختم بند خوش"
  },
  {
    "poem_id": 1426,
    "vorder": 53,
    "position": 0,
    "text": "چو آوای زنگ آمد از پشت پیل"
  },
  {
    "poem_id": 1426,
    "vorder": 54,
    "position": 1,
    "text": "خروشیدن کوس بر چند میل"
  },
  {
    "poem_id": 1426,
    "vorder": 55,
    "position": 0,
    "text": "یکی مژده بردند نزدیک شاه"
  },
  {
    "poem_id": 1426,
    "vorder": 56,
    "position": 1,
    "text": "که رستم بدرید قلب سپاه"
  },
  {
    "poem_id": 1426,
    "vorder": 57,
    "position": 0,
    "text": "چنان تا بر شاه ترکان رسید"
  },
  {
    "poem_id": 1426,
    "vorder": 58,
    "position": 1,
    "text": "درفش سپهدار شد ناپدید"
  },
  {
    "poem_id": 1426,
    "vorder": 59,
    "position": 0,
    "text": "گرفتش کمربند و بفگند خوار"
  },
  {
    "poem_id": 1426,
    "vorder": 60,
    "position": 1,
    "text": "خروشی ز ترکان برآمد بزار"
  },
  {
    "poem_id": 1426,
    "vorder": 61,
    "position": 0,
    "text": "ز جای اندر آمد چو آتش قباد"
  },
  {
    "poem_id": 1426,
    "vorder": 62,
    "position": 1,
    "text": "بجنبید لشگر چو دریا ز باد"
  },
  {
    "poem_id": 1426,
    "vorder": 63,
    "position": 0,
    "text": "برآمد خروشیدن دار و کوب"
  },
  {
    "poem_id": 1426,
    "vorder": 64,
    "position": 1,
    "text": "درخشیدن خنجر و زخم چوب"
  },
  {
    "poem_id": 1426,
    "vorder": 65,
    "position": 0,
    "text": "بران ترگ زرین و زرین سپر"
  },
  {
    "poem_id": 1426,
    "vorder": 66,
    "position": 1,
    "text": "غمی شد سر از چاک چاک تبر"
  },
  {
    "poem_id": 1426,
    "vorder": 67,
    "position": 0,
    "text": "تو گفتی که ابری برآمد ز کنج"
  },
  {
    "poem_id": 1426,
    "vorder": 68,
    "position": 1,
    "text": "ز شنگرف نیرنگ زد بر ترنج"
  },
  {
    "poem_id": 1426,
    "vorder": 69,
    "position": 0,
    "text": "ز گرد سواران در آن پهن دشت"
  },
  {
    "poem_id": 1426,
    "vorder": 70,
    "position": 1,
    "text": "زمین شش شد و آسمان گشت هشت"
  },
  {
    "poem_id": 1426,
    "vorder": 71,
    "position": 0,
    "text": "هزار و صد و شصت گرد دلیر"
  },
  {
    "poem_id": 1426,
    "vorder": 72,
    "position": 1,
    "text": "به یک زخم شد کشته چون نره شیر"
  },
  {
    "poem_id": 1426,
    "vorder": 73,
    "position": 0,
    "text": "برفتند ترکان ز پیش مغان"
  },
  {
    "poem_id": 1426,
    "vorder": 74,
    "position": 1,
    "text": "کشیدند لشگر سوی دامغان"
  },
  {
    "poem_id": 1426,
    "vorder": 75,
    "position": 0,
    "text": "وزانجا به جیحون نهادند روی"
  },
  {
    "poem_id": 1426,
    "vorder": 76,
    "position": 1,
    "text": "خلیده دل و با غم و گفت‌وگوی"
  },
  {
    "poem_id": 1426,
    "vorder": 77,
    "position": 0,
    "text": "شکسته سلیح و گسسته کمر"
  },
  {
    "poem_id": 1426,
    "vorder": 78,
    "position": 1,
    "text": "نه بوق و نه کوس و نه پای و نه سر"
  }
]