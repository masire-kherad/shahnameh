[
  {
    "poem_id": 1781,
    "vorder": 1,
    "position": 0,
    "text": "به روز سدیگر برون رفت شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 2,
    "position": 1,
    "text": "ابا لشکر و ساز نخچیرگاه"
  },
  {
    "poem_id": 1781,
    "vorder": 3,
    "position": 0,
    "text": "بزرگان ایران ز بهر شکار"
  },
  {
    "poem_id": 1781,
    "vorder": 4,
    "position": 1,
    "text": "به درگاه رفتند سیصد سوار"
  },
  {
    "poem_id": 1781,
    "vorder": 5,
    "position": 0,
    "text": "ابا هر سواری پرستنده سی"
  },
  {
    "poem_id": 1781,
    "vorder": 6,
    "position": 1,
    "text": "ز ترک و ز رومی و از پارسی"
  },
  {
    "poem_id": 1781,
    "vorder": 7,
    "position": 0,
    "text": "پرستنده سیصد ز ایوان شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 8,
    "position": 1,
    "text": "برفتند با ساز نخچیرگاه"
  },
  {
    "poem_id": 1781,
    "vorder": 9,
    "position": 0,
    "text": "ز دیبا بیاراسته صد شتر"
  },
  {
    "poem_id": 1781,
    "vorder": 10,
    "position": 1,
    "text": "رکابش همه زر و پالانش در"
  },
  {
    "poem_id": 1781,
    "vorder": 11,
    "position": 0,
    "text": "ده اشتر نشستنگه شاه را"
  },
  {
    "poem_id": 1781,
    "vorder": 12,
    "position": 1,
    "text": "به دیبا بیاراسته گاه را"
  },
  {
    "poem_id": 1781,
    "vorder": 13,
    "position": 0,
    "text": "به پیش اندر آراسته هفت پیل"
  },
  {
    "poem_id": 1781,
    "vorder": 14,
    "position": 1,
    "text": "برو تخت پیروزه همرنگ نیل"
  },
  {
    "poem_id": 1781,
    "vorder": 15,
    "position": 0,
    "text": "همه پایهٔ تخت زر و بلور"
  },
  {
    "poem_id": 1781,
    "vorder": 16,
    "position": 1,
    "text": "نشستنگه شاه بهرام گور"
  },
  {
    "poem_id": 1781,
    "vorder": 17,
    "position": 0,
    "text": "ابا هر یکی تیغ‌زن صد غلام"
  },
  {
    "poem_id": 1781,
    "vorder": 18,
    "position": 1,
    "text": "به زرین کمرها و زرین ستام"
  },
  {
    "poem_id": 1781,
    "vorder": 19,
    "position": 0,
    "text": "صد اشتر بد از بهر رامشگران"
  },
  {
    "poem_id": 1781,
    "vorder": 20,
    "position": 1,
    "text": "همه بر سران افسر از گوهران"
  },
  {
    "poem_id": 1781,
    "vorder": 21,
    "position": 0,
    "text": "ابا بازداران صد و شست باز"
  },
  {
    "poem_id": 1781,
    "vorder": 22,
    "position": 1,
    "text": "دو صد چرغ و شاهین گردن‌فراز"
  },
  {
    "poem_id": 1781,
    "vorder": 23,
    "position": 0,
    "text": "پس‌اندر یکی مرغ بودی سیاه"
  },
  {
    "poem_id": 1781,
    "vorder": 24,
    "position": 1,
    "text": "گرامی‌تر آن بود بر چشم شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 25,
    "position": 0,
    "text": "سیاهی به چنگ و به منقار زرد"
  },
  {
    "poem_id": 1781,
    "vorder": 26,
    "position": 1,
    "text": "چو زر درخشنده بر لاژورد"
  },
  {
    "poem_id": 1781,
    "vorder": 27,
    "position": 0,
    "text": "همی خواندش شاه طغری به نام"
  },
  {
    "poem_id": 1781,
    "vorder": 28,
    "position": 1,
    "text": "دو چشمش به رنگ پر از خون دو جام"
  },
  {
    "poem_id": 1781,
    "vorder": 29,
    "position": 0,
    "text": "که خاقان چینش فرستاده بود"
  },
  {
    "poem_id": 1781,
    "vorder": 30,
    "position": 1,
    "text": "یکی تخت با تاج بیجاده بود"
  },
  {
    "poem_id": 1781,
    "vorder": 31,
    "position": 0,
    "text": "یکی طوق زرین زبرجد نگار"
  },
  {
    "poem_id": 1781,
    "vorder": 32,
    "position": 1,
    "text": "چهل یاره و سی و شش گوشوار"
  },
  {
    "poem_id": 1781,
    "vorder": 33,
    "position": 0,
    "text": "شتروار سیصد طرایف ز چین"
  },
  {
    "poem_id": 1781,
    "vorder": 34,
    "position": 1,
    "text": "فرستاد و یاقوت سیصد نگین"
  },
  {
    "poem_id": 1781,
    "vorder": 35,
    "position": 0,
    "text": "پس بازداران صد و شست یوز"
  },
  {
    "poem_id": 1781,
    "vorder": 36,
    "position": 1,
    "text": "ببردند با شاه گیتی فرزو"
  },
  {
    "poem_id": 1781,
    "vorder": 37,
    "position": 0,
    "text": "بیاراسته طوق یوز از گهر"
  },
  {
    "poem_id": 1781,
    "vorder": 38,
    "position": 1,
    "text": "بدو اندر افگنده زنجیر زر"
  },
  {
    "poem_id": 1781,
    "vorder": 39,
    "position": 0,
    "text": "بیامد شهنشاه زین سان به دشت"
  },
  {
    "poem_id": 1781,
    "vorder": 40,
    "position": 1,
    "text": "همی تاجش از مشتری برگذشت"
  },
  {
    "poem_id": 1781,
    "vorder": 41,
    "position": 0,
    "text": "هرانکس که بودند نخچیرجوی"
  },
  {
    "poem_id": 1781,
    "vorder": 42,
    "position": 1,
    "text": "سوی آب دریا نهادند روی"
  },
  {
    "poem_id": 1781,
    "vorder": 43,
    "position": 0,
    "text": "جهاندار بهرام هر هفت سال"
  },
  {
    "poem_id": 1781,
    "vorder": 44,
    "position": 1,
    "text": "بدان آب رفتی به فرخنده فال"
  },
  {
    "poem_id": 1781,
    "vorder": 45,
    "position": 0,
    "text": "چو لشکر به نزدیک دریا رسید"
  },
  {
    "poem_id": 1781,
    "vorder": 46,
    "position": 1,
    "text": "شهنشاه دریا پر از مرغ دید"
  },
  {
    "poem_id": 1781,
    "vorder": 47,
    "position": 0,
    "text": "بزد طبل و طغری شد اندر هوا"
  },
  {
    "poem_id": 1781,
    "vorder": 48,
    "position": 1,
    "text": "شکیبا نبد مرغ فرمانروا"
  },
  {
    "poem_id": 1781,
    "vorder": 49,
    "position": 0,
    "text": "زبون بود چنگال او را کلنگ"
  },
  {
    "poem_id": 1781,
    "vorder": 50,
    "position": 1,
    "text": "شکاری چو نخچیر بود او پلنگ"
  },
  {
    "poem_id": 1781,
    "vorder": 51,
    "position": 0,
    "text": "سرانجام گشت از جهان ناپدید"
  },
  {
    "poem_id": 1781,
    "vorder": 52,
    "position": 1,
    "text": "کلنگی به چنگ آمدش بردمید"
  },
  {
    "poem_id": 1781,
    "vorder": 53,
    "position": 0,
    "text": "بپرید بر سان تیر از کمان"
  },
  {
    "poem_id": 1781,
    "vorder": 54,
    "position": 1,
    "text": "یکی بازدار از پس اندر دمان"
  },
  {
    "poem_id": 1781,
    "vorder": 55,
    "position": 0,
    "text": "دل شاه گشت از پریدنش تنگ"
  },
  {
    "poem_id": 1781,
    "vorder": 56,
    "position": 1,
    "text": "همی تاخت از پس به آواز زنگ"
  },
  {
    "poem_id": 1781,
    "vorder": 57,
    "position": 0,
    "text": "یکی باغ پیش اندر آمد فراخ"
  },
  {
    "poem_id": 1781,
    "vorder": 58,
    "position": 1,
    "text": "برآورده از گوشهٔ باغ کاخ"
  },
  {
    "poem_id": 1781,
    "vorder": 59,
    "position": 0,
    "text": "بشد تازیان با تنی چند شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 60,
    "position": 1,
    "text": "همی بود لشکر به نخچیرگاه"
  },
  {
    "poem_id": 1781,
    "vorder": 61,
    "position": 0,
    "text": "چو بهرام گور اندر آمد به باغ"
  },
  {
    "poem_id": 1781,
    "vorder": 62,
    "position": 1,
    "text": "یکی جای دید از برش تند راغ"
  },
  {
    "poem_id": 1781,
    "vorder": 63,
    "position": 0,
    "text": "میان گلستان یکی آبگیر"
  },
  {
    "poem_id": 1781,
    "vorder": 64,
    "position": 1,
    "text": "بروبر نشسته یکی مرد پیر"
  },
  {
    "poem_id": 1781,
    "vorder": 65,
    "position": 0,
    "text": "زمینش به دیبا بیاراسته"
  },
  {
    "poem_id": 1781,
    "vorder": 66,
    "position": 1,
    "text": "همه باغ پر بنده و خواسته"
  },
  {
    "poem_id": 1781,
    "vorder": 67,
    "position": 0,
    "text": "سه دختر بر او نشسته چو عاج"
  },
  {
    "poem_id": 1781,
    "vorder": 68,
    "position": 1,
    "text": "نهاده به سربر ز پیروزه تاج"
  },
  {
    "poem_id": 1781,
    "vorder": 69,
    "position": 0,
    "text": "به رخ چون بهار و به بالا بلند"
  },
  {
    "poem_id": 1781,
    "vorder": 70,
    "position": 1,
    "text": "به ابرو کمان و به گیسو کمند"
  },
  {
    "poem_id": 1781,
    "vorder": 71,
    "position": 0,
    "text": "یکی جام بر دست هر یک بلور"
  },
  {
    "poem_id": 1781,
    "vorder": 72,
    "position": 1,
    "text": "بدیشان نگه کرد بهرام گور"
  },
  {
    "poem_id": 1781,
    "vorder": 73,
    "position": 0,
    "text": "ز دیدارشان چشم او خیره شد"
  },
  {
    "poem_id": 1781,
    "vorder": 74,
    "position": 1,
    "text": "ز باز و ز طغری دلش تیره شد"
  },
  {
    "poem_id": 1781,
    "vorder": 75,
    "position": 0,
    "text": "چو دهقان پرمایه او را بدید"
  },
  {
    "poem_id": 1781,
    "vorder": 76,
    "position": 1,
    "text": "رخ او شد از بیم چون شنبلید"
  },
  {
    "poem_id": 1781,
    "vorder": 77,
    "position": 0,
    "text": "خردمند پیری و برزین به نام"
  },
  {
    "poem_id": 1781,
    "vorder": 78,
    "position": 1,
    "text": "دل او شد از شاه ناشادکام"
  },
  {
    "poem_id": 1781,
    "vorder": 79,
    "position": 0,
    "text": "برفت از بر حوض برزین چو باد"
  },
  {
    "poem_id": 1781,
    "vorder": 80,
    "position": 1,
    "text": "بر شاه شد خاک را بوسه داد"
  },
  {
    "poem_id": 1781,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت کای شاه خورشیدچهر"
  },
  {
    "poem_id": 1781,
    "vorder": 82,
    "position": 1,
    "text": "به کام تو گرداد گردان سپهر"
  },
  {
    "poem_id": 1781,
    "vorder": 83,
    "position": 0,
    "text": "نیارمت گفتن که ایدر بایست"
  },
  {
    "poem_id": 1781,
    "vorder": 84,
    "position": 1,
    "text": "بدین مرز من با سواری دویست"
  },
  {
    "poem_id": 1781,
    "vorder": 85,
    "position": 0,
    "text": "سر و نام برزین برآید به ماه"
  },
  {
    "poem_id": 1781,
    "vorder": 86,
    "position": 1,
    "text": "اگر شاد گردد بدین باغ شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 87,
    "position": 0,
    "text": "به برزین چنین گفت شاه جهان"
  },
  {
    "poem_id": 1781,
    "vorder": 88,
    "position": 1,
    "text": "که امروز طغری شد از من نهان"
  },
  {
    "poem_id": 1781,
    "vorder": 89,
    "position": 0,
    "text": "دلم شد ازان مرغ گیرنده تنگ"
  },
  {
    "poem_id": 1781,
    "vorder": 90,
    "position": 1,
    "text": "که مرغان چو نخچیر بد او پلنگ"
  },
  {
    "poem_id": 1781,
    "vorder": 91,
    "position": 0,
    "text": "چنین پاسخ آورد برزین به شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 92,
    "position": 1,
    "text": "که اکنون یکی مرغ دیدم سیاه"
  },
  {
    "poem_id": 1781,
    "vorder": 93,
    "position": 0,
    "text": "ابا زنگ زرین تنش همچو قیر"
  },
  {
    "poem_id": 1781,
    "vorder": 94,
    "position": 1,
    "text": "همان چنگ و منقار او چون زریر"
  },
  {
    "poem_id": 1781,
    "vorder": 95,
    "position": 0,
    "text": "بیامد بران گوزبن بر نشست"
  },
  {
    "poem_id": 1781,
    "vorder": 96,
    "position": 1,
    "text": "بیاید هم‌اکنون به بختت به دست"
  },
  {
    "poem_id": 1781,
    "vorder": 97,
    "position": 0,
    "text": "هم‌انگه یکی بنده را گفت شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 98,
    "position": 1,
    "text": "که رو گوزین کن سراسر نگاه"
  },
  {
    "poem_id": 1781,
    "vorder": 99,
    "position": 0,
    "text": "بشد بنده چون باد و آواز داد"
  },
  {
    "poem_id": 1781,
    "vorder": 100,
    "position": 1,
    "text": "که همواره شاه جهان باد شاد"
  },
  {
    "poem_id": 1781,
    "vorder": 101,
    "position": 0,
    "text": "که طغری به شاخی برآویختست"
  },
  {
    "poem_id": 1781,
    "vorder": 102,
    "position": 1,
    "text": "کنون بازدارش بگیرد به دست"
  },
  {
    "poem_id": 1781,
    "vorder": 103,
    "position": 0,
    "text": "چو طغری پدید آمد آن پیر گفت"
  },
  {
    "poem_id": 1781,
    "vorder": 104,
    "position": 1,
    "text": "که ای بر زمین شاه بی‌بار و جفت"
  },
  {
    "poem_id": 1781,
    "vorder": 105,
    "position": 0,
    "text": "پی مرزبان بر تو فرخنده باد"
  },
  {
    "poem_id": 1781,
    "vorder": 106,
    "position": 1,
    "text": "همه تاجداران ترا بنده باد"
  },
  {
    "poem_id": 1781,
    "vorder": 107,
    "position": 0,
    "text": "بدین شادی اکنون یکی جام خواه"
  },
  {
    "poem_id": 1781,
    "vorder": 108,
    "position": 1,
    "text": "چو آرام دل یافتی کام خواه"
  },
  {
    "poem_id": 1781,
    "vorder": 109,
    "position": 0,
    "text": "شهنشاه گیتی بران آبگیر"
  },
  {
    "poem_id": 1781,
    "vorder": 110,
    "position": 1,
    "text": "فرود آمد و شادمان گشت پیر"
  },
  {
    "poem_id": 1781,
    "vorder": 111,
    "position": 0,
    "text": "بیامد هم‌انگاه دستور اوی"
  },
  {
    "poem_id": 1781,
    "vorder": 112,
    "position": 1,
    "text": "همان گنج داران و گنجور اوی"
  },
  {
    "poem_id": 1781,
    "vorder": 113,
    "position": 0,
    "text": "بیاورد برزین می سرخ و جام"
  },
  {
    "poem_id": 1781,
    "vorder": 114,
    "position": 1,
    "text": "نخستین ز شاه جهان برد نام"
  },
  {
    "poem_id": 1781,
    "vorder": 115,
    "position": 0,
    "text": "بیاورد خوان و خورش ساختند"
  },
  {
    "poem_id": 1781,
    "vorder": 116,
    "position": 1,
    "text": "چو از خوردن نان بپرداختند"
  },
  {
    "poem_id": 1781,
    "vorder": 117,
    "position": 0,
    "text": "ازان پس بیاورد جامی بلور"
  },
  {
    "poem_id": 1781,
    "vorder": 118,
    "position": 1,
    "text": "نهادند بر دست بهرام گور"
  },
  {
    "poem_id": 1781,
    "vorder": 119,
    "position": 0,
    "text": "جهاندار بهرام بستد نبید"
  },
  {
    "poem_id": 1781,
    "vorder": 120,
    "position": 1,
    "text": "از اندازهٔ خط برتر کشید"
  },
  {
    "poem_id": 1781,
    "vorder": 121,
    "position": 0,
    "text": "چو برزین چنان دید برگشت شاد"
  },
  {
    "poem_id": 1781,
    "vorder": 122,
    "position": 1,
    "text": "بیامد به هر جای خمی نهاد"
  },
  {
    "poem_id": 1781,
    "vorder": 123,
    "position": 0,
    "text": "چو شد مست برزین بدان دختران"
  },
  {
    "poem_id": 1781,
    "vorder": 124,
    "position": 1,
    "text": "چنین گفت کای پرخرد مهتران"
  },
  {
    "poem_id": 1781,
    "vorder": 125,
    "position": 0,
    "text": "بدین باغ بهرامشاه آمدست"
  },
  {
    "poem_id": 1781,
    "vorder": 126,
    "position": 1,
    "text": "نه گردنکشی با سپاه آمدست"
  },
  {
    "poem_id": 1781,
    "vorder": 127,
    "position": 0,
    "text": "هلا چامه پیش آور ای چامه‌گوی"
  },
  {
    "poem_id": 1781,
    "vorder": 128,
    "position": 1,
    "text": "تو چنگ آور ای دختر ماه‌روی"
  },
  {
    "poem_id": 1781,
    "vorder": 129,
    "position": 0,
    "text": "برفتند هر سه به نزدیک شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 130,
    "position": 1,
    "text": "نهادند بر سر ز گوهر کلاه"
  },
  {
    "poem_id": 1781,
    "vorder": 131,
    "position": 0,
    "text": "یکی پای کوب و دگر چنگ‌زن"
  },
  {
    "poem_id": 1781,
    "vorder": 132,
    "position": 1,
    "text": "سه دیگر خوش‌آواز لشکر شکن"
  },
  {
    "poem_id": 1781,
    "vorder": 133,
    "position": 0,
    "text": "به آواز ایشان شهنشاه جام"
  },
  {
    "poem_id": 1781,
    "vorder": 134,
    "position": 1,
    "text": "ز باده تهی کرد و شد شادکام"
  },
  {
    "poem_id": 1781,
    "vorder": 135,
    "position": 0,
    "text": "بدو گفت کاین دختران کیند"
  },
  {
    "poem_id": 1781,
    "vorder": 136,
    "position": 1,
    "text": "که با تو بدین شادمانی زیند"
  },
  {
    "poem_id": 1781,
    "vorder": 137,
    "position": 0,
    "text": "چنین گفت برزین که ای شهریار"
  },
  {
    "poem_id": 1781,
    "vorder": 138,
    "position": 1,
    "text": "مبیناد بی‌تو کسی روزگار"
  },
  {
    "poem_id": 1781,
    "vorder": 139,
    "position": 0,
    "text": "چنان دان که این دلبران منند"
  },
  {
    "poem_id": 1781,
    "vorder": 140,
    "position": 1,
    "text": "پسندیده و دختران منند"
  },
  {
    "poem_id": 1781,
    "vorder": 141,
    "position": 0,
    "text": "یکی چامه‌گوی و یکی چنگ‌زن"
  },
  {
    "poem_id": 1781,
    "vorder": 142,
    "position": 1,
    "text": "سیم پای کوبد شکن بر شکن"
  },
  {
    "poem_id": 1781,
    "vorder": 143,
    "position": 0,
    "text": "چهارم به کردار خرم بهار"
  },
  {
    "poem_id": 1781,
    "vorder": 144,
    "position": 1,
    "text": "بدین سان که بیند همی شهریار"
  },
  {
    "poem_id": 1781,
    "vorder": 145,
    "position": 0,
    "text": "بدان چامه‌زن گفت کای ماه‌روی"
  },
  {
    "poem_id": 1781,
    "vorder": 146,
    "position": 1,
    "text": "بپرداز دل چامهٔ شاه گوی"
  },
  {
    "poem_id": 1781,
    "vorder": 147,
    "position": 0,
    "text": "بتان چامه و چنگ برساختند"
  },
  {
    "poem_id": 1781,
    "vorder": 148,
    "position": 1,
    "text": "یکایک دل از غم بپرداختند"
  },
  {
    "poem_id": 1781,
    "vorder": 149,
    "position": 0,
    "text": "نخستین شهنشاه را چامه‌گوی"
  },
  {
    "poem_id": 1781,
    "vorder": 150,
    "position": 1,
    "text": "چنین گفت کای خسرو ماه‌روی"
  },
  {
    "poem_id": 1781,
    "vorder": 151,
    "position": 0,
    "text": "نمانی مگر بر فلک ماه را"
  },
  {
    "poem_id": 1781,
    "vorder": 152,
    "position": 1,
    "text": "به شادی همان خسرو گاه را"
  },
  {
    "poem_id": 1781,
    "vorder": 153,
    "position": 0,
    "text": "به دیدار ماهی و بالای ساج"
  },
  {
    "poem_id": 1781,
    "vorder": 154,
    "position": 1,
    "text": "بنازد بتو تخت شاهی و تاج"
  },
  {
    "poem_id": 1781,
    "vorder": 155,
    "position": 0,
    "text": "خنک آنک شبگیر بیندت روی"
  },
  {
    "poem_id": 1781,
    "vorder": 156,
    "position": 1,
    "text": "خنک آنک یابد ز موی تو بوی"
  },
  {
    "poem_id": 1781,
    "vorder": 157,
    "position": 0,
    "text": "میان تنگ چون شیر و بازو ستبر"
  },
  {
    "poem_id": 1781,
    "vorder": 158,
    "position": 1,
    "text": "همی فر تاجت برآید به ابر"
  },
  {
    "poem_id": 1781,
    "vorder": 159,
    "position": 0,
    "text": "به گلنار ماند همی چهر تو"
  },
  {
    "poem_id": 1781,
    "vorder": 160,
    "position": 1,
    "text": "به شادی بخندد دل از مهر تو"
  },
  {
    "poem_id": 1781,
    "vorder": 161,
    "position": 0,
    "text": "دلت همچو دریا و رایت چو ابر"
  },
  {
    "poem_id": 1781,
    "vorder": 162,
    "position": 1,
    "text": "شکارت نبینم همی جز هژبر"
  },
  {
    "poem_id": 1781,
    "vorder": 163,
    "position": 0,
    "text": "همی مو شکافی به پیکان تیر"
  },
  {
    "poem_id": 1781,
    "vorder": 164,
    "position": 1,
    "text": "همی آب گردد ز داد تو شیر"
  },
  {
    "poem_id": 1781,
    "vorder": 165,
    "position": 0,
    "text": "سپاهی که بیند کمند ترا"
  },
  {
    "poem_id": 1781,
    "vorder": 166,
    "position": 1,
    "text": "همان بازوی زورمند ترا"
  },
  {
    "poem_id": 1781,
    "vorder": 167,
    "position": 0,
    "text": "به درد دل و مغز جنگاوران"
  },
  {
    "poem_id": 1781,
    "vorder": 168,
    "position": 1,
    "text": "وگر چند باشد سپاهی گران"
  },
  {
    "poem_id": 1781,
    "vorder": 169,
    "position": 0,
    "text": "چو آن چامه بشنید بهرام گور"
  },
  {
    "poem_id": 1781,
    "vorder": 170,
    "position": 1,
    "text": "بخورد آن گران سنگ جام بلور"
  },
  {
    "poem_id": 1781,
    "vorder": 171,
    "position": 0,
    "text": "بدو گفت شاه ای سرافراز مرد"
  },
  {
    "poem_id": 1781,
    "vorder": 172,
    "position": 1,
    "text": "چشیده ز گیتی بسی گرم و سرد"
  },
  {
    "poem_id": 1781,
    "vorder": 173,
    "position": 0,
    "text": "نیابی تو داماد بهتر ز من"
  },
  {
    "poem_id": 1781,
    "vorder": 174,
    "position": 1,
    "text": "گو شهریاران سر انجمن"
  },
  {
    "poem_id": 1781,
    "vorder": 175,
    "position": 0,
    "text": "بمن ده تو این هر سه دخترت را"
  },
  {
    "poem_id": 1781,
    "vorder": 176,
    "position": 1,
    "text": "به کیوان برافرازم اخترت را"
  },
  {
    "poem_id": 1781,
    "vorder": 177,
    "position": 0,
    "text": "به دو گفت برزین که ای شهریار"
  },
  {
    "poem_id": 1781,
    "vorder": 178,
    "position": 1,
    "text": "بتو شاد بادا می و میگسار"
  },
  {
    "poem_id": 1781,
    "vorder": 179,
    "position": 0,
    "text": "که یارست گفت این خود اندر جهان"
  },
  {
    "poem_id": 1781,
    "vorder": 180,
    "position": 1,
    "text": "که دارد چنین زهره اندر نهان"
  },
  {
    "poem_id": 1781,
    "vorder": 181,
    "position": 0,
    "text": "مرا گر پذیری بسان رهی"
  },
  {
    "poem_id": 1781,
    "vorder": 182,
    "position": 1,
    "text": "که بپرستم این تخت شاهنشهی"
  },
  {
    "poem_id": 1781,
    "vorder": 183,
    "position": 0,
    "text": "پرستش کنم تاج و تخت ترا"
  },
  {
    "poem_id": 1781,
    "vorder": 184,
    "position": 1,
    "text": "همان فر و اورنگ و بخت ترا"
  },
  {
    "poem_id": 1781,
    "vorder": 185,
    "position": 0,
    "text": "همان این سه دختر پرستنده‌اند"
  },
  {
    "poem_id": 1781,
    "vorder": 186,
    "position": 1,
    "text": "به پیش تو بر پای چون بنده‌اند"
  },
  {
    "poem_id": 1781,
    "vorder": 187,
    "position": 0,
    "text": "پرستندگان را پسندید شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 188,
    "position": 1,
    "text": "بدان سان که از دور دیدش سه ماه"
  },
  {
    "poem_id": 1781,
    "vorder": 189,
    "position": 0,
    "text": "به بالای ساجند و همرنگ عاج"
  },
  {
    "poem_id": 1781,
    "vorder": 190,
    "position": 1,
    "text": "سزاوار تخت‌اند و زیبای تاج"
  },
  {
    "poem_id": 1781,
    "vorder": 191,
    "position": 0,
    "text": "پس‌انگاه گفتش به بهرام پیر"
  },
  {
    "poem_id": 1781,
    "vorder": 192,
    "position": 1,
    "text": "که ای شاه دشمن‌کش و شیرگیر"
  },
  {
    "poem_id": 1781,
    "vorder": 193,
    "position": 0,
    "text": "بگویم کنون هرچ هستم نهان"
  },
  {
    "poem_id": 1781,
    "vorder": 194,
    "position": 1,
    "text": "بد و نیک با شهریار جهان"
  },
  {
    "poem_id": 1781,
    "vorder": 195,
    "position": 0,
    "text": "ز پوشیدنی هم ز گستردنی"
  },
  {
    "poem_id": 1781,
    "vorder": 196,
    "position": 1,
    "text": "ز افگندنی و پراگندگی"
  },
  {
    "poem_id": 1781,
    "vorder": 197,
    "position": 0,
    "text": "همانا شتربار باشد دویست"
  },
  {
    "poem_id": 1781,
    "vorder": 198,
    "position": 1,
    "text": "به ایوان من بنده‌گر بیش نیست"
  },
  {
    "poem_id": 1781,
    "vorder": 199,
    "position": 0,
    "text": "همان یاره و طوق و هم تاج و تخت"
  },
  {
    "poem_id": 1781,
    "vorder": 200,
    "position": 1,
    "text": "کزان دختران را بود نیک‌بخت"
  },
  {
    "poem_id": 1781,
    "vorder": 201,
    "position": 0,
    "text": "ز برزین بخندید بهرام و گفت"
  },
  {
    "poem_id": 1781,
    "vorder": 202,
    "position": 1,
    "text": "که چیزی که داری تو اندر نهفت"
  },
  {
    "poem_id": 1781,
    "vorder": 203,
    "position": 0,
    "text": "بمان تا بباشد هم‌انجا به جای"
  },
  {
    "poem_id": 1781,
    "vorder": 204,
    "position": 1,
    "text": "تو با جام می سوی رامش گرای"
  },
  {
    "poem_id": 1781,
    "vorder": 205,
    "position": 0,
    "text": "بدو پیر گفت این سه دختر چو ماه"
  },
  {
    "poem_id": 1781,
    "vorder": 206,
    "position": 1,
    "text": "به راه کیومرث و هوشنگ شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 207,
    "position": 0,
    "text": "ترا دادم و خاک پای تواند"
  },
  {
    "poem_id": 1781,
    "vorder": 208,
    "position": 1,
    "text": "همه هر سه زنده برای تواند"
  },
  {
    "poem_id": 1781,
    "vorder": 209,
    "position": 0,
    "text": "مهین دخترم نام ماه‌آفرید"
  },
  {
    "poem_id": 1781,
    "vorder": 210,
    "position": 1,
    "text": "فرانک دوم و سیوم شنبلید"
  },
  {
    "poem_id": 1781,
    "vorder": 211,
    "position": 0,
    "text": "پسندیدشان شاه چون دیدشان"
  },
  {
    "poem_id": 1781,
    "vorder": 212,
    "position": 1,
    "text": "ز بانو زنان نیز بگزیدشان"
  },
  {
    "poem_id": 1781,
    "vorder": 213,
    "position": 0,
    "text": "به برزین چنین گفت کاین هر سه ماه"
  },
  {
    "poem_id": 1781,
    "vorder": 214,
    "position": 1,
    "text": "پسندید چون دید بهرامشاه"
  },
  {
    "poem_id": 1781,
    "vorder": 215,
    "position": 0,
    "text": "بفرمود تا مهد زرین چهار"
  },
  {
    "poem_id": 1781,
    "vorder": 216,
    "position": 1,
    "text": "بیارد ز لشکر یکی نامدار"
  },
  {
    "poem_id": 1781,
    "vorder": 217,
    "position": 0,
    "text": "چو هر سه مه اندر عماری نشست"
  },
  {
    "poem_id": 1781,
    "vorder": 218,
    "position": 1,
    "text": "ز رومی همان خادم آورد شست"
  },
  {
    "poem_id": 1781,
    "vorder": 219,
    "position": 0,
    "text": "به مشکوی زرین شدند این سه ماه"
  },
  {
    "poem_id": 1781,
    "vorder": 220,
    "position": 1,
    "text": "همی بود تا مست‌تر گشت شاه"
  },
  {
    "poem_id": 1781,
    "vorder": 221,
    "position": 0,
    "text": "بدو گفت برزین که ای شهریار"
  },
  {
    "poem_id": 1781,
    "vorder": 222,
    "position": 1,
    "text": "جهاندار و دانا و نیزه‌گزار"
  },
  {
    "poem_id": 1781,
    "vorder": 223,
    "position": 0,
    "text": "یکی بنده‌ام تا زیم شاه را"
  },
  {
    "poem_id": 1781,
    "vorder": 224,
    "position": 1,
    "text": "نیایش کنم خاک درگاه را"
  },
  {
    "poem_id": 1781,
    "vorder": 225,
    "position": 0,
    "text": "یکی بنده تازانهٔ شاه را"
  },
  {
    "poem_id": 1781,
    "vorder": 226,
    "position": 1,
    "text": "ببرد و بیاراست درگاه را"
  },
  {
    "poem_id": 1781,
    "vorder": 227,
    "position": 0,
    "text": "سپه را ز سالار گردنکشان"
  },
  {
    "poem_id": 1781,
    "vorder": 228,
    "position": 1,
    "text": "جز از تازیانه نبودی نشان"
  },
  {
    "poem_id": 1781,
    "vorder": 229,
    "position": 0,
    "text": "چو دیدی کسی شاخ شیب دراز"
  },
  {
    "poem_id": 1781,
    "vorder": 230,
    "position": 1,
    "text": "دوان پیش رفتی و بردی نماز"
  },
  {
    "poem_id": 1781,
    "vorder": 231,
    "position": 0,
    "text": "همی بود بهرام تا گشت مست"
  },
  {
    "poem_id": 1781,
    "vorder": 232,
    "position": 1,
    "text": "چو خرم شد اندر عماری نشست"
  },
  {
    "poem_id": 1781,
    "vorder": 233,
    "position": 0,
    "text": "بیامد به مشکوی زرین خویش"
  },
  {
    "poem_id": 1781,
    "vorder": 234,
    "position": 1,
    "text": "سوی خانهٔ عنبر آگین خویش"
  },
  {
    "poem_id": 1781,
    "vorder": 235,
    "position": 0,
    "text": "چو آمد یکی هفته آنجا ببود"
  },
  {
    "poem_id": 1781,
    "vorder": 236,
    "position": 1,
    "text": "بسی خورد و بخشید و شادی نمود"
  }
]