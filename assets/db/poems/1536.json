[
  {
    "poem_id": 1536,
    "vorder": 1,
    "position": 0,
    "text": "چو از بلخ بامی به جیحون رسید"
  },
  {
    "poem_id": 1536,
    "vorder": 2,
    "position": 1,
    "text": "سپهدار لشکر فرود آورید"
  },
  {
    "poem_id": 1536,
    "vorder": 3,
    "position": 0,
    "text": "بشد شهریار از میان سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 4,
    "position": 1,
    "text": "فرود آمد از باره بر شد به گاه"
  },
  {
    "poem_id": 1536,
    "vorder": 5,
    "position": 0,
    "text": "بخواند او گرانمایه جاماسپ را"
  },
  {
    "poem_id": 1536,
    "vorder": 6,
    "position": 1,
    "text": "کجا رهنمون بود گشتاسپ را"
  },
  {
    "poem_id": 1536,
    "vorder": 7,
    "position": 0,
    "text": "سر موبدان بودو شاه ردان"
  },
  {
    "poem_id": 1536,
    "vorder": 8,
    "position": 1,
    "text": "چراغ بزرگان و اسپهبدان"
  },
  {
    "poem_id": 1536,
    "vorder": 9,
    "position": 0,
    "text": "چنان پاک تن بود و تابنده جان"
  },
  {
    "poem_id": 1536,
    "vorder": 10,
    "position": 1,
    "text": "که بودی بر او آشکارا نهان"
  },
  {
    "poem_id": 1536,
    "vorder": 11,
    "position": 0,
    "text": "ستاره‌شناس و گرانمایه بود"
  },
  {
    "poem_id": 1536,
    "vorder": 12,
    "position": 1,
    "text": "ابا او به دانش کرا پایه بود"
  },
  {
    "poem_id": 1536,
    "vorder": 13,
    "position": 0,
    "text": "بپرسید ازو شاه و گفتا خدای"
  },
  {
    "poem_id": 1536,
    "vorder": 14,
    "position": 1,
    "text": "ترا دین به داد و پاکیزه رای"
  },
  {
    "poem_id": 1536,
    "vorder": 15,
    "position": 0,
    "text": "چو تو نیست اندر جهان هیچ کس"
  },
  {
    "poem_id": 1536,
    "vorder": 16,
    "position": 1,
    "text": "جهاندار دانش ترا داد و بس"
  },
  {
    "poem_id": 1536,
    "vorder": 17,
    "position": 0,
    "text": "ببایدت کردن ز اختر شمار"
  },
  {
    "poem_id": 1536,
    "vorder": 18,
    "position": 1,
    "text": "بگویی همی مر مرا روی کار"
  },
  {
    "poem_id": 1536,
    "vorder": 19,
    "position": 0,
    "text": "که چون باشد آغاز و فرجام جنگ"
  },
  {
    "poem_id": 1536,
    "vorder": 20,
    "position": 1,
    "text": "کرا بیشتر باشد اینجا درنگ"
  },
  {
    "poem_id": 1536,
    "vorder": 21,
    "position": 0,
    "text": "نیامد خوش آن پیر جاماسپ را"
  },
  {
    "poem_id": 1536,
    "vorder": 22,
    "position": 1,
    "text": "به روی دژم گفت گشتاسپ را"
  },
  {
    "poem_id": 1536,
    "vorder": 23,
    "position": 0,
    "text": "که میخواستم کایزد دادگر"
  },
  {
    "poem_id": 1536,
    "vorder": 24,
    "position": 1,
    "text": "ندادی مرا این خرد وین هنر"
  },
  {
    "poem_id": 1536,
    "vorder": 25,
    "position": 0,
    "text": "مرا گر نبودی خرد شهریار"
  },
  {
    "poem_id": 1536,
    "vorder": 26,
    "position": 1,
    "text": "نکردی زمن بودنی خواستار"
  },
  {
    "poem_id": 1536,
    "vorder": 27,
    "position": 0,
    "text": "مگر با من از داد پیمان کند"
  },
  {
    "poem_id": 1536,
    "vorder": 28,
    "position": 1,
    "text": "که نه بد کند خود نه فرمان کند"
  },
  {
    "poem_id": 1536,
    "vorder": 29,
    "position": 0,
    "text": "جهانجوی گفتا به نام خدای"
  },
  {
    "poem_id": 1536,
    "vorder": 30,
    "position": 1,
    "text": "بدین و به دین آور پاک رای"
  },
  {
    "poem_id": 1536,
    "vorder": 31,
    "position": 0,
    "text": "به جان زریر آن نبرده سوار"
  },
  {
    "poem_id": 1536,
    "vorder": 32,
    "position": 1,
    "text": "به جان گرانمایه اسفندیار"
  },
  {
    "poem_id": 1536,
    "vorder": 33,
    "position": 0,
    "text": "که نه هرگزت روی دشمن کنم"
  },
  {
    "poem_id": 1536,
    "vorder": 34,
    "position": 1,
    "text": "نفرمایمت بد نه خود من کنم"
  },
  {
    "poem_id": 1536,
    "vorder": 35,
    "position": 0,
    "text": "تو هرچ اندرین کار دانی بگوی"
  },
  {
    "poem_id": 1536,
    "vorder": 36,
    "position": 1,
    "text": "که تو چاره‌دانی و من چاره‌جوی"
  },
  {
    "poem_id": 1536,
    "vorder": 37,
    "position": 0,
    "text": "خردمند گفت ای گرانمایه شاه"
  },
  {
    "poem_id": 1536,
    "vorder": 38,
    "position": 1,
    "text": "همیشه بتو تازه بادا کلاه"
  },
  {
    "poem_id": 1536,
    "vorder": 39,
    "position": 0,
    "text": "ز بنده میازار و بنداز خشم"
  },
  {
    "poem_id": 1536,
    "vorder": 40,
    "position": 1,
    "text": "خنک آنکسی کو نبیند به چشم"
  },
  {
    "poem_id": 1536,
    "vorder": 41,
    "position": 0,
    "text": "بدان ای نبرده کی نامجوی"
  },
  {
    "poem_id": 1536,
    "vorder": 42,
    "position": 1,
    "text": "چو در رزم روی اندر آری بروی"
  },
  {
    "poem_id": 1536,
    "vorder": 43,
    "position": 0,
    "text": "بدانگه کجا بانگ و ویله کنند"
  },
  {
    "poem_id": 1536,
    "vorder": 44,
    "position": 1,
    "text": "تو گویی همی کوه را برکنند"
  },
  {
    "poem_id": 1536,
    "vorder": 45,
    "position": 0,
    "text": "به پیش اندر آیند مردان مرد"
  },
  {
    "poem_id": 1536,
    "vorder": 46,
    "position": 1,
    "text": "هوا تیره گردد ز گرد نبرد"
  },
  {
    "poem_id": 1536,
    "vorder": 47,
    "position": 0,
    "text": "جهان را ببینی بگشته کبود"
  },
  {
    "poem_id": 1536,
    "vorder": 48,
    "position": 1,
    "text": "زمین پر ز آتش هوا پر زدود"
  },
  {
    "poem_id": 1536,
    "vorder": 49,
    "position": 0,
    "text": "وزان زخم آن گُرزهای گران"
  },
  {
    "poem_id": 1536,
    "vorder": 50,
    "position": 1,
    "text": "چنان پتک پولاد آهنگران"
  },
  {
    "poem_id": 1536,
    "vorder": 51,
    "position": 0,
    "text": "به گوش اندر آید ترنگا ترنگ"
  },
  {
    "poem_id": 1536,
    "vorder": 52,
    "position": 1,
    "text": "هوا پر شده نعرهٔ بور و خنگ"
  },
  {
    "poem_id": 1536,
    "vorder": 53,
    "position": 0,
    "text": "شکسته شود چرخ گردونها"
  },
  {
    "poem_id": 1536,
    "vorder": 54,
    "position": 1,
    "text": "زمین سرخ گردد از ان خونها"
  },
  {
    "poem_id": 1536,
    "vorder": 55,
    "position": 0,
    "text": "تو گویی هوا ابر دارد همی"
  },
  {
    "poem_id": 1536,
    "vorder": 56,
    "position": 1,
    "text": "وزان ابر الماس بارد همی"
  },
  {
    "poem_id": 1536,
    "vorder": 57,
    "position": 0,
    "text": "بسی بی پدر گشته بینی پسر"
  },
  {
    "poem_id": 1536,
    "vorder": 58,
    "position": 1,
    "text": "بسی بی پسر گشته بینی پدر"
  },
  {
    "poem_id": 1536,
    "vorder": 59,
    "position": 0,
    "text": "نخستین کس نام‌دار اردشیر"
  },
  {
    "poem_id": 1536,
    "vorder": 60,
    "position": 1,
    "text": "پس شهریار آن نبرده دلیر"
  },
  {
    "poem_id": 1536,
    "vorder": 61,
    "position": 0,
    "text": "به پیش افگند اسپ تازان خویش"
  },
  {
    "poem_id": 1536,
    "vorder": 62,
    "position": 1,
    "text": "به خاک افگند هر ک آیدش پیش"
  },
  {
    "poem_id": 1536,
    "vorder": 63,
    "position": 0,
    "text": "پیاده کند ترک چندان سوار"
  },
  {
    "poem_id": 1536,
    "vorder": 64,
    "position": 1,
    "text": "کز اختر نباشد مر آن را شمار"
  },
  {
    "poem_id": 1536,
    "vorder": 65,
    "position": 0,
    "text": "ولیکن سرانجام کشته شود"
  },
  {
    "poem_id": 1536,
    "vorder": 66,
    "position": 1,
    "text": "نکونامش اندر نوشته شود"
  },
  {
    "poem_id": 1536,
    "vorder": 67,
    "position": 0,
    "text": "دریغ آنچنان مرد نام آورا"
  },
  {
    "poem_id": 1536,
    "vorder": 68,
    "position": 1,
    "text": "ابا رادمردان همه سرورا"
  },
  {
    "poem_id": 1536,
    "vorder": 69,
    "position": 0,
    "text": "پس آزاده شیدسپ فرزند شاه"
  },
  {
    "poem_id": 1536,
    "vorder": 70,
    "position": 1,
    "text": "چو رستم درآید به روی سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 71,
    "position": 0,
    "text": "پس آنگاه مر تیغ را برکشد"
  },
  {
    "poem_id": 1536,
    "vorder": 72,
    "position": 1,
    "text": "بتازد بسی اسپ و دشمن کشد"
  },
  {
    "poem_id": 1536,
    "vorder": 73,
    "position": 0,
    "text": "بسی نامداران و گردان چین"
  },
  {
    "poem_id": 1536,
    "vorder": 74,
    "position": 1,
    "text": "که آن شیر مرد افگند بر زمین"
  },
  {
    "poem_id": 1536,
    "vorder": 75,
    "position": 0,
    "text": "سرانجام بختش کند خاکسار"
  },
  {
    "poem_id": 1536,
    "vorder": 76,
    "position": 1,
    "text": "برهنه کند آن سر تاجدار"
  },
  {
    "poem_id": 1536,
    "vorder": 77,
    "position": 0,
    "text": "بیاید پس آنگاه فرزند من"
  },
  {
    "poem_id": 1536,
    "vorder": 78,
    "position": 1,
    "text": "ببسته میان را جگر بند من"
  },
  {
    "poem_id": 1536,
    "vorder": 79,
    "position": 0,
    "text": "ابر کین شیدسپ فرزند شاه"
  },
  {
    "poem_id": 1536,
    "vorder": 80,
    "position": 1,
    "text": "به میدان کند تیز اسپ سیاه"
  },
  {
    "poem_id": 1536,
    "vorder": 81,
    "position": 0,
    "text": "بسی رنج بیند به رزم اندرون"
  },
  {
    "poem_id": 1536,
    "vorder": 82,
    "position": 1,
    "text": "شه خسروان را بگویم که چون"
  },
  {
    "poem_id": 1536,
    "vorder": 83,
    "position": 0,
    "text": "درفش فروزندهٔ کاویان"
  },
  {
    "poem_id": 1536,
    "vorder": 84,
    "position": 1,
    "text": "بیفگنده باشند ایرانیان"
  },
  {
    "poem_id": 1536,
    "vorder": 85,
    "position": 0,
    "text": "گرامی بگیرد به دندان درفش"
  },
  {
    "poem_id": 1536,
    "vorder": 86,
    "position": 1,
    "text": "به دندان بدارد درفش بنفش"
  },
  {
    "poem_id": 1536,
    "vorder": 87,
    "position": 0,
    "text": "به یک دست شمشیر و دیگر کلاه"
  },
  {
    "poem_id": 1536,
    "vorder": 88,
    "position": 1,
    "text": "به دندان درفش فریدون شاه"
  },
  {
    "poem_id": 1536,
    "vorder": 89,
    "position": 0,
    "text": "برین سان همی‌افگند دشمنان"
  },
  {
    "poem_id": 1536,
    "vorder": 90,
    "position": 1,
    "text": "همی برکند جان آهرمنان"
  },
  {
    "poem_id": 1536,
    "vorder": 91,
    "position": 0,
    "text": "سرانجام در جنگ کشته شود"
  },
  {
    "poem_id": 1536,
    "vorder": 92,
    "position": 1,
    "text": "نکو نامش اندر نوشته شود"
  },
  {
    "poem_id": 1536,
    "vorder": 93,
    "position": 0,
    "text": "پس ازاده بستور پور زریر"
  },
  {
    "poem_id": 1536,
    "vorder": 94,
    "position": 1,
    "text": "به پیش افگند اسپ چون نره شیر"
  },
  {
    "poem_id": 1536,
    "vorder": 95,
    "position": 0,
    "text": "بسی دشمنان را کند ناپدید"
  },
  {
    "poem_id": 1536,
    "vorder": 96,
    "position": 1,
    "text": "شگفتی‌تر از کار او کس ندید"
  },
  {
    "poem_id": 1536,
    "vorder": 97,
    "position": 0,
    "text": "چو آید سرانجام پیروز باز"
  },
  {
    "poem_id": 1536,
    "vorder": 98,
    "position": 1,
    "text": "ابر دشمنان دست کرده دراز"
  },
  {
    "poem_id": 1536,
    "vorder": 99,
    "position": 0,
    "text": "بیاید پس آن برگزیده سوار"
  },
  {
    "poem_id": 1536,
    "vorder": 100,
    "position": 1,
    "text": "پس شهریار جهان نامدار"
  },
  {
    "poem_id": 1536,
    "vorder": 101,
    "position": 0,
    "text": "ز آهرمنان بفگند شست گرد"
  },
  {
    "poem_id": 1536,
    "vorder": 102,
    "position": 1,
    "text": "نماید یکی پهلوی دستبرد"
  },
  {
    "poem_id": 1536,
    "vorder": 103,
    "position": 0,
    "text": "سرانجام ترکان به تیرش زنند"
  },
  {
    "poem_id": 1536,
    "vorder": 104,
    "position": 1,
    "text": "تن پیلوارش به خاک افگنند"
  },
  {
    "poem_id": 1536,
    "vorder": 105,
    "position": 0,
    "text": "بیاید پس آن نره شیر دلیر"
  },
  {
    "poem_id": 1536,
    "vorder": 106,
    "position": 1,
    "text": "سوار دلاور که نامش زریر"
  },
  {
    "poem_id": 1536,
    "vorder": 107,
    "position": 0,
    "text": "به پیش اندر آید گرفته کمند"
  },
  {
    "poem_id": 1536,
    "vorder": 108,
    "position": 1,
    "text": "نشسته بر اسفندیاری سمند"
  },
  {
    "poem_id": 1536,
    "vorder": 109,
    "position": 0,
    "text": "ابا جوشن زر درخشان چو ماه"
  },
  {
    "poem_id": 1536,
    "vorder": 110,
    "position": 1,
    "text": "بدو اندرون خیره گشته سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 111,
    "position": 0,
    "text": "بگیرد ز گردان لشکر هزار"
  },
  {
    "poem_id": 1536,
    "vorder": 112,
    "position": 1,
    "text": "ببندد فرستد بر شهریار"
  },
  {
    "poem_id": 1536,
    "vorder": 113,
    "position": 0,
    "text": "به هر سو کجا بنهد آن شاه روی"
  },
  {
    "poem_id": 1536,
    "vorder": 114,
    "position": 1,
    "text": "همی راند از خون بدخواه جوی"
  },
  {
    "poem_id": 1536,
    "vorder": 115,
    "position": 0,
    "text": "نه استد کس آن پهلوان شاه را"
  },
  {
    "poem_id": 1536,
    "vorder": 116,
    "position": 1,
    "text": "ستوه آورد شاه خرگاه را"
  },
  {
    "poem_id": 1536,
    "vorder": 117,
    "position": 0,
    "text": "پس افگنده بیند بزرگ اردشیر"
  },
  {
    "poem_id": 1536,
    "vorder": 118,
    "position": 1,
    "text": "سیه گشته رخسار و تن چون زریر"
  },
  {
    "poem_id": 1536,
    "vorder": 119,
    "position": 0,
    "text": "بگرید برو زار و گردد نژند"
  },
  {
    "poem_id": 1536,
    "vorder": 120,
    "position": 1,
    "text": "برانگیزد اسفندیاری سمند"
  },
  {
    "poem_id": 1536,
    "vorder": 121,
    "position": 0,
    "text": "به خاقان نهد روی پر خشم و تیز"
  },
  {
    "poem_id": 1536,
    "vorder": 122,
    "position": 1,
    "text": "تو گویی ندیدست هرگز گریز"
  },
  {
    "poem_id": 1536,
    "vorder": 123,
    "position": 0,
    "text": "چو اندر میان بیند ارجاسپ را"
  },
  {
    "poem_id": 1536,
    "vorder": 124,
    "position": 1,
    "text": "ستایش کند شاه گشتاسپ را"
  },
  {
    "poem_id": 1536,
    "vorder": 125,
    "position": 0,
    "text": "صف دشمنان سر بسر بردرد"
  },
  {
    "poem_id": 1536,
    "vorder": 126,
    "position": 1,
    "text": "ز گیتی سوی هیچ کس ننگرد"
  },
  {
    "poem_id": 1536,
    "vorder": 127,
    "position": 0,
    "text": "همی خواند او زند زردشت را"
  },
  {
    "poem_id": 1536,
    "vorder": 128,
    "position": 1,
    "text": "به یزدان نهاده کیی پشت را"
  },
  {
    "poem_id": 1536,
    "vorder": 129,
    "position": 0,
    "text": "سرانجام گردد برو تیره‌بخت"
  },
  {
    "poem_id": 1536,
    "vorder": 130,
    "position": 1,
    "text": "بریده کندش آن نکو تاج و تخت"
  },
  {
    "poem_id": 1536,
    "vorder": 131,
    "position": 0,
    "text": "بیاید یکی نام او بیدرفش"
  },
  {
    "poem_id": 1536,
    "vorder": 132,
    "position": 1,
    "text": "به سرنیزه دارد درفش بنفش"
  },
  {
    "poem_id": 1536,
    "vorder": 133,
    "position": 0,
    "text": "نیارد شدن پیش گرد گزین"
  },
  {
    "poem_id": 1536,
    "vorder": 134,
    "position": 1,
    "text": "نشیند به راه وی اندر کمین"
  },
  {
    "poem_id": 1536,
    "vorder": 135,
    "position": 0,
    "text": "باستد بران راه چون پیل مست"
  },
  {
    "poem_id": 1536,
    "vorder": 136,
    "position": 1,
    "text": "یکی تیغ زهر آب داده به دست"
  },
  {
    "poem_id": 1536,
    "vorder": 137,
    "position": 0,
    "text": "چو شاه جهان بازگردد ز رزم"
  },
  {
    "poem_id": 1536,
    "vorder": 138,
    "position": 1,
    "text": "گرفته جهان را و کشته گُرَزم"
  },
  {
    "poem_id": 1536,
    "vorder": 139,
    "position": 0,
    "text": "بیندازد آن ترک تیری بروی"
  },
  {
    "poem_id": 1536,
    "vorder": 140,
    "position": 1,
    "text": "نیارد شدن آشکارا بروی"
  },
  {
    "poem_id": 1536,
    "vorder": 141,
    "position": 0,
    "text": "پس از دست آن بیدرفش پلید"
  },
  {
    "poem_id": 1536,
    "vorder": 142,
    "position": 1,
    "text": "شود شاه آزادگان ناپدید"
  },
  {
    "poem_id": 1536,
    "vorder": 143,
    "position": 0,
    "text": "به ترکان برد باره و زین اوی"
  },
  {
    "poem_id": 1536,
    "vorder": 144,
    "position": 1,
    "text": "بخواهد پسرت آن زمان کین اوی"
  },
  {
    "poem_id": 1536,
    "vorder": 145,
    "position": 0,
    "text": "پس آن لشکر نامدار بزرگ"
  },
  {
    "poem_id": 1536,
    "vorder": 146,
    "position": 1,
    "text": "به دشمن درافتد چو شیر سترگ"
  },
  {
    "poem_id": 1536,
    "vorder": 147,
    "position": 0,
    "text": "همی تازند این بر آن آن برین"
  },
  {
    "poem_id": 1536,
    "vorder": 148,
    "position": 1,
    "text": "ز خون یلان سرخ گردد زمین"
  },
  {
    "poem_id": 1536,
    "vorder": 149,
    "position": 0,
    "text": "یلان را بباشد همه روی زرد"
  },
  {
    "poem_id": 1536,
    "vorder": 150,
    "position": 1,
    "text": "چو لرزه برافتد به مردان مرد"
  },
  {
    "poem_id": 1536,
    "vorder": 151,
    "position": 0,
    "text": "برآید به خورشید گرد سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 152,
    "position": 1,
    "text": "نبیند کس از گرد تاریک راه"
  },
  {
    "poem_id": 1536,
    "vorder": 153,
    "position": 0,
    "text": "فروغ سر نیزه و تیر و تیغ"
  },
  {
    "poem_id": 1536,
    "vorder": 154,
    "position": 1,
    "text": "بتابد چنان چون ستاره ز میغ"
  },
  {
    "poem_id": 1536,
    "vorder": 155,
    "position": 0,
    "text": "وزان زخم مردان کجا می‌زنند"
  },
  {
    "poem_id": 1536,
    "vorder": 156,
    "position": 1,
    "text": "و بر یکدگر بر همی افگند"
  },
  {
    "poem_id": 1536,
    "vorder": 157,
    "position": 0,
    "text": "همه خسته و کشته بر یکدگر"
  },
  {
    "poem_id": 1536,
    "vorder": 158,
    "position": 1,
    "text": "پسر بر پدر بر پدر بر پسر"
  },
  {
    "poem_id": 1536,
    "vorder": 159,
    "position": 0,
    "text": "وزان ناله و زاری خستگان"
  },
  {
    "poem_id": 1536,
    "vorder": 160,
    "position": 1,
    "text": "به بند اندر آیند نابستگان"
  },
  {
    "poem_id": 1536,
    "vorder": 161,
    "position": 0,
    "text": "شود کشته چندان ز هر سو سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 162,
    "position": 1,
    "text": "که از خونشان پر شود رزمگاه"
  },
  {
    "poem_id": 1536,
    "vorder": 163,
    "position": 0,
    "text": "پس آن بیدرفش پلید و سترگ"
  },
  {
    "poem_id": 1536,
    "vorder": 164,
    "position": 1,
    "text": "به پیش اندر آید چو ارغنده گرگ"
  },
  {
    "poem_id": 1536,
    "vorder": 165,
    "position": 0,
    "text": "همان تیغ زهر آب داده به دست"
  },
  {
    "poem_id": 1536,
    "vorder": 166,
    "position": 1,
    "text": "همی تازد او باره چون پیل مست"
  },
  {
    "poem_id": 1536,
    "vorder": 167,
    "position": 0,
    "text": "به دست وی اندر فراوان سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 168,
    "position": 1,
    "text": "تبه گردد از برگزینان شاه"
  },
  {
    "poem_id": 1536,
    "vorder": 169,
    "position": 0,
    "text": "بیاید پس آن فرخ اسفندیار"
  },
  {
    "poem_id": 1536,
    "vorder": 170,
    "position": 1,
    "text": "سپاه از پس پشت و یزدانش یار"
  },
  {
    "poem_id": 1536,
    "vorder": 171,
    "position": 0,
    "text": "ابر بیدرفش افگند اسپ تیز"
  },
  {
    "poem_id": 1536,
    "vorder": 172,
    "position": 1,
    "text": "برو جامه پر خون و دل پر ستیز"
  },
  {
    "poem_id": 1536,
    "vorder": 173,
    "position": 0,
    "text": "مر او را یکی تیغ هندی زند"
  },
  {
    "poem_id": 1536,
    "vorder": 174,
    "position": 1,
    "text": "ز بر نیمهٔ تنش زیر افگند"
  },
  {
    "poem_id": 1536,
    "vorder": 175,
    "position": 0,
    "text": "بگیرد پس آن آهنین گُرز را"
  },
  {
    "poem_id": 1536,
    "vorder": 176,
    "position": 1,
    "text": "بتاباند آن فره و برز را"
  },
  {
    "poem_id": 1536,
    "vorder": 177,
    "position": 0,
    "text": "به یک حمله از جایشان بگسلد"
  },
  {
    "poem_id": 1536,
    "vorder": 178,
    "position": 1,
    "text": "چو بگسستشان بر زمین کی هلد"
  },
  {
    "poem_id": 1536,
    "vorder": 179,
    "position": 0,
    "text": "بنوک سر نیزه‌شان بر چند"
  },
  {
    "poem_id": 1536,
    "vorder": 180,
    "position": 1,
    "text": "کندشان تبه پاک و بپراگند"
  },
  {
    "poem_id": 1536,
    "vorder": 181,
    "position": 0,
    "text": "گریزد سرانجام سالار چین"
  },
  {
    "poem_id": 1536,
    "vorder": 182,
    "position": 1,
    "text": "از اسفندیار آن گو بافرین"
  },
  {
    "poem_id": 1536,
    "vorder": 183,
    "position": 0,
    "text": "به ترکان نهد روی بگریخته"
  },
  {
    "poem_id": 1536,
    "vorder": 184,
    "position": 1,
    "text": "شکسته سپر نیزها ریخته"
  },
  {
    "poem_id": 1536,
    "vorder": 185,
    "position": 0,
    "text": "بیابان گذارد به اندک سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 186,
    "position": 1,
    "text": "شود شاه پیروز و دشمن تباه"
  },
  {
    "poem_id": 1536,
    "vorder": 187,
    "position": 0,
    "text": "بدان ای گزیده شه خسروان"
  },
  {
    "poem_id": 1536,
    "vorder": 188,
    "position": 1,
    "text": "که من هرچ گفتم نباشد جز آن"
  },
  {
    "poem_id": 1536,
    "vorder": 189,
    "position": 0,
    "text": "نباشد ازین یک سخن بیش و کم"
  },
  {
    "poem_id": 1536,
    "vorder": 190,
    "position": 1,
    "text": "تو زین پس مکن روی بر من دژم"
  },
  {
    "poem_id": 1536,
    "vorder": 191,
    "position": 0,
    "text": "که من آنچ گفتم نگفتم مگر"
  },
  {
    "poem_id": 1536,
    "vorder": 192,
    "position": 1,
    "text": "به فرمانت ای شاه پیروزگر"
  },
  {
    "poem_id": 1536,
    "vorder": 193,
    "position": 0,
    "text": "وزان کم بپرسید فرخنده شاه"
  },
  {
    "poem_id": 1536,
    "vorder": 194,
    "position": 1,
    "text": "ازین ژرف دریا و تاریک راه"
  },
  {
    "poem_id": 1536,
    "vorder": 195,
    "position": 0,
    "text": "ندیدم که بر شاه بنهفتمی"
  },
  {
    "poem_id": 1536,
    "vorder": 196,
    "position": 1,
    "text": "وگرنه من این راز کی گفتمی"
  },
  {
    "poem_id": 1536,
    "vorder": 197,
    "position": 0,
    "text": "چو شاه جهاندار بشنید راز"
  },
  {
    "poem_id": 1536,
    "vorder": 198,
    "position": 1,
    "text": "بران گوشهٔ تخت خسپید باز"
  },
  {
    "poem_id": 1536,
    "vorder": 199,
    "position": 0,
    "text": "ز دستش بیفتاد زرینه گُرز"
  },
  {
    "poem_id": 1536,
    "vorder": 200,
    "position": 1,
    "text": "تو گفتی برفتش همی فر و برز"
  },
  {
    "poem_id": 1536,
    "vorder": 201,
    "position": 0,
    "text": "به روی اندر افتاد و بیهوش گشت"
  },
  {
    "poem_id": 1536,
    "vorder": 202,
    "position": 1,
    "text": "نگفتش سخن نیز و خاموش گشت"
  },
  {
    "poem_id": 1536,
    "vorder": 203,
    "position": 0,
    "text": "چو با هوش آمد جهان شهریار"
  },
  {
    "poem_id": 1536,
    "vorder": 204,
    "position": 1,
    "text": "فرود آمد از تخت و بگریست زار"
  },
  {
    "poem_id": 1536,
    "vorder": 205,
    "position": 0,
    "text": "چه باید مرا گفت شاهی و گاه"
  },
  {
    "poem_id": 1536,
    "vorder": 206,
    "position": 1,
    "text": "که روزم همی گشت خواهد سیاه"
  },
  {
    "poem_id": 1536,
    "vorder": 207,
    "position": 0,
    "text": "که آنان که بر من گرامی‌ترند"
  },
  {
    "poem_id": 1536,
    "vorder": 208,
    "position": 1,
    "text": "گزین سپاهند و نامی‌ترند"
  },
  {
    "poem_id": 1536,
    "vorder": 209,
    "position": 0,
    "text": "همی رفت و خواهند از پیش من"
  },
  {
    "poem_id": 1536,
    "vorder": 210,
    "position": 1,
    "text": "ز تن برکنند این دل ریش من"
  },
  {
    "poem_id": 1536,
    "vorder": 211,
    "position": 0,
    "text": "به جاماسپ گفت ار چنینست کار"
  },
  {
    "poem_id": 1536,
    "vorder": 212,
    "position": 1,
    "text": "به هنگام رفتن سوی کارزار"
  },
  {
    "poem_id": 1536,
    "vorder": 213,
    "position": 0,
    "text": "نخوانم نبرده برادرم را"
  },
  {
    "poem_id": 1536,
    "vorder": 214,
    "position": 1,
    "text": "نسوزم دل پیر مادرم را"
  },
  {
    "poem_id": 1536,
    "vorder": 215,
    "position": 0,
    "text": "نفرمایمش نیز رفتن به رزم"
  },
  {
    "poem_id": 1536,
    "vorder": 216,
    "position": 1,
    "text": "سپه را سپارم به فرخ گُرَزم"
  },
  {
    "poem_id": 1536,
    "vorder": 217,
    "position": 0,
    "text": "کیان زادگان و جوانان من"
  },
  {
    "poem_id": 1536,
    "vorder": 218,
    "position": 1,
    "text": "که هر یک چنانند چون جان من"
  },
  {
    "poem_id": 1536,
    "vorder": 219,
    "position": 0,
    "text": "بخوانم همه سربسر پیش خویش"
  },
  {
    "poem_id": 1536,
    "vorder": 220,
    "position": 1,
    "text": "زره‌شان نپوشم نشانم به پیش"
  },
  {
    "poem_id": 1536,
    "vorder": 221,
    "position": 0,
    "text": "چگونه رسد نوک تیر خدنگ"
  },
  {
    "poem_id": 1536,
    "vorder": 222,
    "position": 1,
    "text": "برین آسمان بر شده کوه سنگ"
  },
  {
    "poem_id": 1536,
    "vorder": 223,
    "position": 0,
    "text": "خردمند گفتا به شاه زمین"
  },
  {
    "poem_id": 1536,
    "vorder": 224,
    "position": 1,
    "text": "که ای نیک‌خو مهتر بافرین"
  },
  {
    "poem_id": 1536,
    "vorder": 225,
    "position": 0,
    "text": "گر ایشان نباشند پیش سپاه"
  },
  {
    "poem_id": 1536,
    "vorder": 226,
    "position": 1,
    "text": "نهاده بسر بر کیانی کلاه"
  },
  {
    "poem_id": 1536,
    "vorder": 227,
    "position": 0,
    "text": "که یارد شدن پیش ترکان چین"
  },
  {
    "poem_id": 1536,
    "vorder": 228,
    "position": 1,
    "text": "که بازآورد فره پاک دین"
  },
  {
    "poem_id": 1536,
    "vorder": 229,
    "position": 0,
    "text": "تو زین خاک برخیز و برشو به گاه"
  },
  {
    "poem_id": 1536,
    "vorder": 230,
    "position": 1,
    "text": "مکن فره پادشاهی تباه"
  },
  {
    "poem_id": 1536,
    "vorder": 231,
    "position": 0,
    "text": "که داد خدایست وزین چاره نیست"
  },
  {
    "poem_id": 1536,
    "vorder": 232,
    "position": 1,
    "text": "خداوند گیتی ستمگاره نیست"
  },
  {
    "poem_id": 1536,
    "vorder": 233,
    "position": 0,
    "text": "ز اندوه خوردن نباشدت سود"
  },
  {
    "poem_id": 1536,
    "vorder": 234,
    "position": 1,
    "text": "کجا بودنی بود و شد کار بود"
  },
  {
    "poem_id": 1536,
    "vorder": 235,
    "position": 0,
    "text": "مکن دلت را بیشتر زین نژند"
  },
  {
    "poem_id": 1536,
    "vorder": 236,
    "position": 1,
    "text": "بداد خدای جهان کن بسند"
  },
  {
    "poem_id": 1536,
    "vorder": 237,
    "position": 0,
    "text": "بدادش بسی پند و بشنید شاه"
  },
  {
    "poem_id": 1536,
    "vorder": 238,
    "position": 1,
    "text": "چو خورشید گون گشت بر شد به گاه"
  },
  {
    "poem_id": 1536,
    "vorder": 239,
    "position": 0,
    "text": "نشست از برگاه و بنهاد دل"
  },
  {
    "poem_id": 1536,
    "vorder": 240,
    "position": 1,
    "text": "به رزم جهانجوی شاه چگل"
  },
  {
    "poem_id": 1536,
    "vorder": 241,
    "position": 0,
    "text": "از اندیشهٔ دل نیامدش خواب"
  },
  {
    "poem_id": 1536,
    "vorder": 242,
    "position": 1,
    "text": "به رزم و به بزمش گرفته شتاب"
  }
]