[
  {
    "poem_id": 1570,
    "vorder": 1,
    "position": 0,
    "text": "شب آمد یکی آتشی برفروخت"
  },
  {
    "poem_id": 1570,
    "vorder": 2,
    "position": 1,
    "text": "که تفش همی آسمان را بسوخت"
  },
  {
    "poem_id": 1570,
    "vorder": 3,
    "position": 0,
    "text": "چو از دیده‌گه دیده‌بان بنگرید"
  },
  {
    "poem_id": 1570,
    "vorder": 4,
    "position": 1,
    "text": "به شب آتش و روز پردود دید"
  },
  {
    "poem_id": 1570,
    "vorder": 5,
    "position": 0,
    "text": "ز جایی که بد شادمان بازگشت"
  },
  {
    "poem_id": 1570,
    "vorder": 6,
    "position": 1,
    "text": "تو گفتی که با باد همباز گشت"
  },
  {
    "poem_id": 1570,
    "vorder": 7,
    "position": 0,
    "text": "چو از راه نزد پشوتن رسید"
  },
  {
    "poem_id": 1570,
    "vorder": 8,
    "position": 1,
    "text": "بگفت آنچ از آتش و دود دید"
  },
  {
    "poem_id": 1570,
    "vorder": 9,
    "position": 0,
    "text": "پشوتن چنین گفت کز پیل و شیر"
  },
  {
    "poem_id": 1570,
    "vorder": 10,
    "position": 1,
    "text": "به تنبل فزونست مرد دلیر"
  },
  {
    "poem_id": 1570,
    "vorder": 11,
    "position": 0,
    "text": "که چشم بدان از تنش دور باد"
  },
  {
    "poem_id": 1570,
    "vorder": 12,
    "position": 1,
    "text": "همه روزگاران او سور باد"
  },
  {
    "poem_id": 1570,
    "vorder": 13,
    "position": 0,
    "text": "بزد نای رویین و رویینه خم"
  },
  {
    "poem_id": 1570,
    "vorder": 14,
    "position": 1,
    "text": "برآمد ز در نالهٔ گاودم"
  },
  {
    "poem_id": 1570,
    "vorder": 15,
    "position": 0,
    "text": "ز هامون سوی دژ بیامد سپاه"
  },
  {
    "poem_id": 1570,
    "vorder": 16,
    "position": 1,
    "text": "شد از گرد خورشید تابان سیاه"
  },
  {
    "poem_id": 1570,
    "vorder": 17,
    "position": 0,
    "text": "همه زیر خفتان و خود اندرون"
  },
  {
    "poem_id": 1570,
    "vorder": 18,
    "position": 1,
    "text": "همی از جگرشان بجوشید خون"
  },
  {
    "poem_id": 1570,
    "vorder": 19,
    "position": 0,
    "text": "به دژ چون خبر شد که آمد سپاه"
  },
  {
    "poem_id": 1570,
    "vorder": 20,
    "position": 1,
    "text": "جهان نیست پیدا ز گرد سیاه"
  },
  {
    "poem_id": 1570,
    "vorder": 21,
    "position": 0,
    "text": "همه دژ پر از نام اسفندیار"
  },
  {
    "poem_id": 1570,
    "vorder": 22,
    "position": 1,
    "text": "درخت بلا حنظل آورد بار"
  },
  {
    "poem_id": 1570,
    "vorder": 23,
    "position": 0,
    "text": "بپوشید ارجاسپ خفتان جنگ"
  },
  {
    "poem_id": 1570,
    "vorder": 24,
    "position": 1,
    "text": "بمالید بر چنگ بسیار چنگ"
  },
  {
    "poem_id": 1570,
    "vorder": 25,
    "position": 0,
    "text": "بفرمود تا کهرم شیرگیر"
  },
  {
    "poem_id": 1570,
    "vorder": 26,
    "position": 1,
    "text": "برد لشکر و کوس و شمشیر وتیر"
  },
  {
    "poem_id": 1570,
    "vorder": 27,
    "position": 0,
    "text": "به طرخان چنین گفت کای سرفراز"
  },
  {
    "poem_id": 1570,
    "vorder": 28,
    "position": 1,
    "text": "برو تیز با لشکری رزمساز"
  },
  {
    "poem_id": 1570,
    "vorder": 29,
    "position": 0,
    "text": "ببر نامدران دژ ده هزار"
  },
  {
    "poem_id": 1570,
    "vorder": 30,
    "position": 1,
    "text": "همه رزم جویان خنجرگزار"
  },
  {
    "poem_id": 1570,
    "vorder": 31,
    "position": 0,
    "text": "نگه کن که این جنگجویان کیند"
  },
  {
    "poem_id": 1570,
    "vorder": 32,
    "position": 1,
    "text": "وزین تاختن ساختن برچیند"
  },
  {
    "poem_id": 1570,
    "vorder": 33,
    "position": 0,
    "text": "سرافراز طرخان بیامد دوان"
  },
  {
    "poem_id": 1570,
    "vorder": 34,
    "position": 1,
    "text": "بدین روی دژ با یکی ترجمان"
  },
  {
    "poem_id": 1570,
    "vorder": 35,
    "position": 0,
    "text": "سپه دید با جوشن و ساز جنگ"
  },
  {
    "poem_id": 1570,
    "vorder": 36,
    "position": 1,
    "text": "درفشی سیه پیکر او پلنگ"
  },
  {
    "poem_id": 1570,
    "vorder": 37,
    "position": 0,
    "text": "سپه‌کش پشوتن به قلب اندرون"
  },
  {
    "poem_id": 1570,
    "vorder": 38,
    "position": 1,
    "text": "سپاهی همه دست شسته به خون"
  },
  {
    "poem_id": 1570,
    "vorder": 39,
    "position": 0,
    "text": "به چنگ اندرون گرز اسفندیار"
  },
  {
    "poem_id": 1570,
    "vorder": 40,
    "position": 1,
    "text": "به زیر اندرون بارهٔ نامدار"
  },
  {
    "poem_id": 1570,
    "vorder": 41,
    "position": 0,
    "text": "جز اسفندیار تهم را نماند"
  },
  {
    "poem_id": 1570,
    "vorder": 42,
    "position": 1,
    "text": "کس او را به جز شاه ایران نخواند"
  },
  {
    "poem_id": 1570,
    "vorder": 43,
    "position": 0,
    "text": "سپه میسره میمنه برکشید"
  },
  {
    "poem_id": 1570,
    "vorder": 44,
    "position": 1,
    "text": "چنان شد که کس روز روشن ندید"
  },
  {
    "poem_id": 1570,
    "vorder": 45,
    "position": 0,
    "text": "ز زخم سنانهای الماس گون"
  },
  {
    "poem_id": 1570,
    "vorder": 46,
    "position": 1,
    "text": "تو گفتی همی بارد از ابر خون"
  },
  {
    "poem_id": 1570,
    "vorder": 47,
    "position": 0,
    "text": "به جنگ اندر آمد سپاه از دو روی"
  },
  {
    "poem_id": 1570,
    "vorder": 48,
    "position": 1,
    "text": "هرانکس که بد گرد و پرخاشجوی"
  },
  {
    "poem_id": 1570,
    "vorder": 49,
    "position": 0,
    "text": "بشد پیش نوش‌آذر تیغ‌زن"
  },
  {
    "poem_id": 1570,
    "vorder": 50,
    "position": 1,
    "text": "همی جست پرخاش زان انجمن"
  },
  {
    "poem_id": 1570,
    "vorder": 51,
    "position": 0,
    "text": "بیامد سرافراز طرخان برش"
  },
  {
    "poem_id": 1570,
    "vorder": 52,
    "position": 1,
    "text": "که از تن به خاک اندر آرد سرش"
  },
  {
    "poem_id": 1570,
    "vorder": 53,
    "position": 0,
    "text": "چو نوش‌آذر او را به هامون بدید"
  },
  {
    "poem_id": 1570,
    "vorder": 54,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 1570,
    "vorder": 55,
    "position": 0,
    "text": "کمرگاه طرخان بدو نیم کرد"
  },
  {
    "poem_id": 1570,
    "vorder": 56,
    "position": 1,
    "text": "دل کهرم از درد پربیم کرد"
  },
  {
    "poem_id": 1570,
    "vorder": 57,
    "position": 0,
    "text": "چنان هم بقلب سپه حمله برد"
  },
  {
    "poem_id": 1570,
    "vorder": 58,
    "position": 1,
    "text": "بزرگش یکی بود با مرد خرد"
  },
  {
    "poem_id": 1570,
    "vorder": 59,
    "position": 0,
    "text": "بران‌سان دو لشکر بهم برشکست"
  },
  {
    "poem_id": 1570,
    "vorder": 60,
    "position": 1,
    "text": "که از تیر بر سرکشان ابر بست"
  },
  {
    "poem_id": 1570,
    "vorder": 61,
    "position": 0,
    "text": "سرافراز کهرم سوی دژ برفت"
  },
  {
    "poem_id": 1570,
    "vorder": 62,
    "position": 1,
    "text": "گریزان و لشکر همی راند تفت"
  },
  {
    "poem_id": 1570,
    "vorder": 63,
    "position": 0,
    "text": "چنین گفت کهرم به پیش پدر"
  },
  {
    "poem_id": 1570,
    "vorder": 64,
    "position": 1,
    "text": "که ای نامور شاه خورشیدفر"
  },
  {
    "poem_id": 1570,
    "vorder": 65,
    "position": 0,
    "text": "از ایران سپاهی بیامد بزرگ"
  },
  {
    "poem_id": 1570,
    "vorder": 66,
    "position": 1,
    "text": "به پیش اندرون نامداری سترگ"
  },
  {
    "poem_id": 1570,
    "vorder": 67,
    "position": 0,
    "text": "سرافراز اسفندیارست و بس"
  },
  {
    "poem_id": 1570,
    "vorder": 68,
    "position": 1,
    "text": "بدین دژ نیاید جزو هیچ‌کس"
  },
  {
    "poem_id": 1570,
    "vorder": 69,
    "position": 0,
    "text": "همان نیزهٔ جنگ دارد به چنگ"
  },
  {
    "poem_id": 1570,
    "vorder": 70,
    "position": 1,
    "text": "که در گنبدان دژ تو دیدی به جنگ"
  },
  {
    "poem_id": 1570,
    "vorder": 71,
    "position": 0,
    "text": "غمی شد دل ارجاسپ را زان سخن"
  },
  {
    "poem_id": 1570,
    "vorder": 72,
    "position": 1,
    "text": "که نو شد دگر باره کین کهن"
  },
  {
    "poem_id": 1570,
    "vorder": 73,
    "position": 0,
    "text": "به ترکان همه گفت بیرون شوید"
  },
  {
    "poem_id": 1570,
    "vorder": 74,
    "position": 1,
    "text": "ز دژ یکسره سوی هامون شوید"
  },
  {
    "poem_id": 1570,
    "vorder": 75,
    "position": 0,
    "text": "همه لشکر اندر میان آورید"
  },
  {
    "poem_id": 1570,
    "vorder": 76,
    "position": 1,
    "text": "خروش هژبر ژیان آورید"
  },
  {
    "poem_id": 1570,
    "vorder": 77,
    "position": 0,
    "text": "یکی زنده زیشان ممانید نیز"
  },
  {
    "poem_id": 1570,
    "vorder": 78,
    "position": 1,
    "text": "کسی نام ایشان مخوانید نیز"
  },
  {
    "poem_id": 1570,
    "vorder": 79,
    "position": 0,
    "text": "همه لشکر از دژ به راه آمدند"
  },
  {
    "poem_id": 1570,
    "vorder": 80,
    "position": 1,
    "text": "جگر خسته و کینه‌خواه آمدند"
  }
]