[
  {
    "poem_id": 1728,
    "vorder": 1,
    "position": 0,
    "text": "برو نیز بگذشت سال دراز"
  },
  {
    "poem_id": 1728,
    "vorder": 2,
    "position": 1,
    "text": "سر تاجور اندر آمد به گاز"
  },
  {
    "poem_id": 1728,
    "vorder": 3,
    "position": 0,
    "text": "یکی پور بودش دلارام بود"
  },
  {
    "poem_id": 1728,
    "vorder": 4,
    "position": 1,
    "text": "ورا نام بهرام بهرام بود"
  },
  {
    "poem_id": 1728,
    "vorder": 5,
    "position": 0,
    "text": "بیاورد و بنشاندش زیر تخت"
  },
  {
    "poem_id": 1728,
    "vorder": 6,
    "position": 1,
    "text": "بدو گفت کای سبز شاخ درخت"
  },
  {
    "poem_id": 1728,
    "vorder": 7,
    "position": 0,
    "text": "نبودم فراوان من از تخت شاد"
  },
  {
    "poem_id": 1728,
    "vorder": 8,
    "position": 1,
    "text": "همه روزگار تو فرخنده باد"
  },
  {
    "poem_id": 1728,
    "vorder": 9,
    "position": 0,
    "text": "سراینده باش و فزاینده باش"
  },
  {
    "poem_id": 1728,
    "vorder": 10,
    "position": 1,
    "text": "شب و روز بارامش و خنده باش"
  },
  {
    "poem_id": 1728,
    "vorder": 11,
    "position": 0,
    "text": "چنان رو که پرسند روز شمار"
  },
  {
    "poem_id": 1728,
    "vorder": 12,
    "position": 1,
    "text": "نپیچی سر از شرم پروردگار"
  },
  {
    "poem_id": 1728,
    "vorder": 13,
    "position": 0,
    "text": "به داد و دهش گیتی آباد دار"
  },
  {
    "poem_id": 1728,
    "vorder": 14,
    "position": 1,
    "text": "دل زیردستان خود شاد دار"
  },
  {
    "poem_id": 1728,
    "vorder": 15,
    "position": 0,
    "text": "که برکس نماند جهان جاودان"
  },
  {
    "poem_id": 1728,
    "vorder": 16,
    "position": 1,
    "text": "نه بر تاجدار و نه بر موبدان"
  },
  {
    "poem_id": 1728,
    "vorder": 17,
    "position": 0,
    "text": "تو از چرخ گردان مدان این ستم"
  },
  {
    "poem_id": 1728,
    "vorder": 18,
    "position": 1,
    "text": "چو از باد چندی گذاری به دم"
  },
  {
    "poem_id": 1728,
    "vorder": 19,
    "position": 0,
    "text": "به سه سال و سه ماه و بر سر سه روز"
  },
  {
    "poem_id": 1728,
    "vorder": 20,
    "position": 1,
    "text": "تهی ماند زو تخت گیتی فروز"
  },
  {
    "poem_id": 1728,
    "vorder": 21,
    "position": 0,
    "text": "چو بهرام گیتی به بهرام داد"
  },
  {
    "poem_id": 1728,
    "vorder": 22,
    "position": 1,
    "text": "پسر مر ورا دخمه آرام داد"
  },
  {
    "poem_id": 1728,
    "vorder": 23,
    "position": 0,
    "text": "چنین بود تا بود چرخ بلند"
  },
  {
    "poem_id": 1728,
    "vorder": 24,
    "position": 1,
    "text": "به انده چه داری دلت را نژند"
  },
  {
    "poem_id": 1728,
    "vorder": 25,
    "position": 0,
    "text": "چه گویی چه جویی چه شاید بدن"
  },
  {
    "poem_id": 1728,
    "vorder": 26,
    "position": 1,
    "text": "برین داستانی نشاید زدن"
  },
  {
    "poem_id": 1728,
    "vorder": 27,
    "position": 0,
    "text": "روانت گر از آز فرتوت نیست"
  },
  {
    "poem_id": 1728,
    "vorder": 28,
    "position": 1,
    "text": "نشست تو جز تنگ تابوت نیست"
  },
  {
    "poem_id": 1728,
    "vorder": 29,
    "position": 0,
    "text": "اگر مرگ دارد چنین طبع گرگ"
  },
  {
    "poem_id": 1728,
    "vorder": 30,
    "position": 1,
    "text": "پر از می یکی جام خواهم بزرگ"
  }
]