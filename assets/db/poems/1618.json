[
  {
    "poem_id": 1618,
    "vorder": 1,
    "position": 0,
    "text": "پسر بد مر او را یکی همچو شیر"
  },
  {
    "poem_id": 1618,
    "vorder": 2,
    "position": 1,
    "text": "که ساسان همی خواندی اردشیر"
  },
  {
    "poem_id": 1618,
    "vorder": 3,
    "position": 0,
    "text": "دگر دختری داشت نامش همای"
  },
  {
    "poem_id": 1618,
    "vorder": 4,
    "position": 1,
    "text": "هنرمند و بادانش و نیک‌رای"
  },
  {
    "poem_id": 1618,
    "vorder": 5,
    "position": 0,
    "text": "همی خواندندی ورا چهرزاد"
  },
  {
    "poem_id": 1618,
    "vorder": 6,
    "position": 1,
    "text": "ز گیتی به دیدار او بود شاد"
  },
  {
    "poem_id": 1618,
    "vorder": 7,
    "position": 0,
    "text": "پدر درپذیرفتش از نیکوی"
  },
  {
    "poem_id": 1618,
    "vorder": 8,
    "position": 1,
    "text": "بران دین که خوانی همی پهلوی"
  },
  {
    "poem_id": 1618,
    "vorder": 9,
    "position": 0,
    "text": "همای دل‌افروز تابنده ماه"
  },
  {
    "poem_id": 1618,
    "vorder": 10,
    "position": 1,
    "text": "چنان بد که آبستن آمد ز شاه"
  },
  {
    "poem_id": 1618,
    "vorder": 11,
    "position": 0,
    "text": "چو شش ماه شد پر ز تیمار شد"
  },
  {
    "poem_id": 1618,
    "vorder": 12,
    "position": 1,
    "text": "چو بهمن چنان دید بیمار شد"
  },
  {
    "poem_id": 1618,
    "vorder": 13,
    "position": 0,
    "text": "چو از درد شاه اندرآمد ز پای"
  },
  {
    "poem_id": 1618,
    "vorder": 14,
    "position": 1,
    "text": "بفرمود تا پیش او شد همای"
  },
  {
    "poem_id": 1618,
    "vorder": 15,
    "position": 0,
    "text": "بزرگان و نیک‌اختران را بخواند"
  },
  {
    "poem_id": 1618,
    "vorder": 16,
    "position": 1,
    "text": "به تخت گرانمایگان بر نشاند"
  },
  {
    "poem_id": 1618,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت کاین پاک‌تن چهرزاد"
  },
  {
    "poem_id": 1618,
    "vorder": 18,
    "position": 1,
    "text": "به گیتی فراوان نبودست شاد"
  },
  {
    "poem_id": 1618,
    "vorder": 19,
    "position": 0,
    "text": "سپردم بدو تاج و تخت بلند"
  },
  {
    "poem_id": 1618,
    "vorder": 20,
    "position": 1,
    "text": "همان لشکر و گنج با ارجمند"
  },
  {
    "poem_id": 1618,
    "vorder": 21,
    "position": 0,
    "text": "ولی عهد من او بود در جهان"
  },
  {
    "poem_id": 1618,
    "vorder": 22,
    "position": 1,
    "text": "هم‌انکس کزو زاید اندر نهان"
  },
  {
    "poem_id": 1618,
    "vorder": 23,
    "position": 0,
    "text": "اگر دختر آید برش گر پسر"
  },
  {
    "poem_id": 1618,
    "vorder": 24,
    "position": 1,
    "text": "ورا باشد این تاج و تخت پدر"
  },
  {
    "poem_id": 1618,
    "vorder": 25,
    "position": 0,
    "text": "چو ساسان شنید این سخن خیره شد"
  },
  {
    "poem_id": 1618,
    "vorder": 26,
    "position": 1,
    "text": "ز گفتار بهمن دلش تیره شد"
  },
  {
    "poem_id": 1618,
    "vorder": 27,
    "position": 0,
    "text": "بدو روز و دو شب بسان پلنگ"
  },
  {
    "poem_id": 1618,
    "vorder": 28,
    "position": 1,
    "text": "ز ایران به مرزی دگر شد ز ننگ"
  },
  {
    "poem_id": 1618,
    "vorder": 29,
    "position": 0,
    "text": "دمان سوی شهر نشاپور شد"
  },
  {
    "poem_id": 1618,
    "vorder": 30,
    "position": 1,
    "text": "پر آزار بد از پدر دور شد"
  },
  {
    "poem_id": 1618,
    "vorder": 31,
    "position": 0,
    "text": "زنی را ز تخم بزرگان بخواست"
  },
  {
    "poem_id": 1618,
    "vorder": 32,
    "position": 1,
    "text": "بپرورد و با جان و دل داشت راست"
  },
  {
    "poem_id": 1618,
    "vorder": 33,
    "position": 0,
    "text": "نژادش به گیتی کسی را نگفت"
  },
  {
    "poem_id": 1618,
    "vorder": 34,
    "position": 1,
    "text": "همی داشت آن راستی در نهفت"
  },
  {
    "poem_id": 1618,
    "vorder": 35,
    "position": 0,
    "text": "زن پاک‌تن خوب فرزند زاد"
  },
  {
    "poem_id": 1618,
    "vorder": 36,
    "position": 1,
    "text": "ز ساسان پرمایه بهمن نژاد"
  },
  {
    "poem_id": 1618,
    "vorder": 37,
    "position": 0,
    "text": "پدر نام ساسانش کرد آن زمان"
  },
  {
    "poem_id": 1618,
    "vorder": 38,
    "position": 1,
    "text": "مر او را به زودی سرآمد زمان"
  },
  {
    "poem_id": 1618,
    "vorder": 39,
    "position": 0,
    "text": "چو کودک ز خردی به مردی رسید"
  },
  {
    "poem_id": 1618,
    "vorder": 40,
    "position": 1,
    "text": "دران خانه جز بینوایی ندید"
  },
  {
    "poem_id": 1618,
    "vorder": 41,
    "position": 0,
    "text": "ز شاه نشاپور بستد گله"
  },
  {
    "poem_id": 1618,
    "vorder": 42,
    "position": 1,
    "text": "که بودی به کوه و به هامون یله"
  },
  {
    "poem_id": 1618,
    "vorder": 43,
    "position": 0,
    "text": "همی بود یکچند چوپان شاه"
  },
  {
    "poem_id": 1618,
    "vorder": 44,
    "position": 1,
    "text": "به کوه و بیابان و آرامگاه"
  },
  {
    "poem_id": 1618,
    "vorder": 45,
    "position": 0,
    "text": "کنون بازگردم به کار همای"
  },
  {
    "poem_id": 1618,
    "vorder": 46,
    "position": 1,
    "text": "پس از مرگ بهمن که بگرفت جای"
  }
]