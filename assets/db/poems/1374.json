[
  {
    "poem_id": 1374,
    "vorder": 1,
    "position": 0,
    "text": "چو از روز رخشنده نیمی برفت"
  },
  {
    "poem_id": 1374,
    "vorder": 2,
    "position": 1,
    "text": "دل هر دو جنگی ز کینه بتفت"
  },
  {
    "poem_id": 1374,
    "vorder": 3,
    "position": 0,
    "text": "به تدبیر یک با دگر ساختند"
  },
  {
    "poem_id": 1374,
    "vorder": 4,
    "position": 1,
    "text": "همه رای بیهوده انداختند"
  },
  {
    "poem_id": 1374,
    "vorder": 5,
    "position": 0,
    "text": "که چون شب شود ما شبیخون کنیم"
  },
  {
    "poem_id": 1374,
    "vorder": 6,
    "position": 1,
    "text": "همه دشت و هامون پر از خون کنیم"
  },
  {
    "poem_id": 1374,
    "vorder": 7,
    "position": 0,
    "text": "چو کارآگهان آگهی یافتند"
  },
  {
    "poem_id": 1374,
    "vorder": 8,
    "position": 1,
    "text": "دوان زی منوچهر بشتافتند"
  },
  {
    "poem_id": 1374,
    "vorder": 9,
    "position": 0,
    "text": "رسیدند پیش منوچهر شاه"
  },
  {
    "poem_id": 1374,
    "vorder": 10,
    "position": 1,
    "text": "بگفتند تا برنشاند سپاه"
  },
  {
    "poem_id": 1374,
    "vorder": 11,
    "position": 0,
    "text": "منوچهر بشنید و بگشاد گوش"
  },
  {
    "poem_id": 1374,
    "vorder": 12,
    "position": 1,
    "text": "سوی چاره شد مرد بسیار هوش"
  },
  {
    "poem_id": 1374,
    "vorder": 13,
    "position": 0,
    "text": "سپه را سراسر به قارن سپرد"
  },
  {
    "poem_id": 1374,
    "vorder": 14,
    "position": 1,
    "text": "کمین‌گاه بگزید سالار گرد"
  },
  {
    "poem_id": 1374,
    "vorder": 15,
    "position": 0,
    "text": "ببرد از سران نامور سی‌هزار"
  },
  {
    "poem_id": 1374,
    "vorder": 16,
    "position": 1,
    "text": "دلیران و گردان خنجر‌گزار"
  },
  {
    "poem_id": 1374,
    "vorder": 17,
    "position": 0,
    "text": "کمین‌گاه را جای شایسته دید"
  },
  {
    "poem_id": 1374,
    "vorder": 18,
    "position": 1,
    "text": "سواران جنگی و بایسته دید"
  },
  {
    "poem_id": 1374,
    "vorder": 19,
    "position": 0,
    "text": "چو شب تیره شد تور با صدهزار"
  },
  {
    "poem_id": 1374,
    "vorder": 20,
    "position": 1,
    "text": "بیامد کمربستهٔ کارزار"
  },
  {
    "poem_id": 1374,
    "vorder": 21,
    "position": 0,
    "text": "شبیخون سگالیده و ساخته"
  },
  {
    "poem_id": 1374,
    "vorder": 22,
    "position": 1,
    "text": "بپیوسته تیر و کمان آخته"
  },
  {
    "poem_id": 1374,
    "vorder": 23,
    "position": 0,
    "text": "چو آمد سپه دید بر جای خویش"
  },
  {
    "poem_id": 1374,
    "vorder": 24,
    "position": 1,
    "text": "درفش فروزنده بر پای پیش"
  },
  {
    "poem_id": 1374,
    "vorder": 25,
    "position": 0,
    "text": "جز از جنگ و پیکار چاره ندید"
  },
  {
    "poem_id": 1374,
    "vorder": 26,
    "position": 1,
    "text": "خروش از میان سپه بر کشید"
  },
  {
    "poem_id": 1374,
    "vorder": 27,
    "position": 0,
    "text": "ز گَرد‌ِ سواران هوا بست میغ"
  },
  {
    "poem_id": 1374,
    "vorder": 28,
    "position": 1,
    "text": "چو برق درخشنده پولاد تیغ"
  },
  {
    "poem_id": 1374,
    "vorder": 29,
    "position": 0,
    "text": "هوا را تو گفتی همی برفروخت"
  },
  {
    "poem_id": 1374,
    "vorder": 30,
    "position": 1,
    "text": "چو الماس روی زمین را بسوخت"
  },
  {
    "poem_id": 1374,
    "vorder": 31,
    "position": 0,
    "text": "به مغز اندرون بانگ پولاد خاست"
  },
  {
    "poem_id": 1374,
    "vorder": 32,
    "position": 1,
    "text": "به ابر اندرون آتش و باد خاست"
  },
  {
    "poem_id": 1374,
    "vorder": 33,
    "position": 0,
    "text": "برآورد شاه از کمین‌گاه سر"
  },
  {
    "poem_id": 1374,
    "vorder": 34,
    "position": 1,
    "text": "نبد تور را از دو رویه گذر"
  },
  {
    "poem_id": 1374,
    "vorder": 35,
    "position": 0,
    "text": "عنان را بپیچید و برگاشت روی"
  },
  {
    "poem_id": 1374,
    "vorder": 36,
    "position": 1,
    "text": "برآمد ز لشکر یکی های هوی"
  },
  {
    "poem_id": 1374,
    "vorder": 37,
    "position": 0,
    "text": "دمان از پس ایدر منوچهر شاه"
  },
  {
    "poem_id": 1374,
    "vorder": 38,
    "position": 1,
    "text": "رسید اندر آن نامور کینه خواه"
  },
  {
    "poem_id": 1374,
    "vorder": 39,
    "position": 0,
    "text": "یکی نیزه انداخت بر پشت او"
  },
  {
    "poem_id": 1374,
    "vorder": 40,
    "position": 1,
    "text": "نگونسار شد خنجر از مشت او"
  },
  {
    "poem_id": 1374,
    "vorder": 41,
    "position": 0,
    "text": "ز زین برگرفتش به کردار باد"
  },
  {
    "poem_id": 1374,
    "vorder": 42,
    "position": 1,
    "text": "بزد بر زمین‌، داد‌ِ مردی بداد"
  },
  {
    "poem_id": 1374,
    "vorder": 43,
    "position": 0,
    "text": "سرش را هم آنگه ز تن دور کرد"
  },
  {
    "poem_id": 1374,
    "vorder": 44,
    "position": 1,
    "text": "دد و دام را از تنش سور کرد"
  },
  {
    "poem_id": 1374,
    "vorder": 45,
    "position": 0,
    "text": "بیامد به لشکرگه خویش باز"
  },
  {
    "poem_id": 1374,
    "vorder": 46,
    "position": 1,
    "text": "به دیدار آن لشکر سرفراز"
  }
]