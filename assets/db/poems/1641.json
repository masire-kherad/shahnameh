[
  {
    "poem_id": 1641,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1641,
    "vorder": 2,
    "position": 1,
    "text": "قلم خواست چینی و رومی حریر"
  },
  {
    "poem_id": 1641,
    "vorder": 3,
    "position": 0,
    "text": "نویسنده از کلک چون خامه کرد"
  },
  {
    "poem_id": 1641,
    "vorder": 4,
    "position": 1,
    "text": "سوی مادر روشنک نامه کرد"
  },
  {
    "poem_id": 1641,
    "vorder": 5,
    "position": 0,
    "text": "که یزدان ترا مزد نیکان دهاد"
  },
  {
    "poem_id": 1641,
    "vorder": 6,
    "position": 1,
    "text": "بداندیش را درد پیکان دهاد"
  },
  {
    "poem_id": 1641,
    "vorder": 7,
    "position": 0,
    "text": "نوشتم یکی نامه‌ای پیش ازین"
  },
  {
    "poem_id": 1641,
    "vorder": 8,
    "position": 1,
    "text": "نوشته درو دردها بیش ازین"
  },
  {
    "poem_id": 1641,
    "vorder": 9,
    "position": 0,
    "text": "چو جفت ترا روز برگشته شد"
  },
  {
    "poem_id": 1641,
    "vorder": 10,
    "position": 1,
    "text": "به دست یکی بنده‌بر کشته شد"
  },
  {
    "poem_id": 1641,
    "vorder": 11,
    "position": 0,
    "text": "بر آیین شاهان کفن ساختم"
  },
  {
    "poem_id": 1641,
    "vorder": 12,
    "position": 1,
    "text": "ورا زین جهان تیز پرداختم"
  },
  {
    "poem_id": 1641,
    "vorder": 13,
    "position": 0,
    "text": "بسی آشتی خواستم پیش جنگ"
  },
  {
    "poem_id": 1641,
    "vorder": 14,
    "position": 1,
    "text": "نکرد آشتی چون نبودش درنگ"
  },
  {
    "poem_id": 1641,
    "vorder": 15,
    "position": 0,
    "text": "ز خونش بپیچید هم دشمنش"
  },
  {
    "poem_id": 1641,
    "vorder": 16,
    "position": 1,
    "text": "به مینو رساناد یزدان تنش"
  },
  {
    "poem_id": 1641,
    "vorder": 17,
    "position": 0,
    "text": "نیابد کسی چاره از چنگ مرگ"
  },
  {
    "poem_id": 1641,
    "vorder": 18,
    "position": 1,
    "text": "چو باد خزانست و ما همچو برگ"
  },
  {
    "poem_id": 1641,
    "vorder": 19,
    "position": 0,
    "text": "جهان یکسر اکنون به پیش شماست"
  },
  {
    "poem_id": 1641,
    "vorder": 20,
    "position": 1,
    "text": "بر اندرز دارا فراوان گواست"
  },
  {
    "poem_id": 1641,
    "vorder": 21,
    "position": 0,
    "text": "که او روشنک را به من داد و گفت"
  },
  {
    "poem_id": 1641,
    "vorder": 22,
    "position": 1,
    "text": "که چون او بباید ترا در نهفت"
  },
  {
    "poem_id": 1641,
    "vorder": 23,
    "position": 0,
    "text": "کنون با پرستنده و دایگان"
  },
  {
    "poem_id": 1641,
    "vorder": 24,
    "position": 1,
    "text": "از ایران بزرگان پرمایگان"
  },
  {
    "poem_id": 1641,
    "vorder": 25,
    "position": 0,
    "text": "فرستید زودش به نزدیک من"
  },
  {
    "poem_id": 1641,
    "vorder": 26,
    "position": 1,
    "text": "زداید مگر جان تاریک من"
  },
  {
    "poem_id": 1641,
    "vorder": 27,
    "position": 0,
    "text": "بدارید چون پیش بود اصفهان"
  },
  {
    "poem_id": 1641,
    "vorder": 28,
    "position": 1,
    "text": "ز هر سو پراگنده کارآگهان"
  },
  {
    "poem_id": 1641,
    "vorder": 29,
    "position": 0,
    "text": "همه کارداران با شرم و داد"
  },
  {
    "poem_id": 1641,
    "vorder": 30,
    "position": 1,
    "text": "که دارای دارابشان کار داد"
  },
  {
    "poem_id": 1641,
    "vorder": 31,
    "position": 0,
    "text": "وز آنجا نخواهید فرمان رواست"
  },
  {
    "poem_id": 1641,
    "vorder": 32,
    "position": 1,
    "text": "همه شهر ایران پیش شماست"
  },
  {
    "poem_id": 1641,
    "vorder": 33,
    "position": 0,
    "text": "دل خویش را پر مدارا کنید"
  },
  {
    "poem_id": 1641,
    "vorder": 34,
    "position": 1,
    "text": "مرا در جهان نام دارا کنید"
  },
  {
    "poem_id": 1641,
    "vorder": 35,
    "position": 0,
    "text": "سوی روشنک همچنین نامه‌ای"
  },
  {
    "poem_id": 1641,
    "vorder": 36,
    "position": 1,
    "text": "ز شاه جهاندار خودکامه‌ای"
  },
  {
    "poem_id": 1641,
    "vorder": 37,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1641,
    "vorder": 38,
    "position": 1,
    "text": "جهاندار و دانا و پروردگار"
  },
  {
    "poem_id": 1641,
    "vorder": 39,
    "position": 0,
    "text": "دگر گفت کز گوهر پادشا"
  },
  {
    "poem_id": 1641,
    "vorder": 40,
    "position": 1,
    "text": "نزاید مگر مردم پارسا"
  },
  {
    "poem_id": 1641,
    "vorder": 41,
    "position": 0,
    "text": "دلارای با نام و با رای و شرم"
  },
  {
    "poem_id": 1641,
    "vorder": 42,
    "position": 1,
    "text": "سخن گفتن خوب و آوای نرم"
  },
  {
    "poem_id": 1641,
    "vorder": 43,
    "position": 0,
    "text": "پدر مر ترا پیش ما را سپرد"
  },
  {
    "poem_id": 1641,
    "vorder": 44,
    "position": 1,
    "text": "وزان پس شد و نام نیکی ببرد"
  },
  {
    "poem_id": 1641,
    "vorder": 45,
    "position": 0,
    "text": "چو آیی شبستان و مشکوی من"
  },
  {
    "poem_id": 1641,
    "vorder": 46,
    "position": 1,
    "text": "ببینی تو باشی جهانجوی من"
  },
  {
    "poem_id": 1641,
    "vorder": 47,
    "position": 0,
    "text": "سر بانوانی و زیبای تاج"
  },
  {
    "poem_id": 1641,
    "vorder": 48,
    "position": 1,
    "text": "فروزندهٔ یاره و تخت عاج"
  },
  {
    "poem_id": 1641,
    "vorder": 49,
    "position": 0,
    "text": "نوشتیم نامه بر مادرت"
  },
  {
    "poem_id": 1641,
    "vorder": 50,
    "position": 1,
    "text": "که ایدر فرستد ترا در خورت"
  },
  {
    "poem_id": 1641,
    "vorder": 51,
    "position": 0,
    "text": "به آیین فرزند شاهنشهان"
  },
  {
    "poem_id": 1641,
    "vorder": 52,
    "position": 1,
    "text": "به پیش اندرون موبد اصفهان"
  },
  {
    "poem_id": 1641,
    "vorder": 53,
    "position": 0,
    "text": "پرستنده و تاج شاهان و مهد"
  },
  {
    "poem_id": 1641,
    "vorder": 54,
    "position": 1,
    "text": "هم آن را که خوردی ازو شیر و شهد"
  },
  {
    "poem_id": 1641,
    "vorder": 55,
    "position": 0,
    "text": "به مشکوی ما باش روشن‌روان"
  },
  {
    "poem_id": 1641,
    "vorder": 56,
    "position": 1,
    "text": "توی در شبستان سر بانوان"
  },
  {
    "poem_id": 1641,
    "vorder": 57,
    "position": 0,
    "text": "همیشه دل شرم جفت تو باد"
  },
  {
    "poem_id": 1641,
    "vorder": 58,
    "position": 1,
    "text": "شبستان شاهان نهفت تو باد"
  },
  {
    "poem_id": 1641,
    "vorder": 59,
    "position": 0,
    "text": "بیامد یکی فیلسوفی چو گرد"
  },
  {
    "poem_id": 1641,
    "vorder": 60,
    "position": 1,
    "text": "سخنهای شاه جهان یاد کرد"
  }
]