[
  {
    "poem_id": 1355,
    "vorder": 1,
    "position": 0,
    "text": "طلسمی که ضحاک سازیده بود"
  },
  {
    "poem_id": 1355,
    "vorder": 2,
    "position": 1,
    "text": "سرش به آسمان بر فرازیده بود"
  },
  {
    "poem_id": 1355,
    "vorder": 3,
    "position": 0,
    "text": "فریدون ز بالا فرود آورید"
  },
  {
    "poem_id": 1355,
    "vorder": 4,
    "position": 1,
    "text": "که آن جز به نام جهاندار دید"
  },
  {
    "poem_id": 1355,
    "vorder": 5,
    "position": 0,
    "text": "و زآن جادوان کاندر ایوان بدند"
  },
  {
    "poem_id": 1355,
    "vorder": 6,
    "position": 1,
    "text": "همه نامور نرّه دیوان بدند"
  },
  {
    "poem_id": 1355,
    "vorder": 7,
    "position": 0,
    "text": "سرانشان به گُرز گران کرد پست"
  },
  {
    "poem_id": 1355,
    "vorder": 8,
    "position": 1,
    "text": "نشست از بر گاه جادوپرست"
  },
  {
    "poem_id": 1355,
    "vorder": 9,
    "position": 0,
    "text": "نهاد از بر تخت ضحاک پای"
  },
  {
    "poem_id": 1355,
    "vorder": 10,
    "position": 1,
    "text": "کلاه کئی جست و بگرفت جای"
  },
  {
    "poem_id": 1355,
    "vorder": 11,
    "position": 0,
    "text": "برون آورید از شبستان اوی"
  },
  {
    "poem_id": 1355,
    "vorder": 12,
    "position": 1,
    "text": "بتان سیه‌موی و خورشید‌روی"
  },
  {
    "poem_id": 1355,
    "vorder": 13,
    "position": 0,
    "text": "بفرمود شستن سرانشان نخست"
  },
  {
    "poem_id": 1355,
    "vorder": 14,
    "position": 1,
    "text": "روانشان از آن تیرگی‌ها بشست"
  },
  {
    "poem_id": 1355,
    "vorder": 15,
    "position": 0,
    "text": "ره داور پاک بنمودشان"
  },
  {
    "poem_id": 1355,
    "vorder": 16,
    "position": 1,
    "text": "ز آلودگی پس بپالودشان"
  },
  {
    "poem_id": 1355,
    "vorder": 17,
    "position": 0,
    "text": "که پروردهٔ بت‌پرستان بدند"
  },
  {
    "poem_id": 1355,
    "vorder": 18,
    "position": 1,
    "text": "سرآسیمه بر سان مستان بدند"
  },
  {
    "poem_id": 1355,
    "vorder": 19,
    "position": 0,
    "text": "پس آن دختران جهاندار جم"
  },
  {
    "poem_id": 1355,
    "vorder": 20,
    "position": 1,
    "text": "به نرگس گل سرخ را داده نم"
  },
  {
    "poem_id": 1355,
    "vorder": 21,
    "position": 0,
    "text": "گشادند بر آفریدون سخن"
  },
  {
    "poem_id": 1355,
    "vorder": 22,
    "position": 1,
    "text": "که تو باش تا هست گیتی کهن"
  },
  {
    "poem_id": 1355,
    "vorder": 23,
    "position": 0,
    "text": "چه اختر بد این از تو ای نیک‌بخت؟"
  },
  {
    "poem_id": 1355,
    "vorder": 24,
    "position": 1,
    "text": "چه باری؟ ز شاخ کدامین درخت؟"
  },
  {
    "poem_id": 1355,
    "vorder": 25,
    "position": 0,
    "text": "که ایدون به بالین شیر آمدی"
  },
  {
    "poem_id": 1355,
    "vorder": 26,
    "position": 1,
    "text": "ستمکاره مرد دلیر آمدی"
  },
  {
    "poem_id": 1355,
    "vorder": 27,
    "position": 0,
    "text": "چه مایه جهان گشت بر ما به بد"
  },
  {
    "poem_id": 1355,
    "vorder": 28,
    "position": 1,
    "text": "ز کردار این جادوی بی‌خرد"
  },
  {
    "poem_id": 1355,
    "vorder": 29,
    "position": 0,
    "text": "ندیدیم کس کاین چنین زهره داشت"
  },
  {
    "poem_id": 1355,
    "vorder": 30,
    "position": 1,
    "text": "بدین پایگه از هنر بهره داشت"
  },
  {
    "poem_id": 1355,
    "vorder": 31,
    "position": 0,
    "text": "کش اندیشهٔ گاه او آمدی"
  },
  {
    "poem_id": 1355,
    "vorder": 32,
    "position": 1,
    "text": "و گرش آرزو جاه او آمدی"
  },
  {
    "poem_id": 1355,
    "vorder": 33,
    "position": 0,
    "text": "چنین داد پاسخ فریدون که تخت"
  },
  {
    "poem_id": 1355,
    "vorder": 34,
    "position": 1,
    "text": "نماند به کس جاودانه نه بخت"
  },
  {
    "poem_id": 1355,
    "vorder": 35,
    "position": 0,
    "text": "منم پور آن نیک‌بخت آبتین"
  },
  {
    "poem_id": 1355,
    "vorder": 36,
    "position": 1,
    "text": "که بگرفت ضحاک ز ایران زمین"
  },
  {
    "poem_id": 1355,
    "vorder": 37,
    "position": 0,
    "text": "بکشتش به زاریّ و من کینه جوی"
  },
  {
    "poem_id": 1355,
    "vorder": 38,
    "position": 1,
    "text": "نهادم سوی تخت ضحاک روی"
  },
  {
    "poem_id": 1355,
    "vorder": 39,
    "position": 0,
    "text": "همان گاو برمایه که‌م دایه بود"
  },
  {
    "poem_id": 1355,
    "vorder": 40,
    "position": 1,
    "text": "ز پیکر تنش همچو پیرایه بود"
  },
  {
    "poem_id": 1355,
    "vorder": 41,
    "position": 0,
    "text": "ز خون چنان بی‌زبان چارپای"
  },
  {
    "poem_id": 1355,
    "vorder": 42,
    "position": 1,
    "text": "چه آمد بر آن مرد ناپاک‌رای"
  },
  {
    "poem_id": 1355,
    "vorder": 43,
    "position": 0,
    "text": "کمر بسته‌ام لاجرم جنگجوی"
  },
  {
    "poem_id": 1355,
    "vorder": 44,
    "position": 1,
    "text": "از ایران به کین اندر آورده روی"
  },
  {
    "poem_id": 1355,
    "vorder": 45,
    "position": 0,
    "text": "سرش را بدین گُرزهٔ گاو چهر"
  },
  {
    "poem_id": 1355,
    "vorder": 46,
    "position": 1,
    "text": "بکوبم‌، نه بخشایش آرم نه مهر"
  },
  {
    "poem_id": 1355,
    "vorder": 47,
    "position": 0,
    "text": "چو بشنید از او این سخن ارنواز"
  },
  {
    "poem_id": 1355,
    "vorder": 48,
    "position": 1,
    "text": "گشاده شدش بر دل پاک راز"
  },
  {
    "poem_id": 1355,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت شاه آفریدون تویی"
  },
  {
    "poem_id": 1355,
    "vorder": 50,
    "position": 1,
    "text": "که ویران کنی تنبل و جادویی"
  },
  {
    "poem_id": 1355,
    "vorder": 51,
    "position": 0,
    "text": "کجا هوش ضحاک بر دست تست"
  },
  {
    "poem_id": 1355,
    "vorder": 52,
    "position": 1,
    "text": "گشاد جهان بر کمربست تست"
  },
  {
    "poem_id": 1355,
    "vorder": 53,
    "position": 0,
    "text": "ز تخم کیان ما دو پوشیده پاک"
  },
  {
    "poem_id": 1355,
    "vorder": 54,
    "position": 1,
    "text": "شده رام با او ز بیم هلاک"
  },
  {
    "poem_id": 1355,
    "vorder": 55,
    "position": 0,
    "text": "همی جفتمان خواند او جفت مار"
  },
  {
    "poem_id": 1355,
    "vorder": 56,
    "position": 1,
    "text": "چگونه توان بودن ای شهریار"
  },
  {
    "poem_id": 1355,
    "vorder": 57,
    "position": 0,
    "text": "فریدون چنین پاسخ آورد باز"
  },
  {
    "poem_id": 1355,
    "vorder": 58,
    "position": 1,
    "text": "که گر چرخ دادم دهد از فراز"
  },
  {
    "poem_id": 1355,
    "vorder": 59,
    "position": 0,
    "text": "ببرّم پی اژدها را ز خاک"
  },
  {
    "poem_id": 1355,
    "vorder": 60,
    "position": 1,
    "text": "بشویم جهان را ز ناپاک پاک"
  },
  {
    "poem_id": 1355,
    "vorder": 61,
    "position": 0,
    "text": "بباید شما را کنون گفت راست"
  },
  {
    "poem_id": 1355,
    "vorder": 62,
    "position": 1,
    "text": "که آن بی‌بها اژدهافش کجاست"
  },
  {
    "poem_id": 1355,
    "vorder": 63,
    "position": 0,
    "text": "بر او خوب‌رویان گشادند راز"
  },
  {
    "poem_id": 1355,
    "vorder": 64,
    "position": 1,
    "text": "مگر کاژدها را سر آید به گاز"
  },
  {
    "poem_id": 1355,
    "vorder": 65,
    "position": 0,
    "text": "بگفتند کاو سوی هندوستان"
  },
  {
    "poem_id": 1355,
    "vorder": 66,
    "position": 1,
    "text": "بشد تا کند بند جادوستان"
  },
  {
    "poem_id": 1355,
    "vorder": 67,
    "position": 0,
    "text": "ببرّد سر بی‌گناهان هزار"
  },
  {
    "poem_id": 1355,
    "vorder": 68,
    "position": 1,
    "text": "هراسان شده‌ست از بد روزگار"
  },
  {
    "poem_id": 1355,
    "vorder": 69,
    "position": 0,
    "text": "کجا گفته بودش یکی پیشبین"
  },
  {
    "poem_id": 1355,
    "vorder": 70,
    "position": 1,
    "text": "که پردختگی گردد از تو زمین"
  },
  {
    "poem_id": 1355,
    "vorder": 71,
    "position": 0,
    "text": "که آید که گیرد سر تخت تو"
  },
  {
    "poem_id": 1355,
    "vorder": 72,
    "position": 1,
    "text": "چگونه فرو پژمرد بخت تو"
  },
  {
    "poem_id": 1355,
    "vorder": 73,
    "position": 0,
    "text": "دلش زآن زده فال پر آتش است"
  },
  {
    "poem_id": 1355,
    "vorder": 74,
    "position": 1,
    "text": "همه زندگانی بر او ناخوش است"
  },
  {
    "poem_id": 1355,
    "vorder": 75,
    "position": 0,
    "text": "همی خون دام و دد و مرد و زن"
  },
  {
    "poem_id": 1355,
    "vorder": 76,
    "position": 1,
    "text": "بریزد کند در یکی آبدن"
  },
  {
    "poem_id": 1355,
    "vorder": 77,
    "position": 0,
    "text": "مگر کاو سر و تن بشوید به خون"
  },
  {
    "poem_id": 1355,
    "vorder": 78,
    "position": 1,
    "text": "شود فال اخترشناسان نگون"
  },
  {
    "poem_id": 1355,
    "vorder": 79,
    "position": 0,
    "text": "همان نیز از آن مارها بر دو کفت"
  },
  {
    "poem_id": 1355,
    "vorder": 80,
    "position": 1,
    "text": "به رنج دراز است مانده شگفت"
  },
  {
    "poem_id": 1355,
    "vorder": 81,
    "position": 0,
    "text": "از این کشور آید به دیگر شود"
  },
  {
    "poem_id": 1355,
    "vorder": 82,
    "position": 1,
    "text": "ز رنج دو مار سیه نغنود"
  },
  {
    "poem_id": 1355,
    "vorder": 83,
    "position": 0,
    "text": "بیامد کنون گاه بازآمدنش"
  },
  {
    "poem_id": 1355,
    "vorder": 84,
    "position": 1,
    "text": "که جایی نباید فراوان بدنش"
  },
  {
    "poem_id": 1355,
    "vorder": 85,
    "position": 0,
    "text": "گشاد آن نگار جگر خسته راز"
  },
  {
    "poem_id": 1355,
    "vorder": 86,
    "position": 1,
    "text": "نهاده بدو گوش گردن‌فراز"
  }
]