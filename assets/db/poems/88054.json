[
  {
    "poem_id": 88054,
    "vorder": 1,
    "position": 0,
    "text": "چو نزدیک بنگاه و لشکر شدند"
  },
  {
    "poem_id": 88054,
    "vorder": 2,
    "position": 1,
    "text": "پذیرهٔ سپهبد سپاه آمدند"
  },
  {
    "poem_id": 88054,
    "vorder": 3,
    "position": 0,
    "text": "به پیش سپه بود گستهم شیر"
  },
  {
    "poem_id": 88054,
    "vorder": 4,
    "position": 1,
    "text": "بیامد بر پهلوان دلیر"
  },
  {
    "poem_id": 88054,
    "vorder": 5,
    "position": 0,
    "text": "زمین را ببوسید و کرد آفرین"
  },
  {
    "poem_id": 88054,
    "vorder": 6,
    "position": 1,
    "text": "سپاهت بی‌آزار گفتا ببین"
  },
  {
    "poem_id": 88054,
    "vorder": 7,
    "position": 0,
    "text": "چنانچون سپردی سپردم به هم"
  },
  {
    "poem_id": 88054,
    "vorder": 8,
    "position": 1,
    "text": "در این بود گودرز با گستهم"
  },
  {
    "poem_id": 88054,
    "vorder": 9,
    "position": 0,
    "text": "که اندر زمان از لب دیده‌بان"
  },
  {
    "poem_id": 88054,
    "vorder": 10,
    "position": 1,
    "text": "به گوش آمد از کوه زیبد فغان"
  },
  {
    "poem_id": 88054,
    "vorder": 11,
    "position": 0,
    "text": "که از گرد شد دشت چون تیره شب"
  },
  {
    "poem_id": 88054,
    "vorder": 12,
    "position": 1,
    "text": "شگفتی برآمد ز هر سو جلب"
  },
  {
    "poem_id": 88054,
    "vorder": 13,
    "position": 0,
    "text": "خروشیدن کوس با کرنای"
  },
  {
    "poem_id": 88054,
    "vorder": 14,
    "position": 1,
    "text": "بجنباند آن دشت گویی ز جای"
  },
  {
    "poem_id": 88054,
    "vorder": 15,
    "position": 0,
    "text": "یکی تخت پیروزه بر پشت پیل"
  },
  {
    "poem_id": 88054,
    "vorder": 16,
    "position": 1,
    "text": "درفشان به کردار دریای نیل"
  },
  {
    "poem_id": 88054,
    "vorder": 17,
    "position": 0,
    "text": "هوا شد به سان پرند بنفش"
  },
  {
    "poem_id": 88054,
    "vorder": 18,
    "position": 1,
    "text": "ز تابیدن کاویانی درفش"
  },
  {
    "poem_id": 88054,
    "vorder": 19,
    "position": 0,
    "text": "درفشی به بالای سرو سهی"
  },
  {
    "poem_id": 88054,
    "vorder": 20,
    "position": 1,
    "text": "پدید آمد از دور با فرهی"
  },
  {
    "poem_id": 88054,
    "vorder": 21,
    "position": 0,
    "text": "به گردش سواران جوشنوران"
  },
  {
    "poem_id": 88054,
    "vorder": 22,
    "position": 1,
    "text": "زمین شد بنفش از کران تا کران"
  },
  {
    "poem_id": 88054,
    "vorder": 23,
    "position": 0,
    "text": "پس هر درفشی درفشی به پای"
  },
  {
    "poem_id": 88054,
    "vorder": 24,
    "position": 1,
    "text": "چه از اژدها و چه پیکر همای"
  },
  {
    "poem_id": 88054,
    "vorder": 25,
    "position": 0,
    "text": "اگر همچنین تیزرانی کنند"
  },
  {
    "poem_id": 88054,
    "vorder": 26,
    "position": 1,
    "text": "به یک روز دیگر بدینجا رسند"
  },
  {
    "poem_id": 88054,
    "vorder": 27,
    "position": 0,
    "text": "ز کوه کنابد همان دیده‌بان"
  },
  {
    "poem_id": 88054,
    "vorder": 28,
    "position": 1,
    "text": "بدید آن شگفتی و آمد دوان"
  },
  {
    "poem_id": 88054,
    "vorder": 29,
    "position": 0,
    "text": "چنین گفت گر چشم من تیره نیست"
  },
  {
    "poem_id": 88054,
    "vorder": 30,
    "position": 1,
    "text": "وز اندوه دیدار من خیره نیست"
  },
  {
    "poem_id": 88054,
    "vorder": 31,
    "position": 0,
    "text": "ز ترکان برآورد ایزد دمار"
  },
  {
    "poem_id": 88054,
    "vorder": 32,
    "position": 1,
    "text": "همه رنجشان سر به سر گشت خوار"
  },
  {
    "poem_id": 88054,
    "vorder": 33,
    "position": 0,
    "text": "سپاه اندر آمد ز بالا به پست"
  },
  {
    "poem_id": 88054,
    "vorder": 34,
    "position": 1,
    "text": "خروشان و هر یک درفشی به دست"
  },
  {
    "poem_id": 88054,
    "vorder": 35,
    "position": 0,
    "text": "درفش سپهدار توران نگون"
  },
  {
    "poem_id": 88054,
    "vorder": 36,
    "position": 1,
    "text": "همی بینم از پیش غرقه به خون"
  },
  {
    "poem_id": 88054,
    "vorder": 37,
    "position": 0,
    "text": "همان ده دلاور کز ایدر برفت"
  },
  {
    "poem_id": 88054,
    "vorder": 38,
    "position": 1,
    "text": "ابا گرد پیران به آورد تفت"
  },
  {
    "poem_id": 88054,
    "vorder": 39,
    "position": 0,
    "text": "همی بینم از دورشان سرنگون"
  },
  {
    "poem_id": 88054,
    "vorder": 40,
    "position": 1,
    "text": "فگنده بر اسبان و تن پر ز خون"
  },
  {
    "poem_id": 88054,
    "vorder": 41,
    "position": 0,
    "text": "دلیران ایران گرازان به هم"
  },
  {
    "poem_id": 88054,
    "vorder": 42,
    "position": 1,
    "text": "رسیدند یکسر بر گستهم"
  },
  {
    "poem_id": 88054,
    "vorder": 43,
    "position": 0,
    "text": "وز آن سوی زیبد یکی تیره‌گرد"
  },
  {
    "poem_id": 88054,
    "vorder": 44,
    "position": 1,
    "text": "پدید آمد و دشت شد لاژورد"
  },
  {
    "poem_id": 88054,
    "vorder": 45,
    "position": 0,
    "text": "میان سپه کاویانی درفش"
  },
  {
    "poem_id": 88054,
    "vorder": 46,
    "position": 1,
    "text": "به پیش اندرون تیغهای بنفش"
  },
  {
    "poem_id": 88054,
    "vorder": 47,
    "position": 0,
    "text": "درفش شهنشاه با بوق و کوس"
  },
  {
    "poem_id": 88054,
    "vorder": 48,
    "position": 1,
    "text": "پدید آمد و شد زمین آبنوس"
  },
  {
    "poem_id": 88054,
    "vorder": 49,
    "position": 0,
    "text": "برفتند لهاک و فرشیدورد"
  },
  {
    "poem_id": 88054,
    "vorder": 50,
    "position": 1,
    "text": "بدانجا که بد جایگاه نبرد"
  },
  {
    "poem_id": 88054,
    "vorder": 51,
    "position": 0,
    "text": "بدیدند کشته به دیدار خویش"
  },
  {
    "poem_id": 88054,
    "vorder": 52,
    "position": 1,
    "text": "سپهبد برادر جهاندار خویش"
  },
  {
    "poem_id": 88054,
    "vorder": 53,
    "position": 0,
    "text": "ابا ده سوار آن گزیده سران"
  },
  {
    "poem_id": 88054,
    "vorder": 54,
    "position": 1,
    "text": "ز ترکان دلیران جنگاوران"
  },
  {
    "poem_id": 88054,
    "vorder": 55,
    "position": 0,
    "text": "بر آن دیده بر زار و جوشان شدند"
  },
  {
    "poem_id": 88054,
    "vorder": 56,
    "position": 1,
    "text": "ز خون برادر خروشان شدند"
  },
  {
    "poem_id": 88054,
    "vorder": 57,
    "position": 0,
    "text": "همی زار گفتند کای نره شیر"
  },
  {
    "poem_id": 88054,
    "vorder": 58,
    "position": 1,
    "text": "سپهدار پیران سوار دلیر"
  },
  {
    "poem_id": 88054,
    "vorder": 59,
    "position": 0,
    "text": "چه بایست آن رادی و راستی"
  },
  {
    "poem_id": 88054,
    "vorder": 60,
    "position": 1,
    "text": "چو رفتن ز گیتی چنین خواستی"
  },
  {
    "poem_id": 88054,
    "vorder": 61,
    "position": 0,
    "text": "کنون کام دشمن برآمد همه"
  },
  {
    "poem_id": 88054,
    "vorder": 62,
    "position": 1,
    "text": "به بد بر تو گیتی سرآمد همه"
  },
  {
    "poem_id": 88054,
    "vorder": 63,
    "position": 0,
    "text": "که جوید کنون در جهان کین تو"
  },
  {
    "poem_id": 88054,
    "vorder": 64,
    "position": 1,
    "text": "که گیرد کنون راه و آیین تو"
  },
  {
    "poem_id": 88054,
    "vorder": 65,
    "position": 0,
    "text": "از این شهر ترکان و افراسیاب"
  },
  {
    "poem_id": 88054,
    "vorder": 66,
    "position": 1,
    "text": "بد آمد سرانجامت ای نیک‌یاب"
  },
  {
    "poem_id": 88054,
    "vorder": 67,
    "position": 0,
    "text": "بباید بریدن سر خویش پست"
  },
  {
    "poem_id": 88054,
    "vorder": 68,
    "position": 1,
    "text": "به خون غرقه کردن بر و یال و دست"
  },
  {
    "poem_id": 88054,
    "vorder": 69,
    "position": 0,
    "text": "چو اندرز پیران نهادند پیش"
  },
  {
    "poem_id": 88054,
    "vorder": 70,
    "position": 1,
    "text": "نرفتند بر خیره گفتار خویش"
  },
  {
    "poem_id": 88054,
    "vorder": 71,
    "position": 0,
    "text": "ز گودرز چون خواست پیران نبرد"
  },
  {
    "poem_id": 88054,
    "vorder": 72,
    "position": 1,
    "text": "چنین گفت با گرد فرشیدورد"
  },
  {
    "poem_id": 88054,
    "vorder": 73,
    "position": 0,
    "text": "که گر من شوم کشته بر کینه‌گاه"
  },
  {
    "poem_id": 88054,
    "vorder": 74,
    "position": 1,
    "text": "شما کس مباشید پیش سپاه"
  },
  {
    "poem_id": 88054,
    "vorder": 75,
    "position": 0,
    "text": "اگر کشته گردم بر این دشت کین"
  },
  {
    "poem_id": 88054,
    "vorder": 76,
    "position": 1,
    "text": "شود تنگ بر نامداران زمین"
  },
  {
    "poem_id": 88054,
    "vorder": 77,
    "position": 0,
    "text": "نه از تخمهٔ ویسه ماند کسی"
  },
  {
    "poem_id": 88054,
    "vorder": 78,
    "position": 1,
    "text": "که اندر سرش مغز باشد بسی"
  },
  {
    "poem_id": 88054,
    "vorder": 79,
    "position": 0,
    "text": "که بر کینه‌گه چونک ما را کشند"
  },
  {
    "poem_id": 88054,
    "vorder": 80,
    "position": 1,
    "text": "چو سرهای ما سوی ایران کشند"
  },
  {
    "poem_id": 88054,
    "vorder": 81,
    "position": 0,
    "text": "ز گودرز خواهد سپه زینهار"
  },
  {
    "poem_id": 88054,
    "vorder": 82,
    "position": 1,
    "text": "شما خویشتن را مدارید خوار"
  },
  {
    "poem_id": 88054,
    "vorder": 83,
    "position": 0,
    "text": "همه راه سوی بیابان برید"
  },
  {
    "poem_id": 88054,
    "vorder": 84,
    "position": 1,
    "text": "مگر کز بد دشمنان جان برید"
  },
  {
    "poem_id": 88054,
    "vorder": 85,
    "position": 0,
    "text": "به لشکرگه خویش رفتند باز"
  },
  {
    "poem_id": 88054,
    "vorder": 86,
    "position": 1,
    "text": "همه دیده پر خون و دل پر گداز"
  },
  {
    "poem_id": 88054,
    "vorder": 87,
    "position": 0,
    "text": "بدانست لشکر سراسر همه"
  },
  {
    "poem_id": 88054,
    "vorder": 88,
    "position": 1,
    "text": "که شد بی‌شبان آن گرازان رمه"
  },
  {
    "poem_id": 88054,
    "vorder": 89,
    "position": 0,
    "text": "همه سر به سر زار و گریان شدند"
  },
  {
    "poem_id": 88054,
    "vorder": 90,
    "position": 1,
    "text": "چو بر آتش تیز بریان شدند"
  },
  {
    "poem_id": 88054,
    "vorder": 91,
    "position": 0,
    "text": "به نزدیک لهاک و فرشیدورد"
  },
  {
    "poem_id": 88054,
    "vorder": 92,
    "position": 1,
    "text": "برفتند با دل پر از باد سرد"
  },
  {
    "poem_id": 88054,
    "vorder": 93,
    "position": 0,
    "text": "که اکنون چه سازیم ز این رزمگاه"
  },
  {
    "poem_id": 88054,
    "vorder": 94,
    "position": 1,
    "text": "چو شد پهلوان پشت توران سپاه"
  },
  {
    "poem_id": 88054,
    "vorder": 95,
    "position": 0,
    "text": "چنین گفت هر کس که پیران گرد"
  },
  {
    "poem_id": 88054,
    "vorder": 96,
    "position": 1,
    "text": "جز از نام نیکو ز گیهان نبرد"
  },
  {
    "poem_id": 88054,
    "vorder": 97,
    "position": 0,
    "text": "که را دل دهد نیز بستن کمر"
  },
  {
    "poem_id": 88054,
    "vorder": 98,
    "position": 1,
    "text": "ز آهن کله برنهادن به سر"
  },
  {
    "poem_id": 88054,
    "vorder": 99,
    "position": 0,
    "text": "چنین گفت لهاک و فرشیدورد"
  },
  {
    "poem_id": 88054,
    "vorder": 100,
    "position": 1,
    "text": "که از خواست یزدان کرانه که کرد"
  },
  {
    "poem_id": 88054,
    "vorder": 101,
    "position": 0,
    "text": "چنین راند بر سر ورا روزگار"
  },
  {
    "poem_id": 88054,
    "vorder": 102,
    "position": 1,
    "text": "که بر کینه کشته شود زار و خوار"
  },
  {
    "poem_id": 88054,
    "vorder": 103,
    "position": 0,
    "text": "به شمشیر کرده جدا سر ز تن"
  },
  {
    "poem_id": 88054,
    "vorder": 104,
    "position": 1,
    "text": "نیابد همی کشته گور و کفن"
  },
  {
    "poem_id": 88054,
    "vorder": 105,
    "position": 0,
    "text": "به هرجای کشته کشان دشمنش"
  },
  {
    "poem_id": 88054,
    "vorder": 106,
    "position": 1,
    "text": "پر از خون سر و درع و خسته تنش"
  },
  {
    "poem_id": 88054,
    "vorder": 107,
    "position": 0,
    "text": "کنون بودنی بود و پیران گذشت"
  },
  {
    "poem_id": 88054,
    "vorder": 108,
    "position": 1,
    "text": "همه کار و کردار او باد گشت"
  },
  {
    "poem_id": 88054,
    "vorder": 109,
    "position": 0,
    "text": "ستون سپه بود تا زنده بود"
  },
  {
    "poem_id": 88054,
    "vorder": 110,
    "position": 1,
    "text": "به مهر سپه جانش آگنده بود"
  },
  {
    "poem_id": 88054,
    "vorder": 111,
    "position": 0,
    "text": "سپه را ز دشمن نگهدار بود"
  },
  {
    "poem_id": 88054,
    "vorder": 112,
    "position": 1,
    "text": "پسر با برادر برش خوار بود"
  },
  {
    "poem_id": 88054,
    "vorder": 113,
    "position": 0,
    "text": "بدان گیتی افتاد نیک و بدش"
  },
  {
    "poem_id": 88054,
    "vorder": 114,
    "position": 1,
    "text": "همانا که نیک است با ایزدش"
  },
  {
    "poem_id": 88054,
    "vorder": 115,
    "position": 0,
    "text": "بس از لشکر خویش تیمار خورد"
  },
  {
    "poem_id": 88054,
    "vorder": 116,
    "position": 1,
    "text": "ز گودرز پیمان ستد در نبرد"
  },
  {
    "poem_id": 88054,
    "vorder": 117,
    "position": 0,
    "text": "که گر من شوم کشته در کینه‌گاه"
  },
  {
    "poem_id": 88054,
    "vorder": 118,
    "position": 1,
    "text": "نجویی تو کین زان سپس با سپاه"
  },
  {
    "poem_id": 88054,
    "vorder": 119,
    "position": 0,
    "text": "گذرشان دهی تا به توران شوند"
  },
  {
    "poem_id": 88054,
    "vorder": 120,
    "position": 1,
    "text": "کمین را نسازی بریشان کمند"
  },
  {
    "poem_id": 88054,
    "vorder": 121,
    "position": 0,
    "text": "ز پیمان نگردند ایرانیان"
  },
  {
    "poem_id": 88054,
    "vorder": 122,
    "position": 1,
    "text": "از این در کنون نیست بیم زیان"
  },
  {
    "poem_id": 88054,
    "vorder": 123,
    "position": 0,
    "text": "سه کار است پیش‌آمده ناگزیر"
  },
  {
    "poem_id": 88054,
    "vorder": 124,
    "position": 1,
    "text": "همه گوش دارید برنا و پیر"
  },
  {
    "poem_id": 88054,
    "vorder": 125,
    "position": 0,
    "text": "اگرتان به زنهار باید شدن"
  },
  {
    "poem_id": 88054,
    "vorder": 126,
    "position": 1,
    "text": "کنونتان همی رای باید زدن"
  },
  {
    "poem_id": 88054,
    "vorder": 127,
    "position": 0,
    "text": "وگر بازگشتن به خرگاه خویش"
  },
  {
    "poem_id": 88054,
    "vorder": 128,
    "position": 1,
    "text": "سپردن به نیک و به بد راه خویش"
  },
  {
    "poem_id": 88054,
    "vorder": 129,
    "position": 0,
    "text": "وگر جنگ را گرد کرده عنان"
  },
  {
    "poem_id": 88054,
    "vorder": 130,
    "position": 1,
    "text": "یکایک به خوناب داده سنان"
  },
  {
    "poem_id": 88054,
    "vorder": 131,
    "position": 0,
    "text": "گر ایدون کتان دل گراید به جنگ"
  },
  {
    "poem_id": 88054,
    "vorder": 132,
    "position": 1,
    "text": "بدین رزمگه کرد باید درنگ"
  },
  {
    "poem_id": 88054,
    "vorder": 133,
    "position": 0,
    "text": "که پیران ز مهتر سپه خواسته است"
  },
  {
    "poem_id": 88054,
    "vorder": 134,
    "position": 1,
    "text": "سپهبد یکی لشکر آراسته است"
  },
  {
    "poem_id": 88054,
    "vorder": 135,
    "position": 0,
    "text": "زمان تا زمان لشکر آید پدید"
  },
  {
    "poem_id": 88054,
    "vorder": 136,
    "position": 1,
    "text": "همی کینه ز ایشان بباید کشید"
  },
  {
    "poem_id": 88054,
    "vorder": 137,
    "position": 0,
    "text": "ز هرگونه رانیم یکسر سخن"
  },
  {
    "poem_id": 88054,
    "vorder": 138,
    "position": 1,
    "text": "جز از خواست یزدان نباشد ز بن"
  },
  {
    "poem_id": 88054,
    "vorder": 139,
    "position": 0,
    "text": "ور ایدون کتان رای شهرست و گاه"
  },
  {
    "poem_id": 88054,
    "vorder": 140,
    "position": 1,
    "text": "همانا که بر ما نگیرند راه"
  },
  {
    "poem_id": 88054,
    "vorder": 141,
    "position": 0,
    "text": "وگرتان به زنهار شاه است رای"
  },
  {
    "poem_id": 88054,
    "vorder": 142,
    "position": 1,
    "text": "بباید بسیچید و رفتن ز جای"
  },
  {
    "poem_id": 88054,
    "vorder": 143,
    "position": 0,
    "text": "وگرتان سوی شهر ایران هواست"
  },
  {
    "poem_id": 88054,
    "vorder": 144,
    "position": 1,
    "text": "دل هر کسی بر تنش پادشاست"
  },
  {
    "poem_id": 88054,
    "vorder": 145,
    "position": 0,
    "text": "ز ما دو برادر مدارید چشم"
  },
  {
    "poem_id": 88054,
    "vorder": 146,
    "position": 1,
    "text": "که هرگز نشوییم دل را ز خشم"
  },
  {
    "poem_id": 88054,
    "vorder": 147,
    "position": 0,
    "text": "کز این تخمهٔ ویسگان کس نبود"
  },
  {
    "poem_id": 88054,
    "vorder": 148,
    "position": 1,
    "text": "که بند کمر بر میانش نسود"
  },
  {
    "poem_id": 88054,
    "vorder": 149,
    "position": 0,
    "text": "بر اندرز سالار پیران شویم"
  },
  {
    "poem_id": 88054,
    "vorder": 150,
    "position": 1,
    "text": "ز راه بیابان به توران شویم"
  },
  {
    "poem_id": 88054,
    "vorder": 151,
    "position": 0,
    "text": "ار ایدونک بر ما بگیرند راه"
  },
  {
    "poem_id": 88054,
    "vorder": 152,
    "position": 1,
    "text": "بکوشیم تا هستمان دستگاه"
  },
  {
    "poem_id": 88054,
    "vorder": 153,
    "position": 0,
    "text": "چو ترکان شنیدند ز ایشان سخن"
  },
  {
    "poem_id": 88054,
    "vorder": 154,
    "position": 1,
    "text": "یکی نیک پاسخ فگندند بن"
  },
  {
    "poem_id": 88054,
    "vorder": 155,
    "position": 0,
    "text": "که سالار با ده یل نامدار"
  },
  {
    "poem_id": 88054,
    "vorder": 156,
    "position": 1,
    "text": "کشیدند کشته بر آن گونه خوار"
  },
  {
    "poem_id": 88054,
    "vorder": 157,
    "position": 0,
    "text": "وز آن روی کیخسرو آید پدید"
  },
  {
    "poem_id": 88054,
    "vorder": 158,
    "position": 1,
    "text": "که یارد بدین رزمگاه آرمید"
  },
  {
    "poem_id": 88054,
    "vorder": 159,
    "position": 0,
    "text": "نه اسب و سلیح و نه پای و نه پر"
  },
  {
    "poem_id": 88054,
    "vorder": 160,
    "position": 1,
    "text": "نه گنج و نه سالار و نه نامور"
  },
  {
    "poem_id": 88054,
    "vorder": 161,
    "position": 0,
    "text": "نه نیروی جنگ و نه راه گریز"
  },
  {
    "poem_id": 88054,
    "vorder": 162,
    "position": 1,
    "text": "چه با خویشتن کرد باید ستیز"
  },
  {
    "poem_id": 88054,
    "vorder": 163,
    "position": 0,
    "text": "اگر بازگردیم گودرز و شاه"
  },
  {
    "poem_id": 88054,
    "vorder": 164,
    "position": 1,
    "text": "پس ما برانند پیل و سپاه"
  },
  {
    "poem_id": 88054,
    "vorder": 165,
    "position": 0,
    "text": "رهایی نیابیم یک تن به جان"
  },
  {
    "poem_id": 88054,
    "vorder": 166,
    "position": 1,
    "text": "نه خرگاه بینیم و نه دودمان"
  },
  {
    "poem_id": 88054,
    "vorder": 167,
    "position": 0,
    "text": "به زنهار بر ما کنون عار نیست"
  },
  {
    "poem_id": 88054,
    "vorder": 168,
    "position": 1,
    "text": "سپاه است بسیار و سالار نیست"
  },
  {
    "poem_id": 88054,
    "vorder": 169,
    "position": 0,
    "text": "از آن پس خود از شاه ترکان چه باک"
  },
  {
    "poem_id": 88054,
    "vorder": 170,
    "position": 1,
    "text": "چه افراسیاب و چه یک مشت خاک"
  }
]