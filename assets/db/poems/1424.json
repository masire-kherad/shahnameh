[
  {
    "poem_id": 1424,
    "vorder": 1,
    "position": 0,
    "text": "ز ترکان طلایه بسی بد براه"
  },
  {
    "poem_id": 1424,
    "vorder": 2,
    "position": 1,
    "text": "رسید اندر ایشان یل صف پناه"
  },
  {
    "poem_id": 1424,
    "vorder": 3,
    "position": 0,
    "text": "برآویخت با نامداران جنگ"
  },
  {
    "poem_id": 1424,
    "vorder": 4,
    "position": 1,
    "text": "یکی گُرزهٔ گاو پیکر به چنگ"
  },
  {
    "poem_id": 1424,
    "vorder": 5,
    "position": 0,
    "text": "دلیران توران برآویختند"
  },
  {
    "poem_id": 1424,
    "vorder": 6,
    "position": 1,
    "text": "سرانجام از رزم بگریختند"
  },
  {
    "poem_id": 1424,
    "vorder": 7,
    "position": 0,
    "text": "نهادند سر سوی افراسیاب"
  },
  {
    "poem_id": 1424,
    "vorder": 8,
    "position": 1,
    "text": "همه دل پر از خون و دیده پر آب"
  },
  {
    "poem_id": 1424,
    "vorder": 9,
    "position": 0,
    "text": "بگفتند وی را همه بیش و کم"
  },
  {
    "poem_id": 1424,
    "vorder": 10,
    "position": 1,
    "text": "سپهبد شد از کار ایشان دژم"
  },
  {
    "poem_id": 1424,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود تا نزد او شد قلون"
  },
  {
    "poem_id": 1424,
    "vorder": 12,
    "position": 1,
    "text": "ز ترکان دلیری گوی پرفسون"
  },
  {
    "poem_id": 1424,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت بگزین ز لشکر سوار"
  },
  {
    "poem_id": 1424,
    "vorder": 14,
    "position": 1,
    "text": "وز ایدر برو تا در کوهسار"
  },
  {
    "poem_id": 1424,
    "vorder": 15,
    "position": 0,
    "text": "دلیر و خردمند و هشیار باش"
  },
  {
    "poem_id": 1424,
    "vorder": 16,
    "position": 1,
    "text": "به پاس اندرون نیز بیدار باش"
  },
  {
    "poem_id": 1424,
    "vorder": 17,
    "position": 0,
    "text": "که ایرانیان مردمی ریمنند"
  },
  {
    "poem_id": 1424,
    "vorder": 18,
    "position": 1,
    "text": "همی ناگهان بر طلایه زنند"
  },
  {
    "poem_id": 1424,
    "vorder": 19,
    "position": 0,
    "text": "برون آمد از نزد خسرو قلون"
  },
  {
    "poem_id": 1424,
    "vorder": 20,
    "position": 1,
    "text": "به پیش اندرون مردم رهنمون"
  },
  {
    "poem_id": 1424,
    "vorder": 21,
    "position": 0,
    "text": "سر راه بر نامداران ببست"
  },
  {
    "poem_id": 1424,
    "vorder": 22,
    "position": 1,
    "text": "به مردان جنگی و پیلان مست"
  },
  {
    "poem_id": 1424,
    "vorder": 23,
    "position": 0,
    "text": "وزان روی رستم دلیر و گزین"
  },
  {
    "poem_id": 1424,
    "vorder": 24,
    "position": 1,
    "text": "بپیمود زی شاه ایران زمین"
  },
  {
    "poem_id": 1424,
    "vorder": 25,
    "position": 0,
    "text": "یکی میل ره تا به البرز کوه"
  },
  {
    "poem_id": 1424,
    "vorder": 26,
    "position": 1,
    "text": "یکی جایگه دید برنا شکوه"
  },
  {
    "poem_id": 1424,
    "vorder": 27,
    "position": 0,
    "text": "درختان بسیار و آب روان"
  },
  {
    "poem_id": 1424,
    "vorder": 28,
    "position": 1,
    "text": "نشستنگه مردم نوجوان"
  },
  {
    "poem_id": 1424,
    "vorder": 29,
    "position": 0,
    "text": "یکی تخت بنهاده نزدیک آب"
  },
  {
    "poem_id": 1424,
    "vorder": 30,
    "position": 1,
    "text": "برو ریخته مشک ناب و گلاب"
  },
  {
    "poem_id": 1424,
    "vorder": 31,
    "position": 0,
    "text": "جوانی به کردار تابنده ماه"
  },
  {
    "poem_id": 1424,
    "vorder": 32,
    "position": 1,
    "text": "نشسته بران تخت بر سایه‌گاه"
  },
  {
    "poem_id": 1424,
    "vorder": 33,
    "position": 0,
    "text": "رده برکشیده بسی پهلوان"
  },
  {
    "poem_id": 1424,
    "vorder": 34,
    "position": 1,
    "text": "به رسم بزرگان کمر بر میان"
  },
  {
    "poem_id": 1424,
    "vorder": 35,
    "position": 0,
    "text": "بیاراسته مجلسی شاهوار"
  },
  {
    "poem_id": 1424,
    "vorder": 36,
    "position": 1,
    "text": "بسان بهشتی به رنگ و نگار"
  },
  {
    "poem_id": 1424,
    "vorder": 37,
    "position": 0,
    "text": "چو دیدند مر پهلوان را به راه"
  },
  {
    "poem_id": 1424,
    "vorder": 38,
    "position": 1,
    "text": "پذیره شدندش ازان سایه‌گاه"
  },
  {
    "poem_id": 1424,
    "vorder": 39,
    "position": 0,
    "text": "که ما میزبانیم و مهمان ما"
  },
  {
    "poem_id": 1424,
    "vorder": 40,
    "position": 1,
    "text": "فرود آی ایدر به فرمان ما"
  },
  {
    "poem_id": 1424,
    "vorder": 41,
    "position": 0,
    "text": "بدان تا همه دست شادی بریم"
  },
  {
    "poem_id": 1424,
    "vorder": 42,
    "position": 1,
    "text": "به یاد رخ نامور می خوریم"
  },
  {
    "poem_id": 1424,
    "vorder": 43,
    "position": 0,
    "text": "تهمتن بدیشان چنین گفت باز"
  },
  {
    "poem_id": 1424,
    "vorder": 44,
    "position": 1,
    "text": "که ای نامداران گردن فراز"
  },
  {
    "poem_id": 1424,
    "vorder": 45,
    "position": 0,
    "text": "مرا رفت باید به البرز کوه"
  },
  {
    "poem_id": 1424,
    "vorder": 46,
    "position": 1,
    "text": "به کاری که بسیار دارد شکوه"
  },
  {
    "poem_id": 1424,
    "vorder": 47,
    "position": 0,
    "text": "نباید به بالین سر و دست ناز"
  },
  {
    "poem_id": 1424,
    "vorder": 48,
    "position": 1,
    "text": "که پیشست بسیار رنج دراز"
  },
  {
    "poem_id": 1424,
    "vorder": 49,
    "position": 0,
    "text": "سر تخت ایران ابی شهریار"
  },
  {
    "poem_id": 1424,
    "vorder": 50,
    "position": 1,
    "text": "مرا باده خوردن نیاید به کار"
  },
  {
    "poem_id": 1424,
    "vorder": 51,
    "position": 0,
    "text": "نشانی دهیدم سوی کیقباد"
  },
  {
    "poem_id": 1424,
    "vorder": 52,
    "position": 1,
    "text": "کسی کز شما دارد او را به یاد"
  },
  {
    "poem_id": 1424,
    "vorder": 53,
    "position": 0,
    "text": "سر آن دلیران زبان برگشاد"
  },
  {
    "poem_id": 1424,
    "vorder": 54,
    "position": 1,
    "text": "که دارم نشانی من از کیقباد"
  },
  {
    "poem_id": 1424,
    "vorder": 55,
    "position": 0,
    "text": "گر آیی فرود و خوری نان ما"
  },
  {
    "poem_id": 1424,
    "vorder": 56,
    "position": 1,
    "text": "بیفروزی از روی خود جان ما"
  },
  {
    "poem_id": 1424,
    "vorder": 57,
    "position": 0,
    "text": "بگوییم یکسر نشان قباد"
  },
  {
    "poem_id": 1424,
    "vorder": 58,
    "position": 1,
    "text": "که او را چگونست رسم و نهاد"
  },
  {
    "poem_id": 1424,
    "vorder": 59,
    "position": 0,
    "text": "تهمتن ز رخش اندر آمد چو باد"
  },
  {
    "poem_id": 1424,
    "vorder": 60,
    "position": 1,
    "text": "چو بشنید از وی نشان قباد"
  },
  {
    "poem_id": 1424,
    "vorder": 61,
    "position": 0,
    "text": "بیامد دمان تا لب رودبار"
  },
  {
    "poem_id": 1424,
    "vorder": 62,
    "position": 1,
    "text": "نشستند در زیر آن سایه‌دار"
  },
  {
    "poem_id": 1424,
    "vorder": 63,
    "position": 0,
    "text": "جوان از بر تخت خود برنشست"
  },
  {
    "poem_id": 1424,
    "vorder": 64,
    "position": 1,
    "text": "گرفته یکی دست رستم به دست"
  },
  {
    "poem_id": 1424,
    "vorder": 65,
    "position": 0,
    "text": "به دست دگر جام پر باده کرد"
  },
  {
    "poem_id": 1424,
    "vorder": 66,
    "position": 1,
    "text": "وزو یاد مردان آزاده کرد"
  },
  {
    "poem_id": 1424,
    "vorder": 67,
    "position": 0,
    "text": "دگر جام بر دست رستم سپرد"
  },
  {
    "poem_id": 1424,
    "vorder": 68,
    "position": 1,
    "text": "بدو گفت کای نامبردار و گرد"
  },
  {
    "poem_id": 1424,
    "vorder": 69,
    "position": 0,
    "text": "بپرسیدی از من نشان قباد"
  },
  {
    "poem_id": 1424,
    "vorder": 70,
    "position": 1,
    "text": "تو این نام را از که داری به یاد"
  },
  {
    "poem_id": 1424,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت رستم که از پهلوان"
  },
  {
    "poem_id": 1424,
    "vorder": 72,
    "position": 1,
    "text": "پیام آوریدم به روشن روان"
  },
  {
    "poem_id": 1424,
    "vorder": 73,
    "position": 0,
    "text": "سر تخت ایران بیاراستند"
  },
  {
    "poem_id": 1424,
    "vorder": 74,
    "position": 1,
    "text": "بزرگان به شاهی ورا خواستند"
  },
  {
    "poem_id": 1424,
    "vorder": 75,
    "position": 0,
    "text": "پدرم آن گزین یلان سر به سر"
  },
  {
    "poem_id": 1424,
    "vorder": 76,
    "position": 1,
    "text": "که خوانند او را همی زال زر"
  },
  {
    "poem_id": 1424,
    "vorder": 77,
    "position": 0,
    "text": "مرا گفت رو تا به البرز کوه"
  },
  {
    "poem_id": 1424,
    "vorder": 78,
    "position": 1,
    "text": "قباد دلاور ببین با گروه"
  },
  {
    "poem_id": 1424,
    "vorder": 79,
    "position": 0,
    "text": "به شاهی برو آفرین کن یکی"
  },
  {
    "poem_id": 1424,
    "vorder": 80,
    "position": 1,
    "text": "نباید که سازی درنگ اندکی"
  },
  {
    "poem_id": 1424,
    "vorder": 81,
    "position": 0,
    "text": "بگویش که گردان ترا خواستند"
  },
  {
    "poem_id": 1424,
    "vorder": 82,
    "position": 1,
    "text": "به شادی جهانی بیاراستند"
  },
  {
    "poem_id": 1424,
    "vorder": 83,
    "position": 0,
    "text": "نشان ار توانی و دانی مرا"
  },
  {
    "poem_id": 1424,
    "vorder": 84,
    "position": 1,
    "text": "دهی و به شاهی رسانی ورا"
  },
  {
    "poem_id": 1424,
    "vorder": 85,
    "position": 0,
    "text": "ز گفتار رستم دلیر جوان"
  },
  {
    "poem_id": 1424,
    "vorder": 86,
    "position": 1,
    "text": "بخندید و گفتش که ای پهلوان"
  },
  {
    "poem_id": 1424,
    "vorder": 87,
    "position": 0,
    "text": "ز تخم فریدون منم کیقباد"
  },
  {
    "poem_id": 1424,
    "vorder": 88,
    "position": 1,
    "text": "پدر بر پدر نام دارم به یاد"
  },
  {
    "poem_id": 1424,
    "vorder": 89,
    "position": 0,
    "text": "چو بشنید رستم فرو برد سر"
  },
  {
    "poem_id": 1424,
    "vorder": 90,
    "position": 1,
    "text": "به خدمت فرود آمد از تخت زر"
  },
  {
    "poem_id": 1424,
    "vorder": 91,
    "position": 0,
    "text": "که ای خسرو خسروان جهان"
  },
  {
    "poem_id": 1424,
    "vorder": 92,
    "position": 1,
    "text": "پناه بزرگان و پشت مهان"
  },
  {
    "poem_id": 1424,
    "vorder": 93,
    "position": 0,
    "text": "سر تخت ایران به کام تو باد"
  },
  {
    "poem_id": 1424,
    "vorder": 94,
    "position": 1,
    "text": "تن ژنده پیلان به دام تو باد"
  },
  {
    "poem_id": 1424,
    "vorder": 95,
    "position": 0,
    "text": "نشست تو بر تخت شاهنشهی"
  },
  {
    "poem_id": 1424,
    "vorder": 96,
    "position": 1,
    "text": "همت سرکشی باد و هم فرهی"
  },
  {
    "poem_id": 1424,
    "vorder": 97,
    "position": 0,
    "text": "درودی رسانم به شاه جهان"
  },
  {
    "poem_id": 1424,
    "vorder": 98,
    "position": 1,
    "text": "ز زال گزین آن یل پهلوان"
  },
  {
    "poem_id": 1424,
    "vorder": 99,
    "position": 0,
    "text": "اگر شاه فرمان دهد بنده را"
  },
  {
    "poem_id": 1424,
    "vorder": 100,
    "position": 1,
    "text": "که بگشایم از بند گوینده را"
  },
  {
    "poem_id": 1424,
    "vorder": 101,
    "position": 0,
    "text": "قباد دلاور برآمد ز جای"
  },
  {
    "poem_id": 1424,
    "vorder": 102,
    "position": 1,
    "text": "ز گفتار رستم دل و هوش و رای"
  },
  {
    "poem_id": 1424,
    "vorder": 103,
    "position": 0,
    "text": "تهمتن همانگه زبان برگشاد"
  },
  {
    "poem_id": 1424,
    "vorder": 104,
    "position": 1,
    "text": "پیام سپهدار ایران بداد"
  },
  {
    "poem_id": 1424,
    "vorder": 105,
    "position": 0,
    "text": "سخن چون به گوش سپهبد رسید"
  },
  {
    "poem_id": 1424,
    "vorder": 106,
    "position": 1,
    "text": "ز شادی دل اندر برش برطپید"
  },
  {
    "poem_id": 1424,
    "vorder": 107,
    "position": 0,
    "text": "بیازید جامی لبالب نبید"
  },
  {
    "poem_id": 1424,
    "vorder": 108,
    "position": 1,
    "text": "بیاد تهمتن به دم درکشید"
  },
  {
    "poem_id": 1424,
    "vorder": 109,
    "position": 0,
    "text": "تهمتن همیدون یکی جام می"
  },
  {
    "poem_id": 1424,
    "vorder": 110,
    "position": 1,
    "text": "بخورد آفرین کرد بر جان کی"
  },
  {
    "poem_id": 1424,
    "vorder": 111,
    "position": 0,
    "text": "برآمد خروش از دل زیر و بم"
  },
  {
    "poem_id": 1424,
    "vorder": 112,
    "position": 1,
    "text": "فراوان شده شادی اندوه کم"
  },
  {
    "poem_id": 1424,
    "vorder": 113,
    "position": 0,
    "text": "شهنشه چنین گفت با پهلوان"
  },
  {
    "poem_id": 1424,
    "vorder": 114,
    "position": 1,
    "text": "که خوابی بدیدم به روشن روان"
  },
  {
    "poem_id": 1424,
    "vorder": 115,
    "position": 0,
    "text": "که از سوی ایران دو باز سپید"
  },
  {
    "poem_id": 1424,
    "vorder": 116,
    "position": 1,
    "text": "یکی تاج رخشان به کردار شید"
  },
  {
    "poem_id": 1424,
    "vorder": 117,
    "position": 0,
    "text": "خرامان و نازان شدندی برم"
  },
  {
    "poem_id": 1424,
    "vorder": 118,
    "position": 1,
    "text": "نهادندی آن تاج را بر سرم"
  },
  {
    "poem_id": 1424,
    "vorder": 119,
    "position": 0,
    "text": "چو بیدار گشتم شدم پرامید"
  },
  {
    "poem_id": 1424,
    "vorder": 120,
    "position": 1,
    "text": "ازان تاج رخشان و باز سپید"
  },
  {
    "poem_id": 1424,
    "vorder": 121,
    "position": 0,
    "text": "بیاراستم مجلسی شاهوار"
  },
  {
    "poem_id": 1424,
    "vorder": 122,
    "position": 1,
    "text": "برین سان که بینی بدین مرغزار"
  },
  {
    "poem_id": 1424,
    "vorder": 123,
    "position": 0,
    "text": "تهمتن مرا شد چو باز سپید"
  },
  {
    "poem_id": 1424,
    "vorder": 124,
    "position": 1,
    "text": "ز تاج بزرگان رسیدم نوید"
  },
  {
    "poem_id": 1424,
    "vorder": 125,
    "position": 0,
    "text": "تهمتن چو بشنید از خواب شاه"
  },
  {
    "poem_id": 1424,
    "vorder": 126,
    "position": 1,
    "text": "ز باز و ز تاج فروزان چو ماه"
  },
  {
    "poem_id": 1424,
    "vorder": 127,
    "position": 0,
    "text": "چنین گفت با شاه کنداوران"
  },
  {
    "poem_id": 1424,
    "vorder": 128,
    "position": 1,
    "text": "نشانست خوابت ز پیغمبران"
  },
  {
    "poem_id": 1424,
    "vorder": 129,
    "position": 0,
    "text": "کنون خیز تا سوی ایران شویم"
  },
  {
    "poem_id": 1424,
    "vorder": 130,
    "position": 1,
    "text": "به یاری به نزد دلیران شویم"
  },
  {
    "poem_id": 1424,
    "vorder": 131,
    "position": 0,
    "text": "قباد اندر آمد چو آتش ز جای"
  },
  {
    "poem_id": 1424,
    "vorder": 132,
    "position": 1,
    "text": "ببور نبرد اندر آورد پای"
  },
  {
    "poem_id": 1424,
    "vorder": 133,
    "position": 0,
    "text": "کمر برمیان بست رستم چو باد"
  },
  {
    "poem_id": 1424,
    "vorder": 134,
    "position": 1,
    "text": "بیامد گرازان پس کیقباد"
  },
  {
    "poem_id": 1424,
    "vorder": 135,
    "position": 0,
    "text": "شب و روز از تاختن نغنوید"
  },
  {
    "poem_id": 1424,
    "vorder": 136,
    "position": 1,
    "text": "چنین تا به نزد طلایه رسید"
  },
  {
    "poem_id": 1424,
    "vorder": 137,
    "position": 0,
    "text": "قلون دلاور شد آگه ز کار"
  },
  {
    "poem_id": 1424,
    "vorder": 138,
    "position": 1,
    "text": "چو آتش بیامد سوی کارزار"
  },
  {
    "poem_id": 1424,
    "vorder": 139,
    "position": 0,
    "text": "شهنشاه ایران چو زان گونه دید"
  },
  {
    "poem_id": 1424,
    "vorder": 140,
    "position": 1,
    "text": "برابر همی خواست صف برکشید"
  },
  {
    "poem_id": 1424,
    "vorder": 141,
    "position": 0,
    "text": "تهمتن بدو گفت کای شهریار"
  },
  {
    "poem_id": 1424,
    "vorder": 142,
    "position": 1,
    "text": "ترا رزم جستن نیاید بکار"
  },
  {
    "poem_id": 1424,
    "vorder": 143,
    "position": 0,
    "text": "من و رخش و کوپال و برگستوان"
  },
  {
    "poem_id": 1424,
    "vorder": 144,
    "position": 1,
    "text": "همانا ندارند با من توان"
  },
  {
    "poem_id": 1424,
    "vorder": 145,
    "position": 0,
    "text": "بگفت این و از جای برکرد رخش"
  },
  {
    "poem_id": 1424,
    "vorder": 146,
    "position": 1,
    "text": "به زخمی سواری همی کرد پخش"
  },
  {
    "poem_id": 1424,
    "vorder": 147,
    "position": 0,
    "text": "قلون دید دیوی بجسته ز بند"
  },
  {
    "poem_id": 1424,
    "vorder": 148,
    "position": 1,
    "text": "به دست اندرون گُرز و برزین کمند"
  },
  {
    "poem_id": 1424,
    "vorder": 149,
    "position": 0,
    "text": "برو حمله آورد مانند باد"
  },
  {
    "poem_id": 1424,
    "vorder": 150,
    "position": 1,
    "text": "بزد نیزه و بند جوشن گشاد"
  },
  {
    "poem_id": 1424,
    "vorder": 151,
    "position": 0,
    "text": "تهمتن بزد دست و نیزه گرفت"
  },
  {
    "poem_id": 1424,
    "vorder": 152,
    "position": 1,
    "text": "قلون از دلیریش مانده شگفت"
  },
  {
    "poem_id": 1424,
    "vorder": 153,
    "position": 0,
    "text": "ستد نیزه از دست او نامدار"
  },
  {
    "poem_id": 1424,
    "vorder": 154,
    "position": 1,
    "text": "بغرید چون تندر از کوهسار"
  },
  {
    "poem_id": 1424,
    "vorder": 155,
    "position": 0,
    "text": "بزد نیزه و برگرفتش ز زین"
  },
  {
    "poem_id": 1424,
    "vorder": 156,
    "position": 1,
    "text": "نهاد آن بن نیزه را بر زمین"
  },
  {
    "poem_id": 1424,
    "vorder": 157,
    "position": 0,
    "text": "قلون گشت چون مرغ با بابزن"
  },
  {
    "poem_id": 1424,
    "vorder": 158,
    "position": 1,
    "text": "بدیدند لشکر همه تن به تن"
  },
  {
    "poem_id": 1424,
    "vorder": 159,
    "position": 0,
    "text": "هزیمت شد از وی سپاه قلون"
  },
  {
    "poem_id": 1424,
    "vorder": 160,
    "position": 1,
    "text": "به یکبارگی بخت بد را زبون"
  },
  {
    "poem_id": 1424,
    "vorder": 161,
    "position": 0,
    "text": "تهمتن گذشت از طلایه سوار"
  },
  {
    "poem_id": 1424,
    "vorder": 162,
    "position": 1,
    "text": "بیامد شتابان سوی کوهسار"
  },
  {
    "poem_id": 1424,
    "vorder": 163,
    "position": 0,
    "text": "کجا بد علفزار و آب روان"
  },
  {
    "poem_id": 1424,
    "vorder": 164,
    "position": 1,
    "text": "فرود آمد آن جایگه پهلوان"
  },
  {
    "poem_id": 1424,
    "vorder": 165,
    "position": 0,
    "text": "چنین تا شب تیره آمد فراز"
  },
  {
    "poem_id": 1424,
    "vorder": 166,
    "position": 1,
    "text": "تهمتن همی کرد هرگونه ساز"
  },
  {
    "poem_id": 1424,
    "vorder": 167,
    "position": 0,
    "text": "از آرایش جامهٔ پهلوی"
  },
  {
    "poem_id": 1424,
    "vorder": 168,
    "position": 1,
    "text": "همان تاج و هم بارهٔ خسروی"
  },
  {
    "poem_id": 1424,
    "vorder": 169,
    "position": 0,
    "text": "چو شب تیره شد پهلو پیش‌بین"
  },
  {
    "poem_id": 1424,
    "vorder": 170,
    "position": 1,
    "text": "برآراست باشاه ایران زمین"
  },
  {
    "poem_id": 1424,
    "vorder": 171,
    "position": 0,
    "text": "به نزدیک زال آوریدش به شب"
  },
  {
    "poem_id": 1424,
    "vorder": 172,
    "position": 1,
    "text": "به آمد شدن هیچ نگشاد لب"
  },
  {
    "poem_id": 1424,
    "vorder": 173,
    "position": 0,
    "text": "نشستند یک هفته با رای زن"
  },
  {
    "poem_id": 1424,
    "vorder": 174,
    "position": 1,
    "text": "شدند اندران موبدان انجمن"
  },
  {
    "poem_id": 1424,
    "vorder": 175,
    "position": 0,
    "text": "بهشتم بیاراست پس تخت عاج"
  },
  {
    "poem_id": 1424,
    "vorder": 176,
    "position": 1,
    "text": "برآویختند از بر عاج تاج"
  }
]