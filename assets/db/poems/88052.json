[
  {
    "poem_id": 88052,
    "vorder": 1,
    "position": 0,
    "text": "دهم برته با کهرم تیغ‌زن"
  },
  {
    "poem_id": 88052,
    "vorder": 2,
    "position": 1,
    "text": "دو خونی و هر دو سر انجمن"
  },
  {
    "poem_id": 88052,
    "vorder": 3,
    "position": 0,
    "text": "همی آزمودند هرگونه جنگ"
  },
  {
    "poem_id": 88052,
    "vorder": 4,
    "position": 1,
    "text": "گرفتند پس تیغ هندی به چنگ"
  },
  {
    "poem_id": 88052,
    "vorder": 5,
    "position": 0,
    "text": "درفش همایون به دست اندرون"
  },
  {
    "poem_id": 88052,
    "vorder": 6,
    "position": 1,
    "text": "تو گفتی بجنبد که بیستون"
  },
  {
    "poem_id": 88052,
    "vorder": 7,
    "position": 0,
    "text": "یکایک بپیچید از او برته روی"
  },
  {
    "poem_id": 88052,
    "vorder": 8,
    "position": 1,
    "text": "یکی تیغ زد بر سر و ترگ اوی"
  },
  {
    "poem_id": 88052,
    "vorder": 9,
    "position": 0,
    "text": "که تا سینه کهرم بدو نیم گشت"
  },
  {
    "poem_id": 88052,
    "vorder": 10,
    "position": 1,
    "text": "ز دشمن دل برته بی‌بیم گشت"
  },
  {
    "poem_id": 88052,
    "vorder": 11,
    "position": 0,
    "text": "فرود آمد از اسب و او را ببست"
  },
  {
    "poem_id": 88052,
    "vorder": 12,
    "position": 1,
    "text": "بر آن زین توزی و خود برنشست"
  },
  {
    "poem_id": 88052,
    "vorder": 13,
    "position": 0,
    "text": "برآمد به بالا چو شرزه پلنگ"
  },
  {
    "poem_id": 88052,
    "vorder": 14,
    "position": 1,
    "text": "خروشان یکی تیغ هندی به چنگ"
  },
  {
    "poem_id": 88052,
    "vorder": 15,
    "position": 0,
    "text": "درفش همایون به دست اندرون"
  },
  {
    "poem_id": 88052,
    "vorder": 16,
    "position": 1,
    "text": "فگنده بر آن باره کهرم نگون"
  },
  {
    "poem_id": 88052,
    "vorder": 17,
    "position": 0,
    "text": "همی گفت شاهست پیروزگر"
  },
  {
    "poem_id": 88052,
    "vorder": 18,
    "position": 1,
    "text": "همیشه کلاهش به خورشید بر"
  },
  {
    "poem_id": 88052,
    "vorder": 19,
    "position": 0,
    "text": "چو از روز نه ساعت اندر گذشت"
  },
  {
    "poem_id": 88052,
    "vorder": 20,
    "position": 1,
    "text": "ز ترکان نبد کس بر آن پهن‌دشت"
  },
  {
    "poem_id": 88052,
    "vorder": 21,
    "position": 0,
    "text": "کسی را کجا پروراند به ناز"
  },
  {
    "poem_id": 88052,
    "vorder": 22,
    "position": 1,
    "text": "برآید بر او روزگار دراز"
  },
  {
    "poem_id": 88052,
    "vorder": 23,
    "position": 0,
    "text": "شبیخون کند گاه شادی بر اوی"
  },
  {
    "poem_id": 88052,
    "vorder": 24,
    "position": 1,
    "text": "همی خواری و سختی آرد به روی"
  },
  {
    "poem_id": 88052,
    "vorder": 25,
    "position": 0,
    "text": "ز باد اندر آرد دهدمان به دم"
  },
  {
    "poem_id": 88052,
    "vorder": 26,
    "position": 1,
    "text": "همی داد خوانیم و پیدا ستم"
  },
  {
    "poem_id": 88052,
    "vorder": 27,
    "position": 0,
    "text": "به تورانیان بر بد آن جنگ شوم"
  },
  {
    "poem_id": 88052,
    "vorder": 28,
    "position": 1,
    "text": "به آوردگه کردن آهنگ شوم"
  },
  {
    "poem_id": 88052,
    "vorder": 29,
    "position": 0,
    "text": "چنان شد که پیران ز توران سپاه"
  },
  {
    "poem_id": 88052,
    "vorder": 30,
    "position": 1,
    "text": "سواری ندید اندر آوردگاه"
  },
  {
    "poem_id": 88052,
    "vorder": 31,
    "position": 0,
    "text": "روان‌ها گسسته ز تنشان به تیغ"
  },
  {
    "poem_id": 88052,
    "vorder": 32,
    "position": 1,
    "text": "جهان را تو گفتی نیامد دریغ"
  }
]