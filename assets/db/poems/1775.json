[
  {
    "poem_id": 1775,
    "vorder": 1,
    "position": 0,
    "text": "چو یوز شکاری به کار آمدش"
  },
  {
    "poem_id": 1775,
    "vorder": 2,
    "position": 1,
    "text": "بجنبید و رای شکار آمدش"
  },
  {
    "poem_id": 1775,
    "vorder": 3,
    "position": 0,
    "text": "یکی باره‌ای تیزرو بر نشست"
  },
  {
    "poem_id": 1775,
    "vorder": 4,
    "position": 1,
    "text": "به هامون خرامید بازی به دست"
  },
  {
    "poem_id": 1775,
    "vorder": 5,
    "position": 0,
    "text": "یکی بیشه پیش آمدش پردرخت"
  },
  {
    "poem_id": 1775,
    "vorder": 6,
    "position": 1,
    "text": "نشستنگه مردم نیک‌بخت"
  },
  {
    "poem_id": 1775,
    "vorder": 7,
    "position": 0,
    "text": "بسان بهشتی یکی سبز جای"
  },
  {
    "poem_id": 1775,
    "vorder": 8,
    "position": 1,
    "text": "ندید اندرو مردم و چارپای"
  },
  {
    "poem_id": 1775,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت کاین جای شیران بود"
  },
  {
    "poem_id": 1775,
    "vorder": 10,
    "position": 1,
    "text": "همان رزمگاه دلیران بود"
  },
  {
    "poem_id": 1775,
    "vorder": 11,
    "position": 0,
    "text": "کمان را به زه کرد مرد دلیر"
  },
  {
    "poem_id": 1775,
    "vorder": 12,
    "position": 1,
    "text": "پدید آمد اندر زمان نره شیر"
  },
  {
    "poem_id": 1775,
    "vorder": 13,
    "position": 0,
    "text": "یکی نعره زد شیر چون در رسید"
  },
  {
    "poem_id": 1775,
    "vorder": 14,
    "position": 1,
    "text": "بزد دست شاه و کمان درکشید"
  },
  {
    "poem_id": 1775,
    "vorder": 15,
    "position": 0,
    "text": "بزد تیر و پهلوش با دل بدوخت"
  },
  {
    "poem_id": 1775,
    "vorder": 16,
    "position": 1,
    "text": "دل شیر ماده بدوبر بسوخت"
  },
  {
    "poem_id": 1775,
    "vorder": 17,
    "position": 0,
    "text": "همان ماده آهنگ بهرام کرد"
  },
  {
    "poem_id": 1775,
    "vorder": 18,
    "position": 1,
    "text": "بغرید و چنگش به اندام کرد"
  },
  {
    "poem_id": 1775,
    "vorder": 19,
    "position": 0,
    "text": "یکی تیغ زد بر میانش سوار"
  },
  {
    "poem_id": 1775,
    "vorder": 20,
    "position": 1,
    "text": "فروماند جنگی دران کارزار"
  },
  {
    "poem_id": 1775,
    "vorder": 21,
    "position": 0,
    "text": "برون آمد از بیشه مردی کهن"
  },
  {
    "poem_id": 1775,
    "vorder": 22,
    "position": 1,
    "text": "زبانش گشاده به شیرین سخن"
  },
  {
    "poem_id": 1775,
    "vorder": 23,
    "position": 0,
    "text": "کجا نام او مهربنداد بود"
  },
  {
    "poem_id": 1775,
    "vorder": 24,
    "position": 1,
    "text": "ازان زخم شمشیر او شاد بود"
  },
  {
    "poem_id": 1775,
    "vorder": 25,
    "position": 0,
    "text": "یکی مرد دهقان یزدان‌پرست"
  },
  {
    "poem_id": 1775,
    "vorder": 26,
    "position": 1,
    "text": "بدان بیشه بودیش جای نشست"
  },
  {
    "poem_id": 1775,
    "vorder": 27,
    "position": 0,
    "text": "چو آمد بر شاه ایران فراز"
  },
  {
    "poem_id": 1775,
    "vorder": 28,
    "position": 1,
    "text": "برو آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1775,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت کای مهتر نامدار"
  },
  {
    "poem_id": 1775,
    "vorder": 30,
    "position": 1,
    "text": "به کام تو باد اختر روزگار"
  },
  {
    "poem_id": 1775,
    "vorder": 31,
    "position": 0,
    "text": "یکی مرد دهقانم ای پاک‌رای"
  },
  {
    "poem_id": 1775,
    "vorder": 32,
    "position": 1,
    "text": "خداوند این جا و کشت و سرای"
  },
  {
    "poem_id": 1775,
    "vorder": 33,
    "position": 0,
    "text": "خداوند گاو و خر و گوسفند"
  },
  {
    "poem_id": 1775,
    "vorder": 34,
    "position": 1,
    "text": "ز شیران شده بددل و مستمند"
  },
  {
    "poem_id": 1775,
    "vorder": 35,
    "position": 0,
    "text": "کنون ایزد این کار بر دست تو"
  },
  {
    "poem_id": 1775,
    "vorder": 36,
    "position": 1,
    "text": "برآورد بر قبضه و شست تو"
  },
  {
    "poem_id": 1775,
    "vorder": 37,
    "position": 0,
    "text": "زمانی درین بیشه آیی چنین"
  },
  {
    "poem_id": 1775,
    "vorder": 38,
    "position": 1,
    "text": "بباشی به شیر و می و انگبین"
  },
  {
    "poem_id": 1775,
    "vorder": 39,
    "position": 0,
    "text": "بره هست چندانک باید به کار"
  },
  {
    "poem_id": 1775,
    "vorder": 40,
    "position": 1,
    "text": "درختان بارآور و سایه‌دار"
  },
  {
    "poem_id": 1775,
    "vorder": 41,
    "position": 0,
    "text": "فرود آمد از باره بهرامشاه"
  },
  {
    "poem_id": 1775,
    "vorder": 42,
    "position": 1,
    "text": "همی کرد زان بیشه جایی نگاه"
  },
  {
    "poem_id": 1775,
    "vorder": 43,
    "position": 0,
    "text": "که باشد زمین سبز و آب روان"
  },
  {
    "poem_id": 1775,
    "vorder": 44,
    "position": 1,
    "text": "چنانچون بود جای مرد جوان"
  },
  {
    "poem_id": 1775,
    "vorder": 45,
    "position": 0,
    "text": "بشد مهربنداد و رامشگران"
  },
  {
    "poem_id": 1775,
    "vorder": 46,
    "position": 1,
    "text": "بیاورد چندی ز ده مهتران"
  },
  {
    "poem_id": 1775,
    "vorder": 47,
    "position": 0,
    "text": "بسی گوسفندان فربه بکشت"
  },
  {
    "poem_id": 1775,
    "vorder": 48,
    "position": 1,
    "text": "بیامد یکی جام زرین به مشت"
  },
  {
    "poem_id": 1775,
    "vorder": 49,
    "position": 0,
    "text": "چو نان خورده شد جامهای نبید"
  },
  {
    "poem_id": 1775,
    "vorder": 50,
    "position": 1,
    "text": "نهادند پیشش گل و شنبلید"
  },
  {
    "poem_id": 1775,
    "vorder": 51,
    "position": 0,
    "text": "چو شد مهربنداد شادان ز می"
  },
  {
    "poem_id": 1775,
    "vorder": 52,
    "position": 1,
    "text": "به بهرام گفت ای گو نیک‌پی"
  },
  {
    "poem_id": 1775,
    "vorder": 53,
    "position": 0,
    "text": "چنان دان که ماننده‌ای شاه را"
  },
  {
    "poem_id": 1775,
    "vorder": 54,
    "position": 1,
    "text": "همان تخت زرین و هم‌گاه را"
  },
  {
    "poem_id": 1775,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت بهرام کآری رواست"
  },
  {
    "poem_id": 1775,
    "vorder": 56,
    "position": 1,
    "text": "نگارنده بر چهرها پادشاست"
  },
  {
    "poem_id": 1775,
    "vorder": 57,
    "position": 0,
    "text": "چنان آفریند که خواهد همی"
  },
  {
    "poem_id": 1775,
    "vorder": 58,
    "position": 1,
    "text": "مر آن را گزیند که خواهد همی"
  },
  {
    "poem_id": 1775,
    "vorder": 59,
    "position": 0,
    "text": "اگر من همی نیک مانم به شاه"
  },
  {
    "poem_id": 1775,
    "vorder": 60,
    "position": 1,
    "text": "ترا دادم این بیشه و جایگاه"
  },
  {
    "poem_id": 1775,
    "vorder": 61,
    "position": 0,
    "text": "بگفت این و زان جایگه برنشست"
  },
  {
    "poem_id": 1775,
    "vorder": 62,
    "position": 1,
    "text": "به ایوان خرم خرامید مست"
  },
  {
    "poem_id": 1775,
    "vorder": 63,
    "position": 0,
    "text": "بخفت آن شب تیره در بوستان"
  },
  {
    "poem_id": 1775,
    "vorder": 64,
    "position": 1,
    "text": "همی یاد کرد از لب دوستان"
  }
]