[
  {
    "poem_id": 1841,
    "vorder": 1,
    "position": 0,
    "text": "چوخواهرش بشنید کامد ز راه"
  },
  {
    "poem_id": 1841,
    "vorder": 2,
    "position": 1,
    "text": "برادرش پر درد زان رزمگاه"
  },
  {
    "poem_id": 1841,
    "vorder": 3,
    "position": 0,
    "text": "بینداخت آن نامدار افسرش"
  },
  {
    "poem_id": 1841,
    "vorder": 4,
    "position": 1,
    "text": "بیاورد فرمانبری چادرش"
  },
  {
    "poem_id": 1841,
    "vorder": 5,
    "position": 0,
    "text": "بیامد بنزد برادر دمان"
  },
  {
    "poem_id": 1841,
    "vorder": 6,
    "position": 1,
    "text": "دلش خسته ازدرد و تیره روان"
  },
  {
    "poem_id": 1841,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت کای مهتر جنگجوی"
  },
  {
    "poem_id": 1841,
    "vorder": 8,
    "position": 1,
    "text": "چگونه شدی پیش خسرو بگوی"
  },
  {
    "poem_id": 1841,
    "vorder": 9,
    "position": 0,
    "text": "گر او ازجوانی شود تیزوتند"
  },
  {
    "poem_id": 1841,
    "vorder": 10,
    "position": 1,
    "text": "مگردان تو درآشتی رای کند"
  },
  {
    "poem_id": 1841,
    "vorder": 11,
    "position": 0,
    "text": "بخواهر چنین گفت بهرام گرد"
  },
  {
    "poem_id": 1841,
    "vorder": 12,
    "position": 1,
    "text": "که او را زشاهان نباید شمرد"
  },
  {
    "poem_id": 1841,
    "vorder": 13,
    "position": 0,
    "text": "نه جنگی سواری نه بخشنده‌ای"
  },
  {
    "poem_id": 1841,
    "vorder": 14,
    "position": 1,
    "text": "نه داناسری گر درخشنده‌ای"
  },
  {
    "poem_id": 1841,
    "vorder": 15,
    "position": 0,
    "text": "هنر بهتر از گوهر نامدار"
  },
  {
    "poem_id": 1841,
    "vorder": 16,
    "position": 1,
    "text": "هنرمند باید تن شهریار"
  },
  {
    "poem_id": 1841,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت داننده خواهر بدوی"
  },
  {
    "poem_id": 1841,
    "vorder": 18,
    "position": 1,
    "text": "که‌ای پرهنر مهتر نامجوی"
  },
  {
    "poem_id": 1841,
    "vorder": 19,
    "position": 0,
    "text": "تو را چند گویم سخن نشنوی"
  },
  {
    "poem_id": 1841,
    "vorder": 20,
    "position": 1,
    "text": "به پیش آوری تندی وبدخوی"
  },
  {
    "poem_id": 1841,
    "vorder": 21,
    "position": 0,
    "text": "نگر تاچه گوید سخن گوی بلخ"
  },
  {
    "poem_id": 1841,
    "vorder": 22,
    "position": 1,
    "text": "که باشد سخن گفتن راست تلخ"
  },
  {
    "poem_id": 1841,
    "vorder": 23,
    "position": 0,
    "text": "هرآنکس که آهوی تو باتوگفت"
  },
  {
    "poem_id": 1841,
    "vorder": 24,
    "position": 1,
    "text": "همه راستیها گشاد ازنهفت"
  },
  {
    "poem_id": 1841,
    "vorder": 25,
    "position": 0,
    "text": "مکن رای ویرانی شهر خویش"
  },
  {
    "poem_id": 1841,
    "vorder": 26,
    "position": 1,
    "text": "ز گیتی چو برداشتی بهرخویش"
  },
  {
    "poem_id": 1841,
    "vorder": 27,
    "position": 0,
    "text": "برین بریکی داستان زد کسی"
  },
  {
    "poem_id": 1841,
    "vorder": 28,
    "position": 1,
    "text": "کجا بهره بودش ز دانش بسی"
  },
  {
    "poem_id": 1841,
    "vorder": 29,
    "position": 0,
    "text": "که خر شد که خواهد زگاوان سروی"
  },
  {
    "poem_id": 1841,
    "vorder": 30,
    "position": 1,
    "text": "بیکباره گم کرد گوش وبروی"
  },
  {
    "poem_id": 1841,
    "vorder": 31,
    "position": 0,
    "text": "نکوهش مخواه از جهان سر به سر"
  },
  {
    "poem_id": 1841,
    "vorder": 32,
    "position": 1,
    "text": "نبود از تبارت کسی تاجور"
  },
  {
    "poem_id": 1841,
    "vorder": 33,
    "position": 0,
    "text": "اگر نیستی درمیان این جوان"
  },
  {
    "poem_id": 1841,
    "vorder": 34,
    "position": 1,
    "text": "نبودی من از داغ تیره روان"
  },
  {
    "poem_id": 1841,
    "vorder": 35,
    "position": 0,
    "text": "پدرزنده و تخت شاهی بجای"
  },
  {
    "poem_id": 1841,
    "vorder": 36,
    "position": 1,
    "text": "نهاده تو اندر میان پیش پای"
  },
  {
    "poem_id": 1841,
    "vorder": 37,
    "position": 0,
    "text": "ندانم سرانجام این چون بود"
  },
  {
    "poem_id": 1841,
    "vorder": 38,
    "position": 1,
    "text": "همیشه دو چشمم پر از خون بود"
  },
  {
    "poem_id": 1841,
    "vorder": 39,
    "position": 0,
    "text": "جز از درد و نفرین نجویی همی"
  },
  {
    "poem_id": 1841,
    "vorder": 40,
    "position": 1,
    "text": "گل زهر خیره ببویی همی"
  },
  {
    "poem_id": 1841,
    "vorder": 41,
    "position": 0,
    "text": "چو گویند چوبینه بدنام گشت"
  },
  {
    "poem_id": 1841,
    "vorder": 42,
    "position": 1,
    "text": "همه نام بهرام دشنام گشت"
  },
  {
    "poem_id": 1841,
    "vorder": 43,
    "position": 0,
    "text": "برین نیز هم خشم یزدان بود"
  },
  {
    "poem_id": 1841,
    "vorder": 44,
    "position": 1,
    "text": "روانت به دوزخ به زندان بود"
  },
  {
    "poem_id": 1841,
    "vorder": 45,
    "position": 0,
    "text": "نگر تا جز از هرمز شهریار"
  },
  {
    "poem_id": 1841,
    "vorder": 46,
    "position": 1,
    "text": "که بد درجهان مر تو را خواستار"
  },
  {
    "poem_id": 1841,
    "vorder": 47,
    "position": 0,
    "text": "هم آن تخت و آن کالهٔ ساوه شاه"
  },
  {
    "poem_id": 1841,
    "vorder": 48,
    "position": 1,
    "text": "بدست آمد و برنهادی کلاه"
  },
  {
    "poem_id": 1841,
    "vorder": 49,
    "position": 0,
    "text": "چو زو نامور گشتی اندر جهان"
  },
  {
    "poem_id": 1841,
    "vorder": 50,
    "position": 1,
    "text": "بجویی کنون گاه شاهنشهان"
  },
  {
    "poem_id": 1841,
    "vorder": 51,
    "position": 0,
    "text": "همه نیکوییها ز یزدان شناس"
  },
  {
    "poem_id": 1841,
    "vorder": 52,
    "position": 1,
    "text": "مباش اندرین تاجور ناسپاس"
  },
  {
    "poem_id": 1841,
    "vorder": 53,
    "position": 0,
    "text": "برزمی که کردی چنین کش مشو"
  },
  {
    "poem_id": 1841,
    "vorder": 54,
    "position": 1,
    "text": "هنرمند بودی منی فش مشو"
  },
  {
    "poem_id": 1841,
    "vorder": 55,
    "position": 0,
    "text": "به دل دیو را یار کردی همی"
  },
  {
    "poem_id": 1841,
    "vorder": 56,
    "position": 1,
    "text": "به یزدان گنهگار گردی همی"
  },
  {
    "poem_id": 1841,
    "vorder": 57,
    "position": 0,
    "text": "چو آشفته شد هرمز وبردمید"
  },
  {
    "poem_id": 1841,
    "vorder": 58,
    "position": 1,
    "text": "به گفتار آذرگشسپ پلید"
  },
  {
    "poem_id": 1841,
    "vorder": 59,
    "position": 0,
    "text": "تو را اندرین صبر بایست کرد"
  },
  {
    "poem_id": 1841,
    "vorder": 60,
    "position": 1,
    "text": "نبد بنده را روزگارنبرد"
  },
  {
    "poem_id": 1841,
    "vorder": 61,
    "position": 0,
    "text": "چو او را چنان سختی آمد بروی"
  },
  {
    "poem_id": 1841,
    "vorder": 62,
    "position": 1,
    "text": "ز بردع بیامد پسر کینه جوی"
  },
  {
    "poem_id": 1841,
    "vorder": 63,
    "position": 0,
    "text": "ببایست رفتن برشاه نو"
  },
  {
    "poem_id": 1841,
    "vorder": 64,
    "position": 1,
    "text": "بکام وی آراستن گاه نو"
  },
  {
    "poem_id": 1841,
    "vorder": 65,
    "position": 0,
    "text": "نکردی جوان جز برای تو کار"
  },
  {
    "poem_id": 1841,
    "vorder": 66,
    "position": 1,
    "text": "ندیدی دلت جز به روزگار"
  },
  {
    "poem_id": 1841,
    "vorder": 67,
    "position": 0,
    "text": "تن آسان بدی شاد وپیروزبخت"
  },
  {
    "poem_id": 1841,
    "vorder": 68,
    "position": 1,
    "text": "چراکردی آهنگ این تاج وتخت"
  },
  {
    "poem_id": 1841,
    "vorder": 69,
    "position": 0,
    "text": "تودانی که ازتخمهٔ اردشیر"
  },
  {
    "poem_id": 1841,
    "vorder": 70,
    "position": 1,
    "text": "بجایند شاهان برنا و پیر"
  },
  {
    "poem_id": 1841,
    "vorder": 71,
    "position": 0,
    "text": "ابا گنج وبا لشکر بی‌شمار"
  },
  {
    "poem_id": 1841,
    "vorder": 72,
    "position": 1,
    "text": "به ایران که خواند تو را شهریار"
  },
  {
    "poem_id": 1841,
    "vorder": 73,
    "position": 0,
    "text": "اگر شهریاری به گنج وسپاه"
  },
  {
    "poem_id": 1841,
    "vorder": 74,
    "position": 1,
    "text": "توانست کردن به ایران نگاه"
  },
  {
    "poem_id": 1841,
    "vorder": 75,
    "position": 0,
    "text": "نبودی جز از ساوه سالار چین"
  },
  {
    "poem_id": 1841,
    "vorder": 76,
    "position": 1,
    "text": "که آورد لشکر به ایران زمین"
  },
  {
    "poem_id": 1841,
    "vorder": 77,
    "position": 0,
    "text": "تو راپاک یزدان بروبرگماشت"
  },
  {
    "poem_id": 1841,
    "vorder": 78,
    "position": 1,
    "text": "بد او ز ایران و توران بگاشت"
  },
  {
    "poem_id": 1841,
    "vorder": 79,
    "position": 0,
    "text": "جهاندار تا این جهان آفرید"
  },
  {
    "poem_id": 1841,
    "vorder": 80,
    "position": 1,
    "text": "زمین کرد و هم آسمان آفرید"
  },
  {
    "poem_id": 1841,
    "vorder": 81,
    "position": 0,
    "text": "ندیدند هرگز سواری چوسام"
  },
  {
    "poem_id": 1841,
    "vorder": 82,
    "position": 1,
    "text": "نزد پیش او شیردرنده گام"
  },
  {
    "poem_id": 1841,
    "vorder": 83,
    "position": 0,
    "text": "چو نوذر شد از بخت بیدادگر"
  },
  {
    "poem_id": 1841,
    "vorder": 84,
    "position": 1,
    "text": "بپا اندر آورد رای‌پدر"
  },
  {
    "poem_id": 1841,
    "vorder": 85,
    "position": 0,
    "text": "همه مهتران سام را خواستند"
  },
  {
    "poem_id": 1841,
    "vorder": 86,
    "position": 1,
    "text": "همان تخت پیروزه آراستند"
  },
  {
    "poem_id": 1841,
    "vorder": 87,
    "position": 0,
    "text": "بران مهتران گفت هرگز مباد"
  },
  {
    "poem_id": 1841,
    "vorder": 88,
    "position": 1,
    "text": "که جان سپهبد کند تاج یاد"
  },
  {
    "poem_id": 1841,
    "vorder": 89,
    "position": 0,
    "text": "که خاک منوچهر گاه منست"
  },
  {
    "poem_id": 1841,
    "vorder": 90,
    "position": 1,
    "text": "سر تخت نوذر کلاه منست"
  },
  {
    "poem_id": 1841,
    "vorder": 91,
    "position": 0,
    "text": "بدان گفتم این ای برادر که تخت"
  },
  {
    "poem_id": 1841,
    "vorder": 92,
    "position": 1,
    "text": "نیابد مگر مرد پیروزبخت"
  },
  {
    "poem_id": 1841,
    "vorder": 93,
    "position": 0,
    "text": "که دارد کفی راد وفر ونژاد"
  },
  {
    "poem_id": 1841,
    "vorder": 94,
    "position": 1,
    "text": "خردمند و روشن دل و پر ز داد"
  },
  {
    "poem_id": 1841,
    "vorder": 95,
    "position": 0,
    "text": "ندانم که بر تو چه خواهد رسید"
  },
  {
    "poem_id": 1841,
    "vorder": 96,
    "position": 1,
    "text": "که اندر دلت شد خرد ناپدید"
  },
  {
    "poem_id": 1841,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت بهرام کاینست راست"
  },
  {
    "poem_id": 1841,
    "vorder": 98,
    "position": 1,
    "text": "برین راستی پاک یزدان گواست"
  },
  {
    "poem_id": 1841,
    "vorder": 99,
    "position": 0,
    "text": "ولیکن کنون کار ازین درگذشت"
  },
  {
    "poem_id": 1841,
    "vorder": 100,
    "position": 1,
    "text": "دل و مغز من پر ز تیمار گشت"
  },
  {
    "poem_id": 1841,
    "vorder": 101,
    "position": 0,
    "text": "اگر مه شوم گر نهم سر بمرگ"
  },
  {
    "poem_id": 1841,
    "vorder": 102,
    "position": 1,
    "text": "که مرگ اندر آید بپولاد ترگ"
  }
]