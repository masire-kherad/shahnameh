[
  {
    "poem_id": 87984,
    "vorder": 1,
    "position": 0,
    "text": "ز ترکان یکی بود بازور نام"
  },
  {
    "poem_id": 87984,
    "vorder": 2,
    "position": 1,
    "text": "بافسوس بهر جای گسترده کام"
  },
  {
    "poem_id": 87984,
    "vorder": 3,
    "position": 0,
    "text": "بیاموخته کژی و جادوی"
  },
  {
    "poem_id": 87984,
    "vorder": 4,
    "position": 1,
    "text": "بدانسته چینی و هم پهلوی"
  },
  {
    "poem_id": 87984,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت پیران بافسون پژوه"
  },
  {
    "poem_id": 87984,
    "vorder": 6,
    "position": 1,
    "text": "کز ایدر برو تا سر تیغ کوه"
  },
  {
    "poem_id": 87984,
    "vorder": 7,
    "position": 0,
    "text": "یکی برف و سرما و باد دمان"
  },
  {
    "poem_id": 87984,
    "vorder": 8,
    "position": 1,
    "text": "بریشان بیاور هم اندر زمان"
  },
  {
    "poem_id": 87984,
    "vorder": 9,
    "position": 0,
    "text": "هوا تیره‌گون بود از تیر ماه"
  },
  {
    "poem_id": 87984,
    "vorder": 10,
    "position": 1,
    "text": "همی گشت بر کوه ابر سیاه"
  },
  {
    "poem_id": 87984,
    "vorder": 11,
    "position": 0,
    "text": "چو بازور در کوه شد در زمان"
  },
  {
    "poem_id": 87984,
    "vorder": 12,
    "position": 1,
    "text": "برآمد یکی برف و باد دمان"
  },
  {
    "poem_id": 87984,
    "vorder": 13,
    "position": 0,
    "text": "همه دست آن نیزه‌داران ز کار"
  },
  {
    "poem_id": 87984,
    "vorder": 14,
    "position": 1,
    "text": "فروماند از برف در کارزار"
  },
  {
    "poem_id": 87984,
    "vorder": 15,
    "position": 0,
    "text": "ازان رستخیز و دم زمهریر"
  },
  {
    "poem_id": 87984,
    "vorder": 16,
    "position": 1,
    "text": "خروش یلان بود و باران تیر"
  },
  {
    "poem_id": 87984,
    "vorder": 17,
    "position": 0,
    "text": "بفرمود پیران که یکسر سپاه"
  },
  {
    "poem_id": 87984,
    "vorder": 18,
    "position": 1,
    "text": "یکی حمله سازید زین رزمگاه"
  },
  {
    "poem_id": 87984,
    "vorder": 19,
    "position": 0,
    "text": "چو بر نیزه بر دستهاشان فسرد"
  },
  {
    "poem_id": 87984,
    "vorder": 20,
    "position": 1,
    "text": "نیاراست بنمود کس دست برد"
  },
  {
    "poem_id": 87984,
    "vorder": 21,
    "position": 0,
    "text": "وزان پس برآورد هومان غریو"
  },
  {
    "poem_id": 87984,
    "vorder": 22,
    "position": 1,
    "text": "یکی حمله آورد برسان دیو"
  },
  {
    "poem_id": 87984,
    "vorder": 23,
    "position": 0,
    "text": "بکشتند چندان ز ایران سپاه"
  },
  {
    "poem_id": 87984,
    "vorder": 24,
    "position": 1,
    "text": "که دریای خون گشت آوردگاه"
  },
  {
    "poem_id": 87984,
    "vorder": 25,
    "position": 0,
    "text": "در و دشت گشته پر از برف و خون"
  },
  {
    "poem_id": 87984,
    "vorder": 26,
    "position": 1,
    "text": "سواران ایران فتاده نگون"
  },
  {
    "poem_id": 87984,
    "vorder": 27,
    "position": 0,
    "text": "ز کشته نبد جای رفتن بجنگ"
  },
  {
    "poem_id": 87984,
    "vorder": 28,
    "position": 1,
    "text": "ز برف و ز افگنده شد جای تنگ"
  },
  {
    "poem_id": 87984,
    "vorder": 29,
    "position": 0,
    "text": "سیه گشت در دشت شمشیر و دست"
  },
  {
    "poem_id": 87984,
    "vorder": 30,
    "position": 1,
    "text": "بروی اندر افتاده برسان مست"
  },
  {
    "poem_id": 87984,
    "vorder": 31,
    "position": 0,
    "text": "نبد جای گردش دران رزمگاه"
  },
  {
    "poem_id": 87984,
    "vorder": 32,
    "position": 1,
    "text": "شده دست لشکر ز سرما تباه"
  },
  {
    "poem_id": 87984,
    "vorder": 33,
    "position": 0,
    "text": "سپهدار و گردنکشان آن زمان"
  },
  {
    "poem_id": 87984,
    "vorder": 34,
    "position": 1,
    "text": "گرفتند زاری سوی آسمان"
  },
  {
    "poem_id": 87984,
    "vorder": 35,
    "position": 0,
    "text": "که ای برتر از دانش و هوش و رای"
  },
  {
    "poem_id": 87984,
    "vorder": 36,
    "position": 1,
    "text": "نه در جای و بر جای و نه زیر جای"
  },
  {
    "poem_id": 87984,
    "vorder": 37,
    "position": 0,
    "text": "همه بندهٔ پرگناه توایم"
  },
  {
    "poem_id": 87984,
    "vorder": 38,
    "position": 1,
    "text": "به بیچارگی دادخواه توایم"
  },
  {
    "poem_id": 87984,
    "vorder": 39,
    "position": 0,
    "text": "ز افسون و از جادوی برتری"
  },
  {
    "poem_id": 87984,
    "vorder": 40,
    "position": 1,
    "text": "جهاندار و بر داوران داوری"
  },
  {
    "poem_id": 87984,
    "vorder": 41,
    "position": 0,
    "text": "تو باشی به بیچارگی دستگیر"
  },
  {
    "poem_id": 87984,
    "vorder": 42,
    "position": 1,
    "text": "تواناتر از آتش و زمهریر"
  },
  {
    "poem_id": 87984,
    "vorder": 43,
    "position": 0,
    "text": "ازین برف و سرما تو فریادرس"
  },
  {
    "poem_id": 87984,
    "vorder": 44,
    "position": 1,
    "text": "نداریم فریادرس جز تو کس"
  },
  {
    "poem_id": 87984,
    "vorder": 45,
    "position": 0,
    "text": "بیامد یکی مرد دانش پژوه"
  },
  {
    "poem_id": 87984,
    "vorder": 46,
    "position": 1,
    "text": "برهام بنمود آن تیغ کوه"
  },
  {
    "poem_id": 87984,
    "vorder": 47,
    "position": 0,
    "text": "کجا جای بازور نستوه بود"
  },
  {
    "poem_id": 87984,
    "vorder": 48,
    "position": 1,
    "text": "بر افسون و تنبل بران کوه بود"
  },
  {
    "poem_id": 87984,
    "vorder": 49,
    "position": 0,
    "text": "بجنبید رهام زان رزمگاه"
  },
  {
    "poem_id": 87984,
    "vorder": 50,
    "position": 1,
    "text": "برون تاخت اسپ از میان سپاه"
  },
  {
    "poem_id": 87984,
    "vorder": 51,
    "position": 0,
    "text": "زره دامنش را بزد بر کمر"
  },
  {
    "poem_id": 87984,
    "vorder": 52,
    "position": 1,
    "text": "پیاده برآمد بران کوه سر"
  },
  {
    "poem_id": 87984,
    "vorder": 53,
    "position": 0,
    "text": "چو جادو بدیدش بیامد بجنگ"
  },
  {
    "poem_id": 87984,
    "vorder": 54,
    "position": 1,
    "text": "عمودی ز پولاد چینی بچنگ"
  },
  {
    "poem_id": 87984,
    "vorder": 55,
    "position": 0,
    "text": "چو رهام نزدیک جادو رسید"
  },
  {
    "poem_id": 87984,
    "vorder": 56,
    "position": 1,
    "text": "سبک تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 87984,
    "vorder": 57,
    "position": 0,
    "text": "بیفگند دستش بشمشیر تیز"
  },
  {
    "poem_id": 87984,
    "vorder": 58,
    "position": 1,
    "text": "یکی باد برخاست چون رستخیز"
  },
  {
    "poem_id": 87984,
    "vorder": 59,
    "position": 0,
    "text": "ز روی هوا ابر تیره ببرد"
  },
  {
    "poem_id": 87984,
    "vorder": 60,
    "position": 1,
    "text": "فرود آمد از کوه رهام گرد"
  },
  {
    "poem_id": 87984,
    "vorder": 61,
    "position": 0,
    "text": "یکی دست با زور جادو بدست"
  },
  {
    "poem_id": 87984,
    "vorder": 62,
    "position": 1,
    "text": "بهامون شد و بارگی برنشست"
  },
  {
    "poem_id": 87984,
    "vorder": 63,
    "position": 0,
    "text": "هوا گشت زان سان که از پیش بود"
  },
  {
    "poem_id": 87984,
    "vorder": 64,
    "position": 1,
    "text": "فروزنده خورشید را رخ نمود"
  },
  {
    "poem_id": 87984,
    "vorder": 65,
    "position": 0,
    "text": "پدر را بگفت آنچ جادو چه کرد"
  },
  {
    "poem_id": 87984,
    "vorder": 66,
    "position": 1,
    "text": "چه آورد بر ما بروز نبرد"
  },
  {
    "poem_id": 87984,
    "vorder": 67,
    "position": 0,
    "text": "بدیدند ازان پس دلیران شاه"
  },
  {
    "poem_id": 87984,
    "vorder": 68,
    "position": 1,
    "text": "چو دریای خون گشته آوردگاه"
  },
  {
    "poem_id": 87984,
    "vorder": 69,
    "position": 0,
    "text": "همه دشت کشته ز ایرانیان"
  },
  {
    "poem_id": 87984,
    "vorder": 70,
    "position": 1,
    "text": "تن بی‌سران سر بی‌تنان"
  },
  {
    "poem_id": 87984,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت گودز آنگه بطوس"
  },
  {
    "poem_id": 87984,
    "vorder": 72,
    "position": 1,
    "text": "که نه پیل ماند و نه آوای کوس"
  },
  {
    "poem_id": 87984,
    "vorder": 73,
    "position": 0,
    "text": "همه یکسره تیغها برکشیم"
  },
  {
    "poem_id": 87984,
    "vorder": 74,
    "position": 1,
    "text": "براریم جوش ار کشند ار کشیم"
  },
  {
    "poem_id": 87984,
    "vorder": 75,
    "position": 0,
    "text": "همانا که ما را سر آمد زمان"
  },
  {
    "poem_id": 87984,
    "vorder": 76,
    "position": 1,
    "text": "نه روز نبردست و تیر و کمان"
  },
  {
    "poem_id": 87984,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت طوس ای جهاندیده مرد"
  },
  {
    "poem_id": 87984,
    "vorder": 78,
    "position": 1,
    "text": "هوا گشت پاک و بشد باد سرد"
  },
  {
    "poem_id": 87984,
    "vorder": 79,
    "position": 0,
    "text": "چرا سر همی داد باید بباد"
  },
  {
    "poem_id": 87984,
    "vorder": 80,
    "position": 1,
    "text": "چو فریادرس فره و زور داد"
  },
  {
    "poem_id": 87984,
    "vorder": 81,
    "position": 0,
    "text": "مکن پیشدستی تو در جنگ ما"
  },
  {
    "poem_id": 87984,
    "vorder": 82,
    "position": 1,
    "text": "کنند این دلیران خود اهنگ ما"
  },
  {
    "poem_id": 87984,
    "vorder": 83,
    "position": 0,
    "text": "بپیش زمانه پذیره مشو"
  },
  {
    "poem_id": 87984,
    "vorder": 84,
    "position": 1,
    "text": "بنزدیک بدخواه خیره مشو"
  },
  {
    "poem_id": 87984,
    "vorder": 85,
    "position": 0,
    "text": "تو در قلب با کاویانی درفش"
  },
  {
    "poem_id": 87984,
    "vorder": 86,
    "position": 1,
    "text": "همی دار در چنگ تیغ بنفش"
  },
  {
    "poem_id": 87984,
    "vorder": 87,
    "position": 0,
    "text": "سوی میمنه گیو و بیژن بهم"
  },
  {
    "poem_id": 87984,
    "vorder": 88,
    "position": 1,
    "text": "نگهبانش بر میسره گستهم"
  },
  {
    "poem_id": 87984,
    "vorder": 89,
    "position": 0,
    "text": "چو رهام و شیدوش بر پیش صف"
  },
  {
    "poem_id": 87984,
    "vorder": 90,
    "position": 1,
    "text": "گرازه بکین برلب آورده کف"
  },
  {
    "poem_id": 87984,
    "vorder": 91,
    "position": 0,
    "text": "شوم برکشم گرز کین از میان"
  },
  {
    "poem_id": 87984,
    "vorder": 92,
    "position": 1,
    "text": "کنم تن فدی پیش ایرانیان"
  },
  {
    "poem_id": 87984,
    "vorder": 93,
    "position": 0,
    "text": "ازین رزمگه برنگردانم اسپ"
  },
  {
    "poem_id": 87984,
    "vorder": 94,
    "position": 1,
    "text": "مگر خاک جایم بود چون زرسپ"
  },
  {
    "poem_id": 87984,
    "vorder": 95,
    "position": 0,
    "text": "اگر من شوم کشته زین رزمگاه"
  },
  {
    "poem_id": 87984,
    "vorder": 96,
    "position": 1,
    "text": "تو برکش سوی شاه ایران سپاه"
  },
  {
    "poem_id": 87984,
    "vorder": 97,
    "position": 0,
    "text": "مرا مرگ نامی‌تر از سرزنش"
  },
  {
    "poem_id": 87984,
    "vorder": 98,
    "position": 1,
    "text": "بهر جای بیغارهٔ بدکنش"
  },
  {
    "poem_id": 87984,
    "vorder": 99,
    "position": 0,
    "text": "چنین است گیتی پرآزار و درد"
  },
  {
    "poem_id": 87984,
    "vorder": 100,
    "position": 1,
    "text": "ازو تا توان گرد بیشی مگرد"
  },
  {
    "poem_id": 87984,
    "vorder": 101,
    "position": 0,
    "text": "فزونیش یک روز بگزایدت"
  },
  {
    "poem_id": 87984,
    "vorder": 102,
    "position": 1,
    "text": "ببودن زمانی نیفزایدت"
  },
  {
    "poem_id": 87984,
    "vorder": 103,
    "position": 0,
    "text": "دگر باره بر شد دم کرنای"
  },
  {
    "poem_id": 87984,
    "vorder": 104,
    "position": 1,
    "text": "خروشیدن زنگ و هندی درای"
  },
  {
    "poem_id": 87984,
    "vorder": 105,
    "position": 0,
    "text": "ز بانگ سواران پرخاشخر"
  },
  {
    "poem_id": 87984,
    "vorder": 106,
    "position": 1,
    "text": "درخشیدن تیغ و زخم تبر"
  },
  {
    "poem_id": 87984,
    "vorder": 107,
    "position": 0,
    "text": "ز پیکان و از گرز و ژوپین و تیر"
  },
  {
    "poem_id": 87984,
    "vorder": 108,
    "position": 1,
    "text": "زمین شد بکردار دریای قیر"
  },
  {
    "poem_id": 87984,
    "vorder": 109,
    "position": 0,
    "text": "همه دشت بی‌تن سر و یال بود"
  },
  {
    "poem_id": 87984,
    "vorder": 110,
    "position": 1,
    "text": "همه گوش پر زخم گوپال بود"
  },
  {
    "poem_id": 87984,
    "vorder": 111,
    "position": 0,
    "text": "چو شد رزم ترکان برین گونه سخت"
  },
  {
    "poem_id": 87984,
    "vorder": 112,
    "position": 1,
    "text": "ندیدند ایرانیان روی بخت"
  },
  {
    "poem_id": 87984,
    "vorder": 113,
    "position": 0,
    "text": "همی تیره شد روی اختر درشت"
  },
  {
    "poem_id": 87984,
    "vorder": 114,
    "position": 1,
    "text": "دلیران بدشمن نمودند پشت"
  },
  {
    "poem_id": 87984,
    "vorder": 115,
    "position": 0,
    "text": "چو طوس و چو گودرز و گیو دلیر"
  },
  {
    "poem_id": 87984,
    "vorder": 116,
    "position": 1,
    "text": "چو شیدوش و بیژن چو رهام شیر"
  },
  {
    "poem_id": 87984,
    "vorder": 117,
    "position": 0,
    "text": "همه برنهادند جان را بکف"
  },
  {
    "poem_id": 87984,
    "vorder": 118,
    "position": 1,
    "text": "همه رزم جستند بر پیش صف"
  },
  {
    "poem_id": 87984,
    "vorder": 119,
    "position": 0,
    "text": "هرآنکس که با طوس در جنگ بود"
  },
  {
    "poem_id": 87984,
    "vorder": 120,
    "position": 1,
    "text": "همه نامدار و کنارنگ بود"
  },
  {
    "poem_id": 87984,
    "vorder": 121,
    "position": 0,
    "text": "بپیش اندرون خون همی ریختند"
  },
  {
    "poem_id": 87984,
    "vorder": 122,
    "position": 1,
    "text": "یلان از پس پشت بگریختند"
  },
  {
    "poem_id": 87984,
    "vorder": 123,
    "position": 0,
    "text": "یکی موبدی طوس یل را بخواند"
  },
  {
    "poem_id": 87984,
    "vorder": 124,
    "position": 1,
    "text": "پس پشت تو گفت جنگی نماند"
  },
  {
    "poem_id": 87984,
    "vorder": 125,
    "position": 0,
    "text": "نباید کت اندر میان آورند"
  },
  {
    "poem_id": 87984,
    "vorder": 126,
    "position": 1,
    "text": "بجان سپهبد زیان آورند"
  },
  {
    "poem_id": 87984,
    "vorder": 127,
    "position": 0,
    "text": "به گیو دلیر آن زمان طوس گفت"
  },
  {
    "poem_id": 87984,
    "vorder": 128,
    "position": 1,
    "text": "که با مغز لشکر خرد نیست جفت"
  },
  {
    "poem_id": 87984,
    "vorder": 129,
    "position": 0,
    "text": "که ما را بدین گونه بگذاشتند"
  },
  {
    "poem_id": 87984,
    "vorder": 130,
    "position": 1,
    "text": "چنین روی از جنگ برگاشتند"
  },
  {
    "poem_id": 87984,
    "vorder": 131,
    "position": 0,
    "text": "برو بازگردان سپه را ز راه"
  },
  {
    "poem_id": 87984,
    "vorder": 132,
    "position": 1,
    "text": "ز بیغارهٔ دشمن و شرم شاه"
  },
  {
    "poem_id": 87984,
    "vorder": 133,
    "position": 0,
    "text": "بشد گیو و لشکر همه بازگشت"
  },
  {
    "poem_id": 87984,
    "vorder": 134,
    "position": 1,
    "text": "پر از کشته دیدند هامون و دشت"
  },
  {
    "poem_id": 87984,
    "vorder": 135,
    "position": 0,
    "text": "سپهبد چنین گفت با مهتران"
  },
  {
    "poem_id": 87984,
    "vorder": 136,
    "position": 1,
    "text": "که اینست پیکار جنگ‌آوران"
  },
  {
    "poem_id": 87984,
    "vorder": 137,
    "position": 0,
    "text": "کنون چون رخ روز شد تیره‌گون"
  },
  {
    "poem_id": 87984,
    "vorder": 138,
    "position": 1,
    "text": "همه روی کشور چو دریای خون"
  },
  {
    "poem_id": 87984,
    "vorder": 139,
    "position": 0,
    "text": "یکی جای آرام باید گزید"
  },
  {
    "poem_id": 87984,
    "vorder": 140,
    "position": 1,
    "text": "اگر تیره شب خود توان آرمید"
  },
  {
    "poem_id": 87984,
    "vorder": 141,
    "position": 0,
    "text": "مگر کشته یابد بجای مغاک"
  },
  {
    "poem_id": 87984,
    "vorder": 142,
    "position": 1,
    "text": "یکی بستر از ریگ و چادر ز خاک"
  },
  {
    "poem_id": 87984,
    "vorder": 143,
    "position": 0,
    "text": "همه بازگشتند یکسر ز جنگ"
  },
  {
    "poem_id": 87984,
    "vorder": 144,
    "position": 1,
    "text": "ز خویشان روان خسته و سر ز ننگ"
  },
  {
    "poem_id": 87984,
    "vorder": 145,
    "position": 0,
    "text": "سر از کوه برزد همانگاه ماه"
  },
  {
    "poem_id": 87984,
    "vorder": 146,
    "position": 1,
    "text": "چو بر تخت پیروزه، پیروز شاه"
  },
  {
    "poem_id": 87984,
    "vorder": 147,
    "position": 0,
    "text": "سپهدار پیران سپه را بخواند"
  },
  {
    "poem_id": 87984,
    "vorder": 148,
    "position": 1,
    "text": "همی گفت زیشان فراوان نماند"
  },
  {
    "poem_id": 87984,
    "vorder": 149,
    "position": 0,
    "text": "بدانگه که دریای یاقوت زرد"
  },
  {
    "poem_id": 87984,
    "vorder": 150,
    "position": 1,
    "text": "زند موج بر کشور لاژورد"
  },
  {
    "poem_id": 87984,
    "vorder": 151,
    "position": 0,
    "text": "کسی را که زنده‌ست بیجان کنیم"
  },
  {
    "poem_id": 87984,
    "vorder": 152,
    "position": 1,
    "text": "بریشان دل شاه پیچان کنیم"
  },
  {
    "poem_id": 87984,
    "vorder": 153,
    "position": 0,
    "text": "برفتند با شادمانی زجای"
  },
  {
    "poem_id": 87984,
    "vorder": 154,
    "position": 1,
    "text": "نشستند بر پیش پرده‌سرای"
  },
  {
    "poem_id": 87984,
    "vorder": 155,
    "position": 0,
    "text": "همه شب ز آوای چنگ و رباب"
  },
  {
    "poem_id": 87984,
    "vorder": 156,
    "position": 1,
    "text": "سپه را نیامد بران دشت خواب"
  },
  {
    "poem_id": 87984,
    "vorder": 157,
    "position": 0,
    "text": "وزین روی لشکر همه مستمند"
  },
  {
    "poem_id": 87984,
    "vorder": 158,
    "position": 1,
    "text": "پدر بر پسر سوگوار و نژند"
  },
  {
    "poem_id": 87984,
    "vorder": 159,
    "position": 0,
    "text": "همه دشت پر کشته و خسته بود"
  },
  {
    "poem_id": 87984,
    "vorder": 160,
    "position": 1,
    "text": "بخون بزرگان زمین شسته بود"
  },
  {
    "poem_id": 87984,
    "vorder": 161,
    "position": 0,
    "text": "چپ و راست آوردگه دست و پای"
  },
  {
    "poem_id": 87984,
    "vorder": 162,
    "position": 1,
    "text": "نهادن ندانست کس پا بجای"
  },
  {
    "poem_id": 87984,
    "vorder": 163,
    "position": 0,
    "text": "همه شب همی خسته برداشتند"
  },
  {
    "poem_id": 87984,
    "vorder": 164,
    "position": 1,
    "text": "چو بیگانه بد خوار بگذاشتند"
  },
  {
    "poem_id": 87984,
    "vorder": 165,
    "position": 0,
    "text": "بر خسته آتش همی سوختند"
  },
  {
    "poem_id": 87984,
    "vorder": 166,
    "position": 1,
    "text": "گسسته ببستند و بردوختند"
  },
  {
    "poem_id": 87984,
    "vorder": 167,
    "position": 0,
    "text": "فراوان ز گودرزیان خسته بود"
  },
  {
    "poem_id": 87984,
    "vorder": 168,
    "position": 1,
    "text": "بسی کشته بود و بسی بسته بود"
  },
  {
    "poem_id": 87984,
    "vorder": 169,
    "position": 0,
    "text": "چو بشنید گودرز برزد خروش"
  },
  {
    "poem_id": 87984,
    "vorder": 170,
    "position": 1,
    "text": "زمین آمد از بانگ اسپان بجوش"
  },
  {
    "poem_id": 87984,
    "vorder": 171,
    "position": 0,
    "text": "همه مهتران جامه کردند چاک"
  },
  {
    "poem_id": 87984,
    "vorder": 172,
    "position": 1,
    "text": "بسربر پراگند گودرز خاک"
  },
  {
    "poem_id": 87984,
    "vorder": 173,
    "position": 0,
    "text": "همی گفت کاندر جهان کس ندید"
  },
  {
    "poem_id": 87984,
    "vorder": 174,
    "position": 1,
    "text": "به پیران سر این بد که بر من رسید"
  },
  {
    "poem_id": 87984,
    "vorder": 175,
    "position": 0,
    "text": "چرا بایدم زنده با پیر سر"
  },
  {
    "poem_id": 87984,
    "vorder": 176,
    "position": 1,
    "text": "بخاک اندر افگنده چندین پسر"
  },
  {
    "poem_id": 87984,
    "vorder": 177,
    "position": 0,
    "text": "ازان روزگاری کجا زاده‌ام"
  },
  {
    "poem_id": 87984,
    "vorder": 178,
    "position": 1,
    "text": "ز خفتان میان هیچ نگشاده‌ام"
  },
  {
    "poem_id": 87984,
    "vorder": 179,
    "position": 0,
    "text": "بفرجام چندین پسر ز انجمن"
  },
  {
    "poem_id": 87984,
    "vorder": 180,
    "position": 1,
    "text": "ببینم چنین کشته در پیش من"
  },
  {
    "poem_id": 87984,
    "vorder": 181,
    "position": 0,
    "text": "جدا گشته از من چو بهرام پور"
  },
  {
    "poem_id": 87984,
    "vorder": 182,
    "position": 1,
    "text": "چنان نامور شیر خودکام پور"
  },
  {
    "poem_id": 87984,
    "vorder": 183,
    "position": 0,
    "text": "ز گودرز چون آگهی شد بطوس"
  },
  {
    "poem_id": 87984,
    "vorder": 184,
    "position": 1,
    "text": "مژه کرد پر خون و رخ سندروس"
  },
  {
    "poem_id": 87984,
    "vorder": 185,
    "position": 0,
    "text": "خروشی براورد آنگه بزار"
  },
  {
    "poem_id": 87984,
    "vorder": 186,
    "position": 1,
    "text": "فراوان ببارید خون در کنار"
  },
  {
    "poem_id": 87984,
    "vorder": 187,
    "position": 0,
    "text": "همی گفت اگر نوذر پاک‌تن"
  },
  {
    "poem_id": 87984,
    "vorder": 188,
    "position": 1,
    "text": "نکشتی بن و بیخ من بر چمن"
  },
  {
    "poem_id": 87984,
    "vorder": 189,
    "position": 0,
    "text": "نبودی مرا رنج و تیمار و درد"
  },
  {
    "poem_id": 87984,
    "vorder": 190,
    "position": 1,
    "text": "غم کشته و گرم دشت نبرد"
  },
  {
    "poem_id": 87984,
    "vorder": 191,
    "position": 0,
    "text": "که تا من کمر بر میان بسته‌ام"
  },
  {
    "poem_id": 87984,
    "vorder": 192,
    "position": 1,
    "text": "بدل خسته‌ام گر بجان رسته‌ام"
  },
  {
    "poem_id": 87984,
    "vorder": 193,
    "position": 0,
    "text": "هم‌اکنون تن کشتگان را بخاک"
  },
  {
    "poem_id": 87984,
    "vorder": 194,
    "position": 1,
    "text": "بپوشید جایی که باشد مغاک"
  },
  {
    "poem_id": 87984,
    "vorder": 195,
    "position": 0,
    "text": "سران بریده سوی تن برید"
  },
  {
    "poem_id": 87984,
    "vorder": 196,
    "position": 1,
    "text": "بنه سوی کوه هماون برید"
  },
  {
    "poem_id": 87984,
    "vorder": 197,
    "position": 0,
    "text": "برانیم لشکر همه همگروه"
  },
  {
    "poem_id": 87984,
    "vorder": 198,
    "position": 1,
    "text": "سراپرده و خیمه بر سوی کوه"
  },
  {
    "poem_id": 87984,
    "vorder": 199,
    "position": 0,
    "text": "هیونی فرستیم نزدیک شاه"
  },
  {
    "poem_id": 87984,
    "vorder": 200,
    "position": 1,
    "text": "دلش برفروزد فرستد سپاه"
  },
  {
    "poem_id": 87984,
    "vorder": 201,
    "position": 0,
    "text": "بدین من سواری فرستاده‌ام"
  },
  {
    "poem_id": 87984,
    "vorder": 202,
    "position": 1,
    "text": "ورا پیش ازین آگهی داده‌ام"
  },
  {
    "poem_id": 87984,
    "vorder": 203,
    "position": 0,
    "text": "مگر رستم زال را با سپاه"
  },
  {
    "poem_id": 87984,
    "vorder": 204,
    "position": 1,
    "text": "سوی ما فرستد بدین رزمگاه"
  },
  {
    "poem_id": 87984,
    "vorder": 205,
    "position": 0,
    "text": "وگرنه ز ما نامداری دلیر"
  },
  {
    "poem_id": 87984,
    "vorder": 206,
    "position": 1,
    "text": "نماند به آوردگه بر چو شیر"
  }
]