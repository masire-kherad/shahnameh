[
  {
    "poem_id": 1624,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه بازگشتند شاد"
  },
  {
    "poem_id": 1624,
    "vorder": 2,
    "position": 1,
    "text": "پسندیده داراب با رشنواد"
  },
  {
    "poem_id": 1624,
    "vorder": 3,
    "position": 0,
    "text": "به منزل بران طاق ویران رسید"
  },
  {
    "poem_id": 1624,
    "vorder": 4,
    "position": 1,
    "text": "که داراب را اندرو خفته دید"
  },
  {
    "poem_id": 1624,
    "vorder": 5,
    "position": 0,
    "text": "زن گازر و شوی و گوهر بهم"
  },
  {
    "poem_id": 1624,
    "vorder": 6,
    "position": 1,
    "text": "شده هر دو از بیم خواری دژم"
  },
  {
    "poem_id": 1624,
    "vorder": 7,
    "position": 0,
    "text": "از آنکس کشان خواند از جای خویش"
  },
  {
    "poem_id": 1624,
    "vorder": 8,
    "position": 1,
    "text": "به یزدان پناهید و رفتند پیش"
  },
  {
    "poem_id": 1624,
    "vorder": 9,
    "position": 0,
    "text": "چو دید آن زن و شوی را رشنواد"
  },
  {
    "poem_id": 1624,
    "vorder": 10,
    "position": 1,
    "text": "ز هر گونه پرسید و کردند یاد"
  },
  {
    "poem_id": 1624,
    "vorder": 11,
    "position": 0,
    "text": "بگفتند با او سخن هرچ بود"
  },
  {
    "poem_id": 1624,
    "vorder": 12,
    "position": 1,
    "text": "ز صندوق وز گوهر نابسود"
  },
  {
    "poem_id": 1624,
    "vorder": 13,
    "position": 0,
    "text": "ز رنج و ز پروردن شیرخوار"
  },
  {
    "poem_id": 1624,
    "vorder": 14,
    "position": 1,
    "text": "ز تیمار وز گردش روزگار"
  },
  {
    "poem_id": 1624,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت با شوی و زن رشنواد"
  },
  {
    "poem_id": 1624,
    "vorder": 16,
    "position": 1,
    "text": "که پیروز باشید همواره شاد"
  },
  {
    "poem_id": 1624,
    "vorder": 17,
    "position": 0,
    "text": "که کس در جهان این شگفتی ندید"
  },
  {
    "poem_id": 1624,
    "vorder": 18,
    "position": 1,
    "text": "نه از موبد پیر هرگز شنید"
  },
  {
    "poem_id": 1624,
    "vorder": 19,
    "position": 0,
    "text": "هم‌اندر زمان مرد پاکیزه‌رای"
  },
  {
    "poem_id": 1624,
    "vorder": 20,
    "position": 1,
    "text": "یکی نامه بنوشت نزد همای"
  },
  {
    "poem_id": 1624,
    "vorder": 21,
    "position": 0,
    "text": "ز داراب وز خواب و آرامگاه"
  },
  {
    "poem_id": 1624,
    "vorder": 22,
    "position": 1,
    "text": "هم از جنگ او اندران رزمگاه"
  },
  {
    "poem_id": 1624,
    "vorder": 23,
    "position": 0,
    "text": "وزان کو به اسپ اندر آورد پای"
  },
  {
    "poem_id": 1624,
    "vorder": 24,
    "position": 1,
    "text": "هم‌انگاه طاق اندر آمد ز جای"
  },
  {
    "poem_id": 1624,
    "vorder": 25,
    "position": 0,
    "text": "از آواز که آمد مر او را به گوش"
  },
  {
    "poem_id": 1624,
    "vorder": 26,
    "position": 1,
    "text": "ز تنگی که شد رشنواد از خروش"
  },
  {
    "poem_id": 1624,
    "vorder": 27,
    "position": 0,
    "text": "ز گازر سخن هرچ بشنید نیز"
  },
  {
    "poem_id": 1624,
    "vorder": 28,
    "position": 1,
    "text": "ز صندوق وز کودک خرد و چیز"
  },
  {
    "poem_id": 1624,
    "vorder": 29,
    "position": 0,
    "text": "به نامه درون سربسر یاد کرد"
  },
  {
    "poem_id": 1624,
    "vorder": 30,
    "position": 1,
    "text": "برون کرد آنگه هیونی چو گرد"
  },
  {
    "poem_id": 1624,
    "vorder": 31,
    "position": 0,
    "text": "همان سرخ گوهر بدو داد و گفت"
  },
  {
    "poem_id": 1624,
    "vorder": 32,
    "position": 1,
    "text": "که با باد باید که گردی تو جفت"
  },
  {
    "poem_id": 1624,
    "vorder": 33,
    "position": 0,
    "text": "فرستاده تازان بیامد ز جای"
  },
  {
    "poem_id": 1624,
    "vorder": 34,
    "position": 1,
    "text": "بیاورد یاقوت نزد همای"
  },
  {
    "poem_id": 1624,
    "vorder": 35,
    "position": 0,
    "text": "به شاه جهاندار نامه بداد"
  },
  {
    "poem_id": 1624,
    "vorder": 36,
    "position": 1,
    "text": "شنیده بگفت از لب رشنواد"
  },
  {
    "poem_id": 1624,
    "vorder": 37,
    "position": 0,
    "text": "چو آن نامه برخواند و یاقوت دید"
  },
  {
    "poem_id": 1624,
    "vorder": 38,
    "position": 1,
    "text": "سرشکش ز مژگان به رخ بر چکید"
  },
  {
    "poem_id": 1624,
    "vorder": 39,
    "position": 0,
    "text": "بدانست کان روز کامد به دشت"
  },
  {
    "poem_id": 1624,
    "vorder": 40,
    "position": 1,
    "text": "بفرمود تا پیش لشکر گذشت"
  },
  {
    "poem_id": 1624,
    "vorder": 41,
    "position": 0,
    "text": "بدید آن جوانی که بد فرمند"
  },
  {
    "poem_id": 1624,
    "vorder": 42,
    "position": 1,
    "text": "به رخ چون بهار و به بالا بلند"
  },
  {
    "poem_id": 1624,
    "vorder": 43,
    "position": 0,
    "text": "نبودست جز پاک فرزند اوی"
  },
  {
    "poem_id": 1624,
    "vorder": 44,
    "position": 1,
    "text": "گرانمایه شاخ برومند اوی"
  },
  {
    "poem_id": 1624,
    "vorder": 45,
    "position": 0,
    "text": "فرستاده را گفت گریان همای"
  },
  {
    "poem_id": 1624,
    "vorder": 46,
    "position": 1,
    "text": "که آمد جهان را یکی کدخدای"
  },
  {
    "poem_id": 1624,
    "vorder": 47,
    "position": 0,
    "text": "نبود ایچ ز ا ندیشه مغزم تهی"
  },
  {
    "poem_id": 1624,
    "vorder": 48,
    "position": 1,
    "text": "پر از درد بودم ز شاهنشهی"
  },
  {
    "poem_id": 1624,
    "vorder": 49,
    "position": 0,
    "text": "ز دادار گیهان دلم پرهراس"
  },
  {
    "poem_id": 1624,
    "vorder": 50,
    "position": 1,
    "text": "کجا گشته بودم ازو ناسپاس"
  },
  {
    "poem_id": 1624,
    "vorder": 51,
    "position": 0,
    "text": "وزان نیز کان بیگنه را که یافت"
  },
  {
    "poem_id": 1624,
    "vorder": 52,
    "position": 1,
    "text": "کسی یافت گر سوی دریا شتافت"
  },
  {
    "poem_id": 1624,
    "vorder": 53,
    "position": 0,
    "text": "که یزدان پسر داد و نشناختم"
  },
  {
    "poem_id": 1624,
    "vorder": 54,
    "position": 1,
    "text": "به آب فرات اندر انداختم"
  },
  {
    "poem_id": 1624,
    "vorder": 55,
    "position": 0,
    "text": "به بازوش بر بستم این یک گهر"
  },
  {
    "poem_id": 1624,
    "vorder": 56,
    "position": 1,
    "text": "پسر خوار شد چون بمیرد پدر"
  },
  {
    "poem_id": 1624,
    "vorder": 57,
    "position": 0,
    "text": "کنون ایزد او را بمن بازداد"
  },
  {
    "poem_id": 1624,
    "vorder": 58,
    "position": 1,
    "text": "به پیروز نام و پی رشنواد"
  },
  {
    "poem_id": 1624,
    "vorder": 59,
    "position": 0,
    "text": "ز دینار گنجی فرو ریختند"
  },
  {
    "poem_id": 1624,
    "vorder": 60,
    "position": 1,
    "text": "می و مشک و گوهر برآمیختند"
  },
  {
    "poem_id": 1624,
    "vorder": 61,
    "position": 0,
    "text": "ببخشید بر هرک بودش نیاز"
  },
  {
    "poem_id": 1624,
    "vorder": 62,
    "position": 1,
    "text": "دگر هفته گنج درم کرد باز"
  },
  {
    "poem_id": 1624,
    "vorder": 63,
    "position": 0,
    "text": "به جایی که دانست کاتشکده‌ست"
  },
  {
    "poem_id": 1624,
    "vorder": 64,
    "position": 1,
    "text": "وگر زند و استا و جشن سده‌ست"
  },
  {
    "poem_id": 1624,
    "vorder": 65,
    "position": 0,
    "text": "ببخشید گنجی برین گونه نیز"
  },
  {
    "poem_id": 1624,
    "vorder": 66,
    "position": 1,
    "text": "به هر کشوری بر پراگنده چیز"
  },
  {
    "poem_id": 1624,
    "vorder": 67,
    "position": 0,
    "text": "به روز دهم بامداد پگاه"
  },
  {
    "poem_id": 1624,
    "vorder": 68,
    "position": 1,
    "text": "سپهبد بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1624,
    "vorder": 69,
    "position": 0,
    "text": "بزرگان و داراب با او بهم"
  },
  {
    "poem_id": 1624,
    "vorder": 70,
    "position": 1,
    "text": "کسی را نگفتند از بیش و کم"
  }
]