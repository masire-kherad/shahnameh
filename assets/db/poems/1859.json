[
  {
    "poem_id": 1859,
    "vorder": 1,
    "position": 0,
    "text": "چو آن نامه نزدیک خسرو رسید"
  },
  {
    "poem_id": 1859,
    "vorder": 2,
    "position": 1,
    "text": "زپیوستن آگاهی نو رسید"
  },
  {
    "poem_id": 1859,
    "vorder": 3,
    "position": 0,
    "text": "به ایرانیان گفت کامروز مهر"
  },
  {
    "poem_id": 1859,
    "vorder": 4,
    "position": 1,
    "text": "دگرگونه گردد همی برسپهر"
  },
  {
    "poem_id": 1859,
    "vorder": 5,
    "position": 0,
    "text": "زقیصر یک نامه آمد بلند"
  },
  {
    "poem_id": 1859,
    "vorder": 6,
    "position": 1,
    "text": "سخن گفتنش سر به سر سودمند"
  },
  {
    "poem_id": 1859,
    "vorder": 7,
    "position": 0,
    "text": "همی راه جوید که دیرینه کین"
  },
  {
    "poem_id": 1859,
    "vorder": 8,
    "position": 1,
    "text": "ببرد ز روم و ز ایران زمین"
  },
  {
    "poem_id": 1859,
    "vorder": 9,
    "position": 0,
    "text": "چنین یافت پاسخ زایرانیان"
  },
  {
    "poem_id": 1859,
    "vorder": 10,
    "position": 1,
    "text": "که هرگز نه برخاست کین ازمیان"
  },
  {
    "poem_id": 1859,
    "vorder": 11,
    "position": 0,
    "text": "چواین راست گردد بهنگام تو"
  },
  {
    "poem_id": 1859,
    "vorder": 12,
    "position": 1,
    "text": "نویسند برتاجها نام تو"
  },
  {
    "poem_id": 1859,
    "vorder": 13,
    "position": 0,
    "text": "چوایشان بران گونه دیدند رای"
  },
  {
    "poem_id": 1859,
    "vorder": 14,
    "position": 1,
    "text": "بپردخت خسرو زبیگانه جای"
  },
  {
    "poem_id": 1859,
    "vorder": 15,
    "position": 0,
    "text": "دوات و قلم خواست وچینی حریر"
  },
  {
    "poem_id": 1859,
    "vorder": 16,
    "position": 1,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1859,
    "vorder": 17,
    "position": 0,
    "text": "یکی نامه بنوشت بر پهلوی"
  },
  {
    "poem_id": 1859,
    "vorder": 18,
    "position": 1,
    "text": "برآیین شاهان خط خسروی"
  },
  {
    "poem_id": 1859,
    "vorder": 19,
    "position": 0,
    "text": "که پذرفت خسرو زیزدان پاک"
  },
  {
    "poem_id": 1859,
    "vorder": 20,
    "position": 1,
    "text": "ز گردنده خورشید تا تیره خاک"
  },
  {
    "poem_id": 1859,
    "vorder": 21,
    "position": 0,
    "text": "که تا او بود شاه در پیشگاه"
  },
  {
    "poem_id": 1859,
    "vorder": 22,
    "position": 1,
    "text": "ورا باشد ایران و گنج و سپاه"
  },
  {
    "poem_id": 1859,
    "vorder": 23,
    "position": 0,
    "text": "نخواهد ز دارندگان باژ روم"
  },
  {
    "poem_id": 1859,
    "vorder": 24,
    "position": 1,
    "text": "نه لشکر فرستد بران مرز وبوم"
  },
  {
    "poem_id": 1859,
    "vorder": 25,
    "position": 0,
    "text": "هران شارستانی کزان مرز بود"
  },
  {
    "poem_id": 1859,
    "vorder": 26,
    "position": 1,
    "text": "اگر چند بیکار و بی‌ارز بود"
  },
  {
    "poem_id": 1859,
    "vorder": 27,
    "position": 0,
    "text": "بقیصر سپارد همه یک بیک"
  },
  {
    "poem_id": 1859,
    "vorder": 28,
    "position": 1,
    "text": "ازین پس نوشته فرستیم و چک"
  },
  {
    "poem_id": 1859,
    "vorder": 29,
    "position": 0,
    "text": "همان نیز دختر کزان مادرست"
  },
  {
    "poem_id": 1859,
    "vorder": 30,
    "position": 1,
    "text": "که پاکست وپیوستهٔ قیصرست"
  },
  {
    "poem_id": 1859,
    "vorder": 31,
    "position": 0,
    "text": "بهمداستان پدرخواستیم"
  },
  {
    "poem_id": 1859,
    "vorder": 32,
    "position": 1,
    "text": "بدین خواستن دل بیاراستیم"
  },
  {
    "poem_id": 1859,
    "vorder": 33,
    "position": 0,
    "text": "هران کس که در بارگاه تواند"
  },
  {
    "poem_id": 1859,
    "vorder": 34,
    "position": 1,
    "text": "ازایران و اندر پناه تواند"
  },
  {
    "poem_id": 1859,
    "vorder": 35,
    "position": 0,
    "text": "چوگستهم و شاپور و چون اندیان"
  },
  {
    "poem_id": 1859,
    "vorder": 36,
    "position": 1,
    "text": "چو خراد بر زین زتخم کیان"
  },
  {
    "poem_id": 1859,
    "vorder": 37,
    "position": 0,
    "text": "چو لشکر فرستی بدیشان سپار"
  },
  {
    "poem_id": 1859,
    "vorder": 38,
    "position": 1,
    "text": "خرد یافته دختر نامدار"
  },
  {
    "poem_id": 1859,
    "vorder": 39,
    "position": 0,
    "text": "بخویشی چنانم کنون باتو من"
  },
  {
    "poem_id": 1859,
    "vorder": 40,
    "position": 1,
    "text": "چو از پیش بود آن بزرگ انجمن"
  },
  {
    "poem_id": 1859,
    "vorder": 41,
    "position": 0,
    "text": "نخستین کیومرث با جمشید"
  },
  {
    "poem_id": 1859,
    "vorder": 42,
    "position": 1,
    "text": "کزو بود گیتی ببیم وامید"
  },
  {
    "poem_id": 1859,
    "vorder": 43,
    "position": 0,
    "text": "دگر هرچ هستند ایرج نژاد"
  },
  {
    "poem_id": 1859,
    "vorder": 44,
    "position": 1,
    "text": "که آیین و فر فریدون نهاد"
  },
  {
    "poem_id": 1859,
    "vorder": 45,
    "position": 0,
    "text": "بدین همنشان تا قباد بزرگ"
  },
  {
    "poem_id": 1859,
    "vorder": 46,
    "position": 1,
    "text": "که از داد او خویش بدمیش وگرگ"
  },
  {
    "poem_id": 1859,
    "vorder": 47,
    "position": 0,
    "text": "همه کینه برداشتیم از میان"
  },
  {
    "poem_id": 1859,
    "vorder": 48,
    "position": 1,
    "text": "یکی گشت رومی و ایرانیان"
  },
  {
    "poem_id": 1859,
    "vorder": 49,
    "position": 0,
    "text": "ز قیصر پذیرفتم آن دخترش"
  },
  {
    "poem_id": 1859,
    "vorder": 50,
    "position": 1,
    "text": "که از دختران باشد او افسرش"
  },
  {
    "poem_id": 1859,
    "vorder": 51,
    "position": 0,
    "text": "ازین بر نگردم که گفتم یکی"
  },
  {
    "poem_id": 1859,
    "vorder": 52,
    "position": 1,
    "text": "ز کردار بسیار تا اندکی"
  },
  {
    "poem_id": 1859,
    "vorder": 53,
    "position": 0,
    "text": "تو چیزی که گفتی درنگی مساز"
  },
  {
    "poem_id": 1859,
    "vorder": 54,
    "position": 1,
    "text": "که بودن درین شارستان شد دراز"
  },
  {
    "poem_id": 1859,
    "vorder": 55,
    "position": 0,
    "text": "چو کرد این سخن‌ها برین گونه یاد"
  },
  {
    "poem_id": 1859,
    "vorder": 56,
    "position": 1,
    "text": "نوشته بخورشید خراد داد"
  },
  {
    "poem_id": 1859,
    "vorder": 57,
    "position": 0,
    "text": "سپهبد چو باد اندر آمد زجای"
  },
  {
    "poem_id": 1859,
    "vorder": 58,
    "position": 1,
    "text": "باسپ کمیت اندر آورد پای"
  },
  {
    "poem_id": 1859,
    "vorder": 59,
    "position": 0,
    "text": "همی‌تاخت تا پیش قیصر چوباد"
  },
  {
    "poem_id": 1859,
    "vorder": 60,
    "position": 1,
    "text": "سخنهای خسرو بدو کرد یاد"
  },
  {
    "poem_id": 1859,
    "vorder": 61,
    "position": 0,
    "text": "چو قیصر ازان نامه بگسست بند"
  },
  {
    "poem_id": 1859,
    "vorder": 62,
    "position": 1,
    "text": "بدید آن سخنهای شاه بلند"
  },
  {
    "poem_id": 1859,
    "vorder": 63,
    "position": 0,
    "text": "بفرمود تا هر که دانا بدند"
  },
  {
    "poem_id": 1859,
    "vorder": 64,
    "position": 1,
    "text": "به گفتارها بر توانا بدند"
  },
  {
    "poem_id": 1859,
    "vorder": 65,
    "position": 0,
    "text": "به نزدیک قیصر شدند انجمن"
  },
  {
    "poem_id": 1859,
    "vorder": 66,
    "position": 1,
    "text": "بپرسید زیشان همه تن بتن"
  },
  {
    "poem_id": 1859,
    "vorder": 67,
    "position": 0,
    "text": "که اکنون مر این را چه درمان کنیم"
  },
  {
    "poem_id": 1859,
    "vorder": 68,
    "position": 1,
    "text": "ابا شاه ایران چه پیمان کنیم"
  },
  {
    "poem_id": 1859,
    "vorder": 69,
    "position": 0,
    "text": "بدین نامه ما بی‌بهانه شدیم"
  },
  {
    "poem_id": 1859,
    "vorder": 70,
    "position": 1,
    "text": "همی روم و ایران یگانه شدیم"
  },
  {
    "poem_id": 1859,
    "vorder": 71,
    "position": 0,
    "text": "بزرگان فرزانه برخاستند"
  },
  {
    "poem_id": 1859,
    "vorder": 72,
    "position": 1,
    "text": "زبان را به پاسخ بیاراستند"
  },
  {
    "poem_id": 1859,
    "vorder": 73,
    "position": 0,
    "text": "که ما کهترانیم و قیصر تویی"
  },
  {
    "poem_id": 1859,
    "vorder": 74,
    "position": 1,
    "text": "جهاندار با تخت و افسر تویی"
  },
  {
    "poem_id": 1859,
    "vorder": 75,
    "position": 0,
    "text": "نگه کن کنون رای و فرمان تو راست"
  },
  {
    "poem_id": 1859,
    "vorder": 76,
    "position": 1,
    "text": "ز ما گر بخواهی تن و جان تو راست"
  },
  {
    "poem_id": 1859,
    "vorder": 77,
    "position": 0,
    "text": "چو بشنید قیصر گرفت آفرین"
  },
  {
    "poem_id": 1859,
    "vorder": 78,
    "position": 1,
    "text": "بدان نامداران با رای و دین"
  },
  {
    "poem_id": 1859,
    "vorder": 79,
    "position": 0,
    "text": "همی‌بود تاشمع گردان سپهر"
  },
  {
    "poem_id": 1859,
    "vorder": 80,
    "position": 1,
    "text": "دگرگونه ترشد به آیین و چهر"
  }
]