[
  {
    "poem_id": 88014,
    "vorder": 1,
    "position": 0,
    "text": "چو یک هفته گرگین بره‌بر بپای"
  },
  {
    "poem_id": 88014,
    "vorder": 2,
    "position": 1,
    "text": "همی بود و بیژن نیامد بجای"
  },
  {
    "poem_id": 88014,
    "vorder": 3,
    "position": 0,
    "text": "ز هر سوش پویان بجستن گرفت"
  },
  {
    "poem_id": 88014,
    "vorder": 4,
    "position": 1,
    "text": "رخان را بخوناب شستن گرفت"
  },
  {
    "poem_id": 88014,
    "vorder": 5,
    "position": 0,
    "text": "پشیمانی آمدش زان کار خویش"
  },
  {
    "poem_id": 88014,
    "vorder": 6,
    "position": 1,
    "text": "که چون بد سگالید بر یار خویش"
  },
  {
    "poem_id": 88014,
    "vorder": 7,
    "position": 0,
    "text": "بشد تازیان تا بدان جشنگاه"
  },
  {
    "poem_id": 88014,
    "vorder": 8,
    "position": 1,
    "text": "کجا بیژن گیو گم کرد راه"
  },
  {
    "poem_id": 88014,
    "vorder": 9,
    "position": 0,
    "text": "همه بیشه برگشت و کس را ندید"
  },
  {
    "poem_id": 88014,
    "vorder": 10,
    "position": 1,
    "text": "نه نیز اندرو بانگ مرغان شنید"
  },
  {
    "poem_id": 88014,
    "vorder": 11,
    "position": 0,
    "text": "همی گشت بر گرد آن مرغزار"
  },
  {
    "poem_id": 88014,
    "vorder": 12,
    "position": 1,
    "text": "همی یار کرد اندرو خواستار"
  },
  {
    "poem_id": 88014,
    "vorder": 13,
    "position": 0,
    "text": "یکایک ز دور اسب بیژن بدید"
  },
  {
    "poem_id": 88014,
    "vorder": 14,
    "position": 1,
    "text": "که آمد ازان مرغزاران پدید"
  },
  {
    "poem_id": 88014,
    "vorder": 15,
    "position": 0,
    "text": "گسسته لگام و نگون کرده زین"
  },
  {
    "poem_id": 88014,
    "vorder": 16,
    "position": 1,
    "text": "فرو مانده بر جای اندوهگین"
  },
  {
    "poem_id": 88014,
    "vorder": 17,
    "position": 0,
    "text": "بدانست کو را تباهست کار"
  },
  {
    "poem_id": 88014,
    "vorder": 18,
    "position": 1,
    "text": "بایران نیاید بدین روزگار"
  },
  {
    "poem_id": 88014,
    "vorder": 19,
    "position": 0,
    "text": "اگر دار دارد اگر چاه و بند"
  },
  {
    "poem_id": 88014,
    "vorder": 20,
    "position": 1,
    "text": "از افراسیاب آمدستش گزند"
  },
  {
    "poem_id": 88014,
    "vorder": 21,
    "position": 0,
    "text": "کمند اندرافگند و برگاشت روی"
  },
  {
    "poem_id": 88014,
    "vorder": 22,
    "position": 1,
    "text": "ز کرده پشیمان و دل جفت جوی"
  },
  {
    "poem_id": 88014,
    "vorder": 23,
    "position": 0,
    "text": "ازان مرغزار اسب بیژن براند"
  },
  {
    "poem_id": 88014,
    "vorder": 24,
    "position": 1,
    "text": "بخیمه در آورد و روزی بماند"
  },
  {
    "poem_id": 88014,
    "vorder": 25,
    "position": 0,
    "text": "پس آنگه سوی شهر ایران شتافت"
  },
  {
    "poem_id": 88014,
    "vorder": 26,
    "position": 1,
    "text": "شب و روز آرام و خوردن نیافت"
  },
  {
    "poem_id": 88014,
    "vorder": 27,
    "position": 0,
    "text": "چو آگاهی آمد ز گرگین بشاه"
  },
  {
    "poem_id": 88014,
    "vorder": 28,
    "position": 1,
    "text": "که بیژن نبودست با او براه"
  },
  {
    "poem_id": 88014,
    "vorder": 29,
    "position": 0,
    "text": "بگفت این سخن گیو را شهریار"
  },
  {
    "poem_id": 88014,
    "vorder": 30,
    "position": 1,
    "text": "بدان تا ز گرگین کند خواستار"
  },
  {
    "poem_id": 88014,
    "vorder": 31,
    "position": 0,
    "text": "پس آگاهی آمد همانگه بگیو"
  },
  {
    "poem_id": 88014,
    "vorder": 32,
    "position": 1,
    "text": "ز گم بودن رزمزن پور نیو"
  },
  {
    "poem_id": 88014,
    "vorder": 33,
    "position": 0,
    "text": "ز خانه بیامد دمان تا بکوی"
  },
  {
    "poem_id": 88014,
    "vorder": 34,
    "position": 1,
    "text": "دل از درد خسته پر از آب روی"
  },
  {
    "poem_id": 88014,
    "vorder": 35,
    "position": 0,
    "text": "همی گفت بیژن نیامد همی"
  },
  {
    "poem_id": 88014,
    "vorder": 36,
    "position": 1,
    "text": "بارمان ندانم چه ماند همی"
  },
  {
    "poem_id": 88014,
    "vorder": 37,
    "position": 0,
    "text": "بفرمود تا بور کشواد را"
  },
  {
    "poem_id": 88014,
    "vorder": 38,
    "position": 1,
    "text": "کجا داشتی روز فریاد را"
  },
  {
    "poem_id": 88014,
    "vorder": 39,
    "position": 0,
    "text": "بروبر نهادند زین خدنگ"
  },
  {
    "poem_id": 88014,
    "vorder": 40,
    "position": 1,
    "text": "گرفته بدل گیو کین پلنگ"
  },
  {
    "poem_id": 88014,
    "vorder": 41,
    "position": 0,
    "text": "همانگه بدو اندر آورد پای"
  },
  {
    "poem_id": 88014,
    "vorder": 42,
    "position": 1,
    "text": "بکردار باد اندر آمد ز جای"
  },
  {
    "poem_id": 88014,
    "vorder": 43,
    "position": 0,
    "text": "پذیره شدش تا کند خواستار"
  },
  {
    "poem_id": 88014,
    "vorder": 44,
    "position": 1,
    "text": "که بیژن کجا ماند و چون بود کار"
  },
  {
    "poem_id": 88014,
    "vorder": 45,
    "position": 0,
    "text": "همی گفت گرگین بدو ناگهان"
  },
  {
    "poem_id": 88014,
    "vorder": 46,
    "position": 1,
    "text": "همانا بدی ساخت اندر نهان"
  },
  {
    "poem_id": 88014,
    "vorder": 47,
    "position": 0,
    "text": "شوم گر ببینمش بی بیژنم"
  },
  {
    "poem_id": 88014,
    "vorder": 48,
    "position": 1,
    "text": "همانگه سرش را ز تن بر کنم"
  },
  {
    "poem_id": 88014,
    "vorder": 49,
    "position": 0,
    "text": "بیامد چو گرگین مر او را بدید"
  },
  {
    "poem_id": 88014,
    "vorder": 50,
    "position": 1,
    "text": "پیاده شد و پیش او در دوید"
  },
  {
    "poem_id": 88014,
    "vorder": 51,
    "position": 0,
    "text": "همی گشت غلتان بخاک اندرا"
  },
  {
    "poem_id": 88014,
    "vorder": 52,
    "position": 1,
    "text": "شخوده رخان و برهنه سرا"
  },
  {
    "poem_id": 88014,
    "vorder": 53,
    "position": 0,
    "text": "بپرسید و گفت ای گزین سپاه"
  },
  {
    "poem_id": 88014,
    "vorder": 54,
    "position": 1,
    "text": "سپهدار سالار و خورشید گاه"
  },
  {
    "poem_id": 88014,
    "vorder": 55,
    "position": 0,
    "text": "پذیره بدین راه چون آمدی"
  },
  {
    "poem_id": 88014,
    "vorder": 56,
    "position": 1,
    "text": "که با دیدگان پر ز خون آمدی"
  },
  {
    "poem_id": 88014,
    "vorder": 57,
    "position": 0,
    "text": "مرا جان شیرین نباید همی"
  },
  {
    "poem_id": 88014,
    "vorder": 58,
    "position": 1,
    "text": "کنون خوارتر گر برآید همی"
  },
  {
    "poem_id": 88014,
    "vorder": 59,
    "position": 0,
    "text": "چو چشمم بروی تو آید ز شرم"
  },
  {
    "poem_id": 88014,
    "vorder": 60,
    "position": 1,
    "text": "بپالایم از دیدگان آب گرم"
  },
  {
    "poem_id": 88014,
    "vorder": 61,
    "position": 0,
    "text": "کنون هیچ مندیش کو را بجان"
  },
  {
    "poem_id": 88014,
    "vorder": 62,
    "position": 1,
    "text": "نیامد گزند و بگویم نشان"
  },
  {
    "poem_id": 88014,
    "vorder": 63,
    "position": 0,
    "text": "چو اسب پسر دید گرگین بدست"
  },
  {
    "poem_id": 88014,
    "vorder": 64,
    "position": 1,
    "text": "پر از خاک و آسیمه برسان مست"
  },
  {
    "poem_id": 88014,
    "vorder": 65,
    "position": 0,
    "text": "چو گفتار گرگینش آمد بگوش"
  },
  {
    "poem_id": 88014,
    "vorder": 66,
    "position": 1,
    "text": "ز اسب اندر افتاد و زو رفت هوش"
  },
  {
    "poem_id": 88014,
    "vorder": 67,
    "position": 0,
    "text": "بخاک اندرون شد سرش ناپدید"
  },
  {
    "poem_id": 88014,
    "vorder": 68,
    "position": 1,
    "text": "همه جامهٔ پهلوی بردرید"
  },
  {
    "poem_id": 88014,
    "vorder": 69,
    "position": 0,
    "text": "همی کند موی از سر و ریش پاک"
  },
  {
    "poem_id": 88014,
    "vorder": 70,
    "position": 1,
    "text": "خروشان بسر بر همی ریخت خاک"
  },
  {
    "poem_id": 88014,
    "vorder": 71,
    "position": 0,
    "text": "همی گفت کای کردگار سپهر"
  },
  {
    "poem_id": 88014,
    "vorder": 72,
    "position": 1,
    "text": "تو گستردی اندر دلم هوش و مهر"
  },
  {
    "poem_id": 88014,
    "vorder": 73,
    "position": 0,
    "text": "گر از من جدا ماند فرزند من"
  },
  {
    "poem_id": 88014,
    "vorder": 74,
    "position": 1,
    "text": "روا دارم ار بگسلد بند من"
  },
  {
    "poem_id": 88014,
    "vorder": 75,
    "position": 0,
    "text": "روانم بدان جای نیکان بری"
  },
  {
    "poem_id": 88014,
    "vorder": 76,
    "position": 1,
    "text": "ز درد دل من تو آگه‌تری"
  },
  {
    "poem_id": 88014,
    "vorder": 77,
    "position": 0,
    "text": "مرا خود ز گیتی هم او بود و بس"
  },
  {
    "poem_id": 88014,
    "vorder": 78,
    "position": 1,
    "text": "چه انده گسار و چه فریادرس"
  },
  {
    "poem_id": 88014,
    "vorder": 79,
    "position": 0,
    "text": "کنون بخت بد کردش از من جدا"
  },
  {
    "poem_id": 88014,
    "vorder": 80,
    "position": 1,
    "text": "بماندم چنین در جهان مبتلا"
  },
  {
    "poem_id": 88014,
    "vorder": 81,
    "position": 0,
    "text": "ز گرگین پس آنگه سخن بازجست"
  },
  {
    "poem_id": 88014,
    "vorder": 82,
    "position": 1,
    "text": "که چون بود خود روزگار از نخست"
  },
  {
    "poem_id": 88014,
    "vorder": 83,
    "position": 0,
    "text": "زمانه بجایش کسی برگزید"
  },
  {
    "poem_id": 88014,
    "vorder": 84,
    "position": 1,
    "text": "وگر خود ز چشم تو شد ناپدید"
  },
  {
    "poem_id": 88014,
    "vorder": 85,
    "position": 0,
    "text": "ز بدها چه آمد مر او را بگوی"
  },
  {
    "poem_id": 88014,
    "vorder": 86,
    "position": 1,
    "text": "چه افگند بند سپهرش بروی"
  },
  {
    "poem_id": 88014,
    "vorder": 87,
    "position": 0,
    "text": "چه دیو آمدش پیش در مرغزار"
  },
  {
    "poem_id": 88014,
    "vorder": 88,
    "position": 1,
    "text": "که او را تبه کرد و برگشت کار"
  },
  {
    "poem_id": 88014,
    "vorder": 89,
    "position": 0,
    "text": "تو این مرده‌ری اسب چون یافتی"
  },
  {
    "poem_id": 88014,
    "vorder": 90,
    "position": 1,
    "text": "ز بیژن کجا روی برتافتی"
  },
  {
    "poem_id": 88014,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت گرگین که بازآر هوش"
  },
  {
    "poem_id": 88014,
    "vorder": 92,
    "position": 1,
    "text": "سخن بشنو و پهن بگشای گوش"
  },
  {
    "poem_id": 88014,
    "vorder": 93,
    "position": 0,
    "text": "که این کار چون بود و کردار چون"
  },
  {
    "poem_id": 88014,
    "vorder": 94,
    "position": 1,
    "text": "بدان بیشه با خوک پیکار چون"
  },
  {
    "poem_id": 88014,
    "vorder": 95,
    "position": 0,
    "text": "بدان پهلوانا و آگاه باش"
  },
  {
    "poem_id": 88014,
    "vorder": 96,
    "position": 1,
    "text": "همیشه فروزندهٔ گاه باش"
  },
  {
    "poem_id": 88014,
    "vorder": 97,
    "position": 0,
    "text": "برفتیم ز ایدر بجنگ گراز"
  },
  {
    "poem_id": 88014,
    "vorder": 98,
    "position": 1,
    "text": "رسیدیم نزدیک ارمان فراز"
  },
  {
    "poem_id": 88014,
    "vorder": 99,
    "position": 0,
    "text": "یکی بیشه دیدیم کرده چو دست"
  },
  {
    "poem_id": 88014,
    "vorder": 100,
    "position": 1,
    "text": "درختان بریده چراگاه پست"
  },
  {
    "poem_id": 88014,
    "vorder": 101,
    "position": 0,
    "text": "همه جای گشته کنام گراز"
  },
  {
    "poem_id": 88014,
    "vorder": 102,
    "position": 1,
    "text": "همه شهر ارمان از آن در کزاز"
  },
  {
    "poem_id": 88014,
    "vorder": 103,
    "position": 0,
    "text": "چو ما جنگ را نیزه برگاشتیم"
  },
  {
    "poem_id": 88014,
    "vorder": 104,
    "position": 1,
    "text": "ببیشه درون بانگ برداشتیم"
  },
  {
    "poem_id": 88014,
    "vorder": 105,
    "position": 0,
    "text": "گراز اندر آمد بکردار کوه"
  },
  {
    "poem_id": 88014,
    "vorder": 106,
    "position": 1,
    "text": "نه یک یک بهر جای گشته گروه"
  },
  {
    "poem_id": 88014,
    "vorder": 107,
    "position": 0,
    "text": "بکردیم جنگی بکردار شیر"
  },
  {
    "poem_id": 88014,
    "vorder": 108,
    "position": 1,
    "text": "بشد روز و نامد دل از جنگ سیر"
  },
  {
    "poem_id": 88014,
    "vorder": 109,
    "position": 0,
    "text": "چو پیلان بهم بر فگندیمشان"
  },
  {
    "poem_id": 88014,
    "vorder": 110,
    "position": 1,
    "text": "بمسمار دندان بکندیمشان"
  },
  {
    "poem_id": 88014,
    "vorder": 111,
    "position": 0,
    "text": "وزآنجا بایران نهادیم روی"
  },
  {
    "poem_id": 88014,
    "vorder": 112,
    "position": 1,
    "text": "همه راه شادان و نخچیر جوی"
  },
  {
    "poem_id": 88014,
    "vorder": 113,
    "position": 0,
    "text": "برآمد یکی گور زان مرغزار"
  },
  {
    "poem_id": 88014,
    "vorder": 114,
    "position": 1,
    "text": "کزان خوبتر کس نبیند نگار"
  },
  {
    "poem_id": 88014,
    "vorder": 115,
    "position": 0,
    "text": "بکردار گلگون گودرز موی"
  },
  {
    "poem_id": 88014,
    "vorder": 116,
    "position": 1,
    "text": "چو خنگ شباهنگ فرهاد روی"
  },
  {
    "poem_id": 88014,
    "vorder": 117,
    "position": 0,
    "text": "چو سیمش دو پا و چو پولاد سم"
  },
  {
    "poem_id": 88014,
    "vorder": 118,
    "position": 1,
    "text": "چو شبرنگ بیژن سر و گوش و دم"
  },
  {
    "poem_id": 88014,
    "vorder": 119,
    "position": 0,
    "text": "بگردن چو شیر و برفتن چو باد"
  },
  {
    "poem_id": 88014,
    "vorder": 120,
    "position": 1,
    "text": "تو گفتی که از رخش دارد نژاد"
  },
  {
    "poem_id": 88014,
    "vorder": 121,
    "position": 0,
    "text": "بر بیژن آمد چو پیلی نژند"
  },
  {
    "poem_id": 88014,
    "vorder": 122,
    "position": 1,
    "text": "برو اندر افگند بیژن کمند"
  },
  {
    "poem_id": 88014,
    "vorder": 123,
    "position": 0,
    "text": "فگندن همان بود و رفتن همان"
  },
  {
    "poem_id": 88014,
    "vorder": 124,
    "position": 1,
    "text": "دوان گور و بیژن پس اندر دمان"
  },
  {
    "poem_id": 88014,
    "vorder": 125,
    "position": 0,
    "text": "ز تازیدن گور و گرد سوار"
  },
  {
    "poem_id": 88014,
    "vorder": 126,
    "position": 1,
    "text": "برآمد یکی دود زان مرغزار"
  },
  {
    "poem_id": 88014,
    "vorder": 127,
    "position": 0,
    "text": "بکردار دریا زمین بردمید"
  },
  {
    "poem_id": 88014,
    "vorder": 128,
    "position": 1,
    "text": "کمندافگن و گور شد ناپدید"
  },
  {
    "poem_id": 88014,
    "vorder": 129,
    "position": 0,
    "text": "پی اندر گرفتم همه دشت و کوه"
  },
  {
    "poem_id": 88014,
    "vorder": 130,
    "position": 1,
    "text": "که از تاختن شد سمندم ستوه"
  },
  {
    "poem_id": 88014,
    "vorder": 131,
    "position": 0,
    "text": "ز بیژن ندیدم بجایی نشان"
  },
  {
    "poem_id": 88014,
    "vorder": 132,
    "position": 1,
    "text": "جزین اسب و زین از پس ایدر کشان"
  },
  {
    "poem_id": 88014,
    "vorder": 133,
    "position": 0,
    "text": "دلم شد پر آتش ز تیمار اوی"
  },
  {
    "poem_id": 88014,
    "vorder": 134,
    "position": 1,
    "text": "که چون بود با گور پیکار اوی"
  },
  {
    "poem_id": 88014,
    "vorder": 135,
    "position": 0,
    "text": "بماندم فراوان بر آن مرغزار"
  },
  {
    "poem_id": 88014,
    "vorder": 136,
    "position": 1,
    "text": "همی کردمش هر سوی خواستار"
  },
  {
    "poem_id": 88014,
    "vorder": 137,
    "position": 0,
    "text": "ازو باز گشتم چنین ناامید"
  },
  {
    "poem_id": 88014,
    "vorder": 138,
    "position": 1,
    "text": "که گور ژیان بود و دیو سپید"
  },
  {
    "poem_id": 88014,
    "vorder": 139,
    "position": 0,
    "text": "چو بشنید گیو این سخن هوشیار"
  },
  {
    "poem_id": 88014,
    "vorder": 140,
    "position": 1,
    "text": "بدانست کو را تباهست کار"
  },
  {
    "poem_id": 88014,
    "vorder": 141,
    "position": 0,
    "text": "ز گرگین سخن سربسر خیره دید"
  },
  {
    "poem_id": 88014,
    "vorder": 142,
    "position": 1,
    "text": "همی چشمش از روی او تیره دید"
  },
  {
    "poem_id": 88014,
    "vorder": 143,
    "position": 0,
    "text": "رخش زرد از بیم سالار شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 144,
    "position": 1,
    "text": "سخن لرزلرزان و دل پر گناه"
  },
  {
    "poem_id": 88014,
    "vorder": 145,
    "position": 0,
    "text": "چو فرزند را گیو گم بوده دید"
  },
  {
    "poem_id": 88014,
    "vorder": 146,
    "position": 1,
    "text": "سخن را برآنگونه آلوده دید"
  },
  {
    "poem_id": 88014,
    "vorder": 147,
    "position": 0,
    "text": "ببرد اهرمن گیو را دل ز جای"
  },
  {
    "poem_id": 88014,
    "vorder": 148,
    "position": 1,
    "text": "همی خواست کو را درآرد ز پای"
  },
  {
    "poem_id": 88014,
    "vorder": 149,
    "position": 0,
    "text": "بخواهد ازو کین پور گزین"
  },
  {
    "poem_id": 88014,
    "vorder": 150,
    "position": 1,
    "text": "وگر چند نیک آید او را ازین"
  },
  {
    "poem_id": 88014,
    "vorder": 151,
    "position": 0,
    "text": "پس اندیشه کرد اندران بنگرید"
  },
  {
    "poem_id": 88014,
    "vorder": 152,
    "position": 1,
    "text": "نیامد همی روشنایی پدید"
  },
  {
    "poem_id": 88014,
    "vorder": 153,
    "position": 0,
    "text": "چه آید مرا گفت از کشتنا"
  },
  {
    "poem_id": 88014,
    "vorder": 154,
    "position": 1,
    "text": "مگر کام بدگوهر آهرمنا"
  },
  {
    "poem_id": 88014,
    "vorder": 155,
    "position": 0,
    "text": "به بیژن چه سود آید از جان اوی"
  },
  {
    "poem_id": 88014,
    "vorder": 156,
    "position": 1,
    "text": "دگرگونه سازیم درمان اوی"
  },
  {
    "poem_id": 88014,
    "vorder": 157,
    "position": 0,
    "text": "بباشیم تا زین سخن نزد شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 158,
    "position": 1,
    "text": "شود آشکارا ز گرگین گناه"
  },
  {
    "poem_id": 88014,
    "vorder": 159,
    "position": 0,
    "text": "ازو کین کشیدن بسی کار نیست"
  },
  {
    "poem_id": 88014,
    "vorder": 160,
    "position": 1,
    "text": "سنان مرا پیش دیوار نیست"
  },
  {
    "poem_id": 88014,
    "vorder": 161,
    "position": 0,
    "text": "بگرگین یکی بانگ برزد بلند"
  },
  {
    "poem_id": 88014,
    "vorder": 162,
    "position": 1,
    "text": "که ای بدکنش ریمن پرگزند"
  },
  {
    "poem_id": 88014,
    "vorder": 163,
    "position": 0,
    "text": "تو بردی ز من شید و ماه مرا"
  },
  {
    "poem_id": 88014,
    "vorder": 164,
    "position": 1,
    "text": "گزین سواران و شاه مرا"
  },
  {
    "poem_id": 88014,
    "vorder": 165,
    "position": 0,
    "text": "فگندی مرا در تک و پوی پوی"
  },
  {
    "poem_id": 88014,
    "vorder": 166,
    "position": 1,
    "text": "بگرد جهان اندرون چاره‌جوی"
  },
  {
    "poem_id": 88014,
    "vorder": 167,
    "position": 0,
    "text": "پس اکنون بدستان و بند و فریب"
  },
  {
    "poem_id": 88014,
    "vorder": 168,
    "position": 1,
    "text": "کجا یابی آرام و خواب و شکیب"
  },
  {
    "poem_id": 88014,
    "vorder": 169,
    "position": 0,
    "text": "نباشد ترا بیش ازین دستگاه"
  },
  {
    "poem_id": 88014,
    "vorder": 170,
    "position": 1,
    "text": "کجا من ببینم یکی روی شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 171,
    "position": 0,
    "text": "پس آنگه بخواهم ز تو کین خویش"
  },
  {
    "poem_id": 88014,
    "vorder": 172,
    "position": 1,
    "text": "ز بهر گرامی جهانبین خویش"
  },
  {
    "poem_id": 88014,
    "vorder": 173,
    "position": 0,
    "text": "وز آنجا بیامد بنزدیک شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 174,
    "position": 1,
    "text": "دو دیده پر از خون و دل کینه‌خواه"
  },
  {
    "poem_id": 88014,
    "vorder": 175,
    "position": 0,
    "text": "برو آفرین کرد کای شهریار"
  },
  {
    "poem_id": 88014,
    "vorder": 176,
    "position": 1,
    "text": "همیشه جهان را بشادی گذار"
  },
  {
    "poem_id": 88014,
    "vorder": 177,
    "position": 0,
    "text": "انوشه جهاندار نیک اخترا"
  },
  {
    "poem_id": 88014,
    "vorder": 178,
    "position": 1,
    "text": "نبینی که بر سر چه آمد مرا"
  },
  {
    "poem_id": 88014,
    "vorder": 179,
    "position": 0,
    "text": "ز گیتی یکی پور بودم جوان"
  },
  {
    "poem_id": 88014,
    "vorder": 180,
    "position": 1,
    "text": "شب و روز بودم بدوبر نوان"
  },
  {
    "poem_id": 88014,
    "vorder": 181,
    "position": 0,
    "text": "بجانش پر از بیم گریان بدم"
  },
  {
    "poem_id": 88014,
    "vorder": 182,
    "position": 1,
    "text": "ز درد جداییش بریان بدم"
  },
  {
    "poem_id": 88014,
    "vorder": 183,
    "position": 0,
    "text": "کنون آمد ای شاه گرگین ز راه"
  },
  {
    "poem_id": 88014,
    "vorder": 184,
    "position": 1,
    "text": "زبان پر ز یافه روان پر گناه"
  },
  {
    "poem_id": 88014,
    "vorder": 185,
    "position": 0,
    "text": "بدآگاهی آورد از پور من"
  },
  {
    "poem_id": 88014,
    "vorder": 186,
    "position": 1,
    "text": "ازان نامور پاک دستور من"
  },
  {
    "poem_id": 88014,
    "vorder": 187,
    "position": 0,
    "text": "یکی اسب دیدم نگونسار زین"
  },
  {
    "poem_id": 88014,
    "vorder": 188,
    "position": 1,
    "text": "ز بیژن نشانی ندارد جزین"
  },
  {
    "poem_id": 88014,
    "vorder": 189,
    "position": 0,
    "text": "اگر داد بیند بدین کار ما"
  },
  {
    "poem_id": 88014,
    "vorder": 190,
    "position": 1,
    "text": "یکی بنگرد ژرف سالار ما"
  },
  {
    "poem_id": 88014,
    "vorder": 191,
    "position": 0,
    "text": "ز گرگین دهد داد من شهریار"
  },
  {
    "poem_id": 88014,
    "vorder": 192,
    "position": 1,
    "text": "کزو گشتم اندر جهان خاکسار"
  },
  {
    "poem_id": 88014,
    "vorder": 193,
    "position": 0,
    "text": "غمی شد ز درد دل گیو شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 194,
    "position": 1,
    "text": "برآشفت و بنهاد فرخ کلاه"
  },
  {
    "poem_id": 88014,
    "vorder": 195,
    "position": 0,
    "text": "رخ شاه بر گاه بی‌رنگ شد"
  },
  {
    "poem_id": 88014,
    "vorder": 196,
    "position": 1,
    "text": "ز تیمار بیژن دلش تنگ شد"
  },
  {
    "poem_id": 88014,
    "vorder": 197,
    "position": 0,
    "text": "بگیو آنگهی گفت گرگین چه گفت"
  },
  {
    "poem_id": 88014,
    "vorder": 198,
    "position": 1,
    "text": "چه گوید کجا ماند از نیک جفت"
  },
  {
    "poem_id": 88014,
    "vorder": 199,
    "position": 0,
    "text": "ز گفتار گرگین پس آنگاه گیو"
  },
  {
    "poem_id": 88014,
    "vorder": 200,
    "position": 1,
    "text": "سخن گفت با خسرو از پور نیو"
  },
  {
    "poem_id": 88014,
    "vorder": 201,
    "position": 0,
    "text": "چو از گیو بشنید خسرو سخن"
  },
  {
    "poem_id": 88014,
    "vorder": 202,
    "position": 1,
    "text": "بدو گفت مندیش و زاری مکن"
  },
  {
    "poem_id": 88014,
    "vorder": 203,
    "position": 0,
    "text": "که بیژن بجانست خرسند باش"
  },
  {
    "poem_id": 88014,
    "vorder": 204,
    "position": 1,
    "text": "بر امید گم بوده فرزند باش"
  },
  {
    "poem_id": 88014,
    "vorder": 205,
    "position": 0,
    "text": "که ایدون شنیدستم از موبدان"
  },
  {
    "poem_id": 88014,
    "vorder": 206,
    "position": 1,
    "text": "ز بیدار دل نامور بخردان"
  },
  {
    "poem_id": 88014,
    "vorder": 207,
    "position": 0,
    "text": "که من با سواران ایران بجنگ"
  },
  {
    "poem_id": 88014,
    "vorder": 208,
    "position": 1,
    "text": "سوی شهر توران شوم بی‌درنگ"
  },
  {
    "poem_id": 88014,
    "vorder": 209,
    "position": 0,
    "text": "بکین سیاوش کشم لشکرا"
  },
  {
    "poem_id": 88014,
    "vorder": 210,
    "position": 1,
    "text": "بپیلان سرآرم از آن کشورا"
  },
  {
    "poem_id": 88014,
    "vorder": 211,
    "position": 0,
    "text": "بدان کینه اندر بود بیژنا"
  },
  {
    "poem_id": 88014,
    "vorder": 212,
    "position": 1,
    "text": "همی رزم جوید چو آهرمنا"
  },
  {
    "poem_id": 88014,
    "vorder": 213,
    "position": 0,
    "text": "تو دل را بدین کار غمگین مدار"
  },
  {
    "poem_id": 88014,
    "vorder": 214,
    "position": 1,
    "text": "من این را همانا بسم خواستار"
  },
  {
    "poem_id": 88014,
    "vorder": 215,
    "position": 0,
    "text": "بشد گیو یکدل پر اندوه و درد"
  },
  {
    "poem_id": 88014,
    "vorder": 216,
    "position": 1,
    "text": "دو دیده پر از آب و رخساره زرد"
  },
  {
    "poem_id": 88014,
    "vorder": 217,
    "position": 0,
    "text": "چو گرگین بدرگاه خسرو رسید"
  },
  {
    "poem_id": 88014,
    "vorder": 218,
    "position": 1,
    "text": "ز گردان در شاه پردخته دید"
  },
  {
    "poem_id": 88014,
    "vorder": 219,
    "position": 0,
    "text": "ز تیمار بیژن همه مهتران"
  },
  {
    "poem_id": 88014,
    "vorder": 220,
    "position": 1,
    "text": "ز درگاه با گیو رفته سران"
  },
  {
    "poem_id": 88014,
    "vorder": 221,
    "position": 0,
    "text": "همه پر ز درد و همه پر زرنج"
  },
  {
    "poem_id": 88014,
    "vorder": 222,
    "position": 1,
    "text": "همه همچو گم کرده صد گونه گنج"
  },
  {
    "poem_id": 88014,
    "vorder": 223,
    "position": 0,
    "text": "پراگنده رای و پراگنده دل"
  },
  {
    "poem_id": 88014,
    "vorder": 224,
    "position": 1,
    "text": "همه خاک ره ز اشک کرده چو گل"
  },
  {
    "poem_id": 88014,
    "vorder": 225,
    "position": 0,
    "text": "وزین روی گرگین شوریده رفت"
  },
  {
    "poem_id": 88014,
    "vorder": 226,
    "position": 1,
    "text": "بنزدیک ایوان درگاه تفت"
  },
  {
    "poem_id": 88014,
    "vorder": 227,
    "position": 0,
    "text": "چو در پیش کیخسرو آمد زمین"
  },
  {
    "poem_id": 88014,
    "vorder": 228,
    "position": 1,
    "text": "ببوسید و بر شاه کرد آفرین"
  },
  {
    "poem_id": 88014,
    "vorder": 229,
    "position": 0,
    "text": "چو الماس دندانهای گراز"
  },
  {
    "poem_id": 88014,
    "vorder": 230,
    "position": 1,
    "text": "بر تخت بنهاد و بردش نماز"
  },
  {
    "poem_id": 88014,
    "vorder": 231,
    "position": 0,
    "text": "که خسرو بهر کار پیروز باد"
  },
  {
    "poem_id": 88014,
    "vorder": 232,
    "position": 1,
    "text": "همه روزگارش چو نوروز باد"
  },
  {
    "poem_id": 88014,
    "vorder": 233,
    "position": 0,
    "text": "سر دشمنان تو بادا بگاز"
  },
  {
    "poem_id": 88014,
    "vorder": 234,
    "position": 1,
    "text": "بریده چنان کان سران گراز"
  },
  {
    "poem_id": 88014,
    "vorder": 235,
    "position": 0,
    "text": "بدندانها چون نگه کرد شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 236,
    "position": 1,
    "text": "بپرسید و گفتش که چون بود راه"
  },
  {
    "poem_id": 88014,
    "vorder": 237,
    "position": 0,
    "text": "کجا ماند از تو جدا بیژنا"
  },
  {
    "poem_id": 88014,
    "vorder": 238,
    "position": 1,
    "text": "بروبر چه بد ساخت آهرمنا"
  },
  {
    "poem_id": 88014,
    "vorder": 239,
    "position": 0,
    "text": "چو خسرو چنین گفت گرگین بجای"
  },
  {
    "poem_id": 88014,
    "vorder": 240,
    "position": 1,
    "text": "فرو ماند خیره همیدون بپای"
  },
  {
    "poem_id": 88014,
    "vorder": 241,
    "position": 0,
    "text": "ندانست پاسخ چه گوید بدوی"
  },
  {
    "poem_id": 88014,
    "vorder": 242,
    "position": 1,
    "text": "فروماند بر جای بر زرد روی"
  },
  {
    "poem_id": 88014,
    "vorder": 243,
    "position": 0,
    "text": "زبان پر ز یافه روان پر گناه"
  },
  {
    "poem_id": 88014,
    "vorder": 244,
    "position": 1,
    "text": "رخان زرد و لرزان تن از بیم شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 245,
    "position": 0,
    "text": "چو گفتارها یک بدیگر نماند"
  },
  {
    "poem_id": 88014,
    "vorder": 246,
    "position": 1,
    "text": "برآشفت وز پیش تختش براند"
  },
  {
    "poem_id": 88014,
    "vorder": 247,
    "position": 0,
    "text": "همش خیره سر دید هم بدگمان"
  },
  {
    "poem_id": 88014,
    "vorder": 248,
    "position": 1,
    "text": "بدشنام بگشاد خسرو زبان"
  },
  {
    "poem_id": 88014,
    "vorder": 249,
    "position": 0,
    "text": "بدو گفت نشنیدی آن داستان"
  },
  {
    "poem_id": 88014,
    "vorder": 250,
    "position": 1,
    "text": "که دستان زدست از گه باستان"
  },
  {
    "poem_id": 88014,
    "vorder": 251,
    "position": 0,
    "text": "که گر شیر با کین گودرزیان"
  },
  {
    "poem_id": 88014,
    "vorder": 252,
    "position": 1,
    "text": "بسیچد تنش را سر آید زمان"
  },
  {
    "poem_id": 88014,
    "vorder": 253,
    "position": 0,
    "text": "اگر نیستی از پی نام بد"
  },
  {
    "poem_id": 88014,
    "vorder": 254,
    "position": 1,
    "text": "وگر پیش یزدان سرانجام بد"
  },
  {
    "poem_id": 88014,
    "vorder": 255,
    "position": 0,
    "text": "بفرمودمی تا سرت را ز تن"
  },
  {
    "poem_id": 88014,
    "vorder": 256,
    "position": 1,
    "text": "بکندی بکردار مرغ اهرمن"
  },
  {
    "poem_id": 88014,
    "vorder": 257,
    "position": 0,
    "text": "بفرمود خسرو بپولادگر"
  },
  {
    "poem_id": 88014,
    "vorder": 258,
    "position": 1,
    "text": "که بندگران ساز و مسمارسر"
  },
  {
    "poem_id": 88014,
    "vorder": 259,
    "position": 0,
    "text": "هم اندر زمان پای کردش ببند"
  },
  {
    "poem_id": 88014,
    "vorder": 260,
    "position": 1,
    "text": "که از بند گیرد بداندیش پند"
  },
  {
    "poem_id": 88014,
    "vorder": 261,
    "position": 0,
    "text": "بگیو آنگهی گفت بازآر هوش"
  },
  {
    "poem_id": 88014,
    "vorder": 262,
    "position": 1,
    "text": "بجویش بهر جای و هر سو بکوش"
  },
  {
    "poem_id": 88014,
    "vorder": 263,
    "position": 0,
    "text": "من اکنون ز هر سو فراوان سپاه"
  },
  {
    "poem_id": 88014,
    "vorder": 264,
    "position": 1,
    "text": "فرستم بجویم بهر جا نگاه"
  },
  {
    "poem_id": 88014,
    "vorder": 265,
    "position": 0,
    "text": "ز بیژن مگر آگهی یابما"
  },
  {
    "poem_id": 88014,
    "vorder": 266,
    "position": 1,
    "text": "بدین کار هشیار بشتابما"
  },
  {
    "poem_id": 88014,
    "vorder": 267,
    "position": 0,
    "text": "وگر دیر یابیم زو آگهی"
  },
  {
    "poem_id": 88014,
    "vorder": 268,
    "position": 1,
    "text": "تو جای خرد را مگردان تهی"
  },
  {
    "poem_id": 88014,
    "vorder": 269,
    "position": 0,
    "text": "بمان تا بیاید مه فرودین"
  },
  {
    "poem_id": 88014,
    "vorder": 270,
    "position": 1,
    "text": "که بفروزد اندر جهان هور دین"
  },
  {
    "poem_id": 88014,
    "vorder": 271,
    "position": 0,
    "text": "بدانگه که بر گل نشاندت باد"
  },
  {
    "poem_id": 88014,
    "vorder": 272,
    "position": 1,
    "text": "چو بر سر همی گل فشاندت باد"
  },
  {
    "poem_id": 88014,
    "vorder": 273,
    "position": 0,
    "text": "زمین چادر سبز در پوشدا"
  },
  {
    "poem_id": 88014,
    "vorder": 274,
    "position": 1,
    "text": "هوا بر گلان زار بخروشدا"
  },
  {
    "poem_id": 88014,
    "vorder": 275,
    "position": 0,
    "text": "بهرسو شود پاک فرمان ما"
  },
  {
    "poem_id": 88014,
    "vorder": 276,
    "position": 1,
    "text": "پرستش که فرمود یزدان ما"
  },
  {
    "poem_id": 88014,
    "vorder": 277,
    "position": 0,
    "text": "بخواهم من آن جام گیتی نمای"
  },
  {
    "poem_id": 88014,
    "vorder": 278,
    "position": 1,
    "text": "شوم پیش یزدان بباشم بپای"
  },
  {
    "poem_id": 88014,
    "vorder": 279,
    "position": 0,
    "text": "کجا هفت کشور بدو اندرا"
  },
  {
    "poem_id": 88014,
    "vorder": 280,
    "position": 1,
    "text": "ببینم بر و بوم هر کشورا"
  },
  {
    "poem_id": 88014,
    "vorder": 281,
    "position": 0,
    "text": "کنم آفرین بر نیاکان خویش"
  },
  {
    "poem_id": 88014,
    "vorder": 282,
    "position": 1,
    "text": "گزیده جهاندار و پاکان خویش"
  },
  {
    "poem_id": 88014,
    "vorder": 283,
    "position": 0,
    "text": "بگویم ترا هر کجا بیژنست"
  },
  {
    "poem_id": 88014,
    "vorder": 284,
    "position": 1,
    "text": "بجام اندرون این مرا روشنست"
  },
  {
    "poem_id": 88014,
    "vorder": 285,
    "position": 0,
    "text": "چو بشنید گیو این سخن شاد شد"
  },
  {
    "poem_id": 88014,
    "vorder": 286,
    "position": 1,
    "text": "ز تیمار فرزند آزاد شد"
  },
  {
    "poem_id": 88014,
    "vorder": 287,
    "position": 0,
    "text": "بخندید و بر شاه کرد آفرین"
  },
  {
    "poem_id": 88014,
    "vorder": 288,
    "position": 1,
    "text": "که بی‌تو مبادا زمان و زمین"
  },
  {
    "poem_id": 88014,
    "vorder": 289,
    "position": 0,
    "text": "بکام تو بادا سپهر بلند"
  },
  {
    "poem_id": 88014,
    "vorder": 290,
    "position": 1,
    "text": "بجان تو هرگز مبادا گزند"
  },
  {
    "poem_id": 88014,
    "vorder": 291,
    "position": 0,
    "text": "ز نیکی دهش بر تو باد آفرین"
  },
  {
    "poem_id": 88014,
    "vorder": 292,
    "position": 1,
    "text": "که بر تو برازد کلاه و نگین"
  },
  {
    "poem_id": 88014,
    "vorder": 293,
    "position": 0,
    "text": "چو گیو از بر گاه خسرو برفت"
  },
  {
    "poem_id": 88014,
    "vorder": 294,
    "position": 1,
    "text": "ز هر سو سواران فرستاد تفت"
  },
  {
    "poem_id": 88014,
    "vorder": 295,
    "position": 0,
    "text": "بجستن گرفتند گرد جهان"
  },
  {
    "poem_id": 88014,
    "vorder": 296,
    "position": 1,
    "text": "که یابد مگر زو بجایی نشان"
  },
  {
    "poem_id": 88014,
    "vorder": 297,
    "position": 0,
    "text": "همه شهر ارمان و تورانیان"
  },
  {
    "poem_id": 88014,
    "vorder": 298,
    "position": 1,
    "text": "سپردند و نامد ز بیژن نشان"
  },
  {
    "poem_id": 88014,
    "vorder": 299,
    "position": 0,
    "text": "چو نوروز فرخ فراز آمدش"
  },
  {
    "poem_id": 88014,
    "vorder": 300,
    "position": 1,
    "text": "بدان جام روشن نیاز آمدش"
  },
  {
    "poem_id": 88014,
    "vorder": 301,
    "position": 0,
    "text": "بیامد پر امید دل پهلوان"
  },
  {
    "poem_id": 88014,
    "vorder": 302,
    "position": 1,
    "text": "ز بهر پسر گوژ گشته نوان"
  },
  {
    "poem_id": 88014,
    "vorder": 303,
    "position": 0,
    "text": "چو خسرو رخ گیو پژمرده دید"
  },
  {
    "poem_id": 88014,
    "vorder": 304,
    "position": 1,
    "text": "دلش را بدرد اندر آزرده دید"
  },
  {
    "poem_id": 88014,
    "vorder": 305,
    "position": 0,
    "text": "بیامد بپوشید رومی قبای"
  },
  {
    "poem_id": 88014,
    "vorder": 306,
    "position": 1,
    "text": "بدان تا بود پیش یزدان بپای"
  },
  {
    "poem_id": 88014,
    "vorder": 307,
    "position": 0,
    "text": "خروشید پیش جهان آفرین"
  },
  {
    "poem_id": 88014,
    "vorder": 308,
    "position": 1,
    "text": "بخورشید بر چند برد آفرین"
  },
  {
    "poem_id": 88014,
    "vorder": 309,
    "position": 0,
    "text": "ز فریادرس زور و فریاد خواست"
  },
  {
    "poem_id": 88014,
    "vorder": 310,
    "position": 1,
    "text": "از آهرمن بدکنش داد خواست"
  },
  {
    "poem_id": 88014,
    "vorder": 311,
    "position": 0,
    "text": "خرامان ازان جا بیامد بگاه"
  },
  {
    "poem_id": 88014,
    "vorder": 312,
    "position": 1,
    "text": "بسر بر نهاد آن خجسته کلاه"
  },
  {
    "poem_id": 88014,
    "vorder": 313,
    "position": 0,
    "text": "یکی جام بر کف نهاده نبید"
  },
  {
    "poem_id": 88014,
    "vorder": 314,
    "position": 1,
    "text": "بدو اندرون هفت کشور پدید"
  },
  {
    "poem_id": 88014,
    "vorder": 315,
    "position": 0,
    "text": "زمان و نشان سپهر بلند"
  },
  {
    "poem_id": 88014,
    "vorder": 316,
    "position": 1,
    "text": "همه کرده پیدا چه و چون و چند"
  },
  {
    "poem_id": 88014,
    "vorder": 317,
    "position": 0,
    "text": "ز ماهی بجام اندرون تا بره"
  },
  {
    "poem_id": 88014,
    "vorder": 318,
    "position": 1,
    "text": "نگاریده پیکر همه یکسره"
  },
  {
    "poem_id": 88014,
    "vorder": 319,
    "position": 0,
    "text": "چو کیوان و بهرام و ناهید و شیر"
  },
  {
    "poem_id": 88014,
    "vorder": 320,
    "position": 1,
    "text": "چو خورشید و تیر از بر و ماه زیر"
  },
  {
    "poem_id": 88014,
    "vorder": 321,
    "position": 0,
    "text": "همه بودنیها بدو اندرا"
  },
  {
    "poem_id": 88014,
    "vorder": 322,
    "position": 1,
    "text": "بدیدی جهاندار افسونگرا"
  },
  {
    "poem_id": 88014,
    "vorder": 323,
    "position": 0,
    "text": "نگه کرد و پس جام بنهاد پیش"
  },
  {
    "poem_id": 88014,
    "vorder": 324,
    "position": 1,
    "text": "بدید اندرو بودنیها ز بیش"
  },
  {
    "poem_id": 88014,
    "vorder": 325,
    "position": 0,
    "text": "بهر هفت کشور همی بنگرید"
  },
  {
    "poem_id": 88014,
    "vorder": 326,
    "position": 1,
    "text": "ز بیژن بجایی نشانی ندید"
  },
  {
    "poem_id": 88014,
    "vorder": 327,
    "position": 0,
    "text": "سوی کشور گرگساران رسید"
  },
  {
    "poem_id": 88014,
    "vorder": 328,
    "position": 1,
    "text": "بفرمان یزدان مر او را بدید"
  },
  {
    "poem_id": 88014,
    "vorder": 329,
    "position": 0,
    "text": "بچاهی ببسته ببند گران"
  },
  {
    "poem_id": 88014,
    "vorder": 330,
    "position": 1,
    "text": "ز سختی همی مرگ جست اندران"
  },
  {
    "poem_id": 88014,
    "vorder": 331,
    "position": 0,
    "text": "یکی دختری از نژاد کیان"
  },
  {
    "poem_id": 88014,
    "vorder": 332,
    "position": 1,
    "text": "ز بهر زوارش ببسته میان"
  },
  {
    "poem_id": 88014,
    "vorder": 333,
    "position": 0,
    "text": "سوی گیو کرد آنگهی روی شاه"
  },
  {
    "poem_id": 88014,
    "vorder": 334,
    "position": 1,
    "text": "بخندید و رخشنده شد پیشگاه"
  },
  {
    "poem_id": 88014,
    "vorder": 335,
    "position": 0,
    "text": "که زندست بیژن دلت شاد دار"
  },
  {
    "poem_id": 88014,
    "vorder": 336,
    "position": 1,
    "text": "ز هر بد تن مهتر آزاد دار"
  },
  {
    "poem_id": 88014,
    "vorder": 337,
    "position": 0,
    "text": "نگر غم نداری بزندان و بند"
  },
  {
    "poem_id": 88014,
    "vorder": 338,
    "position": 1,
    "text": "ازان پس که بر جانش نامد گزند"
  },
  {
    "poem_id": 88014,
    "vorder": 339,
    "position": 0,
    "text": "که بیژن بتوران ببند اندرست"
  },
  {
    "poem_id": 88014,
    "vorder": 340,
    "position": 1,
    "text": "زوارش یکی نامور دخترست"
  },
  {
    "poem_id": 88014,
    "vorder": 341,
    "position": 0,
    "text": "ز بس رنج و سختی و تیمار اوی"
  },
  {
    "poem_id": 88014,
    "vorder": 342,
    "position": 1,
    "text": "پر از درد گشتم من از کار اوی"
  },
  {
    "poem_id": 88014,
    "vorder": 343,
    "position": 0,
    "text": "بدان سان گذارد همی روزگار"
  },
  {
    "poem_id": 88014,
    "vorder": 344,
    "position": 1,
    "text": "که هزمان بروبر بگرید زوار"
  },
  {
    "poem_id": 88014,
    "vorder": 345,
    "position": 0,
    "text": "ز پیوند و خویشان شده ناامید"
  },
  {
    "poem_id": 88014,
    "vorder": 346,
    "position": 1,
    "text": "گرازنده بر سان یک شاخ بید"
  },
  {
    "poem_id": 88014,
    "vorder": 347,
    "position": 0,
    "text": "دو چشمش پر از خون و دل پر ز درد"
  },
  {
    "poem_id": 88014,
    "vorder": 348,
    "position": 1,
    "text": "زبانش ز خویشان پر از یاد کرد"
  },
  {
    "poem_id": 88014,
    "vorder": 349,
    "position": 0,
    "text": "چو ابر بهاران ببارندگی"
  },
  {
    "poem_id": 88014,
    "vorder": 350,
    "position": 1,
    "text": "همی مرگ جوید بدان زندگی"
  },
  {
    "poem_id": 88014,
    "vorder": 351,
    "position": 0,
    "text": "بدین چاره اکنون که جنبد ز جای"
  },
  {
    "poem_id": 88014,
    "vorder": 352,
    "position": 1,
    "text": "که خیزد میان بسته این را بپای"
  },
  {
    "poem_id": 88014,
    "vorder": 353,
    "position": 0,
    "text": "که دارد بدین کار ما را وفا"
  },
  {
    "poem_id": 88014,
    "vorder": 354,
    "position": 1,
    "text": "که آرد ز سختی مر او را رها"
  },
  {
    "poem_id": 88014,
    "vorder": 355,
    "position": 0,
    "text": "نشاید جز از رستم تیز چنگ"
  },
  {
    "poem_id": 88014,
    "vorder": 356,
    "position": 1,
    "text": "که از ژرف دریا برآرد نهنگ"
  },
  {
    "poem_id": 88014,
    "vorder": 357,
    "position": 0,
    "text": "کمر بند و برکش سوی نیمروز"
  },
  {
    "poem_id": 88014,
    "vorder": 358,
    "position": 1,
    "text": "شب از رفتن راه مأسا و روز"
  },
  {
    "poem_id": 88014,
    "vorder": 359,
    "position": 0,
    "text": "ببر نامهٔ من بر رستما"
  },
  {
    "poem_id": 88014,
    "vorder": 360,
    "position": 1,
    "text": "مزن داستان را بره ‌بردما"
  }
]