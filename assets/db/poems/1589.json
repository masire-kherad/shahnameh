[
  {
    "poem_id": 1589,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت با رستم اسفندیار"
  },
  {
    "poem_id": 1589,
    "vorder": 2,
    "position": 1,
    "text": "که ای نیک دل مهتر نامدار"
  },
  {
    "poem_id": 1589,
    "vorder": 3,
    "position": 0,
    "text": "من ایدون شنیدستم از بخردان"
  },
  {
    "poem_id": 1589,
    "vorder": 4,
    "position": 1,
    "text": "بزرگان و بیداردل موبدان"
  },
  {
    "poem_id": 1589,
    "vorder": 5,
    "position": 0,
    "text": "ازان برگذشته نیاکان تو"
  },
  {
    "poem_id": 1589,
    "vorder": 6,
    "position": 1,
    "text": "سرافراز و دین‌دار و پاکان تو"
  },
  {
    "poem_id": 1589,
    "vorder": 7,
    "position": 0,
    "text": "که دستان بدگوهر دیوزاد"
  },
  {
    "poem_id": 1589,
    "vorder": 8,
    "position": 1,
    "text": "به گیتی فزونی ندارد نژاد"
  },
  {
    "poem_id": 1589,
    "vorder": 9,
    "position": 0,
    "text": "فراوان ز سامش نهان داشتند"
  },
  {
    "poem_id": 1589,
    "vorder": 10,
    "position": 1,
    "text": "همی رستخیز جهان داشتند"
  },
  {
    "poem_id": 1589,
    "vorder": 11,
    "position": 0,
    "text": "تنش تیره بد موی و رویش سپید"
  },
  {
    "poem_id": 1589,
    "vorder": 12,
    "position": 1,
    "text": "چو دیدش دل سام شد ناامید"
  },
  {
    "poem_id": 1589,
    "vorder": 13,
    "position": 0,
    "text": "بفرمود تا پیش دریا برند"
  },
  {
    "poem_id": 1589,
    "vorder": 14,
    "position": 1,
    "text": "مگر مرغ و ماهی ورا بشکرند"
  },
  {
    "poem_id": 1589,
    "vorder": 15,
    "position": 0,
    "text": "بیامد بگسترد سیمرغ پر"
  },
  {
    "poem_id": 1589,
    "vorder": 16,
    "position": 1,
    "text": "ندید اندرو هیچ آیین و فر"
  },
  {
    "poem_id": 1589,
    "vorder": 17,
    "position": 0,
    "text": "ببردش به جایی که بودش کنام"
  },
  {
    "poem_id": 1589,
    "vorder": 18,
    "position": 1,
    "text": "ز دستان مر او را خورش بود کام"
  },
  {
    "poem_id": 1589,
    "vorder": 19,
    "position": 0,
    "text": "اگر چند سیمرغ ناهار بود"
  },
  {
    "poem_id": 1589,
    "vorder": 20,
    "position": 1,
    "text": "تن زال پیش اندرش خوار بود"
  },
  {
    "poem_id": 1589,
    "vorder": 21,
    "position": 0,
    "text": "بینداختش پس به پیش کنام"
  },
  {
    "poem_id": 1589,
    "vorder": 22,
    "position": 1,
    "text": "به دیدار او کس نبد شادکام"
  },
  {
    "poem_id": 1589,
    "vorder": 23,
    "position": 0,
    "text": "همی خورد افگنده مردار اوی"
  },
  {
    "poem_id": 1589,
    "vorder": 24,
    "position": 1,
    "text": "ز جامه برهنه تن خوار اوی"
  },
  {
    "poem_id": 1589,
    "vorder": 25,
    "position": 0,
    "text": "چو افگند سیمرغ بر زال مهر"
  },
  {
    "poem_id": 1589,
    "vorder": 26,
    "position": 1,
    "text": "برو گشت زین گونه چندی سپهر"
  },
  {
    "poem_id": 1589,
    "vorder": 27,
    "position": 0,
    "text": "ازان پس که مردار چندی چشید"
  },
  {
    "poem_id": 1589,
    "vorder": 28,
    "position": 1,
    "text": "برهنه سوی سیستانش کشید"
  },
  {
    "poem_id": 1589,
    "vorder": 29,
    "position": 0,
    "text": "پذیرفت سامش ز بی‌بچگی"
  },
  {
    "poem_id": 1589,
    "vorder": 30,
    "position": 1,
    "text": "ز نادانی و دیوی و غرچگی"
  },
  {
    "poem_id": 1589,
    "vorder": 31,
    "position": 0,
    "text": "خجسته بزرگان و شاهان من"
  },
  {
    "poem_id": 1589,
    "vorder": 32,
    "position": 1,
    "text": "نیای من و نیکخواهان من"
  },
  {
    "poem_id": 1589,
    "vorder": 33,
    "position": 0,
    "text": "ورا برکشیدند و دادند چیز"
  },
  {
    "poem_id": 1589,
    "vorder": 34,
    "position": 1,
    "text": "فراوان برین سال بگذشت نیز"
  },
  {
    "poem_id": 1589,
    "vorder": 35,
    "position": 0,
    "text": "یکی سرو بد نابسوده سرش"
  },
  {
    "poem_id": 1589,
    "vorder": 36,
    "position": 1,
    "text": "چو با شاخ شد رستم آمد برش"
  },
  {
    "poem_id": 1589,
    "vorder": 37,
    "position": 0,
    "text": "ز مردی و بالا و دیدار اوی"
  },
  {
    "poem_id": 1589,
    "vorder": 38,
    "position": 1,
    "text": "به گردون برآمد چنین کار اوی"
  },
  {
    "poem_id": 1589,
    "vorder": 39,
    "position": 0,
    "text": "برین گونه پادشاهی گرفت"
  },
  {
    "poem_id": 1589,
    "vorder": 40,
    "position": 1,
    "text": "ببالید و ناپارسایی گرفت"
  }
]