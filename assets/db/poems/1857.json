[
  {
    "poem_id": 1857,
    "vorder": 1,
    "position": 0,
    "text": "چوقیصر نگه کرد و نامه بخواند"
  },
  {
    "poem_id": 1857,
    "vorder": 2,
    "position": 1,
    "text": "ز هر گونه اندیشه بر دل براند"
  },
  {
    "poem_id": 1857,
    "vorder": 3,
    "position": 0,
    "text": "ازان پس بدستور پرمایه گفت"
  },
  {
    "poem_id": 1857,
    "vorder": 4,
    "position": 1,
    "text": "که این راز را بازخواه از نهفت"
  },
  {
    "poem_id": 1857,
    "vorder": 5,
    "position": 0,
    "text": "نگه کن خسرو بدین کار زار"
  },
  {
    "poem_id": 1857,
    "vorder": 6,
    "position": 1,
    "text": "شود شاد اگر پیچد از روزگار"
  },
  {
    "poem_id": 1857,
    "vorder": 7,
    "position": 0,
    "text": "گرای دون که گویی که پیروز نیست"
  },
  {
    "poem_id": 1857,
    "vorder": 8,
    "position": 1,
    "text": "ازان پس و را نیز نوروز نیست"
  },
  {
    "poem_id": 1857,
    "vorder": 9,
    "position": 0,
    "text": "بمانیم تا سوی خاقان شود"
  },
  {
    "poem_id": 1857,
    "vorder": 10,
    "position": 1,
    "text": "چو بیمار شد نزد درمان شود"
  },
  {
    "poem_id": 1857,
    "vorder": 11,
    "position": 0,
    "text": "ور ای دون که پیروزگر باشد اوی"
  },
  {
    "poem_id": 1857,
    "vorder": 12,
    "position": 1,
    "text": "بشاهی بسان پدر باشد اوی"
  },
  {
    "poem_id": 1857,
    "vorder": 13,
    "position": 0,
    "text": "همان به کز ایدر شود با سپاه"
  },
  {
    "poem_id": 1857,
    "vorder": 14,
    "position": 1,
    "text": "مگر کینه در دل ندارد نگاه"
  },
  {
    "poem_id": 1857,
    "vorder": 15,
    "position": 0,
    "text": "چو بشنید دستور دانا سخن"
  },
  {
    "poem_id": 1857,
    "vorder": 16,
    "position": 1,
    "text": "به فرمود تا زیجهای کهن"
  },
  {
    "poem_id": 1857,
    "vorder": 17,
    "position": 0,
    "text": "ببردند مردان اخترشناس"
  },
  {
    "poem_id": 1857,
    "vorder": 18,
    "position": 1,
    "text": "سخن راند تا ماند از شب سه پاس"
  },
  {
    "poem_id": 1857,
    "vorder": 19,
    "position": 0,
    "text": "سرانجام مرد ستاره شمر"
  },
  {
    "poem_id": 1857,
    "vorder": 20,
    "position": 1,
    "text": "به قیصر چنین گفت کای تاجور"
  },
  {
    "poem_id": 1857,
    "vorder": 21,
    "position": 0,
    "text": "نگه کردم این زیجهای کهن"
  },
  {
    "poem_id": 1857,
    "vorder": 22,
    "position": 1,
    "text": "کز اختر فلاطون فگندست بن"
  },
  {
    "poem_id": 1857,
    "vorder": 23,
    "position": 0,
    "text": "نه بس دیر شاهی به خسرو رسد"
  },
  {
    "poem_id": 1857,
    "vorder": 24,
    "position": 1,
    "text": "ز شاهنشهی گردش نو رسد"
  },
  {
    "poem_id": 1857,
    "vorder": 25,
    "position": 0,
    "text": "برین گونه تا سال بر سی وهشت"
  },
  {
    "poem_id": 1857,
    "vorder": 26,
    "position": 1,
    "text": "برو گرد تیره نیارد گذشت"
  },
  {
    "poem_id": 1857,
    "vorder": 27,
    "position": 0,
    "text": "چوبشنید قیصر به دستور گفت"
  },
  {
    "poem_id": 1857,
    "vorder": 28,
    "position": 1,
    "text": "که بیرون شد این آرزوی از نهفت"
  },
  {
    "poem_id": 1857,
    "vorder": 29,
    "position": 0,
    "text": "چه گوییم و این را چه پاسخ دهیم"
  },
  {
    "poem_id": 1857,
    "vorder": 30,
    "position": 1,
    "text": "بیا تا برین رای فرخ نهیم"
  },
  {
    "poem_id": 1857,
    "vorder": 31,
    "position": 0,
    "text": "گران مایه دستور گفت این سخن"
  },
  {
    "poem_id": 1857,
    "vorder": 32,
    "position": 1,
    "text": "که در آسمان اختر افگند بن"
  },
  {
    "poem_id": 1857,
    "vorder": 33,
    "position": 0,
    "text": "به مردی و دانش کجا داشت کس"
  },
  {
    "poem_id": 1857,
    "vorder": 34,
    "position": 1,
    "text": "جهان داورت باد فریاد رس"
  },
  {
    "poem_id": 1857,
    "vorder": 35,
    "position": 0,
    "text": "چو خسرو سوی مرز خاقان شود"
  },
  {
    "poem_id": 1857,
    "vorder": 36,
    "position": 1,
    "text": "ورا یاد خواهد تن آسان شود"
  },
  {
    "poem_id": 1857,
    "vorder": 37,
    "position": 0,
    "text": "چولشکر ز جای دگر سازد اوی"
  },
  {
    "poem_id": 1857,
    "vorder": 38,
    "position": 1,
    "text": "ز کین تو هرگز نپردازد اوی"
  },
  {
    "poem_id": 1857,
    "vorder": 39,
    "position": 0,
    "text": "نگه کن کنون تو که داناتری"
  },
  {
    "poem_id": 1857,
    "vorder": 40,
    "position": 1,
    "text": "بدین آرزوها تواناتری"
  },
  {
    "poem_id": 1857,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت قیصر که اکنون سپاه"
  },
  {
    "poem_id": 1857,
    "vorder": 42,
    "position": 1,
    "text": "فرستیم ناچار با پیل وگاه"
  },
  {
    "poem_id": 1857,
    "vorder": 43,
    "position": 0,
    "text": "سخن چند گویم همان به که گنج"
  },
  {
    "poem_id": 1857,
    "vorder": 44,
    "position": 1,
    "text": "کنم خوار تا دور مانم ز رنج"
  }
]