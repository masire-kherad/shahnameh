[
  {
    "poem_id": 1467,
    "vorder": 1,
    "position": 0,
    "text": "یکی نامه فرمود پس شهریار"
  },
  {
    "poem_id": 1467,
    "vorder": 2,
    "position": 1,
    "text": "نوشتن بر رستم نامدار"
  },
  {
    "poem_id": 1467,
    "vorder": 3,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1467,
    "vorder": 4,
    "position": 1,
    "text": "جهاندار و پروردهٔ روزگار"
  },
  {
    "poem_id": 1467,
    "vorder": 5,
    "position": 0,
    "text": "دگر آفرین کرد بر پهلوان"
  },
  {
    "poem_id": 1467,
    "vorder": 6,
    "position": 1,
    "text": "که بیدار دل باش و روشن روان"
  },
  {
    "poem_id": 1467,
    "vorder": 7,
    "position": 0,
    "text": "دل و پشت گردان ایران تویی"
  },
  {
    "poem_id": 1467,
    "vorder": 8,
    "position": 1,
    "text": "به چنگال و نیروی شیران تویی"
  },
  {
    "poem_id": 1467,
    "vorder": 9,
    "position": 0,
    "text": "گشایندهٔ بند هاماوران"
  },
  {
    "poem_id": 1467,
    "vorder": 10,
    "position": 1,
    "text": "ستانندهٔ مرز مازندران"
  },
  {
    "poem_id": 1467,
    "vorder": 11,
    "position": 0,
    "text": "ز گرز تو خورشید گریان شود"
  },
  {
    "poem_id": 1467,
    "vorder": 12,
    "position": 1,
    "text": "ز تیغ تو ناهید بریان شود"
  },
  {
    "poem_id": 1467,
    "vorder": 13,
    "position": 0,
    "text": "چو گرد پی رخش تو نیل نیست"
  },
  {
    "poem_id": 1467,
    "vorder": 14,
    "position": 1,
    "text": "هم‌آورد تو در جهان پیل نیست"
  },
  {
    "poem_id": 1467,
    "vorder": 15,
    "position": 0,
    "text": "کمند تو بر شیر بندافگند"
  },
  {
    "poem_id": 1467,
    "vorder": 16,
    "position": 1,
    "text": "سنان تو کوهی ز بن برکند"
  },
  {
    "poem_id": 1467,
    "vorder": 17,
    "position": 0,
    "text": "تویی از همه بد به ایران پناه"
  },
  {
    "poem_id": 1467,
    "vorder": 18,
    "position": 1,
    "text": "ز تو برفرازند گردان کلاه"
  },
  {
    "poem_id": 1467,
    "vorder": 19,
    "position": 0,
    "text": "گزاینده کاری بد آمد به پیش"
  },
  {
    "poem_id": 1467,
    "vorder": 20,
    "position": 1,
    "text": "کز اندیشهٔ آن دلم گشت ریش"
  },
  {
    "poem_id": 1467,
    "vorder": 21,
    "position": 0,
    "text": "نشستند گردان به پیشم به هم"
  },
  {
    "poem_id": 1467,
    "vorder": 22,
    "position": 1,
    "text": "چو خواندیم آن نامهٔ گژدهم"
  },
  {
    "poem_id": 1467,
    "vorder": 23,
    "position": 0,
    "text": "چنان باد کاندر جهان جز تو کس"
  },
  {
    "poem_id": 1467,
    "vorder": 24,
    "position": 1,
    "text": "نباشد به هر کار فریادرس"
  },
  {
    "poem_id": 1467,
    "vorder": 25,
    "position": 0,
    "text": "بدان‌گونه دیدند گردان نیو"
  },
  {
    "poem_id": 1467,
    "vorder": 26,
    "position": 1,
    "text": "که پیش تو آید گرانمایه گیو"
  },
  {
    "poem_id": 1467,
    "vorder": 27,
    "position": 0,
    "text": "چو نامه بخوانی به روز و به شب"
  },
  {
    "poem_id": 1467,
    "vorder": 28,
    "position": 1,
    "text": "مکن داستان را گشاده دو لب"
  },
  {
    "poem_id": 1467,
    "vorder": 29,
    "position": 0,
    "text": "مگر با سواران بسیارهوش"
  },
  {
    "poem_id": 1467,
    "vorder": 30,
    "position": 1,
    "text": "ز زابل برانی برآری خروش"
  },
  {
    "poem_id": 1467,
    "vorder": 31,
    "position": 0,
    "text": "بر اینسان که گژدهم زو یاد کرد"
  },
  {
    "poem_id": 1467,
    "vorder": 32,
    "position": 1,
    "text": "نباید جز از تو ورا هم نبرد"
  },
  {
    "poem_id": 1467,
    "vorder": 33,
    "position": 0,
    "text": "به گیو آنگهی گفت برسان دود"
  },
  {
    "poem_id": 1467,
    "vorder": 34,
    "position": 1,
    "text": "عنان تگاور بباید بسود"
  },
  {
    "poem_id": 1467,
    "vorder": 35,
    "position": 0,
    "text": "بباید که نزدیک رستم شوی"
  },
  {
    "poem_id": 1467,
    "vorder": 36,
    "position": 1,
    "text": "به زابل نمانی و گر نغنوی"
  },
  {
    "poem_id": 1467,
    "vorder": 37,
    "position": 0,
    "text": "اگر شب رسی روز را بازگرد"
  },
  {
    "poem_id": 1467,
    "vorder": 38,
    "position": 1,
    "text": "بگویش که تنگ اندرآمد نبرد"
  },
  {
    "poem_id": 1467,
    "vorder": 39,
    "position": 0,
    "text": "وگرنه فرازست این مرد گرد"
  },
  {
    "poem_id": 1467,
    "vorder": 40,
    "position": 1,
    "text": "بداندیش را خوار نتوان شمرد"
  },
  {
    "poem_id": 1467,
    "vorder": 41,
    "position": 0,
    "text": "ازو نامه بستد به کردار آب"
  },
  {
    "poem_id": 1467,
    "vorder": 42,
    "position": 1,
    "text": "برفت و نجست ایچ آرام و خواب"
  },
  {
    "poem_id": 1467,
    "vorder": 43,
    "position": 0,
    "text": "چو نزدیکی زابلستان رسید"
  },
  {
    "poem_id": 1467,
    "vorder": 44,
    "position": 1,
    "text": "خروش طلایه به دستان رسید"
  },
  {
    "poem_id": 1467,
    "vorder": 45,
    "position": 0,
    "text": "تهمتن پذیره شدش با سپاه"
  },
  {
    "poem_id": 1467,
    "vorder": 46,
    "position": 1,
    "text": "نهادند بر سر بزرگان کلاه"
  },
  {
    "poem_id": 1467,
    "vorder": 47,
    "position": 0,
    "text": "پیاده شدش گیو و گردان بهم"
  },
  {
    "poem_id": 1467,
    "vorder": 48,
    "position": 1,
    "text": "هر آنکس که بودند از بیش و کم"
  },
  {
    "poem_id": 1467,
    "vorder": 49,
    "position": 0,
    "text": "ز اسپ اندرآمد گو نامدار"
  },
  {
    "poem_id": 1467,
    "vorder": 50,
    "position": 1,
    "text": "از ایران بپرسید وز شهریار"
  },
  {
    "poem_id": 1467,
    "vorder": 51,
    "position": 0,
    "text": "ز ره سوی ایوان رستم شدند"
  },
  {
    "poem_id": 1467,
    "vorder": 52,
    "position": 1,
    "text": "ببودند یکبار و دم برزدند"
  },
  {
    "poem_id": 1467,
    "vorder": 53,
    "position": 0,
    "text": "بگفت آنچ بشنید و نامه بداد"
  },
  {
    "poem_id": 1467,
    "vorder": 54,
    "position": 1,
    "text": "ز سهراب چندی سخن کرد یاد"
  },
  {
    "poem_id": 1467,
    "vorder": 55,
    "position": 0,
    "text": "تهمتن چو بشنید و نامه بخواند"
  },
  {
    "poem_id": 1467,
    "vorder": 56,
    "position": 1,
    "text": "بخندید و زان کار خیره بماند"
  },
  {
    "poem_id": 1467,
    "vorder": 57,
    "position": 0,
    "text": "که مانندهٔ سام گرد از مهان"
  },
  {
    "poem_id": 1467,
    "vorder": 58,
    "position": 1,
    "text": "سواری پدید آمد اندر جهان"
  },
  {
    "poem_id": 1467,
    "vorder": 59,
    "position": 0,
    "text": "از آزادگان این نباشد شگفت"
  },
  {
    "poem_id": 1467,
    "vorder": 60,
    "position": 1,
    "text": "ز ترکان چنین یاد نتوان گرفت"
  },
  {
    "poem_id": 1467,
    "vorder": 61,
    "position": 0,
    "text": "من از دخت شاه سمنگان یکی"
  },
  {
    "poem_id": 1467,
    "vorder": 62,
    "position": 1,
    "text": "پسر دارم و باشد او کودکی"
  },
  {
    "poem_id": 1467,
    "vorder": 63,
    "position": 0,
    "text": "هنوز آن گرامی نداند که جنگ"
  },
  {
    "poem_id": 1467,
    "vorder": 64,
    "position": 1,
    "text": "توان کرد باید گه نام و ننگ"
  },
  {
    "poem_id": 1467,
    "vorder": 65,
    "position": 0,
    "text": "فرستادمش زر و گوهر بسی"
  },
  {
    "poem_id": 1467,
    "vorder": 66,
    "position": 1,
    "text": "بر مادر او به دست کسی"
  },
  {
    "poem_id": 1467,
    "vorder": 67,
    "position": 0,
    "text": "چنین پاسخ آمد که آن ارجمند"
  },
  {
    "poem_id": 1467,
    "vorder": 68,
    "position": 1,
    "text": "بسی برنیاید که گردد بلند"
  },
  {
    "poem_id": 1467,
    "vorder": 69,
    "position": 0,
    "text": "همی می خورد با لب شیربوی"
  },
  {
    "poem_id": 1467,
    "vorder": 70,
    "position": 1,
    "text": "شود بی‌گمان زود پرخاشجوی"
  },
  {
    "poem_id": 1467,
    "vorder": 71,
    "position": 0,
    "text": "بباشیم یک روز و دم برزنیم"
  },
  {
    "poem_id": 1467,
    "vorder": 72,
    "position": 1,
    "text": "یکی بر لب خشک نم برزنیم"
  },
  {
    "poem_id": 1467,
    "vorder": 73,
    "position": 0,
    "text": "ازان پس گراییم نزدیک شاه"
  },
  {
    "poem_id": 1467,
    "vorder": 74,
    "position": 1,
    "text": "به گردان ایران نماییم راه"
  },
  {
    "poem_id": 1467,
    "vorder": 75,
    "position": 0,
    "text": "مگر بخت رخشنده بیدار نیست"
  },
  {
    "poem_id": 1467,
    "vorder": 76,
    "position": 1,
    "text": "وگرنه چنین کار دشوار نیست"
  },
  {
    "poem_id": 1467,
    "vorder": 77,
    "position": 0,
    "text": "چو دریا به موج اندرآید ز جای"
  },
  {
    "poem_id": 1467,
    "vorder": 78,
    "position": 1,
    "text": "ندارد دم آتش تیزپای"
  },
  {
    "poem_id": 1467,
    "vorder": 79,
    "position": 0,
    "text": "درفش مرا چون ببیند ز دور"
  },
  {
    "poem_id": 1467,
    "vorder": 80,
    "position": 1,
    "text": "دلش ماتم آرد به هنگام سور"
  },
  {
    "poem_id": 1467,
    "vorder": 81,
    "position": 0,
    "text": "بدین تیزی اندر نیاید به جنگ"
  },
  {
    "poem_id": 1467,
    "vorder": 82,
    "position": 1,
    "text": "نباید گرفتن چنین کار تنگ"
  },
  {
    "poem_id": 1467,
    "vorder": 83,
    "position": 0,
    "text": "به می دست بردند و مستان شدند"
  },
  {
    "poem_id": 1467,
    "vorder": 84,
    "position": 1,
    "text": "ز یاد سپهبد به دستان شدند"
  },
  {
    "poem_id": 1467,
    "vorder": 85,
    "position": 0,
    "text": "دگر روز شبگیر هم پرخمار"
  },
  {
    "poem_id": 1467,
    "vorder": 86,
    "position": 1,
    "text": "بیامد تهمتن برآراست کار"
  },
  {
    "poem_id": 1467,
    "vorder": 87,
    "position": 0,
    "text": "ز مستی هم آن روز باز ایستاد"
  },
  {
    "poem_id": 1467,
    "vorder": 88,
    "position": 1,
    "text": "دوم روز رفتن نیامدش یاد"
  },
  {
    "poem_id": 1467,
    "vorder": 89,
    "position": 0,
    "text": "سه دیگر سحرگه بیاورد می"
  },
  {
    "poem_id": 1467,
    "vorder": 90,
    "position": 1,
    "text": "نیامد ورا یاد کاووس کی"
  },
  {
    "poem_id": 1467,
    "vorder": 91,
    "position": 0,
    "text": "به روز چهارم برآراست گیو"
  },
  {
    "poem_id": 1467,
    "vorder": 92,
    "position": 1,
    "text": "چنین گفت با گرد سالار نیو"
  },
  {
    "poem_id": 1467,
    "vorder": 93,
    "position": 0,
    "text": "که کاووس تندست و هشیار نیست"
  },
  {
    "poem_id": 1467,
    "vorder": 94,
    "position": 1,
    "text": "هم این داستان بر دلش خوار نیست"
  },
  {
    "poem_id": 1467,
    "vorder": 95,
    "position": 0,
    "text": "غمی بود ازین کار و دل پرشتاب"
  },
  {
    "poem_id": 1467,
    "vorder": 96,
    "position": 1,
    "text": "شده دور ازو خورد و آرام و خواب"
  },
  {
    "poem_id": 1467,
    "vorder": 97,
    "position": 0,
    "text": "به زابلستان گر درنگ آوریم"
  },
  {
    "poem_id": 1467,
    "vorder": 98,
    "position": 1,
    "text": "ز می باز پیگار و جنگ آوریم"
  },
  {
    "poem_id": 1467,
    "vorder": 99,
    "position": 0,
    "text": "شود شاه ایران به ما خشمگین"
  },
  {
    "poem_id": 1467,
    "vorder": 100,
    "position": 1,
    "text": "ز ناپاک رایی درآید بکین"
  },
  {
    "poem_id": 1467,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت رستم که مندیش ازین"
  },
  {
    "poem_id": 1467,
    "vorder": 102,
    "position": 1,
    "text": "که با ما نشورد کس اندر زمین"
  },
  {
    "poem_id": 1467,
    "vorder": 103,
    "position": 0,
    "text": "بفرمود تا رخش را زین کنند"
  },
  {
    "poem_id": 1467,
    "vorder": 104,
    "position": 1,
    "text": "دم اندر دم نای رویین کنند"
  },
  {
    "poem_id": 1467,
    "vorder": 105,
    "position": 0,
    "text": "سواران زابل شنیدند نای"
  },
  {
    "poem_id": 1467,
    "vorder": 106,
    "position": 1,
    "text": "برفتند با ترگ و جوشن ز جای"
  }
]