[
  {
    "poem_id": 88100,
    "vorder": 1,
    "position": 0,
    "text": "جهاندیده گودرز برپای خاست"
  },
  {
    "poem_id": 88100,
    "vorder": 2,
    "position": 1,
    "text": "بیاراست با شاه گفتار راست"
  },
  {
    "poem_id": 88100,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت کای شاه پیروز بخت"
  },
  {
    "poem_id": 88100,
    "vorder": 4,
    "position": 1,
    "text": "ندیدیم چون تو خداوند تخت"
  },
  {
    "poem_id": 88100,
    "vorder": 5,
    "position": 0,
    "text": "ز گاه منوچهر تا کیقباد"
  },
  {
    "poem_id": 88100,
    "vorder": 6,
    "position": 1,
    "text": "ز کاووس تا گاه فرخ نژاد"
  },
  {
    "poem_id": 88100,
    "vorder": 7,
    "position": 0,
    "text": "به پیش بزرگان کمر بسته‌ام"
  },
  {
    "poem_id": 88100,
    "vorder": 8,
    "position": 1,
    "text": "بی‌آزار یک روز ننشسته‌ام"
  },
  {
    "poem_id": 88100,
    "vorder": 9,
    "position": 0,
    "text": "نبیره پسر بود هفتاد و هشت"
  },
  {
    "poem_id": 88100,
    "vorder": 10,
    "position": 1,
    "text": "کنون ماند هشت و دگر برگذشت"
  },
  {
    "poem_id": 88100,
    "vorder": 11,
    "position": 0,
    "text": "همان گیو بیداردل هفت سال"
  },
  {
    "poem_id": 88100,
    "vorder": 12,
    "position": 1,
    "text": "به توران زمین بود بی‌خورد و هال"
  },
  {
    "poem_id": 88100,
    "vorder": 13,
    "position": 0,
    "text": "به دشت اندرون گور بد خوردنش"
  },
  {
    "poem_id": 88100,
    "vorder": 14,
    "position": 1,
    "text": "هم از چرم نخچیر پیراهنش"
  },
  {
    "poem_id": 88100,
    "vorder": 15,
    "position": 0,
    "text": "به ایران رسید آنچه بد شاه دید"
  },
  {
    "poem_id": 88100,
    "vorder": 16,
    "position": 1,
    "text": "که تیمار او گیو چندی کشید"
  },
  {
    "poem_id": 88100,
    "vorder": 17,
    "position": 0,
    "text": "جهاندار سیر آمد از تاج و گاه"
  },
  {
    "poem_id": 88100,
    "vorder": 18,
    "position": 1,
    "text": "هم او چشم دارد به نیکی ز شاه"
  },
  {
    "poem_id": 88100,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ که بیش است از این"
  },
  {
    "poem_id": 88100,
    "vorder": 20,
    "position": 1,
    "text": "که بر گیو بادا هزار آفرین"
  },
  {
    "poem_id": 88100,
    "vorder": 21,
    "position": 0,
    "text": "خداوند گیتی ورا یار باد"
  },
  {
    "poem_id": 88100,
    "vorder": 22,
    "position": 1,
    "text": "دل بدسگالانش پرخار باد"
  },
  {
    "poem_id": 88100,
    "vorder": 23,
    "position": 0,
    "text": "کم و بیش ما پاک بر دست تست"
  },
  {
    "poem_id": 88100,
    "vorder": 24,
    "position": 1,
    "text": "که روشن روان بادی و تن درست"
  },
  {
    "poem_id": 88100,
    "vorder": 25,
    "position": 0,
    "text": "بفرمود عهد قم و اصفهان"
  },
  {
    "poem_id": 88100,
    "vorder": 26,
    "position": 1,
    "text": "نهاد بزرگان و جای مهان"
  },
  {
    "poem_id": 88100,
    "vorder": 27,
    "position": 0,
    "text": "نویسد ز مشک و ز عنبر دبیر"
  },
  {
    "poem_id": 88100,
    "vorder": 28,
    "position": 1,
    "text": "یکی نامه از پادشا بر حریر"
  },
  {
    "poem_id": 88100,
    "vorder": 29,
    "position": 0,
    "text": "یکی مهر زرین بر او برنهاد"
  },
  {
    "poem_id": 88100,
    "vorder": 30,
    "position": 1,
    "text": "بر آن نامه شاه آفرین کرد یاد"
  },
  {
    "poem_id": 88100,
    "vorder": 31,
    "position": 0,
    "text": "که یزدان ز گودرز خشنود باد"
  },
  {
    "poem_id": 88100,
    "vorder": 32,
    "position": 1,
    "text": "دل بدسگالانش پر دود باد"
  },
  {
    "poem_id": 88100,
    "vorder": 33,
    "position": 0,
    "text": "به ایرانیان گفت گیو دلیر"
  },
  {
    "poem_id": 88100,
    "vorder": 34,
    "position": 1,
    "text": "مبادا که آید ز کردار سیر"
  },
  {
    "poem_id": 88100,
    "vorder": 35,
    "position": 0,
    "text": "بدانید کو یادگار من است"
  },
  {
    "poem_id": 88100,
    "vorder": 36,
    "position": 1,
    "text": "به نزد شما زینهار من است"
  },
  {
    "poem_id": 88100,
    "vorder": 37,
    "position": 0,
    "text": "مر او را همه پاک فرمان برید"
  },
  {
    "poem_id": 88100,
    "vorder": 38,
    "position": 1,
    "text": "ز گفتار گودرز بر مگذرید"
  },
  {
    "poem_id": 88100,
    "vorder": 39,
    "position": 0,
    "text": "ز گودرزیان هرکه بد پیش‌رو"
  },
  {
    "poem_id": 88100,
    "vorder": 40,
    "position": 1,
    "text": "یکی آفرینی بگسترد نو"
  }
]