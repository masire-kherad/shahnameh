[
  {
    "poem_id": 1919,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد به نزد گراز"
  },
  {
    "poem_id": 1919,
    "vorder": 2,
    "position": 1,
    "text": "که زو بود خسرو به گرم و گداز"
  },
  {
    "poem_id": 1919,
    "vorder": 3,
    "position": 0,
    "text": "فرستاد گوینده‌ای را ز روم"
  },
  {
    "poem_id": 1919,
    "vorder": 4,
    "position": 1,
    "text": "که در خاک شد تاج شیروی شوم"
  },
  {
    "poem_id": 1919,
    "vorder": 5,
    "position": 0,
    "text": "که جانش به دوزخ گرفتار باد"
  },
  {
    "poem_id": 1919,
    "vorder": 6,
    "position": 1,
    "text": "سر دخمهٔ او نگون سار باد"
  },
  {
    "poem_id": 1919,
    "vorder": 7,
    "position": 0,
    "text": "که دانست هرگز که سرو بلند"
  },
  {
    "poem_id": 1919,
    "vorder": 8,
    "position": 1,
    "text": "به باغ از گیا یافت خواهد گزند"
  },
  {
    "poem_id": 1919,
    "vorder": 9,
    "position": 0,
    "text": "چو خسرو که چشم و دل روزگار"
  },
  {
    "poem_id": 1919,
    "vorder": 10,
    "position": 1,
    "text": "نبیند چنو نیز یک شهریار"
  },
  {
    "poem_id": 1919,
    "vorder": 11,
    "position": 0,
    "text": "چو شیروی را شهریاری دهد"
  },
  {
    "poem_id": 1919,
    "vorder": 12,
    "position": 1,
    "text": "همه شهر ایران به خواری دهد"
  },
  {
    "poem_id": 1919,
    "vorder": 13,
    "position": 0,
    "text": "چنو رفت شد تاجدار اردشیر"
  },
  {
    "poem_id": 1919,
    "vorder": 14,
    "position": 1,
    "text": "بدو شادمان جان برنا و پیر"
  },
  {
    "poem_id": 1919,
    "vorder": 15,
    "position": 0,
    "text": "مرا گر ز ایران رسد هیچ بهر"
  },
  {
    "poem_id": 1919,
    "vorder": 16,
    "position": 1,
    "text": "نخواهم که بر وی رسد باد شهر"
  },
  {
    "poem_id": 1919,
    "vorder": 17,
    "position": 0,
    "text": "نبودم من آگه که پرویز شاه"
  },
  {
    "poem_id": 1919,
    "vorder": 18,
    "position": 1,
    "text": "به گفتار آن بدتنان شد تباه"
  },
  {
    "poem_id": 1919,
    "vorder": 19,
    "position": 0,
    "text": "بیایم کنون با سپاهی گران"
  },
  {
    "poem_id": 1919,
    "vorder": 20,
    "position": 1,
    "text": "ز روم و ز ایران گزیده سران"
  },
  {
    "poem_id": 1919,
    "vorder": 21,
    "position": 0,
    "text": "ببینیم تا کیست این کدخدای"
  },
  {
    "poem_id": 1919,
    "vorder": 22,
    "position": 1,
    "text": "که باشد پسندش بدین گونه رای"
  },
  {
    "poem_id": 1919,
    "vorder": 23,
    "position": 0,
    "text": "چنان برکنم بیخ او را ز بن"
  },
  {
    "poem_id": 1919,
    "vorder": 24,
    "position": 1,
    "text": "کزان پس نراند ز شاهی سخن"
  },
  {
    "poem_id": 1919,
    "vorder": 25,
    "position": 0,
    "text": "نوندی برافگند پویان به راه"
  },
  {
    "poem_id": 1919,
    "vorder": 26,
    "position": 1,
    "text": "به نزدیک پیران ایران سپاه"
  },
  {
    "poem_id": 1919,
    "vorder": 27,
    "position": 0,
    "text": "دگرگونه آهنگ بدکامه کرد"
  },
  {
    "poem_id": 1919,
    "vorder": 28,
    "position": 1,
    "text": "به پیروز خسرو یکی نامه کرد"
  },
  {
    "poem_id": 1919,
    "vorder": 29,
    "position": 0,
    "text": "که شد تیره این تخت ساسانیان"
  },
  {
    "poem_id": 1919,
    "vorder": 30,
    "position": 1,
    "text": "جهانجوی باید که بندد میان"
  },
  {
    "poem_id": 1919,
    "vorder": 31,
    "position": 0,
    "text": "توانی مگر چاره‌ای ساختن"
  },
  {
    "poem_id": 1919,
    "vorder": 32,
    "position": 1,
    "text": "ز هرگونه اندیشه انداختن"
  },
  {
    "poem_id": 1919,
    "vorder": 33,
    "position": 0,
    "text": "بجویی بسی یار برنا و پیر"
  },
  {
    "poem_id": 1919,
    "vorder": 34,
    "position": 1,
    "text": "جهان را بپردازی از اردشیر"
  },
  {
    "poem_id": 1919,
    "vorder": 35,
    "position": 0,
    "text": "ازان پس بیابی همه کام خویش"
  },
  {
    "poem_id": 1919,
    "vorder": 36,
    "position": 1,
    "text": "شوی ایمن و شاد زارام خویش"
  },
  {
    "poem_id": 1919,
    "vorder": 37,
    "position": 0,
    "text": "گر ایدون که این راز بیرون دهی"
  },
  {
    "poem_id": 1919,
    "vorder": 38,
    "position": 1,
    "text": "همی خنجر کینه را خون دهی"
  },
  {
    "poem_id": 1919,
    "vorder": 39,
    "position": 0,
    "text": "من از روم چندان سپاه آورم"
  },
  {
    "poem_id": 1919,
    "vorder": 40,
    "position": 1,
    "text": "که گیتی به چشمت سیاه آورم"
  },
  {
    "poem_id": 1919,
    "vorder": 41,
    "position": 0,
    "text": "به ژرفی نگه‌دار گفتار من"
  },
  {
    "poem_id": 1919,
    "vorder": 42,
    "position": 1,
    "text": "مبادا که خوار آیدت کار من"
  },
  {
    "poem_id": 1919,
    "vorder": 43,
    "position": 0,
    "text": "چو پیروز خسرو چنان نامه دید"
  },
  {
    "poem_id": 1919,
    "vorder": 44,
    "position": 1,
    "text": "همه پیش و پس رای خودکامه دید"
  },
  {
    "poem_id": 1919,
    "vorder": 45,
    "position": 0,
    "text": "دل روشن نامور شد تباه"
  },
  {
    "poem_id": 1919,
    "vorder": 46,
    "position": 1,
    "text": "که تا چون کند بد بدان زادشاه"
  },
  {
    "poem_id": 1919,
    "vorder": 47,
    "position": 0,
    "text": "ورا خواندی هر زمان اردشیر"
  },
  {
    "poem_id": 1919,
    "vorder": 48,
    "position": 1,
    "text": "که گوینده مردی بد و یادگیر"
  },
  {
    "poem_id": 1919,
    "vorder": 49,
    "position": 0,
    "text": "برآسای دستور بودی ورا"
  },
  {
    "poem_id": 1919,
    "vorder": 50,
    "position": 1,
    "text": "همان نیز گنجور بودی ورا"
  },
  {
    "poem_id": 1919,
    "vorder": 51,
    "position": 0,
    "text": "بیامد شبی تیره گون بار یافت"
  },
  {
    "poem_id": 1919,
    "vorder": 52,
    "position": 1,
    "text": "می روشن و چرب گفتار یافت"
  },
  {
    "poem_id": 1919,
    "vorder": 53,
    "position": 0,
    "text": "نشسته به ایوان خویش اردشیر"
  },
  {
    "poem_id": 1919,
    "vorder": 54,
    "position": 1,
    "text": "تنی چند با او ز برنا و پیر"
  },
  {
    "poem_id": 1919,
    "vorder": 55,
    "position": 0,
    "text": "چو پیروز خسرو بیامد برش"
  },
  {
    "poem_id": 1919,
    "vorder": 56,
    "position": 1,
    "text": "تو گفتی ز گردون برآمد سرش"
  },
  {
    "poem_id": 1919,
    "vorder": 57,
    "position": 0,
    "text": "بفرمود تا برکشیدند رود"
  },
  {
    "poem_id": 1919,
    "vorder": 58,
    "position": 1,
    "text": "شد ایوان پر از بانگ رود و سرود"
  },
  {
    "poem_id": 1919,
    "vorder": 59,
    "position": 0,
    "text": "چو نیمی شب تیره اندرکشید"
  },
  {
    "poem_id": 1919,
    "vorder": 60,
    "position": 1,
    "text": "سپهبد می یک منی در کشید"
  },
  {
    "poem_id": 1919,
    "vorder": 61,
    "position": 0,
    "text": "شده مست یاران شاه اردشیر"
  },
  {
    "poem_id": 1919,
    "vorder": 62,
    "position": 1,
    "text": "نماند ایچ رامشگر و یادگیر"
  },
  {
    "poem_id": 1919,
    "vorder": 63,
    "position": 0,
    "text": "بد اندیش یاران او را براند"
  },
  {
    "poem_id": 1919,
    "vorder": 64,
    "position": 1,
    "text": "جز از شاه و پیروز خسرو نماند"
  },
  {
    "poem_id": 1919,
    "vorder": 65,
    "position": 0,
    "text": "جفا پیشه از پیش خانه بجست"
  },
  {
    "poem_id": 1919,
    "vorder": 66,
    "position": 1,
    "text": "لب شاه بگرفت ناگه به دست"
  },
  {
    "poem_id": 1919,
    "vorder": 67,
    "position": 0,
    "text": "همی‌داشت تا شد تباه اردشیر"
  },
  {
    "poem_id": 1919,
    "vorder": 68,
    "position": 1,
    "text": "همه کاخ شد پر ز شمشیر و تیر"
  },
  {
    "poem_id": 1919,
    "vorder": 69,
    "position": 0,
    "text": "همه یار پیروز خسرو شدند"
  },
  {
    "poem_id": 1919,
    "vorder": 70,
    "position": 1,
    "text": "اگر نو جهانجوی اگر گو بدند"
  },
  {
    "poem_id": 1919,
    "vorder": 71,
    "position": 0,
    "text": "هیونی برافگند نزد گراز"
  },
  {
    "poem_id": 1919,
    "vorder": 72,
    "position": 1,
    "text": "یکی نامه‌ای نیز با آن دراز"
  },
  {
    "poem_id": 1919,
    "vorder": 73,
    "position": 0,
    "text": "فرستاده چون شد به نزدیک او"
  },
  {
    "poem_id": 1919,
    "vorder": 74,
    "position": 1,
    "text": "چو خورشید شد جان تاریک اوی"
  },
  {
    "poem_id": 1919,
    "vorder": 75,
    "position": 0,
    "text": "بیاورد زان بوم چندان سپاه"
  },
  {
    "poem_id": 1919,
    "vorder": 76,
    "position": 1,
    "text": "که بر مور و بر پشه بر بست راه"
  },
  {
    "poem_id": 1919,
    "vorder": 77,
    "position": 0,
    "text": "همی‌تاخت چون باد تا طیسفون"
  },
  {
    "poem_id": 1919,
    "vorder": 78,
    "position": 1,
    "text": "سپاهش همه دست شسته به خون"
  },
  {
    "poem_id": 1919,
    "vorder": 79,
    "position": 0,
    "text": "ز لشکر نیارست دم زد کسی"
  },
  {
    "poem_id": 1919,
    "vorder": 80,
    "position": 1,
    "text": "نبد خود دران شهر مردم بسی"
  }
]