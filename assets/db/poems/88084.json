[
  {
    "poem_id": 88084,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که گودرز کشوادگان"
  },
  {
    "poem_id": 88084,
    "vorder": 2,
    "position": 1,
    "text": "همی رفت با گیو و آزادگان"
  },
  {
    "poem_id": 88084,
    "vorder": 3,
    "position": 0,
    "text": "گرازان و پویان به نزدیک شاه"
  },
  {
    "poem_id": 88084,
    "vorder": 4,
    "position": 1,
    "text": "به دریا درون کرد چندی نگاه"
  },
  {
    "poem_id": 88084,
    "vorder": 5,
    "position": 0,
    "text": "به چشم آمدش هوم با آن کمند"
  },
  {
    "poem_id": 88084,
    "vorder": 6,
    "position": 1,
    "text": "نوان بر لب آب بر مستمند"
  },
  {
    "poem_id": 88084,
    "vorder": 7,
    "position": 0,
    "text": "همان گونه آب را تیره دید"
  },
  {
    "poem_id": 88084,
    "vorder": 8,
    "position": 1,
    "text": "پرستنده را دیدگان خیره دید"
  },
  {
    "poem_id": 88084,
    "vorder": 9,
    "position": 0,
    "text": "به دل گفت کاین مرد پرهیزگار"
  },
  {
    "poem_id": 88084,
    "vorder": 10,
    "position": 1,
    "text": "ز دریای چیچست گیرد شکار"
  },
  {
    "poem_id": 88084,
    "vorder": 11,
    "position": 0,
    "text": "نهنگی مگر دم ماهی گرفت"
  },
  {
    "poem_id": 88084,
    "vorder": 12,
    "position": 1,
    "text": "به دیدار از او مانده اندر شگفت"
  },
  {
    "poem_id": 88084,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت کای مرد پرهیزگار"
  },
  {
    "poem_id": 88084,
    "vorder": 14,
    "position": 1,
    "text": "نهانی چه داری بکن آشکار"
  },
  {
    "poem_id": 88084,
    "vorder": 15,
    "position": 0,
    "text": "از این آب دریا چه جویی همی"
  },
  {
    "poem_id": 88084,
    "vorder": 16,
    "position": 1,
    "text": "مگر تیره تن را بشویی همی"
  },
  {
    "poem_id": 88084,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت هوم ای سرافراز مرد"
  },
  {
    "poem_id": 88084,
    "vorder": 18,
    "position": 1,
    "text": "نگه کن یکی اندر این کارکرد"
  },
  {
    "poem_id": 88084,
    "vorder": 19,
    "position": 0,
    "text": "یکی جای دارم بدین تیغ کوه"
  },
  {
    "poem_id": 88084,
    "vorder": 20,
    "position": 1,
    "text": "پرستشگه بنده دور از گروه"
  },
  {
    "poem_id": 88084,
    "vorder": 21,
    "position": 0,
    "text": "شب تیره بر پیش یزدان بدم"
  },
  {
    "poem_id": 88084,
    "vorder": 22,
    "position": 1,
    "text": "همه شب ز یزدان پرستان بدم"
  },
  {
    "poem_id": 88084,
    "vorder": 23,
    "position": 0,
    "text": "بدان گه که خیزد ز مرغان خروش"
  },
  {
    "poem_id": 88084,
    "vorder": 24,
    "position": 1,
    "text": "یکی ناله زارم آمد به گوش"
  },
  {
    "poem_id": 88084,
    "vorder": 25,
    "position": 0,
    "text": "همانگه گمان برد روشن دلم"
  },
  {
    "poem_id": 88084,
    "vorder": 26,
    "position": 1,
    "text": "که من بیخ کین از جهان بگسلم"
  },
  {
    "poem_id": 88084,
    "vorder": 27,
    "position": 0,
    "text": "بدین گونه آواز هنگام خواب"
  },
  {
    "poem_id": 88084,
    "vorder": 28,
    "position": 1,
    "text": "نشاید که باشد جز افراسیاب"
  },
  {
    "poem_id": 88084,
    "vorder": 29,
    "position": 0,
    "text": "به جستن گرفتم همه کوه و غار"
  },
  {
    "poem_id": 88084,
    "vorder": 30,
    "position": 1,
    "text": "بدیدم در هنگ آن سوگوار"
  },
  {
    "poem_id": 88084,
    "vorder": 31,
    "position": 0,
    "text": "دو دستش به زنار بستم چو سنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 32,
    "position": 1,
    "text": "بدان سان که خونریز بودش دو چنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 33,
    "position": 0,
    "text": "ز کوه اندر آوردمش تازیان"
  },
  {
    "poem_id": 88084,
    "vorder": 34,
    "position": 1,
    "text": "خروشان و نوحه‌زنان چون زنان"
  },
  {
    "poem_id": 88084,
    "vorder": 35,
    "position": 0,
    "text": "ز بس ناله و بانگ و سوگند اوی"
  },
  {
    "poem_id": 88084,
    "vorder": 36,
    "position": 1,
    "text": "یکی سست کردم همی بند اوی"
  },
  {
    "poem_id": 88084,
    "vorder": 37,
    "position": 0,
    "text": "بدین جایگه در ز چنگم بجست"
  },
  {
    "poem_id": 88084,
    "vorder": 38,
    "position": 1,
    "text": "دل و جانم از رستن او بخست"
  },
  {
    "poem_id": 88084,
    "vorder": 39,
    "position": 0,
    "text": "بدین آب چیچست پنهان شدست"
  },
  {
    "poem_id": 88084,
    "vorder": 40,
    "position": 1,
    "text": "بگفتم ترا راست چونان که هست"
  },
  {
    "poem_id": 88084,
    "vorder": 41,
    "position": 0,
    "text": "چو گودرز بشنید این داستان"
  },
  {
    "poem_id": 88084,
    "vorder": 42,
    "position": 1,
    "text": "بیاد آمدش گفته راستان"
  },
  {
    "poem_id": 88084,
    "vorder": 43,
    "position": 0,
    "text": "از آنجا بشد سوی آتشکده"
  },
  {
    "poem_id": 88084,
    "vorder": 44,
    "position": 1,
    "text": "چنانچون بود مردم دلشده"
  },
  {
    "poem_id": 88084,
    "vorder": 45,
    "position": 0,
    "text": "نخستین بر آتش ستایش گرفت"
  },
  {
    "poem_id": 88084,
    "vorder": 46,
    "position": 1,
    "text": "جهان‌آفرین را نیایش گرفت"
  },
  {
    "poem_id": 88084,
    "vorder": 47,
    "position": 0,
    "text": "بپردخت و بگشاد راز از نهفت"
  },
  {
    "poem_id": 88084,
    "vorder": 48,
    "position": 1,
    "text": "همان دیده بر شهریاران بگفت"
  },
  {
    "poem_id": 88084,
    "vorder": 49,
    "position": 0,
    "text": "همانگه نشستند شاهان بر اسب"
  },
  {
    "poem_id": 88084,
    "vorder": 50,
    "position": 1,
    "text": "برفتند ز ایوان آذر گشسب"
  },
  {
    "poem_id": 88084,
    "vorder": 51,
    "position": 0,
    "text": "پراندیشه شد زآن سخن شهریار"
  },
  {
    "poem_id": 88084,
    "vorder": 52,
    "position": 1,
    "text": "بیامد به نزدیک پرهیزگار"
  },
  {
    "poem_id": 88084,
    "vorder": 53,
    "position": 0,
    "text": "چو هوم آن سر و تاج شاهان بدید"
  },
  {
    "poem_id": 88084,
    "vorder": 54,
    "position": 1,
    "text": "بر ایشان به داد آفرین گسترید"
  },
  {
    "poem_id": 88084,
    "vorder": 55,
    "position": 0,
    "text": "همه شهریاران بر او آفرین"
  },
  {
    "poem_id": 88084,
    "vorder": 56,
    "position": 1,
    "text": "همی خواندند از جهان‌آفرین"
  },
  {
    "poem_id": 88084,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت با هوم کاووس شاه"
  },
  {
    "poem_id": 88084,
    "vorder": 58,
    "position": 1,
    "text": "به یزدان سپاس و بدویم پناه"
  },
  {
    "poem_id": 88084,
    "vorder": 59,
    "position": 0,
    "text": "که دیدم رخ مرد یزدان‌پرست"
  },
  {
    "poem_id": 88084,
    "vorder": 60,
    "position": 1,
    "text": "توانا و با دانش و زور دست"
  },
  {
    "poem_id": 88084,
    "vorder": 61,
    "position": 0,
    "text": "چنین داد پاسخ پرستنده هوم"
  },
  {
    "poem_id": 88084,
    "vorder": 62,
    "position": 1,
    "text": "که آباد بادا به داد تو بوم"
  },
  {
    "poem_id": 88084,
    "vorder": 63,
    "position": 0,
    "text": "بدین شاه‌ نوروز فرخنده باد"
  },
  {
    "poem_id": 88084,
    "vorder": 64,
    "position": 1,
    "text": "دل بدسگالان او کنده باد"
  },
  {
    "poem_id": 88084,
    "vorder": 65,
    "position": 0,
    "text": "پرستنده بودم بدین کوهسار"
  },
  {
    "poem_id": 88084,
    "vorder": 66,
    "position": 1,
    "text": "که بگذشت بر گنگ دژ شهریار"
  },
  {
    "poem_id": 88084,
    "vorder": 67,
    "position": 0,
    "text": "همی خواستم تا جهان‌آفرین"
  },
  {
    "poem_id": 88084,
    "vorder": 68,
    "position": 1,
    "text": "بدو دارد آباد روی زمین"
  },
  {
    "poem_id": 88084,
    "vorder": 69,
    "position": 0,
    "text": "چو باز آمد او شاد و خندان شدم"
  },
  {
    "poem_id": 88084,
    "vorder": 70,
    "position": 1,
    "text": "نیایش کنان پیش یزدان شدم"
  },
  {
    "poem_id": 88084,
    "vorder": 71,
    "position": 0,
    "text": "سروش خجسته شبی ناگهان"
  },
  {
    "poem_id": 88084,
    "vorder": 72,
    "position": 1,
    "text": "بکرد آشکارا به من بر نهان"
  },
  {
    "poem_id": 88084,
    "vorder": 73,
    "position": 0,
    "text": "از این غار بی‌بن برآمد خروش"
  },
  {
    "poem_id": 88084,
    "vorder": 74,
    "position": 1,
    "text": "شنیدم نهادم به آواز گوش"
  },
  {
    "poem_id": 88084,
    "vorder": 75,
    "position": 0,
    "text": "کسی زار بگریست بر تخت عاج"
  },
  {
    "poem_id": 88084,
    "vorder": 76,
    "position": 1,
    "text": "چه بر کشور و لشکر و تیغ و تاج"
  },
  {
    "poem_id": 88084,
    "vorder": 77,
    "position": 0,
    "text": "ز تیغ آمدم سوی آن غار تنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 78,
    "position": 1,
    "text": "کمندی که زنار بودم به چنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 79,
    "position": 0,
    "text": "بدیدم سر و گوش افراسیاب"
  },
  {
    "poem_id": 88084,
    "vorder": 80,
    "position": 1,
    "text": "در او ساخته جای آرام و خواب"
  },
  {
    "poem_id": 88084,
    "vorder": 81,
    "position": 0,
    "text": "به بند کمندش ببستم چو سنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 82,
    "position": 1,
    "text": "کشیدمش بیچاره زآن جای تنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 83,
    "position": 0,
    "text": "به خواهش بدو سست کردم کمند"
  },
  {
    "poem_id": 88084,
    "vorder": 84,
    "position": 1,
    "text": "چو آمد بر آب بگشاد بند"
  },
  {
    "poem_id": 88084,
    "vorder": 85,
    "position": 0,
    "text": "به آب اندرست این زمان ناپدید"
  },
  {
    "poem_id": 88084,
    "vorder": 86,
    "position": 1,
    "text": "پی او ز گیتی بباید برید"
  },
  {
    "poem_id": 88084,
    "vorder": 87,
    "position": 0,
    "text": "ورا گر برد باز گیرد سپهر"
  },
  {
    "poem_id": 88084,
    "vorder": 88,
    "position": 1,
    "text": "بجنبد به گرسیوزش خون و مهر"
  },
  {
    "poem_id": 88084,
    "vorder": 89,
    "position": 0,
    "text": "چو فرمان دهد شهریار بلند"
  },
  {
    "poem_id": 88084,
    "vorder": 90,
    "position": 1,
    "text": "برادرش را پای کرده به بند"
  },
  {
    "poem_id": 88084,
    "vorder": 91,
    "position": 0,
    "text": "بیارند بر کتف او خام گاو"
  },
  {
    "poem_id": 88084,
    "vorder": 92,
    "position": 1,
    "text": "بدوزند تا گم کند زور و تاو"
  },
  {
    "poem_id": 88084,
    "vorder": 93,
    "position": 0,
    "text": "چو آواز او یابد افراسیاب"
  },
  {
    "poem_id": 88084,
    "vorder": 94,
    "position": 1,
    "text": "همانا برآید ز دریای آب"
  },
  {
    "poem_id": 88084,
    "vorder": 95,
    "position": 0,
    "text": "بفرمود تا روزبانان در"
  },
  {
    "poem_id": 88084,
    "vorder": 96,
    "position": 1,
    "text": "برفتند با تیغ و گیلی سپر"
  },
  {
    "poem_id": 88084,
    "vorder": 97,
    "position": 0,
    "text": "ببردند گرسیوز شوم را"
  },
  {
    "poem_id": 88084,
    "vorder": 98,
    "position": 1,
    "text": "که آشوب از او بد بر و بوم را"
  },
  {
    "poem_id": 88084,
    "vorder": 99,
    "position": 0,
    "text": "به دژخیم فرمود تا برکشید"
  },
  {
    "poem_id": 88084,
    "vorder": 100,
    "position": 1,
    "text": "ز رخ پرده شوم را بردرید"
  },
  {
    "poem_id": 88084,
    "vorder": 101,
    "position": 0,
    "text": "همی دوخت بر کتف او خام گاو"
  },
  {
    "poem_id": 88084,
    "vorder": 102,
    "position": 1,
    "text": "چنین تا نماندش به تن هیچ تاو"
  },
  {
    "poem_id": 88084,
    "vorder": 103,
    "position": 0,
    "text": "بر او پوست بدرید و زنهار خواست"
  },
  {
    "poem_id": 88084,
    "vorder": 104,
    "position": 1,
    "text": "جهان آفرین را همی یار خواست"
  },
  {
    "poem_id": 88084,
    "vorder": 105,
    "position": 0,
    "text": "چو بشنید آوازش افراسیاب"
  },
  {
    "poem_id": 88084,
    "vorder": 106,
    "position": 1,
    "text": "پر از درد گریان برآمد ز آب"
  },
  {
    "poem_id": 88084,
    "vorder": 107,
    "position": 0,
    "text": "به دریا همی کرد پای آشناه"
  },
  {
    "poem_id": 88084,
    "vorder": 108,
    "position": 1,
    "text": "بیامد به جایی که بد پایگاه"
  },
  {
    "poem_id": 88084,
    "vorder": 109,
    "position": 0,
    "text": "ز خشکی چو بانگ برادر شنید"
  },
  {
    "poem_id": 88084,
    "vorder": 110,
    "position": 1,
    "text": "بر او بدتر آمد ز مرگ آنچه دید"
  },
  {
    "poem_id": 88084,
    "vorder": 111,
    "position": 0,
    "text": "چو گرسیوز او را بدید اندر آب"
  },
  {
    "poem_id": 88084,
    "vorder": 112,
    "position": 1,
    "text": "دو دیده پر از خون و دل پر شتاب"
  },
  {
    "poem_id": 88084,
    "vorder": 113,
    "position": 0,
    "text": "فغان کرد کای شهریار جهان"
  },
  {
    "poem_id": 88084,
    "vorder": 114,
    "position": 1,
    "text": "سر نامداران و تاج مهان"
  },
  {
    "poem_id": 88084,
    "vorder": 115,
    "position": 0,
    "text": "کجات آن همه رسم و آیین و گاه"
  },
  {
    "poem_id": 88084,
    "vorder": 116,
    "position": 1,
    "text": "کجات آن سر تاج و چندان سپاه"
  },
  {
    "poem_id": 88084,
    "vorder": 117,
    "position": 0,
    "text": "کجات آن همه دانش و زور دست"
  },
  {
    "poem_id": 88084,
    "vorder": 118,
    "position": 1,
    "text": "کجات آن بزرگان خسروپرست"
  },
  {
    "poem_id": 88084,
    "vorder": 119,
    "position": 0,
    "text": "کجات آن به رزم اندرون فر و نام"
  },
  {
    "poem_id": 88084,
    "vorder": 120,
    "position": 1,
    "text": "کجات آن به بزم اندرون کام و جام"
  },
  {
    "poem_id": 88084,
    "vorder": 121,
    "position": 0,
    "text": "که اکنون به دریا نیاز آمدت"
  },
  {
    "poem_id": 88084,
    "vorder": 122,
    "position": 1,
    "text": "چنین اختر دیرساز آمدت"
  },
  {
    "poem_id": 88084,
    "vorder": 123,
    "position": 0,
    "text": "چو بشنید بگریست افراسیاب"
  },
  {
    "poem_id": 88084,
    "vorder": 124,
    "position": 1,
    "text": "همی ریخت خونین سرشک اندر آب"
  },
  {
    "poem_id": 88084,
    "vorder": 125,
    "position": 0,
    "text": "چنین داد پاسخ که گرد جهان"
  },
  {
    "poem_id": 88084,
    "vorder": 126,
    "position": 1,
    "text": "بگشتم همی آشکار و نهان"
  },
  {
    "poem_id": 88084,
    "vorder": 127,
    "position": 0,
    "text": "کز این بخشش بد مگر بگذرم"
  },
  {
    "poem_id": 88084,
    "vorder": 128,
    "position": 1,
    "text": "ز بد بدتر آمد کنون بر سرم"
  },
  {
    "poem_id": 88084,
    "vorder": 129,
    "position": 0,
    "text": "مرا زندگانی کنون خوار گشت"
  },
  {
    "poem_id": 88084,
    "vorder": 130,
    "position": 1,
    "text": "روانم پر از درد و تیمار گشت"
  },
  {
    "poem_id": 88084,
    "vorder": 131,
    "position": 0,
    "text": "نبیرهٔ فریدون و پور پشنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 132,
    "position": 1,
    "text": "برآویخته سر به کام نهنگ"
  },
  {
    "poem_id": 88084,
    "vorder": 133,
    "position": 0,
    "text": "همی پوست درند بر وی به چرم"
  },
  {
    "poem_id": 88084,
    "vorder": 134,
    "position": 1,
    "text": "کسی را نبینم به چشم آب شرم"
  },
  {
    "poem_id": 88084,
    "vorder": 135,
    "position": 0,
    "text": "زبان دو مهتر پر از گفتگوی"
  },
  {
    "poem_id": 88084,
    "vorder": 136,
    "position": 1,
    "text": "روان پرستنده پر جستجوی"
  },
  {
    "poem_id": 88084,
    "vorder": 137,
    "position": 0,
    "text": "چو یزدان پرستنده او را بدید"
  },
  {
    "poem_id": 88084,
    "vorder": 138,
    "position": 1,
    "text": "چنان نوحهٔ زار ایشان شنید"
  },
  {
    "poem_id": 88084,
    "vorder": 139,
    "position": 0,
    "text": "ز راه جزیره برآمد یکی"
  },
  {
    "poem_id": 88084,
    "vorder": 140,
    "position": 1,
    "text": "چو دیدش مر او را ز دور اندکی"
  },
  {
    "poem_id": 88084,
    "vorder": 141,
    "position": 0,
    "text": "گشاد آن کیانی کمند از میان"
  },
  {
    "poem_id": 88084,
    "vorder": 142,
    "position": 1,
    "text": "دو تایی بیامد چو شیر ژیان"
  },
  {
    "poem_id": 88084,
    "vorder": 143,
    "position": 0,
    "text": "بینداخت آن گرد کرده کمند"
  },
  {
    "poem_id": 88084,
    "vorder": 144,
    "position": 1,
    "text": "سر شهریار اندر آمد به بند"
  },
  {
    "poem_id": 88084,
    "vorder": 145,
    "position": 0,
    "text": "به خشکی کشیدش ز دریای آب"
  },
  {
    "poem_id": 88084,
    "vorder": 146,
    "position": 1,
    "text": "بشد توش و هوش از رد افراسیاب"
  },
  {
    "poem_id": 88084,
    "vorder": 147,
    "position": 0,
    "text": "گرفته ورا مرد دین‌دار دست"
  },
  {
    "poem_id": 88084,
    "vorder": 148,
    "position": 1,
    "text": "به خواری ز دریا کشید و ببست"
  },
  {
    "poem_id": 88084,
    "vorder": 149,
    "position": 0,
    "text": "سپردش بدیشان و خود بازگشت"
  },
  {
    "poem_id": 88084,
    "vorder": 150,
    "position": 1,
    "text": "تو گفتی که با باد انباز گشت"
  }
]