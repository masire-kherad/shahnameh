[
  {
    "poem_id": 1705,
    "vorder": 1,
    "position": 0,
    "text": "پراندیشه بود آن شب از کرم شاه"
  },
  {
    "poem_id": 1705,
    "vorder": 2,
    "position": 1,
    "text": "چو بنشست خورشید بر جایگاه"
  },
  {
    "poem_id": 1705,
    "vorder": 3,
    "position": 0,
    "text": "سپه برگرفت از لب آبگیر"
  },
  {
    "poem_id": 1705,
    "vorder": 4,
    "position": 1,
    "text": "سوی پارس آمد دمان اردشیر"
  },
  {
    "poem_id": 1705,
    "vorder": 5,
    "position": 0,
    "text": "پس لشکر او بیامد سپاه"
  },
  {
    "poem_id": 1705,
    "vorder": 6,
    "position": 1,
    "text": "ز هر سو گرفتند بر شاه راه"
  },
  {
    "poem_id": 1705,
    "vorder": 7,
    "position": 0,
    "text": "بکشتند هرکس که بد نامدار"
  },
  {
    "poem_id": 1705,
    "vorder": 8,
    "position": 1,
    "text": "همی تاختند از پس شهریار"
  },
  {
    "poem_id": 1705,
    "vorder": 9,
    "position": 0,
    "text": "خروش آمد از پس که ای بخت کرم"
  },
  {
    "poem_id": 1705,
    "vorder": 10,
    "position": 1,
    "text": "که رخشنده بادا سر از تخت کرم"
  },
  {
    "poem_id": 1705,
    "vorder": 11,
    "position": 0,
    "text": "همی هرکسی گفت کاینت شگفت"
  },
  {
    "poem_id": 1705,
    "vorder": 12,
    "position": 1,
    "text": "کزین هرکس اندازه باید گرفت"
  },
  {
    "poem_id": 1705,
    "vorder": 13,
    "position": 0,
    "text": "بیامد گریزان و دل پر نهیب"
  },
  {
    "poem_id": 1705,
    "vorder": 14,
    "position": 1,
    "text": "همی تاخت اندر فراز و نشیب"
  },
  {
    "poem_id": 1705,
    "vorder": 15,
    "position": 0,
    "text": "یکی شارستان دید جایی بزرگ"
  },
  {
    "poem_id": 1705,
    "vorder": 16,
    "position": 1,
    "text": "ازان سو براندند گردان چو گرگ"
  },
  {
    "poem_id": 1705,
    "vorder": 17,
    "position": 0,
    "text": "چو تنگ اندر آمد یکی خانه دید"
  },
  {
    "poem_id": 1705,
    "vorder": 18,
    "position": 1,
    "text": "به در بر دو برنای بیگانه دید"
  },
  {
    "poem_id": 1705,
    "vorder": 19,
    "position": 0,
    "text": "ببودند بر در زمانی به پای"
  },
  {
    "poem_id": 1705,
    "vorder": 20,
    "position": 1,
    "text": "بپرسید زو این دو پاکیزه‌رای"
  },
  {
    "poem_id": 1705,
    "vorder": 21,
    "position": 0,
    "text": "که بیگه چنین از کجا رفته‌اید"
  },
  {
    "poem_id": 1705,
    "vorder": 22,
    "position": 1,
    "text": "که با گرد راهید و آشفته‌اید"
  },
  {
    "poem_id": 1705,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت زین سو گذشت اردشیر"
  },
  {
    "poem_id": 1705,
    "vorder": 24,
    "position": 1,
    "text": "ازو باز ماندیم بر خیره خیر"
  },
  {
    "poem_id": 1705,
    "vorder": 25,
    "position": 0,
    "text": "که بگریخت از کرم وز هفتواد"
  },
  {
    "poem_id": 1705,
    "vorder": 26,
    "position": 1,
    "text": "وزان بی‌هنر لشکر بدنژاد"
  },
  {
    "poem_id": 1705,
    "vorder": 27,
    "position": 0,
    "text": "بجستند از جای هر دو جوان"
  },
  {
    "poem_id": 1705,
    "vorder": 28,
    "position": 1,
    "text": "پر از درد گشتند و تیره‌روان"
  },
  {
    "poem_id": 1705,
    "vorder": 29,
    "position": 0,
    "text": "فرود آوریدندش از پشت زین"
  },
  {
    "poem_id": 1705,
    "vorder": 30,
    "position": 1,
    "text": "بران مهتران خواندند آفرین"
  },
  {
    "poem_id": 1705,
    "vorder": 31,
    "position": 0,
    "text": "یکی جای خرم بپیراستند"
  },
  {
    "poem_id": 1705,
    "vorder": 32,
    "position": 1,
    "text": "پسندیده خوانی بیاراستند"
  },
  {
    "poem_id": 1705,
    "vorder": 33,
    "position": 0,
    "text": "نشستند با شاه گردان به خوان"
  },
  {
    "poem_id": 1705,
    "vorder": 34,
    "position": 1,
    "text": "پرستش گرفتند هر دو جوان"
  },
  {
    "poem_id": 1705,
    "vorder": 35,
    "position": 0,
    "text": "به آواز گفتند کای سرفراز"
  },
  {
    "poem_id": 1705,
    "vorder": 36,
    "position": 1,
    "text": "غم و شادمانی نماند دراز"
  },
  {
    "poem_id": 1705,
    "vorder": 37,
    "position": 0,
    "text": "نگه کن که ضحاک بیدادگر"
  },
  {
    "poem_id": 1705,
    "vorder": 38,
    "position": 1,
    "text": "چه آورد زان تخت شاهی به سر"
  },
  {
    "poem_id": 1705,
    "vorder": 39,
    "position": 0,
    "text": "هم افراسیاب آن بداندیش مرد"
  },
  {
    "poem_id": 1705,
    "vorder": 40,
    "position": 1,
    "text": "کزو بد دل شهریاران به درد"
  },
  {
    "poem_id": 1705,
    "vorder": 41,
    "position": 0,
    "text": "سکندر که آمد برین روزگار"
  },
  {
    "poem_id": 1705,
    "vorder": 42,
    "position": 1,
    "text": "بکشت آنک بد در جهان شهریار"
  },
  {
    "poem_id": 1705,
    "vorder": 43,
    "position": 0,
    "text": "برفتند و زیشان به جز نام زشت"
  },
  {
    "poem_id": 1705,
    "vorder": 44,
    "position": 1,
    "text": "نماند و نیابند خرم بهشت"
  },
  {
    "poem_id": 1705,
    "vorder": 45,
    "position": 0,
    "text": "نماند همین نیز بر هفتواد"
  },
  {
    "poem_id": 1705,
    "vorder": 46,
    "position": 1,
    "text": "بپیچد به فرجام این بدنژاد"
  },
  {
    "poem_id": 1705,
    "vorder": 47,
    "position": 0,
    "text": "ز گفتار ایشان دل شهریار"
  },
  {
    "poem_id": 1705,
    "vorder": 48,
    "position": 1,
    "text": "چنان تازه شد چون گل اندر بهار"
  },
  {
    "poem_id": 1705,
    "vorder": 49,
    "position": 0,
    "text": "خوش آمدش گفتار آن دلنواز"
  },
  {
    "poem_id": 1705,
    "vorder": 50,
    "position": 1,
    "text": "بکرد آشکارا و بنمود راز"
  },
  {
    "poem_id": 1705,
    "vorder": 51,
    "position": 0,
    "text": "که فرزند ساسان منم اردشیر"
  },
  {
    "poem_id": 1705,
    "vorder": 52,
    "position": 1,
    "text": "یکی پند باید مرا دلپذیر"
  },
  {
    "poem_id": 1705,
    "vorder": 53,
    "position": 0,
    "text": "چه سازیم با کرم و با هفتواد"
  },
  {
    "poem_id": 1705,
    "vorder": 54,
    "position": 1,
    "text": "که نام و نژادش به گیتی مباد"
  },
  {
    "poem_id": 1705,
    "vorder": 55,
    "position": 0,
    "text": "سپهبدار ایران چو بگشاد راز"
  },
  {
    "poem_id": 1705,
    "vorder": 56,
    "position": 1,
    "text": "جوانانش بردند هر دو نماز"
  },
  {
    "poem_id": 1705,
    "vorder": 57,
    "position": 0,
    "text": "بگفتند هر دو که نوشه بدی"
  },
  {
    "poem_id": 1705,
    "vorder": 58,
    "position": 1,
    "text": "همیشه ز تو دور دست بدی"
  },
  {
    "poem_id": 1705,
    "vorder": 59,
    "position": 0,
    "text": "تن و جان ما پیش تو بنده باد"
  },
  {
    "poem_id": 1705,
    "vorder": 60,
    "position": 1,
    "text": "همیشه روان تو پاینده باد"
  },
  {
    "poem_id": 1705,
    "vorder": 61,
    "position": 0,
    "text": "سخنها که پرسیدی از ما درست"
  },
  {
    "poem_id": 1705,
    "vorder": 62,
    "position": 1,
    "text": "بگوییم تا چاره سازی نخست"
  },
  {
    "poem_id": 1705,
    "vorder": 63,
    "position": 0,
    "text": "تو در جنگ با کرم و با هفتواد"
  },
  {
    "poem_id": 1705,
    "vorder": 64,
    "position": 1,
    "text": "بسنده نه‌ای گر نپیچی ز داد"
  },
  {
    "poem_id": 1705,
    "vorder": 65,
    "position": 0,
    "text": "یکی جای دارند بر تیغ کوه"
  },
  {
    "poem_id": 1705,
    "vorder": 66,
    "position": 1,
    "text": "بدو اندرون کرم و گنج و گروه"
  },
  {
    "poem_id": 1705,
    "vorder": 67,
    "position": 0,
    "text": "به پیش اندرون شهر و دریا بپشت"
  },
  {
    "poem_id": 1705,
    "vorder": 68,
    "position": 1,
    "text": "دژی بر سر کوه و راهی درشت"
  },
  {
    "poem_id": 1705,
    "vorder": 69,
    "position": 0,
    "text": "همان کرم کز مغز آهرمنست"
  },
  {
    "poem_id": 1705,
    "vorder": 70,
    "position": 1,
    "text": "جهان آفریننده را دشمنست"
  },
  {
    "poem_id": 1705,
    "vorder": 71,
    "position": 0,
    "text": "همی کرم خوانی به چرم اندرون"
  },
  {
    "poem_id": 1705,
    "vorder": 72,
    "position": 1,
    "text": "یکی دیو جنگیست ریزنده خون"
  },
  {
    "poem_id": 1705,
    "vorder": 73,
    "position": 0,
    "text": "سخنها چو بشنید زو اردشیر"
  },
  {
    "poem_id": 1705,
    "vorder": 74,
    "position": 1,
    "text": "همه مهر جوینده و دلپذیر"
  },
  {
    "poem_id": 1705,
    "vorder": 75,
    "position": 0,
    "text": "بدیشان چنین گفت کآری رواست"
  },
  {
    "poem_id": 1705,
    "vorder": 76,
    "position": 1,
    "text": "بد و نیک ایشان مرا با شماست"
  },
  {
    "poem_id": 1705,
    "vorder": 77,
    "position": 0,
    "text": "جوانان ورا پاسخ آراستند"
  },
  {
    "poem_id": 1705,
    "vorder": 78,
    "position": 1,
    "text": "دل هوشمندش بپیراستند"
  },
  {
    "poem_id": 1705,
    "vorder": 79,
    "position": 0,
    "text": "که ما بندگانیم پیشت به پای"
  },
  {
    "poem_id": 1705,
    "vorder": 80,
    "position": 1,
    "text": "همیشه به نیکی ترا رهنمای"
  },
  {
    "poem_id": 1705,
    "vorder": 81,
    "position": 0,
    "text": "ز گفتار ایشان دلش گشت شاد"
  },
  {
    "poem_id": 1705,
    "vorder": 82,
    "position": 1,
    "text": "همی رفت پیروز و دل پر ز داد"
  },
  {
    "poem_id": 1705,
    "vorder": 83,
    "position": 0,
    "text": "چو برداشت زانجا جهاندار شاه"
  },
  {
    "poem_id": 1705,
    "vorder": 84,
    "position": 1,
    "text": "جوانان برفتند با او به راه"
  },
  {
    "poem_id": 1705,
    "vorder": 85,
    "position": 0,
    "text": "همی رفت روشن‌دل و یادگیر"
  },
  {
    "poem_id": 1705,
    "vorder": 86,
    "position": 1,
    "text": "سرافراز تا خورهٔ اردشیر"
  },
  {
    "poem_id": 1705,
    "vorder": 87,
    "position": 0,
    "text": "چو بر شاه بر شد سپاه انجمن"
  },
  {
    "poem_id": 1705,
    "vorder": 88,
    "position": 1,
    "text": "بزرگان فرزانه و رای‌زن"
  },
  {
    "poem_id": 1705,
    "vorder": 89,
    "position": 0,
    "text": "برآسود یک چند و روزی به داد"
  },
  {
    "poem_id": 1705,
    "vorder": 90,
    "position": 1,
    "text": "بیامد سوی مهرک نوش‌زاد"
  },
  {
    "poem_id": 1705,
    "vorder": 91,
    "position": 0,
    "text": "چو مهرک بیارست رفتن به جنگ"
  },
  {
    "poem_id": 1705,
    "vorder": 92,
    "position": 1,
    "text": "جهان کرد بر خویشتن تار و تنگ"
  },
  {
    "poem_id": 1705,
    "vorder": 93,
    "position": 0,
    "text": "به جهرم چو نزدیک شد پادشا"
  },
  {
    "poem_id": 1705,
    "vorder": 94,
    "position": 1,
    "text": "نهان گشت زو مهرک بی‌وفا"
  },
  {
    "poem_id": 1705,
    "vorder": 95,
    "position": 0,
    "text": "دل پادشا پر ز پیکار شد"
  },
  {
    "poem_id": 1705,
    "vorder": 96,
    "position": 1,
    "text": "همی بود تا او گرفتار شد"
  },
  {
    "poem_id": 1705,
    "vorder": 97,
    "position": 0,
    "text": "به شمشیر هندی بزد گردنش"
  },
  {
    "poem_id": 1705,
    "vorder": 98,
    "position": 1,
    "text": "به آتش در انداخت بی‌سر تنش"
  },
  {
    "poem_id": 1705,
    "vorder": 99,
    "position": 0,
    "text": "هرانکس کزان تخمه آمد به مشت"
  },
  {
    "poem_id": 1705,
    "vorder": 100,
    "position": 1,
    "text": "به خنجر هم اندر زمانش بکشت"
  },
  {
    "poem_id": 1705,
    "vorder": 101,
    "position": 0,
    "text": "مگر دختری کان نهان گشت زوی"
  },
  {
    "poem_id": 1705,
    "vorder": 102,
    "position": 1,
    "text": "همه شهر ازو گشت پر جست و جوی"
  }
]