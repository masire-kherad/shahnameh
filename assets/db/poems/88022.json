[
  {
    "poem_id": 88022,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید سر برزد از کوهسار"
  },
  {
    "poem_id": 88022,
    "vorder": 2,
    "position": 1,
    "text": "سواران توران ببستند بار"
  },
  {
    "poem_id": 88022,
    "vorder": 3,
    "position": 0,
    "text": "بتوفید شهر و برآمد خروش"
  },
  {
    "poem_id": 88022,
    "vorder": 4,
    "position": 1,
    "text": "تو گفتی همی کر کند نعره گوش"
  },
  {
    "poem_id": 88022,
    "vorder": 5,
    "position": 0,
    "text": "بدرگاه افراسیاب آمدند"
  },
  {
    "poem_id": 88022,
    "vorder": 6,
    "position": 1,
    "text": "کمربستگان بر درش صف زدند"
  },
  {
    "poem_id": 88022,
    "vorder": 7,
    "position": 0,
    "text": "همه یکسره جنگ را ساخته"
  },
  {
    "poem_id": 88022,
    "vorder": 8,
    "position": 1,
    "text": "دل از بوم و آرام پرداخته"
  },
  {
    "poem_id": 88022,
    "vorder": 9,
    "position": 0,
    "text": "بزرگان توران گشاده کمر"
  },
  {
    "poem_id": 88022,
    "vorder": 10,
    "position": 1,
    "text": "به پیش سپهدار بر خاک سر"
  },
  {
    "poem_id": 88022,
    "vorder": 11,
    "position": 0,
    "text": "همه جنگ را پاک بسته میان"
  },
  {
    "poem_id": 88022,
    "vorder": 12,
    "position": 1,
    "text": "همه دل پر از کین ایرانیان"
  },
  {
    "poem_id": 88022,
    "vorder": 13,
    "position": 0,
    "text": "کز اندازه بگذشت ما را سخن"
  },
  {
    "poem_id": 88022,
    "vorder": 14,
    "position": 1,
    "text": "چه افگند باید بدین کار بن"
  },
  {
    "poem_id": 88022,
    "vorder": 15,
    "position": 0,
    "text": "کزین ننگ بر شاه و گردنکشان"
  },
  {
    "poem_id": 88022,
    "vorder": 16,
    "position": 1,
    "text": "بماند ز کردار بیژن نشان"
  },
  {
    "poem_id": 88022,
    "vorder": 17,
    "position": 0,
    "text": "بایران بمردان ندانندمان"
  },
  {
    "poem_id": 88022,
    "vorder": 18,
    "position": 1,
    "text": "زنان کمربسته خوانندمان"
  },
  {
    "poem_id": 88022,
    "vorder": 19,
    "position": 0,
    "text": "برآشفت پس شه بسان پلنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 20,
    "position": 1,
    "text": "ازان پس بفرمودشان ساز جنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 21,
    "position": 0,
    "text": "به پیران بفرمود تا بست کوس"
  },
  {
    "poem_id": 88022,
    "vorder": 22,
    "position": 1,
    "text": "که بر ما ز ایران همین بد فسوس"
  },
  {
    "poem_id": 88022,
    "vorder": 23,
    "position": 0,
    "text": "بزد نای رویین بدرگاه شاه"
  },
  {
    "poem_id": 88022,
    "vorder": 24,
    "position": 1,
    "text": "بجوشید در شهر توران سپاه"
  },
  {
    "poem_id": 88022,
    "vorder": 25,
    "position": 0,
    "text": "یلان صف کشیدند بر در سرای"
  },
  {
    "poem_id": 88022,
    "vorder": 26,
    "position": 1,
    "text": "خروش آمد از بوق و هندی درای"
  },
  {
    "poem_id": 88022,
    "vorder": 27,
    "position": 0,
    "text": "سپاهی ز توران بدان مرز راند"
  },
  {
    "poem_id": 88022,
    "vorder": 28,
    "position": 1,
    "text": "که روی زمین جز بدریا نماند"
  },
  {
    "poem_id": 88022,
    "vorder": 29,
    "position": 0,
    "text": "چو از دیدگه دیدبان بنگرید"
  },
  {
    "poem_id": 88022,
    "vorder": 30,
    "position": 1,
    "text": "زمین را چو دریای جوشان بدید"
  },
  {
    "poem_id": 88022,
    "vorder": 31,
    "position": 0,
    "text": "بر رستم آمد که ببسیچ کار"
  },
  {
    "poem_id": 88022,
    "vorder": 32,
    "position": 1,
    "text": "که گیتی سیه شد ز گرد سوار"
  },
  {
    "poem_id": 88022,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت ما زین نداریم باک"
  },
  {
    "poem_id": 88022,
    "vorder": 34,
    "position": 1,
    "text": "همی جنگ را برفشانیم خاک"
  },
  {
    "poem_id": 88022,
    "vorder": 35,
    "position": 0,
    "text": "بنه با منیژه گسی کرد و بار"
  },
  {
    "poem_id": 88022,
    "vorder": 36,
    "position": 1,
    "text": "بپوشید خود جامهٔ کارزار"
  },
  {
    "poem_id": 88022,
    "vorder": 37,
    "position": 0,
    "text": "ببالا برآمد سپه را بدید"
  },
  {
    "poem_id": 88022,
    "vorder": 38,
    "position": 1,
    "text": "خروشی چو شیر ژیان برکشید"
  },
  {
    "poem_id": 88022,
    "vorder": 39,
    "position": 0,
    "text": "یکی داستان زد سوار دلیر"
  },
  {
    "poem_id": 88022,
    "vorder": 40,
    "position": 1,
    "text": "که روبه چه سنجد بچنگال شیر"
  },
  {
    "poem_id": 88022,
    "vorder": 41,
    "position": 0,
    "text": "بگردان جنگاور آواز کرد"
  },
  {
    "poem_id": 88022,
    "vorder": 42,
    "position": 1,
    "text": "که پیش آمد امروز ننگ و نبرد"
  },
  {
    "poem_id": 88022,
    "vorder": 43,
    "position": 0,
    "text": "کجا تیغ و ژوپین زهرآبدار"
  },
  {
    "poem_id": 88022,
    "vorder": 44,
    "position": 1,
    "text": "کجا نیزه و گُرزهٔ گاوسار"
  },
  {
    "poem_id": 88022,
    "vorder": 45,
    "position": 0,
    "text": "هنرها کنون کرد باید پدید"
  },
  {
    "poem_id": 88022,
    "vorder": 46,
    "position": 1,
    "text": "برین دشت‌بر کینه باید کشید"
  },
  {
    "poem_id": 88022,
    "vorder": 47,
    "position": 0,
    "text": "برآمد خروشیدن کرنای"
  },
  {
    "poem_id": 88022,
    "vorder": 48,
    "position": 1,
    "text": "تهمتن برخش اندر آورد پای"
  },
  {
    "poem_id": 88022,
    "vorder": 49,
    "position": 0,
    "text": "ازان کوه سر سوی هامون کشید"
  },
  {
    "poem_id": 88022,
    "vorder": 50,
    "position": 1,
    "text": "چو لشکر بتنگ اندر آمد پدید"
  },
  {
    "poem_id": 88022,
    "vorder": 51,
    "position": 0,
    "text": "کشیدند لشکر بران پهن جای"
  },
  {
    "poem_id": 88022,
    "vorder": 52,
    "position": 1,
    "text": "بهرسو ببستند ز آهن سرای"
  },
  {
    "poem_id": 88022,
    "vorder": 53,
    "position": 0,
    "text": "بیاراست رستم یکی رزمگاه"
  },
  {
    "poem_id": 88022,
    "vorder": 54,
    "position": 1,
    "text": "که از گرد اسبان هوا شد سیاه"
  },
  {
    "poem_id": 88022,
    "vorder": 55,
    "position": 0,
    "text": "ابر میمنه اشکش و گستهم"
  },
  {
    "poem_id": 88022,
    "vorder": 56,
    "position": 1,
    "text": "سواران بسیار با او بهم"
  },
  {
    "poem_id": 88022,
    "vorder": 57,
    "position": 0,
    "text": "چو رهام و چون زنگه بر میسره"
  },
  {
    "poem_id": 88022,
    "vorder": 58,
    "position": 1,
    "text": "بخون داده مر جنگ را یکسره"
  },
  {
    "poem_id": 88022,
    "vorder": 59,
    "position": 0,
    "text": "خود و بیژن گیو در قلبگاه"
  },
  {
    "poem_id": 88022,
    "vorder": 60,
    "position": 1,
    "text": "نگهدار گردان و پشت سپاه"
  },
  {
    "poem_id": 88022,
    "vorder": 61,
    "position": 0,
    "text": "پس پشت لشکر که بیستون"
  },
  {
    "poem_id": 88022,
    "vorder": 62,
    "position": 1,
    "text": "حصاری ز شمشیر پیش اندرون"
  },
  {
    "poem_id": 88022,
    "vorder": 63,
    "position": 0,
    "text": "چو افراسیاب آن سپه را بدید"
  },
  {
    "poem_id": 88022,
    "vorder": 64,
    "position": 1,
    "text": "که سالارشان رستم آمد پدید"
  },
  {
    "poem_id": 88022,
    "vorder": 65,
    "position": 0,
    "text": "غمی گشت و پوشید خفتان جنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 66,
    "position": 1,
    "text": "سپه را بفرمود کردن درنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 67,
    "position": 0,
    "text": "برابر به‌آیین صفی برکشید"
  },
  {
    "poem_id": 88022,
    "vorder": 68,
    "position": 1,
    "text": "هوا نیلگون شد زمین ناپدید"
  },
  {
    "poem_id": 88022,
    "vorder": 69,
    "position": 0,
    "text": "چپ لشکرش را بپیران سپرد"
  },
  {
    "poem_id": 88022,
    "vorder": 70,
    "position": 1,
    "text": "سوی راستش را به هومان گرد"
  },
  {
    "poem_id": 88022,
    "vorder": 71,
    "position": 0,
    "text": "بگرسیوز و شیده قلب سپاه"
  },
  {
    "poem_id": 88022,
    "vorder": 72,
    "position": 1,
    "text": "سپرد و همی کرد هر سو نگاه"
  },
  {
    "poem_id": 88022,
    "vorder": 73,
    "position": 0,
    "text": "تهمتن همی گشت گرد سپاه"
  },
  {
    "poem_id": 88022,
    "vorder": 74,
    "position": 1,
    "text": "ز آهن بکردار کوهی سیاه"
  },
  {
    "poem_id": 88022,
    "vorder": 75,
    "position": 0,
    "text": "فغان کرد کای ترک شوریده بخت"
  },
  {
    "poem_id": 88022,
    "vorder": 76,
    "position": 1,
    "text": "که ننگی تو بر لشکر و تاج و تخت"
  },
  {
    "poem_id": 88022,
    "vorder": 77,
    "position": 0,
    "text": "ترا چون سواران دل جنگ نیست"
  },
  {
    "poem_id": 88022,
    "vorder": 78,
    "position": 1,
    "text": "ز گردان لشکر ترا ننگ نیست"
  },
  {
    "poem_id": 88022,
    "vorder": 79,
    "position": 0,
    "text": "که چندین بپیش من آیی بکین"
  },
  {
    "poem_id": 88022,
    "vorder": 80,
    "position": 1,
    "text": "بمردان و اسبان بپوشی زمین"
  },
  {
    "poem_id": 88022,
    "vorder": 81,
    "position": 0,
    "text": "چو در جنگ لشکر شود تیزچنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 82,
    "position": 1,
    "text": "همی پشت بینم ترا سوی جنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 83,
    "position": 0,
    "text": "ز دستان تو نشنیدی آن داستان"
  },
  {
    "poem_id": 88022,
    "vorder": 84,
    "position": 1,
    "text": "که دارد بیاد از گه باستان"
  },
  {
    "poem_id": 88022,
    "vorder": 85,
    "position": 0,
    "text": "که شیری نترسد ز یک دشت گور"
  },
  {
    "poem_id": 88022,
    "vorder": 86,
    "position": 1,
    "text": "ستاره نتابد چو تابنده هور"
  },
  {
    "poem_id": 88022,
    "vorder": 87,
    "position": 0,
    "text": "بدرد دل و گوش غرم سترگ"
  },
  {
    "poem_id": 88022,
    "vorder": 88,
    "position": 1,
    "text": "اگر بشنود نام چنگال گرگ"
  },
  {
    "poem_id": 88022,
    "vorder": 89,
    "position": 0,
    "text": "چو اندر هوا باز گسترد پر"
  },
  {
    "poem_id": 88022,
    "vorder": 90,
    "position": 1,
    "text": "بترسد ز چنگال او کبک نر"
  },
  {
    "poem_id": 88022,
    "vorder": 91,
    "position": 0,
    "text": "نه روبه شود ز آزمودن دلیر"
  },
  {
    "poem_id": 88022,
    "vorder": 92,
    "position": 1,
    "text": "نه گوران بسایند چنگال شیر"
  },
  {
    "poem_id": 88022,
    "vorder": 93,
    "position": 0,
    "text": "چو تو کس سبکسار خسرو مباد"
  },
  {
    "poem_id": 88022,
    "vorder": 94,
    "position": 1,
    "text": "چو باشد دهد پادشاهی بباد"
  },
  {
    "poem_id": 88022,
    "vorder": 95,
    "position": 0,
    "text": "بدین دشت و هامون تو از دست من"
  },
  {
    "poem_id": 88022,
    "vorder": 96,
    "position": 1,
    "text": "رهایی نیابی بجان و بتن"
  },
  {
    "poem_id": 88022,
    "vorder": 97,
    "position": 0,
    "text": "چو این گفته بشنید ترک دژم"
  },
  {
    "poem_id": 88022,
    "vorder": 98,
    "position": 1,
    "text": "بلرزید و برزد یکی تیز دم"
  },
  {
    "poem_id": 88022,
    "vorder": 99,
    "position": 0,
    "text": "برآشفت کای نامداران تور"
  },
  {
    "poem_id": 88022,
    "vorder": 100,
    "position": 1,
    "text": "که این دشت جنگست گر جای سور"
  },
  {
    "poem_id": 88022,
    "vorder": 101,
    "position": 0,
    "text": "بباید کشیدن درین رزم رنج"
  },
  {
    "poem_id": 88022,
    "vorder": 102,
    "position": 1,
    "text": "که بخشم شما رابسی تاج و گنج"
  },
  {
    "poem_id": 88022,
    "vorder": 103,
    "position": 0,
    "text": "چو گفتار سالارشان شد بگوش"
  },
  {
    "poem_id": 88022,
    "vorder": 104,
    "position": 1,
    "text": "زگردان لشکر برآمد خروش"
  },
  {
    "poem_id": 88022,
    "vorder": 105,
    "position": 0,
    "text": "چنان تیره‌گون شد ز گرد آفتاب"
  },
  {
    "poem_id": 88022,
    "vorder": 106,
    "position": 1,
    "text": "که گفتی همی غرقه ماند در آب"
  },
  {
    "poem_id": 88022,
    "vorder": 107,
    "position": 0,
    "text": "ببستند بر پیل رویینه خم"
  },
  {
    "poem_id": 88022,
    "vorder": 108,
    "position": 1,
    "text": "دمیدند شیپور با گاودم"
  },
  {
    "poem_id": 88022,
    "vorder": 109,
    "position": 0,
    "text": "ز جوشن یکی بارهٔ آهنین"
  },
  {
    "poem_id": 88022,
    "vorder": 110,
    "position": 1,
    "text": "کشیدند گردان بروی زمین"
  },
  {
    "poem_id": 88022,
    "vorder": 111,
    "position": 0,
    "text": "بجوشید دشت و بتوفید کوه"
  },
  {
    "poem_id": 88022,
    "vorder": 112,
    "position": 1,
    "text": "ز بانگ سواران هر دو گروه"
  },
  {
    "poem_id": 88022,
    "vorder": 113,
    "position": 0,
    "text": "درفشان بگرد اندرون تیغ تیز"
  },
  {
    "poem_id": 88022,
    "vorder": 114,
    "position": 1,
    "text": "تو گفتی برآمد همی رستخیز"
  },
  {
    "poem_id": 88022,
    "vorder": 115,
    "position": 0,
    "text": "همی گُرز بارید همچون تگرگ"
  },
  {
    "poem_id": 88022,
    "vorder": 116,
    "position": 1,
    "text": "ابر جوشن و تیر و بر خود و ترگ"
  },
  {
    "poem_id": 88022,
    "vorder": 117,
    "position": 0,
    "text": "و زان رستمی اژدهافش درفش"
  },
  {
    "poem_id": 88022,
    "vorder": 118,
    "position": 1,
    "text": "شده روی خورشید تابان بنفش"
  },
  {
    "poem_id": 88022,
    "vorder": 119,
    "position": 0,
    "text": "بپوشید روی هوا گرد پیل"
  },
  {
    "poem_id": 88022,
    "vorder": 120,
    "position": 1,
    "text": "بخورشید گفتی براندود نیل"
  },
  {
    "poem_id": 88022,
    "vorder": 121,
    "position": 0,
    "text": "بهر سو که رستم برافگند رخش"
  },
  {
    "poem_id": 88022,
    "vorder": 122,
    "position": 1,
    "text": "سران را سر از تن همی کرد بخش"
  },
  {
    "poem_id": 88022,
    "vorder": 123,
    "position": 0,
    "text": "به چنگ اندرون گُرزهٔ گاوسار"
  },
  {
    "poem_id": 88022,
    "vorder": 124,
    "position": 1,
    "text": "بسان هیونی گسسته مهار"
  },
  {
    "poem_id": 88022,
    "vorder": 125,
    "position": 0,
    "text": "همی کشت و می‌بست در رزمگاه"
  },
  {
    "poem_id": 88022,
    "vorder": 126,
    "position": 1,
    "text": "چو بسیار کرد از بزرگان تباه"
  },
  {
    "poem_id": 88022,
    "vorder": 127,
    "position": 0,
    "text": "بقلب اندر آمد بکردار گرگ"
  },
  {
    "poem_id": 88022,
    "vorder": 128,
    "position": 1,
    "text": "پراگنده کرد آن سپاه بزرگ"
  },
  {
    "poem_id": 88022,
    "vorder": 129,
    "position": 0,
    "text": "برآمد چو باد آن سران را ز جای"
  },
  {
    "poem_id": 88022,
    "vorder": 130,
    "position": 1,
    "text": "همان بادپایان فرخ همای"
  },
  {
    "poem_id": 88022,
    "vorder": 131,
    "position": 0,
    "text": "چو گرگین و رهام و فرهاد گرد"
  },
  {
    "poem_id": 88022,
    "vorder": 132,
    "position": 1,
    "text": "چپ لشکر شاه توران ببرد"
  },
  {
    "poem_id": 88022,
    "vorder": 133,
    "position": 0,
    "text": "درآمد چو باد اشکش از دست راست"
  },
  {
    "poem_id": 88022,
    "vorder": 134,
    "position": 1,
    "text": "ز گرسیوز تیغ‌زن کینه خواست"
  },
  {
    "poem_id": 88022,
    "vorder": 135,
    "position": 0,
    "text": "بقلب اندرون بیژن تیزچنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 136,
    "position": 1,
    "text": "همی بزمگاه آمدش جای جنگ"
  },
  {
    "poem_id": 88022,
    "vorder": 137,
    "position": 0,
    "text": "سران سواران چو برگ درخت"
  },
  {
    "poem_id": 88022,
    "vorder": 138,
    "position": 1,
    "text": "فرو ریخت از بار و برگشت بخت"
  },
  {
    "poem_id": 88022,
    "vorder": 139,
    "position": 0,
    "text": "همه رزمگه سربسر جوی خون"
  },
  {
    "poem_id": 88022,
    "vorder": 140,
    "position": 1,
    "text": "درفش سپهدار توران نگون"
  },
  {
    "poem_id": 88022,
    "vorder": 141,
    "position": 0,
    "text": "سپهدار چون بخت برگشته دید"
  },
  {
    "poem_id": 88022,
    "vorder": 142,
    "position": 1,
    "text": "دلیران توران همه کشته دید"
  },
  {
    "poem_id": 88022,
    "vorder": 143,
    "position": 0,
    "text": "بیفگند شمشیر هندی ز دست"
  },
  {
    "poem_id": 88022,
    "vorder": 144,
    "position": 1,
    "text": "یکی اسب آسوده‌تر برنشست"
  },
  {
    "poem_id": 88022,
    "vorder": 145,
    "position": 0,
    "text": "خود و ویژگان سوی توران شتافت"
  },
  {
    "poem_id": 88022,
    "vorder": 146,
    "position": 1,
    "text": "کزایرانیان کام و کینه نیافت"
  },
  {
    "poem_id": 88022,
    "vorder": 147,
    "position": 0,
    "text": "برفت از پسش رستم گرد گیر"
  },
  {
    "poem_id": 88022,
    "vorder": 148,
    "position": 1,
    "text": "ببارید بر لشکرش گُرز و تیر"
  },
  {
    "poem_id": 88022,
    "vorder": 149,
    "position": 0,
    "text": "دو فرسنگ چون اژدهای دژم"
  },
  {
    "poem_id": 88022,
    "vorder": 150,
    "position": 1,
    "text": "همی مردم آهخت ازیشان بدم"
  },
  {
    "poem_id": 88022,
    "vorder": 151,
    "position": 0,
    "text": "سواران جنگی ز توران هزار"
  },
  {
    "poem_id": 88022,
    "vorder": 152,
    "position": 1,
    "text": "گرفتند زنده پس از کارزار"
  },
  {
    "poem_id": 88022,
    "vorder": 153,
    "position": 0,
    "text": "بلشکرگه آمد ازان رزمگاه"
  },
  {
    "poem_id": 88022,
    "vorder": 154,
    "position": 1,
    "text": "که بخشش کند خواسته بر سپاه"
  },
  {
    "poem_id": 88022,
    "vorder": 155,
    "position": 0,
    "text": "ببخشید و بنهاد بر پیل بار"
  },
  {
    "poem_id": 88022,
    "vorder": 156,
    "position": 1,
    "text": "بپیروزی آمد بر شهریار"
  }
]