[
  {
    "poem_id": 52175,
    "vorder": 1,
    "position": 0,
    "text": "برآشفت بهرام و شد شوخ چشم"
  },
  {
    "poem_id": 52175,
    "vorder": 2,
    "position": 1,
    "text": "زگفتار پرموده آمد بخشم"
  },
  {
    "poem_id": 52175,
    "vorder": 3,
    "position": 0,
    "text": "بتندیش یک تازیانه بزد"
  },
  {
    "poem_id": 52175,
    "vorder": 4,
    "position": 1,
    "text": "بران سان که از ناسزایان سزد"
  },
  {
    "poem_id": 52175,
    "vorder": 5,
    "position": 0,
    "text": "ببستند هم در زمان پای اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 6,
    "position": 1,
    "text": "یکی تنگ خرگاه شد جای اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 7,
    "position": 0,
    "text": "چو خراد برزین چنان دید گفت"
  },
  {
    "poem_id": 52175,
    "vorder": 8,
    "position": 1,
    "text": "که این پهلوان را خرد نیست جفت"
  },
  {
    "poem_id": 52175,
    "vorder": 9,
    "position": 0,
    "text": "بیامد بنزد دبیر بزرگ"
  },
  {
    "poem_id": 52175,
    "vorder": 10,
    "position": 1,
    "text": "بدو گفت کین پهلوان سترگ"
  },
  {
    "poem_id": 52175,
    "vorder": 11,
    "position": 0,
    "text": "بیک پر پشه ندارد خرد"
  },
  {
    "poem_id": 52175,
    "vorder": 12,
    "position": 1,
    "text": "ازیرا کسی را بکس نشمرد"
  },
  {
    "poem_id": 52175,
    "vorder": 13,
    "position": 0,
    "text": "ببایدش گفتن کزین چاره نیست"
  },
  {
    "poem_id": 52175,
    "vorder": 14,
    "position": 1,
    "text": "ورا بتر از خشم پتیاره نیست"
  },
  {
    "poem_id": 52175,
    "vorder": 15,
    "position": 0,
    "text": "به نزدیک بهرام رفت آن دو مرد"
  },
  {
    "poem_id": 52175,
    "vorder": 16,
    "position": 1,
    "text": "زبانها پراز بند و رخ لاژورد"
  },
  {
    "poem_id": 52175,
    "vorder": 17,
    "position": 0,
    "text": "بگفتند کین رنج دادی بباد"
  },
  {
    "poem_id": 52175,
    "vorder": 18,
    "position": 1,
    "text": "سر نامور پر ز آتش مباد"
  },
  {
    "poem_id": 52175,
    "vorder": 19,
    "position": 0,
    "text": "بدانست بهرام کان بود زشت"
  },
  {
    "poem_id": 52175,
    "vorder": 20,
    "position": 1,
    "text": "باب اندرافگند و تر گشت خشت"
  },
  {
    "poem_id": 52175,
    "vorder": 21,
    "position": 0,
    "text": "پشیمان شد وبند او برگرفت"
  },
  {
    "poem_id": 52175,
    "vorder": 22,
    "position": 1,
    "text": "ز کردار خود دست بر سرگرفت"
  },
  {
    "poem_id": 52175,
    "vorder": 23,
    "position": 0,
    "text": "فرستاد اسبی بزرین ستام"
  },
  {
    "poem_id": 52175,
    "vorder": 24,
    "position": 1,
    "text": "یکی تیغ هندی بزرین نیام"
  },
  {
    "poem_id": 52175,
    "vorder": 25,
    "position": 0,
    "text": "هم اندر زمان شد به نزدیک اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 26,
    "position": 1,
    "text": "که روشن کند جان تاریک اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 27,
    "position": 0,
    "text": "همی‌بود تا او میان را ببست"
  },
  {
    "poem_id": 52175,
    "vorder": 28,
    "position": 1,
    "text": "یکی بارهٔ تیزتگ برنشست"
  },
  {
    "poem_id": 52175,
    "vorder": 29,
    "position": 0,
    "text": "سپهبد همی‌راند با اوبه راه"
  },
  {
    "poem_id": 52175,
    "vorder": 30,
    "position": 1,
    "text": "بدید آنک تازه نبد روی شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 31,
    "position": 0,
    "text": "بهنگام پدرود کردنش گفت"
  },
  {
    "poem_id": 52175,
    "vorder": 32,
    "position": 1,
    "text": "که آزار داری ز من درنهفت"
  },
  {
    "poem_id": 52175,
    "vorder": 33,
    "position": 0,
    "text": "گرت هست با شاه ایران مگوی"
  },
  {
    "poem_id": 52175,
    "vorder": 34,
    "position": 1,
    "text": "نیاید تو را نزد او آب روی"
  },
  {
    "poem_id": 52175,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت خاقان که ما راگله"
  },
  {
    "poem_id": 52175,
    "vorder": 36,
    "position": 1,
    "text": "زبختست و کردم به یزدان یله"
  },
  {
    "poem_id": 52175,
    "vorder": 37,
    "position": 0,
    "text": "نه من زان شمارم که از هرکسی"
  },
  {
    "poem_id": 52175,
    "vorder": 38,
    "position": 1,
    "text": "سخنها همی‌راند خواهم بسی"
  },
  {
    "poem_id": 52175,
    "vorder": 39,
    "position": 0,
    "text": "اگر شهریار تو زین آگهی"
  },
  {
    "poem_id": 52175,
    "vorder": 40,
    "position": 1,
    "text": "نیابد نزیبد برو بر مهی"
  },
  {
    "poem_id": 52175,
    "vorder": 41,
    "position": 0,
    "text": "مرا بند گردون گردنده کرد"
  },
  {
    "poem_id": 52175,
    "vorder": 42,
    "position": 1,
    "text": "نگویم که با من بدی بنده کرد"
  },
  {
    "poem_id": 52175,
    "vorder": 43,
    "position": 0,
    "text": "ز گفتار اوگشت بهرام زرد"
  },
  {
    "poem_id": 52175,
    "vorder": 44,
    "position": 1,
    "text": "بپیچید و خشم از دلیری بخورد"
  },
  {
    "poem_id": 52175,
    "vorder": 45,
    "position": 0,
    "text": "چنین داد پاسخ که آمد نشان"
  },
  {
    "poem_id": 52175,
    "vorder": 46,
    "position": 1,
    "text": "ز گفتار آن مهتر سرکشان"
  },
  {
    "poem_id": 52175,
    "vorder": 47,
    "position": 0,
    "text": "که تخم بدی تا توانی مکار"
  },
  {
    "poem_id": 52175,
    "vorder": 48,
    "position": 1,
    "text": "چوکاری برت بر دهد روزگار"
  },
  {
    "poem_id": 52175,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت بهرام کای نامجوی"
  },
  {
    "poem_id": 52175,
    "vorder": 50,
    "position": 1,
    "text": "سخنها چنین تا توانی مگوی"
  },
  {
    "poem_id": 52175,
    "vorder": 51,
    "position": 0,
    "text": "چرا من بتو دل بیاراستم"
  },
  {
    "poem_id": 52175,
    "vorder": 52,
    "position": 1,
    "text": "ز گیتی تو را نیکویی خواستم"
  },
  {
    "poem_id": 52175,
    "vorder": 53,
    "position": 0,
    "text": "ز تو نامه کردم بشاه جهان"
  },
  {
    "poem_id": 52175,
    "vorder": 54,
    "position": 1,
    "text": "همی زشت تو داشتم در نهان"
  },
  {
    "poem_id": 52175,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت خاقان که آن بد گذشت"
  },
  {
    "poem_id": 52175,
    "vorder": 56,
    "position": 1,
    "text": "گذشته سخنها همه باد گشت"
  },
  {
    "poem_id": 52175,
    "vorder": 57,
    "position": 0,
    "text": "ولیکن چو در جنگ خواری بود"
  },
  {
    "poem_id": 52175,
    "vorder": 58,
    "position": 1,
    "text": "گه آشتی بردباری بود"
  },
  {
    "poem_id": 52175,
    "vorder": 59,
    "position": 0,
    "text": "تو راخشم با آشتی گر یکیست"
  },
  {
    "poem_id": 52175,
    "vorder": 60,
    "position": 1,
    "text": "خرد بی‌گمان نزد تواندکیست"
  },
  {
    "poem_id": 52175,
    "vorder": 61,
    "position": 0,
    "text": "چو سالار راه خداوند خویش"
  },
  {
    "poem_id": 52175,
    "vorder": 62,
    "position": 1,
    "text": "بگیرد نیفتد بهرکار پیش"
  },
  {
    "poem_id": 52175,
    "vorder": 63,
    "position": 0,
    "text": "همان راه یزدان بباید سپرد"
  },
  {
    "poem_id": 52175,
    "vorder": 64,
    "position": 1,
    "text": "ز دل تیرگیها بباید سترد"
  },
  {
    "poem_id": 52175,
    "vorder": 65,
    "position": 0,
    "text": "سخن گر نیفزایی اکنون رواست"
  },
  {
    "poem_id": 52175,
    "vorder": 66,
    "position": 1,
    "text": "که آن بد که شد گشت با باد راست"
  },
  {
    "poem_id": 52175,
    "vorder": 67,
    "position": 0,
    "text": "زخاقان چوبشنید بهرام گفت"
  },
  {
    "poem_id": 52175,
    "vorder": 68,
    "position": 1,
    "text": "که پنداشتم کین بماند نهفت"
  },
  {
    "poem_id": 52175,
    "vorder": 69,
    "position": 0,
    "text": "کنون زان گنه گر بیاید زیان"
  },
  {
    "poem_id": 52175,
    "vorder": 70,
    "position": 1,
    "text": "نپوشم برو چادر پرنیان"
  },
  {
    "poem_id": 52175,
    "vorder": 71,
    "position": 0,
    "text": "چوآنجارسی هرچ باید بگوی"
  },
  {
    "poem_id": 52175,
    "vorder": 72,
    "position": 1,
    "text": "نه زان مر مراکم شود آب روی"
  },
  {
    "poem_id": 52175,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت خاقان که هرشهریار"
  },
  {
    "poem_id": 52175,
    "vorder": 74,
    "position": 1,
    "text": "که ازنیک وبد برنگیرد شمار"
  },
  {
    "poem_id": 52175,
    "vorder": 75,
    "position": 0,
    "text": "ببد کردن بنده خامش بود"
  },
  {
    "poem_id": 52175,
    "vorder": 76,
    "position": 1,
    "text": "برمن چنان دان که بیهش بود"
  },
  {
    "poem_id": 52175,
    "vorder": 77,
    "position": 0,
    "text": "چواز دور بیند ورا بدسگال"
  },
  {
    "poem_id": 52175,
    "vorder": 78,
    "position": 1,
    "text": "وگر نیک خواهی بود گر همال"
  },
  {
    "poem_id": 52175,
    "vorder": 79,
    "position": 0,
    "text": "تو را ناسزا خواند وسرسبک"
  },
  {
    "poem_id": 52175,
    "vorder": 80,
    "position": 1,
    "text": "ورا شاه ایران ومغزی تنگ"
  },
  {
    "poem_id": 52175,
    "vorder": 81,
    "position": 0,
    "text": "بجوشید بهرام وشد زردروی"
  },
  {
    "poem_id": 52175,
    "vorder": 82,
    "position": 1,
    "text": "نگه کرد خراد برزین بروی"
  },
  {
    "poem_id": 52175,
    "vorder": 83,
    "position": 0,
    "text": "بترسید زان تیزخونخوار مرد"
  },
  {
    "poem_id": 52175,
    "vorder": 84,
    "position": 1,
    "text": "که اورا زباد اندرآرد بگرد"
  },
  {
    "poem_id": 52175,
    "vorder": 85,
    "position": 0,
    "text": "ببهرام گفت ای سزاوار گاه"
  },
  {
    "poem_id": 52175,
    "vorder": 86,
    "position": 1,
    "text": "بخور خشم وسر بازگردان ز راه"
  },
  {
    "poem_id": 52175,
    "vorder": 87,
    "position": 0,
    "text": "که خاقان همی راست گوید سخن"
  },
  {
    "poem_id": 52175,
    "vorder": 88,
    "position": 1,
    "text": "توبنیوش واندیشه بدمکن"
  },
  {
    "poem_id": 52175,
    "vorder": 89,
    "position": 0,
    "text": "سخن گر نرفتی بدین گونه سرد"
  },
  {
    "poem_id": 52175,
    "vorder": 90,
    "position": 1,
    "text": "تو را نیستی دل پرآزار و درد"
  },
  {
    "poem_id": 52175,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت کین بدرگ بی‌هنر"
  },
  {
    "poem_id": 52175,
    "vorder": 92,
    "position": 1,
    "text": "بجوید همی خاک وخون پدر"
  },
  {
    "poem_id": 52175,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت خاقان که این بد مکن"
  },
  {
    "poem_id": 52175,
    "vorder": 94,
    "position": 1,
    "text": "بتیزی بزرگی بگردد کهن"
  },
  {
    "poem_id": 52175,
    "vorder": 95,
    "position": 0,
    "text": "بگیتی هرآنکس که او چون تو بود"
  },
  {
    "poem_id": 52175,
    "vorder": 96,
    "position": 1,
    "text": "سرش پر ز گرد ودلش پر ز دود"
  },
  {
    "poem_id": 52175,
    "vorder": 97,
    "position": 0,
    "text": "همه بد سگالید وباکس نساخت"
  },
  {
    "poem_id": 52175,
    "vorder": 98,
    "position": 1,
    "text": "بکژی ونابخردی سر فراخت"
  },
  {
    "poem_id": 52175,
    "vorder": 99,
    "position": 0,
    "text": "همی ازشهنشاه ترسانییم"
  },
  {
    "poem_id": 52175,
    "vorder": 100,
    "position": 1,
    "text": "سزا زو بود رنج وآسانییم"
  },
  {
    "poem_id": 52175,
    "vorder": 101,
    "position": 0,
    "text": "زگردنکشان اوهمال منست"
  },
  {
    "poem_id": 52175,
    "vorder": 102,
    "position": 1,
    "text": "نه چون بنده اوبدسگال منست"
  },
  {
    "poem_id": 52175,
    "vorder": 103,
    "position": 0,
    "text": "هشیوار وآهسته و با نژاد"
  },
  {
    "poem_id": 52175,
    "vorder": 104,
    "position": 1,
    "text": "بسی نامبردار دارد بیاد"
  },
  {
    "poem_id": 52175,
    "vorder": 105,
    "position": 0,
    "text": "به جان و سرشاه ایران سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 106,
    "position": 1,
    "text": "کز ایدر کنون بازگردی به راه"
  },
  {
    "poem_id": 52175,
    "vorder": 107,
    "position": 0,
    "text": "بپاسخ نیفزایی وبدخوی"
  },
  {
    "poem_id": 52175,
    "vorder": 108,
    "position": 1,
    "text": "نگویی سخن نیز تا نشنوی"
  },
  {
    "poem_id": 52175,
    "vorder": 109,
    "position": 0,
    "text": "چوبشنید بهرام زوگشت باز"
  },
  {
    "poem_id": 52175,
    "vorder": 110,
    "position": 1,
    "text": "بلشکر گه آمد گو رزمساز"
  },
  {
    "poem_id": 52175,
    "vorder": 111,
    "position": 0,
    "text": "چو خراد برزین وآن بخردان"
  },
  {
    "poem_id": 52175,
    "vorder": 112,
    "position": 1,
    "text": "دبیر بزرگ ودگر موبدان"
  },
  {
    "poem_id": 52175,
    "vorder": 113,
    "position": 0,
    "text": "نبشتند نامه بشاه جهان"
  },
  {
    "poem_id": 52175,
    "vorder": 114,
    "position": 1,
    "text": "سخن هرچ بد آشکار ونهان"
  },
  {
    "poem_id": 52175,
    "vorder": 115,
    "position": 0,
    "text": "سپهدار با موبد موبدان"
  },
  {
    "poem_id": 52175,
    "vorder": 116,
    "position": 1,
    "text": "بخشم آن زمان گفت کای بخردان"
  },
  {
    "poem_id": 52175,
    "vorder": 117,
    "position": 0,
    "text": "هم اکنون از ایدر بدز درشوید"
  },
  {
    "poem_id": 52175,
    "vorder": 118,
    "position": 1,
    "text": "بکوشید و با باد همبر شوید"
  },
  {
    "poem_id": 52175,
    "vorder": 119,
    "position": 0,
    "text": "بدز بر ببیند تا خواسته"
  },
  {
    "poem_id": 52175,
    "vorder": 120,
    "position": 1,
    "text": "چه مایه بود گنج آراسته"
  },
  {
    "poem_id": 52175,
    "vorder": 121,
    "position": 0,
    "text": "دبیران برفتند دل پرهراس"
  },
  {
    "poem_id": 52175,
    "vorder": 122,
    "position": 1,
    "text": "ز شبگیر تاشب گذشته سه پاس"
  },
  {
    "poem_id": 52175,
    "vorder": 123,
    "position": 0,
    "text": "سیه شد بسی یازگار از شمار"
  },
  {
    "poem_id": 52175,
    "vorder": 124,
    "position": 1,
    "text": "نبشته نشد هم بفرجام کار"
  },
  {
    "poem_id": 52175,
    "vorder": 125,
    "position": 0,
    "text": "بدز بر نبد راه زان خواسته"
  },
  {
    "poem_id": 52175,
    "vorder": 126,
    "position": 1,
    "text": "گذشته بدو سال و ناکاسته"
  },
  {
    "poem_id": 52175,
    "vorder": 127,
    "position": 0,
    "text": "ز هنگام ارجاسب و افراسیاب"
  },
  {
    "poem_id": 52175,
    "vorder": 128,
    "position": 1,
    "text": "ز دینار و گوهر که خیزد ز آب"
  },
  {
    "poem_id": 52175,
    "vorder": 129,
    "position": 0,
    "text": "همان نیز چیزی که کانی بود"
  },
  {
    "poem_id": 52175,
    "vorder": 130,
    "position": 1,
    "text": "کجا رستنش آسمانی بود"
  },
  {
    "poem_id": 52175,
    "vorder": 131,
    "position": 0,
    "text": "همه گنجها اندر آورده بود"
  },
  {
    "poem_id": 52175,
    "vorder": 132,
    "position": 1,
    "text": "کجا نام او در جهان برده بود"
  },
  {
    "poem_id": 52175,
    "vorder": 133,
    "position": 0,
    "text": "زچیز سیاوش نخستین کمر"
  },
  {
    "poem_id": 52175,
    "vorder": 134,
    "position": 1,
    "text": "بهرمهره‌ای در سه یاره گهر"
  },
  {
    "poem_id": 52175,
    "vorder": 135,
    "position": 0,
    "text": "همان گوشوارش که اندر جهان"
  },
  {
    "poem_id": 52175,
    "vorder": 136,
    "position": 1,
    "text": "کسی را نبود ازکهان ومهان"
  },
  {
    "poem_id": 52175,
    "vorder": 137,
    "position": 0,
    "text": "که کیخسرو آن رابه لهراسب داد"
  },
  {
    "poem_id": 52175,
    "vorder": 138,
    "position": 1,
    "text": "که لهراسب زان پس بگشتاسب داد"
  },
  {
    "poem_id": 52175,
    "vorder": 139,
    "position": 0,
    "text": "که ارجاسب آن را بدز درنهاد"
  },
  {
    "poem_id": 52175,
    "vorder": 140,
    "position": 1,
    "text": "که هنگام آنکس ندارد بیاد"
  },
  {
    "poem_id": 52175,
    "vorder": 141,
    "position": 0,
    "text": "شمارش ندانست کس در جهان"
  },
  {
    "poem_id": 52175,
    "vorder": 142,
    "position": 1,
    "text": "ستاره شناسان و فرخ مهان"
  },
  {
    "poem_id": 52175,
    "vorder": 143,
    "position": 0,
    "text": "نبشتند یک یک همه خواسته"
  },
  {
    "poem_id": 52175,
    "vorder": 144,
    "position": 1,
    "text": "که بود اندر آن گنج آراسته"
  },
  {
    "poem_id": 52175,
    "vorder": 145,
    "position": 0,
    "text": "فرستاد بهرام مردی دبیر"
  },
  {
    "poem_id": 52175,
    "vorder": 146,
    "position": 1,
    "text": "سخن گوی و روشن دل و یادگیر"
  },
  {
    "poem_id": 52175,
    "vorder": 147,
    "position": 0,
    "text": "بیامد همه خواسته گرد کرد"
  },
  {
    "poem_id": 52175,
    "vorder": 148,
    "position": 1,
    "text": "که بد در دز وهم به دشت نبرد"
  },
  {
    "poem_id": 52175,
    "vorder": 149,
    "position": 0,
    "text": "ابا خواسته بود دو گوشوار"
  },
  {
    "poem_id": 52175,
    "vorder": 150,
    "position": 1,
    "text": "دو موزه درو بود گوهرنگار"
  },
  {
    "poem_id": 52175,
    "vorder": 151,
    "position": 0,
    "text": "همان شوشه زر وبرو بافته"
  },
  {
    "poem_id": 52175,
    "vorder": 152,
    "position": 1,
    "text": "بگوهر سر شوشه برتافته"
  },
  {
    "poem_id": 52175,
    "vorder": 153,
    "position": 0,
    "text": "دو برد یمانی همه زربفت"
  },
  {
    "poem_id": 52175,
    "vorder": 154,
    "position": 1,
    "text": "بسختند هر یک بمن بود هفت"
  },
  {
    "poem_id": 52175,
    "vorder": 155,
    "position": 0,
    "text": "سپهبد زکشی و کنداوری"
  },
  {
    "poem_id": 52175,
    "vorder": 156,
    "position": 1,
    "text": "نبود آگه از جستن داوری"
  },
  {
    "poem_id": 52175,
    "vorder": 157,
    "position": 0,
    "text": "دو برد یمانی بیکسونهاد"
  },
  {
    "poem_id": 52175,
    "vorder": 158,
    "position": 1,
    "text": "دو موزه به نامه نکرد ایچ یاد"
  },
  {
    "poem_id": 52175,
    "vorder": 159,
    "position": 0,
    "text": "بفرمود زان پس که پیداگشسب"
  },
  {
    "poem_id": 52175,
    "vorder": 160,
    "position": 1,
    "text": "همی با سواران نشیند براسب"
  },
  {
    "poem_id": 52175,
    "vorder": 161,
    "position": 0,
    "text": "زلشکر گزین کرد مردی هزار"
  },
  {
    "poem_id": 52175,
    "vorder": 162,
    "position": 1,
    "text": "که با اوشود تا درشهریار"
  },
  {
    "poem_id": 52175,
    "vorder": 163,
    "position": 0,
    "text": "زخاقان شتر خواست ده کاروان"
  },
  {
    "poem_id": 52175,
    "vorder": 164,
    "position": 1,
    "text": "شمرد آن زمان جمله بر ساروان"
  },
  {
    "poem_id": 52175,
    "vorder": 165,
    "position": 0,
    "text": "سواران پس پشت وخاقان زپیش"
  },
  {
    "poem_id": 52175,
    "vorder": 166,
    "position": 1,
    "text": "همی‌راند با نامداران خویش"
  },
  {
    "poem_id": 52175,
    "vorder": 167,
    "position": 0,
    "text": "چو خاقان بیامد به نزدیک شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 168,
    "position": 1,
    "text": "ابا گنج دیرینه و با سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 169,
    "position": 0,
    "text": "چوبشنید شاه جهان برنشست"
  },
  {
    "poem_id": 52175,
    "vorder": 170,
    "position": 1,
    "text": "به سر بر یکی تاج و گرزی بدست"
  },
  {
    "poem_id": 52175,
    "vorder": 171,
    "position": 0,
    "text": "بیامد چنین تا بدرگه رسید"
  },
  {
    "poem_id": 52175,
    "vorder": 172,
    "position": 1,
    "text": "ز دهلیز چون روی خاقان بدید"
  },
  {
    "poem_id": 52175,
    "vorder": 173,
    "position": 0,
    "text": "همی‌بود تا چونش بیند به راه"
  },
  {
    "poem_id": 52175,
    "vorder": 174,
    "position": 1,
    "text": "فرود آید او همچنان با سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 175,
    "position": 0,
    "text": "ببیندش و برگردد از پیش اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 176,
    "position": 1,
    "text": "پراندیشه بد زان سخن نامجوی"
  },
  {
    "poem_id": 52175,
    "vorder": 177,
    "position": 0,
    "text": "پس آنگاه خاقان چنان هم بر اسب"
  },
  {
    "poem_id": 52175,
    "vorder": 178,
    "position": 1,
    "text": "ابا موبد خویش پیداگشسب"
  },
  {
    "poem_id": 52175,
    "vorder": 179,
    "position": 0,
    "text": "فرود آمد از اسب خاقان همان"
  },
  {
    "poem_id": 52175,
    "vorder": 180,
    "position": 1,
    "text": "بیامد برشاه ایران دمان"
  },
  {
    "poem_id": 52175,
    "vorder": 181,
    "position": 0,
    "text": "درنگی ببد تا جهاندار شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 182,
    "position": 1,
    "text": "نشست از بر تازی اسبی سیاه"
  },
  {
    "poem_id": 52175,
    "vorder": 183,
    "position": 0,
    "text": "شهنشاه اسب تگاور براند"
  },
  {
    "poem_id": 52175,
    "vorder": 184,
    "position": 1,
    "text": "بدهلیز با او زمانی بماند"
  },
  {
    "poem_id": 52175,
    "vorder": 185,
    "position": 0,
    "text": "چوخاقان برفت از در شهریار"
  },
  {
    "poem_id": 52175,
    "vorder": 186,
    "position": 1,
    "text": "عنانش گرفت آن زمان پرده دار"
  },
  {
    "poem_id": 52175,
    "vorder": 187,
    "position": 0,
    "text": "پیاده شد از باره پرموده زود"
  },
  {
    "poem_id": 52175,
    "vorder": 188,
    "position": 1,
    "text": "بران کهتری جادوییها نمود"
  },
  {
    "poem_id": 52175,
    "vorder": 189,
    "position": 0,
    "text": "پیاده همان شاه دستش بدست"
  },
  {
    "poem_id": 52175,
    "vorder": 190,
    "position": 1,
    "text": "بیاورد او را بجای نشست"
  },
  {
    "poem_id": 52175,
    "vorder": 191,
    "position": 0,
    "text": "خرامان بیامد به نزدیک تخت"
  },
  {
    "poem_id": 52175,
    "vorder": 192,
    "position": 1,
    "text": "مراورا شهنشاه بنواخت سخت"
  },
  {
    "poem_id": 52175,
    "vorder": 193,
    "position": 0,
    "text": "بپرسید و بنشاختش پیش خویش"
  },
  {
    "poem_id": 52175,
    "vorder": 194,
    "position": 1,
    "text": "بگفتند بسیار ز انداره بیش"
  },
  {
    "poem_id": 52175,
    "vorder": 195,
    "position": 0,
    "text": "سزاوار او جایگه ساختند"
  },
  {
    "poem_id": 52175,
    "vorder": 196,
    "position": 1,
    "text": "یکی خرم ایوان بپرداختند"
  },
  {
    "poem_id": 52175,
    "vorder": 197,
    "position": 0,
    "text": "ببردند چیزی که شایسته بود"
  },
  {
    "poem_id": 52175,
    "vorder": 198,
    "position": 1,
    "text": "همان پیش پرموده بایسته بود"
  },
  {
    "poem_id": 52175,
    "vorder": 199,
    "position": 0,
    "text": "سپه را به نزدیک او جای کرد"
  },
  {
    "poem_id": 52175,
    "vorder": 200,
    "position": 1,
    "text": "دبیری بدان کاربر پای کرد"
  },
  {
    "poem_id": 52175,
    "vorder": 201,
    "position": 0,
    "text": "چو آگه شد از کار آن خواسته"
  },
  {
    "poem_id": 52175,
    "vorder": 202,
    "position": 1,
    "text": "که آورد پرموده آراسته"
  },
  {
    "poem_id": 52175,
    "vorder": 203,
    "position": 0,
    "text": "به میدان فرستاده تا همچنان"
  },
  {
    "poem_id": 52175,
    "vorder": 204,
    "position": 1,
    "text": "برد بار پرمایه با ساروان"
  },
  {
    "poem_id": 52175,
    "vorder": 205,
    "position": 0,
    "text": "چوآسود پرموده از رنج راه"
  },
  {
    "poem_id": 52175,
    "vorder": 206,
    "position": 1,
    "text": "بهشتم یکی سور فرمود شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 207,
    "position": 0,
    "text": "چو خاقان زپیش جهاندار شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 208,
    "position": 1,
    "text": "نشستند برخوان او پیش گاه"
  },
  {
    "poem_id": 52175,
    "vorder": 209,
    "position": 0,
    "text": "بفرمود تابار آن اشتران"
  },
  {
    "poem_id": 52175,
    "vorder": 210,
    "position": 1,
    "text": "بپشت اندر آرند پیش سران"
  },
  {
    "poem_id": 52175,
    "vorder": 211,
    "position": 0,
    "text": "کسی برگرفت از کشیدن شمار"
  },
  {
    "poem_id": 52175,
    "vorder": 212,
    "position": 1,
    "text": "بیک روز مزدور بدصدهزار"
  },
  {
    "poem_id": 52175,
    "vorder": 213,
    "position": 0,
    "text": "دگر روز هم بامداد پگاه"
  },
  {
    "poem_id": 52175,
    "vorder": 214,
    "position": 1,
    "text": "بخوان برمی‌آورد وبنشست شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 215,
    "position": 0,
    "text": "زمیدان ببردند پنجه هزار"
  },
  {
    "poem_id": 52175,
    "vorder": 216,
    "position": 1,
    "text": "هم ازتنگ بر پشت مردان کار"
  },
  {
    "poem_id": 52175,
    "vorder": 217,
    "position": 0,
    "text": "از آورده صد گنج شد ساخته"
  },
  {
    "poem_id": 52175,
    "vorder": 218,
    "position": 1,
    "text": "دل شاه زان کار پرداخته"
  },
  {
    "poem_id": 52175,
    "vorder": 219,
    "position": 0,
    "text": "یکی تخت جامه بفرمود شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 220,
    "position": 1,
    "text": "کز آنجا بیارند پیش سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 221,
    "position": 0,
    "text": "همان بر کمر گوهر شاهوار"
  },
  {
    "poem_id": 52175,
    "vorder": 222,
    "position": 1,
    "text": "که نامد همی ارز او در شمار"
  },
  {
    "poem_id": 52175,
    "vorder": 223,
    "position": 0,
    "text": "یکی آفرین خاست از بزمگاه"
  },
  {
    "poem_id": 52175,
    "vorder": 224,
    "position": 1,
    "text": "که پیروز باداین جهاندار شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 225,
    "position": 0,
    "text": "بآیین گشسب آن زمان شاه گفت"
  },
  {
    "poem_id": 52175,
    "vorder": 226,
    "position": 1,
    "text": "که با او بدش آشکار و نهفت"
  },
  {
    "poem_id": 52175,
    "vorder": 227,
    "position": 0,
    "text": "که چون بینی این کار چوبینه را"
  },
  {
    "poem_id": 52175,
    "vorder": 228,
    "position": 1,
    "text": "بمردی به کار آورد کینه را"
  },
  {
    "poem_id": 52175,
    "vorder": 229,
    "position": 0,
    "text": "چنین گفت آیین گشسب دبیر"
  },
  {
    "poem_id": 52175,
    "vorder": 230,
    "position": 1,
    "text": "که‌ای شاه روشن دل و یادگیر"
  },
  {
    "poem_id": 52175,
    "vorder": 231,
    "position": 0,
    "text": "بسوری که دستانش چوبین بود"
  },
  {
    "poem_id": 52175,
    "vorder": 232,
    "position": 1,
    "text": "چنان دان که خوانش نو آیین بود"
  },
  {
    "poem_id": 52175,
    "vorder": 233,
    "position": 0,
    "text": "ز گفتار او شاه شد بدگمان"
  },
  {
    "poem_id": 52175,
    "vorder": 234,
    "position": 1,
    "text": "روانش پراندیشه بدیک زمان"
  },
  {
    "poem_id": 52175,
    "vorder": 235,
    "position": 0,
    "text": "هیونی بیامد همانگه سترگ"
  },
  {
    "poem_id": 52175,
    "vorder": 236,
    "position": 1,
    "text": "یکی نامه‌ای از دبیر بزرگ"
  },
  {
    "poem_id": 52175,
    "vorder": 237,
    "position": 0,
    "text": "که شاه جهان جاودان شادباد"
  },
  {
    "poem_id": 52175,
    "vorder": 238,
    "position": 1,
    "text": "همه کار اوبخشش وداد باد"
  },
  {
    "poem_id": 52175,
    "vorder": 239,
    "position": 0,
    "text": "چنان دان که برد یمانی دوبود"
  },
  {
    "poem_id": 52175,
    "vorder": 240,
    "position": 1,
    "text": "همه موزه از گوهر نابسود"
  },
  {
    "poem_id": 52175,
    "vorder": 241,
    "position": 0,
    "text": "همان گوشوار سیاوش رد"
  },
  {
    "poem_id": 52175,
    "vorder": 242,
    "position": 1,
    "text": "کزو یادگارست ما را خرد"
  },
  {
    "poem_id": 52175,
    "vorder": 243,
    "position": 0,
    "text": "ازین چار دو پهلوان برگرفت"
  },
  {
    "poem_id": 52175,
    "vorder": 244,
    "position": 1,
    "text": "چو او دید رنج این نباشد شگفت"
  },
  {
    "poem_id": 52175,
    "vorder": 245,
    "position": 0,
    "text": "زشاهک بپرسید پس نامجوی"
  },
  {
    "poem_id": 52175,
    "vorder": 246,
    "position": 1,
    "text": "کزین هرچ دیدی یکایک بگوی"
  },
  {
    "poem_id": 52175,
    "vorder": 247,
    "position": 0,
    "text": "سخن گفت شاهک برین‌همنشان"
  },
  {
    "poem_id": 52175,
    "vorder": 248,
    "position": 1,
    "text": "برآشفت زان شاه گردنکشان"
  },
  {
    "poem_id": 52175,
    "vorder": 249,
    "position": 0,
    "text": "هم اندر زمان گفت چوبینه راه"
  },
  {
    "poem_id": 52175,
    "vorder": 250,
    "position": 1,
    "text": "همی گم کند سربرآرد بماه"
  },
  {
    "poem_id": 52175,
    "vorder": 251,
    "position": 0,
    "text": "یکی آنک خاقان چین رابزد"
  },
  {
    "poem_id": 52175,
    "vorder": 252,
    "position": 1,
    "text": "ازان سان که ازگوهر بد سزد"
  },
  {
    "poem_id": 52175,
    "vorder": 253,
    "position": 0,
    "text": "دگر آنک چون گوشوارش به کار"
  },
  {
    "poem_id": 52175,
    "vorder": 254,
    "position": 1,
    "text": "بیامد مگرشد یکی شهریار"
  },
  {
    "poem_id": 52175,
    "vorder": 255,
    "position": 0,
    "text": "همه رنج او سر به سر بادگشت"
  },
  {
    "poem_id": 52175,
    "vorder": 256,
    "position": 1,
    "text": "همه داد دادنش بیداد گشت"
  },
  {
    "poem_id": 52175,
    "vorder": 257,
    "position": 0,
    "text": "بگفت این و پرموده را پیش خواند"
  },
  {
    "poem_id": 52175,
    "vorder": 258,
    "position": 1,
    "text": "بران نامور پیشگاهش نشاند"
  },
  {
    "poem_id": 52175,
    "vorder": 259,
    "position": 0,
    "text": "ببودند وخوردند تا شب زراه"
  },
  {
    "poem_id": 52175,
    "vorder": 260,
    "position": 1,
    "text": "بیفشاند آن تیره زلف سیاه"
  },
  {
    "poem_id": 52175,
    "vorder": 261,
    "position": 0,
    "text": "بخاقان چین گفت کز بهر من"
  },
  {
    "poem_id": 52175,
    "vorder": 262,
    "position": 1,
    "text": "بسی زنج دیدی توازشهرمن"
  },
  {
    "poem_id": 52175,
    "vorder": 263,
    "position": 0,
    "text": "نشسته بیازید ودستش گرفت"
  },
  {
    "poem_id": 52175,
    "vorder": 264,
    "position": 1,
    "text": "ازو ماند پرموده اندر شگفت"
  },
  {
    "poem_id": 52175,
    "vorder": 265,
    "position": 0,
    "text": "بدو گفت سوگند ما تازه کن"
  },
  {
    "poem_id": 52175,
    "vorder": 266,
    "position": 1,
    "text": "همان کار بر دیگر اندازه کن"
  },
  {
    "poem_id": 52175,
    "vorder": 267,
    "position": 0,
    "text": "بخوردند سوگندهای گران"
  },
  {
    "poem_id": 52175,
    "vorder": 268,
    "position": 1,
    "text": "به یزدان پاک وبه جان سران"
  },
  {
    "poem_id": 52175,
    "vorder": 269,
    "position": 0,
    "text": "که از شاه خاقان نپیچد به دل"
  },
  {
    "poem_id": 52175,
    "vorder": 270,
    "position": 1,
    "text": "ندارد به کاری ورا دلگسل"
  },
  {
    "poem_id": 52175,
    "vorder": 271,
    "position": 0,
    "text": "بگاه وبتاج و بخورشیدوماه"
  },
  {
    "poem_id": 52175,
    "vorder": 272,
    "position": 1,
    "text": "به آذرگشسب و به آذرپناه"
  },
  {
    "poem_id": 52175,
    "vorder": 273,
    "position": 0,
    "text": "به یزدان که او برتر ازبرتریست"
  },
  {
    "poem_id": 52175,
    "vorder": 274,
    "position": 1,
    "text": "نگارندهٔ زهره ومشتریست"
  },
  {
    "poem_id": 52175,
    "vorder": 275,
    "position": 0,
    "text": "که چون بازگردی نپیچی زمن"
  },
  {
    "poem_id": 52175,
    "vorder": 276,
    "position": 1,
    "text": "نه از نامداران این انجمن"
  },
  {
    "poem_id": 52175,
    "vorder": 277,
    "position": 0,
    "text": "بگفتند وز جای برخاستند"
  },
  {
    "poem_id": 52175,
    "vorder": 278,
    "position": 1,
    "text": "سوی خوابگه رفتن آراستند"
  },
  {
    "poem_id": 52175,
    "vorder": 279,
    "position": 0,
    "text": "چوبرزد سرازکوه زرد آفتاب"
  },
  {
    "poem_id": 52175,
    "vorder": 280,
    "position": 1,
    "text": "سرتاجداران برآمد زخواب"
  },
  {
    "poem_id": 52175,
    "vorder": 281,
    "position": 0,
    "text": "یکی خلعت آراسته بود شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 282,
    "position": 1,
    "text": "ز زرین وسیمین و اسب وکلاه"
  },
  {
    "poem_id": 52175,
    "vorder": 283,
    "position": 0,
    "text": "به نزدیک خاقان فرستاد شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 284,
    "position": 1,
    "text": "دومنزل همی‌رفت با او به راه"
  },
  {
    "poem_id": 52175,
    "vorder": 285,
    "position": 0,
    "text": "سه دیگر نپیمود راه دراز"
  },
  {
    "poem_id": 52175,
    "vorder": 286,
    "position": 1,
    "text": "درودش فرستاد وزو گشت باز"
  },
  {
    "poem_id": 52175,
    "vorder": 287,
    "position": 0,
    "text": "چو آگاهی آمد سوی پهلوان"
  },
  {
    "poem_id": 52175,
    "vorder": 288,
    "position": 1,
    "text": "ازان خلعت شهریار جهان"
  },
  {
    "poem_id": 52175,
    "vorder": 289,
    "position": 0,
    "text": "زخاقان چینی که از نزد شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 290,
    "position": 1,
    "text": "چنان شاد برگشت و آمد به راه"
  },
  {
    "poem_id": 52175,
    "vorder": 291,
    "position": 0,
    "text": "پذیره شدش پهلوان سوار"
  },
  {
    "poem_id": 52175,
    "vorder": 292,
    "position": 1,
    "text": "از ایران هرآنکس که بد نامدار"
  },
  {
    "poem_id": 52175,
    "vorder": 293,
    "position": 0,
    "text": "علف ساخت جایی که اوبرگذشت"
  },
  {
    "poem_id": 52175,
    "vorder": 294,
    "position": 1,
    "text": "به شهروده و منزل وکوه دشت"
  },
  {
    "poem_id": 52175,
    "vorder": 295,
    "position": 0,
    "text": "همی‌ساخت پوزش کنان پیش اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 296,
    "position": 1,
    "text": "پراز شرم جان بداندیش اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 297,
    "position": 0,
    "text": "چوپرموده را دید کرد آفرین"
  },
  {
    "poem_id": 52175,
    "vorder": 298,
    "position": 1,
    "text": "ازو سربپیچید خاقان چین"
  },
  {
    "poem_id": 52175,
    "vorder": 299,
    "position": 0,
    "text": "نپذرفت ازو هرچ آورده بود"
  },
  {
    "poem_id": 52175,
    "vorder": 300,
    "position": 1,
    "text": "علفت بود اگر بدره وبرده بود"
  },
  {
    "poem_id": 52175,
    "vorder": 301,
    "position": 0,
    "text": "همی‌راند بهرام با او به راه"
  },
  {
    "poem_id": 52175,
    "vorder": 302,
    "position": 1,
    "text": "نکرد ایچ خاقان بدو بر نگاه"
  },
  {
    "poem_id": 52175,
    "vorder": 303,
    "position": 0,
    "text": "بدین گونه برتاسه منزل براند"
  },
  {
    "poem_id": 52175,
    "vorder": 304,
    "position": 1,
    "text": "که یک روز پرموده اورانخواند"
  },
  {
    "poem_id": 52175,
    "vorder": 305,
    "position": 0,
    "text": "چهارم فرستاد خاقان کسی"
  },
  {
    "poem_id": 52175,
    "vorder": 306,
    "position": 1,
    "text": "که برگرد چون رنج دیدی بسی"
  },
  {
    "poem_id": 52175,
    "vorder": 307,
    "position": 0,
    "text": "چوبشنید بهرام برگشت از وی"
  },
  {
    "poem_id": 52175,
    "vorder": 308,
    "position": 1,
    "text": "بتندی سوی بلخ بنهاد روی"
  },
  {
    "poem_id": 52175,
    "vorder": 309,
    "position": 0,
    "text": "همی‌بود دربلخ چندی دژم"
  },
  {
    "poem_id": 52175,
    "vorder": 310,
    "position": 1,
    "text": "زکرده پشیمان ودل پر زغم"
  },
  {
    "poem_id": 52175,
    "vorder": 311,
    "position": 0,
    "text": "جهاندار زو هم نه خشنودبود"
  },
  {
    "poem_id": 52175,
    "vorder": 312,
    "position": 1,
    "text": "زتیزی روانش پراز دود بود"
  },
  {
    "poem_id": 52175,
    "vorder": 313,
    "position": 0,
    "text": "از آزار خاقان چینی نخست"
  },
  {
    "poem_id": 52175,
    "vorder": 314,
    "position": 1,
    "text": "که بهرام آزار او را بجست"
  },
  {
    "poem_id": 52175,
    "vorder": 315,
    "position": 0,
    "text": "دگر آنک چیزی که فرمان نبود"
  },
  {
    "poem_id": 52175,
    "vorder": 316,
    "position": 1,
    "text": "ببرداشتن چون دلیری نمود"
  },
  {
    "poem_id": 52175,
    "vorder": 317,
    "position": 0,
    "text": "یکی نامه بنوشت پس شهریار"
  },
  {
    "poem_id": 52175,
    "vorder": 318,
    "position": 1,
    "text": "ببهرام کای دیو ناسازگار"
  },
  {
    "poem_id": 52175,
    "vorder": 319,
    "position": 0,
    "text": "ندانی همی خویشتن راتوباز"
  },
  {
    "poem_id": 52175,
    "vorder": 320,
    "position": 1,
    "text": "چنین رابزرگان شدی بی‌نیاز"
  },
  {
    "poem_id": 52175,
    "vorder": 321,
    "position": 0,
    "text": "هنرها ز یزدان نبینی همی"
  },
  {
    "poem_id": 52175,
    "vorder": 322,
    "position": 1,
    "text": "به چرخ فلک برنشینی همی"
  },
  {
    "poem_id": 52175,
    "vorder": 323,
    "position": 0,
    "text": "زفرمان من سربپیچیده‌ای"
  },
  {
    "poem_id": 52175,
    "vorder": 324,
    "position": 1,
    "text": "دگرگونه کاری بسیجیده‌ای"
  },
  {
    "poem_id": 52175,
    "vorder": 325,
    "position": 0,
    "text": "نیاید همی یادت از رنج من"
  },
  {
    "poem_id": 52175,
    "vorder": 326,
    "position": 1,
    "text": "سپاه من و کوشش وگنج من"
  },
  {
    "poem_id": 52175,
    "vorder": 327,
    "position": 0,
    "text": "ره پهلوانان نسازی همی"
  },
  {
    "poem_id": 52175,
    "vorder": 328,
    "position": 1,
    "text": "سرت به آسمان برفرازی همی"
  },
  {
    "poem_id": 52175,
    "vorder": 329,
    "position": 0,
    "text": "کنون خلعت آمد سزاوار تو"
  },
  {
    "poem_id": 52175,
    "vorder": 330,
    "position": 1,
    "text": "پسندیده و در خور کار تو"
  },
  {
    "poem_id": 52175,
    "vorder": 331,
    "position": 0,
    "text": "چوبنهاد برنامه برمهرشاه"
  },
  {
    "poem_id": 52175,
    "vorder": 332,
    "position": 1,
    "text": "بفرمود تا دو کدانی سیاه"
  },
  {
    "poem_id": 52175,
    "vorder": 333,
    "position": 0,
    "text": "بیارند با دوک و پنبه دروی"
  },
  {
    "poem_id": 52175,
    "vorder": 334,
    "position": 1,
    "text": "نهاده بسی ناسزا رنگ وبوی"
  },
  {
    "poem_id": 52175,
    "vorder": 335,
    "position": 0,
    "text": "هم از شعر پیراهن لاژورد"
  },
  {
    "poem_id": 52175,
    "vorder": 336,
    "position": 1,
    "text": "یکی سرخ مقناع و شلوار زرد"
  },
  {
    "poem_id": 52175,
    "vorder": 337,
    "position": 0,
    "text": "فرستاده پر منش برگزید"
  },
  {
    "poem_id": 52175,
    "vorder": 338,
    "position": 1,
    "text": "که آن خلعت ناسزا را سزید"
  },
  {
    "poem_id": 52175,
    "vorder": 339,
    "position": 0,
    "text": "بدو گفت کاین پیش بهرام بر"
  },
  {
    "poem_id": 52175,
    "vorder": 340,
    "position": 1,
    "text": "بگو ای سبک مایه بی‌هنر"
  },
  {
    "poem_id": 52175,
    "vorder": 341,
    "position": 0,
    "text": "توخاقان چین را ببندی همی"
  },
  {
    "poem_id": 52175,
    "vorder": 342,
    "position": 1,
    "text": "گزند بزرگان پسندی همی"
  },
  {
    "poem_id": 52175,
    "vorder": 343,
    "position": 0,
    "text": "زتختی که هستی فرود آرمت"
  },
  {
    "poem_id": 52175,
    "vorder": 344,
    "position": 1,
    "text": "ازین پس بکس نیزنشمارمت"
  },
  {
    "poem_id": 52175,
    "vorder": 345,
    "position": 0,
    "text": "فرستاده با خلعت آمد چوباد"
  },
  {
    "poem_id": 52175,
    "vorder": 346,
    "position": 1,
    "text": "شنیده سخنها همه کرد یاد"
  },
  {
    "poem_id": 52175,
    "vorder": 347,
    "position": 0,
    "text": "چو بهرام با نامه خلعت بدید"
  },
  {
    "poem_id": 52175,
    "vorder": 348,
    "position": 1,
    "text": "شکیبایی وخامشی برگزید"
  },
  {
    "poem_id": 52175,
    "vorder": 349,
    "position": 0,
    "text": "همی‌گفت کینست پاداش من"
  },
  {
    "poem_id": 52175,
    "vorder": 350,
    "position": 1,
    "text": "چنین از پی شاه پرخاش من"
  },
  {
    "poem_id": 52175,
    "vorder": 351,
    "position": 0,
    "text": "چنین بد ز اندیشه شاه نیست"
  },
  {
    "poem_id": 52175,
    "vorder": 352,
    "position": 1,
    "text": "جز ار ناسزا گفت بدخواه نیست"
  },
  {
    "poem_id": 52175,
    "vorder": 353,
    "position": 0,
    "text": "که خلعت ازینسان فرستد بمن"
  },
  {
    "poem_id": 52175,
    "vorder": 354,
    "position": 1,
    "text": "بدان تا ببینند هر انجمن"
  },
  {
    "poem_id": 52175,
    "vorder": 355,
    "position": 0,
    "text": "جهاندار بر بندگان پادشاست"
  },
  {
    "poem_id": 52175,
    "vorder": 356,
    "position": 1,
    "text": "اگر مر مرا خوار گیرد رواست"
  },
  {
    "poem_id": 52175,
    "vorder": 357,
    "position": 0,
    "text": "گمانی نبردم که نزدیک شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 358,
    "position": 1,
    "text": "بداندیشگان تیز یابند راه"
  },
  {
    "poem_id": 52175,
    "vorder": 359,
    "position": 0,
    "text": "ولیکن چوهرمز مرا خوار کرد"
  },
  {
    "poem_id": 52175,
    "vorder": 360,
    "position": 1,
    "text": "به گفتار آهرمنان کارکرد"
  },
  {
    "poem_id": 52175,
    "vorder": 361,
    "position": 0,
    "text": "زشاه جهان اینچنین کارکرد"
  },
  {
    "poem_id": 52175,
    "vorder": 362,
    "position": 1,
    "text": "نزیبد به پیش خردمند مرد"
  },
  {
    "poem_id": 52175,
    "vorder": 363,
    "position": 0,
    "text": "ازان پس که با خار مایه سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 364,
    "position": 1,
    "text": "بتندی برفتم زدرگاه شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 365,
    "position": 0,
    "text": "همه دیده‌اند آنچ من کرده‌ام"
  },
  {
    "poem_id": 52175,
    "vorder": 366,
    "position": 1,
    "text": "غم و رنج وسختی که من برده‌ام"
  },
  {
    "poem_id": 52175,
    "vorder": 367,
    "position": 0,
    "text": "چوپاداش آن رنج خواری بود"
  },
  {
    "poem_id": 52175,
    "vorder": 368,
    "position": 1,
    "text": "گر ازبخت ناسازگاری بود"
  },
  {
    "poem_id": 52175,
    "vorder": 369,
    "position": 0,
    "text": "به یزدان بنالم ز گردان سپهر"
  },
  {
    "poem_id": 52175,
    "vorder": 370,
    "position": 1,
    "text": "که از من چنین پاک بگسست مهر"
  },
  {
    "poem_id": 52175,
    "vorder": 371,
    "position": 0,
    "text": "زدادار نیکی دهش یاد کرد"
  },
  {
    "poem_id": 52175,
    "vorder": 372,
    "position": 1,
    "text": "بپوشید پس جامهٔ سرخ و زرد"
  },
  {
    "poem_id": 52175,
    "vorder": 373,
    "position": 0,
    "text": "به پیش اندرون دوکدان سیاه"
  },
  {
    "poem_id": 52175,
    "vorder": 374,
    "position": 1,
    "text": "نهاده هرآنچش فرستاد شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 375,
    "position": 0,
    "text": "بفرمود تا هرک بود ازمهان"
  },
  {
    "poem_id": 52175,
    "vorder": 376,
    "position": 1,
    "text": "ازان نامداران شاه جهان"
  },
  {
    "poem_id": 52175,
    "vorder": 377,
    "position": 0,
    "text": "زلشکر برفتند نزدیک اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 378,
    "position": 1,
    "text": "پراندیشه بد جان تاریک اوی"
  },
  {
    "poem_id": 52175,
    "vorder": 379,
    "position": 0,
    "text": "چورفتند و دیدند پیر وجوان"
  },
  {
    "poem_id": 52175,
    "vorder": 380,
    "position": 1,
    "text": "بران گونه آن پوشش پهلوان"
  },
  {
    "poem_id": 52175,
    "vorder": 381,
    "position": 0,
    "text": "بماندند زان کار یکسر شگفت"
  },
  {
    "poem_id": 52175,
    "vorder": 382,
    "position": 1,
    "text": "دل هرکس اندیشه‌ای برگرفت"
  },
  {
    "poem_id": 52175,
    "vorder": 383,
    "position": 0,
    "text": "چنین گفت پس پهلوان با سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 384,
    "position": 1,
    "text": "که خلعت بدین سان فرستاد شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 385,
    "position": 0,
    "text": "جهاندار شاهست وما بنده‌ایم"
  },
  {
    "poem_id": 52175,
    "vorder": 386,
    "position": 1,
    "text": "دل و جان به مهر وی آگنده‌ایم"
  },
  {
    "poem_id": 52175,
    "vorder": 387,
    "position": 0,
    "text": "چه بینید بینندگان اندرین"
  },
  {
    "poem_id": 52175,
    "vorder": 388,
    "position": 1,
    "text": "چه گوییم با شهریار زمین"
  },
  {
    "poem_id": 52175,
    "vorder": 389,
    "position": 0,
    "text": "بپاسخ گشادند یکسر زبان"
  },
  {
    "poem_id": 52175,
    "vorder": 390,
    "position": 1,
    "text": "که‌ای نامور پرهنر پهلوان"
  },
  {
    "poem_id": 52175,
    "vorder": 391,
    "position": 0,
    "text": "چو ارج تو اینست نزدیک شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 392,
    "position": 1,
    "text": "سگانند بر بارگاهش سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 393,
    "position": 0,
    "text": "نگر تا چه گفت آن خردمند پیر"
  },
  {
    "poem_id": 52175,
    "vorder": 394,
    "position": 1,
    "text": "به ری چون دلش تنگ شد ز اردشیر"
  },
  {
    "poem_id": 52175,
    "vorder": 395,
    "position": 0,
    "text": "سری پر زکینه دلی پر زدرد"
  },
  {
    "poem_id": 52175,
    "vorder": 396,
    "position": 1,
    "text": "زبان و روان پر زگفتار سرد"
  },
  {
    "poem_id": 52175,
    "vorder": 397,
    "position": 0,
    "text": "بیامد دمان تا باصطخر پارس"
  },
  {
    "poem_id": 52175,
    "vorder": 398,
    "position": 1,
    "text": "که اصطخر بد بر زمین فخر پارس"
  },
  {
    "poem_id": 52175,
    "vorder": 399,
    "position": 0,
    "text": "که بیزارم از تخت وز تاج شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 400,
    "position": 1,
    "text": "چونیک وبد من ندارد نگاه"
  },
  {
    "poem_id": 52175,
    "vorder": 401,
    "position": 0,
    "text": "بدو گفت بهرام کین خود مگوی"
  },
  {
    "poem_id": 52175,
    "vorder": 402,
    "position": 1,
    "text": "که از شاه گیرد سپاه آبروی"
  },
  {
    "poem_id": 52175,
    "vorder": 403,
    "position": 0,
    "text": "همه سر به سر بندگان وییم"
  },
  {
    "poem_id": 52175,
    "vorder": 404,
    "position": 1,
    "text": "دهنده‌ست وخواهندگان وییم"
  },
  {
    "poem_id": 52175,
    "vorder": 405,
    "position": 0,
    "text": "چنین یافت پاسخ ز ایرانیان"
  },
  {
    "poem_id": 52175,
    "vorder": 406,
    "position": 1,
    "text": "که ماخود نبندیم زین پس میان"
  },
  {
    "poem_id": 52175,
    "vorder": 407,
    "position": 0,
    "text": "به ایران کس اورا نخوانیم شاه"
  },
  {
    "poem_id": 52175,
    "vorder": 408,
    "position": 1,
    "text": "نه بهرام را پهلوان سپاه"
  },
  {
    "poem_id": 52175,
    "vorder": 409,
    "position": 0,
    "text": "بگفتند وز پیش بیرون شدند"
  },
  {
    "poem_id": 52175,
    "vorder": 410,
    "position": 1,
    "text": "ز کاخ همایون به هامون شدند"
  },
  {
    "poem_id": 52175,
    "vorder": 411,
    "position": 0,
    "text": "سپهبد سپه را همی‌داد پند"
  },
  {
    "poem_id": 52175,
    "vorder": 412,
    "position": 1,
    "text": "همی‌داشت با پند لب را ببند"
  },
  {
    "poem_id": 52175,
    "vorder": 413,
    "position": 0,
    "text": "چنین تا دوهفته برین برگذشت"
  },
  {
    "poem_id": 52175,
    "vorder": 414,
    "position": 1,
    "text": "سپهبد ز ایوان بیامد به دشت"
  },
  {
    "poem_id": 52175,
    "vorder": 415,
    "position": 0,
    "text": "یکی بیشه پیش آمدش پر درخت"
  },
  {
    "poem_id": 52175,
    "vorder": 416,
    "position": 1,
    "text": "سزاوار میخوارهٔ نیکبخت"
  },
  {
    "poem_id": 52175,
    "vorder": 417,
    "position": 0,
    "text": "یکی گور دید اندر آن مرغزار"
  },
  {
    "poem_id": 52175,
    "vorder": 418,
    "position": 1,
    "text": "کزان خوبتر کس نبیند نگار"
  },
  {
    "poem_id": 52175,
    "vorder": 419,
    "position": 0,
    "text": "پس اندر همی‌راند بهرام نرم"
  },
  {
    "poem_id": 52175,
    "vorder": 420,
    "position": 1,
    "text": "برو بارگی را نکرد ایچ گرم"
  },
  {
    "poem_id": 52175,
    "vorder": 421,
    "position": 0,
    "text": "بدان بیشه در جای نخچیرگاه"
  },
  {
    "poem_id": 52175,
    "vorder": 422,
    "position": 1,
    "text": "به پیش اندر آمد یکی تنگ راه"
  },
  {
    "poem_id": 52175,
    "vorder": 423,
    "position": 0,
    "text": "ز تنگی چو گور ژیان برگذشت"
  },
  {
    "poem_id": 52175,
    "vorder": 424,
    "position": 1,
    "text": "بیابان پدید آمد و راغ ودشت"
  },
  {
    "poem_id": 52175,
    "vorder": 425,
    "position": 0,
    "text": "گرازنده بهرام و تازنده گور"
  },
  {
    "poem_id": 52175,
    "vorder": 426,
    "position": 1,
    "text": "ز گرمای آن دشت تفسیده هور"
  }
]