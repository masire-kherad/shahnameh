[
  {
    "poem_id": 87986,
    "vorder": 1,
    "position": 0,
    "text": "فرستاده نزدیک پیران رسید"
  },
  {
    "poem_id": 87986,
    "vorder": 2,
    "position": 1,
    "text": "بجوشید چون گفت هومان شنید"
  },
  {
    "poem_id": 87986,
    "vorder": 3,
    "position": 0,
    "text": "بیامد شب تیره هنگام خواب"
  },
  {
    "poem_id": 87986,
    "vorder": 4,
    "position": 1,
    "text": "همی راند لشکر بکردار آب"
  },
  {
    "poem_id": 87986,
    "vorder": 5,
    "position": 0,
    "text": "چو خورشید زان چادر قیرگون"
  },
  {
    "poem_id": 87986,
    "vorder": 6,
    "position": 1,
    "text": "غمی شد بدرید و آمد برون"
  },
  {
    "poem_id": 87986,
    "vorder": 7,
    "position": 0,
    "text": "سپهبد بکوه هماون رسید"
  },
  {
    "poem_id": 87986,
    "vorder": 8,
    "position": 1,
    "text": "ز گرد سپه کوه شد ناپدید"
  },
  {
    "poem_id": 87986,
    "vorder": 9,
    "position": 0,
    "text": "بهومان چنین گفت کز رزمگاه"
  },
  {
    "poem_id": 87986,
    "vorder": 10,
    "position": 1,
    "text": "مجنب و مجنبان از ایدر سپاه"
  },
  {
    "poem_id": 87986,
    "vorder": 11,
    "position": 0,
    "text": "شوم تا سپهدار ایرانیان"
  },
  {
    "poem_id": 87986,
    "vorder": 12,
    "position": 1,
    "text": "چه دارد بپا اختر کاویان"
  },
  {
    "poem_id": 87986,
    "vorder": 13,
    "position": 0,
    "text": "بکوه هماون که دادش نوید"
  },
  {
    "poem_id": 87986,
    "vorder": 14,
    "position": 1,
    "text": "بدین بودن اکنون چه دارد امید"
  },
  {
    "poem_id": 87986,
    "vorder": 15,
    "position": 0,
    "text": "بیامد بنزدیک ایران سپاه"
  },
  {
    "poem_id": 87986,
    "vorder": 16,
    "position": 1,
    "text": "سری پر ز کینه دلی پرگناه"
  },
  {
    "poem_id": 87986,
    "vorder": 17,
    "position": 0,
    "text": "خروشید کای نامبردار طوس"
  },
  {
    "poem_id": 87986,
    "vorder": 18,
    "position": 1,
    "text": "خداوند پیلان و گوپال و کوس"
  },
  {
    "poem_id": 87986,
    "vorder": 19,
    "position": 0,
    "text": "کنون ماهیان اندر آمد به پنج"
  },
  {
    "poem_id": 87986,
    "vorder": 20,
    "position": 1,
    "text": "که تا تو همی رزم جویی برنج"
  },
  {
    "poem_id": 87986,
    "vorder": 21,
    "position": 0,
    "text": "ز گودرزیان آن کجا مهترند"
  },
  {
    "poem_id": 87986,
    "vorder": 22,
    "position": 1,
    "text": "بدان رزمگاهت همه بی‌سرند"
  },
  {
    "poem_id": 87986,
    "vorder": 23,
    "position": 0,
    "text": "تو چون غرم رفتستی اندر کمر"
  },
  {
    "poem_id": 87986,
    "vorder": 24,
    "position": 1,
    "text": "پر از داوری دل پر از کینه سر"
  },
  {
    "poem_id": 87986,
    "vorder": 25,
    "position": 0,
    "text": "گریزان و لشکر پس اندر دمان"
  },
  {
    "poem_id": 87986,
    "vorder": 26,
    "position": 1,
    "text": "بدام اندر آیی همی بی‌گمان"
  },
  {
    "poem_id": 87986,
    "vorder": 27,
    "position": 0,
    "text": "چنین داد پاسخ سرافراز طوس"
  },
  {
    "poem_id": 87986,
    "vorder": 28,
    "position": 1,
    "text": "که من بر دروغ تو دارم فسوس"
  },
  {
    "poem_id": 87986,
    "vorder": 29,
    "position": 0,
    "text": "پی کین تو افگندی اندر جهان"
  },
  {
    "poem_id": 87986,
    "vorder": 30,
    "position": 1,
    "text": "ز بهر سیاوش میان مهان"
  },
  {
    "poem_id": 87986,
    "vorder": 31,
    "position": 0,
    "text": "برین گونه تا چند گویی دروغ"
  },
  {
    "poem_id": 87986,
    "vorder": 32,
    "position": 1,
    "text": "دروغت بر ما نگیرد فروغ"
  },
  {
    "poem_id": 87986,
    "vorder": 33,
    "position": 0,
    "text": "علف تنگ بود اندران رزمگاه"
  },
  {
    "poem_id": 87986,
    "vorder": 34,
    "position": 1,
    "text": "ازان بر هماون کشیدم سپاه"
  },
  {
    "poem_id": 87986,
    "vorder": 35,
    "position": 0,
    "text": "کنون آگهی شد بشاه جهان"
  },
  {
    "poem_id": 87986,
    "vorder": 36,
    "position": 1,
    "text": "بیاید زمان تا زمان ناگهان"
  },
  {
    "poem_id": 87986,
    "vorder": 37,
    "position": 0,
    "text": "بزرگان لشکر شدند انجمن"
  },
  {
    "poem_id": 87986,
    "vorder": 38,
    "position": 1,
    "text": "چو دستان و چون رستم پیلتن"
  },
  {
    "poem_id": 87986,
    "vorder": 39,
    "position": 0,
    "text": "چو جنبیدن شاه کردم درست"
  },
  {
    "poem_id": 87986,
    "vorder": 40,
    "position": 1,
    "text": "نمانم بتوران بر و بوم و رست"
  },
  {
    "poem_id": 87986,
    "vorder": 41,
    "position": 0,
    "text": "کنون کامدی کار مردان ببین"
  },
  {
    "poem_id": 87986,
    "vorder": 42,
    "position": 1,
    "text": "نه گاه فریبست و روز کمین"
  },
  {
    "poem_id": 87986,
    "vorder": 43,
    "position": 0,
    "text": "چو بشنید پیران ز هر سو سپاه"
  },
  {
    "poem_id": 87986,
    "vorder": 44,
    "position": 1,
    "text": "فرستاد و بگرفت بر کوه راه"
  },
  {
    "poem_id": 87986,
    "vorder": 45,
    "position": 0,
    "text": "بهر سو ز توران بیامد گروه"
  },
  {
    "poem_id": 87986,
    "vorder": 46,
    "position": 1,
    "text": "سپاه انجمن کرد بر گرد کوه"
  },
  {
    "poem_id": 87986,
    "vorder": 47,
    "position": 0,
    "text": "بریشان چو راه علف تنگ شد"
  },
  {
    "poem_id": 87986,
    "vorder": 48,
    "position": 1,
    "text": "سپهبد سوی چارهٔ جنگ شد"
  },
  {
    "poem_id": 87986,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت هومان بپیران گرد"
  },
  {
    "poem_id": 87986,
    "vorder": 50,
    "position": 1,
    "text": "که ما را پی کوه باید سپرد"
  },
  {
    "poem_id": 87986,
    "vorder": 51,
    "position": 0,
    "text": "یکی جنگ سازیم کایرانیان"
  },
  {
    "poem_id": 87986,
    "vorder": 52,
    "position": 1,
    "text": "نبندند ازین پس بکینه میان"
  },
  {
    "poem_id": 87986,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت پیران که بر ماست باد"
  },
  {
    "poem_id": 87986,
    "vorder": 54,
    "position": 1,
    "text": "نکردست با باد کس رزم یاد"
  },
  {
    "poem_id": 87986,
    "vorder": 55,
    "position": 0,
    "text": "ز جنگ پیاده بپیچید سر"
  },
  {
    "poem_id": 87986,
    "vorder": 56,
    "position": 1,
    "text": "شود تیره دیدار پرخاشخر"
  },
  {
    "poem_id": 87986,
    "vorder": 57,
    "position": 0,
    "text": "چو راه علف تنگ شد بر سپاه"
  },
  {
    "poem_id": 87986,
    "vorder": 58,
    "position": 1,
    "text": "کسی کوه خارا ندارد نگاه"
  },
  {
    "poem_id": 87986,
    "vorder": 59,
    "position": 0,
    "text": "همه لشکر آید بزنهار ما"
  },
  {
    "poem_id": 87986,
    "vorder": 60,
    "position": 1,
    "text": "ازین پس نجویند پیکار ما"
  },
  {
    "poem_id": 87986,
    "vorder": 61,
    "position": 0,
    "text": "بریشان کنون جای بخشایش است"
  },
  {
    "poem_id": 87986,
    "vorder": 62,
    "position": 1,
    "text": "نه هنگام پیکار و آرایش است"
  },
  {
    "poem_id": 87986,
    "vorder": 63,
    "position": 0,
    "text": "رسید این سگالش بگودرز و طوس"
  },
  {
    "poem_id": 87986,
    "vorder": 64,
    "position": 1,
    "text": "سر سرکشان خیره گشت از فسوس"
  },
  {
    "poem_id": 87986,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت با طوس گودرز پیر"
  },
  {
    "poem_id": 87986,
    "vorder": 66,
    "position": 1,
    "text": "که ما را کنون جنگ شد ناگزیر"
  },
  {
    "poem_id": 87986,
    "vorder": 67,
    "position": 0,
    "text": "سه روز ار بود خوردنی بیش نیست"
  },
  {
    "poem_id": 87986,
    "vorder": 68,
    "position": 1,
    "text": "ز یکسو گشاده رهی پیش نیست"
  },
  {
    "poem_id": 87986,
    "vorder": 69,
    "position": 0,
    "text": "نه خورد و نه چیز و نه بار و بنه"
  },
  {
    "poem_id": 87986,
    "vorder": 70,
    "position": 1,
    "text": "چنین چند باشد سپه گرسنه"
  },
  {
    "poem_id": 87986,
    "vorder": 71,
    "position": 0,
    "text": "کنون چون شود روی خورشید زرد"
  },
  {
    "poem_id": 87986,
    "vorder": 72,
    "position": 1,
    "text": "پدید آید آن چادر لاژورد"
  },
  {
    "poem_id": 87986,
    "vorder": 73,
    "position": 0,
    "text": "بباید گزیدن سواران مرد"
  },
  {
    "poem_id": 87986,
    "vorder": 74,
    "position": 1,
    "text": "ز بالا شدن سوی دشت نبرد"
  },
  {
    "poem_id": 87986,
    "vorder": 75,
    "position": 0,
    "text": "بسان شبیخون یکی رزم سخت"
  },
  {
    "poem_id": 87986,
    "vorder": 76,
    "position": 1,
    "text": "بسازیم تا چون بود یار بخت"
  },
  {
    "poem_id": 87986,
    "vorder": 77,
    "position": 0,
    "text": "اگر یک بیک تن بکشتن دهیم"
  },
  {
    "poem_id": 87986,
    "vorder": 78,
    "position": 1,
    "text": "وگر تاج گردنکشان برنهیم"
  },
  {
    "poem_id": 87986,
    "vorder": 79,
    "position": 0,
    "text": "چنین است فرجام آوردگاه"
  },
  {
    "poem_id": 87986,
    "vorder": 80,
    "position": 1,
    "text": "یکی خاک یابد یکی تاج و گاه"
  },
  {
    "poem_id": 87986,
    "vorder": 81,
    "position": 0,
    "text": "ز گودرز بشنید طوس این سخن"
  },
  {
    "poem_id": 87986,
    "vorder": 82,
    "position": 1,
    "text": "سرش گشت پردرد و کین کهن"
  },
  {
    "poem_id": 87986,
    "vorder": 83,
    "position": 0,
    "text": "ز یک سوی لشکر به بیژن سپرد"
  },
  {
    "poem_id": 87986,
    "vorder": 84,
    "position": 1,
    "text": "دگر سو بشیدوش و خراد گرد"
  },
  {
    "poem_id": 87986,
    "vorder": 85,
    "position": 0,
    "text": "درفش خجسته بگستهم داد"
  },
  {
    "poem_id": 87986,
    "vorder": 86,
    "position": 1,
    "text": "بسی پند و اندرزها کرد یاد"
  }
]