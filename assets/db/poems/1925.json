[
  {
    "poem_id": 1925,
    "vorder": 1,
    "position": 0,
    "text": "عمر سعد وقاس را با سپاه"
  },
  {
    "poem_id": 1925,
    "vorder": 2,
    "position": 1,
    "text": "فرستاد تا جنگ جوید ز شاه"
  },
  {
    "poem_id": 1925,
    "vorder": 3,
    "position": 0,
    "text": "چو آگاه شد زان سخن یزدگرد"
  },
  {
    "poem_id": 1925,
    "vorder": 4,
    "position": 1,
    "text": "ز هر سو سپاه اندر آورد گرد"
  },
  {
    "poem_id": 1925,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا پور هرمزد، راه"
  },
  {
    "poem_id": 1925,
    "vorder": 6,
    "position": 1,
    "text": "بپیماید و برکشد با سپاه"
  },
  {
    "poem_id": 1925,
    "vorder": 7,
    "position": 0,
    "text": "که رستم بُدش نام و بیدار بود"
  },
  {
    "poem_id": 1925,
    "vorder": 8,
    "position": 1,
    "text": "خردمند و گُرد و جهاندار بود"
  },
  {
    "poem_id": 1925,
    "vorder": 9,
    "position": 0,
    "text": "ستاره‌شمُر بود و بسیارهوش"
  },
  {
    "poem_id": 1925,
    "vorder": 10,
    "position": 1,
    "text": "به گفتارش موبد نهاده دو گوش"
  },
  {
    "poem_id": 1925,
    "vorder": 11,
    "position": 0,
    "text": "برَفت و گرانمایگان را ببرد"
  },
  {
    "poem_id": 1925,
    "vorder": 12,
    "position": 1,
    "text": "هر آنکس که بودند بیدار و گرد"
  },
  {
    "poem_id": 1925,
    "vorder": 13,
    "position": 0,
    "text": "برین گونه تا ماه بگذشت سی"
  },
  {
    "poem_id": 1925,
    "vorder": 14,
    "position": 1,
    "text": "همی رزم جستند در قادسی"
  },
  {
    "poem_id": 1925,
    "vorder": 15,
    "position": 0,
    "text": "بسی کشته شد لشکر از هر دو سوی"
  },
  {
    "poem_id": 1925,
    "vorder": 16,
    "position": 1,
    "text": "سپه یک ز دیگر نه برگاشت روی"
  },
  {
    "poem_id": 1925,
    "vorder": 17,
    "position": 0,
    "text": "بدانست رستم شمار سپهر"
  },
  {
    "poem_id": 1925,
    "vorder": 18,
    "position": 1,
    "text": "ستاره‌شمُر بود و با داد و مهر"
  },
  {
    "poem_id": 1925,
    "vorder": 19,
    "position": 0,
    "text": "همی‌گفت کاین رزم را روی نیست"
  },
  {
    "poem_id": 1925,
    "vorder": 20,
    "position": 1,
    "text": "رهِ آبِ شاهان بدین جوی نیست"
  },
  {
    "poem_id": 1925,
    "vorder": 21,
    "position": 0,
    "text": "بیاورد صلّاب و اختر گرفت"
  },
  {
    "poem_id": 1925,
    "vorder": 22,
    "position": 1,
    "text": "ز روز بلا دست بر سر گرفت"
  },
  {
    "poem_id": 1925,
    "vorder": 23,
    "position": 0,
    "text": "یکی نامه سوی برادر به درد"
  },
  {
    "poem_id": 1925,
    "vorder": 24,
    "position": 1,
    "text": "نوشت و سخن‌ها همه یاد کرد"
  },
  {
    "poem_id": 1925,
    "vorder": 25,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1925,
    "vorder": 26,
    "position": 1,
    "text": "کزو دید نیک و بد روزگار"
  },
  {
    "poem_id": 1925,
    "vorder": 27,
    "position": 0,
    "text": "دگر گفت کز گردش آسمان"
  },
  {
    "poem_id": 1925,
    "vorder": 28,
    "position": 1,
    "text": "پژوهنده‌مَردم شود بدگمان"
  },
  {
    "poem_id": 1925,
    "vorder": 29,
    "position": 0,
    "text": "گنه‌کارتر در زمانه منم"
  },
  {
    "poem_id": 1925,
    "vorder": 30,
    "position": 1,
    "text": "ازیرا گرفتار آهرمنم"
  },
  {
    "poem_id": 1925,
    "vorder": 31,
    "position": 0,
    "text": "که این خانه از پادشاهی تهیست"
  },
  {
    "poem_id": 1925,
    "vorder": 32,
    "position": 1,
    "text": "نه هنگام پیروزی و فرهیست"
  },
  {
    "poem_id": 1925,
    "vorder": 33,
    "position": 0,
    "text": "ز چارم همی‌بنگرد آفتاب"
  },
  {
    "poem_id": 1925,
    "vorder": 34,
    "position": 1,
    "text": "کزین جنگ ما را بد آید شتاب"
  },
  {
    "poem_id": 1925,
    "vorder": 35,
    "position": 0,
    "text": "ز بهرام و زُهره‌ست ما را گزند"
  },
  {
    "poem_id": 1925,
    "vorder": 36,
    "position": 1,
    "text": "نشاید گذشتن ز چرخ بلند"
  },
  {
    "poem_id": 1925,
    "vorder": 37,
    "position": 0,
    "text": "همان تیر و کیوان برابر شدست"
  },
  {
    "poem_id": 1925,
    "vorder": 38,
    "position": 1,
    "text": "عطارد به برج دو پیکر شدست"
  },
  {
    "poem_id": 1925,
    "vorder": 39,
    "position": 0,
    "text": "چنین است و کاری بزرگست پیش"
  },
  {
    "poem_id": 1925,
    "vorder": 40,
    "position": 1,
    "text": "همی سیر گردد دل از جان خویش"
  },
  {
    "poem_id": 1925,
    "vorder": 41,
    "position": 0,
    "text": "همه بودنی‌ها ببینم همی"
  },
  {
    "poem_id": 1925,
    "vorder": 42,
    "position": 1,
    "text": "وزان خامشی برگزینم همی"
  },
  {
    "poem_id": 1925,
    "vorder": 43,
    "position": 0,
    "text": "بر ایرانیان زار و گریان شدم"
  },
  {
    "poem_id": 1925,
    "vorder": 44,
    "position": 1,
    "text": "ز ساسانیان نیز بریان شدم"
  },
  {
    "poem_id": 1925,
    "vorder": 45,
    "position": 0,
    "text": "دریغ این سر و تاج و این داد و تخت"
  },
  {
    "poem_id": 1925,
    "vorder": 46,
    "position": 1,
    "text": "دریغ این بزرگی و این فرّ و بخت"
  },
  {
    "poem_id": 1925,
    "vorder": 47,
    "position": 0,
    "text": "کزین پس شکست آید از تازیان"
  },
  {
    "poem_id": 1925,
    "vorder": 48,
    "position": 1,
    "text": "ستاره نگردد مگر بر زیان"
  },
  {
    "poem_id": 1925,
    "vorder": 49,
    "position": 0,
    "text": "برین سالیان چارصد بگذرد"
  },
  {
    "poem_id": 1925,
    "vorder": 50,
    "position": 1,
    "text": "کزین تخمه گیتی کسی نشمرد"
  },
  {
    "poem_id": 1925,
    "vorder": 51,
    "position": 0,
    "text": "ازیشان فرستاده آمد به من"
  },
  {
    "poem_id": 1925,
    "vorder": 52,
    "position": 1,
    "text": "سخن رفت هرگونه بر انجمن"
  },
  {
    "poem_id": 1925,
    "vorder": 53,
    "position": 0,
    "text": "که از قادسی تا لب رودبار"
  },
  {
    "poem_id": 1925,
    "vorder": 54,
    "position": 1,
    "text": "زمین را ببخشیم با شهریار"
  },
  {
    "poem_id": 1925,
    "vorder": 55,
    "position": 0,
    "text": "وزان سو یکی برگشاییم راه"
  },
  {
    "poem_id": 1925,
    "vorder": 56,
    "position": 1,
    "text": "به شهری کجا هست بازارگاه"
  },
  {
    "poem_id": 1925,
    "vorder": 57,
    "position": 0,
    "text": "بدان تا خریم و فروشیم چیز"
  },
  {
    "poem_id": 1925,
    "vorder": 58,
    "position": 1,
    "text": "ازین پس فزونی نجوییم نیز"
  },
  {
    "poem_id": 1925,
    "vorder": 59,
    "position": 0,
    "text": "پذیریم ما ساو و باژ گران"
  },
  {
    "poem_id": 1925,
    "vorder": 60,
    "position": 1,
    "text": "نجوییم دیهیمِ کُنداوران"
  },
  {
    "poem_id": 1925,
    "vorder": 61,
    "position": 0,
    "text": "شهنشاه را نیز فرمان بریم"
  },
  {
    "poem_id": 1925,
    "vorder": 62,
    "position": 1,
    "text": "گر از ما بخواهد گروگان بریم"
  },
  {
    "poem_id": 1925,
    "vorder": 63,
    "position": 0,
    "text": "چنین است گفتار و کردار نیست"
  },
  {
    "poem_id": 1925,
    "vorder": 64,
    "position": 1,
    "text": "جز از گردش کژِّ پرگار نیست"
  },
  {
    "poem_id": 1925,
    "vorder": 65,
    "position": 0,
    "text": "برین نیز جنگی بوَد هر زمان"
  },
  {
    "poem_id": 1925,
    "vorder": 66,
    "position": 1,
    "text": "که کشته شود صد هژبر دمان"
  },
  {
    "poem_id": 1925,
    "vorder": 67,
    "position": 0,
    "text": "بزرگان که با من به جنگ اندرند"
  },
  {
    "poem_id": 1925,
    "vorder": 68,
    "position": 1,
    "text": "به گفتار ایشان همی‌ننگرند"
  },
  {
    "poem_id": 1925,
    "vorder": 69,
    "position": 0,
    "text": "چو میروی طَبری و چون ارمنی"
  },
  {
    "poem_id": 1925,
    "vorder": 70,
    "position": 1,
    "text": "به جنگ‌اند با کیش آهرمنی"
  },
  {
    "poem_id": 1925,
    "vorder": 71,
    "position": 0,
    "text": "چو گُلبوی سوری و این مهتران"
  },
  {
    "poem_id": 1925,
    "vorder": 72,
    "position": 1,
    "text": "که کوپال دارند و گرز گران"
  },
  {
    "poem_id": 1925,
    "vorder": 73,
    "position": 0,
    "text": "همی سرفرازند که ایشان کیَند"
  },
  {
    "poem_id": 1925,
    "vorder": 74,
    "position": 1,
    "text": "به ایران و مازنداران بر چیَند"
  },
  {
    "poem_id": 1925,
    "vorder": 75,
    "position": 0,
    "text": "اگر مرز و راهست اگر نیک و بد"
  },
  {
    "poem_id": 1925,
    "vorder": 76,
    "position": 1,
    "text": "به گرز و به شمشیر باید ستد"
  },
  {
    "poem_id": 1925,
    "vorder": 77,
    "position": 0,
    "text": "بکوشیم و مردی به کار آوریم"
  },
  {
    "poem_id": 1925,
    "vorder": 78,
    "position": 1,
    "text": "بریشان جهان تنگ و تار آوریم"
  },
  {
    "poem_id": 1925,
    "vorder": 79,
    "position": 0,
    "text": "نداند کسی راز گردان‌سپهر"
  },
  {
    "poem_id": 1925,
    "vorder": 80,
    "position": 1,
    "text": "دگرگونه‌تر گشت بر ما به مهر"
  },
  {
    "poem_id": 1925,
    "vorder": 81,
    "position": 0,
    "text": "چو نامه بخوانی خرد را مران"
  },
  {
    "poem_id": 1925,
    "vorder": 82,
    "position": 1,
    "text": "بپرداز و برساز با مهتران"
  },
  {
    "poem_id": 1925,
    "vorder": 83,
    "position": 0,
    "text": "همه گِرد کن خواسته هرچ هست"
  },
  {
    "poem_id": 1925,
    "vorder": 84,
    "position": 1,
    "text": "پرستنده و جامهٔ برنشست"
  },
  {
    "poem_id": 1925,
    "vorder": 85,
    "position": 0,
    "text": "همی تاز تا آذرآبادگان"
  },
  {
    "poem_id": 1925,
    "vorder": 86,
    "position": 1,
    "text": "به جای بزرگان و آزادگان"
  },
  {
    "poem_id": 1925,
    "vorder": 87,
    "position": 0,
    "text": "همیدون گله هرچ داری ز اسپ"
  },
  {
    "poem_id": 1925,
    "vorder": 88,
    "position": 1,
    "text": "ببر سوی گنجور آذرگشسپ"
  },
  {
    "poem_id": 1925,
    "vorder": 89,
    "position": 0,
    "text": "ز زابلستان گر ز ایران سپاه"
  },
  {
    "poem_id": 1925,
    "vorder": 90,
    "position": 1,
    "text": "هرآنکس که آیند زنهارخواه"
  },
  {
    "poem_id": 1925,
    "vorder": 91,
    "position": 0,
    "text": "بدار و بپوش و بیارای مهر"
  },
  {
    "poem_id": 1925,
    "vorder": 92,
    "position": 1,
    "text": "نگه کن بدین گردگردان سپهر"
  },
  {
    "poem_id": 1925,
    "vorder": 93,
    "position": 0,
    "text": "ازو شادمانی و زو در نهیب"
  },
  {
    "poem_id": 1925,
    "vorder": 94,
    "position": 1,
    "text": "زمانی فرازست و روزی نشیب"
  },
  {
    "poem_id": 1925,
    "vorder": 95,
    "position": 0,
    "text": "سخن هرچ گفتم به مادر بگوی"
  },
  {
    "poem_id": 1925,
    "vorder": 96,
    "position": 1,
    "text": "نبیند همانا مرا نیز روی"
  },
  {
    "poem_id": 1925,
    "vorder": 97,
    "position": 0,
    "text": "درودش ده از ما و بسیار پند"
  },
  {
    "poem_id": 1925,
    "vorder": 98,
    "position": 1,
    "text": "بدان تا نباشد به گیتی نژند"
  },
  {
    "poem_id": 1925,
    "vorder": 99,
    "position": 0,
    "text": "گر از من بَدآگاهی آرَد کسی"
  },
  {
    "poem_id": 1925,
    "vorder": 100,
    "position": 1,
    "text": "مباش اندرین کار غمگین بسی"
  },
  {
    "poem_id": 1925,
    "vorder": 101,
    "position": 0,
    "text": "چنان دان که اندر سرای سپنج"
  },
  {
    "poem_id": 1925,
    "vorder": 102,
    "position": 1,
    "text": "کسی کو نهد گنج با دست رنج"
  },
  {
    "poem_id": 1925,
    "vorder": 103,
    "position": 0,
    "text": "چو گاه آیدش زین جهان بگذرد"
  },
  {
    "poem_id": 1925,
    "vorder": 104,
    "position": 1,
    "text": "از آن رنج او دیگری برخورد"
  },
  {
    "poem_id": 1925,
    "vorder": 105,
    "position": 0,
    "text": "همیشه به یزدان‌پرستان گرای"
  },
  {
    "poem_id": 1925,
    "vorder": 106,
    "position": 1,
    "text": "بپرداز دل زین سپنجی‌سرای"
  },
  {
    "poem_id": 1925,
    "vorder": 107,
    "position": 0,
    "text": "که آمد به تنگ اندرون روزگار"
  },
  {
    "poem_id": 1925,
    "vorder": 108,
    "position": 1,
    "text": "نبیند مرا زین سپس شهریار"
  },
  {
    "poem_id": 1925,
    "vorder": 109,
    "position": 0,
    "text": "تو با هر که از دودهٔ ما بوَد"
  },
  {
    "poem_id": 1925,
    "vorder": 110,
    "position": 1,
    "text": "اگر پیر اگر مرد برنا بوَد"
  },
  {
    "poem_id": 1925,
    "vorder": 111,
    "position": 0,
    "text": "همه پیش یزدان نیایش کنید"
  },
  {
    "poem_id": 1925,
    "vorder": 112,
    "position": 1,
    "text": "شب تیره او را ستایش کنید"
  },
  {
    "poem_id": 1925,
    "vorder": 113,
    "position": 0,
    "text": "بکوشید و بخشنده باشید نیز"
  },
  {
    "poem_id": 1925,
    "vorder": 114,
    "position": 1,
    "text": "ز خوردن به فردا ممانید چیز"
  },
  {
    "poem_id": 1925,
    "vorder": 115,
    "position": 0,
    "text": "که من با سپاهی به سختی درم"
  },
  {
    "poem_id": 1925,
    "vorder": 116,
    "position": 1,
    "text": "به رنج و غم و شوربختی درم"
  },
  {
    "poem_id": 1925,
    "vorder": 117,
    "position": 0,
    "text": "رهایی نیابم سرانجام ازین"
  },
  {
    "poem_id": 1925,
    "vorder": 118,
    "position": 1,
    "text": "خوشا باد نوشین ایران‌زمین"
  },
  {
    "poem_id": 1925,
    "vorder": 119,
    "position": 0,
    "text": "چو گیتی شود تنگ بر شهریار"
  },
  {
    "poem_id": 1925,
    "vorder": 120,
    "position": 1,
    "text": "تو گنج و تن و جان گرامی مدار"
  },
  {
    "poem_id": 1925,
    "vorder": 121,
    "position": 0,
    "text": "کزین تخمهٔ نامدار ارجمند"
  },
  {
    "poem_id": 1925,
    "vorder": 122,
    "position": 1,
    "text": "نماندست جز شهریار بلند"
  },
  {
    "poem_id": 1925,
    "vorder": 123,
    "position": 0,
    "text": "ز کوشش مکن هیچ سستی به کار"
  },
  {
    "poem_id": 1925,
    "vorder": 124,
    "position": 1,
    "text": "به گیتی جزو نیستمان یادگار"
  },
  {
    "poem_id": 1925,
    "vorder": 125,
    "position": 0,
    "text": "ز ساسانیان یادگار اوست بس"
  },
  {
    "poem_id": 1925,
    "vorder": 126,
    "position": 1,
    "text": "کزین پس نبینند زین تخمه کس"
  },
  {
    "poem_id": 1925,
    "vorder": 127,
    "position": 0,
    "text": "دریغ این سر و تاج و این مهر و داد"
  },
  {
    "poem_id": 1925,
    "vorder": 128,
    "position": 1,
    "text": "که خواهدشد این تخت شاهی به باد"
  },
  {
    "poem_id": 1925,
    "vorder": 129,
    "position": 0,
    "text": "تو پدرود باش و بی‌آزار باش"
  },
  {
    "poem_id": 1925,
    "vorder": 130,
    "position": 1,
    "text": "ز بهر تن شه به تیمار باش"
  },
  {
    "poem_id": 1925,
    "vorder": 131,
    "position": 0,
    "text": "گر او را بد آید تو شو پیش اوی"
  },
  {
    "poem_id": 1925,
    "vorder": 132,
    "position": 1,
    "text": "به شمشیر بسپار پرخاش‌جوی"
  },
  {
    "poem_id": 1925,
    "vorder": 133,
    "position": 0,
    "text": "چو با تخت منبر برابر کنند"
  },
  {
    "poem_id": 1925,
    "vorder": 134,
    "position": 1,
    "text": "همه نام بوبکر و عمر کنند"
  },
  {
    "poem_id": 1925,
    "vorder": 135,
    "position": 0,
    "text": "تبه گردد این رنج‌های دراز"
  },
  {
    "poem_id": 1925,
    "vorder": 136,
    "position": 1,
    "text": "نشیبی درازست پیش فراز"
  },
  {
    "poem_id": 1925,
    "vorder": 137,
    "position": 0,
    "text": "نه تخت و نه دیهیم بینی نه شهر"
  },
  {
    "poem_id": 1925,
    "vorder": 138,
    "position": 1,
    "text": "ز اختر همه تازیان راست بهر"
  },
  {
    "poem_id": 1925,
    "vorder": 139,
    "position": 0,
    "text": "چو روز اندر آید به روز دراز"
  },
  {
    "poem_id": 1925,
    "vorder": 140,
    "position": 1,
    "text": "شود ناسزا شاه گردن‌فراز"
  },
  {
    "poem_id": 1925,
    "vorder": 141,
    "position": 0,
    "text": "بپوشد ازیشان گروهی سیاه"
  },
  {
    "poem_id": 1925,
    "vorder": 142,
    "position": 1,
    "text": "ز دیبا نهند از برِ سر کلاه"
  },
  {
    "poem_id": 1925,
    "vorder": 143,
    "position": 0,
    "text": "نه تخت و نه تاج و نه زرّینه‌کفش"
  },
  {
    "poem_id": 1925,
    "vorder": 144,
    "position": 1,
    "text": "نه گوهر نه افسر نه بر سر درفش"
  },
  {
    "poem_id": 1925,
    "vorder": 145,
    "position": 0,
    "text": "به رنج یکی دیگری برخورَد"
  },
  {
    "poem_id": 1925,
    "vorder": 146,
    "position": 1,
    "text": "به داد و به بخشش همی‌ننگرد"
  },
  {
    "poem_id": 1925,
    "vorder": 147,
    "position": 0,
    "text": "شب آید یکی چشمه رخشان کند"
  },
  {
    "poem_id": 1925,
    "vorder": 148,
    "position": 1,
    "text": "نهفته کسی را خروشان کند"
  },
  {
    "poem_id": 1925,
    "vorder": 149,
    "position": 0,
    "text": "ستانندهٔ روزشان دیگرست"
  },
  {
    "poem_id": 1925,
    "vorder": 150,
    "position": 1,
    "text": "کمر بر میان و کله بر سرست"
  },
  {
    "poem_id": 1925,
    "vorder": 151,
    "position": 0,
    "text": "ز پیمان بگردند وز راستی"
  },
  {
    "poem_id": 1925,
    "vorder": 152,
    "position": 1,
    "text": "گرامی شود کژّی و کاستی"
  },
  {
    "poem_id": 1925,
    "vorder": 153,
    "position": 0,
    "text": "پیاده شود مردم جنگ‌جوی"
  },
  {
    "poem_id": 1925,
    "vorder": 154,
    "position": 1,
    "text": "سوار آنک لاف آرَد و گفت‌وگوی"
  },
  {
    "poem_id": 1925,
    "vorder": 155,
    "position": 0,
    "text": "کشاورز جنگی شود بی‌هنر"
  },
  {
    "poem_id": 1925,
    "vorder": 156,
    "position": 1,
    "text": "نژاد و هنر کمتر آید ببر"
  },
  {
    "poem_id": 1925,
    "vorder": 157,
    "position": 0,
    "text": "رباید همی این از آن آن ازین"
  },
  {
    "poem_id": 1925,
    "vorder": 158,
    "position": 1,
    "text": "ز نفرین ندانند باز آفرین"
  },
  {
    "poem_id": 1925,
    "vorder": 159,
    "position": 0,
    "text": "نهان بدتر از آشکارا شود"
  },
  {
    "poem_id": 1925,
    "vorder": 160,
    "position": 1,
    "text": "دل شاهشان سنگ خارا شود"
  },
  {
    "poem_id": 1925,
    "vorder": 161,
    "position": 0,
    "text": "بداندیش گردد پدر بر پسر"
  },
  {
    "poem_id": 1925,
    "vorder": 162,
    "position": 1,
    "text": "پسر بر پدر هم چنین چاره‌گر"
  },
  {
    "poem_id": 1925,
    "vorder": 163,
    "position": 0,
    "text": "شود بندهٔ بی‌هنر شهریار"
  },
  {
    "poem_id": 1925,
    "vorder": 164,
    "position": 1,
    "text": "نژاد و بزرگی نیاید به کار"
  },
  {
    "poem_id": 1925,
    "vorder": 165,
    "position": 0,
    "text": "به گیتی کسی را نماند وفا"
  },
  {
    "poem_id": 1925,
    "vorder": 166,
    "position": 1,
    "text": "روان و زبان‌ها شود پر جفا"
  },
  {
    "poem_id": 1925,
    "vorder": 167,
    "position": 0,
    "text": "از ایران و از ترک و از تازیان"
  },
  {
    "poem_id": 1925,
    "vorder": 168,
    "position": 1,
    "text": "نژادی پدید آید اندر میان"
  },
  {
    "poem_id": 1925,
    "vorder": 169,
    "position": 0,
    "text": "نه دهقان، نه ترک و نه تازی بود"
  },
  {
    "poem_id": 1925,
    "vorder": 170,
    "position": 1,
    "text": "سخن‌ها به کردار بازی بود"
  },
  {
    "poem_id": 1925,
    "vorder": 171,
    "position": 0,
    "text": "همه گنج‌ها زیر دامن نهند"
  },
  {
    "poem_id": 1925,
    "vorder": 172,
    "position": 1,
    "text": "بمیرند و کوشش به دشمن دهند"
  },
  {
    "poem_id": 1925,
    "vorder": 173,
    "position": 0,
    "text": "بود دانشومند و زاهد به نام"
  },
  {
    "poem_id": 1925,
    "vorder": 174,
    "position": 1,
    "text": "بکوشد ازین تا که آید به کام"
  },
  {
    "poem_id": 1925,
    "vorder": 175,
    "position": 0,
    "text": "چنان فاش گردد غم و رنج و شور"
  },
  {
    "poem_id": 1925,
    "vorder": 176,
    "position": 1,
    "text": "که شادی به هنگام بهرام گور"
  },
  {
    "poem_id": 1925,
    "vorder": 177,
    "position": 0,
    "text": "نه جشن و نه رامش نه کوشش نه کام"
  },
  {
    "poem_id": 1925,
    "vorder": 178,
    "position": 1,
    "text": "همه چارهٔ ورزش و ساز دام"
  },
  {
    "poem_id": 1925,
    "vorder": 179,
    "position": 0,
    "text": "پدر با پسر کینِ سیم آورد"
  },
  {
    "poem_id": 1925,
    "vorder": 180,
    "position": 1,
    "text": "خورش کشک و پوشش گلیم آورد"
  },
  {
    "poem_id": 1925,
    "vorder": 181,
    "position": 0,
    "text": "زیان کسان از پی سود خویش"
  },
  {
    "poem_id": 1925,
    "vorder": 182,
    "position": 1,
    "text": "بجویند و دین اندر آرند پیش"
  },
  {
    "poem_id": 1925,
    "vorder": 183,
    "position": 0,
    "text": "نباشد بهار و زمستان پدید"
  },
  {
    "poem_id": 1925,
    "vorder": 184,
    "position": 1,
    "text": "نیارند هنگام رامش نبید"
  },
  {
    "poem_id": 1925,
    "vorder": 185,
    "position": 0,
    "text": "چو بسیار ازین داستان بگذرد"
  },
  {
    "poem_id": 1925,
    "vorder": 186,
    "position": 1,
    "text": "کسی سوی آزادگی ننگرد"
  },
  {
    "poem_id": 1925,
    "vorder": 187,
    "position": 0,
    "text": "بریزند خون از پی خواسته"
  },
  {
    "poem_id": 1925,
    "vorder": 188,
    "position": 1,
    "text": "شود روزگار مهان کاسته"
  },
  {
    "poem_id": 1925,
    "vorder": 189,
    "position": 0,
    "text": "دل من پر از خون شد و رویْ زرد"
  },
  {
    "poem_id": 1925,
    "vorder": 190,
    "position": 1,
    "text": "دهن خشک و لب‌ها شده لاژورد"
  },
  {
    "poem_id": 1925,
    "vorder": 191,
    "position": 0,
    "text": "که تا من شدم پهلوان از میان"
  },
  {
    "poem_id": 1925,
    "vorder": 192,
    "position": 1,
    "text": "چنین تیره شد بخت ساسانیان"
  },
  {
    "poem_id": 1925,
    "vorder": 193,
    "position": 0,
    "text": "چنین بی‌وفا گشت گردان‌سپهر"
  },
  {
    "poem_id": 1925,
    "vorder": 194,
    "position": 1,
    "text": "دژم گشت وز ما ببرید مهر"
  },
  {
    "poem_id": 1925,
    "vorder": 195,
    "position": 0,
    "text": "مرا تیز پیکان آهن‌گذار"
  },
  {
    "poem_id": 1925,
    "vorder": 196,
    "position": 1,
    "text": "همی بر برهنه نیاید به کار"
  },
  {
    "poem_id": 1925,
    "vorder": 197,
    "position": 0,
    "text": "همان تیغ کز گردن پیل و شیر"
  },
  {
    "poem_id": 1925,
    "vorder": 198,
    "position": 1,
    "text": "نگشتی به آورد زان زخم سیر"
  },
  {
    "poem_id": 1925,
    "vorder": 199,
    "position": 0,
    "text": "نبُرَّد همی پوست بر تازیان"
  },
  {
    "poem_id": 1925,
    "vorder": 200,
    "position": 1,
    "text": "ز دانش زیان آمدم بر زیان"
  },
  {
    "poem_id": 1925,
    "vorder": 201,
    "position": 0,
    "text": "مرا کاشکی این خرد نیستی"
  },
  {
    "poem_id": 1925,
    "vorder": 202,
    "position": 1,
    "text": "گر اندیشهٔ نیک و بد نیستی"
  },
  {
    "poem_id": 1925,
    "vorder": 203,
    "position": 0,
    "text": "بزرگان که در قادسی بامنند"
  },
  {
    "poem_id": 1925,
    "vorder": 204,
    "position": 1,
    "text": "درشتند و بر تازیان دشمنند"
  },
  {
    "poem_id": 1925,
    "vorder": 205,
    "position": 0,
    "text": "گمانند کاین بیش بیرون شود"
  },
  {
    "poem_id": 1925,
    "vorder": 206,
    "position": 1,
    "text": "ز دشمن زمین رود جیحون شود"
  },
  {
    "poem_id": 1925,
    "vorder": 207,
    "position": 0,
    "text": "ز راز سپهری کس آگاه نیست"
  },
  {
    "poem_id": 1925,
    "vorder": 208,
    "position": 1,
    "text": "ندانند کاین رنج کوتاه نیست"
  },
  {
    "poem_id": 1925,
    "vorder": 209,
    "position": 0,
    "text": "چو بر تخمه‌ای بگذرد روزگار"
  },
  {
    "poem_id": 1925,
    "vorder": 210,
    "position": 1,
    "text": "چه سود آید از رنج وز کارزار"
  },
  {
    "poem_id": 1925,
    "vorder": 211,
    "position": 0,
    "text": "تو را ای برادر تن آباد باد"
  },
  {
    "poem_id": 1925,
    "vorder": 212,
    "position": 1,
    "text": "دل شاه ایران به تو شاد باد"
  },
  {
    "poem_id": 1925,
    "vorder": 213,
    "position": 0,
    "text": "که این قادسی گورگاه منست"
  },
  {
    "poem_id": 1925,
    "vorder": 214,
    "position": 1,
    "text": "کفن جوشن و خون کلاه منست"
  },
  {
    "poem_id": 1925,
    "vorder": 215,
    "position": 0,
    "text": "چنین است راز سپهر بلند"
  },
  {
    "poem_id": 1925,
    "vorder": 216,
    "position": 1,
    "text": "تو دل را به درد من اندر مبند"
  },
  {
    "poem_id": 1925,
    "vorder": 217,
    "position": 0,
    "text": "دو دیده ز شاه جهان برمدار"
  },
  {
    "poem_id": 1925,
    "vorder": 218,
    "position": 1,
    "text": "فدی کن تن خویش در کارزار"
  },
  {
    "poem_id": 1925,
    "vorder": 219,
    "position": 0,
    "text": "که زود آید این روز آهرمنی"
  },
  {
    "poem_id": 1925,
    "vorder": 220,
    "position": 1,
    "text": "چو گردون گردان کند دشمنی"
  },
  {
    "poem_id": 1925,
    "vorder": 221,
    "position": 0,
    "text": "چو نامه به مُهر اندر آورد گفت"
  },
  {
    "poem_id": 1925,
    "vorder": 222,
    "position": 1,
    "text": "که پوینده با آفرین باد جفت"
  },
  {
    "poem_id": 1925,
    "vorder": 223,
    "position": 0,
    "text": "که این نامه نزد برادر بَرَد"
  },
  {
    "poem_id": 1925,
    "vorder": 224,
    "position": 1,
    "text": "بگوید جزین هرچ اندرخورد"
  }
]