[
  {
    "poem_id": 1906,
    "vorder": 1,
    "position": 0,
    "text": "از ایوان خسرو کنون داستان"
  },
  {
    "poem_id": 1906,
    "vorder": 2,
    "position": 1,
    "text": "بگویم که پیش آمد از راستان"
  },
  {
    "poem_id": 1906,
    "vorder": 3,
    "position": 0,
    "text": "جهان بر کهان و مهان بگذرد"
  },
  {
    "poem_id": 1906,
    "vorder": 4,
    "position": 1,
    "text": "خردمند مردم چرا غم خورد"
  },
  {
    "poem_id": 1906,
    "vorder": 5,
    "position": 0,
    "text": "بسی مهتر و کهتر از من گذشت"
  },
  {
    "poem_id": 1906,
    "vorder": 6,
    "position": 1,
    "text": "نخواهم من از خواب بیدار گشت"
  },
  {
    "poem_id": 1906,
    "vorder": 7,
    "position": 0,
    "text": "همانا که شد سال بر شست و شش"
  },
  {
    "poem_id": 1906,
    "vorder": 8,
    "position": 1,
    "text": "نه نیکو بود مردم پیرکش"
  },
  {
    "poem_id": 1906,
    "vorder": 9,
    "position": 0,
    "text": "چو این نامور نامه آید به بن"
  },
  {
    "poem_id": 1906,
    "vorder": 10,
    "position": 1,
    "text": "ز من روی کشور شود پر سخن"
  },
  {
    "poem_id": 1906,
    "vorder": 11,
    "position": 0,
    "text": "از آن پس نمیرم که من زنده‌ام"
  },
  {
    "poem_id": 1906,
    "vorder": 12,
    "position": 1,
    "text": "که تخم سخن من پراگنده‌ام"
  },
  {
    "poem_id": 1906,
    "vorder": 13,
    "position": 0,
    "text": "هر آن کس که دارد هش و رای و دین"
  },
  {
    "poem_id": 1906,
    "vorder": 14,
    "position": 1,
    "text": "پس از مرگ بر من کند آفرین"
  },
  {
    "poem_id": 1906,
    "vorder": 15,
    "position": 0,
    "text": "کنون از مداین سخن نو کنم"
  },
  {
    "poem_id": 1906,
    "vorder": 16,
    "position": 1,
    "text": "صفت‌های ایوان خسرو کنم"
  },
  {
    "poem_id": 1906,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت روشن‌دل پارسی"
  },
  {
    "poem_id": 1906,
    "vorder": 18,
    "position": 1,
    "text": "که بگذاشت با کام دل چارسی"
  },
  {
    "poem_id": 1906,
    "vorder": 19,
    "position": 0,
    "text": "که خسرو فرستاد کسها به روم"
  },
  {
    "poem_id": 1906,
    "vorder": 20,
    "position": 1,
    "text": "به هند و به چین و به آباد بوم"
  },
  {
    "poem_id": 1906,
    "vorder": 21,
    "position": 0,
    "text": "برفتند کاری گران سه هزار"
  },
  {
    "poem_id": 1906,
    "vorder": 22,
    "position": 1,
    "text": "ز هر کشوری آنک بد نامدار"
  },
  {
    "poem_id": 1906,
    "vorder": 23,
    "position": 0,
    "text": "از ایشان هر آن کس که استاد بود"
  },
  {
    "poem_id": 1906,
    "vorder": 24,
    "position": 1,
    "text": "ز خشت و ز گچ بر دلش یاد بود"
  },
  {
    "poem_id": 1906,
    "vorder": 25,
    "position": 0,
    "text": "چو صد مرد بیرون شد از رومیان"
  },
  {
    "poem_id": 1906,
    "vorder": 26,
    "position": 1,
    "text": "ز ایران و اهواز وز هر میان"
  },
  {
    "poem_id": 1906,
    "vorder": 27,
    "position": 0,
    "text": "از ایشان دلاور گزیدند سی"
  },
  {
    "poem_id": 1906,
    "vorder": 28,
    "position": 1,
    "text": "از آن سی دو رومی و دو پارسی"
  },
  {
    "poem_id": 1906,
    "vorder": 29,
    "position": 0,
    "text": "بر خسرو آمد جهاندیده مرد"
  },
  {
    "poem_id": 1906,
    "vorder": 30,
    "position": 1,
    "text": "بر او کار و زخم بنا یاد کرد"
  },
  {
    "poem_id": 1906,
    "vorder": 31,
    "position": 0,
    "text": "گرانمایه رومی که بد هندسی"
  },
  {
    "poem_id": 1906,
    "vorder": 32,
    "position": 1,
    "text": "به گفتار بگذشت از پارسی"
  },
  {
    "poem_id": 1906,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت شاه این ز من در پذیر"
  },
  {
    "poem_id": 1906,
    "vorder": 34,
    "position": 1,
    "text": "سخن هرچ گویم ز من یاد گیر"
  },
  {
    "poem_id": 1906,
    "vorder": 35,
    "position": 0,
    "text": "یکی جای خواهم که فرزند من"
  },
  {
    "poem_id": 1906,
    "vorder": 36,
    "position": 1,
    "text": "همان تا دو صدسال پیوند من"
  },
  {
    "poem_id": 1906,
    "vorder": 37,
    "position": 0,
    "text": "نشیند بدو در نگردد خراب"
  },
  {
    "poem_id": 1906,
    "vorder": 38,
    "position": 1,
    "text": "ز باران وز برف وز آفتاب"
  },
  {
    "poem_id": 1906,
    "vorder": 39,
    "position": 0,
    "text": "مهندس بپذیرفت ایوان شاه"
  },
  {
    "poem_id": 1906,
    "vorder": 40,
    "position": 1,
    "text": "بدو گفت من دارم این دستگاه"
  },
  {
    "poem_id": 1906,
    "vorder": 41,
    "position": 0,
    "text": "فرو برد بنیاد ده شاه رش"
  },
  {
    "poem_id": 1906,
    "vorder": 42,
    "position": 1,
    "text": "همان شاه رش پنج کرده برش"
  },
  {
    "poem_id": 1906,
    "vorder": 43,
    "position": 0,
    "text": "ز سنگ و ز گچ بود بنیاد کار"
  },
  {
    "poem_id": 1906,
    "vorder": 44,
    "position": 1,
    "text": "چنین باید آن کو دهد داد کار"
  },
  {
    "poem_id": 1906,
    "vorder": 45,
    "position": 0,
    "text": "چو دیوار ایوانش آمد به جای"
  },
  {
    "poem_id": 1906,
    "vorder": 46,
    "position": 1,
    "text": "بیامد به پیش جهان‌کد‌خدای"
  },
  {
    "poem_id": 1906,
    "vorder": 47,
    "position": 0,
    "text": "که گر شاه بیند یکی کاردان"
  },
  {
    "poem_id": 1906,
    "vorder": 48,
    "position": 1,
    "text": "گذشته برو سال و بسیاردان"
  },
  {
    "poem_id": 1906,
    "vorder": 49,
    "position": 0,
    "text": "فرستد تنی صد بدین بارگاه"
  },
  {
    "poem_id": 1906,
    "vorder": 50,
    "position": 1,
    "text": "پسندیده با موبد نیک‌خواه"
  },
  {
    "poem_id": 1906,
    "vorder": 51,
    "position": 0,
    "text": "بدو داد زان گونه مردم که خواست"
  },
  {
    "poem_id": 1906,
    "vorder": 52,
    "position": 1,
    "text": "برفتند و دیدند دیوار راست"
  },
  {
    "poem_id": 1906,
    "vorder": 53,
    "position": 0,
    "text": "بریشم بیاورد تا انجمن"
  },
  {
    "poem_id": 1906,
    "vorder": 54,
    "position": 1,
    "text": "بتابند باریک تابی رسن"
  },
  {
    "poem_id": 1906,
    "vorder": 55,
    "position": 0,
    "text": "ز بالای آن تابداده رسن"
  },
  {
    "poem_id": 1906,
    "vorder": 56,
    "position": 1,
    "text": "به پیموده در پیش آن انجمن"
  },
  {
    "poem_id": 1906,
    "vorder": 57,
    "position": 0,
    "text": "رسن سوی گنج شهنشاه برد"
  },
  {
    "poem_id": 1906,
    "vorder": 58,
    "position": 1,
    "text": "ابا مهر گنجور او را سپرد"
  },
  {
    "poem_id": 1906,
    "vorder": 59,
    "position": 0,
    "text": "وزان پس بیامد به ایوان شاه"
  },
  {
    "poem_id": 1906,
    "vorder": 60,
    "position": 1,
    "text": "که دیوار ایوان برآمد به ماه"
  },
  {
    "poem_id": 1906,
    "vorder": 61,
    "position": 0,
    "text": "چو فرمان دهد خسرو زود یاب"
  },
  {
    "poem_id": 1906,
    "vorder": 62,
    "position": 1,
    "text": "نگیرم برین کار کردن شتاب"
  },
  {
    "poem_id": 1906,
    "vorder": 63,
    "position": 0,
    "text": "چهل روز تا کار بنشیندم"
  },
  {
    "poem_id": 1906,
    "vorder": 64,
    "position": 1,
    "text": "ز کاری گران شاه بگزیندم"
  },
  {
    "poem_id": 1906,
    "vorder": 65,
    "position": 0,
    "text": "چو هنگامهٔ زخم ایوان بود"
  },
  {
    "poem_id": 1906,
    "vorder": 66,
    "position": 1,
    "text": "بلندی ایوان چو کیوان بود"
  },
  {
    "poem_id": 1906,
    "vorder": 67,
    "position": 0,
    "text": "بدان زخم خشمت نباید نمود"
  },
  {
    "poem_id": 1906,
    "vorder": 68,
    "position": 1,
    "text": "مرا نیز رنجی نباید فزود"
  },
  {
    "poem_id": 1906,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت خسرو که چندین زمان"
  },
  {
    "poem_id": 1906,
    "vorder": 70,
    "position": 1,
    "text": "چرا خواهی از من تو ای بدگمان"
  },
  {
    "poem_id": 1906,
    "vorder": 71,
    "position": 0,
    "text": "نباید که داری ازین دست باز"
  },
  {
    "poem_id": 1906,
    "vorder": 72,
    "position": 1,
    "text": "به آزرم بودن بیامد نیاز"
  },
  {
    "poem_id": 1906,
    "vorder": 73,
    "position": 0,
    "text": "بفرمود تا سی هزارش درم"
  },
  {
    "poem_id": 1906,
    "vorder": 74,
    "position": 1,
    "text": "بدادند تا او نباشد دژم"
  },
  {
    "poem_id": 1906,
    "vorder": 75,
    "position": 0,
    "text": "بدانست کاری‌گر راست‌گوی"
  },
  {
    "poem_id": 1906,
    "vorder": 76,
    "position": 1,
    "text": "که عیب آورد مرد دانا به‌روی"
  },
  {
    "poem_id": 1906,
    "vorder": 77,
    "position": 0,
    "text": "که گیرد بران زخم ایوان شتاب"
  },
  {
    "poem_id": 1906,
    "vorder": 78,
    "position": 1,
    "text": "اگر بشکند کم کند نان و آب"
  },
  {
    "poem_id": 1906,
    "vorder": 79,
    "position": 0,
    "text": "شب آمد بشد کارگر ناپدید"
  },
  {
    "poem_id": 1906,
    "vorder": 80,
    "position": 1,
    "text": "چنان شد کزان پس کس او را ندید"
  },
  {
    "poem_id": 1906,
    "vorder": 81,
    "position": 0,
    "text": "چو بشنید خسرو که فرعان گریخت"
  },
  {
    "poem_id": 1906,
    "vorder": 82,
    "position": 1,
    "text": "به گوینده بر خشم فرعان بریخت"
  },
  {
    "poem_id": 1906,
    "vorder": 83,
    "position": 0,
    "text": "چنین گفت کان را که دانش نبود"
  },
  {
    "poem_id": 1906,
    "vorder": 84,
    "position": 1,
    "text": "چرا پیش ما در فزونی نمود"
  },
  {
    "poem_id": 1906,
    "vorder": 85,
    "position": 0,
    "text": "بفرمود تا کار او بنگرند"
  },
  {
    "poem_id": 1906,
    "vorder": 86,
    "position": 1,
    "text": "همه رومیان را به زندان برند"
  },
  {
    "poem_id": 1906,
    "vorder": 87,
    "position": 0,
    "text": "دگر گفت کاری گران آورید"
  },
  {
    "poem_id": 1906,
    "vorder": 88,
    "position": 1,
    "text": "گچ و خشت و سنگ گران آورید"
  },
  {
    "poem_id": 1906,
    "vorder": 89,
    "position": 0,
    "text": "بجستند هرکس که دیوار دید"
  },
  {
    "poem_id": 1906,
    "vorder": 90,
    "position": 1,
    "text": "ز بوم و بر شاه شد ناپدید"
  },
  {
    "poem_id": 1906,
    "vorder": 91,
    "position": 0,
    "text": "به بیچارگی دست ازان بازداشت"
  },
  {
    "poem_id": 1906,
    "vorder": 92,
    "position": 1,
    "text": "همی گوش و دل سوی اهواز داشت"
  },
  {
    "poem_id": 1906,
    "vorder": 93,
    "position": 0,
    "text": "کزان شهر کاری گر آید کسی"
  },
  {
    "poem_id": 1906,
    "vorder": 94,
    "position": 1,
    "text": "نماند چنان کار بی بر بسی"
  },
  {
    "poem_id": 1906,
    "vorder": 95,
    "position": 0,
    "text": "همی‌جست استاد آن تا سه سال"
  },
  {
    "poem_id": 1906,
    "vorder": 96,
    "position": 1,
    "text": "ندیدند کاریگری بی‌همال"
  },
  {
    "poem_id": 1906,
    "vorder": 97,
    "position": 0,
    "text": "بسی یاد کردند زان کارجوی"
  },
  {
    "poem_id": 1906,
    "vorder": 98,
    "position": 1,
    "text": "به سال چهارم پدید آمد اوی"
  },
  {
    "poem_id": 1906,
    "vorder": 99,
    "position": 0,
    "text": "یکی مرد بیدار با فرهی"
  },
  {
    "poem_id": 1906,
    "vorder": 100,
    "position": 1,
    "text": "به خسرو رسانید زو آگهی"
  },
  {
    "poem_id": 1906,
    "vorder": 101,
    "position": 0,
    "text": "هم آنگاه رومی بیامد چو گرد"
  },
  {
    "poem_id": 1906,
    "vorder": 102,
    "position": 1,
    "text": "بدو گفت شاه‌ای گنهکار مرد"
  },
  {
    "poem_id": 1906,
    "vorder": 103,
    "position": 0,
    "text": "بگو تا چه بود اندرین پوزشت"
  },
  {
    "poem_id": 1906,
    "vorder": 104,
    "position": 1,
    "text": "چه گفتی که پیش آمد آموزشت"
  },
  {
    "poem_id": 1906,
    "vorder": 105,
    "position": 0,
    "text": "چنین گفت رومی که گر شهریار"
  },
  {
    "poem_id": 1906,
    "vorder": 106,
    "position": 1,
    "text": "فرستد مرا با یکی استوار"
  },
  {
    "poem_id": 1906,
    "vorder": 107,
    "position": 0,
    "text": "بگویم بدان کاردان پوزشم"
  },
  {
    "poem_id": 1906,
    "vorder": 108,
    "position": 1,
    "text": "به پوزش بجا آید افروزشم"
  },
  {
    "poem_id": 1906,
    "vorder": 109,
    "position": 0,
    "text": "فرستاد و رفتند ز ایوان شاه"
  },
  {
    "poem_id": 1906,
    "vorder": 110,
    "position": 1,
    "text": "گران مایه استاد با نیک خواه"
  },
  {
    "poem_id": 1906,
    "vorder": 111,
    "position": 0,
    "text": "همی‌برد دانای رومی رسن"
  },
  {
    "poem_id": 1906,
    "vorder": 112,
    "position": 1,
    "text": "همان مرد را نیز با خویشتن"
  },
  {
    "poem_id": 1906,
    "vorder": 113,
    "position": 0,
    "text": "به پیمود بالای کار و برش"
  },
  {
    "poem_id": 1906,
    "vorder": 114,
    "position": 1,
    "text": "کم آمد ز کار از رسن هفت رش"
  },
  {
    "poem_id": 1906,
    "vorder": 115,
    "position": 0,
    "text": "رسن باز بردند نزدیک شاه"
  },
  {
    "poem_id": 1906,
    "vorder": 116,
    "position": 1,
    "text": "بگفت آنک با او بیامد به راه"
  },
  {
    "poem_id": 1906,
    "vorder": 117,
    "position": 0,
    "text": "چنین گفت رومی که ار زخم کار"
  },
  {
    "poem_id": 1906,
    "vorder": 118,
    "position": 1,
    "text": "برآورد می بر سر ای شهریار"
  },
  {
    "poem_id": 1906,
    "vorder": 119,
    "position": 0,
    "text": "نه دیوار ماندی نه طاق ونه کار"
  },
  {
    "poem_id": 1906,
    "vorder": 120,
    "position": 1,
    "text": "نه من ماندمی بر در شهریار"
  },
  {
    "poem_id": 1906,
    "vorder": 121,
    "position": 0,
    "text": "بدانست خسرو که او راست گفت"
  },
  {
    "poem_id": 1906,
    "vorder": 122,
    "position": 1,
    "text": "کسی راستی را نیارد نهفت"
  },
  {
    "poem_id": 1906,
    "vorder": 123,
    "position": 0,
    "text": "رها کرد هر کو به زندان بدند"
  },
  {
    "poem_id": 1906,
    "vorder": 124,
    "position": 1,
    "text": "بد اندیش گر بی‌گزندان بدند"
  },
  {
    "poem_id": 1906,
    "vorder": 125,
    "position": 0,
    "text": "مر او را یکی بدره دینار داد"
  },
  {
    "poem_id": 1906,
    "vorder": 126,
    "position": 1,
    "text": "به زندانیان چیز بسیار داد"
  },
  {
    "poem_id": 1906,
    "vorder": 127,
    "position": 0,
    "text": "بران کار شد روزگار دراز"
  },
  {
    "poem_id": 1906,
    "vorder": 128,
    "position": 1,
    "text": "به کردار آن شاه را بد نیاز"
  },
  {
    "poem_id": 1906,
    "vorder": 129,
    "position": 0,
    "text": "چوشد هفت سال آمد ایوان بجای"
  },
  {
    "poem_id": 1906,
    "vorder": 130,
    "position": 1,
    "text": "پسندیدهٔ خسرو پاک‌رای"
  },
  {
    "poem_id": 1906,
    "vorder": 131,
    "position": 0,
    "text": "مر او را بسی آب داد و زمین"
  },
  {
    "poem_id": 1906,
    "vorder": 132,
    "position": 1,
    "text": "درم داد و دینار و کرد آفرین"
  },
  {
    "poem_id": 1906,
    "vorder": 133,
    "position": 0,
    "text": "همی‌کرد هرکس به ایوان نگاه"
  },
  {
    "poem_id": 1906,
    "vorder": 134,
    "position": 1,
    "text": "به نوروز رفتی بدان جایگاه"
  },
  {
    "poem_id": 1906,
    "vorder": 135,
    "position": 0,
    "text": "کس اندر جهان زخم چونین ندید"
  },
  {
    "poem_id": 1906,
    "vorder": 136,
    "position": 1,
    "text": "نه از کاردانان پیشین شنید"
  },
  {
    "poem_id": 1906,
    "vorder": 137,
    "position": 0,
    "text": "یکی حلقه زرین بدی ریخته"
  },
  {
    "poem_id": 1906,
    "vorder": 138,
    "position": 1,
    "text": "ازان چرخ کار اندر آویخته"
  },
  {
    "poem_id": 1906,
    "vorder": 139,
    "position": 0,
    "text": "فروهشته زو سرخ زنجیر زر"
  },
  {
    "poem_id": 1906,
    "vorder": 140,
    "position": 1,
    "text": "به هر مهره‌ای در نشانده گهر"
  },
  {
    "poem_id": 1906,
    "vorder": 141,
    "position": 0,
    "text": "چو رفتی شهنشاه بر تخت عاج"
  },
  {
    "poem_id": 1906,
    "vorder": 142,
    "position": 1,
    "text": "بیاویختندی ز زنجیر تاج"
  },
  {
    "poem_id": 1906,
    "vorder": 143,
    "position": 0,
    "text": "به نوروز چون برنشستی به تخت"
  },
  {
    "poem_id": 1906,
    "vorder": 144,
    "position": 1,
    "text": "به نزدیک او موبد نیک بخت"
  },
  {
    "poem_id": 1906,
    "vorder": 145,
    "position": 0,
    "text": "فروتر ز موبد مهان را بدی"
  },
  {
    "poem_id": 1906,
    "vorder": 146,
    "position": 1,
    "text": "بزرگان و روزی دهان را بدی"
  },
  {
    "poem_id": 1906,
    "vorder": 147,
    "position": 0,
    "text": "به زیر مهان جای بازاریان"
  },
  {
    "poem_id": 1906,
    "vorder": 148,
    "position": 1,
    "text": "بیاراستندی همه کاریان"
  },
  {
    "poem_id": 1906,
    "vorder": 149,
    "position": 0,
    "text": "فرومایه‌تر جای درویش بود"
  },
  {
    "poem_id": 1906,
    "vorder": 150,
    "position": 1,
    "text": "کجا خوردش از کوشش خویش بود"
  },
  {
    "poem_id": 1906,
    "vorder": 151,
    "position": 0,
    "text": "فروتر بریده بسی دست و پای"
  },
  {
    "poem_id": 1906,
    "vorder": 152,
    "position": 1,
    "text": "بسی کشته افگنده در زیرجای"
  },
  {
    "poem_id": 1906,
    "vorder": 153,
    "position": 0,
    "text": "ز ایوان ازان پس خروش آمدی"
  },
  {
    "poem_id": 1906,
    "vorder": 154,
    "position": 1,
    "text": "کز آوازها دل به جوش آمدی"
  },
  {
    "poem_id": 1906,
    "vorder": 155,
    "position": 0,
    "text": "که ای زیردستان شاه جهان"
  },
  {
    "poem_id": 1906,
    "vorder": 156,
    "position": 1,
    "text": "مباشید تیره دل و بدگمان"
  },
  {
    "poem_id": 1906,
    "vorder": 157,
    "position": 0,
    "text": "هر آنکس که او سوی بالا نگاه"
  },
  {
    "poem_id": 1906,
    "vorder": 158,
    "position": 1,
    "text": "کند گردد اندیشه او تباه"
  },
  {
    "poem_id": 1906,
    "vorder": 159,
    "position": 0,
    "text": "ز تخت کیان دورتر بنگرید"
  },
  {
    "poem_id": 1906,
    "vorder": 160,
    "position": 1,
    "text": "هر آنکس که کهتر بود بشمرید"
  },
  {
    "poem_id": 1906,
    "vorder": 161,
    "position": 0,
    "text": "وزان پس تن کشتگان را به راه"
  },
  {
    "poem_id": 1906,
    "vorder": 162,
    "position": 1,
    "text": "کزان بگذری کرد باید نگاه"
  },
  {
    "poem_id": 1906,
    "vorder": 163,
    "position": 0,
    "text": "وزان پس گنهگار و گر بیگناه"
  },
  {
    "poem_id": 1906,
    "vorder": 164,
    "position": 1,
    "text": "نماندی کسی نیز دربند شاه"
  },
  {
    "poem_id": 1906,
    "vorder": 165,
    "position": 0,
    "text": "به ارزانیان جامه‌ها داد نیز"
  },
  {
    "poem_id": 1906,
    "vorder": 166,
    "position": 1,
    "text": "ز دیبا و دینار و هرگونه چیز"
  },
  {
    "poem_id": 1906,
    "vorder": 167,
    "position": 0,
    "text": "هرآنکس که درویش بودی به شهر"
  },
  {
    "poem_id": 1906,
    "vorder": 168,
    "position": 1,
    "text": "که او را نبودی ز نوروز بهر"
  },
  {
    "poem_id": 1906,
    "vorder": 169,
    "position": 0,
    "text": "به درگاه ایوانش بنشاندند"
  },
  {
    "poem_id": 1906,
    "vorder": 170,
    "position": 1,
    "text": "درمهای گنجی بر افشاندند"
  },
  {
    "poem_id": 1906,
    "vorder": 171,
    "position": 0,
    "text": "پر از بیم بودی گنهکار از وی"
  },
  {
    "poem_id": 1906,
    "vorder": 172,
    "position": 1,
    "text": "شده مردم خفته بیدار از وی"
  },
  {
    "poem_id": 1906,
    "vorder": 173,
    "position": 0,
    "text": "منادیگری دیگر اندر سرای"
  },
  {
    "poem_id": 1906,
    "vorder": 174,
    "position": 1,
    "text": "برفتی گه بازگشتن به جای"
  },
  {
    "poem_id": 1906,
    "vorder": 175,
    "position": 0,
    "text": "که ای نامور پر هنر سرکشان"
  },
  {
    "poem_id": 1906,
    "vorder": 176,
    "position": 1,
    "text": "ز بیشی چه جویید چندین نشان"
  },
  {
    "poem_id": 1906,
    "vorder": 177,
    "position": 0,
    "text": "به کار اندر اندیشه باید نخست"
  },
  {
    "poem_id": 1906,
    "vorder": 178,
    "position": 1,
    "text": "بدان تا شود ایمن و تن درست"
  },
  {
    "poem_id": 1906,
    "vorder": 179,
    "position": 0,
    "text": "سگالید هر کار و زان پس کنید"
  },
  {
    "poem_id": 1906,
    "vorder": 180,
    "position": 1,
    "text": "دل مردم کم سخن مشکنید"
  },
  {
    "poem_id": 1906,
    "vorder": 181,
    "position": 0,
    "text": "بر انداخت باید پس آنگه برید"
  },
  {
    "poem_id": 1906,
    "vorder": 182,
    "position": 1,
    "text": "سخن‌های داننده باید شنید"
  },
  {
    "poem_id": 1906,
    "vorder": 183,
    "position": 0,
    "text": "ببینید تا از شما ریز کیست"
  },
  {
    "poem_id": 1906,
    "vorder": 184,
    "position": 1,
    "text": "که بر جان بدبخت باید گریست"
  },
  {
    "poem_id": 1906,
    "vorder": 185,
    "position": 0,
    "text": "هرآنکس که او راه دارد نگاه"
  },
  {
    "poem_id": 1906,
    "vorder": 186,
    "position": 1,
    "text": "بخسپد برین گاه ایمن ز شاه"
  },
  {
    "poem_id": 1906,
    "vorder": 187,
    "position": 0,
    "text": "دگر هرک یازد به چیز کسان"
  },
  {
    "poem_id": 1906,
    "vorder": 188,
    "position": 1,
    "text": "بود چشم ما سوی آنکس رسان"
  }
]