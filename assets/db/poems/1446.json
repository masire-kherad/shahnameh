[
  {
    "poem_id": 1446,
    "vorder": 1,
    "position": 0,
    "text": "چو کاووس در شهر ایران رسید"
  },
  {
    "poem_id": 1446,
    "vorder": 2,
    "position": 1,
    "text": "ز گرد سپه شد هوا ناپدید"
  },
  {
    "poem_id": 1446,
    "vorder": 3,
    "position": 0,
    "text": "برآمد همی تا به خورشید جوش"
  },
  {
    "poem_id": 1446,
    "vorder": 4,
    "position": 1,
    "text": "زن و مرد شد پیش او با خروش"
  },
  {
    "poem_id": 1446,
    "vorder": 5,
    "position": 0,
    "text": "همه شهر ایران بیاراستند"
  },
  {
    "poem_id": 1446,
    "vorder": 6,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1446,
    "vorder": 7,
    "position": 0,
    "text": "جهان سر به سر نو شد از شاه نو"
  },
  {
    "poem_id": 1446,
    "vorder": 8,
    "position": 1,
    "text": "ز ایران برآمد یکی ماه نو"
  },
  {
    "poem_id": 1446,
    "vorder": 9,
    "position": 0,
    "text": "چو بر تخت بنشست پیروز و شاد"
  },
  {
    "poem_id": 1446,
    "vorder": 10,
    "position": 1,
    "text": "در گنجهای کهن برگشاد"
  },
  {
    "poem_id": 1446,
    "vorder": 11,
    "position": 0,
    "text": "ز هر جای روزی‌دهان را بخواند"
  },
  {
    "poem_id": 1446,
    "vorder": 12,
    "position": 1,
    "text": "به دیوان دینار دادن نشاند"
  },
  {
    "poem_id": 1446,
    "vorder": 13,
    "position": 0,
    "text": "برآمد خروش از در پیلتن"
  },
  {
    "poem_id": 1446,
    "vorder": 14,
    "position": 1,
    "text": "بزرگان لشکر شدند انجمن"
  },
  {
    "poem_id": 1446,
    "vorder": 15,
    "position": 0,
    "text": "همه شادمان نزد شاه آمدند"
  },
  {
    "poem_id": 1446,
    "vorder": 16,
    "position": 1,
    "text": "بران نامور پیشگاه آمدند"
  },
  {
    "poem_id": 1446,
    "vorder": 17,
    "position": 0,
    "text": "تهمتن بیامد به سر بر کلاه"
  },
  {
    "poem_id": 1446,
    "vorder": 18,
    "position": 1,
    "text": "نشست از بر تخت نزدیک شاه"
  },
  {
    "poem_id": 1446,
    "vorder": 19,
    "position": 0,
    "text": "سزاوار او شهریار زمین"
  },
  {
    "poem_id": 1446,
    "vorder": 20,
    "position": 1,
    "text": "یکی خلعت آراست با آفرین"
  },
  {
    "poem_id": 1446,
    "vorder": 21,
    "position": 0,
    "text": "یکی تخت پیروزه و میش‌سار"
  },
  {
    "poem_id": 1446,
    "vorder": 22,
    "position": 1,
    "text": "یکی خسروی تاج گوهر نگار"
  },
  {
    "poem_id": 1446,
    "vorder": 23,
    "position": 0,
    "text": "یکی دست زربفت شاهنشهی"
  },
  {
    "poem_id": 1446,
    "vorder": 24,
    "position": 1,
    "text": "ابا یاره و طوق و با فرهی"
  },
  {
    "poem_id": 1446,
    "vorder": 25,
    "position": 0,
    "text": "صد از ماهرویان زرین کمر"
  },
  {
    "poem_id": 1446,
    "vorder": 26,
    "position": 1,
    "text": "صد از مشک مویان با زیب و فر"
  },
  {
    "poem_id": 1446,
    "vorder": 27,
    "position": 0,
    "text": "صد از اسپ با زین و زرین ستام"
  },
  {
    "poem_id": 1446,
    "vorder": 28,
    "position": 1,
    "text": "صد استر سیه موی و زرین لگام"
  },
  {
    "poem_id": 1446,
    "vorder": 29,
    "position": 0,
    "text": "همه بارشان دیبهٔ خسروی"
  },
  {
    "poem_id": 1446,
    "vorder": 30,
    "position": 1,
    "text": "ز چینی و رومی و از پهلوی"
  },
  {
    "poem_id": 1446,
    "vorder": 31,
    "position": 0,
    "text": "ببردند صد بدره دینار نیز"
  },
  {
    "poem_id": 1446,
    "vorder": 32,
    "position": 1,
    "text": "ز رنگ و ز بوی و ز هرگونه چیز"
  },
  {
    "poem_id": 1446,
    "vorder": 33,
    "position": 0,
    "text": "ز یاقوت جامی پر از مشک ناب"
  },
  {
    "poem_id": 1446,
    "vorder": 34,
    "position": 1,
    "text": "ز پیروزه دیگر یکی پر گلاب"
  },
  {
    "poem_id": 1446,
    "vorder": 35,
    "position": 0,
    "text": "نوشته یکی نامه‌ای بر حریر"
  },
  {
    "poem_id": 1446,
    "vorder": 36,
    "position": 1,
    "text": "ز مشک و ز عنبر ز عود و عبیر"
  },
  {
    "poem_id": 1446,
    "vorder": 37,
    "position": 0,
    "text": "سپرد این به سالار گیتی فروز"
  },
  {
    "poem_id": 1446,
    "vorder": 38,
    "position": 1,
    "text": "به نوی همه کشور نیمروز"
  },
  {
    "poem_id": 1446,
    "vorder": 39,
    "position": 0,
    "text": "چنان کز پس عهد کاووس شاه"
  },
  {
    "poem_id": 1446,
    "vorder": 40,
    "position": 1,
    "text": "نباشد بران تخت کس را کلاه"
  },
  {
    "poem_id": 1446,
    "vorder": 41,
    "position": 0,
    "text": "مگر نامور رستم زال را"
  },
  {
    "poem_id": 1446,
    "vorder": 42,
    "position": 1,
    "text": "خداوند شمشیر و گوپال را"
  },
  {
    "poem_id": 1446,
    "vorder": 43,
    "position": 0,
    "text": "ازان پس برو آفرین کرد شاه"
  },
  {
    "poem_id": 1446,
    "vorder": 44,
    "position": 1,
    "text": "که بی‌تو مبیناد کس پیشگاه"
  },
  {
    "poem_id": 1446,
    "vorder": 45,
    "position": 0,
    "text": "دل تاجداران به تو گرم باد"
  },
  {
    "poem_id": 1446,
    "vorder": 46,
    "position": 1,
    "text": "روانت پر از شرم و آزرم باد"
  },
  {
    "poem_id": 1446,
    "vorder": 47,
    "position": 0,
    "text": "فرو برد رستم ببوسید تخت"
  },
  {
    "poem_id": 1446,
    "vorder": 48,
    "position": 1,
    "text": "بسیچ گذر کرد و بربست رخت"
  },
  {
    "poem_id": 1446,
    "vorder": 49,
    "position": 0,
    "text": "خروش تبیره برآمد ز شهر"
  },
  {
    "poem_id": 1446,
    "vorder": 50,
    "position": 1,
    "text": "ز شادی به هرکس رسانید بهر"
  },
  {
    "poem_id": 1446,
    "vorder": 51,
    "position": 0,
    "text": "بشد رستم زال و بنشست شاه"
  },
  {
    "poem_id": 1446,
    "vorder": 52,
    "position": 1,
    "text": "جهان کرد روشن به آیین و راه"
  },
  {
    "poem_id": 1446,
    "vorder": 53,
    "position": 0,
    "text": "به شادی بر تخت زرین نشست"
  },
  {
    "poem_id": 1446,
    "vorder": 54,
    "position": 1,
    "text": "همی جور و بیداد را در ببست"
  },
  {
    "poem_id": 1446,
    "vorder": 55,
    "position": 0,
    "text": "زمین را ببخشید بر مهتران"
  },
  {
    "poem_id": 1446,
    "vorder": 56,
    "position": 1,
    "text": "چو باز آمد از شهر مازندران"
  },
  {
    "poem_id": 1446,
    "vorder": 57,
    "position": 0,
    "text": "به طوس آن زمان داد اسپهبدی"
  },
  {
    "poem_id": 1446,
    "vorder": 58,
    "position": 1,
    "text": "بدو گفت از ایران بگردان بدی"
  },
  {
    "poem_id": 1446,
    "vorder": 59,
    "position": 0,
    "text": "پس آنگه سپاهان به گودرز داد"
  },
  {
    "poem_id": 1446,
    "vorder": 60,
    "position": 1,
    "text": "ورا کام و فرمان آن مرز داد"
  },
  {
    "poem_id": 1446,
    "vorder": 61,
    "position": 0,
    "text": "وزان پس به شادی و می دست برد"
  },
  {
    "poem_id": 1446,
    "vorder": 62,
    "position": 1,
    "text": "جهان را نموده بسی دستبرد"
  },
  {
    "poem_id": 1446,
    "vorder": 63,
    "position": 0,
    "text": "بزد گردن غم به شمشیر داد"
  },
  {
    "poem_id": 1446,
    "vorder": 64,
    "position": 1,
    "text": "نیامد همی بر دل از مرگ یاد"
  },
  {
    "poem_id": 1446,
    "vorder": 65,
    "position": 0,
    "text": "زمین گشت پر سبزه و آب و نم"
  },
  {
    "poem_id": 1446,
    "vorder": 66,
    "position": 1,
    "text": "بیاراست گیتی چو باغ ارم"
  },
  {
    "poem_id": 1446,
    "vorder": 67,
    "position": 0,
    "text": "توانگر شد از داد و از ایمنی"
  },
  {
    "poem_id": 1446,
    "vorder": 68,
    "position": 1,
    "text": "ز بد بسته شد دست اهریمنی"
  },
  {
    "poem_id": 1446,
    "vorder": 69,
    "position": 0,
    "text": "به گیتی خبر شد که کاووس شاه"
  },
  {
    "poem_id": 1446,
    "vorder": 70,
    "position": 1,
    "text": "ز مازندران بستد آن تاج و گاه"
  },
  {
    "poem_id": 1446,
    "vorder": 71,
    "position": 0,
    "text": "بماندند یکسر همه زین شگفت"
  },
  {
    "poem_id": 1446,
    "vorder": 72,
    "position": 1,
    "text": "که کاووس شاه این بزرگی گرفت"
  },
  {
    "poem_id": 1446,
    "vorder": 73,
    "position": 0,
    "text": "همه پاک با هدیه و با نثار"
  },
  {
    "poem_id": 1446,
    "vorder": 74,
    "position": 1,
    "text": "کشیدند صف بر در شهریار"
  },
  {
    "poem_id": 1446,
    "vorder": 75,
    "position": 0,
    "text": "جهان چون بهشتی شد آراسته"
  },
  {
    "poem_id": 1446,
    "vorder": 76,
    "position": 1,
    "text": "پر از داد و آگنده از خواسته"
  },
  {
    "poem_id": 1446,
    "vorder": 77,
    "position": 0,
    "text": "سر آمد کنون رزم مازندران"
  },
  {
    "poem_id": 1446,
    "vorder": 78,
    "position": 1,
    "text": "به پیش آورم جنگ هاماوران"
  }
]