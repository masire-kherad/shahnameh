[
  {
    "poem_id": 1615,
    "vorder": 1,
    "position": 0,
    "text": "چو آمد به نزدیکی هیرمند"
  },
  {
    "poem_id": 1615,
    "vorder": 2,
    "position": 1,
    "text": "فرستاده‌ای برگزید ارجمند"
  },
  {
    "poem_id": 1615,
    "vorder": 3,
    "position": 0,
    "text": "فرستاد نزدیک دستان سام"
  },
  {
    "poem_id": 1615,
    "vorder": 4,
    "position": 1,
    "text": "بدادش ز هر گونه چندی پیام"
  },
  {
    "poem_id": 1615,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کز کین اسفندیار"
  },
  {
    "poem_id": 1615,
    "vorder": 6,
    "position": 1,
    "text": "مرا تلخ شد در جهان روزگار"
  },
  {
    "poem_id": 1615,
    "vorder": 7,
    "position": 0,
    "text": "هم از کین نوش‌آذر و مهر نوش"
  },
  {
    "poem_id": 1615,
    "vorder": 8,
    "position": 1,
    "text": "دو شاه گرامی دو فرخ سروش"
  },
  {
    "poem_id": 1615,
    "vorder": 9,
    "position": 0,
    "text": "ز دل کین دیرینه بیرون کنیم"
  },
  {
    "poem_id": 1615,
    "vorder": 10,
    "position": 1,
    "text": "همه بوم زابل پر از خون کنیم"
  },
  {
    "poem_id": 1615,
    "vorder": 11,
    "position": 0,
    "text": "فرستاده آمد به زابل بگفت"
  },
  {
    "poem_id": 1615,
    "vorder": 12,
    "position": 1,
    "text": "دل زال با درد و غم گشت جفت"
  },
  {
    "poem_id": 1615,
    "vorder": 13,
    "position": 0,
    "text": "چنین داد پاسخ که گر شهریار"
  },
  {
    "poem_id": 1615,
    "vorder": 14,
    "position": 1,
    "text": "براندیشد از کار اسفندیار"
  },
  {
    "poem_id": 1615,
    "vorder": 15,
    "position": 0,
    "text": "بداند که آن بودنی کار بود"
  },
  {
    "poem_id": 1615,
    "vorder": 16,
    "position": 1,
    "text": "مرا زان سخن دل پرآزار بود"
  },
  {
    "poem_id": 1615,
    "vorder": 17,
    "position": 0,
    "text": "تو بودی به نیک و بد اندر میان"
  },
  {
    "poem_id": 1615,
    "vorder": 18,
    "position": 1,
    "text": "ز من سود دیدی ندیدی زیان"
  },
  {
    "poem_id": 1615,
    "vorder": 19,
    "position": 0,
    "text": "نپیچید رستم ز فرمان اوی"
  },
  {
    "poem_id": 1615,
    "vorder": 20,
    "position": 1,
    "text": "دلش بسته بودی به پیمان اوی"
  },
  {
    "poem_id": 1615,
    "vorder": 21,
    "position": 0,
    "text": "پدرت آن گرانمایه شاه بزرگ"
  },
  {
    "poem_id": 1615,
    "vorder": 22,
    "position": 1,
    "text": "زمانش بیامد بدان شد سترگ"
  },
  {
    "poem_id": 1615,
    "vorder": 23,
    "position": 0,
    "text": "به بیشه درون شیر و نر اژدها"
  },
  {
    "poem_id": 1615,
    "vorder": 24,
    "position": 1,
    "text": "ز چنگ زمانه نیابد رها"
  },
  {
    "poem_id": 1615,
    "vorder": 25,
    "position": 0,
    "text": "همانا شنیدی که سام سوار"
  },
  {
    "poem_id": 1615,
    "vorder": 26,
    "position": 1,
    "text": "به مردی چه کرد اندران روزگار"
  },
  {
    "poem_id": 1615,
    "vorder": 27,
    "position": 0,
    "text": "چنین تا به هنگام رستم رسید"
  },
  {
    "poem_id": 1615,
    "vorder": 28,
    "position": 1,
    "text": "که شمشیر تیز از میان برکشید"
  },
  {
    "poem_id": 1615,
    "vorder": 29,
    "position": 0,
    "text": "به پیش نیاکان تو در چه کرد"
  },
  {
    "poem_id": 1615,
    "vorder": 30,
    "position": 1,
    "text": "به مردی به هنگام ننگ و نبرد"
  },
  {
    "poem_id": 1615,
    "vorder": 31,
    "position": 0,
    "text": "همان کهتر و دایگان تو بود"
  },
  {
    "poem_id": 1615,
    "vorder": 32,
    "position": 1,
    "text": "به لشکر ز پرمایگان تو بود"
  },
  {
    "poem_id": 1615,
    "vorder": 33,
    "position": 0,
    "text": "به زاری کنون رستم اندرگذشت"
  },
  {
    "poem_id": 1615,
    "vorder": 34,
    "position": 1,
    "text": "همه زابلستان پرآشوب گشت"
  },
  {
    "poem_id": 1615,
    "vorder": 35,
    "position": 0,
    "text": "شب و روز هستم ز درد پسر"
  },
  {
    "poem_id": 1615,
    "vorder": 36,
    "position": 1,
    "text": "پر از آب دیده پر از خاک سر"
  },
  {
    "poem_id": 1615,
    "vorder": 37,
    "position": 0,
    "text": "خروشان و جوشان و دل پر ز درد"
  },
  {
    "poem_id": 1615,
    "vorder": 38,
    "position": 1,
    "text": "دو رخ زرد و لبها شده لاژورد"
  },
  {
    "poem_id": 1615,
    "vorder": 39,
    "position": 0,
    "text": "که نفرین برو باد کو را ز پای"
  },
  {
    "poem_id": 1615,
    "vorder": 40,
    "position": 1,
    "text": "فگند و بر آنکس که بد رهنمای"
  },
  {
    "poem_id": 1615,
    "vorder": 41,
    "position": 0,
    "text": "گر ایدونک بینی تو پیکار ما"
  },
  {
    "poem_id": 1615,
    "vorder": 42,
    "position": 1,
    "text": "به خوبی براندیشی از کار ما"
  },
  {
    "poem_id": 1615,
    "vorder": 43,
    "position": 0,
    "text": "بیایی ز دل کینه بیرون کنی"
  },
  {
    "poem_id": 1615,
    "vorder": 44,
    "position": 1,
    "text": "به مهر اندرین کشور افسون کنی"
  },
  {
    "poem_id": 1615,
    "vorder": 45,
    "position": 0,
    "text": "همه گنج فرزند و دینار سام"
  },
  {
    "poem_id": 1615,
    "vorder": 46,
    "position": 1,
    "text": "کمرهای زرین و زرین ستام"
  },
  {
    "poem_id": 1615,
    "vorder": 47,
    "position": 0,
    "text": "چو آیی به پیش تو آرم همه"
  },
  {
    "poem_id": 1615,
    "vorder": 48,
    "position": 1,
    "text": "تو شاهی و گردنکشانت رمه"
  },
  {
    "poem_id": 1615,
    "vorder": 49,
    "position": 0,
    "text": "فرستاده را اسپ و دینار داد"
  },
  {
    "poem_id": 1615,
    "vorder": 50,
    "position": 1,
    "text": "ز هرگونه‌ای چیز بسیار داد"
  },
  {
    "poem_id": 1615,
    "vorder": 51,
    "position": 0,
    "text": "چو این مایه‌ور پیش بهمن رسید"
  },
  {
    "poem_id": 1615,
    "vorder": 52,
    "position": 1,
    "text": "ز دستان بگفت آنچ دید و شنید"
  },
  {
    "poem_id": 1615,
    "vorder": 53,
    "position": 0,
    "text": "چو بشنید ازو بهمن نیک‌بخت"
  },
  {
    "poem_id": 1615,
    "vorder": 54,
    "position": 1,
    "text": "نپذرفت پوزش برآشفت سخت"
  },
  {
    "poem_id": 1615,
    "vorder": 55,
    "position": 0,
    "text": "به شهر اندر آمد دلی پر ز درد"
  },
  {
    "poem_id": 1615,
    "vorder": 56,
    "position": 1,
    "text": "سری پر ز کین لب پر از باد سرد"
  },
  {
    "poem_id": 1615,
    "vorder": 57,
    "position": 0,
    "text": "پذیره شدش زال سام سوار"
  },
  {
    "poem_id": 1615,
    "vorder": 58,
    "position": 1,
    "text": "هم از سیستان آنک بد نامدار"
  },
  {
    "poem_id": 1615,
    "vorder": 59,
    "position": 0,
    "text": "چو آمد به نزدیک بهمن فراز"
  },
  {
    "poem_id": 1615,
    "vorder": 60,
    "position": 1,
    "text": "پیاده شد از باره بردش نماز"
  },
  {
    "poem_id": 1615,
    "vorder": 61,
    "position": 0,
    "text": "بدو گفت هنگام بخشایش است"
  },
  {
    "poem_id": 1615,
    "vorder": 62,
    "position": 1,
    "text": "ز دل درد و کین روز پالایش است"
  },
  {
    "poem_id": 1615,
    "vorder": 63,
    "position": 0,
    "text": "ازان نیکویها که ما کرده‌ایم"
  },
  {
    "poem_id": 1615,
    "vorder": 64,
    "position": 1,
    "text": "ترا در جوانی بپرورده‌ایم"
  },
  {
    "poem_id": 1615,
    "vorder": 65,
    "position": 0,
    "text": "ببخشای و کار گذشته مگوی"
  },
  {
    "poem_id": 1615,
    "vorder": 66,
    "position": 1,
    "text": "هنر جوی وز کشتگان کین مجوی"
  },
  {
    "poem_id": 1615,
    "vorder": 67,
    "position": 0,
    "text": "که پیش تو دستان سام سوار"
  },
  {
    "poem_id": 1615,
    "vorder": 68,
    "position": 1,
    "text": "بیامد چنین خوار و با دستوار"
  },
  {
    "poem_id": 1615,
    "vorder": 69,
    "position": 0,
    "text": "برآشفت بهمن ز گفتار اوی"
  },
  {
    "poem_id": 1615,
    "vorder": 70,
    "position": 1,
    "text": "چنان سست شد تیز بازار اوی"
  },
  {
    "poem_id": 1615,
    "vorder": 71,
    "position": 0,
    "text": "هم‌اندر زمان پای کردش به بند"
  },
  {
    "poem_id": 1615,
    "vorder": 72,
    "position": 1,
    "text": "ز دستور و گنجور نشنید پند"
  },
  {
    "poem_id": 1615,
    "vorder": 73,
    "position": 0,
    "text": "ز ایوان دستان سام سوار"
  },
  {
    "poem_id": 1615,
    "vorder": 74,
    "position": 1,
    "text": "شتر بارها برنهادند بار"
  },
  {
    "poem_id": 1615,
    "vorder": 75,
    "position": 0,
    "text": "ز دینار وز گوهر نابسود"
  },
  {
    "poem_id": 1615,
    "vorder": 76,
    "position": 1,
    "text": "ز تخت وز گستردنی هرچ بود"
  },
  {
    "poem_id": 1615,
    "vorder": 77,
    "position": 0,
    "text": "ز سیمینه و تاجهای به زر"
  },
  {
    "poem_id": 1615,
    "vorder": 78,
    "position": 1,
    "text": "ز زرینه و گوشوار و کمر"
  },
  {
    "poem_id": 1615,
    "vorder": 79,
    "position": 0,
    "text": "از اسپان تازی به زرین ستام"
  },
  {
    "poem_id": 1615,
    "vorder": 80,
    "position": 1,
    "text": "ز شمشیر هندی به زرین نیام"
  },
  {
    "poem_id": 1615,
    "vorder": 81,
    "position": 0,
    "text": "همان برده و بدره‌های درم"
  },
  {
    "poem_id": 1615,
    "vorder": 82,
    "position": 1,
    "text": "ز مشک و ز کافور وز بیش و کم"
  },
  {
    "poem_id": 1615,
    "vorder": 83,
    "position": 0,
    "text": "که رستم فراز آورید آن به رنج"
  },
  {
    "poem_id": 1615,
    "vorder": 84,
    "position": 1,
    "text": "ز شاهان و گردنکشان یافت گنج"
  },
  {
    "poem_id": 1615,
    "vorder": 85,
    "position": 0,
    "text": "همه زابلستان به تاراج داد"
  },
  {
    "poem_id": 1615,
    "vorder": 86,
    "position": 1,
    "text": "مهان را همه بدره و تاج داد"
  }
]