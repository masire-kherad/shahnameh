[
  {
    "poem_id": 1791,
    "vorder": 1,
    "position": 0,
    "text": "بیاسود در مرو بهرام‌گور"
  },
  {
    "poem_id": 1791,
    "vorder": 2,
    "position": 1,
    "text": "چو آسوده شد شاه و جنگی ستور"
  },
  {
    "poem_id": 1791,
    "vorder": 3,
    "position": 0,
    "text": "ز تیزی روانش مدارا گزید"
  },
  {
    "poem_id": 1791,
    "vorder": 4,
    "position": 1,
    "text": "دلش رای رزم بخارا گزید"
  },
  {
    "poem_id": 1791,
    "vorder": 5,
    "position": 0,
    "text": "به یک روز و یک شب به آموی شد"
  },
  {
    "poem_id": 1791,
    "vorder": 6,
    "position": 1,
    "text": "ز نخچیر و بازی جهانجوی شد"
  },
  {
    "poem_id": 1791,
    "vorder": 7,
    "position": 0,
    "text": "بیامد ز آموی یک پاس شب"
  },
  {
    "poem_id": 1791,
    "vorder": 8,
    "position": 1,
    "text": "گذر کرد بر آب و ریگ فرب"
  },
  {
    "poem_id": 1791,
    "vorder": 9,
    "position": 0,
    "text": "چو خورشید روی هوا کرد زرد"
  },
  {
    "poem_id": 1791,
    "vorder": 10,
    "position": 1,
    "text": "بینداخت پیراهن لاژورد"
  },
  {
    "poem_id": 1791,
    "vorder": 11,
    "position": 0,
    "text": "زمانه شد از گرد چون پر چرغ"
  },
  {
    "poem_id": 1791,
    "vorder": 12,
    "position": 1,
    "text": "جهانجوی بگذشت بر مای و مرغ"
  },
  {
    "poem_id": 1791,
    "vorder": 13,
    "position": 0,
    "text": "همه لشکر ترک بر هم زدند"
  },
  {
    "poem_id": 1791,
    "vorder": 14,
    "position": 1,
    "text": "به بوم و به دشت آتش اندر زدند"
  },
  {
    "poem_id": 1791,
    "vorder": 15,
    "position": 0,
    "text": "ستاره همی دامن ماه جست"
  },
  {
    "poem_id": 1791,
    "vorder": 16,
    "position": 1,
    "text": "پدر بر پسر بر همی راه جست"
  },
  {
    "poem_id": 1791,
    "vorder": 17,
    "position": 0,
    "text": "ز ترکان هرانکس که بد پیش رو"
  },
  {
    "poem_id": 1791,
    "vorder": 18,
    "position": 1,
    "text": "ز پیران و خنجرگزاران تو"
  },
  {
    "poem_id": 1791,
    "vorder": 19,
    "position": 0,
    "text": "همه پیش بهرام رفتند خوار"
  },
  {
    "poem_id": 1791,
    "vorder": 20,
    "position": 1,
    "text": "پیاده پر از خون دل خاکسار"
  },
  {
    "poem_id": 1791,
    "vorder": 21,
    "position": 0,
    "text": "که شاها ردا و بلند اخترا"
  },
  {
    "poem_id": 1791,
    "vorder": 22,
    "position": 1,
    "text": "بر آزادگان جهان مهترا"
  },
  {
    "poem_id": 1791,
    "vorder": 23,
    "position": 0,
    "text": "گر ایدونک خاقان گنهکار گشت"
  },
  {
    "poem_id": 1791,
    "vorder": 24,
    "position": 1,
    "text": "ز عهد جهاندار بیزار گشت"
  },
  {
    "poem_id": 1791,
    "vorder": 25,
    "position": 0,
    "text": "به دستت گرفتار شد بی‌گمان"
  },
  {
    "poem_id": 1791,
    "vorder": 26,
    "position": 1,
    "text": "چو بشکست پیمان شاه جهان"
  },
  {
    "poem_id": 1791,
    "vorder": 27,
    "position": 0,
    "text": "تو خون سر بیگناهان مریز"
  },
  {
    "poem_id": 1791,
    "vorder": 28,
    "position": 1,
    "text": "نه خوب آید از نامداران ستیز"
  },
  {
    "poem_id": 1791,
    "vorder": 29,
    "position": 0,
    "text": "گر از ما همی باژ خواهی رواست"
  },
  {
    "poem_id": 1791,
    "vorder": 30,
    "position": 1,
    "text": "سر بیگناهان بریدن چراست"
  },
  {
    "poem_id": 1791,
    "vorder": 31,
    "position": 0,
    "text": "همه مرد و زن بندگان توایم"
  },
  {
    "poem_id": 1791,
    "vorder": 32,
    "position": 1,
    "text": "به رزم اندر افگندگان توایم"
  },
  {
    "poem_id": 1791,
    "vorder": 33,
    "position": 0,
    "text": "دل شاه بهرام زیشان بسوخت"
  },
  {
    "poem_id": 1791,
    "vorder": 34,
    "position": 1,
    "text": "به دست خرد چشم خشمش بدوخت"
  },
  {
    "poem_id": 1791,
    "vorder": 35,
    "position": 0,
    "text": "ز خون ریختن دست گردان ببست"
  },
  {
    "poem_id": 1791,
    "vorder": 36,
    "position": 1,
    "text": "پراندیشه شد شاه یزدان‌پرست"
  },
  {
    "poem_id": 1791,
    "vorder": 37,
    "position": 0,
    "text": "چو مهر جهاندار پیوسته شد"
  },
  {
    "poem_id": 1791,
    "vorder": 38,
    "position": 1,
    "text": "دل مرد آشفته آهسته شد"
  },
  {
    "poem_id": 1791,
    "vorder": 39,
    "position": 0,
    "text": "بر شاه شد مهتر مهتران"
  },
  {
    "poem_id": 1791,
    "vorder": 40,
    "position": 1,
    "text": "بپذرفت هر سال باژ گران"
  },
  {
    "poem_id": 1791,
    "vorder": 41,
    "position": 0,
    "text": "ازین کار چون کام او شد روا"
  },
  {
    "poem_id": 1791,
    "vorder": 42,
    "position": 1,
    "text": "ابا باژ بستد ز ترکان نوا"
  },
  {
    "poem_id": 1791,
    "vorder": 43,
    "position": 0,
    "text": "چو برگشت و آمد به شهر فرب"
  },
  {
    "poem_id": 1791,
    "vorder": 44,
    "position": 1,
    "text": "پر از رنگ رخسار و پرخنده لب"
  },
  {
    "poem_id": 1791,
    "vorder": 45,
    "position": 0,
    "text": "برآسود یک هفته لشکر نراند"
  },
  {
    "poem_id": 1791,
    "vorder": 46,
    "position": 1,
    "text": "ز چین مهتران را همه پیش خواند"
  },
  {
    "poem_id": 1791,
    "vorder": 47,
    "position": 0,
    "text": "برآورد میلی ز سنگ و ز گج"
  },
  {
    "poem_id": 1791,
    "vorder": 48,
    "position": 1,
    "text": "که کس را به ایران ز ترک و خلج"
  },
  {
    "poem_id": 1791,
    "vorder": 49,
    "position": 0,
    "text": "نباشد گذر جز به فرمان شاه"
  },
  {
    "poem_id": 1791,
    "vorder": 50,
    "position": 1,
    "text": "همان نیز جیحون میانجی به راه"
  },
  {
    "poem_id": 1791,
    "vorder": 51,
    "position": 0,
    "text": "به لشکر یکی مرد بد شمر نام"
  },
  {
    "poem_id": 1791,
    "vorder": 52,
    "position": 1,
    "text": "خردمند و با گوهر و رای و کام"
  },
  {
    "poem_id": 1791,
    "vorder": 53,
    "position": 0,
    "text": "مر او را به توران زمین شاه کرد"
  },
  {
    "poem_id": 1791,
    "vorder": 54,
    "position": 1,
    "text": "سر تخت او افسر ماه کرد"
  },
  {
    "poem_id": 1791,
    "vorder": 55,
    "position": 0,
    "text": "همان تاج زرینش بر سر نهاد"
  },
  {
    "poem_id": 1791,
    "vorder": 56,
    "position": 1,
    "text": "همه شهر توران بدو گشت شاد"
  }
]