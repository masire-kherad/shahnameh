[
  {
    "poem_id": 1668,
    "vorder": 1,
    "position": 0,
    "text": "همی رفت منزل به منزل به راه"
  },
  {
    "poem_id": 1668,
    "vorder": 2,
    "position": 1,
    "text": "ز ره رنجه و مانده یکسر سپاه"
  },
  {
    "poem_id": 1668,
    "vorder": 3,
    "position": 0,
    "text": "ز شهر برهمن به جایی رسید"
  },
  {
    "poem_id": 1668,
    "vorder": 4,
    "position": 1,
    "text": "یکی بی‌کران ژرف دریا بدید"
  },
  {
    "poem_id": 1668,
    "vorder": 5,
    "position": 0,
    "text": "بسان زنان مرد پوشیده روی"
  },
  {
    "poem_id": 1668,
    "vorder": 6,
    "position": 1,
    "text": "همی رفت با جامه و رنگ و بوی"
  },
  {
    "poem_id": 1668,
    "vorder": 7,
    "position": 0,
    "text": "زبانها نه تازی و نه خسروی"
  },
  {
    "poem_id": 1668,
    "vorder": 8,
    "position": 1,
    "text": "نه ترکی نه چینی و نه پهلوی"
  },
  {
    "poem_id": 1668,
    "vorder": 9,
    "position": 0,
    "text": "ز ماهی بدیشان همی خوردنی"
  },
  {
    "poem_id": 1668,
    "vorder": 10,
    "position": 1,
    "text": "به جایی نبد راه آوردنی"
  },
  {
    "poem_id": 1668,
    "vorder": 11,
    "position": 0,
    "text": "شگفت اندر ایشان سکندر بماند"
  },
  {
    "poem_id": 1668,
    "vorder": 12,
    "position": 1,
    "text": "ز دریا همی نام یزدان بخواند"
  },
  {
    "poem_id": 1668,
    "vorder": 13,
    "position": 0,
    "text": "هم‌انگاه کوهی برآمد ز آب"
  },
  {
    "poem_id": 1668,
    "vorder": 14,
    "position": 1,
    "text": "بدو پاره شد زرد چون آفتاب"
  },
  {
    "poem_id": 1668,
    "vorder": 15,
    "position": 0,
    "text": "سکندر یکی تیز کشتی بجست"
  },
  {
    "poem_id": 1668,
    "vorder": 16,
    "position": 1,
    "text": "که آن را ببیند به دیده درست"
  },
  {
    "poem_id": 1668,
    "vorder": 17,
    "position": 0,
    "text": "یکی گفت زان فیلسوفان به شاه"
  },
  {
    "poem_id": 1668,
    "vorder": 18,
    "position": 1,
    "text": "که بر ژرف دریا ترا نیست راه"
  },
  {
    "poem_id": 1668,
    "vorder": 19,
    "position": 0,
    "text": "بمان تا ببیند مر او را کسی"
  },
  {
    "poem_id": 1668,
    "vorder": 20,
    "position": 1,
    "text": "که بهره ندارد ز دانش بسی"
  },
  {
    "poem_id": 1668,
    "vorder": 21,
    "position": 0,
    "text": "ز رومی و از مردم پارسی"
  },
  {
    "poem_id": 1668,
    "vorder": 22,
    "position": 1,
    "text": "بدان کشتی اندر نشستند سی"
  },
  {
    "poem_id": 1668,
    "vorder": 23,
    "position": 0,
    "text": "یکی زرد ماهی بد آن لخت کوه"
  },
  {
    "poem_id": 1668,
    "vorder": 24,
    "position": 1,
    "text": "هم‌انگه چو تنگ اندر آمد گروه"
  },
  {
    "poem_id": 1668,
    "vorder": 25,
    "position": 0,
    "text": "فروبرد کشتی هم اندر شتاب"
  },
  {
    "poem_id": 1668,
    "vorder": 26,
    "position": 1,
    "text": "هم آن کوه شد ناپدید اندر آب"
  },
  {
    "poem_id": 1668,
    "vorder": 27,
    "position": 0,
    "text": "سپاه سکندر همی خیره ماند"
  },
  {
    "poem_id": 1668,
    "vorder": 28,
    "position": 1,
    "text": "همی هرکسی نام یزدان بخواند"
  },
  {
    "poem_id": 1668,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت رومی که دانش بهست"
  },
  {
    "poem_id": 1668,
    "vorder": 30,
    "position": 1,
    "text": "که داننده بر هر کسی بر مهست"
  },
  {
    "poem_id": 1668,
    "vorder": 31,
    "position": 0,
    "text": "اگر شاه رفتی و گشتی تباه"
  },
  {
    "poem_id": 1668,
    "vorder": 32,
    "position": 1,
    "text": "پر از خون شدی جان چندین سپاه"
  },
  {
    "poem_id": 1668,
    "vorder": 33,
    "position": 0,
    "text": "وزان جایگه لشکر اندر کشید"
  },
  {
    "poem_id": 1668,
    "vorder": 34,
    "position": 1,
    "text": "یکی آبگیری نو آمد پدید"
  },
  {
    "poem_id": 1668,
    "vorder": 35,
    "position": 0,
    "text": "به گرد اندرش نی بسان درخت"
  },
  {
    "poem_id": 1668,
    "vorder": 36,
    "position": 1,
    "text": "تو گفتی که چوب چنارست سخت"
  },
  {
    "poem_id": 1668,
    "vorder": 37,
    "position": 0,
    "text": "ز پنجه فزون بود بالای اوی"
  },
  {
    "poem_id": 1668,
    "vorder": 38,
    "position": 1,
    "text": "چهل رش بپیمود پهنای اوی"
  },
  {
    "poem_id": 1668,
    "vorder": 39,
    "position": 0,
    "text": "همه خانه‌ها کرده از چوب و نی"
  },
  {
    "poem_id": 1668,
    "vorder": 40,
    "position": 1,
    "text": "زمینش هم از نی فروبرده پی"
  },
  {
    "poem_id": 1668,
    "vorder": 41,
    "position": 0,
    "text": "نشایست بد در نیستان بسی"
  },
  {
    "poem_id": 1668,
    "vorder": 42,
    "position": 1,
    "text": "ز شوری نخورد آب او هرکسی"
  },
  {
    "poem_id": 1668,
    "vorder": 43,
    "position": 0,
    "text": "چو بگذشت زان آب جایی رسید"
  },
  {
    "poem_id": 1668,
    "vorder": 44,
    "position": 1,
    "text": "که آمد یکی ژرف دریا پدید"
  },
  {
    "poem_id": 1668,
    "vorder": 45,
    "position": 0,
    "text": "جهان خرم و آب چون انگبین"
  },
  {
    "poem_id": 1668,
    "vorder": 46,
    "position": 1,
    "text": "همی مشک بویید روی زمین"
  },
  {
    "poem_id": 1668,
    "vorder": 47,
    "position": 0,
    "text": "بخوردند و کردند آهنگ خواب"
  },
  {
    "poem_id": 1668,
    "vorder": 48,
    "position": 1,
    "text": "بسی مار پیچان برآمد ز آب"
  },
  {
    "poem_id": 1668,
    "vorder": 49,
    "position": 0,
    "text": "وزان بیشه گزدم چو آتش به رنگ"
  },
  {
    "poem_id": 1668,
    "vorder": 50,
    "position": 1,
    "text": "جهان شد بران خفتگان تار و تنگ"
  },
  {
    "poem_id": 1668,
    "vorder": 51,
    "position": 0,
    "text": "به هر گوشه‌ای در فراوان بمرد"
  },
  {
    "poem_id": 1668,
    "vorder": 52,
    "position": 1,
    "text": "بزرگان دانا و مردان گرد"
  },
  {
    "poem_id": 1668,
    "vorder": 53,
    "position": 0,
    "text": "ز یک سو فراوان بیامد گراز"
  },
  {
    "poem_id": 1668,
    "vorder": 54,
    "position": 1,
    "text": "چو الماس دندانهای دراز"
  },
  {
    "poem_id": 1668,
    "vorder": 55,
    "position": 0,
    "text": "ز دست دگر شیر مهتر ز گاو"
  },
  {
    "poem_id": 1668,
    "vorder": 56,
    "position": 1,
    "text": "که با جنگ ایشان نبد زور و تاو"
  },
  {
    "poem_id": 1668,
    "vorder": 57,
    "position": 0,
    "text": "سپاهش ز دریا بیکسو شدند"
  },
  {
    "poem_id": 1668,
    "vorder": 58,
    "position": 1,
    "text": "بران نیستان آتش اندر زدند"
  },
  {
    "poem_id": 1668,
    "vorder": 59,
    "position": 0,
    "text": "بکشتند چندان ز شیران که راه"
  },
  {
    "poem_id": 1668,
    "vorder": 60,
    "position": 1,
    "text": "به یکبارگی تنگ شد بر سپاه"
  }
]