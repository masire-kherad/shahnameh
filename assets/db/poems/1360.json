[
  {
    "poem_id": 1360,
    "vorder": 1,
    "position": 0,
    "text": "فرستادهٔ شاه را پیش خواند"
  },
  {
    "poem_id": 1360,
    "vorder": 2,
    "position": 1,
    "text": "فراوان سخن را به خوبی براند"
  },
  {
    "poem_id": 1360,
    "vorder": 3,
    "position": 0,
    "text": "که من شهریار ترا کهترم"
  },
  {
    "poem_id": 1360,
    "vorder": 4,
    "position": 1,
    "text": "به هرچ او بفرمود فرمانبرم"
  },
  {
    "poem_id": 1360,
    "vorder": 5,
    "position": 0,
    "text": "بگویش که گرچه تو هستی بلند"
  },
  {
    "poem_id": 1360,
    "vorder": 6,
    "position": 1,
    "text": "سه فرزند تو برتو بر ارجمند"
  },
  {
    "poem_id": 1360,
    "vorder": 7,
    "position": 0,
    "text": "پسر خود گرامی بود شاه را"
  },
  {
    "poem_id": 1360,
    "vorder": 8,
    "position": 1,
    "text": "بویژه که زیبا بود گاه را"
  },
  {
    "poem_id": 1360,
    "vorder": 9,
    "position": 0,
    "text": "سخن هر چه گفتی پذیرم همی"
  },
  {
    "poem_id": 1360,
    "vorder": 10,
    "position": 1,
    "text": "ز دختر من اندازه گیرم همی"
  },
  {
    "poem_id": 1360,
    "vorder": 11,
    "position": 0,
    "text": "اگر پادشا دیده خواهد ز من"
  },
  {
    "poem_id": 1360,
    "vorder": 12,
    "position": 1,
    "text": "و گر دشت گردان و تخت یمن"
  },
  {
    "poem_id": 1360,
    "vorder": 13,
    "position": 0,
    "text": "مرا خوارتر چون سه فرزند خویش"
  },
  {
    "poem_id": 1360,
    "vorder": 14,
    "position": 1,
    "text": "نبینم به هنگام بایست پیش"
  },
  {
    "poem_id": 1360,
    "vorder": 15,
    "position": 0,
    "text": "پس ار شاه را این چنین است کام"
  },
  {
    "poem_id": 1360,
    "vorder": 16,
    "position": 1,
    "text": "نشاید زدن جز به فرمانش گام"
  },
  {
    "poem_id": 1360,
    "vorder": 17,
    "position": 0,
    "text": "به فرمان شاه این سه فرزند من"
  },
  {
    "poem_id": 1360,
    "vorder": 18,
    "position": 1,
    "text": "برون آنگه آید ز پیوند من"
  },
  {
    "poem_id": 1360,
    "vorder": 19,
    "position": 0,
    "text": "کجا من ببینم سه شاه ترا"
  },
  {
    "poem_id": 1360,
    "vorder": 20,
    "position": 1,
    "text": "فروزندهٔ تاج و گاه ترا"
  },
  {
    "poem_id": 1360,
    "vorder": 21,
    "position": 0,
    "text": "بیایند هر سه به نزدیک من"
  },
  {
    "poem_id": 1360,
    "vorder": 22,
    "position": 1,
    "text": "شود روشن این شهر تاریک من"
  },
  {
    "poem_id": 1360,
    "vorder": 23,
    "position": 0,
    "text": "شود شادمان دل به دیدارشان"
  },
  {
    "poem_id": 1360,
    "vorder": 24,
    "position": 1,
    "text": "ببینم روانهای بیدارشان"
  },
  {
    "poem_id": 1360,
    "vorder": 25,
    "position": 0,
    "text": "ببینم کشان دل پر از داد هست"
  },
  {
    "poem_id": 1360,
    "vorder": 26,
    "position": 1,
    "text": "به زنهارشان دست گیرم به دست"
  },
  {
    "poem_id": 1360,
    "vorder": 27,
    "position": 0,
    "text": "پس آنگه سه روشن جهان‌بین خویش"
  },
  {
    "poem_id": 1360,
    "vorder": 28,
    "position": 1,
    "text": "سپارم بدیشان بر آیین خویش"
  },
  {
    "poem_id": 1360,
    "vorder": 29,
    "position": 0,
    "text": "چو آید بدیدار ایشان نیاز"
  },
  {
    "poem_id": 1360,
    "vorder": 30,
    "position": 1,
    "text": "فرستم سبکشان سوی شاه باز"
  },
  {
    "poem_id": 1360,
    "vorder": 31,
    "position": 0,
    "text": "سراینده جندل چو پاسخ شنید"
  },
  {
    "poem_id": 1360,
    "vorder": 32,
    "position": 1,
    "text": "ببوسید تختش چنان چون سزید"
  },
  {
    "poem_id": 1360,
    "vorder": 33,
    "position": 0,
    "text": "پر از آفرین لب ز ایوان اوی"
  },
  {
    "poem_id": 1360,
    "vorder": 34,
    "position": 1,
    "text": "سوی شهریار جهان کرد روی"
  },
  {
    "poem_id": 1360,
    "vorder": 35,
    "position": 0,
    "text": "بیامد چو نزد فریدون رسید"
  },
  {
    "poem_id": 1360,
    "vorder": 36,
    "position": 1,
    "text": "بگفت آن کجا گفت و پاسخ شنید"
  },
  {
    "poem_id": 1360,
    "vorder": 37,
    "position": 0,
    "text": "سه فرزند را خواند شاه جهان"
  },
  {
    "poem_id": 1360,
    "vorder": 38,
    "position": 1,
    "text": "نهفته برون آورید از نهان"
  },
  {
    "poem_id": 1360,
    "vorder": 39,
    "position": 0,
    "text": "از آن رفتن جندل و رای خویش"
  },
  {
    "poem_id": 1360,
    "vorder": 40,
    "position": 1,
    "text": "سخنها همه پاک بنهاد پیش"
  },
  {
    "poem_id": 1360,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت کاین شهریار یمن"
  },
  {
    "poem_id": 1360,
    "vorder": 42,
    "position": 1,
    "text": "سر انجمن سرو سایه فکن"
  },
  {
    "poem_id": 1360,
    "vorder": 43,
    "position": 0,
    "text": "چو ناسفته گوهر سه دخترش بود"
  },
  {
    "poem_id": 1360,
    "vorder": 44,
    "position": 1,
    "text": "نبودش پسر دختر افسرش بود"
  },
  {
    "poem_id": 1360,
    "vorder": 45,
    "position": 0,
    "text": "سروش ار بیابد چو ایشان عروس"
  },
  {
    "poem_id": 1360,
    "vorder": 46,
    "position": 1,
    "text": "دهد پیش هر یک مگر خاک‌بوس"
  },
  {
    "poem_id": 1360,
    "vorder": 47,
    "position": 0,
    "text": "ز بهر شما از پدر خواستم"
  },
  {
    "poem_id": 1360,
    "vorder": 48,
    "position": 1,
    "text": "سخنهای بایسته آراستم"
  },
  {
    "poem_id": 1360,
    "vorder": 49,
    "position": 0,
    "text": "کنون تان بباید بر او شدن"
  },
  {
    "poem_id": 1360,
    "vorder": 50,
    "position": 1,
    "text": "به هر بیش و کم رای فرخ زدن"
  },
  {
    "poem_id": 1360,
    "vorder": 51,
    "position": 0,
    "text": "سراینده باشید و بسیارهوش"
  },
  {
    "poem_id": 1360,
    "vorder": 52,
    "position": 1,
    "text": "به گفتار او برنهاده دوگوش"
  },
  {
    "poem_id": 1360,
    "vorder": 53,
    "position": 0,
    "text": "به خوبی سخنهاش پاسخ دهید"
  },
  {
    "poem_id": 1360,
    "vorder": 54,
    "position": 1,
    "text": "چو پرسد سخن رای فرخ نهید"
  },
  {
    "poem_id": 1360,
    "vorder": 55,
    "position": 0,
    "text": "ازیرا که پروردهٔ پادشا"
  },
  {
    "poem_id": 1360,
    "vorder": 56,
    "position": 1,
    "text": "نباید که باشد به جز پارسا"
  },
  {
    "poem_id": 1360,
    "vorder": 57,
    "position": 0,
    "text": "سخن‌گوی و روشن دل و پاک‌دین"
  },
  {
    "poem_id": 1360,
    "vorder": 58,
    "position": 1,
    "text": "به کاری که پیش آیدش پیش‌بین"
  },
  {
    "poem_id": 1360,
    "vorder": 59,
    "position": 0,
    "text": "زبان راستی را بیاراسته"
  },
  {
    "poem_id": 1360,
    "vorder": 60,
    "position": 1,
    "text": "خرد خیره کرده ابر خواسته"
  },
  {
    "poem_id": 1360,
    "vorder": 61,
    "position": 0,
    "text": "شما هر چه گویم ز من بشنوید"
  },
  {
    "poem_id": 1360,
    "vorder": 62,
    "position": 1,
    "text": "اگر کار بندید خرم بوید"
  },
  {
    "poem_id": 1360,
    "vorder": 63,
    "position": 0,
    "text": "یکی ژرف‌بین است شاه یمن"
  },
  {
    "poem_id": 1360,
    "vorder": 64,
    "position": 1,
    "text": "که چون او نباشد به هرانجمن"
  },
  {
    "poem_id": 1360,
    "vorder": 65,
    "position": 0,
    "text": "گرانمایه و پاک هرسه پسر"
  },
  {
    "poem_id": 1360,
    "vorder": 66,
    "position": 1,
    "text": "همه دل‌نهاده به گفت پدر"
  },
  {
    "poem_id": 1360,
    "vorder": 67,
    "position": 0,
    "text": "ز پیش فریدون برون آمدند"
  },
  {
    "poem_id": 1360,
    "vorder": 68,
    "position": 1,
    "text": "پر از دانش و پرفسون آمدند"
  },
  {
    "poem_id": 1360,
    "vorder": 69,
    "position": 0,
    "text": "بجز رای و دانش چه اندرخورد"
  },
  {
    "poem_id": 1360,
    "vorder": 70,
    "position": 1,
    "text": "پسر را که چونان پدر پرورد"
  }
]