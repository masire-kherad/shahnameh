[
  {
    "poem_id": 1842,
    "vorder": 1,
    "position": 0,
    "text": "وزان روی شد شهریار جوان"
  },
  {
    "poem_id": 1842,
    "vorder": 2,
    "position": 1,
    "text": "چوبگذشت شاد از پل نهروان"
  },
  {
    "poem_id": 1842,
    "vorder": 3,
    "position": 0,
    "text": "همه مهتران را زلشکر بخواند"
  },
  {
    "poem_id": 1842,
    "vorder": 4,
    "position": 1,
    "text": "سزاوار بر تخت شاهی نشاند"
  },
  {
    "poem_id": 1842,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کای نیکدل سروران"
  },
  {
    "poem_id": 1842,
    "vorder": 6,
    "position": 1,
    "text": "جهاندیده و کار کرده سران"
  },
  {
    "poem_id": 1842,
    "vorder": 7,
    "position": 0,
    "text": "بشاهی مرا این نخستین سرست"
  },
  {
    "poem_id": 1842,
    "vorder": 8,
    "position": 1,
    "text": "جز از آزمایش نه اندرخورست"
  },
  {
    "poem_id": 1842,
    "vorder": 9,
    "position": 0,
    "text": "بجای کسی نیست ما را سپاس"
  },
  {
    "poem_id": 1842,
    "vorder": 10,
    "position": 1,
    "text": "وگر چند هستیم نیکی شناس"
  },
  {
    "poem_id": 1842,
    "vorder": 11,
    "position": 0,
    "text": "شمارا زما هیچ نیکی نبود"
  },
  {
    "poem_id": 1842,
    "vorder": 12,
    "position": 1,
    "text": "که چندین غم ورنج باید فزود"
  },
  {
    "poem_id": 1842,
    "vorder": 13,
    "position": 0,
    "text": "نیاکان ما را پرستیده‌اید"
  },
  {
    "poem_id": 1842,
    "vorder": 14,
    "position": 1,
    "text": "بسی شور و تلخ جهان دیده‌اید"
  },
  {
    "poem_id": 1842,
    "vorder": 15,
    "position": 0,
    "text": "بخواهم گشادن یکی راز خویش"
  },
  {
    "poem_id": 1842,
    "vorder": 16,
    "position": 1,
    "text": "نهان دارم از لشکر آواز خویش"
  },
  {
    "poem_id": 1842,
    "vorder": 17,
    "position": 0,
    "text": "سخن گفتن من بایرانیان"
  },
  {
    "poem_id": 1842,
    "vorder": 18,
    "position": 1,
    "text": "نباید که بیرون برند ازمیان"
  },
  {
    "poem_id": 1842,
    "vorder": 19,
    "position": 0,
    "text": "کزین گفتن اندیشه من تباه"
  },
  {
    "poem_id": 1842,
    "vorder": 20,
    "position": 1,
    "text": "شود چون بگویند پیش سپاه"
  },
  {
    "poem_id": 1842,
    "vorder": 21,
    "position": 0,
    "text": "من امشب سگالیده‌ام تاختن"
  },
  {
    "poem_id": 1842,
    "vorder": 22,
    "position": 1,
    "text": "سپه را به جنگ اندر انداختند"
  },
  {
    "poem_id": 1842,
    "vorder": 23,
    "position": 0,
    "text": "که بهرام را دیده‌ام در سخن"
  },
  {
    "poem_id": 1842,
    "vorder": 24,
    "position": 1,
    "text": "سواریست اسپ افگن وکارکن"
  },
  {
    "poem_id": 1842,
    "vorder": 25,
    "position": 0,
    "text": "همی کودکی بی‌خرد داندم"
  },
  {
    "poem_id": 1842,
    "vorder": 26,
    "position": 1,
    "text": "بگرز و بشمشیر ترساندم"
  },
  {
    "poem_id": 1842,
    "vorder": 27,
    "position": 0,
    "text": "نداند که من شب شبیخون کنم"
  },
  {
    "poem_id": 1842,
    "vorder": 28,
    "position": 1,
    "text": "برزم اندرون بیم بیرون کنم"
  },
  {
    "poem_id": 1842,
    "vorder": 29,
    "position": 0,
    "text": "اگریار باشید بامن به جنگ"
  },
  {
    "poem_id": 1842,
    "vorder": 30,
    "position": 1,
    "text": "چو شب تیره گردد نسازم درنگ"
  },
  {
    "poem_id": 1842,
    "vorder": 31,
    "position": 0,
    "text": "چو شوید بعنبر شب تیره روی"
  },
  {
    "poem_id": 1842,
    "vorder": 32,
    "position": 1,
    "text": "بیفشاند این گیسوی مشکبوی"
  },
  {
    "poem_id": 1842,
    "vorder": 33,
    "position": 0,
    "text": "شما برنشینید با ساز جنگ"
  },
  {
    "poem_id": 1842,
    "vorder": 34,
    "position": 1,
    "text": "همه گرز و خنجر گرفته بچنگ"
  },
  {
    "poem_id": 1842,
    "vorder": 35,
    "position": 0,
    "text": "بران برنهادند یکسر سپاه"
  },
  {
    "poem_id": 1842,
    "vorder": 36,
    "position": 1,
    "text": "که یک تن نگردد زفرمان شاه"
  },
  {
    "poem_id": 1842,
    "vorder": 37,
    "position": 0,
    "text": "چو خسرو بیامد بپرده سرای"
  },
  {
    "poem_id": 1842,
    "vorder": 38,
    "position": 1,
    "text": "زبیگانه مردم بپردخت جای"
  },
  {
    "poem_id": 1842,
    "vorder": 39,
    "position": 0,
    "text": "بیاورد گستهم وبندوی را"
  },
  {
    "poem_id": 1842,
    "vorder": 40,
    "position": 1,
    "text": "جهاندیده و گرد گردوی را"
  },
  {
    "poem_id": 1842,
    "vorder": 41,
    "position": 0,
    "text": "همه کارزار شبیخون بگفت"
  },
  {
    "poem_id": 1842,
    "vorder": 42,
    "position": 1,
    "text": "که با او مگر یار باشند و جفت"
  },
  {
    "poem_id": 1842,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت گستهم کای شهریار"
  },
  {
    "poem_id": 1842,
    "vorder": 44,
    "position": 1,
    "text": "چرایی چنین ایمن از روزگار"
  },
  {
    "poem_id": 1842,
    "vorder": 45,
    "position": 0,
    "text": "تو با لشکر اکنون شبیخون کنی"
  },
  {
    "poem_id": 1842,
    "vorder": 46,
    "position": 1,
    "text": "ز دلها مگر مهر بیرون کنی"
  },
  {
    "poem_id": 1842,
    "vorder": 47,
    "position": 0,
    "text": "سپاه تو با لشکر دشمنند"
  },
  {
    "poem_id": 1842,
    "vorder": 48,
    "position": 1,
    "text": "ابا او همه یک دل ویک تنند"
  },
  {
    "poem_id": 1842,
    "vorder": 49,
    "position": 0,
    "text": "ز یک سو نبیره ز یک سو نیا"
  },
  {
    "poem_id": 1842,
    "vorder": 50,
    "position": 1,
    "text": "به مغز اندرون کی بود کیمیا"
  },
  {
    "poem_id": 1842,
    "vorder": 51,
    "position": 0,
    "text": "ازین سو برادر وزان سو پدر"
  },
  {
    "poem_id": 1842,
    "vorder": 52,
    "position": 1,
    "text": "همه پاک بسته یک اندر دگر"
  },
  {
    "poem_id": 1842,
    "vorder": 53,
    "position": 0,
    "text": "پدر چون کند با پسر کارزار"
  },
  {
    "poem_id": 1842,
    "vorder": 54,
    "position": 1,
    "text": "بدین آروز کام دشمن مخار"
  },
  {
    "poem_id": 1842,
    "vorder": 55,
    "position": 0,
    "text": "نبایست گفت این سخن با سپاه"
  },
  {
    "poem_id": 1842,
    "vorder": 56,
    "position": 1,
    "text": "چو گفتی کنون کار گردد تباه"
  },
  {
    "poem_id": 1842,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت گردوی کاین خود گذشت"
  },
  {
    "poem_id": 1842,
    "vorder": 58,
    "position": 1,
    "text": "گذشته همه باد گردد به دشت"
  },
  {
    "poem_id": 1842,
    "vorder": 59,
    "position": 0,
    "text": "توانایی و کام وگنج وسپاه"
  },
  {
    "poem_id": 1842,
    "vorder": 60,
    "position": 1,
    "text": "سر مرد بینا نپیچد ز راه"
  },
  {
    "poem_id": 1842,
    "vorder": 61,
    "position": 0,
    "text": "بدین رزمگه امشب اندر مباش"
  },
  {
    "poem_id": 1842,
    "vorder": 62,
    "position": 1,
    "text": "ممان تا شود گنج و لشکر به لاش"
  },
  {
    "poem_id": 1842,
    "vorder": 63,
    "position": 0,
    "text": "که من بی‌گمانم کزین راز ما"
  },
  {
    "poem_id": 1842,
    "vorder": 64,
    "position": 1,
    "text": "وزین ساختن در نهان سازما"
  },
  {
    "poem_id": 1842,
    "vorder": 65,
    "position": 0,
    "text": "بدان لشکر اکنون رسید آگهی"
  },
  {
    "poem_id": 1842,
    "vorder": 66,
    "position": 1,
    "text": "نباید که تو سر بدشمن دهی"
  },
  {
    "poem_id": 1842,
    "vorder": 67,
    "position": 0,
    "text": "چوبشنید خسرو پسند آمدش"
  },
  {
    "poem_id": 1842,
    "vorder": 68,
    "position": 1,
    "text": "به دل رای او سودمند آمدش"
  },
  {
    "poem_id": 1842,
    "vorder": 69,
    "position": 0,
    "text": "گزین کرد زان سرکشان مرد چند"
  },
  {
    "poem_id": 1842,
    "vorder": 70,
    "position": 1,
    "text": "که باشند برنیک وبد یارمند"
  },
  {
    "poem_id": 1842,
    "vorder": 71,
    "position": 0,
    "text": "چو خرداد برزین و گستهم شیر"
  },
  {
    "poem_id": 1842,
    "vorder": 72,
    "position": 1,
    "text": "چوشاپور و چون اندیان دلیر"
  },
  {
    "poem_id": 1842,
    "vorder": 73,
    "position": 0,
    "text": "چو بندوی خراد لشکر فروز"
  },
  {
    "poem_id": 1842,
    "vorder": 74,
    "position": 1,
    "text": "چو نستود لشکرکش نیوسوز"
  },
  {
    "poem_id": 1842,
    "vorder": 75,
    "position": 0,
    "text": "تلی بود پر سبزه وجای سور"
  },
  {
    "poem_id": 1842,
    "vorder": 76,
    "position": 1,
    "text": "سپه را همی‌دید خسرو ز دور"
  }
]