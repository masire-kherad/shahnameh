[
  {
    "poem_id": 88076,
    "vorder": 1,
    "position": 0,
    "text": "وز آن پس برآمد ز لشکر خروش"
  },
  {
    "poem_id": 88076,
    "vorder": 2,
    "position": 1,
    "text": "زمین و زمان شد پر از جنگ و جوش"
  },
  {
    "poem_id": 88076,
    "vorder": 3,
    "position": 0,
    "text": "ستاره پدید آمد از تیره گرد"
  },
  {
    "poem_id": 88076,
    "vorder": 4,
    "position": 1,
    "text": "رخ زرد خورشید شد لاژورد"
  },
  {
    "poem_id": 88076,
    "vorder": 5,
    "position": 0,
    "text": "سپهدار ترکان از آن انجمن"
  },
  {
    "poem_id": 88076,
    "vorder": 6,
    "position": 1,
    "text": "گزین کرد کار آزموده دو تن"
  },
  {
    "poem_id": 88076,
    "vorder": 7,
    "position": 0,
    "text": "پیامی فرستاد نزدیک شاه"
  },
  {
    "poem_id": 88076,
    "vorder": 8,
    "position": 1,
    "text": "که کردی فراوان پس پشت راه"
  },
  {
    "poem_id": 88076,
    "vorder": 9,
    "position": 0,
    "text": "همانا که فرسنگ ز ایران هزار"
  },
  {
    "poem_id": 88076,
    "vorder": 10,
    "position": 1,
    "text": "بود تا به گنگ اندر ای شهریار"
  },
  {
    "poem_id": 88076,
    "vorder": 11,
    "position": 0,
    "text": "ز ریگ و بیابان وز کوه و شخ"
  },
  {
    "poem_id": 88076,
    "vorder": 12,
    "position": 1,
    "text": "دو لشکر بر این سان چو مور و ملخ"
  },
  {
    "poem_id": 88076,
    "vorder": 13,
    "position": 0,
    "text": "زمین همچو دریا شد از خون کین"
  },
  {
    "poem_id": 88076,
    "vorder": 14,
    "position": 1,
    "text": "ز گنگ و ز چین تا به ایران زمین"
  },
  {
    "poem_id": 88076,
    "vorder": 15,
    "position": 0,
    "text": "اگر خون آن کشتگان را ز خاک"
  },
  {
    "poem_id": 88076,
    "vorder": 16,
    "position": 1,
    "text": "به ژرفی برد رای یزدان پاک"
  },
  {
    "poem_id": 88076,
    "vorder": 17,
    "position": 0,
    "text": "همانا چو دریای قلزم شود"
  },
  {
    "poem_id": 88076,
    "vorder": 18,
    "position": 1,
    "text": "دو لشکر به خون اندرون گم شود"
  },
  {
    "poem_id": 88076,
    "vorder": 19,
    "position": 0,
    "text": "اگر گنج خواهی ز من گر سپاه"
  },
  {
    "poem_id": 88076,
    "vorder": 20,
    "position": 1,
    "text": "وگر بوم ترکان و تخت و کلاه"
  },
  {
    "poem_id": 88076,
    "vorder": 21,
    "position": 0,
    "text": "سپارم ترا من شوم ناپدید"
  },
  {
    "poem_id": 88076,
    "vorder": 22,
    "position": 1,
    "text": "جز از تیغ جان را ندارم کلید"
  },
  {
    "poem_id": 88076,
    "vorder": 23,
    "position": 0,
    "text": "مکن گر ترا من پدر مادرم"
  },
  {
    "poem_id": 88076,
    "vorder": 24,
    "position": 1,
    "text": "ز تخم فریدون افسونگرم"
  },
  {
    "poem_id": 88076,
    "vorder": 25,
    "position": 0,
    "text": "ز کین پدر گر دلت خیره شد"
  },
  {
    "poem_id": 88076,
    "vorder": 26,
    "position": 1,
    "text": "چنین آب من پیش تو تیره شد"
  },
  {
    "poem_id": 88076,
    "vorder": 27,
    "position": 0,
    "text": "از آن بد سیاوش گنهکار بود"
  },
  {
    "poem_id": 88076,
    "vorder": 28,
    "position": 1,
    "text": "مرا دل پر از درد و تیمار بود"
  },
  {
    "poem_id": 88076,
    "vorder": 29,
    "position": 0,
    "text": "دگر گردش اختران بلند"
  },
  {
    "poem_id": 88076,
    "vorder": 30,
    "position": 1,
    "text": "که هم با پناهند و هم با گزند"
  },
  {
    "poem_id": 88076,
    "vorder": 31,
    "position": 0,
    "text": "مرا سالیان شست بر سر گذشت"
  },
  {
    "poem_id": 88076,
    "vorder": 32,
    "position": 1,
    "text": "که با نامداری نرفتم به دشت"
  },
  {
    "poem_id": 88076,
    "vorder": 33,
    "position": 0,
    "text": "تو فرزندی و شاه ایران توی"
  },
  {
    "poem_id": 88076,
    "vorder": 34,
    "position": 1,
    "text": "به رزم اندرون چنگ شیران توی"
  },
  {
    "poem_id": 88076,
    "vorder": 35,
    "position": 0,
    "text": "یکی رزمگاهی گزین دوردست"
  },
  {
    "poem_id": 88076,
    "vorder": 36,
    "position": 1,
    "text": "نه بر دامن مرد خسروپرست"
  },
  {
    "poem_id": 88076,
    "vorder": 37,
    "position": 0,
    "text": "بگردیم هر دو به آوردگاه"
  },
  {
    "poem_id": 88076,
    "vorder": 38,
    "position": 1,
    "text": "به جایی کز او دور ماند سپاه"
  },
  {
    "poem_id": 88076,
    "vorder": 39,
    "position": 0,
    "text": "اگر من شوم کشته بر دست تو"
  },
  {
    "poem_id": 88076,
    "vorder": 40,
    "position": 1,
    "text": "ز دریا نهنگ آورد شست تو"
  },
  {
    "poem_id": 88076,
    "vorder": 41,
    "position": 0,
    "text": "تو با خویش و پیوند مادر مکوش"
  },
  {
    "poem_id": 88076,
    "vorder": 42,
    "position": 1,
    "text": "به پرهیز وز کینه چندین مجوش"
  },
  {
    "poem_id": 88076,
    "vorder": 43,
    "position": 0,
    "text": "وگر تو شوی کشته بر دست من"
  },
  {
    "poem_id": 88076,
    "vorder": 44,
    "position": 1,
    "text": "به زنهار یزدان کز آن انجمن"
  },
  {
    "poem_id": 88076,
    "vorder": 45,
    "position": 0,
    "text": "نمانم که یک تن بپیچد ز درد"
  },
  {
    "poem_id": 88076,
    "vorder": 46,
    "position": 1,
    "text": "دگر بیند از باد خاک نبرد"
  },
  {
    "poem_id": 88076,
    "vorder": 47,
    "position": 0,
    "text": "ز گوینده بشنید خسرو پیام"
  },
  {
    "poem_id": 88076,
    "vorder": 48,
    "position": 1,
    "text": "چنین گفت با پور دستان سام"
  },
  {
    "poem_id": 88076,
    "vorder": 49,
    "position": 0,
    "text": "که این ترک بدساز مردم فریب"
  },
  {
    "poem_id": 88076,
    "vorder": 50,
    "position": 1,
    "text": "نبیند همی از بلندی نشیب"
  },
  {
    "poem_id": 88076,
    "vorder": 51,
    "position": 0,
    "text": "به چاره چنین از کف ما بجست"
  },
  {
    "poem_id": 88076,
    "vorder": 52,
    "position": 1,
    "text": "نماید که بر تخت ایران نشست"
  },
  {
    "poem_id": 88076,
    "vorder": 53,
    "position": 0,
    "text": "ز آورد چندین بگوید همی"
  },
  {
    "poem_id": 88076,
    "vorder": 54,
    "position": 1,
    "text": "مگر دخمهٔ شیده جوید همی"
  },
  {
    "poem_id": 88076,
    "vorder": 55,
    "position": 0,
    "text": "نبیره فریدن و پور پشنگ"
  },
  {
    "poem_id": 88076,
    "vorder": 56,
    "position": 1,
    "text": "به آورد با او مرا نیست ننگ"
  },
  {
    "poem_id": 88076,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت رستم که ای شهریار"
  },
  {
    "poem_id": 88076,
    "vorder": 58,
    "position": 1,
    "text": "بدین در مدار آتش اندر کنار"
  },
  {
    "poem_id": 88076,
    "vorder": 59,
    "position": 0,
    "text": "که ننگست بر شاه رفتن به جنگ"
  },
  {
    "poem_id": 88076,
    "vorder": 60,
    "position": 1,
    "text": "وگر همنبرد تو باشد پشنگ"
  },
  {
    "poem_id": 88076,
    "vorder": 61,
    "position": 0,
    "text": "دگر آن که گوید که با لشکرم"
  },
  {
    "poem_id": 88076,
    "vorder": 62,
    "position": 1,
    "text": "مکن جنگ با دوده و کشورم"
  },
  {
    "poem_id": 88076,
    "vorder": 63,
    "position": 0,
    "text": "ز دریا به دریا ترا لشکرست"
  },
  {
    "poem_id": 88076,
    "vorder": 64,
    "position": 1,
    "text": "کجا رایشان ز این سخن دیگرست"
  },
  {
    "poem_id": 88076,
    "vorder": 65,
    "position": 0,
    "text": "چو پیمان یزدان کنی با نیا"
  },
  {
    "poem_id": 88076,
    "vorder": 66,
    "position": 1,
    "text": "نشاید که در دل بود کیمیا"
  },
  {
    "poem_id": 88076,
    "vorder": 67,
    "position": 0,
    "text": "به انبوه لشکر به جنگ اندر آر"
  },
  {
    "poem_id": 88076,
    "vorder": 68,
    "position": 1,
    "text": "سخن چند آلودهٔ نابکار"
  },
  {
    "poem_id": 88076,
    "vorder": 69,
    "position": 0,
    "text": "ز رستم چو بشنید خسرو سخن"
  },
  {
    "poem_id": 88076,
    "vorder": 70,
    "position": 1,
    "text": "یکی دیگر اندیشه افگند بن"
  },
  {
    "poem_id": 88076,
    "vorder": 71,
    "position": 0,
    "text": "به گوینده گفت این بداندیش مرد"
  },
  {
    "poem_id": 88076,
    "vorder": 72,
    "position": 1,
    "text": "چنین با من آویخت اندر نبرد"
  },
  {
    "poem_id": 88076,
    "vorder": 73,
    "position": 0,
    "text": "فزون کرد از این با سیاوش وفا"
  },
  {
    "poem_id": 88076,
    "vorder": 74,
    "position": 1,
    "text": "زبان پر فسون بود دل پرجفا"
  },
  {
    "poem_id": 88076,
    "vorder": 75,
    "position": 0,
    "text": "سپهبد به کژی نگیرد فروغ"
  },
  {
    "poem_id": 88076,
    "vorder": 76,
    "position": 1,
    "text": "زبان خیره پر تاب و دل پر دروغ"
  },
  {
    "poem_id": 88076,
    "vorder": 77,
    "position": 0,
    "text": "گر ایدون که رایش نبردست و بس"
  },
  {
    "poem_id": 88076,
    "vorder": 78,
    "position": 1,
    "text": "جز از من نبرد ورا هست کس"
  },
  {
    "poem_id": 88076,
    "vorder": 79,
    "position": 0,
    "text": "تهمتن به جایست و گیو دلیر"
  },
  {
    "poem_id": 88076,
    "vorder": 80,
    "position": 1,
    "text": "که پیکار جویند با پیل و شیر"
  },
  {
    "poem_id": 88076,
    "vorder": 81,
    "position": 0,
    "text": "اگر شاه با شاه جوید نبرد"
  },
  {
    "poem_id": 88076,
    "vorder": 82,
    "position": 1,
    "text": "چرا باید این دشت پر مرد کرد"
  },
  {
    "poem_id": 88076,
    "vorder": 83,
    "position": 0,
    "text": "نباشد مرا با تو ز این بیش جنگ"
  },
  {
    "poem_id": 88076,
    "vorder": 84,
    "position": 1,
    "text": "ببینی کنون روز تاریک و تنگ"
  },
  {
    "poem_id": 88076,
    "vorder": 85,
    "position": 0,
    "text": "فرستاده برگشت و آمد چو باد"
  },
  {
    "poem_id": 88076,
    "vorder": 86,
    "position": 1,
    "text": "شنیده سراسر بر او کرد یاد"
  },
  {
    "poem_id": 88076,
    "vorder": 87,
    "position": 0,
    "text": "پر از درد شد جان افراسیاب"
  },
  {
    "poem_id": 88076,
    "vorder": 88,
    "position": 1,
    "text": "نکرد ایچ بر جنگ جستن شتاب"
  },
  {
    "poem_id": 88076,
    "vorder": 89,
    "position": 0,
    "text": "سپه را به جنگ اندر آورد شاه"
  },
  {
    "poem_id": 88076,
    "vorder": 90,
    "position": 1,
    "text": "بجنبید ناچار دیگر سپاه"
  },
  {
    "poem_id": 88076,
    "vorder": 91,
    "position": 0,
    "text": "یکی با درنگ و یکی با شتاب"
  },
  {
    "poem_id": 88076,
    "vorder": 92,
    "position": 1,
    "text": "زمین شد به کردار دریای آب"
  },
  {
    "poem_id": 88076,
    "vorder": 93,
    "position": 0,
    "text": "ز باریدن تیر گفتی ز ابر"
  },
  {
    "poem_id": 88076,
    "vorder": 94,
    "position": 1,
    "text": "همی ژاله بارید بر خود و ببر"
  },
  {
    "poem_id": 88076,
    "vorder": 95,
    "position": 0,
    "text": "ز شبگیر تا گشت خورشید لعل"
  },
  {
    "poem_id": 88076,
    "vorder": 96,
    "position": 1,
    "text": "زمین پر ز خون بود در زیر نعل"
  },
  {
    "poem_id": 88076,
    "vorder": 97,
    "position": 0,
    "text": "سپه بازگشتند چون تیره گشت"
  },
  {
    "poem_id": 88076,
    "vorder": 98,
    "position": 1,
    "text": "که چشم سواران همی خیره گشت"
  },
  {
    "poem_id": 88076,
    "vorder": 99,
    "position": 0,
    "text": "سپهدار با فر و نیرنگ و ساز"
  },
  {
    "poem_id": 88076,
    "vorder": 100,
    "position": 1,
    "text": "چو آمد به لشکرگه خویش باز"
  },
  {
    "poem_id": 88076,
    "vorder": 101,
    "position": 0,
    "text": "چنین گفت با طوس کامروز جنگ"
  },
  {
    "poem_id": 88076,
    "vorder": 102,
    "position": 1,
    "text": "نه بر آرزو کرد پور پشنگ"
  },
  {
    "poem_id": 88076,
    "vorder": 103,
    "position": 0,
    "text": "گمانم که امشب شبیخون کند"
  },
  {
    "poem_id": 88076,
    "vorder": 104,
    "position": 1,
    "text": "ز دل درد دیرینه بیرون کند"
  },
  {
    "poem_id": 88076,
    "vorder": 105,
    "position": 0,
    "text": "یکی کنده فرمود کردن به راه"
  },
  {
    "poem_id": 88076,
    "vorder": 106,
    "position": 1,
    "text": "بر آن سو که بد شاه توران سپاه"
  },
  {
    "poem_id": 88076,
    "vorder": 107,
    "position": 0,
    "text": "چنین گفت کآتش نسوزید کس"
  },
  {
    "poem_id": 88076,
    "vorder": 108,
    "position": 1,
    "text": "نباید که آید خروش جرس"
  },
  {
    "poem_id": 88076,
    "vorder": 109,
    "position": 0,
    "text": "ز لشکر سواران که بودند گرد"
  },
  {
    "poem_id": 88076,
    "vorder": 110,
    "position": 1,
    "text": "گزین کرد شاه و به رستم سپرد"
  },
  {
    "poem_id": 88076,
    "vorder": 111,
    "position": 0,
    "text": "دگر بهره بگزید ز ایرانیان"
  },
  {
    "poem_id": 88076,
    "vorder": 112,
    "position": 1,
    "text": "که بندند بر تاختن بر میان"
  },
  {
    "poem_id": 88076,
    "vorder": 113,
    "position": 0,
    "text": "به طوس سپهدار داد آن گروه"
  },
  {
    "poem_id": 88076,
    "vorder": 114,
    "position": 1,
    "text": "بفرمود تا رفت بر سوی کوه"
  },
  {
    "poem_id": 88076,
    "vorder": 115,
    "position": 0,
    "text": "تهمتن سپه را به هامون کشید"
  },
  {
    "poem_id": 88076,
    "vorder": 116,
    "position": 1,
    "text": "سپهبد سوی کوه بیرون کشید"
  },
  {
    "poem_id": 88076,
    "vorder": 117,
    "position": 0,
    "text": "بفرمود تا دور بیرون شوند"
  },
  {
    "poem_id": 88076,
    "vorder": 118,
    "position": 1,
    "text": "چپ و راست هر دو به هامون شوند"
  },
  {
    "poem_id": 88076,
    "vorder": 119,
    "position": 0,
    "text": "طلایه مدارند و شمع و چراغ"
  },
  {
    "poem_id": 88076,
    "vorder": 120,
    "position": 1,
    "text": "یکی سوی دشت و یکی سوی راغ"
  },
  {
    "poem_id": 88076,
    "vorder": 121,
    "position": 0,
    "text": "بدان تا اگر سازد افرسیاب"
  },
  {
    "poem_id": 88076,
    "vorder": 122,
    "position": 1,
    "text": "بر او بر شبیخون به هنگام خواب"
  },
  {
    "poem_id": 88076,
    "vorder": 123,
    "position": 0,
    "text": "گر آید سپاه اندر آید ز پس"
  },
  {
    "poem_id": 88076,
    "vorder": 124,
    "position": 1,
    "text": "بماند نباشدش فریادرس"
  }
]