[
  {
    "poem_id": 1377,
    "vorder": 1,
    "position": 0,
    "text": "تهی شد ز کینه سر کینه دار"
  },
  {
    "poem_id": 1377,
    "vorder": 2,
    "position": 1,
    "text": "گریزان همی رفت سوی حصار"
  },
  {
    "poem_id": 1377,
    "vorder": 3,
    "position": 0,
    "text": "پس اندر سپاه منوچهر شاه"
  },
  {
    "poem_id": 1377,
    "vorder": 4,
    "position": 1,
    "text": "دمان و دنان برگرفتند راه"
  },
  {
    "poem_id": 1377,
    "vorder": 5,
    "position": 0,
    "text": "چو شد سلم تا پیش دریا کنار"
  },
  {
    "poem_id": 1377,
    "vorder": 6,
    "position": 1,
    "text": "ندید آنچه کشتی برآن رهگذار"
  },
  {
    "poem_id": 1377,
    "vorder": 7,
    "position": 0,
    "text": "چنان شد ز بس کشته و خسته دشت"
  },
  {
    "poem_id": 1377,
    "vorder": 8,
    "position": 1,
    "text": "که پوینده را راه دشوار گشت"
  },
  {
    "poem_id": 1377,
    "vorder": 9,
    "position": 0,
    "text": "پر از خشم و پر کینه سالار نو"
  },
  {
    "poem_id": 1377,
    "vorder": 10,
    "position": 1,
    "text": "نشست از بر چرمهٔ تیزرو"
  },
  {
    "poem_id": 1377,
    "vorder": 11,
    "position": 0,
    "text": "بیفگند برگستوان و بتاخت"
  },
  {
    "poem_id": 1377,
    "vorder": 12,
    "position": 1,
    "text": "به گرد سپه چرمه اندر نشاخت"
  },
  {
    "poem_id": 1377,
    "vorder": 13,
    "position": 0,
    "text": "رسید آنگهی تنگ در شاه روم"
  },
  {
    "poem_id": 1377,
    "vorder": 14,
    "position": 1,
    "text": "خروشید کای مرد بیداد شوم"
  },
  {
    "poem_id": 1377,
    "vorder": 15,
    "position": 0,
    "text": "بکشتی برادر ز بهر کلاه"
  },
  {
    "poem_id": 1377,
    "vorder": 16,
    "position": 1,
    "text": "کله یافتی چند پویی براه"
  },
  {
    "poem_id": 1377,
    "vorder": 17,
    "position": 0,
    "text": "کنون تاجت آوردم ای شاه و تخت"
  },
  {
    "poem_id": 1377,
    "vorder": 18,
    "position": 1,
    "text": "به بار آمد آن خسروانی درخت"
  },
  {
    "poem_id": 1377,
    "vorder": 19,
    "position": 0,
    "text": "زتاج بزرگی گریزان مشو"
  },
  {
    "poem_id": 1377,
    "vorder": 20,
    "position": 1,
    "text": "فریدونت گاهی بیاراست نو"
  },
  {
    "poem_id": 1377,
    "vorder": 21,
    "position": 0,
    "text": "درختی که پروردی آمد به بار"
  },
  {
    "poem_id": 1377,
    "vorder": 22,
    "position": 1,
    "text": "بیابی هم اکنون برش در کنار"
  },
  {
    "poem_id": 1377,
    "vorder": 23,
    "position": 0,
    "text": "اگر بار خارست خود کشته‌ای"
  },
  {
    "poem_id": 1377,
    "vorder": 24,
    "position": 1,
    "text": "و گر پرنیانست خود رشته‌ای"
  },
  {
    "poem_id": 1377,
    "vorder": 25,
    "position": 0,
    "text": "همی تاخت اسپ اندرین گفت‌گوی"
  },
  {
    "poem_id": 1377,
    "vorder": 26,
    "position": 1,
    "text": "یکایک به تنگی رسید اندر اوی"
  },
  {
    "poem_id": 1377,
    "vorder": 27,
    "position": 0,
    "text": "یکی تیغ زد زود بر گردنش"
  },
  {
    "poem_id": 1377,
    "vorder": 28,
    "position": 1,
    "text": "بدو نیمه شد خسروانی تنش"
  },
  {
    "poem_id": 1377,
    "vorder": 29,
    "position": 0,
    "text": "بفرمود تا سرش برداشتند"
  },
  {
    "poem_id": 1377,
    "vorder": 30,
    "position": 1,
    "text": "به نیزه به ابر اندر افراشتند"
  },
  {
    "poem_id": 1377,
    "vorder": 31,
    "position": 0,
    "text": "بماندند لشکر شگفت اندر اوی"
  },
  {
    "poem_id": 1377,
    "vorder": 32,
    "position": 1,
    "text": "ازان زور و آن بازوی جنگجوی"
  },
  {
    "poem_id": 1377,
    "vorder": 33,
    "position": 0,
    "text": "همه لشکر سلم همچون رمه"
  },
  {
    "poem_id": 1377,
    "vorder": 34,
    "position": 1,
    "text": "که بپراگند روزگار دمه"
  },
  {
    "poem_id": 1377,
    "vorder": 35,
    "position": 0,
    "text": "برفتند یکسر گروها گروه"
  },
  {
    "poem_id": 1377,
    "vorder": 36,
    "position": 1,
    "text": "پراگنده در دشت و دریا و کوه"
  },
  {
    "poem_id": 1377,
    "vorder": 37,
    "position": 0,
    "text": "یکی پرخرد مرد پاکیزه مغز"
  },
  {
    "poem_id": 1377,
    "vorder": 38,
    "position": 1,
    "text": "که بودش زبان پر ز گفتار نغز"
  },
  {
    "poem_id": 1377,
    "vorder": 39,
    "position": 0,
    "text": "بگفتند تا زی منوچهر شاه"
  },
  {
    "poem_id": 1377,
    "vorder": 40,
    "position": 1,
    "text": "شود  گرم و باشد زبان سپاه"
  },
  {
    "poem_id": 1377,
    "vorder": 41,
    "position": 0,
    "text": "بگوید که گفتند ما کهتریم"
  },
  {
    "poem_id": 1377,
    "vorder": 42,
    "position": 1,
    "text": "زمین جز به فرمان او نسپریم"
  },
  {
    "poem_id": 1377,
    "vorder": 43,
    "position": 0,
    "text": "گروهی خداوند بر چارپای"
  },
  {
    "poem_id": 1377,
    "vorder": 44,
    "position": 1,
    "text": "گروهی خداوند کشت و سرای"
  },
  {
    "poem_id": 1377,
    "vorder": 45,
    "position": 0,
    "text": "سپاهی بدین رزمگاه آمدیم"
  },
  {
    "poem_id": 1377,
    "vorder": 46,
    "position": 1,
    "text": "نه بر آرزو کینه خواه آمدیم"
  },
  {
    "poem_id": 1377,
    "vorder": 47,
    "position": 0,
    "text": "کنون سر به سر شاه را بنده‌ایم"
  },
  {
    "poem_id": 1377,
    "vorder": 48,
    "position": 1,
    "text": "دل و جان به مهر وی آگنده‌ایم"
  },
  {
    "poem_id": 1377,
    "vorder": 49,
    "position": 0,
    "text": "گرش رای جنگ است و خون ریختن"
  },
  {
    "poem_id": 1377,
    "vorder": 50,
    "position": 1,
    "text": "نداریم نیروی آویختن"
  },
  {
    "poem_id": 1377,
    "vorder": 51,
    "position": 0,
    "text": "سران یکسره پیش شاه آوریم"
  },
  {
    "poem_id": 1377,
    "vorder": 52,
    "position": 1,
    "text": "بر او سر بیگناه آوریم"
  },
  {
    "poem_id": 1377,
    "vorder": 53,
    "position": 0,
    "text": "براند هر آن کام کو را هواست"
  },
  {
    "poem_id": 1377,
    "vorder": 54,
    "position": 1,
    "text": "برین بیگنه جان ما پادشاست"
  },
  {
    "poem_id": 1377,
    "vorder": 55,
    "position": 0,
    "text": "بگفت این سخن مرد بسیار هوش"
  },
  {
    "poem_id": 1377,
    "vorder": 56,
    "position": 1,
    "text": "سپهدار خیره بدو دادگوش"
  },
  {
    "poem_id": 1377,
    "vorder": 57,
    "position": 0,
    "text": "چنین داد پاسخ که من کام خویش"
  },
  {
    "poem_id": 1377,
    "vorder": 58,
    "position": 1,
    "text": "به خاک افگنم برکشم نام خویش"
  },
  {
    "poem_id": 1377,
    "vorder": 59,
    "position": 0,
    "text": "هر آن چیز کان نز ره ایزدیست"
  },
  {
    "poem_id": 1377,
    "vorder": 60,
    "position": 1,
    "text": "از آهرمنی گر ز دست بدیست"
  },
  {
    "poem_id": 1377,
    "vorder": 61,
    "position": 0,
    "text": "سراسر ز دیدار من دور باد"
  },
  {
    "poem_id": 1377,
    "vorder": 62,
    "position": 1,
    "text": "بدی را تن دیو رنجور باد"
  },
  {
    "poem_id": 1377,
    "vorder": 63,
    "position": 0,
    "text": "شما گر همه کینه‌دار منید"
  },
  {
    "poem_id": 1377,
    "vorder": 64,
    "position": 1,
    "text": "وگر دوستدارید و یار منید"
  },
  {
    "poem_id": 1377,
    "vorder": 65,
    "position": 0,
    "text": "چو پیروزگر دادمان دستگاه"
  },
  {
    "poem_id": 1377,
    "vorder": 66,
    "position": 1,
    "text": "گنه کار پیدا شد از بی‌گناه"
  },
  {
    "poem_id": 1377,
    "vorder": 67,
    "position": 0,
    "text": "کنون روز دادست بیداد شد"
  },
  {
    "poem_id": 1377,
    "vorder": 68,
    "position": 1,
    "text": "سران را سر از کشتن آزاد شد"
  },
  {
    "poem_id": 1377,
    "vorder": 69,
    "position": 0,
    "text": "همه مهر جویید و افسون کنید"
  },
  {
    "poem_id": 1377,
    "vorder": 70,
    "position": 1,
    "text": "ز تن آلت جنگ بیرون کنید"
  },
  {
    "poem_id": 1377,
    "vorder": 71,
    "position": 0,
    "text": "خروشی بر آمد ز پرده سرای"
  },
  {
    "poem_id": 1377,
    "vorder": 72,
    "position": 1,
    "text": "که ای پهلوانان فرخنده رای"
  },
  {
    "poem_id": 1377,
    "vorder": 73,
    "position": 0,
    "text": "ازین پس به خیره مریزید خون"
  },
  {
    "poem_id": 1377,
    "vorder": 74,
    "position": 1,
    "text": "که بخت جفاپیشگان شد نگون"
  },
  {
    "poem_id": 1377,
    "vorder": 75,
    "position": 0,
    "text": "همه آلت لشکر و ساز جنگ"
  },
  {
    "poem_id": 1377,
    "vorder": 76,
    "position": 1,
    "text": "ببردند نزدیک پور پشنگ"
  },
  {
    "poem_id": 1377,
    "vorder": 77,
    "position": 0,
    "text": "سپهبد منوچهر بنواختشان"
  },
  {
    "poem_id": 1377,
    "vorder": 78,
    "position": 1,
    "text": "براندازه بر پایگه ساختشان"
  },
  {
    "poem_id": 1377,
    "vorder": 79,
    "position": 0,
    "text": "سوی دژ فرستاد شیروی را"
  },
  {
    "poem_id": 1377,
    "vorder": 80,
    "position": 1,
    "text": "جهاندیده مرد جهانجوی را"
  },
  {
    "poem_id": 1377,
    "vorder": 81,
    "position": 0,
    "text": "بفرمود کان خواسته برگرای"
  },
  {
    "poem_id": 1377,
    "vorder": 82,
    "position": 1,
    "text": "نگه کن همه هر چه یابی به جای"
  },
  {
    "poem_id": 1377,
    "vorder": 83,
    "position": 0,
    "text": "به پیلان گردونکش آن خواسته"
  },
  {
    "poem_id": 1377,
    "vorder": 84,
    "position": 1,
    "text": "به درگاه شاه‌آور آراسته"
  },
  {
    "poem_id": 1377,
    "vorder": 85,
    "position": 0,
    "text": "بفرمود تا کوس رویین و نای"
  },
  {
    "poem_id": 1377,
    "vorder": 86,
    "position": 1,
    "text": "زدند و فرو هشت پرده سرای"
  },
  {
    "poem_id": 1377,
    "vorder": 87,
    "position": 0,
    "text": "سپه را ز دریا به هامون کشید"
  },
  {
    "poem_id": 1377,
    "vorder": 88,
    "position": 1,
    "text": "ز هامون سوی آفریدون کشید"
  },
  {
    "poem_id": 1377,
    "vorder": 89,
    "position": 0,
    "text": "چو آمد به نزدیک تمیشه باز"
  },
  {
    "poem_id": 1377,
    "vorder": 90,
    "position": 1,
    "text": "نیا را بدیدار او بد نیاز"
  },
  {
    "poem_id": 1377,
    "vorder": 91,
    "position": 0,
    "text": "برآمد ز در نالهٔ کر نای"
  },
  {
    "poem_id": 1377,
    "vorder": 92,
    "position": 1,
    "text": "سراسر بجنبید لشکر ز جای"
  },
  {
    "poem_id": 1377,
    "vorder": 93,
    "position": 0,
    "text": "همه پشت پیلان ز پیروزه تخت"
  },
  {
    "poem_id": 1377,
    "vorder": 94,
    "position": 1,
    "text": "بیاراست سالار پیروز بخت"
  },
  {
    "poem_id": 1377,
    "vorder": 95,
    "position": 0,
    "text": "چه با مهد زرین به دیبای چین"
  },
  {
    "poem_id": 1377,
    "vorder": 96,
    "position": 1,
    "text": "بگوهر بیاراسته همچنین"
  },
  {
    "poem_id": 1377,
    "vorder": 97,
    "position": 0,
    "text": "چه با گونه گونه درفشان درفش"
  },
  {
    "poem_id": 1377,
    "vorder": 98,
    "position": 1,
    "text": "جهانی شده سرخ و زرد و بنفش"
  },
  {
    "poem_id": 1377,
    "vorder": 99,
    "position": 0,
    "text": "ز دریای گیلان چو ابر سیاه"
  },
  {
    "poem_id": 1377,
    "vorder": 100,
    "position": 1,
    "text": "دمادم بساری رسید آن سپاه"
  },
  {
    "poem_id": 1377,
    "vorder": 101,
    "position": 0,
    "text": "چو آمد بنزدیک شاه آن سپاه"
  },
  {
    "poem_id": 1377,
    "vorder": 102,
    "position": 1,
    "text": "فریدون پذیره بیامد براه"
  },
  {
    "poem_id": 1377,
    "vorder": 103,
    "position": 0,
    "text": "همه گیل مردان چو شیر یله"
  },
  {
    "poem_id": 1377,
    "vorder": 104,
    "position": 1,
    "text": "ابا طوق زرین و مشکین کله"
  },
  {
    "poem_id": 1377,
    "vorder": 105,
    "position": 0,
    "text": "پس پشت شاه اندر ایرانیان"
  },
  {
    "poem_id": 1377,
    "vorder": 106,
    "position": 1,
    "text": "دلیران و هر یک چو شیر ژیان"
  },
  {
    "poem_id": 1377,
    "vorder": 107,
    "position": 0,
    "text": "به پیش سپاه اندرون پیل و شیر"
  },
  {
    "poem_id": 1377,
    "vorder": 108,
    "position": 1,
    "text": "پس ژنده پیلان یلان دلیر"
  },
  {
    "poem_id": 1377,
    "vorder": 109,
    "position": 0,
    "text": "درفش درفشان چو آمد پدید"
  },
  {
    "poem_id": 1377,
    "vorder": 110,
    "position": 1,
    "text": "سپاه منوچهر صف بر کشید"
  },
  {
    "poem_id": 1377,
    "vorder": 111,
    "position": 0,
    "text": "پیاده شد از باره سالار نو"
  },
  {
    "poem_id": 1377,
    "vorder": 112,
    "position": 1,
    "text": "درخت نوآیین پر از بار نو"
  },
  {
    "poem_id": 1377,
    "vorder": 113,
    "position": 0,
    "text": "زمین را ببوسید و کرد آفرین"
  },
  {
    "poem_id": 1377,
    "vorder": 114,
    "position": 1,
    "text": "بران تاج و تخت و کلاه و نگین"
  },
  {
    "poem_id": 1377,
    "vorder": 115,
    "position": 0,
    "text": "فریدونش فرمود تا برنشست"
  },
  {
    "poem_id": 1377,
    "vorder": 116,
    "position": 1,
    "text": "ببوسید و بسترد رویش به دست"
  },
  {
    "poem_id": 1377,
    "vorder": 117,
    "position": 0,
    "text": "پس آنگه سوی آسمان کرد روی"
  },
  {
    "poem_id": 1377,
    "vorder": 118,
    "position": 1,
    "text": "که ای دادگر داور راست‌گوی"
  },
  {
    "poem_id": 1377,
    "vorder": 119,
    "position": 0,
    "text": "تو گفتی که من دادگر داورم"
  },
  {
    "poem_id": 1377,
    "vorder": 120,
    "position": 1,
    "text": "به سختی ستم دیده را یاورم"
  },
  {
    "poem_id": 1377,
    "vorder": 121,
    "position": 0,
    "text": "همم داد دادی و هم داوری"
  },
  {
    "poem_id": 1377,
    "vorder": 122,
    "position": 1,
    "text": "همم تاج دادی هم انگشتری"
  },
  {
    "poem_id": 1377,
    "vorder": 123,
    "position": 0,
    "text": "بفرمود پس تا منوچهر شاه"
  },
  {
    "poem_id": 1377,
    "vorder": 124,
    "position": 1,
    "text": "نشست از بر تخت زر با کلاه"
  },
  {
    "poem_id": 1377,
    "vorder": 125,
    "position": 0,
    "text": "سپهدار شیروی با خواسته"
  },
  {
    "poem_id": 1377,
    "vorder": 126,
    "position": 1,
    "text": "به درگاه شاه آمد آراسته"
  },
  {
    "poem_id": 1377,
    "vorder": 127,
    "position": 0,
    "text": "بفرمود پس تا منوچهر شاه"
  },
  {
    "poem_id": 1377,
    "vorder": 128,
    "position": 1,
    "text": "ببخشید یکسر همه با سپاه"
  },
  {
    "poem_id": 1377,
    "vorder": 129,
    "position": 0,
    "text": "چو این کرده شد روز برگشت بخت"
  },
  {
    "poem_id": 1377,
    "vorder": 130,
    "position": 1,
    "text": "بپژمرد برگ کیانی درخت"
  },
  {
    "poem_id": 1377,
    "vorder": 131,
    "position": 0,
    "text": "کرانه گزید از بر تاج و گاه"
  },
  {
    "poem_id": 1377,
    "vorder": 132,
    "position": 1,
    "text": "نهاده بر خود سر هر سه شاه"
  },
  {
    "poem_id": 1377,
    "vorder": 133,
    "position": 0,
    "text": "پر از خون دل و پر ز گریه دو روی"
  },
  {
    "poem_id": 1377,
    "vorder": 134,
    "position": 1,
    "text": "چنین تا زمانه سرآمد بروی"
  },
  {
    "poem_id": 1377,
    "vorder": 135,
    "position": 0,
    "text": "فریدون شد و نام ازو ماند باز"
  },
  {
    "poem_id": 1377,
    "vorder": 136,
    "position": 1,
    "text": "برآمد برین روزگار دراز"
  },
  {
    "poem_id": 1377,
    "vorder": 137,
    "position": 0,
    "text": "همان نیکنامی به و راستی"
  },
  {
    "poem_id": 1377,
    "vorder": 138,
    "position": 1,
    "text": "که کرد ای پسر سود برکاستی"
  },
  {
    "poem_id": 1377,
    "vorder": 139,
    "position": 0,
    "text": "منوچهر بنهاد تاج کیان"
  },
  {
    "poem_id": 1377,
    "vorder": 140,
    "position": 1,
    "text": "بزنار خونین ببستش میان"
  },
  {
    "poem_id": 1377,
    "vorder": 141,
    "position": 0,
    "text": "برآیین شاهان یکی دخمه کرد"
  },
  {
    "poem_id": 1377,
    "vorder": 142,
    "position": 1,
    "text": "چه از زر سرخ و چه از لاژورد"
  },
  {
    "poem_id": 1377,
    "vorder": 143,
    "position": 0,
    "text": "نهادند زیر اندرش تخت عاج"
  },
  {
    "poem_id": 1377,
    "vorder": 144,
    "position": 1,
    "text": "بیاویختند از بر عاج تاج"
  },
  {
    "poem_id": 1377,
    "vorder": 145,
    "position": 0,
    "text": "بپدرود کردنش رفتند پیش"
  },
  {
    "poem_id": 1377,
    "vorder": 146,
    "position": 1,
    "text": "چنان چون بود رسم آیین و کیش"
  },
  {
    "poem_id": 1377,
    "vorder": 147,
    "position": 0,
    "text": "در دخمه بستند بر شهریار"
  },
  {
    "poem_id": 1377,
    "vorder": 148,
    "position": 1,
    "text": "شد آن ارجمند از جهان زار و خوار"
  },
  {
    "poem_id": 1377,
    "vorder": 149,
    "position": 0,
    "text": "جهانا سراسر فسوسی و باد"
  },
  {
