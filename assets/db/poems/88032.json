[
  {
    "poem_id": 88032,
    "vorder": 1,
    "position": 0,
    "text": "وزآن جایگه روی برگاشتند"
  },
  {
    "poem_id": 88032,
    "vorder": 2,
    "position": 1,
    "text": "به شب دشت پیکار بگذاشتند"
  },
  {
    "poem_id": 88032,
    "vorder": 3,
    "position": 0,
    "text": "به لشکرگه خویش بازآمدند"
  },
  {
    "poem_id": 88032,
    "vorder": 4,
    "position": 1,
    "text": "بر پهلوانان فراز آمدند"
  },
  {
    "poem_id": 88032,
    "vorder": 5,
    "position": 0,
    "text": "همه شب به خواب اندر آسیب شیب"
  },
  {
    "poem_id": 88032,
    "vorder": 6,
    "position": 1,
    "text": "ز پیکارشان دل شده ناشکیب"
  },
  {
    "poem_id": 88032,
    "vorder": 7,
    "position": 0,
    "text": "سپیده چو از کوه سر بردمید"
  },
  {
    "poem_id": 88032,
    "vorder": 8,
    "position": 1,
    "text": "شد آن دامن تیره شب ناپدید"
  },
  {
    "poem_id": 88032,
    "vorder": 9,
    "position": 0,
    "text": "بپوشید هومان سلیح نبرد"
  },
  {
    "poem_id": 88032,
    "vorder": 10,
    "position": 1,
    "text": "سخن پیش پیران همه یاد کرد"
  },
  {
    "poem_id": 88032,
    "vorder": 11,
    "position": 0,
    "text": "که من بیژن گیو را خواستم"
  },
  {
    "poem_id": 88032,
    "vorder": 12,
    "position": 1,
    "text": "همه شب همی جنگش آراستم"
  },
  {
    "poem_id": 88032,
    "vorder": 13,
    "position": 0,
    "text": "یکی ترجمان را ز لشکر بخواند"
  },
  {
    "poem_id": 88032,
    "vorder": 14,
    "position": 1,
    "text": "به گلگون بادآورش برنشاند"
  },
  {
    "poem_id": 88032,
    "vorder": 15,
    "position": 0,
    "text": "که رو پیش بیژن بگویش که زود"
  },
  {
    "poem_id": 88032,
    "vorder": 16,
    "position": 1,
    "text": "بیایی دمان گر من آیم چو دود"
  },
  {
    "poem_id": 88032,
    "vorder": 17,
    "position": 0,
    "text": "فرستاده برگشت و با او بگفت"
  },
  {
    "poem_id": 88032,
    "vorder": 18,
    "position": 1,
    "text": "که با جان پاکت خرد باد جفت"
  },
  {
    "poem_id": 88032,
    "vorder": 19,
    "position": 0,
    "text": "سپهدار هومان بیامد چو گرد"
  },
  {
    "poem_id": 88032,
    "vorder": 20,
    "position": 1,
    "text": "بدان تا ز بیژن بجوید نبرد"
  },
  {
    "poem_id": 88032,
    "vorder": 21,
    "position": 0,
    "text": "چو بشنید بیژن بیامد دمان"
  },
  {
    "poem_id": 88032,
    "vorder": 22,
    "position": 1,
    "text": "بسیچیده جنگ با ترجمان"
  },
  {
    "poem_id": 88032,
    "vorder": 23,
    "position": 0,
    "text": "به پشت شباهنگ بر بسته تنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 24,
    "position": 1,
    "text": "چو جنگی پلنگی گرازان به جنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 25,
    "position": 0,
    "text": "زره با گره بر بر پهلوی"
  },
  {
    "poem_id": 88032,
    "vorder": 26,
    "position": 1,
    "text": "درفشان سر از مغفر خسروی"
  },
  {
    "poem_id": 88032,
    "vorder": 27,
    "position": 0,
    "text": "به هومان چنین گفت کای بادسار"
  },
  {
    "poem_id": 88032,
    "vorder": 28,
    "position": 1,
    "text": "ببردی ز من دوش سر یاددار"
  },
  {
    "poem_id": 88032,
    "vorder": 29,
    "position": 0,
    "text": "امیدستم امروز کین تیغ من"
  },
  {
    "poem_id": 88032,
    "vorder": 30,
    "position": 1,
    "text": "سرت را ز بن بگسلاند ز تن"
  },
  {
    "poem_id": 88032,
    "vorder": 31,
    "position": 0,
    "text": "که از خاک خیزد ز خون تو گل"
  },
  {
    "poem_id": 88032,
    "vorder": 32,
    "position": 1,
    "text": "یکی داستان اندر آری به دل"
  },
  {
    "poem_id": 88032,
    "vorder": 33,
    "position": 0,
    "text": "که با آهوان گفت غرم ژیان"
  },
  {
    "poem_id": 88032,
    "vorder": 34,
    "position": 1,
    "text": "که گر دشت گردد همه پرنیان"
  },
  {
    "poem_id": 88032,
    "vorder": 35,
    "position": 0,
    "text": "ز دامی که پای من آزاد گشت"
  },
  {
    "poem_id": 88032,
    "vorder": 36,
    "position": 1,
    "text": "نپویم بر آن سوی آباد دشت"
  },
  {
    "poem_id": 88032,
    "vorder": 37,
    "position": 0,
    "text": "چنین داد پاسخ که امروز گیو"
  },
  {
    "poem_id": 88032,
    "vorder": 38,
    "position": 1,
    "text": "بماند جگر خسته بر پور نیو"
  },
  {
    "poem_id": 88032,
    "vorder": 39,
    "position": 0,
    "text": "به چنگ منی در به سان تذرو"
  },
  {
    "poem_id": 88032,
    "vorder": 40,
    "position": 1,
    "text": "که بازش برد بر سر شاخ سرو"
  },
  {
    "poem_id": 88032,
    "vorder": 41,
    "position": 0,
    "text": "خروشان و خون از دو دیده چکان"
  },
  {
    "poem_id": 88032,
    "vorder": 42,
    "position": 1,
    "text": "کشانش به چنگال و خونش مکان"
  },
  {
    "poem_id": 88032,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت بیژن که تا کی سخن"
  },
  {
    "poem_id": 88032,
    "vorder": 44,
    "position": 1,
    "text": "کجا خواهی آهنگ آورد کن"
  },
  {
    "poem_id": 88032,
    "vorder": 45,
    "position": 0,
    "text": "به کوه کنابد کنی کارزار"
  },
  {
    "poem_id": 88032,
    "vorder": 46,
    "position": 1,
    "text": "اگر سوی زیبد برآرای کار"
  },
  {
    "poem_id": 88032,
    "vorder": 47,
    "position": 0,
    "text": "که فریادرسمان نباشد ز دور"
  },
  {
    "poem_id": 88032,
    "vorder": 48,
    "position": 1,
    "text": "نه ایران گراید به یاری نه تور"
  },
  {
    "poem_id": 88032,
    "vorder": 49,
    "position": 0,
    "text": "برانگیختند اسب و برخاست گرد"
  },
  {
    "poem_id": 88032,
    "vorder": 50,
    "position": 1,
    "text": "به زه بر نهاده کمان نبرد"
  },
  {
    "poem_id": 88032,
    "vorder": 51,
    "position": 0,
    "text": "دو خونی برافراخته سر به ماه"
  },
  {
    "poem_id": 88032,
    "vorder": 52,
    "position": 1,
    "text": "چنان کینه‌ور گشته از کین شاه"
  },
  {
    "poem_id": 88032,
    "vorder": 53,
    "position": 0,
    "text": "ز کوه کنابد برون تاختند"
  },
  {
    "poem_id": 88032,
    "vorder": 54,
    "position": 1,
    "text": "سران سوی هامون برافراختند"
  },
  {
    "poem_id": 88032,
    "vorder": 55,
    "position": 0,
    "text": "برفتند چندانک اندر زمی"
  },
  {
    "poem_id": 88032,
    "vorder": 56,
    "position": 1,
    "text": "ندیدند جایی پی آدمی"
  },
  {
    "poem_id": 88032,
    "vorder": 57,
    "position": 0,
    "text": "نه بر آسمان کرگسان را گذر"
  },
  {
    "poem_id": 88032,
    "vorder": 58,
    "position": 1,
    "text": "نه خاکش سپرده پی شیر نر"
  },
  {
    "poem_id": 88032,
    "vorder": 59,
    "position": 0,
    "text": "نه از لشکران یار و فریادرس"
  },
  {
    "poem_id": 88032,
    "vorder": 60,
    "position": 1,
    "text": "به پیرامن اندر ندیدند کس"
  },
  {
    "poem_id": 88032,
    "vorder": 61,
    "position": 0,
    "text": "نهادند پیمان که با ترجمان"
  },
  {
    "poem_id": 88032,
    "vorder": 62,
    "position": 1,
    "text": "نباشند در چیرگی بدگمان"
  },
  {
    "poem_id": 88032,
    "vorder": 63,
    "position": 0,
    "text": "بدان تا بد و نیک با شهریار"
  },
  {
    "poem_id": 88032,
    "vorder": 64,
    "position": 1,
    "text": "بگویند از این گردش روزگار"
  },
  {
    "poem_id": 88032,
    "vorder": 65,
    "position": 0,
    "text": "که کردار چون بود و پیکار چون"
  },
  {
    "poem_id": 88032,
    "vorder": 66,
    "position": 1,
    "text": "چه زاری رسید اندر این دشت خون"
  },
  {
    "poem_id": 88032,
    "vorder": 67,
    "position": 0,
    "text": "بگفتند و ز اسبان فرود آمدند"
  },
  {
    "poem_id": 88032,
    "vorder": 68,
    "position": 1,
    "text": "به بند زره بر کمر برزدند"
  },
  {
    "poem_id": 88032,
    "vorder": 69,
    "position": 0,
    "text": "بر اسبان جنگی سواران جنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 70,
    "position": 1,
    "text": "یکی برکشیدند چون سنگ تنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 71,
    "position": 0,
    "text": "چو بر بادپایان ببستند زین"
  },
  {
    "poem_id": 88032,
    "vorder": 72,
    "position": 1,
    "text": "پر از خشم گردان و دل پر ز کین"
  },
  {
    "poem_id": 88032,
    "vorder": 73,
    "position": 0,
    "text": "کمانها چو بایست برخاستند"
  },
  {
    "poem_id": 88032,
    "vorder": 74,
    "position": 1,
    "text": "به میدان تنگ اندرون تاختند"
  },
  {
    "poem_id": 88032,
    "vorder": 75,
    "position": 0,
    "text": "چپ و راست گردان و پیچان عنان"
  },
  {
    "poem_id": 88032,
    "vorder": 76,
    "position": 1,
    "text": "همان نیزه و آب داده سنان"
  },
  {
    "poem_id": 88032,
    "vorder": 77,
    "position": 0,
    "text": "زرهشان در آورد شد لخت لخت"
  },
  {
    "poem_id": 88032,
    "vorder": 78,
    "position": 1,
    "text": "نگر تا کرا روز برگشت و بخت"
  },
  {
    "poem_id": 88032,
    "vorder": 79,
    "position": 0,
    "text": "دهنشان همی از تبش مانده باز"
  },
  {
    "poem_id": 88032,
    "vorder": 80,
    "position": 1,
    "text": "به آب و به آسایش آمد نیاز"
  },
  {
    "poem_id": 88032,
    "vorder": 81,
    "position": 0,
    "text": "پس آسوده گشتند و دم برزدند"
  },
  {
    "poem_id": 88032,
    "vorder": 82,
    "position": 1,
    "text": "بر آن آتش تیز نم برزدند"
  },
  {
    "poem_id": 88032,
    "vorder": 83,
    "position": 0,
    "text": "سپر برگرفتند و شمشیر تیز"
  },
  {
    "poem_id": 88032,
    "vorder": 84,
    "position": 1,
    "text": "برآمد خروشیدن رستخیز"
  },
  {
    "poem_id": 88032,
    "vorder": 85,
    "position": 0,
    "text": "چو برق درفشان که از تیره میغ"
  },
  {
    "poem_id": 88032,
    "vorder": 86,
    "position": 1,
    "text": "همی آتش افروخت از هر دو تیغ"
  },
  {
    "poem_id": 88032,
    "vorder": 87,
    "position": 0,
    "text": "ز آهن بدان آهن آبدار"
  },
  {
    "poem_id": 88032,
    "vorder": 88,
    "position": 1,
    "text": "نیامد به زخم اندرون تابدار"
  },
  {
    "poem_id": 88032,
    "vorder": 89,
    "position": 0,
    "text": "به کردار آتش پرندآوران"
  },
  {
    "poem_id": 88032,
    "vorder": 90,
    "position": 1,
    "text": "فرو ریخت از دست کنداوران"
  },
  {
    "poem_id": 88032,
    "vorder": 91,
    "position": 0,
    "text": "نبد دسترسشان به خون ریختن"
  },
  {
    "poem_id": 88032,
    "vorder": 92,
    "position": 1,
    "text": "نشد سیر دلشان ز آویختن"
  },
  {
    "poem_id": 88032,
    "vorder": 93,
    "position": 0,
    "text": "عمود از پس تیغ برداشتند"
  },
  {
    "poem_id": 88032,
    "vorder": 94,
    "position": 1,
    "text": "از اندازه پیکار بگذاشتند"
  },
  {
    "poem_id": 88032,
    "vorder": 95,
    "position": 0,
    "text": "از آن پس بر آن بر نهادند کار"
  },
  {
    "poem_id": 88032,
    "vorder": 96,
    "position": 1,
    "text": "که زور آزمایند در کارزار"
  },
  {
    "poem_id": 88032,
    "vorder": 97,
    "position": 0,
    "text": "بدین گونه جستند ننگ و نبرد"
  },
  {
    "poem_id": 88032,
    "vorder": 98,
    "position": 1,
    "text": "که از پشت زین اندر آرند مرد"
  },
  {
    "poem_id": 88032,
    "vorder": 99,
    "position": 0,
    "text": "کمربند گیرد کرا زور بیش"
  },
  {
    "poem_id": 88032,
    "vorder": 100,
    "position": 1,
    "text": "رباید ز اسب افگند خوار پیش"
  },
  {
    "poem_id": 88032,
    "vorder": 101,
    "position": 0,
    "text": "ز نیروی گردان دوال رکیب"
  },
  {
    "poem_id": 88032,
    "vorder": 102,
    "position": 1,
    "text": "گسست اندر آوردگاه از نهیب"
  },
  {
    "poem_id": 88032,
    "vorder": 103,
    "position": 0,
    "text": "همیدون نگشتند ز اسبان جدا"
  },
  {
    "poem_id": 88032,
    "vorder": 104,
    "position": 1,
    "text": "نبودند بر یکدگر پادشا"
  },
  {
    "poem_id": 88032,
    "vorder": 105,
    "position": 0,
    "text": "پس از اسب هر دو فرود آمدند"
  },
  {
    "poem_id": 88032,
    "vorder": 106,
    "position": 1,
    "text": "ز پیکار یکبار دم برزدند"
  },
  {
    "poem_id": 88032,
    "vorder": 107,
    "position": 0,
    "text": "گرفته به دست اسپشان ترجمان"
  },
  {
    "poem_id": 88032,
    "vorder": 108,
    "position": 1,
    "text": "دو جنگی به کردار شیر دمان"
  },
  {
    "poem_id": 88032,
    "vorder": 109,
    "position": 0,
    "text": "بدان ماندگی باز برخاستند"
  },
  {
    "poem_id": 88032,
    "vorder": 110,
    "position": 1,
    "text": "به کشتی گرفتن بیاراستند"
  },
  {
    "poem_id": 88032,
    "vorder": 111,
    "position": 0,
    "text": "ز شبگیر تا سایه گسترد شید"
  },
  {
    "poem_id": 88032,
    "vorder": 112,
    "position": 1,
    "text": "دو خونی از این سان به بیم و امید"
  },
  {
    "poem_id": 88032,
    "vorder": 113,
    "position": 0,
    "text": "همی رزم جستند یک با دگر"
  },
  {
    "poem_id": 88032,
    "vorder": 114,
    "position": 1,
    "text": "یکی را ز کینه نه برگشت سر"
  },
  {
    "poem_id": 88032,
    "vorder": 115,
    "position": 0,
    "text": "دهن خشک و غرقه شده تن در آب"
  },
  {
    "poem_id": 88032,
    "vorder": 116,
    "position": 1,
    "text": "از آن رنج و تابیدن آفتاب"
  },
  {
    "poem_id": 88032,
    "vorder": 117,
    "position": 0,
    "text": "وز آن پس به دستوری یکدگر"
  },
  {
    "poem_id": 88032,
    "vorder": 118,
    "position": 1,
    "text": "برفتند پویان سوی آبخور"
  },
  {
    "poem_id": 88032,
    "vorder": 119,
    "position": 0,
    "text": "بخورد آب و برخاست بیژن به درد"
  },
  {
    "poem_id": 88032,
    "vorder": 120,
    "position": 1,
    "text": "ز دادار نیکی دهش یاد کرد"
  },
  {
    "poem_id": 88032,
    "vorder": 121,
    "position": 0,
    "text": "تن از درد لرزان چو از باد بید"
  },
  {
    "poem_id": 88032,
    "vorder": 122,
    "position": 1,
    "text": "دل از جان شیرین شده ناامید"
  },
  {
    "poem_id": 88032,
    "vorder": 123,
    "position": 0,
    "text": "به یزدان چنین گفت کای کردگار"
  },
  {
    "poem_id": 88032,
    "vorder": 124,
    "position": 1,
    "text": "تو دانی نهان من و آشکار"
  },
  {
    "poem_id": 88032,
    "vorder": 125,
    "position": 0,
    "text": "اگر داد بینی همی جنگ ما"
  },
  {
    "poem_id": 88032,
    "vorder": 126,
    "position": 1,
    "text": "بر این کینه جستن بر آهنگ ما"
  },
  {
    "poem_id": 88032,
    "vorder": 127,
    "position": 0,
    "text": "ز من مگسل امروز توش مرا"
  },
  {
    "poem_id": 88032,
    "vorder": 128,
    "position": 1,
    "text": "نگه دار بیدار هوش مرا"
  },
  {
    "poem_id": 88032,
    "vorder": 129,
    "position": 0,
    "text": "جگر خسته هومان بیامد چو زاغ"
  },
  {
    "poem_id": 88032,
    "vorder": 130,
    "position": 1,
    "text": "سیه گشت از درد رخ چون چراغ"
  },
  {
    "poem_id": 88032,
    "vorder": 131,
    "position": 0,
    "text": "بدان خستگی باز جنگ آمدند"
  },
  {
    "poem_id": 88032,
    "vorder": 132,
    "position": 1,
    "text": "گرازان به سان پلنگ آمدند"
  },
  {
    "poem_id": 88032,
    "vorder": 133,
    "position": 0,
    "text": "همی زور کرد این بر آن آن بر این"
  },
  {
    "poem_id": 88032,
    "vorder": 134,
    "position": 1,
    "text": "گه این را بسودی گه آن را زمین"
  },
  {
    "poem_id": 88032,
    "vorder": 135,
    "position": 0,
    "text": "ز بیژن فزون بود هومان به زور"
  },
  {
    "poem_id": 88032,
    "vorder": 136,
    "position": 1,
    "text": "هنر عیب گردد چو برگشت هور"
  },
  {
    "poem_id": 88032,
    "vorder": 137,
    "position": 0,
    "text": "ز هر گونه زور آزمودند و بند"
  },
  {
    "poem_id": 88032,
    "vorder": 138,
    "position": 1,
    "text": "فراز آمد آن بند چرخ بلند"
  },
  {
    "poem_id": 88032,
    "vorder": 139,
    "position": 0,
    "text": "بزد دست بیژن به سان پلنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 140,
    "position": 1,
    "text": "ز سر تا میانش بیازید چنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 141,
    "position": 0,
    "text": "گرفتش به چپ گردن و راست ران"
  },
  {
    "poem_id": 88032,
    "vorder": 142,
    "position": 1,
    "text": "خم آورد پشت هیون گران"
  },
  {
    "poem_id": 88032,
    "vorder": 143,
    "position": 0,
    "text": "برآوردش از جای و بنهاد پست"
  },
  {
    "poem_id": 88032,
    "vorder": 144,
    "position": 1,
    "text": "سوی خنجر آورد چون باد دست"
  },
  {
    "poem_id": 88032,
    "vorder": 145,
    "position": 0,
    "text": "فرو برد و کردش سر از تن جدا"
  },
  {
    "poem_id": 88032,
    "vorder": 146,
    "position": 1,
    "text": "فگندش به سان یکی اژدها"
  },
  {
    "poem_id": 88032,
    "vorder": 147,
    "position": 0,
    "text": "بغلتید هومان به خاک اندرون"
  },
  {
    "poem_id": 88032,
    "vorder": 148,
    "position": 1,
    "text": "همه دشت شد سر به سر جوی خون"
  },
  {
    "poem_id": 88032,
    "vorder": 149,
    "position": 0,
    "text": "نگه کرد بیژن بدان پیلتن"
  },
  {
    "poem_id": 88032,
    "vorder": 150,
    "position": 1,
    "text": "فگنده چو سرو سهی بر چمن"
  },
  {
    "poem_id": 88032,
    "vorder": 151,
    "position": 0,
    "text": "شگفت آمدش سخت و برگشت از اوی"
  },
  {
    "poem_id": 88032,
    "vorder": 152,
    "position": 1,
    "text": "سوی کردگار جهان کرد روی"
  },
  {
    "poem_id": 88032,
    "vorder": 153,
    "position": 0,
    "text": "که ای برتر از جایگاه و زمان"
  },
  {
    "poem_id": 88032,
    "vorder": 154,
    "position": 1,
    "text": "ز جان سخن‌گوی و روشن‌روان"
  },
  {
    "poem_id": 88032,
    "vorder": 155,
    "position": 0,
    "text": "توی تو که جز تو جهاندار نیست"
  },
  {
    "poem_id": 88032,
    "vorder": 156,
    "position": 1,
    "text": "خرد را بدین کار پیکار نیست"
  },
  {
    "poem_id": 88032,
    "vorder": 157,
    "position": 0,
    "text": "مرا ز این هنر سر به سر بهره نیست"
  },
  {
    "poem_id": 88032,
    "vorder": 158,
    "position": 1,
    "text": "که با پیل کین جستنم زهره نیست"
  },
  {
    "poem_id": 88032,
    "vorder": 159,
    "position": 0,
    "text": "به کین سیاوش بریدمش سر"
  },
  {
    "poem_id": 88032,
    "vorder": 160,
    "position": 1,
    "text": "به هفتاد خون برادر پدر"
  },
  {
    "poem_id": 88032,
    "vorder": 161,
    "position": 0,
    "text": "روانش روان ورا بنده باد"
  },
  {
    "poem_id": 88032,
    "vorder": 162,
    "position": 1,
    "text": "به چنگال شیران تنش کنده باد"
  },
  {
    "poem_id": 88032,
    "vorder": 163,
    "position": 0,
    "text": "سرش را به فتراک شبرنگ بست"
  },
  {
    "poem_id": 88032,
    "vorder": 164,
    "position": 1,
    "text": "تنش را به خاک اندر افگند پست"
  },
  {
    "poem_id": 88032,
    "vorder": 165,
    "position": 0,
    "text": "گشاده سلیح و گسسته کمر"
  },
  {
    "poem_id": 88032,
    "vorder": 166,
    "position": 1,
    "text": "تنش جای دیگر دگر جای سر"
  },
  {
    "poem_id": 88032,
    "vorder": 167,
    "position": 0,
    "text": "زمانه سراسر فریب است و بس"
  },
  {
    "poem_id": 88032,
    "vorder": 168,
    "position": 1,
    "text": "به سختی نباشدت فریادرس"
  },
  {
    "poem_id": 88032,
    "vorder": 169,
    "position": 0,
    "text": "جهان را نمایش چو کردار نیست"
  },
  {
    "poem_id": 88032,
    "vorder": 170,
    "position": 1,
    "text": "سپردن بدو دل سزاوار نیست"
  },
  {
    "poem_id": 88032,
    "vorder": 171,
    "position": 0,
    "text": "بترسید از او یار هومان چو دید"
  },
  {
    "poem_id": 88032,
    "vorder": 172,
    "position": 1,
    "text": "که بر مهتر او چنان بد رسید"
  },
  {
    "poem_id": 88032,
    "vorder": 173,
    "position": 0,
    "text": "چو شد کار هومان ویسه تباه"
  },
  {
    "poem_id": 88032,
    "vorder": 174,
    "position": 1,
    "text": "دوان ترجمانان هر دو سپاه"
  },
  {
    "poem_id": 88032,
    "vorder": 175,
    "position": 0,
    "text": "ستایش‌کنان پیش بیژن شدند"
  },
  {
    "poem_id": 88032,
    "vorder": 176,
    "position": 1,
    "text": "چو پیش بت چین برهمن شدند"
  },
  {
    "poem_id": 88032,
    "vorder": 177,
    "position": 0,
    "text": "بدو گفت بیژن مترس از گزند"
  },
  {
    "poem_id": 88032,
    "vorder": 178,
    "position": 1,
    "text": "که پیمان همان است و بگشاد بند"
  },
  {
    "poem_id": 88032,
    "vorder": 179,
    "position": 0,
    "text": "تو اکنون سوی لشکر خویش پوی"
  },
  {
    "poem_id": 88032,
    "vorder": 180,
    "position": 1,
    "text": "ز من هرچ دیدی بدیشان بگوی"
  },
  {
    "poem_id": 88032,
    "vorder": 181,
    "position": 0,
    "text": "بشد ترجمان بیژن آمد دمان"
  },
  {
    "poem_id": 88032,
    "vorder": 182,
    "position": 1,
    "text": "به کوه کنابد به زه بر کمان"
  },
  {
    "poem_id": 88032,
    "vorder": 183,
    "position": 0,
    "text": "چو بیژن نگه کرد ز آن رزمگاه"
  },
  {
    "poem_id": 88032,
    "vorder": 184,
    "position": 1,
    "text": "نبودش گذر جز به توران سپاه"
  },
  {
    "poem_id": 88032,
    "vorder": 185,
    "position": 0,
    "text": "بترسید از انبوه مردم کشان"
  },
  {
    "poem_id": 88032,
    "vorder": 186,
    "position": 1,
    "text": "که یابند ز آن کار یکسر نشان"
  },
  {
    "poem_id": 88032,
    "vorder": 187,
    "position": 0,
    "text": "به جنگ اندر آیند بر سان کوه"
  },
  {
    "poem_id": 88032,
    "vorder": 188,
    "position": 1,
    "text": "بسنده نباشد مگر با گروه"
  },
  {
    "poem_id": 88032,
    "vorder": 189,
    "position": 0,
    "text": "برآهخت درع سیاوش ز سر"
  },
  {
    "poem_id": 88032,
    "vorder": 190,
    "position": 1,
    "text": "به خفتان هومان بپوشید بر"
  },
  {
    "poem_id": 88032,
    "vorder": 191,
    "position": 0,
    "text": "بر آن چرمهٔ پیل‌پیکر نشست"
  },
  {
    "poem_id": 88032,
    "vorder": 192,
    "position": 1,
    "text": "درفش سر نامداران به دست"
  },
  {
    "poem_id": 88032,
    "vorder": 193,
    "position": 0,
    "text": "برفت و بر آن دشت کرد آفرین"
  },
  {
    "poem_id": 88032,
    "vorder": 194,
    "position": 1,
    "text": "بر آن بخت بیدار و فرخ زمین"
  },
  {
    "poem_id": 88032,
    "vorder": 195,
    "position": 0,
    "text": "چو آن دیده‌بانان لشکر ز دور"
  },
  {
    "poem_id": 88032,
    "vorder": 196,
    "position": 1,
    "text": "درفش و نشان سپهدار تور"
  },
  {
    "poem_id": 88032,
    "vorder": 197,
    "position": 0,
    "text": "بدیدند ز آن دیده برخاستند"
  },
  {
    "poem_id": 88032,
    "vorder": 198,
    "position": 1,
    "text": "به شادی خروشیدن آراستند"
  },
  {
    "poem_id": 88032,
    "vorder": 199,
    "position": 0,
    "text": "طلایه هیونی برافگند زود"
  },
  {
    "poem_id": 88032,
    "vorder": 200,
    "position": 1,
    "text": "به نزدیک پیران به کردار دود"
  },
  {
    "poem_id": 88032,
    "vorder": 201,
    "position": 0,
    "text": "که هومان به پیروزی شهریار"
  },
  {
    "poem_id": 88032,
    "vorder": 202,
    "position": 1,
    "text": "دوان آمد از مرکز کارزار"
  },
  {
    "poem_id": 88032,
    "vorder": 203,
    "position": 0,
    "text": "درفش سپهدار ایران نگون"
  },
  {
    "poem_id": 88032,
    "vorder": 204,
    "position": 1,
    "text": "تنش غرقه مانده به خاک اندرون"
  },
  {
    "poem_id": 88032,
    "vorder": 205,
    "position": 0,
    "text": "همه لشکرش برگرفته خروش"
  },
  {
    "poem_id": 88032,
    "vorder": 206,
    "position": 1,
    "text": "به هومان نهاده سپهدار گوش"
  },
  {
    "poem_id": 88032,
    "vorder": 207,
    "position": 0,
    "text": "چو بیژن میان دو رویه سپاه"
  },
  {
    "poem_id": 88032,
    "vorder": 208,
    "position": 1,
    "text": "رسید اندر آن سایهٔ تاج و گاه"
  },
  {
    "poem_id": 88032,
    "vorder": 209,
    "position": 0,
    "text": "به توران رسید آن زمان ترجمان"
  },
  {
    "poem_id": 88032,
    "vorder": 210,
    "position": 1,
    "text": "بگفت آنچ دید از بد بدگمان"
  },
  {
    "poem_id": 88032,
    "vorder": 211,
    "position": 0,
    "text": "هم آنگه به پیران رسید آگهی"
  },
  {
    "poem_id": 88032,
    "vorder": 212,
    "position": 1,
    "text": "که شد تیره آن فر شاهنشهی"
  },
  {
    "poem_id": 88032,
    "vorder": 213,
    "position": 0,
    "text": "سبک بیژن اندر میان سپاه"
  },
  {
    "poem_id": 88032,
    "vorder": 214,
    "position": 1,
    "text": "نگونسار کرد آن درفش سیاه"
  },
  {
    "poem_id": 88032,
    "vorder": 215,
    "position": 0,
    "text": "چو آن دیده‌بانان ایران سپاه"
  },
  {
    "poem_id": 88032,
    "vorder": 216,
    "position": 1,
    "text": "نگون یافتند آن درفش سیاه"
  },
  {
    "poem_id": 88032,
    "vorder": 217,
    "position": 0,
    "text": "سوی پهلوان روی برگاشتند"
  },
  {
    "poem_id": 88032,
    "vorder": 218,
    "position": 1,
    "text": "وز آن دیده گه نعره برداشتند"
  },
  {
    "poem_id": 88032,
    "vorder": 219,
    "position": 0,
    "text": "وز آنجا هیونی به سان نوند"
  },
  {
    "poem_id": 88032,
    "vorder": 220,
    "position": 1,
    "text": "طلایه سوی پهلوان برفگند"
  },
  {
    "poem_id": 88032,
    "vorder": 221,
    "position": 0,
    "text": "که بیژن به پروزی آمد چو شیر"
  },
  {
    "poem_id": 88032,
    "vorder": 222,
    "position": 1,
    "text": "درفش سیه را سر آورده زیر"
  },
  {
    "poem_id": 88032,
    "vorder": 223,
    "position": 0,
    "text": "چو دیوانگان گیو گشته نوان"
  },
  {
    "poem_id": 88032,
    "vorder": 224,
    "position": 1,
    "text": "به هر سو خروشان و هر سو دوان"
  },
  {
    "poem_id": 88032,
    "vorder": 225,
    "position": 0,
    "text": "همی آگهی جست ز آن نیوپور"
  },
  {
    "poem_id": 88032,
    "vorder": 226,
    "position": 1,
    "text": "همی ماتم آورد هنگام سور"
  },
  {
    "poem_id": 88032,
    "vorder": 227,
    "position": 0,
    "text": "چو آگاهی آمد ز بیژن بدوی"
  },
  {
    "poem_id": 88032,
    "vorder": 228,
    "position": 1,
    "text": "دمان پیش فرزند بنهاد روی"
  },
  {
    "poem_id": 88032,
    "vorder": 229,
    "position": 0,
    "text": "چو چشمش به روی گرامی رسید"
  },
  {
    "poem_id": 88032,
    "vorder": 230,
    "position": 1,
    "text": "ز اسب اندر آمد چنان چون سزید"
  },
  {
    "poem_id": 88032,
    "vorder": 231,
    "position": 0,
    "text": "بغلتید و بنهاد بر خاک سر"
  },
  {
    "poem_id": 88032,
    "vorder": 232,
    "position": 1,
    "text": "همی آفرین خواند بر دادگر"
  },
  {
    "poem_id": 88032,
    "vorder": 233,
    "position": 0,
    "text": "گرفتش به بر باز فرزند را"
  },
  {
    "poem_id": 88032,
    "vorder": 234,
    "position": 1,
    "text": "دلیر و جوان و خردمند را"
  },
  {
    "poem_id": 88032,
    "vorder": 235,
    "position": 0,
    "text": "وز آنجا دمان سوی سالار شاه"
  },
  {
    "poem_id": 88032,
    "vorder": 236,
    "position": 1,
    "text": "ستایش کنان برگرفتند راه"
  },
  {
    "poem_id": 88032,
    "vorder": 237,
    "position": 0,
    "text": "چو دیدند مر پهلوان را ز دور"
  },
  {
    "poem_id": 88032,
    "vorder": 238,
    "position": 1,
    "text": "نبیره فرود آمد از اسب تور"
  },
  {
    "poem_id": 88032,
    "vorder": 239,
    "position": 0,
    "text": "پر از خون سلیح و پر از خاک سر"
  },
  {
    "poem_id": 88032,
    "vorder": 240,
    "position": 1,
    "text": "سر گرد هومان به فتراک بر"
  },
  {
    "poem_id": 88032,
    "vorder": 241,
    "position": 0,
    "text": "به پیش نیا رفت بیژن چو دود"
  },
  {
    "poem_id": 88032,
    "vorder": 242,
    "position": 1,
    "text": "همی یاد کرد آن کجا رفته بود"
  },
  {
    "poem_id": 88032,
    "vorder": 243,
    "position": 0,
    "text": "سلیح و سر و اسب هومان گرد"
  },
  {
    "poem_id": 88032,
    "vorder": 244,
    "position": 1,
    "text": "به پیش سپهدار گودرز برد"
  },
  {
    "poem_id": 88032,
    "vorder": 245,
    "position": 0,
    "text": "ز بیژن چنان شاد شد پهلوان"
  },
  {
    "poem_id": 88032,
    "vorder": 246,
    "position": 1,
    "text": "که گفتی برافشاند خواهد روان"
  },
  {
    "poem_id": 88032,
    "vorder": 247,
    "position": 0,
    "text": "گرفت آفرین پس به دادار بر"
  },
  {
    "poem_id": 88032,
    "vorder": 248,
    "position": 1,
    "text": "بر آن اختر و بخت بیدار بر"
  },
  {
    "poem_id": 88032,
    "vorder": 249,
    "position": 0,
    "text": "به گنجور فرمود پس پهلوان"
  },
  {
    "poem_id": 88032,
    "vorder": 250,
    "position": 1,
    "text": "که تاج آر با جامهٔ خسروان"
  },
  {
    "poem_id": 88032,
    "vorder": 251,
    "position": 0,
    "text": "گهربافته پیکر و بوم زر"
  },
  {
    "poem_id": 88032,
    "vorder": 252,
    "position": 1,
    "text": "درفشان چو خورشید تاج و کمر"
  },
  {
    "poem_id": 88032,
    "vorder": 253,
    "position": 0,
    "text": "ده اسب آوریدند زرین لگام"
  },
  {
    "poem_id": 88032,
    "vorder": 254,
    "position": 1,
    "text": "پری‌روی زرین کمر ده غلام"
  },
  {
    "poem_id": 88032,
    "vorder": 255,
    "position": 0,
    "text": "بدو داد و گفت از گه سام شیر"
  },
  {
    "poem_id": 88032,
    "vorder": 256,
    "position": 1,
    "text": "کسی ناورید اژدهایی به زیر"
  },
  {
    "poem_id": 88032,
    "vorder": 257,
    "position": 0,
    "text": "گشادی سپه را بدین جنگ دست"
  },
  {
    "poem_id": 88032,
    "vorder": 258,
    "position": 1,
    "text": "دل شاه ترکان به هم بر شکست"
  },
  {
    "poem_id": 88032,
    "vorder": 259,
    "position": 0,
    "text": "همه لشکر شاه ایران چو شیر"
  },
  {
    "poem_id": 88032,
    "vorder": 260,
    "position": 1,
    "text": "دمان و دنان بادپایان به زیر"
  },
  {
    "poem_id": 88032,
    "vorder": 261,
    "position": 0,
    "text": "وز اندوه پیران برآورد خشم"
  },
  {
    "poem_id": 88032,
    "vorder": 262,
    "position": 1,
    "text": "دل از درد خسته پر از آب چشم"
  },
  {
    "poem_id": 88032,
    "vorder": 263,
    "position": 0,
    "text": "به نستیهن آنگه فرستاد کس"
  },
  {
    "poem_id": 88032,
    "vorder": 264,
    "position": 1,
    "text": "که ای نامور گرد فریادرس"
  },
  {
    "poem_id": 88032,
    "vorder": 265,
    "position": 0,
    "text": "سزد گر کنی جنگ را تیز چنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 266,
    "position": 1,
    "text": "به کین برادر نسازی درنگ"
  },
  {
    "poem_id": 88032,
    "vorder": 267,
    "position": 0,
    "text": "به ایرانیان بر شبیخون کنی"
  },
  {
    "poem_id": 88032,
    "vorder": 268,
    "position": 1,
    "text": "زمین را به خون رود جیحون کنی"
  },
  {
    "poem_id": 88032,
    "vorder": 269,
    "position": 0,
    "text": "ببر ده هزار آزموده سوار"
  },
  {
    "poem_id": 88032,
    "vorder": 270,
    "position": 1,
    "text": "کمر بسته بر کینه و کارزار"
  },
  {
    "poem_id": 88032,
    "vorder": 271,
    "position": 0,
    "text": "مگر کین هومان تو بازآوری"
  },
  {
    "poem_id": 88032,
    "vorder": 272,
    "position": 1,
    "text": "سر دشمنان را به گاز آوری"
  },
  {
    "poem_id": 88032,
    "vorder": 273,
    "position": 0,
    "text": "چو رفتی به نزدیک لشکر فراز"
  },
  {
    "poem_id": 88032,
    "vorder": 274,
    "position": 1,
    "text": "سپه را یکی سوی هومان بساز"
  },
  {
    "poem_id": 88032,
    "vorder": 275,
    "position": 0,
    "text": "بدو گفت نستیهن ایدون کنم"
  },
  {
    "poem_id": 88032,
    "vorder": 276,
    "position": 1,
    "text": "که از خون زمین رود جیحون کنم"
  }
]