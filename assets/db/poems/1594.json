[
  {
    "poem_id": 1594,
    "vorder": 1,
    "position": 0,
    "text": "چو رستم بدر شد ز پرده‌سرای"
  },
  {
    "poem_id": 1594,
    "vorder": 2,
    "position": 1,
    "text": "زمانی همی بود بر در به پای"
  },
  {
    "poem_id": 1594,
    "vorder": 3,
    "position": 0,
    "text": "به کریاس گفت ای سرای امید"
  },
  {
    "poem_id": 1594,
    "vorder": 4,
    "position": 1,
    "text": "خنک روز کاندر تو بد جمشید"
  },
  {
    "poem_id": 1594,
    "vorder": 5,
    "position": 0,
    "text": "همایون بدی گاه کاوس کی"
  },
  {
    "poem_id": 1594,
    "vorder": 6,
    "position": 1,
    "text": "همان روز کیخسرو نیک‌پی"
  },
  {
    "poem_id": 1594,
    "vorder": 7,
    "position": 0,
    "text": "در فرهی بر تو اکنون ببست"
  },
  {
    "poem_id": 1594,
    "vorder": 8,
    "position": 1,
    "text": "که بر تخت تو ناسزایی نشست"
  },
  {
    "poem_id": 1594,
    "vorder": 9,
    "position": 0,
    "text": "شنید این سخنها یل اسفندیار"
  },
  {
    "poem_id": 1594,
    "vorder": 10,
    "position": 1,
    "text": "پیاده بیامد بر نامدار"
  },
  {
    "poem_id": 1594,
    "vorder": 11,
    "position": 0,
    "text": "به رستم چنین گفت کای سرگرای"
  },
  {
    "poem_id": 1594,
    "vorder": 12,
    "position": 1,
    "text": "چرا تیز گشتی به پرده‌سرای"
  },
  {
    "poem_id": 1594,
    "vorder": 13,
    "position": 0,
    "text": "سزد گر برین بوم زابلستان"
  },
  {
    "poem_id": 1594,
    "vorder": 14,
    "position": 1,
    "text": "نهد دانشی نام غلغلستان"
  },
  {
    "poem_id": 1594,
    "vorder": 15,
    "position": 0,
    "text": "که مهمان چو سیر آید از میزبان"
  },
  {
    "poem_id": 1594,
    "vorder": 16,
    "position": 1,
    "text": "به زشتی برد نام پالیزبان"
  },
  {
    "poem_id": 1594,
    "vorder": 17,
    "position": 0,
    "text": "سراپرده را گفت بد روزگار"
  },
  {
    "poem_id": 1594,
    "vorder": 18,
    "position": 1,
    "text": "که جمشید را داشتی بر کنار"
  },
  {
    "poem_id": 1594,
    "vorder": 19,
    "position": 0,
    "text": "همان روز کز بهر کاوس شاه"
  },
  {
    "poem_id": 1594,
    "vorder": 20,
    "position": 1,
    "text": "بدی پرده و سایهٔ بارگاه"
  },
  {
    "poem_id": 1594,
    "vorder": 21,
    "position": 0,
    "text": "کجا راه یزدان همی بازجست"
  },
  {
    "poem_id": 1594,
    "vorder": 22,
    "position": 1,
    "text": "همی خواستی اختران را درست"
  },
  {
    "poem_id": 1594,
    "vorder": 23,
    "position": 0,
    "text": "زمین زو سراسر پرآشوب بود"
  },
  {
    "poem_id": 1594,
    "vorder": 24,
    "position": 1,
    "text": "پر از خنجر و غارت و چوب بود"
  },
  {
    "poem_id": 1594,
    "vorder": 25,
    "position": 0,
    "text": "کنون مایه‌دار تو گشتاسپ است"
  },
  {
    "poem_id": 1594,
    "vorder": 26,
    "position": 1,
    "text": "به پیش وی اندر چو جاماسپ است"
  },
  {
    "poem_id": 1594,
    "vorder": 27,
    "position": 0,
    "text": "نشسته به یک دست او زردهشت"
  },
  {
    "poem_id": 1594,
    "vorder": 28,
    "position": 1,
    "text": "که با زند واست آمدست از بهشت"
  },
  {
    "poem_id": 1594,
    "vorder": 29,
    "position": 0,
    "text": "به دیگر پشوتن گو نیک مرد"
  },
  {
    "poem_id": 1594,
    "vorder": 30,
    "position": 1,
    "text": "چشیده ز گیتی بسی گرم و سرد"
  },
  {
    "poem_id": 1594,
    "vorder": 31,
    "position": 0,
    "text": "به پیش اندرون فرخ اسفندیار"
  },
  {
    "poem_id": 1594,
    "vorder": 32,
    "position": 1,
    "text": "کزو شاد شد گردش روزگار"
  },
  {
    "poem_id": 1594,
    "vorder": 33,
    "position": 0,
    "text": "دل نیک‌مردان بدو زنده شد"
  },
  {
    "poem_id": 1594,
    "vorder": 34,
    "position": 1,
    "text": "بد از بیم شمشیر او بنده شد"
  },
  {
    "poem_id": 1594,
    "vorder": 35,
    "position": 0,
    "text": "بیامد بدر پهلوان سوار"
  },
  {
    "poem_id": 1594,
    "vorder": 36,
    "position": 1,
    "text": "پس‌اندر همی دیدش اسفندیار"
  },
  {
    "poem_id": 1594,
    "vorder": 37,
    "position": 0,
    "text": "چو برگشت ازو با پشوتن بگفت"
  },
  {
    "poem_id": 1594,
    "vorder": 38,
    "position": 1,
    "text": "که مردی و گردی نشاید نهفت"
  },
  {
    "poem_id": 1594,
    "vorder": 39,
    "position": 0,
    "text": "ندیدم بدین گونه اسپ و سوار"
  },
  {
    "poem_id": 1594,
    "vorder": 40,
    "position": 1,
    "text": "ندانم که چون خیزد از کارزار"
  },
  {
    "poem_id": 1594,
    "vorder": 41,
    "position": 0,
    "text": "یکی ژنده پیل است بر کوه گنگ"
  },
  {
    "poem_id": 1594,
    "vorder": 42,
    "position": 1,
    "text": "اگر با سلیح اندر آید به جنگ"
  },
  {
    "poem_id": 1594,
    "vorder": 43,
    "position": 0,
    "text": "اگر با سلیح نبردی بود"
  },
  {
    "poem_id": 1594,
    "vorder": 44,
    "position": 1,
    "text": "همانا که آیین مردی بود"
  },
  {
    "poem_id": 1594,
    "vorder": 45,
    "position": 0,
    "text": "به بالا همی بگذرد فر و زیب"
  },
  {
    "poem_id": 1594,
    "vorder": 46,
    "position": 1,
    "text": "بترسم که فردا ببیند نشیب"
  },
  {
    "poem_id": 1594,
    "vorder": 47,
    "position": 0,
    "text": "همی سوزد از مهر فرش دلم"
  },
  {
    "poem_id": 1594,
    "vorder": 48,
    "position": 1,
    "text": "ز فرمان دادار دل نگسلم"
  },
  {
    "poem_id": 1594,
    "vorder": 49,
    "position": 0,
    "text": "چو فردا بیاید به آوردگاه"
  },
  {
    "poem_id": 1594,
    "vorder": 50,
    "position": 1,
    "text": "کنم روز روشن بروبر سیاه"
  },
  {
    "poem_id": 1594,
    "vorder": 51,
    "position": 0,
    "text": "پشوتن بدو گفت بشنو سخن"
  },
  {
    "poem_id": 1594,
    "vorder": 52,
    "position": 1,
    "text": "همی گویمت ای برادر مکن"
  },
  {
    "poem_id": 1594,
    "vorder": 53,
    "position": 0,
    "text": "ترا گفتم و بیش گویم همی"
  },
  {
    "poem_id": 1594,
    "vorder": 54,
    "position": 1,
    "text": "که از راستی دل نشویم همی"
  },
  {
    "poem_id": 1594,
    "vorder": 55,
    "position": 0,
    "text": "میازار کس را که آزاد مرد"
  },
  {
    "poem_id": 1594,
    "vorder": 56,
    "position": 1,
    "text": "سر اندر نیارد به آزار و درد"
  },
  {
    "poem_id": 1594,
    "vorder": 57,
    "position": 0,
    "text": "بخسب امشب و بامداد پگاه"
  },
  {
    "poem_id": 1594,
    "vorder": 58,
    "position": 1,
    "text": "برو تا به ایوان او بی‌سپاه"
  },
  {
    "poem_id": 1594,
    "vorder": 59,
    "position": 0,
    "text": "بایوان او روز فرخ کنیم"
  },
  {
    "poem_id": 1594,
    "vorder": 60,
    "position": 1,
    "text": "سخن هرچ گویند پاسخ کنیم"
  },
  {
    "poem_id": 1594,
    "vorder": 61,
    "position": 0,
    "text": "همه کار نیکوست زو در جهان"
  },
  {
    "poem_id": 1594,
    "vorder": 62,
    "position": 1,
    "text": "میان کهان و میان مهان"
  },
  {
    "poem_id": 1594,
    "vorder": 63,
    "position": 0,
    "text": "همی سر نپیچد ز فرمان تو"
  },
  {
    "poem_id": 1594,
    "vorder": 64,
    "position": 1,
    "text": "دلش راست بینم به پیمان تو"
  },
  {
    "poem_id": 1594,
    "vorder": 65,
    "position": 0,
    "text": "تو با او چه گویی به کین و به خشم"
  },
  {
    "poem_id": 1594,
    "vorder": 66,
    "position": 1,
    "text": "بشوی از دلت کین وز خشم چشم"
  },
  {
    "poem_id": 1594,
    "vorder": 67,
    "position": 0,
    "text": "یکی پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1594,
    "vorder": 68,
    "position": 1,
    "text": "که بر گوشهٔ گلستان رست خار"
  },
  {
    "poem_id": 1594,
    "vorder": 69,
    "position": 0,
    "text": "چنین گفت کز مردم پاک‌دین"
  },
  {
    "poem_id": 1594,
    "vorder": 70,
    "position": 1,
    "text": "همانا نزیبد که گوید چنین"
  },
  {
    "poem_id": 1594,
    "vorder": 71,
    "position": 0,
    "text": "گر ایدونک دستور ایران توی"
  },
  {
    "poem_id": 1594,
    "vorder": 72,
    "position": 1,
    "text": "دل و گوش و چشم دلیران توی"
  },
  {
    "poem_id": 1594,
    "vorder": 73,
    "position": 0,
    "text": "همی خوب داری چنین راه را"
  },
  {
    "poem_id": 1594,
    "vorder": 74,
    "position": 1,
    "text": "خرد را و آزردن شاه را"
  },
  {
    "poem_id": 1594,
    "vorder": 75,
    "position": 0,
    "text": "همه رنج و تیمار ما باد گشت"
  },
  {
    "poem_id": 1594,
    "vorder": 76,
    "position": 1,
    "text": "همان دین زردشت بیداد گشت"
  },
  {
    "poem_id": 1594,
    "vorder": 77,
    "position": 0,
    "text": "که گوید که هر کو ز فرمان شاه"
  },
  {
    "poem_id": 1594,
    "vorder": 78,
    "position": 1,
    "text": "بپیچد به دوزخ بود جایگاه"
  },
  {
    "poem_id": 1594,
    "vorder": 79,
    "position": 0,
    "text": "مرا چند گویی گنهکار شو"
  },
  {
    "poem_id": 1594,
    "vorder": 80,
    "position": 1,
    "text": "ز گفتار گشتاسپ بیزار شو"
  },
  {
    "poem_id": 1594,
    "vorder": 81,
    "position": 0,
    "text": "تو گویی و من خود چنین کی کنم"
  },
  {
    "poem_id": 1594,
    "vorder": 82,
    "position": 1,
    "text": "که از رای و فرمان او پی کنم"
  },
  {
    "poem_id": 1594,
    "vorder": 83,
    "position": 0,
    "text": "گر ایدونک ترسی همی از تنم"
  },
  {
    "poem_id": 1594,
    "vorder": 84,
    "position": 1,
    "text": "من امروز ترس ترا بشکنم"
  },
  {
    "poem_id": 1594,
    "vorder": 85,
    "position": 0,
    "text": "کسی بی‌زمانه به گیتی نمرد"
  },
  {
    "poem_id": 1594,
    "vorder": 86,
    "position": 1,
    "text": "نمرد آنک نام بزرگی ببرد"
  },
  {
    "poem_id": 1594,
    "vorder": 87,
    "position": 0,
    "text": "تو فردا ببینی که بر دشت جنگ"
  },
  {
    "poem_id": 1594,
    "vorder": 88,
    "position": 1,
    "text": "چه کار آورم پیش چنگی پلنگ"
  },
  {
    "poem_id": 1594,
    "vorder": 89,
    "position": 0,
    "text": "پشوتن بدو گفت کای نامدار"
  },
  {
    "poem_id": 1594,
    "vorder": 90,
    "position": 1,
    "text": "چنین چند گویی تو از کارزار"
  },
  {
    "poem_id": 1594,
    "vorder": 91,
    "position": 0,
    "text": "که تا تو رسیدی به تیر و کمان"
  },
  {
    "poem_id": 1594,
    "vorder": 92,
    "position": 1,
    "text": "نبد بر تو ابلیس را این گمان"
  },
  {
    "poem_id": 1594,
    "vorder": 93,
    "position": 0,
    "text": "به دل دیو را راه دادی کنون"
  },
  {
    "poem_id": 1594,
    "vorder": 94,
    "position": 1,
    "text": "همی نشنوی پند این رهنمون"
  },
  {
    "poem_id": 1594,
    "vorder": 95,
    "position": 0,
    "text": "دلت خیره بینم همی پر ستیز"
  },
  {
    "poem_id": 1594,
    "vorder": 96,
    "position": 1,
    "text": "کنون هرچ گفتم همه ریزریز"
  },
  {
    "poem_id": 1594,
    "vorder": 97,
    "position": 0,
    "text": "چگونه کنم ترس را از دلم"
  },
  {
    "poem_id": 1594,
    "vorder": 98,
    "position": 1,
    "text": "بدین سان کز اندیشه‌ها بگسلم"
  },
  {
    "poem_id": 1594,
    "vorder": 99,
    "position": 0,
    "text": "دو جنگی دو شیر و دو مرد دلیر"
  },
  {
    "poem_id": 1594,
    "vorder": 100,
    "position": 1,
    "text": "چه دانم که پشت که آید به زیر"
  },
  {
    "poem_id": 1594,
    "vorder": 101,
    "position": 0,
    "text": "ورا نامور هیچ پاسخ نداد"
  },
  {
    "poem_id": 1594,
    "vorder": 102,
    "position": 1,
    "text": "دلش گشت پر درد و سر پر ز باد"
  }
]