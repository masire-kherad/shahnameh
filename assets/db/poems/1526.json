[
  {
    "poem_id": 1526,
    "vorder": 1,
    "position": 0,
    "text": "چو برخاست قیصر به گشتاسپ گفت"
  },
  {
    "poem_id": 1526,
    "vorder": 2,
    "position": 1,
    "text": "که پاسخ چرا ماندی در نهفت"
  },
  {
    "poem_id": 1526,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت گشتاسپ من پیش ازین"
  },
  {
    "poem_id": 1526,
    "vorder": 4,
    "position": 1,
    "text": "ببودم بر شاه ایران زمین"
  },
  {
    "poem_id": 1526,
    "vorder": 5,
    "position": 0,
    "text": "همه لشکر شاه و آن انجمن"
  },
  {
    "poem_id": 1526,
    "vorder": 6,
    "position": 1,
    "text": "همه آگهند از هنرهای من"
  },
  {
    "poem_id": 1526,
    "vorder": 7,
    "position": 0,
    "text": "همان به که من سوی ایشان شوم"
  },
  {
    "poem_id": 1526,
    "vorder": 8,
    "position": 1,
    "text": "بگویم همه گفته‌ها بشنوم"
  },
  {
    "poem_id": 1526,
    "vorder": 9,
    "position": 0,
    "text": "برآرم ازیشان همه کام تو"
  },
  {
    "poem_id": 1526,
    "vorder": 10,
    "position": 1,
    "text": "درفشان کنم در جهان نام تو"
  },
  {
    "poem_id": 1526,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت قیصر تو داناتری"
  },
  {
    "poem_id": 1526,
    "vorder": 12,
    "position": 1,
    "text": "برین آرزو بر تواناتری"
  },
  {
    "poem_id": 1526,
    "vorder": 13,
    "position": 0,
    "text": "چو بشنید گشتاسپ گفتار اوی"
  },
  {
    "poem_id": 1526,
    "vorder": 14,
    "position": 1,
    "text": "نشست از بر بارهٔ راه جوی"
  },
  {
    "poem_id": 1526,
    "vorder": 15,
    "position": 0,
    "text": "بیامد به جای نشست زریر"
  },
  {
    "poem_id": 1526,
    "vorder": 16,
    "position": 1,
    "text": "به سر افسر و بادپایی به زیر"
  },
  {
    "poem_id": 1526,
    "vorder": 17,
    "position": 0,
    "text": "چو لشکر بدیدند گشتاسپ را"
  },
  {
    "poem_id": 1526,
    "vorder": 18,
    "position": 1,
    "text": "سرافرازتر پور لهراسپ را"
  },
  {
    "poem_id": 1526,
    "vorder": 19,
    "position": 0,
    "text": "پیاده همه پیش اوی آمدند"
  },
  {
    "poem_id": 1526,
    "vorder": 20,
    "position": 1,
    "text": "پر از درد و پر آب روی آمدند"
  },
  {
    "poem_id": 1526,
    "vorder": 21,
    "position": 0,
    "text": "همه پاک بردند پیشش نماز"
  },
  {
    "poem_id": 1526,
    "vorder": 22,
    "position": 1,
    "text": "که کوتاه شد رنجهای دراز"
  },
  {
    "poem_id": 1526,
    "vorder": 23,
    "position": 0,
    "text": "همانگه چو آمد به پیشش زریر"
  },
  {
    "poem_id": 1526,
    "vorder": 24,
    "position": 1,
    "text": "پیاده ببود و شد از رزم سیر"
  },
  {
    "poem_id": 1526,
    "vorder": 25,
    "position": 0,
    "text": "گرامیش را تنگ در بر گرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 26,
    "position": 1,
    "text": "چو بگشاد لب پرسش اندر گرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 27,
    "position": 0,
    "text": "نشستند بر تخت با مهتران"
  },
  {
    "poem_id": 1526,
    "vorder": 28,
    "position": 1,
    "text": "بزرگان ایران و کنداوران"
  },
  {
    "poem_id": 1526,
    "vorder": 29,
    "position": 0,
    "text": "زریر خجسته به گشتاسپ گفت"
  },
  {
    "poem_id": 1526,
    "vorder": 30,
    "position": 1,
    "text": "که بادی همه ساله با بخت جفت"
  },
  {
    "poem_id": 1526,
    "vorder": 31,
    "position": 0,
    "text": "پدر پیر سر شد تو برنادلی"
  },
  {
    "poem_id": 1526,
    "vorder": 32,
    "position": 1,
    "text": "ز دیدار پیران چرا بگسلی"
  },
  {
    "poem_id": 1526,
    "vorder": 33,
    "position": 0,
    "text": "به پیری ورا بخت خندان شدست"
  },
  {
    "poem_id": 1526,
    "vorder": 34,
    "position": 1,
    "text": "پرستندهٔ پاک یزدان شدست"
  },
  {
    "poem_id": 1526,
    "vorder": 35,
    "position": 0,
    "text": "فرستاد نزدیک تو تاج و گنج"
  },
  {
    "poem_id": 1526,
    "vorder": 36,
    "position": 1,
    "text": "سزد گر نداری کنون دل به رنج"
  },
  {
    "poem_id": 1526,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت کایران سراسر تراست"
  },
  {
    "poem_id": 1526,
    "vorder": 38,
    "position": 1,
    "text": "سر تخت با تاج کشور تراست"
  },
  {
    "poem_id": 1526,
    "vorder": 39,
    "position": 0,
    "text": "ز گیتی یکی کنج ما را بس است"
  },
  {
    "poem_id": 1526,
    "vorder": 40,
    "position": 1,
    "text": "که تخت مهی را جز از من کس است"
  },
  {
    "poem_id": 1526,
    "vorder": 41,
    "position": 0,
    "text": "برادر بیاورد پرمایه تاج"
  },
  {
    "poem_id": 1526,
    "vorder": 42,
    "position": 1,
    "text": "همان یاره و طوق و هم تخت عاج"
  },
  {
    "poem_id": 1526,
    "vorder": 43,
    "position": 0,
    "text": "چو گشتاسپ تخت پدر دید شاد"
  },
  {
    "poem_id": 1526,
    "vorder": 44,
    "position": 1,
    "text": "نشست از برش تاج بر سر نهاد"
  },
  {
    "poem_id": 1526,
    "vorder": 45,
    "position": 0,
    "text": "نبیرهٔ جهانجوی کاوس کی"
  },
  {
    "poem_id": 1526,
    "vorder": 46,
    "position": 1,
    "text": "ز گودرزیان هرک بد نیک‌پی"
  },
  {
    "poem_id": 1526,
    "vorder": 47,
    "position": 0,
    "text": "چو بهرام و چون ساوه و ریونیز"
  },
  {
    "poem_id": 1526,
    "vorder": 48,
    "position": 1,
    "text": "کسی کو سرافراز بودند نیز"
  },
  {
    "poem_id": 1526,
    "vorder": 49,
    "position": 0,
    "text": "به شاهی برو آفرین خواندند"
  },
  {
    "poem_id": 1526,
    "vorder": 50,
    "position": 1,
    "text": "ورا شهریار زمین خواندند"
  },
  {
    "poem_id": 1526,
    "vorder": 51,
    "position": 0,
    "text": "ببودند بر پای بسته کمر"
  },
  {
    "poem_id": 1526,
    "vorder": 52,
    "position": 1,
    "text": "هرانکس که بودند پرخاشخر"
  },
  {
    "poem_id": 1526,
    "vorder": 53,
    "position": 0,
    "text": "چو گشتاسپ دید آن دلارای کام"
  },
  {
    "poem_id": 1526,
    "vorder": 54,
    "position": 1,
    "text": "فرستاد نزدیک قیصر پیام"
  },
  {
    "poem_id": 1526,
    "vorder": 55,
    "position": 0,
    "text": "کز ایران همه کام تو راست گشت"
  },
  {
    "poem_id": 1526,
    "vorder": 56,
    "position": 1,
    "text": "سخنها ز اندازه اندر گذشت"
  },
  {
    "poem_id": 1526,
    "vorder": 57,
    "position": 0,
    "text": "همی چشم دارد زریر و سپاه"
  },
  {
    "poem_id": 1526,
    "vorder": 58,
    "position": 1,
    "text": "که آیی خرامان بدین رزمگاه"
  },
  {
    "poem_id": 1526,
    "vorder": 59,
    "position": 0,
    "text": "همه سربسر با تو پیمان کنند"
  },
  {
    "poem_id": 1526,
    "vorder": 60,
    "position": 1,
    "text": "روان را به مهرت گروگان کنند"
  },
  {
    "poem_id": 1526,
    "vorder": 61,
    "position": 0,
    "text": "گرت رنج ناید خرامی به دشت"
  },
  {
    "poem_id": 1526,
    "vorder": 62,
    "position": 1,
    "text": "که کار زمانه به کام تو گشت"
  },
  {
    "poem_id": 1526,
    "vorder": 63,
    "position": 0,
    "text": "فرستاده چون نزد قیصر رسید"
  },
  {
    "poem_id": 1526,
    "vorder": 64,
    "position": 1,
    "text": "به دشت آمد و ساز لشکر بدید"
  },
  {
    "poem_id": 1526,
    "vorder": 65,
    "position": 0,
    "text": "چو گشتاسپ را دید بر تخت عاج"
  },
  {
    "poem_id": 1526,
    "vorder": 66,
    "position": 1,
    "text": "نهاده به سر بر ز پیروزه تاج"
  },
  {
    "poem_id": 1526,
    "vorder": 67,
    "position": 0,
    "text": "بیامد ورا تنگ در برگرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 68,
    "position": 1,
    "text": "سخنهای دیرینه اندر گرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 69,
    "position": 0,
    "text": "بدانست قیصر که گشتاسپ اوست"
  },
  {
    "poem_id": 1526,
    "vorder": 70,
    "position": 1,
    "text": "فروزندهٔ جان لهراسپ اوست"
  },
  {
    "poem_id": 1526,
    "vorder": 71,
    "position": 0,
    "text": "فراوانش بستود و بردش نماز"
  },
  {
    "poem_id": 1526,
    "vorder": 72,
    "position": 1,
    "text": "وزانجا سوی تخت رفتند باز"
  },
  {
    "poem_id": 1526,
    "vorder": 73,
    "position": 0,
    "text": "ازان کردهٔ خویش پوزش گرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 74,
    "position": 1,
    "text": "بپیچید زان روزگار شگفت"
  },
  {
    "poem_id": 1526,
    "vorder": 75,
    "position": 0,
    "text": "بپذرفت گفتار او شهریار"
  },
  {
    "poem_id": 1526,
    "vorder": 76,
    "position": 1,
    "text": "سرش را گرفت آنگهی برکنار"
  },
  {
    "poem_id": 1526,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت چون تیره گردد هوا"
  },
  {
    "poem_id": 1526,
    "vorder": 78,
    "position": 1,
    "text": "فروزیدن شمع باشد روا"
  },
  {
    "poem_id": 1526,
    "vorder": 79,
    "position": 0,
    "text": "بر ما فرست آنک ما را گزید"
  },
  {
    "poem_id": 1526,
    "vorder": 80,
    "position": 1,
    "text": "که او درد و رنج فراوان کشید"
  },
  {
    "poem_id": 1526,
    "vorder": 81,
    "position": 0,
    "text": "بشد قیصر و رنج و تشویر برد"
  },
  {
    "poem_id": 1526,
    "vorder": 82,
    "position": 1,
    "text": "بسی نیز بر خوی بد برشمرد"
  },
  {
    "poem_id": 1526,
    "vorder": 83,
    "position": 0,
    "text": "به سوی کتایون فرستاد گنج"
  },
  {
    "poem_id": 1526,
    "vorder": 84,
    "position": 1,
    "text": "یکی افسر و سرخ یاقوت پنج"
  },
  {
    "poem_id": 1526,
    "vorder": 85,
    "position": 0,
    "text": "غلام و پرستار رومی هزار"
  },
  {
    "poem_id": 1526,
    "vorder": 86,
    "position": 1,
    "text": "یکی طوق پر گوهر شاهوار"
  },
  {
    "poem_id": 1526,
    "vorder": 87,
    "position": 0,
    "text": "ز دینار رومی شتروار پنج"
  },
  {
    "poem_id": 1526,
    "vorder": 88,
    "position": 1,
    "text": "یکی فیلسوفی نگهبان گنج"
  },
  {
    "poem_id": 1526,
    "vorder": 89,
    "position": 0,
    "text": "سلیح و درم داد لشکرش را"
  },
  {
    "poem_id": 1526,
    "vorder": 90,
    "position": 1,
    "text": "همان نامداران کشورش را"
  },
  {
    "poem_id": 1526,
    "vorder": 91,
    "position": 0,
    "text": "هرانکس که بود او ز تخم بزرگ"
  },
  {
    "poem_id": 1526,
    "vorder": 92,
    "position": 1,
    "text": "وگر تیغ زن نامداری سترگ"
  },
  {
    "poem_id": 1526,
    "vorder": 93,
    "position": 0,
    "text": "بیاراست خلعت سزاوارشان"
  },
  {
    "poem_id": 1526,
    "vorder": 94,
    "position": 1,
    "text": "برافرخت پژمرده بازارشان"
  },
  {
    "poem_id": 1526,
    "vorder": 95,
    "position": 0,
    "text": "از اسپان تازی و برگستوان"
  },
  {
    "poem_id": 1526,
    "vorder": 96,
    "position": 1,
    "text": "ز خفتان وز جامهٔ هندوان"
  },
  {
    "poem_id": 1526,
    "vorder": 97,
    "position": 0,
    "text": "ز دیبا و دینار و تاج و نگین"
  },
  {
    "poem_id": 1526,
    "vorder": 98,
    "position": 1,
    "text": "ز تخت و ز هرگونه دیبای چین"
  },
  {
    "poem_id": 1526,
    "vorder": 99,
    "position": 0,
    "text": "فرستاده نزدیک گشتاسپ برد"
  },
  {
    "poem_id": 1526,
    "vorder": 100,
    "position": 1,
    "text": "یکایک به گنجور او برشمرد"
  },
  {
    "poem_id": 1526,
    "vorder": 101,
    "position": 0,
    "text": "ابا این بسی آفرین گسترید"
  },
  {
    "poem_id": 1526,
    "vorder": 102,
    "position": 1,
    "text": "بران کو زمان و زمین آفرید"
  },
  {
    "poem_id": 1526,
    "vorder": 103,
    "position": 0,
    "text": "کتایون چو آمد به نزدیک شاه"
  },
  {
    "poem_id": 1526,
    "vorder": 104,
    "position": 1,
    "text": "غو کوس برخاست از بارگاه"
  },
  {
    "poem_id": 1526,
    "vorder": 105,
    "position": 0,
    "text": "سپه سوی ایران برفتن گرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 106,
    "position": 1,
    "text": "هوا گرد اسپان نهفتن گرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 107,
    "position": 0,
    "text": "چو قیصر دو منزل بیامد به راه"
  },
  {
    "poem_id": 1526,
    "vorder": 108,
    "position": 1,
    "text": "عنان تگاور بپیچید شاه"
  },
  {
    "poem_id": 1526,
    "vorder": 109,
    "position": 0,
    "text": "به سوگند ازان مرز برگاشتش"
  },
  {
    "poem_id": 1526,
    "vorder": 110,
    "position": 1,
    "text": "به خواهش سوی روم بگذاشتش"
  },
  {
    "poem_id": 1526,
    "vorder": 111,
    "position": 0,
    "text": "وزان جایگه شد سوی روم باز"
  },
  {
    "poem_id": 1526,
    "vorder": 112,
    "position": 1,
    "text": "چو گشتاسپ شد سوی راه دراز"
  },
  {
    "poem_id": 1526,
    "vorder": 113,
    "position": 0,
    "text": "همی راند تا سوی ایران رسید"
  },
  {
    "poem_id": 1526,
    "vorder": 114,
    "position": 1,
    "text": "به نزد دلیران و شیران رسید"
  },
  {
    "poem_id": 1526,
    "vorder": 115,
    "position": 0,
    "text": "چو بشنید لهراسپ کامد زریر"
  },
  {
    "poem_id": 1526,
    "vorder": 116,
    "position": 1,
    "text": "برادرش گشتاسپ آن نره شیر"
  },
  {
    "poem_id": 1526,
    "vorder": 117,
    "position": 0,
    "text": "پذیره شدش با همه مهتران"
  },
  {
    "poem_id": 1526,
    "vorder": 118,
    "position": 1,
    "text": "بزرگان ایران و نام‌آوران"
  },
  {
    "poem_id": 1526,
    "vorder": 119,
    "position": 0,
    "text": "چو دید او پسر را به بر درگرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 120,
    "position": 1,
    "text": "ز جور فلک دست بر سر گرفت"
  },
  {
    "poem_id": 1526,
    "vorder": 121,
    "position": 0,
    "text": "فرود آمد از باره گشتاسپ زود"
  },
  {
    "poem_id": 1526,
    "vorder": 122,
    "position": 1,
    "text": "بدو آفرین کرد و زاری نمود"
  },
  {
    "poem_id": 1526,
    "vorder": 123,
    "position": 0,
    "text": "ز ره چو به ایوان شاهی شدند"
  },
  {
    "poem_id": 1526,
    "vorder": 124,
    "position": 1,
    "text": "چو خورشید در برج ماهی شدند"
  },
  {
    "poem_id": 1526,
    "vorder": 125,
    "position": 0,
    "text": "بدو گفت لهراسپ کز من مبین"
  },
  {
    "poem_id": 1526,
    "vorder": 126,
    "position": 1,
    "text": "چنین بود رای جهان آفرین"
  },
  {
    "poem_id": 1526,
    "vorder": 127,
    "position": 0,
    "text": "نوشته چنین بد مگر بر سرت"
  },
  {
    "poem_id": 1526,
    "vorder": 128,
    "position": 1,
    "text": "که پردخت ماند ز تو کشورت"
  },
  {
    "poem_id": 1526,
    "vorder": 129,
    "position": 0,
    "text": "بدو شادمان گشت لهراسپ شاه"
  },
  {
    "poem_id": 1526,
    "vorder": 130,
    "position": 1,
    "text": "مر او را نشاند از بر تخت و گاه"
  },
  {
    "poem_id": 1526,
    "vorder": 131,
    "position": 0,
    "text": "ببوسید و تاجش به سر بر نهاد"
  },
  {
    "poem_id": 1526,
    "vorder": 132,
    "position": 1,
    "text": "همی آفرین کرد با تاج یاد"
  },
  {
    "poem_id": 1526,
    "vorder": 133,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای شهریار"
  },
  {
    "poem_id": 1526,
    "vorder": 134,
    "position": 1,
    "text": "ابی تو مبیناد کس روزگار"
  },
  {
    "poem_id": 1526,
    "vorder": 135,
    "position": 0,
    "text": "چو مهتر کنی من ترا کهترم"
  },
  {
    "poem_id": 1526,
    "vorder": 136,
    "position": 1,
    "text": "بکوشم که گرد ترا نسپرم"
  },
  {
    "poem_id": 1526,
    "vorder": 137,
    "position": 0,
    "text": "همه نیک بادا سرانجام تو"
  },
  {
    "poem_id": 1526,
    "vorder": 138,
    "position": 1,
    "text": "مبادا که باشیم بی‌نام تو"
  },
  {
    "poem_id": 1526,
    "vorder": 139,
    "position": 0,
    "text": "که گیتی نماند همی بر کسی"
  },
  {
    "poem_id": 1526,
    "vorder": 140,
    "position": 1,
    "text": "چو ماند به تن رنج ماند بسی"
  },
  {
    "poem_id": 1526,
    "vorder": 141,
    "position": 0,
    "text": "چنین است گیهان ناپایدار"
  },
  {
    "poem_id": 1526,
    "vorder": 142,
    "position": 1,
    "text": "برو تخم بد تا توانی مکار"
  },
  {
    "poem_id": 1526,
    "vorder": 143,
    "position": 0,
    "text": "همی خواهم از دادگر یک خدای"
  },
  {
    "poem_id": 1526,
    "vorder": 144,
    "position": 1,
    "text": "که چندان بمانم به گیتی به جای"
  },
  {
    "poem_id": 1526,
    "vorder": 145,
    "position": 0,
    "text": "که این نامهٔ شهریاران پیش"
  },
  {
    "poem_id": 1526,
    "vorder": 146,
    "position": 1,
    "text": "بپیوندم از خوب گفتار خویش"
  },
  {
    "poem_id": 1526,
    "vorder": 147,
    "position": 0,
    "text": "ازان پس تن جانور خاک راست"
  },
  {
    "poem_id": 1526,
    "vorder": 148,
    "position": 1,
    "text": "سخن گوی جان معدن پاک راست"
  }
