[
  {
    "poem_id": 1696,
    "vorder": 1,
    "position": 0,
    "text": "وزین سو به دریا رسید اردشیر"
  },
  {
    "poem_id": 1696,
    "vorder": 2,
    "position": 1,
    "text": "به یزدان چنین گفت کای دستگیر"
  },
  {
    "poem_id": 1696,
    "vorder": 3,
    "position": 0,
    "text": "تو کردی مرا ایمن از بدکنش"
  },
  {
    "poem_id": 1696,
    "vorder": 4,
    "position": 1,
    "text": "که هرگز مبیناد نیکی تنش"
  },
  {
    "poem_id": 1696,
    "vorder": 5,
    "position": 0,
    "text": "برآسود و ملاح را پیش خواند"
  },
  {
    "poem_id": 1696,
    "vorder": 6,
    "position": 1,
    "text": "ز کار گذشته فراوان براند"
  },
  {
    "poem_id": 1696,
    "vorder": 7,
    "position": 0,
    "text": "نگه کرد فرزانه ملاح پیر"
  },
  {
    "poem_id": 1696,
    "vorder": 8,
    "position": 1,
    "text": "به بالا و چهر و بر اردشیر"
  },
  {
    "poem_id": 1696,
    "vorder": 9,
    "position": 0,
    "text": "بدانست کو نیست جز کی نژاد"
  },
  {
    "poem_id": 1696,
    "vorder": 10,
    "position": 1,
    "text": "ز فر و ز اورنگ او گشت شاد"
  },
  {
    "poem_id": 1696,
    "vorder": 11,
    "position": 0,
    "text": "بیامد به دریا هم اندر شتاب"
  },
  {
    "poem_id": 1696,
    "vorder": 12,
    "position": 1,
    "text": "به هر سو برافگند زورق به آب"
  },
  {
    "poem_id": 1696,
    "vorder": 13,
    "position": 0,
    "text": "ز آگاهی نامدار اردشیر"
  },
  {
    "poem_id": 1696,
    "vorder": 14,
    "position": 1,
    "text": "سپاه انجمن شد بران آبگیر"
  },
  {
    "poem_id": 1696,
    "vorder": 15,
    "position": 0,
    "text": "هرانکس که بد بابکی در صطخر"
  },
  {
    "poem_id": 1696,
    "vorder": 16,
    "position": 1,
    "text": "به آگاهی شاه کردند فخر"
  },
  {
    "poem_id": 1696,
    "vorder": 17,
    "position": 0,
    "text": "دگر هرک از تخم دارا بدند"
  },
  {
    "poem_id": 1696,
    "vorder": 18,
    "position": 1,
    "text": "به هر کشوری نامدارا بدند"
  },
  {
    "poem_id": 1696,
    "vorder": 19,
    "position": 0,
    "text": "چو آگاهی آمد ز شاه اردشیر"
  },
  {
    "poem_id": 1696,
    "vorder": 20,
    "position": 1,
    "text": "ز شادی جوان شد دل مرد پیر"
  },
  {
    "poem_id": 1696,
    "vorder": 21,
    "position": 0,
    "text": "همی رفت مردم ز دریا و کوه"
  },
  {
    "poem_id": 1696,
    "vorder": 22,
    "position": 1,
    "text": "به نزدیک برنا گروها گروه"
  },
  {
    "poem_id": 1696,
    "vorder": 23,
    "position": 0,
    "text": "ز هر شهر فرزانه‌ای رای‌زن"
  },
  {
    "poem_id": 1696,
    "vorder": 24,
    "position": 1,
    "text": "به نزد جهانجوی گشت انجمن"
  },
  {
    "poem_id": 1696,
    "vorder": 25,
    "position": 0,
    "text": "زبان برگشاد اردشیر جوان"
  },
  {
    "poem_id": 1696,
    "vorder": 26,
    "position": 1,
    "text": "که ای نامداران روشن‌روان"
  },
  {
    "poem_id": 1696,
    "vorder": 27,
    "position": 0,
    "text": "کسی نیست زین نامدار انجمن"
  },
  {
    "poem_id": 1696,
    "vorder": 28,
    "position": 1,
    "text": "ز فرزانه و مردم رای‌زن"
  },
  {
    "poem_id": 1696,
    "vorder": 29,
    "position": 0,
    "text": "که نشنید کاسکندر بدگمان"
  },
  {
    "poem_id": 1696,
    "vorder": 30,
    "position": 1,
    "text": "چه کرد از فرومایگی در جهان"
  },
  {
    "poem_id": 1696,
    "vorder": 31,
    "position": 0,
    "text": "نیاکان ما را یکایک بکشت"
  },
  {
    "poem_id": 1696,
    "vorder": 32,
    "position": 1,
    "text": "به بیدادی آورد گیتی به مشت"
  },
  {
    "poem_id": 1696,
    "vorder": 33,
    "position": 0,
    "text": "چو من باشم از تخم اسفندیار"
  },
  {
    "poem_id": 1696,
    "vorder": 34,
    "position": 1,
    "text": "به مرز اندرون اردوان شهریار"
  },
  {
    "poem_id": 1696,
    "vorder": 35,
    "position": 0,
    "text": "سزد گرد مر این را نخوانیم داد"
  },
  {
    "poem_id": 1696,
    "vorder": 36,
    "position": 1,
    "text": "وزین داستان کس نگیریم یاد"
  },
  {
    "poem_id": 1696,
    "vorder": 37,
    "position": 0,
    "text": "چو باشید با من بدین یارمند"
  },
  {
    "poem_id": 1696,
    "vorder": 38,
    "position": 1,
    "text": "نمانم به کس نام و تخت بلند"
  },
  {
    "poem_id": 1696,
    "vorder": 39,
    "position": 0,
    "text": "چه گویید و این را چه پاسخ دهید"
  },
  {
    "poem_id": 1696,
    "vorder": 40,
    "position": 1,
    "text": "که پاسخ به آواز فرخ نهید"
  },
  {
    "poem_id": 1696,
    "vorder": 41,
    "position": 0,
    "text": "هرانکس که بود اندر آن انجمن"
  },
  {
    "poem_id": 1696,
    "vorder": 42,
    "position": 1,
    "text": "ز شمشیر زن مرد و از رای‌زن"
  },
  {
    "poem_id": 1696,
    "vorder": 43,
    "position": 0,
    "text": "چو آواز بشنید بر پای خاست"
  },
  {
    "poem_id": 1696,
    "vorder": 44,
    "position": 1,
    "text": "همه راز دل بازگفتند راست"
  },
  {
    "poem_id": 1696,
    "vorder": 45,
    "position": 0,
    "text": "که هرکس که هستیم بابک‌نژاد"
  },
  {
    "poem_id": 1696,
    "vorder": 46,
    "position": 1,
    "text": "به دیدار و چهر تو گشتیم شاد"
  },
  {
    "poem_id": 1696,
    "vorder": 47,
    "position": 0,
    "text": "و دیگر که هستیم ساسانیان"
  },
  {
    "poem_id": 1696,
    "vorder": 48,
    "position": 1,
    "text": "ببندیم کین را کمر بر میان"
  },
  {
    "poem_id": 1696,
    "vorder": 49,
    "position": 0,
    "text": "تن و جان ما سربسر پیش تست"
  },
  {
    "poem_id": 1696,
    "vorder": 50,
    "position": 1,
    "text": "غم و شادمانی به کم بیش تست"
  },
  {
    "poem_id": 1696,
    "vorder": 51,
    "position": 0,
    "text": "به دو گوهر از هرکسی برتری"
  },
  {
    "poem_id": 1696,
    "vorder": 52,
    "position": 1,
    "text": "سزد بر تو شاهی و کنداوری"
  },
  {
    "poem_id": 1696,
    "vorder": 53,
    "position": 0,
    "text": "به فرمان تو کوه هامون کنیم"
  },
  {
    "poem_id": 1696,
    "vorder": 54,
    "position": 1,
    "text": "به تیغ آب دریا همه خون کنیم"
  },
  {
    "poem_id": 1696,
    "vorder": 55,
    "position": 0,
    "text": "چو پاسخ بدان گونه دید اردشیر"
  },
  {
    "poem_id": 1696,
    "vorder": 56,
    "position": 1,
    "text": "سرش برتر آمد ز ناهید و تیر"
  },
  {
    "poem_id": 1696,
    "vorder": 57,
    "position": 0,
    "text": "بران مهتران آفرین گسترید"
  },
  {
    "poem_id": 1696,
    "vorder": 58,
    "position": 1,
    "text": "به دل در ز اندیشه کین گسترید"
  },
  {
    "poem_id": 1696,
    "vorder": 59,
    "position": 0,
    "text": "به نزدیک دریا یکی شارستان"
  },
  {
    "poem_id": 1696,
    "vorder": 60,
    "position": 1,
    "text": "پی‌افگند و شد شارستان کارستان"
  },
  {
    "poem_id": 1696,
    "vorder": 61,
    "position": 0,
    "text": "یکی موبدی گفت با اردشیر"
  },
  {
    "poem_id": 1696,
    "vorder": 62,
    "position": 1,
    "text": "که ای شاه نیک‌اختر و دلپذیر"
  },
  {
    "poem_id": 1696,
    "vorder": 63,
    "position": 0,
    "text": "سر شهریاری همی نو کنی"
  },
  {
    "poem_id": 1696,
    "vorder": 64,
    "position": 1,
    "text": "بر پارس باید که بی‌خو کنی"
  },
  {
    "poem_id": 1696,
    "vorder": 65,
    "position": 0,
    "text": "ازان پس کنی رزم با اردوان"
  },
  {
    "poem_id": 1696,
    "vorder": 66,
    "position": 1,
    "text": "که اختر جوانست و خسرو جوان"
  },
  {
    "poem_id": 1696,
    "vorder": 67,
    "position": 0,
    "text": "که او از ملوک طوایف به گنج"
  },
  {
    "poem_id": 1696,
    "vorder": 68,
    "position": 1,
    "text": "فزونست و زو دیدی آزار و رنج"
  },
  {
    "poem_id": 1696,
    "vorder": 69,
    "position": 0,
    "text": "چو برداشتی گاه او را ز جای"
  },
  {
    "poem_id": 1696,
    "vorder": 70,
    "position": 1,
    "text": "ندارد کسی زین سپس با تو پای"
  },
  {
    "poem_id": 1696,
    "vorder": 71,
    "position": 0,
    "text": "چو بشنید گردن فراز اردشیر"
  },
  {
    "poem_id": 1696,
    "vorder": 72,
    "position": 1,
    "text": "سخنهای بایسته و دلپذیر"
  },
  {
    "poem_id": 1696,
    "vorder": 73,
    "position": 0,
    "text": "چو برزد سر از تیغ کوه آفتاب"
  },
  {
    "poem_id": 1696,
    "vorder": 74,
    "position": 1,
    "text": "به سوی صطخر آمد از پیش آب"
  },
  {
    "poem_id": 1696,
    "vorder": 75,
    "position": 0,
    "text": "خبر شد بر بهمن اردوان"
  },
  {
    "poem_id": 1696,
    "vorder": 76,
    "position": 1,
    "text": "دلش گشت پردرد و تیره‌روان"
  },
  {
    "poem_id": 1696,
    "vorder": 77,
    "position": 0,
    "text": "نکرد ایچ بر تخت شاهی درنگ"
  },
  {
    "poem_id": 1696,
    "vorder": 78,
    "position": 1,
    "text": "سپاهی بیاورد با ساز جنگ"
  }
]