[
  {
    "poem_id": 1616,
    "vorder": 1,
    "position": 0,
    "text": "غمی شد فرامرز در مرز بست"
  },
  {
    "poem_id": 1616,
    "vorder": 2,
    "position": 1,
    "text": "ز در دنیا دست کین را بشست"
  },
  {
    "poem_id": 1616,
    "vorder": 3,
    "position": 0,
    "text": "همه نامداران روشن‌روان"
  },
  {
    "poem_id": 1616,
    "vorder": 4,
    "position": 1,
    "text": "برفتند یکسر بر پهلوان"
  },
  {
    "poem_id": 1616,
    "vorder": 5,
    "position": 0,
    "text": "بدان نامداران زبان برگشاد"
  },
  {
    "poem_id": 1616,
    "vorder": 6,
    "position": 1,
    "text": "ز گفت زواره بسی کرد یاد"
  },
  {
    "poem_id": 1616,
    "vorder": 7,
    "position": 0,
    "text": "که پیش پدرم آن جهاندیده مرد"
  },
  {
    "poem_id": 1616,
    "vorder": 8,
    "position": 1,
    "text": "همی گفت و لبها پر از بادسرد"
  },
  {
    "poem_id": 1616,
    "vorder": 9,
    "position": 0,
    "text": "که بهمن ز ما کین اسفندیار"
  },
  {
    "poem_id": 1616,
    "vorder": 10,
    "position": 1,
    "text": "بخواهد تو این را به بازی مدار"
  },
  {
    "poem_id": 1616,
    "vorder": 11,
    "position": 0,
    "text": "پدرم آن جهاندیدهٔ نامور"
  },
  {
    "poem_id": 1616,
    "vorder": 12,
    "position": 1,
    "text": "ز گفت زواره بپیچید سر"
  },
  {
    "poem_id": 1616,
    "vorder": 13,
    "position": 0,
    "text": "نپذرفت و نشنید اندرز او"
  },
  {
    "poem_id": 1616,
    "vorder": 14,
    "position": 1,
    "text": "ازو گشت ویران کنون مرز او"
  },
  {
    "poem_id": 1616,
    "vorder": 15,
    "position": 0,
    "text": "نیا چون گذشت او به شاهی رسید"
  },
  {
    "poem_id": 1616,
    "vorder": 16,
    "position": 1,
    "text": "سر تاج شاهی به ماهی رسید"
  },
  {
    "poem_id": 1616,
    "vorder": 17,
    "position": 0,
    "text": "کنون بهمن نامور شهریار"
  },
  {
    "poem_id": 1616,
    "vorder": 18,
    "position": 1,
    "text": "همی نو کند کین اسفندیار"
  },
  {
    "poem_id": 1616,
    "vorder": 19,
    "position": 0,
    "text": "هم از کین مهر آن سوار دلیر"
  },
  {
    "poem_id": 1616,
    "vorder": 20,
    "position": 1,
    "text": "ز نوش‌آذر آن گرد درنده شیر"
  },
  {
    "poem_id": 1616,
    "vorder": 21,
    "position": 0,
    "text": "کنون خواهد از ما همی کین‌شان"
  },
  {
    "poem_id": 1616,
    "vorder": 22,
    "position": 1,
    "text": "به جای آورد کین و آیین‌شان"
  },
  {
    "poem_id": 1616,
    "vorder": 23,
    "position": 0,
    "text": "ز ایران سپاهی چو ابر سیاه"
  },
  {
    "poem_id": 1616,
    "vorder": 24,
    "position": 1,
    "text": "بیاورد نزدیک ما کینه‌خواه"
  },
  {
    "poem_id": 1616,
    "vorder": 25,
    "position": 0,
    "text": "نیای من آن نامدار بلند"
  },
  {
    "poem_id": 1616,
    "vorder": 26,
    "position": 1,
    "text": "گرفت و به زنجیر کردش به بند"
  },
  {
    "poem_id": 1616,
    "vorder": 27,
    "position": 0,
    "text": "که بودی سپر پیش ایرانیان"
  },
  {
    "poem_id": 1616,
    "vorder": 28,
    "position": 1,
    "text": "به مردی بهر کینه بسته میان"
  },
  {
    "poem_id": 1616,
    "vorder": 29,
    "position": 0,
    "text": "چه آمد بدین نامور دودمان"
  },
  {
    "poem_id": 1616,
    "vorder": 30,
    "position": 1,
    "text": "که آید ز هر سو بمابر زیان"
  },
  {
    "poem_id": 1616,
    "vorder": 31,
    "position": 0,
    "text": "پدر کشته و بند سایه نیا"
  },
  {
    "poem_id": 1616,
    "vorder": 32,
    "position": 1,
    "text": "به مغز اندرون خون بود کیمیا"
  },
  {
    "poem_id": 1616,
    "vorder": 33,
    "position": 0,
    "text": "به تاراج داده همه مرز خویش"
  },
  {
    "poem_id": 1616,
    "vorder": 34,
    "position": 1,
    "text": "نبینم سر مایهٔ ارز خویش"
  },
  {
    "poem_id": 1616,
    "vorder": 35,
    "position": 0,
    "text": "شما نیز یکسر چه گویید باز"
  },
  {
    "poem_id": 1616,
    "vorder": 36,
    "position": 1,
    "text": "هرانکس که هستید گردن‌فراز"
  },
  {
    "poem_id": 1616,
    "vorder": 37,
    "position": 0,
    "text": "بگفتند کای گرد روشن‌روان"
  },
  {
    "poem_id": 1616,
    "vorder": 38,
    "position": 1,
    "text": "پدر بر پدر بر توی پهلوان"
  },
  {
    "poem_id": 1616,
    "vorder": 39,
    "position": 0,
    "text": "همه یک به یک پیش تو بنده‌ایم"
  },
  {
    "poem_id": 1616,
    "vorder": 40,
    "position": 1,
    "text": "برای و به فرمان تو زنده‌ایم"
  },
  {
    "poem_id": 1616,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید پوشید خفتان جنگ"
  },
  {
    "poem_id": 1616,
    "vorder": 42,
    "position": 1,
    "text": "دلی پر ز کینه سری پر ز ننگ"
  },
  {
    "poem_id": 1616,
    "vorder": 43,
    "position": 0,
    "text": "سپه کرد و سر سوی بهمن نهاد"
  },
  {
    "poem_id": 1616,
    "vorder": 44,
    "position": 1,
    "text": "ز رزم تهمتن بسی کرد یاد"
  },
  {
    "poem_id": 1616,
    "vorder": 45,
    "position": 0,
    "text": "چو نزدیک بهمن رسید آگهی"
  },
  {
    "poem_id": 1616,
    "vorder": 46,
    "position": 1,
    "text": "برآشفت بر تخت شاهنشهی"
  },
  {
    "poem_id": 1616,
    "vorder": 47,
    "position": 0,
    "text": "بنه برنهاد و سپه برنشاند"
  },
  {
    "poem_id": 1616,
    "vorder": 48,
    "position": 1,
    "text": "به غور اندر آمد دو هفته بماند"
  },
  {
    "poem_id": 1616,
    "vorder": 49,
    "position": 0,
    "text": "فرامرز پیش آمدش با سپاه"
  },
  {
    "poem_id": 1616,
    "vorder": 50,
    "position": 1,
    "text": "جهان شد ز گرد سواران سپاه"
  },
  {
    "poem_id": 1616,
    "vorder": 51,
    "position": 0,
    "text": "وزان روی بهمن صفی برکشید"
  },
  {
    "poem_id": 1616,
    "vorder": 52,
    "position": 1,
    "text": "که خورشید تابان زمین را ندید"
  },
  {
    "poem_id": 1616,
    "vorder": 53,
    "position": 0,
    "text": "ز آواز شیپور و هندی درای"
  },
  {
    "poem_id": 1616,
    "vorder": 54,
    "position": 1,
    "text": "همی کوه را دل برآمد ز جای"
  },
  {
    "poem_id": 1616,
    "vorder": 55,
    "position": 0,
    "text": "بشست آسمان روی گیتی به قیر"
  },
  {
    "poem_id": 1616,
    "vorder": 56,
    "position": 1,
    "text": "ببارید چون ژاله از ابر تیر"
  },
  {
    "poem_id": 1616,
    "vorder": 57,
    "position": 0,
    "text": "ز چاک تبرزین و جر کمان"
  },
  {
    "poem_id": 1616,
    "vorder": 58,
    "position": 1,
    "text": "زمین گشت جنبان‌تر از آسمان"
  },
  {
    "poem_id": 1616,
    "vorder": 59,
    "position": 0,
    "text": "سه روز و سه شب هم برین رزمگاه"
  },
  {
    "poem_id": 1616,
    "vorder": 60,
    "position": 1,
    "text": "به رخشنده روز و به تابنده ماه"
  },
  {
    "poem_id": 1616,
    "vorder": 61,
    "position": 0,
    "text": "همی گرز بارید و پولاد تیغ"
  },
  {
    "poem_id": 1616,
    "vorder": 62,
    "position": 1,
    "text": "ز گرد سپاه آسمان گشت میغ"
  },
  {
    "poem_id": 1616,
    "vorder": 63,
    "position": 0,
    "text": "به روز چهارم یکی باد خاست"
  },
  {
    "poem_id": 1616,
    "vorder": 64,
    "position": 1,
    "text": "تو گفتی که با روز شب گشت راست"
  },
  {
    "poem_id": 1616,
    "vorder": 65,
    "position": 0,
    "text": "به سوی فرامرز برگشت باد"
  },
  {
    "poem_id": 1616,
    "vorder": 66,
    "position": 1,
    "text": "جهاندار گشت از دم باد شاد"
  },
  {
    "poem_id": 1616,
    "vorder": 67,
    "position": 0,
    "text": "همی شد پس گرد با تیغ تیز"
  },
  {
    "poem_id": 1616,
    "vorder": 68,
    "position": 1,
    "text": "برآورد زان انجمن رستخیز"
  },
  {
    "poem_id": 1616,
    "vorder": 69,
    "position": 0,
    "text": "ز بستی و از لشکر زابلی"
  },
  {
    "poem_id": 1616,
    "vorder": 70,
    "position": 1,
    "text": "ز گردان شمشیر زن کابلی"
  },
  {
    "poem_id": 1616,
    "vorder": 71,
    "position": 0,
    "text": "برآوردگه بر سواری نماند"
  },
  {
    "poem_id": 1616,
    "vorder": 72,
    "position": 1,
    "text": "وزان سرکشان نامداری نماند"
  },
  {
    "poem_id": 1616,
    "vorder": 73,
    "position": 0,
    "text": "همه سربسر پشت برگاشتند"
  },
  {
    "poem_id": 1616,
    "vorder": 74,
    "position": 1,
    "text": "فرامرز را خوار بگذاشتند"
  },
  {
    "poem_id": 1616,
    "vorder": 75,
    "position": 0,
    "text": "همه رزمگه کشته چون کوه کوه"
  },
  {
    "poem_id": 1616,
    "vorder": 76,
    "position": 1,
    "text": "به هم برفگنده ز هر دو گروه"
  },
  {
    "poem_id": 1616,
    "vorder": 77,
    "position": 0,
    "text": "فرامرز با اندکی رزمجوی"
  },
  {
    "poem_id": 1616,
    "vorder": 78,
    "position": 1,
    "text": "به مردی به روی اندر آورد روی"
  },
  {
    "poem_id": 1616,
    "vorder": 79,
    "position": 0,
    "text": "همه تنش پر زخم شمشیر بود"
  },
  {
    "poem_id": 1616,
    "vorder": 80,
    "position": 1,
    "text": "که فرزند شیران بد و شیر بود"
  },
  {
    "poem_id": 1616,
    "vorder": 81,
    "position": 0,
    "text": "سرانجام بر دست یاز اردشیر"
  },
  {
    "poem_id": 1616,
    "vorder": 82,
    "position": 1,
    "text": "گرفتار شد نامدار دلیر"
  },
  {
    "poem_id": 1616,
    "vorder": 83,
    "position": 0,
    "text": "بر بهمن آوردش از رزمگاه"
  },
  {
    "poem_id": 1616,
    "vorder": 84,
    "position": 1,
    "text": "بدو کرد کین‌دار چندی نگاه"
  },
  {
    "poem_id": 1616,
    "vorder": 85,
    "position": 0,
    "text": "چو دیدش ندادش به جان زینهار"
  },
  {
    "poem_id": 1616,
    "vorder": 86,
    "position": 1,
    "text": "بفرمود داری زدن شهریار"
  },
  {
    "poem_id": 1616,
    "vorder": 87,
    "position": 0,
    "text": "فرامرز را زنده بر دار کرد"
  },
  {
    "poem_id": 1616,
    "vorder": 88,
    "position": 1,
    "text": "تن پیلوارش نگونسار کرد"
  },
  {
    "poem_id": 1616,
    "vorder": 89,
    "position": 0,
    "text": "ازان پس بفرمود شاه اردشیر"
  },
  {
    "poem_id": 1616,
    "vorder": 90,
    "position": 1,
    "text": "که کشتند او را به باران تیر"
  }
]