[
  {
    "poem_id": 88012,
    "vorder": 1,
    "position": 0,
    "text": "چو بگذشت یک چندگاه این چنین"
  },
  {
    "poem_id": 88012,
    "vorder": 2,
    "position": 1,
    "text": "پس آگاهی آمد بدربان ازین"
  },
  {
    "poem_id": 88012,
    "vorder": 3,
    "position": 0,
    "text": "نهفته همه کارشان بازجست"
  },
  {
    "poem_id": 88012,
    "vorder": 4,
    "position": 1,
    "text": "بژرفی نگه کرد کار از نخست"
  },
  {
    "poem_id": 88012,
    "vorder": 5,
    "position": 0,
    "text": "کسی کز گزافه سخن راندا"
  },
  {
    "poem_id": 88012,
    "vorder": 6,
    "position": 1,
    "text": "درخت بلا را بجنباندا"
  },
  {
    "poem_id": 88012,
    "vorder": 7,
    "position": 0,
    "text": "نگه کرد کو کیست و شهرش کجاست"
  },
  {
    "poem_id": 88012,
    "vorder": 8,
    "position": 1,
    "text": "بدین آمدن سوی توران چراست"
  },
  {
    "poem_id": 88012,
    "vorder": 9,
    "position": 0,
    "text": "بدانست و ترسان شد از جان خویش"
  },
  {
    "poem_id": 88012,
    "vorder": 10,
    "position": 1,
    "text": "شتابید نزدیک درمان خویش"
  },
  {
    "poem_id": 88012,
    "vorder": 11,
    "position": 0,
    "text": "جز آگاه کردن ندید ایچ رای"
  },
  {
    "poem_id": 88012,
    "vorder": 12,
    "position": 1,
    "text": "دوان از پس پرده برداشت پای"
  },
  {
    "poem_id": 88012,
    "vorder": 13,
    "position": 0,
    "text": "بیامد بر شاه ترکان بگفت"
  },
  {
    "poem_id": 88012,
    "vorder": 14,
    "position": 1,
    "text": "که دختت ز ایران گزیدست جفت"
  },
  {
    "poem_id": 88012,
    "vorder": 15,
    "position": 0,
    "text": "جهانجوی کرد از جهاندار یاد"
  },
  {
    "poem_id": 88012,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی که بیدست هنگام باد"
  },
  {
    "poem_id": 88012,
    "vorder": 17,
    "position": 0,
    "text": "بدست از مژه خون مژگان برفت"
  },
  {
    "poem_id": 88012,
    "vorder": 18,
    "position": 1,
    "text": "برآشفت و این داستان باز گفت"
  },
  {
    "poem_id": 88012,
    "vorder": 19,
    "position": 0,
    "text": "کرا از پس پرده دختر بود"
  },
  {
    "poem_id": 88012,
    "vorder": 20,
    "position": 1,
    "text": "اگر تاج دارد بداختر بود"
  },
  {
    "poem_id": 88012,
    "vorder": 21,
    "position": 0,
    "text": "کرا دختر آید بجای پسر"
  },
  {
    "poem_id": 88012,
    "vorder": 22,
    "position": 1,
    "text": "به از گور داماد ناید بدر"
  },
  {
    "poem_id": 88012,
    "vorder": 23,
    "position": 0,
    "text": "ز کار منیژه دلش خیره ماند"
  },
  {
    "poem_id": 88012,
    "vorder": 24,
    "position": 1,
    "text": "قراخان سالار را پیش خواند"
  },
  {
    "poem_id": 88012,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت ازین کار ناپاک زن"
  },
  {
    "poem_id": 88012,
    "vorder": 26,
    "position": 1,
    "text": "هشیوار با من یکی رای زن"
  },
  {
    "poem_id": 88012,
    "vorder": 27,
    "position": 0,
    "text": "قراخان چنین داد پاسخ بشاه"
  },
  {
    "poem_id": 88012,
    "vorder": 28,
    "position": 1,
    "text": "که در کار هشیارتر کن نگاه"
  },
  {
    "poem_id": 88012,
    "vorder": 29,
    "position": 0,
    "text": "اگر هست خود جای گفتار نیست"
  },
  {
    "poem_id": 88012,
    "vorder": 30,
    "position": 1,
    "text": "ولیکن شنیدن چو دیدار نیست"
  },
  {
    "poem_id": 88012,
    "vorder": 31,
    "position": 0,
    "text": "بگرسیوز آنگاه گفتش بدرد"
  },
  {
    "poem_id": 88012,
    "vorder": 32,
    "position": 1,
    "text": "پر از خون دل و دیده پر آب زرد"
  },
  {
    "poem_id": 88012,
    "vorder": 33,
    "position": 0,
    "text": "زمانه چرا بندد این بند من"
  },
  {
    "poem_id": 88012,
    "vorder": 34,
    "position": 1,
    "text": "غم شهر ایران و فرزند من"
  },
  {
    "poem_id": 88012,
    "vorder": 35,
    "position": 0,
    "text": "برو با سواران هشیار سر"
  },
  {
    "poem_id": 88012,
    "vorder": 36,
    "position": 1,
    "text": "نگه دار مر کاخ را بام و در"
  },
  {
    "poem_id": 88012,
    "vorder": 37,
    "position": 0,
    "text": "نگر تا که بینی بکاخ اندرا"
  },
  {
    "poem_id": 88012,
    "vorder": 38,
    "position": 1,
    "text": "ببند و کشانش بیار ایدرا"
  },
  {
    "poem_id": 88012,
    "vorder": 39,
    "position": 0,
    "text": "چو گرسیوز آمد بنزدیک در"
  },
  {
    "poem_id": 88012,
    "vorder": 40,
    "position": 1,
    "text": "از ایوان خروش آمد و نوش و خور"
  },
  {
    "poem_id": 88012,
    "vorder": 41,
    "position": 0,
    "text": "غریویدن چنگ و بانگ رباب"
  },
  {
    "poem_id": 88012,
    "vorder": 42,
    "position": 1,
    "text": "برآمد ز ایوان افراسیاب"
  },
  {
    "poem_id": 88012,
    "vorder": 43,
    "position": 0,
    "text": "سواران در و بام آن کاخ شاه"
  },
  {
    "poem_id": 88012,
    "vorder": 44,
    "position": 1,
    "text": "گرفتند و هر سو ببستند راه"
  },
  {
    "poem_id": 88012,
    "vorder": 45,
    "position": 0,
    "text": "چو گر سیوز آن کاخ در بسته دید"
  },
  {
    "poem_id": 88012,
    "vorder": 46,
    "position": 1,
    "text": "می و غلغل نوش پیوسته دید"
  },
  {
    "poem_id": 88012,
    "vorder": 47,
    "position": 0,
    "text": "سواران گرفتندگرد اندرش"
  },
  {
    "poem_id": 88012,
    "vorder": 48,
    "position": 1,
    "text": "چو سالار شد سوی بسته درش"
  },
  {
    "poem_id": 88012,
    "vorder": 49,
    "position": 0,
    "text": "بزد دست و برکند بندش ز جای"
  },
  {
    "poem_id": 88012,
    "vorder": 50,
    "position": 1,
    "text": "بجست از میان در اندر سرای"
  },
  {
    "poem_id": 88012,
    "vorder": 51,
    "position": 0,
    "text": "بیامد بنزدیک آن خانه زود"
  },
  {
    "poem_id": 88012,
    "vorder": 52,
    "position": 1,
    "text": "کجا پیشگه مرد بیگانه بود"
  },
  {
    "poem_id": 88012,
    "vorder": 53,
    "position": 0,
    "text": "ز در چون به بیژن برافگند چشم"
  },
  {
    "poem_id": 88012,
    "vorder": 54,
    "position": 1,
    "text": "بچوشید خونش برگ بر ز خشم"
  },
  {
    "poem_id": 88012,
    "vorder": 55,
    "position": 0,
    "text": "در آن خانه سیصد پرستنده بود"
  },
  {
    "poem_id": 88012,
    "vorder": 56,
    "position": 1,
    "text": "همه با رباب و نبید و سرود"
  },
  {
    "poem_id": 88012,
    "vorder": 57,
    "position": 0,
    "text": "بپیچید بر خویشتن بیژنا"
  },
  {
    "poem_id": 88012,
    "vorder": 58,
    "position": 1,
    "text": "که چون رزم سازم برهنه تنا"
  },
  {
    "poem_id": 88012,
    "vorder": 59,
    "position": 0,
    "text": "نه شبرنگ با من نه رهوار بور"
  },
  {
    "poem_id": 88012,
    "vorder": 60,
    "position": 1,
    "text": "همانا که برگشتم امروز هور"
  },
  {
    "poem_id": 88012,
    "vorder": 61,
    "position": 0,
    "text": "ز گیتی نبینم همی یار کس"
  },
  {
    "poem_id": 88012,
    "vorder": 62,
    "position": 1,
    "text": "بجز ایزدم نیست فریادرس"
  },
  {
    "poem_id": 88012,
    "vorder": 63,
    "position": 0,
    "text": "کجا گیو و گودرز کشوادگان"
  },
  {
    "poem_id": 88012,
    "vorder": 64,
    "position": 1,
    "text": "که سر داد باید همی رایگان"
  },
  {
    "poem_id": 88012,
    "vorder": 65,
    "position": 0,
    "text": "همیشه بیک ساق موزه درون"
  },
  {
    "poem_id": 88012,
    "vorder": 66,
    "position": 1,
    "text": "یکی خنجری داشتی آبگون"
  },
  {
    "poem_id": 88012,
    "vorder": 67,
    "position": 0,
    "text": "بزد دست و خنجر کشید از نیام"
  },
  {
    "poem_id": 88012,
    "vorder": 68,
    "position": 1,
    "text": "در خانه بگرفت و برگفت نام"
  },
  {
    "poem_id": 88012,
    "vorder": 69,
    "position": 0,
    "text": "که من بیژنم پور کشوادگان"
  },
  {
    "poem_id": 88012,
    "vorder": 70,
    "position": 1,
    "text": "سر پهلوانان و آزادگان"
  },
  {
    "poem_id": 88012,
    "vorder": 71,
    "position": 0,
    "text": "ندرد کسی پوست بر من مگر"
  },
  {
    "poem_id": 88012,
    "vorder": 72,
    "position": 1,
    "text": "همی سیری آید تنش را ز سر"
  },
  {
    "poem_id": 88012,
    "vorder": 73,
    "position": 0,
    "text": "وگر خیزد اندر جهان رستخیز"
  },
  {
    "poem_id": 88012,
    "vorder": 74,
    "position": 1,
    "text": "نبیند کسی پشتم اندر گریز"
  },
  {
    "poem_id": 88012,
    "vorder": 75,
    "position": 0,
    "text": "تو دانی نیاکان و شاه مرا"
  },
  {
    "poem_id": 88012,
    "vorder": 76,
    "position": 1,
    "text": "میان یلان پایگاه مرا"
  },
  {
    "poem_id": 88012,
    "vorder": 77,
    "position": 0,
    "text": "وگر جنگ سازند مر جنگ را"
  },
  {
    "poem_id": 88012,
    "vorder": 78,
    "position": 1,
    "text": "همیشه بشویم بخون چنگ را"
  },
  {
    "poem_id": 88012,
    "vorder": 79,
    "position": 0,
    "text": "ز تورانیان من بدین خنجرا"
  },
  {
    "poem_id": 88012,
    "vorder": 80,
    "position": 1,
    "text": "ببرم فراوان سران را سرا"
  },
  {
    "poem_id": 88012,
    "vorder": 81,
    "position": 0,
    "text": "گرم نزد سالار توران بری"
  },
  {
    "poem_id": 88012,
    "vorder": 82,
    "position": 1,
    "text": "بخوبی برو داستان آوری"
  },
  {
    "poem_id": 88012,
    "vorder": 83,
    "position": 0,
    "text": "تو خواهشگری کن مرا زو بخون"
  },
  {
    "poem_id": 88012,
    "vorder": 84,
    "position": 1,
    "text": "سزد گر بنیکی بوی رهنمون"
  },
  {
    "poem_id": 88012,
    "vorder": 85,
    "position": 0,
    "text": "نکرد ایچ گرسیوز آهنگ اوی"
  },
  {
    "poem_id": 88012,
    "vorder": 86,
    "position": 1,
    "text": "چو دید آن چنان تیزی چنگ اوی"
  },
  {
    "poem_id": 88012,
    "vorder": 87,
    "position": 0,
    "text": "بدانست کو راست گوید همی"
  },
  {
    "poem_id": 88012,
    "vorder": 88,
    "position": 1,
    "text": "بخون ریختن دست شوید همی"
  },
  {
    "poem_id": 88012,
    "vorder": 89,
    "position": 0,
    "text": "وفا کرد با او بسوگندها"
  },
  {
    "poem_id": 88012,
    "vorder": 90,
    "position": 1,
    "text": "بخوبی بدادش بسی پندها"
  },
  {
    "poem_id": 88012,
    "vorder": 91,
    "position": 0,
    "text": "بپیمان جدا کرد زو خنجرا"
  },
  {
    "poem_id": 88012,
    "vorder": 92,
    "position": 1,
    "text": "بخوبی کشیدش ببند اندرا"
  },
  {
    "poem_id": 88012,
    "vorder": 93,
    "position": 0,
    "text": "بیاورد بسته بکردار یوز"
  },
  {
    "poem_id": 88012,
    "vorder": 94,
    "position": 1,
    "text": "چه سود از هنرها چو برگشت روز"
  },
  {
    "poem_id": 88012,
    "vorder": 95,
    "position": 0,
    "text": "چنینست کردار این گوژپشت"
  },
  {
    "poem_id": 88012,
    "vorder": 96,
    "position": 1,
    "text": "چو نرمی بسودی بیابی درشت"
  },
  {
    "poem_id": 88012,
    "vorder": 97,
    "position": 0,
    "text": "چو آمد بنزدیک شاه اندرا"
  },
  {
    "poem_id": 88012,
    "vorder": 98,
    "position": 1,
    "text": "گو دست بسته برهنه سرا"
  },
  {
    "poem_id": 88012,
    "vorder": 99,
    "position": 0,
    "text": "برو آفرین کردکای شهریار"
  },
  {
    "poem_id": 88012,
    "vorder": 100,
    "position": 1,
    "text": "گر از من کنی راستی خواستار"
  },
  {
    "poem_id": 88012,
    "vorder": 101,
    "position": 0,
    "text": "بگویم ترا سربسر داستان"
  },
  {
    "poem_id": 88012,
    "vorder": 102,
    "position": 1,
    "text": "چو گردی بگفتار همداستان"
  },
  {
    "poem_id": 88012,
    "vorder": 103,
    "position": 0,
    "text": "نه من بزرو جستم این جشنگاه"
  },
  {
    "poem_id": 88012,
    "vorder": 104,
    "position": 1,
    "text": "نبود اندرین کار کس را گناه"
  },
  {
    "poem_id": 88012,
    "vorder": 105,
    "position": 0,
    "text": "از ایران بجنگ گراز آمدم"
  },
  {
    "poem_id": 88012,
    "vorder": 106,
    "position": 1,
    "text": "بدین جشن توران فراز آمدم"
  },
  {
    "poem_id": 88012,
    "vorder": 107,
    "position": 0,
    "text": "ز بهر یکی باز گم بوده را"
  },
  {
    "poem_id": 88012,
    "vorder": 108,
    "position": 1,
    "text": "برانداختم مهربان دوده را"
  },
  {
    "poem_id": 88012,
    "vorder": 109,
    "position": 0,
    "text": "بزیر یکی سرو رفتم بخواب"
  },
  {
    "poem_id": 88012,
    "vorder": 110,
    "position": 1,
    "text": "که تا سایه دارد مرا ز آفتاب"
  },
  {
    "poem_id": 88012,
    "vorder": 111,
    "position": 0,
    "text": "پری دربیامد بگسترد پر"
  },
  {
    "poem_id": 88012,
    "vorder": 112,
    "position": 1,
    "text": "مرا اندر آورد خفته ببر"
  },
  {
    "poem_id": 88012,
    "vorder": 113,
    "position": 0,
    "text": "از اسبم جدا کرد و شد تا براه"
  },
  {
    "poem_id": 88012,
    "vorder": 114,
    "position": 1,
    "text": "که آمد همی لشکر و دخت شاه"
  },
  {
    "poem_id": 88012,
    "vorder": 115,
    "position": 0,
    "text": "سواران پراگنده بر گرد دشت"
  },
  {
    "poem_id": 88012,
    "vorder": 116,
    "position": 1,
    "text": "چه مایه عماری بمن برگذشت"
  },
  {
    "poem_id": 88012,
    "vorder": 117,
    "position": 0,
    "text": "یکی چتر هندی برآمد ز دور"
  },
  {
    "poem_id": 88012,
    "vorder": 118,
    "position": 1,
    "text": "ز هر سو گرفته سواران تور"
  },
  {
    "poem_id": 88012,
    "vorder": 119,
    "position": 0,
    "text": "یکی کرده از عود مهدی میان"
  },
  {
    "poem_id": 88012,
    "vorder": 120,
    "position": 1,
    "text": "کشیده برو چادر پرنیان"
  },
  {
    "poem_id": 88012,
    "vorder": 121,
    "position": 0,
    "text": "بدو اندرون خفته بت پیکری"
  },
  {
    "poem_id": 88012,
    "vorder": 122,
    "position": 1,
    "text": "نهاده ببالین برش افسری"
  },
  {
    "poem_id": 88012,
    "vorder": 123,
    "position": 0,
    "text": "پری یک بیک ز اهرمن کرد یاد"
  },
  {
    "poem_id": 88012,
    "vorder": 124,
    "position": 1,
    "text": "میان سواران درآمد چو باد"
  },
  {
    "poem_id": 88012,
    "vorder": 125,
    "position": 0,
    "text": "مرا ناگهان در عماری نشاند"
  },
  {
    "poem_id": 88012,
    "vorder": 126,
    "position": 1,
    "text": "بران خوب چهره فسونی بخواند"
  },
  {
    "poem_id": 88012,
    "vorder": 127,
    "position": 0,
    "text": "که تا اندر ایوان نیامد ز خواب"
  },
  {
    "poem_id": 88012,
    "vorder": 128,
    "position": 1,
    "text": "نجنبید و من چشم کرده پر آب"
  },
  {
    "poem_id": 88012,
    "vorder": 129,
    "position": 0,
    "text": "گناهی مرا اندرین بوده نیست"
  },
  {
    "poem_id": 88012,
    "vorder": 130,
    "position": 1,
    "text": "منیژه بدین کار آلوده نیست"
  },
  {
    "poem_id": 88012,
    "vorder": 131,
    "position": 0,
    "text": "پری بی‌گمان بخت برگشته بود"
  },
  {
    "poem_id": 88012,
    "vorder": 132,
    "position": 1,
    "text": "که بر من همی جادوی آزمود"
  },
  {
    "poem_id": 88012,
    "vorder": 133,
    "position": 0,
    "text": "چنین بد که گفتم کم و بیش نه"
  },
  {
    "poem_id": 88012,
    "vorder": 134,
    "position": 1,
    "text": "مرا ایدر اکنون کس و خویش نه"
  },
  {
    "poem_id": 88012,
    "vorder": 135,
    "position": 0,
    "text": "چنین داد پاسخ پس افراسیاب"
  },
  {
    "poem_id": 88012,
    "vorder": 136,
    "position": 1,
    "text": "که بخت بدت کرد بر تو شتاب"
  },
  {
    "poem_id": 88012,
    "vorder": 137,
    "position": 0,
    "text": "تو آنی کز ایران بتیغ و کمند"
  },
  {
    "poem_id": 88012,
    "vorder": 138,
    "position": 1,
    "text": "همی رزم جستی به نام بلند"
  },
  {
    "poem_id": 88012,
    "vorder": 139,
    "position": 0,
    "text": "کنون چون زنان پیش من بسته دست"
  },
  {
    "poem_id": 88012,
    "vorder": 140,
    "position": 1,
    "text": "همی خواب گویی به کردار مست"
  },
  {
    "poem_id": 88012,
    "vorder": 141,
    "position": 0,
    "text": "بکار دروغ آزمودن همی"
  },
  {
    "poem_id": 88012,
    "vorder": 142,
    "position": 1,
    "text": "بخواهی سر از من ربودن همی"
  },
  {
    "poem_id": 88012,
    "vorder": 143,
    "position": 0,
    "text": "بدو گفت بیژن که ای شهریار"
  },
  {
    "poem_id": 88012,
    "vorder": 144,
    "position": 1,
    "text": "سخن بشنو از من یکی هوشیار"
  },
  {
    "poem_id": 88012,
    "vorder": 145,
    "position": 0,
    "text": "گرازان بدندان و شیران بچنگ"
  },
  {
    "poem_id": 88012,
    "vorder": 146,
    "position": 1,
    "text": "توانند کردن بهر جای جنگ"
  },
  {
    "poem_id": 88012,
    "vorder": 147,
    "position": 0,
    "text": "یلان هم بشمشیر و تیر و کمان"
  },
  {
    "poem_id": 88012,
    "vorder": 148,
    "position": 1,
    "text": "توانند کوشید با بدگمان"
  },
  {
    "poem_id": 88012,
    "vorder": 149,
    "position": 0,
    "text": "یکی دست بسته برهنه تنا"
  },
  {
    "poem_id": 88012,
    "vorder": 150,
    "position": 1,
    "text": "یکی را ز پولاد پیراهنا"
  },
  {
    "poem_id": 88012,
    "vorder": 151,
    "position": 0,
    "text": "چگونه درد شیر بی چنگ تیز"
  },
  {
    "poem_id": 88012,
    "vorder": 152,
    "position": 1,
    "text": "اگر چند باشد دلش پر ستیز"
  },
  {
    "poem_id": 88012,
    "vorder": 153,
    "position": 0,
    "text": "اگر شاه خواهد که بیند ز من"
  },
  {
    "poem_id": 88012,
    "vorder": 154,
    "position": 1,
    "text": "دلیری نمودن بدین انجمن"
  },
  {
    "poem_id": 88012,
    "vorder": 155,
    "position": 0,
    "text": "یکی اسب فرمای و گرزی گران"
  },
  {
    "poem_id": 88012,
    "vorder": 156,
    "position": 1,
    "text": "ز ترکان گزین کن هزار از سران"
  },
  {
    "poem_id": 88012,
    "vorder": 157,
    "position": 0,
    "text": "به آوردگه بر یکی زین هزار"
  },
  {
    "poem_id": 88012,
    "vorder": 158,
    "position": 1,
    "text": "اگر زنده مانم بمردم مدار"
  },
  {
    "poem_id": 88012,
    "vorder": 159,
    "position": 0,
    "text": "ز بیژن چو این گفته بشنید چشم"
  },
  {
    "poem_id": 88012,
    "vorder": 160,
    "position": 1,
    "text": "بروبر فگند و برآورد خشم"
  },
  {
    "poem_id": 88012,
    "vorder": 161,
    "position": 0,
    "text": "بگرسیوز اندر یکی بنگرید"
  },
  {
    "poem_id": 88012,
    "vorder": 162,
    "position": 1,
    "text": "کز ایران چه دیدیم و خواهیم دید"
  },
  {
    "poem_id": 88012,
    "vorder": 163,
    "position": 0,
    "text": "نبینی که این بدکنش ریمنا"
  },
  {
    "poem_id": 88012,
    "vorder": 164,
    "position": 1,
    "text": "فزونی سگالد همی بر منا"
  },
  {
    "poem_id": 88012,
    "vorder": 165,
    "position": 0,
    "text": "بسنده نبودش همین بد که کرد"
  },
  {
    "poem_id": 88012,
    "vorder": 166,
    "position": 1,
    "text": "همی رزم جوید بننگ و نبرد"
  },
  {
    "poem_id": 88012,
    "vorder": 167,
    "position": 0,
    "text": "ببر همچنین بند بر دست و پای"
  },
  {
    "poem_id": 88012,
    "vorder": 168,
    "position": 1,
    "text": "هم اندر زمان زو بپرداز جای"
  },
  {
    "poem_id": 88012,
    "vorder": 169,
    "position": 0,
    "text": "بفرمای داری زدن پیش در"
  },
  {
    "poem_id": 88012,
    "vorder": 170,
    "position": 1,
    "text": "که باشد ز هر سو برو رهگذر"
  },
  {
    "poem_id": 88012,
    "vorder": 171,
    "position": 0,
    "text": "نگون بخت را زنده بر دار کن"
  },
  {
    "poem_id": 88012,
    "vorder": 172,
    "position": 1,
    "text": "وزو نیز با من مگردان سخن"
  },
  {
    "poem_id": 88012,
    "vorder": 173,
    "position": 0,
    "text": "بدان تا ز ایرانیان زین سپس"
  },
  {
    "poem_id": 88012,
    "vorder": 174,
    "position": 1,
    "text": "نیارد بتوران نگه کرد کس"
  },
  {
    "poem_id": 88012,
    "vorder": 175,
    "position": 0,
    "text": "کشیدندش از پیش افراسیاب"
  },
  {
    "poem_id": 88012,
    "vorder": 176,
    "position": 1,
    "text": "دل از درد خسته دو دیده پر آب"
  },
  {
    "poem_id": 88012,
    "vorder": 177,
    "position": 0,
    "text": "چو آمد بدر بیژن خسته دل"
  },
  {
    "poem_id": 88012,
    "vorder": 178,
    "position": 1,
    "text": "ز خون مژه پای مانده بگل"
  },
  {
    "poem_id": 88012,
    "vorder": 179,
    "position": 0,
    "text": "همی گفت اگر بر سرم کردگار"
  },
  {
    "poem_id": 88012,
    "vorder": 180,
    "position": 1,
    "text": "نوشتست مردن ببد روزگار"
  },
  {
    "poem_id": 88012,
    "vorder": 181,
    "position": 0,
    "text": "ز دار و ز کشتن نترسم همی"
  },
  {
    "poem_id": 88012,
    "vorder": 182,
    "position": 1,
    "text": "ز گردان ایران بترسم همی"
  },
  {
    "poem_id": 88012,
    "vorder": 183,
    "position": 0,
    "text": "که نامرد خواند مرا دشمنم"
  },
  {
    "poem_id": 88012,
    "vorder": 184,
    "position": 1,
    "text": "ز ناخسته بردار کرده تنم"
  },
  {
    "poem_id": 88012,
    "vorder": 185,
    "position": 0,
    "text": "بپیش نیاکان پهلو منش"
  },
  {
    "poem_id": 88012,
    "vorder": 186,
    "position": 1,
    "text": "پس از مرگ بر من بود سرزنش"
  },
  {
    "poem_id": 88012,
    "vorder": 187,
    "position": 0,
    "text": "روانم بماند هم ایدر بجای"
  },
  {
    "poem_id": 88012,
    "vorder": 188,
    "position": 1,
    "text": "ز شرم پدر چون شوم باز جای"
  },
  {
    "poem_id": 88012,
    "vorder": 189,
    "position": 0,
    "text": "دریغا که شادان شود دشمنم"
  },
  {
    "poem_id": 88012,
    "vorder": 190,
    "position": 1,
    "text": "چو بینند بر دار روشن تنم"
  },
  {
    "poem_id": 88012,
    "vorder": 191,
    "position": 0,
    "text": "دریغا ز شاه و ز مردان نیو"
  },
  {
    "poem_id": 88012,
    "vorder": 192,
    "position": 1,
    "text": "دریغا که دورم ز دیدار گیو"
  },
  {
    "poem_id": 88012,
    "vorder": 193,
    "position": 0,
    "text": "ایا باد بگذر بایران زمین"
  },
  {
    "poem_id": 88012,
    "vorder": 194,
    "position": 1,
    "text": "پیامی بر از من بشاه گزین"
  },
  {
    "poem_id": 88012,
    "vorder": 195,
    "position": 0,
    "text": "بگویش که بیژن بسختی درست"
  },
  {
    "poem_id": 88012,
    "vorder": 196,
    "position": 1,
    "text": "چو آهو که در چنگ شیر نرست"
  }
]