[
  {
    "poem_id": 1746,
    "vorder": 1,
    "position": 0,
    "text": "برانوش چون پاسخ نامه دید"
  },
  {
    "poem_id": 1746,
    "vorder": 2,
    "position": 1,
    "text": "ز شادی دل پاک‌تن بردمید"
  },
  {
    "poem_id": 1746,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا نامداران روم"
  },
  {
    "poem_id": 1746,
    "vorder": 4,
    "position": 1,
    "text": "برفتند صد مرد زان مرز و بوم"
  },
  {
    "poem_id": 1746,
    "vorder": 5,
    "position": 0,
    "text": "درم بار کردند خروار شست"
  },
  {
    "poem_id": 1746,
    "vorder": 6,
    "position": 1,
    "text": "هم از گوهر و جامهٔ بر نشست"
  },
  {
    "poem_id": 1746,
    "vorder": 7,
    "position": 0,
    "text": "ز دینار گنجی ز بهر نثار"
  },
  {
    "poem_id": 1746,
    "vorder": 8,
    "position": 1,
    "text": "فراز آمد از هر سوی سی هزار"
  },
  {
    "poem_id": 1746,
    "vorder": 9,
    "position": 0,
    "text": "همه مهتران نزد شاه آمدند"
  },
  {
    "poem_id": 1746,
    "vorder": 10,
    "position": 1,
    "text": "برهنه سر و بی‌کلاه آمدند"
  },
  {
    "poem_id": 1746,
    "vorder": 11,
    "position": 0,
    "text": "چو دینار پیشش فرو ریختند"
  },
  {
    "poem_id": 1746,
    "vorder": 12,
    "position": 1,
    "text": "بگسترده زر کهن بیختند"
  },
  {
    "poem_id": 1746,
    "vorder": 13,
    "position": 0,
    "text": "ببخشود و شاپور و بنواختشان"
  },
  {
    "poem_id": 1746,
    "vorder": 14,
    "position": 1,
    "text": "به خوبی بر اندازه بنشاختشان"
  },
  {
    "poem_id": 1746,
    "vorder": 15,
    "position": 0,
    "text": "برانوش را گفت کز شهر روم"
  },
  {
    "poem_id": 1746,
    "vorder": 16,
    "position": 1,
    "text": "بیامد بسی مرد بیداد و شوم"
  },
  {
    "poem_id": 1746,
    "vorder": 17,
    "position": 0,
    "text": "به ایران زمین آنچ بد شارستان"
  },
  {
    "poem_id": 1746,
    "vorder": 18,
    "position": 1,
    "text": "کنون گشت یکسر همه خارستان"
  },
  {
    "poem_id": 1746,
    "vorder": 19,
    "position": 0,
    "text": "عوض خواهم آن را که ویران شدست"
  },
  {
    "poem_id": 1746,
    "vorder": 20,
    "position": 1,
    "text": "کنام پلنگان و شیران شدست"
  },
  {
    "poem_id": 1746,
    "vorder": 21,
    "position": 0,
    "text": "برانوش گفتا چه باید بگوی"
  },
  {
    "poem_id": 1746,
    "vorder": 22,
    "position": 1,
    "text": "چو زنهار دادی مه بر تاب روی"
  },
  {
    "poem_id": 1746,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد پاسخ گرانمایه شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 24,
    "position": 1,
    "text": "چو خواهی که یکسر ببخشم گناه"
  },
  {
    "poem_id": 1746,
    "vorder": 25,
    "position": 0,
    "text": "ز دینار رومی به سالی سه بار"
  },
  {
    "poem_id": 1746,
    "vorder": 26,
    "position": 1,
    "text": "همی داد باید هزاران هزار"
  },
  {
    "poem_id": 1746,
    "vorder": 27,
    "position": 0,
    "text": "دگر آنک باشد نصیبین مرا"
  },
  {
    "poem_id": 1746,
    "vorder": 28,
    "position": 1,
    "text": "چو خواهی که کوته شود کین مرا"
  },
  {
    "poem_id": 1746,
    "vorder": 29,
    "position": 0,
    "text": "برانوش گفتا که ایران تراست"
  },
  {
    "poem_id": 1746,
    "vorder": 30,
    "position": 1,
    "text": "نصیبین و دشت دلیران تراست"
  },
  {
    "poem_id": 1746,
    "vorder": 31,
    "position": 0,
    "text": "پذیرفتم این مایه‌ور باژ و ساو"
  },
  {
    "poem_id": 1746,
    "vorder": 32,
    "position": 1,
    "text": "که با کین و خشمت نداریم تاو"
  },
  {
    "poem_id": 1746,
    "vorder": 33,
    "position": 0,
    "text": "نوشتند عهدی ز شاپور شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 34,
    "position": 1,
    "text": "کزان پس نراند ز ایران سپاه"
  },
  {
    "poem_id": 1746,
    "vorder": 35,
    "position": 0,
    "text": "مگر با سزاواری و خرمی"
  },
  {
    "poem_id": 1746,
    "vorder": 36,
    "position": 1,
    "text": "کجا روم را زو نیاید کمی"
  },
  {
    "poem_id": 1746,
    "vorder": 37,
    "position": 0,
    "text": "ازان پس گسی کرد و بنواختشان"
  },
  {
    "poem_id": 1746,
    "vorder": 38,
    "position": 1,
    "text": "سر از نامداران برافراختشان"
  },
  {
    "poem_id": 1746,
    "vorder": 39,
    "position": 0,
    "text": "چو ایشان برفتند لشکر براند"
  },
  {
    "poem_id": 1746,
    "vorder": 40,
    "position": 1,
    "text": "جهان‌آفرین را فراوان بخواند"
  },
  {
    "poem_id": 1746,
    "vorder": 41,
    "position": 0,
    "text": "همی رفت شادان به اصطخر پارس"
  },
  {
    "poem_id": 1746,
    "vorder": 42,
    "position": 1,
    "text": "که اصطخر بد بر زمین فخر پارس"
  },
  {
    "poem_id": 1746,
    "vorder": 43,
    "position": 0,
    "text": "چو اندر نصیبین خبر یافتند"
  },
  {
    "poem_id": 1746,
    "vorder": 44,
    "position": 1,
    "text": "همه جنگ را تیز بشتافتند"
  },
  {
    "poem_id": 1746,
    "vorder": 45,
    "position": 0,
    "text": "که ما را نباید که شاپور شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 46,
    "position": 1,
    "text": "نصیبین بگیرد بیارد سپاه"
  },
  {
    "poem_id": 1746,
    "vorder": 47,
    "position": 0,
    "text": "که دین مسیحا ندارد درست"
  },
  {
    "poem_id": 1746,
    "vorder": 48,
    "position": 1,
    "text": "همش کیش زردشت و زند است و است"
  },
  {
    "poem_id": 1746,
    "vorder": 49,
    "position": 0,
    "text": "چو آید ز ما برنگیرد سخن"
  },
  {
    "poem_id": 1746,
    "vorder": 50,
    "position": 1,
    "text": "نخواهیم استا و دین کهن"
  },
  {
    "poem_id": 1746,
    "vorder": 51,
    "position": 0,
    "text": "زبردست شد مردم زیردست"
  },
  {
    "poem_id": 1746,
    "vorder": 52,
    "position": 1,
    "text": "به کین مرد شهری به زین برنشست"
  },
  {
    "poem_id": 1746,
    "vorder": 53,
    "position": 0,
    "text": "چو آگاهی آمد به شاپور شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 54,
    "position": 1,
    "text": "که اندر نصیبین ندادند راه"
  },
  {
    "poem_id": 1746,
    "vorder": 55,
    "position": 0,
    "text": "ز دین مسیحا برآشفت شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 56,
    "position": 1,
    "text": "سپاهی فرستاد بی‌مر به راه"
  },
  {
    "poem_id": 1746,
    "vorder": 57,
    "position": 0,
    "text": "همی گفت پیغمبری کش جهود"
  },
  {
    "poem_id": 1746,
    "vorder": 58,
    "position": 1,
    "text": "کشد دین او را نشاید ستود"
  },
  {
    "poem_id": 1746,
    "vorder": 59,
    "position": 0,
    "text": "برفتند لشکر به کردار گرد"
  },
  {
    "poem_id": 1746,
    "vorder": 60,
    "position": 1,
    "text": "سواران و شیران روز نبرد"
  },
  {
    "poem_id": 1746,
    "vorder": 61,
    "position": 0,
    "text": "به یک هفته آنجا همی جنگ بود"
  },
  {
    "poem_id": 1746,
    "vorder": 62,
    "position": 1,
    "text": "دران شهر از جنگ بس تنگ بود"
  },
  {
    "poem_id": 1746,
    "vorder": 63,
    "position": 0,
    "text": "بکشتند زیشان فراوان سران"
  },
  {
    "poem_id": 1746,
    "vorder": 64,
    "position": 1,
    "text": "نهادند بر زنده بند گران"
  },
  {
    "poem_id": 1746,
    "vorder": 65,
    "position": 0,
    "text": "همه خواستند آن زمان زینهار"
  },
  {
    "poem_id": 1746,
    "vorder": 66,
    "position": 1,
    "text": "نوشتند نامه بر شهریار"
  },
  {
    "poem_id": 1746,
    "vorder": 67,
    "position": 0,
    "text": "ببخشیدشان نامبردار شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 68,
    "position": 1,
    "text": "بفرمود تا بازگردد سپاه"
  },
  {
    "poem_id": 1746,
    "vorder": 69,
    "position": 0,
    "text": "به هر کشوری نامداری گرفت"
  },
  {
    "poem_id": 1746,
    "vorder": 70,
    "position": 1,
    "text": "همان بر جهان کامگاری گرفت"
  },
  {
    "poem_id": 1746,
    "vorder": 71,
    "position": 0,
    "text": "همی خواندندیش پیروز شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 72,
    "position": 1,
    "text": "همی بود یک چند با تاج و گاه"
  },
  {
    "poem_id": 1746,
    "vorder": 73,
    "position": 0,
    "text": "کنیزک که او را رهانیده بود"
  },
  {
    "poem_id": 1746,
    "vorder": 74,
    "position": 1,
    "text": "بدان کامگاری رسانیده بود"
  },
  {
    "poem_id": 1746,
    "vorder": 75,
    "position": 0,
    "text": "دلفروزو فرخ‌پیش نام کرد"
  },
  {
    "poem_id": 1746,
    "vorder": 76,
    "position": 1,
    "text": "ز خوبان مر او را دلارام کرد"
  },
  {
    "poem_id": 1746,
    "vorder": 77,
    "position": 0,
    "text": "همان باغبان را بسی خواسته"
  },
  {
    "poem_id": 1746,
    "vorder": 78,
    "position": 1,
    "text": "بداد و گسی کردش آراسته"
  },
  {
    "poem_id": 1746,
    "vorder": 79,
    "position": 0,
    "text": "همی بود قیصر به زندان و بند"
  },
  {
    "poem_id": 1746,
    "vorder": 80,
    "position": 1,
    "text": "به زاری و خواری و زخم کمند"
  },
  {
    "poem_id": 1746,
    "vorder": 81,
    "position": 0,
    "text": "به روم اندرون هرچ بودش ز گنج"
  },
  {
    "poem_id": 1746,
    "vorder": 82,
    "position": 1,
    "text": "فراز آوریده ز هر سو به رنج"
  },
  {
    "poem_id": 1746,
    "vorder": 83,
    "position": 0,
    "text": "بیاورد و یکسر به شاپور داد"
  },
  {
    "poem_id": 1746,
    "vorder": 84,
    "position": 1,
    "text": "همی بود یک چند لب پر ز باد"
  },
  {
    "poem_id": 1746,
    "vorder": 85,
    "position": 0,
    "text": "سرانجام در بند و زندان بمرد"
  },
  {
    "poem_id": 1746,
    "vorder": 86,
    "position": 1,
    "text": "کلاه کیی دیگری را سپرد"
  },
  {
    "poem_id": 1746,
    "vorder": 87,
    "position": 0,
    "text": "به رومش فرستاد شاپور شاه"
  },
  {
    "poem_id": 1746,
    "vorder": 88,
    "position": 1,
    "text": "به تابوت وز مشک بر سر کلاه"
  },
  {
    "poem_id": 1746,
    "vorder": 89,
    "position": 0,
    "text": "چنین گفت کاینست فرجام ما"
  },
  {
    "poem_id": 1746,
    "vorder": 90,
    "position": 1,
    "text": "ندانم کجا باشد آرام ما"
  },
  {
    "poem_id": 1746,
    "vorder": 91,
    "position": 0,
    "text": "یکی را همه زفتی و ابلهیست"
  },
  {
    "poem_id": 1746,
    "vorder": 92,
    "position": 1,
    "text": "یکی با خردمندی و فرهیست"
  },
  {
    "poem_id": 1746,
    "vorder": 93,
    "position": 0,
    "text": "برین و بران روز هم بگذرد"
  },
  {
    "poem_id": 1746,
    "vorder": 94,
    "position": 1,
    "text": "خنگ آنک گیتی به بد نسپرد"
  },
  {
    "poem_id": 1746,
    "vorder": 95,
    "position": 0,
    "text": "به تخت کیان اندر آورد پای"
  },
  {
    "poem_id": 1746,
    "vorder": 96,
    "position": 1,
    "text": "همی بود چندی جهان کدخدای"
  },
  {
    "poem_id": 1746,
    "vorder": 97,
    "position": 0,
    "text": "وزان پس بر کشور خوزیان"
  },
  {
    "poem_id": 1746,
    "vorder": 98,
    "position": 1,
    "text": "فرستاد بسیار سود و زیان"
  },
  {
    "poem_id": 1746,
    "vorder": 99,
    "position": 0,
    "text": "ز بهر اسیران یکی شهر کرد"
  },
  {
    "poem_id": 1746,
    "vorder": 100,
    "position": 1,
    "text": "جهان را ازان بوم پر بهر کرد"
  },
  {
    "poem_id": 1746,
    "vorder": 101,
    "position": 0,
    "text": "کجا خرم‌آباد بد نام شهر"
  },
  {
    "poem_id": 1746,
    "vorder": 102,
    "position": 1,
    "text": "وزان بوم خرم کرا بود بهر"
  },
  {
    "poem_id": 1746,
    "vorder": 103,
    "position": 0,
    "text": "کسی را که از پیش ببرید دست"
  },
  {
    "poem_id": 1746,
    "vorder": 104,
    "position": 1,
    "text": "بدین مرز بودیش جای نشست"
  },
  {
    "poem_id": 1746,
    "vorder": 105,
    "position": 0,
    "text": "بر و بوم او یکسر او را بدی"
  },
  {
    "poem_id": 1746,
    "vorder": 106,
    "position": 1,
    "text": "سر سال نو خلعتی بستدی"
  },
  {
    "poem_id": 1746,
    "vorder": 107,
    "position": 0,
    "text": "یکی شارستان کرد دیگر به شام"
  },
  {
    "poem_id": 1746,
    "vorder": 108,
    "position": 1,
    "text": "که پیروز شاپور کردش به نام"
  },
  {
    "poem_id": 1746,
    "vorder": 109,
    "position": 0,
    "text": "به اهواز کرد آن سیم شارستان"
  },
  {
    "poem_id": 1746,
    "vorder": 110,
    "position": 1,
    "text": "بدو اندرون کاخ و بیمارستان"
  },
  {
    "poem_id": 1746,
    "vorder": 111,
    "position": 0,
    "text": "کنام اسیرانش کردند نام"
  },
  {
    "poem_id": 1746,
    "vorder": 112,
    "position": 1,
    "text": "اسیر اندرو یافتی خواب و کام"
  }
]