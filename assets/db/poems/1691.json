[
  {
    "poem_id": 1691,
    "vorder": 1,
    "position": 0,
    "text": "چو آمد به نزدیکی بارگاه"
  },
  {
    "poem_id": 1691,
    "vorder": 2,
    "position": 1,
    "text": "بگفتند با شاه زان بارخواه"
  },
  {
    "poem_id": 1691,
    "vorder": 3,
    "position": 0,
    "text": "جوان را به مهر اردوان پیش خواند"
  },
  {
    "poem_id": 1691,
    "vorder": 4,
    "position": 1,
    "text": "ز بابک سخنها فراوان براند"
  },
  {
    "poem_id": 1691,
    "vorder": 5,
    "position": 0,
    "text": "به نزدیکی تخت بنشاختش"
  },
  {
    "poem_id": 1691,
    "vorder": 6,
    "position": 1,
    "text": "به برزن یکی جایگه ساختش"
  },
  {
    "poem_id": 1691,
    "vorder": 7,
    "position": 0,
    "text": "فرستاد هرگونه‌ای خوردنی"
  },
  {
    "poem_id": 1691,
    "vorder": 8,
    "position": 1,
    "text": "ز پوشیدنی هم ز گستردنی"
  },
  {
    "poem_id": 1691,
    "vorder": 9,
    "position": 0,
    "text": "ابا نامداران بیامد جوان"
  },
  {
    "poem_id": 1691,
    "vorder": 10,
    "position": 1,
    "text": "به جایی که فرموده بود اردوان"
  },
  {
    "poem_id": 1691,
    "vorder": 11,
    "position": 0,
    "text": "چو کرسی نهاد از بر چرخ شید"
  },
  {
    "poem_id": 1691,
    "vorder": 12,
    "position": 1,
    "text": "جهان گشت چون روی رومی سپید"
  },
  {
    "poem_id": 1691,
    "vorder": 13,
    "position": 0,
    "text": "پرستنده‌ای پیش خواند اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 14,
    "position": 1,
    "text": "همان هدیه‌هایی که بد ناگزیر"
  },
  {
    "poem_id": 1691,
    "vorder": 15,
    "position": 0,
    "text": "فرستاد نزدیک شاه اردوان"
  },
  {
    "poem_id": 1691,
    "vorder": 16,
    "position": 1,
    "text": "فرستادهٔ بابک پهلوان"
  },
  {
    "poem_id": 1691,
    "vorder": 17,
    "position": 0,
    "text": "بدید اردوان و پسند آمدش"
  },
  {
    "poem_id": 1691,
    "vorder": 18,
    "position": 1,
    "text": "جوانمرد را سودمند آمدش"
  },
  {
    "poem_id": 1691,
    "vorder": 19,
    "position": 0,
    "text": "پسروار خسرو همی داشتش"
  },
  {
    "poem_id": 1691,
    "vorder": 20,
    "position": 1,
    "text": "زمانی به تیمار نگذاشتش"
  },
  {
    "poem_id": 1691,
    "vorder": 21,
    "position": 0,
    "text": "به می خوردن و خوان و نخچیرگاه"
  },
  {
    "poem_id": 1691,
    "vorder": 22,
    "position": 1,
    "text": "به پیش خودش داشتی سال و ماه"
  },
  {
    "poem_id": 1691,
    "vorder": 23,
    "position": 0,
    "text": "همی داشتش همچو فرزند خویش"
  },
  {
    "poem_id": 1691,
    "vorder": 24,
    "position": 1,
    "text": "جدایی ندادش ز پیوند خویش"
  },
  {
    "poem_id": 1691,
    "vorder": 25,
    "position": 0,
    "text": "چنان بد که روزی به نخچیرگاه"
  },
  {
    "poem_id": 1691,
    "vorder": 26,
    "position": 1,
    "text": "پراگنده شد لشکر و پور شاه"
  },
  {
    "poem_id": 1691,
    "vorder": 27,
    "position": 0,
    "text": "همی راند با اردوان اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 28,
    "position": 1,
    "text": "جوانمرد را شاه بد دلپذیر"
  },
  {
    "poem_id": 1691,
    "vorder": 29,
    "position": 0,
    "text": "پسر بود شاه اردوان را چهار"
  },
  {
    "poem_id": 1691,
    "vorder": 30,
    "position": 1,
    "text": "ازان هر یکی چون یکی شهریار"
  },
  {
    "poem_id": 1691,
    "vorder": 31,
    "position": 0,
    "text": "به هامون پدید آمد از دور گور"
  },
  {
    "poem_id": 1691,
    "vorder": 32,
    "position": 1,
    "text": "ازان لشکر گشن برخاست شور"
  },
  {
    "poem_id": 1691,
    "vorder": 33,
    "position": 0,
    "text": "همه بادپایان برانگیختند"
  },
  {
    "poem_id": 1691,
    "vorder": 34,
    "position": 1,
    "text": "همی گرد با خوی برآمیختند"
  },
  {
    "poem_id": 1691,
    "vorder": 35,
    "position": 0,
    "text": "همی تاخت پیش اندرون اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 36,
    "position": 1,
    "text": "چو نزدیک شد در کمان راند تیر"
  },
  {
    "poem_id": 1691,
    "vorder": 37,
    "position": 0,
    "text": "بزد بر سرون یکی گور نر"
  },
  {
    "poem_id": 1691,
    "vorder": 38,
    "position": 1,
    "text": "گذر کرد بر گور پیکان و پر"
  },
  {
    "poem_id": 1691,
    "vorder": 39,
    "position": 0,
    "text": "بیامد هم اندر زمان اردوان"
  },
  {
    "poem_id": 1691,
    "vorder": 40,
    "position": 1,
    "text": "بدید آن گشاد و بر آن جوان"
  },
  {
    "poem_id": 1691,
    "vorder": 41,
    "position": 0,
    "text": "بدید آن یکی گور افگنده گفت"
  },
  {
    "poem_id": 1691,
    "vorder": 42,
    "position": 1,
    "text": "که با دست آنکس هنر باد جفت"
  },
  {
    "poem_id": 1691,
    "vorder": 43,
    "position": 0,
    "text": "چنین داد پاسخ به شاه اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 44,
    "position": 1,
    "text": "که این گور را من فگندم به تیر"
  },
  {
    "poem_id": 1691,
    "vorder": 45,
    "position": 0,
    "text": "پسر گفت کین را من افگنده‌ام"
  },
  {
    "poem_id": 1691,
    "vorder": 46,
    "position": 1,
    "text": "همان جفت را نیز جوینده‌ام"
  },
  {
    "poem_id": 1691,
    "vorder": 47,
    "position": 0,
    "text": "چنین داد پاسخ بدو اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 48,
    "position": 1,
    "text": "که دشتی فراخست و هم گور و تیر"
  },
  {
    "poem_id": 1691,
    "vorder": 49,
    "position": 0,
    "text": "یکی دیگر افگن برین هم نشان"
  },
  {
    "poem_id": 1691,
    "vorder": 50,
    "position": 1,
    "text": "دروغ از گناهست بر سرکشان"
  },
  {
    "poem_id": 1691,
    "vorder": 51,
    "position": 0,
    "text": "پر از خشم شد زان جوان اردوان"
  },
  {
    "poem_id": 1691,
    "vorder": 52,
    "position": 1,
    "text": "یکی بانگ برزد به مرد جوان"
  },
  {
    "poem_id": 1691,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت شاه این گناه منست"
  },
  {
    "poem_id": 1691,
    "vorder": 54,
    "position": 1,
    "text": "که پروردن آیین و راه منست"
  },
  {
    "poem_id": 1691,
    "vorder": 55,
    "position": 0,
    "text": "ترا خود به بزم و به نخچیرگاه"
  },
  {
    "poem_id": 1691,
    "vorder": 56,
    "position": 1,
    "text": "چرا برد باید همی با سپاه"
  },
  {
    "poem_id": 1691,
    "vorder": 57,
    "position": 0,
    "text": "بدان تا ز فرزند من بگذری"
  },
  {
    "poem_id": 1691,
    "vorder": 58,
    "position": 1,
    "text": "بلندی گزینی و کنداوری"
  },
  {
    "poem_id": 1691,
    "vorder": 59,
    "position": 0,
    "text": "برو تازی اسپان ما را ببین"
  },
  {
    "poem_id": 1691,
    "vorder": 60,
    "position": 1,
    "text": "هم آن جایگه بر سرایی گزین"
  },
  {
    "poem_id": 1691,
    "vorder": 61,
    "position": 0,
    "text": "بران آخر اسپ سالار باش"
  },
  {
    "poem_id": 1691,
    "vorder": 62,
    "position": 1,
    "text": "به هر کار با هر کسی یار باش"
  },
  {
    "poem_id": 1691,
    "vorder": 63,
    "position": 0,
    "text": "بیامد پر از آب چشم اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 64,
    "position": 1,
    "text": "بر آخر اسپ شد ناگزیر"
  },
  {
    "poem_id": 1691,
    "vorder": 65,
    "position": 0,
    "text": "یکی نامه بنوشت پیش نیا"
  },
  {
    "poem_id": 1691,
    "vorder": 66,
    "position": 1,
    "text": "پر از غم دل و سر پر از کیمیا"
  },
  {
    "poem_id": 1691,
    "vorder": 67,
    "position": 0,
    "text": "که ما را چه پیش آمد از اردوان"
  },
  {
    "poem_id": 1691,
    "vorder": 68,
    "position": 1,
    "text": "که درد تنش باد و رنج روان"
  },
  {
    "poem_id": 1691,
    "vorder": 69,
    "position": 0,
    "text": "همه یاد کرد آن کجا رفته بود"
  },
  {
    "poem_id": 1691,
    "vorder": 70,
    "position": 1,
    "text": "کجا اردوان از چه آشفته بود"
  },
  {
    "poem_id": 1691,
    "vorder": 71,
    "position": 0,
    "text": "چو آن نامه نزدیک بابک رسید"
  },
  {
    "poem_id": 1691,
    "vorder": 72,
    "position": 1,
    "text": "نکرد آن سخن نیز بر کس پدید"
  },
  {
    "poem_id": 1691,
    "vorder": 73,
    "position": 0,
    "text": "دلش گشت زان کار پر درد و رنج"
  },
  {
    "poem_id": 1691,
    "vorder": 74,
    "position": 1,
    "text": "بیاورد دینار چندی ز گنج"
  },
  {
    "poem_id": 1691,
    "vorder": 75,
    "position": 0,
    "text": "فرستاد نزدیک او ده هزار"
  },
  {
    "poem_id": 1691,
    "vorder": 76,
    "position": 1,
    "text": "هیونی برافگند گرد و سوار"
  },
  {
    "poem_id": 1691,
    "vorder": 77,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1691,
    "vorder": 78,
    "position": 1,
    "text": "یکی نامه فرمود زی اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 79,
    "position": 0,
    "text": "که این کم خرد نورسیده جوان"
  },
  {
    "poem_id": 1691,
    "vorder": 80,
    "position": 1,
    "text": "چو رفتی به نخچیر با اردوان"
  },
  {
    "poem_id": 1691,
    "vorder": 81,
    "position": 0,
    "text": "چرا تاختی پیش فرزند اوی"
  },
  {
    "poem_id": 1691,
    "vorder": 82,
    "position": 1,
    "text": "پرستنده‌ای تو نه پیوند اوی"
  },
  {
    "poem_id": 1691,
    "vorder": 83,
    "position": 0,
    "text": "نکردی به تو دشمنی ار بدی"
  },
  {
    "poem_id": 1691,
    "vorder": 84,
    "position": 1,
    "text": "که خود کرده‌ای تو به نابخردی"
  },
  {
    "poem_id": 1691,
    "vorder": 85,
    "position": 0,
    "text": "کنون کام و خشنودی او بجوی"
  },
  {
    "poem_id": 1691,
    "vorder": 86,
    "position": 1,
    "text": "مگردان ز فرمان او هیچ روی"
  },
  {
    "poem_id": 1691,
    "vorder": 87,
    "position": 0,
    "text": "ز دینار لختی فرستادمت"
  },
  {
    "poem_id": 1691,
    "vorder": 88,
    "position": 1,
    "text": "به نامه درون پندها دادمت"
  },
  {
    "poem_id": 1691,
    "vorder": 89,
    "position": 0,
    "text": "هرانگه که این مایه بردی بکار"
  },
  {
    "poem_id": 1691,
    "vorder": 90,
    "position": 1,
    "text": "دگر خواه تا بگذرد روزگار"
  },
  {
    "poem_id": 1691,
    "vorder": 91,
    "position": 0,
    "text": "تگاور هیون جهاندیده پیر"
  },
  {
    "poem_id": 1691,
    "vorder": 92,
    "position": 1,
    "text": "بیامد دوان تا بر اردشیر"
  },
  {
    "poem_id": 1691,
    "vorder": 93,
    "position": 0,
    "text": "چو آن نامه برخواند خرسند گشت"
  },
  {
    "poem_id": 1691,
    "vorder": 94,
    "position": 1,
    "text": "دلش سوی نیرنگ و اروند گشت"
  },
  {
    "poem_id": 1691,
    "vorder": 95,
    "position": 0,
    "text": "بگسترد هرگونه گستردنی"
  },
  {
    "poem_id": 1691,
    "vorder": 96,
    "position": 1,
    "text": "ز پوشیدنیها و از خوردنی"
  },
  {
    "poem_id": 1691,
    "vorder": 97,
    "position": 0,
    "text": "به نزدیک اسپان سرایی گزید"
  },
  {
    "poem_id": 1691,
    "vorder": 98,
    "position": 1,
    "text": "نه اندر خور کار جایی گزید"
  },
  {
    "poem_id": 1691,
    "vorder": 99,
    "position": 0,
    "text": "شب و روز خوردن بدی کار اوی"
  },
  {
    "poem_id": 1691,
    "vorder": 100,
    "position": 1,
    "text": "می و جام و رامشگران یار اوی"
  }
]