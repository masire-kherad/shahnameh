[
  {
    "poem_id": 1471,
    "vorder": 1,
    "position": 0,
    "text": "چو افگند خور سوی بالا کمند"
  },
  {
    "poem_id": 1471,
    "vorder": 2,
    "position": 1,
    "text": "زبانه برآمد ز چرخ بلند"
  },
  {
    "poem_id": 1471,
    "vorder": 3,
    "position": 0,
    "text": "بپوشید سهراب خفتان جنگ"
  },
  {
    "poem_id": 1471,
    "vorder": 4,
    "position": 1,
    "text": "نشست از بر چرمهٔ سنگ رنگ"
  },
  {
    "poem_id": 1471,
    "vorder": 5,
    "position": 0,
    "text": "یکی تیغ هندی به چنگ اندرش"
  },
  {
    "poem_id": 1471,
    "vorder": 6,
    "position": 1,
    "text": "یکی مغفر خسروی بر سرش"
  },
  {
    "poem_id": 1471,
    "vorder": 7,
    "position": 0,
    "text": "کمندی به فتراک بر شست خم"
  },
  {
    "poem_id": 1471,
    "vorder": 8,
    "position": 1,
    "text": "خم اندر خم و روی کرده دژم"
  },
  {
    "poem_id": 1471,
    "vorder": 9,
    "position": 0,
    "text": "بیامد یکی برز بالا گزید"
  },
  {
    "poem_id": 1471,
    "vorder": 10,
    "position": 1,
    "text": "به جایی که ایرانیان را بدید"
  },
  {
    "poem_id": 1471,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود تا رفت پیشش هجیر"
  },
  {
    "poem_id": 1471,
    "vorder": 12,
    "position": 1,
    "text": "بدو گفت کژی نیاید ز تیر"
  },
  {
    "poem_id": 1471,
    "vorder": 13,
    "position": 0,
    "text": "نشانه نباید که خم آورد"
  },
  {
    "poem_id": 1471,
    "vorder": 14,
    "position": 1,
    "text": "چو پیچان شود زخم کم آورد"
  },
  {
    "poem_id": 1471,
    "vorder": 15,
    "position": 0,
    "text": "به هر کار در پیشه کن راستی"
  },
  {
    "poem_id": 1471,
    "vorder": 16,
    "position": 1,
    "text": "چو خواهی که نگزایدت کاستی"
  },
  {
    "poem_id": 1471,
    "vorder": 17,
    "position": 0,
    "text": "سخن هرچه پرسم همه راست گوی"
  },
  {
    "poem_id": 1471,
    "vorder": 18,
    "position": 1,
    "text": "متاب از ره راستی هیچ روی"
  },
  {
    "poem_id": 1471,
    "vorder": 19,
    "position": 0,
    "text": "چو خواهی که یابی رهایی ز من"
  },
  {
    "poem_id": 1471,
    "vorder": 20,
    "position": 1,
    "text": "سرافراز باشی به هر انجمن"
  },
  {
    "poem_id": 1471,
    "vorder": 21,
    "position": 0,
    "text": "از ایران هر آنچت بپرسم بگوی"
  },
  {
    "poem_id": 1471,
    "vorder": 22,
    "position": 1,
    "text": "متاب از ره راستی هیچ روی"
  },
  {
    "poem_id": 1471,
    "vorder": 23,
    "position": 0,
    "text": "سپارم به تو گنج آراسته"
  },
  {
    "poem_id": 1471,
    "vorder": 24,
    "position": 1,
    "text": "بیابی بسی خلعت و خواسته"
  },
  {
    "poem_id": 1471,
    "vorder": 25,
    "position": 0,
    "text": "ور ایدون که کژی بود رای تو"
  },
  {
    "poem_id": 1471,
    "vorder": 26,
    "position": 1,
    "text": "همان بند و زندان بود جای تو"
  },
  {
    "poem_id": 1471,
    "vorder": 27,
    "position": 0,
    "text": "هجیرش چنین داد پاسخ که شاه"
  },
  {
    "poem_id": 1471,
    "vorder": 28,
    "position": 1,
    "text": "سخن هرچه پرسد ز ایران سپاه"
  },
  {
    "poem_id": 1471,
    "vorder": 29,
    "position": 0,
    "text": "بگویم همه آنچ دانم بدوی"
  },
  {
    "poem_id": 1471,
    "vorder": 30,
    "position": 1,
    "text": "به کژی چرا بایدم گفت‌وگوی"
  },
  {
    "poem_id": 1471,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت کز تو بپرسم همه"
  },
  {
    "poem_id": 1471,
    "vorder": 32,
    "position": 1,
    "text": "ز گردنکشان و ز شاه و رمه"
  },
  {
    "poem_id": 1471,
    "vorder": 33,
    "position": 0,
    "text": "همه نامداران آن مرز را"
  },
  {
    "poem_id": 1471,
    "vorder": 34,
    "position": 1,
    "text": "چو طوس و چو کاووس و گودرز را"
  },
  {
    "poem_id": 1471,
    "vorder": 35,
    "position": 0,
    "text": "ز بهرام و از رستم نامدار"
  },
  {
    "poem_id": 1471,
    "vorder": 36,
    "position": 1,
    "text": "ز هر کت بپرسم به من برشمار"
  },
  {
    "poem_id": 1471,
    "vorder": 37,
    "position": 0,
    "text": "بگو کان سراپردهٔ هفت رنگ"
  },
  {
    "poem_id": 1471,
    "vorder": 38,
    "position": 1,
    "text": "بدو اندرون خیمه‌های پلنگ"
  },
  {
    "poem_id": 1471,
    "vorder": 39,
    "position": 0,
    "text": "به پیش اندرون بسته صد ژنده‌پیل"
  },
  {
    "poem_id": 1471,
    "vorder": 40,
    "position": 1,
    "text": "یکی مهد پیروزه برسان نیل"
  },
  {
    "poem_id": 1471,
    "vorder": 41,
    "position": 0,
    "text": "یکی برز خورشید پیکر درفش"
  },
  {
    "poem_id": 1471,
    "vorder": 42,
    "position": 1,
    "text": "سرش ماه زرین غلافش بنفش"
  },
  {
    "poem_id": 1471,
    "vorder": 43,
    "position": 0,
    "text": "به قلب سپاه اندرون جای کیست"
  },
  {
    "poem_id": 1471,
    "vorder": 44,
    "position": 1,
    "text": "ز گردان ایران ورا نام چیست"
  },
  {
    "poem_id": 1471,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت کان شاه ایران بود"
  },
  {
    "poem_id": 1471,
    "vorder": 46,
    "position": 1,
    "text": "بدرگاه او پیل و شیران بود"
  },
  {
    "poem_id": 1471,
    "vorder": 47,
    "position": 0,
    "text": "وزان پس بدو گفت بر میمنه"
  },
  {
    "poem_id": 1471,
    "vorder": 48,
    "position": 1,
    "text": "سواران بسیار و پیل و بنه"
  },
  {
    "poem_id": 1471,
    "vorder": 49,
    "position": 0,
    "text": "سراپرده‌ای بر کشیده سیاه"
  },
  {
    "poem_id": 1471,
    "vorder": 50,
    "position": 1,
    "text": "زده گردش اندر ز هر سو سپاه"
  },
  {
    "poem_id": 1471,
    "vorder": 51,
    "position": 0,
    "text": "به گرد اندرش خیمه ز اندازه بیش"
  },
  {
    "poem_id": 1471,
    "vorder": 52,
    "position": 1,
    "text": "پس پشت پیلان و بالاش پیش"
  },
  {
    "poem_id": 1471,
    "vorder": 53,
    "position": 0,
    "text": "زده پیش او پیل پیکر درفش"
  },
  {
    "poem_id": 1471,
    "vorder": 54,
    "position": 1,
    "text": "به در بر سواران زرینه کفش"
  },
  {
    "poem_id": 1471,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت کان طوس نوذر بود"
  },
  {
    "poem_id": 1471,
    "vorder": 56,
    "position": 1,
    "text": "درفشش کجاپیل‌پیکر بود"
  },
  {
    "poem_id": 1471,
    "vorder": 57,
    "position": 0,
    "text": "دگر گفت کان سرخ پرده‌سرای"
  },
  {
    "poem_id": 1471,
    "vorder": 58,
    "position": 1,
    "text": "سواران بسی گردش اندر به پای"
  },
  {
    "poem_id": 1471,
    "vorder": 59,
    "position": 0,
    "text": "یکی شیر پیکر درفشی به زر"
  },
  {
    "poem_id": 1471,
    "vorder": 60,
    "position": 1,
    "text": "درفشان یکی در میانش گهر"
  },
  {
    "poem_id": 1471,
    "vorder": 61,
    "position": 0,
    "text": "چنین گفت کان فر آزادگان"
  },
  {
    "poem_id": 1471,
    "vorder": 62,
    "position": 1,
    "text": "جهانگیر گودرز کشوادگان"
  },
  {
    "poem_id": 1471,
    "vorder": 63,
    "position": 0,
    "text": "بپرسید کان سبز پرده‌سرای"
  },
  {
    "poem_id": 1471,
    "vorder": 64,
    "position": 1,
    "text": "یکی لشکری گشن پیشش به پای"
  },
  {
    "poem_id": 1471,
    "vorder": 65,
    "position": 0,
    "text": "یکی تخت پرمایه اندر میان"
  },
  {
    "poem_id": 1471,
    "vorder": 66,
    "position": 1,
    "text": "زده پیش او اختر کاویان"
  },
  {
    "poem_id": 1471,
    "vorder": 67,
    "position": 0,
    "text": "برو بر نشسته یکی پهلوان"
  },
  {
    "poem_id": 1471,
    "vorder": 68,
    "position": 1,
    "text": "ابا فر و با سفت و یال گوان"
  },
  {
    "poem_id": 1471,
    "vorder": 69,
    "position": 0,
    "text": "ز هر کس که بر پای پیشش براست"
  },
  {
    "poem_id": 1471,
    "vorder": 70,
    "position": 1,
    "text": "نشسته به یک رش سرش برتر است"
  },
  {
    "poem_id": 1471,
    "vorder": 71,
    "position": 0,
    "text": "یکی باره پیشش به بالای اوی"
  },
  {
    "poem_id": 1471,
    "vorder": 72,
    "position": 1,
    "text": "کمندی فرو هشته تا پای اوی"
  },
  {
    "poem_id": 1471,
    "vorder": 73,
    "position": 0,
    "text": "برو هر زمان برخروشد همی"
  },
  {
    "poem_id": 1471,
    "vorder": 74,
    "position": 1,
    "text": "تو گویی که در زین بجوشد همی"
  },
  {
    "poem_id": 1471,
    "vorder": 75,
    "position": 0,
    "text": "بسی پیل برگستوان‌دار پیش"
  },
  {
    "poem_id": 1471,
    "vorder": 76,
    "position": 1,
    "text": "همی جوشد آن مرد بر جای خویش"
  },
  {
    "poem_id": 1471,
    "vorder": 77,
    "position": 0,
    "text": "نه مردست از ایران به بالای اوی"
  },
  {
    "poem_id": 1471,
    "vorder": 78,
    "position": 1,
    "text": "نه بینم همی اسپ همتای اوی"
  },
  {
    "poem_id": 1471,
    "vorder": 79,
    "position": 0,
    "text": "درفشی بدید اژدها پیکرست"
  },
  {
    "poem_id": 1471,
    "vorder": 80,
    "position": 1,
    "text": "بران نیزه بر شیر زرین سرست"
  },
  {
    "poem_id": 1471,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت کز چین یکی نامدار"
  },
  {
    "poem_id": 1471,
    "vorder": 82,
    "position": 1,
    "text": "بنوی بیامد بر شهریار"
  },
  {
    "poem_id": 1471,
    "vorder": 83,
    "position": 0,
    "text": "بپرسید نامش ز فرخ هجیر"
  },
  {
    "poem_id": 1471,
    "vorder": 84,
    "position": 1,
    "text": "بدو گفت نامش ندارم بویر"
  },
  {
    "poem_id": 1471,
    "vorder": 85,
    "position": 0,
    "text": "بدین دژ بدم من بدان روزگار"
  },
  {
    "poem_id": 1471,
    "vorder": 86,
    "position": 1,
    "text": "کجا او بیامد بر شهریار"
  },
  {
    "poem_id": 1471,
    "vorder": 87,
    "position": 0,
    "text": "غمی گشت سهراب را دل ازان"
  },
  {
    "poem_id": 1471,
    "vorder": 88,
    "position": 1,
    "text": "که جایی ز رستم نیامد نشان"
  },
  {
    "poem_id": 1471,
    "vorder": 89,
    "position": 0,
    "text": "نشان داده بود از پدر مادرش"
  },
  {
    "poem_id": 1471,
    "vorder": 90,
    "position": 1,
    "text": "همی دید و دیده نبد باورش"
  },
  {
    "poem_id": 1471,
    "vorder": 91,
    "position": 0,
    "text": "همی نام جست از زبان هجیر"
  },
  {
    "poem_id": 1471,
    "vorder": 92,
    "position": 1,
    "text": "مگر کان سخنها شود دلپذیر"
  },
  {
    "poem_id": 1471,
    "vorder": 93,
    "position": 0,
    "text": "نبشته به سر بر دگرگونه بود"
  },
  {
    "poem_id": 1471,
    "vorder": 94,
    "position": 1,
    "text": "ز فرمان نکاهد نخواهد فزود"
  },
  {
    "poem_id": 1471,
    "vorder": 95,
    "position": 0,
    "text": "ازان پس بپرسید زان مهتران"
  },
  {
    "poem_id": 1471,
    "vorder": 96,
    "position": 1,
    "text": "کشیده سراپرده بد برکران"
  },
  {
    "poem_id": 1471,
    "vorder": 97,
    "position": 0,
    "text": "سواران بسیار و پیلان به پای"
  },
  {
    "poem_id": 1471,
    "vorder": 98,
    "position": 1,
    "text": "برآید همی نالهٔ کرنای"
  },
  {
    "poem_id": 1471,
    "vorder": 99,
    "position": 0,
    "text": "یکی گرگ پیکر درفش از برش"
  },
  {
    "poem_id": 1471,
    "vorder": 100,
    "position": 1,
    "text": "برآورده از پرده زرین سرش"
  },
  {
    "poem_id": 1471,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت کان پور گودرز گیو"
  },
  {
    "poem_id": 1471,
    "vorder": 102,
    "position": 1,
    "text": "که خوانند گردان ورا گیو نیو"
  },
  {
    "poem_id": 1471,
    "vorder": 103,
    "position": 0,
    "text": "ز گودرزیان مهتر و بهترست"
  },
  {
    "poem_id": 1471,
    "vorder": 104,
    "position": 1,
    "text": "به ایرانیان بر دو بهره سرست"
  },
  {
    "poem_id": 1471,
    "vorder": 105,
    "position": 0,
    "text": "بدو گفت زان سوی تابنده شید"
  },
  {
    "poem_id": 1471,
    "vorder": 106,
    "position": 1,
    "text": "برآید یکی پرده بینم سپید"
  },
  {
    "poem_id": 1471,
    "vorder": 107,
    "position": 0,
    "text": "ز دیبای رومی به پیشش سوار"
  },
  {
    "poem_id": 1471,
    "vorder": 108,
    "position": 1,
    "text": "رده برکشیده فزون از هزار"
  },
  {
    "poem_id": 1471,
    "vorder": 109,
    "position": 0,
    "text": "پیاده سپردار و نیزه‌وران"
  },
  {
    "poem_id": 1471,
    "vorder": 110,
    "position": 1,
    "text": "شده انجمن لشکری بی‌کران"
  },
  {
    "poem_id": 1471,
    "vorder": 111,
    "position": 0,
    "text": "نشسته سپهدار بر تخت عاج"
  },
  {
    "poem_id": 1471,
    "vorder": 112,
    "position": 1,
    "text": "نهاده بران عاج کرسی ساج"
  },
  {
    "poem_id": 1471,
    "vorder": 113,
    "position": 0,
    "text": "ز هودج فرو هشته دیبا جلیل"
  },
  {
    "poem_id": 1471,
    "vorder": 114,
    "position": 1,
    "text": "غلام ایستاده رده خیل خیل"
  },
  {
    "poem_id": 1471,
    "vorder": 115,
    "position": 0,
    "text": "بر خیمه نزدیک پرده‌سرای"
  },
  {
    "poem_id": 1471,
    "vorder": 116,
    "position": 1,
    "text": "به دهلیز چندی پیاده به پای"
  },
  {
    "poem_id": 1471,
    "vorder": 117,
    "position": 0,
    "text": "بدو گفت کاو را فریبرز خوان"
  },
  {
    "poem_id": 1471,
    "vorder": 118,
    "position": 1,
    "text": "که فرزند شاهست و تاج گوان"
  },
  {
    "poem_id": 1471,
    "vorder": 119,
    "position": 0,
    "text": "بپرسید کان سرخ پرده‌سرای"
  },
  {
    "poem_id": 1471,
    "vorder": 120,
    "position": 1,
    "text": "به دهلیز چندی پیاده به پای"
  },
  {
    "poem_id": 1471,
    "vorder": 121,
    "position": 0,
    "text": "به گرد اندرش سرخ و زرد و بنفش"
  },
  {
    "poem_id": 1471,
    "vorder": 122,
    "position": 1,
    "text": "ز هرگونه‌ای برکشیده درفش"
  },
  {
    "poem_id": 1471,
    "vorder": 123,
    "position": 0,
    "text": "درفشی پس پشت پیکرگراز"
  },
  {
    "poem_id": 1471,
    "vorder": 124,
    "position": 1,
    "text": "سرش ماه زرین و بالا دراز"
  },
  {
    "poem_id": 1471,
    "vorder": 125,
    "position": 0,
    "text": "چنین گفت کاو را گرازست نام"
  },
  {
    "poem_id": 1471,
    "vorder": 126,
    "position": 1,
    "text": "که در جنگ شیران ندارد لگام"
  },
  {
    "poem_id": 1471,
    "vorder": 127,
    "position": 0,
    "text": "هشیوار و ز تخمهٔ گیوگان"
  },
  {
    "poem_id": 1471,
    "vorder": 128,
    "position": 1,
    "text": "که بر درد و سختی نگردد ژگان"
  },
  {
    "poem_id": 1471,
    "vorder": 129,
    "position": 0,
    "text": "نشان پدر جست و با او نگفت"
  },
  {
    "poem_id": 1471,
    "vorder": 130,
    "position": 1,
    "text": "همی داشت آن راستی در نهفت"
  },
  {
    "poem_id": 1471,
    "vorder": 131,
    "position": 0,
    "text": "تو گیتی چه سازی که خود ساخت‌ست"
  },
  {
    "poem_id": 1471,
    "vorder": 132,
    "position": 1,
    "text": "جهاندار ازین کار پرداخت‌ست"
  },
  {
    "poem_id": 1471,
    "vorder": 133,
    "position": 0,
    "text": "زمانه نبشته دگرگونه داشت"
  },
  {
    "poem_id": 1471,
    "vorder": 134,
    "position": 1,
    "text": "چنان کاو گذارد بباید گذاشت"
  },
  {
    "poem_id": 1471,
    "vorder": 135,
    "position": 0,
    "text": "دگر باره پرسید ازان سرفراز"
  },
  {
    "poem_id": 1471,
    "vorder": 136,
    "position": 1,
    "text": "ازان کش به دیدار او بد نیاز"
  },
  {
    "poem_id": 1471,
    "vorder": 137,
    "position": 0,
    "text": "ازان پردهٔ سبز و مرد بلند"
  },
  {
    "poem_id": 1471,
    "vorder": 138,
    "position": 1,
    "text": "وزان اسپ و آن تاب داده کمند"
  },
  {
    "poem_id": 1471,
    "vorder": 139,
    "position": 0,
    "text": "ازان پس هجیر سپهبدش گفت"
  },
  {
    "poem_id": 1471,
    "vorder": 140,
    "position": 1,
    "text": "که از تو سخن را چه باید نهفت"
  },
  {
    "poem_id": 1471,
    "vorder": 141,
    "position": 0,
    "text": "گر از نام چینی بمانم همی"
  },
  {
    "poem_id": 1471,
    "vorder": 142,
    "position": 1,
    "text": "ازان است کاو را ندانم همی"
  },
  {
    "poem_id": 1471,
    "vorder": 143,
    "position": 0,
    "text": "بدو گفت سهراب کاین نیست داد"
  },
  {
    "poem_id": 1471,
    "vorder": 144,
    "position": 1,
    "text": "ز رستم نکردی سخن هیچ یاد"
  },
  {
    "poem_id": 1471,
    "vorder": 145,
    "position": 0,
    "text": "کسی کاو بود پهلوان جهان"
  },
  {
    "poem_id": 1471,
    "vorder": 146,
    "position": 1,
    "text": "میان سپه در نماند نهان"
  },
  {
    "poem_id": 1471,
    "vorder": 147,
    "position": 0,
    "text": "تو گفتی که بر لشکر او مهترست"
  },
  {
    "poem_id": 1471,
    "vorder": 148,
    "position": 1,
    "text": "نگهبان هر مرز و هر کشورست"
  },
  {
    "poem_id": 1471,
    "vorder": 149,
    "position": 0,
    "text": "چنین داد پاسخ مر او را هجیر"
  },
  {
    "poem_id": 1471,
    "vorder": 150,
    "position": 1,
    "text": "که شاید بدن کان گو شیرگیر"
  },
  {
    "poem_id": 1471,
    "vorder": 151,
    "position": 0,
    "text": "کنون رفته باشد به زابلستان"
  },
  {
    "poem_id": 1471,
    "vorder": 152,
    "position": 1,
    "text": "که هنگام بزمست در گلستان"
  },
  {
    "poem_id": 1471,
    "vorder": 153,
    "position": 0,
    "text": "بدو گفت سهراب کاین خود مگوی"
  },
  {
    "poem_id": 1471,
    "vorder": 154,
    "position": 1,
    "text": "که دارد سپهبد سوی جنگ روی"
  },
  {
    "poem_id": 1471,
    "vorder": 155,
    "position": 0,
    "text": "به رامش نشیند جهان پهلوان"
  },
  {
    "poem_id": 1471,
    "vorder": 156,
    "position": 1,
    "text": "برو بر بخندند پیر و جوان"
  },
  {
    "poem_id": 1471,
    "vorder": 157,
    "position": 0,
    "text": "مرا با تو امروز پیمان یکیست"
  },
  {
    "poem_id": 1471,
    "vorder": 158,
    "position": 1,
    "text": "بگوییم و گفتار ما اندکیست"
  },
  {
    "poem_id": 1471,
    "vorder": 159,
    "position": 0,
    "text": "اگر پهلوان را نمایی به من"
  },
  {
    "poem_id": 1471,
    "vorder": 160,
    "position": 1,
    "text": "سرافراز باشی به هر انجمن"
  },
  {
    "poem_id": 1471,
    "vorder": 161,
    "position": 0,
    "text": "ترا بی‌نیازی دهم در جهان"
  },
  {
    "poem_id": 1471,
    "vorder": 162,
    "position": 1,
    "text": "گشاده کنم گنجهای نهان"
  },
  {
    "poem_id": 1471,
    "vorder": 163,
    "position": 0,
    "text": "ور ایدون که این راز داری ز من"
  },
  {
    "poem_id": 1471,
    "vorder": 164,
    "position": 1,
    "text": "گشاده بپوشی به من بر سخن"
  },
  {
    "poem_id": 1471,
    "vorder": 165,
    "position": 0,
    "text": "سرت را نخواهد همی تن به جای"
  },
  {
    "poem_id": 1471,
    "vorder": 166,
    "position": 1,
    "text": "نگر تا کدامین به آیدت رای"
  },
  {
    "poem_id": 1471,
    "vorder": 167,
    "position": 0,
    "text": "نبینی که موبد به خسرو چه گفت"
  },
  {
    "poem_id": 1471,
    "vorder": 168,
    "position": 1,
    "text": "بدانگه که بگشاد راز از نهفت"
  },
  {
    "poem_id": 1471,
    "vorder": 169,
    "position": 0,
    "text": "سخن گفت ناگفته چون گوهرست"
  },
  {
    "poem_id": 1471,
    "vorder": 170,
    "position": 1,
    "text": "کجا نابسوده به سنگ اندرست"
  },
  {
    "poem_id": 1471,
    "vorder": 171,
    "position": 0,
    "text": "چو از بند و پیوند یابد رها"
  },
  {
    "poem_id": 1471,
    "vorder": 172,
    "position": 1,
    "text": "درخشنده مهری بود بی‌بها"
  },
  {
    "poem_id": 1471,
    "vorder": 173,
    "position": 0,
    "text": "چنین داد پاسخ هجیرش که شاه"
  },
  {
    "poem_id": 1471,
    "vorder": 174,
    "position": 1,
    "text": "چو سیر آید از مهر وز تاج و گاه"
  },
  {
    "poem_id": 1471,
    "vorder": 175,
    "position": 0,
    "text": "نبرد کسی جویداندر جهان"
  },
  {
    "poem_id": 1471,
    "vorder": 176,
    "position": 1,
    "text": "که او ژنده پیل اندر آرد ز جان"
  },
  {
    "poem_id": 1471,
    "vorder": 177,
    "position": 0,
    "text": "کسی را که رستم بود هم نبرد"
  },
  {
    "poem_id": 1471,
    "vorder": 178,
    "position": 1,
    "text": "سرش ز آسمان اندر آید به گرد"
  },
  {
    "poem_id": 1471,
    "vorder": 179,
    "position": 0,
    "text": "تنش زور دارد به صد زورمند"
  },
  {
    "poem_id": 1471,
    "vorder": 180,
    "position": 1,
    "text": "سرش برترست از درخت بلند"
  },
  {
    "poem_id": 1471,
    "vorder": 181,
    "position": 0,
    "text": "چنو خشم گیرد به روز نبرد"
  },
  {
    "poem_id": 1471,
    "vorder": 182,
    "position": 1,
    "text": "چه هم رزم او ژنده پیل و چه مرد"
  },
  {
    "poem_id": 1471,
    "vorder": 183,
    "position": 0,
    "text": "هم‌آورد او بر زمین پیل نیست"
  },
  {
    "poem_id": 1471,
    "vorder": 184,
    "position": 1,
    "text": "چو گرد پی رخش او نیل نیست"
  },
  {
    "poem_id": 1471,
    "vorder": 185,
    "position": 0,
    "text": "بدو گفت سهراب از آزادگان"
  },
  {
    "poem_id": 1471,
    "vorder": 186,
    "position": 1,
    "text": "سیه بخت گودرز کشوادگان"
  },
  {
    "poem_id": 1471,
    "vorder": 187,
    "position": 0,
    "text": "چرا چون ترا خواند باید پسر"
  },
  {
    "poem_id": 1471,
    "vorder": 188,
    "position": 1,
    "text": "بدین زور و این دانش و این هنر"
  },
  {
    "poem_id": 1471,
    "vorder": 189,
    "position": 0,
    "text": "تو مردان جنگی کجا دیده‌ای"
  },
  {
    "poem_id": 1471,
    "vorder": 190,
    "position": 1,
    "text": "که بانگ پی اسپ نشنیده‌ای"
  },
  {
    "poem_id": 1471,
    "vorder": 191,
    "position": 0,
    "text": "که چندین ز رستم سخن بایدت"
  },
  {
    "poem_id": 1471,
    "vorder": 192,
    "position": 1,
    "text": "زبان بر ستودنش بگشایدت"
  },
  {
    "poem_id": 1471,
    "vorder": 193,
    "position": 0,
    "text": "از آتش ترا بیم چندان بود"
  },
  {
    "poem_id": 1471,
    "vorder": 194,
    "position": 1,
    "text": "که دریا به آرام خندان بود"
  },
  {
    "poem_id": 1471,
    "vorder": 195,
    "position": 0,
    "text": "چو دریای سبز اندر آید ز جای"
  },
  {
    "poem_id": 1471,
    "vorder": 196,
    "position": 1,
    "text": "ندارد دم آتش تیزپای"
  },
  {
    "poem_id": 1471,
    "vorder": 197,
    "position": 0,
    "text": "سر تیرگی اندر آید به خواب"
  },
  {
    "poem_id": 1471,
    "vorder": 198,
    "position": 1,
    "text": "چو تیغ از میان برکشد آفتاب"
  },
  {
    "poem_id": 1471,
    "vorder": 199,
    "position": 0,
    "text": "به دل گفت پس کاردیده هجیر"
  },
  {
    "poem_id": 1471,
    "vorder": 200,
    "position": 1,
    "text": "که گر من نشان گو شیرگیر"
  },
  {
    "poem_id": 1471,
    "vorder": 201,
    "position": 0,
    "text": "بگویم بدین ترک با زور دست"
  },
  {
    "poem_id": 1471,
    "vorder": 202,
    "position": 1,
    "text": "چنین یال و این خسروانی نشست"
  },
  {
    "poem_id": 1471,
    "vorder": 203,
    "position": 0,
    "text": "ز لشکر کند جنگ او ز انجمن"
  },
  {
    "poem_id": 1471,
    "vorder": 204,
    "position": 1,
    "text": "برانگیزد این بارهٔ پیلتن"
  },
  {
    "poem_id": 1471,
    "vorder": 205,
    "position": 0,
    "text": "برین زور و این کتف و این یال اوی"
  },
  {
    "poem_id": 1471,
    "vorder": 206,
    "position": 1,
    "text": "شود کشته رستم به چنگال اوی"
  },
  {
    "poem_id": 1471,
    "vorder": 207,
    "position": 0,
    "text": "از ایران نیاید کسی کینه خواه"
  },
  {
    "poem_id": 1471,
    "vorder": 208,
    "position": 1,
    "text": "بگیرد سر تخت کاووس شاه"
  },
  {
    "poem_id": 1471,
    "vorder": 209,
    "position": 0,
    "text": "چنین گفت موبد که مردن به نام"
  },
  {
    "poem_id": 1471,
    "vorder": 210,
    "position": 1,
    "text": "به از زنده دشمن بدو شادکام"
  },
  {
    "poem_id": 1471,
    "vorder": 211,
    "position": 0,
    "text": "اگر من شوم کشته بر دست اوی"
  },
  {
    "poem_id": 1471,
    "vorder": 212,
    "position": 1,
    "text": "نگردد سیه روز چون آب جوی"
  },
  {
    "poem_id": 1471,
    "vorder": 213,
    "position": 0,
    "text": "چو گودرز و هفتاد پور گزین"
  },
  {
    "poem_id": 1471,
    "vorder": 214,
    "position": 1,
    "text": "همه پهلوانان با آفرین"
  },
  {
    "poem_id": 1471,
    "vorder": 215,
    "position": 0,
    "text": "نباشد به ایران تن من مباد"
  },
  {
    "poem_id": 1471,
    "vorder": 216,
    "position": 1,
    "text": "چنین دارم از موبد پاک یاد"
  },
  {
    "poem_id": 1471,
    "vorder": 217,
    "position": 0,
    "text": "که چون برکشد از چمن بیخ سرو"
  },
  {
    "poem_id": 1471,
    "vorder": 218,
    "position": 1,
    "text": "سزد گر گیا را نبوید تذرو"
  },
  {
    "poem_id": 1471,
    "vorder": 219,
    "position": 0,
    "text": "به سهراب گفت این چه آشفتنست"
  },
  {
    "poem_id": 1471,
    "vorder": 220,
    "position": 1,
    "text": "همه با من از رستمت گفتنست"
  },
  {
    "poem_id": 1471,
    "vorder": 221,
    "position": 0,
    "text": "نباید ترا جست با او نبرد"
  },
  {
    "poem_id": 1471,
    "vorder": 222,
    "position": 1,
    "text": "برآرد به آوردگاه از تو گرد"
  },
  {
    "poem_id": 1471,
    "vorder": 223,
    "position": 0,
    "text": "همی پیلتن را نخواهی شکست"
  },
  {
    "poem_id": 1471,
    "vorder": 224,
    "position": 1,
    "text": "همانا که آسان نیاید به دست"
  }
]