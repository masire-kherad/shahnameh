[
  {
    "poem_id": 87957,
    "vorder": 1,
    "position": 0,
    "text": "سپهبد بشد تیز و برگشت شاه"
  },
  {
    "poem_id": 87957,
    "vorder": 2,
    "position": 1,
    "text": "سوی کاخ با رستم و با سپاه"
  },
  {
    "poem_id": 87957,
    "vorder": 3,
    "position": 0,
    "text": "یکی مجلس آراست با پیلتن"
  },
  {
    "poem_id": 87957,
    "vorder": 4,
    "position": 1,
    "text": "رد و موبد و خسرو رای زن"
  },
  {
    "poem_id": 87957,
    "vorder": 5,
    "position": 0,
    "text": "فراوان سخن گفت ز افراسیاب"
  },
  {
    "poem_id": 87957,
    "vorder": 6,
    "position": 1,
    "text": "ز رنج تن خویش وز درد باب"
  },
  {
    "poem_id": 87957,
    "vorder": 7,
    "position": 0,
    "text": "ز آزردن مادر پارسا"
  },
  {
    "poem_id": 87957,
    "vorder": 8,
    "position": 1,
    "text": "که با ما چه کرد آن بد پرجفا"
  },
  {
    "poem_id": 87957,
    "vorder": 9,
    "position": 0,
    "text": "مرا زی شبانان بی‌مایه داد"
  },
  {
    "poem_id": 87957,
    "vorder": 10,
    "position": 1,
    "text": "ز من کس ندانست نام و نژاد"
  },
  {
    "poem_id": 87957,
    "vorder": 11,
    "position": 0,
    "text": "فرستادم این بار طوس و سپاه"
  },
  {
    "poem_id": 87957,
    "vorder": 12,
    "position": 1,
    "text": "ازین پس من و تو گذاریم راه"
  },
  {
    "poem_id": 87957,
    "vorder": 13,
    "position": 0,
    "text": "جهان بر بداندیش تنگ آوریم"
  },
  {
    "poem_id": 87957,
    "vorder": 14,
    "position": 1,
    "text": "سر دشمنان زیر سنگ آوریم"
  },
  {
    "poem_id": 87957,
    "vorder": 15,
    "position": 0,
    "text": "ورا پیلتن گفت کین غم مدار"
  },
  {
    "poem_id": 87957,
    "vorder": 16,
    "position": 1,
    "text": "به کام تو گردد همه روزگار"
  },
  {
    "poem_id": 87957,
    "vorder": 17,
    "position": 0,
    "text": "وزان روی منزل بمنزل سپاه"
  },
  {
    "poem_id": 87957,
    "vorder": 18,
    "position": 1,
    "text": "همی رفت و پیش‌اندر آمد دو راه"
  },
  {
    "poem_id": 87957,
    "vorder": 19,
    "position": 0,
    "text": "ز یک سو بیابان بی آب و نم"
  },
  {
    "poem_id": 87957,
    "vorder": 20,
    "position": 1,
    "text": "کلات از دگر سوی و راه چرم"
  },
  {
    "poem_id": 87957,
    "vorder": 21,
    "position": 0,
    "text": "بماندند بر جای پیلان و کوس"
  },
  {
    "poem_id": 87957,
    "vorder": 22,
    "position": 1,
    "text": "بدان تا بیاید سپهدار طوس"
  },
  {
    "poem_id": 87957,
    "vorder": 23,
    "position": 0,
    "text": "کدامین پسند آیدش زین دو راه"
  },
  {
    "poem_id": 87957,
    "vorder": 24,
    "position": 1,
    "text": "بفرمان رود هم بران ره سپاه"
  },
  {
    "poem_id": 87957,
    "vorder": 25,
    "position": 0,
    "text": "چو آمد بر سرکشان طوس نرم"
  },
  {
    "poem_id": 87957,
    "vorder": 26,
    "position": 1,
    "text": "سخن گفت ازان راه بی‌آب و گرم"
  },
  {
    "poem_id": 87957,
    "vorder": 27,
    "position": 0,
    "text": "بگودرز گفت این بیابان خشک"
  },
  {
    "poem_id": 87957,
    "vorder": 28,
    "position": 1,
    "text": "اگر گرد عنبر دهد باد مشک"
  },
  {
    "poem_id": 87957,
    "vorder": 29,
    "position": 0,
    "text": "چو رانیم روزی به تندی دراز"
  },
  {
    "poem_id": 87957,
    "vorder": 30,
    "position": 1,
    "text": "بآب و بآسایش آید نیاز"
  },
  {
    "poem_id": 87957,
    "vorder": 31,
    "position": 0,
    "text": "همان به که سوی کلات و چرم"
  },
  {
    "poem_id": 87957,
    "vorder": 32,
    "position": 1,
    "text": "برانیم و منزل کنیم از میم"
  },
  {
    "poem_id": 87957,
    "vorder": 33,
    "position": 0,
    "text": "چپ و راست آباد و آب روان"
  },
  {
    "poem_id": 87957,
    "vorder": 34,
    "position": 1,
    "text": "بیابان چه جوییم و رنج روان"
  },
  {
    "poem_id": 87957,
    "vorder": 35,
    "position": 0,
    "text": "مرا بود روزی بدین ره گذر"
  },
  {
    "poem_id": 87957,
    "vorder": 36,
    "position": 1,
    "text": "چو گژدهم پیش سپه راهبر"
  },
  {
    "poem_id": 87957,
    "vorder": 37,
    "position": 0,
    "text": "ندیدیم از این راه رنجی دراز"
  },
  {
    "poem_id": 87957,
    "vorder": 38,
    "position": 1,
    "text": "مگر بود لختی نشیب و فراز"
  },
  {
    "poem_id": 87957,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت گودرز پرمایه شاه"
  },
  {
    "poem_id": 87957,
    "vorder": 40,
    "position": 1,
    "text": "ترا پیش‌رو کرد پیش سپاه"
  },
  {
    "poem_id": 87957,
    "vorder": 41,
    "position": 0,
    "text": "بران ره که گفت او سپه را بران"
  },
  {
    "poem_id": 87957,
    "vorder": 42,
    "position": 1,
    "text": "نباید که آید کسی را زیان"
  },
  {
    "poem_id": 87957,
    "vorder": 43,
    "position": 0,
    "text": "نباید که گردد دل‌آزرده شاه"
  },
  {
    "poem_id": 87957,
    "vorder": 44,
    "position": 1,
    "text": "بد آید ز آزار او بر سپاه"
  },
  {
    "poem_id": 87957,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت طوس ای گو نامدار"
  },
  {
    "poem_id": 87957,
    "vorder": 46,
    "position": 1,
    "text": "ازین گونه اندیشه در دل مدار"
  },
  {
    "poem_id": 87957,
    "vorder": 47,
    "position": 0,
    "text": "کزین شاه را دل نگردد دژم"
  },
  {
    "poem_id": 87957,
    "vorder": 48,
    "position": 1,
    "text": "سزد گر نداری روان جفت غم"
  },
  {
    "poem_id": 87957,
    "vorder": 49,
    "position": 0,
    "text": "همان به که لشکر بدین سو بریم"
  },
  {
    "poem_id": 87957,
    "vorder": 50,
    "position": 1,
    "text": "بیابان و فرسنگها نشمریم"
  },
  {
    "poem_id": 87957,
    "vorder": 51,
    "position": 0,
    "text": "بدین گفته بودند همداستان"
  },
  {
    "poem_id": 87957,
    "vorder": 52,
    "position": 1,
    "text": "برین بر نزد نیز کس داستان"
  },
  {
    "poem_id": 87957,
    "vorder": 53,
    "position": 0,
    "text": "براندند ازان راه پیلان و کوس"
  },
  {
    "poem_id": 87957,
    "vorder": 54,
    "position": 1,
    "text": "بفرمان و رای سپهدار طوس"
  }
]