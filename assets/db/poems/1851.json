[
  {
    "poem_id": 1851,
    "vorder": 1,
    "position": 0,
    "text": "همی‌تاخت خسرو به پیش اندرون"
  },
  {
    "poem_id": 1851,
    "vorder": 2,
    "position": 1,
    "text": "نه آب وگیا بود و نه رهنمون"
  },
  {
    "poem_id": 1851,
    "vorder": 3,
    "position": 0,
    "text": "عنان را بدان باره کرده یله"
  },
  {
    "poem_id": 1851,
    "vorder": 4,
    "position": 1,
    "text": "همی‌راند ناکام تا باهله"
  },
  {
    "poem_id": 1851,
    "vorder": 5,
    "position": 0,
    "text": "پذیره شدندش بزرگان شهر"
  },
  {
    "poem_id": 1851,
    "vorder": 6,
    "position": 1,
    "text": "کسی را که از مردمی بود بهر"
  },
  {
    "poem_id": 1851,
    "vorder": 7,
    "position": 0,
    "text": "چو خسرو به نزدیک ایشان رسید"
  },
  {
    "poem_id": 1851,
    "vorder": 8,
    "position": 1,
    "text": "بران شهر لشکر فرود آورید"
  },
  {
    "poem_id": 1851,
    "vorder": 9,
    "position": 0,
    "text": "همان چون فرود آمد اندر زمان"
  },
  {
    "poem_id": 1851,
    "vorder": 10,
    "position": 1,
    "text": "نوندی بیامد ز ایران دمان"
  },
  {
    "poem_id": 1851,
    "vorder": 11,
    "position": 0,
    "text": "ز بهرام چوبین یکی نامه داشت"
  },
  {
    "poem_id": 1851,
    "vorder": 12,
    "position": 1,
    "text": "همان نامه پوشیده در جامه داشت"
  },
  {
    "poem_id": 1851,
    "vorder": 13,
    "position": 0,
    "text": "نوشته سوی مهتری باهله"
  },
  {
    "poem_id": 1851,
    "vorder": 14,
    "position": 1,
    "text": "که گرلشکر آید مکنشان یله"
  },
  {
    "poem_id": 1851,
    "vorder": 15,
    "position": 0,
    "text": "سپاه من اینک پس اندر دمان"
  },
  {
    "poem_id": 1851,
    "vorder": 16,
    "position": 1,
    "text": "بشهر تو آید زمان تا زمان"
  },
  {
    "poem_id": 1851,
    "vorder": 17,
    "position": 0,
    "text": "چو مهتر برانگونه برنامه دید"
  },
  {
    "poem_id": 1851,
    "vorder": 18,
    "position": 1,
    "text": "هم اندر زمان پیش خسرو دوید"
  },
  {
    "poem_id": 1851,
    "vorder": 19,
    "position": 0,
    "text": "چوخسرو نگه کرد و نامه بخواند"
  },
  {
    "poem_id": 1851,
    "vorder": 20,
    "position": 1,
    "text": "ز کار جهان در شگفتی بماند"
  },
  {
    "poem_id": 1851,
    "vorder": 21,
    "position": 0,
    "text": "بترسید که آید پس او سپاه"
  },
  {
    "poem_id": 1851,
    "vorder": 22,
    "position": 1,
    "text": "بران نامه بر تنگدل گشت شاه"
  },
  {
    "poem_id": 1851,
    "vorder": 23,
    "position": 0,
    "text": "ازان شهر هم در زمان برنشست"
  },
  {
    "poem_id": 1851,
    "vorder": 24,
    "position": 1,
    "text": "میان کیی تاختن را ببست"
  },
  {
    "poem_id": 1851,
    "vorder": 25,
    "position": 0,
    "text": "همی‌تاخت تا پیش آب فرات"
  },
  {
    "poem_id": 1851,
    "vorder": 26,
    "position": 1,
    "text": "ندید اندرو هیچ جای نبات"
  },
  {
    "poem_id": 1851,
    "vorder": 27,
    "position": 0,
    "text": "شده گرسنه مرد پیر وجوان"
  },
  {
    "poem_id": 1851,
    "vorder": 28,
    "position": 1,
    "text": "یکی بیشه دیدند و آب روان"
  },
  {
    "poem_id": 1851,
    "vorder": 29,
    "position": 0,
    "text": "چوخسرو به پیش اندرون بیشه دید"
  },
  {
    "poem_id": 1851,
    "vorder": 30,
    "position": 1,
    "text": "سپه را بران سبزه اندر کشید"
  },
  {
    "poem_id": 1851,
    "vorder": 31,
    "position": 0,
    "text": "شده گرسنه مرد ناهاروسست"
  },
  {
    "poem_id": 1851,
    "vorder": 32,
    "position": 1,
    "text": "کمان را بزه کرد نخچیر جست"
  },
  {
    "poem_id": 1851,
    "vorder": 33,
    "position": 0,
    "text": "ندیدند چیزی بجایی دوان"
  },
  {
    "poem_id": 1851,
    "vorder": 34,
    "position": 1,
    "text": "درخت و گیا بود و آب روان"
  },
  {
    "poem_id": 1851,
    "vorder": 35,
    "position": 0,
    "text": "پدید آمد اندر زمان کاروان"
  },
  {
    "poem_id": 1851,
    "vorder": 36,
    "position": 1,
    "text": "شتر بود و پیش اندرون ساروان"
  },
  {
    "poem_id": 1851,
    "vorder": 37,
    "position": 0,
    "text": "چو آن ساربان روی خسرو بدید"
  },
  {
    "poem_id": 1851,
    "vorder": 38,
    "position": 1,
    "text": "بدان نامدار آفرین گسترید"
  },
  {
    "poem_id": 1851,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت خسرو که نام توچیست"
  },
  {
    "poem_id": 1851,
    "vorder": 40,
    "position": 1,
    "text": "کجا رفت خواهی و کام تو چیست"
  },
  {
    "poem_id": 1851,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت من قیس بن حارثم"
  },
  {
    "poem_id": 1851,
    "vorder": 42,
    "position": 1,
    "text": "ز آزادگان عرب وارثم"
  },
  {
    "poem_id": 1851,
    "vorder": 43,
    "position": 0,
    "text": "ز مصر آمدم با یکی کاروان"
  },
  {
    "poem_id": 1851,
    "vorder": 44,
    "position": 1,
    "text": "برین کاروان بر منم ساروان"
  },
  {
    "poem_id": 1851,
    "vorder": 45,
    "position": 0,
    "text": "به آب فراتست بنگاه من"
  },
  {
    "poem_id": 1851,
    "vorder": 46,
    "position": 1,
    "text": "از انجا بدین بیشه بد راه من"
  },
  {
    "poem_id": 1851,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت خسروکه از خوردنی"
  },
  {
    "poem_id": 1851,
    "vorder": 48,
    "position": 1,
    "text": "چه داری هم از چیز گستردنی"
  },
  {
    "poem_id": 1851,
    "vorder": 49,
    "position": 0,
    "text": "که ما ماندگانیم و هم گرسنه"
  },
  {
    "poem_id": 1851,
    "vorder": 50,
    "position": 1,
    "text": "نه توشست ما را نه بار و بنه"
  },
  {
    "poem_id": 1851,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت تازی که ایدر بایست"
  },
  {
    "poem_id": 1851,
    "vorder": 52,
    "position": 1,
    "text": "مرا با تو چیز و تن جان یکیست"
  },
  {
    "poem_id": 1851,
    "vorder": 53,
    "position": 0,
    "text": "چو بر شاه تازی بگسترد مهر"
  },
  {
    "poem_id": 1851,
    "vorder": 54,
    "position": 1,
    "text": "بیاورد فربه یکی ماده سهر"
  },
  {
    "poem_id": 1851,
    "vorder": 55,
    "position": 0,
    "text": "بکشتند و آتش بر افروختند"
  },
  {
    "poem_id": 1851,
    "vorder": 56,
    "position": 1,
    "text": "ترو خشک هیزم همی‌سوختند"
  },
  {
    "poem_id": 1851,
    "vorder": 57,
    "position": 0,
    "text": "بر آتش پراگند چندی کباب"
  },
  {
    "poem_id": 1851,
    "vorder": 58,
    "position": 1,
    "text": "بخوردن گرفتند یاران شتاب"
  },
  {
    "poem_id": 1851,
    "vorder": 59,
    "position": 0,
    "text": "گرفتند واژ آنک بد دین پژوه"
  },
  {
    "poem_id": 1851,
    "vorder": 60,
    "position": 1,
    "text": "بخوردن شتابید دیگر گروه"
  },
  {
    "poem_id": 1851,
    "vorder": 61,
    "position": 0,
    "text": "بخوردند بی‌نان فراوان کباب"
  },
  {
    "poem_id": 1851,
    "vorder": 62,
    "position": 1,
    "text": "بیاراست هر مهتری جای خواب"
  },
  {
    "poem_id": 1851,
    "vorder": 63,
    "position": 0,
    "text": "زمانی بخفتند و برخاستند"
  },
  {
    "poem_id": 1851,
    "vorder": 64,
    "position": 1,
    "text": "یکی آفرین نو آراستند"
  },
  {
    "poem_id": 1851,
    "vorder": 65,
    "position": 0,
    "text": "بدان دادگر کو جهان آفرید"
  },
  {
    "poem_id": 1851,
    "vorder": 66,
    "position": 1,
    "text": "توانایی و ناتوان آفرید"
  },
  {
    "poem_id": 1851,
    "vorder": 67,
    "position": 0,
    "text": "ازان پس به یاران چنین گفت شاه"
  },
  {
    "poem_id": 1851,
    "vorder": 68,
    "position": 1,
    "text": "که هرکس که او بیش دارد گناه"
  },
  {
    "poem_id": 1851,
    "vorder": 69,
    "position": 0,
    "text": "به پیش من آنکس گرامی ترست"
  },
  {
    "poem_id": 1851,
    "vorder": 70,
    "position": 1,
    "text": "وزان کهتران نیز نامی ترست"
  },
  {
    "poem_id": 1851,
    "vorder": 71,
    "position": 0,
    "text": "هرآنکس کجا بیش دارد بدی"
  },
  {
    "poem_id": 1851,
    "vorder": 72,
    "position": 1,
    "text": "بگشت از من و از ره بخردی"
  },
  {
    "poem_id": 1851,
    "vorder": 73,
    "position": 0,
    "text": "بما بیش باید که دارد امید"
  },
  {
    "poem_id": 1851,
    "vorder": 74,
    "position": 1,
    "text": "سراسر به نیکی دهیدش نوید"
  },
  {
    "poem_id": 1851,
    "vorder": 75,
    "position": 0,
    "text": "گرفتند یاران برو آفرین"
  },
  {
    "poem_id": 1851,
    "vorder": 76,
    "position": 1,
    "text": "که ای پاک دل خسرو پاک دین"
  },
  {
    "poem_id": 1851,
    "vorder": 77,
    "position": 0,
    "text": "بپرسید زان مرد تازی که راه"
  },
  {
    "poem_id": 1851,
    "vorder": 78,
    "position": 1,
    "text": "کدامست و من چون شوم با سپاه"
  },
  {
    "poem_id": 1851,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت هفتاد فرسنگ بیش"
  },
  {
    "poem_id": 1851,
    "vorder": 80,
    "position": 1,
    "text": "شما را بیابان و کوهست پیش"
  },
  {
    "poem_id": 1851,
    "vorder": 81,
    "position": 0,
    "text": "چودستور باشی من ازگوشت و آب"
  },
  {
    "poem_id": 1851,
    "vorder": 82,
    "position": 1,
    "text": "به راه آورم گر نسازی شتاب"
  },
  {
    "poem_id": 1851,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت خسرو جزین نیست رای"
  },
  {
    "poem_id": 1851,
    "vorder": 84,
    "position": 1,
    "text": "که با توشه باشیم و با رهنمای"
  },
  {
    "poem_id": 1851,
    "vorder": 85,
    "position": 0,
    "text": "هیونی بر افگند تازی به راه"
  },
  {
    "poem_id": 1851,
    "vorder": 86,
    "position": 1,
    "text": "بدان تا برد راه پیش سپاه"
  },
  {
    "poem_id": 1851,
    "vorder": 87,
    "position": 0,
    "text": "همی‌تاخت اندر بیابان و کوه"
  },
  {
    "poem_id": 1851,
    "vorder": 88,
    "position": 1,
    "text": "پر از رنج و تیمار با آن گروه"
  },
  {
    "poem_id": 1851,
    "vorder": 89,
    "position": 0,
    "text": "یکی کاروان نیز دیگر به راه"
  },
  {
    "poem_id": 1851,
    "vorder": 90,
    "position": 1,
    "text": "پدید آمد از دور پیش سپاه"
  },
  {
    "poem_id": 1851,
    "vorder": 91,
    "position": 0,
    "text": "یکی مرد بازارگان مایه دار"
  },
  {
    "poem_id": 1851,
    "vorder": 92,
    "position": 1,
    "text": "بیامد هم آنگه بر شهریار"
  },
  {
    "poem_id": 1851,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت شاه از کجایی بگوی"
  },
  {
    "poem_id": 1851,
    "vorder": 94,
    "position": 1,
    "text": "کجا رفت خواهی چنین پوی پوی"
  },
  {
    "poem_id": 1851,
    "vorder": 95,
    "position": 0,
    "text": "بدو گفت کز خرهٔ اردشیر"
  },
  {
    "poem_id": 1851,
    "vorder": 96,
    "position": 1,
    "text": "یکی مرد بازارگانم دبیر"
  },
  {
    "poem_id": 1851,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت نامت چه کرد آنک زاد"
  },
  {
    "poem_id": 1851,
    "vorder": 98,
    "position": 1,
    "text": "چنین داد پاسخ که مهران ستاد"
  },
  {
    "poem_id": 1851,
    "vorder": 99,
    "position": 0,
    "text": "ازو توشه جست آن زمان شهریار"
  },
  {
    "poem_id": 1851,
    "vorder": 100,
    "position": 1,
    "text": "بدو گفت سالار کای نامدار"
  },
  {
    "poem_id": 1851,
    "vorder": 101,
    "position": 0,
    "text": "خورش هست چندانک اندازه نیست"
  },
  {
    "poem_id": 1851,
    "vorder": 102,
    "position": 1,
    "text": "اگر چهره بازارگان تازه نیست"
  },
  {
    "poem_id": 1851,
    "vorder": 103,
    "position": 0,
    "text": "بدو گفت خسرو که مهمان به راه"
  },
  {
    "poem_id": 1851,
    "vorder": 104,
    "position": 1,
    "text": "بیابی فزونی شود دستگاه"
  },
  {
    "poem_id": 1851,
    "vorder": 105,
    "position": 0,
    "text": "سر بار بگشاد بازارگان"
  },
  {
    "poem_id": 1851,
    "vorder": 106,
    "position": 1,
    "text": "درمگان به آمد ز دینارگان"
  },
  {
    "poem_id": 1851,
    "vorder": 107,
    "position": 0,
    "text": "خورش برد و بنشست خود بر زمین"
  },
  {
    "poem_id": 1851,
    "vorder": 108,
    "position": 1,
    "text": "همی‌خواند بر شهریار آفرین"
  },
  {
    "poem_id": 1851,
    "vorder": 109,
    "position": 0,
    "text": "چونان خورده شد مرد مهمان پرست"
  },
  {
    "poem_id": 1851,
    "vorder": 110,
    "position": 1,
    "text": "بیامد گرفت آبدستان بدست"
  },
  {
    "poem_id": 1851,
    "vorder": 111,
    "position": 0,
    "text": "چو از دور خراد برزین بدید"
  },
  {
    "poem_id": 1851,
    "vorder": 112,
    "position": 1,
    "text": "ز جایی که بد پیش خسرو دوید"
  },
  {
    "poem_id": 1851,
    "vorder": 113,
    "position": 0,
    "text": "ز بازارگان بستد آن آب گرم"
  },
  {
    "poem_id": 1851,
    "vorder": 114,
    "position": 1,
    "text": "بدن تا ندارد جهاندار شرم"
  },
  {
    "poem_id": 1851,
    "vorder": 115,
    "position": 0,
    "text": "پس آن مرد بازارگان پر شتاب"
  },
  {
    "poem_id": 1851,
    "vorder": 116,
    "position": 1,
    "text": "می‌ آورد برسان روشن گلاب"
  },
  {
    "poem_id": 1851,
    "vorder": 117,
    "position": 0,
    "text": "دگر باره خراد برزین ز راه"
  },
  {
    "poem_id": 1851,
    "vorder": 118,
    "position": 1,
    "text": "ازو بستد آن جام و شد نزد شاه"
  },
  {
    "poem_id": 1851,
    "vorder": 119,
    "position": 0,
    "text": "پرستش پرستنده را داشت سود"
  },
  {
    "poem_id": 1851,
    "vorder": 120,
    "position": 1,
    "text": "بران برتری برتریها فزود"
  },
  {
    "poem_id": 1851,
    "vorder": 121,
    "position": 0,
    "text": "ازان پس ببازارگان گفت شاه"
  },
  {
    "poem_id": 1851,
    "vorder": 122,
    "position": 1,
    "text": "که اکنون سپه را کدامست راه"
  },
  {
    "poem_id": 1851,
    "vorder": 123,
    "position": 0,
    "text": "نشست تو در خره اردشیر"
  },
  {
    "poem_id": 1851,
    "vorder": 124,
    "position": 1,
    "text": "کجا باشد ای مرد مهمان‌پذیر"
  },
  {
    "poem_id": 1851,
    "vorder": 125,
    "position": 0,
    "text": "بدو گفت کای شاه با داد ورای"
  },
  {
    "poem_id": 1851,
    "vorder": 126,
    "position": 1,
    "text": "ز بازارگانان منم پاک رای"
  },
  {
    "poem_id": 1851,
    "vorder": 127,
    "position": 0,
    "text": "نشانش یکایک به خسرو بگفت"
  },
  {
