[
  {
    "poem_id": 1551,
    "vorder": 1,
    "position": 0,
    "text": "برآمد بسی روزگاری بدوی"
  },
  {
    "poem_id": 1551,
    "vorder": 2,
    "position": 1,
    "text": "که خسرو سوی سیستان کرد روی"
  },
  {
    "poem_id": 1551,
    "vorder": 3,
    "position": 0,
    "text": "که آنجا کند زند و استا روا"
  },
  {
    "poem_id": 1551,
    "vorder": 4,
    "position": 1,
    "text": "کند موبدان را بدانجا گوا"
  },
  {
    "poem_id": 1551,
    "vorder": 5,
    "position": 0,
    "text": "جو آنجا رسید آن گرانمایه شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 6,
    "position": 1,
    "text": "پذیره شدش پهلوان سپاه"
  },
  {
    "poem_id": 1551,
    "vorder": 7,
    "position": 0,
    "text": "شه نیمروز آنک رستمش نام"
  },
  {
    "poem_id": 1551,
    "vorder": 8,
    "position": 1,
    "text": "سوار جهاندیده همتای سام"
  },
  {
    "poem_id": 1551,
    "vorder": 9,
    "position": 0,
    "text": "ابا پیر دستان که بودش پدر"
  },
  {
    "poem_id": 1551,
    "vorder": 10,
    "position": 1,
    "text": "ابا مهتران و گزینان در"
  },
  {
    "poem_id": 1551,
    "vorder": 11,
    "position": 0,
    "text": "به شادی پذیره شدندش به راه"
  },
  {
    "poem_id": 1551,
    "vorder": 12,
    "position": 1,
    "text": "ازو شادمان گشت فرخنده شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 13,
    "position": 0,
    "text": "به زاولش بردند مهمان خویش"
  },
  {
    "poem_id": 1551,
    "vorder": 14,
    "position": 1,
    "text": "همه بنده‌وار ایستادند پیش"
  },
  {
    "poem_id": 1551,
    "vorder": 15,
    "position": 0,
    "text": "وزو زند و کشتی بیاموختند"
  },
  {
    "poem_id": 1551,
    "vorder": 16,
    "position": 1,
    "text": "ببستند و آذر برافروختند"
  },
  {
    "poem_id": 1551,
    "vorder": 17,
    "position": 0,
    "text": "برآمد برین میهمانی دو سال"
  },
  {
    "poem_id": 1551,
    "vorder": 18,
    "position": 1,
    "text": "همی خورد گشتاسپ با پور زال"
  },
  {
    "poem_id": 1551,
    "vorder": 19,
    "position": 0,
    "text": "به هرجا کجا شهریاران بدند"
  },
  {
    "poem_id": 1551,
    "vorder": 20,
    "position": 1,
    "text": "ازان کار گشتاسپ آگه شدند"
  },
  {
    "poem_id": 1551,
    "vorder": 21,
    "position": 0,
    "text": "که او مر سر پهلوان را ببست"
  },
  {
    "poem_id": 1551,
    "vorder": 22,
    "position": 1,
    "text": "تن پیل وارش به آهن بخست"
  },
  {
    "poem_id": 1551,
    "vorder": 23,
    "position": 0,
    "text": "به زاولستان شد به پیغمبری"
  },
  {
    "poem_id": 1551,
    "vorder": 24,
    "position": 1,
    "text": "که نفرین کند بر بت آزری"
  },
  {
    "poem_id": 1551,
    "vorder": 25,
    "position": 0,
    "text": "بگشتند یکسر ز فرمان شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 26,
    "position": 1,
    "text": "بهم برشکستند پیمان شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 27,
    "position": 0,
    "text": "چو آگاهی آمد به بهمن که شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 28,
    "position": 1,
    "text": "ببستست آن شیر را بی‌گناه"
  },
  {
    "poem_id": 1551,
    "vorder": 29,
    "position": 0,
    "text": "نبرده گزینان اسفندیار"
  },
  {
    "poem_id": 1551,
    "vorder": 30,
    "position": 1,
    "text": "ازانجا برفتند تیماردار"
  },
  {
    "poem_id": 1551,
    "vorder": 31,
    "position": 0,
    "text": "همی داشتند از سپه دست باز"
  },
  {
    "poem_id": 1551,
    "vorder": 32,
    "position": 1,
    "text": "پس اندر گرفتند راه دراز"
  },
  {
    "poem_id": 1551,
    "vorder": 33,
    "position": 0,
    "text": "به پیش گو اسفندیار آمدند"
  },
  {
    "poem_id": 1551,
    "vorder": 34,
    "position": 1,
    "text": "کیان‌زادگان شیروار آمدند"
  },
  {
    "poem_id": 1551,
    "vorder": 35,
    "position": 0,
    "text": "پدر را به رامش همی داشتند"
  },
  {
    "poem_id": 1551,
    "vorder": 36,
    "position": 1,
    "text": "به زندانش تنها بنگذاشتند"
  },
  {
    "poem_id": 1551,
    "vorder": 37,
    "position": 0,
    "text": "پس آگاهی آمد به سالار چین"
  },
  {
    "poem_id": 1551,
    "vorder": 38,
    "position": 1,
    "text": "که شاه از گمان اندرآمد به کین"
  },
  {
    "poem_id": 1551,
    "vorder": 39,
    "position": 0,
    "text": "برآشفت خسرو به اسفندیار"
  },
  {
    "poem_id": 1551,
    "vorder": 40,
    "position": 1,
    "text": "به زندان و بندش فرستاد خوار"
  },
  {
    "poem_id": 1551,
    "vorder": 41,
    "position": 0,
    "text": "خود از بلخ زی زابلستان کشید"
  },
  {
    "poem_id": 1551,
    "vorder": 42,
    "position": 1,
    "text": "بیابان گذارید و سیحون بدید"
  },
  {
    "poem_id": 1551,
    "vorder": 43,
    "position": 0,
    "text": "به زاول نشستست مهمان زال"
  },
  {
    "poem_id": 1551,
    "vorder": 44,
    "position": 1,
    "text": "برین روزگاران برآمد دو سال"
  },
  {
    "poem_id": 1551,
    "vorder": 45,
    "position": 0,
    "text": "به بلخ اندرونست لهراسپ شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 46,
    "position": 1,
    "text": "نماندست از ایرانیان و سپاه"
  },
  {
    "poem_id": 1551,
    "vorder": 47,
    "position": 0,
    "text": "مگر هفتصد مرد آتش پرست"
  },
  {
    "poem_id": 1551,
    "vorder": 48,
    "position": 1,
    "text": "هه پیش آذر برآورده دست"
  },
  {
    "poem_id": 1551,
    "vorder": 49,
    "position": 0,
    "text": "جز ایشان به بلخ اندرون نیست کس"
  },
  {
    "poem_id": 1551,
    "vorder": 50,
    "position": 1,
    "text": "از آهنگ‌داران همینند بس"
  },
  {
    "poem_id": 1551,
    "vorder": 51,
    "position": 0,
    "text": "مگر پاسبانان کاخ همای"
  },
  {
    "poem_id": 1551,
    "vorder": 52,
    "position": 1,
    "text": "هلا زود برخیز و چندین مپای"
  },
  {
    "poem_id": 1551,
    "vorder": 53,
    "position": 0,
    "text": "مهان را همه خواند شاه چگل"
  },
  {
    "poem_id": 1551,
    "vorder": 54,
    "position": 1,
    "text": "ابر جنگ لهراسپشان داد دل"
  },
  {
    "poem_id": 1551,
    "vorder": 55,
    "position": 0,
    "text": "بدانید گفتا که گشتاسپ شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 56,
    "position": 1,
    "text": "سوی نیمروز او سپردست راه"
  },
  {
    "poem_id": 1551,
    "vorder": 57,
    "position": 0,
    "text": "به زاول نشستست با لشکرش"
  },
  {
    "poem_id": 1551,
    "vorder": 58,
    "position": 1,
    "text": "سواری نه اندر همه کشورش"
  },
  {
    "poem_id": 1551,
    "vorder": 59,
    "position": 0,
    "text": "کنونست هنگام کین خواستن"
  },
  {
    "poem_id": 1551,
    "vorder": 60,
    "position": 1,
    "text": "بباید بسیچید و آراستن"
  },
  {
    "poem_id": 1551,
    "vorder": 61,
    "position": 0,
    "text": "پسرش آن گرانمایه اسفندیار"
  },
  {
    "poem_id": 1551,
    "vorder": 62,
    "position": 1,
    "text": "به بند گران‌اندرست استوار"
  },
  {
    "poem_id": 1551,
    "vorder": 63,
    "position": 0,
    "text": "کدامست مردی پژوهنده راز"
  },
  {
    "poem_id": 1551,
    "vorder": 64,
    "position": 1,
    "text": "که پیماید این ژرف راه دراز"
  },
  {
    "poem_id": 1551,
    "vorder": 65,
    "position": 0,
    "text": "نراند به راه ایچ و بی‌ره رود"
  },
  {
    "poem_id": 1551,
    "vorder": 66,
    "position": 1,
    "text": "ز ایران هراسان و آگه رود"
  },
  {
    "poem_id": 1551,
    "vorder": 67,
    "position": 0,
    "text": "یکی جادوی بود نامش ستوه"
  },
  {
    "poem_id": 1551,
    "vorder": 68,
    "position": 1,
    "text": "گذارنده راه و نهفته پژوه"
  },
  {
    "poem_id": 1551,
    "vorder": 69,
    "position": 0,
    "text": "منم گفت آهسته و نامجوی"
  },
  {
    "poem_id": 1551,
    "vorder": 70,
    "position": 1,
    "text": "چه باید ترا هرچ باید بگوی"
  },
  {
    "poem_id": 1551,
    "vorder": 71,
    "position": 0,
    "text": "شه چینش گفتا به ایران خرام"
  },
  {
    "poem_id": 1551,
    "vorder": 72,
    "position": 1,
    "text": "نگهبان آتش ببین تا کدام"
  },
  {
    "poem_id": 1551,
    "vorder": 73,
    "position": 0,
    "text": "پژوهندهٔ راز پیمود راه"
  },
  {
    "poem_id": 1551,
    "vorder": 74,
    "position": 1,
    "text": "به بلخ گزین شد که بد گاه شاه"
  },
  {
    "poem_id": 1551,
    "vorder": 75,
    "position": 0,
    "text": "ندید اندرون شاه گشتاسپ را"
  },
  {
    "poem_id": 1551,
    "vorder": 76,
    "position": 1,
    "text": "پرستنده‌ای دید و لهراسپ را"
  },
  {
    "poem_id": 1551,
    "vorder": 77,
    "position": 0,
    "text": "بشد همچنان پیش خاقان بگفت"
  },
  {
    "poem_id": 1551,
    "vorder": 78,
    "position": 1,
    "text": "به رخ پیش او بر زمین را برفت"
  },
  {
    "poem_id": 1551,
    "vorder": 79,
    "position": 0,
    "text": "چو ارجاسپ آگاه شد شاد گشت"
  },
  {
    "poem_id": 1551,
    "vorder": 80,
    "position": 1,
    "text": "از اندوه دیرینه آزاد گشت"
  },
  {
    "poem_id": 1551,
    "vorder": 81,
    "position": 0,
    "text": "سر آن را همه خواند و گفتا روید"
  },
  {
    "poem_id": 1551,
    "vorder": 82,
    "position": 1,
    "text": "سپاه پراگنده گرد آورید"
  },
  {
    "poem_id": 1551,
    "vorder": 83,
    "position": 0,
    "text": "برفتند گردان لشکر همه"
  },
  {
    "poem_id": 1551,
    "vorder": 84,
    "position": 1,
    "text": "به کوه و بیابان و جای رمه"
  },
  {
    "poem_id": 1551,
    "vorder": 85,
    "position": 0,
    "text": "بدو باز خواندند لشکرش را"
  },
  {
    "poem_id": 1551,
    "vorder": 86,
    "position": 1,
    "text": "گزیده سواران کشورش را"
  }
]