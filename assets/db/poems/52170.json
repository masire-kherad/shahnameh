[
  {
    "poem_id": 52170,
    "vorder": 1,
    "position": 0,
    "text": "بدانست هرمز که او دست خون"
  },
  {
    "poem_id": 52170,
    "vorder": 2,
    "position": 1,
    "text": "بیازد همی زنده بی‌رهنمون"
  },
  {
    "poem_id": 52170,
    "vorder": 3,
    "position": 0,
    "text": "شنید آن سخن‌های بی‌کام را"
  },
  {
    "poem_id": 52170,
    "vorder": 4,
    "position": 1,
    "text": "به زندان فرستاد بهرام را"
  },
  {
    "poem_id": 52170,
    "vorder": 5,
    "position": 0,
    "text": "دگر شب چو برزد سر از کوه ماه"
  },
  {
    "poem_id": 52170,
    "vorder": 6,
    "position": 1,
    "text": "به زندان دژ آگاه کردش تباه"
  },
  {
    "poem_id": 52170,
    "vorder": 7,
    "position": 0,
    "text": "نماند آن زمان بر درش بخردی"
  },
  {
    "poem_id": 52170,
    "vorder": 8,
    "position": 1,
    "text": "همان رهنمائی و هم موبدی"
  },
  {
    "poem_id": 52170,
    "vorder": 9,
    "position": 0,
    "text": "ز خوی بد آید همه بدتری"
  },
  {
    "poem_id": 52170,
    "vorder": 10,
    "position": 1,
    "text": "نگر تا سوی خوی بد ننگری"
  },
  {
    "poem_id": 52170,
    "vorder": 11,
    "position": 0,
    "text": "وزان پس نبد زندگانیش خوش"
  },
  {
    "poem_id": 52170,
    "vorder": 12,
    "position": 1,
    "text": "ز تیمار زد بر دل خویش تش"
  },
  {
    "poem_id": 52170,
    "vorder": 13,
    "position": 0,
    "text": "بسالی با صطخر بودی دو ماه"
  },
  {
    "poem_id": 52170,
    "vorder": 14,
    "position": 1,
    "text": "که کوتاه بودی شبان سیاه"
  },
  {
    "poem_id": 52170,
    "vorder": 15,
    "position": 0,
    "text": "که شهری خنک بود و روشن هوا"
  },
  {
    "poem_id": 52170,
    "vorder": 16,
    "position": 1,
    "text": "از آنجا گذشتن نبودی روا"
  },
  {
    "poem_id": 52170,
    "vorder": 17,
    "position": 0,
    "text": "چوپنهان شدی چادر لاژورد"
  },
  {
    "poem_id": 52170,
    "vorder": 18,
    "position": 1,
    "text": "پدید آمدی کوه یاقوت زرد"
  },
  {
    "poem_id": 52170,
    "vorder": 19,
    "position": 0,
    "text": "منادیگری برکشیدی خروش"
  },
  {
    "poem_id": 52170,
    "vorder": 20,
    "position": 1,
    "text": "که این نامداران با فر و هوش"
  },
  {
    "poem_id": 52170,
    "vorder": 21,
    "position": 0,
    "text": "اگر کشتمندی شود کوفته"
  },
  {
    "poem_id": 52170,
    "vorder": 22,
    "position": 1,
    "text": "وزان رنج کارنده آشوفته"
  },
  {
    "poem_id": 52170,
    "vorder": 23,
    "position": 0,
    "text": "وگر اسب در کشت زاری رود"
  },
  {
    "poem_id": 52170,
    "vorder": 24,
    "position": 1,
    "text": "کس نیز بر میوه داری رود"
  },
  {
    "poem_id": 52170,
    "vorder": 25,
    "position": 0,
    "text": "دم و گوش اسبش بباید برید"
  },
  {
    "poem_id": 52170,
    "vorder": 26,
    "position": 1,
    "text": "سر دزد بردار باید کشید"
  },
  {
    "poem_id": 52170,
    "vorder": 27,
    "position": 0,
    "text": "بدو ماه گردان بدی درجهان"
  },
  {
    "poem_id": 52170,
    "vorder": 28,
    "position": 1,
    "text": "بدو نیکویی زو نبودی نهان"
  },
  {
    "poem_id": 52170,
    "vorder": 29,
    "position": 0,
    "text": "بهر کشوری داد کردی چنین"
  },
  {
    "poem_id": 52170,
    "vorder": 30,
    "position": 1,
    "text": "ز دهقان همی‌یافتی آفرین"
  },
  {
    "poem_id": 52170,
    "vorder": 31,
    "position": 0,
    "text": "پسر بد مر او را گرامی یکی"
  },
  {
    "poem_id": 52170,
    "vorder": 32,
    "position": 1,
    "text": "که از ماه پیدا نبود اندکی"
  },
  {
    "poem_id": 52170,
    "vorder": 33,
    "position": 0,
    "text": "مر او را پدر کرده پرویز نام"
  },
  {
    "poem_id": 52170,
    "vorder": 34,
    "position": 1,
    "text": "گهش خواندی خسرو شادکام"
  },
  {
    "poem_id": 52170,
    "vorder": 35,
    "position": 0,
    "text": "نبودی جدا یک زمان از پدر"
  },
  {
    "poem_id": 52170,
    "vorder": 36,
    "position": 1,
    "text": "پدر نیز نشگیفتی از پسر"
  },
  {
    "poem_id": 52170,
    "vorder": 37,
    "position": 0,
    "text": "چنان بد که اسبی ز آخر بجست"
  },
  {
    "poem_id": 52170,
    "vorder": 38,
    "position": 1,
    "text": "که بد شاه پرویز را بر نشست"
  },
  {
    "poem_id": 52170,
    "vorder": 39,
    "position": 0,
    "text": "سوی کشتمند آمد اسب جوان"
  },
  {
    "poem_id": 52170,
    "vorder": 40,
    "position": 1,
    "text": "نگهبان اسب اندر آمد دوان"
  },
  {
    "poem_id": 52170,
    "vorder": 41,
    "position": 0,
    "text": "بیامد خداوند آن کشت زار"
  },
  {
    "poem_id": 52170,
    "vorder": 42,
    "position": 1,
    "text": "به پیش موکل بنالید زار"
  },
  {
    "poem_id": 52170,
    "vorder": 43,
    "position": 0,
    "text": "موکل بدو گفت کین اسب کیست"
  },
  {
    "poem_id": 52170,
    "vorder": 44,
    "position": 1,
    "text": "که بر دم و گوشش بباید گریست"
  },
  {
    "poem_id": 52170,
    "vorder": 45,
    "position": 0,
    "text": "خداوند گفت اسب پرویز شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 46,
    "position": 1,
    "text": "ندارد همی کهترانرا نگاه"
  },
  {
    "poem_id": 52170,
    "vorder": 47,
    "position": 0,
    "text": "بیامد موکل بر شهریار"
  },
  {
    "poem_id": 52170,
    "vorder": 48,
    "position": 1,
    "text": "بگفت آنچ بشنید از کشت زار"
  },
  {
    "poem_id": 52170,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت هرمز برفتن بکوش"
  },
  {
    "poem_id": 52170,
    "vorder": 50,
    "position": 1,
    "text": "ببر اسب را در زمان دم و گوش"
  },
  {
    "poem_id": 52170,
    "vorder": 51,
    "position": 0,
    "text": "زیانی که آمد بران کشتمند"
  },
  {
    "poem_id": 52170,
    "vorder": 52,
    "position": 1,
    "text": "شمارش بباید شمردن که چند"
  },
  {
    "poem_id": 52170,
    "vorder": 53,
    "position": 0,
    "text": "ز خسرو زیان باز باید ستد"
  },
  {
    "poem_id": 52170,
    "vorder": 54,
    "position": 1,
    "text": "اگر صد زیانست اگر پانصد"
  },
  {
    "poem_id": 52170,
    "vorder": 55,
    "position": 0,
    "text": "درمهای گنجی بران کشت زار"
  },
  {
    "poem_id": 52170,
    "vorder": 56,
    "position": 1,
    "text": "بریزند پیش خداوند کار"
  },
  {
    "poem_id": 52170,
    "vorder": 57,
    "position": 0,
    "text": "چو بشنید پرویز پوزش کنان"
  },
  {
    "poem_id": 52170,
    "vorder": 58,
    "position": 1,
    "text": "برانگیخت از هر سویی مهتران"
  },
  {
    "poem_id": 52170,
    "vorder": 59,
    "position": 0,
    "text": "بنزد پدر تا ببخشد گناه"
  },
  {
    "poem_id": 52170,
    "vorder": 60,
    "position": 1,
    "text": "نبرد دم وگوش اسب سیاه"
  },
  {
    "poem_id": 52170,
    "vorder": 61,
    "position": 0,
    "text": "برآشفت ازان پس برو شهریار"
  },
  {
    "poem_id": 52170,
    "vorder": 62,
    "position": 1,
    "text": "بتندی بزد بانگ بر پیشکار"
  },
  {
    "poem_id": 52170,
    "vorder": 63,
    "position": 0,
    "text": "موکل شد از بیم هرمز دوان"
  },
  {
    "poem_id": 52170,
    "vorder": 64,
    "position": 1,
    "text": "بدان کشت نزدیک اسب جوان"
  },
  {
    "poem_id": 52170,
    "vorder": 65,
    "position": 0,
    "text": "بخنجر جداکرد زو گوش و دم"
  },
  {
    "poem_id": 52170,
    "vorder": 66,
    "position": 1,
    "text": "بران کشت زاری که آزرد سم"
  },
  {
    "poem_id": 52170,
    "vorder": 67,
    "position": 0,
    "text": "همان نیز تاوان بدان دادخواه"
  },
  {
    "poem_id": 52170,
    "vorder": 68,
    "position": 1,
    "text": "رسانید خسرو بفرمان شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 69,
    "position": 0,
    "text": "وزان پس بنخچیر شد شهریار"
  },
  {
    "poem_id": 52170,
    "vorder": 70,
    "position": 1,
    "text": "بیاورد هر کس فراوان شکار"
  },
  {
    "poem_id": 52170,
    "vorder": 71,
    "position": 0,
    "text": "سواری ردی مرد کنداوری"
  },
  {
    "poem_id": 52170,
    "vorder": 72,
    "position": 1,
    "text": "سپهبدنژادی بلند اختری"
  },
  {
    "poem_id": 52170,
    "vorder": 73,
    "position": 0,
    "text": "بره بر یکی رز پراز غوره دید"
  },
  {
    "poem_id": 52170,
    "vorder": 74,
    "position": 1,
    "text": "بفرمود تاکهتر اندر دوید"
  },
  {
    "poem_id": 52170,
    "vorder": 75,
    "position": 0,
    "text": "ازان خوشهٔ چند ببردی و برد"
  },
  {
    "poem_id": 52170,
    "vorder": 76,
    "position": 1,
    "text": "بایوان و خوالیگرش را سپرد"
  },
  {
    "poem_id": 52170,
    "vorder": 77,
    "position": 0,
    "text": "بیامد خداوندش اندر زمان"
  },
  {
    "poem_id": 52170,
    "vorder": 78,
    "position": 1,
    "text": "بدان مرد گفت ای بد بدگمان"
  },
  {
    "poem_id": 52170,
    "vorder": 79,
    "position": 0,
    "text": "نگهبان این رز نبودی به رنج"
  },
  {
    "poem_id": 52170,
    "vorder": 80,
    "position": 1,
    "text": "نه دینار دادی بها را نه گنج"
  },
  {
    "poem_id": 52170,
    "vorder": 81,
    "position": 0,
    "text": "چرا رنج نابرده کردی تباه"
  },
  {
    "poem_id": 52170,
    "vorder": 82,
    "position": 1,
    "text": "بنالم کنون از تو در پیش شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 83,
    "position": 0,
    "text": "سوار دلاور ز بیم زیان"
  },
  {
    "poem_id": 52170,
    "vorder": 84,
    "position": 1,
    "text": "بزودی کمر بازکرد از میان"
  },
  {
    "poem_id": 52170,
    "vorder": 85,
    "position": 0,
    "text": "بدو داد پرمایه زرین کمر"
  },
  {
    "poem_id": 52170,
    "vorder": 86,
    "position": 1,
    "text": "بهر مهره‌ای در نشانده گهر"
  },
  {
    "poem_id": 52170,
    "vorder": 87,
    "position": 0,
    "text": "خداوند رز چون کمر دید گفت"
  },
  {
    "poem_id": 52170,
    "vorder": 88,
    "position": 1,
    "text": "که کردار بد چند باید نهفت"
  },
  {
    "poem_id": 52170,
    "vorder": 89,
    "position": 0,
    "text": "تو با شهریار آشنایی مکن"
  },
  {
    "poem_id": 52170,
    "vorder": 90,
    "position": 1,
    "text": "خریده نداری بهایی مکن"
  },
  {
    "poem_id": 52170,
    "vorder": 91,
    "position": 0,
    "text": "سپاسی نهم بر تو بر زین کمر"
  },
  {
    "poem_id": 52170,
    "vorder": 92,
    "position": 1,
    "text": "بپیچی اگر بشنود دادگر"
  },
  {
    "poem_id": 52170,
    "vorder": 93,
    "position": 0,
    "text": "یکی مرد بد هرمز شهریار"
  },
  {
    "poem_id": 52170,
    "vorder": 94,
    "position": 1,
    "text": "به پیروزی اندر شده نامدار"
  },
  {
    "poem_id": 52170,
    "vorder": 95,
    "position": 0,
    "text": "بمردی ستوده بهرانجمن"
  },
  {
    "poem_id": 52170,
    "vorder": 96,
    "position": 1,
    "text": "که از رزم هرگز ندیدی شکن"
  },
  {
    "poem_id": 52170,
    "vorder": 97,
    "position": 0,
    "text": "که هم دادده بود و هم دادخواه"
  },
  {
    "poem_id": 52170,
    "vorder": 98,
    "position": 1,
    "text": "کلاه کیی برنهاده بماه"
  },
  {
    "poem_id": 52170,
    "vorder": 99,
    "position": 0,
    "text": "نکردی بشهر مداین درنگ"
  },
  {
    "poem_id": 52170,
    "vorder": 100,
    "position": 1,
    "text": "دلاور سری بود با نام وننگ"
  },
  {
    "poem_id": 52170,
    "vorder": 101,
    "position": 0,
    "text": "بهار و تموز و زمستان وتیر"
  },
  {
    "poem_id": 52170,
    "vorder": 102,
    "position": 1,
    "text": "نیاسود هرمز یل شیرگیر"
  },
  {
    "poem_id": 52170,
    "vorder": 103,
    "position": 0,
    "text": "همی‌گشت گرد جهان سر به سر"
  },
  {
    "poem_id": 52170,
    "vorder": 104,
    "position": 1,
    "text": "همی‌جست در پادشاهی هنر"
  },
  {
    "poem_id": 52170,
    "vorder": 105,
    "position": 0,
    "text": "چو ده سال شد پادشاهیش راست"
  },
  {
    "poem_id": 52170,
    "vorder": 106,
    "position": 1,
    "text": "ز هرکشور آواز بدخواه خاست"
  },
  {
    "poem_id": 52170,
    "vorder": 107,
    "position": 0,
    "text": "بیامد ز راه هری ساوه شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 108,
    "position": 1,
    "text": "ابا پیل و با کوس و گنج و سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 109,
    "position": 0,
    "text": "گر از لشکر ساوه گیری شمار"
  },
  {
    "poem_id": 52170,
    "vorder": 110,
    "position": 1,
    "text": "برو چارصد بار بشمر هزار"
  },
  {
    "poem_id": 52170,
    "vorder": 111,
    "position": 0,
    "text": "ز پیلان جنگی هزار و دویست"
  },
  {
    "poem_id": 52170,
    "vorder": 112,
    "position": 1,
    "text": "توگفتی مگر برزمین راه نیست"
  },
  {
    "poem_id": 52170,
    "vorder": 113,
    "position": 0,
    "text": "ز دشت هری تا در مرورود"
  },
  {
    "poem_id": 52170,
    "vorder": 114,
    "position": 1,
    "text": "سپه بود آگنده چون تار و پود"
  },
  {
    "poem_id": 52170,
    "vorder": 115,
    "position": 0,
    "text": "وزین روی تا مرو لشکر کشید"
  },
  {
    "poem_id": 52170,
    "vorder": 116,
    "position": 1,
    "text": "شد از گرد لشکر زمین ناپدید"
  },
  {
    "poem_id": 52170,
    "vorder": 117,
    "position": 0,
    "text": "بهرمز یکی نامه بنوشت شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 118,
    "position": 1,
    "text": "که نزدیک خود خوان ز هر سو سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 119,
    "position": 0,
    "text": "برو راه این لشکر آباد کن"
  },
  {
    "poem_id": 52170,
    "vorder": 120,
    "position": 1,
    "text": "علف سازو از تیغ ما یادکن"
  },
  {
    "poem_id": 52170,
    "vorder": 121,
    "position": 0,
    "text": "برین پادشاهی بخواهم گذشت"
  },
  {
    "poem_id": 52170,
    "vorder": 122,
    "position": 1,
    "text": "بدریا سپاهست و بر کوه و دشت"
  },
  {
    "poem_id": 52170,
    "vorder": 123,
    "position": 0,
    "text": "چو برخواند آن نامه را شهریار"
  },
  {
    "poem_id": 52170,
    "vorder": 124,
    "position": 1,
    "text": "بپژمرد زان لشکر بی‌شمار"
  },
  {
    "poem_id": 52170,
    "vorder": 125,
    "position": 0,
    "text": "وزان روی قیصر بیامد ز روم"
  },
  {
    "poem_id": 52170,
    "vorder": 126,
    "position": 1,
    "text": "به لشکر بزیر اندر آورد بوم"
  },
  {
    "poem_id": 52170,
    "vorder": 127,
    "position": 0,
    "text": "سپه بود رومی عدد صد هزار"
  },
  {
    "poem_id": 52170,
    "vorder": 128,
    "position": 1,
    "text": "سواران جنگ آور و نامدار"
  },
  {
    "poem_id": 52170,
    "vorder": 129,
    "position": 0,
    "text": "ز شهری که بگرفت نوشین روان"
  },
  {
    "poem_id": 52170,
    "vorder": 130,
    "position": 1,
    "text": "که از نام او بود قیصر نوان"
  },
  {
    "poem_id": 52170,
    "vorder": 131,
    "position": 0,
    "text": "بیامد ز هر کشوری لشکری"
  },
  {
    "poem_id": 52170,
    "vorder": 132,
    "position": 1,
    "text": "به پیش اندرون نامور مهتری"
  },
  {
    "poem_id": 52170,
    "vorder": 133,
    "position": 0,
    "text": "سپاهی بیامد ز راه خزر"
  },
  {
    "poem_id": 52170,
    "vorder": 134,
    "position": 1,
    "text": "کز ایشان سیه شد همه بوم و بر"
  },
  {
    "poem_id": 52170,
    "vorder": 135,
    "position": 0,
    "text": "جهاندیده بدال درپیش بود"
  },
  {
    "poem_id": 52170,
    "vorder": 136,
    "position": 1,
    "text": "که با گنج و با لشکر خویش بود"
  },
  {
    "poem_id": 52170,
    "vorder": 137,
    "position": 0,
    "text": "ز ارمینیه تا در اردبیل"
  },
  {
    "poem_id": 52170,
    "vorder": 138,
    "position": 1,
    "text": "پراگنده شد لشکرش خیل خیل"
  },
  {
    "poem_id": 52170,
    "vorder": 139,
    "position": 0,
    "text": "ز دشت سواران نیزه گزار"
  },
  {
    "poem_id": 52170,
    "vorder": 140,
    "position": 1,
    "text": "سپاهی بیامد فزون از شمار"
  },
  {
    "poem_id": 52170,
    "vorder": 141,
    "position": 0,
    "text": "چوعباس و چو حمزه شان پیشرو"
  },
  {
    "poem_id": 52170,
    "vorder": 142,
    "position": 1,
    "text": "سواران و گردن فرازان نو"
  },
  {
    "poem_id": 52170,
    "vorder": 143,
    "position": 0,
    "text": "ز تاراج ویران شد آن بوم ورست"
  },
  {
    "poem_id": 52170,
    "vorder": 144,
    "position": 1,
    "text": "که هرمز همی باژ ایشان بجست"
  },
  {
    "poem_id": 52170,
    "vorder": 145,
    "position": 0,
    "text": "بیامد سپه تابه آب فرات"
  },
  {
    "poem_id": 52170,
    "vorder": 146,
    "position": 1,
    "text": "نماند اندر آن بوم جای نبات"
  },
  {
    "poem_id": 52170,
    "vorder": 147,
    "position": 0,
    "text": "چو تاریک شد روزگار بهی"
  },
  {
    "poem_id": 52170,
    "vorder": 148,
    "position": 1,
    "text": "ز لشکر بهرمز رسید آگهی"
  },
  {
    "poem_id": 52170,
    "vorder": 149,
    "position": 0,
    "text": "چو بشنید گفتار کارآگهان"
  },
  {
    "poem_id": 52170,
    "vorder": 150,
    "position": 1,
    "text": "به پژمرد شاداب شاه جهان"
  },
  {
    "poem_id": 52170,
    "vorder": 151,
    "position": 0,
    "text": "فرستاد و ایرانیان را بخواند"
  },
  {
    "poem_id": 52170,
    "vorder": 152,
    "position": 1,
    "text": "سراسر همه کاخ مردم نشاند"
  },
  {
    "poem_id": 52170,
    "vorder": 153,
    "position": 0,
    "text": "برآورد رازی که بود از نهفت"
  },
  {
    "poem_id": 52170,
    "vorder": 154,
    "position": 1,
    "text": "بدان نامداران ایران بگفت"
  },
  {
    "poem_id": 52170,
    "vorder": 155,
    "position": 0,
    "text": "که چندین سپه روی به ایران نهاد"
  },
  {
    "poem_id": 52170,
    "vorder": 156,
    "position": 1,
    "text": "کسی در جهان این ندارد بیاد"
  },
  {
    "poem_id": 52170,
    "vorder": 157,
    "position": 0,
    "text": "همه نامداران فرو ماندند"
  },
  {
    "poem_id": 52170,
    "vorder": 158,
    "position": 1,
    "text": "ز هر گونه اندیشه‌ها راندند"
  },
  {
    "poem_id": 52170,
    "vorder": 159,
    "position": 0,
    "text": "بگفتند کای شاه با رای و هوش"
  },
  {
    "poem_id": 52170,
    "vorder": 160,
    "position": 1,
    "text": "یکی اندرین کار بگشای گوش"
  },
  {
    "poem_id": 52170,
    "vorder": 161,
    "position": 0,
    "text": "خردمند شاهی و ما کهتریم"
  },
  {
    "poem_id": 52170,
    "vorder": 162,
    "position": 1,
    "text": "همی خویشتن موبدی نشمریم"
  },
  {
    "poem_id": 52170,
    "vorder": 163,
    "position": 0,
    "text": "براندیش تا چارهٔ کار چیست"
  },
  {
    "poem_id": 52170,
    "vorder": 164,
    "position": 1,
    "text": "برو بوم ما را نگهدار کیست"
  },
  {
    "poem_id": 52170,
    "vorder": 165,
    "position": 0,
    "text": "چنین گفت موبد که بودش وزیر"
  },
  {
    "poem_id": 52170,
    "vorder": 166,
    "position": 1,
    "text": "که ای شاه دانا و دانش پذیر"
  },
  {
    "poem_id": 52170,
    "vorder": 167,
    "position": 0,
    "text": "سپاه خزر گر بیاید به جنگ"
  },
  {
    "poem_id": 52170,
    "vorder": 168,
    "position": 1,
    "text": "نیابند جنگی زمانی درنگ"
  },
  {
    "poem_id": 52170,
    "vorder": 169,
    "position": 0,
    "text": "ابا رومیان داستانها زنیم"
  },
  {
    "poem_id": 52170,
    "vorder": 170,
    "position": 1,
    "text": "زبن پایه تازیان برکنیم"
  },
  {
    "poem_id": 52170,
    "vorder": 171,
    "position": 0,
    "text": "ندارم به دل بیم ازتازیان"
  },
  {
    "poem_id": 52170,
    "vorder": 172,
    "position": 1,
    "text": "که ازدیدشان دیده دارد زیان"
  },
  {
    "poem_id": 52170,
    "vorder": 173,
    "position": 0,
    "text": "که هم مارخوارند وهم سوسمار"
  },
  {
    "poem_id": 52170,
    "vorder": 174,
    "position": 1,
    "text": "ندارند جنگی گه کارزار"
  },
  {
    "poem_id": 52170,
    "vorder": 175,
    "position": 0,
    "text": "تو را ساوه شاهست نزدیکتر"
  },
  {
    "poem_id": 52170,
    "vorder": 176,
    "position": 1,
    "text": "وزو کار ما نیز تاریکتر"
  },
  {
    "poem_id": 52170,
    "vorder": 177,
    "position": 0,
    "text": "ز راه خراسان بود رنج ما"
  },
  {
    "poem_id": 52170,
    "vorder": 178,
    "position": 1,
    "text": "که ویران کند لشکر و گنج ما"
  },
  {
    "poem_id": 52170,
    "vorder": 179,
    "position": 0,
    "text": "چو ترک اندر آید ز جیحون به جنگ"
  },
  {
    "poem_id": 52170,
    "vorder": 180,
    "position": 1,
    "text": "نباید برین کار کردن درنگ"
  },
  {
    "poem_id": 52170,
    "vorder": 181,
    "position": 0,
    "text": "به موبد چنین گفت جوینده راه"
  },
  {
    "poem_id": 52170,
    "vorder": 182,
    "position": 1,
    "text": "که اکنون چه سازیم با ساوه شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 183,
    "position": 0,
    "text": "بدو گفت موبد که لشکر بساز"
  },
  {
    "poem_id": 52170,
    "vorder": 184,
    "position": 1,
    "text": "که خسرو به لشکر بود سرفراز"
  },
  {
    "poem_id": 52170,
    "vorder": 185,
    "position": 0,
    "text": "عرض را بخوان تا بیارد شمار"
  },
  {
    "poem_id": 52170,
    "vorder": 186,
    "position": 1,
    "text": "که چندست مردم که آید به کار"
  },
  {
    "poem_id": 52170,
    "vorder": 187,
    "position": 0,
    "text": "عرض با جریده به نزدیک شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 188,
    "position": 1,
    "text": "بیامد بیاورد بی‌مر سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 189,
    "position": 0,
    "text": "شمار سپاه آمدش صد هزار"
  },
  {
    "poem_id": 52170,
    "vorder": 190,
    "position": 1,
    "text": "پیاده بسی در میان سوار"
  },
  {
    "poem_id": 52170,
    "vorder": 191,
    "position": 0,
    "text": "بدو گفت موبد که با ساوه شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 192,
    "position": 1,
    "text": "سزد گر نشوریم با این سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 193,
    "position": 0,
    "text": "مگر مردمی جویی و راستی"
  },
  {
    "poem_id": 52170,
    "vorder": 194,
    "position": 1,
    "text": "بدور افگنی کژی و کاستی"
  },
  {
    "poem_id": 52170,
    "vorder": 195,
    "position": 0,
    "text": "رهانی سر کهتر آنرا ز بد"
  },
  {
    "poem_id": 52170,
    "vorder": 196,
    "position": 1,
    "text": "چنان کز ره پادشاهان سزد"
  },
  {
    "poem_id": 52170,
    "vorder": 197,
    "position": 0,
    "text": "شنیدستی آن داستان بزرگ"
  },
  {
    "poem_id": 52170,
    "vorder": 198,
    "position": 1,
    "text": "که ارجاسب آن نامدارسترگ"
  },
  {
    "poem_id": 52170,
    "vorder": 199,
    "position": 0,
    "text": "بگشتاسب و لهراسب از بهر دین"
  },
  {
    "poem_id": 52170,
    "vorder": 200,
    "position": 1,
    "text": "چه بد کرد با آن سواران چین"
  },
  {
    "poem_id": 52170,
    "vorder": 201,
    "position": 0,
    "text": "چه آمد ز تیمار برشهر بلخ"
  },
  {
    "poem_id": 52170,
    "vorder": 202,
    "position": 1,
    "text": "که شد زندگانی بران بوم تلخ"
  },
  {
    "poem_id": 52170,
    "vorder": 203,
    "position": 0,
    "text": "چنین تا گشاده شد اسفندیار"
  },
  {
    "poem_id": 52170,
    "vorder": 204,
    "position": 1,
    "text": "همی‌بود هر گونه کارزار"
  },
  {
    "poem_id": 52170,
    "vorder": 205,
    "position": 0,
    "text": "ز مهتر بسال ار چه من کهترم"
  },
  {
    "poem_id": 52170,
    "vorder": 206,
    "position": 1,
    "text": "ازو من باندیشه بر بگذرم"
  },
  {
    "poem_id": 52170,
    "vorder": 207,
    "position": 0,
    "text": "به موبد چنین گفت پس شهریار"
  },
  {
    "poem_id": 52170,
    "vorder": 208,
    "position": 1,
    "text": "که قیصر نجوید ز ما کارزار"
  },
  {
    "poem_id": 52170,
    "vorder": 209,
    "position": 0,
    "text": "همان شهرها راکه بگرفت شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 210,
    "position": 1,
    "text": "سپارم بدو بازگردد ز راه"
  },
  {
    "poem_id": 52170,
    "vorder": 211,
    "position": 0,
    "text": "فرستاده‌ای جست گرد و دبیر"
  },
  {
    "poem_id": 52170,
    "vorder": 212,
    "position": 1,
    "text": "خردمند و گویا و دانش پذیر"
  },
  {
    "poem_id": 52170,
    "vorder": 213,
    "position": 0,
    "text": "به قیصر چنین گوی کزشهر روم"
  },
  {
    "poem_id": 52170,
    "vorder": 214,
    "position": 1,
    "text": "نخواهم دگر باژ آن مرز و بوم"
  },
  {
    "poem_id": 52170,
    "vorder": 215,
    "position": 0,
    "text": "تو هم پای در مرز ایران منه"
  },
  {
    "poem_id": 52170,
    "vorder": 216,
    "position": 1,
    "text": "چو خواهی که مه باشی و روزبه"
  },
  {
    "poem_id": 52170,
    "vorder": 217,
    "position": 0,
    "text": "فرستاده چون پیش قیصر رسید"
  },
  {
    "poem_id": 52170,
    "vorder": 218,
    "position": 1,
    "text": "بگفت آنچ از شاه ایران شنید"
  },
  {
    "poem_id": 52170,
    "vorder": 219,
    "position": 0,
    "text": "ز ره بازگشت آن زمان شاه روم"
  },
  {
    "poem_id": 52170,
    "vorder": 220,
    "position": 1,
    "text": "نیاورد جنگ اندران مرز و بوم"
  },
  {
    "poem_id": 52170,
    "vorder": 221,
    "position": 0,
    "text": "سپاهی از ایرانیان برگزید"
  },
  {
    "poem_id": 52170,
    "vorder": 222,
    "position": 1,
    "text": "که از گردشان روز شد ناپدید"
  },
  {
    "poem_id": 52170,
    "vorder": 223,
    "position": 0,
    "text": "فرستادشان تا بران بوم و بر"
  },
  {
    "poem_id": 52170,
    "vorder": 224,
    "position": 1,
    "text": "به پای اندر آرند مرز خزر"
  },
  {
    "poem_id": 52170,
    "vorder": 225,
    "position": 0,
    "text": "سپهدارشان پیش خراد بود"
  },
  {
    "poem_id": 52170,
    "vorder": 226,
    "position": 1,
    "text": "که با فر و اورنگ و با داد بود"
  },
  {
    "poem_id": 52170,
    "vorder": 227,
    "position": 0,
    "text": "چو آمد بار مینیه در سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 228,
    "position": 1,
    "text": "سپاه خزر برگرفتند راه"
  },
  {
    "poem_id": 52170,
    "vorder": 229,
    "position": 0,
    "text": "وز ایشان فراوان بکشتند نیز"
  },
  {
    "poem_id": 52170,
    "vorder": 230,
    "position": 1,
    "text": "گرفتند زان مرز بسیار چیز"
  },
  {
    "poem_id": 52170,
    "vorder": 231,
    "position": 0,
    "text": "چو آگاهی آمد به نزدیک شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 232,
    "position": 1,
    "text": "که خراد پیروز شد با سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 233,
    "position": 0,
    "text": "بجز کینهٔ ساوه شاهش نماند"
  },
  {
    "poem_id": 52170,
    "vorder": 234,
    "position": 1,
    "text": "خرد را به اندیشه اندر نشاند"
  },
  {
    "poem_id": 52170,
    "vorder": 235,
    "position": 0,
    "text": "یکی بنده بد شاه را شادکام"
  },
  {
    "poem_id": 52170,
    "vorder": 236,
    "position": 1,
    "text": "خردمند و بینا و نستوه نام"
  },
  {
    "poem_id": 52170,
    "vorder": 237,
    "position": 0,
    "text": "به شاه جهان گفت انوشه بدی"
  },
  {
    "poem_id": 52170,
    "vorder": 238,
    "position": 1,
    "text": "ز تو دور بادا همیشه بدی"
  },
  {
    "poem_id": 52170,
    "vorder": 239,
    "position": 0,
    "text": "بپرسید باید ز مهران ستاد"
  },
  {
    "poem_id": 52170,
    "vorder": 240,
    "position": 1,
    "text": "که از روزگاران چه دارد بیاد"
  },
  {
    "poem_id": 52170,
    "vorder": 241,
    "position": 0,
    "text": "به کنجی نشستست با زند و است"
  },
  {
    "poem_id": 52170,
    "vorder": 242,
    "position": 1,
    "text": "ز امید گیتی شده پیر و سست"
  },
  {
    "poem_id": 52170,
    "vorder": 243,
    "position": 0,
    "text": "بدین روزگاران بر او شدم"
  },
  {
    "poem_id": 52170,
    "vorder": 244,
    "position": 1,
    "text": "یکی روز ویک شب بر او بدم"
  },
  {
    "poem_id": 52170,
    "vorder": 245,
    "position": 0,
    "text": "همی‌گفت او را من از ساوه شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 246,
    "position": 1,
    "text": "ز پیلان جنگی و چندان سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 247,
    "position": 0,
    "text": "چنین داد پاسخ چو آمد سخن"
  },
  {
    "poem_id": 52170,
    "vorder": 248,
    "position": 1,
    "text": "ازان گفته روزگار کهن"
  },
  {
    "poem_id": 52170,
    "vorder": 249,
    "position": 0,
    "text": "بپرسیدم از پیر مهران ستاد"
  },
  {
    "poem_id": 52170,
    "vorder": 250,
    "position": 1,
    "text": "که از روزگاران چه داری بیاد"
  },
  {
    "poem_id": 52170,
    "vorder": 251,
    "position": 0,
    "text": "چنین داد پاسخ که شاه جهان"
  },
  {
    "poem_id": 52170,
    "vorder": 252,
    "position": 1,
    "text": "اگر پرسدم بازگویم نهان"
  },
  {
    "poem_id": 52170,
    "vorder": 253,
    "position": 0,
    "text": "شهنشاه فرمود تا در زمان"
  },
  {
    "poem_id": 52170,
    "vorder": 254,
    "position": 1,
    "text": "بشد نزد او نامداری دمان"
  },
  {
    "poem_id": 52170,
    "vorder": 255,
    "position": 0,
    "text": "تن پیر ازان کاخ برداشتند"
  },
  {
    "poem_id": 52170,
    "vorder": 256,
    "position": 1,
    "text": "به مهد اندرون تیز بگذاشتند"
  },
  {
    "poem_id": 52170,
    "vorder": 257,
    "position": 0,
    "text": "چو آمد برشاه مرد کهن"
  },
  {
    "poem_id": 52170,
    "vorder": 258,
    "position": 1,
    "text": "دلی پر زدانش سری پرسخن"
  },
  {
    "poem_id": 52170,
    "vorder": 259,
    "position": 0,
    "text": "بپرسید هرمز ز مهران ستاد"
  },
  {
    "poem_id": 52170,
    "vorder": 260,
    "position": 1,
    "text": "کزین ترک جنگی چه داری بیاد"
  },
  {
    "poem_id": 52170,
    "vorder": 261,
    "position": 0,
    "text": "چنین داد پاسخ بدو مرد پیر"
  },
  {
    "poem_id": 52170,
    "vorder": 262,
    "position": 1,
    "text": "که‌ای شاه گوینده ویادگیر"
  },
  {
    "poem_id": 52170,
    "vorder": 263,
    "position": 0,
    "text": "بدانگه کجا مادرت را ز چین"
  },
  {
    "poem_id": 52170,
    "vorder": 264,
    "position": 1,
    "text": "فرستاد خاقان به ایران زمین"
  },
  {
    "poem_id": 52170,
    "vorder": 265,
    "position": 0,
    "text": "بخواهندگی من بدم پیشرو"
  },
  {
    "poem_id": 52170,
    "vorder": 266,
    "position": 1,
    "text": "صدو شست مرد از دلیران گو"
  },
  {
    "poem_id": 52170,
    "vorder": 267,
    "position": 0,
    "text": "پدرت آن جهاندار دانا و راست"
  },
  {
    "poem_id": 52170,
    "vorder": 268,
    "position": 1,
    "text": "ز خاقان پرستارزاده نخواست"
  },
  {
    "poem_id": 52170,
    "vorder": 269,
    "position": 0,
    "text": "مرا گفت جز دخت خاتون مخواه"
  },
  {
    "poem_id": 52170,
    "vorder": 270,
    "position": 1,
    "text": "نزیبد پرستار در پیشگاه"
  },
  {
    "poem_id": 52170,
    "vorder": 271,
    "position": 0,
    "text": "برفتم به نزدیک خاقان چین"
  },
  {
    "poem_id": 52170,
    "vorder": 272,
    "position": 1,
    "text": "به شاهی برو خواندم آفرین"
  },
  {
    "poem_id": 52170,
    "vorder": 273,
    "position": 0,
    "text": "ورا دختری پنج بد چون بهار"
  },
  {
    "poem_id": 52170,
    "vorder": 274,
    "position": 1,
    "text": "سراسر پر از بوی و رنگ و نگار"
  },
  {
    "poem_id": 52170,
    "vorder": 275,
    "position": 0,
    "text": "مرا در شبستان فرستاد شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 276,
    "position": 1,
    "text": "برفتم بران نامور پیشگاه"
  },
  {
    "poem_id": 52170,
    "vorder": 277,
    "position": 0,
    "text": "رخ دختران را بیاراستند"
  },
  {
    "poem_id": 52170,
    "vorder": 278,
    "position": 1,
    "text": "سر زلف بر گل بپیراستند"
  },
  {
    "poem_id": 52170,
    "vorder": 279,
    "position": 0,
    "text": "مگر مادرت بر سر افسر نداشت"
  },
  {
    "poem_id": 52170,
    "vorder": 280,
    "position": 1,
    "text": "همان یاره و طوق وگوهر نداشت"
  },
  {
    "poem_id": 52170,
    "vorder": 281,
    "position": 0,
    "text": "از ایشان جز او دخت خاتون نبود"
  },
  {
    "poem_id": 52170,
    "vorder": 282,
    "position": 1,
    "text": "به پیرایه و رنگ وافسون نبود"
  },
  {
    "poem_id": 52170,
    "vorder": 283,
    "position": 0,
    "text": "که خاتون چینی ز فغفور بود"
  },
  {
    "poem_id": 52170,
    "vorder": 284,
    "position": 1,
    "text": "به گوهر زکردار بد دور بود"
  },
  {
    "poem_id": 52170,
    "vorder": 285,
    "position": 0,
    "text": "همی مادرش را جگر زان بخست"
  },
  {
    "poem_id": 52170,
    "vorder": 286,
    "position": 1,
    "text": "که فرزند جایی شود دوردست"
  },
  {
    "poem_id": 52170,
    "vorder": 287,
    "position": 0,
    "text": "دژم بود زان دختر پارسا"
  },
  {
    "poem_id": 52170,
    "vorder": 288,
    "position": 1,
    "text": "گسی کردن از خانهٔ پادشا"
  },
  {
    "poem_id": 52170,
    "vorder": 289,
    "position": 0,
    "text": "من او را گزین کردم از دختران"
  },
  {
    "poem_id": 52170,
    "vorder": 290,
    "position": 1,
    "text": "نگه داشتم چشم زان دیگران"
  },
  {
    "poem_id": 52170,
    "vorder": 291,
    "position": 0,
    "text": "مرا گفت خاتون که دیگر گزین"
  },
  {
    "poem_id": 52170,
    "vorder": 292,
    "position": 1,
    "text": "که هر پنج خوبند و با آفرین"
  },
  {
    "poem_id": 52170,
    "vorder": 293,
    "position": 0,
    "text": "مرا پاسخ این بد که این بایدم"
  },
  {
    "poem_id": 52170,
    "vorder": 294,
    "position": 1,
    "text": "چو دیگر گزینم گزند آیدم"
  },
  {
    "poem_id": 52170,
    "vorder": 295,
    "position": 0,
    "text": "فرستاد و کنداوران را بخواند"
  },
  {
    "poem_id": 52170,
    "vorder": 296,
    "position": 1,
    "text": "برتخت شاهی به زانو نشاند"
  },
  {
    "poem_id": 52170,
    "vorder": 297,
    "position": 0,
    "text": "بپرسش گرفت اختر دخترش"
  },
  {
    "poem_id": 52170,
    "vorder": 298,
    "position": 1,
    "text": "که تا چون بود گردش اخترش"
  },
  {
    "poem_id": 52170,
    "vorder": 299,
    "position": 0,
    "text": "ستاره‌شمر گفت جز نیکویی"
  },
  {
    "poem_id": 52170,
    "vorder": 300,
    "position": 1,
    "text": "نبینی وجز راستی نشنوی"
  },
  {
    "poem_id": 52170,
    "vorder": 301,
    "position": 0,
    "text": "ازین دخت و از شاه ایرانیان"
  },
  {
    "poem_id": 52170,
    "vorder": 302,
    "position": 1,
    "text": "یکی کودک آید چو شیر ژیان"
  },
  {
    "poem_id": 52170,
    "vorder": 303,
    "position": 0,
    "text": "ببالا بلند و ببازوی ستبر"
  },
  {
    "poem_id": 52170,
    "vorder": 304,
    "position": 1,
    "text": "به مردی چو شیر و ببخشش چو ابر"
  },
  {
    "poem_id": 52170,
    "vorder": 305,
    "position": 0,
    "text": "سیه چشم و پر خشم و نابردبار"
  },
  {
    "poem_id": 52170,
    "vorder": 306,
    "position": 1,
    "text": "پدر بگذرد او بود شهریار"
  },
  {
    "poem_id": 52170,
    "vorder": 307,
    "position": 0,
    "text": "فراوان ز گنج پدر بر خورد"
  },
  {
    "poem_id": 52170,
    "vorder": 308,
    "position": 1,
    "text": "بسی روزگاران ببد نشمرد"
  },
  {
    "poem_id": 52170,
    "vorder": 309,
    "position": 0,
    "text": "وزان پس یکی شاه خیزد سترگ"
  },
  {
    "poem_id": 52170,
    "vorder": 310,
    "position": 1,
    "text": "ز ترکان بیارد سپاهی بزرگ"
  },
  {
    "poem_id": 52170,
    "vorder": 311,
    "position": 0,
    "text": "بسازد که ایران و شهریمن"
  },
  {
    "poem_id": 52170,
    "vorder": 312,
    "position": 1,
    "text": "سراسر بگیرد بران انجمن"
  },
  {
    "poem_id": 52170,
    "vorder": 313,
    "position": 0,
    "text": "ازو شاه ایران شود دردمند"
  },
  {
    "poem_id": 52170,
    "vorder": 314,
    "position": 1,
    "text": "بترسد ز پیروز بخت بلند"
  },
  {
    "poem_id": 52170,
    "vorder": 315,
    "position": 0,
    "text": "یکی کهتری باشدش دوردست"
  },
  {
    "poem_id": 52170,
    "vorder": 316,
    "position": 1,
    "text": "سواری سرافراز مهترپرست"
  },
  {
    "poem_id": 52170,
    "vorder": 317,
    "position": 0,
    "text": "ببالا دراز و به اندام خشک"
  },
  {
    "poem_id": 52170,
    "vorder": 318,
    "position": 1,
    "text": "به گرد سرش جعد مویی چومشک"
  },
  {
    "poem_id": 52170,
    "vorder": 319,
    "position": 0,
    "text": "سخن آوری جلد و بینی بزرگ"
  },
  {
    "poem_id": 52170,
    "vorder": 320,
    "position": 1,
    "text": "سیه چرده و تندگوی و سترگ"
  },
  {
    "poem_id": 52170,
    "vorder": 321,
    "position": 0,
    "text": "جهانجوی چوبینه دارد لقب"
  },
  {
    "poem_id": 52170,
    "vorder": 322,
    "position": 1,
    "text": "هم از پهلوانانشان باشد نسب"
  },
  {
    "poem_id": 52170,
    "vorder": 323,
    "position": 0,
    "text": "چو این مرد چاکر باندک سپاه"
  },
  {
    "poem_id": 52170,
    "vorder": 324,
    "position": 1,
    "text": "ز جایی بیاید به درگاه شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 325,
    "position": 0,
    "text": "مرین ترک را ناگهان بشکند"
  },
  {
    "poem_id": 52170,
    "vorder": 326,
    "position": 1,
    "text": "همه لشکرش را بهم برزند"
  },
  {
    "poem_id": 52170,
    "vorder": 327,
    "position": 0,
    "text": "چو بشنید گفت ستاره شمر"
  },
  {
    "poem_id": 52170,
    "vorder": 328,
    "position": 1,
    "text": "ندیدم ز خاقان کسی شادتر"
  },
  {
    "poem_id": 52170,
    "vorder": 329,
    "position": 0,
    "text": "به نوشین روان داد پس دخترش"
  },
  {
    "poem_id": 52170,
    "vorder": 330,
    "position": 1,
    "text": "که از دختران او بدی افسرش"
  },
  {
    "poem_id": 52170,
    "vorder": 331,
    "position": 0,
    "text": "پذیرفتم او را من ازبهر شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 332,
    "position": 1,
    "text": "چو آن کرده بد بازگشتم به راه"
  },
  {
    "poem_id": 52170,
    "vorder": 333,
    "position": 0,
    "text": "بیاورد چندی گهرها ز گنج"
  },
  {
    "poem_id": 52170,
    "vorder": 334,
    "position": 1,
    "text": "که ما یافتیم از کشیدنش رنج"
  },
  {
    "poem_id": 52170,
    "vorder": 335,
    "position": 0,
    "text": "همان تا لب رود جیحون براند"
  },
  {
    "poem_id": 52170,
    "vorder": 336,
    "position": 1,
    "text": "جهان بین خود را بکشتی نشاند"
  },
  {
    "poem_id": 52170,
    "vorder": 337,
    "position": 0,
    "text": "ز جیحون دلی پر ز غم بازگشت"
  },
  {
    "poem_id": 52170,
    "vorder": 338,
    "position": 1,
    "text": "ز فرزند با درد انباز گشت"
  },
  {
    "poem_id": 52170,
    "vorder": 339,
    "position": 0,
    "text": "کنون آنچ دیدم بگفتم همه"
  },
  {
    "poem_id": 52170,
    "vorder": 340,
    "position": 1,
    "text": "به پیش جهاندار شاه رمه"
  },
  {
    "poem_id": 52170,
    "vorder": 341,
    "position": 0,
    "text": "ازین کشور این مرد را باز جوی"
  },
  {
    "poem_id": 52170,
    "vorder": 342,
    "position": 1,
    "text": "بپوینده شاید که گویی بپوی"
  },
  {
    "poem_id": 52170,
    "vorder": 343,
    "position": 0,
    "text": "که پیروزی شاه بر دست اوست"
  },
  {
    "poem_id": 52170,
    "vorder": 344,
    "position": 1,
    "text": "بدشمن ممان این سخن گر بدوست"
  },
  {
    "poem_id": 52170,
    "vorder": 345,
    "position": 0,
    "text": "بگفت این و جانش برآمد ز تن"
  },
  {
    "poem_id": 52170,
    "vorder": 346,
    "position": 1,
    "text": "برو زار و گریان شدند انجمن"
  },
  {
    "poem_id": 52170,
    "vorder": 347,
    "position": 0,
    "text": "شهنشاه زو در شگفتی بماند"
  },
  {
    "poem_id": 52170,
    "vorder": 348,
    "position": 1,
    "text": "به مژگان همی خون دل برفشاند"
  },
  {
    "poem_id": 52170,
    "vorder": 349,
    "position": 0,
    "text": "به ایرانیان گفت مهران ستاد"
  },
  {
    "poem_id": 52170,
    "vorder": 350,
    "position": 1,
    "text": "همی‌داشت این راستیها بیاد"
  },
  {
    "poem_id": 52170,
    "vorder": 351,
    "position": 0,
    "text": "چو با من یکایک بگفت و بمرد"
  },
  {
    "poem_id": 52170,
    "vorder": 352,
    "position": 1,
    "text": "پسندیده جانش به یزدان سپرد"
  },
  {
    "poem_id": 52170,
    "vorder": 353,
    "position": 0,
    "text": "سپاسم ز یزدان کزین مرد پیر"
  },
  {
    "poem_id": 52170,
    "vorder": 354,
    "position": 1,
    "text": "برآمد چنین گفتن ناگزیر"
  },
  {
    "poem_id": 52170,
    "vorder": 355,
    "position": 0,
    "text": "نشان جست باید ز هر مهتری"
  },
  {
    "poem_id": 52170,
    "vorder": 356,
    "position": 1,
    "text": "اگر مهتری باشد ار کهتری"
  },
  {
    "poem_id": 52170,
    "vorder": 357,
    "position": 0,
    "text": "بجویید تا این بجای آورید"
  },
  {
    "poem_id": 52170,
    "vorder": 358,
    "position": 1,
    "text": "همه رنجها را به پای آورید"
  },
  {
    "poem_id": 52170,
    "vorder": 359,
    "position": 0,
    "text": "یکی مهتری نامبردار بود"
  },
  {
    "poem_id": 52170,
    "vorder": 360,
    "position": 1,
    "text": "که بر آخر اسب سالار بود"
  },
  {
    "poem_id": 52170,
    "vorder": 361,
    "position": 0,
    "text": "کجا راد فرخ بدی نام اوی"
  },
  {
    "poem_id": 52170,
    "vorder": 362,
    "position": 1,
    "text": "همه شادی شاه بد کام اوی"
  },
  {
    "poem_id": 52170,
    "vorder": 363,
    "position": 0,
    "text": "بیامد بر شاه گفت این نشان"
  },
  {
    "poem_id": 52170,
    "vorder": 364,
    "position": 1,
    "text": "که داد این ستوده به گردنکشان"
  },
  {
    "poem_id": 52170,
    "vorder": 365,
    "position": 0,
    "text": "ز بهرام بهرام پورگشسب"
  },
  {
    "poem_id": 52170,
    "vorder": 366,
    "position": 1,
    "text": "سواری سرافراز و پیچنده اسب"
  },
  {
    "poem_id": 52170,
    "vorder": 367,
    "position": 0,
    "text": "ز اندیشهٔ من بخواهد گذشت"
  },
  {
    "poem_id": 52170,
    "vorder": 368,
    "position": 1,
    "text": "ندیدم چنو مرزبانی به دشت"
  },
  {
    "poem_id": 52170,
    "vorder": 369,
    "position": 0,
    "text": "که دادی بدو بردع و اردبیل"
  },
  {
    "poem_id": 52170,
    "vorder": 370,
    "position": 1,
    "text": "یکی نامور گشت باکوس وخیل"
  },
  {
    "poem_id": 52170,
    "vorder": 371,
    "position": 0,
    "text": "فرستاد و بهرام را مژده داد"
  },
  {
    "poem_id": 52170,
    "vorder": 372,
    "position": 1,
    "text": "سخنهای مهران برو کرد یاد"
  },
  {
    "poem_id": 52170,
    "vorder": 373,
    "position": 0,
    "text": "جهانجوی پویان ز بردع برفت"
  },
  {
    "poem_id": 52170,
    "vorder": 374,
    "position": 1,
    "text": "ز گردنکشان لشکری برد تفت"
  },
  {
    "poem_id": 52170,
    "vorder": 375,
    "position": 0,
    "text": "چوبهرام تنگ اندر آمد ز راه"
  },
  {
    "poem_id": 52170,
    "vorder": 376,
    "position": 1,
    "text": "بفرمود تا بار دادند شاه"
  },
  {
    "poem_id": 52170,
    "vorder": 377,
    "position": 0,
    "text": "جهاندیده روی شهنشاه دید"
  },
  {
    "poem_id": 52170,
    "vorder": 378,
    "position": 1,
    "text": "بران نامدار آفرین گسترید"
  },
  {
    "poem_id": 52170,
    "vorder": 379,
    "position": 0,
    "text": "نگه کرد شاه اندرو یک زمان"
  },
  {
    "poem_id": 52170,
    "vorder": 380,
    "position": 1,
    "text": "نبودش بدو جز به نیکی گمان"
  },
  {
    "poem_id": 52170,
    "vorder": 381,
    "position": 0,
    "text": "نشاینهای مهران ستاد اندروی"
  },
  {
    "poem_id": 52170,
    "vorder": 382,
    "position": 1,
    "text": "بدید و بخندید وشد تازه روی"
  },
