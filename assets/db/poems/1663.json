[
  {
    "poem_id": 1663,
    "vorder": 1,
    "position": 0,
    "text": "بخندید قیدافه از کار اوی"
  },
  {
    "poem_id": 1663,
    "vorder": 2,
    "position": 1,
    "text": "ازان مردی و تند گفتار اوی"
  },
  {
    "poem_id": 1663,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت کای خسرو شیرفش"
  },
  {
    "poem_id": 1663,
    "vorder": 4,
    "position": 1,
    "text": "به مردی مگردان سر خویش کش"
  },
  {
    "poem_id": 1663,
    "vorder": 5,
    "position": 0,
    "text": "نه از فر تو کشته شد فور هند"
  },
  {
    "poem_id": 1663,
    "vorder": 6,
    "position": 1,
    "text": "نه دارای داراب و گردان سند"
  },
  {
    "poem_id": 1663,
    "vorder": 7,
    "position": 0,
    "text": "که برگشت روز بزرگان دهر"
  },
  {
    "poem_id": 1663,
    "vorder": 8,
    "position": 1,
    "text": "ز اختر ترا بیشتر بود بهر"
  },
  {
    "poem_id": 1663,
    "vorder": 9,
    "position": 0,
    "text": "به مردی تو گستاخ گشتی چنین"
  },
  {
    "poem_id": 1663,
    "vorder": 10,
    "position": 1,
    "text": "که مهتر شدی بر زمان و زمین"
  },
  {
    "poem_id": 1663,
    "vorder": 11,
    "position": 0,
    "text": "همه نیکویها ز یزدان شناس"
  },
  {
    "poem_id": 1663,
    "vorder": 12,
    "position": 1,
    "text": "و زو دار تا زنده باشی سپاس"
  },
  {
    "poem_id": 1663,
    "vorder": 13,
    "position": 0,
    "text": "تو گویی به دانش که گیتی مراست"
  },
  {
    "poem_id": 1663,
    "vorder": 14,
    "position": 1,
    "text": "نبینم همی گفت و گوی تو راست"
  },
  {
    "poem_id": 1663,
    "vorder": 15,
    "position": 0,
    "text": "کجا آورد دانش تو بها"
  },
  {
    "poem_id": 1663,
    "vorder": 16,
    "position": 1,
    "text": "چو آیی چنین در دم اژدها"
  },
  {
    "poem_id": 1663,
    "vorder": 17,
    "position": 0,
    "text": "بدوزی به روز جوانی کفن"
  },
  {
    "poem_id": 1663,
    "vorder": 18,
    "position": 1,
    "text": "فرستاده‌ای سازی از خویشتن"
  },
  {
    "poem_id": 1663,
    "vorder": 19,
    "position": 0,
    "text": "مرا نیست آیین خون ریختن"
  },
  {
    "poem_id": 1663,
    "vorder": 20,
    "position": 1,
    "text": "نه بر خیره با مهتر آویختن"
  },
  {
    "poem_id": 1663,
    "vorder": 21,
    "position": 0,
    "text": "چو شاهی به کاری توانا بود"
  },
  {
    "poem_id": 1663,
    "vorder": 22,
    "position": 1,
    "text": "ببخشاید از داد و دانا بود"
  },
  {
    "poem_id": 1663,
    "vorder": 23,
    "position": 0,
    "text": "چنان دان که ریزندهٔ خون شاه"
  },
  {
    "poem_id": 1663,
    "vorder": 24,
    "position": 1,
    "text": "جز آتش نبیند به فرجام گاه"
  },
  {
    "poem_id": 1663,
    "vorder": 25,
    "position": 0,
    "text": "تو ایمن بباش و به شادی برو"
  },
  {
    "poem_id": 1663,
    "vorder": 26,
    "position": 1,
    "text": "چو رفتی یکی کار برساز نو"
  },
  {
    "poem_id": 1663,
    "vorder": 27,
    "position": 0,
    "text": "کزین پس نیابی به پیغمبری"
  },
  {
    "poem_id": 1663,
    "vorder": 28,
    "position": 1,
    "text": "ترا خاک داند که اسکندری"
  },
  {
    "poem_id": 1663,
    "vorder": 29,
    "position": 0,
    "text": "ندانم کسی را ز گردنکشان"
  },
  {
    "poem_id": 1663,
    "vorder": 30,
    "position": 1,
    "text": "که از چهر او من ندارم نشان"
  },
  {
    "poem_id": 1663,
    "vorder": 31,
    "position": 0,
    "text": "نگاریده هم زین نشان بر حریر"
  },
  {
    "poem_id": 1663,
    "vorder": 32,
    "position": 1,
    "text": "نهاده به نزد یکی یادگیر"
  },
  {
    "poem_id": 1663,
    "vorder": 33,
    "position": 0,
    "text": "برو راند هم حکم اخترشناس"
  },
  {
    "poem_id": 1663,
    "vorder": 34,
    "position": 1,
    "text": "کزو ایمنی باشد اندر هراس"
  },
  {
    "poem_id": 1663,
    "vorder": 35,
    "position": 0,
    "text": "چو بخشنده شد خسرو رای‌زن"
  },
  {
    "poem_id": 1663,
    "vorder": 36,
    "position": 1,
    "text": "زمانه بگوید به مرد و به زن"
  },
  {
    "poem_id": 1663,
    "vorder": 37,
    "position": 0,
    "text": "تو تا ایدری بیطقون خوانمت"
  },
  {
    "poem_id": 1663,
    "vorder": 38,
    "position": 1,
    "text": "برین هم نشان دور بنشانمت"
  },
  {
    "poem_id": 1663,
    "vorder": 39,
    "position": 0,
    "text": "بدان تا نداند کسی راز تو"
  },
  {
    "poem_id": 1663,
    "vorder": 40,
    "position": 1,
    "text": "همان نشنود نام و آواز تو"
  },
  {
    "poem_id": 1663,
    "vorder": 41,
    "position": 0,
    "text": "فرستمت بر نیکوی باز جای"
  },
  {
    "poem_id": 1663,
    "vorder": 42,
    "position": 1,
    "text": "تو باید که باشی خداوند رای"
  },
  {
    "poem_id": 1663,
    "vorder": 43,
    "position": 0,
    "text": "به پیمان که هرگز به فرزند من"
  },
  {
    "poem_id": 1663,
    "vorder": 44,
    "position": 1,
    "text": "به شهر من و خویش و پیوند من"
  },
  {
    "poem_id": 1663,
    "vorder": 45,
    "position": 0,
    "text": "نباشی بداندایش گر بدسگال"
  },
  {
    "poem_id": 1663,
    "vorder": 46,
    "position": 1,
    "text": "به کشور نخوانی مرا جز همال"
  },
  {
    "poem_id": 1663,
    "vorder": 47,
    "position": 0,
    "text": "سکندر شنید این سخن شاد شد"
  },
  {
    "poem_id": 1663,
    "vorder": 48,
    "position": 1,
    "text": "ز تیمار وز کشتن آزاد شد"
  },
  {
    "poem_id": 1663,
    "vorder": 49,
    "position": 0,
    "text": "به دادار دارنده سوگند خورد"
  },
  {
    "poem_id": 1663,
    "vorder": 50,
    "position": 1,
    "text": "بدین مسیحا و گرد نبرد"
  },
  {
    "poem_id": 1663,
    "vorder": 51,
    "position": 0,
    "text": "که با بوم و بارست و فرزند تو"
  },
  {
    "poem_id": 1663,
    "vorder": 52,
    "position": 1,
    "text": "بزرگان که باشند پیوند تو"
  },
  {
    "poem_id": 1663,
    "vorder": 53,
    "position": 0,
    "text": "نسازم جز از خوبی و راستی"
  },
  {
    "poem_id": 1663,
    "vorder": 54,
    "position": 1,
    "text": "نه اندیشم از کژی و کاستی"
  },
  {
    "poem_id": 1663,
    "vorder": 55,
    "position": 0,
    "text": "چو سوگند شد خورده قیدافه گفت"
  },
  {
    "poem_id": 1663,
    "vorder": 56,
    "position": 1,
    "text": "که این پند بر تو نشاید نهفت"
  },
  {
    "poem_id": 1663,
    "vorder": 57,
    "position": 0,
    "text": "چنان دان که طینوش فرزند من"
  },
  {
    "poem_id": 1663,
    "vorder": 58,
    "position": 1,
    "text": "کم اندیشد از دانش و پند من"
  },
  {
    "poem_id": 1663,
    "vorder": 59,
    "position": 0,
    "text": "یکی بادسارست داماد فور"
  },
  {
    "poem_id": 1663,
    "vorder": 60,
    "position": 1,
    "text": "نباید که داند ز نزدیک و دور"
  },
  {
    "poem_id": 1663,
    "vorder": 61,
    "position": 0,
    "text": "که تو با سکندر ز یک پوستی"
  },
  {
    "poem_id": 1663,
    "vorder": 62,
    "position": 1,
    "text": "گر ایدونک با او به دل دوستی"
  },
  {
    "poem_id": 1663,
    "vorder": 63,
    "position": 0,
    "text": "که او از پی فور کین آورد"
  },
  {
    "poem_id": 1663,
    "vorder": 64,
    "position": 1,
    "text": "به جنگ آسمان بر زمین آورد"
  },
  {
    "poem_id": 1663,
    "vorder": 65,
    "position": 0,
    "text": "کنون شاد و ایمن به ایوان خرام"
  },
  {
    "poem_id": 1663,
    "vorder": 66,
    "position": 1,
    "text": "ز تیمار گیتی مبر هیچ نام"
  }
]