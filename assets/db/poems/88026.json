[
  {
    "poem_id": 88026,
    "vorder": 1,
    "position": 0,
    "text": "بی آزار لشکر به فرمان شاه"
  },
  {
    "poem_id": 88026,
    "vorder": 2,
    "position": 1,
    "text": "همی رفت منزل به منزل سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 3,
    "position": 0,
    "text": "چو گودرز نزدیک زیبد رسید"
  },
  {
    "poem_id": 88026,
    "vorder": 4,
    "position": 1,
    "text": "سران را ز لشکر همی برگزید"
  },
  {
    "poem_id": 88026,
    "vorder": 5,
    "position": 0,
    "text": "هزاران دلیران خنجر گزار"
  },
  {
    "poem_id": 88026,
    "vorder": 6,
    "position": 1,
    "text": "ز گردان لشکر دلاور سوار"
  },
  {
    "poem_id": 88026,
    "vorder": 7,
    "position": 0,
    "text": "از ایرانیان نامور ده‌هزار"
  },
  {
    "poem_id": 88026,
    "vorder": 8,
    "position": 1,
    "text": "سخن گوی و اندر خور کارزار"
  },
  {
    "poem_id": 88026,
    "vorder": 9,
    "position": 0,
    "text": "سپهدار پس گیو را پیش خواند"
  },
  {
    "poem_id": 88026,
    "vorder": 10,
    "position": 1,
    "text": "همه گفتهٔ شاه با او براند"
  },
  {
    "poem_id": 88026,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت کای پور سالار سر"
  },
  {
    "poem_id": 88026,
    "vorder": 12,
    "position": 1,
    "text": "برافراخته سر ز بسیار سر"
  },
  {
    "poem_id": 88026,
    "vorder": 13,
    "position": 0,
    "text": "گزین کردم اندر خورت لشکری"
  },
  {
    "poem_id": 88026,
    "vorder": 14,
    "position": 1,
    "text": "که هستند سالار هر کشوری"
  },
  {
    "poem_id": 88026,
    "vorder": 15,
    "position": 0,
    "text": "بدان تا به نزدیک پیران شوی"
  },
  {
    "poem_id": 88026,
    "vorder": 16,
    "position": 1,
    "text": "بگویی و گفتار او بشنوی"
  },
  {
    "poem_id": 88026,
    "vorder": 17,
    "position": 0,
    "text": "بگویی به پیران که من با سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 18,
    "position": 1,
    "text": "به زیبد رسیدم به فرمان شاه"
  },
  {
    "poem_id": 88026,
    "vorder": 19,
    "position": 0,
    "text": "شناسی تو گفتار و کردار خویش"
  },
  {
    "poem_id": 88026,
    "vorder": 20,
    "position": 1,
    "text": "بی آزاری و رنج و تیمار خویش"
  },
  {
    "poem_id": 88026,
    "vorder": 21,
    "position": 0,
    "text": "همه شهر توران بدی را میان"
  },
  {
    "poem_id": 88026,
    "vorder": 22,
    "position": 1,
    "text": "ببستند با نامدار کیان"
  },
  {
    "poem_id": 88026,
    "vorder": 23,
    "position": 0,
    "text": "فریدون فرخ که با داغ و درد"
  },
  {
    "poem_id": 88026,
    "vorder": 24,
    "position": 1,
    "text": "ز گیتی بشد دیده پر آب زرد"
  },
  {
    "poem_id": 88026,
    "vorder": 25,
    "position": 0,
    "text": "پر از درد ایران پر از داغ شاه"
  },
  {
    "poem_id": 88026,
    "vorder": 26,
    "position": 1,
    "text": "که با سوک ایرج نتابید ماه"
  },
  {
    "poem_id": 88026,
    "vorder": 27,
    "position": 0,
    "text": "ز ترکان تو تنها از آن انجمن"
  },
  {
    "poem_id": 88026,
    "vorder": 28,
    "position": 1,
    "text": "شناسی به مهر و وفا خویشتن"
  },
  {
    "poem_id": 88026,
    "vorder": 29,
    "position": 0,
    "text": "دروغست بر تو همین نام مهر"
  },
  {
    "poem_id": 88026,
    "vorder": 30,
    "position": 1,
    "text": "نبینم به دلت اندر آرام مهر"
  },
  {
    "poem_id": 88026,
    "vorder": 31,
    "position": 0,
    "text": "همانست کان شاه آزرمجوی"
  },
  {
    "poem_id": 88026,
    "vorder": 32,
    "position": 1,
    "text": "مرا گفت با او همه نرم گوی"
  },
  {
    "poem_id": 88026,
    "vorder": 33,
    "position": 0,
    "text": "از آن کو به کار سیاوش رد"
  },
  {
    "poem_id": 88026,
    "vorder": 34,
    "position": 1,
    "text": "بیفگند یک روز بنیاد بد"
  },
  {
    "poem_id": 88026,
    "vorder": 35,
    "position": 0,
    "text": "به نزد منش دستگاهست نیز"
  },
  {
    "poem_id": 88026,
    "vorder": 36,
    "position": 1,
    "text": "ز خون پدر بیگناهست نیز"
  },
  {
    "poem_id": 88026,
    "vorder": 37,
    "position": 0,
    "text": "گناهی که تا این زمان کرده‌ای"
  },
  {
    "poem_id": 88026,
    "vorder": 38,
    "position": 1,
    "text": "ز شاهان گیتی که آزرده‌ای"
  },
  {
    "poem_id": 88026,
    "vorder": 39,
    "position": 0,
    "text": "همی شاه بگذارد از تو همه"
  },
  {
    "poem_id": 88026,
    "vorder": 40,
    "position": 1,
    "text": "بدی ، نیکی انگارد از تو همه"
  },
  {
    "poem_id": 88026,
    "vorder": 41,
    "position": 0,
    "text": "نباید که بر دست ما بر ، تباه"
  },
  {
    "poem_id": 88026,
    "vorder": 42,
    "position": 1,
    "text": "شوی بر گذشته فراوان گناه"
  },
  {
    "poem_id": 88026,
    "vorder": 43,
    "position": 0,
    "text": "دگر کز پی جنگ افراسیاب"
  },
  {
    "poem_id": 88026,
    "vorder": 44,
    "position": 1,
    "text": "زمانه همی بر تو گیرد شتاب"
  },
  {
    "poem_id": 88026,
    "vorder": 45,
    "position": 0,
    "text": "بزرگان ایران و فرزند من"
  },
  {
    "poem_id": 88026,
    "vorder": 46,
    "position": 1,
    "text": "بخوانند بر تو همه پند من"
  },
  {
    "poem_id": 88026,
    "vorder": 47,
    "position": 0,
    "text": "سخن هرچ دانی بدیشان بگوی"
  },
  {
    "poem_id": 88026,
    "vorder": 48,
    "position": 1,
    "text": "وز ایشان همیدون سخن بازجوی"
  },
  {
    "poem_id": 88026,
    "vorder": 49,
    "position": 0,
    "text": "اگر راست باشد دلت با زبان"
  },
  {
    "poem_id": 88026,
    "vorder": 50,
    "position": 1,
    "text": "گذشتی ز تیمار و رستی به جان"
  },
  {
    "poem_id": 88026,
    "vorder": 51,
    "position": 0,
    "text": "بر و بوم و خویشانت آباد گشت"
  },
  {
    "poem_id": 88026,
    "vorder": 52,
    "position": 1,
    "text": "ز تیغ منت گردن آزاد گشت"
  },
  {
    "poem_id": 88026,
    "vorder": 53,
    "position": 0,
    "text": "ور از تو پدیدار آید گناه"
  },
  {
    "poem_id": 88026,
    "vorder": 54,
    "position": 1,
    "text": "نماند به تو مهر و تخت و کلاه"
  },
  {
    "poem_id": 88026,
    "vorder": 55,
    "position": 0,
    "text": "نجویم بر این کینه آرام و خواب"
  },
  {
    "poem_id": 88026,
    "vorder": 56,
    "position": 1,
    "text": "من و گرز و میدان افراسیاب"
  },
  {
    "poem_id": 88026,
    "vorder": 57,
    "position": 0,
    "text": "کزو شاه ما را به کین خواستن"
  },
  {
    "poem_id": 88026,
    "vorder": 58,
    "position": 1,
    "text": "نباید بسی لشکر آراستن"
  },
  {
    "poem_id": 88026,
    "vorder": 59,
    "position": 0,
    "text": "مگر پند من سربه سر بشنوی"
  },
  {
    "poem_id": 88026,
    "vorder": 60,
    "position": 1,
    "text": "به گفتار هشیار من بگروی"
  },
  {
    "poem_id": 88026,
    "vorder": 61,
    "position": 0,
    "text": "نخستین کسی کو پی افگند کین"
  },
  {
    "poem_id": 88026,
    "vorder": 62,
    "position": 1,
    "text": "به خون ریختن برنوشت آستین"
  },
  {
    "poem_id": 88026,
    "vorder": 63,
    "position": 0,
    "text": "به خون سیاووش یازید دست"
  },
  {
    "poem_id": 88026,
    "vorder": 64,
    "position": 1,
    "text": "جهانی به بیداد بر کرد پست"
  },
  {
    "poem_id": 88026,
    "vorder": 65,
    "position": 0,
    "text": "به سان سگانش از آن انجمن"
  },
  {
    "poem_id": 88026,
    "vorder": 66,
    "position": 1,
    "text": "ببندی فرستی به نزدیک من"
  },
  {
    "poem_id": 88026,
    "vorder": 67,
    "position": 0,
    "text": "بدان تا فرستم به نزدیک شاه"
  },
  {
    "poem_id": 88026,
    "vorder": 68,
    "position": 1,
    "text": "چه شان سر ستاند چه بخشد کلاه"
  },
  {
    "poem_id": 88026,
    "vorder": 69,
    "position": 0,
    "text": "تو نشنیدی آن داستان بزرگ"
  },
  {
    "poem_id": 88026,
    "vorder": 70,
    "position": 1,
    "text": "که شیر ژیان آورد پیش گرگ"
  },
  {
    "poem_id": 88026,
    "vorder": 71,
    "position": 0,
    "text": "که هر کو به خون کیان دست آخت"
  },
  {
    "poem_id": 88026,
    "vorder": 72,
    "position": 1,
    "text": "زمانه به جز خاک جایش نساخت"
  },
  {
    "poem_id": 88026,
    "vorder": 73,
    "position": 0,
    "text": "دگر هرچ از گنج نزدیک تست"
  },
  {
    "poem_id": 88026,
    "vorder": 74,
    "position": 1,
    "text": "همه دشمن جان تاریک تست"
  },
  {
    "poem_id": 88026,
    "vorder": 75,
    "position": 0,
    "text": "ز اسپان پرمایه و گوهران"
  },
  {
    "poem_id": 88026,
    "vorder": 76,
    "position": 1,
    "text": "ز دیبا و دینار وز افسران"
  },
  {
    "poem_id": 88026,
    "vorder": 77,
    "position": 0,
    "text": "ز ترگ و ز شمشیر و برگستوان"
  },
  {
    "poem_id": 88026,
    "vorder": 78,
    "position": 1,
    "text": "ز خفتان، و از خنجر هندوان"
  },
  {
    "poem_id": 88026,
    "vorder": 79,
    "position": 0,
    "text": "همه آلت لشکر و سیم و زر"
  },
  {
    "poem_id": 88026,
    "vorder": 80,
    "position": 1,
    "text": "فرستی به نزدیک ما سربه سر"
  },
  {
    "poem_id": 88026,
    "vorder": 81,
    "position": 0,
    "text": "به بیداد کز مردمان بستدی"
  },
  {
    "poem_id": 88026,
    "vorder": 82,
    "position": 1,
    "text": "فراز آوریدی ز دست بدی"
  },
  {
    "poem_id": 88026,
    "vorder": 83,
    "position": 0,
    "text": "بدان باز خری مگر جان خویش"
  },
  {
    "poem_id": 88026,
    "vorder": 84,
    "position": 1,
    "text": "از این در کنی زود درمان خویش"
  },
  {
    "poem_id": 88026,
    "vorder": 85,
    "position": 0,
    "text": "چه اندر خور شهریارست از آن"
  },
  {
    "poem_id": 88026,
    "vorder": 86,
    "position": 1,
    "text": "فرستم به نزدیک شاه جهان"
  },
  {
    "poem_id": 88026,
    "vorder": 87,
    "position": 0,
    "text": "ببخشیم دیگر همه بر سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 88,
    "position": 1,
    "text": "به جای مکافات کرده گناه"
  },
  {
    "poem_id": 88026,
    "vorder": 89,
    "position": 0,
    "text": "و دیگر که پور گزین ترا"
  },
  {
    "poem_id": 88026,
    "vorder": 90,
    "position": 1,
    "text": "نگهبان گاه و نگین ترا"
  },
  {
    "poem_id": 88026,
    "vorder": 91,
    "position": 0,
    "text": "برادرت هر دو سران سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 92,
    "position": 1,
    "text": "که هزمان برآرند گردن به ماه"
  },
  {
    "poem_id": 88026,
    "vorder": 93,
    "position": 0,
    "text": "چو هر سه بدین نامدار انجمن"
  },
  {
    "poem_id": 88026,
    "vorder": 94,
    "position": 1,
    "text": "گروگان فرستی به نزدیک من"
  },
  {
    "poem_id": 88026,
    "vorder": 95,
    "position": 0,
    "text": "بدان تا شوم ایمن از کار تو"
  },
  {
    "poem_id": 88026,
    "vorder": 96,
    "position": 1,
    "text": "برآرد درخت وفا بار تو"
  },
  {
    "poem_id": 88026,
    "vorder": 97,
    "position": 0,
    "text": "تو نیز آنگهی برگزینی دو راه"
  },
  {
    "poem_id": 88026,
    "vorder": 98,
    "position": 1,
    "text": "یکی راه‌جویی به نزدیک شاه"
  },
  {
    "poem_id": 88026,
    "vorder": 99,
    "position": 0,
    "text": "ابا دودمان نزد خسرو شوی"
  },
  {
    "poem_id": 88026,
    "vorder": 100,
    "position": 1,
    "text": "بدان سایهٔ مهر او بغنوی"
  },
  {
    "poem_id": 88026,
    "vorder": 101,
    "position": 0,
    "text": "کنم با تو پیمان که خسرو ترا"
  },
  {
    "poem_id": 88026,
    "vorder": 102,
    "position": 1,
    "text": "به خورشید تابان برآرد سرا"
  },
  {
    "poem_id": 88026,
    "vorder": 103,
    "position": 0,
    "text": "ز مهر دل او تو آگه تری"
  },
  {
    "poem_id": 88026,
    "vorder": 104,
    "position": 1,
    "text": "کزو هیچ ناید جز از بهتری"
  },
  {
    "poem_id": 88026,
    "vorder": 105,
    "position": 0,
    "text": "بشویی دل از مهر افراسیاب"
  },
  {
    "poem_id": 88026,
    "vorder": 106,
    "position": 1,
    "text": "نبینی شب تیره او را به خواب"
  },
  {
    "poem_id": 88026,
    "vorder": 107,
    "position": 0,
    "text": "گر از شاه ترکان بترسی ز بد"
  },
  {
    "poem_id": 88026,
    "vorder": 108,
    "position": 1,
    "text": "نخواهی که آیی به ایران سزد"
  },
  {
    "poem_id": 88026,
    "vorder": 109,
    "position": 0,
    "text": "بپرداز توران و بنشین به چاج"
  },
  {
    "poem_id": 88026,
    "vorder": 110,
    "position": 1,
    "text": "ببر تخت ساج و بر افراز تاج"
  },
  {
    "poem_id": 88026,
    "vorder": 111,
    "position": 0,
    "text": "ورت سوی افراسیابست رای"
  },
  {
    "poem_id": 88026,
    "vorder": 112,
    "position": 1,
    "text": "برو سوی او جنگ ما را مپای"
  },
  {
    "poem_id": 88026,
    "vorder": 113,
    "position": 0,
    "text": "اگر تو بخواهی بسیچید جنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 114,
    "position": 1,
    "text": "مرا زور شیرست و چنگ پلنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 115,
    "position": 0,
    "text": "به ترکان نمانم من از تخت بهر"
  },
  {
    "poem_id": 88026,
    "vorder": 116,
    "position": 1,
    "text": "کمان من ابرست و بارانش زهر"
  },
  {
    "poem_id": 88026,
    "vorder": 117,
    "position": 0,
    "text": "بسیچیدهٔ جنگ خیز اندرآی"
  },
  {
    "poem_id": 88026,
    "vorder": 118,
    "position": 1,
    "text": "گرت هست با شیر درنده پای"
  },
  {
    "poem_id": 88026,
    "vorder": 119,
    "position": 0,
    "text": "چو صف برکشید از دو رویه سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 120,
    "position": 1,
    "text": "گنهکار پیدا شد از بیگناه"
  },
  {
    "poem_id": 88026,
    "vorder": 121,
    "position": 0,
    "text": "گرین گفته‌های مرا نشنوی"
  },
  {
    "poem_id": 88026,
    "vorder": 122,
    "position": 1,
    "text": "به فرجام کارت پشیمان شوی"
  },
  {
    "poem_id": 88026,
    "vorder": 123,
    "position": 0,
    "text": "پشیمانی آنگه نداردت سود"
  },
  {
    "poem_id": 88026,
    "vorder": 124,
    "position": 1,
    "text": "که تیغ زمانه سرت را درود"
  },
  {
    "poem_id": 88026,
    "vorder": 125,
    "position": 0,
    "text": "بگفت این سخن پهلوان با پسر"
  },
  {
    "poem_id": 88026,
    "vorder": 126,
    "position": 1,
    "text": "که برخوان به پیران همه دربه در"
  },
  {
    "poem_id": 88026,
    "vorder": 127,
    "position": 0,
    "text": "ز پیش پدر گیو شد تا به بلخ"
  },
  {
    "poem_id": 88026,
    "vorder": 128,
    "position": 1,
    "text": "گرفته به یاد آن سخنهای تلخ"
  },
  {
    "poem_id": 88026,
    "vorder": 129,
    "position": 0,
    "text": "فرود آمد و کس فرستاد زود"
  },
  {
    "poem_id": 88026,
    "vorder": 130,
    "position": 1,
    "text": "بر آن سان که گودرز فرموده بود"
  },
  {
    "poem_id": 88026,
    "vorder": 131,
    "position": 0,
    "text": "همان شب سپاه اندر آورد گرد"
  },
  {
    "poem_id": 88026,
    "vorder": 132,
    "position": 1,
    "text": "برفت از در بلخ تا ویسه گرد"
  },
  {
    "poem_id": 88026,
    "vorder": 133,
    "position": 0,
    "text": "که پیران بدان شهر بد با سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 134,
    "position": 1,
    "text": "که دیهیم ایران همی جست و گاه"
  },
  {
    "poem_id": 88026,
    "vorder": 135,
    "position": 0,
    "text": "فرستاده چون سوی پیران رسید"
  },
  {
    "poem_id": 88026,
    "vorder": 136,
    "position": 1,
    "text": "سپهدار پیران سپه را بدید"
  },
  {
    "poem_id": 88026,
    "vorder": 137,
    "position": 0,
    "text": "بگفتند کآمد سوی بلخ گیو"
  },
  {
    "poem_id": 88026,
    "vorder": 138,
    "position": 1,
    "text": "ابا ویژگان سپهدار نیو"
  },
  {
    "poem_id": 88026,
    "vorder": 139,
    "position": 0,
    "text": "چو بشنید پیران برافراخت کوس"
  },
  {
    "poem_id": 88026,
    "vorder": 140,
    "position": 1,
    "text": "شد از سم اسبان زمین آبنوس"
  },
  {
    "poem_id": 88026,
    "vorder": 141,
    "position": 0,
    "text": "ده و دو هزارش ز لشکر سوار"
  },
  {
    "poem_id": 88026,
    "vorder": 142,
    "position": 1,
    "text": "فراز آمد اندر خور کارزار"
  },
  {
    "poem_id": 88026,
    "vorder": 143,
    "position": 0,
    "text": "از ایشان دو بهره هم آنجا بماند"
  },
  {
    "poem_id": 88026,
    "vorder": 144,
    "position": 1,
    "text": "برفت و جهاندیدگان را بخواند"
  },
  {
    "poem_id": 88026,
    "vorder": 145,
    "position": 0,
    "text": "بیامد چو نزدیک جیحون رسید"
  },
  {
    "poem_id": 88026,
    "vorder": 146,
    "position": 1,
    "text": "به گرد لب آب لشکر کشید"
  },
  {
    "poem_id": 88026,
    "vorder": 147,
    "position": 0,
    "text": "به جیحون پر از نیزه دیوار کرد"
  },
  {
    "poem_id": 88026,
    "vorder": 148,
    "position": 1,
    "text": "چو با گیو گودرز دیدار کرد"
  },
  {
    "poem_id": 88026,
    "vorder": 149,
    "position": 0,
    "text": "دو هفته شد اندر سخنشان درنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 150,
    "position": 1,
    "text": "بدان تا نباشد به بیداد جنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 151,
    "position": 0,
    "text": "ز هر گونه گفتند و پیران شنید"
  },
  {
    "poem_id": 88026,
    "vorder": 152,
    "position": 1,
    "text": "گنهکاری آمد ز ترکان پدید"
  },
  {
    "poem_id": 88026,
    "vorder": 153,
    "position": 0,
    "text": "بزرگان ایران زمان یافتند"
  },
  {
    "poem_id": 88026,
    "vorder": 154,
    "position": 1,
    "text": "بر ایشان به گفتار بشتافتند"
  },
  {
    "poem_id": 88026,
    "vorder": 155,
    "position": 0,
    "text": "برافگند پیران هم اندر شتاب"
  },
  {
    "poem_id": 88026,
    "vorder": 156,
    "position": 1,
    "text": "نوندی به نزدیک افراسیاب"
  },
  {
    "poem_id": 88026,
    "vorder": 157,
    "position": 0,
    "text": "که گودرز کشوادگان با سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 158,
    "position": 1,
    "text": "نهاد از بر تخت گردان کلاه"
  },
  {
    "poem_id": 88026,
    "vorder": 159,
    "position": 0,
    "text": "فرستاده آمد به نزدیک من"
  },
  {
    "poem_id": 88026,
    "vorder": 160,
    "position": 1,
    "text": "گزین پور او مهتر انجمن"
  },
  {
    "poem_id": 88026,
    "vorder": 161,
    "position": 0,
    "text": "مرا گوش و دل سوی فرمان تست"
  },
  {
    "poem_id": 88026,
    "vorder": 162,
    "position": 1,
    "text": "به پیمان روانم گروگان تست"
  },
  {
    "poem_id": 88026,
    "vorder": 163,
    "position": 0,
    "text": "سخن چون به سالار ترکان رسید"
  },
  {
    "poem_id": 88026,
    "vorder": 164,
    "position": 1,
    "text": "سپاهی ز جنگ آوران برگزید"
  },
  {
    "poem_id": 88026,
    "vorder": 165,
    "position": 0,
    "text": "فرستاد نزدیک پیران سوار"
  },
  {
    "poem_id": 88026,
    "vorder": 166,
    "position": 1,
    "text": "ز گردان شمشیر زن سی هزار"
  },
  {
    "poem_id": 88026,
    "vorder": 167,
    "position": 0,
    "text": "بدو گفت بردار شمشیر کین"
  },
  {
    "poem_id": 88026,
    "vorder": 168,
    "position": 1,
    "text": "وز ایشان بپرداز روی زمین"
  },
  {
    "poem_id": 88026,
    "vorder": 169,
    "position": 0,
    "text": "نه گودرز باید که ماند نه گیو"
  },
  {
    "poem_id": 88026,
    "vorder": 170,
    "position": 1,
    "text": "نه فرهاد و گرگین نه رهام نیو"
  },
  {
    "poem_id": 88026,
    "vorder": 171,
    "position": 0,
    "text": "که بر ما سپه آمد از چار سوی"
  },
  {
    "poem_id": 88026,
    "vorder": 172,
    "position": 1,
    "text": "همی گاه توران کنند آرزوی"
  },
  {
    "poem_id": 88026,
    "vorder": 173,
    "position": 0,
    "text": "جفا پیشه گشتم از این پس به جنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 174,
    "position": 1,
    "text": "نجویم به خون ریختن بر درنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 175,
    "position": 0,
    "text": "به رای هشیوار و مردان مرد"
  },
  {
    "poem_id": 88026,
    "vorder": 176,
    "position": 1,
    "text": "برآرم ز کیخسرو این بار گرد"
  },
  {
    "poem_id": 88026,
    "vorder": 177,
    "position": 0,
    "text": "چو پیران بدید آن سپاه بزرگ"
  },
  {
    "poem_id": 88026,
    "vorder": 178,
    "position": 1,
    "text": "به خون تشنه هر یک به کردار گرگ"
  },
  {
    "poem_id": 88026,
    "vorder": 179,
    "position": 0,
    "text": "بر آشفت از آن پس که نیرو گرفت"
  },
  {
    "poem_id": 88026,
    "vorder": 180,
    "position": 1,
    "text": "هنرها بشست از دل آهو گرفت"
  },
  {
    "poem_id": 88026,
    "vorder": 181,
    "position": 0,
    "text": "جفا پیشه گشت آن دل نیکخوی"
  },
  {
    "poem_id": 88026,
    "vorder": 182,
    "position": 1,
    "text": "پر اندیشه شد رزم کرد آرزوی"
  },
  {
    "poem_id": 88026,
    "vorder": 183,
    "position": 0,
    "text": "به گیو آنگهی گفت برخیز و رو"
  },
  {
    "poem_id": 88026,
    "vorder": 184,
    "position": 1,
    "text": "سوی پهلوان سپه باز شو"
  },
  {
    "poem_id": 88026,
    "vorder": 185,
    "position": 0,
    "text": "بگویش که از من تو چیزی مجوی"
  },
  {
    "poem_id": 88026,
    "vorder": 186,
    "position": 1,
    "text": "که فرزانگان آن نبینند روی"
  },
  {
    "poem_id": 88026,
    "vorder": 187,
    "position": 0,
    "text": "یکی آنکه از نامدار گوان"
  },
  {
    "poem_id": 88026,
    "vorder": 188,
    "position": 1,
    "text": "گروگان همی خواهی این کی توان"
  },
  {
    "poem_id": 88026,
    "vorder": 189,
    "position": 0,
    "text": "و دیگر که گفتی سلیح و سپاه"
  },
  {
    "poem_id": 88026,
    "vorder": 190,
    "position": 1,
    "text": "گرانمایه اسبان و تخت و کلاه"
  },
  {
    "poem_id": 88026,
    "vorder": 191,
    "position": 0,
    "text": "برادر که روشن جهان منست"
  },
  {
    "poem_id": 88026,
    "vorder": 192,
    "position": 1,
    "text": "گزیده پسر پهلوان منست"
  },
  {
    "poem_id": 88026,
    "vorder": 193,
    "position": 0,
    "text": "همی گویی از خویشتن دور کن"
  },
  {
    "poem_id": 88026,
    "vorder": 194,
    "position": 1,
    "text": "ز بخرد چنین خام باشد سخن"
  },
  {
    "poem_id": 88026,
    "vorder": 195,
    "position": 0,
    "text": "مرا مرگ بهتر از آن زندگی"
  },
  {
    "poem_id": 88026,
    "vorder": 196,
    "position": 1,
    "text": "که سالار باشم کنم بندگی"
  },
  {
    "poem_id": 88026,
    "vorder": 197,
    "position": 0,
    "text": "یکی داستان زد بر این بر پلنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 198,
    "position": 1,
    "text": "چو با شیر جنگ آورش خاست جنگ"
  },
  {
    "poem_id": 88026,
    "vorder": 199,
    "position": 0,
    "text": "به نام ار بریزی مرا گفت خون"
  },
  {
    "poem_id": 88026,
    "vorder": 200,
    "position": 1,
    "text": "به از زندگانی به ننگ اندرون"
  },
  {
    "poem_id": 88026,
    "vorder": 201,
    "position": 0,
    "text": "و دیگر که پیغام شاه آمدست"
  },
  {
    "poem_id": 88026,
    "vorder": 202,
    "position": 1,
    "text": "به فرمان جنگم سپاه آمدست"
  },
  {
    "poem_id": 88026,
    "vorder": 203,
    "position": 0,
    "text": "چو پاسخ چنین یافت برگشت گیو"
  },
  {
    "poem_id": 88026,
    "vorder": 204,
    "position": 1,
    "text": "ابا لشکری نامبردار و نیو"
  },
  {
    "poem_id": 88026,
    "vorder": 205,
    "position": 0,
    "text": "سپهدار چون گیو برگشت از اوی"
  },
  {
    "poem_id": 88026,
    "vorder": 206,
    "position": 1,
    "text": "خروشان سوی جنگ بنهاد روی"
  },
  {
    "poem_id": 88026,
    "vorder": 207,
    "position": 0,
    "text": "دمان از پس گیو پیران دلیر"
  },
  {
    "poem_id": 88026,
    "vorder": 208,
    "position": 1,
    "text": "سپه را همی راند بر سان شیر"
  },
  {
    "poem_id": 88026,
    "vorder": 209,
    "position": 0,
    "text": "بیامد چو پیش کنابد رسید"
  },
  {
    "poem_id": 88026,
    "vorder": 210,
    "position": 1,
    "text": "بر آن دامن کوه لشکر کشید"
  }
]