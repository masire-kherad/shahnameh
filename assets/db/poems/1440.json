[
  {
    "poem_id": 1440,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه تنگ بسته کمر"
  },
  {
    "poem_id": 1440,
    "vorder": 2,
    "position": 1,
    "text": "بیامد پر از کینه و جنگ سر"
  },
  {
    "poem_id": 1440,
    "vorder": 3,
    "position": 0,
    "text": "چو رخش اندر آمد بران هفت کوه"
  },
  {
    "poem_id": 1440,
    "vorder": 4,
    "position": 1,
    "text": "بران نره دیوان گشته گروه"
  },
  {
    "poem_id": 1440,
    "vorder": 5,
    "position": 0,
    "text": "به نزدیکی غار بی‌بن رسید"
  },
  {
    "poem_id": 1440,
    "vorder": 6,
    "position": 1,
    "text": "به گرد اندرون لشکر دیو دید"
  },
  {
    "poem_id": 1440,
    "vorder": 7,
    "position": 0,
    "text": "به اولاد گفت آنچ پرسیدمت"
  },
  {
    "poem_id": 1440,
    "vorder": 8,
    "position": 1,
    "text": "همه بر ره راستی دیدمت"
  },
  {
    "poem_id": 1440,
    "vorder": 9,
    "position": 0,
    "text": "کنون چون گه رفتن آمد فراز"
  },
  {
    "poem_id": 1440,
    "vorder": 10,
    "position": 1,
    "text": "مرا راه بنمای و بگشای راز"
  },
  {
    "poem_id": 1440,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت اولاد چون آفتاب"
  },
  {
    "poem_id": 1440,
    "vorder": 12,
    "position": 1,
    "text": "شود گرم و دیو اندر آید به خواب"
  },
  {
    "poem_id": 1440,
    "vorder": 13,
    "position": 0,
    "text": "بریشان تو پیروز باشی به جنگ"
  },
  {
    "poem_id": 1440,
    "vorder": 14,
    "position": 1,
    "text": "کنون یک زمان کرد باید درنگ"
  },
  {
    "poem_id": 1440,
    "vorder": 15,
    "position": 0,
    "text": "ز دیوان نبینی نشسته یکی"
  },
  {
    "poem_id": 1440,
    "vorder": 16,
    "position": 1,
    "text": "جز از جادوان پاسبان اندکی"
  },
  {
    "poem_id": 1440,
    "vorder": 17,
    "position": 0,
    "text": "بدانگه تو پیروز باشی مگر"
  },
  {
    "poem_id": 1440,
    "vorder": 18,
    "position": 1,
    "text": "اگر یار باشدت پیروزگر"
  },
  {
    "poem_id": 1440,
    "vorder": 19,
    "position": 0,
    "text": "نکرد ایچ رستم به رفتن شتاب"
  },
  {
    "poem_id": 1440,
    "vorder": 20,
    "position": 1,
    "text": "بدان تا برآمد بلند آفتاب"
  },
  {
    "poem_id": 1440,
    "vorder": 21,
    "position": 0,
    "text": "سراپای اولاد بر هم ببست"
  },
  {
    "poem_id": 1440,
    "vorder": 22,
    "position": 1,
    "text": "به خم کمند آنگهی برنشست"
  },
  {
    "poem_id": 1440,
    "vorder": 23,
    "position": 0,
    "text": "برآهیخت جنگی نهنگ از نیام"
  },
  {
    "poem_id": 1440,
    "vorder": 24,
    "position": 1,
    "text": "بغرید چون رعد و برگفت نام"
  },
  {
    "poem_id": 1440,
    "vorder": 25,
    "position": 0,
    "text": "میان سپاه اندر آمد چو گرد"
  },
  {
    "poem_id": 1440,
    "vorder": 26,
    "position": 1,
    "text": "سران را سر از تن همی دور کرد"
  },
  {
    "poem_id": 1440,
    "vorder": 27,
    "position": 0,
    "text": "ناستاد کس پیش او در به جنگ"
  },
  {
    "poem_id": 1440,
    "vorder": 28,
    "position": 1,
    "text": "نجستند با او یکی نام و ننگ"
  },
  {
    "poem_id": 1440,
    "vorder": 29,
    "position": 0,
    "text": "رهش باز دادند و بگریختند"
  },
  {
    "poem_id": 1440,
    "vorder": 30,
    "position": 1,
    "text": "به آورد با او نیاویختند"
  },
  {
    "poem_id": 1440,
    "vorder": 31,
    "position": 0,
    "text": "وزان جایگه سوی دیو سپید"
  },
  {
    "poem_id": 1440,
    "vorder": 32,
    "position": 1,
    "text": "بیامد به کردار تابنده شید"
  },
  {
    "poem_id": 1440,
    "vorder": 33,
    "position": 0,
    "text": "به کردار دوزخ یکی غار دید"
  },
  {
    "poem_id": 1440,
    "vorder": 34,
    "position": 1,
    "text": "تن دیو از تیرگی ناپدید"
  },
  {
    "poem_id": 1440,
    "vorder": 35,
    "position": 0,
    "text": "زمانی همی بود در چنگ تیغ"
  },
  {
    "poem_id": 1440,
    "vorder": 36,
    "position": 1,
    "text": "نبد جای دیدار و راه گریغ"
  },
  {
    "poem_id": 1440,
    "vorder": 37,
    "position": 0,
    "text": "ازان تیرگی جای دیده ندید"
  },
  {
    "poem_id": 1440,
    "vorder": 38,
    "position": 1,
    "text": "زمانی بران جایگه آرمید"
  },
  {
    "poem_id": 1440,
    "vorder": 39,
    "position": 0,
    "text": "چو مژگان بمالید و دیده بشست"
  },
  {
    "poem_id": 1440,
    "vorder": 40,
    "position": 1,
    "text": "دران جای تاریک لختی بجست"
  },
  {
    "poem_id": 1440,
    "vorder": 41,
    "position": 0,
    "text": "به تاریکی اندر یکی کوه دید"
  },
  {
    "poem_id": 1440,
    "vorder": 42,
    "position": 1,
    "text": "سراسر شده غار ازو ناپدید"
  },
  {
    "poem_id": 1440,
    "vorder": 43,
    "position": 0,
    "text": "به رنگ شبه روی و چون شیر موی"
  },
  {
    "poem_id": 1440,
    "vorder": 44,
    "position": 1,
    "text": "جهان پر ز پهنای و بالای اوی"
  },
  {
    "poem_id": 1440,
    "vorder": 45,
    "position": 0,
    "text": "سوی رستم آمد چو کوهی سیاه"
  },
  {
    "poem_id": 1440,
    "vorder": 46,
    "position": 1,
    "text": "از آهنش ساعد ز آهن کلاه"
  },
  {
    "poem_id": 1440,
    "vorder": 47,
    "position": 0,
    "text": "ازو شد دل پیلتن پرنهیب"
  },
  {
    "poem_id": 1440,
    "vorder": 48,
    "position": 1,
    "text": "بترسید کامد به تنگی نشیب"
  },
  {
    "poem_id": 1440,
    "vorder": 49,
    "position": 0,
    "text": "برآشفت برسان پیل ژیان"
  },
  {
    "poem_id": 1440,
    "vorder": 50,
    "position": 1,
    "text": "یکی تیغ تیزش بزد بر میان"
  },
  {
    "poem_id": 1440,
    "vorder": 51,
    "position": 0,
    "text": "ز نیروی رستم ز بالای اوی"
  },
  {
    "poem_id": 1440,
    "vorder": 52,
    "position": 1,
    "text": "بینداخت یک ران و یک پای اوی"
  },
  {
    "poem_id": 1440,
    "vorder": 53,
    "position": 0,
    "text": "بریده برآویخت با او به هم"
  },
  {
    "poem_id": 1440,
    "vorder": 54,
    "position": 1,
    "text": "چو پیل سرافراز و شیر دژم"
  },
  {
    "poem_id": 1440,
    "vorder": 55,
    "position": 0,
    "text": "همی پوست کند این از آن آن ازین"
  },
  {
    "poem_id": 1440,
    "vorder": 56,
    "position": 1,
    "text": "همی گل شد از خون سراسر زمین"
  },
  {
    "poem_id": 1440,
    "vorder": 57,
    "position": 0,
    "text": "به دل گفت رستم گر امروز جان"
  },
  {
    "poem_id": 1440,
    "vorder": 58,
    "position": 1,
    "text": "بماند به من زنده‌ام جاودان"
  },
  {
    "poem_id": 1440,
    "vorder": 59,
    "position": 0,
    "text": "همیدون به دل گفت دیو سپید"
  },
  {
    "poem_id": 1440,
    "vorder": 60,
    "position": 1,
    "text": "که از جان شیرین شدم ناامید"
  },
  {
    "poem_id": 1440,
    "vorder": 61,
    "position": 0,
    "text": "گر ایدونک از چنگ این اژدها"
  },
  {
    "poem_id": 1440,
    "vorder": 62,
    "position": 1,
    "text": "بریده پی و پوست یابم رها"
  },
  {
    "poem_id": 1440,
    "vorder": 63,
    "position": 0,
    "text": "نه کهتر نه برتر منش مهتران"
  },
  {
    "poem_id": 1440,
    "vorder": 64,
    "position": 1,
    "text": "نبینند نیزم به مازندران"
  },
  {
    "poem_id": 1440,
    "vorder": 65,
    "position": 0,
    "text": "همی گفت ازین گونه دیو سپید"
  },
  {
    "poem_id": 1440,
    "vorder": 66,
    "position": 1,
    "text": "همی داد دل را بدینسان نوید"
  },
  {
    "poem_id": 1440,
    "vorder": 67,
    "position": 0,
    "text": "تهمتن به نیروی جان‌آفرین"
  },
  {
    "poem_id": 1440,
    "vorder": 68,
    "position": 1,
    "text": "بکوشید بسیار با درد و کین"
  },
  {
    "poem_id": 1440,
    "vorder": 69,
    "position": 0,
    "text": "بزد دست و برداشتش نره شیر"
  },
  {
    "poem_id": 1440,
    "vorder": 70,
    "position": 1,
    "text": "به گردن برآورد و افگند زیر"
  },
  {
    "poem_id": 1440,
    "vorder": 71,
    "position": 0,
    "text": "فرو برد خنجر دلش بردرید"
  },
  {
    "poem_id": 1440,
    "vorder": 72,
    "position": 1,
    "text": "جگرش از تن تیره بیرون کشید"
  },
  {
    "poem_id": 1440,
    "vorder": 73,
    "position": 0,
    "text": "همه غار یکسر پر از کشته بود"
  },
  {
    "poem_id": 1440,
    "vorder": 74,
    "position": 1,
    "text": "جهان همچو دریای خون گشته بود"
  },
  {
    "poem_id": 1440,
    "vorder": 75,
    "position": 0,
    "text": "بیامد ز اولاد بگشاد بند"
  },
  {
    "poem_id": 1440,
    "vorder": 76,
    "position": 1,
    "text": "به فتراک بربست پیچان کمند"
  },
  {
    "poem_id": 1440,
    "vorder": 77,
    "position": 0,
    "text": "به اولاد داد آن کشیده جگر"
  },
  {
    "poem_id": 1440,
    "vorder": 78,
    "position": 1,
    "text": "سوی شاه کاووس بنهاد سر"
  },
  {
    "poem_id": 1440,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت اولاد کای نره شیر"
  },
  {
    "poem_id": 1440,
    "vorder": 80,
    "position": 1,
    "text": "جهانی به تیغ آوریدی به زیر"
  },
  {
    "poem_id": 1440,
    "vorder": 81,
    "position": 0,
    "text": "نشانهای بند تو دارد تنم"
  },
  {
    "poem_id": 1440,
    "vorder": 82,
    "position": 1,
    "text": "به زیر کمند تو بد گردنم"
  },
  {
    "poem_id": 1440,
    "vorder": 83,
    "position": 0,
    "text": "به چیزی که دادی دلم را امید"
  },
  {
    "poem_id": 1440,
    "vorder": 84,
    "position": 1,
    "text": "همی باز خواهد امیدم نوید"
  },
  {
    "poem_id": 1440,
    "vorder": 85,
    "position": 0,
    "text": "به پیمان شکستن نه اندر خوری"
  },
  {
    "poem_id": 1440,
    "vorder": 86,
    "position": 1,
    "text": "که شیر ژیانی و کی منظری"
  },
  {
    "poem_id": 1440,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت رستم که مازندران"
  },
  {
    "poem_id": 1440,
    "vorder": 88,
    "position": 1,
    "text": "سپارم ترا از کران تا کران"
  },
  {
    "poem_id": 1440,
    "vorder": 89,
    "position": 0,
    "text": "ترا زین سپس بی‌نیازی دهم"
  },
  {
    "poem_id": 1440,
    "vorder": 90,
    "position": 1,
    "text": "به مازندران سرفرازی دهم"
  },
  {
    "poem_id": 1440,
    "vorder": 91,
    "position": 0,
    "text": "یکی کار پیشست و رنج دراز"
  },
  {
    "poem_id": 1440,
    "vorder": 92,
    "position": 1,
    "text": "که هم با نشیب است و هم با فراز"
  },
  {
    "poem_id": 1440,
    "vorder": 93,
    "position": 0,
    "text": "همی شاه مازندران را ز گاه"
  },
  {
    "poem_id": 1440,
    "vorder": 94,
    "position": 1,
    "text": "بباید ربودن فگندن به چاه"
  },
  {
    "poem_id": 1440,
    "vorder": 95,
    "position": 0,
    "text": "سر دیو جادو هزاران هزار"
  },
  {
    "poem_id": 1440,
    "vorder": 96,
    "position": 1,
    "text": "بیفگند باید به خنجر به زار"
  },
  {
    "poem_id": 1440,
    "vorder": 97,
    "position": 0,
    "text": "ازان پس اگر خاک را بسپرم"
  },
  {
    "poem_id": 1440,
    "vorder": 98,
    "position": 1,
    "text": "وگرنه ز پیمان تو نگذرم"
  },
  {
    "poem_id": 1440,
    "vorder": 99,
    "position": 0,
    "text": "رسید آنگهی نزد کاووس کی"
  },
  {
    "poem_id": 1440,
    "vorder": 100,
    "position": 1,
    "text": "یل پهلو افروز فرخنده پی"
  },
  {
    "poem_id": 1440,
    "vorder": 101,
    "position": 0,
    "text": "چنین گفت کای شاه دانش پذیر"
  },
  {
    "poem_id": 1440,
    "vorder": 102,
    "position": 1,
    "text": "به مرگ بداندیش رامش پذیر"
  },
  {
    "poem_id": 1440,
    "vorder": 103,
    "position": 0,
    "text": "دریدم جگرگاه دیو سپید"
  },
  {
    "poem_id": 1440,
    "vorder": 104,
    "position": 1,
    "text": "ندارد بدو شاه ازین پس امید"
  },
  {
    "poem_id": 1440,
    "vorder": 105,
    "position": 0,
    "text": "ز پهلوش بیرون کشیدم جگر"
  },
  {
    "poem_id": 1440,
    "vorder": 106,
    "position": 1,
    "text": "چه فرمان دهد شاه پیروزگر"
  },
  {
    "poem_id": 1440,
    "vorder": 107,
    "position": 0,
    "text": "برو آفرین کرد کاووس شاه"
  },
  {
    "poem_id": 1440,
    "vorder": 108,
    "position": 1,
    "text": "که بی‌تو مبادا نگین و کلاه"
  },
  {
    "poem_id": 1440,
    "vorder": 109,
    "position": 0,
    "text": "بران مام کاو چون تو فرزند زاد"
  },
  {
    "poem_id": 1440,
    "vorder": 110,
    "position": 1,
    "text": "نشاید جز از آفرین کرد یاد"
  },
  {
    "poem_id": 1440,
    "vorder": 111,
    "position": 0,
    "text": "مرا بخت ازین هر دو فرخترست"
  },
  {
    "poem_id": 1440,
    "vorder": 112,
    "position": 1,
    "text": "که پیل هژبر افگنم کهترست"
  },
  {
    "poem_id": 1440,
    "vorder": 113,
    "position": 0,
    "text": "به رستم چنین گفت کاووس کی"
  },
  {
    "poem_id": 1440,
    "vorder": 114,
    "position": 1,
    "text": "که ای گرد و فرزانهٔ نیک پی"
  },
  {
    "poem_id": 1440,
    "vorder": 115,
    "position": 0,
    "text": "به چشم من اندر چکان خون اوی"
  },
  {
    "poem_id": 1440,
    "vorder": 116,
    "position": 1,
    "text": "مگر باز بینم ترا نیز روی"
  },
  {
    "poem_id": 1440,
    "vorder": 117,
    "position": 0,
    "text": "به چشمش چو اندر کشیدند خون"
  },
  {
    "poem_id": 1440,
    "vorder": 118,
    "position": 1,
    "text": "شد آن دیدهٔ تیره خورشیدگون"
  },
  {
    "poem_id": 1440,
    "vorder": 119,
    "position": 0,
    "text": "نهادند زیراندرش تخت عاج"
  },
  {
    "poem_id": 1440,
    "vorder": 120,
    "position": 1,
    "text": "بیاویختند از بر عاج تاج"
  },
  {
    "poem_id": 1440,
    "vorder": 121,
    "position": 0,
    "text": "نشست از بر تخت مازندران"
  },
  {
    "poem_id": 1440,
    "vorder": 122,
    "position": 1,
    "text": "ابا رستم و نامور مهتران"
  },
  {
    "poem_id": 1440,
    "vorder": 123,
    "position": 0,
    "text": "چو طوس و فریبرز و گودرز و گیو"
  },
  {
    "poem_id": 1440,
    "vorder": 124,
    "position": 1,
    "text": "چو رهام و گرگین و فرهاد نیو"
  },
  {
    "poem_id": 1440,
    "vorder": 125,
    "position": 0,
    "text": "برین گونه یک هفته با رود و می"
  },
  {
    "poem_id": 1440,
    "vorder": 126,
    "position": 1,
    "text": "همی رامش آراست کاووس کی"
  },
  {
    "poem_id": 1440,
    "vorder": 127,
    "position": 0,
    "text": "به هشتم نشستند بر زین همه"
  },
  {
    "poem_id": 1440,
    "vorder": 128,
    "position": 1,
    "text": "جهانجوی و گردنکشان و رمه"
  },
  {
    "poem_id": 1440,
    "vorder": 129,
    "position": 0,
    "text": "همه برکشیدند گرز گران"
  },
  {
    "poem_id": 1440,
    "vorder": 130,
    "position": 1,
    "text": "پراگنده در شهر مازندران"
  },
  {
    "poem_id": 1440,
    "vorder": 131,
    "position": 0,
    "text": "برفتند یکسر به فرمان کی"
  },
  {
    "poem_id": 1440,
    "vorder": 132,
    "position": 1,
    "text": "چو آتش که برخیزد از خشک نی"
  },
  {
    "poem_id": 1440,
    "vorder": 133,
    "position": 0,
    "text": "ز شمشیر تیز آتش افروختند"
  },
  {
    "poem_id": 1440,
    "vorder": 134,
    "position": 1,
    "text": "همه شهر یکسر همی سوختند"
  },
  {
    "poem_id": 1440,
    "vorder": 135,
    "position": 0,
    "text": "به لشکر چنین گفت کاووس شاه"
