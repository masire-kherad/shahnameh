  {
    "poem_id": 1440,
    "vorder": 136,
    "position": 1,
    "text": "که اکنون مکافات کرده گناه"
  },
  {
    "poem_id": 1440,
    "vorder": 137,
    "position": 0,
    "text": "چنان چون سزا بد بدیشان رسید"
  },
  {
    "poem_id": 1440,
    "vorder": 138,
    "position": 1,
    "text": "ز کشتن کنون دست باید کشید"
  },
  {
    "poem_id": 1440,
    "vorder": 139,
    "position": 0,
    "text": "بباید یکی مرد با هوش و سنگ"
  },
  {
    "poem_id": 1440,
    "vorder": 140,
    "position": 1,
    "text": "کجا باز داند شتاب از درنگ"
  },
  {
    "poem_id": 1440,
    "vorder": 141,
    "position": 0,
    "text": "شود نزد سالار مازندران"
  },
  {
    "poem_id": 1440,
    "vorder": 142,
