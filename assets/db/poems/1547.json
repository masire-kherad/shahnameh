[
  {
    "poem_id": 1547,
    "vorder": 1,
    "position": 0,
    "text": "کی نامبردار زان روزگار"
  },
  {
    "poem_id": 1547,
    "vorder": 2,
    "position": 1,
    "text": "نشست از بر گاه آن شهریار"
  },
  {
    "poem_id": 1547,
    "vorder": 3,
    "position": 0,
    "text": "گزینان لشکرش را بار داد"
  },
  {
    "poem_id": 1547,
    "vorder": 4,
    "position": 1,
    "text": "بزرگان و شاهان مهترنژاد"
  },
  {
    "poem_id": 1547,
    "vorder": 5,
    "position": 0,
    "text": "ز پیش اندر آمد گو اسفندیار"
  },
  {
    "poem_id": 1547,
    "vorder": 6,
    "position": 1,
    "text": "به دست اندرون گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1547,
    "vorder": 7,
    "position": 0,
    "text": "نهاده به سر بر کیانی کلاه"
  },
  {
    "poem_id": 1547,
    "vorder": 8,
    "position": 1,
    "text": "به زیر کلاهش همی تافت ماه"
  },
  {
    "poem_id": 1547,
    "vorder": 9,
    "position": 0,
    "text": "به استاد در پیش او شیرفش"
  },
  {
    "poem_id": 1547,
    "vorder": 10,
    "position": 1,
    "text": "سرافگنده و دست کرده به کش"
  },
  {
    "poem_id": 1547,
    "vorder": 11,
    "position": 0,
    "text": "چو شاه جهان روی او را بدید"
  },
  {
    "poem_id": 1547,
    "vorder": 12,
    "position": 1,
    "text": "ز جان و جهانش به دل برگزید"
  },
  {
    "poem_id": 1547,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت شاه ای یل اسفندیار"
  },
  {
    "poem_id": 1547,
    "vorder": 14,
    "position": 1,
    "text": "همی آرزو بایدت کارزار"
  },
  {
    "poem_id": 1547,
    "vorder": 15,
    "position": 0,
    "text": "یل تیغ‌زن گفت فرمان تراست"
  },
  {
    "poem_id": 1547,
    "vorder": 16,
    "position": 1,
    "text": "که تو شهریاری و گیهان تراست"
  },
  {
    "poem_id": 1547,
    "vorder": 17,
    "position": 0,
    "text": "کی نامور تاج زرینش داد"
  },
  {
    "poem_id": 1547,
    "vorder": 18,
    "position": 1,
    "text": "در گنجها را برو برگشاد"
  },
  {
    "poem_id": 1547,
    "vorder": 19,
    "position": 0,
    "text": "همه کار ایران مر او را سپرد"
  },
  {
    "poem_id": 1547,
    "vorder": 20,
    "position": 1,
    "text": "که او را بدی پهلوی دستبرد"
  },
  {
    "poem_id": 1547,
    "vorder": 21,
    "position": 0,
    "text": "درفشان بدو داد و گنج و سپاه"
  },
  {
    "poem_id": 1547,
    "vorder": 22,
    "position": 1,
    "text": "هنوزت نبد گفت هنگام گاه"
  },
  {
    "poem_id": 1547,
    "vorder": 23,
    "position": 0,
    "text": "برو گفت و پا را به زین اندر آر"
  },
  {
    "poem_id": 1547,
    "vorder": 24,
    "position": 1,
    "text": "همه کشورت را به دین اندر آر"
  },
  {
    "poem_id": 1547,
    "vorder": 25,
    "position": 0,
    "text": "بشد تیغ زن گردکش پور شاه"
  },
  {
    "poem_id": 1547,
    "vorder": 26,
    "position": 1,
    "text": "بگردید بر کشورش با سپاه"
  },
  {
    "poem_id": 1547,
    "vorder": 27,
    "position": 0,
    "text": "به روم و به هندوستان برگذشت"
  },
  {
    "poem_id": 1547,
    "vorder": 28,
    "position": 1,
    "text": "ز دریا و تاریکی اندر گذشت"
  },
  {
    "poem_id": 1547,
    "vorder": 29,
    "position": 0,
    "text": "شه روم و هندوستان و یمن"
  },
  {
    "poem_id": 1547,
    "vorder": 30,
    "position": 1,
    "text": "همه نام کردند بر تهمتن"
  },
  {
    "poem_id": 1547,
    "vorder": 31,
    "position": 0,
    "text": "وزو دین گزارش همی خواستند"
  },
  {
    "poem_id": 1547,
    "vorder": 32,
    "position": 1,
    "text": "مرین دین به را بیاراستند"
  },
  {
    "poem_id": 1547,
    "vorder": 33,
    "position": 0,
    "text": "گزارش همی کرد اسفندیار"
  },
  {
    "poem_id": 1547,
    "vorder": 34,
    "position": 1,
    "text": "به فرمان یزدان همی بست کار"
  },
  {
    "poem_id": 1547,
    "vorder": 35,
    "position": 0,
    "text": "چو آگه شدند از نکو دین اوی"
  },
  {
    "poem_id": 1547,
    "vorder": 36,
    "position": 1,
    "text": "گرفتند آن راه و آیین اوی"
  },
  {
    "poem_id": 1547,
    "vorder": 37,
    "position": 0,
    "text": "بتان از سر کوه میسوختند"
  },
  {
    "poem_id": 1547,
    "vorder": 38,
    "position": 1,
    "text": "بجای بت آذر برافروختند"
  },
  {
    "poem_id": 1547,
    "vorder": 39,
    "position": 0,
    "text": "همه نامه کردند زی شهریار"
  },
  {
    "poem_id": 1547,
    "vorder": 40,
    "position": 1,
    "text": "که ما دین گرفتیم ز اسفندیار"
  },
  {
    "poem_id": 1547,
    "vorder": 41,
    "position": 0,
    "text": "ببستیم کشتی و بگرفت باژ"
  },
  {
    "poem_id": 1547,
    "vorder": 42,
    "position": 1,
    "text": "کنونت نشاید ز ما خاست باژ"
  },
  {
    "poem_id": 1547,
    "vorder": 43,
    "position": 0,
    "text": "که ما راست گشتیم و ایزدپرست"
  },
  {
    "poem_id": 1547,
    "vorder": 44,
    "position": 1,
    "text": "کنون زند و استا سوی ما فرست"
  },
  {
    "poem_id": 1547,
    "vorder": 45,
    "position": 0,
    "text": "چو شه نامهٔ شهریاران بخواند"
  },
  {
    "poem_id": 1547,
    "vorder": 46,
    "position": 1,
    "text": "نشست از برگاه و یاران بخواند"
  },
  {
    "poem_id": 1547,
    "vorder": 47,
    "position": 0,
    "text": "فرستاد زندی به هر کشوری"
  },
  {
    "poem_id": 1547,
    "vorder": 48,
    "position": 1,
    "text": "به هر نامداری و هر مهتری"
  },
  {
    "poem_id": 1547,
    "vorder": 49,
    "position": 0,
    "text": "بفرمود تا نامور پهلوان"
  },
  {
    "poem_id": 1547,
    "vorder": 50,
    "position": 1,
    "text": "همی گشت هر سو به گرد جهان"
  },
  {
    "poem_id": 1547,
    "vorder": 51,
    "position": 0,
    "text": "به هرجا که آن شاه بنهاد روی"
  },
  {
    "poem_id": 1547,
    "vorder": 52,
    "position": 1,
    "text": "بیامد پذیره کسی پیش اوی"
  },
  {
    "poem_id": 1547,
    "vorder": 53,
    "position": 0,
    "text": "همه کس مر او را به فرمان شدند"
  },
  {
    "poem_id": 1547,
    "vorder": 54,
    "position": 1,
    "text": "بدان در جهان پاک پنهان شدند"
  },
  {
    "poem_id": 1547,
    "vorder": 55,
    "position": 0,
    "text": "چو گیتی همه راست شد بر پدرش"
  },
  {
    "poem_id": 1547,
    "vorder": 56,
    "position": 1,
    "text": "گشاد از میان باز زرین کمرش"
  },
  {
    "poem_id": 1547,
    "vorder": 57,
    "position": 0,
    "text": "به شادی نشست از بر تخت و گاه"
  },
  {
    "poem_id": 1547,
    "vorder": 58,
    "position": 1,
    "text": "بیاسود یک چند گه با سپاه"
  },
  {
    "poem_id": 1547,
    "vorder": 59,
    "position": 0,
    "text": "برادرش را خواند فرشیدورد"
  },
  {
    "poem_id": 1547,
    "vorder": 60,
    "position": 1,
    "text": "سپاهی برون کرد مردان مرد"
  },
  {
    "poem_id": 1547,
    "vorder": 61,
    "position": 0,
    "text": "بدو داد و دینار دادش بسی"
  },
  {
    "poem_id": 1547,
    "vorder": 62,
    "position": 1,
    "text": "خراسان بدو داد و کردش گسی"
  },
  {
    "poem_id": 1547,
    "vorder": 63,
    "position": 0,
    "text": "چو یک چند گاهی برآمد برین"
  },
  {
    "poem_id": 1547,
    "vorder": 64,
    "position": 1,
    "text": "جهان ویژه گشت از بد و پاک دین"
  },
  {
    "poem_id": 1547,
    "vorder": 65,
    "position": 0,
    "text": "فرسته فرستاد سوی پدر"
  },
  {
    "poem_id": 1547,
    "vorder": 66,
    "position": 1,
    "text": "که ای نامور شاه پیروزگر"
  },
  {
    "poem_id": 1547,
    "vorder": 67,
    "position": 0,
    "text": "جهان ویژه کردم به دین خدای"
  },
  {
    "poem_id": 1547,
    "vorder": 68,
    "position": 1,
    "text": "به کشور برافگنده سایهٔ همای"
  },
  {
    "poem_id": 1547,
    "vorder": 69,
    "position": 0,
    "text": "کسی را بنیز از کسی بیم نه"
  },
  {
    "poem_id": 1547,
    "vorder": 70,
    "position": 1,
    "text": "به گیتی کسی بی‌زر و سیم نه"
  },
  {
    "poem_id": 1547,
    "vorder": 71,
    "position": 0,
    "text": "فروزنده گیتی بسان بهشت"
  },
  {
    "poem_id": 1547,
    "vorder": 72,
    "position": 1,
    "text": "جهان گشته آباد و هر جای کشت"
  },
  {
    "poem_id": 1547,
    "vorder": 73,
    "position": 0,
    "text": "سواران جهان را همی داشتند"
  },
  {
    "poem_id": 1547,
    "vorder": 74,
    "position": 1,
    "text": "چو برزیگران تخم می‌کاشتند"
  },
  {
    "poem_id": 1547,
    "vorder": 75,
    "position": 0,
    "text": "بدین سان ببوده سراسر جهان"
  },
  {
    "poem_id": 1547,
    "vorder": 76,
    "position": 1,
    "text": "به گیتی شده گم بد بدگمان"
  }
]