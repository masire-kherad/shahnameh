[
  {
    "poem_id": 1837,
    "vorder": 1,
    "position": 0,
    "text": "چو خسرو نشست از برتخت زر"
  },
  {
    "poem_id": 1837,
    "vorder": 2,
    "position": 1,
    "text": "برفتند هرکس که بودش هنر"
  },
  {
    "poem_id": 1837,
    "vorder": 3,
    "position": 0,
    "text": "گرانمایگان را همه خواندند"
  },
  {
    "poem_id": 1837,
    "vorder": 4,
    "position": 1,
    "text": "بر آن تاج نو گوهر افشاندند"
  },
  {
    "poem_id": 1837,
    "vorder": 5,
    "position": 0,
    "text": "به موبد چنین گفت کاین تاج وتخت"
  },
  {
    "poem_id": 1837,
    "vorder": 6,
    "position": 1,
    "text": "نیابد مگر مردم نیک بخت"
  },
  {
    "poem_id": 1837,
    "vorder": 7,
    "position": 0,
    "text": "مبادا مرا پیشه جز راستی"
  },
  {
    "poem_id": 1837,
    "vorder": 8,
    "position": 1,
    "text": "که بیدادی آرد همه کاستی"
  },
  {
    "poem_id": 1837,
    "vorder": 9,
    "position": 0,
    "text": "ابا هرکسی رای ما آشتیست"
  },
  {
    "poem_id": 1837,
    "vorder": 10,
    "position": 1,
    "text": "ز پیکار کردن سرماتهیست"
  },
  {
    "poem_id": 1837,
    "vorder": 11,
    "position": 0,
    "text": "ز یزدان پذیرفتم این تخت نو"
  },
  {
    "poem_id": 1837,
    "vorder": 12,
    "position": 1,
    "text": "همین روشن و مایه وربخت نو"
  },
  {
    "poem_id": 1837,
    "vorder": 13,
    "position": 0,
    "text": "شما نیز دلها بفرمان دهید"
  },
  {
    "poem_id": 1837,
    "vorder": 14,
    "position": 1,
    "text": "بهرکار بر ما سپاسی نهید"
  },
  {
    "poem_id": 1837,
    "vorder": 15,
    "position": 0,
    "text": "از آزردن مردم پارسا"
  },
  {
    "poem_id": 1837,
    "vorder": 16,
    "position": 1,
    "text": "و دیگر کشیدن سر از پادشا"
  },
  {
    "poem_id": 1837,
    "vorder": 17,
    "position": 0,
    "text": "سوم دور بودن ز چیز کسان"
  },
  {
    "poem_id": 1837,
    "vorder": 18,
    "position": 1,
    "text": "که دودش بود سوی آنکس رسان"
  },
  {
    "poem_id": 1837,
    "vorder": 19,
    "position": 0,
    "text": "که درگاه و بی‌گه کسی رابسوخت"
  },
  {
    "poem_id": 1837,
    "vorder": 20,
    "position": 1,
    "text": "ببی مایه چیزی دلش برفروخت"
  },
  {
    "poem_id": 1837,
    "vorder": 21,
    "position": 0,
    "text": "دگر هرچ در مردمی در خورد"
  },
  {
    "poem_id": 1837,
    "vorder": 22,
    "position": 1,
    "text": "مر آن را پذیرنده باشد خرد"
  },
  {
    "poem_id": 1837,
    "vorder": 23,
    "position": 0,
    "text": "نباشد مرا باکسی داوری"
  },
  {
    "poem_id": 1837,
    "vorder": 24,
    "position": 1,
    "text": "اگر تاج جوید گر انگشتری"
  },
  {
    "poem_id": 1837,
    "vorder": 25,
    "position": 0,
    "text": "کرا گوهر تن بود با نژاد"
  },
  {
    "poem_id": 1837,
    "vorder": 26,
    "position": 1,
    "text": "نگوید سخن با کسی جز بداد"
  },
  {
    "poem_id": 1837,
    "vorder": 27,
    "position": 0,
    "text": "نباشد شما را جز از ایمنی"
  },
  {
    "poem_id": 1837,
    "vorder": 28,
    "position": 1,
    "text": "نیازد بکردار آهرمنی"
  },
  {
    "poem_id": 1837,
    "vorder": 29,
    "position": 0,
    "text": "هرآنکس که بشنید گفتار شاه"
  },
  {
    "poem_id": 1837,
    "vorder": 30,
    "position": 1,
    "text": "همی آفرین خواند برتاج و گاه"
  },
  {
    "poem_id": 1837,
    "vorder": 31,
    "position": 0,
    "text": "برفتند شاد از بر تخت او"
  },
  {
    "poem_id": 1837,
    "vorder": 32,
    "position": 1,
    "text": "بسی آفرین بود بر بخت او"
  },
  {
    "poem_id": 1837,
    "vorder": 33,
    "position": 0,
    "text": "سپهبد فرود آمد از تخت شاد"
  },
  {
    "poem_id": 1837,
    "vorder": 34,
    "position": 1,
    "text": "همه شب ز هرمز همی‌کرد یاد"
  }
]