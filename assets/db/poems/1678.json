[
  {
    "poem_id": 1678,
    "vorder": 1,
    "position": 0,
    "text": "وزان روی لشکر سوی چین کشید"
  },
  {
    "poem_id": 1678,
    "vorder": 2,
    "position": 1,
    "text": "سر نامداران به بیرون کشید"
  },
  {
    "poem_id": 1678,
    "vorder": 3,
    "position": 0,
    "text": "همی راند منزل به منزل به دشت"
  },
  {
    "poem_id": 1678,
    "vorder": 4,
    "position": 1,
    "text": "چهل روز تا پیش دریا گذشت"
  },
  {
    "poem_id": 1678,
    "vorder": 5,
    "position": 0,
    "text": "ز دیبا سراپرده‌ای برکشید"
  },
  {
    "poem_id": 1678,
    "vorder": 6,
    "position": 1,
    "text": "سپه را به منزل فرود آورید"
  },
  {
    "poem_id": 1678,
    "vorder": 7,
    "position": 0,
    "text": "یکی نامه فرمود پس تا دبیر"
  },
  {
    "poem_id": 1678,
    "vorder": 8,
    "position": 1,
    "text": "نویسد ز اسکندر شهرگیر"
  },
  {
    "poem_id": 1678,
    "vorder": 9,
    "position": 0,
    "text": "نوشتند هرگونه‌ای خوب و زشت"
  },
  {
    "poem_id": 1678,
    "vorder": 10,
    "position": 1,
    "text": "نویسنده چون نامه اندر نوشت"
  },
  {
    "poem_id": 1678,
    "vorder": 11,
    "position": 0,
    "text": "سکندر بشد چون فرستاده‌ای"
  },
  {
    "poem_id": 1678,
    "vorder": 12,
    "position": 1,
    "text": "گزین کرد بینادل آزاده‌ای"
  },
  {
    "poem_id": 1678,
    "vorder": 13,
    "position": 0,
    "text": "که با او بدی یک‌دل و یک‌سخن"
  },
  {
    "poem_id": 1678,
    "vorder": 14,
    "position": 1,
    "text": "بگوید به مهتر که کن یا مکن"
  },
  {
    "poem_id": 1678,
    "vorder": 15,
    "position": 0,
    "text": "سپه را به سالار لشکر سپرد"
  },
  {
    "poem_id": 1678,
    "vorder": 16,
    "position": 1,
    "text": "وزان رومیان پنج دانا ببرد"
  },
  {
    "poem_id": 1678,
    "vorder": 17,
    "position": 0,
    "text": "چو آگاهی آمد به فغفور ازین"
  },
  {
    "poem_id": 1678,
    "vorder": 18,
    "position": 1,
    "text": "که آمد فرستاده‌ای سوی چین"
  },
  {
    "poem_id": 1678,
    "vorder": 19,
    "position": 0,
    "text": "پذیره فرستاد چندی سپاه"
  },
  {
    "poem_id": 1678,
    "vorder": 20,
    "position": 1,
    "text": "سکندر گرازان بیامد به راه"
  },
  {
    "poem_id": 1678,
    "vorder": 21,
    "position": 0,
    "text": "چو آمد بران بارگاه بزرگ"
  },
  {
    "poem_id": 1678,
    "vorder": 22,
    "position": 1,
    "text": "بدید آن گزیده سپاه بزرگ"
  },
  {
    "poem_id": 1678,
    "vorder": 23,
    "position": 0,
    "text": "بیامد ز دهلیز تا پیش اوی"
  },
  {
    "poem_id": 1678,
    "vorder": 24,
    "position": 1,
    "text": "پراندیشه جان بداندیش اوی"
  },
  {
    "poem_id": 1678,
    "vorder": 25,
    "position": 0,
    "text": "دوان پیش او رفت و بردش نماز"
  },
  {
    "poem_id": 1678,
    "vorder": 26,
    "position": 1,
    "text": "نشست اندر ایوان زمانی دراز"
  },
  {
    "poem_id": 1678,
    "vorder": 27,
    "position": 0,
    "text": "بپرسید فغفور و بنواختش"
  },
  {
    "poem_id": 1678,
    "vorder": 28,
    "position": 1,
    "text": "یکی نامور جایگه ساختش"
  },
  {
    "poem_id": 1678,
    "vorder": 29,
    "position": 0,
    "text": "چو برزد سر از کوه روشن چراغ"
  },
  {
    "poem_id": 1678,
    "vorder": 30,
    "position": 1,
    "text": "ببردند بالای زرین جناغ"
  },
  {
    "poem_id": 1678,
    "vorder": 31,
    "position": 0,
    "text": "فرستادهٔ شاه را پیش خواند"
  },
  {
    "poem_id": 1678,
    "vorder": 32,
    "position": 1,
    "text": "سکندر فراوان سخنها براند"
  },
  {
    "poem_id": 1678,
    "vorder": 33,
    "position": 0,
    "text": "بگفت آنچ بایست و نامه بداد"
  },
  {
    "poem_id": 1678,
    "vorder": 34,
    "position": 1,
    "text": "سخنهای قیصر همه کرد یاد"
  },
  {
    "poem_id": 1678,
    "vorder": 35,
    "position": 0,
    "text": "بران نامه عنوان بد از شاه روم"
  },
  {
    "poem_id": 1678,
    "vorder": 36,
    "position": 1,
    "text": "جهاندار و سالار هر مرز و بوم"
  },
  {
    "poem_id": 1678,
    "vorder": 37,
    "position": 0,
    "text": "که خوانند شاهان برو آفرین"
  },
  {
    "poem_id": 1678,
    "vorder": 38,
    "position": 1,
    "text": "زما بندگان جهان آفرین"
  },
  {
    "poem_id": 1678,
    "vorder": 39,
    "position": 0,
    "text": "جهاندار و داننده و رهنمای"
  },
  {
    "poem_id": 1678,
    "vorder": 40,
    "position": 1,
    "text": "خداوند پاکی و نیکی فزای"
  },
  {
    "poem_id": 1678,
    "vorder": 41,
    "position": 0,
    "text": "دگر گفت فرمان ما سوی چین"
  },
  {
    "poem_id": 1678,
    "vorder": 42,
    "position": 1,
    "text": "چنانست که آباد ماند زمین"
  },
  {
    "poem_id": 1678,
    "vorder": 43,
    "position": 0,
    "text": "نباید بسیچید ما را به جنگ"
  },
  {
    "poem_id": 1678,
    "vorder": 44,
    "position": 1,
    "text": "که از جنگ شد روز بر فور تنگ"
  },
  {
    "poem_id": 1678,
    "vorder": 45,
    "position": 0,
    "text": "چو دارا که بد شهریار جهان"
  },
  {
    "poem_id": 1678,
    "vorder": 46,
    "position": 1,
    "text": "چو فریان تازی و دیگر مهان"
  },
  {
    "poem_id": 1678,
    "vorder": 47,
    "position": 0,
    "text": "ز خاور برو تا در باختر"
  },
  {
    "poem_id": 1678,
    "vorder": 48,
    "position": 1,
    "text": "ز فرمان ما کس نجوید گذر"
  },
  {
    "poem_id": 1678,
    "vorder": 49,
    "position": 0,
    "text": "شمار سپاهم نداند سپهر"
  },
  {
    "poem_id": 1678,
    "vorder": 50,
    "position": 1,
    "text": "وگر بشمرد نیز ناهید و مهر"
  },
  {
    "poem_id": 1678,
    "vorder": 51,
    "position": 0,
    "text": "اگر هیچ فرمان ما بشکنی"
  },
  {
    "poem_id": 1678,
    "vorder": 52,
    "position": 1,
    "text": "تن و بوم و کشور به رنج افگنی"
  },
  {
    "poem_id": 1678,
    "vorder": 53,
    "position": 0,
    "text": "چو نامه بخوانی بیارای ساو"
  },
  {
    "poem_id": 1678,
    "vorder": 54,
    "position": 1,
    "text": "مرنجان تن خویش و با بد مکاو"
  },
  {
    "poem_id": 1678,
    "vorder": 55,
    "position": 0,
    "text": "گر آیی بینی مرا با سپاه"
  },
  {
    "poem_id": 1678,
    "vorder": 56,
    "position": 1,
    "text": "ببینم ترا یک‌دل و نیک خواه"
  },
  {
    "poem_id": 1678,
    "vorder": 57,
    "position": 0,
    "text": "بداریم بر تو همین تاج و تخت"
  },
  {
    "poem_id": 1678,
    "vorder": 58,
    "position": 1,
    "text": "به چیزی گزندت نیاید ز بخت"
  },
  {
    "poem_id": 1678,
    "vorder": 59,
    "position": 0,
    "text": "وگر کند باشی به پیش آمدن"
  },
  {
    "poem_id": 1678,
    "vorder": 60,
    "position": 1,
    "text": "ز کشور سوی شاه خویش آمدن"
  },
  {
    "poem_id": 1678,
    "vorder": 61,
    "position": 0,
    "text": "ز چیزی که باشد طرایف به چین"
  },
  {
    "poem_id": 1678,
    "vorder": 62,
    "position": 1,
    "text": "ز زرینه و اسپ و تیغ و نگین"
  },
  {
    "poem_id": 1678,
    "vorder": 63,
    "position": 0,
    "text": "هم از جامه و پرده و تخت عاج"
  },
  {
    "poem_id": 1678,
    "vorder": 64,
    "position": 1,
    "text": "ز دیبای پرمایه و طوق و تاج"
  },
  {
    "poem_id": 1678,
    "vorder": 65,
    "position": 0,
    "text": "ز چیزی که یابی فرستی به گنج"
  },
  {
    "poem_id": 1678,
    "vorder": 66,
    "position": 1,
    "text": "چو خواهی که از ما نیایدت رنج"
  },
  {
    "poem_id": 1678,
    "vorder": 67,
    "position": 0,
    "text": "سپاه مرا بازگردان ز راه"
  },
  {
    "poem_id": 1678,
    "vorder": 68,
    "position": 1,
    "text": "بباش ایمن از گنج و تخت و کلاه"
  },
  {
    "poem_id": 1678,
    "vorder": 69,
    "position": 0,
    "text": "چو سالار چین زان نشان نامه دید"
  },
  {
    "poem_id": 1678,
    "vorder": 70,
    "position": 1,
    "text": "برآشفت و پس خامشی برگزید"
  },
  {
    "poem_id": 1678,
    "vorder": 71,
    "position": 0,
    "text": "بخندید و پس با فرستاده گفت"
  },
  {
    "poem_id": 1678,
    "vorder": 72,
    "position": 1,
    "text": "که شاه ترا آسمان باد جفت"
  },
  {
    "poem_id": 1678,
    "vorder": 73,
    "position": 0,
    "text": "بگوی آنچ دانی ز گفتار اوی"
  },
  {
    "poem_id": 1678,
    "vorder": 74,
    "position": 1,
    "text": "ز بالا و مردی و دیدار اوی"
  },
  {
    "poem_id": 1678,
    "vorder": 75,
    "position": 0,
    "text": "فرستاده گفت ای سپهدار چین"
  },
  {
    "poem_id": 1678,
    "vorder": 76,
    "position": 1,
    "text": "کسی چون سکندر مدان بر زمین"
  },
  {
    "poem_id": 1678,
    "vorder": 77,
    "position": 0,
    "text": "به مردی و رادی و بخش و خرد"
  },
  {
    "poem_id": 1678,
    "vorder": 78,
    "position": 1,
    "text": "ز اندیشهٔ هر کسی بگذرد"
  },
  {
    "poem_id": 1678,
    "vorder": 79,
    "position": 0,
    "text": "به بالای سروست و با زور پیل"
  },
  {
    "poem_id": 1678,
    "vorder": 80,
    "position": 1,
    "text": "به بخشش به کردار دریای نیل"
  },
  {
    "poem_id": 1678,
    "vorder": 81,
    "position": 0,
    "text": "زبانش به کردار برنده تیغ"
  },
  {
    "poem_id": 1678,
    "vorder": 82,
    "position": 1,
    "text": "به چربی عقاب اندر آرد ز میغ"
  },
  {
    "poem_id": 1678,
    "vorder": 83,
    "position": 0,
    "text": "چو بشنید فغفور چین این سخن"
  },
  {
    "poem_id": 1678,
    "vorder": 84,
    "position": 1,
    "text": "یکی دیگر اندیشه افگند بن"
  },
  {
    "poem_id": 1678,
    "vorder": 85,
    "position": 0,
    "text": "بفرمود تا خوان و می خواستند"
  },
  {
    "poem_id": 1678,
    "vorder": 86,
    "position": 1,
    "text": "به باغ اندر ایوان بیاراستند"
  },
  {
    "poem_id": 1678,
    "vorder": 87,
    "position": 0,
    "text": "همی خورد می تا جهان تیره شد"
  },
  {
    "poem_id": 1678,
    "vorder": 88,
    "position": 1,
    "text": "سر میگساران ز می خیره شد"
  },
  {
    "poem_id": 1678,
    "vorder": 89,
    "position": 0,
    "text": "سپهدار چین با فرستاده گفت"
  },
  {
    "poem_id": 1678,
    "vorder": 90,
    "position": 1,
    "text": "که با شاه تو مشتری باد جفت"
  },
  {
    "poem_id": 1678,
    "vorder": 91,
    "position": 0,
    "text": "چو روشن شود نامه پاسخ کنیم"
  },
  {
    "poem_id": 1678,
    "vorder": 92,
    "position": 1,
    "text": "به دیدار تو روز فرخ کنیم"
  },
  {
    "poem_id": 1678,
    "vorder": 93,
    "position": 0,
    "text": "سکندر بیامد ترنجی به دست"
  },
  {
    "poem_id": 1678,
    "vorder": 94,
    "position": 1,
    "text": "ز ایوان سالار چین نیم‌مست"
  },
  {
    "poem_id": 1678,
    "vorder": 95,
    "position": 0,
    "text": "چو خورشید برزد سر از برج شیر"
  },
  {
    "poem_id": 1678,
    "vorder": 96,
    "position": 1,
    "text": "سپهر اندر آورد شب را به زیر"
  },
  {
    "poem_id": 1678,
    "vorder": 97,
    "position": 0,
    "text": "سکندر به نزدیک فغفور شد"
  },
  {
    "poem_id": 1678,
    "vorder": 98,
    "position": 1,
    "text": "از اندیشهٔ بد دلش دور شد"
  },
  {
    "poem_id": 1678,
    "vorder": 99,
    "position": 0,
    "text": "بپرسید زو گفت شب چون بدی"
  },
  {
    "poem_id": 1678,
    "vorder": 100,
    "position": 1,
    "text": "که بیرون شدی دوش میگون بدی"
  },
  {
    "poem_id": 1678,
    "vorder": 101,
    "position": 0,
    "text": "ازان پس بفرمود تا شد دبیر"
  },
  {
    "poem_id": 1678,
    "vorder": 102,
    "position": 1,
    "text": "بیاورد قرطاس و مشک و عبیر"
  },
  {
    "poem_id": 1678,
    "vorder": 103,
    "position": 0,
    "text": "مران نامه را زود پاسخ نوشت"
  },
  {
    "poem_id": 1678,
    "vorder": 104,
    "position": 1,
    "text": "بیاراست قرطاس را چون بهشت"
  },
  {
    "poem_id": 1678,
    "vorder": 105,
    "position": 0,
    "text": "نخست آفرین کرد بر دادگر"
  },
  {
    "poem_id": 1678,
    "vorder": 106,
    "position": 1,
    "text": "خداوند مردی و داد و هنر"
  },
  {
    "poem_id": 1678,
    "vorder": 107,
    "position": 0,
    "text": "خداوند فرهنگ و پرهیز و دین"
  },
  {
    "poem_id": 1678,
    "vorder": 108,
    "position": 1,
    "text": "ازو باد بر شاه روم آفرین"
  },
  {
    "poem_id": 1678,
    "vorder": 109,
    "position": 0,
    "text": "رسید این فرستادهٔ چرب‌گوی"
  },
  {
    "poem_id": 1678,
    "vorder": 110,
    "position": 1,
    "text": "هم آن نامهٔ شاه فرهنگ جوی"
  },
  {
    "poem_id": 1678,
    "vorder": 111,
    "position": 0,
    "text": "سخنهای شاهان همه خواندم"
  },
  {
    "poem_id": 1678,
    "vorder": 112,
    "position": 1,
    "text": "وزان با بزرگان سخن راندم"
  },
  {
    "poem_id": 1678,
    "vorder": 113,
    "position": 0,
    "text": "ز دارای داراب و فریان و فور"
  },
  {
    "poem_id": 1678,
    "vorder": 114,
    "position": 1,
    "text": "سخن هرچ پیدا بد از رزم و سور"
  },
  {
    "poem_id": 1678,
    "vorder": 115,
    "position": 0,
    "text": "که پیروز گشتی بریشان همه"
  },
  {
    "poem_id": 1678,
    "vorder": 116,
    "position": 1,
    "text": "شبان بودی و شهریاران رمه"
  },
  {
    "poem_id": 1678,
    "vorder": 117,
    "position": 0,
    "text": "تو داد خداوند خورشید و ماه"
  },
  {
    "poem_id": 1678,
    "vorder": 118,
    "position": 1,
    "text": "به مردی مدان و فزون سپاه"
  },
  {
    "poem_id": 1678,
    "vorder": 119,
    "position": 0,
    "text": "چو بر مهتری بگذرد روزگار"
  },
  {
    "poem_id": 1678,
    "vorder": 120,
    "position": 1,
    "text": "چه در سور میرد چه در کارزار"
  },
  {
    "poem_id": 1678,
    "vorder": 121,
    "position": 0,
    "text": "چو فرجامشان روز رزم تو بود"
  },
  {
    "poem_id": 1678,
    "vorder": 122,
    "position": 1,
    "text": "زمانه نه کاهد نخواهد فزود"
  },
  {
    "poem_id": 1678,
    "vorder": 123,
    "position": 0,
    "text": "تو زیشان مکن کشی و برتری"
  },
  {
    "poem_id": 1678,
    "vorder": 124,
    "position": 1,
    "text": "که گر ز آهنی بی‌گمان بگذری"
  },
  {
    "poem_id": 1678,
    "vorder": 125,
    "position": 0,
    "text": "کجا شد فریدون و ضحاک و جم"
  },
  {
    "poem_id": 1678,
    "vorder": 126,
    "position": 1,
    "text": "فراز آمد از باد و شد سوی دم"
  },
  {
    "poem_id": 1678,
    "vorder": 127,
    "position": 0,
    "text": "من از تو نترسم نه جنگ آورم"
  },
  {
    "poem_id": 1678,
    "vorder": 128,
    "position": 1,
    "text": "نه بر سان تو باد گیرد سرم"
  },
  {
    "poem_id": 1678,
    "vorder": 129,
    "position": 0,
    "text": "که خون ریختن نیست آیین ما"
  },
  {
    "poem_id": 1678,
    "vorder": 130,
    "position": 1,
    "text": "نه بد کردن اندرخور دین ما"
  },
  {
    "poem_id": 1678,
    "vorder": 131,
    "position": 0,
    "text": "بخوانی مرا بر تو باشد شکست"
  },
  {
    "poem_id": 1678,
    "vorder": 132,
    "position": 1,
    "text": "که یزدان‌پرستم نه خسروپرست"
  },
  {
    "poem_id": 1678,
    "vorder": 133,
    "position": 0,
    "text": "فزون زان فرستم که دارای منش"
  },
  {
    "poem_id": 1678,
    "vorder": 134,
    "position": 1,
    "text": "ز بخشش نباشد مرا سرزنش"
  },
  {
    "poem_id": 1678,
    "vorder": 135,
    "position": 0,
    "text": "سکندر به رخ رنگ تشویر خورد"
  },
  {
    "poem_id": 1678,
    "vorder": 136,
    "position": 1,
    "text": "ز گفتار او بر جگر تیر خورد"
  },
  {
    "poem_id": 1678,
    "vorder": 137,
    "position": 0,
    "text": "به دل گفت ازین پس کس اندر جهان"
  },
  {
    "poem_id": 1678,
    "vorder": 138,
    "position": 1,
    "text": "نبیند مرا رفته جایی نهان"
  },
  {
    "poem_id": 1678,
    "vorder": 139,
    "position": 0,
    "text": "ز ایوان بیامد به جای نشست"
  },
  {
    "poem_id": 1678,
    "vorder": 140,
    "position": 1,
    "text": "میان از پی بازگشتن ببست"
  },
  {
    "poem_id": 1678,
    "vorder": 141,
    "position": 0,
    "text": "سرافراز فغفور بگشاد گنج"
  },
  {
    "poem_id": 1678,
    "vorder": 142,
    "position": 1,
    "text": "ز بخشش نیامد به دلش ایچ رنج"
  },
  {
    "poem_id": 1678,
    "vorder": 143,
    "position": 0,
    "text": "نخستین بفرمود پنجاه تاج"
  },
  {
    "poem_id": 1678,
    "vorder": 144,
    "position": 1,
    "text": "به گوهر بیاگنده ده تخت عاج"
  },
  {
    "poem_id": 1678,
    "vorder": 145,
    "position": 0,
    "text": "ز سیمین و زرینه اشتر هزار"
  },
  {
    "poem_id": 1678,
    "vorder": 146,
    "position": 1,
    "text": "بفرمود تا برنهادند بار"
  },
  {
    "poem_id": 1678,
    "vorder": 147,
    "position": 0,
    "text": "ز دیبای چینی و خز و حریر"
  },
  {
    "poem_id": 1678,
    "vorder": 148,
    "position": 1,
    "text": "ز کافور وز مشک و بوی و عبیر"
  },
  {
    "poem_id": 1678,
    "vorder": 149,
    "position": 0,
    "text": "هزار اشتر بارکش بار کرد"
  },
  {
    "poem_id": 1678,
    "vorder": 150,
    "position": 1,
    "text": "تن‌آسان شد آنکو درم خوار کرد"
  },
  {
    "poem_id": 1678,
    "vorder": 151,
    "position": 0,
    "text": "ز سنجاب و قاقم ز موی سمور"
  },
  {
    "poem_id": 1678,
    "vorder": 152,
    "position": 1,
    "text": "ز گستردنیها و جام بلور"
  },
  {
    "poem_id": 1678,
    "vorder": 153,
    "position": 0,
    "text": "بیاورد زین هر یکی ده هزار"
  },
  {
    "poem_id": 1678,
    "vorder": 154,
    "position": 1,
    "text": "خردمند گنجور بربست بار"
  },
  {
    "poem_id": 1678,
    "vorder": 155,
    "position": 0,
    "text": "گرانمایه صد زین به سیمین ستام"
  },
  {
    "poem_id": 1678,
    "vorder": 156,
    "position": 1,
    "text": "ز زرینه پنجاه بردند نام"
  },
  {
    "poem_id": 1678,
    "vorder": 157,
    "position": 0,
    "text": "ببردند سیصد شتر سرخ‌موی"
  },
  {
    "poem_id": 1678,
    "vorder": 158,
    "position": 1,
    "text": "طرایف بدو دار چینی بدوی"
  },
  {
    "poem_id": 1678,
    "vorder": 159,
    "position": 0,
    "text": "یکی مرد با سنگ و شیرین سخن"
  },
  {
    "poem_id": 1678,
    "vorder": 160,
    "position": 1,
    "text": "گزین کرد زان چینیان کهن"
  },
  {
    "poem_id": 1678,
    "vorder": 161,
    "position": 0,
    "text": "بفرمود تا با درود و خرام"
  },
  {
    "poem_id": 1678,
    "vorder": 162,
    "position": 1,
    "text": "بیاید بر شاه و آرد پیام"
  },
  {
    "poem_id": 1678,
    "vorder": 163,
    "position": 0,
    "text": "که یک چند باشد به نزدیک چین"
  },
  {
    "poem_id": 1678,
    "vorder": 164,
    "position": 1,
    "text": "برو نامداران کنند آفرین"
  },
  {
    "poem_id": 1678,
    "vorder": 165,
    "position": 0,
    "text": "فرستاده شد با سکندر به راه"
  },
  {
    "poem_id": 1678,
    "vorder": 166,
    "position": 1,
    "text": "گمانی که بردی که اویست شاه"
  },
  {
    "poem_id": 1678,
    "vorder": 167,
    "position": 0,
    "text": "چو ملاح روی سکندر بدید"
  },
  {
    "poem_id": 1678,
    "vorder": 168,
    "position": 1,
    "text": "سبک زورقی بادبان برکشید"
  },
  {
    "poem_id": 1678,
    "vorder": 169,
    "position": 0,
    "text": "چو دستور با لشکر آمدش پیش"
  },
  {
    "poem_id": 1678,
    "vorder": 170,
    "position": 1,
    "text": "بگفت آنچ آمد ز بازار خویش"
  },
  {
    "poem_id": 1678,
    "vorder": 171,
    "position": 0,
    "text": "سپاهش برو خواندند آفرین"
  },
  {
    "poem_id": 1678,
    "vorder": 172,
    "position": 1,
    "text": "همه برنهادند سر بر زمین"
  },
  {
    "poem_id": 1678,
    "vorder": 173,
    "position": 0,
    "text": "بدانست چینی که او هست شاه"
  },
  {
    "poem_id": 1678,
    "vorder": 174,
    "position": 1,
    "text": "پیاده بیامد غریوان به راه"
  },
  {
    "poem_id": 1678,
    "vorder": 175,
    "position": 0,
    "text": "سکندر بدو گفت پوزش مکن"
  },
  {
    "poem_id": 1678,
    "vorder": 176,
    "position": 1,
    "text": "مران پیش فغفور زین در سخن"
  },
  {
    "poem_id": 1678,
    "vorder": 177,
    "position": 0,
    "text": "ببود آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1678,
    "vorder": 178,
    "position": 1,
    "text": "به آرام بنشست بر تخت شاه"
  },
  {
    "poem_id": 1678,
    "vorder": 179,
    "position": 0,
    "text": "فرستاده را چیز بخشید و گفت"
  },
  {
    "poem_id": 1678,
    "vorder": 180,
    "position": 1,
    "text": "که با تو روان مسیحست جفت"
  },
  {
    "poem_id": 1678,
    "vorder": 181,
    "position": 0,
    "text": "برو پیش فغفور چینی بگوی"
  },
  {
    "poem_id": 1678,
    "vorder": 182,
    "position": 1,
    "text": "که نزدیک ما یافتی آب‌روی"
  },
  {
    "poem_id": 1678,
    "vorder": 183,
    "position": 0,
    "text": "گر ایدر بباشی همی چین تراست"
  },
  {
    "poem_id": 1678,
    "vorder": 184,
    "position": 1,
    "text": "وگر جای دیگر خرامی رواست"
  },
  {
    "poem_id": 1678,
    "vorder": 185,
    "position": 0,
    "text": "بیاسایم ایدر که چندین سپاه"
  },
  {
    "poem_id": 1678,
    "vorder": 186,
    "position": 1,
    "text": "به تندی نشاید کشیدن به راه"
  },
  {
    "poem_id": 1678,
    "vorder": 187,
    "position": 0,
    "text": "فرستاده برگشت و آمد چو باد"
  },
  {
    "poem_id": 1678,
    "vorder": 188,
    "position": 1,
    "text": "به فغفور پیغام قیصر بداد"
  }
]