[
  {
    "poem_id": 1590,
    "vorder": 1,
    "position": 0,
    "text": "بدو گفت رستم که آرام گیر"
  },
  {
    "poem_id": 1590,
    "vorder": 2,
    "position": 1,
    "text": "چه گویی سخنهای نادلپذیر"
  },
  {
    "poem_id": 1590,
    "vorder": 3,
    "position": 0,
    "text": "دلت بیش کژی بپالد همی"
  },
  {
    "poem_id": 1590,
    "vorder": 4,
    "position": 1,
    "text": "روانت ز دیوان ببالد همی"
  },
  {
    "poem_id": 1590,
    "vorder": 5,
    "position": 0,
    "text": "تو آن گوی کز پادشاهان سزاست"
  },
  {
    "poem_id": 1590,
    "vorder": 6,
    "position": 1,
    "text": "نگوید سخن پادشا جز که راست"
  },
  {
    "poem_id": 1590,
    "vorder": 7,
    "position": 0,
    "text": "جهاندار داند که دستان سام"
  },
  {
    "poem_id": 1590,
    "vorder": 8,
    "position": 1,
    "text": "بزرگست و بادانش و نیک‌نام"
  },
  {
    "poem_id": 1590,
    "vorder": 9,
    "position": 0,
    "text": "همان سام پور نریمان بدست"
  },
  {
    "poem_id": 1590,
    "vorder": 10,
    "position": 1,
    "text": "نریمان گرد از کریمان بدست"
  },
  {
    "poem_id": 1590,
    "vorder": 11,
    "position": 0,
    "text": "بزرگست و گرشاسپ بودش پدر"
  },
  {
    "poem_id": 1590,
    "vorder": 12,
    "position": 1,
    "text": "به گیتی بدی خسرو تاجور"
  },
  {
    "poem_id": 1590,
    "vorder": 13,
    "position": 0,
    "text": "همانا شنیدستی آواز سام"
  },
  {
    "poem_id": 1590,
    "vorder": 14,
    "position": 1,
    "text": "نبد در زمانه چنو نیک‌نام"
  },
  {
    "poem_id": 1590,
    "vorder": 15,
    "position": 0,
    "text": "بکشتش به طوس اندرون اژدها"
  },
  {
    "poem_id": 1590,
    "vorder": 16,
    "position": 1,
    "text": "که از چنگ او کس نیابد رها"
  },
  {
    "poem_id": 1590,
    "vorder": 17,
    "position": 0,
    "text": "به دریا نهنگ و به خشکی پلنگ"
  },
  {
    "poem_id": 1590,
    "vorder": 18,
    "position": 1,
    "text": "ورا کس ندیدی گریزان ز جنگ"
  },
  {
    "poem_id": 1590,
    "vorder": 19,
    "position": 0,
    "text": "به دریا سر ماهیان برفروخت"
  },
  {
    "poem_id": 1590,
    "vorder": 20,
    "position": 1,
    "text": "هم‌اندر هوا پر کرگس بسوخت"
  },
  {
    "poem_id": 1590,
    "vorder": 21,
    "position": 0,
    "text": "همی پیل را درکشیدی به دم"
  },
  {
    "poem_id": 1590,
    "vorder": 22,
    "position": 1,
    "text": "دل خرم از یاد او شدم دژم"
  },
  {
    "poem_id": 1590,
    "vorder": 23,
    "position": 0,
    "text": "و دیگر یکی دیو بُد بدگمان"
  },
  {
    "poem_id": 1590,
    "vorder": 24,
    "position": 1,
    "text": "تنش بر زمین و سرش بآسمان"
  },
  {
    "poem_id": 1590,
    "vorder": 25,
    "position": 0,
    "text": "که دریای چین تا میانش بدی"
  },
  {
    "poem_id": 1590,
    "vorder": 26,
    "position": 1,
    "text": "ز تابیدن خور زیانش بدی"
  },
  {
    "poem_id": 1590,
    "vorder": 27,
    "position": 0,
    "text": "همی ماهی از آب برداشتی"
  },
  {
    "poem_id": 1590,
    "vorder": 28,
    "position": 1,
    "text": "سر از گنبد ماه بگذاشتی"
  },
  {
    "poem_id": 1590,
    "vorder": 29,
    "position": 0,
    "text": "به خورشید ماهیش بریان شدی"
  },
  {
    "poem_id": 1590,
    "vorder": 30,
    "position": 1,
    "text": "ازو چرخ گردنده گریان شدی"
  },
  {
    "poem_id": 1590,
    "vorder": 31,
    "position": 0,
    "text": "دو پتیاره زین گونه پیچان شدند"
  },
  {
    "poem_id": 1590,
    "vorder": 32,
    "position": 1,
    "text": "ز تیغ یلی هر دو بیجان شدند"
  },
  {
    "poem_id": 1590,
    "vorder": 33,
    "position": 0,
    "text": "همان مادرم دخت مهراب بود"
  },
  {
    "poem_id": 1590,
    "vorder": 34,
    "position": 1,
    "text": "بدو کشور هند شاداب بود"
  },
  {
    "poem_id": 1590,
    "vorder": 35,
    "position": 0,
    "text": "که ضحاک بودیش پنجم پدر"
  },
  {
    "poem_id": 1590,
    "vorder": 36,
    "position": 1,
    "text": "ز شاهان گیتی برآورده سر"
  },
  {
    "poem_id": 1590,
    "vorder": 37,
    "position": 0,
    "text": "نژادی ازین نامورتر کراست"
  },
  {
    "poem_id": 1590,
    "vorder": 38,
    "position": 1,
    "text": "خردمند گردن نپیچد ز راست"
  },
  {
    "poem_id": 1590,
    "vorder": 39,
    "position": 0,
    "text": "دگر آنک اندر جهان سربسر"
  },
  {
    "poem_id": 1590,
    "vorder": 40,
    "position": 1,
    "text": "یلان را ز من جست باید هنر"
  },
  {
    "poem_id": 1590,
    "vorder": 41,
    "position": 0,
    "text": "همان عهد کاوس دارم نخست"
  },
  {
    "poem_id": 1590,
    "vorder": 42,
    "position": 1,
    "text": "که بر من بهانه نیارند جست"
  },
  {
    "poem_id": 1590,
    "vorder": 43,
    "position": 0,
    "text": "همان عهد کیخسرو دادگر"
  },
  {
    "poem_id": 1590,
    "vorder": 44,
    "position": 1,
    "text": "که چون او نبست از کیان کس کمر"
  },
  {
    "poem_id": 1590,
    "vorder": 45,
    "position": 0,
    "text": "زمین را سراسر همه گشته‌ام"
  },
  {
    "poem_id": 1590,
    "vorder": 46,
    "position": 1,
    "text": "بسی شاه بیدادگر کشته‌ام"
  },
  {
    "poem_id": 1590,
    "vorder": 47,
    "position": 0,
    "text": "چو من برگذشتم ز جیحون بر آب"
  },
  {
    "poem_id": 1590,
    "vorder": 48,
    "position": 1,
    "text": "ز توران به چین آمد افراسیاب"
  },
  {
    "poem_id": 1590,
    "vorder": 49,
    "position": 0,
    "text": "ز کاوس در جنگ هاماوران"
  },
  {
    "poem_id": 1590,
    "vorder": 50,
    "position": 1,
    "text": "به تنها برفتم به مازندران"
  },
  {
    "poem_id": 1590,
    "vorder": 51,
    "position": 0,
    "text": "نه ارژنگ ماندم نه دیو سپید"
  },
  {
    "poem_id": 1590,
    "vorder": 52,
    "position": 1,
    "text": "نه سنجه نه اولاد غندی نه بید"
  },
  {
    "poem_id": 1590,
    "vorder": 53,
    "position": 0,
    "text": "همی از پی شاه فرزند را"
  },
  {
    "poem_id": 1590,
    "vorder": 54,
    "position": 1,
    "text": "بکشتم دلیر خردمند را"
  },
  {
    "poem_id": 1590,
    "vorder": 55,
    "position": 0,
    "text": "که گردی چو سهراب هرگز نبود"
  },
  {
    "poem_id": 1590,
    "vorder": 56,
    "position": 1,
    "text": "به زور و به مردی و رزم آزمود"
  },
  {
    "poem_id": 1590,
    "vorder": 57,
    "position": 0,
    "text": "ز پانصد همانا فزونست سال"
  },
  {
    "poem_id": 1590,
    "vorder": 58,
    "position": 1,
    "text": "که تا من جدا گشتم از پشت زال"
  },
  {
    "poem_id": 1590,
    "vorder": 59,
    "position": 0,
    "text": "همی پهلوان بودم اندر جهان"
  },
  {
    "poem_id": 1590,
    "vorder": 60,
    "position": 1,
    "text": "یکی بود با آشکارم نهان"
  },
  {
    "poem_id": 1590,
    "vorder": 61,
    "position": 0,
    "text": "به سان فریدون فرخ‌نژاد"
  },
  {
    "poem_id": 1590,
    "vorder": 62,
    "position": 1,
    "text": "که تاج بزرگی به سر بر نهاد"
  },
  {
    "poem_id": 1590,
    "vorder": 63,
    "position": 0,
    "text": "ز تخت اندرآورد ضحاک را"
  },
  {
    "poem_id": 1590,
    "vorder": 64,
    "position": 1,
    "text": "سپرد آن سر و تاج او خاک را"
  },
  {
    "poem_id": 1590,
    "vorder": 65,
    "position": 0,
    "text": "دگر سام کو بود ما را نیا"
  },
  {
    "poem_id": 1590,
    "vorder": 66,
    "position": 1,
    "text": "ببرد از جهان دانش و کیمیا"
  },
  {
    "poem_id": 1590,
    "vorder": 67,
    "position": 0,
    "text": "سه دیگر که چون من ببستم کمر"
  },
  {
    "poem_id": 1590,
    "vorder": 68,
    "position": 1,
    "text": "تن آسان شد اندر جهان تاجور"
  },
  {
    "poem_id": 1590,
    "vorder": 69,
    "position": 0,
    "text": "بران خرمی روز هرگز نبود"
  },
  {
    "poem_id": 1590,
    "vorder": 70,
    "position": 1,
    "text": "پی مرد بی‌راه بر دز نبود"
  },
  {
    "poem_id": 1590,
    "vorder": 71,
    "position": 0,
    "text": "که من بودم اندر جهان کامران"
  },
  {
    "poem_id": 1590,
    "vorder": 72,
    "position": 1,
    "text": "مرا بود شمشیر و گرز گران"
  },
  {
    "poem_id": 1590,
    "vorder": 73,
    "position": 0,
    "text": "بدان گفتم این تا بدانی همه"
  },
  {
    "poem_id": 1590,
    "vorder": 74,
    "position": 1,
    "text": "تو شاهی و گردنکشان چون رمه"
  },
  {
    "poem_id": 1590,
    "vorder": 75,
    "position": 0,
    "text": "تو اندر زمانه رسیده نوی"
  },
  {
    "poem_id": 1590,
    "vorder": 76,
    "position": 1,
    "text": "اگر چند با فر کیخسروی"
  },
  {
    "poem_id": 1590,
    "vorder": 77,
    "position": 0,
    "text": "تن خویش بینی همی در جهان"
  },
  {
    "poem_id": 1590,
    "vorder": 78,
    "position": 1,
    "text": "نه‌ای آگه از کارهای نهان"
  },
  {
    "poem_id": 1590,
    "vorder": 79,
    "position": 0,
    "text": "چو بسیار شد گفتها می‌خوریم"
  },
  {
    "poem_id": 1590,
    "vorder": 80,
    "position": 1,
    "text": "به می جان اندیشه را بشکریم"
  }
]