[
  {
    "poem_id": 1744,
    "vorder": 1,
    "position": 0,
    "text": "عرض‌گاه و دیوان بیاراستند"
  },
  {
    "poem_id": 1744,
    "vorder": 2,
    "position": 1,
    "text": "کلید در گنجها خواستند"
  },
  {
    "poem_id": 1744,
    "vorder": 3,
    "position": 0,
    "text": "سپاه انجمن شد چو روزی بداد"
  },
  {
    "poem_id": 1744,
    "vorder": 4,
    "position": 1,
    "text": "سرش پر ز کین و دلش پر ز باد"
  },
  {
    "poem_id": 1744,
    "vorder": 5,
    "position": 0,
    "text": "از ایران همی راند تا مرز روم"
  },
  {
    "poem_id": 1744,
    "vorder": 6,
    "position": 1,
    "text": "هرانکس که بود اندران مرز و بوم"
  },
  {
    "poem_id": 1744,
    "vorder": 7,
    "position": 0,
    "text": "بکشتند و خانش همی سوختند"
  },
  {
    "poem_id": 1744,
    "vorder": 8,
    "position": 1,
    "text": "جهانی به آتش برافروختند"
  },
  {
    "poem_id": 1744,
    "vorder": 9,
    "position": 0,
    "text": "چو آگاهی آمد ز ایران به روم"
  },
  {
    "poem_id": 1744,
    "vorder": 10,
    "position": 1,
    "text": "که ویران شد آن مرز آباد بوم"
  },
  {
    "poem_id": 1744,
    "vorder": 11,
    "position": 0,
    "text": "گرفتار شد قیصر نامدار"
  },
  {
    "poem_id": 1744,
    "vorder": 12,
    "position": 1,
    "text": "شب تیره اندر صف کارزار"
  },
  {
    "poem_id": 1744,
    "vorder": 13,
    "position": 0,
    "text": "سراسر همه روم گریان شدند"
  },
  {
    "poem_id": 1744,
    "vorder": 14,
    "position": 1,
    "text": "وز آواز شاپور بریان شدند"
  },
  {
    "poem_id": 1744,
    "vorder": 15,
    "position": 0,
    "text": "همی گفت هرکس که این بد که کرد"
  },
  {
    "poem_id": 1744,
    "vorder": 16,
    "position": 1,
    "text": "مگر قیصر آن ناجوانمرد مرد"
  },
  {
    "poem_id": 1744,
    "vorder": 17,
    "position": 0,
    "text": "ز قیصر یکی که برادرش بود"
  },
  {
    "poem_id": 1744,
    "vorder": 18,
    "position": 1,
    "text": "پدر مرده و زنده مادرش بود"
  },
  {
    "poem_id": 1744,
    "vorder": 19,
    "position": 0,
    "text": "جوانی کجا یانسش بود نام"
  },
  {
    "poem_id": 1744,
    "vorder": 20,
    "position": 1,
    "text": "جهانجوی و بخشنده و شادکام"
  },
  {
    "poem_id": 1744,
    "vorder": 21,
    "position": 0,
    "text": "شدند انجمن لشکری بر درش"
  },
  {
    "poem_id": 1744,
    "vorder": 22,
    "position": 1,
    "text": "درم داد پرخاشجو مادرش"
  },
  {
    "poem_id": 1744,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت کین برادر بخواه"
  },
  {
    "poem_id": 1744,
    "vorder": 24,
    "position": 1,
    "text": "نبینی که آمد ز ایران سپاه"
  },
  {
    "poem_id": 1744,
    "vorder": 25,
    "position": 0,
    "text": "چو بشنید یانس بجوشید و گفت"
  },
  {
    "poem_id": 1744,
    "vorder": 26,
    "position": 1,
    "text": "که کین برادر نشاید نهفت"
  },
  {
    "poem_id": 1744,
    "vorder": 27,
    "position": 0,
    "text": "بزد کوس و آورد بیرون صلیب"
  },
  {
    "poem_id": 1744,
    "vorder": 28,
    "position": 1,
    "text": "صلیب بزرگ و سپاهی مهیب"
  },
  {
    "poem_id": 1744,
    "vorder": 29,
    "position": 0,
    "text": "سپه را چو روی اندرآمد به روی"
  },
  {
    "poem_id": 1744,
    "vorder": 30,
    "position": 1,
    "text": "بی‌آرام شد مردم کینه‌جوی"
  },
  {
    "poem_id": 1744,
    "vorder": 31,
    "position": 0,
    "text": "رده برکشیدند و برخاست غو"
  },
  {
    "poem_id": 1744,
    "vorder": 32,
    "position": 1,
    "text": "بیامد دوان یانس پیش رو"
  },
  {
    "poem_id": 1744,
    "vorder": 33,
    "position": 0,
    "text": "برآمد یکی ابر و گردی سیاه"
  },
  {
    "poem_id": 1744,
    "vorder": 34,
    "position": 1,
    "text": "کزان تیرگی دیده گم کرد راه"
  },
  {
    "poem_id": 1744,
    "vorder": 35,
    "position": 0,
    "text": "سپه را به یک روی بر کوه بود"
  },
  {
    "poem_id": 1744,
    "vorder": 36,
    "position": 1,
    "text": "دگر آب زانسو که انبوه بود"
  },
  {
    "poem_id": 1744,
    "vorder": 37,
    "position": 0,
    "text": "بدین گونه تا گشت خورشید زرد"
  },
  {
    "poem_id": 1744,
    "vorder": 38,
    "position": 1,
    "text": "ز هر سو همی خاست گرد نبرد"
  },
  {
    "poem_id": 1744,
    "vorder": 39,
    "position": 0,
    "text": "بکشتند چندانک روی زمین"
  },
  {
    "poem_id": 1744,
    "vorder": 40,
    "position": 1,
    "text": "شد از جوشن کشتگان آهنین"
  },
  {
    "poem_id": 1744,
    "vorder": 41,
    "position": 0,
    "text": "چو از قلب شاپور لشکر براند"
  },
  {
    "poem_id": 1744,
    "vorder": 42,
    "position": 1,
    "text": "چپ و راستش ویژگان را بخواند"
  },
  {
    "poem_id": 1744,
    "vorder": 43,
    "position": 0,
    "text": "چو با مهتران گرم کرد اسپ شاه"
  },
  {
    "poem_id": 1744,
    "vorder": 44,
    "position": 1,
    "text": "زمین گشت جنبان و پیچان سپاه"
  },
  {
    "poem_id": 1744,
    "vorder": 45,
    "position": 0,
    "text": "سوی لشکر رومیان حمله برد"
  },
  {
    "poem_id": 1744,
    "vorder": 46,
    "position": 1,
    "text": "بزرگش یکی بود با مرد خرد"
  },
  {
    "poem_id": 1744,
    "vorder": 47,
    "position": 0,
    "text": "بدانست یانس که پایاب شاه"
  },
  {
    "poem_id": 1744,
    "vorder": 48,
    "position": 1,
    "text": "ندارد گریزان بشد با سپاه"
  },
  {
    "poem_id": 1744,
    "vorder": 49,
    "position": 0,
    "text": "پس‌اندر همی تاخت شاپور گرد"
  },
  {
    "poem_id": 1744,
    "vorder": 50,
    "position": 1,
    "text": "به گرد از هوا روشنایی ببرد"
  },
  {
    "poem_id": 1744,
    "vorder": 51,
    "position": 0,
    "text": "به هر جایگه بر یکی توده کرد"
  },
  {
    "poem_id": 1744,
    "vorder": 52,
    "position": 1,
    "text": "گیاها به مغز سر آلوده کرد"
  },
  {
    "poem_id": 1744,
    "vorder": 53,
    "position": 0,
    "text": "ازان لشکر روم چندان بکشت"
  },
  {
    "poem_id": 1744,
    "vorder": 54,
    "position": 1,
    "text": "که یک دشت سر بود بی‌پای و پشت"
  },
  {
    "poem_id": 1744,
    "vorder": 55,
    "position": 0,
    "text": "به هامون سپاه و چلیپا نماند"
  },
  {
    "poem_id": 1744,
    "vorder": 56,
    "position": 1,
    "text": "به دژها صلیب و سکوبا نماند"
  },
  {
    "poem_id": 1744,
    "vorder": 57,
    "position": 0,
    "text": "ز هر جای چندان غنیمت گرفت"
  },
  {
    "poem_id": 1744,
    "vorder": 58,
    "position": 1,
    "text": "که لشکر همی ماند زو در شگفت"
  },
  {
    "poem_id": 1744,
    "vorder": 59,
    "position": 0,
    "text": "ببخشید یکسر همه بر سپاه"
  },
  {
    "poem_id": 1744,
    "vorder": 60,
    "position": 1,
    "text": "جز از گنج قیصر نبد بهر شاه"
  },
  {
    "poem_id": 1744,
    "vorder": 61,
    "position": 0,
    "text": "کجا دیده‌بد رنج از گنج اوی"
  },
  {
    "poem_id": 1744,
    "vorder": 62,
    "position": 1,
    "text": "نه هم گوشه بد گنج با رنج اوی"
  },
  {
    "poem_id": 1744,
    "vorder": 63,
    "position": 0,
    "text": "همه لشکر روم گرد آمدند"
  },
  {
    "poem_id": 1744,
    "vorder": 64,
    "position": 1,
    "text": "ز قیصر همی داستانها زدند"
  },
  {
    "poem_id": 1744,
    "vorder": 65,
    "position": 0,
    "text": "که ما را چنو نیز مهتر مباد"
  },
  {
    "poem_id": 1744,
    "vorder": 66,
    "position": 1,
    "text": "به روم اندرون نام قیصر مباد"
  },
  {
    "poem_id": 1744,
    "vorder": 67,
    "position": 0,
    "text": "به روم اندرون جای مذبح نماند"
  },
  {
    "poem_id": 1744,
    "vorder": 68,
    "position": 1,
    "text": "صلیب و مسیح و موشح نماند"
  },
  {
    "poem_id": 1744,
    "vorder": 69,
    "position": 0,
    "text": "چو زنار قسیس شد سوخته"
  },
  {
    "poem_id": 1744,
    "vorder": 70,
    "position": 1,
    "text": "چلیپا و مطران برافروخته"
  },
  {
    "poem_id": 1744,
    "vorder": 71,
    "position": 0,
    "text": "کنون روم و قنوج ما را یکیست"
  },
  {
    "poem_id": 1744,
    "vorder": 72,
    "position": 1,
    "text": "چو آواز دین مسیح اندکیست"
  }
]