[
  {
    "poem_id": 1765,
    "vorder": 1,
    "position": 0,
    "text": "خود و شاه بهرام با رای‌زن"
  },
  {
    "poem_id": 1765,
    "vorder": 2,
    "position": 1,
    "text": "نشستند و گفتند بی‌انجمن"
  },
  {
    "poem_id": 1765,
    "vorder": 3,
    "position": 0,
    "text": "سخنشان بران راست شد کز یمن"
  },
  {
    "poem_id": 1765,
    "vorder": 4,
    "position": 1,
    "text": "به ایران خرامند با انجمن"
  },
  {
    "poem_id": 1765,
    "vorder": 5,
    "position": 0,
    "text": "گزین کرد از تازیان سی هزار"
  },
  {
    "poem_id": 1765,
    "vorder": 6,
    "position": 1,
    "text": "همه نیزه‌داران خنجرگزار"
  },
  {
    "poem_id": 1765,
    "vorder": 7,
    "position": 0,
    "text": "به دینارشان یکسر آباد کرد"
  },
  {
    "poem_id": 1765,
    "vorder": 8,
    "position": 1,
    "text": "سر نامداران پر از باد کرد"
  },
  {
    "poem_id": 1765,
    "vorder": 9,
    "position": 0,
    "text": "چو آگاهی این به ایران رسید"
  },
  {
    "poem_id": 1765,
    "vorder": 10,
    "position": 1,
    "text": "جوانوی نزد دلیران رسید"
  },
  {
    "poem_id": 1765,
    "vorder": 11,
    "position": 0,
    "text": "بزرگان ازان کار غمگین شدند"
  },
  {
    "poem_id": 1765,
    "vorder": 12,
    "position": 1,
    "text": "بر آذر پاک برزین شدند"
  },
  {
    "poem_id": 1765,
    "vorder": 13,
    "position": 0,
    "text": "ز یزدان همی خواستند آنک رزم"
  },
  {
    "poem_id": 1765,
    "vorder": 14,
    "position": 1,
    "text": "مگر باز گردد به شادی و بزم"
  },
  {
    "poem_id": 1765,
    "vorder": 15,
    "position": 0,
    "text": "چو منذر به نزدیک جهرم رسید"
  },
  {
    "poem_id": 1765,
    "vorder": 16,
    "position": 1,
    "text": "برآن دشت بی‌آب لشکر کشید"
  },
  {
    "poem_id": 1765,
    "vorder": 17,
    "position": 0,
    "text": "سراپرده زد راد بهرامشاه"
  },
  {
    "poem_id": 1765,
    "vorder": 18,
    "position": 1,
    "text": "به گرد اندر آمد ز هر سو سپاه"
  },
  {
    "poem_id": 1765,
    "vorder": 19,
    "position": 0,
    "text": "به منذر چنین گفت کای رای‌زن"
  },
  {
    "poem_id": 1765,
    "vorder": 20,
    "position": 1,
    "text": "به جهرم رسیدی ز شهر یمن"
  },
  {
    "poem_id": 1765,
    "vorder": 21,
    "position": 0,
    "text": "کنون جنگ سازیم گر گفت‌وگوی"
  },
  {
    "poem_id": 1765,
    "vorder": 22,
    "position": 1,
    "text": "چو لشکر به روی اندر آورد روی"
  },
  {
    "poem_id": 1765,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت منذر مهان را بخوان"
  },
  {
    "poem_id": 1765,
    "vorder": 24,
    "position": 1,
    "text": "چو آیند پیشت بیارای خوان"
  },
  {
    "poem_id": 1765,
    "vorder": 25,
    "position": 0,
    "text": "سخن گوی و بشنو ازیشان سخن"
  },
  {
    "poem_id": 1765,
    "vorder": 26,
    "position": 1,
    "text": "کسی تیز گردد تو تیزی مکن"
  },
  {
    "poem_id": 1765,
    "vorder": 27,
    "position": 0,
    "text": "بخوانیم تا چیستشان در نهان"
  },
  {
    "poem_id": 1765,
    "vorder": 28,
    "position": 1,
    "text": "کرا خواند خواهند شاه جهان"
  },
  {
    "poem_id": 1765,
    "vorder": 29,
    "position": 0,
    "text": "چو دانسته شد چارهٔ آن کنیم"
  },
  {
    "poem_id": 1765,
    "vorder": 30,
    "position": 1,
    "text": "گر آسان بود کینه پنهان کنیم"
  },
  {
    "poem_id": 1765,
    "vorder": 31,
    "position": 0,
    "text": "ور ایدون کجا کین و جنگ آورند"
  },
  {
    "poem_id": 1765,
    "vorder": 32,
    "position": 1,
    "text": "بپیچند و خوی پلنگ آورند"
  },
  {
    "poem_id": 1765,
    "vorder": 33,
    "position": 0,
    "text": "من این دشت جهرم چو دریا کنم"
  },
  {
    "poem_id": 1765,
    "vorder": 34,
    "position": 1,
    "text": "ز خورشید تابان ثریا کنم"
  },
  {
    "poem_id": 1765,
    "vorder": 35,
    "position": 0,
    "text": "بر آنم که بینند چهر ترا"
  },
  {
    "poem_id": 1765,
    "vorder": 36,
    "position": 1,
    "text": "چنین برز و بالا و مهر ترا"
  },
  {
    "poem_id": 1765,
    "vorder": 37,
    "position": 0,
    "text": "خردمندی و رای و فرهنگ تو"
  },
  {
    "poem_id": 1765,
    "vorder": 38,
    "position": 1,
    "text": "شکیبایی و دانش و سنگ تو"
  },
  {
    "poem_id": 1765,
    "vorder": 39,
    "position": 0,
    "text": "نخواهند جز تو کسی تخت را"
  },
  {
    "poem_id": 1765,
    "vorder": 40,
    "position": 1,
    "text": "کله را و زیبایی بخت را"
  },
  {
    "poem_id": 1765,
    "vorder": 41,
    "position": 0,
    "text": "ور ایدونک گم کرده دارند راه"
  },
  {
    "poem_id": 1765,
    "vorder": 42,
    "position": 1,
    "text": "بخواهند بردن همی از تو گاه"
  },
  {
    "poem_id": 1765,
    "vorder": 43,
    "position": 0,
    "text": "من و این سواران و شمشیر تیز"
  },
  {
    "poem_id": 1765,
    "vorder": 44,
    "position": 1,
    "text": "برانگیزم اندر جهان رستخیز"
  },
  {
    "poem_id": 1765,
    "vorder": 45,
    "position": 0,
    "text": "ببینی بروهای پرچین من"
  },
  {
    "poem_id": 1765,
    "vorder": 46,
    "position": 1,
    "text": "فدای تو بادا تن و دین من"
  },
  {
    "poem_id": 1765,
    "vorder": 47,
    "position": 0,
    "text": "چو بینند بی‌مر سپاه مرا"
  },
  {
    "poem_id": 1765,
    "vorder": 48,
    "position": 1,
    "text": "همان رسم و آیین و راه مرا"
  },
  {
    "poem_id": 1765,
    "vorder": 49,
    "position": 0,
    "text": "همین پادشاهی که میراث تست"
  },
  {
    "poem_id": 1765,
    "vorder": 50,
    "position": 1,
    "text": "پدر بر پدر کرد شاید درست"
  },
  {
    "poem_id": 1765,
    "vorder": 51,
    "position": 0,
    "text": "سه دیگر که خون ریختن کار ماست"
  },
  {
    "poem_id": 1765,
    "vorder": 52,
    "position": 1,
    "text": "همان ایزد دادگر یار ماست"
  },
  {
    "poem_id": 1765,
    "vorder": 53,
    "position": 0,
    "text": "کسی را جز از تو نخواهند شاه"
  },
  {
    "poem_id": 1765,
    "vorder": 54,
    "position": 1,
    "text": "که زیبای تاجی و زیبای گاه"
  },
  {
    "poem_id": 1765,
    "vorder": 55,
    "position": 0,
    "text": "ز منذر چو شاه این سخنها شنید"
  },
  {
    "poem_id": 1765,
    "vorder": 56,
    "position": 1,
    "text": "بخندید و شادان دلش بردمید"
  },
  {
    "poem_id": 1765,
    "vorder": 57,
    "position": 0,
    "text": "چو خورشید برزد سر از تیغ کوه"
  },
  {
    "poem_id": 1765,
    "vorder": 58,
    "position": 1,
    "text": "ردان و بزرگان ایران گروه"
  },
  {
    "poem_id": 1765,
    "vorder": 59,
    "position": 0,
    "text": "پذیره شدن را بیاراستند"
  },
  {
    "poem_id": 1765,
    "vorder": 60,
    "position": 1,
    "text": "یکی دانشی انجمن خواستند"
  },
  {
    "poem_id": 1765,
    "vorder": 61,
    "position": 0,
    "text": "نهادند بهرام را تخت عاج"
  },
  {
    "poem_id": 1765,
    "vorder": 62,
    "position": 1,
    "text": "به سر بر نهاده بهاگیر تاج"
  },
  {
    "poem_id": 1765,
    "vorder": 63,
    "position": 0,
    "text": "نشستی به آیین شاهنشهان"
  },
  {
    "poem_id": 1765,
    "vorder": 64,
    "position": 1,
    "text": "بیاراست کو بود شاه جهان"
  },
  {
    "poem_id": 1765,
    "vorder": 65,
    "position": 0,
    "text": "ز یک دست بهرام منذر نشست"
  },
  {
    "poem_id": 1765,
    "vorder": 66,
    "position": 1,
    "text": "دگر دست نعمان و تیغی به دست"
  },
  {
    "poem_id": 1765,
    "vorder": 67,
    "position": 0,
    "text": "همان گرد بر گرد پرده‌سرای"
  },
  {
    "poem_id": 1765,
    "vorder": 68,
    "position": 1,
    "text": "ستاده بزرگان تازی به پای"
  },
  {
    "poem_id": 1765,
    "vorder": 69,
    "position": 0,
    "text": "از ایرانیان آنک بد پاک‌رای"
  },
  {
    "poem_id": 1765,
    "vorder": 70,
    "position": 1,
    "text": "بیامد به دهلیز پرده‌سرای"
  },
  {
    "poem_id": 1765,
    "vorder": 71,
    "position": 0,
    "text": "بفرمود تا پرده برداشتند"
  },
  {
    "poem_id": 1765,
    "vorder": 72,
    "position": 1,
    "text": "ز درشان به آواز بگذاشتند"
  },
  {
    "poem_id": 1765,
    "vorder": 73,
    "position": 0,
    "text": "به شاه جهان آفرین خواندند"
  },
  {
    "poem_id": 1765,
    "vorder": 74,
    "position": 1,
    "text": "به مژگان همی خون برافشاندند"
  },
  {
    "poem_id": 1765,
    "vorder": 75,
    "position": 0,
    "text": "رسیدند نزدیک بهرامشاه"
  },
  {
    "poem_id": 1765,
    "vorder": 76,
    "position": 1,
    "text": "بدیدند زیبا یکی تاج و گاه"
  },
  {
    "poem_id": 1765,
    "vorder": 77,
    "position": 0,
    "text": "به آواز گفتند انوشه بدی"
  },
  {
    "poem_id": 1765,
    "vorder": 78,
    "position": 1,
    "text": "همیشه ز تو دور دست بدی"
  },
  {
    "poem_id": 1765,
    "vorder": 79,
    "position": 0,
    "text": "شهنشاه پرسید و بنواختشان"
  },
  {
    "poem_id": 1765,
    "vorder": 80,
    "position": 1,
    "text": "به اندازه بر پایگه ساختشان"
  }
]