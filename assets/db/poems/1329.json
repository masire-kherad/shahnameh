[
  {
    "poem_id": 1329,
    "vorder": 1,
    "position": 0,
    "text": "چو از دفتر این داستان‌ها بَسی"
  },
  {
    "poem_id": 1329,
    "vorder": 2,
    "position": 1,
    "text": "هَمی خوانَد خوانَنده بَر هَر کَسی"
  },
  {
    "poem_id": 1329,
    "vorder": 3,
    "position": 0,
    "text": "جهان دل نهاده بدین داستان"
  },
  {
    "poem_id": 1329,
    "vorder": 4,
    "position": 1,
    "text": "همان بِخْرَدان نیز و هَم راستان"
  },
  {
    "poem_id": 1329,
    "vorder": 5,
    "position": 0,
    "text": "جوانی بیامد گُشاده زبان"
  },
  {
    "poem_id": 1329,
    "vorder": 6,
    "position": 1,
    "text": "سُخن گفتنِ خوب و طَبعِ رَوان"
  },
  {
    "poem_id": 1329,
    "vorder": 7,
    "position": 0,
    "text": "به شعر آرَم این نامه را گفت مَن"
  },
  {
    "poem_id": 1329,
    "vorder": 8,
    "position": 1,
    "text": "از او شادمان شُد دلِ انجمن"
  },
  {
    "poem_id": 1329,
    "vorder": 9,
    "position": 0,
    "text": "جوانیش را خوی بَد یار بود"
  },
  {
    "poem_id": 1329,
    "vorder": 10,
    "position": 1,
    "text": "اَبا بَد هَمیشه به پیکار بود"
  },
  {
    "poem_id": 1329,
    "vorder": 11,
    "position": 0,
    "text": "بَر او تاختن کَرد ناگاه مرگ"
  },
  {
    "poem_id": 1329,
    "vorder": 12,
    "position": 1,
    "text": "نَهادَش به سَر بَر یکِی تیره تَرگ"
  },
  {
    "poem_id": 1329,
    "vorder": 13,
    "position": 0,
    "text": "بِدان خوی بَد جانِ شیرین بِداد"
  },
  {
    "poem_id": 1329,
    "vorder": 14,
    "position": 1,
    "text": "نَبُد از جوانیش یک روز شاد"
  },
  {
    "poem_id": 1329,
    "vorder": 15,
    "position": 0,
    "text": "یکایک از او بَخت بَرگَشته شُد"
  },
  {
    "poem_id": 1329,
    "vorder": 16,
    "position": 1,
    "text": "به دستِ یکی بَنده بَر کُشته شُد"
  },
  {
    "poem_id": 1329,
    "vorder": 17,
    "position": 0,
    "text": "بِرَفت او و این نامه ناگفته ماند"
  },
  {
    "poem_id": 1329,
    "vorder": 18,
    "position": 1,
    "text": "چُنان بَختِ بیدارِ او خُفته ماند"
  },
  {
    "poem_id": 1329,
    "vorder": 19,
    "position": 0,
    "text": "الهی عَفو کُن گُناهِ وُرا"
  },
  {
    "poem_id": 1329,
    "vorder": 20,
    "position": 1,
    "text": "بیَفزای دَر حَشْر جاهِ وُرا"
  }
]