[
  {
    "poem_id": 1395,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد سوی شهریار"
  },
  {
    "poem_id": 1395,
    "vorder": 2,
    "position": 1,
    "text": "که آمد ز ره زال سام سوار"
  },
  {
    "poem_id": 1395,
    "vorder": 3,
    "position": 0,
    "text": "پذیره شدندش همه سرکشان"
  },
  {
    "poem_id": 1395,
    "vorder": 4,
    "position": 1,
    "text": "که بودند در پادشاهی نشان"
  },
  {
    "poem_id": 1395,
    "vorder": 5,
    "position": 0,
    "text": "چو آمد به نزدیکی بارگاه"
  },
  {
    "poem_id": 1395,
    "vorder": 6,
    "position": 1,
    "text": "سبک نزد شاهش گشادند راه"
  },
  {
    "poem_id": 1395,
    "vorder": 7,
    "position": 0,
    "text": "چو نزدیک شاه اندر آمد زمین"
  },
  {
    "poem_id": 1395,
    "vorder": 8,
    "position": 1,
    "text": "ببوسید و بر شاه کرد آفرین"
  },
  {
    "poem_id": 1395,
    "vorder": 9,
    "position": 0,
    "text": "زمانی همی داشت بر خاک روی"
  },
  {
    "poem_id": 1395,
    "vorder": 10,
    "position": 1,
    "text": "بدو داد دل شاه آزرمجوی"
  },
  {
    "poem_id": 1395,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود تا رویش از خاک خشک"
  },
  {
    "poem_id": 1395,
    "vorder": 12,
    "position": 1,
    "text": "ستردند و بر وی پراگند مشک"
  },
  {
    "poem_id": 1395,
    "vorder": 13,
    "position": 0,
    "text": "بیامد بر تخت شاه ارجمند"
  },
  {
    "poem_id": 1395,
    "vorder": 14,
    "position": 1,
    "text": "بپرسید ازو شهریار بلند"
  },
  {
    "poem_id": 1395,
    "vorder": 15,
    "position": 0,
    "text": "که چون بودی ای پهلو راد مرد"
  },
  {
    "poem_id": 1395,
    "vorder": 16,
    "position": 1,
    "text": "بدین راه دشوار با باد و گرد"
  },
  {
    "poem_id": 1395,
    "vorder": 17,
    "position": 0,
    "text": "به فر تو گفتا همه بهتریست"
  },
  {
    "poem_id": 1395,
    "vorder": 18,
    "position": 1,
    "text": "ابا تو همه رنج رامشگریست"
  },
  {
    "poem_id": 1395,
    "vorder": 19,
    "position": 0,
    "text": "ازو بستد آن نامهٔ پهلوان"
  },
  {
    "poem_id": 1395,
    "vorder": 20,
    "position": 1,
    "text": "بخندید و شد شاد و روشن روان"
  },
  {
    "poem_id": 1395,
    "vorder": 21,
    "position": 0,
    "text": "چو بر خواند پاسخ چنین داد باز"
  },
  {
    "poem_id": 1395,
    "vorder": 22,
    "position": 1,
    "text": "که رنجی فزودی به دل بر دراز"
  },
  {
    "poem_id": 1395,
    "vorder": 23,
    "position": 0,
    "text": "ولیکن بدین نامهٔ دلپذیر"
  },
  {
    "poem_id": 1395,
    "vorder": 24,
    "position": 1,
    "text": "که بنوشت با درد دل سام پیر"
  },
  {
    "poem_id": 1395,
    "vorder": 25,
    "position": 0,
    "text": "اگر چه مرا هست ازین دل دژم"
  },
  {
    "poem_id": 1395,
    "vorder": 26,
    "position": 1,
    "text": "برانم که نندیشم از بیش و کم"
  },
  {
    "poem_id": 1395,
    "vorder": 27,
    "position": 0,
    "text": "بسازم برآرم همه کام تو"
  },
  {
    "poem_id": 1395,
    "vorder": 28,
    "position": 1,
    "text": "گر اینست فرجام آرام تو"
  },
  {
    "poem_id": 1395,
    "vorder": 29,
    "position": 0,
    "text": "تو یک چند اندر به شادی به پای"
  },
  {
    "poem_id": 1395,
    "vorder": 30,
    "position": 1,
    "text": "که تا من به کارت زنم نیک رای"
  },
  {
    "poem_id": 1395,
    "vorder": 31,
    "position": 0,
    "text": "ببردند خوالیگران خوان زر"
  },
  {
    "poem_id": 1395,
    "vorder": 32,
    "position": 1,
    "text": "شهنشاه بنشست با زال زر"
  },
  {
    "poem_id": 1395,
    "vorder": 33,
    "position": 0,
    "text": "بفرمود تا نامداران همه"
  },
  {
    "poem_id": 1395,
    "vorder": 34,
    "position": 1,
    "text": "نشستند بر خوان شاه رمه"
  },
  {
    "poem_id": 1395,
    "vorder": 35,
    "position": 0,
    "text": "چو از خوان خسرو بپرداختند"
  },
  {
    "poem_id": 1395,
    "vorder": 36,
    "position": 1,
    "text": "به تخت دگر جای می‌ساختند"
  },
  {
    "poem_id": 1395,
    "vorder": 37,
    "position": 0,
    "text": "چو می خورده شد نامور پور سام"
  },
  {
    "poem_id": 1395,
    "vorder": 38,
    "position": 1,
    "text": "نشست از بر اسپ زرین ستام"
  },
  {
    "poem_id": 1395,
    "vorder": 39,
    "position": 0,
    "text": "برفت و بپیمود بالای شب"
  },
  {
    "poem_id": 1395,
    "vorder": 40,
    "position": 1,
    "text": "پر اندیشه دل پر ز گفتار لب"
  },
  {
    "poem_id": 1395,
    "vorder": 41,
    "position": 0,
    "text": "بیامد به شبگیر بسته کمر"
  },
  {
    "poem_id": 1395,
    "vorder": 42,
    "position": 1,
    "text": "به پیش منوچهر پیروزگر"
  },
  {
    "poem_id": 1395,
    "vorder": 43,
    "position": 0,
    "text": "برو آفرین کرد شاه جهان"
  },
  {
    "poem_id": 1395,
    "vorder": 44,
    "position": 1,
    "text": "چو برگشت بستودش اندر نهان"
  }
]