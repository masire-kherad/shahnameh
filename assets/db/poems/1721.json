[
  {
    "poem_id": 1721,
    "vorder": 1,
    "position": 0,
    "text": "چو سال اندر آمد به هفتاد و هشت"
  },
  {
    "poem_id": 1721,
    "vorder": 2,
    "position": 1,
    "text": "جهاندار بیدار بیمار گشت"
  },
  {
    "poem_id": 1721,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا رفت شاپور پیش"
  },
  {
    "poem_id": 1721,
    "vorder": 4,
    "position": 1,
    "text": "ورا پندها داد ز اندازه بیش"
  },
  {
    "poem_id": 1721,
    "vorder": 5,
    "position": 0,
    "text": "بدانست کامد به نزدیک مرگ"
  },
  {
    "poem_id": 1721,
    "vorder": 6,
    "position": 1,
    "text": "همی زرد خواهد شدن سبز برگ"
  },
  {
    "poem_id": 1721,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت کاین عهد من یاددار"
  },
  {
    "poem_id": 1721,
    "vorder": 8,
    "position": 1,
    "text": "همه گفت بدگوی را باددار"
  },
  {
    "poem_id": 1721,
    "vorder": 9,
    "position": 0,
    "text": "سخنهای من چون شنودی بورز"
  },
  {
    "poem_id": 1721,
    "vorder": 10,
    "position": 1,
    "text": "مگر بازدانی ز ناارز ارز"
  },
  {
    "poem_id": 1721,
    "vorder": 11,
    "position": 0,
    "text": "جهان راست کردم به شمشیر داد"
  },
  {
    "poem_id": 1721,
    "vorder": 12,
    "position": 1,
    "text": "نگه داشتم ارج مرد نژاد"
  },
  {
    "poem_id": 1721,
    "vorder": 13,
    "position": 0,
    "text": "چو کار جهان مر مرا گشت راست"
  },
  {
    "poem_id": 1721,
    "vorder": 14,
    "position": 1,
    "text": "فزون شد زمین زندگانی بکاست"
  },
  {
    "poem_id": 1721,
    "vorder": 15,
    "position": 0,
    "text": "ازان پس که بسیار بردیم رنج"
  },
  {
    "poem_id": 1721,
    "vorder": 16,
    "position": 1,
    "text": "به رنج اندرون گرد کردیم گنج"
  },
  {
    "poem_id": 1721,
    "vorder": 17,
    "position": 0,
    "text": "شما را همان رنج پیشست و ناز"
  },
  {
    "poem_id": 1721,
    "vorder": 18,
    "position": 1,
    "text": "زمانی نشیب و زمانی فراز"
  },
  {
    "poem_id": 1721,
    "vorder": 19,
    "position": 0,
    "text": "چنین است کردار گردان سپهر"
  },
  {
    "poem_id": 1721,
    "vorder": 20,
    "position": 1,
    "text": "گهی درد پیش آردت گاه مهر"
  },
  {
    "poem_id": 1721,
    "vorder": 21,
    "position": 0,
    "text": "گهی بخت گردد چو اسپی شموس"
  },
  {
    "poem_id": 1721,
    "vorder": 22,
    "position": 1,
    "text": "به نعم اندرون زفتی آردت و بوس"
  },
  {
    "poem_id": 1721,
    "vorder": 23,
    "position": 0,
    "text": "زمانی یکی باره‌ای ساخته"
  },
  {
    "poem_id": 1721,
    "vorder": 24,
    "position": 1,
    "text": "ز فرهختگی سر برافراخته"
  },
  {
    "poem_id": 1721,
    "vorder": 25,
    "position": 0,
    "text": "بدان ای پسر کاین سرای فریب"
  },
  {
    "poem_id": 1721,
    "vorder": 26,
    "position": 1,
    "text": "ندارد ترا شادمان بی‌نهیب"
  },
  {
    "poem_id": 1721,
    "vorder": 27,
    "position": 0,
    "text": "نگهدار تن باش و آن خرد"
  },
  {
    "poem_id": 1721,
    "vorder": 28,
    "position": 1,
    "text": "چو خواهی که روزت به بد نگذرد"
  },
  {
    "poem_id": 1721,
    "vorder": 29,
    "position": 0,
    "text": "چو بر دین کند شهریار آفرین"
  },
  {
    "poem_id": 1721,
    "vorder": 30,
    "position": 1,
    "text": "برادر شود شهریاری و دین"
  },
  {
    "poem_id": 1721,
    "vorder": 31,
    "position": 0,
    "text": "نه بی‌تخت شاهیست دینی به پای"
  },
  {
    "poem_id": 1721,
    "vorder": 32,
    "position": 1,
    "text": "نه بی‌دین بود شهریاری به جای"
  },
  {
    "poem_id": 1721,
    "vorder": 33,
    "position": 0,
    "text": "دو دیباست یک در دگر بافته"
  },
  {
    "poem_id": 1721,
    "vorder": 34,
    "position": 1,
    "text": "برآورده پیش خرد تافته"
  },
  {
    "poem_id": 1721,
    "vorder": 35,
    "position": 0,
    "text": "نه از پادشا بی‌نیازست دین"
  },
  {
    "poem_id": 1721,
    "vorder": 36,
    "position": 1,
    "text": "نه بی‌دین بود شاه را آفرین"
  },
  {
    "poem_id": 1721,
    "vorder": 37,
    "position": 0,
    "text": "چنین پاسبانان یکدیگرند"
  },
  {
    "poem_id": 1721,
    "vorder": 38,
    "position": 1,
    "text": "تو گویی که در زیر یک چادرند"
  },
  {
    "poem_id": 1721,
    "vorder": 39,
    "position": 0,
    "text": "نه آن زین نه این زان بود بی‌نیاز"
  },
  {
    "poem_id": 1721,
    "vorder": 40,
    "position": 1,
    "text": "دو انباز دیدیمشان نیک‌ساز"
  },
  {
    "poem_id": 1721,
    "vorder": 41,
    "position": 0,
    "text": "چو باشد خداوند رای و خرد"
  },
  {
    "poem_id": 1721,
    "vorder": 42,
    "position": 1,
    "text": "دو گیتی همی مرد دینی برد"
  },
  {
    "poem_id": 1721,
    "vorder": 43,
    "position": 0,
    "text": "چو دین را بود پادشا پاسبان"
  },
  {
    "poem_id": 1721,
    "vorder": 44,
    "position": 1,
    "text": "تو این هر دو را جز برادر مخوان"
  },
  {
    "poem_id": 1721,
    "vorder": 45,
    "position": 0,
    "text": "چو دین‌دار کین دارد از پادشا"
  },
  {
    "poem_id": 1721,
    "vorder": 46,
    "position": 1,
    "text": "مخوان تا توانی ورا پارسا"
  },
  {
    "poem_id": 1721,
    "vorder": 47,
    "position": 0,
    "text": "هرانکس که بر دادگر شهریار"
  },
  {
    "poem_id": 1721,
    "vorder": 48,
    "position": 1,
    "text": "گشاید زبان مرد دینش مدار"
  },
  {
    "poem_id": 1721,
    "vorder": 49,
    "position": 0,
    "text": "چه گفت آن سخن‌گوی با آفرین"
  },
  {
    "poem_id": 1721,
    "vorder": 50,
    "position": 1,
    "text": "که چون بنگری مغز دادست دین"
  },
  {
    "poem_id": 1721,
    "vorder": 51,
    "position": 0,
    "text": "سر تخت شاهی بپیچد سه کار"
  },
  {
    "poem_id": 1721,
    "vorder": 52,
    "position": 1,
    "text": "نخستین ز بیدادگر شهریار"
  },
  {
    "poem_id": 1721,
    "vorder": 53,
    "position": 0,
    "text": "دگر آنک بی‌سود را برکشد"
  },
  {
    "poem_id": 1721,
    "vorder": 54,
    "position": 1,
    "text": "ز مرد هنرمند سر درکشد"
  },
  {
    "poem_id": 1721,
    "vorder": 55,
    "position": 0,
    "text": "سه دیگر که با گنج خویشی کند"
  },
  {
    "poem_id": 1721,
    "vorder": 56,
    "position": 1,
    "text": "به دینار کوشد که بیشی کند"
  },
  {
    "poem_id": 1721,
    "vorder": 57,
    "position": 0,
    "text": "به بخشندگی یاز و دین و خرد"
  },
  {
    "poem_id": 1721,
    "vorder": 58,
    "position": 1,
    "text": "دروغ ایچ تا با تو برنگذرد"
  },
  {
    "poem_id": 1721,
    "vorder": 59,
    "position": 0,
    "text": "رخ پادشا تیره دارد دروغ"
  },
  {
    "poem_id": 1721,
    "vorder": 60,
    "position": 1,
    "text": "بلندیش هرگز نگیرد فروغ"
  },
  {
    "poem_id": 1721,
    "vorder": 61,
    "position": 0,
    "text": "نگر تا نباشی نگهبان گنج"
  },
  {
    "poem_id": 1721,
    "vorder": 62,
    "position": 1,
    "text": "که مردم ز دینار یازد به رنج"
  },
  {
    "poem_id": 1721,
    "vorder": 63,
    "position": 0,
    "text": "اگر پادشا آز گنج آورد"
  },
  {
    "poem_id": 1721,
    "vorder": 64,
    "position": 1,
    "text": "تن زیردستان به رنج آورد"
  },
  {
    "poem_id": 1721,
    "vorder": 65,
    "position": 0,
    "text": "کجا گنج دهقان بود گنج اوست"
  },
  {
    "poem_id": 1721,
    "vorder": 66,
    "position": 1,
    "text": "وگر چند بر کوشش و رنج اوست"
  },
  {
    "poem_id": 1721,
    "vorder": 67,
    "position": 0,
    "text": "نگهبان بود شاه گنج ورا"
  },
  {
    "poem_id": 1721,
    "vorder": 68,
    "position": 1,
    "text": "به بار آورد شاخ رنج ورا"
  },
  {
    "poem_id": 1721,
    "vorder": 69,
    "position": 0,
    "text": "بدان کوش تا دور باشی ز خشم"
  },
  {
    "poem_id": 1721,
    "vorder": 70,
    "position": 1,
    "text": "به مردی به خواب از گنهکار چشم"
  },
  {
    "poem_id": 1721,
    "vorder": 71,
    "position": 0,
    "text": "چو خشم آوری هم پشیمان شوی"
  },
  {
    "poem_id": 1721,
    "vorder": 72,
    "position": 1,
    "text": "به پوزش نگهبان درمان شوی"
  },
  {
    "poem_id": 1721,
    "vorder": 73,
    "position": 0,
    "text": "هرانگه که خشم آورد پادشا"
  },
  {
    "poem_id": 1721,
    "vorder": 74,
    "position": 1,
    "text": "سبک‌مایه خواند ورا پارسا"
  },
  {
    "poem_id": 1721,
    "vorder": 75,
    "position": 0,
    "text": "چو بر شاه زشتست بد خواستن"
  },
  {
    "poem_id": 1721,
    "vorder": 76,
    "position": 1,
    "text": "بباید به خوبی دل آراستن"
  },
  {
    "poem_id": 1721,
    "vorder": 77,
    "position": 0,
    "text": "وگر بیم داری به دل یک زمان"
  },
  {
    "poem_id": 1721,
    "vorder": 78,
    "position": 1,
    "text": "شود خیره رای از بد بدگمان"
  },
  {
    "poem_id": 1721,
    "vorder": 79,
    "position": 0,
    "text": "ز بخشش منه بر دل اندوه نیز"
  },
  {
    "poem_id": 1721,
    "vorder": 80,
    "position": 1,
    "text": "بدان تا توان ای پسر ارج چیز"
  },
  {
    "poem_id": 1721,
    "vorder": 81,
    "position": 0,
    "text": "چنان دان که شاهی بدان پادشاست"
  },
  {
    "poem_id": 1721,
    "vorder": 82,
    "position": 1,
    "text": "که دور فلک را ببخشید راست"
  },
  {
    "poem_id": 1721,
    "vorder": 83,
    "position": 0,
    "text": "زمانی غم پادشاهی برد"
  },
  {
    "poem_id": 1721,
    "vorder": 84,
    "position": 1,
    "text": "رد و موبدش رای پیش آورد"
  },
  {
    "poem_id": 1721,
    "vorder": 85,
    "position": 0,
    "text": "بپرسد هم از کار بیداد و داد"
  },
  {
    "poem_id": 1721,
    "vorder": 86,
    "position": 1,
    "text": "کند این سخن بر دل شاه یاد"
  },
  {
    "poem_id": 1721,
    "vorder": 87,
    "position": 0,
    "text": "به روزی که رای شکار آیدت"
  },
  {
    "poem_id": 1721,
    "vorder": 88,
    "position": 1,
    "text": "چو یوز درنده به کار آیدت"
  },
  {
    "poem_id": 1721,
    "vorder": 89,
    "position": 0,
    "text": "دو بازی بهم در نباید زدن"
  },
  {
    "poem_id": 1721,
    "vorder": 90,
    "position": 1,
    "text": "می و بزم و نخچیر و بیرون شدن"
  },
  {
    "poem_id": 1721,
    "vorder": 91,
    "position": 0,
    "text": "که تن گردد از جستن می گران"
  },
  {
    "poem_id": 1721,
    "vorder": 92,
    "position": 1,
    "text": "نگه داشتند این سخن مهتران"
  },
  {
    "poem_id": 1721,
    "vorder": 93,
    "position": 0,
    "text": "وگر دشمن آید به جایی پدید"
  },
  {
    "poem_id": 1721,
    "vorder": 94,
    "position": 1,
    "text": "ازین کارها دل بباید برید"
  },
  {
    "poem_id": 1721,
    "vorder": 95,
    "position": 0,
    "text": "درم دادن و تیغ پیراستن"
  },
  {
    "poem_id": 1721,
    "vorder": 96,
    "position": 1,
    "text": "ز هر پادشاهی سپه خواستن"
  },
  {
    "poem_id": 1721,
    "vorder": 97,
    "position": 0,
    "text": "به فردا ممان کار امروز را"
  },
  {
    "poem_id": 1721,
    "vorder": 98,
    "position": 1,
    "text": "بر تخت منشان بدآموز را"
  },
  {
    "poem_id": 1721,
    "vorder": 99,
    "position": 0,
    "text": "مجوی از دل عامیان راستی"
  },
  {
    "poem_id": 1721,
    "vorder": 100,
    "position": 1,
    "text": "که از جست‌وجو آیدت کاستی"
  },
  {
    "poem_id": 1721,
    "vorder": 101,
    "position": 0,
    "text": "وزیشان ترا گر بد آید خبر"
  },
  {
    "poem_id": 1721,
    "vorder": 102,
    "position": 1,
    "text": "تو مشنو ز بدگوی و انده مخور"
  },
  {
    "poem_id": 1721,
    "vorder": 103,
    "position": 0,
    "text": "نه خسروپرست و نه یزدان‌پرست"
  },
  {
    "poem_id": 1721,
    "vorder": 104,
    "position": 1,
    "text": "اگر پای گیری سر آید به دست"
  },
  {
    "poem_id": 1721,
    "vorder": 105,
    "position": 0,
    "text": "چنین باشد اندازهٔ عام شهر"
  },
  {
    "poem_id": 1721,
    "vorder": 106,
    "position": 1,
    "text": "ترا جاودان از خرد باد بهر"
  },
  {
    "poem_id": 1721,
    "vorder": 107,
    "position": 0,
    "text": "بترس از بد مردم بدنهان"
  },
  {
    "poem_id": 1721,
    "vorder": 108,
    "position": 1,
    "text": "که بر بدنهان تنگ گردد جهان"
  },
  {
    "poem_id": 1721,
    "vorder": 109,
    "position": 0,
    "text": "سخن هیچ مگشای با رازدار"
  },
  {
    "poem_id": 1721,
    "vorder": 110,
    "position": 1,
    "text": "که او را بود نیز انباز و یار"
  },
  {
    "poem_id": 1721,
    "vorder": 111,
    "position": 0,
    "text": "سخن را تو آگنده دانی همی"
  },
  {
    "poem_id": 1721,
    "vorder": 112,
    "position": 1,
    "text": "ز گیتی پراگنده خوانی همی"
  },
  {
    "poem_id": 1721,
    "vorder": 113,
    "position": 0,
    "text": "چو رازت به شهر آشکارا شود"
  },
  {
    "poem_id": 1721,
    "vorder": 114,
    "position": 1,
    "text": "دل بخردان بی‌مدرا شود"
  },
  {
    "poem_id": 1721,
    "vorder": 115,
    "position": 0,
    "text": "برآشوبی و سر سبک خواندت"
  },
  {
    "poem_id": 1721,
    "vorder": 116,
    "position": 1,
    "text": "خردمند گر پیش بنشاندت"
  },
  {
    "poem_id": 1721,
    "vorder": 117,
    "position": 0,
    "text": "تو عیب کسان هیچ‌گونه مجوی"
  },
  {
    "poem_id": 1721,
    "vorder": 118,
    "position": 1,
    "text": "که عیب آورد بر تو بر عیب‌جوی"
  },
  {
    "poem_id": 1721,
    "vorder": 119,
    "position": 0,
    "text": "وگر چیره گردد هوا بر خرد"
  },
  {
    "poem_id": 1721,
    "vorder": 120,
    "position": 1,
    "text": "خردمندت از مردمان نشمرد"
  },
  {
    "poem_id": 1721,
    "vorder": 121,
    "position": 0,
    "text": "خردمند باید جهاندار شاه"
  },
  {
    "poem_id": 1721,
    "vorder": 122,
    "position": 1,
    "text": "کجا هرکسی را بود نیک‌خواه"
  },
  {
    "poem_id": 1721,
    "vorder": 123,
    "position": 0,
    "text": "کسی کو بود تیز و برترمنش"
  },
  {
    "poem_id": 1721,
    "vorder": 124,
    "position": 1,
    "text": "بپیچد ز پیغاره و سرزنش"
  },
  {
    "poem_id": 1721,
    "vorder": 125,
    "position": 0,
    "text": "مبادا که گیرد به نزد تو جای"
  },
  {
    "poem_id": 1721,
    "vorder": 126,
    "position": 1,
    "text": "چنین مرد گر باشدت رهنمای"
  },
  {
    "poem_id": 1721,
    "vorder": 127,
    "position": 0,
    "text": "چو خواهی که بستایدت پارسا"
  },
  {
    "poem_id": 1721,
    "vorder": 128,
    "position": 1,
    "text": "بنه خشم و کین چون شوی پادشا"
  },
  {
    "poem_id": 1721,
    "vorder": 129,
    "position": 0,
    "text": "هوا چونک بر تخت حشمت نشست"
  },
  {
    "poem_id": 1721,
    "vorder": 130,
    "position": 1,
    "text": "نباشی خردمند و یزدان‌پرست"
  },
  {
    "poem_id": 1721,
    "vorder": 131,
    "position": 0,
    "text": "نباید که باشی فراوان سخن"
  },
  {
    "poem_id": 1721,
    "vorder": 132,
    "position": 1,
    "text": "به روی کسان پارسایی مکن"
  },
  {
    "poem_id": 1721,
    "vorder": 133,
    "position": 0,
    "text": "سخن بشنو و بهترین یادگیر"
  },
  {
    "poem_id": 1721,
    "vorder": 134,
    "position": 1,
    "text": "نگر تا کدام آیدت دلپذیر"
  },
  {
    "poem_id": 1721,
    "vorder": 135,
    "position": 0,
    "text": "سخن پیش فرهنگیان سخته گوی"
  },
  {
    "poem_id": 1721,
    "vorder": 136,
    "position": 1,
    "text": "گه می نوازنده و تازه‌روی"
  },
  {
    "poem_id": 1721,
    "vorder": 137,
    "position": 0,
    "text": "مکن خوار خواهنده درویش را"
  },
  {
    "poem_id": 1721,
    "vorder": 138,
    "position": 1,
    "text": "بر تخت منشان بداندیش را"
  },
  {
    "poem_id": 1721,
    "vorder": 139,
    "position": 0,
    "text": "هرانکس که پوزش کند بر گناه"
  },
  {
    "poem_id": 1721,
    "vorder": 140,
    "position": 1,
    "text": "تو بپذیر و کین گذشته مخواه"
  },
  {
    "poem_id": 1721,
    "vorder": 141,
    "position": 0,
    "text": "همه داده ده باش و پروردگار"
  },
  {
    "poem_id": 1721,
    "vorder": 142,
    "position": 1,
    "text": "خنک مرد بخشنده و بردبار"
  },
  {
    "poem_id": 1721,
    "vorder": 143,
    "position": 0,
    "text": "چو دشمن بترسد شود چاپلوس"
  },
  {
    "poem_id": 1721,
    "vorder": 144,
    "position": 1,
    "text": "تو لشکر بیارای و بربند کوس"
  },
  {
    "poem_id": 1721,
    "vorder": 145,
    "position": 0,
    "text": "به جنگ آنگهی شو که دشمن ز جنگ"
  },
  {
    "poem_id": 1721,
    "vorder": 146,
    "position": 1,
    "text": "بپرهیزد و سست گردد به ننگ"
  },
  {
    "poem_id": 1721,
    "vorder": 147,
    "position": 0,
    "text": "وگر آشتی جوید و راستی"
  },
  {
    "poem_id": 1721,
    "vorder": 148,
    "position": 1,
    "text": "نبینی به دلش اندرون کاستی"
  },
  {
    "poem_id": 1721,
    "vorder": 149,
    "position": 0,
    "text": "ازو باژ بستان و کینه مجوی"
  },
  {
    "poem_id": 1721,
    "vorder": 150,
    "position": 1,
    "text": "چنین دار نزدیک او آب‌روی"
  },
  {
    "poem_id": 1721,
    "vorder": 151,
    "position": 0,
    "text": "بیارای دل را به دانش که ارز"
  },
  {
    "poem_id": 1721,
    "vorder": 152,
    "position": 1,
    "text": "به دانش بود تا توانی بورز"
  },
  {
    "poem_id": 1721,
    "vorder": 153,
    "position": 0,
    "text": "چو بخشنده باشی گرامی شوی"
  },
  {
    "poem_id": 1721,
    "vorder": 154,
    "position": 1,
    "text": "ز دانایی و داد نامی شوی"
  },
  {
    "poem_id": 1721,
    "vorder": 155,
    "position": 0,
    "text": "تو عهد پدر با روانت بدار"
  },
  {
    "poem_id": 1721,
    "vorder": 156,
    "position": 1,
    "text": "به فرزندمان هم‌چنین یادگار"
  },
  {
    "poem_id": 1721,
    "vorder": 157,
    "position": 0,
    "text": "چو من حق فرزند بگزاردم"
  },
  {
    "poem_id": 1721,
    "vorder": 158,
    "position": 1,
    "text": "کسی را ز گیتی نیازاردم"
  },
  {
    "poem_id": 1721,
    "vorder": 159,
    "position": 0,
    "text": "شما هم ازین عهد من مگذرید"
  },
  {
    "poem_id": 1721,
    "vorder": 160,
    "position": 1,
    "text": "نفس داستان را به بد مشمرید"
  },
  {
    "poem_id": 1721,
    "vorder": 161,
    "position": 0,
    "text": "تو پند پدر همچنین یاددار"
  },
  {
    "poem_id": 1721,
    "vorder": 162,
    "position": 1,
    "text": "به نیکی گرای و بدی باد دار"
  },
  {
    "poem_id": 1721,
    "vorder": 163,
    "position": 0,
    "text": "به خیره مرنجان روان مرا"
  },
  {
    "poem_id": 1721,
    "vorder": 164,
    "position": 1,
    "text": "به آتش تن ناتوان مرا"
  },
  {
    "poem_id": 1721,
    "vorder": 165,
    "position": 0,
    "text": "به بد کردن خویش و آزار کس"
  },
  {
    "poem_id": 1721,
    "vorder": 166,
    "position": 1,
    "text": "مجوی ای پسر درد و تیمار کس"
  },
  {
    "poem_id": 1721,
    "vorder": 167,
    "position": 0,
    "text": "برین بگذرد سالیان پانصد"
  },
  {
    "poem_id": 1721,
    "vorder": 168,
    "position": 1,
    "text": "بزرگی شما را به پایان رسد"
  },
  {
    "poem_id": 1721,
    "vorder": 169,
    "position": 0,
    "text": "بپیچد سر از عهد فرزند تو"
  },
  {
    "poem_id": 1721,
    "vorder": 170,
    "position": 1,
    "text": "هم‌انکس که باشد ز پیوند تو"
  },
  {
    "poem_id": 1721,
    "vorder": 171,
    "position": 0,
    "text": "ز رای و ز دانش به یکسو شوند"
  },
  {
    "poem_id": 1721,
    "vorder": 172,
    "position": 1,
    "text": "همان پند دانندگان نشنوند"
  },
  {
    "poem_id": 1721,
    "vorder": 173,
    "position": 0,
    "text": "بگردند یکسر ز عهد و وفا"
  },
  {
    "poem_id": 1721,
    "vorder": 174,
    "position": 1,
    "text": "به بیداد یازند و جور و جفا"
  },
  {
    "poem_id": 1721,
    "vorder": 175,
    "position": 0,
    "text": "جهان تنگ دارند بر زیردست"
  },
  {
    "poem_id": 1721,
    "vorder": 176,
    "position": 1,
    "text": "بر ایشان شود خوار یزدان‌پرست"
  },
  {
    "poem_id": 1721,
    "vorder": 177,
    "position": 0,
    "text": "بپوشند پیراهن بدتنی"
  },
  {
    "poem_id": 1721,
    "vorder": 178,
    "position": 1,
    "text": "ببالند با کیش آهرمنی"
  },
  {
    "poem_id": 1721,
    "vorder": 179,
    "position": 0,
    "text": "گشاده شود هرچ ما بسته‌ایم"
  },
  {
    "poem_id": 1721,
    "vorder": 180,
    "position": 1,
    "text": "بیالاید آن دین که ما شسته‌ایم"
  },
  {
    "poem_id": 1721,
    "vorder": 181,
    "position": 0,
    "text": "تبه گردد این پند و اندرز من"
  },
  {
    "poem_id": 1721,
    "vorder": 182,
    "position": 1,
    "text": "به ویرانی آرد رخ این مرز من"
  },
  {
    "poem_id": 1721,
    "vorder": 183,
    "position": 0,
    "text": "همی خواهم از کردگار جهان"
  },
  {
    "poem_id": 1721,
    "vorder": 184,
    "position": 1,
    "text": "شناسندهٔ آشکار و نهان"
  },
  {
    "poem_id": 1721,
    "vorder": 185,
    "position": 0,
    "text": "که باشد ز هر بد نگهدارتان"
  },
  {
    "poem_id": 1721,
    "vorder": 186,
    "position": 1,
    "text": "همه نیک نامی بود یارتان"
  },
  {
    "poem_id": 1721,
    "vorder": 187,
    "position": 0,
    "text": "ز یزدان و از ما بر آن کس درود"
  },
  {
    "poem_id": 1721,
    "vorder": 188,
    "position": 1,
    "text": "که تارش خرد باشد و داد پود"
  },
  {
    "poem_id": 1721,
    "vorder": 189,
    "position": 0,
    "text": "نیارد شکست اندرین عهد من"
  },
  {
    "poem_id": 1721,
    "vorder": 190,
    "position": 1,
    "text": "نکوشد که حنظل کند شهد من"
  },
  {
    "poem_id": 1721,
    "vorder": 191,
    "position": 0,
    "text": "برآمد چهل سال و بر سر دو ماه"
  },
  {
    "poem_id": 1721,
    "vorder": 192,
    "position": 1,
    "text": "که تا برنهادم به شاهی کلاه"
  },
  {
    "poem_id": 1721,
    "vorder": 193,
    "position": 0,
    "text": "به گیتی مرا شارستانست شش"
  },
  {
    "poem_id": 1721,
    "vorder": 194,
    "position": 1,
    "text": "هوا خوشگوار و به زیر آب خوش"
  },
  {
    "poem_id": 1721,
    "vorder": 195,
    "position": 0,
    "text": "یکی خواندم خورهٔ اردشیر"
  },
  {
    "poem_id": 1721,
    "vorder": 196,
    "position": 1,
    "text": "که گردد زبادش جوان مرد پیر"
  },
  {
    "poem_id": 1721,
    "vorder": 197,
    "position": 0,
    "text": "کزو تازه شد کشور خوزیان"
  },
  {
    "poem_id": 1721,
    "vorder": 198,
    "position": 1,
    "text": "پر از مردم و آب و سود و زیان"
  },
  {
    "poem_id": 1721,
    "vorder": 199,
    "position": 0,
    "text": "دگر شارستان گندشاپور نام"
  },
  {
    "poem_id": 1721,
    "vorder": 200,
    "position": 1,
    "text": "که موبد ازان شهر شد شادکام"
  },
  {
    "poem_id": 1721,
    "vorder": 201,
    "position": 0,
    "text": "دگر بوم میسان و رود فرات"
  },
  {
    "poem_id": 1721,
    "vorder": 202,
    "position": 1,
    "text": "پر از چشمه و چارپای و نبات"
  },
  {
    "poem_id": 1721,
    "vorder": 203,
    "position": 0,
    "text": "دگر شارستان برکهٔ اردشیر"
  },
  {
    "poem_id": 1721,
    "vorder": 204,
    "position": 1,
    "text": "پر از باغ و پر گلشن و آبگیر"
  },
  {
    "poem_id": 1721,
    "vorder": 205,
    "position": 0,
    "text": "چو رام اردشیرست شهری دگر"
  },
  {
    "poem_id": 1721,
    "vorder": 206,
    "position": 1,
    "text": "کزو بر سوی پارس کردم گذر"
  },
  {
    "poem_id": 1721,
    "vorder": 207,
    "position": 0,
    "text": "دگر شارستان اورمزد اردشیر"
  },
  {
    "poem_id": 1721,
    "vorder": 208,
    "position": 1,
    "text": "هوا مشک بوی و به جوی آب شیر"
  },
  {
    "poem_id": 1721,
    "vorder": 209,
    "position": 0,
    "text": "روان مرا شادگردان به داد"
  },
  {
    "poem_id": 1721,
    "vorder": 210,
    "position": 1,
    "text": "که پیروز بادی تو بر تخت شاد"
  },
  {
    "poem_id": 1721,
    "vorder": 211,
    "position": 0,
    "text": "بسی رنجها بردم اندر جهان"
  },
  {
    "poem_id": 1721,
    "vorder": 212,
    "position": 1,
    "text": "چه بر آشکار و چه اندر نهان"
  },
  {
    "poem_id": 1721,
    "vorder": 213,
    "position": 0,
    "text": "کنون دخمه را برنهادیم رخت"
  },
  {
    "poem_id": 1721,
    "vorder": 214,
    "position": 1,
    "text": "تو بسپار تابوت و پرداز تخت"
  },
  {
    "poem_id": 1721,
    "vorder": 215,
    "position": 0,
    "text": "بگفت این و تاریک شد بخت اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 216,
    "position": 1,
    "text": "دریغ آن سر و افسر و تخت اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 217,
    "position": 0,
    "text": "چنین است آیین خرم جهان"
  },
  {
    "poem_id": 1721,
    "vorder": 218,
    "position": 1,
    "text": "نخواهد بما برگشادن نهان"
  },
  {
    "poem_id": 1721,
    "vorder": 219,
    "position": 0,
    "text": "انوشه کسی کو بزرگی ندید"
  },
  {
    "poem_id": 1721,
    "vorder": 220,
    "position": 1,
    "text": "نبایستش از تخت شد ناپدید"
  },
  {
    "poem_id": 1721,
    "vorder": 221,
    "position": 0,
    "text": "بکوشی و آری ز هرگونه چیز"
  },
  {
    "poem_id": 1721,
    "vorder": 222,
    "position": 1,
    "text": "نه مردم نه آن چیز ماند به نیز"
  },
  {
    "poem_id": 1721,
    "vorder": 223,
    "position": 0,
    "text": "سرانجام با خاک باشیم جفت"
  },
  {
    "poem_id": 1721,
    "vorder": 224,
    "position": 1,
    "text": "دو رخ را به چادر بباید نهفت"
  },
  {
    "poem_id": 1721,
    "vorder": 225,
    "position": 0,
    "text": "بیا تا همه دست نیکی بریم"
  },
  {
    "poem_id": 1721,
    "vorder": 226,
    "position": 1,
    "text": "جهان جهان را به بد نسپریم"
  },
  {
    "poem_id": 1721,
    "vorder": 227,
    "position": 0,
    "text": "بکوشیم بر نیک‌نامی به تن"
  },
  {
    "poem_id": 1721,
    "vorder": 228,
    "position": 1,
    "text": "کزین نام یابیم بر انجمن"
  },
  {
    "poem_id": 1721,
    "vorder": 229,
    "position": 0,
    "text": "خنک آنک جامی بگیرد به دست"
  },
  {
    "poem_id": 1721,
    "vorder": 230,
    "position": 1,
    "text": "خورد یاد شاهان یزدان‌پرست"
  },
  {
    "poem_id": 1721,
    "vorder": 231,
    "position": 0,
    "text": "چو جام نبیدش دمادم شود"
  },
  {
    "poem_id": 1721,
    "vorder": 232,
    "position": 1,
    "text": "بخسپد بدانگه که خرم شود"
  },
  {
    "poem_id": 1721,
    "vorder": 233,
    "position": 0,
    "text": "کنون پادشاهی شاپور گوی"
  },
  {
    "poem_id": 1721,
    "vorder": 234,
    "position": 1,
    "text": "زبان برگشای از می و سور گوی"
  },
  {
    "poem_id": 1721,
    "vorder": 235,
    "position": 0,
    "text": "بران آفرین کافرین آفرید"
  },
  {
    "poem_id": 1721,
    "vorder": 236,
    "position": 1,
    "text": "مکان و زمان و زمین آفرید"
  },
  {
    "poem_id": 1721,
    "vorder": 237,
    "position": 0,
    "text": "هم آرام ازویست و هم کار ازوی"
  },
  {
    "poem_id": 1721,
    "vorder": 238,
    "position": 1,
    "text": "هم انجام ازویست و فرجام ازوی"
  },
  {
    "poem_id": 1721,
    "vorder": 239,
    "position": 0,
    "text": "سپهر و زمان و زمین کرده است"
  },
  {
    "poem_id": 1721,
    "vorder": 240,
    "position": 1,
    "text": "کم و بیش گیتی برآورده است"
  },
  {
    "poem_id": 1721,
    "vorder": 241,
    "position": 0,
    "text": "ز خاشاک ناچیز تا عرش راست"
  },
  {
    "poem_id": 1721,
    "vorder": 242,
    "position": 1,
    "text": "سراسر به هستی یزدان گواست"
  },
  {
    "poem_id": 1721,
    "vorder": 243,
    "position": 0,
    "text": "جز او را مخوان کردگار جهان"
  },
  {
    "poem_id": 1721,
    "vorder": 244,
    "position": 1,
    "text": "شناسندهٔ آشکار و نهان"
  },
  {
    "poem_id": 1721,
    "vorder": 245,
    "position": 0,
    "text": "ازو بر روان محمد درود"
  },
  {
    "poem_id": 1721,
    "vorder": 246,
    "position": 1,
    "text": "بیارانش بر هریکی برفزود"
  },
  {
    "poem_id": 1721,
    "vorder": 247,
    "position": 0,
    "text": "سرانجمن بد ز یاران علی"
  },
  {
    "poem_id": 1721,
    "vorder": 248,
    "position": 1,
    "text": "که خوانند او را علی ولی"
  },
  {
    "poem_id": 1721,
    "vorder": 249,
    "position": 0,
    "text": "همه پاک بودند و پرهیزگار"
  },
  {
    "poem_id": 1721,
    "vorder": 250,
    "position": 1,
    "text": "سخنهایشان برگذشت از شمار"
  },
  {
    "poem_id": 1721,
    "vorder": 251,
    "position": 0,
    "text": "کنون بر سخنها فزایش کنیم"
  },
  {
    "poem_id": 1721,
    "vorder": 252,
    "position": 1,
    "text": "جهان‌آفرین را ستایش کنیم"
  },
  {
    "poem_id": 1721,
    "vorder": 253,
    "position": 0,
    "text": "ستاییم تاج شهنشاه را"
  },
  {
    "poem_id": 1721,
    "vorder": 254,
    "position": 1,
    "text": "که تختش درفشان کند ماه را"
  },
  {
    "poem_id": 1721,
    "vorder": 255,
    "position": 0,
    "text": "خداوند با فر و با بخش و داد"
  },
  {
    "poem_id": 1721,
    "vorder": 256,
    "position": 1,
    "text": "زمانه به فرمان او گشت شاد"
  },
  {
    "poem_id": 1721,
    "vorder": 257,
    "position": 0,
    "text": "خداوند گوپال و شمشیر و گنج"
  },
  {
    "poem_id": 1721,
    "vorder": 258,
    "position": 1,
    "text": "خداوند آسانی و درد و رنج"
  },
  {
    "poem_id": 1721,
    "vorder": 259,
    "position": 0,
    "text": "جهاندار با فر و نیکی‌شناس"
  },
  {
    "poem_id": 1721,
    "vorder": 260,
    "position": 1,
    "text": "که از تاج دارد به یزدان سپاس"
  },
  {
    "poem_id": 1721,
    "vorder": 261,
    "position": 0,
    "text": "خردمند و زیبا و چیره‌سخن"
  },
  {
    "poem_id": 1721,
    "vorder": 262,
    "position": 1,
    "text": "جوانی بسال و بدانش کهن"
  },
  {
    "poem_id": 1721,
    "vorder": 263,
    "position": 0,
    "text": "همی مشتری بارد از ابر اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 264,
    "position": 1,
    "text": "بتازیم در سایهٔ فر اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 265,
    "position": 0,
    "text": "به رزم آسمان را خروشان کند"
  },
  {
    "poem_id": 1721,
    "vorder": 266,
    "position": 1,
    "text": "چو بزم آیدش گوهرافشان کند"
  },
  {
    "poem_id": 1721,
    "vorder": 267,
    "position": 0,
    "text": "چو خشم آورد کوه ریزان شود"
  },
  {
    "poem_id": 1721,
    "vorder": 268,
    "position": 1,
    "text": "سپهر از بر خاک لرزان شود"
  },
  {
    "poem_id": 1721,
    "vorder": 269,
    "position": 0,
    "text": "پدر بر پدر شهریارست و شاه"
  },
  {
    "poem_id": 1721,
    "vorder": 270,
    "position": 1,
    "text": "بنازد بدو گنبد هور و ماه"
  },
  {
    "poem_id": 1721,
    "vorder": 271,
    "position": 0,
    "text": "بماناد تا جاودان نام اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 272,
    "position": 1,
    "text": "همه مهتری باد فرجام اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 273,
    "position": 0,
    "text": "سر نامه کردم ثنای ورا"
  },
  {
    "poem_id": 1721,
    "vorder": 274,
    "position": 1,
    "text": "بزرگی و آیین و رای ورا"
  },
  {
    "poem_id": 1721,
    "vorder": 275,
    "position": 0,
    "text": "ازو دیدم اندر جهان نام نیک"
  },
  {
    "poem_id": 1721,
    "vorder": 276,
    "position": 1,
    "text": "ز گیتی ورا باد فرجام نیک"
  },
  {
    "poem_id": 1721,
    "vorder": 277,
    "position": 0,
    "text": "ز دیدار او تاج روشن شدست"
  },
  {
    "poem_id": 1721,
    "vorder": 278,
    "position": 1,
    "text": "ز بدها ورا بخت جوشن شدست"
  },
  {
    "poem_id": 1721,
    "vorder": 279,
    "position": 0,
    "text": "بنازد بدو مردم پارسا"
  },
  {
    "poem_id": 1721,
    "vorder": 280,
    "position": 1,
    "text": "هم‌انکس که شد بر زمین پادشا"
  },
  {
    "poem_id": 1721,
    "vorder": 281,
    "position": 0,
    "text": "هوا روشن از بارور بخت اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 282,
    "position": 1,
    "text": "زمین پایهٔ نامور تخت اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 283,
    "position": 0,
    "text": "به رزم اندرون ژنده پیل بلاست"
  },
  {
    "poem_id": 1721,
    "vorder": 284,
    "position": 1,
    "text": "به بزم اندرون آسمان وفاست"
  },
  {
    "poem_id": 1721,
    "vorder": 285,
    "position": 0,
    "text": "چو در رزم رخشان شود رای اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 286,
    "position": 1,
    "text": "همی موج خیزد ز دریای اوی"
  },
  {
    "poem_id": 1721,
    "vorder": 287,
    "position": 0,
    "text": "به نخچیر شیران شکار وی‌اند"
  },
  {
    "poem_id": 1721,
    "vorder": 288,
    "position": 1,
    "text": "دد و دام در زینهار وی‌اند"
  },
  {
    "poem_id": 1721,
    "vorder": 289,
    "position": 0,
    "text": "از آواز گرزش همی روز جنگ"
  },
  {
    "poem_id": 1721,
    "vorder": 290,
    "position": 1,
    "text": "بدرد دل شیر و چرم پلنگ"
  },
  {
    "poem_id": 1721,
    "vorder": 291,
    "position": 0,
    "text": "سرش سبز باد و دلش پر ز داد"
  },
  {
    "poem_id": 1721,
    "vorder": 292,
    "position": 1,
    "text": "جهان بی‌سر و افسر او مباد"
  }
]