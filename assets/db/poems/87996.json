[
  {
    "poem_id": 87996,
    "vorder": 1,
    "position": 0,
    "text": "به خیمه درآمد به کردار باد"
  },
  {
    "poem_id": 87996,
    "vorder": 2,
    "position": 1,
    "text": "یکی ترگ دیگر به سر برنهاد"
  },
  {
    "poem_id": 87996,
    "vorder": 3,
    "position": 0,
    "text": "درفشی دگر جست و اسپی دگر"
  },
  {
    "poem_id": 87996,
    "vorder": 4,
    "position": 1,
    "text": "دگرگونه جوشن دگرگون سپر"
  },
  {
    "poem_id": 87996,
    "vorder": 5,
    "position": 0,
    "text": "بیامد چو نزدیک رستم رسید"
  },
  {
    "poem_id": 87996,
    "vorder": 6,
    "position": 1,
    "text": "همی بود تا یال و شاخش بدید"
  },
  {
    "poem_id": 87996,
    "vorder": 7,
    "position": 0,
    "text": "به رستم چنین گفت کای نامدار"
  },
  {
    "poem_id": 87996,
    "vorder": 8,
    "position": 1,
    "text": "کمندافگن و گرد و جنگی سوار"
  },
  {
    "poem_id": 87996,
    "vorder": 9,
    "position": 0,
    "text": "به یزدان که بیزارم از تاج و گاه"
  },
  {
    "poem_id": 87996,
    "vorder": 10,
    "position": 1,
    "text": "که چون تو ندیدم یکی رزم‌خواه"
  },
  {
    "poem_id": 87996,
    "vorder": 11,
    "position": 0,
    "text": "ز تو بگذرد زین سپاه بزرگ"
  },
  {
    "poem_id": 87996,
    "vorder": 12,
    "position": 1,
    "text": "نبینم همی نامداری سترگ"
  },
  {
    "poem_id": 87996,
    "vorder": 13,
    "position": 0,
    "text": "دلیری که چندین بجوید نبرد"
  },
  {
    "poem_id": 87996,
    "vorder": 14,
    "position": 1,
    "text": "برآرد همی از دل شیر گرد"
  },
  {
    "poem_id": 87996,
    "vorder": 15,
    "position": 0,
    "text": "ز شهر و نژاد و ز آرام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 16,
    "position": 1,
    "text": "سخن‌گوی و از تخمه و نام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 17,
    "position": 0,
    "text": "جز از تو کسی را ز ایران سپاه"
  },
  {
    "poem_id": 87996,
    "vorder": 18,
    "position": 1,
    "text": "ندیدم که دارد دل رزمگاه"
  },
  {
    "poem_id": 87996,
    "vorder": 19,
    "position": 0,
    "text": "مرا مهربانیست بر مرد جنگ"
  },
  {
    "poem_id": 87996,
    "vorder": 20,
    "position": 1,
    "text": "بویژه که دارد نهاد پلنگ"
  },
  {
    "poem_id": 87996,
    "vorder": 21,
    "position": 0,
    "text": "کنون گر بگویی مرا نام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 22,
    "position": 1,
    "text": "بَر و بوم و پیوند وآرام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 23,
    "position": 0,
    "text": "سپاسی برین کار بر من نهی"
  },
  {
    "poem_id": 87996,
    "vorder": 24,
    "position": 1,
    "text": "کز اندیشه گردد دل من تهی"
  },
  {
    "poem_id": 87996,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت رستم که چندین سُخُن"
  },
  {
    "poem_id": 87996,
    "vorder": 26,
    "position": 1,
    "text": "که گفتی و افگندی از مهر بُن"
  },
  {
    "poem_id": 87996,
    "vorder": 27,
    "position": 0,
    "text": "چرا تو نگویی مرا نام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 28,
    "position": 1,
    "text": "بر و کشور و بوم و آرام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 29,
    "position": 0,
    "text": "چرا آمده‌ستی به نزدیک من"
  },
  {
    "poem_id": 87996,
    "vorder": 30,
    "position": 1,
    "text": "به نرمی و چربی و چندین سخن"
  },
  {
    "poem_id": 87996,
    "vorder": 31,
    "position": 0,
    "text": "اگر آشتی جست خواهی همی"
  },
  {
    "poem_id": 87996,
    "vorder": 32,
    "position": 1,
    "text": "بکوشی که این کینه کاهی همی"
  },
  {
    "poem_id": 87996,
    "vorder": 33,
    "position": 0,
    "text": "نگه کن که خون سیاوش که ریخت"
  },
  {
    "poem_id": 87996,
    "vorder": 34,
    "position": 1,
    "text": "چنین آتش کین به ما بر که بیخت"
  },
  {
    "poem_id": 87996,
    "vorder": 35,
    "position": 0,
    "text": "همان خون پرمایه گودرزیان"
  },
  {
    "poem_id": 87996,
    "vorder": 36,
    "position": 1,
    "text": "که بفزود چندین زیان بر زیان"
  },
  {
    "poem_id": 87996,
    "vorder": 37,
    "position": 0,
    "text": "بزرگان کجا با سیاوش بُدند"
  },
  {
    "poem_id": 87996,
    "vorder": 38,
    "position": 1,
    "text": "نجستند پیکار و خامش بُدند"
  },
  {
    "poem_id": 87996,
    "vorder": 39,
    "position": 0,
    "text": "گنهکار خون سر بیگناه"
  },
  {
    "poem_id": 87996,
    "vorder": 40,
    "position": 1,
    "text": "نگر تا که یابی ز توران سپاه"
  },
  {
    "poem_id": 87996,
    "vorder": 41,
    "position": 0,
    "text": "ز مردان و اسپان آراسته"
  },
  {
    "poem_id": 87996,
    "vorder": 42,
    "position": 1,
    "text": "کز ایران بیاورد با خواسته"
  },
  {
    "poem_id": 87996,
    "vorder": 43,
    "position": 0,
    "text": "چو یکسر سوی ما فرستید باز"
  },
  {
    "poem_id": 87996,
    "vorder": 44,
    "position": 1,
    "text": "من از جنگ ترکان شوم بی‌نیاز"
  },
  {
    "poem_id": 87996,
    "vorder": 45,
    "position": 0,
    "text": "ازان پس همه نیکخواه منید"
  },
  {
    "poem_id": 87996,
    "vorder": 46,
    "position": 1,
    "text": "سراسر بر آیین و راه منید"
  },
  {
    "poem_id": 87996,
    "vorder": 47,
    "position": 0,
    "text": "نیازم بکین و نجویم نبرد"
  },
  {
    "poem_id": 87996,
    "vorder": 48,
    "position": 1,
    "text": "نیارم سر سرکشان زیر گرد"
  },
  {
    "poem_id": 87996,
    "vorder": 49,
    "position": 0,
    "text": "وزان پس بگویم به کیخسرو این"
  },
  {
    "poem_id": 87996,
    "vorder": 50,
    "position": 1,
    "text": "بشویم دل و مغزش از درد و کین"
  },
  {
    "poem_id": 87996,
    "vorder": 51,
    "position": 0,
    "text": "به تو برشمارم کنون نامشان"
  },
  {
    "poem_id": 87996,
    "vorder": 52,
    "position": 1,
    "text": "که مه نامشان باد و مه کامشان"
  },
  {
    "poem_id": 87996,
    "vorder": 53,
    "position": 0,
    "text": "سر کین ز گرسیوز آمد نخست"
  },
  {
    "poem_id": 87996,
    "vorder": 54,
    "position": 1,
    "text": "که درد دل و رنج ایران بجست"
  },
  {
    "poem_id": 87996,
    "vorder": 55,
    "position": 0,
    "text": "کسی را که دانی تو از تخم کور"
  },
  {
    "poem_id": 87996,
    "vorder": 56,
    "position": 1,
    "text": "که بر خیره این آب کردند شور"
  },
  {
    "poem_id": 87996,
    "vorder": 57,
    "position": 0,
    "text": "گروی زره و آنک از وی بزاد"
  },
  {
    "poem_id": 87996,
    "vorder": 58,
    "position": 1,
    "text": "نژادی که هرگز مباد آن نژاد"
  },
  {
    "poem_id": 87996,
    "vorder": 59,
    "position": 0,
    "text": "ستم بر سیاوش ازیشان رسید"
  },
  {
    "poem_id": 87996,
    "vorder": 60,
    "position": 1,
    "text": "که زو آمد این بند بد را کلید"
  },
  {
    "poem_id": 87996,
    "vorder": 61,
    "position": 0,
    "text": "کسی کو دل و مغز افراسیاب"
  },
  {
    "poem_id": 87996,
    "vorder": 62,
    "position": 1,
    "text": "تبه کرد و خون راند بر سان آب"
  },
  {
    "poem_id": 87996,
    "vorder": 63,
    "position": 0,
    "text": "و دیگر کسی را کز ایرانیان"
  },
  {
    "poem_id": 87996,
    "vorder": 64,
    "position": 1,
    "text": "نبد کین و بست اندرین کین میان"
  },
  {
    "poem_id": 87996,
    "vorder": 65,
    "position": 0,
    "text": "بزرگان که از تخمهٔ ویسه‌اند"
  },
  {
    "poem_id": 87996,
    "vorder": 66,
    "position": 1,
    "text": "دو رویند و با هر کسی پیسه‌اند"
  },
  {
    "poem_id": 87996,
    "vorder": 67,
    "position": 0,
    "text": "چو هومان و لهاک و فرشیدورد"
  },
  {
    "poem_id": 87996,
    "vorder": 68,
    "position": 1,
    "text": "چو کلباد و نستیهن آن شوخ مرد"
  },
  {
    "poem_id": 87996,
    "vorder": 69,
    "position": 0,
    "text": "اگر این که گفتم به جای آورید"
  },
  {
    "poem_id": 87996,
    "vorder": 70,
    "position": 1,
    "text": "سر کینه جستن به پای آورید"
  },
  {
    "poem_id": 87996,
    "vorder": 71,
    "position": 0,
    "text": "ببندم در کینه بر کشورت"
  },
  {
    "poem_id": 87996,
    "vorder": 72,
    "position": 1,
    "text": "بجوشن نپوشید باید برت"
  },
  {
    "poem_id": 87996,
    "vorder": 73,
    "position": 0,
    "text": "و گر جز بدین گونه گویی سُخَن"
  },
  {
    "poem_id": 87996,
    "vorder": 74,
    "position": 1,
    "text": "کنم تازه پیکار و کین کُهَن"
  },
  {
    "poem_id": 87996,
    "vorder": 75,
    "position": 0,
    "text": "که خوکردهٔ جنگ توران منم"
  },
  {
    "poem_id": 87996,
    "vorder": 76,
    "position": 1,
    "text": "یکی نامداری از ایران منم"
  },
  {
    "poem_id": 87996,
    "vorder": 77,
    "position": 0,
    "text": "بسی سر جدا کرده دارم ز تن"
  },
  {
    "poem_id": 87996,
    "vorder": 78,
    "position": 1,
    "text": "که جز کام شیران نبودش کفن"
  },
  {
    "poem_id": 87996,
    "vorder": 79,
    "position": 0,
    "text": "مرا آزمودی بدین رزمگاه"
  },
  {
    "poem_id": 87996,
    "vorder": 80,
    "position": 1,
    "text": "همینست رسم و همینست راه"
  },
  {
    "poem_id": 87996,
    "vorder": 81,
    "position": 0,
    "text": "ازین گونه هرگز نگفتم سُخُن"
  },
  {
    "poem_id": 87996,
    "vorder": 82,
    "position": 1,
    "text": "بجز کین نجستم ز سر تا به بُن"
  },
  {
    "poem_id": 87996,
    "vorder": 83,
    "position": 0,
    "text": "کنون هرچ گفتم ترا گوش دار"
  },
  {
    "poem_id": 87996,
    "vorder": 84,
    "position": 1,
    "text": "سخنهای خوب اندر آغوش دار"
  },
  {
    "poem_id": 87996,
    "vorder": 85,
    "position": 0,
    "text": "چو بشنید هومان بترسید سخت"
  },
  {
    "poem_id": 87996,
    "vorder": 86,
    "position": 1,
    "text": "بلرزید بر سان برگ درخت"
  },
  {
    "poem_id": 87996,
    "vorder": 87,
    "position": 0,
    "text": "کزان گونه گفتار رستم شنید"
  },
  {
    "poem_id": 87996,
    "vorder": 88,
    "position": 1,
    "text": "همه کینه از دودهٔ خویش دید"
  },
  {
    "poem_id": 87996,
    "vorder": 89,
    "position": 0,
    "text": "چنین پاسخ آورد هومان بدوی"
  },
  {
    "poem_id": 87996,
    "vorder": 90,
    "position": 1,
    "text": "که ای شیر دل مرد پرخاشجوی"
  },
  {
    "poem_id": 87996,
    "vorder": 91,
    "position": 0,
    "text": "بدین زور و این برز و بالای تو"
  },
  {
    "poem_id": 87996,
    "vorder": 92,
    "position": 1,
    "text": "سر تخت ایران سزد جای تو"
  },
  {
    "poem_id": 87996,
    "vorder": 93,
    "position": 0,
    "text": "نباشی جز از پهلوانی بزرگ"
  },
  {
    "poem_id": 87996,
    "vorder": 94,
    "position": 1,
    "text": "وگر نامداری ز ایران سترگ"
  },
  {
    "poem_id": 87996,
    "vorder": 95,
    "position": 0,
    "text": "بپرسیدی از گوهر و نام من"
  },
  {
    "poem_id": 87996,
    "vorder": 96,
    "position": 1,
    "text": "به دل دیگر آمد ترا کام من"
  },
  {
    "poem_id": 87996,
    "vorder": 97,
    "position": 0,
    "text": "مرا کوه گوشست نام ای دلیر"
  },
  {
    "poem_id": 87996,
    "vorder": 98,
    "position": 1,
    "text": "پدر بوسپاسست مردی چو شیر"
  },
  {
    "poem_id": 87996,
    "vorder": 99,
    "position": 0,
    "text": "من از وهر با این سپاه آمدم"
  },
  {
    "poem_id": 87996,
    "vorder": 100,
    "position": 1,
    "text": "سپاهی بدین رزمگاه آمدم"
  },
  {
    "poem_id": 87996,
    "vorder": 101,
    "position": 0,
    "text": "ازان باز جویم همی نام تو"
  },
  {
    "poem_id": 87996,
    "vorder": 102,
    "position": 1,
    "text": "که پیدا کنم در جهان کام تو"
  },
  {
    "poem_id": 87996,
    "vorder": 103,
    "position": 0,
    "text": "کنون گر بگویی مرا نام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 104,
    "position": 1,
    "text": "شوم شاد دل سوی آرام خویش"
  },
  {
    "poem_id": 87996,
    "vorder": 105,
    "position": 0,
    "text": "همه هرچ گفتی بدین رزمگاه"
  },
  {
    "poem_id": 87996,
    "vorder": 106,
    "position": 1,
    "text": "یکایک بگویم به پیش سپاه"
  },
  {
    "poem_id": 87996,
    "vorder": 107,
    "position": 0,
    "text": "همان پیش منشور و خاقان چین"
  },
  {
    "poem_id": 87996,
    "vorder": 108,
    "position": 1,
    "text": "بزرگان و گردان توران زمین"
  },
  {
    "poem_id": 87996,
    "vorder": 109,
    "position": 0,
    "text": "بدو گفت رستم که نامم مجوی"
  },
  {
    "poem_id": 87996,
    "vorder": 110,
    "position": 1,
    "text": "ز من هرچ دیدی بدیشان بگوی"
  },
  {
    "poem_id": 87996,
    "vorder": 111,
    "position": 0,
    "text": "ز پیران مرا دل بسوزد همی"
  },
  {
    "poem_id": 87996,
    "vorder": 112,
    "position": 1,
    "text": "ز مهرش روان برفروزد همی"
  },
  {
    "poem_id": 87996,
    "vorder": 113,
    "position": 0,
    "text": "ز خون سیاوش جگرخسته اوست"
  },
  {
    "poem_id": 87996,
    "vorder": 114,
    "position": 1,
    "text": "ز ترکان کنون راد و آهسته اوست"
  },
  {
    "poem_id": 87996,
    "vorder": 115,
    "position": 0,
    "text": "سوی من فرستش هم اکنون دمان"
  },
  {
    "poem_id": 87996,
    "vorder": 116,
    "position": 1,
    "text": "ببینیم تا بر چه گردد زمان"
  },
  {
    "poem_id": 87996,
    "vorder": 117,
    "position": 0,
    "text": "بدو گفت هومان که ای سرفراز"
  },
  {
    "poem_id": 87996,
    "vorder": 118,
    "position": 1,
    "text": "بدیدار پیرانت آمد نیاز"
  },
  {
    "poem_id": 87996,
    "vorder": 119,
    "position": 0,
    "text": "چه دانی تو پیران و کلباد را"
  },
  {
    "poem_id": 87996,
    "vorder": 120,
    "position": 1,
    "text": "گروی زره را و پولاد را"
  },
  {
    "poem_id": 87996,
    "vorder": 121,
    "position": 0,
    "text": "بدو گفت چندین چه پیچی سُخُن"
  },
  {
    "poem_id": 87996,
    "vorder": 122,
    "position": 1,
    "text": "سر آب را سوی بالا مکن"
  },
  {
    "poem_id": 87996,
    "vorder": 123,
    "position": 0,
    "text": "نبینی که پیکار چندین سپاه"
  },
  {
    "poem_id": 87996,
    "vorder": 124,
    "position": 1,
    "text": "بدویست و زو آمد این رزمگاه"
  },
  {
    "poem_id": 87996,
    "vorder": 125,
    "position": 0,
    "text": "بشد تیز هومان هم اندر زمان"
  },
  {
    "poem_id": 87996,
    "vorder": 126,
    "position": 1,
    "text": "شده گونه از روی و آمد دمان"
  },
  {
    "poem_id": 87996,
    "vorder": 127,
    "position": 0,
    "text": "به پیران چنین گفت کای نیک بخت"
  },
  {
    "poem_id": 87996,
    "vorder": 128,
    "position": 1,
    "text": "بد افتاد ما را ازین کار سخت"
  },
  {
    "poem_id": 87996,
    "vorder": 129,
    "position": 0,
    "text": "که این شیردل رستم زابلیست"
  },
  {
    "poem_id": 87996,
    "vorder": 130,
    "position": 1,
    "text": "برین لشکر اکنون بباید گریست"
  },
  {
    "poem_id": 87996,
    "vorder": 131,
    "position": 0,
    "text": "که هرگز نتابند با او به جنگ"
  },
  {
    "poem_id": 87996,
    "vorder": 132,
    "position": 1,
    "text": "به خشکی پلنگ و به دریا نهنگ"
  },
  {
    "poem_id": 87996,
    "vorder": 133,
    "position": 0,
    "text": "سخن گفت و بشنید پاسخ بسی"
  },
  {
    "poem_id": 87996,
    "vorder": 134,
    "position": 1,
    "text": "همی یاد کرد از بد هر کسی"
  },
  {
    "poem_id": 87996,
    "vorder": 135,
    "position": 0,
    "text": "نخست ای برادر مرا نام برد"
  },
  {
    "poem_id": 87996,
    "vorder": 136,
    "position": 1,
    "text": "ز کین سیاوش بسی برشمرد"
  },
  {
    "poem_id": 87996,
    "vorder": 137,
    "position": 0,
    "text": "ز کار گذشته بسی کرد یاد"
  },
  {
    "poem_id": 87996,
    "vorder": 138,
    "position": 1,
    "text": "ز پیران و گردان ویسه‌نژاد"
  },
  {
    "poem_id": 87996,
    "vorder": 139,
    "position": 0,
    "text": "ز بهرام وز تخم گودرزیان"
  },
  {
    "poem_id": 87996,
    "vorder": 140,
    "position": 1,
    "text": "ز هر کس که آمد بریشان زیان"
  },
  {
    "poem_id": 87996,
    "vorder": 141,
    "position": 0,
    "text": "بجز بر تو بر کس ندیدمش مهر"
  },
  {
    "poem_id": 87996,
    "vorder": 142,
    "position": 1,
    "text": "فراوان سخن گفت و نگشاد چهر"
  },
  {
    "poem_id": 87996,
    "vorder": 143,
    "position": 0,
    "text": "ازین لشکر اکنون ترا خواسته‌ست"
  },
  {
    "poem_id": 87996,
    "vorder": 144,
    "position": 1,
    "text": "ندانم که بر دل چه آراسته‌ست"
  },
  {
    "poem_id": 87996,
    "vorder": 145,
    "position": 0,
    "text": "برو تا ببینیش نیزه به دست"
  },
  {
    "poem_id": 87996,
    "vorder": 146,
    "position": 1,
    "text": "تو گویی که بر کوه دارد نشست"
  },
  {
    "poem_id": 87996,
    "vorder": 147,
    "position": 0,
    "text": "ابا جوشن و ترگ و ببر بیان"
  },
  {
    "poem_id": 87996,
    "vorder": 148,
    "position": 1,
    "text": "به زیر اندرون ژنده پیلی ژیان"
  },
  {
    "poem_id": 87996,
    "vorder": 149,
    "position": 0,
    "text": "ببینی که من زین نجستم دروغ"
  },
  {
    "poem_id": 87996,
    "vorder": 150,
    "position": 1,
    "text": "همی گیرد آتش ز تیغش فروغ"
  },
  {
    "poem_id": 87996,
    "vorder": 151,
    "position": 0,
    "text": "ترا تا نبیند نجنبد ز جای"
  },
  {
    "poem_id": 87996,
    "vorder": 152,
    "position": 1,
    "text": "ز بهر تو مانده‌ست زان سان به پای"
  },
  {
    "poem_id": 87996,
    "vorder": 153,
    "position": 0,
    "text": "چو بینیش با او سخن نرم گوی"
  },
  {
    "poem_id": 87996,
    "vorder": 154,
    "position": 1,
    "text": "برهنه مکن تیغ و منمای روی"
  },
  {
    "poem_id": 87996,
    "vorder": 155,
    "position": 0,
    "text": "بدو گفت پیران که ای رزمساز"
  },
  {
    "poem_id": 87996,
    "vorder": 156,
    "position": 1,
    "text": "بترسم که روز بد آید فراز"
  },
  {
    "poem_id": 87996,
    "vorder": 157,
    "position": 0,
    "text": "گر ایدونک این تیغ‌زن رستمست"
  },
  {
    "poem_id": 87996,
    "vorder": 158,
    "position": 1,
    "text": "بدین دشت ما را گه ماتمست"
  },
  {
    "poem_id": 87996,
    "vorder": 159,
    "position": 0,
    "text": "بر آتش بسوزد بر و بوم ما"
  },
  {
    "poem_id": 87996,
    "vorder": 160,
    "position": 1,
    "text": "ندانم چه کرد اختر شوم ما"
  },
  {
    "poem_id": 87996,
    "vorder": 161,
    "position": 0,
    "text": "بشد پیش خاقان پر از آب چشم"
  },
  {
    "poem_id": 87996,
    "vorder": 162,
    "position": 1,
    "text": "جگر خسته و دل پر از درد و خشم"
  },
  {
    "poem_id": 87996,
    "vorder": 163,
    "position": 0,
    "text": "بدو گفت کای شاه تندی مکن"
  },
  {
    "poem_id": 87996,
    "vorder": 164,
    "position": 1,
    "text": "که اکنون دگرگونه گشت این سُخُن"
  },
  {
    "poem_id": 87996,
    "vorder": 165,
    "position": 0,
    "text": "چو کاموس گو را سرآمد زمان"
  },
  {
    "poem_id": 87996,
    "vorder": 166,
    "position": 1,
    "text": "همانگاه برد این دل من گمان"
  },
  {
    "poem_id": 87996,
    "vorder": 167,
    "position": 0,
    "text": "که این بارهٔ آهنین رستمست"
  },
  {
    "poem_id": 87996,
    "vorder": 168,
    "position": 1,
    "text": "که خام کمندش خم اندر خمست"
  },
  {
    "poem_id": 87996,
    "vorder": 169,
    "position": 0,
    "text": "گر افراسیاب آید اکنون چو آب"
  },
  {
    "poem_id": 87996,
    "vorder": 170,
    "position": 1,
    "text": "نبینند جز سهم او را به خواب"
  },
  {
    "poem_id": 87996,
    "vorder": 171,
    "position": 0,
    "text": "ازو دیو سیر اید اندر نبرد"
  },
  {
    "poem_id": 87996,
    "vorder": 172,
    "position": 1,
    "text": "چه یک مرد با او چه یک دشت مرد"
  },
  {
    "poem_id": 87996,
    "vorder": 173,
    "position": 0,
    "text": "به زابلستان چند پرمایه بود"
  },
  {
    "poem_id": 87996,
    "vorder": 174,
    "position": 1,
    "text": "سیاوش را آن زمان دایه بود"
  },
  {
    "poem_id": 87996,
    "vorder": 175,
    "position": 0,
    "text": "پدروار با درد جنگ آورد"
  },
  {
    "poem_id": 87996,
    "vorder": 176,
    "position": 1,
    "text": "جهان بر جهاندار تنگ آورد"
  },
  {
    "poem_id": 87996,
    "vorder": 177,
    "position": 0,
    "text": "شوم بنگرم تا چه خواهد همی"
  },
  {
    "poem_id": 87996,
    "vorder": 178,
    "position": 1,
    "text": "که از غم روانم بکاهد همی"
  },
  {
    "poem_id": 87996,
    "vorder": 179,
    "position": 0,
    "text": "بدو گفت خاقان برو پیش اوی"
  },
  {
    "poem_id": 87996,
    "vorder": 180,
    "position": 1,
    "text": "چنانچون بباید سخن نرم گوی"
  },
  {
    "poem_id": 87996,
    "vorder": 181,
    "position": 0,
    "text": "اگر آشتی خواهد و دستگاه"
  },
  {
    "poem_id": 87996,
    "vorder": 182,
    "position": 1,
    "text": "چه باید برین دشت رنج سپاه"
  },
  {
    "poem_id": 87996,
    "vorder": 183,
    "position": 0,
    "text": "بسی هدیه بپذیر و پس باز گرد"
  },
  {
    "poem_id": 87996,
    "vorder": 184,
    "position": 1,
    "text": "سزد گر نجوییم چندین نبرد"
  },
  {
    "poem_id": 87996,
    "vorder": 185,
    "position": 0,
    "text": "وگر زیر چرم پلنگ اندرست"
  },
  {
    "poem_id": 87996,
    "vorder": 186,
    "position": 1,
    "text": "همانا که رایش به جنگ اندرست"
  },
  {
    "poem_id": 87996,
    "vorder": 187,
    "position": 0,
    "text": "همه یکسره نیز جنگ آوریم"
  },
  {
    "poem_id": 87996,
    "vorder": 188,
    "position": 1,
    "text": "برو دشت پیکار تنگ آوریم"
  },
  {
    "poem_id": 87996,
    "vorder": 189,
    "position": 0,
    "text": "همه پشت را سوی یزدان کنیم"
  },
  {
    "poem_id": 87996,
    "vorder": 190,
    "position": 1,
    "text": "به نیروی او رزم شیران کنیم"
  },
  {
    "poem_id": 87996,
    "vorder": 191,
    "position": 0,
    "text": "هم او را تن از آهن و روی نیست"
  },
  {
    "poem_id": 87996,
    "vorder": 192,
    "position": 1,
    "text": "جز از خون وز گوشت وز موی نیست"
  },
  {
    "poem_id": 87996,
    "vorder": 193,
    "position": 0,
    "text": "نه اندر هوا باشد او را نبرد"
  },
  {
    "poem_id": 87996,
    "vorder": 194,
    "position": 1,
    "text": "دلت را چه سوزی به تیمار و درد"
  },
  {
    "poem_id": 87996,
    "vorder": 195,
    "position": 0,
    "text": "چنان دان که گر سنگ و آهن خورد"
  },
  {
    "poem_id": 87996,
    "vorder": 196,
    "position": 1,
    "text": "همان تیر و ژوپین برو بگذرد"
  },
  {
    "poem_id": 87996,
    "vorder": 197,
    "position": 0,
    "text": "به هر مرد ازیشان ز ما سیصدست"
  },
  {
    "poem_id": 87996,
    "vorder": 198,
    "position": 1,
    "text": "درین رزمگه غم کشیدن بدست"
  },
  {
    "poem_id": 87996,
    "vorder": 199,
    "position": 0,
    "text": "همین زابلی نامبردار مرد"
  },
  {
    "poem_id": 87996,
    "vorder": 200,
    "position": 1,
    "text": "ز پیلی فزون نیست گاه نبرد"
  },
  {
    "poem_id": 87996,
    "vorder": 201,
    "position": 0,
    "text": "یکی پیلبازی نمایم بدوی"
  },
  {
    "poem_id": 87996,
    "vorder": 202,
    "position": 1,
    "text": "کزان پس نیارد سوی جنگ روی"
  }
]