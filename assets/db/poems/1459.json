[
  {
    "poem_id": 1459,
    "vorder": 1,
    "position": 0,
    "text": "اگر تندبادی براید ز کنج"
  },
  {
    "poem_id": 1459,
    "vorder": 2,
    "position": 1,
    "text": "بخاک افگند نارسیده ترنج"
  },
  {
    "poem_id": 1459,
    "vorder": 3,
    "position": 0,
    "text": "ستمکاره خوانیمش ار دادگر"
  },
  {
    "poem_id": 1459,
    "vorder": 4,
    "position": 1,
    "text": "هنرمند دانیمش ار بی‌هنر"
  },
  {
    "poem_id": 1459,
    "vorder": 5,
    "position": 0,
    "text": "اگر مرگ دادست بیداد چیست"
  },
  {
    "poem_id": 1459,
    "vorder": 6,
    "position": 1,
    "text": "ز داد این همه بانگ و فریاد چیست"
  },
  {
    "poem_id": 1459,
    "vorder": 7,
    "position": 0,
    "text": "ازین راز جان تو آگاه نیست"
  },
  {
    "poem_id": 1459,
    "vorder": 8,
    "position": 1,
    "text": "بدین پرده اندر ترا راه نیست"
  },
  {
    "poem_id": 1459,
    "vorder": 9,
    "position": 0,
    "text": "همه تا در آز رفته فراز"
  },
  {
    "poem_id": 1459,
    "vorder": 10,
    "position": 1,
    "text": "به کس بر نشد این در راز باز"
  },
  {
    "poem_id": 1459,
    "vorder": 11,
    "position": 0,
    "text": "برفتن مگر بهتر آیدش جای"
  },
  {
    "poem_id": 1459,
    "vorder": 12,
    "position": 1,
    "text": "چو آرام یابد به دیگر سرای"
  },
  {
    "poem_id": 1459,
    "vorder": 13,
    "position": 0,
    "text": "دم مرگ چون آتش هولناک"
  },
  {
    "poem_id": 1459,
    "vorder": 14,
    "position": 1,
    "text": "ندارد ز برنا و فرتوت باک"
  },
  {
    "poem_id": 1459,
    "vorder": 15,
    "position": 0,
    "text": "درین جای رفتن نه جای درنگ"
  },
  {
    "poem_id": 1459,
    "vorder": 16,
    "position": 1,
    "text": "بر اسپ فنا گر کشد مرگ تنگ"
  },
  {
    "poem_id": 1459,
    "vorder": 17,
    "position": 0,
    "text": "چنان دان که دادست و بیداد نیست"
  },
  {
    "poem_id": 1459,
    "vorder": 18,
    "position": 1,
    "text": "چو داد آمدش جای فریاد نیست"
  },
  {
    "poem_id": 1459,
    "vorder": 19,
    "position": 0,
    "text": "جوانی و پیری به نزدیک مرگ"
  },
  {
    "poem_id": 1459,
    "vorder": 20,
    "position": 1,
    "text": "یکی دان چو اندر بدن نیست برگ"
  },
  {
    "poem_id": 1459,
    "vorder": 21,
    "position": 0,
    "text": "دل از نور ایمان گر آگنده‌ای"
  },
  {
    "poem_id": 1459,
    "vorder": 22,
    "position": 1,
    "text": "ترا خامشی به که تو بنده‌ای"
  },
  {
    "poem_id": 1459,
    "vorder": 23,
    "position": 0,
    "text": "برین کار یزدان ترا راز نیست"
  },
  {
    "poem_id": 1459,
    "vorder": 24,
    "position": 1,
    "text": "اگر جانت با دیو انباز نیست"
  },
  {
    "poem_id": 1459,
    "vorder": 25,
    "position": 0,
    "text": "به گیتی دران کوش چون بگذری"
  },
  {
    "poem_id": 1459,
    "vorder": 26,
    "position": 1,
    "text": "سرانجام نیکی بر خود بری"
  },
  {
    "poem_id": 1459,
    "vorder": 27,
    "position": 0,
    "text": "کنون رزم سهراب رانم نخست"
  },
  {
    "poem_id": 1459,
    "vorder": 28,
    "position": 1,
    "text": "ازان کین که او با پدر چون بجست"
  }
]