[
  {
    "poem_id": 88037,
    "vorder": 1,
    "position": 0,
    "text": "سر نامه کرد آفرین از نخست"
  },
  {
    "poem_id": 88037,
    "vorder": 2,
    "position": 1,
    "text": "دگر پاسخ آورد یکسر درست"
  },
  {
    "poem_id": 88037,
    "vorder": 3,
    "position": 0,
    "text": "که بر خواندم نامه را سر به سر"
  },
  {
    "poem_id": 88037,
    "vorder": 4,
    "position": 1,
    "text": "شنیدیم گفتار تو در به در"
  },
  {
    "poem_id": 88037,
    "vorder": 5,
    "position": 0,
    "text": "رسانید رویین بر ما پیام"
  },
  {
    "poem_id": 88037,
    "vorder": 6,
    "position": 1,
    "text": "یکایک همه هرچ بردی تو نام"
  },
  {
    "poem_id": 88037,
    "vorder": 7,
    "position": 0,
    "text": "ولیکن شگفت آمدم کار تو"
  },
  {
    "poem_id": 88037,
    "vorder": 8,
    "position": 1,
    "text": "همی ز این چنین چرب گفتار تو"
  },
  {
    "poem_id": 88037,
    "vorder": 9,
    "position": 0,
    "text": "دلت با زبان هیچ همسایه نیست"
  },
  {
    "poem_id": 88037,
    "vorder": 10,
    "position": 1,
    "text": "روان ترا از خرد مایه نیست"
  },
  {
    "poem_id": 88037,
    "vorder": 11,
    "position": 0,
    "text": "به هرجای چربی به کار آوری"
  },
  {
    "poem_id": 88037,
    "vorder": 12,
    "position": 1,
    "text": "چنین تو سخن پرنگار آوری"
  },
  {
    "poem_id": 88037,
    "vorder": 13,
    "position": 0,
    "text": "کسی را که از بن نباشد خرد"
  },
  {
    "poem_id": 88037,
    "vorder": 14,
    "position": 1,
    "text": "گمان بر تو بر مهربانی برد"
  },
  {
    "poem_id": 88037,
    "vorder": 15,
    "position": 0,
    "text": "چو شوره زمینی که از دور آب"
  },
  {
    "poem_id": 88037,
    "vorder": 16,
    "position": 1,
    "text": "نماید چو تابد بر او آفتاب"
  },
  {
    "poem_id": 88037,
    "vorder": 17,
    "position": 0,
    "text": "ولیکن نه گاه فریبست و بند"
  },
  {
    "poem_id": 88037,
    "vorder": 18,
    "position": 1,
    "text": "که هنگام گرزست و تیغ و کمند"
  },
  {
    "poem_id": 88037,
    "vorder": 19,
    "position": 0,
    "text": "مرا با تو جز کین و پیکار نیست"
  },
  {
    "poem_id": 88037,
    "vorder": 20,
    "position": 1,
    "text": "گه پاسخ و روز گفتار نیست"
  },
  {
    "poem_id": 88037,
    "vorder": 21,
    "position": 0,
    "text": "نگر تا چه سان گردد اکنون سپهر"
  },
  {
    "poem_id": 88037,
    "vorder": 22,
    "position": 1,
    "text": "نه جای فریبست و پیوند و مهر"
  },
  {
    "poem_id": 88037,
    "vorder": 23,
    "position": 0,
    "text": "کرا داد خواهد جهاندار زور"
  },
  {
    "poem_id": 88037,
    "vorder": 24,
    "position": 1,
    "text": "کرا بردهد بخت پیروز هور"
  },
  {
    "poem_id": 88037,
    "vorder": 25,
    "position": 0,
    "text": "ولیکن بدین گفته پاسخ شنو"
  },
  {
    "poem_id": 88037,
    "vorder": 26,
    "position": 1,
    "text": "خرد یاد کن بخت را پیشرو"
  },
  {
    "poem_id": 88037,
    "vorder": 27,
    "position": 0,
    "text": "نخست آنک گفتی که از مهر نیز"
  },
  {
    "poem_id": 88037,
    "vorder": 28,
    "position": 1,
    "text": "ز یزدان وز گردش رستخیز"
  },
  {
    "poem_id": 88037,
    "vorder": 29,
    "position": 0,
    "text": "نخواهم که آید مرا پیش جنگ"
  },
  {
    "poem_id": 88037,
    "vorder": 30,
    "position": 1,
    "text": "دلم گشت از این کار بیداد تنگ"
  },
  {
    "poem_id": 88037,
    "vorder": 31,
    "position": 0,
    "text": "دلت با زبان آشنایی نداشت"
  },
  {
    "poem_id": 88037,
    "vorder": 32,
    "position": 1,
    "text": "بدان گه که این گفته بر دل گماشت"
  },
  {
    "poem_id": 88037,
    "vorder": 33,
    "position": 0,
    "text": "اگر داد بودی به دلت اندرون"
  },
  {
    "poem_id": 88037,
    "vorder": 34,
    "position": 1,
    "text": "ترا پیشدستی نبودی به خون"
  },
  {
    "poem_id": 88037,
    "vorder": 35,
    "position": 0,
    "text": "کز آغاز کار اندر آمد نخست"
  },
  {
    "poem_id": 88037,
    "vorder": 36,
    "position": 1,
    "text": "نبودی به خون ریختن هیچ سست"
  },
  {
    "poem_id": 88037,
    "vorder": 37,
    "position": 0,
    "text": "نخستین که آمد به پیش تو گیو"
  },
  {
    "poem_id": 88037,
    "vorder": 38,
    "position": 1,
    "text": "از ایران هشیوار مردان نیو"
  },
  {
    "poem_id": 88037,
    "vorder": 39,
    "position": 0,
    "text": "بسازیده مر جنگ را لشکری"
  },
  {
    "poem_id": 88037,
    "vorder": 40,
    "position": 1,
    "text": "ز کشور دمان تا دگر کشوری"
  },
  {
    "poem_id": 88037,
    "vorder": 41,
    "position": 0,
    "text": "تو کردی همه جنگ را دست پیش"
  },
  {
    "poem_id": 88037,
    "vorder": 42,
    "position": 1,
    "text": "سپه را تو برکندی از جای خویش"
  },
  {
    "poem_id": 88037,
    "vorder": 43,
    "position": 0,
    "text": "خرد، ار پس آمد تو پیش آمدی"
  },
  {
    "poem_id": 88037,
    "vorder": 44,
    "position": 1,
    "text": "به فرجام آرام بیش آمدی"
  },
  {
    "poem_id": 88037,
    "vorder": 45,
    "position": 0,
    "text": "ولیکن سرشت بد و خوی بد"
  },
  {
    "poem_id": 88037,
    "vorder": 46,
    "position": 1,
    "text": "ترا نگذراند به راه خرد"
  },
  {
    "poem_id": 88037,
    "vorder": 47,
    "position": 0,
    "text": "بدی خود بدان تخمه در گوهرست"
  },
  {
    "poem_id": 88037,
    "vorder": 48,
    "position": 1,
    "text": "به بد کردن آن تخمه اندر خورست"
  },
  {
    "poem_id": 88037,
    "vorder": 49,
    "position": 0,
    "text": "شنیدی که بر ایرج نیک‌بخت"
  },
  {
    "poem_id": 88037,
    "vorder": 50,
    "position": 1,
    "text": "چه آمد ز تور از پی تاج و تخت"
  },
  {
    "poem_id": 88037,
    "vorder": 51,
    "position": 0,
    "text": "چو از تور و سلم اندر آمد زمین"
  },
  {
    "poem_id": 88037,
    "vorder": 52,
    "position": 1,
    "text": "سراسر بگسترد بیداد و کین"
  },
  {
    "poem_id": 88037,
    "vorder": 53,
    "position": 0,
    "text": "فریدون که از درد دل روز و شب"
  },
  {
    "poem_id": 88037,
    "vorder": 54,
    "position": 1,
    "text": "گشادی به نفرین ایشان دو لب"
  },
  {
    "poem_id": 88037,
    "vorder": 55,
    "position": 0,
    "text": "به افراسیاب آمد آن مهر بد"
  },
  {
    "poem_id": 88037,
    "vorder": 56,
    "position": 1,
    "text": "از آن نامداران اندک خرد"
  },
  {
    "poem_id": 88037,
    "vorder": 57,
    "position": 0,
    "text": "ز سر با منوچهر نو کین نهاد"
  },
  {
    "poem_id": 88037,
    "vorder": 58,
    "position": 1,
    "text": "همیدون ابا نوذر و کیقباد"
  },
  {
    "poem_id": 88037,
    "vorder": 59,
    "position": 0,
    "text": "به کاووس کی کرد خود آنچ کرد"
  },
  {
    "poem_id": 88037,
    "vorder": 60,
    "position": 1,
    "text": "برآورد از ایران آباد گرد"
  },
  {
    "poem_id": 88037,
    "vorder": 61,
    "position": 0,
    "text": "از آن پس به کین سیاووش باز"
  },
  {
    "poem_id": 88037,
    "vorder": 62,
    "position": 1,
    "text": "فگند این چنین کینهٔ نو دراز"
  },
  {
    "poem_id": 88037,
    "vorder": 63,
    "position": 0,
    "text": "نیامد بدانگه ترا داد یاد"
  },
  {
    "poem_id": 88037,
    "vorder": 64,
    "position": 1,
    "text": "که او بی‌گنه جان شیرین بداد"
  },
  {
    "poem_id": 88037,
    "vorder": 65,
    "position": 0,
    "text": "چه مایه بزرگان که از تخت و گاه"
  },
  {
    "poem_id": 88037,
    "vorder": 66,
    "position": 1,
    "text": "از ایران شدند اندر این کین تباه"
  },
  {
    "poem_id": 88037,
    "vorder": 67,
    "position": 0,
    "text": "و دیگر که گفتی که با پیر سر"
  },
  {
    "poem_id": 88037,
    "vorder": 68,
    "position": 1,
    "text": "به خون ریختن کس نبندد کمر"
  },
  {
    "poem_id": 88037,
    "vorder": 69,
    "position": 0,
    "text": "بدان ای جهاندیدهٔ پرفریب"
  },
  {
    "poem_id": 88037,
    "vorder": 70,
    "position": 1,
    "text": "به هر کار دیده فراز و نشیب"
  },
  {
    "poem_id": 88037,
    "vorder": 71,
    "position": 0,
    "text": "که یزدان مرا زندگانی دراز"
  },
  {
    "poem_id": 88037,
    "vorder": 72,
    "position": 1,
    "text": "بدان داد با بخت گردن‌فراز"
  },
  {
    "poem_id": 88037,
    "vorder": 73,
    "position": 0,
    "text": "که از شهر توران به روز نبرد"
  },
  {
    "poem_id": 88037,
    "vorder": 74,
    "position": 1,
    "text": "ز کینه برآرم به خورشید گرد"
  },
  {
    "poem_id": 88037,
    "vorder": 75,
    "position": 0,
    "text": "بترسم همی زانک یزدان من"
  },
  {
    "poem_id": 88037,
    "vorder": 76,
    "position": 1,
    "text": "ز تن بگسلاند مگر جان من"
  },
  {
    "poem_id": 88037,
    "vorder": 77,
    "position": 0,
    "text": "من این کینه را ناوریده به جای"
  },
  {
    "poem_id": 88037,
    "vorder": 78,
    "position": 1,
    "text": "بر و بومتان ناسپرده به پای"
  },
  {
    "poem_id": 88037,
    "vorder": 79,
    "position": 0,
    "text": "سه دیگر که گفتی ز یزدان پاک"
  },
  {
    "poem_id": 88037,
    "vorder": 80,
    "position": 1,
    "text": "نبینم به دلت اندرون بیم و باک"
  },
  {
    "poem_id": 88037,
    "vorder": 81,
    "position": 0,
    "text": "ندانی کز این خیره خون ریختن"
  },
  {
    "poem_id": 88037,
    "vorder": 82,
    "position": 1,
    "text": "گرفتار کردی به فرجام تن"
  },
  {
    "poem_id": 88037,
    "vorder": 83,
    "position": 0,
    "text": "من اکنون بدین خوب گفتار تو"
  },
  {
    "poem_id": 88037,
    "vorder": 84,
    "position": 1,
    "text": "اگر باز گردم ز پیکار تو"
  },
  {
    "poem_id": 88037,
    "vorder": 85,
    "position": 0,
    "text": "به هنگام پرسش ز من کردگار"
  },
  {
    "poem_id": 88037,
    "vorder": 86,
    "position": 1,
    "text": "بپرسد از این گردش روزگار"
  },
  {
    "poem_id": 88037,
    "vorder": 87,
    "position": 0,
    "text": "که سالاری و گنج و مردانگی"
  },
  {
    "poem_id": 88037,
    "vorder": 88,
    "position": 1,
    "text": "ترا دادم و زور و فرزانگی"
  },
  {
    "poem_id": 88037,
    "vorder": 89,
    "position": 0,
    "text": "به کین سیاوش کمر بر میان"
  },
  {
    "poem_id": 88037,
    "vorder": 90,
    "position": 1,
    "text": "نبستی چرا پیش ایرانیان"
  },
  {
    "poem_id": 88037,
    "vorder": 91,
    "position": 0,
    "text": "به هفتاد خون گرامی پسر"
  },
  {
    "poem_id": 88037,
    "vorder": 92,
    "position": 1,
    "text": "بپرسد ز من داور دادگر"
  },
  {
    "poem_id": 88037,
    "vorder": 93,
    "position": 0,
    "text": "ز پاسخ به پیش جهان‌آفرین"
  },
  {
    "poem_id": 88037,
    "vorder": 94,
    "position": 1,
    "text": "چه گویم چرا بازگشتم ز کین"
  },
  {
    "poem_id": 88037,
    "vorder": 95,
    "position": 0,
    "text": "ز کار سیاوش چهارم سخن"
  },
  {
    "poem_id": 88037,
    "vorder": 96,
    "position": 1,
    "text": "که افگندی ای پیر سالار بن"
  },
  {
    "poem_id": 88037,
    "vorder": 97,
    "position": 0,
    "text": "که گفتی ز بهر تنی گشته خاک"
  },
  {
    "poem_id": 88037,
    "vorder": 98,
    "position": 1,
    "text": "نشاید ستد زنده را جان پاک"
  },
  {
    "poem_id": 88037,
    "vorder": 99,
    "position": 0,
    "text": "تو بشناس کین زشت کردارها"
  },
  {
    "poem_id": 88037,
    "vorder": 100,
    "position": 1,
    "text": "به دل پر ز هر گونه آزارها"
  },
  {
    "poem_id": 88037,
    "vorder": 101,
    "position": 0,
    "text": "که با شهر ایران شما کرده‌اید"
  },
  {
    "poem_id": 88037,
    "vorder": 102,
    "position": 1,
    "text": "چه مایه کیان را بیازرده‌اید"
  },
  {
    "poem_id": 88037,
    "vorder": 103,
    "position": 0,
    "text": "چه پیمان شکستن چه کین ساختن"
  },
  {
    "poem_id": 88037,
    "vorder": 104,
    "position": 1,
    "text": "همیشه به سوی بدی تاختن"
  },
  {
    "poem_id": 88037,
    "vorder": 105,
    "position": 0,
    "text": "چو یاد آورم چون کنم آشتی"
  },
  {
    "poem_id": 88037,
    "vorder": 106,
    "position": 1,
    "text": "که نیکی سراسر بدی کاشتی"
  },
  {
    "poem_id": 88037,
    "vorder": 107,
    "position": 0,
    "text": "به پنجم که گفتی که پیمان کنم"
  },
  {
    "poem_id": 88037,
    "vorder": 108,
    "position": 1,
    "text": "ز توران سران را گروگان کنم"
  },
  {
    "poem_id": 88037,
    "vorder": 109,
    "position": 0,
    "text": "به نزدیک خسرو فرستیم گنج"
  },
  {
    "poem_id": 88037,
    "vorder": 110,
    "position": 1,
    "text": "ببندیم بر خویشتن راه رنج"
  },
  {
    "poem_id": 88037,
    "vorder": 111,
    "position": 0,
    "text": "بدان ای نگهبان توران سپاه"
  },
  {
    "poem_id": 88037,
    "vorder": 112,
    "position": 1,
    "text": "که فرمان جز اینست ما را ز شاه"
  },
  {
    "poem_id": 88037,
    "vorder": 113,
    "position": 0,
    "text": "مرا جنگ فرمود و آویختن"
  },
  {
    "poem_id": 88037,
    "vorder": 114,
    "position": 1,
    "text": "به کین سیاووش خون ریختن"
  },
  {
    "poem_id": 88037,
    "vorder": 115,
    "position": 0,
    "text": "چو فرمان خسرو نیارم به جای"
  },
  {
    "poem_id": 88037,
    "vorder": 116,
    "position": 1,
    "text": "روان شرم دارد به دیگر سرای"
  },
  {
    "poem_id": 88037,
    "vorder": 117,
    "position": 0,
    "text": "ور اومید داری که خسرو به مهر"
  },
  {
    "poem_id": 88037,
    "vorder": 118,
    "position": 1,
    "text": "گشاید بر این گفتها بر تو چهر"
  },
  {
    "poem_id": 88037,
    "vorder": 119,
    "position": 0,
    "text": "گروگان و آن خواسته هرچ هست"
  },
  {
    "poem_id": 88037,
    "vorder": 120,
    "position": 1,
    "text": "چو لهاک و رویین خسروپرست"
  },
  {
    "poem_id": 88037,
    "vorder": 121,
    "position": 0,
    "text": "گسی کن بزودی به نزدیک شاه"
  },
  {
    "poem_id": 88037,
    "vorder": 122,
    "position": 1,
    "text": "سوی شهر ایران گشادست راه"
  },
  {
    "poem_id": 88037,
    "vorder": 123,
    "position": 0,
    "text": "ششم شهر ایران که کردی تو یاد"
  },
  {
    "poem_id": 88037,
    "vorder": 124,
    "position": 1,
    "text": "بر و بوم آباد فرخ‌نژاد"
  },
  {
    "poem_id": 88037,
    "vorder": 125,
    "position": 0,
    "text": "سپاریم گفتی به خسرو همه"
  },
  {
    "poem_id": 88037,
    "vorder": 126,
    "position": 1,
    "text": "ز هر سو بر خویش خوانم رمه"
  },
  {
    "poem_id": 88037,
    "vorder": 127,
    "position": 0,
    "text": "ترا کرد یزدان از آن بی‌نیاز"
  },
  {
    "poem_id": 88037,
    "vorder": 128,
    "position": 1,
    "text": "گر آگه نه‌ای تا گشاییم راز"
  },
  {
    "poem_id": 88037,
    "vorder": 129,
    "position": 0,
    "text": "سوی باختر تا به مرز خزر"
  },
  {
    "poem_id": 88037,
    "vorder": 130,
    "position": 1,
    "text": "همه گشت لهراسب را سر به سر"
  },
  {
    "poem_id": 88037,
    "vorder": 131,
    "position": 0,
    "text": "سوی نیمروز اندرون تا بسند"
  },
  {
    "poem_id": 88037,
    "vorder": 132,
    "position": 1,
    "text": "جهان شد به کردار روی پرند"
  },
  {
    "poem_id": 88037,
    "vorder": 133,
    "position": 0,
    "text": "تهم رستم نیو با تیغ تیز"
  },
  {
    "poem_id": 88037,
    "vorder": 134,
    "position": 1,
    "text": "برآورد از ایشان دم رستخیز"
  },
  {
    "poem_id": 88037,
    "vorder": 135,
    "position": 0,
    "text": "سر هندوان با درفش سیاه"
  },
  {
    "poem_id": 88037,
    "vorder": 136,
    "position": 1,
    "text": "فرستاد رستم به نزدیک شاه"
  },
  {
    "poem_id": 88037,
    "vorder": 137,
    "position": 0,
    "text": "دهستان و خوارزم و آن بوم و بر"
  },
  {
    "poem_id": 88037,
    "vorder": 138,
    "position": 1,
    "text": "که ترکان برآورده بودند سر"
  },
  {
    "poem_id": 88037,
    "vorder": 139,
    "position": 0,
    "text": "بیابان از ایشان بپرداختند"
  },
  {
    "poem_id": 88037,
    "vorder": 140,
    "position": 1,
    "text": "سوی باختر تاختن ساختند"
  },
  {
    "poem_id": 88037,
    "vorder": 141,
    "position": 0,
    "text": "ببارید بر شیده اشکش تگرگ"
  },
  {
    "poem_id": 88037,
    "vorder": 142,
    "position": 1,
    "text": "فراز آوریدش به نزدیک مرگ"
  },
  {
    "poem_id": 88037,
    "vorder": 143,
    "position": 0,
    "text": "اسیران وز خواسته چند چیز"
  },
  {
    "poem_id": 88037,
    "vorder": 144,
    "position": 1,
    "text": "فرستاد نزدیک خسرو به نیز"
  },
  {
    "poem_id": 88037,
    "vorder": 145,
    "position": 0,
    "text": "وز این سو من و تو به جنگ اندریم"
  },
  {
    "poem_id": 88037,
    "vorder": 146,
    "position": 1,
    "text": "بدین مرکز نام و ننگ اندریم"
  },
  {
    "poem_id": 88037,
    "vorder": 147,
    "position": 0,
    "text": "به یک جنگ دیدی همه دستبرد"
  },
  {
    "poem_id": 88037,
    "vorder": 148,
    "position": 1,
    "text": "از این نامداران و مردان گرد"
  },
  {
    "poem_id": 88037,
    "vorder": 149,
    "position": 0,
    "text": "ور ایدونک روی اندر آری به روی"
  },
  {
    "poem_id": 88037,
    "vorder": 150,
    "position": 1,
    "text": "رهانم ترا ز این همه گفت و گوی"
  },
  {
    "poem_id": 88037,
    "vorder": 151,
    "position": 0,
    "text": "به نیروی یزدان و فرمان شاه"
  },
  {
    "poem_id": 88037,
    "vorder": 152,
    "position": 1,
    "text": "به خون غرقه گردانم این رزمگاه"
  },
  {
    "poem_id": 88037,
    "vorder": 153,
    "position": 0,
    "text": "تو ای نامور پهلوان سپاه"
  },
  {
    "poem_id": 88037,
    "vorder": 154,
    "position": 1,
    "text": "نگه کن بدین گردش هور و ماه"
  },
  {
    "poem_id": 88037,
    "vorder": 155,
    "position": 0,
    "text": "که بند سپهری فراز آمدست"
  },
  {
    "poem_id": 88037,
    "vorder": 156,
    "position": 1,
    "text": "سر بخت ترکان به گاز آمدست"
  },
  {
    "poem_id": 88037,
    "vorder": 157,
    "position": 0,
    "text": "نگر تا ز کردار بدگوهرت"
  },
  {
    "poem_id": 88037,
    "vorder": 158,
    "position": 1,
    "text": "چه آرد جهان‌آفرین بر سرت"
  },
  {
    "poem_id": 88037,
    "vorder": 159,
    "position": 0,
    "text": "زمانه ز بد دامن اندر کشید"
  },
  {
    "poem_id": 88037,
    "vorder": 160,
    "position": 1,
    "text": "مکافات بد را بد آید پدید"
  },
  {
    "poem_id": 88037,
    "vorder": 161,
    "position": 0,
    "text": "تو بندیش هشیار و بگشای گوش"
  },
  {
    "poem_id": 88037,
    "vorder": 162,
    "position": 1,
    "text": "سخن از خردمند مردم نیوش"
  },
  {
    "poem_id": 88037,
    "vorder": 163,
    "position": 0,
    "text": "بدان کین چنین لشکر نامدار"
  },
  {
    "poem_id": 88037,
    "vorder": 164,
    "position": 1,
    "text": "سواران شمشیرزن صدهزار"
  },
  {
    "poem_id": 88037,
    "vorder": 165,
    "position": 0,
    "text": "همه نامجوی و همه کینه‌خواه"
  },
  {
    "poem_id": 88037,
    "vorder": 166,
    "position": 1,
    "text": "به افسون نگردند ازین رزمگاه"
  },
  {
    "poem_id": 88037,
    "vorder": 167,
    "position": 0,
    "text": "زمانه برآمد به هفتم سخن"
  },
  {
    "poem_id": 88037,
    "vorder": 168,
    "position": 1,
    "text": "فگندی وفا را به سوگند بن"
  },
  {
    "poem_id": 88037,
    "vorder": 169,
    "position": 0,
    "text": "به پیمان مرا با تو گفتار نیست"
  },
  {
    "poem_id": 88037,
    "vorder": 170,
    "position": 1,
    "text": "خرد را روانت خریدار نیست"
  },
  {
    "poem_id": 88037,
    "vorder": 171,
    "position": 0,
    "text": "ازیراک با هرک پیمان کنی"
  },
  {
    "poem_id": 88037,
    "vorder": 172,
    "position": 1,
    "text": "وفا را به فرجام هم بشکنی"
  },
  {
    "poem_id": 88037,
    "vorder": 173,
    "position": 0,
    "text": "به سوگند تو شد سیاوش به باد"
  },
  {
    "poem_id": 88037,
    "vorder": 174,
    "position": 1,
    "text": "به گفتار بر تو کس ایمن مباد"
  },
  {
    "poem_id": 88037,
    "vorder": 175,
    "position": 0,
    "text": "نبودیش فریادرس روز درد"
  },
  {
    "poem_id": 88037,
    "vorder": 176,
    "position": 1,
    "text": "چه مایه به سختی ترا یاد کرد"
  },
  {
    "poem_id": 88037,
    "vorder": 177,
    "position": 0,
    "text": "به هشتم که گفتی مرا تاج و تخت"
  },
  {
    "poem_id": 88037,
    "vorder": 178,
    "position": 1,
    "text": "از آن تو بیشست مردی و بخت"
  },
  {
    "poem_id": 88037,
    "vorder": 179,
    "position": 0,
    "text": "همیدون فزونم به مردان و گنج"
  },
  {
    "poem_id": 88037,
    "vorder": 180,
    "position": 1,
    "text": "ولیکن دلم را ز مهرست رنج"
  },
  {
    "poem_id": 88037,
    "vorder": 181,
    "position": 0,
    "text": "من ایدون گمانم که تا این زمان"
  },
  {
    "poem_id": 88037,
    "vorder": 182,
    "position": 1,
    "text": "به جنگ آزمودی مرا بی‌گمان"
  },
  {
    "poem_id": 88037,
    "vorder": 183,
    "position": 0,
    "text": "گرم بی‌هنر یافتی روز کین"
  },
  {
    "poem_id": 88037,
    "vorder": 184,
    "position": 1,
    "text": "تو دانی کنون بازم از پس ببین"
  },
  {
    "poem_id": 88037,
    "vorder": 185,
    "position": 0,
    "text": "به فرجام گفتی ز مردان مرد"
  },
  {
    "poem_id": 88037,
    "vorder": 186,
    "position": 1,
    "text": "تنی چند بگزین ز بهر نبرد"
  },
  {
    "poem_id": 88037,
    "vorder": 187,
    "position": 0,
    "text": "من از لشکر ترک هم ز این نشان"
  },
  {
    "poem_id": 88037,
    "vorder": 188,
    "position": 1,
    "text": "بیارم سواران مردم‌کشان"
  },
  {
    "poem_id": 88037,
    "vorder": 189,
    "position": 0,
    "text": "که از مهربانی که بر لشکرم"
  },
  {
    "poem_id": 88037,
    "vorder": 190,
    "position": 1,
    "text": "نخواهم که بیداد کین گسترم"
  },
  {
    "poem_id": 88037,
    "vorder": 191,
    "position": 0,
    "text": "تو با مهربانی نهی پای پیش"
  },
  {
    "poem_id": 88037,
    "vorder": 192,
    "position": 1,
    "text": "که دانی نهان دل و رای خویش"
  },
  {
    "poem_id": 88037,
    "vorder": 193,
    "position": 0,
    "text": "بیازارد از من جهاندار شاه"
  },
  {
    "poem_id": 88037,
    "vorder": 194,
    "position": 1,
    "text": "گر از یکدگر بگسلانم سپاه"
  },
  {
    "poem_id": 88037,
    "vorder": 195,
    "position": 0,
    "text": "نهم آنک گفتی مبارز گزین"
  },
  {
    "poem_id": 88037,
    "vorder": 196,
    "position": 1,
    "text": "که با من بگردد بر این دشت کین"
  },
  {
    "poem_id": 88037,
    "vorder": 197,
    "position": 0,
    "text": "یکی لشکری پرگنه پیش من"
  },
  {
    "poem_id": 88037,
    "vorder": 198,
    "position": 1,
    "text": "پرآزار از ایشان دل انجمن"
  },
  {
    "poem_id": 88037,
    "vorder": 199,
    "position": 0,
    "text": "نباشد ز من شاه همداستان"
  },
  {
    "poem_id": 88037,
    "vorder": 200,
    "position": 1,
    "text": "کز ایشان بگردم بدین داستان"
  },
  {
    "poem_id": 88037,
    "vorder": 201,
    "position": 0,
    "text": "نخستین به انبوه زخمی چو کوه"
  },
  {
    "poem_id": 88037,
    "vorder": 202,
    "position": 1,
    "text": "بباید زدن سر بسر همگروه"
  },
  {
    "poem_id": 88037,
    "vorder": 203,
    "position": 0,
    "text": "میان دو لشکر دو صف برکشید"
  },
  {
    "poem_id": 88037,
    "vorder": 204,
    "position": 1,
    "text": "گر ایدونک پیروزی آید پدید"
  },
  {
    "poem_id": 88037,
    "vorder": 205,
    "position": 0,
    "text": "وگرنه همین نامداران مرد"
  },
  {
    "poem_id": 88037,
    "vorder": 206,
    "position": 1,
    "text": "بیاریم و سازیم جای نبرد"
  },
  {
    "poem_id": 88037,
    "vorder": 207,
    "position": 0,
    "text": "از این گفته گر بگسلی باز دل"
  },
  {
    "poem_id": 88037,
    "vorder": 208,
    "position": 1,
    "text": "من از گفتهٔ خود نیم دلگسل"
  },
  {
    "poem_id": 88037,
    "vorder": 209,
    "position": 0,
    "text": "ور ایدونک با من به آوردگاه"
  },
  {
    "poem_id": 88037,
    "vorder": 210,
    "position": 1,
    "text": "بسنده نخواهی بدن با سپاه"
  },
  {
    "poem_id": 88037,
    "vorder": 211,
    "position": 0,
    "text": "سپه خواه و یاور ز سالار خویش"
  },
  {
    "poem_id": 88037,
    "vorder": 212,
    "position": 1,
    "text": "به ژرفی نگه‌دار پیکار خویش"
  },
  {
    "poem_id": 88037,
    "vorder": 213,
    "position": 0,
    "text": "پراگنده از لشکرت خستگان"
  },
  {
    "poem_id": 88037,
    "vorder": 214,
    "position": 1,
    "text": "ز خویشان نزدیک و پیوستگان"
  },
  {
    "poem_id": 88037,
    "vorder": 215,
    "position": 0,
    "text": "بمان تا کندشان پزشکان درست"
  },
  {
    "poem_id": 88037,
    "vorder": 216,
    "position": 1,
    "text": "زمان جستن اکنون بدین کار تست"
  },
  {
    "poem_id": 88037,
    "vorder": 217,
    "position": 0,
    "text": "اگر خواهی از من زمان درنگ"
  },
  {
    "poem_id": 88037,
    "vorder": 218,
    "position": 1,
    "text": "وگر جنگ جویی بیارای جنگ"
  },
  {
    "poem_id": 88037,
    "vorder": 219,
    "position": 0,
    "text": "بدان گفتم این تا به روز نبرد"
  },
  {
    "poem_id": 88037,
    "vorder": 220,
    "position": 1,
    "text": "به ما بر بهانه نبایدت کرد"
  },
  {
    "poem_id": 88037,
    "vorder": 221,
    "position": 0,
    "text": "که ناگاه با ما به جنگ آمدی"
  },
  {
    "poem_id": 88037,
    "vorder": 222,
    "position": 1,
    "text": "کمین کردی و بی‌درنگ آمدی"
  },
  {
    "poem_id": 88037,
    "vorder": 223,
    "position": 0,
    "text": "من این کین اگر تا به صد سالیان"
  },
  {
    "poem_id": 88037,
    "vorder": 224,
    "position": 1,
    "text": "بخواهم همانست و اکنون همان"
  },
  {
    "poem_id": 88037,
    "vorder": 225,
    "position": 0,
    "text": "از این کینه برگشتن امید نیست"
  },
  {
    "poem_id": 88037,
    "vorder": 226,
    "position": 1,
    "text": "شب و روز بی‌دیدگان را یکیست"
  },
  {
    "poem_id": 88037,
    "vorder": 227,
    "position": 0,
    "text": "چو آن پاسخ نامه گشت اسپری"
  },
  {
    "poem_id": 88037,
    "vorder": 228,
    "position": 1,
    "text": "فرستاده آمد به سان پری"
  },
  {
    "poem_id": 88037,
    "vorder": 229,
    "position": 0,
    "text": "کمر بر میان با ستور نوند"
  },
  {
    "poem_id": 88037,
    "vorder": 230,
    "position": 1,
    "text": "ز مردان به گرد اندرش نیز چند"
  },
  {
    "poem_id": 88037,
    "vorder": 231,
    "position": 0,
    "text": "فرود آمد از باره رویین گرد"
  },
  {
    "poem_id": 88037,
    "vorder": 232,
    "position": 1,
    "text": "گوان را همه پیش گودرز برد"
  },
  {
    "poem_id": 88037,
    "vorder": 233,
    "position": 0,
    "text": "سپهبد بفرمود تا موبدان"
  },
  {
    "poem_id": 88037,
    "vorder": 234,
    "position": 1,
    "text": "ز لشکر همه نامور بخردان"
  },
  {
    "poem_id": 88037,
    "vorder": 235,
    "position": 0,
    "text": "به زودی سوی پهلوان آمدند"
  },
  {
    "poem_id": 88037,
    "vorder": 236,
    "position": 1,
    "text": "خردمند و روشن‌روان آمدند"
  },
  {
    "poem_id": 88037,
    "vorder": 237,
    "position": 0,
    "text": "پس آن پاسخ نامه پیش گوان"
  },
  {
    "poem_id": 88037,
    "vorder": 238,
    "position": 1,
    "text": "بفرمود خواندن همی پهلوان"
  },
  {
    "poem_id": 88037,
    "vorder": 239,
    "position": 0,
    "text": "بزرگان که آن نامهٔ دلپذیر"
  },
  {
    "poem_id": 88037,
    "vorder": 240,
    "position": 1,
    "text": "شنیدند گفتار فرخ دبیر"
  },
  {
    "poem_id": 88037,
    "vorder": 241,
    "position": 0,
    "text": "هش و رای پیران تنک داشتند"
  },
  {
    "poem_id": 88037,
    "vorder": 242,
    "position": 1,
    "text": "همه پند او را سبک داشتند"
  },
  {
    "poem_id": 88037,
    "vorder": 243,
    "position": 0,
    "text": "به گودرز بر آفرین خواند"
  },
  {
    "poem_id": 88037,
    "vorder": 244,
    "position": 1,
    "text": "ورا پهلوان گزین خواندند"
  },
  {
    "poem_id": 88037,
    "vorder": 245,
    "position": 0,
    "text": "پس آن نامه را مهر کرد و بداد"
  },
  {
    "poem_id": 88037,
    "vorder": 246,
    "position": 1,
    "text": "به رویین پیران ویسه‌نژاد"
  },
  {
    "poem_id": 88037,
    "vorder": 247,
    "position": 0,
    "text": "چو از پیش گودرز برخاستند"
  },
  {
    "poem_id": 88037,
    "vorder": 248,
    "position": 1,
    "text": "بفرمود تا خلعت آراستند"
  },
  {
    "poem_id": 88037,
    "vorder": 249,
    "position": 0,
    "text": "از اسبان تازی به زرین ستام"
  },
  {
    "poem_id": 88037,
    "vorder": 250,
    "position": 1,
    "text": "چه افسر چه شمشیر زرین نیام"
  },
  {
    "poem_id": 88037,
    "vorder": 251,
    "position": 0,
    "text": "ببخشید یارانش را سیم و زر"
  },
  {
    "poem_id": 88037,
    "vorder": 252,
    "position": 1,
    "text": "کرا در خور آمد کلاه و کمر"
  },
  {
    "poem_id": 88037,
    "vorder": 253,
    "position": 0,
    "text": "برفت از در پهلوان با سپاه"
  },
  {
    "poem_id": 88037,
    "vorder": 254,
    "position": 1,
    "text": "سوی لشکر خویش بگرفت راه"
  },
  {
    "poem_id": 88037,
    "vorder": 255,
    "position": 0,
    "text": "چو رویین به نزدیک پیران رسید"
  },
  {
    "poem_id": 88037,
    "vorder": 256,
    "position": 1,
    "text": "به پیش پدر شد چنانچون سزید"
  },
  {
    "poem_id": 88037,
    "vorder": 257,
    "position": 0,
    "text": "به نزدیک تختش فرو برد سر"
  },
  {
    "poem_id": 88037,
    "vorder": 258,
    "position": 1,
    "text": "جهاندیده پیران گرفتش به بر"
  },
  {
    "poem_id": 88037,
    "vorder": 259,
    "position": 0,
    "text": "چو بگزارد پیغام سالار شاه"
  },
  {
    "poem_id": 88037,
    "vorder": 260,
    "position": 1,
    "text": "بگفت آنچ دید اندر آن رزمگاه"
  },
  {
    "poem_id": 88037,
    "vorder": 261,
    "position": 0,
    "text": "پس آن نامه برخواند پیشش دبیر"
  },
  {
    "poem_id": 88037,
    "vorder": 262,
    "position": 1,
    "text": "رخ پهلوان سپه شد چو قیر"
  },
  {
    "poem_id": 88037,
    "vorder": 263,
    "position": 0,
    "text": "دلش گشت پردرد و جان پرنهیب"
  },
  {
    "poem_id": 88037,
    "vorder": 264,
    "position": 1,
    "text": "بدانست کآمد به تنگی نشیب"
  },
  {
    "poem_id": 88037,
    "vorder": 265,
    "position": 0,
    "text": "شکیبایی و خامشی برگزید"
  },
  {
    "poem_id": 88037,
    "vorder": 266,
    "position": 1,
    "text": "بکرد آن سخن بر سپه ناپدید"
  },
  {
    "poem_id": 88037,
    "vorder": 267,
    "position": 0,
    "text": "از آن پس چنین گفت پیش سپاه"
  },
  {
    "poem_id": 88037,
    "vorder": 268,
    "position": 1,
    "text": "که گودرز را دل نیامد به راه"
  },
  {
    "poem_id": 88037,
    "vorder": 269,
    "position": 0,
    "text": "از آن خون هفتاد پور گزین"
  },
  {
    "poem_id": 88037,
    "vorder": 270,
    "position": 1,
    "text": "نیارامدش یک زمان دل ز کین"
  },
  {
    "poem_id": 88037,
    "vorder": 271,
    "position": 0,
    "text": "گر ایدونک او بر گذشته سخن"
  },
  {
    "poem_id": 88037,
    "vorder": 272,
    "position": 1,
    "text": "به نوی همی کینه سازد ز بن"
  },
  {
    "poem_id": 88037,
    "vorder": 273,
    "position": 0,
    "text": "چرا من به کین برادر کمر"
  },
  {
    "poem_id": 88037,
    "vorder": 274,
    "position": 1,
    "text": "نبندم نخارم از این کینه سر"
  },
  {
    "poem_id": 88037,
    "vorder": 275,
    "position": 0,
    "text": "هم از خون نهصد سر نامدار"
  },
  {
    "poem_id": 88037,
    "vorder": 276,
    "position": 1,
    "text": "که از تن جدا شد گه کارزار"
  },
  {
    "poem_id": 88037,
    "vorder": 277,
    "position": 0,
    "text": "که اندر بر و بوم ترکان دگر"
  },
  {
    "poem_id": 88037,
    "vorder": 278,
    "position": 1,
    "text": "سواری چو هومان نبندد کمر"
  },
  {
    "poem_id": 88037,
    "vorder": 279,
    "position": 0,
    "text": "چو نستیهن آن سرو سایه فگن"
  },
  {
    "poem_id": 88037,
    "vorder": 280,
    "position": 1,
    "text": "که شد ناپدید از همه انجمن"
  },
  {
    "poem_id": 88037,
    "vorder": 281,
    "position": 0,
    "text": "بباید کنون بست ما را کمر"
  },
  {
    "poem_id": 88037,
    "vorder": 282,
    "position": 1,
    "text": "نمانم به ایرانیان بوم و بر"
  },
  {
    "poem_id": 88037,
    "vorder": 283,
    "position": 0,
    "text": "به نیروی یزدان و شمشیر تیز"
  },
  {
    "poem_id": 88037,
    "vorder": 284,
    "position": 1,
    "text": "برآرم از آن انجمن رستخیز"
  }
]