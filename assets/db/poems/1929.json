[
  {
    "poem_id": 1929,
    "vorder": 1,
    "position": 0,
    "text": "فرخ‌زاد هرمزد با آب چشم"
  },
  {
    "poem_id": 1929,
    "vorder": 2,
    "position": 1,
    "text": "به اروندرود اندر آمد بخشم"
  },
  {
    "poem_id": 1929,
    "vorder": 3,
    "position": 0,
    "text": "به کرخ اندر آمد یکی حمله برد"
  },
  {
    "poem_id": 1929,
    "vorder": 4,
    "position": 1,
    "text": "که از نیزه‌داران نماند ایچ گُرد"
  },
  {
    "poem_id": 1929,
    "vorder": 5,
    "position": 0,
    "text": "هم آنگه ز بغداد بیرون شدند"
  },
  {
    "poem_id": 1929,
    "vorder": 6,
    "position": 1,
    "text": "سوی رزم جستن به هامون شدند"
  },
  {
    "poem_id": 1929,
    "vorder": 7,
    "position": 0,
    "text": "چو برخاست گرد نبرد از میان"
  },
  {
    "poem_id": 1929,
    "vorder": 8,
    "position": 1,
    "text": "شکست اندر آمد به ایرانیان"
  },
  {
    "poem_id": 1929,
    "vorder": 9,
    "position": 0,
    "text": "فرخ‌زاد برگشت و شد نزد شاه"
  },
  {
    "poem_id": 1929,
    "vorder": 10,
    "position": 1,
    "text": "پر از گرد با آلت رزمگاه"
  },
  {
    "poem_id": 1929,
    "vorder": 11,
    "position": 0,
    "text": "فرود آمد از باره بردش نماز"
  },
  {
    "poem_id": 1929,
    "vorder": 12,
    "position": 1,
    "text": "دو دیده پر از خون و دل پرگداز"
  },
  {
    "poem_id": 1929,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت چندین چه مولی همی"
  },
  {
    "poem_id": 1929,
    "vorder": 14,
    "position": 1,
    "text": "که گاه کیی را بشولی همی"
  },
  {
    "poem_id": 1929,
    "vorder": 15,
    "position": 0,
    "text": "ز تخم کیان کس جز از تو نماند"
  },
  {
    "poem_id": 1929,
    "vorder": 16,
    "position": 1,
    "text": "که با تاج بر تخت شاید نشاند"
  },
  {
    "poem_id": 1929,
    "vorder": 17,
    "position": 0,
    "text": "توی یک تن و دشمنان صد هزار"
  },
  {
    "poem_id": 1929,
    "vorder": 18,
    "position": 1,
    "text": "میان جهان چون کنی کارزار"
  },
  {
    "poem_id": 1929,
    "vorder": 19,
    "position": 0,
    "text": "برو تا سوی بیشهٔ ناروَن"
  },
  {
    "poem_id": 1929,
    "vorder": 20,
    "position": 1,
    "text": "جهانی شود بر تو بر انجمن"
  },
  {
    "poem_id": 1929,
    "vorder": 21,
    "position": 0,
    "text": "وزان جایگاه چون فریدون برو"
  },
  {
    "poem_id": 1929,
    "vorder": 22,
    "position": 1,
    "text": "جوانی یکی کار برساز نو"
  },
  {
    "poem_id": 1929,
    "vorder": 23,
    "position": 0,
    "text": "فرخ‌زاد گفت و جهانبان شنید"
  },
  {
    "poem_id": 1929,
    "vorder": 24,
    "position": 1,
    "text": "یکی دیگر اندیشه آمد پدید"
  },
  {
    "poem_id": 1929,
    "vorder": 25,
    "position": 0,
    "text": "دگر روز برگاه بنشست شاه"
  },
  {
    "poem_id": 1929,
    "vorder": 26,
    "position": 1,
    "text": "به سر برنهاد آن کیانی کلاه"
  },
  {
    "poem_id": 1929,
    "vorder": 27,
    "position": 0,
    "text": "یکی انجمن کرد با بخردان"
  },
  {
    "poem_id": 1929,
    "vorder": 28,
    "position": 1,
    "text": "بزرگان و بیداردل موبدان"
  },
  {
    "poem_id": 1929,
    "vorder": 29,
    "position": 0,
    "text": "چه بینید گفت اندرین داستان"
  },
  {
    "poem_id": 1929,
    "vorder": 30,
    "position": 1,
    "text": "چه دارید یاد از گه باستان"
  },
  {
    "poem_id": 1929,
    "vorder": 31,
    "position": 0,
    "text": "فرخ‌زاد گوید که با انجمن"
  },
  {
    "poem_id": 1929,
    "vorder": 32,
    "position": 1,
    "text": "گذر کن سوی بیشهٔ ناروَن"
  },
  {
    "poem_id": 1929,
    "vorder": 33,
    "position": 0,
    "text": "به آمل پرستندگان تواَند"
  },
  {
    "poem_id": 1929,
    "vorder": 34,
    "position": 1,
    "text": "به ساری همه بندگان تواَند"
  },
  {
    "poem_id": 1929,
    "vorder": 35,
    "position": 0,
    "text": "چو لشکر فراوان شود بازگرد"
  },
  {
    "poem_id": 1929,
    "vorder": 36,
    "position": 1,
    "text": "به مردم توان ساخت ننگ و نبرد"
  },
  {
    "poem_id": 1929,
    "vorder": 37,
    "position": 0,
    "text": "شما را پسند آید این گفت‌وگوی"
  },
  {
    "poem_id": 1929,
    "vorder": 38,
    "position": 1,
    "text": "به آواز گفتند کاین نیست روی"
  },
  {
    "poem_id": 1929,
    "vorder": 39,
    "position": 0,
    "text": "شهنشاه گفت این سخن درخورَست"
  },
  {
    "poem_id": 1929,
    "vorder": 40,
    "position": 1,
    "text": "مرا در دل اندیشهٔ دیگرَست"
  },
  {
    "poem_id": 1929,
    "vorder": 41,
    "position": 0,
    "text": "بزرگان ایران و چندین سپاه"
  },
  {
    "poem_id": 1929,
    "vorder": 42,
    "position": 1,
    "text": "بر و بوم آباد و تخت و کلاه"
  },
  {
    "poem_id": 1929,
    "vorder": 43,
    "position": 0,
    "text": "سرِ خویش گیرم بمانم بجای"
  },
  {
    "poem_id": 1929,
    "vorder": 44,
    "position": 1,
    "text": "بزرگی نباشد نه مردی و رای"
  },
  {
    "poem_id": 1929,
    "vorder": 45,
    "position": 0,
    "text": "مرا جنگ دشمن به آید ز ننگ"
  },
  {
    "poem_id": 1929,
    "vorder": 46,
    "position": 1,
    "text": "یکی داستان زد برین بر پلنگ"
  },
  {
    "poem_id": 1929,
    "vorder": 47,
    "position": 0,
    "text": "که خیره به بدخواه منمای پشت"
  },
  {
    "poem_id": 1929,
    "vorder": 48,
    "position": 1,
    "text": "چو پیش آیدت روزگاری درشت"
  },
  {
    "poem_id": 1929,
    "vorder": 49,
    "position": 0,
    "text": "چنان هم که کهتر به فرمان شاه"
  },
  {
    "poem_id": 1929,
    "vorder": 50,
    "position": 1,
    "text": "بد و نیک باید که دارد نگاه"
  },
  {
    "poem_id": 1929,
    "vorder": 51,
    "position": 0,
    "text": "جهاندار باید که او را به رنج"
  },
  {
    "poem_id": 1929,
    "vorder": 52,
    "position": 1,
    "text": "نماند بجای و شود سوی گنج"
  },
  {
    "poem_id": 1929,
    "vorder": 53,
    "position": 0,
    "text": "بزرگان برو خواندند آفرین"
  },
  {
    "poem_id": 1929,
    "vorder": 54,
    "position": 1,
    "text": "که اینست آیین شاهان دین"
  },
  {
    "poem_id": 1929,
    "vorder": 55,
    "position": 0,
    "text": "نگه کن کنون تا چه فرمان دهی"
  },
  {
    "poem_id": 1929,
    "vorder": 56,
    "position": 1,
    "text": "چه خواهی و با ما چه پیمان نهی"
  },
  {
    "poem_id": 1929,
    "vorder": 57,
    "position": 0,
    "text": "مهان را چنین پاسخ آورد شاه"
  },
  {
    "poem_id": 1929,
    "vorder": 58,
    "position": 1,
    "text": "کز اندیشه گردد دل من تباه"
  },
  {
    "poem_id": 1929,
    "vorder": 59,
    "position": 0,
    "text": "همانا که سوی خراسان شویم"
  },
  {
    "poem_id": 1929,
    "vorder": 60,
    "position": 1,
    "text": "ز پیکار دشمن تن‌آسان شویم"
  },
  {
    "poem_id": 1929,
    "vorder": 61,
    "position": 0,
    "text": "کزان سو فراوان مرا لشکرست"
  },
  {
    "poem_id": 1929,
    "vorder": 62,
    "position": 1,
    "text": "همه پهلوانان کنداورست"
  },
  {
    "poem_id": 1929,
    "vorder": 63,
    "position": 0,
    "text": "بزرگان و ترکان خاقان چین"
  },
  {
    "poem_id": 1929,
    "vorder": 64,
    "position": 1,
    "text": "بیایند و بر ما کنند آفرین"
  },
  {
    "poem_id": 1929,
    "vorder": 65,
    "position": 0,
    "text": "بران دوستی نیز بیشی کنیم"
  },
  {
    "poem_id": 1929,
    "vorder": 66,
    "position": 1,
    "text": "که با دختِ فغفور خویشی کنیم"
  },
  {
    "poem_id": 1929,
    "vorder": 67,
    "position": 0,
    "text": "بِیاری بیاید سپاهی گران"
  },
  {
    "poem_id": 1929,
    "vorder": 68,
    "position": 1,
    "text": "بزرگان و ترکان جنگاوران"
  },
  {
    "poem_id": 1929,
    "vorder": 69,
    "position": 0,
    "text": "کنارنگِ مروست ماهوی نیز"
  },
  {
    "poem_id": 1929,
    "vorder": 70,
    "position": 1,
    "text": "ابا لشکر و پیل و هر گونه چیز"
  },
  {
    "poem_id": 1929,
    "vorder": 71,
    "position": 0,
    "text": "کجا پیشکار شبانان ماست"
  },
  {
    "poem_id": 1929,
    "vorder": 72,
    "position": 1,
    "text": "برآوردهٔ دشتبانان ماست"
  },
  {
    "poem_id": 1929,
    "vorder": 73,
    "position": 0,
    "text": "ورا برکشیدم که گوینده بود"
  },
  {
    "poem_id": 1929,
    "vorder": 74,
    "position": 1,
    "text": "همان رزم را نیز جوینده بود"
  },
  {
    "poem_id": 1929,
    "vorder": 75,
    "position": 0,
    "text": "چو بی‌ارز را نام دادیم و ارز"
  },
  {
    "poem_id": 1929,
    "vorder": 76,
    "position": 1,
    "text": "کنارنگی و پیل و مردان و مرز"
  },
  {
    "poem_id": 1929,
    "vorder": 77,
    "position": 0,
    "text": "اگر چند بی‌مایه و بی‌تنست"
  },
  {
    "poem_id": 1929,
    "vorder": 78,
    "position": 1,
    "text": "برآوردهٔ بارگاه منست"
  },
  {
    "poem_id": 1929,
    "vorder": 79,
    "position": 0,
    "text": "ز موبد شنیدستم این داستان"
  },
  {
    "poem_id": 1929,
    "vorder": 80,
    "position": 1,
    "text": "که برخواند از گفتهٔ باستان"
  },
  {
    "poem_id": 1929,
    "vorder": 81,
    "position": 0,
    "text": "که پرهیز از آن کن که بد کرده‌ای"
  },
  {
    "poem_id": 1929,
    "vorder": 82,
    "position": 1,
    "text": "که او را به بیهوده آزرده‌ای"
  },
  {
    "poem_id": 1929,
    "vorder": 83,
    "position": 0,
    "text": "بدان دار اومید کو را به مهر"
  },
  {
    "poem_id": 1929,
    "vorder": 84,
    "position": 1,
    "text": "سر از نیستی بردی اندر سپهر"
  },
  {
    "poem_id": 1929,
    "vorder": 85,
    "position": 0,
    "text": "فرخ‌زاد برهم بزد هر دودست"
  },
  {
    "poem_id": 1929,
    "vorder": 86,
    "position": 1,
    "text": "بدو گفت کای شاه یزدان‌پرست"
  },
  {
    "poem_id": 1929,
    "vorder": 87,
    "position": 0,
    "text": "به بدگوهران بر بس ایمن مشو"
  },
  {
    "poem_id": 1929,
    "vorder": 88,
    "position": 1,
    "text": "که این را یکی داستانست نو"
  },
  {
    "poem_id": 1929,
    "vorder": 89,
    "position": 0,
    "text": "که هر چند بر گوهر افسون کنی"
  },
  {
    "poem_id": 1929,
    "vorder": 90,
    "position": 1,
    "text": "بکوشی کزو رنگ بیرون کنی"
  },
  {
    "poem_id": 1929,
    "vorder": 91,
    "position": 0,
    "text": "چو پروردگارش چنان آفرید"
  },
  {
    "poem_id": 1929,
    "vorder": 92,
    "position": 1,
    "text": "تو بر بند یزدان نیابی کلید"
  },
  {
    "poem_id": 1929,
    "vorder": 93,
    "position": 0,
    "text": "ازیشان نبرّند رنگ و نژاد"
  },
  {
    "poem_id": 1929,
    "vorder": 94,
    "position": 1,
    "text": "تو را جز بزرگی و شاهی مباد"
  },
  {
    "poem_id": 1929,
    "vorder": 95,
    "position": 0,
    "text": "بدو گفت شاه‌ ای هژبر ژیان"
  },
  {
    "poem_id": 1929,
    "vorder": 96,
    "position": 1,
    "text": "ازین آزمایش ندارد زیان"
  },
  {
    "poem_id": 1929,
    "vorder": 97,
    "position": 0,
    "text": "ببود آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1929,
    "vorder": 98,
    "position": 1,
    "text": "گرانمایگان برگرفتند راه"
  },
  {
    "poem_id": 1929,
    "vorder": 99,
    "position": 0,
    "text": "ز بغداد راه خراسان گرفت"
  },
  {
    "poem_id": 1929,
    "vorder": 100,
    "position": 1,
    "text": "همه رنجها بر دل آسان گرفت"
  },
  {
    "poem_id": 1929,
    "vorder": 101,
    "position": 0,
    "text": "بزرگان ایران همه پر ز درد"
  },
  {
    "poem_id": 1929,
    "vorder": 102,
    "position": 1,
    "text": "برفتند با شاه آزادمرد"
  },
  {
    "poem_id": 1929,
    "vorder": 103,
    "position": 0,
    "text": "برو بر همی‌خواندند آفرین"
  },
  {
    "poem_id": 1929,
    "vorder": 104,
    "position": 1,
    "text": "که بی تو مبادا زمان و زمین"
  },
  {
    "poem_id": 1929,
    "vorder": 105,
    "position": 0,
    "text": "خروشی برآمد ز لشکر به زار"
  },
  {
    "poem_id": 1929,
    "vorder": 106,
    "position": 1,
    "text": "ز تیمار وز رفتن شهریار"
  },
  {
    "poem_id": 1929,
    "vorder": 107,
    "position": 0,
    "text": "ازیشان هر آنکس که دهقان بدند"
  },
  {
    "poem_id": 1929,
    "vorder": 108,
    "position": 1,
    "text": "وگر خویش و پیوند خاقان بدند"
  },
  {
    "poem_id": 1929,
    "vorder": 109,
    "position": 0,
    "text": "خروشان برِ شهریار آمدند"
  },
  {
    "poem_id": 1929,
    "vorder": 110,
    "position": 1,
    "text": "همه دیده چون جویبار آمدند"
  },
  {
    "poem_id": 1929,
    "vorder": 111,
    "position": 0,
    "text": "که ما را دل از بوم و آرامگاه"
  },
  {
    "poem_id": 1929,
    "vorder": 112,
    "position": 1,
    "text": "چگونه بوَد شاد بی روی شاه"
  },
  {
    "poem_id": 1929,
    "vorder": 113,
    "position": 0,
    "text": "همه بوم آباد و فرزند و گنج"
  },
  {
    "poem_id": 1929,
    "vorder": 114,
    "position": 1,
    "text": "بمانیم و با تو گزینیم رنج"
  },
  {
    "poem_id": 1929,
    "vorder": 115,
    "position": 0,
    "text": "زمانه نخواهیم بی تخت تو"
  },
  {
    "poem_id": 1929,
    "vorder": 116,
    "position": 1,
    "text": "مبادا که پیچان شود بخت تو"
  },
  {
    "poem_id": 1929,
    "vorder": 117,
    "position": 0,
    "text": "همه با تو آییم تا روزگار"
  },
  {
    "poem_id": 1929,
    "vorder": 118,
    "position": 1,
    "text": "چه بازی کند در دم کارزار"
  },
  {
    "poem_id": 1929,
    "vorder": 119,
    "position": 0,
    "text": "ز خاقانیان آنک بُد چرب‌گوی"
  },
  {
    "poem_id": 1929,
    "vorder": 120,
    "position": 1,
    "text": "به خاک سیه برنهادند روی"
  },
  {
    "poem_id": 1929,
    "vorder": 121,
    "position": 0,
    "text": "که ما بوم آباد بگذاشتیم"
  },
  {
    "poem_id": 1929,
    "vorder": 122,
    "position": 1,
    "text": "جهان در پناه تو پنداشتیم"
  },
  {
    "poem_id": 1929,
    "vorder": 123,
    "position": 0,
    "text": "کنون داغ‌دل نزد خاقان شویم"
  },
  {
    "poem_id": 1929,
    "vorder": 124,
    "position": 1,
    "text": "ز تازی سوی مرز دهقان شویم"
  },
  {
    "poem_id": 1929,
    "vorder": 125,
    "position": 0,
    "text": "شهنشاه مژگان پر از آب کرد"
  },
  {
    "poem_id": 1929,
    "vorder": 126,
    "position": 1,
    "text": "چنین گفت با نامداران بدرد"
  },
  {
    "poem_id": 1929,
    "vorder": 127,
    "position": 0,
    "text": "که یکسر به یزدان نیایش کنید"
  },
  {
    "poem_id": 1929,
    "vorder": 128,
    "position": 1,
    "text": "ستایش ورا در فزایش کنید"
  },
  {
    "poem_id": 1929,
    "vorder": 129,
    "position": 0,
