[
  {
    "poem_id": 1379,
    "vorder": 1,
    "position": 0,
    "text": "کنون پرشگفتی یکی داستان"
  },
  {
    "poem_id": 1379,
    "vorder": 2,
    "position": 1,
    "text": "بپیوندم از گفتهٔ باستان"
  },
  {
    "poem_id": 1379,
    "vorder": 3,
    "position": 0,
    "text": "نگه کن که مر سام را روزگار"
  },
  {
    "poem_id": 1379,
    "vorder": 4,
    "position": 1,
    "text": "چه بازی نمود ای پسر گوش دار"
  },
  {
    "poem_id": 1379,
    "vorder": 5,
    "position": 0,
    "text": "نبود ایچ فرزند مر سام را"
  },
  {
    "poem_id": 1379,
    "vorder": 6,
    "position": 1,
    "text": "دلش بود جویندهٔ کام را"
  },
  {
    "poem_id": 1379,
    "vorder": 7,
    "position": 0,
    "text": "نگاری بُد اندر شبستان اوی"
  },
  {
    "poem_id": 1379,
    "vorder": 8,
    "position": 1,
    "text": "ز گلبرگ رخ داشت و ز مشک موی"
  },
  {
    "poem_id": 1379,
    "vorder": 9,
    "position": 0,
    "text": "از آن ماهش امید فرزند بود"
  },
  {
    "poem_id": 1379,
    "vorder": 10,
    "position": 1,
    "text": "که خورشید‌چهر و برومند بود"
  },
  {
    "poem_id": 1379,
    "vorder": 11,
    "position": 0,
    "text": "ز سام نریمان هم او بار داشت"
  },
  {
    "poem_id": 1379,
    "vorder": 12,
    "position": 1,
    "text": "ز بار گران تنش آزار داشت"
  },
  {
    "poem_id": 1379,
    "vorder": 13,
    "position": 0,
    "text": "ز مادر جدا شد بر آن چند روز"
  },
  {
    "poem_id": 1379,
    "vorder": 14,
    "position": 1,
    "text": "نگاری چو خورشید گیتی‌فروز"
  },
  {
    "poem_id": 1379,
    "vorder": 15,
    "position": 0,
    "text": "به چهره چنان بود تابنده شید"
  },
  {
    "poem_id": 1379,
    "vorder": 16,
    "position": 1,
    "text": "ولیکن همه موی بودش سپید"
  },
  {
    "poem_id": 1379,
    "vorder": 17,
    "position": 0,
    "text": "پسر چون ز مادر بر آن گونه زاد"
  },
  {
    "poem_id": 1379,
    "vorder": 18,
    "position": 1,
    "text": "نکردند یک هفته بر سام یاد"
  },
  {
    "poem_id": 1379,
    "vorder": 19,
    "position": 0,
    "text": "شبستان آن نامور پهلوان"
  },
  {
    "poem_id": 1379,
    "vorder": 20,
    "position": 1,
    "text": "همه پیش آن خرد کودک نوان"
  },
  {
    "poem_id": 1379,
    "vorder": 21,
    "position": 0,
    "text": "کسی سام یل را نیارست گفت"
  },
  {
    "poem_id": 1379,
    "vorder": 22,
    "position": 1,
    "text": "که فرزند پیر آمد از خوب‌جفت"
  },
  {
    "poem_id": 1379,
    "vorder": 23,
    "position": 0,
    "text": "یکی دایه بودش به کردار شیر"
  },
  {
    "poem_id": 1379,
    "vorder": 24,
    "position": 1,
    "text": "بر پهلوان اندر آمد دلیر"
  },
  {
    "poem_id": 1379,
    "vorder": 25,
    "position": 0,
    "text": "که بر سام یل روز فرخنده باد"
  },
  {
    "poem_id": 1379,
    "vorder": 26,
    "position": 1,
    "text": "دل بدسگالان او کنده باد"
  },
  {
    "poem_id": 1379,
    "vorder": 27,
    "position": 0,
    "text": "پس پردهٔ تو در ای نامجوی"
  },
  {
    "poem_id": 1379,
    "vorder": 28,
    "position": 1,
    "text": "یکی پور پاک آمد از ماه‌روی"
  },
  {
    "poem_id": 1379,
    "vorder": 29,
    "position": 0,
    "text": "تنش نقرهٔ سیم و رخ چون بهشت"
  },
  {
    "poem_id": 1379,
    "vorder": 30,
    "position": 1,
    "text": "بر او بر نبینی یک اندام زشت"
  },
  {
    "poem_id": 1379,
    "vorder": 31,
    "position": 0,
    "text": "از آهو همان کش سپید است موی"
  },
  {
    "poem_id": 1379,
    "vorder": 32,
    "position": 1,
    "text": "چنین بود بخش تو ای نامجوی"
  },
  {
    "poem_id": 1379,
    "vorder": 33,
    "position": 0,
    "text": "فرود آمد از تخت سام سوار"
  },
  {
    "poem_id": 1379,
    "vorder": 34,
    "position": 1,
    "text": "به پرده درآمد سوی نو بهار"
  },
  {
    "poem_id": 1379,
    "vorder": 35,
    "position": 0,
    "text": "چو فرزند را دید مویش سپید"
  },
  {
    "poem_id": 1379,
    "vorder": 36,
    "position": 1,
    "text": "ببود از جهان سر به سر ناامید"
  },
  {
    "poem_id": 1379,
    "vorder": 37,
    "position": 0,
    "text": "سوی آسمان سر برآورد راست"
  },
  {
    "poem_id": 1379,
    "vorder": 38,
    "position": 1,
    "text": "ز دادآور آنگاه فریاد خواست"
  },
  {
    "poem_id": 1379,
    "vorder": 39,
    "position": 0,
    "text": "که ای برتر از کژی و کاستی"
  },
  {
    "poem_id": 1379,
    "vorder": 40,
    "position": 1,
    "text": "بهی زان فزاید که تو خواستی"
  },
  {
    "poem_id": 1379,
    "vorder": 41,
    "position": 0,
    "text": "اگر من گناهی گران کرده‌ام"
  },
  {
    "poem_id": 1379,
    "vorder": 42,
    "position": 1,
    "text": "و گر کیش آهرمن آورده‌ام"
  },
  {
    "poem_id": 1379,
    "vorder": 43,
    "position": 0,
    "text": "به پوزش مگر کردگار جهان"
  },
  {
    "poem_id": 1379,
    "vorder": 44,
    "position": 1,
    "text": "به من بر ببخشاید اندر نهان"
  },
  {
    "poem_id": 1379,
    "vorder": 45,
    "position": 0,
    "text": "بپیچد همی تیره جانم ز شرم"
  },
  {
    "poem_id": 1379,
    "vorder": 46,
    "position": 1,
    "text": "بجوشد همی در دلم خون گرم"
  },
  {
    "poem_id": 1379,
    "vorder": 47,
    "position": 0,
    "text": "چو آیند و پرسند گردن‌کشان"
  },
  {
    "poem_id": 1379,
    "vorder": 48,
    "position": 1,
    "text": "چه گویم از این بچهٔ بدنشان‌؟"
  },
  {
    "poem_id": 1379,
    "vorder": 49,
    "position": 0,
    "text": "چه گویم که این بچهٔ دیو چیست؟"
  },
  {
    "poem_id": 1379,
    "vorder": 50,
    "position": 1,
    "text": "پلنگ و دو رنگ است و گر نه پری‌ست"
  },
  {
    "poem_id": 1379,
    "vorder": 51,
    "position": 0,
    "text": "از این ننگ بگذارم ایران زمین"
  },
  {
    "poem_id": 1379,
    "vorder": 52,
    "position": 1,
    "text": "نخواهم بر این بوم و بر آفرین"
  },
  {
    "poem_id": 1379,
    "vorder": 53,
    "position": 0,
    "text": "بفرمود پس تاش برداشتند"
  },
  {
    "poem_id": 1379,
    "vorder": 54,
    "position": 1,
    "text": "از آن بوم و بر دور بگذاشتند"
  },
  {
    "poem_id": 1379,
    "vorder": 55,
    "position": 0,
    "text": "به جایی که سیمرغ را خانه بود"
  },
  {
    "poem_id": 1379,
    "vorder": 56,
    "position": 1,
    "text": "بدان خانه این خرد بیگانه بود"
  },
  {
    "poem_id": 1379,
    "vorder": 57,
    "position": 0,
    "text": "نهادند بر کوه و گشتند باز"
  },
  {
    "poem_id": 1379,
    "vorder": 58,
    "position": 1,
    "text": "برآمد بر این روزگاری دراز"
  },
  {
    "poem_id": 1379,
    "vorder": 59,
    "position": 0,
    "text": "چنان پهلوان زادهٔ بی‌گناه"
  },
  {
    "poem_id": 1379,
    "vorder": 60,
    "position": 1,
    "text": "ندانست رنگ سپید از سیاه"
  },
  {
    "poem_id": 1379,
    "vorder": 61,
    "position": 0,
    "text": "پدر مهر و پیوند بفگند خوار"
  },
  {
    "poem_id": 1379,
    "vorder": 62,
    "position": 1,
    "text": "جفا کرد بر کودک شیرخوار"
  },
  {
    "poem_id": 1379,
    "vorder": 63,
    "position": 0,
    "text": "یکی داستان زد بر این نرّه شیر"
  },
  {
    "poem_id": 1379,
    "vorder": 64,
    "position": 1,
    "text": "کجا بچه را کرده بد شیر سیر"
  },
  {
    "poem_id": 1379,
    "vorder": 65,
    "position": 0,
    "text": "که گر من تو را خون دل دادمی"
  },
  {
    "poem_id": 1379,
    "vorder": 66,
    "position": 1,
    "text": "سپاس ایچ بر سرت ننهادمی"
  },
  {
    "poem_id": 1379,
    "vorder": 67,
    "position": 0,
    "text": "که تو خود مرا دیده و هم دلی"
  },
  {
    "poem_id": 1379,
    "vorder": 68,
    "position": 1,
    "text": "دلم بگسلد گر ز من بگسلی"
  },
  {
    "poem_id": 1379,
    "vorder": 69,
    "position": 0,
    "text": "چو سیمرغ را بچه شد گرْسنه"
  },
  {
    "poem_id": 1379,
    "vorder": 70,
    "position": 1,
    "text": "به پرواز بر شد دمان از بنه"
  },
  {
    "poem_id": 1379,
    "vorder": 71,
    "position": 0,
    "text": "یکی شیرخواره خروشنده دید"
  },
  {
    "poem_id": 1379,
    "vorder": 72,
    "position": 1,
    "text": "زمین را چو دریای جوشنده دید"
  },
  {
    "poem_id": 1379,
    "vorder": 73,
    "position": 0,
    "text": "ز خاراش گهواره و دایه خاک"
  },
  {
    "poem_id": 1379,
    "vorder": 74,
    "position": 1,
    "text": "تن از جامه دور و لب از شیر پاک"
  },
  {
    "poem_id": 1379,
    "vorder": 75,
    "position": 0,
    "text": "به گرد اندرش تیره خاک نژند"
  },
  {
    "poem_id": 1379,
    "vorder": 76,
    "position": 1,
    "text": "به سر برش خورشید گشته بلند"
  },
  {
    "poem_id": 1379,
    "vorder": 77,
    "position": 0,
    "text": "پلنگش بدی کاشکی مام و باب"
  },
  {
    "poem_id": 1379,
    "vorder": 78,
    "position": 1,
    "text": "مگر سایه‌ای یافتی ز آفتاب"
  },
  {
    "poem_id": 1379,
    "vorder": 79,
    "position": 0,
    "text": "فرود آمد از ابر سیمرغ و چنگ"
  },
  {
    "poem_id": 1379,
    "vorder": 80,
    "position": 1,
    "text": "بزد برگرفتش از آن گرم سنگ"
  },
  {
    "poem_id": 1379,
    "vorder": 81,
    "position": 0,
    "text": "ببردش دمان تا به البرز کوه"
  },
  {
    "poem_id": 1379,
    "vorder": 82,
    "position": 1,
    "text": "که بودش بدانجا کنام و گروه"
  },
  {
    "poem_id": 1379,
    "vorder": 83,
    "position": 0,
    "text": "سوی بچگان برد تا بشکرند"
  },
  {
    "poem_id": 1379,
    "vorder": 84,
    "position": 1,
    "text": "بدان نالهٔ زار او ننگرند"
  },
  {
    "poem_id": 1379,
    "vorder": 85,
    "position": 0,
    "text": "ببخشود یزدان نیکی‌دهش"
  },
  {
    "poem_id": 1379,
    "vorder": 86,
    "position": 1,
    "text": "کجا بودنی داشت اندر بوش"
  },
  {
    "poem_id": 1379,
    "vorder": 87,
    "position": 0,
    "text": "نگه کرد سیمرغ با بچّگان"
  },
  {
    "poem_id": 1379,
    "vorder": 88,
    "position": 1,
    "text": "بر آن خرد خون از دو دیده چکان"
  },
  {
    "poem_id": 1379,
    "vorder": 89,
    "position": 0,
    "text": "شگفتی بر او بر فگندند مهر"
  },
  {
    "poem_id": 1379,
    "vorder": 90,
    "position": 1,
    "text": "بماندند خیره بدان خوب چهر"
  },
  {
    "poem_id": 1379,
    "vorder": 91,
    "position": 0,
    "text": "شکاری که نازک‌تر آن برگزید"
  },
  {
    "poem_id": 1379,
    "vorder": 92,
    "position": 1,
    "text": "که بی‌شیر مهمان همی خون مزید"
  },
  {
    "poem_id": 1379,
    "vorder": 93,
    "position": 0,
    "text": "بدین گونه تا روزگاری دراز"
  },
  {
    "poem_id": 1379,
    "vorder": 94,
    "position": 1,
    "text": "برآورد داننده بگشاد راز"
  },
  {
    "poem_id": 1379,
    "vorder": 95,
    "position": 0,
    "text": "چو آن کودک خرد پر مایه گشت"
  },
  {
    "poem_id": 1379,
    "vorder": 96,
    "position": 1,
    "text": "بر آن کوه بر روزگاری گذشت"
  },
  {
    "poem_id": 1379,
    "vorder": 97,
    "position": 0,
    "text": "یکی مرد شد چون یکی زاد سرو"
  },
  {
    "poem_id": 1379,
    "vorder": 98,
    "position": 1,
    "text": "برش کوه سیمین میانش چو غرو"
  },
  {
    "poem_id": 1379,
    "vorder": 99,
    "position": 0,
    "text": "نشانش پراگنده شد در جهان"
  },
  {
    "poem_id": 1379,
    "vorder": 100,
    "position": 1,
    "text": "بد و نیک هرگز نماند نهان"
  },
  {
    "poem_id": 1379,
    "vorder": 101,
    "position": 0,
    "text": "به سام نریمان رسید آگهی"
  },
  {
    "poem_id": 1379,
    "vorder": 102,
    "position": 1,
    "text": "از آن نیک پی پور با فرّهی"
  },
  {
    "poem_id": 1379,
    "vorder": 103,
    "position": 0,
    "text": "شبی از شبان داغ دل خفته بود"
  },
  {
    "poem_id": 1379,
    "vorder": 104,
    "position": 1,
    "text": "ز کار زمانه برآشفته بود"
  },
  {
    "poem_id": 1379,
    "vorder": 105,
    "position": 0,
    "text": "چنان دید در خواب کز هندوان"
  },
  {
    "poem_id": 1379,
    "vorder": 106,
    "position": 1,
    "text": "یکی مرد بر تازی اسپ دوان"
  },
  {
    "poem_id": 1379,
    "vorder": 107,
    "position": 0,
    "text": "ورا مژده دادی به فرزند او"
  },
  {
    "poem_id": 1379,
    "vorder": 108,
    "position": 1,
    "text": "بر آن برز شاخ برومند او"
  },
  {
    "poem_id": 1379,
    "vorder": 109,
    "position": 0,
    "text": "چو بیدار شد موبدان را بخواند"
  },
  {
    "poem_id": 1379,
    "vorder": 110,
    "position": 1,
    "text": "از این در سخن چند گونه براند"
  },
  {
    "poem_id": 1379,
    "vorder": 111,
    "position": 0,
    "text": "چه گویید گفت اندر این داستان‌؟"
  },
  {
    "poem_id": 1379,
    "vorder": 112,
    "position": 1,
    "text": "خردتان بر این هست هم‌داستان‌؟"
  },
  {
    "poem_id": 1379,
    "vorder": 113,
    "position": 0,
    "text": "هر آنکس که بودند پیر و جوان"
  },
  {
    "poem_id": 1379,
    "vorder": 114,
    "position": 1,
    "text": "زبان برگشادند بر پهلوان"
  },
  {
    "poem_id": 1379,
    "vorder": 115,
    "position": 0,
    "text": "که بر سنگ و بر خاک شیر و پلنگ"
  },
  {
    "poem_id": 1379,
    "vorder": 116,
    "position": 1,
    "text": "چه ماهی به دریا درون با نهنگ"
  },
  {
    "poem_id": 1379,
    "vorder": 117,
    "position": 0,
    "text": "همه بچه را پروراننده‌اند"
  },
  {
    "poem_id": 1379,
    "vorder": 118,
    "position": 1,
    "text": "ستایش به یزدان رساننده‌اند"
  },
  {
    "poem_id": 1379,
    "vorder": 119,
    "position": 0,
    "text": "تو پیمان نیکی دهش بشکنی"
  },
  {
    "poem_id": 1379,
    "vorder": 120,
    "position": 1,
    "text": "چنان بی‌گنه بچه را بفگنی"
  },
  {
    "poem_id": 1379,
    "vorder": 121,
    "position": 0,
    "text": "به یزدان کنون سوی پوزش گرای"
  },
  {
    "poem_id": 1379,
    "vorder": 122,
    "position": 1,
    "text": "که اوی است بر نیکویی رهنمای"
  },
  {
    "poem_id": 1379,
    "vorder": 123,
    "position": 0,
    "text": "چو شب تیره شد رای خواب آمدش"
  },
  {
    "poem_id": 1379,
    "vorder": 124,
    "position": 1,
    "text": "از اندیشهٔ دل شتاب آمدش"
  },
  {
    "poem_id": 1379,
    "vorder": 125,
    "position": 0,
    "text": "چنان دید در خواب کز کوه هَند"
  },
  {
    "poem_id": 1379,
    "vorder": 126,
    "position": 1,
    "text": "درفشی برافراشتندی بلند"
  },
  {
    "poem_id": 1379,
    "vorder": 127,
    "position": 0,
    "text": "جوانی پدید آمدی خوب‌روی"
  },
  {
    "poem_id": 1379,
    "vorder": 128,
    "position": 1,
    "text": "سپاهی گران از پس پشت اوی"
  },
  {
    "poem_id": 1379,
    "vorder": 129,
    "position": 0,
    "text": "به دست چپش بر یکی موبدی"
  },
  {
    "poem_id": 1379,
    "vorder": 130,
    "position": 1,
    "text": "سوی راستش نامور بخردی"
  },
  {
    "poem_id": 1379,
    "vorder": 131,
    "position": 0,
    "text": "یکی پیش سام آمدی زان دو مرد"
  },
  {
    "poem_id": 1379,
    "vorder": 132,
    "position": 1,
    "text": "زبان بر گشادی به گفتار سرد"
  },
  {
    "poem_id": 1379,
    "vorder": 133,
    "position": 0,
    "text": "که ای مرد بی‌باک ناپاک رای"
  },
  {
    "poem_id": 1379,
    "vorder": 134,
    "position": 1,
    "text": "دل و دیده شسته ز شرم خدای"
  },
  {
    "poem_id": 1379,
    "vorder": 135,
    "position": 0,
    "text": "تو را دایه گر مرغ شاید همی"
  },
  {
    "poem_id": 1379,
    "vorder": 136,
    "position": 1,
    "text": "پس این پهلوانی چه باید همی"
  },
  {
    "poem_id": 1379,
    "vorder": 137,
    "position": 0,
    "text": "گر آهو است بر مرد موی سپید"
  },
  {
    "poem_id": 1379,
    "vorder": 138,
    "position": 1,
    "text": "تو را ریش و سر گشت چون خنگ بید"
  },
  {
    "poem_id": 1379,
    "vorder": 139,
    "position": 0,
    "text": "پس از آفریننده بیزار شو"
  },
  {
    "poem_id": 1379,
    "vorder": 140,
    "position": 1,
    "text": "که در تنتْ هر روز رنگی‌ست نو"
  },
  {
    "poem_id": 1379,
    "vorder": 141,
    "position": 0,
    "text": "پسر گر به نزدیک تو بود خوار"
  },
  {
    "poem_id": 1379,
    "vorder": 142,
    "position": 1,
    "text": "کنون هست پروردهٔ کردگار"
  },
  {
    "poem_id": 1379,
    "vorder": 143,
    "position": 0,
    "text": "کز او مهربان‌تر ورا دایه نیست"
  },
  {
    "poem_id": 1379,
    "vorder": 144,
    "position": 1,
    "text": "تو را خود به مهر اندرون مایه نیست"
  },
  {
    "poem_id": 1379,
    "vorder": 145,
    "position": 0,
    "text": "به خواب اندرون بر خروشید سام"
  },
  {
    "poem_id": 1379,
    "vorder": 146,
    "position": 1,
    "text": "چو شیر ژیان کاندر آید به دام"
  },
  {
    "poem_id": 1379,
    "vorder": 147,
    "position": 0,
    "text": "چو بیدار شد بخردان را بخواند"
  },
  {
    "poem_id": 1379,
    "vorder": 148,
    "position": 1,
    "text": "سران سپه را همه برنشاند"
  },
  {
    "poem_id": 1379,
    "vorder": 149,
    "position": 0,
    "text": "بیامد دمان سوی آن کوهسار"
  },
  {
    "poem_id": 1379,
    "vorder": 150,
    "position": 1,
    "text": "که افگندگان را کند خواستار"
  },
  {
    "poem_id": 1379,
    "vorder": 151,
    "position": 0,
    "text": "سر اندر ثریا یکی کوه دید"
  },
  {
    "poem_id": 1379,
    "vorder": 152,
    "position": 1,
    "text": "که گفتی ستاره بخواهد کشید"
  },
  {
    "poem_id": 1379,
    "vorder": 153,
    "position": 0,
    "text": "نشیمی از او برکشیده بلند"
  },
  {
    "poem_id": 1379,
    "vorder": 154,
    "position": 1,
    "text": "که ناید ز کیوان بر او بر گزند"
  },
  {
    "poem_id": 1379,
    "vorder": 155,
    "position": 0,
    "text": "فرو برده از شیز و صندل عمود"
  },
  {
    "poem_id": 1379,
    "vorder": 156,
    "position": 1,
    "text": "یک اندر دگر ساخته چوب عود"
  },
  {
    "poem_id": 1379,
    "vorder": 157,
    "position": 0,
    "text": "بدان سنگ خارا نگه کرد سام"
  },
  {
    "poem_id": 1379,
    "vorder": 158,
    "position": 1,
    "text": "بدان هیبت مرغ و هول کنام"
  },
  {
    "poem_id": 1379,
    "vorder": 159,
    "position": 0,
    "text": "یکی کاخ بد تارک اندر سماک"
  },
  {
    "poem_id": 1379,
    "vorder": 160,
    "position": 1,
    "text": "نه از دست رنج و نه از آب و خاک"
  },
  {
    "poem_id": 1379,
    "vorder": 161,
    "position": 0,
    "text": "ره بر شدن جست و کی بود راه"
  },
  {
    "poem_id": 1379,
    "vorder": 162,
    "position": 1,
    "text": "دد و دام را بر چنان جایگاه"
  },
  {
    "poem_id": 1379,
    "vorder": 163,
    "position": 0,
    "text": "ابر آفریننده کرد آفرین"
  },
  {
    "poem_id": 1379,
    "vorder": 164,
    "position": 1,
    "text": "بمالید رخسارگان بر زمین"
  },
  {
    "poem_id": 1379,
    "vorder": 165,
    "position": 0,
    "text": "همی گفت کای برتر از جایگاه"
  },
  {
    "poem_id": 1379,
    "vorder": 166,
    "position": 1,
    "text": "ز روشن روان و ز خورشید و ماه"
  },
  {
    "poem_id": 1379,
    "vorder": 167,
    "position": 0,
    "text": "گر این کودک از پاک پشت من است"
  },
  {
    "poem_id": 1379,
    "vorder": 168,
    "position": 1,
    "text": "نه از تخم بد گوهر آهرمن است"
  },
  {
    "poem_id": 1379,
    "vorder": 169,
    "position": 0,
    "text": "از این بر شدن بنده را دست گیر"
  },
  {
    "poem_id": 1379,
    "vorder": 170,
    "position": 1,
    "text": "مر این پر گنه را تو اندر پذیر"
  },
  {
    "poem_id": 1379,
    "vorder": 171,
    "position": 0,
    "text": "چنین گفت سیمرغ با پور سام"
  },
  {
    "poem_id": 1379,
    "vorder": 172,
    "position": 1,
    "text": "که ای دیده رنج نشیم و کنام"
  },
  {
    "poem_id": 1379,
    "vorder": 173,
    "position": 0,
    "text": "پدر سام یل پهلوان جهان"
  },
  {
    "poem_id": 1379,
    "vorder": 174,
    "position": 1,
    "text": "سرافرازتر کس میان مهان"
  },
  {
    "poem_id": 1379,
    "vorder": 175,
    "position": 0,
    "text": "بدین کوه فرزند جوی آمدست"
  },
  {
    "poem_id": 1379,
    "vorder": 176,
    "position": 1,
    "text": "تو را نزد او آب روی آمدست"
  },
  {
    "poem_id": 1379,
    "vorder": 177,
    "position": 0,
    "text": "روا باشد اکنون که بردارمت"
  },
  {
    "poem_id": 1379,
    "vorder": 178,
    "position": 1,
    "text": "بی‌آزار نزدیک او آرمت"
  },
  {
    "poem_id": 1379,
    "vorder": 179,
    "position": 0,
    "text": "به سیمرغ بنگر که دستان چه گفت"
  },
  {
    "poem_id": 1379,
    "vorder": 180,
    "position": 1,
    "text": "که سیر آمدستی همانا ز جفت"
  },
  {
    "poem_id": 1379,
    "vorder": 181,
    "position": 0,
    "text": "نشیم تو رخشنده گاه من است"
  },
  {
    "poem_id": 1379,
    "vorder": 182,
    "position": 1,
    "text": "دو پرّ تو فرّ کلاه من است"
  },
  {
    "poem_id": 1379,
    "vorder": 183,
    "position": 0,
    "text": "چنین داد پاسخ که گر تاج و گاه"
  },
  {
    "poem_id": 1379,
    "vorder": 184,
    "position": 1,
    "text": "ببینی و رسم کیانی کلاه"
  },
  {
    "poem_id": 1379,
    "vorder": 185,
    "position": 0,
    "text": "مگر کاین نشیمت نیاید به کار"
  },
  {
    "poem_id": 1379,
    "vorder": 186,
    "position": 1,
    "text": "یکی آزمایش کن از روزگار"
  },
  {
    "poem_id": 1379,
    "vorder": 187,
    "position": 0,
    "text": "ابا خویشتن بر یکی پرّ من"
  },
  {
    "poem_id": 1379,
    "vorder": 188,
    "position": 1,
    "text": "خجسته بود سایهٔ فرّ من"
  },
  {
    "poem_id": 1379,
    "vorder": 189,
    "position": 0,
    "text": "گرت هیچ سختی به روی آورند"
  },
  {
    "poem_id": 1379,
    "vorder": 190,
    "position": 1,
    "text": "ور از نیک و بد گفت و گوی آورند"
  },
  {
    "poem_id": 1379,
    "vorder": 191,
    "position": 0,
    "text": "بر آتش برافگن یکی پرّ من"
  },
  {
    "poem_id": 1379,
    "vorder": 192,
    "position": 1,
    "text": "ببینی هم اندر زمان فرّ من"
  },
  {
    "poem_id": 1379,
    "vorder": 193,
    "position": 0,
    "text": "که در زیر پرت بپرورده‌ام"
  },
  {
    "poem_id": 1379,
    "vorder": 194,
    "position": 1,
    "text": "ابا بچّگانت برآورده‌ام"
  },
  {
    "poem_id": 1379,
    "vorder": 195,
    "position": 0,
    "text": "همان گه بیایم چو ابر سیاه"
  },
  {
    "poem_id": 1379,
    "vorder": 196,
    "position": 1,
    "text": "بی‌آزارت آرم بدین جایگاه"
  },
  {
    "poem_id": 1379,
    "vorder": 197,
    "position": 0,
    "text": "فرامش مکن مهر دایه ز دل"
  },
  {
    "poem_id": 1379,
    "vorder": 198,
    "position": 1,
    "text": "که در دل مرا مهر تو دلگسل"
  },
  {
    "poem_id": 1379,
    "vorder": 199,
    "position": 0,
    "text": "دلش کرد پدرام و برداشتش"
  },
  {
    "poem_id": 1379,
    "vorder": 200,
    "position": 1,
    "text": "گرازان به ابر اندر افراشتش"
  },
  {
    "poem_id": 1379,
    "vorder": 201,
    "position": 0,
    "text": "ز پروازش آورد نزد پدر"
  },
  {
    "poem_id": 1379,
    "vorder": 202,
    "position": 1,
    "text": "رسیده به زیر برش موی سر"
  },
  {
    "poem_id": 1379,
    "vorder": 203,
    "position": 0,
    "text": "تنش پیلوار و به رخ چون بهار"
  },
  {
    "poem_id": 1379,
    "vorder": 204,
    "position": 1,
    "text": "پدر چون بدیدش بنالید زار"
  },
  {
    "poem_id": 1379,
    "vorder": 205,
    "position": 0,
    "text": "فرو برد سر پیش سیمرغ زود"
  },
  {
    "poem_id": 1379,
    "vorder": 206,
    "position": 1,
    "text": "نیایش همی بآفرین برفزود"
  },
  {
    "poem_id": 1379,
    "vorder": 207,
    "position": 0,
    "text": "سراپای کودک همی بنگرید"
  },
  {
    "poem_id": 1379,
    "vorder": 208,
    "position": 1,
    "text": "همی تاج و تخت کئی را سزید"
  },
  {
    "poem_id": 1379,
    "vorder": 209,
    "position": 0,
    "text": "بر و بازوی شیر و خورشید روی"
  },
  {
    "poem_id": 1379,
    "vorder": 210,
    "position": 1,
    "text": "دل پهلوان دست شمشیر جوی"
  },
  {
    "poem_id": 1379,
    "vorder": 211,
    "position": 0,
    "text": "سپیدش مژه دیدگان قیرگون"
  },
  {
    "poem_id": 1379,
    "vorder": 212,
    "position": 1,
    "text": "چو بسد لب و رخ به مانند خون"
  },
  {
    "poem_id": 1379,
    "vorder": 213,
    "position": 0,
    "text": "دل سام شد چون بهشت برین"
  },
  {
    "poem_id": 1379,
    "vorder": 214,
    "position": 1,
    "text": "بر آن پاک فرزند کرد آفرین"
  },
  {
    "poem_id": 1379,
    "vorder": 215,
    "position": 0,
    "text": "به من ای پسر گفت دل نرم کن"
  },
  {
    "poem_id": 1379,
    "vorder": 216,
    "position": 1,
    "text": "گذشته مکن یاد و دل گرم کن"
  },
  {
    "poem_id": 1379,
    "vorder": 217,
    "position": 0,
    "text": "منم کم‌ترین بنده یزدان پرست"
  },
  {
    "poem_id": 1379,
    "vorder": 218,
    "position": 1,
    "text": "از آن پس که آوردمت باز دست"
  },
  {
    "poem_id": 1379,
    "vorder": 219,
    "position": 0,
    "text": "پذیرفته‌ام از خدای بزرگ"
  },
  {
    "poem_id": 1379,
    "vorder": 220,
    "position": 1,
    "text": "که دل بر تو هرگز ندارم سترگ"
  },
  {
    "poem_id": 1379,
    "vorder": 221,
    "position": 0,
    "text": "بجویم هوای تو از نیک و بد"
  },
  {
    "poem_id": 1379,
    "vorder": 222,
    "position": 1,
    "text": "از این پس چه خواهی تو چونان سزد"
  },
  {
    "poem_id": 1379,
    "vorder": 223,
    "position": 0,
    "text": "تنش را یکی پهلوانی قبای"
  },
  {
    "poem_id": 1379,
    "vorder": 224,
    "position": 1,
    "text": "بپوشید و از کوه بگزارد پای"
  },
  {
    "poem_id": 1379,
    "vorder": 225,
    "position": 0,
    "text": "فرود آمد از کوه و بالای خواست"
  },
  {
    "poem_id": 1379,
    "vorder": 226,
    "position": 1,
    "text": "همان جامهٔ خسرو آرای خواست"
  },
  {
    "poem_id": 1379,
    "vorder": 227,
    "position": 0,
    "text": "سپه یک‌سره پیش سام آمدند"
  },
  {
    "poem_id": 1379,
    "vorder": 228,
    "position": 1,
    "text": "گشاده دل و شادکام آمدند"
  },
  {
    "poem_id": 1379,
    "vorder": 229,
    "position": 0,
    "text": "تبیره‌زنان پیش بردند پیل"
  },
  {
    "poem_id": 1379,
    "vorder": 230,
    "position": 1,
    "text": "برآمد یکی گرد مانند نیل"
  },
  {
    "poem_id": 1379,
    "vorder": 231,
    "position": 0,
    "text": "خروشیدن کوس با کرّه‌نای"
  },
  {
    "poem_id": 1379,
    "vorder": 232,
    "position": 1,
    "text": "همان زنگ زرین و هندی درای"
  },
  {
    "poem_id": 1379,
    "vorder": 233,
    "position": 0,
    "text": "سواران همه نعره برداشتند"
  },
  {
    "poem_id": 1379,
    "vorder": 234,
    "position": 1,
    "text": "بدان خرّمی راه بگذاشتند"
  },
  {
    "poem_id": 1379,
    "vorder": 235,
    "position": 0,
    "text": "چو اندر هوا شب علم برگشاد"
  },
  {
    "poem_id": 1379,
    "vorder": 236,
    "position": 1,
    "text": "شد آن روی رومیش زنگی نژاد"
  },
  {
    "poem_id": 1379,
    "vorder": 237,
    "position": 0,
    "text": "بر آن دشت هامون فرود آمدند"
  },
  {
    "poem_id": 1379,
    "vorder": 238,
    "position": 1,
    "text": "بخفتند و یکبار دم بر زدند"
  },
  {
    "poem_id": 1379,
    "vorder": 239,
    "position": 0,
    "text": "چو بر چرخ گردان درفشنده شید"
  },
  {
    "poem_id": 1379,
    "vorder": 240,
    "position": 1,
    "text": "یکی خیمه زد از حریر سپید"
  },
  {
    "poem_id": 1379,
    "vorder": 241,
    "position": 0,
    "text": "به شادی به شهر اندرون آمدند"
  },
  {
    "poem_id": 1379,
    "vorder": 242,
    "position": 1,
    "text": "ابا پهلوانی فزون آمدند"
  }
]