[
  {
    "poem_id": 87959,
    "vorder": 1,
    "position": 0,
    "text": "سواران رسیدند بر تیغ کوه"
  },
  {
    "poem_id": 87959,
    "vorder": 2,
    "position": 1,
    "text": "سپاه اندر آمد گروها گروه"
  },
  {
    "poem_id": 87959,
    "vorder": 3,
    "position": 0,
    "text": "سپردار با نیزه‌ور سی هزار"
  },
  {
    "poem_id": 87959,
    "vorder": 4,
    "position": 1,
    "text": "همه رزمجوی از در کارزار"
  },
  {
    "poem_id": 87959,
    "vorder": 5,
    "position": 0,
    "text": "سوار و پیاده بزرین کمر"
  },
  {
    "poem_id": 87959,
    "vorder": 6,
    "position": 1,
    "text": "همه تیغ دار و همه نیزه‌ور"
  },
  {
    "poem_id": 87959,
    "vorder": 7,
    "position": 0,
    "text": "ز بس ترگ زرین و زرین درفش"
  },
  {
    "poem_id": 87959,
    "vorder": 8,
    "position": 1,
    "text": "ز گوپال زرین و زرینه کفش"
  },
  {
    "poem_id": 87959,
    "vorder": 9,
    "position": 0,
    "text": "تو گفتی به کان اندرون زر نماند"
  },
  {
    "poem_id": 87959,
    "vorder": 10,
    "position": 1,
    "text": "برآمد یکی ابر و گوهر فشاند"
  },
  {
    "poem_id": 87959,
    "vorder": 11,
    "position": 0,
    "text": "ز بانگ تبیره میان دو کوه"
  },
  {
    "poem_id": 87959,
    "vorder": 12,
    "position": 1,
    "text": "دل کرگس اندر هوا شد ستوه"
  },
  {
    "poem_id": 87959,
    "vorder": 13,
    "position": 0,
    "text": "چنین گفت کاکنون درفش مهان"
  },
  {
    "poem_id": 87959,
    "vorder": 14,
    "position": 1,
    "text": "بگو و مدار ایچ گونه نهان"
  },
  {
    "poem_id": 87959,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت کان پیل پیکر درفش"
  },
  {
    "poem_id": 87959,
    "vorder": 16,
    "position": 1,
    "text": "سواران و آن تیغهای بنفش"
  },
  {
    "poem_id": 87959,
    "vorder": 17,
    "position": 0,
    "text": "کرا باشد اندر میان سپاه"
  },
  {
    "poem_id": 87959,
    "vorder": 18,
    "position": 1,
    "text": "چنین آلت ساز و این دستگاه"
  },
  {
    "poem_id": 87959,
    "vorder": 19,
    "position": 0,
    "text": "چو بشنید گفتار او را تخوار"
  },
  {
    "poem_id": 87959,
    "vorder": 20,
    "position": 1,
    "text": "چنین داد پاسخ که ای شهریار"
  },
  {
    "poem_id": 87959,
    "vorder": 21,
    "position": 0,
    "text": "پس پشت طوس سپهبد بود"
  },
  {
    "poem_id": 87959,
    "vorder": 22,
    "position": 1,
    "text": "که در کینه پیکار او بد بود"
  },
  {
    "poem_id": 87959,
    "vorder": 23,
    "position": 0,
    "text": "درفشی پس پشت او دیگرست"
  },
  {
    "poem_id": 87959,
    "vorder": 24,
    "position": 1,
    "text": "چو خورشید تابان بدو پیکرست"
  },
  {
    "poem_id": 87959,
    "vorder": 25,
    "position": 0,
    "text": "برادر پدر تست با فر و کام"
  },
  {
    "poem_id": 87959,
    "vorder": 26,
    "position": 1,
    "text": "سپهبد فریبرز کاوس نام"
  },
  {
    "poem_id": 87959,
    "vorder": 27,
    "position": 0,
    "text": "پسش ماه پیکر درفشی بزرگ"
  },
  {
    "poem_id": 87959,
    "vorder": 28,
    "position": 1,
    "text": "دلیران بسیار و گردی سترگ"
  },
  {
    "poem_id": 87959,
    "vorder": 29,
    "position": 0,
    "text": "ورانام گستهم گژدهم خوان"
  },
  {
    "poem_id": 87959,
    "vorder": 30,
    "position": 1,
    "text": "که لرزان بود پیل ازو ز استخوان"
  },
  {
    "poem_id": 87959,
    "vorder": 31,
    "position": 0,
    "text": "پسش گرگ پیکر درفشی دراز"
  },
  {
    "poem_id": 87959,
    "vorder": 32,
    "position": 1,
    "text": "بگردش بسی مردم رزمساز"
  },
  {
    "poem_id": 87959,
    "vorder": 33,
    "position": 0,
    "text": "بزیر اندرش زنگهٔ شاوران"
  },
  {
    "poem_id": 87959,
    "vorder": 34,
    "position": 1,
    "text": "دلیران و گردان و کنداوران"
  },
  {
    "poem_id": 87959,
    "vorder": 35,
    "position": 0,
    "text": "درفشی پرستار پیکر چو ماه"
  },
  {
    "poem_id": 87959,
    "vorder": 36,
    "position": 1,
    "text": "تنش لعل و جعد از حریر سیاه"
  },
  {
    "poem_id": 87959,
    "vorder": 37,
    "position": 0,
    "text": "ورا بیژن گیو راند همی"
  },
  {
    "poem_id": 87959,
    "vorder": 38,
    "position": 1,
    "text": "که خون بآسمان برفشاند همی"
  },
  {
    "poem_id": 87959,
    "vorder": 39,
    "position": 0,
    "text": "درفشی کجا پیکرش هست ببر"
  },
  {
    "poem_id": 87959,
    "vorder": 40,
    "position": 1,
    "text": "همی بشکند زو میان هژبر"
  },
  {
    "poem_id": 87959,
    "vorder": 41,
    "position": 0,
    "text": "ورا گرد شیدوش دارد بپای"
  },
  {
    "poem_id": 87959,
    "vorder": 42,
    "position": 1,
    "text": "چو کوهی همی اندر آید ز جای"
  },
  {
    "poem_id": 87959,
    "vorder": 43,
    "position": 0,
    "text": "درفش گرازست پیکر گراز"
  },
  {
    "poem_id": 87959,
    "vorder": 44,
    "position": 1,
    "text": "سپاهی کمندافگن و رزم ساز"
  },
  {
    "poem_id": 87959,
    "vorder": 45,
    "position": 0,
    "text": "درفشی کجا پیکرش گاومیش"
  },
  {
    "poem_id": 87959,
    "vorder": 46,
    "position": 1,
    "text": "سپاه از پس و نیزه‌داران ز پیش"
  },
  {
    "poem_id": 87959,
    "vorder": 47,
    "position": 0,
    "text": "چنان دان که آن شهره فرهاد راست"
  },
  {
    "poem_id": 87959,
    "vorder": 48,
    "position": 1,
    "text": "که گویی مگر با سپهرست راست"
  },
  {
    "poem_id": 87959,
    "vorder": 49,
    "position": 0,
    "text": "درفشی کجا پیکرش دیزه گرگ"
  },
  {
    "poem_id": 87959,
    "vorder": 50,
    "position": 1,
    "text": "نشان سپهدار گیو سترگ"
  },
  {
    "poem_id": 87959,
    "vorder": 51,
    "position": 0,
    "text": "درفشی کجا شیر پیکر بزر"
  },
  {
    "poem_id": 87959,
    "vorder": 52,
    "position": 1,
    "text": "که گودرز کشواد دارد بسر"
  },
  {
    "poem_id": 87959,
    "vorder": 53,
    "position": 0,
    "text": "درفشی پلنگست پیکر گراز"
  },
  {
    "poem_id": 87959,
    "vorder": 54,
    "position": 1,
    "text": "پس ریونیزست با کام و ناز"
  },
  {
    "poem_id": 87959,
    "vorder": 55,
    "position": 0,
    "text": "درفشی کجا آهویش پیکرست"
  },
  {
    "poem_id": 87959,
    "vorder": 56,
    "position": 1,
    "text": "که نستوه گودرز با لشکرست"
  },
  {
    "poem_id": 87959,
    "vorder": 57,
    "position": 0,
    "text": "درفشی کجا غرم دارد نشان"
  },
  {
    "poem_id": 87959,
    "vorder": 58,
    "position": 1,
    "text": "ز بهرام گودرز کشوادگان"
  },
  {
    "poem_id": 87959,
    "vorder": 59,
    "position": 0,
    "text": "همه شیرمردند و گرد و سوار"
  },
  {
    "poem_id": 87959,
    "vorder": 60,
    "position": 1,
    "text": "یکایک بگویم درازست کار"
  },
  {
    "poem_id": 87959,
    "vorder": 61,
    "position": 0,
    "text": "چو یک‌یک بگفت از نشان گوان"
  },
  {
    "poem_id": 87959,
    "vorder": 62,
    "position": 1,
    "text": "بپیش فرود آن شه خسروان"
  },
  {
    "poem_id": 87959,
    "vorder": 63,
    "position": 0,
    "text": "مهان و کهان را همه بنگرید"
  },
  {
    "poem_id": 87959,
    "vorder": 64,
    "position": 1,
    "text": "ز شادی رخش همچو گل بشکفید"
  }
]