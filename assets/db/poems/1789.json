[
  {
    "poem_id": 1789,
    "vorder": 1,
    "position": 0,
    "text": "برین‌گونه یک چند گیتی بخورد"
  },
  {
    "poem_id": 1789,
    "vorder": 2,
    "position": 1,
    "text": "به رزم و به بزم و به ننگ و نبرد"
  },
  {
    "poem_id": 1789,
    "vorder": 3,
    "position": 0,
    "text": "پس آگاهی آمد به هند و به روم"
  },
  {
    "poem_id": 1789,
    "vorder": 4,
    "position": 1,
    "text": "به ترک و به چین و به آباد بوم"
  },
  {
    "poem_id": 1789,
    "vorder": 5,
    "position": 0,
    "text": "که بهرام را دل به بازیست بس"
  },
  {
    "poem_id": 1789,
    "vorder": 6,
    "position": 1,
    "text": "کسی را ز گیتی ندارد به کس"
  },
  {
    "poem_id": 1789,
    "vorder": 7,
    "position": 0,
    "text": "طلایه نه و دیده‌بان نیز نه"
  },
  {
    "poem_id": 1789,
    "vorder": 8,
    "position": 1,
    "text": "به مرز اندرون پهلوان نیز نه"
  },
  {
    "poem_id": 1789,
    "vorder": 9,
    "position": 0,
    "text": "به بازی همی بگذارند جهان"
  },
  {
    "poem_id": 1789,
    "vorder": 10,
    "position": 1,
    "text": "نداند همی آشکار و نهان"
  },
  {
    "poem_id": 1789,
    "vorder": 11,
    "position": 0,
    "text": "چو خاقان چین این سخنها شنید"
  },
  {
    "poem_id": 1789,
    "vorder": 12,
    "position": 1,
    "text": "ز چین و ختن لشکری برگزید"
  },
  {
    "poem_id": 1789,
    "vorder": 13,
    "position": 0,
    "text": "درم داد و سر سوی ایران نهاد"
  },
  {
    "poem_id": 1789,
    "vorder": 14,
    "position": 1,
    "text": "کسی را نیامد ز بهرام یاد"
  },
  {
    "poem_id": 1789,
    "vorder": 15,
    "position": 0,
    "text": "وزان سوی قیصر سپه برگرفت"
  },
  {
    "poem_id": 1789,
    "vorder": 16,
    "position": 1,
    "text": "همه کشور روم لشگر گرفت"
  },
  {
    "poem_id": 1789,
    "vorder": 17,
    "position": 0,
    "text": "به ایران چو آگاهی آمد ز روم"
  },
  {
    "poem_id": 1789,
    "vorder": 18,
    "position": 1,
    "text": "ز هند و ز چین و ز آباد بوم"
  },
  {
    "poem_id": 1789,
    "vorder": 19,
    "position": 0,
    "text": "که قیصر سپه کرد و لشکر کشید"
  },
  {
    "poem_id": 1789,
    "vorder": 20,
    "position": 1,
    "text": "ز چین و ختن لشکر آمد پدید"
  },
  {
    "poem_id": 1789,
    "vorder": 21,
    "position": 0,
    "text": "به ایران هرانکس که بد پیش‌رو"
  },
  {
    "poem_id": 1789,
    "vorder": 22,
    "position": 1,
    "text": "ز پیران و از نامداران نو"
  },
  {
    "poem_id": 1789,
    "vorder": 23,
    "position": 0,
    "text": "همه پیش بهرام گور آمدند"
  },
  {
    "poem_id": 1789,
    "vorder": 24,
    "position": 1,
    "text": "پر از خشم و پیکار و شور آمدند"
  },
  {
    "poem_id": 1789,
    "vorder": 25,
    "position": 0,
    "text": "بگفتند با شاه چندی درشت"
  },
  {
    "poem_id": 1789,
    "vorder": 26,
    "position": 1,
    "text": "که بخت فروزانت بنمود پشت"
  },
  {
    "poem_id": 1789,
    "vorder": 27,
    "position": 0,
    "text": "سر رزمجویان به رزم اندرست"
  },
  {
    "poem_id": 1789,
    "vorder": 28,
    "position": 1,
    "text": "ترا دل به بازی و بزم اندرست"
  },
  {
    "poem_id": 1789,
    "vorder": 29,
    "position": 0,
    "text": "به چشم تو خوارست گنج و سپاه"
  },
  {
    "poem_id": 1789,
    "vorder": 30,
    "position": 1,
    "text": "هم‌ان تاج ایران و هم تخت و گاه"
  },
  {
    "poem_id": 1789,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد پاسخ جهاندار شاه"
  },
  {
    "poem_id": 1789,
    "vorder": 32,
    "position": 1,
    "text": "بدان موبدان نماینده راه"
  },
  {
    "poem_id": 1789,
    "vorder": 33,
    "position": 0,
    "text": "که دادار گیهان مرا یاورست"
  },
  {
    "poem_id": 1789,
    "vorder": 34,
    "position": 1,
    "text": "که از دانش برتران برترست"
  },
  {
    "poem_id": 1789,
    "vorder": 35,
    "position": 0,
    "text": "به نیروی آن پادشاه بزرگ"
  },
  {
    "poem_id": 1789,
    "vorder": 36,
    "position": 1,
    "text": "که ایران نگه دارم از چنگ گرگ"
  },
  {
    "poem_id": 1789,
    "vorder": 37,
    "position": 0,
    "text": "به بخت و سپاه و به شمشیر و گنج"
  },
  {
    "poem_id": 1789,
    "vorder": 38,
    "position": 1,
    "text": "ز کشور بگردانم این درد و رنج"
  },
  {
    "poem_id": 1789,
    "vorder": 39,
    "position": 0,
    "text": "همی کرد بازی بدان همنشان"
  },
  {
    "poem_id": 1789,
    "vorder": 40,
    "position": 1,
    "text": "وزو پر ز خون دیدهٔ سرکشان"
  },
  {
    "poem_id": 1789,
    "vorder": 41,
    "position": 0,
    "text": "همی گفت هرکس کزین پادشا"
  },
  {
    "poem_id": 1789,
    "vorder": 42,
    "position": 1,
    "text": "بپیچد دل مردم پارسا"
  },
  {
    "poem_id": 1789,
    "vorder": 43,
    "position": 0,
    "text": "دل شاه بهرام بیدار بود"
  },
  {
    "poem_id": 1789,
    "vorder": 44,
    "position": 1,
    "text": "ازین آگهی پر ز تیمار بود"
  },
  {
    "poem_id": 1789,
    "vorder": 45,
    "position": 0,
    "text": "همی ساختی کار لشکر نهان"
  },
  {
    "poem_id": 1789,
    "vorder": 46,
    "position": 1,
    "text": "ندانست رازش کس اندر جهان"
  },
  {
    "poem_id": 1789,
    "vorder": 47,
    "position": 0,
    "text": "همه شهر ایران ز کارش به بیم"
  },
  {
    "poem_id": 1789,
    "vorder": 48,
    "position": 1,
    "text": "از اندیشگان دل شده به دو نیم"
  },
  {
    "poem_id": 1789,
    "vorder": 49,
    "position": 0,
    "text": "همه گشته نومید زان شهریار"
  },
  {
    "poem_id": 1789,
    "vorder": 50,
    "position": 1,
    "text": "تن و کدخدایی گرفتند خوار"
  },
  {
    "poem_id": 1789,
    "vorder": 51,
    "position": 0,
    "text": "پس آگاهی آمد به بهرامشاه"
  },
  {
    "poem_id": 1789,
    "vorder": 52,
    "position": 1,
    "text": "که آمد ز چین اندر ایران سپاه"
  },
  {
    "poem_id": 1789,
    "vorder": 53,
    "position": 0,
    "text": "جهاندار گستهم را پیش خواند"
  },
  {
    "poem_id": 1789,
    "vorder": 54,
    "position": 1,
    "text": "ز خاقان چین چند با او براند"
  },
  {
    "poem_id": 1789,
    "vorder": 55,
    "position": 0,
    "text": "کجا پهلوان بود و دستور بود"
  },
  {
    "poem_id": 1789,
    "vorder": 56,
    "position": 1,
    "text": "چو رزم آمدی پیش رنجور بود"
  },
  {
    "poem_id": 1789,
    "vorder": 57,
    "position": 0,
    "text": "دگر مهرپیروز به زاد را"
  },
  {
    "poem_id": 1789,
    "vorder": 58,
    "position": 1,
    "text": "سوم مهربرزین خراد را"
  },
  {
    "poem_id": 1789,
    "vorder": 59,
    "position": 0,
    "text": "چو بهرام پیروز بهرامیان"
  },
  {
    "poem_id": 1789,
    "vorder": 60,
    "position": 1,
    "text": "خزروان رهام با اندیان"
  },
  {
    "poem_id": 1789,
    "vorder": 61,
    "position": 0,
    "text": "یکی شاه گیلان یکی شاه ری"
  },
  {
    "poem_id": 1789,
    "vorder": 62,
    "position": 1,
    "text": "که بودند در رای هشیار پی"
  },
  {
    "poem_id": 1789,
    "vorder": 63,
    "position": 0,
    "text": "دگر داد برزین رزم‌آزمای"
  },
  {
    "poem_id": 1789,
    "vorder": 64,
    "position": 1,
    "text": "کجا زاولستان بدو بد به پای"
  },
  {
    "poem_id": 1789,
    "vorder": 65,
    "position": 0,
    "text": "بیاورد چون قارن برزمهر"
  },
  {
    "poem_id": 1789,
    "vorder": 66,
    "position": 1,
    "text": "دگر دادبرزین آژنگ چهر"
  },
  {
    "poem_id": 1789,
    "vorder": 67,
    "position": 0,
    "text": "گزین کرد ز ایرانیان سی‌هزار"
  },
  {
    "poem_id": 1789,
    "vorder": 68,
    "position": 1,
    "text": "خردمند و شایستهٔ کارزار"
  },
  {
    "poem_id": 1789,
    "vorder": 69,
    "position": 0,
    "text": "برادرش را داد تخت و کلاه"
  },
  {
    "poem_id": 1789,
    "vorder": 70,
    "position": 1,
    "text": "که تا گنج و لشکر بدارد نگاه"
  },
  {
    "poem_id": 1789,
    "vorder": 71,
    "position": 0,
    "text": "خردمند نرسی آزاد چهر"
  },
  {
    "poem_id": 1789,
    "vorder": 72,
    "position": 1,
    "text": "همش فر و دین بود هم داد و مهر"
  },
  {
    "poem_id": 1789,
    "vorder": 73,
    "position": 0,
    "text": "وزان جایگه لشکر اندر کشید"
  },
  {
    "poem_id": 1789,
    "vorder": 74,
    "position": 1,
    "text": "سوی آذرآبادگان پرکشید"
  },
  {
    "poem_id": 1789,
    "vorder": 75,
    "position": 0,
    "text": "چو از پارس لشکر فراوان ببرد"
  },
  {
    "poem_id": 1789,
    "vorder": 76,
    "position": 1,
    "text": "چنین بود رای بزرگان و خرد"
  },
  {
    "poem_id": 1789,
    "vorder": 77,
    "position": 0,
    "text": "که از جنگ بگریخت بهرامشاه"
  },
  {
    "poem_id": 1789,
    "vorder": 78,
    "position": 1,
    "text": "وزان سوی آذر کشیدست راه"
  },
  {
    "poem_id": 1789,
    "vorder": 79,
    "position": 0,
    "text": "چو بهرام رخ سوی دریا نهاد"
  },
  {
    "poem_id": 1789,
    "vorder": 80,
    "position": 1,
    "text": "رسولی ز قیصر بیامد چو باد"
  },
  {
    "poem_id": 1789,
    "vorder": 81,
    "position": 0,
    "text": "به کاخیش نرسی فرود آورید"
  },
  {
    "poem_id": 1789,
    "vorder": 82,
    "position": 1,
    "text": "گرانمایه جایی چنانچون سزید"
  },
  {
    "poem_id": 1789,
    "vorder": 83,
    "position": 0,
    "text": "نشستند با رای‌زن بخردان"
  },
  {
    "poem_id": 1789,
    "vorder": 84,
    "position": 1,
    "text": "به نزدیک نرسی همه موبدان"
  },
  {
    "poem_id": 1789,
    "vorder": 85,
    "position": 0,
    "text": "سراسر سخنشان بد از شهریار"
  },
  {
    "poem_id": 1789,
    "vorder": 86,
    "position": 1,
    "text": "که داد او به باد آن همه روزگار"
  },
  {
    "poem_id": 1789,
    "vorder": 87,
    "position": 0,
    "text": "سوی موبدان موبد آمد سپاه"
  },
  {
    "poem_id": 1789,
    "vorder": 88,
    "position": 1,
    "text": "به آگاه بودن ز بهرامشاه"
  },
  {
    "poem_id": 1789,
    "vorder": 89,
    "position": 0,
    "text": "که بر ما همی رنج بپراگند"
  },
  {
    "poem_id": 1789,
    "vorder": 90,
    "position": 1,
    "text": "چرا هم ز لشکر نه گنج آگند"
  },
  {
    "poem_id": 1789,
    "vorder": 91,
    "position": 0,
    "text": "به هرجای زر برفشاند همی"
  },
  {
    "poem_id": 1789,
    "vorder": 92,
    "position": 1,
    "text": "هم ارج جوانی نداند همی"
  },
  {
    "poem_id": 1789,
    "vorder": 93,
    "position": 0,
    "text": "پراگنده شد شهری و لشکری"
  },
  {
    "poem_id": 1789,
    "vorder": 94,
    "position": 1,
    "text": "همی جست هرکس ره مهتری"
  },
  {
    "poem_id": 1789,
    "vorder": 95,
    "position": 0,
    "text": "کنون زو نداریم ما آگهی"
  },
  {
    "poem_id": 1789,
    "vorder": 96,
    "position": 1,
    "text": "بما بازگردد بدی ار بهی"
  },
  {
    "poem_id": 1789,
    "vorder": 97,
    "position": 0,
    "text": "ازان پس چو گفتارها شد کهن"
  },
  {
    "poem_id": 1789,
    "vorder": 98,
    "position": 1,
    "text": "برین بر نهادند یکسر سخن"
  },
  {
    "poem_id": 1789,
    "vorder": 99,
    "position": 0,
    "text": "کز ایران یکی مرد با آفرین"
  },
  {
    "poem_id": 1789,
    "vorder": 100,
    "position": 1,
    "text": "فرستند نزدیک خاقان چین"
  },
  {
    "poem_id": 1789,
    "vorder": 101,
    "position": 0,
    "text": "که بنشین ازین غارت و تاختن"
  },
  {
    "poem_id": 1789,
    "vorder": 102,
    "position": 1,
    "text": "ز هرگونه باید برانداختن"
  },
  {
    "poem_id": 1789,
    "vorder": 103,
    "position": 0,
    "text": "مگر بوم ایران بماند به جای"
  },
  {
    "poem_id": 1789,
    "vorder": 104,
    "position": 1,
    "text": "چو از خانه آواره شد کدخدای"
  },
  {
    "poem_id": 1789,
    "vorder": 105,
    "position": 0,
    "text": "چنین گفت نرسی که این روی نیست"
  },
  {
    "poem_id": 1789,
    "vorder": 106,
    "position": 1,
    "text": "مر این آب را در جهان جوی نیست"
  },
  {
    "poem_id": 1789,
    "vorder": 107,
    "position": 0,
    "text": "سلیحست و گنجست و مردان مرد"
  },
  {
    "poem_id": 1789,
    "vorder": 108,
    "position": 1,
    "text": "کز آتش به خنجر برآرند گرد"
  },
  {
    "poem_id": 1789,
    "vorder": 109,
    "position": 0,
    "text": "چو نومیدی آمد ز بهرامشاه"
  },
  {
    "poem_id": 1789,
    "vorder": 110,
    "position": 1,
    "text": "کجا رفت با خوارمایه سپاه"
  },
  {
    "poem_id": 1789,
    "vorder": 111,
    "position": 0,
    "text": "گر اندیشهٔ بد کنی بد رسد"
  },
  {
    "poem_id": 1789,
    "vorder": 112,
    "position": 1,
    "text": "چه باید به شاهان چنین گشت بد"
  },
  {
    "poem_id": 1789,
    "vorder": 113,
    "position": 0,
    "text": "شنیدند ایرانیان این سخن"
  },
  {
    "poem_id": 1789,
    "vorder": 114,
    "position": 1,
    "text": "یکی پاسخ کژ فگندند بن"
  },
  {
    "poem_id": 1789,
    "vorder": 115,
    "position": 0,
    "text": "که بهرام ز ایدر سپاهی ببرد"
  },
  {
    "poem_id": 1789,
    "vorder": 116,
    "position": 1,
    "text": "که ما را به غم دل بباید سپرد"
  },
  {
    "poem_id": 1789,
    "vorder": 117,
    "position": 0,
    "text": "چو خاقان بیاید به ایران به جنگ"
  },
  {
    "poem_id": 1789,
    "vorder": 118,
    "position": 1,
    "text": "نماند برین بوم ما بوی و رنگ"
  },
  {
    "poem_id": 1789,
    "vorder": 119,
    "position": 0,
    "text": "سپاهی و نرسی نماند به جای"
  },
  {
    "poem_id": 1789,
    "vorder": 120,
    "position": 1,
    "text": "بکوبند بر خیره ما را به پای"
  },
  {
    "poem_id": 1789,
    "vorder": 121,
    "position": 0,
    "text": "یکی چاره سازیم تا جای ما"
  },
  {
    "poem_id": 1789,
    "vorder": 122,
    "position": 1,
    "text": "بماند ز تن نگسلد پای ما"
  },
  {
    "poem_id": 1789,
    "vorder": 123,
    "position": 0,
    "text": "یکی موبدی بود نامش همای"
  },
  {
    "poem_id": 1789,
    "vorder": 124,
    "position": 1,
    "text": "هنرمند و بادانش و پاک‌رای"
  },
  {
    "poem_id": 1789,
    "vorder": 125,
    "position": 0,
    "text": "ورا برگزیدند ایرانیان"
  },
  {
    "poem_id": 1789,
    "vorder": 126,
    "position": 1,
    "text": "که آن چاره را تنگ بندد میان"
  },
  {
    "poem_id": 1789,
    "vorder": 127,
    "position": 0,
    "text": "نوشتند پس نامه‌ای بنده‌وار"
  },
  {
    "poem_id": 1789,
    "vorder": 128,
    "position": 1,
    "text": "از ایران به نزدیک آن شهریار"
  },
  {
    "poem_id": 1789,
    "vorder": 129,
    "position": 0,
    "text": "سرنامه گفتند ما بنده‌ایم"
  },
  {
    "poem_id": 1789,
    "vorder": 130,
    "position": 1,
    "text": "به فرمان و رایت سرافگنده‌ایم"
  },
  {
    "poem_id": 1789,
    "vorder": 131,
    "position": 0,
    "text": "ز چیزی که باشد به ایران زمین"
  },
  {
    "poem_id": 1789,
    "vorder": 132,
    "position": 1,
    "text": "فرستیم نزدیک خاقان چین"
  },
  {
    "poem_id": 1789,
    "vorder": 133,
    "position": 0,
    "text": "همان نیز با هدیه و باژ و ساو"
  },
  {
    "poem_id": 1789,
    "vorder": 134,
    "position": 1,
    "text": "که با جنگ ترکان نداریم تاو"
  },
  {
    "poem_id": 1789,
    "vorder": 135,
    "position": 0,
    "text": "بیامد ز ایران خجسته همای"
  },
  {
    "poem_id": 1789,
    "vorder": 136,
    "position": 1,
    "text": "خود و نامداران پاکیزه‌رای"
  },
  {
    "poem_id": 1789,
    "vorder": 137,
    "position": 0,
    "text": "پیام بزرگان به خاقان بداد"
  },
  {
    "poem_id": 1789,
    "vorder": 138,
    "position": 1,
    "text": "دل شاه ترکان بدان گشت شاد"
  },
  {
    "poem_id": 1789,
    "vorder": 139,
    "position": 0,
    "text": "وزان جستن تیز بهرامشاه"
  },
  {
    "poem_id": 1789,
    "vorder": 140,
    "position": 1,
    "text": "گریزان بشد تازیان با سپاه"
  },
  {
    "poem_id": 1789,
    "vorder": 141,
    "position": 0,
    "text": "به پیش گرانمایه خاقان بگفت"
  },
  {
    "poem_id": 1789,
    "vorder": 142,
    "position": 1,
    "text": "دل و جان خاقان چو گل برشکفت"
  },
  {
    "poem_id": 1789,
    "vorder": 143,
    "position": 0,
    "text": "به ترکان چنین گفت خاقان چین"
  },
  {
    "poem_id": 1789,
    "vorder": 144,
    "position": 1,
    "text": "که ما برنهادیم بر چرخ زین"
  },
  {
    "poem_id": 1789,
    "vorder": 145,
    "position": 0,
    "text": "که آورد بی‌جنگ ایران به چنگ؟"
  },
  {
    "poem_id": 1789,
    "vorder": 146,
    "position": 1,
    "text": "مگر ما به رای و به هوش و درنگ؟"
  },
  {
    "poem_id": 1789,
    "vorder": 147,
    "position": 0,
    "text": "فرستاده را چیز بسیار داد"
  },
  {
    "poem_id": 1789,
    "vorder": 148,
    "position": 1,
    "text": "درم داد چینی و دینار داد"
  },
  {
    "poem_id": 1789,
    "vorder": 149,
    "position": 0,
    "text": "یکی پاسخ نامه بنوشت و گفت"
  },
  {
    "poem_id": 1789,
    "vorder": 150,
    "position": 1,
    "text": "که با جان پاکان خرد باد جفت"
  },
  {
    "poem_id": 1789,
    "vorder": 151,
    "position": 0,
    "text": "بدان بازگشتیم همداستان"
  },
  {
    "poem_id": 1789,
    "vorder": 152,
    "position": 1,
    "text": "که گفت این فرستادهٔ راستان"
  },
  {
    "poem_id": 1789,
    "vorder": 153,
    "position": 0,
    "text": "چو من با سپاه اندرآیم به مرو"
  },
  {
    "poem_id": 1789,
    "vorder": 154,
    "position": 1,
    "text": "کنم روی کشور چو پر تذرو"
  },
  {
    "poem_id": 1789,
    "vorder": 155,
    "position": 0,
    "text": "به رای و به داد و به رنگ و به بوی"
  },
  {
    "poem_id": 1789,
    "vorder": 156,
    "position": 1,
    "text": "ابا آب شیر اندر آرم به جوی"
  },
  {
    "poem_id": 1789,
    "vorder": 157,
    "position": 0,
    "text": "بباشیم تا باژ ایران رسد"
  },
  {
    "poem_id": 1789,
    "vorder": 158,
    "position": 1,
    "text": "همان هدیه و ساو شیران رسد"
  },
  {
    "poem_id": 1789,
    "vorder": 159,
    "position": 0,
    "text": "به مرو آیم و زاستر نگذرم"
  },
  {
    "poem_id": 1789,
    "vorder": 160,
    "position": 1,
    "text": "نخواهم که رنج آید از لشکرم"
  },
  {
    "poem_id": 1789,
    "vorder": 161,
    "position": 0,
    "text": "فرستاده تازان به ایران رسید"
  },
  {
    "poem_id": 1789,
    "vorder": 162,
    "position": 1,
    "text": "ز خاقان بگفت آنچ دید و شنید"
  },
  {
    "poem_id": 1789,
    "vorder": 163,
    "position": 0,
    "text": "به مرو اندر آورد خاقان سپاه"
  },
  {
    "poem_id": 1789,
    "vorder": 164,
    "position": 1,
    "text": "جهان شد ز گرد سواران سیاه"
  },
  {
    "poem_id": 1789,
    "vorder": 165,
    "position": 0,
    "text": "چو آسوده شد سر بخوردن نهاد"
  },
  {
    "poem_id": 1789,
    "vorder": 166,
    "position": 1,
    "text": "کسی را نیامد ز بهرام یاد"
  },
  {
    "poem_id": 1789,
    "vorder": 167,
    "position": 0,
    "text": "به مرو اندرون بانگ چنگ و رباب"
  },
  {
    "poem_id": 1789,
    "vorder": 168,
    "position": 1,
    "text": "کسی را نبد جای آرام و خواب"
  },
  {
    "poem_id": 1789,
    "vorder": 169,
    "position": 0,
    "text": "سپاهش همه باره کرده یله"
  },
  {
    "poem_id": 1789,
    "vorder": 170,
    "position": 1,
    "text": "طلایه نه بردشت و نه راحله"
  },
  {
    "poem_id": 1789,
    "vorder": 171,
    "position": 0,
    "text": "شکار و می و مجلس و بانگ چنگ"
  },
  {
    "poem_id": 1789,
    "vorder": 172,
    "position": 1,
    "text": "شب و روز ایمن نشسته ز جنگ"
  },
  {
    "poem_id": 1789,
    "vorder": 173,
    "position": 0,
    "text": "همی باژ ایرانیان چشم داشت"
  },
  {
    "poem_id": 1789,
    "vorder": 174,
    "position": 1,
    "text": "ز دیر آمدن دل پر از خشم داشت"
  }
]