[
  {
    "poem_id": 1336,
    "vorder": 1,
    "position": 0,
    "text": "خجسته سیامک یکی پور داشت"
  },
  {
    "poem_id": 1336,
    "vorder": 2,
    "position": 1,
    "text": "که نزد نیا جاه دستور داشت"
  },
  {
    "poem_id": 1336,
    "vorder": 3,
    "position": 0,
    "text": "گرانمایه را نام هوشنگ بود"
  },
  {
    "poem_id": 1336,
    "vorder": 4,
    "position": 1,
    "text": "تو گفتی همه هوش و فرهنگ بود"
  },
  {
    "poem_id": 1336,
    "vorder": 5,
    "position": 0,
    "text": "به نزد نیا یادگار پدر"
  },
  {
    "poem_id": 1336,
    "vorder": 6,
    "position": 1,
    "text": "نیا پروریده مر او را به بر"
  },
  {
    "poem_id": 1336,
    "vorder": 7,
    "position": 0,
    "text": "نیایش به جای پسر داشتی"
  },
  {
    "poem_id": 1336,
    "vorder": 8,
    "position": 1,
    "text": "جز او بر کسی چشم نگماشتی"
  },
  {
    "poem_id": 1336,
    "vorder": 9,
    "position": 0,
    "text": "چو بنهاد دل کینه و جنگ را"
  },
  {
    "poem_id": 1336,
    "vorder": 10,
    "position": 1,
    "text": "بخواند آن گرانمایه هوشنگ را"
  },
  {
    "poem_id": 1336,
    "vorder": 11,
    "position": 0,
    "text": "همه گفتنی‌ها بدو بازگفت"
  },
  {
    "poem_id": 1336,
    "vorder": 12,
    "position": 1,
    "text": "همه رازها بر گشاد از نهفت"
  },
  {
    "poem_id": 1336,
    "vorder": 13,
    "position": 0,
    "text": "که من لشکری کرد خواهم همی"
  },
  {
    "poem_id": 1336,
    "vorder": 14,
    "position": 1,
    "text": "خروشی برآورد خواهم همی"
  },
  {
    "poem_id": 1336,
    "vorder": 15,
    "position": 0,
    "text": "تو را بود باید همی پیشرو"
  },
  {
    "poem_id": 1336,
    "vorder": 16,
    "position": 1,
    "text": "که من رفتنی‌ام تو سالار نو"
  },
  {
    "poem_id": 1336,
    "vorder": 17,
    "position": 0,
    "text": "پری و پلنگ انجمن کرد و شیر"
  },
  {
    "poem_id": 1336,
    "vorder": 18,
    "position": 1,
    "text": "ز درّندگان گرگ و ببر دلیر"
  },
  {
    "poem_id": 1336,
    "vorder": 19,
    "position": 0,
    "text": "سپاهی دد و دام و مرغ و پری"
  },
  {
    "poem_id": 1336,
    "vorder": 20,
    "position": 1,
    "text": "سپهدار پرکین و کنداوری"
  },
  {
    "poem_id": 1336,
    "vorder": 21,
    "position": 0,
    "text": "پس پشت لشکر کیومرث شاه"
  },
  {
    "poem_id": 1336,
    "vorder": 22,
    "position": 1,
    "text": "نبیره به پیش اندرون با سپاه"
  },
  {
    "poem_id": 1336,
    "vorder": 23,
    "position": 0,
    "text": "بیامد سیه دیو با ترس و باک"
  },
  {
    "poem_id": 1336,
    "vorder": 24,
    "position": 1,
    "text": "همی بآسمان بر پراگند خاک"
  },
  {
    "poem_id": 1336,
    "vorder": 25,
    "position": 0,
    "text": "ز هرّای درّندگان چنگ دیو"
  },
  {
    "poem_id": 1336,
    "vorder": 26,
    "position": 1,
    "text": "شده سست از خشم کیهان خدیو"
  },
  {
    "poem_id": 1336,
    "vorder": 27,
    "position": 0,
    "text": "به هم برشکستند هر دو گروه"
  },
  {
    "poem_id": 1336,
    "vorder": 28,
    "position": 1,
    "text": "شدند از دد و دام دیوان ستوه"
  },
  {
    "poem_id": 1336,
    "vorder": 29,
    "position": 0,
    "text": "بیازید هوشنگ چون شیر چنگ"
  },
  {
    "poem_id": 1336,
    "vorder": 30,
    "position": 1,
    "text": "جهان کرد بر دیو نستوه تنگ"
  },
  {
    "poem_id": 1336,
    "vorder": 31,
    "position": 0,
    "text": "کشیدش سراپای یک‌سر دوال"
  },
  {
    "poem_id": 1336,
    "vorder": 32,
    "position": 1,
    "text": "سپهبد برید آن سر بی‌همال"
  },
  {
    "poem_id": 1336,
    "vorder": 33,
    "position": 0,
    "text": "به پای اندر افگند و بسپرد خوار"
  },
  {
    "poem_id": 1336,
    "vorder": 34,
    "position": 1,
    "text": "دریده بر او چرم و برگشته کار"
  },
  {
    "poem_id": 1336,
    "vorder": 35,
    "position": 0,
    "text": "چو آمد مر آن کینه را خواستار"
  },
  {
    "poem_id": 1336,
    "vorder": 36,
    "position": 1,
    "text": "سرآمد کیومرث را روزگار"
  },
  {
    "poem_id": 1336,
    "vorder": 37,
    "position": 0,
    "text": "برفت و جهان مردری ماند ازوی"
  },
  {
    "poem_id": 1336,
    "vorder": 38,
    "position": 1,
    "text": "نگر تا که را نزد او آبروی"
  },
  {
    "poem_id": 1336,
    "vorder": 39,
    "position": 0,
    "text": "جهان فریبنده را گرد کرد"
  },
  {
    "poem_id": 1336,
    "vorder": 40,
    "position": 1,
    "text": "ره سود بنمود و خود مایه خْوَرد"
  },
  {
    "poem_id": 1336,
    "vorder": 41,
    "position": 0,
    "text": "جهان سر به سر چو فسانست و بس"
  },
  {
    "poem_id": 1336,
    "vorder": 42,
    "position": 1,
    "text": "نماند بد و نیک بر هیچ‌کس"
  }
]