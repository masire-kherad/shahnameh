[
  {
    "poem_id": 1846,
    "vorder": 1,
    "position": 0,
    "text": "چوبهرام رفت اندر ایوان شاه"
  },
  {
    "poem_id": 1846,
    "vorder": 2,
    "position": 1,
    "text": "گزین کرد زان لشکر کینه خواه"
  },
  {
    "poem_id": 1846,
    "vorder": 3,
    "position": 0,
    "text": "زره‌دار و شمشیر زن سی‌هزار"
  },
  {
    "poem_id": 1846,
    "vorder": 4,
    "position": 1,
    "text": "بدان تا شوند از پس شهریار"
  },
  {
    "poem_id": 1846,
    "vorder": 5,
    "position": 0,
    "text": "چنین لشکری نامبردار و گرد"
  },
  {
    "poem_id": 1846,
    "vorder": 6,
    "position": 1,
    "text": "ببهرام پور سیاوش سپرد"
  },
  {
    "poem_id": 1846,
    "vorder": 7,
    "position": 0,
    "text": "وزان روی خسرو بیابان گرفت"
  },
  {
    "poem_id": 1846,
    "vorder": 8,
    "position": 1,
    "text": "همی از بد دشمنان جان گرفت"
  },
  {
    "poem_id": 1846,
    "vorder": 9,
    "position": 0,
    "text": "چنین تا بنزد رباطی رسید"
  },
  {
    "poem_id": 1846,
    "vorder": 10,
    "position": 1,
    "text": "سر تیغ دیوار او ناپدید"
  },
  {
    "poem_id": 1846,
    "vorder": 11,
    "position": 0,
    "text": "کجا خواندندیش یزدان سرای"
  },
  {
    "poem_id": 1846,
    "vorder": 12,
    "position": 1,
    "text": "پرستشگهی بود و فرخنده جای"
  },
  {
    "poem_id": 1846,
    "vorder": 13,
    "position": 0,
    "text": "نشستنگه سوکواران بدی"
  },
  {
    "poem_id": 1846,
    "vorder": 14,
    "position": 1,
    "text": "بدو در سکوبا و مطران بدی"
  },
  {
    "poem_id": 1846,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت خسرو به یزدان پرست"
  },
  {
    "poem_id": 1846,
    "vorder": 16,
    "position": 1,
    "text": "که از خوردنی چیست کاید بدست"
  },
  {
    "poem_id": 1846,
    "vorder": 17,
    "position": 0,
    "text": "سکوبا بدو گفت کای نامدار"
  },
  {
    "poem_id": 1846,
    "vorder": 18,
    "position": 1,
    "text": "فطیرست با ترهٔ جویبار"
  },
  {
    "poem_id": 1846,
    "vorder": 19,
    "position": 0,
    "text": "گرای دون که شاید بدین سان خورش"
  },
  {
    "poem_id": 1846,
    "vorder": 20,
    "position": 1,
    "text": "مبادت جز از نوشه این پرورش"
  },
  {
    "poem_id": 1846,
    "vorder": 21,
    "position": 0,
    "text": "ز اسب اندر آمد سبک شهریار"
  },
  {
    "poem_id": 1846,
    "vorder": 22,
    "position": 1,
    "text": "همان آنک بودند با اوسوار"
  },
  {
    "poem_id": 1846,
    "vorder": 23,
    "position": 0,
    "text": "جهانجوی با آن دو خسرو پرست"
  },
  {
    "poem_id": 1846,
    "vorder": 24,
    "position": 1,
    "text": "گرفت از پی واژ برسم بدست"
  },
  {
    "poem_id": 1846,
    "vorder": 25,
    "position": 0,
    "text": "بخوردند با شتاب چیزی که بود"
  },
  {
    "poem_id": 1846,
    "vorder": 26,
    "position": 1,
    "text": "پس آنگه به زمزم بگفتند زود"
  },
  {
    "poem_id": 1846,
    "vorder": 27,
    "position": 0,
    "text": "چنین گفت پس با سکوبا که می"
  },
  {
    "poem_id": 1846,
    "vorder": 28,
    "position": 1,
    "text": "نداری تو ای پیرفرخنده پی"
  },
  {
    "poem_id": 1846,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت ما می‌زخرما کنیم"
  },
  {
    "poem_id": 1846,
    "vorder": 30,
    "position": 1,
    "text": "به تموز وهنگام گرما کنیم"
  },
  {
    "poem_id": 1846,
    "vorder": 31,
    "position": 0,
    "text": "کنون هست لختی چو روشن گلاب"
  },
  {
    "poem_id": 1846,
    "vorder": 32,
    "position": 1,
    "text": "به سرخی چو بیجاده در آفتاب"
  },
  {
    "poem_id": 1846,
    "vorder": 33,
    "position": 0,
    "text": "هم آنگه بیاورد جامی نبید"
  },
  {
    "poem_id": 1846,
    "vorder": 34,
    "position": 1,
    "text": "که شد رنگ خورشید زو ناپدید"
  },
  {
    "poem_id": 1846,
    "vorder": 35,
    "position": 0,
    "text": "بخورد آن زمان خسرو از می سه جام"
  },
  {
    "poem_id": 1846,
    "vorder": 36,
    "position": 1,
    "text": "می و نان کشکین که دارد بنام"
  },
  {
    "poem_id": 1846,
    "vorder": 37,
    "position": 0,
    "text": "چو مغزش شد از بادهٔ سرخ گرم"
  },
  {
    "poem_id": 1846,
    "vorder": 38,
    "position": 1,
    "text": "هم آنگه بخفت از بر ریگ نرم"
  },
  {
    "poem_id": 1846,
    "vorder": 39,
    "position": 0,
    "text": "نهاد از بر ران بندوی سر"
  },
  {
    "poem_id": 1846,
    "vorder": 40,
    "position": 1,
    "text": "روانش پر از درد و خسته جگر"
  },
  {
    "poem_id": 1846,
    "vorder": 41,
    "position": 0,
    "text": "همان چون بخواب اندر آمد سرش"
  },
  {
    "poem_id": 1846,
    "vorder": 42,
    "position": 1,
    "text": "سکوبای مهتر بیامد برش"
  },
  {
    "poem_id": 1846,
    "vorder": 43,
    "position": 0,
    "text": "که از راه گردی برآمد سیاه"
  },
  {
    "poem_id": 1846,
    "vorder": 44,
    "position": 1,
    "text": "دران گرد تیره فراوان سپاه"
  },
  {
    "poem_id": 1846,
    "vorder": 45,
    "position": 0,
    "text": "چنین گفت خسرو که بد روزگار"
  },
  {
    "poem_id": 1846,
    "vorder": 46,
    "position": 1,
    "text": "که دشمن بدین گونه شد خواستا ر"
  },
  {
    "poem_id": 1846,
    "vorder": 47,
    "position": 0,
    "text": "نه مردم به کارست و نه بارگی"
  },
  {
    "poem_id": 1846,
    "vorder": 48,
    "position": 1,
    "text": "فراز آمد آن روز بیچارگی"
  },
  {
    "poem_id": 1846,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت بندوی بس چاره ساز"
  },
  {
    "poem_id": 1846,
    "vorder": 50,
    "position": 1,
    "text": "که آمدت دشمن بتنگی فراز"
  },
  {
    "poem_id": 1846,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت خسرو که ای نیک خواه"
  },
  {
    "poem_id": 1846,
    "vorder": 52,
    "position": 1,
    "text": "مرا اندرین کار بنمای راه"
  },
  {
    "poem_id": 1846,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت بندوی کای شهریار"
  },
  {
    "poem_id": 1846,
    "vorder": 54,
    "position": 1,
    "text": "تو را چاره سازم بدین روزگار"
  },
  {
    "poem_id": 1846,
    "vorder": 55,
    "position": 0,
    "text": "ولیکن فدا کرده باشم روان"
  },
  {
    "poem_id": 1846,
    "vorder": 56,
    "position": 1,
    "text": "به پیش جهانجوی شاه جهان"
  },
  {
    "poem_id": 1846,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت خسرو که دانای چین"
  },
  {
    "poem_id": 1846,
    "vorder": 58,
    "position": 1,
    "text": "یکی خوب زد داستانی برین"
  },
  {
    "poem_id": 1846,
    "vorder": 59,
    "position": 0,
    "text": "که هرکو کند بر درشاه کشت"
  },
  {
    "poem_id": 1846,
    "vorder": 60,
    "position": 1,
    "text": "بیابد بدان گیتی اندر بهشت"
  },
  {
    "poem_id": 1846,
    "vorder": 61,
    "position": 0,
    "text": "چو دیوار شهر اندر آمد زپای"
  },
  {
    "poem_id": 1846,
    "vorder": 62,
    "position": 1,
    "text": "کلاته نباید که ماند بجای"
  },
  {
    "poem_id": 1846,
    "vorder": 63,
    "position": 0,
    "text": "چو ناچیز خواهد شدن شارستان"
  },
  {
    "poem_id": 1846,
    "vorder": 64,
    "position": 1,
    "text": "مماناد دیوار بیمارستان"
  },
  {
    "poem_id": 1846,
    "vorder": 65,
    "position": 0,
    "text": "توگر چاره‌جویی دانی اکنون بساز"
  },
  {
    "poem_id": 1846,
    "vorder": 66,
    "position": 1,
    "text": "هم از پاک یزدان نه‌ای بی‌نیاز"
  },
  {
    "poem_id": 1846,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت بندوی کاین تاج زر"
  },
  {
    "poem_id": 1846,
    "vorder": 68,
    "position": 1,
    "text": "مرا ده همین گوشوار و کمر"
  },
  {
    "poem_id": 1846,
    "vorder": 69,
    "position": 0,
    "text": "همان لعل زرین چینی قبای"
  },
  {
    "poem_id": 1846,
    "vorder": 70,
    "position": 1,
    "text": "چو من پوشم این را تو ایدر مپای"
  },
  {
    "poem_id": 1846,
    "vorder": 71,
    "position": 0,
    "text": "برو با سپاهت هم اندر شتاب"
  },
  {
    "poem_id": 1846,
    "vorder": 72,
    "position": 1,
    "text": "چو کشتی که موجش درآرد ز آب"
  },
  {
    "poem_id": 1846,
    "vorder": 73,
    "position": 0,
    "text": "بکرد آن زمان هرچ بندوی گفت"
  },
  {
    "poem_id": 1846,
    "vorder": 74,
    "position": 1,
    "text": "وزانجایگه گشت با باد جفت"
  },
  {
    "poem_id": 1846,
    "vorder": 75,
    "position": 0,
    "text": "چو خسرو برفت از بر چاره جوی"
  },
  {
    "poem_id": 1846,
    "vorder": 76,
    "position": 1,
    "text": "جهاندیده سوی سقف کرد روی"
  },
  {
    "poem_id": 1846,
    "vorder": 77,
    "position": 0,
    "text": "که اکنون شما را بدین بر ز کوه"
  },
  {
    "poem_id": 1846,
    "vorder": 78,
    "position": 1,
    "text": "بباید شدن ناپدید از گروه"
  },
  {
    "poem_id": 1846,
    "vorder": 79,
    "position": 0,
    "text": "خود اندر پرستشگه آمد چو گرد"
  },
  {
    "poem_id": 1846,
    "vorder": 80,
    "position": 1,
    "text": "بزودی در آهنین سخت کرد"
  },
  {
    "poem_id": 1846,
    "vorder": 81,
    "position": 0,
    "text": "بپوشید پس جامهٔ زرنگار"
  },
  {
    "poem_id": 1846,
    "vorder": 82,
    "position": 1,
    "text": "به سر برنهاد افسر شهریار"
  },
  {
    "poem_id": 1846,
    "vorder": 83,
    "position": 0,
    "text": "بران بام برشد نه بر آرزوی"
  },
  {
    "poem_id": 1846,
    "vorder": 84,
    "position": 1,
    "text": "سپه دید گرد اندورن چارسوی"
  },
  {
    "poem_id": 1846,
    "vorder": 85,
    "position": 0,
    "text": "همی‌بود تا لشکر رزمساز"
  },
  {
    "poem_id": 1846,
    "vorder": 86,
    "position": 1,
    "text": "رسیدند نزدیک آن دژ فراز"
  },
  {
    "poem_id": 1846,
    "vorder": 87,
    "position": 0,
    "text": "ابرپای خاست آنگه از بام زود"
  },
  {
    "poem_id": 1846,
    "vorder": 88,
    "position": 1,
    "text": "تن خویشتن را به لشکر نمود"
  },
  {
    "poem_id": 1846,
    "vorder": 89,
    "position": 0,
    "text": "بدیدندش از دور با تاج زر"
  },
  {
    "poem_id": 1846,
    "vorder": 90,
    "position": 1,
    "text": "همان طوق و آن گوشوار و کمر"
  },
  {
    "poem_id": 1846,
    "vorder": 91,
    "position": 0,
    "text": "همی‌گفت هر کس که این خسروست"
  },
  {
    "poem_id": 1846,
    "vorder": 92,
    "position": 1,
    "text": "که با تاج و با جامه‌های نوست"
  },
  {
    "poem_id": 1846,
    "vorder": 93,
    "position": 0,
    "text": "چو بند وی شد بی‌گمان کان سپاه"
  },
  {
    "poem_id": 1846,
    "vorder": 94,
    "position": 1,
    "text": "همی‌بازنشناسد او را ز شاه"
  },
  {
    "poem_id": 1846,
    "vorder": 95,
    "position": 0,
    "text": "فرود آمد و جامهٔ خویش تفت"
  },
  {
    "poem_id": 1846,
    "vorder": 96,
    "position": 1,
    "text": "بپوشید ناکام و بربام رفت"
  },
  {
    "poem_id": 1846,
    "vorder": 97,
    "position": 0,
    "text": "چنین گفت کای رزمسازان نو"
  },
  {
    "poem_id": 1846,
    "vorder": 98,
    "position": 1,
    "text": "کرا خوانم اندر شما پیش رو"
  },
  {
    "poem_id": 1846,
    "vorder": 99,
    "position": 0,
    "text": "که پیغام دارم ز شاه جهان"
  },
  {
    "poem_id": 1846,
    "vorder": 100,
    "position": 1,
    "text": "بگویم شنیده به پیش مهان"
  },
  {
    "poem_id": 1846,
    "vorder": 101,
    "position": 0,
    "text": "چو پور سیاووش دیدش ببام"
  },
  {
    "poem_id": 1846,
    "vorder": 102,
    "position": 1,
    "text": "منم پیش رو گفت بهرام نام"
  },
  {
    "poem_id": 1846,
    "vorder": 103,
    "position": 0,
    "text": "بدو گفت گوید جهاندار شاه"
  },
  {
    "poem_id": 1846,
    "vorder": 104,
    "position": 1,
    "text": "که من سخت پیچانم از رنج راه"
  },
  {
    "poem_id": 1846,
    "vorder": 105,
    "position": 0,
    "text": "ستوران همه خسته و کوفته"
  },
  {
    "poem_id": 1846,
    "vorder": 106,
    "position": 1,
    "text": "زراه دراز اندر آشوفته"
  },
  {
    "poem_id": 1846,
    "vorder": 107,
    "position": 0,
    "text": "بدین خانهٔ سوکواران به رنج"
  },
  {
    "poem_id": 1846,
    "vorder": 108,
    "position": 1,
    "text": "فرود آمدستیم با یار پنج"
  },
  {
    "poem_id": 1846,
    "vorder": 109,
    "position": 0,
    "text": "چوپیدا شود چاک روز سپید"
  },
  {
    "poem_id": 1846,
    "vorder": 110,
    "position": 1,
    "text": "کنم دل زکار جهان ناامید"
  },
  {
    "poem_id": 1846,
    "vorder": 111,
    "position": 0,
    "text": "بیاییم با تو به راه دراز"
  },
  {
    "poem_id": 1846,
    "vorder": 112,
    "position": 1,
    "text": "به نزدیک بهرام گردن فراز"
  },
  {
    "poem_id": 1846,
    "vorder": 113,
    "position": 0,
    "text": "برین بر که گفتم نجویم زمان"
  },
  {
    "poem_id": 1846,
    "vorder": 114,
    "position": 1,
    "text": "مگر یارمندی کند آسمان"
  },
  {
    "poem_id": 1846,
    "vorder": 115,
    "position": 0,
    "text": "نیاکان ماآنک بودند پیش"
  },
  {
    "poem_id": 1846,
    "vorder": 116,
    "position": 1,
    "text": "نگه داشتندی هم آیین وکیش"
  },
  {
    "poem_id": 1846,
    "vorder": 117,
    "position": 0,
    "text": "اگرچه بدی بختشان دیر ساز"
  },
  {
    "poem_id": 1846,
    "vorder": 118,
    "position": 1,
    "text": "ز کهتر نبرداشتندی نیاز"
  },
  {
    "poem_id": 1846,
    "vorder": 119,
    "position": 0,
    "text": "کنون آنچ ما را به دل راز بود"
  },
  {
    "poem_id": 1846,
    "vorder": 120,
    "position": 1,
    "text": "بگفتیم چون بخت ناساز بود"
  },
  {
    "poem_id": 1846,
    "vorder": 121,
    "position": 0,
    "text": "زرخشنده خورشید تا تیره خاک"
  },
  {
    "poem_id": 1846,
    "vorder": 122,
    "position": 1,
    "text": "نباشد مگر رای یزدان پاک"
  },
  {
    "poem_id": 1846,
    "vorder": 123,
    "position": 0,
    "text": "چو سالار بشنید زو داستان"
  },
  {
    "poem_id": 1846,
    "vorder": 124,
    "position": 1,
    "text": "به گفتار او گشت همداستان"
  },
  {
    "poem_id": 1846,
    "vorder": 125,
    "position": 0,
    "text": "دگر هرکه بشنید گفتار اوی"
  },
  {
    "poem_id": 1846,
    "vorder": 126,
    "position": 1,
    "text": "پر از درد شد دل ز کردار اوی"
  },
  {
    "poem_id": 1846,
    "vorder": 127,
    "position": 0,
    "text": "فرود آمد آن شب بدانجا سپاه"
  },
  {
    "poem_id": 1846,
    "vorder": 128,
    "position": 1,
    "text": "همی‌داشتی رای خسرو نگاه"
  },
  {
    "poem_id": 1846,
    "vorder": 129,
    "position": 0,
    "text": "دگر روز بندوی بربام شد"
  },
  {
    "poem_id": 1846,
    "vorder": 130,
    "position": 1,
    "text": "ز دیوار تا سوی بهرام شد"
  },
  {
    "poem_id": 1846,
    "vorder": 131,
    "position": 0,
    "text": "بدو گفت کامروز شاه از نماز"
  },
  {
    "poem_id": 1846,
    "vorder": 132,
    "position": 1,
    "text": "همانا نیاید به کاری فراز"
  },
  {
    "poem_id": 1846,
    "vorder": 133,
    "position": 0,
    "text": "چنین هم شب تیره بیدار بود"
  },
  {
    "poem_id": 1846,
    "vorder": 134,
    "position": 1,
    "text": "پرستندهٔ پاک دادار بود"
  },
  {
    "poem_id": 1846,
    "vorder": 135,
    "position": 0,
    "text": "همان نیز خورشید گردد بلند"
  },
  {
    "poem_id": 1846,
    "vorder": 136,
    "position": 1,
    "text": "زگرما نباید که یابد گزند"
  },
  {
    "poem_id": 1846,
    "vorder": 137,
    "position": 0,
    "text": "بیاساید امروز و فردا پگاه"
  },
  {
    "poem_id": 1846,
    "vorder": 138,
    "position": 1,
    "text": "همی‌راند اندر میان سپاه"
  },
  {
    "poem_id": 1846,
    "vorder": 139,
    "position": 0,
    "text": "چنین گفت بهرام با مهتران"
  },
  {
    "poem_id": 1846,
    "vorder": 140,
    "position": 1,
    "text": "که کاریست این هم سبک هم گران"
  },
  {
    "poem_id": 1846,
    "vorder": 141,
    "position": 0,
    "text": "چو بر خسرو این کار گیریم تنگ"
  },
  {
    "poem_id": 1846,
    "vorder": 142,
    "position": 1,
    "text": "مگر تیز گردد بیاید به جنگ"
  },
  {
    "poem_id": 1846,
    "vorder": 143,
    "position": 0,
    "text": "بتنها تن او یکی لشکرست"
  },
  {
    "poem_id": 1846,
    "vorder": 144,
    "position": 1,
    "text": "جهانگیر و بیدار و کنداورست"
  },
  {
    "poem_id": 1846,
    "vorder": 145,
    "position": 0,
    "text": "وگر کشته آید به دشت نبرد"
  },
  {
    "poem_id": 1846,
    "vorder": 146,
    "position": 1,
    "text": "برآرد ز ما نیز بهرام گرد"
  },
  {
    "poem_id": 1846,
    "vorder": 147,
    "position": 0,
    "text": "هم آن به که امروز باشیم نیز"
  },
  {
    "poem_id": 1846,
    "vorder": 148,
    "position": 1,
    "text": "وگر خوردنی نیست بسیار چیز"
  },
  {
    "poem_id": 1846,
    "vorder": 149,
    "position": 0,
    "text": "مگر کو بدین هم نشان خوش منش"
  },
  {
    "poem_id": 1846,
    "vorder": 150,
    "position": 1,
    "text": "بیاید به از جنگ وز سرزنش"
  },
  {
    "poem_id": 1846,
    "vorder": 151,
    "position": 0,
    "text": "چنان هم همی‌بود تا شب ز کوه"
  },
  {
    "poem_id": 1846,
    "vorder": 152,
    "position": 1,
    "text": "برآمد بگرد اندر آمد گروه"
  },
  {
    "poem_id": 1846,
    "vorder": 153,
    "position": 0,
    "text": "سپاه اندرآمد ز هر پهلوی"
  },
  {
    "poem_id": 1846,
    "vorder": 154,
    "position": 1,
    "text": "همی‌سوختند آتش از هر سوی"
  }
]