[
  {
    "poem_id": 88068,
    "vorder": 1,
    "position": 0,
    "text": "چو نیمی ز تیره شب اندر گذشت"
  },
  {
    "poem_id": 88068,
    "vorder": 2,
    "position": 1,
    "text": "سپهر از بر کوه ساکن بگشت"
  },
  {
    "poem_id": 88068,
    "vorder": 3,
    "position": 0,
    "text": "سپهدار ترکان بنه بر نهاد"
  },
  {
    "poem_id": 88068,
    "vorder": 4,
    "position": 1,
    "text": "سپه را همه ترگ و جوشن بداد"
  },
  {
    "poem_id": 88068,
    "vorder": 5,
    "position": 0,
    "text": "طلایه بفرمود تا ده هزار"
  },
  {
    "poem_id": 88068,
    "vorder": 6,
    "position": 1,
    "text": "بود ترک برگستوان ور سوار"
  },
  {
    "poem_id": 88068,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت با لشکر افراسیاب"
  },
  {
    "poem_id": 88068,
    "vorder": 8,
    "position": 1,
    "text": "که من چون گذر یابم از رود آب"
  },
  {
    "poem_id": 88068,
    "vorder": 9,
    "position": 0,
    "text": "دمادم شما از پسم بگذرید"
  },
  {
    "poem_id": 88068,
    "vorder": 10,
    "position": 1,
    "text": "به جیحون و زورق زمان مشمرید"
  },
  {
    "poem_id": 88068,
    "vorder": 11,
    "position": 0,
    "text": "شب تیره با لشکر افراسیاب"
  },
  {
    "poem_id": 88068,
    "vorder": 12,
    "position": 1,
    "text": "گذر کرد از آموی و بگذاشت آب"
  },
  {
    "poem_id": 88068,
    "vorder": 13,
    "position": 0,
    "text": "همه روی کشور به بی راه و راه"
  },
  {
    "poem_id": 88068,
    "vorder": 14,
    "position": 1,
    "text": "سراپرده و خیمه بد بی سپاه"
  },
  {
    "poem_id": 88068,
    "vorder": 15,
    "position": 0,
    "text": "سپیده چو از باختر بردمید"
  },
  {
    "poem_id": 88068,
    "vorder": 16,
    "position": 1,
    "text": "طلایه سپه را به هامون ندید"
  },
  {
    "poem_id": 88068,
    "vorder": 17,
    "position": 0,
    "text": "بیامد به مژده بر شهریار"
  },
  {
    "poem_id": 88068,
    "vorder": 18,
    "position": 1,
    "text": "که پردخته شد شاه ز این کارزار"
  },
  {
    "poem_id": 88068,
    "vorder": 19,
    "position": 0,
    "text": "همه دشت خیمه‌ست و پرده‌سرای"
  },
  {
    "poem_id": 88068,
    "vorder": 20,
    "position": 1,
    "text": "ز دشمن سواری نبینم به جای"
  },
  {
    "poem_id": 88068,
    "vorder": 21,
    "position": 0,
    "text": "چو بشنید خسرو دوان شد به خاک"
  },
  {
    "poem_id": 88068,
    "vorder": 22,
    "position": 1,
    "text": "نیایش کنان پیش یزدان پاک"
  },
  {
    "poem_id": 88068,
    "vorder": 23,
    "position": 0,
    "text": "همی گفت کای روشن کردگار"
  },
  {
    "poem_id": 88068,
    "vorder": 24,
    "position": 1,
    "text": "جهاندار و بیدار و پروردگار"
  },
  {
    "poem_id": 88068,
    "vorder": 25,
    "position": 0,
    "text": "تو دادی مرا فر و دیهیم و زور"
  },
  {
    "poem_id": 88068,
    "vorder": 26,
    "position": 1,
    "text": "تو کردی دل و چشم بدخواه کور"
  },
  {
    "poem_id": 88068,
    "vorder": 27,
    "position": 0,
    "text": "ز گیتی ستمکاره را دور کن"
  },
  {
    "poem_id": 88068,
    "vorder": 28,
    "position": 1,
    "text": "ز بیمش همه ساله رنجور کن"
  },
  {
    "poem_id": 88068,
    "vorder": 29,
    "position": 0,
    "text": "چو خورشید زرین سپر برگرفت"
  },
  {
    "poem_id": 88068,
    "vorder": 30,
    "position": 1,
    "text": "شب آن شعر پیروزه بر سر گرفت"
  },
  {
    "poem_id": 88068,
    "vorder": 31,
    "position": 0,
    "text": "جهاندار بنشست بر تخت عاج"
  },
  {
    "poem_id": 88068,
    "vorder": 32,
    "position": 1,
    "text": "به سر بر نهاد آن دل افروز تاج"
  },
  {
    "poem_id": 88068,
    "vorder": 33,
    "position": 0,
    "text": "نیایش کنان پیش او شد سپاه"
  },
  {
    "poem_id": 88068,
    "vorder": 34,
    "position": 1,
    "text": "که جاوید باد این سزاوار گاه"
  },
  {
    "poem_id": 88068,
    "vorder": 35,
    "position": 0,
    "text": "شد این لشکر از خواسته بی‌نیاز"
  },
  {
    "poem_id": 88068,
    "vorder": 36,
    "position": 1,
    "text": "که از لشکر شاه چین ماند باز"
  },
  {
    "poem_id": 88068,
    "vorder": 37,
    "position": 0,
    "text": "همی گفت هر کس که اینت فسوس"
  },
  {
    "poem_id": 88068,
    "vorder": 38,
    "position": 1,
    "text": "که او رفت با لشکر و بوق و کوس"
  },
  {
    "poem_id": 88068,
    "vorder": 39,
    "position": 0,
    "text": "شب تیره از دست پرمایگان"
  },
  {
    "poem_id": 88068,
    "vorder": 40,
    "position": 1,
    "text": "بشد نامداری چنین رایگان"
  },
  {
    "poem_id": 88068,
    "vorder": 41,
    "position": 0,
    "text": "بدیشان چنین گفت بیدار شاه"
  },
  {
    "poem_id": 88068,
    "vorder": 42,
    "position": 1,
    "text": "که ای نامداران ایران سپاه"
  },
  {
    "poem_id": 88068,
    "vorder": 43,
    "position": 0,
    "text": "چو دشمن بود شاه را کشته به"
  },
  {
    "poem_id": 88068,
    "vorder": 44,
    "position": 1,
    "text": "گر آواره از جنگ برگشته به"
  },
  {
    "poem_id": 88068,
    "vorder": 45,
    "position": 0,
    "text": "چو پیروزگر دادمان فرهی"
  },
  {
    "poem_id": 88068,
    "vorder": 46,
    "position": 1,
    "text": "بزرگی و دیهیم شاهنشهی"
  },
  {
    "poem_id": 88068,
    "vorder": 47,
    "position": 0,
    "text": "ز گیتی ستایش مر او را کنید"
  },
  {
    "poem_id": 88068,
    "vorder": 48,
    "position": 1,
    "text": "شب آید نیایش مر او را کنید"
  },
  {
    "poem_id": 88068,
    "vorder": 49,
    "position": 0,
    "text": "که آن را که خواهد کند شوربخت"
  },
  {
    "poem_id": 88068,
    "vorder": 50,
    "position": 1,
    "text": "یکی بی هنر برنشاند به تخت"
  },
  {
    "poem_id": 88068,
    "vorder": 51,
    "position": 0,
    "text": "از این کوشش و پرسشت رای نیست"
  },
  {
    "poem_id": 88068,
    "vorder": 52,
    "position": 1,
    "text": "که با داد او بنده را پای نیست"
  },
  {
    "poem_id": 88068,
    "vorder": 53,
    "position": 0,
    "text": "بباشم بدین رزمگه پنج روز"
  },
  {
    "poem_id": 88068,
    "vorder": 54,
    "position": 1,
    "text": "ششم روز هرمزد گیتی فروز"
  },
  {
    "poem_id": 88068,
    "vorder": 55,
    "position": 0,
    "text": "برآید برانیم ز ایدر سپاه"
  },
  {
    "poem_id": 88068,
    "vorder": 56,
    "position": 1,
    "text": "که او کین فزایست و ما کینه خواه"
  },
  {
    "poem_id": 88068,
    "vorder": 57,
    "position": 0,
    "text": "بدین پنج روز اندر این رزمگاه"
  },
  {
    "poem_id": 88068,
    "vorder": 58,
    "position": 1,
    "text": "همی کشته جستند ز ایران سپاه"
  },
  {
    "poem_id": 88068,
    "vorder": 59,
    "position": 0,
    "text": "بشستند ایرانیان را ز گرد"
  },
  {
    "poem_id": 88068,
    "vorder": 60,
    "position": 1,
    "text": "سزاوار هر یک یکی دخمه کرد"
  }
]