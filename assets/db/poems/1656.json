[
  {
    "poem_id": 1656,
    "vorder": 1,
    "position": 0,
    "text": "چو پاسخ به نزد سکندر رسید"
  },
  {
    "poem_id": 1656,
    "vorder": 2,
    "position": 1,
    "text": "هم‌انگه ز لشکر سران برگزید"
  },
  {
    "poem_id": 1656,
    "vorder": 3,
    "position": 0,
    "text": "که باشند شایسته و پیش‌رو"
  },
  {
    "poem_id": 1656,
    "vorder": 4,
    "position": 1,
    "text": "به دانش کهن گشته و سال نو"
  },
  {
    "poem_id": 1656,
    "vorder": 5,
    "position": 0,
    "text": "سوی فور هندی سپاهی براند"
  },
  {
    "poem_id": 1656,
    "vorder": 6,
    "position": 1,
    "text": "که روی زمین جز به دریا نماند"
  },
  {
    "poem_id": 1656,
    "vorder": 7,
    "position": 0,
    "text": "به هر سو همی رفت زان‌سان سپاه"
  },
  {
    "poem_id": 1656,
    "vorder": 8,
    "position": 1,
    "text": "تو گفتی جز آن بر زمین نیست راه"
  },
  {
    "poem_id": 1656,
    "vorder": 9,
    "position": 0,
    "text": "همه کوه و دریا و راه درشت"
  },
  {
    "poem_id": 1656,
    "vorder": 10,
    "position": 1,
    "text": "به دل آتش جنگ‌جویان بکشت"
  },
  {
    "poem_id": 1656,
    "vorder": 11,
    "position": 0,
    "text": "ز رفتن سپه سربسر گشت کند"
  },
  {
    "poem_id": 1656,
    "vorder": 12,
    "position": 1,
    "text": "ازان راه دشوار و پیکار تند"
  },
  {
    "poem_id": 1656,
    "vorder": 13,
    "position": 0,
    "text": "هم‌انگه چو آمد به منزل سپاه"
  },
  {
    "poem_id": 1656,
    "vorder": 14,
    "position": 1,
    "text": "گروهی برفتند نزدیک شاه"
  },
  {
    "poem_id": 1656,
    "vorder": 15,
    "position": 0,
    "text": "که ای قیصر روم و سالار چین"
  },
  {
    "poem_id": 1656,
    "vorder": 16,
    "position": 1,
    "text": "سپاه ترا برنتابد زمین"
  },
  {
    "poem_id": 1656,
    "vorder": 17,
    "position": 0,
    "text": "نجوید همی جنگ تو فور هند"
  },
  {
    "poem_id": 1656,
    "vorder": 18,
    "position": 1,
    "text": "نه فغفور چینی نه سالار سند"
  },
  {
    "poem_id": 1656,
    "vorder": 19,
    "position": 0,
    "text": "سپه را چرا کرد باید تباه"
  },
  {
    "poem_id": 1656,
    "vorder": 20,
    "position": 1,
    "text": "بدین مرز بی‌ارز و زین‌گونه راه"
  },
  {
    "poem_id": 1656,
    "vorder": 21,
    "position": 0,
    "text": "ز لشکر نبینیم اسپی درست"
  },
  {
    "poem_id": 1656,
    "vorder": 22,
    "position": 1,
    "text": "که شاید به تندی برو رزم جست"
  },
  {
    "poem_id": 1656,
    "vorder": 23,
    "position": 0,
    "text": "ازین جنگ گر بازگردد سپاه"
  },
  {
    "poem_id": 1656,
    "vorder": 24,
    "position": 1,
    "text": "سوار و پیاده نیابند راه"
  },
  {
    "poem_id": 1656,
    "vorder": 25,
    "position": 0,
    "text": "چو پیروز بودیم تا این زمان"
  },
  {
    "poem_id": 1656,
    "vorder": 26,
    "position": 1,
    "text": "به هرجای بر لشگر بدگمان"
  },
  {
    "poem_id": 1656,
    "vorder": 27,
    "position": 0,
    "text": "کنون سربه‌سر کوه و دریا به پیش"
  },
  {
    "poem_id": 1656,
    "vorder": 28,
    "position": 1,
    "text": "به سیری نیامد کس از جان خویش"
  },
  {
    "poem_id": 1656,
    "vorder": 29,
    "position": 0,
    "text": "مگردان همه نام ما را به ننگ"
  },
  {
    "poem_id": 1656,
    "vorder": 30,
    "position": 1,
    "text": "نکردست کس جنگ با آب و سنگ"
  },
  {
    "poem_id": 1656,
    "vorder": 31,
    "position": 0,
    "text": "غمی شد سکندر ز گفتارشان"
  },
  {
    "poem_id": 1656,
    "vorder": 32,
    "position": 1,
    "text": "برآشفت و بشکست بازارشان"
  },
  {
    "poem_id": 1656,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت کز جنگ ایرانیان"
  },
  {
    "poem_id": 1656,
    "vorder": 34,
    "position": 1,
    "text": "ز رومی کسی را نیامد زیان"
  },
  {
    "poem_id": 1656,
    "vorder": 35,
    "position": 0,
    "text": "به دارا بر از بندگان بد رسید"
  },
  {
    "poem_id": 1656,
    "vorder": 36,
    "position": 1,
    "text": "کسی از شما باد جسته ندید"
  },
  {
    "poem_id": 1656,
    "vorder": 37,
    "position": 0,
    "text": "برین راه من بی‌شما بگذرم"
  },
  {
    "poem_id": 1656,
    "vorder": 38,
    "position": 1,
    "text": "دل اژدها را به پی بسپرم"
  },
  {
    "poem_id": 1656,
    "vorder": 39,
    "position": 0,
    "text": "بیینید ازان پس که رنجور فور"
  },
  {
    "poem_id": 1656,
    "vorder": 40,
    "position": 1,
    "text": "نپردازد از بن به رزم و به سور"
  },
  {
    "poem_id": 1656,
    "vorder": 41,
    "position": 0,
    "text": "مرایار یزدان و ایران سپاه"
  },
  {
    "poem_id": 1656,
    "vorder": 42,
    "position": 1,
    "text": "نخواهم که رومی بود نیک‌خواه"
  },
  {
    "poem_id": 1656,
    "vorder": 43,
    "position": 0,
    "text": "چو آشفته شد شاه زان گفت و گوی"
  },
  {
    "poem_id": 1656,
    "vorder": 44,
    "position": 1,
    "text": "سپه سوی پوزش نهادند روی"
  },
  {
    "poem_id": 1656,
    "vorder": 45,
    "position": 0,
    "text": "که ما سربسر بندهٔ قیصریم"
  },
  {
    "poem_id": 1656,
    "vorder": 46,
    "position": 1,
    "text": "زمین جز به فرمان او نسپریم"
  },
  {
    "poem_id": 1656,
    "vorder": 47,
    "position": 0,
    "text": "بکوشیم و چون اسپ گردد تباه"
  },
  {
    "poem_id": 1656,
    "vorder": 48,
    "position": 1,
    "text": "پیاده به جنگ اندر آید سپاه"
  },
  {
    "poem_id": 1656,
    "vorder": 49,
    "position": 0,
    "text": "گر از خون ما خاک دریا کنند"
  },
  {
    "poem_id": 1656,
    "vorder": 50,
    "position": 1,
    "text": "نشیبی ز افگنده بالا کنند"
  },
  {
    "poem_id": 1656,
    "vorder": 51,
    "position": 0,
    "text": "نبیند کسی پشت ما روز جنگ"
  },
  {
    "poem_id": 1656,
    "vorder": 52,
    "position": 1,
    "text": "اگر چرخ بار آورد کوه سنگ"
  },
  {
    "poem_id": 1656,
    "vorder": 53,
    "position": 0,
    "text": "همه بندگانیم و فرمان تراست"
  },
  {
    "poem_id": 1656,
    "vorder": 54,
    "position": 1,
    "text": "چو آزار گیری ز ما جان تراست"
  },
  {
    "poem_id": 1656,
    "vorder": 55,
    "position": 0,
    "text": "چو بشنید زیشان سکندر سخن"
  },
  {
    "poem_id": 1656,
    "vorder": 56,
    "position": 1,
    "text": "یکی رزم را دیگر افگند بن"
  },
  {
    "poem_id": 1656,
    "vorder": 57,
    "position": 0,
    "text": "گزین کرد ز ایرانیان سی هزار"
  },
  {
    "poem_id": 1656,
    "vorder": 58,
    "position": 1,
    "text": "که بودند با آلت کارزار"
  },
  {
    "poem_id": 1656,
    "vorder": 59,
    "position": 0,
    "text": "برفتند کارآزموده سران"
  },
  {
    "poem_id": 1656,
    "vorder": 60,
    "position": 1,
    "text": "زره‌دار مردان جنگاوران"
  },
  {
    "poem_id": 1656,
    "vorder": 61,
    "position": 0,
    "text": "پس پشت ایشان ز رومی سوار"
  },
  {
    "poem_id": 1656,
    "vorder": 62,
    "position": 1,
    "text": "یکی قلب دیگر همان چل هزار"
  },
  {
    "poem_id": 1656,
    "vorder": 63,
    "position": 0,
    "text": "پس پشت ایشان سواران مصر"
  },
  {
    "poem_id": 1656,
    "vorder": 64,
    "position": 1,
    "text": "دلیران و خنجرگزاران مصر"
  },
  {
    "poem_id": 1656,
    "vorder": 65,
    "position": 0,
    "text": "برفتند شمشیرزن چل هزار"
  },
  {
    "poem_id": 1656,
    "vorder": 66,
    "position": 1,
    "text": "هرانکس که بود از در کارزار"
  },
  {
    "poem_id": 1656,
    "vorder": 67,
    "position": 0,
    "text": "ز خویشان دارا و ایرانیان"
  },
  {
    "poem_id": 1656,
    "vorder": 68,
    "position": 1,
    "text": "هرانکس که بود از نژاد کیان"
  },
  {
    "poem_id": 1656,
    "vorder": 69,
    "position": 0,
    "text": "ز رومی و از مصری و بربری"
  },
  {
    "poem_id": 1656,
    "vorder": 70,
    "position": 1,
    "text": "سواران شایسته و لشکری"
  },
  {
    "poem_id": 1656,
    "vorder": 71,
    "position": 0,
    "text": "گزین کرد قیصر ده و دو هزار"
  },
  {
    "poem_id": 1656,
    "vorder": 72,
    "position": 1,
    "text": "همه رزمجوی و همه نامدار"
  },
  {
    "poem_id": 1656,
    "vorder": 73,
    "position": 0,
    "text": "بدان تا پس پشت او زین گروه"
  },
  {
    "poem_id": 1656,
    "vorder": 74,
    "position": 1,
    "text": "در و دشت گردد به کردار کوه"
  },
  {
    "poem_id": 1656,
    "vorder": 75,
    "position": 0,
    "text": "از اخترشناسان و از موبدان"
  },
  {
    "poem_id": 1656,
    "vorder": 76,
    "position": 1,
    "text": "جهاندیده و نامور بخردان"
  },
  {
    "poem_id": 1656,
    "vorder": 77,
    "position": 0,
    "text": "همی برد با خویشتن شست مرد"
  },
  {
    "poem_id": 1656,
    "vorder": 78,
    "position": 1,
    "text": "پژوهندهٔ روزگار نبرد"
  },
  {
    "poem_id": 1656,
    "vorder": 79,
    "position": 0,
    "text": "چو آگاه شد فور کامد سپاه"
  },
  {
    "poem_id": 1656,
    "vorder": 80,
    "position": 1,
    "text": "گزین کرد جای از در رزمگاه"
  },
  {
    "poem_id": 1656,
    "vorder": 81,
    "position": 0,
    "text": "به دشت اندرون لشکر انبوه گشت"
  },
  {
    "poem_id": 1656,
    "vorder": 82,
    "position": 1,
    "text": "زمین از پی پیل چون کوه گشت"
  },
  {
    "poem_id": 1656,
    "vorder": 83,
    "position": 0,
    "text": "سپاهی کشیدند بر چار میل"
  },
  {
    "poem_id": 1656,
    "vorder": 84,
    "position": 1,
    "text": "پس پشت گردان و در پیش پیل"
  },
  {
    "poem_id": 1656,
    "vorder": 85,
    "position": 0,
    "text": "ز هندوستان نیز کارآگاهان"
  },
  {
    "poem_id": 1656,
    "vorder": 86,
    "position": 1,
    "text": "برفتند نزدیک شاه جهان"
  },
  {
    "poem_id": 1656,
    "vorder": 87,
    "position": 0,
    "text": "بگفتند با او بسی رزم پیل"
  },
  {
    "poem_id": 1656,
    "vorder": 88,
    "position": 1,
    "text": "که او اسپ را بفگند از دو میل"
  },
  {
    "poem_id": 1656,
    "vorder": 89,
    "position": 0,
    "text": "سواری نیارد بر او شدن"
  },
  {
    "poem_id": 1656,
    "vorder": 90,
    "position": 1,
    "text": "نه چون شد بود راه بازآمدن"
  },
  {
    "poem_id": 1656,
    "vorder": 91,
    "position": 0,
    "text": "که خرطوم او از هوا برترست"
  },
  {
    "poem_id": 1656,
    "vorder": 92,
    "position": 1,
    "text": "ز گردون مر او را زحل یاورست"
  },
  {
    "poem_id": 1656,
    "vorder": 93,
    "position": 0,
    "text": "به قرطاس بر پیل بنگاشتند"
  },
  {
    "poem_id": 1656,
    "vorder": 94,
    "position": 1,
    "text": "به چشم جهانجوی بگذاشتند"
  },
  {
    "poem_id": 1656,
    "vorder": 95,
    "position": 0,
    "text": "بفرمود تا فیلسوفان روم"
  },
  {
    "poem_id": 1656,
    "vorder": 96,
    "position": 1,
    "text": "یکی پیل کردند پیشش ز موم"
  },
  {
    "poem_id": 1656,
    "vorder": 97,
    "position": 0,
    "text": "چنین گفت کاکنون به پاکیزه رای"
  },
  {
    "poem_id": 1656,
    "vorder": 98,
    "position": 1,
    "text": "که آرد یکی چارهٔ این به جای"
  },
  {
    "poem_id": 1656,
    "vorder": 99,
    "position": 0,
    "text": "نشستند دانش پژوهان بهم"
  },
  {
    "poem_id": 1656,
    "vorder": 100,
    "position": 1,
    "text": "یکی چاره جستند بر بیش و کم"
  },
  {
    "poem_id": 1656,
    "vorder": 101,
    "position": 0,
    "text": "یکی انجمن کرد ز آهنگران"
  },
  {
    "poem_id": 1656,
    "vorder": 102,
    "position": 1,
    "text": "هرانکس که استاد بود اندران"
  },
  {
    "poem_id": 1656,
    "vorder": 103,
    "position": 0,
    "text": "ز رومی و از مصری و پارسی"
  },
  {
    "poem_id": 1656,
    "vorder": 104,
    "position": 1,
    "text": "فزون بود مرد از چهل بار سی"
  },
  {
    "poem_id": 1656,
    "vorder": 105,
    "position": 0,
    "text": "یکی بارگی ساختند آهنین"
  },
  {
    "poem_id": 1656,
    "vorder": 106,
    "position": 1,
    "text": "سوارش ز آهن ز آهنش زین"
  },
  {
    "poem_id": 1656,
    "vorder": 107,
    "position": 0,
    "text": "به میخ و به مس درزها دوختند"
  },
  {
    "poem_id": 1656,
    "vorder": 108,
    "position": 1,
    "text": "سوار و تن باره بفروختند"
  },
  {
    "poem_id": 1656,
    "vorder": 109,
    "position": 0,
    "text": "به گردون براندند بر پیش شاه"
  },
  {
    "poem_id": 1656,
    "vorder": 110,
    "position": 1,
    "text": "درونش پر از نفط کرده سیاه"
  },
  {
    "poem_id": 1656,
    "vorder": 111,
    "position": 0,
    "text": "سکندر بدید آن پسند آمدش"
  },
  {
    "poem_id": 1656,
    "vorder": 112,
    "position": 1,
    "text": "خردمند را سودمند آمدش"
  },
  {
    "poem_id": 1656,
    "vorder": 113,
    "position": 0,
    "text": "بفرمود تا زان فزون از هزار"
  },
  {
    "poem_id": 1656,
    "vorder": 114,
    "position": 1,
    "text": "ز آهن بکردند اسپ و سوار"
  },
  {
    "poem_id": 1656,
    "vorder": 115,
    "position": 0,
    "text": "ازان ابرش و خنگ و بور و سیاه"
  },
  {
    "poem_id": 1656,
    "vorder": 116,
    "position": 1,
    "text": "که دیدست شاهی ز آهن سپاه"
  },
  {
    "poem_id": 1656,
    "vorder": 117,
    "position": 0,
    "text": "از آهن سپاهی به گردون براند"
  },
  {
    "poem_id": 1656,
    "vorder": 118,
    "position": 1,
    "text": "که جز با سواران جنگی نماند"
  }
]