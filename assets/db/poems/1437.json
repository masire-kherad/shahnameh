[
  {
    "poem_id": 1437,
    "vorder": 1,
    "position": 0,
    "text": "چو از آفرین گشت پرداخته"
  },
  {
    "poem_id": 1437,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد گلرنگ را ساخته"
  },
  {
    "poem_id": 1437,
    "vorder": 3,
    "position": 0,
    "text": "نشست از بر زین و ره برگرفت"
  },
  {
    "poem_id": 1437,
    "vorder": 4,
    "position": 1,
    "text": "خم منزل جادو اندر گرفت"
  },
  {
    "poem_id": 1437,
    "vorder": 5,
    "position": 0,
    "text": "همی رفت پویان به راه دراز"
  },
  {
    "poem_id": 1437,
    "vorder": 6,
    "position": 1,
    "text": "چو خورشید تابان بگشت از فراز"
  },
  {
    "poem_id": 1437,
    "vorder": 7,
    "position": 0,
    "text": "درخت و گیا دید و آب روان"
  },
  {
    "poem_id": 1437,
    "vorder": 8,
    "position": 1,
    "text": "چنان چون بود جای مرد جوان"
  },
  {
    "poem_id": 1437,
    "vorder": 9,
    "position": 0,
    "text": "چو چشم تذروان یکی چشمه دید"
  },
  {
    "poem_id": 1437,
    "vorder": 10,
    "position": 1,
    "text": "یکی جام زرین برو پر نبید"
  },
  {
    "poem_id": 1437,
    "vorder": 11,
    "position": 0,
    "text": "یکی غرم بریان و نان از برش"
  },
  {
    "poem_id": 1437,
    "vorder": 12,
    "position": 1,
    "text": "نمکدان و ریچال گرد اندرش"
  },
  {
    "poem_id": 1437,
    "vorder": 13,
    "position": 0,
    "text": "خور جادوان بد چو رستم رسید"
  },
  {
    "poem_id": 1437,
    "vorder": 14,
    "position": 1,
    "text": "از آواز او دیو شد ناپدید"
  },
  {
    "poem_id": 1437,
    "vorder": 15,
    "position": 0,
    "text": "فرود آمد از باره زین برگرفت"
  },
  {
    "poem_id": 1437,
    "vorder": 16,
    "position": 1,
    "text": "به غرم و بنان اندر آمد شگفت"
  },
  {
    "poem_id": 1437,
    "vorder": 17,
    "position": 0,
    "text": "نشست از بر چشمه فرخنده‌پی"
  },
  {
    "poem_id": 1437,
    "vorder": 18,
    "position": 1,
    "text": "یکی جام زر دید پر کرده می"
  },
  {
    "poem_id": 1437,
    "vorder": 19,
    "position": 0,
    "text": "ابا می یکی نیز تنبور یافت"
  },
  {
    "poem_id": 1437,
    "vorder": 20,
    "position": 1,
    "text": "بیابان چنان خانهٔ سور یافت"
  },
  {
    "poem_id": 1437,
    "vorder": 21,
    "position": 0,
    "text": "تهمتن مر آن را به بر در گرفت"
  },
  {
    "poem_id": 1437,
    "vorder": 22,
    "position": 1,
    "text": "بزد رود و گفتارها برگرفت"
  },
  {
    "poem_id": 1437,
    "vorder": 23,
    "position": 0,
    "text": "که آواره و بد نشان رستم است"
  },
  {
    "poem_id": 1437,
    "vorder": 24,
    "position": 1,
    "text": "که از روز شادیش بهره غم است"
  },
  {
    "poem_id": 1437,
    "vorder": 25,
    "position": 0,
    "text": "همه جای جنگست میدان اوی"
  },
  {
    "poem_id": 1437,
    "vorder": 26,
    "position": 1,
    "text": "بیابان و کوهست بستان اوی"
  },
  {
    "poem_id": 1437,
    "vorder": 27,
    "position": 0,
    "text": "همه جنگ با شیر و نر اژدهاست"
  },
  {
    "poem_id": 1437,
    "vorder": 28,
    "position": 1,
    "text": "کجا اژدها از کفش نا رهاست"
  },
  {
    "poem_id": 1437,
    "vorder": 29,
    "position": 0,
    "text": "می و جام و بویا گل و میگسار"
  },
  {
    "poem_id": 1437,
    "vorder": 30,
    "position": 1,
    "text": "نکردست بخشش ورا کردگار"
  },
  {
    "poem_id": 1437,
    "vorder": 31,
    "position": 0,
    "text": "همیشه به جنگ نهنگ اندر است"
  },
  {
    "poem_id": 1437,
    "vorder": 32,
    "position": 1,
    "text": "و گر با پلنگان به جنگ اندر است"
  },
  {
    "poem_id": 1437,
    "vorder": 33,
    "position": 0,
    "text": "به گوش زن جادو آمد سرود"
  },
  {
    "poem_id": 1437,
    "vorder": 34,
    "position": 1,
    "text": "همان نالهٔ رستم و زخم رود"
  },
  {
    "poem_id": 1437,
    "vorder": 35,
    "position": 0,
    "text": "بیاراست رخ را بسان بهار"
  },
  {
    "poem_id": 1437,
    "vorder": 36,
    "position": 1,
    "text": "وگر چند زیبا نبودش نگار"
  },
  {
    "poem_id": 1437,
    "vorder": 37,
    "position": 0,
    "text": "بر رستم آمد پر از رنگ و بوی"
  },
  {
    "poem_id": 1437,
    "vorder": 38,
    "position": 1,
    "text": "بپرسید و بنشست نزدیک اوی"
  },
  {
    "poem_id": 1437,
    "vorder": 39,
    "position": 0,
    "text": "تهمتن به یزدان نیایش گرفت"
  },
  {
    "poem_id": 1437,
    "vorder": 40,
    "position": 1,
    "text": "ابر آفرینها فزایش گرفت"
  },
  {
    "poem_id": 1437,
    "vorder": 41,
    "position": 0,
    "text": "که در دشت مازندران یافت خوان"
  },
  {
    "poem_id": 1437,
    "vorder": 42,
    "position": 1,
    "text": "می و جام، با میگسار جوان"
  },
  {
    "poem_id": 1437,
    "vorder": 43,
    "position": 0,
    "text": "ندانست کاو جادوی ریمنست"
  },
  {
    "poem_id": 1437,
    "vorder": 44,
    "position": 1,
    "text": "نهفته به رنگ اندر اهریمنست"
  },
  {
    "poem_id": 1437,
    "vorder": 45,
    "position": 0,
    "text": "یکی طاس می بر کفش برنهاد"
  },
  {
    "poem_id": 1437,
    "vorder": 46,
    "position": 1,
    "text": "ز دادار نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1437,
    "vorder": 47,
    "position": 0,
    "text": "چو آواز داد از خداوند مهر"
  },
  {
    "poem_id": 1437,
    "vorder": 48,
    "position": 1,
    "text": "دگرگونه‌تر گشت جادو به چهر"
  },
  {
    "poem_id": 1437,
    "vorder": 49,
    "position": 0,
    "text": "روانش گمان نیایش نداشت"
  },
  {
    "poem_id": 1437,
    "vorder": 50,
    "position": 1,
    "text": "زبانش توان ستایش نداشت"
  },
  {
    "poem_id": 1437,
    "vorder": 51,
    "position": 0,
    "text": "سیه گشت چون نام یزدان شنید"
  },
  {
    "poem_id": 1437,
    "vorder": 52,
    "position": 1,
    "text": "تهمتن سبک چون درو بنگرید"
  },
  {
    "poem_id": 1437,
    "vorder": 53,
    "position": 0,
    "text": "بینداخت از باد خم کمند"
  },
  {
    "poem_id": 1437,
    "vorder": 54,
    "position": 1,
    "text": "سر جادو آورد ناگه ببند"
  },
  {
    "poem_id": 1437,
    "vorder": 55,
    "position": 0,
    "text": "بپرسید و گفتش چه چیزی بگوی"
  },
  {
    "poem_id": 1437,
    "vorder": 56,
    "position": 1,
    "text": "بدان‌گونه کت هست بنمای روی"
  },
  {
    "poem_id": 1437,
    "vorder": 57,
    "position": 0,
    "text": "یکی گنده پیری شد اندر کمند"
  },
  {
    "poem_id": 1437,
    "vorder": 58,
    "position": 1,
    "text": "پر آژنگ و نیرنگ و بند و گزند"
  },
  {
    "poem_id": 1437,
    "vorder": 59,
    "position": 0,
    "text": "میانش به خنجر به دو نیم کرد"
  },
  {
    "poem_id": 1437,
    "vorder": 60,
    "position": 1,
    "text": "دل جادوان زو پر از بیم کرد"
  }
]