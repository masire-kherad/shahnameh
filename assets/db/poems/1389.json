[
  {
    "poem_id": 1389,
    "vorder": 1,
    "position": 0,
    "text": "میان سپهدار و آن سرو بن"
  },
  {
    "poem_id": 1389,
    "vorder": 2,
    "position": 1,
    "text": "زنی بود گوینده شیرین سخن"
  },
  {
    "poem_id": 1389,
    "vorder": 3,
    "position": 0,
    "text": "پیام آوریدی سوی پهلوان"
  },
  {
    "poem_id": 1389,
    "vorder": 4,
    "position": 1,
    "text": "هم از پهلوان سوی سرو روان"
  },
  {
    "poem_id": 1389,
    "vorder": 5,
    "position": 0,
    "text": "سپهدار دستان مر او را بخواند"
  },
  {
    "poem_id": 1389,
    "vorder": 6,
    "position": 1,
    "text": "سخن هر چه بشنید با او براند"
  },
  {
    "poem_id": 1389,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت نزدیک رودابه رو"
  },
  {
    "poem_id": 1389,
    "vorder": 8,
    "position": 1,
    "text": "بگویش که ای نیک دل ماه نو"
  },
  {
    "poem_id": 1389,
    "vorder": 9,
    "position": 0,
    "text": "سخن چون ز تنگی به سختی رسید"
  },
  {
    "poem_id": 1389,
    "vorder": 10,
    "position": 1,
    "text": "فراخیش را زود بینی کلید"
  },
  {
    "poem_id": 1389,
    "vorder": 11,
    "position": 0,
    "text": "فرستاده باز آمد از پیش سام"
  },
  {
    "poem_id": 1389,
    "vorder": 12,
    "position": 1,
    "text": "ابا شادمانی و فرخ پیام"
  },
  {
    "poem_id": 1389,
    "vorder": 13,
    "position": 0,
    "text": "بسی گفت و بشنید و زد داستان"
  },
  {
    "poem_id": 1389,
    "vorder": 14,
    "position": 1,
    "text": "سرانجام او گشت همداستان"
  },
  {
    "poem_id": 1389,
    "vorder": 15,
    "position": 0,
    "text": "سبک پاسخ نامه زن را سپرد"
  },
  {
    "poem_id": 1389,
    "vorder": 16,
    "position": 1,
    "text": "زن از پیش او بازگشت و ببرد"
  },
  {
    "poem_id": 1389,
    "vorder": 17,
    "position": 0,
    "text": "به نزدیک رودابه آمد چو باد"
  },
  {
    "poem_id": 1389,
    "vorder": 18,
    "position": 1,
    "text": "بدین شادمانی ورا مژده داد"
  },
  {
    "poem_id": 1389,
    "vorder": 19,
    "position": 0,
    "text": "پری روی بر زن درم برفشاند"
  },
  {
    "poem_id": 1389,
    "vorder": 20,
    "position": 1,
    "text": "به کرسی زر پیکرش برنشاند"
  },
  {
    "poem_id": 1389,
    "vorder": 21,
    "position": 0,
    "text": "یکی شاره سربند پیش آورید"
  },
  {
    "poem_id": 1389,
    "vorder": 22,
    "position": 1,
    "text": "شده تار و پود اندرو ناپدید"
  },
  {
    "poem_id": 1389,
    "vorder": 23,
    "position": 0,
    "text": "همه پیکرش سرخ یاقوت و زر"
  },
  {
    "poem_id": 1389,
    "vorder": 24,
    "position": 1,
    "text": "شده زر همه ناپدید از گهر"
  },
  {
    "poem_id": 1389,
    "vorder": 25,
    "position": 0,
    "text": "یکی جفت پر مایه انگشتری"
  },
  {
    "poem_id": 1389,
    "vorder": 26,
    "position": 1,
    "text": "فروزنده چون بر فلک مشتری"
  },
  {
    "poem_id": 1389,
    "vorder": 27,
    "position": 0,
    "text": "فرستاد نزدیک دستان سام"
  },
  {
    "poem_id": 1389,
    "vorder": 28,
    "position": 1,
    "text": "بسی داد با آن درود و پیام"
  },
  {
    "poem_id": 1389,
    "vorder": 29,
    "position": 0,
    "text": "زن از حجره آنگه به ایوان رسید"
  },
  {
    "poem_id": 1389,
    "vorder": 30,
    "position": 1,
    "text": "نگه کرد سیندخت او را بدید"
  },
  {
    "poem_id": 1389,
    "vorder": 31,
    "position": 0,
    "text": "زن از بیم برگشت چون سندروس"
  },
  {
    "poem_id": 1389,
    "vorder": 32,
    "position": 1,
    "text": "بترسید و روی زمین داد بوس"
  },
  {
    "poem_id": 1389,
    "vorder": 33,
    "position": 0,
    "text": "پر اندیشه شد جان سیندخت ازوی"
  },
  {
    "poem_id": 1389,
    "vorder": 34,
    "position": 1,
    "text": "به آواز گفت از کجایی بگوی"
  },
  {
    "poem_id": 1389,
    "vorder": 35,
    "position": 0,
    "text": "زمان تا زمان پیش من بگذری"
  },
  {
    "poem_id": 1389,
    "vorder": 36,
    "position": 1,
    "text": "به حجره درآیی به من ننگری"
  },
  {
    "poem_id": 1389,
    "vorder": 37,
    "position": 0,
    "text": "دل روشنم بر تو شد بدگمان"
  },
  {
    "poem_id": 1389,
    "vorder": 38,
    "position": 1,
    "text": "بگویی مرا تا زهی گر کمان"
  },
  {
    "poem_id": 1389,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت زن من یکی چاره‌جوی"
  },
  {
    "poem_id": 1389,
    "vorder": 40,
    "position": 1,
    "text": "همی نان فراز آرم از چند روی"
  },
  {
    "poem_id": 1389,
    "vorder": 41,
    "position": 0,
    "text": "بدین حجره رودابه پیرایه خواست"
  },
  {
    "poem_id": 1389,
    "vorder": 42,
    "position": 1,
    "text": "بدو دادم اکنون همینست راست"
  },
  {
    "poem_id": 1389,
    "vorder": 43,
    "position": 0,
    "text": "بیاوردمش افسر پرنگار"
  },
  {
    "poem_id": 1389,
    "vorder": 44,
    "position": 1,
    "text": "یکی حلقه پرگوهر شاهوار"
  },
  {
    "poem_id": 1389,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت سیندخت بنمایی‌ام"
  },
  {
    "poem_id": 1389,
    "vorder": 46,
    "position": 1,
    "text": "دل بسته ز اندیشه بگشایی‌ام"
  },
  {
    "poem_id": 1389,
    "vorder": 47,
    "position": 0,
    "text": "سپردم به رودابه گفت این دو چیز"
  },
  {
    "poem_id": 1389,
    "vorder": 48,
    "position": 1,
    "text": "فزون خواست اکنون بیارمش نیز"
  },
  {
    "poem_id": 1389,
    "vorder": 49,
    "position": 0,
    "text": "بها گفت بگذار بر چشم من"
  },
  {
    "poem_id": 1389,
    "vorder": 50,
    "position": 1,
    "text": "یکی آب بر زن برین خشم من"
  },
  {
    "poem_id": 1389,
    "vorder": 51,
    "position": 0,
    "text": "درم گفت فردا دهد ماه روی"
  },
  {
    "poem_id": 1389,
    "vorder": 52,
    "position": 1,
    "text": "بها تا نیابم تو از من مجوی"
  },
  {
    "poem_id": 1389,
    "vorder": 53,
    "position": 0,
    "text": "همی کژ دانست گفتار او"
  },
  {
    "poem_id": 1389,
    "vorder": 54,
    "position": 1,
    "text": "بیاراست دل را به پیکار او"
  },
  {
    "poem_id": 1389,
    "vorder": 55,
    "position": 0,
    "text": "بیامد بجستش بر و آستی"
  },
  {
    "poem_id": 1389,
    "vorder": 56,
    "position": 1,
    "text": "همی جست ازو کژی و کاستی"
  },
  {
    "poem_id": 1389,
    "vorder": 57,
    "position": 0,
    "text": "به خشم اندرون شد ازان زن غمی"
  },
  {
    "poem_id": 1389,
    "vorder": 58,
    "position": 1,
    "text": "به خواری کشیدش بروی زمی"
  },
  {
    "poem_id": 1389,
    "vorder": 59,
    "position": 0,
    "text": "چو آن جامه‌های گرانمایه دید"
  },
  {
    "poem_id": 1389,
    "vorder": 60,
    "position": 1,
    "text": "هم از دست رودابه پیرایه دید"
  },
  {
    "poem_id": 1389,
    "vorder": 61,
    "position": 0,
    "text": "در کاخ بر خویشتن بر ببست"
  },
  {
    "poem_id": 1389,
    "vorder": 62,
    "position": 1,
    "text": "از اندیشگان شد به کردار مست"
  },
  {
    "poem_id": 1389,
    "vorder": 63,
    "position": 0,
    "text": "بفرمود تا دخترش رفت پیش"
  },
  {
    "poem_id": 1389,
    "vorder": 64,
    "position": 1,
    "text": "همی دست برزد به رخسار خویش"
  },
  {
    "poem_id": 1389,
    "vorder": 65,
    "position": 0,
    "text": "دو گل را به دو نرگس خوابدار"
  },
  {
    "poem_id": 1389,
    "vorder": 66,
    "position": 1,
    "text": "همی شست تا شد گلان آبدار"
  },
  {
    "poem_id": 1389,
    "vorder": 67,
    "position": 0,
    "text": "به رودابه گفت ای سرافراز ماه"
  },
  {
    "poem_id": 1389,
    "vorder": 68,
    "position": 1,
    "text": "گزین کردی از ناز برگاه چاه"
  },
  {
    "poem_id": 1389,
    "vorder": 69,
    "position": 0,
    "text": "چه ماند از نکو داشتی در جهان"
  },
  {
    "poem_id": 1389,
    "vorder": 70,
    "position": 1,
    "text": "که ننمودمت آشکار و نهان"
  },
  {
    "poem_id": 1389,
    "vorder": 71,
    "position": 0,
    "text": "ستمگر چرا گشتی ای ماه‌روی"
  },
  {
    "poem_id": 1389,
    "vorder": 72,
    "position": 1,
    "text": "همه رازها پیش مادر بگوی"
  },
  {
    "poem_id": 1389,
    "vorder": 73,
    "position": 0,
    "text": "که این زن ز پیش که آید همی"
  },
  {
    "poem_id": 1389,
    "vorder": 74,
    "position": 1,
    "text": "به پیشت ز بهر چه آید همی"
  },
  {
    "poem_id": 1389,
    "vorder": 75,
    "position": 0,
    "text": "سخن بر چه سانست و آن مرد کیست"
  },
  {
    "poem_id": 1389,
    "vorder": 76,
    "position": 1,
    "text": "که زیبای سربند و انگشتریست"
  },
  {
    "poem_id": 1389,
    "vorder": 77,
    "position": 0,
    "text": "ز گنج بزرگ افسر تازیان"
  },
  {
    "poem_id": 1389,
    "vorder": 78,
    "position": 1,
    "text": "به ما ماند بسیار سود و زیان"
  },
  {
    "poem_id": 1389,
    "vorder": 79,
    "position": 0,
    "text": "بدین نام بد دادخواهی به باد"
  },
  {
    "poem_id": 1389,
    "vorder": 80,
    "position": 1,
    "text": "چو من زاده‌ام دخت هرگز مباد"
  },
  {
    "poem_id": 1389,
    "vorder": 81,
    "position": 0,
    "text": "زمین دید رودابه و پشت پای"
  },
  {
    "poem_id": 1389,
    "vorder": 82,
    "position": 1,
    "text": "فرو ماند از خشم مادر به جای"
  },
  {
    "poem_id": 1389,
    "vorder": 83,
    "position": 0,
    "text": "فرو ریخت از دیدگان آب مهر"
  },
  {
    "poem_id": 1389,
    "vorder": 84,
    "position": 1,
    "text": "به خون دو نرگس بیاراست چهر"
  },
  {
    "poem_id": 1389,
    "vorder": 85,
    "position": 0,
    "text": "به مادر چنین گفت کای پر خرد"
  },
  {
    "poem_id": 1389,
    "vorder": 86,
    "position": 1,
    "text": "همی مهر جان مرا بشکرد"
  },
  {
    "poem_id": 1389,
    "vorder": 87,
    "position": 0,
    "text": "مرا مام فرخ نزادی ز بن"
  },
  {
    "poem_id": 1389,
    "vorder": 88,
    "position": 1,
    "text": "نرفتی ز من نیک یا بد سخن"
  },
  {
    "poem_id": 1389,
    "vorder": 89,
    "position": 0,
    "text": "سپهدار دستان به کابل بماند"
  },
  {
    "poem_id": 1389,
    "vorder": 90,
    "position": 1,
    "text": "چنین مهر اویم بر آتش نشاند"
  },
  {
    "poem_id": 1389,
    "vorder": 91,
    "position": 0,
    "text": "چنان تنگ شد بر دلم بر جهان"
  },
  {
    "poem_id": 1389,
    "vorder": 92,
    "position": 1,
    "text": "که گریان شدم آشکار و نهان"
  },
  {
    "poem_id": 1389,
    "vorder": 93,
    "position": 0,
    "text": "نخواهم بدن زنده بی‌روی او"
  },
  {
    "poem_id": 1389,
    "vorder": 94,
    "position": 1,
    "text": "جهانم نیرزد به یک موی او"
  },
  {
    "poem_id": 1389,
    "vorder": 95,
    "position": 0,
    "text": "بدان کو مرا دید و بامن نشست"
  },
  {
    "poem_id": 1389,
    "vorder": 96,
    "position": 1,
    "text": "به پیمان گرفتیم دستش بدست"
  },
  {
    "poem_id": 1389,
    "vorder": 97,
    "position": 0,
    "text": "فرستاده شد نزد سام بزرگ"
  },
  {
    "poem_id": 1389,
    "vorder": 98,
    "position": 1,
    "text": "فرستاد پاسخ به زال سترگ"
  },
  {
    "poem_id": 1389,
    "vorder": 99,
    "position": 0,
    "text": "زمانی بپیچید و دستور بود"
  },
  {
    "poem_id": 1389,
    "vorder": 100,
    "position": 1,
    "text": "سخنهای بایسته گفت و شنود"
  },
  {
    "poem_id": 1389,
    "vorder": 101,
    "position": 0,
    "text": "فرستاده را داد بسیار چیز"
  },
  {
    "poem_id": 1389,
    "vorder": 102,
    "position": 1,
    "text": "شنیدم همه پاسخ سام نیز"
  },
  {
    "poem_id": 1389,
    "vorder": 103,
    "position": 0,
    "text": "به دست همین زن که کندیش موی"
  },
  {
    "poem_id": 1389,
    "vorder": 104,
    "position": 1,
    "text": "زدی بر زمین و کشیدی به روی"
  },
  {
    "poem_id": 1389,
    "vorder": 105,
    "position": 0,
    "text": "فرستاده آرندهٔ نامه بود"
  },
  {
    "poem_id": 1389,
    "vorder": 106,
    "position": 1,
    "text": "مرا پاسخ نامه این جامه بود"
  },
  {
    "poem_id": 1389,
    "vorder": 107,
    "position": 0,
    "text": "فروماند سیندخت زان گفت‌گوی"
  },
  {
    "poem_id": 1389,
    "vorder": 108,
    "position": 1,
    "text": "پسند آمدش زال را جفت اوی"
  },
  {
    "poem_id": 1389,
    "vorder": 109,
    "position": 0,
    "text": "چنین داد پاسخ که این خرد نیست"
  },
  {
    "poem_id": 1389,
    "vorder": 110,
    "position": 1,
    "text": "چو دستان ز پرمایگان گرد نیست"
  },
  {
    "poem_id": 1389,
    "vorder": 111,
    "position": 0,
    "text": "بزرگست پور جهان پهلوان"
  },
  {
    "poem_id": 1389,
    "vorder": 112,
    "position": 1,
    "text": "همش نام و هم رای روشن روان"
  },
  {
    "poem_id": 1389,
    "vorder": 113,
    "position": 0,
    "text": "هنرها همه هست و آهو یکی"
  },
  {
    "poem_id": 1389,
    "vorder": 114,
    "position": 1,
    "text": "که گردد هنر پیش او اندکی"
  },
  {
    "poem_id": 1389,
    "vorder": 115,
    "position": 0,
    "text": "شود شاه گیتی بدین خشمناک"
  },
  {
    "poem_id": 1389,
    "vorder": 116,
    "position": 1,
    "text": "ز کابل برآرد به خورشید خاک"
  },
  {
    "poem_id": 1389,
    "vorder": 117,
    "position": 0,
    "text": "نخواهد که از تخم ما بر زمین"
  },
  {
    "poem_id": 1389,
    "vorder": 118,
    "position": 1,
    "text": "کسی پای خوار اندر آرد به زین"
  },
  {
    "poem_id": 1389,
    "vorder": 119,
    "position": 0,
    "text": "رها کرد زن را و بنواختش"
  },
  {
    "poem_id": 1389,
    "vorder": 120,
    "position": 1,
    "text": "چنان کرد پیدا که نشناختش"
  },
  {
    "poem_id": 1389,
    "vorder": 121,
    "position": 0,
    "text": "چنان دید رودابه را در نهان"
  },
  {
    "poem_id": 1389,
    "vorder": 122,
    "position": 1,
    "text": "کجا نشنود پند کس در جهان"
  },
  {
    "poem_id": 1389,
    "vorder": 123,
    "position": 0,
    "text": "بیامد ز تیمار گریان بخفت"
  },
  {
    "poem_id": 1389,
    "vorder": 124,
    "position": 1,
    "text": "همی پوست بر تنش گفتی بکفت"
  }
]