  {
    "poem_id": 1600,
    "vorder": 158,
    "position": 1,
    "text": "چنانچون بود مردم گزپرست"
  },
  {
    "poem_id": 1600,
    "vorder": 159,
    "position": 0,
    "text": "زمانه برد راست آن را به چشم"
  },
  {
    "poem_id": 1600,
    "vorder": 160,
    "position": 1,
    "text": "بدانگه که باشد دلت پر ز خشم"
