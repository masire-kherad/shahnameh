  {
    "poem_id": 1600,
    "vorder": 162,
    "position": 1,
    "text": "ازو تار وز خویشتن پود کرد"
  },
  {
    "poem_id": 1600,
    "vorder": 163,
    "position": 0,
    "text": "ازان جایگه نیک‌دل برپرید"
  },
  {
