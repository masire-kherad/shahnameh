[
  {
    "poem_id": 1600,
    "vorder": 1,
    "position": 0,
    "text": "ببودند هر دو بران رای مند"
  },
  {
    "poem_id": 1600,
    "vorder": 2,
    "position": 1,
    "text": "سپهبد برآمد به بالا بلند"
  },
  {
    "poem_id": 1600,
    "vorder": 3,
    "position": 0,
    "text": "از ایوان سه مجمر پر آتش ببرد"
  },
  {
    "poem_id": 1600,
    "vorder": 4,
    "position": 1,
    "text": "برفتند با او سه هشیار و گرد"
  },
  {
    "poem_id": 1600,
    "vorder": 5,
    "position": 0,
    "text": "فسونگر چو بر تیغ بالا رسید"
  },
  {
    "poem_id": 1600,
    "vorder": 6,
    "position": 1,
    "text": "ز دیبا یکی پر بیرون کشید"
  },
  {
    "poem_id": 1600,
    "vorder": 7,
    "position": 0,
    "text": "ز مجمر یکی آتشی برفروخت"
  },
  {
    "poem_id": 1600,
    "vorder": 8,
    "position": 1,
    "text": "به بالای آن پر لختی بسوخت"
  },
  {
    "poem_id": 1600,
    "vorder": 9,
    "position": 0,
    "text": "چو پاسی ازان تیره شب درگذشت"
  },
  {
    "poem_id": 1600,
    "vorder": 10,
    "position": 1,
    "text": "تو گفتی چو آهن سیاه ابر گشت"
  },
  {
    "poem_id": 1600,
    "vorder": 11,
    "position": 0,
    "text": "همانگه چو مرغ از هوا بنگرید"
  },
  {
    "poem_id": 1600,
    "vorder": 12,
    "position": 1,
    "text": "درخشیدن آتش تیز دید"
  },
  {
    "poem_id": 1600,
    "vorder": 13,
    "position": 0,
    "text": "نشسته برش زال با درد و غم"
  },
  {
    "poem_id": 1600,
    "vorder": 14,
    "position": 1,
    "text": "ز پرواز مرغ اندر آمد دژم"
  },
  {
    "poem_id": 1600,
    "vorder": 15,
    "position": 0,
    "text": "بشد پیش با عود زال از فراز"
  },
  {
    "poem_id": 1600,
    "vorder": 16,
    "position": 1,
    "text": "ستودش فراوان و بردش نماز"
  },
  {
    "poem_id": 1600,
    "vorder": 17,
    "position": 0,
    "text": "به پیشش سه مجمر پر از بوی کرد"
  },
  {
    "poem_id": 1600,
    "vorder": 18,
    "position": 1,
    "text": "ز خون جگر بر دو رخ جوی کرد"
  },
  {
    "poem_id": 1600,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت سیمرغ شاها چه بود"
  },
  {
    "poem_id": 1600,
    "vorder": 20,
    "position": 1,
    "text": "که آمد ازین سان نیازت به دود"
  },
  {
    "poem_id": 1600,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت کاین بد به دشمن رساد"
  },
  {
    "poem_id": 1600,
    "vorder": 22,
    "position": 1,
    "text": "که بر من رسید از بد بدنژاد"
  },
  {
    "poem_id": 1600,
    "vorder": 23,
    "position": 0,
    "text": "تن رستم شیردل خسته شد"
  },
  {
    "poem_id": 1600,
    "vorder": 24,
    "position": 1,
    "text": "ازان خستگی جان من بسته شد"
  },
  {
    "poem_id": 1600,
    "vorder": 25,
    "position": 0,
    "text": "کزان خستگی بیم جانست و بس"
  },
  {
    "poem_id": 1600,
    "vorder": 26,
    "position": 1,
    "text": "بران گونه خسته ندیدست کس"
  },
  {
    "poem_id": 1600,
    "vorder": 27,
    "position": 0,
    "text": "همان رخش گویی که بیجان شدست"
  },
  {
    "poem_id": 1600,
    "vorder": 28,
    "position": 1,
    "text": "ز پیکان تنش زار و بیجان شدست"
  },
  {
    "poem_id": 1600,
    "vorder": 29,
    "position": 0,
    "text": "بیامد برین کشور اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 30,
    "position": 1,
    "text": "نکوبد همی جز در کارزار"
  },
  {
    "poem_id": 1600,
    "vorder": 31,
    "position": 0,
    "text": "نجوید همی کشور و تاج و تخت"
  },
  {
    "poem_id": 1600,
    "vorder": 32,
    "position": 1,
    "text": "برو بار خواهد همی با درخت"
  },
  {
    "poem_id": 1600,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت سیمرغ کای پهلوان"
  },
  {
    "poem_id": 1600,
    "vorder": 34,
    "position": 1,
    "text": "مباش اندرین کار خسته‌روان"
  },
  {
    "poem_id": 1600,
    "vorder": 35,
    "position": 0,
    "text": "سزد گر نمایی به من رخش را"
  },
  {
    "poem_id": 1600,
    "vorder": 36,
    "position": 1,
    "text": "همان سرفراز جهان‌بخش را"
  },
  {
    "poem_id": 1600,
    "vorder": 37,
    "position": 0,
    "text": "کسی سوی رستم فرستاد زال"
  },
  {
    "poem_id": 1600,
    "vorder": 38,
    "position": 1,
    "text": "که لختی به چاره برافراز یال"
  },
  {
    "poem_id": 1600,
    "vorder": 39,
    "position": 0,
    "text": "بفرمای تا رخش را همچنان"
  },
  {
    "poem_id": 1600,
    "vorder": 40,
    "position": 1,
    "text": "بیارند پیش من اندر زمان"
  },
  {
    "poem_id": 1600,
    "vorder": 41,
    "position": 0,
    "text": "چو رستم بران تند بالا رسید"
  },
  {
    "poem_id": 1600,
    "vorder": 42,
    "position": 1,
    "text": "همان مرغ روشن‌دل او را بدید"
  },
  {
    "poem_id": 1600,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت کای ژنده پیل بلند"
  },
  {
    "poem_id": 1600,
    "vorder": 44,
    "position": 1,
    "text": "ز دست که گشتی بدین سان نژند"
  },
  {
    "poem_id": 1600,
    "vorder": 45,
    "position": 0,
    "text": "چرا رزم جستی ز اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 46,
    "position": 1,
    "text": "چرا آتش افگندی اندر کنار"
  },
  {
    "poem_id": 1600,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت زال ای خداوند مهر"
  },
  {
    "poem_id": 1600,
    "vorder": 48,
    "position": 1,
    "text": "چو اکنون نمودی بما پاک چهر"
  },
  {
    "poem_id": 1600,
    "vorder": 49,
    "position": 0,
    "text": "گر ایدونک رستم نگردد درست"
  },
  {
    "poem_id": 1600,
    "vorder": 50,
    "position": 1,
    "text": "کجا خواهم اندر جهان جای جست"
  },
  {
    "poem_id": 1600,
    "vorder": 51,
    "position": 0,
    "text": "همه سیستان پاک ویران کنند"
  },
  {
    "poem_id": 1600,
    "vorder": 52,
    "position": 1,
    "text": "به کام دلیران ایران کنند"
  },
  {
    "poem_id": 1600,
    "vorder": 53,
    "position": 0,
    "text": "شود کنده این تخمهٔ ما ز بن"
  },
  {
    "poem_id": 1600,
    "vorder": 54,
    "position": 1,
    "text": "کنون بر چه رانیم یکسر سخن"
  },
  {
    "poem_id": 1600,
    "vorder": 55,
    "position": 0,
    "text": "نگه کرد مرغ اندران خستگی"
  },
  {
    "poem_id": 1600,
    "vorder": 56,
    "position": 1,
    "text": "بدید اندرو راه پیوستگی"
  },
  {
    "poem_id": 1600,
    "vorder": 57,
    "position": 0,
    "text": "ازو چار پیکان به بیرون کشید"
  },
  {
    "poem_id": 1600,
    "vorder": 58,
    "position": 1,
    "text": "به منقار از ان خستگی خون کشید"
  },
  {
    "poem_id": 1600,
    "vorder": 59,
    "position": 0,
    "text": "بران خستگیها بمالید پر"
  },
  {
    "poem_id": 1600,
    "vorder": 60,
    "position": 1,
    "text": "هم اندر زمان گشت با زیب و فر"
  },
  {
    "poem_id": 1600,
    "vorder": 61,
    "position": 0,
    "text": "بدو گفت کاین خستگیها ببند"
  },
  {
    "poem_id": 1600,
    "vorder": 62,
    "position": 1,
    "text": "همی باش یکچند دور از گزند"
  },
  {
    "poem_id": 1600,
    "vorder": 63,
    "position": 0,
    "text": "یکی پر من تر بگردان به شیر"
  },
  {
    "poem_id": 1600,
    "vorder": 64,
    "position": 1,
    "text": "بمال اندران خستگیهای تیر"
  },
  {
    "poem_id": 1600,
    "vorder": 65,
    "position": 0,
    "text": "بران همنشان رخش را پیش خواست"
  },
  {
    "poem_id": 1600,
    "vorder": 66,
    "position": 1,
    "text": "فرو کرد منقار بر دست راست"
  },
  {
    "poem_id": 1600,
    "vorder": 67,
    "position": 0,
    "text": "برون کرد پیکان شش از گردنش"
  },
  {
    "poem_id": 1600,
    "vorder": 68,
    "position": 1,
    "text": "نبد خسته گر بسته جایی تنش"
  },
  {
    "poem_id": 1600,
    "vorder": 69,
    "position": 0,
    "text": "همانگه خروشی برآورد رخش"
  },
  {
    "poem_id": 1600,
    "vorder": 70,
    "position": 1,
    "text": "بخندید شادان دل تاج‌بخش"
  },
  {
    "poem_id": 1600,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت مرغ ای گو پیلتن"
  },
  {
    "poem_id": 1600,
    "vorder": 72,
    "position": 1,
    "text": "توی نامبردار هر انجمن"
  },
  {
    "poem_id": 1600,
    "vorder": 73,
    "position": 0,
    "text": "چرا رزم جستی ز اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 74,
    "position": 1,
    "text": "که او هست رویین‌تن و نامدار"
  },
  {
    "poem_id": 1600,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت رستم گر او را ز بند"
  },
  {
    "poem_id": 1600,
    "vorder": 76,
    "position": 1,
    "text": "نبودی دل من نگشتی نژند"
  },
  {
    "poem_id": 1600,
    "vorder": 77,
    "position": 0,
    "text": "مرا کشتن آسان‌تر آید ز ننگ"
  },
  {
    "poem_id": 1600,
    "vorder": 78,
    "position": 1,
    "text": "وگر بازمانم به جایی ز جنگ"
  },
  {
    "poem_id": 1600,
    "vorder": 79,
    "position": 0,
    "text": "چنین داد پاسخ کز اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 80,
    "position": 1,
    "text": "اگر سر بجا آوری نیست عار"
  },
  {
    "poem_id": 1600,
    "vorder": 81,
    "position": 0,
    "text": "که اندر زمانه چنویی نخاست"
  },
  {
    "poem_id": 1600,
    "vorder": 82,
    "position": 1,
    "text": "بدو دارد ایران همی پشت راست"
  },
  {
    "poem_id": 1600,
    "vorder": 83,
    "position": 0,
    "text": "بپرهیزی از وی نباشد شگفت"
  },
  {
    "poem_id": 1600,
    "vorder": 84,
    "position": 1,
    "text": "مرا از خود اندازه باید گرفت"
  },
  {
    "poem_id": 1600,
    "vorder": 85,
    "position": 0,
    "text": "که آن جفت من مرغ با دستگاه"
  },
  {
    "poem_id": 1600,
    "vorder": 86,
    "position": 1,
    "text": "به دستان و شمشیر کردش تباه"
  },
  {
    "poem_id": 1600,
    "vorder": 87,
    "position": 0,
    "text": "اگر با من اکنون تو پیمان کنی"
  },
  {
    "poem_id": 1600,
    "vorder": 88,
    "position": 1,
    "text": "سر از جنگ جستن پشمان کنی"
  },
  {
    "poem_id": 1600,
    "vorder": 89,
    "position": 0,
    "text": "نجویی فزونی به اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 90,
    "position": 1,
    "text": "گه کوشش و جستن کارزار"
  },
  {
    "poem_id": 1600,
    "vorder": 91,
    "position": 0,
    "text": "ور ایدونک او را بیامد زمان"
  },
  {
    "poem_id": 1600,
    "vorder": 92,
    "position": 1,
    "text": "نیندیشی از پوزش بی‌گمان"
  },
  {
    "poem_id": 1600,
    "vorder": 93,
    "position": 0,
    "text": "پس‌انگه یکی چاره سازم ترا"
  },
  {
    "poem_id": 1600,
    "vorder": 94,
    "position": 1,
    "text": "به خورشید سر برفرازم ترا"
  },
  {
    "poem_id": 1600,
    "vorder": 95,
    "position": 0,
    "text": "چو بشنید رستم دلش شاد شد"
  },
  {
    "poem_id": 1600,
    "vorder": 96,
    "position": 1,
    "text": "از اندیشهٔ بستن آزاد شد"
  },
  {
    "poem_id": 1600,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت کز گفت تو نگذرم"
  },
  {
    "poem_id": 1600,
    "vorder": 98,
    "position": 1,
    "text": "وگر تیغ بارد هوا بر سرم"
  },
  {
    "poem_id": 1600,
    "vorder": 99,
    "position": 0,
    "text": "چنین گفت سیمرغ کز راه مهر"
  },
  {
    "poem_id": 1600,
    "vorder": 100,
    "position": 1,
    "text": "بگویم کنون باتو راز سپهر"
  },
  {
    "poem_id": 1600,
    "vorder": 101,
    "position": 0,
    "text": "که هرکس که او خون اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 102,
    "position": 1,
    "text": "بریزد ورا بشکرد روزگار"
  },
  {
    "poem_id": 1600,
    "vorder": 103,
    "position": 0,
    "text": "همان نیز تا زنده باشد ز رنج"
  },
  {
    "poem_id": 1600,
    "vorder": 104,
    "position": 1,
    "text": "رهایی نیابد نماندش گنج"
  },
  {
    "poem_id": 1600,
    "vorder": 105,
    "position": 0,
    "text": "بدین گیتیش شوربختی بود"
  },
  {
    "poem_id": 1600,
    "vorder": 106,
    "position": 1,
    "text": "وگر بگذرد رنج و سختی بود"
  },
  {
    "poem_id": 1600,
    "vorder": 107,
    "position": 0,
    "text": "شگفتی نمایم هم امشب ترا"
  },
  {
    "poem_id": 1600,
    "vorder": 108,
    "position": 1,
    "text": "ببندم ز گفتار بد لب ترا"
  },
  {
    "poem_id": 1600,
    "vorder": 109,
    "position": 0,
    "text": "برو رخش رخشنده را برنشین"
  },
  {
    "poem_id": 1600,
    "vorder": 110,
    "position": 1,
    "text": "یکی خنجر آبگون برگزین"
  },
  {
    "poem_id": 1600,
    "vorder": 111,
    "position": 0,
    "text": "چو بشنید رستم میان را ببست"
  },
  {
    "poem_id": 1600,
    "vorder": 112,
    "position": 1,
    "text": "وزان جایگه رخش را برنشست"
  },
  {
    "poem_id": 1600,
    "vorder": 113,
    "position": 0,
    "text": "به سیمرغ گفت ای گزین جهان"
  },
  {
    "poem_id": 1600,
    "vorder": 114,
    "position": 1,
    "text": "چه خواهد برین مرگ ما ناگهان"
  },
  {
    "poem_id": 1600,
    "vorder": 115,
    "position": 0,
    "text": "جهان یادگارست و ما رفتنی"
  },
  {
    "poem_id": 1600,
    "vorder": 116,
    "position": 1,
    "text": "به گیتی نماند به جز مردمی"
  },
  {
    "poem_id": 1600,
    "vorder": 117,
    "position": 0,
    "text": "به نام نکو گر بمیرم رواست"
  },
  {
    "poem_id": 1600,
    "vorder": 118,
    "position": 1,
    "text": "مرا نام باید که تن مرگ راست"
  },
  {
    "poem_id": 1600,
    "vorder": 119,
    "position": 0,
    "text": "کجا شد فریدون و هوشنگ شاه"
  },
  {
    "poem_id": 1600,
    "vorder": 120,
    "position": 1,
    "text": "که بودند با گنج و تخت و کلاه"
  },
  {
    "poem_id": 1600,
    "vorder": 121,
    "position": 0,
    "text": "برفتند و ما را سپردند جای"
  },
  {
    "poem_id": 1600,
    "vorder": 122,
    "position": 1,
    "text": "جهان را چنین است آیین و رای"
  },
  {
    "poem_id": 1600,
    "vorder": 123,
    "position": 0,
    "text": "همی راند تا پیش دریا رسید"
  },
  {
    "poem_id": 1600,
    "vorder": 124,
    "position": 1,
    "text": "ز سیمرغ روی هوا تیره دید"
  },
  {
    "poem_id": 1600,
    "vorder": 125,
    "position": 0,
    "text": "چو آمد به نزدیک دریا فراز"
  },
  {
    "poem_id": 1600,
    "vorder": 126,
    "position": 1,
    "text": "فرود آمد آن مرغ گردنفراز"
  },
  {
    "poem_id": 1600,
    "vorder": 127,
    "position": 0,
    "text": "به رستم نمود آن زمان راه خشک"
  },
  {
    "poem_id": 1600,
    "vorder": 128,
    "position": 1,
    "text": "همی آمد از باد او بوی مشک"
  },
  {
    "poem_id": 1600,
    "vorder": 129,
    "position": 0,
    "text": "بمالید بر تارکش پر خویش"
  },
  {
    "poem_id": 1600,
    "vorder": 130,
    "position": 1,
    "text": "بفرمود تا رستم آمدش پیش"
  },
  {
    "poem_id": 1600,
    "vorder": 131,
    "position": 0,
    "text": "گزی دید بر خاک سر بر هوا"
  },
  {
    "poem_id": 1600,
    "vorder": 132,
    "position": 1,
    "text": "نشست از برش مرغ فرمانروا"
  },
  {
    "poem_id": 1600,
    "vorder": 133,
    "position": 0,
    "text": "بدو گفت شاخی گزین راست‌تر"
  },
  {
    "poem_id": 1600,
    "vorder": 134,
    "position": 1,
    "text": "سرش برترین و تنش کاست‌تر"
  },
  {
    "poem_id": 1600,
    "vorder": 135,
    "position": 0,
    "text": "بدان گز بود هوش اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 136,
    "position": 1,
    "text": "تو این چوب را خوار مایه مدار"
  },
  {
    "poem_id": 1600,
    "vorder": 137,
    "position": 0,
    "text": "بر آتش مرین چوب را راست کن"
  },
  {
    "poem_id": 1600,
    "vorder": 138,
    "position": 1,
    "text": "نگه کن یکی نغز پیکان کهن"
  },
  {
    "poem_id": 1600,
    "vorder": 139,
    "position": 0,
    "text": "بنه پر و پیکان و برو بر نشان"
  },
  {
    "poem_id": 1600,
    "vorder": 140,
    "position": 1,
    "text": "نمودم ترا از گزندش نشان"
  },
  {
    "poem_id": 1600,
    "vorder": 141,
    "position": 0,
    "text": "چو ببرید رستم تن شاخ گز"
  },
  {
    "poem_id": 1600,
    "vorder": 142,
    "position": 1,
    "text": "بیامد ز دریا به ایوان و رز"
  },
  {
    "poem_id": 1600,
    "vorder": 143,
    "position": 0,
    "text": "بران کار سیمرغ بد رهنمای"
  },
  {
    "poem_id": 1600,
    "vorder": 144,
    "position": 1,
    "text": "همی بود بر تارک او به پای"
  },
  {
    "poem_id": 1600,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت اکنون چو اسفندیار"
  },
  {
    "poem_id": 1600,
    "vorder": 146,
    "position": 1,
    "text": "بیاید بجوید ز تو کارزار"
  },
  {
    "poem_id": 1600,
    "vorder": 147,
    "position": 0,
    "text": "تو خواهش کن و لابه و راستی"
  },
  {
    "poem_id": 1600,
    "vorder": 148,
    "position": 1,
    "text": "مکوب ایچ گونه در کاستی"
  },
  {
    "poem_id": 1600,
    "vorder": 149,
    "position": 0,
    "text": "مگر بازگردد به شیرین سخن"
  },
  {
    "poem_id": 1600,
    "vorder": 150,
    "position": 1,
    "text": "بیاد آیدش روزگار کهن"
  },
  {
    "poem_id": 1600,
    "vorder": 151,
    "position": 0,
    "text": "که تو چند گه بودی اندر جهان"
  },
  {
    "poem_id": 1600,
    "vorder": 152,
    "position": 1,
    "text": "به رنج و به سختی ز بهر مهان"
  },
  {
    "poem_id": 1600,
    "vorder": 153,
    "position": 0,
    "text": "چو پوزش کنی چند نپذیردت"
  },
  {
    "poem_id": 1600,
    "vorder": 154,
    "position": 1,
    "text": "همی از فرومایگان گیردت"
  },
  {
    "poem_id": 1600,
    "vorder": 155,
    "position": 0,
    "text": "به زه کن کمان را و این چوب گز"
  },
  {
    "poem_id": 1600,
    "vorder": 156,
    "position": 1,
    "text": "بدین گونه پرورده در آب رز"
  },
  {
    "poem_id": 1600,
    "vorder": 157,
    "position": 0,
    "text": "ابر چشم او راست کن هر دو دست"
