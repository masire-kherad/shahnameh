[
  {
    "poem_id": 1872,
    "vorder": 1,
    "position": 0,
    "text": "بخراد برزین بفرمود شاه"
  },
  {
    "poem_id": 1872,
    "vorder": 2,
    "position": 1,
    "text": "که رو عرض گه ساز ودیوان بخواه"
  },
  {
    "poem_id": 1872,
    "vorder": 3,
    "position": 0,
    "text": "همه لشکر رومیان عرض کن"
  },
  {
    "poem_id": 1872,
    "vorder": 4,
    "position": 1,
    "text": "هر آنکس که هستند نوگر کهن"
  },
  {
    "poem_id": 1872,
    "vorder": 5,
    "position": 0,
    "text": "درمشان بده رومیان را زگنج"
  },
  {
    "poem_id": 1872,
    "vorder": 6,
    "position": 1,
    "text": "بدادن نباید که بینند رنج"
  },
  {
    "poem_id": 1872,
    "vorder": 7,
    "position": 0,
    "text": "کسی کو به خلعت سزاوار بود"
  },
  {
    "poem_id": 1872,
    "vorder": 8,
    "position": 1,
    "text": "کجا روز جنگ از در کار بود"
  },
  {
    "poem_id": 1872,
    "vorder": 9,
    "position": 0,
    "text": "بفرمود تا خلعت آراستند"
  },
  {
    "poem_id": 1872,
    "vorder": 10,
    "position": 1,
    "text": "ز در اسپ پرمایگان خواستند"
  },
  {
    "poem_id": 1872,
    "vorder": 11,
    "position": 0,
    "text": "نیاطوس را داد چندان گهر"
  },
  {
    "poem_id": 1872,
    "vorder": 12,
    "position": 1,
    "text": "چه اسپ و پرستار و زرین کمر"
  },
  {
    "poem_id": 1872,
    "vorder": 13,
    "position": 0,
    "text": "کز اندازه هدیه برتر گذاشت"
  },
  {
    "poem_id": 1872,
    "vorder": 14,
    "position": 1,
    "text": "سرش را ز پر مایگان برفراشت"
  },
  {
    "poem_id": 1872,
    "vorder": 15,
    "position": 0,
    "text": "هر آن شهرکز روم بستد قباد"
  },
  {
    "poem_id": 1872,
    "vorder": 16,
    "position": 1,
    "text": "چه هرمز چه کسری فرخ نژاد"
  },
  {
    "poem_id": 1872,
    "vorder": 17,
    "position": 0,
    "text": "نیاطوس را داد و بنوشت عهد"
  },
  {
    "poem_id": 1872,
    "vorder": 18,
    "position": 1,
    "text": "بران جام حنظل پراگند شهد"
  },
  {
    "poem_id": 1872,
    "vorder": 19,
    "position": 0,
    "text": "برفتند پس رومیان سوی روم"
  },
  {
    "poem_id": 1872,
    "vorder": 20,
    "position": 1,
    "text": "بدان مرز آباد و آباد بوم"
  },
  {
    "poem_id": 1872,
    "vorder": 21,
    "position": 0,
    "text": "دگر هفته برداشت با ده سوار"
  },
  {
    "poem_id": 1872,
    "vorder": 22,
    "position": 1,
    "text": "که بودند بینا دل و نامدار"
  },
  {
    "poem_id": 1872,
    "vorder": 23,
    "position": 0,
    "text": "ز لشکر گه آمد به آذرگشسپ"
  },
  {
    "poem_id": 1872,
    "vorder": 24,
    "position": 1,
    "text": "به گنبد نگه کرد و بگذاشت اسپ"
  },
  {
    "poem_id": 1872,
    "vorder": 25,
    "position": 0,
    "text": "پیاده همی‌رفت و دیده پر آب"
  },
  {
    "poem_id": 1872,
    "vorder": 26,
    "position": 1,
    "text": "به زردی دو رخساره چون آفتاب"
  },
  {
    "poem_id": 1872,
    "vorder": 27,
    "position": 0,
    "text": "چو از دربه نزدیک آتش رسید"
  },
  {
    "poem_id": 1872,
    "vorder": 28,
    "position": 1,
    "text": "شد از آب دیده رخش ناپدید"
  },
  {
    "poem_id": 1872,
    "vorder": 29,
    "position": 0,
    "text": "دو هفته همی‌خواند استا وزند"
  },
  {
    "poem_id": 1872,
    "vorder": 30,
    "position": 1,
    "text": "همی‌گشت بر گرد آذر نژند"
  },
  {
    "poem_id": 1872,
    "vorder": 31,
    "position": 0,
    "text": "بهشتم بیامد ز آتشکده"
  },
  {
    "poem_id": 1872,
    "vorder": 32,
    "position": 1,
    "text": "چو نزدیک شد روزگار سده"
  },
  {
    "poem_id": 1872,
    "vorder": 33,
    "position": 0,
    "text": "به آتش بداد آنچ پذیرفته بود"
  },
  {
    "poem_id": 1872,
    "vorder": 34,
    "position": 1,
    "text": "سخن هرچ پیش ردان گفته بود"
  },
  {
    "poem_id": 1872,
    "vorder": 35,
    "position": 0,
    "text": "ز زرین و سیمین گوهرنگار"
  },
  {
    "poem_id": 1872,
    "vorder": 36,
    "position": 1,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1872,
    "vorder": 37,
    "position": 0,
    "text": "به درویش بخشید گنج درم"
  },
  {
    "poem_id": 1872,
    "vorder": 38,
    "position": 1,
    "text": "نماند اندران بوم و برکس دژم"
  },
  {
    "poem_id": 1872,
    "vorder": 39,
    "position": 0,
    "text": "وزان جایگه شد باندیو شهر"
  },
  {
    "poem_id": 1872,
    "vorder": 40,
    "position": 1,
    "text": "که بردارد از روز شادیش بهر"
  },
  {
    "poem_id": 1872,
    "vorder": 41,
    "position": 0,
    "text": "کجا کشور شورستان بود مرز"
  },
  {
    "poem_id": 1872,
    "vorder": 42,
    "position": 1,
    "text": "کسی خاک او راندانست ارز"
  },
  {
    "poem_id": 1872,
    "vorder": 43,
    "position": 0,
    "text": "به ایوان که نوشین روان کرده بود"
  },
  {
    "poem_id": 1872,
    "vorder": 44,
    "position": 1,
    "text": "بسی روزگار اندر آن برده بود"
  },
  {
    "poem_id": 1872,
    "vorder": 45,
    "position": 0,
    "text": "گرانمایه کاخی بیاراستند"
  },
  {
    "poem_id": 1872,
    "vorder": 46,
    "position": 1,
    "text": "همان تخت زرین به پیراستند"
  },
  {
    "poem_id": 1872,
    "vorder": 47,
    "position": 0,
    "text": "بیامد به تخت پدر برنشست"
  },
  {
    "poem_id": 1872,
    "vorder": 48,
    "position": 1,
    "text": "جهاندار پیروز یزدان پرست"
  },
  {
    "poem_id": 1872,
    "vorder": 49,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1872,
    "vorder": 50,
    "position": 1,
    "text": "همان راهبر موبد تیزویر"
  },
  {
    "poem_id": 1872,
    "vorder": 51,
    "position": 0,
    "text": "نوشتند منشور ایرانیان"
  },
  {
    "poem_id": 1872,
    "vorder": 52,
    "position": 1,
    "text": "برسم بزرگان و فرخ مهان"
  },
  {
    "poem_id": 1872,
    "vorder": 53,
    "position": 0,
    "text": "بدان کار بندوی بد کدخدای"
  },
  {
    "poem_id": 1872,
    "vorder": 54,
    "position": 1,
    "text": "جهاندیده و راد و فرخنده‌رای"
  },
  {
    "poem_id": 1872,
    "vorder": 55,
    "position": 0,
    "text": "خراسان سراسر به گستهم داد"
  },
  {
    "poem_id": 1872,
    "vorder": 56,
    "position": 1,
    "text": "بفرمود تا نو کند رسم وداد"
  },
  {
    "poem_id": 1872,
    "vorder": 57,
    "position": 0,
    "text": "بهرکار دستور بد برزمهر"
  },
  {
    "poem_id": 1872,
    "vorder": 58,
    "position": 1,
    "text": "دبیری جهاندیده و خوب چهر"
  },
  {
    "poem_id": 1872,
    "vorder": 59,
    "position": 0,
    "text": "چو بر کام او گشت گردنده چرخ"
  },
  {
    "poem_id": 1872,
    "vorder": 60,
    "position": 1,
    "text": "ببخشید داراب گرد و صطرخ"
  },
  {
    "poem_id": 1872,
    "vorder": 61,
    "position": 0,
    "text": "به منشور برمهر زرین نهاد"
  },
  {
    "poem_id": 1872,
    "vorder": 62,
    "position": 1,
    "text": "یکی درکف رام برزین نهاد"
  },
  {
    "poem_id": 1872,
    "vorder": 63,
    "position": 0,
    "text": "بفرمود تا نزد شاپور برد"
  },
  {
    "poem_id": 1872,
    "vorder": 64,
    "position": 1,
    "text": "پرستنده و خلعت او را سپرد"
  },
  {
    "poem_id": 1872,
    "vorder": 65,
    "position": 0,
    "text": "دگر مهر خسرو سوی اندیان"
  },
  {
    "poem_id": 1872,
    "vorder": 66,
    "position": 1,
    "text": "بفرمود بردن برسم کیان"
  },
  {
    "poem_id": 1872,
    "vorder": 67,
    "position": 0,
    "text": "دگر کشوری را بگردوی داد"
  },
  {
    "poem_id": 1872,
    "vorder": 68,
    "position": 1,
    "text": "بران نامه بر مهر زرین نهاد"
  },
  {
    "poem_id": 1872,
    "vorder": 69,
    "position": 0,
    "text": "ببالوی داد آن زمان شهر چاچ"
  },
  {
    "poem_id": 1872,
    "vorder": 70,
    "position": 1,
    "text": "فرستاد منشور با تخت عاج"
  },
  {
    "poem_id": 1872,
    "vorder": 71,
    "position": 0,
    "text": "کلید در گنجها بر شمرد"
  },
  {
    "poem_id": 1872,
    "vorder": 72,
    "position": 1,
    "text": "سراسر بپور تخواره سپرد"
  },
  {
    "poem_id": 1872,
    "vorder": 73,
    "position": 0,
    "text": "بفرمود تا هر که مهتر بدند"
  },
  {
    "poem_id": 1872,
    "vorder": 74,
    "position": 1,
    "text": "به فرمان خراد برزین شدند"
  },
  {
    "poem_id": 1872,
    "vorder": 75,
    "position": 0,
    "text": "به گیتی رونده بود کام او"
  },
  {
    "poem_id": 1872,
    "vorder": 76,
    "position": 1,
    "text": "به منشورها بر بود نام او"
  },
  {
    "poem_id": 1872,
    "vorder": 77,
    "position": 0,
    "text": "ز لشکر هر آنکس که هنگام کار"
  },
  {
    "poem_id": 1872,
    "vorder": 78,
    "position": 1,
    "text": "بماندند با نامور شهریار"
  },
  {
    "poem_id": 1872,
    "vorder": 79,
    "position": 0,
    "text": "همی خلعت خسروی دادشان"
  },
  {
    "poem_id": 1872,
    "vorder": 80,
    "position": 1,
    "text": "به شاهی به مرزی فرستادشان"
  },
  {
    "poem_id": 1872,
    "vorder": 81,
    "position": 0,
    "text": "همی‌گشت گویا منادیگری"
  },
  {
    "poem_id": 1872,
    "vorder": 82,
    "position": 1,
    "text": "خوش آواز و بیدار دل مهتری"
  },
  {
    "poem_id": 1872,
    "vorder": 83,
    "position": 0,
    "text": "که ای زیردستان شاه جهان"
  },
  {
    "poem_id": 1872,
    "vorder": 84,
    "position": 1,
    "text": "مخوانید جز آفرین در نهان"
  },
  {
    "poem_id": 1872,
    "vorder": 85,
    "position": 0,
    "text": "مجویید کین و مریزید خون"
  },
  {
    "poem_id": 1872,
    "vorder": 86,
    "position": 1,
    "text": "مباشید بر کار بد رهنمون"
  },
  {
    "poem_id": 1872,
    "vorder": 87,
    "position": 0,
    "text": "گر از زیردستان بنالد کسی"
  },
  {
    "poem_id": 1872,
    "vorder": 88,
    "position": 1,
    "text": "گر از لشکری رنج یابد بسی"
  },
  {
    "poem_id": 1872,
    "vorder": 89,
    "position": 0,
    "text": "نیابد ستمگاره جز دار جای"
  },
  {
    "poem_id": 1872,
    "vorder": 90,
    "position": 1,
    "text": "همان رنج و آتش بدیگر سرای"
  },
  {
    "poem_id": 1872,
    "vorder": 91,
    "position": 0,
    "text": "همه پادشاهند برگنج خویش"
  },
  {
    "poem_id": 1872,
    "vorder": 92,
    "position": 1,
    "text": "کسی راکه گرد آمد از رنج خویش"
  },
  {
    "poem_id": 1872,
    "vorder": 93,
    "position": 0,
    "text": "خورید و دهید آنک دارید چیز"
  },
  {
    "poem_id": 1872,
    "vorder": 94,
    "position": 1,
    "text": "همان کز شماهست درویش نیز"
  },
  {
    "poem_id": 1872,
    "vorder": 95,
    "position": 0,
    "text": "چو باید خورش بامداد پگاه"
  },
  {
    "poem_id": 1872,
    "vorder": 96,
    "position": 1,
    "text": "سه من می بیابد ز گنجور شاه"
  },
  {
    "poem_id": 1872,
    "vorder": 97,
    "position": 0,
    "text": "به پیمان که خواند بران آفرین"
  },
  {
    "poem_id": 1872,
    "vorder": 98,
    "position": 1,
    "text": "که کوشد که آباد دارد زمین"
  },
  {
    "poem_id": 1872,
    "vorder": 99,
    "position": 0,
    "text": "گر ایدون که زین سان بود پادشا"
  },
  {
    "poem_id": 1872,
    "vorder": 100,
    "position": 1,
    "text": "به از دانشومند ناپارسا"
  }
]