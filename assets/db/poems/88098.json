[
  {
    "poem_id": 88098,
    "vorder": 1,
    "position": 0,
    "text": "به ایرانیان گفت هنگام من"
  },
  {
    "poem_id": 88098,
    "vorder": 2,
    "position": 1,
    "text": "فراز آمد و تازه شد کام من"
  },
  {
    "poem_id": 88098,
    "vorder": 3,
    "position": 0,
    "text": "بخواهید چیزی که باید ز من"
  },
  {
    "poem_id": 88098,
    "vorder": 4,
    "position": 1,
    "text": "که آمد پراگندن انجمن"
  },
  {
    "poem_id": 88098,
    "vorder": 5,
    "position": 0,
    "text": "همه مهتران زار و گریان شدند"
  },
  {
    "poem_id": 88098,
    "vorder": 6,
    "position": 1,
    "text": "ز درد شهنشاه بریان شدند"
  },
  {
    "poem_id": 88098,
    "vorder": 7,
    "position": 0,
    "text": "همی گفت هرکس که ای شهریار"
  },
  {
    "poem_id": 88098,
    "vorder": 8,
    "position": 1,
    "text": "که را مانی این تاج را یادگار"
  },
  {
    "poem_id": 88098,
    "vorder": 9,
    "position": 0,
    "text": "چو بشنید دستان خسرو پرست"
  },
  {
    "poem_id": 88098,
    "vorder": 10,
    "position": 1,
    "text": "زمین را ببوسید و برپای جست"
  },
  {
    "poem_id": 88098,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت کای شهریار جهان"
  },
  {
    "poem_id": 88098,
    "vorder": 12,
    "position": 1,
    "text": "سزد کآرزوها ندارم نهان"
  },
  {
    "poem_id": 88098,
    "vorder": 13,
    "position": 0,
    "text": "تو دانی که رستم به ایران چه کرد"
  },
  {
    "poem_id": 88098,
    "vorder": 14,
    "position": 1,
    "text": "به رزم و به بزم و به ننگ و نبرد"
  },
  {
    "poem_id": 88098,
    "vorder": 15,
    "position": 0,
    "text": "چو کاووس کی شد به مازندران"
  },
  {
    "poem_id": 88098,
    "vorder": 16,
    "position": 1,
    "text": "رهی دور و فرسنگهای گران"
  },
  {
    "poem_id": 88098,
    "vorder": 17,
    "position": 0,
    "text": "چو دیوان ببستند کاووس را"
  },
  {
    "poem_id": 88098,
    "vorder": 18,
    "position": 1,
    "text": "چو گودرز گردنکش و طوس را"
  },
  {
    "poem_id": 88098,
    "vorder": 19,
    "position": 0,
    "text": "تهمتن چو بشنید تنها برفت"
  },
  {
    "poem_id": 88098,
    "vorder": 20,
    "position": 1,
    "text": "به مازندران روی بنهاد تفت"
  },
  {
    "poem_id": 88098,
    "vorder": 21,
    "position": 0,
    "text": "بیابان و تاریکی و دیو و شیر"
  },
  {
    "poem_id": 88098,
    "vorder": 22,
    "position": 1,
    "text": "همان جادوی و اژدهای دلیر"
  },
  {
    "poem_id": 88098,
    "vorder": 23,
    "position": 0,
    "text": "بدان رنج و تیمار ببرید راه"
  },
  {
    "poem_id": 88098,
    "vorder": 24,
    "position": 1,
    "text": "به مازندران شد به نزدیک شاه"
  },
  {
    "poem_id": 88098,
    "vorder": 25,
    "position": 0,
    "text": "بدرید پهلوی دیو سپید"
  },
  {
    "poem_id": 88098,
    "vorder": 26,
    "position": 1,
    "text": "جگرگاه پولاد غندی و بید"
  },
  {
    "poem_id": 88098,
    "vorder": 27,
    "position": 0,
    "text": "سر سنجه را ناگه از تن بکند"
  },
  {
    "poem_id": 88098,
    "vorder": 28,
    "position": 1,
    "text": "خروشش برآمد به ابر بلند"
  },
  {
    "poem_id": 88098,
    "vorder": 29,
    "position": 0,
    "text": "چو سهراب فرزند کاندر جهان"
  },
  {
    "poem_id": 88098,
    "vorder": 30,
    "position": 1,
    "text": "کسی را نبود از کهان و مهان"
  },
  {
    "poem_id": 88098,
    "vorder": 31,
    "position": 0,
    "text": "بکشت از پی کین کاووس شاه"
  },
  {
    "poem_id": 88098,
    "vorder": 32,
    "position": 1,
    "text": "ز دردش بگرید همی سال و ماه"
  },
  {
    "poem_id": 88098,
    "vorder": 33,
    "position": 0,
    "text": "وز آن پس کجا رزم کاموس کرد"
  },
  {
    "poem_id": 88098,
    "vorder": 34,
    "position": 1,
    "text": "به مردی به ابر اندر آورد گرد"
  },
  {
    "poem_id": 88098,
    "vorder": 35,
    "position": 0,
    "text": "ز کردار او چند رانم سخن"
  },
  {
    "poem_id": 88098,
    "vorder": 36,
    "position": 1,
    "text": "که هم داستانها نیاید به بن"
  },
  {
    "poem_id": 88098,
    "vorder": 37,
    "position": 0,
    "text": "اگر شاه سیر آمد از تاج و گاه"
  },
  {
    "poem_id": 88098,
    "vorder": 38,
    "position": 1,
    "text": "چه ماند بدین شیردل نیک‌خواه"
  },
  {
    "poem_id": 88098,
    "vorder": 39,
    "position": 0,
    "text": "چنین داد پاسخ که کردار اوی"
  },
  {
    "poem_id": 88098,
    "vorder": 40,
    "position": 1,
    "text": "به نزدیک ما رنج و تیمار اوی"
  },
  {
    "poem_id": 88098,
    "vorder": 41,
    "position": 0,
    "text": "که داند مگر کردگار سپهر"
  },
  {
    "poem_id": 88098,
    "vorder": 42,
    "position": 1,
    "text": "نمایندهٔ کام و آرام و مهر"
  },
  {
    "poem_id": 88098,
    "vorder": 43,
    "position": 0,
    "text": "سخنهای او نیست اندر نهفت"
  },
  {
    "poem_id": 88098,
    "vorder": 44,
    "position": 1,
    "text": "نداند کس او را به آفاق جفت"
  }
]