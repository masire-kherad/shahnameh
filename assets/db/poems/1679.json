[
  {
    "poem_id": 1679,
    "vorder": 1,
    "position": 0,
    "text": "بدان جایگه شاه ماهی بماند"
  },
  {
    "poem_id": 1679,
    "vorder": 2,
    "position": 1,
    "text": "پس‌انگه بجنبید و لشکر براند"
  },
  {
    "poem_id": 1679,
    "vorder": 3,
    "position": 0,
    "text": "ازان سبز دریا چو گشتند باز"
  },
  {
    "poem_id": 1679,
    "vorder": 4,
    "position": 1,
    "text": "بیابان گرفتند و راه دراز"
  },
  {
    "poem_id": 1679,
    "vorder": 5,
    "position": 0,
    "text": "چو منزل به منزل به حلوان رسید"
  },
  {
    "poem_id": 1679,
    "vorder": 6,
    "position": 1,
    "text": "یکی مایه‌ور باره و شهر دید"
  },
  {
    "poem_id": 1679,
    "vorder": 7,
    "position": 0,
    "text": "به پیش آمدندش بزرگان شهر"
  },
  {
    "poem_id": 1679,
    "vorder": 8,
    "position": 1,
    "text": "کسی کش ز نام و خرد بود بهر"
  },
  {
    "poem_id": 1679,
    "vorder": 9,
    "position": 0,
    "text": "برفتند با هدیه و با نثار"
  },
  {
    "poem_id": 1679,
    "vorder": 10,
    "position": 1,
    "text": "ز حلوان سران تا در شهریار"
  },
  {
    "poem_id": 1679,
    "vorder": 11,
    "position": 0,
    "text": "سکندر سبک پرسش اندر گرفت"
  },
  {
    "poem_id": 1679,
    "vorder": 12,
    "position": 1,
    "text": "که ایدر چه بینید چیزی شگفت"
  },
  {
    "poem_id": 1679,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت گوینده کای شهریار"
  },
  {
    "poem_id": 1679,
    "vorder": 14,
    "position": 1,
    "text": "ندانیم چیزی که آید به کار"
  },
  {
    "poem_id": 1679,
    "vorder": 15,
    "position": 0,
    "text": "برین مرز درویشی و رنج هست"
  },
  {
    "poem_id": 1679,
    "vorder": 16,
    "position": 1,
    "text": "کزین بگذری باد ماند به دست"
  },
  {
    "poem_id": 1679,
    "vorder": 17,
    "position": 0,
    "text": "چو گفتار گوینده بشنید شاه"
  },
  {
    "poem_id": 1679,
    "vorder": 18,
    "position": 1,
    "text": "ز حلوان سوی سند شد با سپاه"
  },
  {
    "poem_id": 1679,
    "vorder": 19,
    "position": 0,
    "text": "پذیره شدندش سواران سند"
  },
  {
    "poem_id": 1679,
    "vorder": 20,
    "position": 1,
    "text": "همان جنگ را یاور آمد ز هند"
  },
  {
    "poem_id": 1679,
    "vorder": 21,
    "position": 0,
    "text": "هرانکس که از فور دل خسته بود"
  },
  {
    "poem_id": 1679,
    "vorder": 22,
    "position": 1,
    "text": "به خون ریختن دستها شسته بود"
  },
  {
    "poem_id": 1679,
    "vorder": 23,
    "position": 0,
    "text": "بردند پیلان و هندی درای"
  },
  {
    "poem_id": 1679,
    "vorder": 24,
    "position": 1,
    "text": "خروش آمد و نالهٔ کرنای"
  },
  {
    "poem_id": 1679,
    "vorder": 25,
    "position": 0,
    "text": "سر سندیان بود بنداه نام"
  },
  {
    "poem_id": 1679,
    "vorder": 26,
    "position": 1,
    "text": "سواری سرافراز با رای و کام"
  },
  {
    "poem_id": 1679,
    "vorder": 27,
    "position": 0,
    "text": "یکی رزمشان کرده شد همگروه"
  },
  {
    "poem_id": 1679,
    "vorder": 28,
    "position": 1,
    "text": "زمین شد ز افگنده بر سان کوه"
  },
  {
    "poem_id": 1679,
    "vorder": 29,
    "position": 0,
    "text": "شب آمد بران دشت سندی نماند"
  },
  {
    "poem_id": 1679,
    "vorder": 30,
    "position": 1,
    "text": "سکندر سپاه از پس‌اندر براند"
  },
  {
    "poem_id": 1679,
    "vorder": 31,
    "position": 0,
    "text": "به دست آمدش پیل هشتاد و پنج"
  },
  {
    "poem_id": 1679,
    "vorder": 32,
    "position": 1,
    "text": "همان تاج زرین و شمشیر و گنج"
  },
  {
    "poem_id": 1679,
    "vorder": 33,
    "position": 0,
    "text": "زن و کودک و پیر مردان به راه"
  },
  {
    "poem_id": 1679,
    "vorder": 34,
    "position": 1,
    "text": "برفتند گریان به نزدیک شاه"
  },
  {
    "poem_id": 1679,
    "vorder": 35,
    "position": 0,
    "text": "که ای شاه بیدار با رای و هوش"
  },
  {
    "poem_id": 1679,
    "vorder": 36,
    "position": 1,
    "text": "مشور این بر و بوم و بر بد مکوش"
  },
  {
    "poem_id": 1679,
    "vorder": 37,
    "position": 0,
    "text": "که فرجام هم روز تو بگذرد"
  },
  {
    "poem_id": 1679,
    "vorder": 38,
    "position": 1,
    "text": "خنک آنک گیتی به بد نسپرد"
  },
  {
    "poem_id": 1679,
    "vorder": 39,
    "position": 0,
    "text": "سکندر بریشان نیاورد مهر"
  },
  {
    "poem_id": 1679,
    "vorder": 40,
    "position": 1,
    "text": "بران خستگان هیچ ننمود چهر"
  },
  {
    "poem_id": 1679,
    "vorder": 41,
    "position": 0,
    "text": "گرفتند زیشان فراوان اسیر"
  },
  {
    "poem_id": 1679,
    "vorder": 42,
    "position": 1,
    "text": "زن و کودک خرد و برنا و پیر"
  },
  {
    "poem_id": 1679,
    "vorder": 43,
    "position": 0,
    "text": "سوی نیمروز آمد از راه بست"
  },
  {
    "poem_id": 1679,
    "vorder": 44,
    "position": 1,
    "text": "همه روی گیتی ز دشمن بشست"
  },
  {
    "poem_id": 1679,
    "vorder": 45,
    "position": 0,
    "text": "وزان جایگه شد به سوی یمن"
  },
  {
    "poem_id": 1679,
    "vorder": 46,
    "position": 1,
    "text": "جهاندار و با نامدار انجمن"
  },
  {
    "poem_id": 1679,
    "vorder": 47,
    "position": 0,
    "text": "چو بشنید شاه یمن با مهان"
  },
  {
    "poem_id": 1679,
    "vorder": 48,
    "position": 1,
    "text": "بیامد بر شهریار جهان"
  },
  {
    "poem_id": 1679,
    "vorder": 49,
    "position": 0,
    "text": "بسی هدیه‌ها کز یمن برگزید"
  },
  {
    "poem_id": 1679,
    "vorder": 50,
    "position": 1,
    "text": "بهاگیر و زیبا چنانچون سزید"
  },
  {
    "poem_id": 1679,
    "vorder": 51,
    "position": 0,
    "text": "ده اشتر ز برد یمن بار کرد"
  },
  {
    "poem_id": 1679,
    "vorder": 52,
    "position": 1,
    "text": "دگر پنج را بار دینار کرد"
  },
  {
    "poem_id": 1679,
    "vorder": 53,
    "position": 0,
    "text": "دگر ده شتر بار کرد از درم"
  },
  {
    "poem_id": 1679,
    "vorder": 54,
    "position": 1,
    "text": "چو باشد درم دل نباشد به غم"
  },
  {
    "poem_id": 1679,
    "vorder": 55,
    "position": 0,
    "text": "دگر سلهٔ زعفران بد هزار"
  },
  {
    "poem_id": 1679,
    "vorder": 56,
    "position": 1,
    "text": "ز دیبا و هرجامهٔ بی‌شمار"
  },
  {
    "poem_id": 1679,
    "vorder": 57,
    "position": 0,
    "text": "زبرجد یکی جام بودش به گنج"
  },
  {
    "poem_id": 1679,
    "vorder": 58,
    "position": 1,
    "text": "همان در ناسفته هفتاد و پنج"
  },
  {
    "poem_id": 1679,
    "vorder": 59,
    "position": 0,
    "text": "یکی جام دیگر بدش لاژورد"
  },
  {
    "poem_id": 1679,
    "vorder": 60,
    "position": 1,
    "text": "نهاد اندرو شست یاقوت زرد"
  },
  {
    "poem_id": 1679,
    "vorder": 61,
    "position": 0,
    "text": "ز یاقوت سرخ از برش ده نگین"
  },
  {
    "poem_id": 1679,
    "vorder": 62,
    "position": 1,
    "text": "به فرمانبران داد و کرد آفرین"
  },
  {
    "poem_id": 1679,
    "vorder": 63,
    "position": 0,
    "text": "به پیش سراپردهٔ شهریار"
  },
  {
    "poem_id": 1679,
    "vorder": 64,
    "position": 1,
    "text": "رسیدند با هدیه و با نثار"
  },
  {
    "poem_id": 1679,
    "vorder": 65,
    "position": 0,
    "text": "سکندر بپرسید و بنواختشان"
  },
  {
    "poem_id": 1679,
    "vorder": 66,
    "position": 1,
    "text": "بر تخت نزدیک بنشاختشان"
  },
  {
    "poem_id": 1679,
    "vorder": 67,
    "position": 0,
    "text": "برو آفرین کرد شاه یمن"
  },
  {
    "poem_id": 1679,
    "vorder": 68,
    "position": 1,
    "text": "که پیروزگر باش بر انجمن"
  },
  {
    "poem_id": 1679,
    "vorder": 69,
    "position": 0,
    "text": "به تو شادم ار باشی ایدر دو ماه"
  },
  {
    "poem_id": 1679,
    "vorder": 70,
    "position": 1,
    "text": "برآساید از راه شاه و سپاه"
  },
  {
    "poem_id": 1679,
    "vorder": 71,
    "position": 0,
    "text": "سکندر برو آفرین کرد و گفت"
  },
  {
    "poem_id": 1679,
    "vorder": 72,
    "position": 1,
    "text": "که با تو همیشه خرد باد جفت"
  },
  {
    "poem_id": 1679,
    "vorder": 73,
    "position": 0,
    "text": "به شبگیر شاه یمن بازگشت"
  },
  {
    "poem_id": 1679,
    "vorder": 74,
    "position": 1,
    "text": "ز لشکر جهانی پر آواز گشت"
  }
]