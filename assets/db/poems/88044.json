[
  {
    "poem_id": 88044,
    "vorder": 1,
    "position": 0,
    "text": "و دیگر گروی زره دیو نیو"
  },
  {
    "poem_id": 88044,
    "vorder": 2,
    "position": 1,
    "text": "برون رفت با پور گودرز گیو"
  },
  {
    "poem_id": 88044,
    "vorder": 3,
    "position": 0,
    "text": "به نیزه فراوان برآویختند"
  },
  {
    "poem_id": 88044,
    "vorder": 4,
    "position": 1,
    "text": "همی زهر با خون برآمیختند"
  },
  {
    "poem_id": 88044,
    "vorder": 5,
    "position": 0,
    "text": "سناندار نیزه ز چنگ سوار"
  },
  {
    "poem_id": 88044,
    "vorder": 6,
    "position": 1,
    "text": "فرو ریخت از هول آن کارزار"
  },
  {
    "poem_id": 88044,
    "vorder": 7,
    "position": 0,
    "text": "کمان برگرفتند و تیر خدنگ"
  },
  {
    "poem_id": 88044,
    "vorder": 8,
    "position": 1,
    "text": "یک اندر دگر تاخته چون پلنگ"
  },
  {
    "poem_id": 88044,
    "vorder": 9,
    "position": 0,
    "text": "همی زنده بایست مر گیو را"
  },
  {
    "poem_id": 88044,
    "vorder": 10,
    "position": 1,
    "text": "کز اسب اندر آرد گو نیو را"
  },
  {
    "poem_id": 88044,
    "vorder": 11,
    "position": 0,
    "text": "چنان بسته در پیش خسرو برد"
  },
  {
    "poem_id": 88044,
    "vorder": 12,
    "position": 1,
    "text": "ز ترکان یکی هدیهٔ نو برد"
  },
  {
    "poem_id": 88044,
    "vorder": 13,
    "position": 0,
    "text": "چو گیو اندر آمد گروی از نهیب"
  },
  {
    "poem_id": 88044,
    "vorder": 14,
    "position": 1,
    "text": "کمان شد ز دستش به سوی نشیب"
  },
  {
    "poem_id": 88044,
    "vorder": 15,
    "position": 0,
    "text": "سوی تیغ برد آن زمان دست خویش"
  },
  {
    "poem_id": 88044,
    "vorder": 16,
    "position": 1,
    "text": "دمان گیو نیو اندر آمد به پیش"
  },
  {
    "poem_id": 88044,
    "vorder": 17,
    "position": 0,
    "text": "عمودی بزد بر سر و ترگ اوی"
  },
  {
    "poem_id": 88044,
    "vorder": 18,
    "position": 1,
    "text": "که خون اندر آمد ز تارک به روی"
  },
  {
    "poem_id": 88044,
    "vorder": 19,
    "position": 0,
    "text": "همیدون ز زین دست بگذاردش"
  },
  {
    "poem_id": 88044,
    "vorder": 20,
    "position": 1,
    "text": "گرفتش به بر سخت و بفشاردش"
  },
  {
    "poem_id": 88044,
    "vorder": 21,
    "position": 0,
    "text": "که بر پشت زین مرد بی‌توش گشت"
  },
  {
    "poem_id": 88044,
    "vorder": 22,
    "position": 1,
    "text": "ز اسب اندر افتاد و بیهوش گشت"
  },
  {
    "poem_id": 88044,
    "vorder": 23,
    "position": 0,
    "text": "فرود آمد از باره جنگی پلنگ"
  },
  {
    "poem_id": 88044,
    "vorder": 24,
    "position": 1,
    "text": "دو دست از پس پشت بستش چو سنگ"
  },
  {
    "poem_id": 88044,
    "vorder": 25,
    "position": 0,
    "text": "نشست از بر زین و او را به پیش"
  },
  {
    "poem_id": 88044,
    "vorder": 26,
    "position": 1,
    "text": "دوانید و شد تا بر یار خویش"
  },
  {
    "poem_id": 88044,
    "vorder": 27,
    "position": 0,
    "text": "به بالا برآمد درفشی به دست"
  },
  {
    "poem_id": 88044,
    "vorder": 28,
    "position": 1,
    "text": "به نعره همی کوه را کرد پست"
  },
  {
    "poem_id": 88044,
    "vorder": 29,
    "position": 0,
    "text": "به پیروزی شاه ایران زمین"
  },
  {
    "poem_id": 88044,
    "vorder": 30,
    "position": 1,
    "text": "همی خواند بر پهلوان آفرین"
  }
]