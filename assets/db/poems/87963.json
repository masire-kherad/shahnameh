[
  {
    "poem_id": 87963,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت پس پهلوان با زرسپ"
  },
  {
    "poem_id": 87963,
    "vorder": 2,
    "position": 1,
    "text": "که بفروز دل را چو آذرگشسپ"
  },
  {
    "poem_id": 87963,
    "vorder": 3,
    "position": 0,
    "text": "سلیح سواران جنگی بپوش"
  },
  {
    "poem_id": 87963,
    "vorder": 4,
    "position": 1,
    "text": "بجان و تن خویشتن دار گوش"
  },
  {
    "poem_id": 87963,
    "vorder": 5,
    "position": 0,
    "text": "تو خواهی مگر کین آن نامدار"
  },
  {
    "poem_id": 87963,
    "vorder": 6,
    "position": 1,
    "text": "وگرنه نبینم کسی خواستار"
  },
  {
    "poem_id": 87963,
    "vorder": 7,
    "position": 0,
    "text": "زرسپ آمد و ترگ بر سر نهاد"
  },
  {
    "poem_id": 87963,
    "vorder": 8,
    "position": 1,
    "text": "دلی پر ز کین و لبی پر ز باد"
  },
  {
    "poem_id": 87963,
    "vorder": 9,
    "position": 0,
    "text": "خروشان باسپ اندر آورد پای"
  },
  {
    "poem_id": 87963,
    "vorder": 10,
    "position": 1,
    "text": "بکردار آتش درآمد ز جای"
  },
  {
    "poem_id": 87963,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت شیر ژیان با تخوار"
  },
  {
    "poem_id": 87963,
    "vorder": 12,
    "position": 1,
    "text": "که آمد دگرگون یکی نامدار"
  },
  {
    "poem_id": 87963,
    "vorder": 13,
    "position": 0,
    "text": "ببین تا شناسی که این مرد کیست"
  },
  {
    "poem_id": 87963,
    "vorder": 14,
    "position": 1,
    "text": "یکی شهریار است اگر لشکریست"
  },
  {
    "poem_id": 87963,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت با شاه جنگی تخوار"
  },
  {
    "poem_id": 87963,
    "vorder": 16,
    "position": 1,
    "text": "که آمد گه گردش روزگار"
  },
  {
    "poem_id": 87963,
    "vorder": 17,
    "position": 0,
    "text": "که این پور طوسست نامش زرسپ"
  },
  {
    "poem_id": 87963,
    "vorder": 18,
    "position": 1,
    "text": "که از پیل جنگی نگرداند اسپ"
  },
  {
    "poem_id": 87963,
    "vorder": 19,
    "position": 0,
    "text": "که جفتست با خواهر ریونیز"
  },
  {
    "poem_id": 87963,
    "vorder": 20,
    "position": 1,
    "text": "بکین آمدست این جهانجوی نیز"
  },
  {
    "poem_id": 87963,
    "vorder": 21,
    "position": 0,
    "text": "چو بیند بر و بازوی و مغفرت"
  },
  {
    "poem_id": 87963,
    "vorder": 22,
    "position": 1,
    "text": "خدنگی بباید گشاد از برت"
  },
  {
    "poem_id": 87963,
    "vorder": 23,
    "position": 0,
    "text": "بدان تا بخاک اندر آید سرش"
  },
  {
    "poem_id": 87963,
    "vorder": 24,
    "position": 1,
    "text": "نگون اندر آید ز باره برش"
  },
  {
    "poem_id": 87963,
    "vorder": 25,
    "position": 0,
    "text": "بداند سپهدار دیوانه طوس"
  },
  {
    "poem_id": 87963,
    "vorder": 26,
    "position": 1,
    "text": "که ایدر نبودیم ما بر فسوس"
  },
  {
    "poem_id": 87963,
    "vorder": 27,
    "position": 0,
    "text": "فرود دلاور برانگیخت اسپ"
  },
  {
    "poem_id": 87963,
    "vorder": 28,
    "position": 1,
    "text": "یکی تیر زد بر میان زرسپ"
  },
  {
    "poem_id": 87963,
    "vorder": 29,
    "position": 0,
    "text": "که با کوههٔ زین تنش را بدوخت"
  },
  {
    "poem_id": 87963,
    "vorder": 30,
    "position": 1,
    "text": "روانش ز پیکان او برفروخت"
  },
  {
    "poem_id": 87963,
    "vorder": 31,
    "position": 0,
    "text": "بیفتاد و برگشت ازو بادپای"
  },
  {
    "poem_id": 87963,
    "vorder": 32,
    "position": 1,
    "text": "همی شد دمان و دنان باز جای"
  },
  {
    "poem_id": 87963,
    "vorder": 33,
    "position": 0,
    "text": "خروشی برآمد ز ایران سپاه"
  },
  {
    "poem_id": 87963,
    "vorder": 34,
    "position": 1,
    "text": "زسر برگرفتند گردان کلاه"
  },
  {
    "poem_id": 87963,
    "vorder": 35,
    "position": 0,
    "text": "دل طوس پرخون و دیده پراب"
  },
  {
    "poem_id": 87963,
    "vorder": 36,
    "position": 1,
    "text": "بپوشید جوشن هم اندر شتاب"
  },
  {
    "poem_id": 87963,
    "vorder": 37,
    "position": 0,
    "text": "ز گردان جنگی بنالید سخت"
  },
  {
    "poem_id": 87963,
    "vorder": 38,
    "position": 1,
    "text": "بلرزید برسان برگ درخت"
  },
  {
    "poem_id": 87963,
    "vorder": 39,
    "position": 0,
    "text": "نشست از بر زین چو کوهی بزرگ"
  },
  {
    "poem_id": 87963,
    "vorder": 40,
    "position": 1,
    "text": "که بنهند بر پشت پیلی سترگ"
  },
  {
    "poem_id": 87963,
    "vorder": 41,
    "position": 0,
    "text": "عنان را بپیچید سوی فرود"
  },
  {
    "poem_id": 87963,
    "vorder": 42,
    "position": 1,
    "text": "دلش پر ز کین و سرش پر ز دود"
  }
]