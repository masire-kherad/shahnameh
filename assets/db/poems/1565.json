[
  {
    "poem_id": 1565,
    "vorder": 1,
    "position": 0,
    "text": "جهانجوی پیش جهان‌آفرین"
  },
  {
    "poem_id": 1565,
    "vorder": 2,
    "position": 1,
    "text": "بمالید چندی رخ اندر زمین"
  },
  {
    "poem_id": 1565,
    "vorder": 3,
    "position": 0,
    "text": "بر آن بیشه اندر سراپرده زد"
  },
  {
    "poem_id": 1565,
    "vorder": 4,
    "position": 1,
    "text": "نهادند خوانی چنان چون سزد"
  },
  {
    "poem_id": 1565,
    "vorder": 5,
    "position": 0,
    "text": "به دژخیم فرمود پس شهریار"
  },
  {
    "poem_id": 1565,
    "vorder": 6,
    "position": 1,
    "text": "که آرند بدبخت را بسته خوار"
  },
  {
    "poem_id": 1565,
    "vorder": 7,
    "position": 0,
    "text": "ببردند پیش یل اسفندیار"
  },
  {
    "poem_id": 1565,
    "vorder": 8,
    "position": 1,
    "text": "چو دیدار او دید پس شهریار"
  },
  {
    "poem_id": 1565,
    "vorder": 9,
    "position": 0,
    "text": "سه جام می خسروانیش داد"
  },
  {
    "poem_id": 1565,
    "vorder": 10,
    "position": 1,
    "text": "ببد گرگسار از می لعل شاد"
  },
  {
    "poem_id": 1565,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت کای ترک برگشته بخت"
  },
  {
    "poem_id": 1565,
    "vorder": 12,
    "position": 1,
    "text": "سر پیر جادو ببین از درخت"
  },
  {
    "poem_id": 1565,
    "vorder": 13,
    "position": 0,
    "text": "که گفتی که لشکر به دریا برد"
  },
  {
    "poem_id": 1565,
    "vorder": 14,
    "position": 1,
    "text": "سر خویش را بر ثریا برد"
  },
  {
    "poem_id": 1565,
    "vorder": 15,
    "position": 0,
    "text": "دگر منزل اکنون چه بینم شگفت"
  },
  {
    "poem_id": 1565,
    "vorder": 16,
    "position": 1,
    "text": "کز این جادو اندازه باید گرفت"
  },
  {
    "poem_id": 1565,
    "vorder": 17,
    "position": 0,
    "text": "چنین داد پاسخ ورا گرگسار"
  },
  {
    "poem_id": 1565,
    "vorder": 18,
    "position": 1,
    "text": "که ای پیل جنگی گه کارزار"
  },
  {
    "poem_id": 1565,
    "vorder": 19,
    "position": 0,
    "text": "بدین منزلت کار دشوارتر"
  },
  {
    "poem_id": 1565,
    "vorder": 20,
    "position": 1,
    "text": "گراینده‌تر باش و بیدارتر"
  },
  {
    "poem_id": 1565,
    "vorder": 21,
    "position": 0,
    "text": "یکی کوه بینی سر اندر هوا"
  },
  {
    "poem_id": 1565,
    "vorder": 22,
    "position": 1,
    "text": "بر او بر یکی مرغ فرمانروا"
  },
  {
    "poem_id": 1565,
    "vorder": 23,
    "position": 0,
    "text": "که سیمرغ گوید ورا کارجوی"
  },
  {
    "poem_id": 1565,
    "vorder": 24,
    "position": 1,
    "text": "چو پرنده کوهیست پیکارجوی"
  },
  {
    "poem_id": 1565,
    "vorder": 25,
    "position": 0,
    "text": "اگر پیل بیند برآرد به ابر"
  },
  {
    "poem_id": 1565,
    "vorder": 26,
    "position": 1,
    "text": "ز دریا نهنگ و به خشکی هژبر"
  },
  {
    "poem_id": 1565,
    "vorder": 27,
    "position": 0,
    "text": "نبیند ز برداشتن هیچ رنج"
  },
  {
    "poem_id": 1565,
    "vorder": 28,
    "position": 1,
    "text": "تو او را چو گرگ و چو جادو مسنج"
  },
  {
    "poem_id": 1565,
    "vorder": 29,
    "position": 0,
    "text": "دو بچه است با او به بالای او"
  },
  {
    "poem_id": 1565,
    "vorder": 30,
    "position": 1,
    "text": "همان رای پیوسته با رای او"
  },
  {
    "poem_id": 1565,
    "vorder": 31,
    "position": 0,
    "text": "چو او بر هوا رفت و گسترد پر"
  },
  {
    "poem_id": 1565,
    "vorder": 32,
    "position": 1,
    "text": "ندارد زمین هوش و خورشید فر"
  },
  {
    "poem_id": 1565,
    "vorder": 33,
    "position": 0,
    "text": "اگر بازگردی بود سودمند"
  },
  {
    "poem_id": 1565,
    "vorder": 34,
    "position": 1,
    "text": "نیازی به سیمرغ و کوه بلند"
  },
  {
    "poem_id": 1565,
    "vorder": 35,
    "position": 0,
    "text": "از او در بخندید و گفت ای شگفت"
  },
  {
    "poem_id": 1565,
    "vorder": 36,
    "position": 1,
    "text": "به پیکان بدوزم من او را دو کتف"
  },
  {
    "poem_id": 1565,
    "vorder": 37,
    "position": 0,
    "text": "ببرم به شمشیر هندی برش"
  },
  {
    "poem_id": 1565,
    "vorder": 38,
    "position": 1,
    "text": "به خاک اندر آرم ز بالا سرش"
  },
  {
    "poem_id": 1565,
    "vorder": 39,
    "position": 0,
    "text": "چو خورشید تابنده بنمود پشت"
  },
  {
    "poem_id": 1565,
    "vorder": 40,
    "position": 1,
    "text": "دل خاور از پشت او شد درشت"
  },
  {
    "poem_id": 1565,
    "vorder": 41,
    "position": 0,
    "text": "سر جنگجویان سپه برگرفت"
  },
  {
    "poem_id": 1565,
    "vorder": 42,
    "position": 1,
    "text": "سخنهای سیمرغ در سر گرفت"
  },
  {
    "poem_id": 1565,
    "vorder": 43,
    "position": 0,
    "text": "همه شب همی راند با خود گروه"
  },
  {
    "poem_id": 1565,
    "vorder": 44,
    "position": 1,
    "text": "چو خورشید تابان برآمد ز کوه"
  },
  {
    "poem_id": 1565,
    "vorder": 45,
    "position": 0,
    "text": "چراغ زمان و زمین تازه کرد"
  },
  {
    "poem_id": 1565,
    "vorder": 46,
    "position": 1,
    "text": "در و دشت بر دیگر اندازه کرد"
  },
  {
    "poem_id": 1565,
    "vorder": 47,
    "position": 0,
    "text": "همان اسپ و گردون و صندوق برد"
  },
  {
    "poem_id": 1565,
    "vorder": 48,
    "position": 1,
    "text": "سپه را به سالار لشکر سپرد"
  },
  {
    "poem_id": 1565,
    "vorder": 49,
    "position": 0,
    "text": "همی رفت چون باد فرمانروا"
  },
  {
    "poem_id": 1565,
    "vorder": 50,
    "position": 1,
    "text": "یکی کوه دیدش سر اندر هوا"
  },
  {
    "poem_id": 1565,
    "vorder": 51,
    "position": 0,
    "text": "بر آن سایه بر اسپ و گردون بداشت"
  },
  {
    "poem_id": 1565,
    "vorder": 52,
    "position": 1,
    "text": "روان را به اندیشه اندر گماشت"
  },
  {
    "poem_id": 1565,
    "vorder": 53,
    "position": 0,
    "text": "همی آفرین خواند بر یک خدای"
  },
  {
    "poem_id": 1565,
    "vorder": 54,
    "position": 1,
    "text": "که گیتی به فرمان او شد به پای"
  },
  {
    "poem_id": 1565,
    "vorder": 55,
    "position": 0,
    "text": "چو سیمرغ از دور صندوق دید"
  },
  {
    "poem_id": 1565,
    "vorder": 56,
    "position": 1,
    "text": "پسش لشکر و نالهٔ بوق دید"
  },
  {
    "poem_id": 1565,
    "vorder": 57,
    "position": 0,
    "text": "ز کوه اندر آمد چو ابری سیاه"
  },
  {
    "poem_id": 1565,
    "vorder": 58,
    "position": 1,
    "text": "نه خورشید بد نیز روشن نه ماه"
  },
  {
    "poem_id": 1565,
    "vorder": 59,
    "position": 0,
    "text": "بدان بد که گردون بگیرد به چنگ"
  },
  {
    "poem_id": 1565,
    "vorder": 60,
    "position": 1,
    "text": "بر آن سان که نخچیر گیرد پلنگ"
  },
  {
    "poem_id": 1565,
    "vorder": 61,
    "position": 0,
    "text": "بر آن تیغها زد دو پا و دو پر"
  },
  {
    "poem_id": 1565,
    "vorder": 62,
    "position": 1,
    "text": "نماند ایچ سیمرغ را زیب و فر"
  },
  {
    "poem_id": 1565,
    "vorder": 63,
    "position": 0,
    "text": "به چنگ و به منقار چندی تپید"
  },
  {
    "poem_id": 1565,
    "vorder": 64,
    "position": 1,
    "text": "چو تنگ اندر آمد فرو آرمید"
  },
  {
    "poem_id": 1565,
    "vorder": 65,
    "position": 0,
    "text": "چو دیدند سیمرغ را بچگان"
  },
  {
    "poem_id": 1565,
    "vorder": 66,
    "position": 1,
    "text": "خروشان و خون از دو دیده چکان"
  },
  {
    "poem_id": 1565,
    "vorder": 67,
    "position": 0,
    "text": "چنان بردمیدند از آن جایگاه"
  },
  {
    "poem_id": 1565,
    "vorder": 68,
    "position": 1,
    "text": "که از سهمشان دیده گم کرد راه"
  },
  {
    "poem_id": 1565,
    "vorder": 69,
    "position": 0,
    "text": "چو سیمرغ زان تیغها گشت سست"
  },
  {
    "poem_id": 1565,
    "vorder": 70,
    "position": 1,
    "text": "به خوناب صندوق و گردون بشست"
  },
  {
    "poem_id": 1565,
    "vorder": 71,
    "position": 0,
    "text": "ز صندوق بیرون شد اسفندیار"
  },
  {
    "poem_id": 1565,
    "vorder": 72,
    "position": 1,
    "text": "بغرید با آلت کارزار"
  },
  {
    "poem_id": 1565,
    "vorder": 73,
    "position": 0,
    "text": "زره در بر و تیغ هندی به چنگ"
  },
  {
    "poem_id": 1565,
    "vorder": 74,
    "position": 1,
    "text": "چه زور آورد مرغ پیش نهنگ"
  },
  {
    "poem_id": 1565,
    "vorder": 75,
    "position": 0,
    "text": "همی زد بر او تیغ تا پاره گشت"
  },
  {
    "poem_id": 1565,
    "vorder": 76,
    "position": 1,
    "text": "چنان چاره گر مرغ بیچاره گشت"
  },
  {
    "poem_id": 1565,
    "vorder": 77,
    "position": 0,
    "text": "بیامد به پیش خداوند ماه"
  },
  {
    "poem_id": 1565,
    "vorder": 78,
    "position": 1,
    "text": "که او داد بر هر ددی دستگاه"
  },
  {
    "poem_id": 1565,
    "vorder": 79,
    "position": 0,
    "text": "چنین گفت کای داور دادگر"
  },
  {
    "poem_id": 1565,
    "vorder": 80,
    "position": 1,
    "text": "خداوند پاکی و زور و هنر"
  },
  {
    "poem_id": 1565,
    "vorder": 81,
    "position": 0,
    "text": "تو بردی پی جادوان را ز جای"
  },
  {
    "poem_id": 1565,
    "vorder": 82,
    "position": 1,
    "text": "تو بودی بدین نیکیم رهنمای"
  },
  {
    "poem_id": 1565,
    "vorder": 83,
    "position": 0,
    "text": "هم‌آنگه خروش آمد از کرنای"
  },
  {
    "poem_id": 1565,
    "vorder": 84,
    "position": 1,
    "text": "پشوتن بیاورد پرده‌سرای"
  },
  {
    "poem_id": 1565,
    "vorder": 85,
    "position": 0,
    "text": "سلیح برادر سپاه و پسر"
  },
  {
    "poem_id": 1565,
    "vorder": 86,
    "position": 1,
    "text": "بزرگان ایران و تاج و کمر"
  },
  {
    "poem_id": 1565,
    "vorder": 87,
    "position": 0,
    "text": "از آن کشته کس روی هامون ندید"
  },
  {
    "poem_id": 1565,
    "vorder": 88,
    "position": 1,
    "text": "جز اندام جنگاور و خون ندید"
  },
  {
    "poem_id": 1565,
    "vorder": 89,
    "position": 0,
    "text": "زمین کوه تا کوه پر پر بود"
  },
  {
    "poem_id": 1565,
    "vorder": 90,
    "position": 1,
    "text": "ز پرش همه دشت پر فر بود"
  },
  {
    "poem_id": 1565,
    "vorder": 91,
    "position": 0,
    "text": "بدیدند پر خون تن شاه را"
  },
  {
    "poem_id": 1565,
    "vorder": 92,
    "position": 1,
    "text": "کجا خیره کردی به رخ ماه را"
  },
  {
    "poem_id": 1565,
    "vorder": 93,
    "position": 0,
    "text": "همی آفرین خواندندش سران"
  },
  {
    "poem_id": 1565,
    "vorder": 94,
    "position": 1,
    "text": "سواران جنگی و کنداوران"
  },
  {
    "poem_id": 1565,
    "vorder": 95,
    "position": 0,
    "text": "شنید آن سخن در زمان گرگسار"
  },
  {
    "poem_id": 1565,
    "vorder": 96,
    "position": 1,
    "text": "که پیروز شد نامور شهریار"
  },
  {
    "poem_id": 1565,
    "vorder": 97,
    "position": 0,
    "text": "تنش گشت لرزان و رخساره زرد"
  },
  {
    "poem_id": 1565,
    "vorder": 98,
    "position": 1,
    "text": "همی رفت پویان و دل پر ز درد"
  },
  {
    "poem_id": 1565,
    "vorder": 99,
    "position": 0,
    "text": "سراپرده زد شهریار جوان"
  },
  {
    "poem_id": 1565,
    "vorder": 100,
    "position": 1,
    "text": "به گردش دلیران روشن‌روان"
  },
  {
    "poem_id": 1565,
    "vorder": 101,
    "position": 0,
    "text": "زمین را به دیبا بیاراستند"
  },
  {
    "poem_id": 1565,
    "vorder": 102,
    "position": 1,
    "text": "نشستند بر خوان و می خواستند"
  }
]