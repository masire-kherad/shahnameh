[
  {
    "poem_id": 1595,
    "vorder": 1,
    "position": 0,
    "text": "چو رستم بیامد به ایوان خویش"
  },
  {
    "poem_id": 1595,
    "vorder": 2,
    "position": 1,
    "text": "نگه کرد چندی به دیوان خویش"
  },
  {
    "poem_id": 1595,
    "vorder": 3,
    "position": 0,
    "text": "زواره بیامد به نزدیک اوی"
  },
  {
    "poem_id": 1595,
    "vorder": 4,
    "position": 1,
    "text": "ورا دید پژمرده و زردروی"
  },
  {
    "poem_id": 1595,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت رو تیغ هندی بیار"
  },
  {
    "poem_id": 1595,
    "vorder": 6,
    "position": 1,
    "text": "یکی جوشن و مغفری نامدار"
  },
  {
    "poem_id": 1595,
    "vorder": 7,
    "position": 0,
    "text": "کمان آر و برگستوان آر و ببر"
  },
  {
    "poem_id": 1595,
    "vorder": 8,
    "position": 1,
    "text": "کمند آر و گرز گران آر و گبر"
  },
  {
    "poem_id": 1595,
    "vorder": 9,
    "position": 0,
    "text": "زواره بفرمود تا هرچ گفت"
  },
  {
    "poem_id": 1595,
    "vorder": 10,
    "position": 1,
    "text": "بیاورد گنجور او از نهفت"
  },
  {
    "poem_id": 1595,
    "vorder": 11,
    "position": 0,
    "text": "چو رستم سلیح نبردش بدید"
  },
  {
    "poem_id": 1595,
    "vorder": 12,
    "position": 1,
    "text": "سرافشاند و باد از جگر برکشید"
  },
  {
    "poem_id": 1595,
    "vorder": 13,
    "position": 0,
    "text": "چنین گفت کای جوشن کارزار"
  },
  {
    "poem_id": 1595,
    "vorder": 14,
    "position": 1,
    "text": "برآسودی از جنگ یک روزگار"
  },
  {
    "poem_id": 1595,
    "vorder": 15,
    "position": 0,
    "text": "کنون کار پیش آمدت سخت باش"
  },
  {
    "poem_id": 1595,
    "vorder": 16,
    "position": 1,
    "text": "به هر جای پیراهن بخت باش"
  },
  {
    "poem_id": 1595,
    "vorder": 17,
    "position": 0,
    "text": "چنین رزمگاهی که غران دو شیر"
  },
  {
    "poem_id": 1595,
    "vorder": 18,
    "position": 1,
    "text": "به جنگ اندر آیند هر دو دلیر"
  },
  {
    "poem_id": 1595,
    "vorder": 19,
    "position": 0,
    "text": "کنون تا چه پیش آرد اسفندیار"
  },
  {
    "poem_id": 1595,
    "vorder": 20,
    "position": 1,
    "text": "چه بازی کند در دم کارزار"
  },
  {
    "poem_id": 1595,
    "vorder": 21,
    "position": 0,
    "text": "چو بشنید دستان ز رستم سخن"
  },
  {
    "poem_id": 1595,
    "vorder": 22,
    "position": 1,
    "text": "پراندیشه شد جان مرد کهن"
  },
  {
    "poem_id": 1595,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت کای نامور پهلوان"
  },
  {
    "poem_id": 1595,
    "vorder": 24,
    "position": 1,
    "text": "چه گفتی کزان تیره گشتم روان"
  },
  {
    "poem_id": 1595,
    "vorder": 25,
    "position": 0,
    "text": "تو تا بر نشستی بزین نبرد"
  },
  {
    "poem_id": 1595,
    "vorder": 26,
    "position": 1,
    "text": "نبودی مگر نیک دل رادمرد"
  },
  {
    "poem_id": 1595,
    "vorder": 27,
    "position": 0,
    "text": "همیشه دل از رنج پرداخته"
  },
  {
    "poem_id": 1595,
    "vorder": 28,
    "position": 1,
    "text": "به فرمان شاهان سرافراخته"
  },
  {
    "poem_id": 1595,
    "vorder": 29,
    "position": 0,
    "text": "بترسم که روزت سرآید همی"
  },
  {
    "poem_id": 1595,
    "vorder": 30,
    "position": 1,
    "text": "گر اختر به خواب اندر آید همی"
  },
  {
    "poem_id": 1595,
    "vorder": 31,
    "position": 0,
    "text": "همی تخم دستان ز بن برکنند"
  },
  {
    "poem_id": 1595,
    "vorder": 32,
    "position": 1,
    "text": "زن و کودکان را به خاک افگنند"
  },
  {
    "poem_id": 1595,
    "vorder": 33,
    "position": 0,
    "text": "به دست جوانی چو اسفندیار"
  },
  {
    "poem_id": 1595,
    "vorder": 34,
    "position": 1,
    "text": "اگر تو شوی کشته در کارزار"
  },
  {
    "poem_id": 1595,
    "vorder": 35,
    "position": 0,
    "text": "نماند به زاولستان آب و خاک"
  },
  {
    "poem_id": 1595,
    "vorder": 36,
    "position": 1,
    "text": "بلندی بر و بوم گردد مغاک"
  },
  {
    "poem_id": 1595,
    "vorder": 37,
    "position": 0,
    "text": "ور ایدونک او را رسد زین گزند"
  },
  {
    "poem_id": 1595,
    "vorder": 38,
    "position": 1,
    "text": "نباشد ترا نیز نام بلند"
  },
  {
    "poem_id": 1595,
    "vorder": 39,
    "position": 0,
    "text": "همی هرکسی داستانها زنند"
  },
  {
    "poem_id": 1595,
    "vorder": 40,
    "position": 1,
    "text": "برآورده نام ترا بشکرند"
  },
  {
    "poem_id": 1595,
    "vorder": 41,
    "position": 0,
    "text": "که او شهریاری ز ایران بکشت"
  },
  {
    "poem_id": 1595,
    "vorder": 42,
    "position": 1,
    "text": "بدان کو سخن گفت با وی درشت"
  },
  {
    "poem_id": 1595,
    "vorder": 43,
    "position": 0,
    "text": "همی باش در پیش او بر به پای"
  },
  {
    "poem_id": 1595,
    "vorder": 44,
    "position": 1,
    "text": "وگرنه هم‌اکنون بپرداز جای"
  },
  {
    "poem_id": 1595,
    "vorder": 45,
    "position": 0,
    "text": "به بیغوله‌ای شو فرود از مهان"
  },
  {
    "poem_id": 1595,
    "vorder": 46,
    "position": 1,
    "text": "که کس نشنود نامت اندر جهان"
  },
  {
    "poem_id": 1595,
    "vorder": 47,
    "position": 0,
    "text": "کزین بد ترا تیره گردد روان"
  },
  {
    "poem_id": 1595,
    "vorder": 48,
    "position": 1,
    "text": "بپرهیز ازین شهریار جوان"
  },
  {
    "poem_id": 1595,
    "vorder": 49,
    "position": 0,
    "text": "به گنج و به رنج این روان بازخر"
  },
  {
    "poem_id": 1595,
    "vorder": 50,
    "position": 1,
    "text": "مبر پیش دیبای چینی تبر"
  },
  {
    "poem_id": 1595,
    "vorder": 51,
    "position": 0,
    "text": "سپاه ورا خلعت آرای نیز"
  },
  {
    "poem_id": 1595,
    "vorder": 52,
    "position": 1,
    "text": "ازو باز خر خویشتن را به چیز"
  },
  {
    "poem_id": 1595,
    "vorder": 53,
    "position": 0,
    "text": "چو برگردد او از لب هیرمند"
  },
  {
    "poem_id": 1595,
    "vorder": 54,
    "position": 1,
    "text": "تو پای اندر آور به رخش بلند"
  },
  {
    "poem_id": 1595,
    "vorder": 55,
    "position": 0,
    "text": "چو ایمن شدی بندگی کن به راه"
  },
  {
    "poem_id": 1595,
    "vorder": 56,
    "position": 1,
    "text": "بدان تا ببینی یکی روی شاه"
  },
  {
    "poem_id": 1595,
    "vorder": 57,
    "position": 0,
    "text": "چو بیند ترا کی کند شاه بد"
  },
  {
    "poem_id": 1595,
    "vorder": 58,
    "position": 1,
    "text": "خود از شاه کردار بد کی سزد"
  },
  {
    "poem_id": 1595,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت رستم که ای مرد پیر"
  },
  {
    "poem_id": 1595,
    "vorder": 60,
    "position": 1,
    "text": "سخنها برین گونه آسان مگیر"
  },
  {
    "poem_id": 1595,
    "vorder": 61,
    "position": 0,
    "text": "به مردی مرا سال بسیار گشت"
  },
  {
    "poem_id": 1595,
    "vorder": 62,
    "position": 1,
    "text": "بد و نیک چندی بسر بر گذشت"
  },
  {
    "poem_id": 1595,
    "vorder": 63,
    "position": 0,
    "text": "رسیدم به دیوان مازندران"
  },
  {
    "poem_id": 1595,
    "vorder": 64,
    "position": 1,
    "text": "به رزم سواران هاماوران"
  },
  {
    "poem_id": 1595,
    "vorder": 65,
    "position": 0,
    "text": "همان رزم کاموس و خاقان چین"
  },
  {
    "poem_id": 1595,
    "vorder": 66,
    "position": 1,
    "text": "که لرزان بدی زیر ایشان زمین"
  },
  {
    "poem_id": 1595,
    "vorder": 67,
    "position": 0,
    "text": "اگر من گریزم ز اسفندیار"
  },
  {
    "poem_id": 1595,
    "vorder": 68,
    "position": 1,
    "text": "تو در سیستان کاخ و گلشن مدار"
  },
  {
    "poem_id": 1595,
    "vorder": 69,
    "position": 0,
    "text": "چو من ببر پوشم به روز نبرد"
  },
  {
    "poem_id": 1595,
    "vorder": 70,
    "position": 1,
    "text": "سر هور و ماه اندرآرم به گرد"
  },
  {
    "poem_id": 1595,
    "vorder": 71,
    "position": 0,
    "text": "ز خواهش که گفتی بسی رانده‌ام"
  },
  {
    "poem_id": 1595,
    "vorder": 72,
    "position": 1,
    "text": "بدو دفتر کهتری خوانده‌ام"
  },
  {
    "poem_id": 1595,
    "vorder": 73,
    "position": 0,
    "text": "همی خوار گیرد سخنهای من"
  },
  {
    "poem_id": 1595,
    "vorder": 74,
    "position": 1,
    "text": "بپیچد سر از دانش و رای من"
  },
  {
    "poem_id": 1595,
    "vorder": 75,
    "position": 0,
    "text": "گر او سر ز کیوان فرود آردی"
  },
  {
    "poem_id": 1595,
    "vorder": 76,
    "position": 1,
    "text": "روانش بر من درود آردی"
  },
  {
    "poem_id": 1595,
    "vorder": 77,
    "position": 0,
    "text": "ازو نیستی گنج و گوهر دریغ"
  },
  {
    "poem_id": 1595,
    "vorder": 78,
    "position": 1,
    "text": "نه برگستوان و نه گوپال و تیغ"
  },
  {
    "poem_id": 1595,
    "vorder": 79,
    "position": 0,
    "text": "سخن چند گفتم به چندین نشست"
  },
  {
    "poem_id": 1595,
    "vorder": 80,
    "position": 1,
    "text": "ز گفتار باد است ما را به دست"
  },
  {
    "poem_id": 1595,
    "vorder": 81,
    "position": 0,
    "text": "گر ایدونک فردا کند کارزار"
  },
  {
    "poem_id": 1595,
    "vorder": 82,
    "position": 1,
    "text": "دل از جان او هیچ رنجه مدار"
  },
  {
    "poem_id": 1595,
    "vorder": 83,
    "position": 0,
    "text": "نپیچم به آورد با او عنان"
  },
  {
    "poem_id": 1595,
    "vorder": 84,
    "position": 1,
    "text": "نه گوپال بیند نه زخم سنان"
  },
  {
    "poem_id": 1595,
    "vorder": 85,
    "position": 0,
    "text": "نبندم به آوردگاه راه اوی"
  },
  {
    "poem_id": 1595,
    "vorder": 86,
    "position": 1,
    "text": "بنیرو نگیرم کمرگاه اوی"
  },
  {
    "poem_id": 1595,
    "vorder": 87,
    "position": 0,
    "text": "ز باره به آغوش بردارمش"
  },
  {
    "poem_id": 1595,
    "vorder": 88,
    "position": 1,
    "text": "به شاهی ز گشتاسپ بگذارمش"
  },
  {
    "poem_id": 1595,
    "vorder": 89,
    "position": 0,
    "text": "بیارم نشانم بر تخت ناز"
  },
  {
    "poem_id": 1595,
    "vorder": 90,
    "position": 1,
    "text": "ازان پس گشایم در گنج باز"
  },
  {
    "poem_id": 1595,
    "vorder": 91,
    "position": 0,
    "text": "چو مهمان من بوده باشد سه روز"
  },
  {
    "poem_id": 1595,
    "vorder": 92,
    "position": 1,
    "text": "چهارم چو از چرخ گیتی فروز"
  },
  {
    "poem_id": 1595,
    "vorder": 93,
    "position": 0,
    "text": "بیندازد آن چادر لاژورد"
  },
  {
    "poem_id": 1595,
    "vorder": 94,
    "position": 1,
    "text": "پدید آید از جام یاقوت زرد"
  },
  {
    "poem_id": 1595,
    "vorder": 95,
    "position": 0,
    "text": "سبک باز با او ببندم کمر"
  },
  {
    "poem_id": 1595,
    "vorder": 96,
    "position": 1,
    "text": "وز ایدر نهم سوی گشتاسپ سر"
  },
  {
    "poem_id": 1595,
    "vorder": 97,
    "position": 0,
    "text": "نشانمش بر نامور تخت عاج"
  },
  {
    "poem_id": 1595,
    "vorder": 98,
    "position": 1,
    "text": "نهم بر سرش بر دل‌افروز تاج"
  },
  {
    "poem_id": 1595,
    "vorder": 99,
    "position": 0,
    "text": "ببندم کمر پیش او بنده‌وار"
  },
  {
    "poem_id": 1595,
    "vorder": 100,
    "position": 1,
    "text": "نجویم جدایی ز اسفندیار"
  },
  {
    "poem_id": 1595,
    "vorder": 101,
    "position": 0,
    "text": "تو دانی که من پیش تخت قباد"
  },
  {
    "poem_id": 1595,
    "vorder": 102,
    "position": 1,
    "text": "چه کردم به مردی تو داری به یاد"
  },
  {
    "poem_id": 1595,
    "vorder": 103,
    "position": 0,
    "text": "بخندید از گفت او زال زر"
  },
  {
    "poem_id": 1595,
    "vorder": 104,
    "position": 1,
    "text": "زمانی بجنبید ز اندیشه سر"
  },
  {
    "poem_id": 1595,
    "vorder": 105,
    "position": 0,
    "text": "بدو گفت زال ای پسر این سخن"
  },
  {
    "poem_id": 1595,
    "vorder": 106,
    "position": 1,
    "text": "مگوی و جدا کن سرش را ز بن"
  },
  {
    "poem_id": 1595,
    "vorder": 107,
    "position": 0,
    "text": "که دیوانگان این سخن بشنوند"
  },
  {
    "poem_id": 1595,
    "vorder": 108,
    "position": 1,
    "text": "بدین خام گفتار تو نگروند"
  },
  {
    "poem_id": 1595,
    "vorder": 109,
    "position": 0,
    "text": "قبادی به جایی نشسته دژم"
  },
  {
    "poem_id": 1595,
    "vorder": 110,
    "position": 1,
    "text": "نه تخت و کلاه و نه گنج کهن"
  },
  {
    "poem_id": 1595,
    "vorder": 111,
    "position": 0,
    "text": "چو اسفندیاری که فعفور چین"
  },
  {
    "poem_id": 1595,
    "vorder": 112,
    "position": 1,
    "text": "نویسد همی نام او بر نگین"
  },
  {
    "poem_id": 1595,
    "vorder": 113,
    "position": 0,
    "text": "تو گویی که از باره بردارمش"
  },
  {
    "poem_id": 1595,
    "vorder": 114,
    "position": 1,
    "text": "به بر بر سوی خان زال آرمش"
  },
  {
    "poem_id": 1595,
    "vorder": 115,
    "position": 0,
    "text": "نگوید چنین مردم سالخورد"
  },
  {
    "poem_id": 1595,
    "vorder": 116,
    "position": 1,
    "text": "به گرد در ناسپاسی مگرد"
  },
  {
    "poem_id": 1595,
    "vorder": 117,
    "position": 0,
    "text": "بگفت این و بنهاد سر بر زمین"
  },
  {
    "poem_id": 1595,
    "vorder": 118,
    "position": 1,
    "text": "همی خواند بر کردگار آفرین"
  },
  {
    "poem_id": 1595,
    "vorder": 119,
    "position": 0,
    "text": "همی گفت کای داور کردگار"
  },
  {
    "poem_id": 1595,
    "vorder": 120,
    "position": 1,
    "text": "بگردان تو از ما بد روزگار"
  },
  {
    "poem_id": 1595,
    "vorder": 121,
    "position": 0,
    "text": "برین گونه تا خور برآمد ز کوه"
  },
  {
    "poem_id": 1595,
    "vorder": 122,
    "position": 1,
    "text": "نیامد زبانش ز گفتن ستوه"
  }
]