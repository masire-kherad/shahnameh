[
  {
    "poem_id": 1348,
    "vorder": 1,
    "position": 0,
    "text": "چو از روزگارش چهل سال ماند"
  },
  {
    "poem_id": 1348,
    "vorder": 2,
    "position": 1,
    "text": "نگر تا به سر برش یزدان چه راند"
  },
  {
    "poem_id": 1348,
    "vorder": 3,
    "position": 0,
    "text": "در ایوان شاهی شبی دیر یاز"
  },
  {
    "poem_id": 1348,
    "vorder": 4,
    "position": 1,
    "text": "به خواب اندرون بود با ارنواز"
  },
  {
    "poem_id": 1348,
    "vorder": 5,
    "position": 0,
    "text": "چنان دید کز کاخ شاهنشهان"
  },
  {
    "poem_id": 1348,
    "vorder": 6,
    "position": 1,
    "text": "سه جنگی پدید آمدی ناگهان"
  },
  {
    "poem_id": 1348,
    "vorder": 7,
    "position": 0,
    "text": "دو مهتر یکی کهتر اندر میان"
  },
  {
    "poem_id": 1348,
    "vorder": 8,
    "position": 1,
    "text": "به بالای سرو و به فرّ کیان"
  },
  {
    "poem_id": 1348,
    "vorder": 9,
    "position": 0,
    "text": "کمر بستن و رفتن شاهوار"
  },
  {
    "poem_id": 1348,
    "vorder": 10,
    "position": 1,
    "text": "به چنگ اندرون گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1348,
    "vorder": 11,
    "position": 0,
    "text": "دمان پیش ضحاک رفتی به جنگ"
  },
  {
    "poem_id": 1348,
    "vorder": 12,
    "position": 1,
    "text": "نهادی به گردن برش پالهنگ"
  },
  {
    "poem_id": 1348,
    "vorder": 13,
    "position": 0,
    "text": "همی تاختی تا دماوند کوه"
  },
  {
    "poem_id": 1348,
    "vorder": 14,
    "position": 1,
    "text": "کشان و دوان از پس اندر گروه"
  },
  {
    "poem_id": 1348,
    "vorder": 15,
    "position": 0,
    "text": "بپیچید ضحاک بیدادگر"
  },
  {
    "poem_id": 1348,
    "vorder": 16,
    "position": 1,
    "text": "بدرّیدش از هول گفتی جگر"
  },
  {
    "poem_id": 1348,
    "vorder": 17,
    "position": 0,
    "text": "یکی بانگ بر زد به خواب اندرون"
  },
  {
    "poem_id": 1348,
    "vorder": 18,
    "position": 1,
    "text": "که لرزان شد آن خانهٔ صدستون"
  },
  {
    "poem_id": 1348,
    "vorder": 19,
    "position": 0,
    "text": "بجَستند خورشیدرویان ز جای"
  },
  {
    "poem_id": 1348,
    "vorder": 20,
    "position": 1,
    "text": "از آن غلغل نامور کدخدای"
  },
  {
    "poem_id": 1348,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت ضحاک را ارنواز"
  },
  {
    "poem_id": 1348,
    "vorder": 22,
    "position": 1,
    "text": "که شاها چه بودت نگویی به راز"
  },
  {
    "poem_id": 1348,
    "vorder": 23,
    "position": 0,
    "text": "که خفته به آرام در خان خویش"
  },
  {
    "poem_id": 1348,
    "vorder": 24,
    "position": 1,
    "text": "بر این سان بترسیدی از جان خویش"
  },
  {
    "poem_id": 1348,
    "vorder": 25,
    "position": 0,
    "text": "زمین هفت کشور به فرمان تو است"
  },
  {
    "poem_id": 1348,
    "vorder": 26,
    "position": 1,
    "text": "دد و دام و مردم به پیمان تو است"
  },
  {
    "poem_id": 1348,
    "vorder": 27,
    "position": 0,
    "text": "به خورشیدرویان جهاندار گفت"
  },
  {
    "poem_id": 1348,
    "vorder": 28,
    "position": 1,
    "text": "که چونین شگفتی بشاید نهفت"
  },
  {
    "poem_id": 1348,
    "vorder": 29,
    "position": 0,
    "text": "که گر از من این داستان بشنوید"
  },
  {
    "poem_id": 1348,
    "vorder": 30,
    "position": 1,
    "text": "شودتان دل از جان من ناامید"
  },
  {
    "poem_id": 1348,
    "vorder": 31,
    "position": 0,
    "text": "به شاه گرانمایه گفت ارنواز"
  },
  {
    "poem_id": 1348,
    "vorder": 32,
    "position": 1,
    "text": "که بر ما بباید گشادنت راز"
  },
  {
    "poem_id": 1348,
    "vorder": 33,
    "position": 0,
    "text": "توانیم کردن مگر چاره‌ای"
  },
  {
    "poem_id": 1348,
    "vorder": 34,
    "position": 1,
    "text": "که بی‌چاره‌ای نیست پتیاره‌ای"
  },
  {
    "poem_id": 1348,
    "vorder": 35,
    "position": 0,
    "text": "سپهبد گشاد آن نهان از نهفت"
  },
  {
    "poem_id": 1348,
    "vorder": 36,
    "position": 1,
    "text": "همه خواب یک یک بدیشان بگفت"
  },
  {
    "poem_id": 1348,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت با نامور ماهروی"
  },
  {
    "poem_id": 1348,
    "vorder": 38,
    "position": 1,
    "text": "که مگذار این را ره چاره جوی"
  },
  {
    "poem_id": 1348,
    "vorder": 39,
    "position": 0,
    "text": "نگین زمانه سر تخت تو است"
  },
  {
    "poem_id": 1348,
    "vorder": 40,
    "position": 1,
    "text": "جهان روشن از نامور بخت تو است"
  },
  {
    "poem_id": 1348,
    "vorder": 41,
    "position": 0,
    "text": "تو داری جهان زیر انگشتری"
  },
  {
    "poem_id": 1348,
    "vorder": 42,
    "position": 1,
    "text": "دد و مردم و مرغ و دیو و پری"
  },
  {
    "poem_id": 1348,
    "vorder": 43,
    "position": 0,
    "text": "ز هر کشوری گِرد کن مهتران"
  },
  {
    "poem_id": 1348,
    "vorder": 44,
    "position": 1,
    "text": "از اخترشناسان و افسونگران"
  },
  {
    "poem_id": 1348,
    "vorder": 45,
    "position": 0,
    "text": "سخن سربه‌سر موبدان را بگوی"
  },
  {
    "poem_id": 1348,
    "vorder": 46,
    "position": 1,
    "text": "پژوهش کن و راستی بازجوی"
  },
  {
    "poem_id": 1348,
    "vorder": 47,
    "position": 0,
    "text": "نگه کن که هوش تو بر دست کیست"
  },
  {
    "poem_id": 1348,
    "vorder": 48,
    "position": 1,
    "text": "ز مردم شمار ار ز دیو و پریست"
  },
  {
    "poem_id": 1348,
    "vorder": 49,
    "position": 0,
    "text": "چو دانسته شد چاره ساز آن زمان"
  },
  {
    "poem_id": 1348,
    "vorder": 50,
    "position": 1,
    "text": "به خیره مترس از بد بدگمان"
  },
  {
    "poem_id": 1348,
    "vorder": 51,
    "position": 0,
    "text": "شه پر منش را خوش آمد سخن"
  },
  {
    "poem_id": 1348,
    "vorder": 52,
    "position": 1,
    "text": "که آن سرو سیمین برافگند بن"
  },
  {
    "poem_id": 1348,
    "vorder": 53,
    "position": 0,
    "text": "جهان از شب تیره چون پرّ زاغ"
  },
  {
    "poem_id": 1348,
    "vorder": 54,
    "position": 1,
    "text": "همانگه سر از کوه بر زد چراغ"
  },
  {
    "poem_id": 1348,
    "vorder": 55,
    "position": 0,
    "text": "تو گفتی که بر گنبد لاژورد"
  },
  {
    "poem_id": 1348,
    "vorder": 56,
    "position": 1,
    "text": "بگسترد خورشید یاقوت زرد"
  },
  {
    "poem_id": 1348,
    "vorder": 57,
    "position": 0,
    "text": "سپهبد به هر جا که بد موبدی"
  },
  {
    "poem_id": 1348,
    "vorder": 58,
    "position": 1,
    "text": "سخن دان و بیداردل بخردی"
  },
  {
    "poem_id": 1348,
    "vorder": 59,
    "position": 0,
    "text": "ز کشور به نزدیک خویش آورید"
  },
  {
    "poem_id": 1348,
    "vorder": 60,
    "position": 1,
    "text": "بگفت آن جگرخسته خوابی که دید"
  },
  {
    "poem_id": 1348,
    "vorder": 61,
    "position": 0,
    "text": "نهانی سخن کردشان آشکار"
  },
  {
    "poem_id": 1348,
    "vorder": 62,
    "position": 1,
    "text": "ز نیک و بد و گردش روزگار"
  },
  {
    "poem_id": 1348,
    "vorder": 63,
    "position": 0,
    "text": "که بر من زمانه کی آید بسر"
  },
  {
    "poem_id": 1348,
    "vorder": 64,
    "position": 1,
    "text": "که را باشد این تاج و تخت و کمر"
  },
  {
    "poem_id": 1348,
    "vorder": 65,
    "position": 0,
    "text": "گر این راز با من بباید گشاد"
  },
  {
    "poem_id": 1348,
    "vorder": 66,
    "position": 1,
    "text": "و گر سر به خواری بباید نهاد"
  },
  {
    "poem_id": 1348,
    "vorder": 67,
    "position": 0,
    "text": "لب موبدان خشک و رخساره تر"
  },
  {
    "poem_id": 1348,
    "vorder": 68,
    "position": 1,
    "text": "زبان پر ز گفتار با یکدگر"
  },
  {
    "poem_id": 1348,
    "vorder": 69,
    "position": 0,
    "text": "که گر بودنی باز گوییم راست"
  },
  {
    "poem_id": 1348,
    "vorder": 70,
    "position": 1,
    "text": "به جانست پیکار و جان بی‌بهاست"
  },
  {
    "poem_id": 1348,
    "vorder": 71,
    "position": 0,
    "text": "و گر نشنود بودنی‌ها درست"
  },
  {
    "poem_id": 1348,
    "vorder": 72,
    "position": 1,
    "text": "بباید هم اکنون ز جان دست شست"
  },
  {
    "poem_id": 1348,
    "vorder": 73,
    "position": 0,
    "text": "سه روز اندر این کار شد روزگار"
  },
  {
    "poem_id": 1348,
    "vorder": 74,
    "position": 1,
    "text": "سخن کس نیارست کرد آشکار"
  },
  {
    "poem_id": 1348,
    "vorder": 75,
    "position": 0,
    "text": "به روز چهارم برآشفت شاه"
  },
  {
    "poem_id": 1348,
    "vorder": 76,
    "position": 1,
    "text": "بر آن موبدان نماینده راه"
  },
  {
    "poem_id": 1348,
    "vorder": 77,
    "position": 0,
    "text": "که گر زنده‌تان دار باید بسود"
  },
  {
    "poem_id": 1348,
    "vorder": 78,
    "position": 1,
    "text": "و گر بودنی‌ها بباید نمود"
  },
  {
    "poem_id": 1348,
    "vorder": 79,
    "position": 0,
    "text": "همه موبدان سرفگنده نگون"
  },
  {
    "poem_id": 1348,
    "vorder": 80,
    "position": 1,
    "text": "پر از هول دل، دیدگان پر ز خون"
  },
  {
    "poem_id": 1348,
    "vorder": 81,
    "position": 0,
    "text": "از آن نامداران بسیار هوش"
  },
  {
    "poem_id": 1348,
    "vorder": 82,
    "position": 1,
    "text": "یکی بود بینادل و تیزگوش"
  },
  {
    "poem_id": 1348,
    "vorder": 83,
    "position": 0,
    "text": "خردمند و بیدار و زیرک به نام"
  },
  {
    "poem_id": 1348,
    "vorder": 84,
    "position": 1,
    "text": "کز آن موبدان او زدی پیش گام"
  },
  {
    "poem_id": 1348,
    "vorder": 85,
    "position": 0,
    "text": "دلش تنگ‌تر گشت و ناباک شد"
  },
  {
    "poem_id": 1348,
    "vorder": 86,
    "position": 1,
    "text": "گشاده زبان پیش ضحاک شد"
  },
  {
    "poem_id": 1348,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت پردخته کن سر ز باد"
  },
  {
    "poem_id": 1348,
    "vorder": 88,
    "position": 1,
    "text": "که جز مرگ را کس ز مادر نزاد"
  },
  {
    "poem_id": 1348,
    "vorder": 89,
    "position": 0,
    "text": "جهاندار پیش از تو بسیار بود"
  },
  {
    "poem_id": 1348,
    "vorder": 90,
    "position": 1,
    "text": "که تخت مهی را سزاوار بود"
  },
  {
    "poem_id": 1348,
    "vorder": 91,
    "position": 0,
    "text": "فراوان غم و شادمانی شمرد"
  },
  {
    "poem_id": 1348,
    "vorder": 92,
    "position": 1,
    "text": "برفت و جهان دیگری را سپرد"
  },
  {
    "poem_id": 1348,
    "vorder": 93,
    "position": 0,
    "text": "اگر بارهٔ آهنینی به پای"
  },
  {
    "poem_id": 1348,
    "vorder": 94,
    "position": 1,
    "text": "سپهرت بساید نمانی به جای"
  },
  {
    "poem_id": 1348,
    "vorder": 95,
    "position": 0,
    "text": "کسی را بود زین سپس تخت تو"
  },
  {
    "poem_id": 1348,
    "vorder": 96,
    "position": 1,
    "text": "به خاک اندر آرد سر و بخت تو"
  },
  {
    "poem_id": 1348,
    "vorder": 97,
    "position": 0,
    "text": "کجا نام او آفریدون بود"
  },
  {
    "poem_id": 1348,
    "vorder": 98,
    "position": 1,
    "text": "زمین را سپهری همایون بود"
  },
  {
    "poem_id": 1348,
    "vorder": 99,
    "position": 0,
    "text": "هنوز آن سپهبد ز مادر نزاد"
  },
  {
    "poem_id": 1348,
    "vorder": 100,
    "position": 1,
    "text": "نیامد گه پرسش و سرد باد"
  },
  {
    "poem_id": 1348,
    "vorder": 101,
    "position": 0,
    "text": "چو او زاید از مادر پرهنر"
  },
  {
    "poem_id": 1348,
    "vorder": 102,
    "position": 1,
    "text": "به سان درختی شود بارور"
  },
  {
    "poem_id": 1348,
    "vorder": 103,
    "position": 0,
    "text": "به مردی رسد بر کشد سر به ماه"
  },
  {
    "poem_id": 1348,
    "vorder": 104,
    "position": 1,
    "text": "کمر جوید و تاج و تخت و کلاه"
  },
  {
    "poem_id": 1348,
    "vorder": 105,
    "position": 0,
    "text": "به بالا شود چون یکی سرو برز"
  },
  {
    "poem_id": 1348,
    "vorder": 106,
    "position": 1,
    "text": "به گردن برآرد ز پولاد گُرز"
  },
  {
    "poem_id": 1348,
    "vorder": 107,
    "position": 0,
    "text": "زند بر سرت گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1348,
    "vorder": 108,
    "position": 1,
    "text": "بگیردت زار و ببنددت خوار"
  },
  {
    "poem_id": 1348,
    "vorder": 109,
    "position": 0,
    "text": "بدو گفت ضحاک ناپاک دین"
  },
  {
    "poem_id": 1348,
    "vorder": 110,
    "position": 1,
    "text": "چرا بنددم از منش چیست کین"
  },
  {
    "poem_id": 1348,
    "vorder": 111,
    "position": 0,
    "text": "دلاور بدو گفت گر بخردی"
  },
  {
    "poem_id": 1348,
    "vorder": 112,
    "position": 1,
    "text": "کسی بی‌بهانه نسازد بدی"
  },
  {
    "poem_id": 1348,
    "vorder": 113,
    "position": 0,
    "text": "برآید به دست تو هوش پدرش"
  },
  {
    "poem_id": 1348,
    "vorder": 114,
    "position": 1,
    "text": "از آن درد گردد پر از کینه سرش"
  },
  {
    "poem_id": 1348,
    "vorder": 115,
    "position": 0,
    "text": "یکی گاو برمایه خواهد بدن"
  },
  {
    "poem_id": 1348,
    "vorder": 116,
    "position": 1,
    "text": "جهانجوی را دایه خواهد بدن"
  },
  {
    "poem_id": 1348,
    "vorder": 117,
    "position": 0,
    "text": "تبه گردد آن هم به دست تو بر"
  },
  {
    "poem_id": 1348,
    "vorder": 118,
    "position": 1,
    "text": "بدین کین کِشد گُرزهٔ گاوسر"
  },
  {
    "poem_id": 1348,
    "vorder": 119,
    "position": 0,
    "text": "چو بشنید ضحاک بگشاد گوش"
  },
  {
    "poem_id": 1348,
    "vorder": 120,
    "position": 1,
    "text": "ز تخت اندر افتاد و زو رفت هوش"
  },
  {
    "poem_id": 1348,
    "vorder": 121,
    "position": 0,
    "text": "گرانمایه از پیش تخت بلند"
  },
  {
    "poem_id": 1348,
    "vorder": 122,
    "position": 1,
    "text": "بتابید روی از نهیب گزند"
  },
  {
    "poem_id": 1348,
    "vorder": 123,
    "position": 0,
    "text": "چو آمد دل نامور باز جای"
  },
  {
    "poem_id": 1348,
    "vorder": 124,
    "position": 1,
    "text": "به تخت کیان اندر آورد پای"
  },
  {
    "poem_id": 1348,
    "vorder": 125,
    "position": 0,
    "text": "نشان فریدون به گرد جهان"
  },
  {
    "poem_id": 1348,
    "vorder": 126,
    "position": 1,
    "text": "همی باز جست آشکار و نهان"
  },
  {
