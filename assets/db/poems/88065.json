[
  {
    "poem_id": 88065,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا قارن نیک‌خواه"
  },
  {
    "poem_id": 88065,
    "vorder": 2,
    "position": 1,
    "text": "شود باز و پاسخ گزارد ز شاه"
  },
  {
    "poem_id": 88065,
    "vorder": 3,
    "position": 0,
    "text": "که این کار ما دیر و دشوار گشت"
  },
  {
    "poem_id": 88065,
    "vorder": 4,
    "position": 1,
    "text": "سخنها ز اندازه اندر گذشت"
  },
  {
    "poem_id": 88065,
    "vorder": 5,
    "position": 0,
    "text": "هنر یافته مرد سنگی به جنگ"
  },
  {
    "poem_id": 88065,
    "vorder": 6,
    "position": 1,
    "text": "نجوید گه رزم چندین درنگ"
  },
  {
    "poem_id": 88065,
    "vorder": 7,
    "position": 0,
    "text": "کنون تا خداوند خورشید و ماه"
  },
  {
    "poem_id": 88065,
    "vorder": 8,
    "position": 1,
    "text": "که را شاد دارد بدین رزمگاه"
  },
  {
    "poem_id": 88065,
    "vorder": 9,
    "position": 0,
    "text": "نخواهم ز تو اسب و دینار و گنج"
  },
  {
    "poem_id": 88065,
    "vorder": 10,
    "position": 1,
    "text": "که بر کس نماند سرای سپنج"
  },
  {
    "poem_id": 88065,
    "vorder": 11,
    "position": 0,
    "text": "به زور جهان آفرین کردگار"
  },
  {
    "poem_id": 88065,
    "vorder": 12,
    "position": 1,
    "text": "به دیهیم کاوس پروردگار"
  },
  {
    "poem_id": 88065,
    "vorder": 13,
    "position": 0,
    "text": "که چندان نمانم شما را زمان"
  },
  {
    "poem_id": 88065,
    "vorder": 14,
    "position": 1,
    "text": "که بر گل جهد تندباد خزان"
  },
  {
    "poem_id": 88065,
    "vorder": 15,
    "position": 0,
    "text": "بدان خواسته نیست ما را نیاز"
  },
  {
    "poem_id": 88065,
    "vorder": 16,
    "position": 1,
    "text": "که از جور و بیدادی آمد فراز"
  },
  {
    "poem_id": 88065,
    "vorder": 17,
    "position": 0,
    "text": "که را پشت گرمی به یزدان بود"
  },
  {
    "poem_id": 88065,
    "vorder": 18,
    "position": 1,
    "text": "همیشه دل و بخت خندان بود"
  },
  {
    "poem_id": 88065,
    "vorder": 19,
    "position": 0,
    "text": "بر و بوم و گنج و سپاهت مراست"
  },
  {
    "poem_id": 88065,
    "vorder": 20,
    "position": 1,
    "text": "همان تخت و زرین کلاهت مراست"
  },
  {
    "poem_id": 88065,
    "vorder": 21,
    "position": 0,
    "text": "پشنگ آمد و خواست از من نبرد"
  },
  {
    "poem_id": 88065,
    "vorder": 22,
    "position": 1,
    "text": "زره‌دار بی لشکر و دار و برد"
  },
  {
    "poem_id": 88065,
    "vorder": 23,
    "position": 0,
    "text": "سپیده‌دمان هست مهمان من"
  },
  {
    "poem_id": 88065,
    "vorder": 24,
    "position": 1,
    "text": "به خنجر ببیند سرافشان من"
  },
  {
    "poem_id": 88065,
    "vorder": 25,
    "position": 0,
    "text": "کسی را نخواهم ز ایران سپاه"
  },
  {
    "poem_id": 88065,
    "vorder": 26,
    "position": 1,
    "text": "که با او بگردد به آوردگاه"
  },
  {
    "poem_id": 88065,
    "vorder": 27,
    "position": 0,
    "text": "من و شیده و دشت و شمشیر تیز"
  },
  {
    "poem_id": 88065,
    "vorder": 28,
    "position": 1,
    "text": "برآرم به فرجام از او رستخیز"
  },
  {
    "poem_id": 88065,
    "vorder": 29,
    "position": 0,
    "text": "گر ایدون که پیروز گردم به جنگ"
  },
  {
    "poem_id": 88065,
    "vorder": 30,
    "position": 1,
    "text": "نسازم بر این سان که گفتی درنگ"
  },
  {
    "poem_id": 88065,
    "vorder": 31,
    "position": 0,
    "text": "مبارز خروشان کنیم از دو روی"
  },
  {
    "poem_id": 88065,
    "vorder": 32,
    "position": 1,
    "text": "ز خون دشت گردد پر از رنگ و بوی"
  },
  {
    "poem_id": 88065,
    "vorder": 33,
    "position": 0,
    "text": "از آن پس یلان را همه همگروه"
  },
  {
    "poem_id": 88065,
    "vorder": 34,
    "position": 1,
    "text": "به جنگ اندر آریم بر سان کوه"
  },
  {
    "poem_id": 88065,
    "vorder": 35,
    "position": 0,
    "text": "چو این گفت باشی به شیده بگوی"
  },
  {
    "poem_id": 88065,
    "vorder": 36,
    "position": 1,
    "text": "که ای کم خرد مهتر کامجوی"
  },
  {
    "poem_id": 88065,
    "vorder": 37,
    "position": 0,
    "text": "نه تنها تو ایدر به کام آمدی"
  },
  {
    "poem_id": 88065,
    "vorder": 38,
    "position": 1,
    "text": "نه بر جستن ننگ و نام آمدی"
  },
  {
    "poem_id": 88065,
    "vorder": 39,
    "position": 0,
    "text": "نه از بهر پیغام افراسیاب"
  },
  {
    "poem_id": 88065,
    "vorder": 40,
    "position": 1,
    "text": "که کردار بد کرد بر تو شتاب"
  },
  {
    "poem_id": 88065,
    "vorder": 41,
    "position": 0,
    "text": "جهاندارت انگیخت از انجمن"
  },
  {
    "poem_id": 88065,
    "vorder": 42,
    "position": 1,
    "text": "ستودانت ایدر بود هم کفن"
  },
  {
    "poem_id": 88065,
    "vorder": 43,
    "position": 0,
    "text": "گزند آیدت زان سر بی‌گزند"
  },
  {
    "poem_id": 88065,
    "vorder": 44,
    "position": 1,
    "text": "که از تن بریدند چون گوسفند"
  },
  {
    "poem_id": 88065,
    "vorder": 45,
    "position": 0,
    "text": "بیامد دمان قارن از نزد شاه"
  },
  {
    "poem_id": 88065,
    "vorder": 46,
    "position": 1,
    "text": "به نزد یکی آن درفش سیاه"
  },
  {
    "poem_id": 88065,
    "vorder": 47,
    "position": 0,
    "text": "سخن هرچ بشنید با او بگفت"
  },
  {
    "poem_id": 88065,
    "vorder": 48,
    "position": 1,
    "text": "نماند ایچ نیک و بد اندر نهفت"
  },
  {
    "poem_id": 88065,
    "vorder": 49,
    "position": 0,
    "text": "بشد شیده نزدیک افراسیاب"
  },
  {
    "poem_id": 88065,
    "vorder": 50,
    "position": 1,
    "text": "دلش چون بر آتش نهاده کباب"
  },
  {
    "poem_id": 88065,
    "vorder": 51,
    "position": 0,
    "text": "ببد شاه ترکان ز پاسخ دژم"
  },
  {
    "poem_id": 88065,
    "vorder": 52,
    "position": 1,
    "text": "غمی گشت و برزد یکی تیز دم"
  },
  {
    "poem_id": 88065,
    "vorder": 53,
    "position": 0,
    "text": "از آن خواب کز روزگار دراز"
  },
  {
    "poem_id": 88065,
    "vorder": 54,
    "position": 1,
    "text": "بدید و ز هر کس همی داشت راز"
  },
  {
    "poem_id": 88065,
    "vorder": 55,
    "position": 0,
    "text": "سرش گشت گردان و دل پرنهیب"
  },
  {
    "poem_id": 88065,
    "vorder": 56,
    "position": 1,
    "text": "بدانست کامد به تنگی نشیب"
  },
  {
    "poem_id": 88065,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت فردا بدین رزمگاه"
  },
  {
    "poem_id": 88065,
    "vorder": 58,
    "position": 1,
    "text": "ز افگنده مردان نیابند راه"
  },
  {
    "poem_id": 88065,
    "vorder": 59,
    "position": 0,
    "text": "به شیده چنین گفت کز بامداد"
  },
  {
    "poem_id": 88065,
    "vorder": 60,
    "position": 1,
    "text": "مکن تا دو روز ای پسر جنگ یاد"
  },
  {
    "poem_id": 88065,
    "vorder": 61,
    "position": 0,
    "text": "بدین رزم بشکست گویی دلم"
  },
  {
    "poem_id": 88065,
    "vorder": 62,
    "position": 1,
    "text": "بر آنم که دل را ز تن بگسلم"
  },
  {
    "poem_id": 88065,
    "vorder": 63,
    "position": 0,
    "text": "پسر گفت کای شاه ترکان و چین"
  },
  {
    "poem_id": 88065,
    "vorder": 64,
    "position": 1,
    "text": "دل خویش را بد مکن روز کین"
  },
  {
    "poem_id": 88065,
    "vorder": 65,
    "position": 0,
    "text": "چو خورشید فردا بر آرد درفش"
  },
  {
    "poem_id": 88065,
    "vorder": 66,
    "position": 1,
    "text": "درفشان کند روی چرخ بنفش"
  },
  {
    "poem_id": 88065,
    "vorder": 67,
    "position": 0,
    "text": "من و خسرو و دشت آوردگاه"
  },
  {
    "poem_id": 88065,
    "vorder": 68,
    "position": 1,
    "text": "برانگیزم از شاه گرد سیاه"
  }
]