[
  {
    "poem_id": 1783,
    "vorder": 1,
    "position": 0,
    "text": "وزانجا برانگیخت شبرنگ را"
  },
  {
    "poem_id": 1783,
    "vorder": 2,
    "position": 1,
    "text": "بدیدش یکی بیشه تنگ را"
  },
  {
    "poem_id": 1783,
    "vorder": 3,
    "position": 0,
    "text": "دو شیر ژیان پیش آن بیشه دید"
  },
  {
    "poem_id": 1783,
    "vorder": 4,
    "position": 1,
    "text": "کمان را به زه کرد و اندر کشید"
  },
  {
    "poem_id": 1783,
    "vorder": 5,
    "position": 0,
    "text": "بزد تیر بر سینهٔ شیر چاک"
  },
  {
    "poem_id": 1783,
    "vorder": 6,
    "position": 1,
    "text": "گذر کرد تا پر و پیکان به خاک"
  },
  {
    "poem_id": 1783,
    "vorder": 7,
    "position": 0,
    "text": "بر ماده شد تیز بگشاد دست"
  },
  {
    "poem_id": 1783,
    "vorder": 8,
    "position": 1,
    "text": "بر شیر با گردرانش ببست"
  },
  {
    "poem_id": 1783,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت کان تیر بی‌پر بود"
  },
  {
    "poem_id": 1783,
    "vorder": 10,
    "position": 1,
    "text": "نبد تیز پیکان او کر بود"
  },
  {
    "poem_id": 1783,
    "vorder": 11,
    "position": 0,
    "text": "سپاهی همی خواندند آفرین"
  },
  {
    "poem_id": 1783,
    "vorder": 12,
    "position": 1,
    "text": "که ای نامور شهریار زمین"
  },
  {
    "poem_id": 1783,
    "vorder": 13,
    "position": 0,
    "text": "ندید و نبیند کسی در جهان"
  },
  {
    "poem_id": 1783,
    "vorder": 14,
    "position": 1,
    "text": "چو تو شاه بر تخت شاهنشهان"
  },
  {
    "poem_id": 1783,
    "vorder": 15,
    "position": 0,
    "text": "چو با تیر بی‌پر تو شیرافگنی"
  },
  {
    "poem_id": 1783,
    "vorder": 16,
    "position": 1,
    "text": "پی کوه خارا ز بن برکنی"
  },
  {
    "poem_id": 1783,
    "vorder": 17,
    "position": 0,
    "text": "بدان مرغزار اندرون راند شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 18,
    "position": 1,
    "text": "ز لشکر هرانکس که بد نیک‌خواه"
  },
  {
    "poem_id": 1783,
    "vorder": 19,
    "position": 0,
    "text": "یکی بیشه دیدند پر گوسفند"
  },
  {
    "poem_id": 1783,
    "vorder": 20,
    "position": 1,
    "text": "شبانان گریزان ز بیم گزند"
  },
  {
    "poem_id": 1783,
    "vorder": 21,
    "position": 0,
    "text": "یکی سرشبان دید بهرام را"
  },
  {
    "poem_id": 1783,
    "vorder": 22,
    "position": 1,
    "text": "بر او دوید از پی نام را"
  },
  {
    "poem_id": 1783,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت بهرام کاین گوسفند"
  },
  {
    "poem_id": 1783,
    "vorder": 24,
    "position": 1,
    "text": "که آرد بدین جای ناسودمند"
  },
  {
    "poem_id": 1783,
    "vorder": 25,
    "position": 0,
    "text": "بدو سرشبان گفت کای شهریار"
  },
  {
    "poem_id": 1783,
    "vorder": 26,
    "position": 1,
    "text": "ز گیتی من آیم بدین مرغزار"
  },
  {
    "poem_id": 1783,
    "vorder": 27,
    "position": 0,
    "text": "همین گوسفندان گوهرفروش"
  },
  {
    "poem_id": 1783,
    "vorder": 28,
    "position": 1,
    "text": "به دشت اندر آوردم از کوه دوش"
  },
  {
    "poem_id": 1783,
    "vorder": 29,
    "position": 0,
    "text": "توانگر خداوند این گوسفند"
  },
  {
    "poem_id": 1783,
    "vorder": 30,
    "position": 1,
    "text": "بپیچد همی از نهیب گزند"
  },
  {
    "poem_id": 1783,
    "vorder": 31,
    "position": 0,
    "text": "به خروار با نامور گوهرست"
  },
  {
    "poem_id": 1783,
    "vorder": 32,
    "position": 1,
    "text": "همان زر و سیمست و هم زیورست"
  },
  {
    "poem_id": 1783,
    "vorder": 33,
    "position": 0,
    "text": "ندارد جز از دختری چنگ‌زن"
  },
  {
    "poem_id": 1783,
    "vorder": 34,
    "position": 1,
    "text": "سر جعد زلفش شکن بر شکن"
  },
  {
    "poem_id": 1783,
    "vorder": 35,
    "position": 0,
    "text": "نخواهد جز از دست دختر نبید"
  },
  {
    "poem_id": 1783,
    "vorder": 36,
    "position": 1,
    "text": "کسی مردم پیر ازین سان ندید"
  },
  {
    "poem_id": 1783,
    "vorder": 37,
    "position": 0,
    "text": "اگر نیستی داد بهرامشاه"
  },
  {
    "poem_id": 1783,
    "vorder": 38,
    "position": 1,
    "text": "مر او را کجا ماندی دستگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 39,
    "position": 0,
    "text": "شهنشاه گیتی نکوشد به زر"
  },
  {
    "poem_id": 1783,
    "vorder": 40,
    "position": 1,
    "text": "همان موبدش نیست بیدادگر"
  },
  {
    "poem_id": 1783,
    "vorder": 41,
    "position": 0,
    "text": "نگویی مرا کاین ددان ار که کشت"
  },
  {
    "poem_id": 1783,
    "vorder": 42,
    "position": 1,
    "text": "که او را خدای جهان باد پشت"
  },
  {
    "poem_id": 1783,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت بهرام کاین هر دو شیر"
  },
  {
    "poem_id": 1783,
    "vorder": 44,
    "position": 1,
    "text": "تبه شد به پیکان مرد دلیر"
  },
  {
    "poem_id": 1783,
    "vorder": 45,
    "position": 0,
    "text": "چو شیران جنگی بکشت او برفت"
  },
  {
    "poem_id": 1783,
    "vorder": 46,
    "position": 1,
    "text": "سواری سرافراز با یار هفت"
  },
  {
    "poem_id": 1783,
    "vorder": 47,
    "position": 0,
    "text": "کجا باشد ایوان گوهرفروش"
  },
  {
    "poem_id": 1783,
    "vorder": 48,
    "position": 1,
    "text": "پدیدار کن راه و بر ما مپوش"
  },
  {
    "poem_id": 1783,
    "vorder": 49,
    "position": 0,
    "text": "بدو سرشبان گفت ز ایدر برو"
  },
  {
    "poem_id": 1783,
    "vorder": 50,
    "position": 1,
    "text": "دهی تازه پیش اندر آیدت نو"
  },
  {
    "poem_id": 1783,
    "vorder": 51,
    "position": 0,
    "text": "به شهر آید آواز زان جایگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 52,
    "position": 1,
    "text": "به نزدیکی کاخ بهرامشاه"
  },
  {
    "poem_id": 1783,
    "vorder": 53,
    "position": 0,
    "text": "چو گردون بپوشد حریر سیاه"
  },
  {
    "poem_id": 1783,
    "vorder": 54,
    "position": 1,
    "text": "به جشن آید آن مرد با دستگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 55,
    "position": 0,
    "text": "گر ایدونک باشدت لختی درنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 56,
    "position": 1,
    "text": "به گوش آیدت نوش و آواز چنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 57,
    "position": 0,
    "text": "چو بشنید بهرام بالای خواست"
  },
  {
    "poem_id": 1783,
    "vorder": 58,
    "position": 1,
    "text": "یکی جامهٔ خسرو آرای خواست"
  },
  {
    "poem_id": 1783,
    "vorder": 59,
    "position": 0,
    "text": "جدا شد ز دستور وز لشکرش"
  },
  {
    "poem_id": 1783,
    "vorder": 60,
    "position": 1,
    "text": "همانا پر از آرزو شد سرش"
  },
  {
    "poem_id": 1783,
    "vorder": 61,
    "position": 0,
    "text": "چنین گفت با موبدان روزبه"
  },
  {
    "poem_id": 1783,
    "vorder": 62,
    "position": 1,
    "text": "که اکنون شود شاه ایران به ده"
  },
  {
    "poem_id": 1783,
    "vorder": 63,
    "position": 0,
    "text": "نشنید بدان خان گوهر فروش"
  },
  {
    "poem_id": 1783,
    "vorder": 64,
    "position": 1,
    "text": "همه سوی گفتار دارید گوش"
  },
  {
    "poem_id": 1783,
    "vorder": 65,
    "position": 0,
    "text": "بخواهد همان دخترش از پدر"
  },
  {
    "poem_id": 1783,
    "vorder": 66,
    "position": 1,
    "text": "نهد بی‌گمان بر سرش تاج زر"
  },
  {
    "poem_id": 1783,
    "vorder": 67,
    "position": 0,
    "text": "نیابد همی سیری از خفت و خیز"
  },
  {
    "poem_id": 1783,
    "vorder": 68,
    "position": 1,
    "text": "شب تیره زو جفت گیرد گریز"
  },
  {
    "poem_id": 1783,
    "vorder": 69,
    "position": 0,
    "text": "شبستان مر او را فزون از صد است"
  },
  {
    "poem_id": 1783,
    "vorder": 70,
    "position": 1,
    "text": "شهنشاه زین‌سان که باشد بد است"
  },
  {
    "poem_id": 1783,
    "vorder": 71,
    "position": 0,
    "text": "کنون نه صد و سی زن از مهتران"
  },
  {
    "poem_id": 1783,
    "vorder": 72,
    "position": 1,
    "text": "همه بر سران افسر از گوهران"
  },
  {
    "poem_id": 1783,
    "vorder": 73,
    "position": 0,
    "text": "ابا یاره و تاج و با تخت زر"
  },
  {
    "poem_id": 1783,
    "vorder": 74,
    "position": 1,
    "text": "درفشان ز دیبای رومی گهر"
  },
  {
    "poem_id": 1783,
    "vorder": 75,
    "position": 0,
    "text": "شمردست خادم به مشکوی شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 76,
    "position": 1,
    "text": "کزیشان یکی نیست بی‌دستگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 77,
    "position": 0,
    "text": "همی باژ خواهد ز هر مرز و بوم"
  },
  {
    "poem_id": 1783,
    "vorder": 78,
    "position": 1,
    "text": "به سالی پریشان رود باژ روم"
  },
  {
    "poem_id": 1783,
    "vorder": 79,
    "position": 0,
    "text": "دریغ آن بر و کتف و بالای شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 80,
    "position": 1,
    "text": "دریغ آن رخ مجلس آرای شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 81,
    "position": 0,
    "text": "نبیند چنو کس به بالای و زور"
  },
  {
    "poem_id": 1783,
    "vorder": 82,
    "position": 1,
    "text": "به یک تیر بر هم بدوزد دو گور"
  },
  {
    "poem_id": 1783,
    "vorder": 83,
    "position": 0,
    "text": "تبه گردد از خفت و خیز زنان"
  },
  {
    "poem_id": 1783,
    "vorder": 84,
    "position": 1,
    "text": "به زودی شود سست چون پرنیان"
  },
  {
    "poem_id": 1783,
    "vorder": 85,
    "position": 0,
    "text": "کند دیده تاریک و رخساره زرد"
  },
  {
    "poem_id": 1783,
    "vorder": 86,
    "position": 1,
    "text": "به تن سست گردد به لب لاژورد"
  },
  {
    "poem_id": 1783,
    "vorder": 87,
    "position": 0,
    "text": "ز بوی زنان موی گردد سپید"
  },
  {
    "poem_id": 1783,
    "vorder": 88,
    "position": 1,
    "text": "سپیدی کند در جهان ناامید"
  },
  {
    "poem_id": 1783,
    "vorder": 89,
    "position": 0,
    "text": "جوان را شود گوژ بالای راست"
  },
  {
    "poem_id": 1783,
    "vorder": 90,
    "position": 1,
    "text": "ز کار زنان چندگونه بلاست"
  },
  {
    "poem_id": 1783,
    "vorder": 91,
    "position": 0,
    "text": "به یک ماه یک بار آمیختن"
  },
  {
    "poem_id": 1783,
    "vorder": 92,
    "position": 1,
    "text": "گر افزون بود خون بود ریختن"
  },
  {
    "poem_id": 1783,
    "vorder": 93,
    "position": 0,
    "text": "همین بار از بهر فرزند را"
  },
  {
    "poem_id": 1783,
    "vorder": 94,
    "position": 1,
    "text": "بباید جوان خردمند را"
  },
  {
    "poem_id": 1783,
    "vorder": 95,
    "position": 0,
    "text": "چو افزون کنی کاهش افزون کند"
  },
  {
    "poem_id": 1783,
    "vorder": 96,
    "position": 1,
    "text": "ز سستی تن مرد بی‌خون کند"
  },
  {
    "poem_id": 1783,
    "vorder": 97,
    "position": 0,
    "text": "برفتند گویان به ایوان شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 98,
    "position": 1,
    "text": "یکی گفت خورشید گم کرد راه"
  },
  {
    "poem_id": 1783,
    "vorder": 99,
    "position": 0,
    "text": "شب تیره‌گون رفت بهرام گور"
  },
  {
    "poem_id": 1783,
    "vorder": 100,
    "position": 1,
    "text": "پرستنده یک تن ز بهر ستور"
  },
  {
    "poem_id": 1783,
    "vorder": 101,
    "position": 0,
    "text": "چو آواز چنگ اندر آمد به گوش"
  },
  {
    "poem_id": 1783,
    "vorder": 102,
    "position": 1,
    "text": "بشد شاه تا خان گوهر فروش"
  },
  {
    "poem_id": 1783,
    "vorder": 103,
    "position": 0,
    "text": "همی تاخت باره به آواز چنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 104,
    "position": 1,
    "text": "سوی خان بازارگان بی‌درنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 105,
    "position": 0,
    "text": "بزد حلقه را بر در و بار خواست"
  },
  {
    "poem_id": 1783,
    "vorder": 106,
    "position": 1,
    "text": "خداوند خورشید را یار خواست"
  },
  {
    "poem_id": 1783,
    "vorder": 107,
    "position": 0,
    "text": "پرستندهٔ مهربان گفت کیست"
  },
  {
    "poem_id": 1783,
    "vorder": 108,
    "position": 1,
    "text": "زدن در شب تیره از بهر چیست"
  },
  {
    "poem_id": 1783,
    "vorder": 109,
    "position": 0,
    "text": "چنین داد پاسخ که شبگیر شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 110,
    "position": 1,
    "text": "بیامد سوی دشت نخچیرگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 111,
    "position": 0,
    "text": "بلنگید در زیر من بارگی"
  },
  {
    "poem_id": 1783,
    "vorder": 112,
    "position": 1,
    "text": "ازو بازگشتم به بیچارگی"
  },
  {
    "poem_id": 1783,
    "vorder": 113,
    "position": 0,
    "text": "چنین اسپ و زرین ستامی به کوی"
  },
  {
    "poem_id": 1783,
    "vorder": 114,
    "position": 1,
    "text": "بدزدد کسی من شوم چاره‌جوی"
  },
  {
    "poem_id": 1783,
    "vorder": 115,
    "position": 0,
    "text": "بیامد کنیزک به دهقان بگفت"
  },
  {
    "poem_id": 1783,
    "vorder": 116,
    "position": 1,
    "text": "که مردی همی خواهد از ما نهفت"
  },
  {
    "poem_id": 1783,
    "vorder": 117,
    "position": 0,
    "text": "همی گوید اسپی به زرین ستام"
  },
  {
    "poem_id": 1783,
    "vorder": 118,
    "position": 1,
    "text": "بدزدند از ایدر شود کار خام"
  },
  {
    "poem_id": 1783,
    "vorder": 119,
    "position": 0,
    "text": "چنین داد پاسخ که بگشای در"
  },
  {
    "poem_id": 1783,
    "vorder": 120,
    "position": 1,
    "text": "به بهرام گفت اندر آی ای پسر"
  },
  {
    "poem_id": 1783,
    "vorder": 121,
    "position": 0,
    "text": "چو شاه اندر آمد چنان جای دید"
  },
  {
    "poem_id": 1783,
    "vorder": 122,
    "position": 1,
    "text": "پرستنده هر جای برپای دید"
  },
  {
    "poem_id": 1783,
    "vorder": 123,
    "position": 0,
    "text": "چنین گفت کای دادگر یک خدای"
  },
  {
    "poem_id": 1783,
    "vorder": 124,
    "position": 1,
    "text": "به خوبی توی بنده را رهنمای"
  },
  {
    "poem_id": 1783,
    "vorder": 125,
    "position": 0,
    "text": "مبادا جز از داد آیین من"
  },
  {
    "poem_id": 1783,
    "vorder": 126,
    "position": 1,
    "text": "مباد آز و گردنکشی دین من"
  },
  {
    "poem_id": 1783,
    "vorder": 127,
    "position": 0,
    "text": "همه کار و کردار من داد باد"
  },
  {
    "poem_id": 1783,
    "vorder": 128,
    "position": 1,
    "text": "دل زیردستان به ما شاد باد"
  },
  {
    "poem_id": 1783,
    "vorder": 129,
    "position": 0,
    "text": "گر افزون شود دانش و داد من"
  },
  {
    "poem_id": 1783,
    "vorder": 130,
    "position": 1,
    "text": "پس از مرگ روشن بود یاد من"
  },
  {
    "poem_id": 1783,
    "vorder": 131,
    "position": 0,
    "text": "همه زیردستان چو گوهرفروش"
  },
  {
    "poem_id": 1783,
    "vorder": 132,
    "position": 1,
    "text": "بمانند با نالهٔ چنگ و نوش"
  },
  {
    "poem_id": 1783,
    "vorder": 133,
    "position": 0,
    "text": "چو آمد به بالای ایوان رسید"
  },
  {
    "poem_id": 1783,
    "vorder": 134,
    "position": 1,
    "text": "ز در دختر میزبان را بدید"
  },
  {
    "poem_id": 1783,
    "vorder": 135,
    "position": 0,
    "text": "چو دهقان ورا دید بر پای خاست"
  },
  {
    "poem_id": 1783,
    "vorder": 136,
    "position": 1,
    "text": "بیامد خم آورد بالای راست"
  },
  {
    "poem_id": 1783,
    "vorder": 137,
    "position": 0,
    "text": "بدو گفت شب بر تو فرخنده باد"
  },
  {
    "poem_id": 1783,
    "vorder": 138,
    "position": 1,
    "text": "همه بدسگالان ترا بنده باد"
  },
  {
    "poem_id": 1783,
    "vorder": 139,
    "position": 0,
    "text": "نهالی بیفگند و مسند نهاد"
  },
  {
    "poem_id": 1783,
    "vorder": 140,
    "position": 1,
    "text": "ز دیدار او میزبان گشت شاد"
  },
  {
    "poem_id": 1783,
    "vorder": 141,
    "position": 0,
    "text": "گرانمایه خوانی بیاورد زود"
  },
  {
    "poem_id": 1783,
    "vorder": 142,
    "position": 1,
    "text": "برو خوردنیها ازان سان که بود"
  },
  {
    "poem_id": 1783,
    "vorder": 143,
    "position": 0,
    "text": "بیامد یکی مرد مهترپرست"
  },
  {
    "poem_id": 1783,
    "vorder": 144,
    "position": 1,
    "text": "بفرمود تا اسپ او را ببست"
  },
  {
    "poem_id": 1783,
    "vorder": 145,
    "position": 0,
    "text": "پرستنده را نیز خوان خواستند"
  },
  {
    "poem_id": 1783,
    "vorder": 146,
    "position": 1,
    "text": "یکی جای دیگر بیاراستند"
  },
  {
    "poem_id": 1783,
    "vorder": 147,
    "position": 0,
    "text": "همان میزبان را یکی زیرگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 148,
    "position": 1,
    "text": "نهادند و بنشست نزدیک شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 149,
    "position": 0,
    "text": "به پوزش بیاراست پس میزبان"
  },
  {
    "poem_id": 1783,
    "vorder": 150,
    "position": 1,
    "text": "به بهرام گفت ای گو مرزبان"
  },
  {
    "poem_id": 1783,
    "vorder": 151,
    "position": 0,
    "text": "توی میهمان اندرین خان من"
  },
  {
    "poem_id": 1783,
    "vorder": 152,
    "position": 1,
    "text": "فدای تو بادا تن و جان من"
  },
  {
    "poem_id": 1783,
    "vorder": 153,
    "position": 0,
    "text": "بدو گفت بهرام تیره شبان"
  },
  {
    "poem_id": 1783,
    "vorder": 154,
    "position": 1,
    "text": "که یابد چنین تازه‌رو میزبان"
  },
  {
    "poem_id": 1783,
    "vorder": 155,
    "position": 0,
    "text": "چو نان خورده شد جام باید گرفت"
  },
  {
    "poem_id": 1783,
    "vorder": 156,
    "position": 1,
    "text": "به خواب خوش آرام باید گرفت"
  },
  {
    "poem_id": 1783,
    "vorder": 157,
    "position": 0,
    "text": "به یزدان نباید بود ناسپاس"
  },
  {
    "poem_id": 1783,
    "vorder": 158,
    "position": 1,
    "text": "دل ناسپاسان بود پرهراس"
  },
  {
    "poem_id": 1783,
    "vorder": 159,
    "position": 0,
    "text": "کنیزک ببرد آبه دستان و تشت"
  },
  {
    "poem_id": 1783,
    "vorder": 160,
    "position": 1,
    "text": "ز دیدار مهمان همی خیره گشت"
  },
  {
    "poem_id": 1783,
    "vorder": 161,
    "position": 0,
    "text": "چو شد دست شسته می و جام خواست"
  },
  {
    "poem_id": 1783,
    "vorder": 162,
    "position": 1,
    "text": "به می رامش و نام و آرام خواست"
  },
  {
    "poem_id": 1783,
    "vorder": 163,
    "position": 0,
    "text": "کنیزک بیاورد جامی نبید"
  },
  {
    "poem_id": 1783,
    "vorder": 164,
    "position": 1,
    "text": "می سرخ و جام و گل و شنبلید"
  },
  {
    "poem_id": 1783,
    "vorder": 165,
    "position": 0,
    "text": "بیازید دهقان به جام از نخست"
  },
  {
    "poem_id": 1783,
    "vorder": 166,
    "position": 1,
    "text": "بخورد و به مشک و گلابش بشست"
  },
  {
    "poem_id": 1783,
    "vorder": 167,
    "position": 0,
    "text": "به بهرام داد آن دلارای جام"
  },
  {
    "poem_id": 1783,
    "vorder": 168,
    "position": 1,
    "text": "بدو گفت میخواره را چیست نام"
  },
  {
    "poem_id": 1783,
    "vorder": 169,
    "position": 0,
    "text": "هم‌اکنون بدین با تو پیمان کنم"
  },
  {
    "poem_id": 1783,
    "vorder": 170,
    "position": 1,
    "text": "به بهرام شاهت گروگان کنم"
  },
  {
    "poem_id": 1783,
    "vorder": 171,
    "position": 0,
    "text": "فراوان بخندید زو شهریار"
  },
  {
    "poem_id": 1783,
    "vorder": 172,
    "position": 1,
    "text": "بدو گفت نامم گشسپ سوار"
  },
  {
    "poem_id": 1783,
    "vorder": 173,
    "position": 0,
    "text": "من ایدر به آواز چنگ آمدم"
  },
  {
    "poem_id": 1783,
    "vorder": 174,
    "position": 1,
    "text": "نه از بهر جای درنگ آمدم"
  },
  {
    "poem_id": 1783,
    "vorder": 175,
    "position": 0,
    "text": "بدو میزبان گفت کاین دخترم"
  },
  {
    "poem_id": 1783,
    "vorder": 176,
    "position": 1,
    "text": "همی به آسمان اندر آرد سرم"
  },
  {
    "poem_id": 1783,
    "vorder": 177,
    "position": 0,
    "text": "همو میگسارست و هم چنگ‌زن"
  },
  {
    "poem_id": 1783,
    "vorder": 178,
    "position": 1,
    "text": "همان چامه گویست و لشکر شکن"
  },
  {
    "poem_id": 1783,
    "vorder": 179,
    "position": 0,
    "text": "دلارام را آرزو نام بود"
  },
  {
    "poem_id": 1783,
    "vorder": 180,
    "position": 1,
    "text": "همو میگسار و دلارام بود"
  },
  {
    "poem_id": 1783,
    "vorder": 181,
    "position": 0,
    "text": "به سرو سهی گفت بردار چنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 182,
    "position": 1,
    "text": "به پیش گشسپ آی با بوی و رنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 183,
    "position": 0,
    "text": "بیامد بر پادشا چنگ زن"
  },
  {
    "poem_id": 1783,
    "vorder": 184,
    "position": 1,
    "text": "خرامان بسان بت برهمن"
  },
  {
    "poem_id": 1783,
    "vorder": 185,
    "position": 0,
    "text": "به بهرام گفت ای گزیده سوار"
  },
  {
    "poem_id": 1783,
    "vorder": 186,
    "position": 1,
    "text": "به هر چیز مانندهٔ شهریار"
  },
  {
    "poem_id": 1783,
    "vorder": 187,
    "position": 0,
    "text": "چنان دان که این خانه بر سور تست"
  },
  {
    "poem_id": 1783,
    "vorder": 188,
    "position": 1,
    "text": "پدر میزبانست و گنجور تست"
  },
  {
    "poem_id": 1783,
    "vorder": 189,
    "position": 0,
    "text": "شبان سیه بر تو فرخنده باد"
  },
  {
    "poem_id": 1783,
    "vorder": 190,
    "position": 1,
    "text": "سرت برتر از ابر بارنده باد"
  },
  {
    "poem_id": 1783,
    "vorder": 191,
    "position": 0,
    "text": "بدو گفت بنشین و بردار چنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 192,
    "position": 1,
    "text": "یکی چامه باید مرا بی‌درنگ"
  },
  {
    "poem_id": 1783,
    "vorder": 193,
    "position": 0,
    "text": "شود ماهیار ایدر امشب جوان"
  },
  {
    "poem_id": 1783,
    "vorder": 194,
    "position": 1,
    "text": "گروگان کند پیش مهمان روان"
  },
  {
    "poem_id": 1783,
    "vorder": 195,
    "position": 0,
    "text": "زن چنگ‌زن چنگ در بر گرفت"
  },
  {
    "poem_id": 1783,
    "vorder": 196,
    "position": 1,
    "text": "نخستین خروش مغان درگرفت"
  },
  {
    "poem_id": 1783,
    "vorder": 197,
    "position": 0,
    "text": "دگر چامه را باب خود ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 198,
    "position": 1,
    "text": "تو گفتی بنالد همی چنگ زار"
  },
  {
    "poem_id": 1783,
    "vorder": 199,
    "position": 0,
    "text": "چو رود بریشم سخن‌گوی گشت"
  },
  {
    "poem_id": 1783,
    "vorder": 200,
    "position": 1,
    "text": "همه خانهٔ وی سمن بوی گشت"
  },
  {
    "poem_id": 1783,
    "vorder": 201,
    "position": 0,
    "text": "پدر را چنین گفت کای ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 202,
    "position": 1,
    "text": "چو سرو سهی بر لب جویبار"
  },
  {
    "poem_id": 1783,
    "vorder": 203,
    "position": 0,
    "text": "چو کافور کرده سر مشکبوی"
  },
  {
    "poem_id": 1783,
    "vorder": 204,
    "position": 1,
    "text": "زبان گرم‌گوی و دل آزرم جوی"
  },
  {
    "poem_id": 1783,
    "vorder": 205,
    "position": 0,
    "text": "همیشه بداندیشت آزرده باد"
  },
  {
    "poem_id": 1783,
    "vorder": 206,
    "position": 1,
    "text": "به دانش روان تو پرورده باد"
  },
  {
    "poem_id": 1783,
    "vorder": 207,
    "position": 0,
    "text": "توی چون فریدون آزاده خوی"
  },
  {
    "poem_id": 1783,
    "vorder": 208,
    "position": 1,
    "text": "منم چون پرستار نام آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 209,
    "position": 0,
    "text": "ز مهمان چنان شاد گشتم که شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 210,
    "position": 1,
    "text": "به جنگ ا ندرون چیره بیند سپاه"
  },
  {
    "poem_id": 1783,
    "vorder": 211,
    "position": 0,
    "text": "چو این گفته شد سوی مهمان گذشت"
  },
  {
    "poem_id": 1783,
    "vorder": 212,
    "position": 1,
    "text": "ابا چامه و چنگ نالان گذشت"
  },
  {
    "poem_id": 1783,
    "vorder": 213,
    "position": 0,
    "text": "به مهمان چنین گفت کای شاه‌فش"
  },
  {
    "poem_id": 1783,
    "vorder": 214,
    "position": 1,
    "text": "بلنداختر و یک‌دل و کینه‌کش"
  },
  {
    "poem_id": 1783,
    "vorder": 215,
    "position": 0,
    "text": "کسی کو ندیدست بهرام را"
  },
  {
    "poem_id": 1783,
    "vorder": 216,
    "position": 1,
    "text": "خنیده سوار دلارام را"
  },
  {
    "poem_id": 1783,
    "vorder": 217,
    "position": 0,
    "text": "نگه کرد باید به روی تو بس"
  },
  {
    "poem_id": 1783,
    "vorder": 218,
    "position": 1,
    "text": "جز او را نمانی ز لشکر به کس"
  },
  {
    "poem_id": 1783,
    "vorder": 219,
    "position": 0,
    "text": "میانت چو غروست و بالا چو سرو"
  },
  {
    "poem_id": 1783,
    "vorder": 220,
    "position": 1,
    "text": "خرامان شده سرو همچون تذرو"
  },
  {
    "poem_id": 1783,
    "vorder": 221,
    "position": 0,
    "text": "به دل نره شیر و به تن ژنده پیل"
  },
  {
    "poem_id": 1783,
    "vorder": 222,
    "position": 1,
    "text": "بناورد خشت افگنی بر دو میل"
  },
  {
    "poem_id": 1783,
    "vorder": 223,
    "position": 0,
    "text": "رخانت به گلنار ماند درست"
  },
  {
    "poem_id": 1783,
    "vorder": 224,
    "position": 1,
    "text": "تو گویی به می برگ گل را بشست"
  },
  {
    "poem_id": 1783,
    "vorder": 225,
    "position": 0,
    "text": "دو بازو به کردار ران هیون"
  },
  {
    "poem_id": 1783,
    "vorder": 226,
    "position": 1,
    "text": "به پای اندر آری که بیستون"
  },
  {
    "poem_id": 1783,
    "vorder": 227,
    "position": 0,
    "text": "تو آنی کجا چشم کس چون تو مرد"
  },
  {
    "poem_id": 1783,
    "vorder": 228,
    "position": 1,
    "text": "ندید و نبیند به روز نبرد"
  },
  {
    "poem_id": 1783,
    "vorder": 229,
    "position": 0,
    "text": "تن آرزو خاک پای تو باد"
  },
  {
    "poem_id": 1783,
    "vorder": 230,
    "position": 1,
    "text": "همه‌ساله زنده برای تو باد"
  },
  {
    "poem_id": 1783,
    "vorder": 231,
    "position": 0,
    "text": "جهاندار ازان چامه و چنگ اوی"
  },
  {
    "poem_id": 1783,
    "vorder": 232,
    "position": 1,
    "text": "ز دیدار و بالا و آهنگ اوی"
  },
  {
    "poem_id": 1783,
    "vorder": 233,
    "position": 0,
    "text": "بروبر ازان گونه شد مبتلا"
  },
  {
    "poem_id": 1783,
    "vorder": 234,
    "position": 1,
    "text": "که گفتی دلش گشت گنج بلا"
  },
  {
    "poem_id": 1783,
    "vorder": 235,
    "position": 0,
    "text": "چو در پیش او مست شد ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 236,
    "position": 1,
    "text": "چنین گفت با میزبان شهریار"
  },
  {
    "poem_id": 1783,
    "vorder": 237,
    "position": 0,
    "text": "که دختر به من ده به آیین و دین"
  },
  {
    "poem_id": 1783,
    "vorder": 238,
    "position": 1,
    "text": "چو خواهی که یابی به داد آفرین"
  },
  {
    "poem_id": 1783,
    "vorder": 239,
    "position": 0,
    "text": "چنین گفت با آرزو ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 240,
    "position": 1,
    "text": "کزین شیردل چند خواهی نثار"
  },
  {
    "poem_id": 1783,
    "vorder": 241,
    "position": 0,
    "text": "نگه کن بدو تا پسند آیدت"
  },
  {
    "poem_id": 1783,
    "vorder": 242,
    "position": 1,
    "text": "بر آسودگی سودمند آیدت"
  },
  {
    "poem_id": 1783,
    "vorder": 243,
    "position": 0,
    "text": "چنین گفت با ماهیار آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 244,
    "position": 1,
    "text": "که ای باب آزاده و نیک خوی"
  },
  {
    "poem_id": 1783,
    "vorder": 245,
    "position": 0,
    "text": "مرا گر همی داد خواهی به کس"
  },
  {
    "poem_id": 1783,
    "vorder": 246,
    "position": 1,
    "text": "همالم گشسپ سوارست و بس"
  },
  {
    "poem_id": 1783,
    "vorder": 247,
    "position": 0,
    "text": "تو گویی به بهرام ماند همی"
  },
  {
    "poem_id": 1783,
    "vorder": 248,
    "position": 1,
    "text": "چو جانست و با او نشستن دمی"
  },
  {
    "poem_id": 1783,
    "vorder": 249,
    "position": 0,
    "text": "به گفتار دختر بسنده نکرد"
  },
  {
    "poem_id": 1783,
    "vorder": 250,
    "position": 1,
    "text": "به بهرام گفت ای سوار نبرد"
  },
  {
    "poem_id": 1783,
    "vorder": 251,
    "position": 0,
    "text": "به ژرفی نگه کن سراپای اوی"
  },
  {
    "poem_id": 1783,
    "vorder": 252,
    "position": 1,
    "text": "همان دانش و کوشش و رای اوی"
  },
  {
    "poem_id": 1783,
    "vorder": 253,
    "position": 0,
    "text": "نگه کن بدو تا پسند تو هست"
  },
  {
    "poem_id": 1783,
    "vorder": 254,
    "position": 1,
    "text": "ازو آگهی بهترست ار نشست"
  },
  {
    "poem_id": 1783,
    "vorder": 255,
    "position": 0,
    "text": "بدین نیکوی نیز درویش نیست"
  },
  {
    "poem_id": 1783,
    "vorder": 256,
    "position": 1,
    "text": "به گفتن مرا رای کم‌بیش نیست"
  },
  {
    "poem_id": 1783,
    "vorder": 257,
    "position": 0,
    "text": "اگر بشمری گوهر ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 258,
    "position": 1,
    "text": "فزون آید از بدرهٔ شهریار"
  },
  {
    "poem_id": 1783,
    "vorder": 259,
    "position": 0,
    "text": "گر او را همی بایدت جام‌گیر"
  },
  {
    "poem_id": 1783,
    "vorder": 260,
    "position": 1,
    "text": "مکن سرسری امشب آرام‌گیر"
  },
  {
    "poem_id": 1783,
    "vorder": 261,
    "position": 0,
    "text": "به مستی بزرگان نبستند بند"
  },
  {
    "poem_id": 1783,
    "vorder": 262,
    "position": 1,
    "text": "به ویژه کسی کو بود ارجمند"
  },
  {
    "poem_id": 1783,
    "vorder": 263,
    "position": 0,
    "text": "بمان تا برآرد سپهر آفتاب"
  },
  {
    "poem_id": 1783,
    "vorder": 264,
    "position": 1,
    "text": "سر نامداران برآید ز خواب"
  },
  {
    "poem_id": 1783,
    "vorder": 265,
    "position": 0,
    "text": "بیاریم پیران داننده را"
  },
  {
    "poem_id": 1783,
    "vorder": 266,
    "position": 1,
    "text": "شکیبا دل و چیز خواننده را"
  },
  {
    "poem_id": 1783,
    "vorder": 267,
    "position": 0,
    "text": "شب تیره از رسم بیرون بود"
  },
  {
    "poem_id": 1783,
    "vorder": 268,
    "position": 1,
    "text": "نه آیین شاه آفریدون بود"
  },
  {
    "poem_id": 1783,
    "vorder": 269,
    "position": 0,
    "text": "نه فرخ بود مست زن خواستن"
  },
  {
    "poem_id": 1783,
    "vorder": 270,
    "position": 1,
    "text": "وگر نیز کاری نو آراستن"
  },
  {
    "poem_id": 1783,
    "vorder": 271,
    "position": 0,
    "text": "بدو گفت بهرام کاین بیهده‌ست"
  },
  {
    "poem_id": 1783,
    "vorder": 272,
    "position": 1,
    "text": "زدن فال بد رای و راه به دست"
  },
  {
    "poem_id": 1783,
    "vorder": 273,
    "position": 0,
    "text": "پسند منست امشب این چنگ‌زن"
  },
  {
    "poem_id": 1783,
    "vorder": 274,
    "position": 1,
    "text": "تو این فال بد تا توانی مزن"
  },
  {
    "poem_id": 1783,
    "vorder": 275,
    "position": 0,
    "text": "چنین گفت با دخترش آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 276,
    "position": 1,
    "text": "پسندیدی او را به گفتار و خوی"
  },
  {
    "poem_id": 1783,
    "vorder": 277,
    "position": 0,
    "text": "بدو گفت آری پسندیده‌ام"
  },
  {
    "poem_id": 1783,
    "vorder": 278,
    "position": 1,
    "text": "به جان و به دل هست چون دیده‌ام"
  },
  {
    "poem_id": 1783,
    "vorder": 279,
    "position": 0,
    "text": "بکن کار زان پس به یزدان سپار"
  },
  {
    "poem_id": 1783,
    "vorder": 280,
    "position": 1,
    "text": "نه گردون به جنگست با ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 281,
    "position": 0,
    "text": "بدو گفت کاکنون تو جفت ویی"
  },
  {
    "poem_id": 1783,
    "vorder": 282,
    "position": 1,
    "text": "چنان دان که اندر نهفت ویی"
  },
  {
    "poem_id": 1783,
    "vorder": 283,
    "position": 0,
    "text": "بدو داد و بهرام گورش بخواست"
  },
  {
    "poem_id": 1783,
    "vorder": 284,
    "position": 1,
    "text": "چو شب روز شد کار او گشت راست"
  },
  {
    "poem_id": 1783,
    "vorder": 285,
    "position": 0,
    "text": "سوی حجرهٔ خویش رفت آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 286,
    "position": 1,
    "text": "سرایش همه خفته بد چار سوی"
  },
  {
    "poem_id": 1783,
    "vorder": 287,
    "position": 0,
    "text": "بیامد به جای دگر ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 288,
    "position": 1,
    "text": "همی ساخت کار گشسپ سوار"
  },
  {
    "poem_id": 1783,
    "vorder": 289,
    "position": 0,
    "text": "پرستنده را گفت درها ببند"
  },
  {
    "poem_id": 1783,
    "vorder": 290,
    "position": 1,
    "text": "یکی را بتاز از پس گوسفند"
  },
  {
    "poem_id": 1783,
    "vorder": 291,
    "position": 0,
    "text": "نباید که آرند خوان بی‌بره"
  },
  {
    "poem_id": 1783,
    "vorder": 292,
    "position": 1,
    "text": "بره نیز پرورده باید سره"
  },
  {
    "poem_id": 1783,
    "vorder": 293,
    "position": 0,
    "text": "چو بیدار گردد فقاع و یخ آر"
  },
  {
    "poem_id": 1783,
    "vorder": 294,
    "position": 1,
    "text": "همی باش پیش گشسپ سوار"
  },
  {
    "poem_id": 1783,
    "vorder": 295,
    "position": 0,
    "text": "یکی جام کافور بر با گلاب"
  },
  {
    "poem_id": 1783,
    "vorder": 296,
    "position": 1,
    "text": "چنان کن که بویا بود جای خواب"
  },
  {
    "poem_id": 1783,
    "vorder": 297,
    "position": 0,
    "text": "من از جام می همچنانم که دوش"
  },
  {
    "poem_id": 1783,
    "vorder": 298,
    "position": 1,
    "text": "نتابد می این پیر گوهر فروش"
  },
  {
    "poem_id": 1783,
    "vorder": 299,
    "position": 0,
    "text": "بگفت این و چادر به سر برکشید"
  },
  {
    "poem_id": 1783,
    "vorder": 300,
    "position": 1,
    "text": "تن‌آسانی و خواب در بر کشید"
  },
  {
    "poem_id": 1783,
    "vorder": 301,
    "position": 0,
    "text": "چو خورشید تابنده بفراخت تاج"
  },
  {
    "poem_id": 1783,
    "vorder": 302,
    "position": 1,
    "text": "زمین شد به کردار دریای عاج"
  },
  {
    "poem_id": 1783,
    "vorder": 303,
    "position": 0,
    "text": "پرستنده تازانه شهریار"
  },
  {
    "poem_id": 1783,
    "vorder": 304,
    "position": 1,
    "text": "بیاویخت از خانهٔ ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 305,
    "position": 0,
    "text": "سپه را ز سالار گردنکشان"
  },
  {
    "poem_id": 1783,
    "vorder": 306,
    "position": 1,
    "text": "بجستند زان تازیانه نشان"
  },
  {
    "poem_id": 1783,
    "vorder": 307,
    "position": 0,
    "text": "سپاه انجمن شد به درگاه بر"
  },
  {
    "poem_id": 1783,
    "vorder": 308,
    "position": 1,
    "text": "کجا همچنان بر در شاه‌بر"
  },
  {
    "poem_id": 1783,
    "vorder": 309,
    "position": 0,
    "text": "هرانکس که تازانه دانست باز"
  },
  {
    "poem_id": 1783,
    "vorder": 310,
    "position": 1,
    "text": "برفتند و بردند پیشش نماز"
  },
  {
    "poem_id": 1783,
    "vorder": 311,
    "position": 0,
    "text": "چو دربان بدید آن سپاه‌گران"
  },
  {
    "poem_id": 1783,
    "vorder": 312,
    "position": 1,
    "text": "کمردار بسیار و ژوپین وران"
  },
  {
    "poem_id": 1783,
    "vorder": 313,
    "position": 0,
    "text": "بیامد بر خفته برسان گرد"
  },
  {
    "poem_id": 1783,
    "vorder": 314,
    "position": 1,
    "text": "سر پیر از خواب بیدار کرد"
  },
  {
    "poem_id": 1783,
    "vorder": 315,
    "position": 0,
    "text": "بدو گفت برخیز و بگشای دست"
  },
  {
    "poem_id": 1783,
    "vorder": 316,
    "position": 1,
    "text": "نه هنگام خوابست و جای نشست"
  },
  {
    "poem_id": 1783,
    "vorder": 317,
    "position": 0,
    "text": "که شاه جهانست مهمان تو"
  },
  {
    "poem_id": 1783,
    "vorder": 318,
    "position": 1,
    "text": "بدین بی‌نوا خانه و مان تو"
  },
  {
    "poem_id": 1783,
    "vorder": 319,
    "position": 0,
    "text": "یکایک دل مرد گوهرفروش"
  },
  {
    "poem_id": 1783,
    "vorder": 320,
    "position": 1,
    "text": "ز گفتار دربان برآمد به جوش"
  },
  {
    "poem_id": 1783,
    "vorder": 321,
    "position": 0,
    "text": "بدو گفت کاین را چه گویی همی"
  },
  {
    "poem_id": 1783,
    "vorder": 322,
    "position": 1,
    "text": "پی شهریاران چه جویی همی"
  },
  {
    "poem_id": 1783,
    "vorder": 323,
    "position": 0,
    "text": "همان چو ز گوینده بشنید مست"
  },
  {
    "poem_id": 1783,
    "vorder": 324,
    "position": 1,
    "text": "خروشان ازانجای برپای جست"
  },
  {
    "poem_id": 1783,
    "vorder": 325,
    "position": 0,
    "text": "ز دربان برآشفت و گفت این سخن"
  },
  {
    "poem_id": 1783,
    "vorder": 326,
    "position": 1,
    "text": "نگوید خردمند مرد کهن"
  },
  {
    "poem_id": 1783,
    "vorder": 327,
    "position": 0,
    "text": "پرستنده گفت ای جهاندیده مرد"
  },
  {
    "poem_id": 1783,
    "vorder": 328,
    "position": 1,
    "text": "ترا بر زمین شاه ایران که کرد"
  },
  {
    "poem_id": 1783,
    "vorder": 329,
    "position": 0,
    "text": "بیامد پرستنده هنگام روز"
  },
  {
    "poem_id": 1783,
    "vorder": 330,
    "position": 1,
    "text": "که پیدا نبد هور گیتی فروز"
  },
  {
    "poem_id": 1783,
    "vorder": 331,
    "position": 0,
    "text": "یکی تازیانه به زر تافته"
  },
  {
    "poem_id": 1783,
    "vorder": 332,
    "position": 1,
    "text": "به هرجای گوهر برو بافته"
  },
  {
    "poem_id": 1783,
    "vorder": 333,
    "position": 0,
    "text": "بیاویخت از پیش درگاه ما"
  },
  {
    "poem_id": 1783,
    "vorder": 334,
    "position": 1,
    "text": "بدان سو که باشد گذرگاه ما"
  },
  {
    "poem_id": 1783,
    "vorder": 335,
    "position": 0,
    "text": "ز دربان چو بشنید یکسر سخن"
  },
  {
    "poem_id": 1783,
    "vorder": 336,
    "position": 1,
    "text": "بپیچید بیدار مرد کهن"
  },
  {
    "poem_id": 1783,
    "vorder": 337,
    "position": 0,
    "text": "که من دوش پیش شهنشاه مست"
  },
  {
    "poem_id": 1783,
    "vorder": 338,
    "position": 1,
    "text": "چرا بودم و دخترم می پرست"
  },
  {
    "poem_id": 1783,
    "vorder": 339,
    "position": 0,
    "text": "بیامد سوی حجرهٔ آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 340,
    "position": 1,
    "text": "بدو گفت کای ماه آزاده‌خوی"
  },
  {
    "poem_id": 1783,
    "vorder": 341,
    "position": 0,
    "text": "شهنشاه بهرام بود آنک دوش"
  },
  {
    "poem_id": 1783,
    "vorder": 342,
    "position": 1,
    "text": "بیامد سوی خان گوهرفروش"
  },
  {
    "poem_id": 1783,
    "vorder": 343,
    "position": 0,
    "text": "همی آمد از دشت نخچیرگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 344,
    "position": 1,
    "text": "عنان تافتست از کهن دژ به راه"
  },
  {
    "poem_id": 1783,
    "vorder": 345,
    "position": 0,
    "text": "کنون خیز و دیبای چینی بپوش"
  },
  {
    "poem_id": 1783,
    "vorder": 346,
    "position": 1,
    "text": "بنه بر سر افسر چنان هم که دوش"
  },
  {
    "poem_id": 1783,
    "vorder": 347,
    "position": 0,
    "text": "نثارش کن از گوهر شاهوار"
  },
  {
    "poem_id": 1783,
    "vorder": 348,
    "position": 1,
    "text": "سه یاقوت سرخ از در شهریار"
  },
  {
    "poem_id": 1783,
    "vorder": 349,
    "position": 0,
    "text": "چو بینی رخ شاه خورشیدفش"
  },
  {
    "poem_id": 1783,
    "vorder": 350,
    "position": 1,
    "text": "دو تایی برو دست کرده بکش"
  },
  {
    "poem_id": 1783,
    "vorder": 351,
    "position": 0,
    "text": "مبین مر ورا چشم در پیش دار"
  },
  {
    "poem_id": 1783,
    "vorder": 352,
    "position": 1,
    "text": "ورا چون روان و تن خویش دار"
  },
  {
    "poem_id": 1783,
    "vorder": 353,
    "position": 0,
    "text": "چو پرسدت با او سخن نرم‌گوی"
  },
  {
    "poem_id": 1783,
    "vorder": 354,
    "position": 1,
    "text": "سخنهای با شرم و بازرم گوی"
  },
  {
    "poem_id": 1783,
    "vorder": 355,
    "position": 0,
    "text": "من اکنون نیایم اگر خواندم"
  },
  {
    "poem_id": 1783,
    "vorder": 356,
    "position": 1,
    "text": "به جای پرستنده بنشاندم"
  },
  {
    "poem_id": 1783,
    "vorder": 357,
    "position": 0,
    "text": "بسان همالان نشستم به خوان"
  },
  {
    "poem_id": 1783,
    "vorder": 358,
    "position": 1,
    "text": "که اندر تنم خرد با استخوان"
  },
  {
    "poem_id": 1783,
    "vorder": 359,
    "position": 0,
    "text": "که من نیز گستاخ گشتم به شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 360,
    "position": 1,
    "text": "به پیر و جوان از می آید گناه"
  },
  {
    "poem_id": 1783,
    "vorder": 361,
    "position": 0,
    "text": "هم‌انگه یکی بنده آمد دوان"
  },
  {
    "poem_id": 1783,
    "vorder": 362,
    "position": 1,
    "text": "که بیدار شد شاه روشن‌روان"
  },
  {
    "poem_id": 1783,
    "vorder": 363,
    "position": 0,
    "text": "چو بیدار شد ایمن و تن‌درست"
  },
  {
    "poem_id": 1783,
    "vorder": 364,
    "position": 1,
    "text": "به باغ اندر آمد سر و تن بشست"
  },
  {
    "poem_id": 1783,
    "vorder": 365,
    "position": 0,
    "text": "نیایش کنان پیش خورشید شد"
  },
  {
    "poem_id": 1783,
    "vorder": 366,
    "position": 1,
    "text": "ز یزدان دلی پر ز امید شد"
  },
  {
    "poem_id": 1783,
    "vorder": 367,
    "position": 0,
    "text": "وزانجا بیامد به جای نشست"
  },
  {
    "poem_id": 1783,
    "vorder": 368,
    "position": 1,
    "text": "یکی جام می خواست از می پرست"
  },
  {
    "poem_id": 1783,
    "vorder": 369,
    "position": 0,
    "text": "چو از کهتران آگهی یافت شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 370,
    "position": 1,
    "text": "بفرمودشان بازگشتن به راه"
  },
  {
    "poem_id": 1783,
    "vorder": 371,
    "position": 0,
    "text": "بفرمود تا رفت پیش آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 372,
    "position": 1,
    "text": "همی بودش از آرزوی آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 373,
    "position": 0,
    "text": "برفت آرزو با می و با نثار"
  },
  {
    "poem_id": 1783,
    "vorder": 374,
    "position": 1,
    "text": "پرستنده با تاج و با گوشوار"
  },
  {
    "poem_id": 1783,
    "vorder": 375,
    "position": 0,
    "text": "دو تا گشت و اندر زمین بوس داد"
  },
  {
    "poem_id": 1783,
    "vorder": 376,
    "position": 1,
    "text": "بخندید زو شاه و برگشت شاد"
  },
  {
    "poem_id": 1783,
    "vorder": 377,
    "position": 0,
    "text": "بدو گفت شاه این کجا داشتی"
  },
  {
    "poem_id": 1783,
    "vorder": 378,
    "position": 1,
    "text": "مرا مست کردی و بگذاشتی"
  },
  {
    "poem_id": 1783,
    "vorder": 379,
    "position": 0,
    "text": "همان چامه و چنگ ما را بس است"
  },
  {
    "poem_id": 1783,
    "vorder": 380,
    "position": 1,
    "text": "نثار زنان بهر دیگر کس است"
  },
  {
    "poem_id": 1783,
    "vorder": 381,
    "position": 0,
    "text": "بیار آنک گفتی ز نخچیرگاه"
  },
  {
    "poem_id": 1783,
    "vorder": 382,
    "position": 1,
    "text": "ز رزم و سر نیزه و زخم شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 383,
    "position": 0,
    "text": "ازان پس بدو گفت گوهرفروش"
  },
  {
    "poem_id": 1783,
    "vorder": 384,
    "position": 1,
    "text": "کجا شد که ما مست گشتیم دوش"
  },
  {
    "poem_id": 1783,
    "vorder": 385,
    "position": 0,
    "text": "چو بشنید دختر پدر را بخواند"
  },
  {
    "poem_id": 1783,
    "vorder": 386,
    "position": 1,
    "text": "همی از دل شاه خیره بماند"
  },
  {
    "poem_id": 1783,
    "vorder": 387,
    "position": 0,
    "text": "بیامد پدر دست کرده به کش"
  },
  {
    "poem_id": 1783,
    "vorder": 388,
    "position": 1,
    "text": "به پیش شهنشاه خورشیدفش"
  },
  {
    "poem_id": 1783,
    "vorder": 389,
    "position": 0,
    "text": "بدو گفت شاها ردا بخردا"
  },
  {
    "poem_id": 1783,
    "vorder": 390,
    "position": 1,
    "text": "بزرگا سترگا گوا موبدا"
  },
  {
    "poem_id": 1783,
    "vorder": 391,
    "position": 0,
    "text": "کسی کو خرد دارد و باهشی"
  },
  {
    "poem_id": 1783,
    "vorder": 392,
    "position": 1,
    "text": "نباید گزیدن جز از خامشی"
  },
  {
    "poem_id": 1783,
    "vorder": 393,
    "position": 0,
    "text": "ز نادانی آمد گنهکاریم"
  },
  {
    "poem_id": 1783,
    "vorder": 394,
    "position": 1,
    "text": "گمانم که دیوانه پنداریم"
  },
  {
    "poem_id": 1783,
    "vorder": 395,
    "position": 0,
    "text": "سزد گر ببخشی گناه مرا"
  },
  {
    "poem_id": 1783,
    "vorder": 396,
    "position": 1,
    "text": "درفشان کنی روز و ماه مرا"
  },
  {
    "poem_id": 1783,
    "vorder": 397,
    "position": 0,
    "text": "منم بر درت بندهٔ بی‌خرد"
  },
  {
    "poem_id": 1783,
    "vorder": 398,
    "position": 1,
    "text": "شهنشاهم از بخردان نشمرد"
  },
  {
    "poem_id": 1783,
    "vorder": 399,
    "position": 0,
    "text": "چنین داد پاسخ که از مرد مست"
  },
  {
    "poem_id": 1783,
    "vorder": 400,
    "position": 1,
    "text": "خردمند چیزی نگیرد به دست"
  },
  {
    "poem_id": 1783,
    "vorder": 401,
    "position": 0,
    "text": "کسی را که می انده آرد به روی"
  },
  {
    "poem_id": 1783,
    "vorder": 402,
    "position": 1,
    "text": "نباید که یابد ز می رنگ و بوی"
  },
  {
    "poem_id": 1783,
    "vorder": 403,
    "position": 0,
    "text": "به مستی ندیدم ز تو بدخوی"
  },
  {
    "poem_id": 1783,
    "vorder": 404,
    "position": 1,
    "text": "همی ز آرزو این سخن بشنوی"
  },
  {
    "poem_id": 1783,
    "vorder": 405,
    "position": 0,
    "text": "تو پوزش بران کن که تا چنگ زن"
  },
  {
    "poem_id": 1783,
    "vorder": 406,
    "position": 1,
    "text": "بگوید همان لاله اندر سمن"
  },
  {
    "poem_id": 1783,
    "vorder": 407,
    "position": 0,
    "text": "بگوید یکی تا بدان می خوریم"
  },
  {
    "poem_id": 1783,
    "vorder": 408,
    "position": 1,
    "text": "پی روز ناآمده نشمریم"
  },
  {
    "poem_id": 1783,
    "vorder": 409,
    "position": 0,
    "text": "زمین بوسه داد آن زمان ماهیار"
  },
  {
    "poem_id": 1783,
    "vorder": 410,
    "position": 1,
    "text": "بیاورد خوان و برآراست کار"
  },
  {
    "poem_id": 1783,
    "vorder": 411,
    "position": 0,
    "text": "بزرگان که بودند بر در به پای"
  },
  {
    "poem_id": 1783,
    "vorder": 412,
    "position": 1,
    "text": "بیاوردشان مرد پاکیزه‌رای"
  },
  {
    "poem_id": 1783,
    "vorder": 413,
    "position": 0,
    "text": "سوی حجرهٔ خویش رفت آرزوی"
  },
  {
    "poem_id": 1783,
    "vorder": 414,
    "position": 1,
    "text": "ز مهمان بیگانه پرچین بَروی"
  },
  {
    "poem_id": 1783,
    "vorder": 415,
    "position": 0,
    "text": "همی بود تا چرخ پوشد سیاه"
  },
  {
    "poem_id": 1783,
    "vorder": 416,
    "position": 1,
    "text": "ستاره پدید آید از گرد ماه"
  },
  {
    "poem_id": 1783,
    "vorder": 417,
    "position": 0,
    "text": "چو نان خورده شد آرزو را بخواند"
  },
  {
    "poem_id": 1783,
    "vorder": 418,
    "position": 1,
    "text": "به کرسی زر پیکرش برنشاند"
  },
  {
    "poem_id": 1783,
    "vorder": 419,
    "position": 0,
    "text": "بفرمود تا چنگ برداشت ماه"
  },
  {
    "poem_id": 1783,
    "vorder": 420,
    "position": 1,
    "text": "بدان چامه کز پیش فرمود شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 421,
    "position": 0,
    "text": "چنین گفت کای شهریار دلیر"
  },
  {
    "poem_id": 1783,
    "vorder": 422,
    "position": 1,
    "text": "که بگذارد از نام تو بیشه شیر"
  },
  {
    "poem_id": 1783,
    "vorder": 423,
    "position": 0,
    "text": "توی شاه پیروز و لشکرشکن"
  },
  {
    "poem_id": 1783,
    "vorder": 424,
    "position": 1,
    "text": "همان رویه چون لاله اندر چمن"
  },
  {
    "poem_id": 1783,
    "vorder": 425,
    "position": 0,
    "text": "به بالای تو بر زمین شاه نیست"
  },
  {
    "poem_id": 1783,
    "vorder": 426,
    "position": 1,
    "text": "به دیدار تو بر فلک ماه نیست"
  },
  {
    "poem_id": 1783,
    "vorder": 427,
    "position": 0,
    "text": "سپاهی که بیند سپاه ترا"
  },
  {
    "poem_id": 1783,
    "vorder": 428,
    "position": 1,
    "text": "به جنگ اندر آوردگاه ترا"
  },
  {
    "poem_id": 1783,
    "vorder": 429,
    "position": 0,
    "text": "بدرد دل و مغزشان از نهیب"
  },
  {
    "poem_id": 1783,
    "vorder": 430,
    "position": 1,
    "text": "بلندی ندانند باز از نشیب"
  },
  {
    "poem_id": 1783,
    "vorder": 431,
    "position": 0,
    "text": "هم‌انگه چو از باده خرم شدند"
  },
  {
    "poem_id": 1783,
    "vorder": 432,
    "position": 1,
    "text": "ز خردک به جام دمادم شدند"
  },
  {
    "poem_id": 1783,
    "vorder": 433,
    "position": 0,
    "text": "بیامد بر پادشا روزبه"
  },
  {
    "poem_id": 1783,
    "vorder": 434,
    "position": 1,
    "text": "گزیدند جایی مر او را به ده"
  },
  {
    "poem_id": 1783,
    "vorder": 435,
    "position": 0,
    "text": "بفرمود بهرام خادم چهل"
  },
  {
    "poem_id": 1783,
    "vorder": 436,
    "position": 1,
    "text": "همه ماه‌چهر و همه دلگسل"
  },
  {
    "poem_id": 1783,
    "vorder": 437,
    "position": 0,
    "text": "رخ رومیان همچو دیبای روم"
  },
  {
    "poem_id": 1783,
    "vorder": 438,
    "position": 1,
    "text": "ازیشان همی تازه شد مرز و بوم"
  },
  {
    "poem_id": 1783,
    "vorder": 439,
    "position": 0,
    "text": "بشد آرزو تا به مشکوی شاه"
  },
  {
    "poem_id": 1783,
    "vorder": 440,
    "position": 1,
    "text": "نهاده به سر بر ز گوهر کلاه"
  },
  {
    "poem_id": 1783,
    "vorder": 441,
    "position": 0,
    "text": "بیامد شهنشاه با روزبه"
  },
  {
    "poem_id": 1783,
    "vorder": 442,
    "position": 1,
    "text": "گشاده‌دل و شاد از ایوان مه"
  },
  {
    "poem_id": 1783,
    "vorder": 443,
    "position": 0,
    "text": "همی‌راند گویان به مشکوی خویش"
  },
  {
    "poem_id": 1783,
    "vorder": 444,
    "position": 1,
    "text": "به سوی بتان سمن‌بوی خویش"
  }
]