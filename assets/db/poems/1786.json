[
  {
    "poem_id": 1786,
    "vorder": 1,
    "position": 0,
    "text": "دگر روز چون تاج بفروخت هور"
  },
  {
    "poem_id": 1786,
    "vorder": 2,
    "position": 1,
    "text": "جهاندار شد سوی نخچیر گور"
  },
  {
    "poem_id": 1786,
    "vorder": 3,
    "position": 0,
    "text": "کمان را به زه بر نهاده سپاه"
  },
  {
    "poem_id": 1786,
    "vorder": 4,
    "position": 1,
    "text": "پس لشکر اندر همی رفت شاه"
  },
  {
    "poem_id": 1786,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت هرکو کمان را به دست"
  },
  {
    "poem_id": 1786,
    "vorder": 6,
    "position": 1,
    "text": "بمالد گشاید به اندازه شست"
  },
  {
    "poem_id": 1786,
    "vorder": 7,
    "position": 0,
    "text": "نباید زدن تیر جز بر سرون"
  },
  {
    "poem_id": 1786,
    "vorder": 8,
    "position": 1,
    "text": "که از سینه پیکانش آید برون"
  },
  {
    "poem_id": 1786,
    "vorder": 9,
    "position": 0,
    "text": "یکی پهلوان گفت کای شهریار"
  },
  {
    "poem_id": 1786,
    "vorder": 10,
    "position": 1,
    "text": "نگه کن بدین لشکر نامدار"
  },
  {
    "poem_id": 1786,
    "vorder": 11,
    "position": 0,
    "text": "که با کیست زین‌گونه تیر و کمان"
  },
  {
    "poem_id": 1786,
    "vorder": 12,
    "position": 1,
    "text": "بداندیش گر مرد نیکی گمان"
  },
  {
    "poem_id": 1786,
    "vorder": 13,
    "position": 0,
    "text": "مگر باشد این را گشاد برت"
  },
  {
    "poem_id": 1786,
    "vorder": 14,
    "position": 1,
    "text": "که جاوید بادا سر و افسرت"
  },
  {
    "poem_id": 1786,
    "vorder": 15,
    "position": 0,
    "text": "چو تو تیر گیری و شمشیر و گرز"
  },
  {
    "poem_id": 1786,
    "vorder": 16,
    "position": 1,
    "text": "ازان خسروی فر و بالای برز"
  },
  {
    "poem_id": 1786,
    "vorder": 17,
    "position": 0,
    "text": "همه لشکر از شاه دارند شرم"
  },
  {
    "poem_id": 1786,
    "vorder": 18,
    "position": 1,
    "text": "ز تیر و کمانشان شود دست نرم"
  },
  {
    "poem_id": 1786,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ که این ایزدیست"
  },
  {
    "poem_id": 1786,
    "vorder": 20,
    "position": 1,
    "text": "کزو بگذری زور بهرام چیست"
  },
  {
    "poem_id": 1786,
    "vorder": 21,
    "position": 0,
    "text": "برانگیخت شبدیز بهرام را"
  },
  {
    "poem_id": 1786,
    "vorder": 22,
    "position": 1,
    "text": "همی تیز کرد او دلارام را"
  },
  {
    "poem_id": 1786,
    "vorder": 23,
    "position": 0,
    "text": "چو آمدش هنگام بگشاد شست"
  },
  {
    "poem_id": 1786,
    "vorder": 24,
    "position": 1,
    "text": "بر گور را با سرونش ببست"
  },
  {
    "poem_id": 1786,
    "vorder": 25,
    "position": 0,
    "text": "هم‌انگاه گور اندر آمد به سر"
  },
  {
    "poem_id": 1786,
    "vorder": 26,
    "position": 1,
    "text": "برفتند گردان زرین کمر"
  },
  {
    "poem_id": 1786,
    "vorder": 27,
    "position": 0,
    "text": "شگفت اندران زخم او ماندند"
  },
  {
    "poem_id": 1786,
    "vorder": 28,
    "position": 1,
    "text": "یکایک برو آفرین خواندند"
  },
  {
    "poem_id": 1786,
    "vorder": 29,
    "position": 0,
    "text": "که کس پر و پیکان تیرش ندید"
  },
  {
    "poem_id": 1786,
    "vorder": 30,
    "position": 1,
    "text": "به بالای آن گور شد ناپدید"
  },
  {
    "poem_id": 1786,
    "vorder": 31,
    "position": 0,
    "text": "سواران جنگی و مردان کین"
  },
  {
    "poem_id": 1786,
    "vorder": 32,
    "position": 1,
    "text": "سراسر برو خواندند آفرین"
  },
  {
    "poem_id": 1786,
    "vorder": 33,
    "position": 0,
    "text": "بدو پهلوان گفت کای شهریار"
  },
  {
    "poem_id": 1786,
    "vorder": 34,
    "position": 1,
    "text": "مبیناد چشمت بد روزگار"
  },
  {
    "poem_id": 1786,
    "vorder": 35,
    "position": 0,
    "text": "سواری تو و ما همه بر خریم"
  },
  {
    "poem_id": 1786,
    "vorder": 36,
    "position": 1,
    "text": "هم از خروران در هنر کمتریم"
  },
  {
    "poem_id": 1786,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت شاه این نه تیر منست"
  },
  {
    "poem_id": 1786,
    "vorder": 38,
    "position": 1,
    "text": "که پیروزگر دستگیر منست"
  },
  {
    "poem_id": 1786,
    "vorder": 39,
    "position": 0,
    "text": "کرا پشت و یاور جهاندار نیست"
  },
  {
    "poem_id": 1786,
    "vorder": 40,
    "position": 1,
    "text": "ازو خوارتر در جهان خوار نیست"
  },
  {
    "poem_id": 1786,
    "vorder": 41,
    "position": 0,
    "text": "برانگیخت آن بارکش را ز جای"
  },
  {
    "poem_id": 1786,
    "vorder": 42,
    "position": 1,
    "text": "تو گفتی شد آن باره پران همای"
  },
  {
    "poem_id": 1786,
    "vorder": 43,
    "position": 0,
    "text": "یکی گور پیش آمدش ماده بود"
  },
  {
    "poem_id": 1786,
    "vorder": 44,
    "position": 1,
    "text": "بچه پیش ازو رفته او مانده بود"
  },
  {
    "poem_id": 1786,
    "vorder": 45,
    "position": 0,
    "text": "یکی تیغ زد بر میانش سوار"
  },
  {
    "poem_id": 1786,
    "vorder": 46,
    "position": 1,
    "text": "بدونیم شد گور ناپایدار"
  },
  {
    "poem_id": 1786,
    "vorder": 47,
    "position": 0,
    "text": "رسیدند نزدیک او مهتران"
  },
  {
    "poem_id": 1786,
    "vorder": 48,
    "position": 1,
    "text": "سرافراز و شمشیر زن کهتران"
  },
  {
    "poem_id": 1786,
    "vorder": 49,
    "position": 0,
    "text": "چو آن زخم دیدند بر ماده گور"
  },
  {
    "poem_id": 1786,
    "vorder": 50,
    "position": 1,
    "text": "خردمند گفت اینت شمشیر و زور"
  },
  {
    "poem_id": 1786,
    "vorder": 51,
    "position": 0,
    "text": "مبیناد چشم بد این شاه را"
  },
  {
    "poem_id": 1786,
    "vorder": 52,
    "position": 1,
    "text": "نماند به جز بر فلک ماه را"
  },
  {
    "poem_id": 1786,
    "vorder": 53,
    "position": 0,
    "text": "سر مهتران جهان زیر اوست"
  },
  {
    "poem_id": 1786,
    "vorder": 54,
    "position": 1,
    "text": "فلک زیر پیکان و شمشیر اوست"
  },
  {
    "poem_id": 1786,
    "vorder": 55,
    "position": 0,
    "text": "سپاه از پس‌اندر همی تاختند"
  },
  {
    "poem_id": 1786,
    "vorder": 56,
    "position": 1,
    "text": "بیابان ز گوران بپرداختند"
  },
  {
    "poem_id": 1786,
    "vorder": 57,
    "position": 0,
    "text": "یکی مرد بر گرد لشکر بگشت"
  },
  {
    "poem_id": 1786,
    "vorder": 58,
    "position": 1,
    "text": "که یک تن مباد اندرین پهن دشت"
  },
  {
    "poem_id": 1786,
    "vorder": 59,
    "position": 0,
    "text": "که گوری فروشد به بازارگان"
  },
  {
    "poem_id": 1786,
    "vorder": 60,
    "position": 1,
    "text": "بدیشان دهند این همه رایگان"
  },
  {
    "poem_id": 1786,
    "vorder": 61,
    "position": 0,
    "text": "ز بر کوی با نامداران جز"
  },
  {
    "poem_id": 1786,
    "vorder": 62,
    "position": 1,
    "text": "ببردند بسیار دیبا و خز"
  },
  {
    "poem_id": 1786,
    "vorder": 63,
    "position": 0,
    "text": "بپذرفت و فرمود تا باژ و ساو"
  },
  {
    "poem_id": 1786,
    "vorder": 64,
    "position": 1,
    "text": "نخواهند اگر چندشان بود تاو"
  },
  {
    "poem_id": 1786,
    "vorder": 65,
    "position": 0,
    "text": "ازان شهرها هرک درویش بود"
  },
  {
    "poem_id": 1786,
    "vorder": 66,
    "position": 1,
    "text": "وگر نانش از کوشش خویش بود"
  },
  {
    "poem_id": 1786,
    "vorder": 67,
    "position": 0,
    "text": "ز بخشیدن او توانگر شدند"
  },
  {
    "poem_id": 1786,
    "vorder": 68,
    "position": 1,
    "text": "بسی نیز با تخت و افسر شدند"
  },
  {
    "poem_id": 1786,
    "vorder": 69,
    "position": 0,
    "text": "به شهر اندر آمد ز نخچیرگاه"
  },
  {
    "poem_id": 1786,
    "vorder": 70,
    "position": 1,
    "text": "بکی هفته بد شادمان با سپاه"
  },
  {
    "poem_id": 1786,
    "vorder": 71,
    "position": 0,
    "text": "برفتی خوش‌آواز گوینده‌ای"
  },
  {
    "poem_id": 1786,
    "vorder": 72,
    "position": 1,
    "text": "خردمند و درویش جوینده‌ای"
  },
  {
    "poem_id": 1786,
    "vorder": 73,
    "position": 0,
    "text": "بگفتی که ای دادخواهندگان"
  },
  {
    "poem_id": 1786,
    "vorder": 74,
    "position": 1,
    "text": "به یزدان پناهید از بندگان"
  },
  {
    "poem_id": 1786,
    "vorder": 75,
    "position": 0,
    "text": "کسی کو بخفته‌ست با رنج ما"
  },
  {
    "poem_id": 1786,
    "vorder": 76,
    "position": 1,
    "text": "وگر نیستش بهره از گنج ما"
  },
  {
    "poem_id": 1786,
    "vorder": 77,
    "position": 0,
    "text": "به میدان خرامید تا شهریار"
  },
  {
    "poem_id": 1786,
    "vorder": 78,
    "position": 1,
    "text": "مگر بر شما نوکند روزگار"
  },
  {
    "poem_id": 1786,
    "vorder": 79,
    "position": 0,
    "text": "دگر هرک پیرست و بیکار و سست"
  },
  {
    "poem_id": 1786,
    "vorder": 80,
    "position": 1,
    "text": "همان کو جوانست و ناتن درست"
  },
  {
    "poem_id": 1786,
    "vorder": 81,
    "position": 0,
    "text": "وگر وام دارد کسی زین گروه"
  },
  {
    "poem_id": 1786,
    "vorder": 82,
    "position": 1,
    "text": "شده‌ست از بد وام خواهان ستوه"
  },
  {
    "poem_id": 1786,
    "vorder": 83,
    "position": 0,
    "text": "وگر بی‌پدر کودکانند نیز"
  },
  {
    "poem_id": 1786,
    "vorder": 84,
    "position": 1,
    "text": "ازان کس که دارد بخواهند چیز"
  },
  {
    "poem_id": 1786,
    "vorder": 85,
    "position": 0,
    "text": "بود مام کودک نهفته نیاز"
  },
  {
    "poem_id": 1786,
    "vorder": 86,
    "position": 1,
    "text": "بدوبر گشایم در گنج باز"
  },
  {
    "poem_id": 1786,
    "vorder": 87,
    "position": 0,
    "text": "وگر مایه‌داری توانگر بمرد"
  },
  {
    "poem_id": 1786,
    "vorder": 88,
    "position": 1,
    "text": "بدین مرز ازو کودکان ماند خرد"
  },
  {
    "poem_id": 1786,
    "vorder": 89,
    "position": 0,
    "text": "گنه کار دارد بدان چیز رای"
  },
  {
    "poem_id": 1786,
    "vorder": 90,
    "position": 1,
    "text": "ندارد به دل شرم و بیم خدای"
  },
  {
    "poem_id": 1786,
    "vorder": 91,
    "position": 0,
    "text": "سخن زین نشان کس مدارید باز"
  },
  {
    "poem_id": 1786,
    "vorder": 92,
    "position": 1,
    "text": "که از رازداران منم بی‌نیاز"
  },
  {
    "poem_id": 1786,
    "vorder": 93,
    "position": 0,
    "text": "توانگر کنم مرد درویش را"
  },
  {
    "poem_id": 1786,
    "vorder": 94,
    "position": 1,
    "text": "به دین آورم جان بدکیش را"
  },
  {
    "poem_id": 1786,
    "vorder": 95,
    "position": 0,
    "text": "بتوزیم فام کسی کش درم"
  },
  {
    "poem_id": 1786,
    "vorder": 96,
    "position": 1,
    "text": "نباشد دل خویش دارد به غم"
  },
  {
    "poem_id": 1786,
    "vorder": 97,
    "position": 0,
    "text": "دگر هرک دارد نهفته نیاز"
  },
  {
    "poem_id": 1786,
    "vorder": 98,
    "position": 1,
    "text": "همی دارد از تنگی خویش راز"
  },
  {
    "poem_id": 1786,
    "vorder": 99,
    "position": 0,
    "text": "مر او را ازان کار بی‌غم کنم"
  },
  {
    "poem_id": 1786,
    "vorder": 100,
    "position": 1,
    "text": "فزون شادی و اندهش کم کنم"
  },
  {
    "poem_id": 1786,
    "vorder": 101,
    "position": 0,
    "text": "گر از کارداران بود رنج نیز"
  },
  {
    "poem_id": 1786,
    "vorder": 102,
    "position": 1,
    "text": "که او از پدرمرده‌ای خواست چیز"
  },
  {
    "poem_id": 1786,
    "vorder": 103,
    "position": 0,
    "text": "کنم زنده بر دار بیداد را"
  },
  {
    "poem_id": 1786,
    "vorder": 104,
    "position": 1,
    "text": "که آزرد او مرد آزاد را"
  },
  {
    "poem_id": 1786,
    "vorder": 105,
    "position": 0,
    "text": "گشادند زان پس در گنج باز"
  },
  {
    "poem_id": 1786,
    "vorder": 106,
    "position": 1,
    "text": "توانگر شد آنکس که بودش نیاز"
  },
  {
    "poem_id": 1786,
    "vorder": 107,
    "position": 0,
    "text": "ز نخچیرگه سوی بغداد رفت"
  },
  {
    "poem_id": 1786,
    "vorder": 108,
    "position": 1,
    "text": "خرد یافته با دلی شاد رفت"
  },
  {
    "poem_id": 1786,
    "vorder": 109,
    "position": 0,
    "text": "برفتند گردنکشان پیش اوی"
  },
  {
    "poem_id": 1786,
    "vorder": 110,
    "position": 1,
    "text": "ز بیگانه و آنک بد خویش اوی"
  },
  {
    "poem_id": 1786,
    "vorder": 111,
    "position": 0,
    "text": "بفرمود تا بازگردد سپاه"
  },
  {
    "poem_id": 1786,
    "vorder": 112,
    "position": 1,
    "text": "بیامد به کاخ دلارای شاه"
  },
  {
    "poem_id": 1786,
    "vorder": 113,
    "position": 0,
    "text": "شبستان زرین بیاراستند"
  },
  {
    "poem_id": 1786,
    "vorder": 114,
    "position": 1,
    "text": "پرستندگان رود و می خواستند"
  },
  {
    "poem_id": 1786,
    "vorder": 115,
    "position": 0,
    "text": "بتان چامه و چنگ برساختند"
  },
  {
    "poem_id": 1786,
    "vorder": 116,
    "position": 1,
    "text": "ز بیگانه ایوان بپرداختند"
  },
  {
    "poem_id": 1786,
    "vorder": 117,
    "position": 0,
    "text": "ز رود و می و بانگ چنگ و سرود"
  },
  {
    "poem_id": 1786,
    "vorder": 118,
    "position": 1,
    "text": "هوا را همی داد گفتی درود"
  },
  {
    "poem_id": 1786,
    "vorder": 119,
    "position": 0,
    "text": "به هر شب ز هر حجره یک دست‌بند"
  },
  {
    "poem_id": 1786,
    "vorder": 120,
    "position": 1,
    "text": "ببردند تا دل ندارد نژند"
  },
  {
    "poem_id": 1786,
    "vorder": 121,
    "position": 0,
    "text": "دو هفته همی بود دل شادمان"
  },
  {
    "poem_id": 1786,
    "vorder": 122,
    "position": 1,
    "text": "در گنج بگشاد روز و شبان"
  },
  {
    "poem_id": 1786,
    "vorder": 123,
    "position": 0,
    "text": "درم داد و آمد به شهر صطخر"
  },
  {
    "poem_id": 1786,
    "vorder": 124,
    "position": 1,
    "text": "به سر بر نهاد آن کیان تاج فخر"
  },
  {
    "poem_id": 1786,
    "vorder": 125,
    "position": 0,
    "text": "شبستاان خود را چو در باز کرد"
  },
  {
    "poem_id": 1786,
    "vorder": 126,
    "position": 1,
    "text": "بتان را ز گنج درم ساز کرد"
  },
  {
    "poem_id": 1786,
    "vorder": 127,
    "position": 0,
    "text": "به مشکوی زرین هرانکس که تاج"
  },
  {
    "poem_id": 1786,
    "vorder": 128,
    "position": 1,
