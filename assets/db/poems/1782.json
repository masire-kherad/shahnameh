[
  {
    "poem_id": 1782,
    "vorder": 1,
    "position": 0,
    "text": "به هشتم بیامد به دشت شکار"
  },
  {
    "poem_id": 1782,
    "vorder": 2,
    "position": 1,
    "text": "خود و روزبه با سواری هزار"
  },
  {
    "poem_id": 1782,
    "vorder": 3,
    "position": 0,
    "text": "همه دشت یکسر پر از گور دید"
  },
  {
    "poem_id": 1782,
    "vorder": 4,
    "position": 1,
    "text": "ز قربان کمان کیان برکشید"
  },
  {
    "poem_id": 1782,
    "vorder": 5,
    "position": 0,
    "text": "دو زاغ کمان را به زه بر نهاد"
  },
  {
    "poem_id": 1782,
    "vorder": 6,
    "position": 1,
    "text": "ز یزدان پیروزگر کرد یاد"
  },
  {
    "poem_id": 1782,
    "vorder": 7,
    "position": 0,
    "text": "بهاران و گوران شده جفت جوی"
  },
  {
    "poem_id": 1782,
    "vorder": 8,
    "position": 1,
    "text": "ز کشتن به روی اندر آورده روی"
  },
  {
    "poem_id": 1782,
    "vorder": 9,
    "position": 0,
    "text": "همی پوست کند این ازآن آن ازین"
  },
  {
    "poem_id": 1782,
    "vorder": 10,
    "position": 1,
    "text": "ز خونشان شده لعل روی زمین"
  },
  {
    "poem_id": 1782,
    "vorder": 11,
    "position": 0,
    "text": "همی بود بهرام تا گور نر"
  },
  {
    "poem_id": 1782,
    "vorder": 12,
    "position": 1,
    "text": "به مستی جدا شد یک از یک دگر"
  },
  {
    "poem_id": 1782,
    "vorder": 13,
    "position": 0,
    "text": "چو پیروز شد نره گور دلیر"
  },
  {
    "poem_id": 1782,
    "vorder": 14,
    "position": 1,
    "text": "یکی ماده را اندر آورد زیر"
  },
  {
    "poem_id": 1782,
    "vorder": 15,
    "position": 0,
    "text": "به زه داشت بهرام جنگی کمان"
  },
  {
    "poem_id": 1782,
    "vorder": 16,
    "position": 1,
    "text": "بخندید چون گور شد شادمان"
  },
  {
    "poem_id": 1782,
    "vorder": 17,
    "position": 0,
    "text": "بزد تیر بر پشت آن گور نر"
  },
  {
    "poem_id": 1782,
    "vorder": 18,
    "position": 1,
    "text": "گذر کرد بر گور پیکان و پر"
  },
  {
    "poem_id": 1782,
    "vorder": 19,
    "position": 0,
    "text": "نر و ماده را هر دو بر هم بدوخت"
  },
  {
    "poem_id": 1782,
    "vorder": 20,
    "position": 1,
    "text": "دل لشکر از زخم او بر فروخت"
  },
  {
    "poem_id": 1782,
    "vorder": 21,
    "position": 0,
    "text": "ز لشکر هرانکس که آن زخم دید"
  },
  {
    "poem_id": 1782,
    "vorder": 22,
    "position": 1,
    "text": "بران شهریار آفرین گسترید"
  },
  {
    "poem_id": 1782,
    "vorder": 23,
    "position": 0,
    "text": "که چشم بد از فر تو دور باد"
  },
  {
    "poem_id": 1782,
    "vorder": 24,
    "position": 1,
    "text": "همه روزگاران تو سور باد"
  },
  {
    "poem_id": 1782,
    "vorder": 25,
    "position": 0,
    "text": "به مردی تواندر زمانه نوی"
  },
  {
    "poem_id": 1782,
    "vorder": 26,
    "position": 1,
    "text": "که هم شاه و هم خسرو و هم گوی"
  }
]