[
  {
    "poem_id": 1476,
    "vorder": 1,
    "position": 0,
    "text": "دگر باره اسپان ببستند سخت"
  },
  {
    "poem_id": 1476,
    "vorder": 2,
    "position": 1,
    "text": "به سر بر همی گشت بدخواه بخت"
  },
  {
    "poem_id": 1476,
    "vorder": 3,
    "position": 0,
    "text": "به کشتی گرفتن نهادند سر"
  },
  {
    "poem_id": 1476,
    "vorder": 4,
    "position": 1,
    "text": "گرفتند هر دو دوال کمر"
  },
  {
    "poem_id": 1476,
    "vorder": 5,
    "position": 0,
    "text": "هرآنگه که خشم آورد بخت شوم"
  },
  {
    "poem_id": 1476,
    "vorder": 6,
    "position": 1,
    "text": "کند سنگ خارا به کردار موم"
  },
  {
    "poem_id": 1476,
    "vorder": 7,
    "position": 0,
    "text": "سرافراز سهراب با زور دست"
  },
  {
    "poem_id": 1476,
    "vorder": 8,
    "position": 1,
    "text": "تو گفتی سپهر بلندش ببست"
  },
  {
    "poem_id": 1476,
    "vorder": 9,
    "position": 0,
    "text": "غمی بود رستم بیازید چنگ"
  },
  {
    "poem_id": 1476,
    "vorder": 10,
    "position": 1,
    "text": "گرفت آن بر و یال جنگی پلنگ"
  },
  {
    "poem_id": 1476,
    "vorder": 11,
    "position": 0,
    "text": "خم آورد پشت دلیر جوان"
  },
  {
    "poem_id": 1476,
    "vorder": 12,
    "position": 1,
    "text": "زمانه بیامد نبودش توان"
  },
  {
    "poem_id": 1476,
    "vorder": 13,
    "position": 0,
    "text": "زدش بر زمین بر به کردار شیر"
  },
  {
    "poem_id": 1476,
    "vorder": 14,
    "position": 1,
    "text": "بدانست کاو هم نماند به زیر"
  },
  {
    "poem_id": 1476,
    "vorder": 15,
    "position": 0,
    "text": "سبک تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 1476,
    "vorder": 16,
    "position": 1,
    "text": "بر شیر بیدار دل بردرید"
  },
  {
    "poem_id": 1476,
    "vorder": 17,
    "position": 0,
    "text": "بپیچید زانپس یکی آه کرد"
  },
  {
    "poem_id": 1476,
    "vorder": 18,
    "position": 1,
    "text": "ز نیک و بد اندیشه کوتاه کرد"
  },
  {
    "poem_id": 1476,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت کاین بر من از من رسید"
  },
  {
    "poem_id": 1476,
    "vorder": 20,
    "position": 1,
    "text": "زمانه به دست تو دادم کلید"
  },
  {
    "poem_id": 1476,
    "vorder": 21,
    "position": 0,
    "text": "تو زین بیگناهی که این کوژپشت"
  },
  {
    "poem_id": 1476,
    "vorder": 22,
    "position": 1,
    "text": "مرابرکشید و به زودی بکشت"
  },
  {
    "poem_id": 1476,
    "vorder": 23,
    "position": 0,
    "text": "به بازی بکویند همسال من"
  },
  {
    "poem_id": 1476,
    "vorder": 24,
    "position": 1,
    "text": "به خاک اندر آمد چنین یال من"
  },
  {
    "poem_id": 1476,
    "vorder": 25,
    "position": 0,
    "text": "نشان داد مادر مرا از پدر"
  },
  {
    "poem_id": 1476,
    "vorder": 26,
    "position": 1,
    "text": "ز مهر اندر آمد روانم بسر"
  },
  {
    "poem_id": 1476,
    "vorder": 27,
    "position": 0,
    "text": "هرآنگه که تشنه شدستی به خون"
  },
  {
    "poem_id": 1476,
    "vorder": 28,
    "position": 1,
    "text": "بیالودی آن خنجر آبگون"
  },
  {
    "poem_id": 1476,
    "vorder": 29,
    "position": 0,
    "text": "زمانه به خون تو تشنه شود"
  },
  {
    "poem_id": 1476,
    "vorder": 30,
    "position": 1,
    "text": "براندام تو موی دشنه شود"
  },
  {
    "poem_id": 1476,
    "vorder": 31,
    "position": 0,
    "text": "کنون گر تو در آب ماهی شوی"
  },
  {
    "poem_id": 1476,
    "vorder": 32,
    "position": 1,
    "text": "و گر چون شب اندر سیاهی شوی"
  },
  {
    "poem_id": 1476,
    "vorder": 33,
    "position": 0,
    "text": "وگر چون ستاره شوی بر سپهر"
  },
  {
    "poem_id": 1476,
    "vorder": 34,
    "position": 1,
    "text": "ببری ز روی زمین پاک مهر"
  },
  {
    "poem_id": 1476,
    "vorder": 35,
    "position": 0,
    "text": "بخواهد هم از تو پدر کین من"
  },
  {
    "poem_id": 1476,
    "vorder": 36,
    "position": 1,
    "text": "چو بیند که خاکست بالین من"
  },
  {
    "poem_id": 1476,
    "vorder": 37,
    "position": 0,
    "text": "ازین نامداران گردنکشان"
  },
  {
    "poem_id": 1476,
    "vorder": 38,
    "position": 1,
    "text": "کسی هم برد سوی رستم نشان"
  },
  {
    "poem_id": 1476,
    "vorder": 39,
    "position": 0,
    "text": "که سهراب کشتست و افگنده خوار"
  },
  {
    "poem_id": 1476,
    "vorder": 40,
    "position": 1,
    "text": "ترا خواست کردن همی خواستار"
  },
  {
    "poem_id": 1476,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید رستم سرش خیره گشت"
  },
  {
    "poem_id": 1476,
    "vorder": 42,
    "position": 1,
    "text": "جهان پیش چشم اندرش تیره گشت"
  },
  {
    "poem_id": 1476,
    "vorder": 43,
    "position": 0,
    "text": "بپرسید زان پس که آمد به هوش"
  },
  {
    "poem_id": 1476,
    "vorder": 44,
    "position": 1,
    "text": "بدو گفت با ناله و با خروش"
  },
  {
    "poem_id": 1476,
    "vorder": 45,
    "position": 0,
    "text": "که اکنون چه داری ز رستم نشان"
  },
  {
    "poem_id": 1476,
    "vorder": 46,
    "position": 1,
    "text": "که کم باد نامش ز گردنکشان"
  },
  {
    "poem_id": 1476,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت ار ایدونکه رستم تویی"
  },
  {
    "poem_id": 1476,
    "vorder": 48,
    "position": 1,
    "text": "بکشتی مرا خیره از بدخویی"
  },
  {
    "poem_id": 1476,
    "vorder": 49,
    "position": 0,
    "text": "ز هر گونه‌ای بودمت رهنمای"
  },
  {
    "poem_id": 1476,
    "vorder": 50,
    "position": 1,
    "text": "نجنبید یک ذره مهرت ز جای"
  },
  {
    "poem_id": 1476,
    "vorder": 51,
    "position": 0,
    "text": "چو برخاست آواز کوس از درم"
  },
  {
    "poem_id": 1476,
    "vorder": 52,
    "position": 1,
    "text": "بیامد پر از خون دو رخ مادرم"
  },
  {
    "poem_id": 1476,
    "vorder": 53,
    "position": 0,
    "text": "همی جانش از رفتن من بخست"
  },
  {
    "poem_id": 1476,
    "vorder": 54,
    "position": 1,
    "text": "یکی مهره بر بازوی من ببست"
  },
  {
    "poem_id": 1476,
    "vorder": 55,
    "position": 0,
    "text": "مرا گفت کاین از پدر یادگار"
  },
  {
    "poem_id": 1476,
    "vorder": 56,
    "position": 1,
    "text": "بدار و ببین تا کی آید به کار"
  },
  {
    "poem_id": 1476,
    "vorder": 57,
    "position": 0,
    "text": "کنون کارگر شد که بیکار گشت"
  },
  {
    "poem_id": 1476,
    "vorder": 58,
    "position": 1,
    "text": "پسر پیش چشم پدر خوار گشت"
  },
  {
    "poem_id": 1476,
    "vorder": 59,
    "position": 0,
    "text": "همان نیز مادر به روشن روان"
  },
  {
    "poem_id": 1476,
    "vorder": 60,
    "position": 1,
    "text": "فرستاد با من یکی پهلوان"
  },
  {
    "poem_id": 1476,
    "vorder": 61,
    "position": 0,
    "text": "بدان تا پدر را نماید به من"
  },
  {
    "poem_id": 1476,
    "vorder": 62,
    "position": 1,
    "text": "سخن برگشاید به هر انجمن"
  },
  {
    "poem_id": 1476,
    "vorder": 63,
    "position": 0,
    "text": "چو آن نامور پهلوان کشته شد"
  },
  {
    "poem_id": 1476,
    "vorder": 64,
    "position": 1,
    "text": "مرا نیز هم روز برگشته شد"
  },
  {
    "poem_id": 1476,
    "vorder": 65,
    "position": 0,
    "text": "کنون بند بگشای از جوشنم"
  },
  {
    "poem_id": 1476,
    "vorder": 66,
    "position": 1,
    "text": "برهنه نگه کن تن روشنم"
  },
  {
    "poem_id": 1476,
    "vorder": 67,
    "position": 0,
    "text": "چو بگشاد خفتان و آن مهره دید"
  },
  {
    "poem_id": 1476,
    "vorder": 68,
    "position": 1,
    "text": "همه جامه بر خویشتن بردرید"
  },
  {
    "poem_id": 1476,
    "vorder": 69,
    "position": 0,
    "text": "همی گفت کای کشته بر دست من"
  },
  {
    "poem_id": 1476,
    "vorder": 70,
    "position": 1,
    "text": "دلیر و ستوده به هر انجمن"
  },
  {
    "poem_id": 1476,
    "vorder": 71,
    "position": 0,
    "text": "همی ریخت خون و همی کند موی"
  },
  {
    "poem_id": 1476,
    "vorder": 72,
    "position": 1,
    "text": "سرش پر ز خاک و پر از آب روی"
  },
  {
    "poem_id": 1476,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت سهراب کین بدتریست"
  },
  {
    "poem_id": 1476,
    "vorder": 74,
    "position": 1,
    "text": "به آب دو دیده نباید گریست"
  },
  {
    "poem_id": 1476,
    "vorder": 75,
    "position": 0,
    "text": "ازین خویشتن کشتن اکنون چه سود"
  },
  {
    "poem_id": 1476,
    "vorder": 76,
    "position": 1,
    "text": "چنین رفت و این بودنی کار بود"
  },
  {
    "poem_id": 1476,
    "vorder": 77,
    "position": 0,
    "text": "چو خورشید تابان ز گنبد بگشت"
  },
  {
    "poem_id": 1476,
    "vorder": 78,
    "position": 1,
    "text": "تهمتن نیامد به لشکر ز دشت"
  },
  {
    "poem_id": 1476,
    "vorder": 79,
    "position": 0,
    "text": "ز لشکر بیامد هشیوار بیست"
  },
  {
    "poem_id": 1476,
    "vorder": 80,
    "position": 1,
    "text": "که تا اندر آوردگه کار چیست"
  },
  {
    "poem_id": 1476,
    "vorder": 81,
    "position": 0,
    "text": "دو اسپ اندر آن دشت برپای بود"
  },
  {
    "poem_id": 1476,
    "vorder": 82,
    "position": 1,
    "text": "پر از گرد رستم دگر جای بود"
  },
  {
    "poem_id": 1476,
    "vorder": 83,
    "position": 0,
    "text": "گو پیلتن را چو بر پشت زین"
  },
  {
    "poem_id": 1476,
    "vorder": 84,
    "position": 1,
    "text": "ندیدند گردان بران دشت کین"
  },
  {
    "poem_id": 1476,
    "vorder": 85,
    "position": 0,
    "text": "گمانشان چنان بد که او کشته شد"
  },
  {
    "poem_id": 1476,
    "vorder": 86,
    "position": 1,
    "text": "سرنامداران همه گشته شد"
  },
  {
    "poem_id": 1476,
    "vorder": 87,
    "position": 0,
    "text": "به کاووس کی تاختند آگهی"
  },
  {
    "poem_id": 1476,
    "vorder": 88,
    "position": 1,
    "text": "که تخت مهی شد ز رستم تهی"
  },
  {
    "poem_id": 1476,
    "vorder": 89,
    "position": 0,
    "text": "ز لشکر برآمد سراسر خروش"
  },
  {
    "poem_id": 1476,
    "vorder": 90,
    "position": 1,
    "text": "زمانه یکایک برآمد به جوش"
  },
  {
    "poem_id": 1476,
    "vorder": 91,
    "position": 0,
    "text": "بفرمود کاووس تا بوق و کوس"
  },
  {
    "poem_id": 1476,
    "vorder": 92,
    "position": 1,
    "text": "دمیدند و آمد سپهدار طوس"
  },
  {
    "poem_id": 1476,
    "vorder": 93,
    "position": 0,
    "text": "ازان پس بدو گفت کاووس شاه"
  },
  {
    "poem_id": 1476,
    "vorder": 94,
    "position": 1,
    "text": "کز ایدر هیونی سوی رزمگاه"
  },
  {
    "poem_id": 1476,
    "vorder": 95,
    "position": 0,
    "text": "بتازید تا کار سهراب چیست"
  },
  {
    "poem_id": 1476,
    "vorder": 96,
    "position": 1,
    "text": "که بر شهر ایران بباید گریست"
  },
  {
    "poem_id": 1476,
    "vorder": 97,
    "position": 0,
    "text": "اگر کشته شد رستم جنگجوی"
  },
  {
    "poem_id": 1476,
    "vorder": 98,
    "position": 1,
    "text": "از ایران که یارد شدن پیش اوی"
  },
  {
    "poem_id": 1476,
    "vorder": 99,
    "position": 0,
    "text": "به انبوه زخمی بباید زدن"
  },
  {
    "poem_id": 1476,
    "vorder": 100,
    "position": 1,
    "text": "برین رزمگه بر نشاید بدن"
  },
  {
    "poem_id": 1476,
    "vorder": 101,
    "position": 0,
    "text": "چو آشوب برخاست از انجمن"
  },
  {
    "poem_id": 1476,
    "vorder": 102,
    "position": 1,
    "text": "چنین گفت سهراب با پیلتن"
  },
  {
    "poem_id": 1476,
    "vorder": 103,
    "position": 0,
    "text": "که اکنون که روز من اندر گذشت"
  },
  {
    "poem_id": 1476,
    "vorder": 104,
    "position": 1,
    "text": "همه کار ترکان دگرگونه گشت"
  },
  {
    "poem_id": 1476,
    "vorder": 105,
    "position": 0,
    "text": "همه مهربانی بران کن که شاه"
  },
  {
    "poem_id": 1476,
    "vorder": 106,
    "position": 1,
    "text": "سوی جنگ ترکان نراند سپاه"
  },
  {
    "poem_id": 1476,
    "vorder": 107,
    "position": 0,
    "text": "که ایشان ز بهر مرا جنگجوی"
  },
  {
    "poem_id": 1476,
    "vorder": 108,
    "position": 1,
    "text": "سوی مرز ایران نهادند روی"
  },
  {
    "poem_id": 1476,
    "vorder": 109,
    "position": 0,
    "text": "بسی روز را داده بودم نوید"
  },
  {
    "poem_id": 1476,
    "vorder": 110,
    "position": 1,
    "text": "بسی کرده بودم ز هر در امید"
  },
  {
    "poem_id": 1476,
    "vorder": 111,
    "position": 0,
    "text": "نباید که بینند رنجی به راه"
  },
  {
    "poem_id": 1476,
    "vorder": 112,
    "position": 1,
    "text": "مکن جز به نیکی بر ایشان نگاه"
  },
  {
    "poem_id": 1476,
    "vorder": 113,
    "position": 0,
    "text": "نشست از بر رخش رستم چو گرد"
  },
  {
    "poem_id": 1476,
    "vorder": 114,
    "position": 1,
    "text": "پر از خون رخ و لب پر از باد سرد"
  },
  {
    "poem_id": 1476,
    "vorder": 115,
    "position": 0,
    "text": "بیامد به پیش سپه با خروش"
  },
  {
    "poem_id": 1476,
    "vorder": 116,
    "position": 1,
    "text": "دل از کردهٔ خویش با درد و جوش"
  },
  {
    "poem_id": 1476,
    "vorder": 117,
    "position": 0,
    "text": "چو دیدند ایرانیان روی اوی"
  },
  {
    "poem_id": 1476,
    "vorder": 118,
    "position": 1,
    "text": "همه برنهادند بر خاک روی"
  },
  {
    "poem_id": 1476,
    "vorder": 119,
    "position": 0,
    "text": "ستایش گرفتند بر کردگار"
  },
  {
    "poem_id": 1476,
    "vorder": 120,
    "position": 1,
    "text": "که او زنده باز آمد از کارزار"
  },
  {
    "poem_id": 1476,
    "vorder": 121,
    "position": 0,
    "text": "چو زان گونه دیدند بر خاک سر"
  },
  {
    "poem_id": 1476,
    "vorder": 122,
    "position": 1,
    "text": "دریده برو جامه و خسته بر"
  },
  {
    "poem_id": 1476,
    "vorder": 123,
    "position": 0,
    "text": "به پرسش گرفتند کاین کار چیست"
  },
  {
    "poem_id": 1476,
    "vorder": 124,
    "position": 1,
    "text": "ترادل برین گونه از بهر کیست"
  },
  {
    "poem_id": 1476,
    "vorder": 125,
    "position": 0,
    "text": "بگفت آن شگفتی که خود کرده بود"
  },
  {
    "poem_id": 1476,
    "vorder": 126,
    "position": 1,
    "text": "گرامی‌تر خود بیازرده بود"
  },
  {
    "poem_id": 1476,
    "vorder": 127,
    "position": 0,
    "text": "همه برگرفتند با او خروش"
  },
  {
    "poem_id": 1476,
    "vorder": 128,
    "position": 1,
    "text": "زمین پر خروش و هوا پر ز جوش"
  },
  {
    "poem_id": 1476,
    "vorder": 129,
    "position": 0,
    "text": "چنین گفت با سرفرازان که من"
  },
  {
    "poem_id": 1476,
    "vorder": 130,
    "position": 1,
    "text": "نه دل دارم امروز گویی نه تن"
  },
  {
    "poem_id": 1476,
    "vorder": 131,
    "position": 0,
    "text": "شما جنگ ترکان مجویید کس"
  },
  {
    "poem_id": 1476,
    "vorder": 132,
    "position": 1,
    "text": "همین بد که من کردم امروز بس"
  },
  {
    "poem_id": 1476,
    "vorder": 133,
    "position": 0,
    "text": "چو برگشت ازان جایگه پهلوان"
  },
  {
    "poem_id": 1476,
    "vorder": 134,
    "position": 1,
    "text": "بیامد بر پور خسته روان"
  },
  {
    "poem_id": 1476,
    "vorder": 135,
    "position": 0,
    "text": "بزرگان برفتند با او بهم"
  },
  {
    "poem_id": 1476,
    "vorder": 136,
    "position": 1,
    "text": "چو طوس و چو گودرز و چون گستهم"
  },
  {
    "poem_id": 1476,
    "vorder": 137,
    "position": 0,
    "text": "همه لشکر از بهر آن ارجمند"
  },
  {
    "poem_id": 1476,
    "vorder": 138,
    "position": 1,
    "text": "زبان برگشادند یکسر ز بند"
  },
  {
    "poem_id": 1476,
    "vorder": 139,
    "position": 0,
    "text": "که درمان این کار یزدان کند"
  },
  {
    "poem_id": 1476,
    "vorder": 140,
    "position": 1,
    "text": "مگر کاین سخن بر تو آسان کند"
  },
  {
    "poem_id": 1476,
    "vorder": 141,
    "position": 0,
    "text": "یکی دشنه بگرفت رستم به دست"
  },
  {
    "poem_id": 1476,
    "vorder": 142,
    "position": 1,
    "text": "که از تن ببرد سر خویش پست"
  },
  {
    "poem_id": 1476,
    "vorder": 143,
    "position": 0,
    "text": "بزرگان بدو اندر آویختند"
  },
  {
    "poem_id": 1476,
    "vorder": 144,
    "position": 1,
    "text": "ز مژگان همی خون فرو ریختند"
  },
  {
    "poem_id": 1476,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت گودرز کاکنون چه سود"
  },
  {
    "poem_id": 1476,
    "vorder": 146,
    "position": 1,
    "text": "که از روی گیتی برآری تو دود"
  },
  {
    "poem_id": 1476,
    "vorder": 147,
    "position": 0,
    "text": "تو بر خویشتن گر کنی صدگزند"
  },
  {
    "poem_id": 1476,
    "vorder": 148,
    "position": 1,
    "text": "چه آسانی آید بدان ارجمند"
  },
  {
    "poem_id": 1476,
    "vorder": 149,
    "position": 0,
    "text": "اگر ماند او را به گیتی زمان"
  },
  {
    "poem_id": 1476,
    "vorder": 150,
    "position": 1,
    "text": "بماند تو بی‌رنج با او بمان"
  },
  {
    "poem_id": 1476,
    "vorder": 151,
    "position": 0,
    "text": "وگر زین جهان این جوان رفتنیست"
  },
  {
    "poem_id": 1476,
    "vorder": 152,
    "position": 1,
    "text": "به گیتی نگه کن که جاوید کیست"
  },
  {
    "poem_id": 1476,
    "vorder": 153,
    "position": 0,
    "text": "شکاریم یکسر همه پیش مرگ"
  },
  {
    "poem_id": 1476,
    "vorder": 154,
    "position": 1,
    "text": "سری زیر تاج و سری زیر ترگ"
  }
]