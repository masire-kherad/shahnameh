[
  {
    "poem_id": 1466,
    "vorder": 1,
    "position": 0,
    "text": "چو برگشت سهراب گژدهم پیر"
  },
  {
    "poem_id": 1466,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد و بنشاند مردی دبیر"
  },
  {
    "poem_id": 1466,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامه بنوشت نزدیک شاه"
  },
  {
    "poem_id": 1466,
    "vorder": 4,
    "position": 1,
    "text": "برافگند پوینده مردی به راه"
  },
  {
    "poem_id": 1466,
    "vorder": 5,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1466,
    "vorder": 6,
    "position": 1,
    "text": "نمود آنگهی گردش روزگار"
  },
  {
    "poem_id": 1466,
    "vorder": 7,
    "position": 0,
    "text": "که آمد بر ما سپاهی گران"
  },
  {
    "poem_id": 1466,
    "vorder": 8,
    "position": 1,
    "text": "همه رزم جویان کندآوران"
  },
  {
    "poem_id": 1466,
    "vorder": 9,
    "position": 0,
    "text": "یکی پهلوانی به پیش اندرون"
  },
  {
    "poem_id": 1466,
    "vorder": 10,
    "position": 1,
    "text": "که سالش ده و دو نباشد فزون"
  },
  {
    "poem_id": 1466,
    "vorder": 11,
    "position": 0,
    "text": "به بالا ز سرو سهی برترست"
  },
  {
    "poem_id": 1466,
    "vorder": 12,
    "position": 1,
    "text": "چو خورشید تابان به دو پیکرست"
  },
  {
    "poem_id": 1466,
    "vorder": 13,
    "position": 0,
    "text": "برش چون بر پیل و بالاش برز"
  },
  {
    "poem_id": 1466,
    "vorder": 14,
    "position": 1,
    "text": "ندیدم کسی را چنان دست و گرز"
  },
  {
    "poem_id": 1466,
    "vorder": 15,
    "position": 0,
    "text": "چو شمشیر هندی به چنگ آیدش"
  },
  {
    "poem_id": 1466,
    "vorder": 16,
    "position": 1,
    "text": "ز دریا و از کوه تنگ آیدش"
  },
  {
    "poem_id": 1466,
    "vorder": 17,
    "position": 0,
    "text": "چو آواز او رعد غرنده نیست"
  },
  {
    "poem_id": 1466,
    "vorder": 18,
    "position": 1,
    "text": "چو بازوی او تیغ برنده نیست"
  },
  {
    "poem_id": 1466,
    "vorder": 19,
    "position": 0,
    "text": "هجیر دلاور میان را ببست"
  },
  {
    "poem_id": 1466,
    "vorder": 20,
    "position": 1,
    "text": "یکی بارهٔ تیزتگ برنشست"
  },
  {
    "poem_id": 1466,
    "vorder": 21,
    "position": 0,
    "text": "بشد پیش سهراب رزم‌آزمای"
  },
  {
    "poem_id": 1466,
    "vorder": 22,
    "position": 1,
    "text": "بر اسپش ندیدم فزون زان به پای"
  },
  {
    "poem_id": 1466,
    "vorder": 23,
    "position": 0,
    "text": "که بر هم زند مژه را جنگ‌جوی"
  },
  {
    "poem_id": 1466,
    "vorder": 24,
    "position": 1,
    "text": "گراید ز بینی سوی مغز بوی"
  },
  {
    "poem_id": 1466,
    "vorder": 25,
    "position": 0,
    "text": "که سهرابش از پشت زین برگرفت"
  },
  {
    "poem_id": 1466,
    "vorder": 26,
    "position": 1,
    "text": "برش ماند زان بازو اندر شگفت"
  },
  {
    "poem_id": 1466,
    "vorder": 27,
    "position": 0,
    "text": "درست‌ست و اکنون به زنهار اوست"
  },
  {
    "poem_id": 1466,
    "vorder": 28,
    "position": 1,
    "text": "پراندیشه جان از پی کار اوست"
  },
  {
    "poem_id": 1466,
    "vorder": 29,
    "position": 0,
    "text": "سواران ترکان بسی دیده‌ام"
  },
  {
    "poem_id": 1466,
    "vorder": 30,
    "position": 1,
    "text": "عنان پیچ زین‌گونه نشنیده‌ام"
  },
  {
    "poem_id": 1466,
    "vorder": 31,
    "position": 0,
    "text": "مبادا که او در میان دو صف"
  },
  {
    "poem_id": 1466,
    "vorder": 32,
    "position": 1,
    "text": "یکی مرد جنگ‌آور آرد بکف"
  },
  {
    "poem_id": 1466,
    "vorder": 33,
    "position": 0,
    "text": "بران کوه بخشایش آرد زمین"
  },
  {
    "poem_id": 1466,
    "vorder": 34,
    "position": 1,
    "text": "که او اسپ تازد برو روز کین"
  },
  {
    "poem_id": 1466,
    "vorder": 35,
    "position": 0,
    "text": "عنان‌دار چون او ندیدست کس"
  },
  {
    "poem_id": 1466,
    "vorder": 36,
    "position": 1,
    "text": "تو گفتی که سام سوارست و بس"
  },
  {
    "poem_id": 1466,
    "vorder": 37,
    "position": 0,
    "text": "بلندیش بر آسمان رفته گیر"
  },
  {
    "poem_id": 1466,
    "vorder": 38,
    "position": 1,
    "text": "سر بخت گردان همه خفته گیر"
  },
  {
    "poem_id": 1466,
    "vorder": 39,
    "position": 0,
    "text": "اگر خود شکیبیم یک چند نیز"
  },
  {
    "poem_id": 1466,
    "vorder": 40,
    "position": 1,
    "text": "نکوشیم و دیگر نگوییم چیز"
  },
  {
    "poem_id": 1466,
    "vorder": 41,
    "position": 0,
    "text": "اگر دم زند شهریار زمین"
  },
  {
    "poem_id": 1466,
    "vorder": 42,
    "position": 1,
    "text": "نراند سپاه و نسازد کمین"
  },
  {
    "poem_id": 1466,
    "vorder": 43,
    "position": 0,
    "text": "دژ و باره گیرد که خود زور هست"
  },
  {
    "poem_id": 1466,
    "vorder": 44,
    "position": 1,
    "text": "نگیرد کسی دست او را به دست"
  },
  {
    "poem_id": 1466,
    "vorder": 45,
    "position": 0,
    "text": "که این باره را نیست پایاب اوی"
  },
  {
    "poem_id": 1466,
    "vorder": 46,
    "position": 1,
    "text": "درنگی شود شیر زاشتاب اوی"
  },
  {
    "poem_id": 1466,
    "vorder": 47,
    "position": 0,
    "text": "چو نامه به مهر اندر آمد به شب"
  },
  {
    "poem_id": 1466,
    "vorder": 48,
    "position": 1,
    "text": "فرستاده را جست و بگشاد لب"
  },
  {
    "poem_id": 1466,
    "vorder": 49,
    "position": 0,
    "text": "بگفتش چنان رو که فردا پگاه"
  },
  {
    "poem_id": 1466,
    "vorder": 50,
    "position": 1,
    "text": "نبیند ترا هیچکس زان سپاه"
  },
  {
    "poem_id": 1466,
    "vorder": 51,
    "position": 0,
    "text": "فرستاد نامه سوی راه راست"
  },
  {
    "poem_id": 1466,
    "vorder": 52,
    "position": 1,
    "text": "پس نامه آنگاه بر پای خاست"
  },
  {
    "poem_id": 1466,
    "vorder": 53,
    "position": 0,
    "text": "بنه برنهاد و سراندر کشید"
  },
  {
    "poem_id": 1466,
    "vorder": 54,
    "position": 1,
    "text": "بران راه بی‌راه شد ناپدید"
  },
  {
    "poem_id": 1466,
    "vorder": 55,
    "position": 0,
    "text": "سوی شهر ایران نهادند روی"
  },
  {
    "poem_id": 1466,
    "vorder": 56,
    "position": 1,
    "text": "سپردند آن بارهٔ دژ بدوی"
  },
  {
    "poem_id": 1466,
    "vorder": 57,
    "position": 0,
    "text": "چو خورشید بر زد سر از تیره‌کوه"
  },
  {
    "poem_id": 1466,
    "vorder": 58,
    "position": 1,
    "text": "میان را ببستند ترکان گروه"
  },
  {
    "poem_id": 1466,
    "vorder": 59,
    "position": 0,
    "text": "سپهدار سهراب نیزه بدست"
  },
  {
    "poem_id": 1466,
    "vorder": 60,
    "position": 1,
    "text": "یکی بارکش باره‌ای برنشست"
  },
  {
    "poem_id": 1466,
    "vorder": 61,
    "position": 0,
    "text": "سوی باره آمد یکی بنگرید"
  },
  {
    "poem_id": 1466,
    "vorder": 62,
    "position": 1,
    "text": "به باره درون بس کسی را ندید"
  },
  {
    "poem_id": 1466,
    "vorder": 63,
    "position": 0,
    "text": "بیامد در دژ گشادند باز"
  },
  {
    "poem_id": 1466,
    "vorder": 64,
    "position": 1,
    "text": "ندیدند در دژ یکی رزمساز"
  },
  {
    "poem_id": 1466,
    "vorder": 65,
    "position": 0,
    "text": "به فرمان همه پیش او آمدند"
  },
  {
    "poem_id": 1466,
    "vorder": 66,
    "position": 1,
    "text": "به جان هرکسی چاره‌جو آمدند"
  },
  {
    "poem_id": 1466,
    "vorder": 67,
    "position": 0,
    "text": "چو نامه به نزدیک خسرو رسید"
  },
  {
    "poem_id": 1466,
    "vorder": 68,
    "position": 1,
    "text": "غمی شد دلش کان سخنها شنید"
  },
  {
    "poem_id": 1466,
    "vorder": 69,
    "position": 0,
    "text": "گرانمایگان را ز لشکر بخواند"
  },
  {
    "poem_id": 1466,
    "vorder": 70,
    "position": 1,
    "text": "وزین داستان چندگونه براند"
  },
  {
    "poem_id": 1466,
    "vorder": 71,
    "position": 0,
    "text": "نشستند با شاه ایران به هم"
  },
  {
    "poem_id": 1466,
    "vorder": 72,
    "position": 1,
    "text": "بزرگان لشکر همه بیش و کم"
  },
  {
    "poem_id": 1466,
    "vorder": 73,
    "position": 0,
    "text": "چو طوس و چو گودرز کشواد و گیو"
  },
  {
    "poem_id": 1466,
    "vorder": 74,
    "position": 1,
    "text": "چو گرگین و بهرام و فرهاد نیو"
  },
  {
    "poem_id": 1466,
    "vorder": 75,
    "position": 0,
    "text": "سپهدار نامه بر ایشان بخواند"
  },
  {
    "poem_id": 1466,
    "vorder": 76,
    "position": 1,
    "text": "بپرسید بسیار و خیره بماند"
  },
  {
    "poem_id": 1466,
    "vorder": 77,
    "position": 0,
    "text": "چنین گفت با پهلوانان براز"
  },
  {
    "poem_id": 1466,
    "vorder": 78,
    "position": 1,
    "text": "که این کار گردد به ما بر دراز"
  },
  {
    "poem_id": 1466,
    "vorder": 79,
    "position": 0,
    "text": "برین سان که گژدهم گوید همی"
  },
  {
    "poem_id": 1466,
    "vorder": 80,
    "position": 1,
    "text": "از اندیشه دل را بشوید همی"
  },
  {
    "poem_id": 1466,
    "vorder": 81,
    "position": 0,
    "text": "چه سازیم و درمان این کار چیست"
  },
  {
    "poem_id": 1466,
    "vorder": 82,
    "position": 1,
    "text": "از ایران هم آورد این مرد کیست"
  },
  {
    "poem_id": 1466,
    "vorder": 83,
    "position": 0,
    "text": "بر آن برنهادند یکسر که گیو"
  },
  {
    "poem_id": 1466,
    "vorder": 84,
    "position": 1,
    "text": "به زابل شود نزد سالار نیو"
  },
  {
    "poem_id": 1466,
    "vorder": 85,
    "position": 0,
    "text": "به رستم رساند از این آگهی"
  },
  {
    "poem_id": 1466,
    "vorder": 86,
    "position": 1,
    "text": "که با بیم شد تخت شاهنشهی"
  },
  {
    "poem_id": 1466,
    "vorder": 87,
    "position": 0,
    "text": "گو پیلتن را بدین رزمگاه"
  },
  {
    "poem_id": 1466,
    "vorder": 88,
    "position": 1,
    "text": "بخواند که اویست پشت سپاه"
  },
  {
    "poem_id": 1466,
    "vorder": 89,
    "position": 0,
    "text": "نشست آنگهی رای زد با دبیر"
  },
  {
    "poem_id": 1466,
    "vorder": 90,
    "position": 1,
    "text": "که کاری گزاینده بد ناگزیر"
  }
]