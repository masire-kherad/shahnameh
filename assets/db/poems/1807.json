[
  {
    "poem_id": 1807,
    "vorder": 1,
    "position": 0,
    "text": "چو زین آگهی شد به فغفور چین"
  },
  {
    "poem_id": 1807,
    "vorder": 2,
    "position": 1,
    "text": "که با فر مردی ز ایران زمین"
  },
  {
    "poem_id": 1807,
    "vorder": 3,
    "position": 0,
    "text": "به نزدیک شنگل فرستاده بود"
  },
  {
    "poem_id": 1807,
    "vorder": 4,
    "position": 1,
    "text": "همانا ز ایران تهم‌زاده بود"
  },
  {
    "poem_id": 1807,
    "vorder": 5,
    "position": 0,
    "text": "بدو داد شنگل یکی دخترش"
  },
  {
    "poem_id": 1807,
    "vorder": 6,
    "position": 1,
    "text": "که بر ماه ساید همی افسرش"
  },
  {
    "poem_id": 1807,
    "vorder": 7,
    "position": 0,
    "text": "یکی نامه نزدیک بهرامشاه"
  },
  {
    "poem_id": 1807,
    "vorder": 8,
    "position": 1,
    "text": "نوشت آن جهاندار با دستگاه"
  },
  {
    "poem_id": 1807,
    "vorder": 9,
    "position": 0,
    "text": "به عنوان بر از شهریار جهان"
  },
  {
    "poem_id": 1807,
    "vorder": 10,
    "position": 1,
    "text": "سر نامداران و شاه مهان"
  },
  {
    "poem_id": 1807,
    "vorder": 11,
    "position": 0,
    "text": "به نزد فرستادهٔ پارسی"
  },
  {
    "poem_id": 1807,
    "vorder": 12,
    "position": 1,
    "text": "که آمد به قنوج با یار سی"
  },
  {
    "poem_id": 1807,
    "vorder": 13,
    "position": 0,
    "text": "دگر گفت کامد بما آگهی"
  },
  {
    "poem_id": 1807,
    "vorder": 14,
    "position": 1,
    "text": "ز تو نامور مرد با فرهی"
  },
  {
    "poem_id": 1807,
    "vorder": 15,
    "position": 0,
    "text": "خردمندی و مردی و رای تو"
  },
  {
    "poem_id": 1807,
    "vorder": 16,
    "position": 1,
    "text": "فشرده به هرجای بر پای تو"
  },
  {
    "poem_id": 1807,
    "vorder": 17,
    "position": 0,
    "text": "کجا کرگ و آن نامور اژدها"
  },
  {
    "poem_id": 1807,
    "vorder": 18,
    "position": 1,
    "text": "ز شمشیر تیزت نیامد رها"
  },
  {
    "poem_id": 1807,
    "vorder": 19,
    "position": 0,
    "text": "بتو داد دختر که پیوند ماست"
  },
  {
    "poem_id": 1807,
    "vorder": 20,
    "position": 1,
    "text": "که هندوستان خاک او را بهاست"
  },
  {
    "poem_id": 1807,
    "vorder": 21,
    "position": 0,
    "text": "سر خویش را بردی اندر هوا"
  },
  {
    "poem_id": 1807,
    "vorder": 22,
    "position": 1,
    "text": "به پیوند این شاه فرمانروا"
  },
  {
    "poem_id": 1807,
    "vorder": 23,
    "position": 0,
    "text": "به ایران بزرگیست این شاه را"
  },
  {
    "poem_id": 1807,
    "vorder": 24,
    "position": 1,
    "text": "کجا کهترش افسر ماه را"
  },
  {
    "poem_id": 1807,
    "vorder": 25,
    "position": 0,
    "text": "به دستوری شاه در بر گرفت"
  },
  {
    "poem_id": 1807,
    "vorder": 26,
    "position": 1,
    "text": "به قنوج شد یار دیگر گرفت"
  },
  {
    "poem_id": 1807,
    "vorder": 27,
    "position": 0,
    "text": "کنون رنج بردار و ایدر بیای"
  },
  {
    "poem_id": 1807,
    "vorder": 28,
    "position": 1,
    "text": "بدین مرز چندانک باید به پای"
  },
  {
    "poem_id": 1807,
    "vorder": 29,
    "position": 0,
    "text": "به دیدار تو چشم روشن کنیم"
  },
  {
    "poem_id": 1807,
    "vorder": 30,
    "position": 1,
    "text": "روان را ز رای تو جوشن کنیم"
  },
  {
    "poem_id": 1807,
    "vorder": 31,
    "position": 0,
    "text": "چو خواهی که ز ایدر شوی باز جای"
  },
  {
    "poem_id": 1807,
    "vorder": 32,
    "position": 1,
    "text": "زمانی نگویم بر من بپای"
  },
  {
    "poem_id": 1807,
    "vorder": 33,
    "position": 0,
    "text": "برو شاد با خلعت و خواسته"
  },
  {
    "poem_id": 1807,
    "vorder": 34,
    "position": 1,
    "text": "خود و نامداران آراسته"
  },
  {
    "poem_id": 1807,
    "vorder": 35,
    "position": 0,
    "text": "ترا آمدن پیش من ننگ نیست"
  },
  {
    "poem_id": 1807,
    "vorder": 36,
    "position": 1,
    "text": "چو با شاه ایران مرا جنگ نیست"
  },
  {
    "poem_id": 1807,
    "vorder": 37,
    "position": 0,
    "text": "مکن سستی از آمدن هیچ رای"
  },
  {
    "poem_id": 1807,
    "vorder": 38,
    "position": 1,
    "text": "چو خواهی که برگردی ایدر مپای"
  },
  {
    "poem_id": 1807,
    "vorder": 39,
    "position": 0,
    "text": "چو نامه بیامد به بهرام گور"
  },
  {
    "poem_id": 1807,
    "vorder": 40,
    "position": 1,
    "text": "به دلش اندر افتاد زان نامه شور"
  },
  {
    "poem_id": 1807,
    "vorder": 41,
    "position": 0,
    "text": "نویسنده بر خواند و پاسخ نوشت"
  },
  {
    "poem_id": 1807,
    "vorder": 42,
    "position": 1,
    "text": "به پالیز کین بر درختی بکشت"
  },
  {
    "poem_id": 1807,
    "vorder": 43,
    "position": 0,
    "text": "سر نامه گفت آنچ گفتی رسید"
  },
  {
    "poem_id": 1807,
    "vorder": 44,
    "position": 1,
    "text": "دو چشم تو جز کشور چین ندید"
  },
  {
    "poem_id": 1807,
    "vorder": 45,
    "position": 0,
    "text": "به عنوان بر از پادشاه جهان"
  },
  {
    "poem_id": 1807,
    "vorder": 46,
    "position": 1,
    "text": "نوشتی سرافراز و تاج مهان"
  },
  {
    "poem_id": 1807,
    "vorder": 47,
    "position": 0,
    "text": "جز آن بد که گفتی سراسر سخن"
  },
  {
    "poem_id": 1807,
    "vorder": 48,
    "position": 1,
    "text": "بزرگی نو را نخواهم کهن"
  },
  {
    "poem_id": 1807,
    "vorder": 49,
    "position": 0,
    "text": "شهنشاه بهرام گورست و بس"
  },
  {
    "poem_id": 1807,
    "vorder": 50,
    "position": 1,
    "text": "چنو در زمانه ندانیم کس"
  },
  {
    "poem_id": 1807,
    "vorder": 51,
    "position": 0,
    "text": "به مردی و دانش به فر و نژاد"
  },
  {
    "poem_id": 1807,
    "vorder": 52,
    "position": 1,
    "text": "چنو پادشا کس ندارد به یاد"
  },
  {
    "poem_id": 1807,
    "vorder": 53,
    "position": 0,
    "text": "جهاندار پیروزگر خواندش"
  },
  {
    "poem_id": 1807,
    "vorder": 54,
    "position": 1,
    "text": "ز شاهان سرافرازتر خواندش"
  },
  {
    "poem_id": 1807,
    "vorder": 55,
    "position": 0,
    "text": "دگر آنک گفتی که من کرده‌ام"
  },
  {
    "poem_id": 1807,
    "vorder": 56,
    "position": 1,
    "text": "به هندوستان رنجها برده‌ام"
  },
  {
    "poem_id": 1807,
    "vorder": 57,
    "position": 0,
    "text": "همان اختر شاه بهرام بود"
  },
  {
    "poem_id": 1807,
    "vorder": 58,
    "position": 1,
    "text": "که با فر و اورند و بانام بود"
  },
  {
    "poem_id": 1807,
    "vorder": 59,
    "position": 0,
    "text": "هنر نیز ز ایرانیانست و بس"
  },
  {
    "poem_id": 1807,
    "vorder": 60,
    "position": 1,
    "text": "ندارند کرگ ژیان را به کس"
  },
  {
    "poem_id": 1807,
    "vorder": 61,
    "position": 0,
    "text": "همه یکدلانند و یزدان‌شناس"
  },
  {
    "poem_id": 1807,
    "vorder": 62,
    "position": 1,
    "text": "به نیکی ندارند ز اختر سپاس"
  },
  {
    "poem_id": 1807,
    "vorder": 63,
    "position": 0,
    "text": "دگر آنک دختر به من داد شاه"
  },
  {
    "poem_id": 1807,
    "vorder": 64,
    "position": 1,
    "text": "به مردی گرفتم چنین پیشگاه"
  },
  {
    "poem_id": 1807,
    "vorder": 65,
    "position": 0,
    "text": "یکی پادشا بود شنگل بزرگ"
  },
  {
    "poem_id": 1807,
    "vorder": 66,
    "position": 1,
    "text": "به مردی همی راند از میش گرگ"
  },
  {
    "poem_id": 1807,
    "vorder": 67,
    "position": 0,
    "text": "چو با من سزا دید پیوند خویش"
  },
  {
    "poem_id": 1807,
    "vorder": 68,
    "position": 1,
    "text": "به من داد شایسته فرزند خویش"
  },
  {
    "poem_id": 1807,
    "vorder": 69,
    "position": 0,
    "text": "دگر آنک گفتی که خیز ایدر آی"
  },
  {
    "poem_id": 1807,
    "vorder": 70,
    "position": 1,
    "text": "به نیکی بباشم ترا رهنمای"
  },
  {
    "poem_id": 1807,
    "vorder": 71,
    "position": 0,
    "text": "مرا شاه ایران فرستد به هند"
  },
  {
    "poem_id": 1807,
    "vorder": 72,
    "position": 1,
    "text": "به چین آیم از بهر چینی پرند"
  },
  {
    "poem_id": 1807,
    "vorder": 73,
    "position": 0,
    "text": "نباشد ز من بنده همداستان"
  },
  {
    "poem_id": 1807,
    "vorder": 74,
    "position": 1,
    "text": "که رانم بدین گونه‌بر داستان"
  },
  {
    "poem_id": 1807,
    "vorder": 75,
    "position": 0,
    "text": "دگر آنک گفتی که با خواسته"
  },
  {
    "poem_id": 1807,
    "vorder": 76,
    "position": 1,
    "text": "به ایران فرستمت آراسته"
  },
  {
    "poem_id": 1807,
    "vorder": 77,
    "position": 0,
    "text": "مرا کرد یزدان ازان بی‌نیاز"
  },
  {
    "poem_id": 1807,
    "vorder": 78,
    "position": 1,
    "text": "به چیز کسان دست کردن دراز"
  },
  {
    "poem_id": 1807,
    "vorder": 79,
    "position": 0,
    "text": "ز بهرام دارم به بخشش سپاس"
  },
  {
    "poem_id": 1807,
    "vorder": 80,
    "position": 1,
    "text": "نیایش کنم روز و شب در سه پاس"
  },
  {
    "poem_id": 1807,
    "vorder": 81,
    "position": 0,
    "text": "چهارم سخن گر ستودی مرا"
  },
  {
    "poem_id": 1807,
    "vorder": 82,
    "position": 1,
    "text": "هنر ز آنچ برتر فزودی مرا"
  },
  {
    "poem_id": 1807,
    "vorder": 83,
    "position": 0,
    "text": "پذیرفتم این از تو ای شاه چین"
  },
  {
    "poem_id": 1807,
    "vorder": 84,
    "position": 1,
    "text": "بگوییم با شاه ایران زمین"
  },
  {
    "poem_id": 1807,
    "vorder": 85,
    "position": 0,
    "text": "ز یزدان ترا باد چندان درود"
  },
  {
    "poem_id": 1807,
    "vorder": 86,
    "position": 1,
    "text": "که آن را نداند فلک تار و پود"
  },
  {
    "poem_id": 1807,
    "vorder": 87,
    "position": 0,
    "text": "بران نامه بنهاد مهر نگین"
  },
  {
    "poem_id": 1807,
    "vorder": 88,
    "position": 1,
    "text": "فرستاد پاسخ سوی شاه چین"
  }
]