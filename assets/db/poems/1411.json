[
  {
    "poem_id": 1411,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس بیاسود لشکر دو روز"
  },
  {
    "poem_id": 1411,
    "vorder": 2,
    "position": 1,
    "text": "سه دیگر چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 1411,
    "vorder": 3,
    "position": 0,
    "text": "نبد شاه را روزگار نبرد"
  },
  {
    "poem_id": 1411,
    "vorder": 4,
    "position": 1,
    "text": "به بیچارگی جنگ بایست کرد"
  },
  {
    "poem_id": 1411,
    "vorder": 5,
    "position": 0,
    "text": "ابا لشکر نوذر افراسیاب"
  },
  {
    "poem_id": 1411,
    "vorder": 6,
    "position": 1,
    "text": "چو دریای جوشان بد و رود آب"
  },
  {
    "poem_id": 1411,
    "vorder": 7,
    "position": 0,
    "text": "خروشیدن آمد ز پرده‌سرای"
  },
  {
    "poem_id": 1411,
    "vorder": 8,
    "position": 1,
    "text": "ابا نالهٔ کوس و هندی درای"
  },
  {
    "poem_id": 1411,
    "vorder": 9,
    "position": 0,
    "text": "تبیره برآمد ز درگاه شاه"
  },
  {
    "poem_id": 1411,
    "vorder": 10,
    "position": 1,
    "text": "نهادند بر سر ز آهن کلاه"
  },
  {
    "poem_id": 1411,
    "vorder": 11,
    "position": 0,
    "text": "به پرده‌سرای رد افراسیاب"
  },
  {
    "poem_id": 1411,
    "vorder": 12,
    "position": 1,
    "text": "کسی را سر اندر نیامد به خواب"
  },
  {
    "poem_id": 1411,
    "vorder": 13,
    "position": 0,
    "text": "همه شب همی لشکر آراستند"
  },
  {
    "poem_id": 1411,
    "vorder": 14,
    "position": 1,
    "text": "همی تیغ و ژوپین بپیراستند"
  },
  {
    "poem_id": 1411,
    "vorder": 15,
    "position": 0,
    "text": "زمین کوه تا کوه جوشن‌وران"
  },
  {
    "poem_id": 1411,
    "vorder": 16,
    "position": 1,
    "text": "برفتند با گرزهای گران"
  },
  {
    "poem_id": 1411,
    "vorder": 17,
    "position": 0,
    "text": "نبد کوه پیدا ز ریگ و ز شخ"
  },
  {
    "poem_id": 1411,
    "vorder": 18,
    "position": 1,
    "text": "ز دریا به دریا کشیدند نخ"
  },
  {
    "poem_id": 1411,
    "vorder": 19,
    "position": 0,
    "text": "بیاراست قارن به قلب اندرون"
  },
  {
    "poem_id": 1411,
    "vorder": 20,
    "position": 1,
    "text": "که با شاه باشد سپه را ستون"
  },
  {
    "poem_id": 1411,
    "vorder": 21,
    "position": 0,
    "text": "چپ شاه گرد تلیمان بخاست"
  },
  {
    "poem_id": 1411,
    "vorder": 22,
    "position": 1,
    "text": "چو شاپور نستوه بر دست راست"
  },
  {
    "poem_id": 1411,
    "vorder": 23,
    "position": 0,
    "text": "ز شبگیر تا خور ز گردون بگشت"
  },
  {
    "poem_id": 1411,
    "vorder": 24,
    "position": 1,
    "text": "نبد کوه پیدا نه دریا نه دشت"
  },
  {
    "poem_id": 1411,
    "vorder": 25,
    "position": 0,
    "text": "دل تیغ گفتی ببالد همی"
  },
  {
    "poem_id": 1411,
    "vorder": 26,
    "position": 1,
    "text": "زمین زیر اسپان بنالد همی"
  },
  {
    "poem_id": 1411,
    "vorder": 27,
    "position": 0,
    "text": "چو شد نیزه‌ها بر زمین سایه‌دار"
  },
  {
    "poem_id": 1411,
    "vorder": 28,
    "position": 1,
    "text": "شکست اندر آمد سوی مایه‌دار"
  },
  {
    "poem_id": 1411,
    "vorder": 29,
    "position": 0,
    "text": "چو آمد به بخت اندرون تیرگی"
  },
  {
    "poem_id": 1411,
    "vorder": 30,
    "position": 1,
    "text": "گرفتند ترکان برو چیرگی"
  },
  {
    "poem_id": 1411,
    "vorder": 31,
    "position": 0,
    "text": "بران سو که شاپور نستوه بود"
  },
  {
    "poem_id": 1411,
    "vorder": 32,
    "position": 1,
    "text": "پراگنده شد هرک انبوه بود"
  },
  {
    "poem_id": 1411,
    "vorder": 33,
    "position": 0,
    "text": "همی بود شاپور تا کشته شد"
  },
  {
    "poem_id": 1411,
    "vorder": 34,
    "position": 1,
    "text": "سر بخت ایرانیان گشته شد"
  },
  {
    "poem_id": 1411,
    "vorder": 35,
    "position": 0,
    "text": "از انبوه ترکان پرخاشجوی"
  },
  {
    "poem_id": 1411,
    "vorder": 36,
    "position": 1,
    "text": "به سوی دهستان نهادند روی"
  },
  {
    "poem_id": 1411,
    "vorder": 37,
    "position": 0,
    "text": "شب و روز بد بر گذرهاش جنگ"
  },
  {
    "poem_id": 1411,
    "vorder": 38,
    "position": 1,
    "text": "برآمد برین نیز چندی درنگ"
  },
  {
    "poem_id": 1411,
    "vorder": 39,
    "position": 0,
    "text": "چو نوذر فرو هشت پی در حصار"
  },
  {
    "poem_id": 1411,
    "vorder": 40,
    "position": 1,
    "text": "برو بسته شد راه جنگ سوار"
  },
  {
    "poem_id": 1411,
    "vorder": 41,
    "position": 0,
    "text": "سواران بیاراست افراسیاب"
  },
  {
    "poem_id": 1411,
    "vorder": 42,
    "position": 1,
    "text": "گرفتش ز جنگ درنگی شتاب"
  },
  {
    "poem_id": 1411,
    "vorder": 43,
    "position": 0,
    "text": "یکی نامور ترک را کرد یاد"
  },
  {
    "poem_id": 1411,
    "vorder": 44,
    "position": 1,
    "text": "سپهبد کروخان ویسه نژاد"
  },
  {
    "poem_id": 1411,
    "vorder": 45,
    "position": 0,
    "text": "سوی پارس فرمود تا برکشید"
  },
  {
    "poem_id": 1411,
    "vorder": 46,
    "position": 1,
    "text": "به راه بیابان سر اندر کشید"
  },
  {
    "poem_id": 1411,
    "vorder": 47,
    "position": 0,
    "text": "کزان سو بد ایرانیان را بنه"
  },
  {
    "poem_id": 1411,
    "vorder": 48,
    "position": 1,
    "text": "بجوید بنه مردم بدتنه"
  },
  {
    "poem_id": 1411,
    "vorder": 49,
    "position": 0,
    "text": "چو قارن شنود آنکه افراسیاب"
  },
  {
    "poem_id": 1411,
    "vorder": 50,
    "position": 1,
    "text": "گسی کرد لشکر به هنگام خواب"
  },
  {
    "poem_id": 1411,
    "vorder": 51,
    "position": 0,
    "text": "شد از رشک جوشان و دل کرد تنگ"
  },
  {
    "poem_id": 1411,
    "vorder": 52,
    "position": 1,
    "text": "بر نوذر آمد بسان پلنگ"
  },
  {
    "poem_id": 1411,
    "vorder": 53,
    "position": 0,
    "text": "که توران شه آن ناجوانمرد مرد"
  },
  {
    "poem_id": 1411,
    "vorder": 54,
    "position": 1,
    "text": "نگه کن که با شاه ایران چه کرد"
  },
  {
    "poem_id": 1411,
    "vorder": 55,
    "position": 0,
    "text": "سوی روی پوشیدگان سپاه"
  },
  {
    "poem_id": 1411,
    "vorder": 56,
    "position": 1,
    "text": "سپاهی فرستاد بی مر به راه"
  },
  {
    "poem_id": 1411,
    "vorder": 57,
    "position": 0,
    "text": "شبستان ماگر به دست آورد"
  },
  {
    "poem_id": 1411,
    "vorder": 58,
    "position": 1,
    "text": "برین نامداران شکست آورد"
  },
  {
    "poem_id": 1411,
    "vorder": 59,
    "position": 0,
    "text": "به ننگ اندرون سر شود ناپدید"
  },
  {
    "poem_id": 1411,
    "vorder": 60,
    "position": 1,
    "text": "به دنب کروخان بباید کشید"
  },
  {
    "poem_id": 1411,
    "vorder": 61,
    "position": 0,
    "text": "ترا خوردنی هست و آب روان"
  },
  {
    "poem_id": 1411,
    "vorder": 62,
    "position": 1,
    "text": "سپاهی به مهر تو دارد روان"
  },
  {
    "poem_id": 1411,
    "vorder": 63,
    "position": 0,
    "text": "همی باش و دل را مکن هیچ بد"
  },
  {
    "poem_id": 1411,
    "vorder": 64,
    "position": 1,
    "text": "که از شهریاران دلیری سزد"
  },
  {
    "poem_id": 1411,
    "vorder": 65,
    "position": 0,
    "text": "کنون من شوم بر پی این سپاه"
  },
  {
    "poem_id": 1411,
    "vorder": 66,
    "position": 1,
    "text": "بگیرم بریشان ز هر گونه راه"
  },
  {
    "poem_id": 1411,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت نوذر که این رای نیست"
  },
  {
    "poem_id": 1411,
    "vorder": 68,
    "position": 1,
    "text": "سپه را چو تو لشکرآرای نیست"
  },
  {
    "poem_id": 1411,
    "vorder": 69,
    "position": 0,
    "text": "ز بهر بنه رفت گستهم و طوس"
  },
  {
    "poem_id": 1411,
    "vorder": 70,
    "position": 1,
    "text": "بدانگه که برخاست آوای کوس"
  },
  {
    "poem_id": 1411,
    "vorder": 71,
    "position": 0,
    "text": "بدین زودی اندر شبستان رسد"
  },
  {
    "poem_id": 1411,
    "vorder": 72,
    "position": 1,
    "text": "کند ساز ایشان چنان چون سزد"
  },
  {
    "poem_id": 1411,
    "vorder": 73,
    "position": 0,
    "text": "نشستند بر خوان و می خواستند"
  },
  {
    "poem_id": 1411,
    "vorder": 74,
    "position": 1,
    "text": "زمانی دل از غم بپیراستند"
  },
  {
    "poem_id": 1411,
    "vorder": 75,
    "position": 0,
    "text": "پس آنگه سوی خان قارن شدند"
  },
  {
    "poem_id": 1411,
    "vorder": 76,
    "position": 1,
    "text": "همه دیده چون ابر بهمن شدند"
  },
  {
    "poem_id": 1411,
    "vorder": 77,
    "position": 0,
    "text": "سخن را فگندند هر گونه بن"
  },
  {
    "poem_id": 1411,
    "vorder": 78,
    "position": 1,
    "text": "بران برنهادند یکسر سخن"
  },
  {
    "poem_id": 1411,
    "vorder": 79,
    "position": 0,
    "text": "که ما را سوی پارس باید کشید"
  },
  {
    "poem_id": 1411,
    "vorder": 80,
    "position": 1,
    "text": "نباید برین جایگاه آرمید"
  },
  {
    "poem_id": 1411,
    "vorder": 81,
    "position": 0,
    "text": "چو پوشیده رویان ایران سپاه"
  },
  {
    "poem_id": 1411,
    "vorder": 82,
    "position": 1,
    "text": "اسیران شوند از بد کینه‌خواه"
  },
  {
    "poem_id": 1411,
    "vorder": 83,
    "position": 0,
    "text": "که گیرد بدین دشت نیزه به دست"
  },
  {
    "poem_id": 1411,
    "vorder": 84,
    "position": 1,
    "text": "کرا باشد آرام و جای نشست"
  },
  {
    "poem_id": 1411,
    "vorder": 85,
    "position": 0,
    "text": "چو شیدوش و کشواد و قارن بهم"
  },
  {
    "poem_id": 1411,
    "vorder": 86,
    "position": 1,
    "text": "زدند اندرین رای بر بیش و کم"
  },
  {
    "poem_id": 1411,
    "vorder": 87,
    "position": 0,
    "text": "چو نیمی گذشت از شب دیریاز"
  },
  {
    "poem_id": 1411,
    "vorder": 88,
    "position": 1,
    "text": "دلیران به رفتن گرفتند ساز"
  },
  {
    "poem_id": 1411,
    "vorder": 89,
    "position": 0,
    "text": "بدین روی دژدار بد گژدهم"
  },
  {
    "poem_id": 1411,
    "vorder": 90,
    "position": 1,
    "text": "دلیران بیدار با او بهم"
  },
  {
    "poem_id": 1411,
    "vorder": 91,
    "position": 0,
    "text": "وزان روی دژ بارمان و سپاه"
  },
  {
    "poem_id": 1411,
    "vorder": 92,
    "position": 1,
    "text": "ابا کوس و پیلان نشسته به راه"
  },
  {
    "poem_id": 1411,
    "vorder": 93,
    "position": 0,
    "text": "کزو قارن رزم‌زن خسته بود"
  },
  {
    "poem_id": 1411,
    "vorder": 94,
    "position": 1,
    "text": "به خون برادر کمربسته بود"
  },
  {
    "poem_id": 1411,
    "vorder": 95,
    "position": 0,
    "text": "برآویخت چون شیر با بارمان"
  },
  {
    "poem_id": 1411,
    "vorder": 96,
    "position": 1,
    "text": "سوی چاره جستن ندادش زمان"
  },
  {
    "poem_id": 1411,
    "vorder": 97,
    "position": 0,
    "text": "یکی نیزه زد بر کمربند اوی"
  },
  {
    "poem_id": 1411,
    "vorder": 98,
    "position": 1,
    "text": "که بگسست بنیاد و پیوند اوی"
  },
  {
    "poem_id": 1411,
    "vorder": 99,
    "position": 0,
    "text": "سپه سر به سر دل شکسته شدند"
  },
  {
    "poem_id": 1411,
    "vorder": 100,
    "position": 1,
    "text": "همه یک ز دیگر گسسته شدند"
  },
  {
    "poem_id": 1411,
    "vorder": 101,
    "position": 0,
    "text": "سپهبد سوی پارس بنهاد روی"
  },
  {
    "poem_id": 1411,
    "vorder": 102,
    "position": 1,
    "text": "ابا نامور لشکر جنگ‌جوی"
  }
]