[
  {
    "poem_id": 1630,
    "vorder": 1,
    "position": 0,
    "text": "چو دارا به دل سوک داراب داشت"
  },
  {
    "poem_id": 1630,
    "vorder": 2,
    "position": 1,
    "text": "به خورشید تاج مهی برفراشت"
  },
  {
    "poem_id": 1630,
    "vorder": 3,
    "position": 0,
    "text": "یکی مرد بد تیز و برنا و تند"
  },
  {
    "poem_id": 1630,
    "vorder": 4,
    "position": 1,
    "text": "شده با زبان و دلش تیغ کند"
  },
  {
    "poem_id": 1630,
    "vorder": 5,
    "position": 0,
    "text": "چو بنشست برگاه گفت ای سران"
  },
  {
    "poem_id": 1630,
    "vorder": 6,
    "position": 1,
    "text": "سرافراز گردان و کنداوران"
  },
  {
    "poem_id": 1630,
    "vorder": 7,
    "position": 0,
    "text": "سری را نخواهم که افتد به چاه"
  },
  {
    "poem_id": 1630,
    "vorder": 8,
    "position": 1,
    "text": "نه از چاه خوانم سوی تخت و گاه"
  },
  {
    "poem_id": 1630,
    "vorder": 9,
    "position": 0,
    "text": "کسی کو ز فرمان من بگذرد"
  },
  {
    "poem_id": 1630,
    "vorder": 10,
    "position": 1,
    "text": "سرش را همی تن به سر نشمرد"
  },
  {
    "poem_id": 1630,
    "vorder": 11,
    "position": 0,
    "text": "وگر هیچ تاب اندر آرد به دل"
  },
  {
    "poem_id": 1630,
    "vorder": 12,
    "position": 1,
    "text": "به شمشیر باشم ورا دلگسل"
  },
  {
    "poem_id": 1630,
    "vorder": 13,
    "position": 0,
    "text": "جز از ما هرانکس که دارند گنج"
  },
  {
    "poem_id": 1630,
    "vorder": 14,
    "position": 1,
    "text": "نخواهم کسی شاددل ما به رنج"
  },
  {
    "poem_id": 1630,
    "vorder": 15,
    "position": 0,
    "text": "نخواهم که باشد مرا رهنمای"
  },
  {
    "poem_id": 1630,
    "vorder": 16,
    "position": 1,
    "text": "منم رهنمای و منم دلگشای"
  },
  {
    "poem_id": 1630,
    "vorder": 17,
    "position": 0,
    "text": "ز گیتی خور و بخش و پیمان مراست"
  },
  {
    "poem_id": 1630,
    "vorder": 18,
    "position": 1,
    "text": "بزرگی و شاهی و فرمان مراست"
  },
  {
    "poem_id": 1630,
    "vorder": 19,
    "position": 0,
    "text": "دبیر خردمند را پیش خواند"
  },
  {
    "poem_id": 1630,
    "vorder": 20,
    "position": 1,
    "text": "ز هر در فراوان سخنها براند"
  },
  {
    "poem_id": 1630,
    "vorder": 21,
    "position": 0,
    "text": "یکی نامه بنوشت فرخ دبیر"
  },
  {
    "poem_id": 1630,
    "vorder": 22,
    "position": 1,
    "text": "ز دارای داراب بن اردشیر"
  },
  {
    "poem_id": 1630,
    "vorder": 23,
    "position": 0,
    "text": "بهر سو که بد شاه و خودکامه‌ای"
  },
  {
    "poem_id": 1630,
    "vorder": 24,
    "position": 1,
    "text": "بفرمود چون خنجری نامه‌ای"
  },
  {
    "poem_id": 1630,
    "vorder": 25,
    "position": 0,
    "text": "که هرکو ز رای و ز فرمان من"
  },
  {
    "poem_id": 1630,
    "vorder": 26,
    "position": 1,
    "text": "بپیچد ببیند سرافشان من"
  },
  {
    "poem_id": 1630,
    "vorder": 27,
    "position": 0,
    "text": "همه گوش یکسر به فرمان نهید"
  },
  {
    "poem_id": 1630,
    "vorder": 28,
    "position": 1,
    "text": "اگر جان ستانید اگر جان دهید"
  },
  {
    "poem_id": 1630,
    "vorder": 29,
    "position": 0,
    "text": "سر گنجهای پدر برگشاد"
  },
  {
    "poem_id": 1630,
    "vorder": 30,
    "position": 1,
    "text": "سپه را همه خواند و روزی بداد"
  },
  {
    "poem_id": 1630,
    "vorder": 31,
    "position": 0,
    "text": "ز چار اندرآمد درم تا بهشت"
  },
  {
    "poem_id": 1630,
    "vorder": 32,
    "position": 1,
    "text": "یکی را بجام و یکی را به تشت"
  },
  {
    "poem_id": 1630,
    "vorder": 33,
    "position": 0,
    "text": "درم داد و دینار و برگستوان"
  },
  {
    "poem_id": 1630,
    "vorder": 34,
    "position": 1,
    "text": "همان جوشن و تیغ و گرز گران"
  },
  {
    "poem_id": 1630,
    "vorder": 35,
    "position": 0,
    "text": "هرانکس که بد کار دیده سری"
  },
  {
    "poem_id": 1630,
    "vorder": 36,
    "position": 1,
    "text": "ببخشید بر هر سری کشوری"
  },
  {
    "poem_id": 1630,
    "vorder": 37,
    "position": 0,
    "text": "یکی را ز گردنکشان مرز داد"
  },
  {
    "poem_id": 1630,
    "vorder": 38,
    "position": 1,
    "text": "سپه را همه چیز باارز داد"
  },
  {
    "poem_id": 1630,
    "vorder": 39,
    "position": 0,
    "text": "فرستاده آمد ز هر کشوری"
  },
  {
    "poem_id": 1630,
    "vorder": 40,
    "position": 1,
    "text": "ز هر نامداری و هر مهتری"
  },
  {
    "poem_id": 1630,
    "vorder": 41,
    "position": 0,
    "text": "ز هند و ز خاقان و فغفور چین"
  },
  {
    "poem_id": 1630,
    "vorder": 42,
    "position": 1,
    "text": "ز روم و ز هر کشوری همچنین"
  },
  {
    "poem_id": 1630,
    "vorder": 43,
    "position": 0,
    "text": "همه پاک با هدیه و باژ و ساو"
  },
  {
    "poem_id": 1630,
    "vorder": 44,
    "position": 1,
    "text": "نه پی بود با او کسی را نه تاو"
  },
  {
    "poem_id": 1630,
    "vorder": 45,
    "position": 0,
    "text": "یکی شارستان کرد نوشاد نام"
  },
  {
    "poem_id": 1630,
    "vorder": 46,
    "position": 1,
    "text": "به اهواز گشتند زو شادکام"
  },
  {
    "poem_id": 1630,
    "vorder": 47,
    "position": 0,
    "text": "کسی را که درویش بد داد داد"
  },
  {
    "poem_id": 1630,
    "vorder": 48,
    "position": 1,
    "text": "به خواهندگان گنج و بنیاد داد"
  }
]