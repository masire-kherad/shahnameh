[
  {
    "poem_id": 87962,
    "vorder": 1,
    "position": 0,
    "text": "وزان پس چنین گفت با سرکشان"
  },
  {
    "poem_id": 87962,
    "vorder": 2,
    "position": 1,
    "text": "که ای نامداران گردنکشان"
  },
  {
    "poem_id": 87962,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامور خواهم و نامجوی"
  },
  {
    "poem_id": 87962,
    "vorder": 4,
    "position": 1,
    "text": "کز ایدر نهد سوی آن ترک روی"
  },
  {
    "poem_id": 87962,
    "vorder": 5,
    "position": 0,
    "text": "سرش را ببرد بخنجر ز تن"
  },
  {
    "poem_id": 87962,
    "vorder": 6,
    "position": 1,
    "text": "بپیش من آرد بدین انجمن"
  },
  {
    "poem_id": 87962,
    "vorder": 7,
    "position": 0,
    "text": "میان را ببست اندران ریونیز"
  },
  {
    "poem_id": 87962,
    "vorder": 8,
    "position": 1,
    "text": "همی زان نبردش سرآمد قفیز"
  },
  {
    "poem_id": 87962,
    "vorder": 9,
    "position": 0,
    "text": "بدو گفت بهرام کای پهلوان"
  },
  {
    "poem_id": 87962,
    "vorder": 10,
    "position": 1,
    "text": "مکن هیچ برخیره تیره روان"
  },
  {
    "poem_id": 87962,
    "vorder": 11,
    "position": 0,
    "text": "بترس از خداوند خورشید و ماه"
  },
  {
    "poem_id": 87962,
    "vorder": 12,
    "position": 1,
    "text": "دلت را بشرم آور از روی شاه"
  },
  {
    "poem_id": 87962,
    "vorder": 13,
    "position": 0,
    "text": "که پیوند اویست و همزاد اوی"
  },
  {
    "poem_id": 87962,
    "vorder": 14,
    "position": 1,
    "text": "سواریست نام‌آور و جنگ‌جوی"
  },
  {
    "poem_id": 87962,
    "vorder": 15,
    "position": 0,
    "text": "که گر یک سوار از میان سپاه"
  },
  {
    "poem_id": 87962,
    "vorder": 16,
    "position": 1,
    "text": "شود نزد آن پرهنر پور شاه"
  },
  {
    "poem_id": 87962,
    "vorder": 17,
    "position": 0,
    "text": "ز چنگش رهایی نیابد بجان"
  },
  {
    "poem_id": 87962,
    "vorder": 18,
    "position": 1,
    "text": "غم آری همی بر دل شادمان"
  },
  {
    "poem_id": 87962,
    "vorder": 19,
    "position": 0,
    "text": "سپهبد شد آشفته از گفت اوی"
  },
  {
    "poem_id": 87962,
    "vorder": 20,
    "position": 1,
    "text": "نبد پند بهرام یل جفت اوی"
  },
  {
    "poem_id": 87962,
    "vorder": 21,
    "position": 0,
    "text": "بفرمود تا نامبردار چند"
  },
  {
    "poem_id": 87962,
    "vorder": 22,
    "position": 1,
    "text": "بتازند نزدیک کوه بلند"
  },
  {
    "poem_id": 87962,
    "vorder": 23,
    "position": 0,
    "text": "ز گردان فراوان برون تاختند"
  },
  {
    "poem_id": 87962,
    "vorder": 24,
    "position": 1,
    "text": "نبرد وراگردن افراختند"
  },
  {
    "poem_id": 87962,
    "vorder": 25,
    "position": 0,
    "text": "بدیشان چنین گفت بهرام گرد"
  },
  {
    "poem_id": 87962,
    "vorder": 26,
    "position": 1,
    "text": "که این کار یکسر مدارید خرد"
  },
  {
    "poem_id": 87962,
    "vorder": 27,
    "position": 0,
    "text": "بدان کوه سر خویش کیخسروست"
  },
  {
    "poem_id": 87962,
    "vorder": 28,
    "position": 1,
    "text": "که یک موی او به ز صد پهلوست"
  },
  {
    "poem_id": 87962,
    "vorder": 29,
    "position": 0,
    "text": "هران کس که روی سیاوش بدید"
  },
  {
    "poem_id": 87962,
    "vorder": 30,
    "position": 1,
    "text": "نیارد ز دیدار او آرمید"
  },
  {
    "poem_id": 87962,
    "vorder": 31,
    "position": 0,
    "text": "چو بهرام داد از فرود این نشان"
  },
  {
    "poem_id": 87962,
    "vorder": 32,
    "position": 1,
    "text": "ز ره بازگشتند گردنکشان"
  },
  {
    "poem_id": 87962,
    "vorder": 33,
    "position": 0,
    "text": "بیامد دگرباره داماد طوس"
  },
  {
    "poem_id": 87962,
    "vorder": 34,
    "position": 1,
    "text": "همی کرد گردون برو بر فسوس"
  },
  {
    "poem_id": 87962,
    "vorder": 35,
    "position": 0,
    "text": "ز راه چرم بر سپدکوه شد"
  },
  {
    "poem_id": 87962,
    "vorder": 36,
    "position": 1,
    "text": "دلش پرجفا بود نستوه شد"
  },
  {
    "poem_id": 87962,
    "vorder": 37,
    "position": 0,
    "text": "چو از تیغ بالا فرودش بدید"
  },
  {
    "poem_id": 87962,
    "vorder": 38,
    "position": 1,
    "text": "ز قربان کمان کیان برکشید"
  },
  {
    "poem_id": 87962,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت با رزم دیده تخوار"
  },
  {
    "poem_id": 87962,
    "vorder": 40,
    "position": 1,
    "text": "که طوس آن سخنها گرفتست خوار"
  },
  {
    "poem_id": 87962,
    "vorder": 41,
    "position": 0,
    "text": "که آمد سواری و بهرام نیست"
  },
  {
    "poem_id": 87962,
    "vorder": 42,
    "position": 1,
    "text": "مرا دل درشتست و پدرام نیست"
  },
  {
    "poem_id": 87962,
    "vorder": 43,
    "position": 0,
    "text": "ببین تا مگر یادت آید که کیست"
  },
  {
    "poem_id": 87962,
    "vorder": 44,
    "position": 1,
    "text": "سراپای در آهن از بهر چیست"
  },
  {
    "poem_id": 87962,
    "vorder": 45,
    "position": 0,
    "text": "چنین داد پاسخ مر او را تخوار"
  },
  {
    "poem_id": 87962,
    "vorder": 46,
    "position": 1,
    "text": "که این ریونیزست گرد و سوار"
  },
  {
    "poem_id": 87962,
    "vorder": 47,
    "position": 0,
    "text": "چهل خواهرستش چو خرم بهار"
  },
  {
    "poem_id": 87962,
    "vorder": 48,
    "position": 1,
    "text": "پسر خود جزین نیست اندر تبار"
  },
  {
    "poem_id": 87962,
    "vorder": 49,
    "position": 0,
    "text": "فریبنده و ریمن و چاپلوس"
  },
  {
    "poem_id": 87962,
    "vorder": 50,
    "position": 1,
    "text": "دلیر و جوانست و داماد طوس"
  },
  {
    "poem_id": 87962,
    "vorder": 51,
    "position": 0,
    "text": "چنین گفت با مرد بینا فرود"
  },
  {
    "poem_id": 87962,
    "vorder": 52,
    "position": 1,
    "text": "که هنگام جنگ این نباید شنود"
  },
  {
    "poem_id": 87962,
    "vorder": 53,
    "position": 0,
    "text": "چو آید به پیکار کنداوران"
  },
  {
    "poem_id": 87962,
    "vorder": 54,
    "position": 1,
    "text": "بخوابمش بر دامن خواهران"
  },
  {
    "poem_id": 87962,
    "vorder": 55,
    "position": 0,
    "text": "بدو گر کند باد کلکم گذار"
  },
  {
    "poem_id": 87962,
    "vorder": 56,
    "position": 1,
    "text": "اگر زنده ماند بمردم مدار"
  },
  {
    "poem_id": 87962,
    "vorder": 57,
    "position": 0,
    "text": "بتیر اسپ بیجان کنم گر سوار"
  },
  {
    "poem_id": 87962,
    "vorder": 58,
    "position": 1,
    "text": "چه گویی تو ای کار دیده تخوار"
  },
  {
    "poem_id": 87962,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت بر مرد بگشای بر"
  },
  {
    "poem_id": 87962,
    "vorder": 60,
    "position": 1,
    "text": "مگر طوس را زو بسوزد جگر"
  },
  {
    "poem_id": 87962,
    "vorder": 61,
    "position": 0,
    "text": "بداند که تو دل بیاراستی"
  },
  {
    "poem_id": 87962,
    "vorder": 62,
    "position": 1,
    "text": "که بااو همی آشتی خواستی"
  },
  {
    "poem_id": 87962,
    "vorder": 63,
    "position": 0,
    "text": "چنین با تو بر خیره جنگ آورد"
  },
  {
    "poem_id": 87962,
    "vorder": 64,
    "position": 1,
    "text": "همی بر برادرت ننگ آورد"
  },
  {
    "poem_id": 87962,
    "vorder": 65,
    "position": 0,
    "text": "چو از دور نزدیک شد ریونیز"
  },
  {
    "poem_id": 87962,
    "vorder": 66,
    "position": 1,
    "text": "بزه برکشید آن خمانیده شیز"
  },
  {
    "poem_id": 87962,
    "vorder": 67,
    "position": 0,
    "text": "ز بالا خدنگی بزد بر برش"
  },
  {
    "poem_id": 87962,
    "vorder": 68,
    "position": 1,
    "text": "که بر دوخت با ترگ رومی سرش"
  },
  {
    "poem_id": 87962,
    "vorder": 69,
    "position": 0,
    "text": "بیفتاد و برگشت زو اسپ تیز"
  },
  {
    "poem_id": 87962,
    "vorder": 70,
    "position": 1,
    "text": "بخاک اندر آمد سر ریو نیز"
  },
  {
    "poem_id": 87962,
    "vorder": 71,
    "position": 0,
    "text": "ببالا چو طوس از میم بنگرید"
  },
  {
    "poem_id": 87962,
    "vorder": 72,
    "position": 1,
    "text": "شد آن کوه بر چشم او ناپدید"
  },
  {
    "poem_id": 87962,
    "vorder": 73,
    "position": 0,
    "text": "چنین داستان زد یکی پرخرد"
  },
  {
    "poem_id": 87962,
    "vorder": 74,
    "position": 1,
    "text": "که از خوی بد کوه کیفر برد"
  }
]