[
  {
    "poem_id": 87983,
    "vorder": 1,
    "position": 0,
    "text": "بیاراست لشکر سپهدار طوس"
  },
  {
    "poem_id": 87983,
    "vorder": 2,
    "position": 1,
    "text": "بپیلان جنگی و مردان و کوس"
  },
  {
    "poem_id": 87983,
    "vorder": 3,
    "position": 0,
    "text": "پیاده سوی کوه شد با بنه"
  },
  {
    "poem_id": 87983,
    "vorder": 4,
    "position": 1,
    "text": "سپهدار گودرز بر میمنه"
  },
  {
    "poem_id": 87983,
    "vorder": 5,
    "position": 0,
    "text": "رده برکشیده همه یکسره"
  },
  {
    "poem_id": 87983,
    "vorder": 6,
    "position": 1,
    "text": "چو رهام گودرز بر میسره"
  },
  {
    "poem_id": 87983,
    "vorder": 7,
    "position": 0,
    "text": "ز نالیدن کوس با کرنای"
  },
  {
    "poem_id": 87983,
    "vorder": 8,
    "position": 1,
    "text": "همی آسمان اندر آمد ز جای"
  },
  {
    "poem_id": 87983,
    "vorder": 9,
    "position": 0,
    "text": "دل چرخ گردان بدو چاک شد"
  },
  {
    "poem_id": 87983,
    "vorder": 10,
    "position": 1,
    "text": "همه کام خورشید پرخاک شد"
  },
  {
    "poem_id": 87983,
    "vorder": 11,
    "position": 0,
    "text": "چنان شد که کس روی هامون ندید"
  },
  {
    "poem_id": 87983,
    "vorder": 12,
    "position": 1,
    "text": "ز بس گرد کز رزمگه بردمید"
  },
  {
    "poem_id": 87983,
    "vorder": 13,
    "position": 0,
    "text": "ببارید الماس از تیره میغ"
  },
  {
    "poem_id": 87983,
    "vorder": 14,
    "position": 1,
    "text": "همی آتش افروخت از گرز و تیغ"
  },
  {
    "poem_id": 87983,
    "vorder": 15,
    "position": 0,
    "text": "سنانهای رخشان و تیغ سران"
  },
  {
    "poem_id": 87983,
    "vorder": 16,
    "position": 1,
    "text": "درفش از بر و زیر گرز گران"
  },
  {
    "poem_id": 87983,
    "vorder": 17,
    "position": 0,
    "text": "هوا گفتی از گرز و از آهنست"
  },
  {
    "poem_id": 87983,
    "vorder": 18,
    "position": 1,
    "text": "زمین یکسر از نعل در جوشنست"
  },
  {
    "poem_id": 87983,
    "vorder": 19,
    "position": 0,
    "text": "چو دریای خون شد همه دشت و راغ"
  },
  {
    "poem_id": 87983,
    "vorder": 20,
    "position": 1,
    "text": "جهان چون شب و تیغها چون چراغ"
  },
  {
    "poem_id": 87983,
    "vorder": 21,
    "position": 0,
    "text": "ز بس نالهٔ کوس با کرنای"
  },
  {
    "poem_id": 87983,
    "vorder": 22,
    "position": 1,
    "text": "همی کس ندانست سر را ز پای"
  },
  {
    "poem_id": 87983,
    "vorder": 23,
    "position": 0,
    "text": "سپهبد به گودرز گفت آن زمان"
  },
  {
    "poem_id": 87983,
    "vorder": 24,
    "position": 1,
    "text": "که تاریک شد گردش آسمان"
  },
  {
    "poem_id": 87983,
    "vorder": 25,
    "position": 0,
    "text": "مرا گفته بود این ستاره‌شناس"
  },
  {
    "poem_id": 87983,
    "vorder": 26,
    "position": 1,
    "text": "که امروز تا شب گذشته سه پاس"
  },
  {
    "poem_id": 87983,
    "vorder": 27,
    "position": 0,
    "text": "ز شمشیر گردان چو ابر سیاه"
  },
  {
    "poem_id": 87983,
    "vorder": 28,
    "position": 1,
    "text": "همی خون فشاند به آوردگاه"
  },
  {
    "poem_id": 87983,
    "vorder": 29,
    "position": 0,
    "text": "سرانجام ترسم که پیروزگر"
  },
  {
    "poem_id": 87983,
    "vorder": 30,
    "position": 1,
    "text": "نباشد مگر دشمن کینه ور"
  },
  {
    "poem_id": 87983,
    "vorder": 31,
    "position": 0,
    "text": "چو شیدوش و رهام و گستهم و گیو"
  },
  {
    "poem_id": 87983,
    "vorder": 32,
    "position": 1,
    "text": "زره‌دار خراد و برزین نیو"
  },
  {
    "poem_id": 87983,
    "vorder": 33,
    "position": 0,
    "text": "ز صف در میان سپاه آمدند"
  },
  {
    "poem_id": 87983,
    "vorder": 34,
    "position": 1,
    "text": "جگر خسته و کینه‌خواه آمدند"
  },
  {
    "poem_id": 87983,
    "vorder": 35,
    "position": 0,
    "text": "بابر اندر آمد ز هر سو غریو"
  },
  {
    "poem_id": 87983,
    "vorder": 36,
    "position": 1,
    "text": "بسان شب تار و انبوه دیو"
  },
  {
    "poem_id": 87983,
    "vorder": 37,
    "position": 0,
    "text": "وزان روی هومان بکردار کوه"
  },
  {
    "poem_id": 87983,
    "vorder": 38,
    "position": 1,
    "text": "بیاورد لشکر همه همگروه"
  },
  {
    "poem_id": 87983,
    "vorder": 39,
    "position": 0,
    "text": "وزان پس گزیدند مردان مرد"
  },
  {
    "poem_id": 87983,
    "vorder": 40,
    "position": 1,
    "text": "که بردشت سازند جای نبرد"
  },
  {
    "poem_id": 87983,
    "vorder": 41,
    "position": 0,
    "text": "گرازه سر گیوگان با نهل"
  },
  {
    "poem_id": 87983,
    "vorder": 42,
    "position": 1,
    "text": "دو گرد گرانمایهٔ شیردل"
  },
  {
    "poem_id": 87983,
    "vorder": 43,
    "position": 0,
    "text": "چو رهام گودرز و فرشیدورد"
  },
  {
    "poem_id": 87983,
    "vorder": 44,
    "position": 1,
    "text": "چو شیدوش و لهاک شد هم نبرد"
  },
  {
    "poem_id": 87983,
    "vorder": 45,
    "position": 0,
    "text": "ابا بیژن گیو کلباد را"
  },
  {
    "poem_id": 87983,
    "vorder": 46,
    "position": 1,
    "text": "که بر هم زدی آتش و باد را"
  },
  {
    "poem_id": 87983,
    "vorder": 47,
    "position": 0,
    "text": "ابا شطرخ نامور گیو را"
  },
  {
    "poem_id": 87983,
    "vorder": 48,
    "position": 1,
    "text": "دو گرد گرانمایهٔ نیو را"
  },
  {
    "poem_id": 87983,
    "vorder": 49,
    "position": 0,
    "text": "چو گودرز و پیران و هومان و طوس"
  },
  {
    "poem_id": 87983,
    "vorder": 50,
    "position": 1,
    "text": "نبد هیچ پیدا درنگ و فسوس"
  },
  {
    "poem_id": 87983,
    "vorder": 51,
    "position": 0,
    "text": "چنین گفت هومان که امروز کار"
  },
  {
    "poem_id": 87983,
    "vorder": 52,
    "position": 1,
    "text": "نباید که چون دی بود کارزار"
  },
  {
    "poem_id": 87983,
    "vorder": 53,
    "position": 0,
    "text": "همه جان شیرین بکف برنهید"
  },
  {
    "poem_id": 87983,
    "vorder": 54,
    "position": 1,
    "text": "چو من برخروشم دمید و دهید"
  },
  {
    "poem_id": 87983,
    "vorder": 55,
    "position": 0,
    "text": "تهی کرد باید ازیشان زمین"
  },
  {
    "poem_id": 87983,
    "vorder": 56,
    "position": 1,
    "text": "نباید که آیند زین پس بکین"
  },
  {
    "poem_id": 87983,
    "vorder": 57,
    "position": 0,
    "text": "بپیش اندر آمد سپهدار طوس"
  },
  {
    "poem_id": 87983,
    "vorder": 58,
    "position": 1,
    "text": "پیاده بیاورد و پیلان و کوس"
  },
  {
    "poem_id": 87983,
    "vorder": 59,
    "position": 0,
    "text": "صفی برکشیدند پیش سوار"
  },
  {
    "poem_id": 87983,
    "vorder": 60,
    "position": 1,
    "text": "سپردار و ژوپین‌ور و نیزه‌دار"
  },
  {
    "poem_id": 87983,
    "vorder": 61,
    "position": 0,
    "text": "مجنبید گفت ایچ از جای خویش"
  },
  {
    "poem_id": 87983,
    "vorder": 62,
    "position": 1,
    "text": "سپر با سنان اندرارید پیش"
  },
  {
    "poem_id": 87983,
    "vorder": 63,
    "position": 0,
    "text": "ببینیم تا این نبرده سران"
  },
  {
    "poem_id": 87983,
    "vorder": 64,
    "position": 1,
    "text": "چگونه گزارند گرز گران"
  }
]