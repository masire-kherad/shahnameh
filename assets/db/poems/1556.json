[
  {
    "poem_id": 1556,
    "vorder": 1,
    "position": 0,
    "text": "یکی مایه‌ور پور اسفندیار"
  },
  {
    "poem_id": 1556,
    "vorder": 2,
    "position": 1,
    "text": "که نوش آذرش خواندی شهریار"
  },
  {
    "poem_id": 1556,
    "vorder": 3,
    "position": 0,
    "text": "بران بام دژ بود و چشمش به راه"
  },
  {
    "poem_id": 1556,
    "vorder": 4,
    "position": 1,
    "text": "بدان تا کی آید ز ایران سپاه"
  },
  {
    "poem_id": 1556,
    "vorder": 5,
    "position": 0,
    "text": "پدر را بگوید چو بیند کسی"
  },
  {
    "poem_id": 1556,
    "vorder": 6,
    "position": 1,
    "text": "به بالای دژ درنمانده بسی"
  },
  {
    "poem_id": 1556,
    "vorder": 7,
    "position": 0,
    "text": "چو جاماسپ را دید پویان به راه"
  },
  {
    "poem_id": 1556,
    "vorder": 8,
    "position": 1,
    "text": "به سربر یکی نغز توزی کلاه"
  },
  {
    "poem_id": 1556,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت کامد ز توران سوار"
  },
  {
    "poem_id": 1556,
    "vorder": 10,
    "position": 1,
    "text": "بپویم بگویم به اسفندیار"
  },
  {
    "poem_id": 1556,
    "vorder": 11,
    "position": 0,
    "text": "فرود آمد از بارهٔ دژ دوان"
  },
  {
    "poem_id": 1556,
    "vorder": 12,
    "position": 1,
    "text": "چنین گفت کای نامور پهلوان"
  },
  {
    "poem_id": 1556,
    "vorder": 13,
    "position": 0,
    "text": "سواری همی بینم از دیدگاه"
  },
  {
    "poem_id": 1556,
    "vorder": 14,
    "position": 1,
    "text": "کلاهی به سر بر نهاده سیاه"
  },
  {
    "poem_id": 1556,
    "vorder": 15,
    "position": 0,
    "text": "شوم باز بینم که گشتاسپیست"
  },
  {
    "poem_id": 1556,
    "vorder": 16,
    "position": 1,
    "text": "وگر کینه‌جویست و ارجاسپیست"
  },
  {
    "poem_id": 1556,
    "vorder": 17,
    "position": 0,
    "text": "اگر ترک باشد ببرم سرش"
  },
  {
    "poem_id": 1556,
    "vorder": 18,
    "position": 1,
    "text": "به خاک افگنم نابسوده برش"
  },
  {
    "poem_id": 1556,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت پرمایه اسفندیار"
  },
  {
    "poem_id": 1556,
    "vorder": 20,
    "position": 1,
    "text": "که راه گذر کی بوده بی‌سوار"
  },
  {
    "poem_id": 1556,
    "vorder": 21,
    "position": 0,
    "text": "همانا کز ایران یکی لشکری"
  },
  {
    "poem_id": 1556,
    "vorder": 22,
    "position": 1,
    "text": "سوی ما بیامد به پیغمبری"
  },
  {
    "poem_id": 1556,
    "vorder": 23,
    "position": 0,
    "text": "کلاهی به سر بر نهاده دوپر"
  },
  {
    "poem_id": 1556,
    "vorder": 24,
    "position": 1,
    "text": "ز بیم سواران پرخاشخر"
  },
  {
    "poem_id": 1556,
    "vorder": 25,
    "position": 0,
    "text": "چو بشنید نوش آذر از پهلوان"
  },
  {
    "poem_id": 1556,
    "vorder": 26,
    "position": 1,
    "text": "بیامد بران بارهٔ دژ دوان"
  },
  {
    "poem_id": 1556,
    "vorder": 27,
    "position": 0,
    "text": "چو جاماسپ تنگ اندر آمد ز راه"
  },
  {
    "poem_id": 1556,
    "vorder": 28,
    "position": 1,
    "text": "هم از باره دانست فرزند شاه"
  },
  {
    "poem_id": 1556,
    "vorder": 29,
    "position": 0,
    "text": "بیامد به نزدیک فرخ پدر"
  },
  {
    "poem_id": 1556,
    "vorder": 30,
    "position": 1,
    "text": "که فرخنده جاماسپ آمد به در"
  },
  {
    "poem_id": 1556,
    "vorder": 31,
    "position": 0,
    "text": "بفرمود تا دژ گشادند باز"
  },
  {
    "poem_id": 1556,
    "vorder": 32,
    "position": 1,
    "text": "درآمد خردمند و بردش نماز"
  },
  {
    "poem_id": 1556,
    "vorder": 33,
    "position": 0,
    "text": "بدادش درود پدر سربسر"
  },
  {
    "poem_id": 1556,
    "vorder": 34,
    "position": 1,
    "text": "پیامی که آورده بد در بدر"
  },
  {
    "poem_id": 1556,
    "vorder": 35,
    "position": 0,
    "text": "چنین پاسخ آورد اسفندیار"
  },
  {
    "poem_id": 1556,
    "vorder": 36,
    "position": 1,
    "text": "که ای از خرد در جهان یادگار"
  },
  {
    "poem_id": 1556,
    "vorder": 37,
    "position": 0,
    "text": "خردمند و کنداور و سرفراز"
  },
  {
    "poem_id": 1556,
    "vorder": 38,
    "position": 1,
    "text": "چرا بسته را برد باید نماز"
  },
  {
    "poem_id": 1556,
    "vorder": 39,
    "position": 0,
    "text": "کسی را که بر دست و پای آهنست"
  },
  {
    "poem_id": 1556,
    "vorder": 40,
    "position": 1,
    "text": "نه مردم نژادست کهرمنست"
  },
  {
    "poem_id": 1556,
    "vorder": 41,
    "position": 0,
    "text": "درود شهنشاه ایران دهی"
  },
  {
    "poem_id": 1556,
    "vorder": 42,
    "position": 1,
    "text": "ز دانش ندارد دلت آگهی"
  },
  {
    "poem_id": 1556,
    "vorder": 43,
    "position": 0,
    "text": "درودم از ارجاسپ آمد کنون"
  },
  {
    "poem_id": 1556,
    "vorder": 44,
    "position": 1,
    "text": "کز ایران همی دست شوید به خون"
  },
  {
    "poem_id": 1556,
    "vorder": 45,
    "position": 0,
    "text": "مرا بند کردند بر بی‌گناه"
  },
  {
    "poem_id": 1556,
    "vorder": 46,
    "position": 1,
    "text": "همانا گه رزم فرزند شاه"
  },
  {
    "poem_id": 1556,
    "vorder": 47,
    "position": 0,
    "text": "چنین بود پاداش رنج مرا"
  },
  {
    "poem_id": 1556,
    "vorder": 48,
    "position": 1,
    "text": "به آهن بیاراست گنج مرا"
  },
  {
    "poem_id": 1556,
    "vorder": 49,
    "position": 0,
    "text": "کنون همچنین بسته باید تنم"
  },
  {
    "poem_id": 1556,
    "vorder": 50,
    "position": 1,
    "text": "به یزدان گوای منست آهنم"
  },
  {
    "poem_id": 1556,
    "vorder": 51,
    "position": 0,
    "text": "که بر من ز گشتاسپ بیداد بود"
  },
  {
    "poem_id": 1556,
    "vorder": 52,
    "position": 1,
    "text": "ز گفت گُرَزم اهرمن شاد بود"
  },
  {
    "poem_id": 1556,
    "vorder": 53,
    "position": 0,
    "text": "مبادا که این بد فرامش کنم"
  },
  {
    "poem_id": 1556,
    "vorder": 54,
    "position": 1,
    "text": "روان را به گفتار بیهش کنم"
  },
  {
    "poem_id": 1556,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت جاماسپ کای راست‌گوی"
  },
  {
    "poem_id": 1556,
    "vorder": 56,
    "position": 1,
    "text": "جهانگیر و کنداور و نیک‌خوی"
  },
  {
    "poem_id": 1556,
    "vorder": 57,
    "position": 0,
    "text": "دلت گر چنین از پدر خیره گشت"
  },
  {
    "poem_id": 1556,
    "vorder": 58,
    "position": 1,
    "text": "نگر بخت این پادشا تیره گشت"
  },
  {
    "poem_id": 1556,
    "vorder": 59,
    "position": 0,
    "text": "چو لهراسپ شاه آن پرستنده مرد"
  },
  {
    "poem_id": 1556,
    "vorder": 60,
    "position": 1,
    "text": "که ترکان بکشتندش اندر نبرد"
  },
  {
    "poem_id": 1556,
    "vorder": 61,
    "position": 0,
    "text": "همان هیربد نیز یزدان‌پرست"
  },
  {
    "poem_id": 1556,
    "vorder": 62,
    "position": 1,
    "text": "که بودند با زند و استا به دست"
  },
  {
    "poem_id": 1556,
    "vorder": 63,
    "position": 0,
    "text": "بکشتند هشتاد از موبدان"
  },
  {
    "poem_id": 1556,
    "vorder": 64,
    "position": 1,
    "text": "پرستنده و پاک‌دل بخردان"
  },
  {
    "poem_id": 1556,
    "vorder": 65,
    "position": 0,
    "text": "ز خونشان به نوش‌آذر آذر بمرد"
  },
  {
    "poem_id": 1556,
    "vorder": 66,
    "position": 1,
    "text": "چنین بدکنش خوار نتوان شمرد"
  },
  {
    "poem_id": 1556,
    "vorder": 67,
    "position": 0,
    "text": "ز بهر نیا دل پر از درد کن"
  },
  {
    "poem_id": 1556,
    "vorder": 68,
    "position": 1,
    "text": "برآشوب و رخسارگان زرد کن"
  },
  {
    "poem_id": 1556,
    "vorder": 69,
    "position": 0,
    "text": "ز کین یا ز دین گر نجنبی ز جای"
  },
  {
    "poem_id": 1556,
    "vorder": 70,
    "position": 1,
    "text": "نباشی پسندیدهٔ رهنمای"
  },
  {
    "poem_id": 1556,
    "vorder": 71,
    "position": 0,
    "text": "چنین داد پاسخ که ای نیک‌نام"
  },
  {
    "poem_id": 1556,
    "vorder": 72,
    "position": 1,
    "text": "بلنداختر و گرد و جوینده کام"
  },
  {
    "poem_id": 1556,
    "vorder": 73,
    "position": 0,
    "text": "براندیش کان پیر لهراسپ را"
  },
  {
    "poem_id": 1556,
    "vorder": 74,
    "position": 1,
    "text": "پرستنده و باب گشتاسپ را"
  },
  {
    "poem_id": 1556,
    "vorder": 75,
    "position": 0,
    "text": "پسر به که جوید همی کین اوی"
  },
  {
    "poem_id": 1556,
    "vorder": 76,
    "position": 1,
    "text": "که تخت پدر داشت و ایین اوی"
  },
  {
    "poem_id": 1556,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت ار ایدونک کین نیا"
  },
  {
    "poem_id": 1556,
    "vorder": 78,
    "position": 1,
    "text": "نجویی نداری به دل کیمیا"
  },
  {
    "poem_id": 1556,
    "vorder": 79,
    "position": 0,
    "text": "همای خردمند و به آفرید"
  },
  {
    "poem_id": 1556,
    "vorder": 80,
    "position": 1,
    "text": "که باد هوا روی ایشان ندید"
  },
  {
    "poem_id": 1556,
    "vorder": 81,
    "position": 0,
    "text": "به ترکان اسیراند با درد و داغ"
  },
  {
    "poem_id": 1556,
    "vorder": 82,
    "position": 1,
    "text": "پیاده دوان رنگ رخ چون چراغ"
  },
  {
    "poem_id": 1556,
    "vorder": 83,
    "position": 0,
    "text": "چنین پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1556,
    "vorder": 84,
    "position": 1,
    "text": "که من بسته بودم چنین زار و خوار"
  },
  {
    "poem_id": 1556,
    "vorder": 85,
    "position": 0,
    "text": "نکردند زیشان ز من هیچ یاد"
  },
  {
    "poem_id": 1556,
    "vorder": 86,
    "position": 1,
    "text": "نه برزد کس از بهر من سردباد"
  },
  {
    "poem_id": 1556,
    "vorder": 87,
    "position": 0,
    "text": "چه گویی به پاسخ که روزی همای"
  },
  {
    "poem_id": 1556,
    "vorder": 88,
    "position": 1,
    "text": "ز من کرد یاد اندرین تنگ جای"
  },
  {
    "poem_id": 1556,
    "vorder": 89,
    "position": 0,
    "text": "دگر نیز پرمایه به آفرید"
  },
  {
    "poem_id": 1556,
    "vorder": 90,
    "position": 1,
    "text": "که گفتی مرا در جهان خود ندید"
  },
  {
    "poem_id": 1556,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت جاماسپ کای پهلوان"
  },
  {
    "poem_id": 1556,
    "vorder": 92,
    "position": 1,
    "text": "پدرت از جهان تیره دارد روان"
  },
  {
    "poem_id": 1556,
    "vorder": 93,
    "position": 0,
    "text": "به کوه اندرست این زمان با سران"
  },
  {
    "poem_id": 1556,
    "vorder": 94,
    "position": 1,
    "text": "دو دیده پر از آب و لب ناچران"
  },
  {
    "poem_id": 1556,
    "vorder": 95,
    "position": 0,
    "text": "سپاهی ز ترکان بگرد اندرش"
  },
  {
    "poem_id": 1556,
    "vorder": 96,
    "position": 1,
    "text": "همانا نبینی سر و افسرش"
  },
  {
    "poem_id": 1556,
    "vorder": 97,
    "position": 0,
    "text": "نیاید پسند جهان‌آفرین"
  },
  {
    "poem_id": 1556,
    "vorder": 98,
    "position": 1,
    "text": "که تو دل بپیچی ز مهر و ز دین"
  },
  {
    "poem_id": 1556,
    "vorder": 99,
    "position": 0,
    "text": "برادر که بد مر ترا سی و هشت"
  },
  {
    "poem_id": 1556,
    "vorder": 100,
    "position": 1,
    "text": "ازان پنج ماند و دگر درگذشت"
  },
  {
    "poem_id": 1556,
    "vorder": 101,
    "position": 0,
    "text": "چنین پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1556,
    "vorder": 102,
    "position": 1,
    "text": "که چندین برادر بدم نامدار"
  },
  {
    "poem_id": 1556,
    "vorder": 103,
    "position": 0,
    "text": "همه شاد با رامش و من به بند"
  },
  {
    "poem_id": 1556,
    "vorder": 104,
    "position": 1,
    "text": "نکردند یاد از من مستمند"
  },
  {
    "poem_id": 1556,
    "vorder": 105,
    "position": 0,
    "text": "اگر من کنون کین بسیچم چه سود"
  },
  {
    "poem_id": 1556,
    "vorder": 106,
    "position": 1,
    "text": "کزیشان برآورد بدخواه دود"
  },
  {
    "poem_id": 1556,
    "vorder": 107,
    "position": 0,
    "text": "چو جاماسپ زین گونه پاسخ شنود"
  },
  {
    "poem_id": 1556,
    "vorder": 108,
    "position": 1,
    "text": "دلش گشت از درد پر داغ و دود"
  },
  {
    "poem_id": 1556,
    "vorder": 109,
    "position": 0,
    "text": "همی بود بر پای و دل پر ز خشم"
  },
  {
    "poem_id": 1556,
    "vorder": 110,
    "position": 1,
    "text": "به زاری همی راند آب از دو چشم"
  },
  {
    "poem_id": 1556,
    "vorder": 111,
    "position": 0,
    "text": "بدو گفت کای پهلوان جهان"
  },
  {
    "poem_id": 1556,
    "vorder": 112,
    "position": 1,
    "text": "اگر تیره گردد دلت با روان"
  },
  {
    "poem_id": 1556,
    "vorder": 113,
    "position": 0,
    "text": "چه گویی کنون کار فرشیدورد"
  },
  {
    "poem_id": 1556,
    "vorder": 114,
    "position": 1,
    "text": "که بود از تو همواره با داغ و درد"
  },
  {
    "poem_id": 1556,
    "vorder": 115,
    "position": 0,
    "text": "به هر سو که بودی به رزم و به بزم"
  },
  {
    "poem_id": 1556,
    "vorder": 116,
    "position": 1,
    "text": "پر از درد و نفرین بدی بر گُرَزم"
  },
  {
    "poem_id": 1556,
    "vorder": 117,
    "position": 0,
    "text": "پر از زخم شمشیر دیدم تنش"
  },
  {
    "poem_id": 1556,
    "vorder": 118,
    "position": 1,
    "text": "دریده برو مغفر و جوشنش"
  },
  {
    "poem_id": 1556,
    "vorder": 119,
    "position": 0,
    "text": "همی زار می بگسلد جان اوی"
  },
  {
    "poem_id": 1556,
    "vorder": 120,
    "position": 1,
    "text": "ببخشای بر چشم گریان اوی"
  },
  {
    "poem_id": 1556,
    "vorder": 121,
    "position": 0,
    "text": "چو آواز دادش ز فرشیدورد"
  },
  {
    "poem_id": 1556,
    "vorder": 122,
    "position": 1,
    "text": "دلش گشت پرخون و جان پر ز درد"
  },
  {
    "poem_id": 1556,
    "vorder": 123,
    "position": 0,
    "text": "چو باز آمدش دل به جاماسپ گفت"
  },
  {
    "poem_id": 1556,
    "vorder": 124,
    "position": 1,
    "text": "که این بد چرا داشتی در نهفت"
  },
  {
    "poem_id": 1556,
    "vorder": 125,
    "position": 0,
    "text": "بفرمای کاهنگران آورند"
  },
  {
    "poem_id": 1556,
    "vorder": 126,
    "position": 1,
    "text": "چو سوهان و پتک گران آورند"
  },
  {
    "poem_id": 1556,
    "vorder": 127,
    "position": 0,
    "text": "بیاورد جاماسپ آهنگران"
  },
  {
    "poem_id": 1556,
    "vorder": 128,
    "position": 1,
    "text": "چو سندان پولاد و پتک گران"
  },
  {
    "poem_id": 1556,
    "vorder": 129,
    "position": 0,
    "text": "بسودند زنجیر و مسمار و غل"
  },
  {
    "poem_id": 1556,
    "vorder": 130,
    "position": 1,
    "text": "همان بند رومی به کردار پل"
  },
  {
    "poem_id": 1556,
    "vorder": 131,
    "position": 0,
    "text": "چو شد دیر بر سودن بستگی"
  },
  {
    "poem_id": 1556,
    "vorder": 132,
    "position": 1,
    "text": "به بد تنگدل بسته از خستگی"
  },
  {
    "poem_id": 1556,
    "vorder": 133,
    "position": 0,
    "text": "به آهنگران گفت کای شوربخت"
  },
  {
    "poem_id": 1556,
    "vorder": 134,
    "position": 1,
    "text": "ببندی و بسته ندانی گسخت"
  },
  {
    "poem_id": 1556,
    "vorder": 135,
    "position": 0,
    "text": "همی گفت من بند آن شهریار"
  },
  {
    "poem_id": 1556,
    "vorder": 136,
    "position": 1,
    "text": "نکردم به پیش خردمند خوار"
  },
  {
    "poem_id": 1556,
    "vorder": 137,
    "position": 0,
    "text": "بپیچید تن را و بر پای جست"
  },
  {
    "poem_id": 1556,
    "vorder": 138,
    "position": 1,
    "text": "غمی شد به پابند یازید دست"
  },
  {
    "poem_id": 1556,
    "vorder": 139,
    "position": 0,
    "text": "بیاهیخت پای و بپیچید دست"
  },
  {
    "poem_id": 1556,
    "vorder": 140,
    "position": 1,
    "text": "همه بند و زنجیر بر هم شکست"
  },
  {
    "poem_id": 1556,
    "vorder": 141,
    "position": 0,
    "text": "چو بگسست زنجیر بی‌توش گشت"
  },
  {
    "poem_id": 1556,
    "vorder": 142,
    "position": 1,
    "text": "بیفتاد از درد و بیهوش گشت"
  },
  {
    "poem_id": 1556,
    "vorder": 143,
    "position": 0,
    "text": "ستاره شمرکان شگفتی بدید"
  },
  {
    "poem_id": 1556,
    "vorder": 144,
    "position": 1,
    "text": "بران تاجدار آفرین گسترید"
  },
  {
    "poem_id": 1556,
    "vorder": 145,
    "position": 0,
    "text": "چو آمد به هوش آن گو زورمند"
  },
  {
    "poem_id": 1556,
    "vorder": 146,
    "position": 1,
    "text": "همی پیش بنهاد زنجیر و بند"
  },
  {
    "poem_id": 1556,
    "vorder": 147,
    "position": 0,
    "text": "چنین گفت کاین هدیه‌های گُرَزم"
  },
  {
    "poem_id": 1556,
    "vorder": 148,
    "position": 1,
    "text": "منش پست بادش به بزم و به رزم"
  },
  {
    "poem_id": 1556,
    "vorder": 149,
    "position": 0,
    "text": "به گرمابه شد با تن دردمند"
  },
  {
    "poem_id": 1556,
    "vorder": 150,
    "position": 1,
    "text": "ز زنجیر فرسوده و مستمند"
  },
  {
    "poem_id": 1556,
    "vorder": 151,
    "position": 0,
    "text": "چو آمد به در پس گو نامدار"
  },
  {
    "poem_id": 1556,
    "vorder": 152,
    "position": 1,
    "text": "رخش بود همچون گل اندر بهار"
  },
  {
    "poem_id": 1556,
    "vorder": 153,
    "position": 0,
    "text": "یکی جوشن خسروانی بخواست"
  },
  {
    "poem_id": 1556,
    "vorder": 154,
    "position": 1,
    "text": "همان جامهٔ پهلوانی بخواست"
  },
  {
    "poem_id": 1556,
    "vorder": 155,
    "position": 0,
    "text": "بفرمود کان بارهٔ گام زن"
  },
  {
    "poem_id": 1556,
    "vorder": 156,
    "position": 1,
    "text": "بیارید و آن ترگ و شمشیر من"
  },
  {
    "poem_id": 1556,
    "vorder": 157,
    "position": 0,
    "text": "چو چشمش بران تیزرو برفتاد"
  },
  {
    "poem_id": 1556,
    "vorder": 158,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1556,
    "vorder": 159,
    "position": 0,
    "text": "همی گفت گر من گنه کرده‌ام"
  },
  {
    "poem_id": 1556,
    "vorder": 160,
    "position": 1,
    "text": "ازینسان به بند اندر آزرده‌ام"
  },
  {
    "poem_id": 1556,
    "vorder": 161,
    "position": 0,
    "text": "چه کرد این چمان بارهٔ بربری"
  },
  {
    "poem_id": 1556,
    "vorder": 162,
    "position": 1,
    "text": "چه بایست کردن بدین لاغری"
  },
  {
    "poem_id": 1556,
    "vorder": 163,
    "position": 0,
    "text": "بشویید و او را بی‌آهو کنید"
  },
  {
    "poem_id": 1556,
    "vorder": 164,
    "position": 1,
    "text": "به خوردن تنش را به نیرو کنید"
  },
  {
    "poem_id": 1556,
    "vorder": 165,
    "position": 0,
    "text": "فرستاد کس نزد آهنگران"
  },
  {
    "poem_id": 1556,
    "vorder": 166,
    "position": 1,
    "text": "هرانکس که استاد بود اندران"
  },
  {
    "poem_id": 1556,
    "vorder": 167,
    "position": 0,
    "text": "برفتند و چندی زره خواستند"
  },
  {
    "poem_id": 1556,
    "vorder": 168,
    "position": 1,
    "text": "سلیحش یکایک بپیراستند"
  }
]