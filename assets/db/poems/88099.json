[
  {
    "poem_id": 88099,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا رفت پیشش دبیر"
  },
  {
    "poem_id": 88099,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد قرطاس و مشک و عبیر"
  },
  {
    "poem_id": 88099,
    "vorder": 3,
    "position": 0,
    "text": "نبشتند عهدی ز شاه زمین"
  },
  {
    "poem_id": 88099,
    "vorder": 4,
    "position": 1,
    "text": "سرافراز کیخسرو پاک‌دین"
  },
  {
    "poem_id": 88099,
    "vorder": 5,
    "position": 0,
    "text": "ز بهر سپهبد گو پیلتن"
  },
  {
    "poem_id": 88099,
    "vorder": 6,
    "position": 1,
    "text": "ستوده به مردی به هر انجمن"
  },
  {
    "poem_id": 88099,
    "vorder": 7,
    "position": 0,
    "text": "که او باشد اندر جهان پیشرو"
  },
  {
    "poem_id": 88099,
    "vorder": 8,
    "position": 1,
    "text": "جهاندار و بیدار و سالار و گو"
  },
  {
    "poem_id": 88099,
    "vorder": 9,
    "position": 0,
    "text": "هم او را بود کشور نیمروز"
  },
  {
    "poem_id": 88099,
    "vorder": 10,
    "position": 1,
    "text": "سپهدار پیروز لشکر فروز"
  },
  {
    "poem_id": 88099,
    "vorder": 11,
    "position": 0,
    "text": "نهادند بر عهد بر مهر زر"
  },
  {
    "poem_id": 88099,
    "vorder": 12,
    "position": 1,
    "text": "بر آیین کیخسرو دادگر"
  },
  {
    "poem_id": 88099,
    "vorder": 13,
    "position": 0,
    "text": "بدو داد منشور و کرد آفرین"
  },
  {
    "poem_id": 88099,
    "vorder": 14,
    "position": 1,
    "text": "که آباد بادا به رستم زمین"
  },
  {
    "poem_id": 88099,
    "vorder": 15,
    "position": 0,
    "text": "مهانی که با زال سام سوار"
  },
  {
    "poem_id": 88099,
    "vorder": 16,
    "position": 1,
    "text": "برفتند با زیجها بر کنار"
  },
  {
    "poem_id": 88099,
    "vorder": 17,
    "position": 0,
    "text": "ببخشیدشان خلعت و سیم و زر"
  },
  {
    "poem_id": 88099,
    "vorder": 18,
    "position": 1,
    "text": "یکی جام مر هر یکی را گهر"
  }
]