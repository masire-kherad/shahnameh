[
  {
    "poem_id": 1645,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید مهران ز کید این سخن"
  },
  {
    "poem_id": 1645,
    "vorder": 2,
    "position": 1,
    "text": "بدو گفت ازین خواب دل بد مکن"
  },
  {
    "poem_id": 1645,
    "vorder": 3,
    "position": 0,
    "text": "نه کمتر شود بر تو نام بلند"
  },
  {
    "poem_id": 1645,
    "vorder": 4,
    "position": 1,
    "text": "نه آید بدین پادشاهی گزند"
  },
  {
    "poem_id": 1645,
    "vorder": 5,
    "position": 0,
    "text": "سکندر بیارد سپاهی گران"
  },
  {
    "poem_id": 1645,
    "vorder": 6,
    "position": 1,
    "text": "ز روم و ز ایران گزیده سران"
  },
  {
    "poem_id": 1645,
    "vorder": 7,
    "position": 0,
    "text": "چو خواهی که باشد ترا آب‌روی"
  },
  {
    "poem_id": 1645,
    "vorder": 8,
    "position": 1,
    "text": "خرد یار کن رزم او را مجوی"
  },
  {
    "poem_id": 1645,
    "vorder": 9,
    "position": 0,
    "text": "ترا چار چیزست کاندر جهان"
  },
  {
    "poem_id": 1645,
    "vorder": 10,
    "position": 1,
    "text": "کسی آن ندید از کهان و مهان"
  },
  {
    "poem_id": 1645,
    "vorder": 11,
    "position": 0,
    "text": "یکی چون بهشت برین دخترت"
  },
  {
    "poem_id": 1645,
    "vorder": 12,
    "position": 1,
    "text": "کزو تابد اندر زمین افسرت"
  },
  {
    "poem_id": 1645,
    "vorder": 13,
    "position": 0,
    "text": "دگر فیلسوفی که داری نهان"
  },
  {
    "poem_id": 1645,
    "vorder": 14,
    "position": 1,
    "text": "بگوید همه با تو راز جهان"
  },
  {
    "poem_id": 1645,
    "vorder": 15,
    "position": 0,
    "text": "سه دیگر پزشکی که هست ارجمند"
  },
  {
    "poem_id": 1645,
    "vorder": 16,
    "position": 1,
    "text": "به دانندگی نام کرده بلند"
  },
  {
    "poem_id": 1645,
    "vorder": 17,
    "position": 0,
    "text": "چهارم قدح کاندرو ریزی آب"
  },
  {
    "poem_id": 1645,
    "vorder": 18,
    "position": 1,
    "text": "نه ز آتش شود کم نه از آفتاب"
  },
  {
    "poem_id": 1645,
    "vorder": 19,
    "position": 0,
    "text": "ز خوردن نگیرد کمی آب اوی"
  },
  {
    "poem_id": 1645,
    "vorder": 20,
    "position": 1,
    "text": "بدین چیزها راست کن آب روی"
  },
  {
    "poem_id": 1645,
    "vorder": 21,
    "position": 0,
    "text": "چو آید بدین باش و مسگال جنگ"
  },
  {
    "poem_id": 1645,
    "vorder": 22,
    "position": 1,
    "text": "چو خواهی که ایدر نسازد درنگ"
  },
  {
    "poem_id": 1645,
    "vorder": 23,
    "position": 0,
    "text": "بسنده نباشی تو با لشکرش"
  },
  {
    "poem_id": 1645,
    "vorder": 24,
    "position": 1,
    "text": "نه با چاره و گنج و با افسرش"
  },
  {
    "poem_id": 1645,
    "vorder": 25,
    "position": 0,
    "text": "چو بر کار تو رای فرخ کنیم"
  },
  {
    "poem_id": 1645,
    "vorder": 26,
    "position": 1,
    "text": "همان خواب را نیز پاسخ کنیم"
  },
  {
    "poem_id": 1645,
    "vorder": 27,
    "position": 0,
    "text": "یکی خانه دیدی و سوراخ تنگ"
  },
  {
    "poem_id": 1645,
    "vorder": 28,
    "position": 1,
    "text": "کزو پیل بیرون شدی بی‌درنگ"
  },
  {
    "poem_id": 1645,
    "vorder": 29,
    "position": 0,
    "text": "تو آن خانه را همچو گیتی شناس"
  },
  {
    "poem_id": 1645,
    "vorder": 30,
    "position": 1,
    "text": "همان پیل شاهی بود ناسپاس"
  },
  {
    "poem_id": 1645,
    "vorder": 31,
    "position": 0,
    "text": "که بیدادگر باشد و کژ گوی"
  },
  {
    "poem_id": 1645,
    "vorder": 32,
    "position": 1,
    "text": "جز از نام شاهی نباشد بدوی"
  },
  {
    "poem_id": 1645,
    "vorder": 33,
    "position": 0,
    "text": "ازین پس بیاید یکی پادشا"
  },
  {
    "poem_id": 1645,
    "vorder": 34,
    "position": 1,
    "text": "چنان سست و بی‌سود و ناپارسا"
  },
  {
    "poem_id": 1645,
    "vorder": 35,
    "position": 0,
    "text": "به دل سفله باشد به تن ناتوان"
  },
  {
    "poem_id": 1645,
    "vorder": 36,
    "position": 1,
    "text": "به آز اندرون نیز تیره‌روان"
  },
  {
    "poem_id": 1645,
    "vorder": 37,
    "position": 0,
    "text": "کجا زیردستانش باشند شاد"
  },
  {
    "poem_id": 1645,
    "vorder": 38,
    "position": 1,
    "text": "پر از غم دل شاه و لب پر ز باد"
  },
  {
    "poem_id": 1645,
    "vorder": 39,
    "position": 0,
    "text": "دگر آنک دیدی ز کرپاس نغز"
  },
  {
    "poem_id": 1645,
    "vorder": 40,
    "position": 1,
    "text": "گرفته ورا چار پاکیزه مغز"
  },
  {
    "poem_id": 1645,
    "vorder": 41,
    "position": 0,
    "text": "نه کرپاس نغز از کشیدن درید"
  },
  {
    "poem_id": 1645,
    "vorder": 42,
    "position": 1,
    "text": "نه آمد ستوه آنک او را کشید"
  },
  {
    "poem_id": 1645,
    "vorder": 43,
    "position": 0,
    "text": "ازین پس بیاید یکی نامدار"
  },
  {
    "poem_id": 1645,
    "vorder": 44,
    "position": 1,
    "text": "ز دشت سواران نیزه گزار"
  },
  {
    "poem_id": 1645,
    "vorder": 45,
    "position": 0,
    "text": "یکی مرد پاکیزه و نیکخوی"
  },
  {
    "poem_id": 1645,
    "vorder": 46,
    "position": 1,
    "text": "بدو دین یزدان شود چارسوی"
  },
  {
    "poem_id": 1645,
    "vorder": 47,
    "position": 0,
    "text": "یکی پیر دهقان آتش‌پرست"
  },
  {
    "poem_id": 1645,
    "vorder": 48,
    "position": 1,
    "text": "که بر واژ برسم بگیرد بدست"
  },
  {
    "poem_id": 1645,
    "vorder": 49,
    "position": 0,
    "text": "دگر دین موسی که خوانی جهود"
  },
  {
    "poem_id": 1645,
    "vorder": 50,
    "position": 1,
    "text": "که گوید جز آن را نشاید ستود"
  },
  {
    "poem_id": 1645,
    "vorder": 51,
    "position": 0,
    "text": "دگر دین یونانی آن پارسا"
  },
  {
    "poem_id": 1645,
    "vorder": 52,
    "position": 1,
    "text": "که داد آورد در دل پادشا"
  },
  {
    "poem_id": 1645,
    "vorder": 53,
    "position": 0,
    "text": "چهارم بیاید همین پاک‌رای"
  },
  {
    "poem_id": 1645,
    "vorder": 54,
    "position": 1,
    "text": "سر هوشمندان برآرد ز جای"
  },
  {
    "poem_id": 1645,
    "vorder": 55,
    "position": 0,
    "text": "چنان چارسو از پی پاس را"
  },
  {
    "poem_id": 1645,
    "vorder": 56,
    "position": 1,
    "text": "کشیدند زانگونه کرپاس را"
  },
  {
    "poem_id": 1645,
    "vorder": 57,
    "position": 0,
    "text": "تو کرپاس را دین یزدان شناس"
  },
  {
    "poem_id": 1645,
    "vorder": 58,
    "position": 1,
    "text": "کشنده چهار آمد از بهر پاس"
  },
  {
    "poem_id": 1645,
    "vorder": 59,
    "position": 0,
    "text": "همی درکشد این ازان آن ازین"
  },
  {
    "poem_id": 1645,
    "vorder": 60,
    "position": 1,
    "text": "شوند آن زمان دشمن از بهر دین"
  },
  {
    "poem_id": 1645,
    "vorder": 61,
    "position": 0,
    "text": "دگر تشنه‌ای کو شد از آب خوش"
  },
  {
    "poem_id": 1645,
    "vorder": 62,
    "position": 1,
    "text": "گریزان و ماهی ورا آب‌کش"
  },
  {
    "poem_id": 1645,
    "vorder": 63,
    "position": 0,
    "text": "زمانی بیاید که پاکیزه مرد"
  },
  {
    "poem_id": 1645,
    "vorder": 64,
    "position": 1,
    "text": "شود خوار چون آب دانش بخورد"
  },
  {
    "poem_id": 1645,
    "vorder": 65,
    "position": 0,
    "text": "به کردار ماهی به دریا شود"
  },
  {
    "poem_id": 1645,
    "vorder": 66,
    "position": 1,
    "text": "گر از بدکنش بر ثریا شود"
  },
  {
    "poem_id": 1645,
    "vorder": 67,
    "position": 0,
    "text": "همی تشنگان را بخواند برآب"
  },
  {
    "poem_id": 1645,
    "vorder": 68,
    "position": 1,
    "text": "کس او را ز دانش نسازد جواب"
  },
  {
    "poem_id": 1645,
    "vorder": 69,
    "position": 0,
    "text": "گریزند زان مرد دانش‌پژوه"
  },
  {
    "poem_id": 1645,
    "vorder": 70,
    "position": 1,
    "text": "گشایند لبها به بد هم‌گروه"
  },
  {
    "poem_id": 1645,
    "vorder": 71,
    "position": 0,
    "text": "به پنجم که دیدی یکی شارستان"
  },
  {
    "poem_id": 1645,
    "vorder": 72,
    "position": 1,
    "text": "بدو اندرون ساخته کارستان"
  },
  {
    "poem_id": 1645,
    "vorder": 73,
    "position": 0,
    "text": "پر از خورد و داد و خرید و فروخت"
  },
  {
    "poem_id": 1645,
    "vorder": 74,
    "position": 1,
    "text": "تو گفتی زمان چشم ایشان بدوخت"
  },
  {
    "poem_id": 1645,
    "vorder": 75,
    "position": 0,
    "text": "ز کوری یکی دیگری را ندید"
  },
  {
    "poem_id": 1645,
    "vorder": 76,
    "position": 1,
    "text": "همی این بدان آن بدین ننگرید"
  },
  {
    "poem_id": 1645,
    "vorder": 77,
    "position": 0,
    "text": "زمانی بیاید کزان سان شود"
  },
  {
    "poem_id": 1645,
    "vorder": 78,
    "position": 1,
    "text": "که دانا پرستار نادان شود"
  },
  {
    "poem_id": 1645,
    "vorder": 79,
    "position": 0,
    "text": "بدیشان بود دانشومند خوار"
  },
  {
    "poem_id": 1645,
    "vorder": 80,
    "position": 1,
    "text": "درخت خردشان نیاید به بار"
  },
  {
    "poem_id": 1645,
    "vorder": 81,
    "position": 0,
    "text": "ستایندهٔ مرد نادان شوند"
  },
  {
    "poem_id": 1645,
    "vorder": 82,
    "position": 1,
    "text": "نیایش کنان پیش یزدان شوند"
  },
  {
    "poem_id": 1645,
    "vorder": 83,
    "position": 0,
    "text": "همی داند آنکس که گوید دروغ"
  },
  {
    "poem_id": 1645,
    "vorder": 84,
    "position": 1,
    "text": "همی زان پرستش نگیرد فروغ"
  },
  {
    "poem_id": 1645,
    "vorder": 85,
    "position": 0,
    "text": "ششم آنک دیدی بر اسپی دو سر"
  },
  {
    "poem_id": 1645,
    "vorder": 86,
    "position": 1,
    "text": "خورش را نبودی بروبر گذر"
  },
  {
    "poem_id": 1645,
    "vorder": 87,
    "position": 0,
    "text": "زمانی بیاید که مردم به چیز"
  },
  {
    "poem_id": 1645,
    "vorder": 88,
    "position": 1,
    "text": "شود شاد و سیری نیابند نیز"
  },
  {
    "poem_id": 1645,
    "vorder": 89,
    "position": 0,
    "text": "نه درویش یابد ازو بهره‌ای"
  },
  {
    "poem_id": 1645,
    "vorder": 90,
    "position": 1,
    "text": "نه دانش پژوهی و نه شهره‌ای"
  },
  {
    "poem_id": 1645,
    "vorder": 91,
    "position": 0,
    "text": "جز از خویشتن را نخواهند بس"
  },
  {
    "poem_id": 1645,
    "vorder": 92,
    "position": 1,
    "text": "کسی را نباشند فریادرس"
  },
  {
    "poem_id": 1645,
    "vorder": 93,
    "position": 0,
    "text": "به هفتم که پرآب دیدی سه خم"
  },
  {
    "poem_id": 1645,
    "vorder": 94,
    "position": 1,
    "text": "یکی زو تهی مانده بد تا بدم"
  },
  {
    "poem_id": 1645,
    "vorder": 95,
    "position": 0,
    "text": "دو از آب دایم سراسر بدی"
  },
  {
    "poem_id": 1645,
    "vorder": 96,
    "position": 1,
    "text": "میانه یکی خشک و بی‌بر بدی"
  },
  {
    "poem_id": 1645,
    "vorder": 97,
    "position": 0,
    "text": "ازین پس بیاید یکی روزگار"
  },
  {
    "poem_id": 1645,
    "vorder": 98,
    "position": 1,
    "text": "که درویش گردد چنان سست و خوار"
  },
  {
    "poem_id": 1645,
    "vorder": 99,
    "position": 0,
    "text": "که گر ابر گردد بهاران پرآب"
  },
  {
    "poem_id": 1645,
    "vorder": 100,
    "position": 1,
    "text": "ز درویش پنهان کند آفتاب"
  },
  {
    "poem_id": 1645,
    "vorder": 101,
    "position": 0,
    "text": "نبارد بدو نیز باران خویش"
  },
  {
    "poem_id": 1645,
    "vorder": 102,
    "position": 1,
    "text": "دل مرد درویش زو گشته ریش"
  },
  {
    "poem_id": 1645,
    "vorder": 103,
    "position": 0,
    "text": "توانگر ببخشد همی این بران"
  },
  {
    "poem_id": 1645,
    "vorder": 104,
    "position": 1,
    "text": "یکی با دگر چرب و شیرین‌زبان"
  },
  {
    "poem_id": 1645,
    "vorder": 105,
    "position": 0,
    "text": "شود مرد درویش را خشک لب"
  },
  {
    "poem_id": 1645,
    "vorder": 106,
    "position": 1,
    "text": "همی روز را بگذراند به شب"
  },
  {
    "poem_id": 1645,
    "vorder": 107,
    "position": 0,
    "text": "دگر آنک گاوی چنان تن درست"
  },
  {
    "poem_id": 1645,
    "vorder": 108,
    "position": 1,
    "text": "ز گوسالهٔ لاغر او شیر جست"
  },
  {
    "poem_id": 1645,
    "vorder": 109,
    "position": 0,
    "text": "چو کیوان به برج ترازو شود"
  },
  {
    "poem_id": 1645,
    "vorder": 110,
    "position": 1,
    "text": "جهان زیر نیروی بازو شود"
  },
  {
    "poem_id": 1645,
    "vorder": 111,
    "position": 0,
    "text": "شود کار بیمار و درویش سست"
  },
  {
    "poem_id": 1645,
    "vorder": 112,
    "position": 1,
    "text": "وزو چیز خواهد همی تن‌درست"
  },
  {
    "poem_id": 1645,
    "vorder": 113,
    "position": 0,
    "text": "نه هرگز گشاید سر گنج خویش"
  },
  {
    "poem_id": 1645,
    "vorder": 114,
    "position": 1,
    "text": "نه زو باز دارد به تن رنج خویش"
  },
  {
    "poem_id": 1645,
    "vorder": 115,
    "position": 0,
    "text": "دگر چشمه‌ای دیدی از آب خشک"
  },
  {
    "poem_id": 1645,
    "vorder": 116,
    "position": 1,
    "text": "به گرد اندرش آبهای چو مشک"
  },
  {
    "poem_id": 1645,
    "vorder": 117,
    "position": 0,
    "text": "نه زو بردمیدی یکی روشن آب"
  },
  {
    "poem_id": 1645,
    "vorder": 118,
    "position": 1,
    "text": "نه آن آبها را گرفتی شتاب"
  },
  {
    "poem_id": 1645,
    "vorder": 119,
    "position": 0,
    "text": "ازین پس یکی روزگاری بود"
  },
  {
    "poem_id": 1645,
    "vorder": 120,
    "position": 1,
    "text": "که اندر جهان شهریاری بود"
  },
  {
    "poem_id": 1645,
    "vorder": 121,
    "position": 0,
    "text": "که دانش نباشد به نزدیک اوی"
  },
  {
    "poem_id": 1645,
    "vorder": 122,
    "position": 1,
    "text": "پر از غم بود جان تاریک اوی"
  },
  {
    "poem_id": 1645,
    "vorder": 123,
    "position": 0,
    "text": "همی هر زمان نو کند لشکری"
  },
  {
    "poem_id": 1645,
    "vorder": 124,
    "position": 1,
    "text": "که سازند زو نامدار افسری"
  },
  {
    "poem_id": 1645,
    "vorder": 125,
    "position": 0,
    "text": "سرانجام لشکر نماند نه شاه"
  },
  {
    "poem_id": 1645,
    "vorder": 126,
    "position": 1,
    "text": "بیاید نو آیین یکی پیش‌گاه"
  },
  {
    "poem_id": 1645,
    "vorder": 127,
    "position": 0,
    "text": "کنون این زمان روز اسکندرست"
  },
  {
    "poem_id": 1645,
    "vorder": 128,
    "position": 1,
    "text": "که بر تارک مهتران افسرست"
  },
  {
    "poem_id": 1645,
    "vorder": 129,
    "position": 0,
    "text": "چو آید بدو ده تو این چار چیز"
  },
  {
    "poem_id": 1645,
    "vorder": 130,
    "position": 1,
    "text": "برآنم که چیزی نخواهد به نیز"
  },
  {
    "poem_id": 1645,
    "vorder": 131,
    "position": 0,
    "text": "چو خشنود داری ورا بگذرد"
  },
  {
    "poem_id": 1645,
    "vorder": 132,
    "position": 1,
    "text": "که دانش پژوهست و دارد خرد"
  },
  {
    "poem_id": 1645,
    "vorder": 133,
    "position": 0,
    "text": "ز مهران چو بشنید کید این سخن"
  },
  {
    "poem_id": 1645,
    "vorder": 134,
    "position": 1,
    "text": "برو تازه شد روزگار کهن"
  },
  {
    "poem_id": 1645,
    "vorder": 135,
    "position": 0,
    "text": "بیامد سر و چشم او بوس داد"
  },
  {
    "poem_id": 1645,
    "vorder": 136,
    "position": 1,
    "text": "دلارام و پیروز برگشت شاد"
  },
  {
    "poem_id": 1645,
    "vorder": 137,
    "position": 0,
    "text": "ز نزدیک دانا چو برگشت شاه"
  },
  {
    "poem_id": 1645,
    "vorder": 138,
    "position": 1,
    "text": "حکیمان برفتند با او براه"
  }
]