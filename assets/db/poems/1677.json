[
  {
    "poem_id": 1677,
    "vorder": 1,
    "position": 0,
    "text": "ز راه بیابان به شهری رسید"
  },
  {
    "poem_id": 1677,
    "vorder": 2,
    "position": 1,
    "text": "ببد شاد کآواز مردم شنید"
  },
  {
    "poem_id": 1677,
    "vorder": 3,
    "position": 0,
    "text": "همه بوم و بر باغ آباد بود"
  },
  {
    "poem_id": 1677,
    "vorder": 4,
    "position": 1,
    "text": "در مردم از خرمی شاد بود"
  },
  {
    "poem_id": 1677,
    "vorder": 5,
    "position": 0,
    "text": "پذیره شدندش بزرگان شهر"
  },
  {
    "poem_id": 1677,
    "vorder": 6,
    "position": 1,
    "text": "کسی را که از مردمی بود بهر"
  },
  {
    "poem_id": 1677,
    "vorder": 7,
    "position": 0,
    "text": "برو همگنان آفرین خواندند"
  },
  {
    "poem_id": 1677,
    "vorder": 8,
    "position": 1,
    "text": "همه زر و گوهر برافشاندند"
  },
  {
    "poem_id": 1677,
    "vorder": 9,
    "position": 0,
    "text": "همی گفت هرکس که ای شهریار"
  },
  {
    "poem_id": 1677,
    "vorder": 10,
    "position": 1,
    "text": "انوشه که کردی بمابر گذار"
  },
  {
    "poem_id": 1677,
    "vorder": 11,
    "position": 0,
    "text": "بدین شهر هرگز نیامد سپاه"
  },
  {
    "poem_id": 1677,
    "vorder": 12,
    "position": 1,
    "text": "نه هرگز شنیدست کس نام شاه"
  },
  {
    "poem_id": 1677,
    "vorder": 13,
    "position": 0,
    "text": "کنون کامدی جان ما پیش تست"
  },
  {
    "poem_id": 1677,
    "vorder": 14,
    "position": 1,
    "text": "که روشن‌روان بادی و تن درست"
  },
  {
    "poem_id": 1677,
    "vorder": 15,
    "position": 0,
    "text": "سکندر دل از مردمان شاد کرد"
  },
  {
    "poem_id": 1677,
    "vorder": 16,
    "position": 1,
    "text": "ز راه بیابان تن آزاد کرد"
  },
  {
    "poem_id": 1677,
    "vorder": 17,
    "position": 0,
    "text": "بپرسید ازیشان که ایدر شگفت"
  },
  {
    "poem_id": 1677,
    "vorder": 18,
    "position": 1,
    "text": "چه چیزست کاندازه باید گرفت"
  },
  {
    "poem_id": 1677,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ بدو رهنمای"
  },
  {
    "poem_id": 1677,
    "vorder": 20,
    "position": 1,
    "text": "که ای شاه پیروز پاکیزه‌رای"
  },
  {
    "poem_id": 1677,
    "vorder": 21,
    "position": 0,
    "text": "شگفتیست ایدر که اندر جهان"
  },
  {
    "poem_id": 1677,
    "vorder": 22,
    "position": 1,
    "text": "کسی آن ندید آشکار و نهان"
  },
  {
    "poem_id": 1677,
    "vorder": 23,
    "position": 0,
    "text": "درختیست ایدر دو بن گشته جفت"
  },
  {
    "poem_id": 1677,
    "vorder": 24,
    "position": 1,
    "text": "که چونان شگفتی نشاید نهفت"
  },
  {
    "poem_id": 1677,
    "vorder": 25,
    "position": 0,
    "text": "یکی ماده و دیگری نر اوی"
  },
  {
    "poem_id": 1677,
    "vorder": 26,
    "position": 1,
    "text": "سخن‌گو بود شاخ با رنگ و بوی"
  },
  {
    "poem_id": 1677,
    "vorder": 27,
    "position": 0,
    "text": "به شب ماده گویا و بویا شود"
  },
  {
    "poem_id": 1677,
    "vorder": 28,
    "position": 1,
    "text": "چو روشن شود نر گویا شود"
  },
  {
    "poem_id": 1677,
    "vorder": 29,
    "position": 0,
    "text": "سکندر بشد با سواران روم"
  },
  {
    "poem_id": 1677,
    "vorder": 30,
    "position": 1,
    "text": "همان نامداران آن مرز و بوم"
  },
  {
    "poem_id": 1677,
    "vorder": 31,
    "position": 0,
    "text": "بپرسید زیشان که اکنون درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 32,
    "position": 1,
    "text": "سخن کی سراید به آواز سخت"
  },
  {
    "poem_id": 1677,
    "vorder": 33,
    "position": 0,
    "text": "چنین داد پاسخ بدو ترجمان"
  },
  {
    "poem_id": 1677,
    "vorder": 34,
    "position": 1,
    "text": "که از روز چون بگذرد نه زمان"
  },
  {
    "poem_id": 1677,
    "vorder": 35,
    "position": 0,
    "text": "سخن‌گوی گردد یکی زین درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 36,
    "position": 1,
    "text": "که آواز او بشنود نیک‌بخت"
  },
  {
    "poem_id": 1677,
    "vorder": 37,
    "position": 0,
    "text": "شب تیره‌گون ماده گویا شود"
  },
  {
    "poem_id": 1677,
    "vorder": 38,
    "position": 1,
    "text": "بر و برگ چون مشک بویا شود"
  },
  {
    "poem_id": 1677,
    "vorder": 39,
    "position": 0,
    "text": "بپرسید چون بگذریم از درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 40,
    "position": 1,
    "text": "شگفتی چه پیش آید ای نیک‌بخت"
  },
  {
    "poem_id": 1677,
    "vorder": 41,
    "position": 0,
    "text": "چنین داد پاسخ کزو بگذری"
  },
  {
    "poem_id": 1677,
    "vorder": 42,
    "position": 1,
    "text": "ز رفتنت کوته شود داوری"
  },
  {
    "poem_id": 1677,
    "vorder": 43,
    "position": 0,
    "text": "چو زو برگذشتی نماندت جای"
  },
  {
    "poem_id": 1677,
    "vorder": 44,
    "position": 1,
    "text": "کران جهان خواندش رهنمای"
  },
  {
    "poem_id": 1677,
    "vorder": 45,
    "position": 0,
    "text": "بیابان و تاریکی آید به پیش"
  },
  {
    "poem_id": 1677,
    "vorder": 46,
    "position": 1,
    "text": "به سیری نیامد کس از جان خویش"
  },
  {
    "poem_id": 1677,
    "vorder": 47,
    "position": 0,
    "text": "نه کس دید از ما نه هرگز شنید"
  },
  {
    "poem_id": 1677,
    "vorder": 48,
    "position": 1,
    "text": "که دام و دد و مرغ بر ره پرید"
  },
  {
    "poem_id": 1677,
    "vorder": 49,
    "position": 0,
    "text": "همی راند با رومیان نیک‌بخت"
  },
  {
    "poem_id": 1677,
    "vorder": 50,
    "position": 1,
    "text": "چو آمد به نزدیک گویا درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 51,
    "position": 0,
    "text": "زمینش ز گرمی همی بردمید"
  },
  {
    "poem_id": 1677,
    "vorder": 52,
    "position": 1,
    "text": "ز پوست ددان خاک پیدا ندید"
  },
  {
    "poem_id": 1677,
    "vorder": 53,
    "position": 0,
    "text": "ز گوینده پرسید کین پوست چیست"
  },
  {
    "poem_id": 1677,
    "vorder": 54,
    "position": 1,
    "text": "ددان را برین گونه درنده کیست"
  },
  {
    "poem_id": 1677,
    "vorder": 55,
    "position": 0,
    "text": "چنین داد پاسخ بدو نیک‌بخت"
  },
  {
    "poem_id": 1677,
    "vorder": 56,
    "position": 1,
    "text": "که چندین پرستنده دارد درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 57,
    "position": 0,
    "text": "چو باید پرستندگان را خورش"
  },
  {
    "poem_id": 1677,
    "vorder": 58,
    "position": 1,
    "text": "ز گوشت ددان باشدش پرورش"
  },
  {
    "poem_id": 1677,
    "vorder": 59,
    "position": 0,
    "text": "چو خورشید بر تیغ گنبد رسید"
  },
  {
    "poem_id": 1677,
    "vorder": 60,
    "position": 1,
    "text": "سکندر ز بالا خروشی شنید"
  },
  {
    "poem_id": 1677,
    "vorder": 61,
    "position": 0,
    "text": "که آمد ز برگ درخت بلند"
  },
  {
    "poem_id": 1677,
    "vorder": 62,
    "position": 1,
    "text": "خروشی پر از سهم و ناسودمند"
  },
  {
    "poem_id": 1677,
    "vorder": 63,
    "position": 0,
    "text": "بترسید و پرسید زان ترجمان"
  },
  {
    "poem_id": 1677,
    "vorder": 64,
    "position": 1,
    "text": "که ای مرد بیدار نیکی گمان"
  },
  {
    "poem_id": 1677,
    "vorder": 65,
    "position": 0,
    "text": "چنین برگ گویا چه گوید همی"
  },
  {
    "poem_id": 1677,
    "vorder": 66,
    "position": 1,
    "text": "که دل را به خوناب شوید همی"
  },
  {
    "poem_id": 1677,
    "vorder": 67,
    "position": 0,
    "text": "چنین داد پاسخ که ای نیک‌بخت"
  },
  {
    "poem_id": 1677,
    "vorder": 68,
    "position": 1,
    "text": "همی گوید این برگ شاخ درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 69,
    "position": 0,
    "text": "که چندین سکندر چه پوید به دهر"
  },
  {
    "poem_id": 1677,
    "vorder": 70,
    "position": 1,
    "text": "که برداشت از نیکویهایش بهر"
  },
  {
    "poem_id": 1677,
    "vorder": 71,
    "position": 0,
    "text": "ز شاهیش چون سال شد بر دو هفت"
  },
  {
    "poem_id": 1677,
    "vorder": 72,
    "position": 1,
    "text": "ز تخت بزرگی ببایدش رفت"
  },
  {
    "poem_id": 1677,
    "vorder": 73,
    "position": 0,
    "text": "سکندر ز دیده ببارید خون"
  },
  {
    "poem_id": 1677,
    "vorder": 74,
    "position": 1,
    "text": "دلش گشت پر درد از رهنمون"
  },
  {
    "poem_id": 1677,
    "vorder": 75,
    "position": 0,
    "text": "ازان پس به کس نیز نگشاد لب"
  },
  {
    "poem_id": 1677,
    "vorder": 76,
    "position": 1,
    "text": "پر از غم همی بود تا نیم‌شب"
  },
  {
    "poem_id": 1677,
    "vorder": 77,
    "position": 0,
    "text": "سخن‌گوی شد برگ دیگر درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 78,
    "position": 1,
    "text": "دگر باره پرسید زان نیک‌بخت"
  },
  {
    "poem_id": 1677,
    "vorder": 79,
    "position": 0,
    "text": "چه گوید همی این دگر شاخ گفت"
  },
  {
    "poem_id": 1677,
    "vorder": 80,
    "position": 1,
    "text": "سخن‌گوی بگشاد راز از نهفت"
  },
  {
    "poem_id": 1677,
    "vorder": 81,
    "position": 0,
    "text": "چنین داد پاسخ که این ماده شاخ"
  },
  {
    "poem_id": 1677,
    "vorder": 82,
    "position": 1,
    "text": "همی گوید اندر جهان فراخ"
  },
  {
    "poem_id": 1677,
    "vorder": 83,
    "position": 0,
    "text": "از آز فراوان نگنجی همی"
  },
  {
    "poem_id": 1677,
    "vorder": 84,
    "position": 1,
    "text": "روان را چرا بر شکنجی همی"
  },
  {
    "poem_id": 1677,
    "vorder": 85,
    "position": 0,
    "text": "ترا آز گرد جهان گشتن است"
  },
  {
    "poem_id": 1677,
    "vorder": 86,
    "position": 1,
    "text": "کس آزردن و پادشا کشتن است"
  },
  {
    "poem_id": 1677,
    "vorder": 87,
    "position": 0,
    "text": "نماندت ایدر فراوان درنگ"
  },
  {
    "poem_id": 1677,
    "vorder": 88,
    "position": 1,
    "text": "مکن روز بر خویشتن تار و تنگ"
  },
  {
    "poem_id": 1677,
    "vorder": 89,
    "position": 0,
    "text": "بپرسید از ترجمان پادشا"
  },
  {
    "poem_id": 1677,
    "vorder": 90,
    "position": 1,
    "text": "که ای مرد روشن‌دل و پارسا"
  },
  {
    "poem_id": 1677,
    "vorder": 91,
    "position": 0,
    "text": "یکی بازپرسش که باشم به روم"
  },
  {
    "poem_id": 1677,
    "vorder": 92,
    "position": 1,
    "text": "چو پیش آید آن گردش روز شوم"
  },
  {
    "poem_id": 1677,
    "vorder": 93,
    "position": 0,
    "text": "مگر زنده بیند مرا مادرم"
  },
  {
    "poem_id": 1677,
    "vorder": 94,
    "position": 1,
    "text": "یکی تا به رخ برکشد چادرم"
  },
  {
    "poem_id": 1677,
    "vorder": 95,
    "position": 0,
    "text": "چنین گفت با شاه گویا درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 96,
    "position": 1,
    "text": "که کوتاه کن روز و بربند رخت"
  },
  {
    "poem_id": 1677,
    "vorder": 97,
    "position": 0,
    "text": "نه مادرت بیند نه خویشان به روم"
  },
  {
    "poem_id": 1677,
    "vorder": 98,
    "position": 1,
    "text": "نه پوشیده رویان آن مرز و بوم"
  },
  {
    "poem_id": 1677,
    "vorder": 99,
    "position": 0,
    "text": "به شهر کسان مرگت آید نه دیر"
  },
  {
    "poem_id": 1677,
    "vorder": 100,
    "position": 1,
    "text": "شود اختر و تاج و تخت از تو سیر"
  },
  {
    "poem_id": 1677,
    "vorder": 101,
    "position": 0,
    "text": "چو بشنید برگشت زان دو درخت"
  },
  {
    "poem_id": 1677,
    "vorder": 102,
    "position": 1,
    "text": "دلش خسته گشته به شمشیر سخت"
  },
  {
    "poem_id": 1677,
    "vorder": 103,
    "position": 0,
    "text": "چو آمد به لشکرگه خویش باز"
  },
  {
    "poem_id": 1677,
    "vorder": 104,
    "position": 1,
    "text": "برفتند گردان گردن‌فراز"
  },
  {
    "poem_id": 1677,
    "vorder": 105,
    "position": 0,
    "text": "به شهر اندرون هدیه‌ها ساختند"
  },
  {
    "poem_id": 1677,
    "vorder": 106,
    "position": 1,
    "text": "بزرگان بر پادشا تاختند"
  },
  {
    "poem_id": 1677,
    "vorder": 107,
    "position": 0,
    "text": "یکی جوشنی بود تابان چو نیل"
  },
  {
    "poem_id": 1677,
    "vorder": 108,
    "position": 1,
    "text": "به بالای و پهنای یک چرم پیل"
  },
  {
    "poem_id": 1677,
    "vorder": 109,
    "position": 0,
    "text": "دو دندان پیل و برش پنج بود"
  },
  {
    "poem_id": 1677,
    "vorder": 110,
    "position": 1,
    "text": "که آن را به برداشتن رنج بود"
  },
  {
    "poem_id": 1677,
    "vorder": 111,
    "position": 0,
    "text": "زره بود و دیبای پرمایه بود"
  },
  {
    "poem_id": 1677,
    "vorder": 112,
    "position": 1,
    "text": "ز زر کرده آگنده صد خایه بود"
  },
  {
    "poem_id": 1677,
    "vorder": 113,
    "position": 0,
    "text": "به سنگ درم هر یکی شست من"
  },
  {
    "poem_id": 1677,
    "vorder": 114,
    "position": 1,
    "text": "ز زر و ز گوهر یکی کرگدن"
  },
  {
    "poem_id": 1677,
    "vorder": 115,
    "position": 0,
    "text": "بپذرفت زان شهر و لشکر براند"
  },
  {
    "poem_id": 1677,
    "vorder": 116,
    "position": 1,
    "text": "ز دیده همی خون دل برفشاند"
  }
]