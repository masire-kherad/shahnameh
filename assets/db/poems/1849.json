[
  {
    "poem_id": 1849,
    "vorder": 1,
    "position": 0,
    "text": "چوپیدا شد آن چادر قیرگون"
  },
  {
    "poem_id": 1849,
    "vorder": 2,
    "position": 1,
    "text": "درفشان شد اختر بچرخ اندرون"
  },
  {
    "poem_id": 1849,
    "vorder": 3,
    "position": 0,
    "text": "چو آواز دارندهٔ پاس خاست"
  },
  {
    "poem_id": 1849,
    "vorder": 4,
    "position": 1,
    "text": "قلم خواست بهرام و قرطاس خواست"
  },
  {
    "poem_id": 1849,
    "vorder": 5,
    "position": 0,
    "text": "بیامد دبیر خردمند و راد"
  },
  {
    "poem_id": 1849,
    "vorder": 6,
    "position": 1,
    "text": "دوات و قلم پیش دانا نهاد"
  },
  {
    "poem_id": 1849,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت عهدی ز ایرانیان"
  },
  {
    "poem_id": 1849,
    "vorder": 8,
    "position": 1,
    "text": "بباید نوشتن برین پرنیان"
  },
  {
    "poem_id": 1849,
    "vorder": 9,
    "position": 0,
    "text": "که بهرام شاهست و پیروزبخت"
  },
  {
    "poem_id": 1849,
    "vorder": 10,
    "position": 1,
    "text": "سزاوار تاج است و زیبای تخت"
  },
  {
    "poem_id": 1849,
    "vorder": 11,
    "position": 0,
    "text": "نجوید جز از راستی درجهان"
  },
  {
    "poem_id": 1849,
    "vorder": 12,
    "position": 1,
    "text": "چه در آشکار و چه اندر نهان"
  },
  {
    "poem_id": 1849,
    "vorder": 13,
    "position": 0,
    "text": "نوشته شد آن شمع برداشتند"
  },
  {
    "poem_id": 1849,
    "vorder": 14,
    "position": 1,
    "text": "شب تیره باندیشه بگذاشتند"
  },
  {
    "poem_id": 1849,
    "vorder": 15,
    "position": 0,
    "text": "چو پنهان شد آن چادر لاژورد"
  },
  {
    "poem_id": 1849,
    "vorder": 16,
    "position": 1,
    "text": "جهان شد ز دیدار خورشید زرد"
  },
  {
    "poem_id": 1849,
    "vorder": 17,
    "position": 0,
    "text": "بیامد یکی مرد پیروزبخت"
  },
  {
    "poem_id": 1849,
    "vorder": 18,
    "position": 1,
    "text": "نهاد اندر ایوان بهرام تخت"
  },
  {
    "poem_id": 1849,
    "vorder": 19,
    "position": 0,
    "text": "برفتند ایوان شاهی چو عاج"
  },
  {
    "poem_id": 1849,
    "vorder": 20,
    "position": 1,
    "text": "بیاویختند از برگاه تاج"
  },
  {
    "poem_id": 1849,
    "vorder": 21,
    "position": 0,
    "text": "برتخت زرین یکی زیرگاه"
  },
  {
    "poem_id": 1849,
    "vorder": 22,
    "position": 1,
    "text": "نهادند و پس برگشادند راه"
  },
  {
    "poem_id": 1849,
    "vorder": 23,
    "position": 0,
    "text": "نشست از بر تخت بهرامشاه"
  },
  {
    "poem_id": 1849,
    "vorder": 24,
    "position": 1,
    "text": "به سر برنهاد آن کیانی کلاه"
  },
  {
    "poem_id": 1849,
    "vorder": 25,
    "position": 0,
    "text": "دبیرش بیاورد عهد کیان"
  },
  {
    "poem_id": 1849,
    "vorder": 26,
    "position": 1,
    "text": "نوشته بران پربها پرنیان"
  },
  {
    "poem_id": 1849,
    "vorder": 27,
    "position": 0,
    "text": "گوایی نوشتند یکسر مهان"
  },
  {
    "poem_id": 1849,
    "vorder": 28,
    "position": 1,
    "text": "که بهرام شد شهریار جهان"
  },
  {
    "poem_id": 1849,
    "vorder": 29,
    "position": 0,
    "text": "بران نامه چون نام کردند یاد"
  },
  {
    "poem_id": 1849,
    "vorder": 30,
    "position": 1,
    "text": "بروبر یکی مهر زرین نهاد"
  },
  {
    "poem_id": 1849,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت کاین پادشاهی مراست"
  },
  {
    "poem_id": 1849,
    "vorder": 32,
    "position": 1,
    "text": "بدین بر شما پاک یزدان گواست"
  },
  {
    "poem_id": 1849,
    "vorder": 33,
    "position": 0,
    "text": "چنین هم بماناد سالی هزار"
  },
  {
    "poem_id": 1849,
    "vorder": 34,
    "position": 1,
    "text": "که از تخمهٔ من بود شهریار"
  },
  {
    "poem_id": 1849,
    "vorder": 35,
    "position": 0,
    "text": "پسر بر پسر هم چنین ارجمند"
  },
  {
    "poem_id": 1849,
    "vorder": 36,
    "position": 1,
    "text": "بماناد با تاج و تخت بلند"
  },
  {
    "poem_id": 1849,
    "vorder": 37,
    "position": 0,
    "text": "بآذر مه اندر بد و روز هور"
  },
  {
    "poem_id": 1849,
    "vorder": 38,
    "position": 1,
    "text": "که از شیر پردخته شد پشت گور"
  },
  {
    "poem_id": 1849,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت زان پس بایرانیان"
  },
  {
    "poem_id": 1849,
    "vorder": 40,
    "position": 1,
    "text": "که برخاست پرخاش و کین از میان"
  },
  {
    "poem_id": 1849,
    "vorder": 41,
    "position": 0,
    "text": "کسی کوبرین نیست همداستان"
  },
  {
    "poem_id": 1849,
    "vorder": 42,
    "position": 1,
    "text": "اگر کژ باشید اگر راستان"
  },
  {
    "poem_id": 1849,
    "vorder": 43,
    "position": 0,
    "text": "به ایران مباشید بیش از سه روز"
  },
  {
    "poem_id": 1849,
    "vorder": 44,
    "position": 1,
    "text": "چهارم چو از چرخ گیتی فروز"
  },
  {
    "poem_id": 1849,
    "vorder": 45,
    "position": 0,
    "text": "بر آید همه نزد خسرو شوید"
  },
  {
    "poem_id": 1849,
    "vorder": 46,
    "position": 1,
    "text": "برین بوم و بر بیش ازین مغنوید"
  },
  {
    "poem_id": 1849,
    "vorder": 47,
    "position": 0,
    "text": "نه از دل برو خواندند آفرین"
  },
  {
    "poem_id": 1849,
    "vorder": 48,
    "position": 1,
    "text": "که پردخته از تو مبادا زمین"
  },
  {
    "poem_id": 1849,
    "vorder": 49,
    "position": 0,
    "text": "هرآنکس که با شاه پیوسته بود"
  },
  {
    "poem_id": 1849,
    "vorder": 50,
    "position": 1,
    "text": "بران پادشاهی دلش خسته بود"
  },
  {
    "poem_id": 1849,
    "vorder": 51,
    "position": 0,
    "text": "برفتند زان بوم تا مرز روم"
  },
  {
    "poem_id": 1849,
    "vorder": 52,
    "position": 1,
    "text": "پراگنده گشتند ز آباد بوم"
  }
]