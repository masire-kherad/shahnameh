[
  {
    "poem_id": 1500,
    "vorder": 1,
    "position": 0,
    "text": "چو با گیو کیخسرو آمد به زم"
  },
  {
    "poem_id": 1500,
    "vorder": 2,
    "position": 1,
    "text": "جهان چند ازو شاد و چندی دژم"
  },
  {
    "poem_id": 1500,
    "vorder": 3,
    "position": 0,
    "text": "نوندی به هر سو برافگند گیو"
  },
  {
    "poem_id": 1500,
    "vorder": 4,
    "position": 1,
    "text": "یکی نامه از شاه وز گیو نیو"
  },
  {
    "poem_id": 1500,
    "vorder": 5,
    "position": 0,
    "text": "که آمد ز توران جهاندار شاد"
  },
  {
    "poem_id": 1500,
    "vorder": 6,
    "position": 1,
    "text": "سر تخمهٔ نامور کیقباد"
  },
  {
    "poem_id": 1500,
    "vorder": 7,
    "position": 0,
    "text": "فرستادهٔ بختیار و سوار"
  },
  {
    "poem_id": 1500,
    "vorder": 8,
    "position": 1,
    "text": "خردمند و بینادل و دوستدار"
  },
  {
    "poem_id": 1500,
    "vorder": 9,
    "position": 0,
    "text": "گزین کرد ازان نامداران زم"
  },
  {
    "poem_id": 1500,
    "vorder": 10,
    "position": 1,
    "text": "بگفت آنچ بشنید از بیش و کم"
  },
  {
    "poem_id": 1500,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت ز ایدر برو باصفهان"
  },
  {
    "poem_id": 1500,
    "vorder": 12,
    "position": 1,
    "text": "بر نیو گودرز کشوادگان"
  },
  {
    "poem_id": 1500,
    "vorder": 13,
    "position": 0,
    "text": "بگویش که کیخسرو آمد به زم"
  },
  {
    "poem_id": 1500,
    "vorder": 14,
    "position": 1,
    "text": "که بادی نجست از بر او دژم"
  },
  {
    "poem_id": 1500,
    "vorder": 15,
    "position": 0,
    "text": "یکی نامه نزدیک کاووس شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 16,
    "position": 1,
    "text": "فرستاده‌ای چست بگرفت راه"
  },
  {
    "poem_id": 1500,
    "vorder": 17,
    "position": 0,
    "text": "هیونان کفک افگن بادپای"
  },
  {
    "poem_id": 1500,
    "vorder": 18,
    "position": 1,
    "text": "بجستند برسان آتش ز جای"
  },
  {
    "poem_id": 1500,
    "vorder": 19,
    "position": 0,
    "text": "فرستادهٔ گیو روشن روان"
  },
  {
    "poem_id": 1500,
    "vorder": 20,
    "position": 1,
    "text": "نخستین بیامد بر پهلوان"
  },
  {
    "poem_id": 1500,
    "vorder": 21,
    "position": 0,
    "text": "پیامش همی گفت و نامه بداد"
  },
  {
    "poem_id": 1500,
    "vorder": 22,
    "position": 1,
    "text": "جهان پهلوان نامه بر سر نهاد"
  },
  {
    "poem_id": 1500,
    "vorder": 23,
    "position": 0,
    "text": "ز بهر سیاووش ببارید آب"
  },
  {
    "poem_id": 1500,
    "vorder": 24,
    "position": 1,
    "text": "همی کرد نفرین بر افراسیاب"
  },
  {
    "poem_id": 1500,
    "vorder": 25,
    "position": 0,
    "text": "فرستاده شد نزد کاووس کی"
  },
  {
    "poem_id": 1500,
    "vorder": 26,
    "position": 1,
    "text": "ز یال هیونان بپالود خوی"
  },
  {
    "poem_id": 1500,
    "vorder": 27,
    "position": 0,
    "text": "چو آمد به نزدیک کاووس شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 28,
    "position": 1,
    "text": "ز شادی خروش آمد از بارگاه"
  },
  {
    "poem_id": 1500,
    "vorder": 29,
    "position": 0,
    "text": "خبر شد به گیتی که فرزند شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 30,
    "position": 1,
    "text": "جهانجوی کیخسرو آمد ز راه"
  },
  {
    "poem_id": 1500,
    "vorder": 31,
    "position": 0,
    "text": "سپهبد فرستاده را پیش خواند"
  },
  {
    "poem_id": 1500,
    "vorder": 32,
    "position": 1,
    "text": "بران نامهٔ گیو گوهر فشاند"
  },
  {
    "poem_id": 1500,
    "vorder": 33,
    "position": 0,
    "text": "جهانی به شادی بیاراستند"
  },
  {
    "poem_id": 1500,
    "vorder": 34,
    "position": 1,
    "text": "بهر جای رامشگران خواستند"
  },
  {
    "poem_id": 1500,
    "vorder": 35,
    "position": 0,
    "text": "ازان پس ز کشور مهان جهان"
  },
  {
    "poem_id": 1500,
    "vorder": 36,
    "position": 1,
    "text": "برفتند یکسر سوی اصفهان"
  },
  {
    "poem_id": 1500,
    "vorder": 37,
    "position": 0,
    "text": "بیاراست گودرز کاخ بلند"
  },
  {
    "poem_id": 1500,
    "vorder": 38,
    "position": 1,
    "text": "همه دیبهٔ خسروانی فگند"
  },
  {
    "poem_id": 1500,
    "vorder": 39,
    "position": 0,
    "text": "یکی تخت بنهاد پیکر به زر"
  },
  {
    "poem_id": 1500,
    "vorder": 40,
    "position": 1,
    "text": "بدو اندرون چند گونه گهر"
  },
  {
    "poem_id": 1500,
    "vorder": 41,
    "position": 0,
    "text": "یکی تاج با یاره و گوشوار"
  },
  {
    "poem_id": 1500,
    "vorder": 42,
    "position": 1,
    "text": "یکی طوق پر گوهر شاهوار"
  },
  {
    "poem_id": 1500,
    "vorder": 43,
    "position": 0,
    "text": "به زر و به گوهر بیاراست گاه"
  },
  {
    "poem_id": 1500,
    "vorder": 44,
    "position": 1,
    "text": "چنان چون بباید سزاوار شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 45,
    "position": 0,
    "text": "سراسر همه شهر آیین ببست"
  },
  {
    "poem_id": 1500,
    "vorder": 46,
    "position": 1,
    "text": "بیاراست میدان و جای نشست"
  },
  {
    "poem_id": 1500,
    "vorder": 47,
    "position": 0,
    "text": "مهان سرافراز برخاستند"
  },
  {
    "poem_id": 1500,
    "vorder": 48,
    "position": 1,
    "text": "پذیره شدن را بیاراستند"
  },
  {
    "poem_id": 1500,
    "vorder": 49,
    "position": 0,
    "text": "برفتند هشتاد فرسنگ پیش"
  },
  {
    "poem_id": 1500,
    "vorder": 50,
    "position": 1,
    "text": "پذیره شدندش به آیین خویش"
  },
  {
    "poem_id": 1500,
    "vorder": 51,
    "position": 0,
    "text": "چو چشم سپهبد برآمد به شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 52,
    "position": 1,
    "text": "همان گیو را دید با او به راه"
  },
  {
    "poem_id": 1500,
    "vorder": 53,
    "position": 0,
    "text": "چو آمد پدیدار با شاه گیو"
  },
  {
    "poem_id": 1500,
    "vorder": 54,
    "position": 1,
    "text": "پیاده شدند آن سواران نیو"
  },
  {
    "poem_id": 1500,
    "vorder": 55,
    "position": 0,
    "text": "فرو ریخت از دیدگان آب زرد"
  },
  {
    "poem_id": 1500,
    "vorder": 56,
    "position": 1,
    "text": "ز درد سیاوش بسی یاد کرد"
  },
  {
    "poem_id": 1500,
    "vorder": 57,
    "position": 0,
    "text": "ستودش فراوان و کرد آفرین"
  },
  {
    "poem_id": 1500,
    "vorder": 58,
    "position": 1,
    "text": "چنین گفت کای شهریار زمین"
  },
  {
    "poem_id": 1500,
    "vorder": 59,
    "position": 0,
    "text": "ز تو چشم بدخواه تو دور باد"
  },
  {
    "poem_id": 1500,
    "vorder": 60,
    "position": 1,
    "text": "روان سیاوش پر از نور باد"
  },
  {
    "poem_id": 1500,
    "vorder": 61,
    "position": 0,
    "text": "جهاندار یزدان گوای منست"
  },
  {
    "poem_id": 1500,
    "vorder": 62,
    "position": 1,
    "text": "که دیدار تو رهنمای منست"
  },
  {
    "poem_id": 1500,
    "vorder": 63,
    "position": 0,
    "text": "سیاووش را زنده گر دیدمی"
  },
  {
    "poem_id": 1500,
    "vorder": 64,
    "position": 1,
    "text": "بدین گونه از دل نخندیدمی"
  },
  {
    "poem_id": 1500,
    "vorder": 65,
    "position": 0,
    "text": "بزرگان ایران همه پیش اوی"
  },
  {
    "poem_id": 1500,
    "vorder": 66,
    "position": 1,
    "text": "یکایک نهادند بر خاک روی"
  },
  {
    "poem_id": 1500,
    "vorder": 67,
    "position": 0,
    "text": "وزان جایگه شاد گشتند باز"
  },
  {
    "poem_id": 1500,
    "vorder": 68,
    "position": 1,
    "text": "فروزنده شد بخت گردن فراز"
  },
  {
    "poem_id": 1500,
    "vorder": 69,
    "position": 0,
    "text": "ببوسید چشم و سر گیو گفت"
  },
  {
    "poem_id": 1500,
    "vorder": 70,
    "position": 1,
    "text": "که بیرون کشیدی سپهر از نهفت"
  },
  {
    "poem_id": 1500,
    "vorder": 71,
    "position": 0,
    "text": "گزارندهٔ خواب و جنگی توی"
  },
  {
    "poem_id": 1500,
    "vorder": 72,
    "position": 1,
    "text": "گه چاره مرد درنگی توی"
  },
  {
    "poem_id": 1500,
    "vorder": 73,
    "position": 0,
    "text": "سوی خانهٔ پهلوان آمدند"
  },
  {
    "poem_id": 1500,
    "vorder": 74,
    "position": 1,
    "text": "همه شاد و روشن روان آمدند"
  },
  {
    "poem_id": 1500,
    "vorder": 75,
    "position": 0,
    "text": "ببودند یک هفته با می بدست"
  },
  {
    "poem_id": 1500,
    "vorder": 76,
    "position": 1,
    "text": "بیاراسته بزمگاه و نشست"
  },
  {
    "poem_id": 1500,
    "vorder": 77,
    "position": 0,
    "text": "به هشتم سوی شهر کاووس شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 78,
    "position": 1,
    "text": "همه شاددل برگرفتند راه"
  },
  {
    "poem_id": 1500,
    "vorder": 79,
    "position": 0,
    "text": "چو کیخسرو آمد بر شهریار"
  },
  {
    "poem_id": 1500,
    "vorder": 80,
    "position": 1,
    "text": "جهان گشت پر بوی و رنگ و نگار"
  },
  {
    "poem_id": 1500,
    "vorder": 81,
    "position": 0,
    "text": "بر آیین جهانی شد آراسته"
  },
  {
    "poem_id": 1500,
    "vorder": 82,
    "position": 1,
    "text": "در و بام و دیوار پرخواسته"
  },
  {
    "poem_id": 1500,
    "vorder": 83,
    "position": 0,
    "text": "نشسته به هر جای رامشگران"
  },
  {
    "poem_id": 1500,
    "vorder": 84,
    "position": 1,
    "text": "گلاب و می و مشک با زعفران"
  },
  {
    "poem_id": 1500,
    "vorder": 85,
    "position": 0,
    "text": "همه یال اسپان پر از مشک و می"
  },
  {
    "poem_id": 1500,
    "vorder": 86,
    "position": 1,
    "text": "درم با شکر ریخته زیر پی"
  },
  {
    "poem_id": 1500,
    "vorder": 87,
    "position": 0,
    "text": "چو کاووس کی روی خسرو بدید"
  },
  {
    "poem_id": 1500,
    "vorder": 88,
    "position": 1,
    "text": "سرشکش ز مژگان به رخ بر چکید"
  },
  {
    "poem_id": 1500,
    "vorder": 89,
    "position": 0,
    "text": "فرود آمد از تخت و شد پیش اوی"
  },
  {
    "poem_id": 1500,
    "vorder": 90,
    "position": 1,
    "text": "بمالید بر چشم او چشم و روی"
  },
  {
    "poem_id": 1500,
    "vorder": 91,
    "position": 0,
    "text": "جوان جهانجوی بردش نماز"
  },
  {
    "poem_id": 1500,
    "vorder": 92,
    "position": 1,
    "text": "گرازان سوی تخت رفتند باز"
  },
  {
    "poem_id": 1500,
    "vorder": 93,
    "position": 0,
    "text": "فراوان ز ترکان بپرسید شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 94,
    "position": 1,
    "text": "هم از تخت سالار توران سپاه"
  },
  {
    "poem_id": 1500,
    "vorder": 95,
    "position": 0,
    "text": "چنین پاسخ آورد کان کم خرد"
  },
  {
    "poem_id": 1500,
    "vorder": 96,
    "position": 1,
    "text": "به بد روی گیتی همی بسپرد"
  },
  {
    "poem_id": 1500,
    "vorder": 97,
    "position": 0,
    "text": "مرا چند ببسود و چندی بگفت"
  },
  {
    "poem_id": 1500,
    "vorder": 98,
    "position": 1,
    "text": "خرد با هنر کردم اندر نهفت"
  },
  {
    "poem_id": 1500,
    "vorder": 99,
    "position": 0,
    "text": "بترسیدم از کار و کردار او"
  },
  {
    "poem_id": 1500,
    "vorder": 100,
    "position": 1,
    "text": "بپیچیدم از رنج و تیمار او"
  },
  {
    "poem_id": 1500,
    "vorder": 101,
    "position": 0,
    "text": "اگر ویژه ابری شود در بار"
  },
  {
    "poem_id": 1500,
    "vorder": 102,
    "position": 1,
    "text": "کشنده پدر چون بود دوستدار"
  },
  {
    "poem_id": 1500,
    "vorder": 103,
    "position": 0,
    "text": "نخواند مرا موبد از آب پاک"
  },
  {
    "poem_id": 1500,
    "vorder": 104,
    "position": 1,
    "text": "که بپرستم او را پدر زیر خاک"
  },
  {
    "poem_id": 1500,
    "vorder": 105,
    "position": 0,
    "text": "کنون گیو چندی به سختی ببود"
  },
  {
    "poem_id": 1500,
    "vorder": 106,
    "position": 1,
    "text": "به توران مرا جست و رنج آزمود"
  },
  {
    "poem_id": 1500,
    "vorder": 107,
    "position": 0,
    "text": "اگر نیز رنجی نبودی جزین"
  },
  {
    "poem_id": 1500,
    "vorder": 108,
    "position": 1,
    "text": "که با من بیامد ز توران زمین"
  },
  {
    "poem_id": 1500,
    "vorder": 109,
    "position": 0,
    "text": "سرافراز دو پهلوان با سپاه"
  },
  {
    "poem_id": 1500,
    "vorder": 110,
    "position": 1,
    "text": "پس ما بیامد چو آتش به راه"
  },
  {
    "poem_id": 1500,
    "vorder": 111,
    "position": 0,
    "text": "من آن دیدم از گیو کز پیل مست"
  },
  {
    "poem_id": 1500,
    "vorder": 112,
    "position": 1,
    "text": "نبیند به هندوستان بت پرست"
  },
  {
    "poem_id": 1500,
    "vorder": 113,
    "position": 0,
    "text": "گمانی نبردم که هرگز نهنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 114,
    "position": 1,
    "text": "ز دریا بران سان برآید به جنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 115,
    "position": 0,
    "text": "ازان پس که پیران بیامد چو شیر"
  },
  {
    "poem_id": 1500,
    "vorder": 116,
    "position": 1,
    "text": "میان بسته و بادپایی به زیر"
  },
  {
    "poem_id": 1500,
    "vorder": 117,
    "position": 0,
    "text": "به آب اندر آمد بسان نهنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 118,
    "position": 1,
    "text": "که گفتی زمین را بسوزد به جنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 119,
    "position": 0,
    "text": "بینداخت بر یال او بر کمند"
  },
  {
    "poem_id": 1500,
    "vorder": 120,
    "position": 1,
    "text": "سر پهلوان اندر آمد به بند"
  },
  {
    "poem_id": 1500,
    "vorder": 121,
    "position": 0,
    "text": "بخواهش‌گری رفتم ای شهریار"
  },
  {
    "poem_id": 1500,
    "vorder": 122,
    "position": 1,
    "text": "وگرنه بکندی سرش را ز بار"
  },
  {
    "poem_id": 1500,
    "vorder": 123,
    "position": 0,
    "text": "بدان کاو ز درد پدر خسته بود"
  },
  {
    "poem_id": 1500,
    "vorder": 124,
    "position": 1,
    "text": "ز بد گفتن ما زبان بسته بود"
  },
  {
    "poem_id": 1500,
    "vorder": 125,
    "position": 0,
    "text": "چنین تا لب رود جیحون به جنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 126,
    "position": 1,
    "text": "نیاسود با گُرزهٔ گاورنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 127,
    "position": 0,
    "text": "سرانجام بگذاشت جیحون به خشم"
  },
  {
    "poem_id": 1500,
    "vorder": 128,
    "position": 1,
    "text": "بآب و بکشتی نیفگند چشم"
  },
  {
    "poem_id": 1500,
    "vorder": 129,
    "position": 0,
    "text": "کسی را که چون او بود پهلوان"
  },
  {
    "poem_id": 1500,
    "vorder": 130,
    "position": 1,
    "text": "بود جاودان شاد و روشن روان"
  },
  {
    "poem_id": 1500,
    "vorder": 131,
    "position": 0,
    "text": "یکی کاخ کشواد بد در صطخر"
  },
  {
    "poem_id": 1500,
    "vorder": 132,
    "position": 1,
    "text": "که آزادگان را بدو بود فخر"
  },
  {
    "poem_id": 1500,
    "vorder": 133,
    "position": 0,
    "text": "چو از تخت کاووس برخاستند"
  },
  {
    "poem_id": 1500,
    "vorder": 134,
    "position": 1,
    "text": "به ایوان نو رفتن آراستند"
  },
  {
    "poem_id": 1500,
    "vorder": 135,
    "position": 0,
    "text": "همی رفت گودرز با شهریار"
  },
  {
    "poem_id": 1500,
    "vorder": 136,
    "position": 1,
    "text": "چو آمد بدان گلشن زرنگار"
  },
  {
    "poem_id": 1500,
    "vorder": 137,
    "position": 0,
    "text": "بر اورنگ زرینش بنشاندند"
  },
  {
    "poem_id": 1500,
    "vorder": 138,
    "position": 1,
    "text": "برو بر بسی آفرین خواندند"
  },
  {
    "poem_id": 1500,
    "vorder": 139,
    "position": 0,
    "text": "ببستند گردان ایران کمر"
  },
  {
    "poem_id": 1500,
    "vorder": 140,
    "position": 1,
    "text": "بجز طوس نوذر که پیچید سر"
  },
  {
    "poem_id": 1500,
    "vorder": 141,
    "position": 0,
    "text": "که او بود با کوس و زرینه کفش"
  },
  {
    "poem_id": 1500,
    "vorder": 142,
    "position": 1,
    "text": "هم او داشتی کاویانی درفش"
  },
  {
    "poem_id": 1500,
    "vorder": 143,
    "position": 0,
    "text": "ازان کار گودرز شد تیز مغز"
  },
  {
    "poem_id": 1500,
    "vorder": 144,
    "position": 1,
    "text": "برِ او پیامی فرستاد نغز"
  },
  {
    "poem_id": 1500,
    "vorder": 145,
    "position": 0,
    "text": "پیمبر سرافراز گیو دلیر"
  },
  {
    "poem_id": 1500,
    "vorder": 146,
    "position": 1,
    "text": "که چنگ یلان داشت و بازوی شیر"
  },
  {
    "poem_id": 1500,
    "vorder": 147,
    "position": 0,
    "text": "بدو گفت با طوس نوذر بگوی"
  },
  {
    "poem_id": 1500,
    "vorder": 148,
    "position": 1,
    "text": "که هنگام شادی بهانه مجوی"
  },
  {
    "poem_id": 1500,
    "vorder": 149,
    "position": 0,
    "text": "بزرگان و گردان ایران زمین"
  },
  {
    "poem_id": 1500,
    "vorder": 150,
    "position": 1,
    "text": "همه شاه را خواندند آفرین"
  },
  {
    "poem_id": 1500,
    "vorder": 151,
    "position": 0,
    "text": "چرا سر کشی تو به فرمان دیو"
  },
  {
    "poem_id": 1500,
    "vorder": 152,
    "position": 1,
    "text": "نبینی همی فر گیهان خدیو"
  },
  {
    "poem_id": 1500,
    "vorder": 153,
    "position": 0,
    "text": "اگر تو بپیچی ز فرمان شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 154,
    "position": 1,
    "text": "مرا با تو کین خیزد و رزمگاه"
  },
  {
    "poem_id": 1500,
    "vorder": 155,
    "position": 0,
    "text": "فرستاده گیوست پیغام من"
  },
  {
    "poem_id": 1500,
    "vorder": 156,
    "position": 1,
    "text": "به دستوری نامدار انجمن"
  },
  {
    "poem_id": 1500,
    "vorder": 157,
    "position": 0,
    "text": "ز پیش پدر گیو بنمود پشت"
  },
  {
    "poem_id": 1500,
    "vorder": 158,
    "position": 1,
    "text": "دلش پر ز گفتارهای درشت"
  },
  {
    "poem_id": 1500,
    "vorder": 159,
    "position": 0,
    "text": "بیامد به طوس سپهبد بگفت"
  },
  {
    "poem_id": 1500,
    "vorder": 160,
    "position": 1,
    "text": "که این رای را با تو دیوست جفت"
  },
  {
    "poem_id": 1500,
    "vorder": 161,
    "position": 0,
    "text": "چو بشنید پاسخ چنین داد طوس"
  },
  {
    "poem_id": 1500,
    "vorder": 162,
    "position": 1,
    "text": "که بر ما نه خوبست کردن فسوس"
  },
  {
    "poem_id": 1500,
    "vorder": 163,
    "position": 0,
    "text": "به ایران پس از رستم پیلتن"
  },
  {
    "poem_id": 1500,
    "vorder": 164,
    "position": 1,
    "text": "سرافرازتر کس منم ز انجمن"
  },
  {
    "poem_id": 1500,
    "vorder": 165,
    "position": 0,
    "text": "نبیره منوچهر شاه دلیر"
  },
  {
    "poem_id": 1500,
    "vorder": 166,
    "position": 1,
    "text": "که گیتی به تیغ اندر آورد زیر"
  },
  {
    "poem_id": 1500,
    "vorder": 167,
    "position": 0,
    "text": "همان شیر پرخاشجویم به جنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 168,
    "position": 1,
    "text": "بدرم دل پیل و چنگ پلنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 169,
    "position": 0,
    "text": "همی بی من آیین و رای آورید"
  },
  {
    "poem_id": 1500,
    "vorder": 170,
    "position": 1,
    "text": "جهان را به نو کدخدای آورید"
  },
  {
    "poem_id": 1500,
    "vorder": 171,
    "position": 0,
    "text": "نباشم بدین کار همداستان"
  },
  {
    "poem_id": 1500,
    "vorder": 172,
    "position": 1,
    "text": "ز خسرو مزن پیش من داستان"
  },
  {
    "poem_id": 1500,
    "vorder": 173,
    "position": 0,
    "text": "جهاندار کز تخم افراسیاب"
  },
  {
    "poem_id": 1500,
    "vorder": 174,
    "position": 1,
    "text": "نشانیم بخت اندر آید به خواب"
  },
  {
    "poem_id": 1500,
    "vorder": 175,
    "position": 0,
    "text": "نخواهیم شاه از نژاد پشنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 176,
    "position": 1,
    "text": "فسیله نه نیکو بود با پلنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 177,
    "position": 0,
    "text": "تو این رنجها را که بردی برست"
  },
  {
    "poem_id": 1500,
    "vorder": 178,
    "position": 1,
    "text": "که خسرو جوانست و کندآورست"
  },
  {
    "poem_id": 1500,
    "vorder": 179,
    "position": 0,
    "text": "کسی کاو بود شهریار زمین"
  },
  {
    "poem_id": 1500,
    "vorder": 180,
    "position": 1,
    "text": "هنر باید و گوهر و فر و دین"
  },
  {
    "poem_id": 1500,
    "vorder": 181,
    "position": 0,
    "text": "فریبرز کاووس فرزند شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 182,
    "position": 1,
    "text": "سزاوارتر کس به تخت و کلاه"
  },
  {
    "poem_id": 1500,
    "vorder": 183,
    "position": 0,
    "text": "بهرسو ز دشمن ندارد نژاد"
  },
  {
    "poem_id": 1500,
    "vorder": 184,
    "position": 1,
    "text": "همش فر و برزست و هم نام و داد"
  },
  {
    "poem_id": 1500,
    "vorder": 185,
    "position": 0,
    "text": "دژم گیو برخاست از پیش او"
  },
  {
    "poem_id": 1500,
    "vorder": 186,
    "position": 1,
    "text": "که خام آمدش دانش و کیش او"
  },
  {
    "poem_id": 1500,
    "vorder": 187,
    "position": 0,
    "text": "بیامد به گودرز کشواد گفت"
  },
  {
    "poem_id": 1500,
    "vorder": 188,
    "position": 1,
    "text": "که فر و خرد نیست با طوس جفت"
  },
  {
    "poem_id": 1500,
    "vorder": 189,
    "position": 0,
    "text": "دو چشمش تو گویی نبیند همی"
  },
  {
    "poem_id": 1500,
    "vorder": 190,
    "position": 1,
    "text": "فریبرز را برگزیند همی"
  },
  {
    "poem_id": 1500,
    "vorder": 191,
    "position": 0,
    "text": "برآشفت گودرز و گفت از مهان"
  },
  {
    "poem_id": 1500,
    "vorder": 192,
    "position": 1,
    "text": "همی طوس کم باید اندر جهان"
  },
  {
    "poem_id": 1500,
    "vorder": 193,
    "position": 0,
    "text": "نبیره پسر داشت هفتاد و هشت"
  },
  {
    "poem_id": 1500,
    "vorder": 194,
    "position": 1,
    "text": "بزد کوس ز ایوان به میدان گذشت"
  },
  {
    "poem_id": 1500,
    "vorder": 195,
    "position": 0,
    "text": "سواران جنگی ده و دو هزار"
  },
  {
    "poem_id": 1500,
    "vorder": 196,
    "position": 1,
    "text": "برون رفت برگستوان‌ور سوار"
  },
  {
    "poem_id": 1500,
    "vorder": 197,
    "position": 0,
    "text": "وزان رو بیامد سپهدار طوس"
  },
  {
    "poem_id": 1500,
    "vorder": 198,
    "position": 1,
    "text": "ببستند بر کوههٔ پیل کوس"
  },
  {
    "poem_id": 1500,
    "vorder": 199,
    "position": 0,
    "text": "ببستند گردان ایران میان"
  },
  {
    "poem_id": 1500,
    "vorder": 200,
    "position": 1,
    "text": "به پیش سپاه اختر کاویان"
  },
  {
    "poem_id": 1500,
    "vorder": 201,
    "position": 0,
    "text": "چو گودرز را دید و چندان سپاه"
  },
  {
    "poem_id": 1500,
    "vorder": 202,
    "position": 1,
    "text": "کزو تیره شد روی خورشید و ماه"
  },
  {
    "poem_id": 1500,
    "vorder": 203,
    "position": 0,
    "text": "یکی تخت بر کوههٔ ژنده پیل"
  },
  {
    "poem_id": 1500,
    "vorder": 204,
    "position": 1,
    "text": "ز پیروزه تابان به کردار نیل"
  },
  {
    "poem_id": 1500,
    "vorder": 205,
    "position": 0,
    "text": "جهانجوی کیخسرو تاج‌ور"
  },
  {
    "poem_id": 1500,
    "vorder": 206,
    "position": 1,
    "text": "نشسته بران تخت و بسته کمر"
  },
  {
    "poem_id": 1500,
    "vorder": 207,
    "position": 0,
    "text": "به گرد اندرش ژنده‌پیلان دویست"
  },
  {
    "poem_id": 1500,
    "vorder": 208,
    "position": 1,
    "text": "تو گفتی به گیتی جز آن جای نیست"
  },
  {
    "poem_id": 1500,
    "vorder": 209,
    "position": 0,
    "text": "همی تافت زان تخت خسرو چو ماه"
  },
  {
    "poem_id": 1500,
    "vorder": 210,
    "position": 1,
    "text": "ز یاقوت رخشنده بر سر کلاه"
  },
  {
    "poem_id": 1500,
    "vorder": 211,
    "position": 0,
    "text": "غمی شد دل طوس و اندیشه کرد"
  },
  {
    "poem_id": 1500,
    "vorder": 212,
    "position": 1,
    "text": "که امروز اگر من بسازم نبرد"
  },
  {
    "poem_id": 1500,
    "vorder": 213,
    "position": 0,
    "text": "بسی کشته آید ز هر دو سپاه"
  },
  {
    "poem_id": 1500,
    "vorder": 214,
    "position": 1,
    "text": "ز ایران نه برخیزد این کینه‌گاه"
  },
  {
    "poem_id": 1500,
    "vorder": 215,
    "position": 0,
    "text": "نباشد جز از کام افراسیاب"
  },
  {
    "poem_id": 1500,
    "vorder": 216,
    "position": 1,
    "text": "سر بخت ترکان برآید ز خواب"
  },
  {
    "poem_id": 1500,
    "vorder": 217,
    "position": 0,
    "text": "بدیشان رسد تخت شاهنشهی"
  },
  {
    "poem_id": 1500,
    "vorder": 218,
    "position": 1,
    "text": "سرآید به ما روزگار مهی"
  },
  {
    "poem_id": 1500,
    "vorder": 219,
    "position": 0,
    "text": "خردمند مردی و جوینده راه"
  },
  {
    "poem_id": 1500,
    "vorder": 220,
    "position": 1,
    "text": "فرستاد نزدیک کاووس شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 221,
    "position": 0,
    "text": "که از ما یکی گر برین دشت جنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 222,
    "position": 1,
    "text": "نهد بر کمان پر تیر خدنگ"
  },
  {
    "poem_id": 1500,
    "vorder": 223,
    "position": 0,
    "text": "یکی کینه خیزد که افراسیاب"
  },
  {
    "poem_id": 1500,
    "vorder": 224,
    "position": 1,
    "text": "هم امشب همی آن ببیند به خواب"
  },
  {
    "poem_id": 1500,
    "vorder": 225,
    "position": 0,
    "text": "چو بشنید زین‌گونه گفتار شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 226,
    "position": 1,
    "text": "بفرمود تا بازگردد به راه"
  },
  {
    "poem_id": 1500,
    "vorder": 227,
    "position": 0,
    "text": "بر طوس و گودرز کشوادگان"
  },
  {
    "poem_id": 1500,
    "vorder": 228,
    "position": 1,
    "text": "گزیده سرافراز آزادگان"
  },
  {
    "poem_id": 1500,
    "vorder": 229,
    "position": 0,
    "text": "که بر درگه آیند بی‌انجمن"
  },
  {
    "poem_id": 1500,
    "vorder": 230,
    "position": 1,
    "text": "چنان چون بباید به نزدیک من"
  },
  {
    "poem_id": 1500,
    "vorder": 231,
    "position": 0,
    "text": "بشد طوس و گودرز نزدیک شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 232,
    "position": 1,
    "text": "زبان برگشادند بر پیش گاه"
  },
  {
    "poem_id": 1500,
    "vorder": 233,
    "position": 0,
    "text": "بدو گفت شاه ای خردمند پیر"
  },
  {
    "poem_id": 1500,
    "vorder": 234,
    "position": 1,
    "text": "منه زهر برنده بر جام شیر"
  },
  {
    "poem_id": 1500,
    "vorder": 235,
    "position": 0,
    "text": "بنه تیغ و بگشای ز آهن میان"
  },
  {
    "poem_id": 1500,
    "vorder": 236,
    "position": 1,
    "text": "نباید کزین سود دارد زیان"
  },
  {
    "poem_id": 1500,
    "vorder": 237,
    "position": 0,
    "text": "چنین گفت طوس سپهبد به شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 238,
    "position": 1,
    "text": "که گر شاه سیر آید از تخت و گاه"
  },
  {
    "poem_id": 1500,
    "vorder": 239,
    "position": 0,
    "text": "به فرزند باید که ماند جهان"
  },
  {
    "poem_id": 1500,
    "vorder": 240,
    "position": 1,
    "text": "بزرگی و دیهیم و تخت مهان"
  },
  {
    "poem_id": 1500,
    "vorder": 241,
    "position": 0,
    "text": "چو فرزند باشد نبیره کلاه"
  },
  {
    "poem_id": 1500,
    "vorder": 242,
    "position": 1,
    "text": "چرا برنهد برنشیند به گاه"
  },
  {
    "poem_id": 1500,
    "vorder": 243,
    "position": 0,
    "text": "بدو گفت گودرز کای کم خرد"
  },
  {
    "poem_id": 1500,
    "vorder": 244,
    "position": 1,
    "text": "ترا بخرد از مردمان نشمرد"
  },
  {
    "poem_id": 1500,
    "vorder": 245,
    "position": 0,
    "text": "به گیتی کسی چون سیاوش نبود"
  },
  {
    "poem_id": 1500,
    "vorder": 246,
    "position": 1,
    "text": "چنو راد و آزاد و خامش نبود"
  },
  {
    "poem_id": 1500,
    "vorder": 247,
    "position": 0,
    "text": "کنون این جهانجوی فرزند اوست"
  },
  {
    "poem_id": 1500,
    "vorder": 248,
    "position": 1,
    "text": "همویست گویی به چهر و به پوست"
  },
  {
    "poem_id": 1500,
    "vorder": 249,
    "position": 0,
    "text": "گر از تور دارد ز مادر نژاد"
  },
  {
    "poem_id": 1500,
    "vorder": 250,
    "position": 1,
    "text": "هم از تخم شاهی نپیچد ز داد"
  },
  {
    "poem_id": 1500,
    "vorder": 251,
    "position": 0,
    "text": "به توران و ایران چنو نیو کیست"
  },
  {
    "poem_id": 1500,
    "vorder": 252,
    "position": 1,
    "text": "چنین خام گفتارت از بهر چیست"
  },
  {
    "poem_id": 1500,
    "vorder": 253,
    "position": 0,
    "text": "دو چشمت نبیند همی چهر او"
  },
  {
    "poem_id": 1500,
    "vorder": 254,
    "position": 1,
    "text": "چنان برز و بالا و آن مهر او"
  },
  {
    "poem_id": 1500,
    "vorder": 255,
    "position": 0,
    "text": "به جیحون گذر کرد و کشتی نجست"
  },
  {
    "poem_id": 1500,
    "vorder": 256,
    "position": 1,
    "text": "به فر کیانی و رای درست"
  },
  {
    "poem_id": 1500,
    "vorder": 257,
    "position": 0,
    "text": "بسان فریدون کز اروند رود"
  },
  {
    "poem_id": 1500,
    "vorder": 258,
    "position": 1,
    "text": "گذشت و به کشتی نیامد فرود"
  },
  {
    "poem_id": 1500,
    "vorder": 259,
    "position": 0,
    "text": "ز مردی و از فرهٔ ایزدی"
  },
  {
    "poem_id": 1500,
    "vorder": 260,
    "position": 1,
    "text": "ازو دور شد چشم و دست بدی"
  },
  {
    "poem_id": 1500,
    "vorder": 261,
    "position": 0,
    "text": "تو نوذر نژادی نه بیگانه‌ای"
  },
  {
    "poem_id": 1500,
    "vorder": 262,
    "position": 1,
    "text": "پدر تیز بود و تو دیوانه‌ای"
  },
  {
    "poem_id": 1500,
    "vorder": 263,
    "position": 0,
    "text": "سلیح من ار با منستی کنون"
  },
  {
    "poem_id": 1500,
    "vorder": 264,
    "position": 1,
    "text": "بر و یالت آغشته گشتی به خون"
  },
  {
    "poem_id": 1500,
    "vorder": 265,
    "position": 0,
    "text": "بدو گفت طوس ای جهاندیده پیر"
  },
  {
    "poem_id": 1500,
    "vorder": 266,
    "position": 1,
    "text": "سخن گوی لیکن همه دلپذیر"
  },
  {
    "poem_id": 1500,
    "vorder": 267,
    "position": 0,
    "text": "اگر تیغ تو هست سندان شکاف"
  },
  {
    "poem_id": 1500,
    "vorder": 268,
    "position": 1,
    "text": "سنانم بدرّد دل کوه قاف"
  },
  {
    "poem_id": 1500,
    "vorder": 269,
    "position": 0,
    "text": "وگر گُرز تو هست با سنگ و تاب"
  },
  {
    "poem_id": 1500,
    "vorder": 270,
    "position": 1,
    "text": "خدنگم بدوزد دل آفتاب"
  },
  {
    "poem_id": 1500,
    "vorder": 271,
    "position": 0,
    "text": "و گر تو ز کشواد داری نژاد"
  },
  {
    "poem_id": 1500,
    "vorder": 272,
    "position": 1,
    "text": "منم طوس نوذر مه و شاهزاد"
  },
  {
    "poem_id": 1500,
    "vorder": 273,
    "position": 0,
    "text": "بدو گفت گودرز چندین مگوی"
  },
  {
    "poem_id": 1500,
    "vorder": 274,
    "position": 1,
    "text": "که چندین نبینم ترا آب روی"
  },
  {
    "poem_id": 1500,
    "vorder": 275,
    "position": 0,
    "text": "به کاووس گفت ای جهاندار شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 276,
    "position": 1,
    "text": "تو دل را مگردان ز آیین و راه"
  },
  {
    "poem_id": 1500,
    "vorder": 277,
    "position": 0,
    "text": "دو فرزند پرمایه را پیش خوان"
  },
  {
    "poem_id": 1500,
    "vorder": 278,
    "position": 1,
    "text": "سزاوار گاهند و هر دو جوان"
  },
  {
    "poem_id": 1500,
    "vorder": 279,
    "position": 0,
    "text": "ببین تا ز هر دو سزاوار کیست"
  },
  {
    "poem_id": 1500,
    "vorder": 280,
    "position": 1,
    "text": "که با برز و با فرهٔ ایزدیست"
  },
  {
    "poem_id": 1500,
    "vorder": 281,
    "position": 0,
    "text": "بدو تاج بسپار و دل شاد دار"
  },
  {
    "poem_id": 1500,
    "vorder": 282,
    "position": 1,
    "text": "چو فرزند بینی همی شهریار"
  },
  {
    "poem_id": 1500,
    "vorder": 283,
    "position": 0,
    "text": "بدو گفت کاووس کاین رای نیست"
  },
  {
    "poem_id": 1500,
    "vorder": 284,
    "position": 1,
    "text": "که فرزند هر دو به دل بر یکیست"
  },
  {
    "poem_id": 1500,
    "vorder": 285,
    "position": 0,
    "text": "یکی را چو من کرده باشم گزین"
  },
  {
    "poem_id": 1500,
    "vorder": 286,
    "position": 1,
    "text": "دل دیگر از من شود پر ز کین"
  },
  {
    "poem_id": 1500,
    "vorder": 287,
    "position": 0,
    "text": "یکی کار سازم که هر دو ز من"
  },
  {
    "poem_id": 1500,
    "vorder": 288,
    "position": 1,
    "text": "نگیرند کین اندرین انجمن"
  },
  {
    "poem_id": 1500,
    "vorder": 289,
    "position": 0,
    "text": "دو فرزند ما را کنون بر دو خیل"
  },
  {
    "poem_id": 1500,
    "vorder": 290,
    "position": 1,
    "text": "بباید شدن تا در اردبیل"
  },
  {
    "poem_id": 1500,
    "vorder": 291,
    "position": 0,
    "text": "به مرزی که آنجا دژ بهمنست"
  },
  {
    "poem_id": 1500,
    "vorder": 292,
    "position": 1,
    "text": "همه ساله پرخاش آهرمنست"
  },
  {
    "poem_id": 1500,
    "vorder": 293,
    "position": 0,
    "text": "برنجست ز آهرمن آتش پرست"
  },
  {
    "poem_id": 1500,
    "vorder": 294,
    "position": 1,
    "text": "نباشد بران مرز کس را نشست"
  },
  {
    "poem_id": 1500,
    "vorder": 295,
    "position": 0,
    "text": "ازیشان یکی کان بگیرد به تیغ"
  },
  {
    "poem_id": 1500,
    "vorder": 296,
    "position": 1,
    "text": "ندارم ازو تخت شاهی دریغ"
  },
  {
    "poem_id": 1500,
    "vorder": 297,
    "position": 0,
    "text": "چو بشنید گودرز و طوس این سخن"
  },
  {
    "poem_id": 1500,
    "vorder": 298,
    "position": 1,
    "text": "که افگند سالار هشیار بن"
  },
  {
    "poem_id": 1500,
    "vorder": 299,
    "position": 0,
    "text": "برین هر دو گشتند همداستان"
  },
  {
    "poem_id": 1500,
    "vorder": 300,
    "position": 1,
    "text": "ندانست ازین به کسی داستان"
  },
  {
    "poem_id": 1500,
    "vorder": 301,
    "position": 0,
    "text": "برین یک سخن دل بیاراستند"
  },
  {
    "poem_id": 1500,
    "vorder": 302,
    "position": 1,
    "text": "ز پیش جهاندار برخاستند"
  },
  {
    "poem_id": 1500,
    "vorder": 303,
    "position": 0,
    "text": "چو خورشید برزد سر از برج شیر"
  },
  {
    "poem_id": 1500,
    "vorder": 304,
    "position": 1,
    "text": "سپهر اندر آورد شب را به زیر"
  },
  {
    "poem_id": 1500,
    "vorder": 305,
    "position": 0,
    "text": "فریبرز با طوس نوذر دمان"
  },
  {
    "poem_id": 1500,
    "vorder": 306,
    "position": 1,
    "text": "به نزدیک شاه آمدند آن زمان"
  },
  {
    "poem_id": 1500,
    "vorder": 307,
    "position": 0,
    "text": "چنین گفت با شاه هشیار طوس"
  },
  {
    "poem_id": 1500,
    "vorder": 308,
    "position": 1,
    "text": "که من با سپهبد برم پیل و کوس"
  },
  {
    "poem_id": 1500,
    "vorder": 309,
    "position": 0,
    "text": "همان من کشم کاویانی درفش"
  },
  {
    "poem_id": 1500,
    "vorder": 310,
    "position": 1,
    "text": "رخ لعل دشمن کنم چون بنفش"
  },
  {
    "poem_id": 1500,
    "vorder": 311,
    "position": 0,
    "text": "کنون همچنین من ز درگاه شاه"
  },
  {
    "poem_id": 1500,
    "vorder": 312,
    "position": 1,
    "text": "بنه برنهم برنشانم سپاه"
  },
  {
    "poem_id": 1500,
    "vorder": 313,
    "position": 0,
    "text": "پس اندر فریبرز و کوس و درفش"
  },
  {
    "poem_id": 1500,
    "vorder": 314,
    "position": 1,
    "text": "هوا کرده از سم اسپان بنفش"
  },
  {
    "poem_id": 1500,
    "vorder": 315,
    "position": 0,
    "text": "چو فرزند را فر و برز کیان"
  },
  {
    "poem_id": 1500,
    "vorder": 316,
    "position": 1,
    "text": "بباشد نبیره نبندد میان"
  },
  {
    "poem_id": 1500,
    "vorder": 317,
    "position": 0,
    "text": "بدو گفت شاه ار تو رانی ز پیش"
  },
  {
    "poem_id": 1500,
    "vorder": 318,
    "position": 1,
    "text": "زمانه نگردد ز آیین خویش"
  },
  {
    "poem_id": 1500,
    "vorder": 319,
    "position": 0,
    "text": "بِرای خداوند خورشید و ماه"
  },
  {
    "poem_id": 1500,
    "vorder": 320,
    "position": 1,
    "text": "توان ساخت پیروزی و دستگاه"
  },
  {
    "poem_id": 1500,
    "vorder": 321,
    "position": 0,
    "text": "فریبرز را گر چنین است رای"
  },
  {
    "poem_id": 1500,
    "vorder": 322,
    "position": 1,
    "text": "تو لشکر بیارای و منشین ز پای"
  },
  {
    "poem_id": 1500,
    "vorder": 323,
    "position": 0,
    "text": "بشد طوس با کاویانی درفش"
  },
  {
    "poem_id": 1500,
    "vorder": 324,
    "position": 1,
    "text": "به پا اندرون کرده زرینه کفش"
  },
  {
    "poem_id": 1500,
    "vorder": 325,
    "position": 0,
    "text": "فریبرز کاووس در قلبگاه"
  },
  {
    "poem_id": 1500,
    "vorder": 326,
    "position": 1,
    "text": "به پیش اندرون طوس و پیل و سپاه"
  },
  {
    "poem_id": 1500,
    "vorder": 327,
    "position": 0,
    "text": "چو نزدیک بهمن دژ اندر رسید"
  },
  {
    "poem_id": 1500,
    "vorder": 328,
    "position": 1,
    "text": "زمین همچو آتش همی بردمید"
  },
  {
    "poem_id": 1500,
    "vorder": 329,
    "position": 0,
    "text": "بشد طوس با لشکری جنگجوی"
  },
  {
    "poem_id": 1500,
    "vorder": 330,
    "position": 1,
    "text": "به تندی سوی دژ نهادند روی"
  },
  {
    "poem_id": 1500,
    "vorder": 331,
    "position": 0,
    "text": "سر بارهٔ دژ بد اندر هوا"
  },
  {
    "poem_id": 1500,
    "vorder": 332,
    "position": 1,
    "text": "ندیدند جنگ هوا کس روا"
  },
  {
    "poem_id": 1500,
    "vorder": 333,
    "position": 0,
    "text": "سنانها ز گرمی همی برفروخت"
  },
  {
    "poem_id": 1500,
    "vorder": 334,
    "position": 1,
    "text": "میان زره مرد جنگی بسوخت"
  },
  {
    "poem_id": 1500,
    "vorder": 335,
    "position": 0,
    "text": "جهان سر به سر گفتی از آتش است"
  },
  {
    "poem_id": 1500,
    "vorder": 336,
    "position": 1,
    "text": "هوا دام آهرمن سرکش است"
  },
  {
    "poem_id": 1500,
    "vorder": 337,
    "position": 0,
    "text": "سپهبد فریبرز را گفت مرد"
  },
  {
    "poem_id": 1500,
    "vorder": 338,
    "position": 1,
    "text": "به چیزی چو آید به دشت نبرد"
  },
  {
    "poem_id": 1500,
    "vorder": 339,
    "position": 0,
    "text": "به گُرز گران و به تیغ و کمند"
  },
  {
    "poem_id": 1500,
    "vorder": 340,
    "position": 1,
    "text": "بکوشد که آرد به چیزی گزند"
  },
  {
    "poem_id": 1500,
    "vorder": 341,
    "position": 0,
    "text": "به پیرامن دژ یکی راه نیست"
  },
  {
    "poem_id": 1500,
    "vorder": 342,
    "position": 1,
    "text": "ز آتش کسی را دل ای شاه نیست"
  },
  {
    "poem_id": 1500,
    "vorder": 343,
    "position": 0,
    "text": "میان زیر جوشن بسوزد همی"
  },
  {
    "poem_id": 1500,
    "vorder": 344,
    "position": 1,
    "text": "تن بارکش برفروزد همی"
  },
  {
    "poem_id": 1500,
    "vorder": 345,
    "position": 0,
    "text": "بگشتند یک هفته گرد اندرش"
  },
  {
    "poem_id": 1500,
    "vorder": 346,
    "position": 1,
    "text": "بدیده ندیدند جای درش"
  },
  {
    "poem_id": 1500,
    "vorder": 347,
    "position": 0,
    "text": "به نومیدی از جنگ گشتند باز"
  },
  {
    "poem_id": 1500,
    "vorder": 348,
    "position": 1,
    "text": "نیامد بر از رنج راه دراز"
  }
]