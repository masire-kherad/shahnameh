[
  {
    "poem_id": 1623,
    "vorder": 1,
    "position": 0,
    "text": "بگفت این و زان جایگه برگرفت"
  },
  {
    "poem_id": 1623,
    "vorder": 2,
    "position": 1,
    "text": "ازان مرز تا روم لشکر گرفت"
  },
  {
    "poem_id": 1623,
    "vorder": 3,
    "position": 0,
    "text": "سپهبد طلایه به داراب داد"
  },
  {
    "poem_id": 1623,
    "vorder": 4,
    "position": 1,
    "text": "طلایه سنان را به زهر آب داد"
  },
  {
    "poem_id": 1623,
    "vorder": 5,
    "position": 0,
    "text": "هم‌انگه طلایه بیامد ز روم"
  },
  {
    "poem_id": 1623,
    "vorder": 6,
    "position": 1,
    "text": "وزین سو نگهدار این مرز و بوم"
  },
  {
    "poem_id": 1623,
    "vorder": 7,
    "position": 0,
    "text": "زناگه دو لشکر بهم بازخورد"
  },
  {
    "poem_id": 1623,
    "vorder": 8,
    "position": 1,
    "text": "برآمد هم‌آنگاه گرد نبرد"
  },
  {
    "poem_id": 1623,
    "vorder": 9,
    "position": 0,
    "text": "همه یک به دیگر برآمیختند"
  },
  {
    "poem_id": 1623,
    "vorder": 10,
    "position": 1,
    "text": "چو رود روان خون همی ریختند"
  },
  {
    "poem_id": 1623,
    "vorder": 11,
    "position": 0,
    "text": "چو داراب دید آن سپاه نبرد"
  },
  {
    "poem_id": 1623,
    "vorder": 12,
    "position": 1,
    "text": "به پیش اندر آمد به کردار گرد"
  },
  {
    "poem_id": 1623,
    "vorder": 13,
    "position": 0,
    "text": "ازان لشکر روم چندان بکشت"
  },
  {
    "poem_id": 1623,
    "vorder": 14,
    "position": 1,
    "text": "که گفتی فلک تیغ دارد به مشت"
  },
  {
    "poem_id": 1623,
    "vorder": 15,
    "position": 0,
    "text": "همی رفت زان گونه بر سان شیر"
  },
  {
    "poem_id": 1623,
    "vorder": 16,
    "position": 1,
    "text": "نهنگی به چنگ اژدهایی به زیر"
  },
  {
    "poem_id": 1623,
    "vorder": 17,
    "position": 0,
    "text": "چنین تا به لشکرگه رومیان"
  },
  {
    "poem_id": 1623,
    "vorder": 18,
    "position": 1,
    "text": "همی تاخت بر سان شیر ژیان"
  },
  {
    "poem_id": 1623,
    "vorder": 19,
    "position": 0,
    "text": "زمین شد ز رومی چو دریای خون"
  },
  {
    "poem_id": 1623,
    "vorder": 20,
    "position": 1,
    "text": "جهانجوی را تیغ شد رهنمون"
  },
  {
    "poem_id": 1623,
    "vorder": 21,
    "position": 0,
    "text": "به پیروزی از رومیان گشت باز"
  },
  {
    "poem_id": 1623,
    "vorder": 22,
    "position": 1,
    "text": "به نزدیک سالار گردنفراز"
  },
  {
    "poem_id": 1623,
    "vorder": 23,
    "position": 0,
    "text": "بسی آفرین یافت از رشنواد"
  },
  {
    "poem_id": 1623,
    "vorder": 24,
    "position": 1,
    "text": "که این لشکر شاه بی‌تو مباد"
  },
  {
    "poem_id": 1623,
    "vorder": 25,
    "position": 0,
    "text": "چو ما بازگردیم زین رزم روم"
  },
  {
    "poem_id": 1623,
    "vorder": 26,
    "position": 1,
    "text": "سپاه اندر آید به آباد بوم"
  },
  {
    "poem_id": 1623,
    "vorder": 27,
    "position": 0,
    "text": "تو چندان نوازش بیابی ز شاه"
  },
  {
    "poem_id": 1623,
    "vorder": 28,
    "position": 1,
    "text": "ز اسپ و ز مهر و ز تیغ و کلاه"
  },
  {
    "poem_id": 1623,
    "vorder": 29,
    "position": 0,
    "text": "همه شب همی لشکر آراستند"
  },
  {
    "poem_id": 1623,
    "vorder": 30,
    "position": 1,
    "text": "سلیح سواران بپیراستند"
  },
  {
    "poem_id": 1623,
    "vorder": 31,
    "position": 0,
    "text": "چو خورشید برزد سر از تیره راغ"
  },
  {
    "poem_id": 1623,
    "vorder": 32,
    "position": 1,
    "text": "زمین شد به کردار روشن چراغ"
  },
  {
    "poem_id": 1623,
    "vorder": 33,
    "position": 0,
    "text": "بهم بازخوردند هر دو سپاه"
  },
  {
    "poem_id": 1623,
    "vorder": 34,
    "position": 1,
    "text": "شد از گرد خورشید تابان سیاه"
  },
  {
    "poem_id": 1623,
    "vorder": 35,
    "position": 0,
    "text": "چو داراب پیش آمد و حمله برد"
  },
  {
    "poem_id": 1623,
    "vorder": 36,
    "position": 1,
    "text": "عنان را به اسپ تگاور سپرد"
  },
  {
    "poem_id": 1623,
    "vorder": 37,
    "position": 0,
    "text": "به پیش صف رومیان کس نماند"
  },
  {
    "poem_id": 1623,
    "vorder": 38,
    "position": 1,
    "text": "ز گردان شمشیرزن بس نماند"
  },
  {
    "poem_id": 1623,
    "vorder": 39,
    "position": 0,
    "text": "به قلب سپاه اندر آمد چو گرگ"
  },
  {
    "poem_id": 1623,
    "vorder": 40,
    "position": 1,
    "text": "پراگنده کرد آن سپاه بزرگ"
  },
  {
    "poem_id": 1623,
    "vorder": 41,
    "position": 0,
    "text": "وزان جایگه شد سوی میمنه"
  },
  {
    "poem_id": 1623,
    "vorder": 42,
    "position": 1,
    "text": "بیاورد چندی سلیح و بنه"
  },
  {
    "poem_id": 1623,
    "vorder": 43,
    "position": 0,
    "text": "همه لشکر روم برهم درید"
  },
  {
    "poem_id": 1623,
    "vorder": 44,
    "position": 1,
    "text": "کسی از یلان خویشتن را ندید"
  },
  {
    "poem_id": 1623,
    "vorder": 45,
    "position": 0,
    "text": "دلیران ایران به کردار شیر"
  },
  {
    "poem_id": 1623,
    "vorder": 46,
    "position": 1,
    "text": "همی تاختند از پس اندر دلیر"
  },
  {
    "poem_id": 1623,
    "vorder": 47,
    "position": 0,
    "text": "بکشتند چندان ز رومی سپاه"
  },
  {
    "poem_id": 1623,
    "vorder": 48,
    "position": 1,
    "text": "که گل شد ز خون خاک آوردگاه"
  },
  {
    "poem_id": 1623,
    "vorder": 49,
    "position": 0,
    "text": "چهل جاثلیق از دلیران بکشت"
  },
  {
    "poem_id": 1623,
    "vorder": 50,
    "position": 1,
    "text": "بیامد صلیبی گرفته به مشت"
  },
  {
    "poem_id": 1623,
    "vorder": 51,
    "position": 0,
    "text": "چو زو رشنواد آن شگفتی بدید"
  },
  {
    "poem_id": 1623,
    "vorder": 52,
    "position": 1,
    "text": "ز شادی دل پهلوان بردمید"
  },
  {
    "poem_id": 1623,
    "vorder": 53,
    "position": 0,
    "text": "برو آفرین کرد و چندی ستود"
  },
  {
    "poem_id": 1623,
    "vorder": 54,
    "position": 1,
    "text": "بران آفرین مهربانی فزود"
  },
  {
    "poem_id": 1623,
    "vorder": 55,
    "position": 0,
    "text": "شب آمد جهان قیرگون شد به رنگ"
  },
  {
    "poem_id": 1623,
    "vorder": 56,
    "position": 1,
    "text": "همی بازگشتند یکسر ز جنگ"
  },
  {
    "poem_id": 1623,
    "vorder": 57,
    "position": 0,
    "text": "سپهبد به لشکرگه رومیان"
  },
  {
    "poem_id": 1623,
    "vorder": 58,
    "position": 1,
    "text": "برآسود و بگشاد بند میان"
  },
  {
    "poem_id": 1623,
    "vorder": 59,
    "position": 0,
    "text": "ببخشید در شب بسی خواسته"
  },
  {
    "poem_id": 1623,
    "vorder": 60,
    "position": 1,
    "text": "شد از خواسته لشکر آراسته"
  },
  {
    "poem_id": 1623,
    "vorder": 61,
    "position": 0,
    "text": "فرستاد نزدیک داراب کس"
  },
  {
    "poem_id": 1623,
    "vorder": 62,
    "position": 1,
    "text": "که ای شیردل مرد فریادرس"
  },
  {
    "poem_id": 1623,
    "vorder": 63,
    "position": 0,
    "text": "نگه کن کنون تا پسند تو چیست"
  },
  {
    "poem_id": 1623,
    "vorder": 64,
    "position": 1,
    "text": "وزی خواسته سودمند تو چیست"
  },
  {
    "poem_id": 1623,
    "vorder": 65,
    "position": 0,
    "text": "نگه دار چیزی که رای آیدت"
  },
  {
    "poem_id": 1623,
    "vorder": 66,
    "position": 1,
    "text": "ببخش آنچ دل رهنمای آیدت"
  },
  {
    "poem_id": 1623,
    "vorder": 67,
    "position": 0,
    "text": "هرآنچ آن پسندت نیاید ببخش"
  },
  {
    "poem_id": 1623,
    "vorder": 68,
    "position": 1,
    "text": "تو نامی‌تری از خداوند رخش"
  },
  {
    "poem_id": 1623,
    "vorder": 69,
    "position": 0,
    "text": "چو آن دید داراب شد شادکام"
  },
  {
    "poem_id": 1623,
    "vorder": 70,
    "position": 1,
    "text": "یکی نیزه برداشت از بهر نام"
  },
  {
    "poem_id": 1623,
    "vorder": 71,
    "position": 0,
    "text": "فرستاد دیگر سوی رشنواد"
  },
  {
    "poem_id": 1623,
    "vorder": 72,
    "position": 1,
    "text": "بدو گفت پیروز بادی و شاد"
  },
  {
    "poem_id": 1623,
    "vorder": 73,
    "position": 0,
    "text": "چو از باختر تیره شد روی مهر"
  },
  {
    "poem_id": 1623,
    "vorder": 74,
    "position": 1,
    "text": "بپوشید دیبای مشکین سپهر"
  },
  {
    "poem_id": 1623,
    "vorder": 75,
    "position": 0,
    "text": "همان پاس از تیره شب درگذشت"
  },
  {
    "poem_id": 1623,
    "vorder": 76,
    "position": 1,
    "text": "طلایه پراگنده بر گرد دشت"
  },
  {
    "poem_id": 1623,
    "vorder": 77,
    "position": 0,
    "text": "غو پاسبان خاست چون زلزله"
  },
  {
    "poem_id": 1623,
    "vorder": 78,
    "position": 1,
    "text": "همی شد چو اواز شیر یله"
  },
  {
    "poem_id": 1623,
    "vorder": 79,
    "position": 0,
    "text": "چو زرین سپر برگرفت آفتاب"
  },
  {
    "poem_id": 1623,
    "vorder": 80,
    "position": 1,
    "text": "سر جنگجویان برآمد ز خواب"
  },
  {
    "poem_id": 1623,
    "vorder": 81,
    "position": 0,
    "text": "ببستند گردان ایران میان"
  },
  {
    "poem_id": 1623,
    "vorder": 82,
    "position": 1,
    "text": "همی تاختند از پس رومیان"
  },
  {
    "poem_id": 1623,
    "vorder": 83,
    "position": 0,
    "text": "به شمشیر تیز آتش افروختند"
  },
  {
    "poem_id": 1623,
    "vorder": 84,
    "position": 1,
    "text": "همه شهرها را همی سوختند"
  },
  {
    "poem_id": 1623,
    "vorder": 85,
    "position": 0,
    "text": "ز روم و ز رومی برانگیخت گرد"
  },
  {
    "poem_id": 1623,
    "vorder": 86,
    "position": 1,
    "text": "کس از بوم و بر یاد دیگر نکرد"
  },
  {
    "poem_id": 1623,
    "vorder": 87,
    "position": 0,
    "text": "خروشی به زاری برآمد ز روم"
  },
  {
    "poem_id": 1623,
    "vorder": 88,
    "position": 1,
    "text": "که بگذاشتند آن دلارام بوم"
  },
  {
    "poem_id": 1623,
    "vorder": 89,
    "position": 0,
    "text": "به قیصر بر از کین جهان تنگ شد"
  },
  {
    "poem_id": 1623,
    "vorder": 90,
    "position": 1,
    "text": "رخ نامدارانش بی‌رنگ شد"
  },
  {
    "poem_id": 1623,
    "vorder": 91,
    "position": 0,
    "text": "فرستاده آمد بر رشنواد"
  },
  {
    "poem_id": 1623,
    "vorder": 92,
    "position": 1,
    "text": "که گر دادگر سر نپیچد ز داد"
  },
  {
    "poem_id": 1623,
    "vorder": 93,
    "position": 0,
    "text": "شدند آنک جنگی بد از جنگ سیر"
  },
  {
    "poem_id": 1623,
    "vorder": 94,
    "position": 1,
    "text": "سر بخت روم اندرآمد به زیر"
  },
  {
    "poem_id": 1623,
    "vorder": 95,
    "position": 0,
    "text": "که گر باژ خواهید فرمان کنیم"
  },
  {
    "poem_id": 1623,
    "vorder": 96,
    "position": 1,
    "text": "بنوی یکی باز پیمان کنیم"
  },
  {
    "poem_id": 1623,
    "vorder": 97,
    "position": 0,
    "text": "فرستاد قیصر ز هر گونه چیز"
  },
  {
    "poem_id": 1623,
    "vorder": 98,
    "position": 1,
    "text": "ابا برده‌ها بدره بسیار نیز"
  },
  {
    "poem_id": 1623,
    "vorder": 99,
    "position": 0,
    "text": "سپهبد پذیرفت زو آنچ بود"
  },
  {
    "poem_id": 1623,
    "vorder": 100,
    "position": 1,
    "text": "ز دینار وز گوهر نابسود"
  }
]