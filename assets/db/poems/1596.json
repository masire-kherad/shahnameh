[
  {
    "poem_id": 1596,
    "vorder": 1,
    "position": 0,
    "text": "چو شد روز رستم بپوشید گبر"
  },
  {
    "poem_id": 1596,
    "vorder": 2,
    "position": 1,
    "text": "نگهبان تن کرد بر گبر ببر"
  },
  {
    "poem_id": 1596,
    "vorder": 3,
    "position": 0,
    "text": "کمندی به فتراک زین ‌برببست"
  },
  {
    "poem_id": 1596,
    "vorder": 4,
    "position": 1,
    "text": "بران بارهٔ پیل پیکر نشست"
  },
  {
    "poem_id": 1596,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا شد زواره برش"
  },
  {
    "poem_id": 1596,
    "vorder": 6,
    "position": 1,
    "text": "فراوان سخن راند از لشکرش"
  },
  {
    "poem_id": 1596,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت رو لشکر آرای باش"
  },
  {
    "poem_id": 1596,
    "vorder": 8,
    "position": 1,
    "text": "بر کوههٔ ریگ بر پای باش"
  },
  {
    "poem_id": 1596,
    "vorder": 9,
    "position": 0,
    "text": "بیامد زواره سپه گرد کرد"
  },
  {
    "poem_id": 1596,
    "vorder": 10,
    "position": 1,
    "text": "به میدان کار و به دشت نبرد"
  },
  {
    "poem_id": 1596,
    "vorder": 11,
    "position": 0,
    "text": "تهمتن همی رفت نیزه به دست"
  },
  {
    "poem_id": 1596,
    "vorder": 12,
    "position": 1,
    "text": "چو بیرون شد از جایگاه نشست"
  },
  {
    "poem_id": 1596,
    "vorder": 13,
    "position": 0,
    "text": "سپاهش برو خواندند آفرین"
  },
  {
    "poem_id": 1596,
    "vorder": 14,
    "position": 1,
    "text": "که بی‌تو مباد اسپ و گوپال و زین"
  },
  {
    "poem_id": 1596,
    "vorder": 15,
    "position": 0,
    "text": "همی رفت رستم زواره پسش"
  },
  {
    "poem_id": 1596,
    "vorder": 16,
    "position": 1,
    "text": "کجا بود در پادشاهی کسش"
  },
  {
    "poem_id": 1596,
    "vorder": 17,
    "position": 0,
    "text": "بیامد چنان تا لب هیرمند"
  },
  {
    "poem_id": 1596,
    "vorder": 18,
    "position": 1,
    "text": "همه دل پر از باد و لب پر ز پند"
  },
  {
    "poem_id": 1596,
    "vorder": 19,
    "position": 0,
    "text": "سپه با برادر هم آنجا بماند"
  },
  {
    "poem_id": 1596,
    "vorder": 20,
    "position": 1,
    "text": "سوی لشکر شاه ایران براند"
  },
  {
    "poem_id": 1596,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت پس با زواره به راز"
  },
  {
    "poem_id": 1596,
    "vorder": 22,
    "position": 1,
    "text": "که مردیست این بدرگ دیوساز"
  },
  {
    "poem_id": 1596,
    "vorder": 23,
    "position": 0,
    "text": "بترسم که با او نیارم زدن"
  },
  {
    "poem_id": 1596,
    "vorder": 24,
    "position": 1,
    "text": "ندانم کزین پس چه شاید بدن"
  },
  {
    "poem_id": 1596,
    "vorder": 25,
    "position": 0,
    "text": "تو اکنون سپه را هم ایدر بدار"
  },
  {
    "poem_id": 1596,
    "vorder": 26,
    "position": 1,
    "text": "شوم تا چه پیش آورد روزگار"
  },
  {
    "poem_id": 1596,
    "vorder": 27,
    "position": 0,
    "text": "اگر تند یابمش هم زان نشان"
  },
  {
    "poem_id": 1596,
    "vorder": 28,
    "position": 1,
    "text": "نخواهم ز زابلستان سرکشان"
  },
  {
    "poem_id": 1596,
    "vorder": 29,
    "position": 0,
    "text": "به تنها تن خویش جویم نبرد"
  },
  {
    "poem_id": 1596,
    "vorder": 30,
    "position": 1,
    "text": "ز لشکر نخواهم کسی رنجه کرد"
  },
  {
    "poem_id": 1596,
    "vorder": 31,
    "position": 0,
    "text": "کسی باشد از بخت پیروز و شاد"
  },
  {
    "poem_id": 1596,
    "vorder": 32,
    "position": 1,
    "text": "که باشد همیشه دلش پر ز داد"
  },
  {
    "poem_id": 1596,
    "vorder": 33,
    "position": 0,
    "text": "گذشت از لب رود و بالا گرفت"
  },
  {
    "poem_id": 1596,
    "vorder": 34,
    "position": 1,
    "text": "همی ماند از کار گیتی شگفت"
  },
  {
    "poem_id": 1596,
    "vorder": 35,
    "position": 0,
    "text": "خروشید کای فرخ اسفندیار"
  },
  {
    "poem_id": 1596,
    "vorder": 36,
    "position": 1,
    "text": "هماوردت آمد برآرای کار"
  },
  {
    "poem_id": 1596,
    "vorder": 37,
    "position": 0,
    "text": "چو بشنید اسفندیار این سخن"
  },
  {
    "poem_id": 1596,
    "vorder": 38,
    "position": 1,
    "text": "ازان شیر پرخاشجوی کهن"
  },
  {
    "poem_id": 1596,
    "vorder": 39,
    "position": 0,
    "text": "بخندید و گفت اینک آراستم"
  },
  {
    "poem_id": 1596,
    "vorder": 40,
    "position": 1,
    "text": "بدانگه که از خواب برخاستم"
  },
  {
    "poem_id": 1596,
    "vorder": 41,
    "position": 0,
    "text": "بفرمود تا جوشن و خود اوی"
  },
  {
    "poem_id": 1596,
    "vorder": 42,
    "position": 1,
    "text": "همان ترکش و نیزهٔ جنگجوی"
  },
  {
    "poem_id": 1596,
    "vorder": 43,
    "position": 0,
    "text": "ببردند و پوشید جوشن برش"
  },
  {
    "poem_id": 1596,
    "vorder": 44,
    "position": 1,
    "text": "نهاد آن کلاه کیی بر سرش"
  },
  {
    "poem_id": 1596,
    "vorder": 45,
    "position": 0,
    "text": "بفرمود تا زین بر اسپ سیاه"
  },
  {
    "poem_id": 1596,
    "vorder": 46,
    "position": 1,
    "text": "نهادند و بردند نزدیک شاه"
  },
  {
    "poem_id": 1596,
    "vorder": 47,
    "position": 0,
    "text": "چو جوشن بپوشید پرخاشجوی"
  },
  {
    "poem_id": 1596,
    "vorder": 48,
    "position": 1,
    "text": "ز زور و ز شادی که بود اندر اوی"
  },
  {
    "poem_id": 1596,
    "vorder": 49,
    "position": 0,
    "text": "نهاد آن بن نیزه را بر زمین"
  },
  {
    "poem_id": 1596,
    "vorder": 50,
    "position": 1,
    "text": "ز خاک سیاه اندر آمد به زین"
  },
  {
    "poem_id": 1596,
    "vorder": 51,
    "position": 0,
    "text": "بسان پلنگی که بر پشت گور"
  },
  {
    "poem_id": 1596,
    "vorder": 52,
    "position": 1,
    "text": "نشیند برانگیزد از گور شور"
  },
  {
    "poem_id": 1596,
    "vorder": 53,
    "position": 0,
    "text": "سپه در شگفتی فروماندند"
  },
  {
    "poem_id": 1596,
    "vorder": 54,
    "position": 1,
    "text": "بران نامدار آفرین خواندند"
  },
  {
    "poem_id": 1596,
    "vorder": 55,
    "position": 0,
    "text": "همی شد چو نزد تهمتن رسید"
  },
  {
    "poem_id": 1596,
    "vorder": 56,
    "position": 1,
    "text": "مر او را بران باره تنها بدید"
  },
  {
    "poem_id": 1596,
    "vorder": 57,
    "position": 0,
    "text": "پس از بارگی با پشوتن بگفت"
  },
  {
    "poem_id": 1596,
    "vorder": 58,
    "position": 1,
    "text": "که ما را نباید بدو یار و جفت"
  },
  {
    "poem_id": 1596,
    "vorder": 59,
    "position": 0,
    "text": "چو تنهاست ما نیز تنها شویم"
  },
  {
    "poem_id": 1596,
    "vorder": 60,
    "position": 1,
    "text": "ز پستی بران تند بالا شویم"
  },
  {
    "poem_id": 1596,
    "vorder": 61,
    "position": 0,
    "text": "بران گونه رفتند هر دو به رزم"
  },
  {
    "poem_id": 1596,
    "vorder": 62,
    "position": 1,
    "text": "تو گفتی که اندر جهان نیست بزم"
  },
  {
    "poem_id": 1596,
    "vorder": 63,
    "position": 0,
    "text": "چو نزدیک گشتند پیر و جوان"
  },
  {
    "poem_id": 1596,
    "vorder": 64,
    "position": 1,
    "text": "دو شیر سرافراز و دو پهلوان"
  },
  {
    "poem_id": 1596,
    "vorder": 65,
    "position": 0,
    "text": "خروش آمد از بارهٔ هر دو مرد"
  },
  {
    "poem_id": 1596,
    "vorder": 66,
    "position": 1,
    "text": "تو گفتی بدرید دشت نبرد"
  },
  {
    "poem_id": 1596,
    "vorder": 67,
    "position": 0,
    "text": "چنین گفت رستم به آواز سخت"
  },
  {
    "poem_id": 1596,
    "vorder": 68,
    "position": 1,
    "text": "که ای شاه شادان‌دل و نیک‌بخت"
  },
  {
    "poem_id": 1596,
    "vorder": 69,
    "position": 0,
    "text": "ازین گونه مستیز و بد را مکوش"
  },
  {
    "poem_id": 1596,
    "vorder": 70,
    "position": 1,
    "text": "سوی مردمی یاز و بازآر هوش"
  },
  {
    "poem_id": 1596,
    "vorder": 71,
    "position": 0,
    "text": "اگر جنگ خواهی و خون ریختن"
  },
  {
    "poem_id": 1596,
    "vorder": 72,
    "position": 1,
    "text": "برین گونه سختی برآویختن"
  },
  {
    "poem_id": 1596,
    "vorder": 73,
    "position": 0,
    "text": "بگو تا سوار آورم زابلی"
  },
  {
    "poem_id": 1596,
    "vorder": 74,
    "position": 1,
    "text": "که باشند با خنجر کابلی"
  },
  {
    "poem_id": 1596,
    "vorder": 75,
    "position": 0,
    "text": "برین رزمگه‌شان به جنگ آوریم"
  },
  {
    "poem_id": 1596,
    "vorder": 76,
    "position": 1,
    "text": "خود ایدر زمانی درنگ آوریم"
  },
  {
    "poem_id": 1596,
    "vorder": 77,
    "position": 0,
    "text": "بباشد به کام تو خون ریختن"
  },
  {
    "poem_id": 1596,
    "vorder": 78,
    "position": 1,
    "text": "ببینی تگاپوی و آویختن"
  },
  {
    "poem_id": 1596,
    "vorder": 79,
    "position": 0,
    "text": "چنین پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1596,
    "vorder": 80,
    "position": 1,
    "text": "که چندین چه گویی چنین نابکار"
  },
  {
    "poem_id": 1596,
    "vorder": 81,
    "position": 0,
    "text": "ز ایوان به شبگیر برخاستی"
  },
  {
    "poem_id": 1596,
    "vorder": 82,
    "position": 1,
    "text": "ازین تند بالا مرا خواستی"
  },
  {
    "poem_id": 1596,
    "vorder": 83,
    "position": 0,
    "text": "چرا ساختی بند و مکر و فریب"
  },
  {
    "poem_id": 1596,
    "vorder": 84,
    "position": 1,
    "text": "همانا بدیدی به تنگی نشیب"
  },
  {
    "poem_id": 1596,
    "vorder": 85,
    "position": 0,
    "text": "چه باید مرا جنگ زابلستان"
  },
  {
    "poem_id": 1596,
    "vorder": 86,
    "position": 1,
    "text": "وگر جنگ ایران و کابلستان"
  },
  {
    "poem_id": 1596,
    "vorder": 87,
    "position": 0,
    "text": "مبادا چنین هرگز آیین من"
  },
  {
    "poem_id": 1596,
    "vorder": 88,
    "position": 1,
    "text": "سزا نیست این کار در دین من"
  },
  {
    "poem_id": 1596,
    "vorder": 89,
    "position": 0,
    "text": "که ایرانیان را به کشتن دهم"
  },
  {
    "poem_id": 1596,
    "vorder": 90,
    "position": 1,
    "text": "خود اندر جهان تاج بر سر نهم"
  },
  {
    "poem_id": 1596,
    "vorder": 91,
    "position": 0,
    "text": "منم پیشرو هرک جنگ آیدم"
  },
  {
    "poem_id": 1596,
    "vorder": 92,
    "position": 1,
    "text": "وگر پیش جنگ نهنگ آیدم"
  },
  {
    "poem_id": 1596,
    "vorder": 93,
    "position": 0,
    "text": "ترا گر همی یار باید بیار"
  },
  {
    "poem_id": 1596,
    "vorder": 94,
    "position": 1,
    "text": "مرا یار هرگز نیاید به کار"
  },
  {
    "poem_id": 1596,
    "vorder": 95,
    "position": 0,
    "text": "مرا یار در جنگ یزدان بود"
  },
  {
    "poem_id": 1596,
    "vorder": 96,
    "position": 1,
    "text": "سر و کار با بخت خندان بود"
  },
  {
    "poem_id": 1596,
    "vorder": 97,
    "position": 0,
    "text": "توی جنگجوی و منم جنگخواه"
  },
  {
    "poem_id": 1596,
    "vorder": 98,
    "position": 1,
    "text": "بگردیم یک با دگر بی‌سپاه"
  },
  {
    "poem_id": 1596,
    "vorder": 99,
    "position": 0,
    "text": "ببینیم تا اسپ اسفندیار"
  },
  {
    "poem_id": 1596,
    "vorder": 100,
    "position": 1,
    "text": "سوی آخور آید همی بی‌سوار"
  },
  {
    "poem_id": 1596,
    "vorder": 101,
    "position": 0,
    "text": "وگر بارهٔ رستم جنگجوی"
  },
  {
    "poem_id": 1596,
    "vorder": 102,
    "position": 1,
    "text": "به ایوان نهد بی‌خداوند روی"
  },
  {
    "poem_id": 1596,
    "vorder": 103,
    "position": 0,
    "text": "نهادند پیمان دو جنگی که کس"
  },
  {
    "poem_id": 1596,
    "vorder": 104,
    "position": 1,
    "text": "نباشد بران جنگ فریادرس"
  },
  {
    "poem_id": 1596,
    "vorder": 105,
    "position": 0,
    "text": "نخستین به نیزه برآویختند"
  },
  {
    "poem_id": 1596,
    "vorder": 106,
    "position": 1,
    "text": "همی خون ز جوشن فرو ریختند"
  },
  {
    "poem_id": 1596,
    "vorder": 107,
    "position": 0,
    "text": "چنین تا سنانها به هم برشکست"
  },
  {
    "poem_id": 1596,
    "vorder": 108,
    "position": 1,
    "text": "به شمشیر بردند ناچار دست"
  },
  {
    "poem_id": 1596,
    "vorder": 109,
    "position": 0,
    "text": "به آوردگه گردن افراختند"
  },
  {
    "poem_id": 1596,
    "vorder": 110,
    "position": 1,
    "text": "چپ و راست هر دو همی تاختند"
  },
  {
    "poem_id": 1596,
    "vorder": 111,
    "position": 0,
    "text": "ز نیروی اسپان و زخم سران"
  },
  {
    "poem_id": 1596,
    "vorder": 112,
    "position": 1,
    "text": "شکسته شد آن تیغهای گران"
  },
  {
    "poem_id": 1596,
    "vorder": 113,
    "position": 0,
    "text": "چو شیران جنگی برآشوفتند"
  },
  {
    "poem_id": 1596,
    "vorder": 114,
    "position": 1,
    "text": "پر از خشم اندامها کوفتند"
  },
  {
    "poem_id": 1596,
    "vorder": 115,
    "position": 0,
    "text": "همان دسته بشکست گرز گران"
  },
  {
    "poem_id": 1596,
    "vorder": 116,
    "position": 1,
    "text": "فروماند از کار دست سران"
  },
  {
    "poem_id": 1596,
    "vorder": 117,
    "position": 0,
    "text": "گرفتند زان پس دوال کمر"
  },
  {
    "poem_id": 1596,
    "vorder": 118,
    "position": 1,
    "text": "دو اسپ تگاور فروبرده سر"
  },
  {
    "poem_id": 1596,
    "vorder": 119,
    "position": 0,
    "text": "همی زور کرد این بران آن برین"
  },
  {
    "poem_id": 1596,
    "vorder": 120,
    "position": 1,
    "text": "نجنبید یک شیر بر پشت زین"
  },
  {
    "poem_id": 1596,
    "vorder": 121,
    "position": 0,
    "text": "پراگنده گشتند ز آوردگاه"
  },
  {
    "poem_id": 1596,
    "vorder": 122,
    "position": 1,
    "text": "غمی گشته اسپان و مردان تباه"
  },
  {
    "poem_id": 1596,
    "vorder": 123,
    "position": 0,
    "text": "کف اندر دهانشان شده خون و خاک"
  },
  {
    "poem_id": 1596,
    "vorder": 124,
    "position": 1,
    "text": "همه گبر و برگستوان چاک‌چاک"
  }
]