[
  {
    "poem_id": 1495,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید برزد سر از کوهسار"
  },
  {
    "poem_id": 1495,
    "vorder": 2,
    "position": 1,
    "text": "بگسترد یاقوت بر جویبار"
  },
  {
    "poem_id": 1495,
    "vorder": 3,
    "position": 0,
    "text": "تهمتن همه خواسته گرد کرد"
  },
  {
    "poem_id": 1495,
    "vorder": 4,
    "position": 1,
    "text": "ببخشید یکسر به مردان مرد"
  },
  {
    "poem_id": 1495,
    "vorder": 5,
    "position": 0,
    "text": "خروش آمد و نالهٔ کرنای"
  },
  {
    "poem_id": 1495,
    "vorder": 6,
    "position": 1,
    "text": "تهمتن برانگیخت لشکر ز جای"
  },
  {
    "poem_id": 1495,
    "vorder": 7,
    "position": 0,
    "text": "نهادند سر سوی افراسیاب"
  },
  {
    "poem_id": 1495,
    "vorder": 8,
    "position": 1,
    "text": "همه رخ ز کین سیاوش پر آب"
  },
  {
    "poem_id": 1495,
    "vorder": 9,
    "position": 0,
    "text": "پس آگاهی آمد به پرخاشجوی"
  },
  {
    "poem_id": 1495,
    "vorder": 10,
    "position": 1,
    "text": "که رستم به توران در آورد روی"
  },
  {
    "poem_id": 1495,
    "vorder": 11,
    "position": 0,
    "text": "به پیران چنین گفت کایرانیان"
  },
  {
    "poem_id": 1495,
    "vorder": 12,
    "position": 1,
    "text": "بدی را ببستند یکسر میان"
  },
  {
    "poem_id": 1495,
    "vorder": 13,
    "position": 0,
    "text": "کنون بوم و بر جمله ویران شود"
  },
  {
    "poem_id": 1495,
    "vorder": 14,
    "position": 1,
    "text": "به کام دلیران ایران شود"
  },
  {
    "poem_id": 1495,
    "vorder": 15,
    "position": 0,
    "text": "کسی نزد رستم برد آگهی"
  },
  {
    "poem_id": 1495,
    "vorder": 16,
    "position": 1,
    "text": "ازین کودک شوم بی‌فرهی"
  },
  {
    "poem_id": 1495,
    "vorder": 17,
    "position": 0,
    "text": "هم آنگه برندش به ایران سپاه"
  },
  {
    "poem_id": 1495,
    "vorder": 18,
    "position": 1,
    "text": "یکی ناسزا برنهندش کلاه"
  },
  {
    "poem_id": 1495,
    "vorder": 19,
    "position": 0,
    "text": "نوندی برافگن هم اندر زمان"
  },
  {
    "poem_id": 1495,
    "vorder": 20,
    "position": 1,
    "text": "بر شوم پی‌زادهٔ بدگمان"
  },
  {
    "poem_id": 1495,
    "vorder": 21,
    "position": 0,
    "text": "که با مادر آن هر دو تن را به هم"
  },
  {
    "poem_id": 1495,
    "vorder": 22,
    "position": 1,
    "text": "بیارد بگوید سخن بیش و کم"
  },
  {
    "poem_id": 1495,
    "vorder": 23,
    "position": 0,
    "text": "نوندی بیامد ببردندشان"
  },
  {
    "poem_id": 1495,
    "vorder": 24,
    "position": 1,
    "text": "شدند آن دو بیچاره چون بیهشان"
  },
  {
    "poem_id": 1495,
    "vorder": 25,
    "position": 0,
    "text": "به نزدیک افراسیاب آمدند"
  },
  {
    "poem_id": 1495,
    "vorder": 26,
    "position": 1,
    "text": "پر از درد و تیمار و تاب آمدند"
  },
  {
    "poem_id": 1495,
    "vorder": 27,
    "position": 0,
    "text": "وز آن جایگه شاه توران زمین"
  },
  {
    "poem_id": 1495,
    "vorder": 28,
    "position": 1,
    "text": "بیاورد لشکر به دریای چین"
  },
  {
    "poem_id": 1495,
    "vorder": 29,
    "position": 0,
    "text": "تهمتن نشست از بر تخت اوی"
  },
  {
    "poem_id": 1495,
    "vorder": 30,
    "position": 1,
    "text": "به خاک اندر آمد سر بخت اوی"
  },
  {
    "poem_id": 1495,
    "vorder": 31,
    "position": 0,
    "text": "یکی داستانی بگفت از نخست"
  },
  {
    "poem_id": 1495,
    "vorder": 32,
    "position": 1,
    "text": "که پرمایه آنکس که دشمن نجست"
  },
  {
    "poem_id": 1495,
    "vorder": 33,
    "position": 0,
    "text": "چو بدخواه پیش آیدت کشته به"
  },
  {
    "poem_id": 1495,
    "vorder": 34,
    "position": 1,
    "text": "گر آواره از پیش برگشته به"
  },
  {
    "poem_id": 1495,
    "vorder": 35,
    "position": 0,
    "text": "از ایوان همه گنج او بازجست"
  },
  {
    "poem_id": 1495,
    "vorder": 36,
    "position": 1,
    "text": "بگفتند با او یکایک درست"
  },
  {
    "poem_id": 1495,
    "vorder": 37,
    "position": 0,
    "text": "غلامان و اسپ و پرستندگان"
  },
  {
    "poem_id": 1495,
    "vorder": 38,
    "position": 1,
    "text": "همان مایه‌ور خوب رخ بندگان"
  },
  {
    "poem_id": 1495,
    "vorder": 39,
    "position": 0,
    "text": "در گنج دینار و پرمایه تاج"
  },
  {
    "poem_id": 1495,
    "vorder": 40,
    "position": 1,
    "text": "همان گوهر و دیبه و تخت عاج"
  },
  {
    "poem_id": 1495,
    "vorder": 41,
    "position": 0,
    "text": "یکایک ز هر سو به چنگ آمدش"
  },
  {
    "poem_id": 1495,
    "vorder": 42,
    "position": 1,
    "text": "بسی گوهر از گنج گنگ آمدش"
  },
  {
    "poem_id": 1495,
    "vorder": 43,
    "position": 0,
    "text": "سپه سر به سر زان توانگر شدند"
  },
  {
    "poem_id": 1495,
    "vorder": 44,
    "position": 1,
    "text": "ابا یاره و تخت و افسر شدند"
  },
  {
    "poem_id": 1495,
    "vorder": 45,
    "position": 0,
    "text": "یکی طوس را داد زان تخت عاج"
  },
  {
    "poem_id": 1495,
    "vorder": 46,
    "position": 1,
    "text": "همان یاره و طوق و منشور چاچ"
  },
  {
    "poem_id": 1495,
    "vorder": 47,
    "position": 0,
    "text": "ورا گفت هر کس که تاب آورد"
  },
  {
    "poem_id": 1495,
    "vorder": 48,
    "position": 1,
    "text": "وگر نام افراسیاب آورد"
  },
  {
    "poem_id": 1495,
    "vorder": 49,
    "position": 0,
    "text": "همانگه سرش را ز تن دور کن"
  },
  {
    "poem_id": 1495,
    "vorder": 50,
    "position": 1,
    "text": "ازو کرگسان را یکی سور کن"
  },
  {
    "poem_id": 1495,
    "vorder": 51,
    "position": 0,
    "text": "کسی کاو خرد جوید و ایمنی"
  },
  {
    "poem_id": 1495,
    "vorder": 52,
    "position": 1,
    "text": "نیازد سوی کیش آهرمنی"
  },
  {
    "poem_id": 1495,
    "vorder": 53,
    "position": 0,
    "text": "چو فرزند باید که داری به ناز"
  },
  {
    "poem_id": 1495,
    "vorder": 54,
    "position": 1,
    "text": "ز رنج ایمن از خواسته بی‌نیاز"
  },
  {
    "poem_id": 1495,
    "vorder": 55,
    "position": 0,
    "text": "تو درویش را رنج منمای هیچ"
  },
  {
    "poem_id": 1495,
    "vorder": 56,
    "position": 1,
    "text": "همی داد و بر داد دادن بسیچ"
  },
  {
    "poem_id": 1495,
    "vorder": 57,
    "position": 0,
    "text": "که گیتی سپنجست و جاوید نیست"
  },
  {
    "poem_id": 1495,
    "vorder": 58,
    "position": 1,
    "text": "فری برتر از فر جمشید نیست"
  },
  {
    "poem_id": 1495,
    "vorder": 59,
    "position": 0,
    "text": "سپهر بلندش به پا آورید"
  },
  {
    "poem_id": 1495,
    "vorder": 60,
    "position": 1,
    "text": "جهان را جزو کدخدا آورید"
  },
  {
    "poem_id": 1495,
    "vorder": 61,
    "position": 0,
    "text": "یکی تاج پرگوهر شاهوار"
  },
  {
    "poem_id": 1495,
    "vorder": 62,
    "position": 1,
    "text": "دو تا یاره و طوق با گوشوار"
  },
  {
    "poem_id": 1495,
    "vorder": 63,
    "position": 0,
    "text": "سپیجاب و سغدش به گودرز داد"
  },
  {
    "poem_id": 1495,
    "vorder": 64,
    "position": 1,
    "text": "بسی پند و منشور آن مرز داد"
  },
  {
    "poem_id": 1495,
    "vorder": 65,
    "position": 0,
    "text": "ستودش فراوان و کرد آفرین"
  },
  {
    "poem_id": 1495,
    "vorder": 66,
    "position": 1,
    "text": "که چون تو کسی نیست ز ایران زمین"
  },
  {
    "poem_id": 1495,
    "vorder": 67,
    "position": 0,
    "text": "بزرگی و فر و بلندی و داد"
  },
  {
    "poem_id": 1495,
    "vorder": 68,
    "position": 1,
    "text": "همان بزم و رزم از تو داریم یاد"
  },
  {
    "poem_id": 1495,
    "vorder": 69,
    "position": 0,
    "text": "ترا با هنر گوهرست و خرد"
  },
  {
    "poem_id": 1495,
    "vorder": 70,
    "position": 1,
    "text": "روانت همی از تو رامش برد"
  },
  {
    "poem_id": 1495,
    "vorder": 71,
    "position": 0,
    "text": "روا باشد ار پند من بشنوی"
  },
  {
    "poem_id": 1495,
    "vorder": 72,
    "position": 1,
    "text": "که آموزگار بزرگان توی"
  },
  {
    "poem_id": 1495,
    "vorder": 73,
    "position": 0,
    "text": "سپیجاب تا آب گلزریون"
  },
  {
    "poem_id": 1495,
    "vorder": 74,
    "position": 1,
    "text": "ز فرمان تو کس نیاید برون"
  },
  {
    "poem_id": 1495,
    "vorder": 75,
    "position": 0,
    "text": "فریبرز کاووس را تاج زر"
  },
  {
    "poem_id": 1495,
    "vorder": 76,
    "position": 1,
    "text": "فرستاد و دینار و تخت و کمر"
  },
  {
    "poem_id": 1495,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت سالار و مهتر توی"
  },
  {
    "poem_id": 1495,
    "vorder": 78,
    "position": 1,
    "text": "سیاووش رد را برادر توی"
  },
  {
    "poem_id": 1495,
    "vorder": 79,
    "position": 0,
    "text": "میان را به کین برادر ببند"
  },
  {
    "poem_id": 1495,
    "vorder": 80,
    "position": 1,
    "text": "ز فتراک مگشای بند کمند"
  },
  {
    "poem_id": 1495,
    "vorder": 81,
    "position": 0,
    "text": "به چین و ختن اندرآور سپاه"
  },
  {
    "poem_id": 1495,
    "vorder": 82,
    "position": 1,
    "text": "به هر جای از دشمنان کینه‌خواه"
  },
  {
    "poem_id": 1495,
    "vorder": 83,
    "position": 0,
    "text": "میاسای از کین افراسیاب"
  },
  {
    "poem_id": 1495,
    "vorder": 84,
    "position": 1,
    "text": "ز تن دور کن خورد و آرام و خواب"
  },
  {
    "poem_id": 1495,
    "vorder": 85,
    "position": 0,
    "text": "به ماچین و چین آمد این آگهی"
  },
  {
    "poem_id": 1495,
    "vorder": 86,
    "position": 1,
    "text": "که بنشست رستم به شاهنشهی"
  },
  {
    "poem_id": 1495,
    "vorder": 87,
    "position": 0,
    "text": "همه هدیه ها ساختند و نثار"
  },
  {
    "poem_id": 1495,
    "vorder": 88,
    "position": 1,
    "text": "ز دینار و ز گوهر شاهوار"
  },
  {
    "poem_id": 1495,
    "vorder": 89,
    "position": 0,
    "text": "تهمتن به جان داد زنهارشان"
  },
  {
    "poem_id": 1495,
    "vorder": 90,
    "position": 1,
    "text": "بدید آن روانهای بیدارشان"
  },
  {
    "poem_id": 1495,
    "vorder": 91,
    "position": 0,
    "text": "وزان پس بنخچیر با یوز و باز"
  },
  {
    "poem_id": 1495,
    "vorder": 92,
    "position": 1,
    "text": "برآمد برین روزگاری دراز"
  },
  {
    "poem_id": 1495,
    "vorder": 93,
    "position": 0,
    "text": "چنان بد که روزی زواره برفت"
  },
  {
    "poem_id": 1495,
    "vorder": 94,
    "position": 1,
    "text": "به نخچیر گوران خرامید تفت"
  },
  {
    "poem_id": 1495,
    "vorder": 95,
    "position": 0,
    "text": "یکی ترک تا باشدش رهنمای"
  },
  {
    "poem_id": 1495,
    "vorder": 96,
    "position": 1,
    "text": "به پیش اندر افگند و آمد بجای"
  },
  {
    "poem_id": 1495,
    "vorder": 97,
    "position": 0,
    "text": "یکی بیشه دید اندران پهن دشت"
  },
  {
    "poem_id": 1495,
    "vorder": 98,
    "position": 1,
    "text": "که گفتی برو بر نشاید گذشت"
  },
  {
    "poem_id": 1495,
    "vorder": 99,
    "position": 0,
    "text": "ز بس بوی و بس رنگ و آب روان"
  },
  {
    "poem_id": 1495,
    "vorder": 100,
    "position": 1,
    "text": "همی نو شد از باد گفتی روان"
  },
  {
    "poem_id": 1495,
    "vorder": 101,
    "position": 0,
    "text": "پس آن ترک خیره زبان برگشاد"
  },
  {
    "poem_id": 1495,
    "vorder": 102,
    "position": 1,
    "text": "به پیش زواره همی کرد یاد"
  },
  {
    "poem_id": 1495,
    "vorder": 103,
    "position": 0,
    "text": "که نخچیرگاه سیاوش بد این"
  },
  {
    "poem_id": 1495,
    "vorder": 104,
    "position": 1,
    "text": "برین بود مهرش به توران زمین"
  },
  {
    "poem_id": 1495,
    "vorder": 105,
    "position": 0,
    "text": "بدین جایگه شاد و خرم بدی"
  },
  {
    "poem_id": 1495,
    "vorder": 106,
    "position": 1,
    "text": "جز ایدر همه جای با غم بدی"
  },
  {
    "poem_id": 1495,
    "vorder": 107,
    "position": 0,
    "text": "زواره چو بشنید زو این سخن"
  },
  {
    "poem_id": 1495,
    "vorder": 108,
    "position": 1,
    "text": "برو تازه شد روزگار کهن"
  },
  {
    "poem_id": 1495,
    "vorder": 109,
    "position": 0,
    "text": "چو گفتار آن ترکش آمد به گوش"
  },
  {
    "poem_id": 1495,
    "vorder": 110,
    "position": 1,
    "text": "ز اسپ اندر افتاد و زو رفت هوش"
  },
  {
    "poem_id": 1495,
    "vorder": 111,
    "position": 0,
    "text": "یکی باز بودش به چنگ اندرون"
  },
  {
    "poem_id": 1495,
    "vorder": 112,
    "position": 1,
    "text": "رها کرد و مژگان شدش جوی خون"
  },
  {
    "poem_id": 1495,
    "vorder": 113,
    "position": 0,
    "text": "رسیدند یاران لشکر بدوی"
  },
  {
    "poem_id": 1495,
    "vorder": 114,
    "position": 1,
    "text": "غمی یافتندش پر از آب روی"
  },
  {
    "poem_id": 1495,
    "vorder": 115,
    "position": 0,
    "text": "گرفتند نفرین بران رهنمای"
  },
  {
    "poem_id": 1495,
    "vorder": 116,
    "position": 1,
    "text": "به زخمش فگندند هر یک ز پای"
  },
  {
    "poem_id": 1495,
    "vorder": 117,
    "position": 0,
    "text": "زواره یکی سخت سوگند خورد"
  },
  {
    "poem_id": 1495,
    "vorder": 118,
    "position": 1,
    "text": "فرو ریخت از دیدگان آب زرد"
  },
  {
    "poem_id": 1495,
    "vorder": 119,
    "position": 0,
    "text": "کزین پس نه نخچیر جویم نه خواب"
  },
  {
    "poem_id": 1495,
    "vorder": 120,
    "position": 1,
    "text": "نپردازم از کین افراسیاب"
  },
  {
    "poem_id": 1495,
    "vorder": 121,
    "position": 0,
    "text": "نمانم که رستم برآساید ایچ"
  },
  {
    "poem_id": 1495,
    "vorder": 122,
    "position": 1,
    "text": "همی کینه را کرد باید بسیچ"
  },
  {
    "poem_id": 1495,
    "vorder": 123,
    "position": 0,
    "text": "همانگه چو نزد تهمتن رسید"
  },
  {
    "poem_id": 1495,
    "vorder": 124,
    "position": 1,
    "text": "خروشید چون روی او را بدید"
  },
  {
    "poem_id": 1495,
    "vorder": 125,
    "position": 0,
    "text": "بدو گفت کایدر به کین آمدیم"
  },
  {
    "poem_id": 1495,
    "vorder": 126,
    "position": 1,
    "text": "و گر لب پر از آفرین آمدیم"
  },
  {
    "poem_id": 1495,
    "vorder": 127,
    "position": 0,
    "text": "چو یزدان نیکی دهش زور داد"
  },
  {
    "poem_id": 1495,
    "vorder": 128,
    "position": 1,
    "text": "از اختر ترا گردش هور داد"
  },
  {
    "poem_id": 1495,
    "vorder": 129,
    "position": 0,
    "text": "چرا باید این کشور آباد ماند"
  },
  {
    "poem_id": 1495,
    "vorder": 130,
    "position": 1,
    "text": "یکی را برین بوم و بر شاد ماند"
  },
  {
    "poem_id": 1495,
    "vorder": 131,
    "position": 0,
    "text": "فرامش مکن کین آن شهریار"
  },
  {
    "poem_id": 1495,
    "vorder": 132,
    "position": 1,
    "text": "که چون او نبیند دگر روزگار"
  },
  {
    "poem_id": 1495,
    "vorder": 133,
    "position": 0,
    "text": "برانگیخت آن پیلتن را ز جای"
  },
  {
    "poem_id": 1495,
    "vorder": 134,
    "position": 1,
    "text": "تهمتن هم آن کرد کاو دید رای"
  },
  {
    "poem_id": 1495,
    "vorder": 135,
    "position": 0,
    "text": "همان غارت و کشتن اندر گرفت"
  },
  {
    "poem_id": 1495,
    "vorder": 136,
    "position": 1,
    "text": "همه بوم و بر دست بر سر گرفت"
  },
  {
    "poem_id": 1495,
    "vorder": 137,
    "position": 0,
    "text": "ز توران زمین تا به سقلاب و روم"
  },
  {
    "poem_id": 1495,
    "vorder": 138,
    "position": 1,
    "text": "نماندند یک مرز آباد بوم"
  },
  {
    "poem_id": 1495,
    "vorder": 139,
    "position": 0,
    "text": "همی سر بریدند برنا و پیر"
  },
  {
    "poem_id": 1495,
    "vorder": 140,
    "position": 1,
    "text": "زن و کودک خرد کردند اسیر"
  },
  {
    "poem_id": 1495,
    "vorder": 141,
    "position": 0,
    "text": "برین گونه فرسنگ بیش از هزار"
  },
  {
    "poem_id": 1495,
    "vorder": 142,
    "position": 1,
    "text": "برآمد ز کشور سراسر دمار"
  },
  {
    "poem_id": 1495,
    "vorder": 143,
    "position": 0,
    "text": "هرآنکس که بد مهتری با گهر"
  },
  {
    "poem_id": 1495,
    "vorder": 144,
    "position": 1,
    "text": "همه پیش رفتند بر خاک سر"
  },
  {
    "poem_id": 1495,
    "vorder": 145,
    "position": 0,
    "text": "که بیزار گشتیم ز افراسیاب"
  },
  {
    "poem_id": 1495,
    "vorder": 146,
    "position": 1,
    "text": "نخواهیم دیدار او را به خواب"
  },
  {
    "poem_id": 1495,
    "vorder": 147,
    "position": 0,
    "text": "ازان خون که او ریخت بر بیگناه"
  },
  {
    "poem_id": 1495,
    "vorder": 148,
    "position": 1,
    "text": "کسی را نبود اندر آن روی راه"
  },
  {
    "poem_id": 1495,
    "vorder": 149,
    "position": 0,
    "text": "کنون انجمن گر پراگنده‌ایم"
  },
  {
    "poem_id": 1495,
    "vorder": 150,
    "position": 1,
    "text": "همه پیش تو چاکر و بنده‌ایم"
  },
  {
    "poem_id": 1495,
    "vorder": 151,
    "position": 0,
    "text": "چو چیره شدی بیگنه خون مریز"
  },
  {
    "poem_id": 1495,
    "vorder": 152,
    "position": 1,
    "text": "مکن چنگ گردون گردنده تیز"
  },
  {
    "poem_id": 1495,
    "vorder": 153,
    "position": 0,
    "text": "ندانیم ماکان جفاگر کجاست"
  },
  {
    "poem_id": 1495,
    "vorder": 154,
    "position": 1,
    "text": "به ابرست گر در دم اژدهاست"
  },
  {
    "poem_id": 1495,
    "vorder": 155,
    "position": 0,
    "text": "چو بشنید گفتار آن انجمن"
  },
  {
    "poem_id": 1495,
    "vorder": 156,
    "position": 1,
    "text": "بپیچید بینادل پیلتن"
  },
  {
    "poem_id": 1495,
    "vorder": 157,
    "position": 0,
    "text": "سوی مرز قچغار باشی براند"
  },
  {
    "poem_id": 1495,
    "vorder": 158,
    "position": 1,
    "text": "سران سپه را سراسر بخواند"
  },
  {
    "poem_id": 1495,
    "vorder": 159,
    "position": 0,
    "text": "شدند انجمن پیش او بخردان"
  },
  {
    "poem_id": 1495,
    "vorder": 160,
    "position": 1,
    "text": "بزرگان و کارآزموده ردان"
  },
  {
    "poem_id": 1495,
    "vorder": 161,
    "position": 0,
    "text": "که کاووس بی‌دست و بی فر و پای"
  },
  {
    "poem_id": 1495,
    "vorder": 162,
    "position": 1,
    "text": "نشستست بر تخت بی‌رهنمای"
  },
  {
    "poem_id": 1495,
    "vorder": 163,
    "position": 0,
    "text": "گر افراسیاب از رهی بی‌درنگ"
  },
  {
    "poem_id": 1495,
    "vorder": 164,
    "position": 1,
    "text": "یکی لشکر آرد به ایران به جنگ"
  },
  {
    "poem_id": 1495,
    "vorder": 165,
    "position": 0,
    "text": "بیابد بران پیر کاووس دست"
  },
  {
    "poem_id": 1495,
    "vorder": 166,
    "position": 1,
    "text": "شود کام و آرام ما جمله پست"
  },
  {
    "poem_id": 1495,
    "vorder": 167,
    "position": 0,
    "text": "یکایک همه فام کین توختیم"
  },
  {
    "poem_id": 1495,
    "vorder": 168,
    "position": 1,
    "text": "همه شهر آباد او سوختیم"
  },
  {
    "poem_id": 1495,
    "vorder": 169,
    "position": 0,
    "text": "کجا سالیان اندر آمد به شش"
  },
  {
    "poem_id": 1495,
    "vorder": 170,
    "position": 1,
    "text": "که نگذشت بر ما یکی روز خوش"
  },
  {
    "poem_id": 1495,
    "vorder": 171,
    "position": 0,
    "text": "کنون نزد آن پیر خسرو شویم"
  },
  {
    "poem_id": 1495,
    "vorder": 172,
    "position": 1,
    "text": "چو رزم اندر آید همه نو شویم"
  },
  {
    "poem_id": 1495,
    "vorder": 173,
    "position": 0,
    "text": "چو دل بر نهی بر سرای کهن"
  },
  {
    "poem_id": 1495,
    "vorder": 174,
    "position": 1,
    "text": "کند ناز و ز تو بپوشد سخن"
  },
  {
    "poem_id": 1495,
    "vorder": 175,
    "position": 0,
    "text": "تهمتن بران گشت همداستان"
  },
  {
    "poem_id": 1495,
    "vorder": 176,
    "position": 1,
    "text": "که فرخنده موبد زد این داستان"
  },
  {
    "poem_id": 1495,
    "vorder": 177,
    "position": 0,
    "text": "چنین گفت خرم دل رهنمای"
  },
  {
    "poem_id": 1495,
    "vorder": 178,
    "position": 1,
    "text": "که خوبی گزین زین سپنجی سرای"
  },
  {
    "poem_id": 1495,
    "vorder": 179,
    "position": 0,
    "text": "بنوش و بناز و بپوش و بخور"
  },
  {
    "poem_id": 1495,
    "vorder": 180,
    "position": 1,
    "text": "ترا بهره اینست زین رهگذر"
  },
  {
    "poem_id": 1495,
    "vorder": 181,
    "position": 0,
    "text": "سوی آز منگر که او دشمنست"
  },
  {
    "poem_id": 1495,
    "vorder": 182,
    "position": 1,
    "text": "دلش بردهٔ جان آهرمنست"
  },
  {
    "poem_id": 1495,
    "vorder": 183,
    "position": 0,
    "text": "نگه کن که در خاک جفت تو کیست"
  },
  {
    "poem_id": 1495,
    "vorder": 184,
    "position": 1,
    "text": "برین خواسته چند خواهی گریست"
  },
  {
    "poem_id": 1495,
    "vorder": 185,
    "position": 0,
    "text": "تهمتن چو بشنید شرم آمدش"
  },
  {
    "poem_id": 1495,
    "vorder": 186,
    "position": 1,
    "text": "برفتن یکی رای گرم آمدش"
  },
  {
    "poem_id": 1495,
    "vorder": 187,
    "position": 0,
    "text": "نگه کرد ز اسپان به هر سو گله"
  },
  {
    "poem_id": 1495,
    "vorder": 188,
    "position": 1,
    "text": "که بودند بر دشت ترکان یله"
  },
  {
    "poem_id": 1495,
    "vorder": 189,
    "position": 0,
    "text": "غلام و پرستندگان ده هزار"
  },
  {
    "poem_id": 1495,
    "vorder": 190,
    "position": 1,
    "text": "بیاورد شایستهٔ شهریار"
  },
  {
    "poem_id": 1495,
    "vorder": 191,
    "position": 0,
    "text": "همان نافهٔ مشک و موی سمور"
  },
  {
    "poem_id": 1495,
    "vorder": 192,
    "position": 1,
    "text": "ز در سپید و ز کیمال بور"
  },
  {
    "poem_id": 1495,
    "vorder": 193,
    "position": 0,
    "text": "به رنگ و به بوی و به دیبا و زر"
  },
  {
    "poem_id": 1495,
    "vorder": 194,
    "position": 1,
    "text": "شد آراسته پشت پیلان نر"
  },
  {
    "poem_id": 1495,
    "vorder": 195,
    "position": 0,
    "text": "ز گستردنیها و از بیش و کم"
  },
  {
    "poem_id": 1495,
    "vorder": 196,
    "position": 1,
    "text": "ز پوشیدنیها و گنج و درم"
  },
  {
    "poem_id": 1495,
    "vorder": 197,
    "position": 0,
    "text": "ز گنج سلیح و ز تاج و ز تخت"
  },
  {
    "poem_id": 1495,
    "vorder": 198,
    "position": 1,
    "text": "به ایران کشیدند و بربست رخت"
  },
  {
    "poem_id": 1495,
    "vorder": 199,
    "position": 0,
    "text": "ز توران سوی زابلستان کشید"
  },
  {
    "poem_id": 1495,
    "vorder": 200,
    "position": 1,
    "text": "به نزدیک فرخنده دستان کشید"
  },
  {
    "poem_id": 1495,
    "vorder": 201,
    "position": 0,
    "text": "سوی پارس شد طوس و گودرز و گیو"
  },
  {
    "poem_id": 1495,
    "vorder": 202,
    "position": 1,
    "text": "سپاهی چنان نامبردار و نیو"
  },
  {
    "poem_id": 1495,
    "vorder": 203,
    "position": 0,
    "text": "نهادند سر سوی شاه جهان"
  },
  {
    "poem_id": 1495,
    "vorder": 204,
    "position": 1,
    "text": "همه نامداران فرخ نهان"
  },
  {
    "poem_id": 1495,
    "vorder": 205,
    "position": 0,
    "text": "وزان پس چو بشنید افراسیاب"
  },
  {
    "poem_id": 1495,
    "vorder": 206,
    "position": 1,
    "text": "که بگذشت رستم بران روی آب"
  },
  {
    "poem_id": 1495,
    "vorder": 207,
    "position": 0,
    "text": "شد از باختر سوی دریای گنگ"
  },
  {
    "poem_id": 1495,
    "vorder": 208,
    "position": 1,
    "text": "دلی پر ز کینه سری پر ز جنگ"
  },
  {
    "poem_id": 1495,
    "vorder": 209,
    "position": 0,
    "text": "همه بوم زیر و زبر کرده دید"
  },
  {
    "poem_id": 1495,
    "vorder": 210,
    "position": 1,
    "text": "مهان کشته و کهتران برده دید"
  },
  {
    "poem_id": 1495,
    "vorder": 211,
    "position": 0,
    "text": "نه اسپ و نه گنج و نه تاج و نه تخت"
  },
  {
    "poem_id": 1495,
    "vorder": 212,
    "position": 1,
    "text": "نه شاداب در باغ برگ درخت"
  },
  {
    "poem_id": 1495,
    "vorder": 213,
    "position": 0,
    "text": "جهانی به آتش برافروخته"
  },
  {
    "poem_id": 1495,
    "vorder": 214,
    "position": 1,
    "text": "همه کاخها کنده و سوخته"
  },
  {
    "poem_id": 1495,
    "vorder": 215,
    "position": 0,
    "text": "ز دیده ببارید خونابه شاه"
  },
  {
    "poem_id": 1495,
    "vorder": 216,
    "position": 1,
    "text": "چنین گفت با مهتران سپاه"
  },
  {
    "poem_id": 1495,
    "vorder": 217,
    "position": 0,
    "text": "که هر کس که این را فرامش کند"
  },
  {
    "poem_id": 1495,
    "vorder": 218,
    "position": 1,
    "text": "همی جان بیدار خامش کند"
  },
  {
    "poem_id": 1495,
    "vorder": 219,
    "position": 0,
    "text": "همه یک به یک دل پر از کین کنید"
  },
  {
    "poem_id": 1495,
    "vorder": 220,
    "position": 1,
    "text": "سپر بستر و تیغ بالین کنید"
  },
  {
    "poem_id": 1495,
    "vorder": 221,
    "position": 0,
    "text": "به ایران سپه رزم و کین آوریم"
  },
  {
    "poem_id": 1495,
    "vorder": 222,
    "position": 1,
    "text": "به نیزه خور اندر زمین آوریم"
  },
  {
    "poem_id": 1495,
    "vorder": 223,
    "position": 0,
    "text": "به یک رزم اگر باد ایشان بجست"
  },
  {
    "poem_id": 1495,
    "vorder": 224,
    "position": 1,
    "text": "نباید چنین کردن اندیشه پست"
  },
  {
    "poem_id": 1495,
    "vorder": 225,
    "position": 0,
    "text": "برآراست بر هر سوی تاختن"
  },
  {
    "poem_id": 1495,
    "vorder": 226,
    "position": 1,
    "text": "ندید ایچ هنگام پرداختن"
  },
  {
    "poem_id": 1495,
    "vorder": 227,
    "position": 0,
    "text": "همی سوخت آباد بوم و درخت"
  },
  {
    "poem_id": 1495,
    "vorder": 228,
    "position": 1,
    "text": "به ایرانیان بر شد آن کار سخت"
  },
  {
    "poem_id": 1495,
    "vorder": 229,
    "position": 0,
    "text": "ز باران هوا خشک شد هفت سال"
  },
  {
    "poem_id": 1495,
    "vorder": 230,
    "position": 1,
    "text": "دگرگونه شد بخت و برگشت حال"
  },
  {
    "poem_id": 1495,
    "vorder": 231,
    "position": 0,
    "text": "شد از رنج و سختی جهان پر نیاز"
  },
  {
    "poem_id": 1495,
    "vorder": 232,
    "position": 1,
    "text": "برآمد برین روزگار دراز"
  }
]