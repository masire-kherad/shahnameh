[
  {
    "poem_id": 1785,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا تخت شاهنشهی"
  },
  {
    "poem_id": 1785,
    "vorder": 2,
    "position": 1,
    "text": "به باغ بهار اندر آرد رهی"
  },
  {
    "poem_id": 1785,
    "vorder": 3,
    "position": 0,
    "text": "به فرمان ببردند پیروزه تخت"
  },
  {
    "poem_id": 1785,
    "vorder": 4,
    "position": 1,
    "text": "نهادند زیر گلفشان درخت"
  },
  {
    "poem_id": 1785,
    "vorder": 5,
    "position": 0,
    "text": "می و جام بردند و رامشگران"
  },
  {
    "poem_id": 1785,
    "vorder": 6,
    "position": 1,
    "text": "به پالیز رفتند با مهتران"
  },
  {
    "poem_id": 1785,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت با رای‌زن شهریار"
  },
  {
    "poem_id": 1785,
    "vorder": 8,
    "position": 1,
    "text": "که خرم به مردم بود روزگار"
  },
  {
    "poem_id": 1785,
    "vorder": 9,
    "position": 0,
    "text": "به دخمه درون بس که تنهاشویم"
  },
  {
    "poem_id": 1785,
    "vorder": 10,
    "position": 1,
    "text": "اگر چند با برز و بالا شویم"
  },
  {
    "poem_id": 1785,
    "vorder": 11,
    "position": 0,
    "text": "همه بسترد مرگ دیوانها"
  },
  {
    "poem_id": 1785,
    "vorder": 12,
    "position": 1,
    "text": "به پای آورد کاخ و ایوانها"
  },
  {
    "poem_id": 1785,
    "vorder": 13,
    "position": 0,
    "text": "ز شاه و ز درویش هر کو بمرد"
  },
  {
    "poem_id": 1785,
    "vorder": 14,
    "position": 1,
    "text": "ابا خویشتن نام نیکی ببرد"
  },
  {
    "poem_id": 1785,
    "vorder": 15,
    "position": 0,
    "text": "ز گیتی ستایش به مابر بس است"
  },
  {
    "poem_id": 1785,
    "vorder": 16,
    "position": 1,
    "text": "که گنج درم بهر دیگر کس است"
  },
  {
    "poem_id": 1785,
    "vorder": 17,
    "position": 0,
    "text": "بی‌آزاری و راستی بایدت"
  },
  {
    "poem_id": 1785,
    "vorder": 18,
    "position": 1,
    "text": "چو خواهی که این خورده نگزایدت"
  },
  {
    "poem_id": 1785,
    "vorder": 19,
    "position": 0,
    "text": "کنون سال من رفت بر سی و هشت"
  },
  {
    "poem_id": 1785,
    "vorder": 20,
    "position": 1,
    "text": "بسی روز بر شادمانی گذشت"
  },
  {
    "poem_id": 1785,
    "vorder": 21,
    "position": 0,
    "text": "چو سال جوان بر کشد بر چهل"
  },
  {
    "poem_id": 1785,
    "vorder": 22,
    "position": 1,
    "text": "غم روز مرگ اندرآید به دل"
  },
  {
    "poem_id": 1785,
    "vorder": 23,
    "position": 0,
    "text": "چو یک موی گردد به سر بر سپید"
  },
  {
    "poem_id": 1785,
    "vorder": 24,
    "position": 1,
    "text": "بباید گسستن ز شادی امید"
  },
  {
    "poem_id": 1785,
    "vorder": 25,
    "position": 0,
    "text": "چو کافور شد مشک معیوب گشت"
  },
  {
    "poem_id": 1785,
    "vorder": 26,
    "position": 1,
    "text": "به کافور بر تاج ناخوب گشت"
  },
  {
    "poem_id": 1785,
    "vorder": 27,
    "position": 0,
    "text": "همی بزم و بازی کنم تا دو سال"
  },
  {
    "poem_id": 1785,
    "vorder": 28,
    "position": 1,
    "text": "چو لختی شکست اندر آید به یال"
  },
  {
    "poem_id": 1785,
    "vorder": 29,
    "position": 0,
    "text": "شوم پیش یزدان بپوشم پلاس"
  },
  {
    "poem_id": 1785,
    "vorder": 30,
    "position": 1,
    "text": "نباشم ز گفتار او ناسپاس"
  },
  {
    "poem_id": 1785,
    "vorder": 31,
    "position": 0,
    "text": "به شادی بسی روز بگذاشتم"
  },
  {
    "poem_id": 1785,
    "vorder": 32,
    "position": 1,
    "text": "ز بادی که بد بهره برداشتم"
  },
  {
    "poem_id": 1785,
    "vorder": 33,
    "position": 0,
    "text": "کنون بر گل و نار و سیب و بهی"
  },
  {
    "poem_id": 1785,
    "vorder": 34,
    "position": 1,
    "text": "ز می جام زرین ندارم تهی"
  },
  {
    "poem_id": 1785,
    "vorder": 35,
    "position": 0,
    "text": "چو بینم رخ سیب بیجاده رنگ"
  },
  {
    "poem_id": 1785,
    "vorder": 36,
    "position": 1,
    "text": "شود آسمان همچو پشت پلنگ"
  },
  {
    "poem_id": 1785,
    "vorder": 37,
    "position": 0,
    "text": "برومند و بویا بهاری بود"
  },
  {
    "poem_id": 1785,
    "vorder": 38,
    "position": 1,
    "text": "می سرخ چون غمگساری بود"
  },
  {
    "poem_id": 1785,
    "vorder": 39,
    "position": 0,
    "text": "هوا راست گردد نه گرم و نه سرد"
  },
  {
    "poem_id": 1785,
    "vorder": 40,
    "position": 1,
    "text": "زمین سبزه و آبها لاژورد"
  },
  {
    "poem_id": 1785,
    "vorder": 41,
    "position": 0,
    "text": "چو با مهرگانی بپوشیم خز"
  },
  {
    "poem_id": 1785,
    "vorder": 42,
    "position": 1,
    "text": "به نخچیر باید شدن سوی جز"
  },
  {
    "poem_id": 1785,
    "vorder": 43,
    "position": 0,
    "text": "بدان دشت نخچیر کاری کنیم"
  },
  {
    "poem_id": 1785,
    "vorder": 44,
    "position": 1,
    "text": "که اندر جهان یادگاری کنیم"
  },
  {
    "poem_id": 1785,
    "vorder": 45,
    "position": 0,
    "text": "کنون گردن گور گردد سبتر"
  },
  {
    "poem_id": 1785,
    "vorder": 46,
    "position": 1,
    "text": "دل شیر نر گیرد و رنگ ببر"
  },
  {
    "poem_id": 1785,
    "vorder": 47,
    "position": 0,
    "text": "سگ و یوز با چرغ و شاهین و باز"
  },
  {
    "poem_id": 1785,
    "vorder": 48,
    "position": 1,
    "text": "نباید کشیدن به راه دراز"
  },
  {
    "poem_id": 1785,
    "vorder": 49,
    "position": 0,
    "text": "که آن جای گرزست و تیر و کمان"
  },
  {
    "poem_id": 1785,
    "vorder": 50,
    "position": 1,
    "text": "نباشیم بی‌تاختن یک زمان"
  },
  {
    "poem_id": 1785,
    "vorder": 51,
    "position": 0,
    "text": "بیابان که من دیده‌ام زیر جز"
  },
  {
    "poem_id": 1785,
    "vorder": 52,
    "position": 1,
    "text": "شده چون بن نیزه بالای گز"
  },
  {
    "poem_id": 1785,
    "vorder": 53,
    "position": 0,
    "text": "بران جایگه نیز یابیم شیر"
  },
  {
    "poem_id": 1785,
    "vorder": 54,
    "position": 1,
    "text": "شکاری بود گر بمانیم دیر"
  },
  {
    "poem_id": 1785,
    "vorder": 55,
    "position": 0,
    "text": "همی بود تا ابر شهریوری"
  },
  {
    "poem_id": 1785,
    "vorder": 56,
    "position": 1,
    "text": "برآمد جهان شد پر از لشکری"
  },
  {
    "poem_id": 1785,
    "vorder": 57,
    "position": 0,
    "text": "ز هر گوشه‌ای لشکری جنگجوی"
  },
  {
    "poem_id": 1785,
    "vorder": 58,
    "position": 1,
    "text": "سوی شاه ایران نهادند روی"
  },
  {
    "poem_id": 1785,
    "vorder": 59,
    "position": 0,
    "text": "ازیشان گزین کرد گردنکشان"
  },
  {
    "poem_id": 1785,
    "vorder": 60,
    "position": 1,
    "text": "کسی کو ز نخچیر دارد نشان"
  },
  {
    "poem_id": 1785,
    "vorder": 61,
    "position": 0,
    "text": "بیاورد لشکر به دشت شکار"
  },
  {
    "poem_id": 1785,
    "vorder": 62,
    "position": 1,
    "text": "سواران شمشیر زن ده هزار"
  },
  {
    "poem_id": 1785,
    "vorder": 63,
    "position": 0,
    "text": "ببردند خرگاه و پرده‌سرای"
  },
  {
    "poem_id": 1785,
    "vorder": 64,
    "position": 1,
    "text": "همان خیمه و آخر و چارپای"
  },
  {
    "poem_id": 1785,
    "vorder": 65,
    "position": 0,
    "text": "همه زیردستان به پیش سپاه"
  },
  {
    "poem_id": 1785,
    "vorder": 66,
    "position": 1,
    "text": "برفتند هرجای کندند چاه"
  },
  {
    "poem_id": 1785,
    "vorder": 67,
    "position": 0,
    "text": "بدان تا نهند از بر چاه چرخ"
  },
  {
    "poem_id": 1785,
    "vorder": 68,
    "position": 1,
    "text": "کنند از بر چرخ چینی سطرخ"
  },
  {
    "poem_id": 1785,
    "vorder": 69,
    "position": 0,
    "text": "پس لشکر اندر همی تاخت شاه"
  },
  {
    "poem_id": 1785,
    "vorder": 70,
    "position": 1,
    "text": "خود و ویژگان تا به نخچیرگاه"
  },
  {
    "poem_id": 1785,
    "vorder": 71,
    "position": 0,
    "text": "بیابان سراسر پر از گور دید"
  },
  {
    "poem_id": 1785,
    "vorder": 72,
    "position": 1,
    "text": "همه بیشه از شیر پرشور دید"
  },
  {
    "poem_id": 1785,
    "vorder": 73,
    "position": 0,
    "text": "چنین گفت کاینجا شکار منست"
  },
  {
    "poem_id": 1785,
    "vorder": 74,
    "position": 1,
    "text": "که از شیر بر خاک چندین تنست"
  },
  {
    "poem_id": 1785,
    "vorder": 75,
    "position": 0,
    "text": "بخسپید شادان‌دل و تن‌درست"
  },
  {
    "poem_id": 1785,
    "vorder": 76,
    "position": 1,
    "text": "که فردا بباید مرا شیر جست"
  },
  {
    "poem_id": 1785,
    "vorder": 77,
    "position": 0,
    "text": "کنون میگساریم تا چاک روز"
  },
  {
    "poem_id": 1785,
    "vorder": 78,
    "position": 1,
    "text": "چو رخشان شود هور گیتی فروز"
  },
  {
    "poem_id": 1785,
    "vorder": 79,
    "position": 0,
    "text": "نخستین به شمشیر شیر افگنیم"
  },
  {
    "poem_id": 1785,
    "vorder": 80,
    "position": 1,
    "text": "همان اژدهای دلیر افگنیم"
  },
  {
    "poem_id": 1785,
    "vorder": 81,
    "position": 0,
    "text": "چو این بیشه از شیر گردد تهی"
  },
  {
    "poem_id": 1785,
    "vorder": 82,
    "position": 1,
    "text": "خدنگ مرا گور گردد رهی"
  },
  {
    "poem_id": 1785,
    "vorder": 83,
    "position": 0,
    "text": "ببود آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1785,
    "vorder": 84,
    "position": 1,
    "text": "سوی بیشه رفتند شاه و سپاه"
  },
  {
    "poem_id": 1785,
    "vorder": 85,
    "position": 0,
    "text": "هم‌انگاه بیرون خرامید شیر"
  },
  {
    "poem_id": 1785,
    "vorder": 86,
    "position": 1,
    "text": "دلاور شده خورده از گور سیر"
  },
  {
    "poem_id": 1785,
    "vorder": 87,
    "position": 0,
    "text": "به یاران چنین گفت بهرام گرد"
  },
  {
    "poem_id": 1785,
    "vorder": 88,
    "position": 1,
    "text": "که تیر و کمان دارم و دست برد"
  },
  {
    "poem_id": 1785,
    "vorder": 89,
    "position": 0,
    "text": "ولیکن به شمشیر یازم به شیر"
  },
  {
    "poem_id": 1785,
    "vorder": 90,
    "position": 1,
    "text": "بدان تا نخواند مرا نادلیر"
  },
  {
    "poem_id": 1785,
    "vorder": 91,
    "position": 0,
    "text": "بپوشید تر کرده پشمین قبای"
  },
  {
    "poem_id": 1785,
    "vorder": 92,
    "position": 1,
    "text": "به اسپ نبرد اندر آورد پای"
  },
  {
    "poem_id": 1785,
    "vorder": 93,
    "position": 0,
    "text": "چو شیر اژدها دید بر پای خاست"
  },
  {
    "poem_id": 1785,
    "vorder": 94,
    "position": 1,
    "text": "ز بالا دو دست اندر آورد راست"
  },
  {
    "poem_id": 1785,
    "vorder": 95,
    "position": 0,
    "text": "همی خواست زد بر سر اسپ اوی"
  },
  {
    "poem_id": 1785,
    "vorder": 96,
    "position": 1,
    "text": "بزد پاشنه مرد نخچیر جوی"
  },
  {
    "poem_id": 1785,
    "vorder": 97,
    "position": 0,
    "text": "بزد بر سر شیر شمشیر تیز"
  },
  {
    "poem_id": 1785,
    "vorder": 98,
    "position": 1,
    "text": "سبک جفت او جست راه گریز"
  },
  {
    "poem_id": 1785,
    "vorder": 99,
    "position": 0,
    "text": "ز سر تا میانش بدونیم کرد"
  },
  {
    "poem_id": 1785,
    "vorder": 100,
    "position": 1,
    "text": "دل نره شیران پر از بیم کرد"
  },
  {
    "poem_id": 1785,
    "vorder": 101,
    "position": 0,
    "text": "بیامد دگر شیر غران دلیر"
  },
  {
    "poem_id": 1785,
    "vorder": 102,
    "position": 1,
    "text": "همی جفت او بچه پرورد زیر"
  },
  {
    "poem_id": 1785,
    "vorder": 103,
    "position": 0,
    "text": "بزد خنجری تیز بر گردنش"
  },
  {
    "poem_id": 1785,
    "vorder": 104,
    "position": 1,
    "text": "سر شیر نر کنده شد از تنش"
  },
  {
    "poem_id": 1785,
    "vorder": 105,
    "position": 0,
    "text": "یکی گفت کای شاه خورشید چهر"
  },
  {
    "poem_id": 1785,
    "vorder": 106,
    "position": 1,
    "text": "نداری همی بر تن خویش مهر"
  },
  {
    "poem_id": 1785,
    "vorder": 107,
    "position": 0,
    "text": "همه بیشه شیرند با بچگان"
  },
  {
    "poem_id": 1785,
    "vorder": 108,
    "position": 1,
    "text": "همه بچگان شیر مادر مکان"
  },
  {
    "poem_id": 1785,
    "vorder": 109,
    "position": 0,
    "text": "کنون باید آژیر بودن دلیر"
  },
  {
    "poem_id": 1785,
    "vorder": 110,
    "position": 1,
    "text": "که در مهرگان بچه دارد به زیر"
  },
  {
    "poem_id": 1785,
    "vorder": 111,
    "position": 0,
    "text": "سه فرسنگ بالای این بیشه است"
  },
  {
    "poem_id": 1785,
    "vorder": 112,
    "position": 1,
    "text": "به یک سال اگر شیرگیری به دست"
  },
  {
    "poem_id": 1785,
    "vorder": 113,
    "position": 0,
    "text": "جهان هم نگردد ز شیران تهی"
  },
  {
    "poem_id": 1785,
    "vorder": 114,
    "position": 1,
    "text": "تو چندین چرا رنج بر تن نهی"
  },
  {
    "poem_id": 1785,
    "vorder": 115,
    "position": 0,
    "text": "چو بنشست بر تخت شاه از نخست"
  },
  {
    "poem_id": 1785,
    "vorder": 116,
    "position": 1,
    "text": "به پیمان جز از چنگ شیران نجست"
  },
  {
    "poem_id": 1785,
    "vorder": 117,
    "position": 0,
    "text": "کنون شهریاری به ایران تراست"
  },
  {
    "poem_id": 1785,
    "vorder": 118,
    "position": 1,
    "text": "به گور آمدی جنگ شیران چراست"
  },
  {
    "poem_id": 1785,
    "vorder": 119,
    "position": 0,
    "text": "بدو گفت شاه ای خردمند پیر"
  },
  {
    "poem_id": 1785,
    "vorder": 120,
    "position": 1,
    "text": "به شبگیر فردا من و گور و تیر"
  },
  {
    "poem_id": 1785,
    "vorder": 121,
    "position": 0,
    "text": "سواران گردنکش اندر زمان"
  },
  {
    "poem_id": 1785,
    "vorder": 122,
    "position": 1,
    "text": "نکردند نامی به تیر و کمان"
  },
  {
    "poem_id": 1785,
    "vorder": 123,
    "position": 0,
    "text": "اگر داد مردی بخواهیم داد"
  },
  {
    "poem_id": 1785,
    "vorder": 124,
    "position": 1,
    "text": "به گوپال و شمشیر گیریم یاد"
  },
  {
    "poem_id": 1785,
    "vorder": 125,
    "position": 0,
    "text": "بدو گفت موبد که مرد سوار"
  },
  {
    "poem_id": 1785,
    "vorder": 126,
    "position": 1,
    "text": "نبیند چو تو گرد در کارزار"
  },
  {
    "poem_id": 1785,
    "vorder": 127,
    "position": 0,
    "text": "که چشم بد از فر تو دور باد"
  },
  {
    "poem_id": 1785,
    "vorder": 128,
    "position": 1,
    "text": "نشست تو در گلشن و سور باد"
  },
  {
    "poem_id": 1785,
    "vorder": 129,
    "position": 0,
    "text": "به پرده‌سرای آمد از بیشه شاه"
  },
  {
    "poem_id": 1785,
    "vorder": 130,
    "position": 1,
    "text": "ابا موبد و پهلوان سپاه"
  },
  {
    "poem_id": 1785,
    "vorder": 131,
    "position": 0,
    "text": "همی خواند لشکر برو آفرین"
  },
  {
    "poem_id": 1785,
    "vorder": 132,
    "position": 1,
    "text": "که بی‌تو مبادا کلاه و نگین"
  },
  {
    "poem_id": 1785,
    "vorder": 133,
    "position": 0,
    "text": "به خرگاه شد چون سپه بازگشت"
  },
  {
    "poem_id": 1785,
    "vorder": 134,
    "position": 1,
    "text": "ز دادنش گیتی پرآواز گشت"
  },
  {
    "poem_id": 1785,
    "vorder": 135,
    "position": 0,
    "text": "یکی دانشی مرزبان پیش‌کار"
  },
  {
    "poem_id": 1785,
    "vorder": 136,
    "position": 1,
    "text": "به خرگاه نو بر پراگنده خار"
  },
  {
    "poem_id": 1785,
    "vorder": 137,
    "position": 0,
    "text": "نهادند کافور و مشک و گلاب"
  },
  {
    "poem_id": 1785,
    "vorder": 138,
    "position": 1,
    "text": "بگسترد مشک از بر جای خواب"
  },
  {
    "poem_id": 1785,
    "vorder": 139,
    "position": 0,
    "text": "همه خیمه‌ها خوان زرین نهاد"
  },
  {
    "poem_id": 1785,
    "vorder": 140,
    "position": 1,
    "text": "برو کاسه آرایش چین نهاد"
  },
  {
    "poem_id": 1785,
    "vorder": 141,
    "position": 0,
    "text": "بیاراست سالار خوان از بره"
  },
  {
    "poem_id": 1785,
    "vorder": 142,
    "position": 1,
    "text": "همه خوردنیها که بد یکسره"
  },
  {
    "poem_id": 1785,
    "vorder": 143,
    "position": 0,
    "text": "چو نان خورده شد شاه بهرام گور"
  },
  {
    "poem_id": 1785,
    "vorder": 144,
    "position": 1,
    "text": "بفرمود جامی بزرگ از بلور"
  },
  {
    "poem_id": 1785,
    "vorder": 145,
    "position": 0,
    "text": "که آرد پری‌چهرهٔ میگسار"
  },
  {
    "poem_id": 1785,
    "vorder": 146,
    "position": 1,
    "text": "نهد بر کف دادگر شهریار"
  },
  {
    "poem_id": 1785,
    "vorder": 147,
    "position": 0,
    "text": "چنین گفت کان شهریار اردشیر"
  },
  {
    "poem_id": 1785,
    "vorder": 148,
    "position": 1,
    "text": "که برنا شد از بخت او مرد پیر"
  },
  {
    "poem_id": 1785,
    "vorder": 149,
    "position": 0,
    "text": "سر مایه او بود ما کهتریم"
  },
  {
    "poem_id": 1785,
    "vorder": 150,
    "position": 1,
    "text": "اگر کهتری را خود اندر خوریم"
  },
  {
    "poem_id": 1785,
    "vorder": 151,
    "position": 0,
    "text": "به رزم و به بزم و به رای و به خوان"
  },
  {
    "poem_id": 1785,
    "vorder": 152,
    "position": 1,
    "text": "جز او را جهاندار گیتی مخوان"
  },
  {
    "poem_id": 1785,
    "vorder": 153,
    "position": 0,
    "text": "بدانگه که اسکندر آمد ز روم"
  },
  {
    "poem_id": 1785,
    "vorder": 154,
    "position": 1,
    "text": "به ایران و ویران شد این مرز و بوم"
  },
  {
    "poem_id": 1785,
    "vorder": 155,
    "position": 0,
    "text": "کجا ناجوانمرد بود و درشت"
  },
  {
    "poem_id": 1785,
    "vorder": 156,
    "position": 1,
    "text": "چو سی و شش از شهریاران بکشت"
  },
  {
    "poem_id": 1785,
    "vorder": 157,
    "position": 0,
    "text": "لب خسروان پر ز نفرین اوست"
  },
  {
    "poem_id": 1785,
    "vorder": 158,
    "position": 1,
    "text": "همه روی گیتی پر از کین اوست"
  },
  {
    "poem_id": 1785,
    "vorder": 159,
    "position": 0,
    "text": "کجا بر فریدون کنند آفرین"
  },
  {
    "poem_id": 1785,
    "vorder": 160,
    "position": 1,
    "text": "برویست نفرین ز جویای کین"
  },
  {
    "poem_id": 1785,
    "vorder": 161,
    "position": 0,
    "text": "مبادا جز از نیکویی در جهان"
  },
  {
    "poem_id": 1785,
    "vorder": 162,
    "position": 1,
    "text": "ز من در میان کهان و مهان"
  },
  {
    "poem_id": 1785,
    "vorder": 163,
    "position": 0,
    "text": "بیارید گفتا منادیگری"
  },
  {
    "poem_id": 1785,
    "vorder": 164,
    "position": 1,
    "text": "خوش آواز و از نامداران سری"
  },
  {
    "poem_id": 1785,
    "vorder": 165,
    "position": 0,
    "text": "که گردد سراسر به گرد سپاه"
  },
  {
    "poem_id": 1785,
    "vorder": 166,
    "position": 1,
    "text": "همی برخروشد به بی‌راه و راه"
  },
  {
    "poem_id": 1785,
    "vorder": 167,
    "position": 0,
    "text": "بگوید که بر کوی بر شهر جز"
  },
  {
    "poem_id": 1785,
    "vorder": 168,
    "position": 1,
    "text": "گر از گوهر و زر و دیبا و خز"
  },
  {
    "poem_id": 1785,
    "vorder": 169,
    "position": 0,
    "text": "چنین تا به خاشاک ناچیز پست"
  },
  {
    "poem_id": 1785,
    "vorder": 170,
    "position": 1,
    "text": "بیازد کسی ناسزاوار دست"
  },
  {
    "poem_id": 1785,
    "vorder": 171,
    "position": 0,
    "text": "بر اسپش نشانم ز پس کرده روی"
  },
  {
    "poem_id": 1785,
    "vorder": 172,
    "position": 1,
    "text": "ز ایدر کشان با دو پرخاشجوی"
  },
  {
    "poem_id": 1785,
    "vorder": 173,
    "position": 0,
    "text": "دو پایش ببندند در زیر اسپ"
  },
  {
    "poem_id": 1785,
    "vorder": 174,
    "position": 1,
    "text": "فرستمش تا خان آذرگشسپ"
  },
  {
    "poem_id": 1785,
    "vorder": 175,
    "position": 0,
    "text": "نیایش کند پیش آتش به خاک"
  },
  {
    "poem_id": 1785,
    "vorder": 176,
    "position": 1,
    "text": "پرستش کند پیش یزدان پاک"
  },
  {
    "poem_id": 1785,
    "vorder": 177,
    "position": 0,
    "text": "بدان کس دهم چیز او را که چیز"
  },
  {
    "poem_id": 1785,
    "vorder": 178,
    "position": 1,
    "text": "ازو بستد و رنج او دید نیز"
  },
  {
    "poem_id": 1785,
    "vorder": 179,
    "position": 0,
    "text": "وگر اسپ در کشت‌زاری کند"
  },
  {
    "poem_id": 1785,
    "vorder": 180,
    "position": 1,
    "text": "ور آهنگ بر میوه‌داری کند"
  },
  {
    "poem_id": 1785,
    "vorder": 181,
    "position": 0,
    "text": "ز زندان نیابد به سالی رها"
  },
  {
    "poem_id": 1785,
    "vorder": 182,
    "position": 1,
    "text": "سوار سرافراز گر بی‌بها"
  },
  {
    "poem_id": 1785,
    "vorder": 183,
    "position": 0,
    "text": "همان رنج ما بس گزیدست بهر"
  },
  {
    "poem_id": 1785,
    "vorder": 184,
    "position": 1,
    "text": "بیاییم و آزرده گردند شهر"
  },
  {
    "poem_id": 1785,
    "vorder": 185,
    "position": 0,
    "text": "برفتند بازارگانان شهر"
  },
  {
    "poem_id": 1785,
    "vorder": 186,
    "position": 1,
    "text": "ز جز و ز برقوه مردم دو بهر"
  },
  {
    "poem_id": 1785,
    "vorder": 187,
    "position": 0,
    "text": "بیابان چو بازار چین شد ز بار"
  },
  {
    "poem_id": 1785,
    "vorder": 188,
    "position": 1,
    "text": "بران‌سو که بد لشکر شهریار"
  }
]