[
  {
    "poem_id": 1351,
    "vorder": 1,
    "position": 0,
    "text": "چو بگذشت از آن بر فریدون دو هشت"
  },
  {
    "poem_id": 1351,
    "vorder": 2,
    "position": 1,
    "text": "ز البرز کوه اندر آمد به دشت"
  },
  {
    "poem_id": 1351,
    "vorder": 3,
    "position": 0,
    "text": "بر مادر آمد پژوهید و گفت"
  },
  {
    "poem_id": 1351,
    "vorder": 4,
    "position": 1,
    "text": "که بگشای بر من نهان از نهفت"
  },
  {
    "poem_id": 1351,
    "vorder": 5,
    "position": 0,
    "text": "بگو مر مرا تا که بودم پدر؟"
  },
  {
    "poem_id": 1351,
    "vorder": 6,
    "position": 1,
    "text": "کیم من؟ ز تخم کدامین گهر؟"
  },
  {
    "poem_id": 1351,
    "vorder": 7,
    "position": 0,
    "text": "چه گویم کیم بر سر انجمن؟"
  },
  {
    "poem_id": 1351,
    "vorder": 8,
    "position": 1,
    "text": "یکی دانشی داستانم بزن"
  },
  {
    "poem_id": 1351,
    "vorder": 9,
    "position": 0,
    "text": "فرانک بدو گفت کای نامجوی"
  },
  {
    "poem_id": 1351,
    "vorder": 10,
    "position": 1,
    "text": "بگویم تو را هر چه گفتی بگوی"
  },
  {
    "poem_id": 1351,
    "vorder": 11,
    "position": 0,
    "text": "تو بشناس کز مرز ایران زمین"
  },
  {
    "poem_id": 1351,
    "vorder": 12,
    "position": 1,
    "text": "یکی مرد بد نام او آبتین"
  },
  {
    "poem_id": 1351,
    "vorder": 13,
    "position": 0,
    "text": "ز تخم کیان بود و بیدار بود"
  },
  {
    "poem_id": 1351,
    "vorder": 14,
    "position": 1,
    "text": "خردمند و گرد و بی‌آزار بود"
  },
  {
    "poem_id": 1351,
    "vorder": 15,
    "position": 0,
    "text": "ز طهمورث گرد بودش نژاد"
  },
  {
    "poem_id": 1351,
    "vorder": 16,
    "position": 1,
    "text": "پدر بر پدر بر همی داشت یاد"
  },
  {
    "poem_id": 1351,
    "vorder": 17,
    "position": 0,
    "text": "پدر بد تو را و مرا نیک شوی"
  },
  {
    "poem_id": 1351,
    "vorder": 18,
    "position": 1,
    "text": "نبد روز روشن مرا جز بدوی"
  },
  {
    "poem_id": 1351,
    "vorder": 19,
    "position": 0,
    "text": "چنان بد که ضحاک جادوپرست"
  },
  {
    "poem_id": 1351,
    "vorder": 20,
    "position": 1,
    "text": "از ایران به جان تو یازید دست"
  },
  {
    "poem_id": 1351,
    "vorder": 21,
    "position": 0,
    "text": "از او من نهانت همی داشتم"
  },
  {
    "poem_id": 1351,
    "vorder": 22,
    "position": 1,
    "text": "چه مایه به بد روز بگذاشتم"
  },
  {
    "poem_id": 1351,
    "vorder": 23,
    "position": 0,
    "text": "پدرت آن گرانمایه مرد جوان"
  },
  {
    "poem_id": 1351,
    "vorder": 24,
    "position": 1,
    "text": "فدی کرده پیش تو روشن روان"
  },
  {
    "poem_id": 1351,
    "vorder": 25,
    "position": 0,
    "text": "ابر کتف ضحاک جادو دو مار"
  },
  {
    "poem_id": 1351,
    "vorder": 26,
    "position": 1,
    "text": "برست و برآورد از ایران دمار"
  },
  {
    "poem_id": 1351,
    "vorder": 27,
    "position": 0,
    "text": "سر بابت از مغز پرداختند"
  },
  {
    "poem_id": 1351,
    "vorder": 28,
    "position": 1,
    "text": "همان اژدها را خورش ساختند"
  },
  {
    "poem_id": 1351,
    "vorder": 29,
    "position": 0,
    "text": "سرانجام رفتم سوی بیشه‌ای"
  },
  {
    "poem_id": 1351,
    "vorder": 30,
    "position": 1,
    "text": "که کس را نه زآن بیشه اندیشه‌ای"
  },
  {
    "poem_id": 1351,
    "vorder": 31,
    "position": 0,
    "text": "یکی گاو دیدم چو خرم بهار"
  },
  {
    "poem_id": 1351,
    "vorder": 32,
    "position": 1,
    "text": "سراپای نیرنگ و رنگ و نگار"
  },
  {
    "poem_id": 1351,
    "vorder": 33,
    "position": 0,
    "text": "نگهبان او‌، پای کرده به‌کش"
  },
  {
    "poem_id": 1351,
    "vorder": 34,
    "position": 1,
    "text": "نشسته به بیشه درون شاه‌فش"
  },
  {
    "poem_id": 1351,
    "vorder": 35,
    "position": 0,
    "text": "بدو دادمت روزگاری دراز"
  },
  {
    "poem_id": 1351,
    "vorder": 36,
    "position": 1,
    "text": "همی پروردیدت به بر بر به ناز"
  },
  {
    "poem_id": 1351,
    "vorder": 37,
    "position": 0,
    "text": "ز پستان آن گاو طاووس رنگ"
  },
  {
    "poem_id": 1351,
    "vorder": 38,
    "position": 1,
    "text": "برافراختی چون دلاور پلنگ"
  },
  {
    "poem_id": 1351,
    "vorder": 39,
    "position": 0,
    "text": "سرانجام زآن گاو و آن مرغزار"
  },
  {
    "poem_id": 1351,
    "vorder": 40,
    "position": 1,
    "text": "یکایک خبر شد سوی شهریار"
  },
  {
    "poem_id": 1351,
    "vorder": 41,
    "position": 0,
    "text": "ز بیشه ببردم تو را ناگهان"
  },
  {
    "poem_id": 1351,
    "vorder": 42,
    "position": 1,
    "text": "گریزنده ز ایوان و از خان و مان"
  },
  {
    "poem_id": 1351,
    "vorder": 43,
    "position": 0,
    "text": "بیامد بکشت آن گرانمایه را"
  },
  {
    "poem_id": 1351,
    "vorder": 44,
    "position": 1,
    "text": "چنان بی‌زبان مهربان دایه را"
  },
  {
    "poem_id": 1351,
    "vorder": 45,
    "position": 0,
    "text": "وز ایوان ما تا به خورشید خاک"
  },
  {
    "poem_id": 1351,
    "vorder": 46,
    "position": 1,
    "text": "برآورد و کرد آن بلندی مغاک"
  },
  {
    "poem_id": 1351,
    "vorder": 47,
    "position": 0,
    "text": "فریدون چو بشنید بگشاد گوش"
  },
  {
    "poem_id": 1351,
    "vorder": 48,
    "position": 1,
    "text": "ز گفتار مادر برآمد به جوش"
  },
  {
    "poem_id": 1351,
    "vorder": 49,
    "position": 0,
    "text": "دلش گشت پردرد و سر پر ز کین"
  },
  {
    "poem_id": 1351,
    "vorder": 50,
    "position": 1,
    "text": "به ابرو ز خشم اندر آورد چین"
  },
  {
    "poem_id": 1351,
    "vorder": 51,
    "position": 0,
    "text": "چنین داد پاسخ به مادر که شیر"
  },
  {
    "poem_id": 1351,
    "vorder": 52,
    "position": 1,
    "text": "نگردد مگر ز آزمایش دلیر"
  },
  {
    "poem_id": 1351,
    "vorder": 53,
    "position": 0,
    "text": "کنون کردنی کرد جادوپرست"
  },
  {
    "poem_id": 1351,
    "vorder": 54,
    "position": 1,
    "text": "مرا برد باید به شمشیر دست"
  },
  {
    "poem_id": 1351,
    "vorder": 55,
    "position": 0,
    "text": "بپویم به فرمان یزدان پاک"
  },
  {
    "poem_id": 1351,
    "vorder": 56,
    "position": 1,
    "text": "برآرم ز ایوان ضحاک خاک"
  },
  {
    "poem_id": 1351,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت مادر که این رای نیست"
  },
  {
    "poem_id": 1351,
    "vorder": 58,
    "position": 1,
    "text": "تو را با جهان سر به سر پای نیست"
  },
  {
    "poem_id": 1351,
    "vorder": 59,
    "position": 0,
    "text": "جهاندار ضحاک با تاج و گاه"
  },
  {
    "poem_id": 1351,
    "vorder": 60,
    "position": 1,
    "text": "میان بسته فرمان او را سپاه"
  },
  {
    "poem_id": 1351,
    "vorder": 61,
    "position": 0,
    "text": "چو خواهد ز هر کشوری صدهزار"
  },
  {
    "poem_id": 1351,
    "vorder": 62,
    "position": 1,
    "text": "کمر بسته او را کند کارزار"
  },
  {
    "poem_id": 1351,
    "vorder": 63,
    "position": 0,
    "text": "جز این است آیین پیوند و کین"
  },
  {
    "poem_id": 1351,
    "vorder": 64,
    "position": 1,
    "text": "جهان را به چشم جوانی مبین"
  },
  {
    "poem_id": 1351,
    "vorder": 65,
    "position": 0,
    "text": "که هر کاو نبید جوانی چشید"
  },
  {
    "poem_id": 1351,
    "vorder": 66,
    "position": 1,
    "text": "به گیتی جز از خویشتن را ندید"
  },
  {
    "poem_id": 1351,
    "vorder": 67,
    "position": 0,
    "text": "بدان مستی اندر دهد سر بباد"
  },
  {
    "poem_id": 1351,
    "vorder": 68,
    "position": 1,
    "text": "تو را روز جز شاد و خرم مباد"
  }
]