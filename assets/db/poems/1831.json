[
  {
    "poem_id": 1831,
    "vorder": 1,
    "position": 0,
    "text": "شنیدم کجا کسری شهریار"
  },
  {
    "poem_id": 1831,
    "vorder": 2,
    "position": 1,
    "text": "به هرمز یکی نامه کرد استوار"
  },
  {
    "poem_id": 1831,
    "vorder": 3,
    "position": 0,
    "text": "ز شاه جهاندار خورشید دهر"
  },
  {
    "poem_id": 1831,
    "vorder": 4,
    "position": 1,
    "text": "مهست و سرافراز و گیرنده شهر"
  },
  {
    "poem_id": 1831,
    "vorder": 5,
    "position": 0,
    "text": "جهاندار بیدار و نیکو کنش"
  },
  {
    "poem_id": 1831,
    "vorder": 6,
    "position": 1,
    "text": "فشاننده گنج بی سرزنش"
  },
  {
    "poem_id": 1831,
    "vorder": 7,
    "position": 0,
    "text": "فزاینده نام و تخت قباد"
  },
  {
    "poem_id": 1831,
    "vorder": 8,
    "position": 1,
    "text": "گراینده تاج و شمشیر و داد"
  },
  {
    "poem_id": 1831,
    "vorder": 9,
    "position": 0,
    "text": "که با فر و برز‌ست و فرهنگ و نام"
  },
  {
    "poem_id": 1831,
    "vorder": 10,
    "position": 1,
    "text": "ز تاج بزرگی رسیده به کام"
  },
  {
    "poem_id": 1831,
    "vorder": 11,
    "position": 0,
    "text": "سوی پاک هرمزد فرزند ما"
  },
  {
    "poem_id": 1831,
    "vorder": 12,
    "position": 1,
    "text": "پذیرفته از دل همی پند ما"
  },
  {
    "poem_id": 1831,
    "vorder": 13,
    "position": 0,
    "text": "ز یزدان بدی شاد و پیروز بخت"
  },
  {
    "poem_id": 1831,
    "vorder": 14,
    "position": 1,
    "text": "همیشه جهاندار با تاج و تخت"
  },
  {
    "poem_id": 1831,
    "vorder": 15,
    "position": 0,
    "text": "به ماه خجسته به خرداد روز"
  },
  {
    "poem_id": 1831,
    "vorder": 16,
    "position": 1,
    "text": "به نیک اختر و فال گیتی‌فروز"
  },
  {
    "poem_id": 1831,
    "vorder": 17,
    "position": 0,
    "text": "نهادیم بر سر تو را تاج زر"
  },
  {
    "poem_id": 1831,
    "vorder": 18,
    "position": 1,
    "text": "چنان هم که ما یافتیم از پدر"
  },
  {
    "poem_id": 1831,
    "vorder": 19,
    "position": 0,
    "text": "همان آفرین نیز کردیم یاد"
  },
  {
    "poem_id": 1831,
    "vorder": 20,
    "position": 1,
    "text": "که بر تاج ما کرد فرخ قباد"
  },
  {
    "poem_id": 1831,
    "vorder": 21,
    "position": 0,
    "text": "تو بیدار باش و جهاندار باش"
  },
  {
    "poem_id": 1831,
    "vorder": 22,
    "position": 1,
    "text": "خردمند و راد و بی‌آزار باش"
  },
  {
    "poem_id": 1831,
    "vorder": 23,
    "position": 0,
    "text": "به دانش فزای و به یزدان گرای"
  },
  {
    "poem_id": 1831,
    "vorder": 24,
    "position": 1,
    "text": "که اوی‌ست جان تو را رهنمای"
  },
  {
    "poem_id": 1831,
    "vorder": 25,
    "position": 0,
    "text": "بپرسیدم از مرد نیکو‌سخن"
  },
  {
    "poem_id": 1831,
    "vorder": 26,
    "position": 1,
    "text": "کسی کاو به سال و خرَد بُد کهن"
  },
  {
    "poem_id": 1831,
    "vorder": 27,
    "position": 0,
    "text": "که از ما به یزدان که نزدیک‌تر‌؟"
  },
  {
    "poem_id": 1831,
    "vorder": 28,
    "position": 1,
    "text": "که‌را نزد او راه باریک‌تر‌؟"
  },
  {
    "poem_id": 1831,
    "vorder": 29,
    "position": 0,
    "text": "چنین داد پاسخ که دانش گزین"
  },
  {
    "poem_id": 1831,
    "vorder": 30,
    "position": 1,
    "text": "چو خواهی ز پروردگار آفرین"
  },
  {
    "poem_id": 1831,
    "vorder": 31,
    "position": 0,
    "text": "که نادان فزونی ندارد ز خاک"
  },
  {
    "poem_id": 1831,
    "vorder": 32,
    "position": 1,
    "text": "به دانش بسنده کند جان پاک"
  },
  {
    "poem_id": 1831,
    "vorder": 33,
    "position": 0,
    "text": "به دانش بود شاه زیبای‌تخت"
  },
  {
    "poem_id": 1831,
    "vorder": 34,
    "position": 1,
    "text": "که داننده بادی و پیروزبخت"
  },
  {
    "poem_id": 1831,
    "vorder": 35,
    "position": 0,
    "text": "مبادا که گردی تو پیمان‌شکن"
  },
  {
    "poem_id": 1831,
    "vorder": 36,
    "position": 1,
    "text": "که خاک است پیمان‌شکن را کفن"
  },
  {
    "poem_id": 1831,
    "vorder": 37,
    "position": 0,
    "text": "به باد‌افره ِ بی‌گناهان مکوش"
  },
  {
    "poem_id": 1831,
    "vorder": 38,
    "position": 1,
    "text": "به گفتار ِ بدگوی مسپار گوش"
  },
  {
    "poem_id": 1831,
    "vorder": 39,
    "position": 0,
    "text": "به هر کار فرمان مکن جز به‌داد"
  },
  {
    "poem_id": 1831,
    "vorder": 40,
    "position": 1,
    "text": "که از داد باشد روان تو شاد"
  },
  {
    "poem_id": 1831,
    "vorder": 41,
    "position": 0,
    "text": "زبان را مگردان به‌گِرد دروغ"
  },
  {
    "poem_id": 1831,
    "vorder": 42,
    "position": 1,
    "text": "چو خواهی که تخت تو گیرد فروغ"
  },
  {
    "poem_id": 1831,
    "vorder": 43,
    "position": 0,
    "text": "وگر زیردستی بود گنج‌دار"
  },
  {
    "poem_id": 1831,
    "vorder": 44,
    "position": 1,
    "text": "تو او را ازان گنج بی‌رنج دار"
  },
  {
    "poem_id": 1831,
    "vorder": 45,
    "position": 0,
    "text": "که چیز کسان دشمن گنج تست"
  },
  {
    "poem_id": 1831,
    "vorder": 46,
    "position": 1,
    "text": "بدان گنج شو شاد کز رنج تست"
  },
  {
    "poem_id": 1831,
    "vorder": 47,
    "position": 0,
    "text": "وگر زیردستی شود مایه‌دار"
  },
  {
    "poem_id": 1831,
    "vorder": 48,
    "position": 1,
    "text": "همان شهریارش بود سایه‌دار"
  },
  {
    "poem_id": 1831,
    "vorder": 49,
    "position": 0,
    "text": "همی در پناه تو باید نشست"
  },
  {
    "poem_id": 1831,
    "vorder": 50,
    "position": 1,
    "text": "اگر زیردست است اگر در پرست"
  },
  {
    "poem_id": 1831,
    "vorder": 51,
    "position": 0,
    "text": "چو نیکی کند با تو پاداش کن"
  },
  {
    "poem_id": 1831,
    "vorder": 52,
    "position": 1,
    "text": "ابا دشمن دوست پرخاش کن"
  },
  {
    "poem_id": 1831,
    "vorder": 53,
    "position": 0,
    "text": "وگر گردی اندر جهان ارجمند"
  },
  {
    "poem_id": 1831,
    "vorder": 54,
    "position": 1,
    "text": "ز درد تن اندیش و درد گزند"
  },
  {
    "poem_id": 1831,
    "vorder": 55,
    "position": 0,
    "text": "سرای سپنج است هرچون که هست"
  },
  {
    "poem_id": 1831,
    "vorder": 56,
    "position": 1,
    "text": "بدو اندر ایمن نشاید نشست"
  },
  {
    "poem_id": 1831,
    "vorder": 57,
    "position": 0,
    "text": "هنر جوی با دین و دانش گزین"
  },
  {
    "poem_id": 1831,
    "vorder": 58,
    "position": 1,
    "text": "چو خواهی که یابی ز بخت آفرین"
  },
  {
    "poem_id": 1831,
    "vorder": 59,
    "position": 0,
    "text": "گرامی کن او را که در پیش تو"
  },
  {
    "poem_id": 1831,
    "vorder": 60,
    "position": 1,
    "text": "سپر کرده جان بر بداندیش تو"
  },
  {
    "poem_id": 1831,
    "vorder": 61,
    "position": 0,
    "text": "به دانش دو دست ستیزه ببند"
  },
  {
    "poem_id": 1831,
    "vorder": 62,
    "position": 1,
    "text": "چو خواهی که از بد نیابی گزند"
  },
  {
    "poem_id": 1831,
    "vorder": 63,
    "position": 0,
    "text": "چو بر سر نهی تاج شاهنشهی"
  },
  {
    "poem_id": 1831,
    "vorder": 64,
    "position": 1,
    "text": "ره برتری بازجوی از بهی"
  },
  {
    "poem_id": 1831,
    "vorder": 65,
    "position": 0,
    "text": "همیشه یکی دانشی پیش دار"
  },
  {
    "poem_id": 1831,
    "vorder": 66,
    "position": 1,
    "text": "ورا چون روان و تن خویش دار"
  },
  {
    "poem_id": 1831,
    "vorder": 67,
    "position": 0,
    "text": "بزرگان و بازارگانان شهر"
  },
  {
    "poem_id": 1831,
    "vorder": 68,
    "position": 1,
    "text": "همی داد باید که یابند بهر"
  },
  {
    "poem_id": 1831,
    "vorder": 69,
    "position": 0,
    "text": "کسی کاو ندارد هنر با نژاد"
  },
  {
    "poem_id": 1831,
    "vorder": 70,
    "position": 1,
    "text": "مکن زو به نیز از کم و بیش یاد"
  },
  {
    "poem_id": 1831,
    "vorder": 71,
    "position": 0,
    "text": "مده مرد بی‌نام را ساز جنگ"
  },
  {
    "poem_id": 1831,
    "vorder": 72,
    "position": 1,
    "text": "که چون بازجویی نیاید به چنگ"
  },
  {
    "poem_id": 1831,
    "vorder": 73,
    "position": 0,
    "text": "به دشمن دهد مر تو را دوستدار"
  },
  {
    "poem_id": 1831,
    "vorder": 74,
    "position": 1,
    "text": "دو کار آیدت پیش دشوار و خوار"
  },
  {
    "poem_id": 1831,
    "vorder": 75,
    "position": 0,
    "text": "سلیح تو در کارزار آوَرَد"
  },
  {
    "poem_id": 1831,
    "vorder": 76,
    "position": 1,
    "text": "همان بر تو روزی به کار آورد"
  },
  {
    "poem_id": 1831,
    "vorder": 77,
    "position": 0,
    "text": "ببخشای بر مردم مستمند"
  },
  {
    "poem_id": 1831,
    "vorder": 78,
    "position": 1,
    "text": "ز بد دور باش و بترس از گزند"
  },
  {
    "poem_id": 1831,
    "vorder": 79,
    "position": 0,
    "text": "همیشه نهان دل خویش جوی"
  },
  {
    "poem_id": 1831,
    "vorder": 80,
    "position": 1,
    "text": "مکن رادی و داد هرگز به روی"
  },
  {
    "poem_id": 1831,
    "vorder": 81,
    "position": 0,
    "text": "همان نیز نیکی به اندازه کن"
  },
  {
    "poem_id": 1831,
    "vorder": 82,
    "position": 1,
    "text": "ز مرد جهاندیده بشنو سخن"
  },
  {
    "poem_id": 1831,
    "vorder": 83,
    "position": 0,
    "text": "به دنیا گرای و به دین دار چشم"
  },
  {
    "poem_id": 1831,
    "vorder": 84,
    "position": 1,
    "text": "که از دین بود مرد را رشک و خشم"
  },
  {
    "poem_id": 1831,
    "vorder": 85,
    "position": 0,
    "text": "هزینه به اندازهٔ گنج کن"
  },
  {
    "poem_id": 1831,
    "vorder": 86,
    "position": 1,
    "text": "دل از بیشی گنج بی‌رنج کن"
  },
  {
    "poem_id": 1831,
    "vorder": 87,
    "position": 0,
    "text": "به کردار شاهان پیشین نگر"
  },
  {
    "poem_id": 1831,
    "vorder": 88,
    "position": 1,
    "text": "نباید که باشی مگر دادگر"
  },
  {
    "poem_id": 1831,
    "vorder": 89,
    "position": 0,
    "text": "که نفرین بود بهر بیداد شاه"
  },
  {
    "poem_id": 1831,
    "vorder": 90,
    "position": 1,
    "text": "تو جز داد مپسند و نفرین مخواه"
  },
  {
    "poem_id": 1831,
    "vorder": 91,
    "position": 0,
    "text": "کجا آن سر و تاج شاهنشهان‌؟"
  },
  {
    "poem_id": 1831,
    "vorder": 92,
    "position": 1,
    "text": "کجا آن بزرگان و فرخ مهان‌؟"
  },
  {
    "poem_id": 1831,
    "vorder": 93,
    "position": 0,
    "text": "از ایشان سخن یادگارست و بس"
  },
  {
    "poem_id": 1831,
    "vorder": 94,
    "position": 1,
    "text": "سرای سپنجی نماند به کس"
  },
  {
    "poem_id": 1831,
    "vorder": 95,
    "position": 0,
    "text": "گزافه مفرمانی خون ریختن"
  },
  {
    "poem_id": 1831,
    "vorder": 96,
    "position": 1,
    "text": "وگر جنگ را لشکر انگیختن"
  },
  {
    "poem_id": 1831,
    "vorder": 97,
    "position": 0,
    "text": "نگه کن بدین نامه پندمند"
  },
  {
    "poem_id": 1831,
    "vorder": 98,
    "position": 1,
    "text": "دل اندر سرای سپنجی مبند"
  },
  {
    "poem_id": 1831,
    "vorder": 99,
    "position": 0,
    "text": "به دین من تو را نیکویی خواستم"
  },
  {
    "poem_id": 1831,
    "vorder": 100,
    "position": 1,
    "text": "به دانش دلت را بیاراستم"
  },
  {
    "poem_id": 1831,
    "vorder": 101,
    "position": 0,
    "text": "به راه خداوند خورشید و ماه"
  },
  {
    "poem_id": 1831,
    "vorder": 102,
    "position": 1,
    "text": "ز بن دور کن دیو را دستگاه"
  },
  {
    "poem_id": 1831,
    "vorder": 103,
    "position": 0,
    "text": "به روز و شب این نامه را پیش دار"
  },
  {
    "poem_id": 1831,
    "vorder": 104,
    "position": 1,
    "text": "خرد را به دل داور خویش دار"
  },
  {
    "poem_id": 1831,
    "vorder": 105,
    "position": 0,
    "text": "اگر یادگاری کنی در جهان"
  },
  {
    "poem_id": 1831,
    "vorder": 106,
    "position": 1,
    "text": "که نام بزرگی نگردد نهان"
  },
  {
    "poem_id": 1831,
    "vorder": 107,
    "position": 0,
    "text": "خداوند گیتی پناه ِ تو باد"
  },
  {
    "poem_id": 1831,
    "vorder": 108,
    "position": 1,
    "text": "زمان و زمین نیک‌خواه تو باد"
  },
  {
    "poem_id": 1831,
    "vorder": 109,
    "position": 0,
    "text": "به کام تو گردنده چرخ بلند"
  },
  {
    "poem_id": 1831,
    "vorder": 110,
    "position": 1,
    "text": "ز کردار بد دور و دور از گزند"
  },
  {
    "poem_id": 1831,
    "vorder": 111,
    "position": 0,
    "text": "شهنشاه کاو داد دارد خرد"
  },
  {
    "poem_id": 1831,
    "vorder": 112,
    "position": 1,
    "text": "بکوشد که با شرم گرد آورد"
  },
  {
    "poem_id": 1831,
    "vorder": 113,
    "position": 0,
    "text": "دلیری به رزم اندرون زور دست"
  },
  {
    "poem_id": 1831,
    "vorder": 114,
    "position": 1,
    "text": "بود پاکدینی و یزدان‌پرست"
  },
  {
    "poem_id": 1831,
    "vorder": 115,
    "position": 0,
    "text": "به گیتی نگر کاین هنرها کراست"
  },
  {
    "poem_id": 1831,
    "vorder": 116,
    "position": 1,
    "text": "چو دیدی‌، ستایش مر او را سزاست"
  },
  {
    "poem_id": 1831,
    "vorder": 117,
    "position": 0,
    "text": "مجوی آنک چون مشتری روشن است"
  },
  {
    "poem_id": 1831,
    "vorder": 118,
    "position": 1,
    "text": "جهان‌جوی و با تیغ و با جوشن است"
  },
  {
    "poem_id": 1831,
    "vorder": 119,
    "position": 0,
    "text": "جهان بستد از مردم بت پرست"
  },
  {
    "poem_id": 1831,
    "vorder": 120,
    "position": 1,
    "text": "ز دیبای دین بر دل آیین ببست"
  },
  {
    "poem_id": 1831,
    "vorder": 121,
    "position": 0,
    "text": "کنو لاجرم جود موجود گشت"
  },
  {
    "poem_id": 1831,
    "vorder": 122,
    "position": 1,
    "text": "چو شاه جهان شاه محمود گشت"
  },
  {
    "poem_id": 1831,
    "vorder": 123,
    "position": 0,
    "text": "اگر بزم جوید همی گر نبرد"
  },
  {
    "poem_id": 1831,
    "vorder": 124,
    "position": 1,
    "text": "جهان‌بخش را این بود کار کرد"
  },
  {
    "poem_id": 1831,
    "vorder": 125,
    "position": 0,
    "text": "ابوالقاسم آن شاه پیروز و داد"
  },
  {
    "poem_id": 1831,
    "vorder": 126,
    "position": 1,
    "text": "زمانه به دیدار او شاد باد"
  }
]