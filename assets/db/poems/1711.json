[
  {
    "poem_id": 1711,
    "vorder": 1,
    "position": 0,
    "text": "چو هنگامه زادن آمد فراز"
  },
  {
    "poem_id": 1711,
    "vorder": 2,
    "position": 1,
    "text": "ازان کار بر باد نگشاد راز"
  },
  {
    "poem_id": 1711,
    "vorder": 3,
    "position": 0,
    "text": "پسر زاد پس دختر اردوان"
  },
  {
    "poem_id": 1711,
    "vorder": 4,
    "position": 1,
    "text": "یکی خسروآیین و روشن‌روان"
  },
  {
    "poem_id": 1711,
    "vorder": 5,
    "position": 0,
    "text": "از ایوان خویش انجمن دور کرد"
  },
  {
    "poem_id": 1711,
    "vorder": 6,
    "position": 1,
    "text": "ورا نام دستور شاپور کرد"
  },
  {
    "poem_id": 1711,
    "vorder": 7,
    "position": 0,
    "text": "نهانش همی داشت تا هفت سال"
  },
  {
    "poem_id": 1711,
    "vorder": 8,
    "position": 1,
    "text": "یکی شاه نو گشت با فر و یال"
  },
  {
    "poem_id": 1711,
    "vorder": 9,
    "position": 0,
    "text": "چنان بد که روزی بیامد وزیر"
  },
  {
    "poem_id": 1711,
    "vorder": 10,
    "position": 1,
    "text": "بدید آب در چهرهٔ اردشیر"
  },
  {
    "poem_id": 1711,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت شاها انوشه بدی"
  },
  {
    "poem_id": 1711,
    "vorder": 12,
    "position": 1,
    "text": "روان را به اندیشه توشه بدی"
  },
  {
    "poem_id": 1711,
    "vorder": 13,
    "position": 0,
    "text": "ز گیتی همه کام دل یافتی"
  },
  {
    "poem_id": 1711,
    "vorder": 14,
    "position": 1,
    "text": "سر دشمن از تخت برتافتی"
  },
  {
    "poem_id": 1711,
    "vorder": 15,
    "position": 0,
    "text": "کنون گاه شادی و می خوردنست"
  },
  {
    "poem_id": 1711,
    "vorder": 16,
    "position": 1,
    "text": "نه هنگام اندیشه‌ها کردنست"
  },
  {
    "poem_id": 1711,
    "vorder": 17,
    "position": 0,
    "text": "زمین هفت کشور سراسر تراست"
  },
  {
    "poem_id": 1711,
    "vorder": 18,
    "position": 1,
    "text": "جهان یکسر از داد تو گشت راست"
  },
  {
    "poem_id": 1711,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ ورا شهریار"
  },
  {
    "poem_id": 1711,
    "vorder": 20,
    "position": 1,
    "text": "که ای پاک‌دل موبد رازدار"
  },
  {
    "poem_id": 1711,
    "vorder": 21,
    "position": 0,
    "text": "زمانه به شمشیر ما راست گشت"
  },
  {
    "poem_id": 1711,
    "vorder": 22,
    "position": 1,
    "text": "غم و رنج و ناخوبی اندر گذشت"
  },
  {
    "poem_id": 1711,
    "vorder": 23,
    "position": 0,
    "text": "مرا سال بر پنجه و یک رسید"
  },
  {
    "poem_id": 1711,
    "vorder": 24,
    "position": 1,
    "text": "ز کافور شد مشک و گل ناپدید"
  },
  {
    "poem_id": 1711,
    "vorder": 25,
    "position": 0,
    "text": "پسر بایدی پیشم اکنون به پای"
  },
  {
    "poem_id": 1711,
    "vorder": 26,
    "position": 1,
    "text": "دلارای و نیروده و رهنمای"
  },
  {
    "poem_id": 1711,
    "vorder": 27,
    "position": 0,
    "text": "پدر بی‌پسر چون پسر بی‌پدر"
  },
  {
    "poem_id": 1711,
    "vorder": 28,
    "position": 1,
    "text": "که بیگانه او را نگیرد به بر"
  },
  {
    "poem_id": 1711,
    "vorder": 29,
    "position": 0,
    "text": "پس از من بدشمن رسد تاج و گنج"
  },
  {
    "poem_id": 1711,
    "vorder": 30,
    "position": 1,
    "text": "مرا خاک سود آید و درد و رنج"
  },
  {
    "poem_id": 1711,
    "vorder": 31,
    "position": 0,
    "text": "به دل گفت بیدار مرد کهن"
  },
  {
    "poem_id": 1711,
    "vorder": 32,
    "position": 1,
    "text": "که آمد کنون روزگار سخن"
  },
  {
    "poem_id": 1711,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت کای شاه کهتر نواز"
  },
  {
    "poem_id": 1711,
    "vorder": 34,
    "position": 1,
    "text": "جوانمرد روشن‌دل و سرفراز"
  },
  {
    "poem_id": 1711,
    "vorder": 35,
    "position": 0,
    "text": "گر ایدونک یابم به جان زینهار"
  },
  {
    "poem_id": 1711,
    "vorder": 36,
    "position": 1,
    "text": "من این رنج بردارم از شهریار"
  },
  {
    "poem_id": 1711,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت شاه ای خردمند مرد"
  },
  {
    "poem_id": 1711,
    "vorder": 38,
    "position": 1,
    "text": "چرا بیم جان ترا رنجه کرد"
  },
  {
    "poem_id": 1711,
    "vorder": 39,
    "position": 0,
    "text": "بگوی آنچ دانی و بفزای نیز"
  },
  {
    "poem_id": 1711,
    "vorder": 40,
    "position": 1,
    "text": "ز گفت خردمند برتر چه چیز"
  },
  {
    "poem_id": 1711,
    "vorder": 41,
    "position": 0,
    "text": "چنین داد پاسخ بدو کدخدای"
  },
  {
    "poem_id": 1711,
    "vorder": 42,
    "position": 1,
    "text": "که ای شاه روشن‌دل و پاک‌رای"
  },
  {
    "poem_id": 1711,
    "vorder": 43,
    "position": 0,
    "text": "یکی حقه بد نزد گنجور شاه"
  },
  {
    "poem_id": 1711,
    "vorder": 44,
    "position": 1,
    "text": "سزد گر بخواهد کنون پیش گاه"
  },
  {
    "poem_id": 1711,
    "vorder": 45,
    "position": 0,
    "text": "به گنجور گفت آنک او زینهار"
  },
  {
    "poem_id": 1711,
    "vorder": 46,
    "position": 1,
    "text": "ترا داد آمد کنون خواستار"
  },
  {
    "poem_id": 1711,
    "vorder": 47,
    "position": 0,
    "text": "بدو بازده تا ببینم که چیست"
  },
  {
    "poem_id": 1711,
    "vorder": 48,
    "position": 1,
    "text": "مگرمان نباید به اندیشه زیست"
  },
  {
    "poem_id": 1711,
    "vorder": 49,
    "position": 0,
    "text": "بیاورد آن حقه گنجور اوی"
  },
  {
    "poem_id": 1711,
    "vorder": 50,
    "position": 1,
    "text": "سپرد آنک بستد ز دستور اوی"
  },
  {
    "poem_id": 1711,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت شاه اندرین حقه چیست"
  },
  {
    "poem_id": 1711,
    "vorder": 52,
    "position": 1,
    "text": "نهاده برین بند بر مهر کیست"
  },
  {
    "poem_id": 1711,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت کان خون گرم منست"
  },
  {
    "poem_id": 1711,
    "vorder": 54,
    "position": 1,
    "text": "بریده ز بن پاک شرم منست"
  },
  {
    "poem_id": 1711,
    "vorder": 55,
    "position": 0,
    "text": "سپردی مرا دختر اردوان"
  },
  {
    "poem_id": 1711,
    "vorder": 56,
    "position": 1,
    "text": "که تا بازخواهی تن بی‌روان"
  },
  {
    "poem_id": 1711,
    "vorder": 57,
    "position": 0,
    "text": "نکشتم که فرزند بد در نهان"
  },
  {
    "poem_id": 1711,
    "vorder": 58,
    "position": 1,
    "text": "بترسیدم از کردگار جهان"
  },
  {
    "poem_id": 1711,
    "vorder": 59,
    "position": 0,
    "text": "بجستم ز فرمانت آزرم خویش"
  },
  {
    "poem_id": 1711,
    "vorder": 60,
    "position": 1,
    "text": "بریدم هم‌اندر زمان شرم خویش"
  },
  {
    "poem_id": 1711,
    "vorder": 61,
    "position": 0,
    "text": "بدان تا کسی بد نگوید مرا"
  },
  {
    "poem_id": 1711,
    "vorder": 62,
    "position": 1,
    "text": "به دریای تهمت نشوید مرا"
  },
  {
    "poem_id": 1711,
    "vorder": 63,
    "position": 0,
    "text": "کنون هفت‌ساله‌ست شاپور تو"
  },
  {
    "poem_id": 1711,
    "vorder": 64,
    "position": 1,
    "text": "که دایم خرد باد دستور تو"
  },
  {
    "poem_id": 1711,
    "vorder": 65,
    "position": 0,
    "text": "چنو نیست فرزند یک شاه را"
  },
  {
    "poem_id": 1711,
    "vorder": 66,
    "position": 1,
    "text": "نماند مگر بر فلک ماه را"
  },
  {
    "poem_id": 1711,
    "vorder": 67,
    "position": 0,
    "text": "ورا نام شاپور کردم ز مهر"
  },
  {
    "poem_id": 1711,
    "vorder": 68,
    "position": 1,
    "text": "که از بخت تو شاد بادا سپهر"
  },
  {
    "poem_id": 1711,
    "vorder": 69,
    "position": 0,
    "text": "همان مادرش نیز با او به جای"
  },
  {
    "poem_id": 1711,
    "vorder": 70,
    "position": 1,
    "text": "جهانجوی فرزند را رهنمای"
  },
  {
    "poem_id": 1711,
    "vorder": 71,
    "position": 0,
    "text": "بدو ماند شاه جهان درشگفت"
  },
  {
    "poem_id": 1711,
    "vorder": 72,
    "position": 1,
    "text": "ازان کودک اندیشه‌ها برگرفت"
  },
  {
    "poem_id": 1711,
    "vorder": 73,
    "position": 0,
    "text": "ازان پس چنین گفت با کدخدای"
  },
  {
    "poem_id": 1711,
    "vorder": 74,
    "position": 1,
    "text": "که ای مرد روشن‌دل و پاک‌رای"
  },
  {
    "poem_id": 1711,
    "vorder": 75,
    "position": 0,
    "text": "بسی رنج برداشتی زین سخن"
  },
  {
    "poem_id": 1711,
    "vorder": 76,
    "position": 1,
    "text": "نمانم که رنج تو گردد کهن"
  },
  {
    "poem_id": 1711,
    "vorder": 77,
    "position": 0,
    "text": "کنون صد پسر گیر همسال اوی"
  },
  {
    "poem_id": 1711,
    "vorder": 78,
    "position": 1,
    "text": "به بالا و دوش و بر و یال اوی"
  },
  {
    "poem_id": 1711,
    "vorder": 79,
    "position": 0,
    "text": "همان جامه پوشیده با او بهم"
  },
  {
    "poem_id": 1711,
    "vorder": 80,
    "position": 1,
    "text": "نباید که چیزی بود بیش و کم"
  },
  {
    "poem_id": 1711,
    "vorder": 81,
    "position": 0,
    "text": "همه کودکان را به میدان فرست"
  },
  {
    "poem_id": 1711,
    "vorder": 82,
    "position": 1,
    "text": "به بازیدن گوی و چوگان فرست"
  },
  {
    "poem_id": 1711,
    "vorder": 83,
    "position": 0,
    "text": "چو یک دشت کودک بود خوب‌چهر"
  },
  {
    "poem_id": 1711,
    "vorder": 84,
    "position": 1,
    "text": "بپیچد ز فرزند جانم به مهر"
  },
  {
    "poem_id": 1711,
    "vorder": 85,
    "position": 0,
    "text": "بدان راستی دل گواهی دهد"
  },
  {
    "poem_id": 1711,
    "vorder": 86,
    "position": 1,
    "text": "مرا با پسر آشنایی دهد"
  }
]