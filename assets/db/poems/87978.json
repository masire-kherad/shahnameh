[
  {
    "poem_id": 87978,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تابنده بنمود پشت"
  },
  {
    "poem_id": 87978,
    "vorder": 2,
    "position": 1,
    "text": "دل گیو گشت از برادر درشت"
  },
  {
    "poem_id": 87978,
    "vorder": 3,
    "position": 0,
    "text": "ببیژن چنین گفت کای رهنمای"
  },
  {
    "poem_id": 87978,
    "vorder": 4,
    "position": 1,
    "text": "برادر نیامد همی باز جای"
  },
  {
    "poem_id": 87978,
    "vorder": 5,
    "position": 0,
    "text": "بباید شدن تا وراکار چیست"
  },
  {
    "poem_id": 87978,
    "vorder": 6,
    "position": 1,
    "text": "نباید که بر رفته باید گریست"
  },
  {
    "poem_id": 87978,
    "vorder": 7,
    "position": 0,
    "text": "دلیران برفتند هر دو چو گرد"
  },
  {
    "poem_id": 87978,
    "vorder": 8,
    "position": 1,
    "text": "بدان جای پرخاش و ننگ و نبرد"
  },
  {
    "poem_id": 87978,
    "vorder": 9,
    "position": 0,
    "text": "بدیدار بهرامشان بد نیاز"
  },
  {
    "poem_id": 87978,
    "vorder": 10,
    "position": 1,
    "text": "همی خسته و کشته جستند باز"
  },
  {
    "poem_id": 87978,
    "vorder": 11,
    "position": 0,
    "text": "همه دشت پرخسته و کشته بود"
  },
  {
    "poem_id": 87978,
    "vorder": 12,
    "position": 1,
    "text": "جهانی بخون اندر آغشته بود"
  },
  {
    "poem_id": 87978,
    "vorder": 13,
    "position": 0,
    "text": "دلیران چو بهرام را یافتند"
  },
  {
    "poem_id": 87978,
    "vorder": 14,
    "position": 1,
    "text": "پر از آب و خون دیده بشتافتند"
  },
  {
    "poem_id": 87978,
    "vorder": 15,
    "position": 0,
    "text": "بخاک و بخون اندر افگنده خوار"
  },
  {
    "poem_id": 87978,
    "vorder": 16,
    "position": 1,
    "text": "فتاده ازو دست و برگشته کار"
  },
  {
    "poem_id": 87978,
    "vorder": 17,
    "position": 0,
    "text": "همی ریخت آب از بر چهراوی"
  },
  {
    "poem_id": 87978,
    "vorder": 18,
    "position": 1,
    "text": "پر از خون دو تن دیده از مهر اوی"
  },
  {
    "poem_id": 87978,
    "vorder": 19,
    "position": 0,
    "text": "چو بازآمدش هوش بگشاد چشم"
  },
  {
    "poem_id": 87978,
    "vorder": 20,
    "position": 1,
    "text": "تنش پر ز خون بود و دل پر ز خشم"
  },
  {
    "poem_id": 87978,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت با گیو کای نامجوی"
  },
  {
    "poem_id": 87978,
    "vorder": 22,
    "position": 1,
    "text": "مرا چون بپوشی بتابوت روی"
  },
  {
    "poem_id": 87978,
    "vorder": 23,
    "position": 0,
    "text": "تو کین برادر بخواه از تژاو"
  },
  {
    "poem_id": 87978,
    "vorder": 24,
    "position": 1,
    "text": "ندارد مگر گاو با شیر تاو"
  },
  {
    "poem_id": 87978,
    "vorder": 25,
    "position": 0,
    "text": "مرا دید پیران ویسه نخست"
  },
  {
    "poem_id": 87978,
    "vorder": 26,
    "position": 1,
    "text": "که با من بدش روزگاری نشست"
  },
  {
    "poem_id": 87978,
    "vorder": 27,
    "position": 0,
    "text": "همه نامداران و گردان چین"
  },
  {
    "poem_id": 87978,
    "vorder": 28,
    "position": 1,
    "text": "بجستند با من بغاز کین"
  },
  {
    "poem_id": 87978,
    "vorder": 29,
    "position": 0,
    "text": "تن من تژاو جفاپیشه خست"
  },
  {
    "poem_id": 87978,
    "vorder": 30,
    "position": 1,
    "text": "نکرد ایچ یاد از نژاد و نشست"
  },
  {
    "poem_id": 87978,
    "vorder": 31,
    "position": 0,
    "text": "چو بهرام گرد این سخن یاد کرد"
  },
  {
    "poem_id": 87978,
    "vorder": 32,
    "position": 1,
    "text": "ببارید گیو از مژه آب زرد"
  },
  {
    "poem_id": 87978,
    "vorder": 33,
    "position": 0,
    "text": "بدادار دارنده سوگند خورد"
  },
  {
    "poem_id": 87978,
    "vorder": 34,
    "position": 1,
    "text": "بروز سپید و شب لاژورد"
  },
  {
    "poem_id": 87978,
    "vorder": 35,
    "position": 0,
    "text": "که جز ترگ رومی نبیند سرم"
  },
  {
    "poem_id": 87978,
    "vorder": 36,
    "position": 1,
    "text": "مگر کین بهرام بازآورم"
  },
  {
    "poem_id": 87978,
    "vorder": 37,
    "position": 0,
    "text": "پر از درد و پر کین بزین برنشست"
  },
  {
    "poem_id": 87978,
    "vorder": 38,
    "position": 1,
    "text": "یکی تیغ هندی گرفته بدست"
  },
  {
    "poem_id": 87978,
    "vorder": 39,
    "position": 0,
    "text": "بدانگه که شد روی گیتی سیاه"
  },
  {
    "poem_id": 87978,
    "vorder": 40,
    "position": 1,
    "text": "تژاو از طلایه برآمد براه"
  },
  {
    "poem_id": 87978,
    "vorder": 41,
    "position": 0,
    "text": "چو از دور گیو دلیرش بدید"
  },
  {
    "poem_id": 87978,
    "vorder": 42,
    "position": 1,
    "text": "عنان را بپیچید و دم درکشید"
  },
  {
    "poem_id": 87978,
    "vorder": 43,
    "position": 0,
    "text": "چو دانست کز لشکر اندر گذشت"
  },
  {
    "poem_id": 87978,
    "vorder": 44,
    "position": 1,
    "text": "ز گردان و گردنکشان دور گشت"
  },
  {
    "poem_id": 87978,
    "vorder": 45,
    "position": 0,
    "text": "سوی او بیفکند پیچان کمند"
  },
  {
    "poem_id": 87978,
    "vorder": 46,
    "position": 1,
    "text": "میان تژاو اندر آمد به بند"
  },
  {
    "poem_id": 87978,
    "vorder": 47,
    "position": 0,
    "text": "بران اندر آورد و برگشت زود"
  },
  {
    "poem_id": 87978,
    "vorder": 48,
    "position": 1,
    "text": "پس آسانش از پشت زین در ربود"
  },
  {
    "poem_id": 87978,
    "vorder": 49,
    "position": 0,
    "text": "بخاک اندر افگند خوار و نژند"
  },
  {
    "poem_id": 87978,
    "vorder": 50,
    "position": 1,
    "text": "فرود آمد و دست کردش به بند"
  },
  {
    "poem_id": 87978,
    "vorder": 51,
    "position": 0,
    "text": "نشست از بر اسپ و او را کشان"
  },
  {
    "poem_id": 87978,
    "vorder": 52,
    "position": 1,
    "text": "پس اندر همی برد چون بیهشان"
  },
  {
    "poem_id": 87978,
    "vorder": 53,
    "position": 0,
    "text": "چنین گفت با او بخواهش تژاو"
  },
  {
    "poem_id": 87978,
    "vorder": 54,
    "position": 1,
    "text": "که با من نماند ای دلیر ایچ تاو"
  },
  {
    "poem_id": 87978,
    "vorder": 55,
    "position": 0,
    "text": "چه کردم کزین بی‌شمار انجمن"
  },
  {
    "poem_id": 87978,
    "vorder": 56,
    "position": 1,
    "text": "شب تیره دوزخ نمودی بمن"
  },
  {
    "poem_id": 87978,
    "vorder": 57,
    "position": 0,
    "text": "بزد بر سرش تازیانه دویست"
  },
  {
    "poem_id": 87978,
    "vorder": 58,
    "position": 1,
    "text": "بدو گفت کین جای گفتار نیست"
  },
  {
    "poem_id": 87978,
    "vorder": 59,
    "position": 0,
    "text": "ندانی همی ای بد شور بخت"
  },
  {
    "poem_id": 87978,
    "vorder": 60,
    "position": 1,
    "text": "که در باغ کین تازه کشتی درخت"
  },
  {
    "poem_id": 87978,
    "vorder": 61,
    "position": 0,
    "text": "که بالاش با چرخ همبر بود"
  },
  {
    "poem_id": 87978,
    "vorder": 62,
    "position": 1,
    "text": "تنش خون خورد بار او سر بود"
  },
  {
    "poem_id": 87978,
    "vorder": 63,
    "position": 0,
    "text": "شکار تو بهرام باید بجنگ"
  },
  {
    "poem_id": 87978,
    "vorder": 64,
    "position": 1,
    "text": "ببینی کنون زخم کام نهنگ"
  },
  {
    "poem_id": 87978,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت با گیو جنگی تژاو"
  },
  {
    "poem_id": 87978,
    "vorder": 66,
    "position": 1,
    "text": "که تو چون عقابی و من چون چکاو"
  },
  {
    "poem_id": 87978,
    "vorder": 67,
    "position": 0,
    "text": "ز بهرام بر بد نبردم گمان"
  },
  {
    "poem_id": 87978,
    "vorder": 68,
    "position": 1,
    "text": "نه او را بدست من آمد زمان"
  },
  {
    "poem_id": 87978,
    "vorder": 69,
    "position": 0,
    "text": "که من چون رسیدم سواران چین"
  },
  {
    "poem_id": 87978,
    "vorder": 70,
    "position": 1,
    "text": "ورا کشته بودند بر دشت کین"
  },
  {
    "poem_id": 87978,
    "vorder": 71,
    "position": 0,
    "text": "بران بد که بهرام بیجان شدست"
  },
  {
    "poem_id": 87978,
    "vorder": 72,
    "position": 1,
    "text": "ز دردش دل گیو پیچان شدست"
  },
  {
    "poem_id": 87978,
    "vorder": 73,
    "position": 0,
    "text": "کشانش بیارد گیو دلیر"
  },
  {
    "poem_id": 87978,
    "vorder": 74,
    "position": 1,
    "text": "بپیش جگر خسته بهرام شیر"
  },
  {
    "poem_id": 87978,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت کاینک سر بی‌وفا"
  },
  {
    "poem_id": 87978,
    "vorder": 76,
    "position": 1,
    "text": "مکافات سازم جفا را جفا"
  },
  {
    "poem_id": 87978,
    "vorder": 77,
    "position": 0,
    "text": "سپاس از جهان‌آفرین کردگار"
  },
  {
    "poem_id": 87978,
    "vorder": 78,
    "position": 1,
    "text": "که چندان زمان دیدم از روزگار"
  },
  {
    "poem_id": 87978,
    "vorder": 79,
    "position": 0,
    "text": "که تیره‌روان بداندیش تو"
  },
  {
    "poem_id": 87978,
    "vorder": 80,
    "position": 1,
    "text": "بپردازم اکنون من از پیش تو"
  },
  {
    "poem_id": 87978,
    "vorder": 81,
    "position": 0,
    "text": "همی کرد خواهش بریشان تژاو"
  },
  {
    "poem_id": 87978,
    "vorder": 82,
    "position": 1,
    "text": "همی خواست از کشتن خویش تاو"
  },
  {
    "poem_id": 87978,
    "vorder": 83,
    "position": 0,
    "text": "همی گفت ار ایدونک این کار بود"
  },
  {
    "poem_id": 87978,
    "vorder": 84,
    "position": 1,
    "text": "سر من بخنجر بریدن چه سود"
  },
  {
    "poem_id": 87978,
    "vorder": 85,
    "position": 0,
    "text": "یکی بنده باشم روان ترا"
  },
  {
    "poem_id": 87978,
    "vorder": 86,
    "position": 1,
    "text": "پرستش کنم گوربان ترا"
  },
  {
    "poem_id": 87978,
    "vorder": 87,
    "position": 0,
    "text": "چنین گفت با گیو بهرام شیر"
  },
  {
    "poem_id": 87978,
    "vorder": 88,
    "position": 1,
    "text": "که ای نامور نامدار دلیر"
  },
  {
    "poem_id": 87978,
    "vorder": 89,
    "position": 0,
    "text": "گر ایدونک از وی بمن بد رسید"
  },
  {
    "poem_id": 87978,
    "vorder": 90,
    "position": 1,
    "text": "همان روز مرگش نباید چشید"
  },
  {
    "poem_id": 87978,
    "vorder": 91,
    "position": 0,
    "text": "سر پر گناهش روان داد من"
  },
  {
    "poem_id": 87978,
    "vorder": 92,
    "position": 1,
    "text": "بمان تا کند در جهان یاد من"
  },
  {
    "poem_id": 87978,
    "vorder": 93,
    "position": 0,
    "text": "برادر چو بهرام را خسته دید"
  },
  {
    "poem_id": 87978,
    "vorder": 94,
    "position": 1,
    "text": "تژاو جفا پیشه را بسته دید"
  },
  {
    "poem_id": 87978,
    "vorder": 95,
    "position": 0,
    "text": "خروشید و بگرفت ریش تژاو"
  },
  {
    "poem_id": 87978,
    "vorder": 96,
    "position": 1,
    "text": "بریدش سر از تن بسان چکاو"
  },
  {
    "poem_id": 87978,
    "vorder": 97,
    "position": 0,
    "text": "دل گیو زان پس بریشان بسوخت"
  },
  {
    "poem_id": 87978,
    "vorder": 98,
    "position": 1,
    "text": "روانش ز غم آتشی برفروخت"
  },
  {
    "poem_id": 87978,
    "vorder": 99,
    "position": 0,
    "text": "خروشی برآورد کاندر جهان"
  },
  {
    "poem_id": 87978,
    "vorder": 100,
    "position": 1,
    "text": "که دید این شگفت آشکار و نهان"
  },
  {
    "poem_id": 87978,
    "vorder": 101,
    "position": 0,
    "text": "که گر من کشم ور کشی پیش من"
  },
  {
    "poem_id": 87978,
    "vorder": 102,
    "position": 1,
    "text": "برادر بود گر کسی خویش من"
  },
  {
    "poem_id": 87978,
    "vorder": 103,
    "position": 0,
    "text": "بگفت این و بهرام یل جان بداد"
  },
  {
    "poem_id": 87978,
    "vorder": 104,
    "position": 1,
    "text": "جهان را چنین است ساز ونهاد"
  },
  {
    "poem_id": 87978,
    "vorder": 105,
    "position": 0,
    "text": "عنان بزرگی هرآنکو بجست"
  },
  {
    "poem_id": 87978,
    "vorder": 106,
    "position": 1,
    "text": "نخستین بباید بخون دست شست"
  },
  {
    "poem_id": 87978,
    "vorder": 107,
    "position": 0,
    "text": "اگر خود کشد گر کشندش بدرد"
  },
  {
    "poem_id": 87978,
    "vorder": 108,
    "position": 1,
    "text": "بگرد جهان تا توانی مگرد"
  },
  {
    "poem_id": 87978,
    "vorder": 109,
    "position": 0,
    "text": "خروشان بر اسپ تژاوش ببست"
  },
  {
    "poem_id": 87978,
    "vorder": 110,
    "position": 1,
    "text": "به بیژن سپرد آنگهی برنشست"
  },
  {
    "poem_id": 87978,
    "vorder": 111,
    "position": 0,
    "text": "بیاوردش از جایگاه تژاو"
  },
  {
    "poem_id": 87978,
    "vorder": 112,
    "position": 1,
    "text": "بنزدیک ایران دلش پر ز تاو"
  },
  {
    "poem_id": 87978,
    "vorder": 113,
    "position": 0,
    "text": "چو شد دور زان جایگاه نبرد"
  },
  {
    "poem_id": 87978,
    "vorder": 114,
    "position": 1,
    "text": "بکردار ایوان یکی دخمه کرد"
  },
  {
    "poem_id": 87978,
    "vorder": 115,
    "position": 0,
    "text": "بیاگند مغزش بمشک و عبیر"
  },
  {
    "poem_id": 87978,
    "vorder": 116,
    "position": 1,
    "text": "تنش را بپوشید چینی حریر"
  },
  {
    "poem_id": 87978,
    "vorder": 117,
    "position": 0,
    "text": "برآیین شاهانش بر تخت عاج"
  },
  {
    "poem_id": 87978,
    "vorder": 118,
    "position": 1,
    "text": "بخوابید و آویخت بر سرش تاج"
  },
  {
    "poem_id": 87978,
    "vorder": 119,
    "position": 0,
    "text": "سر دخمه کردند سرخ و کبود"
  },
  {
    "poem_id": 87978,
    "vorder": 120,
    "position": 1,
    "text": "تو گفتی که بهرام هرگز نبود"
  },
  {
    "poem_id": 87978,
    "vorder": 121,
    "position": 0,
    "text": "شد آن لشکر نامور سوگوار"
  },
  {
    "poem_id": 87978,
    "vorder": 122,
    "position": 1,
    "text": "ز بهرام وز گردش روزگار"
  }
]