[
  {
    "poem_id": 1627,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که از تازیان صدهزار"
  },
  {
    "poem_id": 1627,
    "vorder": 2,
    "position": 1,
    "text": "نبرده سواران نیزه گزار"
  },
  {
    "poem_id": 1627,
    "vorder": 3,
    "position": 0,
    "text": "برفتند و سالار ایشان شعیب"
  },
  {
    "poem_id": 1627,
    "vorder": 4,
    "position": 1,
    "text": "یکی نامدار از نژاد قتیب"
  },
  {
    "poem_id": 1627,
    "vorder": 5,
    "position": 0,
    "text": "جهاندار ایران سپاهی ببرد"
  },
  {
    "poem_id": 1627,
    "vorder": 6,
    "position": 1,
    "text": "بگفتند کان را نشاید شمرد"
  },
  {
    "poem_id": 1627,
    "vorder": 7,
    "position": 0,
    "text": "فراز آمدند آن دو لشکر بهم"
  },
  {
    "poem_id": 1627,
    "vorder": 8,
    "position": 1,
    "text": "جهان شد ز پرخاشجویان دژم"
  },
  {
    "poem_id": 1627,
    "vorder": 9,
    "position": 0,
    "text": "زمین آن سپه را همی برنتافت"
  },
  {
    "poem_id": 1627,
    "vorder": 10,
    "position": 1,
    "text": "بران بوم کس جای رفتن نیافت"
  },
  {
    "poem_id": 1627,
    "vorder": 11,
    "position": 0,
    "text": "ز باران ژوپین و باران تیر"
  },
  {
    "poem_id": 1627,
    "vorder": 12,
    "position": 1,
    "text": "زمین شد ز خون چون یکی آبگیر"
  },
  {
    "poem_id": 1627,
    "vorder": 13,
    "position": 0,
    "text": "خروشی برآمد ز هر پهلوی"
  },
  {
    "poem_id": 1627,
    "vorder": 14,
    "position": 1,
    "text": "تلی کشته دیدند بر هر سوی"
  },
  {
    "poem_id": 1627,
    "vorder": 15,
    "position": 0,
    "text": "سه روز و سه شب زین نشان جنگ بود"
  },
  {
    "poem_id": 1627,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی بریشان جهان تنگ بود"
  },
  {
    "poem_id": 1627,
    "vorder": 17,
    "position": 0,
    "text": "چهارم عرب روی برگاشتند"
  },
  {
    "poem_id": 1627,
    "vorder": 18,
    "position": 1,
    "text": "به شب دشت پیکار بگذاشتند"
  },
  {
    "poem_id": 1627,
    "vorder": 19,
    "position": 0,
    "text": "شعیب اندران رزمگه کشته شد"
  },
  {
    "poem_id": 1627,
    "vorder": 20,
    "position": 1,
    "text": "عرب را همه روز برگشته شد"
  },
  {
    "poem_id": 1627,
    "vorder": 21,
    "position": 0,
    "text": "بسی اسپ تازی به زین خدنگ"
  },
  {
    "poem_id": 1627,
    "vorder": 22,
    "position": 1,
    "text": "هم از نیزه و تیغ و خفتان جنگ"
  },
  {
    "poem_id": 1627,
    "vorder": 23,
    "position": 0,
    "text": "ازان رفتگان ماند آنجا به جای"
  },
  {
    "poem_id": 1627,
    "vorder": 24,
    "position": 1,
    "text": "به نزد جهاندار پور همای"
  },
  {
    "poem_id": 1627,
    "vorder": 25,
    "position": 0,
    "text": "ببخشید چیزی که بد بر سپاه"
  },
  {
    "poem_id": 1627,
    "vorder": 26,
    "position": 1,
    "text": "ز اسپ و ز رمح و ز تیغ و کلاه"
  },
  {
    "poem_id": 1627,
    "vorder": 27,
    "position": 0,
    "text": "ز لشکر یکی مرزبان برگزید"
  },
  {
    "poem_id": 1627,
    "vorder": 28,
    "position": 1,
    "text": "که گفتار ایشان بداند شنید"
  },
  {
    "poem_id": 1627,
    "vorder": 29,
    "position": 0,
    "text": "فرستاد تا باژ خواهد ز دشت"
  },
  {
    "poem_id": 1627,
    "vorder": 30,
    "position": 1,
    "text": "ازان سال و آن سال کاندر گذشت"
  }
]