[
  {
    "poem_id": 88097,
    "vorder": 1,
    "position": 0,
    "text": "به هشتم نشست از بر گاه شاه"
  },
  {
    "poem_id": 88097,
    "vorder": 2,
    "position": 1,
    "text": "ابی یاره و گرز و زرین کلاه"
  },
  {
    "poem_id": 88097,
    "vorder": 3,
    "position": 0,
    "text": "چو آمدش رفتن به تنگی فراز"
  },
  {
    "poem_id": 88097,
    "vorder": 4,
    "position": 1,
    "text": "یکی گنج را درگشادند باز"
  },
  {
    "poem_id": 88097,
    "vorder": 5,
    "position": 0,
    "text": "چو بگشاد آن گنج آباد را"
  },
  {
    "poem_id": 88097,
    "vorder": 6,
    "position": 1,
    "text": "وصی کرد گودرز کشواد را"
  },
  {
    "poem_id": 88097,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت بنگر به کار جهان"
  },
  {
    "poem_id": 88097,
    "vorder": 8,
    "position": 1,
    "text": "چه در آشکار و چه اندر نهان"
  },
  {
    "poem_id": 88097,
    "vorder": 9,
    "position": 0,
    "text": "که هر گنج را روزی آگندنیست"
  },
  {
    "poem_id": 88097,
    "vorder": 10,
    "position": 1,
    "text": "به سختی و روزی پراگندنیست"
  },
  {
    "poem_id": 88097,
    "vorder": 11,
    "position": 0,
    "text": "نگه کن رباطی که ویران بود"
  },
  {
    "poem_id": 88097,
    "vorder": 12,
    "position": 1,
    "text": "یکی کان به نزدیک ایران بود"
  },
  {
    "poem_id": 88097,
    "vorder": 13,
    "position": 0,
    "text": "دگر آبگیری که باشد خراب"
  },
  {
    "poem_id": 88097,
    "vorder": 14,
    "position": 1,
    "text": "از ایران وز رنج افراسیاب"
  },
  {
    "poem_id": 88097,
    "vorder": 15,
    "position": 0,
    "text": "دگر کودکانی که بی‌مادرند"
  },
  {
    "poem_id": 88097,
    "vorder": 16,
    "position": 1,
    "text": "زنانی که بی شوی و بی‌چادرند"
  },
  {
    "poem_id": 88097,
    "vorder": 17,
    "position": 0,
    "text": "دگر آن کش آید به چیزی نیاز"
  },
  {
    "poem_id": 88097,
    "vorder": 18,
    "position": 1,
    "text": "ز هر کس همی دارد آن رنج راز"
  },
  {
    "poem_id": 88097,
    "vorder": 19,
    "position": 0,
    "text": "بر ایشان در گنج بسته مدار"
  },
  {
    "poem_id": 88097,
    "vorder": 20,
    "position": 1,
    "text": "ببخش و بترس از بد روزگار"
  },
  {
    "poem_id": 88097,
    "vorder": 21,
    "position": 0,
    "text": "دگر گنج کش نام بادآورست"
  },
  {
    "poem_id": 88097,
    "vorder": 22,
    "position": 1,
    "text": "پر از افسر و زیور و گوهرست"
  },
  {
    "poem_id": 88097,
    "vorder": 23,
    "position": 0,
    "text": "نگه کن به شهری که ویران شدست"
  },
  {
    "poem_id": 88097,
    "vorder": 24,
    "position": 1,
    "text": "کنام پلنگان و شیران شدست"
  },
  {
    "poem_id": 88097,
    "vorder": 25,
    "position": 0,
    "text": "دگر هر کجا رسم آتشکدست"
  },
  {
    "poem_id": 88097,
    "vorder": 26,
    "position": 1,
    "text": "که بی‌هیربد جای ویران شدست"
  },
  {
    "poem_id": 88097,
    "vorder": 27,
    "position": 0,
    "text": "سه دیگر کسی کاو ز تن بازماند"
  },
  {
    "poem_id": 88097,
    "vorder": 28,
    "position": 1,
    "text": "به روز جوانی درم برفشاند"
  },
  {
    "poem_id": 88097,
    "vorder": 29,
    "position": 0,
    "text": "دگر چاهساری که بی‌آب گشت"
  },
  {
    "poem_id": 88097,
    "vorder": 30,
    "position": 1,
    "text": "فراوان بر او سالیان برگذشت"
  },
  {
    "poem_id": 88097,
    "vorder": 31,
    "position": 0,
    "text": "بدین گنج بادآور آباد کن"
  },
  {
    "poem_id": 88097,
    "vorder": 32,
    "position": 1,
    "text": "درم خوار کن مرگ را یاد کن"
  },
  {
    "poem_id": 88097,
    "vorder": 33,
    "position": 0,
    "text": "دگر گنج کش خواندندی عروس"
  },
  {
    "poem_id": 88097,
    "vorder": 34,
    "position": 1,
    "text": "که آگند کاووس در شهر طوس"
  },
  {
    "poem_id": 88097,
    "vorder": 35,
    "position": 0,
    "text": "به گودرز فرمود کان را ببخش"
  },
  {
    "poem_id": 88097,
    "vorder": 36,
    "position": 1,
    "text": "به زال و به گیو و خداوند رخش"
  },
  {
    "poem_id": 88097,
    "vorder": 37,
    "position": 0,
    "text": "همه جامه‌های تنش برشمرد"
  },
  {
    "poem_id": 88097,
    "vorder": 38,
    "position": 1,
    "text": "نگه کرد یکسر به رستم سپرد"
  },
  {
    "poem_id": 88097,
    "vorder": 39,
    "position": 0,
    "text": "همان یاره و طوق کنداوران"
  },
  {
    "poem_id": 88097,
    "vorder": 40,
    "position": 1,
    "text": "همان جوشن و گرزهای گران"
  },
  {
    "poem_id": 88097,
    "vorder": 41,
    "position": 0,
    "text": "ز اسبان به جایی که بودش یله"
  },
  {
    "poem_id": 88097,
    "vorder": 42,
    "position": 1,
    "text": "به طوس سپهبد سپردش گله"
  },
  {
    "poem_id": 88097,
    "vorder": 43,
    "position": 0,
    "text": "همه باغ و گلشن به گودرز داد"
  },
  {
    "poem_id": 88097,
    "vorder": 44,
    "position": 1,
    "text": "به گیتی ز مرزی که آمدش یاد"
  },
  {
    "poem_id": 88097,
    "vorder": 45,
    "position": 0,
    "text": "سلیح تنش هرچه در گنج بود"
  },
  {
    "poem_id": 88097,
    "vorder": 46,
    "position": 1,
    "text": "که او را بدان خواسته رنج بود"
  },
  {
    "poem_id": 88097,
    "vorder": 47,
    "position": 0,
    "text": "سپردند یکسر به گیو دلیر"
  },
  {
    "poem_id": 88097,
    "vorder": 48,
    "position": 1,
    "text": "بدانگه که خسرو شد از گنج سیر"
  },
  {
    "poem_id": 88097,
    "vorder": 49,
    "position": 0,
    "text": "از ایوان و خرگاه و پرده‌سرای"
  },
  {
    "poem_id": 88097,
    "vorder": 50,
    "position": 1,
    "text": "همان خیمه و آخور و چارپای"
  },
  {
    "poem_id": 88097,
    "vorder": 51,
    "position": 0,
    "text": "فریبرز کاووس را داد شاه"
  },
  {
    "poem_id": 88097,
    "vorder": 52,
    "position": 1,
    "text": "بسی جوشن و ترگ و رومی کلاه"
  },
  {
    "poem_id": 88097,
    "vorder": 53,
    "position": 0,
    "text": "یکی طوق روشن‌تر از مشتری"
  },
  {
    "poem_id": 88097,
    "vorder": 54,
    "position": 1,
    "text": "ز یاقوت رخشان دو انگشتری"
  },
  {
    "poem_id": 88097,
    "vorder": 55,
    "position": 0,
    "text": "نبشته بر او نام شاه جهان"
  },
  {
    "poem_id": 88097,
    "vorder": 56,
    "position": 1,
    "text": "که اندر جهان آن نبودی نهان"
  },
  {
    "poem_id": 88097,
    "vorder": 57,
    "position": 0,
    "text": "به بیژن چنین گفت کین یادگار"
  },
  {
    "poem_id": 88097,
    "vorder": 58,
    "position": 1,
    "text": "همی دار و جز تخم نیکی مکار"
  }
]