[
  {
    "poem_id": 1479,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه شاه لشکر براند"
  },
  {
    "poem_id": 1479,
    "vorder": 2,
    "position": 1,
    "text": "به ایران خرامید و رستم بماند"
  },
  {
    "poem_id": 1479,
    "vorder": 3,
    "position": 0,
    "text": "بدان تا زواره بیاید ز راه"
  },
  {
    "poem_id": 1479,
    "vorder": 4,
    "position": 1,
    "text": "بدو آگهی آورد زان سپاه"
  },
  {
    "poem_id": 1479,
    "vorder": 5,
    "position": 0,
    "text": "چو آمد زواره سپیده دمان"
  },
  {
    "poem_id": 1479,
    "vorder": 6,
    "position": 1,
    "text": "سپه راند رستم هم اندر زمان"
  },
  {
    "poem_id": 1479,
    "vorder": 7,
    "position": 0,
    "text": "پس آنگه سوی زابلستان کشید"
  },
  {
    "poem_id": 1479,
    "vorder": 8,
    "position": 1,
    "text": "چو آگاهی از وی به دستان رسید"
  },
  {
    "poem_id": 1479,
    "vorder": 9,
    "position": 0,
    "text": "همه سیستان پیش باز آمدند"
  },
  {
    "poem_id": 1479,
    "vorder": 10,
    "position": 1,
    "text": "به رنج و به درد و گداز آمدند"
  },
  {
    "poem_id": 1479,
    "vorder": 11,
    "position": 0,
    "text": "چو تابوت را دید دستان سام"
  },
  {
    "poem_id": 1479,
    "vorder": 12,
    "position": 1,
    "text": "فرود آمد از اسپ زرین ستام"
  },
  {
    "poem_id": 1479,
    "vorder": 13,
    "position": 0,
    "text": "تهمتن پیاده همی رفت پیش"
  },
  {
    "poem_id": 1479,
    "vorder": 14,
    "position": 1,
    "text": "دریده همه جامه دل کرده ریش"
  },
  {
    "poem_id": 1479,
    "vorder": 15,
    "position": 0,
    "text": "گشادند گردان سراسر کمر"
  },
  {
    "poem_id": 1479,
    "vorder": 16,
    "position": 1,
    "text": "همه پیش تابوت بر خاک سر"
  },
  {
    "poem_id": 1479,
    "vorder": 17,
    "position": 0,
    "text": "همی گفت زال اینت کاری شگفت"
  },
  {
    "poem_id": 1479,
    "vorder": 18,
    "position": 1,
    "text": "که سهراب گرز گران برگرفت"
  },
  {
    "poem_id": 1479,
    "vorder": 19,
    "position": 0,
    "text": "نشانی شد اندر میان مهان"
  },
  {
    "poem_id": 1479,
    "vorder": 20,
    "position": 1,
    "text": "نزاید چنو مادر اندر جهان"
  },
  {
    "poem_id": 1479,
    "vorder": 21,
    "position": 0,
    "text": "همی گفت و مژگان پر از آب کرد"
  },
  {
    "poem_id": 1479,
    "vorder": 22,
    "position": 1,
    "text": "زبان پر ز گفتار سهراب کرد"
  },
  {
    "poem_id": 1479,
    "vorder": 23,
    "position": 0,
    "text": "چو آمد تهمتن به ایوان خویش"
  },
  {
    "poem_id": 1479,
    "vorder": 24,
    "position": 1,
    "text": "خروشید و تابوت بنهاد پیش"
  },
  {
    "poem_id": 1479,
    "vorder": 25,
    "position": 0,
    "text": "ازو میخ برکند و بگشاد سر"
  },
  {
    "poem_id": 1479,
    "vorder": 26,
    "position": 1,
    "text": "کفن زو جدا کرد پیش پدر"
  },
  {
    "poem_id": 1479,
    "vorder": 27,
    "position": 0,
    "text": "تنش را بدان نامداران نمود"
  },
  {
    "poem_id": 1479,
    "vorder": 28,
    "position": 1,
    "text": "تو گفتی که از چرخ برخاست دود"
  },
  {
    "poem_id": 1479,
    "vorder": 29,
    "position": 0,
    "text": "مهان جهان جامه کردند چاک"
  },
  {
    "poem_id": 1479,
    "vorder": 30,
    "position": 1,
    "text": "به ابر اندر آمد سر گرد و خاک"
  },
  {
    "poem_id": 1479,
    "vorder": 31,
    "position": 0,
    "text": "همه کاخ تابوت بد سر به سر"
  },
  {
    "poem_id": 1479,
    "vorder": 32,
    "position": 1,
    "text": "غنوده بصندوق در شیر نر"
  },
  {
    "poem_id": 1479,
    "vorder": 33,
    "position": 0,
    "text": "تو گفتی که سام است با یال و سفت"
  },
  {
    "poem_id": 1479,
    "vorder": 34,
    "position": 1,
    "text": "غمی شد ز جنگ اندر آمد بخفت"
  },
  {
    "poem_id": 1479,
    "vorder": 35,
    "position": 0,
    "text": "بپوشید بازش به دیبای زرد"
  },
  {
    "poem_id": 1479,
    "vorder": 36,
    "position": 1,
    "text": "سر تنگ تابوت را سخت کرد"
  },
  {
    "poem_id": 1479,
    "vorder": 37,
    "position": 0,
    "text": "همی گفت اگر دخمه زرین کنم"
  },
  {
    "poem_id": 1479,
    "vorder": 38,
    "position": 1,
    "text": "ز مشک سیه گردش آگین کنم"
  },
  {
    "poem_id": 1479,
    "vorder": 39,
    "position": 0,
    "text": "چو من رفته باشم نماند بجای"
  },
  {
    "poem_id": 1479,
    "vorder": 40,
    "position": 1,
    "text": "وگرنه مرا خود جزین نیست رای"
  },
  {
    "poem_id": 1479,
    "vorder": 41,
    "position": 0,
    "text": "یکی دخمه کردش ز سم ستور"
  },
  {
    "poem_id": 1479,
    "vorder": 42,
    "position": 1,
    "text": "جهانی ز زاری همی گشت کور"
  },
  {
    "poem_id": 1479,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت بهرام نیکو سخن"
  },
  {
    "poem_id": 1479,
    "vorder": 44,
    "position": 1,
    "text": "که با مردگان آشنایی مکن"
  },
  {
    "poem_id": 1479,
    "vorder": 45,
    "position": 0,
    "text": "نه ایدر همی ماند خواهی دراز"
  },
  {
    "poem_id": 1479,
    "vorder": 46,
    "position": 1,
    "text": "بسیچیده باش و درنگی مساز"
  },
  {
    "poem_id": 1479,
    "vorder": 47,
    "position": 0,
    "text": "به تو داد یک روز نوبت پدر"
  },
  {
    "poem_id": 1479,
    "vorder": 48,
    "position": 1,
    "text": "سزد گر ترا نوبت آید بسر"
  },
  {
    "poem_id": 1479,
    "vorder": 49,
    "position": 0,
    "text": "چنین است و رازش نیامد پدید"
  },
  {
    "poem_id": 1479,
    "vorder": 50,
    "position": 1,
    "text": "نیابی به خیره چه جویی کلید"
  },
  {
    "poem_id": 1479,
    "vorder": 51,
    "position": 0,
    "text": "در بسته را کس نداند گشاد"
  },
  {
    "poem_id": 1479,
    "vorder": 52,
    "position": 1,
    "text": "بدین رنج عمر تو گردد بباد"
  },
  {
    "poem_id": 1479,
    "vorder": 53,
    "position": 0,
    "text": "یکی داستانست پر آب چشم"
  },
  {
    "poem_id": 1479,
    "vorder": 54,
    "position": 1,
    "text": "دل نازک از رستم آید بخشم"
  },
  {
    "poem_id": 1479,
    "vorder": 55,
    "position": 0,
    "text": "برین داستان من سخن ساختم"
  },
  {
    "poem_id": 1479,
    "vorder": 56,
    "position": 1,
    "text": "به کار سیاووش پرداختم"
  }
]