[
  {
    "poem_id": 1353,
    "vorder": 1,
    "position": 0,
    "text": "فریدون به خورشید بر برد سر"
  },
  {
    "poem_id": 1353,
    "vorder": 2,
    "position": 1,
    "text": "کمر تنگ بستش به کین پدر"
  },
  {
    "poem_id": 1353,
    "vorder": 3,
    "position": 0,
    "text": "برون رفت خرم به خرداد روز"
  },
  {
    "poem_id": 1353,
    "vorder": 4,
    "position": 1,
    "text": "به نیک اختر و فال گیتی فروز"
  },
  {
    "poem_id": 1353,
    "vorder": 5,
    "position": 0,
    "text": "سپاه انجمن شد به درگاه او"
  },
  {
    "poem_id": 1353,
    "vorder": 6,
    "position": 1,
    "text": "به ابر اندر آمد سر گاه او"
  },
  {
    "poem_id": 1353,
    "vorder": 7,
    "position": 0,
    "text": "به پیلان گردون‌کش و گاومیش"
  },
  {
    "poem_id": 1353,
    "vorder": 8,
    "position": 1,
    "text": "سپه را همی توشه بردند پیش"
  },
  {
    "poem_id": 1353,
    "vorder": 9,
    "position": 0,
    "text": "کیانوش و پرمایه بر دست شاه"
  },
  {
    "poem_id": 1353,
    "vorder": 10,
    "position": 1,
    "text": "چو کهتر برادر ورا نیک خواه"
  },
  {
    "poem_id": 1353,
    "vorder": 11,
    "position": 0,
    "text": "همی رفت منزل به منزل چو باد"
  },
  {
    "poem_id": 1353,
    "vorder": 12,
    "position": 1,
    "text": "سری پر ز کینه دلی پر ز داد"
  },
  {
    "poem_id": 1353,
    "vorder": 13,
    "position": 0,
    "text": "به اروندرود اندر آورد روی"
  },
  {
    "poem_id": 1353,
    "vorder": 14,
    "position": 1,
    "text": "چنان چون بود مرد دیهیم‌جوی"
  },
  {
    "poem_id": 1353,
    "vorder": 15,
    "position": 0,
    "text": "اگر پهلوانی ندانی زبان"
  },
  {
    "poem_id": 1353,
    "vorder": 16,
    "position": 1,
    "text": "به تازی تو اروند را دجله خوان"
  },
  {
    "poem_id": 1353,
    "vorder": 17,
    "position": 0,
    "text": "دگر منزل آن شاه آزادمرد"
  },
  {
    "poem_id": 1353,
    "vorder": 18,
    "position": 1,
    "text": "لب دجله و شهر بغداد کرد"
  }
]