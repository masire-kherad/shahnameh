[
  {
    "poem_id": 1523,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید شد بر سر کوه زرد"
  },
  {
    "poem_id": 1523,
    "vorder": 2,
    "position": 1,
    "text": "نماند آن زمان روزگار نبرد"
  },
  {
    "poem_id": 1523,
    "vorder": 3,
    "position": 0,
    "text": "شب آمد یکی پردهٔ آبنوس"
  },
  {
    "poem_id": 1523,
    "vorder": 4,
    "position": 1,
    "text": "بپوشید بر چهرهٔ سندروس"
  },
  {
    "poem_id": 1523,
    "vorder": 5,
    "position": 0,
    "text": "چو خورشید ازان کوشش آگاه شد"
  },
  {
    "poem_id": 1523,
    "vorder": 6,
    "position": 1,
    "text": "ز برج کمان بر سر گاه شد"
  },
  {
    "poem_id": 1523,
    "vorder": 7,
    "position": 0,
    "text": "ببد چشمهٔ روز چون سندروس"
  },
  {
    "poem_id": 1523,
    "vorder": 8,
    "position": 1,
    "text": "ز هر سو برآمد دم نای و کوس"
  },
  {
    "poem_id": 1523,
    "vorder": 9,
    "position": 0,
    "text": "چکاچاک برخاست از هر دو روی"
  },
  {
    "poem_id": 1523,
    "vorder": 10,
    "position": 1,
    "text": "ز خون شد همه رزمگه جوی جوی"
  },
  {
    "poem_id": 1523,
    "vorder": 11,
    "position": 0,
    "text": "بیامد سبک قیصر از میمنه"
  },
  {
    "poem_id": 1523,
    "vorder": 12,
    "position": 1,
    "text": "دو داماد را کرد پیش بنه"
  },
  {
    "poem_id": 1523,
    "vorder": 13,
    "position": 0,
    "text": "ابر میمنه پور قیصر سقیل"
  },
  {
    "poem_id": 1523,
    "vorder": 14,
    "position": 1,
    "text": "ابر میسره قیصر و کوس و پیل"
  },
  {
    "poem_id": 1523,
    "vorder": 15,
    "position": 0,
    "text": "دهاده برآمد ز هر دو سپاه"
  },
  {
    "poem_id": 1523,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی برآویخت با شید ماه"
  },
  {
    "poem_id": 1523,
    "vorder": 17,
    "position": 0,
    "text": "بجنبید گشتاسپ از پیش صف"
  },
  {
    "poem_id": 1523,
    "vorder": 18,
    "position": 1,
    "text": "یکی باره زیر اژدهایی به کف"
  },
  {
    "poem_id": 1523,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت الیاس با انجمن"
  },
  {
    "poem_id": 1523,
    "vorder": 20,
    "position": 1,
    "text": "که قیصر همی باژ خواهد ز من"
  },
  {
    "poem_id": 1523,
    "vorder": 21,
    "position": 0,
    "text": "چو بر در چنین اژدها باشدش"
  },
  {
    "poem_id": 1523,
    "vorder": 22,
    "position": 1,
    "text": "ازیرا منش بابها باشدش"
  },
  {
    "poem_id": 1523,
    "vorder": 23,
    "position": 0,
    "text": "چو گشتاسپ الیاس را دید گفت"
  },
  {
    "poem_id": 1523,
    "vorder": 24,
    "position": 1,
    "text": "که اکنون هنرها نباید نهفت"
  },
  {
    "poem_id": 1523,
    "vorder": 25,
    "position": 0,
    "text": "برانگیختند اسپ هر دو سوار"
  },
  {
    "poem_id": 1523,
    "vorder": 26,
    "position": 1,
    "text": "ابا نیزه و تیر جوشن گذار"
  },
  {
    "poem_id": 1523,
    "vorder": 27,
    "position": 0,
    "text": "ازان لشکر الیاس بگشاد شست"
  },
  {
    "poem_id": 1523,
    "vorder": 28,
    "position": 1,
    "text": "که گشتاسپ را برکند کار پست"
  },
  {
    "poem_id": 1523,
    "vorder": 29,
    "position": 0,
    "text": "بزد نیزه گشتاسپ بر جوشنش"
  },
  {
    "poem_id": 1523,
    "vorder": 30,
    "position": 1,
    "text": "بخست آن زمان کارزاری تنش"
  },
  {
    "poem_id": 1523,
    "vorder": 31,
    "position": 0,
    "text": "بیفگندش از باره برسان مست"
  },
  {
    "poem_id": 1523,
    "vorder": 32,
    "position": 1,
    "text": "بیازید و بگرفت دستش به دست"
  },
  {
    "poem_id": 1523,
    "vorder": 33,
    "position": 0,
    "text": "ز پیش سواران کشانش ببرد"
  },
  {
    "poem_id": 1523,
    "vorder": 34,
    "position": 1,
    "text": "بیاورد و نزدیک قیصر سپرد"
  },
  {
    "poem_id": 1523,
    "vorder": 35,
    "position": 0,
    "text": "بیاورد لشکر به پیش سپاه"
  },
  {
    "poem_id": 1523,
    "vorder": 36,
    "position": 1,
    "text": "به کردار باد اندر آمد ز راه"
  },
  {
    "poem_id": 1523,
    "vorder": 37,
    "position": 0,
    "text": "ازیشان چه مایه گرفت و بکشت"
  },
  {
    "poem_id": 1523,
    "vorder": 38,
    "position": 1,
    "text": "بکشتند مر هرک آمد به مشت"
  },
  {
    "poem_id": 1523,
    "vorder": 39,
    "position": 0,
    "text": "چو رومی پس‌اندر هم‌آواز شد"
  },
  {
    "poem_id": 1523,
    "vorder": 40,
    "position": 1,
    "text": "چو گشتاسپ زان جایگه باز شد"
  },
  {
    "poem_id": 1523,
    "vorder": 41,
    "position": 0,
    "text": "بر قیصر آمد سپه تاخته"
  },
  {
    "poem_id": 1523,
    "vorder": 42,
    "position": 1,
    "text": "به پیروزی و گردن افراخته"
  },
  {
    "poem_id": 1523,
    "vorder": 43,
    "position": 0,
    "text": "ز لشکر چو قیصر بدیدش به راه"
  },
  {
    "poem_id": 1523,
    "vorder": 44,
    "position": 1,
    "text": "ز شادی پذیره شدش با سپاه"
  },
  {
    "poem_id": 1523,
    "vorder": 45,
    "position": 0,
    "text": "سر و چشم آن نامور بوس داد"
  },
  {
    "poem_id": 1523,
    "vorder": 46,
    "position": 1,
    "text": "جهان‌آفرین را همی کرد یاد"
  },
  {
    "poem_id": 1523,
    "vorder": 47,
    "position": 0,
    "text": "وزان جایگه بازگشتند شاد"
  },
  {
    "poem_id": 1523,
    "vorder": 48,
    "position": 1,
    "text": "سپهبد کلاه کیان برنهاد"
  },
  {
    "poem_id": 1523,
    "vorder": 49,
    "position": 0,
    "text": "همه روم با هدیه و با نثار"
  },
  {
    "poem_id": 1523,
    "vorder": 50,
    "position": 1,
    "text": "برفتند شادان بر نامدار"
  }
]