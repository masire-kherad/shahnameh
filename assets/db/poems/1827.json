[
  {
    "poem_id": 1827,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت موبد که یک روز شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 2,
    "position": 1,
    "text": "به دیبای رومی بیاراست گاه"
  },
  {
    "poem_id": 1827,
    "vorder": 3,
    "position": 0,
    "text": "بیاویخت تاج از بر تخت عاج"
  },
  {
    "poem_id": 1827,
    "vorder": 4,
    "position": 1,
    "text": "همه جای عاج و همه جای تاج"
  },
  {
    "poem_id": 1827,
    "vorder": 5,
    "position": 0,
    "text": "همه کاخ پر موبد و مرزبان"
  },
  {
    "poem_id": 1827,
    "vorder": 6,
    "position": 1,
    "text": "ز بلخ و ز بامین و ز کرزبان"
  },
  {
    "poem_id": 1827,
    "vorder": 7,
    "position": 0,
    "text": "چنین آگهی یافت شاه جهان"
  },
  {
    "poem_id": 1827,
    "vorder": 8,
    "position": 1,
    "text": "ز گفتار بیدار کارآگهان"
  },
  {
    "poem_id": 1827,
    "vorder": 9,
    "position": 0,
    "text": "که آمد فرستادهٔ شاه هند"
  },
  {
    "poem_id": 1827,
    "vorder": 10,
    "position": 1,
    "text": "ابا پیل و چتر و سواران سند"
  },
  {
    "poem_id": 1827,
    "vorder": 11,
    "position": 0,
    "text": "شتروار بارست با او هزار"
  },
  {
    "poem_id": 1827,
    "vorder": 12,
    "position": 1,
    "text": "همی راه جوید بر شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 13,
    "position": 0,
    "text": "همانگه چو بشنید بیدار شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 14,
    "position": 1,
    "text": "پذیره فرستاد چندی سپاه"
  },
  {
    "poem_id": 1827,
    "vorder": 15,
    "position": 0,
    "text": "چو آمد بر شهریار بزرگ"
  },
  {
    "poem_id": 1827,
    "vorder": 16,
    "position": 1,
    "text": "فرستادهٔ نامدار و سترگ"
  },
  {
    "poem_id": 1827,
    "vorder": 17,
    "position": 0,
    "text": "برسم بزرگان نیایش گرفت"
  },
  {
    "poem_id": 1827,
    "vorder": 18,
    "position": 1,
    "text": "جهان آفرین را ستایش گرفت"
  },
  {
    "poem_id": 1827,
    "vorder": 19,
    "position": 0,
    "text": "گهرکرد بسیار پیشش نثار"
  },
  {
    "poem_id": 1827,
    "vorder": 20,
    "position": 1,
    "text": "یکی چتر و ده پیل با گوشوار"
  },
  {
    "poem_id": 1827,
    "vorder": 21,
    "position": 0,
    "text": "بیاراسته چتر هندی به زر"
  },
  {
    "poem_id": 1827,
    "vorder": 22,
    "position": 1,
    "text": "بدو بافته چند گونه گهر"
  },
  {
    "poem_id": 1827,
    "vorder": 23,
    "position": 0,
    "text": "سر بار بگشاد در بارگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 24,
    "position": 1,
    "text": "بیاورد یک سر همه نزد شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 25,
    "position": 0,
    "text": "فراوان ببار اندرون سیم و زر"
  },
  {
    "poem_id": 1827,
    "vorder": 26,
    "position": 1,
    "text": "چه از مشک و عنبر چه از عود تر"
  },
  {
    "poem_id": 1827,
    "vorder": 27,
    "position": 0,
    "text": "ز یاقوت والماس وز تیغ هند"
  },
  {
    "poem_id": 1827,
    "vorder": 28,
    "position": 1,
    "text": "همه تیغ هندی سراسر پرند"
  },
  {
    "poem_id": 1827,
    "vorder": 29,
    "position": 0,
    "text": "ز چیزی که خیزد ز قنوج و رای"
  },
  {
    "poem_id": 1827,
    "vorder": 30,
    "position": 1,
    "text": "زده دست و پای آوریده به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 31,
    "position": 0,
    "text": "ببردند یک سر همه پیش تخت"
  },
  {
    "poem_id": 1827,
    "vorder": 32,
    "position": 1,
    "text": "نگه کرد سالار خورشید بخت"
  },
  {
    "poem_id": 1827,
    "vorder": 33,
    "position": 0,
    "text": "ز چیزی که برد اندران رای رنج"
  },
  {
    "poem_id": 1827,
    "vorder": 34,
    "position": 1,
    "text": "فرستاد کسری سراسر به گنج"
  },
  {
    "poem_id": 1827,
    "vorder": 35,
    "position": 0,
    "text": "بیاورد پس نامه‌ای بر پرند"
  },
  {
    "poem_id": 1827,
    "vorder": 36,
    "position": 1,
    "text": "نبشته بنوشین‌روان رای هند"
  },
  {
    "poem_id": 1827,
    "vorder": 37,
    "position": 0,
    "text": "یکی تخت شطرنج کرده به رنج"
  },
  {
    "poem_id": 1827,
    "vorder": 38,
    "position": 1,
    "text": "تهی کرده از رنج شطرنج گنج"
  },
  {
    "poem_id": 1827,
    "vorder": 39,
    "position": 0,
    "text": "بیاورد پیغام هندی ز رای"
  },
  {
    "poem_id": 1827,
    "vorder": 40,
    "position": 1,
    "text": "که تا چرخ باشد تو بادی به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 41,
    "position": 0,
    "text": "کسی کو بدانش برد رنج بیش"
  },
  {
    "poem_id": 1827,
    "vorder": 42,
    "position": 1,
    "text": "بفرمای تا تخت شطرنج پیش"
  },
  {
    "poem_id": 1827,
    "vorder": 43,
    "position": 0,
    "text": "نهند و ز هر گونه رای آورند"
  },
  {
    "poem_id": 1827,
    "vorder": 44,
    "position": 1,
    "text": "که این نغز بازی به جای آورند"
  },
  {
    "poem_id": 1827,
    "vorder": 45,
    "position": 0,
    "text": "بدانند هرمهره‌ای را به نام"
  },
  {
    "poem_id": 1827,
    "vorder": 46,
    "position": 1,
    "text": "که گویند پس خانهٔ او کدام"
  },
  {
    "poem_id": 1827,
    "vorder": 47,
    "position": 0,
    "text": "پیاده بدانند و پیل و سپاه"
  },
  {
    "poem_id": 1827,
    "vorder": 48,
    "position": 1,
    "text": "رخ واسب و رفتار فرزین و شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 49,
    "position": 0,
    "text": "گراین نغز بازی به جای آورند"
  },
  {
    "poem_id": 1827,
    "vorder": 50,
    "position": 1,
    "text": "درین کار پاکیزه رای آورند"
  },
  {
    "poem_id": 1827,
    "vorder": 51,
    "position": 0,
    "text": "همان باژ و ساوی که فرمودشاه"
  },
  {
    "poem_id": 1827,
    "vorder": 52,
    "position": 1,
    "text": "به خوبی فرستم بران بارگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 53,
    "position": 0,
    "text": "وگر نامداران ایران گروه"
  },
  {
    "poem_id": 1827,
    "vorder": 54,
    "position": 1,
    "text": "ازین دانش آیند یک سر ستوه"
  },
  {
    "poem_id": 1827,
    "vorder": 55,
    "position": 0,
    "text": "چو با دانش ما ندارند تاو"
  },
  {
    "poem_id": 1827,
    "vorder": 56,
    "position": 1,
    "text": "نخواهند زین بوم و بر باژ و ساو"
  },
  {
    "poem_id": 1827,
    "vorder": 57,
    "position": 0,
    "text": "همان باژ باید پذیرفت نیز"
  },
  {
    "poem_id": 1827,
    "vorder": 58,
    "position": 1,
    "text": "که دانش به از نامبردار چیز"
  },
  {
    "poem_id": 1827,
    "vorder": 59,
    "position": 0,
    "text": "دل و گوش کسری بگوینده داد"
  },
  {
    "poem_id": 1827,
    "vorder": 60,
    "position": 1,
    "text": "سخنها برو کرد گوینده یاد"
  },
  {
    "poem_id": 1827,
    "vorder": 61,
    "position": 0,
    "text": "نهادند شطرنج نزدیک شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 62,
    "position": 1,
    "text": "به مهره درون کرد چندی نگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 63,
    "position": 0,
    "text": "ز تختش یکی مهره از عاج بود"
  },
  {
    "poem_id": 1827,
    "vorder": 64,
    "position": 1,
    "text": "پر از رنگ پیکر دگر ساج بود"
  },
  {
    "poem_id": 1827,
    "vorder": 65,
    "position": 0,
    "text": "بپرسید ازو شاه پیروزبخت"
  },
  {
    "poem_id": 1827,
    "vorder": 66,
    "position": 1,
    "text": "ازان پیکر ومهره ومشک وتخت"
  },
  {
    "poem_id": 1827,
    "vorder": 67,
    "position": 0,
    "text": "چنین داد پاسخ که ای شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 68,
    "position": 1,
    "text": "همه رسم و راه از در کارزار"
  },
  {
    "poem_id": 1827,
    "vorder": 69,
    "position": 0,
    "text": "ببینی چویابی به بازیش راه"
  },
  {
    "poem_id": 1827,
    "vorder": 70,
    "position": 1,
    "text": "رخ و پیل و آرایش رزمگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت یک هفته ما را زمان"
  },
  {
    "poem_id": 1827,
    "vorder": 72,
    "position": 1,
    "text": "ببازیم هشتم به روشن‌روان"
  },
  {
    "poem_id": 1827,
    "vorder": 73,
    "position": 0,
    "text": "یکی خرم ایوان بپرداختند"
  },
  {
    "poem_id": 1827,
    "vorder": 74,
    "position": 1,
    "text": "فرستاده را پایگه ساختند"
  },
  {
    "poem_id": 1827,
    "vorder": 75,
    "position": 0,
    "text": "رد وموبدان نماینده راه"
  },
  {
    "poem_id": 1827,
    "vorder": 76,
    "position": 1,
    "text": "برفتند یک سر به نزدیک شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 77,
    "position": 0,
    "text": "نهادند پس تخت شطرنج پیش"
  },
  {
    "poem_id": 1827,
    "vorder": 78,
    "position": 1,
    "text": "نگه کرد هریک ز اندازه بیش"
  },
  {
    "poem_id": 1827,
    "vorder": 79,
    "position": 0,
    "text": "بجستند و هر گونه‌ای ساختند"
  },
  {
    "poem_id": 1827,
    "vorder": 80,
    "position": 1,
    "text": "ز هر دست یکبارش انداختند"
  },
  {
    "poem_id": 1827,
    "vorder": 81,
    "position": 0,
    "text": "یکی گفت وپرسید و دیگر شنید"
  },
  {
    "poem_id": 1827,
    "vorder": 82,
    "position": 1,
    "text": "نیاورد کس راه بازی پدید"
  },
  {
    "poem_id": 1827,
    "vorder": 83,
    "position": 0,
    "text": "برفتند یکسر پرآژنگ چهر"
  },
  {
    "poem_id": 1827,
    "vorder": 84,
    "position": 1,
    "text": "بیامد برشاه بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 85,
    "position": 0,
    "text": "ورا زان سخن نیک ناکام دید"
  },
  {
    "poem_id": 1827,
    "vorder": 86,
    "position": 1,
    "text": "به آغاز آن رنج فرجام دید"
  },
  {
    "poem_id": 1827,
    "vorder": 87,
    "position": 0,
    "text": "به کسری چنین گفت کای پادشا"
  },
  {
    "poem_id": 1827,
    "vorder": 88,
    "position": 1,
    "text": "جهاندار و بیدار و فرمانروا"
  },
  {
    "poem_id": 1827,
    "vorder": 89,
    "position": 0,
    "text": "من این نغز بازی به جای آورم"
  },
  {
    "poem_id": 1827,
    "vorder": 90,
    "position": 1,
    "text": "خرد را بدین رهنمای آورم"
  },
  {
    "poem_id": 1827,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت شاه این سخن کارتست"
  },
  {
    "poem_id": 1827,
    "vorder": 92,
    "position": 1,
    "text": "که روشن‌روان بادی وتندرست"
  },
  {
    "poem_id": 1827,
    "vorder": 93,
    "position": 0,
    "text": "کنون رای قنوج گوید که شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 94,
    "position": 1,
    "text": "ندارد یکی مرد جوینده راه"
  },
  {
    "poem_id": 1827,
    "vorder": 95,
    "position": 0,
    "text": "شکست بزرگ است بر موبدان"
  },
  {
    "poem_id": 1827,
    "vorder": 96,
    "position": 1,
    "text": "به در گاه و بر گاه و بر بخردان"
  },
  {
    "poem_id": 1827,
    "vorder": 97,
    "position": 0,
    "text": "بیاورد شطرنج بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 98,
    "position": 1,
    "text": "پراندیشه بنشست و بگشاد چهر"
  },
  {
    "poem_id": 1827,
    "vorder": 99,
    "position": 0,
    "text": "همی‌جست بازی چپ و دست راست"
  },
  {
    "poem_id": 1827,
    "vorder": 100,
    "position": 1,
    "text": "همی‌راند تا جای هریک کجاست"
  },
  {
    "poem_id": 1827,
    "vorder": 101,
    "position": 0,
    "text": "به یک روز و یک شب چو بازیش یافت"
  },
  {
    "poem_id": 1827,
    "vorder": 102,
    "position": 1,
    "text": "از ایوان سوی شاه ایران شتافت"
  },
  {
    "poem_id": 1827,
    "vorder": 103,
    "position": 0,
    "text": "بدو گفت کای شاه پیروزبخت"
  },
  {
    "poem_id": 1827,
    "vorder": 104,
    "position": 1,
    "text": "نگه کردم این مهره و مشک و تخت"
  },
  {
    "poem_id": 1827,
    "vorder": 105,
    "position": 0,
    "text": "به خوبی همه بازی آمد به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 106,
    "position": 1,
    "text": "به بخت بلند جهان کدخدای"
  },
  {
    "poem_id": 1827,
    "vorder": 107,
    "position": 0,
    "text": "فرستادهٔ شاه را پیش خواه"
  },
  {
    "poem_id": 1827,
    "vorder": 108,
    "position": 1,
    "text": "کسی را که دارند ما را نگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 109,
    "position": 0,
    "text": "شهنشاه باید که بیند نخست"
  },
  {
    "poem_id": 1827,
    "vorder": 110,
    "position": 1,
    "text": "یکی رزمگاهست گویی درست"
  },
  {
    "poem_id": 1827,
    "vorder": 111,
    "position": 0,
    "text": "ز گفتار او شاد شد شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 112,
    "position": 1,
    "text": "ورا نیک پی خواند و به روزگار"
  },
  {
    "poem_id": 1827,
    "vorder": 113,
    "position": 0,
    "text": "بفرمود تا موبدان و ردان"
  },
  {
    "poem_id": 1827,
    "vorder": 114,
    "position": 1,
    "text": "برفتند با نامور بخردان"
  },
  {
    "poem_id": 1827,
    "vorder": 115,
    "position": 0,
    "text": "فرستاده رای را پیش خواند"
  },
  {
    "poem_id": 1827,
    "vorder": 116,
    "position": 1,
    "text": "بران نامور پیشگاهش نشاند"
  },
  {
    "poem_id": 1827,
    "vorder": 117,
    "position": 0,
    "text": "بدو گفت گوینده بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 118,
    "position": 1,
    "text": "که ای موبد رای خورشید چهر"
  },
  {
    "poem_id": 1827,
    "vorder": 119,
    "position": 0,
    "text": "ازین مهرها رای با توچه گفت"
  },
  {
    "poem_id": 1827,
    "vorder": 120,
    "position": 1,
    "text": "که همواره با توخرد باد جفت"
  },
  {
    "poem_id": 1827,
    "vorder": 121,
    "position": 0,
    "text": "چنین داد پاسخ که فرخنده‌رای"
  },
  {
    "poem_id": 1827,
    "vorder": 122,
    "position": 1,
    "text": "چو از پیش او من برفتم ز جای"
  },
  {
    "poem_id": 1827,
    "vorder": 123,
    "position": 0,
    "text": "مرا گفت کین مهرهٔ ساج و عاج"
  },
  {
    "poem_id": 1827,
    "vorder": 124,
    "position": 1,
    "text": "ببر پیش تخت خداوند تاج"
  },
  {
    "poem_id": 1827,
    "vorder": 125,
    "position": 0,
    "text": "بگویش که با موبد و رای‌زن"
  },
  {
    "poem_id": 1827,
    "vorder": 126,
    "position": 1,
    "text": "بنه پیش و بنشان یکی انجمن"
  },
  {
    "poem_id": 1827,
    "vorder": 127,
    "position": 0,
    "text": "گر این نغز بازی به جای آورند"
  },
  {
    "poem_id": 1827,
    "vorder": 128,
    "position": 1,
    "text": "پسندیده و دلربای آورند"
  },
  {
    "poem_id": 1827,
    "vorder": 129,
    "position": 0,
    "text": "همین بدره و برده و باژ و ساو"
  },
  {
    "poem_id": 1827,
    "vorder": 130,
    "position": 1,
    "text": "فرستیم چندانک داریم تاو"
  },
  {
    "poem_id": 1827,
    "vorder": 131,
    "position": 0,
    "text": "و گر شاه و فرزانگان این به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 132,
    "position": 1,
    "text": "نیارند روشن ندارند رای"
  },
  {
    "poem_id": 1827,
    "vorder": 133,
    "position": 0,
    "text": "نباید که خواهد ز ما باژ و گنج"
  },
  {
    "poem_id": 1827,
    "vorder": 134,
    "position": 1,
    "text": "دریغ آیدش جان دانا به رنج"
  },
  {
    "poem_id": 1827,
    "vorder": 135,
    "position": 0,
    "text": "چو بیند دل و رای باریک ما"
  },
  {
    "poem_id": 1827,
    "vorder": 136,
    "position": 1,
    "text": "فزونتر فرستد به نزدیک ما"
  },
  {
    "poem_id": 1827,
    "vorder": 137,
    "position": 0,
    "text": "برتخت آن شاه بیداربخت"
  },
  {
    "poem_id": 1827,
    "vorder": 138,
    "position": 1,
    "text": "بیاورد و بنهاد شطرنج وتخت"
  },
  {
    "poem_id": 1827,
    "vorder": 139,
    "position": 0,
    "text": "چنین گفت با موبدان و ردان"
  },
  {
    "poem_id": 1827,
    "vorder": 140,
    "position": 1,
    "text": "که‌ای نامور پاک دل بخردان"
  },
  {
    "poem_id": 1827,
    "vorder": 141,
    "position": 0,
    "text": "همه گوش دارید گفتار اوی"
  },
  {
    "poem_id": 1827,
    "vorder": 142,
    "position": 1,
    "text": "هم آن را هشیار سالار اوی"
  },
  {
    "poem_id": 1827,
    "vorder": 143,
    "position": 0,
    "text": "بیاراست دانا یکی رزمگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 144,
    "position": 1,
    "text": "به قلب اندرون ساخته جای شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 145,
    "position": 0,
    "text": "چپ و راست صف برکشیده سوار"
  },
  {
    "poem_id": 1827,
    "vorder": 146,
    "position": 1,
    "text": "پیاده به پیش اندرون نیزه دار"
  },
  {
    "poem_id": 1827,
    "vorder": 147,
    "position": 0,
    "text": "هشیوار دستور در پیش شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 148,
    "position": 1,
    "text": "به رزم اندرونش نماینده راه"
  },
  {
    "poem_id": 1827,
    "vorder": 149,
    "position": 0,
    "text": "مبارز که اسب افگند بر دو روی"
  },
  {
    "poem_id": 1827,
    "vorder": 150,
    "position": 1,
    "text": "به دست چپش پیل پرخاشجوی"
  },
  {
    "poem_id": 1827,
    "vorder": 151,
    "position": 0,
    "text": "وزو برتر اسبان جنگی به پای"
  },
  {
    "poem_id": 1827,
    "vorder": 152,
    "position": 1,
    "text": "بدان تاکه آید به بالای رای"
  },
  {
    "poem_id": 1827,
    "vorder": 153,
    "position": 0,
    "text": "چو بوزرجمهر آن سپه را براند"
  },
  {
    "poem_id": 1827,
    "vorder": 154,
    "position": 1,
    "text": "همه انجمن درشگفتی بماند"
  },
  {
    "poem_id": 1827,
    "vorder": 155,
    "position": 0,
    "text": "غمی شد فرستادهٔ هند سخت"
  },
  {
    "poem_id": 1827,
    "vorder": 156,
    "position": 1,
    "text": "بماند اندر آن کار هشیار بخت"
  },
  {
    "poem_id": 1827,
    "vorder": 157,
    "position": 0,
    "text": "شگفت اندرو مرد جادو بماند"
  },
  {
    "poem_id": 1827,
    "vorder": 158,
    "position": 1,
    "text": "دلش را به اندیشه اندر نشاند"
  },
  {
    "poem_id": 1827,
    "vorder": 159,
    "position": 0,
    "text": "که این تخت شطرنج هرگز ندید"
  },
  {
    "poem_id": 1827,
    "vorder": 160,
    "position": 1,
    "text": "نه از کاردانان هندی شنید"
  },
  {
    "poem_id": 1827,
    "vorder": 161,
    "position": 0,
    "text": "چگونه فراز آمدش رای این"
  },
  {
    "poem_id": 1827,
    "vorder": 162,
    "position": 1,
    "text": "به گیتی نگیرد کسی جای این"
  },
  {
    "poem_id": 1827,
    "vorder": 163,
    "position": 0,
    "text": "چنان گشت کسری ز بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 164,
    "position": 1,
    "text": "که گفتی بدوبخت بنمود چهر"
  },
  {
    "poem_id": 1827,
    "vorder": 165,
    "position": 0,
    "text": "یکی جام فرمود پس شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 166,
    "position": 1,
    "text": "که کردند پرگوهر شاهوار"
  },
  {
    "poem_id": 1827,
    "vorder": 167,
    "position": 0,
    "text": "یکی بدره دینار واسبی به زین"
  },
  {
    "poem_id": 1827,
    "vorder": 168,
    "position": 1,
    "text": "بدو داد و کردش بسی آفرین"
  },
  {
    "poem_id": 1827,
    "vorder": 169,
    "position": 0,
    "text": "بشد مرد دانا به آرام خویش"
  },
  {
    "poem_id": 1827,
    "vorder": 170,
    "position": 1,
    "text": "یکی تخت و پرگار بنهاد پیش"
  },
  {
    "poem_id": 1827,
    "vorder": 171,
    "position": 0,
    "text": "به شطرنج و اندیشهٔ هندوان"
  },
  {
    "poem_id": 1827,
    "vorder": 172,
    "position": 1,
    "text": "نگه کرد و بفزود رنج روان"
  },
  {
    "poem_id": 1827,
    "vorder": 173,
    "position": 0,
    "text": "خرد بادل روشن انباز کرد"
  },
  {
    "poem_id": 1827,
    "vorder": 174,
    "position": 1,
    "text": "به اندیشه بنهاد برتخت نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 175,
    "position": 0,
    "text": "دومهره بفرمود کردن ز عاج"
  },
  {
    "poem_id": 1827,
    "vorder": 176,
    "position": 1,
    "text": "همه پیکر عاج همرنگ ساج"
  },
  {
    "poem_id": 1827,
    "vorder": 177,
    "position": 0,
    "text": "یکی رزمگه ساخت شطرنج وار"
  },
  {
    "poem_id": 1827,
    "vorder": 178,
    "position": 1,
    "text": "دو رویه برآراسته کارزار"
  },
  {
    "poem_id": 1827,
    "vorder": 179,
    "position": 0,
    "text": "دولشکر ببخشید بر هشت بهر"
  },
  {
    "poem_id": 1827,
    "vorder": 180,
    "position": 1,
    "text": "همه رزمجویان گیرنده شهر"
  },
  {
    "poem_id": 1827,
    "vorder": 181,
    "position": 0,
    "text": "زمین وار لشکر گهی چارسوی"
  },
  {
    "poem_id": 1827,
    "vorder": 182,
    "position": 1,
    "text": "دوشاه گرانمایه و نیک خوی"
  },
  {
    "poem_id": 1827,
    "vorder": 183,
    "position": 0,
    "text": "کم و بیش دارند هر دو به هم"
  },
  {
    "poem_id": 1827,
    "vorder": 184,
    "position": 1,
    "text": "یکی از دگر برنگیرد ستم"
  },
  {
    "poem_id": 1827,
    "vorder": 185,
    "position": 0,
    "text": "به فرمان ایشان سپاه از دو روی"
  },
  {
    "poem_id": 1827,
    "vorder": 186,
    "position": 1,
    "text": "به تندی بیاراسته جنگجوی"
  },
  {
    "poem_id": 1827,
    "vorder": 187,
    "position": 0,
    "text": "یکی را چوتنها بگیرد دو تن"
  },
  {
    "poem_id": 1827,
    "vorder": 188,
    "position": 1,
    "text": "ز لشکر برین یک تن آید شکن"
  },
  {
    "poem_id": 1827,
    "vorder": 189,
    "position": 0,
    "text": "به هرجای پیش وپس اندر سپاه"
  },
  {
    "poem_id": 1827,
    "vorder": 190,
    "position": 1,
    "text": "گرازان دو شاه اندران رزمگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 191,
    "position": 0,
    "text": "همی این بران آن برین برگذشت"
  },
  {
    "poem_id": 1827,
    "vorder": 192,
    "position": 1,
    "text": "گهی رزم کوه و گهی رزم دشت"
  },
  {
    "poem_id": 1827,
    "vorder": 193,
    "position": 0,
    "text": "برین گونه تا بر که بودی شکن"
  },
  {
    "poem_id": 1827,
    "vorder": 194,
    "position": 1,
    "text": "شدندی دو شاه و سپاه انجمن"
  },
  {
    "poem_id": 1827,
    "vorder": 195,
    "position": 0,
    "text": "بدین سان که گفتم بیاراست نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 196,
    "position": 1,
    "text": "برشاه شد یک به یک یاد کرد"
  },
  {
    "poem_id": 1827,
    "vorder": 197,
    "position": 0,
    "text": "وزان رفتن شاه برترمنش"
  },
  {
    "poem_id": 1827,
    "vorder": 198,
    "position": 1,
    "text": "همانش ستایش همان سرزنش"
  },
  {
    "poem_id": 1827,
    "vorder": 199,
    "position": 0,
    "text": "ز نیروی و فرمان و جنگ سپاه"
  },
  {
    "poem_id": 1827,
    "vorder": 200,
    "position": 1,
    "text": "بگسترد و بنمود یک یک بشاه"
  },
  {
    "poem_id": 1827,
    "vorder": 201,
    "position": 0,
    "text": "دل شاه ایران ازو خیره ماند"
  },
  {
    "poem_id": 1827,
    "vorder": 202,
    "position": 1,
    "text": "خرد را باندیشه اندر نشاند"
  },
  {
    "poem_id": 1827,
    "vorder": 203,
    "position": 0,
    "text": "همی‌گفت کای مرد روشن‌روان"
  },
  {
    "poem_id": 1827,
    "vorder": 204,
    "position": 1,
    "text": "جوان بادی و روزگارت جوان"
  },
  {
    "poem_id": 1827,
    "vorder": 205,
    "position": 0,
    "text": "بفرمود تا ساروان دو هزار"
  },
  {
    "poem_id": 1827,
    "vorder": 206,
    "position": 1,
    "text": "بیارد شتر تا در شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 207,
    "position": 0,
    "text": "ز باری که خیزد ز روم و ز چین"
  },
  {
    "poem_id": 1827,
    "vorder": 208,
    "position": 1,
    "text": "ز هیتال و مکران و ایران زمین"
  },
  {
    "poem_id": 1827,
    "vorder": 209,
    "position": 0,
    "text": "ز گنج شهنشاه کردند بار"
  },
  {
    "poem_id": 1827,
    "vorder": 210,
    "position": 1,
    "text": "بشد کاروان از در شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 211,
    "position": 0,
    "text": "چوشد بارهای شتر ساخته"
  },
  {
    "poem_id": 1827,
    "vorder": 212,
    "position": 1,
    "text": "دل شاه زان کار پرداخته"
  },
  {
    "poem_id": 1827,
    "vorder": 213,
    "position": 0,
    "text": "فرستادهٔ رای را پیش خواند"
  },
  {
    "poem_id": 1827,
    "vorder": 214,
    "position": 1,
    "text": "ز دانش فراوان سخنها براند"
  },
  {
    "poem_id": 1827,
    "vorder": 215,
    "position": 0,
    "text": "یکی نامه بنوشت نزدیک اوی"
  },
  {
    "poem_id": 1827,
    "vorder": 216,
    "position": 1,
    "text": "پر از دانش و رامش و رنگ و بوی"
  },
  {
    "poem_id": 1827,
    "vorder": 217,
    "position": 0,
    "text": "سر نامه کرد آفرین بزرگ"
  },
  {
    "poem_id": 1827,
    "vorder": 218,
    "position": 1,
    "text": "به یزدان پناهش ز دیو سترگ"
  },
  {
    "poem_id": 1827,
    "vorder": 219,
    "position": 0,
    "text": "دگر گفت کای نامور شاه هند"
  },
  {
    "poem_id": 1827,
    "vorder": 220,
    "position": 1,
    "text": "ز دریای قنوج تا پیش سند"
  },
  {
    "poem_id": 1827,
    "vorder": 221,
    "position": 0,
    "text": "رسیداین فرستادهٔ رای‌زن"
  },
  {
    "poem_id": 1827,
    "vorder": 222,
    "position": 1,
    "text": "ابا چتر و پیلان بدین انجمن"
  },
  {
    "poem_id": 1827,
    "vorder": 223,
    "position": 0,
    "text": "همان تخت شطرنج و پیغام رای"
  },
  {
    "poem_id": 1827,
    "vorder": 224,
    "position": 1,
    "text": "شنیدیم و پیغامش امد بجای"
  },
  {
    "poem_id": 1827,
    "vorder": 225,
    "position": 0,
    "text": "ز دانای هندی زمان خواستیم"
  },
  {
    "poem_id": 1827,
    "vorder": 226,
    "position": 1,
    "text": "به دانش روان را بیاراستیم"
  },
  {
    "poem_id": 1827,
    "vorder": 227,
    "position": 0,
    "text": "بسی رای زد موبد پاک‌رای"
  },
  {
    "poem_id": 1827,
    "vorder": 228,
    "position": 1,
    "text": "پژوهید وآورد بازی به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 229,
    "position": 0,
    "text": "کنون آمد این موبد هوشمند"
  },
  {
    "poem_id": 1827,
    "vorder": 230,
    "position": 1,
    "text": "به قنوج نزدیک رای بلند"
  },
  {
    "poem_id": 1827,
    "vorder": 231,
    "position": 0,
    "text": "شتروار بار گران دو هزار"
  },
  {
    "poem_id": 1827,
    "vorder": 232,
    "position": 1,
    "text": "پسندیده بار از در شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 233,
    "position": 0,
    "text": "نهادیم برجای شطرنج نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 234,
    "position": 1,
    "text": "کنون تا به بازی که آرد نبرد"
  },
  {
    "poem_id": 1827,
    "vorder": 235,
    "position": 0,
    "text": "برهمن فراوان بود پاک‌رای"
  },
  {
    "poem_id": 1827,
    "vorder": 236,
    "position": 1,
    "text": "که این بازی آرد به دانش به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 237,
    "position": 0,
    "text": "ز چیزی که دید این فرستاده رنج"
  },
  {
    "poem_id": 1827,
    "vorder": 238,
    "position": 1,
    "text": "فرستد همه رای هندی به گنج"
  },
  {
    "poem_id": 1827,
    "vorder": 239,
    "position": 0,
    "text": "ور ایدون کجا رای با راهنمای"
  },
  {
    "poem_id": 1827,
    "vorder": 240,
    "position": 1,
    "text": "بکوشند بازی نیاید به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 241,
    "position": 0,
    "text": "شتروار باید که هم زین شمار"
  },
  {
    "poem_id": 1827,
    "vorder": 242,
    "position": 1,
    "text": "به پیمان کند رای قنوج بار"
  },
  {
    "poem_id": 1827,
    "vorder": 243,
    "position": 0,
    "text": "کند بار همراه با بار ما"
  },
  {
    "poem_id": 1827,
    "vorder": 244,
    "position": 1,
    "text": "چنینست پیمان و بازار ما"
  },
  {
    "poem_id": 1827,
    "vorder": 245,
    "position": 0,
    "text": "چوخورشید رخشنده شد بر سپهر"
  },
  {
    "poem_id": 1827,
    "vorder": 246,
    "position": 1,
    "text": "برفت از در شاه بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 247,
    "position": 0,
    "text": "چو آمد ز ایران به نزدیک رای"
  },
  {
    "poem_id": 1827,
    "vorder": 248,
    "position": 1,
    "text": "برهمن بشادی ورا رهنمای"
  },
  {
    "poem_id": 1827,
    "vorder": 249,
    "position": 0,
    "text": "ابا بار با نامه وتخت نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 250,
    "position": 1,
    "text": "دلش پر ز بازار ننگ ونبرد"
  },
  {
    "poem_id": 1827,
    "vorder": 251,
    "position": 0,
    "text": "چو آمد به نزدیکی تخت اوی"
  },
  {
    "poem_id": 1827,
    "vorder": 252,
    "position": 1,
    "text": "بدید آن سر و افسر و بخت اوی"
  },
  {
    "poem_id": 1827,
    "vorder": 253,
    "position": 0,
    "text": "فراوانش بستود بر پهلوی"
  },
  {
    "poem_id": 1827,
    "vorder": 254,
    "position": 1,
    "text": "بدو داد پس نامهٔ خسروی"
  },
  {
    "poem_id": 1827,
    "vorder": 255,
    "position": 0,
    "text": "ز شطرنج وز راه وز رنج رای"
  },
  {
    "poem_id": 1827,
    "vorder": 256,
    "position": 1,
    "text": "بگفت آنچه آمد یکایک به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 257,
    "position": 0,
    "text": "پیام شهنشاه با او بگفت"
  },
  {
    "poem_id": 1827,
    "vorder": 258,
    "position": 1,
    "text": "رخ رای هندی چوگل برشگفت"
  },
  {
    "poem_id": 1827,
    "vorder": 259,
    "position": 0,
    "text": "بگفت آن کجا دید پاینده مرد"
  },
  {
    "poem_id": 1827,
    "vorder": 260,
    "position": 1,
    "text": "چنان هم سراسر بیاورد نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 261,
    "position": 0,
    "text": "ز بازی و از مهره و رای شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 262,
    "position": 1,
    "text": "وزان موبدان نماینده راه"
  },
  {
    "poem_id": 1827,
    "vorder": 263,
    "position": 0,
    "text": "به نامه دورن آنچه کردست یاد"
  },
  {
    "poem_id": 1827,
    "vorder": 264,
    "position": 1,
    "text": "بخواند بداند نپیچد ز داد"
  },
  {
    "poem_id": 1827,
    "vorder": 265,
    "position": 0,
    "text": "ز گفتار اوشد رخ شاه زرد"
  },
  {
    "poem_id": 1827,
    "vorder": 266,
    "position": 1,
    "text": "چو بشنید گفتار شطرنج و نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 267,
    "position": 0,
    "text": "بیامد یکی نامور کدخدای"
  },
  {
    "poem_id": 1827,
    "vorder": 268,
    "position": 1,
    "text": "فرستاده را داد شایسته‌جای"
  },
  {
    "poem_id": 1827,
    "vorder": 269,
    "position": 0,
    "text": "یکی خرم ایوان بیاراستند"
  },
  {
    "poem_id": 1827,
    "vorder": 270,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1827,
    "vorder": 271,
    "position": 0,
    "text": "زمان خواست پس نامور هفت روز"
  },
  {
    "poem_id": 1827,
    "vorder": 272,
    "position": 1,
    "text": "برفت آنک بودند دانش فروز"
  },
  {
    "poem_id": 1827,
    "vorder": 273,
    "position": 0,
    "text": "به کشور ز پیران شایسته مرد"
  },
  {
    "poem_id": 1827,
    "vorder": 274,
    "position": 1,
    "text": "یکی انجمن کرد و بنهاد نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 275,
    "position": 0,
    "text": "به یک هفته آنکس که بد تیزویر"
  },
  {
    "poem_id": 1827,
    "vorder": 276,
    "position": 1,
    "text": "ازان نامداران برنا و پیر"
  },
  {
    "poem_id": 1827,
    "vorder": 277,
    "position": 0,
    "text": "همی‌بازجستند بازی نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 278,
    "position": 1,
    "text": "به رشک و برای وبه ننگ و نبرد"
  },
  {
    "poem_id": 1827,
    "vorder": 279,
    "position": 0,
    "text": "بهشتم چنین گفت موبد به رای"
  },
  {
    "poem_id": 1827,
    "vorder": 280,
    "position": 1,
    "text": "که این را نداند کسی سر زپای"
  },
  {
    "poem_id": 1827,
    "vorder": 281,
    "position": 0,
    "text": "مگر با روان یار گردد خرد"
  },
  {
    "poem_id": 1827,
    "vorder": 282,
    "position": 1,
    "text": "کزین مهره بازی برون آورد"
  },
  {
    "poem_id": 1827,
    "vorder": 283,
    "position": 0,
    "text": "بیامد نهم روز بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 284,
    "position": 1,
    "text": "پر از آرزو دل پرآژنگ چهر"
  },
  {
    "poem_id": 1827,
    "vorder": 285,
    "position": 0,
    "text": "که کسری نفرمود ما را درنگ"
  },
  {
    "poem_id": 1827,
    "vorder": 286,
    "position": 1,
    "text": "نباید که گردد دل شاه تنگ"
  },
  {
    "poem_id": 1827,
    "vorder": 287,
    "position": 0,
    "text": "بشد موبدان را ازان دل دژم"
  },
  {
    "poem_id": 1827,
    "vorder": 288,
    "position": 1,
    "text": "روان پر زغم ابروان پر زخم"
  },
  {
    "poem_id": 1827,
    "vorder": 289,
    "position": 0,
    "text": "بزرگان دانا به یک سو شدند"
  },
  {
    "poem_id": 1827,
    "vorder": 290,
    "position": 1,
    "text": "به نادانی خویش خستو شدند"
  },
  {
    "poem_id": 1827,
    "vorder": 291,
    "position": 0,
    "text": "چو آن دید بنشست بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 292,
    "position": 1,
    "text": "همه موبدان برگشادند چهر"
  },
  {
    "poem_id": 1827,
    "vorder": 293,
    "position": 0,
    "text": "بگسترد پیش اندرون تخت نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 294,
    "position": 1,
    "text": "همه گردش مهرها یاد کرد"
  },
  {
    "poem_id": 1827,
    "vorder": 295,
    "position": 0,
    "text": "سپهدار بنمود و جنگ سپاه"
  },
  {
    "poem_id": 1827,
    "vorder": 296,
    "position": 1,
    "text": "هم آرایش رزم و فرمان شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 297,
    "position": 0,
    "text": "ازو خیره شد رای با رای‌زن"
  },
  {
    "poem_id": 1827,
    "vorder": 298,
    "position": 1,
    "text": "ز کشور بسی نامدار انجمن"
  },
  {
    "poem_id": 1827,
    "vorder": 299,
    "position": 0,
    "text": "همه مهتران آفرین خواندند"
  },
  {
    "poem_id": 1827,
    "vorder": 300,
    "position": 1,
    "text": "ورا موبد پاک دین خواندند"
  },
  {
    "poem_id": 1827,
    "vorder": 301,
    "position": 0,
    "text": "ز هر دانشی زو بپرسید رای"
  },
  {
    "poem_id": 1827,
    "vorder": 302,
    "position": 1,
    "text": "همه پاسخ آمد یکایک به جای"
  },
  {
    "poem_id": 1827,
    "vorder": 303,
    "position": 0,
    "text": "خروشی برآمد ز دانندگان"
  },
  {
    "poem_id": 1827,
    "vorder": 304,
    "position": 1,
    "text": "ز دانش پژوهان وخوانندگان"
  },
  {
    "poem_id": 1827,
    "vorder": 305,
    "position": 0,
    "text": "که اینت سخنگوی داننده مرد"
  },
  {
    "poem_id": 1827,
    "vorder": 306,
    "position": 1,
    "text": "نه از بهر شطرنج و بازی نرد"
  },
  {
    "poem_id": 1827,
    "vorder": 307,
    "position": 0,
    "text": "بیاورد زان پس شتر دو هزار"
  },
  {
    "poem_id": 1827,
    "vorder": 308,
    "position": 1,
    "text": "همه گنج قنوح کردند بار"
  },
  {
    "poem_id": 1827,
    "vorder": 309,
    "position": 0,
    "text": "ز عود و ز عنبر ز کافور و زر"
  },
  {
    "poem_id": 1827,
    "vorder": 310,
    "position": 1,
    "text": "همه جامه وجام پیکر گهر"
  },
  {
    "poem_id": 1827,
    "vorder": 311,
    "position": 0,
    "text": "ابا باژ یکساله از پیشگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 312,
    "position": 1,
    "text": "فرستاد یک سر به درگاه شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 313,
    "position": 0,
    "text": "یکی افسری خواست از گنج رای"
  },
  {
    "poem_id": 1827,
    "vorder": 314,
    "position": 1,
    "text": "همان جامهٔ زر ز سر تا به پای"
  },
  {
    "poem_id": 1827,
    "vorder": 315,
    "position": 0,
    "text": "بدو داد وچند آفرین کرد نیز"
  },
  {
    "poem_id": 1827,
    "vorder": 316,
    "position": 1,
    "text": "بیارانش بخشید بسیار چیز"
  },
  {
    "poem_id": 1827,
    "vorder": 317,
    "position": 0,
    "text": "شتر دو هزار آنک از پیش برد"
  },
  {
    "poem_id": 1827,
    "vorder": 318,
    "position": 1,
    "text": "ابا باژ و هدیه مر او را سپرد"
  },
  {
    "poem_id": 1827,
    "vorder": 319,
    "position": 0,
    "text": "یکی کاروان بد که کس پیش ازان"
  },
  {
    "poem_id": 1827,
    "vorder": 320,
    "position": 1,
    "text": "نراند و نبد خواسته بیش ازان"
  },
  {
    "poem_id": 1827,
    "vorder": 321,
    "position": 0,
    "text": "بیامد ز قنوج بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 322,
    "position": 1,
    "text": "برافراخته سر بگردان سپهر"
  },
  {
    "poem_id": 1827,
    "vorder": 323,
    "position": 0,
    "text": "دلی شاد با نامه شاه هند"
  },
  {
    "poem_id": 1827,
    "vorder": 324,
    "position": 1,
    "text": "نبشته به هندی خطی بر پرند"
  },
  {
    "poem_id": 1827,
    "vorder": 325,
    "position": 0,
    "text": "که رای و بزرگان گوایی دهند"
  },
  {
    "poem_id": 1827,
    "vorder": 326,
    "position": 1,
    "text": "نه از بیم کزنیک رایی دهند"
  },
  {
    "poem_id": 1827,
    "vorder": 327,
    "position": 0,
    "text": "که چون شاه نوشین‌روان کس ندید"
  },
  {
    "poem_id": 1827,
    "vorder": 328,
    "position": 1,
    "text": "نه از موبد سالخورده شنید"
  },
  {
    "poem_id": 1827,
    "vorder": 329,
    "position": 0,
    "text": "نه کس دانشی تر ز دستور اوی"
  },
  {
    "poem_id": 1827,
    "vorder": 330,
    "position": 1,
    "text": "ز دانش سپهرست گنجور اوی"
  },
  {
    "poem_id": 1827,
    "vorder": 331,
    "position": 0,
    "text": "فرستاده شد باژ یک ساله پیش"
  },
  {
    "poem_id": 1827,
    "vorder": 332,
    "position": 1,
    "text": "اگر بیش باید فرستیم بیش"
  },
  {
    "poem_id": 1827,
    "vorder": 333,
    "position": 0,
    "text": "ز باژی که پیمان نهادیم نیز"
  },
  {
    "poem_id": 1827,
    "vorder": 334,
    "position": 1,
    "text": "فرستاده شد هرچ بایست چیز"
  },
  {
    "poem_id": 1827,
    "vorder": 335,
    "position": 0,
    "text": "چو آگاهی آمد ز دانا به شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 336,
    "position": 1,
    "text": "که با کام و با خوبی آمد ز راه"
  },
  {
    "poem_id": 1827,
    "vorder": 337,
    "position": 0,
    "text": "ازان آگهی شاد شد شهریار"
  },
  {
    "poem_id": 1827,
    "vorder": 338,
    "position": 1,
    "text": "بفرمود تاهرک بد نامدار"
  },
  {
    "poem_id": 1827,
    "vorder": 339,
    "position": 0,
    "text": "ز شهر و ز لشکر خبیره شدند"
  },
  {
    "poem_id": 1827,
    "vorder": 340,
    "position": 1,
    "text": "همه نامداران پذیره شدند"
  },
  {
    "poem_id": 1827,
    "vorder": 341,
    "position": 0,
    "text": "به شهر اندر آمد چنان ارجمند"
  },
  {
    "poem_id": 1827,
    "vorder": 342,
    "position": 1,
    "text": "به پیروزی شهریار بلند"
  },
  {
    "poem_id": 1827,
    "vorder": 343,
    "position": 0,
    "text": "به ایوان چو آمد به نزدیک تخت"
  },
  {
    "poem_id": 1827,
    "vorder": 344,
    "position": 1,
    "text": "برو شهریار آفرین کرد سخت"
  },
  {
    "poem_id": 1827,
    "vorder": 345,
    "position": 0,
    "text": "ببر در گرفتش جهاندار شاه"
  },
  {
    "poem_id": 1827,
    "vorder": 346,
    "position": 1,
    "text": "بپرسیدش از رای وز رنج راه"
  },
  {
    "poem_id": 1827,
    "vorder": 347,
    "position": 0,
    "text": "بگفت آنکجا رفت بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 348,
    "position": 1,
    "text": "ازان بخت بیدار و مهر سپهر"
  },
  {
    "poem_id": 1827,
    "vorder": 349,
    "position": 0,
    "text": "پس آن نامه رای پیروزبخت"
  },
  {
    "poem_id": 1827,
    "vorder": 350,
    "position": 1,
    "text": "بیاورد و بنهاد در پیش تخت"
  },
  {
    "poem_id": 1827,
    "vorder": 351,
    "position": 0,
    "text": "بفرمود تا یزدگرد دبیر"
  },
  {
    "poem_id": 1827,
    "vorder": 352,
    "position": 1,
    "text": "بیامد بر شاه دانش‌پذیر"
  },
  {
    "poem_id": 1827,
    "vorder": 353,
    "position": 0,
    "text": "چو آن نامه رای هندی بخواند"
  },
  {
    "poem_id": 1827,
    "vorder": 354,
    "position": 1,
    "text": "یکی انجمن درشگفتی بماند"
  },
  {
    "poem_id": 1827,
    "vorder": 355,
    "position": 0,
    "text": "هم از دانش و رای بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 356,
    "position": 1,
    "text": "ازان بخت سالار خورشید چهر"
  },
  {
    "poem_id": 1827,
    "vorder": 357,
    "position": 0,
    "text": "چنین گفت کسری که یزدان سپاس"
  },
  {
    "poem_id": 1827,
    "vorder": 358,
    "position": 1,
    "text": "که هستم خردمند و نیکی‌شناس"
  },
  {
    "poem_id": 1827,
    "vorder": 359,
    "position": 0,
    "text": "مهان تاج وتخت مرا بنده‌اند"
  },
  {
    "poem_id": 1827,
    "vorder": 360,
    "position": 1,
    "text": "دل وجان به مهر من آگنده‌اند"
  },
  {
    "poem_id": 1827,
    "vorder": 361,
    "position": 0,
    "text": "شگفتی‌تر از کار بوزرجمهر"
  },
  {
    "poem_id": 1827,
    "vorder": 362,
    "position": 1,
    "text": "که دانش بدو داد چندین سپهر"
  },
  {
    "poem_id": 1827,
    "vorder": 363,
    "position": 0,
    "text": "سپاس از خداوند خورشید وماه"
  },
  {
    "poem_id": 1827,
    "vorder": 364,
    "position": 1,
    "text": "کزویست پیروزی و دستگاه"
  },
  {
    "poem_id": 1827,
    "vorder": 365,
    "position": 0,
    "text": "برین داستان برسخن ساختم"
  },
  {
    "poem_id": 1827,
    "vorder": 366,
    "position": 1,
    "text": "به طلخند و شطرنج پرداختم"
  }
]