[
  {
    "poem_id": 1751,
    "vorder": 1,
    "position": 0,
    "text": "چو شاپور بنشست بر جای عم"
  },
  {
    "poem_id": 1751,
    "vorder": 2,
    "position": 1,
    "text": "از ایران بسی شاد و بهری دژم"
  },
  {
    "poem_id": 1751,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت کای نامور بخردان"
  },
  {
    "poem_id": 1751,
    "vorder": 4,
    "position": 1,
    "text": "جهاندیده و رای‌زن موبدان"
  },
  {
    "poem_id": 1751,
    "vorder": 5,
    "position": 0,
    "text": "بدانید کان کس که گوید دروغ"
  },
  {
    "poem_id": 1751,
    "vorder": 6,
    "position": 1,
    "text": "نگیرد ازین پس بر ما فروغ"
  },
  {
    "poem_id": 1751,
    "vorder": 7,
    "position": 0,
    "text": "دروغ از بر ما نباشد ز رای"
  },
  {
    "poem_id": 1751,
    "vorder": 8,
    "position": 1,
    "text": "که از رای باشد بزرگی به جای"
  },
  {
    "poem_id": 1751,
    "vorder": 9,
    "position": 0,
    "text": "همان مر تن سفله را دوستدار"
  },
  {
    "poem_id": 1751,
    "vorder": 10,
    "position": 1,
    "text": "نیابی به باغ اندرون چون نگار"
  },
  {
    "poem_id": 1751,
    "vorder": 11,
    "position": 0,
    "text": "سری را کجا مغز باشد بسی"
  },
  {
    "poem_id": 1751,
    "vorder": 12,
    "position": 1,
    "text": "گواژه نباید زدن بر کسی"
  },
  {
    "poem_id": 1751,
    "vorder": 13,
    "position": 0,
    "text": "زبان را نگهدار باید بدن"
  },
  {
    "poem_id": 1751,
    "vorder": 14,
    "position": 1,
    "text": "نباید روان را به زهر آژدن"
  },
  {
    "poem_id": 1751,
    "vorder": 15,
    "position": 0,
    "text": "که بر انجمن مرد بسیار گوی"
  },
  {
    "poem_id": 1751,
    "vorder": 16,
    "position": 1,
    "text": "بکاهد به گفتار خود آب‌روی"
  },
  {
    "poem_id": 1751,
    "vorder": 17,
    "position": 0,
    "text": "اگر دانشی مرد راند سخن"
  },
  {
    "poem_id": 1751,
    "vorder": 18,
    "position": 1,
    "text": "تو بشنو که دانش نگردد کهن"
  },
  {
    "poem_id": 1751,
    "vorder": 19,
    "position": 0,
    "text": "دل مرد مطمع بود پر ز درد"
  },
  {
    "poem_id": 1751,
    "vorder": 20,
    "position": 1,
    "text": "به گرد طمع تا توانی مگرد"
  },
  {
    "poem_id": 1751,
    "vorder": 21,
    "position": 0,
    "text": "مکن دوستی با دروغ آزمای"
  },
  {
    "poem_id": 1751,
    "vorder": 22,
    "position": 1,
    "text": "همان نیز با مرد ناپاک‌رای"
  },
  {
    "poem_id": 1751,
    "vorder": 23,
    "position": 0,
    "text": "سرشت تن از چار گوهر بود"
  },
  {
    "poem_id": 1751,
    "vorder": 24,
    "position": 1,
    "text": "گذر زین چهارانش کمتر بود"
  },
  {
    "poem_id": 1751,
    "vorder": 25,
    "position": 0,
    "text": "اگر سفله‌گر مرد با شرم و راد"
  },
  {
    "poem_id": 1751,
    "vorder": 26,
    "position": 1,
    "text": "به آزادگی یک دل و یک نهاد"
  },
  {
    "poem_id": 1751,
    "vorder": 27,
    "position": 0,
    "text": "سیم کو میانه گزیند ز کار"
  },
  {
    "poem_id": 1751,
    "vorder": 28,
    "position": 1,
    "text": "بسند آیدش بخشش کردگار"
  },
  {
    "poem_id": 1751,
    "vorder": 29,
    "position": 0,
    "text": "چهارم که بپراگند بر گزاف"
  },
  {
    "poem_id": 1751,
    "vorder": 30,
    "position": 1,
    "text": "همی دانشی نام جوید ز لاف"
  },
  {
    "poem_id": 1751,
    "vorder": 31,
    "position": 0,
    "text": "دو گیتی بیابد دل مرد راد"
  },
  {
    "poem_id": 1751,
    "vorder": 32,
    "position": 1,
    "text": "نباشد دل سفله یک روز شاد"
  },
  {
    "poem_id": 1751,
    "vorder": 33,
    "position": 0,
    "text": "بدین گیتی او را بود نام زشت"
  },
  {
    "poem_id": 1751,
    "vorder": 34,
    "position": 1,
    "text": "بدان گیتی‌اندر نیابد بهشت"
  },
  {
    "poem_id": 1751,
    "vorder": 35,
    "position": 0,
    "text": "دو گیتی نیابد دل مرد لاف"
  },
  {
    "poem_id": 1751,
    "vorder": 36,
    "position": 1,
    "text": "که بپراگند خواسته بر گزاف"
  },
  {
    "poem_id": 1751,
    "vorder": 37,
    "position": 0,
    "text": "ستوده کسی کو میانه گزید"
  },
  {
    "poem_id": 1751,
    "vorder": 38,
    "position": 1,
    "text": "تن خویش را آفرین گسترید"
  },
  {
    "poem_id": 1751,
    "vorder": 39,
    "position": 0,
    "text": "شما را جهان‌آفرین یار باد"
  },
  {
    "poem_id": 1751,
    "vorder": 40,
    "position": 1,
    "text": "همیشه سر بخت بیدار باد"
  },
  {
    "poem_id": 1751,
    "vorder": 41,
    "position": 0,
    "text": "جهاندارمان باد فریادرس"
  },
  {
    "poem_id": 1751,
    "vorder": 42,
    "position": 1,
    "text": "که تخت بزرگی نماند به کس"
  },
  {
    "poem_id": 1751,
    "vorder": 43,
    "position": 0,
    "text": "بگفت این و از پیش برخاستند"
  },
  {
    "poem_id": 1751,
    "vorder": 44,
    "position": 1,
    "text": "ز یزدان برو آفرین خواستند"
  },
  {
    "poem_id": 1751,
    "vorder": 45,
    "position": 0,
    "text": "چو شد سالیان پنج بر چار ماه"
  },
  {
    "poem_id": 1751,
    "vorder": 46,
    "position": 1,
    "text": "بشد شاه روزی به نخچیرگاه"
  },
  {
    "poem_id": 1751,
    "vorder": 47,
    "position": 0,
    "text": "جهان شد پر از یوز و باران و سگ"
  },
  {
    "poem_id": 1751,
    "vorder": 48,
    "position": 1,
    "text": "چه پرنده و چند تازان به تگ"
  },
  {
    "poem_id": 1751,
    "vorder": 49,
    "position": 0,
    "text": "ستاره زدند از پی خوابگاه"
  },
  {
    "poem_id": 1751,
    "vorder": 50,
    "position": 1,
    "text": "چو چیزی بخورد و بیاسود شاه"
  },
  {
    "poem_id": 1751,
    "vorder": 51,
    "position": 0,
    "text": "سه جام می خسروانی بخورد"
  },
  {
    "poem_id": 1751,
    "vorder": 52,
    "position": 1,
    "text": "پراندیشه شد سر سوی خواب کرد"
  },
  {
    "poem_id": 1751,
    "vorder": 53,
    "position": 0,
    "text": "پراگنده گشتند لشکر همه"
  },
  {
    "poem_id": 1751,
    "vorder": 54,
    "position": 1,
    "text": "چو در خواب شد شهریار رمه"
  },
  {
    "poem_id": 1751,
    "vorder": 55,
    "position": 0,
    "text": "بخفت او و از دشت برخاست باد"
  },
  {
    "poem_id": 1751,
    "vorder": 56,
    "position": 1,
    "text": "که کس باد ازان سان ندارد به یاد"
  },
  {
    "poem_id": 1751,
    "vorder": 57,
    "position": 0,
    "text": "فروبرده چوب ستاره بکند"
  },
  {
    "poem_id": 1751,
    "vorder": 58,
    "position": 1,
    "text": "بزد بر سر شهریار بلند"
  },
  {
    "poem_id": 1751,
    "vorder": 59,
    "position": 0,
    "text": "جهانجوی شاپور جنگی بمرد"
  },
  {
    "poem_id": 1751,
    "vorder": 60,
    "position": 1,
    "text": "کلاه کیی دیگری را سپرد"
  },
  {
    "poem_id": 1751,
    "vorder": 61,
    "position": 0,
    "text": "میاز و مناز و متاز و مرنج"
  },
  {
    "poem_id": 1751,
    "vorder": 62,
    "position": 1,
    "text": "چه تازی به کین و چه نازی به گنج"
  },
  {
    "poem_id": 1751,
    "vorder": 63,
    "position": 0,
    "text": "که بهر تو اینست زین تیره‌گوی"
  },
  {
    "poem_id": 1751,
    "vorder": 64,
    "position": 1,
    "text": "هنر جوی و راز جهان را مجوی"
  },
  {
    "poem_id": 1751,
    "vorder": 65,
    "position": 0,
    "text": "که گر بازیابی به پیچی بدرد"
  },
  {
    "poem_id": 1751,
    "vorder": 66,
    "position": 1,
    "text": "پژوهش مکن گرد رازش مگرد"
  },
  {
    "poem_id": 1751,
    "vorder": 67,
    "position": 0,
    "text": "چنین است کردار این چرخ تیر"
  },
  {
    "poem_id": 1751,
    "vorder": 68,
    "position": 1,
    "text": "چه با مرد برنا چه با مردپیر"
  }
]