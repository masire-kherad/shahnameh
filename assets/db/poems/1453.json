[
  {
    "poem_id": 1453,
    "vorder": 1,
    "position": 0,
    "text": "بیامد سوی پارس کاووس کی"
  },
  {
    "poem_id": 1453,
    "vorder": 2,
    "position": 1,
    "text": "جهانی به شادی نوافگند پی"
  },
  {
    "poem_id": 1453,
    "vorder": 3,
    "position": 0,
    "text": "بیاراست تخت و بگسترد داد"
  },
  {
    "poem_id": 1453,
    "vorder": 4,
    "position": 1,
    "text": "به شادی و خوردن دل اندر نهاد"
  },
  {
    "poem_id": 1453,
    "vorder": 5,
    "position": 0,
    "text": "فرستاد هر سو یکی پهلوان"
  },
  {
    "poem_id": 1453,
    "vorder": 6,
    "position": 1,
    "text": "جهاندار و بیدار و روشن‌روان"
  },
  {
    "poem_id": 1453,
    "vorder": 7,
    "position": 0,
    "text": "به مرو و نشاپور و بلخ و هری"
  },
  {
    "poem_id": 1453,
    "vorder": 8,
    "position": 1,
    "text": "فرستاد بر هر سویی لشکری"
  },
  {
    "poem_id": 1453,
    "vorder": 9,
    "position": 0,
    "text": "جهانی پر از داد شد یکسره"
  },
  {
    "poem_id": 1453,
    "vorder": 10,
    "position": 1,
    "text": "همی روی برتافت گرگ از بره"
  },
  {
    "poem_id": 1453,
    "vorder": 11,
    "position": 0,
    "text": "ز بس گنج و زیبایی و فرهی"
  },
  {
    "poem_id": 1453,
    "vorder": 12,
    "position": 1,
    "text": "پری و دد و دام گشتش رهی"
  },
  {
    "poem_id": 1453,
    "vorder": 13,
    "position": 0,
    "text": "مهان پیش کاووس کهتر شدند"
  },
  {
    "poem_id": 1453,
    "vorder": 14,
    "position": 1,
    "text": "همه تاجدارنش لشکر شدند"
  },
  {
    "poem_id": 1453,
    "vorder": 15,
    "position": 0,
    "text": "جهان پهلوانی به رستم سپرد"
  },
  {
    "poem_id": 1453,
    "vorder": 16,
    "position": 1,
    "text": "همه روزگار بهی زو شمرد"
  },
  {
    "poem_id": 1453,
    "vorder": 17,
    "position": 0,
    "text": "یکی خانه کرد اندر البرز کوه"
  },
  {
    "poem_id": 1453,
    "vorder": 18,
    "position": 1,
    "text": "که دیو اندران رنج‌ها شد ستوه"
  },
  {
    "poem_id": 1453,
    "vorder": 19,
    "position": 0,
    "text": "بفرمود کز سنگ خارا کنند"
  },
  {
    "poem_id": 1453,
    "vorder": 20,
    "position": 1,
    "text": "دو خانه برو هر یکی ده کمند"
  },
  {
    "poem_id": 1453,
    "vorder": 21,
    "position": 0,
    "text": "بیاراست آخر به سنگ اندرون"
  },
  {
    "poem_id": 1453,
    "vorder": 22,
    "position": 1,
    "text": "ز پولاد میخ و ز خارا ستون"
  },
  {
    "poem_id": 1453,
    "vorder": 23,
    "position": 0,
    "text": "ببستند اسپان جنگی بدوی"
  },
  {
    "poem_id": 1453,
    "vorder": 24,
    "position": 1,
    "text": "هم اشتر عماری‌کش و راه جوی"
  },
  {
    "poem_id": 1453,
    "vorder": 25,
    "position": 0,
    "text": "دو خانه دگر ز آبگینه بساخت"
  },
  {
    "poem_id": 1453,
    "vorder": 26,
    "position": 1,
    "text": "زبرجد به هر جایش اندر نشاخت"
  },
  {
    "poem_id": 1453,
    "vorder": 27,
    "position": 0,
    "text": "چنان ساخت جای خرام و خورش"
  },
  {
    "poem_id": 1453,
    "vorder": 28,
    "position": 1,
    "text": "که تن یابد از خوردنی پرورش"
  },
  {
    "poem_id": 1453,
    "vorder": 29,
    "position": 0,
    "text": "دو خانه ز بهر سلیح نبرد"
  },
  {
    "poem_id": 1453,
    "vorder": 30,
    "position": 1,
    "text": "بفرمو کز نقرهٔ خام کرد"
  },
  {
    "poem_id": 1453,
    "vorder": 31,
    "position": 0,
    "text": "یکی کاخ زرین ز بهر نشست"
  },
  {
    "poem_id": 1453,
    "vorder": 32,
    "position": 1,
    "text": "برآورد و بالاش داده دو شست"
  },
  {
    "poem_id": 1453,
    "vorder": 33,
    "position": 0,
    "text": "نبودی تموز ایچ پیدا ز دی"
  },
  {
    "poem_id": 1453,
    "vorder": 34,
    "position": 1,
    "text": "هوا عنبرین بود و بارانش می"
  },
  {
    "poem_id": 1453,
    "vorder": 35,
    "position": 0,
    "text": "به ایوانش یاقوت برده بکار"
  },
  {
    "poem_id": 1453,
    "vorder": 36,
    "position": 1,
    "text": "ز پیروزه کرده برو بر نگار"
  },
  {
    "poem_id": 1453,
    "vorder": 37,
    "position": 0,
    "text": "همه ساله روشن بهاران بدی"
  },
  {
    "poem_id": 1453,
    "vorder": 38,
    "position": 1,
    "text": "گلان چون رخ غمگساران بدی"
  },
  {
    "poem_id": 1453,
    "vorder": 39,
    "position": 0,
    "text": "ز درد و غم و رنج دل دور بود"
  },
  {
    "poem_id": 1453,
    "vorder": 40,
    "position": 1,
    "text": "بدی را تن دیو رنجور بود"
  },
  {
    "poem_id": 1453,
    "vorder": 41,
    "position": 0,
    "text": "به خواب اندر آمد بد روزگار"
  },
  {
    "poem_id": 1453,
    "vorder": 42,
    "position": 1,
    "text": "ز خوبی و از داد آموزگار"
  },
  {
    "poem_id": 1453,
    "vorder": 43,
    "position": 0,
    "text": "به رنجش گرفتار دیوان بدند"
  },
  {
    "poem_id": 1453,
    "vorder": 44,
    "position": 1,
    "text": "ز بادافرهٔ او غریوان بدند"
  }
]