[
  {
    "poem_id": 1473,
    "vorder": 1,
    "position": 0,
    "text": "به آوردگه رفت نیزه بکفت"
  },
  {
    "poem_id": 1473,
    "vorder": 2,
    "position": 1,
    "text": "همی ماند از گفت مادر شگفت"
  },
  {
    "poem_id": 1473,
    "vorder": 3,
    "position": 0,
    "text": "یکی تنگ میدان فرو ساختند"
  },
  {
    "poem_id": 1473,
    "vorder": 4,
    "position": 1,
    "text": "به کوتاه نیزه همی بافتند"
  },
  {
    "poem_id": 1473,
    "vorder": 5,
    "position": 0,
    "text": "نماند ایچ بر نیزه بند و سنان"
  },
  {
    "poem_id": 1473,
    "vorder": 6,
    "position": 1,
    "text": "به چپ باز بردند هر دو عنان"
  },
  {
    "poem_id": 1473,
    "vorder": 7,
    "position": 0,
    "text": "به شمشیر هندی برآویختند"
  },
  {
    "poem_id": 1473,
    "vorder": 8,
    "position": 1,
    "text": "همی ز آهن آتش فرو ریختند"
  },
  {
    "poem_id": 1473,
    "vorder": 9,
    "position": 0,
    "text": "به زخم اندرون تیغ شد ریز ریز"
  },
  {
    "poem_id": 1473,
    "vorder": 10,
    "position": 1,
    "text": "چه زخمی که پیدا کند رستخیز"
  },
  {
    "poem_id": 1473,
    "vorder": 11,
    "position": 0,
    "text": "گرفتند زان پس عمود گران"
  },
  {
    "poem_id": 1473,
    "vorder": 12,
    "position": 1,
    "text": "غمی گشت بازوی کندآوران"
  },
  {
    "poem_id": 1473,
    "vorder": 13,
    "position": 0,
    "text": "ز نیرو عمود اندر آورد خم"
  },
  {
    "poem_id": 1473,
    "vorder": 14,
    "position": 1,
    "text": "دمان باد پایان و گردان دژم"
  },
  {
    "poem_id": 1473,
    "vorder": 15,
    "position": 0,
    "text": "ز اسپان فرو ریخت برگستوان"
  },
  {
    "poem_id": 1473,
    "vorder": 16,
    "position": 1,
    "text": "زره پاره شد بر میان گوان"
  },
  {
    "poem_id": 1473,
    "vorder": 17,
    "position": 0,
    "text": "فرو ماند اسپ و دلاور ز کار"
  },
  {
    "poem_id": 1473,
    "vorder": 18,
    "position": 1,
    "text": "یکی را نبد چنگ و بازو به کار"
  },
  {
    "poem_id": 1473,
    "vorder": 19,
    "position": 0,
    "text": "تن از خوی پر آب و همه کام خاک"
  },
  {
    "poem_id": 1473,
    "vorder": 20,
    "position": 1,
    "text": "زبان گشته از تشنگی چاک چاک"
  },
  {
    "poem_id": 1473,
    "vorder": 21,
    "position": 0,
    "text": "یک از یکدگر ایستادند دور"
  },
  {
    "poem_id": 1473,
    "vorder": 22,
    "position": 1,
    "text": "پر از درد باب و پر از رنج پور"
  },
  {
    "poem_id": 1473,
    "vorder": 23,
    "position": 0,
    "text": "جهانا شگفتی ز کردار تست"
  },
  {
    "poem_id": 1473,
    "vorder": 24,
    "position": 1,
    "text": "هم از تو شکسته هم از تو درست"
  },
  {
    "poem_id": 1473,
    "vorder": 25,
    "position": 0,
    "text": "ازین دو یکی را نجنبید مهر"
  },
  {
    "poem_id": 1473,
    "vorder": 26,
    "position": 1,
    "text": "خرد دور بد مهر ننمود چهر"
  },
  {
    "poem_id": 1473,
    "vorder": 27,
    "position": 0,
    "text": "همی بچه را باز داند ستور"
  },
  {
    "poem_id": 1473,
    "vorder": 28,
    "position": 1,
    "text": "چه ماهی به دریا چه در دشت گور"
  },
  {
    "poem_id": 1473,
    "vorder": 29,
    "position": 0,
    "text": "نداند همی مردم از رنج و آز"
  },
  {
    "poem_id": 1473,
    "vorder": 30,
    "position": 1,
    "text": "یکی دشمنی را ز فرزند باز"
  },
  {
    "poem_id": 1473,
    "vorder": 31,
    "position": 0,
    "text": "همی گفت رستم که هرگز نهنگ"
  },
  {
    "poem_id": 1473,
    "vorder": 32,
    "position": 1,
    "text": "ندیدم که آید بدین سان به جنگ"
  },
  {
    "poem_id": 1473,
    "vorder": 33,
    "position": 0,
    "text": "مرا خوار شد جنگ دیو سپید"
  },
  {
    "poem_id": 1473,
    "vorder": 34,
    "position": 1,
    "text": "ز مردی شد امروز دل ناامید"
  },
  {
    "poem_id": 1473,
    "vorder": 35,
    "position": 0,
    "text": "جوانی چنین ناسپرده جهان"
  },
  {
    "poem_id": 1473,
    "vorder": 36,
    "position": 1,
    "text": "نه گردی نه نام‌آوری از مهان"
  },
  {
    "poem_id": 1473,
    "vorder": 37,
    "position": 0,
    "text": "به سیری رسانیدم از روزگار"
  },
  {
    "poem_id": 1473,
    "vorder": 38,
    "position": 1,
    "text": "دو لشکر نظاره بدین کارزار"
  },
  {
    "poem_id": 1473,
    "vorder": 39,
    "position": 0,
    "text": "چو آسوده شد بارهٔ هر دو مرد"
  },
  {
    "poem_id": 1473,
    "vorder": 40,
    "position": 1,
    "text": "ز آورد و ز بند و ننگ و نبرد"
  },
  {
    "poem_id": 1473,
    "vorder": 41,
    "position": 0,
    "text": "به زه بر نهادند هر دو کمان"
  },
  {
    "poem_id": 1473,
    "vorder": 42,
    "position": 1,
    "text": "جوانه همان سالخورده همان"
  },
  {
    "poem_id": 1473,
    "vorder": 43,
    "position": 0,
    "text": "زره بود و خفتان و ببر بیان"
  },
  {
    "poem_id": 1473,
    "vorder": 44,
    "position": 1,
    "text": "ز کلک و ز پیکانش نامد زیان"
  },
  {
    "poem_id": 1473,
    "vorder": 45,
    "position": 0,
    "text": "غمی شد دل هر دو از یکدگر"
  },
  {
    "poem_id": 1473,
    "vorder": 46,
    "position": 1,
    "text": "گرفتند هر دو دوال کمر"
  },
  {
    "poem_id": 1473,
    "vorder": 47,
    "position": 0,
    "text": "تهمتن که گر دست بردی به سنگ"
  },
  {
    "poem_id": 1473,
    "vorder": 48,
    "position": 1,
    "text": "بکندی ز کوه سیه روز جنگ"
  },
  {
    "poem_id": 1473,
    "vorder": 49,
    "position": 0,
    "text": "کمربند سهراب را چاره کرد"
  },
  {
    "poem_id": 1473,
    "vorder": 50,
    "position": 1,
    "text": "که بر زین بجنباند اندر نبرد"
  },
  {
    "poem_id": 1473,
    "vorder": 51,
    "position": 0,
    "text": "میان جوان را نبود آگهی"
  },
  {
    "poem_id": 1473,
    "vorder": 52,
    "position": 1,
    "text": "بماند از هنر دست رستم تهی"
  },
  {
    "poem_id": 1473,
    "vorder": 53,
    "position": 0,
    "text": "دو شیراوژن از جنگ سیر آمدند"
  },
  {
    "poem_id": 1473,
    "vorder": 54,
    "position": 1,
    "text": "همه خسته و گشته دیر آمدند"
  },
  {
    "poem_id": 1473,
    "vorder": 55,
    "position": 0,
    "text": "دگر باره سهراب گرز گران"
  },
  {
    "poem_id": 1473,
    "vorder": 56,
    "position": 1,
    "text": "ز زین برکشید و بیفشارد ران"
  },
  {
    "poem_id": 1473,
    "vorder": 57,
    "position": 0,
    "text": "بزد گرز و آورد کتفش به درد"
  },
  {
    "poem_id": 1473,
    "vorder": 58,
    "position": 1,
    "text": "بپیچید و درد از دلیری بخورد"
  },
  {
    "poem_id": 1473,
    "vorder": 59,
    "position": 0,
    "text": "بخندید سهراب و گفت ای سوار"
  },
  {
    "poem_id": 1473,
    "vorder": 60,
    "position": 1,
    "text": "به زخم دلیران نه‌ای پایدار"
  },
  {
    "poem_id": 1473,
    "vorder": 61,
    "position": 0,
    "text": "به رزم اندرون رخش گویی خرست"
  },
  {
    "poem_id": 1473,
    "vorder": 62,
    "position": 1,
    "text": "دو دست سوار از همه بترست"
  },
  {
    "poem_id": 1473,
    "vorder": 63,
    "position": 0,
    "text": "اگرچه گوی سرو بالا بود"
  },
  {
    "poem_id": 1473,
    "vorder": 64,
    "position": 1,
    "text": "جوانی کند پیر کانا بود"
  },
  {
    "poem_id": 1473,
    "vorder": 65,
    "position": 0,
    "text": "به سستی رسید این ازان آن ازین"
  },
  {
    "poem_id": 1473,
    "vorder": 66,
    "position": 1,
    "text": "چنان تنگ شد بر دلیران زمین"
  },
  {
    "poem_id": 1473,
    "vorder": 67,
    "position": 0,
    "text": "که از یکدگر روی برگاشتند"
  },
  {
    "poem_id": 1473,
    "vorder": 68,
    "position": 1,
    "text": "دل و جان به اندوه بگذاشتند"
  },
  {
    "poem_id": 1473,
    "vorder": 69,
    "position": 0,
    "text": "تهمتن به توران سپه شد به جنگ"
  },
  {
    "poem_id": 1473,
    "vorder": 70,
    "position": 1,
    "text": "بدانسان که نخچیر بیند پلنگ"
  },
  {
    "poem_id": 1473,
    "vorder": 71,
    "position": 0,
    "text": "میان سپاه اندر آمد چو گرگ"
  },
  {
    "poem_id": 1473,
    "vorder": 72,
    "position": 1,
    "text": "پراگنده گشت آن سپاه بزرگ"
  },
  {
    "poem_id": 1473,
    "vorder": 73,
    "position": 0,
    "text": "عنان را بپچید سهراب گرد"
  },
  {
    "poem_id": 1473,
    "vorder": 74,
    "position": 1,
    "text": "به ایرانیان بر یکی حمله برد"
  },
  {
    "poem_id": 1473,
    "vorder": 75,
    "position": 0,
    "text": "بزد خویشتن را به ایران سپاه"
  },
  {
    "poem_id": 1473,
    "vorder": 76,
    "position": 1,
    "text": "ز گرزش بسی نامور شد تباه"
  },
  {
    "poem_id": 1473,
    "vorder": 77,
    "position": 0,
    "text": "دل رستم اندیشه‌ای کرد بد"
  },
  {
    "poem_id": 1473,
    "vorder": 78,
    "position": 1,
    "text": "که کاووس را بی‌گمان بد رسد"
  },
  {
    "poem_id": 1473,
    "vorder": 79,
    "position": 0,
    "text": "ازین پرهنر ترک نوخاسته"
  },
  {
    "poem_id": 1473,
    "vorder": 80,
    "position": 1,
    "text": "بخفتان بر و بازو آراسته"
  },
  {
    "poem_id": 1473,
    "vorder": 81,
    "position": 0,
    "text": "به لشکرگه خویش تازید زود"
  },
  {
    "poem_id": 1473,
    "vorder": 82,
    "position": 1,
    "text": "که اندیشهٔ دل بدان گونه بود"
  },
  {
    "poem_id": 1473,
    "vorder": 83,
    "position": 0,
    "text": "میان سپه دید سهراب را"
  },
  {
    "poem_id": 1473,
    "vorder": 84,
    "position": 1,
    "text": "چو می لعل کرده به خون آب را"
  },
  {
    "poem_id": 1473,
    "vorder": 85,
    "position": 0,
    "text": "غمی گشت رستم چو او را بدید"
  },
  {
    "poem_id": 1473,
    "vorder": 86,
    "position": 1,
    "text": "خروشی چو شیر ژیان برکشید"
  },
  {
    "poem_id": 1473,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت کای ترک خونخواره مرد"
  },
  {
    "poem_id": 1473,
    "vorder": 88,
    "position": 1,
    "text": "از ایران سپه جنگ با تو که کرد"
  },
  {
    "poem_id": 1473,
    "vorder": 89,
    "position": 0,
    "text": "چرا دست یازی به سوی همه"
  },
  {
    "poem_id": 1473,
    "vorder": 90,
    "position": 1,
    "text": "چو گرگ آمدی در میان رمه"
  },
  {
    "poem_id": 1473,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت سهراب توران سپاه"
  },
  {
    "poem_id": 1473,
    "vorder": 92,
    "position": 1,
    "text": "ازین رزم بودند بر بی‌گناه"
  },
  {
    "poem_id": 1473,
    "vorder": 93,
    "position": 0,
    "text": "تو آهنگ کردی بدیشان نخست"
  },
  {
    "poem_id": 1473,
    "vorder": 94,
    "position": 1,
    "text": "کسی با تو پیگار و کینه نجست"
  },
  {
    "poem_id": 1473,
    "vorder": 95,
    "position": 0,
    "text": "بدو گفت رستم که شد تیره‌روز"
  },
  {
    "poem_id": 1473,
    "vorder": 96,
    "position": 1,
    "text": "چه پیدا کند تیغ گیتی فروز"
  },
  {
    "poem_id": 1473,
    "vorder": 97,
    "position": 0,
    "text": "برین دشت هم دار و هم منبرست"
  },
  {
    "poem_id": 1473,
    "vorder": 98,
    "position": 1,
    "text": "که روشن جهان زیر تیغ‌اندرست"
  },
  {
    "poem_id": 1473,
    "vorder": 99,
    "position": 0,
    "text": "گر ایدون که شمشیر با بوی شیر"
  },
  {
    "poem_id": 1473,
    "vorder": 100,
    "position": 1,
    "text": "چنین آشنا شد تو هرگز ممیر"
  },
  {
    "poem_id": 1473,
    "vorder": 101,
    "position": 0,
    "text": "بگردیم شبگیر با تیغ کین"
  },
  {
    "poem_id": 1473,
    "vorder": 102,
    "position": 1,
    "text": "برو تا چه خواهد جهان آفرین"
  }
]