[
  {
    "poem_id": 1880,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد به شاه بزرگ"
  },
  {
    "poem_id": 1880,
    "vorder": 2,
    "position": 1,
    "text": "که از بیشه بیرون خرامید گرگ"
  },
  {
    "poem_id": 1880,
    "vorder": 3,
    "position": 0,
    "text": "سپاهی بیاورد بهرام گرد"
  },
  {
    "poem_id": 1880,
    "vorder": 4,
    "position": 1,
    "text": "که از آسمان روشنایی ببرد"
  },
  {
    "poem_id": 1880,
    "vorder": 5,
    "position": 0,
    "text": "به خراد برزین چنین گفت شاه"
  },
  {
    "poem_id": 1880,
    "vorder": 6,
    "position": 1,
    "text": "که بگزین برین کار بر چار ماه"
  },
  {
    "poem_id": 1880,
    "vorder": 7,
    "position": 0,
    "text": "یکی سوی خاقان بی‌مایه پوی"
  },
  {
    "poem_id": 1880,
    "vorder": 8,
    "position": 1,
    "text": "سخن هرچ دانی که باید بگوی"
  },
  {
    "poem_id": 1880,
    "vorder": 9,
    "position": 0,
    "text": "به ایران و نیران تو داناتری"
  },
  {
    "poem_id": 1880,
    "vorder": 10,
    "position": 1,
    "text": "همان بر زبان بر توانا‌تری"
  },
  {
    "poem_id": 1880,
    "vorder": 11,
    "position": 0,
    "text": "در گنج بگشاد و چندان گهر"
  },
  {
    "poem_id": 1880,
    "vorder": 12,
    "position": 1,
    "text": "بیاورد شمشیر و زرین کمر"
  },
  {
    "poem_id": 1880,
    "vorder": 13,
    "position": 0,
    "text": "که خراد برزین بران خیره ماند"
  },
  {
    "poem_id": 1880,
    "vorder": 14,
    "position": 1,
    "text": "همی در نهان نام یزدان بخواند"
  },
  {
    "poem_id": 1880,
    "vorder": 15,
    "position": 0,
    "text": "چو با هدیه‌ها راه چین بر گرفت"
  },
  {
    "poem_id": 1880,
    "vorder": 16,
    "position": 1,
    "text": "به جیحون یکی راه دیگر گرفت"
  },
  {
    "poem_id": 1880,
    "vorder": 17,
    "position": 0,
    "text": "چو نزدیک درگاه خاقان رسید"
  },
  {
    "poem_id": 1880,
    "vorder": 18,
    "position": 1,
    "text": "نگه کرد و گوینده‌ای برگزید"
  },
  {
    "poem_id": 1880,
    "vorder": 19,
    "position": 0,
    "text": "بدان تا بگوید که از نزد شاه"
  },
  {
    "poem_id": 1880,
    "vorder": 20,
    "position": 1,
    "text": "فرستاده آمد بدین بارگاه"
  },
  {
    "poem_id": 1880,
    "vorder": 21,
    "position": 0,
    "text": "چو بشنید خاقان بیاراست گاه"
  },
  {
    "poem_id": 1880,
    "vorder": 22,
    "position": 1,
    "text": "بفرمود تا برگشادند راه"
  },
  {
    "poem_id": 1880,
    "vorder": 23,
    "position": 0,
    "text": "فرستاده آمد به تنگی فراز"
  },
  {
    "poem_id": 1880,
    "vorder": 24,
    "position": 1,
    "text": "زبان کرد کوتاه و بردش نماز"
  },
  {
    "poem_id": 1880,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت هرگه که فرمان دهی"
  },
  {
    "poem_id": 1880,
    "vorder": 26,
    "position": 1,
    "text": "به گفتن زبان بر گشاید رهی"
  },
  {
    "poem_id": 1880,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت خاقان به شیرین زبان"
  },
  {
    "poem_id": 1880,
    "vorder": 28,
    "position": 1,
    "text": "دل مردم پیر گردد جوان"
  },
  {
    "poem_id": 1880,
    "vorder": 29,
    "position": 0,
    "text": "بگو آن سخن‌ها که سود اندروست"
  },
  {
    "poem_id": 1880,
    "vorder": 30,
    "position": 1,
    "text": "سخن گفت مغز‌ست و ناگفته پوست"
  },
  {
    "poem_id": 1880,
    "vorder": 31,
    "position": 0,
    "text": "چو خراد برزین شنید آن سخن"
  },
  {
    "poem_id": 1880,
    "vorder": 32,
    "position": 1,
    "text": "به‌یاد آمدش کینهای کهن"
  },
  {
    "poem_id": 1880,
    "vorder": 33,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1880,
    "vorder": 34,
    "position": 1,
    "text": "توانا دانندهٔ روزگار"
  },
  {
    "poem_id": 1880,
    "vorder": 35,
    "position": 0,
    "text": "که چرخ و مکان و زمان آفرید"
  },
  {
    "poem_id": 1880,
    "vorder": 36,
    "position": 1,
    "text": "توانایی و ناتوان آفرید"
  },
  {
    "poem_id": 1880,
    "vorder": 37,
    "position": 0,
    "text": "همان چرخ گردندهٔ بی ستون"
  },
  {
    "poem_id": 1880,
    "vorder": 38,
    "position": 1,
    "text": "چرا نه به فرمان او در نه چون"
  },
  {
    "poem_id": 1880,
    "vorder": 39,
    "position": 0,
    "text": "بدان آفرین کو جهان آفرید"
  },
  {
    "poem_id": 1880,
    "vorder": 40,
    "position": 1,
    "text": "بلند آسمان و زمین گسترید"
  },
  {
    "poem_id": 1880,
    "vorder": 41,
    "position": 0,
    "text": "توانا و دانا و دارنده اوست"
  },
  {
    "poem_id": 1880,
    "vorder": 42,
    "position": 1,
    "text": "سپهر و زمین را نگارنده اوست"
  },
  {
    "poem_id": 1880,
    "vorder": 43,
    "position": 0,
    "text": "به چرخ اندرون آفتاب آفرید"
  },
  {
    "poem_id": 1880,
    "vorder": 44,
    "position": 1,
    "text": "شب و روز و آرام و خواب آفرید"
  },
  {
    "poem_id": 1880,
    "vorder": 45,
    "position": 0,
    "text": "توانایی اوراست ما بنده‌ایم"
  },
  {
    "poem_id": 1880,
    "vorder": 46,
    "position": 1,
    "text": "همه راستیهاش گوینده‌ایم"
  },
  {
    "poem_id": 1880,
    "vorder": 47,
    "position": 0,
    "text": "یکی را دهد تاج و تخت بلند"
  },
  {
    "poem_id": 1880,
    "vorder": 48,
    "position": 1,
    "text": "یکی را کند بنده و مستمند"
  },
  {
    "poem_id": 1880,
    "vorder": 49,
    "position": 0,
    "text": "نه با اینش مهر و نه با آنش کین"
  },
  {
    "poem_id": 1880,
    "vorder": 50,
    "position": 1,
    "text": "نداند کس این جز جهان‌آفرین"
  },
  {
    "poem_id": 1880,
    "vorder": 51,
    "position": 0,
    "text": "که یک سر همه خاک را زاده‌ایم"
  },
  {
    "poem_id": 1880,
    "vorder": 52,
    "position": 1,
    "text": "به بیچاره تن مرگ را داده‌ایم"
  },
  {
    "poem_id": 1880,
    "vorder": 53,
    "position": 0,
    "text": "نخست اندر آیم ز جم برین"
  },
  {
    "poem_id": 1880,
    "vorder": 54,
    "position": 1,
    "text": "جهاندار طهمورث بافرین"
  },
  {
    "poem_id": 1880,
    "vorder": 55,
    "position": 0,
    "text": "چنین هم برو تاسر کی قباد"
  },
  {
    "poem_id": 1880,
    "vorder": 56,
    "position": 1,
    "text": "همان نامداران که داریم یاد"
  },
  {
    "poem_id": 1880,
    "vorder": 57,
    "position": 0,
    "text": "برین هم نشان تا به اسفندیار"
  },
  {
    "poem_id": 1880,
    "vorder": 58,
    "position": 1,
    "text": "چو کیخسرو و رستم نامدار"
  },
  {
    "poem_id": 1880,
    "vorder": 59,
    "position": 0,
    "text": "ز گیتی یکی دخمه شان بود بهر"
  },
  {
    "poem_id": 1880,
    "vorder": 60,
    "position": 1,
    "text": "چشیدند بر جای تریاک زهر"
  },
  {
    "poem_id": 1880,
    "vorder": 61,
    "position": 0,
    "text": "کنون شاه ایران به‌تن خویش تست"
  },
  {
    "poem_id": 1880,
    "vorder": 62,
    "position": 1,
    "text": "همه شاد و غمگین به کم بیش تست"
  },
  {
    "poem_id": 1880,
    "vorder": 63,
    "position": 0,
    "text": "به هنگام شاهان با آفرین"
  },
  {
    "poem_id": 1880,
    "vorder": 64,
    "position": 1,
    "text": "پدر مادرش بود خاقان چین"
  },
  {
    "poem_id": 1880,
    "vorder": 65,
    "position": 0,
    "text": "بدین روز پیوند ما تازه گشت"
  },
  {
    "poem_id": 1880,
    "vorder": 66,
    "position": 1,
    "text": "همه کار بر دیگر اندازه گشت"
  },
  {
    "poem_id": 1880,
    "vorder": 67,
    "position": 0,
    "text": "ز پیروزگر آفرین بر تو باد"
  },
  {
    "poem_id": 1880,
    "vorder": 68,
    "position": 1,
    "text": "سر نامداران زمین تو باد"
  },
  {
    "poem_id": 1880,
    "vorder": 69,
    "position": 0,
    "text": "همی‌گفت و خاقان بدو داده گوش"
  },
  {
    "poem_id": 1880,
    "vorder": 70,
    "position": 1,
    "text": "چنین گفت کای مرد دانش فروش"
  },
  {
    "poem_id": 1880,
    "vorder": 71,
    "position": 0,
    "text": "به ایران اگر نیز چون تو کسست"
  },
  {
    "poem_id": 1880,
    "vorder": 72,
    "position": 1,
    "text": "ستاینده آسمان او بسست"
  },
  {
    "poem_id": 1880,
    "vorder": 73,
    "position": 0,
    "text": "بران گاه جایی بپرداختش"
  },
  {
    "poem_id": 1880,
    "vorder": 74,
    "position": 1,
    "text": "به نزدیکی خویش بنشاختش"
  },
  {
    "poem_id": 1880,
    "vorder": 75,
    "position": 0,
    "text": "به فرمان او هدیه‌ها پیش برد"
  },
  {
    "poem_id": 1880,
    "vorder": 76,
    "position": 1,
    "text": "یکایک به گنج‌ور او برشمرد"
  },
  {
    "poem_id": 1880,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت خاقان که بی‌خواسته"
  },
  {
    "poem_id": 1880,
    "vorder": 78,
    "position": 1,
    "text": "مبادی تو اندر جهان کاسته"
  },
  {
    "poem_id": 1880,
    "vorder": 79,
    "position": 0,
    "text": "گر از من پذیرفت خواهی تو چیز"
  },
  {
    "poem_id": 1880,
    "vorder": 80,
    "position": 1,
    "text": "بگو تا پذیرم من آن چیز نیز"
  },
  {
    "poem_id": 1880,
    "vorder": 81,
    "position": 0,
    "text": "وگر نه ز هدیه تو روشن‌تری"
  },
  {
    "poem_id": 1880,
    "vorder": 82,
    "position": 1,
    "text": "به دانندگان جهان افسری"
  },
  {
    "poem_id": 1880,
    "vorder": 83,
    "position": 0,
    "text": "یکی جای خرم بپرداختند"
  },
  {
    "poem_id": 1880,
    "vorder": 84,
    "position": 1,
    "text": "ز هر گونه‌ای جامه‌ها ساختند"
  },
  {
    "poem_id": 1880,
    "vorder": 85,
    "position": 0,
    "text": "به خوان و شکار و به بزم و به می"
  },
  {
    "poem_id": 1880,
    "vorder": 86,
    "position": 1,
    "text": "به نزدیک خاقان بدی نیک پی"
  },
  {
    "poem_id": 1880,
    "vorder": 87,
    "position": 0,
    "text": "همی‌جست و روزیش جایی بیافت"
  },
  {
    "poem_id": 1880,
    "vorder": 88,
    "position": 1,
    "text": "به مردی به گفتارش اندر شتافت"
  },
  {
    "poem_id": 1880,
    "vorder": 89,
    "position": 0,
    "text": "همی‌گفت بهرام بدگوهر است"
  },
  {
    "poem_id": 1880,
    "vorder": 90,
    "position": 1,
    "text": "از آهرمن بد‌کنش بدتر است"
  },
  {
    "poem_id": 1880,
    "vorder": 91,
    "position": 0,
    "text": "فروشد جهاندیدگان را به چیز"
  },
  {
    "poem_id": 1880,
    "vorder": 92,
    "position": 1,
    "text": "که آن چیز گفتن نیرزد پشیز"
  },
  {
    "poem_id": 1880,
    "vorder": 93,
    "position": 0,
    "text": "ورا هرمز تاجور برکشید"
  },
  {
    "poem_id": 1880,
    "vorder": 94,
    "position": 1,
    "text": "به ارجش ز خورشید برتر کشید"
  },
  {
    "poem_id": 1880,
    "vorder": 95,
    "position": 0,
    "text": "ندانست کس در جهان نام اوی"
  },
  {
    "poem_id": 1880,
    "vorder": 96,
    "position": 1,
    "text": "ز گیتی بر آمد همه کام اوی"
  },
  {
    "poem_id": 1880,
    "vorder": 97,
    "position": 0,
    "text": "اگر با تو بسیار خوبی کند"
  },
  {
    "poem_id": 1880,
    "vorder": 98,
    "position": 1,
    "text": "به فرجام پیمان تو بشکند"
  },
  {
    "poem_id": 1880,
    "vorder": 99,
    "position": 0,
    "text": "چنان هم که با شاه ایران شکست"
  },
  {
    "poem_id": 1880,
    "vorder": 100,
    "position": 1,
    "text": "نه خسرو پرست و نه یزدان پرست"
  },
  {
    "poem_id": 1880,
    "vorder": 101,
    "position": 0,
    "text": "گر او را فرستی به نزدیک شاه"
  },
  {
    "poem_id": 1880,
    "vorder": 102,
    "position": 1,
    "text": "سر شاه ایران بر آری به ماه"
  },
  {
    "poem_id": 1880,
    "vorder": 103,
    "position": 0,
    "text": "ازان پس همه چین و ایران تو راست"
  },
  {
    "poem_id": 1880,
    "vorder": 104,
    "position": 1,
    "text": "نشستن‌گه آنجا کنی کت هواست"
  },
  {
    "poem_id": 1880,
    "vorder": 105,
    "position": 0,
    "text": "چو خاقان شنید این سخن خیره شد"
  },
  {
    "poem_id": 1880,
    "vorder": 106,
    "position": 1,
    "text": "دو چشمش ز گفتار او تیره شد"
  },
  {
    "poem_id": 1880,
    "vorder": 107,
    "position": 0,
    "text": "بدو گفت زین سان سخن‌ها مگوی"
  },
  {
    "poem_id": 1880,
    "vorder": 108,
    "position": 1,
    "text": "که تیره کنی نزد ما آب روی"
  },
  {
    "poem_id": 1880,
    "vorder": 109,
    "position": 0,
    "text": "نیم من بداندیش و پیمان‌شکن"
  },
  {
    "poem_id": 1880,
    "vorder": 110,
    "position": 1,
    "text": "که پیمان شکن خاک یابد کفن"
  },
  {
    "poem_id": 1880,
    "vorder": 111,
    "position": 0,
    "text": "چو بشنید خراد برزین سخن"
  },
  {
    "poem_id": 1880,
    "vorder": 112,
    "position": 1,
    "text": "بدانست کان کار او شد کهن"
  },
  {
    "poem_id": 1880,
    "vorder": 113,
    "position": 0,
    "text": "که بهرام دادش به ایران امید"
  },
  {
    "poem_id": 1880,
    "vorder": 114,
    "position": 1,
    "text": "سخن گفتن من شود باد و بید"
  },
  {
    "poem_id": 1880,
    "vorder": 115,
    "position": 0,
    "text": "چو امید خاقان بدو تیره گشت"
  },
  {
    "poem_id": 1880,
    "vorder": 116,
    "position": 1,
    "text": "به بیچارگی سوی خاتون گذشت"
  },
  {
    "poem_id": 1880,
    "vorder": 117,
    "position": 0,
    "text": "همی‌جست تا کیست نزدیک اوی"
  },
  {
    "poem_id": 1880,
    "vorder": 118,
    "position": 1,
    "text": "که روشن کند جان تاریک اوی"
  },
  {
    "poem_id": 1880,
    "vorder": 119,
    "position": 0,
    "text": "یکی کدخدایی به‌دست آمدش"
  },
  {
    "poem_id": 1880,
    "vorder": 120,
    "position": 1,
    "text": "همان نیز با او نشست آمدش"
  },
  {
    "poem_id": 1880,
    "vorder": 121,
    "position": 0,
    "text": "سخن‌های خسرو بدو یاد کرد"
  },
  {
    "poem_id": 1880,
    "vorder": 122,
    "position": 1,
    "text": "دل مرد بی‌تن بدان شاد کرد"
  },
  {
    "poem_id": 1880,
    "vorder": 123,
    "position": 0,
    "text": "بدو گفت خاتون مرا دستگیر"
  },
  {
    "poem_id": 1880,
    "vorder": 124,
    "position": 1,
    "text": "بود تا شوم بر درش بر دبیر"
  },
  {
    "poem_id": 1880,
    "vorder": 125,
    "position": 0,
    "text": "چنین گفت با چاره‌گر کدخدای"
  },
  {
    "poem_id": 1880,
    "vorder": 126,
    "position": 1,
    "text": "کزو آرزوها نیاید بجای"
  },
  {
    "poem_id": 1880,
    "vorder": 127,
    "position": 0,
    "text": "که بهرام چوبینه داماد اوست"
  },
  {
    "poem_id": 1880,
    "vorder": 128,
    "position": 1,
    "text": "و زویست بهرام را مغز و پوست"
  },
  {
    "poem_id": 1880,
    "vorder": 129,
    "position": 0,
    "text": "تو مردی دبیری‌، یکی چاره ساز"
  },
  {
    "poem_id": 1880,
    "vorder": 130,
    "position": 1,
    "text": "وزین نیز بر باد مگشای راز"
  },
  {
    "poem_id": 1880,
    "vorder": 131,
    "position": 0,
    "text": "چو خراد برزین شنید این سخن"
  },
  {
    "poem_id": 1880,
    "vorder": 132,
    "position": 1,
    "text": "نه سر دید پیمان او را نه بن"
  },
  {
    "poem_id": 1880,
    "vorder": 133,
    "position": 0,
    "text": "یکی ترک بد پیر نامش قلون"
  },
  {
    "poem_id": 1880,
    "vorder": 134,
    "position": 1,
    "text": "که ترکان ورا داشتندی زبون"
  },
  {
    "poem_id": 1880,
    "vorder": 135,
    "position": 0,
    "text": "همه پوستین بود پوشیدنش"
  },
  {
    "poem_id": 1880,
    "vorder": 136,
    "position": 1,
    "text": "ز کشک و ز ارزن بدی خوردنش"
  },
  {
    "poem_id": 1880,
    "vorder": 137,
    "position": 0,
    "text": "کسی را فرستاد و او را بخواند"
  },
  {
    "poem_id": 1880,
    "vorder": 138,
    "position": 1,
    "text": "بران نامور جایگاهش نشاند"
  },
  {
    "poem_id": 1880,
    "vorder": 139,
    "position": 0,
    "text": "مر او را درم داد و دینار داد"
  },
  {
    "poem_id": 1880,
    "vorder": 140,
    "position": 1,
    "text": "همان پوشش و خورد بسیار داد"
  },
  {
    "poem_id": 1880,
    "vorder": 141,
    "position": 0,
    "text": "چو بر خوان نشستی ورا خواندی"
  },
  {
    "poem_id": 1880,
    "vorder": 142,
    "position": 1,
    "text": "بر نامدارانش بنشاندی"
  },
  {
    "poem_id": 1880,
    "vorder": 143,
    "position": 0,
    "text": "پر‌اندیشه بد مرد بسیاردان"
  },
  {
    "poem_id": 1880,
    "vorder": 144,
    "position": 1,
    "text": "شکیبا دل و زیرک و کاردان"
  },
  {
    "poem_id": 1880,
    "vorder": 145,
    "position": 0,
    "text": "وزان روی با کدخدای سرای"
  },
  {
    "poem_id": 1880,
    "vorder": 146,
    "position": 1,
    "text": "ز خاتون چینی همی‌گفت رای"
  },
  {
    "poem_id": 1880,
    "vorder": 147,
    "position": 0,
    "text": "همان پیش خاقان به روز و به شب"
  },
  {
    "poem_id": 1880,
    "vorder": 148,
    "position": 1,
    "text": "چو رفتی همی‌داشتی بسته لب"
  },
  {
    "poem_id": 1880,
    "vorder": 149,
    "position": 0,
    "text": "چنین گفت با مهتر آن مرد پیر"
  },
  {
    "poem_id": 1880,
    "vorder": 150,
    "position": 1,
    "text": "که چون تو سرافراز مردی دبیر"
  },
  {
    "poem_id": 1880,
    "vorder": 151,
    "position": 0,
    "text": "اگر در پزشکیت بهره بدی"
  },
  {
    "poem_id": 1880,
    "vorder": 152,
    "position": 1,
    "text": "وگر نامت از دور شهره بدی"
  },
  {
    "poem_id": 1880,
    "vorder": 153,
    "position": 0,
    "text": "یکی تاج نو بودیی بر سرش"
  },
  {
    "poem_id": 1880,
    "vorder": 154,
    "position": 1,
    "text": "به ویژه که بیمار شد دخترش"
  },
  {
    "poem_id": 1880,
    "vorder": 155,
    "position": 0,
    "text": "بدو گفت کاین دانشم نیز هست"
  },
  {
    "poem_id": 1880,
    "vorder": 156,
    "position": 1,
    "text": "چو گویی بسایم برین کار دست"
  },
  {
    "poem_id": 1880,
    "vorder": 157,
    "position": 0,
    "text": "بشد پیش خاتون دوان کدخدای"
  },
  {
    "poem_id": 1880,
    "vorder": 158,
    "position": 1,
    "text": "که دانا پزشکی نوآمد به جای"
  },
  {
    "poem_id": 1880,
    "vorder": 159,
    "position": 0,
    "text": "بدو گفت شادان زی و نوش خور"
  },
  {
    "poem_id": 1880,
    "vorder": 160,
    "position": 1,
    "text": "بیارش‌، مخار اندرین کار سر"
  },
  {
    "poem_id": 1880,
    "vorder": 161,
    "position": 0,
    "text": "بیامد به خراد برزین بگفت"
  },
  {
    "poem_id": 1880,
    "vorder": 162,
    "position": 1,
    "text": "که این راز باید که داری نهفت"
  },
  {
    "poem_id": 1880,
    "vorder": 163,
    "position": 0,
    "text": "برو پیش او نام خود را مگوی"
  },
  {
    "poem_id": 1880,
    "vorder": 164,
    "position": 1,
    "text": "پزشکی کن از خویشتن تازه‌روی"
  },
  {
    "poem_id": 1880,
    "vorder": 165,
    "position": 0,
    "text": "به نزدیک خاتون شد آن چاره‌گر"
  },
  {
    "poem_id": 1880,
    "vorder": 166,
    "position": 1,
    "text": "تبه دید بیمار او را جگر"
  },
  {
    "poem_id": 1880,
    "vorder": 167,
    "position": 0,
    "text": "بفرمود تا آب نار آورند"
  },
  {
    "poem_id": 1880,
    "vorder": 168,
    "position": 1,
    "text": "همان ترهٔ جویبار آورند"
  },
  {
    "poem_id": 1880,
    "vorder": 169,
    "position": 0,
    "text": "کجا تره گر کاسنی خواندش"
  },
  {
    "poem_id": 1880,
    "vorder": 170,
    "position": 1,
    "text": "تبش خواست کز مغز بنشاندش"
  },
  {
    "poem_id": 1880,
    "vorder": 171,
    "position": 0,
    "text": "به فرمان یزدان چو شد هفت روز"
  },
  {
    "poem_id": 1880,
    "vorder": 172,
    "position": 1,
    "text": "شد آن دخت چون ماه گیتی‌فروز"
  },
  {
    "poem_id": 1880,
    "vorder": 173,
    "position": 0,
    "text": "بیاورد دینار خاتون ز گنج"
  },
  {
    "poem_id": 1880,
    "vorder": 174,
    "position": 1,
    "text": "یکی بدره و تای زربفت پنج"
  },
  {
    "poem_id": 1880,
    "vorder": 175,
    "position": 0,
    "text": "بدو گفت کاین ناسزاوار چیز"
  },
  {
    "poem_id": 1880,
    "vorder": 176,
    "position": 1,
    "text": "بگیر و بخواه آنچ بایدت نیز"
  },
  {
    "poem_id": 1880,
    "vorder": 177,
    "position": 0,
    "text": "چنین داد پاسخ که این را بدار"
  },
  {
    "poem_id": 1880,
    "vorder": 178,
    "position": 1,
    "text": "بخواهم هر آنگه که آید به کار"
  }
]