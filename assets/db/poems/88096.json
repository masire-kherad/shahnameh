[
  {
    "poem_id": 88096,
    "vorder": 1,
    "position": 0,
    "text": "شهنشاه بر تخت زرین نشست"
  },
  {
    "poem_id": 88096,
    "vorder": 2,
    "position": 1,
    "text": "یکی گُرزهٔ گاوپیکر به دست"
  },
  {
    "poem_id": 88096,
    "vorder": 3,
    "position": 0,
    "text": "به یک دست او زال و رستم به هم"
  },
  {
    "poem_id": 88096,
    "vorder": 4,
    "position": 1,
    "text": "چو پیل سرافراز و شیر دژم"
  },
  {
    "poem_id": 88096,
    "vorder": 5,
    "position": 0,
    "text": "به دست دگر طوس و گودرز و گیو"
  },
  {
    "poem_id": 88096,
    "vorder": 6,
    "position": 1,
    "text": "دگر بیژن گرد و رهام نیو"
  },
  {
    "poem_id": 88096,
    "vorder": 7,
    "position": 0,
    "text": "نهاده همه چهر بر چشم شاه"
  },
  {
    "poem_id": 88096,
    "vorder": 8,
    "position": 1,
    "text": "بدان تا چه گوید ز کار سپاه"
  },
  {
    "poem_id": 88096,
    "vorder": 9,
    "position": 0,
    "text": "به آواز گفت آن زمان شهریار"
  },
  {
    "poem_id": 88096,
    "vorder": 10,
    "position": 1,
    "text": "که ای نامداران به روزگار"
  },
  {
    "poem_id": 88096,
    "vorder": 11,
    "position": 0,
    "text": "هر آن کس که دارید راه و خرد"
  },
  {
    "poem_id": 88096,
    "vorder": 12,
    "position": 1,
    "text": "بدانید کاین نیک و بد بگذرد"
  },
  {
    "poem_id": 88096,
    "vorder": 13,
    "position": 0,
    "text": "همه رفتنی‌ایم و گیتی سپنچ"
  },
  {
    "poem_id": 88096,
    "vorder": 14,
    "position": 1,
    "text": "چرا باید این درد و اندوه و رنج"
  },
  {
    "poem_id": 88096,
    "vorder": 15,
    "position": 0,
    "text": "ز هر دست خوبی فراز آوریم"
  },
  {
    "poem_id": 88096,
    "vorder": 16,
    "position": 1,
    "text": "به دشمن بمانیم و خود بگذریم"
  },
  {
    "poem_id": 88096,
    "vorder": 17,
    "position": 0,
    "text": "کنون گاو آن زیر چرم اندر است"
  },
  {
    "poem_id": 88096,
    "vorder": 18,
    "position": 1,
    "text": "که پاداش و بادافره دیگرست"
  },
  {
    "poem_id": 88096,
    "vorder": 19,
    "position": 0,
    "text": "بترسید یکسر ز یزدان پاک"
  },
  {
    "poem_id": 88096,
    "vorder": 20,
    "position": 1,
    "text": "مباشید ایمن بدین تیره خاک"
  },
  {
    "poem_id": 88096,
    "vorder": 21,
    "position": 0,
    "text": "که این روز بر ما همی بگذرد"
  },
  {
    "poem_id": 88096,
    "vorder": 22,
    "position": 1,
    "text": "زمانه دم هر کسی بشمرد"
  },
  {
    "poem_id": 88096,
    "vorder": 23,
    "position": 0,
    "text": "ز هوشنگ و جمشید و کاووس شاه"
  },
  {
    "poem_id": 88096,
    "vorder": 24,
    "position": 1,
    "text": "که بودند با فر و تخت و کلاه"
  },
  {
    "poem_id": 88096,
    "vorder": 25,
    "position": 0,
    "text": "جز از نام از ایشان به گیتی نماند"
  },
  {
    "poem_id": 88096,
    "vorder": 26,
    "position": 1,
    "text": "کسی نامهٔ رفتگان برنخواند"
  },
  {
    "poem_id": 88096,
    "vorder": 27,
    "position": 0,
    "text": "از ایشان بسی ناسپاسان بدند"
  },
  {
    "poem_id": 88096,
    "vorder": 28,
    "position": 1,
    "text": "به فرجام زآن بد هراسان بدند"
  },
  {
    "poem_id": 88096,
    "vorder": 29,
    "position": 0,
    "text": "چو ایشان همان من یکی بنده‌ام"
  },
  {
    "poem_id": 88096,
    "vorder": 30,
    "position": 1,
    "text": "وگر چند با رنج کوشنده‌ام"
  },
  {
    "poem_id": 88096,
    "vorder": 31,
    "position": 0,
    "text": "بکوشیدم و رنج بردم بسی"
  },
  {
    "poem_id": 88096,
    "vorder": 32,
    "position": 1,
    "text": "ندیدم که ایدر بماند کسی"
  },
  {
    "poem_id": 88096,
    "vorder": 33,
    "position": 0,
    "text": "کنون جان و دل ز این سرای سپنج"
  },
  {
    "poem_id": 88096,
    "vorder": 34,
    "position": 1,
    "text": "بکندم سرآوردم این درد و رنج"
  },
  {
    "poem_id": 88096,
    "vorder": 35,
    "position": 0,
    "text": "کنون آنچه جستم همه یافتم"
  },
  {
    "poem_id": 88096,
    "vorder": 36,
    "position": 1,
    "text": "ز تخت کیی روی برتافتم"
  },
  {
    "poem_id": 88096,
    "vorder": 37,
    "position": 0,
    "text": "هر آن کس که در پیش من برد رنج"
  },
  {
    "poem_id": 88096,
    "vorder": 38,
    "position": 1,
    "text": "ببخشم بدو هرچ خواهد ز گنج"
  },
  {
    "poem_id": 88096,
    "vorder": 39,
    "position": 0,
    "text": "ز کردار هر کس که دارم سپاس"
  },
  {
    "poem_id": 88096,
    "vorder": 40,
    "position": 1,
    "text": "بگویم به یزدان نیکی‌شناس"
  },
  {
    "poem_id": 88096,
    "vorder": 41,
    "position": 0,
    "text": "به ایرانیان بخشم این خواسته"
  },
  {
    "poem_id": 88096,
    "vorder": 42,
    "position": 1,
    "text": "سلیح و در گنج آراسته"
  },
  {
    "poem_id": 88096,
    "vorder": 43,
    "position": 0,
    "text": "هر آن کس که هست از شما مهتری"
  },
  {
    "poem_id": 88096,
    "vorder": 44,
    "position": 1,
    "text": "ببخشم به هر مهتری کشوری"
  },
  {
    "poem_id": 88096,
    "vorder": 45,
    "position": 0,
    "text": "همان بدره و برده و چارپای"
  },
  {
    "poem_id": 88096,
    "vorder": 46,
    "position": 1,
    "text": "براندیشم آرم شمارش به جای"
  },
  {
    "poem_id": 88096,
    "vorder": 47,
    "position": 0,
    "text": "ببخشم که من راه را ساختم"
  },
  {
    "poem_id": 88096,
    "vorder": 48,
    "position": 1,
    "text": "وز این تیرگی دل بپرداختم"
  },
  {
    "poem_id": 88096,
    "vorder": 49,
    "position": 0,
    "text": "شما دست شادی به خوردن برید"
  },
  {
    "poem_id": 88096,
    "vorder": 50,
    "position": 1,
    "text": "به یک هفته ایدر چمید و چرید"
  },
  {
    "poem_id": 88096,
    "vorder": 51,
    "position": 0,
    "text": "بخواهم که تا ز این سرای سپنج"
  },
  {
    "poem_id": 88096,
    "vorder": 52,
    "position": 1,
    "text": "گذر یابم و دور مانم ز رنج"
  },
  {
    "poem_id": 88096,
    "vorder": 53,
    "position": 0,
    "text": "چو کیخسرو این پندها برگرفت"
  },
  {
    "poem_id": 88096,
    "vorder": 54,
    "position": 1,
    "text": "بماندند گردان ایران شگفت"
  },
  {
    "poem_id": 88096,
    "vorder": 55,
    "position": 0,
    "text": "یکی گفت کاین شاه دیوانه شد"
  },
  {
    "poem_id": 88096,
    "vorder": 56,
    "position": 1,
    "text": "خرد با دلش سخت بیگانه شد"
  },
  {
    "poem_id": 88096,
    "vorder": 57,
    "position": 0,
    "text": "ندانم بر او بر چه خواهد رسید"
  },
  {
    "poem_id": 88096,
    "vorder": 58,
    "position": 1,
    "text": "کجا خواهد این تاج و تخت آرمید"
  },
  {
    "poem_id": 88096,
    "vorder": 59,
    "position": 0,
    "text": "برفتند یکسر گروهاگروه"
  },
  {
    "poem_id": 88096,
    "vorder": 60,
    "position": 1,
    "text": "همه دشت لشکر بد و راغ و کوه"
  },
  {
    "poem_id": 88096,
    "vorder": 61,
    "position": 0,
    "text": "غو نای و آوای مستان ز دشت"
  },
  {
    "poem_id": 88096,
    "vorder": 62,
    "position": 1,
    "text": "تو گفتی همی از هوا برگذشت"
  },
  {
    "poem_id": 88096,
    "vorder": 63,
    "position": 0,
    "text": "ببودند یک هفته ز این گونه شاد"
  },
  {
    "poem_id": 88096,
    "vorder": 64,
    "position": 1,
    "text": "کسی را نیامد غم و رنج یاد"
  }
]