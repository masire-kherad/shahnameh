[
  {
    "poem_id": 1384,
    "vorder": 1,
    "position": 0,
    "text": "پرستنده برخاست از پیش اوی"
  },
  {
    "poem_id": 1384,
    "vorder": 2,
    "position": 1,
    "text": "بدان چاره بی‌چاره بنهاد روی"
  },
  {
    "poem_id": 1384,
    "vorder": 3,
    "position": 0,
    "text": "به دیبای رومی بیاراستند"
  },
  {
    "poem_id": 1384,
    "vorder": 4,
    "position": 1,
    "text": "سر زلف برگل بپیراستند"
  },
  {
    "poem_id": 1384,
    "vorder": 5,
    "position": 0,
    "text": "برفتند هر پنج تا رودبار"
  },
  {
    "poem_id": 1384,
    "vorder": 6,
    "position": 1,
    "text": "ز هر بوی و رنگی چو خرم بهار"
  },
  {
    "poem_id": 1384,
    "vorder": 7,
    "position": 0,
    "text": "مه فرودین وسر سال بود"
  },
  {
    "poem_id": 1384,
    "vorder": 8,
    "position": 1,
    "text": "لب رود لشکرگه زال بود"
  },
  {
    "poem_id": 1384,
    "vorder": 9,
    "position": 0,
    "text": "همی گل چدند از لب رودبار"
  },
  {
    "poem_id": 1384,
    "vorder": 10,
    "position": 1,
    "text": "رخان چون گلستان و گل در کنار"
  },
  {
    "poem_id": 1384,
    "vorder": 11,
    "position": 0,
    "text": "نگه کرد دستان ز تخت بلند"
  },
  {
    "poem_id": 1384,
    "vorder": 12,
    "position": 1,
    "text": "بپرسید کاین گل پرستان کی َند"
  },
  {
    "poem_id": 1384,
    "vorder": 13,
    "position": 0,
    "text": "چنین گفت گوینده با پهلوان"
  },
  {
    "poem_id": 1384,
    "vorder": 14,
    "position": 1,
    "text": "که از کاخ مهراب روشن روان"
  },
  {
    "poem_id": 1384,
    "vorder": 15,
    "position": 0,
    "text": "پرستندگان را سوی گلستان"
  },
  {
    "poem_id": 1384,
    "vorder": 16,
    "position": 1,
    "text": "فرستد همی ماه کابلستان"
  },
  {
    "poem_id": 1384,
    "vorder": 17,
    "position": 0,
    "text": "به نزد پری چهرگان رفت زال"
  },
  {
    "poem_id": 1384,
    "vorder": 18,
    "position": 1,
    "text": "کمان خواست از ترک و بفراخت یال"
  },
  {
    "poem_id": 1384,
    "vorder": 19,
    "position": 0,
    "text": "پیاده همی رفت جویان شکار"
  },
  {
    "poem_id": 1384,
    "vorder": 20,
    "position": 1,
    "text": "خشیشار دید اندر آن رودبار"
  },
  {
    "poem_id": 1384,
    "vorder": 21,
    "position": 0,
    "text": "کمان ترک گلرخ به زه بر نهاد"
  },
  {
    "poem_id": 1384,
    "vorder": 22,
    "position": 1,
    "text": "به دست جهان پهلوان در نهاد"
  },
  {
    "poem_id": 1384,
    "vorder": 23,
    "position": 0,
    "text": "نگه کرد تا مرغ برخاست ز آب"
  },
  {
    "poem_id": 1384,
    "vorder": 24,
    "position": 1,
    "text": "یکی تیره بنداخت اندر شتاب"
  },
  {
    "poem_id": 1384,
    "vorder": 25,
    "position": 0,
    "text": "ز پروازش آورد گردان فرود"
  },
  {
    "poem_id": 1384,
    "vorder": 26,
    "position": 1,
    "text": "چکان خون و وشی شده آب رود"
  },
  {
    "poem_id": 1384,
    "vorder": 27,
    "position": 0,
    "text": "بترک آنگهی گفت زان سو گذر"
  },
  {
    "poem_id": 1384,
    "vorder": 28,
    "position": 1,
    "text": "بیاور تو آن مرغ افگنده پر"
  },
  {
    "poem_id": 1384,
    "vorder": 29,
    "position": 0,
    "text": "به کشتی گذر کرد ترک سترگ"
  },
  {
    "poem_id": 1384,
    "vorder": 30,
    "position": 1,
    "text": "خرامید نزد پرستنده ترک"
  },
  {
    "poem_id": 1384,
    "vorder": 31,
    "position": 0,
    "text": "پرستنده پرسید کای پهلوان"
  },
  {
    "poem_id": 1384,
    "vorder": 32,
    "position": 1,
    "text": "سخن گوی و بگشای شیرین زبان"
  },
  {
    "poem_id": 1384,
    "vorder": 33,
    "position": 0,
    "text": "که این شیر بازو گو پیلتن"
  },
  {
    "poem_id": 1384,
    "vorder": 34,
    "position": 1,
    "text": "چه مردست و شاه کدام انجمن"
  },
  {
    "poem_id": 1384,
    "vorder": 35,
    "position": 0,
    "text": "که بگشاد زین گونه تیر از کمان"
  },
  {
    "poem_id": 1384,
    "vorder": 36,
    "position": 1,
    "text": "چه سنجد به پیش اندرش بدگمان"
  },
  {
    "poem_id": 1384,
    "vorder": 37,
    "position": 0,
    "text": "ندیدیم زیبنده تر زین سوار"
  },
  {
    "poem_id": 1384,
    "vorder": 38,
    "position": 1,
    "text": "به تیر و کمان بر چنین کامگار"
  },
  {
    "poem_id": 1384,
    "vorder": 39,
    "position": 0,
    "text": "پری روی دندان به لب برنهاد"
  },
  {
    "poem_id": 1384,
    "vorder": 40,
    "position": 1,
    "text": "مکن گفت ازین گونه از شاه یاد"
  },
  {
    "poem_id": 1384,
    "vorder": 41,
    "position": 0,
    "text": "شه نیمروزست فرزند سام"
  },
  {
    "poem_id": 1384,
    "vorder": 42,
    "position": 1,
    "text": "که دستانش خوانند شاهان به نام"
  },
  {
    "poem_id": 1384,
    "vorder": 43,
    "position": 0,
    "text": "بگِردِ جهان گر بگردد سوار"
  },
  {
    "poem_id": 1384,
    "vorder": 44,
    "position": 1,
    "text": "ازین سان نبیند یکی نامدار"
  },
  {
    "poem_id": 1384,
    "vorder": 45,
    "position": 0,
    "text": "پرستنده با کودک ماه روی"
  },
  {
    "poem_id": 1384,
    "vorder": 46,
    "position": 1,
    "text": "بخندید و گفتش که چندین مگوی"
  },
  {
    "poem_id": 1384,
    "vorder": 47,
    "position": 0,
    "text": "که ماهیست مهراب را در سرای"
  },
  {
    "poem_id": 1384,
    "vorder": 48,
    "position": 1,
    "text": "به یک سر ز شاه تو برتر بپای"
  },
  {
    "poem_id": 1384,
    "vorder": 49,
    "position": 0,
    "text": "به بالای ساج است و همرنگ عاج"
  },
  {
    "poem_id": 1384,
    "vorder": 50,
    "position": 1,
    "text": "یکی ایزدی بر سر از مشک تاج"
  },
  {
    "poem_id": 1384,
    "vorder": 51,
    "position": 0,
    "text": "دو نرگس دژم و دو ابرو به خم"
  },
  {
    "poem_id": 1384,
    "vorder": 52,
    "position": 1,
    "text": "ستون دو ابرو چو سیمین قلم"
  },
  {
    "poem_id": 1384,
    "vorder": 53,
    "position": 0,
    "text": "دهانش به تنگی دل مستمند"
  },
  {
    "poem_id": 1384,
    "vorder": 54,
    "position": 1,
    "text": "سر زلف چون حلقهٔ پای‌بند"
  },
  {
    "poem_id": 1384,
    "vorder": 55,
    "position": 0,
    "text": "دو جادوش پر خواب و پرآب روی"
  },
  {
    "poem_id": 1384,
    "vorder": 56,
    "position": 1,
    "text": "پر از لاله رخسار و پر مشک موی"
  },
  {
    "poem_id": 1384,
    "vorder": 57,
    "position": 0,
    "text": "نفس را مگر بر لبش راه نیست"
  },
  {
    "poem_id": 1384,
    "vorder": 58,
    "position": 1,
    "text": "چنو در جهان نیز یک ماه نیست"
  },
  {
    "poem_id": 1384,
    "vorder": 59,
    "position": 0,
    "text": "پرستندگان هر یکی آشکار"
  },
  {
    "poem_id": 1384,
    "vorder": 60,
    "position": 1,
    "text": "همی کرد وصف رخ آن نگار"
  },
  {
    "poem_id": 1384,
    "vorder": 61,
    "position": 0,
    "text": "بدین چاره تا آن لب لعل فام"
  },
  {
    "poem_id": 1384,
    "vorder": 62,
    "position": 1,
    "text": "کند آشنا با لب پور سام"
  },
  {
    "poem_id": 1384,
    "vorder": 63,
    "position": 0,
    "text": "چنین گفت با بندگان خوب چهر"
  },
  {
    "poem_id": 1384,
    "vorder": 64,
    "position": 1,
    "text": "که با ماه خوبست رخشنده مهر"
  },
  {
    "poem_id": 1384,
    "vorder": 65,
    "position": 0,
    "text": "ولیکن به گفتن مگر روی نیست"
  },
  {
    "poem_id": 1384,
    "vorder": 66,
    "position": 1,
    "text": "بود کاب را ره بدین جوی نیست"
  },
  {
    "poem_id": 1384,
    "vorder": 67,
    "position": 0,
    "text": "دلاور که پرهیز جوید ز جفت"
  },
  {
    "poem_id": 1384,
    "vorder": 68,
    "position": 1,
    "text": "بماند به آسانی اندر نهفت"
  },
  {
    "poem_id": 1384,
    "vorder": 69,
    "position": 0,
    "text": "بدان تاش دختر نباشد ز بن"
  },
  {
    "poem_id": 1384,
    "vorder": 70,
    "position": 1,
    "text": "نباید شنیدنش ننگ سخن"
  },
  {
    "poem_id": 1384,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت مر جفت را باز نر"
  },
  {
    "poem_id": 1384,
    "vorder": 72,
    "position": 1,
    "text": "چو بر خایه بنشست و گسترد پر"
  },
  {
    "poem_id": 1384,
    "vorder": 73,
    "position": 0,
    "text": "کزین خایه گر مایه بیرون کنم"
  },
  {
    "poem_id": 1384,
    "vorder": 74,
    "position": 1,
    "text": "ز پشت پدر خایه بیرون کنم"
  },
  {
    "poem_id": 1384,
    "vorder": 75,
    "position": 0,
    "text": "ازیشان چو برگشت خندان غلام"
  },
  {
    "poem_id": 1384,
    "vorder": 76,
    "position": 1,
    "text": "بپرسید از و نامور پور سام"
  },
  {
    "poem_id": 1384,
    "vorder": 77,
    "position": 0,
    "text": "که با تو چه گفت آن که خندان شدی"
  },
  {
    "poem_id": 1384,
    "vorder": 78,
    "position": 1,
    "text": "گشاده لب و سیم دندان شدی"
  },
  {
    "poem_id": 1384,
    "vorder": 79,
    "position": 0,
    "text": "بگفت آنچه بشنید با پهلوان"
  },
  {
    "poem_id": 1384,
    "vorder": 80,
    "position": 1,
    "text": "ز شادی دل پهلوان شد جوان"
  },
  {
    "poem_id": 1384,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت با ریدک ماه روی"
  },
  {
    "poem_id": 1384,
    "vorder": 82,
    "position": 1,
    "text": "که رو مر پرستندگان را بگوی"
  },
  {
    "poem_id": 1384,
    "vorder": 83,
    "position": 0,
    "text": "که از گلستان یک زمان مگذرید"
  },
  {
    "poem_id": 1384,
    "vorder": 84,
    "position": 1,
    "text": "مگر با گل از باغ گوهر برید"
  },
  {
    "poem_id": 1384,
    "vorder": 85,
    "position": 0,
    "text": "درم خواست و دینار و گوهر ز گنج"
  },
  {
    "poem_id": 1384,
    "vorder": 86,
    "position": 1,
    "text": "گرانمایه دیبای زربفت پنج"
  },
  {
    "poem_id": 1384,
    "vorder": 87,
    "position": 0,
    "text": "بفرمود کاین نزد ایشان برید"
  },
  {
    "poem_id": 1384,
    "vorder": 88,
    "position": 1,
    "text": "کسی را مگوئید و پنهان برید"
  },
  {
    "poem_id": 1384,
    "vorder": 89,
    "position": 0,
    "text": "نباید شدن شان سوی کاخ باز"
  },
  {
    "poem_id": 1384,
    "vorder": 90,
    "position": 1,
    "text": "بدان تا پیامی فرستم براز"
  },
  {
    "poem_id": 1384,
    "vorder": 91,
    "position": 0,
    "text": "برفتند زی ماه رخسار پنج"
  },
  {
    "poem_id": 1384,
    "vorder": 92,
    "position": 1,
    "text": "ابا گرم گفتار و دینار و گنج"
  },
  {
    "poem_id": 1384,
    "vorder": 93,
    "position": 0,
    "text": "بدیشان سپردند زر و گهر"
  },
  {
    "poem_id": 1384,
    "vorder": 94,
    "position": 1,
    "text": "پیام جهان پهلوان زال زر"
  },
  {
    "poem_id": 1384,
    "vorder": 95,
    "position": 0,
    "text": "پرستنده با ماه دیدار گفت"
  },
  {
    "poem_id": 1384,
    "vorder": 96,
    "position": 1,
    "text": "که هرگز نماند سخن در نهفت"
  },
  {
    "poem_id": 1384,
    "vorder": 97,
    "position": 0,
    "text": "مگر آنکه باشد میان دو تن"
  },
  {
    "poem_id": 1384,
    "vorder": 98,
    "position": 1,
    "text": "سه تن نانهانست و چار انجمن"
  },
  {
    "poem_id": 1384,
    "vorder": 99,
    "position": 0,
    "text": "بگوی ای خردمند پاکیزه رای"
  },
  {
    "poem_id": 1384,
    "vorder": 100,
    "position": 1,
    "text": "سخن گر به رازست با ما سرای"
  },
  {
    "poem_id": 1384,
    "vorder": 101,
    "position": 0,
    "text": "پرستنده گفتند یک با دگر"
  },
  {
    "poem_id": 1384,
    "vorder": 102,
    "position": 1,
    "text": "که آمد به دام اندرون شیر نر"
  },
  {
    "poem_id": 1384,
    "vorder": 103,
    "position": 0,
    "text": "کنون کار رودابه و کام زال"
  },
  {
    "poem_id": 1384,
    "vorder": 104,
    "position": 1,
    "text": "به جای آمد و این بود نیک فال"
  },
  {
    "poem_id": 1384,
    "vorder": 105,
    "position": 0,
    "text": "بیامد سیه چشم گنجور شاه"
  },
  {
    "poem_id": 1384,
    "vorder": 106,
    "position": 1,
    "text": "که بود اندر آن کار دستور شاه"
  },
  {
    "poem_id": 1384,
    "vorder": 107,
    "position": 0,
    "text": "سخن هر چه بشنید از آن دلنواز"
  },
  {
    "poem_id": 1384,
    "vorder": 108,
    "position": 1,
    "text": "همی گفت پیش سپهبد به راز"
  },
  {
    "poem_id": 1384,
    "vorder": 109,
    "position": 0,
    "text": "سپهبد خرامید تا گلستان"
  },
  {
    "poem_id": 1384,
    "vorder": 110,
    "position": 1,
    "text": "بر امید خورشید کابلستان"
  },
  {
    "poem_id": 1384,
    "vorder": 111,
    "position": 0,
    "text": "پری روی گلرخ بتان طراز"
  },
  {
    "poem_id": 1384,
    "vorder": 112,
    "position": 1,
    "text": "برفتند و بردند پیشش نماز"
  },
  {
    "poem_id": 1384,
    "vorder": 113,
    "position": 0,
    "text": "سپهبد بپرسید ازیشان سخن"
  },
  {
    "poem_id": 1384,
    "vorder": 114,
    "position": 1,
    "text": "ز بالا و دیدار آن سرو بن"
  },
  {
    "poem_id": 1384,
    "vorder": 115,
    "position": 0,
    "text": "ز گفتار و دیدار و رای و خرد"
  },
  {
    "poem_id": 1384,
    "vorder": 116,
    "position": 1,
    "text": "بدان تا به خوی وی اندر خورد"
  },
  {
    "poem_id": 1384,
    "vorder": 117,
    "position": 0,
    "text": "بگویید با من یکایک سخن"
  },
  {
    "poem_id": 1384,
    "vorder": 118,
    "position": 1,
    "text": "به کژی نگر نفگنید ایچ بن"
  },
  {
    "poem_id": 1384,
    "vorder": 119,
    "position": 0,
    "text": "اگر راستی‌تان بود گفت‌وگوی"
  },
  {
    "poem_id": 1384,
    "vorder": 120,
    "position": 1,
    "text": "به نزدیک من تان بود آبروی"
  },
  {
    "poem_id": 1384,
    "vorder": 121,
    "position": 0,
    "text": "وگر هیچ کژی گمانی برم"
  },
  {
    "poem_id": 1384,
    "vorder": 122,
    "position": 1,
    "text": "به زیر پی پیلتان بسپرم"
  },
  {
    "poem_id": 1384,
    "vorder": 123,
    "position": 0,
    "text": "رخ لاله رخ گشت چون سندروس"
  },
  {
    "poem_id": 1384,
    "vorder": 124,
    "position": 1,
    "text": "به پیش سپهبد زمین داد بوس"
  },
  {
    "poem_id": 1384,
    "vorder": 125,
    "position": 0,
    "text": "چنین گفت کز مادر اندر جهان"
  },
  {
    "poem_id": 1384,
    "vorder": 126,
    "position": 1,
    "text": "نزاید کس اندر میان مهان"
  },
  {
    "poem_id": 1384,
    "vorder": 127,
    "position": 0,
    "text": "به دیدار سام و به بالای او"
  },
  {
    "poem_id": 1384,
    "vorder": 128,
    "position": 1,
    "text": "به پاکی دل و دانش و رای او"
  },
  {
    "poem_id": 1384,
    "vorder": 129,
    "position": 0,
    "text": "دگر چون تو ای پهلوان دلیر"
  },
  {
    "poem_id": 1384,
    "vorder": 130,
    "position": 1,
    "text": "بدین برز بالا و بازوی شیر"
  },
  {
    "poem_id": 1384,
    "vorder": 131,
    "position": 0,
    "text": "همی می‌ چکد گویی از روی تو"
  },
  {
    "poem_id": 1384,
    "vorder": 132,
    "position": 1,
    "text": "عبیرست گویی مگر بوی تو"
  },
  {
    "poem_id": 1384,
    "vorder": 133,
    "position": 0,
    "text": "سه دیگر چو رودابهٔ ماه روی"
  },
  {
    "poem_id": 1384,
    "vorder": 134,
    "position": 1,
    "text": "یکی سرو سیمست با رنگ و بوی"
  },
  {
    "poem_id": 1384,
    "vorder": 135,
    "position": 0,
    "text": "ز سر تا به پایش گلست وسمن"
  },
  {
    "poem_id": 1384,
    "vorder": 136,
    "position": 1,
    "text": "به سرو سهی بر سهیل یمن"
  },
  {
    "poem_id": 1384,
    "vorder": 137,
    "position": 0,
    "text": "از آن گنبد سیم سر بر زمین"
  },
  {
    "poem_id": 1384,
    "vorder": 138,
    "position": 1,
    "text": "فرو هشته بر گل کمند از کمین"
  },
  {
    "poem_id": 1384,
    "vorder": 139,
    "position": 0,
    "text": "به مشک و به عنبر سرش بافته"
  },
  {
    "poem_id": 1384,
    "vorder": 140,
    "position": 1,
    "text": "به یاقوت و زمرد تنش تافته"
  },
  {
    "poem_id": 1384,
    "vorder": 141,
    "position": 0,
    "text": "سر زلف و جعدش چو مشکین زره"
  },
  {
    "poem_id": 1384,
    "vorder": 142,
    "position": 1,
    "text": "فگندست گویی گره بر گره"
  },
  {
    "poem_id": 1384,
    "vorder": 143,
    "position": 0,
    "text": "ده انگشت برسان سیمین قلم"
  },
  {
    "poem_id": 1384,
    "vorder": 144,
    "position": 1,
    "text": "برو کرده از غالیه صدرقم"
  },
  {
    "poem_id": 1384,
    "vorder": 145,
    "position": 0,
    "text": "بت آرای چون او نبیند بچین"
  },
  {
    "poem_id": 1384,
    "vorder": 146,
    "position": 1,
    "text": "برو ماه و پروین کنند آفرین"
  },
  {
    "poem_id": 1384,
    "vorder": 147,
    "position": 0,
    "text": "سپهبد پرستنده را گفت گرم"
  },
  {
    "poem_id": 1384,
    "vorder": 148,
    "position": 1,
    "text": "سخنهای شیرین به آوای نرم"
  },
  {
    "poem_id": 1384,
    "vorder": 149,
    "position": 0,
    "text": "که اکنون چه چارست با من بگوی"
  },
  {
    "poem_id": 1384,
    "vorder": 150,
    "position": 1,
    "text": "یکی راه جستن به نزدیک اوی"
  },
  {
    "poem_id": 1384,
    "vorder": 151,
    "position": 0,
    "text": "که ما را دل و جان پر از مهر اوست"
  },
  {
    "poem_id": 1384,
    "vorder": 152,
    "position": 1,
    "text": "همه آرزو دیدن چهر اوست"
  },
  {
    "poem_id": 1384,
    "vorder": 153,
    "position": 0,
    "text": "پرستنده گفتا چو فرمان دهی"
  },
  {
    "poem_id": 1384,
    "vorder": 154,
    "position": 1,
    "text": "گذاریم تا کاخ سرو سهی"
  },
  {
    "poem_id": 1384,
    "vorder": 155,
    "position": 0,
    "text": "ز فرخنده رای جهان پهلوان"
  },
  {
    "poem_id": 1384,
    "vorder": 156,
    "position": 1,
    "text": "ز گفتار و دیدار روشن روان"
  },
  {
    "poem_id": 1384,
    "vorder": 157,
    "position": 0,
    "text": "فریبیم و گوییم هر گونه‌ای"
  },
  {
    "poem_id": 1384,
    "vorder": 158,
    "position": 1,
    "text": "میان اندرون نیست واژونه‌ای"
  },
  {
    "poem_id": 1384,
    "vorder": 159,
    "position": 0,
    "text": "سرمشک بویش به دام آوریم"
  },
  {
    "poem_id": 1384,
    "vorder": 160,
    "position": 1,
    "text": "لبش زی لب پور سام آوریم"
  },
  {
    "poem_id": 1384,
    "vorder": 161,
    "position": 0,
    "text": "خرامد مگر پهلوان با کمند"
  },
  {
    "poem_id": 1384,
    "vorder": 162,
    "position": 1,
    "text": "به نزدیک دیوار کاخ بلند"
  },
  {
    "poem_id": 1384,
    "vorder": 163,
    "position": 0,
    "text": "کند حلقه در گردن کنگره"
  },
  {
    "poem_id": 1384,
    "vorder": 164,
    "position": 1,
    "text": "شود شیر شاد از شکار بره"
  },
  {
    "poem_id": 1384,
    "vorder": 165,
    "position": 0,
    "text": "برفتند خوبان و برگشت زال"
  },
  {
    "poem_id": 1384,
    "vorder": 166,
    "position": 1,
    "text": "دلش گشت با کام و شادی همال"
  }
]