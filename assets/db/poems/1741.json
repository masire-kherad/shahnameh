[
  {
    "poem_id": 1741,
    "vorder": 1,
    "position": 0,
    "text": "چو پالیزبان گفت و موبد شنید"
  },
  {
    "poem_id": 1741,
    "vorder": 2,
    "position": 1,
    "text": "به روشن روان مرد دانا بدید"
  },
  {
    "poem_id": 1741,
    "vorder": 3,
    "position": 0,
    "text": "که آن شیردل مرد جز شاه نیست"
  },
  {
    "poem_id": 1741,
    "vorder": 4,
    "position": 1,
    "text": "همان چهر او جز در گاه نیست"
  },
  {
    "poem_id": 1741,
    "vorder": 5,
    "position": 0,
    "text": "فرستاده‌ای جست روشن‌روان"
  },
  {
    "poem_id": 1741,
    "vorder": 6,
    "position": 1,
    "text": "فرستاد موبد بر پهلوان"
  },
  {
    "poem_id": 1741,
    "vorder": 7,
    "position": 0,
    "text": "که پیدا شد آن فر شاپور شاه"
  },
  {
    "poem_id": 1741,
    "vorder": 8,
    "position": 1,
    "text": "تو از هر سوی انجمن کن سپاه"
  },
  {
    "poem_id": 1741,
    "vorder": 9,
    "position": 0,
    "text": "فرستادهٔ موبد آمد دوان"
  },
  {
    "poem_id": 1741,
    "vorder": 10,
    "position": 1,
    "text": "ز جایی که بد تا در پهلوان"
  },
  {
    "poem_id": 1741,
    "vorder": 11,
    "position": 0,
    "text": "بگفت آنک در باغ شادی و بخت"
  },
  {
    "poem_id": 1741,
    "vorder": 12,
    "position": 1,
    "text": "شکفته شد آن خسروانی درخت"
  },
  {
    "poem_id": 1741,
    "vorder": 13,
    "position": 0,
    "text": "سپهبد ز گفتار او گشت شاد"
  },
  {
    "poem_id": 1741,
    "vorder": 14,
    "position": 1,
    "text": "دلش پر ز کین گشت و لب پر ز باد"
  },
  {
    "poem_id": 1741,
    "vorder": 15,
    "position": 0,
    "text": "به دادار گفت ای جهاندار راست"
  },
  {
    "poem_id": 1741,
    "vorder": 16,
    "position": 1,
    "text": "پرستش کنی جز ترا ناسزاست"
  },
  {
    "poem_id": 1741,
    "vorder": 17,
    "position": 0,
    "text": "که دانست هرگز که شاپور شاه"
  },
  {
    "poem_id": 1741,
    "vorder": 18,
    "position": 1,
    "text": "ببیند سپه نیز و او را سپاه"
  },
  {
    "poem_id": 1741,
    "vorder": 19,
    "position": 0,
    "text": "سپاس از تو ای دادگر یک خدای"
  },
  {
    "poem_id": 1741,
    "vorder": 20,
    "position": 1,
    "text": "جهاندار و بر نیکویی رهنمای"
  },
  {
    "poem_id": 1741,
    "vorder": 21,
    "position": 0,
    "text": "چو شب برکشید آن درفش سیاه"
  },
  {
    "poem_id": 1741,
    "vorder": 22,
    "position": 1,
    "text": "ستاره پدید آمد از گرد ماه"
  },
  {
    "poem_id": 1741,
    "vorder": 23,
    "position": 0,
    "text": "فراز آمد از هر سوی لشکری"
  },
  {
    "poem_id": 1741,
    "vorder": 24,
    "position": 1,
    "text": "به جایی که بد در جهان مهتری"
  },
  {
    "poem_id": 1741,
    "vorder": 25,
    "position": 0,
    "text": "سوی سورستان سربرافراختند"
  },
  {
    "poem_id": 1741,
    "vorder": 26,
    "position": 1,
    "text": "یگان و دوگانه همی تاختند"
  },
  {
    "poem_id": 1741,
    "vorder": 27,
    "position": 0,
    "text": "به درگاه پالیزبان آمدند"
  },
  {
    "poem_id": 1741,
    "vorder": 28,
    "position": 1,
    "text": "به شادی بر میزبان آمدند"
  },
  {
    "poem_id": 1741,
    "vorder": 29,
    "position": 0,
    "text": "چو لشکر شد آسوده بر درسرای"
  },
  {
    "poem_id": 1741,
    "vorder": 30,
    "position": 1,
    "text": "به نزدیک شاه آمد آن پاک‌رای"
  },
  {
    "poem_id": 1741,
    "vorder": 31,
    "position": 0,
    "text": "به شاه جهان گفت پس میزبان"
  },
  {
    "poem_id": 1741,
    "vorder": 32,
    "position": 1,
    "text": "خجستست بر ماه پالیزبان"
  },
  {
    "poem_id": 1741,
    "vorder": 33,
    "position": 0,
    "text": "سپاه انجمن شد بدین درسرای"
  },
  {
    "poem_id": 1741,
    "vorder": 34,
    "position": 1,
    "text": "نگه کن کنون تا چه آیدت رای"
  },
  {
    "poem_id": 1741,
    "vorder": 35,
    "position": 0,
    "text": "بفرمود تا برگشادند راه"
  },
  {
    "poem_id": 1741,
    "vorder": 36,
    "position": 1,
    "text": "اگر چه فرومایه بد جایگاه"
  },
  {
    "poem_id": 1741,
    "vorder": 37,
    "position": 0,
    "text": "چو رفتند نزدیک آن نامجوی"
  },
  {
    "poem_id": 1741,
    "vorder": 38,
    "position": 1,
    "text": "یکایک نهادند بر خاک روی"
  },
  {
    "poem_id": 1741,
    "vorder": 39,
    "position": 0,
    "text": "مهان را همه شاه در بر گرفت"
  },
  {
    "poem_id": 1741,
    "vorder": 40,
    "position": 1,
    "text": "ز بدها خروشیدن اندر گرفت"
  },
  {
    "poem_id": 1741,
    "vorder": 41,
    "position": 0,
    "text": "بگفت آنک از چرم خر دیده بود"
  },
  {
    "poem_id": 1741,
    "vorder": 42,
    "position": 1,
    "text": "سخنهای قیصر که بشنیده بود"
  },
  {
    "poem_id": 1741,
    "vorder": 43,
    "position": 0,
    "text": "هم آزادی آن بت خوب‌چهر"
  },
  {
    "poem_id": 1741,
    "vorder": 44,
    "position": 1,
    "text": "بگفت آنچ او کرد پیدا ز مهر"
  },
  {
    "poem_id": 1741,
    "vorder": 45,
    "position": 0,
    "text": "کزو یافتم جان و از کردگار"
  },
  {
    "poem_id": 1741,
    "vorder": 46,
    "position": 1,
    "text": "که فرخنده بادا برو روزگار"
  },
  {
    "poem_id": 1741,
    "vorder": 47,
    "position": 0,
    "text": "وگر شهریاری و فرخنده‌ای"
  },
  {
    "poem_id": 1741,
    "vorder": 48,
    "position": 1,
    "text": "بود بندهٔ پرهنر بنده‌ای"
  },
  {
    "poem_id": 1741,
    "vorder": 49,
    "position": 0,
    "text": "منم بنده این مهربان بنده را"
  },
  {
    "poem_id": 1741,
    "vorder": 50,
    "position": 1,
    "text": "گشاده‌دل و نازپرورده را"
  },
  {
    "poem_id": 1741,
    "vorder": 51,
    "position": 0,
    "text": "ز هر سو که اکنون سپاه منست"
  },
  {
    "poem_id": 1741,
    "vorder": 52,
    "position": 1,
    "text": "وگر پادشاهی و راه منست"
  },
  {
    "poem_id": 1741,
    "vorder": 53,
    "position": 0,
    "text": "همه کس فرستید و آگه کنید"
  },
  {
    "poem_id": 1741,
    "vorder": 54,
    "position": 1,
    "text": "طلایه پراگنده بر ره کنید"
  },
  {
    "poem_id": 1741,
    "vorder": 55,
    "position": 0,
    "text": "ببندید ویژه ره طیسفون"
  },
  {
    "poem_id": 1741,
    "vorder": 56,
    "position": 1,
    "text": "نباید که آگاهی آید برون"
  },
  {
    "poem_id": 1741,
    "vorder": 57,
    "position": 0,
    "text": "چو قیصر بیابد ز ما آگهی"
  },
  {
    "poem_id": 1741,
    "vorder": 58,
    "position": 1,
    "text": "که بیدار شد فر شاهنشهی"
  },
  {
    "poem_id": 1741,
    "vorder": 59,
    "position": 0,
    "text": "بیاید سپاه مرا برکند"
  },
  {
    "poem_id": 1741,
    "vorder": 60,
    "position": 1,
    "text": "دل و پشت ایرانیان بشکند"
  },
  {
    "poem_id": 1741,
    "vorder": 61,
    "position": 0,
    "text": "کنون ما نداریم پایاب اوی"
  },
  {
    "poem_id": 1741,
    "vorder": 62,
    "position": 1,
    "text": "نه پیچیم با بخت شاداب اوی"
  },
  {
    "poem_id": 1741,
    "vorder": 63,
    "position": 0,
    "text": "چو موبد بیاید بیارد سپاه"
  },
  {
    "poem_id": 1741,
    "vorder": 64,
    "position": 1,
    "text": "ز لشکر ببندیم بر پشه راه"
  },
  {
    "poem_id": 1741,
    "vorder": 65,
    "position": 0,
    "text": "بسازیم و آرایشی نو کنیم"
  },
  {
    "poem_id": 1741,
    "vorder": 66,
    "position": 1,
    "text": "نهانی مگر باغ بی‌خو کنیم"
  },
  {
    "poem_id": 1741,
    "vorder": 67,
    "position": 0,
    "text": "بباید به هر گوشه‌ای دیده‌بان"
  },
  {
    "poem_id": 1741,
    "vorder": 68,
    "position": 1,
    "text": "طلایه به روز و به شب پاسبان"
  },
  {
    "poem_id": 1741,
    "vorder": 69,
    "position": 0,
    "text": "ازان پس نمانیم از رومیان"
  },
  {
    "poem_id": 1741,
    "vorder": 70,
    "position": 1,
    "text": "کسی خسپد ایمن گشاده‌میان"
  }
]