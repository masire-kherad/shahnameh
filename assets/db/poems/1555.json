[
  {
    "poem_id": 1555,
    "vorder": 1,
    "position": 0,
    "text": "سرانجام گشتاسپ بنمود پشت"
  },
  {
    "poem_id": 1555,
    "vorder": 2,
    "position": 1,
    "text": "بدانگه که شد روزگارش درشت"
  },
  {
    "poem_id": 1555,
    "vorder": 3,
    "position": 0,
    "text": "پس اندر دو منزل همی تاختند"
  },
  {
    "poem_id": 1555,
    "vorder": 4,
    "position": 1,
    "text": "مر او را گرفتن همی ساختند"
  },
  {
    "poem_id": 1555,
    "vorder": 5,
    "position": 0,
    "text": "یکی کوه پیش آمدش پرگیا"
  },
  {
    "poem_id": 1555,
    "vorder": 6,
    "position": 1,
    "text": "بدو اندرون چشمه و آسیا"
  },
  {
    "poem_id": 1555,
    "vorder": 7,
    "position": 0,
    "text": "که بر گرد آن کوه یک راه بود"
  },
  {
    "poem_id": 1555,
    "vorder": 8,
    "position": 1,
    "text": "وزان راه گشتاسپ آگاه بود"
  },
  {
    "poem_id": 1555,
    "vorder": 9,
    "position": 0,
    "text": "جهاندار گشتاسپ و یکسر سپاه"
  },
  {
    "poem_id": 1555,
    "vorder": 10,
    "position": 1,
    "text": "سوی کوه رفتند ز آوردگاه"
  },
  {
    "poem_id": 1555,
    "vorder": 11,
    "position": 0,
    "text": "چو ارجاسپ با لشکر آنجا رسید"
  },
  {
    "poem_id": 1555,
    "vorder": 12,
    "position": 1,
    "text": "بگردید و بر کوه راهی ندید"
  },
  {
    "poem_id": 1555,
    "vorder": 13,
    "position": 0,
    "text": "گرفتند گرداندرش چار سوی"
  },
  {
    "poem_id": 1555,
    "vorder": 14,
    "position": 1,
    "text": "چو بیچاره شد شاه آزاده‌خوی"
  },
  {
    "poem_id": 1555,
    "vorder": 15,
    "position": 0,
    "text": "ازان کوهسار آتش افروختند"
  },
  {
    "poem_id": 1555,
    "vorder": 16,
    "position": 1,
    "text": "بدان خاره بر خار می‌سوختند"
  },
  {
    "poem_id": 1555,
    "vorder": 17,
    "position": 0,
    "text": "همی کشت هر مهتری بارگی"
  },
  {
    "poem_id": 1555,
    "vorder": 18,
    "position": 1,
    "text": "نهاند دلها به بیچارگی"
  },
  {
    "poem_id": 1555,
    "vorder": 19,
    "position": 0,
    "text": "چو لشکر چنان گردشان برگرفت"
  },
  {
    "poem_id": 1555,
    "vorder": 20,
    "position": 1,
    "text": "کی خوش منش دست بر سر گرفت"
  },
  {
    "poem_id": 1555,
    "vorder": 21,
    "position": 0,
    "text": "جهاندیده جاماسپ را پیش خواند"
  },
  {
    "poem_id": 1555,
    "vorder": 22,
    "position": 1,
    "text": "ز اختر فراوان سخنها براند"
  },
  {
    "poem_id": 1555,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت کز گردش آسمان"
  },
  {
    "poem_id": 1555,
    "vorder": 24,
    "position": 1,
    "text": "بگوی آنچ دانی و پنهان ممان"
  },
  {
    "poem_id": 1555,
    "vorder": 25,
    "position": 0,
    "text": "که باشد بدین بد مرا دستگیر"
  },
  {
    "poem_id": 1555,
    "vorder": 26,
    "position": 1,
    "text": "ببایدت گفتن همه ناگزیر"
  },
  {
    "poem_id": 1555,
    "vorder": 27,
    "position": 0,
    "text": "چو بشنید جاماسپ بر پای خاست"
  },
  {
    "poem_id": 1555,
    "vorder": 28,
    "position": 1,
    "text": "بدو گفت کای خسرو داد و راست"
  },
  {
    "poem_id": 1555,
    "vorder": 29,
    "position": 0,
    "text": "اگر شاه گفتار من بشنود"
  },
  {
    "poem_id": 1555,
    "vorder": 30,
    "position": 1,
    "text": "بدین گردش اختران بگرود"
  },
  {
    "poem_id": 1555,
    "vorder": 31,
    "position": 0,
    "text": "بگویم بدو هرچ دانم درست"
  },
  {
    "poem_id": 1555,
    "vorder": 32,
    "position": 1,
    "text": "ز من راستی جوی شاها نخست"
  },
  {
    "poem_id": 1555,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت شاه آنچ دانی بگوی"
  },
  {
    "poem_id": 1555,
    "vorder": 34,
    "position": 1,
    "text": "که هم راست گویی و هم راه‌جوی"
  },
  {
    "poem_id": 1555,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت جاماسپ کای شهریار"
  },
  {
    "poem_id": 1555,
    "vorder": 36,
    "position": 1,
    "text": "سخن بشنو از من یکی هوشیار"
  },
  {
    "poem_id": 1555,
    "vorder": 37,
    "position": 0,
    "text": "تو دانی که فرزندت اسفندیار"
  },
  {
    "poem_id": 1555,
    "vorder": 38,
    "position": 1,
    "text": "همی بند ساید به بد روزگار"
  },
  {
    "poem_id": 1555,
    "vorder": 39,
    "position": 0,
    "text": "اگر شاه بگشاید او را ز بند"
  },
  {
    "poem_id": 1555,
    "vorder": 40,
    "position": 1,
    "text": "نماند برین کوهسار بلند"
  },
  {
    "poem_id": 1555,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای راست‌گوی"
  },
  {
    "poem_id": 1555,
    "vorder": 42,
    "position": 1,
    "text": "بجز راستی نیست ایچ آرزوی"
  },
  {
    "poem_id": 1555,
    "vorder": 43,
    "position": 0,
    "text": "به جاماسپ گفت ای خردمند مرد"
  },
  {
    "poem_id": 1555,
    "vorder": 44,
    "position": 1,
    "text": "مرا بود ازان کار دل پر ز درد"
  },
  {
    "poem_id": 1555,
    "vorder": 45,
    "position": 0,
    "text": "که اورا ببستم بران بزمگاه"
  },
  {
    "poem_id": 1555,
    "vorder": 46,
    "position": 1,
    "text": "به گفتار بدخواه و او بیگناه"
  },
  {
    "poem_id": 1555,
    "vorder": 47,
    "position": 0,
    "text": "همانگاه من زان پشیمان شدم"
  },
  {
    "poem_id": 1555,
    "vorder": 48,
    "position": 1,
    "text": "دلم خسته بد سوی درمان شدم"
  },
  {
    "poem_id": 1555,
    "vorder": 49,
    "position": 0,
    "text": "گر او را ببینم برین رزمگاه"
  },
  {
    "poem_id": 1555,
    "vorder": 50,
    "position": 1,
    "text": "بدو بخشم این تاج و تخت و کلاه"
  },
  {
    "poem_id": 1555,
    "vorder": 51,
    "position": 0,
    "text": "که یارد شدن پیش آن ارجمند"
  },
  {
    "poem_id": 1555,
    "vorder": 52,
    "position": 1,
    "text": "رهاند مران بیگنه را ز بند"
  },
  {
    "poem_id": 1555,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت جاماسپ کای شهریار"
  },
  {
    "poem_id": 1555,
    "vorder": 54,
    "position": 1,
    "text": "منم رفتنی کاین سخن نیست خوار"
  },
  {
    "poem_id": 1555,
    "vorder": 55,
    "position": 0,
    "text": "به جاماسپ شاه جهاندار گفت"
  },
  {
    "poem_id": 1555,
    "vorder": 56,
    "position": 1,
    "text": "که با تو همیشه خرد باد جفت"
  },
  {
    "poem_id": 1555,
    "vorder": 57,
    "position": 0,
    "text": "برو وز منش ده فراوان درود"
  },
  {
    "poem_id": 1555,
    "vorder": 58,
    "position": 1,
    "text": "شب تیره ناگاه بگذر ز رود"
  },
  {
    "poem_id": 1555,
    "vorder": 59,
    "position": 0,
    "text": "بگویش که آنکس که بیداد کرد"
  },
  {
    "poem_id": 1555,
    "vorder": 60,
    "position": 1,
    "text": "بشد زین جهان با دلی پر ز درد"
  },
  {
    "poem_id": 1555,
    "vorder": 61,
    "position": 0,
    "text": "اگر من برفتم بگفت کسی"
  },
  {
    "poem_id": 1555,
    "vorder": 62,
    "position": 1,
    "text": "که بهره نبودش ز دانش بسی"
  },
  {
    "poem_id": 1555,
    "vorder": 63,
    "position": 0,
    "text": "چو بیداد کردم بسیچم همی"
  },
  {
    "poem_id": 1555,
    "vorder": 64,
    "position": 1,
    "text": "وزان کردهٔ خویش پیچم همی"
  },
  {
    "poem_id": 1555,
    "vorder": 65,
    "position": 0,
    "text": "کنون گر بیایی دل از کینه پاک"
  },
  {
    "poem_id": 1555,
    "vorder": 66,
    "position": 1,
    "text": "سر دشمنان اندر آری به خاک"
  },
  {
    "poem_id": 1555,
    "vorder": 67,
    "position": 0,
    "text": "وگرنه شد این پادشاهی و تخت"
  },
  {
    "poem_id": 1555,
    "vorder": 68,
    "position": 1,
    "text": "ز بن برکنند این کیانی درخت"
  },
  {
    "poem_id": 1555,
    "vorder": 69,
    "position": 0,
    "text": "چو آیی سپارم ترا تاج و گنج"
  },
  {
    "poem_id": 1555,
    "vorder": 70,
    "position": 1,
    "text": "ز چیزی که من گرد کردم به رنج"
  },
  {
    "poem_id": 1555,
    "vorder": 71,
    "position": 0,
    "text": "بدین گفته یزدان گوای منست"
  },
  {
    "poem_id": 1555,
    "vorder": 72,
    "position": 1,
    "text": "چو جاماسپ کو رهنمای منست"
  },
  {
    "poem_id": 1555,
    "vorder": 73,
    "position": 0,
    "text": "بپوشید جاماسپ توزی قبای"
  },
  {
    "poem_id": 1555,
    "vorder": 74,
    "position": 1,
    "text": "فرود آمد از کوه بی‌رهنمای"
  },
  {
    "poem_id": 1555,
    "vorder": 75,
    "position": 0,
    "text": "به سر بر نهاده کلاه دو پر"
  },
  {
    "poem_id": 1555,
    "vorder": 76,
    "position": 1,
    "text": "برآیین ترکان ببسته کمر"
  },
  {
    "poem_id": 1555,
    "vorder": 77,
    "position": 0,
    "text": "یکی اسپ ترکی بیاورد پیش"
  },
  {
    "poem_id": 1555,
    "vorder": 78,
    "position": 1,
    "text": "ابر اسپ آلت ز اندازه بیش"
  },
  {
    "poem_id": 1555,
    "vorder": 79,
    "position": 0,
    "text": "نشست از بر باره و آمد به زیر"
  },
  {
    "poem_id": 1555,
    "vorder": 80,
    "position": 1,
    "text": "که بد مرد شایسته بر سان شیر"
  },
  {
    "poem_id": 1555,
    "vorder": 81,
    "position": 0,
    "text": "هرانکس که او را بدیدی به راه"
  },
  {
    "poem_id": 1555,
    "vorder": 82,
    "position": 1,
    "text": "بپرسیدی او را ز توران سپاه"
  },
  {
    "poem_id": 1555,
    "vorder": 83,
    "position": 0,
    "text": "به آواز ترکی سخن راندی"
  },
  {
    "poem_id": 1555,
    "vorder": 84,
    "position": 1,
    "text": "بگفتی بدان کس که او خواندی"
  },
  {
    "poem_id": 1555,
    "vorder": 85,
    "position": 0,
    "text": "ندانستی او را کسی حال و کار"
  },
  {
    "poem_id": 1555,
    "vorder": 86,
    "position": 1,
    "text": "بگفتی به ترکی سخن هوشیار"
  },
  {
    "poem_id": 1555,
    "vorder": 87,
    "position": 0,
    "text": "همی راند باره به کردار باد"
  },
  {
    "poem_id": 1555,
    "vorder": 88,
    "position": 1,
    "text": "چنین تا بیامد بر شاه زاد"
  },
  {
    "poem_id": 1555,
    "vorder": 89,
    "position": 0,
    "text": "خرد یافته چون بیامد به دشت"
  },
  {
    "poem_id": 1555,
    "vorder": 90,
    "position": 1,
    "text": "شب تیره از لشکر اندر گذشت"
  },
  {
    "poem_id": 1555,
    "vorder": 91,
    "position": 0,
    "text": "چو آمد به نزد دژ گنبدان"
  },
  {
    "poem_id": 1555,
    "vorder": 92,
    "position": 1,
    "text": "رهانید خود را ز دست بدان"
  }
]