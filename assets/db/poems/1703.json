[
  {
    "poem_id": 1703,
    "vorder": 1,
    "position": 0,
    "text": "چو آگه شد از هفتواد اردشیر"
  },
  {
    "poem_id": 1703,
    "vorder": 2,
    "position": 1,
    "text": "نبود آن سخنها ورا دلپذیر"
  },
  {
    "poem_id": 1703,
    "vorder": 3,
    "position": 0,
    "text": "سپهبد فرستاد نزدیک اوی"
  },
  {
    "poem_id": 1703,
    "vorder": 4,
    "position": 1,
    "text": "سپاهی بلند اختر و رزمجوی"
  },
  {
    "poem_id": 1703,
    "vorder": 5,
    "position": 0,
    "text": "چو آگاه شد زان سخن هفتواد"
  },
  {
    "poem_id": 1703,
    "vorder": 6,
    "position": 1,
    "text": "ازیشان به دل در نیامدش یاد"
  },
  {
    "poem_id": 1703,
    "vorder": 7,
    "position": 0,
    "text": "کمینگاه کرد اندران کنج کوه"
  },
  {
    "poem_id": 1703,
    "vorder": 8,
    "position": 1,
    "text": "بیامد سوی رزم خود با گروه"
  },
  {
    "poem_id": 1703,
    "vorder": 9,
    "position": 0,
    "text": "چو لشکر سراسر برآشوفتند"
  },
  {
    "poem_id": 1703,
    "vorder": 10,
    "position": 1,
    "text": "به گرز و تبرزین همی کوفتند"
  },
  {
    "poem_id": 1703,
    "vorder": 11,
    "position": 0,
    "text": "سپاه اندرآمد ز جای کمین"
  },
  {
    "poem_id": 1703,
    "vorder": 12,
    "position": 1,
    "text": "سیه شد بران نامداران زمین"
  },
  {
    "poem_id": 1703,
    "vorder": 13,
    "position": 0,
    "text": "کسی بازنشناخت از پای دست"
  },
  {
    "poem_id": 1703,
    "vorder": 14,
    "position": 1,
    "text": "تو گفتی زمین دست ایشان ببست"
  },
  {
    "poem_id": 1703,
    "vorder": 15,
    "position": 0,
    "text": "ز کشته چنان شد در و دشت و کوه"
  },
  {
    "poem_id": 1703,
    "vorder": 16,
    "position": 1,
    "text": "که پیروزگر شد ز کشتن ستوه"
  },
  {
    "poem_id": 1703,
    "vorder": 17,
    "position": 0,
    "text": "هرانکس که بد زنده زان رزمگاه"
  },
  {
    "poem_id": 1703,
    "vorder": 18,
    "position": 1,
    "text": "سبک باز رفتند نزدیک شاه"
  },
  {
    "poem_id": 1703,
    "vorder": 19,
    "position": 0,
    "text": "چو آگاه شد نامدار اردشیر"
  },
  {
    "poem_id": 1703,
    "vorder": 20,
    "position": 1,
    "text": "ازان کشتن و غارت و دار و گیر"
  },
  {
    "poem_id": 1703,
    "vorder": 21,
    "position": 0,
    "text": "غمی گشت و لشکر همی باز خواند"
  },
  {
    "poem_id": 1703,
    "vorder": 22,
    "position": 1,
    "text": "به زودی سلیح و درم برفشاند"
  },
  {
    "poem_id": 1703,
    "vorder": 23,
    "position": 0,
    "text": "به تندی بیامد سوی هفتواد"
  },
  {
    "poem_id": 1703,
    "vorder": 24,
    "position": 1,
    "text": "به گردون برآمد سر بدنژاد"
  },
  {
    "poem_id": 1703,
    "vorder": 25,
    "position": 0,
    "text": "بیاورد گنج و سلیح از حصار"
  },
  {
    "poem_id": 1703,
    "vorder": 26,
    "position": 1,
    "text": "برو خوار شد لشکر و کارزار"
  },
  {
    "poem_id": 1703,
    "vorder": 27,
    "position": 0,
    "text": "جدا بود ازو دور مهتر پسر"
  },
  {
    "poem_id": 1703,
    "vorder": 28,
    "position": 1,
    "text": "چو آگاه شد او ز رزم پدر"
  },
  {
    "poem_id": 1703,
    "vorder": 29,
    "position": 0,
    "text": "برآمد ز آرام وز خورد و خواب"
  },
  {
    "poem_id": 1703,
    "vorder": 30,
    "position": 1,
    "text": "به کشتی بیامد برین روی آب"
  },
  {
    "poem_id": 1703,
    "vorder": 31,
    "position": 0,
    "text": "جهانجوی را نام شاهوی بود"
  },
  {
    "poem_id": 1703,
    "vorder": 32,
    "position": 1,
    "text": "یکی مرد بدساز و بدگوی بود"
  },
  {
    "poem_id": 1703,
    "vorder": 33,
    "position": 0,
    "text": "ز کشتی بیامد بر هفتواد"
  },
  {
    "poem_id": 1703,
    "vorder": 34,
    "position": 1,
    "text": "دل هفتواد از پسر گشت شاد"
  },
  {
    "poem_id": 1703,
    "vorder": 35,
    "position": 0,
    "text": "بیاراست بر میمنه جای خویش"
  },
  {
    "poem_id": 1703,
    "vorder": 36,
    "position": 1,
    "text": "سپهبد بد و لشکر آرای خویش"
  },
  {
    "poem_id": 1703,
    "vorder": 37,
    "position": 0,
    "text": "دو لشکر بشد هر دو آراسته"
  },
  {
    "poem_id": 1703,
    "vorder": 38,
    "position": 1,
    "text": "پر از کینه سر گنج پر خواسته"
  },
  {
    "poem_id": 1703,
    "vorder": 39,
    "position": 0,
    "text": "بدیشان نگه کرد شاه اردشیر"
  },
  {
    "poem_id": 1703,
    "vorder": 40,
    "position": 1,
    "text": "دل مرد برنا شد از رنج پیر"
  },
  {
    "poem_id": 1703,
    "vorder": 41,
    "position": 0,
    "text": "سپه برکشید از دو رویه دو صف"
  },
  {
    "poem_id": 1703,
    "vorder": 42,
    "position": 1,
    "text": "ز خورشید و شمشیر برخاست تف"
  },
  {
    "poem_id": 1703,
    "vorder": 43,
    "position": 0,
    "text": "چو آواز کوس آمد از پشت پیل"
  },
  {
    "poem_id": 1703,
    "vorder": 44,
    "position": 1,
    "text": "همی مرد بیهوش گشت از دو میل"
  },
  {
    "poem_id": 1703,
    "vorder": 45,
    "position": 0,
    "text": "برآمد خروشیدن گاودم"
  },
  {
    "poem_id": 1703,
    "vorder": 46,
    "position": 1,
    "text": "جهان پر شد از بانگ رویینه خم"
  },
  {
    "poem_id": 1703,
    "vorder": 47,
    "position": 0,
    "text": "زمین جنب جنبان شد از میخ نعل"
  },
  {
    "poem_id": 1703,
    "vorder": 48,
    "position": 1,
    "text": "هوا از درفش سران گشت لعل"
  },
  {
    "poem_id": 1703,
    "vorder": 49,
    "position": 0,
    "text": "از آواز گوپال وز ترگ و خود"
  },
  {
    "poem_id": 1703,
    "vorder": 50,
    "position": 1,
    "text": "همی داد گردون زمین را درود"
  },
  {
    "poem_id": 1703,
    "vorder": 51,
    "position": 0,
    "text": "تگ بادپایان زمین را کنان"
  },
  {
    "poem_id": 1703,
    "vorder": 52,
    "position": 1,
    "text": "در و دشت شد پر سر بی‌تنان"
  },
  {
    "poem_id": 1703,
    "vorder": 53,
    "position": 0,
    "text": "برآن گونه شد لشکر هفتواد"
  },
  {
    "poem_id": 1703,
    "vorder": 54,
    "position": 1,
    "text": "که گفتی بجنبید دریا ز باد"
  },
  {
    "poem_id": 1703,
    "vorder": 55,
    "position": 0,
    "text": "بیابان چنان شد ز هر دو سپاه"
  },
  {
    "poem_id": 1703,
    "vorder": 56,
    "position": 1,
    "text": "که بر مور و بر پشه شد تنگ راه"
  },
  {
    "poem_id": 1703,
    "vorder": 57,
    "position": 0,
    "text": "برین گونه تا روز برگشت زرد"
  },
  {
    "poem_id": 1703,
    "vorder": 58,
    "position": 1,
    "text": "برآورد شب چادر لاژورد"
  },
  {
    "poem_id": 1703,
    "vorder": 59,
    "position": 0,
    "text": "ز هر سو سپه باز خواند اردشیر"
  },
  {
    "poem_id": 1703,
    "vorder": 60,
    "position": 1,
    "text": "پس پشت او بد یکی آبگیر"
  },
  {
    "poem_id": 1703,
    "vorder": 61,
    "position": 0,
    "text": "چو دریای زنگارگون شد سیاه"
  },
  {
    "poem_id": 1703,
    "vorder": 62,
    "position": 1,
    "text": "طلایه بیامد ز هر دو سپاه"
  },
  {
    "poem_id": 1703,
    "vorder": 63,
    "position": 0,
    "text": "خورش تنگ بد لشکر شاه را"
  },
  {
    "poem_id": 1703,
    "vorder": 64,
    "position": 1,
    "text": "که بدخواه او بسته بد راه را"
  }
]