[
  {
    "poem_id": 1584,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید رستم ز بهمن سخن"
  },
  {
    "poem_id": 1584,
    "vorder": 2,
    "position": 1,
    "text": "پراندیشه شد مغز مرد کهن"
  },
  {
    "poem_id": 1584,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت کآری شنیدم پیام"
  },
  {
    "poem_id": 1584,
    "vorder": 4,
    "position": 1,
    "text": "دلم شد به دیدار تو شادکام"
  },
  {
    "poem_id": 1584,
    "vorder": 5,
    "position": 0,
    "text": "ز من پاسخ این بر به اسفندیار"
  },
  {
    "poem_id": 1584,
    "vorder": 6,
    "position": 1,
    "text": "که ای شیردل مهتر نامدار"
  },
  {
    "poem_id": 1584,
    "vorder": 7,
    "position": 0,
    "text": "هرانکس که دارد روانش خرد"
  },
  {
    "poem_id": 1584,
    "vorder": 8,
    "position": 1,
    "text": "سر مایهٔ کارها بنگرد"
  },
  {
    "poem_id": 1584,
    "vorder": 9,
    "position": 0,
    "text": "چو مردی و پیروزی و خواسته"
  },
  {
    "poem_id": 1584,
    "vorder": 10,
    "position": 1,
    "text": "ورا باشد و گنج آراسته"
  },
  {
    "poem_id": 1584,
    "vorder": 11,
    "position": 0,
    "text": "بزرگی و گردی و نام بلند"
  },
  {
    "poem_id": 1584,
    "vorder": 12,
    "position": 1,
    "text": "به نزد گرانمایگان ارجمند"
  },
  {
    "poem_id": 1584,
    "vorder": 13,
    "position": 0,
    "text": "به گیتی بدین سان که اکنون تویی"
  },
  {
    "poem_id": 1584,
    "vorder": 14,
    "position": 1,
    "text": "نباید که داری سر بدخویی"
  },
  {
    "poem_id": 1584,
    "vorder": 15,
    "position": 0,
    "text": "بباشیم بر داد و یزدان‌پرست"
  },
  {
    "poem_id": 1584,
    "vorder": 16,
    "position": 1,
    "text": "نگیریم دست بدی را به دست"
  },
  {
    "poem_id": 1584,
    "vorder": 17,
    "position": 0,
    "text": "سخن هرچ بر گفتنش روی نیست"
  },
  {
    "poem_id": 1584,
    "vorder": 18,
    "position": 1,
    "text": "درختی بود کش بر و بوی نیست"
  },
  {
    "poem_id": 1584,
    "vorder": 19,
    "position": 0,
    "text": "وگر جان تو بسپرد راه آز"
  },
  {
    "poem_id": 1584,
    "vorder": 20,
    "position": 1,
    "text": "شود کار بی‌سود بر تو دراز"
  },
  {
    "poem_id": 1584,
    "vorder": 21,
    "position": 0,
    "text": "چو مهتر سراید سخن سخته به"
  },
  {
    "poem_id": 1584,
    "vorder": 22,
    "position": 1,
    "text": "ز گفتار بد کام پردخته به"
  },
  {
    "poem_id": 1584,
    "vorder": 23,
    "position": 0,
    "text": "ز گفتارت آن کس بدی بنده شاد"
  },
  {
    "poem_id": 1584,
    "vorder": 24,
    "position": 1,
    "text": "که گفتی که چون تو ز مادر نزاد"
  },
  {
    "poem_id": 1584,
    "vorder": 25,
    "position": 0,
    "text": "به مردی و گردی و رای و خرد"
  },
  {
    "poem_id": 1584,
    "vorder": 26,
    "position": 1,
    "text": "همی بر نیاکان خود بگذرد"
  },
  {
    "poem_id": 1584,
    "vorder": 27,
    "position": 0,
    "text": "پدیدست نامت به هندوستان"
  },
  {
    "poem_id": 1584,
    "vorder": 28,
    "position": 1,
    "text": "به روم و به چین و به جادوستان"
  },
  {
    "poem_id": 1584,
    "vorder": 29,
    "position": 0,
    "text": "ازین پندها داشتم من سپاس"
  },
  {
    "poem_id": 1584,
    "vorder": 30,
    "position": 1,
    "text": "نیایش کنم روز و شب در سه‌پاس"
  },
  {
    "poem_id": 1584,
    "vorder": 31,
    "position": 0,
    "text": "ز یزدان همی آرزو خواستم"
  },
  {
    "poem_id": 1584,
    "vorder": 32,
    "position": 1,
    "text": "که اکنون بتو دل بیاراستم"
  },
  {
    "poem_id": 1584,
    "vorder": 33,
    "position": 0,
    "text": "که بینم پسندیده چهر ترا"
  },
  {
    "poem_id": 1584,
    "vorder": 34,
    "position": 1,
    "text": "بزرگی و گردی و مهر ترا"
  },
  {
    "poem_id": 1584,
    "vorder": 35,
    "position": 0,
    "text": "نشینیم یک با دگر شادکام"
  },
  {
    "poem_id": 1584,
    "vorder": 36,
    "position": 1,
    "text": "به یاد شهنشاه گیریم جام"
  },
  {
    "poem_id": 1584,
    "vorder": 37,
    "position": 0,
    "text": "کنون آنچ جستم همه یافتم"
  },
  {
    "poem_id": 1584,
    "vorder": 38,
    "position": 1,
    "text": "به خواهشگری تیز بشتافتم"
  },
  {
    "poem_id": 1584,
    "vorder": 39,
    "position": 0,
    "text": "به پیش تو آیم کنون بی‌سپاه"
  },
  {
    "poem_id": 1584,
    "vorder": 40,
    "position": 1,
    "text": "ز تو بشنوم هرچ فرمود شاه"
  },
  {
    "poem_id": 1584,
    "vorder": 41,
    "position": 0,
    "text": "بیارم برت عهد شاهان داد"
  },
  {
    "poem_id": 1584,
    "vorder": 42,
    "position": 1,
    "text": "ز کیخسرو آغاز تا کیقباد"
  },
  {
    "poem_id": 1584,
    "vorder": 43,
    "position": 0,
    "text": "کنون شهریارا تو در کار من"
  },
  {
    "poem_id": 1584,
    "vorder": 44,
    "position": 1,
    "text": "نگه کن به کردار و آزار من"
  },
  {
    "poem_id": 1584,
    "vorder": 45,
    "position": 0,
    "text": "گر آن نیکویها که من کرده‌ام"
  },
  {
    "poem_id": 1584,
    "vorder": 46,
    "position": 1,
    "text": "همان رنجهایی که من برده‌ام"
  },
  {
    "poem_id": 1584,
    "vorder": 47,
    "position": 0,
    "text": "پرستیدن شهریاران همان"
  },
  {
    "poem_id": 1584,
    "vorder": 48,
    "position": 1,
    "text": "از امروز تا روز پیشی همان"
  },
  {
    "poem_id": 1584,
    "vorder": 49,
    "position": 0,
    "text": "چو پاداش آن رنج بند آیدم"
  },
  {
    "poem_id": 1584,
    "vorder": 50,
    "position": 1,
    "text": "که از شاه ایران گزند آیدم"
  },
  {
    "poem_id": 1584,
    "vorder": 51,
    "position": 0,
    "text": "همان به که گیتی نبیند کسی"
  },
  {
    "poem_id": 1584,
    "vorder": 52,
    "position": 1,
    "text": "چو بیند بدو در نماند بسی"
  },
  {
    "poem_id": 1584,
    "vorder": 53,
    "position": 0,
    "text": "بیابم بگویم همه راز خویش"
  },
  {
    "poem_id": 1584,
    "vorder": 54,
    "position": 1,
    "text": "ز گیتی برافرازم آواز خویش"
  },
  {
    "poem_id": 1584,
    "vorder": 55,
    "position": 0,
    "text": "به بازو ببندم یکی پالهنگ"
  },
  {
    "poem_id": 1584,
    "vorder": 56,
    "position": 1,
    "text": "بیاویز پایم به چرم پلنگ"
  },
  {
    "poem_id": 1584,
    "vorder": 57,
    "position": 0,
    "text": "ازان سان که من گردن ژنده پیل"
  },
  {
    "poem_id": 1584,
    "vorder": 58,
    "position": 1,
    "text": "ببستم فکندم به دریای نیل"
  },
  {
    "poem_id": 1584,
    "vorder": 59,
    "position": 0,
    "text": "چو از من گناهی بیابد پدید"
  },
  {
    "poem_id": 1584,
    "vorder": 60,
    "position": 1,
    "text": "ازان پس سر من بباید برید"
  },
  {
    "poem_id": 1584,
    "vorder": 61,
    "position": 0,
    "text": "سخنهای ناخوش ز من دور دار"
  },
  {
    "poem_id": 1584,
    "vorder": 62,
    "position": 1,
    "text": "به بدها دل دیو رنجور دار"
  },
  {
    "poem_id": 1584,
    "vorder": 63,
    "position": 0,
    "text": "مگوی آنچ هرگز نگفتست کس"
  },
  {
    "poem_id": 1584,
    "vorder": 64,
    "position": 1,
    "text": "به مردی مکن باد را در قفس"
  },
  {
    "poem_id": 1584,
    "vorder": 65,
    "position": 0,
    "text": "بزرگان به دانش بیابند راه"
  },
  {
    "poem_id": 1584,
    "vorder": 66,
    "position": 1,
    "text": "ز دریا گذر نیست بی‌آشناه"
  },
  {
    "poem_id": 1584,
    "vorder": 67,
    "position": 0,
    "text": "همان تابش مهر نتوان نهفت"
  },
  {
    "poem_id": 1584,
    "vorder": 68,
    "position": 1,
    "text": "نه روبه توان کرد با شیر جفت"
  },
  {
    "poem_id": 1584,
    "vorder": 69,
    "position": 0,
    "text": "تو بر راه من بر ستیزه مریز"
  },
  {
    "poem_id": 1584,
    "vorder": 70,
    "position": 1,
    "text": "که من خود یکی مایه‌ام در ستیز"
  },
  {
    "poem_id": 1584,
    "vorder": 71,
    "position": 0,
    "text": "ندیدست کس بند بر پای من"
  },
  {
    "poem_id": 1584,
    "vorder": 72,
    "position": 1,
    "text": "نه بگرفت پیل ژیان جای من"
  },
  {
    "poem_id": 1584,
    "vorder": 73,
    "position": 0,
    "text": "تو آن کن که از پادشاهان سزاست"
  },
  {
    "poem_id": 1584,
    "vorder": 74,
    "position": 1,
    "text": "مدار آز را دیو بر دست راست"
  },
  {
    "poem_id": 1584,
    "vorder": 75,
    "position": 0,
    "text": "به مردی ز دل دور کن خشم و کین"
  },
  {
    "poem_id": 1584,
    "vorder": 76,
    "position": 1,
    "text": "جهان را به چشم جوانی مبین"
  },
  {
    "poem_id": 1584,
    "vorder": 77,
    "position": 0,
    "text": "به دل خرمی دار و بگذر ز رود"
  },
  {
    "poem_id": 1584,
    "vorder": 78,
    "position": 1,
    "text": "ترا باد از پاک یزدان درود"
  },
  {
    "poem_id": 1584,
    "vorder": 79,
    "position": 0,
    "text": "گرامی کن ایوان ما را به سور"
  },
  {
    "poem_id": 1584,
    "vorder": 80,
    "position": 1,
    "text": "مباش از پرستندهٔ خویش دور"
  },
  {
    "poem_id": 1584,
    "vorder": 81,
    "position": 0,
    "text": "چنان چون بدم کهتر کیقباد"
  },
  {
    "poem_id": 1584,
    "vorder": 82,
    "position": 1,
    "text": "کنون از تو دارم دل و مغز شاد"
  },
  {
    "poem_id": 1584,
    "vorder": 83,
    "position": 0,
    "text": "چو آیی به ایوان من با سپاه"
  },
  {
    "poem_id": 1584,
    "vorder": 84,
    "position": 1,
    "text": "هم‌ایدر به شادی بباشی دو ماه"
  },
  {
    "poem_id": 1584,
    "vorder": 85,
    "position": 0,
    "text": "برآساید از رنج مرد و ستور"
  },
  {
    "poem_id": 1584,
    "vorder": 86,
    "position": 1,
    "text": "دل دشمنان گردد از رشک کور"
  },
  {
    "poem_id": 1584,
    "vorder": 87,
    "position": 0,
    "text": "همه دشت نخچیر و مرغ اندر آب"
  },
  {
    "poem_id": 1584,
    "vorder": 88,
    "position": 1,
    "text": "اگر دیر مانی بگیرد شتاب"
  },
  {
    "poem_id": 1584,
    "vorder": 89,
    "position": 0,
    "text": "ببینم ز تو زور مردان جنگ"
  },
  {
    "poem_id": 1584,
    "vorder": 90,
    "position": 1,
    "text": "به شمشیر شیر افگنی گر پلنگ"
  },
  {
    "poem_id": 1584,
    "vorder": 91,
    "position": 0,
    "text": "چو خواهی که لشکر به ایران بری"
  },
  {
    "poem_id": 1584,
    "vorder": 92,
    "position": 1,
    "text": "به نزدیک شاه دلیران بری"
  },
  {
    "poem_id": 1584,
    "vorder": 93,
    "position": 0,
    "text": "گشایم در گنجهای کهن"
  },
  {
    "poem_id": 1584,
    "vorder": 94,
    "position": 1,
    "text": "که ایدر فکندم به شمشیر بن"
  },
  {
    "poem_id": 1584,
    "vorder": 95,
    "position": 0,
    "text": "به پیش تو آرم همه هرچ هست"
  },
  {
    "poem_id": 1584,
    "vorder": 96,
    "position": 1,
    "text": "کجا گرد کردم به نیروی دست"
  },
  {
    "poem_id": 1584,
    "vorder": 97,
    "position": 0,
    "text": "بخواه آنچ خواهی و دیگر ببخش"
  },
  {
    "poem_id": 1584,
    "vorder": 98,
    "position": 1,
    "text": "مکن بر دل ما چنین روز دخش"
  },
  {
    "poem_id": 1584,
    "vorder": 99,
    "position": 0,
    "text": "درم ده سپه را و تندی مکن"
  },
  {
    "poem_id": 1584,
    "vorder": 100,
    "position": 1,
    "text": "چو خوبی بیابی نژندی مکن"
  },
  {
    "poem_id": 1584,
    "vorder": 101,
    "position": 0,
    "text": "چو هنگام رفتن فراز آیدت"
  },
  {
    "poem_id": 1584,
    "vorder": 102,
    "position": 1,
    "text": "به دیدار خسرو نیاز آیدت"
  },
  {
    "poem_id": 1584,
    "vorder": 103,
    "position": 0,
    "text": "عنان با عنان تو بندم به راه"
  },
  {
    "poem_id": 1584,
    "vorder": 104,
    "position": 1,
    "text": "خرامان بیایم به نزدیک شاه"
  },
  {
    "poem_id": 1584,
    "vorder": 105,
    "position": 0,
    "text": "به پوزش کنم نرم خشم ورا"
  },
  {
    "poem_id": 1584,
    "vorder": 106,
    "position": 1,
    "text": "ببوسم سر و پای و چشم ورا"
  },
  {
    "poem_id": 1584,
    "vorder": 107,
    "position": 0,
    "text": "بپرسم ز بیدار شاه بلند"
  },
  {
    "poem_id": 1584,
    "vorder": 108,
    "position": 1,
    "text": "که پایم چرا کرد باید به بند"
  },
  {
    "poem_id": 1584,
    "vorder": 109,
    "position": 0,
    "text": "همه هرچ گفتم ترا یاد دار"
  },
  {
    "poem_id": 1584,
    "vorder": 110,
    "position": 1,
    "text": "بگویش به پرمایه اسفندیار"
  }
]