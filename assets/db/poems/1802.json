[
  {
    "poem_id": 1802,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید شنگل به بهرام گفت"
  },
  {
    "poem_id": 1802,
    "vorder": 2,
    "position": 1,
    "text": "که رای تو با مردمی نیست جفت"
  },
  {
    "poem_id": 1802,
    "vorder": 3,
    "position": 0,
    "text": "زمانی فرودآی و بگشای بند"
  },
  {
    "poem_id": 1802,
    "vorder": 4,
    "position": 1,
    "text": "چه گویی سخن‌های ناسودمند"
  },
  {
    "poem_id": 1802,
    "vorder": 5,
    "position": 0,
    "text": "یکی خرم ایوان بپرداختند"
  },
  {
    "poem_id": 1802,
    "vorder": 6,
    "position": 1,
    "text": "همه هرچ بایست برساختند"
  },
  {
    "poem_id": 1802,
    "vorder": 7,
    "position": 0,
    "text": "بیاسود بهرام تا نیم‌روز"
  },
  {
    "poem_id": 1802,
    "vorder": 8,
    "position": 1,
    "text": "چو بر اوج شد تاج گیتی فروز"
  },
  {
    "poem_id": 1802,
    "vorder": 9,
    "position": 0,
    "text": "چو در پیش شنگل نهادند خوان"
  },
  {
    "poem_id": 1802,
    "vorder": 10,
    "position": 1,
    "text": "یکی را بفرمود کو را بخوان"
  },
  {
    "poem_id": 1802,
    "vorder": 11,
    "position": 0,
    "text": "کز ایران فرستادهٔ خسروپرست"
  },
  {
    "poem_id": 1802,
    "vorder": 12,
    "position": 1,
    "text": "سخن‌گوی و هم کامگار نوست"
  },
  {
    "poem_id": 1802,
    "vorder": 13,
    "position": 0,
    "text": "کسی را که با اوست هم زین‌نشان"
  },
  {
    "poem_id": 1802,
    "vorder": 14,
    "position": 1,
    "text": "بیاور به خوان رسولان نشان"
  },
  {
    "poem_id": 1802,
    "vorder": 15,
    "position": 0,
    "text": "بشد تیز بهرام و بر خوان نشست"
  },
  {
    "poem_id": 1802,
    "vorder": 16,
    "position": 1,
    "text": "بنان دست بگشاد و لب را ببست"
  },
  {
    "poem_id": 1802,
    "vorder": 17,
    "position": 0,
    "text": "چو نان خورده شد مجلس آراستند"
  },
  {
    "poem_id": 1802,
    "vorder": 18,
    "position": 1,
    "text": "نوازندهٔ رود و می خواستند"
  },
  {
    "poem_id": 1802,
    "vorder": 19,
    "position": 0,
    "text": "همی بوی مشک آمد از خوردنی"
  },
  {
    "poem_id": 1802,
    "vorder": 20,
    "position": 1,
    "text": "همان زیر زربفت گستردنی"
  },
  {
    "poem_id": 1802,
    "vorder": 21,
    "position": 0,
    "text": "بزرگان چو از باده خرم شدند"
  },
  {
    "poem_id": 1802,
    "vorder": 22,
    "position": 1,
    "text": "ز تیمار نابوده بی‌غم شدند"
  },
  {
    "poem_id": 1802,
    "vorder": 23,
    "position": 0,
    "text": "دو تن را بفرمود زورآزمای"
  },
  {
    "poem_id": 1802,
    "vorder": 24,
    "position": 1,
    "text": "به کشتی که دارند با دیو پای"
  },
  {
    "poem_id": 1802,
    "vorder": 25,
    "position": 0,
    "text": "برفتند شایسته مردان کار"
  },
  {
    "poem_id": 1802,
    "vorder": 26,
    "position": 1,
    "text": "ببستندشان بر میانها ازار"
  },
  {
    "poem_id": 1802,
    "vorder": 27,
    "position": 0,
    "text": "همی کرد زور ان برین این بران"
  },
  {
    "poem_id": 1802,
    "vorder": 28,
    "position": 1,
    "text": "گرازان و پیچان دو مرد گران"
  },
  {
    "poem_id": 1802,
    "vorder": 29,
    "position": 0,
    "text": "چو برداشت بهرام جام بلور"
  },
  {
    "poem_id": 1802,
    "vorder": 30,
    "position": 1,
    "text": "به مغزش نبید اندرافگند شور"
  },
  {
    "poem_id": 1802,
    "vorder": 31,
    "position": 0,
    "text": "بشنگل چنین گفت کای شهریار"
  },
  {
    "poem_id": 1802,
    "vorder": 32,
    "position": 1,
    "text": "بفرمای تا من ببندم ازار"
  },
  {
    "poem_id": 1802,
    "vorder": 33,
    "position": 0,
    "text": "چو با زورمندان به کشتی شوم"
  },
  {
    "poem_id": 1802,
    "vorder": 34,
    "position": 1,
    "text": "نه اندر خرابی و مستی شوم"
  },
  {
    "poem_id": 1802,
    "vorder": 35,
    "position": 0,
    "text": "بخندید شنگل بدو گفت خیز"
  },
  {
    "poem_id": 1802,
    "vorder": 36,
    "position": 1,
    "text": "چو زیر آوری خون ایشان بریز"
  },
  {
    "poem_id": 1802,
    "vorder": 37,
    "position": 0,
    "text": "چو بشنید بهرام بر پای خاست"
  },
  {
    "poem_id": 1802,
    "vorder": 38,
    "position": 1,
    "text": "به مردی خم آورد بالای راست"
  },
  {
    "poem_id": 1802,
    "vorder": 39,
    "position": 0,
    "text": "کسی را که بگرفت زیشان میان"
  },
  {
    "poem_id": 1802,
    "vorder": 40,
    "position": 1,
    "text": "چو شیری که یازد به گور ژیان"
  },
  {
    "poem_id": 1802,
    "vorder": 41,
    "position": 0,
    "text": "همی بر زمین زد چنان کاستخوانش"
  },
  {
    "poem_id": 1802,
    "vorder": 42,
    "position": 1,
    "text": "شکست و بپالود رنگ رخانش"
  },
  {
    "poem_id": 1802,
    "vorder": 43,
    "position": 0,
    "text": "بدو مانده بد شنگل اندر شگفت"
  },
  {
    "poem_id": 1802,
    "vorder": 44,
    "position": 1,
    "text": "ازان برز بالا و آن زور و کفت"
  },
  {
    "poem_id": 1802,
    "vorder": 45,
    "position": 0,
    "text": "به هندی همی نام یزدان بخواند"
  },
  {
    "poem_id": 1802,
    "vorder": 46,
    "position": 1,
    "text": "ورا از چهل مرد برتر نشاند"
  },
  {
    "poem_id": 1802,
    "vorder": 47,
    "position": 0,
    "text": "چو گشتند مست از می خوشگوار"
  },
  {
    "poem_id": 1802,
    "vorder": 48,
    "position": 1,
    "text": "برفتند ز ایوان گوهرنگار"
  },
  {
    "poem_id": 1802,
    "vorder": 49,
    "position": 0,
    "text": "چو گردون بپوشید چینی حریر"
  },
  {
    "poem_id": 1802,
    "vorder": 50,
    "position": 1,
    "text": "ز خوردن برآسود برنا و پیر"
  },
  {
    "poem_id": 1802,
    "vorder": 51,
    "position": 0,
    "text": "چو زرین شد آن چادر مشکبوی"
  },
  {
    "poem_id": 1802,
    "vorder": 52,
    "position": 1,
    "text": "فروزنده بر چرخ بنمود روی"
  },
  {
    "poem_id": 1802,
    "vorder": 53,
    "position": 0,
    "text": "شه هندوان باره را برنشست"
  },
  {
    "poem_id": 1802,
    "vorder": 54,
    "position": 1,
    "text": "به میدان خرامید چوگان به دست"
  },
  {
    "poem_id": 1802,
    "vorder": 55,
    "position": 0,
    "text": "ببردند با شاه تیر و کمان"
  },
  {
    "poem_id": 1802,
    "vorder": 56,
    "position": 1,
    "text": "همی تاخت بر آرزو یک زمان"
  },
  {
    "poem_id": 1802,
    "vorder": 57,
    "position": 0,
    "text": "به بهرام فرمود تا بر نشست"
  },
  {
    "poem_id": 1802,
    "vorder": 58,
    "position": 1,
    "text": "کمان کیانی گرفته به دست"
  },
  {
    "poem_id": 1802,
    "vorder": 59,
    "position": 0,
    "text": "به شنگل چنین گفت کای شهریار"
  },
  {
    "poem_id": 1802,
    "vorder": 60,
    "position": 1,
    "text": "چنان دان که هستند با من سوار"
  },
  {
    "poem_id": 1802,
    "vorder": 61,
    "position": 0,
    "text": "همی تیر و چوگان کنند آرزوی"
  },
  {
    "poem_id": 1802,
    "vorder": 62,
    "position": 1,
    "text": "چو فرمان دهد شاه آزاده‌خوی"
  },
  {
    "poem_id": 1802,
    "vorder": 63,
    "position": 0,
    "text": "چنین گفت شنگل که تیر و کمان"
  },
  {
    "poem_id": 1802,
    "vorder": 64,
    "position": 1,
    "text": "ستون سواران بود بی‌گمان"
  },
  {
    "poem_id": 1802,
    "vorder": 65,
    "position": 0,
    "text": "تو با شاخ و یالی بیفراز دست"
  },
  {
    "poem_id": 1802,
    "vorder": 66,
    "position": 1,
    "text": "به زه کن کمان را و بگشای شست"
  },
  {
    "poem_id": 1802,
    "vorder": 67,
    "position": 0,
    "text": "کمان را به زه کرد بهرام گرد"
  },
  {
    "poem_id": 1802,
    "vorder": 68,
    "position": 1,
    "text": "عنان را به اسپ تگاور سپرد"
  },
  {
    "poem_id": 1802,
    "vorder": 69,
    "position": 0,
    "text": "یکی تیر بگرفت و بگشاد شست"
  },
  {
    "poem_id": 1802,
    "vorder": 70,
    "position": 1,
    "text": "نشانه به یک چوبه بر هم شکست"
  },
  {
    "poem_id": 1802,
    "vorder": 71,
    "position": 0,
    "text": "گرفتند یکسر برو آفرین"
  },
  {
    "poem_id": 1802,
    "vorder": 72,
    "position": 1,
    "text": "سواران میدان و مردان کین"
  }
]