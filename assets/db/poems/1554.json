[
  {
    "poem_id": 1554,
    "vorder": 1,
    "position": 0,
    "text": "زنی بود گشتاسپ را هوشمند"
  },
  {
    "poem_id": 1554,
    "vorder": 2,
    "position": 1,
    "text": "خردمند وز بد زبانش به بند"
  },
  {
    "poem_id": 1554,
    "vorder": 3,
    "position": 0,
    "text": "ز آخر چمان باره‌ای برنشست"
  },
  {
    "poem_id": 1554,
    "vorder": 4,
    "position": 1,
    "text": "به کردار ترکان میان را ببست"
  },
  {
    "poem_id": 1554,
    "vorder": 5,
    "position": 0,
    "text": "از ایران ره سیستان برگرفت"
  },
  {
    "poem_id": 1554,
    "vorder": 6,
    "position": 1,
    "text": "ازان کارها مانده اندر شگفت"
  },
  {
    "poem_id": 1554,
    "vorder": 7,
    "position": 0,
    "text": "نخفتی به منزل چو برداشتی"
  },
  {
    "poem_id": 1554,
    "vorder": 8,
    "position": 1,
    "text": "دو روزه به یک روزه بگذاشتی"
  },
  {
    "poem_id": 1554,
    "vorder": 9,
    "position": 0,
    "text": "چنین تا به نزدیک گشتاسپ شد"
  },
  {
    "poem_id": 1554,
    "vorder": 10,
    "position": 1,
    "text": "به آگاهی درد لهراسپ شد"
  },
  {
    "poem_id": 1554,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت چندین چرا ماندی"
  },
  {
    "poem_id": 1554,
    "vorder": 12,
    "position": 1,
    "text": "خود از بخل بامی چرا راندی"
  },
  {
    "poem_id": 1554,
    "vorder": 13,
    "position": 0,
    "text": "سپاهی ز ترکان بیامد به بلخ"
  },
  {
    "poem_id": 1554,
    "vorder": 14,
    "position": 1,
    "text": "که شد مردم بلخ را روز تلخ"
  },
  {
    "poem_id": 1554,
    "vorder": 15,
    "position": 0,
    "text": "همه بلخ پر غارت و کشتن است"
  },
  {
    "poem_id": 1554,
    "vorder": 16,
    "position": 1,
    "text": "از ایدر ترا روی برگشتن است"
  },
  {
    "poem_id": 1554,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت گشتاسپ کین غم چراست"
  },
  {
    "poem_id": 1554,
    "vorder": 18,
    "position": 1,
    "text": "به یک تاختن درد و ماتم چراست"
  },
  {
    "poem_id": 1554,
    "vorder": 19,
    "position": 0,
    "text": "چو من با سپاه اندرآیم ز جای"
  },
  {
    "poem_id": 1554,
    "vorder": 20,
    "position": 1,
    "text": "همه کشور چین ندارند پای"
  },
  {
    "poem_id": 1554,
    "vorder": 21,
    "position": 0,
    "text": "چنین پاسخ آورد کاین خود مگوی"
  },
  {
    "poem_id": 1554,
    "vorder": 22,
    "position": 1,
    "text": "که کای بزرگ آمدستت به روی"
  },
  {
    "poem_id": 1554,
    "vorder": 23,
    "position": 0,
    "text": "شهنشاه لهراسپ را پیش بلخ"
  },
  {
    "poem_id": 1554,
    "vorder": 24,
    "position": 1,
    "text": "بکشتند و شد بلخ را روز تلخ"
  },
  {
    "poem_id": 1554,
    "vorder": 25,
    "position": 0,
    "text": "همان دختران را ببردند اسیر"
  },
  {
    "poem_id": 1554,
    "vorder": 26,
    "position": 1,
    "text": "چنین کار دشوار آسان مگیر"
  },
  {
    "poem_id": 1554,
    "vorder": 27,
    "position": 0,
    "text": "اگر نیستی جز شکست همای"
  },
  {
    "poem_id": 1554,
    "vorder": 28,
    "position": 1,
    "text": "خردمند را دل نرفتی ز جای"
  },
  {
    "poem_id": 1554,
    "vorder": 29,
    "position": 0,
    "text": "وز انجا به نوش آذراندر شدند"
  },
  {
    "poem_id": 1554,
    "vorder": 30,
    "position": 1,
    "text": "رد و هیربد را بهم برزدند"
  },
  {
    "poem_id": 1554,
    "vorder": 31,
    "position": 0,
    "text": "ز خونشان فروزنده آذر بمرد"
  },
  {
    "poem_id": 1554,
    "vorder": 32,
    "position": 1,
    "text": "چنین کار را خوار نتوان شمرد"
  },
  {
    "poem_id": 1554,
    "vorder": 33,
    "position": 0,
    "text": "دگر دختر شاه به آفرید"
  },
  {
    "poem_id": 1554,
    "vorder": 34,
    "position": 1,
    "text": "که باد هوا هرگز او را ندید"
  },
  {
    "poem_id": 1554,
    "vorder": 35,
    "position": 0,
    "text": "به خواری ورا زار برداشتند"
  },
  {
    "poem_id": 1554,
    "vorder": 36,
    "position": 1,
    "text": "برو یاره و تاج نگذاشتند"
  },
  {
    "poem_id": 1554,
    "vorder": 37,
    "position": 0,
    "text": "چو بشنید گشتاسپ شد پر ز درد"
  },
  {
    "poem_id": 1554,
    "vorder": 38,
    "position": 1,
    "text": "ز مژگان ببارید خوناب زرد"
  },
  {
    "poem_id": 1554,
    "vorder": 39,
    "position": 0,
    "text": "بزرگان ایرانیان را بخواند"
  },
  {
    "poem_id": 1554,
    "vorder": 40,
    "position": 1,
    "text": "شنیده سخن پیش ایشان براند"
  },
  {
    "poem_id": 1554,
    "vorder": 41,
    "position": 0,
    "text": "نویسندهٔ نامه را خواند شاه"
  },
  {
    "poem_id": 1554,
    "vorder": 42,
    "position": 1,
    "text": "بینداخت تاج و بپردخت گاه"
  },
  {
    "poem_id": 1554,
    "vorder": 43,
    "position": 0,
    "text": "سواران پراگنده بر هر سوی"
  },
  {
    "poem_id": 1554,
    "vorder": 44,
    "position": 1,
    "text": "فرستاد نامه به هر پهلوی"
  },
  {
    "poem_id": 1554,
    "vorder": 45,
    "position": 0,
    "text": "که یک تن سر از گل مشورید پاک"
  },
  {
    "poem_id": 1554,
    "vorder": 46,
    "position": 1,
    "text": "مدارید باک از بلند و مغاک"
  },
  {
    "poem_id": 1554,
    "vorder": 47,
    "position": 0,
    "text": "ببردند نامه به هر کشوری"
  },
  {
    "poem_id": 1554,
    "vorder": 48,
    "position": 1,
    "text": "کجا بود در پادشاهی سری"
  },
  {
    "poem_id": 1554,
    "vorder": 49,
    "position": 0,
    "text": "چو آگاه گشتند یکسر سپاه"
  },
  {
    "poem_id": 1554,
    "vorder": 50,
    "position": 1,
    "text": "برفتند با گرز و رومی کلاه"
  },
  {
    "poem_id": 1554,
    "vorder": 51,
    "position": 0,
    "text": "همه یکسره پیش شاه آمدند"
  },
  {
    "poem_id": 1554,
    "vorder": 52,
    "position": 1,
    "text": "بران نامور بارگاه آمدند"
  },
  {
    "poem_id": 1554,
    "vorder": 53,
    "position": 0,
    "text": "چو گشتاسپ دید آن سپه بر درش"
  },
  {
    "poem_id": 1554,
    "vorder": 54,
    "position": 1,
    "text": "سواران جنگاور از کشورش"
  },
  {
    "poem_id": 1554,
    "vorder": 55,
    "position": 0,
    "text": "درم داد وز سیستان برگرفت"
  },
  {
    "poem_id": 1554,
    "vorder": 56,
    "position": 1,
    "text": "سوی بلخ بامی ره اندر گرفت"
  },
  {
    "poem_id": 1554,
    "vorder": 57,
    "position": 0,
    "text": "چو بشنید ارجاسپ کامد سپاه"
  },
  {
    "poem_id": 1554,
    "vorder": 58,
    "position": 1,
    "text": "جهاندار گشتاسپ با تاج و گاه"
  },
  {
    "poem_id": 1554,
    "vorder": 59,
    "position": 0,
    "text": "ز دریا به دریا سپه گسترید"
  },
  {
    "poem_id": 1554,
    "vorder": 60,
    "position": 1,
    "text": "که جایی کسی روی هامون ندید"
  },
  {
    "poem_id": 1554,
    "vorder": 61,
    "position": 0,
    "text": "دو لشکر چو تنگ اندر آمد به گرد"
  },
  {
    "poem_id": 1554,
    "vorder": 62,
    "position": 1,
    "text": "زمین شد سیاه و هوا لاژورد"
  },
  {
    "poem_id": 1554,
    "vorder": 63,
    "position": 0,
    "text": "چو هر دو سپه برکشیدند صف"
  },
  {
    "poem_id": 1554,
    "vorder": 64,
    "position": 1,
    "text": "همه نیزه و تیغ و ژوپین به کف"
  },
  {
    "poem_id": 1554,
    "vorder": 65,
    "position": 0,
    "text": "ابر میمنه شاه فرشیدورد"
  },
  {
    "poem_id": 1554,
    "vorder": 66,
    "position": 1,
    "text": "که با شیر درنده جستی نبرد"
  },
  {
    "poem_id": 1554,
    "vorder": 67,
    "position": 0,
    "text": "ابر میسره گرد بستور بود"
  },
  {
    "poem_id": 1554,
    "vorder": 68,
    "position": 1,
    "text": "که شاه و گه رزم چون کوه بود"
  },
  {
    "poem_id": 1554,
    "vorder": 69,
    "position": 0,
    "text": "جهاندار گشتاسپ در قلبگاه"
  },
  {
    "poem_id": 1554,
    "vorder": 70,
    "position": 1,
    "text": "همی کرد هر سو به لشکر نگاه"
  },
  {
    "poem_id": 1554,
    "vorder": 71,
    "position": 0,
    "text": "وزان روی کندر ابر میمنه"
  },
  {
    "poem_id": 1554,
    "vorder": 72,
    "position": 1,
    "text": "بیامد پس پشت او با بنه"
  },
  {
    "poem_id": 1554,
    "vorder": 73,
    "position": 0,
    "text": "سوی میسره کهرم تیغ‌زن"
  },
  {
    "poem_id": 1554,
    "vorder": 74,
    "position": 1,
    "text": "به قلب اندر ارجاسپ با انجمن"
  },
  {
    "poem_id": 1554,
    "vorder": 75,
    "position": 0,
    "text": "برآمد ز هر دو سپه بانگ کوس"
  },
  {
    "poem_id": 1554,
    "vorder": 76,
    "position": 1,
    "text": "زمین آهنین شد هوا آبنوس"
  },
  {
    "poem_id": 1554,
    "vorder": 77,
    "position": 0,
    "text": "تو گفتی که گردون بپرد همی"
  },
  {
    "poem_id": 1554,
    "vorder": 78,
    "position": 1,
    "text": "زمین از گرانی بدرد همی"
  },
  {
    "poem_id": 1554,
    "vorder": 79,
    "position": 0,
    "text": "ز آواز اسپان و زخم تبر"
  },
  {
    "poem_id": 1554,
    "vorder": 80,
    "position": 1,
    "text": "همی کوه خارا برآورد پر"
  },
  {
    "poem_id": 1554,
    "vorder": 81,
    "position": 0,
    "text": "همه دشت سر بود بی‌تن به خاک"
  },
  {
    "poem_id": 1554,
    "vorder": 82,
    "position": 1,
    "text": "سر گرزداران همه چاک‌چاک"
  },
  {
    "poem_id": 1554,
    "vorder": 83,
    "position": 0,
    "text": "درفشیدن تیغ و باران تیر"
  },
  {
    "poem_id": 1554,
    "vorder": 84,
    "position": 1,
    "text": "خروش یلان بود با دار و گیر"
  },
  {
    "poem_id": 1554,
    "vorder": 85,
    "position": 0,
    "text": "ستاره همی جست راه گریغ"
  },
  {
    "poem_id": 1554,
    "vorder": 86,
    "position": 1,
    "text": "سپه را همی نامدی جان دریغ"
  },
  {
    "poem_id": 1554,
    "vorder": 87,
    "position": 0,
    "text": "سر نیزه و گرز خم داده بود"
  },
  {
    "poem_id": 1554,
    "vorder": 88,
    "position": 1,
    "text": "همه دشت پر کشته افتاده بود"
  },
  {
    "poem_id": 1554,
    "vorder": 89,
    "position": 0,
    "text": "بسی کوفته زیر باره درون"
  },
  {
    "poem_id": 1554,
    "vorder": 90,
    "position": 1,
    "text": "کفن سینهٔ شیر و تابوت خون"
  },
  {
    "poem_id": 1554,
    "vorder": 91,
    "position": 0,
    "text": "تن بی‌سران و سر بی‌تنان"
  },
  {
    "poem_id": 1554,
    "vorder": 92,
    "position": 1,
    "text": "سواران چو پیلان کفک افگنان"
  },
  {
    "poem_id": 1554,
    "vorder": 93,
    "position": 0,
    "text": "پدر را نبد بر پسر جای مهر"
  },
  {
    "poem_id": 1554,
    "vorder": 94,
    "position": 1,
    "text": "همی گشت زین گونه گردان سپهر"
  },
  {
    "poem_id": 1554,
    "vorder": 95,
    "position": 0,
    "text": "چو بگذشت زین سان سه روز و سه شب"
  },
  {
    "poem_id": 1554,
    "vorder": 96,
    "position": 1,
    "text": "ز بس بانگ اسپان و جنگ و جلب"
  },
  {
    "poem_id": 1554,
    "vorder": 97,
    "position": 0,
    "text": "سراسر چنان گشت آوردگاه"
  },
  {
    "poem_id": 1554,
    "vorder": 98,
    "position": 1,
    "text": "که از جوش خون لعل شد روی ماه"
  },
  {
    "poem_id": 1554,
    "vorder": 99,
    "position": 0,
    "text": "ابا کهرم تیغ‌زن در نبرد"
  },
  {
    "poem_id": 1554,
    "vorder": 100,
    "position": 1,
    "text": "برآویخت ناگاه فرشیدورد"
  },
  {
    "poem_id": 1554,
    "vorder": 101,
    "position": 0,
    "text": "ز کهرم مران شاه تن خسته شد"
  },
  {
    "poem_id": 1554,
    "vorder": 102,
    "position": 1,
    "text": "به جان گرچه از دست او رسته شد"
  },
  {
    "poem_id": 1554,
    "vorder": 103,
    "position": 0,
    "text": "از ایران سواران پرخاشجوی"
  },
  {
    "poem_id": 1554,
    "vorder": 104,
    "position": 1,
    "text": "چنان خسته بردند از پیش اوی"
  },
  {
    "poem_id": 1554,
    "vorder": 105,
    "position": 0,
    "text": "فراوان ز ایرانیان کشته شد"
  },
  {
    "poem_id": 1554,
    "vorder": 106,
    "position": 1,
    "text": "ز خون یلان کشور آغشته شد"
  },
  {
    "poem_id": 1554,
    "vorder": 107,
    "position": 0,
    "text": "پسر بود گشتاسپ را سی و هشت"
  },
  {
    "poem_id": 1554,
    "vorder": 108,
    "position": 1,
    "text": "دلیران کوه و سواران دشت"
  },
  {
    "poem_id": 1554,
    "vorder": 109,
    "position": 0,
    "text": "بکشتند یکسر بران رزمگاه"
  },
  {
    "poem_id": 1554,
    "vorder": 110,
    "position": 1,
    "text": "به یکبارگی تیره شد بخت شاه"
  }
]