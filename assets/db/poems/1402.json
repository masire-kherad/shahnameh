[
  {
    "poem_id": 1402,
    "vorder": 1,
    "position": 0,
    "text": "بسی برنیامد برین روزگار"
  },
  {
    "poem_id": 1402,
    "vorder": 2,
    "position": 1,
    "text": "که آزاده سرو اندر آمد به بار"
  },
  {
    "poem_id": 1402,
    "vorder": 3,
    "position": 0,
    "text": "بهار دل افروز پژمرده شد"
  },
  {
    "poem_id": 1402,
    "vorder": 4,
    "position": 1,
    "text": "دلش را غم و رنج بسپرده شد"
  },
  {
    "poem_id": 1402,
    "vorder": 5,
    "position": 0,
    "text": "شکم گشت فربه و تن شد گران"
  },
  {
    "poem_id": 1402,
    "vorder": 6,
    "position": 1,
    "text": "شد آن ارغوانی رخش زعفران"
  },
  {
    "poem_id": 1402,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت مادر که ای جان مام"
  },
  {
    "poem_id": 1402,
    "vorder": 8,
    "position": 1,
    "text": "چه بودت که گشتی چنین زرد فام"
  },
  {
    "poem_id": 1402,
    "vorder": 9,
    "position": 0,
    "text": "چنین داد پاسخ که من روز و شب"
  },
  {
    "poem_id": 1402,
    "vorder": 10,
    "position": 1,
    "text": "همی برگشایم به فریاد لب"
  },
  {
    "poem_id": 1402,
    "vorder": 11,
    "position": 0,
    "text": "همانا زمان آمدستم فراز"
  },
  {
    "poem_id": 1402,
    "vorder": 12,
    "position": 1,
    "text": "وزین بار بردن نیابم جواز"
  },
  {
    "poem_id": 1402,
    "vorder": 13,
    "position": 0,
    "text": "تو گویی به سنگستم آگنده پوست"
  },
  {
    "poem_id": 1402,
    "vorder": 14,
    "position": 1,
    "text": "و گر آهنست آنکه نیز اندروست"
  },
  {
    "poem_id": 1402,
    "vorder": 15,
    "position": 0,
    "text": "چنین تا گه زادن آمد فراز"
  },
  {
    "poem_id": 1402,
    "vorder": 16,
    "position": 1,
    "text": "به خواب و به آرام بودش نیاز"
  },
  {
    "poem_id": 1402,
    "vorder": 17,
    "position": 0,
    "text": "چنان بد که یک روز ازو رفت هوش"
  },
  {
    "poem_id": 1402,
    "vorder": 18,
    "position": 1,
    "text": "از ایوان دستان برآمد خروش"
  },
  {
    "poem_id": 1402,
    "vorder": 19,
    "position": 0,
    "text": "خروشید سیندخت و بشخود روی"
  },
  {
    "poem_id": 1402,
    "vorder": 20,
    "position": 1,
    "text": "بکند آن سیه گیسوی مشک بوی"
  },
  {
    "poem_id": 1402,
    "vorder": 21,
    "position": 0,
    "text": "یکایک بدستان رسید آگهی"
  },
  {
    "poem_id": 1402,
    "vorder": 22,
    "position": 1,
    "text": "که پژمرده شد برگ سرو سهی"
  },
  {
    "poem_id": 1402,
    "vorder": 23,
    "position": 0,
    "text": "به بالین رودابه شد زال زر"
  },
  {
    "poem_id": 1402,
    "vorder": 24,
    "position": 1,
    "text": "پر از آب رخسار و خسته جگر"
  },
  {
    "poem_id": 1402,
    "vorder": 25,
    "position": 0,
    "text": "همان پر سیمرغش آمد به یاد"
  },
  {
    "poem_id": 1402,
    "vorder": 26,
    "position": 1,
    "text": "بخندید و سیندخت را مژده داد"
  },
  {
    "poem_id": 1402,
    "vorder": 27,
    "position": 0,
    "text": "یکی مجمر آورد و آتش فروخت"
  },
  {
    "poem_id": 1402,
    "vorder": 28,
    "position": 1,
    "text": "وزآن پر سیمرغ لختی بسوخت"
  },
  {
    "poem_id": 1402,
    "vorder": 29,
    "position": 0,
    "text": "هم اندر زمان تیره گون شد هوا"
  },
  {
    "poem_id": 1402,
    "vorder": 30,
    "position": 1,
    "text": "پدید آمد آن مرغ فرمان روا"
  },
  {
    "poem_id": 1402,
    "vorder": 31,
    "position": 0,
    "text": "چو ابری که بارانش مرجان بود"
  },
  {
    "poem_id": 1402,
    "vorder": 32,
    "position": 1,
    "text": "چه مرجان که آرایش جان بود"
  },
  {
    "poem_id": 1402,
    "vorder": 33,
    "position": 0,
    "text": "برو کرد زال آفرین دراز"
  },
  {
    "poem_id": 1402,
    "vorder": 34,
    "position": 1,
    "text": "ستودش فراوان و بردش نماز"
  },
  {
    "poem_id": 1402,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت با زال کین غم چراست"
  },
  {
    "poem_id": 1402,
    "vorder": 36,
    "position": 1,
    "text": "به چشم هژبر اندرون نم چراست"
  },
  {
    "poem_id": 1402,
    "vorder": 37,
    "position": 0,
    "text": "کزین سرو سیمین بر ماه‌روی"
  },
  {
    "poem_id": 1402,
    "vorder": 38,
    "position": 1,
    "text": "یکی نره شیر آید و نامجوی"
  },
  {
    "poem_id": 1402,
    "vorder": 39,
    "position": 0,
    "text": "که خاک پی او ببوسد هژبر"
  },
  {
    "poem_id": 1402,
    "vorder": 40,
    "position": 1,
    "text": "نیارد گذشتن به سر برش ابر"
  },
  {
    "poem_id": 1402,
    "vorder": 41,
    "position": 0,
    "text": "از آواز او چرم جنگی پلنگ"
  },
  {
    "poem_id": 1402,
    "vorder": 42,
    "position": 1,
    "text": "شود چاک چاک و بخاید دو چنگ"
  },
  {
    "poem_id": 1402,
    "vorder": 43,
    "position": 0,
    "text": "هران گرد کاواز کوپال اوی"
  },
  {
    "poem_id": 1402,
    "vorder": 44,
    "position": 1,
    "text": "ببیند بر و بازوی و یال اوی"
  },
  {
    "poem_id": 1402,
    "vorder": 45,
    "position": 0,
    "text": "ز آواز او اندر آید ز پای"
  },
  {
    "poem_id": 1402,
    "vorder": 46,
    "position": 1,
    "text": "دل مرد جنگی برآید ز جای"
  },
  {
    "poem_id": 1402,
    "vorder": 47,
    "position": 0,
    "text": "به جای خرد سام سنگی بود"
  },
  {
    "poem_id": 1402,
    "vorder": 48,
    "position": 1,
    "text": "به خشم اندرون شیر جنگی بود"
  },
  {
    "poem_id": 1402,
    "vorder": 49,
    "position": 0,
    "text": "به بالای سرو و به نیروی پیل"
  },
  {
    "poem_id": 1402,
    "vorder": 50,
    "position": 1,
    "text": "به آورد خشت افگند بر دو میل"
  },
  {
    "poem_id": 1402,
    "vorder": 51,
    "position": 0,
    "text": "نیاید به گیتی ز راه زهش"
  },
  {
    "poem_id": 1402,
    "vorder": 52,
    "position": 1,
    "text": "به فرمان دادار نیکی دهش"
  },
  {
    "poem_id": 1402,
    "vorder": 53,
    "position": 0,
    "text": "بیاور یکی خنجر آبگون"
  },
  {
    "poem_id": 1402,
    "vorder": 54,
    "position": 1,
    "text": "یکی مرد بینادل پرفسون"
  },
  {
    "poem_id": 1402,
    "vorder": 55,
    "position": 0,
    "text": "نخستین به می ماه را مست کن"
  },
  {
    "poem_id": 1402,
    "vorder": 56,
    "position": 1,
    "text": "ز دل بیم و اندیشه را پست کن"
  },
  {
    "poem_id": 1402,
    "vorder": 57,
    "position": 0,
    "text": "بکافد تهیگاه سرو سهی"
  },
  {
    "poem_id": 1402,
    "vorder": 58,
    "position": 1,
    "text": "نباشد مر او را ز درد آگهی"
  },
  {
    "poem_id": 1402,
    "vorder": 59,
    "position": 0,
    "text": "وزو بچهٔ شیر بیرون کشد"
  },
  {
    "poem_id": 1402,
    "vorder": 60,
    "position": 1,
    "text": "همه پهلوی ماه در خون کشد"
  },
  {
    "poem_id": 1402,
    "vorder": 61,
    "position": 0,
    "text": "وز آن پس بدوز آن کجا کرد چاک"
  },
  {
    "poem_id": 1402,
    "vorder": 62,
    "position": 1,
    "text": "ز دل دور کن ترس و تیمار و باک"
  },
  {
    "poem_id": 1402,
    "vorder": 63,
    "position": 0,
    "text": "گیاهی که گویمت با شیر و مشک"
  },
  {
    "poem_id": 1402,
    "vorder": 64,
    "position": 1,
    "text": "بکوب و بکن هر سه در سایه خشک"
  },
  {
    "poem_id": 1402,
    "vorder": 65,
    "position": 0,
    "text": "بساو و برآلای بر خستگیش"
  },
  {
    "poem_id": 1402,
    "vorder": 66,
    "position": 1,
    "text": "ببینی همان روز پیوستگیش"
  },
  {
    "poem_id": 1402,
    "vorder": 67,
    "position": 0,
    "text": "بدو مال ازان پس یکی پر من"
  },
  {
    "poem_id": 1402,
    "vorder": 68,
    "position": 1,
    "text": "خجسته بود سایهٔ فر من"
  },
  {
    "poem_id": 1402,
    "vorder": 69,
    "position": 0,
    "text": "ترا زین سخن شاد باید بدن"
  },
  {
    "poem_id": 1402,
    "vorder": 70,
    "position": 1,
    "text": "به پیش جهاندار باید شدن"
  },
  {
    "poem_id": 1402,
    "vorder": 71,
    "position": 0,
    "text": "که او دادت این خسروانی درخت"
  },
  {
    "poem_id": 1402,
    "vorder": 72,
    "position": 1,
    "text": "که هر روز نو بشکفاندش بخت"
  },
  {
    "poem_id": 1402,
    "vorder": 73,
    "position": 0,
    "text": "بدین کار دل هیچ غمگین مدار"
  },
  {
    "poem_id": 1402,
    "vorder": 74,
    "position": 1,
    "text": "که شاخ برومندت آمد به بار"
  },
  {
    "poem_id": 1402,
    "vorder": 75,
    "position": 0,
    "text": "بگفت و یکی پر ز بازو بکند"
  },
  {
    "poem_id": 1402,
    "vorder": 76,
    "position": 1,
    "text": "فگند و به پرواز بر شد بلند"
  },
  {
    "poem_id": 1402,
    "vorder": 77,
    "position": 0,
    "text": "بشد زال و آن پر او برگرفت"
  },
  {
    "poem_id": 1402,
    "vorder": 78,
    "position": 1,
    "text": "برفت و بکرد آنچه گفت ای شگفت"
  },
  {
    "poem_id": 1402,
    "vorder": 79,
    "position": 0,
    "text": "بدان کار نظاره شد یک جهان"
  },
  {
    "poem_id": 1402,
    "vorder": 80,
    "position": 1,
    "text": "همه دیده پر خون و خسته روان"
  },
  {
    "poem_id": 1402,
    "vorder": 81,
    "position": 0,
    "text": "فرو ریخت از مژه سیندخت خون"
  },
  {
    "poem_id": 1402,
    "vorder": 82,
    "position": 1,
    "text": "که کودک ز پهلو کی آید برون"
  }
]