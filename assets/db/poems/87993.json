[
  {
    "poem_id": 87993,
    "vorder": 1,
    "position": 0,
    "text": "دلیری کجا نام او اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 2,
    "position": 1,
    "text": "همی بر خروشید بر سانِ کوس"
  },
  {
    "poem_id": 87993,
    "vorder": 3,
    "position": 0,
    "text": "بیامد که جوید ز ایران نبرد"
  },
  {
    "poem_id": 87993,
    "vorder": 4,
    "position": 1,
    "text": "سرِ هم‌نبرد اندر آرد به گَرد"
  },
  {
    "poem_id": 87993,
    "vorder": 5,
    "position": 0,
    "text": "بشد تیز رُهّام با خُود و گبر"
  },
  {
    "poem_id": 87993,
    "vorder": 6,
    "position": 1,
    "text": "همی گَرد رزم اندر آمد به ابر"
  },
  {
    "poem_id": 87993,
    "vorder": 7,
    "position": 0,
    "text": "برآویخت رُهّام با اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 8,
    "position": 1,
    "text": "برآمد ز هر دو سپه بوق و کوس"
  },
  {
    "poem_id": 87993,
    "vorder": 9,
    "position": 0,
    "text": "بر آن نامور تیرباران گرفت"
  },
  {
    "poem_id": 87993,
    "vorder": 10,
    "position": 1,
    "text": "کمانش کمینِ سواران گرفت"
  },
  {
    "poem_id": 87993,
    "vorder": 11,
    "position": 0,
    "text": "جهان‌جویْ در زیر پولاد بود"
  },
  {
    "poem_id": 87993,
    "vorder": 12,
    "position": 1,
    "text": "به خِفتانْشْ بر تیر، چون باد بود"
  },
  {
    "poem_id": 87993,
    "vorder": 13,
    "position": 0,
    "text": "نبد کارگر تیر بر گبر اوی"
  },
  {
    "poem_id": 87993,
    "vorder": 14,
    "position": 1,
    "text": "از آن تیزتر شد دل جنگجوی"
  },
  {
    "poem_id": 87993,
    "vorder": 15,
    "position": 0,
    "text": "به گرز گران دست برد اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 16,
    "position": 1,
    "text": "زمین آهنین شد، سپهر آبنوس"
  },
  {
    "poem_id": 87993,
    "vorder": 17,
    "position": 0,
    "text": "برآهیخت رُهّام، گرز گران"
  },
  {
    "poem_id": 87993,
    "vorder": 18,
    "position": 1,
    "text": "غمی شد ز پیکار دست سران"
  },
  {
    "poem_id": 87993,
    "vorder": 19,
    "position": 0,
    "text": "چو رُهّام گشت از کَشانی ستوه"
  },
  {
    "poem_id": 87993,
    "vorder": 20,
    "position": 1,
    "text": "بپیچید زو روی و شد سوی کوه"
  },
  {
    "poem_id": 87993,
    "vorder": 21,
    "position": 0,
    "text": "ز قلب سپاه اندر آشفت طوس"
  },
  {
    "poem_id": 87993,
    "vorder": 22,
    "position": 1,
    "text": "بزد اسپ کاید برِ اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 23,
    "position": 0,
    "text": "تهمتن برآشفت و با طوس گفت"
  },
  {
    "poem_id": 87993,
    "vorder": 24,
    "position": 1,
    "text": "که رُهّام را جامِ باده‌ست جفت"
  },
  {
    "poem_id": 87993,
    "vorder": 25,
    "position": 0,
    "text": "به می در همی تیغ‌بازی کند"
  },
  {
    "poem_id": 87993,
    "vorder": 26,
    "position": 1,
    "text": "میان یَلان سرفرازی کند"
  },
  {
    "poem_id": 87993,
    "vorder": 27,
    "position": 0,
    "text": "چرا شد کنون رویْ چون سَندَروس؟"
  },
  {
    "poem_id": 87993,
    "vorder": 28,
    "position": 1,
    "text": "سواری بود کمتر از اشکبوس؟"
  },
  {
    "poem_id": 87993,
    "vorder": 29,
    "position": 0,
    "text": "تو قلب سپه را به‌آیین بدار"
  },
  {
    "poem_id": 87993,
    "vorder": 30,
    "position": 1,
    "text": "من اکنون پیاده کنم کارزار"
  },
  {
    "poem_id": 87993,
    "vorder": 31,
    "position": 0,
    "text": "کمانِ به زِه را به بازو فگند"
  },
  {
    "poem_id": 87993,
    "vorder": 32,
    "position": 1,
    "text": "به بندِ کمر بر بزد تیرْ چند"
  },
  {
    "poem_id": 87993,
    "vorder": 33,
    "position": 0,
    "text": "خروشید کای مرد رزم آزمای"
  },
  {
    "poem_id": 87993,
    "vorder": 34,
    "position": 1,
    "text": "هم آوردت آمد مشو بازْ جای"
  },
  {
    "poem_id": 87993,
    "vorder": 35,
    "position": 0,
    "text": "کَشانی بخندید و خیره بماند"
  },
  {
    "poem_id": 87993,
    "vorder": 36,
    "position": 1,
    "text": "عنان را گران کرد و او را بخواند"
  },
  {
    "poem_id": 87993,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت خندان که نام تو چیست؟"
  },
  {
    "poem_id": 87993,
    "vorder": 38,
    "position": 1,
    "text": "تن بی‌سرت را که خواهد گریست؟"
  },
  {
    "poem_id": 87993,
    "vorder": 39,
    "position": 0,
    "text": "تهمتن چنین داد پاسخ که نام"
  },
  {
    "poem_id": 87993,
    "vorder": 40,
    "position": 1,
    "text": "چه پرسی؟ کزین پس نبینی تو کام"
  },
  {
    "poem_id": 87993,
    "vorder": 41,
    "position": 0,
    "text": "مرا مادرم نامْ مرگ تو کرد"
  },
  {
    "poem_id": 87993,
    "vorder": 42,
    "position": 1,
    "text": "زمانه مرا پتکِ ترگِ تو کرد"
  },
  {
    "poem_id": 87993,
    "vorder": 43,
    "position": 0,
    "text": "کَشانی بدو گفت بی‌بارگی"
  },
  {
    "poem_id": 87993,
    "vorder": 44,
    "position": 1,
    "text": "به کشتن دهی سر به یک‌بارگی"
  },
  {
    "poem_id": 87993,
    "vorder": 45,
    "position": 0,
    "text": "تهمتن چنین داد پاسخ بدوی"
  },
  {
    "poem_id": 87993,
    "vorder": 46,
    "position": 1,
    "text": "که ای بیهده مردِ پرخاشجوی"
  },
  {
    "poem_id": 87993,
    "vorder": 47,
    "position": 0,
    "text": "پیاده ندیدی که جنگ آورد؟"
  },
  {
    "poem_id": 87993,
    "vorder": 48,
    "position": 1,
    "text": "سر سرکشان زیر سنگ آورد؟"
  },
  {
    "poem_id": 87993,
    "vorder": 49,
    "position": 0,
    "text": "به شهر تو شیر و نهنگ و پلنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 50,
    "position": 1,
    "text": "سوار اندر آیند هر سه به جنگ؟"
  },
  {
    "poem_id": 87993,
    "vorder": 51,
    "position": 0,
    "text": "هم اکنون ترا ای نَبَرده سوار"
  },
  {
    "poem_id": 87993,
    "vorder": 52,
    "position": 1,
    "text": "پیاده بیاموزمت کارزار"
  },
  {
    "poem_id": 87993,
    "vorder": 53,
    "position": 0,
    "text": "پیاده مرا زان فرستاد طوس"
  },
  {
    "poem_id": 87993,
    "vorder": 54,
    "position": 1,
    "text": "که تا اسپ بستانم از اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 55,
    "position": 0,
    "text": "کَشانی پیاده شود همچو من"
  },
  {
    "poem_id": 87993,
    "vorder": 56,
    "position": 1,
    "text": "ز دو روی خندان شوند انجمن"
  },
  {
    "poem_id": 87993,
    "vorder": 57,
    "position": 0,
    "text": "پیاده به از چون تو پانصد سوار"
  },
  {
    "poem_id": 87993,
    "vorder": 58,
    "position": 1,
    "text": "بدین روز و این گردش کارزار"
  },
  {
    "poem_id": 87993,
    "vorder": 59,
    "position": 0,
    "text": "کَشانی بدو گفت با تو سَلیح"
  },
  {
    "poem_id": 87993,
    "vorder": 60,
    "position": 1,
    "text": "نبینم همی جز فُسوس و مَزیح"
  },
  {
    "poem_id": 87993,
    "vorder": 61,
    "position": 0,
    "text": "بدو گفت رستم که تیر و کمان"
  },
  {
    "poem_id": 87993,
    "vorder": 62,
    "position": 1,
    "text": "ببین تا هم اکنون سرآری زمان"
  },
  {
    "poem_id": 87993,
    "vorder": 63,
    "position": 0,
    "text": "چو نازش به اسپ گرانمایه دید"
  },
  {
    "poem_id": 87993,
    "vorder": 64,
    "position": 1,
    "text": "کمان را به زه کرد و اندر کشید"
  },
  {
    "poem_id": 87993,
    "vorder": 65,
    "position": 0,
    "text": "یکی تیر زد بَر بَرِ اسپ اوی"
  },
  {
    "poem_id": 87993,
    "vorder": 66,
    "position": 1,
    "text": "که اسپ اندر آمد ز بالا به روی"
  },
  {
    "poem_id": 87993,
    "vorder": 67,
    "position": 0,
    "text": "بخندید رستم به آواز گفت"
  },
  {
    "poem_id": 87993,
    "vorder": 68,
    "position": 1,
    "text": "که بنشین به پیش گرانمایه جفت"
  },
  {
    "poem_id": 87993,
    "vorder": 69,
    "position": 0,
    "text": "سزد گر بداری سرش در کنار"
  },
  {
    "poem_id": 87993,
    "vorder": 70,
    "position": 1,
    "text": "زمانی برآسایی از کارزار"
  },
  {
    "poem_id": 87993,
    "vorder": 71,
    "position": 0,
    "text": "کمان را به زه کرد زود اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 72,
    "position": 1,
    "text": "تنی لرز لرزان و رخ سَندَروس"
  },
  {
    "poem_id": 87993,
    "vorder": 73,
    "position": 0,
    "text": "به رستم بر آنگه ببارید تیر"
  },
  {
    "poem_id": 87993,
    "vorder": 74,
    "position": 1,
    "text": "تهمتن بدو گفت برخیره خیر"
  },
  {
    "poem_id": 87993,
    "vorder": 75,
    "position": 0,
    "text": "همی رنجه داری تن خویش را"
  },
  {
    "poem_id": 87993,
    "vorder": 76,
    "position": 1,
    "text": "دو بازوی و جان بداندیش را"
  },
  {
    "poem_id": 87993,
    "vorder": 77,
    "position": 0,
    "text": "تهمتن به بند کمر برد چنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 78,
    "position": 1,
    "text": "گزین کرد یک چوبه تیرِ خَدنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 79,
    "position": 0,
    "text": "یکی تیرِ الماس، پیکان چو آب"
  },
  {
    "poem_id": 87993,
    "vorder": 80,
    "position": 1,
    "text": "نهاده بَر او چار پرّ عقاب"
  },
  {
    "poem_id": 87993,
    "vorder": 81,
    "position": 0,
    "text": "کمان را بمالید رستم به چنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 82,
    "position": 1,
    "text": "به شست اندر آورد تیر خَدَنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 83,
    "position": 0,
    "text": "برو راستْ خم کرد و چپ کرد راست"
  },
  {
    "poem_id": 87993,
    "vorder": 84,
    "position": 1,
    "text": "خروش از خَم چرخِ چاچی بخاست"
  },
  {
    "poem_id": 87993,
    "vorder": 85,
    "position": 0,
    "text": "چو سوفارَش آمد به پهنای گوش"
  },
  {
    "poem_id": 87993,
    "vorder": 86,
    "position": 1,
    "text": "ز شاخ گوزنان برآمد خروش"
  },
  {
    "poem_id": 87993,
    "vorder": 87,
    "position": 0,
    "text": "چو بوسید پیکانْ سرانگشتِ اوی"
  },
  {
    "poem_id": 87993,
    "vorder": 88,
    "position": 1,
    "text": "گذر کرد بر مهرهٔ پشت اوی"
  },
  {
    "poem_id": 87993,
    "vorder": 89,
    "position": 0,
    "text": "بزد بَر بَر و سینهٔ اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 90,
    "position": 1,
    "text": "سپهر آن زمان دست او داد بوس"
  },
  {
    "poem_id": 87993,
    "vorder": 91,
    "position": 0,
    "text": "قضا گفت گیر و قَدَر گفت ده"
  },
  {
    "poem_id": 87993,
    "vorder": 92,
    "position": 1,
    "text": "فلک گفت احسنت و مَه گفت زِه"
  },
  {
    "poem_id": 87993,
    "vorder": 93,
    "position": 0,
    "text": "کَشانی هم اندر زمان جان بداد"
  },
  {
    "poem_id": 87993,
    "vorder": 94,
    "position": 1,
    "text": "چنان شد که گفتی ز مادر نزاد"
  },
  {
    "poem_id": 87993,
    "vorder": 95,
    "position": 0,
    "text": "نظاره بر ایشان دو رویه سپاه"
  },
  {
    "poem_id": 87993,
    "vorder": 96,
    "position": 1,
    "text": "که دارند پیکارِ گُردان نگاه"
  },
  {
    "poem_id": 87993,
    "vorder": 97,
    "position": 0,
    "text": "نگه کرد کاموس و خاقان چین"
  },
  {
    "poem_id": 87993,
    "vorder": 98,
    "position": 1,
    "text": "بر آن بَرز و بالا و آن زور و کین"
  },
  {
    "poem_id": 87993,
    "vorder": 99,
    "position": 0,
    "text": "چو برگشت رستم هم اندر زمان"
  },
  {
    "poem_id": 87993,
    "vorder": 100,
    "position": 1,
    "text": "سواری فرستاد خاقان، دَمان"
  },
  {
    "poem_id": 87993,
    "vorder": 101,
    "position": 0,
    "text": "کزان ناموَر تیر بیرون کشید"
  },
  {
    "poem_id": 87993,
    "vorder": 102,
    "position": 1,
    "text": "همه تیر تا پَر، پُر از خون کشید"
  },
  {
    "poem_id": 87993,
    "vorder": 103,
    "position": 0,
    "text": "همه لشکر آن تیر برداشتند"
  },
  {
    "poem_id": 87993,
    "vorder": 104,
    "position": 1,
    "text": "سراسر همه نیزه پنداشتند"
  },
  {
    "poem_id": 87993,
    "vorder": 105,
    "position": 0,
    "text": "چو خاقان بدان پَرّ و پیکانِ تیر"
  },
  {
    "poem_id": 87993,
    "vorder": 106,
    "position": 1,
    "text": "نگه کرد بُرنا‌ دلش گشت پیر"
  },
  {
    "poem_id": 87993,
    "vorder": 107,
    "position": 0,
    "text": "به پیران چنین گفت کین مرد کیست؟"
  },
  {
    "poem_id": 87993,
    "vorder": 108,
    "position": 1,
    "text": "ز گُردان ایران ورا نام چیست؟"
  },
  {
    "poem_id": 87993,
    "vorder": 109,
    "position": 0,
    "text": "تو گفتی که لختی فرومایه‌اند"
  },
  {
    "poem_id": 87993,
    "vorder": 110,
    "position": 1,
    "text": "ز گردنکشان، کمترین پایه‌اند"
  },
  {
    "poem_id": 87993,
    "vorder": 111,
    "position": 0,
    "text": "کنون نیزه با تیر ایشان یکیست"
  },
  {
    "poem_id": 87993,
    "vorder": 112,
    "position": 1,
    "text": "دل شیر در جنگشان اندکیست"
  },
  {
    "poem_id": 87993,
    "vorder": 113,
    "position": 0,
    "text": "همی خوار کردی سراسر سُخُن"
  },
  {
    "poem_id": 87993,
    "vorder": 114,
    "position": 1,
    "text": "جز آن بُد که گفتی ز سر تا به بُن"
  },
  {
    "poem_id": 87993,
    "vorder": 115,
    "position": 0,
    "text": "بدو گفت پیران کز ایران سپاه"
  },
  {
    "poem_id": 87993,
    "vorder": 116,
    "position": 1,
    "text": "ندانم کسی را بدین پایگاه"
  },
  {
    "poem_id": 87993,
    "vorder": 117,
    "position": 0,
    "text": "کجا تیر او بگذرد بر درخت"
  },
  {
    "poem_id": 87993,
    "vorder": 118,
    "position": 1,
    "text": "ندانم چه دارد به دلْ شوربخت"
  },
  {
    "poem_id": 87993,
    "vorder": 119,
    "position": 0,
    "text": "از ایرانیان گیو و طوس‌اند مَرد"
  },
  {
    "poem_id": 87993,
    "vorder": 120,
    "position": 1,
    "text": "که با فَرّ و بَرزند روز نبرد"
  },
  {
    "poem_id": 87993,
    "vorder": 121,
    "position": 0,
    "text": "برادرْم هومان بسی پیش طوس"
  },
  {
    "poem_id": 87993,
    "vorder": 122,
    "position": 1,
    "text": "جهان کرد بر گونهٔ آبنوس"
  },
  {
    "poem_id": 87993,
    "vorder": 123,
    "position": 0,
    "text": "به ایران ندانم که این مرد کیست"
  },
  {
    "poem_id": 87993,
    "vorder": 124,
    "position": 1,
    "text": "بدین لشکر او را هم‌آورد کیست"
  },
  {
    "poem_id": 87993,
    "vorder": 125,
    "position": 0,
    "text": "شوم بازپرسم ز پرده‌سرای"
  },
  {
    "poem_id": 87993,
    "vorder": 126,
    "position": 1,
    "text": "بیارند ناکام نامش به جای"
  },
  {
    "poem_id": 87993,
    "vorder": 127,
    "position": 0,
    "text": "بیامد پر اندیشه و رویْ زرد"
  },
  {
    "poem_id": 87993,
    "vorder": 128,
    "position": 1,
    "text": "بپرسید زان نامدارانِ مرد"
  },
  {
    "poem_id": 87993,
    "vorder": 129,
    "position": 0,
    "text": "به پیران چنین گفت هومانِ گُرد"
  },
  {
    "poem_id": 87993,
    "vorder": 130,
    "position": 1,
    "text": "که دشمن ندارد خردمند خُرد"
  },
  {
    "poem_id": 87993,
    "vorder": 131,
    "position": 0,
    "text": "بزرگان ایران گشاده‌دلند"
  },
  {
    "poem_id": 87993,
    "vorder": 132,
    "position": 1,
    "text": "تو گویی که آهن همی بگسلند"
  },
  {
    "poem_id": 87993,
    "vorder": 133,
    "position": 0,
    "text": "کنون تا بیامد از ایران سپاه"
  },
  {
    "poem_id": 87993,
    "vorder": 134,
    "position": 1,
    "text": "همی برخروشند زان رزمگاه"
  },
  {
    "poem_id": 87993,
    "vorder": 135,
    "position": 0,
    "text": "بدو گفت پیران که هر چند یار"
  },
  {
    "poem_id": 87993,
    "vorder": 136,
    "position": 1,
    "text": "بیاید برِ طوس از ایران سوار"
  },
  {
    "poem_id": 87993,
    "vorder": 137,
    "position": 0,
    "text": "چو رستم نباشد مرا باک نیست"
  },
  {
    "poem_id": 87993,
    "vorder": 138,
    "position": 1,
    "text": "ز گرگین و بیژن دلم چاک نیست"
  },
  {
    "poem_id": 87993,
    "vorder": 139,
    "position": 0,
    "text": "سپه را دو رزم گرانست پیش"
  },
  {
    "poem_id": 87993,
    "vorder": 140,
    "position": 1,
    "text": "بجویند هر کس بدین نامِ خویش"
  },
  {
    "poem_id": 87993,
    "vorder": 141,
    "position": 0,
    "text": "وزان جایگه پیش کاموس رفت"
  },
  {
    "poem_id": 87993,
    "vorder": 142,
    "position": 1,
    "text": "به نزدیک منشور و فَرطوس تفت"
  },
  {
    "poem_id": 87993,
    "vorder": 143,
    "position": 0,
    "text": "چنین گفت کامروز رزمی بزرگ"
  },
  {
    "poem_id": 87993,
    "vorder": 144,
    "position": 1,
    "text": "برفت و پدید آمد از میشْ گرگ"
  },
  {
    "poem_id": 87993,
    "vorder": 145,
    "position": 0,
    "text": "ببینید تا چارهٔ کار چیست"
  },
  {
    "poem_id": 87993,
    "vorder": 146,
    "position": 1,
    "text": "بران خستگی‌ها بر آزار چیست"
  },
  {
    "poem_id": 87993,
    "vorder": 147,
    "position": 0,
    "text": "چنین گفت کاموس کامروز جنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 148,
    "position": 1,
    "text": "چنان بُد که نام اندر آمد به ننگ"
  },
  {
    "poem_id": 87993,
    "vorder": 149,
    "position": 0,
    "text": "به رزم اندرون کشته شد اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 150,
    "position": 1,
    "text": "وزو شادمان شد دل گیو و طوس"
  },
  {
    "poem_id": 87993,
    "vorder": 151,
    "position": 0,
    "text": "دلم زان پیاده به دو نیم شد"
  },
  {
    "poem_id": 87993,
    "vorder": 152,
    "position": 1,
    "text": "کزو لشکر ما پر از بیم شد"
  },
  {
    "poem_id": 87993,
    "vorder": 153,
    "position": 0,
    "text": "به بالای او بر زمین، مرد نیست"
  },
  {
    "poem_id": 87993,
    "vorder": 154,
    "position": 1,
    "text": "بدین لشکر او را هم‌آورد نیست"
  },
  {
    "poem_id": 87993,
    "vorder": 155,
    "position": 0,
    "text": "کمانش تو دیدی و تیر ایدرست"
  },
  {
    "poem_id": 87993,
    "vorder": 156,
    "position": 1,
    "text": "به زور او ز پیلِ ژیان برترست"
  },
  {
    "poem_id": 87993,
    "vorder": 157,
    "position": 0,
    "text": "همانا که آن سَگزیِ جنگجوی"
  },
  {
    "poem_id": 87993,
    "vorder": 158,
    "position": 1,
    "text": "که چندین همی برشمردی ازوی"
  },
  {
    "poem_id": 87993,
    "vorder": 159,
    "position": 0,
    "text": "پیاده بدین رزمگاه آمدست"
  },
  {
    "poem_id": 87993,
    "vorder": 160,
    "position": 1,
    "text": "به یاری ایران سپاه آمدست"
  },
  {
    "poem_id": 87993,
    "vorder": 161,
    "position": 0,
    "text": "بدو گفت پیران که او دیگرست"
  },
  {
    "poem_id": 87993,
    "vorder": 162,
    "position": 1,
    "text": "سواری سرافراز و کُنداورست"
  },
  {
    "poem_id": 87993,
    "vorder": 163,
    "position": 0,
    "text": "بترسید پس مردِ بیدار دل"
  },
  {
    "poem_id": 87993,
    "vorder": 164,
    "position": 1,
    "text": "کجا بسته بود اندران کار دل"
  },
  {
    "poem_id": 87993,
    "vorder": 165,
    "position": 0,
    "text": "ز پیران بپرسید کان شیر مرد"
  },
  {
    "poem_id": 87993,
    "vorder": 166,
    "position": 1,
    "text": "چگونه خرامد به دشت نبرد؟"
  },
  {
    "poem_id": 87993,
    "vorder": 167,
    "position": 0,
    "text": "ز بازو و بَرزش چه داری نشان؟"
  },
  {
    "poem_id": 87993,
    "vorder": 168,
    "position": 1,
    "text": "چه گوید به آورد با سرکشان؟"
  },
  {
    "poem_id": 87993,
    "vorder": 169,
    "position": 0,
    "text": "چگونست مردیّ و دیدار اوی؟"
  },
  {
    "poem_id": 87993,
    "vorder": 170,
    "position": 1,
    "text": "چگونه شوم من به پیکار اوی؟"
  },
  {
    "poem_id": 87993,
    "vorder": 171,
    "position": 0,
    "text": "گر ایدونک اویست کامد ز راه"
  },
  {
    "poem_id": 87993,
    "vorder": 172,
    "position": 1,
    "text": "مرا رفت باید به آوردگاه"
  },
  {
    "poem_id": 87993,
    "vorder": 173,
    "position": 0,
    "text": "بدو گفت پیران که این خود مباد"
  },
  {
    "poem_id": 87993,
    "vorder": 174,
    "position": 1,
    "text": "که او آید ایدر کند رزم یاد"
  },
  {
    "poem_id": 87993,
    "vorder": 175,
    "position": 0,
    "text": "یکی مرد بینی چو سرو سهی"
  },
  {
    "poem_id": 87993,
    "vorder": 176,
    "position": 1,
    "text": "به دیدار با زیب و با فَرّهی"
  },
  {
    "poem_id": 87993,
    "vorder": 177,
    "position": 0,
    "text": "بسا رزمگاها که افراسیاب"
  },
  {
    "poem_id": 87993,
    "vorder": 178,
    "position": 1,
    "text": "ازو گشت پیچان و دیده پرآب"
  },
  {
    "poem_id": 87993,
    "vorder": 179,
    "position": 0,
    "text": "یکی رزمسازست و خسروپرست"
  },
  {
    "poem_id": 87993,
    "vorder": 180,
    "position": 1,
    "text": "نخست او بَرَد سوی شمشیر دست"
  },
  {
    "poem_id": 87993,
    "vorder": 181,
    "position": 0,
    "text": "به کینِ سیاوش کند کارزار"
  },
  {
    "poem_id": 87993,
    "vorder": 182,
    "position": 1,
    "text": "کجا او بپروردش اندر کنار"
  },
  {
    "poem_id": 87993,
    "vorder": 183,
    "position": 0,
    "text": "ز مردان کنند آزمایش بسی"
  },
  {
    "poem_id": 87993,
    "vorder": 184,
    "position": 1,
    "text": "سلیح ورا برنتابد کسی"
  },
  {
    "poem_id": 87993,
    "vorder": 185,
    "position": 0,
    "text": "نه برگیرد از جایْ گرزش نهنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 186,
    "position": 1,
    "text": "اگر بفگند بر زمین روزِ جنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 187,
    "position": 0,
    "text": "زهی بَر کمانش بَر از چرم شیر"
  },
  {
    "poem_id": 87993,
    "vorder": 188,
    "position": 1,
    "text": "یکی تیر و پیکان او دَه سِتیر"
  },
  {
    "poem_id": 87993,
    "vorder": 189,
    "position": 0,
    "text": "به رزم اندر آید بپوشد زره"
  },
  {
    "poem_id": 87993,
    "vorder": 190,
    "position": 1,
    "text": "یکی جوشن از بَر ببندد گره"
  },
  {
    "poem_id": 87993,
    "vorder": 191,
    "position": 0,
    "text": "یکی جامه دارد ز چرم پلنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 192,
    "position": 1,
    "text": "بپوشد بَر و اندر آید به جنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 193,
    "position": 0,
    "text": "همی نامْ بَبرِ بَیان خوانَدَش"
  },
  {
    "poem_id": 87993,
    "vorder": 194,
    "position": 1,
    "text": "ز خِفتان و جوشن فزون دانَدَش"
  },
  {
    "poem_id": 87993,
    "vorder": 195,
    "position": 0,
    "text": "نه سوزد در آتش، نه از آب تر"
  },
  {
    "poem_id": 87993,
    "vorder": 196,
    "position": 1,
    "text": "شود چون بپوشد برآیدْش پَر"
  },
  {
    "poem_id": 87993,
    "vorder": 197,
    "position": 0,
    "text": "یکی رخش دارد به زیر اندرون"
  },
  {
    "poem_id": 87993,
    "vorder": 198,
    "position": 1,
    "text": "تو گفتی روان شد کُهِ بیستون"
  },
  {
    "poem_id": 87993,
    "vorder": 199,
    "position": 0,
    "text": "همی آتش افروزد از خاک و سنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 200,
    "position": 1,
    "text": "نیارامد از بانگ، هنگام جنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 201,
    "position": 0,
    "text": "ابا این شگفتی به روز نبرد"
  },
  {
    "poem_id": 87993,
    "vorder": 202,
    "position": 1,
    "text": "سزد گر نداری تو او را به مرد"
  },
  {
    "poem_id": 87993,
    "vorder": 203,
    "position": 0,
    "text": "چو بشْنید کاموسِ بسیارهوش"
  },
  {
    "poem_id": 87993,
    "vorder": 204,
    "position": 1,
    "text": "به پیران سپرد آن زمان چشم و گوش"
  },
  {
    "poem_id": 87993,
    "vorder": 205,
    "position": 0,
    "text": "همانا خوش آمدْش گفتار اوی"
  },
  {
    "poem_id": 87993,
    "vorder": 206,
    "position": 1,
    "text": "برافروخت زان کار بازار اوی"
  },
  {
    "poem_id": 87993,
    "vorder": 207,
    "position": 0,
    "text": "به پیران چنین گفت کای پهلوان"
  },
  {
    "poem_id": 87993,
    "vorder": 208,
    "position": 1,
    "text": "تو بیدار دل باش و روشن‌روان"
  },
  {
    "poem_id": 87993,
    "vorder": 209,
    "position": 0,
    "text": "ببین تا چه خواهی ز سوگندِ سخت"
  },
  {
    "poem_id": 87993,
    "vorder": 210,
    "position": 1,
    "text": "که خوردند شاهانِ بیداربخت"
  },
  {
    "poem_id": 87993,
    "vorder": 211,
    "position": 0,
    "text": "خورم من فزون زان کنون پیش تو"
  },
  {
    "poem_id": 87993,
    "vorder": 212,
    "position": 1,
    "text": "که روشن شود زان دل و کیش تو"
  },
  {
    "poem_id": 87993,
    "vorder": 213,
    "position": 0,
    "text": "که زین را نه بردارم از پشت بور"
  },
  {
    "poem_id": 87993,
    "vorder": 214,
    "position": 1,
    "text": "به نیروی یزدانِ کیوان و هُور"
  },
  {
    "poem_id": 87993,
    "vorder": 215,
    "position": 0,
    "text": "مگر بخت و رای تو روشن کنم"
  },
  {
    "poem_id": 87993,
    "vorder": 216,
    "position": 1,
    "text": "بر ایشان جهان، چشمِ سوزن کنم"
  },
  {
    "poem_id": 87993,
    "vorder": 217,
    "position": 0,
    "text": "بسی آفرین خواند پیران بدوی"
  },
  {
    "poem_id": 87993,
    "vorder": 218,
    "position": 1,
    "text": "که ای شاهِ بینادل و راست‌گوی"
  },
  {
    "poem_id": 87993,
    "vorder": 219,
    "position": 0,
    "text": "بدین شاخ و این یال و بازوی و کِفت"
  },
  {
    "poem_id": 87993,
    "vorder": 220,
    "position": 1,
    "text": "هنرمند باشی ندارم شگفت"
  },
  {
    "poem_id": 87993,
    "vorder": 221,
    "position": 0,
    "text": "به کام تو گردد همه کار ما"
  },
  {
    "poem_id": 87993,
    "vorder": 222,
    "position": 1,
    "text": "نماندست بسیار پیکار ما"
  },
  {
    "poem_id": 87993,
    "vorder": 223,
    "position": 0,
    "text": "وزان جایگه گِردِ لشکر بگشت"
  },
  {
    "poem_id": 87993,
    "vorder": 224,
    "position": 1,
    "text": "به هر خیمه و پرده‌ای برگذشت"
  },
  {
    "poem_id": 87993,
    "vorder": 225,
    "position": 0,
    "text": "بگفت این سخن پیشِ خاقان چین"
  },
  {
    "poem_id": 87993,
    "vorder": 226,
    "position": 1,
    "text": "همی گفت با هر کسی همچنین"
  },
  {
    "poem_id": 87993,
    "vorder": 227,
    "position": 0,
    "text": "ز خورشید، چون شد جهانْ لعل‌فام"
  },
  {
    "poem_id": 87993,
    "vorder": 228,
    "position": 1,
    "text": "شب تیره بر چرخ بگذاشت گام"
  },
  {
    "poem_id": 87993,
    "vorder": 229,
    "position": 0,
    "text": "دلیران لشکر شدند انجمن"
  },
  {
    "poem_id": 87993,
    "vorder": 230,
    "position": 1,
    "text": "که بودند دانا و شمشیرزن"
  },
  {
    "poem_id": 87993,
    "vorder": 231,
    "position": 0,
    "text": "به خرگاه خاقان چین آمدند"
  },
  {
    "poem_id": 87993,
    "vorder": 232,
    "position": 1,
    "text": "همه دل پر از رزم و کین آمدند"
  },
  {
    "poem_id": 87993,
    "vorder": 233,
    "position": 0,
    "text": "چو کاموسِ اسپ‌افگنِ شیرمرد"
  },
  {
    "poem_id": 87993,
    "vorder": 234,
    "position": 1,
    "text": "چو منشور و فِرطوسِ مردِ نبرد"
  },
  {
    "poem_id": 87993,
    "vorder": 235,
    "position": 0,
    "text": "شَمیرانُ شُگنی و شَنگُل ز هند"
  },
  {
    "poem_id": 87993,
    "vorder": 236,
    "position": 1,
    "text": "ز سَقلاب چون کُندر و شاهِ سِند"
  },
  {
    "poem_id": 87993,
    "vorder": 237,
    "position": 0,
    "text": "همی رای زد رزم را هر کسی"
  },
  {
    "poem_id": 87993,
    "vorder": 238,
    "position": 1,
    "text": "از ایران سخن گفت هر کس بسی"
  },
  {
    "poem_id": 87993,
    "vorder": 239,
    "position": 0,
    "text": "از آن پس بر آن رایشان شد درست"
  },
  {
    "poem_id": 87993,
    "vorder": 240,
    "position": 1,
    "text": "که یک‌سر به خون، دست بایست شست"
  },
  {
    "poem_id": 87993,
    "vorder": 241,
    "position": 0,
    "text": "برفتند هر کس به آرامِ خویش"
  },
  {
    "poem_id": 87993,
    "vorder": 242,
    "position": 1,
    "text": "بخفتند در خیمه با کام خویش"
  },
  {
    "poem_id": 87993,
    "vorder": 243,
    "position": 0,
    "text": "چو باریک و خَمّیده شد پشت ماه"
  },
  {
    "poem_id": 87993,
    "vorder": 244,
    "position": 1,
    "text": "ز تاریک‌زلفِ شبانِ سیاه"
  },
  {
    "poem_id": 87993,
    "vorder": 245,
    "position": 0,
    "text": "به نزدیک خورشید چون شد درست"
  },
  {
    "poem_id": 87993,
    "vorder": 246,
    "position": 1,
    "text": "برآمد پر از آب رخ را بشست"
  },
  {
    "poem_id": 87993,
    "vorder": 247,
    "position": 0,
    "text": "سپاه دو کشور برآمد به جوش"
  },
  {
    "poem_id": 87993,
    "vorder": 248,
    "position": 1,
    "text": "به چرخ بلند اندر آمد خروش"
  },
  {
    "poem_id": 87993,
    "vorder": 249,
    "position": 0,
    "text": "چنین گفت خاقان که امروز جنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 250,
    "position": 1,
    "text": "نباید که چون دِی بود با درنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 251,
    "position": 0,
    "text": "گمان برد باید که پیران نبود"
  },
  {
    "poem_id": 87993,
    "vorder": 252,
    "position": 1,
    "text": "نه بی او نشاید نبرد آزمود"
  },
  {
    "poem_id": 87993,
    "vorder": 253,
    "position": 0,
    "text": "همه همگنان رزمساز آمدیم"
  },
  {
    "poem_id": 87993,
    "vorder": 254,
    "position": 1,
    "text": "به یاری ز راه دراز آمدیم"
  },
  {
    "poem_id": 87993,
    "vorder": 255,
    "position": 0,
    "text": "گر امروز چون دی درنگ آوریم"
  },
  {
    "poem_id": 87993,
    "vorder": 256,
    "position": 1,
    "text": "همه نام را زیر ننگ آوریم"
  },
  {
    "poem_id": 87993,
    "vorder": 257,
    "position": 0,
    "text": "و دیگر که فردا ز افراسیاب"
  },
  {
    "poem_id": 87993,
    "vorder": 258,
    "position": 1,
    "text": "سپاس اندر آرام جوییم و خواب"
  },
  {
    "poem_id": 87993,
    "vorder": 259,
    "position": 0,
    "text": "یکی رزم باید همه هم‌گروه"
  },
  {
    "poem_id": 87993,
    "vorder": 260,
    "position": 1,
    "text": "شدن پیش لشکر به کردارِ کوه"
  },
  {
    "poem_id": 87993,
    "vorder": 261,
    "position": 0,
    "text": "ز من هدیه و بردهٔ زابلی"
  },
  {
    "poem_id": 87993,
    "vorder": 262,
    "position": 1,
    "text": "بیابید با شارهٔ کابلی"
  },
  {
    "poem_id": 87993,
    "vorder": 263,
    "position": 0,
    "text": "ز ده کشور ایدر سرافراز هست"
  },
  {
    "poem_id": 87993,
    "vorder": 264,
    "position": 1,
    "text": "به خواب و به خوردن نباید نِشَست"
  },
  {
    "poem_id": 87993,
    "vorder": 265,
    "position": 0,
    "text": "بزرگان ز هر جای برخاستند"
  },
  {
    "poem_id": 87993,
    "vorder": 266,
    "position": 1,
    "text": "به خاقان چین خواهش آراستند"
  },
  {
    "poem_id": 87993,
    "vorder": 267,
    "position": 0,
    "text": "که بر لشکر امروز فرمان تراست"
  },
  {
    "poem_id": 87993,
    "vorder": 268,
    "position": 1,
    "text": "همه کشور چین و توران تراست"
  },
  {
    "poem_id": 87993,
    "vorder": 269,
    "position": 0,
    "text": "یک امروز بنگر بدین رزمگاه"
  },
  {
    "poem_id": 87993,
    "vorder": 270,
    "position": 1,
    "text": "که شمشیر بارد ز ابر سیاه"
  },
  {
    "poem_id": 87993,
    "vorder": 271,
    "position": 0,
    "text": "وزین روی رستم به ایرانیان"
  },
  {
    "poem_id": 87993,
    "vorder": 272,
    "position": 1,
    "text": "چنین گفت کاکنون سرآمد زمان"
  },
  {
    "poem_id": 87993,
    "vorder": 273,
    "position": 0,
    "text": "اگر کشته شد زین سپاه اندکی"
  },
  {
    "poem_id": 87993,
    "vorder": 274,
    "position": 1,
    "text": "نشد بیش و کم از دو سیصد یکی"
  },
  {
    "poem_id": 87993,
    "vorder": 275,
    "position": 0,
    "text": "چنین یکسره دل مدارید تنگ"
  },
  {
    "poem_id": 87993,
    "vorder": 276,
    "position": 1,
    "text": "نخواهم تن زنده بی‌نام و ننگ"
  },
  {
    "poem_id": 87993,
    "vorder": 277,
    "position": 0,
    "text": "همه لشکر تُرک از اشکبوس"
  },
  {
    "poem_id": 87993,
    "vorder": 278,
    "position": 1,
    "text": "برفتند رخساره چون سَندَروس"
  },
  {
    "poem_id": 87993,
    "vorder": 279,
    "position": 0,
    "text": "کنون یک‌سره دل پر از کین کنید"
  },
  {
    "poem_id": 87993,
    "vorder": 280,
    "position": 1,
    "text": "بروهای جنگی پر از چین کنید"
  },
  {
    "poem_id": 87993,
    "vorder": 281,
    "position": 0,
    "text": "که من رخش را بستم امروز نعل"
  },
  {
    "poem_id": 87993,
    "vorder": 282,
    "position": 1,
    "text": "به خون کرد خواهم سرِ تیغ، لعل"
  },
  {
    "poem_id": 87993,
    "vorder": 283,
    "position": 0,
    "text": "بسازید کامروز روز نوست"
  },
  {
    "poem_id": 87993,
    "vorder": 284,
    "position": 1,
    "text": "زمین سر به سر، گنج کیخسروست"
  },
  {
    "poem_id": 87993,
    "vorder": 285,
    "position": 0,
    "text": "میان را ببندید کز کارزار"
  },
  {
    "poem_id": 87993,
    "vorder": 286,
    "position": 1,
    "text": "همه تاج یابید با گوشوار"
  },
  {
    "poem_id": 87993,
    "vorder": 287,
    "position": 0,
    "text": "بزرگان برو خواندند آفرین"
  },
  {
    "poem_id": 87993,
    "vorder": 288,
    "position": 1,
    "text": "که از تو فروزد کلاه و نگین"
  }
]