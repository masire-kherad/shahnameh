[
  {
    "poem_id": 1934,
    "vorder": 1,
    "position": 0,
    "text": "چو ماهوی دل را برآورد گِرد"
  },
  {
    "poem_id": 1934,
    "vorder": 2,
    "position": 1,
    "text": "بدانست کو نیست جز یزدگرد"
  },
  {
    "poem_id": 1934,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت بشتاب زین انجمن"
  },
  {
    "poem_id": 1934,
    "vorder": 4,
    "position": 1,
    "text": "هم اکنون جدا کن سرش را ز تن"
  },
  {
    "poem_id": 1934,
    "vorder": 5,
    "position": 0,
    "text": "وگرنه هم اکنون ببرم سرت"
  },
  {
    "poem_id": 1934,
    "vorder": 6,
    "position": 1,
    "text": "نمانم کسی زنده از گوهرت"
  },
  {
    "poem_id": 1934,
    "vorder": 7,
    "position": 0,
    "text": "شنیدند ازو این سخن مهتران"
  },
  {
    "poem_id": 1934,
    "vorder": 8,
    "position": 1,
    "text": "بزرگان بیدار و کنداوران"
  },
  {
    "poem_id": 1934,
    "vorder": 9,
    "position": 0,
    "text": "همه انجمن گشت ازو پر ز خشم"
  },
  {
    "poem_id": 1934,
    "vorder": 10,
    "position": 1,
    "text": "زبان پر ز گفتار و پرآب چشم"
  },
  {
    "poem_id": 1934,
    "vorder": 11,
    "position": 0,
    "text": "یکی موبدی بود رادوی نام"
  },
  {
    "poem_id": 1934,
    "vorder": 12,
    "position": 1,
    "text": "به جان و خرد برنهادی لگام"
  },
  {
    "poem_id": 1934,
    "vorder": 13,
    "position": 0,
    "text": "به ماهوی گفت ای بداندیش مرد"
  },
  {
    "poem_id": 1934,
    "vorder": 14,
    "position": 1,
    "text": "چرا دیو چشم تو را تیره کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 15,
    "position": 0,
    "text": "چنان دان که شاهی و پیغمبری"
  },
  {
    "poem_id": 1934,
    "vorder": 16,
    "position": 1,
    "text": "دو گوهر بود در یک انگشتری"
  },
  {
    "poem_id": 1934,
    "vorder": 17,
    "position": 0,
    "text": "ازین دو یکی را همی‌بشکنی"
  },
  {
    "poem_id": 1934,
    "vorder": 18,
    "position": 1,
    "text": "روان و خرد را به پا افگنی"
  },
  {
    "poem_id": 1934,
    "vorder": 19,
    "position": 0,
    "text": "نگر تا چه گویی بپرهیز ازین"
  },
  {
    "poem_id": 1934,
    "vorder": 20,
    "position": 1,
    "text": "مشو بدگمان با جهان‌آفرین"
  },
  {
    "poem_id": 1934,
    "vorder": 21,
    "position": 0,
    "text": "نخستین ازو بر تو آید گزند"
  },
  {
    "poem_id": 1934,
    "vorder": 22,
    "position": 1,
    "text": "به فرزند مانی یکی کشتمند"
  },
  {
    "poem_id": 1934,
    "vorder": 23,
    "position": 0,
    "text": "که بارش کبست آید و برگ خون"
  },
  {
    "poem_id": 1934,
    "vorder": 24,
    "position": 1,
    "text": "به زودی سر خویش بینی نگون"
  },
  {
    "poem_id": 1934,
    "vorder": 25,
    "position": 0,
    "text": "همی دین یزدان شود زو تباه"
  },
  {
    "poem_id": 1934,
    "vorder": 26,
    "position": 1,
    "text": "همان برتو نفرین کند تاج و گاه"
  },
  {
    "poem_id": 1934,
    "vorder": 27,
    "position": 0,
    "text": "برهنه شود در جهان زشت تو"
  },
  {
    "poem_id": 1934,
    "vorder": 28,
    "position": 1,
    "text": "پسر بدرود بی‌گمان کشت تو"
  },
  {
    "poem_id": 1934,
    "vorder": 29,
    "position": 0,
    "text": "یکی دین‌وری بود یزدان‌پرست"
  },
  {
    "poem_id": 1934,
    "vorder": 30,
    "position": 1,
    "text": "که هرگز نبردی به بد کار دست"
  },
  {
    "poem_id": 1934,
    "vorder": 31,
    "position": 0,
    "text": "که هرمزد خراد بُد نام او"
  },
  {
    "poem_id": 1934,
    "vorder": 32,
    "position": 1,
    "text": "بدین اندرون بود آرام او"
  },
  {
    "poem_id": 1934,
    "vorder": 33,
    "position": 0,
    "text": "به ماهوی گفت ای ستمگاره مرد"
  },
  {
    "poem_id": 1934,
    "vorder": 34,
    "position": 1,
    "text": "چنین از ره پاک‌یزدان مگرد"
  },
  {
    "poem_id": 1934,
    "vorder": 35,
    "position": 0,
    "text": "همی تیره بینم دل و هوش تو"
  },
  {
    "poem_id": 1934,
    "vorder": 36,
    "position": 1,
    "text": "همی خار بینم در آغوش تو"
  },
  {
    "poem_id": 1934,
    "vorder": 37,
    "position": 0,
    "text": "تنومند و بی‌مغز و جان نزار"
  },
  {
    "poem_id": 1934,
    "vorder": 38,
    "position": 1,
    "text": "همی دود ز آتش کنی خواستار"
  },
  {
    "poem_id": 1934,
    "vorder": 39,
    "position": 0,
    "text": "تو را زین جهان سرزنش بینم آز"
  },
  {
    "poem_id": 1934,
    "vorder": 40,
    "position": 1,
    "text": "ببرگشتنت گرم و رنج گداز"
  },
  {
    "poem_id": 1934,
    "vorder": 41,
    "position": 0,
    "text": "کنون زندگانیت ناخوش بود"
  },
  {
    "poem_id": 1934,
    "vorder": 42,
    "position": 1,
    "text": "چو رفتی نشستت در آتش بود"
  },
  {
    "poem_id": 1934,
    "vorder": 43,
    "position": 0,
    "text": "نشست او و شهروی بر پای خاست"
  },
  {
    "poem_id": 1934,
    "vorder": 44,
    "position": 1,
    "text": "به ماهوی گفت این دلیری چراست"
  },
  {
    "poem_id": 1934,
    "vorder": 45,
    "position": 0,
    "text": "شهنشاه را کارزار آمدی"
  },
  {
    "poem_id": 1934,
    "vorder": 46,
    "position": 1,
    "text": "ز خان و ز فغفور یار آمدی"
  },
  {
    "poem_id": 1934,
    "vorder": 47,
    "position": 0,
    "text": "ازین تخمه بی‌کس بسی یافتند"
  },
  {
    "poem_id": 1934,
    "vorder": 48,
    "position": 1,
    "text": "که هرگز بکشتنش نشتافتند"
  },
  {
    "poem_id": 1934,
    "vorder": 49,
    "position": 0,
    "text": "تو گر بنده‌ای خون شاهان مریز"
  },
  {
    "poem_id": 1934,
    "vorder": 50,
    "position": 1,
    "text": "که نفرین بود بر تو تا رستخیز"
  },
  {
    "poem_id": 1934,
    "vorder": 51,
    "position": 0,
    "text": "بگفت این و بنشست گریان به درد"
  },
  {
    "poem_id": 1934,
    "vorder": 52,
    "position": 1,
    "text": "پر از خون دل و مژه پر آب زرد"
  },
  {
    "poem_id": 1934,
    "vorder": 53,
    "position": 0,
    "text": "چو بنشست گریان بشد مهرنوش"
  },
  {
    "poem_id": 1934,
    "vorder": 54,
    "position": 1,
    "text": "پر از درد با ناله و با خروش"
  },
  {
    "poem_id": 1934,
    "vorder": 55,
    "position": 0,
    "text": "به ماهوی گفت ای بد بدنژاد"
  },
  {
    "poem_id": 1934,
    "vorder": 56,
    "position": 1,
    "text": "که نه رای فرجام دانی نه داد"
  },
  {
    "poem_id": 1934,
    "vorder": 57,
    "position": 0,
    "text": "ز خون کیان شرم دارد نهنگ"
  },
  {
    "poem_id": 1934,
    "vorder": 58,
    "position": 1,
    "text": "اگر کشته بیند ندرّد پلنگ"
  },
  {
    "poem_id": 1934,
    "vorder": 59,
    "position": 0,
    "text": "ایا بتّر از دد به مهر و به خوی"
  },
  {
    "poem_id": 1934,
    "vorder": 60,
    "position": 1,
    "text": "همی گاه شاه آیدت آرزوی"
  },
  {
    "poem_id": 1934,
    "vorder": 61,
    "position": 0,
    "text": "چو بر دست ضحاک جم کشته شد"
  },
  {
    "poem_id": 1934,
    "vorder": 62,
    "position": 1,
    "text": "چه مایه سپهر از برش گشته شد"
  },
  {
    "poem_id": 1934,
    "vorder": 63,
    "position": 0,
    "text": "چو ضحاک بگرفت روی زمین"
  },
  {
    "poem_id": 1934,
    "vorder": 64,
    "position": 1,
    "text": "پدید آمد اندر جهان آبتین"
  },
  {
    "poem_id": 1934,
    "vorder": 65,
    "position": 0,
    "text": "بزاد آفریدون فرخ نژاد"
  },
  {
    "poem_id": 1934,
    "vorder": 66,
    "position": 1,
    "text": "جهان را یکی دیگر آمد نهاد"
  },
  {
    "poem_id": 1934,
    "vorder": 67,
    "position": 0,
    "text": "شنیدی که ضحاک بیدادگر"
  },
  {
    "poem_id": 1934,
    "vorder": 68,
    "position": 1,
    "text": "چه آورد از آن خویشتن را به سر"
  },
  {
    "poem_id": 1934,
    "vorder": 69,
    "position": 0,
    "text": "برو سال بگذشت مانا هزار"
  },
  {
    "poem_id": 1934,
    "vorder": 70,
    "position": 1,
    "text": "به فرجام کار آمدش خواستار"
  },
  {
    "poem_id": 1934,
    "vorder": 71,
    "position": 0,
    "text": "و دیگر که تور آن سرافراز مرد"
  },
  {
    "poem_id": 1934,
    "vorder": 72,
    "position": 1,
    "text": "کجا آز ایران ورا رنجه کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 73,
    "position": 0,
    "text": "همان ایرج پاک‌دین را بکشت"
  },
  {
    "poem_id": 1934,
    "vorder": 74,
    "position": 1,
    "text": "برو گردش آسمان شد درشت"
  },
  {
    "poem_id": 1934,
    "vorder": 75,
    "position": 0,
    "text": "منوچهر زان تخمه آمد پدید"
  },
  {
    "poem_id": 1934,
    "vorder": 76,
    "position": 1,
    "text": "شد آن بند بد را سراسر کلید"
  },
  {
    "poem_id": 1934,
    "vorder": 77,
    "position": 0,
    "text": "سه دیگر سیاوش ز تخم کیان"
  },
  {
    "poem_id": 1934,
    "vorder": 78,
    "position": 1,
    "text": "کمر بست بی‌آرزو در میان"
  },
  {
    "poem_id": 1934,
    "vorder": 79,
    "position": 0,
    "text": "به گفتار گرسیوز افراسیاب"
  },
  {
    "poem_id": 1934,
    "vorder": 80,
    "position": 1,
    "text": "ببرد از روان و خرد شرم و آب"
  },
  {
    "poem_id": 1934,
    "vorder": 81,
    "position": 0,
    "text": "جهاندار کیخسرو از پشت اوی"
  },
  {
    "poem_id": 1934,
    "vorder": 82,
    "position": 1,
    "text": "بیامد جهان کرد پر گفت‌و‌گوی"
  },
  {
    "poem_id": 1934,
    "vorder": 83,
    "position": 0,
    "text": "نیا را به خنجر به دو نیم کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 84,
    "position": 1,
    "text": "سر کینه‌جویان پر از بیم کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 85,
    "position": 0,
    "text": "چهارم سخن کین ارجاسپ بود"
  },
  {
    "poem_id": 1934,
    "vorder": 86,
    "position": 1,
    "text": "که ریزندهٔ خون لهراسپ بود"
  },
  {
    "poem_id": 1934,
    "vorder": 87,
    "position": 0,
    "text": "چو اسفندیار اندر آمد به جنگ"
  },
  {
    "poem_id": 1934,
    "vorder": 88,
    "position": 1,
    "text": "ز کینه ندادش زمانی درنگ"
  },
  {
    "poem_id": 1934,
    "vorder": 89,
    "position": 0,
    "text": "به پنجم سخن کین هرمزد شاه"
  },
  {
    "poem_id": 1934,
    "vorder": 90,
    "position": 1,
    "text": "چو پرویز را گشن شد دستگاه"
  },
  {
    "poem_id": 1934,
    "vorder": 91,
    "position": 0,
    "text": "به بندوی و گستهم کرد آنچ کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 92,
    "position": 1,
    "text": "نیاساید این چرخ گردان ز گرد"
  },
  {
    "poem_id": 1934,
    "vorder": 93,
    "position": 0,
    "text": "چو دستش شد او جان ایشان ببرد"
  },
  {
    "poem_id": 1934,
    "vorder": 94,
    "position": 1,
    "text": "دُر کینه را خوار نتوان شمرد"
  },
  {
    "poem_id": 1934,
    "vorder": 95,
    "position": 0,
    "text": "تو را زود یاد آید این روزگار"
  },
  {
    "poem_id": 1934,
    "vorder": 96,
    "position": 1,
    "text": "بپیچی ز اندیشهٔ نابکار"
  },
  {
    "poem_id": 1934,
    "vorder": 97,
    "position": 0,
    "text": "تو زین هرچ کاری پسر بدرود"
  },
  {
    "poem_id": 1934,
    "vorder": 98,
    "position": 1,
    "text": "زمانه زمانی همی‌نغنود"
  },
  {
    "poem_id": 1934,
    "vorder": 99,
    "position": 0,
    "text": "بپرهیز زین گنج آراسته"
  },
  {
    "poem_id": 1934,
    "vorder": 100,
    "position": 1,
    "text": "وزین مُردری تاج و این خواسته"
  },
  {
    "poem_id": 1934,
    "vorder": 101,
    "position": 0,
    "text": "همی سر بپیچی به فرمان دیو"
  },
  {
    "poem_id": 1934,
    "vorder": 102,
    "position": 1,
    "text": "ببرّی همی راه گیهان خدیو"
  },
  {
    "poem_id": 1934,
    "vorder": 103,
    "position": 0,
    "text": "به چیزی که بر تو نزیبد همی"
  },
  {
    "poem_id": 1934,
    "vorder": 104,
    "position": 1,
    "text": "ندانی که دیوَت فریبد همی"
  },
  {
    "poem_id": 1934,
    "vorder": 105,
    "position": 0,
    "text": "به آتش نهال دلت را مسوز"
  },
  {
    "poem_id": 1934,
    "vorder": 106,
    "position": 1,
    "text": "مکن تیره این تاج گیتی‌فروز"
  },
  {
    "poem_id": 1934,
    "vorder": 107,
    "position": 0,
    "text": "سپاه پراگنده را گرد کن"
  },
  {
    "poem_id": 1934,
    "vorder": 108,
    "position": 1,
    "text": "وزین سان که گفتی مگردان سخُن"
  },
  {
    "poem_id": 1934,
    "vorder": 109,
    "position": 0,
    "text": "ازیدر به پوزش بر شاه رو"
  },
  {
    "poem_id": 1934,
    "vorder": 110,
    "position": 1,
    "text": "چو بینی ورا بندگی ساز نو"
  },
  {
    "poem_id": 1934,
    "vorder": 111,
    "position": 0,
    "text": "وزان جایگه جنگ لشکر بسیچ"
  },
  {
    "poem_id": 1934,
    "vorder": 112,
    "position": 1,
    "text": "ز رای و ز پوزش میاسای هیچ"
  },
  {
    "poem_id": 1934,
    "vorder": 113,
    "position": 0,
    "text": "کزین بدنشانِ دو گیتی شوی"
  },
  {
    "poem_id": 1934,
    "vorder": 114,
    "position": 1,
    "text": "چو گفتار دانندگان نشنوی"
  },
  {
    "poem_id": 1934,
    "vorder": 115,
    "position": 0,
    "text": "چو کاری که امروز بایدت کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 116,
    "position": 1,
    "text": "به فردا رسد زو برآرند گرد"
  },
  {
    "poem_id": 1934,
    "vorder": 117,
    "position": 0,
    "text": "همی یزدگرد شهنشاه را"
  },
  {
    "poem_id": 1934,
    "vorder": 118,
    "position": 1,
    "text": "بتر خواهی از ترک بدخواه را"
  },
  {
    "poem_id": 1934,
    "vorder": 119,
    "position": 0,
    "text": "که در جنگ شیرست بر گاه شاه"
  },
  {
    "poem_id": 1934,
    "vorder": 120,
    "position": 1,
    "text": "درخشان به کردار تابنده ماه"
  },
  {
    "poem_id": 1934,
    "vorder": 121,
    "position": 0,
    "text": "یکی یادگاری ز ساسانیان"
  },
  {
    "poem_id": 1934,
    "vorder": 122,
    "position": 1,
    "text": "که چون او نبندد کمر بر میان"
  },
  {
    "poem_id": 1934,
    "vorder": 123,
    "position": 0,
    "text": "پدر بر پدر داد و دانش‌پذیر"
  },
  {
    "poem_id": 1934,
    "vorder": 124,
    "position": 1,
    "text": "ز نوشین‌روان شاه تا اردشیر"
  },
  {
    "poem_id": 1934,
    "vorder": 125,
    "position": 0,
    "text": "بود اردشیرش به هشتم پدر"
  },
  {
    "poem_id": 1934,
    "vorder": 126,
    "position": 1,
    "text": "جهاندار ساسان با داد و فر"
  },
  {
    "poem_id": 1934,
    "vorder": 127,
    "position": 0,
    "text": "که یزدانش تاج کیان برنهاد"
  },
  {
    "poem_id": 1934,
    "vorder": 128,
    "position": 1,
    "text": "همه شهریارانش فرخ‌نژاد"
  },
  {
    "poem_id": 1934,
    "vorder": 129,
    "position": 0,
    "text": "چو تو بود مهتر به کشور بسی"
  },
  {
    "poem_id": 1934,
    "vorder": 130,
    "position": 1,
    "text": "نکرد اینچنین رای هرگز کسی"
  },
  {
    "poem_id": 1934,
    "vorder": 131,
    "position": 0,
    "text": "چو بهرام چوبین که سیصد هزار"
  },
  {
    "poem_id": 1934,
    "vorder": 132,
    "position": 1,
    "text": "عناندار و برگستوانور سوار"
  },
  {
    "poem_id": 1934,
    "vorder": 133,
    "position": 0,
    "text": "به یک تیر او پشت برگاشتند"
  },
  {
    "poem_id": 1934,
    "vorder": 134,
    "position": 1,
    "text": "بدو دشت پیکار بگذاشتند"
  },
  {
    "poem_id": 1934,
    "vorder": 135,
    "position": 0,
    "text": "چو از رای شاهان سرش سیر گشت"
  },
  {
    "poem_id": 1934,
    "vorder": 136,
    "position": 1,
    "text": "سر دولت روشنش زیر گشت"
  },
  {
    "poem_id": 1934,
    "vorder": 137,
    "position": 0,
    "text": "فرآیین که تخت بزرگی بجست"
  },
  {
    "poem_id": 1934,
    "vorder": 138,
    "position": 1,
    "text": "نبودش سزا دست بد را بشست"
  },
  {
    "poem_id": 1934,
    "vorder": 139,
    "position": 0,
    "text": "بران گونه بر کشته شد زار و خوار"
  },
  {
    "poem_id": 1934,
    "vorder": 140,
    "position": 1,
    "text": "گزافه بپرداز زین روزگار"
  },
  {
    "poem_id": 1934,
    "vorder": 141,
    "position": 0,
    "text": "بترس از خدای جهان آفرین"
  },
  {
    "poem_id": 1934,
    "vorder": 142,
    "position": 1,
    "text": "که تخت آفریدست و تاج و نگین"
  },
  {
    "poem_id": 1934,
    "vorder": 143,
    "position": 0,
    "text": "تن خویش بر خیره رسوا مکن"
  },
  {
    "poem_id": 1934,
    "vorder": 144,
    "position": 1,
    "text": "که بر تو سر آرند زود این سخُن"
  },
  {
    "poem_id": 1934,
    "vorder": 145,
    "position": 0,
    "text": "هر آنکس که با تو نگوید درست"
  },
  {
    "poem_id": 1934,
    "vorder": 146,
    "position": 1,
    "text": "چنان دان که او دشمن جان تست"
  },
  {
    "poem_id": 1934,
    "vorder": 147,
    "position": 0,
    "text": "تو بیماری اکنون و ما چون پزشک"
  },
  {
    "poem_id": 1934,
    "vorder": 148,
    "position": 1,
    "text": "پزشک خروشان به خونین سرشک"
  },
  {
    "poem_id": 1934,
    "vorder": 149,
    "position": 0,
    "text": "تو از بندهٔ بندگان کمتری"
  },
  {
    "poem_id": 1934,
    "vorder": 150,
    "position": 1,
    "text": "به اندیشهٔ دل مکن مهتری"
  },
  {
    "poem_id": 1934,
    "vorder": 151,
    "position": 0,
    "text": "همی کینه با پاک یزدان نهی"
  },
  {
    "poem_id": 1934,
    "vorder": 152,
    "position": 1,
    "text": "ز راه خرد جوی تخت مهی"
  },
  {
    "poem_id": 1934,
    "vorder": 153,
    "position": 0,
    "text": "شبان‌زاده را دل پر از تخت بود"
  },
  {
    "poem_id": 1934,
    "vorder": 154,
    "position": 1,
    "text": "ورا پند آن موبدان سخت بود"
  },
  {
    "poem_id": 1934,
    "vorder": 155,
    "position": 0,
    "text": "چنین بود تا بود و این تازه نیست"
  },
  {
    "poem_id": 1934,
    "vorder": 156,
    "position": 1,
    "text": "که کار زمانه بر اندازه نیست"
  },
  {
    "poem_id": 1934,
    "vorder": 157,
    "position": 0,
    "text": "یکی را برآرد به چرخ بلند"
  },
  {
    "poem_id": 1934,
    "vorder": 158,
    "position": 1,
    "text": "یکی را کند خوار و زار و نژند"
  },
  {
    "poem_id": 1934,
    "vorder": 159,
    "position": 0,
    "text": "نه پیوند با آن نه با اینش کین"
  },
  {
    "poem_id": 1934,
    "vorder": 160,
    "position": 1,
    "text": "که دانست راز جهان‌آفرین"
  },
  {
    "poem_id": 1934,
    "vorder": 161,
    "position": 0,
    "text": "همه موبدان تا جهان شد سیاه"
  },
  {
    "poem_id": 1934,
    "vorder": 162,
    "position": 1,
    "text": "بر آیین خورشید بنشست ماه"
  },
  {
    "poem_id": 1934,
    "vorder": 163,
    "position": 0,
    "text": "بگفتند زین گونه با کینه‌جوی"
  },
  {
    "poem_id": 1934,
    "vorder": 164,
    "position": 1,
    "text": "نبُد سوی یک موی زان گفت‌وگوی"
  },
  {
    "poem_id": 1934,
    "vorder": 165,
    "position": 0,
    "text": "چو شب تیره شد گفت با موبدان"
  },
  {
    "poem_id": 1934,
    "vorder": 166,
    "position": 1,
    "text": "شما را بباید شد ای بخردان"
  },
  {
    "poem_id": 1934,
    "vorder": 167,
    "position": 0,
    "text": "من امشب بگردانم این با پسر"
  },
  {
    "poem_id": 1934,
    "vorder": 168,
    "position": 1,
    "text": "ز هر گونه‌ای دانش آرم ببر"
  },
  {
    "poem_id": 1934,
    "vorder": 169,
    "position": 0,
    "text": "ز لشگر بخوانیم داننده بیست"
  },
  {
    "poem_id": 1934,
    "vorder": 170,
    "position": 1,
    "text": "بدان تا بدین بر نباید گریست"
  },
  {
    "poem_id": 1934,
    "vorder": 171,
    "position": 0,
    "text": "برفتند دانندگان از برش"
  },
  {
    "poem_id": 1934,
    "vorder": 172,
    "position": 1,
    "text": "بیامد یکی موبد از لشکرش"
  },
  {
    "poem_id": 1934,
    "vorder": 173,
    "position": 0,
    "text": "چو بنشست ماهوی با راستان"
  },
  {
    "poem_id": 1934,
    "vorder": 174,
    "position": 1,
    "text": "چه بینید گفت اندرین داستان"
  },
  {
    "poem_id": 1934,
    "vorder": 175,
    "position": 0,
    "text": "اگر زنده ماند تن یزدگرد"
  },
  {
    "poem_id": 1934,
    "vorder": 176,
    "position": 1,
    "text": "ز هر سو برو لشکر آیند گرد"
  },
  {
    "poem_id": 1934,
    "vorder": 177,
    "position": 0,
    "text": "برهنه شد این راز من در جهان"
  },
  {
    "poem_id": 1934,
    "vorder": 178,
    "position": 1,
    "text": "شنیدند یکسر کهان و مهان"
  },
  {
    "poem_id": 1934,
    "vorder": 179,
    "position": 0,
    "text": "بیاید مرا از بدش جان به سر"
  },
  {
    "poem_id": 1934,
    "vorder": 180,
    "position": 1,
    "text": "نه تن ماند ایدر نه بوم و نه بر"
  },
  {
    "poem_id": 1934,
    "vorder": 181,
    "position": 0,
    "text": "چنین داد پاسخ خردمند مرد"
  },
  {
    "poem_id": 1934,
    "vorder": 182,
    "position": 1,
    "text": "که این خود نخستین نبایست کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 183,
    "position": 0,
    "text": "اگر شاه ایران شود دشمنت"
  },
  {
    "poem_id": 1934,
    "vorder": 184,
    "position": 1,
    "text": "ازو بد رسد بی‌گمان بر تنت"
  },
  {
    "poem_id": 1934,
    "vorder": 185,
    "position": 0,
    "text": "و گر خون او را بریزی بدست"
  },
  {
    "poem_id": 1934,
    "vorder": 186,
    "position": 1,
    "text": "که کین‌خواه او در جهان ایزدست"
  },
  {
    "poem_id": 1934,
    "vorder": 187,
    "position": 0,
    "text": "چپ و راست رنجست و اندوه و درد"
  },
  {
    "poem_id": 1934,
    "vorder": 188,
    "position": 1,
    "text": "نگه کن کنون تا چه بایدت کرد"
  },
  {
    "poem_id": 1934,
    "vorder": 189,
    "position": 0,
    "text": "پسر گفت کای باب فرخنده‌رای"
  },
  {
    "poem_id": 1934,
    "vorder": 190,
    "position": 1,
    "text": "چو دشمن کنی زو بپرداز جای"
  },
  {
    "poem_id": 1934,
    "vorder": 191,
    "position": 0,
    "text": "سپاه آید او را ز ما چین و چین"
  },
  {
    "poem_id": 1934,
    "vorder": 192,
    "position": 1,
    "text": "به ما بر شود تنگ روی زمین"
  },
  {
    "poem_id": 1934,
    "vorder": 193,
    "position": 0,
    "text": "تو این را چنین خردکاری مدان"
  },
  {
    "poem_id": 1934,
    "vorder": 194,
    "position": 1,
    "text": "چو چیره شدی کام مردان بران"
  },
  {
    "poem_id": 1934,
    "vorder": 195,
    "position": 0,
    "text": "گر از دامن او درفشی کنند"
  },
  {
    "poem_id": 1934,
    "vorder": 196,
    "position": 1,
    "text": "تو را با سپاه از بنه برکنند"
  }
]