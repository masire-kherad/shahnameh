[
  {
    "poem_id": 88062,
    "vorder": 1,
    "position": 0,
    "text": "سپهدار توران از آن سوی جاج"
  },
  {
    "poem_id": 88062,
    "vorder": 2,
    "position": 1,
    "text": "نشسته به آرام بر تخت عاج"
  },
  {
    "poem_id": 88062,
    "vorder": 3,
    "position": 0,
    "text": "دوباره ز لشکر هزاران هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 4,
    "position": 1,
    "text": "سپه بود با آلت کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 5,
    "position": 0,
    "text": "نشسته همه خلخ و سرکشان"
  },
  {
    "poem_id": 88062,
    "vorder": 6,
    "position": 1,
    "text": "همی سرفرازان و گردنکشان"
  },
  {
    "poem_id": 88062,
    "vorder": 7,
    "position": 0,
    "text": "به مرز کروشان زمین هرچ بود"
  },
  {
    "poem_id": 88062,
    "vorder": 8,
    "position": 1,
    "text": "ز برگ درخت و ز کشت و درود"
  },
  {
    "poem_id": 88062,
    "vorder": 9,
    "position": 0,
    "text": "بخوردند یکسر همه بار و برگ"
  },
  {
    "poem_id": 88062,
    "vorder": 10,
    "position": 1,
    "text": "جهان را همی آرزو کرد مرگ"
  },
  {
    "poem_id": 88062,
    "vorder": 11,
    "position": 0,
    "text": "سپهدار ترکان به بیکند بود"
  },
  {
    "poem_id": 88062,
    "vorder": 12,
    "position": 1,
    "text": "بسی گرد او خویش و پیوند بود"
  },
  {
    "poem_id": 88062,
    "vorder": 13,
    "position": 0,
    "text": "همه نامداران ماچین و چین"
  },
  {
    "poem_id": 88062,
    "vorder": 14,
    "position": 1,
    "text": "نشسته به مرز کروشان زمین"
  },
  {
    "poem_id": 88062,
    "vorder": 15,
    "position": 0,
    "text": "جهان پر ز خرگاه و پرده سرای"
  },
  {
    "poem_id": 88062,
    "vorder": 16,
    "position": 1,
    "text": "ز خیمه نبد نیز بر دشت جای"
  },
  {
    "poem_id": 88062,
    "vorder": 17,
    "position": 0,
    "text": "جهانجوی پر دانش افراسیاب"
  },
  {
    "poem_id": 88062,
    "vorder": 18,
    "position": 1,
    "text": "نشسته به کندز به خورد و به خواب"
  },
  {
    "poem_id": 88062,
    "vorder": 19,
    "position": 0,
    "text": "نشست اندر آن مرز زان کرده بود"
  },
  {
    "poem_id": 88062,
    "vorder": 20,
    "position": 1,
    "text": "که کندز فریدون برآورده بود"
  },
  {
    "poem_id": 88062,
    "vorder": 21,
    "position": 0,
    "text": "برآورده در کندز آتشکده"
  },
  {
    "poem_id": 88062,
    "vorder": 22,
    "position": 1,
    "text": "همه زند و استا به زر آژده"
  },
  {
    "poem_id": 88062,
    "vorder": 23,
    "position": 0,
    "text": "ورا نام کندز بدی پهلوی"
  },
  {
    "poem_id": 88062,
    "vorder": 24,
    "position": 1,
    "text": "اگر پهلوانی سخن بشنوی"
  },
  {
    "poem_id": 88062,
    "vorder": 25,
    "position": 0,
    "text": "کنون نام کندز به بیکند گشت"
  },
  {
    "poem_id": 88062,
    "vorder": 26,
    "position": 1,
    "text": "زمانه پر از بند و ترفند گشت"
  },
  {
    "poem_id": 88062,
    "vorder": 27,
    "position": 0,
    "text": "نبیره فریدون بد افراسیاب"
  },
  {
    "poem_id": 88062,
    "vorder": 28,
    "position": 1,
    "text": "ز کندز به رفتن نکردی شتاب"
  },
  {
    "poem_id": 88062,
    "vorder": 29,
    "position": 0,
    "text": "خود و ویژگانش نشسته به دشت"
  },
  {
    "poem_id": 88062,
    "vorder": 30,
    "position": 1,
    "text": "سپهر از سپاهش همی خیره گشت"
  },
  {
    "poem_id": 88062,
    "vorder": 31,
    "position": 0,
    "text": "ز دیبای چینی سراپرده بود"
  },
  {
    "poem_id": 88062,
    "vorder": 32,
    "position": 1,
    "text": "فراوان به پرده درون برده بود"
  },
  {
    "poem_id": 88062,
    "vorder": 33,
    "position": 0,
    "text": "به پرده درون خیمه‌های پلنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 34,
    "position": 1,
    "text": "بر آیین سالار ترکان پشنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 35,
    "position": 0,
    "text": "نهاده به خیمه درون تخت زر"
  },
  {
    "poem_id": 88062,
    "vorder": 36,
    "position": 1,
    "text": "همه پیکر تخت یکسر گهر"
  },
  {
    "poem_id": 88062,
    "vorder": 37,
    "position": 0,
    "text": "نشسته بر او شاه توران سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 38,
    "position": 1,
    "text": "به چنگ اندرون گرز و بر سر کلاه"
  },
  {
    "poem_id": 88062,
    "vorder": 39,
    "position": 0,
    "text": "ز بیرون دهلیز پرده‌سرای"
  },
  {
    "poem_id": 88062,
    "vorder": 40,
    "position": 1,
    "text": "فراوان درفش بزرگان به پای"
  },
  {
    "poem_id": 88062,
    "vorder": 41,
    "position": 0,
    "text": "زده بر در خیمهٔ هر کسی"
  },
  {
    "poem_id": 88062,
    "vorder": 42,
    "position": 1,
    "text": "که نزدیک او آب بودش بسی"
  },
  {
    "poem_id": 88062,
    "vorder": 43,
    "position": 0,
    "text": "برادر بد و چند جنگی پسر"
  },
  {
    "poem_id": 88062,
    "vorder": 44,
    "position": 1,
    "text": "ز خویشان شاه آنک بد نامور"
  },
  {
    "poem_id": 88062,
    "vorder": 45,
    "position": 0,
    "text": "همی خواست کآید به پشت سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 46,
    "position": 1,
    "text": "به نزدیک پیران بدان رزمگاه"
  },
  {
    "poem_id": 88062,
    "vorder": 47,
    "position": 0,
    "text": "سحرگه سواری بیامد چو گرد"
  },
  {
    "poem_id": 88062,
    "vorder": 48,
    "position": 1,
    "text": "سخنهای پیران همه یاد کرد"
  },
  {
    "poem_id": 88062,
    "vorder": 49,
    "position": 0,
    "text": "همه خستگان از پس یکدگر"
  },
  {
    "poem_id": 88062,
    "vorder": 50,
    "position": 1,
    "text": "رسیدند گریان و خسته جگر"
  },
  {
    "poem_id": 88062,
    "vorder": 51,
    "position": 0,
    "text": "همی هر کسی یاد کرد آنچ دید"
  },
  {
    "poem_id": 88062,
    "vorder": 52,
    "position": 1,
    "text": "وزان بد کز ایران بدیشان رسید"
  },
  {
    "poem_id": 88062,
    "vorder": 53,
    "position": 0,
    "text": "ز پیران و لهاک و فرشیدورد"
  },
  {
    "poem_id": 88062,
    "vorder": 54,
    "position": 1,
    "text": "وزان نامداران روز نبرد"
  },
  {
    "poem_id": 88062,
    "vorder": 55,
    "position": 0,
    "text": "کز ایشان چه آمد به روی سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 56,
    "position": 1,
    "text": "چه زاری رسید اندر آن رزمگاه"
  },
  {
    "poem_id": 88062,
    "vorder": 57,
    "position": 0,
    "text": "همان روز کیخسرو آنجا رسید"
  },
  {
    "poem_id": 88062,
    "vorder": 58,
    "position": 1,
    "text": "زمین کوه تا کوه لشکر کشید"
  },
  {
    "poem_id": 88062,
    "vorder": 59,
    "position": 0,
    "text": "به زنهار شد لشکر ما همه"
  },
  {
    "poem_id": 88062,
    "vorder": 60,
    "position": 1,
    "text": "هراسان شد از بی‌شبانی رمه"
  },
  {
    "poem_id": 88062,
    "vorder": 61,
    "position": 0,
    "text": "چو بشنید شاه این سخن خیره گشت"
  },
  {
    "poem_id": 88062,
    "vorder": 62,
    "position": 1,
    "text": "سیه گشت و چشم و دلش تیره گشت"
  },
  {
    "poem_id": 88062,
    "vorder": 63,
    "position": 0,
    "text": "خروشان فرود آمد از تخت عاج"
  },
  {
    "poem_id": 88062,
    "vorder": 64,
    "position": 1,
    "text": "به پیش بزرگان بینداخت تاج"
  },
  {
    "poem_id": 88062,
    "vorder": 65,
    "position": 0,
    "text": "خروشی ز لشکر بر آمد به درد"
  },
  {
    "poem_id": 88062,
    "vorder": 66,
    "position": 1,
    "text": "رخ نامداران شد از درد زرد"
  },
  {
    "poem_id": 88062,
    "vorder": 67,
    "position": 0,
    "text": "ز بیگانه خیمه بپرداختند"
  },
  {
    "poem_id": 88062,
    "vorder": 68,
    "position": 1,
    "text": "ز خویشان یکی انجمن ساختند"
  },
  {
    "poem_id": 88062,
    "vorder": 69,
    "position": 0,
    "text": "از آن درد بگریست افراسیاب"
  },
  {
    "poem_id": 88062,
    "vorder": 70,
    "position": 1,
    "text": "همی کند موی و همی ریخت آب"
  },
  {
    "poem_id": 88062,
    "vorder": 71,
    "position": 0,
    "text": "همی گفت زار این جهانبین من"
  },
  {
    "poem_id": 88062,
    "vorder": 72,
    "position": 1,
    "text": "سوار سرافراز رویین من"
  },
  {
    "poem_id": 88062,
    "vorder": 73,
    "position": 0,
    "text": "جهانجوی لهاک و فرشیدورد"
  },
  {
    "poem_id": 88062,
    "vorder": 74,
    "position": 1,
    "text": "سواران و گردان روز نبرد"
  },
  {
    "poem_id": 88062,
    "vorder": 75,
    "position": 0,
    "text": "از این جنگ پور و برادر نماند"
  },
  {
    "poem_id": 88062,
    "vorder": 76,
    "position": 1,
    "text": "بزرگان و سالار و لشکر نماند"
  },
  {
    "poem_id": 88062,
    "vorder": 77,
    "position": 0,
    "text": "بنالید و بر زد یکی باد سرد"
  },
  {
    "poem_id": 88062,
    "vorder": 78,
    "position": 1,
    "text": "پس آنگه یکی سخت سوگند خورد"
  },
  {
    "poem_id": 88062,
    "vorder": 79,
    "position": 0,
    "text": "به یزدان که بیزارم از تخت و گاه"
  },
  {
    "poem_id": 88062,
    "vorder": 80,
    "position": 1,
    "text": "اگر نیز بیند سر من کلاه"
  },
  {
    "poem_id": 88062,
    "vorder": 81,
    "position": 0,
    "text": "قبا جوشن و اسب تخت منست"
  },
  {
    "poem_id": 88062,
    "vorder": 82,
    "position": 1,
    "text": "کله خود و نیزه درخت منست"
  },
  {
    "poem_id": 88062,
    "vorder": 83,
    "position": 0,
    "text": "از این پس نخواهم چمید و چرید"
  },
  {
    "poem_id": 88062,
    "vorder": 84,
    "position": 1,
    "text": "و گر خویشتن تاج را پرورید"
  },
  {
    "poem_id": 88062,
    "vorder": 85,
    "position": 0,
    "text": "مگر کین آن نامداران خویش"
  },
  {
    "poem_id": 88062,
    "vorder": 86,
    "position": 1,
    "text": "جهانجوی و خنجرگزاران خویش"
  },
  {
    "poem_id": 88062,
    "vorder": 87,
    "position": 0,
    "text": "بخواهم ز کیخسرو شوم‌زاد"
  },
  {
    "poem_id": 88062,
    "vorder": 88,
    "position": 1,
    "text": "که تخم سیاوش به گیتی مباد"
  },
  {
    "poem_id": 88062,
    "vorder": 89,
    "position": 0,
    "text": "خروشان همی بود ز این گفت و گوی"
  },
  {
    "poem_id": 88062,
    "vorder": 90,
    "position": 1,
    "text": "ز کیخسرو آگاهی آمد بر اوی"
  },
  {
    "poem_id": 88062,
    "vorder": 91,
    "position": 0,
    "text": "که لشکر به نزدیک جیحون رسید"
  },
  {
    "poem_id": 88062,
    "vorder": 92,
    "position": 1,
    "text": "همه روی کشور سپه گسترید"
  },
  {
    "poem_id": 88062,
    "vorder": 93,
    "position": 0,
    "text": "بدان درد و زاری سپه را بخواند"
  },
  {
    "poem_id": 88062,
    "vorder": 94,
    "position": 1,
    "text": "ز پیران فراوان سخنها براند"
  },
  {
    "poem_id": 88062,
    "vorder": 95,
    "position": 0,
    "text": "ز خون برادرش فرشیدورد"
  },
  {
    "poem_id": 88062,
    "vorder": 96,
    "position": 1,
    "text": "ز رویین و لهاک شیر نبرد"
  },
  {
    "poem_id": 88062,
    "vorder": 97,
    "position": 0,
    "text": "کنون گاه کینست و آویختن"
  },
  {
    "poem_id": 88062,
    "vorder": 98,
    "position": 1,
    "text": "ابا گیو گودرز خون ریختن"
  },
  {
    "poem_id": 88062,
    "vorder": 99,
    "position": 0,
    "text": "همم رنج و مهرست و هم درد و کین"
  },
  {
    "poem_id": 88062,
    "vorder": 100,
    "position": 1,
    "text": "از ایران و از شاه ایران زمین"
  },
  {
    "poem_id": 88062,
    "vorder": 101,
    "position": 0,
    "text": "بزرگان ترکان افراسیاب"
  },
  {
    "poem_id": 88062,
    "vorder": 102,
    "position": 1,
    "text": "ز گفتن بکردند مژگان پر آب"
  },
  {
    "poem_id": 88062,
    "vorder": 103,
    "position": 0,
    "text": "که ما سر به سر مر تو را بنده‌ایم"
  },
  {
    "poem_id": 88062,
    "vorder": 104,
    "position": 1,
    "text": "به فرمان و رایت سرافگنده‌ایم"
  },
  {
    "poem_id": 88062,
    "vorder": 105,
    "position": 0,
    "text": "چو رویین و پیران ز مادر نزاد"
  },
  {
    "poem_id": 88062,
    "vorder": 106,
    "position": 1,
    "text": "چو فرشیدورد گرامی نژاد"
  },
  {
    "poem_id": 88062,
    "vorder": 107,
    "position": 0,
    "text": "ز خون گر در و کوه و دریا شود"
  },
  {
    "poem_id": 88062,
    "vorder": 108,
    "position": 1,
    "text": "درازای ما همچو پهنا شود"
  },
  {
    "poem_id": 88062,
    "vorder": 109,
    "position": 0,
    "text": "یکی برنگردیم ز این رزمگاه"
  },
  {
    "poem_id": 88062,
    "vorder": 110,
    "position": 1,
    "text": "اگر یار باشد خداوند ماه"
  },
  {
    "poem_id": 88062,
    "vorder": 111,
    "position": 0,
    "text": "دل شاه ترکان از آن تازه گشت"
  },
  {
    "poem_id": 88062,
    "vorder": 112,
    "position": 1,
    "text": "از آن کار بر دیگر اندازه گشت"
  },
  {
    "poem_id": 88062,
    "vorder": 113,
    "position": 0,
    "text": "در گنج بگشاد و روزی بداد"
  },
  {
    "poem_id": 88062,
    "vorder": 114,
    "position": 1,
    "text": "دلش پر ز کین و سرش پر ز باد"
  },
  {
    "poem_id": 88062,
    "vorder": 115,
    "position": 0,
    "text": "گله هرچ بودش به دشت و به کوه"
  },
  {
    "poem_id": 88062,
    "vorder": 116,
    "position": 1,
    "text": "ببخشید بر لشکرش همگروه"
  },
  {
    "poem_id": 88062,
    "vorder": 117,
    "position": 0,
    "text": "ز گردان شمشیرزن سی هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 118,
    "position": 1,
    "text": "گزین کرد شاه از در کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 119,
    "position": 0,
    "text": "سوی بلخ بامی فرستادشان"
  },
  {
    "poem_id": 88062,
    "vorder": 120,
    "position": 1,
    "text": "بسی پند و اندرزها دادشان"
  },
  {
    "poem_id": 88062,
    "vorder": 121,
    "position": 0,
    "text": "که گستهم نوذر بد آنجا به پای"
  },
  {
    "poem_id": 88062,
    "vorder": 122,
    "position": 1,
    "text": "سواران روشن دل و رهنمای"
  },
  {
    "poem_id": 88062,
    "vorder": 123,
    "position": 0,
    "text": "گزین کرد دیگر سپه سی هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 124,
    "position": 1,
    "text": "سواران گرد از در کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 125,
    "position": 0,
    "text": "به جیحون فرستاد تا بگذرند"
  },
  {
    "poem_id": 88062,
    "vorder": 126,
    "position": 1,
    "text": "به کشتی رخ آب را بسپرند"
  },
  {
    "poem_id": 88062,
    "vorder": 127,
    "position": 0,
    "text": "بدان تا شب تیره بی ساختن"
  },
  {
    "poem_id": 88062,
    "vorder": 128,
    "position": 1,
    "text": "ز ایران نیاید یکی تاختن"
  },
  {
    "poem_id": 88062,
    "vorder": 129,
    "position": 0,
    "text": "فرستاد بر هر سوی لشکری"
  },
  {
    "poem_id": 88062,
    "vorder": 130,
    "position": 1,
    "text": "بسی چاره‌ها ساخت از هر دری"
  },
  {
    "poem_id": 88062,
    "vorder": 131,
    "position": 0,
    "text": "چنین بود فرمان یزدان پاک"
  },
  {
    "poem_id": 88062,
    "vorder": 132,
    "position": 1,
    "text": "که بیدادگر شاه گردد هلاک"
  },
  {
    "poem_id": 88062,
    "vorder": 133,
    "position": 0,
    "text": "شب تیره بنشست با بخردان"
  },
  {
    "poem_id": 88062,
    "vorder": 134,
    "position": 1,
    "text": "جهاندیده و رای زن موبدان"
  },
  {
    "poem_id": 88062,
    "vorder": 135,
    "position": 0,
    "text": "ز هرگونه با او سخن ساختند"
  },
  {
    "poem_id": 88062,
    "vorder": 136,
    "position": 1,
    "text": "جهان را چپ و راست انداختند"
  },
  {
    "poem_id": 88062,
    "vorder": 137,
    "position": 0,
    "text": "بر آن برنهادند یکسر که شاه"
  },
  {
    "poem_id": 88062,
    "vorder": 138,
    "position": 1,
    "text": "ز جیحون بر آن سو گذارد سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 139,
    "position": 0,
    "text": "قراخان که او بود مهتر پسر"
  },
  {
    "poem_id": 88062,
    "vorder": 140,
    "position": 1,
    "text": "بفرمود تا رفت پیش پدر"
  },
  {
    "poem_id": 88062,
    "vorder": 141,
    "position": 0,
    "text": "پدر بود گفتی به مردی به جای"
  },
  {
    "poem_id": 88062,
    "vorder": 142,
    "position": 1,
    "text": "به بالا و دیدار و فرهنگ و رای"
  },
  {
    "poem_id": 88062,
    "vorder": 143,
    "position": 0,
    "text": "ز چندان سپه نیمه او را سپرد"
  },
  {
    "poem_id": 88062,
    "vorder": 144,
    "position": 1,
    "text": "جهاندیده و نامداران گرد"
  },
  {
    "poem_id": 88062,
    "vorder": 145,
    "position": 0,
    "text": "بفرمودتا در بخارا بود"
  },
  {
    "poem_id": 88062,
    "vorder": 146,
    "position": 1,
    "text": "به پشت پدر کوه خارا بود"
  },
  {
    "poem_id": 88062,
    "vorder": 147,
    "position": 0,
    "text": "دمادم فرستد سلیح و سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 148,
    "position": 1,
    "text": "خورش را شتر نگسلاند ز راه"
  },
  {
    "poem_id": 88062,
    "vorder": 149,
    "position": 0,
    "text": "سپه را ز بیکند بیرون کشید"
  },
  {
    "poem_id": 88062,
    "vorder": 150,
    "position": 1,
    "text": "دمان تا لب رود جیحون کشید"
  },
  {
    "poem_id": 88062,
    "vorder": 151,
    "position": 0,
    "text": "سپه بود سرتاسر رودبار"
  },
  {
    "poem_id": 88062,
    "vorder": 152,
    "position": 1,
    "text": "بیاورد کشتی و زورق هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 153,
    "position": 0,
    "text": "به یک هفته بر آب کشتی گذشت"
  },
  {
    "poem_id": 88062,
    "vorder": 154,
    "position": 1,
    "text": "سپه بود یکسر همه کوه و دشت"
  },
  {
    "poem_id": 88062,
    "vorder": 155,
    "position": 0,
    "text": "به خرطوم پیلان و شیران به دم"
  },
  {
    "poem_id": 88062,
    "vorder": 156,
    "position": 1,
    "text": "گذرهای جیحون پر از باد و دم"
  },
  {
    "poem_id": 88062,
    "vorder": 157,
    "position": 0,
    "text": "ز کشتی همه آب شد ناپدید"
  },
  {
    "poem_id": 88062,
    "vorder": 158,
    "position": 1,
    "text": "بیابان آموی لشکر کشید"
  },
  {
    "poem_id": 88062,
    "vorder": 159,
    "position": 0,
    "text": "بیامد پس لشکر افراسیاب"
  },
  {
    "poem_id": 88062,
    "vorder": 160,
    "position": 1,
    "text": "بر اندیشهٔ رزم بگذاشت آب"
  },
  {
    "poem_id": 88062,
    "vorder": 161,
    "position": 0,
    "text": "پراگند هر سو هیونی دوان"
  },
  {
    "poem_id": 88062,
    "vorder": 162,
    "position": 1,
    "text": "یکی مرد هشیار روشن روان"
  },
  {
    "poem_id": 88062,
    "vorder": 163,
    "position": 0,
    "text": "ببینید گفت از چپ و دست راست"
  },
  {
    "poem_id": 88062,
    "vorder": 164,
    "position": 1,
    "text": "که بالا و پهنای لشکر کجاست"
  },
  {
    "poem_id": 88062,
    "vorder": 165,
    "position": 0,
    "text": "چو بازآمد از هر سوی رزمساز"
  },
  {
    "poem_id": 88062,
    "vorder": 166,
    "position": 1,
    "text": "چنین گفت با شاه گردن فراز"
  },
  {
    "poem_id": 88062,
    "vorder": 167,
    "position": 0,
    "text": "که چندین سپه را بر این دشت جنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 168,
    "position": 1,
    "text": "علف باید و ساز و جای درنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 169,
    "position": 0,
    "text": "ز یک سو به دریای گیلان رهست"
  },
  {
    "poem_id": 88062,
    "vorder": 170,
    "position": 1,
    "text": "چراگاه اسبان و جای نشست"
  },
  {
    "poem_id": 88062,
    "vorder": 171,
    "position": 0,
    "text": "بدین روی جیحون و آب روان"
  },
  {
    "poem_id": 88062,
    "vorder": 172,
    "position": 1,
    "text": "خورش آورد مرد روشن روان"
  },
  {
    "poem_id": 88062,
    "vorder": 173,
    "position": 0,
    "text": "میان اندرون ریگ و دشت فراخ"
  },
  {
    "poem_id": 88062,
    "vorder": 174,
    "position": 1,
    "text": "سراپرده و خیمه بر سوی کاخ"
  },
  {
    "poem_id": 88062,
    "vorder": 175,
    "position": 0,
    "text": "دلش تازه‌تر گشت زان آگهی"
  },
  {
    "poem_id": 88062,
    "vorder": 176,
    "position": 1,
    "text": "بیامد به درگاه شاهنشهی"
  },
  {
    "poem_id": 88062,
    "vorder": 177,
    "position": 0,
    "text": "سپهدار خود دیده بد روزگار"
  },
  {
    "poem_id": 88062,
    "vorder": 178,
    "position": 1,
    "text": "نرفتی به گفتار آموزگار"
  },
  {
    "poem_id": 88062,
    "vorder": 179,
    "position": 0,
    "text": "بیاراست قلب و جناح سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 180,
    "position": 1,
    "text": "طلایه که دارد ز دشمن نگاه"
  },
  {
    "poem_id": 88062,
    "vorder": 181,
    "position": 0,
    "text": "همان ساقه و جایگاه بنه"
  },
  {
    "poem_id": 88062,
    "vorder": 182,
    "position": 1,
    "text": "همان میسره راست با میمنه"
  },
  {
    "poem_id": 88062,
    "vorder": 183,
    "position": 0,
    "text": "بیاراست لشکرگهی شاهوار"
  },
  {
    "poem_id": 88062,
    "vorder": 184,
    "position": 1,
    "text": "به قلب اندرون تیغ زن سی هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 185,
    "position": 0,
    "text": "نگه کرد بر قلبگه جای خویش"
  },
  {
    "poem_id": 88062,
    "vorder": 186,
    "position": 1,
    "text": "سپهبد بد و لشکرآرای خویش"
  },
  {
    "poem_id": 88062,
    "vorder": 187,
    "position": 0,
    "text": "بفرمود تا پیش او شد پشنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 188,
    "position": 1,
    "text": "که او داشتی چنگ و زور نهنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 189,
    "position": 0,
    "text": "به لشکر چون او نامداری نبود"
  },
  {
    "poem_id": 88062,
    "vorder": 190,
    "position": 1,
    "text": "به هر کار چون او سواری نبود"
  },
  {
    "poem_id": 88062,
    "vorder": 191,
    "position": 0,
    "text": "برانگیختی اسب و دم پلنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 192,
    "position": 1,
    "text": "گرفتی بکندی ز نیروی جنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 193,
    "position": 0,
    "text": "همان نیزهٔ آهنین داشتی"
  },
  {
    "poem_id": 88062,
    "vorder": 194,
    "position": 1,
    "text": "به آورد بر کوه بگذاشتی"
  },
  {
    "poem_id": 88062,
    "vorder": 195,
    "position": 0,
    "text": "پشنگست نامش پدر شیده خواند"
  },
  {
    "poem_id": 88062,
    "vorder": 196,
    "position": 1,
    "text": "که شیده به خورشید تابنده ماند"
  },
  {
    "poem_id": 88062,
    "vorder": 197,
    "position": 0,
    "text": "ز گردان گردنکشان صد هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 198,
    "position": 1,
    "text": "بدو داد شاه از در کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 199,
    "position": 0,
    "text": "همان میسره جهن را داد و گفت"
  },
  {
    "poem_id": 88062,
    "vorder": 200,
    "position": 1,
    "text": "که نیک اخترت باد هر جای جفت"
  },
  {
    "poem_id": 88062,
    "vorder": 201,
    "position": 0,
    "text": "که باشد نگهبان پشت پشنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 202,
    "position": 1,
    "text": "نپیچد سر ار بارد از ابر سنگ"
  },
  {
    "poem_id": 88062,
    "vorder": 203,
    "position": 0,
    "text": "سپاهی به جنگ کهیلا سپرد"
  },
  {
    "poem_id": 88062,
    "vorder": 204,
    "position": 1,
    "text": "یکی تیزتر بود ایلای گرد"
  },
  {
    "poem_id": 88062,
    "vorder": 205,
    "position": 0,
    "text": "نبیره جهاندار فراسیاب"
  },
  {
    "poem_id": 88062,
    "vorder": 206,
    "position": 1,
    "text": "که از پشت شیران ربودی کباب"
  },
  {
    "poem_id": 88062,
    "vorder": 207,
    "position": 0,
    "text": "دو جنگی ز توران سواران بدند"
  },
  {
    "poem_id": 88062,
    "vorder": 208,
    "position": 1,
    "text": "به دل یک به یک کوه ساران بدند"
  },
  {
    "poem_id": 88062,
    "vorder": 209,
    "position": 0,
    "text": "سوی میمنه لشکری برگزید"
  },
  {
    "poem_id": 88062,
    "vorder": 210,
    "position": 1,
    "text": "که خورسید گشت از جهان ناپدید"
  },
  {
    "poem_id": 88062,
    "vorder": 211,
    "position": 0,
    "text": "قراخان سالار چارم پسر"
  },
  {
    "poem_id": 88062,
    "vorder": 212,
    "position": 1,
    "text": "کمر بست و آمد به پیش پدر"
  },
  {
    "poem_id": 88062,
    "vorder": 213,
    "position": 0,
    "text": "بدو داد ترک چگل سی هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 214,
    "position": 1,
    "text": "سواران و شایستهٔ کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 215,
    "position": 0,
    "text": "طرازی و غزی و خلخ سوار"
  },
  {
    "poem_id": 88062,
    "vorder": 216,
    "position": 1,
    "text": "همان سی هزار آزموده سوار"
  },
  {
    "poem_id": 88062,
    "vorder": 217,
    "position": 0,
    "text": "که سالارشان بود پنجم پسر"
  },
  {
    "poem_id": 88062,
    "vorder": 218,
    "position": 1,
    "text": "یکی نامور گرد پرخاشخر"
  },
  {
    "poem_id": 88062,
    "vorder": 219,
    "position": 0,
    "text": "ورا خواندندی گو گردگیر"
  },
  {
    "poem_id": 88062,
    "vorder": 220,
    "position": 1,
    "text": "که بر کوه بگذاشتی تیغ و تیر"
  },
  {
    "poem_id": 88062,
    "vorder": 221,
    "position": 0,
    "text": "دمور و جرنجاش با او برفت"
  },
  {
    "poem_id": 88062,
    "vorder": 222,
    "position": 1,
    "text": "به یاری جهن سرافراز تفت"
  },
  {
    "poem_id": 88062,
    "vorder": 223,
    "position": 0,
    "text": "ز گردان و جنگ آوران سی هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 224,
    "position": 1,
    "text": "برفتند با خنجر کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 225,
    "position": 0,
    "text": "جهاندیده نستوه سالارشان"
  },
  {
    "poem_id": 88062,
    "vorder": 226,
    "position": 1,
    "text": "پشنگ دلاور نگهدارشان"
  },
  {
    "poem_id": 88062,
    "vorder": 227,
    "position": 0,
    "text": "همان سی هزار از یلان ترکمان"
  },
  {
    "poem_id": 88062,
    "vorder": 228,
    "position": 1,
    "text": "برفتند با گرز و تیر و کمان"
  },
  {
    "poem_id": 88062,
    "vorder": 229,
    "position": 0,
    "text": "سپهبد چو اغریرث جنگجوی"
  },
  {
    "poem_id": 88062,
    "vorder": 230,
    "position": 1,
    "text": "که با خون یکی داشتی آب جوی"
  },
  {
    "poem_id": 88062,
    "vorder": 231,
    "position": 0,
    "text": "وز آن نامور تیغ زن سی هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 232,
    "position": 1,
    "text": "گزین کرد شاه از در کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 233,
    "position": 0,
    "text": "سپهبد چو گرسیوز پیلتن"
  },
  {
    "poem_id": 88062,
    "vorder": 234,
    "position": 1,
    "text": "جهانجوی و سالار آن انجمن"
  },
  {
    "poem_id": 88062,
    "vorder": 235,
    "position": 0,
    "text": "بدو داد پیلان و سالارگاه"
  },
  {
    "poem_id": 88062,
    "vorder": 236,
    "position": 1,
    "text": "سر نامداران و پشت سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 237,
    "position": 0,
    "text": "از آن پس گزید از یلان ده هزار"
  },
  {
    "poem_id": 88062,
    "vorder": 238,
    "position": 1,
    "text": "که سیری نداند کس از کارزار"
  },
  {
    "poem_id": 88062,
    "vorder": 239,
    "position": 0,
    "text": "بفرمود تا در میان دو صف"
  },
  {
    "poem_id": 88062,
    "vorder": 240,
    "position": 1,
    "text": "به آوردگه بر لب آورده کف"
  },
  {
    "poem_id": 88062,
    "vorder": 241,
    "position": 0,
    "text": "پراگنده بر لشکر اسب افگنند"
  },
  {
    "poem_id": 88062,
    "vorder": 242,
    "position": 1,
    "text": "دل و پشت ایرانیان بشکنند"
  },
  {
    "poem_id": 88062,
    "vorder": 243,
    "position": 0,
    "text": "سوی باختر بود پشت سپاه"
  },
  {
    "poem_id": 88062,
    "vorder": 244,
    "position": 1,
    "text": "شب آمد به پیلان ببستند راه"
  },
  {
    "poem_id": 88062,
    "vorder": 245,
    "position": 0,
    "text": "چنین گفت سالار گیتی فروز"
  },
  {
    "poem_id": 88062,
    "vorder": 246,
    "position": 1,
    "text": "که دارد سپه چشم بر نیمروز"
  }
]