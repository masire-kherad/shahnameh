[
  {
    "poem_id": 1413,
    "vorder": 1,
    "position": 0,
    "text": "بشد ویسه سالار توران سپاه"
  },
  {
    "poem_id": 1413,
    "vorder": 2,
    "position": 1,
    "text": "ابا لشکری نامور کینه‌خواه"
  },
  {
    "poem_id": 1413,
    "vorder": 3,
    "position": 0,
    "text": "ازان پیشتر تابه قارن رسید"
  },
  {
    "poem_id": 1413,
    "vorder": 4,
    "position": 1,
    "text": "گرامیش را کشته افگنده دید"
  },
  {
    "poem_id": 1413,
    "vorder": 5,
    "position": 0,
    "text": "دلیران و گردان توران سپاه"
  },
  {
    "poem_id": 1413,
    "vorder": 6,
    "position": 1,
    "text": "بسی نیز با او فگنده به راه"
  },
  {
    "poem_id": 1413,
    "vorder": 7,
    "position": 0,
    "text": "دریده درفش و نگونسار کوس"
  },
  {
    "poem_id": 1413,
    "vorder": 8,
    "position": 1,
    "text": "چو لاله کفن روی چون سندروس"
  },
  {
    "poem_id": 1413,
    "vorder": 9,
    "position": 0,
    "text": "ز ویسه به قارن رسید آگهی"
  },
  {
    "poem_id": 1413,
    "vorder": 10,
    "position": 1,
    "text": "که آمد به پیروزی و فرهی"
  },
  {
    "poem_id": 1413,
    "vorder": 11,
    "position": 0,
    "text": "ستوران تازی سوی نیمروز"
  },
  {
    "poem_id": 1413,
    "vorder": 12,
    "position": 1,
    "text": "فرستاد و خود رفت گیتی فروز"
  },
  {
    "poem_id": 1413,
    "vorder": 13,
    "position": 0,
    "text": "ز درد پسر ویسهٔ جنگجوی"
  },
  {
    "poem_id": 1413,
    "vorder": 14,
    "position": 1,
    "text": "سوی پارس چون باد بنهاد روی"
  },
  {
    "poem_id": 1413,
    "vorder": 15,
    "position": 0,
    "text": "چو از پارس قارن به هامون کشید"
  },
  {
    "poem_id": 1413,
    "vorder": 16,
    "position": 1,
    "text": "ز دست چپش لشکر آمد پدید"
  },
  {
    "poem_id": 1413,
    "vorder": 17,
    "position": 0,
    "text": "ز گرد اندر آمد درفش سیاه"
  },
  {
    "poem_id": 1413,
    "vorder": 18,
    "position": 1,
    "text": "سپهدار ترکان به پیش سپاه"
  },
  {
    "poem_id": 1413,
    "vorder": 19,
    "position": 0,
    "text": "رده برکشیدند بر هر دو روی"
  },
  {
    "poem_id": 1413,
    "vorder": 20,
    "position": 1,
    "text": "برفتند گردان پرخاشجوی"
  },
  {
    "poem_id": 1413,
    "vorder": 21,
    "position": 0,
    "text": "ز قلب سپه ویسه آواز داد"
  },
  {
    "poem_id": 1413,
    "vorder": 22,
    "position": 1,
    "text": "که شد تاج و تخت بزرگی به باد"
  },
  {
    "poem_id": 1413,
    "vorder": 23,
    "position": 0,
    "text": "ز قنوج تا مرز کابلستان"
  },
  {
    "poem_id": 1413,
    "vorder": 24,
    "position": 1,
    "text": "همان تا در بست و زابلستان"
  },
  {
    "poem_id": 1413,
    "vorder": 25,
    "position": 0,
    "text": "همه سر به سر پاک در چنگ ماست"
  },
  {
    "poem_id": 1413,
    "vorder": 26,
    "position": 1,
    "text": "بر ایوانها نقش و نیرنگ ماست"
  },
  {
    "poem_id": 1413,
    "vorder": 27,
    "position": 0,
    "text": "کجا یافت خواهی تو آرامگاه"
  },
  {
    "poem_id": 1413,
    "vorder": 28,
    "position": 1,
    "text": "ازان پس کجا شد گرفتار شاه"
  },
  {
    "poem_id": 1413,
    "vorder": 29,
    "position": 0,
    "text": "چنین داد پاسخ که من قارنم"
  },
  {
    "poem_id": 1413,
    "vorder": 30,
    "position": 1,
    "text": "گلیم اندر آب روان افگنم"
  },
  {
    "poem_id": 1413,
    "vorder": 31,
    "position": 0,
    "text": "نه از بیم رفتم نه از گفت‌وگوی"
  },
  {
    "poem_id": 1413,
    "vorder": 32,
    "position": 1,
    "text": "به پیش پسرت آمدم کینه جوی"
  },
  {
    "poem_id": 1413,
    "vorder": 33,
    "position": 0,
    "text": "چو از کین او دل بپرداختم"
  },
  {
    "poem_id": 1413,
    "vorder": 34,
    "position": 1,
    "text": "کنون کین و جنگ ترا ساختم"
  },
  {
    "poem_id": 1413,
    "vorder": 35,
    "position": 0,
    "text": "برآمد چپ و راست گرد سیاه"
  },
  {
    "poem_id": 1413,
    "vorder": 36,
    "position": 1,
    "text": "نه روی هوا ماند روشن نه ماه"
  },
  {
    "poem_id": 1413,
    "vorder": 37,
    "position": 0,
    "text": "سپه یک به دیگر برآویختند"
  },
  {
    "poem_id": 1413,
    "vorder": 38,
    "position": 1,
    "text": "چو رود روان خون همی ریختند"
  },
  {
    "poem_id": 1413,
    "vorder": 39,
    "position": 0,
    "text": "بر ویسه شد قارن رزم جوی"
  },
  {
    "poem_id": 1413,
    "vorder": 40,
    "position": 1,
    "text": "ازو ویسه در جنگ برگاشت روی"
  },
  {
    "poem_id": 1413,
    "vorder": 41,
    "position": 0,
    "text": "فراوان ز جنگ آوران کشته شد"
  },
  {
    "poem_id": 1413,
    "vorder": 42,
    "position": 1,
    "text": "بآورد چون ویسه سرگشته شد"
  },
  {
    "poem_id": 1413,
    "vorder": 43,
    "position": 0,
    "text": "چو بر ویسه آمد ز اختر شکن"
  },
  {
    "poem_id": 1413,
    "vorder": 44,
    "position": 1,
    "text": "نرفت از پسش قارن رزم‌زن"
  },
  {
    "poem_id": 1413,
    "vorder": 45,
    "position": 0,
    "text": "بشد ویسه تا پیش افراسیاب"
  },
  {
    "poem_id": 1413,
    "vorder": 46,
    "position": 1,
    "text": "ز درد پسر مژه کرده پرآب"
  }
]