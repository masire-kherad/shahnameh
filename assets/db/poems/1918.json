[
  {
    "poem_id": 1918,
    "vorder": 1,
    "position": 0,
    "text": "چو بنشست بر تخت شاه اردشیر"
  },
  {
    "poem_id": 1918,
    "vorder": 2,
    "position": 1,
    "text": "از ایران برفتند برنا و پیر"
  },
  {
    "poem_id": 1918,
    "vorder": 3,
    "position": 0,
    "text": "بسی نامداران گشته کهن"
  },
  {
    "poem_id": 1918,
    "vorder": 4,
    "position": 1,
    "text": "بدان تا چگونه سرآید سخن"
  },
  {
    "poem_id": 1918,
    "vorder": 5,
    "position": 0,
    "text": "زبان برگشاد اردشیر جوان"
  },
  {
    "poem_id": 1918,
    "vorder": 6,
    "position": 1,
    "text": "چنین گفت کای کار دیده گوان"
  },
  {
    "poem_id": 1918,
    "vorder": 7,
    "position": 0,
    "text": "هر آنکس که برگاه شاهی نشست"
  },
  {
    "poem_id": 1918,
    "vorder": 8,
    "position": 1,
    "text": "گشاده زبان باد و یزدان پرست"
  },
  {
    "poem_id": 1918,
    "vorder": 9,
    "position": 0,
    "text": "بر آیین شاهان پیشین رویم"
  },
  {
    "poem_id": 1918,
    "vorder": 10,
    "position": 1,
    "text": "همان از پس فره و دین رویم"
  },
  {
    "poem_id": 1918,
    "vorder": 11,
    "position": 0,
    "text": "ز یزدان نیکی دهش یاد باد"
  },
  {
    "poem_id": 1918,
    "vorder": 12,
    "position": 1,
    "text": "همه کار و کردار ما داد باد"
  },
  {
    "poem_id": 1918,
    "vorder": 13,
    "position": 0,
    "text": "پرستندگان راهمه برکشیم"
  },
  {
    "poem_id": 1918,
    "vorder": 14,
    "position": 1,
    "text": "ستمگارگان را به خون درکشیم"
  },
  {
    "poem_id": 1918,
    "vorder": 15,
    "position": 0,
    "text": "بسی کس به گفتارش آرام یافت"
  },
  {
    "poem_id": 1918,
    "vorder": 16,
    "position": 1,
    "text": "از آرام او هرکسی کام یافت"
  },
  {
    "poem_id": 1918,
    "vorder": 17,
    "position": 0,
    "text": "به پیروز خسرو سپردم سپاه"
  },
  {
    "poem_id": 1918,
    "vorder": 18,
    "position": 1,
    "text": "که از داد شادست و شادان ز شاه"
  },
  {
    "poem_id": 1918,
    "vorder": 19,
    "position": 0,
    "text": "به ایران چو باشد چنو پهلوان"
  },
  {
    "poem_id": 1918,
    "vorder": 20,
    "position": 1,
    "text": "بمانید شادان و روشن روان"
  }
]