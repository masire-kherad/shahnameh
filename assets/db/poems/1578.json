[
  {
    "poem_id": 1578,
    "vorder": 1,
    "position": 0,
    "text": "به فرزند پاسخ چنین داد شاه"
  },
  {
    "poem_id": 1578,
    "vorder": 2,
    "position": 1,
    "text": "که از راستی بگذری نیست راه"
  },
  {
    "poem_id": 1578,
    "vorder": 3,
    "position": 0,
    "text": "از این بیش کردی که گفتی تو کار"
  },
  {
    "poem_id": 1578,
    "vorder": 4,
    "position": 1,
    "text": "که یار تو بادا جهان کردگار"
  },
  {
    "poem_id": 1578,
    "vorder": 5,
    "position": 0,
    "text": "نبینم همی دشمنی در جهان"
  },
  {
    "poem_id": 1578,
    "vorder": 6,
    "position": 1,
    "text": "نه در آشکارا نه اندر نهان"
  },
  {
    "poem_id": 1578,
    "vorder": 7,
    "position": 0,
    "text": "که نام تو یابد نه پیچان شود"
  },
  {
    "poem_id": 1578,
    "vorder": 8,
    "position": 1,
    "text": "چه پیچان همانا که بیجان شود"
  },
  {
    "poem_id": 1578,
    "vorder": 9,
    "position": 0,
    "text": "به گیتی نداری کسی را همال"
  },
  {
    "poem_id": 1578,
    "vorder": 10,
    "position": 1,
    "text": "مگر بی‌خرد نامور پور زال"
  },
  {
    "poem_id": 1578,
    "vorder": 11,
    "position": 0,
    "text": "که او راست تا هست زاولستان"
  },
  {
    "poem_id": 1578,
    "vorder": 12,
    "position": 1,
    "text": "همان بست و غزنین و کاولستان"
  },
  {
    "poem_id": 1578,
    "vorder": 13,
    "position": 0,
    "text": "به مردی همی ز آسمان بگذرد"
  },
  {
    "poem_id": 1578,
    "vorder": 14,
    "position": 1,
    "text": "همی خویشتن کهتری نشمرد"
  },
  {
    "poem_id": 1578,
    "vorder": 15,
    "position": 0,
    "text": "که بر پیش کاوس کی بنده بود"
  },
  {
    "poem_id": 1578,
    "vorder": 16,
    "position": 1,
    "text": "ز کیخسرو اندر جهان زنده بود"
  },
  {
    "poem_id": 1578,
    "vorder": 17,
    "position": 0,
    "text": "به شاهی ز گشتاسپ نارد سخن"
  },
  {
    "poem_id": 1578,
    "vorder": 18,
    "position": 1,
    "text": "که او تاج نو دارد و ما کهن"
  },
  {
    "poem_id": 1578,
    "vorder": 19,
    "position": 0,
    "text": "به گیتی مرا نیست کس هم نبرد"
  },
  {
    "poem_id": 1578,
    "vorder": 20,
    "position": 1,
    "text": "ز رومی و توری و آزاد مرد"
  },
  {
    "poem_id": 1578,
    "vorder": 21,
    "position": 0,
    "text": "سوی سیستان رفت باید کنون"
  },
  {
    "poem_id": 1578,
    "vorder": 22,
    "position": 1,
    "text": "به کار آوری زور و بند و فسون"
  },
  {
    "poem_id": 1578,
    "vorder": 23,
    "position": 0,
    "text": "برهنه کنی تیغ و گوپال را"
  },
  {
    "poem_id": 1578,
    "vorder": 24,
    "position": 1,
    "text": "به بند آوری رستم زال را"
  },
  {
    "poem_id": 1578,
    "vorder": 25,
    "position": 0,
    "text": "زواره فرامرز را همچنین"
  },
  {
    "poem_id": 1578,
    "vorder": 26,
    "position": 1,
    "text": "نمانی که کس برنشیند به زین"
  },
  {
    "poem_id": 1578,
    "vorder": 27,
    "position": 0,
    "text": "به دادار گیتی که او داد زور"
  },
  {
    "poem_id": 1578,
    "vorder": 28,
    "position": 1,
    "text": "فروزندهٔ اختر و ماه و هور"
  },
  {
    "poem_id": 1578,
    "vorder": 29,
    "position": 0,
    "text": "که چون این سخنها به جای آوری"
  },
  {
    "poem_id": 1578,
    "vorder": 30,
    "position": 1,
    "text": "ز من نشنوی زین سپس داوری"
  },
  {
    "poem_id": 1578,
    "vorder": 31,
    "position": 0,
    "text": "سپارم به تو تاج و تخت و کلاه"
  },
  {
    "poem_id": 1578,
    "vorder": 32,
    "position": 1,
    "text": "نشانم بر تخت بر پیشگاه"
  },
  {
    "poem_id": 1578,
    "vorder": 33,
    "position": 0,
    "text": "چنین پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1578,
    "vorder": 34,
    "position": 1,
    "text": "که ای پرهنر نامور شهریار"
  },
  {
    "poem_id": 1578,
    "vorder": 35,
    "position": 0,
    "text": "همی دور مانی ز رسم کهن"
  },
  {
    "poem_id": 1578,
    "vorder": 36,
    "position": 1,
    "text": "براندازه باید که رانی سخن"
  },
  {
    "poem_id": 1578,
    "vorder": 37,
    "position": 0,
    "text": "تو با شاه چین جنگ جوی و نبرد"
  },
  {
    "poem_id": 1578,
    "vorder": 38,
    "position": 1,
    "text": "از آن نامداران برانگیز گرد"
  },
  {
    "poem_id": 1578,
    "vorder": 39,
    "position": 0,
    "text": "چه جویی نبرد یکی مرد پیر"
  },
  {
    "poem_id": 1578,
    "vorder": 40,
    "position": 1,
    "text": "که کاووس خواندی ورا شیرگیر"
  },
  {
    "poem_id": 1578,
    "vorder": 41,
    "position": 0,
    "text": "ز گاه منوچهر تا کیقباد"
  },
  {
    "poem_id": 1578,
    "vorder": 42,
    "position": 1,
    "text": "دل شهریاران بدو بود شاد"
  },
  {
    "poem_id": 1578,
    "vorder": 43,
    "position": 0,
    "text": "نکوکارتر زو به ایران کسی"
  },
  {
    "poem_id": 1578,
    "vorder": 44,
    "position": 1,
    "text": "نبودست کاورد نیکی بسی"
  },
  {
    "poem_id": 1578,
    "vorder": 45,
    "position": 0,
    "text": "همی خواندندش خداوند رخش"
  },
  {
    "poem_id": 1578,
    "vorder": 46,
    "position": 1,
    "text": "جهانگیر و شیراوژن و تاج‌بخش"
  },
  {
    "poem_id": 1578,
    "vorder": 47,
    "position": 0,
    "text": "نه اندر جهان نامداری نوست"
  },
  {
    "poem_id": 1578,
    "vorder": 48,
    "position": 1,
    "text": "بزرگست و با عهد کیخسروست"
  },
  {
    "poem_id": 1578,
    "vorder": 49,
    "position": 0,
    "text": "اگر عهد شاهان نباشد درست"
  },
  {
    "poem_id": 1578,
    "vorder": 50,
    "position": 1,
    "text": "نباید ز گشتاسپ منشور جست"
  },
  {
    "poem_id": 1578,
    "vorder": 51,
    "position": 0,
    "text": "چنین داد پاسخ به اسفندیار"
  },
  {
    "poem_id": 1578,
    "vorder": 52,
    "position": 1,
    "text": "که ای شیر دل پرهنر نامدار"
  },
  {
    "poem_id": 1578,
    "vorder": 53,
    "position": 0,
    "text": "هر آن کس که از راه یزدان بگشت"
  },
  {
    "poem_id": 1578,
    "vorder": 54,
    "position": 1,
    "text": "همان عهد او گشت چون باد دشت"
  },
  {
    "poem_id": 1578,
    "vorder": 55,
    "position": 0,
    "text": "همانا شنیدی که کاووس شاه"
  },
  {
    "poem_id": 1578,
    "vorder": 56,
    "position": 1,
    "text": "به فرمان ابلیس گم کرد راه"
  },
  {
    "poem_id": 1578,
    "vorder": 57,
    "position": 0,
    "text": "همی بآسمان شد به پر عقاب"
  },
  {
    "poem_id": 1578,
    "vorder": 58,
    "position": 1,
    "text": "به زاری به ساری فتاد اندر آب"
  },
  {
    "poem_id": 1578,
    "vorder": 59,
    "position": 0,
    "text": "ز هاماوران دیوزادی ببرد"
  },
  {
    "poem_id": 1578,
    "vorder": 60,
    "position": 1,
    "text": "شبستان شاهی مر او را سپرد"
  },
  {
    "poem_id": 1578,
    "vorder": 61,
    "position": 0,
    "text": "سیاوش به آزار او کشته شد"
  },
  {
    "poem_id": 1578,
    "vorder": 62,
    "position": 1,
    "text": "همه دوده زیر و زبر گشته شد"
  },
  {
    "poem_id": 1578,
    "vorder": 63,
    "position": 0,
    "text": "کسی کو ز عهد جهاندار گشت"
  },
  {
    "poem_id": 1578,
    "vorder": 64,
    "position": 1,
    "text": "به گرد در او نشاید گذشت"
  },
  {
    "poem_id": 1578,
    "vorder": 65,
    "position": 0,
    "text": "اگر تخت خواهی ز من با کلاه"
  },
  {
    "poem_id": 1578,
    "vorder": 66,
    "position": 1,
    "text": "ره سیستان گیر و برکش سپاه"
  },
  {
    "poem_id": 1578,
    "vorder": 67,
    "position": 0,
    "text": "چو آن‌جا رسی دست رستم ببند"
  },
  {
    "poem_id": 1578,
    "vorder": 68,
    "position": 1,
    "text": "بیارش به بازو فگنده کمند"
  },
  {
    "poem_id": 1578,
    "vorder": 69,
    "position": 0,
    "text": "زواره فرامرز و دستان سام"
  },
  {
    "poem_id": 1578,
    "vorder": 70,
    "position": 1,
    "text": "نباید که سازند پیش تو دام"
  },
  {
    "poem_id": 1578,
    "vorder": 71,
    "position": 0,
    "text": "پیاده دوانش بدین بارگاه"
  },
  {
    "poem_id": 1578,
    "vorder": 72,
    "position": 1,
    "text": "بیاور کشان تا ببیند سپاه"
  },
  {
    "poem_id": 1578,
    "vorder": 73,
    "position": 0,
    "text": "ازان پس نپیچد سر از ما کسی"
  },
  {
    "poem_id": 1578,
    "vorder": 74,
    "position": 1,
    "text": "اگر کام اگر گنج یابد بسی"
  },
  {
    "poem_id": 1578,
    "vorder": 75,
    "position": 0,
    "text": "سپهبد بروها پر از تاب کرد"
  },
  {
    "poem_id": 1578,
    "vorder": 76,
    "position": 1,
    "text": "به شاه جهان گفت زین بازگرد"
  },
  {
    "poem_id": 1578,
    "vorder": 77,
    "position": 0,
    "text": "ترا نیست دستان و رستم به کار"
  },
  {
    "poem_id": 1578,
    "vorder": 78,
    "position": 1,
    "text": "همی راه جویی به اسفندیار"
  },
  {
    "poem_id": 1578,
    "vorder": 79,
    "position": 0,
    "text": "دریغ آیدت جای شاهی همی"
  },
  {
    "poem_id": 1578,
    "vorder": 80,
    "position": 1,
    "text": "مرا از جهان دور خواهی همی"
  },
  {
    "poem_id": 1578,
    "vorder": 81,
    "position": 0,
    "text": "ترا باد این تخت و تاج کیان"
  },
  {
    "poem_id": 1578,
    "vorder": 82,
    "position": 1,
    "text": "مرا گوشه‌ای بس بود زین جهان"
  },
  {
    "poem_id": 1578,
    "vorder": 83,
    "position": 0,
    "text": "ولیکن ترا من یکی بنده‌ام"
  },
  {
    "poem_id": 1578,
    "vorder": 84,
    "position": 1,
    "text": "به فرمان و رایت سرافگنده‌ام"
  },
  {
    "poem_id": 1578,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت گشتاسپ تندی مکن"
  },
  {
    "poem_id": 1578,
    "vorder": 86,
    "position": 1,
    "text": "بلندی بیابی نژندی مکن"
  },
  {
    "poem_id": 1578,
    "vorder": 87,
    "position": 0,
    "text": "ز لشکر گزین کن فراوان سوار"
  },
  {
    "poem_id": 1578,
    "vorder": 88,
    "position": 1,
    "text": "جهاندیدگان از در کارزار"
  },
  {
    "poem_id": 1578,
    "vorder": 89,
    "position": 0,
    "text": "سلیح و سپاه و درم پیش تست"
  },
  {
    "poem_id": 1578,
    "vorder": 90,
    "position": 1,
    "text": "نژندی به جان بداندیش تست"
  },
  {
    "poem_id": 1578,
    "vorder": 91,
    "position": 0,
    "text": "چه باید مرا بی‌تو گنج و سپاه"
  },
  {
    "poem_id": 1578,
    "vorder": 92,
    "position": 1,
    "text": "همان گنج و تخت و سپاه و کلاه"
  },
  {
    "poem_id": 1578,
    "vorder": 93,
    "position": 0,
    "text": "چنین داد پاسخ یل اسفندیار"
  },
  {
    "poem_id": 1578,
    "vorder": 94,
    "position": 1,
    "text": "که لشکر نیاید مرا خود به کار"
  },
  {
    "poem_id": 1578,
    "vorder": 95,
    "position": 0,
    "text": "گر ایدونک آید زمانم فراز"
  },
  {
    "poem_id": 1578,
    "vorder": 96,
    "position": 1,
    "text": "به لشکر ندارد جهاندار باز"
  },
  {
    "poem_id": 1578,
    "vorder": 97,
    "position": 0,
    "text": "ز پیش پدر بازگشت او به تاب"
  },
  {
    "poem_id": 1578,
    "vorder": 98,
    "position": 1,
    "text": "چه از پادشاهی چه از خشم باب"
  },
  {
    "poem_id": 1578,
    "vorder": 99,
    "position": 0,
    "text": "به ایوان خویش اندر آمد دژم"
  },
  {
    "poem_id": 1578,
    "vorder": 100,
    "position": 1,
    "text": "لبی پر ز باد و دلی پر ز غم"
  }
]