[
  {
    "poem_id": 1401,
    "vorder": 1,
    "position": 0,
    "text": "بزد نای مهراب و بربست کوس"
  },
  {
    "poem_id": 1401,
    "vorder": 2,
    "position": 1,
    "text": "بیاراست لشکر چو چشم خروس"
  },
  {
    "poem_id": 1401,
    "vorder": 3,
    "position": 0,
    "text": "ابا ژنده‌پیلان و رامشگران"
  },
  {
    "poem_id": 1401,
    "vorder": 4,
    "position": 1,
    "text": "زمین شد بهشت از کران تا کران"
  },
  {
    "poem_id": 1401,
    "vorder": 5,
    "position": 0,
    "text": "ز بس گونه گون پرنیانی درفش"
  },
  {
    "poem_id": 1401,
    "vorder": 6,
    "position": 1,
    "text": "چه سرخ و سپید و چه زرد و بنفش"
  },
  {
    "poem_id": 1401,
    "vorder": 7,
    "position": 0,
    "text": "چه آوای نای و چه آوای چنگ"
  },
  {
    "poem_id": 1401,
    "vorder": 8,
    "position": 1,
    "text": "خروشیدن بوق و آوای زنگ"
  },
  {
    "poem_id": 1401,
    "vorder": 9,
    "position": 0,
    "text": "تو گفتی مگر روز انجامش است"
  },
  {
    "poem_id": 1401,
    "vorder": 10,
    "position": 1,
    "text": "یکی رستخیز است گر رامش است"
  },
  {
    "poem_id": 1401,
    "vorder": 11,
    "position": 0,
    "text": "همی رفت ازین گونه تا پیش سام"
  },
  {
    "poem_id": 1401,
    "vorder": 12,
    "position": 1,
    "text": "فرود آمد از اسپ و بگذارد گام"
  },
  {
    "poem_id": 1401,
    "vorder": 13,
    "position": 0,
    "text": "گرفتش جهان پهلوان در کنار"
  },
  {
    "poem_id": 1401,
    "vorder": 14,
    "position": 1,
    "text": "بپرسیدش از گردش روزگار"
  },
  {
    "poem_id": 1401,
    "vorder": 15,
    "position": 0,
    "text": "شه کابلستان گرفت آفرین"
  },
  {
    "poem_id": 1401,
    "vorder": 16,
    "position": 1,
    "text": "چه بر سام و بر زال زر همچنین"
  },
  {
    "poem_id": 1401,
    "vorder": 17,
    "position": 0,
    "text": "نشست از بر بارهٔ تیزرو"
  },
  {
    "poem_id": 1401,
    "vorder": 18,
    "position": 1,
    "text": "چو از کوه سر برکشد ماه نو"
  },
  {
    "poem_id": 1401,
    "vorder": 19,
    "position": 0,
    "text": "یکی تاج زرین نگارش گهر"
  },
  {
    "poem_id": 1401,
    "vorder": 20,
    "position": 1,
    "text": "نهاد از بر تارک زال زر"
  },
  {
    "poem_id": 1401,
    "vorder": 21,
    "position": 0,
    "text": "به کابل رسیدند خندان و شاد"
  },
  {
    "poem_id": 1401,
    "vorder": 22,
    "position": 1,
    "text": "سخنهای دیرینه کردند یاد"
  },
  {
    "poem_id": 1401,
    "vorder": 23,
    "position": 0,
    "text": "همه شهر ز آوای هندی درای"
  },
  {
    "poem_id": 1401,
    "vorder": 24,
    "position": 1,
    "text": "ز نالیدن بربط و چنگ و نای"
  },
  {
    "poem_id": 1401,
    "vorder": 25,
    "position": 0,
    "text": "تو گفتی دد و دام رامشگرست"
  },
  {
    "poem_id": 1401,
    "vorder": 26,
    "position": 1,
    "text": "زمانه به آرایشی دیگرست"
  },
  {
    "poem_id": 1401,
    "vorder": 27,
    "position": 0,
    "text": "بش و یال اسپان کران تا کران"
  },
  {
    "poem_id": 1401,
    "vorder": 28,
    "position": 1,
    "text": "بر اندوده پر مشک و پر زعفران"
  },
  {
    "poem_id": 1401,
    "vorder": 29,
    "position": 0,
    "text": "برون رفت سیندخت با بندگان"
  },
  {
    "poem_id": 1401,
    "vorder": 30,
    "position": 1,
    "text": "میان بسته سیصد پرستندگان"
  },
  {
    "poem_id": 1401,
    "vorder": 31,
    "position": 0,
    "text": "مر آن هر یکی را یکی جام زر"
  },
  {
    "poem_id": 1401,
    "vorder": 32,
    "position": 1,
    "text": "به دست اندرون پر ز مشک و گهر"
  },
  {
    "poem_id": 1401,
    "vorder": 33,
    "position": 0,
    "text": "همه سام را آفرین خواندند"
  },
  {
    "poem_id": 1401,
    "vorder": 34,
    "position": 1,
    "text": "پس از جام گوهر برافشاندند"
  },
  {
    "poem_id": 1401,
    "vorder": 35,
    "position": 0,
    "text": "بدان جشن هر کس که آمد فراز"
  },
  {
    "poem_id": 1401,
    "vorder": 36,
    "position": 1,
    "text": "شد از خواسته یک به یک بی‌نیاز"
  },
  {
    "poem_id": 1401,
    "vorder": 37,
    "position": 0,
    "text": "بخندید و سیندخت را سام گفت"
  },
  {
    "poem_id": 1401,
    "vorder": 38,
    "position": 1,
    "text": "که رودابه را چند خواهی نهفت"
  },
  {
    "poem_id": 1401,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت سیندخت هدیه کجاست"
  },
  {
    "poem_id": 1401,
    "vorder": 40,
    "position": 1,
    "text": "اگر دیدن آفتابت هواست"
  },
  {
    "poem_id": 1401,
    "vorder": 41,
    "position": 0,
    "text": "چنین داد پاسخ به سیندخت سام"
  },
  {
    "poem_id": 1401,
    "vorder": 42,
    "position": 1,
    "text": "که ازمن بخواه آنچه آیدت کام"
  },
  {
    "poem_id": 1401,
    "vorder": 43,
    "position": 0,
    "text": "برفتند تا خانهٔ زرنگار"
  },
  {
    "poem_id": 1401,
    "vorder": 44,
    "position": 1,
    "text": "کجا اندرو بود خرم بهار"
  },
  {
    "poem_id": 1401,
    "vorder": 45,
    "position": 0,
    "text": "نگه کرد سام اندران ماه روی"
  },
  {
    "poem_id": 1401,
    "vorder": 46,
    "position": 1,
    "text": "یکایک شگفتی بماند اندروی"
  },
  {
    "poem_id": 1401,
    "vorder": 47,
    "position": 0,
    "text": "ندانست کش چون ستاید همی"
  },
  {
    "poem_id": 1401,
    "vorder": 48,
    "position": 1,
    "text": "برو چشم را چون گشاید همی"
  },
  {
    "poem_id": 1401,
    "vorder": 49,
    "position": 0,
    "text": "بفرمود تا رفت مهراب پیش"
  },
  {
    "poem_id": 1401,
    "vorder": 50,
    "position": 1,
    "text": "ببستند عقدی برآیین و کیش"
  },
  {
    "poem_id": 1401,
    "vorder": 51,
    "position": 0,
    "text": "به یک تختشان شاد بنشاندند"
  },
  {
    "poem_id": 1401,
    "vorder": 52,
    "position": 1,
    "text": "عقیق و زبرجد برافشاندند"
  },
  {
    "poem_id": 1401,
    "vorder": 53,
    "position": 0,
    "text": "سر ماه با افسر نام دار"
  },
  {
    "poem_id": 1401,
    "vorder": 54,
    "position": 1,
    "text": "سر شاه با تاج گوهرنگار"
  },
  {
    "poem_id": 1401,
    "vorder": 55,
    "position": 0,
    "text": "بیاورد پس دفتر خواسته"
  },
  {
    "poem_id": 1401,
    "vorder": 56,
    "position": 1,
    "text": "یکی نسخت گنج آراسته"
  },
  {
    "poem_id": 1401,
    "vorder": 57,
    "position": 0,
    "text": "برو خواند از گنجها هر چه بود"
  },
  {
    "poem_id": 1401,
    "vorder": 58,
    "position": 1,
    "text": "که گوش آن نیارست گفتی شنود"
  },
  {
    "poem_id": 1401,
    "vorder": 59,
    "position": 0,
    "text": "برفتند از آنجا به جای نشست"
  },
  {
    "poem_id": 1401,
    "vorder": 60,
    "position": 1,
    "text": "ببودند یک هفته با می به دست"
  },
  {
    "poem_id": 1401,
    "vorder": 61,
    "position": 0,
    "text": "وز ایوان سوی باغ رفتند باز"
  },
  {
    "poem_id": 1401,
    "vorder": 62,
    "position": 1,
    "text": "سه هفته به شادی گرفتند ساز"
  },
  {
    "poem_id": 1401,
    "vorder": 63,
    "position": 0,
    "text": "بزرگان کشورش با دست بند"
  },
  {
    "poem_id": 1401,
    "vorder": 64,
    "position": 1,
    "text": "کشیدند بر پیش کاخ بلند"
  },
  {
    "poem_id": 1401,
    "vorder": 65,
    "position": 0,
    "text": "سر ماه سام نریمان برفت"
  },
  {
    "poem_id": 1401,
    "vorder": 66,
    "position": 1,
    "text": "سوی سیستان روی بنهاد تفت"
  },
  {
    "poem_id": 1401,
    "vorder": 67,
    "position": 0,
    "text": "ابا زال و با لشکر و پیل و کوس"
  },
  {
    "poem_id": 1401,
    "vorder": 68,
    "position": 1,
    "text": "زمانه رکاب ورا داد بوس"
  },
  {
    "poem_id": 1401,
    "vorder": 69,
    "position": 0,
    "text": "عماری و بالای و هودج بساخت"
  },
  {
    "poem_id": 1401,
    "vorder": 70,
    "position": 1,
    "text": "یکی مهد تا ماه را در نشاخت"
  },
  {
    "poem_id": 1401,
    "vorder": 71,
    "position": 0,
    "text": "چو سیندخت و مهراب و پیوند خویش"
  },
  {
    "poem_id": 1401,
    "vorder": 72,
    "position": 1,
    "text": "سوی سیستان روی کردند پیش"
  },
  {
    "poem_id": 1401,
    "vorder": 73,
    "position": 0,
    "text": "برفتند شادان دل و خوش منش"
  },
  {
    "poem_id": 1401,
    "vorder": 74,
    "position": 1,
    "text": "پر از آفرین لب ز نیکی کنش"
  },
  {
    "poem_id": 1401,
    "vorder": 75,
    "position": 0,
    "text": "رسیدند پیروز تا نیمروز"
  },
  {
    "poem_id": 1401,
    "vorder": 76,
    "position": 1,
    "text": "چنان شاد و خندان و گیتی فروز"
  },
  {
    "poem_id": 1401,
    "vorder": 77,
    "position": 0,
    "text": "یکی بزم سام آنگهی ساز کرد"
  },
  {
    "poem_id": 1401,
    "vorder": 78,
    "position": 1,
    "text": "سه روز اندران بزم بگماز کرد"
  },
  {
    "poem_id": 1401,
    "vorder": 79,
    "position": 0,
    "text": "پس آنگاه سیندخت آنجا بماند"
  },
  {
    "poem_id": 1401,
    "vorder": 80,
    "position": 1,
    "text": "خود و لشکرش سوی کابل براند"
  },
  {
    "poem_id": 1401,
    "vorder": 81,
    "position": 0,
    "text": "سپرد آن زمان پادشاهی به زال"
  },
  {
    "poem_id": 1401,
    "vorder": 82,
    "position": 1,
    "text": "برون برد لشکر به فرخنده فال"
  },
  {
    "poem_id": 1401,
    "vorder": 83,
    "position": 0,
    "text": "سوی گرگساران شد و باختر"
  },
  {
    "poem_id": 1401,
    "vorder": 84,
    "position": 1,
    "text": "درفش خجسته برافراخت سر"
  },
  {
    "poem_id": 1401,
    "vorder": 85,
    "position": 0,
    "text": "شوم گفت کان پادشاهی مراست"
  },
  {
    "poem_id": 1401,
    "vorder": 86,
    "position": 1,
    "text": "دل و دیده با ما ندارند راست"
  },
  {
    "poem_id": 1401,
    "vorder": 87,
    "position": 0,
    "text": "منوچهر منشور آن شهر بر"
  },
  {
    "poem_id": 1401,
    "vorder": 88,
    "position": 1,
    "text": "مرا داد و گفتا همی دار و خوار"
  },
  {
    "poem_id": 1401,
    "vorder": 89,
    "position": 0,
    "text": "بترسم ز آشوب بد گوهران"
  },
  {
    "poem_id": 1401,
    "vorder": 90,
    "position": 1,
    "text": "به ویژه ز گردان مازنداران"
  },
  {
    "poem_id": 1401,
    "vorder": 91,
    "position": 0,
    "text": "بشد سام یکزخم و بنشست زال"
  },
  {
    "poem_id": 1401,
    "vorder": 92,
    "position": 1,
    "text": "می و مجلس آراست و بفراخت یال"
  }
]