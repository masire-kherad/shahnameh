[
  {
    "poem_id": 1930,
    "vorder": 1,
    "position": 0,
    "text": "دبیر جهاندیده را پیش خواند"
  },
  {
    "poem_id": 1930,
    "vorder": 2,
    "position": 1,
    "text": "دل آگنده بودش همه برفشاند"
  },
  {
    "poem_id": 1930,
    "vorder": 3,
    "position": 0,
    "text": "جهاندار چون کرد آهنگ مرو"
  },
  {
    "poem_id": 1930,
    "vorder": 4,
    "position": 1,
    "text": "به ماهوی سوری کنارنگ مرو"
  },
  {
    "poem_id": 1930,
    "vorder": 5,
    "position": 0,
    "text": "یکی نامه بنوشت با درد و خشم"
  },
  {
    "poem_id": 1930,
    "vorder": 6,
    "position": 1,
    "text": "پر از آرزو دل پر از آب چشم"
  },
  {
    "poem_id": 1930,
    "vorder": 7,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1930,
    "vorder": 8,
    "position": 1,
    "text": "خداوند دانا و پروردگار"
  },
  {
    "poem_id": 1930,
    "vorder": 9,
    "position": 0,
    "text": "خداوند گردنده بهرام و هور"
  },
  {
    "poem_id": 1930,
    "vorder": 10,
    "position": 1,
    "text": "خداوند پیل و خداوند مور"
  },
  {
    "poem_id": 1930,
    "vorder": 11,
    "position": 0,
    "text": "کند چون بخواهد ز ناچیز چیز"
  },
  {
    "poem_id": 1930,
    "vorder": 12,
    "position": 1,
    "text": "که آموزگارش نباید به نیز"
  },
  {
    "poem_id": 1930,
    "vorder": 13,
    "position": 0,
    "text": "بگفت آنک ما را چه آمد بروی"
  },
  {
    "poem_id": 1930,
    "vorder": 14,
    "position": 1,
    "text": "وزین پادشاهی بشد رنگ و بوی"
  },
  {
    "poem_id": 1930,
    "vorder": 15,
    "position": 0,
    "text": "ز رستم کجا کشته شد روز جنگ"
  },
  {
    "poem_id": 1930,
    "vorder": 16,
    "position": 1,
    "text": "ز تیمار بر ما جهان گشت تنگ"
  },
  {
    "poem_id": 1930,
    "vorder": 17,
    "position": 0,
    "text": "بدست یکی سعد وقاص نام"
  },
  {
    "poem_id": 1930,
    "vorder": 18,
    "position": 1,
    "text": "نه بوم و نژاد و نه دانش نه کام"
  },
  {
    "poem_id": 1930,
    "vorder": 19,
    "position": 0,
    "text": "کنون تا در طیسفون لشکرست"
  },
  {
    "poem_id": 1930,
    "vorder": 20,
    "position": 1,
    "text": "همین زاغ پیسه به پیش اندرست"
  },
  {
    "poem_id": 1930,
    "vorder": 21,
    "position": 0,
    "text": "تو با لشکرت رزم را ساز کن"
  },
  {
    "poem_id": 1930,
    "vorder": 22,
    "position": 1,
    "text": "سپه را برین بر هم آواز کن"
  },
  {
    "poem_id": 1930,
    "vorder": 23,
    "position": 0,
    "text": "من اینک پس نامه بر سانِ باد"
  },
  {
    "poem_id": 1930,
    "vorder": 24,
    "position": 1,
    "text": "بیایم به نزد تو ای پاک و راد"
  },
  {
    "poem_id": 1930,
    "vorder": 25,
    "position": 0,
    "text": "فرستادهٔ دیگر از انجمن"
  },
  {
    "poem_id": 1930,
    "vorder": 26,
    "position": 1,
    "text": "گزین کرد بینا‌دل و رای‌زن"
  }
]