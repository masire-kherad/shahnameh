[
  {
    "poem_id": 1533,
    "vorder": 1,
    "position": 0,
    "text": "همان چون بگفت این سخن شهریار"
  },
  {
    "poem_id": 1533,
    "vorder": 2,
    "position": 1,
    "text": "زریر سپهدار و اسفندیار"
  },
  {
    "poem_id": 1533,
    "vorder": 3,
    "position": 0,
    "text": "کشیدند شمشیر و گفتند اگر"
  },
  {
    "poem_id": 1533,
    "vorder": 4,
    "position": 1,
    "text": "کسی باشد اندر جهان سربسر"
  },
  {
    "poem_id": 1533,
    "vorder": 5,
    "position": 0,
    "text": "که نپسندد او را به دین‌آوری"
  },
  {
    "poem_id": 1533,
    "vorder": 6,
    "position": 1,
    "text": "سر اندر نیارد به فرمانبری"
  },
  {
    "poem_id": 1533,
    "vorder": 7,
    "position": 0,
    "text": "نیاید بدرگاه فرخنده شاه"
  },
  {
    "poem_id": 1533,
    "vorder": 8,
    "position": 1,
    "text": "نبندد میان پیش رخشنده گاه"
  },
  {
    "poem_id": 1533,
    "vorder": 9,
    "position": 0,
    "text": "نگیرد ازو راه و دین بهی"
  },
  {
    "poem_id": 1533,
    "vorder": 10,
    "position": 1,
    "text": "مرین دین به را نباشد رهی"
  },
  {
    "poem_id": 1533,
    "vorder": 11,
    "position": 0,
    "text": "به شمشیر جان از تنش بر کنیم"
  },
  {
    "poem_id": 1533,
    "vorder": 12,
    "position": 1,
    "text": "سرش را به دار برین بر کنیم"
  },
  {
    "poem_id": 1533,
    "vorder": 13,
    "position": 0,
    "text": "سپهدار ایران که نامش زریر"
  },
  {
    "poem_id": 1533,
    "vorder": 14,
    "position": 1,
    "text": "نبرده دلیری چو درنده شیر"
  },
  {
    "poem_id": 1533,
    "vorder": 15,
    "position": 0,
    "text": "به شاه جهان گفت آزاده‌وار"
  },
  {
    "poem_id": 1533,
    "vorder": 16,
    "position": 1,
    "text": "که دستور باشد مرا شهریار"
  },
  {
    "poem_id": 1533,
    "vorder": 17,
    "position": 0,
    "text": "که پاسخ کنم جادو ارجاسپ را"
  },
  {
    "poem_id": 1533,
    "vorder": 18,
    "position": 1,
    "text": "پسند آمد این شاه گشتاسپ را"
  },
  {
    "poem_id": 1533,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت برخیز و پاسخ کنش"
  },
  {
    "poem_id": 1533,
    "vorder": 20,
    "position": 1,
    "text": "نکال تگینان خلخ کنش"
  },
  {
    "poem_id": 1533,
    "vorder": 21,
    "position": 0,
    "text": "زریر گرانمایه و اسفندیار"
  },
  {
    "poem_id": 1533,
    "vorder": 22,
    "position": 1,
    "text": "چو جاماسپ دستور ناباک‌دار"
  },
  {
    "poem_id": 1533,
    "vorder": 23,
    "position": 0,
    "text": "ز پیشش برفتند هر سه به هم"
  },
  {
    "poem_id": 1533,
    "vorder": 24,
    "position": 1,
    "text": "شده سر پر از کین و دلها دژم"
  },
  {
    "poem_id": 1533,
    "vorder": 25,
    "position": 0,
    "text": "نوشتند نامه به ارجاسپ زشت"
  },
  {
    "poem_id": 1533,
    "vorder": 26,
    "position": 1,
    "text": "هم اندر خور آن کجا او نوشت"
  },
  {
    "poem_id": 1533,
    "vorder": 27,
    "position": 0,
    "text": "زریر سپهبد گرفتش به دست"
  },
  {
    "poem_id": 1533,
    "vorder": 28,
    "position": 1,
    "text": "چنان هم گشاده ببردش نبست"
  },
  {
    "poem_id": 1533,
    "vorder": 29,
    "position": 0,
    "text": "سوی شاه برد و برو بر بخواند"
  },
  {
    "poem_id": 1533,
    "vorder": 30,
    "position": 1,
    "text": "جهانجوی گشتاسپ خیره بماند"
  },
  {
    "poem_id": 1533,
    "vorder": 31,
    "position": 0,
    "text": "ز دانا سپهبد زریر سوار"
  },
  {
    "poem_id": 1533,
    "vorder": 32,
    "position": 1,
    "text": "ز جاماسپ و ز فرخ اسفندیار"
  },
  {
    "poem_id": 1533,
    "vorder": 33,
    "position": 0,
    "text": "ببست و نوشت اندرو نام خویش"
  },
  {
    "poem_id": 1533,
    "vorder": 34,
    "position": 1,
    "text": "فرستادگان را همه خواند پیش"
  },
  {
    "poem_id": 1533,
    "vorder": 35,
    "position": 0,
    "text": "بگیرید گفت این و زی او برید"
  },
  {
    "poem_id": 1533,
    "vorder": 36,
    "position": 1,
    "text": "نگر زین سپس راه را نسپرید"
  },
  {
    "poem_id": 1533,
    "vorder": 37,
    "position": 0,
    "text": "که گر نیستی اندر استا و زند"
  },
  {
    "poem_id": 1533,
    "vorder": 38,
    "position": 1,
    "text": "فرستاده را زینهار از گزند"
  },
  {
    "poem_id": 1533,
    "vorder": 39,
    "position": 0,
    "text": "ازین خواب بیدارتان کردمی"
  },
  {
    "poem_id": 1533,
    "vorder": 40,
    "position": 1,
    "text": "همان زنده بر دارتان کردمی"
  },
  {
    "poem_id": 1533,
    "vorder": 41,
    "position": 0,
    "text": "چنین تا بدانستی آن گرگسار"
  },
  {
    "poem_id": 1533,
    "vorder": 42,
    "position": 1,
    "text": "که گردن نیازد ابا شهریار"
  },
  {
    "poem_id": 1533,
    "vorder": 43,
    "position": 0,
    "text": "بینداخت نامه بگفتا روید"
  },
  {
    "poem_id": 1533,
    "vorder": 44,
    "position": 1,
    "text": "مرین را سوی ترک جادو برید"
  },
  {
    "poem_id": 1533,
    "vorder": 45,
    "position": 0,
    "text": "بگویید هوشت فراز آمدست"
  },
  {
    "poem_id": 1533,
    "vorder": 46,
    "position": 1,
    "text": "به خون و به خاکت نیاز آمدست"
  },
  {
    "poem_id": 1533,
    "vorder": 47,
    "position": 0,
    "text": "زده باد گردنت خسته میان"
  },
  {
    "poem_id": 1533,
    "vorder": 48,
    "position": 1,
    "text": "به خاک اندرون ریخته استخوان"
  },
  {
    "poem_id": 1533,
    "vorder": 49,
    "position": 0,
    "text": "درین ماه ار ایدونک خواهد خدای"
  },
  {
    "poem_id": 1533,
    "vorder": 50,
    "position": 1,
    "text": "بپوشم به رزم آهنینه قبای"
  },
  {
    "poem_id": 1533,
    "vorder": 51,
    "position": 0,
    "text": "به توران زمین اندر آرم سپاه"
  },
  {
    "poem_id": 1533,
    "vorder": 52,
    "position": 1,
    "text": "کنم کشور گرگساران تباه"
  }
]