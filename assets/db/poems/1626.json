[
  {
    "poem_id": 1626,
    "vorder": 1,
    "position": 0,
    "text": "کنون آفرین جهان‌آفرین"
  },
  {
    "poem_id": 1626,
    "vorder": 2,
    "position": 1,
    "text": "بخوانیم بر شهریار زمین"
  },
  {
    "poem_id": 1626,
    "vorder": 3,
    "position": 0,
    "text": "ابوالقاسم آن شاه خورشید چهر"
  },
  {
    "poem_id": 1626,
    "vorder": 4,
    "position": 1,
    "text": "بیاراست گیتی به داد و به مهر"
  },
  {
    "poem_id": 1626,
    "vorder": 5,
    "position": 0,
    "text": "نجوید جز از خوبی و راستی"
  },
  {
    "poem_id": 1626,
    "vorder": 6,
    "position": 1,
    "text": "نیارد بداد اندرون کاستی"
  },
  {
    "poem_id": 1626,
    "vorder": 7,
    "position": 0,
    "text": "جهان روشن از تاج محمود باد"
  },
  {
    "poem_id": 1626,
    "vorder": 8,
    "position": 1,
    "text": "همه روزگارانش مسعود باد"
  },
  {
    "poem_id": 1626,
    "vorder": 9,
    "position": 0,
    "text": "همیشه جوان تا جوانی بود"
  },
  {
    "poem_id": 1626,
    "vorder": 10,
    "position": 1,
    "text": "همان زنده تا زندگانی بود"
  },
  {
    "poem_id": 1626,
    "vorder": 11,
    "position": 0,
    "text": "چه گفت آن سراینده دهقان پیر"
  },
  {
    "poem_id": 1626,
    "vorder": 12,
    "position": 1,
    "text": "ز گشتاسپ وز نامدار اردشیر"
  },
  {
    "poem_id": 1626,
    "vorder": 13,
    "position": 0,
    "text": "وزان نامداران پاکیزه‌رای"
  },
  {
    "poem_id": 1626,
    "vorder": 14,
    "position": 1,
    "text": "ز داراب وز رسم و رای همای"
  },
  {
    "poem_id": 1626,
    "vorder": 15,
    "position": 0,
    "text": "چو دارا به تخت مهی برنشست"
  },
  {
    "poem_id": 1626,
    "vorder": 16,
    "position": 1,
    "text": "کمر بر میان بست و بگشاد دست"
  },
  {
    "poem_id": 1626,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت با موبدان و ردان"
  },
  {
    "poem_id": 1626,
    "vorder": 18,
    "position": 1,
    "text": "بزرگان و بیداردل بخردان"
  },
  {
    "poem_id": 1626,
    "vorder": 19,
    "position": 0,
    "text": "که گیتی نجستم به رنج و به داد"
  },
  {
    "poem_id": 1626,
    "vorder": 20,
    "position": 1,
    "text": "مرا تاج یزدان به سر بر نهاد"
  },
  {
    "poem_id": 1626,
    "vorder": 21,
    "position": 0,
    "text": "شگفتی‌تر از کار من در جهان"
  },
  {
    "poem_id": 1626,
    "vorder": 22,
    "position": 1,
    "text": "نبیند کسی آشکار و نهان"
  },
  {
    "poem_id": 1626,
    "vorder": 23,
    "position": 0,
    "text": "ندانیم جز داد پاداش این"
  },
  {
    "poem_id": 1626,
    "vorder": 24,
    "position": 1,
    "text": "که بر ما پس از ما کنند آفرین"
  },
  {
    "poem_id": 1626,
    "vorder": 25,
    "position": 0,
    "text": "نباید که پیچد کس از رنج ما"
  },
  {
    "poem_id": 1626,
    "vorder": 26,
    "position": 1,
    "text": "ز بیشی و آگندن گنج ما"
  },
  {
    "poem_id": 1626,
    "vorder": 27,
    "position": 0,
    "text": "زمانه ز داد من آباد باد"
  },
  {
    "poem_id": 1626,
    "vorder": 28,
    "position": 1,
    "text": "دل زیر دستان ما شاد باد"
  },
  {
    "poem_id": 1626,
    "vorder": 29,
    "position": 0,
    "text": "ازان پس ز هندوستان و ز روم"
  },
  {
    "poem_id": 1626,
    "vorder": 30,
    "position": 1,
    "text": "ز هر مرز باارز و آباد بوم"
  },
  {
    "poem_id": 1626,
    "vorder": 31,
    "position": 0,
    "text": "برفتند با هدیه و با نثار"
  },
  {
    "poem_id": 1626,
    "vorder": 32,
    "position": 1,
    "text": "بجستند خشنودی شهریار"
  },
  {
    "poem_id": 1626,
    "vorder": 33,
    "position": 0,
    "text": "چنان بد که روزی ز بهر گله"
  },
  {
    "poem_id": 1626,
    "vorder": 34,
    "position": 1,
    "text": "بیامد که اسپان ببیند یله"
  },
  {
    "poem_id": 1626,
    "vorder": 35,
    "position": 0,
    "text": "ز پستی برآمد به کوهی رسید"
  },
  {
    "poem_id": 1626,
    "vorder": 36,
    "position": 1,
    "text": "یکی بی‌کران ژرف دریا بدید"
  },
  {
    "poem_id": 1626,
    "vorder": 37,
    "position": 0,
    "text": "بفرمود کز روم و وز هندوان"
  },
  {
    "poem_id": 1626,
    "vorder": 38,
    "position": 1,
    "text": "بیارند کارآزموده گوان"
  },
  {
    "poem_id": 1626,
    "vorder": 39,
    "position": 0,
    "text": "بجویند زان آب دریا دری"
  },
  {
    "poem_id": 1626,
    "vorder": 40,
    "position": 1,
    "text": "رسانند رودی به هر کشوری"
  },
  {
    "poem_id": 1626,
    "vorder": 41,
    "position": 0,
    "text": "چو بگشاد داننده از آب بند"
  },
  {
    "poem_id": 1626,
    "vorder": 42,
    "position": 1,
    "text": "یکی شهر فرمود بس سودمند"
  },
  {
    "poem_id": 1626,
    "vorder": 43,
    "position": 0,
    "text": "چو دیوار شهر اندرآورد گرد"
  },
  {
    "poem_id": 1626,
    "vorder": 44,
    "position": 1,
    "text": "ورا نام کردند داراب گرد"
  },
  {
    "poem_id": 1626,
    "vorder": 45,
    "position": 0,
    "text": "یکی آتش افروخت از تیغ کوه"
  },
  {
    "poem_id": 1626,
    "vorder": 46,
    "position": 1,
    "text": "پرستندهٔ آذر آمد گروه"
  },
  {
    "poem_id": 1626,
    "vorder": 47,
    "position": 0,
    "text": "ز هر پیشه‌ای کارگر خواستند"
  },
  {
    "poem_id": 1626,
    "vorder": 48,
    "position": 1,
    "text": "همی شهر ایران بیاراستند"
  },
  {
    "poem_id": 1626,
    "vorder": 49,
    "position": 0,
    "text": "به هر سو فرستاد بی‌مر سپاه"
  },
  {
    "poem_id": 1626,
    "vorder": 50,
    "position": 1,
    "text": "ز دشمن همی داشت گیتی نگاه"
  },
  {
    "poem_id": 1626,
    "vorder": 51,
    "position": 0,
    "text": "جهان از بداندیش بی‌بیم کرد"
  },
  {
    "poem_id": 1626,
    "vorder": 52,
    "position": 1,
    "text": "دل بدسگالان بدو نیم کرد"
  }
]