[
  {
    "poem_id": 1531,
    "vorder": 1,
    "position": 0,
    "text": "برین ایستادند ترکان چین"
  },
  {
    "poem_id": 1531,
    "vorder": 2,
    "position": 1,
    "text": "دو تن نیز کردند زیشان گزین"
  },
  {
    "poem_id": 1531,
    "vorder": 3,
    "position": 0,
    "text": "یکی نام او بیدرفش بزرگ"
  },
  {
    "poem_id": 1531,
    "vorder": 4,
    "position": 1,
    "text": "گوی پیر و جادو ستنبه سترگ"
  },
  {
    "poem_id": 1531,
    "vorder": 5,
    "position": 0,
    "text": "دگر جادوی نام او نام خواست"
  },
  {
    "poem_id": 1531,
    "vorder": 6,
    "position": 1,
    "text": "که هرگز دلش جز تباهی نخواست"
  },
  {
    "poem_id": 1531,
    "vorder": 7,
    "position": 0,
    "text": "یکی نامه بنوشت خوب و هژیر"
  },
  {
    "poem_id": 1531,
    "vorder": 8,
    "position": 1,
    "text": "سوی نامور خسرو و دین پذیر"
  },
  {
    "poem_id": 1531,
    "vorder": 9,
    "position": 0,
    "text": "نوشتش به نام خدای جهان"
  },
  {
    "poem_id": 1531,
    "vorder": 10,
    "position": 1,
    "text": "شناسندهٔ آشکار و نهان"
  },
  {
    "poem_id": 1531,
    "vorder": 11,
    "position": 0,
    "text": "نوشتم یکی نامه‌ای شهریار"
  },
  {
    "poem_id": 1531,
    "vorder": 12,
    "position": 1,
    "text": "چنانچون بد اندر خور روزگار"
  },
  {
    "poem_id": 1531,
    "vorder": 13,
    "position": 0,
    "text": "سوی گرد گشتاسپ شاه زمین"
  },
  {
    "poem_id": 1531,
    "vorder": 14,
    "position": 1,
    "text": "سزاوار گاه کیان بافرین"
  },
  {
    "poem_id": 1531,
    "vorder": 15,
    "position": 0,
    "text": "گزین و مهین پور لهراسپ شاه"
  },
  {
    "poem_id": 1531,
    "vorder": 16,
    "position": 1,
    "text": "خداوند جیش و نگهدار گاه"
  },
  {
    "poem_id": 1531,
    "vorder": 17,
    "position": 0,
    "text": "ز ارجاسپ سالار گردان چین"
  },
  {
    "poem_id": 1531,
    "vorder": 18,
    "position": 1,
    "text": "سوار جهان‌دیده گرد زمین"
  },
  {
    "poem_id": 1531,
    "vorder": 19,
    "position": 0,
    "text": "نوشت اندران نامهٔ خسروی"
  },
  {
    "poem_id": 1531,
    "vorder": 20,
    "position": 1,
    "text": "نکو آفرینی خط یبغوی"
  },
  {
    "poem_id": 1531,
    "vorder": 21,
    "position": 0,
    "text": "که ای نامور شهریار جهان"
  },
  {
    "poem_id": 1531,
    "vorder": 22,
    "position": 1,
    "text": "فروزندهٔ تاج شاهنشهان"
  },
  {
    "poem_id": 1531,
    "vorder": 23,
    "position": 0,
    "text": "سرت سبز باد و تن و جان درست"
  },
  {
    "poem_id": 1531,
    "vorder": 24,
    "position": 1,
    "text": "مبادت کیانی کمرگاه سست"
  },
  {
    "poem_id": 1531,
    "vorder": 25,
    "position": 0,
    "text": "شنیدم که راهی گرفتی تباه"
  },
  {
    "poem_id": 1531,
    "vorder": 26,
    "position": 1,
    "text": "مرا روز روشن بکردی سیاه"
  },
  {
    "poem_id": 1531,
    "vorder": 27,
    "position": 0,
    "text": "بیامد یکی پیر مهتر فریب"
  },
  {
    "poem_id": 1531,
    "vorder": 28,
    "position": 1,
    "text": "ترا دل پر از بیم کرد و نهیب"
  },
  {
    "poem_id": 1531,
    "vorder": 29,
    "position": 0,
    "text": "سخن گفتش از دوزخ و از بهشت"
  },
  {
    "poem_id": 1531,
    "vorder": 30,
    "position": 1,
    "text": "به دلت اندرون هیچ شادی نهشت"
  },
  {
    "poem_id": 1531,
    "vorder": 31,
    "position": 0,
    "text": "تو او را پذیرفتی و دینش را"
  },
  {
    "poem_id": 1531,
    "vorder": 32,
    "position": 1,
    "text": "بیاراستی راه و آیینش را"
  },
  {
    "poem_id": 1531,
    "vorder": 33,
    "position": 0,
    "text": "برافگندی آیین شاهان خویش"
  },
  {
    "poem_id": 1531,
    "vorder": 34,
    "position": 1,
    "text": "بزرگان گیتی که بودند پیش"
  },
  {
    "poem_id": 1531,
    "vorder": 35,
    "position": 0,
    "text": "رها کردی آن پهلوی کیش را"
  },
  {
    "poem_id": 1531,
    "vorder": 36,
    "position": 1,
    "text": "چرا ننگریدی پس و پیش را"
  },
  {
    "poem_id": 1531,
    "vorder": 37,
    "position": 0,
    "text": "تو فرزند آنی که فرخنده شاه"
  },
  {
    "poem_id": 1531,
    "vorder": 38,
    "position": 1,
    "text": "بدو داد تاج از میان سپاه"
  },
  {
    "poem_id": 1531,
    "vorder": 39,
    "position": 0,
    "text": "ورا برگزید از گزینان خویش"
  },
  {
    "poem_id": 1531,
    "vorder": 40,
    "position": 1,
    "text": "ز جمشیدیان مر ترا داشت پیش"
  },
  {
    "poem_id": 1531,
    "vorder": 41,
    "position": 0,
    "text": "بران سان که کیخسرو کینه‌جوی"
  },
  {
    "poem_id": 1531,
    "vorder": 42,
    "position": 1,
    "text": "ترا بیش بود از کیان آبروی"
  },
  {
    "poem_id": 1531,
    "vorder": 43,
    "position": 0,
    "text": "بزرگی و شاهی و فرخندگی"
  },
  {
    "poem_id": 1531,
    "vorder": 44,
    "position": 1,
    "text": "توانایی و فر و زیبندگی"
  },
  {
    "poem_id": 1531,
    "vorder": 45,
    "position": 0,
    "text": "درفشان و پیلان آراسته"
  },
  {
    "poem_id": 1531,
    "vorder": 46,
    "position": 1,
    "text": "بسی لشکر و گنج و بس خواسته"
  },
  {
    "poem_id": 1531,
    "vorder": 47,
    "position": 0,
    "text": "همی بودت ای مهتر شهریار"
  },
  {
    "poem_id": 1531,
    "vorder": 48,
    "position": 1,
    "text": "همه مهتران مر ترا دوستدار"
  },
  {
    "poem_id": 1531,
    "vorder": 49,
    "position": 0,
    "text": "همی تافتی بر جهان یکسره"
  },
  {
    "poem_id": 1531,
    "vorder": 50,
    "position": 1,
    "text": "چو اردیبهشت آفتاب از بره"
  },
  {
    "poem_id": 1531,
    "vorder": 51,
    "position": 0,
    "text": "زگیتی ترا برگزیده خدای"
  },
  {
    "poem_id": 1531,
    "vorder": 52,
    "position": 1,
    "text": "مهانت همه پیش بوده به پای"
  },
  {
    "poem_id": 1531,
    "vorder": 53,
    "position": 0,
    "text": "نکردی خدای جهان را سپاس"
  },
  {
    "poem_id": 1531,
    "vorder": 54,
    "position": 1,
    "text": "نبودی بدین ره ورا حق شناس"
  },
  {
    "poem_id": 1531,
    "vorder": 55,
    "position": 0,
    "text": "ازان پس که ایزد ترا شاه کرد"
  },
  {
    "poem_id": 1531,
    "vorder": 56,
    "position": 1,
    "text": "یکی پیر جادوت بی راه کرد"
  },
  {
    "poem_id": 1531,
    "vorder": 57,
    "position": 0,
    "text": "چو آگاهی تو سوی من رسید"
  },
  {
    "poem_id": 1531,
    "vorder": 58,
    "position": 1,
    "text": "به روز سپیدم ستاره بدید"
  },
  {
    "poem_id": 1531,
    "vorder": 59,
    "position": 0,
    "text": "نوشتم یکی نامهٔ دوست وار"
  },
  {
    "poem_id": 1531,
    "vorder": 60,
    "position": 1,
    "text": "که هم دوست بودیم و هم نیک یار"
  },
  {
    "poem_id": 1531,
    "vorder": 61,
    "position": 0,
    "text": "چو نامه بخوانی سر و تن بشوی"
  },
  {
    "poem_id": 1531,
    "vorder": 62,
    "position": 1,
    "text": "فریبنده را نیز منمای روی"
  },
  {
    "poem_id": 1531,
    "vorder": 63,
    "position": 0,
    "text": "مران بند را از میان باز کن"
  },
  {
    "poem_id": 1531,
    "vorder": 64,
    "position": 1,
    "text": "به شادی می روشن آغاز کن"
  },
  {
    "poem_id": 1531,
    "vorder": 65,
    "position": 0,
    "text": "گرایدونک بپذیری از من تو پند"
  },
  {
    "poem_id": 1531,
    "vorder": 66,
    "position": 1,
    "text": "ز ترکان ترا نیز ناید گزند"
  },
  {
    "poem_id": 1531,
    "vorder": 67,
    "position": 0,
    "text": "زمین کشانی و ترکان چین"
  },
  {
    "poem_id": 1531,
    "vorder": 68,
    "position": 1,
    "text": "ترا باشد این همچو ایران زمین"
  },
  {
    "poem_id": 1531,
    "vorder": 69,
    "position": 0,
    "text": "به تو بخشم این بی‌کران گنجها"
  },
  {
    "poem_id": 1531,
    "vorder": 70,
    "position": 1,
    "text": "که آورده‌ام گرد با رنجها"
  },
  {
    "poem_id": 1531,
    "vorder": 71,
    "position": 0,
    "text": "نکورنگ اسپان با سیم و زر"
  },
  {
    "poem_id": 1531,
    "vorder": 72,
    "position": 1,
    "text": "به استامها در نشانده گهر"
  },
  {
    "poem_id": 1531,
    "vorder": 73,
    "position": 0,
    "text": "غلامان فرستمت با خواسته"
  },
  {
    "poem_id": 1531,
    "vorder": 74,
    "position": 1,
    "text": "نگاران با جعد آراسته"
  },
  {
    "poem_id": 1531,
    "vorder": 75,
    "position": 0,
    "text": "و ایدونک نپذیری این پند من"
  },
  {
    "poem_id": 1531,
    "vorder": 76,
    "position": 1,
    "text": "ببینی گران آهنین بند من"
  },
  {
    "poem_id": 1531,
    "vorder": 77,
    "position": 0,
    "text": "بیایم پس نامه تا چندگاه"
  },
  {
    "poem_id": 1531,
    "vorder": 78,
    "position": 1,
    "text": "کنم کشورت را سراسر تباه"
  },
  {
    "poem_id": 1531,
    "vorder": 79,
    "position": 0,
    "text": "سپاهی بیارم ز ترکان چین"
  },
  {
    "poem_id": 1531,
    "vorder": 80,
    "position": 1,
    "text": "که بنگاهشان بر نتابد زمین"
  },
  {
    "poem_id": 1531,
    "vorder": 81,
    "position": 0,
    "text": "بینبارم این رود جیحون به مشک"
  },
  {
    "poem_id": 1531,
    "vorder": 82,
    "position": 1,
    "text": "به مشک آب دریا کنم پاک خشک"
  },
  {
    "poem_id": 1531,
    "vorder": 83,
    "position": 0,
    "text": "بسوزم نگاریده کاخ ترا"
  },
  {
    "poem_id": 1531,
    "vorder": 84,
    "position": 1,
    "text": "ز بن برکنم بیخ و شاخ ترا"
  },
  {
    "poem_id": 1531,
    "vorder": 85,
    "position": 0,
    "text": "زمین را سراسر بسوزم همه"
  },
  {
    "poem_id": 1531,
    "vorder": 86,
    "position": 1,
    "text": "کتفتان به ناوک بدوزم همه"
  },
  {
    "poem_id": 1531,
    "vorder": 87,
    "position": 0,
    "text": "ز ایرانیان هرچ مردست پیر"
  },
  {
    "poem_id": 1531,
    "vorder": 88,
    "position": 1,
    "text": "کشان بنده کردن نباشد هژیر"
  },
  {
    "poem_id": 1531,
    "vorder": 89,
    "position": 0,
    "text": "ازیشان نیابی فزونی بها"
  },
  {
    "poem_id": 1531,
    "vorder": 90,
    "position": 1,
    "text": "کنمشان همه سر ز گردن جدا"
  },
  {
    "poem_id": 1531,
    "vorder": 91,
    "position": 0,
    "text": "زن و کودکانشان بیارم ز پیش"
  },
  {
    "poem_id": 1531,
    "vorder": 92,
    "position": 1,
    "text": "کنمشان همه بندهٔ شهر خویش"
  },
  {
    "poem_id": 1531,
    "vorder": 93,
    "position": 0,
    "text": "زمینشان همه پاک ویران کنم"
  },
  {
    "poem_id": 1531,
    "vorder": 94,
    "position": 1,
    "text": "درختانش از بیخ و بن برکنم"
  },
  {
    "poem_id": 1531,
    "vorder": 95,
    "position": 0,
    "text": "بگفتم همه گفتنی سر بسر"
  },
  {
    "poem_id": 1531,
    "vorder": 96,
    "position": 1,
    "text": "تو ژرف اندرین پند نامه نگر"
  }
]