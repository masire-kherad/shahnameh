[
  {
    "poem_id": 1847,
    "vorder": 1,
    "position": 0,
    "text": "چوروی زمین گشت خورشید فام"
  },
  {
    "poem_id": 1847,
    "vorder": 2,
    "position": 1,
    "text": "سخن گوی بندوی برشد ببام"
  },
  {
    "poem_id": 1847,
    "vorder": 3,
    "position": 0,
    "text": "ببهرام گفت ای جهاندیده مرد"
  },
  {
    "poem_id": 1847,
    "vorder": 4,
    "position": 1,
    "text": "برانگه که برخاست از دشت گرد"
  },
  {
    "poem_id": 1847,
    "vorder": 5,
    "position": 0,
    "text": "چو خسرو شما را بدید او برفت"
  },
  {
    "poem_id": 1847,
    "vorder": 6,
    "position": 1,
    "text": "سوی روم با لشکر خویش تفت"
  },
  {
    "poem_id": 1847,
    "vorder": 7,
    "position": 0,
    "text": "کنون گر تو پران شوی چون عقاب"
  },
  {
    "poem_id": 1847,
    "vorder": 8,
    "position": 1,
    "text": "وگر برتر آری سر از آفتاب"
  },
  {
    "poem_id": 1847,
    "vorder": 9,
    "position": 0,
    "text": "نبیند کسی شاه را جز بروم"
  },
  {
    "poem_id": 1847,
    "vorder": 10,
    "position": 1,
    "text": "که اکنون کهن شد بران مرز وبوم"
  },
  {
    "poem_id": 1847,
    "vorder": 11,
    "position": 0,
    "text": "کنون گر دهیدم به جان زینهار"
  },
  {
    "poem_id": 1847,
    "vorder": 12,
    "position": 1,
    "text": "بیایم بر پهلوان سوار"
  },
  {
    "poem_id": 1847,
    "vorder": 13,
    "position": 0,
    "text": "بگویم سخن هرچ پرسد زمن"
  },
  {
    "poem_id": 1847,
    "vorder": 14,
    "position": 1,
    "text": "ز کمی و بیشی آن انجمن"
  },
  {
    "poem_id": 1847,
    "vorder": 15,
    "position": 0,
    "text": "وگرنه بپوشم سلیح نبرد"
  },
  {
    "poem_id": 1847,
    "vorder": 16,
    "position": 1,
    "text": "به جنگ اندر آیم بکردار گرد"
  },
  {
    "poem_id": 1847,
    "vorder": 17,
    "position": 0,
    "text": "چو بهرام بشنید زو این سخن"
  },
  {
    "poem_id": 1847,
    "vorder": 18,
    "position": 1,
    "text": "دل مرد برنا شد از غم کهن"
  },
  {
    "poem_id": 1847,
    "vorder": 19,
    "position": 0,
    "text": "به یاران چنین گفت کاکنون چه سود"
  },
  {
    "poem_id": 1847,
    "vorder": 20,
    "position": 1,
    "text": "اگر من برآرم ز بندوی دود"
  },
  {
    "poem_id": 1847,
    "vorder": 21,
    "position": 0,
    "text": "همان به که او را برپهلوان"
  },
  {
    "poem_id": 1847,
    "vorder": 22,
    "position": 1,
    "text": "برم هم برین گونه روشن روان"
  },
  {
    "poem_id": 1847,
    "vorder": 23,
    "position": 0,
    "text": "بگوید بدو هرچ داند ز شاه"
  },
  {
    "poem_id": 1847,
    "vorder": 24,
    "position": 1,
    "text": "اگر سر دهد گر ستاند کلاه"
  },
  {
    "poem_id": 1847,
    "vorder": 25,
    "position": 0,
    "text": "به بندوی گفت ای بد چاره‌جوی"
  },
  {
    "poem_id": 1847,
    "vorder": 26,
    "position": 1,
    "text": "تو این داوریها ببهرام گوی"
  },
  {
    "poem_id": 1847,
    "vorder": 27,
    "position": 0,
    "text": "فرود آمد از بام بندوی شیر"
  },
  {
    "poem_id": 1847,
    "vorder": 28,
    "position": 1,
    "text": "همی‌راند با نامدار دلیر"
  },
  {
    "poem_id": 1847,
    "vorder": 29,
    "position": 0,
    "text": "چوبشنید بهرام کامد سپاه"
  },
  {
    "poem_id": 1847,
    "vorder": 30,
    "position": 1,
    "text": "سوی روم شد خسرو کینه خواه"
  },
  {
    "poem_id": 1847,
    "vorder": 31,
    "position": 0,
    "text": "زپور سیاوش بر آشفت سخت"
  },
  {
    "poem_id": 1847,
    "vorder": 32,
    "position": 1,
    "text": "بدو گفت کای بدرگ شوربخت"
  },
  {
    "poem_id": 1847,
    "vorder": 33,
    "position": 0,
    "text": "نه کار تو بود اینک فرمودمت"
  },
  {
    "poem_id": 1847,
    "vorder": 34,
    "position": 1,
    "text": "همی بی‌هنر خیره بستودمت"
  },
  {
    "poem_id": 1847,
    "vorder": 35,
    "position": 0,
    "text": "جهانجوی بندوی را پیش خواند"
  },
  {
    "poem_id": 1847,
    "vorder": 36,
    "position": 1,
    "text": "همی خشم بهرام با او براند"
  },
  {
    "poem_id": 1847,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت کای بدتن بدکنش"
  },
  {
    "poem_id": 1847,
    "vorder": 38,
    "position": 1,
    "text": "فریبنده مرد از در سرزنش"
  },
  {
    "poem_id": 1847,
    "vorder": 39,
    "position": 0,
    "text": "سپاه مرا خیره بفریفتی"
  },
  {
    "poem_id": 1847,
    "vorder": 40,
    "position": 1,
    "text": "زبد گوهر خویش نشکیفتی"
  },
  {
    "poem_id": 1847,
    "vorder": 41,
    "position": 0,
    "text": "تو با خسرو شوم گشتی یکی"
  },
  {
    "poem_id": 1847,
    "vorder": 42,
    "position": 1,
    "text": "جهاندیده‌ای کردی از کودکی"
  },
  {
    "poem_id": 1847,
    "vorder": 43,
    "position": 0,
    "text": "کنون آمدی با دلی پر سخن"
  },
  {
    "poem_id": 1847,
    "vorder": 44,
    "position": 1,
    "text": "که من نو کنم روزگار کهن"
  },
  {
    "poem_id": 1847,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت بندوی کای سرفراز"
  },
  {
    "poem_id": 1847,
    "vorder": 46,
    "position": 1,
    "text": "زمن راستی جوی و تندی مساز"
  },
  {
    "poem_id": 1847,
    "vorder": 47,
    "position": 0,
    "text": "بدان کان شهنشاه خویش منست"
  },
  {
    "poem_id": 1847,
    "vorder": 48,
    "position": 1,
    "text": "بزرگیش ورادیش پیش منست"
  },
  {
    "poem_id": 1847,
    "vorder": 49,
    "position": 0,
    "text": "فداکردمش جان وبایست کرد"
  },
  {
    "poem_id": 1847,
    "vorder": 50,
    "position": 1,
    "text": "تو گر مهتری گرد کژی مگرد"
  },
  {
    "poem_id": 1847,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت بهرام من زین گناه"
  },
  {
    "poem_id": 1847,
    "vorder": 52,
    "position": 1,
    "text": "که کردی نخواهمت کردن تباه"
  },
  {
    "poem_id": 1847,
    "vorder": 53,
    "position": 0,
    "text": "ولیکن تو هم کشته بر دست اوی"
  },
  {
    "poem_id": 1847,
    "vorder": 54,
    "position": 1,
    "text": "شوی زود و خوانی مرا راست گوی"
  },
  {
    "poem_id": 1847,
    "vorder": 55,
    "position": 0,
    "text": "نهادند بر پای بندوی بند"
  },
  {
    "poem_id": 1847,
    "vorder": 56,
    "position": 1,
    "text": "ببهرام دادش ز بهر گزند"
  },
  {
    "poem_id": 1847,
    "vorder": 57,
    "position": 0,
    "text": "همی‌بود تا خور شد اندر نهفت"
  },
  {
    "poem_id": 1847,
    "vorder": 58,
    "position": 1,
    "text": "بیامد پر اندیشه دل بخفت"
  }
]