[
  {
    "poem_id": 1391,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد به شاه بزرگ"
  },
  {
    "poem_id": 1391,
    "vorder": 2,
    "position": 1,
    "text": "ز مهراب و دستان سام سترگ"
  },
  {
    "poem_id": 1391,
    "vorder": 3,
    "position": 0,
    "text": "ز پیوند مهراب وز مهر زال"
  },
  {
    "poem_id": 1391,
    "vorder": 4,
    "position": 1,
    "text": "وزان ناهمالان گشته همال"
  },
  {
    "poem_id": 1391,
    "vorder": 5,
    "position": 0,
    "text": "سخن رفت هر گونه با موبدان"
  },
  {
    "poem_id": 1391,
    "vorder": 6,
    "position": 1,
    "text": "به پیش سرافراز شاه ردان"
  },
  {
    "poem_id": 1391,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت با بخردان شهریار"
  },
  {
    "poem_id": 1391,
    "vorder": 8,
    "position": 1,
    "text": "که بر ما شود زین دژم روزگار"
  },
  {
    "poem_id": 1391,
    "vorder": 9,
    "position": 0,
    "text": "چو ایران ز چنگال شیر و پلنگ"
  },
  {
    "poem_id": 1391,
    "vorder": 10,
    "position": 1,
    "text": "برون آوریدم به رای و به جنگ"
  },
  {
    "poem_id": 1391,
    "vorder": 11,
    "position": 0,
    "text": "فریدون ز ضحاک گیتی بشست"
  },
  {
    "poem_id": 1391,
    "vorder": 12,
    "position": 1,
    "text": "بترسم که آید ازان تخم رست"
  },
  {
    "poem_id": 1391,
    "vorder": 13,
    "position": 0,
    "text": "نباید که بر خیره از عشق زال"
  },
  {
    "poem_id": 1391,
    "vorder": 14,
    "position": 1,
    "text": "همال سرافگنده گردد همال"
  },
  {
    "poem_id": 1391,
    "vorder": 15,
    "position": 0,
    "text": "چو از دخت مهراب و از پور سام"
  },
  {
    "poem_id": 1391,
    "vorder": 16,
    "position": 1,
    "text": "برآید یکی تیغ تیز از نیام"
  },
  {
    "poem_id": 1391,
    "vorder": 17,
    "position": 0,
    "text": "اگر تاب گیرد سوی مادرش"
  },
  {
    "poem_id": 1391,
    "vorder": 18,
    "position": 1,
    "text": "ز گفت پراگنده گردد سرش"
  },
  {
    "poem_id": 1391,
    "vorder": 19,
    "position": 0,
    "text": "کند شهر ایران پر آشوب و رنج"
  },
  {
    "poem_id": 1391,
    "vorder": 20,
    "position": 1,
    "text": "بدو بازگردد مگر تاج و گنج"
  },
  {
    "poem_id": 1391,
    "vorder": 21,
    "position": 0,
    "text": "همه موبدان آفرین خواندند"
  },
  {
    "poem_id": 1391,
    "vorder": 22,
    "position": 1,
    "text": "ورا خسرو پاک‌دین خواندند"
  },
  {
    "poem_id": 1391,
    "vorder": 23,
    "position": 0,
    "text": "بگفتند کز ما تو داناتری"
  },
  {
    "poem_id": 1391,
    "vorder": 24,
    "position": 1,
    "text": "به بایستها بر تواناتری"
  },
  {
    "poem_id": 1391,
    "vorder": 25,
    "position": 0,
    "text": "همان کن کجا با خرد درخورد"
  },
  {
    "poem_id": 1391,
    "vorder": 26,
    "position": 1,
    "text": "دل اژدها را خرد بشکرد"
  },
  {
    "poem_id": 1391,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود تا نوذر آمدش پیش"
  },
  {
    "poem_id": 1391,
    "vorder": 28,
    "position": 1,
    "text": "ابا ویژگان و بزرگان خویش"
  },
  {
    "poem_id": 1391,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت رو پیش سام سوار"
  },
  {
    "poem_id": 1391,
    "vorder": 30,
    "position": 1,
    "text": "بپرسش که چون آمد از کارزار"
  },
  {
    "poem_id": 1391,
    "vorder": 31,
    "position": 0,
    "text": "چو دیدی بگویش کزین‌سو گرای"
  },
  {
    "poem_id": 1391,
    "vorder": 32,
    "position": 1,
    "text": "ز نزدیک ما کن سوی خانه رای"
  },
  {
    "poem_id": 1391,
    "vorder": 33,
    "position": 0,
    "text": "هم آنگاه برخاست فرزند شاه"
  },
  {
    "poem_id": 1391,
    "vorder": 34,
    "position": 1,
    "text": "ابا ویژگان سرنهاده به راه"
  },
  {
    "poem_id": 1391,
    "vorder": 35,
    "position": 0,
    "text": "سوی سام نیرم نهادند روی"
  },
  {
    "poem_id": 1391,
    "vorder": 36,
    "position": 1,
    "text": "ابا ژنده‌پیلان پرخاش‌جوی"
  },
  {
    "poem_id": 1391,
    "vorder": 37,
    "position": 0,
    "text": "چو زین کار سام یل آگاه شد"
  },
  {
    "poem_id": 1391,
    "vorder": 38,
    "position": 1,
    "text": "پذیره سوی پور کی شاه شد"
  },
  {
    "poem_id": 1391,
    "vorder": 39,
    "position": 0,
    "text": "ز پیش پدر نوذر نامدار"
  },
  {
    "poem_id": 1391,
    "vorder": 40,
    "position": 1,
    "text": "بیامد به نزدیک سام سوار"
  },
  {
    "poem_id": 1391,
    "vorder": 41,
    "position": 0,
    "text": "همه نامداران پذیره شدند"
  },
  {
    "poem_id": 1391,
    "vorder": 42,
    "position": 1,
    "text": "ابا ژنده‌پیل و تبیره شدند"
  },
  {
    "poem_id": 1391,
    "vorder": 43,
    "position": 0,
    "text": "رسیدند پس پیش سام سوار"
  },
  {
    "poem_id": 1391,
    "vorder": 44,
    "position": 1,
    "text": "بزرگان و کی نوذر نامدار"
  },
  {
    "poem_id": 1391,
    "vorder": 45,
    "position": 0,
    "text": "پیام پدر شاه نوذر بداد"
  },
  {
    "poem_id": 1391,
    "vorder": 46,
    "position": 1,
    "text": "به دیدار او سام یل گشت شاد"
  },
  {
    "poem_id": 1391,
    "vorder": 47,
    "position": 0,
    "text": "چنین داد پاسخ که فرمان کنم"
  },
  {
    "poem_id": 1391,
    "vorder": 48,
    "position": 1,
    "text": "ز دیدار او رامش جان کنم"
  },
  {
    "poem_id": 1391,
    "vorder": 49,
    "position": 0,
    "text": "نهادند خوان و گرفتند جام"
  },
  {
    "poem_id": 1391,
    "vorder": 50,
    "position": 1,
    "text": "نخست از منوچهر بردند نام"
  },
  {
    "poem_id": 1391,
    "vorder": 51,
    "position": 0,
    "text": "پس از نوذر و سام و هر مهتری"
  },
  {
    "poem_id": 1391,
    "vorder": 52,
    "position": 1,
    "text": "گرفتند شادی ز هر کشوری"
  },
  {
    "poem_id": 1391,
    "vorder": 53,
    "position": 0,
    "text": "به شادی درآمد شب دیریاز"
  },
  {
    "poem_id": 1391,
    "vorder": 54,
    "position": 1,
    "text": "چو خورشید رخشنده بگشاد راز"
  },
  {
    "poem_id": 1391,
    "vorder": 55,
    "position": 0,
    "text": "خروش تبیره برآمد ز در"
  },
  {
    "poem_id": 1391,
    "vorder": 56,
    "position": 1,
    "text": "هیون دلاور برآورد پر"
  },
  {
    "poem_id": 1391,
    "vorder": 57,
    "position": 0,
    "text": "سوی بارگاه منوچهر شاه"
  },
  {
    "poem_id": 1391,
    "vorder": 58,
    "position": 1,
    "text": "به فرمان او برگرفتند راه"
  },
  {
    "poem_id": 1391,
    "vorder": 59,
    "position": 0,
    "text": "منوچهر چون یافت زو آگهی"
  },
  {
    "poem_id": 1391,
    "vorder": 60,
    "position": 1,
    "text": "بیاراست دیهیم شاهنشهی"
  },
  {
    "poem_id": 1391,
    "vorder": 61,
    "position": 0,
    "text": "ز ساری و آمل برآمد خروش"
  },
  {
    "poem_id": 1391,
    "vorder": 62,
    "position": 1,
    "text": "چو دریای سبز اندر آمد به جوش"
  },
  {
    "poem_id": 1391,
    "vorder": 63,
    "position": 0,
    "text": "ببستند آیین ژوپین وران"
  },
  {
    "poem_id": 1391,
    "vorder": 64,
    "position": 1,
    "text": "برفتند با خشتهای گران"
  },
  {
    "poem_id": 1391,
    "vorder": 65,
    "position": 0,
    "text": "سپاهی که از کوه تا کوه مرد"
  },
  {
    "poem_id": 1391,
    "vorder": 66,
    "position": 1,
    "text": "سپر در سپر ساخته سرخ و زرد"
  },
  {
    "poem_id": 1391,
    "vorder": 67,
    "position": 0,
    "text": "ابا کوس و با نای رویین و سنج"
  },
  {
    "poem_id": 1391,
    "vorder": 68,
    "position": 1,
    "text": "ابا تازی اسپان و پیلان و گنج"
  },
  {
    "poem_id": 1391,
    "vorder": 69,
    "position": 0,
    "text": "ازین گونه لشکر پذیره شدند"
  },
  {
    "poem_id": 1391,
    "vorder": 70,
    "position": 1,
    "text": "بسی با درفش و تبیره شدند"
  },
  {
    "poem_id": 1391,
    "vorder": 71,
    "position": 0,
    "text": "چو آمد به نزدیکی بارگاه"
  },
  {
    "poem_id": 1391,
    "vorder": 72,
    "position": 1,
    "text": "پیاده شد و راه بگشاد شاه"
  },
  {
    "poem_id": 1391,
    "vorder": 73,
    "position": 0,
    "text": "چو شاه جهاندار بگشاد روی"
  },
  {
    "poem_id": 1391,
    "vorder": 74,
    "position": 1,
    "text": "زمین را ببوسید و شد پیش اوی"
  },
  {
    "poem_id": 1391,
    "vorder": 75,
    "position": 0,
    "text": "منوچهر برخاست از تخت عاج"
  },
  {
    "poem_id": 1391,
    "vorder": 76,
    "position": 1,
    "text": "ز یاقوت رخشنده بر سرش تاج"
  },
  {
    "poem_id": 1391,
    "vorder": 77,
    "position": 0,
    "text": "بر خویش بر تخت بنشاختش"
  },
  {
    "poem_id": 1391,
    "vorder": 78,
    "position": 1,
    "text": "چنان چون سزا بود بنواختش"
  },
  {
    "poem_id": 1391,
    "vorder": 79,
    "position": 0,
    "text": "وزان گرگ‌ساران جنگاور‌ان"
  },
  {
    "poem_id": 1391,
    "vorder": 80,
    "position": 1,
    "text": "وزان نره دیوان مازندران"
  },
  {
    "poem_id": 1391,
    "vorder": 81,
    "position": 0,
    "text": "بپرسید و بسیار تیمار خورد"
  },
  {
    "poem_id": 1391,
    "vorder": 82,
    "position": 1,
    "text": "سپهبد سخن یک به یک یاد کرد"
  },
  {
    "poem_id": 1391,
    "vorder": 83,
    "position": 0,
    "text": "که نوشه زی ای شاه تا جاودان"
  },
  {
    "poem_id": 1391,
    "vorder": 84,
    "position": 1,
    "text": "ز جان تو کوته بد بدگمان"
  },
  {
    "poem_id": 1391,
    "vorder": 85,
    "position": 0,
    "text": "برفتم بران شهر دیوان نر"
  },
  {
    "poem_id": 1391,
    "vorder": 86,
    "position": 1,
    "text": "نه دیوان که شیران جنگی به بر"
  },
  {
    "poem_id": 1391,
    "vorder": 87,
    "position": 0,
    "text": "که از تازی اسپان تکاور‌ترند"
  },
  {
    "poem_id": 1391,
    "vorder": 88,
    "position": 1,
    "text": "ز گردان ایران دلاور‌ترند"
  },
  {
    "poem_id": 1391,
    "vorder": 89,
    "position": 0,
    "text": "سپاهی که سگسار خوانندشان"
  },
  {
    "poem_id": 1391,
    "vorder": 90,
    "position": 1,
    "text": "پلنگان جنگی نمایندشان"
  },
  {
    "poem_id": 1391,
    "vorder": 91,
    "position": 0,
    "text": "ز من چون بدیشان رسید آگهی"
  },
  {
    "poem_id": 1391,
    "vorder": 92,
    "position": 1,
    "text": "از آواز من مغزشان شد تهی"
  },
  {
    "poem_id": 1391,
    "vorder": 93,
    "position": 0,
    "text": "به شهر اندرون نعره برداشتند"
  },
  {
    "poem_id": 1391,
    "vorder": 94,
    "position": 1,
    "text": "ازان پس همه شهر بگذاشتند"
  },
  {
    "poem_id": 1391,
    "vorder": 95,
    "position": 0,
    "text": "همه پیش من جنگ جوی آمدند"
  },
  {
    "poem_id": 1391,
    "vorder": 96,
    "position": 1,
    "text": "چنان خیره و پوی پوی آمدند"
  },
  {
    "poem_id": 1391,
    "vorder": 97,
    "position": 0,
    "text": "سپه جنب جنبان شد و روز تار"
  },
  {
    "poem_id": 1391,
    "vorder": 98,
    "position": 1,
    "text": "پس اندر فراز آمد و پیش غار"
  },
  {
    "poem_id": 1391,
    "vorder": 99,
    "position": 0,
    "text": "نبیره جهاندار سلم بزرگ"
  },
  {
    "poem_id": 1391,
    "vorder": 100,
    "position": 1,
    "text": "به پیش سپاه اندر آمد چو گرگ"
  },
  {
    "poem_id": 1391,
    "vorder": 101,
    "position": 0,
    "text": "سپاهی به کردار مور و ملخ"
  },
  {
    "poem_id": 1391,
    "vorder": 102,
    "position": 1,
    "text": "نبد دشت پیدا نه کوه و نه شخ"
  },
  {
    "poem_id": 1391,
    "vorder": 103,
    "position": 0,
    "text": "چو برخاست زان لشکر گشن گرد"
  },
  {
    "poem_id": 1391,
    "vorder": 104,
    "position": 1,
    "text": "رخ نامداران ما گشت زرد"
  },
  {
    "poem_id": 1391,
    "vorder": 105,
    "position": 0,
    "text": "من این گرز یک زخم برداشتم"
  },
  {
    "poem_id": 1391,
    "vorder": 106,
    "position": 1,
    "text": "سپه را هم آنجای بگذاشتم"
  },
  {
    "poem_id": 1391,
    "vorder": 107,
    "position": 0,
    "text": "خروشی خروشیدم از پشت زین"
  },
  {
    "poem_id": 1391,
    "vorder": 108,
    "position": 1,
    "text": "که چون آسیا شد بریشان زمین"
  },
  {
    "poem_id": 1391,
    "vorder": 109,
    "position": 0,
    "text": "دل آمد سپه را همه بازجای"
  },
  {
    "poem_id": 1391,
    "vorder": 110,
    "position": 1,
    "text": "سراسر سوی رزم کردند رای"
  },
  {
    "poem_id": 1391,
    "vorder": 111,
    "position": 0,
    "text": "چو بشنید کاکوی آواز من"
  },
  {
    "poem_id": 1391,
    "vorder": 112,
    "position": 1,
    "text": "چنان زخم سرباز کوپال من"
  },
  {
    "poem_id": 1391,
    "vorder": 113,
    "position": 0,
    "text": "بیامد به نزدیک من جنگ ساز"
  },
  {
    "poem_id": 1391,
    "vorder": 114,
    "position": 1,
    "text": "چو پیل ژیان با کمند دراز"
  },
  {
    "poem_id": 1391,
    "vorder": 115,
    "position": 0,
    "text": "مرا خواست کارد به خم کمند"
  },
  {
    "poem_id": 1391,
    "vorder": 116,
    "position": 1,
    "text": "چو دیدم خمیدم ز راه گزند"
  },
  {
    "poem_id": 1391,
    "vorder": 117,
    "position": 0,
    "text": "کمان کیانی گرفتم به چنگ"
  },
  {
    "poem_id": 1391,
    "vorder": 118,
    "position": 1,
    "text": "به پیکان پولاد و تیر خدنگ"
  },
  {
    "poem_id": 1391,
    "vorder": 119,
    "position": 0,
    "text": "عقاب تکاور برانگیختم"
  },
  {
    "poem_id": 1391,
    "vorder": 120,
    "position": 1,
    "text": "چو آتش بدو بر تبر ریختم"
  },
  {
    "poem_id": 1391,
    "vorder": 121,
    "position": 0,
    "text": "گمانم چنان بد که سندان سرش"
  },
  {
    "poem_id": 1391,
    "vorder": 122,
    "position": 1,
    "text": "که شد دوخته مغز تا مغفرش"
  },
  {
    "poem_id": 1391,
    "vorder": 123,
    "position": 0,
    "text": "نگه کردم از گرد چون پیل مست"
  },
  {
    "poem_id": 1391,
    "vorder": 124,
    "position": 1,
    "text": "برآمد یکی تیغ هندی به دست"
  },
  {
    "poem_id": 1391,
    "vorder": 125,
    "position": 0,
    "text": "چنان آمدم شهریارا گمان"
  },
  {
    "poem_id": 1391,
    "vorder": 126,
    "position": 1,
    "text": "کزو کوه زنهار خواهد بجان"
  },
  {
    "poem_id": 1391,
    "vorder": 127,
    "position": 0,
    "text": "وی اندر شتاب و من اندر درنگ"
  },
  {
    "poem_id": 1391,
    "vorder": 128,
    "position": 1,
    "text": "همی جستمش تا کی آید به چنگ"
  },
  {
    "poem_id": 1391,
    "vorder": 129,
    "position": 0,
    "text": "چو آمد به نزدیک من سرفراز"
  },
  {
    "poem_id": 1391,
    "vorder": 130,
    "position": 1,
    "text": "من از چرمه چنگال کردم دراز"
  },
  {
    "poem_id": 1391,
    "vorder": 131,
    "position": 0,
    "text": "گرفتم کمربند مرد دلیر"
  },
  {
    "poem_id": 1391,
    "vorder": 132,
    "position": 1,
    "text": "ز زین برگسستم بکردار شیر"
  },
  {
    "poem_id": 1391,
    "vorder": 133,
    "position": 0,
    "text": "زدم بر زمین بر چو پیل ژیان"
  },
  {
    "poem_id": 1391,
    "vorder": 134,
    "position": 1,
    "text": "بدین آهنین دست و گردی میان"
  },
  {
    "poem_id": 1391,
    "vorder": 135,
    "position": 0,
    "text": "چو افگنده شد شاه زین گونه خوار"
  },
  {
    "poem_id": 1391,
    "vorder": 136,
    "position": 1,
    "text": "سپه روی برگشت از کارزار"
  },
  {
    "poem_id": 1391,
    "vorder": 137,
    "position": 0,
    "text": "نشیب و فراز بیابان و کوه"
  },
  {
    "poem_id": 1391,
    "vorder": 138,
    "position": 1,
    "text": "به هر سو شده مردمان هم گروه"
  },
  {
    "poem_id": 1391,
    "vorder": 139,
    "position": 0,
    "text": "سوار و پیاده ده و دو هزار"
  },
  {
    "poem_id": 1391,
    "vorder": 140,
    "position": 1,
    "text": "فگنده پدید آمد اندر شمار"
  },
  {
    "poem_id": 1391,
    "vorder": 141,
    "position": 0,
    "text": "چو بشنید گفتار سالار شاه"
  },
  {
    "poem_id": 1391,
    "vorder": 142,
    "position": 1,
    "text": "برافراخت تا ماه فرخ کلاه"
  },
  {
    "poem_id": 1391,
    "vorder": 143,
    "position": 0,
    "text": "چو روز از شب آمد بکوشش ستوه"
  },
  {
    "poem_id": 1391,
    "vorder": 144,
    "position": 1,
    "text": "ستوهی گرفته فرو شد به کوه"
  },
  {
    "poem_id": 1391,
    "vorder": 145,
    "position": 0,
    "text": "می و مجلس آراست و شد شادمان"
  },
  {
    "poem_id": 1391,
    "vorder": 146,
    "position": 1,
    "text": "جهان پاک دید از بد بدگمان"
  },
  {
    "poem_id": 1391,
    "vorder": 147,
    "position": 0,
    "text": "به بگماز کوتاه کردند شب"
  },
  {
    "poem_id": 1391,
    "vorder": 148,
    "position": 1,
    "text": "به یاد سپهبد گشادند لب"
  },
  {
    "poem_id": 1391,
    "vorder": 149,
    "position": 0,
    "text": "چو شب روز شد پردهٔ بارگاه"
  },
  {
    "poem_id": 1391,
    "vorder": 150,
    "position": 1,
    "text": "گشادند و دادند زی شاه راه"
  },
  {
    "poem_id": 1391,
    "vorder": 151,
    "position": 0,
    "text": "بیامد سپهدار سام سترگ"
  },
  {
    "poem_id": 1391,
    "vorder": 152,
    "position": 1,
    "text": "به نزد منوچهر شاه بزرگ"
  },
  {
    "poem_id": 1391,
    "vorder": 153,
    "position": 0,
    "text": "چنین گفت با سام شاه جهان"
  },
  {
    "poem_id": 1391,
    "vorder": 154,
    "position": 1,
    "text": "کز ایدر برو با گزیده مهان"
  },
  {
    "poem_id": 1391,
    "vorder": 155,
    "position": 0,
    "text": "به هندوستان آتش اندر فروز"
  },
  {
    "poem_id": 1391,
    "vorder": 156,
    "position": 1,
    "text": "همه کاخ مهراب و کابل بسوز"
  },
  {
    "poem_id": 1391,
    "vorder": 157,
    "position": 0,
    "text": "نباید که او یابد از بد رها"
  },
  {
    "poem_id": 1391,
    "vorder": 158,
    "position": 1,
    "text": "که او ماند از بچهٔ اژدها"
  },
  {
    "poem_id": 1391,
    "vorder": 159,
    "position": 0,
    "text": "زمان تا زمان زو برآید خروش"
  },
  {
    "poem_id": 1391,
    "vorder": 160,
    "position": 1,
    "text": "شود رام گیتی پر از جنگ و جوش"
  },
  {
    "poem_id": 1391,
    "vorder": 161,
    "position": 0,
    "text": "هر آنکس که پیوستهٔ او بود"
  },
  {
    "poem_id": 1391,
    "vorder": 162,
    "position": 1,
    "text": "بزرگان که در دستهٔ او بود"
  },
  {
    "poem_id": 1391,
    "vorder": 163,
    "position": 0,
    "text": "سر از تن جدا کن زمین را بشوی"
  },
  {
    "poem_id": 1391,
    "vorder": 164,
    "position": 1,
    "text": "ز پیوند ضحاک و خویشان اوی"
  },
  {
    "poem_id": 1391,
    "vorder": 165,
    "position": 0,
    "text": "چنین داد پاسخ که ایدون کنم"
  },
  {
    "poem_id": 1391,
    "vorder": 166,
    "position": 1,
    "text": "که کین از دل شاه بیرون کنم"
  },
  {
    "poem_id": 1391,
    "vorder": 167,
    "position": 0,
    "text": "ببوسید تخت و بمالید روی"
  },
  {
    "poem_id": 1391,
    "vorder": 168,
    "position": 1,
    "text": "بران نامور مهر انگشت اوی"
  },
  {
    "poem_id": 1391,
    "vorder": 169,
    "position": 0,
    "text": "سوی خانه بنهاد سر با سپاه"
  },
  {
    "poem_id": 1391,
    "vorder": 170,
    "position": 1,
    "text": "بدان باد پایان جوینده راه"
  }
]