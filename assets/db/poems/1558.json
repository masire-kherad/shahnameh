[
  {
    "poem_id": 1558,
    "vorder": 1,
    "position": 0,
    "text": "برآمد بران تند بالا فراز"
  },
  {
    "poem_id": 1558,
    "vorder": 2,
    "position": 1,
    "text": "چو روی پدر دید بردش نماز"
  },
  {
    "poem_id": 1558,
    "vorder": 3,
    "position": 0,
    "text": "پدر داغ دل بود بر پای جست"
  },
  {
    "poem_id": 1558,
    "vorder": 4,
    "position": 1,
    "text": "ببوسید و بسترد رویش به دست"
  },
  {
    "poem_id": 1558,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت یزدان سپاس ای جوان"
  },
  {
    "poem_id": 1558,
    "vorder": 6,
    "position": 1,
    "text": "که دیدم ترا شاد و روشن‌روان"
  },
  {
    "poem_id": 1558,
    "vorder": 7,
    "position": 0,
    "text": "ز من در دل آزار و تندی مدار"
  },
  {
    "poem_id": 1558,
    "vorder": 8,
    "position": 1,
    "text": "به کین خواستن هیچ کندی مدار"
  },
  {
    "poem_id": 1558,
    "vorder": 9,
    "position": 0,
    "text": "گُرَزْم آن بداندیش بدخواه مرد"
  },
  {
    "poem_id": 1558,
    "vorder": 10,
    "position": 1,
    "text": "دل من ز فرزند خود تیره کرد"
  },
  {
    "poem_id": 1558,
    "vorder": 11,
    "position": 0,
    "text": "بد آید به مردم ز کردار بد"
  },
  {
    "poem_id": 1558,
    "vorder": 12,
    "position": 1,
    "text": "بد آید به روی بد از کار بد"
  },
  {
    "poem_id": 1558,
    "vorder": 13,
    "position": 0,
    "text": "پذیرفتم از کردگار جهان"
  },
  {
    "poem_id": 1558,
    "vorder": 14,
    "position": 1,
    "text": "شناسندهٔ آشکار و نهان"
  },
  {
    "poem_id": 1558,
    "vorder": 15,
    "position": 0,
    "text": "که چون من شوم شاد و پیروزبخت"
  },
  {
    "poem_id": 1558,
    "vorder": 16,
    "position": 1,
    "text": "سپارم ترا کشور و تاج و تخت"
  },
  {
    "poem_id": 1558,
    "vorder": 17,
    "position": 0,
    "text": "پرستش بهی برکنم زین جهان"
  },
  {
    "poem_id": 1558,
    "vorder": 18,
    "position": 1,
    "text": "سپارم ترا تاج و تخت مهان"
  },
  {
    "poem_id": 1558,
    "vorder": 19,
    "position": 0,
    "text": "چنین پاسخش داد اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 20,
    "position": 1,
    "text": "که خشنود بادا ز من شهریار"
  },
  {
    "poem_id": 1558,
    "vorder": 21,
    "position": 0,
    "text": "مرا آن بود تخت و تاج و سپاه"
  },
  {
    "poem_id": 1558,
    "vorder": 22,
    "position": 1,
    "text": "که خشنود باشد جهاندار شاه"
  },
  {
    "poem_id": 1558,
    "vorder": 23,
    "position": 0,
    "text": "جهاندار داند که بر دشت رزم"
  },
  {
    "poem_id": 1558,
    "vorder": 24,
    "position": 1,
    "text": "چو من دیدم افگنده روی گُرَزْم"
  },
  {
    "poem_id": 1558,
    "vorder": 25,
    "position": 0,
    "text": "بدان مرد بد گوی گریان شدم"
  },
  {
    "poem_id": 1558,
    "vorder": 26,
    "position": 1,
    "text": "ز درد دل شاه بریان شدم"
  },
  {
    "poem_id": 1558,
    "vorder": 27,
    "position": 0,
    "text": "کنون آنچ بد بود از ما گذشت"
  },
  {
    "poem_id": 1558,
    "vorder": 28,
    "position": 1,
    "text": "غم رفته نزدیک ما بادگشت"
  },
  {
    "poem_id": 1558,
    "vorder": 29,
    "position": 0,
    "text": "ازین پس چو من تیغ را برکشم"
  },
  {
    "poem_id": 1558,
    "vorder": 30,
    "position": 1,
    "text": "وزین کوه‌پایه سراندر کشم"
  },
  {
    "poem_id": 1558,
    "vorder": 31,
    "position": 0,
    "text": "نه ارجاسپ مانم نه خاقان چین"
  },
  {
    "poem_id": 1558,
    "vorder": 32,
    "position": 1,
    "text": "نه کهرم نه خلخ نه توران زمین"
  },
  {
    "poem_id": 1558,
    "vorder": 33,
    "position": 0,
    "text": "چو لشکر بدانست کاسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 34,
    "position": 1,
    "text": "ز بند گران رست و بد روزگار"
  },
  {
    "poem_id": 1558,
    "vorder": 35,
    "position": 0,
    "text": "برفتند یکسر گروها گروه"
  },
  {
    "poem_id": 1558,
    "vorder": 36,
    "position": 1,
    "text": "به پیش جهاندار بر تیغ کوه"
  },
  {
    "poem_id": 1558,
    "vorder": 37,
    "position": 0,
    "text": "بزرگان فزرانه و خویش اوی"
  },
  {
    "poem_id": 1558,
    "vorder": 38,
    "position": 1,
    "text": "نهادند سر بر زمین پیش اوی"
  },
  {
    "poem_id": 1558,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت نیک‌اختر اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 40,
    "position": 1,
    "text": "که ای نامداران خنجرگزار"
  },
  {
    "poem_id": 1558,
    "vorder": 41,
    "position": 0,
    "text": "همه تیغ زهرآبگون برکشید"
  },
  {
    "poem_id": 1558,
    "vorder": 42,
    "position": 1,
    "text": "یکایک درآیید و دشمن کشید"
  },
  {
    "poem_id": 1558,
    "vorder": 43,
    "position": 0,
    "text": "بزرگان برو خواندند آفرین"
  },
  {
    "poem_id": 1558,
    "vorder": 44,
    "position": 1,
    "text": "که ما را توی افسر و تیغ کین"
  },
  {
    "poem_id": 1558,
    "vorder": 45,
    "position": 0,
    "text": "همه پیش تو جان گروگان کنیم"
  },
  {
    "poem_id": 1558,
    "vorder": 46,
    "position": 1,
    "text": "به دیدار تو رامش جان کنیم"
  },
  {
    "poem_id": 1558,
    "vorder": 47,
    "position": 0,
    "text": "همه شب همی لشکر آراستند"
  },
  {
    "poem_id": 1558,
    "vorder": 48,
    "position": 1,
    "text": "همی جوشن و تیغ پیراستند"
  },
  {
    "poem_id": 1558,
    "vorder": 49,
    "position": 0,
    "text": "پدر نیز با فرخ اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 50,
    "position": 1,
    "text": "همی راز گفت از بد روزگار"
  },
  {
    "poem_id": 1558,
    "vorder": 51,
    "position": 0,
    "text": "ز خون جوانان پرخاشجوی"
  },
  {
    "poem_id": 1558,
    "vorder": 52,
    "position": 1,
    "text": "به رخ بر نهاد از دو دیده دو جوی"
  },
  {
    "poem_id": 1558,
    "vorder": 53,
    "position": 0,
    "text": "که بودند کشته بران رزمگاه"
  },
  {
    "poem_id": 1558,
    "vorder": 54,
    "position": 1,
    "text": "به سر بر ز خون و ز آهن کلاه"
  },
  {
    "poem_id": 1558,
    "vorder": 55,
    "position": 0,
    "text": "همان شب خبر نزد ارجاسپ شد"
  },
  {
    "poem_id": 1558,
    "vorder": 56,
    "position": 1,
    "text": "که فرزند نزدیک گشتاسپ شد"
  },
  {
    "poem_id": 1558,
    "vorder": 57,
    "position": 0,
    "text": "به ره بر فراوان طلایه بکشت"
  },
  {
    "poem_id": 1558,
    "vorder": 58,
    "position": 1,
    "text": "کسی کو نشد کشته بنمود پشت"
  },
  {
    "poem_id": 1558,
    "vorder": 59,
    "position": 0,
    "text": "غمی گشت و پرمایگان را بخواند"
  },
  {
    "poem_id": 1558,
    "vorder": 60,
    "position": 1,
    "text": "بسی پیش کهرم سخنها براند"
  },
  {
    "poem_id": 1558,
    "vorder": 61,
    "position": 0,
    "text": "که ما را جزین بود در جنگ رای"
  },
  {
    "poem_id": 1558,
    "vorder": 62,
    "position": 1,
    "text": "بدانگه که لشکر بیامد ز جای"
  },
  {
    "poem_id": 1558,
    "vorder": 63,
    "position": 0,
    "text": "همی گفتم آن دیو را گر به بند"
  },
  {
    "poem_id": 1558,
    "vorder": 64,
    "position": 1,
    "text": "بیابیم گیتی شود بی‌گزند"
  },
  {
    "poem_id": 1558,
    "vorder": 65,
    "position": 0,
    "text": "بگیرم سر گاه ایران زمین"
  },
  {
    "poem_id": 1558,
    "vorder": 66,
    "position": 1,
    "text": "به هر مرز بر ما کنند آفرین"
  },
  {
    "poem_id": 1558,
    "vorder": 67,
    "position": 0,
    "text": "کنون چون گشاده شد آن دیوزاد"
  },
  {
    "poem_id": 1558,
    "vorder": 68,
    "position": 1,
    "text": "به چنگست ما را غم و سرد باد"
  },
  {
    "poem_id": 1558,
    "vorder": 69,
    "position": 0,
    "text": "ز ترکان کسی نیست همتای اوی"
  },
  {
    "poem_id": 1558,
    "vorder": 70,
    "position": 1,
    "text": "که گیرد به رزم اندرون جای اوی"
  },
  {
    "poem_id": 1558,
    "vorder": 71,
    "position": 0,
    "text": "کنون با دلی شاد و پیروز بخت"
  },
  {
    "poem_id": 1558,
    "vorder": 72,
    "position": 1,
    "text": "به توران خرامیم با تاج و تخت"
  },
  {
    "poem_id": 1558,
    "vorder": 73,
    "position": 0,
    "text": "بفرمود تا هرچ بد خواسته"
  },
  {
    "poem_id": 1558,
    "vorder": 74,
    "position": 1,
    "text": "ز گنج و ز اسپان آراسته"
  },
  {
    "poem_id": 1558,
    "vorder": 75,
    "position": 0,
    "text": "ز چیزی که از بلخ بامی ببرد"
  },
  {
    "poem_id": 1558,
    "vorder": 76,
    "position": 1,
    "text": "بیاورد یکسر به کهرم سپرد"
  },
  {
    "poem_id": 1558,
    "vorder": 77,
    "position": 0,
    "text": "ز کهرمش کهتر پسر بد چهار"
  },
  {
    "poem_id": 1558,
    "vorder": 78,
    "position": 1,
    "text": "بنه بر نهادند و شد پیش بار"
  },
  {
    "poem_id": 1558,
    "vorder": 79,
    "position": 0,
    "text": "برفتند بر هر سوی صد هیون"
  },
  {
    "poem_id": 1558,
    "vorder": 80,
    "position": 1,
    "text": "نشسته برو نیز صد رهنمون"
  },
  {
    "poem_id": 1558,
    "vorder": 81,
    "position": 0,
    "text": "دلش بود پربیم و سر پر شتاب"
  },
  {
    "poem_id": 1558,
    "vorder": 82,
    "position": 1,
    "text": "ازو دور بد خورد و آرام و خواب"
  },
  {
    "poem_id": 1558,
    "vorder": 83,
    "position": 0,
    "text": "یکی ترک بد نام اون گرگسار"
  },
  {
    "poem_id": 1558,
    "vorder": 84,
    "position": 1,
    "text": "ز لشکر بیامد بر شهریار"
  },
  {
    "poem_id": 1558,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت کای شاه ترکان چین"
  },
  {
    "poem_id": 1558,
    "vorder": 86,
    "position": 1,
    "text": "به یک تن مزن خویشتن بر زمین"
  },
  {
    "poem_id": 1558,
    "vorder": 87,
    "position": 0,
    "text": "سپاهی همه خسته و کوفته"
  },
  {
    "poem_id": 1558,
    "vorder": 88,
    "position": 1,
    "text": "گریزان و بخت اندر آشوفته"
  },
  {
    "poem_id": 1558,
    "vorder": 89,
    "position": 0,
    "text": "پسر کوفته سوخته شهریار"
  },
  {
    "poem_id": 1558,
    "vorder": 90,
    "position": 1,
    "text": "بیاری که آمد جز اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 91,
    "position": 0,
    "text": "هم‌آورد او گر بیاید منم"
  },
  {
    "poem_id": 1558,
    "vorder": 92,
    "position": 1,
    "text": "تن مرد جنگی به خاک افگنم"
  },
  {
    "poem_id": 1558,
    "vorder": 93,
    "position": 0,
    "text": "سپه را همی دل شکسته کنی"
  },
  {
    "poem_id": 1558,
    "vorder": 94,
    "position": 1,
    "text": "به گفتار بی‌جنگ خسته کنی"
  },
  {
    "poem_id": 1558,
    "vorder": 95,
    "position": 0,
    "text": "چو ارجاسپ بشنید گفتار اوی"
  },
  {
    "poem_id": 1558,
    "vorder": 96,
    "position": 1,
    "text": "بدید آن دل و رای هشیار اوی"
  },
  {
    "poem_id": 1558,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت کای شیر پرخاشخر"
  },
  {
    "poem_id": 1558,
    "vorder": 98,
    "position": 1,
    "text": "ترا هست نام و نژاد و هنر"
  },
  {
    "poem_id": 1558,
    "vorder": 99,
    "position": 0,
    "text": "گر این را که گفتی بجای آوری"
  },
  {
    "poem_id": 1558,
    "vorder": 100,
    "position": 1,
    "text": "هنر بر زبان رهنمای آوری"
  },
  {
    "poem_id": 1558,
    "vorder": 101,
    "position": 0,
    "text": "ز توران زمین تا به دریای چین"
  },
  {
    "poem_id": 1558,
    "vorder": 102,
    "position": 1,
    "text": "ترا بخشم و بوم ایران زمین"
  },
  {
    "poem_id": 1558,
    "vorder": 103,
    "position": 0,
    "text": "سپهبد تو باشی به هر کشورم"
  },
  {
    "poem_id": 1558,
    "vorder": 104,
    "position": 1,
    "text": "ز فرمان تو یک زمان نگذرم"
  },
  {
    "poem_id": 1558,
    "vorder": 105,
    "position": 0,
    "text": "هم اندر زمان لشکر او را سپرد"
  },
  {
    "poem_id": 1558,
    "vorder": 106,
    "position": 1,
    "text": "کسانی که بودند هشیار و گرد"
  },
  {
    "poem_id": 1558,
    "vorder": 107,
    "position": 0,
    "text": "همه شب همی خلعت آراستند"
  },
  {
    "poem_id": 1558,
    "vorder": 108,
    "position": 1,
    "text": "همی بارهٔ پهلوان خواستند"
  },
  {
    "poem_id": 1558,
    "vorder": 109,
    "position": 0,
    "text": "چو خورشید زرین سپر برگرفت"
  },
  {
    "poem_id": 1558,
    "vorder": 110,
    "position": 1,
    "text": "شب تیره زو دست بر سر گرفت"
  },
  {
    "poem_id": 1558,
    "vorder": 111,
    "position": 0,
    "text": "بینداخت پیراهن مشک رنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 112,
    "position": 1,
    "text": "چو یاقوت شد مهر چهرش به رنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 113,
    "position": 0,
    "text": "ز کوه اندر آمد سپاه بزرگ"
  },
  {
    "poem_id": 1558,
    "vorder": 114,
    "position": 1,
    "text": "جهانگیر اسفندیار سترگ"
  },
  {
    "poem_id": 1558,
    "vorder": 115,
    "position": 0,
    "text": "چو لشکر بیاراست اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 116,
    "position": 1,
    "text": "جهان شد به کردار دریای قار"
  },
  {
    "poem_id": 1558,
    "vorder": 117,
    "position": 0,
    "text": "بشد گرد بستور پور زریر"
  },
  {
    "poem_id": 1558,
    "vorder": 118,
    "position": 1,
    "text": "که بگذاشتی بیشه زو نره شیر"
  },
  {
    "poem_id": 1558,
    "vorder": 119,
    "position": 0,
    "text": "بیاراست بر میمنه جای خویش"
  },
  {
    "poem_id": 1558,
    "vorder": 120,
    "position": 1,
    "text": "سپهبد بد و لشکر آرای خویش"
  },
  {
    "poem_id": 1558,
    "vorder": 121,
    "position": 0,
    "text": "چو گردوی جنگی بر میسره"
  },
  {
    "poem_id": 1558,
    "vorder": 122,
    "position": 1,
    "text": "بیامد چو خور پیش برج بره"
  },
  {
    "poem_id": 1558,
    "vorder": 123,
    "position": 0,
    "text": "به پیش سپاه آمد اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 124,
    "position": 1,
    "text": "به زین اندرون گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1558,
    "vorder": 125,
    "position": 0,
    "text": "به قلب اندرون شاه گشتاسپ بود"
  },
  {
    "poem_id": 1558,
    "vorder": 126,
    "position": 1,
    "text": "روانش پر از کین لهراسپ بود"
  },
  {
    "poem_id": 1558,
    "vorder": 127,
    "position": 0,
    "text": "وزان روی ارجاسپ صف برکشید"
  },
  {
    "poem_id": 1558,
    "vorder": 128,
    "position": 1,
    "text": "ستاره همی روی دریا ندید"
  },
  {
    "poem_id": 1558,
    "vorder": 129,
    "position": 0,
    "text": "ز بس نیزه و تیغهای بنفش"
  },
  {
    "poem_id": 1558,
    "vorder": 130,
    "position": 1,
    "text": "هوا گشته پر پرنیانی درفش"
  },
  {
    "poem_id": 1558,
    "vorder": 131,
    "position": 0,
    "text": "بشد قلب ارجاسپ چون آبنوس"
  },
  {
    "poem_id": 1558,
    "vorder": 132,
    "position": 1,
    "text": "سوی راستش کهرم و بوق و کوس"
  },
  {
    "poem_id": 1558,
    "vorder": 133,
    "position": 0,
    "text": "سوی میسره نام شاه چگل"
  },
  {
    "poem_id": 1558,
    "vorder": 134,
    "position": 1,
    "text": "که در جنگ ازو خواستی شیر دل"
  },
  {
    "poem_id": 1558,
    "vorder": 135,
    "position": 0,
    "text": "برآمد ز هر دو سپه گیر و دار"
  },
  {
    "poem_id": 1558,
    "vorder": 136,
    "position": 1,
    "text": "به پیش اندر آمد گو اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 137,
    "position": 0,
    "text": "چو ارجاسپ دید آن سپاه گران"
  },
  {
    "poem_id": 1558,
    "vorder": 138,
    "position": 1,
    "text": "گزیده سواران نیزه‌وران"
  },
  {
    "poem_id": 1558,
    "vorder": 139,
    "position": 0,
    "text": "بیامد یکی تند بالا گزید"
  },
  {
    "poem_id": 1558,
    "vorder": 140,
    "position": 1,
    "text": "به هر سوی لشکر همی بنگرید"
  },
  {
    "poem_id": 1558,
    "vorder": 141,
    "position": 0,
    "text": "ازان پس بفرمود تا ساروان"
  },
  {
    "poem_id": 1558,
    "vorder": 142,
    "position": 1,
    "text": "هیون آورد پیش ده کاروان"
  },
  {
    "poem_id": 1558,
    "vorder": 143,
    "position": 0,
    "text": "چنین گفت با نامداران براز"
  },
  {
    "poem_id": 1558,
    "vorder": 144,
    "position": 1,
    "text": "که این کار گردد به مابر دراز"
  },
  {
    "poem_id": 1558,
    "vorder": 145,
    "position": 0,
    "text": "نیاید پدیدار پیروزئی"
  },
  {
    "poem_id": 1558,
    "vorder": 146,
    "position": 1,
    "text": "نکو رفتنی گر دل افروزئی"
  },
  {
    "poem_id": 1558,
    "vorder": 147,
    "position": 0,
    "text": "خود و ویژگان بر هیونان مست"
  },
  {
    "poem_id": 1558,
    "vorder": 148,
    "position": 1,
    "text": "بسازیم باهستگی راه جست"
  },
  {
    "poem_id": 1558,
    "vorder": 149,
    "position": 0,
    "text": "چو اسفندیار از میان دو صف"
  },
  {
    "poem_id": 1558,
    "vorder": 150,
    "position": 1,
    "text": "چو پیل ژیان بر لب آورده کف"
  },
  {
    "poem_id": 1558,
    "vorder": 151,
    "position": 0,
    "text": "همی گشت برسان گردان سپهر"
  },
  {
    "poem_id": 1558,
    "vorder": 152,
    "position": 1,
    "text": "به چنگ اندرون گُرزهٔ گاو چهر"
  },
  {
    "poem_id": 1558,
    "vorder": 153,
    "position": 0,
    "text": "تو گفتی همه دشت بالای اوست"
  },
  {
    "poem_id": 1558,
    "vorder": 154,
    "position": 1,
    "text": "روانش همی در نگنجد به پوست"
  },
  {
    "poem_id": 1558,
    "vorder": 155,
    "position": 0,
    "text": "خروش آمد و نالهٔ کرنای"
  },
  {
    "poem_id": 1558,
    "vorder": 156,
    "position": 1,
    "text": "برفتند گردان لشکر ز جای"
  },
  {
    "poem_id": 1558,
    "vorder": 157,
    "position": 0,
    "text": "تو گفتی ز خون بوم دریا شدست"
  },
  {
    "poem_id": 1558,
    "vorder": 158,
    "position": 1,
    "text": "ز خنجر هوا چون ثریا شدست"
  },
  {
    "poem_id": 1558,
    "vorder": 159,
    "position": 0,
    "text": "گران شد رکیب یل اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 160,
    "position": 1,
    "text": "بغرید با گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1558,
    "vorder": 161,
    "position": 0,
    "text": "بیفشارد بر گُرز پولاد مشت"
  },
  {
    "poem_id": 1558,
    "vorder": 162,
    "position": 1,
    "text": "ز قلب سپه گرد سیصد بکشت"
  },
  {
    "poem_id": 1558,
    "vorder": 163,
    "position": 0,
    "text": "چنین گفت کز کین فرشیدورد"
  },
  {
    "poem_id": 1558,
    "vorder": 164,
    "position": 1,
    "text": "ز دریا برانگیزم امروز گرد"
  },
  {
    "poem_id": 1558,
    "vorder": 165,
    "position": 0,
    "text": "ازان پس سوی میمنه حمله برد"
  },
  {
    "poem_id": 1558,
    "vorder": 166,
    "position": 1,
    "text": "عنان بارهٔ تیزتگ را سپرد"
  },
  {
    "poem_id": 1558,
    "vorder": 167,
    "position": 0,
    "text": "صد و شست گرد از دلیران بکشت"
  },
  {
    "poem_id": 1558,
    "vorder": 168,
    "position": 1,
    "text": "چو کهرم چنان دید بنمود پشت"
  },
  {
    "poem_id": 1558,
    "vorder": 169,
    "position": 0,
    "text": "چنین گفت کاین کین خون نیاست"
  },
  {
    "poem_id": 1558,
    "vorder": 170,
    "position": 1,
    "text": "کزو شاه را دل پر از کیمیاست"
  },
  {
    "poem_id": 1558,
    "vorder": 171,
    "position": 0,
    "text": "عنان را بپیچید بر میسره"
  },
  {
    "poem_id": 1558,
    "vorder": 172,
    "position": 1,
    "text": "زمین شد چو دریای خون یکسره"
  },
  {
    "poem_id": 1558,
    "vorder": 173,
    "position": 0,
    "text": "بکشت از دلیران صد و شصت و پنج"
  },
  {
    "poem_id": 1558,
    "vorder": 174,
    "position": 1,
    "text": "همه نامداران با تاج و گنج"
  },
  {
    "poem_id": 1558,
    "vorder": 175,
    "position": 0,
    "text": "چنین گفت کاین کین آن سی و هشت"
  },
  {
    "poem_id": 1558,
    "vorder": 176,
    "position": 1,
    "text": "گرامی برادر که اندر گذشت"
  },
  {
    "poem_id": 1558,
    "vorder": 177,
    "position": 0,
    "text": "چو ارجاسپ آن دید با گرگسار"
  },
  {
    "poem_id": 1558,
    "vorder": 178,
    "position": 1,
    "text": "چنین گفت کز لشکر بی‌شمار"
  },
  {
    "poem_id": 1558,
    "vorder": 179,
    "position": 0,
    "text": "همه کشته شد هرک جنگی بدند"
  },
  {
    "poem_id": 1558,
    "vorder": 180,
    "position": 1,
    "text": "به پیش صف‌اندر درنگی بدند"
  },
  {
    "poem_id": 1558,
    "vorder": 181,
    "position": 0,
    "text": "ندانم تو خامش چرا مانده‌ای"
  },
  {
    "poem_id": 1558,
    "vorder": 182,
    "position": 1,
    "text": "چنین داستانها چرا رانده‌ای"
  },
  {
    "poem_id": 1558,
    "vorder": 183,
    "position": 0,
    "text": "ز گفتار او تیز شد گرگسار"
  },
  {
    "poem_id": 1558,
    "vorder": 184,
    "position": 1,
    "text": "بیامد به پیش صف کارزار"
  },
  {
    "poem_id": 1558,
    "vorder": 185,
    "position": 0,
    "text": "گرفته کمان کیانی به چنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 186,
    "position": 1,
    "text": "یکی تیر پولاد پیکان خدنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 187,
    "position": 0,
    "text": "چو نزدیک شد راند اندر کمان"
  },
  {
    "poem_id": 1558,
    "vorder": 188,
    "position": 1,
    "text": "بزد بر بر و سینهٔ پهلوان"
  },
  {
    "poem_id": 1558,
    "vorder": 189,
    "position": 0,
    "text": "ز زین اندر آویخت اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 190,
    "position": 1,
    "text": "بدان تا گمانی برد گرگسار"
  },
  {
    "poem_id": 1558,
    "vorder": 191,
    "position": 0,
    "text": "که آن تیر بگذشت بر جوشنش"
  },
  {
    "poem_id": 1558,
    "vorder": 192,
    "position": 1,
    "text": "بخست آن کیانی بر روشنش"
  },
  {
    "poem_id": 1558,
    "vorder": 193,
    "position": 0,
    "text": "یکی تیغ الماس گون برکشید"
  },
  {
    "poem_id": 1558,
    "vorder": 194,
    "position": 1,
    "text": "همی خواست از تن سرش را برید"
  },
  {
    "poem_id": 1558,
    "vorder": 195,
    "position": 0,
    "text": "بترسید اسفندیار از گزند"
  },
  {
    "poem_id": 1558,
    "vorder": 196,
    "position": 1,
    "text": "ز فتراک بگشاد پیچان کمند"
  },
  {
    "poem_id": 1558,
    "vorder": 197,
    "position": 0,
    "text": "به نام جهان‌آفرین کردگار"
  },
  {
    "poem_id": 1558,
    "vorder": 198,
    "position": 1,
    "text": "بینداخت بر گردن گرگسار"
  },
  {
    "poem_id": 1558,
    "vorder": 199,
    "position": 0,
    "text": "به بند اندر آمد سر و گردنش"
  },
  {
    "poem_id": 1558,
    "vorder": 200,
    "position": 1,
    "text": "بخاک اندر افگند لرزان تنش"
  },
  {
    "poem_id": 1558,
    "vorder": 201,
    "position": 0,
    "text": "دو دست از پس پشت بستش چو سنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 202,
    "position": 1,
    "text": "گره زد به گردن برش پالهنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 203,
    "position": 0,
    "text": "به لشکرگه آوردش از پیش صف"
  },
  {
    "poem_id": 1558,
    "vorder": 204,
    "position": 1,
    "text": "کشان و ز خون بر لب آورده کف"
  },
  {
    "poem_id": 1558,
    "vorder": 205,
    "position": 0,
    "text": "فرستاد بدخواه را نزد شاه"
  },
  {
    "poem_id": 1558,
    "vorder": 206,
    "position": 1,
    "text": "به دست همایون زرین کلاه"
  },
  {
    "poem_id": 1558,
    "vorder": 207,
    "position": 0,
    "text": "چنین گفت کاین را به پرده سرای"
  },
  {
    "poem_id": 1558,
    "vorder": 208,
    "position": 1,
    "text": "ببند و به کشتن مکن هیچ رای"
  },
  {
    "poem_id": 1558,
    "vorder": 209,
    "position": 0,
    "text": "کنون تا کرا بد دهد کردگار"
  },
  {
    "poem_id": 1558,
    "vorder": 210,
    "position": 1,
    "text": "که پیروز گردد ازین کارزار"
  },
  {
    "poem_id": 1558,
    "vorder": 211,
    "position": 0,
    "text": "وزان جایگه شد به آوردگاه"
  },
  {
    "poem_id": 1558,
    "vorder": 212,
    "position": 1,
    "text": "به جنگ اندر آورد یکسر سپاه"
  },
  {
    "poem_id": 1558,
    "vorder": 213,
    "position": 0,
    "text": "برانگیختند آتش کارزار"
  },
  {
    "poem_id": 1558,
    "vorder": 214,
    "position": 1,
    "text": "هوا تیره گون شد ز گرد سوار"
  },
  {
    "poem_id": 1558,
    "vorder": 215,
    "position": 0,
    "text": "چو ارجاسپ پیکار زان‌گونه دید"
  },
  {
    "poem_id": 1558,
    "vorder": 216,
    "position": 1,
    "text": "ز غم پست گشت و دلش بردمید"
  },
  {
    "poem_id": 1558,
    "vorder": 217,
    "position": 0,
    "text": "به جنگاوران گفت کهرم کجاست"
  },
  {
    "poem_id": 1558,
    "vorder": 218,
    "position": 1,
    "text": "درفشش نه پیداست بر دست راست"
  },
  {
    "poem_id": 1558,
    "vorder": 219,
    "position": 0,
    "text": "همان تیغ‌زن کندر شیرگیر"
  },
  {
    "poem_id": 1558,
    "vorder": 220,
    "position": 1,
    "text": "که بگذاشتی نیزه بر کوه و تیر"
  },
  {
    "poem_id": 1558,
    "vorder": 221,
    "position": 0,
    "text": "به ارجاسپ گفتند کاسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 222,
    "position": 1,
    "text": "به رزم اندرون بود با گرگسار"
  },
  {
    "poem_id": 1558,
    "vorder": 223,
    "position": 0,
    "text": "ز تیغ دلیران هوا شد بنفش"
  },
  {
    "poem_id": 1558,
    "vorder": 224,
    "position": 1,
    "text": "نه پیداست آن گرگ پیکر درفش"
  },
  {
    "poem_id": 1558,
    "vorder": 225,
    "position": 0,
    "text": "غمی شد در ارجاسپ را زان شگفت"
  },
  {
    "poem_id": 1558,
    "vorder": 226,
    "position": 1,
    "text": "هیون خواست و راه بیابان گرفت"
  },
  {
    "poem_id": 1558,
    "vorder": 227,
    "position": 0,
    "text": "خود و ویژگان بر هیونان مست"
  },
  {
    "poem_id": 1558,
    "vorder": 228,
    "position": 1,
    "text": "برفتند و اسپان گرفته به دست"
  },
  {
    "poem_id": 1558,
    "vorder": 229,
    "position": 0,
    "text": "سپه را بران رزمگه بر بماند"
  },
  {
    "poem_id": 1558,
    "vorder": 230,
    "position": 1,
    "text": "خود و مهتران سوی خَلُّخ براند"
  },
  {
    "poem_id": 1558,
    "vorder": 231,
    "position": 0,
    "text": "خروشی برآمد ز اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 232,
    "position": 1,
    "text": "بلرزید ز آواز او کوه و غار"
  },
  {
    "poem_id": 1558,
    "vorder": 233,
    "position": 0,
    "text": "به ایرانیان گفت شمشیر جنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 234,
    "position": 1,
    "text": "مدارید خیره گرفته به چنگ"
  },
  {
    "poem_id": 1558,
    "vorder": 235,
    "position": 0,
    "text": "نیام از دل و خون دشمن کنید"
  },
  {
    "poem_id": 1558,
    "vorder": 236,
    "position": 1,
    "text": "ز تورانیان کوه قارن کنید"
  },
  {
    "poem_id": 1558,
    "vorder": 237,
    "position": 0,
    "text": "بیفشارد ران لشکر کینه‌خواه"
  },
  {
    "poem_id": 1558,
    "vorder": 238,
    "position": 1,
    "text": "سپاه اندر آمد به پیش سپاه"
  },
  {
    "poem_id": 1558,
    "vorder": 239,
    "position": 0,
    "text": "به خون غرقه شد خاک و سنگ و گیا"
  },
  {
    "poem_id": 1558,
    "vorder": 240,
    "position": 1,
    "text": "بگشتس بخون گر بدی آسیا"
  },
  {
    "poem_id": 1558,
    "vorder": 241,
    "position": 0,
    "text": "همه دشت پا و بر و پشت بود"
  },
  {
    "poem_id": 1558,
    "vorder": 242,
    "position": 1,
    "text": "بریده سر و تیغ در مشت بود"
  },
  {
    "poem_id": 1558,
    "vorder": 243,
    "position": 0,
    "text": "سواران جنگی همی تاختند"
  },
  {
    "poem_id": 1558,
    "vorder": 244,
    "position": 1,
    "text": "به کالا گرفتن نپرداختند"
  },
  {
    "poem_id": 1558,
    "vorder": 245,
    "position": 0,
    "text": "چو ترکان شنیدند کارجاسپ رفت"
  },
  {
    "poem_id": 1558,
    "vorder": 246,
    "position": 1,
    "text": "همی پوستشان بر تن از غم بکفت"
  },
  {
    "poem_id": 1558,
    "vorder": 247,
    "position": 0,
    "text": "کسی را که بد باره بگریختند"
  },
  {
    "poem_id": 1558,
    "vorder": 248,
    "position": 1,
    "text": "دگر تیغ و جوشن فرو ریختند"
  },
  {
    "poem_id": 1558,
    "vorder": 249,
    "position": 0,
    "text": "به زنهار اسفندیار آمدند"
  },
  {
    "poem_id": 1558,
    "vorder": 250,
    "position": 1,
    "text": "همه دیده چون جویبار آمدند"
  },
  {
    "poem_id": 1558,
    "vorder": 251,
    "position": 0,
    "text": "بریشان ببخشود زورآزمای"
  },
  {
    "poem_id": 1558,
    "vorder": 252,
    "position": 1,
    "text": "ازان پس نیفگند کس را ز پای"
  },
  {
    "poem_id": 1558,
    "vorder": 253,
    "position": 0,
    "text": "ز خون نیا دل بی‌آزار کرد"
  },
  {
    "poem_id": 1558,
    "vorder": 254,
    "position": 1,
    "text": "سری را بریشان نگهدار کرد"
  },
  {
    "poem_id": 1558,
    "vorder": 255,
    "position": 0,
    "text": "خود و لشکر آمد به نزدیک شاه"
  },
  {
    "poem_id": 1558,
    "vorder": 256,
    "position": 1,
    "text": "پر از خون بر و تیغ و رومی کلاه"
  },
  {
    "poem_id": 1558,
    "vorder": 257,
    "position": 0,
    "text": "ز خون در کفش خنجر افسرده بود"
  },
  {
    "poem_id": 1558,
    "vorder": 258,
    "position": 1,
    "text": "بر و کتفش از جوش آزرده بود"
  },
  {
    "poem_id": 1558,
    "vorder": 259,
    "position": 0,
    "text": "بشستند شمشیر و کفش به شیر"
  },
  {
    "poem_id": 1558,
    "vorder": 260,
    "position": 1,
    "text": "کشیدند بیرون ز خفتانش تیر"
  },
  {
    "poem_id": 1558,
    "vorder": 261,
    "position": 0,
    "text": "به آب اندر آمد سر و تن بشست"
  },
  {
    "poem_id": 1558,
    "vorder": 262,
    "position": 1,
    "text": "جهانجوی شادان دل و تن درست"
  },
  {
    "poem_id": 1558,
    "vorder": 263,
    "position": 0,
    "text": "یکی جامهٔ سوکواران بخواست"
  },
  {
    "poem_id": 1558,
    "vorder": 264,
    "position": 1,
    "text": "بیامد بر داور داد و راست"
  },
  {
    "poem_id": 1558,
    "vorder": 265,
    "position": 0,
    "text": "نیایش همی کرد خود با پدر"
  },
  {
    "poem_id": 1558,
    "vorder": 266,
    "position": 1,
    "text": "بران آفرینندهٔ دادگر"
  },
  {
    "poem_id": 1558,
    "vorder": 267,
    "position": 0,
    "text": "یکی هفته بر پیش یزدان پاک"
  },
  {
    "poem_id": 1558,
    "vorder": 268,
    "position": 1,
    "text": "همی بود گشتاسپ با درد و باک"
  },
  {
    "poem_id": 1558,
    "vorder": 269,
    "position": 0,
    "text": "به هشتم به جا آمد اسفندیار"
  },
  {
    "poem_id": 1558,
    "vorder": 270,
    "position": 1,
    "text": "بیامد به درگاه او گرگسار"
  },
  {
    "poem_id": 1558,
    "vorder": 271,
    "position": 0,
    "text": "ز شیرین روان دل شده ناامید"
  },
  {
    "poem_id": 1558,
    "vorder": 272,
    "position": 1,
    "text": "تن از بیم لرزان چو از باد بید"
  },
  {
    "poem_id": 1558,
    "vorder": 273,
    "position": 0,
    "text": "بدو گفت شاها تو از خون من"
  },
  {
    "poem_id": 1558,
    "vorder": 274,
    "position": 1,
    "text": "ستایش نیابی به هر انجمن"
  },
  {
    "poem_id": 1558,
    "vorder": 275,
    "position": 0,
    "text": "یکی بنده باشم بپیشت بپای"
  },
  {
    "poem_id": 1558,
    "vorder": 276,
    "position": 1,
    "text": "همیشه به نیکی ترا رهنمای"
  },
  {
    "poem_id": 1558,
    "vorder": 277,
    "position": 0,
    "text": "به هر بد که آید زبونی کنم"
  },
  {
    "poem_id": 1558,
    "vorder": 278,
    "position": 1,
    "text": "به رویین دژت رهنمونی کنم"
  },
  {
    "poem_id": 1558,
    "vorder": 279,
    "position": 0,
    "text": "بفرمود تا بند بر دست و پای"
  },
  {
    "poem_id": 1558,
    "vorder": 280,
    "position": 1,
    "text": "ببردند بازش به پرده سرای"
  },
  {
    "poem_id": 1558,
    "vorder": 281,
    "position": 0,
    "text": "به لشکر گه آمد که ارجاسپ بود"
  },
  {
    "poem_id": 1558,
    "vorder": 282,
    "position": 1,
    "text": "که ریزندها خون لهراسپ بود"
  },
  {
    "poem_id": 1558,
    "vorder": 283,
    "position": 0,
    "text": "ببخشید زان رزمگه خواسته"
  },
  {
    "poem_id": 1558,
    "vorder": 284,
    "position": 1,
    "text": "سوار و پیاده شد آراسته"
  },
  {
    "poem_id": 1558,
    "vorder": 285,
    "position": 0,
    "text": "سران و اسیران که آورده بود"
  },
  {
    "poem_id": 1558,
    "vorder": 286,
    "position": 1,
    "text": "بکشت آن کزو لشکر آزرده بود"
  }
