[
  {
    "poem_id": 1659,
    "vorder": 1,
    "position": 0,
    "text": "چو برگشت و آمد به درگاه قصر"
  },
  {
    "poem_id": 1659,
    "vorder": 2,
    "position": 1,
    "text": "ببخشید دینار چندی به نصر"
  },
  {
    "poem_id": 1659,
    "vorder": 3,
    "position": 0,
    "text": "توانگر شد آنکس که درویش بود"
  },
  {
    "poem_id": 1659,
    "vorder": 4,
    "position": 1,
    "text": "وگر خوردش از کوشش خویش بود"
  },
  {
    "poem_id": 1659,
    "vorder": 5,
    "position": 0,
    "text": "وزان جایگه شاد لشکر براند"
  },
  {
    "poem_id": 1659,
    "vorder": 6,
    "position": 1,
    "text": "به جده درآمد فراوان نماند"
  },
  {
    "poem_id": 1659,
    "vorder": 7,
    "position": 0,
    "text": "سپه را بفرمود تا هرکسی"
  },
  {
    "poem_id": 1659,
    "vorder": 8,
    "position": 1,
    "text": "بسازند کشتی و زورق بسی"
  },
  {
    "poem_id": 1659,
    "vorder": 9,
    "position": 0,
    "text": "جهانگیر با لشکری راه‌جوی"
  },
  {
    "poem_id": 1659,
    "vorder": 10,
    "position": 1,
    "text": "ز جده سوی مصر بنهاد روی"
  },
  {
    "poem_id": 1659,
    "vorder": 11,
    "position": 0,
    "text": "ملک بود قیطون به مصر اندرون"
  },
  {
    "poem_id": 1659,
    "vorder": 12,
    "position": 1,
    "text": "سپاهش ز راه گمانی فزون"
  },
  {
    "poem_id": 1659,
    "vorder": 13,
    "position": 0,
    "text": "چو بشنید کامد ز راه حرم"
  },
  {
    "poem_id": 1659,
    "vorder": 14,
    "position": 1,
    "text": "جهانگیر پیروز با باد و دم"
  },
  {
    "poem_id": 1659,
    "vorder": 15,
    "position": 0,
    "text": "پذیره شدش با فراوان سپاه"
  },
  {
    "poem_id": 1659,
    "vorder": 16,
    "position": 1,
    "text": "ابا بدره و برده و تاج و گاه"
  },
  {
    "poem_id": 1659,
    "vorder": 17,
    "position": 0,
    "text": "سکندر به دیدار او گشت شاد"
  },
  {
    "poem_id": 1659,
    "vorder": 18,
    "position": 1,
    "text": "همان گفت بدخواه او گشت باد"
  },
  {
    "poem_id": 1659,
    "vorder": 19,
    "position": 0,
    "text": "به مصر اندرون بود یک سال شاه"
  },
  {
    "poem_id": 1659,
    "vorder": 20,
    "position": 1,
    "text": "بدان تا برآسود شاه و سپاه"
  },
  {
    "poem_id": 1659,
    "vorder": 21,
    "position": 0,
    "text": "زنی بود در اندلس شهریار"
  },
  {
    "poem_id": 1659,
    "vorder": 22,
    "position": 1,
    "text": "خردمند و با لشکری بی‌شمار"
  },
  {
    "poem_id": 1659,
    "vorder": 23,
    "position": 0,
    "text": "جهانجوی بخشنده قیدافه بود"
  },
  {
    "poem_id": 1659,
    "vorder": 24,
    "position": 1,
    "text": "ز روی بهی یافته کام و سود"
  },
  {
    "poem_id": 1659,
    "vorder": 25,
    "position": 0,
    "text": "ز لشکر سواری مصور بجست"
  },
  {
    "poem_id": 1659,
    "vorder": 26,
    "position": 1,
    "text": "که مانند صورت نگارد درست"
  },
  {
    "poem_id": 1659,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت سوی سکندر خرام"
  },
  {
    "poem_id": 1659,
    "vorder": 28,
    "position": 1,
    "text": "وزین مرز و از ما مبر هیچ نام"
  },
  {
    "poem_id": 1659,
    "vorder": 29,
    "position": 0,
    "text": "به ژرفی نگه کن چنان چون که هست"
  },
  {
    "poem_id": 1659,
    "vorder": 30,
    "position": 1,
    "text": "به کردار تا چون برآیدت دست"
  },
  {
    "poem_id": 1659,
    "vorder": 31,
    "position": 0,
    "text": "ز رنگ و ز چهر و ز بالای اوی"
  },
  {
    "poem_id": 1659,
    "vorder": 32,
    "position": 1,
    "text": "یکی صورت آر از سر پای اوی"
  },
  {
    "poem_id": 1659,
    "vorder": 33,
    "position": 0,
    "text": "نگارنده بشنید و زو بر نشست"
  },
  {
    "poem_id": 1659,
    "vorder": 34,
    "position": 1,
    "text": "به فرمان مهتر میان را ببست"
  },
  {
    "poem_id": 1659,
    "vorder": 35,
    "position": 0,
    "text": "به مصر آمد از اندلس چون نوند"
  },
  {
    "poem_id": 1659,
    "vorder": 36,
    "position": 1,
    "text": "بر قیصر اسکندر ارجمند"
  },
  {
    "poem_id": 1659,
    "vorder": 37,
    "position": 0,
    "text": "چه برگاه دیدش چه بر پشت زین"
  },
  {
    "poem_id": 1659,
    "vorder": 38,
    "position": 1,
    "text": "بیاورد قرطاس و دیبای چین"
  },
  {
    "poem_id": 1659,
    "vorder": 39,
    "position": 0,
    "text": "نگار سکندر چنان هم که بود"
  },
  {
    "poem_id": 1659,
    "vorder": 40,
    "position": 1,
    "text": "نگارید و ز جای برگشت زود"
  },
  {
    "poem_id": 1659,
    "vorder": 41,
    "position": 0,
    "text": "چو قیدافه چهر سکندر بدید"
  },
  {
    "poem_id": 1659,
    "vorder": 42,
    "position": 1,
    "text": "غمی گشت و بنهفت و دم در کشید"
  },
  {
    "poem_id": 1659,
    "vorder": 43,
    "position": 0,
    "text": "سکندر ز قیطون بپرسید و گفت"
  },
  {
    "poem_id": 1659,
    "vorder": 44,
    "position": 1,
    "text": "که قیدافه را بر زمین کیست جفت"
  },
  {
    "poem_id": 1659,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت قیطون که ای شهریار"
  },
  {
    "poem_id": 1659,
    "vorder": 46,
    "position": 1,
    "text": "چنو نیست اندر جهان کامگار"
  },
  {
    "poem_id": 1659,
    "vorder": 47,
    "position": 0,
    "text": "شمار سپاهش نداند کسی"
  },
  {
    "poem_id": 1659,
    "vorder": 48,
    "position": 1,
    "text": "مگر باز جوید ز دفتر بسی"
  },
  {
    "poem_id": 1659,
    "vorder": 49,
    "position": 0,
    "text": "ز گنج و بزرگی و شایستگی"
  },
  {
    "poem_id": 1659,
    "vorder": 50,
    "position": 1,
    "text": "ز آهستگی هم ز بایستگی"
  },
  {
    "poem_id": 1659,
    "vorder": 51,
    "position": 0,
    "text": "به رای و به گفتار نیکی گمان"
  },
  {
    "poem_id": 1659,
    "vorder": 52,
    "position": 1,
    "text": "نبینی به مانند او در جهان"
  },
  {
    "poem_id": 1659,
    "vorder": 53,
    "position": 0,
    "text": "یکی شارستان کرده دارد ز سنگ"
  },
  {
    "poem_id": 1659,
    "vorder": 54,
    "position": 1,
    "text": "که نبساید آن هم ز چنگ پلنگ"
  },
  {
    "poem_id": 1659,
    "vorder": 55,
    "position": 0,
    "text": "زمین چار فرسنگ بالای اوی"
  },
  {
    "poem_id": 1659,
    "vorder": 56,
    "position": 1,
    "text": "برین هم نشانست پهنای اوی"
  },
  {
    "poem_id": 1659,
    "vorder": 57,
    "position": 0,
    "text": "گر از گنج پرسی خود اندازه نیست"
  },
  {
    "poem_id": 1659,
    "vorder": 58,
    "position": 1,
    "text": "سخنهای او در جهان تازه نیست"
  }
]