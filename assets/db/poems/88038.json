[
  {
    "poem_id": 88038,
    "vorder": 1,
    "position": 0,
    "text": "از اسبان گله هرچ شایسته بود"
  },
  {
    "poem_id": 88038,
    "vorder": 2,
    "position": 1,
    "text": "ز هر سو به لشکرگه آورد زود"
  },
  {
    "poem_id": 88038,
    "vorder": 3,
    "position": 0,
    "text": "پیاده همه کرد یکسر سوار"
  },
  {
    "poem_id": 88038,
    "vorder": 4,
    "position": 1,
    "text": "دو اسبه سوار از پس کارزار"
  },
  {
    "poem_id": 88038,
    "vorder": 5,
    "position": 0,
    "text": "سر گنجهای کهن برگشاد"
  },
  {
    "poem_id": 88038,
    "vorder": 6,
    "position": 1,
    "text": "به دینار دادن دل اندر نهاد"
  },
  {
    "poem_id": 88038,
    "vorder": 7,
    "position": 0,
    "text": "چو این کرده شد نزد افراسیاب"
  },
  {
    "poem_id": 88038,
    "vorder": 8,
    "position": 1,
    "text": "نوندی برافگند هنگام خواب"
  },
  {
    "poem_id": 88038,
    "vorder": 9,
    "position": 0,
    "text": "فرستاده‌ای با هش و رای پیر"
  },
  {
    "poem_id": 88038,
    "vorder": 10,
    "position": 1,
    "text": "سخن‌گوی و گرد و سوار و دبیر"
  },
  {
    "poem_id": 88038,
    "vorder": 11,
    "position": 0,
    "text": "که رو شاه توران سپه را بگوی"
  },
  {
    "poem_id": 88038,
    "vorder": 12,
    "position": 1,
    "text": "که ای دادگر خسرو نامجوی"
  },
  {
    "poem_id": 88038,
    "vorder": 13,
    "position": 0,
    "text": "کز آنگه که چرخ سپهر بلند"
  },
  {
    "poem_id": 88038,
    "vorder": 14,
    "position": 1,
    "text": "بگشت از بر تیره خاک نژند"
  },
  {
    "poem_id": 88038,
    "vorder": 15,
    "position": 0,
    "text": "چو تو شاه بر گاه ننشست نیز"
  },
  {
    "poem_id": 88038,
    "vorder": 16,
    "position": 1,
    "text": "به کس نام شاهی نپیوست نیز"
  },
  {
    "poem_id": 88038,
    "vorder": 17,
    "position": 0,
    "text": "نه زیبا بود جز تو مر تخت را"
  },
  {
    "poem_id": 88038,
    "vorder": 18,
    "position": 1,
    "text": "کلاه و کمر بستن و بخت را"
  },
  {
    "poem_id": 88038,
    "vorder": 19,
    "position": 0,
    "text": "از آن کس برآرد جهاندار گرد"
  },
  {
    "poem_id": 88038,
    "vorder": 20,
    "position": 1,
    "text": "که پیش تو آید به روز نبرد"
  },
  {
    "poem_id": 88038,
    "vorder": 21,
    "position": 0,
    "text": "یکی بنده‌ام من گنهکار تو"
  },
  {
    "poem_id": 88038,
    "vorder": 22,
    "position": 1,
    "text": "کشیده سر از جان بیدار تو"
  },
  {
    "poem_id": 88038,
    "vorder": 23,
    "position": 0,
    "text": "ز کیخسرو از من بیازرد شاه"
  },
  {
    "poem_id": 88038,
    "vorder": 24,
    "position": 1,
    "text": "جز این خویشتن را ندانم گناه"
  },
  {
    "poem_id": 88038,
    "vorder": 25,
    "position": 0,
    "text": "که این ایزدی بود بود آنچ بود"
  },
  {
    "poem_id": 88038,
    "vorder": 26,
    "position": 1,
    "text": "ندارد ز گفتار بسیار سود"
  },
  {
    "poem_id": 88038,
    "vorder": 27,
    "position": 0,
    "text": "اگر نیز بیند مرا ز این گناه"
  },
  {
    "poem_id": 88038,
    "vorder": 28,
    "position": 1,
    "text": "کند گردن آزاد و آید به راه"
  },
  {
    "poem_id": 88038,
    "vorder": 29,
    "position": 0,
    "text": "رسانم من اکنون به شاه آگهی"
  },
  {
    "poem_id": 88038,
    "vorder": 30,
    "position": 1,
    "text": "که گردون چه آورد پیش رهی"
  },
  {
    "poem_id": 88038,
    "vorder": 31,
    "position": 0,
    "text": "کشیدم به کوه کنابد سپاه"
  },
  {
    "poem_id": 88038,
    "vorder": 32,
    "position": 1,
    "text": "به ایرانیان بر ببستیم راه"
  },
  {
    "poem_id": 88038,
    "vorder": 33,
    "position": 0,
    "text": "وز آن سو بیامد سپاهی گران"
  },
  {
    "poem_id": 88038,
    "vorder": 34,
    "position": 1,
    "text": "سپهدار گودرز و با او سران"
  },
  {
    "poem_id": 88038,
    "vorder": 35,
    "position": 0,
    "text": "کز ایران ز گاه منوچهر شاه"
  },
  {
    "poem_id": 88038,
    "vorder": 36,
    "position": 1,
    "text": "فزون زان نیامد به توران سپاه"
  },
  {
    "poem_id": 88038,
    "vorder": 37,
    "position": 0,
    "text": "به زیبد یکی جایگه ساختند"
  },
  {
    "poem_id": 88038,
    "vorder": 38,
    "position": 1,
    "text": "سپه را در آن کوه بنشاختند"
  },
  {
    "poem_id": 88038,
    "vorder": 39,
    "position": 0,
    "text": "سپه را سه روز و سه شب چون پلنگ"
  },
  {
    "poem_id": 88038,
    "vorder": 40,
    "position": 1,
    "text": "به روی اندر آورده بد روی تنگ"
  },
  {
    "poem_id": 88038,
    "vorder": 41,
    "position": 0,
    "text": "نجستیم رزم اندر آن کینه‌گاه"
  },
  {
    "poem_id": 88038,
    "vorder": 42,
    "position": 1,
    "text": "که آید مگر سوی هامون سپاه"
  },
  {
    "poem_id": 88038,
    "vorder": 43,
    "position": 0,
    "text": "نیامد سپاهش از آن که برون"
  },
  {
    "poem_id": 88038,
    "vorder": 44,
    "position": 1,
    "text": "سر پهلوانان ما شد نگون"
  },
  {
    "poem_id": 88038,
    "vorder": 45,
    "position": 0,
    "text": "سپهدار ایران نیامد ستوه"
  },
  {
    "poem_id": 88038,
    "vorder": 46,
    "position": 1,
    "text": "به هامون نیاورد لشکر ز کوه"
  },
  {
    "poem_id": 88038,
    "vorder": 47,
    "position": 0,
    "text": "برادر جهاندار هومان من"
  },
  {
    "poem_id": 88038,
    "vorder": 48,
    "position": 1,
    "text": "به کینه بجوشید از این انجمن"
  },
  {
    "poem_id": 88038,
    "vorder": 49,
    "position": 0,
    "text": "به ایران سپه شد که جوید نبرد"
  },
  {
    "poem_id": 88038,
    "vorder": 50,
    "position": 1,
    "text": "ندانم چه آمد بر آن شیرمرد"
  },
  {
    "poem_id": 88038,
    "vorder": 51,
    "position": 0,
    "text": "بیامد به کین جستنش پور گیو"
  },
  {
    "poem_id": 88038,
    "vorder": 52,
    "position": 1,
    "text": "بگردید با گرد هومان نیو"
  },
  {
    "poem_id": 88038,
    "vorder": 53,
    "position": 0,
    "text": "ابر دست چون بیژنی کشته شد"
  },
  {
    "poem_id": 88038,
    "vorder": 54,
    "position": 1,
    "text": "سر من ز تیمار او گشته شد"
  },
  {
    "poem_id": 88038,
    "vorder": 55,
    "position": 0,
    "text": "که دانست هرگز که سرو بلند"
  },
  {
    "poem_id": 88038,
    "vorder": 56,
    "position": 1,
    "text": "به باغ از گیا یافت خواهد گزند"
  },
  {
    "poem_id": 88038,
    "vorder": 57,
    "position": 0,
    "text": "دل نامداران همه بر شکست"
  },
  {
    "poem_id": 88038,
    "vorder": 58,
    "position": 1,
    "text": "همه شادمانی شد از درد پست"
  },
  {
    "poem_id": 88038,
    "vorder": 59,
    "position": 0,
    "text": "و دیگر چو نستیهن نامدار"
  },
  {
    "poem_id": 88038,
    "vorder": 60,
    "position": 1,
    "text": "ابا ده هزار آزموده سوار"
  },
  {
    "poem_id": 88038,
    "vorder": 61,
    "position": 0,
    "text": "برفت از بر من سپیده دمان"
  },
  {
    "poem_id": 88038,
    "vorder": 62,
    "position": 1,
    "text": "همان بیژنش کند سر در زمان"
  },
  {
    "poem_id": 88038,
    "vorder": 63,
    "position": 0,
    "text": "من از درد دل برکشیدم سپاه"
  },
  {
    "poem_id": 88038,
    "vorder": 64,
    "position": 1,
    "text": "غریوان برفتم به آوردگاه"
  },
  {
    "poem_id": 88038,
    "vorder": 65,
    "position": 0,
    "text": "یکی رزم تا شب برآمد ز کوه"
  },
  {
    "poem_id": 88038,
    "vorder": 66,
    "position": 1,
    "text": "بکردیم یک با دگر همگروه"
  },
  {
    "poem_id": 88038,
    "vorder": 67,
    "position": 0,
    "text": "چو نهصد تن از نامداران شاه"
  },
  {
    "poem_id": 88038,
    "vorder": 68,
    "position": 1,
    "text": "سر از تن جدا شد بر این رزمگاه"
  },
  {
    "poem_id": 88038,
    "vorder": 69,
    "position": 0,
    "text": "دو بهره ز گردان این انجمن"
  },
  {
    "poem_id": 88038,
    "vorder": 70,
    "position": 1,
    "text": "دل از درد خسته به شمشیر تن"
  },
  {
    "poem_id": 88038,
    "vorder": 71,
    "position": 0,
    "text": "به ما بر شده چیره ایرانیان"
  },
  {
    "poem_id": 88038,
    "vorder": 72,
    "position": 1,
    "text": "به کینه همه پاک بسته میان"
  },
  {
    "poem_id": 88038,
    "vorder": 73,
    "position": 0,
    "text": "بترسم همی زانک گردان سپهر"
  },
  {
    "poem_id": 88038,
    "vorder": 74,
    "position": 1,
    "text": "بخواهد بریدن ز ما پاک مهر"
  },
  {
    "poem_id": 88038,
    "vorder": 75,
    "position": 0,
    "text": "وز آن پس شنیدم یکی بدخبر"
  },
  {
    "poem_id": 88038,
    "vorder": 76,
    "position": 1,
    "text": "کز آن نیز برگشتم آسیمه سر"
  },
  {
    "poem_id": 88038,
    "vorder": 77,
    "position": 0,
    "text": "که کیخسرو آید همی با سپاه"
  },
  {
    "poem_id": 88038,
    "vorder": 78,
    "position": 1,
    "text": "به پشت سپهبد بدین رزمگاه"
  },
  {
    "poem_id": 88038,
    "vorder": 79,
    "position": 0,
    "text": "گر ایدونک گردد درست این خبر"
  },
  {
    "poem_id": 88038,
    "vorder": 80,
    "position": 1,
    "text": "که خسرو کند سوی ما بر گذر"
  },
  {
    "poem_id": 88038,
    "vorder": 81,
    "position": 0,
    "text": "جهاندار داند که من با سپاه"
  },
  {
    "poem_id": 88038,
    "vorder": 82,
    "position": 1,
    "text": "نیارم شدن پیش او کینه‌خواه"
  },
  {
    "poem_id": 88038,
    "vorder": 83,
    "position": 0,
    "text": "مگر شاه با لشکر کینه‌جوی"
  },
  {
    "poem_id": 88038,
    "vorder": 84,
    "position": 1,
    "text": "نهد سوی ایران بدین کینه روی"
  },
  {
    "poem_id": 88038,
    "vorder": 85,
    "position": 0,
    "text": "بگرداند این بد ز تورانیان"
  },
  {
    "poem_id": 88038,
    "vorder": 86,
    "position": 1,
    "text": "ببندد به کینه کمر بر میان"
  },
  {
    "poem_id": 88038,
    "vorder": 87,
    "position": 0,
    "text": "که گر جان ما را ز ایران سپاه"
  },
  {
    "poem_id": 88038,
    "vorder": 88,
    "position": 1,
    "text": "بد آید نباشد کسی کینه‌خواه"
  },
  {
    "poem_id": 88038,
    "vorder": 89,
    "position": 0,
    "text": "فرستاده چون گفت پیران شنید"
  },
  {
    "poem_id": 88038,
    "vorder": 90,
    "position": 1,
    "text": "به کردار باد دمان بردمید"
  },
  {
    "poem_id": 88038,
    "vorder": 91,
    "position": 0,
    "text": "نشست از بر بادپای سمند"
  },
  {
    "poem_id": 88038,
    "vorder": 92,
    "position": 1,
    "text": "به کردار آتش هیونی بلند"
  },
  {
    "poem_id": 88038,
    "vorder": 93,
    "position": 0,
    "text": "بشد تا به نزدیک افراسیاب"
  },
  {
    "poem_id": 88038,
    "vorder": 94,
    "position": 1,
    "text": "نه دم زد به ره بر نه آرام و خواب"
  },
  {
    "poem_id": 88038,
    "vorder": 95,
    "position": 0,
    "text": "به نزدیک شاه اندر آمد چو باد"
  },
  {
    "poem_id": 88038,
    "vorder": 96,
    "position": 1,
    "text": "ببوسید تخت و پیامش بداد"
  },
  {
    "poem_id": 88038,
    "vorder": 97,
    "position": 0,
    "text": "چو بشنید گفتار پیران به درد"
  },
  {
    "poem_id": 88038,
    "vorder": 98,
    "position": 1,
    "text": "دلش گشت پرخون و رخساره زرد"
  },
  {
    "poem_id": 88038,
    "vorder": 99,
    "position": 0,
    "text": "شد از کار آن کشتگان خسته‌دل"
  },
  {
    "poem_id": 88038,
    "vorder": 100,
    "position": 1,
    "text": "بدان درد بنهاد پیوسته دل"
  },
  {
    "poem_id": 88038,
    "vorder": 101,
    "position": 0,
    "text": "وز آن نیز کز دشمنان لشکرش"
  },
  {
    "poem_id": 88038,
    "vorder": 102,
    "position": 1,
    "text": "گریزان و ویران شده کشورش"
  },
  {
    "poem_id": 88038,
    "vorder": 103,
    "position": 0,
    "text": "ز هر سو پلنگ اندر آورده چنگ"
  },
  {
    "poem_id": 88038,
    "vorder": 104,
    "position": 1,
    "text": "بر او بر جهان گشته تاریک و تنگ"
  },
  {
    "poem_id": 88038,
    "vorder": 105,
    "position": 0,
    "text": "چو گفتار پیران از آن سان شنید"
  },
  {
    "poem_id": 88038,
    "vorder": 106,
    "position": 1,
    "text": "سپه را همه پای برجای دید"
  }
]