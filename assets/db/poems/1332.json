[
  {
    "poem_id": 1332,
    "vorder": 1,
    "position": 0,
    "text": "جهان آفرین تا جهان آفرید"
  },
  {
    "poem_id": 1332,
    "vorder": 2,
    "position": 1,
    "text": "چون او مرزبانی نیامد پدید"
  },
  {
    "poem_id": 1332,
    "vorder": 3,
    "position": 0,
    "text": "چو خورشید بر چرخ بنمود تاج"
  },
  {
    "poem_id": 1332,
    "vorder": 4,
    "position": 1,
    "text": "زمین شد به کردار تابنده عاج"
  },
  {
    "poem_id": 1332,
    "vorder": 5,
    "position": 0,
    "text": "چه گویم که خورشید تابان که بود"
  },
  {
    "poem_id": 1332,
    "vorder": 6,
    "position": 1,
    "text": "کز او در جهان روشنایی فزود"
  },
  {
    "poem_id": 1332,
    "vorder": 7,
    "position": 0,
    "text": "ابوالقاسم آن شاه پیروز بخت"
  },
  {
    "poem_id": 1332,
    "vorder": 8,
    "position": 1,
    "text": "نهاد از بر تاج خورشید تخت"
  },
  {
    "poem_id": 1332,
    "vorder": 9,
    "position": 0,
    "text": "ز خاور بیاراست تا باختر"
  },
  {
    "poem_id": 1332,
    "vorder": 10,
    "position": 1,
    "text": "پدید آمد از فرّ او کان زر"
  },
  {
    "poem_id": 1332,
    "vorder": 11,
    "position": 0,
    "text": "مرا اختر خفته بیدار گشت"
  },
  {
    "poem_id": 1332,
    "vorder": 12,
    "position": 1,
    "text": "به مغز اندر اندیشه بسیار گشت"
  },
  {
    "poem_id": 1332,
    "vorder": 13,
    "position": 0,
    "text": "بدانستم آمد زمان سخن"
  },
  {
    "poem_id": 1332,
    "vorder": 14,
    "position": 1,
    "text": "کنون نو شود روزگار کهن"
  },
  {
    "poem_id": 1332,
    "vorder": 15,
    "position": 0,
    "text": "بر اندیشهٔ شهریار زمین"
  },
  {
    "poem_id": 1332,
    "vorder": 16,
    "position": 1,
    "text": "بخفتم شبی لب پر از آفرین"
  },
  {
    "poem_id": 1332,
    "vorder": 17,
    "position": 0,
    "text": "دل من چو نور اندر آن تیره شب"
  },
  {
    "poem_id": 1332,
    "vorder": 18,
    "position": 1,
    "text": "نخفته گشاده دل و بسته لب"
  },
  {
    "poem_id": 1332,
    "vorder": 19,
    "position": 0,
    "text": "چنان دید روشن روانم به خواب"
  },
  {
    "poem_id": 1332,
    "vorder": 20,
    "position": 1,
    "text": "که رخشنده شمعی بر آمد ز آب"
  },
  {
    "poem_id": 1332,
    "vorder": 21,
    "position": 0,
    "text": "همه روی گیتی شب لاژورد"
  },
  {
    "poem_id": 1332,
    "vorder": 22,
    "position": 1,
    "text": "از آن شمع گشتی چو یاقوت زرد"
  },
  {
    "poem_id": 1332,
    "vorder": 23,
    "position": 0,
    "text": "در و دشت بر سان دیبا شدی"
  },
  {
    "poem_id": 1332,
    "vorder": 24,
    "position": 1,
    "text": "یکی تخت پیروزه پیدا شدی"
  },
  {
    "poem_id": 1332,
    "vorder": 25,
    "position": 0,
    "text": "نشسته بر او شهریاری چو ماه"
  },
  {
    "poem_id": 1332,
    "vorder": 26,
    "position": 1,
    "text": "یکی تاج بر سر به جای کلاه"
  },
  {
    "poem_id": 1332,
    "vorder": 27,
    "position": 0,
    "text": "رده بر کشیده سپاهش دو میل"
  },
  {
    "poem_id": 1332,
    "vorder": 28,
    "position": 1,
    "text": "به دست چپش هفتصد ژنده پیل"
  },
  {
    "poem_id": 1332,
    "vorder": 29,
    "position": 0,
    "text": "یکی پاک دستور پیشش به پای"
  },
  {
    "poem_id": 1332,
    "vorder": 30,
    "position": 1,
    "text": "به داد و به دین شاه را رهنمای"
  },
  {
    "poem_id": 1332,
    "vorder": 31,
    "position": 0,
    "text": "مرا خیره گشتی سر از فرّ شاه"
  },
  {
    "poem_id": 1332,
    "vorder": 32,
    "position": 1,
    "text": "و زان ژنده پیلان و چندان سپاه"
  },
  {
    "poem_id": 1332,
    "vorder": 33,
    "position": 0,
    "text": "چو آن چهرهٔ خسروی دیدمی"
  },
  {
    "poem_id": 1332,
    "vorder": 34,
    "position": 1,
    "text": "از آن نامداران بپرسیدمی"
  },
  {
    "poem_id": 1332,
    "vorder": 35,
    "position": 0,
    "text": "که این چرخ و ماه است یا تاج و گاه"
  },
  {
    "poem_id": 1332,
    "vorder": 36,
    "position": 1,
    "text": "ستاره است پیش اندرش یا سپاه"
  },
  {
    "poem_id": 1332,
    "vorder": 37,
    "position": 0,
    "text": "یکی گفت کاین شاه روم است و هند"
  },
  {
    "poem_id": 1332,
    "vorder": 38,
    "position": 1,
    "text": "ز قنّوج تا پیش دریای سند"
  },
  {
    "poem_id": 1332,
    "vorder": 39,
    "position": 0,
    "text": "به ایران و توران ورا بنده‌اند"
  },
  {
    "poem_id": 1332,
    "vorder": 40,
    "position": 1,
    "text": "به رای و به فرمان او زنده‌اند"
  },
  {
    "poem_id": 1332,
    "vorder": 41,
    "position": 0,
    "text": "بیاراست روی زمین را به داد"
  },
  {
    "poem_id": 1332,
    "vorder": 42,
    "position": 1,
    "text": "بپردخت از آن تاج بر سر نهاد"
  },
  {
    "poem_id": 1332,
    "vorder": 43,
    "position": 0,
    "text": "جهاندار محمود شاه بزرگ"
  },
  {
    "poem_id": 1332,
    "vorder": 44,
    "position": 1,
    "text": "به آبشخور آرد همی میش و گرگ"
  },
  {
    "poem_id": 1332,
    "vorder": 45,
    "position": 0,
    "text": "ز کشمیر تا پیش دریای چین"
  },
  {
    "poem_id": 1332,
    "vorder": 46,
    "position": 1,
    "text": "بر او شهریاران کنند آفرین"
  },
  {
    "poem_id": 1332,
    "vorder": 47,
    "position": 0,
    "text": "چو کودک لب از شیر مادر بشست"
  },
  {
    "poem_id": 1332,
    "vorder": 48,
    "position": 1,
    "text": "ز گهواره محمود گوید نخست"
  },
  {
    "poem_id": 1332,
    "vorder": 49,
    "position": 0,
    "text": "نپیچد کسی سر ز فرمان اوی"
  },
  {
    "poem_id": 1332,
    "vorder": 50,
    "position": 1,
    "text": "نیارد گذشتن ز پیمان اوی"
  },
  {
    "poem_id": 1332,
    "vorder": 51,
    "position": 0,
    "text": "تو نیز آفرین کن که گوینده‌ای"
  },
  {
    "poem_id": 1332,
    "vorder": 52,
    "position": 1,
    "text": "بدو نام جاوید جوینده‌ای"
  },
  {
    "poem_id": 1332,
    "vorder": 53,
    "position": 0,
    "text": "چو بیدار گشتم بجستم ز جای"
  },
  {
    "poem_id": 1332,
    "vorder": 54,
    "position": 1,
    "text": "چه مایه شب تیره بودم به پای"
  },
  {
    "poem_id": 1332,
    "vorder": 55,
    "position": 0,
    "text": "بر آن شهریار آفرین خواندم"
  },
  {
    "poem_id": 1332,
    "vorder": 56,
    "position": 1,
    "text": "نبودم درم جان بر افشاندم"
  },
  {
    "poem_id": 1332,
    "vorder": 57,
    "position": 0,
    "text": "به دل گفتم این خواب را پاسخ است"
  },
  {
    "poem_id": 1332,
    "vorder": 58,
    "position": 1,
    "text": "که آواز او بر جهان فرخ است"
  },
  {
    "poem_id": 1332,
    "vorder": 59,
    "position": 0,
    "text": "بر آن آفرین کو کند آفرین"
  },
  {
    "poem_id": 1332,
    "vorder": 60,
    "position": 1,
    "text": "بر آن بخت بیدار و فرخ زمین"
  },
  {
    "poem_id": 1332,
    "vorder": 61,
    "position": 0,
    "text": "ز فرش جهان شد چو باغ بهار"
  },
  {
    "poem_id": 1332,
    "vorder": 62,
    "position": 1,
    "text": "هوا پر ز ابر و زمین پر نگار"
  },
  {
    "poem_id": 1332,
    "vorder": 63,
    "position": 0,
    "text": "از ابر اندر آمد به هنگام نم"
  },
  {
    "poem_id": 1332,
    "vorder": 64,
    "position": 1,
    "text": "جهان شد به کردار باغ ارم"
  },
  {
    "poem_id": 1332,
    "vorder": 65,
    "position": 0,
    "text": "به ایران همه خوبی از داد اوست"
  },
  {
    "poem_id": 1332,
    "vorder": 66,
    "position": 1,
    "text": "کجا هست مردم همه یاد اوست"
  },
  {
    "poem_id": 1332,
    "vorder": 67,
    "position": 0,
    "text": "به بزم اندرون آسمان سخاست"
  },
  {
    "poem_id": 1332,
    "vorder": 68,
    "position": 1,
    "text": "به رزم اندرون تیز چنگ اژدهاست"
  },
  {
    "poem_id": 1332,
    "vorder": 69,
    "position": 0,
    "text": "به تن ژنده پیل و به جان جبرئیل"
  },
  {
    "poem_id": 1332,
    "vorder": 70,
    "position": 1,
    "text": "به کف ابر بهمن به دل رود نیل"
  },
  {
    "poem_id": 1332,
    "vorder": 71,
    "position": 0,
    "text": "سر بخت بدخواه با خشم اوی"
  },
  {
    "poem_id": 1332,
    "vorder": 72,
    "position": 1,
    "text": "چو دینار خوارست بر چشم اوی"
  },
  {
    "poem_id": 1332,
    "vorder": 73,
    "position": 0,
    "text": "نه کند آوری گیرد از باج و گنج"
  },
  {
    "poem_id": 1332,
    "vorder": 74,
    "position": 1,
    "text": "نه دل تیره دارد ز رزم و ز رنج"
  },
  {
    "poem_id": 1332,
    "vorder": 75,
    "position": 0,
    "text": "هر آن کس که دارد ز پروردگان"
  },
  {
    "poem_id": 1332,
    "vorder": 76,
    "position": 1,
    "text": "از آزاد و از نیک‌دل بردگان"
  },
  {
    "poem_id": 1332,
    "vorder": 77,
    "position": 0,
    "text": "شهنشاه را سر به سر دوست‌وار"
  },
  {
    "poem_id": 1332,
    "vorder": 78,
    "position": 1,
    "text": "به فرمان ببسته کمر استوار"
  },
  {
    "poem_id": 1332,
    "vorder": 79,
    "position": 0,
    "text": "نخستین برادرش که‌تر به سال"
  },
  {
    "poem_id": 1332,
    "vorder": 80,
    "position": 1,
    "text": "که در مردمی کس ندارد همال"
  },
  {
    "poem_id": 1332,
    "vorder": 81,
    "position": 0,
    "text": "ز گیتی پرستندهٔ فر و نصر"
  },
  {
    "poem_id": 1332,
    "vorder": 82,
    "position": 1,
    "text": "زیَد شاد در سایهٔ شاه عصر"
  },
  {
    "poem_id": 1332,
    "vorder": 83,
    "position": 0,
    "text": "کسی کش پدر ناصرالدین بود"
  },
  {
    "poem_id": 1332,
    "vorder": 84,
    "position": 1,
    "text": "سر تخت او تاج پروین بود"
  },
  {
    "poem_id": 1332,
    "vorder": 85,
    "position": 0,
    "text": "و دیگر دلاور سپهدار طوس"
  },
  {
    "poem_id": 1332,
    "vorder": 86,
    "position": 1,
    "text": "که در جنگ بر شیر دارد فسوس"
  },
  {
    "poem_id": 1332,
    "vorder": 87,
    "position": 0,
    "text": "ببخشد درم هر چه یابد ز دهر"
  },
  {
    "poem_id": 1332,
    "vorder": 88,
    "position": 1,
    "text": "همی آفرین یابد از دهر بهر"
  },
  {
    "poem_id": 1332,
    "vorder": 89,
    "position": 0,
    "text": "به یزدان بود خلق را رهنمای"
  },
  {
    "poem_id": 1332,
    "vorder": 90,
    "position": 1,
    "text": "سر شاه خواهد که باشد به جای"
  },
  {
    "poem_id": 1332,
    "vorder": 91,
    "position": 0,
    "text": "جهان بی‌سر و تاج خسرو مباد"
  },
  {
    "poem_id": 1332,
    "vorder": 92,
    "position": 1,
    "text": "همیشه بماناد جاوید و شاد"
  },
  {
    "poem_id": 1332,
    "vorder": 93,
    "position": 0,
    "text": "همیشه تن آباد با تاج و تخت"
  },
  {
    "poem_id": 1332,
    "vorder": 94,
    "position": 1,
    "text": "ز درد و غم آزاد و پیروز بخت"
  },
  {
    "poem_id": 1332,
    "vorder": 95,
    "position": 0,
    "text": "کنون باز گردم به آغاز کار"
  },
  {
    "poem_id": 1332,
    "vorder": 96,
    "position": 1,
    "text": "سوی نامهٔ نامور شهریار"
  }
]