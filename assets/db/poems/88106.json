[
  {
    "poem_id": 88106,
    "vorder": 1,
    "position": 0,
    "text": "چو لهراسب آگه شد از کار شاه"
  },
  {
    "poem_id": 88106,
    "vorder": 2,
    "position": 1,
    "text": "ز لشکر که بودند با او به راه"
  },
  {
    "poem_id": 88106,
    "vorder": 3,
    "position": 0,
    "text": "نشست از بر تخت با تاج زر"
  },
  {
    "poem_id": 88106,
    "vorder": 4,
    "position": 1,
    "text": "برفتند گردان زرین کمر"
  },
  {
    "poem_id": 88106,
    "vorder": 5,
    "position": 0,
    "text": "به آواز گفت ای سران سپاه"
  },
  {
    "poem_id": 88106,
    "vorder": 6,
    "position": 1,
    "text": "شنیده همه پند و اندرز شاه"
  },
  {
    "poem_id": 88106,
    "vorder": 7,
    "position": 0,
    "text": "هرآنکس که از تخت من نیست شاد"
  },
  {
    "poem_id": 88106,
    "vorder": 8,
    "position": 1,
    "text": "ندارد همی پند شاهان به یاد"
  },
  {
    "poem_id": 88106,
    "vorder": 9,
    "position": 0,
    "text": "مرا هرچه فرمود و گفت آن کنم"
  },
  {
    "poem_id": 88106,
    "vorder": 10,
    "position": 1,
    "text": "بکوشم به نیکی و فرمان کنم"
  },
  {
    "poem_id": 88106,
    "vorder": 11,
    "position": 0,
    "text": "شما نیز از اندرز او دست باز"
  },
  {
    "poem_id": 88106,
    "vorder": 12,
    "position": 1,
    "text": "مدارید وز من مدارید راز"
  },
  {
    "poem_id": 88106,
    "vorder": 13,
    "position": 0,
    "text": "گنهکار باشد به یزدان کسی"
  },
  {
    "poem_id": 88106,
    "vorder": 14,
    "position": 1,
    "text": "که اندرز شاهان ندارد بسی"
  },
  {
    "poem_id": 88106,
    "vorder": 15,
    "position": 0,
    "text": "بد و نیک از این هرچه دارید یاد"
  },
  {
    "poem_id": 88106,
    "vorder": 16,
    "position": 1,
    "text": "سراسر به من بر بباید گشاد"
  },
  {
    "poem_id": 88106,
    "vorder": 17,
    "position": 0,
    "text": "چنین داد پاسخ ورا پور سام"
  },
  {
    "poem_id": 88106,
    "vorder": 18,
    "position": 1,
    "text": "که خسرو ترا شاه بُردَست نام"
  },
  {
    "poem_id": 88106,
    "vorder": 19,
    "position": 0,
    "text": "پذیرفته‌ام پند و اندرز او"
  },
  {
    "poem_id": 88106,
    "vorder": 20,
    "position": 1,
    "text": "نیابد گذر پای از مرز او"
  },
  {
    "poem_id": 88106,
    "vorder": 21,
    "position": 0,
    "text": "تو شاهی و ما یکسره کهتریم"
  },
  {
    "poem_id": 88106,
    "vorder": 22,
    "position": 1,
    "text": "ز رای و ز فرمان او نگذریم"
  },
  {
    "poem_id": 88106,
    "vorder": 23,
    "position": 0,
    "text": "من و رستم و زابلی هرکه هست"
  },
  {
    "poem_id": 88106,
    "vorder": 24,
    "position": 1,
    "text": "ز مهتر تو برنگسلانیم دست"
  },
  {
    "poem_id": 88106,
    "vorder": 25,
    "position": 0,
    "text": "هرآنکس که او نه بر این ره بود"
  },
  {
    "poem_id": 88106,
    "vorder": 26,
    "position": 1,
    "text": "ز نیکی ورا دست کوته بود"
  },
  {
    "poem_id": 88106,
    "vorder": 27,
    "position": 0,
    "text": "چو لهراسب گفتار دستان شنید"
  },
  {
    "poem_id": 88106,
    "vorder": 28,
    "position": 1,
    "text": "بدو آفرین کرد و دم درکشید"
  },
  {
    "poem_id": 88106,
    "vorder": 29,
    "position": 0,
    "text": "چنین گفت کز داور راستی"
  },
  {
    "poem_id": 88106,
    "vorder": 30,
    "position": 1,
    "text": "شما را مبادا کم و کاستی"
  },
  {
    "poem_id": 88106,
    "vorder": 31,
    "position": 0,
    "text": "که یزدان شما را بدان آفرید"
  },
  {
    "poem_id": 88106,
    "vorder": 32,
    "position": 1,
    "text": "که روی بدیها شود ناپدید"
  },
  {
    "poem_id": 88106,
    "vorder": 33,
    "position": 0,
    "text": "جهاندار نیک‌اختر و شادروز"
  },
  {
    "poem_id": 88106,
    "vorder": 34,
    "position": 1,
    "text": "شما را سپرد آن زمان نیمروز"
  },
  {
    "poem_id": 88106,
    "vorder": 35,
    "position": 0,
    "text": "کنون پادشاهی جز آن هرچه هست"
  },
  {
    "poem_id": 88106,
    "vorder": 36,
    "position": 1,
    "text": "بگیرید چندان که باید به دست"
  },
  {
    "poem_id": 88106,
    "vorder": 37,
    "position": 0,
    "text": "مرا با شما گنج بخشیده نیست"
  },
  {
    "poem_id": 88106,
    "vorder": 38,
    "position": 1,
    "text": "تن و دوده و پادشاهی یکیست"
  },
  {
    "poem_id": 88106,
    "vorder": 39,
    "position": 0,
    "text": "به گودز گفت آنچه داری نهان"
  },
  {
    "poem_id": 88106,
    "vorder": 40,
    "position": 1,
    "text": "بگوی از دل ای پهلوان جهان"
  },
  {
    "poem_id": 88106,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت گودرز من یک تنم"
  },
  {
    "poem_id": 88106,
    "vorder": 42,
    "position": 1,
    "text": "چو بی‌گیو و رهام و بی بیژنم"
  },
  {
    "poem_id": 88106,
    "vorder": 43,
    "position": 0,
    "text": "بر آنم سراسر که دستان بگفت"
  },
  {
    "poem_id": 88106,
    "vorder": 44,
    "position": 1,
    "text": "جز این من ندارم سخن در نهفت"
  },
  {
    "poem_id": 88106,
    "vorder": 45,
    "position": 0,
    "text": "چنانم که با شاه گفتم نخست"
  },
  {
    "poem_id": 88106,
    "vorder": 46,
    "position": 1,
    "text": "بدین مایه نشکست عهد درست"
  },
  {
    "poem_id": 88106,
    "vorder": 47,
    "position": 0,
    "text": "تو شاهی و ما سر به سر کهتریم"
  },
  {
    "poem_id": 88106,
    "vorder": 48,
    "position": 1,
    "text": "ز پیمان و فرمان تو نگذریم"
  },
  {
    "poem_id": 88106,
    "vorder": 49,
    "position": 0,
    "text": "همه مهتران خواندند آفرین"
  },
  {
    "poem_id": 88106,
    "vorder": 50,
    "position": 1,
    "text": "به فرمان نهادند سر برزمین"
  },
  {
    "poem_id": 88106,
    "vorder": 51,
    "position": 0,
    "text": "ز گفتار ایشان دلش تازه گشت"
  },
  {
    "poem_id": 88106,
    "vorder": 52,
    "position": 1,
    "text": "ببالید و بر دیگر اندازه گشت"
  },
  {
    "poem_id": 88106,
    "vorder": 53,
    "position": 0,
    "text": "بر آن نامداران گرفت آفرین"
  },
  {
    "poem_id": 88106,
    "vorder": 54,
    "position": 1,
    "text": "که آباد بادا به گردان زمین"
  },
  {
    "poem_id": 88106,
    "vorder": 55,
    "position": 0,
    "text": "گزیدش یکی روز فرخنده‌تر"
  },
  {
    "poem_id": 88106,
    "vorder": 56,
    "position": 1,
    "text": "که تا برنهد تاج شاهی به سر"
  },
  {
    "poem_id": 88106,
    "vorder": 57,
    "position": 0,
    "text": "چنانچون فریدون فرخ‌نژاد"
  },
  {
    "poem_id": 88106,
    "vorder": 58,
    "position": 1,
    "text": "بر این مهرگان تاج بر سر نهاد"
  },
  {
    "poem_id": 88106,
    "vorder": 59,
    "position": 0,
    "text": "بدان مهرگان گزین او ز مهر"
  },
  {
    "poem_id": 88106,
    "vorder": 60,
    "position": 1,
    "text": "کز آن راستی رفت مهر سپهر"
  },
  {
    "poem_id": 88106,
    "vorder": 61,
    "position": 0,
    "text": "بیاراست ایوان کیخسروی"
  },
  {
    "poem_id": 88106,
    "vorder": 62,
    "position": 1,
    "text": "بپیراست دیوان او از نوی"
  },
  {
    "poem_id": 88106,
    "vorder": 63,
    "position": 0,
    "text": "چنینست گیتی فراز و نشیب"
  },
  {
    "poem_id": 88106,
    "vorder": 64,
    "position": 1,
    "text": "یکی آورد دیگری را نهیب"
  },
  {
    "poem_id": 88106,
    "vorder": 65,
    "position": 0,
    "text": "از این کار خسرو به بیرون شدیم"
  },
  {
    "poem_id": 88106,
    "vorder": 66,
    "position": 1,
    "text": "سوی کار لهراسب بازآمدیم"
  },
  {
    "poem_id": 88106,
    "vorder": 67,
    "position": 0,
    "text": "به پیروزی شهریار بلند"
  },
  {
    "poem_id": 88106,
    "vorder": 68,
    "position": 1,
    "text": "کز اویست امید نیک و گزند"
  },
  {
    "poem_id": 88106,
    "vorder": 69,
    "position": 0,
    "text": "به نیکی رساند دل دوستان"
  },
  {
    "poem_id": 88106,
    "vorder": 70,
    "position": 1,
    "text": "گزند آید از وی به ناراستان"
  }
]