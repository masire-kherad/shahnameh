[
  {
    "poem_id": 1855,
    "vorder": 1,
    "position": 0,
    "text": "دبیر جهاندیده را پیش خواند"
  },
  {
    "poem_id": 1855,
    "vorder": 2,
    "position": 1,
    "text": "بران پیشگاه بزرگی نشاند"
  },
  {
    "poem_id": 1855,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا نامه پاسخ نوشت"
  },
  {
    "poem_id": 1855,
    "vorder": 4,
    "position": 1,
    "text": "بیاراست چون مرغزار بهشت"
  },
  {
    "poem_id": 1855,
    "vorder": 5,
    "position": 0,
    "text": "ز بس بند و پیوند و نیکو سخن"
  },
  {
    "poem_id": 1855,
    "vorder": 6,
    "position": 1,
    "text": "ازان روز تا روزگار کهن"
  },
  {
    "poem_id": 1855,
    "vorder": 7,
    "position": 0,
    "text": "چوگشت از نوشتن نویسنده سیر"
  },
  {
    "poem_id": 1855,
    "vorder": 8,
    "position": 1,
    "text": "نگه کرد قیصر سواری دلیر"
  },
  {
    "poem_id": 1855,
    "vorder": 9,
    "position": 0,
    "text": "سخن گوی و روشن دل و یادگیر"
  },
  {
    "poem_id": 1855,
    "vorder": 10,
    "position": 1,
    "text": "خردمند و گویا و گرد و دبیر"
  },
  {
    "poem_id": 1855,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت رو پیش خسرو بگوی"
  },
  {
    "poem_id": 1855,
    "vorder": 12,
    "position": 1,
    "text": "که ای شاه بینا دل و راه جوی"
  },
  {
    "poem_id": 1855,
    "vorder": 13,
    "position": 0,
    "text": "مرا هم سلیحست و هم زر به گنج"
  },
  {
    "poem_id": 1855,
    "vorder": 14,
    "position": 1,
    "text": "نیاورد باید کسی را به رنج"
  },
  {
    "poem_id": 1855,
    "vorder": 15,
    "position": 0,
    "text": "وگر نیستیمان ز هر کشوری"
  },
  {
    "poem_id": 1855,
    "vorder": 16,
    "position": 1,
    "text": "درم خواستیمی ز هر مهتری"
  },
  {
    "poem_id": 1855,
    "vorder": 17,
    "position": 0,
    "text": "بدان تا تواز روم با کام خویش"
  },
  {
    "poem_id": 1855,
    "vorder": 18,
    "position": 1,
    "text": "به ایران گذشتی به آرام خویش"
  },
  {
    "poem_id": 1855,
    "vorder": 19,
    "position": 0,
    "text": "مباش اندرین بوم تیره روان"
  },
  {
    "poem_id": 1855,
    "vorder": 20,
    "position": 1,
    "text": "چنین است کردار چرخ روان"
  },
  {
    "poem_id": 1855,
    "vorder": 21,
    "position": 0,
    "text": "که گاهی پناهست و گاهی گزند"
  },
  {
    "poem_id": 1855,
    "vorder": 22,
    "position": 1,
    "text": "گهی با زیانیم و گه سودمند"
  },
  {
    "poem_id": 1855,
    "vorder": 23,
    "position": 0,
    "text": "کنون تا سلیح و سپاه و درم"
  },
  {
    "poem_id": 1855,
    "vorder": 24,
    "position": 1,
    "text": "فراز آورم تو نباشی دژم"
  },
  {
    "poem_id": 1855,
    "vorder": 25,
    "position": 0,
    "text": "بر خسرو آمد فرستاده مرد"
  },
  {
    "poem_id": 1855,
    "vorder": 26,
    "position": 1,
    "text": "سخنهای قیصر همه یاد کرد"
  }
]