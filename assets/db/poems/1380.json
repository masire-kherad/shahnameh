[
  {
    "poem_id": 1380,
    "vorder": 1,
    "position": 0,
    "text": "یکایک به شاه آمد این آگهی"
  },
  {
    "poem_id": 1380,
    "vorder": 2,
    "position": 1,
    "text": "که سام آمد از کوه با فرّهی"
  },
  {
    "poem_id": 1380,
    "vorder": 3,
    "position": 0,
    "text": "بدان آگهی شد منوچهر شاد"
  },
  {
    "poem_id": 1380,
    "vorder": 4,
    "position": 1,
    "text": "بسی از جهان آفرین کرد یاد"
  },
  {
    "poem_id": 1380,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا نوذر نامدار"
  },
  {
    "poem_id": 1380,
    "vorder": 6,
    "position": 1,
    "text": "شود تازیان پیش سام سوار"
  },
  {
    "poem_id": 1380,
    "vorder": 7,
    "position": 0,
    "text": "کند آفرین کیانی بر اوی"
  },
  {
    "poem_id": 1380,
    "vorder": 8,
    "position": 1,
    "text": "بدان شادمانی که بگشاد روی"
  },
  {
    "poem_id": 1380,
    "vorder": 9,
    "position": 0,
    "text": "بفرمایدش تا سوی شهریار"
  },
  {
    "poem_id": 1380,
    "vorder": 10,
    "position": 1,
    "text": "شود تا سخن‌ها کند خواستار"
  },
  {
    "poem_id": 1380,
    "vorder": 11,
    "position": 0,
    "text": "ببیند یکی روی دستان سام"
  },
  {
    "poem_id": 1380,
    "vorder": 12,
    "position": 1,
    "text": "به دیدار ایشان شود شادکام"
  },
  {
    "poem_id": 1380,
    "vorder": 13,
    "position": 0,
    "text": "و زین جا سوی زابلستان شود"
  },
  {
    "poem_id": 1380,
    "vorder": 14,
    "position": 1,
    "text": "بر آیین خسرو پرستان شود"
  },
  {
    "poem_id": 1380,
    "vorder": 15,
    "position": 0,
    "text": "چو نوذر بر سام نیرم رسید"
  },
  {
    "poem_id": 1380,
    "vorder": 16,
    "position": 1,
    "text": "یکی نو جهان پهلوان را بدید"
  },
  {
    "poem_id": 1380,
    "vorder": 17,
    "position": 0,
    "text": "فرود آمد از باره سام سوار"
  },
  {
    "poem_id": 1380,
    "vorder": 18,
    "position": 1,
    "text": "گرفتند مر یک‌دگر را کنار"
  },
  {
    "poem_id": 1380,
    "vorder": 19,
    "position": 0,
    "text": "ز شاه و ز گردان بپرسید سام"
  },
  {
    "poem_id": 1380,
    "vorder": 20,
    "position": 1,
    "text": "از ایشان بدو داد نوذر پیام"
  },
  {
    "poem_id": 1380,
    "vorder": 21,
    "position": 0,
    "text": "چو بشنید پیغام شاه بزرگ"
  },
  {
    "poem_id": 1380,
    "vorder": 22,
    "position": 1,
    "text": "زمین را ببوسید سام سترگ"
  },
  {
    "poem_id": 1380,
    "vorder": 23,
    "position": 0,
    "text": "دوان سوی درگاه بنهاد روی"
  },
  {
    "poem_id": 1380,
    "vorder": 24,
    "position": 1,
    "text": "چنان کش بفرمود دیهیم جوی"
  },
  {
    "poem_id": 1380,
    "vorder": 25,
    "position": 0,
    "text": "چو آمد به نزدیکی شهریار"
  },
  {
    "poem_id": 1380,
    "vorder": 26,
    "position": 1,
    "text": "سپهبد پذیره شدش از کنار"
  },
  {
    "poem_id": 1380,
    "vorder": 27,
    "position": 0,
    "text": "درفش منوچهر چون دید سام"
  },
  {
    "poem_id": 1380,
    "vorder": 28,
    "position": 1,
    "text": "پیاده شد از باره بگذارد گام"
  },
  {
    "poem_id": 1380,
    "vorder": 29,
    "position": 0,
    "text": "منوچهر فرمود تا برنشست"
  },
  {
    "poem_id": 1380,
    "vorder": 30,
    "position": 1,
    "text": "مر آن پاک‌دل گرد خسرو پرست"
  },
  {
    "poem_id": 1380,
    "vorder": 31,
    "position": 0,
    "text": "سوی تخت و ایوان نهادند روی"
  },
  {
    "poem_id": 1380,
    "vorder": 32,
    "position": 1,
    "text": "چه دیهیم دار و چه دیهیم جوی"
  },
  {
    "poem_id": 1380,
    "vorder": 33,
    "position": 0,
    "text": "منوچهر برگاه بنشست شاد"
  },
  {
    "poem_id": 1380,
    "vorder": 34,
    "position": 1,
    "text": "کلاه بزرگی به سر برنهاد"
  },
  {
    "poem_id": 1380,
    "vorder": 35,
    "position": 0,
    "text": "به یک دست قارن به یک دست سام"
  },
  {
    "poem_id": 1380,
    "vorder": 36,
    "position": 1,
    "text": "نشستند روشن‌دل و شادکام"
  },
  {
    "poem_id": 1380,
    "vorder": 37,
    "position": 0,
    "text": "پس آراسته زال را پیش شاه"
  },
  {
    "poem_id": 1380,
    "vorder": 38,
    "position": 1,
    "text": "به زرّین عمود و به رزّین کلاه"
  },
  {
    "poem_id": 1380,
    "vorder": 39,
    "position": 0,
    "text": "گرازان بیاورد سالار بار"
  },
  {
    "poem_id": 1380,
    "vorder": 40,
    "position": 1,
    "text": "شگفتی بماند اندر او شهریار"
  },
  {
    "poem_id": 1380,
    "vorder": 41,
    "position": 0,
    "text": "بر آن برز بالای آن خوب چهر"
  },
  {
    "poem_id": 1380,
    "vorder": 42,
    "position": 1,
    "text": "تو گفتی که آرام جان است و مهر"
  },
  {
    "poem_id": 1380,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت مر سام را شهریار"
  },
  {
    "poem_id": 1380,
    "vorder": 44,
    "position": 1,
    "text": "که از من تو این را به زنهاردار"
  },
  {
    "poem_id": 1380,
    "vorder": 45,
    "position": 0,
    "text": "به خیره میازارش از هیچ روی"
  },
  {
    "poem_id": 1380,
    "vorder": 46,
    "position": 1,
    "text": "به کس شادمانه مشو جز بدوی"
  },
  {
    "poem_id": 1380,
    "vorder": 47,
    "position": 0,
    "text": "که فرّ کیان دارد و چنگ شیر"
  },
  {
    "poem_id": 1380,
    "vorder": 48,
    "position": 1,
    "text": "دل هوشمندان و آهنگ شیر"
  },
  {
    "poem_id": 1380,
    "vorder": 49,
    "position": 0,
    "text": "پس از کار سیمرغ و کوه بلند"
  },
  {
    "poem_id": 1380,
    "vorder": 50,
    "position": 1,
    "text": "و زان تا چرا خوار شد ارجمند"
  },
  {
    "poem_id": 1380,
    "vorder": 51,
    "position": 0,
    "text": "یکایک همه سام با او بگفت"
  },
  {
    "poem_id": 1380,
    "vorder": 52,
    "position": 1,
    "text": "هم از آشکارا هم اندر نهفت"
  },
  {
    "poem_id": 1380,
    "vorder": 53,
    "position": 0,
    "text": "و ز افگندن زال بگشاد راز"
  },
  {
    "poem_id": 1380,
    "vorder": 54,
    "position": 1,
    "text": "که چون گشت با او سپهر از فراز"
  },
  {
    "poem_id": 1380,
    "vorder": 55,
    "position": 0,
    "text": "سرانجام گیتی ز سیمرغ و زال"
  },
  {
    "poem_id": 1380,
    "vorder": 56,
    "position": 1,
    "text": "پر از داستان شد به بسیار سال"
  },
  {
    "poem_id": 1380,
    "vorder": 57,
    "position": 0,
    "text": "برفتم به فرمان گیهان خدای"
  },
  {
    "poem_id": 1380,
    "vorder": 58,
    "position": 1,
    "text": "به البرز کوه اندر آن زشت جای"
  },
  {
    "poem_id": 1380,
    "vorder": 59,
    "position": 0,
    "text": "یکی کوه دیدم سر اندر سحاب"
  },
  {
    "poem_id": 1380,
    "vorder": 60,
    "position": 1,
    "text": "سپهری است گفتی ز خارا بر آب"
  },
  {
    "poem_id": 1380,
    "vorder": 61,
    "position": 0,
    "text": "برو بر نشیمی چو کاخ بلند"
  },
  {
    "poem_id": 1380,
    "vorder": 62,
    "position": 1,
    "text": "ز هر سوی بر او بسته راه گزند"
  },
  {
    "poem_id": 1380,
    "vorder": 63,
    "position": 0,
    "text": "بدو اندرون بچهٔ مرغ و زال"
  },
  {
    "poem_id": 1380,
    "vorder": 64,
    "position": 1,
    "text": "تو گفتی که هستند هر دو همال"
  },
  {
    "poem_id": 1380,
    "vorder": 65,
    "position": 0,
    "text": "همی بوی مهر آمد از باد اوی"
  },
  {
    "poem_id": 1380,
    "vorder": 66,
    "position": 1,
    "text": "به دل راحت آمد هم از یاد اوی"
  },
  {
    "poem_id": 1380,
    "vorder": 67,
    "position": 0,
    "text": "ابا داور راست گفتم به راز"
  },
  {
    "poem_id": 1380,
    "vorder": 68,
    "position": 1,
    "text": "که ای آفرینندهٔ بی‌نیاز"
  },
  {
    "poem_id": 1380,
    "vorder": 69,
    "position": 0,
    "text": "رسیده به هر جای برهان تو"
  },
  {
    "poem_id": 1380,
    "vorder": 70,
    "position": 1,
    "text": "نگردد فلک جز به فرمان تو"
  },
  {
    "poem_id": 1380,
    "vorder": 71,
    "position": 0,
    "text": "یکی بنده‌ام با تنی پر گناه"
  },
  {
    "poem_id": 1380,
    "vorder": 72,
    "position": 1,
    "text": "به پیش خداوند خورشید و ماه"
  },
  {
    "poem_id": 1380,
    "vorder": 73,
    "position": 0,
    "text": "امیدم به بخشایش تو است بس"
  },
  {
    "poem_id": 1380,
    "vorder": 74,
    "position": 1,
    "text": "به چیزی دگر نیستم دسترس"
  },
  {
    "poem_id": 1380,
    "vorder": 75,
    "position": 0,
    "text": "تو این بندهٔ مرغ پرورده را"
  },
  {
    "poem_id": 1380,
    "vorder": 76,
    "position": 1,
    "text": "به خواری و زاری برآورده را"
  },
  {
    "poem_id": 1380,
    "vorder": 77,
    "position": 0,
    "text": "همی پرّ پوشد به جای حریر"
  },
  {
    "poem_id": 1380,
    "vorder": 78,
    "position": 1,
    "text": "مزد گوشت هنگام پستان شیر"
  },
  {
    "poem_id": 1380,
    "vorder": 79,
    "position": 0,
    "text": "به بد مهری من روانم مسوز"
  },
  {
    "poem_id": 1380,
    "vorder": 80,
    "position": 1,
    "text": "به من باز بخش و دلم بر فروز"
  },
  {
    "poem_id": 1380,
    "vorder": 81,
    "position": 0,
    "text": "به فرمان یزدان چو این گفته شد"
  },
  {
    "poem_id": 1380,
    "vorder": 82,
    "position": 1,
    "text": "نیایش همانگه پذیرفته شد"
  },
  {
    "poem_id": 1380,
    "vorder": 83,
    "position": 0,
    "text": "بزد پرّ سیمرغ و بر شد به ابر"
  },
  {
    "poem_id": 1380,
    "vorder": 84,
    "position": 1,
    "text": "همی حلقه زد بر سر مرد گبر"
  },
  {
    "poem_id": 1380,
    "vorder": 85,
    "position": 0,
    "text": "ز کوه اندر آمد چو ابر بهار"
  },
  {
    "poem_id": 1380,
    "vorder": 86,
    "position": 1,
    "text": "گرفته تن زال را بر کنار"
  },
  {
    "poem_id": 1380,
    "vorder": 87,
    "position": 0,
    "text": "به پیش من آورد چون دایه‌ای"
  },
  {
    "poem_id": 1380,
    "vorder": 88,
    "position": 1,
    "text": "که در مهر باشد ورا مایه‌ای"
  },
  {
    "poem_id": 1380,
    "vorder": 89,
    "position": 0,
    "text": "من آوردمش نزد شاه جهان"
  },
  {
    "poem_id": 1380,
    "vorder": 90,
    "position": 1,
    "text": "همه آشکاراش کردم نهان"
  },
  {
    "poem_id": 1380,
    "vorder": 91,
    "position": 0,
    "text": "بفرمود پس شاه با موبدان"
  },
  {
    "poem_id": 1380,
    "vorder": 92,
    "position": 1,
    "text": "ستاره‌شناسان و هم بخردان"
  },
  {
    "poem_id": 1380,
    "vorder": 93,
    "position": 0,
    "text": "که جویند تا اختر زال چیست"
  },
  {
    "poem_id": 1380,
    "vorder": 94,
    "position": 1,
    "text": "بر آن اختر از بخت سالار کیست"
  },
  {
    "poem_id": 1380,
    "vorder": 95,
    "position": 0,
    "text": "چو گیرد بلندی چه خواهد بدن"
  },
  {
    "poem_id": 1380,
    "vorder": 96,
    "position": 1,
    "text": "همی داستان از چه خواهد زدن"
  },
  {
    "poem_id": 1380,
    "vorder": 97,
    "position": 0,
    "text": "ستاره‌شناسان هم اندر زمان"
  },
  {
    "poem_id": 1380,
    "vorder": 98,
    "position": 1,
    "text": "از اختر گرفتند پیدا نشان"
  },
  {
    "poem_id": 1380,
    "vorder": 99,
    "position": 0,
    "text": "بگفتند با شاه دیهیم دار"
  },
  {
    "poem_id": 1380,
    "vorder": 100,
    "position": 1,
    "text": "که شادان بزی تا بود روزگار"
  },
  {
    "poem_id": 1380,
    "vorder": 101,
    "position": 0,
    "text": "که او پهلوانی بود نامدار"
  },
  {
    "poem_id": 1380,
    "vorder": 102,
    "position": 1,
    "text": "سرافراز و هشیار و گرد و سوار"
  },
  {
    "poem_id": 1380,
    "vorder": 103,
    "position": 0,
    "text": "چو بشنید شاه این سخن شاد شد"
  },
  {
    "poem_id": 1380,
    "vorder": 104,
    "position": 1,
    "text": "دل پهلوان از غم آزاد شد"
  },
  {
    "poem_id": 1380,
    "vorder": 105,
    "position": 0,
    "text": "یکی خلعتی ساخت شاه زمین"
  },
  {
    "poem_id": 1380,
    "vorder": 106,
    "position": 1,
    "text": "که کردند هر کس بدو آفرین"
  },
  {
    "poem_id": 1380,
    "vorder": 107,
    "position": 0,
    "text": "از اسپان تازی به زرین ستام"
  },
  {
    "poem_id": 1380,
    "vorder": 108,
    "position": 1,
    "text": "ز شمشیر هندی به زرّین نیام"
  },
  {
    "poem_id": 1380,
    "vorder": 109,
    "position": 0,
    "text": "ز دینار و خز و ز یاقوت و زر"
  },
  {
    "poem_id": 1380,
    "vorder": 110,
    "position": 1,
    "text": "ز گستردنی‌های بسیار مر"
  },
  {
    "poem_id": 1380,
    "vorder": 111,
    "position": 0,
    "text": "غلامان رومی به دیبای روم"
  },
  {
    "poem_id": 1380,
    "vorder": 112,
    "position": 1,
    "text": "همه گوهرش پیکر و زرش بوم"
  },
  {
    "poem_id": 1380,
    "vorder": 113,
    "position": 0,
    "text": "زبرجد طبق‌ها و پیروزه جام"
  },
  {
    "poem_id": 1380,
    "vorder": 114,
    "position": 1,
    "text": "چه از زرّ سرخ و چه از سیم خام"
  },
  {
    "poem_id": 1380,
    "vorder": 115,
    "position": 0,
    "text": "پر از مشک و کافور و پر زعفران"
  },
  {
    "poem_id": 1380,
    "vorder": 116,
    "position": 1,
    "text": "همه پیش بردند فرمان بران"
  },
  {
    "poem_id": 1380,
    "vorder": 117,
    "position": 0,
    "text": "همان جوشن و ترگ و برگستوان"
  },
  {
    "poem_id": 1380,
    "vorder": 118,
    "position": 1,
    "text": "همان نیزه و تیر و گُرز گران"
  },
  {
    "poem_id": 1380,
    "vorder": 119,
    "position": 0,
    "text": "همان تخت پیروزه و تاج زر"
  },
  {
    "poem_id": 1380,
    "vorder": 120,
    "position": 1,
    "text": "همان مهر یاقوت و زرین کمر"
  },
  {
    "poem_id": 1380,
    "vorder": 121,
    "position": 0,
    "text": "و زان پس منوچهر عهدی نوشت"
  },
  {
    "poem_id": 1380,
    "vorder": 122,
    "position": 1,
    "text": "سراسر ستایش به سان بهشت"
  },
  {
    "poem_id": 1380,
    "vorder": 123,
    "position": 0,
    "text": "همه کابل و زابل و مای و هند"
  },
  {
    "poem_id": 1380,
    "vorder": 124,
    "position": 1,
    "text": "ز دریای چین تا به دریای سند"
  },
  {
    "poem_id": 1380,
    "vorder": 125,
    "position": 0,
    "text": "ز زابلستان تا بدان روی بست"
  },
  {
    "poem_id": 1380,
    "vorder": 126,
    "position": 1,
    "text": "به نوّی نوشتند عهدی درست"
  },
  {
    "poem_id": 1380,
    "vorder": 127,
    "position": 0,
    "text": "چو این عهد و خلعت بیاراستند"
  },
  {
    "poem_id": 1380,
    "vorder": 128,
    "position": 1,
    "text": "پس اسپ جهان پهلوان خواستند"
  },
  {
    "poem_id": 1380,
    "vorder": 129,
    "position": 0,
    "text": "چو این کرده شد سام بر پای خاست"
  },
  {
    "poem_id": 1380,
    "vorder": 130,
    "position": 1,
    "text": "که ای مهربان مهتر داد و راست"
  },
  {
    "poem_id": 1380,
    "vorder": 131,
    "position": 0,
    "text": "ز ماهی بر اندیشه تا چرخ ماه"
  },
  {
    "poem_id": 1380,
    "vorder": 132,
    "position": 1,
    "text": "چو تو شاه ننهاد بر سر کلاه"
  },
  {
    "poem_id": 1380,
    "vorder": 133,
    "position": 0,
    "text": "به مهر و به داد و به خوی و خرد"
  },
  {
    "poem_id": 1380,
    "vorder": 134,
    "position": 1,
    "text": "زمانه همی از تو رامش برد"
  },
  {
    "poem_id": 1380,
    "vorder": 135,
    "position": 0,
    "text": "همه گنج گیتی به چشم تو خوار"
  },
  {
    "poem_id": 1380,
    "vorder": 136,
    "position": 1,
    "text": "مبادا ز تو نام تو یادگار"
  },
  {
    "poem_id": 1380,
    "vorder": 137,
    "position": 0,
    "text": "فرود آمد و تخت را داد بوس"
  },
  {
    "poem_id": 1380,
    "vorder": 138,
    "position": 1,
    "text": "ببستند بر کوههٔ پیل کوس"
  },
  {
    "poem_id": 1380,
    "vorder": 139,
    "position": 0,
    "text": "سوی زابلستان نهادند روی"
  },
  {
    "poem_id": 1380,
    "vorder": 140,
    "position": 1,
    "text": "نظاره بر او بر همه شهر و کوی"
  },
  {
    "poem_id": 1380,
    "vorder": 141,
    "position": 0,
    "text": "چو آمد به نزدیکی نیمروز"
  },
  {
    "poem_id": 1380,
    "vorder": 142,
    "position": 1,
    "text": "خبر شد ز سالار گیتی فروز"
  },
  {
    "poem_id": 1380,
    "vorder": 143,
    "position": 0,
    "text": "بیاراسته سیستان چون بهشت"
  },
  {
    "poem_id": 1380,
    "vorder": 144,
    "position": 1,
    "text": "گلش مشک سارا بُد و زرّ خشت"
  },
  {
    "poem_id": 1380,
    "vorder": 145,
    "position": 0,
    "text": "بسی مشک و دینار بر ریختند"
  },
  {
    "poem_id": 1380,
    "vorder": 146,
    "position": 1,
    "text": "بسی زعفران و درم بیختند"
  },
  {
    "poem_id": 1380,
    "vorder": 147,
    "position": 0,
    "text": "یکی شادمانی بُد اندر جهان"
  },
  {
    "poem_id": 1380,
    "vorder": 148,
    "position": 1,
    "text": "سراسر میان کهان و مهان"
  },
  {
    "poem_id": 1380,
    "vorder": 149,
    "position": 0,
    "text": "هر آن‌جا که بد مهتری نامجوی"
  },
  {
    "poem_id": 1380,
    "vorder": 150,
    "position": 1,
    "text": "ز گیتی سوی سام بنهاد روی"
  },
  {
    "poem_id": 1380,
    "vorder": 151,
    "position": 0,
    "text": "که فرخنده بادا پی این جوان"
  },
  {
    "poem_id": 1380,
    "vorder": 152,
    "position": 1,
    "text": "بر این پاک دل نامور پهلوان"
  },
  {
    "poem_id": 1380,
    "vorder": 153,
    "position": 0,
    "text": "چو بر پهلوان آفرین خواندند"
  },
  {
    "poem_id": 1380,
    "vorder": 154,
    "position": 1,
    "text": "ابر زال زر گوهر افشاندند"
  },
  {
    "poem_id": 1380,
    "vorder": 155,
    "position": 0,
    "text": "نشست آنگهی سام با زیب و جام"
  },
  {
    "poem_id": 1380,
    "vorder": 156,
    "position": 1,
    "text": "همی داد چیز و همی راند کام"
  },
  {
    "poem_id": 1380,
    "vorder": 157,
    "position": 0,
    "text": "کسی کو به خلعت سزاوار بود"
  },
  {
    "poem_id": 1380,
    "vorder": 158,
    "position": 1,
    "text": "خردمند بود و جهاندار بود"
  },
  {
    "poem_id": 1380,
    "vorder": 159,
    "position": 0,
    "text": "براندازه‌شان خلعت آراستند"
  },
  {
    "poem_id": 1380,
    "vorder": 160,
    "position": 1,
    "text": "همه پایهٔ برتری خواستند"
  },
  {
    "poem_id": 1380,
    "vorder": 161,
    "position": 0,
    "text": "جهاندیدگان را ز کشور بخواند"
  },
  {
    "poem_id": 1380,
    "vorder": 162,
    "position": 1,
    "text": "سخن‌های بایسته چندی براند"
  },
  {
    "poem_id": 1380,
    "vorder": 163,
    "position": 0,
    "text": "چنین گفت با نامور بخردان"
  },
  {
    "poem_id": 1380,
    "vorder": 164,
    "position": 1,
    "text": "که ای پاک و بیدار دل موبدان"
  },
  {
    "poem_id": 1380,
    "vorder": 165,
    "position": 0,
    "text": "چنین است فرمان هشیار شاه"
  },
  {
    "poem_id": 1380,
    "vorder": 166,
    "position": 1,
    "text": "که لشکر همی راند باید به راه"
  },
  {
    "poem_id": 1380,
    "vorder": 167,
    "position": 0,
    "text": "سوی گرگساران و مازندران"
  },
  {
    "poem_id": 1380,
    "vorder": 168,
    "position": 1,
    "text": "همی راند خواهم سپاهی گران"
  },
  {
    "poem_id": 1380,
    "vorder": 169,
    "position": 0,
    "text": "بماند به نزد شما این پسر"
  },
  {
    "poem_id": 1380,
    "vorder": 170,
    "position": 1,
    "text": "که همتای جان است و جفت جگر"
  },
  {
    "poem_id": 1380,
    "vorder": 171,
    "position": 0,
    "text": "دل و جانم ایدر بماند همی"
  },
  {
    "poem_id": 1380,
    "vorder": 172,
    "position": 1,
    "text": "مژه خون دل برفشاند همی"
  },
  {
    "poem_id": 1380,
    "vorder": 173,
    "position": 0,
    "text": "به گاه جوانی و کند آوری"
  },
  {
    "poem_id": 1380,
    "vorder": 174,
    "position": 1,
    "text": "یکی بیهده ساختم داوری"
  },
  {
    "poem_id": 1380,
    "vorder": 175,
    "position": 0,
    "text": "پسر داد یزدان بیانداختم"
  },
  {
    "poem_id": 1380,
    "vorder": 176,
    "position": 1,
    "text": "ز بی‌دانشی ارج نشناختم"
  },
  {
    "poem_id": 1380,
    "vorder": 177,
    "position": 0,
    "text": "گرانمایه سیمرغ برداشتش"
  },
  {
    "poem_id": 1380,
    "vorder": 178,
    "position": 1,
    "text": "همان آفریننده بگماشتش"
  },
  {
    "poem_id": 1380,
    "vorder": 179,
    "position": 0,
    "text": "بپرورد او را چو سرو بلند"
  },
  {
    "poem_id": 1380,
    "vorder": 180,
    "position": 1,
    "text": "مرا خوار بد مرغ را ارجمند"
  },
  {
    "poem_id": 1380,
    "vorder": 181,
    "position": 0,
    "text": "چو هنگام بخشایش آمد فراز"
  },
  {
    "poem_id": 1380,
    "vorder": 182,
    "position": 1,
    "text": "جهاندار یزدان به من داد باز"
  },
  {
    "poem_id": 1380,
    "vorder": 183,
    "position": 0,
    "text": "بدانید کاین زینهار من است"
  },
  {
    "poem_id": 1380,
    "vorder": 184,
    "position": 1,
    "text": "به نزد شما یادگار من است"
  },
  {
    "poem_id": 1380,
    "vorder": 185,
    "position": 0,
    "text": "گرامیش دارید و پندش دهید"
  },
  {
    "poem_id": 1380,
    "vorder": 186,
    "position": 1,
    "text": "همه راه و رای بلندش دهید"
  },
  {
    "poem_id": 1380,
    "vorder": 187,
    "position": 0,
    "text": "سوی زال کرد آنگهی سام روی"
  },
  {
    "poem_id": 1380,
    "vorder": 188,
    "position": 1,
    "text": "که داد و دهش گیر و آرام جوی"
  },
  {
    "poem_id": 1380,
    "vorder": 189,
    "position": 0,
    "text": "چنان دان که زابلستان خان تست"
  },
  {
    "poem_id": 1380,
    "vorder": 190,
    "position": 1,
    "text": "جهان سر به سر زیر فرمان تست"
  },
  {
    "poem_id": 1380,
    "vorder": 191,
    "position": 0,
    "text": "تو را خان و مان باید آبادتر"
  },
  {
    "poem_id": 1380,
    "vorder": 192,
    "position": 1,
    "text": "دل دوستداران تو شادتر"
  },
  {
    "poem_id": 1380,
    "vorder": 193,
    "position": 0,
    "text": "کلید در گنج‌ها پیش تو است"
  },
  {
    "poem_id": 1380,
    "vorder": 194,
    "position": 1,
    "text": "دلم شاد و غمگین به کم بیش تو است"
  },
  {
    "poem_id": 1380,
    "vorder": 195,
    "position": 0,
    "text": "به سام آنگهی گفت زال جوان"
  },
  {
    "poem_id": 1380,
    "vorder": 196,
    "position": 1,
    "text": "که چون زیست خواهم من ایدر نوان"
  },
  {
    "poem_id": 1380,
    "vorder": 197,
    "position": 0,
    "text": "جدا پیش‌تر زین کجا داشتی"
  },
  {
    "poem_id": 1380,
    "vorder": 198,
    "position": 1,
    "text": "مدارم که آمد گه آشتی"
  },
  {
    "poem_id": 1380,
    "vorder": 199,
    "position": 0,
    "text": "کسی کو ز مادر گنه کار زاد"
  },
  {
    "poem_id": 1380,
    "vorder": 200,
    "position": 1,
    "text": "من آنم سزد گر بنالم ز داد"
  },
  {
    "poem_id": 1380,
    "vorder": 201,
    "position": 0,
    "text": "گهی زیر چنگال مرغ اندرون"
  },
  {
    "poem_id": 1380,
    "vorder": 202,
    "position": 1,
    "text": "چمیدن به خاک و چریدن ز خون"
  },
  {
    "poem_id": 1380,
    "vorder": 203,
    "position": 0,
    "text": "کنون دور ماندم ز پروردگار"
  },
  {
    "poem_id": 1380,
    "vorder": 204,
    "position": 1,
    "text": "چنین پروراند مرا روزگار"
  },
  {
    "poem_id": 1380,
    "vorder": 205,
    "position": 0,
    "text": "ز گل بهرهٔ من به جز خار نیست"
  },
  {
    "poem_id": 1380,
    "vorder": 206,
    "position": 1,
    "text": "بدین با جهاندار پیگار نیست"
  },
  {
    "poem_id": 1380,
    "vorder": 207,
    "position": 0,
    "text": "بدو گفت پرداختن دل سزاست"
  },
  {
    "poem_id": 1380,
    "vorder": 208,
    "position": 1,
    "text": "بپرداز و بر گوی هرچت هواست"
  },
  {
    "poem_id": 1380,
    "vorder": 209,
    "position": 0,
    "text": "ستاره شمر مرد اخترگرای"
  },
  {
    "poem_id": 1380,
    "vorder": 210,
    "position": 1,
    "text": "چنین زد تو را ز اختر نیک رای"
  },
  {
    "poem_id": 1380,
    "vorder": 211,
    "position": 0,
    "text": "که ایدر تو را باشد آرامگاه"
  },
  {
    "poem_id": 1380,
    "vorder": 212,
    "position": 1,
    "text": "هم ایدر سپاه و هم ایدر کلاه"
  },
  {
    "poem_id": 1380,
    "vorder": 213,
    "position": 0,
    "text": "گذر نیست بر حکم گردان سپهر"
  },
  {
    "poem_id": 1380,
    "vorder": 214,
    "position": 1,
    "text": "هم ایدر بگسترد بایدت مهر"
  },
  {
    "poem_id": 1380,
    "vorder": 215,
    "position": 0,
    "text": "کنون گرد خویش اندر آور گروه"
  },
  {
    "poem_id": 1380,
    "vorder": 216,
    "position": 1,
    "text": "سواران و مردان دانش پژوه"
  },
  {
    "poem_id": 1380,
    "vorder": 217,
    "position": 0,
    "text": "بیاموز و بشنو ز هر دانشی"
  },
  {
    "poem_id": 1380,
    "vorder": 218,
    "position": 1,
    "text": "که یابی ز هر دانشی رامشی"
  },
  {
    "poem_id": 1380,
    "vorder": 219,
    "position": 0,
    "text": "ز خورد و ز بخشش میاسای هیچ"
  },
  {
    "poem_id": 1380,
    "vorder": 220,
    "position": 1,
    "text": "همه دانش و داد دادن بسیچ"
  },
  {
    "poem_id": 1380,
    "vorder": 221,
    "position": 0,
    "text": "بگفت این و برخاست آوای کوس"
  },
  {
    "poem_id": 1380,
    "vorder": 222,
    "position": 1,
    "text": "هوا قیرگون شد زمین آبنوس"
  },
  {
    "poem_id": 1380,
    "vorder": 223,
    "position": 0,
    "text": "خروشیدن زنگ و هندی درای"
  },
  {
    "poem_id": 1380,
    "vorder": 224,
    "position": 1,
    "text": "برآمد ز دهلیز پرده سرای"
  },
  {
    "poem_id": 1380,
    "vorder": 225,
    "position": 0,
    "text": "سپهبد سوی جنگ بنهاد روی"
  },
  {
    "poem_id": 1380,
    "vorder": 226,
    "position": 1,
    "text": "یکی لشکری ساخته جنگجوی"
  },
  {
    "poem_id": 1380,
    "vorder": 227,
    "position": 0,
    "text": "بشد زال با او دو منزل به راه"
  },
  {
    "poem_id": 1380,
    "vorder": 228,
    "position": 1,
    "text": "بدان تا پدر چون گذارد سپاه"
  },
  {
    "poem_id": 1380,
    "vorder": 229,
    "position": 0,
    "text": "پدر زال را تنگ در برگرفت"
  },
  {
    "poem_id": 1380,
    "vorder": 230,
    "position": 1,
    "text": "شگفتی خروشیدن اندر گرفت"
  },
  {
    "poem_id": 1380,
    "vorder": 231,
    "position": 0,
    "text": "بفرمود تا بازگردد ز راه"
  },
  {
    "poem_id": 1380,
    "vorder": 232,
    "position": 1,
    "text": "شود شادمان سوی تخت و کلاه"
  },
  {
    "poem_id": 1380,
    "vorder": 233,
    "position": 0,
    "text": "بیامد پر اندیشه دستان سام"
  },
  {
    "poem_id": 1380,
    "vorder": 234,
    "position": 1,
    "text": "که تا چون زید تا بود نیک نام"
  },
  {
    "poem_id": 1380,
    "vorder": 235,
    "position": 0,
    "text": "نشست از بر نامور تخت عاج"
  },
  {
    "poem_id": 1380,
    "vorder": 236,
    "position": 1,
    "text": "به سر بر نهاد آن فروزنده تاج"
  },
  {
    "poem_id": 1380,
    "vorder": 237,
    "position": 0,
    "text": "ابا یاره و گُرزهٔ گاو سر"
  },
  {
    "poem_id": 1380,
    "vorder": 238,
    "position": 1,
    "text": "ابا طوق زرّین و زرّین کمر"
  },
  {
    "poem_id": 1380,
    "vorder": 239,
    "position": 0,
    "text": "ز هر کشوری موبدان را بخواند"
  },
  {
    "poem_id": 1380,
    "vorder": 240,
    "position": 1,
    "text": "پژوهید هر کار و هر چیز راند"
  },
  {
    "poem_id": 1380,
    "vorder": 241,
    "position": 0,
    "text": "ستاره‌شناسان و دین آوران"
  },
  {
    "poem_id": 1380,
    "vorder": 242,
    "position": 1,
    "text": "سواران جنگی و کین‌آوران"
  },
  {
    "poem_id": 1380,
    "vorder": 243,
    "position": 0,
    "text": "شب و روز بودند با او به هم"
  },
  {
    "poem_id": 1380,
    "vorder": 244,
    "position": 1,
    "text": "زدندی همی رای بر بیش و کم"
  },
  {
    "poem_id": 1380,
    "vorder": 245,
    "position": 0,
    "text": "چنان گشت زال از بس آموختن"
  },
  {
    "poem_id": 1380,
    "vorder": 246,
    "position": 1,
    "text": "تو گفتی ستاره است از افروختن"
  },
  {
    "poem_id": 1380,
    "vorder": 247,
    "position": 0,
    "text": "به رای و به دانش به جایی رسید"
  },
  {
    "poem_id": 1380,
    "vorder": 248,
    "position": 1,
    "text": "که چون خویشتن در جهان کس ندید"
  },
  {
    "poem_id": 1380,
    "vorder": 249,
    "position": 0,
    "text": "بدین سان همی گشت گردان سپهر"
  },
  {
    "poem_id": 1380,
    "vorder": 250,
    "position": 1,
    "text": "ابر سام و بر زال گسترده مهر"
  }
]