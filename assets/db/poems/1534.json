[
  {
    "poem_id": 1534,
    "vorder": 1,
    "position": 0,
    "text": "سخن چون بسر برد شاه زمین"
  },
  {
    "poem_id": 1534,
    "vorder": 2,
    "position": 1,
    "text": "سیه پیل را خواند و کرد آفرین"
  },
  {
    "poem_id": 1534,
    "vorder": 3,
    "position": 0,
    "text": "سپردش بدو گفت بردارشان"
  },
  {
    "poem_id": 1534,
    "vorder": 4,
    "position": 1,
    "text": "از ایران به آن مرز بگذارشان"
  },
  {
    "poem_id": 1534,
    "vorder": 5,
    "position": 0,
    "text": "فرستادگان سپهدار چین"
  },
  {
    "poem_id": 1534,
    "vorder": 6,
    "position": 1,
    "text": "ز پیش جهانجوی شاه زمین"
  },
  {
    "poem_id": 1534,
    "vorder": 7,
    "position": 0,
    "text": "برفتند هر دو شده خاکسار"
  },
  {
    "poem_id": 1534,
    "vorder": 8,
    "position": 1,
    "text": "جهاندارشان رانده و کرده خوار"
  },
  {
    "poem_id": 1534,
    "vorder": 9,
    "position": 0,
    "text": "از ایران فرخ به خلخ شدند"
  },
  {
    "poem_id": 1534,
    "vorder": 10,
    "position": 1,
    "text": "ولیکن به خلخ نه فرخ شدند"
  },
  {
    "poem_id": 1534,
    "vorder": 11,
    "position": 0,
    "text": "چو از دور دیدند ایوان شاه"
  },
  {
    "poem_id": 1534,
    "vorder": 12,
    "position": 1,
    "text": "زده بر سر او درفش سیاه"
  },
  {
    "poem_id": 1534,
    "vorder": 13,
    "position": 0,
    "text": "فرود آمدند از چمنده ستور"
  },
  {
    "poem_id": 1534,
    "vorder": 14,
    "position": 1,
    "text": "شکسته دل و چشمها گشته کور"
  },
  {
    "poem_id": 1534,
    "vorder": 15,
    "position": 0,
    "text": "پیاده برفتند تا پیش اوی"
  },
  {
    "poem_id": 1534,
    "vorder": 16,
    "position": 1,
    "text": "سیه‌شان شده جامه و زرد روی"
  },
  {
    "poem_id": 1534,
    "vorder": 17,
    "position": 0,
    "text": "بدادندش آن نامهٔ شهریار"
  },
  {
    "poem_id": 1534,
    "vorder": 18,
    "position": 1,
    "text": "سرآهنگ مردان نیزه گزار"
  },
  {
    "poem_id": 1534,
    "vorder": 19,
    "position": 0,
    "text": "دبیرش مران نامه را برگشاد"
  },
  {
    "poem_id": 1534,
    "vorder": 20,
    "position": 1,
    "text": "بخواندش بران شاه جادو نژاد"
  },
  {
    "poem_id": 1534,
    "vorder": 21,
    "position": 0,
    "text": "نوشته دران نامهٔ شهریار"
  },
  {
    "poem_id": 1534,
    "vorder": 22,
    "position": 1,
    "text": "ز گردان و مردان نیزه گزار"
  },
  {
    "poem_id": 1534,
    "vorder": 23,
    "position": 0,
    "text": "پس شاه لهراسپ گشتاسپ شاه"
  },
  {
    "poem_id": 1534,
    "vorder": 24,
    "position": 1,
    "text": "نگهبان گیتی سزاوار گاه"
  },
  {
    "poem_id": 1534,
    "vorder": 25,
    "position": 0,
    "text": "فرسته فرستاد زی او خدای"
  },
  {
    "poem_id": 1534,
    "vorder": 26,
    "position": 1,
    "text": "همه مهتران پیش او بر به پای"
  },
  {
    "poem_id": 1534,
    "vorder": 27,
    "position": 0,
    "text": "زی ارجاسپ ترک آن پلید سترگ"
  },
  {
    "poem_id": 1534,
    "vorder": 28,
    "position": 1,
    "text": "کجا پیکرش پیکر پیر گرگ"
  },
  {
    "poem_id": 1534,
    "vorder": 29,
    "position": 0,
    "text": "زده سر ز آیین و دین بهی"
  },
  {
    "poem_id": 1534,
    "vorder": 30,
    "position": 1,
    "text": "گزینه ره کوری و ابلهی"
  },
  {
    "poem_id": 1534,
    "vorder": 31,
    "position": 0,
    "text": "رسید آن نوشته فرومایه‌وار"
  },
  {
    "poem_id": 1534,
    "vorder": 32,
    "position": 1,
    "text": "که بنوشته بودی سوی شهریار"
  },
  {
    "poem_id": 1534,
    "vorder": 33,
    "position": 0,
    "text": "شنیدیم و دید آن سخنها کجا"
  },
  {
    "poem_id": 1534,
    "vorder": 34,
    "position": 1,
    "text": "نبودی تو مر گفتنش را سزا"
  },
  {
    "poem_id": 1534,
    "vorder": 35,
    "position": 0,
    "text": "نه پوشیدنی و نه بنمودنی"
  },
  {
    "poem_id": 1534,
    "vorder": 36,
    "position": 1,
    "text": "نه افگندنی و نه پیسودنی"
  },
  {
    "poem_id": 1534,
    "vorder": 37,
    "position": 0,
    "text": "چنان گفته بودی که من تا دو ماه"
  },
  {
    "poem_id": 1534,
    "vorder": 38,
    "position": 1,
    "text": "سوی کشور خرم آرم سپاه"
  },
  {
    "poem_id": 1534,
    "vorder": 39,
    "position": 0,
    "text": "نه دو ماه باید ز تو نی چهار"
  },
  {
    "poem_id": 1534,
    "vorder": 40,
    "position": 1,
    "text": "کجا من بیایم چو شیر شکار"
  },
  {
    "poem_id": 1534,
    "vorder": 41,
    "position": 0,
    "text": "تو بر خویشتن بر میفزای رنج"
  },
  {
    "poem_id": 1534,
    "vorder": 42,
    "position": 1,
    "text": "که ما بر گشادیم درهای گنج"
  },
  {
    "poem_id": 1534,
    "vorder": 43,
    "position": 0,
    "text": "بیارم ز گردان هزاران هزار"
  },
  {
    "poem_id": 1534,
    "vorder": 44,
    "position": 1,
    "text": "همه کار دیده همه نیزه‌دار"
  },
  {
    "poem_id": 1534,
    "vorder": 45,
    "position": 0,
    "text": "همه ایرجی زاده و پهلوی"
  },
  {
    "poem_id": 1534,
    "vorder": 46,
    "position": 1,
    "text": "نه افراسیابی و نه یبغوی"
  },
  {
    "poem_id": 1534,
    "vorder": 47,
    "position": 0,
    "text": "همه شاه چهر و همه ماه روی"
  },
  {
    "poem_id": 1534,
    "vorder": 48,
    "position": 1,
    "text": "همه سرو بالا همه راست‌گوی"
  },
  {
    "poem_id": 1534,
    "vorder": 49,
    "position": 0,
    "text": "همه از در پادشاهی و گاه"
  },
  {
    "poem_id": 1534,
    "vorder": 50,
    "position": 1,
    "text": "همه از در گنج و گاه و کلاه"
  },
  {
    "poem_id": 1534,
    "vorder": 51,
    "position": 0,
    "text": "جهانشان بفرسوده با رنج و ناز"
  },
  {
    "poem_id": 1534,
    "vorder": 52,
    "position": 1,
    "text": "همه شیرگیر و همه سرفراز"
  },
  {
    "poem_id": 1534,
    "vorder": 53,
    "position": 0,
    "text": "همه نیزه‌داران شمشیر زن"
  },
  {
    "poem_id": 1534,
    "vorder": 54,
    "position": 1,
    "text": "همه باره‌انگیز و لشکر شکن"
  },
  {
    "poem_id": 1534,
    "vorder": 55,
    "position": 0,
    "text": "چو دانند کم کوس بر پیل بست"
  },
  {
    "poem_id": 1534,
    "vorder": 56,
    "position": 1,
    "text": "سم اسپ ایشان کند کوه پست"
  },
  {
    "poem_id": 1534,
    "vorder": 57,
    "position": 0,
    "text": "ازیشان دو گرد گزیده سوار"
  },
  {
    "poem_id": 1534,
    "vorder": 58,
    "position": 1,
    "text": "زریر سپهدار و اسفندیار"
  },
  {
    "poem_id": 1534,
    "vorder": 59,
    "position": 0,
    "text": "چو ایشان بپوشند ز آهن قبای"
  },
  {
    "poem_id": 1534,
    "vorder": 60,
    "position": 1,
    "text": "به خورشید و ماه اندرآرند پای"
  },
  {
    "poem_id": 1534,
    "vorder": 61,
    "position": 0,
    "text": "چو بر گردن آرند رخشنده گرز"
  },
  {
    "poem_id": 1534,
    "vorder": 62,
    "position": 1,
    "text": "همی تابد از گرزشان فر و برز"
  },
  {
    "poem_id": 1534,
    "vorder": 63,
    "position": 0,
    "text": "چو ایشان بباشند پیش سپاه"
  },
  {
    "poem_id": 1534,
    "vorder": 64,
    "position": 1,
    "text": "ترا کرد باید بدیشان نگاه"
  },
  {
    "poem_id": 1534,
    "vorder": 65,
    "position": 0,
    "text": "به خورشید مانند با تاج و تخت"
  },
  {
    "poem_id": 1534,
    "vorder": 66,
    "position": 1,
    "text": "همی تابد از نیزه‌شان فر و بخت"
  },
  {
    "poem_id": 1534,
    "vorder": 67,
    "position": 0,
    "text": "چنینم گوانند و اسپهبدان"
  },
  {
    "poem_id": 1534,
    "vorder": 68,
    "position": 1,
    "text": "گزین و پسندیدهٔ موبدان"
  },
  {
    "poem_id": 1534,
    "vorder": 69,
    "position": 0,
    "text": "تو سیحون مینبار و جیحون به مشک"
  },
  {
    "poem_id": 1534,
    "vorder": 70,
    "position": 1,
    "text": "که ما را چه جیحون چه سیحون چه خشک"
  },
  {
    "poem_id": 1534,
    "vorder": 71,
    "position": 0,
    "text": "چنان بردوانند باره بر آب"
  },
  {
    "poem_id": 1534,
    "vorder": 72,
    "position": 1,
    "text": "که تاری شود چشمهٔ آفتاب"
  },
  {
    "poem_id": 1534,
    "vorder": 73,
    "position": 0,
    "text": "به روز نبرد ار بخواهد خدای"
  },
  {
    "poem_id": 1534,
    "vorder": 74,
    "position": 1,
    "text": "به رزم اندر آرم سرت زیر پای"
  },
  {
    "poem_id": 1534,
    "vorder": 75,
    "position": 0,
    "text": "چو سالار پیکند نامه بخواند"
  },
  {
    "poem_id": 1534,
    "vorder": 76,
    "position": 1,
    "text": "فرود آمد از گاه و خیره بماند"
  },
  {
    "poem_id": 1534,
    "vorder": 77,
    "position": 0,
    "text": "سپهبدش را گفت فردا پگاه"
  },
  {
    "poem_id": 1534,
    "vorder": 78,
    "position": 1,
    "text": "بخوان از همه پادشاهی سپاه"
  },
  {
    "poem_id": 1534,
    "vorder": 79,
    "position": 0,
    "text": "تگینان لشکرش ترکان چین"
  },
  {
    "poem_id": 1534,
    "vorder": 80,
    "position": 1,
    "text": "برفتند هر سو به توران زمین"
  },
  {
    "poem_id": 1534,
    "vorder": 81,
    "position": 0,
    "text": "بدو باز خواندند لشکرش را"
  },
  {
    "poem_id": 1534,
    "vorder": 82,
    "position": 1,
    "text": "سر مرزداران کشورش را"
  },
  {
    "poem_id": 1534,
    "vorder": 83,
    "position": 0,
    "text": "برادر بد او را دو آهرمنان"
  },
  {
    "poem_id": 1534,
    "vorder": 84,
    "position": 1,
    "text": "یکی کهرم و دیگری اندمان"
  },
  {
    "poem_id": 1534,
    "vorder": 85,
    "position": 0,
    "text": "بفرمودشان تا نبرده سوار"
  },
  {
    "poem_id": 1534,
    "vorder": 86,
    "position": 1,
    "text": "گزیدند گردان لشکر هزار"
  },
  {
    "poem_id": 1534,
    "vorder": 87,
    "position": 0,
    "text": "بدادندشان کوس و پیل و درفش"
  },
  {
    "poem_id": 1534,
    "vorder": 88,
    "position": 1,
    "text": "بیاراسته زرد و سرخ و بنفش"
  },
  {
    "poem_id": 1534,
    "vorder": 89,
    "position": 0,
    "text": "بدیشان ببخشید سیصد هزار"
  },
  {
    "poem_id": 1534,
    "vorder": 90,
    "position": 1,
    "text": "گوان گزیده نبرده سوار"
  },
  {
    "poem_id": 1534,
    "vorder": 91,
    "position": 0,
    "text": "در گنج بگشاد و روزی بداد"
  },
  {
    "poem_id": 1534,
    "vorder": 92,
    "position": 1,
    "text": "بزد نای رویین بنه بر نهاد"
  },
  {
    "poem_id": 1534,
    "vorder": 93,
    "position": 0,
    "text": "بخواند آن زمان مر برادرش را"
  },
  {
    "poem_id": 1534,
    "vorder": 94,
    "position": 1,
    "text": "بدو داد یک دست لشکرش را"
  },
  {
    "poem_id": 1534,
    "vorder": 95,
    "position": 0,
    "text": "باندیدمان داد دست دگر"
  },
  {
    "poem_id": 1534,
    "vorder": 96,
    "position": 1,
    "text": "خود اندر میان رفت با یک پسر"
  },
  {
    "poem_id": 1534,
    "vorder": 97,
    "position": 0,
    "text": "یکی ترک بد نام او گرگسار"
  },
  {
    "poem_id": 1534,
    "vorder": 98,
    "position": 1,
    "text": "گذشته بروبر بسی روزگار"
  },
  {
    "poem_id": 1534,
    "vorder": 99,
    "position": 0,
    "text": "سپه را بدو داد اسپهبدی"
  },
  {
    "poem_id": 1534,
    "vorder": 100,
    "position": 1,
    "text": "تو گفتی نداند همی جز بدی"
  },
  {
    "poem_id": 1534,
    "vorder": 101,
    "position": 0,
    "text": "چو غارتگری داد بر بیدرفش"
  },
  {
    "poem_id": 1534,
    "vorder": 102,
    "position": 1,
    "text": "بدادش یکی پیل پیکر درفش"
  },
  {
    "poem_id": 1534,
    "vorder": 103,
    "position": 0,
    "text": "یکی بود نامش خشاش دلیر"
  },
  {
    "poem_id": 1534,
    "vorder": 104,
    "position": 1,
    "text": "پذیره نرفتی ورا نره شیر"
  },
  {
    "poem_id": 1534,
    "vorder": 105,
    "position": 0,
    "text": "سپه دیده‌بان کردش و پیش رو"
  },
  {
    "poem_id": 1534,
    "vorder": 106,
    "position": 1,
    "text": "کشیدش درفش و بشد پیش گو"
  },
  {
    "poem_id": 1534,
    "vorder": 107,
    "position": 0,
    "text": "دگر ترک بد نام او هوش دیو"
  },
  {
    "poem_id": 1534,
    "vorder": 108,
    "position": 1,
    "text": "پیامش فرستاد ترکان خدیو"
  },
  {
    "poem_id": 1534,
    "vorder": 109,
    "position": 0,
    "text": "نگه دار گفتا تو پشت سپاه"
  },
  {
    "poem_id": 1534,
    "vorder": 110,
    "position": 1,
    "text": "گر از ما کسی باز گردد به راه"
  },
  {
    "poem_id": 1534,
    "vorder": 111,
    "position": 0,
    "text": "هم آنجا که بینی مر او را بکش"
  },
  {
    "poem_id": 1534,
    "vorder": 112,
    "position": 1,
    "text": "نگر تا بدانجا نجنبدت هش"
  },
  {
    "poem_id": 1534,
    "vorder": 113,
    "position": 0,
    "text": "بران سان همی رفت بایین خشم"
  },
  {
    "poem_id": 1534,
    "vorder": 114,
    "position": 1,
    "text": "پر از خون شده دل پر از آب چشم"
  },
  {
    "poem_id": 1534,
    "vorder": 115,
    "position": 0,
    "text": "همی کرد غارت همی سوخت کاخ"
  },
  {
    "poem_id": 1534,
    "vorder": 116,
    "position": 1,
    "text": "درختان همی کند از بیخ و شاخ"
  },
  {
    "poem_id": 1534,
    "vorder": 117,
    "position": 0,
    "text": "در آورد لشکر به ایران زمین"
  },
  {
    "poem_id": 1534,
    "vorder": 118,
    "position": 1,
    "text": "همه خیره و دل پراگنده کین"
  }
]