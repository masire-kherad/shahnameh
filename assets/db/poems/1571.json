[
  {
    "poem_id": 1571,
    "vorder": 1,
    "position": 0,
    "text": "چو تاریکتر شد شب اسفندیار"
  },
  {
    "poem_id": 1571,
    "vorder": 2,
    "position": 1,
    "text": "بپوشید نو جامهٔ کارزار"
  },
  {
    "poem_id": 1571,
    "vorder": 3,
    "position": 0,
    "text": "سر بند صندوقها برگشاد"
  },
  {
    "poem_id": 1571,
    "vorder": 4,
    "position": 1,
    "text": "یکی تا بدان بستگان جست باد"
  },
  {
    "poem_id": 1571,
    "vorder": 5,
    "position": 0,
    "text": "کباب و می آورد و نوشیدنی"
  },
  {
    "poem_id": 1571,
    "vorder": 6,
    "position": 1,
    "text": "همان جامهٔ رزم و پوشیدنی"
  },
  {
    "poem_id": 1571,
    "vorder": 7,
    "position": 0,
    "text": "چو نان خورده شد هر یکی را سه جام"
  },
  {
    "poem_id": 1571,
    "vorder": 8,
    "position": 1,
    "text": "بدادند و گشتند زان شادکام"
  },
  {
    "poem_id": 1571,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت کامشب شبی پربلاست"
  },
  {
    "poem_id": 1571,
    "vorder": 10,
    "position": 1,
    "text": "اگر نام گیریم ز ایدر سزاست"
  },
  {
    "poem_id": 1571,
    "vorder": 11,
    "position": 0,
    "text": "بکوشید و پیکار مردان کنید"
  },
  {
    "poem_id": 1571,
    "vorder": 12,
    "position": 1,
    "text": "پناه از بلاها به یزدان کنید"
  },
  {
    "poem_id": 1571,
    "vorder": 13,
    "position": 0,
    "text": "ازان پس یلان را به سه بهر کرد"
  },
  {
    "poem_id": 1571,
    "vorder": 14,
    "position": 1,
    "text": "هرانکس که جستند ننگ و نبرد"
  },
  {
    "poem_id": 1571,
    "vorder": 15,
    "position": 0,
    "text": "یکی بهره زیشان میان حصار"
  },
  {
    "poem_id": 1571,
    "vorder": 16,
    "position": 1,
    "text": "که سازند با هرکسی کارزار"
  },
  {
    "poem_id": 1571,
    "vorder": 17,
    "position": 0,
    "text": "دگر بهره تا بر در دژ شوند"
  },
  {
    "poem_id": 1571,
    "vorder": 18,
    "position": 1,
    "text": "ز پیکار و خون ریختن نغنوند"
  },
  {
    "poem_id": 1571,
    "vorder": 19,
    "position": 0,
    "text": "سیم بهره را گفت از سرکشان"
  },
  {
    "poem_id": 1571,
    "vorder": 20,
    "position": 1,
    "text": "که باید که یابید زیشان نشان"
  },
  {
    "poem_id": 1571,
    "vorder": 21,
    "position": 0,
    "text": "که بودند با ما ز می دوش مست"
  },
  {
    "poem_id": 1571,
    "vorder": 22,
    "position": 1,
    "text": "سرانشان به خنجر ببرید پست"
  },
  {
    "poem_id": 1571,
    "vorder": 23,
    "position": 0,
    "text": "خود و بیست مرد از دلیران گرد"
  },
  {
    "poem_id": 1571,
    "vorder": 24,
    "position": 1,
    "text": "بشد تیز و دیگر بدیشان سپرد"
  },
  {
    "poem_id": 1571,
    "vorder": 25,
    "position": 0,
    "text": "به درگاه ارجاسپ آمد دلیر"
  },
  {
    "poem_id": 1571,
    "vorder": 26,
    "position": 1,
    "text": "زره‌دار و غران به کردار شیر"
  },
  {
    "poem_id": 1571,
    "vorder": 27,
    "position": 0,
    "text": "چو زخم خروش آمد از در سرای"
  },
  {
    "poem_id": 1571,
    "vorder": 28,
    "position": 1,
    "text": "دوان پیش آزادگان شد همای"
  },
  {
    "poem_id": 1571,
    "vorder": 29,
    "position": 0,
    "text": "ابا خواهر خویش به آفرید"
  },
  {
    "poem_id": 1571,
    "vorder": 30,
    "position": 1,
    "text": "به خون مژه کرده رخ ناپدید"
  },
  {
    "poem_id": 1571,
    "vorder": 31,
    "position": 0,
    "text": "چو آمد به تنگ اندر اسفندیار"
  },
  {
    "poem_id": 1571,
    "vorder": 32,
    "position": 1,
    "text": "دو پوشیده را دید چون نوبهار"
  },
  {
    "poem_id": 1571,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت با خواهران شیرمرد"
  },
  {
    "poem_id": 1571,
    "vorder": 34,
    "position": 1,
    "text": "کز ایدر بپویید برسان گرد"
  },
  {
    "poem_id": 1571,
    "vorder": 35,
    "position": 0,
    "text": "بدانجا که بازارگاه منست"
  },
  {
    "poem_id": 1571,
    "vorder": 36,
    "position": 1,
    "text": "بسی زر و سیم است و گاه منست"
  },
  {
    "poem_id": 1571,
    "vorder": 37,
    "position": 0,
    "text": "مباشید با من بدین رزمگاه"
  },
  {
    "poem_id": 1571,
    "vorder": 38,
    "position": 1,
    "text": "اگر سر دهم گر ستانم کلاه"
  },
  {
    "poem_id": 1571,
    "vorder": 39,
    "position": 0,
    "text": "بیامد یکی تیغ هندی به مشت"
  },
  {
    "poem_id": 1571,
    "vorder": 40,
    "position": 1,
    "text": "کسی را که دید از دلیران بکشت"
  },
  {
    "poem_id": 1571,
    "vorder": 41,
    "position": 0,
    "text": "همه بارگاهش چنان شد که راه"
  },
  {
    "poem_id": 1571,
    "vorder": 42,
    "position": 1,
    "text": "نبود اندران نامور بارگاه"
  },
  {
    "poem_id": 1571,
    "vorder": 43,
    "position": 0,
    "text": "ز بس خسته و کشته و کوفته"
  },
  {
    "poem_id": 1571,
    "vorder": 44,
    "position": 1,
    "text": "زمین همچو دریای آشوفته"
  },
  {
    "poem_id": 1571,
    "vorder": 45,
    "position": 0,
    "text": "چو ارجاسپ از خواب بیدار شد"
  },
  {
    "poem_id": 1571,
    "vorder": 46,
    "position": 1,
    "text": "ز غلغل دلش پر ز تیمار شد"
  },
  {
    "poem_id": 1571,
    "vorder": 47,
    "position": 0,
    "text": "بجوشید ارجاسپ از جایگاه"
  },
  {
    "poem_id": 1571,
    "vorder": 48,
    "position": 1,
    "text": "بپوشید خفتان و رومی کلاه"
  },
  {
    "poem_id": 1571,
    "vorder": 49,
    "position": 0,
    "text": "به دست اندرش خنجر آب‌گون"
  },
  {
    "poem_id": 1571,
    "vorder": 50,
    "position": 1,
    "text": "دهن پر ز آواز و دل پر ز خون"
  },
  {
    "poem_id": 1571,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت کز مرد بازارگان"
  },
  {
    "poem_id": 1571,
    "vorder": 52,
    "position": 1,
    "text": "بیابی کنون تیغ و دینارگان"
  },
  {
    "poem_id": 1571,
    "vorder": 53,
    "position": 0,
    "text": "یکی هدیه آرمت لهراسپی"
  },
  {
    "poem_id": 1571,
    "vorder": 54,
    "position": 1,
    "text": "نهاده برو مهر گشتاسپی"
  },
  {
    "poem_id": 1571,
    "vorder": 55,
    "position": 0,
    "text": "برآویخت ارجاسپ و اسفندیار"
  },
  {
    "poem_id": 1571,
    "vorder": 56,
    "position": 1,
    "text": "از اندازه بگذشتشان کارزار"
  },
  {
    "poem_id": 1571,
    "vorder": 57,
    "position": 0,
    "text": "پیاپی بسی تیغ و خنجر زدند"
  },
  {
    "poem_id": 1571,
    "vorder": 58,
    "position": 1,
    "text": "گهی بر میان گاه بر سر زدند"
  },
  {
    "poem_id": 1571,
    "vorder": 59,
    "position": 0,
    "text": "به زخم اندر ارجاسپ را کرد سست"
  },
  {
    "poem_id": 1571,
    "vorder": 60,
    "position": 1,
    "text": "ندیدند بر تنش جایی درست"
  },
  {
    "poem_id": 1571,
    "vorder": 61,
    "position": 0,
    "text": "ز پای اندر آمد تن پیلوار"
  },
  {
    "poem_id": 1571,
    "vorder": 62,
    "position": 1,
    "text": "جدا کردش از تن سر اسفندیار"
  },
  {
    "poem_id": 1571,
    "vorder": 63,
    "position": 0,
    "text": "چو شد کشته ارجاسپ آزرده‌جان"
  },
  {
    "poem_id": 1571,
    "vorder": 64,
    "position": 1,
    "text": "خروشی برآمد ز کاخ زنان"
  },
  {
    "poem_id": 1571,
    "vorder": 65,
    "position": 0,
    "text": "چنین است کردار گردنده دهر"
  },
  {
    "poem_id": 1571,
    "vorder": 66,
    "position": 1,
    "text": "گهی نوش یابیم ازو گاه زهر"
  },
  {
    "poem_id": 1571,
    "vorder": 67,
    "position": 0,
    "text": "چه بندی دل اندر سرای سپنج"
  },
  {
    "poem_id": 1571,
    "vorder": 68,
    "position": 1,
    "text": "چو دانی که ایدر نمانی مرنج"
  },
  {
    "poem_id": 1571,
    "vorder": 69,
    "position": 0,
    "text": "بپردخت ز ارجاسپ اسفندیار"
  },
  {
    "poem_id": 1571,
    "vorder": 70,
    "position": 1,
    "text": "به کیوان برآورد ز ایوان دمار"
  },
  {
    "poem_id": 1571,
    "vorder": 71,
    "position": 0,
    "text": "بفرمود تا شمع بفروختند"
  },
  {
    "poem_id": 1571,
    "vorder": 72,
    "position": 1,
    "text": "به هر سوی ایوان همی سوختند"
  },
  {
    "poem_id": 1571,
    "vorder": 73,
    "position": 0,
    "text": "شبستان او را به خادم سپرد"
  },
  {
    "poem_id": 1571,
    "vorder": 74,
    "position": 1,
    "text": "ازان جایگه رشته‌تایی نبرد"
  },
  {
    "poem_id": 1571,
    "vorder": 75,
    "position": 0,
    "text": "در گنج دینار او مهر کرد"
  },
  {
    "poem_id": 1571,
    "vorder": 76,
    "position": 1,
    "text": "به ایوان نبودش کسی هم نبرد"
  },
  {
    "poem_id": 1571,
    "vorder": 77,
    "position": 0,
    "text": "بیامد سوی آخر و برنشست"
  },
  {
    "poem_id": 1571,
    "vorder": 78,
    "position": 1,
    "text": "یکی تیغ هندی گرفته به دست"
  },
  {
    "poem_id": 1571,
    "vorder": 79,
    "position": 0,
    "text": "ازان تازی اسپان کش آمد گزین"
  },
  {
    "poem_id": 1571,
    "vorder": 80,
    "position": 1,
    "text": "بفرمود تا برنهادند زین"
  },
  {
    "poem_id": 1571,
    "vorder": 81,
    "position": 0,
    "text": "برفتند زانجا صد و شست مرد"
  },
  {
    "poem_id": 1571,
    "vorder": 82,
    "position": 1,
    "text": "گزیده سواران روز نبرد"
  },
  {
    "poem_id": 1571,
    "vorder": 83,
    "position": 0,
    "text": "همان خواهران را بر اسپان نشاند"
  },
  {
    "poem_id": 1571,
    "vorder": 84,
    "position": 1,
    "text": "ز درگاه ارجاسپ لشکر براند"
  },
  {
    "poem_id": 1571,
    "vorder": 85,
    "position": 0,
    "text": "وز ایرانیان نامور مرد چند"
  },
  {
    "poem_id": 1571,
    "vorder": 86,
    "position": 1,
    "text": "به دژ ماند با ساوهٔ ارجمند"
  },
  {
    "poem_id": 1571,
    "vorder": 87,
    "position": 0,
    "text": "چو من گفت از ایدر به بیرون شوم"
  },
  {
    "poem_id": 1571,
    "vorder": 88,
    "position": 1,
    "text": "خود و نامدارن به هامون شوم"
  },
  {
    "poem_id": 1571,
    "vorder": 89,
    "position": 0,
    "text": "به ترکان در دژ ببندید سخت"
  },
  {
    "poem_id": 1571,
    "vorder": 90,
    "position": 1,
    "text": "مگر یار باشد مرا نیک‌بخت"
  },
  {
    "poem_id": 1571,
    "vorder": 91,
    "position": 0,
    "text": "هرانگه که آید گمانتان که من"
  },
  {
    "poem_id": 1571,
    "vorder": 92,
    "position": 1,
    "text": "رسیدم بدان پاک‌رای انجمن"
  },
  {
    "poem_id": 1571,
    "vorder": 93,
    "position": 0,
    "text": "غو دیده باید که از دیدگاه"
  },
  {
    "poem_id": 1571,
    "vorder": 94,
    "position": 1,
    "text": "کانوشه سر و تاج گشتاسپ شاه"
  },
  {
    "poem_id": 1571,
    "vorder": 95,
    "position": 0,
    "text": "چو انبوه گردد به دژ بر سپاه"
  },
  {
    "poem_id": 1571,
    "vorder": 96,
    "position": 1,
    "text": "گریزان و برگشته از رزمگاه"
  },
  {
    "poem_id": 1571,
    "vorder": 97,
    "position": 0,
    "text": "به پیروزی از بارهٔ کاخ پاس"
  },
  {
    "poem_id": 1571,
    "vorder": 98,
    "position": 1,
    "text": "بدارید از پاک یزدان سپاس"
  },
  {
    "poem_id": 1571,
    "vorder": 99,
    "position": 0,
    "text": "سر شاه ترکان ازان دیدگاه"
  },
  {
    "poem_id": 1571,
    "vorder": 100,
    "position": 1,
    "text": "بینداخت باید به پیش سپاه"
  },
  {
    "poem_id": 1571,
    "vorder": 101,
    "position": 0,
    "text": "بیامد ز دژ با صد و شست مرد"
  },
  {
    "poem_id": 1571,
    "vorder": 102,
    "position": 1,
    "text": "خروشان و جوشان به دشت نبرد"
  },
  {
    "poem_id": 1571,
    "vorder": 103,
    "position": 0,
    "text": "چو نزد سپاه پشوتن رسید"
  },
  {
    "poem_id": 1571,
    "vorder": 104,
    "position": 1,
    "text": "برو نامدار آفرین گسترید"
  },
  {
    "poem_id": 1571,
    "vorder": 105,
    "position": 0,
    "text": "سپاهش همه مانده زو در شگفت"
  },
  {
    "poem_id": 1571,
    "vorder": 106,
    "position": 1,
    "text": "که مرد جوان آن دلیری گرفت"
  }
]