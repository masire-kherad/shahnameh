[
  {
    "poem_id": 1381,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که روزی چنان کرد رای"
  },
  {
    "poem_id": 1381,
    "vorder": 2,
    "position": 1,
    "text": "که در پادشاهی بجنبد ز جای"
  },
  {
    "poem_id": 1381,
    "vorder": 3,
    "position": 0,
    "text": "برون رفت با ویژه‌گردان خویش"
  },
  {
    "poem_id": 1381,
    "vorder": 4,
    "position": 1,
    "text": "که با او یکی بودشان رای و کیش"
  },
  {
    "poem_id": 1381,
    "vorder": 5,
    "position": 0,
    "text": "سوی کشور هندوان کرد رای"
  },
  {
    "poem_id": 1381,
    "vorder": 6,
    "position": 1,
    "text": "سوی کابل و دنبر و مرغ و مای"
  },
  {
    "poem_id": 1381,
    "vorder": 7,
    "position": 0,
    "text": "به هر جایگاهی بیاراستی"
  },
  {
    "poem_id": 1381,
    "vorder": 8,
    "position": 1,
    "text": "می و رود و رامشگران خواستی"
  },
  {
    "poem_id": 1381,
    "vorder": 9,
    "position": 0,
    "text": "گشاده در گنج و افگنده رنج"
  },
  {
    "poem_id": 1381,
    "vorder": 10,
    "position": 1,
    "text": "بر آیین و رسم سرای سپنج"
  },
  {
    "poem_id": 1381,
    "vorder": 11,
    "position": 0,
    "text": "ز زابل به کابل رسید آن زمان"
  },
  {
    "poem_id": 1381,
    "vorder": 12,
    "position": 1,
    "text": "گرازان و خندان و دل شادمان"
  },
  {
    "poem_id": 1381,
    "vorder": 13,
    "position": 0,
    "text": "یکی پادشا بود مهراب نام"
  },
  {
    "poem_id": 1381,
    "vorder": 14,
    "position": 1,
    "text": "زبر دست با گنج و گسترده کام"
  },
  {
    "poem_id": 1381,
    "vorder": 15,
    "position": 0,
    "text": "به بالا به کردار آزاده سرو"
  },
  {
    "poem_id": 1381,
    "vorder": 16,
    "position": 1,
    "text": "به رخ چون بهار و به رفتن تذرو"
  },
  {
    "poem_id": 1381,
    "vorder": 17,
    "position": 0,
    "text": "دل بخردان داشت و مغز ردان"
  },
  {
    "poem_id": 1381,
    "vorder": 18,
    "position": 1,
    "text": "دو کتف یلان و هش موبدان"
  },
  {
    "poem_id": 1381,
    "vorder": 19,
    "position": 0,
    "text": "ز ضحاک تازی گهر داشتی"
  },
  {
    "poem_id": 1381,
    "vorder": 20,
    "position": 1,
    "text": "به کابل همه بوم و برداشتی"
  },
  {
    "poem_id": 1381,
    "vorder": 21,
    "position": 0,
    "text": "همی داد هر سال مر سام ساو"
  },
  {
    "poem_id": 1381,
    "vorder": 22,
    "position": 1,
    "text": "که با او به رزمش نبود ایچ تاو"
  },
  {
    "poem_id": 1381,
    "vorder": 23,
    "position": 0,
    "text": "چو آگه شد از کار دستان سام"
  },
  {
    "poem_id": 1381,
    "vorder": 24,
    "position": 1,
    "text": "ز کابل بیامد به هنگام بام"
  },
  {
    "poem_id": 1381,
    "vorder": 25,
    "position": 0,
    "text": "ابا گنج و اسپان آراسته"
  },
  {
    "poem_id": 1381,
    "vorder": 26,
    "position": 1,
    "text": "غلامان و هر گونه‌ای خواسته"
  },
  {
    "poem_id": 1381,
    "vorder": 27,
    "position": 0,
    "text": "ز دینار و یاقوت و مشک و عبیر"
  },
  {
    "poem_id": 1381,
    "vorder": 28,
    "position": 1,
    "text": "ز دیبای زربفت و چینی حریر"
  },
  {
    "poem_id": 1381,
    "vorder": 29,
    "position": 0,
    "text": "یکی تاج با گوهر شاهوار"
  },
  {
    "poem_id": 1381,
    "vorder": 30,
    "position": 1,
    "text": "یکی طوق زرین زبرجد نگار"
  },
  {
    "poem_id": 1381,
    "vorder": 31,
    "position": 0,
    "text": "چو آمد به دستان سام آگهی"
  },
  {
    "poem_id": 1381,
    "vorder": 32,
    "position": 1,
    "text": "که مهراب آمد بدین فرهی"
  },
  {
    "poem_id": 1381,
    "vorder": 33,
    "position": 0,
    "text": "پذیره شدش زال و بنواختش"
  },
  {
    "poem_id": 1381,
    "vorder": 34,
    "position": 1,
    "text": "به آیین یکی پایگه ساختش"
  },
  {
    "poem_id": 1381,
    "vorder": 35,
    "position": 0,
    "text": "سوی تخت پیروزه باز آمدند"
  },
  {
    "poem_id": 1381,
    "vorder": 36,
    "position": 1,
    "text": "گشاده دل و بزم ساز آمدند"
  },
  {
    "poem_id": 1381,
    "vorder": 37,
    "position": 0,
    "text": "یکی پهلوانی نهادند خوان"
  },
  {
    "poem_id": 1381,
    "vorder": 38,
    "position": 1,
    "text": "نشستند بر خوان با فرخان"
  },
  {
    "poem_id": 1381,
    "vorder": 39,
    "position": 0,
    "text": "گسارندهٔ می می آورد و جام"
  },
  {
    "poem_id": 1381,
    "vorder": 40,
    "position": 1,
    "text": "نگه کرد مهراب را پور سام"
  },
  {
    "poem_id": 1381,
    "vorder": 41,
    "position": 0,
    "text": "خوش آمد هماناش دیدار او"
  },
  {
    "poem_id": 1381,
    "vorder": 42,
    "position": 1,
    "text": "دلش تیز تر گشت در کار او"
  },
  {
    "poem_id": 1381,
    "vorder": 43,
    "position": 0,
    "text": "چو مهراب برخاست از خوان زال"
  },
  {
    "poem_id": 1381,
    "vorder": 44,
    "position": 1,
    "text": "نگه کرد زال اندر آن برز و یال"
  },
  {
    "poem_id": 1381,
    "vorder": 45,
    "position": 0,
    "text": "چنین گفت با مهتران زال زر"
  },
  {
    "poem_id": 1381,
    "vorder": 46,
    "position": 1,
    "text": "که زیبنده‌تر زین که بندد کمر"
  },
  {
    "poem_id": 1381,
    "vorder": 47,
    "position": 0,
    "text": "یکی نامدار از میان مهان"
  },
  {
    "poem_id": 1381,
    "vorder": 48,
    "position": 1,
    "text": "چنین گفت کای پهلوان جهان"
  },
  {
    "poem_id": 1381,
    "vorder": 49,
    "position": 0,
    "text": "پس پردهٔ او یکی دخترست"
  },
  {
    "poem_id": 1381,
    "vorder": 50,
    "position": 1,
    "text": "که رویش ز خورشید روشن‌ترست"
  },
  {
    "poem_id": 1381,
    "vorder": 51,
    "position": 0,
    "text": "ز سر تا به پایش به کردار عاج"
  },
  {
    "poem_id": 1381,
    "vorder": 52,
    "position": 1,
    "text": "به رخ چون بهشت و به بالا چو ساج"
  },
  {
    "poem_id": 1381,
    "vorder": 53,
    "position": 0,
    "text": "بر  آن سفت سیمنش مشکین کمند"
  },
  {
    "poem_id": 1381,
    "vorder": 54,
    "position": 1,
    "text": "سرش گشته چون حلقهٔ پای‌بند"
  },
  {
    "poem_id": 1381,
    "vorder": 55,
    "position": 0,
    "text": "رخانش چو گلنار و لب ناردان"
  },
  {
    "poem_id": 1381,
    "vorder": 56,
    "position": 1,
    "text": "ز سیمین برش رسته دو ناروان"
  },
  {
    "poem_id": 1381,
    "vorder": 57,
    "position": 0,
    "text": "دو چشمش به سان دو نرگس به باغ"
  },
  {
    "poem_id": 1381,
    "vorder": 58,
    "position": 1,
    "text": "مژه تیرگی برده از پر زاغ"
  },
  {
    "poem_id": 1381,
    "vorder": 59,
    "position": 0,
    "text": "دو ابرو به سان کمان طراز"
  },
  {
    "poem_id": 1381,
    "vorder": 60,
    "position": 1,
    "text": "بر او توز پوشیده از مشک ناز"
  },
  {
    "poem_id": 1381,
    "vorder": 61,
    "position": 0,
    "text": "بهشتیست سرتاسر آراسته"
  },
  {
    "poem_id": 1381,
    "vorder": 62,
    "position": 1,
    "text": "پر آرایش و رامش و خواسته"
  },
  {
    "poem_id": 1381,
    "vorder": 63,
    "position": 0,
    "text": "برآورد مر زال را دل به جوش"
  },
  {
    "poem_id": 1381,
    "vorder": 64,
    "position": 1,
    "text": "چنان شد کزو رفت آرام وهوش"
  },
  {
    "poem_id": 1381,
    "vorder": 65,
    "position": 0,
    "text": "شب آمد پر اندیشه بنشست زال"
  },
  {
    "poem_id": 1381,
    "vorder": 66,
    "position": 1,
    "text": "به نادیده برگشت بی‌خورد و هال"
  },
  {
    "poem_id": 1381,
    "vorder": 67,
    "position": 0,
    "text": "چو زد بر سر کوه بر تیغ شید"
  },
  {
    "poem_id": 1381,
    "vorder": 68,
    "position": 1,
    "text": "چو یاقوت شد روی گیتی سپید"
  },
  {
    "poem_id": 1381,
    "vorder": 69,
    "position": 0,
    "text": "در بار بگشاد دستان سام"
  },
  {
    "poem_id": 1381,
    "vorder": 70,
    "position": 1,
    "text": "برفتند گردان به زرین نیام"
  },
  {
    "poem_id": 1381,
    "vorder": 71,
    "position": 0,
    "text": "در پهلوان را بیاراستند"
  },
  {
    "poem_id": 1381,
    "vorder": 72,
    "position": 1,
    "text": "چو بالای پرمایگان خواستند"
  },
  {
    "poem_id": 1381,
    "vorder": 73,
    "position": 0,
    "text": "برون رفت مهراب کابل خدای"
  },
  {
    "poem_id": 1381,
    "vorder": 74,
    "position": 1,
    "text": "سوی خیمهٔ زال زابل خدای"
  },
  {
    "poem_id": 1381,
    "vorder": 75,
    "position": 0,
    "text": "چو آمد به نزدیکی بارگاه"
  },
  {
    "poem_id": 1381,
    "vorder": 76,
    "position": 1,
    "text": "خروش آمد از در که بگشای راه"
  },
  {
    "poem_id": 1381,
    "vorder": 77,
    "position": 0,
    "text": "بر پهلوان اندرون رفت گو"
  },
  {
    "poem_id": 1381,
    "vorder": 78,
    "position": 1,
    "text": "به سان درختی پر از بار نو"
  },
  {
    "poem_id": 1381,
    "vorder": 79,
    "position": 0,
    "text": "دل زال شد شاد و بنواختش"
  },
  {
    "poem_id": 1381,
    "vorder": 80,
    "position": 1,
    "text": "از آن انجمن سر برافراختش"
  },
  {
    "poem_id": 1381,
    "vorder": 81,
    "position": 0,
    "text": "بپرسید کز من چه خواهی بخواه"
  },
  {
    "poem_id": 1381,
    "vorder": 82,
    "position": 1,
    "text": "ز تخت و ز مهر و ز تیغ و کلاه"
  },
  {
    "poem_id": 1381,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت مهراب کای پادشا"
  },
  {
    "poem_id": 1381,
    "vorder": 84,
    "position": 1,
    "text": "سرافراز و پیروز و فرمان روا"
  },
  {
    "poem_id": 1381,
    "vorder": 85,
    "position": 0,
    "text": "مرا آرزو در زمانه یکیست"
  },
  {
    "poem_id": 1381,
    "vorder": 86,
    "position": 1,
    "text": "که آن آرزو بر تو دشوار نیست"
  },
  {
    "poem_id": 1381,
    "vorder": 87,
    "position": 0,
    "text": "که آیی به شادی سوی خان من"
  },
  {
    "poem_id": 1381,
    "vorder": 88,
    "position": 1,
    "text": "چو خورشید روشن کنی جان من"
  },
  {
    "poem_id": 1381,
    "vorder": 89,
    "position": 0,
    "text": "چنین داد پاسخ که این رای نیست"
  },
  {
    "poem_id": 1381,
    "vorder": 90,
    "position": 1,
    "text": "به خان تو اندر مرا جای نیست"
  },
  {
    "poem_id": 1381,
    "vorder": 91,
    "position": 0,
    "text": "نباشد بدین سام همداستان"
  },
  {
    "poem_id": 1381,
    "vorder": 92,
    "position": 1,
    "text": "همان شاه چون بشنود داستان"
  },
  {
    "poem_id": 1381,
    "vorder": 93,
    "position": 0,
    "text": "که ما می گساریم و مستان شویم"
  },
  {
    "poem_id": 1381,
    "vorder": 94,
    "position": 1,
    "text": "سوی خانهٔ بت پرستان شویم"
  },
  {
    "poem_id": 1381,
    "vorder": 95,
    "position": 0,
    "text": "جز آن هر چه گویی تو پاسخ دهم"
  },
  {
    "poem_id": 1381,
    "vorder": 96,
    "position": 1,
    "text": "به دیدار تو رای فرخ نهم"
  },
  {
    "poem_id": 1381,
    "vorder": 97,
    "position": 0,
    "text": "چو بشنید مهراب کرد آفرین"
  },
  {
    "poem_id": 1381,
    "vorder": 98,
    "position": 1,
    "text": "به دل زال را خواند ناپاک دین"
  },
  {
    "poem_id": 1381,
    "vorder": 99,
    "position": 0,
    "text": "خرامان برفت از بر تخت اوی"
  },
  {
    "poem_id": 1381,
    "vorder": 100,
    "position": 1,
    "text": "همی آفرین خواند بر بخت اوی"
  },
  {
    "poem_id": 1381,
    "vorder": 101,
    "position": 0,
    "text": "چو دستان سام از پسش بنگرید"
  },
  {
    "poem_id": 1381,
    "vorder": 102,
    "position": 1,
    "text": "ستودش فراوان چنان چون سزید"
  },
  {
    "poem_id": 1381,
    "vorder": 103,
    "position": 0,
    "text": "از آن کو نه هم دین و هم راه بود"
  },
  {
    "poem_id": 1381,
    "vorder": 104,
    "position": 1,
    "text": "زبان از ستودنش کوتاه بود"
  },
  {
    "poem_id": 1381,
    "vorder": 105,
    "position": 0,
    "text": "بر او هیچکس چشم نگماشتند"
  },
  {
    "poem_id": 1381,
    "vorder": 106,
    "position": 1,
    "text": "مر او را ز دیوانگان داشتند"
  },
  {
    "poem_id": 1381,
    "vorder": 107,
    "position": 0,
    "text": "چو روشن دل پهلوان را بدوی"
  },
  {
    "poem_id": 1381,
    "vorder": 108,
    "position": 1,
    "text": "چنان گرم دیدند با گفت‌وگوی"
  },
  {
    "poem_id": 1381,
    "vorder": 109,
    "position": 0,
    "text": "مر او را ستودند یک یک مهان"
  },
  {
    "poem_id": 1381,
    "vorder": 110,
    "position": 1,
    "text": "همان کز پس پرده بودش نهان"
  },
  {
    "poem_id": 1381,
    "vorder": 111,
    "position": 0,
    "text": "ز بالا و دیدار و آهستگی"
  },
  {
    "poem_id": 1381,
    "vorder": 112,
    "position": 1,
    "text": "ز بایستگی هم ز شایستگی"
  },
  {
    "poem_id": 1381,
    "vorder": 113,
    "position": 0,
    "text": "دل زال یکباره دیوانه گشت"
  },
  {
    "poem_id": 1381,
    "vorder": 114,
    "position": 1,
    "text": "خرد دور شد عشق فرزانه گشت"
  },
  {
    "poem_id": 1381,
    "vorder": 115,
    "position": 0,
    "text": "سپهدار تازی سر راستان"
  },
  {
    "poem_id": 1381,
    "vorder": 116,
    "position": 1,
    "text": "بگوید بر این بر یکی داستان"
  },
  {
    "poem_id": 1381,
    "vorder": 117,
    "position": 0,
    "text": "که تا زنده‌ام چرمه جفت منست"
  },
  {
    "poem_id": 1381,
    "vorder": 118,
    "position": 1,
    "text": "خم چرخ گردان نهفت منست"
  },
  {
    "poem_id": 1381,
    "vorder": 119,
    "position": 0,
    "text": "عروسم نباید که رعنا شوم"
  },
  {
    "poem_id": 1381,
    "vorder": 120,
    "position": 1,
    "text": "به نزد خردمند رسوا شوم"
  },
  {
    "poem_id": 1381,
    "vorder": 121,
    "position": 0,
    "text": "از اندیشگان زال شد خسته دل"
  },
  {
    "poem_id": 1381,
    "vorder": 122,
    "position": 1,
    "text": "بر آن کار بنهاد پیوسته دل"
  },
  {
    "poem_id": 1381,
    "vorder": 123,
    "position": 0,
    "text": "همی بود پیچان دل از گفت‌وگوی"
  },
  {
    "poem_id": 1381,
    "vorder": 124,
    "position": 1,
    "text": "مگر تیره گردد از این آبروی"
  },
  {
    "poem_id": 1381,
    "vorder": 125,
    "position": 0,
    "text": "همی گشت یک چند بر سر سپهر"
  },
  {
    "poem_id": 1381,
    "vorder": 126,
    "position": 1,
    "text": "دل زال آگنده یکسر به مهر"
  }
]