[
  {
    "poem_id": 1818,
    "vorder": 1,
    "position": 0,
    "text": "بیامد به تخت کیی برنشست"
  },
  {
    "poem_id": 1818,
    "vorder": 2,
    "position": 1,
    "text": "چنان چون بود شاه یزدان‌پرست"
  },
  {
    "poem_id": 1818,
    "vorder": 3,
    "position": 0,
    "text": "نخستین چنین گفت با مهتران"
  },
  {
    "poem_id": 1818,
    "vorder": 4,
    "position": 1,
    "text": "که ای پرهنر پاکدل سروران"
  },
  {
    "poem_id": 1818,
    "vorder": 5,
    "position": 0,
    "text": "همی‌خواهم از داور بی‌نیاز"
  },
  {
    "poem_id": 1818,
    "vorder": 6,
    "position": 1,
    "text": "که باشد مرا زندگانی دراز"
  },
  {
    "poem_id": 1818,
    "vorder": 7,
    "position": 0,
    "text": "که که را به که دارم و مه به مه"
  },
  {
    "poem_id": 1818,
    "vorder": 8,
    "position": 1,
    "text": "فراوان خرد باشدم روز به"
  },
  {
    "poem_id": 1818,
    "vorder": 9,
    "position": 0,
    "text": "سر مردمی بردباری بود"
  },
  {
    "poem_id": 1818,
    "vorder": 10,
    "position": 1,
    "text": "سبک سر همیشه به خواری بود"
  },
  {
    "poem_id": 1818,
    "vorder": 11,
    "position": 0,
    "text": "ستون خرد داد و بخشایشست"
  },
  {
    "poem_id": 1818,
    "vorder": 12,
    "position": 1,
    "text": "در بخشش او را چو آرایشست"
  },
  {
    "poem_id": 1818,
    "vorder": 13,
    "position": 0,
    "text": "زبان چرب و گویندگی فر اوست"
  },
  {
    "poem_id": 1818,
    "vorder": 14,
    "position": 1,
    "text": "دلیری و مردانگی پر اوست"
  },
  {
    "poem_id": 1818,
    "vorder": 15,
    "position": 0,
    "text": "هران نامور کو ندارد خرد"
  },
  {
    "poem_id": 1818,
    "vorder": 16,
    "position": 1,
    "text": "ز تخت بزرگی کجا برخورد؟"
  },
  {
    "poem_id": 1818,
    "vorder": 17,
    "position": 0,
    "text": "خردمند هم نیز جاوید نیست"
  },
  {
    "poem_id": 1818,
    "vorder": 18,
    "position": 1,
    "text": "فری برتر از فر جمشید نیست"
  },
  {
    "poem_id": 1818,
    "vorder": 19,
    "position": 0,
    "text": "چو تاجش به ماه اندر آمد بمرد"
  },
  {
    "poem_id": 1818,
    "vorder": 20,
    "position": 1,
    "text": "نشست کیی دیگری را سپرد"
  },
  {
    "poem_id": 1818,
    "vorder": 21,
    "position": 0,
    "text": "نماند برین خاک جاوید کس"
  },
  {
    "poem_id": 1818,
    "vorder": 22,
    "position": 1,
    "text": "ز هر بد به یزدان پناهید و بس"
  },
  {
    "poem_id": 1818,
    "vorder": 23,
    "position": 0,
    "text": "همی‌بود یک سال با داد و پند"
  },
  {
    "poem_id": 1818,
    "vorder": 24,
    "position": 1,
    "text": "خردمند وز هر بدی بی‌گزند"
  },
  {
    "poem_id": 1818,
    "vorder": 25,
    "position": 0,
    "text": "دگر سال روی هوا خشک شد"
  },
  {
    "poem_id": 1818,
    "vorder": 26,
    "position": 1,
    "text": "به جو اندرون آب چون مشک شد"
  },
  {
    "poem_id": 1818,
    "vorder": 27,
    "position": 0,
    "text": "سه دیگر همان و چهارم همان"
  },
  {
    "poem_id": 1818,
    "vorder": 28,
    "position": 1,
    "text": "ز خشکی نبد هیچکس شادمان"
  },
  {
    "poem_id": 1818,
    "vorder": 29,
    "position": 0,
    "text": "هوا را دهان خشک چون خاک شد"
  },
  {
    "poem_id": 1818,
    "vorder": 30,
    "position": 1,
    "text": "ز تنگی به جو آب تریاک شد"
  },
  {
    "poem_id": 1818,
    "vorder": 31,
    "position": 0,
    "text": "ز بس مردن مردم و چارپای"
  },
  {
    "poem_id": 1818,
    "vorder": 32,
    "position": 1,
    "text": "پیی را ندیدند بر خاک جای"
  },
  {
    "poem_id": 1818,
    "vorder": 33,
    "position": 0,
    "text": "شهنشاه ایران چو دید آن شگفت"
  },
  {
    "poem_id": 1818,
    "vorder": 34,
    "position": 1,
    "text": "خراج و گزیت از جهان برگرفت"
  },
  {
    "poem_id": 1818,
    "vorder": 35,
    "position": 0,
    "text": "به هر سو که انبار بودش نهان"
  },
  {
    "poem_id": 1818,
    "vorder": 36,
    "position": 1,
    "text": "ببخشید بر کهتران و مهان"
  },
  {
    "poem_id": 1818,
    "vorder": 37,
    "position": 0,
    "text": "خروشی برآمد ز درگاه شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 38,
    "position": 1,
    "text": "که ای نامداران با دستگاه"
  },
  {
    "poem_id": 1818,
    "vorder": 39,
    "position": 0,
    "text": "غله هرچ دارید پیدا کنید"
  },
  {
    "poem_id": 1818,
    "vorder": 40,
    "position": 1,
    "text": "ز دینار پیروز گنج آگنید"
  },
  {
    "poem_id": 1818,
    "vorder": 41,
    "position": 0,
    "text": "هر آنکس که دارد نهانی غله"
  },
  {
    "poem_id": 1818,
    "vorder": 42,
    "position": 1,
    "text": "وگر گاو و گر گوسفند و گله"
  },
  {
    "poem_id": 1818,
    "vorder": 43,
    "position": 0,
    "text": "به نرخی فروشد که او را هواست"
  },
  {
    "poem_id": 1818,
    "vorder": 44,
    "position": 1,
    "text": "که از خوردنی جانور بی‌نواست"
  },
  {
    "poem_id": 1818,
    "vorder": 45,
    "position": 0,
    "text": "به هر کارداری و خودکامه‌ای"
  },
  {
    "poem_id": 1818,
    "vorder": 46,
    "position": 1,
    "text": "فرستاد تازان یکی نامه‌ای"
  },
  {
    "poem_id": 1818,
    "vorder": 47,
    "position": 0,
    "text": "که انبارها برگشایند باز"
  },
  {
    "poem_id": 1818,
    "vorder": 48,
    "position": 1,
    "text": "به گیتی برآنکس که هستش نیاز"
  },
  {
    "poem_id": 1818,
    "vorder": 49,
    "position": 0,
    "text": "کسی گر بمیرد بنایافت نان"
  },
  {
    "poem_id": 1818,
    "vorder": 50,
    "position": 1,
    "text": "ز برنا و از پیر مرد و زنان"
  },
  {
    "poem_id": 1818,
    "vorder": 51,
    "position": 0,
    "text": "بریزم ز تن خون انباردار"
  },
  {
    "poem_id": 1818,
    "vorder": 52,
    "position": 1,
    "text": "کجا کار یزدان گرفتست خوار"
  },
  {
    "poem_id": 1818,
    "vorder": 53,
    "position": 0,
    "text": "بفرمود تا خانه بگذاشتند"
  },
  {
    "poem_id": 1818,
    "vorder": 54,
    "position": 1,
    "text": "به دشت آمد و دست برداشتند"
  },
  {
    "poem_id": 1818,
    "vorder": 55,
    "position": 0,
    "text": "همی به آسمان اندر آمد خروش"
  },
  {
    "poem_id": 1818,
    "vorder": 56,
    "position": 1,
    "text": "ز بس مویه و درد و زاری و جوش"
  },
  {
    "poem_id": 1818,
    "vorder": 57,
    "position": 0,
    "text": "ز کوه و بیابان وز دشت و غار"
  },
  {
    "poem_id": 1818,
    "vorder": 58,
    "position": 1,
    "text": "ز یزدان همی‌خواستی زینهار"
  },
  {
    "poem_id": 1818,
    "vorder": 59,
    "position": 0,
    "text": "برین گونه تا هفت سال از جهان"
  },
  {
    "poem_id": 1818,
    "vorder": 60,
    "position": 1,
    "text": "ندیدند سبزی کهان و مهان"
  },
  {
    "poem_id": 1818,
    "vorder": 61,
    "position": 0,
    "text": "به هشتُم بیامد مه فرودین"
  },
  {
    "poem_id": 1818,
    "vorder": 62,
    "position": 1,
    "text": "برآمد یکی ابر با آفرین"
  },
  {
    "poem_id": 1818,
    "vorder": 63,
    "position": 0,
    "text": "همی دُرّ بارید بر خاک خشک"
  },
  {
    "poem_id": 1818,
    "vorder": 64,
    "position": 1,
    "text": "همی‌آمد از بوستان بوی مشک"
  },
  {
    "poem_id": 1818,
    "vorder": 65,
    "position": 0,
    "text": "شده ژاله بر گل چو مل در قدح"
  },
  {
    "poem_id": 1818,
    "vorder": 66,
    "position": 1,
    "text": "همی‌تافت از ابر قوس قزح"
  },
  {
    "poem_id": 1818,
    "vorder": 67,
    "position": 0,
    "text": "زمانه‌ برست از بد بدگمان"
  },
  {
    "poem_id": 1818,
    "vorder": 68,
    "position": 1,
    "text": "به هرجای بر زه نهاده کمان"
  },
  {
    "poem_id": 1818,
    "vorder": 69,
    "position": 0,
    "text": "چو پیروز ازان روز تنگی‌ برست"
  },
  {
    "poem_id": 1818,
    "vorder": 70,
    "position": 1,
    "text": "بر آرام بر تخت شاهی نشست"
  },
  {
    "poem_id": 1818,
    "vorder": 71,
    "position": 0,
    "text": "یکی شارستان کرد پیروز کام"
  },
  {
    "poem_id": 1818,
    "vorder": 72,
    "position": 1,
    "text": "بفرمود کو را نهادند نام"
  },
  {
    "poem_id": 1818,
    "vorder": 73,
    "position": 0,
    "text": "جهاندار گوینده گفت این رِی‌ست"
  },
  {
    "poem_id": 1818,
    "vorder": 74,
    "position": 1,
    "text": "که آرام شاهان فرخ‌پی‌ست"
  },
  {
    "poem_id": 1818,
    "vorder": 75,
    "position": 0,
    "text": "دگر کرد بادان پیروز نام"
  },
  {
    "poem_id": 1818,
    "vorder": 76,
    "position": 1,
    "text": "خنیده به هرجایش آرام و کام"
  },
  {
    "poem_id": 1818,
    "vorder": 77,
    "position": 0,
    "text": "که اکنونش خوانی همی اردبیل"
  },
  {
    "poem_id": 1818,
    "vorder": 78,
    "position": 1,
    "text": "که قیصر بدو دارد از داد میل"
  },
  {
    "poem_id": 1818,
    "vorder": 79,
    "position": 0,
    "text": "چو این بوم‌ها یکسر آباد کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 80,
    "position": 1,
    "text": "دل مردم پر خرد شاد کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 81,
    "position": 0,
    "text": "درم داد با لشکر نامدار"
  },
  {
    "poem_id": 1818,
    "vorder": 82,
    "position": 1,
    "text": "سوی جنگ جستن برآراست کار"
  },
  {
    "poem_id": 1818,
    "vorder": 83,
    "position": 0,
    "text": "بدان جنگ هرمز بُدی پیش‌رو"
  },
  {
    "poem_id": 1818,
    "vorder": 84,
    "position": 1,
    "text": "همی‌رفت با کارسازان نو"
  },
  {
    "poem_id": 1818,
    "vorder": 85,
    "position": 0,
    "text": "قباد از پس پشت پیروز شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 86,
    "position": 1,
    "text": "همی‌راند چون باد لشکر به راه"
  },
  {
    "poem_id": 1818,
    "vorder": 87,
    "position": 0,
    "text": "که پیروز را پاک فرزند بود"
  },
  {
    "poem_id": 1818,
    "vorder": 88,
    "position": 1,
    "text": "خردمند شاخی برومند بود"
  },
  {
    "poem_id": 1818,
    "vorder": 89,
    "position": 0,
    "text": "بلاش از بر تخت بنشست شاد"
  },
  {
    "poem_id": 1818,
    "vorder": 90,
    "position": 1,
    "text": "که کهتر پسر بود با مهر و داد"
  },
  {
    "poem_id": 1818,
    "vorder": 91,
    "position": 0,
    "text": "یکی پارسی بود بس نامدار"
  },
  {
    "poem_id": 1818,
    "vorder": 92,
    "position": 1,
    "text": "ورا سوفزا خواندی شهریار"
  },
  {
    "poem_id": 1818,
    "vorder": 93,
    "position": 0,
    "text": "بفرمود پیروز کایدر بباش"
  },
  {
    "poem_id": 1818,
    "vorder": 94,
    "position": 1,
    "text": "چو دستور شایسته نزد بلاش"
  },
  {
    "poem_id": 1818,
    "vorder": 95,
    "position": 0,
    "text": "سپه را سوی جنگ ترکان کشید"
  },
  {
    "poem_id": 1818,
    "vorder": 96,
    "position": 1,
    "text": "همی تاج و تخت کیی را سزید"
  },
  {
    "poem_id": 1818,
    "vorder": 97,
    "position": 0,
    "text": "همی‌راند با لشکر و گنج و ساز"
  },
  {
    "poem_id": 1818,
    "vorder": 98,
    "position": 1,
    "text": "که پیکار جویند با خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 99,
    "position": 0,
    "text": "نشانی که بهرام یل کرده بود"
  },
  {
    "poem_id": 1818,
    "vorder": 100,
    "position": 1,
    "text": "ز پستی بلندی برآورده بود"
  },
  {
    "poem_id": 1818,
    "vorder": 101,
    "position": 0,
    "text": "نبشته یکی عهد شاهنشهان"
  },
  {
    "poem_id": 1818,
    "vorder": 102,
    "position": 1,
    "text": "که از ترک و ایرانیان در جهان"
  },
  {
    "poem_id": 1818,
    "vorder": 103,
    "position": 0,
    "text": "کسی زین نشان هیچ برنگذرد"
  },
  {
    "poem_id": 1818,
    "vorder": 104,
    "position": 1,
    "text": "کزان رود برتر زمین نشمرد"
  },
  {
    "poem_id": 1818,
    "vorder": 105,
    "position": 0,
    "text": "چو پیروز شیراوژن آنجا رسید"
  },
  {
    "poem_id": 1818,
    "vorder": 106,
    "position": 1,
    "text": "نشان کردن شاه ایران بدید"
  },
  {
    "poem_id": 1818,
    "vorder": 107,
    "position": 0,
    "text": "چنین گفت یکسر به گردنکشان"
  },
  {
    "poem_id": 1818,
    "vorder": 108,
    "position": 1,
    "text": "که از پیش ترکان برین همنشان"
  },
  {
    "poem_id": 1818,
    "vorder": 109,
    "position": 0,
    "text": "مناره برآرم به شمشیر و گنج"
  },
  {
    "poem_id": 1818,
    "vorder": 110,
    "position": 1,
    "text": "ز هیتال تا کس نباشد به رنج"
  },
  {
    "poem_id": 1818,
    "vorder": 111,
    "position": 0,
    "text": "چو باشد مناره به پیش برک"
  },
  {
    "poem_id": 1818,
    "vorder": 112,
    "position": 1,
    "text": "بزرگان به پیش من آرند چک"
  },
  {
    "poem_id": 1818,
    "vorder": 113,
    "position": 0,
    "text": "بگویم که آن کرد بهرام گور"
  },
  {
    "poem_id": 1818,
    "vorder": 114,
    "position": 1,
    "text": "به مردی و دانایی و فر و زور"
  },
  {
    "poem_id": 1818,
    "vorder": 115,
    "position": 0,
    "text": "نمانم به جایی پی خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 116,
    "position": 1,
    "text": "به هیتال و ترک از نشیب و فراز"
  },
  {
    "poem_id": 1818,
    "vorder": 117,
    "position": 0,
    "text": "چو بشنید فرزند خاقان که شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 118,
    "position": 1,
    "text": "ز جیحون گذر کرد خود با سپاه"
  },
  {
    "poem_id": 1818,
    "vorder": 119,
    "position": 0,
    "text": "همی‌بشکند عهد بهرام گور"
  },
  {
    "poem_id": 1818,
    "vorder": 120,
    "position": 1,
    "text": "بدان تازه شد کشتن و جنگ و شور"
  },
  {
    "poem_id": 1818,
    "vorder": 121,
    "position": 0,
    "text": "دبیر جهاندیده را خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 122,
    "position": 1,
    "text": "بفرمود تا شد بر او فراز"
  },
  {
    "poem_id": 1818,
    "vorder": 123,
    "position": 0,
    "text": "یکی نامه بنوشت با آفرین"
  },
  {
    "poem_id": 1818,
    "vorder": 124,
    "position": 1,
    "text": "ز دادار بر شهریار زمین"
  },
  {
    "poem_id": 1818,
    "vorder": 125,
    "position": 0,
    "text": "چنین گفت کز عهد شاهان داد"
  },
  {
    "poem_id": 1818,
    "vorder": 126,
    "position": 1,
    "text": "به گردی نخوانمت خسرونژاد"
  },
  {
    "poem_id": 1818,
    "vorder": 127,
    "position": 0,
    "text": "نه این بود عهد نیاکان تو"
  },
  {
    "poem_id": 1818,
    "vorder": 128,
    "position": 1,
    "text": "گزیده جهاندار و پاکان تو"
  },
  {
    "poem_id": 1818,
    "vorder": 129,
    "position": 0,
    "text": "چو پیمان آزادگان بشکنی"
  },
  {
    "poem_id": 1818,
    "vorder": 130,
    "position": 1,
    "text": "نشان بزرگی به خاک افگنی"
  },
  {
    "poem_id": 1818,
    "vorder": 131,
    "position": 0,
    "text": "مرا با تو پیمان بباید شکست"
  },
  {
    "poem_id": 1818,
    "vorder": 132,
    "position": 1,
    "text": "به ناچار بردن به شمشیر دست"
  },
  {
    "poem_id": 1818,
    "vorder": 133,
    "position": 0,
    "text": "به نامه ز هر کارش آگاه کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 134,
    "position": 1,
    "text": "بسی هدیه با نامه همراه کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 135,
    "position": 0,
    "text": "سواری سراینده و سرفراز"
  },
  {
    "poem_id": 1818,
    "vorder": 136,
    "position": 1,
    "text": "همی‌رفت با نامهٔ خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 137,
    "position": 0,
    "text": "چو آن نامه برخواند پیروز شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 138,
    "position": 1,
    "text": "برآشفت زان نامور پیشگاه"
  },
  {
    "poem_id": 1818,
    "vorder": 139,
    "position": 0,
    "text": "فرستاده را گفت برخیز و رو"
  },
  {
    "poem_id": 1818,
    "vorder": 140,
    "position": 1,
    "text": "به نزدیک آن مرد دیوانه شو"
  },
  {
    "poem_id": 1818,
    "vorder": 141,
    "position": 0,
    "text": "بگویش که تا پیش رود برک"
  },
  {
    "poem_id": 1818,
    "vorder": 142,
    "position": 1,
    "text": "شما را فرستاد بهرام چک"
  },
  {
    "poem_id": 1818,
    "vorder": 143,
    "position": 0,
    "text": "کنون تا لب رود جیحون تو راست"
  },
  {
    "poem_id": 1818,
    "vorder": 144,
    "position": 1,
    "text": "بلندی و پستی و هامون تو راست"
  },
  {
    "poem_id": 1818,
    "vorder": 145,
    "position": 0,
    "text": "من اینک بیارم سپاهی گران"
  },
  {
    "poem_id": 1818,
    "vorder": 146,
    "position": 1,
    "text": "سرافراز گردان جنگ آوران"
  },
  {
    "poem_id": 1818,
    "vorder": 147,
    "position": 0,
    "text": "نمانم مگر سایهٔ خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 148,
    "position": 1,
    "text": "که باشد بروی زمین بر دراز"
  },
  {
    "poem_id": 1818,
    "vorder": 149,
    "position": 0,
    "text": "فرستاده آمد به کردار گرد"
  },
  {
    "poem_id": 1818,
    "vorder": 150,
    "position": 1,
    "text": "شنیده سخن‌ها همه یاد کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 151,
    "position": 0,
    "text": "همی‌گفت یک چند با خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 152,
    "position": 1,
    "text": "ازان شاه گردنکش و دیرساز"
  },
  {
    "poem_id": 1818,
    "vorder": 153,
    "position": 0,
    "text": "چو گفتار بشنید و نامه بخواند"
  },
  {
    "poem_id": 1818,
    "vorder": 154,
    "position": 1,
    "text": "سپاه پراگنده را برنشاند"
  },
  {
    "poem_id": 1818,
    "vorder": 155,
    "position": 0,
    "text": "بیاورد لشکر به دشت نبرد"
  },
  {
    "poem_id": 1818,
    "vorder": 156,
    "position": 1,
    "text": "همان عهد را بر سر نیزه کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 157,
    "position": 0,
    "text": "که بستد نیایش ز بهرامشاه"
  },
  {
    "poem_id": 1818,
    "vorder": 158,
    "position": 1,
    "text": "که جیحون میانجیست ما را به راه"
  },
  {
    "poem_id": 1818,
    "vorder": 159,
    "position": 0,
    "text": "یکی مرد بینادل و چرب‌گوی"
  },
  {
    "poem_id": 1818,
    "vorder": 160,
    "position": 1,
    "text": "ز لشکر گزین کرد با آبروی"
  },
  {
    "poem_id": 1818,
    "vorder": 161,
    "position": 0,
    "text": "بدو گفت نزدیک پیروز رو"
  },
  {
    "poem_id": 1818,
    "vorder": 162,
    "position": 1,
    "text": "به چربی سخن‌گوی و پاسخ شنو"
  },
  {
    "poem_id": 1818,
    "vorder": 163,
    "position": 0,
    "text": "بگویش که عهد نیای تو را"
  },
  {
    "poem_id": 1818,
    "vorder": 164,
    "position": 1,
    "text": "بلند اختر و رهنمای تو را"
  },
  {
    "poem_id": 1818,
    "vorder": 165,
    "position": 0,
    "text": "همی بر سر نیزه پیش سپاه"
  },
  {
    "poem_id": 1818,
    "vorder": 166,
    "position": 1,
    "text": "بیارم چو خورشید تابان به راه"
  },
  {
    "poem_id": 1818,
    "vorder": 167,
    "position": 0,
    "text": "بدان تا هر آنکس که دارد خرد"
  },
  {
    "poem_id": 1818,
    "vorder": 168,
    "position": 1,
    "text": "به منشور آن دادگر بنگرد"
  },
  {
    "poem_id": 1818,
    "vorder": 169,
    "position": 0,
    "text": "مرا آفرین بر تو نفرین بود"
  },
  {
    "poem_id": 1818,
    "vorder": 170,
    "position": 1,
    "text": "همان نام تو شاه بی‌دین بود"
  },
  {
    "poem_id": 1818,
    "vorder": 171,
    "position": 0,
    "text": "نه یزدان پسندد نه یزدان‌پرست"
  },
  {
    "poem_id": 1818,
    "vorder": 172,
    "position": 1,
    "text": "نه اندر جهان مردم زیردست"
  },
  {
    "poem_id": 1818,
    "vorder": 173,
    "position": 0,
    "text": "که بیداد جوید کسی در جهان"
  },
  {
    "poem_id": 1818,
    "vorder": 174,
    "position": 1,
    "text": "بپیچد سر از عهد شاهنشهان"
  },
  {
    "poem_id": 1818,
    "vorder": 175,
    "position": 0,
    "text": "به داد و به مردی چو بهرام شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 176,
    "position": 1,
    "text": "کسی نیز ننهاد بر سر کلاه"
  },
  {
    "poem_id": 1818,
    "vorder": 177,
    "position": 0,
    "text": "برین بر جهاندار یزدان گواست"
  },
  {
    "poem_id": 1818,
    "vorder": 178,
    "position": 1,
    "text": "که او را گوا خواستن ناسزاست"
  },
  {
    "poem_id": 1818,
    "vorder": 179,
    "position": 0,
    "text": "که بیداد جوید همی جنگ من"
  },
  {
    "poem_id": 1818,
    "vorder": 180,
    "position": 1,
    "text": "چنین با سپه کردن آهنگ من"
  },
  {
    "poem_id": 1818,
    "vorder": 181,
    "position": 0,
    "text": "نباشی تو زین جنگ پیروزگر"
  },
  {
    "poem_id": 1818,
    "vorder": 182,
    "position": 1,
    "text": "نیابی مگر ز اختر نیک بر"
  },
  {
    "poem_id": 1818,
    "vorder": 183,
    "position": 0,
    "text": "ازین پس نخواهم فرستاد کس"
  },
  {
    "poem_id": 1818,
    "vorder": 184,
    "position": 1,
    "text": "بدین جنگ یزدان مرا یار بس"
  },
  {
    "poem_id": 1818,
    "vorder": 185,
    "position": 0,
    "text": "فرستاده با نامه آمد چو گرد"
  },
  {
    "poem_id": 1818,
    "vorder": 186,
    "position": 1,
    "text": "سخن‌ها به پیروز بر یاد کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 187,
    "position": 0,
    "text": "چو برخواند آن نامهٔ خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 188,
    "position": 1,
    "text": "پر از خشم شد شاه گردن فراز"
  },
  {
    "poem_id": 1818,
    "vorder": 189,
    "position": 0,
    "text": "فرستاده را گفت چندین سخن"
  },
  {
    "poem_id": 1818,
    "vorder": 190,
    "position": 1,
    "text": "نگوید جهاندیده مرد کهن"
  },
  {
    "poem_id": 1818,
    "vorder": 191,
    "position": 0,
    "text": "که از چاچ یک پی نهد نزد رود"
  },
  {
    "poem_id": 1818,
    "vorder": 192,
    "position": 1,
    "text": "به نوک سنانش فرستم درود"
  },
  {
    "poem_id": 1818,
    "vorder": 193,
    "position": 0,
    "text": "فرستاده آمد بر خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 194,
    "position": 1,
    "text": "فراوان سخن گفت با او به راز"
  },
  {
    "poem_id": 1818,
    "vorder": 195,
    "position": 0,
    "text": "که نزدیک پیروز، ترسِ خدای"
  },
  {
    "poem_id": 1818,
    "vorder": 196,
    "position": 1,
    "text": "ندیدم نبودش کسی رهنمای"
  },
  {
    "poem_id": 1818,
    "vorder": 197,
    "position": 0,
    "text": "همه دیدمش جنگ جوید همی"
  },
  {
    "poem_id": 1818,
    "vorder": 198,
    "position": 1,
    "text": "به فرمان یزدان نگوید همی"
  },
  {
    "poem_id": 1818,
    "vorder": 199,
    "position": 0,
    "text": "چو بشندی زو این سخن خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 200,
    "position": 1,
    "text": "به یزدان پناهید و بردش نماز"
  },
  {
    "poem_id": 1818,
    "vorder": 201,
    "position": 0,
    "text": "چنین گفت کای داور داد و پاک"
  },
  {
    "poem_id": 1818,
    "vorder": 202,
    "position": 1,
    "text": "تویی آفرینندهٔ هور و خاک"
  },
  {
    "poem_id": 1818,
    "vorder": 203,
    "position": 0,
    "text": "تو دانی که پیروز بیدادگر"
  },
  {
    "poem_id": 1818,
    "vorder": 204,
    "position": 1,
    "text": "ز بهرام بیشی ندارد هنر"
  },
  {
    "poem_id": 1818,
    "vorder": 205,
    "position": 0,
    "text": "پی او ز روی زمین برگسل"
  },
  {
    "poem_id": 1818,
    "vorder": 206,
    "position": 1,
    "text": "مه نیرو مه آهنگ جانش مه دل"
  },
  {
    "poem_id": 1818,
    "vorder": 207,
    "position": 0,
    "text": "سخن‌های بیداد گوید همی"
  },
  {
    "poem_id": 1818,
    "vorder": 208,
    "position": 1,
    "text": "بزرگی به شمشیر جوید همی"
  },
  {
    "poem_id": 1818,
    "vorder": 209,
    "position": 0,
    "text": "به گرد سپه بر یکی کنده کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 210,
    "position": 1,
    "text": "سرش را بپوشید و آگنده کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 211,
    "position": 0,
    "text": "کمندی فزون بود بالای اوی"
  },
  {
    "poem_id": 1818,
    "vorder": 212,
    "position": 1,
    "text": "همان سی ارش کرده پهنای اوی"
  },
  {
    "poem_id": 1818,
    "vorder": 213,
    "position": 0,
    "text": "چو این کرده شد نام یزدان بخواند"
  },
  {
    "poem_id": 1818,
    "vorder": 214,
    "position": 1,
    "text": "ز پیش سمرقند لشکر براند"
  },
  {
    "poem_id": 1818,
    "vorder": 215,
    "position": 0,
    "text": "وزان روی سرگشته پیروز شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 216,
    "position": 1,
    "text": "همی‌راند چون باد لشکر به راه"
  },
  {
    "poem_id": 1818,
    "vorder": 217,
    "position": 0,
    "text": "وزین روی پر بیم دل خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 218,
    "position": 1,
    "text": "چنین تا برِ کنده آمد فراز"
  },
  {
    "poem_id": 1818,
    "vorder": 219,
    "position": 0,
    "text": "برآمد ز هردو سپه بوق و کوس"
  },
  {
    "poem_id": 1818,
    "vorder": 220,
    "position": 1,
    "text": "هوا شد ز گرد سپاه آبنوس"
  },
  {
    "poem_id": 1818,
    "vorder": 221,
    "position": 0,
    "text": "چنان تیرباران بد از هر دو روی"
  },
  {
    "poem_id": 1818,
    "vorder": 222,
    "position": 1,
    "text": "که چون آب خون اندر آمد به جوی"
  },
  {
    "poem_id": 1818,
    "vorder": 223,
    "position": 0,
    "text": "چو نزدیکی کنده شد خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 224,
    "position": 1,
    "text": "همی‌گفت با داور پاک راز"
  },
  {
    "poem_id": 1818,
    "vorder": 225,
    "position": 0,
    "text": "وزان روی چون باد پیروزشاه"
  },
  {
    "poem_id": 1818,
    "vorder": 226,
    "position": 1,
    "text": "همی‌تاخت با خوارمایه سپاه"
  },
  {
    "poem_id": 1818,
    "vorder": 227,
    "position": 0,
    "text": "چو آمد به نزدیکی خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 228,
    "position": 1,
    "text": "سپهدار ترکان ازو گشت باز"
  },
  {
    "poem_id": 1818,
    "vorder": 229,
    "position": 0,
    "text": "عنان را بپیچید و بنمود پشت"
  },
  {
    "poem_id": 1818,
    "vorder": 230,
    "position": 1,
    "text": "پس او سپاه اندر آمد درشت"
  },
  {
    "poem_id": 1818,
    "vorder": 231,
    "position": 0,
    "text": "برانگیخت پس باره پیروزشاه"
  },
  {
    "poem_id": 1818,
    "vorder": 232,
    "position": 1,
    "text": "همی‌راند با گرز و رومی کلاه"
  },
  {
    "poem_id": 1818,
    "vorder": 233,
    "position": 0,
    "text": "به کنده در افتاد با چند مرد"
  },
  {
    "poem_id": 1818,
    "vorder": 234,
    "position": 1,
    "text": "بزرگان و شیران روز نبرد"
  },
  {
    "poem_id": 1818,
    "vorder": 235,
    "position": 0,
    "text": "چو نرسی برادرش و فرخ قباد"
  },
  {
    "poem_id": 1818,
    "vorder": 236,
    "position": 1,
    "text": "بزرگان و شاهان فرخ نژاد"
  },
  {
    "poem_id": 1818,
    "vorder": 237,
    "position": 0,
    "text": "برین سان نگون شد سر هفت شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 238,
    "position": 1,
    "text": "همه نامداران زرین کلاه"
  },
  {
    "poem_id": 1818,
    "vorder": 239,
    "position": 0,
    "text": "وزان جایگه شاددل خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 240,
    "position": 1,
    "text": "به نزدیکی کنده آمد فراز"
  },
  {
    "poem_id": 1818,
    "vorder": 241,
    "position": 0,
    "text": "برآورد زان کنده هر کس که زیست"
  },
  {
    "poem_id": 1818,
    "vorder": 242,
    "position": 1,
    "text": "همان خاک بر بخت ایشان گریست"
  },
  {
    "poem_id": 1818,
    "vorder": 243,
    "position": 0,
    "text": "بزرگان و پیکارجویان هران"
  },
  {
    "poem_id": 1818,
    "vorder": 244,
    "position": 1,
    "text": "کسی را که در کنده آمد زمان"
  },
  {
    "poem_id": 1818,
    "vorder": 245,
    "position": 0,
    "text": "شکسته سر و پشت پیروزشاه"
  },
  {
    "poem_id": 1818,
    "vorder": 246,
    "position": 1,
    "text": "شه نامداران با تاج و گاه"
  },
  {
    "poem_id": 1818,
    "vorder": 247,
    "position": 0,
    "text": "ز شاهان نبد زنده جز کیقباد"
  },
  {
    "poem_id": 1818,
    "vorder": 248,
    "position": 1,
    "text": "شد آن لشکر و پادشاهی به باد"
  },
  {
    "poem_id": 1818,
    "vorder": 249,
    "position": 0,
    "text": "همی‌راند با کام دل خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 250,
    "position": 1,
    "text": "سرافراز با لشکر رزمساز"
  },
  {
    "poem_id": 1818,
    "vorder": 251,
    "position": 0,
    "text": "به تاراج داده سپاه و بنه"
  },
  {
    "poem_id": 1818,
    "vorder": 252,
    "position": 1,
    "text": "نه کس میسره دید و نه میمنه"
  },
  {
    "poem_id": 1818,
    "vorder": 253,
    "position": 0,
    "text": "ز ایرانیان چند بردند اسیر"
  },
  {
    "poem_id": 1818,
    "vorder": 254,
    "position": 1,
    "text": "چه افگنده بر خاک و خسته به تیر"
  },
  {
    "poem_id": 1818,
    "vorder": 255,
    "position": 0,
    "text": "نباید که باشد جهانجوی زفت"
  },
  {
    "poem_id": 1818,
    "vorder": 256,
    "position": 1,
    "text": "دل زفت با خاک تیره‌ست جفت"
  },
  {
    "poem_id": 1818,
    "vorder": 257,
    "position": 0,
    "text": "چنین آمد این چرخ ناپایدار"
  },
  {
    "poem_id": 1818,
    "vorder": 258,
    "position": 1,
    "text": "چه با زیردست و چه با شهریار"
  },
  {
    "poem_id": 1818,
    "vorder": 259,
    "position": 0,
    "text": "بپیچاند آن را که خود پرورد"
  },
  {
    "poem_id": 1818,
    "vorder": 260,
    "position": 1,
    "text": "اگر تو شوی پاسبان خرد"
  },
  {
    "poem_id": 1818,
    "vorder": 261,
    "position": 0,
    "text": "نماند برین خاک جاوید کس"
  },
  {
    "poem_id": 1818,
    "vorder": 262,
    "position": 1,
    "text": "تو را توشه از راستی باد و بس"
  },
  {
    "poem_id": 1818,
    "vorder": 263,
    "position": 0,
    "text": "چو بگذشت بر کنده بر خوشنواز"
  },
  {
    "poem_id": 1818,
    "vorder": 264,
    "position": 1,
    "text": "سپاهش شد از خواسته بی‌نیاز"
  },
  {
    "poem_id": 1818,
    "vorder": 265,
    "position": 0,
    "text": "به آهن ببستند پای قباد"
  },
  {
    "poem_id": 1818,
    "vorder": 266,
    "position": 1,
    "text": "ز تخت و نژادش نکردند یاد"
  },
  {
    "poem_id": 1818,
    "vorder": 267,
    "position": 0,
    "text": "چو آگاهی آمد به ایران سپاه"
  },
  {
    "poem_id": 1818,
    "vorder": 268,
    "position": 1,
    "text": "ازان کنده و رزم پیروز شاه"
  },
  {
    "poem_id": 1818,
    "vorder": 269,
    "position": 0,
    "text": "خروشی برآمد ز کشور به درد"
  },
  {
    "poem_id": 1818,
    "vorder": 270,
    "position": 1,
    "text": "ازان شهریاران آزادمرد"
  },
  {
    "poem_id": 1818,
    "vorder": 271,
    "position": 0,
    "text": "چو اندر جهان این سخن گشت فاش"
  },
  {
    "poem_id": 1818,
    "vorder": 272,
    "position": 1,
    "text": "فرود آمد از تخت زرین بلاش"
  },
  {
    "poem_id": 1818,
    "vorder": 273,
    "position": 0,
    "text": "همه گوشت بازو به دندان بکند"
  },
  {
    "poem_id": 1818,
    "vorder": 274,
    "position": 1,
    "text": "همی‌ریخت بر تخت خاک نژند"
  },
  {
    "poem_id": 1818,
    "vorder": 275,
    "position": 0,
    "text": "سپاهی و شهری ز ایران به درد"
  },
  {
    "poem_id": 1818,
    "vorder": 276,
    "position": 1,
    "text": "زن و مرد و کودک همی مویه کرد"
  },
  {
    "poem_id": 1818,
    "vorder": 277,
    "position": 0,
    "text": "همه کنده‌موی و همه خسته‌روی"
  },
  {
    "poem_id": 1818,
    "vorder": 278,
    "position": 1,
    "text": "همه شاه‌جوی و همه راه‌جوی"
  },
  {
    "poem_id": 1818,
    "vorder": 279,
    "position": 0,
    "text": "که تا چون گریزند ز ایران زمین"
  },
  {
    "poem_id": 1818,
    "vorder": 280,
    "position": 1,
    "text": "گر آیند لشکر ازان دشت کین"
  }
]