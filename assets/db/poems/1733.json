[
  {
    "poem_id": 1733,
    "vorder": 1,
    "position": 0,
    "text": "به شاهی برو آفرین خواندند"
  },
  {
    "poem_id": 1733,
    "vorder": 2,
    "position": 1,
    "text": "همه مهتران گوهر افشاندند"
  },
  {
    "poem_id": 1733,
    "vorder": 3,
    "position": 0,
    "text": "یکی موبدی بود شهرو به نام"
  },
  {
    "poem_id": 1733,
    "vorder": 4,
    "position": 1,
    "text": "خردمند و شایسته و شادکام"
  },
  {
    "poem_id": 1733,
    "vorder": 5,
    "position": 0,
    "text": "بیامد به کرسی زرین نشست"
  },
  {
    "poem_id": 1733,
    "vorder": 6,
    "position": 1,
    "text": "میان پیش او بندگی را ببست"
  },
  {
    "poem_id": 1733,
    "vorder": 7,
    "position": 0,
    "text": "جهان را همی داشت با داد و رای"
  },
  {
    "poem_id": 1733,
    "vorder": 8,
    "position": 1,
    "text": "سپه را به هر نیک و بد رهنمای"
  },
  {
    "poem_id": 1733,
    "vorder": 9,
    "position": 0,
    "text": "پراگنده گنج و سپاه ورا"
  },
  {
    "poem_id": 1733,
    "vorder": 10,
    "position": 1,
    "text": "بیاراست ایوان و گاه ورا"
  },
  {
    "poem_id": 1733,
    "vorder": 11,
    "position": 0,
    "text": "چنین تا برآمد برین پنج سال"
  },
  {
    "poem_id": 1733,
    "vorder": 12,
    "position": 1,
    "text": "برافراخت آن کودک خرد یال"
  },
  {
    "poem_id": 1733,
    "vorder": 13,
    "position": 0,
    "text": "نشسته شبی شاه در طیسفون"
  },
  {
    "poem_id": 1733,
    "vorder": 14,
    "position": 1,
    "text": "خردمند موبد به پیش اندرون"
  },
  {
    "poem_id": 1733,
    "vorder": 15,
    "position": 0,
    "text": "بدانگه که خورشید برگشت زرد"
  },
  {
    "poem_id": 1733,
    "vorder": 16,
    "position": 1,
    "text": "پدید آمد آن چادر لاژورد"
  },
  {
    "poem_id": 1733,
    "vorder": 17,
    "position": 0,
    "text": "خروش آمد از راه اروندرود"
  },
  {
    "poem_id": 1733,
    "vorder": 18,
    "position": 1,
    "text": "به موبد چنین گفت هست این درود"
  },
  {
    "poem_id": 1733,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت موبد بران شاه خرد"
  },
  {
    "poem_id": 1733,
    "vorder": 20,
    "position": 1,
    "text": "که ای پاک‌دل نیک پی شاه گرد"
  },
  {
    "poem_id": 1733,
    "vorder": 21,
    "position": 0,
    "text": "کنون مرد بازاری و چاره جوی"
  },
  {
    "poem_id": 1733,
    "vorder": 22,
    "position": 1,
    "text": "ز کلبه سوی خانه بنهاد روی"
  },
  {
    "poem_id": 1733,
    "vorder": 23,
    "position": 0,
    "text": "چو بر دجله بر یکدگر بگذرند"
  },
  {
    "poem_id": 1733,
    "vorder": 24,
    "position": 1,
    "text": "چنین تنگ پل را به پی بسپرند"
  },
  {
    "poem_id": 1733,
    "vorder": 25,
    "position": 0,
    "text": "بترسد چنین هرکس از بیم کوس"
  },
  {
    "poem_id": 1733,
    "vorder": 26,
    "position": 1,
    "text": "چنین برخروشند چون زخم کوس"
  },
  {
    "poem_id": 1733,
    "vorder": 27,
    "position": 0,
    "text": "چنین گفت شاپور با موبدان"
  },
  {
    "poem_id": 1733,
    "vorder": 28,
    "position": 1,
    "text": "که ای پرهنر نامور بخردان"
  },
  {
    "poem_id": 1733,
    "vorder": 29,
    "position": 0,
    "text": "پلی دیگر اکنون بباید زدن"
  },
  {
    "poem_id": 1733,
    "vorder": 30,
    "position": 1,
    "text": "شدن را یکی راه باز آمدن"
  },
  {
    "poem_id": 1733,
    "vorder": 31,
    "position": 0,
    "text": "بدان تا چنین زیردستان ما"
  },
  {
    "poem_id": 1733,
    "vorder": 32,
    "position": 1,
    "text": "گر از لشکری در پرستان ما"
  },
  {
    "poem_id": 1733,
    "vorder": 33,
    "position": 0,
    "text": "به رفتن نباشند زین سان به رنج"
  },
  {
    "poem_id": 1733,
    "vorder": 34,
    "position": 1,
    "text": "درم داد باید فراوان ز گنج"
  },
  {
    "poem_id": 1733,
    "vorder": 35,
    "position": 0,
    "text": "همه موبدان شاد گشتند سخت"
  },
  {
    "poem_id": 1733,
    "vorder": 36,
    "position": 1,
    "text": "که سبز آمد آن نارسیده درخت"
  },
  {
    "poem_id": 1733,
    "vorder": 37,
    "position": 0,
    "text": "یکی پل بفرمود موبد دگر"
  },
  {
    "poem_id": 1733,
    "vorder": 38,
    "position": 1,
    "text": "به فرمان آن کودک تاجور"
  },
  {
    "poem_id": 1733,
    "vorder": 39,
    "position": 0,
    "text": "ازو شادمان شد دل مادرش"
  },
  {
    "poem_id": 1733,
    "vorder": 40,
    "position": 1,
    "text": "بیاورد فرهنگ جویان برش"
  },
  {
    "poem_id": 1733,
    "vorder": 41,
    "position": 0,
    "text": "به زودی به فرهنگ جایی رسید"
  },
  {
    "poem_id": 1733,
    "vorder": 42,
    "position": 1,
    "text": "کز آموزگاران سراندر کشید"
  },
  {
    "poem_id": 1733,
    "vorder": 43,
    "position": 0,
    "text": "چو بر هفت شد رسم میدان نهاد"
  },
  {
    "poem_id": 1733,
    "vorder": 44,
    "position": 1,
    "text": "هم‌آورد و هم رسم چوگان نهاد"
  },
  {
    "poem_id": 1733,
    "vorder": 45,
    "position": 0,
    "text": "بهشتم شد آیین تخت و کلاه"
  },
  {
    "poem_id": 1733,
    "vorder": 46,
    "position": 1,
    "text": "تو گفتی کمر بست بهرامشاه"
  },
  {
    "poem_id": 1733,
    "vorder": 47,
    "position": 0,
    "text": "تن خویش را از در فخر کرد"
  },
  {
    "poem_id": 1733,
    "vorder": 48,
    "position": 1,
    "text": "نشستنگه خود به اصطخر کرد"
  },
  {
    "poem_id": 1733,
    "vorder": 49,
    "position": 0,
    "text": "بر آیین فرخ نیاکان خویش"
  },
  {
    "poem_id": 1733,
    "vorder": 50,
    "position": 1,
    "text": "گزیده سرافراز و پاکان خویش"
  }
]