[
  {
    "poem_id": 1921,
    "vorder": 1,
    "position": 0,
    "text": "یکی دختری بود پوران بنام"
  },
  {
    "poem_id": 1921,
    "vorder": 2,
    "position": 1,
    "text": "چو زن شاه شد کارها گشت خام"
  },
  {
    "poem_id": 1921,
    "vorder": 3,
    "position": 0,
    "text": "بران تخت شاهیش بنشاندند"
  },
  {
    "poem_id": 1921,
    "vorder": 4,
    "position": 1,
    "text": "بزرگان برو گوهر افشاندند"
  },
  {
    "poem_id": 1921,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت پس دخت پوران که من"
  },
  {
    "poem_id": 1921,
    "vorder": 6,
    "position": 1,
    "text": "نخواهم پراگندن انجمن"
  },
  {
    "poem_id": 1921,
    "vorder": 7,
    "position": 0,
    "text": "کسی راکه درویش باشد ز گنج"
  },
  {
    "poem_id": 1921,
    "vorder": 8,
    "position": 1,
    "text": "توانگر کنم تانماند به رنج"
  },
  {
    "poem_id": 1921,
    "vorder": 9,
    "position": 0,
    "text": "مبادا ز گیتی کسی مستمند"
  },
  {
    "poem_id": 1921,
    "vorder": 10,
    "position": 1,
    "text": "که از درد او بر من آید گزند"
  },
  {
    "poem_id": 1921,
    "vorder": 11,
    "position": 0,
    "text": "ز کشور کنم دور بدخواه را"
  },
  {
    "poem_id": 1921,
    "vorder": 12,
    "position": 1,
    "text": "بر آیین شاهان کنم گاه را"
  },
  {
    "poem_id": 1921,
    "vorder": 13,
    "position": 0,
    "text": "نشانی ز پیروز خسرو بجست"
  },
  {
    "poem_id": 1921,
    "vorder": 14,
    "position": 1,
    "text": "بیاورد ناگاه مردی درست"
  },
  {
    "poem_id": 1921,
    "vorder": 15,
    "position": 0,
    "text": "خبر چون به نزدیک پوران رسید"
  },
  {
    "poem_id": 1921,
    "vorder": 16,
    "position": 1,
    "text": "ز لشکر بسی نامور برگزید"
  },
  {
    "poem_id": 1921,
    "vorder": 17,
    "position": 0,
    "text": "ببردند پیروز راپیش اوی"
  },
  {
    "poem_id": 1921,
    "vorder": 18,
    "position": 1,
    "text": "بدو گفت کای بد تن کینه جوی"
  },
  {
    "poem_id": 1921,
    "vorder": 19,
    "position": 0,
    "text": "ز کاری که کردی بیابی جزا"
  },
  {
    "poem_id": 1921,
    "vorder": 20,
    "position": 1,
    "text": "چنانچون بود در خور ناسزا"
  },
  {
    "poem_id": 1921,
    "vorder": 21,
    "position": 0,
    "text": "مکافات یابی ز کرده کنون"
  },
  {
    "poem_id": 1921,
    "vorder": 22,
    "position": 1,
    "text": "برانم ز گردن تو را جوی خون"
  },
  {
    "poem_id": 1921,
    "vorder": 23,
    "position": 0,
    "text": "ز آخر هم آنگه یکی کره خواست"
  },
  {
    "poem_id": 1921,
    "vorder": 24,
    "position": 1,
    "text": "به زین اندرون نوز نابوده راست"
  },
  {
    "poem_id": 1921,
    "vorder": 25,
    "position": 0,
    "text": "ببستش بران باره بر همچوسنگ"
  },
  {
    "poem_id": 1921,
    "vorder": 26,
    "position": 1,
    "text": "فگنده به گردن درون پالهنگ"
  },
  {
    "poem_id": 1921,
    "vorder": 27,
    "position": 0,
    "text": "چنان کرهٔ تیز نادیده زین"
  },
  {
    "poem_id": 1921,
    "vorder": 28,
    "position": 1,
    "text": "به میدان کشید آن خداوند کین"
  },
  {
    "poem_id": 1921,
    "vorder": 29,
    "position": 0,
    "text": "سواران به میدان فرستاد چند"
  },
  {
    "poem_id": 1921,
    "vorder": 30,
    "position": 1,
    "text": "به فتراک بر گرد کرده کمند"
  },
  {
    "poem_id": 1921,
    "vorder": 31,
    "position": 0,
    "text": "که تا کره او را همی‌تاختی"
  },
  {
    "poem_id": 1921,
    "vorder": 32,
    "position": 1,
    "text": "زمان تا زمانش بینداختی"
  },
  {
    "poem_id": 1921,
    "vorder": 33,
    "position": 0,
    "text": "زدی هر زمان خویشتن بر زمین"
  },
  {
    "poem_id": 1921,
    "vorder": 34,
    "position": 1,
    "text": "بران کره بربود چند آفرین"
  },
  {
    "poem_id": 1921,
    "vorder": 35,
    "position": 0,
    "text": "چنین تا برو بر بدرید چرم"
  },
  {
    "poem_id": 1921,
    "vorder": 36,
    "position": 1,
    "text": "همی‌رفت خون از برش نرم نرم"
  },
  {
    "poem_id": 1921,
    "vorder": 37,
    "position": 0,
    "text": "سرانجام جانش به خواری به داد"
  },
  {
    "poem_id": 1921,
    "vorder": 38,
    "position": 1,
    "text": "چرا جویی از کار بیداد داد"
  },
  {
    "poem_id": 1921,
    "vorder": 39,
    "position": 0,
    "text": "همی‌داشت این زن جهان را به مهر"
  },
  {
    "poem_id": 1921,
    "vorder": 40,
    "position": 1,
    "text": "نجست از بر خاک باد سپهر"
  },
  {
    "poem_id": 1921,
    "vorder": 41,
    "position": 0,
    "text": "چو شش ماه بگذشت بر کار اوی"
  },
  {
    "poem_id": 1921,
    "vorder": 42,
    "position": 1,
    "text": "ببد ناگهان کژ پرگار اوی"
  },
  {
    "poem_id": 1921,
    "vorder": 43,
    "position": 0,
    "text": "به یک هفته بیمار گشت و بمرد"
  },
  {
    "poem_id": 1921,
    "vorder": 44,
    "position": 1,
    "text": "ابا خویشتن نام نیکی ببرد"
  },
  {
    "poem_id": 1921,
    "vorder": 45,
    "position": 0,
    "text": "چنین است آیین چرخ روان"
  },
  {
    "poem_id": 1921,
    "vorder": 46,
    "position": 1,
    "text": "توانا به هر کار و ما ناتوان"
  }
]