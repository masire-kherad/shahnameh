[
  {
    "poem_id": 1890,
    "vorder": 1,
    "position": 0,
    "text": "وزان پس بسوی خراسان کسی"
  },
  {
    "poem_id": 1890,
    "vorder": 2,
    "position": 1,
    "text": "گسی کرد و اندرز دادش بسی"
  },
  {
    "poem_id": 1890,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت با کس مجنبان زبان"
  },
  {
    "poem_id": 1890,
    "vorder": 4,
    "position": 1,
    "text": "از ایدر برو تا در مرزبان"
  },
  {
    "poem_id": 1890,
    "vorder": 5,
    "position": 0,
    "text": "به گستهم گو ایچ گونه مپا"
  },
  {
    "poem_id": 1890,
    "vorder": 6,
    "position": 1,
    "text": "چو این نامه من بخوانی بیا"
  },
  {
    "poem_id": 1890,
    "vorder": 7,
    "position": 0,
    "text": "فرستاده چون در خراسان رسید"
  },
  {
    "poem_id": 1890,
    "vorder": 8,
    "position": 1,
    "text": "به درگاه مرد تن آسان رسید"
  },
  {
    "poem_id": 1890,
    "vorder": 9,
    "position": 0,
    "text": "بگفت آنچ فرمان پرویز بود"
  },
  {
    "poem_id": 1890,
    "vorder": 10,
    "position": 1,
    "text": "که شاه جوان بود و خونریز بود"
  },
  {
    "poem_id": 1890,
    "vorder": 11,
    "position": 0,
    "text": "چو گستهم بشنید لشکر براند"
  },
  {
    "poem_id": 1890,
    "vorder": 12,
    "position": 1,
    "text": "پراگنده لشکر همه باز خواند"
  },
  {
    "poem_id": 1890,
    "vorder": 13,
    "position": 0,
    "text": "چنین تا به شهر بزرگان رسید"
  },
  {
    "poem_id": 1890,
    "vorder": 14,
    "position": 1,
    "text": "ز ساری و آمل به گرگان رسید"
  },
  {
    "poem_id": 1890,
    "vorder": 15,
    "position": 0,
    "text": "شنید آنک شد شاه ایران درشت"
  },
  {
    "poem_id": 1890,
    "vorder": 16,
    "position": 1,
    "text": "برادرش را او به مستی بکشت"
  },
  {
    "poem_id": 1890,
    "vorder": 17,
    "position": 0,
    "text": "چوبشنید دستش به دندان بکند"
  },
  {
    "poem_id": 1890,
    "vorder": 18,
    "position": 1,
    "text": "فرود آمد از پشت اسپ سمند"
  },
  {
    "poem_id": 1890,
    "vorder": 19,
    "position": 0,
    "text": "همه جامهٔ پهلوی کرد چاک"
  },
  {
    "poem_id": 1890,
    "vorder": 20,
    "position": 1,
    "text": "خروشان به سر بر همی‌ریخت خاک"
  },
  {
    "poem_id": 1890,
    "vorder": 21,
    "position": 0,
    "text": "بدانست کو را جهاندار شاه"
  },
  {
    "poem_id": 1890,
    "vorder": 22,
    "position": 1,
    "text": "به کین پدر کرد خواهد تباه"
  },
  {
    "poem_id": 1890,
    "vorder": 23,
    "position": 0,
    "text": "خروشان ازان جایگه بازگشت"
  },
  {
    "poem_id": 1890,
    "vorder": 24,
    "position": 1,
    "text": "تو گفتی که با باد انباز گشت"
  },
  {
    "poem_id": 1890,
    "vorder": 25,
    "position": 0,
    "text": "سپاه پراگنده کرد انجمن"
  },
  {
    "poem_id": 1890,
    "vorder": 26,
    "position": 1,
    "text": "همی‌تاخت تا بیشه نارون"
  },
  {
    "poem_id": 1890,
    "vorder": 27,
    "position": 0,
    "text": "چو نزدیکی کوه آمل رسید"
  },
  {
    "poem_id": 1890,
    "vorder": 28,
    "position": 1,
    "text": "سپه را بدان بیشه اندر کشید"
  },
  {
    "poem_id": 1890,
    "vorder": 29,
    "position": 0,
    "text": "همی‌برد بر هر سوی تاختن"
  },
  {
    "poem_id": 1890,
    "vorder": 30,
    "position": 1,
    "text": "بدان تاختن بود کین آختن"
  },
  {
    "poem_id": 1890,
    "vorder": 31,
    "position": 0,
    "text": "به هر سو که بیکار مردم بدند"
  },
  {
    "poem_id": 1890,
    "vorder": 32,
    "position": 1,
    "text": "به نانی همی بندهٔ او شدند"
  },
  {
    "poem_id": 1890,
    "vorder": 33,
    "position": 0,
    "text": "به جایی کجا لشکر شاه بود"
  },
  {
    "poem_id": 1890,
    "vorder": 34,
    "position": 1,
    "text": "که گستهم زان لشکر آگاه بود"
  },
  {
    "poem_id": 1890,
    "vorder": 35,
    "position": 0,
    "text": "همی بر سرانشان فرود آمدی"
  },
  {
    "poem_id": 1890,
    "vorder": 36,
    "position": 1,
    "text": "سپه رایکایک بهم برزدی"
  },
  {
    "poem_id": 1890,
    "vorder": 37,
    "position": 0,
    "text": "وزان پس چو گردوی شد نزد شاه"
  },
  {
    "poem_id": 1890,
    "vorder": 38,
    "position": 1,
    "text": "بگفت آن کجا خواهرش با سپاه"
  },
  {
    "poem_id": 1890,
    "vorder": 39,
    "position": 0,
    "text": "بدان مرزبانان خاقان چه کرد"
  },
  {
    "poem_id": 1890,
    "vorder": 40,
    "position": 1,
    "text": "که در مرو زیشان برآورد گرد"
  },
  {
    "poem_id": 1890,
    "vorder": 41,
    "position": 0,
    "text": "وزان روی گستهم بشنید نیز"
  },
  {
    "poem_id": 1890,
    "vorder": 42,
    "position": 1,
    "text": "که بهرام یل را پر آمد قفیز"
  },
  {
    "poem_id": 1890,
    "vorder": 43,
    "position": 0,
    "text": "همان گردیه با سپاه بزرگ"
  },
  {
    "poem_id": 1890,
    "vorder": 44,
    "position": 1,
    "text": "برفت از بر نامدار سترگ"
  },
  {
    "poem_id": 1890,
    "vorder": 45,
    "position": 0,
    "text": "پس او سپاهی بیامد بکین"
  },
  {
    "poem_id": 1890,
    "vorder": 46,
    "position": 1,
    "text": "چه کرد او بدان نامداران چین"
  },
  {
    "poem_id": 1890,
    "vorder": 47,
    "position": 0,
    "text": "پذیره شدن را سپه برنشاند"
  },
  {
    "poem_id": 1890,
    "vorder": 48,
    "position": 1,
    "text": "ازان جایگه نیز لشکر براند"
  },
  {
    "poem_id": 1890,
    "vorder": 49,
    "position": 0,
    "text": "چو آگاه شد گردیه رفت پیش"
  },
  {
    "poem_id": 1890,
    "vorder": 50,
    "position": 1,
    "text": "از آموی با نامدران خویش"
  },
  {
    "poem_id": 1890,
    "vorder": 51,
    "position": 0,
    "text": "چو گستهم دید آن سپه را ز راه"
  },
  {
    "poem_id": 1890,
    "vorder": 52,
    "position": 1,
    "text": "بر انگیخت اسپ از میان سپاه"
  },
  {
    "poem_id": 1890,
    "vorder": 53,
    "position": 0,
    "text": "بیامد بر گردیه پر ز درد"
  },
  {
    "poem_id": 1890,
    "vorder": 54,
    "position": 1,
    "text": "فراوان ز بهرام تیمار خورد"
  },
  {
    "poem_id": 1890,
    "vorder": 55,
    "position": 0,
    "text": "همان درد بندوی او رابگفت"
  },
  {
    "poem_id": 1890,
    "vorder": 56,
    "position": 1,
    "text": "همی به آستین خون مژگان برفت"
  },
  {
    "poem_id": 1890,
    "vorder": 57,
    "position": 0,
    "text": "یلان سینه را دید و ایزد گشسپ"
  },
  {
    "poem_id": 1890,
    "vorder": 58,
    "position": 1,
    "text": "فرود آمد از دور گریان زاسپ"
  },
  {
    "poem_id": 1890,
    "vorder": 59,
    "position": 0,
    "text": "بگفت آنک بندوی را شهریار"
  },
  {
    "poem_id": 1890,
    "vorder": 60,
    "position": 1,
    "text": "تبه کرد و بد شد مرا روزگار"
  },
  {
    "poem_id": 1890,
    "vorder": 61,
    "position": 0,
    "text": "تو گفتی نه از خواهرش زاده بود"
  },
  {
    "poem_id": 1890,
    "vorder": 62,
    "position": 1,
    "text": "نه از بهر او تن به خون داده بود"
  },
  {
    "poem_id": 1890,
    "vorder": 63,
    "position": 0,
    "text": "به تارک مر او را روا داشتی"
  },
  {
    "poem_id": 1890,
    "vorder": 64,
    "position": 1,
    "text": "روان پیش خاکش فدا داشتی"
  },
  {
    "poem_id": 1890,
    "vorder": 65,
    "position": 0,
    "text": "نخستین ز تن دست و پایش برید"
  },
  {
    "poem_id": 1890,
    "vorder": 66,
    "position": 1,
    "text": "بران سان که از گوهر او سزید"
  },
  {
    "poem_id": 1890,
    "vorder": 67,
    "position": 0,
    "text": "شما را بدو چیست اکنون امید"
  },
  {
    "poem_id": 1890,
    "vorder": 68,
    "position": 1,
    "text": "کجا همچو هنگام با دست و بید"
  },
  {
    "poem_id": 1890,
    "vorder": 69,
    "position": 0,
    "text": "ابا همگنانتان بتر زان کند"
  },
  {
    "poem_id": 1890,
    "vorder": 70,
    "position": 1,
    "text": "به شهر اندرون گوشت ارزان کند"
  },
  {
    "poem_id": 1890,
    "vorder": 71,
    "position": 0,
    "text": "چو از دور بیند یلان سینه را"
  },
  {
    "poem_id": 1890,
    "vorder": 72,
    "position": 1,
    "text": "بر آشوبد و نو کند کینه را"
  },
  {
    "poem_id": 1890,
    "vorder": 73,
    "position": 0,
    "text": "که سالار بودی تو بهرام را"
  },
  {
    "poem_id": 1890,
    "vorder": 74,
    "position": 1,
    "text": "ازو یافتی در جهان کام را"
  },
  {
    "poem_id": 1890,
    "vorder": 75,
    "position": 0,
    "text": "ازو هرکه داندش پرهیز به"
  },
  {
    "poem_id": 1890,
    "vorder": 76,
    "position": 1,
    "text": "گلوی و را خنجر تیز به"
  },
  {
    "poem_id": 1890,
    "vorder": 77,
    "position": 0,
    "text": "گر ای دون که باشید با من بهم"
  },
  {
    "poem_id": 1890,
    "vorder": 78,
    "position": 1,
    "text": "ز نیم اندرین رای بر بیش و کم"
  },
  {
    "poem_id": 1890,
    "vorder": 79,
    "position": 0,
    "text": "پذیرفت ازو هر که بشنید پند"
  },
  {
    "poem_id": 1890,
    "vorder": 80,
    "position": 1,
    "text": "همی‌جست هر کس ز راه گزند"
  },
  {
    "poem_id": 1890,
    "vorder": 81,
    "position": 0,
    "text": "زبان تیز با گردیه بر گشاد"
  },
  {
    "poem_id": 1890,
    "vorder": 82,
    "position": 1,
    "text": "همی‌کرد کردار بهرام یاد"
  },
  {
    "poem_id": 1890,
    "vorder": 83,
    "position": 0,
    "text": "ز گفتار او گردیه گشت سست"
  },
  {
    "poem_id": 1890,
    "vorder": 84,
    "position": 1,
    "text": "شداندیشه‌ها بر دلش بر درست"
  },
  {
    "poem_id": 1890,
    "vorder": 85,
    "position": 0,
    "text": "ببودند یکسر به نزدیک اوی"
  },
  {
    "poem_id": 1890,
    "vorder": 86,
    "position": 1,
    "text": "درخشان شد آن رای تاریک اوی"
  },
  {
    "poem_id": 1890,
    "vorder": 87,
    "position": 0,
    "text": "یلان سینه راگفت کاین زن بشوی"
  },
  {
    "poem_id": 1890,
    "vorder": 88,
    "position": 1,
    "text": "چه گوید بجوید بدین آب روی"
  },
  {
    "poem_id": 1890,
    "vorder": 89,
    "position": 0,
    "text": "چنین داد پاسخ که تا گویمش"
  },
  {
    "poem_id": 1890,
    "vorder": 90,
    "position": 1,
    "text": "به گفتار بسیار دل جویمش"
  },
  {
    "poem_id": 1890,
    "vorder": 91,
    "position": 0,
    "text": "یلان سینه با گردیه گفت زن"
  },
  {
    "poem_id": 1890,
    "vorder": 92,
    "position": 1,
    "text": "به گیتی تو را دیده‌ام رای زن"
  },
  {
    "poem_id": 1890,
    "vorder": 93,
    "position": 0,
    "text": "ز خاقان کرانه گزیدی سزید"
  },
  {
    "poem_id": 1890,
    "vorder": 94,
    "position": 1,
    "text": "که رای تو آزادگان را گزید"
  },
  {
    "poem_id": 1890,
    "vorder": 95,
    "position": 0,
    "text": "چه گویی ز گستهم یل خال شاه"
  },
  {
    "poem_id": 1890,
    "vorder": 96,
    "position": 1,
    "text": "توانگر سپهبد یلی با سپاه"
  },
  {
    "poem_id": 1890,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت شویی کز ایران بود"
  },
  {
    "poem_id": 1890,
    "vorder": 98,
    "position": 1,
    "text": "ازو تخمهٔ ما نه ویران بود"
  },
  {
    "poem_id": 1890,
    "vorder": 99,
    "position": 0,
    "text": "یلان سینه او را بگستهم داد"
  },
  {
    "poem_id": 1890,
    "vorder": 100,
    "position": 1,
    "text": "دلاور گوی بود فرخ نژاد"
  },
  {
    "poem_id": 1890,
    "vorder": 101,
    "position": 0,
    "text": "همی‌داشتش چون یکی تازه سیب"
  },
  {
    "poem_id": 1890,
    "vorder": 102,
    "position": 1,
    "text": "که اندر بلندی ندیدی نشیب"
  },
  {
    "poem_id": 1890,
    "vorder": 103,
    "position": 0,
    "text": "سپاهی که از نزد خسرو شدی"
  },
  {
    "poem_id": 1890,
    "vorder": 104,
    "position": 1,
    "text": "برو روزگار کهن نو شدی"
  },
  {
    "poem_id": 1890,
    "vorder": 105,
    "position": 0,
    "text": "هر آنگه که دیدی شکست سپاه"
  },
  {
    "poem_id": 1890,
    "vorder": 106,
    "position": 1,
    "text": "کمان را بر افراشتی تا به ماه"
  }
]