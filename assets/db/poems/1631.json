[
  {
    "poem_id": 1631,
    "vorder": 1,
    "position": 0,
    "text": "بمرد اندران چند گه فیلقوس"
  },
  {
    "poem_id": 1631,
    "vorder": 2,
    "position": 1,
    "text": "به روم اندرون بود یک‌چند بوس"
  },
  {
    "poem_id": 1631,
    "vorder": 3,
    "position": 0,
    "text": "سکندر به تخت نیا برنشست"
  },
  {
    "poem_id": 1631,
    "vorder": 4,
    "position": 1,
    "text": "بهی جست و دست بدی را ببست"
  },
  {
    "poem_id": 1631,
    "vorder": 5,
    "position": 0,
    "text": "یکی نامداری بد آنگه به روم"
  },
  {
    "poem_id": 1631,
    "vorder": 6,
    "position": 1,
    "text": "کزو شاد بد آن همه مرز و بوم"
  },
  {
    "poem_id": 1631,
    "vorder": 7,
    "position": 0,
    "text": "حکیمی که بد ارسطالیس نام"
  },
  {
    "poem_id": 1631,
    "vorder": 8,
    "position": 1,
    "text": "خردمند و بیدار و گسترده کام"
  },
  {
    "poem_id": 1631,
    "vorder": 9,
    "position": 0,
    "text": "به پیش سکندر شد آن پاک‌رای"
  },
  {
    "poem_id": 1631,
    "vorder": 10,
    "position": 1,
    "text": "زبان کرد گویا و بگرفت جای"
  },
  {
    "poem_id": 1631,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت کای مهتر شادکام"
  },
  {
    "poem_id": 1631,
    "vorder": 12,
    "position": 1,
    "text": "همی گم کنی اندرین کار نام"
  },
  {
    "poem_id": 1631,
    "vorder": 13,
    "position": 0,
    "text": "که تخت کیان چون تو بسیار دید"
  },
  {
    "poem_id": 1631,
    "vorder": 14,
    "position": 1,
    "text": "نخواهد همی با کسی آرمید"
  },
  {
    "poem_id": 1631,
    "vorder": 15,
    "position": 0,
    "text": "هرانگه که گویی رسیدم به جای"
  },
  {
    "poem_id": 1631,
    "vorder": 16,
    "position": 1,
    "text": "نباید به گیتی مرا رهنمای"
  },
  {
    "poem_id": 1631,
    "vorder": 17,
    "position": 0,
    "text": "چنان دان که نادان‌ترین کس توی"
  },
  {
    "poem_id": 1631,
    "vorder": 18,
    "position": 1,
    "text": "اگر پند دانندگان نشنوی"
  },
  {
    "poem_id": 1631,
    "vorder": 19,
    "position": 0,
    "text": "ز خاکیم و هم خاک را زاده‌ایم"
  },
  {
    "poem_id": 1631,
    "vorder": 20,
    "position": 1,
    "text": "به بیچارگی دل بدو داده‌ایم"
  },
  {
    "poem_id": 1631,
    "vorder": 21,
    "position": 0,
    "text": "اگر نیک باشی بماندت نام"
  },
  {
    "poem_id": 1631,
    "vorder": 22,
    "position": 1,
    "text": "به تخت کیی‌بر بوی شادکام"
  },
  {
    "poem_id": 1631,
    "vorder": 23,
    "position": 0,
    "text": "وگر بد کنی جز بدی ندروی"
  },
  {
    "poem_id": 1631,
    "vorder": 24,
    "position": 1,
    "text": "شبی در جهان شادمان نغنوی"
  },
  {
    "poem_id": 1631,
    "vorder": 25,
    "position": 0,
    "text": "به نیکی بود شاه را دست‌رس"
  },
  {
    "poem_id": 1631,
    "vorder": 26,
    "position": 1,
    "text": "به بد روز گیتی نجستست کس"
  },
  {
    "poem_id": 1631,
    "vorder": 27,
    "position": 0,
    "text": "سکندر شنید این پسند آمدش"
  },
  {
    "poem_id": 1631,
    "vorder": 28,
    "position": 1,
    "text": "سخن‌گوی را فرمند آمدش"
  },
  {
    "poem_id": 1631,
    "vorder": 29,
    "position": 0,
    "text": "به فرمان او کرد کاری که کرد"
  },
  {
    "poem_id": 1631,
    "vorder": 30,
    "position": 1,
    "text": "ز بزم و ز رزم و ز ننگ و نبرد"
  },
  {
    "poem_id": 1631,
    "vorder": 31,
    "position": 0,
    "text": "به نو هر زمانیش بنواختی"
  },
  {
    "poem_id": 1631,
    "vorder": 32,
    "position": 1,
    "text": "چو رفتی بر تخت بنشاختی"
  },
  {
    "poem_id": 1631,
    "vorder": 33,
    "position": 0,
    "text": "چنان بد که روزی فرستاده‌ای"
  },
  {
    "poem_id": 1631,
    "vorder": 34,
    "position": 1,
    "text": "سخن‌گو و روشن‌دل آزاده‌ای"
  },
  {
    "poem_id": 1631,
    "vorder": 35,
    "position": 0,
    "text": "ز نزدیک دارا بیامد به روم"
  },
  {
    "poem_id": 1631,
    "vorder": 36,
    "position": 1,
    "text": "کجا باژ خواهد ز آباد بوم"
  },
  {
    "poem_id": 1631,
    "vorder": 37,
    "position": 0,
    "text": "به پیش سکندر بگفت آن سخن"
  },
  {
    "poem_id": 1631,
    "vorder": 38,
    "position": 1,
    "text": "غمی شد سکندر ز باژ کهن"
  },
  {
    "poem_id": 1631,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت رو پیش دارا بگوی"
  },
  {
    "poem_id": 1631,
    "vorder": 40,
    "position": 1,
    "text": "که از باژ ما شد کنون رنگ و بوی"
  },
  {
    "poem_id": 1631,
    "vorder": 41,
    "position": 0,
    "text": "که مرغی که زرین همی خایه کرد"
  },
  {
    "poem_id": 1631,
    "vorder": 42,
    "position": 1,
    "text": "به مرد و سر باژ بی‌مایه کرد"
  },
  {
    "poem_id": 1631,
    "vorder": 43,
    "position": 0,
    "text": "فرستاد پاسخ بدان سان شنید"
  },
  {
    "poem_id": 1631,
    "vorder": 44,
    "position": 1,
    "text": "بترسید وز روم شد ناپدید"
  },
  {
    "poem_id": 1631,
    "vorder": 45,
    "position": 0,
    "text": "سکندر سپه را سراسر بخواند"
  },
  {
    "poem_id": 1631,
    "vorder": 46,
    "position": 1,
    "text": "گذشته سخن پیش ایشان براند"
  },
  {
    "poem_id": 1631,
    "vorder": 47,
    "position": 0,
    "text": "چنین گفت کز گردش آسمان"
  },
  {
    "poem_id": 1631,
    "vorder": 48,
    "position": 1,
    "text": "نیابد گذر مرد نیکی‌گمان"
  },
  {
    "poem_id": 1631,
    "vorder": 49,
    "position": 0,
    "text": "مرا روی گیتی بباید سپرد"
  },
  {
    "poem_id": 1631,
    "vorder": 50,
    "position": 1,
    "text": "بد و نیک چندی بباید شمرد"
  },
  {
    "poem_id": 1631,
    "vorder": 51,
    "position": 0,
    "text": "شما را بباید کنون ساختن"
  },
  {
    "poem_id": 1631,
    "vorder": 52,
    "position": 1,
    "text": "دل از بوم و آرام پرداختن"
  },
  {
    "poem_id": 1631,
    "vorder": 53,
    "position": 0,
    "text": "سر گنجهای نیا باز کرد"
  },
  {
    "poem_id": 1631,
    "vorder": 54,
    "position": 1,
    "text": "بفرمود تا لشکرش ساز کرد"
  },
  {
    "poem_id": 1631,
    "vorder": 55,
    "position": 0,
    "text": "به شبگیر برخاست از روم غو"
  },
  {
    "poem_id": 1631,
    "vorder": 56,
    "position": 1,
    "text": "ز شهر و ز درگاه سالار نو"
  },
  {
    "poem_id": 1631,
    "vorder": 57,
    "position": 0,
    "text": "برون آمد آن نامور شهریار"
  },
  {
    "poem_id": 1631,
    "vorder": 58,
    "position": 1,
    "text": "بره‌بر چنان لشکر نامدار"
  },
  {
    "poem_id": 1631,
    "vorder": 59,
    "position": 0,
    "text": "درفشی پس پشت سالار روم"
  },
  {
    "poem_id": 1631,
    "vorder": 60,
    "position": 1,
    "text": "نوشته برو سرخ و پیروزه بوم"
  },
  {
    "poem_id": 1631,
    "vorder": 61,
    "position": 0,
    "text": "همای از برو خیزرانش قضیب"
  },
  {
    "poem_id": 1631,
    "vorder": 62,
    "position": 1,
    "text": "نوشته بر او بر محب صلیب"
  },
  {
    "poem_id": 1631,
    "vorder": 63,
    "position": 0,
    "text": "به مصر آمد از روم چندان سپاه"
  },
  {
    "poem_id": 1631,
    "vorder": 64,
    "position": 1,
    "text": "که بستند بر مور و بر پشه راه"
  },
  {
    "poem_id": 1631,
    "vorder": 65,
    "position": 0,
    "text": "دو لشکر به روی اندر آورده روی"
  },
  {
    "poem_id": 1631,
    "vorder": 66,
    "position": 1,
    "text": "ببودند یک هفته پرخاشجوی"
  },
  {
    "poem_id": 1631,
    "vorder": 67,
    "position": 0,
    "text": "به هشتم به مصر اندر آمد شکست"
  },
  {
    "poem_id": 1631,
    "vorder": 68,
    "position": 1,
    "text": "سکندر سر راه ایشان ببست"
  },
  {
    "poem_id": 1631,
    "vorder": 69,
    "position": 0,
    "text": "ز یک راه چندان گرفتار شد"
  },
  {
    "poem_id": 1631,
    "vorder": 70,
    "position": 1,
    "text": "که گیرنده را دست بیکار شد"
  },
  {
    "poem_id": 1631,
    "vorder": 71,
    "position": 0,
    "text": "ز گوپال و از اسپ و برگستوان"
  },
  {
    "poem_id": 1631,
    "vorder": 72,
    "position": 1,
    "text": "ز خفتان وز خنجر هندوان"
  },
  {
    "poem_id": 1631,
    "vorder": 73,
    "position": 0,
    "text": "کمرهای زرین و زرین ستام"
  },
  {
    "poem_id": 1631,
    "vorder": 74,
    "position": 1,
    "text": "همان تیغ هندی به زرین نیام"
  },
  {
    "poem_id": 1631,
    "vorder": 75,
    "position": 0,
    "text": "ز دیبا و دینار چندان بیافت"
  },
  {
    "poem_id": 1631,
    "vorder": 76,
    "position": 1,
    "text": "که از خواسته بارگی برنتافت"
  },
  {
    "poem_id": 1631,
    "vorder": 77,
    "position": 0,
    "text": "بسی زینهاری بیامد سوار"
  },
  {
    "poem_id": 1631,
    "vorder": 78,
    "position": 1,
    "text": "بزرگان جنگاور و نامدار"
  },
  {
    "poem_id": 1631,
    "vorder": 79,
    "position": 0,
    "text": "وزان جایگه ساز ایران گرفت"
  },
  {
    "poem_id": 1631,
    "vorder": 80,
    "position": 1,
    "text": "دل شیر و چنگ دلیران گرفت"
  },
  {
    "poem_id": 1631,
    "vorder": 81,
    "position": 0,
    "text": "چو بشنید دارا که لشکر ز روم"
  },
  {
    "poem_id": 1631,
    "vorder": 82,
    "position": 1,
    "text": "بجنبید و آمد برین مرز و بوم"
  },
  {
    "poem_id": 1631,
    "vorder": 83,
    "position": 0,
    "text": "برفتند ز اصطخر چندان سپاه"
  },
  {
    "poem_id": 1631,
    "vorder": 84,
    "position": 1,
    "text": "که از نیزه بر باد بستند راه"
  },
  {
    "poem_id": 1631,
    "vorder": 85,
    "position": 0,
    "text": "همی داشت از پارس آهنگ روم"
  },
  {
    "poem_id": 1631,
    "vorder": 86,
    "position": 1,
    "text": "کز ایران گذارد به آباد بوم"
  },
  {
    "poem_id": 1631,
    "vorder": 87,
    "position": 0,
    "text": "چو آورد لشکر به پیش فرات"
  },
  {
    "poem_id": 1631,
    "vorder": 88,
    "position": 1,
    "text": "سپه را عدد بود بیش از نبات"
  },
  {
    "poem_id": 1631,
    "vorder": 89,
    "position": 0,
    "text": "به گرد لب آب لشکر کشید"
  },
  {
    "poem_id": 1631,
    "vorder": 90,
    "position": 1,
    "text": "ز جوشن کسی آب دریا ندید"
  }
]