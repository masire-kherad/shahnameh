[
  {
    "poem_id": 1770,
    "vorder": 1,
    "position": 0,
    "text": "چو بر تخت بنشست بهرام گور"
  },
  {
    "poem_id": 1770,
    "vorder": 2,
    "position": 1,
    "text": "برو آفرین کرد بهرام و هور"
  },
  {
    "poem_id": 1770,
    "vorder": 3,
    "position": 0,
    "text": "پرستش گرفت آفریننده را"
  },
  {
    "poem_id": 1770,
    "vorder": 4,
    "position": 1,
    "text": "جهاندار و بیدار و بیننده را"
  },
  {
    "poem_id": 1770,
    "vorder": 5,
    "position": 0,
    "text": "خداوند پیروزی و برتری"
  },
  {
    "poem_id": 1770,
    "vorder": 6,
    "position": 1,
    "text": "خداوند افزونی و کمتری"
  },
  {
    "poem_id": 1770,
    "vorder": 7,
    "position": 0,
    "text": "خداوند داد و خداوند رای"
  },
  {
    "poem_id": 1770,
    "vorder": 8,
    "position": 1,
    "text": "کزویست گیتی سراسر به پای"
  },
  {
    "poem_id": 1770,
    "vorder": 9,
    "position": 0,
    "text": "ازان پس چنین گفت کاین تاج و تخت"
  },
  {
    "poem_id": 1770,
    "vorder": 10,
    "position": 1,
    "text": "ازو یافتم که‌آفریده‌ست بخت"
  },
  {
    "poem_id": 1770,
    "vorder": 11,
    "position": 0,
    "text": "بدو هستم امید و هم زو هراس"
  },
  {
    "poem_id": 1770,
    "vorder": 12,
    "position": 1,
    "text": "وزو دارم از نیکوی‌ها سپاس"
  },
  {
    "poem_id": 1770,
    "vorder": 13,
    "position": 0,
    "text": "شما هم بدو نیز نازش کنید"
  },
  {
    "poem_id": 1770,
    "vorder": 14,
    "position": 1,
    "text": "بکوشید تا عهد او نشکنید"
  },
  {
    "poem_id": 1770,
    "vorder": 15,
    "position": 0,
    "text": "زبان برگشادند ایرانیان"
  },
  {
    "poem_id": 1770,
    "vorder": 16,
    "position": 1,
    "text": "که بستیم ما بندگی را میان"
  },
  {
    "poem_id": 1770,
    "vorder": 17,
    "position": 0,
    "text": "که این تاج بر شاه فرخنده باد"
  },
  {
    "poem_id": 1770,
    "vorder": 18,
    "position": 1,
    "text": "همیشه دل و بخت او زنده باد"
  },
  {
    "poem_id": 1770,
    "vorder": 19,
    "position": 0,
    "text": "وزان پس همه آفرین خواندند"
  },
  {
    "poem_id": 1770,
    "vorder": 20,
    "position": 1,
    "text": "همه بر سرش گوهر افشاندند"
  },
  {
    "poem_id": 1770,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت بهرام کای سرکشان"
  },
  {
    "poem_id": 1770,
    "vorder": 22,
    "position": 1,
    "text": "ز نیک و بد روز دیده نشان"
  },
  {
    "poem_id": 1770,
    "vorder": 23,
    "position": 0,
    "text": "همه بندگانیم و ایزد یکی‌ست"
  },
  {
    "poem_id": 1770,
    "vorder": 24,
    "position": 1,
    "text": "پرستش جز او را سزاوار نیست"
  },
  {
    "poem_id": 1770,
    "vorder": 25,
    "position": 0,
    "text": "ز بدْروز بی‌بیم داریمتان"
  },
  {
    "poem_id": 1770,
    "vorder": 26,
    "position": 1,
    "text": "به بدخواه حاجت نیاریمتان"
  },
  {
    "poem_id": 1770,
    "vorder": 27,
    "position": 0,
    "text": "بگفت این و از پیش برخاستند"
  },
  {
    "poem_id": 1770,
    "vorder": 28,
    "position": 1,
    "text": "برو آفرین نو آراستند"
  },
  {
    "poem_id": 1770,
    "vorder": 29,
    "position": 0,
    "text": "شب تیره بودند با گفت‌وگوی"
  },
  {
    "poem_id": 1770,
    "vorder": 30,
    "position": 1,
    "text": "چو خورشید بر چرخ بنمود روی"
  },
  {
    "poem_id": 1770,
    "vorder": 31,
    "position": 0,
    "text": "به آرام بنشست بر گاه شاه"
  },
  {
    "poem_id": 1770,
    "vorder": 32,
    "position": 1,
    "text": "برفتند ایرانیان بارخواه"
  },
  {
    "poem_id": 1770,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت بهرام با مهتران"
  },
  {
    "poem_id": 1770,
    "vorder": 34,
    "position": 1,
    "text": "که این نیکنامان و نیک‌اختران"
  },
  {
    "poem_id": 1770,
    "vorder": 35,
    "position": 0,
    "text": "به یزدان گراییم و رامش کنیم"
  },
  {
    "poem_id": 1770,
    "vorder": 36,
    "position": 1,
    "text": "بتازیم و دل زین جهان برکنیم"
  },
  {
    "poem_id": 1770,
    "vorder": 37,
    "position": 0,
    "text": "بگفت این و اسپ کیان خواستند"
  },
  {
    "poem_id": 1770,
    "vorder": 38,
    "position": 1,
    "text": "کیی بارگاهش بیاراستند"
  },
  {
    "poem_id": 1770,
    "vorder": 39,
    "position": 0,
    "text": "سه دیگر چو بنشست بر تخت گفت"
  },
  {
    "poem_id": 1770,
    "vorder": 40,
    "position": 1,
    "text": "که رسم پرستش نباید نهفت"
  },
  {
    "poem_id": 1770,
    "vorder": 41,
    "position": 0,
    "text": "به هستی یزدان گوایی دهیم"
  },
  {
    "poem_id": 1770,
    "vorder": 42,
    "position": 1,
    "text": "روان را بدین آشنایی دهیم"
  },
  {
    "poem_id": 1770,
    "vorder": 43,
    "position": 0,
    "text": "بهشت‌ست و هم دوزخ و رستخیز"
  },
  {
    "poem_id": 1770,
    "vorder": 44,
    "position": 1,
    "text": "ز نیک و ز بد نیست راه گریز"
  },
  {
    "poem_id": 1770,
    "vorder": 45,
    "position": 0,
    "text": "کسی کاو نگرود به روز شمار"
  },
  {
    "poem_id": 1770,
    "vorder": 46,
    "position": 1,
    "text": "مر او را تو با‌دین و دانا مدار"
  },
  {
    "poem_id": 1770,
    "vorder": 47,
    "position": 0,
    "text": "به روز چهارم چو بر تخت عاج"
  },
  {
    "poem_id": 1770,
    "vorder": 48,
    "position": 1,
    "text": "بسر بر نهاد آن پسندیده تاج"
  },
  {
    "poem_id": 1770,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت کز گنج من یک زمان"
  },
  {
    "poem_id": 1770,
    "vorder": 50,
    "position": 1,
    "text": "نیم شاد کز مردم شادمان"
  },
  {
    "poem_id": 1770,
    "vorder": 51,
    "position": 0,
    "text": "نیم خواستار سرای سپنج"
  },
  {
    "poem_id": 1770,
    "vorder": 52,
    "position": 1,
    "text": "نه از بازگشتن به تیمار و رنج"
  },
  {
    "poem_id": 1770,
    "vorder": 53,
    "position": 0,
    "text": "که آنست جاوید و این ره‌گذار"
  },
  {
    "poem_id": 1770,
    "vorder": 54,
    "position": 1,
    "text": "تو از آز پرهیز و انده مدار"
  },
  {
    "poem_id": 1770,
    "vorder": 55,
    "position": 0,
    "text": "به پنجم چنین گفت کز رنج کس"
  },
  {
    "poem_id": 1770,
    "vorder": 56,
    "position": 1,
    "text": "نیم شاد تا باشدم دست‌رس"
  },
  {
    "poem_id": 1770,
    "vorder": 57,
    "position": 0,
    "text": "به کوشش بجوییم خرم بهشت"
  },
  {
    "poem_id": 1770,
    "vorder": 58,
    "position": 1,
    "text": "خنک آنک جز تخم نیکی نکشت"
  },
  {
    "poem_id": 1770,
    "vorder": 59,
    "position": 0,
    "text": "ششم گفت بر مردم زیردست"
  },
  {
    "poem_id": 1770,
    "vorder": 60,
    "position": 1,
    "text": "مبادا که هرگز بجویم شکست"
  },
  {
    "poem_id": 1770,
    "vorder": 61,
    "position": 0,
    "text": "جهان را ز دشمن تن‌آسان کنیم"
  },
  {
    "poem_id": 1770,
    "vorder": 62,
    "position": 1,
    "text": "بداندیشگان را هراسان کنیم"
  },
  {
    "poem_id": 1770,
    "vorder": 63,
    "position": 0,
    "text": "به هفتم چو بنشست گفت ای مهان"
  },
  {
    "poem_id": 1770,
    "vorder": 64,
    "position": 1,
    "text": "خردمند و بیدار و دیده جهان"
  },
  {
    "poem_id": 1770,
    "vorder": 65,
    "position": 0,
    "text": "چو با مردم زفت زفتی کنیم"
  },
  {
    "poem_id": 1770,
    "vorder": 66,
    "position": 1,
    "text": "همی با خردمند جفتی کنیم"
  },
  {
    "poem_id": 1770,
    "vorder": 67,
    "position": 0,
    "text": "هرانکس که با ما نسازند گرم"
  },
  {
    "poem_id": 1770,
    "vorder": 68,
    "position": 1,
    "text": "بدی بیش ازان بیند او کز پدرم"
  },
  {
    "poem_id": 1770,
    "vorder": 69,
    "position": 0,
    "text": "هرانکس که فرمان ما برگزید"
  },
  {
    "poem_id": 1770,
    "vorder": 70,
    "position": 1,
    "text": "غم و درد و رنجش نباید کشید"
  },
  {
    "poem_id": 1770,
    "vorder": 71,
    "position": 0,
    "text": "به هشتم چو بنشست فرمود شاه"
  },
  {
    "poem_id": 1770,
    "vorder": 72,
    "position": 1,
    "text": "جوانوی را خواندن از بارگاه"
  },
  {
    "poem_id": 1770,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت نزدیک هر مهتری"
  },
  {
    "poem_id": 1770,
    "vorder": 74,
    "position": 1,
    "text": "به هر نامداری و هر کشوری"
  },
  {
    "poem_id": 1770,
    "vorder": 75,
    "position": 0,
    "text": "یکی نامه بنویس با مهر و داد"
  },
  {
    "poem_id": 1770,
    "vorder": 76,
    "position": 1,
    "text": "که بهرام بنشست بر تخت شاد"
  },
  {
    "poem_id": 1770,
    "vorder": 77,
    "position": 0,
    "text": "خداوند بخشایش و راستی"
  },
  {
    "poem_id": 1770,
    "vorder": 78,
    "position": 1,
    "text": "گریزنده از کژی و کاستی"
  },
  {
    "poem_id": 1770,
    "vorder": 79,
    "position": 0,
    "text": "که با فر و برز‌ست و با مهر و داد"
  },
  {
    "poem_id": 1770,
    "vorder": 80,
    "position": 1,
    "text": "نگیرد جز از پاک دادار یاد"
  },
  {
    "poem_id": 1770,
    "vorder": 81,
    "position": 0,
    "text": "پذیرفتم آن را که فرمان برد"
  },
  {
    "poem_id": 1770,
    "vorder": 82,
    "position": 1,
    "text": "گناه آن سگالد که درمان برد؟"
  },
  {
    "poem_id": 1770,
    "vorder": 83,
    "position": 0,
    "text": "نشستم برین تخت فرخ پدر"
  },
  {
    "poem_id": 1770,
    "vorder": 84,
    "position": 1,
    "text": "بر آیین طهمورث دادگر"
  },
  {
    "poem_id": 1770,
    "vorder": 85,
    "position": 0,
    "text": "به داد از نیاکان فزونی کنم"
  },
  {
    "poem_id": 1770,
    "vorder": 86,
    "position": 1,
    "text": "شما را به دین رهنمونی کنم"
  },
  {
    "poem_id": 1770,
    "vorder": 87,
    "position": 0,
    "text": "جز از راستی نیست با هرکسی"
  },
  {
    "poem_id": 1770,
    "vorder": 88,
    "position": 1,
    "text": "اگر چند ازو کژی آید بسی"
  },
  {
    "poem_id": 1770,
    "vorder": 89,
    "position": 0,
    "text": "بران دین زردشت پیغمبرم"
  },
  {
    "poem_id": 1770,
    "vorder": 90,
    "position": 1,
    "text": "ز راه نیاکان خود نگذرم"
  },
  {
    "poem_id": 1770,
    "vorder": 91,
    "position": 0,
    "text": "نهم گفت زردشت پیشین بروی"
  },
  {
    "poem_id": 1770,
    "vorder": 92,
    "position": 1,
    "text": "براهیم پیغمبر راست‌گوی"
  },
  {
    "poem_id": 1770,
    "vorder": 93,
    "position": 0,
    "text": "همه پادشاهید بر چیز خویش"
  },
  {
    "poem_id": 1770,
    "vorder": 94,
    "position": 1,
    "text": "نگهبان مرز و نگهبان کیش"
  },
  {
    "poem_id": 1770,
    "vorder": 95,
    "position": 0,
    "text": "به فرزند و زن نیز هم پادشا"
  },
  {
    "poem_id": 1770,
    "vorder": 96,
    "position": 1,
    "text": "خنک مردم زیرک و پارسا"
  },
  {
    "poem_id": 1770,
    "vorder": 97,
    "position": 0,
    "text": "نخواهیم آگندن زر به گنج"
  },
  {
    "poem_id": 1770,
    "vorder": 98,
    "position": 1,
    "text": "که از گنج درویش ماند به رنج"
  },
  {
    "poem_id": 1770,
    "vorder": 99,
    "position": 0,
    "text": "گر ایزد مرا زندگانی دهد"
  },
  {
    "poem_id": 1770,
    "vorder": 100,
    "position": 1,
    "text": "برین اختران کامرانی دهد"
  },
  {
    "poem_id": 1770,
    "vorder": 101,
    "position": 0,
    "text": "یکی رامشی نامه خوانید نیز"
  },
  {
    "poem_id": 1770,
    "vorder": 102,
    "position": 1,
    "text": "کزان جاودان ارج یابید و چیز"
  },
  {
    "poem_id": 1770,
    "vorder": 103,
    "position": 0,
    "text": "ز ما بر همه پادشاهی درود"
  },
  {
    "poem_id": 1770,
    "vorder": 104,
    "position": 1,
    "text": "به ویژه که مهرش بود تار و پود"
  },
  {
    "poem_id": 1770,
    "vorder": 105,
    "position": 0,
    "text": "نهادند بر نامه‌ها بر نگین"
  },
  {
    "poem_id": 1770,
    "vorder": 106,
    "position": 1,
    "text": "فرستادگان خواست با آفرین"
  },
  {
    "poem_id": 1770,
    "vorder": 107,
    "position": 0,
    "text": "برفتند با نامه‌ها موبدان"
  },
  {
    "poem_id": 1770,
    "vorder": 108,
    "position": 1,
    "text": "سواران بینا‌دل و بخردان"
  }
]