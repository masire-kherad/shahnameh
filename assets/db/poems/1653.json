[
  {
    "poem_id": 1653,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس بفرمود کان جام زرد"
  },
  {
    "poem_id": 1653,
    "vorder": 2,
    "position": 1,
    "text": "بیارند پر کرده از آب سرد"
  },
  {
    "poem_id": 1653,
    "vorder": 3,
    "position": 0,
    "text": "همی خورد زان جام زر هرکس آب"
  },
  {
    "poem_id": 1653,
    "vorder": 4,
    "position": 1,
    "text": "ز شبگیر تا بود هنگام خواب"
  },
  {
    "poem_id": 1653,
    "vorder": 5,
    "position": 0,
    "text": "بخوردند آب از پی خرمی"
  },
  {
    "poem_id": 1653,
    "vorder": 6,
    "position": 1,
    "text": "ز خوردن نیامد بدو در کمی"
  },
  {
    "poem_id": 1653,
    "vorder": 7,
    "position": 0,
    "text": "بدان فیلسوف آن زمان شاه گفت"
  },
  {
    "poem_id": 1653,
    "vorder": 8,
    "position": 1,
    "text": "که این دانش از من نباید نهفت"
  },
  {
    "poem_id": 1653,
    "vorder": 9,
    "position": 0,
    "text": "که افزایش آب این جام چیست"
  },
  {
    "poem_id": 1653,
    "vorder": 10,
    "position": 1,
    "text": "نجومیست گر آلت هندویست"
  },
  {
    "poem_id": 1653,
    "vorder": 11,
    "position": 0,
    "text": "چنین داد پاسخ که ای شهریار"
  },
  {
    "poem_id": 1653,
    "vorder": 12,
    "position": 1,
    "text": "تو این جام را خوارمایه مدار"
  },
  {
    "poem_id": 1653,
    "vorder": 13,
    "position": 0,
    "text": "که این در بسی سالیان کرده‌اند"
  },
  {
    "poem_id": 1653,
    "vorder": 14,
    "position": 1,
    "text": "بدین در بسی رنجها برده‌اند"
  },
  {
    "poem_id": 1653,
    "vorder": 15,
    "position": 0,
    "text": "ز اختر شناسان هر کشوری"
  },
  {
    "poem_id": 1653,
    "vorder": 16,
    "position": 1,
    "text": "به جایی که بد نامور مهتری"
  },
  {
    "poem_id": 1653,
    "vorder": 17,
    "position": 0,
    "text": "بر کید بودند کین جام کرد"
  },
  {
    "poem_id": 1653,
    "vorder": 18,
    "position": 1,
    "text": "به روز سپید و شب لاژورد"
  },
  {
    "poem_id": 1653,
    "vorder": 19,
    "position": 0,
    "text": "همی طبع اختر نگه داشتند"
  },
  {
    "poem_id": 1653,
    "vorder": 20,
    "position": 1,
    "text": "فراوان درین روز بگذاشتند"
  },
  {
    "poem_id": 1653,
    "vorder": 21,
    "position": 0,
    "text": "تو از مغنیاطیس گیر این نشان"
  },
  {
    "poem_id": 1653,
    "vorder": 22,
    "position": 1,
    "text": "که او را کسی کرد ز آهن‌کشان"
  },
  {
    "poem_id": 1653,
    "vorder": 23,
    "position": 0,
    "text": "به طبع این چنین هم شدست آب‌کش"
  },
  {
    "poem_id": 1653,
    "vorder": 24,
    "position": 1,
    "text": "ز گردون پذیره همی آب خوش"
  },
  {
    "poem_id": 1653,
    "vorder": 25,
    "position": 0,
    "text": "همی آب یابد چو گیرد کمی"
  },
  {
    "poem_id": 1653,
    "vorder": 26,
    "position": 1,
    "text": "نبیند به روشن دو چشم آدمی"
  },
  {
    "poem_id": 1653,
    "vorder": 27,
    "position": 0,
    "text": "چو گفتار دانا پسند آمدش"
  },
  {
    "poem_id": 1653,
    "vorder": 28,
    "position": 1,
    "text": "سخنهای او سودمند آمدش"
  },
  {
    "poem_id": 1653,
    "vorder": 29,
    "position": 0,
    "text": "چنین گفت پیران میلاد را"
  },
  {
    "poem_id": 1653,
    "vorder": 30,
    "position": 1,
    "text": "که من عهد کید از پی داد را"
  },
  {
    "poem_id": 1653,
    "vorder": 31,
    "position": 0,
    "text": "همی نشکنم تا بماند به جای"
  },
  {
    "poem_id": 1653,
    "vorder": 32,
    "position": 1,
    "text": "همی پیش او بود باید به پای"
  },
  {
    "poem_id": 1653,
    "vorder": 33,
    "position": 0,
    "text": "که من یافتم زو چنین چار چیز"
  },
  {
    "poem_id": 1653,
    "vorder": 34,
    "position": 1,
    "text": "بروبر فزونی نجوییم نیز"
  },
  {
    "poem_id": 1653,
    "vorder": 35,
    "position": 0,
    "text": "دو صد بارکش خواسته بر نهاد"
  },
  {
    "poem_id": 1653,
    "vorder": 36,
    "position": 1,
    "text": "صد افسر ز گوهر بران سر نهاد"
  },
  {
    "poem_id": 1653,
    "vorder": 37,
    "position": 0,
    "text": "به کوه اندر آگند چیزی که بود"
  },
  {
    "poem_id": 1653,
    "vorder": 38,
    "position": 1,
    "text": "ز دینار وز گوهر نابسود"
  },
  {
    "poem_id": 1653,
    "vorder": 39,
    "position": 0,
    "text": "چو در کوه شد گنجها ناپدید"
  },
  {
    "poem_id": 1653,
    "vorder": 40,
    "position": 1,
    "text": "کسی چهرهٔ آگننده ندید"
  },
  {
    "poem_id": 1653,
    "vorder": 41,
    "position": 0,
    "text": "همه گنج با آنک کردش نهان"
  },
  {
    "poem_id": 1653,
    "vorder": 42,
    "position": 1,
    "text": "ندیدند زان پس کس اندر جهان"
  },
  {
    "poem_id": 1653,
    "vorder": 43,
    "position": 0,
    "text": "ز گنج نهان کرده بر کوهسار"
  },
  {
    "poem_id": 1653,
    "vorder": 44,
    "position": 1,
    "text": "بیاورد با خویشتن یادگار"
  }
]