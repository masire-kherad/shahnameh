[
  {
    "poem_id": 1643,
    "vorder": 1,
    "position": 0,
    "text": "ز عموریه مادرش را بخواند"
  },
  {
    "poem_id": 1643,
    "vorder": 2,
    "position": 1,
    "text": "چو آمد سخنهای دارا براند"
  },
  {
    "poem_id": 1643,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت نزد دلارای شو"
  },
  {
    "poem_id": 1643,
    "vorder": 4,
    "position": 1,
    "text": "به خوبی به پیوند گفتار نو"
  },
  {
    "poem_id": 1643,
    "vorder": 5,
    "position": 0,
    "text": "به پرده درون روشنک را ببین"
  },
  {
    "poem_id": 1643,
    "vorder": 6,
    "position": 1,
    "text": "چو دیدی ز ما کن برو آفرین"
  },
  {
    "poem_id": 1643,
    "vorder": 7,
    "position": 0,
    "text": "ببر طوق با یاره و گوشوار"
  },
  {
    "poem_id": 1643,
    "vorder": 8,
    "position": 1,
    "text": "یکی تاج پر گوهر شاهوار"
  },
  {
    "poem_id": 1643,
    "vorder": 9,
    "position": 0,
    "text": "صد اشتر ز گستردنیها ببر"
  },
  {
    "poem_id": 1643,
    "vorder": 10,
    "position": 1,
    "text": "صد اشتر ز هر گونه دیبا به زر"
  },
  {
    "poem_id": 1643,
    "vorder": 11,
    "position": 0,
    "text": "هم از گنج دینار چو سی هزار"
  },
  {
    "poem_id": 1643,
    "vorder": 12,
    "position": 1,
    "text": "به بدره درون کن ز بهر نثار"
  },
  {
    "poem_id": 1643,
    "vorder": 13,
    "position": 0,
    "text": "ز رومی کنیزک چو سیصد ببر"
  },
  {
    "poem_id": 1643,
    "vorder": 14,
    "position": 1,
    "text": "دگر هرچ باید همه سر به سر"
  },
  {
    "poem_id": 1643,
    "vorder": 15,
    "position": 0,
    "text": "یکی جام زر هر یکی را به دست"
  },
  {
    "poem_id": 1643,
    "vorder": 16,
    "position": 1,
    "text": "بر آیین خوبان خسروپرست"
  },
  {
    "poem_id": 1643,
    "vorder": 17,
    "position": 0,
    "text": "ابا خویشتن خادمان بر براه"
  },
  {
    "poem_id": 1643,
    "vorder": 18,
    "position": 1,
    "text": "ز راه و ز آیین شاهان مکاه"
  },
  {
    "poem_id": 1643,
    "vorder": 19,
    "position": 0,
    "text": "بشد مادر شاه با ترجمان"
  },
  {
    "poem_id": 1643,
    "vorder": 20,
    "position": 1,
    "text": "ده از فیلسوفان شیرین‌زبان"
  },
  {
    "poem_id": 1643,
    "vorder": 21,
    "position": 0,
    "text": "چو آمد به نزدیکی اصفهان"
  },
  {
    "poem_id": 1643,
    "vorder": 22,
    "position": 1,
    "text": "پذیره شدندش فراوان مهان"
  },
  {
    "poem_id": 1643,
    "vorder": 23,
    "position": 0,
    "text": "بیامد ز ایوان دلارای پیش"
  },
  {
    "poem_id": 1643,
    "vorder": 24,
    "position": 1,
    "text": "خود و نامداران به آیین خویش"
  },
  {
    "poem_id": 1643,
    "vorder": 25,
    "position": 0,
    "text": "به دهلیز کردند چندان نثار"
  },
  {
    "poem_id": 1643,
    "vorder": 26,
    "position": 1,
    "text": "که بر چشم گنج درم گشت خوار"
  },
  {
    "poem_id": 1643,
    "vorder": 27,
    "position": 0,
    "text": "به ایوان نشستند با رای‌زن"
  },
  {
    "poem_id": 1643,
    "vorder": 28,
    "position": 1,
    "text": "همه نامداران شدند انجمن"
  },
  {
    "poem_id": 1643,
    "vorder": 29,
    "position": 0,
    "text": "دلارای برداشت چندان جهیز"
  },
  {
    "poem_id": 1643,
    "vorder": 30,
    "position": 1,
    "text": "که شد در جهان روی بازار تیز"
  },
  {
    "poem_id": 1643,
    "vorder": 31,
    "position": 0,
    "text": "شتر در شتر رفت فرسنگها"
  },
  {
    "poem_id": 1643,
    "vorder": 32,
    "position": 1,
    "text": "ز زرین و سیمین وز رنگها"
  },
  {
    "poem_id": 1643,
    "vorder": 33,
    "position": 0,
    "text": "ز پوشیدنی و ز گستردنی"
  },
  {
    "poem_id": 1643,
    "vorder": 34,
    "position": 1,
    "text": "ز افگندنی و پراگندنی"
  },
  {
    "poem_id": 1643,
    "vorder": 35,
    "position": 0,
    "text": "ز اسپان تازی به زرین ستام"
  },
  {
    "poem_id": 1643,
    "vorder": 36,
    "position": 1,
    "text": "ز شمشیر هندی به زرین نیام"
  },
  {
    "poem_id": 1643,
    "vorder": 37,
    "position": 0,
    "text": "ز خفتان و از خود و برگستوان"
  },
  {
    "poem_id": 1643,
    "vorder": 38,
    "position": 1,
    "text": "ز گوپال و ز خنجر هندوان"
  },
  {
    "poem_id": 1643,
    "vorder": 39,
    "position": 0,
    "text": "چه مایه بریده چه از نابرید"
  },
  {
    "poem_id": 1643,
    "vorder": 40,
    "position": 1,
    "text": "کسی در جهان بیشتر زان ندید"
  },
  {
    "poem_id": 1643,
    "vorder": 41,
    "position": 0,
    "text": "ز ایوان پرستندگان خواستند"
  },
  {
    "poem_id": 1643,
    "vorder": 42,
    "position": 1,
    "text": "چهل مهد زرین بیاراستند"
  },
  {
    "poem_id": 1643,
    "vorder": 43,
    "position": 0,
    "text": "یکی مهد با چتر و با خادمان"
  },
  {
    "poem_id": 1643,
    "vorder": 44,
    "position": 1,
    "text": "نشست اندرو روشنک شادمان"
  },
  {
    "poem_id": 1643,
    "vorder": 45,
    "position": 0,
    "text": "ز کاخ دلارای تا نیم راه"
  },
  {
    "poem_id": 1643,
    "vorder": 46,
    "position": 1,
    "text": "درم بود و دینار و اسپ و سپاه"
  },
  {
    "poem_id": 1643,
    "vorder": 47,
    "position": 0,
    "text": "ببستند آذین به شهر اندرون"
  },
  {
    "poem_id": 1643,
    "vorder": 48,
    "position": 1,
    "text": "پر از خنده لبها و دل پر ز خون"
  },
  {
    "poem_id": 1643,
    "vorder": 49,
    "position": 0,
    "text": "بران چتر دیبا درم ریختند"
  },
  {
    "poem_id": 1643,
    "vorder": 50,
    "position": 1,
    "text": "ز بر مشک سارا همی بیختند"
  },
  {
    "poem_id": 1643,
    "vorder": 51,
    "position": 0,
    "text": "چو ماه اندر آمد به مشکوی شاه"
  },
  {
    "poem_id": 1643,
    "vorder": 52,
    "position": 1,
    "text": "سکندر بدو کرد چندی نگاه"
  },
  {
    "poem_id": 1643,
    "vorder": 53,
    "position": 0,
    "text": "بران برز و بالا و آن خوب چهر"
  },
  {
    "poem_id": 1643,
    "vorder": 54,
    "position": 1,
    "text": "تو گفتی خرد پروریدش به مهر"
  },
  {
    "poem_id": 1643,
    "vorder": 55,
    "position": 0,
    "text": "چو مادرش بر تخت زرین نشاند"
  },
  {
    "poem_id": 1643,
    "vorder": 56,
    "position": 1,
    "text": "سکندر بروبر همی جان فشاند"
  },
  {
    "poem_id": 1643,
    "vorder": 57,
    "position": 0,
    "text": "نشستند یک هفته با او به هم"
  },
  {
    "poem_id": 1643,
    "vorder": 58,
    "position": 1,
    "text": "همی رای زد شاه بر بیش و کم"
  },
  {
    "poem_id": 1643,
    "vorder": 59,
    "position": 0,
    "text": "نبد جز بزرگی و آهستگی"
  },
  {
    "poem_id": 1643,
    "vorder": 60,
    "position": 1,
    "text": "خردمندی و شرم و شایستگی"
  },
  {
    "poem_id": 1643,
    "vorder": 61,
    "position": 0,
    "text": "ببردند ز ایران فراوان نثار"
  },
  {
    "poem_id": 1643,
    "vorder": 62,
    "position": 1,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1643,
    "vorder": 63,
    "position": 0,
    "text": "همه شهر ایران و توران و چین"
  },
  {
    "poem_id": 1643,
    "vorder": 64,
    "position": 1,
    "text": "به شاهی برو خواندند آفرین"
  },
  {
    "poem_id": 1643,
    "vorder": 65,
    "position": 0,
    "text": "همه روی گیتی پر از داد شد"
  },
  {
    "poem_id": 1643,
    "vorder": 66,
    "position": 1,
    "text": "به هر جای ویرانی آباد شد"
  }
]