[
  {
    "poem_id": 1829,
    "vorder": 1,
    "position": 0,
    "text": "نگه کن که شادان برزین چه گفت"
  },
  {
    "poem_id": 1829,
    "vorder": 2,
    "position": 1,
    "text": "بدانگه که بگشاد راز از نهفت"
  },
  {
    "poem_id": 1829,
    "vorder": 3,
    "position": 0,
    "text": "بدرگه شهنشاه نوشین‌روان"
  },
  {
    "poem_id": 1829,
    "vorder": 4,
    "position": 1,
    "text": "که نامش بماناد تا جاودان"
  },
  {
    "poem_id": 1829,
    "vorder": 5,
    "position": 0,
    "text": "ز هر دانشی موبدی خواستی"
  },
  {
    "poem_id": 1829,
    "vorder": 6,
    "position": 1,
    "text": "که درگه بدیشان بیاراستی"
  },
  {
    "poem_id": 1829,
    "vorder": 7,
    "position": 0,
    "text": "پزشک سخنگوی و کنداوران"
  },
  {
    "poem_id": 1829,
    "vorder": 8,
    "position": 1,
    "text": "بزرگان وکارآزموده سران"
  },
  {
    "poem_id": 1829,
    "vorder": 9,
    "position": 0,
    "text": "ابر هر دری ناموَر مهتری"
  },
  {
    "poem_id": 1829,
    "vorder": 10,
    "position": 1,
    "text": "کجا هر سری را بُدی افسری"
  },
  {
    "poem_id": 1829,
    "vorder": 11,
    "position": 0,
    "text": "پزشک سراینده برزوی بود"
  },
  {
    "poem_id": 1829,
    "vorder": 12,
    "position": 1,
    "text": "به نیرو رسیده سخنگوی بود"
  },
  {
    "poem_id": 1829,
    "vorder": 13,
    "position": 0,
    "text": "ز هر دانشی داشتی بهره‌ای"
  },
  {
    "poem_id": 1829,
    "vorder": 14,
    "position": 1,
    "text": "به هر بهره‌ای در جهان شهره‌ای"
  },
  {
    "poem_id": 1829,
    "vorder": 15,
    "position": 0,
    "text": "چنان بد که روزی به هنگام بار"
  },
  {
    "poem_id": 1829,
    "vorder": 16,
    "position": 1,
    "text": "بیامد بر نامور شهریار"
  },
  {
    "poem_id": 1829,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت کای شاه دانش‌پذیر"
  },
  {
    "poem_id": 1829,
    "vorder": 18,
    "position": 1,
    "text": "پژوهنده و یافته یادگیر"
  },
  {
    "poem_id": 1829,
    "vorder": 19,
    "position": 0,
    "text": "من امروز در دفتر هندوان"
  },
  {
    "poem_id": 1829,
    "vorder": 20,
    "position": 1,
    "text": "همی‌ بنگریدم به روشن روان"
  },
  {
    "poem_id": 1829,
    "vorder": 21,
    "position": 0,
    "text": "چنین بُد نبشته که بر کوه هند"
  },
  {
    "poem_id": 1829,
    "vorder": 22,
    "position": 1,
    "text": "گیاییست چینی چو رومی پرند"
  },
  {
    "poem_id": 1829,
    "vorder": 23,
    "position": 0,
    "text": "که آن را چو گرد آورد رهنمای"
  },
  {
    "poem_id": 1829,
    "vorder": 24,
    "position": 1,
    "text": "بیامیزد و دانش آرد بجای"
  },
  {
    "poem_id": 1829,
    "vorder": 25,
    "position": 0,
    "text": "چو بر مُرده بپراگند بی‌گمان"
  },
  {
    "poem_id": 1829,
    "vorder": 26,
    "position": 1,
    "text": "سخنگوی گردد هم اندر زمان"
  },
  {
    "poem_id": 1829,
    "vorder": 27,
    "position": 0,
    "text": "کنون من بدستوری شهریار"
  },
  {
    "poem_id": 1829,
    "vorder": 28,
    "position": 1,
    "text": "بپیمایم این راه دشوار خوار"
  },
  {
    "poem_id": 1829,
    "vorder": 29,
    "position": 0,
    "text": "بسی دانشی رهنمای آورم"
  },
  {
    "poem_id": 1829,
    "vorder": 30,
    "position": 1,
    "text": "مگر کین شگفتی بجای آورم"
  },
  {
    "poem_id": 1829,
    "vorder": 31,
    "position": 0,
    "text": "تن مرده گر زنده گردد رواست"
  },
  {
    "poem_id": 1829,
    "vorder": 32,
    "position": 1,
    "text": "که نوشین‌روان بر جهان پادشاست"
  },
  {
    "poem_id": 1829,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت شاه این نشاید بُدن"
  },
  {
    "poem_id": 1829,
    "vorder": 34,
    "position": 1,
    "text": "مگر آزمون را بباید شدن"
  },
  {
    "poem_id": 1829,
    "vorder": 35,
    "position": 0,
    "text": "ببر نامهٔ من برِ رای هند"
  },
  {
    "poem_id": 1829,
    "vorder": 36,
    "position": 1,
    "text": "نگر تا که باشد بت‌آرای هند"
  },
  {
    "poem_id": 1829,
    "vorder": 37,
    "position": 0,
    "text": "بدین کار با خویشتن یارخواه"
  },
  {
    "poem_id": 1829,
    "vorder": 38,
    "position": 1,
    "text": "همه یاری از بختِ بیدار خواه"
  },
  {
    "poem_id": 1829,
    "vorder": 39,
    "position": 0,
    "text": "اگر نوشگفتی شود در جهان"
  },
  {
    "poem_id": 1829,
    "vorder": 40,
    "position": 1,
    "text": "که این گفته رمزی بود درنهان"
  },
  {
    "poem_id": 1829,
    "vorder": 41,
    "position": 0,
    "text": "ببر هرچ باید به نزدیک رای"
  },
  {
    "poem_id": 1829,
    "vorder": 42,
    "position": 1,
    "text": "کزو بایدت بی‌گمان رهنمای"
  },
  {
    "poem_id": 1829,
    "vorder": 43,
    "position": 0,
    "text": "در گنج بگشاد نوشین‌روان"
  },
  {
    "poem_id": 1829,
    "vorder": 44,
    "position": 1,
    "text": "ز چیزی که بُد درخور خسروان"
  },
  {
    "poem_id": 1829,
    "vorder": 45,
    "position": 0,
    "text": "ز دینار و دیبا و خز و حریر"
  },
  {
    "poem_id": 1829,
    "vorder": 46,
    "position": 1,
    "text": "ز مهر و ز افسر ز مشک و عبیر"
  },
  {
    "poem_id": 1829,
    "vorder": 47,
    "position": 0,
    "text": "شتروار سیصد بیاراست شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 48,
    "position": 1,
    "text": "فرستاده برداشت آمد به راه"
  },
  {
    "poem_id": 1829,
    "vorder": 49,
    "position": 0,
    "text": "بیامد برِ رای و نامه بداد"
  },
  {
    "poem_id": 1829,
    "vorder": 50,
    "position": 1,
    "text": "سرِ بارها پیش او برگشاد"
  },
  {
    "poem_id": 1829,
    "vorder": 51,
    "position": 0,
    "text": "چو برخواند آن نامهٔ شاه رای"
  },
  {
    "poem_id": 1829,
    "vorder": 52,
    "position": 1,
    "text": "بدو گفت کای مرد پاکیزه رای"
  },
  {
    "poem_id": 1829,
    "vorder": 53,
    "position": 0,
    "text": "ز کسری مرا گنج بخشیده نیست"
  },
  {
    "poem_id": 1829,
    "vorder": 54,
    "position": 1,
    "text": "همه لشکر و پادشاهی یکیست"
  },
  {
    "poem_id": 1829,
    "vorder": 55,
    "position": 0,
    "text": "ز داد و ز فرّ و ز اورند شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 56,
    "position": 1,
    "text": "وزان روشنی بخت و آن دستگاه"
  },
  {
    "poem_id": 1829,
    "vorder": 57,
    "position": 0,
    "text": "نباشد شگفت از جهاندار پاک"
  },
  {
    "poem_id": 1829,
    "vorder": 58,
    "position": 1,
    "text": "که گر مردگان را برآرد ز خاک"
  },
  {
    "poem_id": 1829,
    "vorder": 59,
    "position": 0,
    "text": "برهمن بکوه اندرون هرک هست"
  },
  {
    "poem_id": 1829,
    "vorder": 60,
    "position": 1,
    "text": "یکی دارد این رای را با تو دست"
  },
  {
    "poem_id": 1829,
    "vorder": 61,
    "position": 0,
    "text": "بت‌آرای و فرخنده دستور من"
  },
  {
    "poem_id": 1829,
    "vorder": 62,
    "position": 1,
    "text": "هم آن گنج و پرمایه گنجور من"
  },
  {
    "poem_id": 1829,
    "vorder": 63,
    "position": 0,
    "text": "بد و نیک هندوستان پیش تست"
  },
  {
    "poem_id": 1829,
    "vorder": 64,
    "position": 1,
    "text": "بزرگی مرا در کم و بیش تست"
  },
  {
    "poem_id": 1829,
    "vorder": 65,
    "position": 0,
    "text": "بیاراستندش به نزدیک رای"
  },
  {
    "poem_id": 1829,
    "vorder": 66,
    "position": 1,
    "text": "یکی نامور چون ببایست جای"
  },
  {
    "poem_id": 1829,
    "vorder": 67,
    "position": 0,
    "text": "خورشگر فرستاد هم خوردنی"
  },
  {
    "poem_id": 1829,
    "vorder": 68,
    "position": 1,
    "text": "همان پوشش نغز و گستردنی"
  },
  {
    "poem_id": 1829,
    "vorder": 69,
    "position": 0,
    "text": "برفت آن شب و رای زد با ردان"
  },
  {
    "poem_id": 1829,
    "vorder": 70,
    "position": 1,
    "text": "بزرگان قنّوج با بخردان"
  },
  {
    "poem_id": 1829,
    "vorder": 71,
    "position": 0,
    "text": "چو برزد سر از کوه رخشنده روز"
  },
  {
    "poem_id": 1829,
    "vorder": 72,
    "position": 1,
    "text": "پدید آمد آن شمع گیتی‌فروز"
  },
  {
    "poem_id": 1829,
    "vorder": 73,
    "position": 0,
    "text": "پزشکان فرزانه را خواند رای"
  },
  {
    "poem_id": 1829,
    "vorder": 74,
    "position": 1,
    "text": "کسی کو بدانش بُدی رهنمای"
  },
  {
    "poem_id": 1829,
    "vorder": 75,
    "position": 0,
    "text": "چو برزوی بنهاد سر سوی کوه"
  },
  {
    "poem_id": 1829,
    "vorder": 76,
    "position": 1,
    "text": "برفتند با او پزشکان گروه"
  },
  {
    "poem_id": 1829,
    "vorder": 77,
    "position": 0,
    "text": "پیاده همه کوهساران بپای"
  },
  {
    "poem_id": 1829,
    "vorder": 78,
    "position": 1,
    "text": "بپیمود با دانشی رهنمای"
  },
  {
    "poem_id": 1829,
    "vorder": 79,
    "position": 0,
    "text": "گیاها ز خشک و ز تر برگزید"
  },
  {
    "poem_id": 1829,
    "vorder": 80,
    "position": 1,
    "text": "ز پژمرده و آنچ رخشنده دید"
  },
  {
    "poem_id": 1829,
    "vorder": 81,
    "position": 0,
    "text": "ز هرگونه دارو ز خشک و ز تر"
  },
  {
    "poem_id": 1829,
    "vorder": 82,
    "position": 1,
    "text": "همی بر پراگند بر مرده بر"
  },
  {
    "poem_id": 1829,
    "vorder": 83,
    "position": 0,
    "text": "یکی مرده زنده نگشت از گیا"
  },
  {
    "poem_id": 1829,
    "vorder": 84,
    "position": 1,
    "text": "همانا که سست آمد آن کیمیا"
  },
  {
    "poem_id": 1829,
    "vorder": 85,
    "position": 0,
    "text": "همه کوه بسپرد یک یک بپای"
  },
  {
    "poem_id": 1829,
    "vorder": 86,
    "position": 1,
    "text": "ابر رنج او بر نیامد بجای"
  },
  {
    "poem_id": 1829,
    "vorder": 87,
    "position": 0,
    "text": "بدانست کان کار آن پادشاست"
  },
  {
    "poem_id": 1829,
    "vorder": 88,
    "position": 1,
    "text": "که زنده است جاوید و فرمانرواست"
  },
  {
    "poem_id": 1829,
    "vorder": 89,
    "position": 0,
    "text": "دلش گشت سوزان ز تشویر شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 90,
    "position": 1,
    "text": "هم از نامداران هم از رنج راه"
  },
  {
    "poem_id": 1829,
    "vorder": 91,
    "position": 0,
    "text": "وزان خواسته نیز کاورده بود"
  },
  {
    "poem_id": 1829,
    "vorder": 92,
    "position": 1,
    "text": "ز گفتار بیهوده آزرده بود"
  },
  {
    "poem_id": 1829,
    "vorder": 93,
    "position": 0,
    "text": "ز کارِ نبشته ببُد تنگدل"
  },
  {
    "poem_id": 1829,
    "vorder": 94,
    "position": 1,
    "text": "که آن مرد بیدانش و سنگدل"
  },
  {
    "poem_id": 1829,
    "vorder": 95,
    "position": 0,
    "text": "چرا خیره بر باد چیزی نبشت"
  },
  {
    "poem_id": 1829,
    "vorder": 96,
    "position": 1,
    "text": "که بد بار آن رنج گفتار زشت"
  },
  {
    "poem_id": 1829,
    "vorder": 97,
    "position": 0,
    "text": "چنین گفت زان پس بران بخردان"
  },
  {
    "poem_id": 1829,
    "vorder": 98,
    "position": 1,
    "text": "که‌ ای کاردیده ستوده ردان"
  },
  {
    "poem_id": 1829,
    "vorder": 99,
    "position": 0,
    "text": "که دانید داناتر از خویشتن"
  },
  {
    "poem_id": 1829,
    "vorder": 100,
    "position": 1,
    "text": "کجا سرفرازد بدین انجمن"
  },
  {
    "poem_id": 1829,
    "vorder": 101,
    "position": 0,
    "text": "به پاسخ شدند انجمن همسخن"
  },
  {
    "poem_id": 1829,
    "vorder": 102,
    "position": 1,
    "text": "که داننده پیرست ایدر کهن"
  },
  {
    "poem_id": 1829,
    "vorder": 103,
    "position": 0,
    "text": "به سال و خرد او ز ما مهترست"
  },
  {
    "poem_id": 1829,
    "vorder": 104,
    "position": 1,
    "text": "به دانش ز هر مهتری بهترست"
  },
  {
    "poem_id": 1829,
    "vorder": 105,
    "position": 0,
    "text": "چنین گفت برزوی با هندوان"
  },
  {
    "poem_id": 1829,
    "vorder": 106,
    "position": 1,
    "text": "که ای نامداران روشن‌روان"
  },
  {
    "poem_id": 1829,
    "vorder": 107,
    "position": 0,
    "text": "برین رنجها بر فزونی کنید"
  },
  {
    "poem_id": 1829,
    "vorder": 108,
    "position": 1,
    "text": "مرا سوی او رهنمونی کنید"
  },
  {
    "poem_id": 1829,
    "vorder": 109,
    "position": 0,
    "text": "مگر کان سخنگوی دانای پیر"
  },
  {
    "poem_id": 1829,
    "vorder": 110,
    "position": 1,
    "text": "بدین کار باشد مرا دستگیر"
  },
  {
    "poem_id": 1829,
    "vorder": 111,
    "position": 0,
    "text": "ببردند برزوی را نزد اوی"
  },
  {
    "poem_id": 1829,
    "vorder": 112,
    "position": 1,
    "text": "پراندیشه دل سر پر از گفت و گوی"
  },
  {
    "poem_id": 1829,
    "vorder": 113,
    "position": 0,
    "text": "چو نزدیک او شد سخنگوی مرد"
  },
  {
    "poem_id": 1829,
    "vorder": 114,
    "position": 1,
    "text": "همه رنج‌ها پیش او یاد کرد"
  },
  {
    "poem_id": 1829,
    "vorder": 115,
    "position": 0,
    "text": "ز کار نبشته که آمد پدید"
  },
  {
    "poem_id": 1829,
    "vorder": 116,
    "position": 1,
    "text": "سخن‌ها که از کاردانان شنید"
  },
  {
    "poem_id": 1829,
    "vorder": 117,
    "position": 0,
    "text": "بدو پیر دانا زبان برگشاد"
  },
  {
    "poem_id": 1829,
    "vorder": 118,
    "position": 1,
    "text": "ز هر دانشی پیش او کرد یاد"
  },
  {
    "poem_id": 1829,
    "vorder": 119,
    "position": 0,
    "text": "که من در نبشته چنین یافتم"
  },
  {
    "poem_id": 1829,
    "vorder": 120,
    "position": 1,
    "text": "بدان آرزو تیز بشتافتم"
  },
  {
    "poem_id": 1829,
    "vorder": 121,
    "position": 0,
    "text": "چو زان رنج‌ها برنیامد پدید"
  },
  {
    "poem_id": 1829,
    "vorder": 122,
    "position": 1,
    "text": "ببایست ناچار دیگر شنید"
  },
  {
    "poem_id": 1829,
    "vorder": 123,
    "position": 0,
    "text": "گیا چون سخن‌دان و دانش چو کوه"
  },
  {
    "poem_id": 1829,
    "vorder": 124,
    "position": 1,
    "text": "که همواره باشد مر او را شکوه"
  },
  {
    "poem_id": 1829,
    "vorder": 125,
    "position": 0,
    "text": "تن مرده چون مرد بیدانشست"
  },
  {
    "poem_id": 1829,
    "vorder": 126,
    "position": 1,
    "text": "که دانا به هر جای با رامشست"
  },
  {
    "poem_id": 1829,
    "vorder": 127,
    "position": 0,
    "text": "به دانش بود بی‌گمان زنده مرد"
  },
  {
    "poem_id": 1829,
    "vorder": 128,
    "position": 1,
    "text": "چو دانش نباشد ب گِردش مگرد"
  },
  {
    "poem_id": 1829,
    "vorder": 129,
    "position": 0,
    "text": "چو مردم ز دانایی آید ستوه"
  },
  {
    "poem_id": 1829,
    "vorder": 130,
    "position": 1,
    "text": "گیا چون کلیله‌ست و دانش چو کوه"
  },
  {
    "poem_id": 1829,
    "vorder": 131,
    "position": 0,
    "text": "کتابی به دانش نماینده راه"
  },
  {
    "poem_id": 1829,
    "vorder": 132,
    "position": 1,
    "text": "بیابی چو جویی تو از گنج شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 133,
    "position": 0,
    "text": "چو بشنید برزوی زو شاد شد"
  },
  {
    "poem_id": 1829,
    "vorder": 134,
    "position": 1,
    "text": "همه رنج بر چشم او باد شد"
  },
  {
    "poem_id": 1829,
    "vorder": 135,
    "position": 0,
    "text": "بر او آفرین کرد و شد نزد شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 136,
    "position": 1,
    "text": "به کردار آتش بپیمود راه"
  },
  {
    "poem_id": 1829,
    "vorder": 137,
    "position": 0,
    "text": "بیامد نیایش‌کنان پیش رای"
  },
  {
    "poem_id": 1829,
    "vorder": 138,
    "position": 1,
    "text": "که تا جای باشد تو بادی به جای"
  },
  {
    "poem_id": 1829,
    "vorder": 139,
    "position": 0,
    "text": "کتابیست ای شاه گسترده کام"
  },
  {
    "poem_id": 1829,
    "vorder": 140,
    "position": 1,
    "text": "که آن را به هندی کلیله‌ست نام"
  },
  {
    "poem_id": 1829,
    "vorder": 141,
    "position": 0,
    "text": "به مهرست تا درج در گنج شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 142,
    "position": 1,
    "text": "به رای و به دانش نماینده راه"
  },
  {
    "poem_id": 1829,
    "vorder": 143,
    "position": 0,
    "text": "به گنجور فرمان دهد تا ز گنج"
  },
  {
    "poem_id": 1829,
    "vorder": 144,
    "position": 1,
    "text": "سپارد به من گر ندارد به رنج"
  },
  {
    "poem_id": 1829,
    "vorder": 145,
    "position": 0,
    "text": "دژم گشت زان آرزو جان شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 146,
    "position": 1,
    "text": "بپیچید برخویشتن چندگاه"
  },
  {
    "poem_id": 1829,
    "vorder": 147,
    "position": 0,
    "text": "به برزوی گفت این کس از ما نجُست"
  },
  {
    "poem_id": 1829,
    "vorder": 148,
    "position": 1,
    "text": "نه اکنون نه از روزگار نخست"
  },
  {
    "poem_id": 1829,
    "vorder": 149,
    "position": 0,
    "text": "ولیکن جهاندار نوشین‌روان"
  },
  {
    "poem_id": 1829,
    "vorder": 150,
    "position": 1,
    "text": "اگر تن بخواهد ز ما یا روان"
  },
  {
    "poem_id": 1829,
    "vorder": 151,
    "position": 0,
    "text": "نداریم ازو باز چیزی که هست"
  },
  {
    "poem_id": 1829,
    "vorder": 152,
    "position": 1,
    "text": "اگر سرفرازست اگر زیردست"
  },
  {
    "poem_id": 1829,
    "vorder": 153,
    "position": 0,
    "text": "ولیکن بخوانی مگر پیش ما"
  },
  {
    "poem_id": 1829,
    "vorder": 154,
    "position": 1,
    "text": "بدان تا روان بداندیش ما"
  },
  {
    "poem_id": 1829,
    "vorder": 155,
    "position": 0,
    "text": "نگوید به دل کان نبشتست کس"
  },
  {
    "poem_id": 1829,
    "vorder": 156,
    "position": 1,
    "text": "بخوان و بدان و ببین پیش و پس"
  },
  {
    "poem_id": 1829,
    "vorder": 157,
    "position": 0,
    "text": "بدو گفت برزوی کای شهریار"
  },
  {
    "poem_id": 1829,
    "vorder": 158,
    "position": 1,
    "text": "ندارم فزون ز آنچ گویی مدار"
  },
  {
    "poem_id": 1829,
    "vorder": 159,
    "position": 0,
    "text": "کلیله بیاورد گنجور شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 160,
    "position": 1,
    "text": "همی‌بود او را نماینده راه"
  },
  {
    "poem_id": 1829,
    "vorder": 161,
    "position": 0,
    "text": "هران دُر که از نامه برخواندی"
  },
  {
    "poem_id": 1829,
    "vorder": 162,
    "position": 1,
    "text": "همه روز بر دل همی‌راندی"
  },
  {
    "poem_id": 1829,
    "vorder": 163,
    "position": 0,
    "text": "ز نامه فزون ز آنک بودیش یاد"
  },
  {
    "poem_id": 1829,
    "vorder": 164,
    "position": 1,
    "text": "ز برخواندی نیز تا بامداد"
  },
  {
    "poem_id": 1829,
    "vorder": 165,
    "position": 0,
    "text": "همی‌بود شادان دل و تن درست"
  },
  {
    "poem_id": 1829,
    "vorder": 166,
    "position": 1,
    "text": "بدانش همی جان روشن بشست"
  },
  {
    "poem_id": 1829,
    "vorder": 167,
    "position": 0,
    "text": "چو زو نامه رفتی به شاه جهان"
  },
  {
    "poem_id": 1829,
    "vorder": 168,
    "position": 1,
    "text": "دری از کلیله نبشتی نهان"
  },
  {
    "poem_id": 1829,
    "vorder": 169,
    "position": 0,
    "text": "بدین چاره تا نامهٔ هندوان"
  },
  {
    "poem_id": 1829,
    "vorder": 170,
    "position": 1,
    "text": "فرستاد نزدیک نوشین‌روان"
  },
  {
    "poem_id": 1829,
    "vorder": 171,
    "position": 0,
    "text": "بدین گونه تا پاسخ نامه دید"
  },
  {
    "poem_id": 1829,
    "vorder": 172,
    "position": 1,
    "text": "که دریای دانش بر ما رسید"
  },
  {
    "poem_id": 1829,
    "vorder": 173,
    "position": 0,
    "text": "ز ایوان بیامد به نزدیک رای"
  },
  {
    "poem_id": 1829,
    "vorder": 174,
    "position": 1,
    "text": "بدستوری بازگشتن به جای"
  },
  {
    "poem_id": 1829,
    "vorder": 175,
    "position": 0,
    "text": "چو بگشاد دل رای بنواختش"
  },
  {
    "poem_id": 1829,
    "vorder": 176,
    "position": 1,
    "text": "یکی خلعت هندویی ساختش"
  },
  {
    "poem_id": 1829,
    "vorder": 177,
    "position": 0,
    "text": "دو یاره بهاگیر و دو گوشوار"
  },
  {
    "poem_id": 1829,
    "vorder": 178,
    "position": 1,
    "text": "یکی طوق پرگوهر شاهوار"
  },
  {
    "poem_id": 1829,
    "vorder": 179,
    "position": 0,
    "text": "هم از شارهٔ هندی و تیغ هند"
  },
  {
    "poem_id": 1829,
    "vorder": 180,
    "position": 1,
    "text": "همه روی آهن سراسر پرند"
  },
  {
    "poem_id": 1829,
    "vorder": 181,
    "position": 0,
    "text": "بیامد ز قنّوج برزوی شاد"
  },
  {
    "poem_id": 1829,
    "vorder": 182,
    "position": 1,
    "text": "بسی دانشِ نو گرفته به یاد"
  },
  {
    "poem_id": 1829,
    "vorder": 183,
    "position": 0,
    "text": "ز ره چون رسید اندر آن بارگاه"
  },
  {
    "poem_id": 1829,
    "vorder": 184,
    "position": 1,
    "text": "نیایش کنان رفت نزدیک شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 185,
    "position": 0,
    "text": "بگفت آنچ از رای دید و شنید"
  },
  {
    "poem_id": 1829,
    "vorder": 186,
    "position": 1,
    "text": "بجای گیا دانش آمد پدید"
  },
  {
    "poem_id": 1829,
    "vorder": 187,
    "position": 0,
    "text": "بدو گفت شاه‌ ای پسندیده مرد"
  },
  {
    "poem_id": 1829,
    "vorder": 188,
    "position": 1,
    "text": "کلیله روان مرا زنده کرد"
  },
  {
    "poem_id": 1829,
    "vorder": 189,
    "position": 0,
    "text": "تو اکنون ز گنجور بستان کلید"
  },
  {
    "poem_id": 1829,
    "vorder": 190,
    "position": 1,
    "text": "ز چیزی که باید بباید گزید"
  },
  {
    "poem_id": 1829,
    "vorder": 191,
    "position": 0,
    "text": "بیامد خرد یافته سوی گنج"
  },
  {
    "poem_id": 1829,
    "vorder": 192,
    "position": 1,
    "text": "به گنجور بسیار ننمود رنج"
  },
  {
    "poem_id": 1829,
    "vorder": 193,
    "position": 0,
    "text": "درم بود و گوهر چپ و دست راست"
  },
  {
    "poem_id": 1829,
    "vorder": 194,
    "position": 1,
    "text": "جز از جامهٔ شاه چیزی نخواست"
  },
  {
    "poem_id": 1829,
    "vorder": 195,
    "position": 0,
    "text": "گرانمایه دستی بپوشید و رفت"
  },
  {
    "poem_id": 1829,
    "vorder": 196,
    "position": 1,
    "text": "بر گاه کسری خرامید تفت"
  },
  {
    "poem_id": 1829,
    "vorder": 197,
    "position": 0,
    "text": "چو آمد به نزدیک تختش فراز"
  },
  {
    "poem_id": 1829,
    "vorder": 198,
    "position": 1,
    "text": "برو آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1829,
    "vorder": 199,
    "position": 0,
    "text": "بدو گفت پس نامور شهریار"
  },
  {
    "poem_id": 1829,
    "vorder": 200,
    "position": 1,
    "text": "که بی بدره و گوهر شاهوار"
  },
  {
    "poem_id": 1829,
    "vorder": 201,
    "position": 0,
    "text": "چرا رفتی ای رنج دیده ز گنج"
  },
  {
    "poem_id": 1829,
    "vorder": 202,
    "position": 1,
    "text": "کسی را سزد گنج کو دید رنج"
  },
  {
    "poem_id": 1829,
    "vorder": 203,
    "position": 0,
    "text": "چنین پاسخ آورد برزو بشاه"
  },
  {
    "poem_id": 1829,
    "vorder": 204,
    "position": 1,
    "text": "که ای تاج تو برتر از چرخ ماه"
  },
  {
    "poem_id": 1829,
    "vorder": 205,
    "position": 0,
    "text": "هرآنکس که او پوشش شاه یافت"
  },
  {
    "poem_id": 1829,
    "vorder": 206,
    "position": 1,
    "text": "به بخت و به تخت مهی راه یافت"
  },
  {
    "poem_id": 1829,
    "vorder": 207,
    "position": 0,
    "text": "دگر آنک با جامهٔ شهریار"
  },
  {
    "poem_id": 1829,
    "vorder": 208,
    "position": 1,
    "text": "ببیند مرا مرد ناسازگار"
  },
  {
    "poem_id": 1829,
    "vorder": 209,
    "position": 0,
    "text": "دل بدسگالان شود تار و تنگ"
  },
  {
    "poem_id": 1829,
    "vorder": 210,
    "position": 1,
    "text": "بماند رخ دوست با آب و رنگ"
  },
  {
    "poem_id": 1829,
    "vorder": 211,
    "position": 0,
    "text": "یکی آرزو خواهم از شهریار"
  },
  {
    "poem_id": 1829,
    "vorder": 212,
    "position": 1,
    "text": "که ماند ز من در جهان یادگار"
  },
  {
    "poem_id": 1829,
    "vorder": 213,
    "position": 0,
    "text": "چو بنویسد این نامه بوزرجمهر"
  },
  {
    "poem_id": 1829,
    "vorder": 214,
    "position": 1,
    "text": "گشاید برین رنج برزوی چهر"
  },
  {
    "poem_id": 1829,
    "vorder": 215,
    "position": 0,
    "text": "نخستین در از من کند یادگار"
  },
  {
    "poem_id": 1829,
    "vorder": 216,
    "position": 1,
    "text": "به فرمان پیروزگر شهریار"
  },
  {
    "poem_id": 1829,
    "vorder": 217,
    "position": 0,
    "text": "بدان تا پس از مرگ من در جهان"
  },
  {
    "poem_id": 1829,
    "vorder": 218,
    "position": 1,
    "text": "ز داننده رنجم نگردد نهان"
  },
  {
    "poem_id": 1829,
    "vorder": 219,
    "position": 0,
    "text": "بدو گفت شاه این بزرگ آرزوست"
  },
  {
    "poem_id": 1829,
    "vorder": 220,
    "position": 1,
    "text": "بر اندازهٔ مرد آزاده‌خوست"
  },
  {
    "poem_id": 1829,
    "vorder": 221,
    "position": 0,
    "text": "ولیکن به رنج تو اندر خورست"
  },
  {
    "poem_id": 1829,
    "vorder": 222,
    "position": 1,
    "text": "سخن گرچه از پایگه برترست"
  },
  {
    "poem_id": 1829,
    "vorder": 223,
    "position": 0,
    "text": "به بوزرجمهر آن زمان شاه گفت"
  },
  {
    "poem_id": 1829,
    "vorder": 224,
    "position": 1,
    "text": "که این آرزو را نشاید نهفت"
  },
  {
    "poem_id": 1829,
    "vorder": 225,
    "position": 0,
    "text": "نویسنده از کلک چون خامه کرد"
  },
  {
    "poem_id": 1829,
    "vorder": 226,
    "position": 1,
    "text": "ز برزوی یک در سرِ نامه کرد"
  },
  {
    "poem_id": 1829,
    "vorder": 227,
    "position": 0,
    "text": "نبشت او بران نامهٔ خسروی"
  },
  {
    "poem_id": 1829,
    "vorder": 228,
    "position": 1,
    "text": "نبود آن زمان خط جز پهلوی"
  },
  {
    "poem_id": 1829,
    "vorder": 229,
    "position": 0,
    "text": "همی‌بود با ارج در گنج شاه"
  },
  {
    "poem_id": 1829,
    "vorder": 230,
    "position": 1,
    "text": "بدو ناسزا کس نکردی نگاه"
  },
  {
    "poem_id": 1829,
    "vorder": 231,
    "position": 0,
    "text": "چنین تا بتازی سخن راندند"
  },
  {
    "poem_id": 1829,
    "vorder": 232,
    "position": 1,
    "text": "ورا پهلوانی همی‌خواندند"
  },
  {
    "poem_id": 1829,
    "vorder": 233,
    "position": 0,
    "text": "چو مامون روشن روان تازه کرد"
  },
  {
    "poem_id": 1829,
    "vorder": 234,
    "position": 1,
    "text": "خور روز بر دیگر اندازه کرد"
  },
  {
    "poem_id": 1829,
    "vorder": 235,
    "position": 0,
    "text": "دل موبدان داشت و رای کیان"
  },
  {
    "poem_id": 1829,
    "vorder": 236,
    "position": 1,
    "text": "ببسته به هر دانشی بر میان"
  },
  {
    "poem_id": 1829,
    "vorder": 237,
    "position": 0,
    "text": "کلیله به تازی شد از پهلوی"
  },
  {
    "poem_id": 1829,
    "vorder": 238,
    "position": 1,
    "text": "بدین سان که اکنون همی‌بشنوی"
  },
  {
    "poem_id": 1829,
    "vorder": 239,
    "position": 0,
    "text": "بتازی همی‌بود تا گاه نصر"
  },
  {
    "poem_id": 1829,
    "vorder": 240,
    "position": 1,
    "text": "بدانگه که شد در جهان شاه نصر"
  },
  {
    "poem_id": 1829,
    "vorder": 241,
    "position": 0,
    "text": "گرانمایه بوالفضل دستور اوی"
  },
  {
    "poem_id": 1829,
    "vorder": 242,
    "position": 1,
    "text": "که اندر سخن بود گنجور اوی"
  },
  {
    "poem_id": 1829,
    "vorder": 243,
    "position": 0,
    "text": "بفرمود تا پارسی و دری"
  },
  {
    "poem_id": 1829,
    "vorder": 244,
    "position": 1,
    "text": "نبشتند و کوتاه شد داوری"
  },
  {
    "poem_id": 1829,
    "vorder": 245,
    "position": 0,
    "text": "وزان پس چو پیوسته رای آمدش"
  },
  {
    "poem_id": 1829,
    "vorder": 246,
    "position": 1,
    "text": "بدانش خرد رهنمای آمدش"
  },
  {
    "poem_id": 1829,
    "vorder": 247,
    "position": 0,
    "text": "همی‌خواست تا آشکار و نهان"
  },
  {
    "poem_id": 1829,
    "vorder": 248,
    "position": 1,
    "text": "ازو یادگاری بود در جهان"
  },
  {
    "poem_id": 1829,
    "vorder": 249,
    "position": 0,
    "text": "گزارنده را پیش بنشاندند"
  },
  {
    "poem_id": 1829,
    "vorder": 250,
    "position": 1,
    "text": "همه نامه بر رودکی خواندند"
  },
  {
    "poem_id": 1829,
    "vorder": 251,
    "position": 0,
    "text": "بپیوست گویا پراگنده را"
  },
  {
    "poem_id": 1829,
    "vorder": 252,
    "position": 1,
    "text": "بسفت اینچنین در آگنده را"
  },
  {
    "poem_id": 1829,
    "vorder": 253,
    "position": 0,
    "text": "بدان کو سخن راند آرایشست"
  },
  {
    "poem_id": 1829,
    "vorder": 254,
    "position": 1,
    "text": "چو ابله بود جای بخشایشست"
  },
  {
    "poem_id": 1829,
    "vorder": 255,
    "position": 0,
    "text": "حدیث پراگنده بپراگند"
  },
  {
    "poem_id": 1829,
    "vorder": 256,
    "position": 1,
    "text": "چو پیوسته شد جان و مغز آگند"
  },
  {
    "poem_id": 1829,
    "vorder": 257,
    "position": 0,
    "text": "جهاندار تا جاودان زنده باد"
  },
  {
    "poem_id": 1829,
    "vorder": 258,
    "position": 1,
    "text": "زمان و زمین پیش او بنده باد"
  },
  {
    "poem_id": 1829,
    "vorder": 259,
    "position": 0,
    "text": "از اندیشه دل را مدار ایچ تنگ"
  },
  {
    "poem_id": 1829,
    "vorder": 260,
    "position": 1,
    "text": "که دوری تو از روزگار درنگ"
  },
  {
    "poem_id": 1829,
    "vorder": 261,
    "position": 0,
    "text": "گهی بر فراز و گهی بر نشیب"
  },
  {
    "poem_id": 1829,
    "vorder": 262,
    "position": 1,
    "text": "گهی با مراد و گهی با نهیب"
  },
  {
    "poem_id": 1829,
    "vorder": 263,
    "position": 0,
    "text": "ازین دو یکی نیز جاوید نیست"
  },
  {
    "poem_id": 1829,
    "vorder": 264,
    "position": 1,
    "text": "به بودن تو را راه امید نیست"
  },
  {
    "poem_id": 1829,
    "vorder": 265,
    "position": 0,
    "text": "نگه کن کنون کار بوزرجمهر"
  },
  {
    "poem_id": 1829,
    "vorder": 266,
    "position": 1,
    "text": "که از خاک بر شد به گردان سپهر"
  },
  {
    "poem_id": 1829,
    "vorder": 267,
    "position": 0,
    "text": "فراز آوریدش به خاک نژند"
  },
  {
    "poem_id": 1829,
    "vorder": 268,
    "position": 1,
    "text": "همان کس که بردش به ابر بلند"
  }
]