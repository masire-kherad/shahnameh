[
  {
    "poem_id": 1407,
    "vorder": 1,
    "position": 0,
    "text": "پس آنگه ز مرگ منوچهر شاه"
  },
  {
    "poem_id": 1407,
    "vorder": 2,
    "position": 1,
    "text": "بشد آگهی تا به توران سپاه"
  },
  {
    "poem_id": 1407,
    "vorder": 3,
    "position": 0,
    "text": "ز نارفتن کار نوذر همان"
  },
  {
    "poem_id": 1407,
    "vorder": 4,
    "position": 1,
    "text": "یکایک بگفتند با بدگمان"
  },
  {
    "poem_id": 1407,
    "vorder": 5,
    "position": 0,
    "text": "چو بشنید سالار ترکان پشنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 6,
    "position": 1,
    "text": "چنان خواست کاید به ایران به جنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 7,
    "position": 0,
    "text": "یکی یاد کرد از نیا زادشم"
  },
  {
    "poem_id": 1407,
    "vorder": 8,
    "position": 1,
    "text": "هم از تور بر زد یکی تیز دم"
  },
  {
    "poem_id": 1407,
    "vorder": 9,
    "position": 0,
    "text": "ز کار منوچهر و از لشکرش"
  },
  {
    "poem_id": 1407,
    "vorder": 10,
    "position": 1,
    "text": "ز گردان و سالار و از کشورش"
  },
  {
    "poem_id": 1407,
    "vorder": 11,
    "position": 0,
    "text": "همه نامداران کشورش را"
  },
  {
    "poem_id": 1407,
    "vorder": 12,
    "position": 1,
    "text": "بخواند و بزرگان لشکرش را"
  },
  {
    "poem_id": 1407,
    "vorder": 13,
    "position": 0,
    "text": "چو ارجسپ و گرسیوز و بارمان"
  },
  {
    "poem_id": 1407,
    "vorder": 14,
    "position": 1,
    "text": "چو کلباد جنگی هژبر دمان"
  },
  {
    "poem_id": 1407,
    "vorder": 15,
    "position": 0,
    "text": "سپهبدش چون ویسهٔ تیزچنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 16,
    "position": 1,
    "text": "که سالار بد بر سپاه پشنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 17,
    "position": 0,
    "text": "جهان پهلوان پورش افراسیاب"
  },
  {
    "poem_id": 1407,
    "vorder": 18,
    "position": 1,
    "text": "بخواندش درنگی و آمد شتاب"
  },
  {
    "poem_id": 1407,
    "vorder": 19,
    "position": 0,
    "text": "سخن راند از تور و از سلم گفت"
  },
  {
    "poem_id": 1407,
    "vorder": 20,
    "position": 1,
    "text": "که کین زیر دامن نشاید نهفت"
  },
  {
    "poem_id": 1407,
    "vorder": 21,
    "position": 0,
    "text": "کسی را کجا مغز جوشیده نیست"
  },
  {
    "poem_id": 1407,
    "vorder": 22,
    "position": 1,
    "text": "برو بر چنین کار پوشیده نیست"
  },
  {
    "poem_id": 1407,
    "vorder": 23,
    "position": 0,
    "text": "که با ما چه کردند ایرانیان"
  },
  {
    "poem_id": 1407,
    "vorder": 24,
    "position": 1,
    "text": "بدی را ببستند یک یک میان"
  },
  {
    "poem_id": 1407,
    "vorder": 25,
    "position": 0,
    "text": "کنون روز تندی و کین جستنست"
  },
  {
    "poem_id": 1407,
    "vorder": 26,
    "position": 1,
    "text": "رخ از خون دیده گه شستنست"
  },
  {
    "poem_id": 1407,
    "vorder": 27,
    "position": 0,
    "text": "ز گفت پدر مغز افراسیاب"
  },
  {
    "poem_id": 1407,
    "vorder": 28,
    "position": 1,
    "text": "برآمد ز آرام وز خورد و خواب"
  },
  {
    "poem_id": 1407,
    "vorder": 29,
    "position": 0,
    "text": "به پیش پدر شد گشاده زبان"
  },
  {
    "poem_id": 1407,
    "vorder": 30,
    "position": 1,
    "text": "دل آگنده از کین کمر برمیان"
  },
  {
    "poem_id": 1407,
    "vorder": 31,
    "position": 0,
    "text": "که شایستهٔ جنگ شیران منم"
  },
  {
    "poem_id": 1407,
    "vorder": 32,
    "position": 1,
    "text": "هم‌آورد سالار ایران منم"
  },
  {
    "poem_id": 1407,
    "vorder": 33,
    "position": 0,
    "text": "اگر زادشم تیغ برداشتی"
  },
  {
    "poem_id": 1407,
    "vorder": 34,
    "position": 1,
    "text": "جهان را به گرشاسپ نگذاشتی"
  },
  {
    "poem_id": 1407,
    "vorder": 35,
    "position": 0,
    "text": "میان را ببستی به کین آوری"
  },
  {
    "poem_id": 1407,
    "vorder": 36,
    "position": 1,
    "text": "بایران نکردی مگر سروری"
  },
  {
    "poem_id": 1407,
    "vorder": 37,
    "position": 0,
    "text": "کنون هرچه مانیده بود از نیا"
  },
  {
    "poem_id": 1407,
    "vorder": 38,
    "position": 1,
    "text": "ز کین جستن و چاره و کیمیا"
  },
  {
    "poem_id": 1407,
    "vorder": 39,
    "position": 0,
    "text": "گشادنش بر تیغ تیز منست"
  },
  {
    "poem_id": 1407,
    "vorder": 40,
    "position": 1,
    "text": "گه شورش و رستخیز منست"
  },
  {
    "poem_id": 1407,
    "vorder": 41,
    "position": 0,
    "text": "به مغز پشنگ اندر آمد شتاب"
  },
  {
    "poem_id": 1407,
    "vorder": 42,
    "position": 1,
    "text": "چو دید آن سهی قد افراسیاب"
  },
  {
    "poem_id": 1407,
    "vorder": 43,
    "position": 0,
    "text": "بر و بازوی شیر و هم زور پیل"
  },
  {
    "poem_id": 1407,
    "vorder": 44,
    "position": 1,
    "text": "وزو سایه گسترده بر چند میل"
  },
  {
    "poem_id": 1407,
    "vorder": 45,
    "position": 0,
    "text": "زبانش به کردار برنده تیغ"
  },
  {
    "poem_id": 1407,
    "vorder": 46,
    "position": 1,
    "text": "چو دریا دل و کف چو بارنده میغ"
  },
  {
    "poem_id": 1407,
    "vorder": 47,
    "position": 0,
    "text": "بفرمود تا برکشد تیغ جنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 48,
    "position": 1,
    "text": "به ایران شود با سپاه پشنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 49,
    "position": 0,
    "text": "سپهبد چو شایسته بیند پسر"
  },
  {
    "poem_id": 1407,
    "vorder": 50,
    "position": 1,
    "text": "سزد گر برآرد به خورشید سر"
  },
  {
    "poem_id": 1407,
    "vorder": 51,
    "position": 0,
    "text": "پس از مرگ باشد سر او به جای"
  },
  {
    "poem_id": 1407,
    "vorder": 52,
    "position": 1,
    "text": "ازیرا پسر نام زد رهنمای"
  },
  {
    "poem_id": 1407,
    "vorder": 53,
    "position": 0,
    "text": "چو شد ساخته کار جنگ آزمای"
  },
  {
    "poem_id": 1407,
    "vorder": 54,
    "position": 1,
    "text": "به کاخ آمد اغریرث رهنمای"
  },
  {
    "poem_id": 1407,
    "vorder": 55,
    "position": 0,
    "text": "به پیش پدر شد پراندیشه دل"
  },
  {
    "poem_id": 1407,
    "vorder": 56,
    "position": 1,
    "text": "که اندیشه دارد همی پیشه دل"
  },
  {
    "poem_id": 1407,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت کای کار دیده پدر"
  },
  {
    "poem_id": 1407,
    "vorder": 58,
    "position": 1,
    "text": "ز ترکان به مردی برآورده سر"
  },
  {
    "poem_id": 1407,
    "vorder": 59,
    "position": 0,
    "text": "منوچهر از ایران اگر کم شدست"
  },
  {
    "poem_id": 1407,
    "vorder": 60,
    "position": 1,
    "text": "سپهدار چون سام نیرم شدست"
  },
  {
    "poem_id": 1407,
    "vorder": 61,
    "position": 0,
    "text": "چو گرشاسپ و چون قارن رزم زن"
  },
  {
    "poem_id": 1407,
    "vorder": 62,
    "position": 1,
    "text": "جز این نامداران آن انجمن"
  },
  {
    "poem_id": 1407,
    "vorder": 63,
    "position": 0,
    "text": "تو دانی که با سلم و تور سترگ"
  },
  {
    "poem_id": 1407,
    "vorder": 64,
    "position": 1,
    "text": "چه آمد ازان تیغ زن پیر گرگ؟"
  },
  {
    "poem_id": 1407,
    "vorder": 65,
    "position": 0,
    "text": "نیا زادشم شاه توران سپاه"
  },
  {
    "poem_id": 1407,
    "vorder": 66,
    "position": 1,
    "text": "که ترگش همی سود بر چرخ و ماه"
  },
  {
    "poem_id": 1407,
    "vorder": 67,
    "position": 0,
    "text": "ازین در سخن هیچ گونه نراند"
  },
  {
    "poem_id": 1407,
    "vorder": 68,
    "position": 1,
    "text": "به آرام بر نامهٔ کین نخواند"
  },
  {
    "poem_id": 1407,
    "vorder": 69,
    "position": 0,
    "text": "اگر ما نشوریم بهتر بود"
  },
  {
    "poem_id": 1407,
    "vorder": 70,
    "position": 1,
    "text": "کزین جنبش آشوب کشور بود"
  },
  {
    "poem_id": 1407,
    "vorder": 71,
    "position": 0,
    "text": "پسر را چنین داد پاسخ پشنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 72,
    "position": 1,
    "text": "که افراسیاب آن دلاور نهنگ"
  },
  {
    "poem_id": 1407,
    "vorder": 73,
    "position": 0,
    "text": "یکی نره شیرست روز شکار"
  },
  {
    "poem_id": 1407,
    "vorder": 74,
    "position": 1,
    "text": "یکی پیل جنگی گه کارزار"
  },
  {
    "poem_id": 1407,
    "vorder": 75,
    "position": 0,
    "text": "ترا نیز با او بباید شدن"
  },
  {
    "poem_id": 1407,
    "vorder": 76,
    "position": 1,
    "text": "به هر بیش و کم رای فرخ زدن"
  },
  {
    "poem_id": 1407,
    "vorder": 77,
    "position": 0,
    "text": "نبیره که کین نیا را نجست"
  },
  {
    "poem_id": 1407,
    "vorder": 78,
    "position": 1,
    "text": "سزد گر نخوانی نژادش درست"
  },
  {
    "poem_id": 1407,
    "vorder": 79,
    "position": 0,
    "text": "چو از دامن ابر چین کم شود"
  },
  {
    "poem_id": 1407,
    "vorder": 80,
    "position": 1,
    "text": "بیابان ز باران پر از نم شود"
  },
  {
    "poem_id": 1407,
    "vorder": 81,
    "position": 0,
    "text": "چراگاه اسپان شود کوه و دشت"
  },
  {
    "poem_id": 1407,
    "vorder": 82,
    "position": 1,
    "text": "گیاها ز یال یلان برگذشت"
  },
  {
    "poem_id": 1407,
    "vorder": 83,
    "position": 0,
    "text": "جهان سر به سر سبز گردد ز خوید"
  },
  {
    "poem_id": 1407,
    "vorder": 84,
    "position": 1,
    "text": "به هامون سراپرده باید کشید"
  },
  {
    "poem_id": 1407,
    "vorder": 85,
    "position": 0,
    "text": "سپه را همه سوی آمل براند"
  },
  {
    "poem_id": 1407,
    "vorder": 86,
    "position": 1,
    "text": "دلی شاد بر سبزه و گل براند"
  },
  {
    "poem_id": 1407,
    "vorder": 87,
    "position": 0,
    "text": "دهستان و گرگان همه زیر نعل"
  },
  {
    "poem_id": 1407,
    "vorder": 88,
    "position": 1,
    "text": "بکوبید وز خون کنید آب لعل"
  },
  {
    "poem_id": 1407,
    "vorder": 89,
    "position": 0,
    "text": "منوچهر از آن جایگه جنگجوی"
  },
  {
    "poem_id": 1407,
    "vorder": 90,
    "position": 1,
    "text": "به کینه سوی تور بنهاد روی"
  },
  {
    "poem_id": 1407,
    "vorder": 91,
    "position": 0,
    "text": "بکوشید با قارن رزم زن"
  },
  {
    "poem_id": 1407,
    "vorder": 92,
    "position": 1,
    "text": "دگر گرد گرشاسپ زان انجمن"
  },
  {
    "poem_id": 1407,
    "vorder": 93,
    "position": 0,
    "text": "مگر دست یابید بر دشت کین"
  },
  {
    "poem_id": 1407,
    "vorder": 94,
    "position": 1,
    "text": "برین دو سرافراز ایران زمین"
  },
  {
    "poem_id": 1407,
    "vorder": 95,
    "position": 0,
    "text": "روان نیاگان ما خوش کنید"
  },
  {
    "poem_id": 1407,
    "vorder": 96,
    "position": 1,
    "text": "دل بدسگالان پرآتش کنید"
  },
  {
    "poem_id": 1407,
    "vorder": 97,
    "position": 0,
    "text": "چنین گفت با نامور نامجوی"
  },
  {
    "poem_id": 1407,
    "vorder": 98,
    "position": 1,
    "text": "که من خون به کین اندر آرم به جوی"
  }
]