[
  {
    "poem_id": 88000,
    "vorder": 1,
    "position": 0,
    "text": "یکی خویش کاموس بد ساوه نام"
  },
  {
    "poem_id": 88000,
    "vorder": 2,
    "position": 1,
    "text": "سرافراز و هر جای گسترده کام"
  },
  {
    "poem_id": 88000,
    "vorder": 3,
    "position": 0,
    "text": "بیامد بپیش تهمتن بجنگ"
  },
  {
    "poem_id": 88000,
    "vorder": 4,
    "position": 1,
    "text": "یکی تیغ هندی گرفته بچنگ"
  },
  {
    "poem_id": 88000,
    "vorder": 5,
    "position": 0,
    "text": "بگردید گرد چپ و دست راست"
  },
  {
    "poem_id": 88000,
    "vorder": 6,
    "position": 1,
    "text": "ز رستم همی کین کاموس خواست"
  },
  {
    "poem_id": 88000,
    "vorder": 7,
    "position": 0,
    "text": "برستم چنین گفت کای ژنده پیل"
  },
  {
    "poem_id": 88000,
    "vorder": 8,
    "position": 1,
    "text": "ببینی کنون موج دریای نیل"
  },
  {
    "poem_id": 88000,
    "vorder": 9,
    "position": 0,
    "text": "بخواهم کنون کین کاموس خوار"
  },
  {
    "poem_id": 88000,
    "vorder": 10,
    "position": 1,
    "text": "اگر باشدم زین سپس کارزار"
  },
  {
    "poem_id": 88000,
    "vorder": 11,
    "position": 0,
    "text": "چو گفتار ساوه برستم رسید"
  },
  {
    "poem_id": 88000,
    "vorder": 12,
    "position": 1,
    "text": "بزد دست و گرز گران برکشید"
  },
  {
    "poem_id": 88000,
    "vorder": 13,
    "position": 0,
    "text": "بزد بر سرش گرز را پیلتن"
  },
  {
    "poem_id": 88000,
    "vorder": 14,
    "position": 1,
    "text": "که جانش برون شد بزاری ز تن"
  },
  {
    "poem_id": 88000,
    "vorder": 15,
    "position": 0,
    "text": "برآورد و زد بر سر و مغفرش"
  },
  {
    "poem_id": 88000,
    "vorder": 16,
    "position": 1,
    "text": "ندیدست گفتی تنش را سرش"
  },
  {
    "poem_id": 88000,
    "vorder": 17,
    "position": 0,
    "text": "بیفگند و رخش از بر او براند"
  },
  {
    "poem_id": 88000,
    "vorder": 18,
    "position": 1,
    "text": "ز ساوه بگیتی نشانی نماند"
  },
  {
    "poem_id": 88000,
    "vorder": 19,
    "position": 0,
    "text": "درفش کشانی نگونسار کرد"
  },
  {
    "poem_id": 88000,
    "vorder": 20,
    "position": 1,
    "text": "و زو جان لشکر پرآزار کرد"
  },
  {
    "poem_id": 88000,
    "vorder": 21,
    "position": 0,
    "text": "نبد نیز کس پیش او پایدار"
  },
  {
    "poem_id": 88000,
    "vorder": 22,
    "position": 1,
    "text": "همه خاک مغز سر آورد بار"
  },
  {
    "poem_id": 88000,
    "vorder": 23,
    "position": 0,
    "text": "پس از میمنه شد سوی میسره"
  },
  {
    "poem_id": 88000,
    "vorder": 24,
    "position": 1,
    "text": "غمی گشت لشکر همه یکسره"
  }
]