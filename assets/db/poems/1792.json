[
  {
    "poem_id": 1792,
    "vorder": 1,
    "position": 0,
    "text": "چو شد کار توران زمین ساخته"
  },
  {
    "poem_id": 1792,
    "vorder": 2,
    "position": 1,
    "text": "دل شاه ز اندیشه پرداخته"
  },
  {
    "poem_id": 1792,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1792,
    "vorder": 4,
    "position": 1,
    "text": "قلم خواست با مشک و چینی حریر"
  },
  {
    "poem_id": 1792,
    "vorder": 5,
    "position": 0,
    "text": "به نرسی یکی نامه فرمود شاه"
  },
  {
    "poem_id": 1792,
    "vorder": 6,
    "position": 1,
    "text": "ز پیکار ترکان و کار سپاه"
  },
  {
    "poem_id": 1792,
    "vorder": 7,
    "position": 0,
    "text": "سر نامه کرد آفرین نهان"
  },
  {
    "poem_id": 1792,
    "vorder": 8,
    "position": 1,
    "text": "ازین بنده بر کردگار جهان"
  },
  {
    "poem_id": 1792,
    "vorder": 9,
    "position": 0,
    "text": "خداوند پیروزی و دستگاه"
  },
  {
    "poem_id": 1792,
    "vorder": 10,
    "position": 1,
    "text": "خداوند بهرام و کیوان و ماه"
  },
  {
    "poem_id": 1792,
    "vorder": 11,
    "position": 0,
    "text": "خداوند گردنده چرخ بلند"
  },
  {
    "poem_id": 1792,
    "vorder": 12,
    "position": 1,
    "text": "خداوند ارمنده خاک نژند"
  },
  {
    "poem_id": 1792,
    "vorder": 13,
    "position": 0,
    "text": "بزرگی و خردی به پیمان اوست"
  },
  {
    "poem_id": 1792,
    "vorder": 14,
    "position": 1,
    "text": "همه بودنی زیر فرمان اوست"
  },
  {
    "poem_id": 1792,
    "vorder": 15,
    "position": 0,
    "text": "نوشتم یکی نامه از مرز چین"
  },
  {
    "poem_id": 1792,
    "vorder": 16,
    "position": 1,
    "text": "به نزد برادر به ایران زمین"
  },
  {
    "poem_id": 1792,
    "vorder": 17,
    "position": 0,
    "text": "به نزد بزرگان ایرانیان"
  },
  {
    "poem_id": 1792,
    "vorder": 18,
    "position": 1,
    "text": "نوشتن همین نامه بر پرنیان"
  },
  {
    "poem_id": 1792,
    "vorder": 19,
    "position": 0,
    "text": "هرانکس که او رزم خاقان ندید"
  },
  {
    "poem_id": 1792,
    "vorder": 20,
    "position": 1,
    "text": "ازین جنگجویان بباید شنید"
  },
  {
    "poem_id": 1792,
    "vorder": 21,
    "position": 0,
    "text": "سپه بود چندانک گفتی سپهر"
  },
  {
    "poem_id": 1792,
    "vorder": 22,
    "position": 1,
    "text": "ز گردش به قیر اندر اندود چهر"
  },
  {
    "poem_id": 1792,
    "vorder": 23,
    "position": 0,
    "text": "همه مرز شد همچو دریای خون"
  },
  {
    "poem_id": 1792,
    "vorder": 24,
    "position": 1,
    "text": "سر بخت بیداد گشته نگون"
  },
  {
    "poem_id": 1792,
    "vorder": 25,
    "position": 0,
    "text": "به رزم اندرون او گرفتار شد"
  },
  {
    "poem_id": 1792,
    "vorder": 26,
    "position": 1,
    "text": "وزو چرخ گردنده بیزار شد"
  },
  {
    "poem_id": 1792,
    "vorder": 27,
    "position": 0,
    "text": "کنون بسته آوردمش بر هیون"
  },
  {
    "poem_id": 1792,
    "vorder": 28,
    "position": 1,
    "text": "جگر خسته و دیدگان پر ز خون"
  },
  {
    "poem_id": 1792,
    "vorder": 29,
    "position": 0,
    "text": "همه گردن سرکشان گشت نرم"
  },
  {
    "poem_id": 1792,
    "vorder": 30,
    "position": 1,
    "text": "زبان چرب و دلها پر از خون گرم"
  },
  {
    "poem_id": 1792,
    "vorder": 31,
    "position": 0,
    "text": "پذیرفت باژ آنک بدخواه بود"
  },
  {
    "poem_id": 1792,
    "vorder": 32,
    "position": 1,
    "text": "به راه آمدند آنک بی‌راه بود"
  },
  {
    "poem_id": 1792,
    "vorder": 33,
    "position": 0,
    "text": "کنون از پس نامه من با سپاه"
  },
  {
    "poem_id": 1792,
    "vorder": 34,
    "position": 1,
    "text": "بیایم به کام دل نیک‌خواه"
  },
  {
    "poem_id": 1792,
    "vorder": 35,
    "position": 0,
    "text": "هیونان کفک‌افگن بادپای"
  },
  {
    "poem_id": 1792,
    "vorder": 36,
    "position": 1,
    "text": "برفتند چون ابر غران ز جای"
  },
  {
    "poem_id": 1792,
    "vorder": 37,
    "position": 0,
    "text": "چو نامه به نزدیک نرسی رسید"
  },
  {
    "poem_id": 1792,
    "vorder": 38,
    "position": 1,
    "text": "ز شادی دل پادشا بردمید"
  },
  {
    "poem_id": 1792,
    "vorder": 39,
    "position": 0,
    "text": "بشد موبد موبدان پیش اوی"
  },
  {
    "poem_id": 1792,
    "vorder": 40,
    "position": 1,
    "text": "هرانکس که بود از یلان جنگ جوی"
  },
  {
    "poem_id": 1792,
    "vorder": 41,
    "position": 0,
    "text": "به شادی برآمد ز ایران خروش"
  },
  {
    "poem_id": 1792,
    "vorder": 42,
    "position": 1,
    "text": "نهادند هر یک به آواز گوش"
  },
  {
    "poem_id": 1792,
    "vorder": 43,
    "position": 0,
    "text": "دل نامداران ز تشویر شاه"
  },
  {
    "poem_id": 1792,
    "vorder": 44,
    "position": 1,
    "text": "همی بود پیچان ز بهر گناه"
  },
  {
    "poem_id": 1792,
    "vorder": 45,
    "position": 0,
    "text": "به پوزش به نزدیک موبد شدند"
  },
  {
    "poem_id": 1792,
    "vorder": 46,
    "position": 1,
    "text": "همه دل‌هراسان ز هر بد شدند"
  },
  {
    "poem_id": 1792,
    "vorder": 47,
    "position": 0,
    "text": "کز اندیشه کژ و فرمان دیو"
  },
  {
    "poem_id": 1792,
    "vorder": 48,
    "position": 1,
    "text": "ببرد دل از راه گیهان خدیو"
  },
  {
    "poem_id": 1792,
    "vorder": 49,
    "position": 0,
    "text": "بدان مایه لشکر که برد این گمان"
  },
  {
    "poem_id": 1792,
    "vorder": 50,
    "position": 1,
    "text": "که یزدان گشاید در آسمان"
  },
  {
    "poem_id": 1792,
    "vorder": 51,
    "position": 0,
    "text": "شگفتیست این کز گمان بگذرد"
  },
  {
    "poem_id": 1792,
    "vorder": 52,
    "position": 1,
    "text": "هم از رای داننده مرد خرد"
  },
  {
    "poem_id": 1792,
    "vorder": 53,
    "position": 0,
    "text": "چو پاسخ شود نامه بر خوب و زشت"
  },
  {
    "poem_id": 1792,
    "vorder": 54,
    "position": 1,
    "text": "همین پوزش ما بباید نوشت"
  },
  {
    "poem_id": 1792,
    "vorder": 55,
    "position": 0,
    "text": "که گر چند رفت از برزگان گناه"
  },
  {
    "poem_id": 1792,
    "vorder": 56,
    "position": 1,
    "text": "ببخشد مگر نامبردار شاه"
  },
  {
    "poem_id": 1792,
    "vorder": 57,
    "position": 0,
    "text": "بپذرفت نرسی که ایدون کنم"
  },
  {
    "poem_id": 1792,
    "vorder": 58,
    "position": 1,
    "text": "که کین از دل شاه بیرون کنم"
  },
  {
    "poem_id": 1792,
    "vorder": 59,
    "position": 0,
    "text": "پس آن نامه را زود پاسخ نوشت"
  },
  {
    "poem_id": 1792,
    "vorder": 60,
    "position": 1,
    "text": "پدیدار کرد اندرو خوب و زشت"
  },
  {
    "poem_id": 1792,
    "vorder": 61,
    "position": 0,
    "text": "که ایرانیان از پی درد و رنج"
  },
  {
    "poem_id": 1792,
    "vorder": 62,
    "position": 1,
    "text": "همان از پی بوم و فرزند و گنج"
  },
  {
    "poem_id": 1792,
    "vorder": 63,
    "position": 0,
    "text": "گرفتند خاقان چین را پناه"
  },
  {
    "poem_id": 1792,
    "vorder": 64,
    "position": 1,
    "text": "به نومیدی از نامبردار شاه"
  },
  {
    "poem_id": 1792,
    "vorder": 65,
    "position": 0,
    "text": "نه از دشمنی بد نه از درد و کین"
  },
  {
    "poem_id": 1792,
    "vorder": 66,
    "position": 1,
    "text": "نه بر شاه بودست کس را گزین"
  },
  {
    "poem_id": 1792,
    "vorder": 67,
    "position": 0,
    "text": "یکی مهتری نام او برزمهر"
  },
  {
    "poem_id": 1792,
    "vorder": 68,
    "position": 1,
    "text": "بدان رفتن راه بگشاد چهر"
  },
  {
    "poem_id": 1792,
    "vorder": 69,
    "position": 0,
    "text": "بیامد به نزدیک شاه جهان"
  },
  {
    "poem_id": 1792,
    "vorder": 70,
    "position": 1,
    "text": "همه رازها برگشاد از نهان"
  },
  {
    "poem_id": 1792,
    "vorder": 71,
    "position": 0,
    "text": "ز گفتار او شاه خشنود گشت"
  },
  {
    "poem_id": 1792,
    "vorder": 72,
    "position": 1,
    "text": "چنین آتش تیز بی‌دود گشت"
  },
  {
    "poem_id": 1792,
    "vorder": 73,
    "position": 0,
    "text": "چغانی و چگلی و بلخی ردان"
  },
  {
    "poem_id": 1792,
    "vorder": 74,
    "position": 1,
    "text": "بخاری و از غرجگان موبدان"
  },
  {
    "poem_id": 1792,
    "vorder": 75,
    "position": 0,
    "text": "برفتند با باژ و برسم به دست"
  },
  {
    "poem_id": 1792,
    "vorder": 76,
    "position": 1,
    "text": "نیایش کنان پیش آتش‌پرست"
  },
  {
    "poem_id": 1792,
    "vorder": 77,
    "position": 0,
    "text": "که ما شاه را یکسره بنده‌ایم"
  },
  {
    "poem_id": 1792,
    "vorder": 78,
    "position": 1,
    "text": "همان باژ را گردن افگنده‌ایم"
  },
  {
    "poem_id": 1792,
    "vorder": 79,
    "position": 0,
    "text": "همان نیز هر سال با باژ و ساو"
  },
  {
    "poem_id": 1792,
    "vorder": 80,
    "position": 1,
    "text": "به درگه شدی هرک بودیش تاو"
  }
]