[
  {
    "poem_id": 1477,
    "vorder": 1,
    "position": 0,
    "text": "به گودرز گفت آن زمان پهلوان"
  },
  {
    "poem_id": 1477,
    "vorder": 2,
    "position": 1,
    "text": "کز ایدر برو زود روشن روان"
  },
  {
    "poem_id": 1477,
    "vorder": 3,
    "position": 0,
    "text": "پیامی ز من پیش کاووس بر"
  },
  {
    "poem_id": 1477,
    "vorder": 4,
    "position": 1,
    "text": "بگویش که مارا چه آمد به سر"
  },
  {
    "poem_id": 1477,
    "vorder": 5,
    "position": 0,
    "text": "به دشنه جگرگاه پور دلیر"
  },
  {
    "poem_id": 1477,
    "vorder": 6,
    "position": 1,
    "text": "دریدم که رستم مماناد دیر"
  },
  {
    "poem_id": 1477,
    "vorder": 7,
    "position": 0,
    "text": "گرت هیچ یادست کردار من"
  },
  {
    "poem_id": 1477,
    "vorder": 8,
    "position": 1,
    "text": "یکی رنجه کن دل به تیمار من"
  },
  {
    "poem_id": 1477,
    "vorder": 9,
    "position": 0,
    "text": "ازان نوشدارو که در گنج تست"
  },
  {
    "poem_id": 1477,
    "vorder": 10,
    "position": 1,
    "text": "کجا خستگان را کند تن درست"
  },
  {
    "poem_id": 1477,
    "vorder": 11,
    "position": 0,
    "text": "به نزدیک من با یکی جام می"
  },
  {
    "poem_id": 1477,
    "vorder": 12,
    "position": 1,
    "text": "سزد گر فرستی هم اکنون به پی"
  },
  {
    "poem_id": 1477,
    "vorder": 13,
    "position": 0,
    "text": "مگر کاو ببخت تو بهتر شود"
  },
  {
    "poem_id": 1477,
    "vorder": 14,
    "position": 1,
    "text": "چو من پیش تخت تو کهتر شود"
  },
  {
    "poem_id": 1477,
    "vorder": 15,
    "position": 0,
    "text": "بیامد سپهبد بکردار باد"
  },
  {
    "poem_id": 1477,
    "vorder": 16,
    "position": 1,
    "text": "به کاووس یکسر پیامش بداد"
  },
  {
    "poem_id": 1477,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت کاووس کز انجمن"
  },
  {
    "poem_id": 1477,
    "vorder": 18,
    "position": 1,
    "text": "اگر زنده ماند چنان پیلتن"
  },
  {
    "poem_id": 1477,
    "vorder": 19,
    "position": 0,
    "text": "شود پشت رستم به نیرو ترا"
  },
  {
    "poem_id": 1477,
    "vorder": 20,
    "position": 1,
    "text": "هلاک آورد بی‌گمانی مرا"
  },
  {
    "poem_id": 1477,
    "vorder": 21,
    "position": 0,
    "text": "اگر یک زمان زو به من بد رسد"
  },
  {
    "poem_id": 1477,
    "vorder": 22,
    "position": 1,
    "text": "نسازیم پاداش او جز به بد"
  },
  {
    "poem_id": 1477,
    "vorder": 23,
    "position": 0,
    "text": "کجا گنجد او در جهان فراخ"
  },
  {
    "poem_id": 1477,
    "vorder": 24,
    "position": 1,
    "text": "بدان فر و آن برز و آن یال و شاخ"
  },
  {
    "poem_id": 1477,
    "vorder": 25,
    "position": 0,
    "text": "شنیدی که او گفت کاووس کیست"
  },
  {
    "poem_id": 1477,
    "vorder": 26,
    "position": 1,
    "text": "گر او شهریارست پس طوس کیست"
  },
  {
    "poem_id": 1477,
    "vorder": 27,
    "position": 0,
    "text": "کجا باشد او پیش تختم به پای"
  },
  {
    "poem_id": 1477,
    "vorder": 28,
    "position": 1,
    "text": "کجا راند او زیر فر همای"
  },
  {
    "poem_id": 1477,
    "vorder": 29,
    "position": 0,
    "text": "چو بشنید گودرز برگشت زود"
  },
  {
    "poem_id": 1477,
    "vorder": 30,
    "position": 1,
    "text": "بر رستم آمد به کردار دود"
  },
  {
    "poem_id": 1477,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت خوی بد شهریار"
  },
  {
    "poem_id": 1477,
    "vorder": 32,
    "position": 1,
    "text": "درختیست خنگی همیشه به بار"
  },
  {
    "poem_id": 1477,
    "vorder": 33,
    "position": 0,
    "text": "ترا رفت باید به نزدیک او"
  },
  {
    "poem_id": 1477,
    "vorder": 34,
    "position": 1,
    "text": "درفشان کنی جان تاریک او"
  }
]