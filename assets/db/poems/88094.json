[
  {
    "poem_id": 88094,
    "vorder": 1,
    "position": 0,
    "text": "چو کیخسرو آن گفت ایشان شنید"
  },
  {
    "poem_id": 88094,
    "vorder": 2,
    "position": 1,
    "text": "زمانی بیاسود و اندر شمید"
  },
  {
    "poem_id": 88094,
    "vorder": 3,
    "position": 0,
    "text": "پراندیشه گفت ای جهاندیده زال"
  },
  {
    "poem_id": 88094,
    "vorder": 4,
    "position": 1,
    "text": "به مردی بی‌اندازه پیموده سال"
  },
  {
    "poem_id": 88094,
    "vorder": 5,
    "position": 0,
    "text": "اگر سرد گویمت بر انجمن"
  },
  {
    "poem_id": 88094,
    "vorder": 6,
    "position": 1,
    "text": "جهاندار نپسندد این بد ز من"
  },
  {
    "poem_id": 88094,
    "vorder": 7,
    "position": 0,
    "text": "دگر آن که رستم شود دردمند"
  },
  {
    "poem_id": 88094,
    "vorder": 8,
    "position": 1,
    "text": "ز درد وی آید به ایران گزند"
  },
  {
    "poem_id": 88094,
    "vorder": 9,
    "position": 0,
    "text": "دگر آن که گر بشمری رنج اوی"
  },
  {
    "poem_id": 88094,
    "vorder": 10,
    "position": 1,
    "text": "همانا فزون آید از گنج اوی"
  },
  {
    "poem_id": 88094,
    "vorder": 11,
    "position": 0,
    "text": "سپر کرد پیشم تن خویش را"
  },
  {
    "poem_id": 88094,
    "vorder": 12,
    "position": 1,
    "text": "نبد خواب و خوردن بداندیش را"
  },
  {
    "poem_id": 88094,
    "vorder": 13,
    "position": 0,
    "text": "همان پاسخت را به خوبی کنیم"
  },
  {
    "poem_id": 88094,
    "vorder": 14,
    "position": 1,
    "text": "دلت را به گفتار تو نشکنیم"
  },
  {
    "poem_id": 88094,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت زآن پس به آواز سخت"
  },
  {
    "poem_id": 88094,
    "vorder": 16,
    "position": 1,
    "text": "که ای سرفرازان پیروز بخت"
  },
  {
    "poem_id": 88094,
    "vorder": 17,
    "position": 0,
    "text": "سخنهای دستان شنیدم همه"
  },
  {
    "poem_id": 88094,
    "vorder": 18,
    "position": 1,
    "text": "که بیدار بگشاد پیش رمه"
  },
  {
    "poem_id": 88094,
    "vorder": 19,
    "position": 0,
    "text": "به دارنده یزدان گیهان خدیو"
  },
  {
    "poem_id": 88094,
    "vorder": 20,
    "position": 1,
    "text": "که من دورم از راه و فرمان دیو"
  },
  {
    "poem_id": 88094,
    "vorder": 21,
    "position": 0,
    "text": "به یزدان گراید همی جان من"
  },
  {
    "poem_id": 88094,
    "vorder": 22,
    "position": 1,
    "text": "که آن دیدم از رنج درمان من"
  },
  {
    "poem_id": 88094,
    "vorder": 23,
    "position": 0,
    "text": "بدید آن جهان را دل روشنم"
  },
  {
    "poem_id": 88094,
    "vorder": 24,
    "position": 1,
    "text": "خرد شد ز بدهای او جوشنم"
  },
  {
    "poem_id": 88094,
    "vorder": 25,
    "position": 0,
    "text": "به زال آنگهی گفت تندی مکن"
  },
  {
    "poem_id": 88094,
    "vorder": 26,
    "position": 1,
    "text": "بر اندازه باید که رانی سخن"
  },
  {
    "poem_id": 88094,
    "vorder": 27,
    "position": 0,
    "text": "نخست آن دکه گفتی ز توران‌نژاد"
  },
  {
    "poem_id": 88094,
    "vorder": 28,
    "position": 1,
    "text": "خردمند و بیدار هرگز نزاد"
  },
  {
    "poem_id": 88094,
    "vorder": 29,
    "position": 0,
    "text": "جهاندار پور سیاوش منم"
  },
  {
    "poem_id": 88094,
    "vorder": 30,
    "position": 1,
    "text": "ز تخم کیان راد و باهش منم"
  },
  {
    "poem_id": 88094,
    "vorder": 31,
    "position": 0,
    "text": "نبیرهٔ جهاندار کاووس کی"
  },
  {
    "poem_id": 88094,
    "vorder": 32,
    "position": 1,
    "text": "دل‌افروز و با دانش و نیک‌پی"
  },
  {
    "poem_id": 88094,
    "vorder": 33,
    "position": 0,
    "text": "به مادر هم از تخم افراسیاب"
  },
  {
    "poem_id": 88094,
    "vorder": 34,
    "position": 1,
    "text": "که با خشم او گم شدی خورد و خواب"
  },
  {
    "poem_id": 88094,
    "vorder": 35,
    "position": 0,
    "text": "نبیرهٔ فریدون و پور پشنگ"
  },
  {
    "poem_id": 88094,
    "vorder": 36,
    "position": 1,
    "text": "از این گوهران چنین نیست ننگ"
  },
  {
    "poem_id": 88094,
    "vorder": 37,
    "position": 0,
    "text": "که شیران ایران به دریای آب"
  },
  {
    "poem_id": 88094,
    "vorder": 38,
    "position": 1,
    "text": "نشستی تن از بیم افراسیاب"
  },
  {
    "poem_id": 88094,
    "vorder": 39,
    "position": 0,
    "text": "دگر آن که کاووس صندوق ساخت"
  },
  {
    "poem_id": 88094,
    "vorder": 40,
    "position": 1,
    "text": "سر از پادشاهی همی برفراخت"
  },
  {
    "poem_id": 88094,
    "vorder": 41,
    "position": 0,
    "text": "چنان دان که اندر فزونی منش"
  },
  {
    "poem_id": 88094,
    "vorder": 42,
    "position": 1,
    "text": "نسازند بر پادشا سرزنش"
  },
  {
    "poem_id": 88094,
    "vorder": 43,
    "position": 0,
    "text": "کنون من چو کین پدر خواستم"
  },
  {
    "poem_id": 88094,
    "vorder": 44,
    "position": 1,
    "text": "جهان را به پیروزی آراستم"
  },
  {
    "poem_id": 88094,
    "vorder": 45,
    "position": 0,
    "text": "بکشتم کسی را کز او بود کین"
  },
  {
    "poem_id": 88094,
    "vorder": 46,
    "position": 1,
    "text": "وز او جور و بیداد بد بر زمین"
  },
  {
    "poem_id": 88094,
    "vorder": 47,
    "position": 0,
    "text": "به گیتی مرا نیز کاری نماند"
  },
  {
    "poem_id": 88094,
    "vorder": 48,
    "position": 1,
    "text": "ز بدگوهران یادگاری نماند"
  },
  {
    "poem_id": 88094,
    "vorder": 49,
    "position": 0,
    "text": "هرآنگه که اندیشه گردد دراز"
  },
  {
    "poem_id": 88094,
    "vorder": 50,
    "position": 1,
    "text": "ز شادی و از دولت دیریاز"
  },
  {
    "poem_id": 88094,
    "vorder": 51,
    "position": 0,
    "text": "چو کاووس و جمشید باشم به راه"
  },
  {
    "poem_id": 88094,
    "vorder": 52,
    "position": 1,
    "text": "چو ایشان ز من گم شود پایگاه"
  },
  {
    "poem_id": 88094,
    "vorder": 53,
    "position": 0,
    "text": "چو ضحاک ناپاک و تور دلیر"
  },
  {
    "poem_id": 88094,
    "vorder": 54,
    "position": 1,
    "text": "که از جور ایشان جهان گشت سیر"
  },
  {
    "poem_id": 88094,
    "vorder": 55,
    "position": 0,
    "text": "بترسم که چون روز نخ برکشد"
  },
  {
    "poem_id": 88094,
    "vorder": 56,
    "position": 1,
    "text": "چو ایشان مرا سوی دوزخ کشد"
  },
  {
    "poem_id": 88094,
    "vorder": 57,
    "position": 0,
    "text": "دگر آن که گفتی که با شیده جنگ"
  },
  {
    "poem_id": 88094,
    "vorder": 58,
    "position": 1,
    "text": "بیاراستی چون دلاور پلنگ"
  },
  {
    "poem_id": 88094,
    "vorder": 59,
    "position": 0,
    "text": "از آن بد کز ایران ندیدم سوار"
  },
  {
    "poem_id": 88094,
    "vorder": 60,
    "position": 1,
    "text": "نه اسپ افگنی از در کارزار"
  },
  {
    "poem_id": 88094,
    "vorder": 61,
    "position": 0,
    "text": "که تنها بر او به جنگ آمدی"
  },
  {
    "poem_id": 88094,
    "vorder": 62,
    "position": 1,
    "text": "چو رفتی به رزمش درنگ آمدی"
  },
  {
    "poem_id": 88094,
    "vorder": 63,
    "position": 0,
    "text": "کسی را کجا فر یزدان نبود"
  },
  {
    "poem_id": 88094,
    "vorder": 64,
    "position": 1,
    "text": "وگر اختر نیک خندان نبود"
  },
  {
    "poem_id": 88094,
    "vorder": 65,
    "position": 0,
    "text": "همه خاک بودی به جنگ پشنگ"
  },
  {
    "poem_id": 88094,
    "vorder": 66,
    "position": 1,
    "text": "از ایران بدین سان شدم تیزچنگ"
  },
  {
    "poem_id": 88094,
    "vorder": 67,
    "position": 0,
    "text": "بدین پنج هفته که من روز و شب"
  },
  {
    "poem_id": 88094,
    "vorder": 68,
    "position": 1,
    "text": "همی بآفرین برگشادم دو لب"
  },
  {
    "poem_id": 88094,
    "vorder": 69,
    "position": 0,
    "text": "بدان تا جهاندار یزدان پاک"
  },
  {
    "poem_id": 88094,
    "vorder": 70,
    "position": 1,
    "text": "رهاند مرا ز این غم تیره خاک"
  },
  {
    "poem_id": 88094,
    "vorder": 71,
    "position": 0,
    "text": "شدم سیر ز این لشکر و تاج و تخت"
  },
  {
    "poem_id": 88094,
    "vorder": 72,
    "position": 1,
    "text": "سبک بار گشتیم و بستیم رخت"
  },
  {
    "poem_id": 88094,
    "vorder": 73,
    "position": 0,
    "text": "تو ای پیر بیدار دستان سام"
  },
  {
    "poem_id": 88094,
    "vorder": 74,
    "position": 1,
    "text": "مرا دیو گویی که بنهاد دام"
  },
  {
    "poem_id": 88094,
    "vorder": 75,
    "position": 0,
    "text": "به تاری و کژی بگشتم ز راه"
  },
  {
    "poem_id": 88094,
    "vorder": 76,
    "position": 1,
    "text": "روان گشته بی‌مایه و دل تباه"
  },
  {
    "poem_id": 88094,
    "vorder": 77,
    "position": 0,
    "text": "ندانم که بادافره ایزدی"
  },
  {
    "poem_id": 88094,
    "vorder": 78,
    "position": 1,
    "text": "کجا یابم و روزگار بدی"
  }
]