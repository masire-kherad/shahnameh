[
  {
    "poem_id": 1868,
    "vorder": 1,
    "position": 0,
    "text": "هم آنگه ز کوه اندر آمد سپاه"
  },
  {
    "poem_id": 1868,
    "vorder": 2,
    "position": 1,
    "text": "جهان شد ز گرد سواران سیاه"
  },
  {
    "poem_id": 1868,
    "vorder": 3,
    "position": 0,
    "text": "وزان روی بهرام لشکر براند"
  },
  {
    "poem_id": 1868,
    "vorder": 4,
    "position": 1,
    "text": "به روز اندرون روشنایی نماند"
  },
  {
    "poem_id": 1868,
    "vorder": 5,
    "position": 0,
    "text": "همی‌گفت هرکس که راند سپاه"
  },
  {
    "poem_id": 1868,
    "vorder": 6,
    "position": 1,
    "text": "خرد باید و مردی و دستگاه"
  },
  {
    "poem_id": 1868,
    "vorder": 7,
    "position": 0,
    "text": "دلیران که دیدند خشت مرا"
  },
  {
    "poem_id": 1868,
    "vorder": 8,
    "position": 1,
    "text": "همان پهلوانی سرشت مرا"
  },
  {
    "poem_id": 1868,
    "vorder": 9,
    "position": 0,
    "text": "مرا برگزیدند بر خسروان"
  },
  {
    "poem_id": 1868,
    "vorder": 10,
    "position": 1,
    "text": "به خاک افگنم نام نوشین روان"
  },
  {
    "poem_id": 1868,
    "vorder": 11,
    "position": 0,
    "text": "ز لشکر بر شاه شد خیره خیر"
  },
  {
    "poem_id": 1868,
    "vorder": 12,
    "position": 1,
    "text": "کمان را بزه کرد و یک چوبه تیر"
  },
  {
    "poem_id": 1868,
    "vorder": 13,
    "position": 0,
    "text": "بزد ناگهان بر کمرگاه شاه"
  },
  {
    "poem_id": 1868,
    "vorder": 14,
    "position": 1,
    "text": "بکژ اندر آویخت پیکان به راه"
  },
  {
    "poem_id": 1868,
    "vorder": 15,
    "position": 0,
    "text": "یکی بنده چون زخم پیکان بدید"
  },
  {
    "poem_id": 1868,
    "vorder": 16,
    "position": 1,
    "text": "بیامد ز دیباش بیرون کشید"
  },
  {
    "poem_id": 1868,
    "vorder": 17,
    "position": 0,
    "text": "سبک شهریار اندر آمد دمان"
  },
  {
    "poem_id": 1868,
    "vorder": 18,
    "position": 1,
    "text": "به بهرام چوبینهٔ بد نشان"
  },
  {
    "poem_id": 1868,
    "vorder": 19,
    "position": 0,
    "text": "بزد نیزه‌ای بر کمربند اوی"
  },
  {
    "poem_id": 1868,
    "vorder": 20,
    "position": 1,
    "text": "زره بود نگسست پیوند اوی"
  },
  {
    "poem_id": 1868,
    "vorder": 21,
    "position": 0,
    "text": "سنان سر نیزه شد به دونیم"
  },
  {
    "poem_id": 1868,
    "vorder": 22,
    "position": 1,
    "text": "دل مرد بی‌راه شد پر ز بیم"
  },
  {
    "poem_id": 1868,
    "vorder": 23,
    "position": 0,
    "text": "چو بشکست نیزه بر آشفت شاه"
  },
  {
    "poem_id": 1868,
    "vorder": 24,
    "position": 1,
    "text": "بزد تیغ بر مغفر کینه خواه"
  },
  {
    "poem_id": 1868,
    "vorder": 25,
    "position": 0,
    "text": "سراسر همه تیغ برهم شکست"
  },
  {
    "poem_id": 1868,
    "vorder": 26,
    "position": 1,
    "text": "بدان پیکر مغفر اندر نشست"
  },
  {
    "poem_id": 1868,
    "vorder": 27,
    "position": 0,
    "text": "همی آفرین کرد هرکس که دید"
  },
  {
    "poem_id": 1868,
    "vorder": 28,
    "position": 1,
    "text": "هم آنکس که آواز آهن شنید"
  },
  {
    "poem_id": 1868,
    "vorder": 29,
    "position": 0,
    "text": "گرانمایگان از پس اندر شدند"
  },
  {
    "poem_id": 1868,
    "vorder": 30,
    "position": 1,
    "text": "چنان لشکری را بهم بر زدند"
  },
  {
    "poem_id": 1868,
    "vorder": 31,
    "position": 0,
    "text": "خرامید بندوی نزدیک شاه"
  },
  {
    "poem_id": 1868,
    "vorder": 32,
    "position": 1,
    "text": "که‌ای تاج تو برتر از چرخ ماه"
  },
  {
    "poem_id": 1868,
    "vorder": 33,
    "position": 0,
    "text": "یکی لشکرست این چومور وملخ"
  },
  {
    "poem_id": 1868,
    "vorder": 34,
    "position": 1,
    "text": "گرفته بیابان همه ریگ و شخ"
  },
  {
    "poem_id": 1868,
    "vorder": 35,
    "position": 0,
    "text": "نه والا بود خیره خون ریختن"
  },
  {
    "poem_id": 1868,
    "vorder": 36,
    "position": 1,
    "text": "نه این شاه با بنده آویختن"
  },
  {
    "poem_id": 1868,
    "vorder": 37,
    "position": 0,
    "text": "هر آنکس که خواهد ز ما زینهار"
  },
  {
    "poem_id": 1868,
    "vorder": 38,
    "position": 1,
    "text": "به از کشته یا خسته در کارزار"
  },
  {
    "poem_id": 1868,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت خسرو که هر کز گناه"
  },
  {
    "poem_id": 1868,
    "vorder": 40,
    "position": 1,
    "text": "بپیچید برو من نیم کینه خواه"
  },
  {
    "poem_id": 1868,
    "vorder": 41,
    "position": 0,
    "text": "همه پاک در زینهار منند"
  },
  {
    "poem_id": 1868,
    "vorder": 42,
    "position": 1,
    "text": "به تاج اندرون گوشوار منند"
  },
  {
    "poem_id": 1868,
    "vorder": 43,
    "position": 0,
    "text": "برآمد هم آنگه شب از تیره کوه"
  },
  {
    "poem_id": 1868,
    "vorder": 44,
    "position": 1,
    "text": "سپه بازگشتند هر دو گروه"
  },
  {
    "poem_id": 1868,
    "vorder": 45,
    "position": 0,
    "text": "چوآمد غوپاسبان و جرس"
  },
  {
    "poem_id": 1868,
    "vorder": 46,
    "position": 1,
    "text": "ز لشکر نبد خفته بسیار کس"
  },
  {
    "poem_id": 1868,
    "vorder": 47,
    "position": 0,
    "text": "جهان جوی بندوی ز آنجا برفت"
  },
  {
    "poem_id": 1868,
    "vorder": 48,
    "position": 1,
    "text": "میان دو لشکر خرامید تفت"
  },
  {
    "poem_id": 1868,
    "vorder": 49,
    "position": 0,
    "text": "ز لشکر نگه کرد کنداوری"
  },
  {
    "poem_id": 1868,
    "vorder": 50,
    "position": 1,
    "text": "خوش آواز و گویا منادیگری"
  },
  {
    "poem_id": 1868,
    "vorder": 51,
    "position": 0,
    "text": "بفرمود تا بارگی برنشست"
  },
  {
    "poem_id": 1868,
    "vorder": 52,
    "position": 1,
    "text": "به بیدار کردن میان را ببست"
  },
  {
    "poem_id": 1868,
    "vorder": 53,
    "position": 0,
    "text": "چنین تا میان دولشکر براند"
  },
  {
    "poem_id": 1868,
    "vorder": 54,
    "position": 1,
    "text": "کزو تا بدشمن فراوان نماند"
  },
  {
    "poem_id": 1868,
    "vorder": 55,
    "position": 0,
    "text": "خروشی برآورد کای بندگان"
  },
  {
    "poem_id": 1868,
    "vorder": 56,
    "position": 1,
    "text": "گنه کرده و بخت جویندگان"
  },
  {
    "poem_id": 1868,
    "vorder": 57,
    "position": 0,
    "text": "هران کز شما او گنهکارتر"
  },
  {
    "poem_id": 1868,
    "vorder": 58,
    "position": 1,
    "text": "به جنگ اندرون نامبردارتر"
  },
  {
    "poem_id": 1868,
    "vorder": 59,
    "position": 0,
    "text": "به یزدانش بخشید شاه جهان"
  },
  {
    "poem_id": 1868,
    "vorder": 60,
    "position": 1,
    "text": "گناهی‌که کرد آشکار و نهان"
  },
  {
    "poem_id": 1868,
    "vorder": 61,
    "position": 0,
    "text": "به تیره شبان چون برآمد خروش"
  },
  {
    "poem_id": 1868,
    "vorder": 62,
    "position": 1,
    "text": "نهادند هرکس به آواز گوش"
  },
  {
    "poem_id": 1868,
    "vorder": 63,
    "position": 0,
    "text": "همه نامداران بهرامیان"
  },
  {
    "poem_id": 1868,
    "vorder": 64,
    "position": 1,
    "text": "برفتن ببستند یک سر میان"
  },
  {
    "poem_id": 1868,
    "vorder": 65,
    "position": 0,
    "text": "چو برزد سر از کوه گیتی فروز"
  },
  {
    "poem_id": 1868,
    "vorder": 66,
    "position": 1,
    "text": "زمین را به ملحم بیاراست روز"
  },
  {
    "poem_id": 1868,
    "vorder": 67,
    "position": 0,
    "text": "همه دشت بی‌مرد و خرگاه بود"
  },
  {
    "poem_id": 1868,
    "vorder": 68,
    "position": 1,
    "text": "که بهرام زان شب نه آگاه بود"
  },
  {
    "poem_id": 1868,
    "vorder": 69,
    "position": 0,
    "text": "بدان خیمه‌ها در ندیدند کس"
  },
  {
    "poem_id": 1868,
    "vorder": 70,
    "position": 1,
    "text": "جز از ویژه یاران بهرام و بس"
  },
  {
    "poem_id": 1868,
    "vorder": 71,
    "position": 0,
    "text": "چو بهرام زان لشکر آگاه گشت"
  },
  {
    "poem_id": 1868,
    "vorder": 72,
    "position": 1,
    "text": "بیامد بران خیمه‌ها برگذشت"
  },
  {
    "poem_id": 1868,
    "vorder": 73,
    "position": 0,
    "text": "به یاران چنین گفت کاکنون گریز"
  },
  {
    "poem_id": 1868,
    "vorder": 74,
    "position": 1,
    "text": "به آید ز آرام با رستخیز"
  },
  {
    "poem_id": 1868,
    "vorder": 75,
    "position": 0,
    "text": "شتر خواست از ساروان سه هزار"
  },
  {
    "poem_id": 1868,
    "vorder": 76,
    "position": 1,
    "text": "هیونان کفک افگن و نامدار"
  },
  {
    "poem_id": 1868,
    "vorder": 77,
    "position": 0,
    "text": "ز چیزی که در گنج بد بردنی"
  },
  {
    "poem_id": 1868,
    "vorder": 78,
    "position": 1,
    "text": "ز گستردنیها و از خوردنی"
  },
  {
    "poem_id": 1868,
    "vorder": 79,
    "position": 0,
    "text": "ز زرین و سیمین وز تخت عاج"
  },
  {
    "poem_id": 1868,
    "vorder": 80,
    "position": 1,
    "text": "همان یاره و طوق زرین وتاج"
  },
  {
    "poem_id": 1868,
    "vorder": 81,
    "position": 0,
    "text": "همه بار کردند و خود برنشست"
  },
  {
    "poem_id": 1868,
    "vorder": 82,
    "position": 1,
    "text": "میان از پی بازگشتن ببست"
  }
]