[
  {
    "poem_id": 1614,
    "vorder": 1,
    "position": 0,
    "text": "چو بهمن به تخت نیا بر نشست"
  },
  {
    "poem_id": 1614,
    "vorder": 2,
    "position": 1,
    "text": "کمر با میان بست و بگشاد دست"
  },
  {
    "poem_id": 1614,
    "vorder": 3,
    "position": 0,
    "text": "سپه را درم داد و دینار داد"
  },
  {
    "poem_id": 1614,
    "vorder": 4,
    "position": 1,
    "text": "همان کشور و مرز بسیار داد"
  },
  {
    "poem_id": 1614,
    "vorder": 5,
    "position": 0,
    "text": "یکی انجمن ساخت از بخردان"
  },
  {
    "poem_id": 1614,
    "vorder": 6,
    "position": 1,
    "text": "بزرگان و کار آزموده ردان"
  },
  {
    "poem_id": 1614,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت کز کار اسفندیار"
  },
  {
    "poem_id": 1614,
    "vorder": 8,
    "position": 1,
    "text": "ز نیک و بد گردش روزگار"
  },
  {
    "poem_id": 1614,
    "vorder": 9,
    "position": 0,
    "text": "همه یاد دارید پیر و جوان"
  },
  {
    "poem_id": 1614,
    "vorder": 10,
    "position": 1,
    "text": "هرانکس که هستید روشن‌روان"
  },
  {
    "poem_id": 1614,
    "vorder": 11,
    "position": 0,
    "text": "که رستم گه زندگانی چه کرد"
  },
  {
    "poem_id": 1614,
    "vorder": 12,
    "position": 1,
    "text": "همان زال افسونگر آن پیرمرد"
  },
  {
    "poem_id": 1614,
    "vorder": 13,
    "position": 0,
    "text": "فرامرز جز کین ما در جهان"
  },
  {
    "poem_id": 1614,
    "vorder": 14,
    "position": 1,
    "text": "نجوید همی آشکار و نهان"
  },
  {
    "poem_id": 1614,
    "vorder": 15,
    "position": 0,
    "text": "سرم پر ز دردست و دل پر ز خون"
  },
  {
    "poem_id": 1614,
    "vorder": 16,
    "position": 1,
    "text": "جز از کین ندارم به مغز اندرون"
  },
  {
    "poem_id": 1614,
    "vorder": 17,
    "position": 0,
    "text": "دو جنگی چو نوش‌آذر و مهرنوش"
  },
  {
    "poem_id": 1614,
    "vorder": 18,
    "position": 1,
    "text": "که از درد ایشان برآمد خروش"
  },
  {
    "poem_id": 1614,
    "vorder": 19,
    "position": 0,
    "text": "چو اسفندیاری که اندر جهان"
  },
  {
    "poem_id": 1614,
    "vorder": 20,
    "position": 1,
    "text": "بدو تازه بد روزگار مهان"
  },
  {
    "poem_id": 1614,
    "vorder": 21,
    "position": 0,
    "text": "به زابلستان زان نشان کشته شد"
  },
  {
    "poem_id": 1614,
    "vorder": 22,
    "position": 1,
    "text": "ز دردش دد و دام سرگشته شد"
  },
  {
    "poem_id": 1614,
    "vorder": 23,
    "position": 0,
    "text": "همانا که بر خون اسفندیار"
  },
  {
    "poem_id": 1614,
    "vorder": 24,
    "position": 1,
    "text": "به زاری بگرید به ایوان نگار"
  },
  {
    "poem_id": 1614,
    "vorder": 25,
    "position": 0,
    "text": "هم از خون آن نامداران ما"
  },
  {
    "poem_id": 1614,
    "vorder": 26,
    "position": 1,
    "text": "جوانان و جنگی سواران ما"
  },
  {
    "poem_id": 1614,
    "vorder": 27,
    "position": 0,
    "text": "هر آنکس که او باشد از آب پاک"
  },
  {
    "poem_id": 1614,
    "vorder": 28,
    "position": 1,
    "text": "نیارد سر گوهر اندر مغاک"
  },
  {
    "poem_id": 1614,
    "vorder": 29,
    "position": 0,
    "text": "به کردار شاه آفریدون بود"
  },
  {
    "poem_id": 1614,
    "vorder": 30,
    "position": 1,
    "text": "چو خونین بباشد همایون بود"
  },
  {
    "poem_id": 1614,
    "vorder": 31,
    "position": 0,
    "text": "که ضحاک را از پی خون جم"
  },
  {
    "poem_id": 1614,
    "vorder": 32,
    "position": 1,
    "text": "ز نام‌آوران جهان کرد کم"
  },
  {
    "poem_id": 1614,
    "vorder": 33,
    "position": 0,
    "text": "منوچهر با سلم و تور سترگ"
  },
  {
    "poem_id": 1614,
    "vorder": 34,
    "position": 1,
    "text": "بیاورد ز آمل سپاهی بزرگ"
  },
  {
    "poem_id": 1614,
    "vorder": 35,
    "position": 0,
    "text": "به چین رفت و کین نیا بازخواست"
  },
  {
    "poem_id": 1614,
    "vorder": 36,
    "position": 1,
    "text": "مرا همچنان داستانست راست"
  },
  {
    "poem_id": 1614,
    "vorder": 37,
    "position": 0,
    "text": "چو کیخسرو آمد از افراسیاب"
  },
  {
    "poem_id": 1614,
    "vorder": 38,
    "position": 1,
    "text": "ز خون کرد گیتی چو دریای آب"
  },
  {
    "poem_id": 1614,
    "vorder": 39,
    "position": 0,
    "text": "پدرم آمد و کین لهراسپ خواست"
  },
  {
    "poem_id": 1614,
    "vorder": 40,
    "position": 1,
    "text": "ز کشته زمین کرد با کوه راست"
  },
  {
    "poem_id": 1614,
    "vorder": 41,
    "position": 0,
    "text": "فرامرز کز بهر خون پدر"
  },
  {
    "poem_id": 1614,
    "vorder": 42,
    "position": 1,
    "text": "به خورشید تابان برآورد سر"
  },
  {
    "poem_id": 1614,
    "vorder": 43,
    "position": 0,
    "text": "به کابل شد و کین رستم بخواست"
  },
  {
    "poem_id": 1614,
    "vorder": 44,
    "position": 1,
    "text": "همه بوم و بر کرد با خاک راست"
  },
  {
    "poem_id": 1614,
    "vorder": 45,
    "position": 0,
    "text": "زمین را ز خون بازنشناختند"
  },
  {
    "poem_id": 1614,
    "vorder": 46,
    "position": 1,
    "text": "همی باره بر کشتگان تاختند"
  },
  {
    "poem_id": 1614,
    "vorder": 47,
    "position": 0,
    "text": "به کینه سزاوارتر کس منم"
  },
  {
    "poem_id": 1614,
    "vorder": 48,
    "position": 1,
    "text": "که بر شیر درنده اسپ افگنم"
  },
  {
    "poem_id": 1614,
    "vorder": 49,
    "position": 0,
    "text": "اگر بشمری در جهان نامدار"
  },
  {
    "poem_id": 1614,
    "vorder": 50,
    "position": 1,
    "text": "سواری نبینی چو اسفندیار"
  },
  {
    "poem_id": 1614,
    "vorder": 51,
    "position": 0,
    "text": "چه بیند و این را چه پاسخ دهید"
  },
  {
    "poem_id": 1614,
    "vorder": 52,
    "position": 1,
    "text": "بکوشید تا رای فرخ نهید"
  },
  {
    "poem_id": 1614,
    "vorder": 53,
    "position": 0,
    "text": "چو بشنید گفتار بهمن سپاه"
  },
  {
    "poem_id": 1614,
    "vorder": 54,
    "position": 1,
    "text": "هرانکس که بد شاه را نیکخواه"
  },
  {
    "poem_id": 1614,
    "vorder": 55,
    "position": 0,
    "text": "به آواز گفتند ما بنده‌ایم"
  },
  {
    "poem_id": 1614,
    "vorder": 56,
    "position": 1,
    "text": "همه دل به مهر تو آگنده‌ایم"
  },
  {
    "poem_id": 1614,
    "vorder": 57,
    "position": 0,
    "text": "ز کار گذشته تو داناتری"
  },
  {
    "poem_id": 1614,
    "vorder": 58,
    "position": 1,
    "text": "ز مردان جنگی تواناتری"
  },
  {
    "poem_id": 1614,
    "vorder": 59,
    "position": 0,
    "text": "به گیتی همان کن که کام آیدت"
  },
  {
    "poem_id": 1614,
    "vorder": 60,
    "position": 1,
    "text": "وگر زان سخن فر و نام آیدت"
  },
  {
    "poem_id": 1614,
    "vorder": 61,
    "position": 0,
    "text": "نپیچد کسی سر ز فرمان تو"
  },
  {
    "poem_id": 1614,
    "vorder": 62,
    "position": 1,
    "text": "که یارد گذشتن ز پیمان تو"
  },
  {
    "poem_id": 1614,
    "vorder": 63,
    "position": 0,
    "text": "چو پاسخ چنین یافت از لشکرش"
  },
  {
    "poem_id": 1614,
    "vorder": 64,
    "position": 1,
    "text": "به کین اندرون تیزتر شد سرش"
  },
  {
    "poem_id": 1614,
    "vorder": 65,
    "position": 0,
    "text": "همه سیستان را بیاراستند"
  },
  {
    "poem_id": 1614,
    "vorder": 66,
    "position": 1,
    "text": "برین بر نهادند و برخاستند"
  },
  {
    "poem_id": 1614,
    "vorder": 67,
    "position": 0,
    "text": "به شبگیر برخاست آوای کوس"
  },
  {
    "poem_id": 1614,
    "vorder": 68,
    "position": 1,
    "text": "شد از گرد لشکر سپهر آبنوس"
  },
  {
    "poem_id": 1614,
    "vorder": 69,
    "position": 0,
    "text": "همی رفت زان لشکر نامدار"
  },
  {
    "poem_id": 1614,
    "vorder": 70,
    "position": 1,
    "text": "سواران شمشیرزن صد هزار"
  }
]