[
  {
    "poem_id": 1494,
    "vorder": 1,
    "position": 0,
    "text": "چو لشکر بیامد ز دشت نبرد"
  },
  {
    "poem_id": 1494,
    "vorder": 2,
    "position": 1,
    "text": "تنان پر ز خون و سران پر ز گرد"
  },
  {
    "poem_id": 1494,
    "vorder": 3,
    "position": 0,
    "text": "خبر شد ز ترکان به افراسیاب"
  },
  {
    "poem_id": 1494,
    "vorder": 4,
    "position": 1,
    "text": "که بیدار بخت اندرآمد به خواب"
  },
  {
    "poem_id": 1494,
    "vorder": 5,
    "position": 0,
    "text": "همان سرخه نامور کشته شد"
  },
  {
    "poem_id": 1494,
    "vorder": 6,
    "position": 1,
    "text": "چنان دولت تیز برگشته شد"
  },
  {
    "poem_id": 1494,
    "vorder": 7,
    "position": 0,
    "text": "بریده سرش را نگونسار کرد"
  },
  {
    "poem_id": 1494,
    "vorder": 8,
    "position": 1,
    "text": "تنش را به خون غرقه بر دار کرد"
  },
  {
    "poem_id": 1494,
    "vorder": 9,
    "position": 0,
    "text": "همه شهر ایران جگر خسته‌اند"
  },
  {
    "poem_id": 1494,
    "vorder": 10,
    "position": 1,
    "text": "به کین سیاوش کمر بسته‌اند"
  },
  {
    "poem_id": 1494,
    "vorder": 11,
    "position": 0,
    "text": "نگون شد سر و تاج افراسیاب"
  },
  {
    "poem_id": 1494,
    "vorder": 12,
    "position": 1,
    "text": "همی کند موی و همی ریخت آب"
  },
  {
    "poem_id": 1494,
    "vorder": 13,
    "position": 0,
    "text": "همی گفت رادا سرا موبدا"
  },
  {
    "poem_id": 1494,
    "vorder": 14,
    "position": 1,
    "text": "ردا نامدارا یلا بخردا"
  },
  {
    "poem_id": 1494,
    "vorder": 15,
    "position": 0,
    "text": "دریغ ارغوانی رخت همچو ماه"
  },
  {
    "poem_id": 1494,
    "vorder": 16,
    "position": 1,
    "text": "دریغ آن کیی برز و بالای شاه"
  },
  {
    "poem_id": 1494,
    "vorder": 17,
    "position": 0,
    "text": "خروشان به سر بر پراگند خاک"
  },
  {
    "poem_id": 1494,
    "vorder": 18,
    "position": 1,
    "text": "همه جامه ها کرد بر خویش چاک"
  },
  {
    "poem_id": 1494,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت با لشکر افراسیاب"
  },
  {
    "poem_id": 1494,
    "vorder": 20,
    "position": 1,
    "text": "که مارا بر آمد سر از خورد و خواب"
  },
  {
    "poem_id": 1494,
    "vorder": 21,
    "position": 0,
    "text": "همه کینه را چشم روشن کنید"
  },
  {
    "poem_id": 1494,
    "vorder": 22,
    "position": 1,
    "text": "نهالی ز خفتان و جوشن کنید"
  },
  {
    "poem_id": 1494,
    "vorder": 23,
    "position": 0,
    "text": "چو برخاست آوای کوس از درش"
  },
  {
    "poem_id": 1494,
    "vorder": 24,
    "position": 1,
    "text": "بجنبید بر بارگه لشکرش"
  },
  {
    "poem_id": 1494,
    "vorder": 25,
    "position": 0,
    "text": "بزد نای رویین و بربست کوس"
  },
  {
    "poem_id": 1494,
    "vorder": 26,
    "position": 1,
    "text": "همی آسمان بر زمین داد بوس"
  },
  {
    "poem_id": 1494,
    "vorder": 27,
    "position": 0,
    "text": "به گردنکشان خسرو آواز کرد"
  },
  {
    "poem_id": 1494,
    "vorder": 28,
    "position": 1,
    "text": "که ای نامداران روز نبرد"
  },
  {
    "poem_id": 1494,
    "vorder": 29,
    "position": 0,
    "text": "چو برخیزد آوای کوس از دو روی"
  },
  {
    "poem_id": 1494,
    "vorder": 30,
    "position": 1,
    "text": "نجوید زمان مرد پرخاشجوی"
  },
  {
    "poem_id": 1494,
    "vorder": 31,
    "position": 0,
    "text": "همه رزم را دل پر از کین کنید"
  },
  {
    "poem_id": 1494,
    "vorder": 32,
    "position": 1,
    "text": "به ایرانیان پاک نفرین کنید"
  },
  {
    "poem_id": 1494,
    "vorder": 33,
    "position": 0,
    "text": "خروش آمد و نالهٔ کرنای"
  },
  {
    "poem_id": 1494,
    "vorder": 34,
    "position": 1,
    "text": "دم نای رویین و هندی درای"
  },
  {
    "poem_id": 1494,
    "vorder": 35,
    "position": 0,
    "text": "زمین آمد از سم اسپان به جوش"
  },
  {
    "poem_id": 1494,
    "vorder": 36,
    "position": 1,
    "text": "به ابر اندر آمد فغان و خروش"
  },
  {
    "poem_id": 1494,
    "vorder": 37,
    "position": 0,
    "text": "چو برخاست از دشت گرد سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 38,
    "position": 1,
    "text": "کس آمد بر رستم از دیده‌گاه"
  },
  {
    "poem_id": 1494,
    "vorder": 39,
    "position": 0,
    "text": "که آمد سپاهی چو کوه گران"
  },
  {
    "poem_id": 1494,
    "vorder": 40,
    "position": 1,
    "text": "همه رزم جویان کندآوران"
  },
  {
    "poem_id": 1494,
    "vorder": 41,
    "position": 0,
    "text": "ز تیغ دلیران هوا شد بنفش"
  },
  {
    "poem_id": 1494,
    "vorder": 42,
    "position": 1,
    "text": "برفتند با کاویانی درفش"
  },
  {
    "poem_id": 1494,
    "vorder": 43,
    "position": 0,
    "text": "برآمد خروش سپاه از دو روی"
  },
  {
    "poem_id": 1494,
    "vorder": 44,
    "position": 1,
    "text": "جهان شد پر از مردم جنگجوی"
  },
  {
    "poem_id": 1494,
    "vorder": 45,
    "position": 0,
    "text": "خور و ماه گفتی به رنگ اندرست"
  },
  {
    "poem_id": 1494,
    "vorder": 46,
    "position": 1,
    "text": "ستاره به چنگ نهنگ اندرست"
  },
  {
    "poem_id": 1494,
    "vorder": 47,
    "position": 0,
    "text": "سپهدار ترکان برآراست جنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 48,
    "position": 1,
    "text": "گرفتند گوپال و خنجر به چنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 49,
    "position": 0,
    "text": "بیامد سوی میمنه بارمان"
  },
  {
    "poem_id": 1494,
    "vorder": 50,
    "position": 1,
    "text": "سپاهی ز ترکان دنان و دمان"
  },
  {
    "poem_id": 1494,
    "vorder": 51,
    "position": 0,
    "text": "سوی میسره کهرم تیغ‌زن"
  },
  {
    "poem_id": 1494,
    "vorder": 52,
    "position": 1,
    "text": "به قلب اندرون شاه با انجمن"
  },
  {
    "poem_id": 1494,
    "vorder": 53,
    "position": 0,
    "text": "وزین روی رستم سپه برکشید"
  },
  {
    "poem_id": 1494,
    "vorder": 54,
    "position": 1,
    "text": "هوا شد ز تیغ یلان ناپدید"
  },
  {
    "poem_id": 1494,
    "vorder": 55,
    "position": 0,
    "text": "بیاراست بر میمنه گیو و طوس"
  },
  {
    "poem_id": 1494,
    "vorder": 56,
    "position": 1,
    "text": "سواران بیدار با پیل و کوس"
  },
  {
    "poem_id": 1494,
    "vorder": 57,
    "position": 0,
    "text": "چو گودرز کشواد بر میسره"
  },
  {
    "poem_id": 1494,
    "vorder": 58,
    "position": 1,
    "text": "هجیر و گرانمایگان یکسره"
  },
  {
    "poem_id": 1494,
    "vorder": 59,
    "position": 0,
    "text": "به قلب اندرون رستم زابلی"
  },
  {
    "poem_id": 1494,
    "vorder": 60,
    "position": 1,
    "text": "زره‌دار با خنجر کابلی"
  },
  {
    "poem_id": 1494,
    "vorder": 61,
    "position": 0,
    "text": "تو گفتی نه شب بود پیدا نه روز"
  },
  {
    "poem_id": 1494,
    "vorder": 62,
    "position": 1,
    "text": "نهان گشت خورشید گیتی‌فروز"
  },
  {
    "poem_id": 1494,
    "vorder": 63,
    "position": 0,
    "text": "شد از سم اسپان زمین سنگ رنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 64,
    "position": 1,
    "text": "ز نیزه هوا همچو پشت پلنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 65,
    "position": 0,
    "text": "تو گفتی هوا کوه آهن شدست"
  },
  {
    "poem_id": 1494,
    "vorder": 66,
    "position": 1,
    "text": "سر کوه پر ترگ و جوشن شدست"
  },
  {
    "poem_id": 1494,
    "vorder": 67,
    "position": 0,
    "text": "به ابر اندر آمد سنان و درفش"
  },
  {
    "poem_id": 1494,
    "vorder": 68,
    "position": 1,
    "text": "درفشیدن تیغهای بنفش"
  },
  {
    "poem_id": 1494,
    "vorder": 69,
    "position": 0,
    "text": "بیامد ز قلب سپه پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 70,
    "position": 1,
    "text": "دلش پر ز خون کرده چهره دژم"
  },
  {
    "poem_id": 1494,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت با شاه توران سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 72,
    "position": 1,
    "text": "که‌ای پرهنر خسرو نیک‌خواه"
  },
  {
    "poem_id": 1494,
    "vorder": 73,
    "position": 0,
    "text": "گر ایدونک از من نداری دریغ"
  },
  {
    "poem_id": 1494,
    "vorder": 74,
    "position": 1,
    "text": "یکی باره و جوشن و گرز و تیغ"
  },
  {
    "poem_id": 1494,
    "vorder": 75,
    "position": 0,
    "text": "ابا رستم امروز جنگ آورم"
  },
  {
    "poem_id": 1494,
    "vorder": 76,
    "position": 1,
    "text": "همه نام او زیر ننگ آورم"
  },
  {
    "poem_id": 1494,
    "vorder": 77,
    "position": 0,
    "text": "به پیش تو آرم سر و رخش او"
  },
  {
    "poem_id": 1494,
    "vorder": 78,
    "position": 1,
    "text": "همان خود و تیغ جهان بخش او"
  },
  {
    "poem_id": 1494,
    "vorder": 79,
    "position": 0,
    "text": "ازو شاد شد جان افراسیاب"
  },
  {
    "poem_id": 1494,
    "vorder": 80,
    "position": 1,
    "text": "سر نیزه بگذاشت از آفتاب"
  },
  {
    "poem_id": 1494,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت کای نام بردار شیر"
  },
  {
    "poem_id": 1494,
    "vorder": 82,
    "position": 1,
    "text": "همانا که پیلت نیارد به زیر"
  },
  {
    "poem_id": 1494,
    "vorder": 83,
    "position": 0,
    "text": "اگر پیلتن را به چنگ آوری"
  },
  {
    "poem_id": 1494,
    "vorder": 84,
    "position": 1,
    "text": "زمانه برآساید از داوری"
  },
  {
    "poem_id": 1494,
    "vorder": 85,
    "position": 0,
    "text": "به توران چو تو کس نباشد به جاه"
  },
  {
    "poem_id": 1494,
    "vorder": 86,
    "position": 1,
    "text": "به گنج و به تیغ و به تخت و کلاه"
  },
  {
    "poem_id": 1494,
    "vorder": 87,
    "position": 0,
    "text": "به گردان سپهر اندرآری سرم"
  },
  {
    "poem_id": 1494,
    "vorder": 88,
    "position": 1,
    "text": "سپارم ترا دختر و کشورم"
  },
  {
    "poem_id": 1494,
    "vorder": 89,
    "position": 0,
    "text": "از ایران و توران دو بهر آن تست"
  },
  {
    "poem_id": 1494,
    "vorder": 90,
    "position": 1,
    "text": "همان گوهر و گنج و شهر آن تست"
  },
  {
    "poem_id": 1494,
    "vorder": 91,
    "position": 0,
    "text": "چو بشنید پیران غمی گشت سخت"
  },
  {
    "poem_id": 1494,
    "vorder": 92,
    "position": 1,
    "text": "بیامد بر شاه خورشید بخت"
  },
  {
    "poem_id": 1494,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت کاین مرد برنا و تیز"
  },
  {
    "poem_id": 1494,
    "vorder": 94,
    "position": 1,
    "text": "همی بر تن خویش دارد ستیز"
  },
  {
    "poem_id": 1494,
    "vorder": 95,
    "position": 0,
    "text": "همی در گمان افتد از نام خویش"
  },
  {
    "poem_id": 1494,
    "vorder": 96,
    "position": 1,
    "text": "نیندیشد از کار فرجام خویش"
  },
  {
    "poem_id": 1494,
    "vorder": 97,
    "position": 0,
    "text": "کسی سوی دوزخ نپوید به پا"
  },
  {
    "poem_id": 1494,
    "vorder": 98,
    "position": 1,
    "text": "و گر خیره سوی دم اژدها"
  },
  {
    "poem_id": 1494,
    "vorder": 99,
    "position": 0,
    "text": "گر او با تهمتن نبرد آورد"
  },
  {
    "poem_id": 1494,
    "vorder": 100,
    "position": 1,
    "text": "سر خویش را زیر گرد آورد"
  },
  {
    "poem_id": 1494,
    "vorder": 101,
    "position": 0,
    "text": "شکسته شود دل گوان را به جنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 102,
    "position": 1,
    "text": "بود این سخن نیز بر شاه ننگ"
  },
  {
    "poem_id": 1494,
    "vorder": 103,
    "position": 0,
    "text": "برادر تو دانی که کهتر بود"
  },
  {
    "poem_id": 1494,
    "vorder": 104,
    "position": 1,
    "text": "فزون‌تر برو مهر مهتر بود"
  },
  {
    "poem_id": 1494,
    "vorder": 105,
    "position": 0,
    "text": "به پیران چنین گفت پس پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 106,
    "position": 1,
    "text": "کزین پهلوان دل ندارد دژم"
  },
  {
    "poem_id": 1494,
    "vorder": 107,
    "position": 0,
    "text": "که گر من کنم جنگ جنگی نهنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 108,
    "position": 1,
    "text": "نیارم به بخت تو بر شاه ننگ"
  },
  {
    "poem_id": 1494,
    "vorder": 109,
    "position": 0,
    "text": "به پیش تو با نامور چار گرد"
  },
  {
    "poem_id": 1494,
    "vorder": 110,
    "position": 1,
    "text": "چه کردم تو دیدی ز من دست برد"
  },
  {
    "poem_id": 1494,
    "vorder": 111,
    "position": 0,
    "text": "همانا کنون زورم افزونترست"
  },
  {
    "poem_id": 1494,
    "vorder": 112,
    "position": 1,
    "text": "شکستن دل من نه اندرخورست"
  },
  {
    "poem_id": 1494,
    "vorder": 113,
    "position": 0,
    "text": "برآید به دست من این کارکرد"
  },
  {
    "poem_id": 1494,
    "vorder": 114,
    "position": 1,
    "text": "به گرد در اختر بد مگرد"
  },
  {
    "poem_id": 1494,
    "vorder": 115,
    "position": 0,
    "text": "چو بشنید زو این سخن شهریار"
  },
  {
    "poem_id": 1494,
    "vorder": 116,
    "position": 1,
    "text": "یکی اسپ شایستهٔ کارزار"
  },
  {
    "poem_id": 1494,
    "vorder": 117,
    "position": 0,
    "text": "بدو داد با تیغ و برگستوان"
  },
  {
    "poem_id": 1494,
    "vorder": 118,
    "position": 1,
    "text": "همان نیزه و درع و خود گوان"
  },
  {
    "poem_id": 1494,
    "vorder": 119,
    "position": 0,
    "text": "بیاراست آن جنگ را پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 120,
    "position": 1,
    "text": "همی راند چون شیر با باد و دم"
  },
  {
    "poem_id": 1494,
    "vorder": 121,
    "position": 0,
    "text": "به ایرانیان گفت رستم کجاست"
  },
  {
    "poem_id": 1494,
    "vorder": 122,
    "position": 1,
    "text": "که گوید که او روز جنگ اژدهاست"
  },
  {
    "poem_id": 1494,
    "vorder": 123,
    "position": 0,
    "text": "چو بشنید گیو این سخن بردمید"
  },
  {
    "poem_id": 1494,
    "vorder": 124,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 1494,
    "vorder": 125,
    "position": 0,
    "text": "بدو گفت رستم به یک ترک جنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 126,
    "position": 1,
    "text": "نسازد همانا که آیدش ننگ"
  },
  {
    "poem_id": 1494,
    "vorder": 127,
    "position": 0,
    "text": "برآویختند آن دو جنگی به هم"
  },
  {
    "poem_id": 1494,
    "vorder": 128,
    "position": 1,
    "text": "دمان گیو گودرز با پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 129,
    "position": 0,
    "text": "یکی نیزه زد گیو را کز نهیب"
  },
  {
    "poem_id": 1494,
    "vorder": 130,
    "position": 1,
    "text": "برون آمدش هر دو پا از رکیب"
  },
  {
    "poem_id": 1494,
    "vorder": 131,
    "position": 0,
    "text": "فرامرز چون دید یار آمدش"
  },
  {
    "poem_id": 1494,
    "vorder": 132,
    "position": 1,
    "text": "همی یار جنگی به کار آمدش"
  },
  {
    "poem_id": 1494,
    "vorder": 133,
    "position": 0,
    "text": "یکی تیغ بر نیزهٔ پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 134,
    "position": 1,
    "text": "بزد نیزه از تیغ او شد قلم"
  },
  {
    "poem_id": 1494,
    "vorder": 135,
    "position": 0,
    "text": "دگر باره زد بر سر ترگ اوی"
  },
  {
    "poem_id": 1494,
    "vorder": 136,
    "position": 1,
    "text": "شکسته شد آن تیغ پرخاشجوی"
  },
  {
    "poem_id": 1494,
    "vorder": 137,
    "position": 0,
    "text": "همی گشت با آن دو یل پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 138,
    "position": 1,
    "text": "به میدان به کردار شیر دژم"
  },
  {
    "poem_id": 1494,
    "vorder": 139,
    "position": 0,
    "text": "تهمتن ز قلب سپه بنگرید"
  },
  {
    "poem_id": 1494,
    "vorder": 140,
    "position": 1,
    "text": "دو گرد دلیر و گرانمایه دید"
  },
  {
    "poem_id": 1494,
    "vorder": 141,
    "position": 0,
    "text": "برآویخته با یکی شیرمرد"
  },
  {
    "poem_id": 1494,
    "vorder": 142,
    "position": 1,
    "text": "به ابر اندر آورده از باد گرد"
  },
  {
    "poem_id": 1494,
    "vorder": 143,
    "position": 0,
    "text": "بدانست رستم که جز پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 144,
    "position": 1,
    "text": "ز ترکان ندارد کس آن زور و دم"
  },
  {
    "poem_id": 1494,
    "vorder": 145,
    "position": 0,
    "text": "و دیگر که از نامور بخردان"
  },
  {
    "poem_id": 1494,
    "vorder": 146,
    "position": 1,
    "text": "ز گفت ستاره‌شمر موبدان"
  },
  {
    "poem_id": 1494,
    "vorder": 147,
    "position": 0,
    "text": "ز اختر بد و نیک بشنوده بود"
  },
  {
    "poem_id": 1494,
    "vorder": 148,
    "position": 1,
    "text": "جهان را چپ و راست پیموده بود"
  },
  {
    "poem_id": 1494,
    "vorder": 149,
    "position": 0,
    "text": "که گر پیلسم از بد روزگار"
  },
  {
    "poem_id": 1494,
    "vorder": 150,
    "position": 1,
    "text": "خرد یابد و بند آموزگار"
  },
  {
    "poem_id": 1494,
    "vorder": 151,
    "position": 0,
    "text": "نبرده چنو در جهان سر به سر"
  },
  {
    "poem_id": 1494,
    "vorder": 152,
    "position": 1,
    "text": "به ایران و توران نبندد کمر"
  },
  {
    "poem_id": 1494,
    "vorder": 153,
    "position": 0,
    "text": "همانا که او را زمان آمدست"
  },
  {
    "poem_id": 1494,
    "vorder": 154,
    "position": 1,
    "text": "که ایدر به چنگم دمان آمدست"
  },
  {
    "poem_id": 1494,
    "vorder": 155,
    "position": 0,
    "text": "به لشکر بفرمود کز جای خویش"
  },
  {
    "poem_id": 1494,
    "vorder": 156,
    "position": 1,
    "text": "مگر ناورند اندکی پای پیش"
  },
  {
    "poem_id": 1494,
    "vorder": 157,
    "position": 0,
    "text": "شوم برگرایم تن پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 158,
    "position": 1,
    "text": "ببینم که دارد پی و شاخ و دم"
  },
  {
    "poem_id": 1494,
    "vorder": 159,
    "position": 0,
    "text": "یکی نیزهٔ بارکش برگرفت"
  },
  {
    "poem_id": 1494,
    "vorder": 160,
    "position": 1,
    "text": "بیفشارد ران ترگ بر سر گرفت"
  },
  {
    "poem_id": 1494,
    "vorder": 161,
    "position": 0,
    "text": "گران شد رکیب و سبک شد عنان"
  },
  {
    "poem_id": 1494,
    "vorder": 162,
    "position": 1,
    "text": "به چشم اندر آورد رخشان سنان"
  },
  {
    "poem_id": 1494,
    "vorder": 163,
    "position": 0,
    "text": "غمی گشت و بر لب برآورد کف"
  },
  {
    "poem_id": 1494,
    "vorder": 164,
    "position": 1,
    "text": "همی تاخت از قلب تا پیش صف"
  },
  {
    "poem_id": 1494,
    "vorder": 165,
    "position": 0,
    "text": "چنین گفت کای نامور پیلسم"
  },
  {
    "poem_id": 1494,
    "vorder": 166,
    "position": 1,
    "text": "مرا خواستی تا بسوزی به دم"
  },
  {
    "poem_id": 1494,
    "vorder": 167,
    "position": 0,
    "text": "همی گفت و می‌تاخت برسان گرد"
  },
  {
    "poem_id": 1494,
    "vorder": 168,
    "position": 1,
    "text": "یکی کرد با او سخن در نبرد"
  },
  {
    "poem_id": 1494,
    "vorder": 169,
    "position": 0,
    "text": "یکی نیزه زد بر کمرگاه اوی"
  },
  {
    "poem_id": 1494,
    "vorder": 170,
    "position": 1,
    "text": "ز زین برگرفتش به کردار گوی"
  },
  {
    "poem_id": 1494,
    "vorder": 171,
    "position": 0,
    "text": "همی تاخت تا قلب توران سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 172,
    "position": 1,
    "text": "بینداختش خوار در قلبگاه"
  },
  {
    "poem_id": 1494,
    "vorder": 173,
    "position": 0,
    "text": "چنین گفت کاین را به دیبای زرد"
  },
  {
    "poem_id": 1494,
    "vorder": 174,
    "position": 1,
    "text": "بپوشید کز گرد شد لاژورد"
  },
  {
    "poem_id": 1494,
    "vorder": 175,
    "position": 0,
    "text": "عنان را بپیچید زان جایگاه"
  },
  {
    "poem_id": 1494,
    "vorder": 176,
    "position": 1,
    "text": "بیامد دمان تا به قلب سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 177,
    "position": 0,
    "text": "ببارید پیران ز مژگان سرشک"
  },
  {
    "poem_id": 1494,
    "vorder": 178,
    "position": 1,
    "text": "تن پیلسم دور دید از پزشک"
  },
  {
    "poem_id": 1494,
    "vorder": 179,
    "position": 0,
    "text": "دل لشکر و شاه توران سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 180,
    "position": 1,
    "text": "شکسته شد و تیره شد رزمگاه"
  },
  {
    "poem_id": 1494,
    "vorder": 181,
    "position": 0,
    "text": "خروش آمد از لشکر هر دو سوی"
  },
  {
    "poem_id": 1494,
    "vorder": 182,
    "position": 1,
    "text": "ده و دار گردان پرخاشجوی"
  },
  {
    "poem_id": 1494,
    "vorder": 183,
    "position": 0,
    "text": "خروشیدن کوس بر پشت پیل"
  },
  {
    "poem_id": 1494,
    "vorder": 184,
    "position": 1,
    "text": "ز هر سو همی رفت تا چند میل"
  },
  {
    "poem_id": 1494,
    "vorder": 185,
    "position": 0,
    "text": "زمین شد ز نعل ستوران ستوه"
  },
  {
    "poem_id": 1494,
    "vorder": 186,
    "position": 1,
    "text": "همه کوه دریا شد و دشت کوه"
  },
  {
    "poem_id": 1494,
    "vorder": 187,
    "position": 0,
    "text": "ز بس نعره و نالهٔ کره‌نای"
  },
  {
    "poem_id": 1494,
    "vorder": 188,
    "position": 1,
    "text": "همی آسمان اندر آمد ز جای"
  },
  {
    "poem_id": 1494,
    "vorder": 189,
    "position": 0,
    "text": "همی سنگ مرجان شد و خاک خون"
  },
  {
    "poem_id": 1494,
    "vorder": 190,
    "position": 1,
    "text": "سراسر سر سروران شد نگون"
  },
  {
    "poem_id": 1494,
    "vorder": 191,
    "position": 0,
    "text": "بکشتند چندان ز هردو گروه"
  },
  {
    "poem_id": 1494,
    "vorder": 192,
    "position": 1,
    "text": "که شد خاک دریا و هامون چو کوه"
  },
  {
    "poem_id": 1494,
    "vorder": 193,
    "position": 0,
    "text": "یکی باد برخاست از رزمگاه"
  },
  {
    "poem_id": 1494,
    "vorder": 194,
    "position": 1,
    "text": "هوا را بپوشید گرد سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 195,
    "position": 0,
    "text": "دو لشکر به هامون همی تاختند"
  },
  {
    "poem_id": 1494,
    "vorder": 196,
    "position": 1,
    "text": "یک از دیگران بازنشناختند"
  },
  {
    "poem_id": 1494,
    "vorder": 197,
    "position": 0,
    "text": "جهان چون شب تیره تاریک شد"
  },
  {
    "poem_id": 1494,
    "vorder": 198,
    "position": 1,
    "text": "تو گفتی به شب روز نزدیک شد"
  },
  {
    "poem_id": 1494,
    "vorder": 199,
    "position": 0,
    "text": "چنین گفت با لشکر افراسیاب"
  },
  {
    "poem_id": 1494,
    "vorder": 200,
    "position": 1,
    "text": "که بیدار بخت اندر آمد به خواب"
  },
  {
    "poem_id": 1494,
    "vorder": 201,
    "position": 0,
    "text": "اگر سستی آرید یک تن به جنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 202,
    "position": 1,
    "text": "نماند مرا روزگار درنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 203,
    "position": 0,
    "text": "بریشان ز هر سو کمین آورید"
  },
  {
    "poem_id": 1494,
    "vorder": 204,
    "position": 1,
    "text": "به نیزه خور اندر زمین آورید"
  },
  {
    "poem_id": 1494,
    "vorder": 205,
    "position": 0,
    "text": "بیامد خود از قلب توران سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 206,
    "position": 1,
    "text": "بر طوس شد داغ دل کینه‌خواه"
  },
  {
    "poem_id": 1494,
    "vorder": 207,
    "position": 0,
    "text": "از ایران فراوان سپه را بکشت"
  },
  {
    "poem_id": 1494,
    "vorder": 208,
    "position": 1,
    "text": "غمی شد دل طوس و بنمود پشت"
  },
  {
    "poem_id": 1494,
    "vorder": 209,
    "position": 0,
    "text": "بر رستم آمد یکی چاره‌جوی"
  },
  {
    "poem_id": 1494,
    "vorder": 210,
    "position": 1,
    "text": "که امروز ازین رزم شد رنگ و بوی"
  },
  {
    "poem_id": 1494,
    "vorder": 211,
    "position": 0,
    "text": "همه رزمگه شد چو دریای خون"
  },
  {
    "poem_id": 1494,
    "vorder": 212,
    "position": 1,
    "text": "درفش سپهدار ایران نگون"
  },
  {
    "poem_id": 1494,
    "vorder": 213,
    "position": 0,
    "text": "بیامد ز قلب سپه پیلتن"
  },
  {
    "poem_id": 1494,
    "vorder": 214,
    "position": 1,
    "text": "پس او فرامرز با انجمن"
  },
  {
    "poem_id": 1494,
    "vorder": 215,
    "position": 0,
    "text": "سپردار بسیار در پیش بود"
  },
  {
    "poem_id": 1494,
    "vorder": 216,
    "position": 1,
    "text": "که دلشان ز رستم بداندیش بود"
  },
  {
    "poem_id": 1494,
    "vorder": 217,
    "position": 0,
    "text": "همه خویش و پیوند افراسیاب"
  },
  {
    "poem_id": 1494,
    "vorder": 218,
    "position": 1,
    "text": "همه دل پر از کین و سر پرشتاب"
  },
  {
    "poem_id": 1494,
    "vorder": 219,
    "position": 0,
    "text": "تهمتن فراوان از ایشان بکشت"
  },
  {
    "poem_id": 1494,
    "vorder": 220,
    "position": 1,
    "text": "فرامرز و طوس اندر آمد به پشت"
  },
  {
    "poem_id": 1494,
    "vorder": 221,
    "position": 0,
    "text": "چو افراسیاب آن درفش بنفش"
  },
  {
    "poem_id": 1494,
    "vorder": 222,
    "position": 1,
    "text": "نگه کرد بر جایگاه درفش"
  },
  {
    "poem_id": 1494,
    "vorder": 223,
    "position": 0,
    "text": "بدانست کان پیلتن رستم است"
  },
  {
    "poem_id": 1494,
    "vorder": 224,
    "position": 1,
    "text": "سرافراز وز تخمهٔ نیرم است"
  },
  {
    "poem_id": 1494,
    "vorder": 225,
    "position": 0,
    "text": "برآشفت بر سان جنگی پلنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 226,
    "position": 1,
    "text": "بیفشارد ران پیش او شد به جنگ"
  },
  {
    "poem_id": 1494,
    "vorder": 227,
    "position": 0,
    "text": "چو رستم درفش سیه را بدید"
  },
  {
    "poem_id": 1494,
    "vorder": 228,
    "position": 1,
    "text": "به کردار شیر ژیان بردمید"
  },
  {
    "poem_id": 1494,
    "vorder": 229,
    "position": 0,
    "text": "به جوش آمد آن نامبردار گرد"
  },
  {
    "poem_id": 1494,
    "vorder": 230,
    "position": 1,
    "text": "عنان بارهٔ تیزتگ را سپرد"
  },
  {
    "poem_id": 1494,
    "vorder": 231,
    "position": 0,
    "text": "برآویخت با سرکش افراسیاب"
  },
  {
    "poem_id": 1494,
    "vorder": 232,
    "position": 1,
    "text": "به پیگار خون رفت چون رود آب"
  },
  {
    "poem_id": 1494,
    "vorder": 233,
    "position": 0,
    "text": "یکی نیزه سالار توران سپاه"
  },
  {
    "poem_id": 1494,
    "vorder": 234,
    "position": 1,
    "text": "بزد بر بر رستم کینه‌خواه"
  },
  {
    "poem_id": 1494,
    "vorder": 235,
    "position": 0,
    "text": "سنان اندر آمد به بند کمر"
  },
  {
    "poem_id": 1494,
    "vorder": 236,
    "position": 1,
    "text": "به ببر بیان بر نبد کارگر"
  },
  {
    "poem_id": 1494,
    "vorder": 237,
    "position": 0,
    "text": "تهمتن به کین اندر آورد روی"
  },
  {
    "poem_id": 1494,
    "vorder": 238,
    "position": 1,
    "text": "یکی نیزه زد بر سر اسپ اوی"
  },
  {
    "poem_id": 1494,
    "vorder": 239,
    "position": 0,
    "text": "تگاور ز درد اندر آمد به سر"
  },
  {
    "poem_id": 1494,
    "vorder": 240,
    "position": 1,
    "text": "بیفتاد زو شاه پرخاشخر"
  },
  {
    "poem_id": 1494,
    "vorder": 241,
    "position": 0,
    "text": "همی جست رستم کمرگاه او"
  },
  {
    "poem_id": 1494,
    "vorder": 242,
    "position": 1,
    "text": "که از رزم کوته کند راه او"
  },
  {
    "poem_id": 1494,
    "vorder": 243,
    "position": 0,
    "text": "نگه کرد هومان بدید از کران"
  },
  {
    "poem_id": 1494,
    "vorder": 244,
    "position": 1,
    "text": "به گردن برآورد گرز گران"
  },
  {
    "poem_id": 1494,
    "vorder": 245,
    "position": 0,
    "text": "بزد بر سر شانهٔ پیلتن"
  },
  {
    "poem_id": 1494,
    "vorder": 246,
    "position": 1,
    "text": "به لشکر خروش آمد از انجمن"
  },
  {
    "poem_id": 1494,
    "vorder": 247,
    "position": 0,
    "text": "ز پس کرد رستم همانگه نگاه"
  },
  {
    "poem_id": 1494,
    "vorder": 248,
    "position": 1,
    "text": "بجست از کفش نامبردار شاه"
  },
  {
    "poem_id": 1494,
    "vorder": 249,
    "position": 0,
    "text": "برآشفت گردافگن تاج‌بخش"
  },
  {
    "poem_id": 1494,
    "vorder": 250,
    "position": 1,
    "text": "به دنبال هومان برانگیخت رخش"
  },
  {
    "poem_id": 1494,
    "vorder": 251,
    "position": 0,
    "text": "بتازید چندی و چندی شتافت"
  },
  {
    "poem_id": 1494,
    "vorder": 252,
    "position": 1,
    "text": "زمانه بدش مانده او را نیافت"
  },
  {
    "poem_id": 1494,
    "vorder": 253,
    "position": 0,
    "text": "سپهدار ترکان نشد زیر دست"
  },
  {
    "poem_id": 1494,
    "vorder": 254,
    "position": 1,
    "text": "یکی بارهٔ تیزتگ برنشست"
  },
  {
    "poem_id": 1494,
    "vorder": 255,
    "position": 0,
    "text": "چو از جنگ رستم بپیچید روی"
  },
  {
    "poem_id": 1494,
    "vorder": 256,
    "position": 1,
    "text": "گریزان همی رفت پرخاشجوی"
  },
  {
    "poem_id": 1494,
    "vorder": 257,
    "position": 0,
    "text": "برآمد ز هر سو دم کرنای"
  },
  {
    "poem_id": 1494,
    "vorder": 258,
    "position": 1,
    "text": "همی آسمان اندر آمد ز جای"
  },
  {
    "poem_id": 1494,
    "vorder": 259,
    "position": 0,
    "text": "به ابر اندر آمد خروش سران"
  },
  {
    "poem_id": 1494,
    "vorder": 260,
    "position": 1,
    "text": "گراییدن گرزهای گران"
  },
  {
    "poem_id": 1494,
    "vorder": 261,
    "position": 0,
    "text": "گوان سر به سر نعره برداشتند"
  },
  {
    "poem_id": 1494,
    "vorder": 262,
    "position": 1,
    "text": "سنانها به ابر اندر افراشتند"
  },
  {
    "poem_id": 1494,
    "vorder": 263,
    "position": 0,
    "text": "زمین سر به سر کشته و خسته بود"
  },
  {
    "poem_id": 1494,
    "vorder": 264,
    "position": 1,
    "text": "وگر لاله بر زعفران رسته بود"
  },
  {
    "poem_id": 1494,
    "vorder": 265,
    "position": 0,
    "text": "سپردند اسپان همی خون به نعل"
  },
  {
    "poem_id": 1494,
    "vorder": 266,
    "position": 1,
    "text": "شده پای پیل از دل کشته لعل"
  },
  {
    "poem_id": 1494,
    "vorder": 267,
    "position": 0,
    "text": "هزیمت گرفتند ترکان چو باد"
  },
  {
    "poem_id": 1494,
    "vorder": 268,
    "position": 1,
    "text": "که رستم ز بازو همی داد داد"
  },
  {
    "poem_id": 1494,
    "vorder": 269,
    "position": 0,
    "text": "سه فرسنگ چون اژدهای دمان"
  },
  {
    "poem_id": 1494,
    "vorder": 270,
    "position": 1,
    "text": "تهمتن همی شد پس بدگمان"
  },
  {
    "poem_id": 1494,
    "vorder": 271,
    "position": 0,
    "text": "وز آن جایگه پیلتن بازگشت"
  },
  {
    "poem_id": 1494,
    "vorder": 272,
    "position": 1,
    "text": "سپه یکسر از جنگ ناساز گشت"
  },
  {
    "poem_id": 1494,
    "vorder": 273,
    "position": 0,
    "text": "ز رستم بپرسید پرمایه طوس"
  },
  {
    "poem_id": 1494,
    "vorder": 274,
    "position": 1,
    "text": "که چون یافت شیر از یکی گور کوس"
  },
  {
    "poem_id": 1494,
    "vorder": 275,
    "position": 0,
    "text": "بدو گفت رستم که گرز گران"
  },
  {
    "poem_id": 1494,
    "vorder": 276,
    "position": 1,
    "text": "چو یاد آرد از یال جنگ‌آوران"
  },
  {
    "poem_id": 1494,
    "vorder": 277,
    "position": 0,
    "text": "دل سنگ و سندان نماند درست"
  },
  {
    "poem_id": 1494,
    "vorder": 278,
    "position": 1,
    "text": "بر و یال کوبنده باید نخست"
  },
  {
    "poem_id": 1494,
    "vorder": 279,
    "position": 0,
    "text": "عمودی که کوبنده هومان بود"
  },
  {
    "poem_id": 1494,
    "vorder": 280,
    "position": 1,
    "text": "تو آهن مخوانش که موم آن بود"
  },
  {
    "poem_id": 1494,
    "vorder": 281,
    "position": 0,
    "text": "به لشکرگه خویش گشتند باز"
  },
  {
    "poem_id": 1494,
    "vorder": 282,
    "position": 1,
    "text": "سپه یکسر از خواسته بی‌نیاز"
  },
  {
    "poem_id": 1494,
    "vorder": 283,
    "position": 0,
    "text": "همه دشت پر آهن و سیم و زر"
  },
  {
    "poem_id": 1494,
    "vorder": 284,
    "position": 1,
    "text": "سنان و ستام و کلاه و کمر"
  }
]