[
  {
    "poem_id": 88092,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید خسرو ز دستان سخن"
  },
  {
    "poem_id": 88092,
    "vorder": 2,
    "position": 1,
    "text": "یکی دانشی پاسخ افگند بن"
  },
  {
    "poem_id": 88092,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت کای پیر پاکیزه مغز"
  },
  {
    "poem_id": 88092,
    "vorder": 4,
    "position": 1,
    "text": "همه رای و گفتارهای تو نغز"
  },
  {
    "poem_id": 88092,
    "vorder": 5,
    "position": 0,
    "text": "ز گاه منوچهر تا این زمان"
  },
  {
    "poem_id": 88092,
    "vorder": 6,
    "position": 1,
    "text": "نه‌ای جز بی‌آزار و نیکی گمان"
  },
  {
    "poem_id": 88092,
    "vorder": 7,
    "position": 0,
    "text": "همان نامور رستم پیلتن"
  },
  {
    "poem_id": 88092,
    "vorder": 8,
    "position": 1,
    "text": "ستون کیان نازش انجمن"
  },
  {
    "poem_id": 88092,
    "vorder": 9,
    "position": 0,
    "text": "سیاووش را پروراننده اوست"
  },
  {
    "poem_id": 88092,
    "vorder": 10,
    "position": 1,
    "text": "بدو نیکویها رساننده اوست"
  },
  {
    "poem_id": 88092,
    "vorder": 11,
    "position": 0,
    "text": "سپاهی که دیدند گوپال او"
  },
  {
    "poem_id": 88092,
    "vorder": 12,
    "position": 1,
    "text": "سر ترگ و برز و فر و یال او"
  },
  {
    "poem_id": 88092,
    "vorder": 13,
    "position": 0,
    "text": "بسی جنگ ناکرده بگریختند"
  },
  {
    "poem_id": 88092,
    "vorder": 14,
    "position": 1,
    "text": "همه دشت تیر و کمان ریختند"
  },
  {
    "poem_id": 88092,
    "vorder": 15,
    "position": 0,
    "text": "به پیش نیاکان من کینه‌خواه"
  },
  {
    "poem_id": 88092,
    "vorder": 16,
    "position": 1,
    "text": "چو دستور فرخ نماینده راه"
  },
  {
    "poem_id": 88092,
    "vorder": 17,
    "position": 0,
    "text": "وگر نام و رنج تو گیرم به یاد"
  },
  {
    "poem_id": 88092,
    "vorder": 18,
    "position": 1,
    "text": "بماند سخن تازه تا صد نژاد"
  },
  {
    "poem_id": 88092,
    "vorder": 19,
    "position": 0,
    "text": "ز گفتار چرب ار پژوهش کنم"
  },
  {
    "poem_id": 88092,
    "vorder": 20,
    "position": 1,
    "text": "ترا این ستایش نکوهش کنم"
  },
  {
    "poem_id": 88092,
    "vorder": 21,
    "position": 0,
    "text": "دگر هرچه پرسیدی از کار من"
  },
  {
    "poem_id": 88092,
    "vorder": 22,
    "position": 1,
    "text": "ز نادادن بار و آزار من"
  },
  {
    "poem_id": 88092,
    "vorder": 23,
    "position": 0,
    "text": "به یزدان یکی آرزو داشتم"
  },
  {
    "poem_id": 88092,
    "vorder": 24,
    "position": 1,
    "text": "جهان را همه خوار بگذاشتم"
  },
  {
    "poem_id": 88092,
    "vorder": 25,
    "position": 0,
    "text": "کنون پنج هفتست تا من به پای"
  },
  {
    "poem_id": 88092,
    "vorder": 26,
    "position": 1,
    "text": "همی خواهم از داور رهنمای"
  },
  {
    "poem_id": 88092,
    "vorder": 27,
    "position": 0,
    "text": "که بخشد گذشته گناه مرا"
  },
  {
    "poem_id": 88092,
    "vorder": 28,
    "position": 1,
    "text": "درخشان کند تیره گاه مرا"
  },
  {
    "poem_id": 88092,
    "vorder": 29,
    "position": 0,
    "text": "برد مر مرا ز این سپنجی سرای"
  },
  {
    "poem_id": 88092,
    "vorder": 30,
    "position": 1,
    "text": "بود در همه نیکوی رهنمای"
  },
  {
    "poem_id": 88092,
    "vorder": 31,
    "position": 0,
    "text": "نماند کز این راستی بگذرم"
  },
  {
    "poem_id": 88092,
    "vorder": 32,
    "position": 1,
    "text": "چو شاهان پیشین یپیچد سرم"
  },
  {
    "poem_id": 88092,
    "vorder": 33,
    "position": 0,
    "text": "کنون یافتم هرچه جستم ز کام"
  },
  {
    "poem_id": 88092,
    "vorder": 34,
    "position": 1,
    "text": "بباید پسیچید کآمد خرام"
  },
  {
    "poem_id": 88092,
    "vorder": 35,
    "position": 0,
    "text": "سحرگه مرا چشم بغنود دوش"
  },
  {
    "poem_id": 88092,
    "vorder": 36,
    "position": 1,
    "text": "ز یزدان بیامد خجسته سروش"
  },
  {
    "poem_id": 88092,
    "vorder": 37,
    "position": 0,
    "text": "که برساز کآمد گه رفتنت"
  },
  {
    "poem_id": 88092,
    "vorder": 38,
    "position": 1,
    "text": "سرآمد نژندی و ناخفتنت"
  },
  {
    "poem_id": 88092,
    "vorder": 39,
    "position": 0,
    "text": "کنون بارگاه من آمد به سر"
  },
  {
    "poem_id": 88092,
    "vorder": 40,
    "position": 1,
    "text": "غم لشکر و تاج و تخت و کمر"
  }
]