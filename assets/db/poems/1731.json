[
  {
    "poem_id": 1731,
    "vorder": 1,
    "position": 0,
    "text": "چو نرسی نشست از بر تخت عاج"
  },
  {
    "poem_id": 1731,
    "vorder": 2,
    "position": 1,
    "text": "به سر بر نهاد آن سزاوار تاج"
  },
  {
    "poem_id": 1731,
    "vorder": 3,
    "position": 0,
    "text": "همه مهتران با نثار آمدند"
  },
  {
    "poem_id": 1731,
    "vorder": 4,
    "position": 1,
    "text": "ز درد پدر سوکوار آمدند"
  },
  {
    "poem_id": 1731,
    "vorder": 5,
    "position": 0,
    "text": "بریشان سپهدار کرد آفرین"
  },
  {
    "poem_id": 1731,
    "vorder": 6,
    "position": 1,
    "text": "که ای مهربانان باداد و دین"
  },
  {
    "poem_id": 1731,
    "vorder": 7,
    "position": 0,
    "text": "بدانید کز کردگار جهان"
  },
  {
    "poem_id": 1731,
    "vorder": 8,
    "position": 1,
    "text": "چنین رفت کار آشکار و نهان"
  },
  {
    "poem_id": 1731,
    "vorder": 9,
    "position": 0,
    "text": "که ما را فزونی خرد داد و شرم"
  },
  {
    "poem_id": 1731,
    "vorder": 10,
    "position": 1,
    "text": "جوانمردی و داد و آواز نرم"
  },
  {
    "poem_id": 1731,
    "vorder": 11,
    "position": 0,
    "text": "همان ایمنی شادمانی بود"
  },
  {
    "poem_id": 1731,
    "vorder": 12,
    "position": 1,
    "text": "کرا ز اخترش مهربانی بود"
  },
  {
    "poem_id": 1731,
    "vorder": 13,
    "position": 0,
    "text": "خردمند مرد ار ترا دوست گشت"
  },
  {
    "poem_id": 1731,
    "vorder": 14,
    "position": 1,
    "text": "چنان دان که با تو ز یک پوست گشت"
  },
  {
    "poem_id": 1731,
    "vorder": 15,
    "position": 0,
    "text": "تو کردار خوب از توانا شناس"
  },
  {
    "poem_id": 1731,
    "vorder": 16,
    "position": 1,
    "text": "خرد نیز نزدیک دانا شناس"
  },
  {
    "poem_id": 1731,
    "vorder": 17,
    "position": 0,
    "text": "دلیری ز هشیار بودن بود"
  },
  {
    "poem_id": 1731,
    "vorder": 18,
    "position": 1,
    "text": "دلاور به جای ستودن بود"
  },
  {
    "poem_id": 1731,
    "vorder": 19,
    "position": 0,
    "text": "هرانکس که بگریزد از کارکرد"
  },
  {
    "poem_id": 1731,
    "vorder": 20,
    "position": 1,
    "text": "ازو دور شد نام و ننگ و نبرد"
  },
  {
    "poem_id": 1731,
    "vorder": 21,
    "position": 0,
    "text": "همان کاهلی مردم از بددلیست"
  },
  {
    "poem_id": 1731,
    "vorder": 22,
    "position": 1,
    "text": "هم‌آواز آن بددلی کاهلیست"
  },
  {
    "poem_id": 1731,
    "vorder": 23,
    "position": 0,
    "text": "همی زیست نه سال با رای و پند"
  },
  {
    "poem_id": 1731,
    "vorder": 24,
    "position": 1,
    "text": "جهان را سخن گفتنش سودمند"
  },
  {
    "poem_id": 1731,
    "vorder": 25,
    "position": 0,
    "text": "چو روزش فراز آمد و بخت شوم"
  },
  {
    "poem_id": 1731,
    "vorder": 26,
    "position": 1,
    "text": "شد آن ترگ پولاد بر سان موم"
  },
  {
    "poem_id": 1731,
    "vorder": 27,
    "position": 0,
    "text": "دوان شد به بالینش شاه اورمزد"
  },
  {
    "poem_id": 1731,
    "vorder": 28,
    "position": 1,
    "text": "به رخشانی لاله اندر فرزد"
  },
  {
    "poem_id": 1731,
    "vorder": 29,
    "position": 0,
    "text": "که فرزند آن نامور شاه بود"
  },
  {
    "poem_id": 1731,
    "vorder": 30,
    "position": 1,
    "text": "فرزوان چو در تیره شب ماه بود"
  },
  {
    "poem_id": 1731,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت کای نازدیده جوان"
  },
  {
    "poem_id": 1731,
    "vorder": 32,
    "position": 1,
    "text": "مبر دست سوی بدی تا توان"
  },
  {
    "poem_id": 1731,
    "vorder": 33,
    "position": 0,
    "text": "تو از جای بهرام و نرسی به بخت"
  },
  {
    "poem_id": 1731,
    "vorder": 34,
    "position": 1,
    "text": "سزاوار تاجی و زیبای تخت"
  },
  {
    "poem_id": 1731,
    "vorder": 35,
    "position": 0,
    "text": "بدین زور و بالا و این فر و یال"
  },
  {
    "poem_id": 1731,
    "vorder": 36,
    "position": 1,
    "text": "بهر دانش از هرکسی بی‌همال"
  },
  {
    "poem_id": 1731,
    "vorder": 37,
    "position": 0,
    "text": "مبادا که تاج از تو گریان شود"
  },
  {
    "poem_id": 1731,
    "vorder": 38,
    "position": 1,
    "text": "دل انجمن بر تو بریان شود"
  },
  {
    "poem_id": 1731,
    "vorder": 39,
    "position": 0,
    "text": "جهان را به آیین شاهان بدار"
  },
  {
    "poem_id": 1731,
    "vorder": 40,
    "position": 1,
    "text": "چو آمختی از پاک پروردگار"
  },
  {
    "poem_id": 1731,
    "vorder": 41,
    "position": 0,
    "text": "به فرجام هم روز تو بگذرد"
  },
  {
    "poem_id": 1731,
    "vorder": 42,
    "position": 1,
    "text": "سپهر روانت به پی بسپرد"
  },
  {
    "poem_id": 1731,
    "vorder": 43,
    "position": 0,
    "text": "چنان رو که پرسند پاسخ کنی"
  },
  {
    "poem_id": 1731,
    "vorder": 44,
    "position": 1,
    "text": "به پاسخ‌گری روز فرخ کنی"
  },
  {
    "poem_id": 1731,
    "vorder": 45,
    "position": 0,
    "text": "بگفت این و چادر به سر درکشید"
  },
  {
    "poem_id": 1731,
    "vorder": 46,
    "position": 1,
    "text": "یکی بادسرد از جگر برکشید"
  },
  {
    "poem_id": 1731,
    "vorder": 47,
    "position": 0,
    "text": "همان روز گفتی که نرسی نبود"
  },
  {
    "poem_id": 1731,
    "vorder": 48,
    "position": 1,
    "text": "همان تخت و دیهیم و کرسی نبود"
  }
]