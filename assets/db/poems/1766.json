[
  {
    "poem_id": 1766,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت بهرام کای مهتران"
  },
  {
    "poem_id": 1766,
    "vorder": 2,
    "position": 1,
    "text": "جهاندیده و سالخورده سران"
  },
  {
    "poem_id": 1766,
    "vorder": 3,
    "position": 0,
    "text": "پدر بر پدر پادشاهی مراست"
  },
  {
    "poem_id": 1766,
    "vorder": 4,
    "position": 1,
    "text": "چرا بخشش اکنون برای شماست"
  },
  {
    "poem_id": 1766,
    "vorder": 5,
    "position": 0,
    "text": "به آواز گفتند ایرانیان"
  },
  {
    "poem_id": 1766,
    "vorder": 6,
    "position": 1,
    "text": "که ما را شکیبا مکن بر زیان"
  },
  {
    "poem_id": 1766,
    "vorder": 7,
    "position": 0,
    "text": "نخواهیم یکسر به شاهی ترا"
  },
  {
    "poem_id": 1766,
    "vorder": 8,
    "position": 1,
    "text": "بر و بوم ما را سپاهی ترا"
  },
  {
    "poem_id": 1766,
    "vorder": 9,
    "position": 0,
    "text": "کزین تخمه پرداغ و دودیم و درد"
  },
  {
    "poem_id": 1766,
    "vorder": 10,
    "position": 1,
    "text": "شب و روز با پیچش و باد سرد"
  },
  {
    "poem_id": 1766,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت بهرام کری رواست"
  },
  {
    "poem_id": 1766,
    "vorder": 12,
    "position": 1,
    "text": "هوا بر دل هرکسی پادشاست"
  },
  {
    "poem_id": 1766,
    "vorder": 13,
    "position": 0,
    "text": "مرا گر نخواهید بی‌رای من"
  },
  {
    "poem_id": 1766,
    "vorder": 14,
    "position": 1,
    "text": "چرا کس نشانید بر جای من"
  },
  {
    "poem_id": 1766,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت موبد که از راه داد"
  },
  {
    "poem_id": 1766,
    "vorder": 16,
    "position": 1,
    "text": "نه خسرو گریزد نه کهتر نژاد"
  },
  {
    "poem_id": 1766,
    "vorder": 17,
    "position": 0,
    "text": "تو از ما یکی باش و شاهی گزین"
  },
  {
    "poem_id": 1766,
    "vorder": 18,
    "position": 1,
    "text": "که خوانند هرکس برو آفرین"
  },
  {
    "poem_id": 1766,
    "vorder": 19,
    "position": 0,
    "text": "سه روز اندران کار شد روزگار"
  },
  {
    "poem_id": 1766,
    "vorder": 20,
    "position": 1,
    "text": "که جویند ز ایران یکی شهریار"
  },
  {
    "poem_id": 1766,
    "vorder": 21,
    "position": 0,
    "text": "نوشتند پس نام صد نامور"
  },
  {
    "poem_id": 1766,
    "vorder": 22,
    "position": 1,
    "text": "فروزندهٔ تاج و تخت و کمر"
  },
  {
    "poem_id": 1766,
    "vorder": 23,
    "position": 0,
    "text": "ازان صد یکی نام بهرام بود"
  },
  {
    "poem_id": 1766,
    "vorder": 24,
    "position": 1,
    "text": "که در پادشاهی دلارام بود"
  },
  {
    "poem_id": 1766,
    "vorder": 25,
    "position": 0,
    "text": "ازین صد به پنجاه بازآمدند"
  },
  {
    "poem_id": 1766,
    "vorder": 26,
    "position": 1,
    "text": "پر از چاره و پرنیاز آمدند"
  },
  {
    "poem_id": 1766,
    "vorder": 27,
    "position": 0,
    "text": "ز پنجاه بهرام بود از نخست"
  },
  {
    "poem_id": 1766,
    "vorder": 28,
    "position": 1,
    "text": "اگر جست پای پدر گر نجست"
  },
  {
    "poem_id": 1766,
    "vorder": 29,
    "position": 0,
    "text": "ز پنجاه بازآوریدند سی"
  },
  {
    "poem_id": 1766,
    "vorder": 30,
    "position": 1,
    "text": "ز ایرانی و رومی و پارسی"
  },
  {
    "poem_id": 1766,
    "vorder": 31,
    "position": 0,
    "text": "ز سی نیز بهرام بد پیش رو"
  },
  {
    "poem_id": 1766,
    "vorder": 32,
    "position": 1,
    "text": "که هم تاجور بود و هم شیر نو"
  },
  {
    "poem_id": 1766,
    "vorder": 33,
    "position": 0,
    "text": "ز سی کرد داننده موبد چهار"
  },
  {
    "poem_id": 1766,
    "vorder": 34,
    "position": 1,
    "text": "وزین چار بهرام بد شهریار"
  },
  {
    "poem_id": 1766,
    "vorder": 35,
    "position": 0,
    "text": "چو تنگ اندرآمد ز شاهی سخن"
  },
  {
    "poem_id": 1766,
    "vorder": 36,
    "position": 1,
    "text": "ز ایرانیان هرک او بد کهن"
  },
  {
    "poem_id": 1766,
    "vorder": 37,
    "position": 0,
    "text": "نخواهیم گفتند بهرام را"
  },
  {
    "poem_id": 1766,
    "vorder": 38,
    "position": 1,
    "text": "دلیر و سبکسار و خودکام را"
  },
  {
    "poem_id": 1766,
    "vorder": 39,
    "position": 0,
    "text": "خروشی برآمد میان سران"
  },
  {
    "poem_id": 1766,
    "vorder": 40,
    "position": 1,
    "text": "دل هرکسی تیز گشت اندران"
  },
  {
    "poem_id": 1766,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت منذر به ایرانیان"
  },
  {
    "poem_id": 1766,
    "vorder": 42,
    "position": 1,
    "text": "که خواهم که دانم به سود و زیان"
  },
  {
    "poem_id": 1766,
    "vorder": 43,
    "position": 0,
    "text": "کزین سال ناخورده شاه جوان"
  },
  {
    "poem_id": 1766,
    "vorder": 44,
    "position": 1,
    "text": "چرایید پر درد و تیره‌روان"
  },
  {
    "poem_id": 1766,
    "vorder": 45,
    "position": 0,
    "text": "بزرگان به پاسخ بیاراستند"
  },
  {
    "poem_id": 1766,
    "vorder": 46,
    "position": 1,
    "text": "بسی خسته دل پارسی خواستند"
  },
  {
    "poem_id": 1766,
    "vorder": 47,
    "position": 0,
    "text": "ز ایران کرا خسته بد یزدگرد"
  },
  {
    "poem_id": 1766,
    "vorder": 48,
    "position": 1,
    "text": "یکایک بران دشت کردند گرد"
  },
  {
    "poem_id": 1766,
    "vorder": 49,
    "position": 0,
    "text": "بریده یکی را دو دست و دو پای"
  },
  {
    "poem_id": 1766,
    "vorder": 50,
    "position": 1,
    "text": "یکی مانده بر جای و جانش به جای"
  },
  {
    "poem_id": 1766,
    "vorder": 51,
    "position": 0,
    "text": "یکی را دو دست و دو گوش و زبان"
  },
  {
    "poem_id": 1766,
    "vorder": 52,
    "position": 1,
    "text": "بریده شده چون تن بی‌روان"
  },
  {
    "poem_id": 1766,
    "vorder": 53,
    "position": 0,
    "text": "یکی را ز تن دور کرده دو کفت"
  },
  {
    "poem_id": 1766,
    "vorder": 54,
    "position": 1,
    "text": "ازان مردمان ماند منذر شگفت"
  },
  {
    "poem_id": 1766,
    "vorder": 55,
    "position": 0,
    "text": "یکی را به مسمار کنده دو چشم"
  },
  {
    "poem_id": 1766,
    "vorder": 56,
    "position": 1,
    "text": "چو منذر بدید آن برآورد خشم"
  },
  {
    "poem_id": 1766,
    "vorder": 57,
    "position": 0,
    "text": "غمی گشت زان کار بهرام سخت"
  },
  {
    "poem_id": 1766,
    "vorder": 58,
    "position": 1,
    "text": "به خاک پدر گفت کای شوربخت"
  },
  {
    "poem_id": 1766,
    "vorder": 59,
    "position": 0,
    "text": "اگر چشم شادیت بر دوختی"
  },
  {
    "poem_id": 1766,
    "vorder": 60,
    "position": 1,
    "text": "روان را به آتش چرا سوختی"
  },
  {
    "poem_id": 1766,
    "vorder": 61,
    "position": 0,
    "text": "جهانجوی منذر به بهرام گفت"
  },
  {
    "poem_id": 1766,
    "vorder": 62,
    "position": 1,
    "text": "که این بد بریشان نباید نهفت"
  },
  {
    "poem_id": 1766,
    "vorder": 63,
    "position": 0,
    "text": "سخنها شنیدی تو پاسخ‌گزار"
  },
  {
    "poem_id": 1766,
    "vorder": 64,
    "position": 1,
    "text": "که تندی نه خوب آید از شهریار"
  }
]