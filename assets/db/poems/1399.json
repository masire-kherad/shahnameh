[
  {
    "poem_id": 1399,
    "vorder": 1,
    "position": 0,
    "text": "پس آن نامهٔ سام پاسخ نوشت"
  },
  {
    "poem_id": 1399,
    "vorder": 2,
    "position": 1,
    "text": "شگفتی سخنهای فرخ نوشت"
  },
  {
    "poem_id": 1399,
    "vorder": 3,
    "position": 0,
    "text": "که ای نامور پهلوان دلیر"
  },
  {
    "poem_id": 1399,
    "vorder": 4,
    "position": 1,
    "text": "به هر کار پیروز برسان شیر"
  },
  {
    "poem_id": 1399,
    "vorder": 5,
    "position": 0,
    "text": "نبیند چو تو نیز گردان سپهر"
  },
  {
    "poem_id": 1399,
    "vorder": 6,
    "position": 1,
    "text": "به رزم و به بزم و به رای و به چهر"
  },
  {
    "poem_id": 1399,
    "vorder": 7,
    "position": 0,
    "text": "همان پور فرخنده زال سوار"
  },
  {
    "poem_id": 1399,
    "vorder": 8,
    "position": 1,
    "text": "کزو ماند اندر جهان یادگار"
  },
  {
    "poem_id": 1399,
    "vorder": 9,
    "position": 0,
    "text": "رسید و بدانستم از کام او"
  },
  {
    "poem_id": 1399,
    "vorder": 10,
    "position": 1,
    "text": "همان خواهش و رای و آرام او"
  },
  {
    "poem_id": 1399,
    "vorder": 11,
    "position": 0,
    "text": "برآمد هر آنچ آن ترا کام بود"
  },
  {
    "poem_id": 1399,
    "vorder": 12,
    "position": 1,
    "text": "همان زال را رای و آرام بود"
  },
  {
    "poem_id": 1399,
    "vorder": 13,
    "position": 0,
    "text": "همه آرزوها سپردم بدوی"
  },
  {
    "poem_id": 1399,
    "vorder": 14,
    "position": 1,
    "text": "بسی روز فرخ شمردم بدوی"
  },
  {
    "poem_id": 1399,
    "vorder": 15,
    "position": 0,
    "text": "ز شیری که باشد شکارش پلنگ"
  },
  {
    "poem_id": 1399,
    "vorder": 16,
    "position": 1,
    "text": "چه زاید جز از شیر شرزه به جنگ"
  },
  {
    "poem_id": 1399,
    "vorder": 17,
    "position": 0,
    "text": "گسی کردمش با دلی شادمان"
  },
  {
    "poem_id": 1399,
    "vorder": 18,
    "position": 1,
    "text": "کزو دور بادا بد بدگمان"
  },
  {
    "poem_id": 1399,
    "vorder": 19,
    "position": 0,
    "text": "برون رفت با فرخی زال زر"
  },
  {
    "poem_id": 1399,
    "vorder": 20,
    "position": 1,
    "text": "ز گردان لشکر برآورده سر"
  },
  {
    "poem_id": 1399,
    "vorder": 21,
    "position": 0,
    "text": "نوندی برافگند نزدیک سام"
  },
  {
    "poem_id": 1399,
    "vorder": 22,
    "position": 1,
    "text": "که برگشتم از شاه دل شادکام"
  },
  {
    "poem_id": 1399,
    "vorder": 23,
    "position": 0,
    "text": "ابا خلعت خسروانی و تاج"
  },
  {
    "poem_id": 1399,
    "vorder": 24,
    "position": 1,
    "text": "همان یاره و طوق و هم تخت عاج"
  },
  {
    "poem_id": 1399,
    "vorder": 25,
    "position": 0,
    "text": "چنان شاد شد زان سخن پهلوان"
  },
  {
    "poem_id": 1399,
    "vorder": 26,
    "position": 1,
    "text": "که با پیر سر شد به نوی جوان"
  },
  {
    "poem_id": 1399,
    "vorder": 27,
    "position": 0,
    "text": "سواری به کابل برافگند زود"
  },
  {
    "poem_id": 1399,
    "vorder": 28,
    "position": 1,
    "text": "به مهراب گفت آن کجا رفته بود"
  },
  {
    "poem_id": 1399,
    "vorder": 29,
    "position": 0,
    "text": "نوازیدن شهریار جهان"
  },
  {
    "poem_id": 1399,
    "vorder": 30,
    "position": 1,
    "text": "وزان شادمانی که رفت از مهان"
  },
  {
    "poem_id": 1399,
    "vorder": 31,
    "position": 0,
    "text": "من اینک چو دستان بر من رسد"
  },
  {
    "poem_id": 1399,
    "vorder": 32,
    "position": 1,
    "text": "گذاریم هر دو چنان چون سزد"
  },
  {
    "poem_id": 1399,
    "vorder": 33,
    "position": 0,
    "text": "چنان شاد شد شاه کابلستان"
  },
  {
    "poem_id": 1399,
    "vorder": 34,
    "position": 1,
    "text": "ز پیوند خورشید زابلستان"
  },
  {
    "poem_id": 1399,
    "vorder": 35,
    "position": 0,
    "text": "که گفتی همی جان برافشاندند"
  },
  {
    "poem_id": 1399,
    "vorder": 36,
    "position": 1,
    "text": "ز هر جای رامشگران خواندند"
  },
  {
    "poem_id": 1399,
    "vorder": 37,
    "position": 0,
    "text": "چو مهراب شد شاد و روشن روان"
  },
  {
    "poem_id": 1399,
    "vorder": 38,
    "position": 1,
    "text": "لبش گشت خندان و دل شادمان"
  },
  {
    "poem_id": 1399,
    "vorder": 39,
    "position": 0,
    "text": "گرانمایه سیندخت را پیش خواند"
  },
  {
    "poem_id": 1399,
    "vorder": 40,
    "position": 1,
    "text": "بسی خوب گفتار با او براند"
  },
  {
    "poem_id": 1399,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت کای جفت فرخنده رای"
  },
  {
    "poem_id": 1399,
    "vorder": 42,
    "position": 1,
    "text": "بیفروخت از رایت این تیره جای"
  },
  {
    "poem_id": 1399,
    "vorder": 43,
    "position": 0,
    "text": "به شاخی زدی دست کاندر زمین"
  },
  {
    "poem_id": 1399,
    "vorder": 44,
    "position": 1,
    "text": "برو شهریاران کنند آفرین"
  },
  {
    "poem_id": 1399,
    "vorder": 45,
    "position": 0,
    "text": "چنان هم کجا ساختی از نخست"
  },
  {
    "poem_id": 1399,
    "vorder": 46,
    "position": 1,
    "text": "بیاید مر این را سرانجام جست"
  },
  {
    "poem_id": 1399,
    "vorder": 47,
    "position": 0,
    "text": "همه گنج پیش تو آراستست"
  },
  {
    "poem_id": 1399,
    "vorder": 48,
    "position": 1,
    "text": "اگر تخت عاجست اگر خواستست"
  },
  {
    "poem_id": 1399,
    "vorder": 49,
    "position": 0,
    "text": "چو بشنید سیندخت ازو گشت باز"
  },
  {
    "poem_id": 1399,
    "vorder": 50,
    "position": 1,
    "text": "بر دختر آمد سراینده راز"
  },
  {
    "poem_id": 1399,
    "vorder": 51,
    "position": 0,
    "text": "همی مژده دادش به دیدار زال"
  },
  {
    "poem_id": 1399,
    "vorder": 52,
    "position": 1,
    "text": "که دیدی چنان چون بباید همال"
  },
  {
    "poem_id": 1399,
    "vorder": 53,
    "position": 0,
    "text": "زن و مرد را از بلندی منش"
  },
  {
    "poem_id": 1399,
    "vorder": 54,
    "position": 1,
    "text": "سزد گر فرازد سر از سرزنش"
  },
  {
    "poem_id": 1399,
    "vorder": 55,
    "position": 0,
    "text": "سوی کام دل تیز بشتافتی"
  },
  {
    "poem_id": 1399,
    "vorder": 56,
    "position": 1,
    "text": "کنون هر چه جستی همه یافتی"
  },
  {
    "poem_id": 1399,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت رودابه ای شاه زن"
  },
  {
    "poem_id": 1399,
    "vorder": 58,
    "position": 1,
    "text": "سزای ستایش به هر انجمن"
  },
  {
    "poem_id": 1399,
    "vorder": 59,
    "position": 0,
    "text": "من از خاک پای تو بالین کنم"
  },
  {
    "poem_id": 1399,
    "vorder": 60,
    "position": 1,
    "text": "به فرمانت آرایش دین کنم"
  },
  {
    "poem_id": 1399,
    "vorder": 61,
    "position": 0,
    "text": "ز تو چشم آهرمنان دور باد"
  },
  {
    "poem_id": 1399,
    "vorder": 62,
    "position": 1,
    "text": "دل و جان تو خانهٔ سور باد"
  },
  {
    "poem_id": 1399,
    "vorder": 63,
    "position": 0,
    "text": "چو بشنید سیندخت گفتار اوی"
  },
  {
    "poem_id": 1399,
    "vorder": 64,
    "position": 1,
    "text": "به آرایش کاخ بنهاد روی"
  },
  {
    "poem_id": 1399,
    "vorder": 65,
    "position": 0,
    "text": "بیاراست ایوانها چون بهشت"
  },
  {
    "poem_id": 1399,
    "vorder": 66,
    "position": 1,
    "text": "گلاب و می و مشک و عنبر سرشت"
  },
  {
    "poem_id": 1399,
    "vorder": 67,
    "position": 0,
    "text": "بساطی بیفگند پیکر به زر"
  },
  {
    "poem_id": 1399,
    "vorder": 68,
    "position": 1,
    "text": "زبر جد برو بافته سر به سر"
  },
  {
    "poem_id": 1399,
    "vorder": 69,
    "position": 0,
    "text": "دگر پیکرش در خوشاب بود"
  },
  {
    "poem_id": 1399,
    "vorder": 70,
    "position": 1,
    "text": "که هر دانه‌ای قطره‌ای آب بود"
  },
  {
    "poem_id": 1399,
    "vorder": 71,
    "position": 0,
    "text": "یک ایوان همه تخت زرین نهاد"
  },
  {
    "poem_id": 1399,
    "vorder": 72,
    "position": 1,
    "text": "به آیین و آرایش چین نهاد"
  },
  {
    "poem_id": 1399,
    "vorder": 73,
    "position": 0,
    "text": "همه پیکرش گوهر آگنده بود"
  },
  {
    "poem_id": 1399,
    "vorder": 74,
    "position": 1,
    "text": "میان گهر نقشها کنده بود"
  },
  {
    "poem_id": 1399,
    "vorder": 75,
    "position": 0,
    "text": "ز یاقوت مر تخت را پایه بود"
  },
  {
    "poem_id": 1399,
    "vorder": 76,
    "position": 1,
    "text": "که تخت کیان بود و پرمایه بود"
  },
  {
    "poem_id": 1399,
    "vorder": 77,
    "position": 0,
    "text": "یک ایوان همه جامهٔ رود و می"
  },
  {
    "poem_id": 1399,
    "vorder": 78,
    "position": 1,
    "text": "بیاورده از پارس و اهواز و ری"
  },
  {
    "poem_id": 1399,
    "vorder": 79,
    "position": 0,
    "text": "بیاراست رودابه را چون نگار"
  },
  {
    "poem_id": 1399,
    "vorder": 80,
    "position": 1,
    "text": "پر از جامه و رنگ و بوی بهار"
  },
  {
    "poem_id": 1399,
    "vorder": 81,
    "position": 0,
    "text": "همه کابلستان شد آراسته"
  },
  {
    "poem_id": 1399,
    "vorder": 82,
    "position": 1,
    "text": "پر از رنگ و بوی و پر از خواسته"
  },
  {
    "poem_id": 1399,
    "vorder": 83,
    "position": 0,
    "text": "همه پشت پیلان بیاراستند"
  },
  {
    "poem_id": 1399,
    "vorder": 84,
    "position": 1,
    "text": "ز کابل پرستندگان خواستند"
  },
  {
    "poem_id": 1399,
    "vorder": 85,
    "position": 0,
    "text": "نشستند بر پیل رامشگران"
  },
  {
    "poem_id": 1399,
    "vorder": 86,
    "position": 1,
    "text": "نهاده به سر بر زر افسران"
  },
  {
    "poem_id": 1399,
    "vorder": 87,
    "position": 0,
    "text": "پذیره شدن را بیاراستند"
  },
  {
    "poem_id": 1399,
    "vorder": 88,
    "position": 1,
    "text": "نثارش همه مشک و زر خواستند"
  }
]