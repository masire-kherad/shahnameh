[
  {
    "poem_id": 1611,
    "vorder": 1,
    "position": 0,
    "text": "فرامرز چون سوک رستم بداشت"
  },
  {
    "poem_id": 1611,
    "vorder": 2,
    "position": 1,
    "text": "سپه را همه سوی هامون گذاشت"
  },
  {
    "poem_id": 1611,
    "vorder": 3,
    "position": 0,
    "text": "در خانهٔ پیلتن باز کرد"
  },
  {
    "poem_id": 1611,
    "vorder": 4,
    "position": 1,
    "text": "سپه را ز گنج پدر ساز کرد"
  },
  {
    "poem_id": 1611,
    "vorder": 5,
    "position": 0,
    "text": "سحرگه خروش آمد از کرنای"
  },
  {
    "poem_id": 1611,
    "vorder": 6,
    "position": 1,
    "text": "هم از کوس و رویین و هندی درای"
  },
  {
    "poem_id": 1611,
    "vorder": 7,
    "position": 0,
    "text": "سپاهی ز زابل به کابل کشید"
  },
  {
    "poem_id": 1611,
    "vorder": 8,
    "position": 1,
    "text": "که خورشید گشت از جهان ناپدید"
  },
  {
    "poem_id": 1611,
    "vorder": 9,
    "position": 0,
    "text": "چو آگاه شد شاه کابلستان"
  },
  {
    "poem_id": 1611,
    "vorder": 10,
    "position": 1,
    "text": "ازان نامداران زابلستان"
  },
  {
    "poem_id": 1611,
    "vorder": 11,
    "position": 0,
    "text": "سپاه پراگنده را گرد کرد"
  },
  {
    "poem_id": 1611,
    "vorder": 12,
    "position": 1,
    "text": "زمین آهنین شد هوا لاژورد"
  },
  {
    "poem_id": 1611,
    "vorder": 13,
    "position": 0,
    "text": "پذیرهٔ فرامرز شد با سپاه"
  },
  {
    "poem_id": 1611,
    "vorder": 14,
    "position": 1,
    "text": "بشد روشنایی ز خورشید و ماه"
  },
  {
    "poem_id": 1611,
    "vorder": 15,
    "position": 0,
    "text": "سپه را چو روی اندر آمد به روی"
  },
  {
    "poem_id": 1611,
    "vorder": 16,
    "position": 1,
    "text": "جهان شد پرآواز پرخاشجوی"
  },
  {
    "poem_id": 1611,
    "vorder": 17,
    "position": 0,
    "text": "ز انبوه پیلان و گرد سپاه"
  },
  {
    "poem_id": 1611,
    "vorder": 18,
    "position": 1,
    "text": "به بیشه درون شیر گم گرد راه"
  },
  {
    "poem_id": 1611,
    "vorder": 19,
    "position": 0,
    "text": "برآمد یکی باد و گردی کبود"
  },
  {
    "poem_id": 1611,
    "vorder": 20,
    "position": 1,
    "text": "زمین ز آسمان هیچ پیدا نبود"
  },
  {
    "poem_id": 1611,
    "vorder": 21,
    "position": 0,
    "text": "بیامد فرامرز پیش سپاه"
  },
  {
    "poem_id": 1611,
    "vorder": 22,
    "position": 1,
    "text": "دو دیده نبرداشت از روی شاه"
  },
  {
    "poem_id": 1611,
    "vorder": 23,
    "position": 0,
    "text": "چو برخاست آواز کوس از دو روی"
  },
  {
    "poem_id": 1611,
    "vorder": 24,
    "position": 1,
    "text": "بی‌آرام شد مردم جنگجوی"
  },
  {
    "poem_id": 1611,
    "vorder": 25,
    "position": 0,
    "text": "فرامرز با خوارمایه سپاه"
  },
  {
    "poem_id": 1611,
    "vorder": 26,
    "position": 1,
    "text": "بزد خویشتن را بر آن قلبگاه"
  },
  {
    "poem_id": 1611,
    "vorder": 27,
    "position": 0,
    "text": "ز گرد سواران هوا تار شد"
  },
  {
    "poem_id": 1611,
    "vorder": 28,
    "position": 1,
    "text": "سپهدار کابل گرفتار شد"
  },
  {
    "poem_id": 1611,
    "vorder": 29,
    "position": 0,
    "text": "پراگنده شد آن سپاه بزرگ"
  },
  {
    "poem_id": 1611,
    "vorder": 30,
    "position": 1,
    "text": "دلیران زابل به کردار گرگ"
  },
  {
    "poem_id": 1611,
    "vorder": 31,
    "position": 0,
    "text": "ز هر سو بریشان کمین ساختند"
  },
  {
    "poem_id": 1611,
    "vorder": 32,
    "position": 1,
    "text": "پس لشکراندر همی تاختند"
  },
  {
    "poem_id": 1611,
    "vorder": 33,
    "position": 0,
    "text": "بکشتند چندان ز گردان هند"
  },
  {
    "poem_id": 1611,
    "vorder": 34,
    "position": 1,
    "text": "هم از بر منش نامداران سند"
  },
  {
    "poem_id": 1611,
    "vorder": 35,
    "position": 0,
    "text": "که گل شد همی خاک آوردگاه"
  },
  {
    "poem_id": 1611,
    "vorder": 36,
    "position": 1,
    "text": "پراگنده شد هند و سندی سپاه"
  },
  {
    "poem_id": 1611,
    "vorder": 37,
    "position": 0,
    "text": "دل از مرز وز خانه برداشتند"
  },
  {
    "poem_id": 1611,
    "vorder": 38,
    "position": 1,
    "text": "زن و کودک خرد بگذاشتند"
  },
  {
    "poem_id": 1611,
    "vorder": 39,
    "position": 0,
    "text": "تن مهتر کابلی پر ز خون"
  },
  {
    "poem_id": 1611,
    "vorder": 40,
    "position": 1,
    "text": "فگنده به صندوق پیل اندرون"
  },
  {
    "poem_id": 1611,
    "vorder": 41,
    "position": 0,
    "text": "بیاورد لشکر به نخچیرگاه"
  },
  {
    "poem_id": 1611,
    "vorder": 42,
    "position": 1,
    "text": "به جایی کجا کنده بودند چاه"
  },
  {
    "poem_id": 1611,
    "vorder": 43,
    "position": 0,
    "text": "همی برد بدخواه را بسته دست"
  },
  {
    "poem_id": 1611,
    "vorder": 44,
    "position": 1,
    "text": "ز خویشان او نیز چل بت‌پرست"
  },
  {
    "poem_id": 1611,
    "vorder": 45,
    "position": 0,
    "text": "ز پشت سپهبد زهی برکشید"
  },
  {
    "poem_id": 1611,
    "vorder": 46,
    "position": 1,
    "text": "چنان کاستخوان و پی آمد پدید"
  },
  {
    "poem_id": 1611,
    "vorder": 47,
    "position": 0,
    "text": "ز چاه اندر آویختنش سرنگون"
  },
  {
    "poem_id": 1611,
    "vorder": 48,
    "position": 1,
    "text": "تنش پر ز خاک و دهن پر ز خون"
  },
  {
    "poem_id": 1611,
    "vorder": 49,
    "position": 0,
    "text": "چهل خویش او را بر آتش نهاد"
  },
  {
    "poem_id": 1611,
    "vorder": 50,
    "position": 1,
    "text": "ازان جایگه رفت سوی شغاد"
  },
  {
    "poem_id": 1611,
    "vorder": 51,
    "position": 0,
    "text": "به کردار کوه آتشی برفروخت"
  },
  {
    "poem_id": 1611,
    "vorder": 52,
    "position": 1,
    "text": "شغاد و چنار و زمین را بسوخت"
  },
  {
    "poem_id": 1611,
    "vorder": 53,
    "position": 0,
    "text": "چو لشکر سوی زابلستان کشید"
  },
  {
    "poem_id": 1611,
    "vorder": 54,
    "position": 1,
    "text": "همه خاک را سوی دستان کشید"
  },
  {
    "poem_id": 1611,
    "vorder": 55,
    "position": 0,
    "text": "چو روز جفاپیشه کوتاه کرد"
  },
  {
    "poem_id": 1611,
    "vorder": 56,
    "position": 1,
    "text": "به کابل یکی مهتری شاه کرد"
  },
  {
    "poem_id": 1611,
    "vorder": 57,
    "position": 0,
    "text": "ازان دودمان کس به کابل نماند"
  },
  {
    "poem_id": 1611,
    "vorder": 58,
    "position": 1,
    "text": "که منشور تیغ ورا برنخواند"
  },
  {
    "poem_id": 1611,
    "vorder": 59,
    "position": 0,
    "text": "ز کابل بیامد پر از داغ و دود"
  },
  {
    "poem_id": 1611,
    "vorder": 60,
    "position": 1,
    "text": "شده روز روشن بروبر کبود"
  },
  {
    "poem_id": 1611,
    "vorder": 61,
    "position": 0,
    "text": "خروشان همه زابلستان و بست"
  },
  {
    "poem_id": 1611,
    "vorder": 62,
    "position": 1,
    "text": "یکی را نبد جامه بر تن درست"
  },
  {
    "poem_id": 1611,
    "vorder": 63,
    "position": 0,
    "text": "به پیش فرامرز باز آمدند"
  },
  {
    "poem_id": 1611,
    "vorder": 64,
    "position": 1,
    "text": "دریده بر و با گداز آمدند"
  },
  {
    "poem_id": 1611,
    "vorder": 65,
    "position": 0,
    "text": "به یک سال در سیستان سوک بود"
  },
  {
    "poem_id": 1611,
    "vorder": 66,
    "position": 1,
    "text": "همه جامه‌هاشان سیاه و کبود"
  }
]