[
  {
    "poem_id": 88071,
    "vorder": 1,
    "position": 0,
    "text": "دو هفته بر این گونه شادان بزیست"
  },
  {
    "poem_id": 88071,
    "vorder": 2,
    "position": 1,
    "text": "که داند که فردا دل‌افروز کیست"
  },
  {
    "poem_id": 88071,
    "vorder": 3,
    "position": 0,
    "text": "سیم هفته کیخسرو آمد به گنگ"
  },
  {
    "poem_id": 88071,
    "vorder": 4,
    "position": 1,
    "text": "شنید آن غو نای و آوای چنگ"
  },
  {
    "poem_id": 88071,
    "vorder": 5,
    "position": 0,
    "text": "بخندید و برگشت گرد حصار"
  },
  {
    "poem_id": 88071,
    "vorder": 6,
    "position": 1,
    "text": "بماند اندر آن گردش روزگار"
  },
  {
    "poem_id": 88071,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت کان کو چنین باره کرد"
  },
  {
    "poem_id": 88071,
    "vorder": 8,
    "position": 1,
    "text": "نه از بهر پیکار پتیاره کرد"
  },
  {
    "poem_id": 88071,
    "vorder": 9,
    "position": 0,
    "text": "چو خون سر شاه ایران بریخت"
  },
  {
    "poem_id": 88071,
    "vorder": 10,
    "position": 1,
    "text": "به ما بر چنین آتش کین ببیخت"
  },
  {
    "poem_id": 88071,
    "vorder": 11,
    "position": 0,
    "text": "شگفت آمدش کانچنان جای دید"
  },
  {
    "poem_id": 88071,
    "vorder": 12,
    "position": 1,
    "text": "سپهری دلارام بر پای دید"
  },
  {
    "poem_id": 88071,
    "vorder": 13,
    "position": 0,
    "text": "به رستم چنین گفت کای پهلوان"
  },
  {
    "poem_id": 88071,
    "vorder": 14,
    "position": 1,
    "text": "سزد گر ببینی به روشن روان"
  },
  {
    "poem_id": 88071,
    "vorder": 15,
    "position": 0,
    "text": "که با ما جهاندار یزدان چه کرد"
  },
  {
    "poem_id": 88071,
    "vorder": 16,
    "position": 1,
    "text": "ز خوبی و پیروزی اندر نبرد"
  },
  {
    "poem_id": 88071,
    "vorder": 17,
    "position": 0,
    "text": "بدی را کجا نام بد بر بدی"
  },
  {
    "poem_id": 88071,
    "vorder": 18,
    "position": 1,
    "text": "به تندی و کژی و نابخردی"
  },
  {
    "poem_id": 88071,
    "vorder": 19,
    "position": 0,
    "text": "گریزان شد از دست ما بر حصار"
  },
  {
    "poem_id": 88071,
    "vorder": 20,
    "position": 1,
    "text": "بر این سان برآسود از روزگار"
  },
  {
    "poem_id": 88071,
    "vorder": 21,
    "position": 0,
    "text": "بدی کو بد آن جهان را سرست"
  },
  {
    "poem_id": 88071,
    "vorder": 22,
    "position": 1,
    "text": "به پیری رسیده کنون بترست"
  },
  {
    "poem_id": 88071,
    "vorder": 23,
    "position": 0,
    "text": "بدین گر ندارم ز یزدان سپاس"
  },
  {
    "poem_id": 88071,
    "vorder": 24,
    "position": 1,
    "text": "مبادا که شب زنده باشم سه پاس"
  },
  {
    "poem_id": 88071,
    "vorder": 25,
    "position": 0,
    "text": "کز اویست پیروزی و دستگاه"
  },
  {
    "poem_id": 88071,
    "vorder": 26,
    "position": 1,
    "text": "هم او آفرینندهٔ هور و ماه"
  },
  {
    "poem_id": 88071,
    "vorder": 27,
    "position": 0,
    "text": "ز یک سوی آن شارستان کوه بود"
  },
  {
    "poem_id": 88071,
    "vorder": 28,
    "position": 1,
    "text": "ز پیکار لشکر بی اندوه بود"
  },
  {
    "poem_id": 88071,
    "vorder": 29,
    "position": 0,
    "text": "به روی دگر بودش آب روان"
  },
  {
    "poem_id": 88071,
    "vorder": 30,
    "position": 1,
    "text": "که روشن شدی مرد را زو روان"
  },
  {
    "poem_id": 88071,
    "vorder": 31,
    "position": 0,
    "text": "کشیدند بر دشت پرده سرای"
  },
  {
    "poem_id": 88071,
    "vorder": 32,
    "position": 1,
    "text": "ز هر سوی دژ پهلوانی به پای"
  },
  {
    "poem_id": 88071,
    "vorder": 33,
    "position": 0,
    "text": "زمین هفت فرسنگ لشکر گرفت"
  },
  {
    "poem_id": 88071,
    "vorder": 34,
    "position": 1,
    "text": "ز لشکر زمین دست بر سر گرفت"
  },
  {
    "poem_id": 88071,
    "vorder": 35,
    "position": 0,
    "text": "سراپرده زد رستم از دست راست"
  },
  {
    "poem_id": 88071,
    "vorder": 36,
    "position": 1,
    "text": "ز شاه جهاندار لشکر بخواست"
  },
  {
    "poem_id": 88071,
    "vorder": 37,
    "position": 0,
    "text": "به چپ بر فریبرز کاووس بود"
  },
  {
    "poem_id": 88071,
    "vorder": 38,
    "position": 1,
    "text": "دل‌افروز با بوق و با کوس بود"
  },
  {
    "poem_id": 88071,
    "vorder": 39,
    "position": 0,
    "text": "برفتند و بردند پرده‌سرای"
  },
  {
    "poem_id": 88071,
    "vorder": 40,
    "position": 1,
    "text": "سیم روی گودرز بگزید جای"
  },
  {
    "poem_id": 88071,
    "vorder": 41,
    "position": 0,
    "text": "شب آمد بر آمد ز هر سو خروش"
  },
  {
    "poem_id": 88071,
    "vorder": 42,
    "position": 1,
    "text": "تو گفتی جهان را بدرید گوش"
  },
  {
    "poem_id": 88071,
    "vorder": 43,
    "position": 0,
    "text": "زمین را همی دل برآمد ز جای"
  },
  {
    "poem_id": 88071,
    "vorder": 44,
    "position": 1,
    "text": "ز بس نالهٔ بوق و شیپور و نای"
  },
  {
    "poem_id": 88071,
    "vorder": 45,
    "position": 0,
    "text": "چو خورشید برداشت از چرخ زنگ"
  },
  {
    "poem_id": 88071,
    "vorder": 46,
    "position": 1,
    "text": "بدرید پیراهن مشک رنگ"
  },
  {
    "poem_id": 88071,
    "vorder": 47,
    "position": 0,
    "text": "نشست از بر اسب شبرنگ شاه"
  },
  {
    "poem_id": 88071,
    "vorder": 48,
    "position": 1,
    "text": "بیامد بگردید گرد سپاه"
  },
  {
    "poem_id": 88071,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت با رستم پیلتن"
  },
  {
    "poem_id": 88071,
    "vorder": 50,
    "position": 1,
    "text": "که این نامور مهتر انجمن"
  },
  {
    "poem_id": 88071,
    "vorder": 51,
    "position": 0,
    "text": "چنین دارم امید کافراسیاب"
  },
  {
    "poem_id": 88071,
    "vorder": 52,
    "position": 1,
    "text": "نبیند جهان نیز هرگز به خواب"
  },
  {
    "poem_id": 88071,
    "vorder": 53,
    "position": 0,
    "text": "اگر کشته گر زنده آید به دست"
  },
  {
    "poem_id": 88071,
    "vorder": 54,
    "position": 1,
    "text": "ببیند سر تیغ یزدان پرست"
  },
  {
    "poem_id": 88071,
    "vorder": 55,
    "position": 0,
    "text": "برآنم که او را ز هر سو سپاه"
  },
  {
    "poem_id": 88071,
    "vorder": 56,
    "position": 1,
    "text": "به یاری بیاید بدین رزمگاه"
  },
  {
    "poem_id": 88071,
    "vorder": 57,
    "position": 0,
    "text": "بترسند وز ترس یاری کنند"
  },
  {
    "poem_id": 88071,
    "vorder": 58,
    "position": 1,
    "text": "نه از کین و از کامکاری کنند"
  },
  {
    "poem_id": 88071,
    "vorder": 59,
    "position": 0,
    "text": "بکوشیم تا پیش از آن کو سپاه"
  },
  {
    "poem_id": 88071,
    "vorder": 60,
    "position": 1,
    "text": "بخواند بر او بر بگیریم راه"
  },
  {
    "poem_id": 88071,
    "vorder": 61,
    "position": 0,
    "text": "همه بارهٔ دژ فرود آوریم"
  },
  {
    "poem_id": 88071,
    "vorder": 62,
    "position": 1,
    "text": "همه سنگ و خاکش به رود آوریم"
  },
  {
    "poem_id": 88071,
    "vorder": 63,
    "position": 0,
    "text": "سپه را کنون روز سختی گذشت"
  },
  {
    "poem_id": 88071,
    "vorder": 64,
    "position": 1,
    "text": "همان روز رزم اندر آرام گشت"
  },
  {
    "poem_id": 88071,
    "vorder": 65,
    "position": 0,
    "text": "چو دشمن به دیوار گیرد پناه"
  },
  {
    "poem_id": 88071,
    "vorder": 66,
    "position": 1,
    "text": "ز پیکار و کینش نترسد سپاه"
  },
  {
    "poem_id": 88071,
    "vorder": 67,
    "position": 0,
    "text": "شکسته دلست او بدین شارستان"
  },
  {
    "poem_id": 88071,
    "vorder": 68,
    "position": 1,
    "text": "کزین پس شود بی گمان خارستان"
  },
  {
    "poem_id": 88071,
    "vorder": 69,
    "position": 0,
    "text": "چو گفتار کاووس یاد آوریم"
  },
  {
    "poem_id": 88071,
    "vorder": 70,
    "position": 1,
    "text": "روان را همه سوی داد آوریم"
  },
  {
    "poem_id": 88071,
    "vorder": 71,
    "position": 0,
    "text": "کجا گفت کاین کین با دار و برد"
  },
  {
    "poem_id": 88071,
    "vorder": 72,
    "position": 1,
    "text": "بپوشد زمانه به زنگار و گرد"
  },
  {
    "poem_id": 88071,
    "vorder": 73,
    "position": 0,
    "text": "پسر بر پسر بگذرانم به دست"
  },
  {
    "poem_id": 88071,
    "vorder": 74,
    "position": 1,
    "text": "چنین تا شود سال بر پنج شست"
  },
  {
    "poem_id": 88071,
    "vorder": 75,
    "position": 0,
    "text": "به سان درختی بود تازه برگ"
  },
  {
    "poem_id": 88071,
    "vorder": 76,
    "position": 1,
    "text": "دل از کین شاهان نترسد ز مرگ"
  },
  {
    "poem_id": 88071,
    "vorder": 77,
    "position": 0,
    "text": "پدر بگذرد کین بماند به جای"
  },
  {
    "poem_id": 88071,
    "vorder": 78,
    "position": 1,
    "text": "پسر باشد این درد را رهنمای"
  },
  {
    "poem_id": 88071,
    "vorder": 79,
    "position": 0,
    "text": "بزرگان بر او آفرین خواندند"
  },
  {
    "poem_id": 88071,
    "vorder": 80,
    "position": 1,
    "text": "ورا خسرو پاکدین خواندند"
  },
  {
    "poem_id": 88071,
    "vorder": 81,
    "position": 0,
    "text": "که کین پدر بر تو آید به سر"
  },
  {
    "poem_id": 88071,
    "vorder": 82,
    "position": 1,
    "text": "مبادی به جز شاه و پیروزگر"
  }
]