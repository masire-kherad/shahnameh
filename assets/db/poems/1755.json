[
  {
    "poem_id": 1755,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید زو این سخن یزدگرد"
  },
  {
    "poem_id": 1755,
    "vorder": 2,
    "position": 1,
    "text": "روان و خرد را برآورد گرد"
  },
  {
    "poem_id": 1755,
    "vorder": 3,
    "position": 0,
    "text": "نگه کرد از آغاز فرجام را"
  },
  {
    "poem_id": 1755,
    "vorder": 4,
    "position": 1,
    "text": "بدو داد پرمایه بهرام را"
  },
  {
    "poem_id": 1755,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا خلعتش ساختند"
  },
  {
    "poem_id": 1755,
    "vorder": 6,
    "position": 1,
    "text": "سرش را به گردون برافراختند"
  },
  {
    "poem_id": 1755,
    "vorder": 7,
    "position": 0,
    "text": "تنش را به خلعت بیاراستند"
  },
  {
    "poem_id": 1755,
    "vorder": 8,
    "position": 1,
    "text": "ز در اسپ شاه یمن خواستند"
  },
  {
    "poem_id": 1755,
    "vorder": 9,
    "position": 0,
    "text": "ز ایوان شاه جهان تا به دشت"
  },
  {
    "poem_id": 1755,
    "vorder": 10,
    "position": 1,
    "text": "همی اشتر و اسپ و هودج گذشت"
  },
  {
    "poem_id": 1755,
    "vorder": 11,
    "position": 0,
    "text": "پرستنده و دایهٔ بی‌شمار"
  },
  {
    "poem_id": 1755,
    "vorder": 12,
    "position": 1,
    "text": "ز بازارگه تا در شهریار"
  },
  {
    "poem_id": 1755,
    "vorder": 13,
    "position": 0,
    "text": "به بازار گه بسته آیین به راه"
  },
  {
    "poem_id": 1755,
    "vorder": 14,
    "position": 1,
    "text": "ز دروازه تا پیش درگاه شاه"
  },
  {
    "poem_id": 1755,
    "vorder": 15,
    "position": 0,
    "text": "جو منذر بیامد به شهر یمن"
  },
  {
    "poem_id": 1755,
    "vorder": 16,
    "position": 1,
    "text": "پذیره شدندش همه مرد و زن"
  },
  {
    "poem_id": 1755,
    "vorder": 17,
    "position": 0,
    "text": "چو آمد به آرامگاه از نخست"
  },
  {
    "poem_id": 1755,
    "vorder": 18,
    "position": 1,
    "text": "فراوان زنان نژادی بجست"
  },
  {
    "poem_id": 1755,
    "vorder": 19,
    "position": 0,
    "text": "ز دهقان و تازی و پرمایگان"
  },
  {
    "poem_id": 1755,
    "vorder": 20,
    "position": 1,
    "text": "توانگر گزیده گران سایگان"
  },
  {
    "poem_id": 1755,
    "vorder": 21,
    "position": 0,
    "text": "ازین مهتران چار زن برگزید"
  },
  {
    "poem_id": 1755,
    "vorder": 22,
    "position": 1,
    "text": "که آید هنر بر نژادش پدید"
  },
  {
    "poem_id": 1755,
    "vorder": 23,
    "position": 0,
    "text": "دو تازی دو دهقان ز تخم کیان"
  },
  {
    "poem_id": 1755,
    "vorder": 24,
    "position": 1,
    "text": "ببستند مرا دایگی را میان"
  },
  {
    "poem_id": 1755,
    "vorder": 25,
    "position": 0,
    "text": "همی داشتندش چنین چار سال"
  },
  {
    "poem_id": 1755,
    "vorder": 26,
    "position": 1,
    "text": "چو شد سیرشیر و بیاگند یال"
  },
  {
    "poem_id": 1755,
    "vorder": 27,
    "position": 0,
    "text": "به دشواری از شیر کردند باز"
  },
  {
    "poem_id": 1755,
    "vorder": 28,
    "position": 1,
    "text": "همی داشتندش به بر بر به ناز"
  },
  {
    "poem_id": 1755,
    "vorder": 29,
    "position": 0,
    "text": "چو شد هفت ساله به منذر چه گفت"
  },
  {
    "poem_id": 1755,
    "vorder": 30,
    "position": 1,
    "text": "که آن رای با مهتری بود جفت"
  },
  {
    "poem_id": 1755,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت کای مهتر سرفراز"
  },
  {
    "poem_id": 1755,
    "vorder": 32,
    "position": 1,
    "text": "ز من کودک شیرخواره مساز"
  },
  {
    "poem_id": 1755,
    "vorder": 33,
    "position": 0,
    "text": "به داننده فرهنگیانم سپار"
  },
  {
    "poem_id": 1755,
    "vorder": 34,
    "position": 1,
    "text": "چو کارست بیکار خوارم مدار"
  },
  {
    "poem_id": 1755,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت منذر که ای سرفراز"
  },
  {
    "poem_id": 1755,
    "vorder": 36,
    "position": 1,
    "text": "به فرهنگ نوزت نیامد نیاز"
  },
  {
    "poem_id": 1755,
    "vorder": 37,
    "position": 0,
    "text": "چو هنگام فرهنگ باشد ترا"
  },
  {
    "poem_id": 1755,
    "vorder": 38,
    "position": 1,
    "text": "به دانایی آهنگ باشد ترا"
  },
  {
    "poem_id": 1755,
    "vorder": 39,
    "position": 0,
    "text": "به ایوان نمانم که بازی کنی"
  },
  {
    "poem_id": 1755,
    "vorder": 40,
    "position": 1,
    "text": "به بازی همی سرفرازی کنی"
  },
  {
    "poem_id": 1755,
    "vorder": 41,
    "position": 0,
    "text": "چنین پاسخ آورد بهرام باز"
  },
  {
    "poem_id": 1755,
    "vorder": 42,
    "position": 1,
    "text": "که از من تو بی‌کار خوردی مساز"
  },
  {
    "poem_id": 1755,
    "vorder": 43,
    "position": 0,
    "text": "مرا هست دانش اگر سال نیست"
  },
  {
    "poem_id": 1755,
    "vorder": 44,
    "position": 1,
    "text": "بسان گوانم بر و یال نیست"
  },
  {
    "poem_id": 1755,
    "vorder": 45,
    "position": 0,
    "text": "ترا سال هست و خرد کمترست"
  },
  {
    "poem_id": 1755,
    "vorder": 46,
    "position": 1,
    "text": "نهاد من از رای تو دیگرست"
  },
  {
    "poem_id": 1755,
    "vorder": 47,
    "position": 0,
    "text": "ندانی که هرکس که هنگام جست"
  },
  {
    "poem_id": 1755,
    "vorder": 48,
    "position": 1,
    "text": "ز کار آن گزیند که باید نخست"
  },
  {
    "poem_id": 1755,
    "vorder": 49,
    "position": 0,
    "text": "تو گر باز هنگام جویی همی"
  },
  {
    "poem_id": 1755,
    "vorder": 50,
    "position": 1,
    "text": "دل از نیکویها بشویی همی"
  },
  {
    "poem_id": 1755,
    "vorder": 51,
    "position": 0,
    "text": "همه کار بی‌گاه و بی‌بر بود"
  },
  {
    "poem_id": 1755,
    "vorder": 52,
    "position": 1,
    "text": "بهین از تن زندگان سر بود"
  },
  {
    "poem_id": 1755,
    "vorder": 53,
    "position": 0,
    "text": "هران چیز کان در خور پادشاست"
  },
  {
    "poem_id": 1755,
    "vorder": 54,
    "position": 1,
    "text": "بیاموزیم تا بدانم سزاست"
  },
  {
    "poem_id": 1755,
    "vorder": 55,
    "position": 0,
    "text": "سر راستی دانش ایزدیست"
  },
  {
    "poem_id": 1755,
    "vorder": 56,
    "position": 1,
    "text": "خنک آنک بادانش و بخردیست"
  },
  {
    "poem_id": 1755,
    "vorder": 57,
    "position": 0,
    "text": "نگه کرد منذر بدو خیره ماند"
  },
  {
    "poem_id": 1755,
    "vorder": 58,
    "position": 1,
    "text": "به زیر لبان نام یزدان بخواند"
  },
  {
    "poem_id": 1755,
    "vorder": 59,
    "position": 0,
    "text": "فرستاد هم در زمان رهنمون"
  },
  {
    "poem_id": 1755,
    "vorder": 60,
    "position": 1,
    "text": "سوی شورستان سرکشی بر هیون"
  },
  {
    "poem_id": 1755,
    "vorder": 61,
    "position": 0,
    "text": "سه موبد نگه کرد فرهنگ جوی"
  },
  {
    "poem_id": 1755,
    "vorder": 62,
    "position": 1,
    "text": "که در شورستان بودشان آب‌روی"
  },
  {
    "poem_id": 1755,
    "vorder": 63,
    "position": 0,
    "text": "یکی تا دبیری بیاموزدش"
  },
  {
    "poem_id": 1755,
    "vorder": 64,
    "position": 1,
    "text": "دل از تیرگیها بیفروزدش"
  },
  {
    "poem_id": 1755,
    "vorder": 65,
    "position": 0,
    "text": "دگر آنک دانستن باز و یوز"
  },
  {
    "poem_id": 1755,
    "vorder": 66,
    "position": 1,
    "text": "بیاموزدش کان بود دلفروز"
  },
  {
    "poem_id": 1755,
    "vorder": 67,
    "position": 0,
    "text": "ودیگر که چوگان و تیر و کمان"
  },
  {
    "poem_id": 1755,
    "vorder": 68,
    "position": 1,
    "text": "همان گردش رزم با بدگمان"
  },
  {
    "poem_id": 1755,
    "vorder": 69,
    "position": 0,
    "text": "چپ و راست پیچان عنان داشتن"
  },
  {
    "poem_id": 1755,
    "vorder": 70,
    "position": 1,
    "text": "به آوردگه باره برگاشتن"
  },
  {
    "poem_id": 1755,
    "vorder": 71,
    "position": 0,
    "text": "چنین موبدان پیش منذر شدند"
  },
  {
    "poem_id": 1755,
    "vorder": 72,
    "position": 1,
    "text": "ز هر دانشی داستانها زدند"
  },
  {
    "poem_id": 1755,
    "vorder": 73,
    "position": 0,
    "text": "تن شاه زاده بدیشان سپرد"
  },
  {
    "poem_id": 1755,
    "vorder": 74,
    "position": 1,
    "text": "فزاینده خود دانشی بود و گرد"
  },
  {
    "poem_id": 1755,
    "vorder": 75,
    "position": 0,
    "text": "چنان گشت بهرام خسرونژاد"
  },
  {
    "poem_id": 1755,
    "vorder": 76,
    "position": 1,
    "text": "که اندر هنر داد مردی بداد"
  },
  {
    "poem_id": 1755,
    "vorder": 77,
    "position": 0,
    "text": "هنر هرچ بگذشت بر گوش اوی"
  },
  {
    "poem_id": 1755,
    "vorder": 78,
    "position": 1,
    "text": "به فرهنگ یازان شدی هوش اوی"
  },
  {
    "poem_id": 1755,
    "vorder": 79,
    "position": 0,
    "text": "چو شد سال آن نامور بر سه شش"
  },
  {
    "poem_id": 1755,
    "vorder": 80,
    "position": 1,
    "text": "دلاور گوی گشت خورشیدفش"
  },
  {
    "poem_id": 1755,
    "vorder": 81,
    "position": 0,
    "text": "به موبد نبودش به چیزی نیاز"
  },
  {
    "poem_id": 1755,
    "vorder": 82,
    "position": 1,
    "text": "به فرهنگ جویان و آن یوز و باز"
  },
  {
    "poem_id": 1755,
    "vorder": 83,
    "position": 0,
    "text": "به آوردگه بر عنان تافتن"
  },
  {
    "poem_id": 1755,
    "vorder": 84,
    "position": 1,
    "text": "برافگندن اسپ و هم تاختن"
  },
  {
    "poem_id": 1755,
    "vorder": 85,
    "position": 0,
    "text": "به منذر چنین گفت کای پاک‌رای"
  },
  {
    "poem_id": 1755,
    "vorder": 86,
    "position": 1,
    "text": "گسی کن هنرمند را باز جای"
  },
  {
    "poem_id": 1755,
    "vorder": 87,
    "position": 0,
    "text": "ازان هر یکی را بسی هدیه داد"
  },
  {
    "poem_id": 1755,
    "vorder": 88,
    "position": 1,
    "text": "ز درگاه منذر برفتند شاد"
  },
  {
    "poem_id": 1755,
    "vorder": 89,
    "position": 0,
    "text": "وزان پس به منذر چنین گفت شاه"
  },
  {
    "poem_id": 1755,
    "vorder": 90,
    "position": 1,
    "text": "که اسپان این نیزه‌داران بخواه"
  },
  {
    "poem_id": 1755,
    "vorder": 91,
    "position": 0,
    "text": "بگو تا بپیچند پیشم عنان"
  },
  {
    "poem_id": 1755,
    "vorder": 92,
    "position": 1,
    "text": "به چشم اندر آرند نوک سنان"
  },
  {
    "poem_id": 1755,
    "vorder": 93,
    "position": 0,
    "text": "بهایی کنند آنچ آید خوشم"
  },
  {
    "poem_id": 1755,
    "vorder": 94,
    "position": 1,
    "text": "درم پیش خواهم بریشان کشم"
  },
  {
    "poem_id": 1755,
    "vorder": 95,
    "position": 0,
    "text": "چنین پاسخ آورد منذر بدوی"
  },
  {
    "poem_id": 1755,
    "vorder": 96,
    "position": 1,
    "text": "که ای پر هنر خسرو نامجوی"
  },
  {
    "poem_id": 1755,
    "vorder": 97,
    "position": 0,
    "text": "گله‌دار اسپان من پیش تست"
  },
  {
    "poem_id": 1755,
    "vorder": 98,
    "position": 1,
    "text": "خداوند او هم به تن خویش تست"
  },
  {
    "poem_id": 1755,
    "vorder": 99,
    "position": 0,
    "text": "گر از تازیان اسپ خواهی خرید"
  },
  {
    "poem_id": 1755,
    "vorder": 100,
    "position": 1,
    "text": "مرا رنج و سختی چه باید کشید"
  },
  {
    "poem_id": 1755,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت بهرام کای نیک‌نام"
  },
  {
    "poem_id": 1755,
    "vorder": 102,
    "position": 1,
    "text": "به نیکیت بادا همه ساله کام"
  },
  {
    "poem_id": 1755,
    "vorder": 103,
    "position": 0,
    "text": "من اسپ آن گزینم که اندر نشیب"
  },
  {
    "poem_id": 1755,
    "vorder": 104,
    "position": 1,
    "text": "بتازم نه بینم عنان از رکیب"
  },
  {
    "poem_id": 1755,
    "vorder": 105,
    "position": 0,
    "text": "چو با تگ چنان پایدارش کنم"
  },
  {
    "poem_id": 1755,
    "vorder": 106,
    "position": 1,
    "text": "به نوروز با باد یارش کنم"
  },
  {
    "poem_id": 1755,
    "vorder": 107,
    "position": 0,
    "text": "وگر آزموده نباشد ستور"
  },
  {
    "poem_id": 1755,
    "vorder": 108,
    "position": 1,
    "text": "نشاید به تندی برو کرد زور"
  },
  {
    "poem_id": 1755,
    "vorder": 109,
    "position": 0,
    "text": "به نعمان بفرمود منذر که رو"
  },
  {
    "poem_id": 1755,
    "vorder": 110,
    "position": 1,
    "text": "فسیله گزین از گله‌دار نو"
  },
  {
    "poem_id": 1755,
    "vorder": 111,
    "position": 0,
    "text": "همه دشت پیش سواران بگرد"
  },
  {
    "poem_id": 1755,
    "vorder": 112,
    "position": 1,
    "text": "نگر تا کجا یابی اسپ نبرد"
  },
  {
    "poem_id": 1755,
    "vorder": 113,
    "position": 0,
    "text": "بشد تیز نعمان صد اسپ آورید"
  },
  {
    "poem_id": 1755,
    "vorder": 114,
    "position": 1,
    "text": "ز اسپان جنگی بسی برگزید"
  },
  {
    "poem_id": 1755,
    "vorder": 115,
    "position": 0,
    "text": "چو بهرام دید آن بیامد به دشت"
  },
  {
    "poem_id": 1755,
    "vorder": 116,
    "position": 1,
    "text": "چپ و راست پیچید و چندی بگشت"
  },
  {
    "poem_id": 1755,
    "vorder": 117,
    "position": 0,
    "text": "هر اسپی که با باد همبر بدی"
  },
  {
    "poem_id": 1755,
    "vorder": 118,
    "position": 1,
    "text": "همه زیر بهرام بی‌پر شدی"
  },
  {
    "poem_id": 1755,
    "vorder": 119,
    "position": 0,
    "text": "برین‌گونه تا برگزید اشقری"
  },
  {
    "poem_id": 1755,
    "vorder": 120,
    "position": 1,
    "text": "یکی بادپایی گشاده‌بری"
  },
  {
    "poem_id": 1755,
    "vorder": 121,
    "position": 0,
    "text": "هم از داغ دیگر کمیتی به رنگ"
  },
  {
    "poem_id": 1755,
    "vorder": 122,
    "position": 1,
    "text": "تو گفتی ز دریا برآمد نهنگ"
  },
  {
    "poem_id": 1755,
    "vorder": 123,
    "position": 0,
    "text": "همی آتش افروخت از نعل اوی"
  },
  {
    "poem_id": 1755,
    "vorder": 124,
    "position": 1,
    "text": "همی خون چکید از بر لعل اوی"
  },
  {
    "poem_id": 1755,
    "vorder": 125,
    "position": 0,
    "text": "بها داد منذر چو بود ارزشان"
  },
  {
    "poem_id": 1755,
    "vorder": 126,
    "position": 1,
    "text": "که در بیشهٔ کوفه بد مرزشان"
  },
  {
    "poem_id": 1755,
    "vorder": 127,
    "position": 0,
    "text": "بپذرفت بهرام زو آن دو اسپ"
  },
  {
    "poem_id": 1755,
    "vorder": 128,
    "position": 1,
    "text": "فروزنده بر سان آذر گشسپ"
  },
  {
    "poem_id": 1755,
    "vorder": 129,
    "position": 0,
    "text": "همی داشتش چون یکی تازه سیب"
  },
  {
    "poem_id": 1755,
    "vorder": 130,
    "position": 1,
    "text": "که از باد ناید بروبر نهیب"
  },
  {
    "poem_id": 1755,
    "vorder": 131,
    "position": 0,
    "text": "به منذر چنین گفت روزی جوان"
  },
  {
    "poem_id": 1755,
    "vorder": 132,
    "position": 1,
    "text": "که ای مرد باهنگ و روشن‌روان"
  },
  {
    "poem_id": 1755,
    "vorder": 133,
    "position": 0,
    "text": "چنین بی‌بهانه همی داریم"
  },
  {
    "poem_id": 1755,
    "vorder": 134,
    "position": 1,
    "text": "زمانی به تیمار نگذاریم"
  },
  {
    "poem_id": 1755,
    "vorder": 135,
    "position": 0,
    "text": "همی هرک بینی تو اندر جهان"
  },
  {
    "poem_id": 1755,
    "vorder": 136,
    "position": 1,
    "text": "دلی نیست اندر جهان بی‌نهان"
  },
  {
    "poem_id": 1755,
    "vorder": 137,
    "position": 0,
    "text": "ز اندوه باشد رخ مرد زرد"
  },
  {
    "poem_id": 1755,
    "vorder": 138,
    "position": 1,
    "text": "به رامش فزاید تن زادمرد"
  },
  {
    "poem_id": 1755,
    "vorder": 139,
    "position": 0,
    "text": "برین‌بر یکی خوبی افزای پس"
  },
  {
    "poem_id": 1755,
    "vorder": 140,
    "position": 1,
    "text": "که باشد ز هر درد فریادرس"
  },
  {
    "poem_id": 1755,
    "vorder": 141,
    "position": 0,
    "text": "اگر تاجدارست اگر پهلوان"
  },
  {
    "poem_id": 1755,
    "vorder": 142,
    "position": 1,
    "text": "به زن گیرد آرام مرد جوان"
  },
  {
    "poem_id": 1755,
    "vorder": 143,
    "position": 0,
    "text": "همان زو بود دین یزدان به پای"
  },
  {
    "poem_id": 1755,
    "vorder": 144,
    "position": 1,
    "text": "جوان را به نیکی بود رهنمای"
  },
  {
    "poem_id": 1755,
    "vorder": 145,
    "position": 0,
    "text": "کنیزک بفرمای تا پنج و شش"
  },
  {
    "poem_id": 1755,
    "vorder": 146,
    "position": 1,
    "text": "بیارند با زیب و خورشیدفش"
  },
  {
    "poem_id": 1755,
    "vorder": 147,
    "position": 0,
    "text": "مگر زان یکی دو گزین آیدم"
  },
  {
    "poem_id": 1755,
    "vorder": 148,
    "position": 1,
    "text": "هم اندیشهٔ آفرین آیدم"
  },
  {
    "poem_id": 1755,
    "vorder": 149,
    "position": 0,
    "text": "مگر نیز فرزند بینم یکی"
  },
  {
    "poem_id": 1755,
    "vorder": 150,
    "position": 1,
    "text": "که آرام دل باشدم اندکی"
  },
  {
    "poem_id": 1755,
    "vorder": 151,
    "position": 0,
    "text": "جهاندار خشنود باشد ز من"
  },
  {
    "poem_id": 1755,
    "vorder": 152,
    "position": 1,
    "text": "ستوده بمانم به هر انجمن"
  },
  {
    "poem_id": 1755,
    "vorder": 153,
    "position": 0,
    "text": "چو بشنید منذر ز خسرو سخن"
  },
  {
    "poem_id": 1755,
    "vorder": 154,
    "position": 1,
    "text": "برو آفرین کرد مرد کهن"
  },
  {
    "poem_id": 1755,
    "vorder": 155,
    "position": 0,
    "text": "بفرمود تا سعد گوینده تفت"
  },
  {
    "poem_id": 1755,
    "vorder": 156,
    "position": 1,
    "text": "سوی کلبهٔ مرد نخاس رفت"
  },
  {
    "poem_id": 1755,
    "vorder": 157,
    "position": 0,
    "text": "بیاورد رومی کنیزک چهل"
  },
  {
    "poem_id": 1755,
    "vorder": 158,
    "position": 1,
    "text": "همه از در کام و آرام دل"
  },
  {
    "poem_id": 1755,
    "vorder": 159,
    "position": 0,
    "text": "دو بگزید بهرام زان گلرخان"
  },
  {
    "poem_id": 1755,
    "vorder": 160,
    "position": 1,
    "text": "که در پوستشان عاج بود استخوان"
  },
  {
    "poem_id": 1755,
    "vorder": 161,
    "position": 0,
    "text": "به بالا به کردار سرو سهی"
  },
  {
    "poem_id": 1755,
    "vorder": 162,
    "position": 1,
    "text": "همه کام و زیبایی و فرهی"
  },
  {
    "poem_id": 1755,
    "vorder": 163,
    "position": 0,
    "text": "ازان دو ستاره یکی چنگ‌زن"
  },
  {
    "poem_id": 1755,
    "vorder": 164,
    "position": 1,
    "text": "دگر لاله رخ چون سهیل یمن"
  },
  {
    "poem_id": 1755,
    "vorder": 165,
    "position": 0,
    "text": "به بالا چون سرو و به گیسو کمند"
  },
  {
    "poem_id": 1755,
    "vorder": 166,
    "position": 1,
    "text": "بها داد منذر چو آمد پسند"
  },
  {
    "poem_id": 1755,
    "vorder": 167,
    "position": 0,
    "text": "بخندید بهرام و کرد آفرین"
  },
  {
    "poem_id": 1755,
    "vorder": 168,
    "position": 1,
    "text": "رخش گشت همچون بدخشان نگین"
  }
]