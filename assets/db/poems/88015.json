[
  {
    "poem_id": 88015,
    "vorder": 1,
    "position": 0,
    "text": "نویسندهٔ نامه را پیش خواند"
  },
  {
    "poem_id": 88015,
    "vorder": 2,
    "position": 1,
    "text": "وزین داستان چند با او براند"
  },
  {
    "poem_id": 88015,
    "vorder": 3,
    "position": 0,
    "text": "برستم یکی نامه فرمود شاه"
  },
  {
    "poem_id": 88015,
    "vorder": 4,
    "position": 1,
    "text": "نوشتن ز مهتر سوی نیکخواه"
  },
  {
    "poem_id": 88015,
    "vorder": 5,
    "position": 0,
    "text": "که ای پهلوان زادهٔ پر هنر"
  },
  {
    "poem_id": 88015,
    "vorder": 6,
    "position": 1,
    "text": "ز گردان لشکر برآورده سر"
  },
  {
    "poem_id": 88015,
    "vorder": 7,
    "position": 0,
    "text": "دل شهریاران و پشت کیان"
  },
  {
    "poem_id": 88015,
    "vorder": 8,
    "position": 1,
    "text": "بفرمان هر کس کمر بر میان"
  },
  {
    "poem_id": 88015,
    "vorder": 9,
    "position": 0,
    "text": "توی از نیاکان مرا یادگار"
  },
  {
    "poem_id": 88015,
    "vorder": 10,
    "position": 1,
    "text": "همیشه کمربستهٔ کارزار"
  },
  {
    "poem_id": 88015,
    "vorder": 11,
    "position": 0,
    "text": "ترا داد گردون بمردی پلنگ"
  },
  {
    "poem_id": 88015,
    "vorder": 12,
    "position": 1,
    "text": "بدریا ز بیمت خروشان نهنگ"
  },
  {
    "poem_id": 88015,
    "vorder": 13,
    "position": 0,
    "text": "جهان را ز دیوان مازندران"
  },
  {
    "poem_id": 88015,
    "vorder": 14,
    "position": 1,
    "text": "بشستی و کندی بدان را سران"
  },
  {
    "poem_id": 88015,
    "vorder": 15,
    "position": 0,
    "text": "چه مایه سر تاجداران ز گاه"
  },
  {
    "poem_id": 88015,
    "vorder": 16,
    "position": 1,
    "text": "ربودی و برکندی از پیشگاه"
  },
  {
    "poem_id": 88015,
    "vorder": 17,
    "position": 0,
    "text": "بسا دشمنان کز تو بیجان شدست"
  },
  {
    "poem_id": 88015,
    "vorder": 18,
    "position": 1,
    "text": "بسا بوم و بر کز تو ویران شدست"
  },
  {
    "poem_id": 88015,
    "vorder": 19,
    "position": 0,
    "text": "سر پهلوانی و لشکر پناه"
  },
  {
    "poem_id": 88015,
    "vorder": 20,
    "position": 1,
    "text": "بنزدیک شاهان ترا دستگاه"
  },
  {
    "poem_id": 88015,
    "vorder": 21,
    "position": 0,
    "text": "همه جادوان را ببستی بگرز"
  },
  {
    "poem_id": 88015,
    "vorder": 22,
    "position": 1,
    "text": "بیفروختی تاج شاهان ببرز"
  },
  {
    "poem_id": 88015,
    "vorder": 23,
    "position": 0,
    "text": "چه افراسیاب و چه شاهان چین"
  },
  {
    "poem_id": 88015,
    "vorder": 24,
    "position": 1,
    "text": "نوشته همه نام تو بر نگین"
  },
  {
    "poem_id": 88015,
    "vorder": 25,
    "position": 0,
    "text": "هران بند کز دست تو بسته شد"
  },
  {
    "poem_id": 88015,
    "vorder": 26,
    "position": 1,
    "text": "گشایندگان را جگر خسته شد"
  },
  {
    "poem_id": 88015,
    "vorder": 27,
    "position": 0,
    "text": "گشایندهٔ بند بسته توی"
  },
  {
    "poem_id": 88015,
    "vorder": 28,
    "position": 1,
    "text": "کیان را سپهر خجسته توی"
  },
  {
    "poem_id": 88015,
    "vorder": 29,
    "position": 0,
    "text": "ترا ایزد این زور پیلان که داد"
  },
  {
    "poem_id": 88015,
    "vorder": 30,
    "position": 1,
    "text": "دل و هوش و فرهنگ فرخ‌نژاد"
  },
  {
    "poem_id": 88015,
    "vorder": 31,
    "position": 0,
    "text": "بدان داد تا دست فریاد خواه"
  },
  {
    "poem_id": 88015,
    "vorder": 32,
    "position": 1,
    "text": "بگیری برآری ز تاریک چاه"
  },
  {
    "poem_id": 88015,
    "vorder": 33,
    "position": 0,
    "text": "کنون این یکی کار بایسته پیش"
  },
  {
    "poem_id": 88015,
    "vorder": 34,
    "position": 1,
    "text": "فراز آمد و اینت شایسته خویش"
  },
  {
    "poem_id": 88015,
    "vorder": 35,
    "position": 0,
    "text": "بتو دارد امید گودرز و گیو"
  },
  {
    "poem_id": 88015,
    "vorder": 36,
    "position": 1,
    "text": "که هستی بهر کشور امروز نیو"
  },
  {
    "poem_id": 88015,
    "vorder": 37,
    "position": 0,
    "text": "شناسی بنزدیک من جاهشان"
  },
  {
    "poem_id": 88015,
    "vorder": 38,
    "position": 1,
    "text": "زبان و دل و رای یکتاهشان"
  },
  {
    "poem_id": 88015,
    "vorder": 39,
    "position": 0,
    "text": "سزدگر تو اینرا نداری برنج"
  },
  {
    "poem_id": 88015,
    "vorder": 40,
    "position": 1,
    "text": "بخواه آنچ باید ز مردان و گنج"
  },
  {
    "poem_id": 88015,
    "vorder": 41,
    "position": 0,
    "text": "که هرگز بدین دودمان غم نبود"
  },
  {
    "poem_id": 88015,
    "vorder": 42,
    "position": 1,
    "text": "فروزنده‌تر زین چنانکم شنود"
  },
  {
    "poem_id": 88015,
    "vorder": 43,
    "position": 0,
    "text": "نبد گیو را خود جز این پور کس"
  },
  {
    "poem_id": 88015,
    "vorder": 44,
    "position": 1,
    "text": "چه فرزند بود و چه فریادرس"
  },
  {
    "poem_id": 88015,
    "vorder": 45,
    "position": 0,
    "text": "فراوان بنزد منش دستگاه"
  },
  {
    "poem_id": 88015,
    "vorder": 46,
    "position": 1,
    "text": "مرا و نیای مرا نیکخواه"
  },
  {
    "poem_id": 88015,
    "vorder": 47,
    "position": 0,
    "text": "بهر سو که جویمش یابم بجای"
  },
  {
    "poem_id": 88015,
    "vorder": 48,
    "position": 1,
    "text": "بهر نیک و بد پیش من بربپای"
  },
  {
    "poem_id": 88015,
    "vorder": 49,
    "position": 0,
    "text": "چو این نامهٔ من بخوانی مپای"
  },
  {
    "poem_id": 88015,
    "vorder": 50,
    "position": 1,
    "text": "بزودی تو با گیو خیز اندرآی"
  },
  {
    "poem_id": 88015,
    "vorder": 51,
    "position": 0,
    "text": "بدان تا بدین کار با ما بهم"
  },
  {
    "poem_id": 88015,
    "vorder": 52,
    "position": 1,
    "text": "زنی رای فرخ بهر بیش و کم"
  },
  {
    "poem_id": 88015,
    "vorder": 53,
    "position": 0,
    "text": "ز مردان وز گنج وز خواسته"
  },
  {
    "poem_id": 88015,
    "vorder": 54,
    "position": 1,
    "text": "بیارم بپیش تو آراسته"
  },
  {
    "poem_id": 88015,
    "vorder": 55,
    "position": 0,
    "text": "بفرخ پی و بر شده نام تو"
  },
  {
    "poem_id": 88015,
    "vorder": 56,
    "position": 1,
    "text": "ز توران برآید همه کام تو"
  },
  {
    "poem_id": 88015,
    "vorder": 57,
    "position": 0,
    "text": "چنانچون بباید بسازی نوا"
  },
  {
    "poem_id": 88015,
    "vorder": 58,
    "position": 1,
    "text": "مگر بیژن از بند یابد رها"
  },
  {
    "poem_id": 88015,
    "vorder": 59,
    "position": 0,
    "text": "چو برنامه بنهاد خسرو نگین"
  },
  {
    "poem_id": 88015,
    "vorder": 60,
    "position": 1,
    "text": "بشد گیو و بر شاه کرد آفرین"
  },
  {
    "poem_id": 88015,
    "vorder": 61,
    "position": 0,
    "text": "سواران دوده همه برنشاند"
  },
  {
    "poem_id": 88015,
    "vorder": 62,
    "position": 1,
    "text": "بیزدان پناهید و لشکر براند"
  },
  {
    "poem_id": 88015,
    "vorder": 63,
    "position": 0,
    "text": "چو نخجیر از آنجا که برداشتی"
  },
  {
    "poem_id": 88015,
    "vorder": 64,
    "position": 1,
    "text": "دو روزه بیک روزه بگذاشتی"
  },
  {
    "poem_id": 88015,
    "vorder": 65,
    "position": 0,
    "text": "بیابان گرفت و ره هیرمند"
  },
  {
    "poem_id": 88015,
    "vorder": 66,
    "position": 1,
    "text": "همی رفت پویان بسان نوند"
  },
  {
    "poem_id": 88015,
    "vorder": 67,
    "position": 0,
    "text": "بکوه و بصحرا نهادند روی"
  },
  {
    "poem_id": 88015,
    "vorder": 68,
    "position": 1,
    "text": "همی شد خلیده دل و راه‌جوی"
  },
  {
    "poem_id": 88015,
    "vorder": 69,
    "position": 0,
    "text": "چو از دیده‌گه دیده‌بانش بدید"
  },
  {
    "poem_id": 88015,
    "vorder": 70,
    "position": 1,
    "text": "سوی زابلستان فغان برکشید"
  },
  {
    "poem_id": 88015,
    "vorder": 71,
    "position": 0,
    "text": "که آمد سواری سوی هیرمند"
  },
  {
    "poem_id": 88015,
    "vorder": 72,
    "position": 1,
    "text": "سواران بگرد اندرش نیز چند"
  },
  {
    "poem_id": 88015,
    "vorder": 73,
    "position": 0,
    "text": "درفشی درفشان پس پشت اوی"
  },
  {
    "poem_id": 88015,
    "vorder": 74,
    "position": 1,
    "text": "یکی زابلی تیغ در مشت اوی"
  },
  {
    "poem_id": 88015,
    "vorder": 75,
    "position": 0,
    "text": "غو دیده بشنید دستان سام"
  },
  {
    "poem_id": 88015,
    "vorder": 76,
    "position": 1,
    "text": "بفرمود بر چرمه کردن لگام"
  },
  {
    "poem_id": 88015,
    "vorder": 77,
    "position": 0,
    "text": "پراندیشه آمد پذیره براه"
  },
  {
    "poem_id": 88015,
    "vorder": 78,
    "position": 1,
    "text": "بدان تا نباشد یکی کینه خواه"
  },
  {
    "poem_id": 88015,
    "vorder": 79,
    "position": 0,
    "text": "ز ره گیو را دید پژمرده روی"
  },
  {
    "poem_id": 88015,
    "vorder": 80,
    "position": 1,
    "text": "همی آمد آسیمه و پوی پوی"
  },
  {
    "poem_id": 88015,
    "vorder": 81,
    "position": 0,
    "text": "بدل گفت کاری نو آمد بشاه"
  },
  {
    "poem_id": 88015,
    "vorder": 82,
    "position": 1,
    "text": "فرستاده گیوست کامد براه"
  },
  {
    "poem_id": 88015,
    "vorder": 83,
    "position": 0,
    "text": "چو نزدیک شد پهلوان سپاه"
  },
  {
    "poem_id": 88015,
    "vorder": 84,
    "position": 1,
    "text": "نیایش کنان برگرفتند راه"
  },
  {
    "poem_id": 88015,
    "vorder": 85,
    "position": 0,
    "text": "بپرسید دستان ز ایرانیان"
  },
  {
    "poem_id": 88015,
    "vorder": 86,
    "position": 1,
    "text": "ز شاه و ز پیکار تورانیان"
  },
  {
    "poem_id": 88015,
    "vorder": 87,
    "position": 0,
    "text": "درود بزرگان بدستان بداد"
  },
  {
    "poem_id": 88015,
    "vorder": 88,
    "position": 1,
    "text": "ز شاه و ز گردان فرخ نژاد"
  },
  {
    "poem_id": 88015,
    "vorder": 89,
    "position": 0,
    "text": "همه درد دل پیش دستان بخواند"
  },
  {
    "poem_id": 88015,
    "vorder": 90,
    "position": 1,
    "text": "غم پور گم بوده با او براند"
  },
  {
    "poem_id": 88015,
    "vorder": 91,
    "position": 0,
    "text": "همی گفت رویم نبینی برنگ"
  },
  {
    "poem_id": 88015,
    "vorder": 92,
    "position": 1,
    "text": "ز خون مژه پشت پایم بلنگ"
  },
  {
    "poem_id": 88015,
    "vorder": 93,
    "position": 0,
    "text": "ازان پس نشان تهمتن بخواست"
  },
  {
    "poem_id": 88015,
    "vorder": 94,
    "position": 1,
    "text": "بپرسید و گفتش که رستم کجاست"
  },
  {
    "poem_id": 88015,
    "vorder": 95,
    "position": 0,
    "text": "بدو گفت رستم بنخچیر گور"
  },
  {
    "poem_id": 88015,
    "vorder": 96,
    "position": 1,
    "text": "بیاید همانا که برگشت هور"
  },
  {
    "poem_id": 88015,
    "vorder": 97,
    "position": 0,
    "text": "شوم گفت تا من ببینمش روی"
  },
  {
    "poem_id": 88015,
    "vorder": 98,
    "position": 1,
    "text": "ز خسرو یکی نامه دارم بدوی"
  },
  {
    "poem_id": 88015,
    "vorder": 99,
    "position": 0,
    "text": "بدو گفت دستان کز ایدر مرو"
  },
  {
    "poem_id": 88015,
    "vorder": 100,
    "position": 1,
    "text": "که زود آید از دشت نخچیرگو"
  },
  {
    "poem_id": 88015,
    "vorder": 101,
    "position": 0,
    "text": "تو تا رستم آید بخانه بپای"
  },
  {
    "poem_id": 88015,
    "vorder": 102,
    "position": 1,
    "text": "یک امروز با ما بشادی گرای"
  },
  {
    "poem_id": 88015,
    "vorder": 103,
    "position": 0,
    "text": "چو گیو اندر آمد بایوان ز راه"
  },
  {
    "poem_id": 88015,
    "vorder": 104,
    "position": 1,
    "text": "تهمتن بیامد ز نخچیرگاه"
  },
  {
    "poem_id": 88015,
    "vorder": 105,
    "position": 0,
    "text": "پذیره شدش گیو کامد فراز"
  },
  {
    "poem_id": 88015,
    "vorder": 106,
    "position": 1,
    "text": "پیاده شد از اسب و بردش نماز"
  },
  {
    "poem_id": 88015,
    "vorder": 107,
    "position": 0,
    "text": "پر از آرزو دل پر از رنگ روی"
  },
  {
    "poem_id": 88015,
    "vorder": 108,
    "position": 1,
    "text": "به رُخ برنهاد از دو دیده دو جوی"
  },
  {
    "poem_id": 88015,
    "vorder": 109,
    "position": 0,
    "text": "چو رستم دل گیو را خسته دید"
  },
  {
    "poem_id": 88015,
    "vorder": 110,
    "position": 1,
    "text": "بآب مژه روی او شسته دید"
  },
  {
    "poem_id": 88015,
    "vorder": 111,
    "position": 0,
    "text": "بدو گفت باری تباهست کار"
  },
  {
    "poem_id": 88015,
    "vorder": 112,
    "position": 1,
    "text": "بایوان و بر شاه بد روزگار"
  },
  {
    "poem_id": 88015,
    "vorder": 113,
    "position": 0,
    "text": "ز اسب اندر آمد گرفتش ببر"
  },
  {
    "poem_id": 88015,
    "vorder": 114,
    "position": 1,
    "text": "بپرسیدش از خسرو تاجور"
  },
  {
    "poem_id": 88015,
    "vorder": 115,
    "position": 0,
    "text": "ز گودرز وز طوس وز گستهم"
  },
  {
    "poem_id": 88015,
    "vorder": 116,
    "position": 1,
    "text": "ز گردان لشکر همه بیش و کم"
  },
  {
    "poem_id": 88015,
    "vorder": 117,
    "position": 0,
    "text": "ز شاپور و فرهاد وز بیژنا"
  },
  {
    "poem_id": 88015,
    "vorder": 118,
    "position": 1,
    "text": "ز رهام و گرگین وز هرتنا"
  },
  {
    "poem_id": 88015,
    "vorder": 119,
    "position": 0,
    "text": "چو آواز بیژن رسیدش بگوش"
  },
  {
    "poem_id": 88015,
    "vorder": 120,
    "position": 1,
    "text": "برآمد بناکام ازو یک خروش"
  },
  {
    "poem_id": 88015,
    "vorder": 121,
    "position": 0,
    "text": "برستم چنین گفت کای بآفرین"
  },
  {
    "poem_id": 88015,
    "vorder": 122,
    "position": 1,
    "text": "گزین همه خسروان زمین"
  },
  {
    "poem_id": 88015,
    "vorder": 123,
    "position": 0,
    "text": "چنان شاد گشتم بدیدار تو"
  },
  {
    "poem_id": 88015,
    "vorder": 124,
    "position": 1,
    "text": "بدین پرسش خوب و گفتار تو"
  },
  {
    "poem_id": 88015,
    "vorder": 125,
    "position": 0,
    "text": "درستند ازین هرک بردی تو نام"
  },
  {
    "poem_id": 88015,
    "vorder": 126,
    "position": 1,
    "text": "ازیشان فراوان درود و پیام"
  },
  {
    "poem_id": 88015,
    "vorder": 127,
    "position": 0,
    "text": "نبینی که بر من بپیران سرم"
  },
  {
    "poem_id": 88015,
    "vorder": 128,
    "position": 1,
    "text": "چه آمد ز بخت بد اندر خورم"
  },
  {
    "poem_id": 88015,
    "vorder": 129,
    "position": 0,
    "text": "چه چشم بد آمد بگودرزیان"
  },
  {
    "poem_id": 88015,
    "vorder": 130,
    "position": 1,
    "text": "کزان سود ما را سر آمد زیان"
  },
  {
    "poem_id": 88015,
    "vorder": 131,
    "position": 0,
    "text": "ز گیتی مرا خود یکی پور بود"
  },
  {
    "poem_id": 88015,
    "vorder": 132,
    "position": 1,
    "text": "همم پور و هم پاک دستور بود"
  },
  {
    "poem_id": 88015,
    "vorder": 133,
    "position": 0,
    "text": "شد از چشم من در جهان ناپدید"
  },
  {
    "poem_id": 88015,
    "vorder": 134,
    "position": 1,
    "text": "بدین دودمان کس چنین غم ندید"
  },
  {
    "poem_id": 88015,
    "vorder": 135,
    "position": 0,
    "text": "چنینم که بینی بپشت ستور"
  },
  {
    "poem_id": 88015,
    "vorder": 136,
    "position": 1,
    "text": "شب و روز تازان بتاریک هور"
  },
  {
    "poem_id": 88015,
    "vorder": 137,
    "position": 0,
    "text": "ز بیژن شب و روز چون بیهشان"
  },
  {
    "poem_id": 88015,
    "vorder": 138,
    "position": 1,
    "text": "بجستم بهر سو ز هر کس نشان"
  },
  {
    "poem_id": 88015,
    "vorder": 139,
    "position": 0,
    "text": "کنون شاه با جام گیتی نمای"
  },
  {
    "poem_id": 88015,
    "vorder": 140,
    "position": 1,
    "text": "بپیش جهان آفرین شد بپای"
  },
  {
    "poem_id": 88015,
    "vorder": 141,
    "position": 0,
    "text": "چه مایه خروشید و کرد آفرین"
  },
  {
    "poem_id": 88015,
    "vorder": 142,
    "position": 1,
    "text": "بجشن کیان هرمز فرودین"
  },
  {
    "poem_id": 88015,
    "vorder": 143,
    "position": 0,
    "text": "پس آمد ز آتشکده تا بگاه"
  },
  {
    "poem_id": 88015,
    "vorder": 144,
    "position": 1,
    "text": "کمربست و بنهاد بر سر کلاه"
  },
  {
    "poem_id": 88015,
    "vorder": 145,
    "position": 0,
    "text": "همان جام رخشنده بنهاد پیش"
  },
  {
    "poem_id": 88015,
    "vorder": 146,
    "position": 1,
    "text": "بهر سو نگه کرد ز اندازه بیش"
  },
  {
    "poem_id": 88015,
    "vorder": 147,
    "position": 0,
    "text": "بتوران نشان داد زو شهریار"
  },
  {
    "poem_id": 88015,
    "vorder": 148,
    "position": 1,
    "text": "ببند گران و ببد روزگار"
  },
  {
    "poem_id": 88015,
    "vorder": 149,
    "position": 0,
    "text": "چو در جام کیخسرو ایدون نمود"
  },
  {
    "poem_id": 88015,
    "vorder": 150,
    "position": 1,
    "text": "سوی پهلوانم دوانید زود"
  },
  {
    "poem_id": 88015,
    "vorder": 151,
    "position": 0,
    "text": "کنون آمدم با دلی پر امید"
  },
  {
    "poem_id": 88015,
    "vorder": 152,
    "position": 1,
    "text": "دو رخساره زرد و دو دیده سپید"
  },
  {
    "poem_id": 88015,
    "vorder": 153,
    "position": 0,
    "text": "ترا دیدم اندر جهان چاره‌گر"
  },
  {
    "poem_id": 88015,
    "vorder": 154,
    "position": 1,
    "text": "تو بندی بفریاد هر کس کمر"
  },
  {
    "poem_id": 88015,
    "vorder": 155,
    "position": 0,
    "text": "همی گفت و مژگان پر از آب زرد"
  },
  {
    "poem_id": 88015,
    "vorder": 156,
    "position": 1,
    "text": "همی برکشید از جگر باد سرد"
  },
  {
    "poem_id": 88015,
    "vorder": 157,
    "position": 0,
    "text": "ازان پس که نامه برستم بداد"
  },
  {
    "poem_id": 88015,
    "vorder": 158,
    "position": 1,
    "text": "همه کار گرگین بدو کرد یاد"
  },
  {
    "poem_id": 88015,
    "vorder": 159,
    "position": 0,
    "text": "ازو نامه بستد دو دیده پر آب"
  },
  {
    "poem_id": 88015,
    "vorder": 160,
    "position": 1,
    "text": "همه دل پر از کین افراسیاب"
  },
  {
    "poem_id": 88015,
    "vorder": 161,
    "position": 0,
    "text": "پس از بهر بیژن خروشید زار"
  },
  {
    "poem_id": 88015,
    "vorder": 162,
    "position": 1,
    "text": "فرو ریخت از دیده خون برکنار"
  },
  {
    "poem_id": 88015,
    "vorder": 163,
    "position": 0,
    "text": "بگیو آنگهی گفت مندیش ازین"
  },
  {
    "poem_id": 88015,
    "vorder": 164,
    "position": 1,
    "text": "که رستم نگرداند از رخش زین"
  },
  {
    "poem_id": 88015,
    "vorder": 165,
    "position": 0,
    "text": "مگر دست بیژن گرفته بدست"
  },
  {
    "poem_id": 88015,
    "vorder": 166,
    "position": 1,
    "text": "همه بند و زندان او کرده پست"
  },
  {
    "poem_id": 88015,
    "vorder": 167,
    "position": 0,
    "text": "بنیروی یزدان و فرمان شاه"
  },
  {
    "poem_id": 88015,
    "vorder": 168,
    "position": 1,
    "text": "ز توران بگردانم این تاج و گاه"
  },
  {
    "poem_id": 88015,
    "vorder": 169,
    "position": 0,
    "text": "وز آنجا بایوان رستم شدند"
  },
  {
    "poem_id": 88015,
    "vorder": 170,
    "position": 1,
    "text": "بره بر همی رای رفتن زدند"
  },
  {
    "poem_id": 88015,
    "vorder": 171,
    "position": 0,
    "text": "چو آن نامهٔ شاه رستم بخواند"
  },
  {
    "poem_id": 88015,
    "vorder": 172,
    "position": 1,
    "text": "ز گفتار خسرو بخیره بماند"
  },
  {
    "poem_id": 88015,
    "vorder": 173,
    "position": 0,
    "text": "ز بس آفرین جهاندار شاه"
  },
  {
    "poem_id": 88015,
    "vorder": 174,
    "position": 1,
    "text": "بد آن نامه بر پهلوان سپاه"
  },
  {
    "poem_id": 88015,
    "vorder": 175,
    "position": 0,
    "text": "بگیو آنگهی گفت بشناختم"
  },
  {
    "poem_id": 88015,
    "vorder": 176,
    "position": 1,
    "text": "بفرمان او راه را ساختم"
  },
  {
    "poem_id": 88015,
    "vorder": 177,
    "position": 0,
    "text": "بدانستم این رنج و کردار تو"
  },
  {
    "poem_id": 88015,
    "vorder": 178,
    "position": 1,
    "text": "کشیدن بهر کار تیمار تو"
  },
  {
    "poem_id": 88015,
    "vorder": 179,
    "position": 0,
    "text": "چه مایه ترا نزد من دستگاه"
  },
  {
    "poem_id": 88015,
    "vorder": 180,
    "position": 1,
    "text": "بهر کینه‌گاه اندرون کینه خواه"
  },
  {
    "poem_id": 88015,
    "vorder": 181,
    "position": 0,
    "text": "چه کین سیاوش چه مازندران"
  },
  {
    "poem_id": 88015,
    "vorder": 182,
    "position": 1,
    "text": "کمر بسته بر پیش جنگاوران"
  },
  {
    "poem_id": 88015,
    "vorder": 183,
    "position": 0,
    "text": "برین آمدن رنج برداشتی"
  },
  {
    "poem_id": 88015,
    "vorder": 184,
    "position": 1,
    "text": "چنین راه دشوار بگذاشتی"
  },
  {
    "poem_id": 88015,
    "vorder": 185,
    "position": 0,
    "text": "بدیدار تو سخت شادان شدم"
  },
  {
    "poem_id": 88015,
    "vorder": 186,
    "position": 1,
    "text": "ولیکن ز بیژن غریوان شدم"
  },
  {
    "poem_id": 88015,
    "vorder": 187,
    "position": 0,
    "text": "نبایستمی کاین چنین سوگوار"
  },
  {
    "poem_id": 88015,
    "vorder": 188,
    "position": 1,
    "text": "ترا دیدمی خستهٔ روزگار"
  },
  {
    "poem_id": 88015,
    "vorder": 189,
    "position": 0,
    "text": "من از بهر این نامهٔ شاه را"
  },
  {
    "poem_id": 88015,
    "vorder": 190,
    "position": 1,
    "text": "بفرمان بسر بسپرم راه را"
  },
  {
    "poem_id": 88015,
    "vorder": 191,
    "position": 0,
    "text": "ز بهر ترا خود جگر خسته‌ام"
  },
  {
    "poem_id": 88015,
    "vorder": 192,
    "position": 1,
    "text": "بدین کار بیژن کمر بسته‌ام"
  },
  {
    "poem_id": 88015,
    "vorder": 193,
    "position": 0,
    "text": "بکوشم بدین کارگر جان من"
  },
  {
    "poem_id": 88015,
    "vorder": 194,
    "position": 1,
    "text": "ز تن بگسلد پاک یزدان من"
  },
  {
    "poem_id": 88015,
    "vorder": 195,
    "position": 0,
    "text": "من از بهر بیژن ندارم برنج"
  },
  {
    "poem_id": 88015,
    "vorder": 196,
    "position": 1,
    "text": "فدا کردن جان و مردان و گنج"
  },
  {
    "poem_id": 88015,
    "vorder": 197,
    "position": 0,
    "text": "بنیروی یزدان ببندم کمر"
  },
  {
    "poem_id": 88015,
    "vorder": 198,
    "position": 1,
    "text": "ببخت شهنشاه پیروزگر"
  },
  {
    "poem_id": 88015,
    "vorder": 199,
    "position": 0,
    "text": "بیارمش زان بند تاریک چاه"
  },
  {
    "poem_id": 88015,
    "vorder": 200,
    "position": 1,
    "text": "نشانمش با شاه در پیشگاه"
  },
  {
    "poem_id": 88015,
    "vorder": 201,
    "position": 0,
    "text": "سه روز اندرین خان من شاد باش"
  },
  {
    "poem_id": 88015,
    "vorder": 202,
    "position": 1,
    "text": "ز رنج و ز اندیشه آزاد باش"
  },
  {
    "poem_id": 88015,
    "vorder": 203,
    "position": 0,
    "text": "که این خانه زان خانه بخشیده نیست"
  },
  {
    "poem_id": 88015,
    "vorder": 204,
    "position": 1,
    "text": "مرا با تو گنج و تن و جان یکیست"
  },
  {
    "poem_id": 88015,
    "vorder": 205,
    "position": 0,
    "text": "چهارم سوی شهر ایران شویم"
  },
  {
    "poem_id": 88015,
    "vorder": 206,
    "position": 1,
    "text": "بنزدیک شاه دلیران شویم"
  },
  {
    "poem_id": 88015,
    "vorder": 207,
    "position": 0,
    "text": "چو رستم چنین گفت بر جست گیو"
  },
  {
    "poem_id": 88015,
    "vorder": 208,
    "position": 1,
    "text": "ببوسید دست و سر و پای نیو"
  },
  {
    "poem_id": 88015,
    "vorder": 209,
    "position": 0,
    "text": "برو آفرین کرد کای نامور"
  },
  {
    "poem_id": 88015,
    "vorder": 210,
    "position": 1,
    "text": "بمردی و نیروی و بخت و هنر"
  },
  {
    "poem_id": 88015,
    "vorder": 211,
    "position": 0,
    "text": "بماناد بر تو چنین جاودان"
  },
  {
    "poem_id": 88015,
    "vorder": 212,
    "position": 1,
    "text": "تن پیل و هوش و دل موبدان"
  },
  {
    "poem_id": 88015,
    "vorder": 213,
    "position": 0,
    "text": "ز هر نیکی بهره‌ور بادیا"
  },
  {
    "poem_id": 88015,
    "vorder": 214,
    "position": 1,
    "text": "چنین کز دلم زنگ بزدادیا"
  },
  {
    "poem_id": 88015,
    "vorder": 215,
    "position": 0,
    "text": "چو رستم دل گیو پدرام دید"
  },
  {
    "poem_id": 88015,
    "vorder": 216,
    "position": 1,
    "text": "ازان پس بنیکی سرانجام دید"
  },
  {
    "poem_id": 88015,
    "vorder": 217,
    "position": 0,
    "text": "بسالار خوان گفت پیش آر خوان"
  },
  {
    "poem_id": 88015,
    "vorder": 218,
    "position": 1,
    "text": "بزرگان و فرزانگان را بخوان"
  },
  {
    "poem_id": 88015,
    "vorder": 219,
    "position": 0,
    "text": "زواره فرامرز و دستان و گیو"
  },
  {
    "poem_id": 88015,
    "vorder": 220,
    "position": 1,
    "text": "نشستند بر خوان سالار نیو"
  },
  {
    "poem_id": 88015,
    "vorder": 221,
    "position": 0,
    "text": "بخوردند خوان و بپرداختند"
  },
  {
    "poem_id": 88015,
    "vorder": 222,
    "position": 1,
    "text": "نشستنگه رود و می ساختند"
  },
  {
    "poem_id": 88015,
    "vorder": 223,
    "position": 0,
    "text": "نوازندهٔ رود با میگسار"
  },
  {
    "poem_id": 88015,
    "vorder": 224,
    "position": 1,
    "text": "بیامد بایوان گوهر نگار"
  },
  {
    "poem_id": 88015,
    "vorder": 225,
    "position": 0,
    "text": "همه دست لعل از می لعل فام"
  },
  {
    "poem_id": 88015,
    "vorder": 226,
    "position": 1,
    "text": "غریونده چنگ و خروشنده جام"
  },
  {
    "poem_id": 88015,
    "vorder": 227,
    "position": 0,
    "text": "بروز چهارم گرفتند ساز"
  },
  {
    "poem_id": 88015,
    "vorder": 228,
    "position": 1,
    "text": "چو آمدش هنگام رفتن فراز"
  },
  {
    "poem_id": 88015,
    "vorder": 229,
    "position": 0,
    "text": "بفرمود رستم که بندید بار"
  },
  {
    "poem_id": 88015,
    "vorder": 230,
    "position": 1,
    "text": "سوی شاه ایران بسیچید کار"
  },
  {
    "poem_id": 88015,
    "vorder": 231,
    "position": 0,
    "text": "سواران گردنکش از کشورش"
  },
  {
    "poem_id": 88015,
    "vorder": 232,
    "position": 1,
    "text": "همه راه را ساخته بر درش"
  },
  {
    "poem_id": 88015,
    "vorder": 233,
    "position": 0,
    "text": "بیامد به رَخش اندر آورد پای"
  },
  {
    "poem_id": 88015,
    "vorder": 234,
    "position": 1,
    "text": "کمر بست و پوشید رومی قبای"
  },
  {
    "poem_id": 88015,
    "vorder": 235,
    "position": 0,
    "text": "بزین اندر افگند گرز نیا"
  },
  {
    "poem_id": 88015,
    "vorder": 236,
    "position": 1,
    "text": "پر از جنگ سر دل پر از کیمیا"
  },
  {
    "poem_id": 88015,
    "vorder": 237,
    "position": 0,
    "text": "بگردون برافراخته گوش رخش"
  },
  {
    "poem_id": 88015,
    "vorder": 238,
    "position": 1,
    "text": "ز خورشید برتر سر تاج‌بخش"
  },
  {
    "poem_id": 88015,
    "vorder": 239,
    "position": 0,
    "text": "خود و گیو با زابلی صد سوار"
  },
  {
    "poem_id": 88015,
    "vorder": 240,
    "position": 1,
    "text": "ز لشکر گزید از در کارزار"
  },
  {
    "poem_id": 88015,
    "vorder": 241,
    "position": 0,
    "text": "که نابردنی بود برگاشتند"
  },
  {
    "poem_id": 88015,
    "vorder": 242,
    "position": 1,
    "text": "بزال و فرامرز بگذاشتند"
  },
  {
    "poem_id": 88015,
    "vorder": 243,
    "position": 0,
    "text": "سوی شهر ایران نهادند روی"
  },
  {
    "poem_id": 88015,
    "vorder": 244,
    "position": 1,
    "text": "همه راه پویان و دل کینه‌جوی"
  },
  {
    "poem_id": 88015,
    "vorder": 245,
    "position": 0,
    "text": "چو رستم بنزدیک ایران رسید"
  },
  {
    "poem_id": 88015,
    "vorder": 246,
    "position": 1,
    "text": "بنزدیک شهر دلیران رسید"
  },
  {
    "poem_id": 88015,
    "vorder": 247,
    "position": 0,
    "text": "یکی باد نوشین درود سپهر"
  },
  {
    "poem_id": 88015,
    "vorder": 248,
    "position": 1,
    "text": "برستم رسانید شادان بمهر"
  },
  {
    "poem_id": 88015,
    "vorder": 249,
    "position": 0,
    "text": "بر رستم آمد همانگاه گیو"
  },
  {
    "poem_id": 88015,
    "vorder": 250,
    "position": 1,
    "text": "کز ایدر نباید شدن پیش نیو"
  },
  {
    "poem_id": 88015,
    "vorder": 251,
    "position": 0,
    "text": "شوم گفت و آگه کنم شاه را"
  },
  {
    "poem_id": 88015,
    "vorder": 252,
    "position": 1,
    "text": "که پیمود رخش تهم راه را"
  },
  {
    "poem_id": 88015,
    "vorder": 253,
    "position": 0,
    "text": "چو رفت از بر رستم پهلوان"
  },
  {
    "poem_id": 88015,
    "vorder": 254,
    "position": 1,
    "text": "بیامد بدرگاه شاه جوان"
  },
  {
    "poem_id": 88015,
    "vorder": 255,
    "position": 0,
    "text": "چو نزدیک کیخسرو آمد فراز"
  },
  {
    "poem_id": 88015,
    "vorder": 256,
    "position": 1,
    "text": "ستودش فراوان و بردش نماز"
  },
  {
    "poem_id": 88015,
    "vorder": 257,
    "position": 0,
    "text": "پس از گیو گودرز پرسید شاه"
  },
  {
    "poem_id": 88015,
    "vorder": 258,
    "position": 1,
    "text": "که رستم کجا ماند چون بود راه"
  },
  {
    "poem_id": 88015,
    "vorder": 259,
    "position": 0,
    "text": "بدو گفت گیو ای شه نامدار"
  },
  {
    "poem_id": 88015,
    "vorder": 260,
    "position": 1,
    "text": "برآید ببخت تو هرگونه کار"
  },
  {
    "poem_id": 88015,
    "vorder": 261,
    "position": 0,
    "text": "نتابید رستم ز فرمان تو"
  },
  {
    "poem_id": 88015,
    "vorder": 262,
    "position": 1,
    "text": "دلش بسته دیدم بپیمان تو"
  },
  {
    "poem_id": 88015,
    "vorder": 263,
    "position": 0,
    "text": "چو آن نامهٔ شاه دادم بدوی"
  },
  {
    "poem_id": 88015,
    "vorder": 264,
    "position": 1,
    "text": "بمالید بر نامه بر چشم و روی"
  },
  {
    "poem_id": 88015,
    "vorder": 265,
    "position": 0,
    "text": "عنان با عنان من اندر ببست"
  },
  {
    "poem_id": 88015,
    "vorder": 266,
    "position": 1,
    "text": "چنانچون بود گرد خسروپرست"
  },
  {
    "poem_id": 88015,
    "vorder": 267,
    "position": 0,
    "text": "برفتم من از پیش تا با تو شاه"
  },
  {
    "poem_id": 88015,
    "vorder": 268,
    "position": 1,
    "text": "بگویم که آمد تهمتن ز راه"
  },
  {
    "poem_id": 88015,
    "vorder": 269,
    "position": 0,
    "text": "بگیو آنگهی گفت رستم کجاست"
  },
  {
    "poem_id": 88015,
    "vorder": 270,
    "position": 1,
    "text": "که پشت بزرگی و تخم وفاست"
  },
  {
    "poem_id": 88015,
    "vorder": 271,
    "position": 0,
    "text": "گرامیش کردن سزاوار هست"
  },
  {
    "poem_id": 88015,
    "vorder": 272,
    "position": 1,
    "text": "که نیکی نمایست و خسروپرست"
  },
  {
    "poem_id": 88015,
    "vorder": 273,
    "position": 0,
    "text": "بفرمود خسرو بفرزانگان"
  },
  {
    "poem_id": 88015,
    "vorder": 274,
    "position": 1,
    "text": "بمهتر نژادان و مردانگان"
  },
  {
    "poem_id": 88015,
    "vorder": 275,
    "position": 0,
    "text": "پذیره شدن پیش او با سپاه"
  },
  {
    "poem_id": 88015,
    "vorder": 276,
    "position": 1,
    "text": "که آمد بفرمان خسرو براه"
  },
  {
    "poem_id": 88015,
    "vorder": 277,
    "position": 0,
    "text": "بگفتند گودرز کشواد را"
  },
  {
    "poem_id": 88015,
    "vorder": 278,
    "position": 1,
    "text": "شه نوذران طوس و فرهاد را"
  },
  {
    "poem_id": 88015,
    "vorder": 279,
    "position": 0,
    "text": "دو بهره ز گردان گردنکشان"
  },
  {
    "poem_id": 88015,
    "vorder": 280,
    "position": 1,
    "text": "چه از گرزداران مردمکشان"
  },
  {
    "poem_id": 88015,
    "vorder": 281,
    "position": 0,
    "text": "بر آیین کاوس برخاستند"
  },
  {
    "poem_id": 88015,
    "vorder": 282,
    "position": 1,
    "text": "پذیره شدن را بیاراستند"
  },
  {
    "poem_id": 88015,
    "vorder": 283,
    "position": 0,
    "text": "جهان شد ز گرد سواران بنفش"
  },
  {
    "poem_id": 88015,
    "vorder": 284,
    "position": 1,
    "text": "درخشان سنان و درفشان درفش"
  },
  {
    "poem_id": 88015,
    "vorder": 285,
    "position": 0,
    "text": "چو نزدیک رستم فراز آمدند"
  },
  {
    "poem_id": 88015,
    "vorder": 286,
    "position": 1,
    "text": "پیاده برسم نماز آمدند"
  },
  {
    "poem_id": 88015,
    "vorder": 287,
    "position": 0,
    "text": "ز اسب اندر آمد جهان پهلوان"
  },
  {
    "poem_id": 88015,
    "vorder": 288,
    "position": 1,
    "text": "کجا پهلوانان بپیشش نوان"
  },
  {
    "poem_id": 88015,
    "vorder": 289,
    "position": 0,
    "text": "بپرسید مر هریکی را ز شاه"
  },
  {
    "poem_id": 88015,
    "vorder": 290,
    "position": 1,
    "text": "ز گردنده خورشید و تابنده ماه"
  },
  {
    "poem_id": 88015,
    "vorder": 291,
    "position": 0,
    "text": "نشستند گردان و رستم بر اسب"
  },
  {
    "poem_id": 88015,
    "vorder": 292,
    "position": 1,
    "text": "بکردار رخشنده آذرگشسب"
  }
]