[
  {
    "poem_id": 1700,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید شد زرد لشکر براند"
  },
  {
    "poem_id": 1700,
    "vorder": 2,
    "position": 1,
    "text": "کسی را که نابردنی بد بماند"
  },
  {
    "poem_id": 1700,
    "vorder": 3,
    "position": 0,
    "text": "چو شب نیم بگذشت و تاریک شد"
  },
  {
    "poem_id": 1700,
    "vorder": 4,
    "position": 1,
    "text": "جهاندار با کرد نزدیک شد"
  },
  {
    "poem_id": 1700,
    "vorder": 5,
    "position": 0,
    "text": "همه دشت زیشان پر از خفته دید"
  },
  {
    "poem_id": 1700,
    "vorder": 6,
    "position": 1,
    "text": "یکایک دل لشکر آشفته دید"
  },
  {
    "poem_id": 1700,
    "vorder": 7,
    "position": 0,
    "text": "چو آمد سپهبد به بالین کرد"
  },
  {
    "poem_id": 1700,
    "vorder": 8,
    "position": 1,
    "text": "عنان بارهٔ تیزتگ را سپرد"
  },
  {
    "poem_id": 1700,
    "vorder": 9,
    "position": 0,
    "text": "برآهخت شمشیر و اندرنهاد"
  },
  {
    "poem_id": 1700,
    "vorder": 10,
    "position": 1,
    "text": "گیا را ز خون بر سر افسر نهاد"
  },
  {
    "poem_id": 1700,
    "vorder": 11,
    "position": 0,
    "text": "همه دشت زیشان سر و دست شد"
  },
  {
    "poem_id": 1700,
    "vorder": 12,
    "position": 1,
    "text": "ز انبوه کشته زمین گست شد"
  },
  {
    "poem_id": 1700,
    "vorder": 13,
    "position": 0,
    "text": "بی‌اندازه زیشان گرفتار شد"
  },
  {
    "poem_id": 1700,
    "vorder": 14,
    "position": 1,
    "text": "سترگی و نابخردی خوار شد"
  },
  {
    "poem_id": 1700,
    "vorder": 15,
    "position": 0,
    "text": "همه بومهاشان به تاراج داد"
  },
  {
    "poem_id": 1700,
    "vorder": 16,
    "position": 1,
    "text": "سپه را همه بدره و تاج داد"
  },
  {
    "poem_id": 1700,
    "vorder": 17,
    "position": 0,
    "text": "چنان شد که دینار بر سر به تشت"
  },
  {
    "poem_id": 1700,
    "vorder": 18,
    "position": 1,
    "text": "اگر پیر مردی ببردی به دشت"
  },
  {
    "poem_id": 1700,
    "vorder": 19,
    "position": 0,
    "text": "به دینار او کس نکردی نگاه"
  },
  {
    "poem_id": 1700,
    "vorder": 20,
    "position": 1,
    "text": "ز نیک‌اختر و بخت وز داد شاه"
  },
  {
    "poem_id": 1700,
    "vorder": 21,
    "position": 0,
    "text": "ز مردی نکردی بدان جنگ فخر"
  },
  {
    "poem_id": 1700,
    "vorder": 22,
    "position": 1,
    "text": "گرازان بیامد به شهر صطخر"
  },
  {
    "poem_id": 1700,
    "vorder": 23,
    "position": 0,
    "text": "بفرمود کاسپان به نیرو کنید"
  },
  {
    "poem_id": 1700,
    "vorder": 24,
    "position": 1,
    "text": "سلیح سواران بی‌آهو کنید"
  },
  {
    "poem_id": 1700,
    "vorder": 25,
    "position": 0,
    "text": "چو آسوده گردید یکسر به بزم"
  },
  {
    "poem_id": 1700,
    "vorder": 26,
    "position": 1,
    "text": "که زود آید اندیشهٔ روز رزم"
  },
  {
    "poem_id": 1700,
    "vorder": 27,
    "position": 0,
    "text": "دلیران به خوردن نهادند سر"
  },
  {
    "poem_id": 1700,
    "vorder": 28,
    "position": 1,
    "text": "چو آسوده شد کردگاه و کمر"
  },
  {
    "poem_id": 1700,
    "vorder": 29,
    "position": 0,
    "text": "پراندیشهٔ رزم شد اردشیر"
  },
  {
    "poem_id": 1700,
    "vorder": 30,
    "position": 1,
    "text": "چو این داستان بشنوی یادگیر"
  }
]