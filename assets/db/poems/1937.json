[
  {
    "poem_id": 1937,
    "vorder": 1,
    "position": 0,
    "text": "کس آمد به ماهوی سوری بگفت"
  },
  {
    "poem_id": 1937,
    "vorder": 2,
    "position": 1,
    "text": "که شاه جهان گشت با خاک جفت"
  },
  {
    "poem_id": 1937,
    "vorder": 3,
    "position": 0,
    "text": "سکوبا و قسیس و رهبان روم"
  },
  {
    "poem_id": 1937,
    "vorder": 4,
    "position": 1,
    "text": "همه سوگواران آن مرز و بوم"
  },
  {
    "poem_id": 1937,
    "vorder": 5,
    "position": 0,
    "text": "برفتند با مویه برنا و پیر"
  },
  {
    "poem_id": 1937,
    "vorder": 6,
    "position": 1,
    "text": "تن شاه بردند زان آبگیر"
  },
  {
    "poem_id": 1937,
    "vorder": 7,
    "position": 0,
    "text": "یکی دخمه کردند او را به باغ"
  },
  {
    "poem_id": 1937,
    "vorder": 8,
    "position": 1,
    "text": "بلند و بزرگیش برتر ز راغ"
  },
  {
    "poem_id": 1937,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت ماهوی بدبخت و شوم"
  },
  {
    "poem_id": 1937,
    "vorder": 10,
    "position": 1,
    "text": "که ایران نبُد پیش از این خویشِ روم"
  },
  {
    "poem_id": 1937,
    "vorder": 11,
    "position": 0,
    "text": "فرستاد تا هر که آن دخمه کرد"
  },
  {
    "poem_id": 1937,
    "vorder": 12,
    "position": 1,
    "text": "هم آنکس کزان کار تیمار خوَرد"
  },
  {
    "poem_id": 1937,
    "vorder": 13,
    "position": 0,
    "text": "بکشتند و تاراج کردند مرز"
  },
  {
    "poem_id": 1937,
    "vorder": 14,
    "position": 1,
    "text": "چنین بود ماهوی را کام و ارز"
  },
  {
    "poem_id": 1937,
    "vorder": 15,
    "position": 0,
    "text": "ازان پس بگرد جهان بنگرید"
  },
  {
    "poem_id": 1937,
    "vorder": 16,
    "position": 1,
    "text": "ز تخم بزرگان کسی را ندید"
  },
  {
    "poem_id": 1937,
    "vorder": 17,
    "position": 0,
    "text": "همان تاج با او بد و مهر شاه"
  },
  {
    "poem_id": 1937,
    "vorder": 18,
    "position": 1,
    "text": "شبان‌زاده را آرزو کرد گاه"
  },
  {
    "poem_id": 1937,
    "vorder": 19,
    "position": 0,
    "text": "همه رازدارانش را پیش خواند"
  },
  {
    "poem_id": 1937,
    "vorder": 20,
    "position": 1,
    "text": "سخن هرچ بودش به دل در براند"
  },
  {
    "poem_id": 1937,
    "vorder": 21,
    "position": 0,
    "text": "به دستور گفت ای جهاندیده مرد"
  },
  {
    "poem_id": 1937,
    "vorder": 22,
    "position": 1,
    "text": "فراز آمد آن روز ننگ و نبرد"
  },
  {
    "poem_id": 1937,
    "vorder": 23,
    "position": 0,
    "text": "نه گنجست با من نه نام و نژاد"
  },
  {
    "poem_id": 1937,
    "vorder": 24,
    "position": 1,
    "text": "همی‌ داد خواهم سر خود بباد"
  },
  {
    "poem_id": 1937,
    "vorder": 25,
    "position": 0,
    "text": "بر انگشتری یزدگردست نام"
  },
  {
    "poem_id": 1937,
    "vorder": 26,
    "position": 1,
    "text": "به شمشیر بر من نگردند رام"
  },
  {
    "poem_id": 1937,
    "vorder": 27,
    "position": 0,
    "text": "همه شهر ایران ورا بنده بود"
  },
  {
    "poem_id": 1937,
    "vorder": 28,
    "position": 1,
    "text": "اگر خویش بد ار پراگنده بود"
  },
  {
    "poem_id": 1937,
    "vorder": 29,
    "position": 0,
    "text": "نخواند مرا مرد داننده شاه"
  },
  {
    "poem_id": 1937,
    "vorder": 30,
    "position": 1,
    "text": "نه بر مهرم آرام گیرد سپاه"
  },
  {
    "poem_id": 1937,
    "vorder": 31,
    "position": 0,
    "text": "جزین بود چاره مرا در نهان"
  },
  {
    "poem_id": 1937,
    "vorder": 32,
    "position": 1,
    "text": "چرا ریختم خون شاه جهان"
  },
  {
    "poem_id": 1937,
    "vorder": 33,
    "position": 0,
    "text": "همه شب ز اندیشه پر خون بُدم"
  },
  {
    "poem_id": 1937,
    "vorder": 34,
    "position": 1,
    "text": "جهاندار داند که من چون بدم"
  },
  {
    "poem_id": 1937,
    "vorder": 35,
    "position": 0,
    "text": "بدو رای‌زن گفت که اکنون گذشت"
  },
  {
    "poem_id": 1937,
    "vorder": 36,
    "position": 1,
    "text": "ازین کار گیتی پرآواز گشت"
  },
  {
    "poem_id": 1937,
    "vorder": 37,
    "position": 0,
    "text": "کنون بازجویی همی کار خویش"
  },
  {
    "poem_id": 1937,
    "vorder": 38,
    "position": 1,
    "text": "که بگسستی آن رشتهٔ تار خویش"
  },
  {
    "poem_id": 1937,
    "vorder": 39,
    "position": 0,
    "text": "کنون او بدخمه درون خاک شد"
  },
  {
    "poem_id": 1937,
    "vorder": 40,
    "position": 1,
    "text": "روان ورا زهر تریاک شد"
  },
  {
    "poem_id": 1937,
    "vorder": 41,
    "position": 0,
    "text": "جهاندیدگان را همه گرد کن"
  },
  {
    "poem_id": 1937,
    "vorder": 42,
    "position": 1,
    "text": "زبان تیز گردان به شیرین سخُن"
  },
  {
    "poem_id": 1937,
    "vorder": 43,
    "position": 0,
    "text": "چنین گوی کاین تاج و انگشتری"
  },
  {
    "poem_id": 1937,
    "vorder": 44,
    "position": 1,
    "text": "مرا شاه داد از پی مهتری"
  },
  {
    "poem_id": 1937,
    "vorder": 45,
    "position": 0,
    "text": "چو دانست کامد ز ترکان سپاه"
  },
  {
    "poem_id": 1937,
    "vorder": 46,
    "position": 1,
    "text": "چو شب تیره‌تر شد مرا خواند شاه"
  },
  {
    "poem_id": 1937,
    "vorder": 47,
    "position": 0,
    "text": "مرا گفت چون خاست باد نبرد"
  },
  {
    "poem_id": 1937,
    "vorder": 48,
    "position": 1,
    "text": "که داند به گیتی که بر کیست گرد"
  },
  {
    "poem_id": 1937,
    "vorder": 49,
    "position": 0,
    "text": "تو این تاج و انگشتری را بدار"
  },
  {
    "poem_id": 1937,
    "vorder": 50,
    "position": 1,
    "text": "بود روز کین تاجت آید به کار"
  },
  {
    "poem_id": 1937,
    "vorder": 51,
    "position": 0,
    "text": "مرا نیست چیزی جزین در جهان"
  },
  {
    "poem_id": 1937,
    "vorder": 52,
    "position": 1,
    "text": "همانا که هست این ز تازی نهان"
  },
  {
    "poem_id": 1937,
    "vorder": 53,
    "position": 0,
    "text": "تو زین پس به دشمن مده گاه من"
  },
  {
    "poem_id": 1937,
    "vorder": 54,
    "position": 1,
    "text": "نگه‌دار هم زین نشان راه من"
  },
  {
    "poem_id": 1937,
    "vorder": 55,
    "position": 0,
    "text": "من این تاج میراث دارم ز شاه"
  },
  {
    "poem_id": 1937,
    "vorder": 56,
    "position": 1,
    "text": "به فرمان او برنشینم به گاه"
  },
  {
    "poem_id": 1937,
    "vorder": 57,
    "position": 0,
    "text": "بدین چاره ده بند بد را فروغ"
  },
  {
    "poem_id": 1937,
    "vorder": 58,
    "position": 1,
    "text": "که داند که این راستست از دروغ"
  },
  {
    "poem_id": 1937,
    "vorder": 59,
    "position": 0,
    "text": "چو بشنید ماهوی گفتا که زه"
  },
  {
    "poem_id": 1937,
    "vorder": 60,
    "position": 1,
    "text": "تو دستوری و بر تو بر نیست مه"
  },
  {
    "poem_id": 1937,
    "vorder": 61,
    "position": 0,
    "text": "همه مهتران را ز لشکر بخواند"
  },
  {
    "poem_id": 1937,
    "vorder": 62,
    "position": 1,
    "text": "وزین گونه چندین سخنها براند"
  },
  {
    "poem_id": 1937,
    "vorder": 63,
    "position": 0,
    "text": "بدانست لشکر که این نیست راست"
  },
  {
    "poem_id": 1937,
    "vorder": 64,
    "position": 1,
    "text": "به شوخی ورا سر بریدن سزاست"
  },
  {
    "poem_id": 1937,
    "vorder": 65,
    "position": 0,
    "text": "یکی پهلوان گفت کاین کارِ تست"
  },
  {
    "poem_id": 1937,
    "vorder": 66,
    "position": 1,
    "text": "سخن گر درستست گر نادرست"
  },
  {
    "poem_id": 1937,
    "vorder": 67,
    "position": 0,
    "text": "چو بشنید بر تخت شاهی نشست"
  },
  {
    "poem_id": 1937,
    "vorder": 68,
    "position": 1,
    "text": "به افسون خراسانش آمد بدست"
  },
  {
    "poem_id": 1937,
    "vorder": 69,
    "position": 0,
    "text": "ببخشید روی زمین بر مهان"
  },
  {
    "poem_id": 1937,
    "vorder": 70,
    "position": 1,
    "text": "منم گفت با مهر شاه جهان"
  },
  {
    "poem_id": 1937,
    "vorder": 71,
    "position": 0,
    "text": "جهان را سراسر به بخشش گرفت"
  },
  {
    "poem_id": 1937,
    "vorder": 72,
    "position": 1,
    "text": "ستاره نظاره برو ای شگفت"
  },
  {
    "poem_id": 1937,
    "vorder": 73,
    "position": 0,
    "text": "به مهتر پسر داد بلخ و هری"
  },
  {
    "poem_id": 1937,
    "vorder": 74,
    "position": 1,
    "text": "فرستاد بر هر سوی لشکری"
  },
  {
    "poem_id": 1937,
    "vorder": 75,
    "position": 0,
    "text": "بداندیشگان را همه برکشید"
  },
  {
    "poem_id": 1937,
    "vorder": 76,
    "position": 1,
    "text": "بدانسان که از گوهر او سزید"
  },
  {
    "poem_id": 1937,
    "vorder": 77,
    "position": 0,
    "text": "بدان را بهَر جای سالار کرد"
  },
  {
    "poem_id": 1937,
    "vorder": 78,
    "position": 1,
    "text": "خردمند را سرنگونسار کرد"
  },
  {
    "poem_id": 1937,
    "vorder": 79,
    "position": 0,
    "text": "چو زیر اندر آمد سر راستی"
  },
  {
    "poem_id": 1937,
    "vorder": 80,
    "position": 1,
    "text": "پدید آمد از هر سوی کاستی"
  },
  {
    "poem_id": 1937,
    "vorder": 81,
    "position": 0,
    "text": "چو لشکر فراوان شد و خواسته"
  },
  {
    "poem_id": 1937,
    "vorder": 82,
    "position": 1,
    "text": "دل مرد بی تن شد آراسته"
  },
  {
    "poem_id": 1937,
    "vorder": 83,
    "position": 0,
    "text": "سپه را درم داد و آباد کرد"
  },
  {
    "poem_id": 1937,
    "vorder": 84,
    "position": 1,
    "text": "سر دوده خویش پرباد کرد"
  },
  {
    "poem_id": 1937,
    "vorder": 85,
    "position": 0,
    "text": "به آموی شد پهلو پیش رو"
  },
  {
    "poem_id": 1937,
    "vorder": 86,
    "position": 1,
    "text": "ابا لشکری جنگ‌سازان نو"
  },
  {
    "poem_id": 1937,
    "vorder": 87,
    "position": 0,
    "text": "طلایه به پیش سپاه اندرون"
  },
  {
    "poem_id": 1937,
    "vorder": 88,
    "position": 1,
    "text": "جهان‌دیده‌ای نام او گرستون"
  },
  {
    "poem_id": 1937,
    "vorder": 89,
    "position": 0,
    "text": "به شهر بخارا نهادند روی"
  },
  {
    "poem_id": 1937,
    "vorder": 90,
    "position": 1,
    "text": "چنان ساخته لشکری جنگجوی"
  },
  {
    "poem_id": 1937,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت ما را سمرقند و چاچ"
  },
  {
    "poem_id": 1937,
    "vorder": 92,
    "position": 1,
    "text": "بباید گرفتن بدین مهر و تاج"
  },
  {
    "poem_id": 1937,
    "vorder": 93,
    "position": 0,
    "text": "به فرمان شاه جهان یزدگرد"
  },
  {
    "poem_id": 1937,
    "vorder": 94,
    "position": 1,
    "text": "که سالار بُد او بر این هفت گرد"
  },
  {
    "poem_id": 1937,
    "vorder": 95,
    "position": 0,
    "text": "ز بیژن بخواهم به شمشیر کین"
  },
  {
    "poem_id": 1937,
    "vorder": 96,
    "position": 1,
    "text": "کزو تیره شد بخت ایران‌زمین"
  }
]