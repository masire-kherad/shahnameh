[
  {
    "poem_id": 1396,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا موبدان و ردان"
  },
  {
    "poem_id": 1396,
    "vorder": 2,
    "position": 1,
    "text": "ستاره‌شناسان و هم بخردان"
  },
  {
    "poem_id": 1396,
    "vorder": 3,
    "position": 0,
    "text": "کنند انجمن پیش تخت بلند"
  },
  {
    "poem_id": 1396,
    "vorder": 4,
    "position": 1,
    "text": "به کار سپهری پژوهش کنند"
  },
  {
    "poem_id": 1396,
    "vorder": 5,
    "position": 0,
    "text": "برفتند و بردند رنج دراز"
  },
  {
    "poem_id": 1396,
    "vorder": 6,
    "position": 1,
    "text": "که تا با ستاره چه دارند راز"
  },
  {
    "poem_id": 1396,
    "vorder": 7,
    "position": 0,
    "text": "سه روز اندران کارشان شد درنگ"
  },
  {
    "poem_id": 1396,
    "vorder": 8,
    "position": 1,
    "text": "برفتند با زیج رومی به چنگ"
  },
  {
    "poem_id": 1396,
    "vorder": 9,
    "position": 0,
    "text": "زبان بر گشادند بر شهریار"
  },
  {
    "poem_id": 1396,
    "vorder": 10,
    "position": 1,
    "text": "که کردیم با چرخ گردان شمار"
  },
  {
    "poem_id": 1396,
    "vorder": 11,
    "position": 0,
    "text": "چنین آمد از داد اختر پدید"
  },
  {
    "poem_id": 1396,
    "vorder": 12,
    "position": 1,
    "text": "که این آب روشن بخواهد دوید"
  },
  {
    "poem_id": 1396,
    "vorder": 13,
    "position": 0,
    "text": "ازین دخت مهراب و از پور سام"
  },
  {
    "poem_id": 1396,
    "vorder": 14,
    "position": 1,
    "text": "گوی پر منش زاید و نیک نام"
  },
  {
    "poem_id": 1396,
    "vorder": 15,
    "position": 0,
    "text": "بود زندگانیش بسیار مر"
  },
  {
    "poem_id": 1396,
    "vorder": 16,
    "position": 1,
    "text": "همش زور باشد هم آیین و فر"
  },
  {
    "poem_id": 1396,
    "vorder": 17,
    "position": 0,
    "text": "همش برز باشد همش شاخ و یال"
  },
  {
    "poem_id": 1396,
    "vorder": 18,
    "position": 1,
    "text": "به رزم و به بزمش نباشد همال"
  },
  {
    "poem_id": 1396,
    "vorder": 19,
    "position": 0,
    "text": "کجا بارهٔ او کند موی تر"
  },
  {
    "poem_id": 1396,
    "vorder": 20,
    "position": 1,
    "text": "شود خشک همرزم او را جگر"
  },
  {
    "poem_id": 1396,
    "vorder": 21,
    "position": 0,
    "text": "عقاب از بر ترگ او نگذرد"
  },
  {
    "poem_id": 1396,
    "vorder": 22,
    "position": 1,
    "text": "سران جهان را بکس نشمرد"
  },
  {
    "poem_id": 1396,
    "vorder": 23,
    "position": 0,
    "text": "یکی برز بالا بود فرمند"
  },
  {
    "poem_id": 1396,
    "vorder": 24,
    "position": 1,
    "text": "همه شیر گیرد به خم کمند"
  },
  {
    "poem_id": 1396,
    "vorder": 25,
    "position": 0,
    "text": "هوا را به شمشیر گریان کند"
  },
  {
    "poem_id": 1396,
    "vorder": 26,
    "position": 1,
    "text": "بر آتش یکی گور بریان کند"
  },
  {
    "poem_id": 1396,
    "vorder": 27,
    "position": 0,
    "text": "کمر بستهٔ شهریاران بود"
  },
  {
    "poem_id": 1396,
    "vorder": 28,
    "position": 1,
    "text": "به ایران پناه سواران بود"
  }
]