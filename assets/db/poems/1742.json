[
  {
    "poem_id": 1742,
    "vorder": 1,
    "position": 0,
    "text": "بسی برنیامد برین روزگار"
  },
  {
    "poem_id": 1742,
    "vorder": 2,
    "position": 1,
    "text": "که شد مردم لشکری شش هزار"
  },
  {
    "poem_id": 1742,
    "vorder": 3,
    "position": 0,
    "text": "فرستاد شاپور کارآگهان"
  },
  {
    "poem_id": 1742,
    "vorder": 4,
    "position": 1,
    "text": "سوی طیسفون کاردیده مهان"
  },
  {
    "poem_id": 1742,
    "vorder": 5,
    "position": 0,
    "text": "بدان تا ز قیصر دهند آگهی"
  },
  {
    "poem_id": 1742,
    "vorder": 6,
    "position": 1,
    "text": "ازان برز درگاه با فرهی"
  },
  {
    "poem_id": 1742,
    "vorder": 7,
    "position": 0,
    "text": "برفتند کارآگهان ناگهان"
  },
  {
    "poem_id": 1742,
    "vorder": 8,
    "position": 1,
    "text": "نهفته بجستند کار جهان"
  },
  {
    "poem_id": 1742,
    "vorder": 9,
    "position": 0,
    "text": "بدیدند هرگونه بازآمدند"
  },
  {
    "poem_id": 1742,
    "vorder": 10,
    "position": 1,
    "text": "بر شاه گردن‌فراز آمدند"
  },
  {
    "poem_id": 1742,
    "vorder": 11,
    "position": 0,
    "text": "که قیصر ز می خوردن و از شکار"
  },
  {
    "poem_id": 1742,
    "vorder": 12,
    "position": 1,
    "text": "همی هیچ نندیشد از کارزار"
  },
  {
    "poem_id": 1742,
    "vorder": 13,
    "position": 0,
    "text": "سپاهش پراگنده از هر سوی"
  },
  {
    "poem_id": 1742,
    "vorder": 14,
    "position": 1,
    "text": "به تاراج کردن به هر پهلوی"
  },
  {
    "poem_id": 1742,
    "vorder": 15,
    "position": 0,
    "text": "نه روزش طلایه نه شب پاسبان"
  },
  {
    "poem_id": 1742,
    "vorder": 16,
    "position": 1,
    "text": "سپاهش همه چون رمه بی‌شبان"
  },
  {
    "poem_id": 1742,
    "vorder": 17,
    "position": 0,
    "text": "نبیند همی دشمن از هیچ روی"
  },
  {
    "poem_id": 1742,
    "vorder": 18,
    "position": 1,
    "text": "پسند آمدش زیستن برزوی"
  },
  {
    "poem_id": 1742,
    "vorder": 19,
    "position": 0,
    "text": "چو شاپور بشنید زان شاد شد"
  },
  {
    "poem_id": 1742,
    "vorder": 20,
    "position": 1,
    "text": "همه رنجها بر دلش باد شد"
  },
  {
    "poem_id": 1742,
    "vorder": 21,
    "position": 0,
    "text": "گزین کرد ز ایرانیان سه هزار"
  },
  {
    "poem_id": 1742,
    "vorder": 22,
    "position": 1,
    "text": "زره‌دار و برگستوان ور سوار"
  },
  {
    "poem_id": 1742,
    "vorder": 23,
    "position": 0,
    "text": "شب تیره جوشن به بر در کشید"
  },
  {
    "poem_id": 1742,
    "vorder": 24,
    "position": 1,
    "text": "سپه را سوی طیسفون برکشید"
  },
  {
    "poem_id": 1742,
    "vorder": 25,
    "position": 0,
    "text": "به تیره شبان تیز بشتافتی"
  },
  {
    "poem_id": 1742,
    "vorder": 26,
    "position": 1,
    "text": "چو روشن شدی روی برتافتی"
  },
  {
    "poem_id": 1742,
    "vorder": 27,
    "position": 0,
    "text": "همی راندی در بیابان و کوه"
  },
  {
    "poem_id": 1742,
    "vorder": 28,
    "position": 1,
    "text": "بران راه بی‌راه خود با گروه"
  },
  {
    "poem_id": 1742,
    "vorder": 29,
    "position": 0,
    "text": "فزون از دو فرسنگ پیش سپاه"
  },
  {
    "poem_id": 1742,
    "vorder": 30,
    "position": 1,
    "text": "همی دیده‌بان بود بی‌راه و راه"
  },
  {
    "poem_id": 1742,
    "vorder": 31,
    "position": 0,
    "text": "چنین تا به نزدیکی طیسفون"
  },
  {
    "poem_id": 1742,
    "vorder": 32,
    "position": 1,
    "text": "طلایه همی راند پیش اندرون"
  },
  {
    "poem_id": 1742,
    "vorder": 33,
    "position": 0,
    "text": "به لشکر گه آمد گذشته دو پاس"
  },
  {
    "poem_id": 1742,
    "vorder": 34,
    "position": 1,
    "text": "ز قیصر نبودش به دل در هراس"
  },
  {
    "poem_id": 1742,
    "vorder": 35,
    "position": 0,
    "text": "ازان مرز بشنید آواز کوس"
  },
  {
    "poem_id": 1742,
    "vorder": 36,
    "position": 1,
    "text": "غو پاسبانان چو بانگ خروس"
  },
  {
    "poem_id": 1742,
    "vorder": 37,
    "position": 0,
    "text": "پر از خیمه یک دشت و خرگاه بود"
  },
  {
    "poem_id": 1742,
    "vorder": 38,
    "position": 1,
    "text": "ازان تاختن خود که آگاه بود"
  },
  {
    "poem_id": 1742,
    "vorder": 39,
    "position": 0,
    "text": "ز می مست قیصر به پرده‌سرای"
  },
  {
    "poem_id": 1742,
    "vorder": 40,
    "position": 1,
    "text": "ز لشکر نبود اندران مرز جای"
  },
  {
    "poem_id": 1742,
    "vorder": 41,
    "position": 0,
    "text": "چو گیتی چنان دید شاپور گرد"
  },
  {
    "poem_id": 1742,
    "vorder": 42,
    "position": 1,
    "text": "عنان کیی بارگی را سپرد"
  },
  {
    "poem_id": 1742,
    "vorder": 43,
    "position": 0,
    "text": "سپه را به لشکرگه اندر کشید"
  },
  {
    "poem_id": 1742,
    "vorder": 44,
    "position": 1,
    "text": "بزد دست و گرز گران برکشید"
  },
  {
    "poem_id": 1742,
    "vorder": 45,
    "position": 0,
    "text": "به ابر اندر آمد دم کرنای"
  },
  {
    "poem_id": 1742,
    "vorder": 46,
    "position": 1,
    "text": "جرنگیدن گرز و هندی درای"
  },
  {
    "poem_id": 1742,
    "vorder": 47,
    "position": 0,
    "text": "دهاده برآمد ز هر پهلوی"
  },
  {
    "poem_id": 1742,
    "vorder": 48,
    "position": 1,
    "text": "چکاچاک برخاست از هر سوی"
  },
  {
    "poem_id": 1742,
    "vorder": 49,
    "position": 0,
    "text": "تو گفتی همی آسمان بترکید"
  },
  {
    "poem_id": 1742,
    "vorder": 50,
    "position": 1,
    "text": "ز خورشید خون بر هوا برچکید"
  },
  {
    "poem_id": 1742,
    "vorder": 51,
    "position": 0,
    "text": "درفشیدن کاویانی درفش"
  },
  {
    "poem_id": 1742,
    "vorder": 52,
    "position": 1,
    "text": "شب تیره و تیغهای بنفش"
  },
  {
    "poem_id": 1742,
    "vorder": 53,
    "position": 0,
    "text": "تو گفتی هوا تیغ بارد همی"
  },
  {
    "poem_id": 1742,
    "vorder": 54,
    "position": 1,
    "text": "جهان یکسره میغ دارد همی"
  },
  {
    "poem_id": 1742,
    "vorder": 55,
    "position": 0,
    "text": "ز گرد سپه کوه شد ناپدید"
  },
  {
    "poem_id": 1742,
    "vorder": 56,
    "position": 1,
    "text": "ستاره همی دامن اندرکشید"
  },
  {
    "poem_id": 1742,
    "vorder": 57,
    "position": 0,
    "text": "سراپردهٔ قیصر بی‌هنر"
  },
  {
    "poem_id": 1742,
    "vorder": 58,
    "position": 1,
    "text": "همی کرد شاپور زیر و زبر"
  },
  {
    "poem_id": 1742,
    "vorder": 59,
    "position": 0,
    "text": "به هر گوشه‌ای آتش اندر زدند"
  },
  {
    "poem_id": 1742,
    "vorder": 60,
    "position": 1,
    "text": "همی آسمان بر زمین بر زدند"
  },
  {
    "poem_id": 1742,
    "vorder": 61,
    "position": 0,
    "text": "سرانجام قیصر گرفتار شد"
  },
  {
    "poem_id": 1742,
    "vorder": 62,
    "position": 1,
    "text": "وزو اختر نیک بیزار شد"
  },
  {
    "poem_id": 1742,
    "vorder": 63,
    "position": 0,
    "text": "وزان خیمه‌ها نامداران اوی"
  },
  {
    "poem_id": 1742,
    "vorder": 64,
    "position": 1,
    "text": "دلیر و گزیده سواران اوی"
  },
  {
    "poem_id": 1742,
    "vorder": 65,
    "position": 0,
    "text": "گرفتند بسیار و کردند بند"
  },
  {
    "poem_id": 1742,
    "vorder": 66,
    "position": 1,
    "text": "چنین است کردار چرخ بلند"
  },
  {
    "poem_id": 1742,
    "vorder": 67,
    "position": 0,
    "text": "گهی زو فراز آید و گه نشیب"
  },
  {
    "poem_id": 1742,
    "vorder": 68,
    "position": 1,
    "text": "گهی شادمانی و گاهی نهیب"
  },
  {
    "poem_id": 1742,
    "vorder": 69,
    "position": 0,
    "text": "بی‌آزاری و مردمی بهترست"
  },
  {
    "poem_id": 1742,
    "vorder": 70,
    "position": 1,
    "text": "کرا کردگار جهان یاورست"
  }
]