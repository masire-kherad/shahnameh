[
  {
    "poem_id": 1892,
    "vorder": 1,
    "position": 0,
    "text": "دوات و قلم خواست ناباک زن"
  },
  {
    "poem_id": 1892,
    "vorder": 2,
    "position": 1,
    "text": "ز هرگونه انداخت با رای زن"
  },
  {
    "poem_id": 1892,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامه بنوشت نزدیک شاه"
  },
  {
    "poem_id": 1892,
    "vorder": 4,
    "position": 1,
    "text": "ز بدخواه وز مردم نیک خواه"
  },
  {
    "poem_id": 1892,
    "vorder": 5,
    "position": 0,
    "text": "سر نامه کرد آفرین از نخست"
  },
  {
    "poem_id": 1892,
    "vorder": 6,
    "position": 1,
    "text": "بر آنکس که او کینه از دل بشست"
  },
  {
    "poem_id": 1892,
    "vorder": 7,
    "position": 0,
    "text": "دگر گفت کاری که فرمود شاه"
  },
  {
    "poem_id": 1892,
    "vorder": 8,
    "position": 1,
    "text": "بر آمد بکام دل نیک خواه"
  },
  {
    "poem_id": 1892,
    "vorder": 9,
    "position": 0,
    "text": "پراگنده گشت آن سپاه سترگ"
  },
  {
    "poem_id": 1892,
    "vorder": 10,
    "position": 1,
    "text": "به بخت جهاندار شاه بزرگ"
  },
  {
    "poem_id": 1892,
    "vorder": 11,
    "position": 0,
    "text": "ازین پس کنون تا چه فرمان دهی"
  },
  {
    "poem_id": 1892,
    "vorder": 12,
    "position": 1,
    "text": "چه آویزی از گوشوار رهی"
  },
  {
    "poem_id": 1892,
    "vorder": 13,
    "position": 0,
    "text": "چو آن نامه نزدیک خسرو رسید"
  },
  {
    "poem_id": 1892,
    "vorder": 14,
    "position": 1,
    "text": "از آن زن ورا شادی نو رسید"
  },
  {
    "poem_id": 1892,
    "vorder": 15,
    "position": 0,
    "text": "فرستاده‌ای خواست شیرین سخن"
  },
  {
    "poem_id": 1892,
    "vorder": 16,
    "position": 1,
    "text": "که داند همه داستان کهن"
  },
  {
    "poem_id": 1892,
    "vorder": 17,
    "position": 0,
    "text": "یکی نامه برسان ارژنگ چین"
  },
  {
    "poem_id": 1892,
    "vorder": 18,
    "position": 1,
    "text": "نوشتند و کردند چند آفرین"
  },
  {
    "poem_id": 1892,
    "vorder": 19,
    "position": 0,
    "text": "گرانمایه زن را به درگاه خواند"
  },
  {
    "poem_id": 1892,
    "vorder": 20,
    "position": 1,
    "text": "به نامه ورا افسر ماه خواند"
  },
  {
    "poem_id": 1892,
    "vorder": 21,
    "position": 0,
    "text": "فرستاده آمد بر زن چوگرد"
  },
  {
    "poem_id": 1892,
    "vorder": 22,
    "position": 1,
    "text": "سخنهای خسرو بدو یادکرد"
  },
  {
    "poem_id": 1892,
    "vorder": 23,
    "position": 0,
    "text": "زن شیر زان نامهٔ شهریار"
  },
  {
    "poem_id": 1892,
    "vorder": 24,
    "position": 1,
    "text": "چو رخشنده گل شد به وقت بهار"
  },
  {
    "poem_id": 1892,
    "vorder": 25,
    "position": 0,
    "text": "سپه را به در خواند و روزی بداد"
  },
  {
    "poem_id": 1892,
    "vorder": 26,
    "position": 1,
    "text": "چو شد روز روشن بنه برنهاد"
  },
  {
    "poem_id": 1892,
    "vorder": 27,
    "position": 0,
    "text": "چو آمد به نزدیکی شهریار"
  },
  {
    "poem_id": 1892,
    "vorder": 28,
    "position": 1,
    "text": "سپاهی پذیره شدش بی‌شمار"
  },
  {
    "poem_id": 1892,
    "vorder": 29,
    "position": 0,
    "text": "ز ره چون بدرگاه شد بار یافت"
  },
  {
    "poem_id": 1892,
    "vorder": 30,
    "position": 1,
    "text": "دل تاجور پر ز تیمار یافت"
  },
  {
    "poem_id": 1892,
    "vorder": 31,
    "position": 0,
    "text": "بیاورد زان پس نثاری گران"
  },
  {
    "poem_id": 1892,
    "vorder": 32,
    "position": 1,
    "text": "هر آنکس که بودند با اوسران"
  },
  {
    "poem_id": 1892,
    "vorder": 33,
    "position": 0,
    "text": "همان گنج و آن خواسته پیش برد"
  },
  {
    "poem_id": 1892,
    "vorder": 34,
    "position": 1,
    "text": "یکایک به گنج‌ور اوبرشمرد"
  },
  {
    "poem_id": 1892,
    "vorder": 35,
    "position": 0,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1892,
    "vorder": 36,
    "position": 1,
    "text": "کس آن را ندانست کردن شمار"
  },
  {
    "poem_id": 1892,
    "vorder": 37,
    "position": 0,
    "text": "ز دیبای زر بفت و تاج و کمر"
  },
  {
    "poem_id": 1892,
    "vorder": 38,
    "position": 1,
    "text": "همان تخت زرین و زرین سپر"
  },
  {
    "poem_id": 1892,
    "vorder": 39,
    "position": 0,
    "text": "نگه کرد خسرو بران زاد سرو"
  },
  {
    "poem_id": 1892,
    "vorder": 40,
    "position": 1,
    "text": "به رخ چون بهار و به رفتن تذرو"
  },
  {
    "poem_id": 1892,
    "vorder": 41,
    "position": 0,
    "text": "به رخساره روز و به گیسو چو شب"
  },
  {
    "poem_id": 1892,
    "vorder": 42,
    "position": 1,
    "text": "همی در بارد تو گویی ز لب"
  },
  {
    "poem_id": 1892,
    "vorder": 43,
    "position": 0,
    "text": "ورا در شبستان فرستاد شاه"
  },
  {
    "poem_id": 1892,
    "vorder": 44,
    "position": 1,
    "text": "ز هر کس فزون شد و را پایگاه"
  },
  {
    "poem_id": 1892,
    "vorder": 45,
    "position": 0,
    "text": "فرستاد نزد برادرش کس"
  },
  {
    "poem_id": 1892,
    "vorder": 46,
    "position": 1,
    "text": "همان نزد دستور فریادرس"
  },
  {
    "poem_id": 1892,
    "vorder": 47,
    "position": 0,
    "text": "بر آیین آن دین مر او رابخواست"
  },
  {
    "poem_id": 1892,
    "vorder": 48,
    "position": 1,
    "text": "بپذرفت با جان همی‌داشت راست"
  },
  {
    "poem_id": 1892,
    "vorder": 49,
    "position": 0,
    "text": "بیارانش بر خلعت افگند نیز"
  },
  {
    "poem_id": 1892,
    "vorder": 50,
    "position": 1,
    "text": "درم داد و دینار و هرگونه چیز"
  }
]