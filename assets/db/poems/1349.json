[
  {
    "poem_id": 1349,
    "vorder": 1,
    "position": 0,
    "text": "برآمد برین روزگار دراز"
  },
  {
    "poem_id": 1349,
    "vorder": 2,
    "position": 1,
    "text": "کشید اژدهافش به تنگی فراز"
  },
  {
    "poem_id": 1349,
    "vorder": 3,
    "position": 0,
    "text": "خجسته فریدون ز مادر بزاد"
  },
  {
    "poem_id": 1349,
    "vorder": 4,
    "position": 1,
    "text": "جهان را یکی دیگر آمد نهاد"
  },
  {
    "poem_id": 1349,
    "vorder": 5,
    "position": 0,
    "text": "ببالید برسان سرو سهی"
  },
  {
    "poem_id": 1349,
    "vorder": 6,
    "position": 1,
    "text": "همی تافت زو فر شاهنشهی"
  },
  {
    "poem_id": 1349,
    "vorder": 7,
    "position": 0,
    "text": "جهانجوی با فر جمشید بود"
  },
  {
    "poem_id": 1349,
    "vorder": 8,
    "position": 1,
    "text": "به کردار تابنده خورشید بود"
  },
  {
    "poem_id": 1349,
    "vorder": 9,
    "position": 0,
    "text": "جهان را چو باران به بایستگی"
  },
  {
    "poem_id": 1349,
    "vorder": 10,
    "position": 1,
    "text": "روان را چو دانش به شایستگی"
  },
  {
    "poem_id": 1349,
    "vorder": 11,
    "position": 0,
    "text": "بسر بر همی گشت گردان سپهر"
  },
  {
    "poem_id": 1349,
    "vorder": 12,
    "position": 1,
    "text": "شده رام با آفریدون به مهر"
  },
  {
    "poem_id": 1349,
    "vorder": 13,
    "position": 0,
    "text": "همان گاو کش نام برمایه بود"
  },
  {
    "poem_id": 1349,
    "vorder": 14,
    "position": 1,
    "text": "ز گاوان ورا برترین پایه بود"
  },
  {
    "poem_id": 1349,
    "vorder": 15,
    "position": 0,
    "text": "ز مادر جدا شد چو طاووس نر"
  },
  {
    "poem_id": 1349,
    "vorder": 16,
    "position": 1,
    "text": "بهر موی بر تازه رنگی دگر"
  },
  {
    "poem_id": 1349,
    "vorder": 17,
    "position": 0,
    "text": "شده انجمن بر سرش بخردان"
  },
  {
    "poem_id": 1349,
    "vorder": 18,
    "position": 1,
    "text": "ستاره‌شناسان و هم موبدان"
  },
  {
    "poem_id": 1349,
    "vorder": 19,
    "position": 0,
    "text": "که کس در جهان گاو چونان ندید"
  },
  {
    "poem_id": 1349,
    "vorder": 20,
    "position": 1,
    "text": "نه از پیرسر کاردانان شنید"
  },
  {
    "poem_id": 1349,
    "vorder": 21,
    "position": 0,
    "text": "زمین کرده ضحاک پر گفت و گوی"
  },
  {
    "poem_id": 1349,
    "vorder": 22,
    "position": 1,
    "text": "به گرد جهان هم بدین جست و جوی"
  },
  {
    "poem_id": 1349,
    "vorder": 23,
    "position": 0,
    "text": "فریدون که بودش پدر آبتین"
  },
  {
    "poem_id": 1349,
    "vorder": 24,
    "position": 1,
    "text": "شده تنگ بر آبتین بر زمین"
  },
  {
    "poem_id": 1349,
    "vorder": 25,
    "position": 0,
    "text": "گریزان و از خویشتن گشته سیر"
  },
  {
    "poem_id": 1349,
    "vorder": 26,
    "position": 1,
    "text": "برآویخت ناگاه بر کام شیر"
  },
  {
    "poem_id": 1349,
    "vorder": 27,
    "position": 0,
    "text": "از آن روزبانان ناپاک مرد"
  },
  {
    "poem_id": 1349,
    "vorder": 28,
    "position": 1,
    "text": "تنی چند روزی بدو باز خورد"
  },
  {
    "poem_id": 1349,
    "vorder": 29,
    "position": 0,
    "text": "گرفتند و بردند بسته چو یوز"
  },
  {
    "poem_id": 1349,
    "vorder": 30,
    "position": 1,
    "text": "برو بر سر آورد ضحاک روز"
  },
  {
    "poem_id": 1349,
    "vorder": 31,
    "position": 0,
    "text": "خردمند مام فریدون چو دید"
  },
  {
    "poem_id": 1349,
    "vorder": 32,
    "position": 1,
    "text": "که بر جفت او بر چنان بد رسید"
  },
  {
    "poem_id": 1349,
    "vorder": 33,
    "position": 0,
    "text": "فرانک بدش نام و فرخنده بود"
  },
  {
    "poem_id": 1349,
    "vorder": 34,
    "position": 1,
    "text": "به مهر فریدون دل آگنده بود"
  },
  {
    "poem_id": 1349,
    "vorder": 35,
    "position": 0,
    "text": "پر از داغ دل خستهٔ روزگار"
  },
  {
    "poem_id": 1349,
    "vorder": 36,
    "position": 1,
    "text": "همی رفت پویان بدان مرغزار"
  },
  {
    "poem_id": 1349,
    "vorder": 37,
    "position": 0,
    "text": "کجا نامور گاو برمایه بود"
  },
  {
    "poem_id": 1349,
    "vorder": 38,
    "position": 1,
    "text": "که بایسته بر تنش پیرایه بود"
  },
  {
    "poem_id": 1349,
    "vorder": 39,
    "position": 0,
    "text": "به پیش نگهبان آن مرغزار"
  },
  {
    "poem_id": 1349,
    "vorder": 40,
    "position": 1,
    "text": "خروشید و بارید خون بر کنار"
  },
  {
    "poem_id": 1349,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت کاین کودک شیرخوار"
  },
  {
    "poem_id": 1349,
    "vorder": 42,
    "position": 1,
    "text": "ز من روزگاری بزنهار دار"
  },
  {
    "poem_id": 1349,
    "vorder": 43,
    "position": 0,
    "text": "پدروارش از مادر اندر پذیر"
  },
  {
    "poem_id": 1349,
    "vorder": 44,
    "position": 1,
    "text": "وزین گاو نغزش بپرور به شیر"
  },
  {
    "poem_id": 1349,
    "vorder": 45,
    "position": 0,
    "text": "و گر باره خواهی روانم تراست"
  },
  {
    "poem_id": 1349,
    "vorder": 46,
    "position": 1,
    "text": "گروگان کنم جان بدان کت هواست"
  },
  {
    "poem_id": 1349,
    "vorder": 47,
    "position": 0,
    "text": "پرستندهٔ بیشه و گاو نغز"
  },
  {
    "poem_id": 1349,
    "vorder": 48,
    "position": 1,
    "text": "چنین داد پاسخ بدان پاک مغز"
  },
  {
    "poem_id": 1349,
    "vorder": 49,
    "position": 0,
    "text": "که چون بنده در پیش فرزند تو"
  },
  {
    "poem_id": 1349,
    "vorder": 50,
    "position": 1,
    "text": "بباشم پرستندهٔ پند تو"
  },
  {
    "poem_id": 1349,
    "vorder": 51,
    "position": 0,
    "text": "سه سالش همی داد زان گاو شیر"
  },
  {
    "poem_id": 1349,
    "vorder": 52,
    "position": 1,
    "text": "هشیوار بیدار زنهارگیر"
  }
]