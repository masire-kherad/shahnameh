[
  {
    "poem_id": 1464,
    "vorder": 1,
    "position": 0,
    "text": "خبر شد به نزدیک افراسیاب"
  },
  {
    "poem_id": 1464,
    "vorder": 2,
    "position": 1,
    "text": "که افگند سهراب کشتی بر آب"
  },
  {
    "poem_id": 1464,
    "vorder": 3,
    "position": 0,
    "text": "هنوز از دهن بوی شیر آیدش"
  },
  {
    "poem_id": 1464,
    "vorder": 4,
    "position": 1,
    "text": "همی رای شمشیر و تیر آیدش"
  },
  {
    "poem_id": 1464,
    "vorder": 5,
    "position": 0,
    "text": "زمین را به خنجر بشوید همی"
  },
  {
    "poem_id": 1464,
    "vorder": 6,
    "position": 1,
    "text": "کنون رزم کاووس جوید همی"
  },
  {
    "poem_id": 1464,
    "vorder": 7,
    "position": 0,
    "text": "سپاه انجمن شد برو بر بسی"
  },
  {
    "poem_id": 1464,
    "vorder": 8,
    "position": 1,
    "text": "نیاید همی یادش از هر کسی"
  },
  {
    "poem_id": 1464,
    "vorder": 9,
    "position": 0,
    "text": "سخن زین درازی چه باید کشید"
  },
  {
    "poem_id": 1464,
    "vorder": 10,
    "position": 1,
    "text": "هنر برتر از گوهر آمد پدید"
  },
  {
    "poem_id": 1464,
    "vorder": 11,
    "position": 0,
    "text": "چو افراسیاب آن سخنها شنود"
  },
  {
    "poem_id": 1464,
    "vorder": 12,
    "position": 1,
    "text": "خوش آمدش خندید و شادی نمود"
  },
  {
    "poem_id": 1464,
    "vorder": 13,
    "position": 0,
    "text": "ز لشکر گزید از دلاور سران"
  },
  {
    "poem_id": 1464,
    "vorder": 14,
    "position": 1,
    "text": "کسی کاو گراید به گرز گران"
  },
  {
    "poem_id": 1464,
    "vorder": 15,
    "position": 0,
    "text": "ده و دو هزار از دلیران گرد"
  },
  {
    "poem_id": 1464,
    "vorder": 16,
    "position": 1,
    "text": "چو هومان و مر بارمان را سپرد"
  },
  {
    "poem_id": 1464,
    "vorder": 17,
    "position": 0,
    "text": "به گردان لشکر سپهدار گفت"
  },
  {
    "poem_id": 1464,
    "vorder": 18,
    "position": 1,
    "text": "که این راز باید که ماند نهفت"
  },
  {
    "poem_id": 1464,
    "vorder": 19,
    "position": 0,
    "text": "چو روی اندر آرند هر دو بروی"
  },
  {
    "poem_id": 1464,
    "vorder": 20,
    "position": 1,
    "text": "تهمتن بود بی‌گمان چاره‌جوی"
  },
  {
    "poem_id": 1464,
    "vorder": 21,
    "position": 0,
    "text": "پدر را نباید که داند پسر"
  },
  {
    "poem_id": 1464,
    "vorder": 22,
    "position": 1,
    "text": "که بندد دل و جان به مهر پدر"
  },
  {
    "poem_id": 1464,
    "vorder": 23,
    "position": 0,
    "text": "مگر کان دلاور گو سالخورد"
  },
  {
    "poem_id": 1464,
    "vorder": 24,
    "position": 1,
    "text": "شود کشته بر دست این شیرمرد"
  },
  {
    "poem_id": 1464,
    "vorder": 25,
    "position": 0,
    "text": "ازان پس بسازید سهراب را"
  },
  {
    "poem_id": 1464,
    "vorder": 26,
    "position": 1,
    "text": "ببندید یک شب برو خواب را"
  },
  {
    "poem_id": 1464,
    "vorder": 27,
    "position": 0,
    "text": "برفتند بیدار دو پهلوان"
  },
  {
    "poem_id": 1464,
    "vorder": 28,
    "position": 1,
    "text": "به نزدیک سهراب روشن‌روان"
  },
  {
    "poem_id": 1464,
    "vorder": 29,
    "position": 0,
    "text": "به پیش اندرون هدیهٔ شهریار"
  },
  {
    "poem_id": 1464,
    "vorder": 30,
    "position": 1,
    "text": "ده اسپ و ده استر به زین و به بار"
  },
  {
    "poem_id": 1464,
    "vorder": 31,
    "position": 0,
    "text": "ز پیروزه تخت و ز بیجاده تاج"
  },
  {
    "poem_id": 1464,
    "vorder": 32,
    "position": 1,
    "text": "سر تاج زر پایهٔ تخت عاج"
  },
  {
    "poem_id": 1464,
    "vorder": 33,
    "position": 0,
    "text": "یکی نامه با لابه و دلپسند"
  },
  {
    "poem_id": 1464,
    "vorder": 34,
    "position": 1,
    "text": "نبشته به نزدیک آن ارجمند"
  },
  {
    "poem_id": 1464,
    "vorder": 35,
    "position": 0,
    "text": "که گر تخت ایران به چنگ آوری"
  },
  {
    "poem_id": 1464,
    "vorder": 36,
    "position": 1,
    "text": "زمانه برآساید از داوری"
  },
  {
    "poem_id": 1464,
    "vorder": 37,
    "position": 0,
    "text": "ازین مرز تا آن بسی راه نیست"
  },
  {
    "poem_id": 1464,
    "vorder": 38,
    "position": 1,
    "text": "سمنگان و ایران و توران یکی‌ست"
  },
  {
    "poem_id": 1464,
    "vorder": 39,
    "position": 0,
    "text": "فرستمت هرچند باید سپاه"
  },
  {
    "poem_id": 1464,
    "vorder": 40,
    "position": 1,
    "text": "تو بر تخت بنشین و برنه کلاه"
  },
  {
    "poem_id": 1464,
    "vorder": 41,
    "position": 0,
    "text": "به توران چو هومان و چون بارمان"
  },
  {
    "poem_id": 1464,
    "vorder": 42,
    "position": 1,
    "text": "دلیر و سپهبد نبد بی‌گمان"
  },
  {
    "poem_id": 1464,
    "vorder": 43,
    "position": 0,
    "text": "فرستادم اینک به فرمان تو"
  },
  {
    "poem_id": 1464,
    "vorder": 44,
    "position": 1,
    "text": "که باشند یک چند مهمان تو"
  },
  {
    "poem_id": 1464,
    "vorder": 45,
    "position": 0,
    "text": "اگر جنگ جویی تو جنگ آورند"
  },
  {
    "poem_id": 1464,
    "vorder": 46,
    "position": 1,
    "text": "جهان بر بداندیش تنگ آورند"
  },
  {
    "poem_id": 1464,
    "vorder": 47,
    "position": 0,
    "text": "چنین نامه و خلعت شهریار"
  },
  {
    "poem_id": 1464,
    "vorder": 48,
    "position": 1,
    "text": "ببردند با ساز چندان سوار"
  },
  {
    "poem_id": 1464,
    "vorder": 49,
    "position": 0,
    "text": "به سهراب آگاهی آمد ز راه"
  },
  {
    "poem_id": 1464,
    "vorder": 50,
    "position": 1,
    "text": "ز هومان و از بارمان و سپاه"
  },
  {
    "poem_id": 1464,
    "vorder": 51,
    "position": 0,
    "text": "پذیره بشد با نیا همچو باد"
  },
  {
    "poem_id": 1464,
    "vorder": 52,
    "position": 1,
    "text": "سپه دید چندان دلش گشت شاد"
  },
  {
    "poem_id": 1464,
    "vorder": 53,
    "position": 0,
    "text": "چو هومان ورا دید با یال و کفت"
  },
  {
    "poem_id": 1464,
    "vorder": 54,
    "position": 1,
    "text": "فروماند هومان ازو در شگفت"
  },
  {
    "poem_id": 1464,
    "vorder": 55,
    "position": 0,
    "text": "بدو داد پس نامهٔ شهریار"
  },
  {
    "poem_id": 1464,
    "vorder": 56,
    "position": 1,
    "text": "ابا هدیه و اسپ و استر به بار"
  },
  {
    "poem_id": 1464,
    "vorder": 57,
    "position": 0,
    "text": "جهانجوی چون نامهٔ شاه خواند"
  },
  {
    "poem_id": 1464,
    "vorder": 58,
    "position": 1,
    "text": "ازان جایگه تیز لشکر براند"
  },
  {
    "poem_id": 1464,
    "vorder": 59,
    "position": 0,
    "text": "کسی را نبد پای با او بجنگ"
  },
  {
    "poem_id": 1464,
    "vorder": 60,
    "position": 1,
    "text": "اگر شیر پیش آمدی گر پلنگ"
  },
  {
    "poem_id": 1464,
    "vorder": 61,
    "position": 0,
    "text": "دژی بود کش خواندندی سپید"
  },
  {
    "poem_id": 1464,
    "vorder": 62,
    "position": 1,
    "text": "بران دژ بد ایرانیان را امید"
  },
  {
    "poem_id": 1464,
    "vorder": 63,
    "position": 0,
    "text": "نگهبان دژ رزم دیده هجیر"
  },
  {
    "poem_id": 1464,
    "vorder": 64,
    "position": 1,
    "text": "که با زور و دل بود و با دار و گیر"
  },
  {
    "poem_id": 1464,
    "vorder": 65,
    "position": 0,
    "text": "هنوز آن زمان گستهم خرد بود"
  },
  {
    "poem_id": 1464,
    "vorder": 66,
    "position": 1,
    "text": "به خردی گراینده و گرد بود"
  },
  {
    "poem_id": 1464,
    "vorder": 67,
    "position": 0,
    "text": "یکی خواهرش بود گرد و سوار"
  },
  {
    "poem_id": 1464,
    "vorder": 68,
    "position": 1,
    "text": "بداندیش و گردنکش و نامدار"
  },
  {
    "poem_id": 1464,
    "vorder": 69,
    "position": 0,
    "text": "چو سهراب نزدیکی دژ رسید"
  },
  {
    "poem_id": 1464,
    "vorder": 70,
    "position": 1,
    "text": "هجیر دلاور سپه را بدید"
  },
  {
    "poem_id": 1464,
    "vorder": 71,
    "position": 0,
    "text": "نشست از بر بادپای چو گرد"
  },
  {
    "poem_id": 1464,
    "vorder": 72,
    "position": 1,
    "text": "ز دژ رفت پویان به دشت نبرد"
  },
  {
    "poem_id": 1464,
    "vorder": 73,
    "position": 0,
    "text": "چو سهراب جنگ‌آور او را بدید"
  },
  {
    "poem_id": 1464,
    "vorder": 74,
    "position": 1,
    "text": "برآشفت و شمشیر کین برکشید"
  },
  {
    "poem_id": 1464,
    "vorder": 75,
    "position": 0,
    "text": "ز لشکر برون تاخت برسان شیر"
  },
  {
    "poem_id": 1464,
    "vorder": 76,
    "position": 1,
    "text": "به پیش هجیر اندر آمد دلیر"
  },
  {
    "poem_id": 1464,
    "vorder": 77,
    "position": 0,
    "text": "چنین گفت با رزم‌دیده هجیر"
  },
  {
    "poem_id": 1464,
    "vorder": 78,
    "position": 1,
    "text": "که تنها به جنگ آمدی خیره خیر"
  },
  {
    "poem_id": 1464,
    "vorder": 79,
    "position": 0,
    "text": "چه مردی و نام و نژاد تو چیست"
  },
  {
    "poem_id": 1464,
    "vorder": 80,
    "position": 1,
    "text": "که زاینده را بر تو باید گریست"
  },
  {
    "poem_id": 1464,
    "vorder": 81,
    "position": 0,
    "text": "هجیرش چنین داد پاسخ که بس"
  },
  {
    "poem_id": 1464,
    "vorder": 82,
    "position": 1,
    "text": "به ترکی نباید مرا یار کس"
  },
  {
    "poem_id": 1464,
    "vorder": 83,
    "position": 0,
    "text": "هجیر دلیر و سپهبد منم"
  },
  {
    "poem_id": 1464,
    "vorder": 84,
    "position": 1,
    "text": "سرت را هم اکنون ز تن برکنم"
  },
  {
    "poem_id": 1464,
    "vorder": 85,
    "position": 0,
    "text": "فرستم به نزدیک شاه جهان"
  },
  {
    "poem_id": 1464,
    "vorder": 86,
    "position": 1,
    "text": "تنت را کنم زیر گل در نهان"
  },
  {
    "poem_id": 1464,
    "vorder": 87,
    "position": 0,
    "text": "بخندید سهراب کاین گفت‌وگوی"
  },
  {
    "poem_id": 1464,
    "vorder": 88,
    "position": 1,
    "text": "به گوش آمدش تیز بنهاد روی"
  },
  {
    "poem_id": 1464,
    "vorder": 89,
    "position": 0,
    "text": "چنان نیزه بر نیزه برساختند"
  },
  {
    "poem_id": 1464,
    "vorder": 90,
    "position": 1,
    "text": "که از یکدگر بازنشناختند"
  },
  {
    "poem_id": 1464,
    "vorder": 91,
    "position": 0,
    "text": "یکی نیزه زد بر میانش هجیر"
  },
  {
    "poem_id": 1464,
    "vorder": 92,
    "position": 1,
    "text": "نیامد سنان اندرو جایگیر"
  },
  {
    "poem_id": 1464,
    "vorder": 93,
    "position": 0,
    "text": "سنان باز پس کرد سهراب شیر"
  },
  {
    "poem_id": 1464,
    "vorder": 94,
    "position": 1,
    "text": "بن نیزه زد بر میان دلیر"
  },
  {
    "poem_id": 1464,
    "vorder": 95,
    "position": 0,
    "text": "ز زین برگرفتش به کردار باد"
  },
  {
    "poem_id": 1464,
    "vorder": 96,
    "position": 1,
    "text": "نیامد همی زو بدلش ایچ یاد"
  },
  {
    "poem_id": 1464,
    "vorder": 97,
    "position": 0,
    "text": "ز اسپ اندر آمد نشست از برش"
  },
  {
    "poem_id": 1464,
    "vorder": 98,
    "position": 1,
    "text": "همی خواست از تن بریدن سرش"
  },
  {
    "poem_id": 1464,
    "vorder": 99,
    "position": 0,
    "text": "بپیچید و برگشت بر دست راست"
  },
  {
    "poem_id": 1464,
    "vorder": 100,
    "position": 1,
    "text": "غمی شد ز سهراب و زنهار خواست"
  },
  {
    "poem_id": 1464,
    "vorder": 101,
    "position": 0,
    "text": "رها کرد ازو چنگ و زنهار داد"
  },
  {
    "poem_id": 1464,
    "vorder": 102,
    "position": 1,
    "text": "چو خشنود شد پند بسیار داد"
  },
  {
    "poem_id": 1464,
    "vorder": 103,
    "position": 0,
    "text": "ببستش ببند آنگهی رزمجوی"
  },
  {
    "poem_id": 1464,
    "vorder": 104,
    "position": 1,
    "text": "به نزدیک هومان فرستاد اوی"
  },
  {
    "poem_id": 1464,
    "vorder": 105,
    "position": 0,
    "text": "به دژ در چو آگه شدند از هجیر"
  },
  {
    "poem_id": 1464,
    "vorder": 106,
    "position": 1,
    "text": "که او را گرفتند و بردند اسیر"
  },
  {
    "poem_id": 1464,
    "vorder": 107,
    "position": 0,
    "text": "خروش آمد و نالهٔ مرد و زن"
  },
  {
    "poem_id": 1464,
    "vorder": 108,
    "position": 1,
    "text": "که کم شد هجیر اندر آن انجمن"
  }
]