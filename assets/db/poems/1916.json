[
  {
    "poem_id": 1916,
    "vorder": 1,
    "position": 0,
    "text": "هر آنکس که بد کرد با شهریار"
  },
  {
    "poem_id": 1916,
    "vorder": 2,
    "position": 1,
    "text": "شب و روز ترسان بد از روزگار"
  },
  {
    "poem_id": 1916,
    "vorder": 3,
    "position": 0,
    "text": "چو شیروی ترسنده و خام بود"
  },
  {
    "poem_id": 1916,
    "vorder": 4,
    "position": 1,
    "text": "همان تخت پیش اندرش دام بود"
  },
  {
    "poem_id": 1916,
    "vorder": 5,
    "position": 0,
    "text": "بدانست اختر شمر هرک دید"
  },
  {
    "poem_id": 1916,
    "vorder": 6,
    "position": 1,
    "text": "که روز بزرگان نخواهد رسید"
  },
  {
    "poem_id": 1916,
    "vorder": 7,
    "position": 0,
    "text": "برفتند هرکس که بد کرده بود"
  },
  {
    "poem_id": 1916,
    "vorder": 8,
    "position": 1,
    "text": "بدان کار تاب اندر آورده بود"
  },
  {
    "poem_id": 1916,
    "vorder": 9,
    "position": 0,
    "text": "ز درگاه یکسر به نزد قباد"
  },
  {
    "poem_id": 1916,
    "vorder": 10,
    "position": 1,
    "text": "از آن کار بیداد کردند یاد"
  },
  {
    "poem_id": 1916,
    "vorder": 11,
    "position": 0,
    "text": "که یک بار گفتیم و این دیگرست"
  },
  {
    "poem_id": 1916,
    "vorder": 12,
    "position": 1,
    "text": "تو را خود جزین داوری درسرست"
  },
  {
    "poem_id": 1916,
    "vorder": 13,
    "position": 0,
    "text": "نشسته به یک شهر بی بر دو شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 14,
    "position": 1,
    "text": "یکی گاه دارد یکی زیرگاه"
  },
  {
    "poem_id": 1916,
    "vorder": 15,
    "position": 0,
    "text": "چو خویشی فزاید پدر با پسر"
  },
  {
    "poem_id": 1916,
    "vorder": 16,
    "position": 1,
    "text": "همه بندگان راببرند سر"
  },
  {
    "poem_id": 1916,
    "vorder": 17,
    "position": 0,
    "text": "نییم اندرین کار همداستان"
  },
  {
    "poem_id": 1916,
    "vorder": 18,
    "position": 1,
    "text": "مزن زین سپس پیش ما داستان"
  },
  {
    "poem_id": 1916,
    "vorder": 19,
    "position": 0,
    "text": "بترسید شیروی و ترسنده بود"
  },
  {
    "poem_id": 1916,
    "vorder": 20,
    "position": 1,
    "text": "که در چنگ ایشان یکی بنده بود"
  },
  {
    "poem_id": 1916,
    "vorder": 21,
    "position": 0,
    "text": "چنین داد پاسخ که سرسوی دام"
  },
  {
    "poem_id": 1916,
    "vorder": 22,
    "position": 1,
    "text": "نیارد مگر مردم زشت نام"
  },
  {
    "poem_id": 1916,
    "vorder": 23,
    "position": 0,
    "text": "شما را سوی خانه باید شدن"
  },
  {
    "poem_id": 1916,
    "vorder": 24,
    "position": 1,
    "text": "بران آرزو رای باید زدن"
  },
  {
    "poem_id": 1916,
    "vorder": 25,
    "position": 0,
    "text": "به جویید تا کیست اندر جهان"
  },
  {
    "poem_id": 1916,
    "vorder": 26,
    "position": 1,
    "text": "که این رنج بر ما سرآرد نهان"
  },
  {
    "poem_id": 1916,
    "vorder": 27,
    "position": 0,
    "text": "کشنده همی‌جست بدخواه شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 28,
    "position": 1,
    "text": "بدان تا کنندش نهانی تباه"
  },
  {
    "poem_id": 1916,
    "vorder": 29,
    "position": 0,
    "text": "کس اندر جهان زهرهٔ آن نداشت"
  },
  {
    "poem_id": 1916,
    "vorder": 30,
    "position": 1,
    "text": "زمردی همان بهرهٔ آن نداشت"
  },
  {
    "poem_id": 1916,
    "vorder": 31,
    "position": 0,
    "text": "که خون چنان خسروی ریختی"
  },
  {
    "poem_id": 1916,
    "vorder": 32,
    "position": 1,
    "text": "همی‌کوه در گردن آویختی"
  },
  {
    "poem_id": 1916,
    "vorder": 33,
    "position": 0,
    "text": "ز هر سو همی‌جست بدخواه شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 34,
    "position": 1,
    "text": "چنین تا بدیدند مردی به راه"
  },
  {
    "poem_id": 1916,
    "vorder": 35,
    "position": 0,
    "text": "دو چشمش کبود و در خساره زرد"
  },
  {
    "poem_id": 1916,
    "vorder": 36,
    "position": 1,
    "text": "تنی خشک و پر موی و رخ لاژورد"
  },
  {
    "poem_id": 1916,
    "vorder": 37,
    "position": 0,
    "text": "پر از خاک پای و شکم گرسنه"
  },
  {
    "poem_id": 1916,
    "vorder": 38,
    "position": 1,
    "text": "تن مرد بیدادگر برهنه"
  },
  {
    "poem_id": 1916,
    "vorder": 39,
    "position": 0,
    "text": "ندانست کس نام او در جهان"
  },
  {
    "poem_id": 1916,
    "vorder": 40,
    "position": 1,
    "text": "میان کهان و میان مهان"
  },
  {
    "poem_id": 1916,
    "vorder": 41,
    "position": 0,
    "text": "بر زاد فرخ شد این مرد زشت"
  },
  {
    "poem_id": 1916,
    "vorder": 42,
    "position": 1,
    "text": "که هرگز مبیناد خرم بهشت"
  },
  {
    "poem_id": 1916,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت کاین رزم کارمنست"
  },
  {
    "poem_id": 1916,
    "vorder": 44,
    "position": 1,
    "text": "چو سیرم کنی این شکار منست"
  },
  {
    "poem_id": 1916,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت روگر توانی بکن"
  },
  {
    "poem_id": 1916,
    "vorder": 46,
    "position": 1,
    "text": "وزین بیش مگشای لب بر سخن"
  },
  {
    "poem_id": 1916,
    "vorder": 47,
    "position": 0,
    "text": "یکی کیسه دینار دادم تو را"
  },
  {
    "poem_id": 1916,
    "vorder": 48,
    "position": 1,
    "text": "چو فرزند او یار دادم تو را"
  },
  {
    "poem_id": 1916,
    "vorder": 49,
    "position": 0,
    "text": "یکی خنجری تیز دادش چوآب"
  },
  {
    "poem_id": 1916,
    "vorder": 50,
    "position": 1,
    "text": "بیامد کشنده سبک پرشتاب"
  },
  {
    "poem_id": 1916,
    "vorder": 51,
    "position": 0,
    "text": "چو آن بدکنش رفت نزدیک شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 52,
    "position": 1,
    "text": "ورا دیده پابند در پیش گاه"
  },
  {
    "poem_id": 1916,
    "vorder": 53,
    "position": 0,
    "text": "بلرزید خسرو چو او را بدید"
  },
  {
    "poem_id": 1916,
    "vorder": 54,
    "position": 1,
    "text": "سرشکش ز مژگان به رخ برچکید"
  },
  {
    "poem_id": 1916,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت کای زشت نام تو چیست"
  },
  {
    "poem_id": 1916,
    "vorder": 56,
    "position": 1,
    "text": "که زاینده را بر تو باید گریست"
  },
  {
    "poem_id": 1916,
    "vorder": 57,
    "position": 0,
    "text": "مرا مِهرهرمزد خوانند گفت"
  },
  {
    "poem_id": 1916,
    "vorder": 58,
    "position": 1,
    "text": "غریبم بدین شهر بی‌یار و جفت"
  },
  {
    "poem_id": 1916,
    "vorder": 59,
    "position": 0,
    "text": "چنین گفت خسرو که آمد زمان"
  },
  {
    "poem_id": 1916,
    "vorder": 60,
    "position": 1,
    "text": "بدست فرومایهٔ بدگمان"
  },
  {
    "poem_id": 1916,
    "vorder": 61,
    "position": 0,
    "text": "به مردم نماند همی‌چهراو"
  },
  {
    "poem_id": 1916,
    "vorder": 62,
    "position": 1,
    "text": "به گیتی نجوید کسی مهر او"
  },
  {
    "poem_id": 1916,
    "vorder": 63,
    "position": 0,
    "text": "یکی ریدکی پیش او بد بپای"
  },
  {
    "poem_id": 1916,
    "vorder": 64,
    "position": 1,
    "text": "بریدک چنین گفت کای رهنمای"
  },
  {
    "poem_id": 1916,
    "vorder": 65,
    "position": 0,
    "text": "بروتشت آب آر و مشک و عبیر"
  },
  {
    "poem_id": 1916,
    "vorder": 66,
    "position": 1,
    "text": "یکی پاک ترجامهٔ دلپذیر"
  },
  {
    "poem_id": 1916,
    "vorder": 67,
    "position": 0,
    "text": "پرستنده بشنید آواز اوی"
  },
  {
    "poem_id": 1916,
    "vorder": 68,
    "position": 1,
    "text": "ندانست کودک همی راز اوی"
  },
  {
    "poem_id": 1916,
    "vorder": 69,
    "position": 0,
    "text": "ز پیشش بیامد پرستار خرد"
  },
  {
    "poem_id": 1916,
    "vorder": 70,
    "position": 1,
    "text": "یکی تشت زرین بر شاه برد"
  },
  {
    "poem_id": 1916,
    "vorder": 71,
    "position": 0,
    "text": "ابا جامه و آبدستان وآب"
  },
  {
    "poem_id": 1916,
    "vorder": 72,
    "position": 1,
    "text": "همی‌کرد خسرو ببردن شتاب"
  },
  {
    "poem_id": 1916,
    "vorder": 73,
    "position": 0,
    "text": "چو برسم بدید اندر آمد بواژ"
  },
  {
    "poem_id": 1916,
    "vorder": 74,
    "position": 1,
    "text": "نه گاه سخن بود و گفتار ژاژ"
  },
  {
    "poem_id": 1916,
    "vorder": 75,
    "position": 0,
    "text": "چو آن جامه‌ها را بپوشید شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 76,
    "position": 1,
    "text": "به زمزم همی توبه کرد از گناه"
  },
  {
    "poem_id": 1916,
    "vorder": 77,
    "position": 0,
    "text": "یکی چادر نو به سر در کشید"
  },
  {
    "poem_id": 1916,
    "vorder": 78,
    "position": 1,
    "text": "بدان تا رخ جان ستان راندید"
  },
  {
    "poem_id": 1916,
    "vorder": 79,
    "position": 0,
    "text": "بشد مهر هرمزد خنجر بدست"
  },
  {
    "poem_id": 1916,
    "vorder": 80,
    "position": 1,
    "text": "در خانهٔ پادشا راببست"
  },
  {
    "poem_id": 1916,
    "vorder": 81,
    "position": 0,
    "text": "سبک رفت و جامه ازو در کشید"
  },
  {
    "poem_id": 1916,
    "vorder": 82,
    "position": 1,
    "text": "جگرگاه شاه جهان بر درید"
  },
  {
    "poem_id": 1916,
    "vorder": 83,
    "position": 0,
    "text": "بپیچید و بر زد یکی سرد باد"
  },
  {
    "poem_id": 1916,
    "vorder": 84,
    "position": 1,
    "text": "به زاری بران جامه بر جان بداد"
  },
  {
    "poem_id": 1916,
    "vorder": 85,
    "position": 0,
    "text": "برین گونه گردد جهان جهان"
  },
  {
    "poem_id": 1916,
    "vorder": 86,
    "position": 1,
    "text": "همی راز خویش از تو دارد نهان"
  },
  {
    "poem_id": 1916,
    "vorder": 87,
    "position": 0,
    "text": "سخن سنج بی‌رنج گر مرد لاف"
  },
  {
    "poem_id": 1916,
    "vorder": 88,
    "position": 1,
    "text": "نبیند ز کردار او جز گزاف"
  },
  {
    "poem_id": 1916,
    "vorder": 89,
    "position": 0,
    "text": "اگر گنج داری و گر گُرم و رنج"
  },
  {
    "poem_id": 1916,
    "vorder": 90,
    "position": 1,
    "text": "نمانی همی در سرای سپنج"
  },
  {
    "poem_id": 1916,
    "vorder": 91,
    "position": 0,
    "text": "بی‌آزاری و راستی برگزین"
  },
  {
    "poem_id": 1916,
    "vorder": 92,
    "position": 1,
    "text": "چو خواهی که یابی به داد آفرین"
  },
  {
    "poem_id": 1916,
    "vorder": 93,
    "position": 0,
    "text": "چو آگاهی آمد به بازار و راه"
  },
  {
    "poem_id": 1916,
    "vorder": 94,
    "position": 1,
    "text": "که خسرو بران گونه برشد تباه"
  },
  {
    "poem_id": 1916,
    "vorder": 95,
    "position": 0,
    "text": "همه بدگمانان به زندان شدند"
  },
  {
    "poem_id": 1916,
    "vorder": 96,
    "position": 1,
    "text": "به ایوان آن مستمندان شدند"
  },
  {
    "poem_id": 1916,
    "vorder": 97,
    "position": 0,
    "text": "گرامی ده و پنج فرزند بود"
  },
  {
    "poem_id": 1916,
    "vorder": 98,
    "position": 1,
    "text": "به ایوان شاه آنک دربند بود"
  },
  {
    "poem_id": 1916,
    "vorder": 99,
    "position": 0,
    "text": "به زندان بکشتندشان بی‌گناه"
  },
  {
    "poem_id": 1916,
    "vorder": 100,
    "position": 1,
    "text": "بدانگه که برگشته شد بخت شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 101,
    "position": 0,
    "text": "جهاندار چیزی نیارست گفت"
  },
  {
    "poem_id": 1916,
    "vorder": 102,
    "position": 1,
    "text": "همی‌داشت آن انده اندر نهفت"
  },
  {
    "poem_id": 1916,
    "vorder": 103,
    "position": 0,
    "text": "چو بشنید شیرویه چندی گریست"
  },
  {
    "poem_id": 1916,
    "vorder": 104,
    "position": 1,
    "text": "از آن پس نگهبان فرستاد بیست"
  },
  {
    "poem_id": 1916,
    "vorder": 105,
    "position": 0,
    "text": "بدان تا زن و کودکانشان نگاه"
  },
  {
    "poem_id": 1916,
    "vorder": 106,
    "position": 1,
    "text": "بدارد پس از مرگ آن کشته شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 107,
    "position": 0,
    "text": "شد آن پادشاهی و چندان سپاه"
  },
  {
    "poem_id": 1916,
    "vorder": 108,
    "position": 1,
    "text": "بزرگی و مردی و آن دستگاه"
  },
  {
    "poem_id": 1916,
    "vorder": 109,
    "position": 0,
    "text": "که کس را ز شاهنشهان آن نبود"
  },
  {
    "poem_id": 1916,
    "vorder": 110,
    "position": 1,
    "text": "نه از نامداران پیشین شنود"
  },
  {
    "poem_id": 1916,
    "vorder": 111,
    "position": 0,
    "text": "یکی گشت با آنک نانی فراخ"
  },
  {
    "poem_id": 1916,
    "vorder": 112,
    "position": 1,
    "text": "نیابد نبیند برو بوم و کاخ"
  },
  {
    "poem_id": 1916,
    "vorder": 113,
    "position": 0,
    "text": "خردمند گوید نیارد بها"
  },
  {
    "poem_id": 1916,
    "vorder": 114,
    "position": 1,
    "text": "هر آنکس که ایمن شد از اژدها"
  },
  {
    "poem_id": 1916,
    "vorder": 115,
    "position": 0,
    "text": "جهان رامخوان جز دلاور نهنگ"
  },
  {
    "poem_id": 1916,
    "vorder": 116,
    "position": 1,
    "text": "بخاید به دندان چو گیرد به چنگ"
  },
  {
    "poem_id": 1916,
    "vorder": 117,
    "position": 0,
    "text": "سرآمد کنون کار پرویز شاه"
  },
  {
    "poem_id": 1916,
    "vorder": 118,
    "position": 1,
    "text": "شد آن نامور تخت و گنج و سپاه"
  }
]