[
  {
    "poem_id": 1764,
    "vorder": 1,
    "position": 0,
    "text": "چو ایرانیان آگهی یافتند"
  },
  {
    "poem_id": 1764,
    "vorder": 2,
    "position": 1,
    "text": "یکایک سوی چاره بشتافتند"
  },
  {
    "poem_id": 1764,
    "vorder": 3,
    "position": 0,
    "text": "چو گشتند زان رنج یکسر ستوه"
  },
  {
    "poem_id": 1764,
    "vorder": 4,
    "position": 1,
    "text": "نشستند یک با دگر همگروه"
  },
  {
    "poem_id": 1764,
    "vorder": 5,
    "position": 0,
    "text": "که این کار ز اندازه اندر گذشت"
  },
  {
    "poem_id": 1764,
    "vorder": 6,
    "position": 1,
    "text": "ز روم و ز هند و سواران دشت"
  },
  {
    "poem_id": 1764,
    "vorder": 7,
    "position": 0,
    "text": "یکی چاره باید کنون ساختن"
  },
  {
    "poem_id": 1764,
    "vorder": 8,
    "position": 1,
    "text": "دل و جان ازین کار پرداختن"
  },
  {
    "poem_id": 1764,
    "vorder": 9,
    "position": 0,
    "text": "بجستند موبد فرستاده‌ای"
  },
  {
    "poem_id": 1764,
    "vorder": 10,
    "position": 1,
    "text": "سخن‌گوی و بینادل آزاده‌ای"
  },
  {
    "poem_id": 1764,
    "vorder": 11,
    "position": 0,
    "text": "کجا نام آن گو جوانوی بود"
  },
  {
    "poem_id": 1764,
    "vorder": 12,
    "position": 1,
    "text": "دبیری بزرگ و سخن‌گوی بود"
  },
  {
    "poem_id": 1764,
    "vorder": 13,
    "position": 0,
    "text": "بدان تا به نزدیک منذر شود"
  },
  {
    "poem_id": 1764,
    "vorder": 14,
    "position": 1,
    "text": "سخن گوید و گفت او بشنود"
  },
  {
    "poem_id": 1764,
    "vorder": 15,
    "position": 0,
    "text": "به منذر بگوید که ای سرفراز"
  },
  {
    "poem_id": 1764,
    "vorder": 16,
    "position": 1,
    "text": "جهان را به نام تو بادا نیاز"
  },
  {
    "poem_id": 1764,
    "vorder": 17,
    "position": 0,
    "text": "نگهدار ایران نیران توی"
  },
  {
    "poem_id": 1764,
    "vorder": 18,
    "position": 1,
    "text": "به هر جای پشت دلیران توی"
  },
  {
    "poem_id": 1764,
    "vorder": 19,
    "position": 0,
    "text": "چو این تخت بی‌شاه و بی‌تاج شد"
  },
  {
    "poem_id": 1764,
    "vorder": 20,
    "position": 1,
    "text": "ز خون مرز چون پر دراج شد"
  },
  {
    "poem_id": 1764,
    "vorder": 21,
    "position": 0,
    "text": "تو گفتیم باشی خداوند مرز"
  },
  {
    "poem_id": 1764,
    "vorder": 22,
    "position": 1,
    "text": "که این مرز را از تو دیدیم ارز"
  },
  {
    "poem_id": 1764,
    "vorder": 23,
    "position": 0,
    "text": "کنون غارت از تست و خون ریختن"
  },
  {
    "poem_id": 1764,
    "vorder": 24,
    "position": 1,
    "text": "به هر جای تاراج و آویختن"
  },
  {
    "poem_id": 1764,
    "vorder": 25,
    "position": 0,
    "text": "نبودی ازین پیش تو بدکنش"
  },
  {
    "poem_id": 1764,
    "vorder": 26,
    "position": 1,
    "text": "ز نفرین بترسیدی و سرزنش"
  },
  {
    "poem_id": 1764,
    "vorder": 27,
    "position": 0,
    "text": "نگه کن بدین تا پسند آیدت"
  },
  {
    "poem_id": 1764,
    "vorder": 28,
    "position": 1,
    "text": "به پیران سر این سودمند آیدت"
  },
  {
    "poem_id": 1764,
    "vorder": 29,
    "position": 0,
    "text": "جز از تو زبر داوری دیگرست"
  },
  {
    "poem_id": 1764,
    "vorder": 30,
    "position": 1,
    "text": "کز اندیشهٔ برتران برترست"
  },
  {
    "poem_id": 1764,
    "vorder": 31,
    "position": 0,
    "text": "بگوید فرستاده چیزی که دید"
  },
  {
    "poem_id": 1764,
    "vorder": 32,
    "position": 1,
    "text": "سخن نیز کز کاردانان شنید"
  },
  {
    "poem_id": 1764,
    "vorder": 33,
    "position": 0,
    "text": "جوانوی دانا ز پیش سران"
  },
  {
    "poem_id": 1764,
    "vorder": 34,
    "position": 1,
    "text": "بیامد سوی دشت نیزه‌وران"
  },
  {
    "poem_id": 1764,
    "vorder": 35,
    "position": 0,
    "text": "به منذر سخن گفت و نامه بداد"
  },
  {
    "poem_id": 1764,
    "vorder": 36,
    "position": 1,
    "text": "سخنهای ایرانیان کرد یاد"
  },
  {
    "poem_id": 1764,
    "vorder": 37,
    "position": 0,
    "text": "سخنهایش بشنید شاه عرب"
  },
  {
    "poem_id": 1764,
    "vorder": 38,
    "position": 1,
    "text": "به پاسخ برو هیچ نگشاد لب"
  },
  {
    "poem_id": 1764,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت کای دانشی چاره‌جوی"
  },
  {
    "poem_id": 1764,
    "vorder": 40,
    "position": 1,
    "text": "سخن زین نشان با شهنشاه گوی"
  },
  {
    "poem_id": 1764,
    "vorder": 41,
    "position": 0,
    "text": "بگوی این که گفتی به بهرامشاه"
  },
  {
    "poem_id": 1764,
    "vorder": 42,
    "position": 1,
    "text": "چو پاسخ بجویی نمایدت راه"
  },
  {
    "poem_id": 1764,
    "vorder": 43,
    "position": 0,
    "text": "فرستاد با او یکی نامدار"
  },
  {
    "poem_id": 1764,
    "vorder": 44,
    "position": 1,
    "text": "جوانوی شد تا در شهریار"
  },
  {
    "poem_id": 1764,
    "vorder": 45,
    "position": 0,
    "text": "چو بهرام را دید داننده مرد"
  },
  {
    "poem_id": 1764,
    "vorder": 46,
    "position": 1,
    "text": "برو آفریننده را یاد کرد"
  },
  {
    "poem_id": 1764,
    "vorder": 47,
    "position": 0,
    "text": "ازان برز و بالا و آن یال و کفت"
  },
  {
    "poem_id": 1764,
    "vorder": 48,
    "position": 1,
    "text": "فروماند بینادل اندر شگفت"
  },
  {
    "poem_id": 1764,
    "vorder": 49,
    "position": 0,
    "text": "همی می چکد گویی از روی اوی"
  },
  {
    "poem_id": 1764,
    "vorder": 50,
    "position": 1,
    "text": "همی بوی مشک آید از موی اوی"
  },
  {
    "poem_id": 1764,
    "vorder": 51,
    "position": 0,
    "text": "سخن‌گوی بی‌فر و بی‌هوش گشت"
  },
  {
    "poem_id": 1764,
    "vorder": 52,
    "position": 1,
    "text": "پیامش سراسر فراموش گشت"
  },
  {
    "poem_id": 1764,
    "vorder": 53,
    "position": 0,
    "text": "بدانست بهرام کو خیره شد"
  },
  {
    "poem_id": 1764,
    "vorder": 54,
    "position": 1,
    "text": "ز دیدار چشم و دلش تیره شد"
  },
  {
    "poem_id": 1764,
    "vorder": 55,
    "position": 0,
    "text": "بپرسید بسیار و بنواختش"
  },
  {
    "poem_id": 1764,
    "vorder": 56,
    "position": 1,
    "text": "به خوبی بر تخت بنشاختش"
  },
  {
    "poem_id": 1764,
    "vorder": 57,
    "position": 0,
    "text": "چو گستاخ شد زو بپرسید شاه"
  },
  {
    "poem_id": 1764,
    "vorder": 58,
    "position": 1,
    "text": "کز ایران چرا رنجه گشتی به راه"
  },
  {
    "poem_id": 1764,
    "vorder": 59,
    "position": 0,
    "text": "فرستاد با او یکی پرخرد"
  },
  {
    "poem_id": 1764,
    "vorder": 60,
    "position": 1,
    "text": "که او را به نزدیک منذر برد"
  },
  {
    "poem_id": 1764,
    "vorder": 61,
    "position": 0,
    "text": "بگوید که آن نامه پاسخ نویس"
  },
  {
    "poem_id": 1764,
    "vorder": 62,
    "position": 1,
    "text": "به پاسخ سخنهای فرخ نویس"
  },
  {
    "poem_id": 1764,
    "vorder": 63,
    "position": 0,
    "text": "وزان پس نگر تا چه دارد پیام"
  },
  {
    "poem_id": 1764,
    "vorder": 64,
    "position": 1,
    "text": "ازو بشنود پاسخ او تمام"
  },
  {
    "poem_id": 1764,
    "vorder": 65,
    "position": 0,
    "text": "بیامد جوانو سخنها بگفت"
  },
  {
    "poem_id": 1764,
    "vorder": 66,
    "position": 1,
    "text": "رخ منذر از رای او برشکفت"
  },
  {
    "poem_id": 1764,
    "vorder": 67,
    "position": 0,
    "text": "چو بشنید زان مرد بنا سخن"
  },
  {
    "poem_id": 1764,
    "vorder": 68,
    "position": 1,
    "text": "مر آن نامه را پاسخ افگند بن"
  },
  {
    "poem_id": 1764,
    "vorder": 69,
    "position": 0,
    "text": "جوانوی را گفت کای پرخرد"
  },
  {
    "poem_id": 1764,
    "vorder": 70,
    "position": 1,
    "text": "هرانکس که بد کرد کیفر برد"
  },
  {
    "poem_id": 1764,
    "vorder": 71,
    "position": 0,
    "text": "شنیدم همه هرچ دادی پیام"
  },
  {
    "poem_id": 1764,
    "vorder": 72,
    "position": 1,
    "text": "وزان نامداران که کردی سلام"
  },
  {
    "poem_id": 1764,
    "vorder": 73,
    "position": 0,
    "text": "چنین گوی کاین بد که کرد از نخست"
  },
  {
    "poem_id": 1764,
    "vorder": 74,
    "position": 1,
    "text": "که بیهوده پیکار بایست جست"
  },
  {
    "poem_id": 1764,
    "vorder": 75,
    "position": 0,
    "text": "شهنشاه بهرام گور ایدرست"
  },
  {
    "poem_id": 1764,
    "vorder": 76,
    "position": 1,
    "text": "که با فر و برزست و با لشکرست"
  },
  {
    "poem_id": 1764,
    "vorder": 77,
    "position": 0,
    "text": "ز سوراخ چون مار بیرون کشید"
  },
  {
    "poem_id": 1764,
    "vorder": 78,
    "position": 1,
    "text": "همی دامن خویش در خون کشید"
  },
  {
    "poem_id": 1764,
    "vorder": 79,
    "position": 0,
    "text": "گر ایدونک من بودمی رای زن"
  },
  {
    "poem_id": 1764,
    "vorder": 80,
    "position": 1,
    "text": "به ایرانیان بر نبودی شکن"
  },
  {
    "poem_id": 1764,
    "vorder": 81,
    "position": 0,
    "text": "جوانوی روی شهنشاه دید"
  },
  {
    "poem_id": 1764,
    "vorder": 82,
    "position": 1,
    "text": "وزو نیز چندی سخنها شنید"
  },
  {
    "poem_id": 1764,
    "vorder": 83,
    "position": 0,
    "text": "بپرسید تا شاید او تخت را"
  },
  {
    "poem_id": 1764,
    "vorder": 84,
    "position": 1,
    "text": "بزرگی و پیروزی و بخت را"
  },
  {
    "poem_id": 1764,
    "vorder": 85,
    "position": 0,
    "text": "ز منذر چو بشنید زان‌سان سخن"
  },
  {
    "poem_id": 1764,
    "vorder": 86,
    "position": 1,
    "text": "یکی روشن اندیشه افگند بن"
  },
  {
    "poem_id": 1764,
    "vorder": 87,
    "position": 0,
    "text": "چنین داد پاسخ که ای سرفراز"
  },
  {
    "poem_id": 1764,
    "vorder": 88,
    "position": 1,
    "text": "به دانایی از هرکسی بی‌نیاز"
  },
  {
    "poem_id": 1764,
    "vorder": 89,
    "position": 0,
    "text": "از ایرانیان گر خرد گشته شد"
  },
  {
    "poem_id": 1764,
    "vorder": 90,
    "position": 1,
    "text": "فراوان از آزادگان کشته شد"
  },
  {
    "poem_id": 1764,
    "vorder": 91,
    "position": 0,
    "text": "کنون من یکی نامجویم کهن"
  },
  {
    "poem_id": 1764,
    "vorder": 92,
    "position": 1,
    "text": "اگر بشنوی تا بگویم سخن"
  },
  {
    "poem_id": 1764,
    "vorder": 93,
    "position": 0,
    "text": "ترا با شهنشاه بهرام گور"
  },
  {
    "poem_id": 1764,
    "vorder": 94,
    "position": 1,
    "text": "خرامید باید ابی جنگ و شور"
  },
  {
    "poem_id": 1764,
    "vorder": 95,
    "position": 0,
    "text": "به ایران زمین در ابا یوز و باز"
  },
  {
    "poem_id": 1764,
    "vorder": 96,
    "position": 1,
    "text": "چنانچون بود شاه گردن‌فراز"
  },
  {
    "poem_id": 1764,
    "vorder": 97,
    "position": 0,
    "text": "شنیدن سخنهای ایرانیان"
  },
  {
    "poem_id": 1764,
    "vorder": 98,
    "position": 1,
    "text": "همانا ز جنبش نباید زیان"
  },
  {
    "poem_id": 1764,
    "vorder": 99,
    "position": 0,
    "text": "بگویی تو نیز آنچ اندرخورد"
  },
  {
    "poem_id": 1764,
    "vorder": 100,
    "position": 1,
    "text": "خردمندی و دوری از بی‌خرد"
  },
  {
    "poem_id": 1764,
    "vorder": 101,
    "position": 0,
    "text": "ز رای بدان دور داری منش"
  },
  {
    "poem_id": 1764,
    "vorder": 102,
    "position": 1,
    "text": "بپیچی ز بیغاره و سرزنش"
  },
  {
    "poem_id": 1764,
    "vorder": 103,
    "position": 0,
    "text": "چو بشنید منذر ورا هدیه داد"
  },
  {
    "poem_id": 1764,
    "vorder": 104,
    "position": 1,
    "text": "کسی کردش از شهر آباد شاد"
  }
]