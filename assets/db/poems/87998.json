[
  {
    "poem_id": 87998,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه شد بدان انجمن"
  },
  {
    "poem_id": 87998,
    "vorder": 2,
    "position": 1,
    "text": "بجایی که بد سایهٔ پیلتن"
  },
  {
    "poem_id": 87998,
    "vorder": 3,
    "position": 0,
    "text": "فرود آمد و آفرین کرد چند"
  },
  {
    "poem_id": 87998,
    "vorder": 4,
    "position": 1,
    "text": "که زور از تو گیرد سپهر بلند"
  },
  {
    "poem_id": 87998,
    "vorder": 5,
    "position": 0,
    "text": "مبادا که روز تو گیرد نشیب"
  },
  {
    "poem_id": 87998,
    "vorder": 6,
    "position": 1,
    "text": "مبادا که آید برویت نهیب"
  },
  {
    "poem_id": 87998,
    "vorder": 7,
    "position": 0,
    "text": "دل شاه ایران بتو شاد باد"
  },
  {
    "poem_id": 87998,
    "vorder": 8,
    "position": 1,
    "text": "همه کار تو سربسر داد باد"
  },
  {
    "poem_id": 87998,
    "vorder": 9,
    "position": 0,
    "text": "برفتم ز نزد تو ای پهلوان"
  },
  {
    "poem_id": 87998,
    "vorder": 10,
    "position": 1,
    "text": "پیامت بدادم بپیر و جوان"
  },
  {
    "poem_id": 87998,
    "vorder": 11,
    "position": 0,
    "text": "بگفتم هنرهای تو هرچ بود"
  },
  {
    "poem_id": 87998,
    "vorder": 12,
    "position": 1,
    "text": "بگیتی ترا خود که یارد ستود"
  },
  {
    "poem_id": 87998,
    "vorder": 13,
    "position": 0,
    "text": "هم از آشتی راندم هم ز جنگ"
  },
  {
    "poem_id": 87998,
    "vorder": 14,
    "position": 1,
    "text": "سخن گفتم از هر دری بی‌درنگ"
  },
  {
    "poem_id": 87998,
    "vorder": 15,
    "position": 0,
    "text": "بفرجام گفتند کین چون کنیم"
  },
  {
    "poem_id": 87998,
    "vorder": 16,
    "position": 1,
    "text": "که از رای او کینه بیرون کنیم"
  },
  {
    "poem_id": 87998,
    "vorder": 17,
    "position": 0,
    "text": "توان داد گنج و زر و خواسته"
  },
  {
    "poem_id": 87998,
    "vorder": 18,
    "position": 1,
    "text": "ز ما هر چه او خواهد آراسته"
  },
  {
    "poem_id": 87998,
    "vorder": 19,
    "position": 0,
    "text": "نشاید گنهکار دادن بدوی"
  },
  {
    "poem_id": 87998,
    "vorder": 20,
    "position": 1,
    "text": "براندیش و این رازها بازجوی"
  },
  {
    "poem_id": 87998,
    "vorder": 21,
    "position": 0,
    "text": "گنهکار جز خویش افراسیاب"
  },
  {
    "poem_id": 87998,
    "vorder": 22,
    "position": 1,
    "text": "که دانی سخن را مزن در شتاب"
  },
  {
    "poem_id": 87998,
    "vorder": 23,
    "position": 0,
    "text": "ز ما هرک خواهد همه مهترند"
  },
  {
    "poem_id": 87998,
    "vorder": 24,
    "position": 1,
    "text": "بزرگند و با تخت و با افسرند"
  },
  {
    "poem_id": 87998,
    "vorder": 25,
    "position": 0,
    "text": "سپاهی بیامد بدین سان ز چین"
  },
  {
    "poem_id": 87998,
    "vorder": 26,
    "position": 1,
    "text": "ز سقلاب و ختلان و توران زمین"
  },
  {
    "poem_id": 87998,
    "vorder": 27,
    "position": 0,
    "text": "کجا آشتی خواهد افراسیاب"
  },
  {
    "poem_id": 87998,
    "vorder": 28,
    "position": 1,
    "text": "که چندین سپاه آمد از خشک و آب"
  },
  {
    "poem_id": 87998,
    "vorder": 29,
    "position": 0,
    "text": "بپاسخ نکوهش بسی یافتم"
  },
  {
    "poem_id": 87998,
    "vorder": 30,
    "position": 1,
    "text": "بدین سان سوی پهلوان تافتم"
  },
  {
    "poem_id": 87998,
    "vorder": 31,
    "position": 0,
    "text": "وزیشان سپاهی چو دریای آب"
  },
  {
    "poem_id": 87998,
    "vorder": 32,
    "position": 1,
    "text": "گرفتند بر جنگ جستن شتاب"
  },
  {
    "poem_id": 87998,
    "vorder": 33,
    "position": 0,
    "text": "نبرد تو خواهد همی شاه هند"
  },
  {
    "poem_id": 87998,
    "vorder": 34,
    "position": 1,
    "text": "بتیر و کمان و بهندی پرند"
  },
  {
    "poem_id": 87998,
    "vorder": 35,
    "position": 0,
    "text": "مرا این درستست کز پیلتن"
  },
  {
    "poem_id": 87998,
    "vorder": 36,
    "position": 1,
    "text": "بفرجام گریان شوند انجمن"
  },
  {
    "poem_id": 87998,
    "vorder": 37,
    "position": 0,
    "text": "چو بشنید رستم برآشفت سخت"
  },
  {
    "poem_id": 87998,
    "vorder": 38,
    "position": 1,
    "text": "بپیران چنین گفت کای شوربخت"
  },
  {
    "poem_id": 87998,
    "vorder": 39,
    "position": 0,
    "text": "تو با این چنین بند و چندین فریب"
  },
  {
    "poem_id": 87998,
    "vorder": 40,
    "position": 1,
    "text": "کجا پای داری بروز نهیب"
  },
  {
    "poem_id": 87998,
    "vorder": 41,
    "position": 0,
    "text": "مرا از دروغ تو شاه جهان"
  },
  {
    "poem_id": 87998,
    "vorder": 42,
    "position": 1,
    "text": "بسی یاد کرد آشکار و نهان"
  },
  {
    "poem_id": 87998,
    "vorder": 43,
    "position": 0,
    "text": "وزان پس کجا پیر گودرز گفت"
  },
  {
    "poem_id": 87998,
    "vorder": 44,
    "position": 1,
    "text": "همه بند و نیرنگت اندر نهفت"
  },
  {
    "poem_id": 87998,
    "vorder": 45,
    "position": 0,
    "text": "بدیدم کنون دانش و رای تو"
  },
  {
    "poem_id": 87998,
    "vorder": 46,
    "position": 1,
    "text": "دروغست یکسر سراپای تو"
  },
  {
    "poem_id": 87998,
    "vorder": 47,
    "position": 0,
    "text": "بغلتی همی خیره در خون خویش"
  },
  {
    "poem_id": 87998,
    "vorder": 48,
    "position": 1,
    "text": "بدست این و زین بدتر آیدت پیش"
  },
  {
    "poem_id": 87998,
    "vorder": 49,
    "position": 0,
    "text": "چنین زندگانی نیارد بها"
  },
  {
    "poem_id": 87998,
    "vorder": 50,
    "position": 1,
    "text": "که باشد سر اندر دم اژدها"
  },
  {
    "poem_id": 87998,
    "vorder": 51,
    "position": 0,
    "text": "مگر گفتم آن خاک بیداد و شوم"
  },
  {
    "poem_id": 87998,
    "vorder": 52,
    "position": 1,
    "text": "گذاری بیایی به آباد بوم"
  },
  {
    "poem_id": 87998,
    "vorder": 53,
    "position": 0,
    "text": "ببینی مگر شاه با داد و مهر"
  },
  {
    "poem_id": 87998,
    "vorder": 54,
    "position": 1,
    "text": "جوان و نوازنده و خوب‌چهر"
  },
  {
    "poem_id": 87998,
    "vorder": 55,
    "position": 0,
    "text": "بدارد ترا چون پدر بی‌گمان"
  },
  {
    "poem_id": 87998,
    "vorder": 56,
    "position": 1,
    "text": "برآرد سرت برتر از آسمان"
  },
  {
    "poem_id": 87998,
    "vorder": 57,
    "position": 0,
    "text": "ترا پوشش از خود و چرم پلنگ"
  },
  {
    "poem_id": 87998,
    "vorder": 58,
    "position": 1,
    "text": "همی خوشتر آید ز دیبای رنگ"
  },
  {
    "poem_id": 87998,
    "vorder": 59,
    "position": 0,
    "text": "ندارد کسی با تو این داوری"
  },
  {
    "poem_id": 87998,
    "vorder": 60,
    "position": 1,
    "text": "ز تخم پراکند خود بر خوری"
  },
  {
    "poem_id": 87998,
    "vorder": 61,
    "position": 0,
    "text": "بدو گفت پیران که ای نیکبخت"
  },
  {
    "poem_id": 87998,
    "vorder": 62,
    "position": 1,
    "text": "برومند و شاداب و زیبا درخت"
  },
  {
    "poem_id": 87998,
    "vorder": 63,
    "position": 0,
    "text": "سخنها که داند جز از تو چنین"
  },
  {
    "poem_id": 87998,
    "vorder": 64,
    "position": 1,
    "text": "که از مهتران بر تو باد آفرین"
  },
  {
    "poem_id": 87998,
    "vorder": 65,
    "position": 0,
    "text": "مرا جان و دل زیر فرمان تست"
  },
  {
    "poem_id": 87998,
    "vorder": 66,
    "position": 1,
    "text": "همیشه روانم گروگان تست"
  },
  {
    "poem_id": 87998,
    "vorder": 67,
    "position": 0,
    "text": "یک امشب زنم رای با خویشتن"
  },
  {
    "poem_id": 87998,
    "vorder": 68,
    "position": 1,
    "text": "بگویم سخن نیز با انجمن"
  },
  {
    "poem_id": 87998,
    "vorder": 69,
    "position": 0,
    "text": "وزانجا بیامد بقلب سیاه"
  },
  {
    "poem_id": 87998,
    "vorder": 70,
    "position": 1,
    "text": "زبان پر دروغ و روان کینه‌خواه"
  },
  {
    "poem_id": 87998,
    "vorder": 71,
    "position": 0,
    "text": "چو برگشت پیران ز هر دو گروه"
  },
  {
    "poem_id": 87998,
    "vorder": 72,
    "position": 1,
    "text": "زمین شد بکردار جوشنده کوه"
  },
  {
    "poem_id": 87998,
    "vorder": 73,
    "position": 0,
    "text": "چنین گفت رستم بایرانیان"
  },
  {
    "poem_id": 87998,
    "vorder": 74,
    "position": 1,
    "text": "که من جنگ را بسته دارم میان"
  },
  {
    "poem_id": 87998,
    "vorder": 75,
    "position": 0,
    "text": "شما یک بیک سر پر از کین کنید"
  },
  {
    "poem_id": 87998,
    "vorder": 76,
    "position": 1,
    "text": "بروهای جنگی پر از چین کنید"
  },
  {
    "poem_id": 87998,
    "vorder": 77,
    "position": 0,
    "text": "که امروز رزمی بزرگست پیش"
  },
  {
    "poem_id": 87998,
    "vorder": 78,
    "position": 1,
    "text": "پدید آید اندازهٔ گرگ و میش"
  },
  {
    "poem_id": 87998,
    "vorder": 79,
    "position": 0,
    "text": "مرا گفته بود آن ستاره‌شناس"
  },
  {
    "poem_id": 87998,
    "vorder": 80,
    "position": 1,
    "text": "ازین روز بودم دل اندر هراس"
  },
  {
    "poem_id": 87998,
    "vorder": 81,
    "position": 0,
    "text": "که رزمی بود در میان دو کوه"
  },
  {
    "poem_id": 87998,
    "vorder": 82,
    "position": 1,
    "text": "جهانی شوند اندر آن همگروه"
  },
  {
    "poem_id": 87998,
    "vorder": 83,
    "position": 0,
    "text": "شوند انجمن کاردیده مهان"
  },
  {
    "poem_id": 87998,
    "vorder": 84,
    "position": 1,
    "text": "بدان جنگ بی‌مرد گردد جهان"
  },
  {
    "poem_id": 87998,
    "vorder": 85,
    "position": 0,
    "text": "پی کین نهان گردد از روی بوم"
  },
  {
    "poem_id": 87998,
    "vorder": 86,
    "position": 1,
    "text": "شود گُرز پولاد برسان موم"
  },
  {
    "poem_id": 87998,
    "vorder": 87,
    "position": 0,
    "text": "هر آنکس که آید بر ما بجنگ"
  },
  {
    "poem_id": 87998,
    "vorder": 88,
    "position": 1,
    "text": "شما دل مدارید از آن کار تنگ"
  },
  {
    "poem_id": 87998,
    "vorder": 89,
    "position": 0,
    "text": "دو دستش ببندم بخم کمند"
  },
  {
    "poem_id": 87998,
    "vorder": 90,
    "position": 1,
    "text": "اگر یار باشد سپهر بلند"
  },
  {
    "poem_id": 87998,
    "vorder": 91,
    "position": 0,
    "text": "شما سربسر یک بیک همگروه"
  },
  {
    "poem_id": 87998,
    "vorder": 92,
    "position": 1,
    "text": "مباشید از آن نامداران ستوه"
  },
  {
    "poem_id": 87998,
    "vorder": 93,
    "position": 0,
    "text": "مرا گر برزم اندر آید زمان"
  },
  {
    "poem_id": 87998,
    "vorder": 94,
    "position": 1,
    "text": "نمیرم ببزم اندرون بی‌گمان"
  },
  {
    "poem_id": 87998,
    "vorder": 95,
    "position": 0,
    "text": "همی نام باید که ماند دراز"
  },
  {
    "poem_id": 87998,
    "vorder": 96,
    "position": 1,
    "text": "نمانی همی کار چندین مساز"
  },
  {
    "poem_id": 87998,
    "vorder": 97,
    "position": 0,
    "text": "دل اندر سرای سپنجی مبند"
  },
  {
    "poem_id": 87998,
    "vorder": 98,
    "position": 1,
    "text": "که پر خون شوی چون ببایدت کند"
  },
  {
    "poem_id": 87998,
    "vorder": 99,
    "position": 0,
    "text": "اگر یار باشد روان با خرد"
  },
  {
    "poem_id": 87998,
    "vorder": 100,
    "position": 1,
    "text": "بنیک و ببد روز را بشمرد"
  },
  {
    "poem_id": 87998,
    "vorder": 101,
    "position": 0,
    "text": "خداوند تاج و خداوند گنج"
  },
  {
    "poem_id": 87998,
    "vorder": 102,
    "position": 1,
    "text": "نبندد دل اندر سرای سپنج"
  },
  {
    "poem_id": 87998,
    "vorder": 103,
    "position": 0,
    "text": "چنین داد پاسخ به رستم سپاه"
  },
  {
    "poem_id": 87998,
    "vorder": 104,
    "position": 1,
    "text": "که فرمان تو برتر از چرخ ماه"
  },
  {
    "poem_id": 87998,
    "vorder": 105,
    "position": 0,
    "text": "چنان رزم سازیم با تیغ تیز"
  },
  {
    "poem_id": 87998,
    "vorder": 106,
    "position": 1,
    "text": "که ماند ز ما نام تا رستخیز"
  },
  {
    "poem_id": 87998,
    "vorder": 107,
    "position": 0,
    "text": "ز دو رویه تنگ اندر آمد سپاه"
  },
  {
    "poem_id": 87998,
    "vorder": 108,
    "position": 1,
    "text": "یکی ابر گفتی برآمد سیاه"
  },
  {
    "poem_id": 87998,
    "vorder": 109,
    "position": 0,
    "text": "که باران او بود شمشیر و تیر"
  },
  {
    "poem_id": 87998,
    "vorder": 110,
    "position": 1,
    "text": "جهان شد بکردار دریای قیر"
  },
  {
    "poem_id": 87998,
    "vorder": 111,
    "position": 0,
    "text": "ز پیکان پولاد و پر عقاب"
  },
  {
    "poem_id": 87998,
    "vorder": 112,
    "position": 1,
    "text": "سیه گشت رخشان رخ آفتاب"
  },
  {
    "poem_id": 87998,
    "vorder": 113,
    "position": 0,
    "text": "سنانهای نیزه بگرد اندرون"
  },
  {
    "poem_id": 87998,
    "vorder": 114,
    "position": 1,
    "text": "ستاره بیالود گفتی بخون"
  },
  {
    "poem_id": 87998,
    "vorder": 115,
    "position": 0,
    "text": "چرنگیدن گُرزهٔ گاوچهر"
  },
  {
    "poem_id": 87998,
    "vorder": 116,
    "position": 1,
    "text": "تو گفتی همی سنگ بارد سپهر"
  },
  {
    "poem_id": 87998,
    "vorder": 117,
    "position": 0,
    "text": "بخون و بمغز اندرون خار و خاک"
  },
  {
    "poem_id": 87998,
    "vorder": 118,
    "position": 1,
    "text": "شده غرق و برگستوان چاک چاک"
  },
  {
    "poem_id": 87998,
    "vorder": 119,
    "position": 0,
    "text": "همه دشت یکسر پر از جوی خون"
  },
  {
    "poem_id": 87998,
    "vorder": 120,
    "position": 1,
    "text": "بهر جای چندی فگنده نگون"
  },
  {
    "poem_id": 87998,
    "vorder": 121,
    "position": 0,
    "text": "چو پیلان فگنده بهم میل میل"
  },
  {
    "poem_id": 87998,
    "vorder": 122,
    "position": 1,
    "text": "به رخ چون زریر و به لب همچو نیل"
  },
  {
    "poem_id": 87998,
    "vorder": 123,
    "position": 0,
    "text": "چنین گفت گودرز با پیر سر"
  },
  {
    "poem_id": 87998,
    "vorder": 124,
    "position": 1,
    "text": "که تا من ببستم بمردی کمر"
  },
  {
    "poem_id": 87998,
    "vorder": 125,
    "position": 0,
    "text": "ندیدم که رزمی بود زین نشان"
  },
  {
    "poem_id": 87998,
    "vorder": 126,
    "position": 1,
    "text": "نه هرگز شنیدم ز گردنکشان"
  },
  {
    "poem_id": 87998,
    "vorder": 127,
    "position": 0,
