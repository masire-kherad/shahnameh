[
  {
    "poem_id": 88060,
    "vorder": 1,
    "position": 0,
    "text": "از آن پس خروش آمد از دیده‌گاه"
  },
  {
    "poem_id": 88060,
    "vorder": 2,
    "position": 1,
    "text": "که گرد سواران برآمد ز راه"
  },
  {
    "poem_id": 88060,
    "vorder": 3,
    "position": 0,
    "text": "سه اسب و دو کشته بر او بسته زار"
  },
  {
    "poem_id": 88060,
    "vorder": 4,
    "position": 1,
    "text": "همی بینم از دور با یک سوار"
  },
  {
    "poem_id": 88060,
    "vorder": 5,
    "position": 0,
    "text": "همه نامداران ایران سپاه"
  },
  {
    "poem_id": 88060,
    "vorder": 6,
    "position": 1,
    "text": "نهادند چشم از شگفتی به راه"
  },
  {
    "poem_id": 88060,
    "vorder": 7,
    "position": 0,
    "text": "که تا کیست از مرز توران زمین"
  },
  {
    "poem_id": 88060,
    "vorder": 8,
    "position": 1,
    "text": "که یارد گذشتن بر این دشت کین"
  },
  {
    "poem_id": 88060,
    "vorder": 9,
    "position": 0,
    "text": "هم اندر زمان بیژن آمد دمان"
  },
  {
    "poem_id": 88060,
    "vorder": 10,
    "position": 1,
    "text": "به بازو به زه بر فگنده کمان"
  },
  {
    "poem_id": 88060,
    "vorder": 11,
    "position": 0,
    "text": "بر اسبان چو لهاک و فرشیدورد"
  },
  {
    "poem_id": 88060,
    "vorder": 12,
    "position": 1,
    "text": "فگنده نگونسار پر خون و گرد"
  },
  {
    "poem_id": 88060,
    "vorder": 13,
    "position": 0,
    "text": "بر اسبی دگر بر پر از درد و غم"
  },
  {
    "poem_id": 88060,
    "vorder": 14,
    "position": 1,
    "text": "به آغوش ترک اندرون گستهم"
  },
  {
    "poem_id": 88060,
    "vorder": 15,
    "position": 0,
    "text": "چو بیژن به نزدیک خسرو رسید"
  },
  {
    "poem_id": 88060,
    "vorder": 16,
    "position": 1,
    "text": "سر تاج و تخت بلندش بدید"
  },
  {
    "poem_id": 88060,
    "vorder": 17,
    "position": 0,
    "text": "ببوسید و بر خاک بنهاد روی"
  },
  {
    "poem_id": 88060,
    "vorder": 18,
    "position": 1,
    "text": "بشد شاد خسرو به دیدار اوی"
  },
  {
    "poem_id": 88060,
    "vorder": 19,
    "position": 0,
    "text": "بپرسید و گفتش که ای شیر مرد"
  },
  {
    "poem_id": 88060,
    "vorder": 20,
    "position": 1,
    "text": "کجا رفته بودی ز دشت نبرد"
  },
  {
    "poem_id": 88060,
    "vorder": 21,
    "position": 0,
    "text": "ز گستهم بیژن سخن یاد کرد"
  },
  {
    "poem_id": 88060,
    "vorder": 22,
    "position": 1,
    "text": "ز لهاک وز گرد فرشیدورد"
  },
  {
    "poem_id": 88060,
    "vorder": 23,
    "position": 0,
    "text": "وز آن خسته و زاری گستهم"
  },
  {
    "poem_id": 88060,
    "vorder": 24,
    "position": 1,
    "text": "ز جنگ سواران و از بیش و کم"
  },
  {
    "poem_id": 88060,
    "vorder": 25,
    "position": 0,
    "text": "کنون آرزو گستهم را یکیست"
  },
  {
    "poem_id": 88060,
    "vorder": 26,
    "position": 1,
    "text": "که آن کار بر شاه دشوار نیست"
  },
  {
    "poem_id": 88060,
    "vorder": 27,
    "position": 0,
    "text": "به دیدار شاه آمدستش هوا"
  },
  {
    "poem_id": 88060,
    "vorder": 28,
    "position": 1,
    "text": "وز آن پس اگر میرد او را روا"
  },
  {
    "poem_id": 88060,
    "vorder": 29,
    "position": 0,
    "text": "بفرمود پس شاه آزرم جوی"
  },
  {
    "poem_id": 88060,
    "vorder": 30,
    "position": 1,
    "text": "که بردند گستهم را پیش اوی"
  },
  {
    "poem_id": 88060,
    "vorder": 31,
    "position": 0,
    "text": "چنان نیک دل شد از او شهریار"
  },
  {
    "poem_id": 88060,
    "vorder": 32,
    "position": 1,
    "text": "که از گریه مژگانش آمد به بار"
  },
  {
    "poem_id": 88060,
    "vorder": 33,
    "position": 0,
    "text": "چنان بد ز بس خستگی گستهم"
  },
  {
    "poem_id": 88060,
    "vorder": 34,
    "position": 1,
    "text": "که گفتی همی برنیامدش دم"
  },
  {
    "poem_id": 88060,
    "vorder": 35,
    "position": 0,
    "text": "یکی بوی مهر شهنشاه یافت"
  },
  {
    "poem_id": 88060,
    "vorder": 36,
    "position": 1,
    "text": "بپیچید و دیده سوی او شتافت"
  },
  {
    "poem_id": 88060,
    "vorder": 37,
    "position": 0,
    "text": "ببارید از دیدگان آب مهر"
  },
  {
    "poem_id": 88060,
    "vorder": 38,
    "position": 1,
    "text": "سپهبد پر از آب و خون کرد چهر"
  },
  {
    "poem_id": 88060,
    "vorder": 39,
    "position": 0,
    "text": "بزرگان بر او زار و گریان شدند"
  },
  {
    "poem_id": 88060,
    "vorder": 40,
    "position": 1,
    "text": "چو بر آتش تیز بریان شدند"
  },
  {
    "poem_id": 88060,
    "vorder": 41,
    "position": 0,
    "text": "دریغ آمد او را سپهبد به مرگ"
  },
  {
    "poem_id": 88060,
    "vorder": 42,
    "position": 1,
    "text": "که سندان کین بد سرش زیر ترگ"
  },
  {
    "poem_id": 88060,
    "vorder": 43,
    "position": 0,
    "text": "ز هوشنگ و طهمورث و جمشید"
  },
  {
    "poem_id": 88060,
    "vorder": 44,
    "position": 1,
    "text": "یکی مهره بد خستگان را امید"
  },
  {
    "poem_id": 88060,
    "vorder": 45,
    "position": 0,
    "text": "رسیده به میراث نزدیک شاه"
  },
  {
    "poem_id": 88060,
    "vorder": 46,
    "position": 1,
    "text": "به بازوش بر داشتی سال و ماه"
  },
  {
    "poem_id": 88060,
    "vorder": 47,
    "position": 0,
    "text": "چو مهر دلش گستهم را بخواست"
  },
  {
    "poem_id": 88060,
    "vorder": 48,
    "position": 1,
    "text": "گشاد آن گرانمایه از دست راست"
  },
  {
    "poem_id": 88060,
    "vorder": 49,
    "position": 0,
    "text": "ابر بازوی گستهم بر ببست"
  },
  {
    "poem_id": 88060,
    "vorder": 50,
    "position": 1,
    "text": "بمالید بر خستگیهاش دست"
  },
  {
    "poem_id": 88060,
    "vorder": 51,
    "position": 0,
    "text": "پزشکان که از روم و ز هند و چین"
  },
  {
    "poem_id": 88060,
    "vorder": 52,
    "position": 1,
    "text": "چه از شهر یونان و ایران زمین"
  },
  {
    "poem_id": 88060,
    "vorder": 53,
    "position": 0,
    "text": "به بالین گستهمشان بر نشاند"
  },
  {
    "poem_id": 88060,
    "vorder": 54,
    "position": 1,
    "text": "ز هر گونه افسون بر او بر بخواند"
  },
  {
    "poem_id": 88060,
    "vorder": 55,
    "position": 0,
    "text": "وز آنجا بیامد به جای نماز"
  },
  {
    "poem_id": 88060,
    "vorder": 56,
    "position": 1,
    "text": "بسی با جهان آفرین گفت راز"
  },
  {
    "poem_id": 88060,
    "vorder": 57,
    "position": 0,
    "text": "دو هفته برآمد بر آن خسته مرد"
  },
  {
    "poem_id": 88060,
    "vorder": 58,
    "position": 1,
    "text": "سر آمد همه رنج و سختی و درد"
  },
  {
    "poem_id": 88060,
    "vorder": 59,
    "position": 0,
    "text": "بر اسبش ببردند نزدیک شاه"
  },
  {
    "poem_id": 88060,
    "vorder": 60,
    "position": 1,
    "text": "چو شاه اندر او کرد لختی نگاه"
  },
  {
    "poem_id": 88060,
    "vorder": 61,
    "position": 0,
    "text": "به ایرانیان گفت کز کردگار"
  },
  {
    "poem_id": 88060,
    "vorder": 62,
    "position": 1,
    "text": "بود هر کسی شاد و به روزگار"
  },
  {
    "poem_id": 88060,
    "vorder": 63,
    "position": 0,
    "text": "ولیکن شگفت است این کار من"
  },
  {
    "poem_id": 88060,
    "vorder": 64,
    "position": 1,
    "text": "بدین راستی بر شده یار من"
  },
  {
    "poem_id": 88060,
    "vorder": 65,
    "position": 0,
    "text": "به پیروزی اندر غم گستهم"
  },
  {
    "poem_id": 88060,
    "vorder": 66,
    "position": 1,
    "text": "نکرد این دل شادمان را دژم"
  },
  {
    "poem_id": 88060,
    "vorder": 67,
    "position": 0,
    "text": "بخواند آن زمان بیژن گیو را"
  },
  {
    "poem_id": 88060,
    "vorder": 68,
    "position": 1,
    "text": "بدو داد دست گو نیو را"
  },
  {
    "poem_id": 88060,
    "vorder": 69,
    "position": 0,
    "text": "که تو نیک‌بختی و یزدان شناس"
  },
  {
    "poem_id": 88060,
    "vorder": 70,
    "position": 1,
    "text": "مدار از تن خویش هرگز هراس"
  },
  {
    "poem_id": 88060,
    "vorder": 71,
    "position": 0,
    "text": "همه مهر پروردگار است و بس"
  },
  {
    "poem_id": 88060,
    "vorder": 72,
    "position": 1,
    "text": "ندانم به گیتی جز او هیچ کس"
  },
  {
    "poem_id": 88060,
    "vorder": 73,
    "position": 0,
    "text": "که اوی است جاوید فریادرس"
  },
  {
    "poem_id": 88060,
    "vorder": 74,
    "position": 1,
    "text": "به سختی نگیرد جز او دست کس"
  },
  {
    "poem_id": 88060,
    "vorder": 75,
    "position": 0,
    "text": "اگر زنده گردد تن مرده مرد"
  },
  {
    "poem_id": 88060,
    "vorder": 76,
    "position": 1,
    "text": "جهاندار گستهم را زنده کرد"
  },
  {
    "poem_id": 88060,
    "vorder": 77,
    "position": 0,
    "text": "بدآنگه بدو گفت تیمار دار"
  },
  {
    "poem_id": 88060,
    "vorder": 78,
    "position": 1,
    "text": "چو بیژن نبیند کس از روزگار"
  },
  {
    "poem_id": 88060,
    "vorder": 79,
    "position": 0,
    "text": "کز او رنج بر مهر بگزیده‌ای"
  },
  {
    "poem_id": 88060,
    "vorder": 80,
    "position": 1,
    "text": "ستایش بدین گونه بشنیده‌ای"
  },
  {
    "poem_id": 88060,
    "vorder": 81,
    "position": 0,
    "text": "به زیبد ببد شاه یک هفته نیز"
  },
  {
    "poem_id": 88060,
    "vorder": 82,
    "position": 1,
    "text": "درم داد و دینار و هر گونه چیز"
  },
  {
    "poem_id": 88060,
    "vorder": 83,
    "position": 0,
    "text": "فرستاد هر سو فرستادگان"
  },
  {
    "poem_id": 88060,
    "vorder": 84,
    "position": 1,
    "text": "به نزد بزرگان و آزادگان"
  },
  {
    "poem_id": 88060,
    "vorder": 85,
    "position": 0,
    "text": "چو از جنگ پیران شدی بی‌نیاز"
  },
  {
    "poem_id": 88060,
    "vorder": 86,
    "position": 1,
    "text": "یکی رزم کیخسرو اکنون بساز"
  }
]