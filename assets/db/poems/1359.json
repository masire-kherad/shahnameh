[
  {
    "poem_id": 1359,
    "vorder": 1,
    "position": 0,
    "text": "ز سالش چو یک پنجه اندر کشید"
  },
  {
    "poem_id": 1359,
    "vorder": 2,
    "position": 1,
    "text": "سه فرزند‌ش آمد گرامی پدید"
  },
  {
    "poem_id": 1359,
    "vorder": 3,
    "position": 0,
    "text": "به بخت جهاندار هر سه پسر"
  },
  {
    "poem_id": 1359,
    "vorder": 4,
    "position": 1,
    "text": "سه خسرو نژاد از در تاج زر"
  },
  {
    "poem_id": 1359,
    "vorder": 5,
    "position": 0,
    "text": "به بالا چو سرو و به رخ چون بهار"
  },
  {
    "poem_id": 1359,
    "vorder": 6,
    "position": 1,
    "text": "به هر چیز مانندهٔ شهریار"
  },
  {
    "poem_id": 1359,
    "vorder": 7,
    "position": 0,
    "text": "از این سه دو پاکیزه از شهرناز"
  },
  {
    "poem_id": 1359,
    "vorder": 8,
    "position": 1,
    "text": "یکی کهتر از خوب چهر ارنواز"
  },
  {
    "poem_id": 1359,
    "vorder": 9,
    "position": 0,
    "text": "پدر نوز ناکرده از ناز نام"
  },
  {
    "poem_id": 1359,
    "vorder": 10,
    "position": 1,
    "text": "همی پیش پیلان نهادند گام"
  },
  {
    "poem_id": 1359,
    "vorder": 11,
    "position": 0,
    "text": "فریدون از آن نامداران خویش"
  },
  {
    "poem_id": 1359,
    "vorder": 12,
    "position": 1,
    "text": "یکی را گرانمایه‌تر خواند پیش"
  },
  {
    "poem_id": 1359,
    "vorder": 13,
    "position": 0,
    "text": "کجا نام او جندل پرهنر"
  },
  {
    "poem_id": 1359,
    "vorder": 14,
    "position": 1,
    "text": "به هر کار دلسوز بر شاه بر"
  },
  {
    "poem_id": 1359,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت برگرد گرد جهان"
  },
  {
    "poem_id": 1359,
    "vorder": 16,
    "position": 1,
    "text": "سه دختر گزین از نژاد مهان"
  },
  {
    "poem_id": 1359,
    "vorder": 17,
    "position": 0,
    "text": "سه خواهر ز یک مادر و یک پدر"
  },
  {
    "poem_id": 1359,
    "vorder": 18,
    "position": 1,
    "text": "پری چهره و پاک و خسرو گهر"
  },
  {
    "poem_id": 1359,
    "vorder": 19,
    "position": 0,
    "text": "به خوبی سزای سه فرزند من"
  },
  {
    "poem_id": 1359,
    "vorder": 20,
    "position": 1,
    "text": "چنان چون بشاید به پیوند من"
  },
  {
    "poem_id": 1359,
    "vorder": 21,
    "position": 0,
    "text": "به بالا و دیدار هر سه یکی"
  },
  {
    "poem_id": 1359,
    "vorder": 22,
    "position": 1,
    "text": "که این را ندانند ازان اندکی"
  },
  {
    "poem_id": 1359,
    "vorder": 23,
    "position": 0,
    "text": "چو بشنید جندل ز خسرو سخن"
  },
  {
    "poem_id": 1359,
    "vorder": 24,
    "position": 1,
    "text": "یکی رای پاکیزه افگند بن"
  },
  {
    "poem_id": 1359,
    "vorder": 25,
    "position": 0,
    "text": "که بیدار دل بود و پاکیزه مغز"
  },
  {
    "poem_id": 1359,
    "vorder": 26,
    "position": 1,
    "text": "زبان چرب و شایستهٔ کار نغز"
  },
  {
    "poem_id": 1359,
    "vorder": 27,
    "position": 0,
    "text": "ز پیش سپهبد برون شد به راه"
  },
  {
    "poem_id": 1359,
    "vorder": 28,
    "position": 1,
    "text": "ابا چند تن مر ورا نیکخواه"
  },
  {
    "poem_id": 1359,
    "vorder": 29,
    "position": 0,
    "text": "یکایک ز ایران سراندر کشید"
  },
  {
    "poem_id": 1359,
    "vorder": 30,
    "position": 1,
    "text": "پژوهید و هرگونه گفت و شنید"
  },
  {
    "poem_id": 1359,
    "vorder": 31,
    "position": 0,
    "text": "به هر کشوری کز جهان مهتری"
  },
  {
    "poem_id": 1359,
    "vorder": 32,
    "position": 1,
    "text": "به پرده درون داشتن دختری"
  },
  {
    "poem_id": 1359,
    "vorder": 33,
    "position": 0,
    "text": "نهفته بجستی همه راز‌شان"
  },
  {
    "poem_id": 1359,
    "vorder": 34,
    "position": 1,
    "text": "شنیدی همه نام و آواز‌شان"
  },
  {
    "poem_id": 1359,
    "vorder": 35,
    "position": 0,
    "text": "ز دهقان پر مایه کس را ندید"
  },
  {
    "poem_id": 1359,
    "vorder": 36,
    "position": 1,
    "text": "که پیوستهٔ آفریدون سزید"
  },
  {
    "poem_id": 1359,
    "vorder": 37,
    "position": 0,
    "text": "خردمند و روشن‌دل و پاک‌تن"
  },
  {
    "poem_id": 1359,
    "vorder": 38,
    "position": 1,
    "text": "بیامد بر سرو شاه یمن"
  },
  {
    "poem_id": 1359,
    "vorder": 39,
    "position": 0,
    "text": "نشان یافت جندل مر اورا درست"
  },
  {
    "poem_id": 1359,
    "vorder": 40,
    "position": 1,
    "text": "سه دختر چنان چون فریدون بجست"
  },
  {
    "poem_id": 1359,
    "vorder": 41,
    "position": 0,
    "text": "خرامان بیامد به نزدیک سرو"
  },
  {
    "poem_id": 1359,
    "vorder": 42,
    "position": 1,
    "text": "چنان چون به پیش گل اندر تذرو"
  },
  {
    "poem_id": 1359,
    "vorder": 43,
    "position": 0,
    "text": "زمین را ببوسید و چربی نمود"
  },
  {
    "poem_id": 1359,
    "vorder": 44,
    "position": 1,
    "text": "برآن کهتری آفرین برفزود"
  },
  {
    "poem_id": 1359,
    "vorder": 45,
    "position": 0,
    "text": "به جندل چنین گفت شاه یمن"
  },
  {
    "poem_id": 1359,
    "vorder": 46,
    "position": 1,
    "text": "که بی‌آفرینت مبادا دهن"
  },
  {
    "poem_id": 1359,
    "vorder": 47,
    "position": 0,
    "text": "چه پیغام داری چه فرمان دهی"
  },
  {
    "poem_id": 1359,
    "vorder": 48,
    "position": 1,
    "text": "فرستاده‌ای گر گرامی رهی"
  },
  {
    "poem_id": 1359,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت جندل که خرم بدی"
  },
  {
    "poem_id": 1359,
    "vorder": 50,
    "position": 1,
    "text": "همیشه ز تو دور دست بدی"
  },
  {
    "poem_id": 1359,
    "vorder": 51,
    "position": 0,
    "text": "از ایران یکی کهترم چون شمن"
  },
  {
    "poem_id": 1359,
    "vorder": 52,
    "position": 1,
    "text": "پیام آوریده به شاه یمن"
  },
  {
    "poem_id": 1359,
    "vorder": 53,
    "position": 0,
    "text": "درود فریدون فرخ دهم"
  },
  {
    "poem_id": 1359,
    "vorder": 54,
    "position": 1,
    "text": "سخن هر چه پرسند پاسخ دهم"
  },
  {
    "poem_id": 1359,
    "vorder": 55,
    "position": 0,
    "text": "ترا آفرین از فریدون گرد"
  },
  {
    "poem_id": 1359,
    "vorder": 56,
    "position": 1,
    "text": "بزرگ آن‌کسی کو نداردش خرد"
  },
  {
    "poem_id": 1359,
    "vorder": 57,
    "position": 0,
    "text": "مرا گفت شاه یمن را بگوی"
  },
  {
    "poem_id": 1359,
    "vorder": 58,
    "position": 1,
    "text": "که بر گاه تا مشک بوید ببوی"
  },
  {
    "poem_id": 1359,
    "vorder": 59,
    "position": 0,
    "text": "بدان ای سر مایهٔ تازیان"
  },
  {
    "poem_id": 1359,
    "vorder": 60,
    "position": 1,
    "text": "کز اختر بدی جاودان بی‌زیان"
  },
  {
    "poem_id": 1359,
    "vorder": 61,
    "position": 0,
    "text": "مرا پادشاهی آباد هست"
  },
  {
    "poem_id": 1359,
    "vorder": 62,
    "position": 1,
    "text": "همان گنج و مردی و نیروی دست"
  },
  {
    "poem_id": 1359,
    "vorder": 63,
    "position": 0,
    "text": "سه فرزند شایستهٔ تاج و گاه"
  },
  {
    "poem_id": 1359,
    "vorder": 64,
    "position": 1,
    "text": "اگر داستان را بود گاه ماه"
  },
  {
    "poem_id": 1359,
    "vorder": 65,
    "position": 0,
    "text": "ز هر کام و هر خواسته بی‌نیاز"
  },
  {
    "poem_id": 1359,
    "vorder": 66,
    "position": 1,
    "text": "به هر آرزو دست ایشان دراز"
  },
  {
    "poem_id": 1359,
    "vorder": 67,
    "position": 0,
    "text": "مر این سه گرانمایه را در نهفت"
  },
  {
    "poem_id": 1359,
    "vorder": 68,
    "position": 1,
    "text": "بباید کنون شاهزاده سه جفت"
  },
  {
    "poem_id": 1359,
    "vorder": 69,
    "position": 0,
    "text": "ز کار آگهان آگهی یافتم"
  },
  {
    "poem_id": 1359,
    "vorder": 70,
    "position": 1,
    "text": "بدین آگهی تیز بشتافتم"
  },
  {
    "poem_id": 1359,
    "vorder": 71,
    "position": 0,
    "text": "کجا از پس پرده پوشیده روی"
  },
  {
    "poem_id": 1359,
    "vorder": 72,
    "position": 1,
    "text": "سه پاکیزه داری تو ای نامجوی"
  },
  {
    "poem_id": 1359,
    "vorder": 73,
    "position": 0,
    "text": "مران هرسه را نوز ناکرده نام"
  },
  {
    "poem_id": 1359,
    "vorder": 74,
    "position": 1,
    "text": "چو بشنیدم این دل شدم شادکام"
  },
  {
    "poem_id": 1359,
    "vorder": 75,
    "position": 0,
    "text": "که ما نیز نام سه فرخ نژاد"
  },
  {
    "poem_id": 1359,
    "vorder": 76,
    "position": 1,
    "text": "چو اندر خور آید نکردیم یاد"
  },
  {
    "poem_id": 1359,
    "vorder": 77,
    "position": 0,
    "text": "کنون این گرامی دو گونه گهر"
  },
  {
    "poem_id": 1359,
    "vorder": 78,
    "position": 1,
    "text": "بباید برآمیخت با یکدگر"
  },
  {
    "poem_id": 1359,
    "vorder": 79,
    "position": 0,
    "text": "سه پوشیده رخ را سه دیهیم جوی"
  },
  {
    "poem_id": 1359,
    "vorder": 80,
    "position": 1,
    "text": "سزا را سزاوار بی‌گفت‌وگوی"
  },
  {
    "poem_id": 1359,
    "vorder": 81,
    "position": 0,
    "text": "فریدون پیامم بدین گونه داد"
  },
  {
    "poem_id": 1359,
    "vorder": 82,
    "position": 1,
    "text": "تو پاسخ گزار آنچه آیدت یاد"
  },
  {
    "poem_id": 1359,
    "vorder": 83,
    "position": 0,
    "text": "پیامش چو بشنید شاه یمن"
  },
  {
    "poem_id": 1359,
    "vorder": 84,
    "position": 1,
    "text": "بپژمرد چون زاب کنده سمن"
  },
  {
    "poem_id": 1359,
    "vorder": 85,
    "position": 0,
    "text": "همی‌گفت گر پیش بالین من"
  },
  {
    "poem_id": 1359,
    "vorder": 86,
    "position": 1,
    "text": "نبیند سه ماه این جهان‌بین من"
  },
  {
    "poem_id": 1359,
    "vorder": 87,
    "position": 0,
    "text": "مرا روز روشن بود تاره شب"
  },
  {
    "poem_id": 1359,
    "vorder": 88,
    "position": 1,
    "text": "بباید گشادن به پاسخ دو لب"
  },
  {
    "poem_id": 1359,
    "vorder": 89,
    "position": 0,
    "text": "سراینده را گفت کای نامجوی"
  },
  {
    "poem_id": 1359,
    "vorder": 90,
    "position": 1,
    "text": "زمان باید اندر چنین گفت‌گوی"
  },
  {
    "poem_id": 1359,
    "vorder": 91,
    "position": 0,
    "text": "شتابت نباید به پاسخ کنون"
  },
  {
    "poem_id": 1359,
    "vorder": 92,
    "position": 1,
    "text": "مرا چند راز‌ست با رهنمون"
  },
  {
    "poem_id": 1359,
    "vorder": 93,
    "position": 0,
    "text": "فرستاده را زود جایی گزید"
  },
  {
    "poem_id": 1359,
    "vorder": 94,
    "position": 1,
    "text": "پس آنگه به کار اندرون بنگرید"
  },
  {
    "poem_id": 1359,
    "vorder": 95,
    "position": 0,
    "text": "بیامد در بار دادن ببست"
  },
  {
    "poem_id": 1359,
    "vorder": 96,
    "position": 1,
    "text": "به انبوه اندیشگان در نشست"
  },
  {
    "poem_id": 1359,
    "vorder": 97,
    "position": 0,
    "text": "فراوان کس از دشت نیزه‌وران"
  },
  {
    "poem_id": 1359,
    "vorder": 98,
    "position": 1,
    "text": "بر خویش خواند آزموده سران"
  },
  {
    "poem_id": 1359,
    "vorder": 99,
    "position": 0,
    "text": "نهفته برون آورید از نهفت"
  },
  {
    "poem_id": 1359,
    "vorder": 100,
    "position": 1,
    "text": "همه راز‌ها پیش ایشان بگفت"
  },
  {
    "poem_id": 1359,
    "vorder": 101,
    "position": 0,
    "text": "که ما را به گیتی ز پیوند خویش"
  },
  {
    "poem_id": 1359,
    "vorder": 102,
    "position": 1,
    "text": "سه شمع‌ست روشن به دیدار پیش"
  },
  {
    "poem_id": 1359,
    "vorder": 103,
    "position": 0,
    "text": "فریدون فرستاد زی من پیام"
  },
  {
    "poem_id": 1359,
    "vorder": 104,
    "position": 1,
    "text": "بگسترد پیشم یکی خوب دام"
  },
  {
    "poem_id": 1359,
    "vorder": 105,
    "position": 0,
    "text": "همی‌کرد خواهد ز چشمم جدا"
  },
  {
    "poem_id": 1359,
    "vorder": 106,
    "position": 1,
    "text": "یکی رای باید زدن با شما"
  },
  {
    "poem_id": 1359,
    "vorder": 107,
    "position": 0,
    "text": "فرستاده گوید چنین گفت شاه"
  },
  {
    "poem_id": 1359,
    "vorder": 108,
    "position": 1,
    "text": "که ما را سه شاه‌ست زیبای گاه"
  },
  {
    "poem_id": 1359,
    "vorder": 109,
    "position": 0,
    "text": "گراینده هر سه به پیوند من"
  },
  {
    "poem_id": 1359,
    "vorder": 110,
    "position": 1,
    "text": "به سه روی پوشیده فرزند من"
  },
  {
    "poem_id": 1359,
    "vorder": 111,
    "position": 0,
    "text": "اگر گویم آری و دل زان تهی"
  },
  {
    "poem_id": 1359,
    "vorder": 112,
    "position": 1,
    "text": "دروغم نه اندر خورد با مهی"
  },
  {
    "poem_id": 1359,
    "vorder": 113,
    "position": 0,
    "text": "وگر آرزو‌ها سپارم بدوی"
  },
  {
    "poem_id": 1359,
    "vorder": 114,
    "position": 1,
    "text": "شود دل پر آتش پر از آب روی"
  },
  {
    "poem_id": 1359,
    "vorder": 115,
    "position": 0,
    "text": "وگر سر بپیچم ز فرمان او"
  },
  {
    "poem_id": 1359,
    "vorder": 116,
    "position": 1,
    "text": "به یک سو گرایم ز پیمان او"
  },
  {
    "poem_id": 1359,
    "vorder": 117,
    "position": 0,
    "text": "کسی کو بود شهریار زمین"
  },
  {
    "poem_id": 1359,
    "vorder": 118,
    "position": 1,
    "text": "نه بازی‌ست با او سگالید کین"
  },
  {
    "poem_id": 1359,
    "vorder": 119,
    "position": 0,
    "text": "شنیدستم از مردم راه‌جوی"
  },
  {
    "poem_id": 1359,
    "vorder": 120,
    "position": 1,
    "text": "که ضحاک را زو چه آمد بروی"
  },
  {
    "poem_id": 1359,
    "vorder": 121,
    "position": 0,
    "text": "ازین در سخن هر چه دارید یاد"
  },
  {
    "poem_id": 1359,
    "vorder": 122,
    "position": 1,
    "text": "سراسر به من بر بباید گشاد"
  },
  {
    "poem_id": 1359,
    "vorder": 123,
    "position": 0,
    "text": "جهان آزموده دلاور سران"
  },
  {
    "poem_id": 1359,
    "vorder": 124,
    "position": 1,
    "text": "گشادند یک‌یک به پاسخ زبان"
  },
  {
    "poem_id": 1359,
    "vorder": 125,
    "position": 0,
    "text": "که ما همگنان آن نبینیم رای"
  },
  {
    "poem_id": 1359,
    "vorder": 126,
    "position": 1,
    "text": "که هر باد را تو بجنبی ز جای"
  },
  {
    "poem_id": 1359,
    "vorder": 127,
    "position": 0,
    "text": "اگر شد فریدون جهان شهریار"
  },
  {
    "poem_id": 1359,
    "vorder": 128,
    "position": 1,
    "text": "نه ما بندگانیم با گوشوار"
  },
  {
    "poem_id": 1359,
    "vorder": 129,
    "position": 0,
    "text": "سخن‌گفتن و کوشش آیین ماست"
  },
  {
    "poem_id": 1359,
    "vorder": 130,
    "position": 1,
    "text": "عنان و سنان تافتن دین ماست"
  },
  {
    "poem_id": 1359,
    "vorder": 131,
    "position": 0,
    "text": "به خنجر زمین را میستان کنیم"
  },
  {
    "poem_id": 1359,
    "vorder": 132,
    "position": 1,
    "text": "به نیزه هوا را نیستان کنیم"
  },
  {
    "poem_id": 1359,
    "vorder": 133,
    "position": 0,
    "text": "سه فرزند اگر بر تو هست ارجمند"
  },
  {
    "poem_id": 1359,
    "vorder": 134,
    "position": 1,
    "text": "سر بدره بگشای و لب را ببند"
  },
  {
    "poem_id": 1359,
    "vorder": 135,
    "position": 0,
    "text": "و گر چارهٔ کار خواهی همی"
  },
  {
    "poem_id": 1359,
    "vorder": 136,
    "position": 1,
    "text": "بترسی ازین پادشاهی همی"
  },
  {
    "poem_id": 1359,
    "vorder": 137,
    "position": 0,
    "text": "ازو آرزو‌های پرمایه جوی"
  },
  {
    "poem_id": 1359,
    "vorder": 138,
    "position": 1,
    "text": "که کردار آنرا نبینند روی"
  },
  {
    "poem_id": 1359,
    "vorder": 139,
    "position": 0,
    "text": "چو بشنید از آن نامداران سخن"
  },
  {
    "poem_id": 1359,
    "vorder": 140,
    "position": 1,
    "text": "نه سر دید آن را به گیتی نه بن"
  }
]