[
  {
    "poem_id": 1682,
    "vorder": 1,
    "position": 0,
    "text": "به بابل هم‌ان روز شد دردمند"
  },
  {
    "poem_id": 1682,
    "vorder": 2,
    "position": 1,
    "text": "بدانست کامد به تنگی گزند"
  },
  {
    "poem_id": 1682,
    "vorder": 3,
    "position": 0,
    "text": "دبیر جهاندیده را پیش خواند"
  },
  {
    "poem_id": 1682,
    "vorder": 4,
    "position": 1,
    "text": "هرانچش به دل بود با او براند"
  },
  {
    "poem_id": 1682,
    "vorder": 5,
    "position": 0,
    "text": "به مادر یکی نامه فرمود و گفت"
  },
  {
    "poem_id": 1682,
    "vorder": 6,
    "position": 1,
    "text": "که آگاهی مرگ نتوان نهفت"
  },
  {
    "poem_id": 1682,
    "vorder": 7,
    "position": 0,
    "text": "ز گیتی مرا بهره این بد که بود"
  },
  {
    "poem_id": 1682,
    "vorder": 8,
    "position": 1,
    "text": "زمان چون نکاهد نشاید فزود"
  },
  {
    "poem_id": 1682,
    "vorder": 9,
    "position": 0,
    "text": "تو از مرگ من هیچ غمگین مشو"
  },
  {
    "poem_id": 1682,
    "vorder": 10,
    "position": 1,
    "text": "که اندر جهان این سخن نیست نو"
  },
  {
    "poem_id": 1682,
    "vorder": 11,
    "position": 0,
    "text": "هرانکس که زاید ببایدش مرد"
  },
  {
    "poem_id": 1682,
    "vorder": 12,
    "position": 1,
    "text": "اگر شهریارست گر مرد خرد"
  },
  {
    "poem_id": 1682,
    "vorder": 13,
    "position": 0,
    "text": "بگویم کنون با بزرگان روم"
  },
  {
    "poem_id": 1682,
    "vorder": 14,
    "position": 1,
    "text": "که چون بازگردند زین مرز و بوم"
  },
  {
    "poem_id": 1682,
    "vorder": 15,
    "position": 0,
    "text": "نجویند جز رای و فرمان تو"
  },
  {
    "poem_id": 1682,
    "vorder": 16,
    "position": 1,
    "text": "کسی برنگردد ز پیمان تو"
  },
  {
    "poem_id": 1682,
    "vorder": 17,
    "position": 0,
    "text": "هرانکس که بودند ز ایرانیان"
  },
  {
    "poem_id": 1682,
    "vorder": 18,
    "position": 1,
    "text": "کزیشان بدی رومیان را زیان"
  },
  {
    "poem_id": 1682,
    "vorder": 19,
    "position": 0,
    "text": "سپردم به هر مهتری کشوری"
  },
  {
    "poem_id": 1682,
    "vorder": 20,
    "position": 1,
    "text": "که گردد بر آن پادشاهی سری"
  },
  {
    "poem_id": 1682,
    "vorder": 21,
    "position": 0,
    "text": "همانا نیازش نیاید به روم"
  },
  {
    "poem_id": 1682,
    "vorder": 22,
    "position": 1,
    "text": "برآساید آن کشور و مرز و بوم"
  },
  {
    "poem_id": 1682,
    "vorder": 23,
    "position": 0,
    "text": "مرا مرده در خاک مصر آگنید"
  },
  {
    "poem_id": 1682,
    "vorder": 24,
    "position": 1,
    "text": "ز گفتار من هیچ مپراگنید"
  },
  {
    "poem_id": 1682,
    "vorder": 25,
    "position": 0,
    "text": "به سالی ز دینار من صدهزار"
  },
  {
    "poem_id": 1682,
    "vorder": 26,
    "position": 1,
    "text": "ببخشید بر مردم خیش‌کار"
  },
  {
    "poem_id": 1682,
    "vorder": 27,
    "position": 0,
    "text": "گر آید یکی روشنک را پسر"
  },
  {
    "poem_id": 1682,
    "vorder": 28,
    "position": 1,
    "text": "بود بی‌گمان زنده نام پدر"
  },
  {
    "poem_id": 1682,
    "vorder": 29,
    "position": 0,
    "text": "نباید که باشد جزو شاه روم"
  },
  {
    "poem_id": 1682,
    "vorder": 30,
    "position": 1,
    "text": "که او تازه گرداند آن مرز و بوم"
  },
  {
    "poem_id": 1682,
    "vorder": 31,
    "position": 0,
    "text": "وگر دختر آید به هنگام بوس"
  },
  {
    "poem_id": 1682,
    "vorder": 32,
    "position": 1,
    "text": "به پیوند با تخمهٔ فیلقوس"
  },
  {
    "poem_id": 1682,
    "vorder": 33,
    "position": 0,
    "text": "تو فرزند خوانش نه داماد من"
  },
  {
    "poem_id": 1682,
    "vorder": 34,
    "position": 1,
    "text": "بدو تازه کن در جهان یاد من"
  },
  {
    "poem_id": 1682,
    "vorder": 35,
    "position": 0,
    "text": "دگر دختر کید را بی‌گزند"
  },
  {
    "poem_id": 1682,
    "vorder": 36,
    "position": 1,
    "text": "فرستید نزد پدر ارجمند"
  },
  {
    "poem_id": 1682,
    "vorder": 37,
    "position": 0,
    "text": "ابا یاره و برده و نیک‌خواه"
  },
  {
    "poem_id": 1682,
    "vorder": 38,
    "position": 1,
    "text": "عمار بسیچید بااو به راه"
  },
  {
    "poem_id": 1682,
    "vorder": 39,
    "position": 0,
    "text": "همان افسر و گوهر و سیم و زر"
  },
  {
    "poem_id": 1682,
    "vorder": 40,
    "position": 1,
    "text": "که آورده بود او ز پیش پدر"
  },
  {
    "poem_id": 1682,
    "vorder": 41,
    "position": 0,
    "text": "به رفتن چنو گشت همداستان"
  },
  {
    "poem_id": 1682,
    "vorder": 42,
    "position": 1,
    "text": "فرستید با او به هندوستان"
  },
  {
    "poem_id": 1682,
    "vorder": 43,
    "position": 0,
    "text": "من ایدر همه کار کردم به برگ"
  },
  {
    "poem_id": 1682,
    "vorder": 44,
    "position": 1,
    "text": "به بیچارگی دل نهادم به مرگ"
  },
  {
    "poem_id": 1682,
    "vorder": 45,
    "position": 0,
    "text": "نخست آنک تابوت زرین کنند"
  },
  {
    "poem_id": 1682,
    "vorder": 46,
    "position": 1,
    "text": "کفن بر تنم عنبر آگین کنند"
  },
  {
    "poem_id": 1682,
    "vorder": 47,
    "position": 0,
    "text": "ز زربفت چینی سزاوار من"
  },
  {
    "poem_id": 1682,
    "vorder": 48,
    "position": 1,
    "text": "کسی کو بپیچد ز تیمار من"
  },
  {
    "poem_id": 1682,
    "vorder": 49,
    "position": 0,
    "text": "در و بند تابوت ما را به قیر"
  },
  {
    "poem_id": 1682,
    "vorder": 50,
    "position": 1,
    "text": "بگیرند و کافور و مشک و عبیر"
  },
  {
    "poem_id": 1682,
    "vorder": 51,
    "position": 0,
    "text": "نخست آگنند اندرو انگبین"
  },
  {
    "poem_id": 1682,
    "vorder": 52,
    "position": 1,
    "text": "زبر انگبین زیر دیبای چین"
  },
  {
    "poem_id": 1682,
    "vorder": 53,
    "position": 0,
    "text": "ازان پس تن من نهند اندران"
  },
  {
    "poem_id": 1682,
    "vorder": 54,
    "position": 1,
    "text": "سرآمد سخن چون برآمد روان"
  },
  {
    "poem_id": 1682,
    "vorder": 55,
    "position": 0,
    "text": "تو پند من ای مادر پرخرد"
  },
  {
    "poem_id": 1682,
    "vorder": 56,
    "position": 1,
    "text": "نگه‌دار تا روز من بگذرد"
  },
  {
    "poem_id": 1682,
    "vorder": 57,
    "position": 0,
    "text": "ز چیزی که آوردم از هند و چین"
  },
  {
    "poem_id": 1682,
    "vorder": 58,
    "position": 1,
    "text": "ز توران و ایران و مکران زمین"
  },
  {
    "poem_id": 1682,
    "vorder": 59,
    "position": 0,
    "text": "بدار و ببخش آنچ افزون بود"
  },
  {
    "poem_id": 1682,
    "vorder": 60,
    "position": 1,
    "text": "وز اندازهٔ خویش بیرون بود"
  },
  {
    "poem_id": 1682,
    "vorder": 61,
    "position": 0,
    "text": "به تو حاجت آنستم ای مهربان"
  },
  {
    "poem_id": 1682,
    "vorder": 62,
    "position": 1,
    "text": "که بیدار باشی و روشن‌روان"
  },
  {
    "poem_id": 1682,
    "vorder": 63,
    "position": 0,
    "text": "نداری تن خویش را رنجه بس"
  },
  {
    "poem_id": 1682,
    "vorder": 64,
    "position": 1,
    "text": "که اندر جهان نیست جاوید کس"
  },
  {
    "poem_id": 1682,
    "vorder": 65,
    "position": 0,
    "text": "روانم روان ترا بی‌گمان"
  },
  {
    "poem_id": 1682,
    "vorder": 66,
    "position": 1,
    "text": "ببیند چو تنگ اندر آید زمان"
  },
  {
    "poem_id": 1682,
    "vorder": 67,
    "position": 0,
    "text": "شکیبایی از مهر نامی‌تر است"
  },
  {
    "poem_id": 1682,
    "vorder": 68,
    "position": 1,
    "text": "سبکسر بود هرک او کهتر است"
  },
  {
    "poem_id": 1682,
    "vorder": 69,
    "position": 0,
    "text": "ترا مهر بد بر تنم سال و ماه"
  },
  {
    "poem_id": 1682,
    "vorder": 70,
    "position": 1,
    "text": "کنون جان پاکم ز یزدان بخواه"
  },
  {
    "poem_id": 1682,
    "vorder": 71,
    "position": 0,
    "text": "بدین خواستن باش فریادرس"
  },
  {
    "poem_id": 1682,
    "vorder": 72,
    "position": 1,
    "text": "که فریادرس باشدم دست‌رس"
  },
  {
    "poem_id": 1682,
    "vorder": 73,
    "position": 0,
    "text": "نگر تا که بینی به گرد جهان"
  },
  {
    "poem_id": 1682,
    "vorder": 74,
    "position": 1,
    "text": "که او نیست از مرگ خسته‌روان"
  },
  {
    "poem_id": 1682,
    "vorder": 75,
    "position": 0,
    "text": "چو نامه به مهر اندر آورد و بند"
  },
  {
    "poem_id": 1682,
    "vorder": 76,
    "position": 1,
    "text": "بفرمود تا بر ستور نوند"
  },
  {
    "poem_id": 1682,
    "vorder": 77,
    "position": 0,
    "text": "ز بابل به روم آورند آگهی"
  },
  {
    "poem_id": 1682,
    "vorder": 78,
    "position": 1,
    "text": "که تیره شد آن فر شاهنشهی"
  }
]