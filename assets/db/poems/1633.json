[
  {
    "poem_id": 1633,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید برزد سر از کوه و راغ"
  },
  {
    "poem_id": 1633,
    "vorder": 2,
    "position": 1,
    "text": "زمین شد به کردار زرین چراغ"
  },
  {
    "poem_id": 1633,
    "vorder": 3,
    "position": 0,
    "text": "جهاندار دارا سپه برگرفت"
  },
  {
    "poem_id": 1633,
    "vorder": 4,
    "position": 1,
    "text": "جهان چادر قیر بر سرگرفت"
  },
  {
    "poem_id": 1633,
    "vorder": 5,
    "position": 0,
    "text": "بیاورد لشکر ز رود فرات"
  },
  {
    "poem_id": 1633,
    "vorder": 6,
    "position": 1,
    "text": "به هامون سپه بیش بود از نبات"
  },
  {
    "poem_id": 1633,
    "vorder": 7,
    "position": 0,
    "text": "سکندر چو بشنید کامد سپاه"
  },
  {
    "poem_id": 1633,
    "vorder": 8,
    "position": 1,
    "text": "بزد کوس و آورد لشکر به راه"
  },
  {
    "poem_id": 1633,
    "vorder": 9,
    "position": 0,
    "text": "دو لشکر که آن را کرانه نبود"
  },
  {
    "poem_id": 1633,
    "vorder": 10,
    "position": 1,
    "text": "چو اسکندر اندر زمانه نبود"
  },
  {
    "poem_id": 1633,
    "vorder": 11,
    "position": 0,
    "text": "ز ساز و ز گردان هر دو گروه"
  },
  {
    "poem_id": 1633,
    "vorder": 12,
    "position": 1,
    "text": "زمین همچو دریا بد و گرد کوه"
  },
  {
    "poem_id": 1633,
    "vorder": 13,
    "position": 0,
    "text": "ز خفتان وز خنجر هندوان"
  },
  {
    "poem_id": 1633,
    "vorder": 14,
    "position": 1,
    "text": "ز بالا و اسپ وز برگستوان"
  },
  {
    "poem_id": 1633,
    "vorder": 15,
    "position": 0,
    "text": "دو رویه سپه برکشیدند صف"
  },
  {
    "poem_id": 1633,
    "vorder": 16,
    "position": 1,
    "text": "ز خنجر همی یافت خورشید تف"
  },
  {
    "poem_id": 1633,
    "vorder": 17,
    "position": 0,
    "text": "به پیش سپاه آوریدند پیل"
  },
  {
    "poem_id": 1633,
    "vorder": 18,
    "position": 1,
    "text": "جهان شد به کردار دریای نیل"
  },
  {
    "poem_id": 1633,
    "vorder": 19,
    "position": 0,
    "text": "سواران جنگ از پس و پیل پیش"
  },
  {
    "poem_id": 1633,
    "vorder": 20,
    "position": 1,
    "text": "همه برگرفته دل از جان خویش"
  },
  {
    "poem_id": 1633,
    "vorder": 21,
    "position": 0,
    "text": "تو گفتی هوا خون خروشد همی"
  },
  {
    "poem_id": 1633,
    "vorder": 22,
    "position": 1,
    "text": "زمین از خروشش بجوشد همی"
  },
  {
    "poem_id": 1633,
    "vorder": 23,
    "position": 0,
    "text": "ز بس نالهٔ بوق و هندی درای"
  },
  {
    "poem_id": 1633,
    "vorder": 24,
    "position": 1,
    "text": "همی کوه را دل برآمد ز جای"
  },
  {
    "poem_id": 1633,
    "vorder": 25,
    "position": 0,
    "text": "ز آواز اسپان و بانگ سران"
  },
  {
    "poem_id": 1633,
    "vorder": 26,
    "position": 1,
    "text": "چرنگیدن گرزهای گران"
  },
  {
    "poem_id": 1633,
    "vorder": 27,
    "position": 0,
    "text": "تو گفتی زمین کوه جنگی شدست"
  },
  {
    "poem_id": 1633,
    "vorder": 28,
    "position": 1,
    "text": "ز گرد آسمان روی زنگی شدست"
  },
  {
    "poem_id": 1633,
    "vorder": 29,
    "position": 0,
    "text": "به یک هفته گردان پرخاشجوی"
  },
  {
    "poem_id": 1633,
    "vorder": 30,
    "position": 1,
    "text": "به روی اندر آورده بودند روی"
  },
  {
    "poem_id": 1633,
    "vorder": 31,
    "position": 0,
    "text": "بهشتم برآمد یکی تیره گرد"
  },
  {
    "poem_id": 1633,
    "vorder": 32,
    "position": 1,
    "text": "بران سان که خورشید شد لاژورد"
  },
  {
    "poem_id": 1633,
    "vorder": 33,
    "position": 0,
    "text": "بپوشید دیدار ایران سپاه"
  },
  {
    "poem_id": 1633,
    "vorder": 34,
    "position": 1,
    "text": "گریزان برفتند از آن رزمگاه"
  },
  {
    "poem_id": 1633,
    "vorder": 35,
    "position": 0,
    "text": "سپاه سکندر پس اندر دمان"
  },
  {
    "poem_id": 1633,
    "vorder": 36,
    "position": 1,
    "text": "یکی پرغم و دیگری شادمان"
  },
  {
    "poem_id": 1633,
    "vorder": 37,
    "position": 0,
    "text": "سکندر بشد تا لب رودبار"
  },
  {
    "poem_id": 1633,
    "vorder": 38,
    "position": 1,
    "text": "بکشتند ز ایرانیان بی‌شمار"
  },
  {
    "poem_id": 1633,
    "vorder": 39,
    "position": 0,
    "text": "سپاه از لب رود برگاشتند"
  },
  {
    "poem_id": 1633,
    "vorder": 40,
    "position": 1,
    "text": "بفرمود تا رود بگذاشتند"
  },
  {
    "poem_id": 1633,
    "vorder": 41,
    "position": 0,
    "text": "به پیروزی آمد بران رزمگاه"
  },
  {
    "poem_id": 1633,
    "vorder": 42,
    "position": 1,
    "text": "کجا پیش بود آن گزیده سپاه"
  }
]