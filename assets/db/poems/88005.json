[
  {
    "poem_id": 88005,
    "vorder": 1,
    "position": 0,
    "text": "بایوان شد و نامه پاسخ نوشت"
  },
  {
    "poem_id": 88005,
    "vorder": 2,
    "position": 1,
    "text": "بباغ بزرگی درختی بکشت"
  },
  {
    "poem_id": 88005,
    "vorder": 3,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 88005,
    "vorder": 4,
    "position": 1,
    "text": "کزو بود روشن دل و بختیار"
  },
  {
    "poem_id": 88005,
    "vorder": 5,
    "position": 0,
    "text": "خداوند ناهید و گردان سپهر"
  },
  {
    "poem_id": 88005,
    "vorder": 6,
    "position": 1,
    "text": "کزویست پرخاش و آرام و مهر"
  },
  {
    "poem_id": 88005,
    "vorder": 7,
    "position": 0,
    "text": "سپهری برین گونه بر پای کرد"
  },
  {
    "poem_id": 88005,
    "vorder": 8,
    "position": 1,
    "text": "شب و روز را گیتی آرای کرد"
  },
  {
    "poem_id": 88005,
    "vorder": 9,
    "position": 0,
    "text": "یکی را چنین تیره‌بخت آفرید"
  },
  {
    "poem_id": 88005,
    "vorder": 10,
    "position": 1,
    "text": "یکی را سزاوار تخت آفرید"
  },
  {
    "poem_id": 88005,
    "vorder": 11,
    "position": 0,
    "text": "غم و شادمانی ز یزدان شناس"
  },
  {
    "poem_id": 88005,
    "vorder": 12,
    "position": 1,
    "text": "کزویست هر گونه بر ما سپاس"
  },
  {
    "poem_id": 88005,
    "vorder": 13,
    "position": 0,
    "text": "رسید آنچ دادی بدین بارگاه"
  },
  {
    "poem_id": 88005,
    "vorder": 14,
    "position": 1,
    "text": "اسیران و پیلان و تخت و کلاه"
  },
  {
    "poem_id": 88005,
    "vorder": 15,
    "position": 0,
    "text": "هیونان بسیار و افگندنی"
  },
  {
    "poem_id": 88005,
    "vorder": 16,
    "position": 1,
    "text": "ز پوشیدنی هم ز گستردنی"
  },
  {
    "poem_id": 88005,
    "vorder": 17,
    "position": 0,
    "text": "همه آلت ناز و سورست و بزم"
  },
  {
    "poem_id": 88005,
    "vorder": 18,
    "position": 1,
    "text": "بپیش تو زین سان که آید برزم"
  },
  {
    "poem_id": 88005,
    "vorder": 19,
    "position": 0,
    "text": "مگر آنکسی کش سرآید بپیش"
  },
  {
    "poem_id": 88005,
    "vorder": 20,
    "position": 1,
    "text": "بدین گونه سیر آید از جان خویش"
  },
  {
    "poem_id": 88005,
    "vorder": 21,
    "position": 0,
    "text": "وزان رنج بردن ز توران سپاه"
  },
  {
    "poem_id": 88005,
    "vorder": 22,
    "position": 1,
    "text": "شب و روز بودن به آوردگاه"
  },
  {
    "poem_id": 88005,
    "vorder": 23,
    "position": 0,
    "text": "ز کارت خبر بد مرا روز و شب"
  },
  {
    "poem_id": 88005,
    "vorder": 24,
    "position": 1,
    "text": "گشاده نکردم به بیگانه لب"
  },
  {
    "poem_id": 88005,
    "vorder": 25,
    "position": 0,
    "text": "شب و روز بر پیش یزدان پاک"
  },
  {
    "poem_id": 88005,
    "vorder": 26,
    "position": 1,
    "text": "نوان بودم و دل شده چاک چاک"
  },
  {
    "poem_id": 88005,
    "vorder": 27,
    "position": 0,
    "text": "کسی را که رستم بود پهلوان"
  },
  {
    "poem_id": 88005,
    "vorder": 28,
    "position": 1,
    "text": "سزد گر بماند همیشه جوان"
  },
  {
    "poem_id": 88005,
    "vorder": 29,
    "position": 0,
    "text": "پرستنده چون تو ندارد سپهر"
  },
  {
    "poem_id": 88005,
    "vorder": 30,
    "position": 1,
    "text": "ز تو بخت هرگز مبراد مهر"
  },
  {
    "poem_id": 88005,
    "vorder": 31,
    "position": 0,
    "text": "نویسنده پردخته شد ز آفرین"
  },
  {
    "poem_id": 88005,
    "vorder": 32,
    "position": 1,
    "text": "نهاد از بر نامه خسرو نگین"
  },
  {
    "poem_id": 88005,
    "vorder": 33,
    "position": 0,
    "text": "بفرمود تا خلعت آراستند"
  },
  {
    "poem_id": 88005,
    "vorder": 34,
    "position": 1,
    "text": "ستام و کمرها بپیراستند"
  },
  {
    "poem_id": 88005,
    "vorder": 35,
    "position": 0,
    "text": "صد از جعد مویان زرین کمر"
  },
  {
    "poem_id": 88005,
    "vorder": 36,
    "position": 1,
    "text": "صد اسپ گرانمایه با زین زر"
  },
  {
    "poem_id": 88005,
    "vorder": 37,
    "position": 0,
    "text": "صد اشتر همه بار دیبای چین"
  },
  {
    "poem_id": 88005,
    "vorder": 38,
    "position": 1,
    "text": "صد اشتر ز افگندنی هم چنین"
  },
  {
    "poem_id": 88005,
    "vorder": 39,
    "position": 0,
    "text": "ز یاقوت رخشان دو انگشتری"
  },
  {
    "poem_id": 88005,
    "vorder": 40,
    "position": 1,
    "text": "ز خوشاب و در افسری بر سری"
  },
  {
    "poem_id": 88005,
    "vorder": 41,
    "position": 0,
    "text": "ز پوشیدن شاه دستی بزر"
  },
  {
    "poem_id": 88005,
    "vorder": 42,
    "position": 1,
    "text": "همان یاره و طوق و زرین کمر"
  },
  {
    "poem_id": 88005,
    "vorder": 43,
    "position": 0,
    "text": "سران را همه هدیه‌ها ساختند"
  },
  {
    "poem_id": 88005,
    "vorder": 44,
    "position": 1,
    "text": "یکی گنج زین سان بپرداختند"
  },
  {
    "poem_id": 88005,
    "vorder": 45,
    "position": 0,
    "text": "فریبرز با تاج و گرز و درفش"
  },
  {
    "poem_id": 88005,
    "vorder": 46,
    "position": 1,
    "text": "یکی تخت زرین و زرینه کفش"
  },
  {
    "poem_id": 88005,
    "vorder": 47,
    "position": 0,
    "text": "فرستاد و فرمود تا بازگشت"
  },
  {
    "poem_id": 88005,
    "vorder": 48,
    "position": 1,
    "text": "از ایران بسوی سپهبد گذشت"
  },
  {
    "poem_id": 88005,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت کز جنگ افراسیاب"
  },
  {
    "poem_id": 88005,
    "vorder": 50,
    "position": 1,
    "text": "نه آرام باید نه خورد و نه خواب"
  },
  {
    "poem_id": 88005,
    "vorder": 51,
    "position": 0,
    "text": "مگر کان سر شهریار گزند"
  },
  {
    "poem_id": 88005,
    "vorder": 52,
    "position": 1,
    "text": "بخم کمند تو آید ببند"
  },
  {
    "poem_id": 88005,
    "vorder": 53,
    "position": 0,
    "text": "فریبرز برگشت زان بارگاه"
  },
  {
    "poem_id": 88005,
    "vorder": 54,
    "position": 1,
    "text": "بکام دل شاه ایران سپاه"
  }
]