[
  {
    "poem_id": 1714,
    "vorder": 1,
    "position": 0,
    "text": "کنون بشنو از دخت مهرک سخن"
  },
  {
    "poem_id": 1714,
    "vorder": 2,
    "position": 1,
    "text": "ابا گرد شاپور شمشیرزن"
  },
  {
    "poem_id": 1714,
    "vorder": 3,
    "position": 0,
    "text": "چو لختی برآمد برین روزگار"
  },
  {
    "poem_id": 1714,
    "vorder": 4,
    "position": 1,
    "text": "فروزنده شد دولت شهریار"
  },
  {
    "poem_id": 1714,
    "vorder": 5,
    "position": 0,
    "text": "به نخچیر شد شاه روزی پگاه"
  },
  {
    "poem_id": 1714,
    "vorder": 6,
    "position": 1,
    "text": "خردمند شاپور با او به راه"
  },
  {
    "poem_id": 1714,
    "vorder": 7,
    "position": 0,
    "text": "به هر سو سواران همی تاختند"
  },
  {
    "poem_id": 1714,
    "vorder": 8,
    "position": 1,
    "text": "ز نخچیر دشتی بپرداختند"
  },
  {
    "poem_id": 1714,
    "vorder": 9,
    "position": 0,
    "text": "پدید آمد از دور دشتی فراخ"
  },
  {
    "poem_id": 1714,
    "vorder": 10,
    "position": 1,
    "text": "پر از باغ و میدان و ایوان و کاخ"
  },
  {
    "poem_id": 1714,
    "vorder": 11,
    "position": 0,
    "text": "همی تاخت شاپور تا پیش ده"
  },
  {
    "poem_id": 1714,
    "vorder": 12,
    "position": 1,
    "text": "فرود آمد از راه در خان مه"
  },
  {
    "poem_id": 1714,
    "vorder": 13,
    "position": 0,
    "text": "یکی باغ بد کش و خرم سرای"
  },
  {
    "poem_id": 1714,
    "vorder": 14,
    "position": 1,
    "text": "جوان اندر آمد بدان سبز جای"
  },
  {
    "poem_id": 1714,
    "vorder": 15,
    "position": 0,
    "text": "یکی دختری دید بر سان ماه"
  },
  {
    "poem_id": 1714,
    "vorder": 16,
    "position": 1,
    "text": "فروهشته از چرخ دلوی به چاه"
  },
  {
    "poem_id": 1714,
    "vorder": 17,
    "position": 0,
    "text": "چو آن ماه‌رخ روی شاپور دید"
  },
  {
    "poem_id": 1714,
    "vorder": 18,
    "position": 1,
    "text": "بیامد برو آفرین گسترید"
  },
  {
    "poem_id": 1714,
    "vorder": 19,
    "position": 0,
    "text": "که شادان بدی شاه و خندان بدی"
  },
  {
    "poem_id": 1714,
    "vorder": 20,
    "position": 1,
    "text": "همه ساله از بی‌گزندان بدی"
  },
  {
    "poem_id": 1714,
    "vorder": 21,
    "position": 0,
    "text": "کنون بی‌گمان تشنه باشد ستور"
  },
  {
    "poem_id": 1714,
    "vorder": 22,
    "position": 1,
    "text": "بدین ده رود اندرون آب شور"
  },
  {
    "poem_id": 1714,
    "vorder": 23,
    "position": 0,
    "text": "به چاه اندرون آب سردست و خوش"
  },
  {
    "poem_id": 1714,
    "vorder": 24,
    "position": 1,
    "text": "بفرمای تا من بوم آب‌کش"
  },
  {
    "poem_id": 1714,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت شاپور کای ماه‌روی"
  },
  {
    "poem_id": 1714,
    "vorder": 26,
    "position": 1,
    "text": "چرا رنجه گشتی بدین گفت‌وگوی"
  },
  {
    "poem_id": 1714,
    "vorder": 27,
    "position": 0,
    "text": "که باشند با من پرستنده مرد"
  },
  {
    "poem_id": 1714,
    "vorder": 28,
    "position": 1,
    "text": "کزین چاه بی‌بن کشند آب سرد"
  },
  {
    "poem_id": 1714,
    "vorder": 29,
    "position": 0,
    "text": "ز برنا کنیزک بپیچید روی"
  },
  {
    "poem_id": 1714,
    "vorder": 30,
    "position": 1,
    "text": "بشد دور و بنشست بر پیش جوی"
  },
  {
    "poem_id": 1714,
    "vorder": 31,
    "position": 0,
    "text": "پرستنده‌ای را بفرمود شاه"
  },
  {
    "poem_id": 1714,
    "vorder": 32,
    "position": 1,
    "text": "که دلو آور و آب برکش ز چاه"
  },
  {
    "poem_id": 1714,
    "vorder": 33,
    "position": 0,
    "text": "پرستنده بشنید و آمد دوان"
  },
  {
    "poem_id": 1714,
    "vorder": 34,
    "position": 1,
    "text": "رسن برد بر چرخ دلو گران"
  },
  {
    "poem_id": 1714,
    "vorder": 35,
    "position": 0,
    "text": "چو دلو گران‌سنگ پر آب گشت"
  },
  {
    "poem_id": 1714,
    "vorder": 36,
    "position": 1,
    "text": "پرستنده را روی پرتاب گشت"
  },
  {
    "poem_id": 1714,
    "vorder": 37,
    "position": 0,
    "text": "چو دلو گران برنیامد ز چاه"
  },
  {
    "poem_id": 1714,
    "vorder": 38,
    "position": 1,
    "text": "بیامد ژکان زود شاپور شاه"
  },
  {
    "poem_id": 1714,
    "vorder": 39,
    "position": 0,
    "text": "پرستنده را گفت کای نیم‌زن"
  },
  {
    "poem_id": 1714,
    "vorder": 40,
    "position": 1,
    "text": "نه زن داشت این دلو و چندین رسن"
  },
  {
    "poem_id": 1714,
    "vorder": 41,
    "position": 0,
    "text": "همی برکشید آب چندین ز چاه"
  },
  {
    "poem_id": 1714,
    "vorder": 42,
    "position": 1,
    "text": "تو گشتی پر از رنج و فریادخواه"
  },
  {
    "poem_id": 1714,
    "vorder": 43,
    "position": 0,
    "text": "بیامد رسن بستد از پیشکار"
  },
  {
    "poem_id": 1714,
    "vorder": 44,
    "position": 1,
    "text": "شد آن کار دشوار بر شاه خوار"
  },
  {
    "poem_id": 1714,
    "vorder": 45,
    "position": 0,
    "text": "ز دلو گران شاه چون رنج دید"
  },
  {
    "poem_id": 1714,
    "vorder": 46,
    "position": 1,
    "text": "بر آن خوب‌رخ آفرین گسترید"
  },
  {
    "poem_id": 1714,
    "vorder": 47,
    "position": 0,
    "text": "که برتافت دلوی برین سان گران"
  },
  {
    "poem_id": 1714,
    "vorder": 48,
    "position": 1,
    "text": "همانا که هست از نژاد سران"
  },
  {
    "poem_id": 1714,
    "vorder": 49,
    "position": 0,
    "text": "کنیزک چو او دلو را برکشید"
  },
  {
    "poem_id": 1714,
    "vorder": 50,
    "position": 1,
    "text": "بیامد به مهر آفرین گسترید"
  },
  {
    "poem_id": 1714,
    "vorder": 51,
    "position": 0,
    "text": "که نوشه بدی تا بود روزگار"
  },
  {
    "poem_id": 1714,
    "vorder": 52,
    "position": 1,
    "text": "همیشه خرد بادت آموزگار"
  },
  {
    "poem_id": 1714,
    "vorder": 53,
    "position": 0,
    "text": "به نیروی شاپور شاه اردشیر"
  },
  {
    "poem_id": 1714,
    "vorder": 54,
    "position": 1,
    "text": "شود بی‌گمان آب در چاه شیر"
  },
  {
    "poem_id": 1714,
    "vorder": 55,
    "position": 0,
    "text": "جوان گفت با دختر چرب‌گوی"
  },
  {
    "poem_id": 1714,
    "vorder": 56,
    "position": 1,
    "text": "چه دانی که شاپورم ای ماه‌روی"
  },
  {
    "poem_id": 1714,
    "vorder": 57,
    "position": 0,
    "text": "چنین داد پاسخ که این داستان"
  },
  {
    "poem_id": 1714,
    "vorder": 58,
    "position": 1,
    "text": "شنیدم بسی از لب راستان"
  },
  {
    "poem_id": 1714,
    "vorder": 59,
    "position": 0,
    "text": "که شاپور گردست با زور پیل"
  },
  {
    "poem_id": 1714,
    "vorder": 60,
    "position": 1,
    "text": "به بخشندگی همچو دریای نیل"
  },
  {
    "poem_id": 1714,
    "vorder": 61,
    "position": 0,
    "text": "به بالای سروست و رویین‌تنست"
  },
  {
    "poem_id": 1714,
    "vorder": 62,
    "position": 1,
    "text": "به هرچیز مانندهٔ بهمنست"
  },
  {
    "poem_id": 1714,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت شاپور کای ماه‌روی"
  },
  {
    "poem_id": 1714,
    "vorder": 64,
    "position": 1,
    "text": "سخن هرچ پرسم ترا راست‌گوی"
  },
  {
    "poem_id": 1714,
    "vorder": 65,
    "position": 0,
    "text": "پدیدار کن تا نژاد تو چیست"
  },
  {
    "poem_id": 1714,
    "vorder": 66,
    "position": 1,
    "text": "برین چهرهٔ تو نشان کییست"
  },
  {
    "poem_id": 1714,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت من دختر مهترم"
  },
  {
    "poem_id": 1714,
    "vorder": 68,
    "position": 1,
    "text": "ازیرا چنین خوب و کنداورم"
  },
  {
    "poem_id": 1714,
    "vorder": 69,
    "position": 0,
    "text": "چنین داد پاسخ که هرگز دروغ"
  },
  {
    "poem_id": 1714,
    "vorder": 70,
    "position": 1,
    "text": "بر شهریاران نگیرد فروغ"
  },
  {
    "poem_id": 1714,
    "vorder": 71,
    "position": 0,
    "text": "کشاورز را دختر ماه‌روی"
  },
  {
    "poem_id": 1714,
    "vorder": 72,
    "position": 1,
    "text": "نباشد بدین روی و این رنگ و بوی"
  },
  {
    "poem_id": 1714,
    "vorder": 73,
    "position": 0,
    "text": "کنیزک بدو گفت کای شهریار"
  },
  {
    "poem_id": 1714,
    "vorder": 74,
    "position": 1,
    "text": "هرانگه که یابم به جان زینهار"
  },
  {
    "poem_id": 1714,
    "vorder": 75,
    "position": 0,
    "text": "بگویم همه پیش تو من نژاد"
  },
  {
    "poem_id": 1714,
    "vorder": 76,
    "position": 1,
    "text": "چو یابم ز خشم شهنشاه داد"
  },
  {
    "poem_id": 1714,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت شاپور کز بوستان"
  },
  {
    "poem_id": 1714,
    "vorder": 78,
    "position": 1,
    "text": "نرست از چمن کینهٔ دوستان"
  },
  {
    "poem_id": 1714,
    "vorder": 79,
    "position": 0,
    "text": "بگوی و ز من بیم در دل مدار"
  },
  {
    "poem_id": 1714,
    "vorder": 80,
    "position": 1,
    "text": "نه از نامور دادگر شهریار"
  },
  {
    "poem_id": 1714,
    "vorder": 81,
    "position": 0,
    "text": "کنیزک بدو گفت کز راه داد"
  },
  {
    "poem_id": 1714,
    "vorder": 82,
    "position": 1,
    "text": "منم دختر مهرک نوش‌زاد"
  },
  {
    "poem_id": 1714,
    "vorder": 83,
    "position": 0,
    "text": "مرا پارسایی بیاورد خرد"
  },
  {
    "poem_id": 1714,
    "vorder": 84,
    "position": 1,
    "text": "بدین پرهنر مهتر ده سپرد"
  },
  {
    "poem_id": 1714,
    "vorder": 85,
    "position": 0,
    "text": "من از بیم آن نامور شهریار"
  },
  {
    "poem_id": 1714,
    "vorder": 86,
    "position": 1,
    "text": "چنین آبکش گشتم و پیشکار"
  },
  {
    "poem_id": 1714,
    "vorder": 87,
    "position": 0,
    "text": "بیامد بپردخت شاپور جای"
  },
  {
    "poem_id": 1714,
    "vorder": 88,
    "position": 1,
    "text": "همی بود مهتر به پیشش به پای"
  },
  {
    "poem_id": 1714,
    "vorder": 89,
    "position": 0,
    "text": "به دو گفت کین دختر خوب‌چهر"
  },
  {
    "poem_id": 1714,
    "vorder": 90,
    "position": 1,
    "text": "به من ده بر من گوا کن سپهر"
  },
  {
    "poem_id": 1714,
    "vorder": 91,
    "position": 0,
    "text": "بدو داد مهتر به فرمان اوی"
  },
  {
    "poem_id": 1714,
    "vorder": 92,
    "position": 1,
    "text": "بر آیین آتش‌پرستان اوی"
  }
]