[
  {
    "poem_id": 1566,
    "vorder": 1,
    "position": 0,
    "text": "از آن پس بفرمود تا گرگسار"
  },
  {
    "poem_id": 1566,
    "vorder": 2,
    "position": 1,
    "text": "بیامد بر نامور شهریار"
  },
  {
    "poem_id": 1566,
    "vorder": 3,
    "position": 0,
    "text": "بدادش سه جام دمادم نبید"
  },
  {
    "poem_id": 1566,
    "vorder": 4,
    "position": 1,
    "text": "می سرخ و جام از گل شنبلید"
  },
  {
    "poem_id": 1566,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کای بد تن بدنهان"
  },
  {
    "poem_id": 1566,
    "vorder": 6,
    "position": 1,
    "text": "نگه کن بدین کردگار جهان"
  },
  {
    "poem_id": 1566,
    "vorder": 7,
    "position": 0,
    "text": "نه سیمرغ پیدا نه شیر و نه گرگ"
  },
  {
    "poem_id": 1566,
    "vorder": 8,
    "position": 1,
    "text": "نه آن تیز چنگ اژدهای بزرگ"
  },
  {
    "poem_id": 1566,
    "vorder": 9,
    "position": 0,
    "text": "به منزل که انگیزد این بار شور"
  },
  {
    "poem_id": 1566,
    "vorder": 10,
    "position": 1,
    "text": "بود آب و جای گیای ستور"
  },
  {
    "poem_id": 1566,
    "vorder": 11,
    "position": 0,
    "text": "به آواز گفت آن زمان گرگسار"
  },
  {
    "poem_id": 1566,
    "vorder": 12,
    "position": 1,
    "text": "که ای نامور فرخ اسفندیار"
  },
  {
    "poem_id": 1566,
    "vorder": 13,
    "position": 0,
    "text": "اگر باز گردی نباشد شگفت"
  },
  {
    "poem_id": 1566,
    "vorder": 14,
    "position": 1,
    "text": "ز بخت تو اندازه باید گرفت"
  },
  {
    "poem_id": 1566,
    "vorder": 15,
    "position": 0,
    "text": "ترا یار بود ایزد ای نیکبخت"
  },
  {
    "poem_id": 1566,
    "vorder": 16,
    "position": 1,
    "text": "به بار آمد آن خسروانی درخت"
  },
  {
    "poem_id": 1566,
    "vorder": 17,
    "position": 0,
    "text": "یکی کار پیش است فردا که مرد"
  },
  {
    "poem_id": 1566,
    "vorder": 18,
    "position": 1,
    "text": "نیندیشد از روزگار نبرد"
  },
  {
    "poem_id": 1566,
    "vorder": 19,
    "position": 0,
    "text": "نه گرز و کمان یادت آید نه تیغ"
  },
  {
    "poem_id": 1566,
    "vorder": 20,
    "position": 1,
    "text": "نه بیند ره جنگ و راه گریغ"
  },
  {
    "poem_id": 1566,
    "vorder": 21,
    "position": 0,
    "text": "به بالای یک نیزه برف آیدت"
  },
  {
    "poem_id": 1566,
    "vorder": 22,
    "position": 1,
    "text": "بدو روز شادی شگرف آیدت"
  },
  {
    "poem_id": 1566,
    "vorder": 23,
    "position": 0,
    "text": "بمانی تو با لشکر نامدار"
  },
  {
    "poem_id": 1566,
    "vorder": 24,
    "position": 1,
    "text": "به برف اندر ای فرخ اسفندیار"
  },
  {
    "poem_id": 1566,
    "vorder": 25,
    "position": 0,
    "text": "اگر بازگردی نباشد شگفت"
  },
  {
    "poem_id": 1566,
    "vorder": 26,
    "position": 1,
    "text": "ز گفتار من کین نباید گرفت"
  },
  {
    "poem_id": 1566,
    "vorder": 27,
    "position": 0,
    "text": "همی ویژه در خون لشکر شوی"
  },
  {
    "poem_id": 1566,
    "vorder": 28,
    "position": 1,
    "text": "به تندی و بدرایی و بدخوی"
  },
  {
    "poem_id": 1566,
    "vorder": 29,
    "position": 0,
    "text": "مرا این درستست کز باد سخت"
  },
  {
    "poem_id": 1566,
    "vorder": 30,
    "position": 1,
    "text": "بریزد بر آن مرز بار درخت"
  },
  {
    "poem_id": 1566,
    "vorder": 31,
    "position": 0,
    "text": "از آن پس که اندر بیابان رسی"
  },
  {
    "poem_id": 1566,
    "vorder": 32,
    "position": 1,
    "text": "یکی منزل آید به فرسنگ سی"
  },
  {
    "poem_id": 1566,
    "vorder": 33,
    "position": 0,
    "text": "همه ریگ تفته است گر خاک و شخ"
  },
  {
    "poem_id": 1566,
    "vorder": 34,
    "position": 1,
    "text": "بر او نگذرد مرغ و مور و ملخ"
  },
  {
    "poem_id": 1566,
    "vorder": 35,
    "position": 0,
    "text": "نبینی به جایی یکی قطره آب"
  },
  {
    "poem_id": 1566,
    "vorder": 36,
    "position": 1,
    "text": "زمینش همی جوشد از آفتاب"
  },
  {
    "poem_id": 1566,
    "vorder": 37,
    "position": 0,
    "text": "نه بر خاک او شیر یابد گذر"
  },
  {
    "poem_id": 1566,
    "vorder": 38,
    "position": 1,
    "text": "نه اندر هوا کرگس تیزپر"
  },
  {
    "poem_id": 1566,
    "vorder": 39,
    "position": 0,
    "text": "نه بر شخ و ریگش بروید گیا"
  },
  {
    "poem_id": 1566,
    "vorder": 40,
    "position": 1,
    "text": "زمینش روان ریگ چون توتیا"
  },
  {
    "poem_id": 1566,
    "vorder": 41,
    "position": 0,
    "text": "برانی بر این گونه فرسنگ چل"
  },
  {
    "poem_id": 1566,
    "vorder": 42,
    "position": 1,
    "text": "نه با اسپ تاو و نه با مرد دل"
  },
  {
    "poem_id": 1566,
    "vorder": 43,
    "position": 0,
    "text": "وز آنجا به رویین‌دژ آید سپاه"
  },
  {
    "poem_id": 1566,
    "vorder": 44,
    "position": 1,
    "text": "ببینی یک مایه‌ور جایگاه"
  },
  {
    "poem_id": 1566,
    "vorder": 45,
    "position": 0,
    "text": "زمینش به کام نیاز اندر است"
  },
  {
    "poem_id": 1566,
    "vorder": 46,
    "position": 1,
    "text": "وگر باره با مه به راز اندر است"
  },
  {
    "poem_id": 1566,
    "vorder": 47,
    "position": 0,
    "text": "بشد بامش از ابر بارنده‌تر"
  },
  {
    "poem_id": 1566,
    "vorder": 48,
    "position": 1,
    "text": "که بد نامش از ابر برنده‌تر"
  },
  {
    "poem_id": 1566,
    "vorder": 49,
    "position": 0,
    "text": "ز بیرون نیابد خورش چارپای"
  },
  {
    "poem_id": 1566,
    "vorder": 50,
    "position": 1,
    "text": "ز لشکر نماند سواری به جای"
  },
  {
    "poem_id": 1566,
    "vorder": 51,
    "position": 0,
    "text": "از ایران و توران اگر صدهزار"
  },
  {
    "poem_id": 1566,
    "vorder": 52,
    "position": 1,
    "text": "بیایند گردان خنجرگزار"
  },
  {
    "poem_id": 1566,
    "vorder": 53,
    "position": 0,
    "text": "نشینند صد سال گرد اندرش"
  },
  {
    "poem_id": 1566,
    "vorder": 54,
    "position": 1,
    "text": "همی تیرباران کنند از برش"
  },
  {
    "poem_id": 1566,
    "vorder": 55,
    "position": 0,
    "text": "فراوان همانست و کمتر همان"
  },
  {
    "poem_id": 1566,
    "vorder": 56,
    "position": 1,
    "text": "چو حلقه‌ست بر در بد بدگمان"
  },
  {
    "poem_id": 1566,
    "vorder": 57,
    "position": 0,
    "text": "چو ایرانیان این بد از گرگسار"
  },
  {
    "poem_id": 1566,
    "vorder": 58,
    "position": 1,
    "text": "شنیدند و گشتند با درد یار"
  },
  {
    "poem_id": 1566,
    "vorder": 59,
    "position": 0,
    "text": "بگفتند کای شاه آزادمرد"
  },
  {
    "poem_id": 1566,
    "vorder": 60,
    "position": 1,
    "text": "به گرد بلا تا توانی مگرد"
  },
  {
    "poem_id": 1566,
    "vorder": 61,
    "position": 0,
    "text": "اگر گرگسار این سخنها که گفت"
  },
  {
    "poem_id": 1566,
    "vorder": 62,
    "position": 1,
    "text": "چنین است این خود نماند نهفت"
  },
  {
    "poem_id": 1566,
    "vorder": 63,
    "position": 0,
    "text": "بدین جایگه مرگ را آمدیم"
  },
  {
    "poem_id": 1566,
    "vorder": 64,
    "position": 1,
    "text": "نه فرسودن ترگ را آمدیم"
  },
  {
    "poem_id": 1566,
    "vorder": 65,
    "position": 0,
    "text": "چنین راه دشوار بگذاشتی"
  },
  {
    "poem_id": 1566,
    "vorder": 66,
    "position": 1,
    "text": "بلای دد و دام برداشتی"
  },
  {
    "poem_id": 1566,
    "vorder": 67,
    "position": 0,
    "text": "کس از نامداران و شاهان گرد"
  },
  {
    "poem_id": 1566,
    "vorder": 68,
    "position": 1,
    "text": "چنین رنجها برنیارد شمرد"
  },
  {
    "poem_id": 1566,
    "vorder": 69,
    "position": 0,
    "text": "که پیش تو آمد بدین هفتخوان"
  },
  {
    "poem_id": 1566,
    "vorder": 70,
    "position": 1,
    "text": "بر این بر جهان آفرین را بخوان"
  },
  {
    "poem_id": 1566,
    "vorder": 71,
    "position": 0,
    "text": "چو پیروزگر بازگردی به راه"
  },
  {
    "poem_id": 1566,
    "vorder": 72,
    "position": 1,
    "text": "به دل شاد و خرم شوی نزد شاه"
  },
  {
    "poem_id": 1566,
    "vorder": 73,
    "position": 0,
    "text": "به راهی دگر گر شوی کینه‌ساز"
  },
  {
    "poem_id": 1566,
    "vorder": 74,
    "position": 1,
    "text": "همه شهر توران برندت نماز"
  },
  {
    "poem_id": 1566,
    "vorder": 75,
    "position": 0,
    "text": "بدین سان که گوید همی گرگسار"
  },
  {
    "poem_id": 1566,
    "vorder": 76,
    "position": 1,
    "text": "تن خویش را خوارمایه مدار"
  },
  {
    "poem_id": 1566,
    "vorder": 77,
    "position": 0,
    "text": "از آن پس که پیروز گشتیم و شاد"
  },
  {
    "poem_id": 1566,
    "vorder": 78,
    "position": 1,
    "text": "نباید سر خویش دادن به باد"
  },
  {
    "poem_id": 1566,
    "vorder": 79,
    "position": 0,
    "text": "چو بشنید این‌گونه ز ایشان سخن"
  },
  {
    "poem_id": 1566,
    "vorder": 80,
    "position": 1,
    "text": "شد آن تازه رویش ز گردان کهن"
  },
  {
    "poem_id": 1566,
    "vorder": 81,
    "position": 0,
    "text": "شما گفت از ایران به پند آمدید"
  },
  {
    "poem_id": 1566,
    "vorder": 82,
    "position": 1,
    "text": "نه از بهر نام بلند آمدید"
  },
  {
    "poem_id": 1566,
    "vorder": 83,
    "position": 0,
    "text": "کجا آن همه خلعت و پند شاه"
  },
  {
    "poem_id": 1566,
    "vorder": 84,
    "position": 1,
    "text": "کمرهای زرین و تخت و کلاه"
  },
  {
    "poem_id": 1566,
    "vorder": 85,
    "position": 0,
    "text": "کجا آن همه عهد و سوگند و بند"
  },
  {
    "poem_id": 1566,
    "vorder": 86,
    "position": 1,
    "text": "به یزدان و آن اختر سودمند"
  },
  {
    "poem_id": 1566,
    "vorder": 87,
    "position": 0,
    "text": "که اکنون چنین سست شد پایتان"
  },
  {
    "poem_id": 1566,
    "vorder": 88,
    "position": 1,
    "text": "به ره بر پراگنده شد رایتان"
  },
  {
    "poem_id": 1566,
    "vorder": 89,
    "position": 0,
    "text": "شما بازگردید پیروز و شاد"
  },
  {
    "poem_id": 1566,
    "vorder": 90,
    "position": 1,
    "text": "مرا کام جز رزم جستن مباد"
  },
  {
    "poem_id": 1566,
    "vorder": 91,
    "position": 0,
    "text": "به گفتار این دیو ناسازگار"
  },
  {
    "poem_id": 1566,
    "vorder": 92,
    "position": 1,
    "text": "چنین سرکشیدید از کارزار"
  },
  {
    "poem_id": 1566,
    "vorder": 93,
    "position": 0,
    "text": "از ایران نخواهم بر این رزم کس"
  },
  {
    "poem_id": 1566,
    "vorder": 94,
    "position": 1,
    "text": "پسر با برادر مرا یار بس"
  },
  {
    "poem_id": 1566,
    "vorder": 95,
    "position": 0,
    "text": "جهاندار پیروز یار منست"
  },
  {
    "poem_id": 1566,
    "vorder": 96,
    "position": 1,
    "text": "سر اختر اندر کنار منست"
  },
  {
    "poem_id": 1566,
    "vorder": 97,
    "position": 0,
    "text": "به مردی نباید کسی همرهم"
  },
  {
    "poem_id": 1566,
    "vorder": 98,
    "position": 1,
    "text": "اگر جان ستانم وگر جان دهم"
  },
  {
    "poem_id": 1566,
    "vorder": 99,
    "position": 0,
    "text": "به دشمن نمایم هنر هرچه هست"
  },
  {
    "poem_id": 1566,
    "vorder": 100,
    "position": 1,
    "text": "ز مردی و پیروزی و زور دست"
  },
  {
    "poem_id": 1566,
    "vorder": 101,
    "position": 0,
    "text": "بیابید هم بی‌گمان آگهی"
  },
  {
    "poem_id": 1566,
    "vorder": 102,
    "position": 1,
    "text": "از این نامور فر شاهنشهی"
  },
  {
    "poem_id": 1566,
    "vorder": 103,
    "position": 0,
    "text": "که با دژ چه کردم به دستان و زور"
  },
  {
    "poem_id": 1566,
    "vorder": 104,
    "position": 1,
    "text": "به نام خداوند کیوان و هور"
  },
  {
    "poem_id": 1566,
    "vorder": 105,
    "position": 0,
    "text": "چو ایرانیان برگشادند چشم"
  },
  {
    "poem_id": 1566,
    "vorder": 106,
    "position": 1,
    "text": "بدیدند چهر ورا پر ز خشم"
  },
  {
    "poem_id": 1566,
    "vorder": 107,
    "position": 0,
    "text": "برفتند پوزش‌کنان نزد شاه"
  },
  {
    "poem_id": 1566,
    "vorder": 108,
    "position": 1,
    "text": "که گر شاه بیند ببخشد گناه"
  },
  {
    "poem_id": 1566,
    "vorder": 109,
    "position": 0,
    "text": "فدای تو بادا تن و جان ما"
  },
  {
    "poem_id": 1566,
    "vorder": 110,
    "position": 1,
    "text": "بر این بود تا بود پیمان ما"
  },
  {
    "poem_id": 1566,
    "vorder": 111,
    "position": 0,
    "text": "ز بهر تن شاه غمخواره‌ایم"
  },
  {
    "poem_id": 1566,
    "vorder": 112,
    "position": 1,
    "text": "نه از کوشش و جنگ بیچاره‌ایم"
  },
  {
    "poem_id": 1566,
    "vorder": 113,
    "position": 0,
    "text": "ز ما تا بود زنده یک نامدار"
  },
  {
    "poem_id": 1566,
    "vorder": 114,
    "position": 1,
    "text": "نپیچیم یک تن سر از کارزار"
  },
  {
    "poem_id": 1566,
    "vorder": 115,
    "position": 0,
    "text": "سپهبد چو بشنید ز ایشان سخن"
  },
  {
    "poem_id": 1566,
    "vorder": 116,
    "position": 1,
    "text": "بپیچید زان گفته های کهن"
  },
  {
    "poem_id": 1566,
    "vorder": 117,
    "position": 0,
    "text": "به ایرانیان آفرین کرد و گفت"
  },
  {
    "poem_id": 1566,
    "vorder": 118,
    "position": 1,
    "text": "که هرگز نماند هنر در نهفت"
  },
  {
    "poem_id": 1566,
    "vorder": 119,
    "position": 0,
    "text": "گر ایدون که گردیم پیروزگر"
  },
  {
    "poem_id": 1566,
    "vorder": 120,
    "position": 1,
    "text": "ز رنج گذشته بیابیم بر"
  },
  {
    "poem_id": 1566,
    "vorder": 121,
    "position": 0,
    "text": "نگردد فرامش به دل رنجتان"
  },
  {
    "poem_id": 1566,
    "vorder": 122,
    "position": 1,
    "text": "نماند تهی بی‌گمان گنجتان"
  },
  {
    "poem_id": 1566,
    "vorder": 123,
    "position": 0,
    "text": "همی رای زد تا جهان شد خنک"
  },
  {
    "poem_id": 1566,
    "vorder": 124,
    "position": 1,
    "text": "برفت از بر کوه باد سبک"
  },
  {
    "poem_id": 1566,
    "vorder": 125,
    "position": 0,
    "text": "برآمد ز درگاه شیپور و نای"
  },
  {
    "poem_id": 1566,
    "vorder": 126,
    "position": 1,
    "text": "سپه برگرفتند یکسر ز جای"
  },
  {
    "poem_id": 1566,
    "vorder": 127,
    "position": 0,
    "text": "به کردار آتش همی راندند"
  },
  {
    "poem_id": 1566,
    "vorder": 128,
    "position": 1,
    "text": "جهان‌آفرین را بسی خواندند"
  },
  {
    "poem_id": 1566,
    "vorder": 129,
    "position": 0,
    "text": "سپیده چو از کوه سر برکشید"
  },
  {
    "poem_id": 1566,
    "vorder": 130,
    "position": 1,
    "text": "شب آن چادر شعر در سرکشید"
  },
  {
    "poem_id": 1566,
    "vorder": 131,
    "position": 0,
    "text": "چو خورشید تابان نهان کرد روی"
  },
  {
    "poem_id": 1566,
    "vorder": 132,
    "position": 1,
    "text": "همی رفت خون در پس پشت اوی"
  },
  {
    "poem_id": 1566,
    "vorder": 133,
    "position": 0,
    "text": "به منزل رسید آن سپاه گران"
  },
  {
    "poem_id": 1566,
    "vorder": 134,
    "position": 1,
    "text": "همه گرزداران و نیزه‌وران"
  },
  {
    "poem_id": 1566,
    "vorder": 135,
    "position": 0,
    "text": "بهاری یکی خوش‌منش روز بود"
  },
  {
    "poem_id": 1566,
    "vorder": 136,
    "position": 1,
    "text": "دل‌افروز یا گیتی‌افروز بود"
  },
  {
    "poem_id": 1566,
    "vorder": 137,
    "position": 0,
    "text": "سراپرده و خیمه فرمود کی"
  },
  {
    "poem_id": 1566,
    "vorder": 138,
    "position": 1,
    "text": "بیاراست خوان و بیاورد می"
  },
  {
    "poem_id": 1566,
    "vorder": 139,
    "position": 0,
    "text": "هم‌اندر زمان تندبادی ز کوه"
  },
  {
    "poem_id": 1566,
    "vorder": 140,
    "position": 1,
    "text": "برآمد که شد نامور زان ستوه"
  },
  {
    "poem_id": 1566,
    "vorder": 141,
    "position": 0,
    "text": "جهان سربسر گشت چون پر زاغ"
  },
  {
    "poem_id": 1566,
    "vorder": 142,
    "position": 1,
    "text": "ندانست کس باز هامون ز زاغ"
  },
  {
    "poem_id": 1566,
    "vorder": 143,
    "position": 0,
    "text": "بیارید از ابر تاریک برف"
  },
  {
    "poem_id": 1566,
    "vorder": 144,
    "position": 1,
    "text": "زمینی پر از برف و بادی شگرف"
  },
  {
    "poem_id": 1566,
    "vorder": 145,
    "position": 0,
    "text": "سه روز و سه شب هم بدان سان به دشت"
  },
  {
    "poem_id": 1566,
    "vorder": 146,
    "position": 1,
    "text": "دم باد ز اندازه اندر گذشت"
  },
  {
    "poem_id": 1566,
    "vorder": 147,
    "position": 0,
    "text": "هوا پود گشت ابر چون تار شد"
  },
  {
    "poem_id": 1566,
    "vorder": 148,
    "position": 1,
    "text": "سپهبد از آن کار بیچار شد"
  },
  {
    "poem_id": 1566,
    "vorder": 149,
    "position": 0,
    "text": "به آواز پیش پشوتن بگفت"
  },
  {
    "poem_id": 1566,
    "vorder": 150,
    "position": 1,
    "text": "که این کار ما گشت با درد جفت"
  },
  {
    "poem_id": 1566,
    "vorder": 151,
    "position": 0,
    "text": "به مردی شدم در دم اژدها"
  },
  {
    "poem_id": 1566,
    "vorder": 152,
    "position": 1,
    "text": "کنون زور کردن نیارد بها"
  },
  {
    "poem_id": 1566,
    "vorder": 153,
    "position": 0,
    "text": "همه پیش یزدان نیایش کنید"
  },
  {
    "poem_id": 1566,
    "vorder": 154,
    "position": 1,
    "text": "بخوانید و او را ستایش کنید"
  },
  {
    "poem_id": 1566,
    "vorder": 155,
    "position": 0,
    "text": "مگر کاین بلاها ز ما بگذرد"
  },
  {
    "poem_id": 1566,
    "vorder": 156,
    "position": 1,
    "text": "کز این پس کسی مان به کس نشمرد"
  },
  {
    "poem_id": 1566,
    "vorder": 157,
    "position": 0,
    "text": "پشوتن بیامد به پیش خدای"
  },
  {
    "poem_id": 1566,
    "vorder": 158,
    "position": 1,
    "text": "که او بود بر نیکویی رهنمای"
  },
  {
    "poem_id": 1566,
    "vorder": 159,
    "position": 0,
    "text": "نیایش ز اندازه بگذاشتند"
  },
  {
    "poem_id": 1566,
    "vorder": 160,
    "position": 1,
    "text": "همه در زمان دست برداشتند"
  },
  {
    "poem_id": 1566,
    "vorder": 161,
    "position": 0,
    "text": "همانگه بیامد یکی باد خوش"
  },
  {
    "poem_id": 1566,
    "vorder": 162,
    "position": 1,
    "text": "ببرد ابر و روی هوا گشت کش"
  },
  {
    "poem_id": 1566,
    "vorder": 163,
    "position": 0,
    "text": "چو ایرانیان را دل آمد به جای"
  },
  {
    "poem_id": 1566,
    "vorder": 164,
    "position": 1,
    "text": "ببودند بر پیش یزدان به پای"
  },
  {
    "poem_id": 1566,
    "vorder": 165,
    "position": 0,
    "text": "سراپرده و خیمه‌ها گشته تر"
  },
  {
    "poem_id": 1566,
    "vorder": 166,
    "position": 1,
    "text": "ز سرما کسی را نبد پای و پر"
  },
  {
    "poem_id": 1566,
    "vorder": 167,
    "position": 0,
    "text": "همانجا ببودند گردان سه روز"
  },
  {
    "poem_id": 1566,
    "vorder": 168,
    "position": 1,
    "text": "چهارم چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 1566,
    "vorder": 169,
    "position": 0,
    "text": "سپهبد گرانمایگان را بخواند"
  },
  {
    "poem_id": 1566,
    "vorder": 170,
    "position": 1,
    "text": "بسی داستانهای نیکو براند"
  },
  {
    "poem_id": 1566,
    "vorder": 171,
    "position": 0,
    "text": "چنین گفت کایدر بمانید بار"
  },
  {
    "poem_id": 1566,
    "vorder": 172,
    "position": 1,
    "text": "مدارید جز آلت کارزار"
  },
  {
    "poem_id": 1566,
    "vorder": 173,
    "position": 0,
    "text": "هرانکس که هستند سرهنگ‌فش"
  },
  {
    "poem_id": 1566,
    "vorder": 174,
    "position": 1,
    "text": "که باشد ورا باره صد آب کش"
  },
  {
    "poem_id": 1566,
    "vorder": 175,
    "position": 0,
    "text": "به پنجاه آب و خورش برنهید"
  },
  {
    "poem_id": 1566,
    "vorder": 176,
    "position": 1,
    "text": "دگر آلت گسترش بر نهید"
  },
  {
    "poem_id": 1566,
    "vorder": 177,
    "position": 0,
    "text": "فزونی هم ایدر بمانید بار"
  },
  {
    "poem_id": 1566,
    "vorder": 178,
    "position": 1,
    "text": "مگر آنچه باید بدان کارزار"
  },
  {
    "poem_id": 1566,
    "vorder": 179,
    "position": 0,
    "text": "به نیروی یزدان بیابیم دست"
  },
  {
    "poem_id": 1566,
    "vorder": 180,
    "position": 1,
    "text": "بدان بدکنش مردم بت‌پرست"
  },
  {
    "poem_id": 1566,
    "vorder": 181,
    "position": 0,
    "text": "چو نومید گردد ز یزدان کسی"
  },
  {
    "poem_id": 1566,
    "vorder": 182,
    "position": 1,
    "text": "از او نیک‌بختی نیاید بسی"
  },
  {
    "poem_id": 1566,
    "vorder": 183,
    "position": 0,
    "text": "از آن دژ یکایک توانگر شوید"
  },
  {
    "poem_id": 1566,
    "vorder": 184,
    "position": 1,
    "text": "همه پاک با گنج و افسر شوید"
  },
  {
    "poem_id": 1566,
    "vorder": 185,
    "position": 0,
    "text": "چو خور چادر زرد بر سرکشید"
  },
  {
    "poem_id": 1566,
    "vorder": 186,
    "position": 1,
    "text": "ببد باختر چون گل شنبلید"
  },
  {
    "poem_id": 1566,
    "vorder": 187,
    "position": 0,
    "text": "بنه برنهادند گردان همه"
  },
  {
    "poem_id": 1566,
    "vorder": 188,
    "position": 1,
    "text": "برفتند با شهریار رمه"
  },
  {
    "poem_id": 1566,
    "vorder": 189,
    "position": 0,
    "text": "چو بگذشت از تیره شب یک زمان"
  },
  {
    "poem_id": 1566,
    "vorder": 190,
    "position": 1,
    "text": "خروش کلنگ آمد از آسمان"
  },
  {
    "poem_id": 1566,
    "vorder": 191,
    "position": 0,
    "text": "برآشفت ز آوازش اسفندیار"
  },
  {
    "poem_id": 1566,
    "vorder": 192,
    "position": 1,
    "text": "پیامی فرستاد زی گرگسار"
  },
  {
    "poem_id": 1566,
    "vorder": 193,
    "position": 0,
    "text": "که گفتی بدین منزلت آب نیست"
  },
  {
    "poem_id": 1566,
    "vorder": 194,
    "position": 1,
    "text": "همان جای آرامش و خواب نیست"
  },
  {
    "poem_id": 1566,
    "vorder": 195,
    "position": 0,
    "text": "کنون ز آسمان خاست بانگ کلنگ"
  },
  {
    "poem_id": 1566,
    "vorder": 196,
    "position": 1,
    "text": "دل ما چرا کردی از آب تنگ"
  },
  {
    "poem_id": 1566,
    "vorder": 197,
    "position": 0,
    "text": "چنین داد پاسخ کز ایدر ستور"
  },
  {
    "poem_id": 1566,
    "vorder": 198,
    "position": 1,
    "text": "نیابد مگر چشمهٔ آب شور"
  },
  {
    "poem_id": 1566,
    "vorder": 199,
    "position": 0,
    "text": "دگر چشمهٔ آب‌یابی چو زهر"
  },
  {
    "poem_id": 1566,
    "vorder": 200,
    "position": 1,
    "text": "کزان آب مرغ و ددان راست بهر"
  },
  {
    "poem_id": 1566,
    "vorder": 201,
    "position": 0,
    "text": "چنین گفت سالار کز گرگسار"
  },
  {
    "poem_id": 1566,
    "vorder": 202,
    "position": 1,
    "text": "یکی راهبر ساختم کینه‌دار"
  },
  {
    "poem_id": 1566,
    "vorder": 203,
    "position": 0,
    "text": "ز گفتار او تیز لشکر براند"
  },
  {
    "poem_id": 1566,
    "vorder": 204,
    "position": 1,
    "text": "جهاندار نیکی دهش را بخواند"
  }
]