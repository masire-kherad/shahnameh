[
  {
    "poem_id": 1474,
    "vorder": 1,
    "position": 0,
    "text": "برفتند و روی هوا تیره گشت"
  },
  {
    "poem_id": 1474,
    "vorder": 2,
    "position": 1,
    "text": "ز سهراب گردون همی خیره گشت"
  },
  {
    "poem_id": 1474,
    "vorder": 3,
    "position": 0,
    "text": "تو گفتی ز جنگش سرشت آسمان"
  },
  {
    "poem_id": 1474,
    "vorder": 4,
    "position": 1,
    "text": "نیارامد از تاختن یک زمان"
  },
  {
    "poem_id": 1474,
    "vorder": 5,
    "position": 0,
    "text": "وگر باره زیر اندرش آهنست"
  },
  {
    "poem_id": 1474,
    "vorder": 6,
    "position": 1,
    "text": "شگفتی روانست و رویین تنست"
  },
  {
    "poem_id": 1474,
    "vorder": 7,
    "position": 0,
    "text": "شب تیره آمد سوی لشکرش"
  },
  {
    "poem_id": 1474,
    "vorder": 8,
    "position": 1,
    "text": "میان سوده از جنگ و از خنجرش"
  },
  {
    "poem_id": 1474,
    "vorder": 9,
    "position": 0,
    "text": "به هومان چنین گفت کامروز هور"
  },
  {
    "poem_id": 1474,
    "vorder": 10,
    "position": 1,
    "text": "برآمد جهان کرد پر چنگ و شور"
  },
  {
    "poem_id": 1474,
    "vorder": 11,
    "position": 0,
    "text": "شما را چه کرد آن سوار دلیر"
  },
  {
    "poem_id": 1474,
    "vorder": 12,
    "position": 1,
    "text": "که یال یلان داشت و آهنگ شیر"
  },
  {
    "poem_id": 1474,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت هومان که فرمان شاه"
  },
  {
    "poem_id": 1474,
    "vorder": 14,
    "position": 1,
    "text": "چنان بد کز ایدر نجنبد سپاه"
  },
  {
    "poem_id": 1474,
    "vorder": 15,
    "position": 0,
    "text": "همه کار ماسخت ناساز بود"
  },
  {
    "poem_id": 1474,
    "vorder": 16,
    "position": 1,
    "text": "به آورد گشتن چه آغاز بود"
  },
  {
    "poem_id": 1474,
    "vorder": 17,
    "position": 0,
    "text": "بیامی یکی مرد پرخاشجوی"
  },
  {
    "poem_id": 1474,
    "vorder": 18,
    "position": 1,
    "text": "برین لشکر گشن بنهاد روی"
  },
  {
    "poem_id": 1474,
    "vorder": 19,
    "position": 0,
    "text": "تو گفتی ز مستی کنون خاستست"
  },
  {
    "poem_id": 1474,
    "vorder": 20,
    "position": 1,
    "text": "وگر جنگ بایک تن آراستست"
  },
  {
    "poem_id": 1474,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت سهراب کاو زین سپاه"
  },
  {
    "poem_id": 1474,
    "vorder": 22,
    "position": 1,
    "text": "نکرد از دلیران کسی را تباه"
  },
  {
    "poem_id": 1474,
    "vorder": 23,
    "position": 0,
    "text": "از ایرانیان من بسی کشته‌ام"
  },
  {
    "poem_id": 1474,
    "vorder": 24,
    "position": 1,
    "text": "زمین را به خون و گل آغشته‌ام"
  },
  {
    "poem_id": 1474,
    "vorder": 25,
    "position": 0,
    "text": "کنون خوان همی باید آراستن"
  },
  {
    "poem_id": 1474,
    "vorder": 26,
    "position": 1,
    "text": "بباید به می غم ز دل کاستن"
  },
  {
    "poem_id": 1474,
    "vorder": 27,
    "position": 0,
    "text": "وزان روی رستم سپه را بدید"
  },
  {
    "poem_id": 1474,
    "vorder": 28,
    "position": 1,
    "text": "سخن راند با گیو و گفت و شنید"
  },
  {
    "poem_id": 1474,
    "vorder": 29,
    "position": 0,
    "text": "که امروز سهراب رزم آزمای"
  },
  {
    "poem_id": 1474,
    "vorder": 30,
    "position": 1,
    "text": "چگونه به جنگ اندر آورد پای"
  },
  {
    "poem_id": 1474,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت با رستم گرد گیو"
  },
  {
    "poem_id": 1474,
    "vorder": 32,
    "position": 1,
    "text": "کزین گونه هرگز ندیدیم نیو"
  },
  {
    "poem_id": 1474,
    "vorder": 33,
    "position": 0,
    "text": "بیامد دمان تا به قلب سپاه"
  },
  {
    "poem_id": 1474,
    "vorder": 34,
    "position": 1,
    "text": "ز لشکر بر طوس شد کینه خواه"
  },
  {
    "poem_id": 1474,
    "vorder": 35,
    "position": 0,
    "text": "که او بود بر زین و نیزه بدست"
  },
  {
    "poem_id": 1474,
    "vorder": 36,
    "position": 1,
    "text": "چو گرگین فرود آمد او برنشست"
  },
  {
    "poem_id": 1474,
    "vorder": 37,
    "position": 0,
    "text": "بیامد چو با نیزه او را بدید"
  },
  {
    "poem_id": 1474,
    "vorder": 38,
    "position": 1,
    "text": "به کردار شیر ژیان بردمید"
  },
  {
    "poem_id": 1474,
    "vorder": 39,
    "position": 0,
    "text": "عمودی خمیده بزد بر برش"
  },
  {
    "poem_id": 1474,
    "vorder": 40,
    "position": 1,
    "text": "ز نیرو بیفتاد ترگ از سرش"
  },
  {
    "poem_id": 1474,
    "vorder": 41,
    "position": 0,
    "text": "نتابید با او بتابید روی"
  },
  {
    "poem_id": 1474,
    "vorder": 42,
    "position": 1,
    "text": "شدند از دلیران بسی جنگ جوی"
  },
  {
    "poem_id": 1474,
    "vorder": 43,
    "position": 0,
    "text": "ز گردان کسی مایهٔ او نداشت"
  },
  {
    "poem_id": 1474,
    "vorder": 44,
    "position": 1,
    "text": "جز از پیلتن پایهٔ او نداشت"
  },
  {
    "poem_id": 1474,
    "vorder": 45,
    "position": 0,
    "text": "هم آیین پیشین نگه داشتیم"
  },
  {
    "poem_id": 1474,
    "vorder": 46,
    "position": 1,
    "text": "سپاهی برو ساده بگماشتیم"
  },
  {
    "poem_id": 1474,
    "vorder": 47,
    "position": 0,
    "text": "سواری نشد پیش او یکتنه"
  },
  {
    "poem_id": 1474,
    "vorder": 48,
    "position": 1,
    "text": "همی تاخت از قلب تا میمنه"
  },
  {
    "poem_id": 1474,
    "vorder": 49,
    "position": 0,
    "text": "غمی گشت رستم ز گفتار اوی"
  },
  {
    "poem_id": 1474,
    "vorder": 50,
    "position": 1,
    "text": "بر شاه کاووس بنهاد روی"
  },
  {
    "poem_id": 1474,
    "vorder": 51,
    "position": 0,
    "text": "چو کاووس کی پهلوان را بدید"
  },
  {
    "poem_id": 1474,
    "vorder": 52,
    "position": 1,
    "text": "بر خویش نزدیک جایش گزید"
  },
  {
    "poem_id": 1474,
    "vorder": 53,
    "position": 0,
    "text": "ز سهراب رستم زبان برگشاد"
  },
  {
    "poem_id": 1474,
    "vorder": 54,
    "position": 1,
    "text": "ز بالا و برزش همی کرد یاد"
  },
  {
    "poem_id": 1474,
    "vorder": 55,
    "position": 0,
    "text": "که کس در جهان کودک نارسید"
  },
  {
    "poem_id": 1474,
    "vorder": 56,
    "position": 1,
    "text": "بدین شیرمردی و گردی ندید"
  },
  {
    "poem_id": 1474,
    "vorder": 57,
    "position": 0,
    "text": "به بالا ستاره بساید همی"
  },
  {
    "poem_id": 1474,
    "vorder": 58,
    "position": 1,
    "text": "تنش را زمین برگراید همی"
  },
  {
    "poem_id": 1474,
    "vorder": 59,
    "position": 0,
    "text": "دو بازو و رانش ز ران هیون"
  },
  {
    "poem_id": 1474,
    "vorder": 60,
    "position": 1,
    "text": "همانا که دارد ستبری فزون"
  },
  {
    "poem_id": 1474,
    "vorder": 61,
    "position": 0,
    "text": "به گرز و به تیغ و به تیر و کمند"
  },
  {
    "poem_id": 1474,
    "vorder": 62,
    "position": 1,
    "text": "ز هرگونه‌ای آزمودیم بند"
  },
  {
    "poem_id": 1474,
    "vorder": 63,
    "position": 0,
    "text": "سرانجام گفتم که من پیش ازین"
  },
  {
    "poem_id": 1474,
    "vorder": 64,
    "position": 1,
    "text": "بسی گرد را برگرفتم ز زین"
  },
  {
    "poem_id": 1474,
    "vorder": 65,
    "position": 0,
    "text": "گرفتم دوال کمربند اوی"
  },
  {
    "poem_id": 1474,
    "vorder": 66,
    "position": 1,
    "text": "بیفشاردم سخت پیوند اوی"
  },
  {
    "poem_id": 1474,
    "vorder": 67,
    "position": 0,
    "text": "همی خواستم کش ز زین برکنم"
  },
  {
    "poem_id": 1474,
    "vorder": 68,
    "position": 1,
    "text": "چو دیگر کسانش به خاک افگنم"
  },
  {
    "poem_id": 1474,
    "vorder": 69,
    "position": 0,
    "text": "گر از باد جنبان شود کوه خار"
  },
  {
    "poem_id": 1474,
    "vorder": 70,
    "position": 1,
    "text": "نجنبید بر زین بر آن نامدار"
  },
  {
    "poem_id": 1474,
    "vorder": 71,
    "position": 0,
    "text": "چو فردا بیاید به دشت نبرد"
  },
  {
    "poem_id": 1474,
    "vorder": 72,
    "position": 1,
    "text": "به کشتی همی بایدم چاره کرد"
  },
  {
    "poem_id": 1474,
    "vorder": 73,
    "position": 0,
    "text": "بکوشم ندانم که پیروز کیست"
  },
  {
    "poem_id": 1474,
    "vorder": 74,
    "position": 1,
    "text": "ببینیم تا رای یزدان به چیست"
  },
  {
    "poem_id": 1474,
    "vorder": 75,
    "position": 0,
    "text": "کزویست پیروزی و فر و زور"
  },
  {
    "poem_id": 1474,
    "vorder": 76,
    "position": 1,
    "text": "هم او آفرینندهٔ ماه و هور"
  },
  {
    "poem_id": 1474,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت کاووس یزدان پاک"
  },
  {
    "poem_id": 1474,
    "vorder": 78,
    "position": 1,
    "text": "دل بدسگالت کند چاک چاک"
  },
  {
    "poem_id": 1474,
    "vorder": 79,
    "position": 0,
    "text": "من امشب به پیش جهان آفرین"
  },
  {
    "poem_id": 1474,
    "vorder": 80,
    "position": 1,
    "text": "بمالم فراوان دو رخ بر زمین"
  },
  {
    "poem_id": 1474,
    "vorder": 81,
    "position": 0,
    "text": "کزویست پیروزی و دستگاه"
  },
  {
    "poem_id": 1474,
    "vorder": 82,
    "position": 1,
    "text": "به فرمان او تابد از چرخ ماه"
  },
  {
    "poem_id": 1474,
    "vorder": 83,
    "position": 0,
    "text": "کند تازه این بار کام ترا"
  },
  {
    "poem_id": 1474,
    "vorder": 84,
    "position": 1,
    "text": "برآرد به خورشید نام ترا"
  },
  {
    "poem_id": 1474,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت رستم که با فر شاه"
  },
  {
    "poem_id": 1474,
    "vorder": 86,
    "position": 1,
    "text": "برآید همه کامهٔ نیک خواه"
  },
  {
    "poem_id": 1474,
    "vorder": 87,
    "position": 0,
    "text": "به لشکر گه خویش بنهاد روی"
  },
  {
    "poem_id": 1474,
    "vorder": 88,
    "position": 1,
    "text": "پراندیشه جان و سرش کینه جوی"
  },
  {
    "poem_id": 1474,
    "vorder": 89,
    "position": 0,
    "text": "زواره بیامد خلیده روان"
  },
  {
    "poem_id": 1474,
    "vorder": 90,
    "position": 1,
    "text": "که چون بود امروز بر پهلوان"
  },
  {
    "poem_id": 1474,
    "vorder": 91,
    "position": 0,
    "text": "ازو خوردنی خواست رستم نخست"
  },
  {
    "poem_id": 1474,
    "vorder": 92,
    "position": 1,
    "text": "پس آنگه ز اندیشگان دل بشست"
  },
  {
    "poem_id": 1474,
    "vorder": 93,
    "position": 0,
    "text": "چنین راند پیش برادر سخن"
  },
  {
    "poem_id": 1474,
    "vorder": 94,
    "position": 1,
    "text": "که بیدار دل باش و تندی مکن"
  },
  {
    "poem_id": 1474,
    "vorder": 95,
    "position": 0,
    "text": "به شبگیر چون من به آوردگاه"
  },
  {
    "poem_id": 1474,
    "vorder": 96,
    "position": 1,
    "text": "روم پیش آن ترک آوردخواه"
  },
  {
    "poem_id": 1474,
    "vorder": 97,
    "position": 0,
    "text": "بیاور سپاه و درفش مرا"
  },
  {
    "poem_id": 1474,
    "vorder": 98,
    "position": 1,
    "text": "همان تخت و زرینه کفش مرا"
  },
  {
    "poem_id": 1474,
    "vorder": 99,
    "position": 0,
    "text": "همی باش بر پیش پرده‌سرای"
  },
  {
    "poem_id": 1474,
    "vorder": 100,
    "position": 1,
    "text": "چو خورشید تابان برآید ز جای"
  },
  {
    "poem_id": 1474,
    "vorder": 101,
    "position": 0,
    "text": "گر ایدون که پیروز باشم به جنگ"
  },
  {
    "poem_id": 1474,
    "vorder": 102,
    "position": 1,
    "text": "به آوردگه بر نسازم درنگ"
  },
  {
    "poem_id": 1474,
    "vorder": 103,
    "position": 0,
    "text": "و گر خود دگرگونه گردد سخن"
  },
  {
    "poem_id": 1474,
    "vorder": 104,
    "position": 1,
    "text": "تو زاری میاغاز و تندی مکن"
  },
  {
    "poem_id": 1474,
    "vorder": 105,
    "position": 0,
    "text": "مباشید یک تن برین رزمگاه"
  },
  {
    "poem_id": 1474,
    "vorder": 106,
    "position": 1,
    "text": "مسازید جستن سوی رزم راه"
  },
  {
    "poem_id": 1474,
    "vorder": 107,
    "position": 0,
    "text": "یکایک سوی زابلستان شوید"
  },
  {
    "poem_id": 1474,
    "vorder": 108,
    "position": 1,
    "text": "از ایدر به نزدیک دستان شوید"
  },
  {
    "poem_id": 1474,
    "vorder": 109,
    "position": 0,
    "text": "تو خرسند گردان دل مادرم"
  },
  {
    "poem_id": 1474,
    "vorder": 110,
    "position": 1,
    "text": "چنین کرد یزدان قضا بر سرم"
  },
  {
    "poem_id": 1474,
    "vorder": 111,
    "position": 0,
    "text": "بگویش که تو دل به من در مبند"
  },
  {
    "poem_id": 1474,
    "vorder": 112,
    "position": 1,
    "text": "که سودی ندارت بودن نژند"
  },
  {
    "poem_id": 1474,
    "vorder": 113,
    "position": 0,
    "text": "کس اندر جهان جاودانه نماند"
  },
  {
    "poem_id": 1474,
    "vorder": 114,
    "position": 1,
    "text": "ز گردون مرا خود بهانه نماند"
  },
  {
    "poem_id": 1474,
    "vorder": 115,
    "position": 0,
    "text": "بسی شیر و دیو و پلنگ و نهنگ"
  },
  {
    "poem_id": 1474,
    "vorder": 116,
    "position": 1,
    "text": "تبه شد به چنگم به هنگام جنگ"
  },
  {
    "poem_id": 1474,
    "vorder": 117,
    "position": 0,
    "text": "بسی باره و دژ که کردیم پست"
  },
  {
    "poem_id": 1474,
    "vorder": 118,
    "position": 1,
    "text": "نیاورد کس دست من زیر دست"
  },
  {
    "poem_id": 1474,
    "vorder": 119,
    "position": 0,
    "text": "در مرگ را آن بکوبد که پای"
  },
  {
    "poem_id": 1474,
    "vorder": 120,
    "position": 1,
    "text": "باسپ اندر آرد بجنبد ز جای"
  },
  {
    "poem_id": 1474,
    "vorder": 121,
    "position": 0,
    "text": "اگر سال گشتی فزون ازهزار"
  },
  {
    "poem_id": 1474,
    "vorder": 122,
    "position": 1,
    "text": "همین بود خواهد سرانجام کار"
  },
  {
    "poem_id": 1474,
    "vorder": 123,
    "position": 0,
    "text": "چو خرسند گردد به دستان بگوی"
  },
  {
    "poem_id": 1474,
    "vorder": 124,
    "position": 1,
    "text": "که از شاه گیتی مبرتاب روی"
  },
  {
    "poem_id": 1474,
    "vorder": 125,
    "position": 0,
    "text": "اگر جنگ سازد تو سستی مکن"
  },
  {
    "poem_id": 1474,
    "vorder": 126,
    "position": 1,
    "text": "چنان رو که او راند از بن سخن"
  },
  {
    "poem_id": 1474,
    "vorder": 127,
    "position": 0,
