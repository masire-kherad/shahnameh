[
  {
    "poem_id": 88053,
    "vorder": 1,
    "position": 0,
    "text": "سپهدار ایران و توران دژم"
  },
  {
    "poem_id": 88053,
    "vorder": 2,
    "position": 1,
    "text": "فراز آمدند اندر آن کین به هم"
  },
  {
    "poem_id": 88053,
    "vorder": 3,
    "position": 0,
    "text": "همی برنوشتند هر دو زمین"
  },
  {
    "poem_id": 88053,
    "vorder": 4,
    "position": 1,
    "text": "همه دل پر از درد و سر پر ز کین"
  },
  {
    "poem_id": 88053,
    "vorder": 5,
    "position": 0,
    "text": "به آوردگاه سواران ز گرد"
  },
  {
    "poem_id": 88053,
    "vorder": 6,
    "position": 1,
    "text": "فروماند خورشید روز نبرد"
  },
  {
    "poem_id": 88053,
    "vorder": 7,
    "position": 0,
    "text": "به تیغ و به خنجر به گرز و کمند"
  },
  {
    "poem_id": 88053,
    "vorder": 8,
    "position": 1,
    "text": "ز هر گونهٔ برنهادند بند"
  },
  {
    "poem_id": 88053,
    "vorder": 9,
    "position": 0,
    "text": "فراز آمد آن گردش ایزدی"
  },
  {
    "poem_id": 88053,
    "vorder": 10,
    "position": 1,
    "text": "از ایران به توران رسید آن بدی"
  },
  {
    "poem_id": 88053,
    "vorder": 11,
    "position": 0,
    "text": "ابا خواست یزدانش چاره نماند"
  },
  {
    "poem_id": 88053,
    "vorder": 12,
    "position": 1,
    "text": "کرا کوشش و زور و یاره نماند"
  },
  {
    "poem_id": 88053,
    "vorder": 13,
    "position": 0,
    "text": "نگه کرد پیران که هنگام چیست"
  },
  {
    "poem_id": 88053,
    "vorder": 14,
    "position": 1,
    "text": "بدانست کان گردش ایزدیست"
  },
  {
    "poem_id": 88053,
    "vorder": 15,
    "position": 0,
    "text": "ولیکن به مردی همی کرد کار"
  },
  {
    "poem_id": 88053,
    "vorder": 16,
    "position": 1,
    "text": "بکوشید با گردش روزگار"
  },
  {
    "poem_id": 88053,
    "vorder": 17,
    "position": 0,
    "text": "از آن پس کمان برگرفتند و تیر"
  },
  {
    "poem_id": 88053,
    "vorder": 18,
    "position": 1,
    "text": "دو سالار لشکر دو هشیار پیر"
  },
  {
    "poem_id": 88053,
    "vorder": 19,
    "position": 0,
    "text": "یکی تیرباران گرفتند سخت"
  },
  {
    "poem_id": 88053,
    "vorder": 20,
    "position": 1,
    "text": "چو باد خزان بر جهد بر درخت"
  },
  {
    "poem_id": 88053,
    "vorder": 21,
    "position": 0,
    "text": "نگه کرد گودرز تیر خدنگ"
  },
  {
    "poem_id": 88053,
    "vorder": 22,
    "position": 1,
    "text": "که آهن ندارد مر او را نه سنگ"
  },
  {
    "poem_id": 88053,
    "vorder": 23,
    "position": 0,
    "text": "به برگستوان برزد و بردرید"
  },
  {
    "poem_id": 88053,
    "vorder": 24,
    "position": 1,
    "text": "تگاور بلرزید و دم درکشید"
  },
  {
    "poem_id": 88053,
    "vorder": 25,
    "position": 0,
    "text": "بیفتاد و پیران درآمد به زیر"
  },
  {
    "poem_id": 88053,
    "vorder": 26,
    "position": 1,
    "text": "بغلتید زیرش سوار دلیر"
  },
  {
    "poem_id": 88053,
    "vorder": 27,
    "position": 0,
    "text": "بدانست کآمد زمانه فراز"
  },
  {
    "poem_id": 88053,
    "vorder": 28,
    "position": 1,
    "text": "وز آن روز تیره نیابد جواز"
  },
  {
    "poem_id": 88053,
    "vorder": 29,
    "position": 0,
    "text": "ز نیرو به دو نیم شد دست راست"
  },
  {
    "poem_id": 88053,
    "vorder": 30,
    "position": 1,
    "text": "هم آنگه بغلتید و بر پای خاست"
  },
  {
    "poem_id": 88053,
    "vorder": 31,
    "position": 0,
    "text": "ز گودرز بگریخت و شد سوی کوه"
  },
  {
    "poem_id": 88053,
    "vorder": 32,
    "position": 1,
    "text": "غمی شد ز درد دویدن ستوه"
  },
  {
    "poem_id": 88053,
    "vorder": 33,
    "position": 0,
    "text": "همی شد بر آن کوهسر بر دوان"
  },
  {
    "poem_id": 88053,
    "vorder": 34,
    "position": 1,
    "text": "کزو بازگردد مگر پهلوان"
  },
  {
    "poem_id": 88053,
    "vorder": 35,
    "position": 0,
    "text": "نگه کرد گودرز و بگریست زار"
  },
  {
    "poem_id": 88053,
    "vorder": 36,
    "position": 1,
    "text": "بترسید از گردش روزگار"
  },
  {
    "poem_id": 88053,
    "vorder": 37,
    "position": 0,
    "text": "بدانست کش نیست با کس وفا"
  },
  {
    "poem_id": 88053,
    "vorder": 38,
    "position": 1,
    "text": "میان بسته دارد ز بهر جفا"
  },
  {
    "poem_id": 88053,
    "vorder": 39,
    "position": 0,
    "text": "فغان کرد کای نامور پهلوان"
  },
  {
    "poem_id": 88053,
    "vorder": 40,
    "position": 1,
    "text": "چه بودت که ایدون پیاده دوان"
  },
  {
    "poem_id": 88053,
    "vorder": 41,
    "position": 0,
    "text": "به کردار نخچیر در پیش من"
  },
  {
    "poem_id": 88053,
    "vorder": 42,
    "position": 1,
    "text": "کجات آن سپاه ای سر انجمن"
  },
  {
    "poem_id": 88053,
    "vorder": 43,
    "position": 0,
    "text": "نیامد ز لشکر ترا یار کس"
  },
  {
    "poem_id": 88053,
    "vorder": 44,
    "position": 1,
    "text": "وز ایشان نبینمت فریادرس"
  },
  {
    "poem_id": 88053,
    "vorder": 45,
    "position": 0,
    "text": "کجات آنهمه زور و مردانگی"
  },
  {
    "poem_id": 88053,
    "vorder": 46,
    "position": 1,
    "text": "سلیح و دل و گنج و فرزانگی"
  },
  {
    "poem_id": 88053,
    "vorder": 47,
    "position": 0,
    "text": "ستون گوان پشت افراسیاب"
  },
  {
    "poem_id": 88053,
    "vorder": 48,
    "position": 1,
    "text": "کنون شاه را تیره گشت آفتاب"
  },
  {
    "poem_id": 88053,
    "vorder": 49,
    "position": 0,
    "text": "زمانه ز تو زود برگاشت روی"
  },
  {
    "poem_id": 88053,
    "vorder": 50,
    "position": 1,
    "text": "به هنگام کینه تو چاره مجوی"
  },
  {
    "poem_id": 88053,
    "vorder": 51,
    "position": 0,
    "text": "چو کارت چنین گشت زنهار خواه"
  },
  {
    "poem_id": 88053,
    "vorder": 52,
    "position": 1,
    "text": "بدان تات زنده برم نزد شاه"
  },
  {
    "poem_id": 88053,
    "vorder": 53,
    "position": 0,
    "text": "ببخشاید از دل همی بر تو بر"
  },
  {
    "poem_id": 88053,
    "vorder": 54,
    "position": 1,
    "text": "که هستی جهان پهلوان سر به سر"
  },
  {
    "poem_id": 88053,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت پیران که این خود مباد"
  },
  {
    "poem_id": 88053,
    "vorder": 56,
    "position": 1,
    "text": "به فرجام بر من چنین بد مباد"
  },
  {
    "poem_id": 88053,
    "vorder": 57,
    "position": 0,
    "text": "از این پس مرا زندگانی بود"
  },
  {
    "poem_id": 88053,
    "vorder": 58,
    "position": 1,
    "text": "به زنهار رفتن گمانی بود"
  },
  {
    "poem_id": 88053,
    "vorder": 59,
    "position": 0,
    "text": "خود اندر جهان مرگ را زاده‌ایم"
  },
  {
    "poem_id": 88053,
    "vorder": 60,
    "position": 1,
    "text": "بدین کار گردن ترا داده‌ایم"
  },
  {
    "poem_id": 88053,
    "vorder": 61,
    "position": 0,
    "text": "شنیدستم این داستان از مهان"
  },
  {
    "poem_id": 88053,
    "vorder": 62,
    "position": 1,
    "text": "که هرچند باشی به خرم جهان"
  },
  {
    "poem_id": 88053,
    "vorder": 63,
    "position": 0,
    "text": "سرانجام مرگست زو چاره نیست"
  },
  {
    "poem_id": 88053,
    "vorder": 64,
    "position": 1,
    "text": "به من بر بدین جای پیغاره نیست"
  },
  {
    "poem_id": 88053,
    "vorder": 65,
    "position": 0,
    "text": "همی گشت گودرز بر گرد کوه"
  },
  {
    "poem_id": 88053,
    "vorder": 66,
    "position": 1,
    "text": "نبودش بدو راه و آمد ستوه"
  },
  {
    "poem_id": 88053,
    "vorder": 67,
    "position": 0,
    "text": "پیاده ببود و سپر برگرفت"
  },
  {
    "poem_id": 88053,
    "vorder": 68,
    "position": 1,
    "text": "چو نخچیربانان که اندر گرفت"
  },
  {
    "poem_id": 88053,
    "vorder": 69,
    "position": 0,
    "text": "گرفته سپر پیش و ژوپین به دست"
  },
  {
    "poem_id": 88053,
    "vorder": 70,
    "position": 1,
    "text": "به بالا نهاده سر از جای پست"
  },
  {
    "poem_id": 88053,
    "vorder": 71,
    "position": 0,
    "text": "همی دید پیران مر او را ز دور"
  },
  {
    "poem_id": 88053,
    "vorder": 72,
    "position": 1,
    "text": "بجست از بر سنگ سالار تور"
  },
  {
    "poem_id": 88053,
    "vorder": 73,
    "position": 0,
    "text": "بینداخت خنجر به کردار تیر"
  },
  {
    "poem_id": 88053,
    "vorder": 74,
    "position": 1,
    "text": "بیامد به بازوی سالار پیر"
  },
  {
    "poem_id": 88053,
    "vorder": 75,
    "position": 0,
    "text": "چو گودرز شد خسته بر دست اوی"
  },
  {
    "poem_id": 88053,
    "vorder": 76,
    "position": 1,
    "text": "ز کینه به خشم اندر آورد روی"
  },
  {
    "poem_id": 88053,
    "vorder": 77,
    "position": 0,
    "text": "بینداخت ژوپین به پیران رسید"
  },
  {
    "poem_id": 88053,
    "vorder": 78,
    "position": 1,
    "text": "زره بر تنش سر به سر بردرید"
  },
  {
    "poem_id": 88053,
    "vorder": 79,
    "position": 0,
    "text": "ز پشت اندر آمد به راه جگر"
  },
  {
    "poem_id": 88053,
    "vorder": 80,
    "position": 1,
    "text": "بغرید و آسیمه برگشت سر"
  },
  {
    "poem_id": 88053,
    "vorder": 81,
    "position": 0,
    "text": "برآمدش خون جگر بر دهان"
  },
  {
    "poem_id": 88053,
    "vorder": 82,
    "position": 1,
    "text": "روانش برآمد هم اندر زمان"
  },
  {
    "poem_id": 88053,
    "vorder": 83,
    "position": 0,
    "text": "چو شیر ژیان اندر آمد به سر"
  },
  {
    "poem_id": 88053,
    "vorder": 84,
    "position": 1,
    "text": "بنالید با داور دادگر"
  },
  {
    "poem_id": 88053,
    "vorder": 85,
    "position": 0,
    "text": "بر آن کوه خارا زمانی تپید"
  },
  {
    "poem_id": 88053,
    "vorder": 86,
    "position": 1,
    "text": "پس از کین و آوردگاه آرمید"
  },
  {
    "poem_id": 88053,
    "vorder": 87,
    "position": 0,
    "text": "زمانه به زهر آب دادست چنگ"
  },
  {
    "poem_id": 88053,
    "vorder": 88,
    "position": 1,
    "text": "بدرد دل شیر و چرم پلنگ"
  },
  {
    "poem_id": 88053,
    "vorder": 89,
    "position": 0,
    "text": "چنین است خود گردش روزگار"
  },
  {
    "poem_id": 88053,
    "vorder": 90,
    "position": 1,
    "text": "نگیرد همی پند آموزگار"
  },
  {
    "poem_id": 88053,
    "vorder": 91,
    "position": 0,
    "text": "چو گودرز بر شد بر آن کوهسار"
  },
  {
    "poem_id": 88053,
    "vorder": 92,
    "position": 1,
    "text": "بدیدش بر آن‌گونه افگنده خوار"
  },
  {
    "poem_id": 88053,
    "vorder": 93,
    "position": 0,
    "text": "دریده دل و دست و بر خاک سر"
  },
  {
    "poem_id": 88053,
    "vorder": 94,
    "position": 1,
    "text": "شکسته سلیح و گسسته کمر"
  },
  {
    "poem_id": 88053,
    "vorder": 95,
    "position": 0,
    "text": "چنین گفت گودرز کای نره شیر"
  },
  {
    "poem_id": 88053,
    "vorder": 96,
    "position": 1,
    "text": "سر پهلوانان و گرد دلیر"
  },
  {
    "poem_id": 88053,
    "vorder": 97,
    "position": 0,
    "text": "جهان چون من و چون تو بسیار دید"
  },
  {
    "poem_id": 88053,
    "vorder": 98,
    "position": 1,
    "text": "نخواهد همی با کسی آرمید"
  },
  {
    "poem_id": 88053,
    "vorder": 99,
    "position": 0,
    "text": "چو گودرز دیدش چنان مرده‌خوار"
  },
  {
    "poem_id": 88053,
    "vorder": 100,
    "position": 1,
    "text": "به خاک و به خون بر تپیده به زار"
  },
  {
    "poem_id": 88053,
    "vorder": 101,
    "position": 0,
    "text": "فروبرد چنگال و خون برگرفت"
  },
  {
    "poem_id": 88053,
    "vorder": 102,
    "position": 1,
    "text": "بخورد و بیالود روی ای شگفت"
  },
  {
    "poem_id": 88053,
    "vorder": 103,
    "position": 0,
    "text": "ز خون سیاوش خروشید زار"
  },
  {
    "poem_id": 88053,
    "vorder": 104,
    "position": 1,
    "text": "نیایش همی کرد بر کردگار"
  },
  {
    "poem_id": 88053,
    "vorder": 105,
    "position": 0,
    "text": "ز هفتاد خون گرامی پسر"
  },
  {
    "poem_id": 88053,
    "vorder": 106,
    "position": 1,
    "text": "بنالید با داور دادگر"
  },
  {
    "poem_id": 88053,
    "vorder": 107,
    "position": 0,
    "text": "سرش را همی خواست از تن برید"
  },
  {
    "poem_id": 88053,
    "vorder": 108,
    "position": 1,
    "text": "چنان بدکنش خویشتن را ندید"
  },
  {
    "poem_id": 88053,
    "vorder": 109,
    "position": 0,
    "text": "درفشی به بالینش بر پای کرد"
  },
  {
    "poem_id": 88053,
    "vorder": 110,
    "position": 1,
    "text": "سرش را بدان سایه برجای کرد"
  },
  {
    "poem_id": 88053,
    "vorder": 111,
    "position": 0,
    "text": "سوی لشکر خویش بنهاد روی"
  },
  {
    "poem_id": 88053,
    "vorder": 112,
    "position": 1,
    "text": "چکان خون ز بازوش چون آب جوی"
  },
  {
    "poem_id": 88053,
    "vorder": 113,
    "position": 0,
    "text": "همه کینه‌جویان پرخاشجوی"
  },
  {
    "poem_id": 88053,
    "vorder": 114,
    "position": 1,
    "text": "ز بالا به لشکر نهادند روی"
  },
  {
    "poem_id": 88053,
    "vorder": 115,
    "position": 0,
    "text": "ابا کشتگان بسته بر پشت زین"
  },
  {
    "poem_id": 88053,
    "vorder": 116,
    "position": 1,
    "text": "بر ایشان سرآورده پرخاش و کین"
  },
  {
    "poem_id": 88053,
    "vorder": 117,
    "position": 0,
    "text": "چو با کینه‌جویان نبد پهلوان"
  },
  {
    "poem_id": 88053,
    "vorder": 118,
    "position": 1,
    "text": "خروشی برآمد ز پیر و جوان"
  },
  {
    "poem_id": 88053,
    "vorder": 119,
    "position": 0,
    "text": "که گودرز بر دست پیران مگر"
  },
  {
    "poem_id": 88053,
    "vorder": 120,
    "position": 1,
    "text": "ز پیری به خون اندر آورد سر"
  },
  {
    "poem_id": 88053,
    "vorder": 121,
    "position": 0,
    "text": "همی زار بگریست لشکر همه"
  },
  {
    "poem_id": 88053,
    "vorder": 122,
    "position": 1,
    "text": "ز نادیدن پهلوان رمه"
  },
  {
    "poem_id": 88053,
    "vorder": 123,
    "position": 0,
    "text": "درفشی پدید آمد از تیره گرد"
  },
  {
    "poem_id": 88053,
    "vorder": 124,
    "position": 1,
    "text": "گرازان و تازان به دشت نبرد"
  },
  {
    "poem_id": 88053,
    "vorder": 125,
    "position": 0,
    "text": "برآمد ز لشکرگه آوای کوس"
  },
  {
    "poem_id": 88053,
    "vorder": 126,
    "position": 1,
    "text": "همی گرد بر آسمان داد بوس"
  },
  {
    "poem_id": 88053,
    "vorder": 127,
    "position": 0,
    "text": "بزرگان بر پهلوان آمدند"
  },
  {
    "poem_id": 88053,
    "vorder": 128,
    "position": 1,
    "text": "پر از خنده و شادمان آمدند"
  },
  {
    "poem_id": 88053,
    "vorder": 129,
    "position": 0,
    "text": "چنین گفت لشکر مگر پهلوان"
  },
  {
    "poem_id": 88053,
    "vorder": 130,
    "position": 1,
    "text": "از او بازگردید تیره روان"
  },
  {
    "poem_id": 88053,
    "vorder": 131,
    "position": 0,
    "text": "که پیران یکی شیردل مرد بود"
  },
  {
    "poem_id": 88053,
    "vorder": 132,
    "position": 1,
    "text": "همه ساله جویای آورد بود"
  },
  {
    "poem_id": 88053,
    "vorder": 133,
    "position": 0,
    "text": "چنین یاد کرد آن زمان پهلوان"
  },
  {
    "poem_id": 88053,
    "vorder": 134,
    "position": 1,
    "text": "سپرده بدو گوش پیر و جوان"
  },
  {
    "poem_id": 88053,
    "vorder": 135,
    "position": 0,
    "text": "به انگشت بنمود جای نبرد"
  },
  {
    "poem_id": 88053,
    "vorder": 136,
    "position": 1,
    "text": "بگفت آنک با او زمانه چه کرد"
  },
  {
    "poem_id": 88053,
    "vorder": 137,
    "position": 0,
    "text": "به رهام فرمود تا برنشست"
  },
  {
    "poem_id": 88053,
    "vorder": 138,
    "position": 1,
    "text": "به آوردن او میان را ببست"
  },
  {
    "poem_id": 88053,
    "vorder": 139,
    "position": 0,
    "text": "بدو گفت او را به زین برببند"
  },
  {
    "poem_id": 88053,
    "vorder": 140,
    "position": 1,
    "text": "بیاور چنان تازیان بر نوند"
  },
  {
    "poem_id": 88053,
    "vorder": 141,
    "position": 0,
    "text": "درفش و سلیحش چنان هم که هست"
  },
  {
    "poem_id": 88053,
    "vorder": 142,
    "position": 1,
    "text": "به درع و میانش مبر هیچ دست"
  },
  {
    "poem_id": 88053,
    "vorder": 143,
    "position": 0,
    "text": "بر آن گونه چون پهلوان کرد یاد"
  },
  {
    "poem_id": 88053,
    "vorder": 144,
    "position": 1,
    "text": "برون تاخت رهام چون تندباد"
  },
  {
    "poem_id": 88053,
    "vorder": 145,
    "position": 0,
    "text": "کشید از بر اسب روشن تنش"
  },
  {
    "poem_id": 88053,
    "vorder": 146,
    "position": 1,
    "text": "به خون اندرون غرقه بد جوشنش"
  },
  {
    "poem_id": 88053,
    "vorder": 147,
    "position": 0,
    "text": "چنان هم ببستش به خم کمند"
  },
  {
    "poem_id": 88053,
    "vorder": 148,
    "position": 1,
    "text": "فرود آوریدش ز کوه بلند"
  },
  {
    "poem_id": 88053,
    "vorder": 149,
    "position": 0,
    "text": "درفشش چو از جایگاه نشان"
  },
  {
    "poem_id": 88053,
    "vorder": 150,
    "position": 1,
    "text": "ندیدند گردان گردنکشان"
  },
  {
    "poem_id": 88053,
    "vorder": 151,
    "position": 0,
    "text": "همه خواندند آفرین سر به سر"
  },
  {
    "poem_id": 88053,
    "vorder": 152,
    "position": 1,
    "text": "ابر پهلوان زمین در به در"
  },
  {
    "poem_id": 88053,
    "vorder": 153,
    "position": 0,
    "text": "که ای نامور پشت ایران سپاه"
  },
  {
    "poem_id": 88053,
    "vorder": 154,
    "position": 1,
    "text": "پرستندهٔ تخت تو باد ماه"
  },
  {
    "poem_id": 88053,
    "vorder": 155,
    "position": 0,
    "text": "فدای سپه کرده‌ای جان و تن"
  },
  {
    "poem_id": 88053,
    "vorder": 156,
    "position": 1,
    "text": "به پیری زمان روزگار کهن"
  },
  {
    "poem_id": 88053,
    "vorder": 157,
    "position": 0,
    "text": "چنین گفت گودرز با مهتران"
  },
  {
    "poem_id": 88053,
    "vorder": 158,
    "position": 1,
    "text": "که چون رزم ما گشت ز این سان گران"
  },
  {
    "poem_id": 88053,
    "vorder": 159,
    "position": 0,
    "text": "مرا در دل آید که افراسیاب"
  },
  {
    "poem_id": 88053,
    "vorder": 160,
    "position": 1,
    "text": "سپه بگذراند بدین روی آب"
  },
  {
    "poem_id": 88053,
    "vorder": 161,
    "position": 0,
    "text": "سپاه وی آسوده از رنج و تاب"
  },
  {
    "poem_id": 88053,
    "vorder": 162,
    "position": 1,
    "text": "بمانده سپاهم چنین در شتاب"
  },
  {
    "poem_id": 88053,
    "vorder": 163,
    "position": 0,
    "text": "ولیکن چنین دارم امید من"
  },
  {
    "poem_id": 88053,
    "vorder": 164,
    "position": 1,
    "text": "که آید جهاندار خورشید من"
  },
  {
    "poem_id": 88053,
    "vorder": 165,
    "position": 0,
    "text": "بیفروزد این رزمگه را به فر"
  },
  {
    "poem_id": 88053,
    "vorder": 166,
    "position": 1,
    "text": "بیارد سپاهی به نو کینه‌ور"
  },
  {
    "poem_id": 88053,
    "vorder": 167,
    "position": 0,
    "text": "یکی هوشمندی فرستاده‌ام"
  },
  {
    "poem_id": 88053,
    "vorder": 168,
    "position": 1,
    "text": "بسی شاه را پندها داده‌ام"
  },
  {
    "poem_id": 88053,
    "vorder": 169,
    "position": 0,
    "text": "که گر شاه ترکان بیارد سپاه"
  },
  {
    "poem_id": 88053,
    "vorder": 170,
    "position": 1,
    "text": "نداریم پای اندر این کینه‌گاه"
  },
  {
    "poem_id": 88053,
    "vorder": 171,
    "position": 0,
    "text": "گمانم چنان است کو با سپاه"
  },
  {
    "poem_id": 88053,
    "vorder": 172,
    "position": 1,
    "text": "به یاری بیاید بدین رزمگاه"
  },
  {
    "poem_id": 88053,
    "vorder": 173,
    "position": 0,
    "text": "مر این کشتگان را بر این دشت کین"
  },
  {
    "poem_id": 88053,
    "vorder": 174,
    "position": 1,
    "text": "چنین هم بدارید بر پشت زین"
  },
  {
    "poem_id": 88053,
    "vorder": 175,
    "position": 0,
    "text": "کز این کشتگان جان ما بیغم است"
  },
  {
    "poem_id": 88053,
    "vorder": 176,
    "position": 1,
    "text": "روان سیاووش ز این خرم است"
  },
  {
    "poem_id": 88053,
    "vorder": 177,
    "position": 0,
    "text": "اگر هم چنین نزد شاه آوریم"
  },
  {
    "poem_id": 88053,
    "vorder": 178,
    "position": 1,
    "text": "شود شاد و ز این پایگاه آوریم"
  },
  {
    "poem_id": 88053,
    "vorder": 179,
    "position": 0,
    "text": "که آشوب ترکان و ایرانیان"
  },
  {
    "poem_id": 88053,
    "vorder": 180,
    "position": 1,
    "text": "از این بد کجا کم شد اندر میان"
  },
  {
    "poem_id": 88053,
    "vorder": 181,
    "position": 0,
    "text": "همه یکسره خواندند آفرین"
  },
  {
    "poem_id": 88053,
    "vorder": 182,
    "position": 1,
    "text": "که بی‌تو مبادا زمان و زمین"
  },
  {
    "poem_id": 88053,
    "vorder": 183,
    "position": 0,
    "text": "همه سودمندی ز گفتار تست"
  },
  {
    "poem_id": 88053,
    "vorder": 184,
    "position": 1,
    "text": "خور و ماه روشن بدیدار تست"
  },
  {
    "poem_id": 88053,
    "vorder": 185,
    "position": 0,
    "text": "برفتند با کشتگان همچنان"
  },
  {
    "poem_id": 88053,
    "vorder": 186,
    "position": 1,
    "text": "گروی زره را پیاده دوان"
  }
]