[
  {
    "poem_id": 1701,
    "vorder": 1,
    "position": 0,
    "text": "ببین این شگفتی که دهقان چه گفت"
  },
  {
    "poem_id": 1701,
    "vorder": 2,
    "position": 1,
    "text": "بدانگه که بگشاد راز از نهفت"
  },
  {
    "poem_id": 1701,
    "vorder": 3,
    "position": 0,
    "text": "به شهر کجاران به دریای پارس"
  },
  {
    "poem_id": 1701,
    "vorder": 4,
    "position": 1,
    "text": "چه گوید ز بالا و پهنای پارس"
  },
  {
    "poem_id": 1701,
    "vorder": 5,
    "position": 0,
    "text": "یکی شهر بد تنگ و مردم بسی"
  },
  {
    "poem_id": 1701,
    "vorder": 6,
    "position": 1,
    "text": "ز کوشش بدی خوردن هر کسی"
  },
  {
    "poem_id": 1701,
    "vorder": 7,
    "position": 0,
    "text": "بدان شهر دختر فراوان بدی"
  },
  {
    "poem_id": 1701,
    "vorder": 8,
    "position": 1,
    "text": "که بی‌کام جویندهٔ نان بدی"
  },
  {
    "poem_id": 1701,
    "vorder": 9,
    "position": 0,
    "text": "به یک روی نزدیک او بود کوه"
  },
  {
    "poem_id": 1701,
    "vorder": 10,
    "position": 1,
    "text": "شدندی همه دختران همگروه"
  },
  {
    "poem_id": 1701,
    "vorder": 11,
    "position": 0,
    "text": "ازان هر یکی پنبه بردی به سنگ"
  },
  {
    "poem_id": 1701,
    "vorder": 12,
    "position": 1,
    "text": "یکی دوکدانی ز چوب خدنگ"
  },
  {
    "poem_id": 1701,
    "vorder": 13,
    "position": 0,
    "text": "به دروازه دختر شدی همگروه"
  },
  {
    "poem_id": 1701,
    "vorder": 14,
    "position": 1,
    "text": "خرامان ازین شهر تا پیش کوه"
  },
  {
    "poem_id": 1701,
    "vorder": 15,
    "position": 0,
    "text": "برآمیختندی خورشها بهم"
  },
  {
    "poem_id": 1701,
    "vorder": 16,
    "position": 1,
    "text": "نبودی به خورد اندرون بیش و کم"
  },
  {
    "poem_id": 1701,
    "vorder": 17,
    "position": 0,
    "text": "نرفتی سخن گفتن از خواب و خورد"
  },
  {
    "poem_id": 1701,
    "vorder": 18,
    "position": 1,
    "text": "ازان پنبه‌شان بود ننگ و نبرد"
  },
  {
    "poem_id": 1701,
    "vorder": 19,
    "position": 0,
    "text": "شدندی شبانگه سوی خانه باز"
  },
  {
    "poem_id": 1701,
    "vorder": 20,
    "position": 1,
    "text": "شده پنبه‌شان ریسمان طراز"
  },
  {
    "poem_id": 1701,
    "vorder": 21,
    "position": 0,
    "text": "بدان شهر بی‌چیز و خرم نهاد"
  },
  {
    "poem_id": 1701,
    "vorder": 22,
    "position": 1,
    "text": "یکی مرد بد نام او هفتواد"
  },
  {
    "poem_id": 1701,
    "vorder": 23,
    "position": 0,
    "text": "برین‌گونه بر نام او از چه رفت"
  },
  {
    "poem_id": 1701,
    "vorder": 24,
    "position": 1,
    "text": "ازیراک او را پسر بود هفت"
  },
  {
    "poem_id": 1701,
    "vorder": 25,
    "position": 0,
    "text": "گرامی یکی دخترش بود و بس"
  },
  {
    "poem_id": 1701,
    "vorder": 26,
    "position": 1,
    "text": "که نشمردی او دختران را به کس"
  },
  {
    "poem_id": 1701,
    "vorder": 27,
    "position": 0,
    "text": "چنان بد که روزی همه همگروه"
  },
  {
    "poem_id": 1701,
    "vorder": 28,
    "position": 1,
    "text": "نشستند با دوک در پیش کوه"
  },
  {
    "poem_id": 1701,
    "vorder": 29,
    "position": 0,
    "text": "برآمیختند آن کجا داشتند"
  },
  {
    "poem_id": 1701,
    "vorder": 30,
    "position": 1,
    "text": "به گاه خورش دوک بگذاشتند"
  },
  {
    "poem_id": 1701,
    "vorder": 31,
    "position": 0,
    "text": "چنان بد که این دختر نیک‌بخت"
  },
  {
    "poem_id": 1701,
    "vorder": 32,
    "position": 1,
    "text": "یکی سیب افگنده باد از درخت"
  },
  {
    "poem_id": 1701,
    "vorder": 33,
    "position": 0,
    "text": "به ره بر بدید و سبک برگرفت"
  },
  {
    "poem_id": 1701,
    "vorder": 34,
    "position": 1,
    "text": "ز من بشنو این داستان شگفت"
  },
  {
    "poem_id": 1701,
    "vorder": 35,
    "position": 0,
    "text": "چو آن خوب رخ میوه اندرگزید"
  },
  {
    "poem_id": 1701,
    "vorder": 36,
    "position": 1,
    "text": "یکی در میان کرم آگنده دید"
  },
  {
    "poem_id": 1701,
    "vorder": 37,
    "position": 0,
    "text": "به انگشت زان سیب برداشتش"
  },
  {
    "poem_id": 1701,
    "vorder": 38,
    "position": 1,
    "text": "بدان دوکدان نرم بگذاشتش"
  },
  {
    "poem_id": 1701,
    "vorder": 39,
    "position": 0,
    "text": "چو برداشت زان دوکدان پنبه گفت"
  },
  {
    "poem_id": 1701,
    "vorder": 40,
    "position": 1,
    "text": "به نام خداوند بی‌یار و جفت"
  },
  {
    "poem_id": 1701,
    "vorder": 41,
    "position": 0,
    "text": "من امروز بر اختر کرم سیب"
  },
  {
    "poem_id": 1701,
    "vorder": 42,
    "position": 1,
    "text": "به رشتن نمایم شما را نهیب"
  },
  {
    "poem_id": 1701,
    "vorder": 43,
    "position": 0,
    "text": "همه دختران شاد و خندان شدند"
  },
  {
    "poem_id": 1701,
    "vorder": 44,
    "position": 1,
    "text": "گشاده‌رخ و سیم دندان شدند"
  },
  {
    "poem_id": 1701,
    "vorder": 45,
    "position": 0,
    "text": "دو چندان که رشتی به روزی برشت"
  },
  {
    "poem_id": 1701,
    "vorder": 46,
    "position": 1,
    "text": "شمارش همی بر زمین برنوشت"
  },
  {
    "poem_id": 1701,
    "vorder": 47,
    "position": 0,
    "text": "وزانجا بیامد به کردار دود"
  },
  {
    "poem_id": 1701,
    "vorder": 48,
    "position": 1,
    "text": "به مادر نمود آن کجا رشته بود"
  },
  {
    "poem_id": 1701,
    "vorder": 49,
    "position": 0,
    "text": "برو آفرین کرد مادر به مهر"
  },
  {
    "poem_id": 1701,
    "vorder": 50,
    "position": 1,
    "text": "که برخوردی از مادر ای خوب‌چهر"
  },
  {
    "poem_id": 1701,
    "vorder": 51,
    "position": 0,
    "text": "به شبگیر چون ریسمان برشمرد"
  },
  {
    "poem_id": 1701,
    "vorder": 52,
    "position": 1,
    "text": "دو چندانک هر بار بردی ببرد"
  },
  {
    "poem_id": 1701,
    "vorder": 53,
    "position": 0,
    "text": "چو آمد بدان چاره‌جوی انجمن"
  },
  {
    "poem_id": 1701,
    "vorder": 54,
    "position": 1,
    "text": "به رشتن نهاده دل و گوش و تن"
  },
  {
    "poem_id": 1701,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت با نامور دختران"
  },
  {
    "poem_id": 1701,
    "vorder": 56,
    "position": 1,
    "text": "که ای ماه‌رویان و نیک‌اختران"
  },
  {
    "poem_id": 1701,
    "vorder": 57,
    "position": 0,
    "text": "من از اختر کرم چندان طراز"
  },
  {
    "poem_id": 1701,
    "vorder": 58,
    "position": 1,
    "text": "بریسم که نیزم نیاید نیاز"
  },
  {
    "poem_id": 1701,
    "vorder": 59,
    "position": 0,
    "text": "به رشت آنکجا برده بد پیش ازین"
  },
  {
    "poem_id": 1701,
    "vorder": 60,
    "position": 1,
    "text": "به کار آمدی گر بدی بیش ازین"
  },
  {
    "poem_id": 1701,
    "vorder": 61,
    "position": 0,
    "text": "سوی خانه برد آن طرازی که رشت"
  },
  {
    "poem_id": 1701,
    "vorder": 62,
    "position": 1,
    "text": "دل مام او شد چو خرم بهشت"
  },
  {
    "poem_id": 1701,
    "vorder": 63,
    "position": 0,
    "text": "همی لختکی سیب هر بامداد"
  },
  {
    "poem_id": 1701,
    "vorder": 64,
    "position": 1,
    "text": "پری‌روی دختر بران کرم داد"
  },
  {
    "poem_id": 1701,
    "vorder": 65,
    "position": 0,
    "text": "ازان پنبه هرچند کردی فزون"
  },
  {
    "poem_id": 1701,
    "vorder": 66,
    "position": 1,
    "text": "برشتی همی دختر پرفسون"
  },
  {
    "poem_id": 1701,
    "vorder": 67,
    "position": 0,
    "text": "چنان بد که یک روز مام و پدر"
  },
  {
    "poem_id": 1701,
    "vorder": 68,
    "position": 1,
    "text": "بگفتند با دختر پرهنر"
  },
  {
    "poem_id": 1701,
    "vorder": 69,
    "position": 0,
    "text": "که چندین بریسی مگر با پری"
  },
  {
    "poem_id": 1701,
    "vorder": 70,
    "position": 1,
    "text": "گرفتستی ای پاک تن خواهری"
  },
  {
    "poem_id": 1701,
    "vorder": 71,
    "position": 0,
    "text": "سبک سیم تن پیش مادر بگفت"
  },
  {
    "poem_id": 1701,
    "vorder": 72,
    "position": 1,
    "text": "ازان سیب و آن کرمک اندر نهفت"
  },
  {
    "poem_id": 1701,
    "vorder": 73,
    "position": 0,
    "text": "همان کرم فرخ بدیشان نمود"
  },
  {
    "poem_id": 1701,
    "vorder": 74,
    "position": 1,
    "text": "زن و شوی را روشنایی فزود"
  },
  {
    "poem_id": 1701,
    "vorder": 75,
    "position": 0,
    "text": "به فالی گرفت آن سخن هفتواد"
  },
  {
    "poem_id": 1701,
    "vorder": 76,
    "position": 1,
    "text": "ز کاری نکردی به دل نیز یاد"
  },
  {
    "poem_id": 1701,
    "vorder": 77,
    "position": 0,
    "text": "چنین تا برآمد برین روزگار"
  },
  {
    "poem_id": 1701,
    "vorder": 78,
    "position": 1,
    "text": "فروزنده‌تر گشت هر روز کار"
  },
  {
    "poem_id": 1701,
    "vorder": 79,
    "position": 0,
    "text": "مگر ز اختر کرم گفتی سخن"
  },
  {
    "poem_id": 1701,
    "vorder": 80,
    "position": 1,
    "text": "برو نو شدی روزگار کهن"
  },
  {
    "poem_id": 1701,
    "vorder": 81,
    "position": 0,
    "text": "مر این کرم را خوار نگذاشتند"
  },
  {
    "poem_id": 1701,
    "vorder": 82,
    "position": 1,
    "text": "بخوردنش نیکو همی داشتند"
  },
  {
    "poem_id": 1701,
    "vorder": 83,
    "position": 0,
    "text": "تن‌آور شد آن کرم و نیرو گرفت"
  },
  {
    "poem_id": 1701,
    "vorder": 84,
    "position": 1,
    "text": "سر و پشت او رنگ نیکو گرفت"
  },
  {
    "poem_id": 1701,
    "vorder": 85,
    "position": 0,
    "text": "همی تنگ شد دوکدان بر تنش"
  },
  {
    "poem_id": 1701,
    "vorder": 86,
    "position": 1,
    "text": "چو مشک سیه گشت پیراهنش"
  },
  {
    "poem_id": 1701,
    "vorder": 87,
    "position": 0,
    "text": "به مشک اندرون پیکر زعفران"
  },
  {
    "poem_id": 1701,
    "vorder": 88,
    "position": 1,
    "text": "برو پشت او از کران تا کران"
  },
  {
    "poem_id": 1701,
    "vorder": 89,
    "position": 0,
    "text": "یکی پاک صندوق کردش سیاه"
  },
  {
    "poem_id": 1701,
    "vorder": 90,
    "position": 1,
    "text": "بدو اندرون ساخته جایگاه"
  },
  {
    "poem_id": 1701,
    "vorder": 91,
    "position": 0,
    "text": "چنان شد که در شهر بی‌هفتواد"
  },
  {
    "poem_id": 1701,
    "vorder": 92,
    "position": 1,
    "text": "نگفتی سخن کس به بیداد و داد"
  },
  {
    "poem_id": 1701,
    "vorder": 93,
    "position": 0,
    "text": "فراز آمدش ارج و آزرم و چیز"
  },
  {
    "poem_id": 1701,
    "vorder": 94,
    "position": 1,
    "text": "توانگر شد آن هفت فرزند نیز"
  },
  {
    "poem_id": 1701,
    "vorder": 95,
    "position": 0,
    "text": "یکی میر بد اندر آن شهراوی"
  },
  {
    "poem_id": 1701,
    "vorder": 96,
    "position": 1,
    "text": "سرافراز با لشکر و رنگ و بوی"
  },
  {
    "poem_id": 1701,
    "vorder": 97,
    "position": 0,
    "text": "بهانه همی ساخت بر هفتواد"
  },
  {
    "poem_id": 1701,
    "vorder": 98,
    "position": 1,
    "text": "که دینار بستاند از بدنژاد"
  },
  {
    "poem_id": 1701,
    "vorder": 99,
    "position": 0,
    "text": "ازان آگهی مرد شد در نهیب"
  },
  {
    "poem_id": 1701,
    "vorder": 100,
    "position": 1,
    "text": "بیامد ازان شهر دل با شکیب"
  },
  {
    "poem_id": 1701,
    "vorder": 101,
    "position": 0,
    "text": "همان هفت فرزند پیش اندرون"
  },
  {
    "poem_id": 1701,
    "vorder": 102,
    "position": 1,
    "text": "پر از درد دل دیدگان پر ز خون"
  },
  {
    "poem_id": 1701,
    "vorder": 103,
    "position": 0,
    "text": "ز هر سو برانگیخت بانگ و نفیر"
  },
  {
    "poem_id": 1701,
    "vorder": 104,
    "position": 1,
    "text": "برو انجمن گشت برنا و پیر"
  },
  {
    "poem_id": 1701,
    "vorder": 105,
    "position": 0,
    "text": "هرانجا که بایست دینار داد"
  },
  {
    "poem_id": 1701,
    "vorder": 106,
    "position": 1,
    "text": "به کنداوران چیز بسیار داد"
  },
  {
    "poem_id": 1701,
    "vorder": 107,
    "position": 0,
    "text": "یکی لشکری شد بر او انجمن"
  },
  {
    "poem_id": 1701,
    "vorder": 108,
    "position": 1,
    "text": "همه نامداران شمشیرزن"
  },
  {
    "poem_id": 1701,
    "vorder": 109,
    "position": 0,
    "text": "همه یکسره پیش فرزند اوی"
  },
  {
    "poem_id": 1701,
    "vorder": 110,
    "position": 1,
    "text": "برفتند و گشتند پیکارجوی"
  }
]