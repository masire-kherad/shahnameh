[
  {
    "poem_id": 1768,
    "vorder": 1,
    "position": 0,
    "text": "گذشت آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1768,
    "vorder": 2,
    "position": 1,
    "text": "بیامد نشست از بر گاه شاه"
  },
  {
    "poem_id": 1768,
    "vorder": 3,
    "position": 0,
    "text": "فرستاد و ایرانیان را بخواند"
  },
  {
    "poem_id": 1768,
    "vorder": 4,
    "position": 1,
    "text": "ز روز گذشته فراوان براند"
  },
  {
    "poem_id": 1768,
    "vorder": 5,
    "position": 0,
    "text": "به آواز گفتند پس موبدان"
  },
  {
    "poem_id": 1768,
    "vorder": 6,
    "position": 1,
    "text": "که هستی تو داناتر از بخردان"
  },
  {
    "poem_id": 1768,
    "vorder": 7,
    "position": 0,
    "text": "به شاهنشهی در چه پیش آوری"
  },
  {
    "poem_id": 1768,
    "vorder": 8,
    "position": 1,
    "text": "چو گیری بلندی و کنداوری"
  },
  {
    "poem_id": 1768,
    "vorder": 9,
    "position": 0,
    "text": "چه پیش آری از داد و از راستی"
  },
  {
    "poem_id": 1768,
    "vorder": 10,
    "position": 1,
    "text": "کزان گم شود کژی و کاستی"
  },
  {
    "poem_id": 1768,
    "vorder": 11,
    "position": 0,
    "text": "چنین داد پاسخ به فرزانگان"
  },
  {
    "poem_id": 1768,
    "vorder": 12,
    "position": 1,
    "text": "بدان نامداران و مردانگان"
  },
  {
    "poem_id": 1768,
    "vorder": 13,
    "position": 0,
    "text": "که بخشش بیفزایم از گفت‌وگوی"
  },
  {
    "poem_id": 1768,
    "vorder": 14,
    "position": 1,
    "text": "بکاهم ز بیدادی و جست و جوی"
  },
  {
    "poem_id": 1768,
    "vorder": 15,
    "position": 0,
    "text": "کسی را کجا پادشاهی سزاست"
  },
  {
    "poem_id": 1768,
    "vorder": 16,
    "position": 1,
    "text": "زمین را بدیشان ببخشیم راست"
  },
  {
    "poem_id": 1768,
    "vorder": 17,
    "position": 0,
    "text": "جهان را بدارم به رای و به داد"
  },
  {
    "poem_id": 1768,
    "vorder": 18,
    "position": 1,
    "text": "چو ایمنی کنم باشم از داد شاد"
  },
  {
    "poem_id": 1768,
    "vorder": 19,
    "position": 0,
    "text": "کسی را که درویش باشد به نیز"
  },
  {
    "poem_id": 1768,
    "vorder": 20,
    "position": 1,
    "text": "ز گنج نهاده ببخشیم چیز"
  },
  {
    "poem_id": 1768,
    "vorder": 21,
    "position": 0,
    "text": "گنه کرده را پند پیش آوریم"
  },
  {
    "poem_id": 1768,
    "vorder": 22,
    "position": 1,
    "text": "چو دیگر کند بند پیش آوریم"
  },
  {
    "poem_id": 1768,
    "vorder": 23,
    "position": 0,
    "text": "سپه را به هنگام روزی دهیم"
  },
  {
    "poem_id": 1768,
    "vorder": 24,
    "position": 1,
    "text": "خردمند را دلفروزی دهیم"
  },
  {
    "poem_id": 1768,
    "vorder": 25,
    "position": 0,
    "text": "همان راست داریم دل با زبان"
  },
  {
    "poem_id": 1768,
    "vorder": 26,
    "position": 1,
    "text": "ز کژی و تاری بپیچم روان"
  },
  {
    "poem_id": 1768,
    "vorder": 27,
    "position": 0,
    "text": "کسی کو بمیرد نباشدش خویش"
  },
  {
    "poem_id": 1768,
    "vorder": 28,
    "position": 1,
    "text": "وزو چیز ماند ز اندازه بیش"
  },
  {
    "poem_id": 1768,
    "vorder": 29,
    "position": 0,
    "text": "به دوریش بخشم نیارم به گنج"
  },
  {
    "poem_id": 1768,
    "vorder": 30,
    "position": 1,
    "text": "نبندم دل اندر سرای سپنج"
  },
  {
    "poem_id": 1768,
    "vorder": 31,
    "position": 0,
    "text": "همه رای با کاردانان زنیم"
  },
  {
    "poem_id": 1768,
    "vorder": 32,
    "position": 1,
    "text": "به تدبیر پشت هوا بشکنیم"
  },
  {
    "poem_id": 1768,
    "vorder": 33,
    "position": 0,
    "text": "ز دستور پرسیم یکسر سخن"
  },
  {
    "poem_id": 1768,
    "vorder": 34,
    "position": 1,
    "text": "چو کاری نو افگند خواهم ز بن"
  },
  {
    "poem_id": 1768,
    "vorder": 35,
    "position": 0,
    "text": "کسی کو همی داد خواهد ز من"
  },
  {
    "poem_id": 1768,
    "vorder": 36,
    "position": 1,
    "text": "نجویم پراگندن انجمن"
  },
  {
    "poem_id": 1768,
    "vorder": 37,
    "position": 0,
    "text": "دهم داد آنکس که او داد خواست"
  },
  {
    "poem_id": 1768,
    "vorder": 38,
    "position": 1,
    "text": "به چیزی نرانم سخن جز به راست"
  },
  {
    "poem_id": 1768,
    "vorder": 39,
    "position": 0,
    "text": "مکافات سازم بدان را به بد"
  },
  {
    "poem_id": 1768,
    "vorder": 40,
    "position": 1,
    "text": "چنان کز ره شهریاران سزد"
  },
  {
    "poem_id": 1768,
    "vorder": 41,
    "position": 0,
    "text": "برین پاک یزدان گوای منست"
  },
  {
    "poem_id": 1768,
    "vorder": 42,
    "position": 1,
    "text": "خرد بر زبان رهنمای منست"
  },
  {
    "poem_id": 1768,
    "vorder": 43,
    "position": 0,
    "text": "همان موبد و موبد موبدان"
  },
  {
    "poem_id": 1768,
    "vorder": 44,
    "position": 1,
    "text": "پسندیده و کاردیده ردان"
  },
  {
    "poem_id": 1768,
    "vorder": 45,
    "position": 0,
    "text": "برین کار یک سال گر بگذرد"
  },
  {
    "poem_id": 1768,
    "vorder": 46,
    "position": 1,
    "text": "نپیچم ز گفتار جان و خرد"
  },
  {
    "poem_id": 1768,
    "vorder": 47,
    "position": 0,
    "text": "ز میراث بیزارم و تاج و تخت"
  },
  {
    "poem_id": 1768,
    "vorder": 48,
    "position": 1,
    "text": "ازان پس نشینم بر شوربخت"
  },
  {
    "poem_id": 1768,
    "vorder": 49,
    "position": 0,
    "text": "چو پاسخ شنیدند آن بخردان"
  },
  {
    "poem_id": 1768,
    "vorder": 50,
    "position": 1,
    "text": "بزرگان و بیداردل موبدان"
  },
  {
    "poem_id": 1768,
    "vorder": 51,
    "position": 0,
    "text": "ز گفت گذشته پشیمان شدند"
  },
  {
    "poem_id": 1768,
    "vorder": 52,
    "position": 1,
    "text": "گنه کارگان سوی درمان شدند"
  },
  {
    "poem_id": 1768,
    "vorder": 53,
    "position": 0,
    "text": "به آواز گفتند یک با دگر"
  },
  {
    "poem_id": 1768,
    "vorder": 54,
    "position": 1,
    "text": "که شاهی بود زین سزاوارتر"
  },
  {
    "poem_id": 1768,
    "vorder": 55,
    "position": 0,
    "text": "به مردی و گفتار و رای و نژاد"
  },
  {
    "poem_id": 1768,
    "vorder": 56,
    "position": 1,
    "text": "ازین پاک‌تر در جهان کس نزاد"
  },
  {
    "poem_id": 1768,
    "vorder": 57,
    "position": 0,
    "text": "ز داد آفریدست ایزد ورا"
  },
  {
    "poem_id": 1768,
    "vorder": 58,
    "position": 1,
    "text": "مبادا که کاری رسد بد ورا"
  },
  {
    "poem_id": 1768,
    "vorder": 59,
    "position": 0,
    "text": "به گفتار اگر هیچ تاب آوریم"
  },
  {
    "poem_id": 1768,
    "vorder": 60,
    "position": 1,
    "text": "خرد را همی سر به خواب آوریم"
  },
  {
    "poem_id": 1768,
    "vorder": 61,
    "position": 0,
    "text": "همه نیکویها بیابیم ازوی"
  },
  {
    "poem_id": 1768,
    "vorder": 62,
    "position": 1,
    "text": "به خورد و به داد اندر آریم روی"
  },
  {
    "poem_id": 1768,
    "vorder": 63,
    "position": 0,
    "text": "بدین برز بالا و این شاخ و یال"
  },
  {
    "poem_id": 1768,
    "vorder": 64,
    "position": 1,
    "text": "به گیتی کسی نیست او را همال"
  },
  {
    "poem_id": 1768,
    "vorder": 65,
    "position": 0,
    "text": "پس پشت او لشکر تازیان"
  },
  {
    "poem_id": 1768,
    "vorder": 66,
    "position": 1,
    "text": "چو منذرش یاور به سود و زیان"
  },
  {
    "poem_id": 1768,
    "vorder": 67,
    "position": 0,
    "text": "اگر خود بگیرد سر گاه خویش"
  },
  {
    "poem_id": 1768,
    "vorder": 68,
    "position": 1,
    "text": "به گیتی که باشد ز بهرام بیش"
  },
  {
    "poem_id": 1768,
    "vorder": 69,
    "position": 0,
    "text": "ازان پس ز ایرانیانش چه باک"
  },
  {
    "poem_id": 1768,
    "vorder": 70,
    "position": 1,
    "text": "چه ما پیش او در چه یک مشت خاک"
  },
  {
    "poem_id": 1768,
    "vorder": 71,
    "position": 0,
    "text": "به بهرام گفتند کای فرمند"
  },
  {
    "poem_id": 1768,
    "vorder": 72,
    "position": 1,
    "text": "به شاهی توی جان ما را پسند"
  },
  {
    "poem_id": 1768,
    "vorder": 73,
    "position": 0,
    "text": "ندانست کس در هنرهای تو"
  },
  {
    "poem_id": 1768,
    "vorder": 74,
    "position": 1,
    "text": "به پاکی تن و دانش و رای تو"
  },
  {
    "poem_id": 1768,
    "vorder": 75,
    "position": 0,
    "text": "چو خسرو که بود از نژاد پشین"
  },
  {
    "poem_id": 1768,
    "vorder": 76,
    "position": 1,
    "text": "به شاهی برو خواندند آفرین"
  },
  {
    "poem_id": 1768,
    "vorder": 77,
    "position": 0,
    "text": "همه زیر سوگند و بند وییم"
  },
  {
    "poem_id": 1768,
    "vorder": 78,
    "position": 1,
    "text": "که گوید که اندر گزند وییم"
  },
  {
    "poem_id": 1768,
    "vorder": 79,
    "position": 0,
    "text": "گرو زین سپس شاه ایران بود"
  },
  {
    "poem_id": 1768,
    "vorder": 80,
    "position": 1,
    "text": "همه مرز در چنگ شیران بود"
  },
  {
    "poem_id": 1768,
    "vorder": 81,
    "position": 0,
    "text": "گروهی به بهرام باشند شاد"
  },
  {
    "poem_id": 1768,
    "vorder": 82,
    "position": 1,
    "text": "ز خسرو دگر پاره گیرند یاد"
  },
  {
    "poem_id": 1768,
    "vorder": 83,
    "position": 0,
    "text": "ز داد آن چنان به که پیمان تست"
  },
  {
    "poem_id": 1768,
    "vorder": 84,
    "position": 1,
    "text": "ازان پس جهان زیر فرمان تست"
  },
  {
    "poem_id": 1768,
    "vorder": 85,
    "position": 0,
    "text": "بهانه همان شیر جنگیست و بس"
  },
  {
    "poem_id": 1768,
    "vorder": 86,
    "position": 1,
    "text": "ازین پس بزرگی نجویند کس"
  },
  {
    "poem_id": 1768,
    "vorder": 87,
    "position": 0,
    "text": "بدان گشت بهرام همداستان"
  },
  {
    "poem_id": 1768,
    "vorder": 88,
    "position": 1,
    "text": "که آورد او پیش ازین داستان"
  },
  {
    "poem_id": 1768,
    "vorder": 89,
    "position": 0,
    "text": "چنین بود آیین شاهان داد"
  },
  {
    "poem_id": 1768,
    "vorder": 90,
    "position": 1,
    "text": "که چون نو بدی شاه فرخ‌نژاد"
  },
  {
    "poem_id": 1768,
    "vorder": 91,
    "position": 0,
    "text": "بر او شدی موبد موبدان"
  },
  {
    "poem_id": 1768,
    "vorder": 92,
    "position": 1,
    "text": "ببردی سه بینادل از بخردان"
  },
  {
    "poem_id": 1768,
    "vorder": 93,
    "position": 0,
    "text": "همو شاه بر گاه بنشاندی"
  },
  {
    "poem_id": 1768,
    "vorder": 94,
    "position": 1,
    "text": "بدان تاج بر آفرین خواندی"
  },
  {
    "poem_id": 1768,
    "vorder": 95,
    "position": 0,
    "text": "نهادی به نام کیان بر سرش"
  },
  {
    "poem_id": 1768,
    "vorder": 96,
    "position": 1,
    "text": "بسودی به شادی دو رخ بر برش"
  },
  {
    "poem_id": 1768,
    "vorder": 97,
    "position": 0,
    "text": "ازان پس هرانکس که بردی نثار"
  },
  {
    "poem_id": 1768,
    "vorder": 98,
    "position": 1,
    "text": "به خواهنده دادی همی شهریار"
  },
  {
    "poem_id": 1768,
    "vorder": 99,
    "position": 0,
    "text": "به موبد سپردند پس تاج و تخت"
  },
  {
    "poem_id": 1768,
    "vorder": 100,
    "position": 1,
    "text": "به هامون شد از شهر بیداربخت"
  },
  {
    "poem_id": 1768,
    "vorder": 101,
    "position": 0,
    "text": "دو شیر ژیان داشت گستهم گرد"
  },
  {
    "poem_id": 1768,
    "vorder": 102,
    "position": 1,
    "text": "به زنجیر بسته به موبد سپرد"
  },
  {
    "poem_id": 1768,
    "vorder": 103,
    "position": 0,
    "text": "ببردند شیران جنگی کشان"
  },
  {
    "poem_id": 1768,
    "vorder": 104,
    "position": 1,
    "text": "کشنده شد از بیم چون بیهشان"
  },
  {
    "poem_id": 1768,
    "vorder": 105,
    "position": 0,
    "text": "ببستند بر پایهٔ تخت عاج"
  },
  {
    "poem_id": 1768,
    "vorder": 106,
    "position": 1,
    "text": "نهادند بر گوشهٔ عاج تاج"
  },
  {
    "poem_id": 1768,
    "vorder": 107,
    "position": 0,
    "text": "جهانی نظاره بران تاج و تخت"
  },
  {
    "poem_id": 1768,
    "vorder": 108,
    "position": 1,
    "text": "که تا چون بود کار آن نیک‌بخت"
  },
  {
    "poem_id": 1768,
    "vorder": 109,
    "position": 0,
    "text": "که گر شاه پیروز گردد برین"
  },
  {
    "poem_id": 1768,
    "vorder": 110,
    "position": 1,
    "text": "برو شهریاران کنند آفرین"
  }
]