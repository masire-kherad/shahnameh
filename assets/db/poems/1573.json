[
  {
    "poem_id": 1573,
    "vorder": 1,
    "position": 0,
    "text": "دبیر جهاندیده را پیش خواند"
  },
  {
    "poem_id": 1573,
    "vorder": 2,
    "position": 1,
    "text": "ازان چاره و چنگ چندی براند"
  },
  {
    "poem_id": 1573,
    "vorder": 3,
    "position": 0,
    "text": "بر تخت بنشست فرخ دبیر"
  },
  {
    "poem_id": 1573,
    "vorder": 4,
    "position": 1,
    "text": "قلم خواست و قرطاس و مشک و عبیر"
  },
  {
    "poem_id": 1573,
    "vorder": 5,
    "position": 0,
    "text": "نخستین که نوک قلم شد سیاه"
  },
  {
    "poem_id": 1573,
    "vorder": 6,
    "position": 1,
    "text": "گرفت آفرین بر خداوند ماه"
  },
  {
    "poem_id": 1573,
    "vorder": 7,
    "position": 0,
    "text": "خداوند کیوان و ناهید و هور"
  },
  {
    "poem_id": 1573,
    "vorder": 8,
    "position": 1,
    "text": "خداوند پیل و خداوند مور"
  },
  {
    "poem_id": 1573,
    "vorder": 9,
    "position": 0,
    "text": "خداوند پیروزی و فرهی"
  },
  {
    "poem_id": 1573,
    "vorder": 10,
    "position": 1,
    "text": "خداوند دیهیم و شاهنشهی"
  },
  {
    "poem_id": 1573,
    "vorder": 11,
    "position": 0,
    "text": "خداوند جان و خداوند رای"
  },
  {
    "poem_id": 1573,
    "vorder": 12,
    "position": 1,
    "text": "خداوند نیکی‌ده و رهنمای"
  },
  {
    "poem_id": 1573,
    "vorder": 13,
    "position": 0,
    "text": "ازو جاودان کام گشتاسپ شاد"
  },
  {
    "poem_id": 1573,
    "vorder": 14,
    "position": 1,
    "text": "به مینو همه یاد لهراسپ باد"
  },
  {
    "poem_id": 1573,
    "vorder": 15,
    "position": 0,
    "text": "رسیدم به راهی به توران زمین"
  },
  {
    "poem_id": 1573,
    "vorder": 16,
    "position": 1,
    "text": "که هرگز نخوانم برو آفرین"
  },
  {
    "poem_id": 1573,
    "vorder": 17,
    "position": 0,
    "text": "اگر برگشایم سراسر سخن"
  },
  {
    "poem_id": 1573,
    "vorder": 18,
    "position": 1,
    "text": "سر مرد نو گردد از غم کهن"
  },
  {
    "poem_id": 1573,
    "vorder": 19,
    "position": 0,
    "text": "چه دستور باشد مرا شهریار"
  },
  {
    "poem_id": 1573,
    "vorder": 20,
    "position": 1,
    "text": "بخوانم برو نامهٔ کارزار"
  },
  {
    "poem_id": 1573,
    "vorder": 21,
    "position": 0,
    "text": "به دیدار او شاد و خرم شوم"
  },
  {
    "poem_id": 1573,
    "vorder": 22,
    "position": 1,
    "text": "ازین رنج دیرینه بی‌غم شوم"
  },
  {
    "poem_id": 1573,
    "vorder": 23,
    "position": 0,
    "text": "وزان چاره‌هایی که من ساختم"
  },
  {
    "poem_id": 1573,
    "vorder": 24,
    "position": 1,
    "text": "که تا دل ز کینه بپرداختم"
  },
  {
    "poem_id": 1573,
    "vorder": 25,
    "position": 0,
    "text": "به رویین دژ ارجاسپ و کهرم نماند"
  },
  {
    "poem_id": 1573,
    "vorder": 26,
    "position": 1,
    "text": "جز از مویه و درد و ماتم نماند"
  },
  {
    "poem_id": 1573,
    "vorder": 27,
    "position": 0,
    "text": "کسی را ندادم به جان زینهار"
  },
  {
    "poem_id": 1573,
    "vorder": 28,
    "position": 1,
    "text": "گیا در بیابان سرآورد بار"
  },
  {
    "poem_id": 1573,
    "vorder": 29,
    "position": 0,
    "text": "همی مغز مردم خورد شیر و گرگ"
  },
  {
    "poem_id": 1573,
    "vorder": 30,
    "position": 1,
    "text": "جز از دل نجوید پلنگ سترگ"
  },
  {
    "poem_id": 1573,
    "vorder": 31,
    "position": 0,
    "text": "فلک روشن از تاج گشتاسپ باد"
  },
  {
    "poem_id": 1573,
    "vorder": 32,
    "position": 1,
    "text": "زمین گلشن شاه لهراسپ باد"
  },
  {
    "poem_id": 1573,
    "vorder": 33,
    "position": 0,
    "text": "چو بر نامه بر مهر اسفندیار"
  },
  {
    "poem_id": 1573,
    "vorder": 34,
    "position": 1,
    "text": "نهادند و جستند چندی سوار"
  },
  {
    "poem_id": 1573,
    "vorder": 35,
    "position": 0,
    "text": "هیونان کفک‌افگن و تیزرو"
  },
  {
    "poem_id": 1573,
    "vorder": 36,
    "position": 1,
    "text": "به ایران فرستاد سالار نو"
  },
  {
    "poem_id": 1573,
    "vorder": 37,
    "position": 0,
    "text": "بماند از پی پاسخ نامه را"
  },
  {
    "poem_id": 1573,
    "vorder": 38,
    "position": 1,
    "text": "بکشت آتش مرد بدکامه را"
  },
  {
    "poem_id": 1573,
    "vorder": 39,
    "position": 0,
    "text": "بسی برنیامد که پاسخ رسید"
  },
  {
    "poem_id": 1573,
    "vorder": 40,
    "position": 1,
    "text": "یکی نامه بد بند بد را کلید"
  },
  {
    "poem_id": 1573,
    "vorder": 41,
    "position": 0,
    "text": "سر پاسخ نامه بود از نخست"
  },
  {
    "poem_id": 1573,
    "vorder": 42,
    "position": 1,
    "text": "که پاینده بادآنک نیکی بجست"
  },
  {
    "poem_id": 1573,
    "vorder": 43,
    "position": 0,
    "text": "خرد یافته مرد یزدان شناس"
  },
  {
    "poem_id": 1573,
    "vorder": 44,
    "position": 1,
    "text": "به نیکی ز یزدان شناسد سپاس"
  },
  {
    "poem_id": 1573,
    "vorder": 45,
    "position": 0,
    "text": "دگر گفت کز دادگر یک خدای"
  },
  {
    "poem_id": 1573,
    "vorder": 46,
    "position": 1,
    "text": "بخواهیم کو باشدت رهنمای"
  },
  {
    "poem_id": 1573,
    "vorder": 47,
    "position": 0,
    "text": "درختی بکشتم به باغ بهشت"
  },
  {
    "poem_id": 1573,
    "vorder": 48,
    "position": 1,
    "text": "کزان بارورتر فریدون نکشت"
  },
  {
    "poem_id": 1573,
    "vorder": 49,
    "position": 0,
    "text": "برش سرخ یاقوت و زر آمدست"
  },
  {
    "poem_id": 1573,
    "vorder": 50,
    "position": 1,
    "text": "همه برگ او زیب و فر آمدست"
  },
  {
    "poem_id": 1573,
    "vorder": 51,
    "position": 0,
    "text": "بماناد تا جاودان این درخت"
  },
  {
    "poem_id": 1573,
    "vorder": 52,
    "position": 1,
    "text": "ترا باد شادان دل و نیک‌بخت"
  },
  {
    "poem_id": 1573,
    "vorder": 53,
    "position": 0,
    "text": "یکی آنک گفتی که کین نیا"
  },
  {
    "poem_id": 1573,
    "vorder": 54,
    "position": 1,
    "text": "بجستم پر از چاره و کیمیا"
  },
  {
    "poem_id": 1573,
    "vorder": 55,
    "position": 0,
    "text": "دگر آنک گفتی ز خون ریختن"
  },
  {
    "poem_id": 1573,
    "vorder": 56,
    "position": 1,
    "text": "به تنها به رزم اندر آویختن"
  },
  {
    "poem_id": 1573,
    "vorder": 57,
    "position": 0,
    "text": "تن شهریاران گرامی بود"
  },
  {
    "poem_id": 1573,
    "vorder": 58,
    "position": 1,
    "text": "که از کوشش سخت نامی بود"
  },
  {
    "poem_id": 1573,
    "vorder": 59,
    "position": 0,
    "text": "نگهدار تن باش و آن خرد"
  },
  {
    "poem_id": 1573,
    "vorder": 60,
    "position": 1,
    "text": "که جان را به دانش خرد پرورد"
  },
  {
    "poem_id": 1573,
    "vorder": 61,
    "position": 0,
    "text": "سه دیگر که گفتی به جان زینهار"
  },
  {
    "poem_id": 1573,
    "vorder": 62,
    "position": 1,
    "text": "ندادم کسی را ز چندان سوار"
  },
  {
    "poem_id": 1573,
    "vorder": 63,
    "position": 0,
    "text": "همیشه دلت مهربان باد و گرم"
  },
  {
    "poem_id": 1573,
    "vorder": 64,
    "position": 1,
    "text": "پر از شرم جان لب پر آوای نرم"
  },
  {
    "poem_id": 1573,
    "vorder": 65,
    "position": 0,
    "text": "مبادا ترا پیشه خون ریختن"
  },
  {
    "poem_id": 1573,
    "vorder": 66,
    "position": 1,
    "text": "نه بی‌کینه با مهتر آویختن"
  },
  {
    "poem_id": 1573,
    "vorder": 67,
    "position": 0,
    "text": "به کین برادرت بی سی و هشت"
  },
  {
    "poem_id": 1573,
    "vorder": 68,
    "position": 1,
    "text": "از اندازه خون ریختن درگذشت"
  },
  {
    "poem_id": 1573,
    "vorder": 69,
    "position": 0,
    "text": "و دیگر کزان پیر گشته نیا"
  },
  {
    "poem_id": 1573,
    "vorder": 70,
    "position": 1,
    "text": "ز دل دور کرده بد و کیمیا"
  },
  {
    "poem_id": 1573,
    "vorder": 71,
    "position": 0,
    "text": "چو خون ریختندش تو خون ریختی"
  },
  {
    "poem_id": 1573,
    "vorder": 72,
    "position": 1,
    "text": "چو شیران جنگی برآویختی"
  },
  {
    "poem_id": 1573,
    "vorder": 73,
    "position": 0,
    "text": "همیشه بدی شاد و به روزگار"
  },
  {
    "poem_id": 1573,
    "vorder": 74,
    "position": 1,
    "text": "روان را خرد بادت آموزگار"
  },
  {
    "poem_id": 1573,
    "vorder": 75,
    "position": 0,
    "text": "نیازست ما را به دیدار تو"
  },
  {
    "poem_id": 1573,
    "vorder": 76,
    "position": 1,
    "text": "بدان پر خرد جان بیدار تو"
  },
  {
    "poem_id": 1573,
    "vorder": 77,
    "position": 0,
    "text": "چه نامه بخوانی بنه بر نشان"
  },
  {
    "poem_id": 1573,
    "vorder": 78,
    "position": 1,
    "text": "بدین بارگاه آی با سرکشان"
  },
  {
    "poem_id": 1573,
    "vorder": 79,
    "position": 0,
    "text": "هیون تگاور ز در بازگشت"
  },
  {
    "poem_id": 1573,
    "vorder": 80,
    "position": 1,
    "text": "همه شهر ایران پرآواز گشت"
  },
  {
    "poem_id": 1573,
    "vorder": 81,
    "position": 0,
    "text": "سوار هیونان چو باز آمدند"
  },
  {
    "poem_id": 1573,
    "vorder": 82,
    "position": 1,
    "text": "به نزد تهمتن فراز آمدند"
  }
]