[
  {
    "poem_id": 1512,
    "vorder": 1,
    "position": 0,
    "text": "همی رفت گشتاسپ پرتاب و خشم"
  },
  {
    "poem_id": 1512,
    "vorder": 2,
    "position": 1,
    "text": "دلی پر ز کین و پر از آب چشم"
  },
  {
    "poem_id": 1512,
    "vorder": 3,
    "position": 0,
    "text": "همی تاخت تا پیش کابل رسید"
  },
  {
    "poem_id": 1512,
    "vorder": 4,
    "position": 1,
    "text": "درخت و گل و سبزه و آب دید"
  },
  {
    "poem_id": 1512,
    "vorder": 5,
    "position": 0,
    "text": "بدان جای خرم فرود آمدند"
  },
  {
    "poem_id": 1512,
    "vorder": 6,
    "position": 1,
    "text": "ببودند یک روز و دم بر زدند"
  },
  {
    "poem_id": 1512,
    "vorder": 7,
    "position": 0,
    "text": "همه کوهسارانش نخچیر بود"
  },
  {
    "poem_id": 1512,
    "vorder": 8,
    "position": 1,
    "text": "به جوی آبها چون می و شیر بود"
  },
  {
    "poem_id": 1512,
    "vorder": 9,
    "position": 0,
    "text": "شب تیره می‌ خواست از میگسار"
  },
  {
    "poem_id": 1512,
    "vorder": 10,
    "position": 1,
    "text": "ببردند شمع از بر جویبار"
  },
  {
    "poem_id": 1512,
    "vorder": 11,
    "position": 0,
    "text": "چو بفروخت از کوه گیتی فروز"
  },
  {
    "poem_id": 1512,
    "vorder": 12,
    "position": 1,
    "text": "برفتند ازآن بیشه با باز و یوز"
  },
  {
    "poem_id": 1512,
    "vorder": 13,
    "position": 0,
    "text": "همی تاخت اسپ از پی او زریر"
  },
  {
    "poem_id": 1512,
    "vorder": 14,
    "position": 1,
    "text": "زمانی به جایی نیاسود دیر"
  },
  {
    "poem_id": 1512,
    "vorder": 15,
    "position": 0,
    "text": "چو آواز اسپان برآمد ز راه"
  },
  {
    "poem_id": 1512,
    "vorder": 16,
    "position": 1,
    "text": "برفتند گردان ز نخچیرگاه"
  },
  {
    "poem_id": 1512,
    "vorder": 17,
    "position": 0,
    "text": "چو بنهاد گشتاسپ گوش اندر آن"
  },
  {
    "poem_id": 1512,
    "vorder": 18,
    "position": 1,
    "text": "چنین گفت با نامور مهتران"
  },
  {
    "poem_id": 1512,
    "vorder": 19,
    "position": 0,
    "text": "که این جز به آواز اسپ زریر"
  },
  {
    "poem_id": 1512,
    "vorder": 20,
    "position": 1,
    "text": "نماند که او راست آواز شیر"
  },
  {
    "poem_id": 1512,
    "vorder": 21,
    "position": 0,
    "text": "نه تنها بیامد گر او آمدست"
  },
  {
    "poem_id": 1512,
    "vorder": 22,
    "position": 1,
    "text": "که با لشکری جنگجو آمدست"
  },
  {
    "poem_id": 1512,
    "vorder": 23,
    "position": 0,
    "text": "هنوز اندرین بد که گردی بنفش"
  },
  {
    "poem_id": 1512,
    "vorder": 24,
    "position": 1,
    "text": "پدید آمد و پیل پیکر درفش"
  },
  {
    "poem_id": 1512,
    "vorder": 25,
    "position": 0,
    "text": "زریر سپهبد به پیش سپاه"
  },
  {
    "poem_id": 1512,
    "vorder": 26,
    "position": 1,
    "text": "چو باد دمان اندر آمد ز راه"
  },
  {
    "poem_id": 1512,
    "vorder": 27,
    "position": 0,
    "text": "چو گشتاسپ را دید گریان برفت"
  },
  {
    "poem_id": 1512,
    "vorder": 28,
    "position": 1,
    "text": "پیاده بدو روی بنهاد تفت"
  },
  {
    "poem_id": 1512,
    "vorder": 29,
    "position": 0,
    "text": "جهان‌آفرین را ستایش گرفت"
  },
  {
    "poem_id": 1512,
    "vorder": 30,
    "position": 1,
    "text": "به پیش برادر نیایش گرفت"
  },
  {
    "poem_id": 1512,
    "vorder": 31,
    "position": 0,
    "text": "گرفتند مر یکدگر را کنار"
  },
  {
    "poem_id": 1512,
    "vorder": 32,
    "position": 1,
    "text": "نشستند شادان در آن مرغزار"
  },
  {
    "poem_id": 1512,
    "vorder": 33,
    "position": 0,
    "text": "ز لشکر هر آنکس که بد پیشرو"
  },
  {
    "poem_id": 1512,
    "vorder": 34,
    "position": 1,
    "text": "ورا خواندی شاه گشتاسپ گو"
  },
  {
    "poem_id": 1512,
    "vorder": 35,
    "position": 0,
    "text": "بخواندند و نزدیک بنشاندند"
  },
  {
    "poem_id": 1512,
    "vorder": 36,
    "position": 1,
    "text": "ز هر جایگاهی سخن راندند"
  },
  {
    "poem_id": 1512,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت زیشان یکی نامور"
  },
  {
    "poem_id": 1512,
    "vorder": 38,
    "position": 1,
    "text": "به گشتاسپ کای گرد زرین کمر"
  },
  {
    "poem_id": 1512,
    "vorder": 39,
    "position": 0,
    "text": "ستاره‌شناسان ایران گروه"
  },
  {
    "poem_id": 1512,
    "vorder": 40,
    "position": 1,
    "text": "هرانکس که دانیم دانش پژوه"
  },
  {
    "poem_id": 1512,
    "vorder": 41,
    "position": 0,
    "text": "به اخترت گویند کیخسروی"
  },
  {
    "poem_id": 1512,
    "vorder": 42,
    "position": 1,
    "text": "به شاهی به تخت مهی بر شوی"
  },
  {
    "poem_id": 1512,
    "vorder": 43,
    "position": 0,
    "text": "کنون افسر شاه هندوستان"
  },
  {
    "poem_id": 1512,
    "vorder": 44,
    "position": 1,
    "text": "بپوشی نباشیم همداستان"
  },
  {
    "poem_id": 1512,
    "vorder": 45,
    "position": 0,
    "text": "ازیشان کسی نیست یزدان پرست"
  },
  {
    "poem_id": 1512,
    "vorder": 46,
    "position": 1,
    "text": "یکی هم ندارند با شاه دست"
  },
  {
    "poem_id": 1512,
    "vorder": 47,
    "position": 0,
    "text": "نگر تا پسند آید اندر خرد"
  },
  {
    "poem_id": 1512,
    "vorder": 48,
    "position": 1,
    "text": "کجا رای را شاه فرمان برد"
  },
  {
    "poem_id": 1512,
    "vorder": 49,
    "position": 0,
    "text": "ترا از پدر سربسر نیکویست"
  },
  {
    "poem_id": 1512,
    "vorder": 50,
    "position": 1,
    "text": "ندانم که آزردن از بهر چیست"
  },
  {
    "poem_id": 1512,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای نامجوی"
  },
  {
    "poem_id": 1512,
    "vorder": 52,
    "position": 1,
    "text": "ندارم به پیش پدر آبروی"
  },
  {
    "poem_id": 1512,
    "vorder": 53,
    "position": 0,
    "text": "به کاوسیان خواهد او نیکوی"
  },
  {
    "poem_id": 1512,
    "vorder": 54,
    "position": 1,
    "text": "بزرگی و هم افسر خسروی"
  },
  {
    "poem_id": 1512,
    "vorder": 55,
    "position": 0,
    "text": "اگر تاج ایران سپارد به من"
  },
  {
    "poem_id": 1512,
    "vorder": 56,
    "position": 1,
    "text": "پرستش کنم چون بتان را شمن"
  },
  {
    "poem_id": 1512,
    "vorder": 57,
    "position": 0,
    "text": "وگرنه نباشم به درگاه اوی"
  },
  {
    "poem_id": 1512,
    "vorder": 58,
    "position": 1,
    "text": "ندارم دل روشن از ماه اوی"
  },
  {
    "poem_id": 1512,
    "vorder": 59,
    "position": 0,
    "text": "به جایی شوم کم نیابند نیز"
  },
  {
    "poem_id": 1512,
    "vorder": 60,
    "position": 1,
    "text": "به لهراسپ مانم همه مرز و چیز"
  },
  {
    "poem_id": 1512,
    "vorder": 61,
    "position": 0,
    "text": "بگفت این و برگشت زان مرغزار"
  },
  {
    "poem_id": 1512,
    "vorder": 62,
    "position": 1,
    "text": "بیامد بر نامور شهریار"
  },
  {
    "poem_id": 1512,
    "vorder": 63,
    "position": 0,
    "text": "چو بشنید لهراسپ با مهتران"
  },
  {
    "poem_id": 1512,
    "vorder": 64,
    "position": 1,
    "text": "پذیره شدش با سپاهی گران"
  },
  {
    "poem_id": 1512,
    "vorder": 65,
    "position": 0,
    "text": "جهانجوی روی پدر دید باز"
  },
  {
    "poem_id": 1512,
    "vorder": 66,
    "position": 1,
    "text": "فرود آمد از باره بردش نماز"
  },
  {
    "poem_id": 1512,
    "vorder": 67,
    "position": 0,
    "text": "ورا تنگ لهراسپ در برگرفت"
  },
  {
    "poem_id": 1512,
    "vorder": 68,
    "position": 1,
    "text": "بدان پوزش آرایش اندر گرفت"
  },
  {
    "poem_id": 1512,
    "vorder": 69,
    "position": 0,
    "text": "که تاج تو تاج سر ماه باد"
  },
  {
    "poem_id": 1512,
    "vorder": 70,
    "position": 1,
    "text": "ز تو دیو را دست کوتاه باد"
  },
  {
    "poem_id": 1512,
    "vorder": 71,
    "position": 0,
    "text": "که هرگز نیاموزدت راه بد"
  },
  {
    "poem_id": 1512,
    "vorder": 72,
    "position": 1,
    "text": "چو دستور بد بر در شاه بد"
  },
  {
    "poem_id": 1512,
    "vorder": 73,
    "position": 0,
    "text": "ز شاهی مرا نام تاجست و تخت"
  },
  {
    "poem_id": 1512,
    "vorder": 74,
    "position": 1,
    "text": "ترا مهر و فرمان و پیمان و بخت"
  },
  {
    "poem_id": 1512,
    "vorder": 75,
    "position": 0,
    "text": "ورا گفت گشتاسپ کای شهریار"
  },
  {
    "poem_id": 1512,
    "vorder": 76,
    "position": 1,
    "text": "منم بر درت بر یکی پیشکار"
  },
  {
    "poem_id": 1512,
    "vorder": 77,
    "position": 0,
    "text": "اگر کم کنی جاه فرمان کنم"
  },
  {
    "poem_id": 1512,
    "vorder": 78,
    "position": 1,
    "text": "به پیمان روان را گروگان کنم"
  },
  {
    "poem_id": 1512,
    "vorder": 79,
    "position": 0,
    "text": "بزرگان برفتند با او به راه"
  },
  {
    "poem_id": 1512,
    "vorder": 80,
    "position": 1,
    "text": "گرازان و پویان به ایوان شاه"
  },
  {
    "poem_id": 1512,
    "vorder": 81,
    "position": 0,
    "text": "بیاراست ایوان گوهرنگار"
  },
  {
    "poem_id": 1512,
    "vorder": 82,
    "position": 1,
    "text": "نهادند خوان و می خوشگوار"
  },
  {
    "poem_id": 1512,
    "vorder": 83,
    "position": 0,
    "text": "یکی جشن کردند کز چرخ ماه"
  },
  {
    "poem_id": 1512,
    "vorder": 84,
    "position": 1,
    "text": "ستاره ببارید بر جشنگاه"
  },
  {
    "poem_id": 1512,
    "vorder": 85,
    "position": 0,
    "text": "چنان بد ز مستی که هر مهتری"
  },
  {
    "poem_id": 1512,
    "vorder": 86,
    "position": 1,
    "text": "برفتند بر سر ز زر افسری"
  },
  {
    "poem_id": 1512,
    "vorder": 87,
    "position": 0,
    "text": "به کاوسیان بود لهراسپ شاد"
  },
  {
    "poem_id": 1512,
    "vorder": 88,
    "position": 1,
    "text": "همیشه ز کیخسروش بود یاد"
  },
  {
    "poem_id": 1512,
    "vorder": 89,
    "position": 0,
    "text": "همی ریخت زان درد گشتاسپ خون"
  },
  {
    "poem_id": 1512,
    "vorder": 90,
    "position": 1,
    "text": "همی گفت هرگونه با رهنمون"
  },
  {
    "poem_id": 1512,
    "vorder": 91,
    "position": 0,
    "text": "همی گفت هرچند کوشم به رای"
  },
  {
    "poem_id": 1512,
    "vorder": 92,
    "position": 1,
    "text": "نیارم همی چارهٔ این به جای"
  },
  {
    "poem_id": 1512,
    "vorder": 93,
    "position": 0,
    "text": "اگر با سواران شوم مهتری"
  },
  {
    "poem_id": 1512,
    "vorder": 94,
    "position": 1,
    "text": "فرستد پسم نیز با لشکری"
  },
  {
    "poem_id": 1512,
    "vorder": 95,
    "position": 0,
    "text": "به چاره ز ره بازگرداندم"
  },
  {
    "poem_id": 1512,
    "vorder": 96,
    "position": 1,
    "text": "بسی خواهش و پندها راندم"
  },
  {
    "poem_id": 1512,
    "vorder": 97,
    "position": 0,
    "text": "چو تنها شوم ننگ دارم همی"
  },
  {
    "poem_id": 1512,
    "vorder": 98,
    "position": 1,
    "text": "ز لهراسپ دل تنگ دارم همی"
  },
  {
    "poem_id": 1512,
    "vorder": 99,
    "position": 0,
    "text": "دل او به کاوسیانست شاد"
  },
  {
    "poem_id": 1512,
    "vorder": 100,
    "position": 1,
    "text": "نیاید گذر مهر او بر نژاد"
  },
  {
    "poem_id": 1512,
    "vorder": 101,
    "position": 0,
    "text": "چو یک تن بود کم کند خواستار"
  },
  {
    "poem_id": 1512,
    "vorder": 102,
    "position": 1,
    "text": "چه داند که من چون شدم شهریار"
  }
]