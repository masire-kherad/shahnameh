[
  {
    "poem_id": 1406,
    "vorder": 1,
    "position": 0,
    "text": "چو سوگ پدر شاه نوذر بداشت"
  },
  {
    "poem_id": 1406,
    "vorder": 2,
    "position": 1,
    "text": "ز کیوان کلاه کیی برفراشت"
  },
  {
    "poem_id": 1406,
    "vorder": 3,
    "position": 0,
    "text": "به تخت منوچهر بر بار داد"
  },
  {
    "poem_id": 1406,
    "vorder": 4,
    "position": 1,
    "text": "بخواند انجمن را و دینار داد"
  },
  {
    "poem_id": 1406,
    "vorder": 5,
    "position": 0,
    "text": "برین برنیامد بسی روزگار"
  },
  {
    "poem_id": 1406,
    "vorder": 6,
    "position": 1,
    "text": "که بیدادگر شد سر شهریار:"
  },
  {
    "poem_id": 1406,
    "vorder": 7,
    "position": 0,
    "text": "ز گیتی برآمد به هر جای غَو"
  },
  {
    "poem_id": 1406,
    "vorder": 8,
    "position": 1,
    "text": "جهان را کهن شد سر از شاه نو"
  },
  {
    "poem_id": 1406,
    "vorder": 9,
    "position": 0,
    "text": "چو او رسمهای پدر درنَوَشت"
  },
  {
    "poem_id": 1406,
    "vorder": 10,
    "position": 1,
    "text": "ابا موبدان و ردان تیز گشت؛"
  },
  {
    "poem_id": 1406,
    "vorder": 11,
    "position": 0,
    "text": "همی مردمی نزد او خوار شد"
  },
  {
    "poem_id": 1406,
    "vorder": 12,
    "position": 1,
    "text": "دلش بردهٔ گنج و دینار شد"
  },
  {
    "poem_id": 1406,
    "vorder": 13,
    "position": 0,
    "text": "کدیور یکایک سپاهی شدند"
  },
  {
    "poem_id": 1406,
    "vorder": 14,
    "position": 1,
    "text": "دلیران سزاوار شاهی شدند"
  },
  {
    "poem_id": 1406,
    "vorder": 15,
    "position": 0,
    "text": "چو از روی کشور برآمد خروش"
  },
  {
    "poem_id": 1406,
    "vorder": 16,
    "position": 1,
    "text": "جهانی سراسر برآمد به جوش"
  },
  {
    "poem_id": 1406,
    "vorder": 17,
    "position": 0,
    "text": "بترسید بیدادگر شهریار"
  },
  {
    "poem_id": 1406,
    "vorder": 18,
    "position": 1,
    "text": "فرستاد کس نزد سام سوار"
  },
  {
    "poem_id": 1406,
    "vorder": 19,
    "position": 0,
    "text": "به سگسار مازندران بود سام"
  },
  {
    "poem_id": 1406,
    "vorder": 20,
    "position": 1,
    "text": "فرستاد نوذر بر او بر پیام"
  },
  {
    "poem_id": 1406,
    "vorder": 21,
    "position": 0,
    "text": "«خداوند کیوان و بهرام و هور"
  },
  {
    "poem_id": 1406,
    "vorder": 22,
    "position": 1,
    "text": "که هست آفرینندهٔ پیل و مور"
  },
  {
    "poem_id": 1406,
    "vorder": 23,
    "position": 0,
    "text": "نه دشواری از چیز برترمنش"
  },
  {
    "poem_id": 1406,
    "vorder": 24,
    "position": 1,
    "text": "نه آسانی از اندک اندر بوش"
  },
  {
    "poem_id": 1406,
    "vorder": 25,
    "position": 0,
    "text": "همه با توانایی او یکیست"
  },
  {
    "poem_id": 1406,
    "vorder": 26,
    "position": 1,
    "text": "اگر هست بسیار و گر اندکیست"
  },
  {
    "poem_id": 1406,
    "vorder": 27,
    "position": 0,
    "text": "کنون از خداوند خورشید و ماه"
  },
  {
    "poem_id": 1406,
    "vorder": 28,
    "position": 1,
    "text": "ثنا بر روان منوچهر شاه"
  },
  {
    "poem_id": 1406,
    "vorder": 29,
    "position": 0,
    "text": "ابر سام یل باد چندان درود"
  },
  {
    "poem_id": 1406,
    "vorder": 30,
    "position": 1,
    "text": "که آید همی ز ابر باران فرود"
  },
  {
    "poem_id": 1406,
    "vorder": 31,
    "position": 0,
    "text": "مران پهلوان جهاندیده را"
  },
  {
    "poem_id": 1406,
    "vorder": 32,
    "position": 1,
    "text": "سرافراز گرد پسندیده را"
  },
  {
    "poem_id": 1406,
    "vorder": 33,
    "position": 0,
    "text": "همیشه دل و هوشش آباد باد"
  },
  {
    "poem_id": 1406,
    "vorder": 34,
    "position": 1,
    "text": "روانش ز هر درد آزاد باد"
  },
  {
    "poem_id": 1406,
    "vorder": 35,
    "position": 0,
    "text": "شناسد مگر پهلوان جهان"
  },
  {
    "poem_id": 1406,
    "vorder": 36,
    "position": 1,
    "text": "سخنها هم از آشکار و نهان"
  },
  {
    "poem_id": 1406,
    "vorder": 37,
    "position": 0,
    "text": "که تا شاه مژگان به هم برنهاد"
  },
  {
    "poem_id": 1406,
    "vorder": 38,
    "position": 1,
    "text": "ز سام نریمان بسی کرد یاد"
  },
  {
    "poem_id": 1406,
    "vorder": 39,
    "position": 0,
    "text": "همیدون مرا پشت گرمی بدوست"
  },
  {
    "poem_id": 1406,
    "vorder": 40,
    "position": 1,
    "text": "که هم پهلوانست و هم شاه دوست"
  },
  {
    "poem_id": 1406,
    "vorder": 41,
    "position": 0,
    "text": "نگهبان کشور به هنگام شاه"
  },
  {
    "poem_id": 1406,
    "vorder": 42,
    "position": 1,
    "text": "ازویست رخشنده فرخ کلاه"
  },
  {
    "poem_id": 1406,
    "vorder": 43,
    "position": 0,
    "text": "کنون پادشاهی پرآشوب گشت"
  },
  {
    "poem_id": 1406,
    "vorder": 44,
    "position": 1,
    "text": "سخنها از اندازه اندر گذشت"
  },
  {
    "poem_id": 1406,
    "vorder": 45,
    "position": 0,
    "text": "اگر برنگیرد وی آن گرز کین"
  },
  {
    "poem_id": 1406,
    "vorder": 46,
    "position": 1,
    "text": "ازین تخت پردخته ماند زمین»"
  },
  {
    "poem_id": 1406,
    "vorder": 47,
    "position": 0,
    "text": "چو نامه بر سام نیرم رسید"
  },
  {
    "poem_id": 1406,
    "vorder": 48,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1406,
    "vorder": 49,
    "position": 0,
    "text": "به شبگیر هنگام بانگ خروس"
  },
  {
    "poem_id": 1406,
    "vorder": 50,
    "position": 1,
    "text": "برآمد خروشیدن بوق و کوس"
  },
  {
    "poem_id": 1406,
    "vorder": 51,
    "position": 0,
    "text": "یکی لشکری راند از گرگسار"
  },
  {
    "poem_id": 1406,
    "vorder": 52,
    "position": 1,
    "text": "که دریای سبز اندرو گشت خوار"
  },
  {
    "poem_id": 1406,
    "vorder": 53,
    "position": 0,
    "text": "چو نزدیک ایران رسید آن سپاه"
  },
  {
    "poem_id": 1406,
    "vorder": 54,
    "position": 1,
    "text": "پذیره شدندش بزرگان به راه"
  },
  {
    "poem_id": 1406,
    "vorder": 55,
    "position": 0,
    "text": "پیاده همه پیش سام دلیر"
  },
  {
    "poem_id": 1406,
    "vorder": 56,
    "position": 1,
    "text": "برفتند و گفتند هر گونه دیر"
  },
  {
    "poem_id": 1406,
    "vorder": 57,
    "position": 0,
    "text": "ز بیدادی نوذر تاجور"
  },
  {
    "poem_id": 1406,
    "vorder": 58,
    "position": 1,
    "text": "که بر خیره گم کرد راه پدر"
  },
  {
    "poem_id": 1406,
    "vorder": 59,
    "position": 0,
    "text": "جهان گشت ویران ز کردار اوی"
  },
  {
    "poem_id": 1406,
    "vorder": 60,
    "position": 1,
    "text": "غنوده شد آن بخت بیدار اوی"
  },
  {
    "poem_id": 1406,
    "vorder": 61,
    "position": 0,
    "text": "بگردد همی از ره بخردی"
  },
  {
    "poem_id": 1406,
    "vorder": 62,
    "position": 1,
    "text": "ازو دور شد فرهٔ ایزدی"
  },
  {
    "poem_id": 1406,
    "vorder": 63,
    "position": 0,
    "text": "چه باشد اگر سام یل پهلوان"
  },
  {
    "poem_id": 1406,
    "vorder": 64,
    "position": 1,
    "text": "نشیند برین تخت روشن روان"
  },
  {
    "poem_id": 1406,
    "vorder": 65,
    "position": 0,
    "text": "جهان گردد آباد با داد او"
  },
  {
    "poem_id": 1406,
    "vorder": 66,
    "position": 1,
    "text": "برویست ایران و بنیاد او"
  },
  {
    "poem_id": 1406,
    "vorder": 67,
    "position": 0,
    "text": "که ما بنده باشیم و فرمان کنیم"
  },
  {
    "poem_id": 1406,
    "vorder": 68,
    "position": 1,
    "text": "روانها به مهرش گروگان کنیم"
  },
  {
    "poem_id": 1406,
    "vorder": 69,
    "position": 0,
    "text": "بدیشان چنین گفت سام سوار"
  },
  {
    "poem_id": 1406,
    "vorder": 70,
    "position": 1,
    "text": "که این کی پسندد ز من کردگار"
  },
  {
    "poem_id": 1406,
    "vorder": 71,
    "position": 0,
    "text": "که چون نوذری از نژاد کیان"
  },
  {
    "poem_id": 1406,
    "vorder": 72,
    "position": 1,
    "text": "به تخت کیی بر کمر بر میان"
  },
  {
    "poem_id": 1406,
    "vorder": 73,
    "position": 0,
    "text": "به شاهی مرا تاج باید بسود"
  },
  {
    "poem_id": 1406,
    "vorder": 74,
    "position": 1,
    "text": "محالست و این کس نیارد شنود"
  },
  {
    "poem_id": 1406,
    "vorder": 75,
    "position": 0,
    "text": "خود این گفت یارد کس اندر جهان!"
  },
  {
    "poem_id": 1406,
    "vorder": 76,
    "position": 1,
    "text": "چنین زهره دارد کس اندر نهان؟"
  },
  {
    "poem_id": 1406,
    "vorder": 77,
    "position": 0,
    "text": "اگر دختری از منوچهر شاه"
  },
  {
    "poem_id": 1406,
    "vorder": 78,
    "position": 1,
    "text": "بران تخت زرین شدی با کلاه"
  },
  {
    "poem_id": 1406,
    "vorder": 79,
    "position": 0,
    "text": "نبودی جز از خاک بالین من"
  },
  {
    "poem_id": 1406,
    "vorder": 80,
    "position": 1,
    "text": "بدو شاد بودی جهانبین من"
  },
  {
    "poem_id": 1406,
    "vorder": 81,
    "position": 0,
    "text": "دلش گر ز راه پدر گشت باز"
  },
  {
    "poem_id": 1406,
    "vorder": 82,
    "position": 1,
    "text": "برین‌بر نیامد زمانی دراز"
  },
  {
    "poem_id": 1406,
    "vorder": 83,
    "position": 0,
    "text": "هنوز آهنی نیست زنگار خورد"
  },
  {
    "poem_id": 1406,
    "vorder": 84,
    "position": 1,
    "text": "که رخشنده دشوار شایدش کرد"
  },
  {
    "poem_id": 1406,
    "vorder": 85,
    "position": 0,
    "text": "من آن ایزدی فره باز آورم"
  },
  {
    "poem_id": 1406,
    "vorder": 86,
    "position": 1,
    "text": "جهان را به مهرش نیاز آورم"
  },
  {
    "poem_id": 1406,
    "vorder": 87,
    "position": 0,
    "text": "شما بر گذشته پشیمان شوید"
  },
  {
    "poem_id": 1406,
    "vorder": 88,
    "position": 1,
    "text": "به نوی ز سر باز پیمان شوید"
  },
  {
    "poem_id": 1406,
    "vorder": 89,
    "position": 0,
    "text": "گر آمرزش کردگار سپهر"
  },
  {
    "poem_id": 1406,
    "vorder": 90,
    "position": 1,
    "text": "نیابید و از نوذر شاه مهر"
  },
  {
    "poem_id": 1406,
    "vorder": 91,
    "position": 0,
    "text": "بدین گیتی اندر بود خشم شاه"
  },
  {
    "poem_id": 1406,
    "vorder": 92,
    "position": 1,
    "text": "به برگشتن آتش بود جایگاه"
  },
  {
    "poem_id": 1406,
    "vorder": 93,
    "position": 0,
    "text": "بزرگان ز کرده پشیمان شدند"
  },
  {
    "poem_id": 1406,
    "vorder": 94,
    "position": 1,
    "text": "یکایک ز سر باز پیمان شدند"
  },
  {
    "poem_id": 1406,
    "vorder": 95,
    "position": 0,
    "text": "چو آمد به درگاه سام سوار"
  },
  {
    "poem_id": 1406,
    "vorder": 96,
    "position": 1,
    "text": "پذیره شدش نوذر شهریار"
  },
  {
    "poem_id": 1406,
    "vorder": 97,
    "position": 0,
    "text": "به فرخ پی نامور پهلوان"
  },
  {
    "poem_id": 1406,
    "vorder": 98,
    "position": 1,
    "text": "جهان سر به سر شد به نوی جوان"
  },
  {
    "poem_id": 1406,
    "vorder": 99,
    "position": 0,
    "text": "به پوزش مهان پیش نوذر شدند"
  },
  {
    "poem_id": 1406,
    "vorder": 100,
    "position": 1,
    "text": "به جان و به دل ویژه کهتر شدند"
  },
  {
    "poem_id": 1406,
    "vorder": 101,
    "position": 0,
    "text": "برافروخت نوذر ز تخت مهی"
  },
  {
    "poem_id": 1406,
    "vorder": 102,
    "position": 1,
    "text": "نشست اندر آرام با فرهی"
  },
  {
    "poem_id": 1406,
    "vorder": 103,
    "position": 0,
    "text": "جهان پهلوان پیش نوذر به پای"
  },
  {
    "poem_id": 1406,
    "vorder": 104,
    "position": 1,
    "text": "پرستنده او بود و هم رهنمای"
  },
  {
    "poem_id": 1406,
    "vorder": 105,
    "position": 0,
    "text": "به نوذر در پندها را گشاد"
  },
  {
    "poem_id": 1406,
    "vorder": 106,
    "position": 1,
    "text": "سخنهای نیکو بسی کرد یاد"
  },
  {
    "poem_id": 1406,
    "vorder": 107,
    "position": 0,
    "text": "ز گرد فریدون و هوشنگ شاه"
  },
  {
    "poem_id": 1406,
    "vorder": 108,
    "position": 1,
    "text": "همان از منوچهر زیبای گاه"
  },
  {
    "poem_id": 1406,
    "vorder": 109,
    "position": 0,
    "text": "که گیتی بداد و دهش داشتند"
  },
  {
    "poem_id": 1406,
    "vorder": 110,
    "position": 1,
    "text": "به بیداد بر چشم نگماشتند"
  },
  {
    "poem_id": 1406,
    "vorder": 111,
    "position": 0,
    "text": "دل او ز کژی به داد آورید"
  },
  {
    "poem_id": 1406,
    "vorder": 112,
    "position": 1,
    "text": "چنان کرد نوذر که او رای دید"
  },
  {
    "poem_id": 1406,
    "vorder": 113,
    "position": 0,
    "text": "دل مهتران را بدو نرم کرد"
  },
  {
    "poem_id": 1406,
    "vorder": 114,
    "position": 1,
    "text": "همه داد و بنیاد آزرم کرد"
  },
  {
    "poem_id": 1406,
    "vorder": 115,
    "position": 0,
    "text": "چو گفته شد از گفتنیها همه"
  },
  {
    "poem_id": 1406,
    "vorder": 116,
    "position": 1,
    "text": "به گردنکشان و به شاه رمه"
  },
  {
    "poem_id": 1406,
    "vorder": 117,
    "position": 0,
    "text": "برون رفت با خلعت نوذری"
  },
  {
    "poem_id": 1406,
    "vorder": 118,
    "position": 1,
    "text": "چه تخت و چه تاج و چه انگشتری"
  },
  {
    "poem_id": 1406,
    "vorder": 119,
    "position": 0,
    "text": "غلامان و اسپان زرین ستام"
  },
  {
    "poem_id": 1406,
    "vorder": 120,
    "position": 1,
    "text": "پر از گوهر سرخ زرین دو جام"
  },
  {
    "poem_id": 1406,
    "vorder": 121,
    "position": 0,
    "text": "برین نیز بگذشت چندی سپهر"
  },
  {
    "poem_id": 1406,
    "vorder": 122,
    "position": 1,
    "text": "نه با نوذر آرام بودش نه مهر"
  }
]