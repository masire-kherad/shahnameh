[
  {
    "poem_id": 88075,
    "vorder": 1,
    "position": 0,
    "text": "دبیر نویسنده را پیش خواند"
  },
  {
    "poem_id": 88075,
    "vorder": 2,
    "position": 1,
    "text": "سخن هرچه بایست با او براند"
  },
  {
    "poem_id": 88075,
    "vorder": 3,
    "position": 0,
    "text": "سر نامه کرد آفرین از نخست"
  },
  {
    "poem_id": 88075,
    "vorder": 4,
    "position": 1,
    "text": "بدان کو زمین از بدیها بشست"
  },
  {
    "poem_id": 88075,
    "vorder": 5,
    "position": 0,
    "text": "چنان اختر خفته بیدار کرد"
  },
  {
    "poem_id": 88075,
    "vorder": 6,
    "position": 1,
    "text": "سر جادوان را نگونسار کرد"
  },
  {
    "poem_id": 88075,
    "vorder": 7,
    "position": 0,
    "text": "توانایی و دانش و داد از اوست"
  },
  {
    "poem_id": 88075,
    "vorder": 8,
    "position": 1,
    "text": "به گیتی ستم یافته شاد از اوست"
  },
  {
    "poem_id": 88075,
    "vorder": 9,
    "position": 0,
    "text": "دگر گفت کز بخت کاووس کی"
  },
  {
    "poem_id": 88075,
    "vorder": 10,
    "position": 1,
    "text": "بزرگ و جهاندیده و نیک‌پی"
  },
  {
    "poem_id": 88075,
    "vorder": 11,
    "position": 0,
    "text": "گشاده شد آن گنگ افراسیاب"
  },
  {
    "poem_id": 88075,
    "vorder": 12,
    "position": 1,
    "text": "سر بخت او اندر آمد به خواب"
  },
  {
    "poem_id": 88075,
    "vorder": 13,
    "position": 0,
    "text": "به یک رزمگاه از نبرده سران"
  },
  {
    "poem_id": 88075,
    "vorder": 14,
    "position": 1,
    "text": "سرافراز با گرزهای گران"
  },
  {
    "poem_id": 88075,
    "vorder": 15,
    "position": 0,
    "text": "همانا که افگنده شد صد هزار"
  },
  {
    "poem_id": 88075,
    "vorder": 16,
    "position": 1,
    "text": "به گلزریون در یکی کارزار"
  },
  {
    "poem_id": 88075,
    "vorder": 17,
    "position": 0,
    "text": "وز آن پس برآمد یکی باد سخت"
  },
  {
    "poem_id": 88075,
    "vorder": 18,
    "position": 1,
    "text": "که برکند شاداب بیخ درخت"
  },
  {
    "poem_id": 88075,
    "vorder": 19,
    "position": 0,
    "text": "به آب اندر افتاد چندی سپاه"
  },
  {
    "poem_id": 88075,
    "vorder": 20,
    "position": 1,
    "text": "که جستند بر ما یکی دستگاه"
  },
  {
    "poem_id": 88075,
    "vorder": 21,
    "position": 0,
    "text": "به آوردگه در چنان شد سوار"
  },
  {
    "poem_id": 88075,
    "vorder": 22,
    "position": 1,
    "text": "که از ما یکی را دو صد شد شکار"
  },
  {
    "poem_id": 88075,
    "vorder": 23,
    "position": 0,
    "text": "وز آن جایگه رفت ببهشت گنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 24,
    "position": 1,
    "text": "حصاری پر از مردم و جای تنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 25,
    "position": 0,
    "text": "به جنگ حصار اندرون سی‌هزار"
  },
  {
    "poem_id": 88075,
    "vorder": 26,
    "position": 1,
    "text": "همانا که شد کشته در کارزار"
  },
  {
    "poem_id": 88075,
    "vorder": 27,
    "position": 0,
    "text": "همان بد که بیدادگر بود مرد"
  },
  {
    "poem_id": 88075,
    "vorder": 28,
    "position": 1,
    "text": "ورا دانش و بخت یاری نکرد"
  },
  {
    "poem_id": 88075,
    "vorder": 29,
    "position": 0,
    "text": "همه روی کشور سپه گسترید"
  },
  {
    "poem_id": 88075,
    "vorder": 30,
    "position": 1,
    "text": "شدست او کنون از جهان ناپدید"
  },
  {
    "poem_id": 88075,
    "vorder": 31,
    "position": 0,
    "text": "از این پس فرستم به شاه آگهی"
  },
  {
    "poem_id": 88075,
    "vorder": 32,
    "position": 1,
    "text": "ز روزی که باشد مرا فرهی"
  },
  {
    "poem_id": 88075,
    "vorder": 33,
    "position": 0,
    "text": "از آن پس بیامد به شادی نشست"
  },
  {
    "poem_id": 88075,
    "vorder": 34,
    "position": 1,
    "text": "پری روی پیش اندرون می به دست"
  },
  {
    "poem_id": 88075,
    "vorder": 35,
    "position": 0,
    "text": "ببد تا بهار اندرآورد روی"
  },
  {
    "poem_id": 88075,
    "vorder": 36,
    "position": 1,
    "text": "جهان شد بهشتی پر از رنگ و بوی"
  },
  {
    "poem_id": 88075,
    "vorder": 37,
    "position": 0,
    "text": "همه دشت چون پرنیان شد به رنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 38,
    "position": 1,
    "text": "هوا گشت بر سان پشت پلنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 39,
    "position": 0,
    "text": "گرازیدن گور و آهو به دشت"
  },
  {
    "poem_id": 88075,
    "vorder": 40,
    "position": 1,
    "text": "بدین گونه بر چند خوشی گذشت"
  },
  {
    "poem_id": 88075,
    "vorder": 41,
    "position": 0,
    "text": "به نخچیر یوزان و پرنده باز"
  },
  {
    "poem_id": 88075,
    "vorder": 42,
    "position": 1,
    "text": "همه مشک بویان بتان طراز"
  },
  {
    "poem_id": 88075,
    "vorder": 43,
    "position": 0,
    "text": "همه چارپایان به کردار گور"
  },
  {
    "poem_id": 88075,
    "vorder": 44,
    "position": 1,
    "text": "پراگند و آگنده کردن به زور"
  },
  {
    "poem_id": 88075,
    "vorder": 45,
    "position": 0,
    "text": "به گردن به کردار شیران نر"
  },
  {
    "poem_id": 88075,
    "vorder": 46,
    "position": 1,
    "text": "به سان گوزنان به گوش و به سر"
  },
  {
    "poem_id": 88075,
    "vorder": 47,
    "position": 0,
    "text": "ز هر سو فرستاد کارآگهان"
  },
  {
    "poem_id": 88075,
    "vorder": 48,
    "position": 1,
    "text": "همی جست پیدا ز کار جهان"
  },
  {
    "poem_id": 88075,
    "vorder": 49,
    "position": 0,
    "text": "پس آگاهی آمد ز چین و ختن"
  },
  {
    "poem_id": 88075,
    "vorder": 50,
    "position": 1,
    "text": "از افراسیاب و از آن انجمن"
  },
  {
    "poem_id": 88075,
    "vorder": 51,
    "position": 0,
    "text": "که فغفور چین با وی انباز گشت"
  },
  {
    "poem_id": 88075,
    "vorder": 52,
    "position": 1,
    "text": "همه روی کشور پرآواز گشت"
  },
  {
    "poem_id": 88075,
    "vorder": 53,
    "position": 0,
    "text": "ز چین تا به گلزریون لشکرست"
  },
  {
    "poem_id": 88075,
    "vorder": 54,
    "position": 1,
    "text": "بر ایشان چو خاقان چین سرورست"
  },
  {
    "poem_id": 88075,
    "vorder": 55,
    "position": 0,
    "text": "نداند کسی راز آن خواسته"
  },
  {
    "poem_id": 88075,
    "vorder": 56,
    "position": 1,
    "text": "پرستنده و اسب آراسته"
  },
  {
    "poem_id": 88075,
    "vorder": 57,
    "position": 0,
    "text": "که او را فرستاد خاقان چین"
  },
  {
    "poem_id": 88075,
    "vorder": 58,
    "position": 1,
    "text": "به شاهی بر او خواندند آفرین"
  },
  {
    "poem_id": 88075,
    "vorder": 59,
    "position": 0,
    "text": "همان گنج پیرانش آمد به دست"
  },
  {
    "poem_id": 88075,
    "vorder": 60,
    "position": 1,
    "text": "شتروار دینار صدبار شست"
  },
  {
    "poem_id": 88075,
    "vorder": 61,
    "position": 0,
    "text": "چو آن خواسته برگرفت از ختن"
  },
  {
    "poem_id": 88075,
    "vorder": 62,
    "position": 1,
    "text": "سپاهی بیاورد لشکر شکن"
  },
  {
    "poem_id": 88075,
    "vorder": 63,
    "position": 0,
    "text": "چو ز این گونه آگاهی آمد به شاه"
  },
  {
    "poem_id": 88075,
    "vorder": 64,
    "position": 1,
    "text": "به نزدیک زنهار داده سپاه"
  },
  {
    "poem_id": 88075,
    "vorder": 65,
    "position": 0,
    "text": "همه بازگشتند ز ایرانیان"
  },
  {
    "poem_id": 88075,
    "vorder": 66,
    "position": 1,
    "text": "ببستند خون ریختن را میان"
  },
  {
    "poem_id": 88075,
    "vorder": 67,
    "position": 0,
    "text": "چو برداشت افراسیاب از ختن"
  },
  {
    "poem_id": 88075,
    "vorder": 68,
    "position": 1,
    "text": "یکی لشکری شد بر او انجمن"
  },
  {
    "poem_id": 88075,
    "vorder": 69,
    "position": 0,
    "text": "که گفتی زمین برنتابد همی"
  },
  {
    "poem_id": 88075,
    "vorder": 70,
    "position": 1,
    "text": "ستاره شمارش نیابد همی"
  },
  {
    "poem_id": 88075,
    "vorder": 71,
    "position": 0,
    "text": "ز چین سوی کیخسرو آورد روی"
  },
  {
    "poem_id": 88075,
    "vorder": 72,
    "position": 1,
    "text": "پر از درد با لشکری کینه‌جوی"
  },
  {
    "poem_id": 88075,
    "vorder": 73,
    "position": 0,
    "text": "چو کیخسرو آگاه شد زان سپاه"
  },
  {
    "poem_id": 88075,
    "vorder": 74,
    "position": 1,
    "text": "طلایه فرستاد چندی به راه"
  },
  {
    "poem_id": 88075,
    "vorder": 75,
    "position": 0,
    "text": "بفرمود گودرز کشواد را"
  },
  {
    "poem_id": 88075,
    "vorder": 76,
    "position": 1,
    "text": "سپهدار گرگین و فرهاد را"
  },
  {
    "poem_id": 88075,
    "vorder": 77,
    "position": 0,
    "text": "که ایدر بباشید با داد و رای"
  },
  {
    "poem_id": 88075,
    "vorder": 78,
    "position": 1,
    "text": "طلایه شب و روز کرده به پای"
  },
  {
    "poem_id": 88075,
    "vorder": 79,
    "position": 0,
    "text": "به گودرز گفت این سپاه تو اند"
  },
  {
    "poem_id": 88075,
    "vorder": 80,
    "position": 1,
    "text": "چو کار آید اندر پناه تو اند"
  },
  {
    "poem_id": 88075,
    "vorder": 81,
    "position": 0,
    "text": "ز ترکان هرآنگه که بینی یکی"
  },
  {
    "poem_id": 88075,
    "vorder": 82,
    "position": 1,
    "text": "که یاد آرد از دشمنان اندکی"
  },
  {
    "poem_id": 88075,
    "vorder": 83,
    "position": 0,
    "text": "هم اندر زمان زنده بر دار کن"
  },
  {
    "poem_id": 88075,
    "vorder": 84,
    "position": 1,
    "text": "دو پایش ز بر سر نگونسار کن"
  },
  {
    "poem_id": 88075,
    "vorder": 85,
    "position": 0,
    "text": "چو بی‌رنج باشد تو بی‌رنج باش"
  },
  {
    "poem_id": 88075,
    "vorder": 86,
    "position": 1,
    "text": "نگهبان این لشکر و گنج باش"
  },
  {
    "poem_id": 88075,
    "vorder": 87,
    "position": 0,
    "text": "تبیره برآمد ز پرده سرای"
  },
  {
    "poem_id": 88075,
    "vorder": 88,
    "position": 1,
    "text": "خروشیدن زنگ و هندی درای"
  },
  {
    "poem_id": 88075,
    "vorder": 89,
    "position": 0,
    "text": "بدین سان سپاهی بیامد ز گنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 90,
    "position": 1,
    "text": "که خورشید را آرزو کرد جنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 91,
    "position": 0,
    "text": "چو بیرون شد از شهر صف بر کشید"
  },
  {
    "poem_id": 88075,
    "vorder": 92,
    "position": 1,
    "text": "سوی کوکها لشکر اندر کشید"
  },
  {
    "poem_id": 88075,
    "vorder": 93,
    "position": 0,
    "text": "میان دو لشکر دو منزل بماند"
  },
  {
    "poem_id": 88075,
    "vorder": 94,
    "position": 1,
    "text": "جهاندار گردنکشان را بخواند"
  },
  {
    "poem_id": 88075,
    "vorder": 95,
    "position": 0,
    "text": "چنین گفت کامشب مجنبید هیچ"
  },
  {
    "poem_id": 88075,
    "vorder": 96,
    "position": 1,
    "text": "نه خوب آید آرامش اندر بسیچ"
  },
  {
    "poem_id": 88075,
    "vorder": 97,
    "position": 0,
    "text": "طلایه برافگند بر گرد دشت"
  },
  {
    "poem_id": 88075,
    "vorder": 98,
    "position": 1,
    "text": "همه شب همی گرد لشکر بگشت"
  },
  {
    "poem_id": 88075,
    "vorder": 99,
    "position": 0,
    "text": "به یک هفته بودش هم آنجا درنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 100,
    "position": 1,
    "text": "همی ساخت آرایش و ساز جنگ"
  },
  {
    "poem_id": 88075,
    "vorder": 101,
    "position": 0,
    "text": "به هشتم بیامد طلایه ز راه"
  },
  {
    "poem_id": 88075,
    "vorder": 102,
    "position": 1,
    "text": "به خسرو خبر داد کآمد سپاه"
  },
  {
    "poem_id": 88075,
    "vorder": 103,
    "position": 0,
    "text": "سپه را بدان سان بیاراست شاه"
  },
  {
    "poem_id": 88075,
    "vorder": 104,
    "position": 1,
    "text": "که نظاره گشتند خورشید و ماه"
  },
  {
    "poem_id": 88075,
    "vorder": 105,
    "position": 0,
    "text": "چو افراسیاب آن سپه را بدید"
  },
  {
    "poem_id": 88075,
    "vorder": 106,
    "position": 1,
    "text": "بیامد برابر صفی برکشید"
  },
  {
    "poem_id": 88075,
    "vorder": 107,
    "position": 0,
    "text": "به فرزانگان گفت کین دشت رزم"
  },
  {
    "poem_id": 88075,
    "vorder": 108,
    "position": 1,
    "text": "به دل مر مرا چون خرامست و بزم"
  },
  {
    "poem_id": 88075,
    "vorder": 109,
    "position": 0,
    "text": "مرا شاد بر گاه خواب آمدی"
  },
  {
    "poem_id": 88075,
    "vorder": 110,
    "position": 1,
    "text": "چو رزمم نبودی شتاب آمدی"
  },
  {
    "poem_id": 88075,
    "vorder": 111,
    "position": 0,
    "text": "کنون مانده گشتم چنین در گریز"
  },
  {
    "poem_id": 88075,
    "vorder": 112,
    "position": 1,
    "text": "سری پر ز کینه دلی پرستیز"
  },
  {
    "poem_id": 88075,
    "vorder": 113,
    "position": 0,
    "text": "بر آنم که از بخت کیخسروست"
  },
  {
    "poem_id": 88075,
    "vorder": 114,
    "position": 1,
    "text": "و گر بر سرم روزگاری نوست"
  },
  {
    "poem_id": 88075,
    "vorder": 115,
    "position": 0,
    "text": "بر آنم که با او شوم همنبرد"
  },
  {
    "poem_id": 88075,
    "vorder": 116,
    "position": 1,
    "text": "اگر کام یابم اگر مرگ و درد"
  },
  {
    "poem_id": 88075,
    "vorder": 117,
    "position": 0,
    "text": "بدو گفت هر کس که فرزانه بود"
  },
  {
    "poem_id": 88075,
    "vorder": 118,
    "position": 1,
    "text": "گر از خویش بود ار ز بیگانه بود"
  },
  {
    "poem_id": 88075,
    "vorder": 119,
    "position": 0,
    "text": "که گر شاه را جست باید نبرد"
  },
  {
    "poem_id": 88075,
    "vorder": 120,
    "position": 1,
    "text": "چرا باید این لشکر و دار و برد"
  },
  {
    "poem_id": 88075,
    "vorder": 121,
    "position": 0,
    "text": "همه چین و توران به پیش تواند"
  },
  {
    "poem_id": 88075,
    "vorder": 122,
    "position": 1,
    "text": "ز بیگانگان ار ز خویش تواند"
  },
  {
    "poem_id": 88075,
    "vorder": 123,
    "position": 0,
    "text": "فدای تو بادا همه جان ما"
  },
  {
    "poem_id": 88075,
    "vorder": 124,
    "position": 1,
    "text": "چنین بود تا بود پیمان ما"
  },
  {
