[
  {
    "poem_id": 88042,
    "vorder": 1,
    "position": 0,
    "text": "سپهدار ترکان برآراست کار"
  },
  {
    "poem_id": 88042,
    "vorder": 2,
    "position": 1,
    "text": "ز لشکر گزید آن زمان ده سوار"
  },
  {
    "poem_id": 88042,
    "vorder": 3,
    "position": 0,
    "text": "ابا اسب و ساز و سلیح تمام"
  },
  {
    "poem_id": 88042,
    "vorder": 4,
    "position": 1,
    "text": "همه شیرمرد و همه نیک‌نام"
  },
  {
    "poem_id": 88042,
    "vorder": 5,
    "position": 0,
    "text": "همانگه ز ایران سپه پهلوان"
  },
  {
    "poem_id": 88042,
    "vorder": 6,
    "position": 1,
    "text": "بخواند آن زمان ده سوار جوان"
  },
  {
    "poem_id": 88042,
    "vorder": 7,
    "position": 0,
    "text": "برون تاختند از میان سپاه"
  },
  {
    "poem_id": 88042,
    "vorder": 8,
    "position": 1,
    "text": "برفتند یکسر به آوردگاه"
  },
  {
    "poem_id": 88042,
    "vorder": 9,
    "position": 0,
    "text": "که دیدار دیده بر ایشان نبود"
  },
  {
    "poem_id": 88042,
    "vorder": 10,
    "position": 1,
    "text": "دو سالار ز این گونه زرم آزمود"
  },
  {
    "poem_id": 88042,
    "vorder": 11,
    "position": 0,
    "text": "ابا هر سواری ز ایران سپاه"
  },
  {
    "poem_id": 88042,
    "vorder": 12,
    "position": 1,
    "text": "ز توران یکی شد ورا رزم خواه"
  },
  {
    "poem_id": 88042,
    "vorder": 13,
    "position": 0,
    "text": "نهادند پس گیو را با گروی"
  },
  {
    "poem_id": 88042,
    "vorder": 14,
    "position": 1,
    "text": "که همزور بودند و پرخاشجوی"
  },
  {
    "poem_id": 88042,
    "vorder": 15,
    "position": 0,
    "text": "گروی زره کز میان سپاه"
  },
  {
    "poem_id": 88042,
    "vorder": 16,
    "position": 1,
    "text": "سراسر بر او بود نفرین شاه"
  },
  {
    "poem_id": 88042,
    "vorder": 17,
    "position": 0,
    "text": "که بگرفت ریش سیاوش به دست"
  },
  {
    "poem_id": 88042,
    "vorder": 18,
    "position": 1,
    "text": "سرش را برید از تن پاک پست"
  },
  {
    "poem_id": 88042,
    "vorder": 19,
    "position": 0,
    "text": "دگر با فریبرز کاوس تفت"
  },
  {
    "poem_id": 88042,
    "vorder": 20,
    "position": 1,
    "text": "چو کلباد ویسه به آورد رفت"
  },
  {
    "poem_id": 88042,
    "vorder": 21,
    "position": 0,
    "text": "چو رهام گودرز با بارمان"
  },
  {
    "poem_id": 88042,
    "vorder": 22,
    "position": 1,
    "text": "برفتند یک با دگر بدگمان"
  },
  {
    "poem_id": 88042,
    "vorder": 23,
    "position": 0,
    "text": "گرازه بشد با سیامک به جنگ"
  },
  {
    "poem_id": 88042,
    "vorder": 24,
    "position": 1,
    "text": "چو شیر ژیان با دمنده نهنگ"
  },
  {
    "poem_id": 88042,
    "vorder": 25,
    "position": 0,
    "text": "چو گرگین کارآزموده سوار"
  },
  {
    "poem_id": 88042,
    "vorder": 26,
    "position": 1,
    "text": "که با اندریمان کند کارزار"
  },
  {
    "poem_id": 88042,
    "vorder": 27,
    "position": 0,
    "text": "ابا بیژن گیو رویین گرد"
  },
  {
    "poem_id": 88042,
    "vorder": 28,
    "position": 1,
    "text": "به جنگ از جهان روشنایی ببرد"
  },
  {
    "poem_id": 88042,
    "vorder": 29,
    "position": 0,
    "text": "چو او خواست با زنگه شاوران"
  },
  {
    "poem_id": 88042,
    "vorder": 30,
    "position": 1,
    "text": "دگر برته با کهرم از یاوران"
  },
  {
    "poem_id": 88042,
    "vorder": 31,
    "position": 0,
    "text": "چو دیگر فروهل بد و زنگله"
  },
  {
    "poem_id": 88042,
    "vorder": 32,
    "position": 1,
    "text": "برون تاختند از میان گله"
  },
  {
    "poem_id": 88042,
    "vorder": 33,
    "position": 0,
    "text": "هجیر و سپهرم به کردار شیر"
  },
  {
    "poem_id": 88042,
    "vorder": 34,
    "position": 1,
    "text": "بدان رزمگاه اندر آمد دلیر"
  },
  {
    "poem_id": 88042,
    "vorder": 35,
    "position": 0,
    "text": "چو گودرز کشواد و پیران به هم"
  },
  {
    "poem_id": 88042,
    "vorder": 36,
    "position": 1,
    "text": "همه ساخته دل به درد و ستم"
  },
  {
    "poem_id": 88042,
    "vorder": 37,
    "position": 0,
    "text": "میان بسته هر دو سپهبد به کین"
  },
  {
    "poem_id": 88042,
    "vorder": 38,
    "position": 1,
    "text": "چه از پادشاهی چه از بهر دین"
  },
  {
    "poem_id": 88042,
    "vorder": 39,
    "position": 0,
    "text": "بخوردند سوگند یک با دگر"
  },
  {
    "poem_id": 88042,
    "vorder": 40,
    "position": 1,
    "text": "که کس برنگرداند از کینه سر"
  },
  {
    "poem_id": 88042,
    "vorder": 41,
    "position": 0,
    "text": "بدان تا که را گردد امروز کار"
  },
  {
    "poem_id": 88042,
    "vorder": 42,
    "position": 1,
    "text": "که پیروز برگردد از کارزار"
  },
  {
    "poem_id": 88042,
    "vorder": 43,
    "position": 0,
    "text": "دو بالا بد اندر دو روی سپاه"
  },
  {
    "poem_id": 88042,
    "vorder": 44,
    "position": 1,
    "text": "که شایست کردن به هرسو نگاه"
  },
  {
    "poem_id": 88042,
    "vorder": 45,
    "position": 0,
    "text": "یکی سوی ایران دگر سوی تور"
  },
  {
    "poem_id": 88042,
    "vorder": 46,
    "position": 1,
    "text": "که دیدار بودی به لشکر ز دور"
  },
  {
    "poem_id": 88042,
    "vorder": 47,
    "position": 0,
    "text": "به پیش اندرون بود هامون و دشت"
  },
  {
    "poem_id": 88042,
    "vorder": 48,
    "position": 1,
    "text": "که تا زنده شایست بر وی گذشت"
  },
  {
    "poem_id": 88042,
    "vorder": 49,
    "position": 0,
    "text": "سپهدار گودرز کرد آن نشان"
  },
  {
    "poem_id": 88042,
    "vorder": 50,
    "position": 1,
    "text": "که هر کو ز گردان گردنکشان"
  },
  {
    "poem_id": 88042,
    "vorder": 51,
    "position": 0,
    "text": "به زیر آورد دشمنی را چو دود"
  },
  {
    "poem_id": 88042,
    "vorder": 52,
    "position": 1,
    "text": "درفشی ز بالا برآرند زود"
  },
  {
    "poem_id": 88042,
    "vorder": 53,
    "position": 0,
    "text": "سپهدار پیران نشانی نهاد"
  },
  {
    "poem_id": 88042,
    "vorder": 54,
    "position": 1,
    "text": "به بالای دیگر همین کرد یاد"
  },
  {
    "poem_id": 88042,
    "vorder": 55,
    "position": 0,
    "text": "از آن پس به هامون نهادند سر"
  },
  {
    "poem_id": 88042,
    "vorder": 56,
    "position": 1,
    "text": "به خون ریختن بسته گردان کمر"
  },
  {
    "poem_id": 88042,
    "vorder": 57,
    "position": 0,
    "text": "به تیغ و به گرز و به تیر و کمند"
  },
  {
    "poem_id": 88042,
    "vorder": 58,
    "position": 1,
    "text": "همی آزمودند هرگونه بند"
  },
  {
    "poem_id": 88042,
    "vorder": 59,
    "position": 0,
    "text": "دلیران توران و کنداوران"
  },
  {
    "poem_id": 88042,
    "vorder": 60,
    "position": 1,
    "text": "ابا گرز و تیغ و پرندآوران"
  },
  {
    "poem_id": 88042,
    "vorder": 61,
    "position": 0,
    "text": "که گر کوه پیش آمدی روز جنگ"
  },
  {
    "poem_id": 88042,
    "vorder": 62,
    "position": 1,
    "text": "نبودی بر آن رزم کردن درنگ"
  },
  {
    "poem_id": 88042,
    "vorder": 63,
    "position": 0,
    "text": "همه دستهاشان فروماند پست"
  },
  {
    "poem_id": 88042,
    "vorder": 64,
    "position": 1,
    "text": "در زور یزدان بر ایشان ببست"
  },
  {
    "poem_id": 88042,
    "vorder": 65,
    "position": 0,
    "text": "به دام بلا اندر آویختند"
  },
  {
    "poem_id": 88042,
    "vorder": 66,
    "position": 1,
    "text": "که بسیار بیداد خون ریختند"
  },
  {
    "poem_id": 88042,
    "vorder": 67,
    "position": 0,
    "text": "فرومانده اسبان جنگی به جای"
  },
  {
    "poem_id": 88042,
    "vorder": 68,
    "position": 1,
    "text": "تو گفتی که با دست بستست پای"
  },
  {
    "poem_id": 88042,
    "vorder": 69,
    "position": 0,
    "text": "بر ایشان همه راستی شد نگون"
  },
  {
    "poem_id": 88042,
    "vorder": 70,
    "position": 1,
    "text": "که برگشت روز و بجوشید خون"
  },
  {
    "poem_id": 88042,
    "vorder": 71,
    "position": 0,
    "text": "چنان خواست یزدان جان‌آفرین"
  },
  {
    "poem_id": 88042,
    "vorder": 72,
    "position": 1,
    "text": "که گفتی گرفت آن گوان را زمین"
  },
  {
    "poem_id": 88042,
    "vorder": 73,
    "position": 0,
    "text": "ز مردی که بودند با بخت خویش"
  },
  {
    "poem_id": 88042,
    "vorder": 74,
    "position": 1,
    "text": "برآویختند از پی تخت خویش"
  },
  {
    "poem_id": 88042,
    "vorder": 75,
    "position": 0,
    "text": "سران از پی پادشاهی به جنگ"
  },
  {
    "poem_id": 88042,
    "vorder": 76,
    "position": 1,
    "text": "بدادند جان از پی نام و ننگ"
  },
  {
    "poem_id": 88042,
    "vorder": 77,
    "position": 0,
    "text": "دمان آمدند اندر آوردگاه"
  },
  {
    "poem_id": 88042,
    "vorder": 78,
    "position": 1,
    "text": "ابا یکدگر ساخته کینه خواه"
  }
]