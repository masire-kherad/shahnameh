[
  {
    "poem_id": 1497,
    "vorder": 1,
    "position": 0,
    "text": "بسا رنج‌ها کز جهان دیده‌اند"
  },
  {
    "poem_id": 1497,
    "vorder": 2,
    "position": 1,
    "text": "ز بهر بزرگی پسندیده‌اند"
  },
  {
    "poem_id": 1497,
    "vorder": 3,
    "position": 0,
    "text": "سرانجام بستر جز از خاک نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 4,
    "position": 1,
    "text": "از او بهره زهر است و تریاک نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 5,
    "position": 0,
    "text": "چو دانی که ایدر نمانی دراز"
  },
  {
    "poem_id": 1497,
    "vorder": 6,
    "position": 1,
    "text": "به تارک چرا بر نهی تاج آز"
  },
  {
    "poem_id": 1497,
    "vorder": 7,
    "position": 0,
    "text": "همان آز را زیر خاک آوری"
  },
  {
    "poem_id": 1497,
    "vorder": 8,
    "position": 1,
    "text": "سرش را سر اندر مغاک آوری"
  },
  {
    "poem_id": 1497,
    "vorder": 9,
    "position": 0,
    "text": "ترا زین جهان شادمانی بس است"
  },
  {
    "poem_id": 1497,
    "vorder": 10,
    "position": 1,
    "text": "کجا رنج تو بهر دیگر کس است"
  },
  {
    "poem_id": 1497,
    "vorder": 11,
    "position": 0,
    "text": "تو رنجی و آسان دگر کس خورد"
  },
  {
    "poem_id": 1497,
    "vorder": 12,
    "position": 1,
    "text": "سوی گور و تابوت تو ننگرد"
  },
  {
    "poem_id": 1497,
    "vorder": 13,
    "position": 0,
    "text": "بر او نیز شادی سرآید همی"
  },
  {
    "poem_id": 1497,
    "vorder": 14,
    "position": 1,
    "text": "سرش زیر گرد اندر آید همی"
  },
  {
    "poem_id": 1497,
    "vorder": 15,
    "position": 0,
    "text": "ز روز گذر کردن اندیشه کن"
  },
  {
    "poem_id": 1497,
    "vorder": 16,
    "position": 1,
    "text": "پرستیدن دادگر پیشه کن"
  },
  {
    "poem_id": 1497,
    "vorder": 17,
    "position": 0,
    "text": "بترس از خدا و میازار کس"
  },
  {
    "poem_id": 1497,
    "vorder": 18,
    "position": 1,
    "text": "ره رستگاری همین است و بس"
  },
  {
    "poem_id": 1497,
    "vorder": 19,
    "position": 0,
    "text": "کنون ای خردمند بیدار دل"
  },
  {
    "poem_id": 1497,
    "vorder": 20,
    "position": 1,
    "text": "مشو در گمان‌، پای درکش ز گل"
  },
  {
    "poem_id": 1497,
    "vorder": 21,
    "position": 0,
    "text": "ترا کردگار است پروردگار"
  },
  {
    "poem_id": 1497,
    "vorder": 22,
    "position": 1,
    "text": "توی بنده و کردهٔ کردگار"
  },
  {
    "poem_id": 1497,
    "vorder": 23,
    "position": 0,
    "text": "چو گردن به اندیشه زیر آوری"
  },
  {
    "poem_id": 1497,
    "vorder": 24,
    "position": 1,
    "text": "ز هستی مکن پرسش و داوری"
  },
  {
    "poem_id": 1497,
    "vorder": 25,
    "position": 0,
    "text": "نشاید خور و خواب با آن نشست"
  },
  {
    "poem_id": 1497,
    "vorder": 26,
    "position": 1,
    "text": "که خستو نباشد به یزدان که هست"
  },
  {
    "poem_id": 1497,
    "vorder": 27,
    "position": 0,
    "text": "دلش کور باشد سرش بی‌خرد"
  },
  {
    "poem_id": 1497,
    "vorder": 28,
    "position": 1,
    "text": "خردمندش از مردمان نشمرد"
  },
  {
    "poem_id": 1497,
    "vorder": 29,
    "position": 0,
    "text": "ز هستی نشان است بر آب و خاک"
  },
  {
    "poem_id": 1497,
    "vorder": 30,
    "position": 1,
    "text": "ز دانش منش را مکن در مغاک"
  },
  {
    "poem_id": 1497,
    "vorder": 31,
    "position": 0,
    "text": "توانا و دانا و دارنده اوست"
  },
  {
    "poem_id": 1497,
    "vorder": 32,
    "position": 1,
    "text": "خرد را و جان را نگارنده اوست"
  },
  {
    "poem_id": 1497,
    "vorder": 33,
    "position": 0,
    "text": "جهان آفرید و مکان و زمان"
  },
  {
    "poem_id": 1497,
    "vorder": 34,
    "position": 1,
    "text": "پی پشهٔ خرد و پیل گران"
  },
  {
    "poem_id": 1497,
    "vorder": 35,
    "position": 0,
    "text": "چو سالار ترکان به دل گفت من"
  },
  {
    "poem_id": 1497,
    "vorder": 36,
    "position": 1,
    "text": "به بیشی برآرم سر از انجمن"
  },
  {
    "poem_id": 1497,
    "vorder": 37,
    "position": 0,
    "text": "چنان شاهزاده جوان را بکشت"
  },
  {
    "poem_id": 1497,
    "vorder": 38,
    "position": 1,
    "text": "ندانست جز گنج و شمشیر پشت"
  },
  {
    "poem_id": 1497,
    "vorder": 39,
    "position": 0,
    "text": "هم از پشت او روشن کردگار"
  },
  {
    "poem_id": 1497,
    "vorder": 40,
    "position": 1,
    "text": "درختی برآورد یازان به بار"
  },
  {
    "poem_id": 1497,
    "vorder": 41,
    "position": 0,
    "text": "که با او بگفت آن که جز تو کس است"
  },
  {
    "poem_id": 1497,
    "vorder": 42,
    "position": 1,
    "text": "که اندر جهان کردگار او بس است"
  },
  {
    "poem_id": 1497,
    "vorder": 43,
    "position": 0,
    "text": "خداوند خورشید و کیوان و ماه"
  },
  {
    "poem_id": 1497,
    "vorder": 44,
    "position": 1,
    "text": "کز اوی است پیروزی و دستگاه"
  },
  {
    "poem_id": 1497,
    "vorder": 45,
    "position": 0,
    "text": "خداوند هستی و هم راستی"
  },
  {
    "poem_id": 1497,
    "vorder": 46,
    "position": 1,
    "text": "نخواهد ز تو کژی و کاستی"
  },
  {
    "poem_id": 1497,
    "vorder": 47,
    "position": 0,
    "text": "جز از رای و فرمان او راه نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 48,
    "position": 1,
    "text": "خور و ماه از این دانش آگاه نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 49,
    "position": 0,
    "text": "پسر را بفرمود گودرز پیر"
  },
  {
    "poem_id": 1497,
    "vorder": 50,
    "position": 1,
    "text": "به توران شدن کار را ناگزیر"
  },
  {
    "poem_id": 1497,
    "vorder": 51,
    "position": 0,
    "text": "به فرمان او گیو بسته میان"
  },
  {
    "poem_id": 1497,
    "vorder": 52,
    "position": 1,
    "text": "بیامد به کردار شیر ژیان"
  },
  {
    "poem_id": 1497,
    "vorder": 53,
    "position": 0,
    "text": "همی تاخت تا مرز توران رسید"
  },
  {
    "poem_id": 1497,
    "vorder": 54,
    "position": 1,
    "text": "هر آن کس که در راه تنها بدید"
  },
  {
    "poem_id": 1497,
    "vorder": 55,
    "position": 0,
    "text": "زبان را به ترکی بیاراستی"
  },
  {
    "poem_id": 1497,
    "vorder": 56,
    "position": 1,
    "text": "ز کیخسرو از وی نشان خواستی"
  },
  {
    "poem_id": 1497,
    "vorder": 57,
    "position": 0,
    "text": "چو گفتی ندارم ز شاه آگهی"
  },
  {
    "poem_id": 1497,
    "vorder": 58,
    "position": 1,
    "text": "تنش را ز جان زود کردی تهی"
  },
  {
    "poem_id": 1497,
    "vorder": 59,
    "position": 0,
    "text": "به خم کمندش بیاویختی"
  },
  {
    "poem_id": 1497,
    "vorder": 60,
    "position": 1,
    "text": "سبک از برش خاک بر‌بیختی"
  },
  {
    "poem_id": 1497,
    "vorder": 61,
    "position": 0,
    "text": "بدان تا نداند کسی راز او"
  },
  {
    "poem_id": 1497,
    "vorder": 62,
    "position": 1,
    "text": "همان نشنود نام و آواز او"
  },
  {
    "poem_id": 1497,
    "vorder": 63,
    "position": 0,
    "text": "یکی را همی برد با خویشتن"
  },
  {
    "poem_id": 1497,
    "vorder": 64,
    "position": 1,
    "text": "ورا رهنمون بود زآن انجمن"
  },
  {
    "poem_id": 1497,
    "vorder": 65,
    "position": 0,
    "text": "همی رفت بیدار با او به راه"
  },
  {
    "poem_id": 1497,
    "vorder": 66,
    "position": 1,
    "text": "بر او راز نگشاد تا چندگاه"
  },
  {
    "poem_id": 1497,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت روزی که اندر جهان"
  },
  {
    "poem_id": 1497,
    "vorder": 68,
    "position": 1,
    "text": "سخن پرسم از تو یکی در نهان"
  },
  {
    "poem_id": 1497,
    "vorder": 69,
    "position": 0,
    "text": "گر ایدون که یابم ز تو راستی"
  },
  {
    "poem_id": 1497,
    "vorder": 70,
    "position": 1,
    "text": "بشویی به دانش دل از کاستی"
  },
  {
    "poem_id": 1497,
    "vorder": 71,
    "position": 0,
    "text": "ببخشم ترا هرچه خواهی ز من"
  },
  {
    "poem_id": 1497,
    "vorder": 72,
    "position": 1,
    "text": "ندارم دریغ از تو پرمایه تن"
  },
  {
    "poem_id": 1497,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد پاسخ که دانش بس است"
  },
  {
    "poem_id": 1497,
    "vorder": 74,
    "position": 1,
    "text": "ولیکن پراگنده با هر کس است"
  },
  {
    "poem_id": 1497,
    "vorder": 75,
    "position": 0,
    "text": "اگر زآن که پرسیم هست آگهی"
  },
  {
    "poem_id": 1497,
    "vorder": 76,
    "position": 1,
    "text": "ز پاسخ زبان را نیابی تهی"
  },
  {
    "poem_id": 1497,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت کیخسرو اکنون کجاست"
  },
  {
    "poem_id": 1497,
    "vorder": 78,
    "position": 1,
    "text": "بباید به من برگشادنت راست"
  },
  {
    "poem_id": 1497,
    "vorder": 79,
    "position": 0,
    "text": "چنین داد پاسخ که نشنیده‌ام"
  },
  {
    "poem_id": 1497,
    "vorder": 80,
    "position": 1,
    "text": "چنین نام هرگز نپرسیده‌ام"
  },
  {
    "poem_id": 1497,
    "vorder": 81,
    "position": 0,
    "text": "چو پاسخ چنین یافت از رهنمون"
  },
  {
    "poem_id": 1497,
    "vorder": 82,
    "position": 1,
    "text": "بزد تیغ و انداختش سرنگون"
  },
  {
    "poem_id": 1497,
    "vorder": 83,
    "position": 0,
    "text": "به توران همی رفت چون بیهشان"
  },
  {
    "poem_id": 1497,
    "vorder": 84,
    "position": 1,
    "text": "مگر یابد از شاه جایی نشان"
  },
  {
    "poem_id": 1497,
    "vorder": 85,
    "position": 0,
    "text": "چنین تا برآمد بر این هفت سال"
  },
  {
    "poem_id": 1497,
    "vorder": 86,
    "position": 1,
    "text": "میان سوده از تیغ و بند دوال"
  },
  {
    "poem_id": 1497,
    "vorder": 87,
    "position": 0,
    "text": "خورش گور و پوشش هم از چرم گور"
  },
  {
    "poem_id": 1497,
    "vorder": 88,
    "position": 1,
    "text": "گیا خوردن باره و آب شور"
  },
  {
    "poem_id": 1497,
    "vorder": 89,
    "position": 0,
    "text": "همی گشت گرد بیابان و کوه"
  },
  {
    "poem_id": 1497,
    "vorder": 90,
    "position": 1,
    "text": "به رنج و به سختی و دور از گروه"
  },
  {
    "poem_id": 1497,
    "vorder": 91,
    "position": 0,
    "text": "چنان بد که روزی پر‌اندیشه بود"
  },
  {
    "poem_id": 1497,
    "vorder": 92,
    "position": 1,
    "text": "به پیشش یکی بارور بیشه بود"
  },
  {
    "poem_id": 1497,
    "vorder": 93,
    "position": 0,
    "text": "بدان مرغزار اندر آمد دژم"
  },
  {
    "poem_id": 1497,
    "vorder": 94,
    "position": 1,
    "text": "جهان خرم و مرد را دل به غم"
  },
  {
    "poem_id": 1497,
    "vorder": 95,
    "position": 0,
    "text": "زمین سبز و چشمه پر از آب دید"
  },
  {
    "poem_id": 1497,
    "vorder": 96,
    "position": 1,
    "text": "همی جای آرامش و خواب دید"
  },
  {
    "poem_id": 1497,
    "vorder": 97,
    "position": 0,
    "text": "فرود آمد و اسپ را برگذاشت"
  },
  {
    "poem_id": 1497,
    "vorder": 98,
    "position": 1,
    "text": "بخفت و همی بر دل اندیشه داشت"
  },
  {
    "poem_id": 1497,
    "vorder": 99,
    "position": 0,
    "text": "همی گفت مانا که دیو پلید"
  },
  {
    "poem_id": 1497,
    "vorder": 100,
    "position": 1,
    "text": "بر پهلوان بد که آن خواب دید"
  },
  {
    "poem_id": 1497,
    "vorder": 101,
    "position": 0,
    "text": "ز کیخسرو ایدر نبینم نشان"
  },
  {
    "poem_id": 1497,
    "vorder": 102,
    "position": 1,
    "text": "چه دارم همی خویشتن را کشان"
  },
  {
    "poem_id": 1497,
    "vorder": 103,
    "position": 0,
    "text": "کنون گر به رزم‌اند یاران من"
  },
  {
    "poem_id": 1497,
    "vorder": 104,
    "position": 1,
    "text": "به بزم اندرون غمگساران من"
  },
  {
    "poem_id": 1497,
    "vorder": 105,
    "position": 0,
    "text": "یکی نامجوی و یکی شاد‌روز"
  },
  {
    "poem_id": 1497,
    "vorder": 106,
    "position": 1,
    "text": "مرا بخت بر گنبد افشاند گوز"
  },
  {
    "poem_id": 1497,
    "vorder": 107,
    "position": 0,
    "text": "همی برفشانم به خیره روان"
  },
  {
    "poem_id": 1497,
    "vorder": 108,
    "position": 1,
    "text": "خمیده‌ست پشتم چو خم کمان"
  },
  {
    "poem_id": 1497,
    "vorder": 109,
    "position": 0,
    "text": "همانا که خسرو ز مادر نزاد"
  },
  {
    "poem_id": 1497,
    "vorder": 110,
    "position": 1,
    "text": "وگر زاد‌، دادش زمانه به باد"
  },
  {
    "poem_id": 1497,
    "vorder": 111,
    "position": 0,
    "text": "ز جستن مرا رنج و سختی‌ست بهر"
  },
  {
    "poem_id": 1497,
    "vorder": 112,
    "position": 1,
    "text": "انوشه کسی کاو بمیرد به زهر"
  },
  {
    "poem_id": 1497,
    "vorder": 113,
    "position": 0,
    "text": "سرش پر ز غم گرد آن مرغزار"
  },
  {
    "poem_id": 1497,
    "vorder": 114,
    "position": 1,
    "text": "همی گشت شه را کنان خواستار"
  },
  {
    "poem_id": 1497,
    "vorder": 115,
    "position": 0,
    "text": "یکی چشمه‌ای دید تابان ز دور"
  },
  {
    "poem_id": 1497,
    "vorder": 116,
    "position": 1,
    "text": "یکی سرو بالا دل آرام پور"
  },
  {
    "poem_id": 1497,
    "vorder": 117,
    "position": 0,
    "text": "یکی جام پر می گرفته به چنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 118,
    "position": 1,
    "text": "به سر بر زده دستهٔ بوی و رنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 119,
    "position": 0,
    "text": "ز بالای او فرهٔ ایزدی"
  },
  {
    "poem_id": 1497,
    "vorder": 120,
    "position": 1,
    "text": "پدید آمد و رایت بخردی"
  },
  {
    "poem_id": 1497,
    "vorder": 121,
    "position": 0,
    "text": "تو گفتی منوچهر بر تخت عاج"
  },
  {
    "poem_id": 1497,
    "vorder": 122,
    "position": 1,
    "text": "نشسته‌ست بر سر ز پیروزه تاج"
  },
  {
    "poem_id": 1497,
    "vorder": 123,
    "position": 0,
    "text": "همی بوی مهر آمد از روی او"
  },
  {
    "poem_id": 1497,
    "vorder": 124,
    "position": 1,
    "text": "همی زیب تاج آمد از موی او"
  },
  {
    "poem_id": 1497,
    "vorder": 125,
    "position": 0,
    "text": "به دل گفت گیو این به جز شاه نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 126,
    "position": 1,
    "text": "چنین چهره جز در خور گاه نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 127,
    "position": 0,
    "text": "پیاده بدو تیز بنهاد روی"
  },
  {
    "poem_id": 1497,
    "vorder": 128,
    "position": 1,
    "text": "چو تنگ اندر آمد گو شاه‌جوی"
  },
  {
    "poem_id": 1497,
    "vorder": 129,
    "position": 0,
    "text": "گره سست شد بر در رنج او"
  },
  {
    "poem_id": 1497,
    "vorder": 130,
    "position": 1,
    "text": "پدید آمد آن نامور گنج او"
  },
  {
    "poem_id": 1497,
    "vorder": 131,
    "position": 0,
    "text": "چو کیخسرو از چشمه او را بدید"
  },
  {
    "poem_id": 1497,
    "vorder": 132,
    "position": 1,
    "text": "بخندید و شادان دلش بردمید"
  },
  {
    "poem_id": 1497,
    "vorder": 133,
    "position": 0,
    "text": "به دل گفت کاین گرد جز گیو نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 134,
    "position": 1,
    "text": "بدین مرز خود زین نشان نیو نیست"
  },
  {
    "poem_id": 1497,
    "vorder": 135,
    "position": 0,
    "text": "مرا کرد خواهد همی خواستار"
  },
  {
    "poem_id": 1497,
    "vorder": 136,
    "position": 1,
    "text": "به ایران برد تا کند شهریار"
  },
  {
    "poem_id": 1497,
    "vorder": 137,
    "position": 0,
    "text": "چو آمد برش گیو بردش نماز"
  },
  {
    "poem_id": 1497,
    "vorder": 138,
    "position": 1,
    "text": "بدو گفت کای نامور سرفراز"
  },
  {
    "poem_id": 1497,
    "vorder": 139,
    "position": 0,
    "text": "بر آنم که پور سیاوش توی"
  },
  {
    "poem_id": 1497,
    "vorder": 140,
    "position": 1,
    "text": "ز تخم کیانی و کیخسروی"
  },
  {
    "poem_id": 1497,
    "vorder": 141,
    "position": 0,
    "text": "چنین داد پاسخ ورا شهریار"
  },
  {
    "poem_id": 1497,
    "vorder": 142,
    "position": 1,
    "text": "که تو گیو گودرزی ای نامدار"
  },
  {
    "poem_id": 1497,
    "vorder": 143,
    "position": 0,
    "text": "بدو گفت گیو ای سر راستان"
  },
  {
    "poem_id": 1497,
    "vorder": 144,
    "position": 1,
    "text": "ز گودرز با تو که زد داستان"
  },
  {
    "poem_id": 1497,
    "vorder": 145,
    "position": 0,
    "text": "ز کشواد و گیو‌ت که داد آگهی‌؟"
  },
  {
    "poem_id": 1497,
    "vorder": 146,
    "position": 1,
    "text": "که با خرمی بادی و فرهی"
  },
  {
    "poem_id": 1497,
    "vorder": 147,
    "position": 0,
    "text": "بدو گفت کیخسرو ای شیر مرد"
  },
  {
    "poem_id": 1497,
    "vorder": 148,
    "position": 1,
    "text": "مرا مادر این از پدر یاد کرد"
  },
  {
    "poem_id": 1497,
    "vorder": 149,
    "position": 0,
    "text": "که از فر یزدان گشادی سخن"
  },
  {
    "poem_id": 1497,
    "vorder": 150,
    "position": 1,
    "text": "بدان‌گه که اندرز‌ش آمد به بن"
  },
  {
    "poem_id": 1497,
    "vorder": 151,
    "position": 0,
    "text": "همی گفت با نامور مادرم"
  },
  {
    "poem_id": 1497,
    "vorder": 152,
    "position": 1,
    "text": "کز ایدر چه آید ز بد بر سرم"
  },
  {
    "poem_id": 1497,
    "vorder": 153,
    "position": 0,
    "text": "سرانجام کیخسرو آید پدید"
  },
  {
    "poem_id": 1497,
    "vorder": 154,
    "position": 1,
    "text": "بجا آورد بندها را کلید"
  },
  {
    "poem_id": 1497,
    "vorder": 155,
    "position": 0,
    "text": "بدانگه که گردد جهاندار نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 156,
    "position": 1,
    "text": "ز ایران بیاید سرافراز گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 157,
    "position": 0,
    "text": "مر او را سوی تخت ایران برد"
  },
  {
    "poem_id": 1497,
    "vorder": 158,
    "position": 1,
    "text": "بر‌ِ نامداران و شیران برد"
  },
  {
    "poem_id": 1497,
    "vorder": 159,
    "position": 0,
    "text": "جهان را به مردی به پای آورد"
  },
  {
    "poem_id": 1497,
    "vorder": 160,
    "position": 1,
    "text": "همان کین ما را به جای آورد"
  },
  {
    "poem_id": 1497,
    "vorder": 161,
    "position": 0,
    "text": "بدو گفت گیو ای سر سرکشان"
  },
  {
    "poem_id": 1497,
    "vorder": 162,
    "position": 1,
    "text": "ز فر بزرگی چه داری نشان"
  },
  {
    "poem_id": 1497,
    "vorder": 163,
    "position": 0,
    "text": "نشان سیاوش پدیدار بود"
  },
  {
    "poem_id": 1497,
    "vorder": 164,
    "position": 1,
    "text": "چو بر گلستان نقطهٔ قار بود"
  },
  {
    "poem_id": 1497,
    "vorder": 165,
    "position": 0,
    "text": "تو بگشای و بنمای بازو به من"
  },
  {
    "poem_id": 1497,
    "vorder": 166,
    "position": 1,
    "text": "نشان تو پیداست بر انجمن"
  },
  {
    "poem_id": 1497,
    "vorder": 167,
    "position": 0,
    "text": "برهنه تن خویش بنمود شاه"
  },
  {
    "poem_id": 1497,
    "vorder": 168,
    "position": 1,
    "text": "نگه کرد گیو آن نشان سیاه"
  },
  {
    "poem_id": 1497,
    "vorder": 169,
    "position": 0,
    "text": "که میراث بود از گه کیقباد"
  },
  {
    "poem_id": 1497,
    "vorder": 170,
    "position": 1,
    "text": "درستی بدان بد کیان را نژاد"
  },
  {
    "poem_id": 1497,
    "vorder": 171,
    "position": 0,
    "text": "چو گیو آن نشان دید بردش نماز"
  },
  {
    "poem_id": 1497,
    "vorder": 172,
    "position": 1,
    "text": "همی ریخت آب و همی گفت راز"
  },
  {
    "poem_id": 1497,
    "vorder": 173,
    "position": 0,
    "text": "گرفتش به بر شهریار زمین"
  },
  {
    "poem_id": 1497,
    "vorder": 174,
    "position": 1,
    "text": "ز شادی بر او بر گرفت آفرین"
  },
  {
    "poem_id": 1497,
    "vorder": 175,
    "position": 0,
    "text": "از ایران بپرسید و ز تخت و گاه"
  },
  {
    "poem_id": 1497,
    "vorder": 176,
    "position": 1,
    "text": "ز گودرز وز رستم نیک‌خواه"
  },
  {
    "poem_id": 1497,
    "vorder": 177,
    "position": 0,
    "text": "بدو گفت گیو ای جهاندار کی"
  },
  {
    "poem_id": 1497,
    "vorder": 178,
    "position": 1,
    "text": "سرافراز و بیدار و فرخنده پی"
  },
  {
    "poem_id": 1497,
    "vorder": 179,
    "position": 0,
    "text": "جهاندار دارندهٔ خوب و زشت"
  },
  {
    "poem_id": 1497,
    "vorder": 180,
    "position": 1,
    "text": "مرا گر نمودی سراسر بهشت"
  },
  {
    "poem_id": 1497,
    "vorder": 181,
    "position": 0,
    "text": "همان هفت کشور به شاهنشهی"
  },
  {
    "poem_id": 1497,
    "vorder": 182,
    "position": 1,
    "text": "نهاده بزرگی و تاج مهی"
  },
  {
    "poem_id": 1497,
    "vorder": 183,
    "position": 0,
    "text": "نبودی دل من بدین خرمی"
  },
  {
    "poem_id": 1497,
    "vorder": 184,
    "position": 1,
    "text": "که روی تو دیدم به توران زمی"
  },
  {
    "poem_id": 1497,
    "vorder": 185,
    "position": 0,
    "text": "که داند به گیتی که من زنده‌ام"
  },
  {
    "poem_id": 1497,
    "vorder": 186,
    "position": 1,
    "text": "به خاکم و گر به‌آتش افگنده‌ام"
  },
  {
    "poem_id": 1497,
    "vorder": 187,
    "position": 0,
    "text": "سپاس از جهاندار کاین رنج سخت"
  },
  {
    "poem_id": 1497,
    "vorder": 188,
    "position": 1,
    "text": "به شادی و خوبی سرآورد بخت"
  },
  {
    "poem_id": 1497,
    "vorder": 189,
    "position": 0,
    "text": "برفتند زآن بیشه هر دو به راه"
  },
  {
    "poem_id": 1497,
    "vorder": 190,
    "position": 1,
    "text": "بپرسید خسرو ز کاووس شاه"
  },
  {
    "poem_id": 1497,
    "vorder": 191,
    "position": 0,
    "text": "وزآن هفت ساله غم و درد او"
  },
  {
    "poem_id": 1497,
    "vorder": 192,
    "position": 1,
    "text": "ز گستردن و خواب وز خورد او"
  },
  {
    "poem_id": 1497,
    "vorder": 193,
    "position": 0,
    "text": "همی گفت با شاه یکسر سخن"
  },
  {
    "poem_id": 1497,
    "vorder": 194,
    "position": 1,
    "text": "که دادار گیتی چه افگند بن"
  },
  {
    "poem_id": 1497,
    "vorder": 195,
    "position": 0,
    "text": "همان خواب گودرز و رنج دراز"
  },
  {
    "poem_id": 1497,
    "vorder": 196,
    "position": 1,
    "text": "خور و پوشش و درد و آرام و ناز"
  },
  {
    "poem_id": 1497,
    "vorder": 197,
    "position": 0,
    "text": "ز کاووس کش سال بفگند فر"
  },
  {
    "poem_id": 1497,
    "vorder": 198,
    "position": 1,
    "text": "ز درد پسر گشت بی پای و پر"
  },
  {
    "poem_id": 1497,
    "vorder": 199,
    "position": 0,
    "text": "ز ایران پراکنده شد رنگ و بوی"
  },
  {
    "poem_id": 1497,
    "vorder": 200,
    "position": 1,
    "text": "سراسر به ویرانی آورد روی"
  },
  {
    "poem_id": 1497,
    "vorder": 201,
    "position": 0,
    "text": "دل خسرو از درد و رنجش بسوخت"
  },
  {
    "poem_id": 1497,
    "vorder": 202,
    "position": 1,
    "text": "به کردار آتش رخش برفروخت"
  },
  {
    "poem_id": 1497,
    "vorder": 203,
    "position": 0,
    "text": "بدو گفت کاکنون ز رنج دراز"
  },
  {
    "poem_id": 1497,
    "vorder": 204,
    "position": 1,
    "text": "ترا بردهد بخت آرام و ناز"
  },
  {
    "poem_id": 1497,
    "vorder": 205,
    "position": 0,
    "text": "مرا چون پدر باش و با کس مگوی"
  },
  {
    "poem_id": 1497,
    "vorder": 206,
    "position": 1,
    "text": "ببین تا زمانه چه آرد به روی"
  },
  {
    "poem_id": 1497,
    "vorder": 207,
    "position": 0,
    "text": "سپهبد نشست از بر اسپ گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 208,
    "position": 1,
    "text": "پیاده همی رفت بر پیش نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 209,
    "position": 0,
    "text": "یکی تیغ هندی گرفته به چنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 210,
    "position": 1,
    "text": "هر آن کس که پیش آمدی بی‌درنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 211,
    "position": 0,
    "text": "زدی گیو بیدار دل گردنش"
  },
  {
    "poem_id": 1497,
    "vorder": 212,
    "position": 1,
    "text": "به زیر گل و خاک کردی تنش"
  },
  {
    "poem_id": 1497,
    "vorder": 213,
    "position": 0,
    "text": "برفتند سوی سیاووش گرد"
  },
  {
    "poem_id": 1497,
    "vorder": 214,
    "position": 1,
    "text": "چو آمد دو تن را دل و هوش گرد"
  },
  {
    "poem_id": 1497,
    "vorder": 215,
    "position": 0,
    "text": "فرنگیس را نیز کردند یار"
  },
  {
    "poem_id": 1497,
    "vorder": 216,
    "position": 1,
    "text": "نهانی بر آن بر نهادند کار"
  },
  {
    "poem_id": 1497,
    "vorder": 217,
    "position": 0,
    "text": "که هر سه به راه اندر آرند روی"
  },
  {
    "poem_id": 1497,
    "vorder": 218,
    "position": 1,
    "text": "نهان از دلیران پرخاشجوی"
  },
  {
    "poem_id": 1497,
    "vorder": 219,
    "position": 0,
    "text": "فرنگیس گفت ار درنگ آوریم"
  },
  {
    "poem_id": 1497,
    "vorder": 220,
    "position": 1,
    "text": "جهان بر دل خویش تنگ آوریم"
  },
  {
    "poem_id": 1497,
    "vorder": 221,
    "position": 0,
    "text": "از این آگهی یابد افراسیاب"
  },
  {
    "poem_id": 1497,
    "vorder": 222,
    "position": 1,
    "text": "نسازد به خورد و نیازد به خواب"
  },
  {
    "poem_id": 1497,
    "vorder": 223,
    "position": 0,
    "text": "بیاید به کردار دیو سپید"
  },
  {
    "poem_id": 1497,
    "vorder": 224,
    "position": 1,
    "text": "دل از جان شیرین شود ناامید"
  },
  {
    "poem_id": 1497,
    "vorder": 225,
    "position": 0,
    "text": "یکی را ز ما زنده اندر جهان"
  },
  {
    "poem_id": 1497,
    "vorder": 226,
    "position": 1,
    "text": "نبیند کسی آشکار و نهان"
  },
  {
    "poem_id": 1497,
    "vorder": 227,
    "position": 0,
    "text": "جهان پر ز بدخواه و پر‌دشمن است"
  },
  {
    "poem_id": 1497,
    "vorder": 228,
    "position": 1,
    "text": "همه مرز ما جای آهرمن است"
  },
  {
    "poem_id": 1497,
    "vorder": 229,
    "position": 0,
    "text": "تو ای بافرین شاه فرزند من"
  },
  {
    "poem_id": 1497,
    "vorder": 230,
    "position": 1,
    "text": "نگر تا نیوشی یکی پند من"
  },
  {
    "poem_id": 1497,
    "vorder": 231,
    "position": 0,
    "text": "که گر آگهی یابد آن مرد شوم"
  },
  {
    "poem_id": 1497,
    "vorder": 232,
    "position": 1,
    "text": "برانگیزد آتش ز آباد بوم"
  },
  {
    "poem_id": 1497,
    "vorder": 233,
    "position": 0,
    "text": "یکی مرغزار‌ست ز ایدر نه دور"
  },
  {
    "poem_id": 1497,
    "vorder": 234,
    "position": 1,
    "text": "به یک‌سو ز راه سواران تور"
  },
  {
    "poem_id": 1497,
    "vorder": 235,
    "position": 0,
    "text": "همان جویبار است و آب روان"
  },
  {
    "poem_id": 1497,
    "vorder": 236,
    "position": 1,
    "text": "که از دیدنش تازه گردد روان"
  },
  {
    "poem_id": 1497,
    "vorder": 237,
    "position": 0,
    "text": "تو بر گیر زین و لگام سیاه"
  },
  {
    "poem_id": 1497,
    "vorder": 238,
    "position": 1,
    "text": "برو سوی آن مرغزاران پگاه"
  },
  {
    "poem_id": 1497,
    "vorder": 239,
    "position": 0,
    "text": "چو خورشید بر تیغ گنبد شود"
  },
  {
    "poem_id": 1497,
    "vorder": 240,
    "position": 1,
    "text": "گه خواب و خورد سپهبد شود"
  },
  {
    "poem_id": 1497,
    "vorder": 241,
    "position": 0,
    "text": "گله هرچه هست اندر آن مرغزار"
  },
  {
    "poem_id": 1497,
    "vorder": 242,
    "position": 1,
    "text": "به آبشخور آید سوی جویبار"
  },
  {
    "poem_id": 1497,
    "vorder": 243,
    "position": 0,
    "text": "به بهزاد بنمای زین و لگام"
  },
  {
    "poem_id": 1497,
    "vorder": 244,
    "position": 1,
    "text": "چو او رام گردد تو بگذار گام"
  },
  {
    "poem_id": 1497,
    "vorder": 245,
    "position": 0,
    "text": "چو آیی برش نیک بنمای چهر"
  },
  {
    "poem_id": 1497,
    "vorder": 246,
    "position": 1,
    "text": "بیارای و ببسای رویش به مهر"
  },
  {
    "poem_id": 1497,
    "vorder": 247,
    "position": 0,
    "text": "سیاوش چو گشت از جهان ناامید"
  },
  {
    "poem_id": 1497,
    "vorder": 248,
    "position": 1,
    "text": "بر او تیره شد روی روز سپید"
  },
  {
    "poem_id": 1497,
    "vorder": 249,
    "position": 0,
    "text": "چنین گفت شبرنگ بهزاد را"
  },
  {
    "poem_id": 1497,
    "vorder": 250,
    "position": 1,
    "text": "که فرمان مبر ز این سپس باد را"
  },
  {
    "poem_id": 1497,
    "vorder": 251,
    "position": 0,
    "text": "همی باش بر کوه و در مرغزار"
  },
  {
    "poem_id": 1497,
    "vorder": 252,
    "position": 1,
    "text": "چو کیخسرو آید ترا خواستار"
  },
  {
    "poem_id": 1497,
    "vorder": 253,
    "position": 0,
    "text": "ورا بارگی باش و گیتی بکوب"
  },
  {
    "poem_id": 1497,
    "vorder": 254,
    "position": 1,
    "text": "ز دشمن زمین را به نعلت بروب"
  },
  {
    "poem_id": 1497,
    "vorder": 255,
    "position": 0,
    "text": "نشست از بر اسپ سالار نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 256,
    "position": 1,
    "text": "پیاده همی رفت بر پیش گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 257,
    "position": 0,
    "text": "بدان تند بالا نهادند روی"
  },
  {
    "poem_id": 1497,
    "vorder": 258,
    "position": 1,
    "text": "چنان چون بود مردم چاره‌جوی"
  },
  {
    "poem_id": 1497,
    "vorder": 259,
    "position": 0,
    "text": "فسیله چو آمد به تنگی فراز"
  },
  {
    "poem_id": 1497,
    "vorder": 260,
    "position": 1,
    "text": "بخوردند سیراب و گشتند باز"
  },
  {
    "poem_id": 1497,
    "vorder": 261,
    "position": 0,
    "text": "نگه کرد بهزاد و کی را بدید"
  },
  {
    "poem_id": 1497,
    "vorder": 262,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1497,
    "vorder": 263,
    "position": 0,
    "text": "بدید آن نشست سیاوش پلنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 264,
    "position": 1,
    "text": "رکیب دراز و جناغ خدنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 265,
    "position": 0,
    "text": "همی داشت در آبخور پای خویش"
  },
  {
    "poem_id": 1497,
    "vorder": 266,
    "position": 1,
    "text": "از آنجا که بُد‌، دست ننهاد پیش"
  },
  {
    "poem_id": 1497,
    "vorder": 267,
    "position": 0,
    "text": "چو کیخسرو او را به آرام یافت"
  },
  {
    "poem_id": 1497,
    "vorder": 268,
    "position": 1,
    "text": "بپویید و با زین سوی او شتافت"
  },
  {
    "poem_id": 1497,
    "vorder": 269,
    "position": 0,
    "text": "بمالید بر چشم او دست و روی"
  },
  {
    "poem_id": 1497,
    "vorder": 270,
    "position": 1,
    "text": "بر و یال ببسود و بشخود موی"
  },
  {
    "poem_id": 1497,
    "vorder": 271,
    "position": 0,
    "text": "لگامش بدو داد و زین بر نهاد"
  },
  {
    "poem_id": 1497,
    "vorder": 272,
    "position": 1,
    "text": "بسی از پدر کرد با درد یاد"
  },
  {
    "poem_id": 1497,
    "vorder": 273,
    "position": 0,
    "text": "چو بنشست بر باره بفشارد ران"
  },
  {
    "poem_id": 1497,
    "vorder": 274,
    "position": 1,
    "text": "برآمد ز جا آن هیون گران"
  },
  {
    "poem_id": 1497,
    "vorder": 275,
    "position": 0,
    "text": "به کردار باد هوا بردمید"
  },
  {
    "poem_id": 1497,
    "vorder": 276,
    "position": 1,
    "text": "بپرید وز گیو شد ناپدید"
  },
  {
    "poem_id": 1497,
    "vorder": 277,
    "position": 0,
    "text": "غمی شد دل گیو و خیره بماند"
  },
  {
    "poem_id": 1497,
    "vorder": 278,
    "position": 1,
    "text": "بدان خیرگی نام یزدان بخواند"
  },
  {
    "poem_id": 1497,
    "vorder": 279,
    "position": 0,
    "text": "همی گفت که‌آهرمن چاره‌جوی"
  },
  {
    "poem_id": 1497,
    "vorder": 280,
    "position": 1,
    "text": "یکی بارگی گشت و بنمود روی"
  },
  {
    "poem_id": 1497,
    "vorder": 281,
    "position": 0,
    "text": "کنون جان خسرو شد و رنج من"
  },
  {
    "poem_id": 1497,
    "vorder": 282,
    "position": 1,
    "text": "همین رنج بد در جهان گنج من"
  },
  {
    "poem_id": 1497,
    "vorder": 283,
    "position": 0,
    "text": "چو یک نیمه ببرید زآن کوه شاه"
  },
  {
    "poem_id": 1497,
    "vorder": 284,
    "position": 1,
    "text": "گران کرد باز آن عنان سیاه"
  },
  {
    "poem_id": 1497,
    "vorder": 285,
    "position": 0,
    "text": "همی بود تا پیش او رفت گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 286,
    "position": 1,
    "text": "چنین گفت بیدار دل شاه نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 287,
    "position": 0,
    "text": "که شاید که اندیشهٔ پهلوان"
  },
  {
    "poem_id": 1497,
    "vorder": 288,
    "position": 1,
    "text": "کنم آشکارا به روشن روان"
  },
  {
    "poem_id": 1497,
    "vorder": 289,
    "position": 0,
    "text": "بدو گفت گیو ای شه سرفراز"
  },
  {
    "poem_id": 1497,
    "vorder": 290,
    "position": 1,
    "text": "سزد که‌آشکارا بود بر تو راز"
  },
  {
    "poem_id": 1497,
    "vorder": 291,
    "position": 0,
    "text": "تو از ایزدی فر و برز کیان"
  },
  {
    "poem_id": 1497,
    "vorder": 292,
    "position": 1,
    "text": "به موی اندر آیی ببینی میان"
  },
  {
    "poem_id": 1497,
    "vorder": 293,
    "position": 0,
    "text": "بدو گفت زین اسپ فرخ نژاد"
  },
  {
    "poem_id": 1497,
    "vorder": 294,
    "position": 1,
    "text": "یکی بر دل اندیشه آمدت یاد"
  },
  {
    "poem_id": 1497,
    "vorder": 295,
    "position": 0,
    "text": "چنین بود اندیشهٔ پهلوان"
  },
  {
    "poem_id": 1497,
    "vorder": 296,
    "position": 1,
    "text": "که اهریمن آمد برِ این جوان"
  },
  {
    "poem_id": 1497,
    "vorder": 297,
    "position": 0,
    "text": "کنون رفت و رنج مرا باد کرد"
  },
  {
    "poem_id": 1497,
    "vorder": 298,
    "position": 1,
    "text": "دل شاد من سخت ناشاد کرد"
  },
  {
    "poem_id": 1497,
    "vorder": 299,
    "position": 0,
    "text": "ز اسپ اندر آمد جهان‌دیده گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 300,
    "position": 1,
    "text": "همی آفرین خواند بر شاه نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 301,
    "position": 0,
    "text": "که روز و شبان بر تو فرخنده باد"
  },
  {
    "poem_id": 1497,
    "vorder": 302,
    "position": 1,
    "text": "سر بدسگالان تو کنده باد"
  },
  {
    "poem_id": 1497,
    "vorder": 303,
    "position": 0,
    "text": "که با برز و اورندی و رای و فر"
  },
  {
    "poem_id": 1497,
    "vorder": 304,
    "position": 1,
    "text": "ترا داد داور هنر با گهر"
  },
  {
    "poem_id": 1497,
    "vorder": 305,
    "position": 0,
    "text": "ز بالا به ایوان نهادند روی"
  },
  {
    "poem_id": 1497,
    "vorder": 306,
    "position": 1,
    "text": "پر‌اندیشه مغز و روان راه‌جوی"
  },
  {
    "poem_id": 1497,
    "vorder": 307,
    "position": 0,
    "text": "چو نزد فرنگیس رفتند باز"
  },
  {
    "poem_id": 1497,
    "vorder": 308,
    "position": 1,
    "text": "سخن رفت چندی ز راه دراز"
  },
  {
    "poem_id": 1497,
    "vorder": 309,
    "position": 0,
    "text": "بدان تا نهانی بود کارشان"
  },
  {
    "poem_id": 1497,
    "vorder": 310,
    "position": 1,
    "text": "نباشد کسی آگه از رازشان"
  },
  {
    "poem_id": 1497,
    "vorder": 311,
    "position": 0,
    "text": "فرنگیس چون روی بهزاد دید"
  },
  {
    "poem_id": 1497,
    "vorder": 312,
    "position": 1,
    "text": "شد از آب دیده رخش ناپدید"
  },
  {
    "poem_id": 1497,
    "vorder": 313,
    "position": 0,
    "text": "دو رخ را به یال و برش بر نهاد"
  },
  {
    "poem_id": 1497,
    "vorder": 314,
    "position": 1,
    "text": "ز درد سیاوش بسی کرد یاد"
  },
  {
    "poem_id": 1497,
    "vorder": 315,
    "position": 0,
    "text": "چو آب دو دیده پراگنده کرد"
  },
  {
    "poem_id": 1497,
    "vorder": 316,
    "position": 1,
    "text": "سبک‌سر سوی گنج آگنده کرد"
  },
  {
    "poem_id": 1497,
    "vorder": 317,
    "position": 0,
    "text": "به ایوان یکی گنج بودش نهان"
  },
  {
    "poem_id": 1497,
    "vorder": 318,
    "position": 1,
    "text": "نبد زآن کسی آگه اندر جهان"
  },
  {
    "poem_id": 1497,
    "vorder": 319,
    "position": 0,
    "text": "یکی گنج آگنده دینار بود"
  },
  {
    "poem_id": 1497,
    "vorder": 320,
    "position": 1,
    "text": "زره بود و یاقوت بسیار بود"
  },
  {
    "poem_id": 1497,
    "vorder": 321,
    "position": 0,
    "text": "همان گنج گوپال و برگستوان"
  },
  {
    "poem_id": 1497,
    "vorder": 322,
    "position": 1,
    "text": "همان خنجر و تیغ و گرز گران"
  },
  {
    "poem_id": 1497,
    "vorder": 323,
    "position": 0,
    "text": "در گنج بگشاد پیش پسر"
  },
  {
    "poem_id": 1497,
    "vorder": 324,
    "position": 1,
    "text": "پر از خون رخ از درد خسته جگر"
  },
  {
    "poem_id": 1497,
    "vorder": 325,
    "position": 0,
    "text": "چنین گفت با گیو کای برده رنج"
  },
  {
    "poem_id": 1497,
    "vorder": 326,
    "position": 1,
    "text": "ببین تا ز گوهر چه خواهی ز گنج"
  },
  {
    "poem_id": 1497,
    "vorder": 327,
    "position": 0,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1497,
    "vorder": 328,
    "position": 1,
    "text": "ز یاقوت وز تاج گوهر‌نگار"
  },
  {
    "poem_id": 1497,
    "vorder": 329,
    "position": 0,
    "text": "ببوسید پیشش زمین پهلوان"
  },
  {
    "poem_id": 1497,
    "vorder": 330,
    "position": 1,
    "text": "بدو گفت کای مهتر بانوان"
  },
  {
    "poem_id": 1497,
    "vorder": 331,
    "position": 0,
    "text": "همه پاسبانیم و گنج آن تست"
  },
  {
    "poem_id": 1497,
    "vorder": 332,
    "position": 1,
    "text": "فدی کردن جان و رنج آن تست"
  },
  {
    "poem_id": 1497,
    "vorder": 333,
    "position": 0,
    "text": "زمین از تو گردد بهار بهشت"
  },
  {
    "poem_id": 1497,
    "vorder": 334,
    "position": 1,
    "text": "سپهر از تو زاید همی خوب و زشت"
  },
  {
    "poem_id": 1497,
    "vorder": 335,
    "position": 0,
    "text": "جهان پیش فرزند تو بنده باد"
  },
  {
    "poem_id": 1497,
    "vorder": 336,
    "position": 1,
    "text": "سر بدسگالانش افگنده باد"
  },
  {
    "poem_id": 1497,
    "vorder": 337,
    "position": 0,
    "text": "چو افتاد بر خواسته چشم گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 338,
    "position": 1,
    "text": "گزین کرد درع سیاووش نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 339,
    "position": 0,
    "text": "ز گوهر که پرمایه‌تر یافتند"
  },
  {
    "poem_id": 1497,
    "vorder": 340,
    "position": 1,
    "text": "ببردند چندان که برتافتند"
  },
  {
    "poem_id": 1497,
    "vorder": 341,
    "position": 0,
    "text": "همان ترگ و پرمایه برگستوان"
  },
  {
    "poem_id": 1497,
    "vorder": 342,
    "position": 1,
    "text": "سلیحی که بود از در پهلوان"
  },
  {
    "poem_id": 1497,
    "vorder": 343,
    "position": 0,
    "text": "سر گنج را شاه کرد استوار"
  },
  {
    "poem_id": 1497,
    "vorder": 344,
    "position": 1,
    "text": "به راه بیابان برآراست کار"
  },
  {
    "poem_id": 1497,
    "vorder": 345,
    "position": 0,
    "text": "چو این کرده شد برنهادند زین"
  },
  {
    "poem_id": 1497,
    "vorder": 346,
    "position": 1,
    "text": "بر آن بادپایان با‌آفرین"
  },
  {
    "poem_id": 1497,
    "vorder": 347,
    "position": 0,
    "text": "فرنگیس ترگی به سر بر نهاد"
  },
  {
    "poem_id": 1497,
    "vorder": 348,
    "position": 1,
    "text": "برفتند هر سه به کردار باد"
  },
  {
    "poem_id": 1497,
    "vorder": 349,
    "position": 0,
    "text": "سران سوی ایران نهادند گرم"
  },
  {
    "poem_id": 1497,
    "vorder": 350,
    "position": 1,
    "text": "نهانی چنان چون بود نرم نرم"
  },
  {
    "poem_id": 1497,
    "vorder": 351,
    "position": 0,
    "text": "بشد شهر یکسر پر از گفت و گوی"
  },
  {
    "poem_id": 1497,
    "vorder": 352,
    "position": 1,
    "text": "که خسرو به ایران نهاده‌ست روی"
  },
  {
    "poem_id": 1497,
    "vorder": 353,
    "position": 0,
    "text": "نماند این سخن یک زمان در نهفت"
  },
  {
    "poem_id": 1497,
    "vorder": 354,
    "position": 1,
    "text": "کس آمد به نزدیک پیران بگفت"
  },
  {
    "poem_id": 1497,
    "vorder": 355,
    "position": 0,
    "text": "که آمد ز ایران سرافراز گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 356,
    "position": 1,
    "text": "به نزدیک بیدار دل شاه نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 357,
    "position": 0,
    "text": "سوی شهر ایران نهادند روی"
  },
  {
    "poem_id": 1497,
    "vorder": 358,
    "position": 1,
    "text": "فرنگیس و شاه و گو جنگ‌جوی"
  },
  {
    "poem_id": 1497,
    "vorder": 359,
    "position": 0,
    "text": "چو بشنید پیران غمی گشت سخت"
  },
  {
    "poem_id": 1497,
    "vorder": 360,
    "position": 1,
    "text": "بلرزید بر سان برگ درخت"
  },
  {
    "poem_id": 1497,
    "vorder": 361,
    "position": 0,
    "text": "ز گردان گزین کرد کلباد را"
  },
  {
    "poem_id": 1497,
    "vorder": 362,
    "position": 1,
    "text": "چو نستیهن و گرد پولاد را"
  },
  {
    "poem_id": 1497,
    "vorder": 363,
    "position": 0,
    "text": "بفرمود تا ترک سیصد سوار"
  },
  {
    "poem_id": 1497,
    "vorder": 364,
    "position": 1,
    "text": "برفتند تازان بر آن کارزار"
  },
  {
    "poem_id": 1497,
    "vorder": 365,
    "position": 0,
    "text": "سر گیو بر نیزه سازید گفت"
  },
  {
    "poem_id": 1497,
    "vorder": 366,
    "position": 1,
    "text": "فرنگیس را خاک باید نهفت"
  },
  {
    "poem_id": 1497,
    "vorder": 367,
    "position": 0,
    "text": "ببندید کیخسرو شوم را"
  },
  {
    "poem_id": 1497,
    "vorder": 368,
    "position": 1,
    "text": "بد اختر پی او بر و بوم را"
  },
  {
    "poem_id": 1497,
    "vorder": 369,
    "position": 0,
    "text": "سپاهی بر این گونه گرد و جوان"
  },
  {
    "poem_id": 1497,
    "vorder": 370,
    "position": 1,
    "text": "برفتند بیدار دو پهلوان"
  },
  {
    "poem_id": 1497,
    "vorder": 371,
    "position": 0,
    "text": "فرنگیس با رنج دیده پسر"
  },
  {
    "poem_id": 1497,
    "vorder": 372,
    "position": 1,
    "text": "به خواب اندر آورده بودند سر"
  },
  {
    "poem_id": 1497,
    "vorder": 373,
    "position": 0,
    "text": "ز پیمودن راه و رنج شبان"
  },
  {
    "poem_id": 1497,
    "vorder": 374,
    "position": 1,
    "text": "جهانجوی را گیو بد پاسبان"
  },
  {
    "poem_id": 1497,
    "vorder": 375,
    "position": 0,
    "text": "دو تن خفته و گیو با رنج و خشم"
  },
  {
    "poem_id": 1497,
    "vorder": 376,
    "position": 1,
    "text": "به راه سواران نهاده دو چشم"
  },
  {
    "poem_id": 1497,
    "vorder": 377,
    "position": 0,
    "text": "به برگستوان اندرون اسپ گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 378,
    "position": 1,
    "text": "چنان چون بود ساز مردان نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 379,
    "position": 0,
    "text": "زره در بر و بر سرش بود ترگ"
  },
  {
    "poem_id": 1497,
    "vorder": 380,
    "position": 1,
    "text": "دل ارغنده و تن نهاده به مرگ"
  },
  {
    "poem_id": 1497,
    "vorder": 381,
    "position": 0,
    "text": "چو از دور گرد سپه را بدید"
  },
  {
    "poem_id": 1497,
    "vorder": 382,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 1497,
    "vorder": 383,
    "position": 0,
    "text": "خروشی برآورد بر سان ابر"
  },
  {
    "poem_id": 1497,
    "vorder": 384,
    "position": 1,
    "text": "که تاریک شد مغز و چشم هژبر"
  },
  {
    "poem_id": 1497,
    "vorder": 385,
    "position": 0,
    "text": "میان سواران بیامد چو گرد"
  },
  {
    "poem_id": 1497,
    "vorder": 386,
    "position": 1,
    "text": "ز پرخاش او خاک شد لاژورد"
  },
  {
    "poem_id": 1497,
    "vorder": 387,
    "position": 0,
    "text": "زمانی به خنجر زمانی به گرز"
  },
  {
    "poem_id": 1497,
    "vorder": 388,
    "position": 1,
    "text": "همی ریخت آهن ز بالای برز"
  },
  {
    "poem_id": 1497,
    "vorder": 389,
    "position": 0,
    "text": "از آن زخم گوپال گیو دلیر"
  },
  {
    "poem_id": 1497,
    "vorder": 390,
    "position": 1,
    "text": "سران را همی شد سر از جنگ سیر"
  },
  {
    "poem_id": 1497,
    "vorder": 391,
    "position": 0,
    "text": "دل گیو خندان شد از زور خشم"
  },
  {
    "poem_id": 1497,
    "vorder": 392,
    "position": 1,
    "text": "که چون چشمه بودیش دریا به چشم"
  },
  {
    "poem_id": 1497,
    "vorder": 393,
    "position": 0,
    "text": "از آن پس گرفتندش اندر میان"
  },
  {
    "poem_id": 1497,
    "vorder": 394,
    "position": 1,
    "text": "چنان لشکری همچو شیر ژیان"
  },
  {
    "poem_id": 1497,
    "vorder": 395,
    "position": 0,
    "text": "ز نیزه نیستان شد آوردگاه"
  },
  {
    "poem_id": 1497,
    "vorder": 396,
    "position": 1,
    "text": "بپوشید دیدار خورشید و ماه"
  },
  {
    "poem_id": 1497,
    "vorder": 397,
    "position": 0,
    "text": "غمی شد دل شیر در نیستان"
  },
  {
    "poem_id": 1497,
    "vorder": 398,
    "position": 1,
    "text": "ز خون نیستان کرد چون میستان"
  },
  {
    "poem_id": 1497,
    "vorder": 399,
    "position": 0,
    "text": "از ایشان بیفگند بسیار گیو"
  },
  {
    "poem_id": 1497,
    "vorder": 400,
    "position": 1,
    "text": "ستوه آمدند آن سواران ز نیو"
  },
  {
    "poem_id": 1497,
    "vorder": 401,
    "position": 0,
    "text": "به نستیهن گرد کلباد گفت"
  },
  {
    "poem_id": 1497,
    "vorder": 402,
    "position": 1,
    "text": "که این کوه خارا‌ست نه یال و سفت"
  },
  {
    "poem_id": 1497,
    "vorder": 403,
    "position": 0,
    "text": "همه خسته و بسته گشتند باز"
  },
  {
    "poem_id": 1497,
    "vorder": 404,
    "position": 1,
    "text": "به نزدیک پیران گردن فراز"
  },
  {
    "poem_id": 1497,
    "vorder": 405,
    "position": 0,
    "text": "همه غار و هامون پر از کشته بود"
  },
  {
    "poem_id": 1497,
    "vorder": 406,
    "position": 1,
    "text": "ز خون خاک چون ارغوان گشته بود"
  },
  {
    "poem_id": 1497,
    "vorder": 407,
    "position": 0,
    "text": "چو نزدیک کیخسرو آمد دلیر"
  },
  {
    "poem_id": 1497,
    "vorder": 408,
    "position": 1,
    "text": "پر از خون بر و چنگ بر سان شیر"
  },
  {
    "poem_id": 1497,
    "vorder": 409,
    "position": 0,
    "text": "بدو گفت کای شاه‌، دل شاد دار"
  },
  {
    "poem_id": 1497,
    "vorder": 410,
    "position": 1,
    "text": "خرد را ز اندیشه آزاد دار"
  },
  {
    "poem_id": 1497,
    "vorder": 411,
    "position": 0,
    "text": "یکی لشکر آمد بر ما به جنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 412,
    "position": 1,
    "text": "چو کلباد و نستیهن تیز چنگ"
  },
  {
    "poem_id": 1497,
    "vorder": 413,
    "position": 0,
    "text": "چنان بازگشتند آن کس که زیست"
  },
  {
    "poem_id": 1497,
    "vorder": 414,
    "position": 1,
    "text": "که بر یال و برشان بباید گریست"
  },
  {
    "poem_id": 1497,
    "vorder": 415,
    "position": 0,
    "text": "گذشته ز رستم به ایران سوار"
  },
  {
    "poem_id": 1497,
    "vorder": 416,
    "position": 1,
    "text": "ندانم که با من کند کارزار"
  },
  {
    "poem_id": 1497,
    "vorder": 417,
    "position": 0,
    "text": "از او شاد شد خسرو پاک‌دین"
  },
  {
    "poem_id": 1497,
    "vorder": 418,
    "position": 1,
    "text": "ستودش فراوان و کرد آفرین"
  },
  {
    "poem_id": 1497,
    "vorder": 419,
    "position": 0,
    "text": "بخوردند چیزی کجا یافتند"
  },
  {
    "poem_id": 1497,
    "vorder": 420,
    "position": 1,
    "text": "سوی راه بی‌راه بشتافتند"
  },
  {
    "poem_id": 1497,
    "vorder": 421,
    "position": 0,
    "text": "چو ترکان به نزدیک پیران شدند"
  },
  {
    "poem_id": 1497,
    "vorder": 422,
    "position": 1,
    "text": "چنان خسته و زار و گریان شدند"
  },
  {
    "poem_id": 1497,
    "vorder": 423,
    "position": 0,
    "text": "برآشفت پیران به کلباد گفت"
  },
  {
    "poem_id": 1497,
    "vorder": 424,
    "position": 1,
    "text": "که چونین شگفتی نشاید نهفت"
  },
  {
    "poem_id": 1497,
    "vorder": 425,
    "position": 0,
    "text": "چه کردید با گیو و خسرو کجاست"
  },
  {
    "poem_id": 1497,
    "vorder": 426,
    "position": 1,
    "text": "سخن بر چه سان است برگوی راست"
  },
  {
    "poem_id": 1497,
    "vorder": 427,
    "position": 0,
    "text": "بدو گفت کلباد کای پهلوان"
  },
  {
    "poem_id": 1497,
    "vorder": 428,
    "position": 1,
    "text": "به پیش تو گر برگشایم زبان"
  },
  {
    "poem_id": 1497,
    "vorder": 429,
    "position": 0,
    "text": "که گیو دلاور به گردان چه کرد"
  },
  {
    "poem_id": 1497,
    "vorder": 430,
    "position": 1,
    "text": "دلت سیر گردد به دشت نبرد"
  },
  {
    "poem_id": 1497,
    "vorder": 431,
    "position": 0,
    "text": "فراوان به لشکر مرا دیده‌ای"
  },
  {
    "poem_id": 1497,
    "vorder": 432,
    "position": 1,
    "text": "نبرد مرا هم پسندیده‌ای"
  },
  {
    "poem_id": 1497,
    "vorder": 433,
    "position": 0,
    "text": "همانا که گوپال بیش از هزار"
  },
  {
    "poem_id": 1497,
    "vorder": 434,
    "position": 1,
    "text": "گرفتی ز دست من آن نامدار"
  },
  {
    "poem_id": 1497,
    "vorder": 435,
    "position": 0,
    "text": "سرش ویژه گفتی که سندان شده‌ست"
  },
  {
    "poem_id": 1497,
    "vorder": 436,
    "position": 1,
    "text": "بر و ساعدش پیل دندان شده‌ست"
  },
  {
    "poem_id": 1497,
    "vorder": 437,
    "position": 0,
    "text": "من آورد رستم بسی دیده‌ام"
  },
  {
    "poem_id": 1497,
    "vorder": 438,
    "position": 1,
    "text": "ز جنگ‌آوران نیز بشنیده‌ام"
  },
  {
    "poem_id": 1497,
    "vorder": 439,
    "position": 0,
    "text": "به زخمش ندیدم چنین پایدار"
  },
  {
    "poem_id": 1497,
    "vorder": 440,
    "position": 1,
    "text": "نه در کوشش و پیچش کارزار"
  },
  {
    "poem_id": 1497,
    "vorder": 441,
    "position": 0,
    "text": "همی هر زمان تیز و جوشان بدی"
  },
  {
    "poem_id": 1497,
    "vorder": 442,
    "position": 1,
    "text": "به نوی چو پیلی خروشان بدی"
  },
  {
    "poem_id": 1497,
    "vorder": 443,
    "position": 0,
    "text": "برآشفت پیران بدو گفت بس"
  },
  {
    "poem_id": 1497,
    "vorder": 444,
    "position": 1,
    "text": "که ننگ است از این یاد کردن به کس"
  },
  {
    "poem_id": 1497,
    "vorder": 445,
    "position": 0,
    "text": "نه از یک سوار است چندین سخن"
  },
  {
    "poem_id": 1497,
    "vorder": 446,
    "position": 1,
    "text": "تو آهنگ آورد مردان مکن"
  },
  {
    "poem_id": 1497,
    "vorder": 447,
    "position": 0,
    "text": "تو رفتی و نستیهن نامور"
  },
  {
    "poem_id": 1497,
    "vorder": 448,
    "position": 1,
    "text": "سپاهی به کردار شیران نر"
  },
  {
    "poem_id": 1497,
    "vorder": 449,
    "position": 0,
    "text": "کنون گیو را ساختی پیل مست"
  },
  {
    "poem_id": 1497,
    "vorder": 450,
    "position": 1,
    "text": "میان یلان گشت نام تو پست"
  },
  {
    "poem_id": 1497,
    "vorder": 451,
    "position": 0,
    "text": "چو ز این یابد افراسیاب آگهی"
  },
  {
    "poem_id": 1497,
    "vorder": 452,
    "position": 1,
    "text": "بیندازد آن تاج شاهنشهی"
  },
  {
    "poem_id": 1497,
    "vorder": 453,
    "position": 0,
    "text": "که دو پهلوان دلیر و سوار"
  },
  {
    "poem_id": 1497,
    "vorder": 454,
    "position": 1,
    "text": "چنین لشکری از در کارزار"
  },
  {
    "poem_id": 1497,
    "vorder": 455,
    "position": 0,
    "text": "ز پیش سواری نمودید پشت"
  },
  {
    "poem_id": 1497,
    "vorder": 456,
    "position": 1,
    "text": "بسی از دلیران ترکان بکشت"
  },
  {
    "poem_id": 1497,
    "vorder": 457,
    "position": 0,
    "text": "گواژه بسی باشدت با فسوس"
  },
  {
    "poem_id": 1497,
    "vorder": 458,
    "position": 1,
    "text": "نه مرد نبردی و گوپال و کوس"
  }
]