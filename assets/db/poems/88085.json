[
  {
    "poem_id": 88085,
    "vorder": 1,
    "position": 0,
    "text": "بیامد جهاندار با تیغ تیز"
  },
  {
    "poem_id": 88085,
    "vorder": 2,
    "position": 1,
    "text": "سری پر ز کینه دلی پر ستیز"
  },
  {
    "poem_id": 88085,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت بی‌دولت افراسیاب"
  },
  {
    "poem_id": 88085,
    "vorder": 4,
    "position": 1,
    "text": "که این روز را دیده بودم به خواب"
  },
  {
    "poem_id": 88085,
    "vorder": 5,
    "position": 0,
    "text": "سپهر بلند ار فراوان کشید"
  },
  {
    "poem_id": 88085,
    "vorder": 6,
    "position": 1,
    "text": "همان پردهٔ رازها بردرید"
  },
  {
    "poem_id": 88085,
    "vorder": 7,
    "position": 0,
    "text": "به آواز گفت ای بد کینه جوی"
  },
  {
    "poem_id": 88085,
    "vorder": 8,
    "position": 1,
    "text": "چرا کشت خواهی نیا را بگوی"
  },
  {
    "poem_id": 88085,
    "vorder": 9,
    "position": 0,
    "text": "چنین داد پاسخ که ای بدکنش"
  },
  {
    "poem_id": 88085,
    "vorder": 10,
    "position": 1,
    "text": "سزاوار پیغاره و سرزنش"
  },
  {
    "poem_id": 88085,
    "vorder": 11,
    "position": 0,
    "text": "ز جان برادرت گویم نخست"
  },
  {
    "poem_id": 88085,
    "vorder": 12,
    "position": 1,
    "text": "که هرگز بلای مهان را نجست"
  },
  {
    "poem_id": 88085,
    "vorder": 13,
    "position": 0,
    "text": "دگر نوذر آن نامور شهریار"
  },
  {
    "poem_id": 88085,
    "vorder": 14,
    "position": 1,
    "text": "که از تخم ایرج بد او یادگار"
  },
  {
    "poem_id": 88085,
    "vorder": 15,
    "position": 0,
    "text": "زدی گردنش را به شمشیر تیز"
  },
  {
    "poem_id": 88085,
    "vorder": 16,
    "position": 1,
    "text": "برانگیختی از جهان رستخیز"
  },
  {
    "poem_id": 88085,
    "vorder": 17,
    "position": 0,
    "text": "سه دیگر سیاوش که چون او سوار"
  },
  {
    "poem_id": 88085,
    "vorder": 18,
    "position": 1,
    "text": "نبیند کسی از مهان یادگار"
  },
  {
    "poem_id": 88085,
    "vorder": 19,
    "position": 0,
    "text": "بریدی سرش چون سر گوسفند"
  },
  {
    "poem_id": 88085,
    "vorder": 20,
    "position": 1,
    "text": "همی برگذشتی ز چرخ بلند"
  },
  {
    "poem_id": 88085,
    "vorder": 21,
    "position": 0,
    "text": "به کردار بد تیز بشتافتی"
  },
  {
    "poem_id": 88085,
    "vorder": 22,
    "position": 1,
    "text": "مکافات آن بد کنون یافتی"
  },
  {
    "poem_id": 88085,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت شاها ببود آنچه بود"
  },
  {
    "poem_id": 88085,
    "vorder": 24,
    "position": 1,
    "text": "کنون داستانم بباید شنود"
  },
  {
    "poem_id": 88085,
    "vorder": 25,
    "position": 0,
    "text": "بمان تا مگر مادرت را به جان"
  },
  {
    "poem_id": 88085,
    "vorder": 26,
    "position": 1,
    "text": "ببینم پس این داستانها بخوان"
  },
  {
    "poem_id": 88085,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت گر خواستی مادرم"
  },
  {
    "poem_id": 88085,
    "vorder": 28,
    "position": 1,
    "text": "چرا آتش افروختی بر سرم"
  },
  {
    "poem_id": 88085,
    "vorder": 29,
    "position": 0,
    "text": "پدر بیگنه بود و من در نهان"
  },
  {
    "poem_id": 88085,
    "vorder": 30,
    "position": 1,
    "text": "چه رفت از گزند تو اندر جهان"
  },
  {
    "poem_id": 88085,
    "vorder": 31,
    "position": 0,
    "text": "سر شهریاری ربودی که تاج"
  },
  {
    "poem_id": 88085,
    "vorder": 32,
    "position": 1,
    "text": "بدو زار گریان شد و تخت عاج"
  },
  {
    "poem_id": 88085,
    "vorder": 33,
    "position": 0,
    "text": "کنون روز بادافره ایزدیست"
  },
  {
    "poem_id": 88085,
    "vorder": 34,
    "position": 1,
    "text": "مکافات بد را ز یزدان بدیست"
  },
  {
    "poem_id": 88085,
    "vorder": 35,
    "position": 0,
    "text": "به شمشیر هندی بزد گردنش"
  },
  {
    "poem_id": 88085,
    "vorder": 36,
    "position": 1,
    "text": "به خاک اندر افگند نازک تنش"
  },
  {
    "poem_id": 88085,
    "vorder": 37,
    "position": 0,
    "text": "ز خون لعل شد ریش و موی سپید"
  },
  {
    "poem_id": 88085,
    "vorder": 38,
    "position": 1,
    "text": "برادرش گشت از جهان ناامید"
  },
  {
    "poem_id": 88085,
    "vorder": 39,
    "position": 0,
    "text": "تهی ماند ز او گاه شاهنشهی"
  },
  {
    "poem_id": 88085,
    "vorder": 40,
    "position": 1,
    "text": "سرآمد بر او روزگار مهی"
  },
  {
    "poem_id": 88085,
    "vorder": 41,
    "position": 0,
    "text": "ز کردار بد بر تنش بد رسید"
  },
  {
    "poem_id": 88085,
    "vorder": 42,
    "position": 1,
    "text": "مجو ای پسر بند بد را کلید"
  },
  {
    "poem_id": 88085,
    "vorder": 43,
    "position": 0,
    "text": "چو جویی بدانی که از کار بد"
  },
  {
    "poem_id": 88085,
    "vorder": 44,
    "position": 1,
    "text": "به فرجام بر بدکنش بد رسد"
  },
  {
    "poem_id": 88085,
    "vorder": 45,
    "position": 0,
    "text": "سپهبد که با فر یزدان بود"
  },
  {
    "poem_id": 88085,
    "vorder": 46,
    "position": 1,
    "text": "همه خشم او بند و زندان بود"
  },
  {
    "poem_id": 88085,
    "vorder": 47,
    "position": 0,
    "text": "چو خونریز گردد بماند نژند"
  },
  {
    "poem_id": 88085,
    "vorder": 48,
    "position": 1,
    "text": "مکافات یابد ز چرخ بلند"
  },
  {
    "poem_id": 88085,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت موبد به بهرام تیز"
  },
  {
    "poem_id": 88085,
    "vorder": 50,
    "position": 1,
    "text": "که خون سر بیگناهان مریز"
  },
  {
    "poem_id": 88085,
    "vorder": 51,
    "position": 0,
    "text": "چو خواهی که تاج تو ماند به جای"
  },
  {
    "poem_id": 88085,
    "vorder": 52,
    "position": 1,
    "text": "مبادی جز آهسته و پاک‌رای"
  },
  {
    "poem_id": 88085,
    "vorder": 53,
    "position": 0,
    "text": "نگه کن که خود تاج با سر چه گفت"
  },
  {
    "poem_id": 88085,
    "vorder": 54,
    "position": 1,
    "text": "که با مغزت ای سر خرد باد جفت"
  },
  {
    "poem_id": 88085,
    "vorder": 55,
    "position": 0,
    "text": "به گرسیوز آمد ز کار نیا"
  },
  {
    "poem_id": 88085,
    "vorder": 56,
    "position": 1,
    "text": "دو رخ زرد و یک دل پر از کیمیا"
  },
  {
    "poem_id": 88085,
    "vorder": 57,
    "position": 0,
    "text": "کشیدندش از پیش دژخیم زار"
  },
  {
    "poem_id": 88085,
    "vorder": 58,
    "position": 1,
    "text": "به بند گران و به بد روزگار"
  },
  {
    "poem_id": 88085,
    "vorder": 59,
    "position": 0,
    "text": "ابا روزبانان مردم‌کشان"
  },
  {
    "poem_id": 88085,
    "vorder": 60,
    "position": 1,
    "text": "چنانچون بود مردم بدنشان"
  },
  {
    "poem_id": 88085,
    "vorder": 61,
    "position": 0,
    "text": "چو در پیش کیخسرو آمد به درد"
  },
  {
    "poem_id": 88085,
    "vorder": 62,
    "position": 1,
    "text": "ببارید خون بر رخ لاژورد"
  },
  {
    "poem_id": 88085,
    "vorder": 63,
    "position": 0,
    "text": "شهنشاه ایران زبان برگشاد"
  },
  {
    "poem_id": 88085,
    "vorder": 64,
    "position": 1,
    "text": "و زآن تشت و خنجر بسی کرد یاد"
  },
  {
    "poem_id": 88085,
    "vorder": 65,
    "position": 0,
    "text": "ز تور و فریدون و سلم سترگ"
  },
  {
    "poem_id": 88085,
    "vorder": 66,
    "position": 1,
    "text": "ز ایرج که بد پادشاه بزرگ"
  },
  {
    "poem_id": 88085,
    "vorder": 67,
    "position": 0,
    "text": "به دژخیم فرمود تا تیغ تیز"
  },
  {
    "poem_id": 88085,
    "vorder": 68,
    "position": 1,
    "text": "کشید و بیامد دلی پر ستیز"
  },
  {
    "poem_id": 88085,
    "vorder": 69,
    "position": 0,
    "text": "میان سپهبد به دو نیم کرد"
  },
  {
    "poem_id": 88085,
    "vorder": 70,
    "position": 1,
    "text": "سپه را همه دل پر از بیم کرد"
  },
  {
    "poem_id": 88085,
    "vorder": 71,
    "position": 0,
    "text": "به هم برفگندندشان همچو کوه"
  },
  {
    "poem_id": 88085,
    "vorder": 72,
    "position": 1,
    "text": "ز هر سو به دور ایستاده گروه"
  },
  {
    "poem_id": 88085,
    "vorder": 73,
    "position": 0,
    "text": "ز یزدان چو شاه آرزوها بیافت"
  },
  {
    "poem_id": 88085,
    "vorder": 74,
    "position": 1,
    "text": "ز دریا سوی خان آذر شتافت"
  },
  {
    "poem_id": 88085,
    "vorder": 75,
    "position": 0,
    "text": "بسی زر بر آتش برافشاندند"
  },
  {
    "poem_id": 88085,
    "vorder": 76,
    "position": 1,
    "text": "به زمزم همی آفرین خواندند"
  },
  {
    "poem_id": 88085,
    "vorder": 77,
    "position": 0,
    "text": "ببودند یک روز و یک شب به پای"
  },
  {
    "poem_id": 88085,
    "vorder": 78,
    "position": 1,
    "text": "به پیش جهانداور رهنمای"
  },
  {
    "poem_id": 88085,
    "vorder": 79,
    "position": 0,
    "text": "چو گنجور کیخسرو آمد زرسب"
  },
  {
    "poem_id": 88085,
    "vorder": 80,
    "position": 1,
    "text": "ببخشید گنجی بر آذرگشسب"
  },
  {
    "poem_id": 88085,
    "vorder": 81,
    "position": 0,
    "text": "بر آن موبدان خلعت افگند نیز"
  },
  {
    "poem_id": 88085,
    "vorder": 82,
    "position": 1,
    "text": "درم داد و دینار و بسیار چیز"
  },
  {
    "poem_id": 88085,
    "vorder": 83,
    "position": 0,
    "text": "به شهر اندرون هر که درویش بود"
  },
  {
    "poem_id": 88085,
    "vorder": 84,
    "position": 1,
    "text": "وگر خوردش از کوشش خویش بود"
  },
  {
    "poem_id": 88085,
    "vorder": 85,
    "position": 0,
    "text": "بر آن نیز گنجی پراگنده کرد"
  },
  {
    "poem_id": 88085,
    "vorder": 86,
    "position": 1,
    "text": "جهانی به داد و دهش بنده کرد"
  },
  {
    "poem_id": 88085,
    "vorder": 87,
    "position": 0,
    "text": "از آن پس به تخت کیان برنشست"
  },
  {
    "poem_id": 88085,
    "vorder": 88,
    "position": 1,
    "text": "در بار بگشاد و لب را ببست"
  },
  {
    "poem_id": 88085,
    "vorder": 89,
    "position": 0,
    "text": "نبشتند نامه به هر کشوری"
  },
  {
    "poem_id": 88085,
    "vorder": 90,
    "position": 1,
    "text": "به هر نامداری و هر مهتری"
  },
  {
    "poem_id": 88085,
    "vorder": 91,
    "position": 0,
    "text": "ز خاور بشد نامه تا باختر"
  },
  {
    "poem_id": 88085,
    "vorder": 92,
    "position": 1,
    "text": "به جایی که بد مهتری با گهر"
  },
  {
    "poem_id": 88085,
    "vorder": 93,
    "position": 0,
    "text": "که روی زمین از بد اژدها"
  },
  {
    "poem_id": 88085,
    "vorder": 94,
    "position": 1,
    "text": "به شمشیر کیخسرو آمد رها"
  },
  {
    "poem_id": 88085,
    "vorder": 95,
    "position": 0,
    "text": "به نیروی یزدان پیروزگر"
  },
  {
    "poem_id": 88085,
    "vorder": 96,
    "position": 1,
    "text": "نیاسود و نگشاد هرگز کمر"
  },
  {
    "poem_id": 88085,
    "vorder": 97,
    "position": 0,
    "text": "روان سیاووش را زنده کرد"
  },
  {
    "poem_id": 88085,
    "vorder": 98,
    "position": 1,
    "text": "جهان را به داد و دهش بنده کرد"
  },
  {
    "poem_id": 88085,
    "vorder": 99,
    "position": 0,
    "text": "همی چیز بخشید درویش را"
  },
  {
    "poem_id": 88085,
    "vorder": 100,
    "position": 1,
    "text": "پرستنده و مردم خویش را"
  },
  {
    "poem_id": 88085,
    "vorder": 101,
    "position": 0,
    "text": "از آن پس چنین گفت شاه جهان"
  },
  {
    "poem_id": 88085,
    "vorder": 102,
    "position": 1,
    "text": "که ای نامداران فرخ مهان"
  },
  {
    "poem_id": 88085,
    "vorder": 103,
    "position": 0,
    "text": "زن و کودک خرد بیرون برید"
  },
  {
    "poem_id": 88085,
    "vorder": 104,
    "position": 1,
    "text": "خورشها و رامش به هامون برید"
  },
  {
    "poem_id": 88085,
    "vorder": 105,
    "position": 0,
    "text": "بپردخت زان پس به رامش نهاد"
  },
  {
    "poem_id": 88085,
    "vorder": 106,
    "position": 1,
    "text": "برفتند گردان خسرو نژاد"
  },
  {
    "poem_id": 88085,
    "vorder": 107,
    "position": 0,
    "text": "هر آن کس که بود از نژاد زرسب"
  },
  {
    "poem_id": 88085,
    "vorder": 108,
    "position": 1,
    "text": "بیامد به ایوان آذرگشسب"
  },
  {
    "poem_id": 88085,
    "vorder": 109,
    "position": 0,
    "text": "چهل روز با شاه کاووس کی"
  },
  {
    "poem_id": 88085,
    "vorder": 110,
    "position": 1,
    "text": "همی بود با رامش و رود و می"
  },
  {
    "poem_id": 88085,
    "vorder": 111,
    "position": 0,
    "text": "چو رخشنده شد بر فلک ماه نو"
  },
  {
    "poem_id": 88085,
    "vorder": 112,
    "position": 1,
    "text": "ز زر افسری بر سر شاه نو"
  },
  {
    "poem_id": 88085,
    "vorder": 113,
    "position": 0,
    "text": "بزرگان سوی پارس کردند روی"
  },
  {
    "poem_id": 88085,
    "vorder": 114,
    "position": 1,
    "text": "برآسوده از رزم وز گفتگوی"
  },
  {
    "poem_id": 88085,
    "vorder": 115,
    "position": 0,
    "text": "به هر شهر کاندر شدندی ز راه"
  },
  {
    "poem_id": 88085,
    "vorder": 116,
    "position": 1,
    "text": "شدی انجمن مرد بر پیشگاه"
  },
  {
    "poem_id": 88085,
    "vorder": 117,
    "position": 0,
    "text": "گشادی سر بدره‌ها شهریار"
  },
  {
    "poem_id": 88085,
    "vorder": 118,
    "position": 1,
    "text": "توانگر شدی مرد پرهیزگار"
  }
]