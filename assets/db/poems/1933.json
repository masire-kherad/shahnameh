[
  {
    "poem_id": 1933,
    "vorder": 1,
    "position": 0,
    "text": "یکی پهلوان بود گسترده‌کام"
  },
  {
    "poem_id": 1933,
    "vorder": 2,
    "position": 1,
    "text": "نژادش ز طرخان و بیژن بنام"
  },
  {
    "poem_id": 1933,
    "vorder": 3,
    "position": 0,
    "text": "نشستش به شهر سمرقند بود"
  },
  {
    "poem_id": 1933,
    "vorder": 4,
    "position": 1,
    "text": "بران مرز چندیش پیوند بود"
  },
  {
    "poem_id": 1933,
    "vorder": 5,
    "position": 0,
    "text": "چو ماهوی بدبخت خودکامه شد"
  },
  {
    "poem_id": 1933,
    "vorder": 6,
    "position": 1,
    "text": "ازو نزد بیژن یکی نامه شد"
  },
  {
    "poem_id": 1933,
    "vorder": 7,
    "position": 0,
    "text": "که ای پهلوان زادهٔ بی‌گزند"
  },
  {
    "poem_id": 1933,
    "vorder": 8,
    "position": 1,
    "text": "یکی رزم پیش آمدت سودمند"
  },
  {
    "poem_id": 1933,
    "vorder": 9,
    "position": 0,
    "text": "که شاه جهان با سپاه ایدرست"
  },
  {
    "poem_id": 1933,
    "vorder": 10,
    "position": 1,
    "text": "ابا تاج و گاهست و با افسرست"
  },
  {
    "poem_id": 1933,
    "vorder": 11,
    "position": 0,
    "text": "گر آیی سر و تاج و گاهش تو راست"
  },
  {
    "poem_id": 1933,
    "vorder": 12,
    "position": 1,
    "text": "همان گنج و چتر سیاهش تو راست"
  },
  {
    "poem_id": 1933,
    "vorder": 13,
    "position": 0,
    "text": "چو بیژن نگه کرد و آن نامه دید"
  },
  {
    "poem_id": 1933,
    "vorder": 14,
    "position": 1,
    "text": "جهان پیش ماهوی خودکامه دید"
  },
  {
    "poem_id": 1933,
    "vorder": 15,
    "position": 0,
    "text": "به دستور گفت ای سر راستان"
  },
  {
    "poem_id": 1933,
    "vorder": 16,
    "position": 1,
    "text": "چه داری بیاد اندرین داستان"
  },
  {
    "poem_id": 1933,
    "vorder": 17,
    "position": 0,
    "text": "به یاری ماهوی گر من سپاه"
  },
  {
    "poem_id": 1933,
    "vorder": 18,
    "position": 1,
    "text": "برانم شود کارم ایدر تباه"
  },
  {
    "poem_id": 1933,
    "vorder": 19,
    "position": 0,
    "text": "به من برکند شاه چینی فسوس"
  },
  {
    "poem_id": 1933,
    "vorder": 20,
    "position": 1,
    "text": "مرا بی‌منش خواند و چاپلوس"
  },
  {
    "poem_id": 1933,
    "vorder": 21,
    "position": 0,
    "text": "وگرنه کنم گوید از بیم کرد"
  },
  {
    "poem_id": 1933,
    "vorder": 22,
    "position": 1,
    "text": "همی‌ترسد از روز ننگ و نبرد"
  },
  {
    "poem_id": 1933,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد دستور پاسخ بدوی"
  },
  {
    "poem_id": 1933,
    "vorder": 24,
    "position": 1,
    "text": "که ای شیر‌دل مردِ پرخاشجوی"
  },
  {
    "poem_id": 1933,
    "vorder": 25,
    "position": 0,
    "text": "از ایدر تو را ننگ باشد شدن"
  },
  {
    "poem_id": 1933,
    "vorder": 26,
    "position": 1,
    "text": "به یاریِ ماهوی و باز‌آمدن"
  },
  {
    "poem_id": 1933,
    "vorder": 27,
    "position": 0,
    "text": "به برسام فرمای تا با سپاه"
  },
  {
    "poem_id": 1933,
    "vorder": 28,
    "position": 1,
    "text": "بِیاری شود سوی آن رزمگاه"
  },
  {
    "poem_id": 1933,
    "vorder": 29,
    "position": 0,
    "text": "به گفتار سوری شوی سوی جنگ"
  },
  {
    "poem_id": 1933,
    "vorder": 30,
    "position": 1,
    "text": "سبکسار خواند ترا مرد سنگ"
  },
  {
    "poem_id": 1933,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت بیژن که اینست رای"
  },
  {
    "poem_id": 1933,
    "vorder": 32,
    "position": 1,
    "text": "مرا خود نجنبید باید ز جای"
  },
  {
    "poem_id": 1933,
    "vorder": 33,
    "position": 0,
    "text": "به برسام فرمود تا ده هزار"
  },
  {
    "poem_id": 1933,
    "vorder": 34,
    "position": 1,
    "text": "نبرده‌سواران خنجرگزار"
  },
  {
    "poem_id": 1933,
    "vorder": 35,
    "position": 0,
    "text": "به مرو اندرون ساز جنگ آورد"
  },
  {
    "poem_id": 1933,
    "vorder": 36,
    "position": 1,
    "text": "مگر گنج ایران به چنگ آورد"
  },
  {
    "poem_id": 1933,
    "vorder": 37,
    "position": 0,
    "text": "سپاه از بخارا چو پرّان تذرو"
  },
  {
    "poem_id": 1933,
    "vorder": 38,
    "position": 1,
    "text": "بیامد به یک هفته تا شهر مرو"
  },
  {
    "poem_id": 1933,
    "vorder": 39,
    "position": 0,
    "text": "شب تیره هنگام بانگ خروس"
  },
  {
    "poem_id": 1933,
    "vorder": 40,
    "position": 1,
    "text": "از آن مرز برخاست آواز کوس"
  },
  {
    "poem_id": 1933,
    "vorder": 41,
    "position": 0,
    "text": "جهاندار زین خود نه آگاه بود"
  },
  {
    "poem_id": 1933,
    "vorder": 42,
    "position": 1,
    "text": "که ماهوی سوریش بدخواه بود"
  },
  {
    "poem_id": 1933,
    "vorder": 43,
    "position": 0,
    "text": "به شبگیر گاه سپیده‌دمان"
  },
  {
    "poem_id": 1933,
    "vorder": 44,
    "position": 1,
    "text": "سواری سوی خسرو آمد دوان"
  },
  {
    "poem_id": 1933,
    "vorder": 45,
    "position": 0,
    "text": "که ماهوی گوید که آمد سپاه"
  },
  {
    "poem_id": 1933,
    "vorder": 46,
    "position": 1,
    "text": "ز ترکان کنون بر چه رایست شاه"
  },
  {
    "poem_id": 1933,
    "vorder": 47,
    "position": 0,
    "text": "سپهدارِ خانست و فغفور چین"
  },
  {
    "poem_id": 1933,
    "vorder": 48,
    "position": 1,
    "text": "سپاهش همی برنتابد زمین"
  },
  {
    "poem_id": 1933,
    "vorder": 49,
    "position": 0,
    "text": "بر‌آشفت و جوشن بپوشید شاه"
  },
  {
    "poem_id": 1933,
    "vorder": 50,
    "position": 1,
    "text": "شد از گرد گیتی سراسر سیاه"
  },
  {
    "poem_id": 1933,
    "vorder": 51,
    "position": 0,
    "text": "چو نیروی پرخاش ترکان بدید"
  },
  {
    "poem_id": 1933,
    "vorder": 52,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 1933,
    "vorder": 53,
    "position": 0,
    "text": "به پیش سپاه اندر آمد چو پیل"
  },
  {
    "poem_id": 1933,
    "vorder": 54,
    "position": 1,
    "text": "زمین شد به کردار دریای نیل"
  },
  {
    "poem_id": 1933,
    "vorder": 55,
    "position": 0,
    "text": "چو بر لشکر ترک بر حمله برد"
  },
  {
    "poem_id": 1933,
    "vorder": 56,
    "position": 1,
    "text": "پس پشت او در نماند ایچ گُرد"
  },
  {
    "poem_id": 1933,
    "vorder": 57,
    "position": 0,
    "text": "همه پشت بر تاجور گاشتند"
  },
  {
    "poem_id": 1933,
    "vorder": 58,
    "position": 1,
    "text": "میان سوارانش بگذاشتند"
  },
  {
    "poem_id": 1933,
    "vorder": 59,
    "position": 0,
    "text": "چو برگشت ماهوی شاه جهان"
  },
  {
    "poem_id": 1933,
    "vorder": 60,
    "position": 1,
    "text": "بدانست نیرنگ او در نهان"
  },
  {
    "poem_id": 1933,
    "vorder": 61,
    "position": 0,
    "text": "چنین بود ماهوی را رای و راه"
  },
  {
    "poem_id": 1933,
    "vorder": 62,
    "position": 1,
    "text": "که او ماند اندر میان سپاه"
  },
  {
    "poem_id": 1933,
    "vorder": 63,
    "position": 0,
    "text": "شهنشاه در جنگ شد ناشکیب"
  },
  {
    "poem_id": 1933,
    "vorder": 64,
    "position": 1,
    "text": "همی‌زد به تیغ و به پای و رکیب"
  },
  {
    "poem_id": 1933,
    "vorder": 65,
    "position": 0,
    "text": "فراوان از آن نامداران بکشت"
  },
  {
    "poem_id": 1933,
    "vorder": 66,
    "position": 1,
    "text": "چو بیچاره‌تر گشت بنمود پشت"
  },
  {
    "poem_id": 1933,
    "vorder": 67,
    "position": 0,
    "text": "ز ترکان بسی بود در پشت اوی"
  },
  {
    "poem_id": 1933,
    "vorder": 68,
    "position": 1,
    "text": "یکی کابلی‌تیغ در مشت اوی"
  },
  {
    "poem_id": 1933,
    "vorder": 69,
    "position": 0,
    "text": "همی‌تاخت جوشان چو از ابر برق"
  },
  {
    "poem_id": 1933,
    "vorder": 70,
    "position": 1,
    "text": "یکی آسیا بُد بر آن آب زرق"
  },
  {
    "poem_id": 1933,
    "vorder": 71,
    "position": 0,
    "text": "فرود آمد از باره شاه جهان"
  },
  {
    "poem_id": 1933,
    "vorder": 72,
    "position": 1,
    "text": "ز بدخواه در آسیا شد نهان"
  },
  {
    "poem_id": 1933,
    "vorder": 73,
    "position": 0,
    "text": "سواران بجستن نهادند روی"
  },
  {
    "poem_id": 1933,
    "vorder": 74,
    "position": 1,
    "text": "همه زرق ازو شد پر از گفت‌وگوی"
  },
  {
    "poem_id": 1933,
    "vorder": 75,
    "position": 0,
    "text": "ازو بازماند اسپ زرین ستام"
  },
  {
    "poem_id": 1933,
    "vorder": 76,
    "position": 1,
    "text": "همان گرز و شمشیر زرین‌نیام"
  },
  {
    "poem_id": 1933,
    "vorder": 77,
    "position": 0,
    "text": "بجستنش ترکان خروشان شدند"
  },
  {
    "poem_id": 1933,
    "vorder": 78,
    "position": 1,
    "text": "از آن باره و ساز جوشان شدند"
  },
  {
    "poem_id": 1933,
    "vorder": 79,
    "position": 0,
    "text": "نهان گشته در خانهٔ آسیا"
  },
  {
    "poem_id": 1933,
    "vorder": 80,
    "position": 1,
    "text": "نشست از بر خشک لختی گیا"
  },
  {
    "poem_id": 1933,
    "vorder": 81,
    "position": 0,
    "text": "چنین است رسم سرای فریب"
  },
  {
    "poem_id": 1933,
    "vorder": 82,
    "position": 1,
    "text": "فرازش بلند و نشیبش نشیب"
  },
  {
    "poem_id": 1933,
    "vorder": 83,
    "position": 0,
    "text": "بدانگه که بیدار بُد بخت اوی"
  },
  {
    "poem_id": 1933,
    "vorder": 84,
    "position": 1,
    "text": "بگردون کشیدی فلک تخت اوی"
  },
  {
    "poem_id": 1933,
    "vorder": 85,
    "position": 0,
    "text": "کنون آسیابی بیامدش بهر"
  },
  {
    "poem_id": 1933,
    "vorder": 86,
    "position": 1,
    "text": "ز نوشش فراوان فزون بود زهر"
  },
  {
    "poem_id": 1933,
    "vorder": 87,
    "position": 0,
    "text": "چه بندی دل اندر سرای فسوس"
  },
  {
    "poem_id": 1933,
    "vorder": 88,
    "position": 1,
    "text": "که هزمان به گوش آید آواز کوس"
  },
  {
    "poem_id": 1933,
    "vorder": 89,
    "position": 0,
    "text": "خروشی برآید که بربند رخت"
  },
  {
    "poem_id": 1933,
    "vorder": 90,
    "position": 1,
    "text": "نبینی به جز دخمهٔ گور تخت"
  },
  {
    "poem_id": 1933,
    "vorder": 91,
    "position": 0,
    "text": "دهان ناچریده دو دیده پرآب"
  },
  {
    "poem_id": 1933,
    "vorder": 92,
    "position": 1,
    "text": "همی‌بود تا برکشید آفتاب"
  },
  {
    "poem_id": 1933,
    "vorder": 93,
    "position": 0,
    "text": "گشاد آسیابان در آسیا"
  },
  {
    "poem_id": 1933,
    "vorder": 94,
    "position": 1,
    "text": "به پشت اندرون بار و لختی گیا"
  },
  {
    "poem_id": 1933,
    "vorder": 95,
    "position": 0,
    "text": "فرومایه‌ای بود خسرو به نام"
  },
  {
    "poem_id": 1933,
    "vorder": 96,
    "position": 1,
    "text": "نه تخت و نه گنج و نه تاج و نه کام"
  },
  {
    "poem_id": 1933,
    "vorder": 97,
    "position": 0,
    "text": "خور خویش زان آسیا ساختی"
  },
  {
    "poem_id": 1933,
    "vorder": 98,
    "position": 1,
    "text": "به کاری جزین خود نپرداختی"
  },
  {
    "poem_id": 1933,
    "vorder": 99,
    "position": 0,
    "text": "گوی دید بر سانِ سرو بلند"
  },
  {
    "poem_id": 1933,
    "vorder": 100,
    "position": 1,
    "text": "نشسته بران سنگ چون مستمند"
  },
  {
    "poem_id": 1933,
    "vorder": 101,
    "position": 0,
    "text": "یکی افسری خسروی بر سرش"
  },
  {
    "poem_id": 1933,
    "vorder": 102,
    "position": 1,
    "text": "درفشان ز دیبای چینی برش"
  },
  {
    "poem_id": 1933,
    "vorder": 103,
    "position": 0,
    "text": "به پیکر یکی کفش زرین بپای"
  },
  {
    "poem_id": 1933,
    "vorder": 104,
    "position": 1,
    "text": "ز خوشاب و زر آستین قبای"
  },
  {
    "poem_id": 1933,
    "vorder": 105,
    "position": 0,
    "text": "نگه کرد خسرو بدو خیره ماند"
  },
  {
    "poem_id": 1933,
    "vorder": 106,
    "position": 1,
    "text": "بدان خیرگی نام یزدان بخواند"
  },
  {
    "poem_id": 1933,
    "vorder": 107,
    "position": 0,
    "text": "بدو گفت کای شاه خورشید‌روی"
  },
  {
    "poem_id": 1933,
    "vorder": 108,
    "position": 1,
    "text": "برین آسیا چون رسیدی تو گوی"
  },
  {
    "poem_id": 1933,
    "vorder": 109,
    "position": 0,
    "text": "چه جای نشستت بود آسیا"
  },
  {
    "poem_id": 1933,
    "vorder": 110,
    "position": 1,
    "text": "پر از گندم و خاک و چندی گیا"
  },
  {
    "poem_id": 1933,
    "vorder": 111,
    "position": 0,
    "text": "چه مردی بدین فرّ و این برز و چهر"
  },
  {
    "poem_id": 1933,
    "vorder": 112,
    "position": 1,
    "text": "که چون تو نبیند همانا سپهر"
  },
  {
    "poem_id": 1933,
    "vorder": 113,
    "position": 0,
    "text": "از ایرانیانم بدو گفت شاه"
  },
  {
    "poem_id": 1933,
    "vorder": 114,
    "position": 1,
    "text": "هزیمت گرفتم ز توران‌سپاه"
  },
  {
    "poem_id": 1933,
    "vorder": 115,
    "position": 0,
    "text": "بدو آسیابان به تشویر گفت"
  },
  {
    "poem_id": 1933,
    "vorder": 116,
    "position": 1,
    "text": "که جز تنگ‌دستی مرا نیست جفت"
  },
  {
    "poem_id": 1933,
    "vorder": 117,
    "position": 0,
    "text": "اگر نان کشکینت آید به کار"
  },
  {
    "poem_id": 1933,
    "vorder": 118,
    "position": 1,
    "text": "ورین ناسزا ترّهٔ جویبار"
  },
  {
    "poem_id": 1933,
    "vorder": 119,
    "position": 0,
    "text": "بیارم جزین نیز چیزی که هست"
  },
  {
    "poem_id": 1933,
    "vorder": 120,
    "position": 1,
    "text": "خروشان بود مردم تنگ‌دست"
  },
  {
    "poem_id": 1933,
    "vorder": 121,
    "position": 0,
    "text": "به سه روز شاه جهان را ز رزم"
  },
  {
    "poem_id": 1933,
    "vorder": 122,
    "position": 1,
    "text": "نبود ایچ پردازش خوان و بزم"
  },
  {
    "poem_id": 1933,
    "vorder": 123,
    "position": 0,
    "text": "بدو گفت شاه آنچ داری بیار"
  },
  {
    "poem_id": 1933,
    "vorder": 124,
    "position": 1,
    "text": "خورش نیز با برسم آید به کار"
  },
  {
    "poem_id": 1933,
    "vorder": 125,
    "position": 0,
    "text": "سبک مرد بی‌مایه چُبّین نهاد"
  },
  {
    "poem_id": 1933,
    "vorder": 126,
    "position": 1,
    "text": "برو ترّه و نان کشکین نهاد"
  },
  {
    "poem_id": 1933,
    "vorder": 127,
    "position": 0,
    "text": "ببرسم شتابید و آمد به راه"
  },
  {
    "poem_id": 1933,
    "vorder": 128,
    "position": 1,
    "text": "به جایی که بود اندران واژگاه"
  },
  {
    "poem_id": 1933,
    "vorder": 129,
    "position": 0,
    "text": "برِ مهتر زرق شد بی‌گذار"
  },
  {
    "poem_id": 1933,
    "vorder": 130,
    "position": 1,
    "text": "که برسم کند زو یکی خواستار"
  },
  {
    "poem_id": 1933,
    "vorder": 131,
    "position": 0,
    "text": "بهر سو فرستاد ماهوی کس"
  },
  {
    "poem_id": 1933,
    "vorder": 132,
    "position": 1,
    "text": "ز گیتی همی شاه را جست و بس"
  },
  {
    "poem_id": 1933,
    "vorder": 133,
    "position": 0,
    "text": "از آن آسیابان بپرسید مه"
  },
  {
    "poem_id": 1933,
    "vorder": 134,
    "position": 1,
    "text": "که برسم کرا خواهی ای روزبه"
  },
  {
    "poem_id": 1933,
    "vorder": 135,
    "position": 0,
    "text": "بدو گفت خسرو که در آسیا"
  },
  {
    "poem_id": 1933,
    "vorder": 136,
    "position": 1,
    "text": "نشستست کنداوری بر گیا"
  },
  {
    "poem_id": 1933,
    "vorder": 137,
    "position": 0,
    "text": "به بالا به کردار سرو سهی"
  },
  {
    "poem_id": 1933,
    "vorder": 138,
    "position": 1,
    "text": "بدیدار خورشید با فرهی"
  },
  {
    "poem_id": 1933,
    "vorder": 139,
    "position": 0,
    "text": "دو ابرو کمان و دو نرگس دژم"
  },
  {
    "poem_id": 1933,
    "vorder": 140,
    "position": 1,
    "text": "دهن پر ز باد ابروان پر زخم"
  },
  {
    "poem_id": 1933,
    "vorder": 141,
    "position": 0,
    "text": "ببرسم همی واژ خواهد گرفت"
  },
  {
    "poem_id": 1933,
    "vorder": 142,
    "position": 1,
    "text": "سزد گر بمانی ازو در شگفت"
  },
  {
    "poem_id": 1933,
    "vorder": 143,
    "position": 0,
    "text": "یکی کهنه چُبّین نهادم به پیش"
  },
  {
    "poem_id": 1933,
    "vorder": 144,
    "position": 1,
    "text": "برو نان کشکین سزاوار خویش"
  },
  {
    "poem_id": 1933,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت مهتر کز ایدر بپوی"
  },
  {
    "poem_id": 1933,
    "vorder": 146,
    "position": 1,
    "text": "چنین هم به ماهوی سوری بگوی"
  },
  {
    "poem_id": 1933,
    "vorder": 147,
    "position": 0,
    "text": "نباید که آن بدنژاد پلید"
  },
  {
    "poem_id": 1933,
    "vorder": 148,
    "position": 1,
    "text": "چو این بشنود گوهر آرد پدید"
  },
  {
    "poem_id": 1933,
    "vorder": 149,
    "position": 0,
    "text": "سبک مهتر او را بمردی سپرد"
  },
  {
    "poem_id": 1933,
    "vorder": 150,
    "position": 1,
    "text": "جهان‌دیده را پیش ماهوی برد"
  },
  {
    "poem_id": 1933,
    "vorder": 151,
    "position": 0,
    "text": "بپرسید ماهوی زین چاره‌جوی"
  },
  {
    "poem_id": 1933,
    "vorder": 152,
    "position": 1,
    "text": "که برسم کرا خواستی راست گوی"
  },
  {
    "poem_id": 1933,
    "vorder": 153,
    "position": 0,
    "text": "چنین داد پاسخ ورا ترسکار"
  },
  {
    "poem_id": 1933,
    "vorder": 154,
    "position": 1,
    "text": "که من بار کردم همی خواستار"
  },
  {
    "poem_id": 1933,
    "vorder": 155,
    "position": 0,
    "text": "در آسیا را گشادم به خشم"
  },
  {
    "poem_id": 1933,
    "vorder": 156,
    "position": 1,
    "text": "چنان دان که خورشید دیدم به چشم"
  },
  {
    "poem_id": 1933,
    "vorder": 157,
    "position": 0,
    "text": "دو نرگس چو نر آهو اندر هراس"
  },
  {
    "poem_id": 1933,
    "vorder": 158,
    "position": 1,
    "text": "دو دیده چو از شب گذشته سه پاس"
  },
  {
    "poem_id": 1933,
    "vorder": 159,
    "position": 0,
    "text": "چو خورشید گشتست زو آسیا"
  },
  {
    "poem_id": 1933,
    "vorder": 160,
    "position": 1,
    "text": "خورش نان خشک و نشستش گیا"
  },
  {
    "poem_id": 1933,
    "vorder": 161,
    "position": 0,
    "text": "هر آنکس که او فر یزدان ندید"
  },
  {
    "poem_id": 1933,
    "vorder": 162,
    "position": 1,
    "text": "ازین آسیابان بباید شنید"
  },
  {
    "poem_id": 1933,
    "vorder": 163,
    "position": 0,
    "text": "پر از گوهر نابسود افسرش"
  },
  {
    "poem_id": 1933,
    "vorder": 164,
    "position": 1,
    "text": "ز دیبای چینی فروزان برش"
  },
  {
    "poem_id": 1933,
    "vorder": 165,
    "position": 0,
    "text": "بهاریست گویی در اردیبهشت"
  },
  {
    "poem_id": 1933,
    "vorder": 166,
    "position": 1,
    "text": "به بالای او سرو دهقان نکِشت"
  }
]