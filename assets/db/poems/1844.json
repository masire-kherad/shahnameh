[
  {
    "poem_id": 1844,
    "vorder": 1,
    "position": 0,
    "text": "ز لشکر گزین کرد بهرام شیر"
  },
  {
    "poem_id": 1844,
    "vorder": 2,
    "position": 1,
    "text": "سپاهی جهانگیر وگرد دلیر"
  },
  {
    "poem_id": 1844,
    "vorder": 3,
    "position": 0,
    "text": "چوکردند و با او دبیران شمار"
  },
  {
    "poem_id": 1844,
    "vorder": 4,
    "position": 1,
    "text": "سپه بود شمشیر زن صد هزار"
  },
  {
    "poem_id": 1844,
    "vorder": 5,
    "position": 0,
    "text": "ز خاقانیان آن سه ترک سترگ"
  },
  {
    "poem_id": 1844,
    "vorder": 6,
    "position": 1,
    "text": "که بودند غرنده برسان گرگ"
  },
  {
    "poem_id": 1844,
    "vorder": 7,
    "position": 0,
    "text": "به جنگ‌آوران گفت چون زخم کوس"
  },
  {
    "poem_id": 1844,
    "vorder": 8,
    "position": 1,
    "text": "برآید بهنگام بانگ خروس"
  },
  {
    "poem_id": 1844,
    "vorder": 9,
    "position": 0,
    "text": "شما بر خروشید و اندر دهید"
  },
  {
    "poem_id": 1844,
    "vorder": 10,
    "position": 1,
    "text": "سران را ز خون بر سرافسر نهید"
  },
  {
    "poem_id": 1844,
    "vorder": 11,
    "position": 0,
    "text": "بشد تیز لشکر بفرمان گو"
  },
  {
    "poem_id": 1844,
    "vorder": 12,
    "position": 1,
    "text": "سه ترک سر افرازشان پیش رو"
  },
  {
    "poem_id": 1844,
    "vorder": 13,
    "position": 0,
    "text": "برلشکر شهریار آمدند"
  },
  {
    "poem_id": 1844,
    "vorder": 14,
    "position": 1,
    "text": "جفاپیشه و کینه دار آمدند"
  },
  {
    "poem_id": 1844,
    "vorder": 15,
    "position": 0,
    "text": "خروش آمد از گرز و گوپال و تیغ"
  },
  {
    "poem_id": 1844,
    "vorder": 16,
    "position": 1,
    "text": "از آهن زمین بود وز گرد میغ"
  },
  {
    "poem_id": 1844,
    "vorder": 17,
    "position": 0,
    "text": "همی‌گفت هرکس که خسرو کجاست"
  },
  {
    "poem_id": 1844,
    "vorder": 18,
    "position": 1,
    "text": "که امروز پیروزی روز ماست"
  },
  {
    "poem_id": 1844,
    "vorder": 19,
    "position": 0,
    "text": "ببالا همی‌بود خسرو بدرد"
  },
  {
    "poem_id": 1844,
    "vorder": 20,
    "position": 1,
    "text": "دودیده پر از خون و رخ لاژورد"
  },
  {
    "poem_id": 1844,
    "vorder": 21,
    "position": 0,
    "text": "چنین تا سپیده برآمد ز کوه"
  },
  {
    "poem_id": 1844,
    "vorder": 22,
    "position": 1,
    "text": "شد از زخم شمشیر و کشته ستوه"
  },
  {
    "poem_id": 1844,
    "vorder": 23,
    "position": 0,
    "text": "چوشد دامن تیره شب تا پدید"
  },
  {
    "poem_id": 1844,
    "vorder": 24,
    "position": 1,
    "text": "همه رزمگه کشته و خسته دید"
  },
  {
    "poem_id": 1844,
    "vorder": 25,
    "position": 0,
    "text": "بگردنکشان گفت یاری کنید"
  },
  {
    "poem_id": 1844,
    "vorder": 26,
    "position": 1,
    "text": "برین دشمنان کامگاری کنید"
  },
  {
    "poem_id": 1844,
    "vorder": 27,
    "position": 0,
    "text": "که پیروزگر پشت و یارمنست"
  },
  {
    "poem_id": 1844,
    "vorder": 28,
    "position": 1,
    "text": "همان زخم شمشیر کارمنست"
  },
  {
    "poem_id": 1844,
    "vorder": 29,
    "position": 0,
    "text": "بیامد دمان تا بر آن سه ترک"
  },
  {
    "poem_id": 1844,
    "vorder": 30,
    "position": 1,
    "text": "نه ترک دلاور سه پیل سترگ"
  },
  {
    "poem_id": 1844,
    "vorder": 31,
    "position": 0,
    "text": "یکی تاخت تا نزد خسرو رسید"
  },
  {
    "poem_id": 1844,
    "vorder": 32,
    "position": 1,
    "text": "پرنداوری از میان برکشید"
  },
  {
    "poem_id": 1844,
    "vorder": 33,
    "position": 0,
    "text": "همی‌خواست زد بر سر شهریار"
  },
  {
    "poem_id": 1844,
    "vorder": 34,
    "position": 1,
    "text": "سپر بر سرآورد شاه سوار"
  },
  {
    "poem_id": 1844,
    "vorder": 35,
    "position": 0,
    "text": "بزیر سپر تیغ زهر آبگون"
  },
  {
    "poem_id": 1844,
    "vorder": 36,
    "position": 1,
    "text": "بزد تیغ و انداختش سرنگون"
  },
  {
    "poem_id": 1844,
    "vorder": 37,
    "position": 0,
    "text": "خروشید کای نامداران جنگ"
  },
  {
    "poem_id": 1844,
    "vorder": 38,
    "position": 1,
    "text": "زمانی دگر کرد باید درنگ"
  },
  {
    "poem_id": 1844,
    "vorder": 39,
    "position": 0,
    "text": "سپاهش همه پشت برگاشتند"
  },
  {
    "poem_id": 1844,
    "vorder": 40,
    "position": 1,
    "text": "جهانجوی را خوار بگذاشتند"
  },
  {
    "poem_id": 1844,
    "vorder": 41,
    "position": 0,
    "text": "به بندوی و گستهم گفت آن زمان"
  },
  {
    "poem_id": 1844,
    "vorder": 42,
    "position": 1,
    "text": "که اکنون شدم زین سخن بدگمان"
  },
  {
    "poem_id": 1844,
    "vorder": 43,
    "position": 0,
    "text": "رسیده مرا هیچ فرزند نیست"
  },
  {
    "poem_id": 1844,
    "vorder": 44,
    "position": 1,
    "text": "همان از در تاج پیوند نیست"
  },
  {
    "poem_id": 1844,
    "vorder": 45,
    "position": 0,
    "text": "اگر من شوم کشته در کارزار"
  },
  {
    "poem_id": 1844,
    "vorder": 46,
    "position": 1,
    "text": "جهان را نماند یکی شهریار"
  },
  {
    "poem_id": 1844,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت بندوی کای سرفراز"
  },
  {
    "poem_id": 1844,
    "vorder": 48,
    "position": 1,
    "text": "بدین روز هرگز مبادت نیاز"
  },
  {
    "poem_id": 1844,
    "vorder": 49,
    "position": 0,
    "text": "سپه رفت اکنون تو ایدر مه ایست"
  },
  {
    "poem_id": 1844,
    "vorder": 50,
    "position": 1,
    "text": "که کس در زمانه تو را یار نیست"
  },
  {
    "poem_id": 1844,
    "vorder": 51,
    "position": 0,
    "text": "بزنگوی گفت آن زمان شهریار"
  },
  {
    "poem_id": 1844,
    "vorder": 52,
    "position": 1,
    "text": "کز ایدر برو تازیان تاتخوار"
  },
  {
    "poem_id": 1844,
    "vorder": 53,
    "position": 0,
    "text": "ازین ماندگان بر سواری هزار"
  },
  {
    "poem_id": 1844,
    "vorder": 54,
    "position": 1,
    "text": "بران رزمگاه آنچ یابی بیار"
  },
  {
    "poem_id": 1844,
    "vorder": 55,
    "position": 0,
    "text": "سراپرده دیبه وگنج وتاج"
  },
  {
    "poem_id": 1844,
    "vorder": 56,
    "position": 1,
    "text": "همان بدره وبرده وتخت عاج"
  },
  {
    "poem_id": 1844,
    "vorder": 57,
    "position": 0,
    "text": "بزرگان بنه برنهادند وگنج"
  },
  {
    "poem_id": 1844,
    "vorder": 58,
    "position": 1,
    "text": "فراوان ببردن کشیدند رنج"
  },
  {
    "poem_id": 1844,
    "vorder": 59,
    "position": 0,
    "text": "هم آنگه یکی اژدهافش درفش"
  },
  {
    "poem_id": 1844,
    "vorder": 60,
    "position": 1,
    "text": "پدید آمد و گشت گیتی بنفش"
  },
  {
    "poem_id": 1844,
    "vorder": 61,
    "position": 0,
    "text": "پس اندر همی‌راند بهرام گرد"
  },
  {
    "poem_id": 1844,
    "vorder": 62,
    "position": 1,
    "text": "به جنگ از جهان روشنایی ببرد"
  },
  {
    "poem_id": 1844,
    "vorder": 63,
    "position": 0,
    "text": "رسیدند بهرام و خسرو بهم"
  },
  {
    "poem_id": 1844,
    "vorder": 64,
    "position": 1,
    "text": "دلاور دو جنگی دو شیر دژم"
  },
  {
    "poem_id": 1844,
    "vorder": 65,
    "position": 0,
    "text": "چوپیلان جنگی بر آشوفتند"
  },
  {
    "poem_id": 1844,
    "vorder": 66,
    "position": 1,
    "text": "همی برسریکدگر کوفتند"
  },
  {
    "poem_id": 1844,
    "vorder": 67,
    "position": 0,
    "text": "همی‌گشت بهرام چون شیر نر"
  },
  {
    "poem_id": 1844,
    "vorder": 68,
    "position": 1,
    "text": "سلیحش نیامد برو کارگر"
  },
  {
    "poem_id": 1844,
    "vorder": 69,
    "position": 0,
    "text": "برین گونه تا خور ز گنبد بگشت"
  },
  {
    "poem_id": 1844,
    "vorder": 70,
    "position": 1,
    "text": "از اندازه آویزش اندر گذشت"
  },
  {
    "poem_id": 1844,
    "vorder": 71,
    "position": 0,
    "text": "تخوار آن زمان پیش خسرو رسید"
  },
  {
    "poem_id": 1844,
    "vorder": 72,
    "position": 1,
    "text": "که گنج وبنه زان سوی پل کشید"
  },
  {
    "poem_id": 1844,
    "vorder": 73,
    "position": 0,
    "text": "چوبشنید خسرو بگستهم گفت"
  },
  {
    "poem_id": 1844,
    "vorder": 74,
    "position": 1,
    "text": "که با ما کسی نیست در جنگ جفت"
  },
  {
    "poem_id": 1844,
    "vorder": 75,
    "position": 0,
    "text": "که ما ده تنیم این سپاهی بزرگ"
  },
  {
    "poem_id": 1844,
    "vorder": 76,
    "position": 1,
    "text": "به پیش اندرون پهلوانی سترگ"
  },
  {
    "poem_id": 1844,
    "vorder": 77,
    "position": 0,
    "text": "هزیمت بهنگام بهتر زجنگ"
  },
  {
    "poem_id": 1844,
    "vorder": 78,
    "position": 1,
    "text": "چو تنها شدی نیست جای درنگ"
  },
  {
    "poem_id": 1844,
    "vorder": 79,
    "position": 0,
    "text": "همی‌راند ناکار دیده جوان"
  },
  {
    "poem_id": 1844,
    "vorder": 80,
    "position": 1,
    "text": "برین گونه بر تا پل نهروان"
  },
  {
    "poem_id": 1844,
    "vorder": 81,
    "position": 0,
    "text": "پس اندر همی‌تاخت بهرام تیز"
  },
  {
    "poem_id": 1844,
    "vorder": 82,
    "position": 1,
    "text": "سری پر ز کینه دلی پر ستیز"
  },
  {
    "poem_id": 1844,
    "vorder": 83,
    "position": 0,
    "text": "چو خسرو چنان دید بر پل بماند"
  },
  {
    "poem_id": 1844,
    "vorder": 84,
    "position": 1,
    "text": "جهاندیده گستهم را پیش خواند"
  },
  {
    "poem_id": 1844,
    "vorder": 85,
    "position": 0,
    "text": "بیارید گفتا کمان مرا"
  },
  {
    "poem_id": 1844,
    "vorder": 86,
    "position": 1,
    "text": "به جنگ اندرون ترجمان مرا"
  },
  {
    "poem_id": 1844,
    "vorder": 87,
    "position": 0,
    "text": "کمانش ببرد آنک گنجور بود"
  },
  {
    "poem_id": 1844,
    "vorder": 88,
    "position": 1,
    "text": "بران کار گستهم دستور بود"
  },
  {
    "poem_id": 1844,
    "vorder": 89,
    "position": 0,
    "text": "کمان بر گرفت آن سپهدار گرد"
  },
  {
    "poem_id": 1844,
    "vorder": 90,
    "position": 1,
    "text": "بتیر از هوا روشنایی ببرد"
  },
  {
    "poem_id": 1844,
    "vorder": 91,
    "position": 0,
    "text": "همی تیر بارید همچون تگرگ"
  },
  {
    "poem_id": 1844,
    "vorder": 92,
    "position": 1,
    "text": "بیک چوبه با سر همی‌دوخت ترگ"
  },
  {
    "poem_id": 1844,
    "vorder": 93,
    "position": 0,
    "text": "پس اندر همی‌تاخت بهرام شیر"
  },
  {
    "poem_id": 1844,
    "vorder": 94,
    "position": 1,
    "text": "کمندی بدست اژدهایی بزیر"
  },
  {
    "poem_id": 1844,
    "vorder": 95,
    "position": 0,
    "text": "چوخسرو و را دید برگشت شاد"
  },
  {
    "poem_id": 1844,
    "vorder": 96,
    "position": 1,
    "text": "دو زاغ کمان را بزه برنهاد"
  },
  {
    "poem_id": 1844,
    "vorder": 97,
    "position": 0,
    "text": "یکی تیر زد بر بربارگی"
  },
  {
    "poem_id": 1844,
    "vorder": 98,
    "position": 1,
    "text": "بشد کار آن باره یکبارگی"
  },
  {
    "poem_id": 1844,
    "vorder": 99,
    "position": 0,
    "text": "پیاده سپهبد سپر برگرفت"
  },
  {
    "poem_id": 1844,
    "vorder": 100,
    "position": 1,
    "text": "ز بیچارگی دست بر سرگرفت"
  },
  {
    "poem_id": 1844,
    "vorder": 101,
    "position": 0,
    "text": "یلان سینه پیش اندر آمد چوگرد"
  },
  {
    "poem_id": 1844,
    "vorder": 102,
    "position": 1,
    "text": "جهانجوی کی داشت او را بمرد"
  },
  {
    "poem_id": 1844,
    "vorder": 103,
    "position": 0,
    "text": "هم اندر زمان اسپ او رابخست"
  },
  {
    "poem_id": 1844,
    "vorder": 104,
    "position": 1,
    "text": "پیاده یلان سینه را پل بجست"
  },
  {
    "poem_id": 1844,
    "vorder": 105,
    "position": 0,
    "text": "سپه بازگشت از پل نهروان"
  },
  {
    "poem_id": 1844,
    "vorder": 106,
    "position": 1,
    "text": "هرآنکس که بودند پیر و جوان"
  },
  {
    "poem_id": 1844,
    "vorder": 107,
    "position": 0,
    "text": "چو بهرام برگشت خسرو چوگرد"
  },
  {
    "poem_id": 1844,
    "vorder": 108,
    "position": 1,
    "text": "پل نهروان سر به سر باز کرد"
  },
  {
    "poem_id": 1844,
    "vorder": 109,
    "position": 0,
    "text": "همی‌راند غمگین سوی طیسفون"
  },
  {
    "poem_id": 1844,
    "vorder": 110,
    "position": 1,
    "text": "دلی پر زغم دیدگان پر زخون"
  },
  {
    "poem_id": 1844,
    "vorder": 111,
    "position": 0,
    "text": "در شارستانها به آهن ببست"
  },
  {
    "poem_id": 1844,
    "vorder": 112,
    "position": 1,
    "text": "بانبوه اندیشگان درنشست"
  },
  {
    "poem_id": 1844,
    "vorder": 113,
    "position": 0,
    "text": "زهر برزنی مهتران را بخواند"
  },
  {
    "poem_id": 1844,
    "vorder": 114,
    "position": 1,
    "text": "به دروازه بر پاسبانان نشاند"
  }
]