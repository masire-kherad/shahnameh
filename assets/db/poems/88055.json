[
  {
    "poem_id": 88055,
    "vorder": 1,
    "position": 0,
    "text": "چو لشکر چنین پاسخ آراستند"
  },
  {
    "poem_id": 88055,
    "vorder": 2,
    "position": 1,
    "text": "دو پرمایه از جای برخاستند"
  },
  {
    "poem_id": 88055,
    "vorder": 3,
    "position": 0,
    "text": "بدانست لهاک و فرشیدورد"
  },
  {
    "poem_id": 88055,
    "vorder": 4,
    "position": 1,
    "text": "کشان نیست هنگام ننگ و نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 5,
    "position": 0,
    "text": "همی راست گویند لشکر همه"
  },
  {
    "poem_id": 88055,
    "vorder": 6,
    "position": 1,
    "text": "تبه گردد از بی‌شبانی رمه"
  },
  {
    "poem_id": 88055,
    "vorder": 7,
    "position": 0,
    "text": "به پدرود کردند گرفتند ساز"
  },
  {
    "poem_id": 88055,
    "vorder": 8,
    "position": 1,
    "text": "بیابان گرفتند و راه دراز"
  },
  {
    "poem_id": 88055,
    "vorder": 9,
    "position": 0,
    "text": "درفشی گرفته به دست اندرون"
  },
  {
    "poem_id": 88055,
    "vorder": 10,
    "position": 1,
    "text": "پر از درد دل دیدگان پر ز خون"
  },
  {
    "poem_id": 88055,
    "vorder": 11,
    "position": 0,
    "text": "برفتند با نامور ده سوار"
  },
  {
    "poem_id": 88055,
    "vorder": 12,
    "position": 1,
    "text": "دلیران و شایستهٔ کارزار"
  },
  {
    "poem_id": 88055,
    "vorder": 13,
    "position": 0,
    "text": "به ره بر ز ایران سواران بدند"
  },
  {
    "poem_id": 88055,
    "vorder": 14,
    "position": 1,
    "text": "نگهبان آن نامداران بدند"
  },
  {
    "poem_id": 88055,
    "vorder": 15,
    "position": 0,
    "text": "برانگیختند اسب ترکان ز جای"
  },
  {
    "poem_id": 88055,
    "vorder": 16,
    "position": 1,
    "text": "طلایه بیفشارد با جای پای"
  },
  {
    "poem_id": 88055,
    "vorder": 17,
    "position": 0,
    "text": "یکی ناسگالیده‌شان جنگ خاست"
  },
  {
    "poem_id": 88055,
    "vorder": 18,
    "position": 1,
    "text": "که از خون زمین گشت با کوه راست"
  },
  {
    "poem_id": 88055,
    "vorder": 19,
    "position": 0,
    "text": "بکشتند ایرانیان هشت مرد"
  },
  {
    "poem_id": 88055,
    "vorder": 20,
    "position": 1,
    "text": "دلیران و شیران روز نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 21,
    "position": 0,
    "text": "وز آنجا برفتند هر دو دلیر"
  },
  {
    "poem_id": 88055,
    "vorder": 22,
    "position": 1,
    "text": "به راه بیابان به کردار شیر"
  },
  {
    "poem_id": 88055,
    "vorder": 23,
    "position": 0,
    "text": "ز ترکان جز این دو سرافراز گرد"
  },
  {
    "poem_id": 88055,
    "vorder": 24,
    "position": 1,
    "text": "ز دست طلایه دگر جان نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 25,
    "position": 0,
    "text": "پس از دیده گه دیده‌بان کرد غو"
  },
  {
    "poem_id": 88055,
    "vorder": 26,
    "position": 1,
    "text": "که ای سرفرازان و گردان نو"
  },
  {
    "poem_id": 88055,
    "vorder": 27,
    "position": 0,
    "text": "از این لشکر ترک دو نامدار"
  },
  {
    "poem_id": 88055,
    "vorder": 28,
    "position": 1,
    "text": "برون رفت با نامور ده سوار"
  },
  {
    "poem_id": 88055,
    "vorder": 29,
    "position": 0,
    "text": "چنان با طلایه برآویختند"
  },
  {
    "poem_id": 88055,
    "vorder": 30,
    "position": 1,
    "text": "که با خاک خون را برآمیختند"
  },
  {
    "poem_id": 88055,
    "vorder": 31,
    "position": 0,
    "text": "تنی هشت کشتند ایرانیان"
  },
  {
    "poem_id": 88055,
    "vorder": 32,
    "position": 1,
    "text": "دو تن تیز رفتند بسته میان"
  },
  {
    "poem_id": 88055,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید گودرز گفت آن دو مرد"
  },
  {
    "poem_id": 88055,
    "vorder": 34,
    "position": 1,
    "text": "بود گرد لهاک و فرشیدورد"
  },
  {
    "poem_id": 88055,
    "vorder": 35,
    "position": 0,
    "text": "برفتند با گردن افراختن"
  },
  {
    "poem_id": 88055,
    "vorder": 36,
    "position": 1,
    "text": "شکسته نشدشان دل از تاختن"
  },
  {
    "poem_id": 88055,
    "vorder": 37,
    "position": 0,
    "text": "گر ایشان از اینجا به توران شوند"
  },
  {
    "poem_id": 88055,
    "vorder": 38,
    "position": 1,
    "text": "بر این لشکر آید همانا گزند"
  },
  {
    "poem_id": 88055,
    "vorder": 39,
    "position": 0,
    "text": "هم اندر زمان گفت با سرکشان"
  },
  {
    "poem_id": 88055,
    "vorder": 40,
    "position": 1,
    "text": "که ای نامداران دشمن‌کشان"
  },
  {
    "poem_id": 88055,
    "vorder": 41,
    "position": 0,
    "text": "که جوید کنون نام نزدیک شاه"
  },
  {
    "poem_id": 88055,
    "vorder": 42,
    "position": 1,
    "text": "بپوشد سرش را به رومی کلاه"
  },
  {
    "poem_id": 88055,
    "vorder": 43,
    "position": 0,
    "text": "همه مانده بودند ایرانیان"
  },
  {
    "poem_id": 88055,
    "vorder": 44,
    "position": 1,
    "text": "شده سست و سوده ز آهن میان"
  },
  {
    "poem_id": 88055,
    "vorder": 45,
    "position": 0,
    "text": "ندادند پاسخ جز از گستهم"
  },
  {
    "poem_id": 88055,
    "vorder": 46,
    "position": 1,
    "text": "که بود اندر آورد شیر دژم"
  },
  {
    "poem_id": 88055,
    "vorder": 47,
    "position": 0,
    "text": "به سالار گفت ای سرافراز شاه"
  },
  {
    "poem_id": 88055,
    "vorder": 48,
    "position": 1,
    "text": "چو رفتی به آورد توران سپاه"
  },
  {
    "poem_id": 88055,
    "vorder": 49,
    "position": 0,
    "text": "سپردی مرا کوس و پرده‌سرای"
  },
  {
    "poem_id": 88055,
    "vorder": 50,
    "position": 1,
    "text": "به پیش سپه بر ببودن به پای"
  },
  {
    "poem_id": 88055,
    "vorder": 51,
    "position": 0,
    "text": "دلیران همه نام جستند و ننگ"
  },
  {
    "poem_id": 88055,
    "vorder": 52,
    "position": 1,
    "text": "مرا بهره نآمد به هنگام جنگ"
  },
  {
    "poem_id": 88055,
    "vorder": 53,
    "position": 0,
    "text": "کنون من بدین کار نام آورم"
  },
  {
    "poem_id": 88055,
    "vorder": 54,
    "position": 1,
    "text": "شومشان یکایک به دام آورم"
  },
  {
    "poem_id": 88055,
    "vorder": 55,
    "position": 0,
    "text": "بخندید گودرز و زو شاد شد"
  },
  {
    "poem_id": 88055,
    "vorder": 56,
    "position": 1,
    "text": "رخش تازه شد وز غم آزاد شد"
  },
  {
    "poem_id": 88055,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت نیک‌اختری تو ز هور"
  },
  {
    "poem_id": 88055,
    "vorder": 58,
    "position": 1,
    "text": "که شیری و بدخواه تو همچو گور"
  },
  {
    "poem_id": 88055,
    "vorder": 59,
    "position": 0,
    "text": "برو کآفریننده یار تو باد"
  },
  {
    "poem_id": 88055,
    "vorder": 60,
    "position": 1,
    "text": "چو لهاک سیصد شکار تو باد"
  },
  {
    "poem_id": 88055,
    "vorder": 61,
    "position": 0,
    "text": "بپوشید گستهم درع نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 62,
    "position": 1,
    "text": "ز گردان که را دید پدرود کرد"
  },
  {
    "poem_id": 88055,
    "vorder": 63,
    "position": 0,
    "text": "برون رفت وز لشکر خویش تفت"
  },
  {
    "poem_id": 88055,
    "vorder": 64,
    "position": 1,
    "text": "به جنگ دو ترک سرافراز رفت"
  },
  {
    "poem_id": 88055,
    "vorder": 65,
    "position": 0,
    "text": "همی گفت لشکر همه سر به سر"
  },
  {
    "poem_id": 88055,
    "vorder": 66,
    "position": 1,
    "text": "که گستهم را ز این بد آید به سر"
  },
  {
    "poem_id": 88055,
    "vorder": 67,
    "position": 0,
    "text": "یکی لشکر از نزد افراسیاب"
  },
  {
    "poem_id": 88055,
    "vorder": 68,
    "position": 1,
    "text": "همی رفت بر سان کشتی بر آب"
  },
  {
    "poem_id": 88055,
    "vorder": 69,
    "position": 0,
    "text": "به یاری همه جنگجو آمدند"
  },
  {
    "poem_id": 88055,
    "vorder": 70,
    "position": 1,
    "text": "چو نزدیک دشت دغو آمدند"
  },
  {
    "poem_id": 88055,
    "vorder": 71,
    "position": 0,
    "text": "خبر شد بدیشان که پیران گذشت"
  },
  {
    "poem_id": 88055,
    "vorder": 72,
    "position": 1,
    "text": "نبرد دلیران دگرگونه گشت"
  },
  {
    "poem_id": 88055,
    "vorder": 73,
    "position": 0,
    "text": "همه بازگشتند یکسر ز راه"
  },
  {
    "poem_id": 88055,
    "vorder": 74,
    "position": 1,
    "text": "خروشان برفتند نزدیک شاه"
  },
  {
    "poem_id": 88055,
    "vorder": 75,
    "position": 0,
    "text": "چو بشنید بیژن که گستهم رفت"
  },
  {
    "poem_id": 88055,
    "vorder": 76,
    "position": 1,
    "text": "ز لشکر به آورد لهاک تفت"
  },
  {
    "poem_id": 88055,
    "vorder": 77,
    "position": 0,
    "text": "گمانی چنان برد بیژن که او"
  },
  {
    "poem_id": 88055,
    "vorder": 78,
    "position": 1,
    "text": "چو تنگ اندر آید به دشت دغو"
  },
  {
    "poem_id": 88055,
    "vorder": 79,
    "position": 0,
    "text": "نباید که لهاک و فرشیدورد"
  },
  {
    "poem_id": 88055,
    "vorder": 80,
    "position": 1,
    "text": "برآرند از او خاک روز نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 81,
    "position": 0,
    "text": "نشست از بر دیزهٔ راه‌جوی"
  },
  {
    "poem_id": 88055,
    "vorder": 82,
    "position": 1,
    "text": "به نزدیک گودرز بنهاد روی"
  },
  {
    "poem_id": 88055,
    "vorder": 83,
    "position": 0,
    "text": "چو چشمش به روی نیا برفتاد"
  },
  {
    "poem_id": 88055,
    "vorder": 84,
    "position": 1,
    "text": "خروشید و چندی سخن کرد یاد"
  },
  {
    "poem_id": 88055,
    "vorder": 85,
    "position": 0,
    "text": "نه خوب آید ای پهلوان از خرد"
  },
  {
    "poem_id": 88055,
    "vorder": 86,
    "position": 1,
    "text": "که هر نامداری که فرمان برد"
  },
  {
    "poem_id": 88055,
    "vorder": 87,
    "position": 0,
    "text": "مر او را به خیره بکشتن دهی"
  },
  {
    "poem_id": 88055,
    "vorder": 88,
    "position": 1,
    "text": "بهانه به چرخ فلک برنهی"
  },
  {
    "poem_id": 88055,
    "vorder": 89,
    "position": 0,
    "text": "دو تن نامداران توران سپاه"
  },
  {
    "poem_id": 88055,
    "vorder": 90,
    "position": 1,
    "text": "برفتند ز این سان دلاور به راه"
  },
  {
    "poem_id": 88055,
    "vorder": 91,
    "position": 0,
    "text": "ز هومان و پیران دلاورترند"
  },
  {
    "poem_id": 88055,
    "vorder": 92,
    "position": 1,
    "text": "به گوهر بزرگان آن کشورند"
  },
  {
    "poem_id": 88055,
    "vorder": 93,
    "position": 0,
    "text": "کنون گستهم شد به جنگ دو تن"
  },
  {
    "poem_id": 88055,
    "vorder": 94,
    "position": 1,
    "text": "نباید که آید بر او بر شکن"
  },
  {
    "poem_id": 88055,
    "vorder": 95,
    "position": 0,
    "text": "همه کام ما بازگردد به درد"
  },
  {
    "poem_id": 88055,
    "vorder": 96,
    "position": 1,
    "text": "چو کم گردد از لشکر آن رادمرد"
  },
  {
    "poem_id": 88055,
    "vorder": 97,
    "position": 0,
    "text": "چو بشنید گودرز گفتار اوی"
  },
  {
    "poem_id": 88055,
    "vorder": 98,
    "position": 1,
    "text": "کشیدن بدان کار تیمار اوی"
  },
  {
    "poem_id": 88055,
    "vorder": 99,
    "position": 0,
    "text": "پس اندیشه کرد اندر آن یک زمان"
  },
  {
    "poem_id": 88055,
    "vorder": 100,
    "position": 1,
    "text": "هم از بد که می‌برد بیژن گمان"
  },
  {
    "poem_id": 88055,
    "vorder": 101,
    "position": 0,
    "text": "به گردان چنین گفت سالار شاه"
  },
  {
    "poem_id": 88055,
    "vorder": 102,
    "position": 1,
    "text": "که هر کس که جوید همی نام و گاه"
  },
  {
    "poem_id": 88055,
    "vorder": 103,
    "position": 0,
    "text": "پس گستهم رفت باید دمان"
  },
  {
    "poem_id": 88055,
    "vorder": 104,
    "position": 1,
    "text": "مر او را بدن یار با بدگمان"
  },
  {
    "poem_id": 88055,
    "vorder": 105,
    "position": 0,
    "text": "ندادند پاسخ کس از انجمن"
  },
  {
    "poem_id": 88055,
    "vorder": 106,
    "position": 1,
    "text": "نه غمخواره بد کس نه آسوده‌تن"
  },
  {
    "poem_id": 88055,
    "vorder": 107,
    "position": 0,
    "text": "به گودرز پس گفت بیژن که کس"
  },
  {
    "poem_id": 88055,
    "vorder": 108,
    "position": 1,
    "text": "جز از من نباشدش فریادرس"
  },
  {
    "poem_id": 88055,
    "vorder": 109,
    "position": 0,
    "text": "که آید ز گردان بدین کار پیش"
  },
  {
    "poem_id": 88055,
    "vorder": 110,
    "position": 1,
    "text": "به سیری نیامد کس از جان خویش"
  },
  {
    "poem_id": 88055,
    "vorder": 111,
    "position": 0,
    "text": "مرا رفت باید که از کار اوی"
  },
  {
    "poem_id": 88055,
    "vorder": 112,
    "position": 1,
    "text": "دلم پر ز درد است و پر آب روی"
  },
  {
    "poem_id": 88055,
    "vorder": 113,
    "position": 0,
    "text": "بدو گفت گودرز کای شیرمرد"
  },
  {
    "poem_id": 88055,
    "vorder": 114,
    "position": 1,
    "text": "نه گرم آزموده ز گیتی نه سرد"
  },
  {
    "poem_id": 88055,
    "vorder": 115,
    "position": 0,
    "text": "نبینی که ماییم پیروزگر"
  },
  {
    "poem_id": 88055,
    "vorder": 116,
    "position": 1,
    "text": "بدین کار مشتاب تند ای پسر"
  },
  {
    "poem_id": 88055,
    "vorder": 117,
    "position": 0,
    "text": "بر ایشان بود گستهم چیره‌بخت"
  },
  {
    "poem_id": 88055,
    "vorder": 118,
    "position": 1,
    "text": "وز ایشان ستاند سرو تاج و تخت"
  },
  {
    "poem_id": 88055,
    "vorder": 119,
    "position": 0,
    "text": "بمان تا کنون از پس گستهم"
  },
  {
    "poem_id": 88055,
    "vorder": 120,
    "position": 1,
    "text": "سواری فرستم چو شیر دژم"
  },
  {
    "poem_id": 88055,
    "vorder": 121,
    "position": 0,
    "text": "که با او بود یار گاه نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 122,
    "position": 1,
    "text": "سر دشمنان اندر آرد به گرد"
  },
  {
    "poem_id": 88055,
    "vorder": 123,
    "position": 0,
    "text": "بدو گفت بیژن که ای پهلوان"
  },
  {
    "poem_id": 88055,
    "vorder": 124,
    "position": 1,
    "text": "خردمند و بیدار و روشن‌روان"
  },
  {
    "poem_id": 88055,
    "vorder": 125,
    "position": 0,
    "text": "کنون یار باید که زندست مرد"
  },
  {
    "poem_id": 88055,
    "vorder": 126,
    "position": 1,
    "text": "نه آنگه کجا زو برآرند گرد"
  },
  {
    "poem_id": 88055,
    "vorder": 127,
    "position": 0,
    "text": "چو گستهم شد کشته در کارزار"
  },
  {
    "poem_id": 88055,
    "vorder": 128,
    "position": 1,
    "text": "سرآمد بر او روز و برگشت کار"
  },
  {
    "poem_id": 88055,
    "vorder": 129,
    "position": 0,
    "text": "کجا سود دارد مر او را سپاه"
  },
  {
    "poem_id": 88055,
    "vorder": 130,
    "position": 1,
    "text": "کنون دار گر داشت خواهی نگاه"
  },
  {
    "poem_id": 88055,
    "vorder": 131,
    "position": 0,
    "text": "بفرمای تا من ز تیمار اوی"
  },
  {
    "poem_id": 88055,
    "vorder": 132,
    "position": 1,
    "text": "ببندم کمر تنگ بر کار اوی"
  },
  {
    "poem_id": 88055,
    "vorder": 133,
    "position": 0,
    "text": "ور ایدونک گویی مرو من سرم"
  },
  {
    "poem_id": 88055,
    "vorder": 134,
    "position": 1,
    "text": "ببرم بدین آبگون خنجرم"
  },
  {
    "poem_id": 88055,
    "vorder": 135,
    "position": 0,
    "text": "که من زندگانی پس از مرگ اوی"
  },
  {
    "poem_id": 88055,
    "vorder": 136,
    "position": 1,
    "text": "نخواهم که باشد بهانه مجوی"
  },
  {
    "poem_id": 88055,
    "vorder": 137,
    "position": 0,
    "text": "بدو گفت گودرز بشتاب پیش"
  },
  {
    "poem_id": 88055,
    "vorder": 138,
    "position": 1,
    "text": "اگر نیست مهر تو بر جان خویش"
  },
  {
    "poem_id": 88055,
    "vorder": 139,
    "position": 0,
    "text": "نیابی همی سیری از کارزار"
  },
  {
    "poem_id": 88055,
    "vorder": 140,
    "position": 1,
    "text": "کمر بند و ببسیچ و سر بر مخار"
  },
  {
    "poem_id": 88055,
    "vorder": 141,
    "position": 0,
    "text": "نسوزد همانا دلت بر پدر"
  },
  {
    "poem_id": 88055,
    "vorder": 142,
    "position": 1,
    "text": "که هزمان مر او را بسوزی جگر"
  },
  {
    "poem_id": 88055,
    "vorder": 143,
    "position": 0,
    "text": "چو بشنید بیژن فرو برد سر"
  },
  {
    "poem_id": 88055,
    "vorder": 144,
    "position": 1,
    "text": "زمین را ببوسید و آمد به در"
  },
  {
    "poem_id": 88055,
    "vorder": 145,
    "position": 0,
    "text": "برآرم همی گفت از کوه خاک"
  },
  {
    "poem_id": 88055,
    "vorder": 146,
    "position": 1,
    "text": "بدین جنگ جستن مرا زو چه باک"
  },
  {
    "poem_id": 88055,
    "vorder": 147,
    "position": 0,
    "text": "کمر بست و برساخت مر جنگ را"
  },
  {
    "poem_id": 88055,
    "vorder": 148,
    "position": 1,
    "text": "به زین اندر آورد شبرنگ را"
  },
  {
    "poem_id": 88055,
    "vorder": 149,
    "position": 0,
    "text": "به گیو آگهی شد که بیژن چو گرد"
  },
  {
    "poem_id": 88055,
    "vorder": 150,
    "position": 1,
    "text": "کمر بست بر جنگ فرشیدورد"
  },
  {
    "poem_id": 88055,
    "vorder": 151,
    "position": 0,
    "text": "پس گستهم تازیان شد به راه"
  },
  {
    "poem_id": 88055,
    "vorder": 152,
    "position": 1,
    "text": "به جنگ سواران توران سپاه"
  },
  {
    "poem_id": 88055,
    "vorder": 153,
    "position": 0,
    "text": "هم اندر زمان گیو برجست زود"
  },
  {
    "poem_id": 88055,
    "vorder": 154,
    "position": 1,
    "text": "نشست از بر تازی اسبی چو دود"
  },
  {
    "poem_id": 88055,
    "vorder": 155,
    "position": 0,
    "text": "بیامد به ره بر چو او را بدید"
  },
  {
    "poem_id": 88055,
    "vorder": 156,
    "position": 1,
    "text": "به تندی عنانش به یکسو کشید"
  },
  {
    "poem_id": 88055,
    "vorder": 157,
    "position": 0,
    "text": "بدو گفت چندین زدم داستان"
  },
  {
    "poem_id": 88055,
    "vorder": 158,
    "position": 1,
    "text": "نخواهی همی بود همداستان"
  },
  {
    "poem_id": 88055,
    "vorder": 159,
    "position": 0,
    "text": "که باشم به تو شادمان یک زمان"
  },
  {
    "poem_id": 88055,
    "vorder": 160,
    "position": 1,
    "text": "کجا رفت خواهی بدین سان دمان"
  },
  {
    "poem_id": 88055,
    "vorder": 161,
    "position": 0,
    "text": "به هر کار درد دلم را مجوی"
  },
  {
    "poem_id": 88055,
    "vorder": 162,
    "position": 1,
    "text": "به پیران سر از من چه باید بگوی"
  },
  {
    "poem_id": 88055,
    "vorder": 163,
    "position": 0,
    "text": "جز از تو به گیتیم فرزند نیست"
  },
  {
    "poem_id": 88055,
    "vorder": 164,
    "position": 1,
    "text": "روانم به درد تو خرسند نیست"
  },
  {
    "poem_id": 88055,
    "vorder": 165,
    "position": 0,
    "text": "بدی ده شبان روز بر پشت زین"
  },
  {
    "poem_id": 88055,
    "vorder": 166,
    "position": 1,
    "text": "کشیده به بدخواه بر تیغ کین"
  },
  {
    "poem_id": 88055,
    "vorder": 167,
    "position": 0,
    "text": "بسودی به خفتان و خود اندرون"
  },
  {
    "poem_id": 88055,
    "vorder": 168,
    "position": 1,
    "text": "نخواهی همی سیر گشتن ز خون"
  },
  {
    "poem_id": 88055,
    "vorder": 169,
    "position": 0,
    "text": "چو نیکی دهش بخت پیروز داد"
  },
  {
    "poem_id": 88055,
    "vorder": 170,
    "position": 1,
    "text": "بباید نشستن به آرام و شاد"
  },
  {
    "poem_id": 88055,
    "vorder": 171,
    "position": 0,
    "text": "به پیش زمانه چه تازی سرت"
  },
  {
    "poem_id": 88055,
    "vorder": 172,
    "position": 1,
    "text": "بس ایمن شدستی بدین خنجرت"
  },
  {
    "poem_id": 88055,
    "vorder": 173,
    "position": 0,
    "text": "کسی کو بجوید سرانجام خویش"
  },
  {
    "poem_id": 88055,
    "vorder": 174,
    "position": 1,
    "text": "نجوید ز گیتی چنین کام خویش"
  },
  {
    "poem_id": 88055,
    "vorder": 175,
    "position": 0,
    "text": "تو چندین به گرد زمانه مپوی"
  },
  {
    "poem_id": 88055,
    "vorder": 176,
    "position": 1,
    "text": "که او خود سوی ما نهادست روی"
  },
  {
    "poem_id": 88055,
    "vorder": 177,
    "position": 0,
    "text": "ز بهر مرا ز این سخن بازگرد"
  },
  {
    "poem_id": 88055,
    "vorder": 178,
    "position": 1,
    "text": "نشاید که دارای دل من به درد"
  },
  {
    "poem_id": 88055,
    "vorder": 179,
    "position": 0,
    "text": "بدو گفت بیژن که ای پر خرد"
  },
  {
    "poem_id": 88055,
    "vorder": 180,
    "position": 1,
    "text": "جز این بر تو مردم گمانی برد"
  },
  {
    "poem_id": 88055,
    "vorder": 181,
    "position": 0,
    "text": "که کار گذشته بیاری به یاد"
  },
  {
    "poem_id": 88055,
    "vorder": 182,
    "position": 1,
    "text": "نپیچی به خیره همی سر ز داد"
  },
  {
    "poem_id": 88055,
    "vorder": 183,
    "position": 0,
    "text": "بدان ای پدر کین سخن داد نیست"
  },
  {
    "poem_id": 88055,
    "vorder": 184,
    "position": 1,
    "text": "مگر جنگ لاون ترا یاد نیست"
  },
  {
    "poem_id": 88055,
    "vorder": 185,
    "position": 0,
    "text": "که با من چه کرد اندر آن گستهم"
  },
  {
    "poem_id": 88055,
    "vorder": 186,
    "position": 1,
    "text": "غم و شادمانیش با من به هم"
  },
  {
    "poem_id": 88055,
    "vorder": 187,
    "position": 0,
    "text": "ورایدون کجا گردش ایزدی"
  },
  {
    "poem_id": 88055,
    "vorder": 188,
    "position": 1,
    "text": "فراز آورد روزگار بدی"
  },
  {
    "poem_id": 88055,
    "vorder": 189,
    "position": 0,
    "text": "نبشته نگردد به پرهیز باز"
  },
  {
    "poem_id": 88055,
    "vorder": 190,
    "position": 1,
    "text": "نباید کشید این سخن را دراز"
  },
  {
    "poem_id": 88055,
    "vorder": 191,
    "position": 0,
    "text": "ز پیکار سر بر مگردان که من"
  },
  {
    "poem_id": 88055,
    "vorder": 192,
    "position": 1,
    "text": "فدی کرده دارم بدین کار تن"
  },
  {
    "poem_id": 88055,
    "vorder": 193,
    "position": 0,
    "text": "بدو گفت گیو ار بگردی تو باز"
  },
  {
    "poem_id": 88055,
    "vorder": 194,
    "position": 1,
    "text": "همان خوبتر کین نشیب و فراز"
  },
  {
    "poem_id": 88055,
    "vorder": 195,
    "position": 0,
    "text": "تو بی‌من مپویی به روز نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 196,
    "position": 1,
    "text": "منت یار باشم به هر کارکرد"
  },
  {
    "poem_id": 88055,
    "vorder": 197,
    "position": 0,
    "text": "بدو گفت بیژن که این خود مباد"
  },
  {
    "poem_id": 88055,
    "vorder": 198,
    "position": 1,
    "text": "که از نامداران خسرونژاد"
  },
  {
    "poem_id": 88055,
    "vorder": 199,
    "position": 0,
    "text": "سه گرد از پی بیم خورده دو تور"
  },
  {
    "poem_id": 88055,
    "vorder": 200,
    "position": 1,
    "text": "بتازند پویان بدین راه دور"
  },
  {
    "poem_id": 88055,
    "vorder": 201,
    "position": 0,
    "text": "به جان و سر شاه روشن‌روان"
  },
  {
    "poem_id": 88055,
    "vorder": 202,
    "position": 1,
    "text": "به جان نیا نامور پهلوان"
  },
  {
    "poem_id": 88055,
    "vorder": 203,
    "position": 0,
    "text": "به کین سیاوش کز این رزمگاه"
  },
  {
    "poem_id": 88055,
    "vorder": 204,
    "position": 1,
    "text": "تو برگردی و من بپویم به راه"
  },
  {
    "poem_id": 88055,
    "vorder": 205,
    "position": 0,
    "text": "نخواهم بر این کار فرمانت کرد"
  },
  {
    "poem_id": 88055,
    "vorder": 206,
    "position": 1,
    "text": "که گویی مرا بازگرد از نبرد"
  },
  {
    "poem_id": 88055,
    "vorder": 207,
    "position": 0,
    "text": "چو بشنید گیو این سخن بازگشت"
  },
  {
    "poem_id": 88055,
    "vorder": 208,
    "position": 1,
    "text": "بر او آفرین کرد و اندر گذشت"
  },
  {
    "poem_id": 88055,
    "vorder": 209,
    "position": 0,
    "text": "که پیروز بادی و شاد آمدی"
  },
  {
    "poem_id": 88055,
    "vorder": 210,
    "position": 1,
    "text": "مبیناد چشم تو هرگز بدی"
  },
  {
    "poem_id": 88055,
    "vorder": 211,
    "position": 0,
    "text": "همی تاخت بیژن پس گستهم"
  },
  {
    "poem_id": 88055,
    "vorder": 212,
    "position": 1,
    "text": "که ناید بر او بر ز توران ستم"
  }
]