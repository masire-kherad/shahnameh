[
  {
    "poem_id": 88031,
    "vorder": 1,
    "position": 0,
    "text": "خبر شد به بیژن که هومان چو شیر"
  },
  {
    "poem_id": 88031,
    "vorder": 2,
    "position": 1,
    "text": "به پیش نیای تو آمد دلیر"
  },
  {
    "poem_id": 88031,
    "vorder": 3,
    "position": 0,
    "text": "چو بشنید بیژن برآشفت سخت"
  },
  {
    "poem_id": 88031,
    "vorder": 4,
    "position": 1,
    "text": "به خشم آمد آن شیر‌پنجه ز بخت"
  },
  {
    "poem_id": 88031,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا برنهادند زین"
  },
  {
    "poem_id": 88031,
    "vorder": 6,
    "position": 1,
    "text": "بر آن پیل‌تن دیزهٔ دوربین"
  },
  {
    "poem_id": 88031,
    "vorder": 7,
    "position": 0,
    "text": "بپوشید رومی‌زره جنگ را"
  },
  {
    "poem_id": 88031,
    "vorder": 8,
    "position": 1,
    "text": "یکی تنگ بربست شبرنگ را"
  },
  {
    "poem_id": 88031,
    "vorder": 9,
    "position": 0,
    "text": "به پیش پدر شد پر از کیمیا"
  },
  {
    "poem_id": 88031,
    "vorder": 10,
    "position": 1,
    "text": "سخن گفت با او ز بهر نیا"
  },
  {
    "poem_id": 88031,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت مر گیو را کای پدر"
  },
  {
    "poem_id": 88031,
    "vorder": 12,
    "position": 1,
    "text": "بگفتم ترا من همه در به در"
  },
  {
    "poem_id": 88031,
    "vorder": 13,
    "position": 0,
    "text": "که گودرز را هوش کمتر شده‌ست"
  },
  {
    "poem_id": 88031,
    "vorder": 14,
    "position": 1,
    "text": "به آیین نبینی که دیگر شده‌ست"
  },
  {
    "poem_id": 88031,
    "vorder": 15,
    "position": 0,
    "text": "دلش پر نهیب است و پرخون جگر"
  },
  {
    "poem_id": 88031,
    "vorder": 16,
    "position": 1,
    "text": "ز تیمار و ز درد چندان پسر"
  },
  {
    "poem_id": 88031,
    "vorder": 17,
    "position": 0,
    "text": "که از تن سرانشان جدا کرده‌دید"
  },
  {
    "poem_id": 88031,
    "vorder": 18,
    "position": 1,
    "text": "بدان رزمگه جمله افگنده‌دید"
  },
  {
    "poem_id": 88031,
    "vorder": 19,
    "position": 0,
    "text": "نشان آنک ترکی بیامد دلیر"
  },
  {
    "poem_id": 88031,
    "vorder": 20,
    "position": 1,
    "text": "میان دلیران به کردار شیر"
  },
  {
    "poem_id": 88031,
    "vorder": 21,
    "position": 0,
    "text": "به پیش نیا رفت نیزه به دست"
  },
  {
    "poem_id": 88031,
    "vorder": 22,
    "position": 1,
    "text": "همی بر خروشید بر سان مست"
  },
  {
    "poem_id": 88031,
    "vorder": 23,
    "position": 0,
    "text": "چنان بد کز این لشکر نامدار"
  },
  {
    "poem_id": 88031,
    "vorder": 24,
    "position": 1,
    "text": "سواری نبود از در کارزار"
  },
  {
    "poem_id": 88031,
    "vorder": 25,
    "position": 0,
    "text": "که او را به نیزه برافراختی"
  },
  {
    "poem_id": 88031,
    "vorder": 26,
    "position": 1,
    "text": "چو بر بابزن مرغ بر ساختی"
  },
  {
    "poem_id": 88031,
    "vorder": 27,
    "position": 0,
    "text": "تو ای مهربان باب بسیار‌هوش"
  },
  {
    "poem_id": 88031,
    "vorder": 28,
    "position": 1,
    "text": "دو کتفم به درع سیاوش بپوش"
  },
  {
    "poem_id": 88031,
    "vorder": 29,
    "position": 0,
    "text": "نشاید جز از من که سازم نبرد"
  },
  {
    "poem_id": 88031,
    "vorder": 30,
    "position": 1,
    "text": "بدان تا برآرم ز مردیش گرد"
  },
  {
    "poem_id": 88031,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت گیو ای پسر هوش دار"
  },
  {
    "poem_id": 88031,
    "vorder": 32,
    "position": 1,
    "text": "به گفتار من سر به سر گوش دار"
  },
  {
    "poem_id": 88031,
    "vorder": 33,
    "position": 0,
    "text": "ترا گفته بودم که تندی مکن"
  },
  {
    "poem_id": 88031,
    "vorder": 34,
    "position": 1,
    "text": "ز گودرز بر بد مگردان سخن"
  },
  {
    "poem_id": 88031,
    "vorder": 35,
    "position": 0,
    "text": "که او کار دیده‌ست و داناترست"
  },
  {
    "poem_id": 88031,
    "vorder": 36,
    "position": 1,
    "text": "بدین لشکر نامور مهترست"
  },
  {
    "poem_id": 88031,
    "vorder": 37,
    "position": 0,
    "text": "سواران جنگی به پیش اندرند"
  },
  {
    "poem_id": 88031,
    "vorder": 38,
    "position": 1,
    "text": "که بر کینه‌گه پیل را بشکرند"
  },
  {
    "poem_id": 88031,
    "vorder": 39,
    "position": 0,
    "text": "نفرمود با او کسی را نبرد"
  },
  {
    "poem_id": 88031,
    "vorder": 40,
    "position": 1,
    "text": "جوانی مگر مر ترا خیره کرد؟"
  },
  {
    "poem_id": 88031,
    "vorder": 41,
    "position": 0,
    "text": "که گردن بدین سان برافراختی"
  },
  {
    "poem_id": 88031,
    "vorder": 42,
    "position": 1,
    "text": "بدین آرزو پیش من تاختی"
  },
  {
    "poem_id": 88031,
    "vorder": 43,
    "position": 0,
    "text": "نیم من بدین کار همداستان"
  },
  {
    "poem_id": 88031,
    "vorder": 44,
    "position": 1,
    "text": "مزن نیز پیشم چنین داستان"
  },
  {
    "poem_id": 88031,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت بیژن که گر کام من"
  },
  {
    "poem_id": 88031,
    "vorder": 46,
    "position": 1,
    "text": "نجویی نخواهی مگر نام من"
  },
  {
    "poem_id": 88031,
    "vorder": 47,
    "position": 0,
    "text": "شوم پیش سالار بسته‌کمر"
  },
  {
    "poem_id": 88031,
    "vorder": 48,
    "position": 1,
    "text": "زنم دست بر جنگ هومان به بر"
  },
  {
    "poem_id": 88031,
    "vorder": 49,
    "position": 0,
    "text": "وز آنجا بزد اسب و برگاشت روی"
  },
  {
    "poem_id": 88031,
    "vorder": 50,
    "position": 1,
    "text": "به نزدیک گودرز شد پوی پوی"
  },
  {
    "poem_id": 88031,
    "vorder": 51,
    "position": 0,
    "text": "ستایش‌کنان پیش او شد به درد"
  },
  {
    "poem_id": 88031,
    "vorder": 52,
    "position": 1,
    "text": "هم این داستان سر به سر یاد کرد"
  },
  {
    "poem_id": 88031,
    "vorder": 53,
    "position": 0,
    "text": "که ای پهلوان جهاندار شاه"
  },
  {
    "poem_id": 88031,
    "vorder": 54,
    "position": 1,
    "text": "شناسای هر کار و زیبای گاه"
  },
  {
    "poem_id": 88031,
    "vorder": 55,
    "position": 0,
    "text": "شگفتی همی‌بینم از تو یکی"
  },
  {
    "poem_id": 88031,
    "vorder": 56,
    "position": 1,
    "text": "وگر چند هستم به هوش اندکی"
  },
  {
    "poem_id": 88031,
    "vorder": 57,
    "position": 0,
    "text": "کز این رزمگه بوستان ساختی"
  },
  {
    "poem_id": 88031,
    "vorder": 58,
    "position": 1,
    "text": "دل از کین ترکان بپرداختی"
  },
  {
    "poem_id": 88031,
    "vorder": 59,
    "position": 0,
    "text": "شگفتی‌تر آنک از میان سپاه"
  },
  {
    "poem_id": 88031,
    "vorder": 60,
    "position": 1,
    "text": "یکی ترک بدبخت گم‌کرده راه"
  },
  {
    "poem_id": 88031,
    "vorder": 61,
    "position": 0,
    "text": "بیامد که یزدان نیکی‌کنش"
  },
  {
    "poem_id": 88031,
    "vorder": 62,
    "position": 1,
    "text": "همی بد سگالید با بد تنش"
  },
  {
    "poem_id": 88031,
    "vorder": 63,
    "position": 0,
    "text": "بیاوردش از پیش توران سپاه"
  },
  {
    "poem_id": 88031,
    "vorder": 64,
    "position": 1,
    "text": "بدان تا به دست تو گردد تباه"
  },
  {
    "poem_id": 88031,
    "vorder": 65,
    "position": 0,
    "text": "به دام آمده گرگ برگاشتی"
  },
  {
    "poem_id": 88031,
    "vorder": 66,
    "position": 1,
    "text": "ندانم کز این خود چه پنداشتی"
  },
  {
    "poem_id": 88031,
    "vorder": 67,
    "position": 0,
    "text": "تو دانی که گر خون او بی‌درنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 68,
    "position": 1,
    "text": "بریزند پیران نیاید به جنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 69,
    "position": 0,
    "text": "مپندار کاو کینه بیش آورد"
  },
  {
    "poem_id": 88031,
    "vorder": 70,
    "position": 1,
    "text": "سپه را بر این دشت پیش آورد"
  },
  {
    "poem_id": 88031,
    "vorder": 71,
    "position": 0,
    "text": "من اینک به خون چنگ را شسته‌ام"
  },
  {
    "poem_id": 88031,
    "vorder": 72,
    "position": 1,
    "text": "همان جنگ او را کمر بسته‌ام"
  },
  {
    "poem_id": 88031,
    "vorder": 73,
    "position": 0,
    "text": "چو دستور باشد مرا پهلوان"
  },
  {
    "poem_id": 88031,
    "vorder": 74,
    "position": 1,
    "text": "شوم پیش او چون هژبر دمان"
  },
  {
    "poem_id": 88031,
    "vorder": 75,
    "position": 0,
    "text": "بفرماید اکنون سپهبد به گیو"
  },
  {
    "poem_id": 88031,
    "vorder": 76,
    "position": 1,
    "text": "مگر کان سلیح سیاووش نیو"
  },
  {
    "poem_id": 88031,
    "vorder": 77,
    "position": 0,
    "text": "دهد مر مرا خود و رومی‌زره"
  },
  {
    "poem_id": 88031,
    "vorder": 78,
    "position": 1,
    "text": "ز بند زره برگشاید گره"
  },
  {
    "poem_id": 88031,
    "vorder": 79,
    "position": 0,
    "text": "چو بشنید گودرز گفتار اوی"
  },
  {
    "poem_id": 88031,
    "vorder": 80,
    "position": 1,
    "text": "بدید آن دل و رای هشیار اوی"
  },
  {
    "poem_id": 88031,
    "vorder": 81,
    "position": 0,
    "text": "ز شادی بر او آفرین کرد سخت"
  },
  {
    "poem_id": 88031,
    "vorder": 82,
    "position": 1,
    "text": "که از تو مگرداد جاوید بخت"
  },
  {
    "poem_id": 88031,
    "vorder": 83,
    "position": 0,
    "text": "تو تا برنشستی به زین پلنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 84,
    "position": 1,
    "text": "نهنگ از دم آسود و شیران ز جنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 85,
    "position": 0,
    "text": "به هر کارزار اندر آیی دلیر"
  },
  {
    "poem_id": 88031,
    "vorder": 86,
    "position": 1,
    "text": "به هر جنگ پیروز باشی چو شیر"
  },
  {
    "poem_id": 88031,
    "vorder": 87,
    "position": 0,
    "text": "نگه کن که با او به آوردگاه"
  },
  {
    "poem_id": 88031,
    "vorder": 88,
    "position": 1,
    "text": "توانی شدن زان پس آورد خواه"
  },
  {
    "poem_id": 88031,
    "vorder": 89,
    "position": 0,
    "text": "که هومان یکی بدکنش ریمن است"
  },
  {
    "poem_id": 88031,
    "vorder": 90,
    "position": 1,
    "text": "به آورد و جنگ او چو آهرمن است"
  },
  {
    "poem_id": 88031,
    "vorder": 91,
    "position": 0,
    "text": "جوانی و ناگشته بر سر سپهر"
  },
  {
    "poem_id": 88031,
    "vorder": 92,
    "position": 1,
    "text": "نداری همی بر تن خویش مهر"
  },
  {
    "poem_id": 88031,
    "vorder": 93,
    "position": 0,
    "text": "بمان تا یکی رزم دیده هژبر"
  },
  {
    "poem_id": 88031,
    "vorder": 94,
    "position": 1,
    "text": "فرستم به جنگش به کردار ابر"
  },
  {
    "poem_id": 88031,
    "vorder": 95,
    "position": 0,
    "text": "بر او تیرباران کند چون تگرگ"
  },
  {
    "poem_id": 88031,
    "vorder": 96,
    "position": 1,
    "text": "به سر بر بدوزدش پولاد ترگ"
  },
  {
    "poem_id": 88031,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت بیژن که ای پهلوان"
  },
  {
    "poem_id": 88031,
    "vorder": 98,
    "position": 1,
    "text": "هنرمند باشد دلیر و جوان"
  },
  {
    "poem_id": 88031,
    "vorder": 99,
    "position": 0,
    "text": "مرا گر بدیدی به رزم فرود"
  },
  {
    "poem_id": 88031,
    "vorder": 100,
    "position": 1,
    "text": "ز سر باز باید کنون آزمود"
  },
  {
    "poem_id": 88031,
    "vorder": 101,
    "position": 0,
    "text": "به جنگ پشن بر نوشتم زمین"
  },
  {
    "poem_id": 88031,
    "vorder": 102,
    "position": 1,
    "text": "نبیند کسی پشت من روز کین"
  },
  {
    "poem_id": 88031,
    "vorder": 103,
    "position": 0,
    "text": "مرا زندگانی نه اندر خورست"
  },
  {
    "poem_id": 88031,
    "vorder": 104,
    "position": 1,
    "text": "گر از دیگرانم هنر کمترست"
  },
  {
    "poem_id": 88031,
    "vorder": 105,
    "position": 0,
    "text": "وگر بازداری مرا زین سخن"
  },
  {
    "poem_id": 88031,
    "vorder": 106,
    "position": 1,
    "text": "بدان روی کآهنگ هومان مکن"
  },
  {
    "poem_id": 88031,
    "vorder": 107,
    "position": 0,
    "text": "بنالم من از پهلوان پیش شاه"
  },
  {
    "poem_id": 88031,
    "vorder": 108,
    "position": 1,
    "text": "نخواهم کمر زان سپس نه کلاه"
  },
  {
    "poem_id": 88031,
    "vorder": 109,
    "position": 0,
    "text": "بخندید گودرز و زو شاد شد"
  },
  {
    "poem_id": 88031,
    "vorder": 110,
    "position": 1,
    "text": "به سان یکی سرو آزاد شد"
  },
  {
    "poem_id": 88031,
    "vorder": 111,
    "position": 0,
    "text": "بدو گفت نیک اختر و بخت گیو"
  },
  {
    "poem_id": 88031,
    "vorder": 112,
    "position": 1,
    "text": "که فرزند بیند همی چون تو نیو"
  },
  {
    "poem_id": 88031,
    "vorder": 113,
    "position": 0,
    "text": "تو تا چنگ را باز کردی به جنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 114,
    "position": 1,
    "text": "فروماند از جنگ چنگ پلنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 115,
    "position": 0,
    "text": "ترا دادم این رزم هومان کنون"
  },
  {
    "poem_id": 88031,
    "vorder": 116,
    "position": 1,
    "text": "مگر بخت نیکت بود رهنمون"
  },
  {
    "poem_id": 88031,
    "vorder": 117,
    "position": 0,
    "text": "گر این اهرمن را به دست تو هوش"
  },
  {
    "poem_id": 88031,
    "vorder": 118,
    "position": 1,
    "text": "برآید به فرمان یزدان بکوش"
  },
  {
    "poem_id": 88031,
    "vorder": 119,
    "position": 0,
    "text": "به نام جهاندار یزدان ما"
  },
  {
    "poem_id": 88031,
    "vorder": 120,
    "position": 1,
    "text": "به پیروزی شاه و گردان ما"
  },
  {
    "poem_id": 88031,
    "vorder": 121,
    "position": 0,
    "text": "بگویم کنون گیو را کان زره"
  },
  {
    "poem_id": 88031,
    "vorder": 122,
    "position": 1,
    "text": "که بیژن همی‌خواهد او را بده"
  },
  {
    "poem_id": 88031,
    "vorder": 123,
    "position": 0,
    "text": "گر ایدنک پیروز باشی بر اوی"
  },
  {
    "poem_id": 88031,
    "vorder": 124,
    "position": 1,
    "text": "ترا بیشتر نزد من آبروی"
  },
  {
    "poem_id": 88031,
    "vorder": 125,
    "position": 0,
    "text": "ز فرهاد و گیوت برآرم به جاه"
  },
  {
    "poem_id": 88031,
    "vorder": 126,
    "position": 1,
    "text": "به گنج و سپاه و به تخت و کلاه"
  },
  {
    "poem_id": 88031,
    "vorder": 127,
    "position": 0,
    "text": "بگفت این سخن با نبیره نیا"
  },
  {
    "poem_id": 88031,
    "vorder": 128,
    "position": 1,
    "text": "نبیره پر از بند و پر کیمیا"
  },
  {
    "poem_id": 88031,
    "vorder": 129,
    "position": 0,
    "text": "پیاده شد از اسب و روی زمین"
  },
  {
    "poem_id": 88031,
    "vorder": 130,
    "position": 1,
    "text": "ببوسید و بر باب کرد آفرین"
  },
  {
    "poem_id": 88031,
    "vorder": 131,
    "position": 0,
    "text": "بخواند آن زمان گیو را پهلوان"
  },
  {
    "poem_id": 88031,
    "vorder": 132,
    "position": 1,
    "text": "سخن گفت با او ز بهر جوان"
  },
  {
    "poem_id": 88031,
    "vorder": 133,
    "position": 0,
    "text": "وز آن خسروانی زره یاد کرد"
  },
  {
    "poem_id": 88031,
    "vorder": 134,
    "position": 1,
    "text": "کجا خواست بیژن ز بهر نبرد"
  },
  {
    "poem_id": 88031,
    "vorder": 135,
    "position": 0,
    "text": "چنین داد پاسخ پدر را پسر"
  },
  {
    "poem_id": 88031,
    "vorder": 136,
    "position": 1,
    "text": "که ای پهلوان جهان سر به سر"
  },
  {
    "poem_id": 88031,
    "vorder": 137,
    "position": 0,
    "text": "مرا هوش و جان و جهان این یکیست"
  },
  {
    "poem_id": 88031,
    "vorder": 138,
    "position": 1,
    "text": "به چشمم چنین جان او خوار نیست"
  },
  {
    "poem_id": 88031,
    "vorder": 139,
    "position": 0,
    "text": "بدو گفت گودرز کای مهربان"
  },
  {
    "poem_id": 88031,
    "vorder": 140,
    "position": 1,
    "text": "جز این برد باید به وی بر گمان"
  },
  {
    "poem_id": 88031,
    "vorder": 141,
    "position": 0,
    "text": "که هر چند بیژن جوانست و نو"
  },
  {
    "poem_id": 88031,
    "vorder": 142,
    "position": 1,
    "text": "به هر کار دارد خرد پیشرو"
  },
  {
    "poem_id": 88031,
    "vorder": 143,
    "position": 0,
    "text": "و دیگر که این جای کین جستن است"
  },
  {
    "poem_id": 88031,
    "vorder": 144,
    "position": 1,
    "text": "جهان را ز آهرمنان شستن است"
  },
  {
    "poem_id": 88031,
    "vorder": 145,
    "position": 0,
    "text": "به کین سیاوش به فرمان شاه"
  },
  {
    "poem_id": 88031,
    "vorder": 146,
    "position": 1,
    "text": "نشاید به پیوند کردن نگاه"
  },
  {
    "poem_id": 88031,
    "vorder": 147,
    "position": 0,
    "text": "و گر بارد از ابر پولاد تیغ"
  },
  {
    "poem_id": 88031,
    "vorder": 148,
    "position": 1,
    "text": "نشاید که داریم ما جان دریغ"
  },
  {
    "poem_id": 88031,
    "vorder": 149,
    "position": 0,
    "text": "نشاید شکستن دلش را به جنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 150,
    "position": 1,
    "text": "بپوشیدنش جامهٔ نام و ننگ"
  },
  {
    "poem_id": 88031,
    "vorder": 151,
    "position": 0,
    "text": "که چون کاهلی پیشه گیرد جوان"
  },
  {
    "poem_id": 88031,
    "vorder": 152,
    "position": 1,
    "text": "بماند منش پست و تیره روان"
  },
  {
    "poem_id": 88031,
    "vorder": 153,
    "position": 0,
    "text": "چو پاسخ چنین یافت چاره نبود"
  },
  {
    "poem_id": 88031,
    "vorder": 154,
    "position": 1,
    "text": "یکی با پسر نیز بند آزمود"
  },
  {
    "poem_id": 88031,
    "vorder": 155,
    "position": 0,
    "text": "به گودرز گفت ای جهان‌پهلوان"
  },
  {
    "poem_id": 88031,
    "vorder": 156,
    "position": 1,
    "text": "به جایی که پیکار خیزد به جان"
  },
  {
    "poem_id": 88031,
    "vorder": 157,
    "position": 0,
    "text": "مرا خود شب و روز کارست پیش"
  },
  {
    "poem_id": 88031,
    "vorder": 158,
    "position": 1,
    "text": "چرا داد باید مرا جان خویش"
  },
  {
    "poem_id": 88031,
    "vorder": 159,
    "position": 0,
    "text": "نه فرزند باید نه گنج و سپاه"
  },
  {
    "poem_id": 88031,
    "vorder": 160,
    "position": 1,
    "text": "نه آزرم سالار و فرمان شاه"
  },
  {
    "poem_id": 88031,
    "vorder": 161,
    "position": 0,
    "text": "اگر جنگ جوید سلیحش کجاست؟"
  },
  {
    "poem_id": 88031,
    "vorder": 162,
    "position": 1,
    "text": "زره دارد از من چه بایدش خواست"
  },
  {
    "poem_id": 88031,
    "vorder": 163,
    "position": 0,
    "text": "چنین گفت پیش پدر رزمساز"
  },
  {
    "poem_id": 88031,
    "vorder": 164,
    "position": 1,
    "text": "که ما را به درع تو ناید نیاز"
  },
  {
    "poem_id": 88031,
    "vorder": 165,
    "position": 0,
    "text": "بر آنی که اندر جهان سر به سر"
  },
  {
    "poem_id": 88031,
    "vorder": 166,
    "position": 1,
    "text": "به درع تو جویند مردان هنر"
  },
  {
    "poem_id": 88031,
    "vorder": 167,
    "position": 0,
    "text": "چو درع سیاوش نباشد به جنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 168,
    "position": 1,
    "text": "نجویند گردنکشان نام و ننگ"
  },
  {
    "poem_id": 88031,
    "vorder": 169,
    "position": 0,
    "text": "برانگیخت اسب از میان سپاه"
  },
  {
    "poem_id": 88031,
    "vorder": 170,
    "position": 1,
    "text": "که آید ز لشکر به آوردگاه"
  },
  {
    "poem_id": 88031,
    "vorder": 171,
    "position": 0,
    "text": "چو از پیش گودرز شد ناپدید"
  },
  {
    "poem_id": 88031,
    "vorder": 172,
    "position": 1,
    "text": "دل گیو ز اندوه او بردمید"
  },
  {
    "poem_id": 88031,
    "vorder": 173,
    "position": 0,
    "text": "پشیمان شد از درد دل خون گریست"
  },
  {
    "poem_id": 88031,
    "vorder": 174,
    "position": 1,
    "text": "نگر تا غم و مهر فرزند چیست"
  },
  {
    "poem_id": 88031,
    "vorder": 175,
    "position": 0,
    "text": "یکی بآسمان برفرازید سر"
  },
  {
    "poem_id": 88031,
    "vorder": 176,
    "position": 1,
    "text": "پر از خون دل از درد خسته جگر"
  },
  {
    "poem_id": 88031,
    "vorder": 177,
    "position": 0,
    "text": "به دادار گفت ار جهان‌داوری"
  },
  {
    "poem_id": 88031,
    "vorder": 178,
    "position": 1,
    "text": "یکی سوی این خسته‌دل بنگری"
  },
  {
    "poem_id": 88031,
    "vorder": 179,
    "position": 0,
    "text": "نسوزی تو از جان بیژن دلم"
  },
  {
    "poem_id": 88031,
    "vorder": 180,
    "position": 1,
    "text": "که ز آب مژه تا دل اندر گلم"
  },
  {
    "poem_id": 88031,
    "vorder": 181,
    "position": 0,
    "text": "به من باز بخشش تو ای کردگار"
  },
  {
    "poem_id": 88031,
    "vorder": 182,
    "position": 1,
    "text": "بگردان ز جانش بد روزگار"
  },
  {
    "poem_id": 88031,
    "vorder": 183,
    "position": 0,
    "text": "بیامد پراندیشه دل پهلوان"
  },
  {
    "poem_id": 88031,
    "vorder": 184,
    "position": 1,
    "text": "پر از خون دل از بهر رفته جوان"
  },
  {
    "poem_id": 88031,
    "vorder": 185,
    "position": 0,
    "text": "به دل گفت خیره بیازردمش"
  },
  {
    "poem_id": 88031,
    "vorder": 186,
    "position": 1,
    "text": "چرا خواسته پیش ناوردمش"
  },
  {
    "poem_id": 88031,
    "vorder": 187,
    "position": 0,
    "text": "گر او را ز هومان بد آید به سر"
  },
  {
    "poem_id": 88031,
    "vorder": 188,
    "position": 1,
    "text": "چه باید مرا درع و تیغ و کمر"
  },
  {
    "poem_id": 88031,
    "vorder": 189,
    "position": 0,
    "text": "بمانم پر از حسرت و درد و خشم"
  },
  {
    "poem_id": 88031,
    "vorder": 190,
    "position": 1,
    "text": "پر از آرزو دل پر از آب چشم"
  },
  {
    "poem_id": 88031,
    "vorder": 191,
    "position": 0,
    "text": "وز آنجا دمان هم به کردار گرد"
  },
  {
    "poem_id": 88031,
    "vorder": 192,
    "position": 1,
    "text": "به پیش پسر شد به جای نبرد"
  },
  {
    "poem_id": 88031,
    "vorder": 193,
    "position": 0,
    "text": "بدو گفت ما را چه داری به تنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 194,
    "position": 1,
    "text": "همی تیزی آری به جای درنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 195,
    "position": 0,
    "text": "سیه مار چندان دمد روز جنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 196,
    "position": 1,
    "text": "که از ژرف دریا برآید نهنگ"
  },
  {
    "poem_id": 88031,
    "vorder": 197,
    "position": 0,
    "text": "درفشیدن ماه چندان بود"
  },
  {
    "poem_id": 88031,
    "vorder": 198,
    "position": 1,
    "text": "که خورشید تابنده پنهان بود"
  },
  {
    "poem_id": 88031,
    "vorder": 199,
    "position": 0,
    "text": "کنون سوی هومان شتابی همی"
  },
  {
    "poem_id": 88031,
    "vorder": 200,
    "position": 1,
    "text": "ز فرمان من سر بتابی همی"
  },
  {
    "poem_id": 88031,
    "vorder": 201,
    "position": 0,
    "text": "چنین برگزینی همی رای خویش"
  },
  {
    "poem_id": 88031,
    "vorder": 202,
    "position": 1,
    "text": "ندانی که چون آیدت کار پیش"
  },
  {
    "poem_id": 88031,
    "vorder": 203,
    "position": 0,
    "text": "بدو گفت بیژن که ای نیو باب"
  },
  {
    "poem_id": 88031,
    "vorder": 204,
    "position": 1,
    "text": "دل من ز کین سیاوش متاب"
  },
  {
    "poem_id": 88031,
    "vorder": 205,
    "position": 0,
    "text": "که هومان نه از روی وز آهن است"
  },
  {
    "poem_id": 88031,
    "vorder": 206,
    "position": 1,
    "text": "نه پیل ژیان و نه آهرمن است"
  },
  {
    "poem_id": 88031,
    "vorder": 207,
    "position": 0,
    "text": "یکی مرد جنگ است و من جنگجوی"
  },
  {
    "poem_id": 88031,
    "vorder": 208,
    "position": 1,
    "text": "از او برنتابم به بخت تو روی"
  },
  {
    "poem_id": 88031,
    "vorder": 209,
    "position": 0,
    "text": "نوشته مگر بر سرم دیگرست"
  },
  {
    "poem_id": 88031,
    "vorder": 210,
    "position": 1,
    "text": "زمانه به دست جهان‌داورست"
  },
  {
    "poem_id": 88031,
    "vorder": 211,
    "position": 0,
    "text": "اگر بودنی بود دل را به غم"
  },
  {
    "poem_id": 88031,
    "vorder": 212,
    "position": 1,
    "text": "سزد گر نداری نباشی دژم"
  },
  {
    "poem_id": 88031,
    "vorder": 213,
    "position": 0,
    "text": "چو بشنید گفتار پور دلیر"
  },
  {
    "poem_id": 88031,
    "vorder": 214,
    "position": 1,
    "text": "میان بستهٔ جنگ بر سان شیر"
  },
  {
    "poem_id": 88031,
    "vorder": 215,
    "position": 0,
    "text": "فرودآمد از دیزهٔ راهجوی"
  },
  {
    "poem_id": 88031,
    "vorder": 216,
    "position": 1,
    "text": "سپر داد و درع سیاوش بدوی"
  },
  {
    "poem_id": 88031,
    "vorder": 217,
    "position": 0,
    "text": "بدو گفت گر کارزارت هواست"
  },
  {
    "poem_id": 88031,
    "vorder": 218,
    "position": 1,
    "text": "چنین بر خرد کام تو پادشاست"
  },
  {
    "poem_id": 88031,
    "vorder": 219,
    "position": 0,
    "text": "بر این بارهٔ گامزن برنشین"
  },
  {
    "poem_id": 88031,
    "vorder": 220,
    "position": 1,
    "text": "که زیر تو اندر نوردد زمین"
  },
  {
    "poem_id": 88031,
    "vorder": 221,
    "position": 0,
    "text": "سلیحم همیدون به کار آیدت"
  },
  {
    "poem_id": 88031,
    "vorder": 222,
    "position": 1,
    "text": "چو با اهرمن کارزار آیدت"
  },
  {
    "poem_id": 88031,
    "vorder": 223,
    "position": 0,
    "text": "چو اسب پدر دید بر پای پیش"
  },
  {
    "poem_id": 88031,
    "vorder": 224,
    "position": 1,
    "text": "چو باد اندر آمد ز بالای خویش"
  },
  {
    "poem_id": 88031,
    "vorder": 225,
    "position": 0,
    "text": "بر آن بارهٔ خسروی برنشست"
  },
  {
    "poem_id": 88031,
    "vorder": 226,
    "position": 1,
    "text": "کمر بست و بگرفت گرزش به دست"
  },
  {
    "poem_id": 88031,
    "vorder": 227,
    "position": 0,
    "text": "یکی ترجمان را ز لشکر بجست"
  },
  {
    "poem_id": 88031,
    "vorder": 228,
    "position": 1,
    "text": "که گفتار ترکان بداند درست"
  },
  {
    "poem_id": 88031,
    "vorder": 229,
    "position": 0,
    "text": "بیامد به سان هژبر ژیان"
  },
  {
    "poem_id": 88031,
    "vorder": 230,
    "position": 1,
    "text": "به کین سیاووش بسته میان"
  },
  {
    "poem_id": 88031,
    "vorder": 231,
    "position": 0,
    "text": "چو بیژن به نزدیک هومان رسید"
  },
  {
    "poem_id": 88031,
    "vorder": 232,
    "position": 1,
    "text": "یکی آهنین کوه پوشیده دید"
  },
  {
    "poem_id": 88031,
    "vorder": 233,
    "position": 0,
    "text": "ز جوشن همه دشت روشن شده"
  },
  {
    "poem_id": 88031,
    "vorder": 234,
    "position": 1,
    "text": "یکی پیل در زیر جوشن شده"
  },
  {
    "poem_id": 88031,
    "vorder": 235,
    "position": 0,
    "text": "از آن پس بفرمود تا ترجمان"
  },
  {
    "poem_id": 88031,
    "vorder": 236,
    "position": 1,
    "text": "یکی بانگ برزد بر آن بدگمان"
  },
  {
    "poem_id": 88031,
    "vorder": 237,
    "position": 0,
    "text": "که گر جنگ جویی یکی بازگرد"
  },
  {
    "poem_id": 88031,
    "vorder": 238,
    "position": 1,
    "text": "که بیژن همی با تو جوید نبرد"
  },
  {
    "poem_id": 88031,
    "vorder": 239,
    "position": 0,
    "text": "همی‌گوید ای رزم‌دیده سوار"
  },
  {
    "poem_id": 88031,
    "vorder": 240,
    "position": 1,
    "text": "چه پویانی اسب اندر این مرغزار؟"
  },
  {
    "poem_id": 88031,
    "vorder": 241,
    "position": 0,
    "text": "کز افراسیاب اندر آیدت بد"
  },
  {
    "poem_id": 88031,
    "vorder": 242,
    "position": 1,
    "text": "ز توران زمین بر تو نفرین سزد"
  },
  {
    "poem_id": 88031,
    "vorder": 243,
    "position": 0,
    "text": "به کینه پی‌افگنده و بدخوی"
  },
  {
    "poem_id": 88031,
    "vorder": 244,
    "position": 1,
    "text": "ز ترکان گنهکارتر کس توی"
  },
  {
    "poem_id": 88031,
    "vorder": 245,
    "position": 0,
    "text": "عنان بازکش ز این تگاور هیون"
  },
  {
    "poem_id": 88031,
    "vorder": 246,
    "position": 1,
    "text": "کت اکنون ز کینه بجوشید خون"
  },
  {
    "poem_id": 88031,
    "vorder": 247,
    "position": 0,
    "text": "یکی برگزین جایگاه نبرد"
  },
  {
    "poem_id": 88031,
    "vorder": 248,
    "position": 1,
    "text": "به دشت و در و کوه با من بگرد"
  },
  {
    "poem_id": 88031,
    "vorder": 249,
    "position": 0,
    "text": "وگر در میان دو رویه سپاه"
  },
  {
    "poem_id": 88031,
    "vorder": 250,
    "position": 1,
    "text": "بگردی به لاف از پی نام و جاه"
  },
  {
    "poem_id": 88031,
    "vorder": 251,
    "position": 0,
    "text": "کجا دشمن و دوست بیند ترا"
  },
  {
    "poem_id": 88031,
    "vorder": 252,
    "position": 1,
    "text": "دل اکنون کجا برگزیند ترا"
  },
  {
    "poem_id": 88031,
    "vorder": 253,
    "position": 0,
    "text": "چو بشنید هومان بدو گفت زه"
  },
  {
    "poem_id": 88031,
    "vorder": 254,
    "position": 1,
    "text": "زره را به کینم تو بستی گره"
  },
  {
    "poem_id": 88031,
    "vorder": 255,
    "position": 0,
    "text": "ز یزدان سپاس و بدویم پناه"
  },
  {
    "poem_id": 88031,
    "vorder": 256,
    "position": 1,
    "text": "کت آورد پیشم بدین رزمگاه"
  },
  {
    "poem_id": 88031,
    "vorder": 257,
    "position": 0,
    "text": "به لشکر بر آن سان فرستمت باز"
  },
  {
    "poem_id": 88031,
    "vorder": 258,
    "position": 1,
    "text": "که گیو از تو ماند به گرم و گداز"
  },
  {
    "poem_id": 88031,
    "vorder": 259,
    "position": 0,
    "text": "سرت را ز تن دور مانم نه دیر"
  },
  {
    "poem_id": 88031,
    "vorder": 260,
    "position": 1,
    "text": "چنان کز تبارت فراوان دلیر"
  },
  {
    "poem_id": 88031,
    "vorder": 261,
    "position": 0,
    "text": "چه سودست کآمد به نزدیک شب"
  },
  {
    "poem_id": 88031,
    "vorder": 262,
    "position": 1,
    "text": "رو اکنون به زنهار تاریک شب"
  },
  {
    "poem_id": 88031,
    "vorder": 263,
    "position": 0,
    "text": "من اکنون یکی باز لشگر شوم"
  },
  {
    "poem_id": 88031,
    "vorder": 264,
    "position": 1,
    "text": "به شبگیر نزدیک مهتر شوم"
  },
  {
    "poem_id": 88031,
    "vorder": 265,
    "position": 0,
    "text": "وزآنجا دمان گردن افراخته"
  },
  {
    "poem_id": 88031,
    "vorder": 266,
    "position": 1,
    "text": "بیایم نبرد ترا ساخته"
  },
  {
    "poem_id": 88031,
    "vorder": 267,
    "position": 0,
    "text": "چنین پاسخ آورد بیژن که شو"
  },
  {
    "poem_id": 88031,
    "vorder": 268,
    "position": 1,
    "text": "پست باد و آهرمنت پیشرو"
  },
  {
    "poem_id": 88031,
    "vorder": 269,
    "position": 0,
    "text": "همه دشمنان سر به سر کشته باد"
  },
  {
    "poem_id": 88031,
    "vorder": 270,
    "position": 1,
    "text": "گر آواره از جنگ برگشته باد"
  },
  {
    "poem_id": 88031,
    "vorder": 271,
    "position": 0,
    "text": "چو فردا بیایی به آوردگاه"
  },
  {
    "poem_id": 88031,
    "vorder": 272,
    "position": 1,
    "text": "نبیند ترا نیز شاه و سپاه"
  },
  {
    "poem_id": 88031,
    "vorder": 273,
    "position": 0,
    "text": "سرت را چنان دور مانم ز پای"
  },
  {
    "poem_id": 88031,
    "vorder": 274,
    "position": 1,
    "text": "کزان پس به لشکر نیایدت رای"
  }
]