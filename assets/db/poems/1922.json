[
  {
    "poem_id": 1922,
    "vorder": 1,
    "position": 0,
    "text": "یکی دخت دیگر بد آزرم نام"
  },
  {
    "poem_id": 1922,
    "vorder": 2,
    "position": 1,
    "text": "ز تاج بزرگان رسیده به کام"
  },
  {
    "poem_id": 1922,
    "vorder": 3,
    "position": 0,
    "text": "بیامد به تخت کیان برنشست"
  },
  {
    "poem_id": 1922,
    "vorder": 4,
    "position": 1,
    "text": "گرفت این جهان جهان را به دست"
  },
  {
    "poem_id": 1922,
    "vorder": 5,
    "position": 0,
    "text": "نخستین چنین گفت کای بخردان"
  },
  {
    "poem_id": 1922,
    "vorder": 6,
    "position": 1,
    "text": "جهان گشته و کار کرده ردان"
  },
  {
    "poem_id": 1922,
    "vorder": 7,
    "position": 0,
    "text": "همه کار بر داد و آیین کنیم"
  },
  {
    "poem_id": 1922,
    "vorder": 8,
    "position": 1,
    "text": "کزین پس همه خشت بالین کنیم"
  },
  {
    "poem_id": 1922,
    "vorder": 9,
    "position": 0,
    "text": "هر آنکس که باشد مرا دوستدار"
  },
  {
    "poem_id": 1922,
    "vorder": 10,
    "position": 1,
    "text": "چنانم مر او را چو پروردگار"
  },
  {
    "poem_id": 1922,
    "vorder": 11,
    "position": 0,
    "text": "کس کو ز پیمان من بگذرد"
  },
  {
    "poem_id": 1922,
    "vorder": 12,
    "position": 1,
    "text": "بپیچید ز آیین و راه خرد"
  },
  {
    "poem_id": 1922,
    "vorder": 13,
    "position": 0,
    "text": "به خواری تنش را برآرم بدار"
  },
  {
    "poem_id": 1922,
    "vorder": 14,
    "position": 1,
    "text": "ز دهقان و تازی و رومی شمار"
  },
  {
    "poem_id": 1922,
    "vorder": 15,
    "position": 0,
    "text": "همی‌بود بر تخت بر چار ماه"
  },
  {
    "poem_id": 1922,
    "vorder": 16,
    "position": 1,
    "text": "به پنجم شکست اندر آمد به گاه"
  },
  {
    "poem_id": 1922,
    "vorder": 17,
    "position": 0,
    "text": "از آزرم گیتی بی‌آزرم گشت"
  },
  {
    "poem_id": 1922,
    "vorder": 18,
    "position": 1,
    "text": "پی اختر رفتنش نرم گشت"
  },
  {
    "poem_id": 1922,
    "vorder": 19,
    "position": 0,
    "text": "شد اونیز و آن تخت بی‌شاه ماند"
  },
  {
    "poem_id": 1922,
    "vorder": 20,
    "position": 1,
    "text": "به کام دل مرد بدخواه ماند"
  },
  {
    "poem_id": 1922,
    "vorder": 21,
    "position": 0,
    "text": "همه کار گردنده چرخ این بود"
  },
  {
    "poem_id": 1922,
    "vorder": 22,
    "position": 1,
    "text": "ز پروردهٔ خویش پرکین بود"
  }
]