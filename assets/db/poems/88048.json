[
  {
    "poem_id": 88048,
    "vorder": 1,
    "position": 0,
    "text": "ششم بیژن گیو و رویین دمان"
  },
  {
    "poem_id": 88048,
    "vorder": 2,
    "position": 1,
    "text": "به زه برنهادند هر دو کمان"
  },
  {
    "poem_id": 88048,
    "vorder": 3,
    "position": 0,
    "text": "چپ و راست گشتند یک با دگر"
  },
  {
    "poem_id": 88048,
    "vorder": 4,
    "position": 1,
    "text": "نبد تیرشان از کمان کارگر"
  },
  {
    "poem_id": 88048,
    "vorder": 5,
    "position": 0,
    "text": "به رومی عمود آنگهی پور گیو"
  },
  {
    "poem_id": 88048,
    "vorder": 6,
    "position": 1,
    "text": "همی گشت با گرد رویین نیو"
  },
  {
    "poem_id": 88048,
    "vorder": 7,
    "position": 0,
    "text": "بر آوردگه بر بر او دست یافت"
  },
  {
    "poem_id": 88048,
    "vorder": 8,
    "position": 1,
    "text": "زمین را بدرید و اندر شتافت"
  },
  {
    "poem_id": 88048,
    "vorder": 9,
    "position": 0,
    "text": "زد از باد بر سرش رومی ستون"
  },
  {
    "poem_id": 88048,
    "vorder": 10,
    "position": 1,
    "text": "فروریخت از ترگ او مغز و خون"
  },
  {
    "poem_id": 88048,
    "vorder": 11,
    "position": 0,
    "text": "به زین پلنگ اندرون جان بداد"
  },
  {
    "poem_id": 88048,
    "vorder": 12,
    "position": 1,
    "text": "ز پیران ویسه بسی کرد یاد"
  },
  {
    "poem_id": 88048,
    "vorder": 13,
    "position": 0,
    "text": "پس از پشت باره درآمد نگون"
  },
  {
    "poem_id": 88048,
    "vorder": 14,
    "position": 1,
    "text": "همه تن پر آهن دهن پر ز خون"
  },
  {
    "poem_id": 88048,
    "vorder": 15,
    "position": 0,
    "text": "ز اسب اندر آمد سبک بیژنا"
  },
  {
    "poem_id": 88048,
    "vorder": 16,
    "position": 1,
    "text": "مر او را به کردار آهرمنا"
  },
  {
    "poem_id": 88048,
    "vorder": 17,
    "position": 0,
    "text": "کمند اندر افگند و بر زین کشید"
  },
  {
    "poem_id": 88048,
    "vorder": 18,
    "position": 1,
    "text": "نبد کس که تیمار رویین کشید"
  },
  {
    "poem_id": 88048,
    "vorder": 19,
    "position": 0,
    "text": "برفت از پی سود مایه به باد"
  },
  {
    "poem_id": 88048,
    "vorder": 20,
    "position": 1,
    "text": "هنوز از جوانیش نابوده شاد"
  },
  {
    "poem_id": 88048,
    "vorder": 21,
    "position": 0,
    "text": "بر اسبش به کردار پیلی ببست"
  },
  {
    "poem_id": 88048,
    "vorder": 22,
    "position": 1,
    "text": "گرفت آنگهی پالهنگش به دست"
  },
  {
    "poem_id": 88048,
    "vorder": 23,
    "position": 0,
    "text": "عنان هیون تگاور بتافت"
  },
  {
    "poem_id": 88048,
    "vorder": 24,
    "position": 1,
    "text": "وز آن جایگه سوی بالا شتافت"
  },
  {
    "poem_id": 88048,
    "vorder": 25,
    "position": 0,
    "text": "به چنگ اندرون شیر پیکر درفش"
  },
  {
    "poem_id": 88048,
    "vorder": 26,
    "position": 1,
    "text": "میان دیبه و رنگ خورده بنفش"
  },
  {
    "poem_id": 88048,
    "vorder": 27,
    "position": 0,
    "text": "چنینست کار جهان فریب"
  },
  {
    "poem_id": 88048,
    "vorder": 28,
    "position": 1,
    "text": "پس هر فرازی نهاده نشیب"
  },
  {
    "poem_id": 88048,
    "vorder": 29,
    "position": 0,
    "text": "وز آن جایگه شد به جای نشان"
  },
  {
    "poem_id": 88048,
    "vorder": 30,
    "position": 1,
    "text": "به نزدیک آن نامور سرکشان"
  },
  {
    "poem_id": 88048,
    "vorder": 31,
    "position": 0,
    "text": "همی گفت پیروزگر باد شاه"
  },
  {
    "poem_id": 88048,
    "vorder": 32,
    "position": 1,
    "text": "همیشه سر پهلوان با کلاه"
  },
  {
    "poem_id": 88048,
    "vorder": 33,
    "position": 0,
    "text": "جهان پیش شاه جهان بنده باد"
  },
  {
    "poem_id": 88048,
    "vorder": 34,
    "position": 1,
    "text": "همیشه دل پهلوان باد شاد"
  }
]