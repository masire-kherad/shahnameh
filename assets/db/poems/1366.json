[
  {
    "poem_id": 1366,
    "vorder": 1,
    "position": 0,
    "text": "چو تنگ اندر آمد به نزدیکشان"
  },
  {
    "poem_id": 1366,
    "vorder": 2,
    "position": 1,
    "text": "نبود آگه از رای تاریکشان"
  },
  {
    "poem_id": 1366,
    "vorder": 3,
    "position": 0,
    "text": "پذیره شدندش به آیین خویش"
  },
  {
    "poem_id": 1366,
    "vorder": 4,
    "position": 1,
    "text": "سپه سربسر باز بردند پیش"
  },
  {
    "poem_id": 1366,
    "vorder": 5,
    "position": 0,
    "text": "چو دیدند روی برادر به مهر"
  },
  {
    "poem_id": 1366,
    "vorder": 6,
    "position": 1,
    "text": "یکی تازه‌تر برگشادند چهر"
  },
  {
    "poem_id": 1366,
    "vorder": 7,
    "position": 0,
    "text": "دو پرخاشجوی با یکی نیک خوی"
  },
  {
    "poem_id": 1366,
    "vorder": 8,
    "position": 1,
    "text": "گرفتند پرسش نه بر آرزوی"
  },
  {
    "poem_id": 1366,
    "vorder": 9,
    "position": 0,
    "text": "دو دل پر ز کینه یکی دل به جای"
  },
  {
    "poem_id": 1366,
    "vorder": 10,
    "position": 1,
    "text": "برفتند هر سه به پرده سرای"
  },
  {
    "poem_id": 1366,
    "vorder": 11,
    "position": 0,
    "text": "به ایرج نگه کرد یکسر سپاه"
  },
  {
    "poem_id": 1366,
    "vorder": 12,
    "position": 1,
    "text": "که او بد سزاوار تخت و کلاه"
  },
  {
    "poem_id": 1366,
    "vorder": 13,
    "position": 0,
    "text": "بی‌آرامشان شد دل از مهر او"
  },
  {
    "poem_id": 1366,
    "vorder": 14,
    "position": 1,
    "text": "دل از مهر و دیده پر از چهر او"
  },
  {
    "poem_id": 1366,
    "vorder": 15,
    "position": 0,
    "text": "سپاه پراگنده شد جفت جفت"
  },
  {
    "poem_id": 1366,
    "vorder": 16,
    "position": 1,
    "text": "همه نام ایرج بد اندر نهفت"
  },
  {
    "poem_id": 1366,
    "vorder": 17,
    "position": 0,
    "text": "که هست این سزاوار شاهنشهی"
  },
  {
    "poem_id": 1366,
    "vorder": 18,
    "position": 1,
    "text": "جز این را نزیبد کلاه مهی"
  },
  {
    "poem_id": 1366,
    "vorder": 19,
    "position": 0,
    "text": "به لشکر نگه کرد سلم از کران"
  },
  {
    "poem_id": 1366,
    "vorder": 20,
    "position": 1,
    "text": "سرش گشت از کار لشکر گران"
  },
  {
    "poem_id": 1366,
    "vorder": 21,
    "position": 0,
    "text": "به لشگرگه آمد دلی پر ز کین"
  },
  {
    "poem_id": 1366,
    "vorder": 22,
    "position": 1,
    "text": "جگر پر ز خون ابروان پر ز چین"
  },
  {
    "poem_id": 1366,
    "vorder": 23,
    "position": 0,
    "text": "سراپرده پرداخت از انجمن"
  },
  {
    "poem_id": 1366,
    "vorder": 24,
    "position": 1,
    "text": "خود و تور بنشست با رای زن"
  },
  {
    "poem_id": 1366,
    "vorder": 25,
    "position": 0,
    "text": "سخن شد پژوهنده از هردری"
  },
  {
    "poem_id": 1366,
    "vorder": 26,
    "position": 1,
    "text": "ز شاهی و از تاج هر کشوری"
  },
  {
    "poem_id": 1366,
    "vorder": 27,
    "position": 0,
    "text": "به تور از میان سخن سلم گفت"
  },
  {
    "poem_id": 1366,
    "vorder": 28,
    "position": 1,
    "text": "که یک یک سپاه از چه گشتند جفت"
  },
  {
    "poem_id": 1366,
    "vorder": 29,
    "position": 0,
    "text": "به هنگامهٔ بازگشتن ز راه"
  },
  {
    "poem_id": 1366,
    "vorder": 30,
    "position": 1,
    "text": "نکردی همانا به لشکر نگاه"
  },
  {
    "poem_id": 1366,
    "vorder": 31,
    "position": 0,
    "text": "سپاه دو شاه از پذیره شدن"
  },
  {
    "poem_id": 1366,
    "vorder": 32,
    "position": 1,
    "text": "دگر بود و دیگر به بازآمدن"
  },
  {
    "poem_id": 1366,
    "vorder": 33,
    "position": 0,
    "text": "که چندان کجا راه بگذاشتند"
  },
  {
    "poem_id": 1366,
    "vorder": 34,
    "position": 1,
    "text": "یکی چشم از ایرج نه برداشتند"
  },
  {
    "poem_id": 1366,
    "vorder": 35,
    "position": 0,
    "text": "از ایران دلم خود به دو نیم بود"
  },
  {
    "poem_id": 1366,
    "vorder": 36,
    "position": 1,
    "text": "به اندیشه اندیشگان برفزود"
  },
  {
    "poem_id": 1366,
    "vorder": 37,
    "position": 0,
    "text": "سپاه دو کشور چو کردم نگاه"
  },
  {
    "poem_id": 1366,
    "vorder": 38,
    "position": 1,
    "text": "از این پس جز او را نخوانند شاه"
  },
  {
    "poem_id": 1366,
    "vorder": 39,
    "position": 0,
    "text": "اگر بیخ او نگسلانی ز جای"
  },
  {
    "poem_id": 1366,
    "vorder": 40,
    "position": 1,
    "text": "ز تخت بلندت کشد زیر پای"
  },
  {
    "poem_id": 1366,
    "vorder": 41,
    "position": 0,
    "text": "برین گونه از جای برخاستند"
  },
  {
    "poem_id": 1366,
    "vorder": 42,
    "position": 1,
    "text": "همه شب همی چاره آراستند"
  }
]