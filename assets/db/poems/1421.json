[
  {
    "poem_id": 1421,
    "vorder": 1,
    "position": 0,
    "text": "چنان شد ز گفتار او پهلوان"
  },
  {
    "poem_id": 1421,
    "vorder": 2,
    "position": 1,
    "text": "که گفتی برافشاند خواهد روان"
  },
  {
    "poem_id": 1421,
    "vorder": 3,
    "position": 0,
    "text": "گله هرچ بودش به زابلستان"
  },
  {
    "poem_id": 1421,
    "vorder": 4,
    "position": 1,
    "text": "بیاورد لختی به کابلستان"
  },
  {
    "poem_id": 1421,
    "vorder": 5,
    "position": 0,
    "text": "همه پیش رستم همی راندند"
  },
  {
    "poem_id": 1421,
    "vorder": 6,
    "position": 1,
    "text": "برو داغ شاهان همی خواندند"
  },
  {
    "poem_id": 1421,
    "vorder": 7,
    "position": 0,
    "text": "هر اسپی که رستم کشیدیش پیش"
  },
  {
    "poem_id": 1421,
    "vorder": 8,
    "position": 1,
    "text": "به پشتش بیفشاردی دست خویش"
  },
  {
    "poem_id": 1421,
    "vorder": 9,
    "position": 0,
    "text": "ز نیروی او پشت کردی به خم"
  },
  {
    "poem_id": 1421,
    "vorder": 10,
    "position": 1,
    "text": "نهادی به روی زمین بر شکم"
  },
  {
    "poem_id": 1421,
    "vorder": 11,
    "position": 0,
    "text": "چنین تا ز کابل بیامد زرنگ"
  },
  {
    "poem_id": 1421,
    "vorder": 12,
    "position": 1,
    "text": "فسیله همی تاخت از رنگ‌رنگ"
  },
  {
    "poem_id": 1421,
    "vorder": 13,
    "position": 0,
    "text": "یکی مادیان تیز بگذشت خنگ"
  },
  {
    "poem_id": 1421,
    "vorder": 14,
    "position": 1,
    "text": "برش چون بر شیر و کوتاه لنگ"
  },
  {
    "poem_id": 1421,
    "vorder": 15,
    "position": 0,
    "text": "دو گوشش چو دو خنجر آبدار"
  },
  {
    "poem_id": 1421,
    "vorder": 16,
    "position": 1,
    "text": "بر و یال فربه میانش نزار"
  },
  {
    "poem_id": 1421,
    "vorder": 17,
    "position": 0,
    "text": "یکی کره از پس به بالای او"
  },
  {
    "poem_id": 1421,
    "vorder": 18,
    "position": 1,
    "text": "سرین و برش هم به پهنای او"
  },
  {
    "poem_id": 1421,
    "vorder": 19,
    "position": 0,
    "text": "سیه چشم و بورابرش و گاودم"
  },
  {
    "poem_id": 1421,
    "vorder": 20,
    "position": 1,
    "text": "سیه خایه و تند و پولادسم"
  },
  {
    "poem_id": 1421,
    "vorder": 21,
    "position": 0,
    "text": "تنش پرنگار از کران تا کران"
  },
  {
    "poem_id": 1421,
    "vorder": 22,
    "position": 1,
    "text": "چو داغ گل سرخ بر زعفران"
  },
  {
    "poem_id": 1421,
    "vorder": 23,
    "position": 0,
    "text": "چو رستم بران مادیان بنگرید"
  },
  {
    "poem_id": 1421,
    "vorder": 24,
    "position": 1,
    "text": "مر آن کرهٔ پیلتن را بدید"
  },
  {
    "poem_id": 1421,
    "vorder": 25,
    "position": 0,
    "text": "کمند کیانی همی داد خم"
  },
  {
    "poem_id": 1421,
    "vorder": 26,
    "position": 1,
    "text": "که آن کره را بازگیرد ز رم"
  },
  {
    "poem_id": 1421,
    "vorder": 27,
    "position": 0,
    "text": "به رستم چنین گفت چوپان پیر"
  },
  {
    "poem_id": 1421,
    "vorder": 28,
    "position": 1,
    "text": "که ای مهتر اسپ کسان را مگیر"
  },
  {
    "poem_id": 1421,
    "vorder": 29,
    "position": 0,
    "text": "بپرسید رستم که این اسپ کیست"
  },
  {
    "poem_id": 1421,
    "vorder": 30,
    "position": 1,
    "text": "که دو رانش از داغ آتش تهیست"
  },
  {
    "poem_id": 1421,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد پاسخ که داغش مجوی"
  },
  {
    "poem_id": 1421,
    "vorder": 32,
    "position": 1,
    "text": "کزین هست هر گونه‌ای گفت‌وگوی"
  },
  {
    "poem_id": 1421,
    "vorder": 33,
    "position": 0,
    "text": "همی رخش خوانیم بورابرش است"
  },
  {
    "poem_id": 1421,
    "vorder": 34,
    "position": 1,
    "text": "به خو آتشی و به رنگ آتش است"
  },
  {
    "poem_id": 1421,
    "vorder": 35,
    "position": 0,
    "text": "خداوند این را ندانیم کس"
  },
  {
    "poem_id": 1421,
    "vorder": 36,
    "position": 1,
    "text": "همی رخش رستمش خوانیم و بس"
  },
  {
    "poem_id": 1421,
    "vorder": 37,
    "position": 0,
    "text": "سه سالست تا این بزین آمدست"
  },
  {
    "poem_id": 1421,
    "vorder": 38,
    "position": 1,
    "text": "به چشم بزرگان گزین آمدست"
  },
  {
    "poem_id": 1421,
    "vorder": 39,
    "position": 0,
    "text": "چو مادرش بیند کمند سوار"
  },
  {
    "poem_id": 1421,
    "vorder": 40,
    "position": 1,
    "text": "چو شیر اندرآید کند کارزار"
  },
  {
    "poem_id": 1421,
    "vorder": 41,
    "position": 0,
    "text": "بینداخت رستم کیانی کمند"
  },
  {
    "poem_id": 1421,
    "vorder": 42,
    "position": 1,
    "text": "سر ابرش آورد ناگه ببند"
  },
  {
    "poem_id": 1421,
    "vorder": 43,
    "position": 0,
    "text": "بیامد چو شیر ژیان مادرش"
  },
  {
    "poem_id": 1421,
    "vorder": 44,
    "position": 1,
    "text": "همی خواست کندن به دندان سرش"
  },
  {
    "poem_id": 1421,
    "vorder": 45,
    "position": 0,
    "text": "بغرید رستم چو شیر ژیان"
  },
  {
    "poem_id": 1421,
    "vorder": 46,
    "position": 1,
    "text": "از آواز او خیره شد مادیان"
  },
  {
    "poem_id": 1421,
    "vorder": 47,
    "position": 0,
    "text": "یکی مشت زد نیز بر گردنش"
  },
  {
    "poem_id": 1421,
    "vorder": 48,
    "position": 1,
    "text": "کزان مشت برگشت لرزان تنش"
  },
  {
    "poem_id": 1421,
    "vorder": 49,
    "position": 0,
    "text": "بیفتاد و برخاست و برگشت از وی"
  },
  {
    "poem_id": 1421,
    "vorder": 50,
    "position": 1,
    "text": "بسوی گله تیز بنهاد روی"
  },
  {
    "poem_id": 1421,
    "vorder": 51,
    "position": 0,
    "text": "بیفشارد ران رستم زورمند"
  },
  {
    "poem_id": 1421,
    "vorder": 52,
    "position": 1,
    "text": "برو تنگتر کرد خم کمند"
  },
  {
    "poem_id": 1421,
    "vorder": 53,
    "position": 0,
    "text": "بیازید چنگال گردی بزور"
  },
  {
    "poem_id": 1421,
    "vorder": 54,
    "position": 1,
    "text": "بیفشارد یک دست بر پشت بور"
  },
  {
    "poem_id": 1421,
    "vorder": 55,
    "position": 0,
    "text": "نکرد ایچ پشت از فشردن تهی"
  },
  {
    "poem_id": 1421,
    "vorder": 56,
    "position": 1,
    "text": "تو گفتی ندارد همی آگهی"
  },
  {
    "poem_id": 1421,
    "vorder": 57,
    "position": 0,
    "text": "بدل گفت کاین برنشست منست"
  },
  {
    "poem_id": 1421,
    "vorder": 58,
    "position": 1,
    "text": "کنون کار کردن به دست منست"
  },
  {
    "poem_id": 1421,
    "vorder": 59,
    "position": 0,
    "text": "ز چوپان بپرسید کاین اژدها"
  },
  {
    "poem_id": 1421,
    "vorder": 60,
    "position": 1,
    "text": "به چندست و این را که خواهد بها"
  },
  {
    "poem_id": 1421,
    "vorder": 61,
    "position": 0,
    "text": "چنین داد پاسخ که گر رستمی"
  },
  {
    "poem_id": 1421,
    "vorder": 62,
    "position": 1,
    "text": "برو راست کن روی ایران زمی"
  },
  {
    "poem_id": 1421,
    "vorder": 63,
    "position": 0,
    "text": "مر این را بر و بوم ایران بهاست"
  },
  {
    "poem_id": 1421,
    "vorder": 64,
    "position": 1,
    "text": "بدین بر تو خواهی جهان کرد راست"
  },
  {
    "poem_id": 1421,
    "vorder": 65,
    "position": 0,
    "text": "لب رستم از خنده شد چون بسد"
  },
  {
    "poem_id": 1421,
    "vorder": 66,
    "position": 1,
    "text": "همی گفت نیکی ز یزدان سزد"
  },
  {
    "poem_id": 1421,
    "vorder": 67,
    "position": 0,
    "text": "به زین اندر آورد گلرنگ را"
  },
  {
    "poem_id": 1421,
    "vorder": 68,
    "position": 1,
    "text": "سرش تیز شد کینه و جنگ را"
  },
  {
    "poem_id": 1421,
    "vorder": 69,
    "position": 0,
    "text": "گشاده زنخ دیدش و تیزتگ"
  },
  {
    "poem_id": 1421,
    "vorder": 70,
    "position": 1,
    "text": "بدیدش که دارد دل و تاو و رگ"
  },
  {
    "poem_id": 1421,
    "vorder": 71,
    "position": 0,
    "text": "کشد جوشن و خود و کوپال او"
  },
  {
    "poem_id": 1421,
    "vorder": 72,
    "position": 1,
    "text": "تن پیلوار و بر و یال او"
  },
  {
    "poem_id": 1421,
    "vorder": 73,
    "position": 0,
    "text": "چنان گشت ابرش که هر شب سپند"
  },
  {
    "poem_id": 1421,
    "vorder": 74,
    "position": 1,
    "text": "همی سوختندش ز بیم گزند"
  },
  {
    "poem_id": 1421,
    "vorder": 75,
    "position": 0,
    "text": "چپ و راست گفتی که جادو شدست"
  },
  {
    "poem_id": 1421,
    "vorder": 76,
    "position": 1,
    "text": "به آورد تا زنده آهو شدست"
  },
  {
    "poem_id": 1421,
    "vorder": 77,
    "position": 0,
    "text": "دل زال زر شد چو خرم بهار"
  },
  {
    "poem_id": 1421,
    "vorder": 78,
    "position": 1,
    "text": "ز رخش نوآیین و فرخ سوار"
  },
  {
    "poem_id": 1421,
    "vorder": 79,
    "position": 0,
    "text": "در گنج بگشاد و دینار داد"
  },
  {
    "poem_id": 1421,
    "vorder": 80,
    "position": 1,
    "text": "از امروز و فردا نیامدش یاد"
  }
]