[
  {
    "poem_id": 1331,
    "vorder": 1,
    "position": 0,
    "text": "بدین نامه چون دست کردم دراز"
  },
  {
    "poem_id": 1331,
    "vorder": 2,
    "position": 1,
    "text": "یکی مهتری بود گردن‌فراز"
  },
  {
    "poem_id": 1331,
    "vorder": 3,
    "position": 0,
    "text": "جوان بود و از گوهر پهلوان"
  },
  {
    "poem_id": 1331,
    "vorder": 4,
    "position": 1,
    "text": "خردمند و بیدار و روشن روان"
  },
  {
    "poem_id": 1331,
    "vorder": 5,
    "position": 0,
    "text": "خداوند رای و خداوند شرم"
  },
  {
    "poem_id": 1331,
    "vorder": 6,
    "position": 1,
    "text": "سخن گفتن خوب و آوای نرم"
  },
  {
    "poem_id": 1331,
    "vorder": 7,
    "position": 0,
    "text": "مرا گفت کز من چه باید همی"
  },
  {
    "poem_id": 1331,
    "vorder": 8,
    "position": 1,
    "text": "که جانت سخن برگراید همی"
  },
  {
    "poem_id": 1331,
    "vorder": 9,
    "position": 0,
    "text": "به چیزی که باشد مرا دسترس"
  },
  {
    "poem_id": 1331,
    "vorder": 10,
    "position": 1,
    "text": "بکوشم نیازت نیارم به کس"
  },
  {
    "poem_id": 1331,
    "vorder": 11,
    "position": 0,
    "text": "همی داشتم چون یکی تازه سیب"
  },
  {
    "poem_id": 1331,
    "vorder": 12,
    "position": 1,
    "text": "که از باد نامد به من بر نهیب"
  },
  {
    "poem_id": 1331,
    "vorder": 13,
    "position": 0,
    "text": "به کیوان رسیدم ز خاک نژند"
  },
  {
    "poem_id": 1331,
    "vorder": 14,
    "position": 1,
    "text": "از آن نیک‌دل نامدار ارجمند"
  },
  {
    "poem_id": 1331,
    "vorder": 15,
    "position": 0,
    "text": "به چشمش همان خاک و هم سیم و زر"
  },
  {
    "poem_id": 1331,
    "vorder": 16,
    "position": 1,
    "text": "کریمی بدو یافته زیب و فر"
  },
  {
    "poem_id": 1331,
    "vorder": 17,
    "position": 0,
    "text": "سراسر جهان پیش او خوار بود"
  },
  {
    "poem_id": 1331,
    "vorder": 18,
    "position": 1,
    "text": "جوانمرد بود و وفادار بود"
  },
  {
    "poem_id": 1331,
    "vorder": 19,
    "position": 0,
    "text": "چنان نامور گم شد از انجمن"
  },
  {
    "poem_id": 1331,
    "vorder": 20,
    "position": 1,
    "text": "چو در باغ سرو سهی از چمن"
  },
  {
    "poem_id": 1331,
    "vorder": 21,
    "position": 0,
    "text": "نه ز او زنده بینم نه مرده نشان"
  },
  {
    "poem_id": 1331,
    "vorder": 22,
    "position": 1,
    "text": "به دست نهنگان مردم کشان"
  },
  {
    "poem_id": 1331,
    "vorder": 23,
    "position": 0,
    "text": "دریغ آن کمربند و آن گِردگاه"
  },
  {
    "poem_id": 1331,
    "vorder": 24,
    "position": 1,
    "text": "دریغ آن کِیی برز و بالای شاه"
  },
  {
    "poem_id": 1331,
    "vorder": 25,
    "position": 0,
    "text": "گرفتار ز او دل شده نا‌امید"
  },
  {
    "poem_id": 1331,
    "vorder": 26,
    "position": 1,
    "text": "نوان لرز لرزان به کردار بید"
  },
  {
    "poem_id": 1331,
    "vorder": 27,
    "position": 0,
    "text": "یکی پند آن شاه یاد آوریم"
  },
  {
    "poem_id": 1331,
    "vorder": 28,
    "position": 1,
    "text": "ز کژی روان سوی داد آوریم"
  },
  {
    "poem_id": 1331,
    "vorder": 29,
    "position": 0,
    "text": "مرا گفت کاین نامهٔ شهریار"
  },
  {
    "poem_id": 1331,
    "vorder": 30,
    "position": 1,
    "text": "گرت گفته آید به شاهان سپار"
  },
  {
    "poem_id": 1331,
    "vorder": 31,
    "position": 0,
    "text": "بدین نامه من دست بردم فراز"
  },
  {
    "poem_id": 1331,
    "vorder": 32,
    "position": 1,
    "text": "به نام شهنشاه گردن‌فراز"
  }
]