[
  {
    "poem_id": 1592,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت رستم به اسفندیار"
  },
  {
    "poem_id": 1592,
    "vorder": 2,
    "position": 1,
    "text": "که کردار ماند ز ما یادگار"
  },
  {
    "poem_id": 1592,
    "vorder": 3,
    "position": 0,
    "text": "کنون داد ده باش و بشنو سخن"
  },
  {
    "poem_id": 1592,
    "vorder": 4,
    "position": 1,
    "text": "ازین نامبردار مرد کهن"
  },
  {
    "poem_id": 1592,
    "vorder": 5,
    "position": 0,
    "text": "اگر من نرفتی به مازندران"
  },
  {
    "poem_id": 1592,
    "vorder": 6,
    "position": 1,
    "text": "به گردن برآورده گرز گران"
  },
  {
    "poem_id": 1592,
    "vorder": 7,
    "position": 0,
    "text": "کجا بسته بد گیو و کاوس و طوس"
  },
  {
    "poem_id": 1592,
    "vorder": 8,
    "position": 1,
    "text": "شده گوش کر یکسر از بانگ کوس"
  },
  {
    "poem_id": 1592,
    "vorder": 9,
    "position": 0,
    "text": "که کندی دل و مغز دیو سپید"
  },
  {
    "poem_id": 1592,
    "vorder": 10,
    "position": 1,
    "text": "که دارد به بازوی خویش این امید"
  },
  {
    "poem_id": 1592,
    "vorder": 11,
    "position": 0,
    "text": "سر جادوان را بکندم ز تن"
  },
  {
    "poem_id": 1592,
    "vorder": 12,
    "position": 1,
    "text": "ستودان ندیدند و گور و کفن"
  },
  {
    "poem_id": 1592,
    "vorder": 13,
    "position": 0,
    "text": "ز بند گران بردمش سوی تخت"
  },
  {
    "poem_id": 1592,
    "vorder": 14,
    "position": 1,
    "text": "شد ایران بدو شاد و او نیکبخت"
  },
  {
    "poem_id": 1592,
    "vorder": 15,
    "position": 0,
    "text": "مرا یار در هفتخوان رخش بود"
  },
  {
    "poem_id": 1592,
    "vorder": 16,
    "position": 1,
    "text": "که شمشیر تیزم جهان‌بخش بود"
  },
  {
    "poem_id": 1592,
    "vorder": 17,
    "position": 0,
    "text": "وزان پس که شد سوی هاماوران"
  },
  {
    "poem_id": 1592,
    "vorder": 18,
    "position": 1,
    "text": "ببستند پایش به بند گران"
  },
  {
    "poem_id": 1592,
    "vorder": 19,
    "position": 0,
    "text": "ببردم ز ایرانیان لشکری"
  },
  {
    "poem_id": 1592,
    "vorder": 20,
    "position": 1,
    "text": "به جایی که بد مهتری گر سری"
  },
  {
    "poem_id": 1592,
    "vorder": 21,
    "position": 0,
    "text": "بکشتم به جنگ اندرون شاهشان"
  },
  {
    "poem_id": 1592,
    "vorder": 22,
    "position": 1,
    "text": "تهی کردم آن نامور گاهشان"
  },
  {
    "poem_id": 1592,
    "vorder": 23,
    "position": 0,
    "text": "جهاندار کاوس کی بسته بود"
  },
  {
    "poem_id": 1592,
    "vorder": 24,
    "position": 1,
    "text": "ز رنج و ز تیمار دل خسته بود"
  },
  {
    "poem_id": 1592,
    "vorder": 25,
    "position": 0,
    "text": "بیاوردم از بند کاوس را"
  },
  {
    "poem_id": 1592,
    "vorder": 26,
    "position": 1,
    "text": "همان گیو و گودرز و هم طوس را"
  },
  {
    "poem_id": 1592,
    "vorder": 27,
    "position": 0,
    "text": "به ایران بد افراسیاب آن زمان"
  },
  {
    "poem_id": 1592,
    "vorder": 28,
    "position": 1,
    "text": "جهان پر ز درد از بد بدگمان"
  },
  {
    "poem_id": 1592,
    "vorder": 29,
    "position": 0,
    "text": "به ایران کشیدم ز هاماوران"
  },
  {
    "poem_id": 1592,
    "vorder": 30,
    "position": 1,
    "text": "خود و شاه با لشکری بی‌کران"
  },
  {
    "poem_id": 1592,
    "vorder": 31,
    "position": 0,
    "text": "شب تیره تنها برفتم ز پیش"
  },
  {
    "poem_id": 1592,
    "vorder": 32,
    "position": 1,
    "text": "همه نام جستم نه آرام خویش"
  },
  {
    "poem_id": 1592,
    "vorder": 33,
    "position": 0,
    "text": "چو دید آن درفشان درفش مرا"
  },
  {
    "poem_id": 1592,
    "vorder": 34,
    "position": 1,
    "text": "به گوش آمدش بانگ رخش مرا"
  },
  {
    "poem_id": 1592,
    "vorder": 35,
    "position": 0,
    "text": "بپردخت ایران و شد سوی چین"
  },
  {
    "poem_id": 1592,
    "vorder": 36,
    "position": 1,
    "text": "جهان شد پر از داد و پر آفرین"
  },
  {
    "poem_id": 1592,
    "vorder": 37,
    "position": 0,
    "text": "گر از یال کاوس خون آمدی"
  },
  {
    "poem_id": 1592,
    "vorder": 38,
    "position": 1,
    "text": "ز پشتش سیاوش چون آمدی"
  },
  {
    "poem_id": 1592,
    "vorder": 39,
    "position": 0,
    "text": "وزو شاه کیخسرو پاک و راد"
  },
  {
    "poem_id": 1592,
    "vorder": 40,
    "position": 1,
    "text": "که لهراسپ را تاج بر سر نهاد"
  },
  {
    "poem_id": 1592,
    "vorder": 41,
    "position": 0,
    "text": "پدرم آن دلیر گرانمایه مرد"
  },
  {
    "poem_id": 1592,
    "vorder": 42,
    "position": 1,
    "text": "ز ننگ اندران انجمن خاک خورد"
  },
  {
    "poem_id": 1592,
    "vorder": 43,
    "position": 0,
    "text": "که لهراسپ را شاه بایست خواند"
  },
  {
    "poem_id": 1592,
    "vorder": 44,
    "position": 1,
    "text": "ازو در جهان نام چندین نماند"
  },
  {
    "poem_id": 1592,
    "vorder": 45,
    "position": 0,
    "text": "چه نازی بدین تاج گشتاسپی"
  },
  {
    "poem_id": 1592,
    "vorder": 46,
    "position": 1,
    "text": "بدین تازه آیین لهراسپی"
  },
  {
    "poem_id": 1592,
    "vorder": 47,
    "position": 0,
    "text": "که گوید برو دست رستم ببند"
  },
  {
    "poem_id": 1592,
    "vorder": 48,
    "position": 1,
    "text": "نبندد مرا دست چرخ بلند"
  },
  {
    "poem_id": 1592,
    "vorder": 49,
    "position": 0,
    "text": "که گر چرخ گوید مراکاین نیوش"
  },
  {
    "poem_id": 1592,
    "vorder": 50,
    "position": 1,
    "text": "به گرز گرانش بمالم دو گوش"
  },
  {
    "poem_id": 1592,
    "vorder": 51,
    "position": 0,
    "text": "من از کودکی تا شدستم کهن"
  },
  {
    "poem_id": 1592,
    "vorder": 52,
    "position": 1,
    "text": "بدین گونه از کس نبردم سخن"
  },
  {
    "poem_id": 1592,
    "vorder": 53,
    "position": 0,
    "text": "مرا خواری از پوزش و خواهش است"
  },
  {
    "poem_id": 1592,
    "vorder": 54,
    "position": 1,
    "text": "وزین نرم گفتن مرا کاهش است"
  },
  {
    "poem_id": 1592,
    "vorder": 55,
    "position": 0,
    "text": "ز تیزیش خندان شد اسفندیار"
  },
  {
    "poem_id": 1592,
    "vorder": 56,
    "position": 1,
    "text": "بیازید و دستش گرفت استوار"
  },
  {
    "poem_id": 1592,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت کای رستم پیلتن"
  },
  {
    "poem_id": 1592,
    "vorder": 58,
    "position": 1,
    "text": "چنانی که بشنیدم از انجمن"
  },
  {
    "poem_id": 1592,
    "vorder": 59,
    "position": 0,
    "text": "ستبرست بازوت چون ران شیر"
  },
  {
    "poem_id": 1592,
    "vorder": 60,
    "position": 1,
    "text": "برو یال چون اژدهای دلیر"
  },
  {
    "poem_id": 1592,
    "vorder": 61,
    "position": 0,
    "text": "میان تنگ و باریک همچون پلنگ"
  },
  {
    "poem_id": 1592,
    "vorder": 62,
    "position": 1,
    "text": "به ویژه کجا گرز گیرد به چنگ"
  },
  {
    "poem_id": 1592,
    "vorder": 63,
    "position": 0,
    "text": "بیفشارد چنگش میان سخن"
  },
  {
    "poem_id": 1592,
    "vorder": 64,
    "position": 1,
    "text": "ز برنا بخندید مرد کهن"
  },
  {
    "poem_id": 1592,
    "vorder": 65,
    "position": 0,
    "text": "ز ناخن فرو ریختش آب زرد"
  },
  {
    "poem_id": 1592,
    "vorder": 66,
    "position": 1,
    "text": "همانا نجنبید زان‌درد مرد"
  },
  {
    "poem_id": 1592,
    "vorder": 67,
    "position": 0,
    "text": "گرفت آن زمان دست مهتر به دست"
  },
  {
    "poem_id": 1592,
    "vorder": 68,
    "position": 1,
    "text": "چنین گفت کای شاه یزدان‌پرست"
  },
  {
    "poem_id": 1592,
    "vorder": 69,
    "position": 0,
    "text": "خنک شاه گشتاسپ آن نامدار"
  },
  {
    "poem_id": 1592,
    "vorder": 70,
    "position": 1,
    "text": "کجا پور دارد چو اسفندیار"
  },
  {
    "poem_id": 1592,
    "vorder": 71,
    "position": 0,
    "text": "خنک آنک چون تو پسر زاید او"
  },
  {
    "poem_id": 1592,
    "vorder": 72,
    "position": 1,
    "text": "همی فر گیتی بیفزاید او"
  },
  {
    "poem_id": 1592,
    "vorder": 73,
    "position": 0,
    "text": "همی گفت و چنگش به چنگ اندرون"
  },
  {
    "poem_id": 1592,
    "vorder": 74,
    "position": 1,
    "text": "همی داشت تا چهر او شد چو خون"
  },
  {
    "poem_id": 1592,
    "vorder": 75,
    "position": 0,
    "text": "همان ناخنش پر ز خوناب کرد"
  },
  {
    "poem_id": 1592,
    "vorder": 76,
    "position": 1,
    "text": "سپهبد بروها پر از تاب کرد"
  },
  {
    "poem_id": 1592,
    "vorder": 77,
    "position": 0,
    "text": "بخندید ازو فرخ اسفندیار"
  },
  {
    "poem_id": 1592,
    "vorder": 78,
    "position": 1,
    "text": "چنین گفت کای رستم نامدار"
  },
  {
    "poem_id": 1592,
    "vorder": 79,
    "position": 0,
    "text": "تو امروز می خور که فردا به رزم"
  },
  {
    "poem_id": 1592,
    "vorder": 80,
    "position": 1,
    "text": "بپیچی و یادت نیاید ز بزم"
  },
  {
    "poem_id": 1592,
    "vorder": 81,
    "position": 0,
    "text": "چو من زین زرین نهم بر سپاه"
  },
  {
    "poem_id": 1592,
    "vorder": 82,
    "position": 1,
    "text": "به سر بر نهم خسروانی کلاه"
  },
  {
    "poem_id": 1592,
    "vorder": 83,
    "position": 0,
    "text": "به نیزه ز اسپت نهم بر زمین"
  },
  {
    "poem_id": 1592,
    "vorder": 84,
    "position": 1,
    "text": "ازان پس نه پرخاش جویی نه کین"
  },
  {
    "poem_id": 1592,
    "vorder": 85,
    "position": 0,
    "text": "دو دستت ببندم برم نزد شاه"
  },
  {
    "poem_id": 1592,
    "vorder": 86,
    "position": 1,
    "text": "بگویم که من زو ندیدم گناه"
  },
  {
    "poem_id": 1592,
    "vorder": 87,
    "position": 0,
    "text": "بباشیم پیشش به خواهشگری"
  },
  {
    "poem_id": 1592,
    "vorder": 88,
    "position": 1,
    "text": "بسازیم هرگونه‌ای داوری"
  },
  {
    "poem_id": 1592,
    "vorder": 89,
    "position": 0,
    "text": "رهانم ترا از غم و درد و رنج"
  },
  {
    "poem_id": 1592,
    "vorder": 90,
    "position": 1,
    "text": "بیابی پس از رنج خوبی و گنج"
  },
  {
    "poem_id": 1592,
    "vorder": 91,
    "position": 0,
    "text": "بخندید رستم ز اسفندیار"
  },
  {
    "poem_id": 1592,
    "vorder": 92,
    "position": 1,
    "text": "بدو گفت سیر آیی از کارزار"
  },
  {
    "poem_id": 1592,
    "vorder": 93,
    "position": 0,
    "text": "کجا دیده‌ای رزم جنگاوران"
  },
  {
    "poem_id": 1592,
    "vorder": 94,
    "position": 1,
    "text": "کجا یافتی باد گرز گران"
  },
  {
    "poem_id": 1592,
    "vorder": 95,
    "position": 0,
    "text": "اگر بر جزین روی گردد سپهر"
  },
  {
    "poem_id": 1592,
    "vorder": 96,
    "position": 1,
    "text": "بپوشید میان دو تن روی مهر"
  },
  {
    "poem_id": 1592,
    "vorder": 97,
    "position": 0,
    "text": "به جای می سرخ کین آوریم"
  },
  {
    "poem_id": 1592,
    "vorder": 98,
    "position": 1,
    "text": "کمند نبرد و کمین آوریم"
  },
  {
    "poem_id": 1592,
    "vorder": 99,
    "position": 0,
    "text": "غو کوس خواهیم از آوای رود"
  },
  {
    "poem_id": 1592,
    "vorder": 100,
    "position": 1,
    "text": "به تیغ و به گوپال باشد درود"
  },
  {
    "poem_id": 1592,
    "vorder": 101,
    "position": 0,
    "text": "ببینی تو ای فرخ اسفندیار"
  },
  {
    "poem_id": 1592,
    "vorder": 102,
    "position": 1,
    "text": "گراییدن و گردش کارزار"
  },
  {
    "poem_id": 1592,
    "vorder": 103,
    "position": 0,
    "text": "چو فردا بیایی به دشت نبرد"
  },
  {
    "poem_id": 1592,
    "vorder": 104,
    "position": 1,
    "text": "به آورد مرد اندر آید به مرد"
  },
  {
    "poem_id": 1592,
    "vorder": 105,
    "position": 0,
    "text": "ز باره به آغوش بردارمت"
  },
  {
    "poem_id": 1592,
    "vorder": 106,
    "position": 1,
    "text": "ز میدان به نزدیک زال آرمت"
  },
  {
    "poem_id": 1592,
    "vorder": 107,
    "position": 0,
    "text": "نشانمت بر نامور تخت عاج"
  },
  {
    "poem_id": 1592,
    "vorder": 108,
    "position": 1,
    "text": "نهم بر سرت بر دل‌افروز تاج"
  },
  {
    "poem_id": 1592,
    "vorder": 109,
    "position": 0,
    "text": "کجا یافتستم من از کیقباد"
  },
  {
    "poem_id": 1592,
    "vorder": 110,
    "position": 1,
    "text": "به مینو همی جان او باد شاد"
  },
  {
    "poem_id": 1592,
    "vorder": 111,
    "position": 0,
    "text": "گشایم در گنج و هر خواسته"
  },
  {
    "poem_id": 1592,
    "vorder": 112,
    "position": 1,
    "text": "نهم پیش تو یکسر آراسته"
  },
  {
    "poem_id": 1592,
    "vorder": 113,
    "position": 0,
    "text": "دهم بی‌نیازی سپاه ترا"
  },
  {
    "poem_id": 1592,
    "vorder": 114,
    "position": 1,
    "text": "به چرخ اندر آرم کلاه ترا"
  },
  {
    "poem_id": 1592,
    "vorder": 115,
    "position": 0,
    "text": "ازان پس بیابم به نزدیک شاه"
  },
  {
    "poem_id": 1592,
    "vorder": 116,
    "position": 1,
    "text": "گرازان و خندان و خرم به راه"
  },
  {
    "poem_id": 1592,
    "vorder": 117,
    "position": 0,
    "text": "به مردی ترا تاج بر سر نهم"
  },
  {
    "poem_id": 1592,
    "vorder": 118,
    "position": 1,
    "text": "سپاسی به گشتاسپ زین بر نهم"
  },
  {
    "poem_id": 1592,
    "vorder": 119,
    "position": 0,
    "text": "ازان پس ببندم کمر بر میان"
  },
  {
    "poem_id": 1592,
    "vorder": 120,
    "position": 1,
    "text": "چنانچون ببستم به پیش کیان"
  },
  {
    "poem_id": 1592,
    "vorder": 121,
    "position": 0,
    "text": "همه روی پالیز بی خو کنم"
  },
  {
    "poem_id": 1592,
    "vorder": 122,
    "position": 1,
    "text": "ز شادی تن خویش را نو کنم"
  },
  {
    "poem_id": 1592,
    "vorder": 123,
    "position": 0,
    "text": "چو تو شاه باشی و من پهلوان"
  },
  {
    "poem_id": 1592,
    "vorder": 124,
    "position": 1,
    "text": "کسی را به تن در نباشد روان"
  }
]