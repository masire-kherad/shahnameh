[
  {
    "poem_id": 1676,
    "vorder": 1,
    "position": 0,
    "text": "همی رفت یک ماه پویان به راه"
  },
  {
    "poem_id": 1676,
    "vorder": 2,
    "position": 1,
    "text": "به رنج اندر از راه شاه و سپاه"
  },
  {
    "poem_id": 1676,
    "vorder": 3,
    "position": 0,
    "text": "چنین تا به نزدیک کوهی رسید"
  },
  {
    "poem_id": 1676,
    "vorder": 4,
    "position": 1,
    "text": "که جایی دد و دام و ماهی ندید"
  },
  {
    "poem_id": 1676,
    "vorder": 5,
    "position": 0,
    "text": "یکی کوه دید از برش لاژورد"
  },
  {
    "poem_id": 1676,
    "vorder": 6,
    "position": 1,
    "text": "یکی خانه بر سر ز یاقوت زرد"
  },
  {
    "poem_id": 1676,
    "vorder": 7,
    "position": 0,
    "text": "همه خانه قندیلهای بلور"
  },
  {
    "poem_id": 1676,
    "vorder": 8,
    "position": 1,
    "text": "میان اندرون چشمهٔ آب شور"
  },
  {
    "poem_id": 1676,
    "vorder": 9,
    "position": 0,
    "text": "نهاده بر چشمه زرین دو تخت"
  },
  {
    "poem_id": 1676,
    "vorder": 10,
    "position": 1,
    "text": "برو خوابنیده یکی شوربخت"
  },
  {
    "poem_id": 1676,
    "vorder": 11,
    "position": 0,
    "text": "به تن مردم و سر چو آن گراز"
  },
  {
    "poem_id": 1676,
    "vorder": 12,
    "position": 1,
    "text": "به بیچارگی مرده بر تخت ناز"
  },
  {
    "poem_id": 1676,
    "vorder": 13,
    "position": 0,
    "text": "ز کافور زیراندرش بستری"
  },
  {
    "poem_id": 1676,
    "vorder": 14,
    "position": 1,
    "text": "کشیده ز دیبا برو چادری"
  },
  {
    "poem_id": 1676,
    "vorder": 15,
    "position": 0,
    "text": "یکی سرخ گوهر به جای چراغ"
  },
  {
    "poem_id": 1676,
    "vorder": 16,
    "position": 1,
    "text": "فروزان شده زو همه بوم و راغ"
  },
  {
    "poem_id": 1676,
    "vorder": 17,
    "position": 0,
    "text": "فتاده فروغ ستاره در آب"
  },
  {
    "poem_id": 1676,
    "vorder": 18,
    "position": 1,
    "text": "ز گوهر همه خانه چون آفتاب"
  },
  {
    "poem_id": 1676,
    "vorder": 19,
    "position": 0,
    "text": "هرانکس که رفتی که چیزی برد"
  },
  {
    "poem_id": 1676,
    "vorder": 20,
    "position": 1,
    "text": "وگر خاک آن خانه را بسپرد"
  },
  {
    "poem_id": 1676,
    "vorder": 21,
    "position": 0,
    "text": "همه تنش بر جای لرزان شدی"
  },
  {
    "poem_id": 1676,
    "vorder": 22,
    "position": 1,
    "text": "وزان لرزه آن زنده ریزان شدی"
  },
  {
    "poem_id": 1676,
    "vorder": 23,
    "position": 0,
    "text": "خروش آمد از چشمهٔ آب شور"
  },
  {
    "poem_id": 1676,
    "vorder": 24,
    "position": 1,
    "text": "که ای آرزومند چندین مشور"
  },
  {
    "poem_id": 1676,
    "vorder": 25,
    "position": 0,
    "text": "بسی چیز دیدی که آن کس ندید"
  },
  {
    "poem_id": 1676,
    "vorder": 26,
    "position": 1,
    "text": "عنان را کنون باز باید کشید"
  },
  {
    "poem_id": 1676,
    "vorder": 27,
    "position": 0,
    "text": "کنون زندگانیت کوتاه گشت"
  },
  {
    "poem_id": 1676,
    "vorder": 28,
    "position": 1,
    "text": "سر تخت شاهیت بی‌شاه گشت"
  },
  {
    "poem_id": 1676,
    "vorder": 29,
    "position": 0,
    "text": "سکندر بترسید و برگشت زود"
  },
  {
    "poem_id": 1676,
    "vorder": 30,
    "position": 1,
    "text": "به لشکرگه آمد به کردار دود"
  },
  {
    "poem_id": 1676,
    "vorder": 31,
    "position": 0,
    "text": "وزان جایگه تیز لشکر براند"
  },
  {
    "poem_id": 1676,
    "vorder": 32,
    "position": 1,
    "text": "خروشان بسی نام یزدان بخواند"
  },
  {
    "poem_id": 1676,
    "vorder": 33,
    "position": 0,
    "text": "ازان کوه راه بیابان گرفت"
  },
  {
    "poem_id": 1676,
    "vorder": 34,
    "position": 1,
    "text": "غمی گشت و اندیشهٔ جان گرفت"
  },
  {
    "poem_id": 1676,
    "vorder": 35,
    "position": 0,
    "text": "همی راند پر درد و گریان ز جای"
  },
  {
    "poem_id": 1676,
    "vorder": 36,
    "position": 1,
    "text": "سپاه از پس و پیش او رهنمای"
  }
]