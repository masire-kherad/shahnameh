[
  {
    "poem_id": 1439,
    "vorder": 1,
    "position": 0,
    "text": "یکی مغفری خسروی بر سرش"
  },
  {
    "poem_id": 1439,
    "vorder": 2,
    "position": 1,
    "text": "خوی آلوده ببر بیان در برش"
  },
  {
    "poem_id": 1439,
    "vorder": 3,
    "position": 0,
    "text": "به ارژنگ سالار بنهاد روی"
  },
  {
    "poem_id": 1439,
    "vorder": 4,
    "position": 1,
    "text": "چو آمد بر لشکر نامجوی"
  },
  {
    "poem_id": 1439,
    "vorder": 5,
    "position": 0,
    "text": "یکی نعره زد در میان گروه"
  },
  {
    "poem_id": 1439,
    "vorder": 6,
    "position": 1,
    "text": "تو گفتی بدرید دریا و کوه"
  },
  {
    "poem_id": 1439,
    "vorder": 7,
    "position": 0,
    "text": "برون آمد از خیمه ارژنگ دیو"
  },
  {
    "poem_id": 1439,
    "vorder": 8,
    "position": 1,
    "text": "چو آمد به گوش اندرش آن غریو"
  },
  {
    "poem_id": 1439,
    "vorder": 9,
    "position": 0,
    "text": "چو رستم بدیدش برانگیخت اسپ"
  },
  {
    "poem_id": 1439,
    "vorder": 10,
    "position": 1,
    "text": "بیامد بر وی چو آذر گشسپ"
  },
  {
    "poem_id": 1439,
    "vorder": 11,
    "position": 0,
    "text": "سر و گوش بگرفت و یالش دلیر"
  },
  {
    "poem_id": 1439,
    "vorder": 12,
    "position": 1,
    "text": "سر از تن بکندش به کردار شیر"
  },
  {
    "poem_id": 1439,
    "vorder": 13,
    "position": 0,
    "text": "پر از خون سر دیو کنده ز تن"
  },
  {
    "poem_id": 1439,
    "vorder": 14,
    "position": 1,
    "text": "بینداخت ز آنسو که بود انجمن"
  },
  {
    "poem_id": 1439,
    "vorder": 15,
    "position": 0,
    "text": "چو دیوان بدیدند گوپال اوی"
  },
  {
    "poem_id": 1439,
    "vorder": 16,
    "position": 1,
    "text": "بدریدشان دل ز چنگال اوی"
  },
  {
    "poem_id": 1439,
    "vorder": 17,
    "position": 0,
    "text": "نکردند یاد بر و بوم و رست"
  },
  {
    "poem_id": 1439,
    "vorder": 18,
    "position": 1,
    "text": "پدر بر پسر بر همی راه جست"
  },
  {
    "poem_id": 1439,
    "vorder": 19,
    "position": 0,
    "text": "برآهیخت شمشیر کین پیلتن"
  },
  {
    "poem_id": 1439,
    "vorder": 20,
    "position": 1,
    "text": "بپردخت یکباره زان انجمن"
  },
  {
    "poem_id": 1439,
    "vorder": 21,
    "position": 0,
    "text": "چو برگشت پیروز گیتی‌فروز"
  },
  {
    "poem_id": 1439,
    "vorder": 22,
    "position": 1,
    "text": "بیامد دمان تا به کوه اسپروز"
  },
  {
    "poem_id": 1439,
    "vorder": 23,
    "position": 0,
    "text": "ز اولاد بگشاد خم کمند"
  },
  {
    "poem_id": 1439,
    "vorder": 24,
    "position": 1,
    "text": "نشستند زیر درختی بلند"
  },
  {
    "poem_id": 1439,
    "vorder": 25,
    "position": 0,
    "text": "تهمتن ز اولاد پرسید راه"
  },
  {
    "poem_id": 1439,
    "vorder": 26,
    "position": 1,
    "text": "به شهری کجا بود کاووس شاه"
  },
  {
    "poem_id": 1439,
    "vorder": 27,
    "position": 0,
    "text": "چو بشنید ازو تیز بنهاد روی"
  },
  {
    "poem_id": 1439,
    "vorder": 28,
    "position": 1,
    "text": "پیاده دوان پیش او راهجوی"
  },
  {
    "poem_id": 1439,
    "vorder": 29,
    "position": 0,
    "text": "چو آمد به شهر اندرون تاجبخش"
  },
  {
    "poem_id": 1439,
    "vorder": 30,
    "position": 1,
    "text": "خروشی برآورد چون رعد رخش"
  },
  {
    "poem_id": 1439,
    "vorder": 31,
    "position": 0,
    "text": "به ایرانیان گفت پس شهریار"
  },
  {
    "poem_id": 1439,
    "vorder": 32,
    "position": 1,
    "text": "که بر ما سرآمد بد روزگار"
  },
  {
    "poem_id": 1439,
    "vorder": 33,
    "position": 0,
    "text": "خروشیدن رخشم آمد به گوش"
  },
  {
    "poem_id": 1439,
    "vorder": 34,
    "position": 1,
    "text": "روان و دلم تازه شد زان خروش"
  },
  {
    "poem_id": 1439,
    "vorder": 35,
    "position": 0,
    "text": "به گاه قباد این خروشش نکرد"
  },
  {
    "poem_id": 1439,
    "vorder": 36,
    "position": 1,
    "text": "کجا کرد با شاه ترکان نبرد"
  },
  {
    "poem_id": 1439,
    "vorder": 37,
    "position": 0,
    "text": "بیامد هم اندر زمان پیش اوی"
  },
  {
    "poem_id": 1439,
    "vorder": 38,
    "position": 1,
    "text": "یل دانش‌افروز پرخاشجوی"
  },
  {
    "poem_id": 1439,
    "vorder": 39,
    "position": 0,
    "text": "به نزدیک کاووس شد پیلتن"
  },
  {
    "poem_id": 1439,
    "vorder": 40,
    "position": 1,
    "text": "همه سرفرازان شدند انجمن"
  },
  {
    "poem_id": 1439,
    "vorder": 41,
    "position": 0,
    "text": "غریوید بسیار و بردش نماز"
  },
  {
    "poem_id": 1439,
    "vorder": 42,
    "position": 1,
    "text": "بپرسیدش از رنجهای دراز"
  },
  {
    "poem_id": 1439,
    "vorder": 43,
    "position": 0,
    "text": "گرفتش به آغوش کاووس شاه"
  },
  {
    "poem_id": 1439,
    "vorder": 44,
    "position": 1,
    "text": "ز زالش بپرسید و از رنج راه"
  },
  {
    "poem_id": 1439,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت پنهان ازین جادوان"
  },
  {
    "poem_id": 1439,
    "vorder": 46,
    "position": 1,
    "text": "همی رخش را کرد باید روان"
  },
  {
    "poem_id": 1439,
    "vorder": 47,
    "position": 0,
    "text": "چو آید به دیو سپید آگهی"
  },
  {
    "poem_id": 1439,
    "vorder": 48,
    "position": 1,
    "text": "کز ارژنگ شد روی گیتی تهی"
  },
  {
    "poem_id": 1439,
    "vorder": 49,
    "position": 0,
    "text": "که نزدیک کاووس شد پیلتن"
  },
  {
    "poem_id": 1439,
    "vorder": 50,
    "position": 1,
    "text": "همه نره دیوان شوند انجمن"
  },
  {
    "poem_id": 1439,
    "vorder": 51,
    "position": 0,
    "text": "همه رنجهای تو بی‌بر شود"
  },
  {
    "poem_id": 1439,
    "vorder": 52,
    "position": 1,
    "text": "ز دیوان جهان پر ز لشکر شود"
  },
  {
    "poem_id": 1439,
    "vorder": 53,
    "position": 0,
    "text": "تو اکنون ره خانهٔ دیو گیر"
  },
  {
    "poem_id": 1439,
    "vorder": 54,
    "position": 1,
    "text": "به رنج اندرآور تن و تیغ و تیر"
  },
  {
    "poem_id": 1439,
    "vorder": 55,
    "position": 0,
    "text": "مگر یار باشدت یزدان پاک"
  },
  {
    "poem_id": 1439,
    "vorder": 56,
    "position": 1,
    "text": "سر جادوان اندر آری به خاک"
  },
  {
    "poem_id": 1439,
    "vorder": 57,
    "position": 0,
    "text": "گذر کرد باید بر هفت کوه"
  },
  {
    "poem_id": 1439,
    "vorder": 58,
    "position": 1,
    "text": "ز دیوان به هر جای کرده گروه"
  },
  {
    "poem_id": 1439,
    "vorder": 59,
    "position": 0,
    "text": "یکی غار پیش آیدت هولناک"
  },
  {
    "poem_id": 1439,
    "vorder": 60,
    "position": 1,
    "text": "چنان چون شنیدم پر از بیم و باک"
  },
  {
    "poem_id": 1439,
    "vorder": 61,
    "position": 0,
    "text": "گذارت بران نره دیوان جنگ"
  },
  {
    "poem_id": 1439,
    "vorder": 62,
    "position": 1,
    "text": "همه رزم را ساخته چون پلنگ"
  },
  {
    "poem_id": 1439,
    "vorder": 63,
    "position": 0,
    "text": "به غار اندرون گاه دیو سپید"
  },
  {
    "poem_id": 1439,
    "vorder": 64,
    "position": 1,
    "text": "کزویند لشکر به بیم و امید"
  },
  {
    "poem_id": 1439,
    "vorder": 65,
    "position": 0,
    "text": "توانی مگر کردن او را تباه"
  },
  {
    "poem_id": 1439,
    "vorder": 66,
    "position": 1,
    "text": "که اویست سالار و پشت سپاه"
  },
  {
    "poem_id": 1439,
    "vorder": 67,
    "position": 0,
    "text": "سپه را ز غم چشمها تیره شد"
  },
  {
    "poem_id": 1439,
    "vorder": 68,
    "position": 1,
    "text": "مرا چشم در تیرگی خیره شد"
  },
  {
    "poem_id": 1439,
    "vorder": 69,
    "position": 0,
    "text": "پزشکان به درمانش کردند امید"
  },
  {
    "poem_id": 1439,
    "vorder": 70,
    "position": 1,
    "text": "به خون دل و مغز دیو سپید"
  },
  {
    "poem_id": 1439,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت فرزانه مردی پزشک"
  },
  {
    "poem_id": 1439,
    "vorder": 72,
    "position": 1,
    "text": "که چون خون او را بسان سرشک"
  },
  {
    "poem_id": 1439,
    "vorder": 73,
    "position": 0,
    "text": "چکانی سه قطره به چشم اندرون"
  },
  {
    "poem_id": 1439,
    "vorder": 74,
    "position": 1,
    "text": "شود تیرگی پاک با خون برون"
  },
  {
    "poem_id": 1439,
    "vorder": 75,
    "position": 0,
    "text": "گو پیلتن جنگ را ساز کرد"
  },
  {
    "poem_id": 1439,
    "vorder": 76,
    "position": 1,
    "text": "ازان جایگه رفتن آغاز کرد"
  },
  {
    "poem_id": 1439,
    "vorder": 77,
    "position": 0,
    "text": "به ایرانیان گفت بیدار بید"
  },
  {
    "poem_id": 1439,
    "vorder": 78,
    "position": 1,
    "text": "که من کردم آهنگ دیو سپید"
  },
  {
    "poem_id": 1439,
    "vorder": 79,
    "position": 0,
    "text": "یکی پیل جنگی و چاره‌گرست"
  },
  {
    "poem_id": 1439,
    "vorder": 80,
    "position": 1,
    "text": "فراوان به گرداندرش لشکرست"
  },
  {
    "poem_id": 1439,
    "vorder": 81,
    "position": 0,
    "text": "گر ایدونک پشت من آرد به خم"
  },
  {
    "poem_id": 1439,
    "vorder": 82,
    "position": 1,
    "text": "شما دیر مانید خوار و دژم"
  },
  {
    "poem_id": 1439,
    "vorder": 83,
    "position": 0,
    "text": "وگر یار باشد خداوند هور"
  },
  {
    "poem_id": 1439,
    "vorder": 84,
    "position": 1,
    "text": "دهد مر مرا اختر نیک زور"
  },
  {
    "poem_id": 1439,
    "vorder": 85,
    "position": 0,
    "text": "همان بوم و بر باز یابید و تخت"
  },
  {
    "poem_id": 1439,
    "vorder": 86,
    "position": 1,
    "text": "به بار آید آن خسروانی درخت"
  }
]