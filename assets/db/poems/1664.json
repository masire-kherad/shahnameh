[
  {
    "poem_id": 1664,
    "vorder": 1,
    "position": 0,
    "text": "سکندر بیامد دلی همچو کوه"
  },
  {
    "poem_id": 1664,
    "vorder": 2,
    "position": 1,
    "text": "رها گشته از شاه دانش پژوه"
  },
  {
    "poem_id": 1664,
    "vorder": 3,
    "position": 0,
    "text": "نبودش ز قیدافه چین در بروی"
  },
  {
    "poem_id": 1664,
    "vorder": 4,
    "position": 1,
    "text": "نبرداشت هرگز دل از آرزوی"
  },
  {
    "poem_id": 1664,
    "vorder": 5,
    "position": 0,
    "text": "ببود آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1664,
    "vorder": 6,
    "position": 1,
    "text": "ز ایوان بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1664,
    "vorder": 7,
    "position": 0,
    "text": "سپهدار در خان پیل‌استه بود"
  },
  {
    "poem_id": 1664,
    "vorder": 8,
    "position": 1,
    "text": "همه گرد بر گرد او رسته بود"
  },
  {
    "poem_id": 1664,
    "vorder": 9,
    "position": 0,
    "text": "سر خانه را پیکر از جزع و زر"
  },
  {
    "poem_id": 1664,
    "vorder": 10,
    "position": 1,
    "text": "به زر اندرون چند گونه گهر"
  },
  {
    "poem_id": 1664,
    "vorder": 11,
    "position": 0,
    "text": "به پیش اندرون دستهٔ مشک بوی"
  },
  {
    "poem_id": 1664,
    "vorder": 12,
    "position": 1,
    "text": "دو فرزند بایسته در پیش اوی"
  },
  {
    "poem_id": 1664,
    "vorder": 13,
    "position": 0,
    "text": "چو طینوش اسپ‌افگن و قیدروش"
  },
  {
    "poem_id": 1664,
    "vorder": 14,
    "position": 1,
    "text": "نهاده به گفتار قیدافه گوش"
  },
  {
    "poem_id": 1664,
    "vorder": 15,
    "position": 0,
    "text": "به مادر چنین گفت کهتر پسر"
  },
  {
    "poem_id": 1664,
    "vorder": 16,
    "position": 1,
    "text": "که ای شاه نیک اختر و دادگر"
  },
  {
    "poem_id": 1664,
    "vorder": 17,
    "position": 0,
    "text": "چنان کن که از پیش تو بیطقون"
  },
  {
    "poem_id": 1664,
    "vorder": 18,
    "position": 1,
    "text": "شود شاد و خشنود با رهنمون"
  },
  {
    "poem_id": 1664,
    "vorder": 19,
    "position": 0,
    "text": "به ره بر کسی تا نیازاردش"
  },
  {
    "poem_id": 1664,
    "vorder": 20,
    "position": 1,
    "text": "ور از دشمنان نیز نشماردش"
  },
  {
    "poem_id": 1664,
    "vorder": 21,
    "position": 0,
    "text": "که زنده کن پاک جان من اوست"
  },
  {
    "poem_id": 1664,
    "vorder": 22,
    "position": 1,
    "text": "برآنم که روشن روان من اوست"
  },
  {
    "poem_id": 1664,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت مادر که ایدون کنم"
  },
  {
    "poem_id": 1664,
    "vorder": 24,
    "position": 1,
    "text": "که او را بزرگی بر افزون کنم"
  },
  {
    "poem_id": 1664,
    "vorder": 25,
    "position": 0,
    "text": "به اسکندر نامور شاه گفت"
  },
  {
    "poem_id": 1664,
    "vorder": 26,
    "position": 1,
    "text": "که پیدا کن اکنون نهان از نهفت"
  },
  {
    "poem_id": 1664,
    "vorder": 27,
    "position": 0,
    "text": "چه خواهی و رای سکندر به چیست"
  },
  {
    "poem_id": 1664,
    "vorder": 28,
    "position": 1,
    "text": "چه رانی تو از شاه و دستور کیست"
  },
  {
    "poem_id": 1664,
    "vorder": 29,
    "position": 0,
    "text": "سکندر بدو گفت کای سرفراز"
  },
  {
    "poem_id": 1664,
    "vorder": 30,
    "position": 1,
    "text": "به نزد تو شد بودن من دراز"
  },
  {
    "poem_id": 1664,
    "vorder": 31,
    "position": 0,
    "text": "مرا گفت رو باژ مرزش بخواه"
  },
  {
    "poem_id": 1664,
    "vorder": 32,
    "position": 1,
    "text": "وگر دیر مانی بیارم سپاه"
  },
  {
    "poem_id": 1664,
    "vorder": 33,
    "position": 0,
    "text": "نمانم بدو کشور و تاج و تخت"
  },
  {
    "poem_id": 1664,
    "vorder": 34,
    "position": 1,
    "text": "نه زور و نه شاهی نه گنج و نه بخت"
  }
]