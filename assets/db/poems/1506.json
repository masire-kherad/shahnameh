[
  {
    "poem_id": 1506,
    "vorder": 1,
    "position": 0,
    "text": "تو بر کردگار روان و خرد"
  },
  {
    "poem_id": 1506,
    "vorder": 2,
    "position": 1,
    "text": "ستایش گزین تا چه اندر خورد"
  },
  {
    "poem_id": 1506,
    "vorder": 3,
    "position": 0,
    "text": "ببین ای خردمند روشن‌روان"
  },
  {
    "poem_id": 1506,
    "vorder": 4,
    "position": 1,
    "text": "که چون باید او را ستودن توان"
  },
  {
    "poem_id": 1506,
    "vorder": 5,
    "position": 0,
    "text": "همه دانش ما به بیچارگیست"
  },
  {
    "poem_id": 1506,
    "vorder": 6,
    "position": 1,
    "text": "به بیچارگان بر بباید گریست"
  },
  {
    "poem_id": 1506,
    "vorder": 7,
    "position": 0,
    "text": "تو خستو شو آنرا که هست و یکیست"
  },
  {
    "poem_id": 1506,
    "vorder": 8,
    "position": 1,
    "text": "روان و خرد را جزین راه نیست"
  },
  {
    "poem_id": 1506,
    "vorder": 9,
    "position": 0,
    "text": "ایا فلسفه‌دان بسیار گوی"
  },
  {
    "poem_id": 1506,
    "vorder": 10,
    "position": 1,
    "text": "بپویم براهی که گویی مپوی"
  },
  {
    "poem_id": 1506,
    "vorder": 11,
    "position": 0,
    "text": "ترا هرچ بر چشم سر بگذرد"
  },
  {
    "poem_id": 1506,
    "vorder": 12,
    "position": 1,
    "text": "نگنجد همی در دلت با خرد"
  },
  {
    "poem_id": 1506,
    "vorder": 13,
    "position": 0,
    "text": "سخن هرچ بایستِ توحید نیست"
  },
  {
    "poem_id": 1506,
    "vorder": 14,
    "position": 1,
    "text": "به ناگفتن و گفتن او یکیست"
  },
  {
    "poem_id": 1506,
    "vorder": 15,
    "position": 0,
    "text": "تو گر سخته‌ای شو سخن سخته‌گوی"
  },
  {
    "poem_id": 1506,
    "vorder": 16,
    "position": 1,
    "text": "نیاید به بن هرگز این گفت و گوی"
  },
  {
    "poem_id": 1506,
    "vorder": 17,
    "position": 0,
    "text": "به یک دم زدن رستی از جان و تن"
  },
  {
    "poem_id": 1506,
    "vorder": 18,
    "position": 1,
    "text": "همی بس بزرگ آیدت خویشتن"
  },
  {
    "poem_id": 1506,
    "vorder": 19,
    "position": 0,
    "text": "همی بگذرد بر تو ایام تو"
  },
  {
    "poem_id": 1506,
    "vorder": 20,
    "position": 1,
    "text": "سرای جز این باشد آرام تو"
  },
  {
    "poem_id": 1506,
    "vorder": 21,
    "position": 0,
    "text": "نخست از جهان‌آفرین یاد کن"
  },
  {
    "poem_id": 1506,
    "vorder": 22,
    "position": 1,
    "text": "پرستش بر این یاد بنیاد کن"
  },
  {
    "poem_id": 1506,
    "vorder": 23,
    "position": 0,
    "text": "کزویست گردونِ گردان بپای"
  },
  {
    "poem_id": 1506,
    "vorder": 24,
    "position": 1,
    "text": "هم اویست بر نیک و بد رهنمای"
  },
  {
    "poem_id": 1506,
    "vorder": 25,
    "position": 0,
    "text": "جهان پر شگفتست چون بنگری"
  },
  {
    "poem_id": 1506,
    "vorder": 26,
    "position": 1,
    "text": "ندارد کسی آلت داوری"
  },
  {
    "poem_id": 1506,
    "vorder": 27,
    "position": 0,
    "text": "که جانت شگفتست و تن هم شگفت"
  },
  {
    "poem_id": 1506,
    "vorder": 28,
    "position": 1,
    "text": "نخست از خود اندازه باید گرفت"
  },
  {
    "poem_id": 1506,
    "vorder": 29,
    "position": 0,
    "text": "دگر آنک این گرد گردان سپهر"
  },
  {
    "poem_id": 1506,
    "vorder": 30,
    "position": 1,
    "text": "همی نو نمایدت هر روز چهر"
  },
  {
    "poem_id": 1506,
    "vorder": 31,
    "position": 0,
    "text": "نباشی بدین گفته همداستان"
  },
  {
    "poem_id": 1506,
    "vorder": 32,
    "position": 1,
    "text": "که دهقان همی گوید از باستان"
  },
  {
    "poem_id": 1506,
    "vorder": 33,
    "position": 0,
    "text": "خردمند کاین داستان بشنوَد"
  },
  {
    "poem_id": 1506,
    "vorder": 34,
    "position": 1,
    "text": "بدانش گراید بدین نگرود"
  },
  {
    "poem_id": 1506,
    "vorder": 35,
    "position": 0,
    "text": "ولیکن چو معنیش یادآوری"
  },
  {
    "poem_id": 1506,
    "vorder": 36,
    "position": 1,
    "text": "شود رام و کوته کند داوری"
  },
  {
    "poem_id": 1506,
    "vorder": 37,
    "position": 0,
    "text": "تو بشنو ز گفتار دهقان پیر"
  },
  {
    "poem_id": 1506,
    "vorder": 38,
    "position": 1,
    "text": "گر ایدونک باشد سخن دلپذیر"
  },
  {
    "poem_id": 1506,
    "vorder": 39,
    "position": 0,
    "text": "سخنگوی دهقان چنین کرد یاد"
  },
  {
    "poem_id": 1506,
    "vorder": 40,
    "position": 1,
    "text": "که یک روز کیخسرو از بامداد"
  },
  {
    "poem_id": 1506,
    "vorder": 41,
    "position": 0,
    "text": "بیاراست گلشن بسان بهار"
  },
  {
    "poem_id": 1506,
    "vorder": 42,
    "position": 1,
    "text": "بزرگان نشستند با شهریار"
  },
  {
    "poem_id": 1506,
    "vorder": 43,
    "position": 0,
    "text": "چو گودرز و چون رستم و گستهم"
  },
  {
    "poem_id": 1506,
    "vorder": 44,
    "position": 1,
    "text": "چو برزین گرشاسپ از تخم جم"
  },
  {
    "poem_id": 1506,
    "vorder": 45,
    "position": 0,
    "text": "چو گیو و چو رهام کار آزمای"
  },
  {
    "poem_id": 1506,
    "vorder": 46,
    "position": 1,
    "text": "چو گرگین و خراد فرخنده رای"
  },
  {
    "poem_id": 1506,
    "vorder": 47,
    "position": 0,
    "text": "چو از روز یک ساعت اندر گذشت"
  },
  {
    "poem_id": 1506,
    "vorder": 48,
    "position": 1,
    "text": "بیامد بدرگاه چوپان ز دشت"
  },
  {
    "poem_id": 1506,
    "vorder": 49,
    "position": 0,
    "text": "که گوری پدید آمد اندر گله"
  },
  {
    "poem_id": 1506,
    "vorder": 50,
    "position": 1,
    "text": "چو شیری که از بند گردد یله"
  },
  {
    "poem_id": 1506,
    "vorder": 51,
    "position": 0,
    "text": "همان رنگ خورشید دارد درست"
  },
  {
    "poem_id": 1506,
    "vorder": 52,
    "position": 1,
    "text": "سپهرش بزر آب گویی بشست"
  },
  {
    "poem_id": 1506,
    "vorder": 53,
    "position": 0,
    "text": "یکی برکشیده خط از یال اوی"
  },
  {
    "poem_id": 1506,
    "vorder": 54,
    "position": 1,
    "text": "ز مشک سیه تا بدنبال اوی"
  },
  {
    "poem_id": 1506,
    "vorder": 55,
    "position": 0,
    "text": "سمندی بزرگست گویی بجای"
  },
  {
    "poem_id": 1506,
    "vorder": 56,
    "position": 1,
    "text": "ورا چار گرزست آن دست و پای"
  },
  {
    "poem_id": 1506,
    "vorder": 57,
    "position": 0,
    "text": "یکی نره شیرست گویی دژم"
  },
  {
    "poem_id": 1506,
    "vorder": 58,
    "position": 1,
    "text": "همی بفگند یال اسپان ز هم"
  },
  {
    "poem_id": 1506,
    "vorder": 59,
    "position": 0,
    "text": "بدانست خسرو که آن نیست گور"
  },
  {
    "poem_id": 1506,
    "vorder": 60,
    "position": 1,
    "text": "که برنگذرد گور ز اسپی بزور"
  },
  {
    "poem_id": 1506,
    "vorder": 61,
    "position": 0,
    "text": "برستم چنین گفت کین رنج نیز"
  },
  {
    "poem_id": 1506,
    "vorder": 62,
    "position": 1,
    "text": "به پیگار بر خویشتن سنج نیز"
  },
  {
    "poem_id": 1506,
    "vorder": 63,
    "position": 0,
    "text": "برو خویشتن را نگه‌دار ازوی"
  },
  {
    "poem_id": 1506,
    "vorder": 64,
    "position": 1,
    "text": "مگر باشد آهرمن کینه‌جوی"
  },
  {
    "poem_id": 1506,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت رستم که با بخت تو"
  },
  {
    "poem_id": 1506,
    "vorder": 66,
    "position": 1,
    "text": "نترسد پرستندهٔ تخت تو"
  },
  {
    "poem_id": 1506,
    "vorder": 67,
    "position": 0,
    "text": "نه دیو و نه شیر و نه نر اژدها"
  },
  {
    "poem_id": 1506,
    "vorder": 68,
    "position": 1,
    "text": "ز شمشیر تیزم نیابد رها"
  },
  {
    "poem_id": 1506,
    "vorder": 69,
    "position": 0,
    "text": "برون شد بنخچیر چون نره شیر"
  },
  {
    "poem_id": 1506,
    "vorder": 70,
    "position": 1,
    "text": "کمندی بدست اژدهایی بزیر"
  },
  {
    "poem_id": 1506,
    "vorder": 71,
    "position": 0,
    "text": "به دشتی کجا داشت چوپان گله"
  },
  {
    "poem_id": 1506,
    "vorder": 72,
    "position": 1,
    "text": "وزانسو گذر داشت گور یله"
  },
  {
    "poem_id": 1506,
    "vorder": 73,
    "position": 0,
    "text": "سه روزش همی جست در مرغزار"
  },
  {
    "poem_id": 1506,
    "vorder": 74,
    "position": 1,
    "text": "همی کرد بر گرد اسپان شکار"
  },
  {
    "poem_id": 1506,
    "vorder": 75,
    "position": 0,
    "text": "چهارم بدیدش گرازان بدشت"
  },
  {
    "poem_id": 1506,
    "vorder": 76,
    "position": 1,
    "text": "چو باد شمالی برو بر گذشت"
  },
  {
    "poem_id": 1506,
    "vorder": 77,
    "position": 0,
    "text": "درخشنده زرین یکی باره بود"
  },
  {
    "poem_id": 1506,
    "vorder": 78,
    "position": 1,
    "text": "بچرم اندرون زشت پتیاره بود"
  },
  {
    "poem_id": 1506,
    "vorder": 79,
    "position": 0,
    "text": "برانگیخت رخش دلاور ز جای"
  },
  {
    "poem_id": 1506,
    "vorder": 80,
    "position": 1,
    "text": "چو تنگ اندر آمد دگر شد برای"
  },
  {
    "poem_id": 1506,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت کین را نباید فگند"
  },
  {
    "poem_id": 1506,
    "vorder": 82,
    "position": 1,
    "text": "بباید گرفتن بخم کمند"
  },
  {
    "poem_id": 1506,
    "vorder": 83,
    "position": 0,
    "text": "نشایدش کردن بخنجر تباه"
  },
  {
    "poem_id": 1506,
    "vorder": 84,
    "position": 1,
    "text": "بدین سانش زنده برم نزد شاه"
  },
  {
    "poem_id": 1506,
    "vorder": 85,
    "position": 0,
    "text": "بینداخت رستم کیانی کمند"
  },
  {
    "poem_id": 1506,
    "vorder": 86,
    "position": 1,
    "text": "همی خواست کارد سرش را ببند"
  },
  {
    "poem_id": 1506,
    "vorder": 87,
    "position": 0,
    "text": "چو گور دلاور کمندش بدید"
  },
  {
    "poem_id": 1506,
    "vorder": 88,
    "position": 1,
    "text": "شد از چشم او در زمان ناپدید"
  },
  {
    "poem_id": 1506,
    "vorder": 89,
    "position": 0,
    "text": "بدانست رستم که آن نیست گور"
  },
  {
    "poem_id": 1506,
    "vorder": 90,
    "position": 1,
    "text": "ابا او کنون چاره باید نه زور"
  },
  {
    "poem_id": 1506,
    "vorder": 91,
    "position": 0,
    "text": "جز اکوان دیو این نشاید بُدن"
  },
  {
    "poem_id": 1506,
    "vorder": 92,
    "position": 1,
    "text": "ببایستش از باد تیغی زدن"
  },
  {
    "poem_id": 1506,
    "vorder": 93,
    "position": 0,
    "text": "بشمشیر باید کنون چاره کرد"
  },
  {
    "poem_id": 1506,
    "vorder": 94,
    "position": 1,
    "text": "دوانیدن خون بران چرم زرد"
  },
  {
    "poem_id": 1506,
    "vorder": 95,
    "position": 0,
    "text": "ز دانا شنیدم که این جای اوست"
  },
  {
    "poem_id": 1506,
    "vorder": 96,
    "position": 1,
    "text": "که گفتند بستاند از گور پوست"
  },
  {
    "poem_id": 1506,
    "vorder": 97,
    "position": 0,
    "text": "همانگه پدید آمد از دشت باز"
  },
  {
    "poem_id": 1506,
    "vorder": 98,
    "position": 1,
    "text": "سپهبد برانگیخت آن تند تاز"
  },
  {
    "poem_id": 1506,
    "vorder": 99,
    "position": 0,
    "text": "کمان را بزه کرد و از باد اسپ"
  },
  {
    "poem_id": 1506,
    "vorder": 100,
    "position": 1,
    "text": "بینداخت تیری چو آذر گشسپ"
  },
  {
    "poem_id": 1506,
    "vorder": 101,
    "position": 0,
    "text": "همان کو کمان کیان درکشید"
  },
  {
    "poem_id": 1506,
    "vorder": 102,
    "position": 1,
    "text": "دگر باره شد گور ازو ناپدید"
  },
  {
    "poem_id": 1506,
    "vorder": 103,
    "position": 0,
    "text": "همی تاخت اسپ اندران پهن دشت"
  },
  {
    "poem_id": 1506,
    "vorder": 104,
    "position": 1,
    "text": "چو سه روز و سه شب برو بر گذشت"
  },
  {
    "poem_id": 1506,
    "vorder": 105,
    "position": 0,
    "text": "به آبش گرفت آرزو هم به نان"
  },
  {
    "poem_id": 1506,
    "vorder": 106,
    "position": 1,
    "text": "سر از خواب بر کوههٔ زین زنان"
  },
  {
    "poem_id": 1506,
    "vorder": 107,
    "position": 0,
    "text": "چو بگرفتش از آب روشن شتاب"
  },
  {
    "poem_id": 1506,
    "vorder": 108,
    "position": 1,
    "text": "به پیش آمدش چشمهٔ چون گلاب"
  },
  {
    "poem_id": 1506,
    "vorder": 109,
    "position": 0,
    "text": "فرود آمد و رخش را آب داد"
  },
  {
    "poem_id": 1506,
    "vorder": 110,
    "position": 1,
    "text": "هم از ماندگی چشم را خواب داد"
  },
  {
    "poem_id": 1506,
    "vorder": 111,
    "position": 0,
    "text": "کمندش ببازوی و ببر بیان"
  },
  {
    "poem_id": 1506,
    "vorder": 112,
    "position": 1,
    "text": "بپوشیده و تنگ بسته میان"
  },
  {
    "poem_id": 1506,
    "vorder": 113,
    "position": 0,
    "text": "ز زین کیانیش بگشاد تنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 114,
    "position": 1,
    "text": "به بالین نهاد آن جناغ خدنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 115,
    "position": 0,
    "text": "چراگاه رخش آمد و جای خواب"
  },
  {
    "poem_id": 1506,
    "vorder": 116,
    "position": 1,
    "text": "نمدزین برافگند بر پیش آب"
  },
  {
    "poem_id": 1506,
    "vorder": 117,
    "position": 0,
    "text": "بدان جایگه خفت و خوابش ربود"
  },
  {
    "poem_id": 1506,
    "vorder": 118,
    "position": 1,
    "text": "که از رنج وز تاختن مانده بود"
  },
  {
    "poem_id": 1506,
    "vorder": 119,
    "position": 0,
    "text": "چو اکوانش از دور خفته بدید"
  },
  {
    "poem_id": 1506,
    "vorder": 120,
    "position": 1,
    "text": "یکی باد شد تا بر او رسید"
  },
  {
    "poem_id": 1506,
    "vorder": 121,
    "position": 0,
    "text": "زمین گرد ببرید و برداشتش"
  },
  {
    "poem_id": 1506,
    "vorder": 122,
    "position": 1,
    "text": "ز هامون بگردون برافراشتش"
  },
  {
    "poem_id": 1506,
    "vorder": 123,
    "position": 0,
    "text": "غمی شد تهمتن چو بیدار شد"
  },
  {
    "poem_id": 1506,
    "vorder": 124,
    "position": 1,
    "text": "سر پر خرد پر ز پیکار شد"
  },
  {
    "poem_id": 1506,
    "vorder": 125,
    "position": 0,
    "text": "چو رستم بجنبید بر خویشتن"
  },
  {
    "poem_id": 1506,
    "vorder": 126,
    "position": 1,
    "text": "بدو گفت اکوان که ای پیلتن"
  },
  {
    "poem_id": 1506,
    "vorder": 127,
    "position": 0,
    "text": "یکی آرزو کن که تا از هوا"
  },
  {
    "poem_id": 1506,
    "vorder": 128,
    "position": 1,
    "text": "کجات آید افگندن اکنون هوا"
  },
  {
    "poem_id": 1506,
    "vorder": 129,
    "position": 0,
    "text": "سوی آبت اندازم ار سوی کوه"
  },
  {
    "poem_id": 1506,
    "vorder": 130,
    "position": 1,
    "text": "کجا خواهی افتاد دور از گروه"
  },
  {
    "poem_id": 1506,
    "vorder": 131,
    "position": 0,
    "text": "چو رستم بگفتار او بنگرید"
  },
  {
    "poem_id": 1506,
    "vorder": 132,
    "position": 1,
    "text": "هوا در کف دیو واژونه دید"
  },
  {
    "poem_id": 1506,
    "vorder": 133,
    "position": 0,
    "text": "چنین گفت با خویشتن پیلتن"
  },
  {
    "poem_id": 1506,
    "vorder": 134,
    "position": 1,
    "text": "که بد نامبردار هر انجمن"
  },
  {
    "poem_id": 1506,
    "vorder": 135,
    "position": 0,
    "text": "گر اندازدم گفت بر کوهسار"
  },
  {
    "poem_id": 1506,
    "vorder": 136,
    "position": 1,
    "text": "تن و استخوانم نیاید بکار"
  },
  {
    "poem_id": 1506,
    "vorder": 137,
    "position": 0,
    "text": "بدریا به آید که اندازدم"
  },
  {
    "poem_id": 1506,
    "vorder": 138,
    "position": 1,
    "text": "کفن سینهٔ ماهیان سازدم"
  },
  {
    "poem_id": 1506,
    "vorder": 139,
    "position": 0,
    "text": "وگر گویم او را بدریا فگن"
  },
  {
    "poem_id": 1506,
    "vorder": 140,
    "position": 1,
    "text": "بکوه افگند بدگهر اهرمن"
  },
  {
    "poem_id": 1506,
    "vorder": 141,
    "position": 0,
    "text": "همه واژگونه بود کار دیو"
  },
  {
    "poem_id": 1506,
    "vorder": 142,
    "position": 1,
    "text": "که فریادرس باد گیهان خدیو"
  },
  {
    "poem_id": 1506,
    "vorder": 143,
    "position": 0,
    "text": "چنین داد پاسخ که دانای چین"
  },
  {
    "poem_id": 1506,
    "vorder": 144,
    "position": 1,
    "text": "یکی داستانی زدست اندرین"
  },
  {
    "poem_id": 1506,
    "vorder": 145,
    "position": 0,
    "text": "که در آب هر کو بر آیدش هوش"
  },
  {
    "poem_id": 1506,
    "vorder": 146,
    "position": 1,
    "text": "به مینو روانش نبیند سروش"
  },
  {
    "poem_id": 1506,
    "vorder": 147,
    "position": 0,
    "text": "بزاری هم ایدر بماند بجای"
  },
  {
    "poem_id": 1506,
    "vorder": 148,
    "position": 1,
    "text": "خرامش نیاید بدیگر سرای"
  },
  {
    "poem_id": 1506,
    "vorder": 149,
    "position": 0,
    "text": "به کوهم بینداز تا ببر و شیر"
  },
  {
    "poem_id": 1506,
    "vorder": 150,
    "position": 1,
    "text": "ببینند چنگال مرد دلیر"
  },
  {
    "poem_id": 1506,
    "vorder": 151,
    "position": 0,
    "text": "ز رستم چو بشنید اکوان دیو"
  },
  {
    "poem_id": 1506,
    "vorder": 152,
    "position": 1,
    "text": "برآورد بر سوی دریا غریو"
  },
  {
    "poem_id": 1506,
    "vorder": 153,
    "position": 0,
    "text": "بجایی بخواهم فگندنت گفت"
  },
  {
    "poem_id": 1506,
    "vorder": 154,
    "position": 1,
    "text": "که اندر دو گیتی بمانی نهفت"
  },
  {
    "poem_id": 1506,
    "vorder": 155,
    "position": 0,
    "text": "بدریای ژرف اندر انداختش"
  },
  {
    "poem_id": 1506,
    "vorder": 156,
    "position": 1,
    "text": "ز کینه خور ماهیان ساختش"
  },
  {
    "poem_id": 1506,
    "vorder": 157,
    "position": 0,
    "text": "همان کز هوا سوی دریا رسید"
  },
  {
    "poem_id": 1506,
    "vorder": 158,
    "position": 1,
    "text": "سبک تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 1506,
    "vorder": 159,
    "position": 0,
    "text": "نهنگان که کردند آهنگ اوی"
  },
  {
    "poem_id": 1506,
    "vorder": 160,
    "position": 1,
    "text": "ببودند سرگشته از چنگ اوی"
  },
  {
    "poem_id": 1506,
    "vorder": 161,
    "position": 0,
    "text": "بدست چپ و پای کرد آشناه"
  },
  {
    "poem_id": 1506,
    "vorder": 162,
    "position": 1,
    "text": "بدیگر ز دشمن همی جست راه"
  },
  {
    "poem_id": 1506,
    "vorder": 163,
    "position": 0,
    "text": "بکارش نیامد زمانی درنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 164,
    "position": 1,
    "text": "چنین باشد آن کو بود مرد جنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 165,
    "position": 0,
    "text": "اگر ماندی کس بمردی بپای"
  },
  {
    "poem_id": 1506,
    "vorder": 166,
    "position": 1,
    "text": "پی او زمانه نبردی ز جای"
  },
  {
    "poem_id": 1506,
    "vorder": 167,
    "position": 0,
    "text": "ولیکن چنینست گردنده دهر"
  },
  {
    "poem_id": 1506,
    "vorder": 168,
    "position": 1,
    "text": "گهی نوش یابند ازو گاه زهر"
  },
  {
    "poem_id": 1506,
    "vorder": 169,
    "position": 0,
    "text": "ز دریا بمردی به یکسو کشید"
  },
  {
    "poem_id": 1506,
    "vorder": 170,
    "position": 1,
    "text": "برآمد بهامون و خشکی بدید"
  },
  {
    "poem_id": 1506,
    "vorder": 171,
    "position": 0,
    "text": "ستایش گرفت آفریننده را"
  },
  {
    "poem_id": 1506,
    "vorder": 172,
    "position": 1,
    "text": "رهانیده از بد تن بنده را"
  },
  {
    "poem_id": 1506,
    "vorder": 173,
    "position": 0,
    "text": "برآسود و بگشاد بند میان"
  },
  {
    "poem_id": 1506,
    "vorder": 174,
    "position": 1,
    "text": "بر چشمه بنهاد ببر بیان"
  },
  {
    "poem_id": 1506,
    "vorder": 175,
    "position": 0,
    "text": "کمند و سلیحش چو بفگند نم"
  },
  {
    "poem_id": 1506,
    "vorder": 176,
    "position": 1,
    "text": "زره را بپوشید شیر دژم"
  },
  {
    "poem_id": 1506,
    "vorder": 177,
    "position": 0,
    "text": "بدان چشمه آمد کجا خفته بود"
  },
  {
    "poem_id": 1506,
    "vorder": 178,
    "position": 1,
    "text": "بران دیو بدگوهر آشفته بود"
  },
  {
    "poem_id": 1506,
    "vorder": 179,
    "position": 0,
    "text": "نبود رخش رخشان بران مرغزار"
  },
  {
    "poem_id": 1506,
    "vorder": 180,
    "position": 1,
    "text": "جهانجوی شد تند با روزگار"
  },
  {
    "poem_id": 1506,
    "vorder": 181,
    "position": 0,
    "text": "برآشفت و برداشت زین و لگام"
  },
  {
    "poem_id": 1506,
    "vorder": 182,
    "position": 1,
    "text": "بشد بر پی رخش تا گاه شام"
  },
  {
    "poem_id": 1506,
    "vorder": 183,
    "position": 0,
    "text": "پیاده همی رفت جویان شکار"
  },
  {
    "poem_id": 1506,
    "vorder": 184,
    "position": 1,
    "text": "به پیش اندر آمد یکی مرغزار"
  },
  {
    "poem_id": 1506,
    "vorder": 185,
    "position": 0,
    "text": "همه بیشه و آبهای روان"
  },
  {
    "poem_id": 1506,
    "vorder": 186,
    "position": 1,
    "text": "بهر جای دراج و قمری نوان"
  },
  {
    "poem_id": 1506,
    "vorder": 187,
    "position": 0,
    "text": "گله‌دار اسپان افراسیاب"
  },
  {
    "poem_id": 1506,
    "vorder": 188,
    "position": 1,
    "text": "به بیشه درون سر نهاده بخواب"
  },
  {
    "poem_id": 1506,
    "vorder": 189,
    "position": 0,
    "text": "دمان رخش بر مادیانان چو دیو"
  },
  {
    "poem_id": 1506,
    "vorder": 190,
    "position": 1,
    "text": "میان گله برکشیده غریو"
  },
  {
    "poem_id": 1506,
    "vorder": 191,
    "position": 0,
    "text": "چو رستم بدیدش کیانی کمند"
  },
  {
    "poem_id": 1506,
    "vorder": 192,
    "position": 1,
    "text": "بیفگند و سرش اندر آمد به بند"
  },
  {
    "poem_id": 1506,
    "vorder": 193,
    "position": 0,
    "text": "بمالیدش از گرد و زین برنهاد"
  },
  {
    "poem_id": 1506,
    "vorder": 194,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1506,
    "vorder": 195,
    "position": 0,
    "text": "لگامش بسر بر زد و برنشست"
  },
  {
    "poem_id": 1506,
    "vorder": 196,
    "position": 1,
    "text": "بران تیز شمشیر بنهاد دست"
  },
  {
    "poem_id": 1506,
    "vorder": 197,
    "position": 0,
    "text": "گله هر کجا دید یکسر براند"
  },
  {
    "poem_id": 1506,
    "vorder": 198,
    "position": 1,
    "text": "بشمشیر بر نام یزدان بخواند"
  },
  {
    "poem_id": 1506,
    "vorder": 199,
    "position": 0,
    "text": "گله‌دار چون بانگ اسبان شنید"
  },
  {
    "poem_id": 1506,
    "vorder": 200,
    "position": 1,
    "text": "سرآسیمه از خواب سر بر کشید"
  },
  {
    "poem_id": 1506,
    "vorder": 201,
    "position": 0,
    "text": "سواران که بودند با او بخواند"
  },
  {
    "poem_id": 1506,
    "vorder": 202,
    "position": 1,
    "text": "بر اسپ سرافرازشان برنشاند"
  },
  {
    "poem_id": 1506,
    "vorder": 203,
    "position": 0,
    "text": "گرفتند هر کس کمند و کمان"
  },
  {
    "poem_id": 1506,
    "vorder": 204,
    "position": 1,
    "text": "بدان تا که باشد چنین بدگمان"
  },
  {
    "poem_id": 1506,
    "vorder": 205,
    "position": 0,
    "text": "که یارد بدین مرغزار آمدن"
  },
  {
    "poem_id": 1506,
    "vorder": 206,
    "position": 1,
    "text": "بنزدیک چندین سوار آمدن"
  },
  {
    "poem_id": 1506,
    "vorder": 207,
    "position": 0,
    "text": "پس اندر سواران برفتند گرم"
  },
  {
    "poem_id": 1506,
    "vorder": 208,
    "position": 1,
    "text": "که بر پشت رستم بدرند چرم"
  },
  {
    "poem_id": 1506,
    "vorder": 209,
    "position": 0,
    "text": "چو رستم شتابندگان را بدید"
  },
  {
    "poem_id": 1506,
    "vorder": 210,
    "position": 1,
    "text": "سبک تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 1506,
    "vorder": 211,
    "position": 0,
    "text": "بغرید چون شیر و برگفت نام"
  },
  {
    "poem_id": 1506,
    "vorder": 212,
    "position": 1,
    "text": "که من رستمم پور دستان سام"
  },
  {
    "poem_id": 1506,
    "vorder": 213,
    "position": 0,
    "text": "بشمشیر ازیشان دو بهره بکشت"
  },
  {
    "poem_id": 1506,
    "vorder": 214,
    "position": 1,
    "text": "چو چوپان چنان دید بنمود پشت"
  },
  {
    "poem_id": 1506,
    "vorder": 215,
    "position": 0,
    "text": "چو باد از شگفتی هم اندر شتاب"
  },
  {
    "poem_id": 1506,
    "vorder": 216,
    "position": 1,
    "text": "بدیدار اسپ آمد افراسیاب"
  },
  {
    "poem_id": 1506,
    "vorder": 217,
    "position": 0,
    "text": "بجایی که هر سال چوپان گله"
  },
  {
    "poem_id": 1506,
    "vorder": 218,
    "position": 1,
    "text": "بران دشت و آن آب کردی یله"
  },
  {
    "poem_id": 1506,
    "vorder": 219,
    "position": 0,
    "text": "خود و دو هزار از یل نامدار"
  },
  {
    "poem_id": 1506,
    "vorder": 220,
    "position": 1,
    "text": "رسیدند تازان بران مرغزار"
  },
  {
    "poem_id": 1506,
    "vorder": 221,
    "position": 0,
    "text": "ابا باده و رود و گردان بهم"
  },
  {
    "poem_id": 1506,
    "vorder": 222,
    "position": 1,
    "text": "بدان تا کند بر دل اندیشه کم"
  },
  {
    "poem_id": 1506,
    "vorder": 223,
    "position": 0,
    "text": "چو نزدیک آن مرغزاران رسید"
  },
  {
    "poem_id": 1506,
    "vorder": 224,
    "position": 1,
    "text": "ز اسپان و چوپان نشانی ندید"
  },
  {
    "poem_id": 1506,
    "vorder": 225,
    "position": 0,
    "text": "یکایک خروشیدن آمد ز دشت"
  },
  {
    "poem_id": 1506,
    "vorder": 226,
    "position": 1,
    "text": "همه اسپ یک بر دگر برگذشت"
  },
  {
    "poem_id": 1506,
    "vorder": 227,
    "position": 0,
    "text": "ز خاک پی رخش بر سرکشان"
  },
  {
    "poem_id": 1506,
    "vorder": 228,
    "position": 1,
    "text": "پدید آمد از دور پیدا نشان"
  },
  {
    "poem_id": 1506,
    "vorder": 229,
    "position": 0,
    "text": "چو چوپان بر شاه توران رسید"
  },
  {
    "poem_id": 1506,
    "vorder": 230,
    "position": 1,
    "text": "بدو باز گفت آن شگفتی که دید"
  },
  {
    "poem_id": 1506,
    "vorder": 231,
    "position": 0,
    "text": "که تنها گله برد رستم ز دشت"
  },
  {
    "poem_id": 1506,
    "vorder": 232,
    "position": 1,
    "text": "ز ما کشت بسیار و اندر گذشت"
  },
  {
    "poem_id": 1506,
    "vorder": 233,
    "position": 0,
    "text": "ز ترکان برآمد یکی گفت و گوی"
  },
  {
    "poem_id": 1506,
    "vorder": 234,
    "position": 1,
    "text": "که تنها بجنگ آمد این کینه‌جوی"
  },
  {
    "poem_id": 1506,
    "vorder": 235,
    "position": 0,
    "text": "بباید کشیدن یکایک سلیح"
  },
  {
    "poem_id": 1506,
    "vorder": 236,
    "position": 1,
    "text": "که این کار بر ما گذشت از مزیح"
  },
  {
    "poem_id": 1506,
    "vorder": 237,
    "position": 0,
    "text": "چنین زار گشتیم و خوار و زبون"
  },
  {
    "poem_id": 1506,
    "vorder": 238,
    "position": 1,
    "text": "که یک تن سوی ما گراید به خون"
  },
  {
    "poem_id": 1506,
    "vorder": 239,
    "position": 0,
    "text": "همی بفگند نام مردی ز ما"
  },
  {
    "poem_id": 1506,
    "vorder": 240,
    "position": 1,
    "text": "به تیغ او براند ز خون آسیا"
  },
  {
    "poem_id": 1506,
    "vorder": 241,
    "position": 0,
    "text": "همی بگذراند به یک تن گله"
  },
  {
    "poem_id": 1506,
    "vorder": 242,
    "position": 1,
    "text": "نشاید چنین کار کردن یله"
  },
  {
    "poem_id": 1506,
    "vorder": 243,
    "position": 0,
    "text": "سپهدار با چار پیل و سپاه"
  },
  {
    "poem_id": 1506,
    "vorder": 244,
    "position": 1,
    "text": "پس رستم اندر گرفتند راه"
  },
  {
    "poem_id": 1506,
    "vorder": 245,
    "position": 0,
    "text": "چو گشتند نزدیک رستم کمان"
  },
  {
    "poem_id": 1506,
    "vorder": 246,
    "position": 1,
    "text": "ز بازو برون کرد و آمد دمان"
  },
  {
    "poem_id": 1506,
    "vorder": 247,
    "position": 0,
    "text": "بریشان ببارید چو ژاله میغ"
  },
  {
    "poem_id": 1506,
    "vorder": 248,
    "position": 1,
    "text": "چه تیر از کمان و چه پولاد تیغ"
  },
  {
    "poem_id": 1506,
    "vorder": 249,
    "position": 0,
    "text": "چو افگنده شد شست مرد دلیر"
  },
  {
    "poem_id": 1506,
    "vorder": 250,
    "position": 1,
    "text": "بگرز اندر آمد ز شمشیر شیر"
  },
  {
    "poem_id": 1506,
    "vorder": 251,
    "position": 0,
    "text": "همی گرز بارید همچون تگرگ"
  },
  {
    "poem_id": 1506,
    "vorder": 252,
    "position": 1,
    "text": "همی چاک چاک آمد از خود و ترگ"
  },
  {
    "poem_id": 1506,
    "vorder": 253,
    "position": 0,
    "text": "ازیشان چهل مرد دیگر بکشت"
  },
  {
    "poem_id": 1506,
    "vorder": 254,
    "position": 1,
    "text": "غمی شد سپهدار و بنمود پشت"
  },
  {
    "poem_id": 1506,
    "vorder": 255,
    "position": 0,
    "text": "ازو بستد آن چار پیل سپید"
  },
  {
    "poem_id": 1506,
    "vorder": 256,
    "position": 1,
    "text": "شدند آن سپاه از جهان ناامید"
  },
  {
    "poem_id": 1506,
    "vorder": 257,
    "position": 0,
    "text": "پس پشتشان رستم گرزدار"
  },
  {
    "poem_id": 1506,
    "vorder": 258,
    "position": 1,
    "text": "دو فرسنگ برسان ابر بهار"
  },
  {
    "poem_id": 1506,
    "vorder": 259,
    "position": 0,
    "text": "چو برگشت برداشت پیل و رمه"
  },
  {
    "poem_id": 1506,
    "vorder": 260,
    "position": 1,
    "text": "بنه هرچ آمد بچنگش همه"
  },
  {
    "poem_id": 1506,
    "vorder": 261,
    "position": 0,
    "text": "بیامد گرازان بران چشمه باز"
  },
  {
    "poem_id": 1506,
    "vorder": 262,
    "position": 1,
    "text": "دلش جنگ جویان بچنگ دراز"
  },
  {
    "poem_id": 1506,
    "vorder": 263,
    "position": 0,
    "text": "دگر باره اکوان بدو باز خورد"
  },
  {
    "poem_id": 1506,
    "vorder": 264,
    "position": 1,
    "text": "نگشتی بدو گفت سیر از نبرد"
  },
  {
    "poem_id": 1506,
    "vorder": 265,
    "position": 0,
    "text": "برستی ز دریا و چنگ نهنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 266,
    "position": 1,
    "text": "بدشت آمدی باز پیچان بجنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 267,
    "position": 0,
    "text": "تهمتن چو بنشید گفتار دیو"
  },
  {
    "poem_id": 1506,
    "vorder": 268,
    "position": 1,
    "text": "برآورد چون شیر جنگی غریو"
  },
  {
    "poem_id": 1506,
    "vorder": 269,
    "position": 0,
    "text": "ز فتراک بگشاد پیچان کمند"
  },
  {
    "poem_id": 1506,
    "vorder": 270,
    "position": 1,
    "text": "بیفگند و آمد میانش به بند"
  },
  {
    "poem_id": 1506,
    "vorder": 271,
    "position": 0,
    "text": "بپیچید بر زین و گرز گران"
  },
  {
    "poem_id": 1506,
    "vorder": 272,
    "position": 1,
    "text": "برآهیخت چون پتک آهنگران"
  },
  {
    "poem_id": 1506,
    "vorder": 273,
    "position": 0,
    "text": "بزد بر سر دیو چون پیل مست"
  },
  {
    "poem_id": 1506,
    "vorder": 274,
    "position": 1,
    "text": "سر و مغزش از گرز او گشت پست"
  },
  {
    "poem_id": 1506,
    "vorder": 275,
    "position": 0,
    "text": "فرود آمد آن آبگون خنجرش"
  },
  {
    "poem_id": 1506,
    "vorder": 276,
    "position": 1,
    "text": "برآهیخت و ببرید جنگی سرش"
  },
  {
    "poem_id": 1506,
    "vorder": 277,
    "position": 0,
    "text": "همی خواند بر کردگار آفرین"
  },
  {
    "poem_id": 1506,
    "vorder": 278,
    "position": 1,
    "text": "کزو بود پیروزی و زور کین"
  },
  {
    "poem_id": 1506,
    "vorder": 279,
    "position": 0,
    "text": "تو مر دیو را مردم بد شناس"
  },
  {
    "poem_id": 1506,
    "vorder": 280,
    "position": 1,
    "text": "کسی کو ندارد ز یزدان سپاس"
  },
  {
    "poem_id": 1506,
    "vorder": 281,
    "position": 0,
    "text": "هرانکو گذشت از ره مردمی"
  },
  {
    "poem_id": 1506,
    "vorder": 282,
    "position": 1,
    "text": "ز دیوان شمر مشمر از آدمی"
  },
  {
    "poem_id": 1506,
    "vorder": 283,
    "position": 0,
    "text": "خرد گر برین گفتها نگرود"
  },
  {
    "poem_id": 1506,
    "vorder": 284,
    "position": 1,
    "text": "مگر نیک مغزش همی نشنود"
  },
  {
    "poem_id": 1506,
    "vorder": 285,
    "position": 0,
    "text": "گر آن پهلوانی بود زورمند"
  },
  {
    "poem_id": 1506,
    "vorder": 286,
    "position": 1,
    "text": "به بازو ستبر و به بالا بلند"
  },
  {
    "poem_id": 1506,
    "vorder": 287,
    "position": 0,
    "text": "گوان خوان و اکوان دیوش مخوان"
  },
  {
    "poem_id": 1506,
    "vorder": 288,
    "position": 1,
    "text": "که بر پهلوانی بگردد زیان"
  },
  {
    "poem_id": 1506,
    "vorder": 289,
    "position": 0,
    "text": "چه گویی تو ای خواجهٔ سالخورد"
  },
  {
    "poem_id": 1506,
    "vorder": 290,
    "position": 1,
    "text": "چشیده ز گیتی بسی گرم و سرد"
  },
  {
    "poem_id": 1506,
    "vorder": 291,
    "position": 0,
    "text": "که داند که چندین نشیب و فراز"
  },
  {
    "poem_id": 1506,
    "vorder": 292,
    "position": 1,
    "text": "به پیش آرد این روزگار دراز"
  },
  {
    "poem_id": 1506,
    "vorder": 293,
    "position": 0,
    "text": "تگ روزگار از درازی که هست"
  },
  {
    "poem_id": 1506,
    "vorder": 294,
    "position": 1,
    "text": "همی بگذراند سخنها ز دست"
  },
  {
    "poem_id": 1506,
    "vorder": 295,
    "position": 0,
    "text": "که داند کزین گنبد تیزگرد"
  },
  {
    "poem_id": 1506,
    "vorder": 296,
    "position": 1,
    "text": "درو سور چند است و چندی نبرد"
  },
  {
    "poem_id": 1506,
    "vorder": 297,
    "position": 0,
    "text": "چو ببرید رستم سر دیو پست"
  },
  {
    "poem_id": 1506,
    "vorder": 298,
    "position": 1,
    "text": "بران بارهٔ پیل پیکر نشست"
  },
  {
    "poem_id": 1506,
    "vorder": 299,
    "position": 0,
    "text": "به پیش اندر آورد یکسر گله"
  },
  {
    "poem_id": 1506,
    "vorder": 300,
    "position": 1,
    "text": "بنه هرچ کردند ترکان یله"
  },
  {
    "poem_id": 1506,
    "vorder": 301,
    "position": 0,
    "text": "همی رفت با پیل و با خواسته"
  },
  {
    "poem_id": 1506,
    "vorder": 302,
    "position": 1,
    "text": "وزو شد جهان یکسر آراسته"
  },
  {
    "poem_id": 1506,
    "vorder": 303,
    "position": 0,
    "text": "ز ره چون به شاه آمد این آگهی"
  },
  {
    "poem_id": 1506,
    "vorder": 304,
    "position": 1,
    "text": "که برگشت رستم بدان فرهی"
  },
  {
    "poem_id": 1506,
    "vorder": 305,
    "position": 0,
    "text": "از ایدر میان را بدان کرد بند"
  },
  {
    "poem_id": 1506,
    "vorder": 306,
    "position": 1,
    "text": "کجا گور گیرد بخم کمند"
  },
  {
    "poem_id": 1506,
    "vorder": 307,
    "position": 0,
    "text": "کنون دیو و پیل آمدستش بچنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 308,
    "position": 1,
    "text": "بخشکی پلنگ و بدریا نهنگ"
  },
  {
    "poem_id": 1506,
    "vorder": 309,
    "position": 0,
    "text": "نیابد گذر شیر بر تیغ اوی"
  },
  {
    "poem_id": 1506,
    "vorder": 310,
    "position": 1,
    "text": "همان دیو و هم مردم کینه‌جوی"
  },
  {
    "poem_id": 1506,
    "vorder": 311,
    "position": 0,
    "text": "پذیره شدن را بیاراست شاه"
  },
  {
    "poem_id": 1506,
    "vorder": 312,
    "position": 1,
    "text": "بسر بر نهادند گردان کلاه"
  },
  {
    "poem_id": 1506,
    "vorder": 313,
    "position": 0,
    "text": "درفش شهنشاه با کرنای"
  },
  {
    "poem_id": 1506,
    "vorder": 314,
    "position": 1,
    "text": "ببردند با ژنده پیل و درای"
  },
  {
    "poem_id": 1506,
    "vorder": 315,
    "position": 0,
    "text": "چو رستم درفش جهاندار شاه"
  },
  {
    "poem_id": 1506,
    "vorder": 316,
    "position": 1,
    "text": "نگه کرد کامد پذیره براه"
  },
  {
    "poem_id": 1506,
    "vorder": 317,
    "position": 0,
    "text": "فرود آمد و خاک را داد بوس"
  },
  {
    "poem_id": 1506,
    "vorder": 318,
    "position": 1,
    "text": "خروش سپاه آمد و بوق و کوس"
  },
  {
    "poem_id": 1506,
    "vorder": 319,
    "position": 0,
    "text": "سر سرکشان رستم تاج بخش"
  },
  {
    "poem_id": 1506,
    "vorder": 320,
    "position": 1,
    "text": "بفرمود تا برنشیند برخش"
  },
  {
    "poem_id": 1506,
    "vorder": 321,
    "position": 0,
    "text": "وزانجا بایوان شاه آمدند"
  },
  {
    "poem_id": 1506,
    "vorder": 322,
    "position": 1,
    "text": "گشاده دل و نیک خواه آمدند"
  },
  {
    "poem_id": 1506,
    "vorder": 323,
    "position": 0,
    "text": "به ایرانیان بر گله بخش کرد"
  },
  {
    "poem_id": 1506,
    "vorder": 324,
    "position": 1,
    "text": "نشست تن خویشتن رخش کرد"
  },
  {
    "poem_id": 1506,
    "vorder": 325,
    "position": 0,
    "text": "فرستاد پیلان بر پیل شاه"
  },
  {
    "poem_id": 1506,
    "vorder": 326,
    "position": 1,
    "text": "که بر شیر پیلان بگیرند راه"
  },
  {
    "poem_id": 1506,
    "vorder": 327,
    "position": 0,
    "text": "بیک هفته ایوان بیاراستند"
  },
  {
    "poem_id": 1506,
    "vorder": 328,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1506,
    "vorder": 329,
    "position": 0,
    "text": "بمی رستم آن داستان برگشاد"
  },
  {
    "poem_id": 1506,
    "vorder": 330,
    "position": 1,
    "text": "وز اکوان همی کرد بر شاه یاد"
  },
  {
    "poem_id": 1506,
    "vorder": 331,
    "position": 0,
    "text": "که گوری ندیدم بخوبی چنوی"
  },
  {
    "poem_id": 1506,
    "vorder": 332,
    "position": 1,
    "text": "بدان سرافرازی و آن رنگ و بوی"
  },
  {
    "poem_id": 1506,
    "vorder": 333,
    "position": 0,
    "text": "چو خنجر بدرید بر تنش پوست"
  },
  {
    "poem_id": 1506,
    "vorder": 334,
    "position": 1,
    "text": "بروبر نبخشود دشمن نه دوست"
  },
  {
    "poem_id": 1506,
    "vorder": 335,
    "position": 0,
    "text": "سرش چون سر پیل و مویش دراز"
  },
  {
    "poem_id": 1506,
    "vorder": 336,
    "position": 1,
    "text": "دهن پر زدندانهای گراز"
  },
  {
    "poem_id": 1506,
    "vorder": 337,
    "position": 0,
    "text": "دو چشمش کبود و لبانش سیاه"
  },
  {
    "poem_id": 1506,
    "vorder": 338,
    "position": 1,
    "text": "تنش را نشایست کردن نگاه"
  },
  {
    "poem_id": 1506,
    "vorder": 339,
    "position": 0,
    "text": "بدان زور و آن تن نباشد هیون"
  },
  {
    "poem_id": 1506,
    "vorder": 340,
    "position": 1,
    "text": "همه دشت ازو شد چو دریای خون"
  },
  {
    "poem_id": 1506,
    "vorder": 341,
    "position": 0,
    "text": "سرش کردم از تن بخنجر جدا"
  },
  {
    "poem_id": 1506,
    "vorder": 342,
    "position": 1,
    "text": "چو باران ازو خون شد اندر هوا"
  },
  {
    "poem_id": 1506,
    "vorder": 343,
    "position": 0,
    "text": "ازو ماند کیخسرو اندر شگفت"
  },
  {
    "poem_id": 1506,
    "vorder": 344,
    "position": 1,
    "text": "چو بنهاد جام آفرین برگرفت"
  },
  {
    "poem_id": 1506,
    "vorder": 345,
    "position": 0,
    "text": "بران کو چنان پهلوان آفرید"
  },
  {
    "poem_id": 1506,
    "vorder": 346,
    "position": 1,
    "text": "کسی این شگفتی بگیتی ندید"
  },
  {
    "poem_id": 1506,
    "vorder": 347,
    "position": 0,
    "text": "که مردم بود خود بکردار اوی"
  },
  {
    "poem_id": 1506,
    "vorder": 348,
    "position": 1,
    "text": "بمردی و بالا و دیدار اوی"
  },
  {
    "poem_id": 1506,
    "vorder": 349,
    "position": 0,
    "text": "همی گفت اگر کردگار سپهر"
  },
  {
    "poem_id": 1506,
    "vorder": 350,
    "position": 1,
    "text": "ندادی مرا بهره از داد و مهر"
  },
  {
    "poem_id": 1506,
    "vorder": 351,
    "position": 0,
    "text": "نبودی بگیتی چنین کهترم"
  },
  {
    "poem_id": 1506,
    "vorder": 352,
    "position": 1,
    "text": "که هزمان بدو دیو و پیل اشکرم"
  },
  {
    "poem_id": 1506,
    "vorder": 353,
    "position": 0,
    "text": "دو هفته بران گونه بودند شاد"
  },
  {
    "poem_id": 1506,
    "vorder": 354,
    "position": 1,
    "text": "ز اکوان وز بزم کردند یاد"
  },
  {
    "poem_id": 1506,
    "vorder": 355,
    "position": 0,
    "text": "سه دیگر تهمتن چنین کرد رای"
  },
  {
    "poem_id": 1506,
    "vorder": 356,
    "position": 1,
    "text": "که پیروز و شادان شود باز جای"
  },
  {
    "poem_id": 1506,
    "vorder": 357,
    "position": 0,
    "text": "مرا بویهٔ زال سامست گفت"
  },
  {
    "poem_id": 1506,
    "vorder": 358,
    "position": 1,
    "text": "چنین آرزو را نشاید نهفت"
  },
  {
    "poem_id": 1506,
    "vorder": 359,
    "position": 0,
    "text": "شوم زود و آیم بدرگاه باز"
  },
  {
    "poem_id": 1506,
    "vorder": 360,
    "position": 1,
    "text": "بباید همی کینه را کرد ساز"
  },
  {
    "poem_id": 1506,
    "vorder": 361,
    "position": 0,
    "text": "که کین سیاوش به پیل و گله"
  },
  {
    "poem_id": 1506,
    "vorder": 362,
    "position": 1,
    "text": "نشاید چنین خوار کردن یله"
  },
  {
    "poem_id": 1506,
    "vorder": 363,
    "position": 0,
    "text": "در گنج بگشاد شاه جهان"
  },
  {
    "poem_id": 1506,
    "vorder": 364,
    "position": 1,
    "text": "گرانمایه چیزی که بودش نهان"
  },
  {
    "poem_id": 1506,
    "vorder": 365,
    "position": 0,
    "text": "بیاورد ده جام گوهر ز گنج"
  },
  {
    "poem_id": 1506,
    "vorder": 366,
    "position": 1,
    "text": "بزر بافته جامهٔ شاه پنج"
  },
  {
    "poem_id": 1506,
    "vorder": 367,
    "position": 0,
    "text": "غلامان روزمی بزرین کمر"
  },
  {
    "poem_id": 1506,
    "vorder": 368,
    "position": 1,
    "text": "پرستندگان نیز با طوق زر"
  },
  {
    "poem_id": 1506,
    "vorder": 369,
    "position": 0,
    "text": "ز گستردنیها و از تخت عاج"
  },
  {
    "poem_id": 1506,
    "vorder": 370,
    "position": 1,
    "text": "ز دیبا و دینار و پیروزه تاج"
  },
  {
    "poem_id": 1506,
    "vorder": 371,
    "position": 0,
    "text": "بنزدیک رستم فرستاد شاه"
  },
  {
    "poem_id": 1506,
    "vorder": 372,
    "position": 1,
    "text": "که این هدیه با خویشتن بر براه"
  },
  {
    "poem_id": 1506,
    "vorder": 373,
    "position": 0,
    "text": "یک امروز با ما بباید بدن"
  },
  {
    "poem_id": 1506,
    "vorder": 374,
    "position": 1,
    "text": "وزان پس ترا رای رفتن زدن"
  },
  {
    "poem_id": 1506,
    "vorder": 375,
    "position": 0,
    "text": "ببود و بپیمود چندی نبید"
  },
  {
    "poem_id": 1506,
    "vorder": 376,
    "position": 1,
    "text": "بشبگیر جز رای رفتن ندید"
  },
  {
    "poem_id": 1506,
    "vorder": 377,
    "position": 0,
    "text": "دو فرسنگ با او بشد شهریار"
  },
  {
    "poem_id": 1506,
    "vorder": 378,
    "position": 1,
    "text": "بپدرود کردن گرفتش کنار"
  },
  {
    "poem_id": 1506,
    "vorder": 379,
    "position": 0,
    "text": "چو با راه رستم هم آواز گشت"
