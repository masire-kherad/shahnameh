[
  {
    "poem_id": 1501,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد به آزادگان"
  },
  {
    "poem_id": 1501,
    "vorder": 2,
    "position": 1,
    "text": "بر پیر گودرز کشوادگان"
  },
  {
    "poem_id": 1501,
    "vorder": 3,
    "position": 0,
    "text": "که طوس و فریبرز گشتند باز"
  },
  {
    "poem_id": 1501,
    "vorder": 4,
    "position": 1,
    "text": "نیارست رفتن بر دژ فراز"
  },
  {
    "poem_id": 1501,
    "vorder": 5,
    "position": 0,
    "text": "بیاراست پیلان و برخاست غو"
  },
  {
    "poem_id": 1501,
    "vorder": 6,
    "position": 1,
    "text": "بیامد سپاه جهاندار نو"
  },
  {
    "poem_id": 1501,
    "vorder": 7,
    "position": 0,
    "text": "یکی تخت زرین زبرجدنگار"
  },
  {
    "poem_id": 1501,
    "vorder": 8,
    "position": 1,
    "text": "نهاد از بر پیل و بستند بار"
  },
  {
    "poem_id": 1501,
    "vorder": 9,
    "position": 0,
    "text": "به گرد اندرش با درفش بنفش"
  },
  {
    "poem_id": 1501,
    "vorder": 10,
    "position": 1,
    "text": "به پا اندرون کرده زرینه کفش"
  },
  {
    "poem_id": 1501,
    "vorder": 11,
    "position": 0,
    "text": "جهانجوی بر تخت زرین نشست"
  },
  {
    "poem_id": 1501,
    "vorder": 12,
    "position": 1,
    "text": "به سر برش تاجی و گرزی به دست"
  },
  {
    "poem_id": 1501,
    "vorder": 13,
    "position": 0,
    "text": "دو یاره ز یاقوت و طوقی به زر"
  },
  {
    "poem_id": 1501,
    "vorder": 14,
    "position": 1,
    "text": "به زر اندرون نقش کرده گهر"
  },
  {
    "poem_id": 1501,
    "vorder": 15,
    "position": 0,
    "text": "همی رفت لشکر گروها گروه"
  },
  {
    "poem_id": 1501,
    "vorder": 16,
    "position": 1,
    "text": "که از سم اسپان زمین شد چو کوه"
  },
  {
    "poem_id": 1501,
    "vorder": 17,
    "position": 0,
    "text": "چو نزدیک دژ شد همی برنشست"
  },
  {
    "poem_id": 1501,
    "vorder": 18,
    "position": 1,
    "text": "بپوشید درع و میان را ببست"
  },
  {
    "poem_id": 1501,
    "vorder": 19,
    "position": 0,
    "text": "نویسنده‌ای خواست بر پشت زین"
  },
  {
    "poem_id": 1501,
    "vorder": 20,
    "position": 1,
    "text": "یکی نامه فرمود با آفرین"
  },
  {
    "poem_id": 1501,
    "vorder": 21,
    "position": 0,
    "text": "ز عنبر نوشتند بر پهلوی"
  },
  {
    "poem_id": 1501,
    "vorder": 22,
    "position": 1,
    "text": "چنان چون بود نامهٔ خسروی"
  },
  {
    "poem_id": 1501,
    "vorder": 23,
    "position": 0,
    "text": "که این نامه از بندهٔ کردگار"
  },
  {
    "poem_id": 1501,
    "vorder": 24,
    "position": 1,
    "text": "جهانجوی کیخسرو نامدار"
  },
  {
    "poem_id": 1501,
    "vorder": 25,
    "position": 0,
    "text": "که از بند آهرمن بد بجست"
  },
  {
    "poem_id": 1501,
    "vorder": 26,
    "position": 1,
    "text": "به یزدان زد از هر بدی پاک دست"
  },
  {
    "poem_id": 1501,
    "vorder": 27,
    "position": 0,
    "text": "که اویست جاوید برتر خدای"
  },
  {
    "poem_id": 1501,
    "vorder": 28,
    "position": 1,
    "text": "خداوند نیکی ده و رهنمای"
  },
  {
    "poem_id": 1501,
    "vorder": 29,
    "position": 0,
    "text": "خداوند بهرام و کیوان و هور"
  },
  {
    "poem_id": 1501,
    "vorder": 30,
    "position": 1,
    "text": "خداوند فر و خداوند زور"
  },
  {
    "poem_id": 1501,
    "vorder": 31,
    "position": 0,
    "text": "مرا داد اورند و فر کیان"
  },
  {
    "poem_id": 1501,
    "vorder": 32,
    "position": 1,
    "text": "تن پیل و چنگال شیر ژیان"
  },
  {
    "poem_id": 1501,
    "vorder": 33,
    "position": 0,
    "text": "جهانی سراسر به شاهی مراست"
  },
  {
    "poem_id": 1501,
    "vorder": 34,
    "position": 1,
    "text": "در گاو تا برج ماهی مراست"
  },
  {
    "poem_id": 1501,
    "vorder": 35,
    "position": 0,
    "text": "گر این دژ بر و بوم آهرمنست"
  },
  {
    "poem_id": 1501,
    "vorder": 36,
    "position": 1,
    "text": "جهان آفرین را به دل دشمنست"
  },
  {
    "poem_id": 1501,
    "vorder": 37,
    "position": 0,
    "text": "به فر و به فرمان یزدان پاک"
  },
  {
    "poem_id": 1501,
    "vorder": 38,
    "position": 1,
    "text": "سراسر به گرز اندر آرم به خاک"
  },
  {
    "poem_id": 1501,
    "vorder": 39,
    "position": 0,
    "text": "و گر جادوان راست این دستگاه"
  },
  {
    "poem_id": 1501,
    "vorder": 40,
    "position": 1,
    "text": "مرا خود به جادو نباید سپاه"
  },
  {
    "poem_id": 1501,
    "vorder": 41,
    "position": 0,
    "text": "چو خم دوال کمند آورم"
  },
  {
    "poem_id": 1501,
    "vorder": 42,
    "position": 1,
    "text": "سر جادوان را به بند آورم"
  },
  {
    "poem_id": 1501,
    "vorder": 43,
    "position": 0,
    "text": "وگر خود خجسته سروش اندرست"
  },
  {
    "poem_id": 1501,
    "vorder": 44,
    "position": 1,
    "text": "به فرمان یزدان یکی لشکرست"
  },
  {
    "poem_id": 1501,
    "vorder": 45,
    "position": 0,
    "text": "همان من نه از دست آهرمنم"
  },
  {
    "poem_id": 1501,
    "vorder": 46,
    "position": 1,
    "text": "که از فر و برزست جان و تنم"
  },
  {
    "poem_id": 1501,
    "vorder": 47,
    "position": 0,
    "text": "به فرمان یزدان کند این تهی"
  },
  {
    "poem_id": 1501,
    "vorder": 48,
    "position": 1,
    "text": "که اینست پیمان شاهنشهی"
  },
  {
    "poem_id": 1501,
    "vorder": 49,
    "position": 0,
    "text": "یکی نیزه بگرفت خسرو به دست"
  },
  {
    "poem_id": 1501,
    "vorder": 50,
    "position": 1,
    "text": "همان نامه را بر سر نیزه بست"
  },
  {
    "poem_id": 1501,
    "vorder": 51,
    "position": 0,
    "text": "بسان درفشی برآورد راست"
  },
  {
    "poem_id": 1501,
    "vorder": 52,
    "position": 1,
    "text": "به گیتی به جز فر یزدان نخواست"
  },
  {
    "poem_id": 1501,
    "vorder": 53,
    "position": 0,
    "text": "بفرمود تا گیو با نیزه تفت"
  },
  {
    "poem_id": 1501,
    "vorder": 54,
    "position": 1,
    "text": "به نزدیک آن بر شده باره رفت"
  },
  {
    "poem_id": 1501,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت کاین نامهٔ پندمند"
  },
  {
    "poem_id": 1501,
    "vorder": 56,
    "position": 1,
    "text": "ببر سوی دیوار حصن بلند"
  },
  {
    "poem_id": 1501,
    "vorder": 57,
    "position": 0,
    "text": "بنه نامه و نام یزدان بخوان"
  },
  {
    "poem_id": 1501,
    "vorder": 58,
    "position": 1,
    "text": "بگردان عنان تیز و لختی ممان"
  },
  {
    "poem_id": 1501,
    "vorder": 59,
    "position": 0,
    "text": "بشد گیو نیزه گرفته به دست"
  },
  {
    "poem_id": 1501,
    "vorder": 60,
    "position": 1,
    "text": "پر از آفرین جان یزدان پرست"
  },
  {
    "poem_id": 1501,
    "vorder": 61,
    "position": 0,
    "text": "چو نامه به دیوار دژ برنهاد"
  },
  {
    "poem_id": 1501,
    "vorder": 62,
    "position": 1,
    "text": "به نام جهانجوی خسرو نژاد"
  },
  {
    "poem_id": 1501,
    "vorder": 63,
    "position": 0,
    "text": "ز دادار نیکی دهش یاد کرد"
  },
  {
    "poem_id": 1501,
    "vorder": 64,
    "position": 1,
    "text": "پس آن چرمهٔ تیزرو باد کرد"
  },
  {
    "poem_id": 1501,
    "vorder": 65,
    "position": 0,
    "text": "شد آن نامهٔ نامور ناپدید"
  },
  {
    "poem_id": 1501,
    "vorder": 66,
    "position": 1,
    "text": "خروش آمد و خاک دژ بردمید"
  },
  {
    "poem_id": 1501,
    "vorder": 67,
    "position": 0,
    "text": "همانگه به فرمان یزدان پاک"
  },
  {
    "poem_id": 1501,
    "vorder": 68,
    "position": 1,
    "text": "ازان بارهٔ دژ برآمد تراک"
  },
  {
    "poem_id": 1501,
    "vorder": 69,
    "position": 0,
    "text": "تو گفتی که رعدست وقت بهار"
  },
  {
    "poem_id": 1501,
    "vorder": 70,
    "position": 1,
    "text": "خروش آمد از دشت و ز کوهسار"
  },
  {
    "poem_id": 1501,
    "vorder": 71,
    "position": 0,
    "text": "جهان گشت چون روی زنگی سیاه"
  },
  {
    "poem_id": 1501,
    "vorder": 72,
    "position": 1,
    "text": "چه از باره دژ چه گرد سپاه"
  },
  {
    "poem_id": 1501,
    "vorder": 73,
    "position": 0,
    "text": "تو گفتی برآمد یکی تیره ابر"
  },
  {
    "poem_id": 1501,
    "vorder": 74,
    "position": 1,
    "text": "هوا شد به کردار کام هژبر"
  },
  {
    "poem_id": 1501,
    "vorder": 75,
    "position": 0,
    "text": "برانگیخت کیخسرو اسپ سیاه"
  },
  {
    "poem_id": 1501,
    "vorder": 76,
    "position": 1,
    "text": "چنین گفت با پهلوان سپاه"
  },
  {
    "poem_id": 1501,
    "vorder": 77,
    "position": 0,
    "text": "که بر دژ یکی تیر باران کنید"
  },
  {
    "poem_id": 1501,
    "vorder": 78,
    "position": 1,
    "text": "هوا را چو ابر بهاران کنید"
  },
  {
    "poem_id": 1501,
    "vorder": 79,
    "position": 0,
    "text": "برآمد یکی میغ بارش تگرگ"
  },
  {
    "poem_id": 1501,
    "vorder": 80,
    "position": 1,
    "text": "تگرگی که بردارد از ابر مرگ"
  },
  {
    "poem_id": 1501,
    "vorder": 81,
    "position": 0,
    "text": "ز دیوان بسی شد به پیکان هلاک"
  },
  {
    "poem_id": 1501,
    "vorder": 82,
    "position": 1,
    "text": "بسی زهره کفته فتاده به خاک"
  },
  {
    "poem_id": 1501,
    "vorder": 83,
    "position": 0,
    "text": "ازان پس یکی روشنی بردمید"
  },
  {
    "poem_id": 1501,
    "vorder": 84,
    "position": 1,
    "text": "شد آن تیرگی سر به سر ناپدید"
  },
  {
    "poem_id": 1501,
    "vorder": 85,
    "position": 0,
    "text": "جهان شد به کردار تابنده ماه"
  },
  {
    "poem_id": 1501,
    "vorder": 86,
    "position": 1,
    "text": "به نام جهاندار پیروز شاه"
  },
  {
    "poem_id": 1501,
    "vorder": 87,
    "position": 0,
    "text": "برآمد یکی باد با آفرین"
  },
  {
    "poem_id": 1501,
    "vorder": 88,
    "position": 1,
    "text": "هوا گشت خندان و روی زمین"
  },
  {
    "poem_id": 1501,
    "vorder": 89,
    "position": 0,
    "text": "برفتند دیوان به فرمان شاه"
  },
  {
    "poem_id": 1501,
    "vorder": 90,
    "position": 1,
    "text": "در دژ پدید آمد از جایگاه"
  },
  {
    "poem_id": 1501,
    "vorder": 91,
    "position": 0,
    "text": "به دژ در شد آن شاه آزادگان"
  },
  {
    "poem_id": 1501,
    "vorder": 92,
    "position": 1,
    "text": "ابا پیر گودرز کشوادگان"
  },
  {
    "poem_id": 1501,
    "vorder": 93,
    "position": 0,
    "text": "یکی شهر دید اندر آن دژ فراخ"
  },
  {
    "poem_id": 1501,
    "vorder": 94,
    "position": 1,
    "text": "پر از باغ و میدان و ایوان و کاخ"
  },
  {
    "poem_id": 1501,
    "vorder": 95,
    "position": 0,
    "text": "بدانجای کان روشنی بردمید"
  },
  {
    "poem_id": 1501,
    "vorder": 96,
    "position": 1,
    "text": "سر بارهٔ دژ بشد ناپدید"
  },
  {
    "poem_id": 1501,
    "vorder": 97,
    "position": 0,
    "text": "بفرمود خسرو بدان جایگاه"
  },
  {
    "poem_id": 1501,
    "vorder": 98,
    "position": 1,
    "text": "یکی گنبدی تا به ابر سیاه"
  },
  {
    "poem_id": 1501,
    "vorder": 99,
    "position": 0,
    "text": "درازی و پهنای او ده کمند"
  },
  {
    "poem_id": 1501,
    "vorder": 100,
    "position": 1,
    "text": "به گرد اندرش طاقهای بلند"
  },
  {
    "poem_id": 1501,
    "vorder": 101,
    "position": 0,
    "text": "ز بیرون دو نیمی تگ تازی اسپ"
  },
  {
    "poem_id": 1501,
    "vorder": 102,
    "position": 1,
    "text": "برآورد و بنهاد آذرگشسپ"
  },
  {
    "poem_id": 1501,
    "vorder": 103,
    "position": 0,
    "text": "نشستند گرد اندرش موبدان"
  },
  {
    "poem_id": 1501,
    "vorder": 104,
    "position": 1,
    "text": "ستاره‌شناسان و هم بخردان"
  },
  {
    "poem_id": 1501,
    "vorder": 105,
    "position": 0,
    "text": "دران شارستان کرد چندان درنگ"
  },
  {
    "poem_id": 1501,
    "vorder": 106,
    "position": 1,
    "text": "که آتشکده گشت با بوی و رنگ"
  },
  {
    "poem_id": 1501,
    "vorder": 107,
    "position": 0,
    "text": "چو یک سال بگذشت لشکر براند"
  },
  {
    "poem_id": 1501,
    "vorder": 108,
    "position": 1,
    "text": "بنه بر نهاد و سپه برنشاند"
  },
  {
    "poem_id": 1501,
    "vorder": 109,
    "position": 0,
    "text": "چو آگاهی آمد به ایران ز شاه"
  },
  {
    "poem_id": 1501,
    "vorder": 110,
    "position": 1,
    "text": "ازان ایزدی فر و آن دستگاه"
  },
  {
    "poem_id": 1501,
    "vorder": 111,
    "position": 0,
    "text": "جهانی فرو ماند اندر شگفت"
  },
  {
    "poem_id": 1501,
    "vorder": 112,
    "position": 1,
    "text": "که کیخسرو آن فر و بالا گرفت"
  },
  {
    "poem_id": 1501,
    "vorder": 113,
    "position": 0,
    "text": "همه مهتران یک به یک با نثار"
  },
  {
    "poem_id": 1501,
    "vorder": 114,
    "position": 1,
    "text": "برفتند شادان بر شهریار"
  },
  {
    "poem_id": 1501,
    "vorder": 115,
    "position": 0,
    "text": "فریبرز پیش آمدش با گروه"
  },
  {
    "poem_id": 1501,
    "vorder": 116,
    "position": 1,
    "text": "از ایران سپاهی بکردار کوه"
  },
  {
    "poem_id": 1501,
    "vorder": 117,
    "position": 0,
    "text": "چو دیدش فرود آمد از تخت زر"
  },
  {
    "poem_id": 1501,
    "vorder": 118,
    "position": 1,
    "text": "ببوسید روی برادر پدر"
  },
  {
    "poem_id": 1501,
    "vorder": 119,
    "position": 0,
    "text": "نشاندش بر تخت زر شهریار"
  },
  {
    "poem_id": 1501,
    "vorder": 120,
    "position": 1,
    "text": "که بود از در یاره و گوشوار"
  },
  {
    "poem_id": 1501,
    "vorder": 121,
    "position": 0,
    "text": "همان طوس با کاویانی درفش"
  },
  {
    "poem_id": 1501,
    "vorder": 122,
    "position": 1,
    "text": "همی رفت با کوس و زرینه کفش"
  },
  {
    "poem_id": 1501,
    "vorder": 123,
    "position": 0,
    "text": "بیاورد و پیش جهاندار برد"
  },
  {
    "poem_id": 1501,
    "vorder": 124,
    "position": 1,
    "text": "زمین را ببوسید و او را سپرد"
  },
  {
    "poem_id": 1501,
    "vorder": 125,
    "position": 0,
    "text": "بدو گفت کاین کوس و زرینه کفش"
  },
  {
    "poem_id": 1501,
    "vorder": 126,
    "position": 1,
    "text": "به نیک اختری کاویانی درفش"
  },
  {
    "poem_id": 1501,
    "vorder": 127,
    "position": 0,
    "text": "ز لشکر ببین تا سزاوار کیست"
  },
  {
    "poem_id": 1501,
    "vorder": 128,
    "position": 1,
    "text": "یکی پهلوان از در کار کیست"
  },
  {
    "poem_id": 1501,
    "vorder": 129,
    "position": 0,
    "text": "ز گفتارها پوزش آورد پیش"
  },
  {
    "poem_id": 1501,
    "vorder": 130,
    "position": 1,
    "text": "بپیچید زان بیهده رای خویش"
  },
  {
    "poem_id": 1501,
    "vorder": 131,
    "position": 0,
    "text": "جهاندار پیروز بنواختش"
  },
  {
    "poem_id": 1501,
    "vorder": 132,
    "position": 1,
    "text": "بخندید و بر تخت بنشاختش"
  },
  {
    "poem_id": 1501,
    "vorder": 133,
    "position": 0,
    "text": "بدو گفت کین کاویانی درفش"
  },
  {
    "poem_id": 1501,
    "vorder": 134,
    "position": 1,
    "text": "هم آن پهلوانی و زرینه کفش"
  },
  {
    "poem_id": 1501,
    "vorder": 135,
    "position": 0,
    "text": "نبینم سزای کسی در سپاه"
  },
  {
    "poem_id": 1501,
    "vorder": 136,
    "position": 1,
    "text": "ترا زیبد این کار و این دستگاه"
  },
  {
    "poem_id": 1501,
    "vorder": 137,
    "position": 0,
    "text": "ترا پوزش اکنون نیاید به کار"
  },
  {
    "poem_id": 1501,
    "vorder": 138,
    "position": 1,
    "text": "نه بیگانه‌ای خواستی شهریار"
  },
  {
    "poem_id": 1501,
    "vorder": 139,
    "position": 0,
    "text": "چو پیروز برگشت شیر از نبرد"
  },
  {
    "poem_id": 1501,
    "vorder": 140,
    "position": 1,
    "text": "دل و دیدهٔ دشمنان تیره کرد"
  },
  {
    "poem_id": 1501,
    "vorder": 141,
    "position": 0,
    "text": "سوی پهلو پارس بنهاد روی"
  },
  {
    "poem_id": 1501,
    "vorder": 142,
    "position": 1,
    "text": "جوان بود و بیدار و دیهیم جوی"
  },
  {
    "poem_id": 1501,
    "vorder": 143,
    "position": 0,
    "text": "چو زو آگهی یافت کاووس کی"
  },
  {
    "poem_id": 1501,
    "vorder": 144,
    "position": 1,
    "text": "که آمد ز ره پور فرخنده پی"
  },
  {
    "poem_id": 1501,
    "vorder": 145,
    "position": 0,
    "text": "پذیره شدش با رخی ارغوان"
  },
  {
    "poem_id": 1501,
    "vorder": 146,
    "position": 1,
    "text": "ز شادی دل پیر گشته جوان"
  },
  {
    "poem_id": 1501,
    "vorder": 147,
    "position": 0,
    "text": "چو از دور خسرو نیا را بدید"
  },
  {
    "poem_id": 1501,
    "vorder": 148,
    "position": 1,
    "text": "بخندید و شادان دلش بردمید"
  },
  {
    "poem_id": 1501,
    "vorder": 149,
    "position": 0,
    "text": "پیاده شد و برد پیشش نماز"
  },
  {
    "poem_id": 1501,
    "vorder": 150,
    "position": 1,
    "text": "به دیدار او بد نیا را نیاز"
  },
  {
    "poem_id": 1501,
    "vorder": 151,
    "position": 0,
    "text": "بخندید و او را به بر در گرفت"
  },
  {
    "poem_id": 1501,
    "vorder": 152,
    "position": 1,
    "text": "نیایش سزاوار او برگرفت"
  },
  {
    "poem_id": 1501,
    "vorder": 153,
    "position": 0,
    "text": "وزانجا سوی کاخ رفتند باز"
  },
  {
    "poem_id": 1501,
    "vorder": 154,
    "position": 1,
    "text": "به تخت جهاندار دیهیم ساز"
  },
  {
    "poem_id": 1501,
    "vorder": 155,
    "position": 0,
    "text": "چو کاووس بر تخت زرین نشست"
  },
  {
    "poem_id": 1501,
    "vorder": 156,
    "position": 1,
    "text": "گرفت آن زمان دست خسرو به دست"
  },
  {
    "poem_id": 1501,
    "vorder": 157,
    "position": 0,
    "text": "بیاورد و بنشاند بر جای خویش"
  },
  {
    "poem_id": 1501,
    "vorder": 158,
    "position": 1,
    "text": "ز گنجور تاج کیان خواست پیش"
  },
  {
    "poem_id": 1501,
    "vorder": 159,
    "position": 0,
    "text": "ببوسید و بنهاد بر سرش تاج"
  },
  {
    "poem_id": 1501,
    "vorder": 160,
    "position": 1,
    "text": "به کرسی شد از نامور تخت عاج"
  },
  {
    "poem_id": 1501,
    "vorder": 161,
    "position": 0,
    "text": "ز گنجش زبرجد نثار آورید"
  },
  {
    "poem_id": 1501,
    "vorder": 162,
    "position": 1,
    "text": "بسی گوهر شاهوار آورید"
  },
  {
    "poem_id": 1501,
    "vorder": 163,
    "position": 0,
    "text": "بسی آفرین بر سیاوش بخواند"
  },
  {
    "poem_id": 1501,
    "vorder": 164,
    "position": 1,
    "text": "که خسرو به چهره جز او را نماند"
  },
  {
    "poem_id": 1501,
    "vorder": 165,
    "position": 0,
    "text": "ز پهلو برفتند آزادگان"
  },
  {
    "poem_id": 1501,
    "vorder": 166,
    "position": 1,
    "text": "سپهبد سران و گرانمایگان"
  },
  {
    "poem_id": 1501,
    "vorder": 167,
    "position": 0,
    "text": "به شاهی برو آفرین خواندند"
  },
  {
    "poem_id": 1501,
    "vorder": 168,
    "position": 1,
    "text": "همه زر و گوهر برافشاندند"
  },
  {
    "poem_id": 1501,
    "vorder": 169,
    "position": 0,
    "text": "جهان را چنین است ساز و نهاد"
  },
  {
    "poem_id": 1501,
    "vorder": 170,
    "position": 1,
    "text": "ز یک دست بستد به دیگر بداد"
  },
  {
    "poem_id": 1501,
    "vorder": 171,
    "position": 0,
    "text": "بدردیم ازین رفتن اندر فریب"
  },
  {
    "poem_id": 1501,
    "vorder": 172,
    "position": 1,
    "text": "زمانی فراز و زمانی نشیب"
  },
  {
    "poem_id": 1501,
    "vorder": 173,
    "position": 0,
    "text": "اگر دل توان داشتن شادمان"
  },
  {
    "poem_id": 1501,
    "vorder": 174,
    "position": 1,
    "text": "به شادی چرا نگذرانی زمان"
  },
  {
    "poem_id": 1501,
    "vorder": 175,
    "position": 0,
    "text": "به خوشی بناز و به خوبی ببخش"
  },
  {
    "poem_id": 1501,
    "vorder": 176,
    "position": 1,
    "text": "مکن روز را بر دل خویش رخش"
  },
  {
    "poem_id": 1501,
    "vorder": 177,
    "position": 0,
    "text": "ترا داد و فرزند را هم دهد"
  },
  {
    "poem_id": 1501,
    "vorder": 178,
    "position": 1,
    "text": "درختی که از بیخ تو برجهد"
  },
  {
    "poem_id": 1501,
    "vorder": 179,
    "position": 0,
    "text": "نبینی که گنجش پر از خواستست"
  },
  {
    "poem_id": 1501,
    "vorder": 180,
    "position": 1,
    "text": "جهانی به خوبی بیاراستست"
  },
  {
    "poem_id": 1501,
    "vorder": 181,
    "position": 0,
    "text": "کمی نیست در بخشش دادگر"
  },
  {
    "poem_id": 1501,
    "vorder": 182,
    "position": 1,
    "text": "فزونی بخوردست انده مخور"
  }
]