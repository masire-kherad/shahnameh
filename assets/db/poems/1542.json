[
  {
    "poem_id": 1542,
    "vorder": 1,
    "position": 0,
    "text": "چو اسفندیار آن گو تهمتن"
  },
  {
    "poem_id": 1542,
    "vorder": 2,
    "position": 1,
    "text": "خداوند اورنگ با سهم و تن"
  },
  {
    "poem_id": 1542,
    "vorder": 3,
    "position": 0,
    "text": "ازان کوه بشنید بانگ پدر"
  },
  {
    "poem_id": 1542,
    "vorder": 4,
    "position": 1,
    "text": "به زاری به پیش اندر افگند سر"
  },
  {
    "poem_id": 1542,
    "vorder": 5,
    "position": 0,
    "text": "خرامیده نیزه به چنگ اندرون"
  },
  {
    "poem_id": 1542,
    "vorder": 6,
    "position": 1,
    "text": "ز پیش پدر سر فگنده نگون"
  },
  {
    "poem_id": 1542,
    "vorder": 7,
    "position": 0,
    "text": "یکی دیزه‌ای بر نشسته بلند"
  },
  {
    "poem_id": 1542,
    "vorder": 8,
    "position": 1,
    "text": "بسان یکی دیو جسته ز بند"
  },
  {
    "poem_id": 1542,
    "vorder": 9,
    "position": 0,
    "text": "بدان لشکر دشمن اندر فتاد"
  },
  {
    "poem_id": 1542,
    "vorder": 10,
    "position": 1,
    "text": "چنان چون در افتد به گلبرگ باد"
  },
  {
    "poem_id": 1542,
    "vorder": 11,
    "position": 0,
    "text": "همی کشت ازیشان و سر می‌برید"
  },
  {
    "poem_id": 1542,
    "vorder": 12,
    "position": 1,
    "text": "ز بیمش همی مرد هرکش بدید"
  },
  {
    "poem_id": 1542,
    "vorder": 13,
    "position": 0,
    "text": "چو بستور پور زریر سوار"
  },
  {
    "poem_id": 1542,
    "vorder": 14,
    "position": 1,
    "text": "ز خیمه خرامید زی اسپ‌دار"
  },
  {
    "poem_id": 1542,
    "vorder": 15,
    "position": 0,
    "text": "یکی اسپ آسودهٔ تیزرو"
  },
  {
    "poem_id": 1542,
    "vorder": 16,
    "position": 1,
    "text": "جهنده یکی بود آگنده خو"
  },
  {
    "poem_id": 1542,
    "vorder": 17,
    "position": 0,
    "text": "طلب کرد از اسپ‌دار پدر"
  },
  {
    "poem_id": 1542,
    "vorder": 18,
    "position": 1,
    "text": "نهاد از بر او یکی زین زر"
  },
  {
    "poem_id": 1542,
    "vorder": 19,
    "position": 0,
    "text": "بیاراست و برگستوران برفگند"
  },
  {
    "poem_id": 1542,
    "vorder": 20,
    "position": 1,
    "text": "به فتراک بر بست پیچان کمند"
  },
  {
    "poem_id": 1542,
    "vorder": 21,
    "position": 0,
    "text": "بپوشید جوشن بدو بر نشست"
  },
  {
    "poem_id": 1542,
    "vorder": 22,
    "position": 1,
    "text": "ز پنهان خرامید نیزه به دست"
  },
  {
    "poem_id": 1542,
    "vorder": 23,
    "position": 0,
    "text": "ازین سان خرامید تا رزمگاه"
  },
  {
    "poem_id": 1542,
    "vorder": 24,
    "position": 1,
    "text": "سوی باب کشته بپیمود راه"
  },
  {
    "poem_id": 1542,
    "vorder": 25,
    "position": 0,
    "text": "همی تاخت آن بارهٔ تیزگرد"
  },
  {
    "poem_id": 1542,
    "vorder": 26,
    "position": 1,
    "text": "همی آخت کینه همی کشت مرد"
  },
  {
    "poem_id": 1542,
    "vorder": 27,
    "position": 0,
    "text": "از آزادگان هرک دیدی به راه"
  },
  {
    "poem_id": 1542,
    "vorder": 28,
    "position": 1,
    "text": "بپرسیدی از نامدار سپاه"
  },
  {
    "poem_id": 1542,
    "vorder": 29,
    "position": 0,
    "text": "کجا اوفتادست گفتی زریر"
  },
  {
    "poem_id": 1542,
    "vorder": 30,
    "position": 1,
    "text": "پدر آن نبرده سوار دلیر"
  },
  {
    "poem_id": 1542,
    "vorder": 31,
    "position": 0,
    "text": "یکی مرد بد نام او اردشیر"
  },
  {
    "poem_id": 1542,
    "vorder": 32,
    "position": 1,
    "text": "سواری گرانمایه گردی دلیر"
  },
  {
    "poem_id": 1542,
    "vorder": 33,
    "position": 0,
    "text": "بپرسید ازو راه فرزند خرد"
  },
  {
    "poem_id": 1542,
    "vorder": 34,
    "position": 1,
    "text": "سوی بابکش راه بنمود گرد"
  },
  {
    "poem_id": 1542,
    "vorder": 35,
    "position": 0,
    "text": "فگندست گفتا میان سپاه"
  },
  {
    "poem_id": 1542,
    "vorder": 36,
    "position": 1,
    "text": "به نزدیکی آن درفش سیاه"
  },
  {
    "poem_id": 1542,
    "vorder": 37,
    "position": 0,
    "text": "برو زود کانجا فتادست اوی"
  },
  {
    "poem_id": 1542,
    "vorder": 38,
    "position": 1,
    "text": "مگر باز بینیش یک بار روی"
  },
  {
    "poem_id": 1542,
    "vorder": 39,
    "position": 0,
    "text": "پس آن شاهزاده برانگیخت بور"
  },
  {
    "poem_id": 1542,
    "vorder": 40,
    "position": 1,
    "text": "همی کشت گرد و همی کرد شور"
  },
  {
    "poem_id": 1542,
    "vorder": 41,
    "position": 0,
    "text": "بدان تاختن تا بر او رسید"
  },
  {
    "poem_id": 1542,
    "vorder": 42,
    "position": 1,
    "text": "چو او را بدان خاک کشته بدید"
  },
  {
    "poem_id": 1542,
    "vorder": 43,
    "position": 0,
    "text": "بدیدش مر او را چو نزدیک شد"
  },
  {
    "poem_id": 1542,
    "vorder": 44,
    "position": 1,
    "text": "جهان فروزانش تاریک شد"
  },
  {
    "poem_id": 1542,
    "vorder": 45,
    "position": 0,
    "text": "برفتش دل و هوش وز پشت زین"
  },
  {
    "poem_id": 1542,
    "vorder": 46,
    "position": 1,
    "text": "فگند از برش خویشتن بر زمین"
  },
  {
    "poem_id": 1542,
    "vorder": 47,
    "position": 0,
    "text": "همی گفت کای ماه تابان من"
  },
  {
    "poem_id": 1542,
    "vorder": 48,
    "position": 1,
    "text": "چراغ دل و دیده و جان من"
  },
  {
    "poem_id": 1542,
    "vorder": 49,
    "position": 0,
    "text": "بران رنج و سختی بپروردیم"
  },
  {
    "poem_id": 1542,
    "vorder": 50,
    "position": 1,
    "text": "کنون چون برفتی بکه اسپردیم"
  },
  {
    "poem_id": 1542,
    "vorder": 51,
    "position": 0,
    "text": "ترا تا سپه داد لهراسپ شاه"
  },
  {
    "poem_id": 1542,
    "vorder": 52,
    "position": 1,
    "text": "و گشتاسپ را داد تخت و کلاه"
  },
  {
    "poem_id": 1542,
    "vorder": 53,
    "position": 0,
    "text": "همی لشکر و کشور آراستی"
  },
  {
    "poem_id": 1542,
    "vorder": 54,
    "position": 1,
    "text": "همی رزم را به آرزو خواستی"
  },
  {
    "poem_id": 1542,
    "vorder": 55,
    "position": 0,
    "text": "کنون کت به گیتی برافروخت نام"
  },
  {
    "poem_id": 1542,
    "vorder": 56,
    "position": 1,
    "text": "شدی کشته و نارسیده به کام"
  },
  {
    "poem_id": 1542,
    "vorder": 57,
    "position": 0,
    "text": "شوم زی برادرت فرخنده شاه"
  },
  {
    "poem_id": 1542,
    "vorder": 58,
    "position": 1,
    "text": "فرود آی گویمش از خوب گاه"
  },
  {
    "poem_id": 1542,
    "vorder": 59,
    "position": 0,
    "text": "که از تو نه این بد سزاوار اوی"
  },
  {
    "poem_id": 1542,
    "vorder": 60,
    "position": 1,
    "text": "برو کینش از دشمنان بازجوی"
  },
  {
    "poem_id": 1542,
    "vorder": 61,
    "position": 0,
    "text": "زمانی برین سان همی بود دیر"
  },
  {
    "poem_id": 1542,
    "vorder": 62,
    "position": 1,
    "text": "پس آن باره را اندر آورد زیر"
  },
  {
    "poem_id": 1542,
    "vorder": 63,
    "position": 0,
    "text": "همی رفت با بانگ تا نزد شاه"
  },
  {
    "poem_id": 1542,
    "vorder": 64,
    "position": 1,
    "text": "که بنشسته بود از بر رزمگاه"
  },
  {
    "poem_id": 1542,
    "vorder": 65,
    "position": 0,
    "text": "شه خسروان گفت کای جان باب"
  },
  {
    "poem_id": 1542,
    "vorder": 66,
    "position": 1,
    "text": "چرا کردی این دیدگان پر ز آب"
  },
  {
    "poem_id": 1542,
    "vorder": 67,
    "position": 0,
    "text": "کیان زاده گفت ای جهانگیر شاه"
  },
  {
    "poem_id": 1542,
    "vorder": 68,
    "position": 1,
    "text": "نبینی که بابم شد اکنون تباه"
  },
  {
    "poem_id": 1542,
    "vorder": 69,
    "position": 0,
    "text": "پس آنگاه گفت ای جهانگیر شاه"
  },
  {
    "poem_id": 1542,
    "vorder": 70,
    "position": 1,
    "text": "برو کینهٔ باب من بازخواه"
  },
  {
    "poem_id": 1542,
    "vorder": 71,
    "position": 0,
    "text": "بماندست بابم بران خاک خشک"
  },
  {
    "poem_id": 1542,
    "vorder": 72,
    "position": 1,
    "text": "سیه ریش او پروریده به مشک"
  },
  {
    "poem_id": 1542,
    "vorder": 73,
    "position": 0,
    "text": "چواز پور بشنید شاه این سخن"
  },
  {
    "poem_id": 1542,
    "vorder": 74,
    "position": 1,
    "text": "سیاهش ببد روز روشن ز بن"
  },
  {
    "poem_id": 1542,
    "vorder": 75,
    "position": 0,
    "text": "جهان بر جهانجوی تاریک شد"
  },
  {
    "poem_id": 1542,
    "vorder": 76,
    "position": 1,
    "text": "تن پیل واریش باریک شد"
  },
  {
    "poem_id": 1542,
    "vorder": 77,
    "position": 0,
    "text": "بیارید گفتا سیاه مرا"
  },
  {
    "poem_id": 1542,
    "vorder": 78,
    "position": 1,
    "text": "نبردی قبا و کلاه مرا"
  },
  {
    "poem_id": 1542,
    "vorder": 79,
    "position": 0,
    "text": "که امروز من از پی کین اوی"
  },
  {
    "poem_id": 1542,
    "vorder": 80,
    "position": 1,
    "text": "برانم ازین دشمنان خون به جوی"
  },
  {
    "poem_id": 1542,
    "vorder": 81,
    "position": 0,
    "text": "یکی آتش انگیزم اندر جهان"
  },
  {
    "poem_id": 1542,
    "vorder": 82,
    "position": 1,
    "text": "کزانجا به کیوان رسد دود آن"
  },
  {
    "poem_id": 1542,
    "vorder": 83,
    "position": 0,
    "text": "چو گردان بدیدند کز رزمگاه"
  },
  {
    "poem_id": 1542,
    "vorder": 84,
    "position": 1,
    "text": "ازان تیره آوردگاه سپاه"
  },
  {
    "poem_id": 1542,
    "vorder": 85,
    "position": 0,
    "text": "که خسرو بسیچید آراستن"
  },
  {
    "poem_id": 1542,
    "vorder": 86,
    "position": 1,
    "text": "همی رفت خواهد به کین خواستن"
  },
  {
    "poem_id": 1542,
    "vorder": 87,
    "position": 0,
    "text": "نباشیم گفتند همداستان"
  },
  {
    "poem_id": 1542,
    "vorder": 88,
    "position": 1,
    "text": "که شاهنشه آن کدخدای جهان"
  },
  {
    "poem_id": 1542,
    "vorder": 89,
    "position": 0,
    "text": "به رزم اندر آید به کین خواستن"
  },
  {
    "poem_id": 1542,
    "vorder": 90,
    "position": 1,
    "text": "چرا باید این لشکر آراستن"
  },
  {
    "poem_id": 1542,
    "vorder": 91,
    "position": 0,
    "text": "گرانمایه دستور گفتش به شاه"
  },
  {
    "poem_id": 1542,
    "vorder": 92,
    "position": 1,
    "text": "نبایدت رفتن بدان رزمگاه"
  },
  {
    "poem_id": 1542,
    "vorder": 93,
    "position": 0,
    "text": "به بستور ده بارهٔ برنشست"
  },
  {
    "poem_id": 1542,
    "vorder": 94,
    "position": 1,
    "text": "مر او را سوی رزم دشمن فرست"
  },
  {
    "poem_id": 1542,
    "vorder": 95,
    "position": 0,
    "text": "که او آورد باز کین پدر"
  },
  {
    "poem_id": 1542,
    "vorder": 96,
    "position": 1,
    "text": "ازان کش تو باز آوری خوب‌تر"
  }
]