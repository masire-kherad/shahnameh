[
  {
    "poem_id": 1914,
    "vorder": 1,
    "position": 0,
    "text": "چوبشنید شیروی بگریست سخت"
  },
  {
    "poem_id": 1914,
    "vorder": 2,
    "position": 1,
    "text": "دلش گشت ترسان ازان تاج وتخت"
  },
  {
    "poem_id": 1914,
    "vorder": 3,
    "position": 0,
    "text": "چوازپیش برخاستند آن گروه"
  },
  {
    "poem_id": 1914,
    "vorder": 4,
    "position": 1,
    "text": "که او راهمی‌داشتندی ستوه"
  },
  {
    "poem_id": 1914,
    "vorder": 5,
    "position": 0,
    "text": "به گفتار زشت و به خون پدر"
  },
  {
    "poem_id": 1914,
    "vorder": 6,
    "position": 1,
    "text": "جوان را همی‌سوختندی جگر"
  },
  {
    "poem_id": 1914,
    "vorder": 7,
    "position": 0,
    "text": "فرود آمد از تخت شاهی قباد"
  },
  {
    "poem_id": 1914,
    "vorder": 8,
    "position": 1,
    "text": "دودست گرامی به سر برنهاد"
  },
  {
    "poem_id": 1914,
    "vorder": 9,
    "position": 0,
    "text": "ز مژگان همی بر برش خون چکید"
  },
  {
    "poem_id": 1914,
    "vorder": 10,
    "position": 1,
    "text": "چو آگاهی او به دشمن رسید"
  },
  {
    "poem_id": 1914,
    "vorder": 11,
    "position": 0,
    "text": "چوبرزد سرازتیره کوه آفتاب"
  },
  {
    "poem_id": 1914,
    "vorder": 12,
    "position": 1,
    "text": "بد اندیش را سر بر آمد ز خواب"
  },
  {
    "poem_id": 1914,
    "vorder": 13,
    "position": 0,
    "text": "برفتند یکسر سوی بارگاه"
  },
  {
    "poem_id": 1914,
    "vorder": 14,
    "position": 1,
    "text": "چو بشنید بنشست برگاه شاه"
  },
  {
    "poem_id": 1914,
    "vorder": 15,
    "position": 0,
    "text": "برفتند گردنکشان پیش او"
  },
  {
    "poem_id": 1914,
    "vorder": 16,
    "position": 1,
    "text": "ز گردان بیگانه و خویش او"
  },
  {
    "poem_id": 1914,
    "vorder": 17,
    "position": 0,
    "text": "نشستند با روی کرده دژم"
  },
  {
    "poem_id": 1914,
    "vorder": 18,
    "position": 1,
    "text": "زبانش نجنبید بر بیش و کم"
  },
  {
    "poem_id": 1914,
    "vorder": 19,
    "position": 0,
    "text": "بدانست کایشان بدانسان دژم"
  },
  {
    "poem_id": 1914,
    "vorder": 20,
    "position": 1,
    "text": "نشسته چرایند بادرد وغم"
  },
  {
    "poem_id": 1914,
    "vorder": 21,
    "position": 0,
    "text": "بدیشان چنین گفت کان شهریار"
  },
  {
    "poem_id": 1914,
    "vorder": 22,
    "position": 1,
    "text": "کجا باشد از پشت پروردگار"
  },
  {
    "poem_id": 1914,
    "vorder": 23,
    "position": 0,
    "text": "که غمگین نباشد به درد پدر"
  },
  {
    "poem_id": 1914,
    "vorder": 24,
    "position": 1,
    "text": "نخوانمش جز بد تن و بد گهر"
  },
  {
    "poem_id": 1914,
    "vorder": 25,
    "position": 0,
    "text": "نباید که دارد بدو کس امید"
  },
  {
    "poem_id": 1914,
    "vorder": 26,
    "position": 1,
    "text": "که او پوده‌تر باشد از پوده بید"
  },
  {
    "poem_id": 1914,
    "vorder": 27,
    "position": 0,
    "text": "چنین یافت پاسخ زمرد گناه"
  },
  {
    "poem_id": 1914,
    "vorder": 28,
    "position": 1,
    "text": "که هرکس که گوید پرستم دو شاه"
  },
  {
    "poem_id": 1914,
    "vorder": 29,
    "position": 0,
    "text": "تو او رابه دل نا هشیوار خوان"
  },
  {
    "poem_id": 1914,
    "vorder": 30,
    "position": 1,
    "text": "وگر ارجمندی بود خوار خوان"
  },
  {
    "poem_id": 1914,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد شیروی پاسخ که شاه"
  },
  {
    "poem_id": 1914,
    "vorder": 32,
    "position": 1,
    "text": "چو بی گنج باشد نیرزد سپاه"
  },
  {
    "poem_id": 1914,
    "vorder": 33,
    "position": 0,
    "text": "سخن خوب رانیم یک ماه نیز"
  },
  {
    "poem_id": 1914,
    "vorder": 34,
    "position": 1,
    "text": "ز راه درشتی نگوییم چیز"
  },
  {
    "poem_id": 1914,
    "vorder": 35,
    "position": 0,
    "text": "مگر شاد باشیم ز اندرز او"
  },
  {
    "poem_id": 1914,
    "vorder": 36,
    "position": 1,
    "text": "که گنجست سرتاسر این مرز او"
  },
  {
    "poem_id": 1914,
    "vorder": 37,
    "position": 0,
    "text": "چو پاسخ شنیدند برخاستند"
  },
  {
    "poem_id": 1914,
    "vorder": 38,
    "position": 1,
    "text": "سوی خانه‌ها رفتن آراستند"
  },
  {
    "poem_id": 1914,
    "vorder": 39,
    "position": 0,
    "text": "به خوالیگران شاه شیروی گفت"
  },
  {
    "poem_id": 1914,
    "vorder": 40,
    "position": 1,
    "text": "که چیزی ز خسرو نباید نهفت"
  },
  {
    "poem_id": 1914,
    "vorder": 41,
    "position": 0,
    "text": "به پیشش همه خوان زرین نهید"
  },
  {
    "poem_id": 1914,
    "vorder": 42,
    "position": 1,
    "text": "خورشها بر و چرب و شیرین نهید"
  },
  {
    "poem_id": 1914,
    "vorder": 43,
    "position": 0,
    "text": "برنده همی‌برد و خسرو نخورد"
  },
  {
    "poem_id": 1914,
    "vorder": 44,
    "position": 1,
    "text": "ز چیزی که دیدی بخوان گرم و سرد"
  },
  {
    "poem_id": 1914,
    "vorder": 45,
    "position": 0,
    "text": "همه خوردش از دست شیرین بدی"
  },
  {
    "poem_id": 1914,
    "vorder": 46,
    "position": 1,
    "text": "که شیرین بخوردنش غمگین بدی"
  }
]