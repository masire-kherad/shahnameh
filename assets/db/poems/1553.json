[
  {
    "poem_id": 1553,
    "vorder": 1,
    "position": 0,
    "text": "کنون رزم ارجاسپ را نو کنیم"
  },
  {
    "poem_id": 1553,
    "vorder": 2,
    "position": 1,
    "text": "به طبع روان باغ بی خو کنیم"
  },
  {
    "poem_id": 1553,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا کهرم تیغ‌زن"
  },
  {
    "poem_id": 1553,
    "vorder": 4,
    "position": 1,
    "text": "بود پیش سالار آن انجمن"
  },
  {
    "poem_id": 1553,
    "vorder": 5,
    "position": 0,
    "text": "که ارجاسپ را بود مهتر پسر"
  },
  {
    "poem_id": 1553,
    "vorder": 6,
    "position": 1,
    "text": "به خورشید تابان برآورده سر"
  },
  {
    "poem_id": 1553,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت بگزین ز لشکر سوار"
  },
  {
    "poem_id": 1553,
    "vorder": 8,
    "position": 1,
    "text": "ز ترکان شایسته مردی هزار"
  },
  {
    "poem_id": 1553,
    "vorder": 9,
    "position": 0,
    "text": "از ایدر برو تازیان تا به بلخ"
  },
  {
    "poem_id": 1553,
    "vorder": 10,
    "position": 1,
    "text": "که از بلخ شد روز ما تار و تلخ"
  },
  {
    "poem_id": 1553,
    "vorder": 11,
    "position": 0,
    "text": "نگر تا کرا یابی از دشمنان"
  },
  {
    "poem_id": 1553,
    "vorder": 12,
    "position": 1,
    "text": "از آتش پرستان و آهرمنان"
  },
  {
    "poem_id": 1553,
    "vorder": 13,
    "position": 0,
    "text": "سرانشان ببر خانهاشان بسوز"
  },
  {
    "poem_id": 1553,
    "vorder": 14,
    "position": 1,
    "text": "بریشان شب آور به رخشنده روز"
  },
  {
    "poem_id": 1553,
    "vorder": 15,
    "position": 0,
    "text": "از ایوان گشتاسپ باید که دود"
  },
  {
    "poem_id": 1553,
    "vorder": 16,
    "position": 1,
    "text": "زبانه برآرد به چرخ کبود"
  },
  {
    "poem_id": 1553,
    "vorder": 17,
    "position": 0,
    "text": "اگر بند بر پای اسفندیار"
  },
  {
    "poem_id": 1553,
    "vorder": 18,
    "position": 1,
    "text": "بیابی سرآور برو روزگار"
  },
  {
    "poem_id": 1553,
    "vorder": 19,
    "position": 0,
    "text": "هم‌آنگه سرش را ز تن بازکن"
  },
  {
    "poem_id": 1553,
    "vorder": 20,
    "position": 1,
    "text": "وزین روی گیتی پرآواز کن"
  },
  {
    "poem_id": 1553,
    "vorder": 21,
    "position": 0,
    "text": "همه شهر ایران به کام تو گشت"
  },
  {
    "poem_id": 1553,
    "vorder": 22,
    "position": 1,
    "text": "تو تیغی و دشمن نیام تو گشت"
  },
  {
    "poem_id": 1553,
    "vorder": 23,
    "position": 0,
    "text": "من اکنون ز خلخ به اندک زمان"
  },
  {
    "poem_id": 1553,
    "vorder": 24,
    "position": 1,
    "text": "بیایم دمادم چو باد دمان"
  },
  {
    "poem_id": 1553,
    "vorder": 25,
    "position": 0,
    "text": "بخوانم سپاه پراگنده را"
  },
  {
    "poem_id": 1553,
    "vorder": 26,
    "position": 1,
    "text": "برافشانم این گنج آگنده را"
  },
  {
    "poem_id": 1553,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت کهرم که فرمان کنم"
  },
  {
    "poem_id": 1553,
    "vorder": 28,
    "position": 1,
    "text": "ز فرمان تو رامش جان کنم"
  },
  {
    "poem_id": 1553,
    "vorder": 29,
    "position": 0,
    "text": "چو خورشید تیغ از میان برکشید"
  },
  {
    "poem_id": 1553,
    "vorder": 30,
    "position": 1,
    "text": "سپاه شب تیره شد ناپدید"
  },
  {
    "poem_id": 1553,
    "vorder": 31,
    "position": 0,
    "text": "بیاورد کهرم ز توران سپاه"
  },
  {
    "poem_id": 1553,
    "vorder": 32,
    "position": 1,
    "text": "جهان گشت چون روی زنگی سیاه"
  },
  {
    "poem_id": 1553,
    "vorder": 33,
    "position": 0,
    "text": "چو آمد بران مرز بگشاد دست"
  },
  {
    "poem_id": 1553,
    "vorder": 34,
    "position": 1,
    "text": "کسی را که بد پیش آذرپرست"
  },
  {
    "poem_id": 1553,
    "vorder": 35,
    "position": 0,
    "text": "چو ترکان رسیدند نزدیک بلخ"
  },
  {
    "poem_id": 1553,
    "vorder": 36,
    "position": 1,
    "text": "گشاده زبان را به گفتار تلخ"
  },
  {
    "poem_id": 1553,
    "vorder": 37,
    "position": 0,
    "text": "ز کهرم چو لهراسپ آگاه شد"
  },
  {
    "poem_id": 1553,
    "vorder": 38,
    "position": 1,
    "text": "غمی گشت و با رنج همراه شد"
  },
  {
    "poem_id": 1553,
    "vorder": 39,
    "position": 0,
    "text": "به یزدان چنین گفت کای کردگار"
  },
  {
    "poem_id": 1553,
    "vorder": 40,
    "position": 1,
    "text": "توی برتر از گردش روزگار"
  },
  {
    "poem_id": 1553,
    "vorder": 41,
    "position": 0,
    "text": "توانا و دانا و پاینده‌ای"
  },
  {
    "poem_id": 1553,
    "vorder": 42,
    "position": 1,
    "text": "خداوند خورشید تابنده‌ای"
  },
  {
    "poem_id": 1553,
    "vorder": 43,
    "position": 0,
    "text": "نگهدار دین و تن و هوش من"
  },
  {
    "poem_id": 1553,
    "vorder": 44,
    "position": 1,
    "text": "همان نیروی جان وگر توش من"
  },
  {
    "poem_id": 1553,
    "vorder": 45,
    "position": 0,
    "text": "که من بنده بر دست ایشان تباه"
  },
  {
    "poem_id": 1553,
    "vorder": 46,
    "position": 1,
    "text": "نگردم توی پشت و فریادخواه"
  },
  {
    "poem_id": 1553,
    "vorder": 47,
    "position": 0,
    "text": "به بلخ اندرون نامداری نبود"
  },
  {
    "poem_id": 1553,
    "vorder": 48,
    "position": 1,
    "text": "وزان گُرزداران سواری نبود"
  },
  {
    "poem_id": 1553,
    "vorder": 49,
    "position": 0,
    "text": "بیامد ز بازار مردی هزار"
  },
  {
    "poem_id": 1553,
    "vorder": 50,
    "position": 1,
    "text": "چنانچون بود از در کارزار"
  },
  {
    "poem_id": 1553,
    "vorder": 51,
    "position": 0,
    "text": "چو توران سپاه اندر آمد به تنگ"
  },
  {
    "poem_id": 1553,
    "vorder": 52,
    "position": 1,
    "text": "بپوشید لهراسپ خفتان جنگ"
  },
  {
    "poem_id": 1553,
    "vorder": 53,
    "position": 0,
    "text": "ز جای پرستش به آوردگاه"
  },
  {
    "poem_id": 1553,
    "vorder": 54,
    "position": 1,
    "text": "بیامد به سر بر کیانی کلاه"
  },
  {
    "poem_id": 1553,
    "vorder": 55,
    "position": 0,
    "text": "به پیری بغرید چون پیل مست"
  },
  {
    "poem_id": 1553,
    "vorder": 56,
    "position": 1,
    "text": "یکی گُرزهٔ گاو پیکر به دست"
  },
  {
    "poem_id": 1553,
    "vorder": 57,
    "position": 0,
    "text": "به هر حمله‌ای جادوی زان سران"
  },
  {
    "poem_id": 1553,
    "vorder": 58,
    "position": 1,
    "text": "سپردی زمین را به گُرز گران"
  },
  {
    "poem_id": 1553,
    "vorder": 59,
    "position": 0,
    "text": "همی گفت هرکس که این نامدار"
  },
  {
    "poem_id": 1553,
    "vorder": 60,
    "position": 1,
    "text": "نباشد جز از گرد اسفندیار"
  },
  {
    "poem_id": 1553,
    "vorder": 61,
    "position": 0,
    "text": "به هر سو که باره برانگیختی"
  },
  {
    "poem_id": 1553,
    "vorder": 62,
    "position": 1,
    "text": "همی خاک با خون برآمیختی"
  },
  {
    "poem_id": 1553,
    "vorder": 63,
    "position": 0,
    "text": "هرانکس که آواز او یافتی"
  },
  {
    "poem_id": 1553,
    "vorder": 64,
    "position": 1,
    "text": "به تنش اندرون زهره بشکافتی"
  },
  {
    "poem_id": 1553,
    "vorder": 65,
    "position": 0,
    "text": "به ترکان چنین گفت کهرم که چنگ"
  },
  {
    "poem_id": 1553,
    "vorder": 66,
    "position": 1,
    "text": "میازید با او یکایک به جنگ"
  },
  {
    "poem_id": 1553,
    "vorder": 67,
    "position": 0,
    "text": "بکوشید و اندر میانش آورید"
  },
  {
    "poem_id": 1553,
    "vorder": 68,
    "position": 1,
    "text": "خروش هژبر ژیان آورید"
  },
  {
    "poem_id": 1553,
    "vorder": 69,
    "position": 0,
    "text": "برآمد چکاچاک زخم تبر"
  },
  {
    "poem_id": 1553,
    "vorder": 70,
    "position": 1,
    "text": "خروش سواران پرخاشخر"
  },
  {
    "poem_id": 1553,
    "vorder": 71,
    "position": 0,
    "text": "چو لهراسپ اندر میانه بماند"
  },
  {
    "poem_id": 1553,
    "vorder": 72,
    "position": 1,
    "text": "به بیچارگی نام یزدان بخواند"
  },
  {
    "poem_id": 1553,
    "vorder": 73,
    "position": 0,
    "text": "ز پیری و از تابش آفتاب"
  },
  {
    "poem_id": 1553,
    "vorder": 74,
    "position": 1,
    "text": "غمی گشت و بخت اندر آمد به خواب"
  },
  {
    "poem_id": 1553,
    "vorder": 75,
    "position": 0,
    "text": "جهاندیده از تیر ترکان بخست"
  },
  {
    "poem_id": 1553,
    "vorder": 76,
    "position": 1,
    "text": "نگونسار شد مرد یزدان پرست"
  },
  {
    "poem_id": 1553,
    "vorder": 77,
    "position": 0,
    "text": "به خاک اندر آمد سر تاجدار"
  },
  {
    "poem_id": 1553,
    "vorder": 78,
    "position": 1,
    "text": "برو انجمن شد فراوان سوار"
  },
  {
    "poem_id": 1553,
    "vorder": 79,
    "position": 0,
    "text": "بکردند چاک آن بر و جوشنش"
  },
  {
    "poem_id": 1553,
    "vorder": 80,
    "position": 1,
    "text": "به شمشیر شد پاره‌پاره تنش"
  },
  {
    "poem_id": 1553,
    "vorder": 81,
    "position": 0,
    "text": "همی نوسواریش پنداشتند"
  },
  {
    "poem_id": 1553,
    "vorder": 82,
    "position": 1,
    "text": "چو خود از سر شاه برداشتند"
  },
  {
    "poem_id": 1553,
    "vorder": 83,
    "position": 0,
    "text": "رخی لعل دیدند و کافور موی"
  },
  {
    "poem_id": 1553,
    "vorder": 84,
    "position": 1,
    "text": "از آهن سیاه آن بهشتیش روی"
  },
  {
    "poem_id": 1553,
    "vorder": 85,
    "position": 0,
    "text": "بماندند یکسر ازو در شگفت"
  },
  {
    "poem_id": 1553,
    "vorder": 86,
    "position": 1,
    "text": "که این پیر شمشیر چون برگرفت"
  },
  {
    "poem_id": 1553,
    "vorder": 87,
    "position": 0,
    "text": "کزین گونه اسفندیار آمدی"
  },
  {
    "poem_id": 1553,
    "vorder": 88,
    "position": 1,
    "text": "سپه را برین دشت کار آمدی"
  },
  {
    "poem_id": 1553,
    "vorder": 89,
    "position": 0,
    "text": "بدین اندکی ما چرا آمدیم"
  },
  {
    "poem_id": 1553,
    "vorder": 90,
    "position": 1,
    "text": "همی بی‌گله در چرا آمدیم"
  },
  {
    "poem_id": 1553,
    "vorder": 91,
    "position": 0,
    "text": "به ترکان چنین گفت کهرم که کار"
  },
  {
    "poem_id": 1553,
    "vorder": 92,
    "position": 1,
    "text": "همین بودمان رنج در کارزار"
  },
  {
    "poem_id": 1553,
    "vorder": 93,
    "position": 0,
    "text": "که این نامور شاه لهراسپ است"
  },
  {
    "poem_id": 1553,
    "vorder": 94,
    "position": 1,
    "text": "که پورش جهاندار گشتاسپ است"
  },
  {
    "poem_id": 1553,
    "vorder": 95,
    "position": 0,
    "text": "جهاندار با فر یزدان بود"
  },
  {
    "poem_id": 1553,
    "vorder": 96,
    "position": 1,
    "text": "همه کار او رزم و میدان بود"
  },
  {
    "poem_id": 1553,
    "vorder": 97,
    "position": 0,
    "text": "جز این نیز کاین خود پرستنده بود"
  },
  {
    "poem_id": 1553,
    "vorder": 98,
    "position": 1,
    "text": "دل از تاج وز تخت برکنده بود"
  },
  {
    "poem_id": 1553,
    "vorder": 99,
    "position": 0,
    "text": "کنون پشت گشتاسپ زو شد تهی"
  },
  {
    "poem_id": 1553,
    "vorder": 100,
    "position": 1,
    "text": "بپیچد ز دیهیم شاهنشهی"
  },
  {
    "poem_id": 1553,
    "vorder": 101,
    "position": 0,
    "text": "از آنجا به بلخ اندر آمد سپاه"
  },
  {
    "poem_id": 1553,
    "vorder": 102,
    "position": 1,
    "text": "جهان شد ز تاراج و کشتن سیاه"
  },
  {
    "poem_id": 1553,
    "vorder": 103,
    "position": 0,
    "text": "نهادند سر سوی آتشکده"
  },
  {
    "poem_id": 1553,
    "vorder": 104,
    "position": 1,
    "text": "بران کاخ و ایوان زر آژده"
  },
  {
    "poem_id": 1553,
    "vorder": 105,
    "position": 0,
    "text": "همه زند و استش همی سوختند"
  },
  {
    "poem_id": 1553,
    "vorder": 106,
    "position": 1,
    "text": "چه پرمایه‌تر بود برتوختند"
  },
  {
    "poem_id": 1553,
    "vorder": 107,
    "position": 0,
    "text": "از ایرانیان بود هشتاد مرد"
  },
  {
    "poem_id": 1553,
    "vorder": 108,
    "position": 1,
    "text": "زبانشان ز یزدان پر از یاد کرد"
  },
  {
    "poem_id": 1553,
    "vorder": 109,
    "position": 0,
    "text": "همه پیش آتش بکشتندشان"
  },
  {
    "poem_id": 1553,
    "vorder": 110,
    "position": 1,
    "text": "ره بندگی بر نوشتندشان"
  },
  {
    "poem_id": 1553,
    "vorder": 111,
    "position": 0,
    "text": "ز خونشان بمرد آتش زرد هشت"
  },
  {
    "poem_id": 1553,
    "vorder": 112,
    "position": 1,
    "text": "ندانم جزا جایشان جز بهشت"
  }
]