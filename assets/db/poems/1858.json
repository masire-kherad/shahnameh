[
  {
    "poem_id": 1858,
    "vorder": 1,
    "position": 0,
    "text": "هم آنگه یکی نامه بنوشت زود"
  },
  {
    "poem_id": 1858,
    "vorder": 2,
    "position": 1,
    "text": "بران آفرین آفرین بر فزود"
  },
  {
    "poem_id": 1858,
    "vorder": 3,
    "position": 0,
    "text": "که با موبد یکدل و پاک رای"
  },
  {
    "poem_id": 1858,
    "vorder": 4,
    "position": 1,
    "text": "زدیم از بد و نیک ناباک رای"
  },
  {
    "poem_id": 1858,
    "vorder": 5,
    "position": 0,
    "text": "ز هرگونه‌ای داستانها زدیم"
  },
  {
    "poem_id": 1858,
    "vorder": 6,
    "position": 1,
    "text": "بران رای پیشینه باز آمدیم"
  },
  {
    "poem_id": 1858,
    "vorder": 7,
    "position": 0,
    "text": "کنون رای و گفتارها شد ببن"
  },
  {
    "poem_id": 1858,
    "vorder": 8,
    "position": 1,
    "text": "گشادم در گنجهای کهن"
  },
  {
    "poem_id": 1858,
    "vorder": 9,
    "position": 0,
    "text": "به قسطنیه در فراوان سپاه"
  },
  {
    "poem_id": 1858,
    "vorder": 10,
    "position": 1,
    "text": "ندارم که دارند کشور نگاه"
  },
  {
    "poem_id": 1858,
    "vorder": 11,
    "position": 0,
    "text": "سخنها ز هرگونه آراستیم"
  },
  {
    "poem_id": 1858,
    "vorder": 12,
    "position": 1,
    "text": "ز هر کشوری لشکری خواستیم"
  },
  {
    "poem_id": 1858,
    "vorder": 13,
    "position": 0,
    "text": "یکایک چوآیند هم در زمان"
  },
  {
    "poem_id": 1858,
    "vorder": 14,
    "position": 1,
    "text": "فرستیم نزدیک تو بی گمان"
  },
  {
    "poem_id": 1858,
    "vorder": 15,
    "position": 0,
    "text": "همه مولش و رای چندین زدن"
  },
  {
    "poem_id": 1858,
    "vorder": 16,
    "position": 1,
    "text": "برین نیشتر کام شیر آژدن"
  },
  {
    "poem_id": 1858,
    "vorder": 17,
    "position": 0,
    "text": "ازان بد که کردارهای کهن"
  },
  {
    "poem_id": 1858,
    "vorder": 18,
    "position": 1,
    "text": "همی یاد کرد آنک داند سخن"
  },
  {
    "poem_id": 1858,
    "vorder": 19,
    "position": 0,
    "text": "که هنگام شاپور شاه اردشیر"
  },
  {
    "poem_id": 1858,
    "vorder": 20,
    "position": 1,
    "text": "دل مرد برناشد از رنج سیر"
  },
  {
    "poem_id": 1858,
    "vorder": 21,
    "position": 0,
    "text": "ز بس غارت و کشتن و تاختن"
  },
  {
    "poem_id": 1858,
    "vorder": 22,
    "position": 1,
    "text": "به بیداد برکینها ساختن"
  },
  {
    "poem_id": 1858,
    "vorder": 23,
    "position": 0,
    "text": "کزو بگذری هرمز و کی قباد"
  },
  {
    "poem_id": 1858,
    "vorder": 24,
    "position": 1,
    "text": "که از داد یزدان نکردند یاد"
  },
  {
    "poem_id": 1858,
    "vorder": 25,
    "position": 0,
    "text": "نیای تو آن شاه نوشین روان"
  },
  {
    "poem_id": 1858,
    "vorder": 26,
    "position": 1,
    "text": "که از داد او پیر سر شد جوان"
  },
  {
    "poem_id": 1858,
    "vorder": 27,
    "position": 0,
    "text": "همه روم ازو شد سراسر خراب"
  },
  {
    "poem_id": 1858,
    "vorder": 28,
    "position": 1,
    "text": "چناچون که ایران ز افراسیاب"
  },
  {
    "poem_id": 1858,
    "vorder": 29,
    "position": 0,
    "text": "ازین مرز ما سی و نه شارستان"
  },
  {
    "poem_id": 1858,
    "vorder": 30,
    "position": 1,
    "text": "از ایرانیان شد همه خارستان"
  },
  {
    "poem_id": 1858,
    "vorder": 31,
    "position": 0,
    "text": "ز خون سران دشت شد آبگیر"
  },
  {
    "poem_id": 1858,
    "vorder": 32,
    "position": 1,
    "text": "زن و کودکانشان ببردند اسیر"
  },
  {
    "poem_id": 1858,
    "vorder": 33,
    "position": 0,
    "text": "اگر مرد رومی به دل کین گرفت"
  },
  {
    "poem_id": 1858,
    "vorder": 34,
    "position": 1,
    "text": "نباید که آید تو را آن شگفت"
  },
  {
    "poem_id": 1858,
    "vorder": 35,
    "position": 0,
    "text": "خود آزردنی نیست در دین ما"
  },
  {
    "poem_id": 1858,
    "vorder": 36,
    "position": 1,
    "text": "مبادا بدی کردن آیین ما"
  },
  {
    "poem_id": 1858,
    "vorder": 37,
    "position": 0,
    "text": "ندیدیم چیزی به از راستی"
  },
  {
    "poem_id": 1858,
    "vorder": 38,
    "position": 1,
    "text": "همان دوری از کژی و کاستی"
  },
  {
    "poem_id": 1858,
    "vorder": 39,
    "position": 0,
    "text": "ستمدیدگان را همه خواندم"
  },
  {
    "poem_id": 1858,
    "vorder": 40,
    "position": 1,
    "text": "وزین در فراوان سخن راندم"
  },
  {
    "poem_id": 1858,
    "vorder": 41,
    "position": 0,
    "text": "به افسون دل مردمان پاک شد"
  },
  {
    "poem_id": 1858,
    "vorder": 42,
    "position": 1,
    "text": "همه زهر گیرنده تریاک شد"
  },
  {
    "poem_id": 1858,
    "vorder": 43,
    "position": 0,
    "text": "بدان برنهادم کزین درسخن"
  },
  {
    "poem_id": 1858,
    "vorder": 44,
    "position": 1,
    "text": "نگوید کس از روزگار کهن"
  },
  {
    "poem_id": 1858,
    "vorder": 45,
    "position": 0,
    "text": "به چیزی که گویی تو فرمان کنم"
  },
  {
    "poem_id": 1858,
    "vorder": 46,
    "position": 1,
    "text": "روان را به پیمان گروگان کنم"
  },
  {
    "poem_id": 1858,
    "vorder": 47,
    "position": 0,
    "text": "شما را زبان داد باید همان"
  },
  {
    "poem_id": 1858,
    "vorder": 48,
    "position": 1,
    "text": "که بر ما نباشد کسی بدگمان"
  },
  {
    "poem_id": 1858,
    "vorder": 49,
    "position": 0,
    "text": "بگویی که تا من بوم شهریار"
  },
  {
    "poem_id": 1858,
    "vorder": 50,
    "position": 1,
    "text": "نگیرم چنین رنجها سست وخوار"
  },
  {
    "poem_id": 1858,
    "vorder": 51,
    "position": 0,
    "text": "نخواهم من از رومیان باژ نیز"
  },
  {
    "poem_id": 1858,
    "vorder": 52,
    "position": 1,
    "text": "نه بفروشم این رنجها را بچیز"
  },
  {
    "poem_id": 1858,
    "vorder": 53,
    "position": 0,
    "text": "دگر هرچ دارید زان مرز و بوم"
  },
  {
    "poem_id": 1858,
    "vorder": 54,
    "position": 1,
    "text": "از ایران کسی نسپرد مرز روم"
  },
  {
    "poem_id": 1858,
    "vorder": 55,
    "position": 0,
    "text": "بدین آرزو نیز بیشی کنید"
  },
  {
    "poem_id": 1858,
    "vorder": 56,
    "position": 1,
    "text": "بسازید با ما و خویشی کنید"
  },
  {
    "poem_id": 1858,
    "vorder": 57,
    "position": 0,
    "text": "شما را هر آنگه که کاری بود"
  },
  {
    "poem_id": 1858,
    "vorder": 58,
    "position": 1,
    "text": "وگر ناسزا کارزاری بود"
  },
  {
    "poem_id": 1858,
    "vorder": 59,
    "position": 0,
    "text": "همه دوستدار و برادر شویم"
  },
  {
    "poem_id": 1858,
    "vorder": 60,
    "position": 1,
    "text": "بود نیز گاهی که کهتر شویم"
  },
  {
    "poem_id": 1858,
    "vorder": 61,
    "position": 0,
    "text": "چو گردید زین شهر ما بی‌نیاز"
  },
  {
    "poem_id": 1858,
    "vorder": 62,
    "position": 1,
    "text": "به دل‌تان همه کینه آید فراز"
  },
  {
    "poem_id": 1858,
    "vorder": 63,
    "position": 0,
    "text": "ز تور و ز سلم اندر آمد سخن"
  },
  {
    "poem_id": 1858,
    "vorder": 64,
    "position": 1,
    "text": "ازان بیهوده روزگار کهن"
  },
  {
    "poem_id": 1858,
    "vorder": 65,
    "position": 0,
    "text": "یکی عهد باید کنون استوار"
  },
  {
    "poem_id": 1858,
    "vorder": 66,
    "position": 1,
    "text": "سزاوار مهری برو یادگار"
  },
  {
    "poem_id": 1858,
    "vorder": 67,
    "position": 0,
    "text": "کزین باره از کین ایرج سخن"
  },
  {
    "poem_id": 1858,
    "vorder": 68,
    "position": 1,
    "text": "نرانیم و از روزگار کهن"
  },
  {
    "poem_id": 1858,
    "vorder": 69,
    "position": 0,
    "text": "ازین پس یکی باشد ایران و روم"
  },
  {
    "poem_id": 1858,
    "vorder": 70,
    "position": 1,
    "text": "جدایی نجوییم زین مرز و بوم"
  },
  {
    "poem_id": 1858,
    "vorder": 71,
    "position": 0,
    "text": "پس پردهٔ ما یکی دخترست"
  },
  {
    "poem_id": 1858,
    "vorder": 72,
    "position": 1,
    "text": "که از مهتران برخرد بهترست"
  },
  {
    "poem_id": 1858,
    "vorder": 73,
    "position": 0,
    "text": "بخواهید بر پاکی دین ما"
  },
  {
    "poem_id": 1858,
    "vorder": 74,
    "position": 1,
    "text": "چنانچون بود رسم و آیین ما"
  },
  {
    "poem_id": 1858,
    "vorder": 75,
    "position": 0,
    "text": "بدان تا چو فرزند قیصر نژاد"
  },
  {
    "poem_id": 1858,
    "vorder": 76,
    "position": 1,
    "text": "بود کین ایرج نیارد بیاد"
  },
  {
    "poem_id": 1858,
    "vorder": 77,
    "position": 0,
    "text": "از آشوب وز جنگ روی زمین"
  },
  {
    "poem_id": 1858,
    "vorder": 78,
    "position": 1,
    "text": "بیاساید و راه جوید بدین"
  },
  {
    "poem_id": 1858,
    "vorder": 79,
    "position": 0,
    "text": "کنون چون بچشم خرد بنگری"
  },
  {
    "poem_id": 1858,
    "vorder": 80,
    "position": 1,
    "text": "مراین را به جز راستی نشمری"
  },
  {
    "poem_id": 1858,
    "vorder": 81,
    "position": 0,
    "text": "بماند ز پیوند پیمان ما"
  },
  {
    "poem_id": 1858,
    "vorder": 82,
    "position": 1,
    "text": "ز یزدان چنین است فرمان ما"
  },
  {
    "poem_id": 1858,
    "vorder": 83,
    "position": 0,
    "text": "ز هنگام پیروز تا خوشنواز"
  },
  {
    "poem_id": 1858,
    "vorder": 84,
    "position": 1,
    "text": "همانا که بگذشت سال دراز"
  },
  {
    "poem_id": 1858,
    "vorder": 85,
    "position": 0,
    "text": "که سرها بدادند هر دو بباد"
  },
  {
    "poem_id": 1858,
    "vorder": 86,
    "position": 1,
    "text": "جهاندار پیمان شکن خود مباد"
  },
  {
    "poem_id": 1858,
    "vorder": 87,
    "position": 0,
    "text": "مسیح پیمبر چنین کرد یاد"
  },
  {
    "poem_id": 1858,
    "vorder": 88,
    "position": 1,
    "text": "که پیچد خرد چون به پیچی زداد"
  },
  {
    "poem_id": 1858,
    "vorder": 89,
    "position": 0,
    "text": "بسی چاره کرد اندران خوشنواز"
  },
  {
    "poem_id": 1858,
    "vorder": 90,
    "position": 1,
    "text": "که پیروز را سر نیاید به گاز"
  },
  {
    "poem_id": 1858,
    "vorder": 91,
    "position": 0,
    "text": "چو پیروز با او درشتی نمود"
  },
  {
    "poem_id": 1858,
    "vorder": 92,
    "position": 1,
    "text": "بدید اندران جایگه تیره دود"
  },
  {
    "poem_id": 1858,
    "vorder": 93,
    "position": 0,
    "text": "شد آن لشکر و تخت شاهی بباد"
  },
  {
    "poem_id": 1858,
    "vorder": 94,
    "position": 1,
    "text": "بپیچد و شد شاه را سر زداد"
  },
  {
    "poem_id": 1858,
    "vorder": 95,
    "position": 0,
    "text": "تو برنایی و نوز نادیده کار"
  },
  {
    "poem_id": 1858,
    "vorder": 96,
    "position": 1,
    "text": "چو خواهی که بر یابی از روزگار"
  },
  {
    "poem_id": 1858,
    "vorder": 97,
    "position": 0,
    "text": "مکن یاری مرد پیمان شکن"
  },
  {
    "poem_id": 1858,
    "vorder": 98,
    "position": 1,
    "text": "که پیمان شکن کس نیرزد کفن"
  },
  {
    "poem_id": 1858,
    "vorder": 99,
    "position": 0,
    "text": "بدان شاه نفرین کند تاج و گاه"
  },
  {
    "poem_id": 1858,
    "vorder": 100,
    "position": 1,
    "text": "که پیمان شکن باشد و کینه خواه"
  },
  {
    "poem_id": 1858,
    "vorder": 101,
    "position": 0,
    "text": "کنون نامهٔ من سراسر بخوان"
  },
  {
    "poem_id": 1858,
    "vorder": 102,
    "position": 1,
    "text": "گر انگشتها چرب داری مخوان"
  },
  {
    "poem_id": 1858,
    "vorder": 103,
    "position": 0,
    "text": "سخنها نگه دار و پاسخ نویس"
  },
  {
    "poem_id": 1858,
    "vorder": 104,
    "position": 1,
    "text": "همه خوبی اندیش و فرخ نویس"
  },
  {
    "poem_id": 1858,
    "vorder": 105,
    "position": 0,
    "text": "نخواهم که این راز داند دبیر"
  },
  {
    "poem_id": 1858,
    "vorder": 106,
    "position": 1,
    "text": "تو باشی نویسندهٔ تیزویر"
  },
  {
    "poem_id": 1858,
    "vorder": 107,
    "position": 0,
    "text": "چو برخوانم این پاسخ نامه را"
  },
  {
    "poem_id": 1858,
    "vorder": 108,
    "position": 1,
    "text": "ببینم دل مرد خود کامه را"
  },
  {
    "poem_id": 1858,
    "vorder": 109,
    "position": 0,
    "text": "همانا سلیح و سپاه و درم"
  },
  {
    "poem_id": 1858,
    "vorder": 110,
    "position": 1,
    "text": "فرستیم تا دل نداری دژم"
  },
  {
    "poem_id": 1858,
    "vorder": 111,
    "position": 0,
    "text": "هرآنکس که برتو گرامی ترست"
  },
  {
    "poem_id": 1858,
    "vorder": 112,
    "position": 1,
    "text": "وگر نزد تو نیز نامی ترست"
  },
  {
    "poem_id": 1858,
    "vorder": 113,
    "position": 0,
    "text": "ابا آنک زو کینه داری به دل"
  },
  {
    "poem_id": 1858,
    "vorder": 114,
    "position": 1,
    "text": "به مردی ز دل کینه‌ها برگسل"
  },
  {
    "poem_id": 1858,
    "vorder": 115,
    "position": 0,
    "text": "گناهش بیزدان دارنده بخش"
  },
  {
    "poem_id": 1858,
    "vorder": 116,
    "position": 1,
    "text": "مکن روز بر دشمن و دوست دخش"
  },
  {
    "poem_id": 1858,
    "vorder": 117,
    "position": 0,
    "text": "چو خواهی که داردت پیروزبخت"
  },
  {
    "poem_id": 1858,
    "vorder": 118,
    "position": 1,
    "text": "جهاندار و با لشکر و تاج و تخت"
  },
  {
    "poem_id": 1858,
    "vorder": 119,
    "position": 0,
    "text": "زچیزکسان دست کوتاه دار"
  },
  {
    "poem_id": 1858,
    "vorder": 120,
    "position": 1,
    "text": "روان را سوی راستی راه دار"
  },
  {
    "poem_id": 1858,
    "vorder": 121,
    "position": 0,
    "text": "چو عنوان آن نامه برگشت خشک"
  },
  {
    "poem_id": 1858,
    "vorder": 122,
    "position": 1,
    "text": "برو برنهادند مهری زمشک"
  },
  {
    "poem_id": 1858,
    "vorder": 123,
    "position": 0,
    "text": "بران مهر بنهاد قیصر نگین"
  },
  {
    "poem_id": 1858,
    "vorder": 124,
    "position": 1,
    "text": "فرستاده را داد وکرد آفرین"
  }
]