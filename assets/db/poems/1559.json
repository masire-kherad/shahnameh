[
  {
    "poem_id": 1559,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس بیامد به پرده‌سرای"
  },
  {
    "poem_id": 1559,
    "vorder": 2,
    "position": 1,
    "text": "ز هرگونه انداخت با شاه رای"
  },
  {
    "poem_id": 1559,
    "vorder": 3,
    "position": 0,
    "text": "ز لهراسپ وز کین فرشیدورد"
  },
  {
    "poem_id": 1559,
    "vorder": 4,
    "position": 1,
    "text": "ازان نامداران روز نبرد"
  },
  {
    "poem_id": 1559,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای زورمند"
  },
  {
    "poem_id": 1559,
    "vorder": 6,
    "position": 1,
    "text": "تو شادانی و خواهرانت به بند"
  },
  {
    "poem_id": 1559,
    "vorder": 7,
    "position": 0,
    "text": "خنک آنک بر کینه گه کشته شد"
  },
  {
    "poem_id": 1559,
    "vorder": 8,
    "position": 1,
    "text": "نه در چنگ ترکان سرگشته شد"
  },
  {
    "poem_id": 1559,
    "vorder": 9,
    "position": 0,
    "text": "چو بر تخت بینند ما را نشست"
  },
  {
    "poem_id": 1559,
    "vorder": 10,
    "position": 1,
    "text": "چه گوید کسی کو بود زیر دست"
  },
  {
    "poem_id": 1559,
    "vorder": 11,
    "position": 0,
    "text": "بگریم برین ننگ تا زنده‌ام"
  },
  {
    "poem_id": 1559,
    "vorder": 12,
    "position": 1,
    "text": "به مغز اندرون آتش افگنده‌ام"
  },
  {
    "poem_id": 1559,
    "vorder": 13,
    "position": 0,
    "text": "پذیرفتم از کردگار بلند"
  },
  {
    "poem_id": 1559,
    "vorder": 14,
    "position": 1,
    "text": "که گر تو به توران شوی بی‌گزند"
  },
  {
    "poem_id": 1559,
    "vorder": 15,
    "position": 0,
    "text": "به مردی شوی در دم اژدها"
  },
  {
    "poem_id": 1559,
    "vorder": 16,
    "position": 1,
    "text": "کنی خواهران را ز ترکان رها"
  },
  {
    "poem_id": 1559,
    "vorder": 17,
    "position": 0,
    "text": "سپارم ترا تاج شاهنشهی"
  },
  {
    "poem_id": 1559,
    "vorder": 18,
    "position": 1,
    "text": "همان گنج بی‌رنج و تخت مهی"
  },
  {
    "poem_id": 1559,
    "vorder": 19,
    "position": 0,
    "text": "مرا جایگاه پرستش بس است"
  },
  {
    "poem_id": 1559,
    "vorder": 20,
    "position": 1,
    "text": "نه فرزند من نزد دیگر کس است"
  },
  {
    "poem_id": 1559,
    "vorder": 21,
    "position": 0,
    "text": "چنین پاسخ آورد اسفندیار"
  },
  {
    "poem_id": 1559,
    "vorder": 22,
    "position": 1,
    "text": "که بی‌تو مبیناد کس روزگار"
  },
  {
    "poem_id": 1559,
    "vorder": 23,
    "position": 0,
    "text": "به پیش پدر من یکی بنده‌ام"
  },
  {
    "poem_id": 1559,
    "vorder": 24,
    "position": 1,
    "text": "روان را به فرمانش آگنده‌ام"
  },
  {
    "poem_id": 1559,
    "vorder": 25,
    "position": 0,
    "text": "فدای تو دارم تن و جان خویش"
  },
  {
    "poem_id": 1559,
    "vorder": 26,
    "position": 1,
    "text": "نخواهم سر و تخت و فرمان خویش"
  },
  {
    "poem_id": 1559,
    "vorder": 27,
    "position": 0,
    "text": "شوم باز خواهم ز ارجاسپ کین"
  },
  {
    "poem_id": 1559,
    "vorder": 28,
    "position": 1,
    "text": "نمانم بر و بوم توران زمین"
  },
  {
    "poem_id": 1559,
    "vorder": 29,
    "position": 0,
    "text": "به تخت آورم خواهران را ز بند"
  },
  {
    "poem_id": 1559,
    "vorder": 30,
    "position": 1,
    "text": "به بخت جهاندار شاه بلند"
  },
  {
    "poem_id": 1559,
    "vorder": 31,
    "position": 0,
    "text": "برو آفرین کرد گشتاسپ و گفت"
  },
  {
    "poem_id": 1559,
    "vorder": 32,
    "position": 1,
    "text": "که با تو روان و خرد باد جفت"
  },
  {
    "poem_id": 1559,
    "vorder": 33,
    "position": 0,
    "text": "برفتنت یزدان پناه تو باد"
  },
  {
    "poem_id": 1559,
    "vorder": 34,
    "position": 1,
    "text": "به باز آمدن تخت گاه تو باد"
  },
  {
    "poem_id": 1559,
    "vorder": 35,
    "position": 0,
    "text": "بخواند آن زمان لشگر از هر سوی"
  },
  {
    "poem_id": 1559,
    "vorder": 36,
    "position": 1,
    "text": "به جایی که بد موبدی گر گوی"
  },
  {
    "poem_id": 1559,
    "vorder": 37,
    "position": 0,
    "text": "ازیشان گزیده ده و دو هزار"
  },
  {
    "poem_id": 1559,
    "vorder": 38,
    "position": 1,
    "text": "سواران مرد افگن و کینه‌دار"
  },
  {
    "poem_id": 1559,
    "vorder": 39,
    "position": 0,
    "text": "بر ایشان ببخشید گنج درم"
  },
  {
    "poem_id": 1559,
    "vorder": 40,
    "position": 1,
    "text": "نکرد ایچ کس را به بخشش دژم"
  },
  {
    "poem_id": 1559,
    "vorder": 41,
    "position": 0,
    "text": "ببخشید گنجی بر اسفندیار"
  },
  {
    "poem_id": 1559,
    "vorder": 42,
    "position": 1,
    "text": "یکی تاج پر گوهر شاهوار"
  },
  {
    "poem_id": 1559,
    "vorder": 43,
    "position": 0,
    "text": "خروشی برآمد ز درگاه شاه"
  },
  {
    "poem_id": 1559,
    "vorder": 44,
    "position": 1,
    "text": "شد از گرد خورشید تابان سیاه"
  },
  {
    "poem_id": 1559,
    "vorder": 45,
    "position": 0,
    "text": "ز ایوان به دشت آمد اسفندیار"
  },
  {
    "poem_id": 1559,
    "vorder": 46,
    "position": 1,
    "text": "سپاهی گزید از در کارزار"
  }
]