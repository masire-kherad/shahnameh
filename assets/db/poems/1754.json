[
  {
    "poem_id": 1754,
    "vorder": 1,
    "position": 0,
    "text": "ز شاهیش بگذشت چون هفت سال"
  },
  {
    "poem_id": 1754,
    "vorder": 2,
    "position": 1,
    "text": "همه موبدان زو به رنج و وبال"
  },
  {
    "poem_id": 1754,
    "vorder": 3,
    "position": 0,
    "text": "سر سال هشتم مه فروَدین"
  },
  {
    "poem_id": 1754,
    "vorder": 4,
    "position": 1,
    "text": "که پیدا کند در جهان هور دین"
  },
  {
    "poem_id": 1754,
    "vorder": 5,
    "position": 0,
    "text": "یکی کودک آمدش هرمزد روز"
  },
  {
    "poem_id": 1754,
    "vorder": 6,
    "position": 1,
    "text": "به نیک اختر و فال گیتی فروز"
  },
  {
    "poem_id": 1754,
    "vorder": 7,
    "position": 0,
    "text": "هم‌آنگه پدر کرد بهرام نام"
  },
  {
    "poem_id": 1754,
    "vorder": 8,
    "position": 1,
    "text": "ازان کودک خرد شد شادکام"
  },
  {
    "poem_id": 1754,
    "vorder": 9,
    "position": 0,
    "text": "به در بر ستاره‌شمر هرک بود"
  },
  {
    "poem_id": 1754,
    "vorder": 10,
    "position": 1,
    "text": "که شایست گفتار ایشان شنود"
  },
  {
    "poem_id": 1754,
    "vorder": 11,
    "position": 0,
    "text": "یکی مایه‌ور بود با فر و هوش"
  },
  {
    "poem_id": 1754,
    "vorder": 12,
    "position": 1,
    "text": "سر هندوان بود نامش سروش"
  },
  {
    "poem_id": 1754,
    "vorder": 13,
    "position": 0,
    "text": "یکی پارسی بود هشیار نام"
  },
  {
    "poem_id": 1754,
    "vorder": 14,
    "position": 1,
    "text": "که بر چرخ کردی به دانش لگام"
  },
  {
    "poem_id": 1754,
    "vorder": 15,
    "position": 0,
    "text": "بفرمود تا پیش شاه آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 16,
    "position": 1,
    "text": "هشیوار و جوینده راه آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 17,
    "position": 0,
    "text": "به صلاب کردند ز اختر نگاه"
  },
  {
    "poem_id": 1754,
    "vorder": 18,
    "position": 1,
    "text": "هم از زیچ رومی بجستند راه"
  },
  {
    "poem_id": 1754,
    "vorder": 19,
    "position": 0,
    "text": "از اختر چنان دید خرم نهان"
  },
  {
    "poem_id": 1754,
    "vorder": 20,
    "position": 1,
    "text": "که او شهریاری بود در جهان"
  },
  {
    "poem_id": 1754,
    "vorder": 21,
    "position": 0,
    "text": "ابر هفت کشور بود پادشا"
  },
  {
    "poem_id": 1754,
    "vorder": 22,
    "position": 1,
    "text": "گو شاددل باشد و پارسا"
  },
  {
    "poem_id": 1754,
    "vorder": 23,
    "position": 0,
    "text": "برفتند پویان بر شهریار"
  },
  {
    "poem_id": 1754,
    "vorder": 24,
    "position": 1,
    "text": "همان زیچ و صلابها بر کنار"
  },
  {
    "poem_id": 1754,
    "vorder": 25,
    "position": 0,
    "text": "بگفتند با تاجور یزدگرد"
  },
  {
    "poem_id": 1754,
    "vorder": 26,
    "position": 1,
    "text": "که دانش ز هرگونه کردیم گرد"
  },
  {
    "poem_id": 1754,
    "vorder": 27,
    "position": 0,
    "text": "چنان آمد اندر شمار سپهر"
  },
  {
    "poem_id": 1754,
    "vorder": 28,
    "position": 1,
    "text": "که دارد بدین کودک خرد مهر"
  },
  {
    "poem_id": 1754,
    "vorder": 29,
    "position": 0,
    "text": "مر او را بود هفت کشور زمین"
  },
  {
    "poem_id": 1754,
    "vorder": 30,
    "position": 1,
    "text": "گرانمایه شاهی بود بافرین"
  },
  {
    "poem_id": 1754,
    "vorder": 31,
    "position": 0,
    "text": "ز گفتارشان شاد شد شهریار"
  },
  {
    "poem_id": 1754,
    "vorder": 32,
    "position": 1,
    "text": "ببخشیدشان گوهر شاهوار"
  },
  {
    "poem_id": 1754,
    "vorder": 33,
    "position": 0,
    "text": "چو ایشان برفتند زان بارگاه"
  },
  {
    "poem_id": 1754,
    "vorder": 34,
    "position": 1,
    "text": "رد و موبد و پاک دستور شاه"
  },
  {
    "poem_id": 1754,
    "vorder": 35,
    "position": 0,
    "text": "نشستند و جستند هرگونه رای"
  },
  {
    "poem_id": 1754,
    "vorder": 36,
    "position": 1,
    "text": "که تا چارهٔ آن چه آید به جای"
  },
  {
    "poem_id": 1754,
    "vorder": 37,
    "position": 0,
    "text": "گرین کودک خرد خوی پدر"
  },
  {
    "poem_id": 1754,
    "vorder": 38,
    "position": 1,
    "text": "نگیرد شو خسروی دادگر"
  },
  {
    "poem_id": 1754,
    "vorder": 39,
    "position": 0,
    "text": "گر ایدونک خوی پدر دارد اوی"
  },
  {
    "poem_id": 1754,
    "vorder": 40,
    "position": 1,
    "text": "همه بوم زیر و زبر دارد اوی"
  },
  {
    "poem_id": 1754,
    "vorder": 41,
    "position": 0,
    "text": "نه موبد بود شاد و نه پهلوان"
  },
  {
    "poem_id": 1754,
    "vorder": 42,
    "position": 1,
    "text": "نه او در جهان شاد روشن‌روان"
  },
  {
    "poem_id": 1754,
    "vorder": 43,
    "position": 0,
    "text": "همه موبدان نزد شاه آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 44,
    "position": 1,
    "text": "گشاده‌دل و نیک‌خواه آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 45,
    "position": 0,
    "text": "بگفتند کاین کودک برمنش"
  },
  {
    "poem_id": 1754,
    "vorder": 46,
    "position": 1,
    "text": "ز بیغاره دورست و ز سرزنش"
  },
  {
    "poem_id": 1754,
    "vorder": 47,
    "position": 0,
    "text": "جهان سربسر زیر فرمان اوست"
  },
  {
    "poem_id": 1754,
    "vorder": 48,
    "position": 1,
    "text": "به هر کشوری باژ و پیمان اوست"
  },
  {
    "poem_id": 1754,
    "vorder": 49,
    "position": 0,
    "text": "نگه کن به جایی که دانش بود"
  },
  {
    "poem_id": 1754,
    "vorder": 50,
    "position": 1,
    "text": "ز داننده کشور به رامش بود"
  },
  {
    "poem_id": 1754,
    "vorder": 51,
    "position": 0,
    "text": "ز پرمایگان دایگانی گزین"
  },
  {
    "poem_id": 1754,
    "vorder": 52,
    "position": 1,
    "text": "که باشد ز کشور برو آفرین"
  },
  {
    "poem_id": 1754,
    "vorder": 53,
    "position": 0,
    "text": "هنر گیرد این شاه خرم نهان"
  },
  {
    "poem_id": 1754,
    "vorder": 54,
    "position": 1,
    "text": "ز فرمان او شاد گردد جهان"
  },
  {
    "poem_id": 1754,
    "vorder": 55,
    "position": 0,
    "text": "چو بشنید زان موبدان یزدگرد"
  },
  {
    "poem_id": 1754,
    "vorder": 56,
    "position": 1,
    "text": "ز کشور فرستادگان کرد گرد"
  },
  {
    "poem_id": 1754,
    "vorder": 57,
    "position": 0,
    "text": "هم‌انگه فرستاد کسها به روم"
  },
  {
    "poem_id": 1754,
    "vorder": 58,
    "position": 1,
    "text": "به هند و به چین و به آباد بوم"
  },
  {
    "poem_id": 1754,
    "vorder": 59,
    "position": 0,
    "text": "همان نامداری سوی تازیان"
  },
  {
    "poem_id": 1754,
    "vorder": 60,
    "position": 1,
    "text": "بشد تا ببیند به سود و زیان"
  },
  {
    "poem_id": 1754,
    "vorder": 61,
    "position": 0,
    "text": "به هر سو همی رفت خواننده‌ای"
  },
  {
    "poem_id": 1754,
    "vorder": 62,
    "position": 1,
    "text": "که بهرام را پروراننده‌ای"
  },
  {
    "poem_id": 1754,
    "vorder": 63,
    "position": 0,
    "text": "بجوید سخنگوی و دانش‌پذیر"
  },
  {
    "poem_id": 1754,
    "vorder": 64,
    "position": 1,
    "text": "سخن‌دان و هر دانشی یادگیر"
  },
  {
    "poem_id": 1754,
    "vorder": 65,
    "position": 0,
    "text": "بیامد ز هر کشوری موبدی"
  },
  {
    "poem_id": 1754,
    "vorder": 66,
    "position": 1,
    "text": "جهاندیده و نیک‌پی بخردی"
  },
  {
    "poem_id": 1754,
    "vorder": 67,
    "position": 0,
    "text": "چو یکسر بدان بارگاه آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 68,
    "position": 1,
    "text": "پژوهنده نزدیک شاه آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 69,
    "position": 0,
    "text": "بپرسید بسیار و بنواختشان"
  },
  {
    "poem_id": 1754,
    "vorder": 70,
    "position": 1,
    "text": "به هر برزنی جایگه ساختشان"
  },
  {
    "poem_id": 1754,
    "vorder": 71,
    "position": 0,
    "text": "برفتند نعمان و منذر به شب"
  },
  {
    "poem_id": 1754,
    "vorder": 72,
    "position": 1,
    "text": "بسی نامداران گرد از عرب"
  },
  {
    "poem_id": 1754,
    "vorder": 73,
    "position": 0,
    "text": "بزرگان چو در پارس گرد آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 74,
    "position": 1,
    "text": "بر تاجور یزدگرد آمدند"
  },
  {
    "poem_id": 1754,
    "vorder": 75,
    "position": 0,
    "text": "همی گفت هرکس که ما بنده‌ایم"
  },
  {
    "poem_id": 1754,
    "vorder": 76,
    "position": 1,
    "text": "سخن بشنویم و سراینده‌ایم"
  },
  {
    "poem_id": 1754,
    "vorder": 77,
    "position": 0,
    "text": "که باید چنین روزگار از مهان"
  },
  {
    "poem_id": 1754,
    "vorder": 78,
    "position": 1,
    "text": "که بایسته فرزند شاه جهان"
  },
  {
    "poem_id": 1754,
    "vorder": 79,
    "position": 0,
    "text": "به بر گیرد و دانش آموزدش"
  },
  {
    "poem_id": 1754,
    "vorder": 80,
    "position": 1,
    "text": "دل از تیرگیها بیفروزدش"
  },
  {
    "poem_id": 1754,
    "vorder": 81,
    "position": 0,
    "text": "ز رومی و هندی و از پارسی"
  },
  {
    "poem_id": 1754,
    "vorder": 82,
    "position": 1,
    "text": "نجومی و گر مردم هندسی"
  },
  {
    "poem_id": 1754,
    "vorder": 83,
    "position": 0,
    "text": "همه فیلسوفان بسیاردان"
  },
  {
    "poem_id": 1754,
    "vorder": 84,
    "position": 1,
    "text": "سخن‌گوی وز مردم کاردان"
  },
  {
    "poem_id": 1754,
    "vorder": 85,
    "position": 0,
    "text": "بگفتند هریک به آواز نرم"
  },
  {
    "poem_id": 1754,
    "vorder": 86,
    "position": 1,
    "text": "که ای شاه باداد و با رای و شرم"
  },
  {
    "poem_id": 1754,
    "vorder": 87,
    "position": 0,
    "text": "همه سربسر خاک پای توایم"
  },
  {
    "poem_id": 1754,
    "vorder": 88,
    "position": 1,
    "text": "به دانش همه رهنمای توایم"
  },
  {
    "poem_id": 1754,
    "vorder": 89,
    "position": 0,
    "text": "نگر تا پسندت که آید همی"
  },
  {
    "poem_id": 1754,
    "vorder": 90,
    "position": 1,
    "text": "وگر سودمندت که آید همی"
  },
  {
    "poem_id": 1754,
    "vorder": 91,
    "position": 0,
    "text": "چنین گفت منذر که ما بنده‌ایم"
  },
  {
    "poem_id": 1754,
    "vorder": 92,
    "position": 1,
    "text": "خود اندر جهان شاه را زنده‌ایم"
  },
  {
    "poem_id": 1754,
    "vorder": 93,
    "position": 0,
    "text": "هنرهای ما شاه داند همه"
  },
  {
    "poem_id": 1754,
    "vorder": 94,
    "position": 1,
    "text": "که او چون شبانست و ما چون رمه"
  },
  {
    "poem_id": 1754,
    "vorder": 95,
    "position": 0,
    "text": "سواریم و گردیم و اسپ افگنیم"
  },
  {
    "poem_id": 1754,
    "vorder": 96,
    "position": 1,
    "text": "کسی را که دانا بود بشکنیم"
  },
  {
    "poem_id": 1754,
    "vorder": 97,
    "position": 0,
    "text": "ستاره‌شمر نیست چون ما کسی"
  },
  {
    "poem_id": 1754,
    "vorder": 98,
    "position": 1,
    "text": "که از هندسه بهره دارد بسی"
  },
  {
    "poem_id": 1754,
    "vorder": 99,
    "position": 0,
    "text": "پر از مهر شاهست ما را روان"
  },
  {
    "poem_id": 1754,
    "vorder": 100,
    "position": 1,
    "text": "به زیر اندرون تازی اسپان دمان"
  },
  {
    "poem_id": 1754,
    "vorder": 101,
    "position": 0,
    "text": "همه پیش فرزند تو بنده‌ایم"
  },
  {
    "poem_id": 1754,
    "vorder": 102,
    "position": 1,
    "text": "بزرگی وی را ستاینده‌ایم"
  }
]