[
  {
    "poem_id": 1538,
    "vorder": 1,
    "position": 0,
    "text": "چو اندر گذشت آن شب و بود روز"
  },
  {
    "poem_id": 1538,
    "vorder": 2,
    "position": 1,
    "text": "بتابید خورشید گیهان فروز"
  },
  {
    "poem_id": 1538,
    "vorder": 3,
    "position": 0,
    "text": "به زین بر نشستند هر دو سپاه"
  },
  {
    "poem_id": 1538,
    "vorder": 4,
    "position": 1,
    "text": "همی دید زان کوه گشتاسپ شاه"
  },
  {
    "poem_id": 1538,
    "vorder": 5,
    "position": 0,
    "text": "چو از کوه دید آن شه بافرین"
  },
  {
    "poem_id": 1538,
    "vorder": 6,
    "position": 1,
    "text": "کجا برنشستند گردان به زین"
  },
  {
    "poem_id": 1538,
    "vorder": 7,
    "position": 0,
    "text": "سیه رنگ بهزاد را پیش خواست"
  },
  {
    "poem_id": 1538,
    "vorder": 8,
    "position": 1,
    "text": "تو گفتی که بیستونست راست"
  },
  {
    "poem_id": 1538,
    "vorder": 9,
    "position": 0,
    "text": "برو بر فگندند برگستوان"
  },
  {
    "poem_id": 1538,
    "vorder": 10,
    "position": 1,
    "text": "برو بر نشست آن شه خسروان"
  },
  {
    "poem_id": 1538,
    "vorder": 11,
    "position": 0,
    "text": "چو هر دو برابر فرود آمدند"
  },
  {
    "poem_id": 1538,
    "vorder": 12,
    "position": 1,
    "text": "ابر پیل بر نای رویین زدند"
  },
  {
    "poem_id": 1538,
    "vorder": 13,
    "position": 0,
    "text": "یکی رزمگاهی بیاراستند"
  },
  {
    "poem_id": 1538,
    "vorder": 14,
    "position": 1,
    "text": "یلان هم نبردان همی خواستند"
  },
  {
    "poem_id": 1538,
    "vorder": 15,
    "position": 0,
    "text": "بکردند یک تیرباران نخست"
  },
  {
    "poem_id": 1538,
    "vorder": 16,
    "position": 1,
    "text": "بسان تگرگ بهاران درست"
  },
  {
    "poem_id": 1538,
    "vorder": 17,
    "position": 0,
    "text": "بشد آفتاب از جهان ناپدید"
  },
  {
    "poem_id": 1538,
    "vorder": 18,
    "position": 1,
    "text": "چه داند کسی کان شگفتی ندید"
  },
  {
    "poem_id": 1538,
    "vorder": 19,
    "position": 0,
    "text": "بپوشیده شد چشمهٔ آفتاب"
  },
  {
    "poem_id": 1538,
    "vorder": 20,
    "position": 1,
    "text": "ز پیکانهاشان درفشان چو آب"
  },
  {
    "poem_id": 1538,
    "vorder": 21,
    "position": 0,
    "text": "تو گفتی جهان ابر دارد همی"
  },
  {
    "poem_id": 1538,
    "vorder": 22,
    "position": 1,
    "text": "وزان ابر الماس بارد همی"
  },
  {
    "poem_id": 1538,
    "vorder": 23,
    "position": 0,
    "text": "وزان گرزداران و نیزه‌وران"
  },
  {
    "poem_id": 1538,
    "vorder": 24,
    "position": 1,
    "text": "همی تاختند آن برین این بران"
  },
  {
    "poem_id": 1538,
    "vorder": 25,
    "position": 0,
    "text": "هوازی جهان بود شبگون شده"
  },
  {
    "poem_id": 1538,
    "vorder": 26,
    "position": 1,
    "text": "زمین سربسر پاک گلگون شده"
  },
  {
    "poem_id": 1538,
    "vorder": 27,
    "position": 0,
    "text": "بیامد نخست آن سوار هژیر"
  },
  {
    "poem_id": 1538,
    "vorder": 28,
    "position": 1,
    "text": "پس شهریار جهان اردشیر"
  },
  {
    "poem_id": 1538,
    "vorder": 29,
    "position": 0,
    "text": "به آوردگه رفت نیزه به دست"
  },
  {
    "poem_id": 1538,
    "vorder": 30,
    "position": 1,
    "text": "تو گفتی مگر طوس اسپهبدست"
  },
  {
    "poem_id": 1538,
    "vorder": 31,
    "position": 0,
    "text": "برین سان همی گشت پیش سپاه"
  },
  {
    "poem_id": 1538,
    "vorder": 32,
    "position": 1,
    "text": "نبود آگه از بخش خورشید و ماه"
  },
  {
    "poem_id": 1538,
    "vorder": 33,
    "position": 0,
    "text": "بیامد یکی ناوکش بر میان"
  },
  {
    "poem_id": 1538,
    "vorder": 34,
    "position": 1,
    "text": "گذارنده شد بر سلیح کیان"
  },
  {
    "poem_id": 1538,
    "vorder": 35,
    "position": 0,
    "text": "ز بور اندر افتاد خسرو نگون"
  },
  {
    "poem_id": 1538,
    "vorder": 36,
    "position": 1,
    "text": "تن پاکش آلوده شد پر ز خون"
  },
  {
    "poem_id": 1538,
    "vorder": 37,
    "position": 0,
    "text": "دریغ آن نکو روی همرنگ ماه"
  },
  {
    "poem_id": 1538,
    "vorder": 38,
    "position": 1,
    "text": "که بازش ندید آن خردمند شاه"
  },
  {
    "poem_id": 1538,
    "vorder": 39,
    "position": 0,
    "text": "بیامد بر شاه شیر اورمزد"
  },
  {
    "poem_id": 1538,
    "vorder": 40,
    "position": 1,
    "text": "کجا زو گرفتی شهنشاه پزد"
  },
  {
    "poem_id": 1538,
    "vorder": 41,
    "position": 0,
    "text": "ز پیش اندر آمد به دشت اندرا"
  },
  {
    "poem_id": 1538,
    "vorder": 42,
    "position": 1,
    "text": "به زهر آب داده یکی خنجرا"
  },
  {
    "poem_id": 1538,
    "vorder": 43,
    "position": 0,
    "text": "خروشی برآورد برسان شیر"
  },
  {
    "poem_id": 1538,
    "vorder": 44,
    "position": 1,
    "text": "که آورد خواهد ژیان گور زیر"
  },
  {
    "poem_id": 1538,
    "vorder": 45,
    "position": 0,
    "text": "ابر کین آن شاهزاده سوار"
  },
  {
    "poem_id": 1538,
    "vorder": 46,
    "position": 1,
    "text": "بکشت از سواران دشمن هزار"
  },
  {
    "poem_id": 1538,
    "vorder": 47,
    "position": 0,
    "text": "به هنگامهٔ بازگشتن ز جنگ"
  },
  {
    "poem_id": 1538,
    "vorder": 48,
    "position": 1,
    "text": "که روی زمین گشته بد لاله رنگ"
  },
  {
    "poem_id": 1538,
    "vorder": 49,
    "position": 0,
    "text": "بیامد یکی تیرش اندر قفا"
  },
  {
    "poem_id": 1538,
    "vorder": 50,
    "position": 1,
    "text": "شد آن خسرو شاهزاده فنا"
  },
  {
    "poem_id": 1538,
    "vorder": 51,
    "position": 0,
    "text": "بیامد پسش باز شیدسپ شاه"
  },
  {
    "poem_id": 1538,
    "vorder": 52,
    "position": 1,
    "text": "که مانندهٔ شاه بد همچو ماه"
  },
  {
    "poem_id": 1538,
    "vorder": 53,
    "position": 0,
    "text": "یکی دیزه‌ای بر نشسته چو نیل"
  },
  {
    "poem_id": 1538,
    "vorder": 54,
    "position": 1,
    "text": "به تگ همچو آهو به تن همچو پیل"
  },
  {
    "poem_id": 1538,
    "vorder": 55,
    "position": 0,
    "text": "به آوردگه گشت و نیزه بگاشت"
  },
  {
    "poem_id": 1538,
    "vorder": 56,
    "position": 1,
    "text": "چو لختی بگردید نیزه بداشت"
  },
  {
    "poem_id": 1538,
    "vorder": 57,
    "position": 0,
    "text": "کدامست گفتا کهرم سترگ"
  },
  {
    "poem_id": 1538,
    "vorder": 58,
    "position": 1,
    "text": "کجا پیکرش پیکر پیر گرگ"
  },
  {
    "poem_id": 1538,
    "vorder": 59,
    "position": 0,
    "text": "بیامد یکی دیو گفتا منم"
  },
  {
    "poem_id": 1538,
    "vorder": 60,
    "position": 1,
    "text": "که با گرسنه شیر دندان زنم"
  },
  {
    "poem_id": 1538,
    "vorder": 61,
    "position": 0,
    "text": "به نیزه بگشتند هر دو چو باد"
  },
  {
    "poem_id": 1538,
    "vorder": 62,
    "position": 1,
    "text": "بزد ترک را نیزهٔ شاهزاد"
  },
  {
    "poem_id": 1538,
    "vorder": 63,
    "position": 0,
    "text": "ز باره در آورد و ببرید سر"
  },
  {
    "poem_id": 1538,
    "vorder": 64,
    "position": 1,
    "text": "به خاک اندر افگنده زرین کمر"
  },
  {
    "poem_id": 1538,
    "vorder": 65,
    "position": 0,
    "text": "همی گشت بر پیش گردان چین"
  },
  {
    "poem_id": 1538,
    "vorder": 66,
    "position": 1,
    "text": "بسان یکی کوه بر پشت زین"
  },
  {
    "poem_id": 1538,
    "vorder": 67,
    "position": 0,
    "text": "همانا چنو نیز دیده ندید"
  },
  {
    "poem_id": 1538,
    "vorder": 68,
    "position": 1,
    "text": "ز خوبی کجا بود چشمش رسید"
  },
  {
    "poem_id": 1538,
    "vorder": 69,
    "position": 0,
    "text": "یکی ترک تیری برو برگماشت"
  },
  {
    "poem_id": 1538,
    "vorder": 70,
    "position": 1,
    "text": "ز پشتش سر تیر بیرون گذاشت"
  },
  {
    "poem_id": 1538,
    "vorder": 71,
    "position": 0,
    "text": "دریغ آن شه پروریده به ناز"
  },
  {
    "poem_id": 1538,
    "vorder": 72,
    "position": 1,
    "text": "بشد روی او باب نادیده باز"
  }
]