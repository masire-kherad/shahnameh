[
  {
    "poem_id": 1779,
    "vorder": 1,
    "position": 0,
    "text": "دگر هفته با موبدان و ردان"
  },
  {
    "poem_id": 1779,
    "vorder": 2,
    "position": 1,
    "text": "به نخچیر شد شهریار جهان"
  },
  {
    "poem_id": 1779,
    "vorder": 3,
    "position": 0,
    "text": "چنان بد که ماهی به نخچیرگاه"
  },
  {
    "poem_id": 1779,
    "vorder": 4,
    "position": 1,
    "text": "همی بود میخواره و با سپاه"
  },
  {
    "poem_id": 1779,
    "vorder": 5,
    "position": 0,
    "text": "ز نخچیر کوه و ز نخچیر دشت"
  },
  {
    "poem_id": 1779,
    "vorder": 6,
    "position": 1,
    "text": "گرفتن ز اندازه اندر گذشت"
  },
  {
    "poem_id": 1779,
    "vorder": 7,
    "position": 0,
    "text": "سوی شهر شد شاددل با سپاه"
  },
  {
    "poem_id": 1779,
    "vorder": 8,
    "position": 1,
    "text": "شب آمد به ره گشت گیتی سیاه"
  },
  {
    "poem_id": 1779,
    "vorder": 9,
    "position": 0,
    "text": "برزگان لشکر همی راندند"
  },
  {
    "poem_id": 1779,
    "vorder": 10,
    "position": 1,
    "text": "سخنهای شاهنشهان خواندند"
  },
  {
    "poem_id": 1779,
    "vorder": 11,
    "position": 0,
    "text": "یکی آتشی دید رخشان ز دور"
  },
  {
    "poem_id": 1779,
    "vorder": 12,
    "position": 1,
    "text": "بران سان که بهمن کند شاه سور"
  },
  {
    "poem_id": 1779,
    "vorder": 13,
    "position": 0,
    "text": "شهنشاه بر روشنی بنگرید"
  },
  {
    "poem_id": 1779,
    "vorder": 14,
    "position": 1,
    "text": "به یک سو دهی خرم آمد پدید"
  },
  {
    "poem_id": 1779,
    "vorder": 15,
    "position": 0,
    "text": "یکی آسیا دید در پیش ده"
  },
  {
    "poem_id": 1779,
    "vorder": 16,
    "position": 1,
    "text": "نشسته پراگنده مردان مه"
  },
  {
    "poem_id": 1779,
    "vorder": 17,
    "position": 0,
    "text": "وزان سوی آتش همه دختران"
  },
  {
    "poem_id": 1779,
    "vorder": 18,
    "position": 1,
    "text": "یکی جشنگه ساخته بر کران"
  },
  {
    "poem_id": 1779,
    "vorder": 19,
    "position": 0,
    "text": "ز گل هر یکی بر سرش افسری"
  },
  {
    "poem_id": 1779,
    "vorder": 20,
    "position": 1,
    "text": "نشسته به هرجای رامشگری"
  },
  {
    "poem_id": 1779,
    "vorder": 21,
    "position": 0,
    "text": "همی چامهٔ رزم خسرو زدند"
  },
  {
    "poem_id": 1779,
    "vorder": 22,
    "position": 1,
    "text": "وزان جایگه هر زمان نو زدند"
  },
  {
    "poem_id": 1779,
    "vorder": 23,
    "position": 0,
    "text": "همه ماه‌روی و همه جعدموی"
  },
  {
    "poem_id": 1779,
    "vorder": 24,
    "position": 1,
    "text": "همه جامه گوهر همه مشک موی"
  },
  {
    "poem_id": 1779,
    "vorder": 25,
    "position": 0,
    "text": "به نزدیک پیش در آسیا"
  },
  {
    "poem_id": 1779,
    "vorder": 26,
    "position": 1,
    "text": "به رامش کشیده نخی بر گیا"
  },
  {
    "poem_id": 1779,
    "vorder": 27,
    "position": 0,
    "text": "وزان هر یکی دسته گل به دست"
  },
  {
    "poem_id": 1779,
    "vorder": 28,
    "position": 1,
    "text": "ز شادی و از می شده نیم‌مست"
  },
  {
    "poem_id": 1779,
    "vorder": 29,
    "position": 0,
    "text": "ازان پس خروش آمد از جشنگاه"
  },
  {
    "poem_id": 1779,
    "vorder": 30,
    "position": 1,
    "text": "که جاوید ماناد بهرامشاه"
  },
  {
    "poem_id": 1779,
    "vorder": 31,
    "position": 0,
    "text": "که با فر و برزست و با مهر و چهر"
  },
  {
    "poem_id": 1779,
    "vorder": 32,
    "position": 1,
    "text": "برویست بر پای گردان سپهر"
  },
  {
    "poem_id": 1779,
    "vorder": 33,
    "position": 0,
    "text": "همی می چکد گویی از روی اوی"
  },
  {
    "poem_id": 1779,
    "vorder": 34,
    "position": 1,
    "text": "همی بوی مشک آید از موی اوی"
  },
  {
    "poem_id": 1779,
    "vorder": 35,
    "position": 0,
    "text": "شکارش نباشد جز از شیر و گور"
  },
  {
    "poem_id": 1779,
    "vorder": 36,
    "position": 1,
    "text": "ازیراش خوانند بهرام گور"
  },
  {
    "poem_id": 1779,
    "vorder": 37,
    "position": 0,
    "text": "جهاندار کاواز ایشان شنید"
  },
  {
    "poem_id": 1779,
    "vorder": 38,
    "position": 1,
    "text": "عنان را بپیچید و زان سو کشید"
  },
  {
    "poem_id": 1779,
    "vorder": 39,
    "position": 0,
    "text": "چو آمد به نزدیکی دختران"
  },
  {
    "poem_id": 1779,
    "vorder": 40,
    "position": 1,
    "text": "نگه کرد جای از کران تا کران"
  },
  {
    "poem_id": 1779,
    "vorder": 41,
    "position": 0,
    "text": "همه دشت یکسر پر از ماه دید"
  },
  {
    "poem_id": 1779,
    "vorder": 42,
    "position": 1,
    "text": "به شهر آمدن راه کوتاه دید"
  },
  {
    "poem_id": 1779,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود تا میگساران ز راه"
  },
  {
    "poem_id": 1779,
    "vorder": 44,
    "position": 1,
    "text": "می آرند و میخواره نزدیک شاه"
  },
  {
    "poem_id": 1779,
    "vorder": 45,
    "position": 0,
    "text": "گسارنده آورد جام بلور"
  },
  {
    "poem_id": 1779,
    "vorder": 46,
    "position": 1,
    "text": "نهادند بر دست بهرام گور"
  },
  {
    "poem_id": 1779,
    "vorder": 47,
    "position": 0,
    "text": "ازان دختران آنک بد نامدار"
  },
  {
    "poem_id": 1779,
    "vorder": 48,
    "position": 1,
    "text": "برون آمدند از میانه چهار"
  },
  {
    "poem_id": 1779,
    "vorder": 49,
    "position": 0,
    "text": "یکی مشک نام و دگر سیسنک"
  },
  {
    "poem_id": 1779,
    "vorder": 50,
    "position": 1,
    "text": "یکی نام نار و دگر سوسنک"
  },
  {
    "poem_id": 1779,
    "vorder": 51,
    "position": 0,
    "text": "بر شاه رفتند با دست‌بند"
  },
  {
    "poem_id": 1779,
    "vorder": 52,
    "position": 1,
    "text": "به رخ چون بهار و به بالا بلند"
  },
  {
    "poem_id": 1779,
    "vorder": 53,
    "position": 0,
    "text": "یکی چامه گفتند بهرام را"
  },
  {
    "poem_id": 1779,
    "vorder": 54,
    "position": 1,
    "text": "شهنشاه با دانش و نام را"
  },
  {
    "poem_id": 1779,
    "vorder": 55,
    "position": 0,
    "text": "ز هر چار پرسید بهرام گور"
  },
  {
    "poem_id": 1779,
    "vorder": 56,
    "position": 1,
    "text": "کزیشان به دلش اندر افتاد شور"
  },
  {
    "poem_id": 1779,
    "vorder": 57,
    "position": 0,
    "text": "که ای گلرخان دختران که‌اید"
  },
  {
    "poem_id": 1779,
    "vorder": 58,
    "position": 1,
    "text": "وزین آتش افروختن بر چه‌اید"
  },
  {
    "poem_id": 1779,
    "vorder": 59,
    "position": 0,
    "text": "یکی گفت کای سرو بالا سوار"
  },
  {
    "poem_id": 1779,
    "vorder": 60,
    "position": 1,
    "text": "به هر چیز ماننده شهریار"
  },
  {
    "poem_id": 1779,
    "vorder": 61,
    "position": 0,
    "text": "پدرمان یکی آسیابان پیر"
  },
  {
    "poem_id": 1779,
    "vorder": 62,
    "position": 1,
    "text": "بدین کوه نخچیر گیرد به تیر"
  },
  {
    "poem_id": 1779,
    "vorder": 63,
    "position": 0,
    "text": "بیاید همانا چو شب تیره شد"
  },
  {
    "poem_id": 1779,
    "vorder": 64,
    "position": 1,
    "text": "ورا دیده از تیرگی خیره شد"
  },
  {
    "poem_id": 1779,
    "vorder": 65,
    "position": 0,
    "text": "هم‌اندر زمان آسیابان ز کوه"
  },
  {
    "poem_id": 1779,
    "vorder": 66,
    "position": 1,
    "text": "بیاورد نخچیر خود با گروه"
  },
  {
    "poem_id": 1779,
    "vorder": 67,
    "position": 0,
    "text": "چو بهرام را دید رخ را به خاک"
  },
  {
    "poem_id": 1779,
    "vorder": 68,
    "position": 1,
    "text": "بمالید آن پیر آزاده پاک"
  },
  {
    "poem_id": 1779,
    "vorder": 69,
    "position": 0,
    "text": "یکی جام زرین بفرمود شاه"
  },
  {
    "poem_id": 1779,
    "vorder": 70,
    "position": 1,
    "text": "بدان پیر دادن که آمد ز راه"
  },
  {
    "poem_id": 1779,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت کاین چار خورشید روی"
  },
  {
    "poem_id": 1779,
    "vorder": 72,
    "position": 1,
    "text": "چه داری چو هستند هنگام شوی"
  },
  {
    "poem_id": 1779,
    "vorder": 73,
    "position": 0,
    "text": "برو پیرمرد آفرین کرد و گفت"
  },
  {
    "poem_id": 1779,
    "vorder": 74,
    "position": 1,
    "text": "که این دختران مرا نیست جفت"
  },
  {
    "poem_id": 1779,
    "vorder": 75,
    "position": 0,
    "text": "رسیده بدین سال دوشیزه‌اند"
  },
  {
    "poem_id": 1779,
    "vorder": 76,
    "position": 1,
    "text": "به دوشیزگی نیز پاکیزه‌اند"
  },
  {
    "poem_id": 1779,
    "vorder": 77,
    "position": 0,
    "text": "ولیکن ندارند چیزی فزون"
  },
  {
    "poem_id": 1779,
    "vorder": 78,
    "position": 1,
    "text": "نگوییم زین بیش چیزی کنون"
  },
  {
    "poem_id": 1779,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت بهرام کاین هر چهار"
  },
  {
    "poem_id": 1779,
    "vorder": 80,
    "position": 1,
    "text": "به من ده وزین بیش دختر مکار"
  },
  {
    "poem_id": 1779,
    "vorder": 81,
    "position": 0,
    "text": "چنین داد پاسخ ورا پیرمرد"
  },
  {
    "poem_id": 1779,
    "vorder": 82,
    "position": 1,
    "text": "کزین در که گفتی سوارا مگرد"
  },
  {
    "poem_id": 1779,
    "vorder": 83,
    "position": 0,
    "text": "نه جا هست ما را نه بوم و نه بر"
  },
  {
    "poem_id": 1779,
    "vorder": 84,
    "position": 1,
    "text": "نه سیم و سرای و نه گاو و نه خر"
  },
  {
    "poem_id": 1779,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت بهرام شاید مرا"
  },
  {
    "poem_id": 1779,
    "vorder": 86,
    "position": 1,
    "text": "که بی‌چیز ایشان بباید مرا"
  },
  {
    "poem_id": 1779,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت هرچار جفت تواند"
  },
  {
    "poem_id": 1779,
    "vorder": 88,
    "position": 1,
    "text": "پرستارگان نهفت تواند"
  },
  {
    "poem_id": 1779,
    "vorder": 89,
    "position": 0,
    "text": "به عیب و هنر چشم تو دیدشان"
  },
  {
    "poem_id": 1779,
    "vorder": 90,
    "position": 1,
    "text": "بدین‌سان که دیدی پسندیده‌شان"
  },
  {
    "poem_id": 1779,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت بهرام کاین هر چهار"
  },
  {
    "poem_id": 1779,
    "vorder": 92,
    "position": 1,
    "text": "پذیرفتم از پاک پروردگار"
  },
  {
    "poem_id": 1779,
    "vorder": 93,
    "position": 0,
    "text": "بگفت این و از جای بر پای خاست"
  },
  {
    "poem_id": 1779,
    "vorder": 94,
    "position": 1,
    "text": "به دشت اندر آوای بالای خاست"
  },
  {
    "poem_id": 1779,
    "vorder": 95,
    "position": 0,
    "text": "بفرمود تا خادمان سپاه"
  },
  {
    "poem_id": 1779,
    "vorder": 96,
    "position": 1,
    "text": "برند آن بتان را به مشکوی شاه"
  },
  {
    "poem_id": 1779,
    "vorder": 97,
    "position": 0,
    "text": "سپاه اندر آمد یکایک ز دشت"
  },
  {
    "poem_id": 1779,
    "vorder": 98,
    "position": 1,
    "text": "همه شب همی دشت لشکر گذشت"
  },
  {
    "poem_id": 1779,
    "vorder": 99,
    "position": 0,
    "text": "فروماند زان آسیابان شگفت"
  },
  {
    "poem_id": 1779,
    "vorder": 100,
    "position": 1,
    "text": "شب تیره اندیشه اندر گرفت"
  },
  {
    "poem_id": 1779,
    "vorder": 101,
    "position": 0,
    "text": "به زن گفت کاین نامدار چو ماه"
  },
  {
    "poem_id": 1779,
    "vorder": 102,
    "position": 1,
    "text": "بدین برز بالا و این دستگاه"
  },
  {
    "poem_id": 1779,
    "vorder": 103,
    "position": 0,
    "text": "شب تیره بر آسیا چون رسید"
  },
  {
    "poem_id": 1779,
    "vorder": 104,
    "position": 1,
    "text": "زنش گفت کز دور آتش بدید"
  },
  {
    "poem_id": 1779,
    "vorder": 105,
    "position": 0,
    "text": "بر آواز این رامش دختران"
  },
  {
    "poem_id": 1779,
    "vorder": 106,
    "position": 1,
    "text": "ز مستی می آورد و رامشگران"
  },
  {
    "poem_id": 1779,
    "vorder": 107,
    "position": 0,
    "text": "چنین گفت پس آسیابان به زن"
  },
  {
    "poem_id": 1779,
    "vorder": 108,
    "position": 1,
    "text": "که ای زن مرا داستانی بزن"
  },
  {
    "poem_id": 1779,
    "vorder": 109,
    "position": 0,
    "text": "که نیکیست فرجام این گر بدی"
  },
  {
    "poem_id": 1779,
    "vorder": 110,
    "position": 1,
    "text": "زنش گفت کاری بود ایزدی"
  },
  {
    "poem_id": 1779,
    "vorder": 111,
    "position": 0,
    "text": "نپرسید چون دید مرد از نژاد"
  },
  {
    "poem_id": 1779,
    "vorder": 112,
    "position": 1,
    "text": "نه از خواسته بر دلش بود یاد"
  },
  {
    "poem_id": 1779,
    "vorder": 113,
    "position": 0,
    "text": "به روی زمین بر همی ماه جست"
  },
  {
    "poem_id": 1779,
    "vorder": 114,
    "position": 1,
    "text": "نه دینار و نه دختر شاه جست"
  },
  {
    "poem_id": 1779,
    "vorder": 115,
    "position": 0,
    "text": "بت آرا ببیند چو ایشان به چین"
  },
  {
    "poem_id": 1779,
    "vorder": 116,
    "position": 1,
    "text": "گسسته شود بر بتان آفرین"
  },
  {
    "poem_id": 1779,
    "vorder": 117,
    "position": 0,
    "text": "برین گونه تا شید بر پشت راغ"
  },
  {
    "poem_id": 1779,
    "vorder": 118,
    "position": 1,
    "text": "برآمد جهان شد چو روشن چراغ"
  },
  {
    "poem_id": 1779,
    "vorder": 119,
    "position": 0,
    "text": "همی رفت هرگونه‌ای داستان"
  },
  {
    "poem_id": 1779,
    "vorder": 120,
    "position": 1,
    "text": "چه از بدنژاد و چه از راستان"
  },
  {
    "poem_id": 1779,
    "vorder": 121,
    "position": 0,
    "text": "چو شب روز شد مهتر آمد به ده"
  },
  {
    "poem_id": 1779,
    "vorder": 122,
    "position": 1,
    "text": "بدین پیر گفتا که ای روزبه"
  },
  {
    "poem_id": 1779,
    "vorder": 123,
    "position": 0,
    "text": "به بالینت آمد شب تیره‌بخت"
  },
  {
    "poem_id": 1779,
    "vorder": 124,
    "position": 1,
    "text": "به بار آمد آن سبز شاخ درخت"
  },
  {
    "poem_id": 1779,
    "vorder": 125,
    "position": 0,
    "text": "شب تیره‌گون دوش بهرامشاه"
  },
  {
    "poem_id": 1779,
    "vorder": 126,
    "position": 1,
    "text": "همی آمد از دشت نخچیرگاه"
  },
  {
    "poem_id": 1779,
    "vorder": 127,
    "position": 0,
    "text": "نگه کرد این جشن و آتش بدید"
  },
  {
    "poem_id": 1779,
    "vorder": 128,
    "position": 1,
    "text": "عنان را بپیچید و زین سو کشید"
  },
  {
    "poem_id": 1779,
    "vorder": 129,
    "position": 0,
    "text": "کنون دختران تو جفت وی‌اند"
  },
  {
    "poem_id": 1779,
    "vorder": 130,
    "position": 1,
    "text": "به آرام اندر نهفت وی‌اند"
  },
  {
    "poem_id": 1779,
    "vorder": 131,
    "position": 0,
    "text": "بدان روی و آن موی و آن راستی"
