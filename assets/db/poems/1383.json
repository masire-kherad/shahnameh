[
  {
    "poem_id": 1383,
    "vorder": 1,
    "position": 0,
    "text": "ورا پنج ترک پرستنده بود"
  },
  {
    "poem_id": 1383,
    "vorder": 2,
    "position": 1,
    "text": "پرستنده و مهربان بنده بود"
  },
  {
    "poem_id": 1383,
    "vorder": 3,
    "position": 0,
    "text": "بدان بندگان خردمند گفت"
  },
  {
    "poem_id": 1383,
    "vorder": 4,
    "position": 1,
    "text": "که بگشاد خواهم نهان از نهفت"
  },
  {
    "poem_id": 1383,
    "vorder": 5,
    "position": 0,
    "text": "شما یک به یک رازدار منید"
  },
  {
    "poem_id": 1383,
    "vorder": 6,
    "position": 1,
    "text": "پرستنده و غمگسار منید"
  },
  {
    "poem_id": 1383,
    "vorder": 7,
    "position": 0,
    "text": "بدانید هر پنج و آگه بوید"
  },
  {
    "poem_id": 1383,
    "vorder": 8,
    "position": 1,
    "text": "همه ساله با بخت همره بوید"
  },
  {
    "poem_id": 1383,
    "vorder": 9,
    "position": 0,
    "text": "که من عاشقم همچو بحر دمان"
  },
  {
    "poem_id": 1383,
    "vorder": 10,
    "position": 1,
    "text": "از او بر شده موج تا آسمان"
  },
  {
    "poem_id": 1383,
    "vorder": 11,
    "position": 0,
    "text": "پر از پور سامست روشن دلم"
  },
  {
    "poem_id": 1383,
    "vorder": 12,
    "position": 1,
    "text": "به خواب اندر اندیشه زو نگسلم"
  },
  {
    "poem_id": 1383,
    "vorder": 13,
    "position": 0,
    "text": "همیشه دلم در غم مهر اوست"
  },
  {
    "poem_id": 1383,
    "vorder": 14,
    "position": 1,
    "text": "شب و روزم اندیشهٔ چهر اوست"
  },
  {
    "poem_id": 1383,
    "vorder": 15,
    "position": 0,
    "text": "کنون این سخن را چه درمان کنید"
  },
  {
    "poem_id": 1383,
    "vorder": 16,
    "position": 1,
    "text": "چه گویید و با من چه پیمان کنید"
  },
  {
    "poem_id": 1383,
    "vorder": 17,
    "position": 0,
    "text": "یکی چاره باید کنون ساختن"
  },
  {
    "poem_id": 1383,
    "vorder": 18,
    "position": 1,
    "text": "دل و جانم از رنج پرداختن"
  },
  {
    "poem_id": 1383,
    "vorder": 19,
    "position": 0,
    "text": "پرستندگان را شگفت آمد آن"
  },
  {
    "poem_id": 1383,
    "vorder": 20,
    "position": 1,
    "text": "که بیکاری آمد ز دخت ردان"
  },
  {
    "poem_id": 1383,
    "vorder": 21,
    "position": 0,
    "text": "همه پاسخش را بیاراستند"
  },
  {
    "poem_id": 1383,
    "vorder": 22,
    "position": 1,
    "text": "چو اهرمن از جای برخاستند"
  },
  {
    "poem_id": 1383,
    "vorder": 23,
    "position": 0,
    "text": "که ای افسر بانوان جهان"
  },
  {
    "poem_id": 1383,
    "vorder": 24,
    "position": 1,
    "text": "سرافراز بر دختران مهان"
  },
  {
    "poem_id": 1383,
    "vorder": 25,
    "position": 0,
    "text": "ستوده ز هندوستان تا به چین"
  },
  {
    "poem_id": 1383,
    "vorder": 26,
    "position": 1,
    "text": "میان بتان در چو روشن نگین"
  },
  {
    "poem_id": 1383,
    "vorder": 27,
    "position": 0,
    "text": "به بالای تو بر چمن سرو نیست"
  },
  {
    "poem_id": 1383,
    "vorder": 28,
    "position": 1,
    "text": "چو رخسار تو تابش پرو نیست"
  },
  {
    "poem_id": 1383,
    "vorder": 29,
    "position": 0,
    "text": "نگار رخ تو ز قنوج و رای"
  },
  {
    "poem_id": 1383,
    "vorder": 30,
    "position": 1,
    "text": "فرستد همی سوی خاور خدای"
  },
  {
    "poem_id": 1383,
    "vorder": 31,
    "position": 0,
    "text": "ترا خود به دیده درون شرم نیست"
  },
  {
    "poem_id": 1383,
    "vorder": 32,
    "position": 1,
    "text": "پدر را به نزد تو آزرم نیست"
  },
  {
    "poem_id": 1383,
    "vorder": 33,
    "position": 0,
    "text": "که آن را که اندازد از بر پدر"
  },
  {
    "poem_id": 1383,
    "vorder": 34,
    "position": 1,
    "text": "تو خواهی که گیری مر او را به بر"
  },
  {
    "poem_id": 1383,
    "vorder": 35,
    "position": 0,
    "text": "که پروردهٔ مرغ باشد به کوه"
  },
  {
    "poem_id": 1383,
    "vorder": 36,
    "position": 1,
    "text": "نشانی شده در میان گروه"
  },
  {
    "poem_id": 1383,
    "vorder": 37,
    "position": 0,
    "text": "کس از مادران پیر هرگز نزاد"
  },
  {
    "poem_id": 1383,
    "vorder": 38,
    "position": 1,
    "text": "نه ز آن کس که زاید بباشد نژاد"
  },
  {
    "poem_id": 1383,
    "vorder": 39,
    "position": 0,
    "text": "چنین سرخ دو بسد شیر بوی"
  },
  {
    "poem_id": 1383,
    "vorder": 40,
    "position": 1,
    "text": "شگفتی بود گر شود پیرجوی"
  },
  {
    "poem_id": 1383,
    "vorder": 41,
    "position": 0,
    "text": "جهانی سراسر پر از مهر تست"
  },
  {
    "poem_id": 1383,
    "vorder": 42,
    "position": 1,
    "text": "به ایوانها صورت چهر تست"
  },
  {
    "poem_id": 1383,
    "vorder": 43,
    "position": 0,
    "text": "ترا با چنین روی و بالای و موی"
  },
  {
    "poem_id": 1383,
    "vorder": 44,
    "position": 1,
    "text": "ز چرخ چهارم خور آیدت شوی"
  },
  {
    "poem_id": 1383,
    "vorder": 45,
    "position": 0,
    "text": "چو رودابه گفتار ایشان شنید"
  },
  {
    "poem_id": 1383,
    "vorder": 46,
    "position": 1,
    "text": "چو از باد آتش دلش بردمید"
  },
  {
    "poem_id": 1383,
    "vorder": 47,
    "position": 0,
    "text": "بر ایشان یکی بانگ برزد به خشم"
  },
  {
    "poem_id": 1383,
    "vorder": 48,
    "position": 1,
    "text": "بتابید روی و بخوابید چشم"
  },
  {
    "poem_id": 1383,
    "vorder": 49,
    "position": 0,
    "text": "وز آن پس به چشم و به روی دژم"
  },
  {
    "poem_id": 1383,
    "vorder": 50,
    "position": 1,
    "text": "به ابرو ز خشم اندر آورد خم"
  },
  {
    "poem_id": 1383,
    "vorder": 51,
    "position": 0,
    "text": "چنین گفت کاین خام پیکارتان"
  },
  {
    "poem_id": 1383,
    "vorder": 52,
    "position": 1,
    "text": "شنیدن نیرزید گفتارتان"
  },
  {
    "poem_id": 1383,
    "vorder": 53,
    "position": 0,
    "text": "نه قیصر بخواهم نه فغفور چین"
  },
  {
    "poem_id": 1383,
    "vorder": 54,
    "position": 1,
    "text": "نه از تاجداران ایران زمین"
  },
  {
    "poem_id": 1383,
    "vorder": 55,
    "position": 0,
    "text": "به بالای من پور سامست زال"
  },
  {
    "poem_id": 1383,
    "vorder": 56,
    "position": 1,
    "text": "ابا بازوی شیر و با برز و یال"
  },
  {
    "poem_id": 1383,
    "vorder": 57,
    "position": 0,
    "text": "گرش پیر خوانی همی گر جوان"
  },
  {
    "poem_id": 1383,
    "vorder": 58,
    "position": 1,
    "text": "مرا او به جای تنست و روان"
  },
  {
    "poem_id": 1383,
    "vorder": 59,
    "position": 0,
    "text": "مرا مهر او دل ندیده گزید"
  },
  {
    "poem_id": 1383,
    "vorder": 60,
    "position": 1,
    "text": "همان دوستی از شنیده گزید"
  },
  {
    "poem_id": 1383,
    "vorder": 61,
    "position": 0,
    "text": "بر او مهربانم به بر روی و موی"
  },
  {
    "poem_id": 1383,
    "vorder": 62,
    "position": 1,
    "text": "به سوی هنر گشتمش مهرجوی"
  },
  {
    "poem_id": 1383,
    "vorder": 63,
    "position": 0,
    "text": "پرستنده آگه شد از راز او"
  },
  {
    "poem_id": 1383,
    "vorder": 64,
    "position": 1,
    "text": "چو بشنید دل خسته آواز او"
  },
  {
    "poem_id": 1383,
    "vorder": 65,
    "position": 0,
    "text": "به آواز گفتند ما بنده‌ایم"
  },
  {
    "poem_id": 1383,
    "vorder": 66,
    "position": 1,
    "text": "به دل مهربان و پرستنده‌ایم"
  },
  {
    "poem_id": 1383,
    "vorder": 67,
    "position": 0,
    "text": "نگه کن کنون تا چه فرمان دهی"
  },
  {
    "poem_id": 1383,
    "vorder": 68,
    "position": 1,
    "text": "نیاید ز فرمان تو جز بهی"
  },
  {
    "poem_id": 1383,
    "vorder": 69,
    "position": 0,
    "text": "یکی گفت ز ایشان که ای سرو بن"
  },
  {
    "poem_id": 1383,
    "vorder": 70,
    "position": 1,
    "text": "نگر تا نداند کسی این سخن"
  },
  {
    "poem_id": 1383,
    "vorder": 71,
    "position": 0,
    "text": "اگر جادویی باید آموختن"
  },
  {
    "poem_id": 1383,
    "vorder": 72,
    "position": 1,
    "text": "به بند و فسون چشمها دوختن"
  },
  {
    "poem_id": 1383,
    "vorder": 73,
    "position": 0,
    "text": "بپریم با مرغ و جادو شویم"
  },
  {
    "poem_id": 1383,
    "vorder": 74,
    "position": 1,
    "text": "بپوییم و در چاره آهو شویم"
  },
  {
    "poem_id": 1383,
    "vorder": 75,
    "position": 0,
    "text": "مگر شاه را نزد ماه آوریم"
  },
  {
    "poem_id": 1383,
    "vorder": 76,
    "position": 1,
    "text": "به نزدیک او پایگاه آوریم"
  },
  {
    "poem_id": 1383,
    "vorder": 77,
    "position": 0,
    "text": "لب سرخ رودابه پرخنده کرد"
  },
  {
    "poem_id": 1383,
    "vorder": 78,
    "position": 1,
    "text": "رخان معصفر سوی بنده کرد"
  },
  {
    "poem_id": 1383,
    "vorder": 79,
    "position": 0,
    "text": "که این گفته را گر شوی کاربند"
  },
  {
    "poem_id": 1383,
    "vorder": 80,
    "position": 1,
    "text": "درختی برومند کاری بلند"
  },
  {
    "poem_id": 1383,
    "vorder": 81,
    "position": 0,
    "text": "که هر روز یاقوت بار آورد"
  },
  {
    "poem_id": 1383,
    "vorder": 82,
    "position": 1,
    "text": "برش تازیان بر کنار آورد"
  }
]