[
  {
    "poem_id": 1583,
    "vorder": 1,
    "position": 0,
    "text": "یکی کوه بد پیش مرد جوان"
  },
  {
    "poem_id": 1583,
    "vorder": 2,
    "position": 1,
    "text": "برانگیخت آن باره را پهلوان"
  },
  {
    "poem_id": 1583,
    "vorder": 3,
    "position": 0,
    "text": "نگه کرد بهمن به نخچیرگاه"
  },
  {
    "poem_id": 1583,
    "vorder": 4,
    "position": 1,
    "text": "بدید آن بر پهلوان سپاه"
  },
  {
    "poem_id": 1583,
    "vorder": 5,
    "position": 0,
    "text": "درختی گرفته به چنگ اندرون"
  },
  {
    "poem_id": 1583,
    "vorder": 6,
    "position": 1,
    "text": "بر او نشسته بسی رهنمون"
  },
  {
    "poem_id": 1583,
    "vorder": 7,
    "position": 0,
    "text": "یکی نره گوری زده بر درخت"
  },
  {
    "poem_id": 1583,
    "vorder": 8,
    "position": 1,
    "text": "نهاده بر خویش گوپال و رخت"
  },
  {
    "poem_id": 1583,
    "vorder": 9,
    "position": 0,
    "text": "یکی جام پر می به دست دگر"
  },
  {
    "poem_id": 1583,
    "vorder": 10,
    "position": 1,
    "text": "پرستنده بر پای پیشش پسر"
  },
  {
    "poem_id": 1583,
    "vorder": 11,
    "position": 0,
    "text": "همی گشت رخش اندران مرغزار"
  },
  {
    "poem_id": 1583,
    "vorder": 12,
    "position": 1,
    "text": "درخت و گیا بود و هم جویبار"
  },
  {
    "poem_id": 1583,
    "vorder": 13,
    "position": 0,
    "text": "به دل گفت بهمن که این رستمست"
  },
  {
    "poem_id": 1583,
    "vorder": 14,
    "position": 1,
    "text": "و گر آفتاب سپیده دمست"
  },
  {
    "poem_id": 1583,
    "vorder": 15,
    "position": 0,
    "text": "به گیتی کسی مرد ازین سان ندید"
  },
  {
    "poem_id": 1583,
    "vorder": 16,
    "position": 1,
    "text": "نه از نامداران پیشی شنید"
  },
  {
    "poem_id": 1583,
    "vorder": 17,
    "position": 0,
    "text": "بترسم که با او یل اسفندیار"
  },
  {
    "poem_id": 1583,
    "vorder": 18,
    "position": 1,
    "text": "نتابد بپیچد سر از کارزار"
  },
  {
    "poem_id": 1583,
    "vorder": 19,
    "position": 0,
    "text": "من این را به یک سنگ بیجان کنم"
  },
  {
    "poem_id": 1583,
    "vorder": 20,
    "position": 1,
    "text": "دل زال و رودابه پیچان کنم"
  },
  {
    "poem_id": 1583,
    "vorder": 21,
    "position": 0,
    "text": "یکی سنگ زان کوه خارا بکند"
  },
  {
    "poem_id": 1583,
    "vorder": 22,
    "position": 1,
    "text": "فروهشت زان کوهسار بلند"
  },
  {
    "poem_id": 1583,
    "vorder": 23,
    "position": 0,
    "text": "ز نخچیرگاهش زواره بدید"
  },
  {
    "poem_id": 1583,
    "vorder": 24,
    "position": 1,
    "text": "خروشیدن سنگ خارا شنید"
  },
  {
    "poem_id": 1583,
    "vorder": 25,
    "position": 0,
    "text": "خروشید کای مهتر نامدار"
  },
  {
    "poem_id": 1583,
    "vorder": 26,
    "position": 1,
    "text": "یکی سنگ غلتان شد از کوهسار"
  },
  {
    "poem_id": 1583,
    "vorder": 27,
    "position": 0,
    "text": "نجنبید رستم نه بنهاد گور"
  },
  {
    "poem_id": 1583,
    "vorder": 28,
    "position": 1,
    "text": "زواره همی کرد ازان گونه شور"
  },
  {
    "poem_id": 1583,
    "vorder": 29,
    "position": 0,
    "text": "همی بود تا سنگ نزدیک شد"
  },
  {
    "poem_id": 1583,
    "vorder": 30,
    "position": 1,
    "text": "ز گردش بر کوه تاریک شد"
  },
  {
    "poem_id": 1583,
    "vorder": 31,
    "position": 0,
    "text": "بزد پاشنه سنگ بنداخت دور"
  },
  {
    "poem_id": 1583,
    "vorder": 32,
    "position": 1,
    "text": "زواره برو آفرین کرد و پور"
  },
  {
    "poem_id": 1583,
    "vorder": 33,
    "position": 0,
    "text": "غمی شد دل بهمن از کار اوی"
  },
  {
    "poem_id": 1583,
    "vorder": 34,
    "position": 1,
    "text": "چو دید آن بزرگی و کردار اوی"
  },
  {
    "poem_id": 1583,
    "vorder": 35,
    "position": 0,
    "text": "همی گفت گر فرخ اسفندیار"
  },
  {
    "poem_id": 1583,
    "vorder": 36,
    "position": 1,
    "text": "کند با چنین نامور کارزار"
  },
  {
    "poem_id": 1583,
    "vorder": 37,
    "position": 0,
    "text": "تن خویش در جنگ رسوا کند"
  },
  {
    "poem_id": 1583,
    "vorder": 38,
    "position": 1,
    "text": "همان به که با او مدارا کند"
  },
  {
    "poem_id": 1583,
    "vorder": 39,
    "position": 0,
    "text": "ور ایدونک او بهتر آید به جنگ"
  },
  {
    "poem_id": 1583,
    "vorder": 40,
    "position": 1,
    "text": "همه شهر ایران بگیرد به چنگ"
  },
  {
    "poem_id": 1583,
    "vorder": 41,
    "position": 0,
    "text": "نشست از بر بارهٔ بادپای"
  },
  {
    "poem_id": 1583,
    "vorder": 42,
    "position": 1,
    "text": "پراندیشه از کوه شد باز جای"
  },
  {
    "poem_id": 1583,
    "vorder": 43,
    "position": 0,
    "text": "بگفت آن شگفتی به موبد که دید"
  },
  {
    "poem_id": 1583,
    "vorder": 44,
    "position": 1,
    "text": "وزان راه آسان سر اندر کشید"
  },
  {
    "poem_id": 1583,
    "vorder": 45,
    "position": 0,
    "text": "چو آمد به نزدیک نخچیرگاه"
  },
  {
    "poem_id": 1583,
    "vorder": 46,
    "position": 1,
    "text": "هم‌انگه تهمتن بدیدش ز راه"
  },
  {
    "poem_id": 1583,
    "vorder": 47,
    "position": 0,
    "text": "به موبد چنین گفت کین مرد کیست"
  },
  {
    "poem_id": 1583,
    "vorder": 48,
    "position": 1,
    "text": "من ایدون گمانم که گشتاسپیست"
  },
  {
    "poem_id": 1583,
    "vorder": 49,
    "position": 0,
    "text": "پذیره شدش با زواره بهم"
  },
  {
    "poem_id": 1583,
    "vorder": 50,
    "position": 1,
    "text": "به نخچیرگه هرک بد بیش و کم"
  },
  {
    "poem_id": 1583,
    "vorder": 51,
    "position": 0,
    "text": "پیاده شد از باره بهمن چو دود"
  },
  {
    "poem_id": 1583,
    "vorder": 52,
    "position": 1,
    "text": "بپرسیدش و نیکویها فزود"
  },
  {
    "poem_id": 1583,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت رستم که تا نام خویش"
  },
  {
    "poem_id": 1583,
    "vorder": 54,
    "position": 1,
    "text": "نگویی نیابی ز من کام خویش"
  },
  {
    "poem_id": 1583,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت من پور اسفندیار"
  },
  {
    "poem_id": 1583,
    "vorder": 56,
    "position": 1,
    "text": "سر راستان بهمن نامدار"
  },
  {
    "poem_id": 1583,
    "vorder": 57,
    "position": 0,
    "text": "ورا پهلوان زود در بر گرفت"
  },
  {
    "poem_id": 1583,
    "vorder": 58,
    "position": 1,
    "text": "ز دیر آمدن پوزش اندر گرفت"
  },
  {
    "poem_id": 1583,
    "vorder": 59,
    "position": 0,
    "text": "برفتند هر دو به جای نشست"
  },
  {
    "poem_id": 1583,
    "vorder": 60,
    "position": 1,
    "text": "خود و نامداران خسروپرست"
  },
  {
    "poem_id": 1583,
    "vorder": 61,
    "position": 0,
    "text": "چو بنشست بهمن بدادش درود"
  },
  {
    "poem_id": 1583,
    "vorder": 62,
    "position": 1,
    "text": "ز شاه و ز ایرانیان برفزود"
  },
  {
    "poem_id": 1583,
    "vorder": 63,
    "position": 0,
    "text": "ازان پس چنین گفت کاسفندیار"
  },
  {
    "poem_id": 1583,
    "vorder": 64,
    "position": 1,
    "text": "چو آتش برفت از در شهریار"
  },
  {
    "poem_id": 1583,
    "vorder": 65,
    "position": 0,
    "text": "سراپرده زد بر لب هیرمند"
  },
  {
    "poem_id": 1583,
    "vorder": 66,
    "position": 1,
    "text": "به فرمان فرخنده شاه بلند"
  },
  {
    "poem_id": 1583,
    "vorder": 67,
    "position": 0,
    "text": "پیامی رسانم ز اسفندیار"
  },
  {
    "poem_id": 1583,
    "vorder": 68,
    "position": 1,
    "text": "اگر بشنود پهلوان سوار"
  },
  {
    "poem_id": 1583,
    "vorder": 69,
    "position": 0,
    "text": "چنین گفت رستم که فرمان شاه"
  },
  {
    "poem_id": 1583,
    "vorder": 70,
    "position": 1,
    "text": "برآنم که برتر ز خورشید و ماه"
  },
  {
    "poem_id": 1583,
    "vorder": 71,
    "position": 0,
    "text": "خوریم آنچ داریم چیزی نخست"
  },
  {
    "poem_id": 1583,
    "vorder": 72,
    "position": 1,
    "text": "پس‌انگه جهان زیر فرمان تست"
  },
  {
    "poem_id": 1583,
    "vorder": 73,
    "position": 0,
    "text": "بگسترد بر سفره بر نان نرم"
  },
  {
    "poem_id": 1583,
    "vorder": 74,
    "position": 1,
    "text": "یکی گور بریان بیاورد گرم"
  },
  {
    "poem_id": 1583,
    "vorder": 75,
    "position": 0,
    "text": "چو دستارخوان پیش بهمن نهاد"
  },
  {
    "poem_id": 1583,
    "vorder": 76,
    "position": 1,
    "text": "گذشته سخنها برو کرد یاد"
  },
  {
    "poem_id": 1583,
    "vorder": 77,
    "position": 0,
    "text": "برادرش را نیز با خود نشاند"
  },
  {
    "poem_id": 1583,
    "vorder": 78,
    "position": 1,
    "text": "وزان نامداران کسان را نخواند"
  },
  {
    "poem_id": 1583,
    "vorder": 79,
    "position": 0,
    "text": "دگر گور بنهاد پیش تنش"
  },
  {
    "poem_id": 1583,
    "vorder": 80,
    "position": 1,
    "text": "که هر بار گوری بدی خوردنیش"
  },
  {
    "poem_id": 1583,
    "vorder": 81,
    "position": 0,
    "text": "نمک بر پراگند و ببرید و خورد"
  },
  {
    "poem_id": 1583,
    "vorder": 82,
    "position": 1,
    "text": "نظاره بروبر سرافراز مرد"
  },
  {
    "poem_id": 1583,
    "vorder": 83,
    "position": 0,
    "text": "همی خورد بهمن ز گور اندکی"
  },
  {
    "poem_id": 1583,
    "vorder": 84,
    "position": 1,
    "text": "نبد خوردنش زان او صد یکی"
  },
  {
    "poem_id": 1583,
    "vorder": 85,
    "position": 0,
    "text": "بخندید رستم بدو گفت شاه"
  },
  {
    "poem_id": 1583,
    "vorder": 86,
    "position": 1,
    "text": "ز بهر خورش دارد این پیشگاه"
  },
  {
    "poem_id": 1583,
    "vorder": 87,
    "position": 0,
    "text": "خورش چون بدین گونه داری به خوان"
  },
  {
    "poem_id": 1583,
    "vorder": 88,
    "position": 1,
    "text": "چرا رفتی اندر دم هفتخوان"
  },
  {
    "poem_id": 1583,
    "vorder": 89,
    "position": 0,
    "text": "چگونه زدی نیزه در کارزار"
  },
  {
    "poem_id": 1583,
    "vorder": 90,
    "position": 1,
    "text": "چو خوردن چنین داری ای شهریار"
  },
  {
    "poem_id": 1583,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت بهمن که خسرو نژاد"
  },
  {
    "poem_id": 1583,
    "vorder": 92,
    "position": 1,
    "text": "سخن‌گوی و بسیار خواره مباد"
  },
  {
    "poem_id": 1583,
    "vorder": 93,
    "position": 0,
    "text": "خورش کم بود کوشش و جنگ بیش"
  },
  {
    "poem_id": 1583,
    "vorder": 94,
    "position": 1,
    "text": "به کف بر نهیم آن زمان جان خویش"
  },
  {
    "poem_id": 1583,
    "vorder": 95,
    "position": 0,
    "text": "بخندید رستم به آواز گفت"
  },
  {
    "poem_id": 1583,
    "vorder": 96,
    "position": 1,
    "text": "که مردی نشاید ز مردان نهفت"
  },
  {
    "poem_id": 1583,
    "vorder": 97,
    "position": 0,
    "text": "یکی جام زرین پر از باده کرد"
  },
  {
    "poem_id": 1583,
    "vorder": 98,
    "position": 1,
    "text": "وزو یاد مردان آزاده کرد"
  },
  {
    "poem_id": 1583,
    "vorder": 99,
    "position": 0,
    "text": "دگر جام بر دست بهمن نهاد"
  },
  {
    "poem_id": 1583,
    "vorder": 100,
    "position": 1,
    "text": "که برگیر ازان کس که خواهی تو یاد"
  },
  {
    "poem_id": 1583,
    "vorder": 101,
    "position": 0,
    "text": "بترسید بهمن ز جام نبید"
  },
  {
    "poem_id": 1583,
    "vorder": 102,
    "position": 1,
    "text": "زواره نخستین دمی درکشید"
  },
  {
    "poem_id": 1583,
    "vorder": 103,
    "position": 0,
    "text": "بدو گفت کای بچهٔ شهریار"
  },
  {
    "poem_id": 1583,
    "vorder": 104,
    "position": 1,
    "text": "به تو شاد بادا می و میگسار"
  },
  {
    "poem_id": 1583,
    "vorder": 105,
    "position": 0,
    "text": "ازو بستد آن جام بهمن به چنگ"
  },
  {
    "poem_id": 1583,
    "vorder": 106,
    "position": 1,
    "text": "دل آزار کرده بدان می درنگ"
  },
  {
    "poem_id": 1583,
    "vorder": 107,
    "position": 0,
    "text": "همی ماند از رستم اندر شگفت"
  },
  {
    "poem_id": 1583,
    "vorder": 108,
    "position": 1,
    "text": "ازان خوردن و یال و بازوی و کفت"
  },
  {
    "poem_id": 1583,
    "vorder": 109,
    "position": 0,
    "text": "نشستند بر باره هر دو سوار"
  },
  {
    "poem_id": 1583,
    "vorder": 110,
    "position": 1,
    "text": "همی راند بهمن بر نامدار"
  },
  {
    "poem_id": 1583,
    "vorder": 111,
    "position": 0,
    "text": "بدادش یکایک درود و پیام"
  },
  {
    "poem_id": 1583,
    "vorder": 112,
    "position": 1,
    "text": "از اسفندیار آن یل نیک‌نام"
  }
]