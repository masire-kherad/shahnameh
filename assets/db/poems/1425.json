[
  {
    "poem_id": 1425,
    "vorder": 1,
    "position": 0,
    "text": "به شاهی نشست از برش کیقباد"
  },
  {
    "poem_id": 1425,
    "vorder": 2,
    "position": 1,
    "text": "همان تاج گوهر به سر برنهاد"
  },
  {
    "poem_id": 1425,
    "vorder": 3,
    "position": 0,
    "text": "همه نامداران شدند انجمن"
  },
  {
    "poem_id": 1425,
    "vorder": 4,
    "position": 1,
    "text": "چو دستان و چون قارن رزم‌زن"
  },
  {
    "poem_id": 1425,
    "vorder": 5,
    "position": 0,
    "text": "چو کشواد و خراد و برزین گو"
  },
  {
    "poem_id": 1425,
    "vorder": 6,
    "position": 1,
    "text": "فشاندند گوهر بران تاج نو"
  },
  {
    "poem_id": 1425,
    "vorder": 7,
    "position": 0,
    "text": "قباد از بزرگان سخن بشنوید"
  },
  {
    "poem_id": 1425,
    "vorder": 8,
    "position": 1,
    "text": "پس افراسیاب و سپه را بدید"
  },
  {
    "poem_id": 1425,
    "vorder": 9,
    "position": 0,
    "text": "دگر روز برداشت لشکر ز جای"
  },
  {
    "poem_id": 1425,
    "vorder": 10,
    "position": 1,
    "text": "خروشیدن آمد ز پرده‌سرای"
  },
  {
    "poem_id": 1425,
    "vorder": 11,
    "position": 0,
    "text": "بپوشید رستم سلیح نبرد"
  },
  {
    "poem_id": 1425,
    "vorder": 12,
    "position": 1,
    "text": "چو پیل ژیان شد که برخاست گرد"
  },
  {
    "poem_id": 1425,
    "vorder": 13,
    "position": 0,
    "text": "رده بر کشیدند ایرانیان"
  },
  {
    "poem_id": 1425,
    "vorder": 14,
    "position": 1,
    "text": "ببستند خون ریختن را میان"
  },
  {
    "poem_id": 1425,
    "vorder": 15,
    "position": 0,
    "text": "به یک دست مهراب کابل خدای"
  },
  {
    "poem_id": 1425,
    "vorder": 16,
    "position": 1,
    "text": "دگر دست گژدهم جنگی به پای"
  },
  {
    "poem_id": 1425,
    "vorder": 17,
    "position": 0,
    "text": "به قلب اندرون قارن رزم‌زن"
  },
  {
    "poem_id": 1425,
    "vorder": 18,
    "position": 1,
    "text": "ابا گرد کشواد لشگر شکن"
  },
  {
    "poem_id": 1425,
    "vorder": 19,
    "position": 0,
    "text": "پس پشت‌شان زال با کیقباد"
  },
  {
    "poem_id": 1425,
    "vorder": 20,
    "position": 1,
    "text": "به یک دست آتش به یک دست باد"
  },
  {
    "poem_id": 1425,
    "vorder": 21,
    "position": 0,
    "text": "به پیش اندرون کاویانی درفش"
  },
  {
    "poem_id": 1425,
    "vorder": 22,
    "position": 1,
    "text": "جهان زو شده سرخ و زرد و بنفش"
  },
  {
    "poem_id": 1425,
    "vorder": 23,
    "position": 0,
    "text": "ز لشکر چو کشتی سراسر زمین"
  },
  {
    "poem_id": 1425,
    "vorder": 24,
    "position": 1,
    "text": "کجا موج خیزد ز دریای چین"
  },
  {
    "poem_id": 1425,
    "vorder": 25,
    "position": 0,
    "text": "سپر در سپر بافته دشت و راغ"
  },
  {
    "poem_id": 1425,
    "vorder": 26,
    "position": 1,
    "text": "درفشیدن تیغها چون چراغ"
  },
  {
    "poem_id": 1425,
    "vorder": 27,
    "position": 0,
    "text": "جهان سر به سر گشت دریای قار"
  },
  {
    "poem_id": 1425,
    "vorder": 28,
    "position": 1,
    "text": "برافروخته شمع ازو صدهزار"
  },
  {
    "poem_id": 1425,
    "vorder": 29,
    "position": 0,
    "text": "ز نالیدن بوق و بانگ سپاه"
  },
  {
    "poem_id": 1425,
    "vorder": 30,
    "position": 1,
    "text": "تو گفتی که خورشید گم کرد راه"
  },
  {
    "poem_id": 1425,
    "vorder": 31,
    "position": 0,
    "text": "سبک قارن رزم‌زن کان بدید"
  },
  {
    "poem_id": 1425,
    "vorder": 32,
    "position": 1,
    "text": "چو رعد از میان نعره‌ای برکشید"
  },
  {
    "poem_id": 1425,
    "vorder": 33,
    "position": 0,
    "text": "میان سپاه اندر آمد دلیر"
  },
  {
    "poem_id": 1425,
    "vorder": 34,
    "position": 1,
    "text": "سپهدار قارن به کردار شیر"
  },
  {
    "poem_id": 1425,
    "vorder": 35,
    "position": 0,
    "text": "گهی سوی چپّ و گهی سوی راست"
  },
  {
    "poem_id": 1425,
    "vorder": 36,
    "position": 1,
    "text": "بران گونه از هر سویی کینه خواست"
  },
  {
    "poem_id": 1425,
    "vorder": 37,
    "position": 0,
    "text": "به گرز و به تیغ و سنان دراز"
  },
  {
    "poem_id": 1425,
    "vorder": 38,
    "position": 1,
    "text": "همی کُشت از ایشان گو سرفراز"
  },
  {
    "poem_id": 1425,
    "vorder": 39,
    "position": 0,
    "text": "ز کشته زمین کرد مانند کوه"
  },
  {
    "poem_id": 1425,
    "vorder": 40,
    "position": 1,
    "text": "شدند آن دلیران ترکان ستوه"
  },
  {
    "poem_id": 1425,
    "vorder": 41,
    "position": 0,
    "text": "شماساس را دید گرد دلیر"
  },
  {
    "poem_id": 1425,
    "vorder": 42,
    "position": 1,
    "text": "که می‌برخروشید چون نرّه شیر"
  },
  {
    "poem_id": 1425,
    "vorder": 43,
    "position": 0,
    "text": "بیامد دمان تا بر او رسید"
  },
  {
    "poem_id": 1425,
    "vorder": 44,
    "position": 1,
    "text": "سبک تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 1425,
    "vorder": 45,
    "position": 0,
    "text": "بزد بر سرش تیغ زهر آبدار"
  },
  {
    "poem_id": 1425,
    "vorder": 46,
    "position": 1,
    "text": "بگفتا منم قارن نامدار"
  },
  {
    "poem_id": 1425,
    "vorder": 47,
    "position": 0,
    "text": "نگون اندر آمد شماساس گرد"
  },
  {
    "poem_id": 1425,
    "vorder": 48,
    "position": 1,
    "text": "چو دید او ز قارن چنان دست برد"
  },
  {
    "poem_id": 1425,
    "vorder": 49,
    "position": 0,
    "text": "چنین است کردار گردون پیر"
  },
  {
    "poem_id": 1425,
    "vorder": 50,
    "position": 1,
    "text": "گهی چون کمانست و گاهی چو تیر"
  }
]