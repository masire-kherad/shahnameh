[
  {
    "poem_id": 1635,
    "vorder": 1,
    "position": 0,
    "text": "سکندر چو از کارش آگاه شد"
  },
  {
    "poem_id": 1635,
    "vorder": 2,
    "position": 1,
    "text": "که دارا به تخت افسر ماه شد"
  },
  {
    "poem_id": 1635,
    "vorder": 3,
    "position": 0,
    "text": "سپه برگرفت از عراق و براند"
  },
  {
    "poem_id": 1635,
    "vorder": 4,
    "position": 1,
    "text": "به رومی همی نام یزدان بخواند"
  },
  {
    "poem_id": 1635,
    "vorder": 5,
    "position": 0,
    "text": "سپه را میان و کرانه نبود"
  },
  {
    "poem_id": 1635,
    "vorder": 6,
    "position": 1,
    "text": "همان بخت دارا جوانه نبود"
  },
  {
    "poem_id": 1635,
    "vorder": 7,
    "position": 0,
    "text": "پذیره شدن را بیاراست شاه"
  },
  {
    "poem_id": 1635,
    "vorder": 8,
    "position": 1,
    "text": "بیاورد ز اصطخر چندان سپاه"
  },
  {
    "poem_id": 1635,
    "vorder": 9,
    "position": 0,
    "text": "که گفتی ستاره نتابد همی"
  },
  {
    "poem_id": 1635,
    "vorder": 10,
    "position": 1,
    "text": "فلک راه رفتن نیابد همی"
  },
  {
    "poem_id": 1635,
    "vorder": 11,
    "position": 0,
    "text": "سپاه دو کشور کشیدند صف"
  },
  {
    "poem_id": 1635,
    "vorder": 12,
    "position": 1,
    "text": "همه نیزه و گرز و خنجر به کف"
  },
  {
    "poem_id": 1635,
    "vorder": 13,
    "position": 0,
    "text": "برآمد چنان از دو لشکر خروش"
  },
  {
    "poem_id": 1635,
    "vorder": 14,
    "position": 1,
    "text": "که چرخ فلک را بدرید گوش"
  },
  {
    "poem_id": 1635,
    "vorder": 15,
    "position": 0,
    "text": "چو دریا شد از خون گردان زمین"
  },
  {
    "poem_id": 1635,
    "vorder": 16,
    "position": 1,
    "text": "تن بی‌سران بد همه دشت کین"
  },
  {
    "poem_id": 1635,
    "vorder": 17,
    "position": 0,
    "text": "پدر را نبد بر پسر جای مهر"
  },
  {
    "poem_id": 1635,
    "vorder": 18,
    "position": 1,
    "text": "بریشان نبخشید گردان سپهر"
  },
  {
    "poem_id": 1635,
    "vorder": 19,
    "position": 0,
    "text": "سیم ره به دارا درآمد شکست"
  },
  {
    "poem_id": 1635,
    "vorder": 20,
    "position": 1,
    "text": "سکندر میان تاختن را ببست"
  },
  {
    "poem_id": 1635,
    "vorder": 21,
    "position": 0,
    "text": "جهاندار لشکر به کرمان کشید"
  },
  {
    "poem_id": 1635,
    "vorder": 22,
    "position": 1,
    "text": "همی از بد دشمنان جان کشید"
  },
  {
    "poem_id": 1635,
    "vorder": 23,
    "position": 0,
    "text": "سکندر بیامد زی اصطخر پارس"
  },
  {
    "poem_id": 1635,
    "vorder": 24,
    "position": 1,
    "text": "که دیهیم شاهان بد و فخر پارس"
  },
  {
    "poem_id": 1635,
    "vorder": 25,
    "position": 0,
    "text": "خروشی بلند آمد از بارگاه"
  },
  {
    "poem_id": 1635,
    "vorder": 26,
    "position": 1,
    "text": "که ای مهتران نماینده راه"
  },
  {
    "poem_id": 1635,
    "vorder": 27,
    "position": 0,
    "text": "هرانکس که زنهار خواهد همی"
  },
  {
    "poem_id": 1635,
    "vorder": 28,
    "position": 1,
    "text": "ز کرده به یزدان پناهد همی"
  },
  {
    "poem_id": 1635,
    "vorder": 29,
    "position": 0,
    "text": "همه یکسره در پناه منید"
  },
  {
    "poem_id": 1635,
    "vorder": 30,
    "position": 1,
    "text": "بدانید اگر نیک‌خواه منید"
  },
  {
    "poem_id": 1635,
    "vorder": 31,
    "position": 0,
    "text": "همه خستگان را ببخشیم چیز"
  },
  {
    "poem_id": 1635,
    "vorder": 32,
    "position": 1,
    "text": "همان خون دشمن نریزیم نیز"
  },
  {
    "poem_id": 1635,
    "vorder": 33,
    "position": 0,
    "text": "ز چیز کسان دست کوته کنیم"
  },
  {
    "poem_id": 1635,
    "vorder": 34,
    "position": 1,
    "text": "خرد را سوی روشنی ره کنیم"
  },
  {
    "poem_id": 1635,
    "vorder": 35,
    "position": 0,
    "text": "که پیروزگر دادمان فرهی"
  },
  {
    "poem_id": 1635,
    "vorder": 36,
    "position": 1,
    "text": "بزرگی و دیهیم شاهنشهی"
  },
  {
    "poem_id": 1635,
    "vorder": 37,
    "position": 0,
    "text": "کسی کو ز فرمان ما بگذرد"
  },
  {
    "poem_id": 1635,
    "vorder": 38,
    "position": 1,
    "text": "همی گردن اژدها بشکرد"
  },
  {
    "poem_id": 1635,
    "vorder": 39,
    "position": 0,
    "text": "ز چیزی که دید اندران رزمگاه"
  },
  {
    "poem_id": 1635,
    "vorder": 40,
    "position": 1,
    "text": "ببخشید یکسر همه بر سپاه"
  },
  {
    "poem_id": 1635,
    "vorder": 41,
    "position": 0,
    "text": "چو دارا ز ایران به کرمان رسید"
  },
  {
    "poem_id": 1635,
    "vorder": 42,
    "position": 1,
    "text": "دو بهر از بزرگان لشکر ندید"
  },
  {
    "poem_id": 1635,
    "vorder": 43,
    "position": 0,
    "text": "خروشی بد اندر میان سپاه"
  },
  {
    "poem_id": 1635,
    "vorder": 44,
    "position": 1,
    "text": "یکی را ندیدند بر سر کلاه"
  },
  {
    "poem_id": 1635,
    "vorder": 45,
    "position": 0,
    "text": "بزرگان فرزانه را گرد کرد"
  },
  {
    "poem_id": 1635,
    "vorder": 46,
    "position": 1,
    "text": "کسی را که با او بد اندر نبرد"
  },
  {
    "poem_id": 1635,
    "vorder": 47,
    "position": 0,
    "text": "همه مهتران زار و گریان شدند"
  },
  {
    "poem_id": 1635,
    "vorder": 48,
    "position": 1,
    "text": "ز بخت بد خویش بریان شدند"
  },
  {
    "poem_id": 1635,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت دارا که هم بی‌گمان"
  },
  {
    "poem_id": 1635,
    "vorder": 50,
    "position": 1,
    "text": "ز ما بود بر ما بد آسمان"
  },
  {
    "poem_id": 1635,
    "vorder": 51,
    "position": 0,
    "text": "شکن زین نشان در جهان کس ندید"
  },
  {
    "poem_id": 1635,
    "vorder": 52,
    "position": 1,
    "text": "نه از کاردانان پیشین شنید"
  },
  {
    "poem_id": 1635,
    "vorder": 53,
    "position": 0,
    "text": "زن و کودک شهریاران اسیر"
  },
  {
    "poem_id": 1635,
    "vorder": 54,
    "position": 1,
    "text": "وگر کشته خسته به ژوپین و تیر"
  },
  {
    "poem_id": 1635,
    "vorder": 55,
    "position": 0,
    "text": "چه بینید و این را چه درمان کنید"
  },
  {
    "poem_id": 1635,
    "vorder": 56,
    "position": 1,
    "text": "که بدخواه را زین پشیمان کنید"
  },
  {
    "poem_id": 1635,
    "vorder": 57,
    "position": 0,
    "text": "نه کشور نه لشکر نه تخت و کلاه"
  },
  {
    "poem_id": 1635,
    "vorder": 58,
    "position": 1,
    "text": "نه شاهی نه فرزند و گنج و سپاه"
  },
  {
    "poem_id": 1635,
    "vorder": 59,
    "position": 0,
    "text": "ار ایدونک بخشایش کردگار"
  },
  {
    "poem_id": 1635,
    "vorder": 60,
    "position": 1,
    "text": "نباشد تبه شد به ما روزگار"
  },
  {
    "poem_id": 1635,
    "vorder": 61,
    "position": 0,
    "text": "کسی کز گرانمایگان زیستند"
  },
  {
    "poem_id": 1635,
    "vorder": 62,
    "position": 1,
    "text": "به پیش شهنشاه بگریستند"
  },
  {
    "poem_id": 1635,
    "vorder": 63,
    "position": 0,
    "text": "به آواز گفتند کای شهریار"
  },
  {
    "poem_id": 1635,
    "vorder": 64,
    "position": 1,
    "text": "همه خسته‌ایم از بد روزگار"
  },
  {
    "poem_id": 1635,
    "vorder": 65,
    "position": 0,
    "text": "سپه را ز کوشش سخن درگذشت"
  },
  {
    "poem_id": 1635,
    "vorder": 66,
    "position": 1,
    "text": "ز تارک دم آب برتر گذشت"
  },
  {
    "poem_id": 1635,
    "vorder": 67,
    "position": 0,
    "text": "پدر بی‌پسر شد پسر بی‌پدر"
  },
  {
    "poem_id": 1635,
    "vorder": 68,
    "position": 1,
    "text": "چنین آمد از چرخ گردان به سر"
  },
  {
    "poem_id": 1635,
    "vorder": 69,
    "position": 0,
    "text": "کرا مادر و خواهر و دختر است"
  },
  {
    "poem_id": 1635,
    "vorder": 70,
    "position": 1,
    "text": "همه پاک بر دست اسکندر است"
  },
  {
    "poem_id": 1635,
    "vorder": 71,
    "position": 0,
    "text": "همان پاک پوشیده‌رویان تو"
  },
  {
    "poem_id": 1635,
    "vorder": 72,
    "position": 1,
    "text": "که بودند لرزنده بر جان تو"
  },
  {
    "poem_id": 1635,
    "vorder": 73,
    "position": 0,
    "text": "چو گنج نیاکان برترمنش"
  },
  {
    "poem_id": 1635,
    "vorder": 74,
    "position": 1,
    "text": "که آمد به دست تو بی‌سرزنش"
  },
  {
    "poem_id": 1635,
    "vorder": 75,
    "position": 0,
    "text": "کنون مانده اندر کف رومیان"
  },
  {
    "poem_id": 1635,
    "vorder": 76,
    "position": 1,
    "text": "نژاد بزرگان و گنج کیان"
  },
  {
    "poem_id": 1635,
    "vorder": 77,
    "position": 0,
    "text": "ترا چاره با او مداراست بس"
  },
  {
    "poem_id": 1635,
    "vorder": 78,
    "position": 1,
    "text": "که تاج بزرگی نماند به کس"
  },
  {
    "poem_id": 1635,
    "vorder": 79,
    "position": 0,
    "text": "کسی گوید آتش زبانش نسوخت"
  },
  {
    "poem_id": 1635,
    "vorder": 80,
    "position": 1,
    "text": "به چاره بد از تن بباید سپوخت"
  },
  {
    "poem_id": 1635,
    "vorder": 81,
    "position": 0,
    "text": "تو او را به تن زیردستی نمای"
  },
  {
    "poem_id": 1635,
    "vorder": 82,
    "position": 1,
    "text": "یکی در سخن نیز چربی فزای"
  },
  {
    "poem_id": 1635,
    "vorder": 83,
    "position": 0,
    "text": "ببینیم فرجام تا چون بود"
  },
  {
    "poem_id": 1635,
    "vorder": 84,
    "position": 1,
    "text": "که گردش ز اندیشه بیرون بود"
  },
  {
    "poem_id": 1635,
    "vorder": 85,
    "position": 0,
    "text": "یکی نامه بنویس نزدیک او"
  },
  {
    "poem_id": 1635,
    "vorder": 86,
    "position": 1,
    "text": "پراندیشه کن جان تاریک او"
  },
  {
    "poem_id": 1635,
    "vorder": 87,
    "position": 0,
    "text": "هم این چرخ گردان برو بگذرد"
  },
  {
    "poem_id": 1635,
    "vorder": 88,
    "position": 1,
    "text": "چنین داند آنکس که دارد خرد"
  },
  {
    "poem_id": 1635,
    "vorder": 89,
    "position": 0,
    "text": "از ایشان چو بشنید فرمان گزید"
  },
  {
    "poem_id": 1635,
    "vorder": 90,
    "position": 1,
    "text": "چنان کز دل شهریاران سزید"
  }
]