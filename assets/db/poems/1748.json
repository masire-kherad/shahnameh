[
  {
    "poem_id": 1748,
    "vorder": 1,
    "position": 0,
    "text": "ز شاپور زان‌گونه شد روزگار"
  },
  {
    "poem_id": 1748,
    "vorder": 2,
    "position": 1,
    "text": "که در باغ با گل ندیدند خار"
  },
  {
    "poem_id": 1748,
    "vorder": 3,
    "position": 0,
    "text": "ز داد و ز رای و ز آهنگ اوی"
  },
  {
    "poem_id": 1748,
    "vorder": 4,
    "position": 1,
    "text": "ز بس کوشش و جنگ و نیرنگ اوی"
  },
  {
    "poem_id": 1748,
    "vorder": 5,
    "position": 0,
    "text": "مر او را به هر بوم دشمن نماند"
  },
  {
    "poem_id": 1748,
    "vorder": 6,
    "position": 1,
    "text": "بدی را به گیتی نشیمن نماند"
  },
  {
    "poem_id": 1748,
    "vorder": 7,
    "position": 0,
    "text": "چو نومید شد او ز چرخ بلند"
  },
  {
    "poem_id": 1748,
    "vorder": 8,
    "position": 1,
    "text": "بشد سالیانش به هفتاد و اند"
  },
  {
    "poem_id": 1748,
    "vorder": 9,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1748,
    "vorder": 10,
    "position": 1,
    "text": "ابا موبد موبدان اردشیر"
  },
  {
    "poem_id": 1748,
    "vorder": 11,
    "position": 0,
    "text": "جوانی که کهتر برادرش بود"
  },
  {
    "poem_id": 1748,
    "vorder": 12,
    "position": 1,
    "text": "به داد و خرد بر سر افسرش بود"
  },
  {
    "poem_id": 1748,
    "vorder": 13,
    "position": 0,
    "text": "ورا نام بود اردشیر جوان"
  },
  {
    "poem_id": 1748,
    "vorder": 14,
    "position": 1,
    "text": "توانا و دانا به سود و زیان"
  },
  {
    "poem_id": 1748,
    "vorder": 15,
    "position": 0,
    "text": "پسر بد یکی خرد شاپور نام"
  },
  {
    "poem_id": 1748,
    "vorder": 16,
    "position": 1,
    "text": "هنوز از جهان نارسیده به کام"
  },
  {
    "poem_id": 1748,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت پس شاه با اردشیر"
  },
  {
    "poem_id": 1748,
    "vorder": 18,
    "position": 1,
    "text": "که ای گرد و چابک سوار دلیر"
  },
  {
    "poem_id": 1748,
    "vorder": 19,
    "position": 0,
    "text": "اگر با من از داد پیمان کنی"
  },
  {
    "poem_id": 1748,
    "vorder": 20,
    "position": 1,
    "text": "زبان را به پیمان گروگان کنی"
  },
  {
    "poem_id": 1748,
    "vorder": 21,
    "position": 0,
    "text": "که فرزند من چون به مردی رسد"
  },
  {
    "poem_id": 1748,
    "vorder": 22,
    "position": 1,
    "text": "به گاه دلیری و گردی رسد"
  },
  {
    "poem_id": 1748,
    "vorder": 23,
    "position": 0,
    "text": "سپاری بدو تخت و گنج و سپاه"
  },
  {
    "poem_id": 1748,
    "vorder": 24,
    "position": 1,
    "text": "تو دستور باشی ورا نیک‌خواه"
  },
  {
    "poem_id": 1748,
    "vorder": 25,
    "position": 0,
    "text": "من این تاج شاهی سپارم به تو"
  },
  {
    "poem_id": 1748,
    "vorder": 26,
    "position": 1,
    "text": "همان گنج و لشکر گذارم به تو"
  },
  {
    "poem_id": 1748,
    "vorder": 27,
    "position": 0,
    "text": "بپذرفت زو این سخن اردشیر"
  },
  {
    "poem_id": 1748,
    "vorder": 28,
    "position": 1,
    "text": "به پیش بزرگان و پیش دبیر"
  },
  {
    "poem_id": 1748,
    "vorder": 29,
    "position": 0,
    "text": "که چون کودک او به مردی رسد"
  },
  {
    "poem_id": 1748,
    "vorder": 30,
    "position": 1,
    "text": "که دیهیم و تاج کیی را سزد"
  },
  {
    "poem_id": 1748,
    "vorder": 31,
    "position": 0,
    "text": "سپارم همه پادشاهی ورا"
  },
  {
    "poem_id": 1748,
    "vorder": 32,
    "position": 1,
    "text": "نسازم جز از نیک‌خواهی ورا"
  },
  {
    "poem_id": 1748,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید شاپور پیش مهان"
  },
  {
    "poem_id": 1748,
    "vorder": 34,
    "position": 1,
    "text": "بدو داد دیهیم و مهر شهان"
  },
  {
    "poem_id": 1748,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت پس شاه با اردشیر"
  },
  {
    "poem_id": 1748,
    "vorder": 36,
    "position": 1,
    "text": "که کار جهان بر دل آسان مگیر"
  },
  {
    "poem_id": 1748,
    "vorder": 37,
    "position": 0,
    "text": "بدان ای برادر که بیداد شاه"
  },
  {
    "poem_id": 1748,
    "vorder": 38,
    "position": 1,
    "text": "پی پادشاهی ندارد نگاه"
  },
  {
    "poem_id": 1748,
    "vorder": 39,
    "position": 0,
    "text": "به آگندن گنج شادان بود"
  },
  {
    "poem_id": 1748,
    "vorder": 40,
    "position": 1,
    "text": "به زفتی سر سرفرازان بود"
  },
  {
    "poem_id": 1748,
    "vorder": 41,
    "position": 0,
    "text": "خنک شاه باداد و یزدان پرست"
  },
  {
    "poem_id": 1748,
    "vorder": 42,
    "position": 1,
    "text": "کزو شاد باشد دل زیردست"
  },
  {
    "poem_id": 1748,
    "vorder": 43,
    "position": 0,
    "text": "به داد و به بخشش فزونی کند"
  },
  {
    "poem_id": 1748,
    "vorder": 44,
    "position": 1,
    "text": "جهان را بدین رهنمونی کند"
  },
  {
    "poem_id": 1748,
    "vorder": 45,
    "position": 0,
    "text": "نگه دارد از دشمنان کشورش"
  },
  {
    "poem_id": 1748,
    "vorder": 46,
    "position": 1,
    "text": "به ابر اندر آرد سر و افسرش"
  },
  {
    "poem_id": 1748,
    "vorder": 47,
    "position": 0,
    "text": "به داد و به آرام گنج آگند"
  },
  {
    "poem_id": 1748,
    "vorder": 48,
    "position": 1,
    "text": "به بخشش ز دل رنج بپراگند"
  },
  {
    "poem_id": 1748,
    "vorder": 49,
    "position": 0,
    "text": "گناه از گنهکار بگذاشتن"
  },
  {
    "poem_id": 1748,
    "vorder": 50,
    "position": 1,
    "text": "پی مردمی را نگه داشتن"
  },
  {
    "poem_id": 1748,
    "vorder": 51,
    "position": 0,
    "text": "هرانکس که او این هنرها بجست"
  },
  {
    "poem_id": 1748,
    "vorder": 52,
    "position": 1,
    "text": "خرد باید و حزم و رای درست"
  },
  {
    "poem_id": 1748,
    "vorder": 53,
    "position": 0,
    "text": "بباید خرد شاه را ناگزیر"
  },
  {
    "poem_id": 1748,
    "vorder": 54,
    "position": 1,
    "text": "هم آموزش مرد برنا و پیر"
  },
  {
    "poem_id": 1748,
    "vorder": 55,
    "position": 0,
    "text": "دل پادشا چون گراید به مهر"
  },
  {
    "poem_id": 1748,
    "vorder": 56,
    "position": 1,
    "text": "برو کامها تازه دارد سپهر"
  },
  {
    "poem_id": 1748,
    "vorder": 57,
    "position": 0,
    "text": "گنهکار باشد تن زیردست"
  },
  {
    "poem_id": 1748,
    "vorder": 58,
    "position": 1,
    "text": "مگر مردم پاک و یزدان پرست"
  },
  {
    "poem_id": 1748,
    "vorder": 59,
    "position": 0,
    "text": "دل و مغز مردم دو شاه تنند"
  },
  {
    "poem_id": 1748,
    "vorder": 60,
    "position": 1,
    "text": "دگر آلت تن سپاه تنند"
  },
  {
    "poem_id": 1748,
    "vorder": 61,
    "position": 0,
    "text": "چو مغز و دل مردم آلوده گشت"
  },
  {
    "poem_id": 1748,
    "vorder": 62,
    "position": 1,
    "text": "به نومیدی از رای پالوده گشت"
  },
  {
    "poem_id": 1748,
    "vorder": 63,
    "position": 0,
    "text": "بدان تن سراسیمه گردد روان"
  },
  {
    "poem_id": 1748,
    "vorder": 64,
    "position": 1,
    "text": "سپه چون زید شاه بی‌پهلوان"
  },
  {
    "poem_id": 1748,
    "vorder": 65,
    "position": 0,
    "text": "چو روشن نباشد بپراگند"
  },
  {
    "poem_id": 1748,
    "vorder": 66,
    "position": 1,
    "text": "تن بی‌روان را به خاک افگند"
  },
  {
    "poem_id": 1748,
    "vorder": 67,
    "position": 0,
    "text": "چنین همچو شد شاه بیدادگر"
  },
  {
    "poem_id": 1748,
    "vorder": 68,
    "position": 1,
    "text": "جهان زو شود زود زیر و زبر"
  },
  {
    "poem_id": 1748,
    "vorder": 69,
    "position": 0,
    "text": "بدوبر پس از مرگ نفرین بود"
  },
  {
    "poem_id": 1748,
    "vorder": 70,
    "position": 1,
    "text": "همان نام او شاه بی دین بود"
  },
  {
    "poem_id": 1748,
    "vorder": 71,
    "position": 0,
    "text": "بدین دار چشم و بدان دار گوش"
  },
  {
    "poem_id": 1748,
    "vorder": 72,
    "position": 1,
    "text": "که اویست دارنده جان و هوش"
  },
  {
    "poem_id": 1748,
    "vorder": 73,
    "position": 0,
    "text": "هران پادشا کو جزین راه جست"
  },
  {
    "poem_id": 1748,
    "vorder": 74,
    "position": 1,
    "text": "ز نیکیش باید دل و دست شست"
  },
  {
    "poem_id": 1748,
    "vorder": 75,
    "position": 0,
    "text": "ز کشورش بپراگند زیردست"
  },
  {
    "poem_id": 1748,
    "vorder": 76,
    "position": 1,
    "text": "همان از درش مرد خسروپرست"
  },
  {
    "poem_id": 1748,
    "vorder": 77,
    "position": 0,
    "text": "نبینی که دانا چه گوید همی"
  },
  {
    "poem_id": 1748,
    "vorder": 78,
    "position": 1,
    "text": "دلت را ز کژی بشوید همی"
  },
  {
    "poem_id": 1748,
    "vorder": 79,
    "position": 0,
    "text": "که هر شاه کو را ستایش بود"
  },
  {
    "poem_id": 1748,
    "vorder": 80,
    "position": 1,
    "text": "همه کارش اندر فزایش بود"
  },
  {
    "poem_id": 1748,
    "vorder": 81,
    "position": 0,
    "text": "نکوهیده باشد جفا پیشه مرد"
  },
  {
    "poem_id": 1748,
    "vorder": 82,
    "position": 1,
    "text": "به گرد در آزداران مگرد"
  },
  {
    "poem_id": 1748,
    "vorder": 83,
    "position": 0,
    "text": "بدان ای برادر که از شهریار"
  },
  {
    "poem_id": 1748,
    "vorder": 84,
    "position": 1,
    "text": "بجوید خردمند هرگونه کار"
  },
  {
    "poem_id": 1748,
    "vorder": 85,
    "position": 0,
    "text": "یکی آنک پیروزگر باشد اوی"
  },
  {
    "poem_id": 1748,
    "vorder": 86,
    "position": 1,
    "text": "ز دشمن نتابد گه جنگ روی"
  },
  {
    "poem_id": 1748,
    "vorder": 87,
    "position": 0,
    "text": "دگر آنک لشکر بدارد به داد"
  },
  {
    "poem_id": 1748,
    "vorder": 88,
    "position": 1,
    "text": "بداند فزونی مرد نژاد"
  },
  {
    "poem_id": 1748,
    "vorder": 89,
    "position": 0,
    "text": "کسی کز در پادشاهی بود"
  },
  {
    "poem_id": 1748,
    "vorder": 90,
    "position": 1,
    "text": "نخواهد که مهتر سپاهی بود"
  },
  {
    "poem_id": 1748,
    "vorder": 91,
    "position": 0,
    "text": "چهارم که با زیردستان خویش"
  },
  {
    "poem_id": 1748,
    "vorder": 92,
    "position": 1,
    "text": "همان باگهر در پرستان خویش"
  },
  {
    "poem_id": 1748,
    "vorder": 93,
    "position": 0,
    "text": "ندارد در گنج را بسته سخت"
  },
  {
    "poem_id": 1748,
    "vorder": 94,
    "position": 1,
    "text": "همی بارد از شاخ بار درخت"
  },
  {
    "poem_id": 1748,
    "vorder": 95,
    "position": 0,
    "text": "بباید در پادشاهی سپاه"
  },
  {
    "poem_id": 1748,
    "vorder": 96,
    "position": 1,
    "text": "سپاهی در گنج دارد نگاه"
  },
  {
    "poem_id": 1748,
    "vorder": 97,
    "position": 0,
    "text": "اگر گنجت آباد داری به داد"
  },
  {
    "poem_id": 1748,
    "vorder": 98,
    "position": 1,
    "text": "تو از گنج شاد و سپاه از تو شاد"
  },
  {
    "poem_id": 1748,
    "vorder": 99,
    "position": 0,
    "text": "سلیحت در آرایش خویش دار"
  },
  {
    "poem_id": 1748,
    "vorder": 100,
    "position": 1,
    "text": "سزد کت شب تیره آید به کار"
  },
  {
    "poem_id": 1748,
    "vorder": 101,
    "position": 0,
    "text": "بس ایمن مشو بر نگهدار خویش"
  },
  {
    "poem_id": 1748,
    "vorder": 102,
    "position": 1,
    "text": "چو ایمن شدی راست کن کار خویش"
  },
  {
    "poem_id": 1748,
    "vorder": 103,
    "position": 0,
    "text": "سرانجام مرگ آیدت بی‌گمان"
  },
  {
    "poem_id": 1748,
    "vorder": 104,
    "position": 1,
    "text": "اگر تیره‌ای گر چراغ جهان"
  },
  {
    "poem_id": 1748,
    "vorder": 105,
    "position": 0,
    "text": "برادر چو بشنید چندی گریست"
  },
  {
    "poem_id": 1748,
    "vorder": 106,
    "position": 1,
    "text": "چو اندرز بنوشت سالی بزیست"
  },
  {
    "poem_id": 1748,
    "vorder": 107,
    "position": 0,
    "text": "برفت و بماند این سخن یادگار"
  },
  {
    "poem_id": 1748,
    "vorder": 108,
    "position": 1,
    "text": "تو اندر جهان تخم زفتی مکار"
  },
  {
    "poem_id": 1748,
    "vorder": 109,
    "position": 0,
    "text": "که هم یک زمان روز تو بگذرد"
  },
  {
    "poem_id": 1748,
    "vorder": 110,
    "position": 1,
    "text": "چنین برده رنج تو دشمن خورد"
  },
  {
    "poem_id": 1748,
    "vorder": 111,
    "position": 0,
    "text": "چو آدینه هر مزد بهمن بود"
  },
  {
    "poem_id": 1748,
    "vorder": 112,
    "position": 1,
    "text": "برین کار فرخ نشیمن بود"
  },
  {
    "poem_id": 1748,
    "vorder": 113,
    "position": 0,
    "text": "می لعل پیش آور ای هاشمی"
  },
  {
    "poem_id": 1748,
    "vorder": 114,
    "position": 1,
    "text": "ز خمی که هرگز نگیرد کمی"
  },
  {
    "poem_id": 1748,
    "vorder": 115,
    "position": 0,
    "text": "چو شست و سه شد سال شد گوش کر"
  },
  {
    "poem_id": 1748,
    "vorder": 116,
    "position": 1,
    "text": "ز بیشی چرا جویم آیین و فر"
  },
  {
    "poem_id": 1748,
    "vorder": 117,
    "position": 0,
    "text": "کنون داستانهای شاه اردشیر"
  },
  {
    "poem_id": 1748,
    "vorder": 118,
    "position": 1,
    "text": "بگویم ز گفتار من یادگیر"
  }
]