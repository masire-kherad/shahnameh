[
  {
    "poem_id": 1545,
    "vorder": 1,
    "position": 0,
    "text": "چو ترکان بدیدند کارجاسپ رفت"
  },
  {
    "poem_id": 1545,
    "vorder": 2,
    "position": 1,
    "text": "همی آید از هر سوی تیغ تفت"
  },
  {
    "poem_id": 1545,
    "vorder": 3,
    "position": 0,
    "text": "همه سرکشانشان پیاده شدند"
  },
  {
    "poem_id": 1545,
    "vorder": 4,
    "position": 1,
    "text": "به پیش گو اسفندیار آمدند"
  },
  {
    "poem_id": 1545,
    "vorder": 5,
    "position": 0,
    "text": "کمانچای چاچی بینداختند"
  },
  {
    "poem_id": 1545,
    "vorder": 6,
    "position": 1,
    "text": "قبای نبردی برون آختند"
  },
  {
    "poem_id": 1545,
    "vorder": 7,
    "position": 0,
    "text": "به زاریش گفتند گر شهریار"
  },
  {
    "poem_id": 1545,
    "vorder": 8,
    "position": 1,
    "text": "دهد بندگان را به جان زینهار"
  },
  {
    "poem_id": 1545,
    "vorder": 9,
    "position": 0,
    "text": "بدین اندر آییم و خواهش کنیم"
  },
  {
    "poem_id": 1545,
    "vorder": 10,
    "position": 1,
    "text": "همه آذران را نیایش کنیم"
  },
  {
    "poem_id": 1545,
    "vorder": 11,
    "position": 0,
    "text": "ازیشان چو بشنید اسفندیار"
  },
  {
    "poem_id": 1545,
    "vorder": 12,
    "position": 1,
    "text": "به جان و به تن دادشان زینهار"
  },
  {
    "poem_id": 1545,
    "vorder": 13,
    "position": 0,
    "text": "بران لشگر گشن آواز داد"
  },
  {
    "poem_id": 1545,
    "vorder": 14,
    "position": 1,
    "text": "گو نامبردار فرخ‌نژاد"
  },
  {
    "poem_id": 1545,
    "vorder": 15,
    "position": 0,
    "text": "که این نامداران ایرانیان"
  },
  {
    "poem_id": 1545,
    "vorder": 16,
    "position": 1,
    "text": "بگردید زین لشکر چینیان"
  },
  {
    "poem_id": 1545,
    "vorder": 17,
    "position": 0,
    "text": "کنون کاین سپاه عدو گشت پست"
  },
  {
    "poem_id": 1545,
    "vorder": 18,
    "position": 1,
    "text": "ازین سهم و کشتن بدارید دست"
  },
  {
    "poem_id": 1545,
    "vorder": 19,
    "position": 0,
    "text": "که بس زاروارند و بیچاره‌وار"
  },
  {
    "poem_id": 1545,
    "vorder": 20,
    "position": 1,
    "text": "دهید این سگان را به جان زینهار"
  },
  {
    "poem_id": 1545,
    "vorder": 21,
    "position": 0,
    "text": "بدارید دست از گرفتن کنون"
  },
  {
    "poem_id": 1545,
    "vorder": 22,
    "position": 1,
    "text": "مبندید کس را مریزید خون"
  },
  {
    "poem_id": 1545,
    "vorder": 23,
    "position": 0,
    "text": "متازید و این کشتگان مسپرید"
  },
  {
    "poem_id": 1545,
    "vorder": 24,
    "position": 1,
    "text": "بگردید و این خستگان بشمرید"
  },
  {
    "poem_id": 1545,
    "vorder": 25,
    "position": 0,
    "text": "مگیریدشان بهر جان زریر"
  },
  {
    "poem_id": 1545,
    "vorder": 26,
    "position": 1,
    "text": "بر اسپان جنگی مپایید دیر"
  },
  {
    "poem_id": 1545,
    "vorder": 27,
    "position": 0,
    "text": "چو لشکر شنیدند آواز اوی"
  },
  {
    "poem_id": 1545,
    "vorder": 28,
    "position": 1,
    "text": "شدند از بر خستگان بارزوی"
  },
  {
    "poem_id": 1545,
    "vorder": 29,
    "position": 0,
    "text": "به لشکرگه خود فرود آمدند"
  },
  {
    "poem_id": 1545,
    "vorder": 30,
    "position": 1,
    "text": "به پیروز گشتن تبیره زدند"
  },
  {
    "poem_id": 1545,
    "vorder": 31,
    "position": 0,
    "text": "همه شب نخفتند زان خرمی"
  },
  {
    "poem_id": 1545,
    "vorder": 32,
    "position": 1,
    "text": "که پیروزی بودشان رستمی"
  },
  {
    "poem_id": 1545,
    "vorder": 33,
    "position": 0,
    "text": "چو اندر شکست آن شب تیره‌گون"
  },
  {
    "poem_id": 1545,
    "vorder": 34,
    "position": 1,
    "text": "به دشت و بیابان فرو خورد خون"
  },
  {
    "poem_id": 1545,
    "vorder": 35,
    "position": 0,
    "text": "کی نامور با سران سپاه"
  },
  {
    "poem_id": 1545,
    "vorder": 36,
    "position": 1,
    "text": "بیامد به دیدار آن رزمگاه"
  },
  {
    "poem_id": 1545,
    "vorder": 37,
    "position": 0,
    "text": "همی گرد آن کشتگان بر بگشت"
  },
  {
    "poem_id": 1545,
    "vorder": 38,
    "position": 1,
    "text": "کرا دید بگریست و اندر گذشت"
  },
  {
    "poem_id": 1545,
    "vorder": 39,
    "position": 0,
    "text": "برادرش را دید کشته به زار"
  },
  {
    "poem_id": 1545,
    "vorder": 40,
    "position": 1,
    "text": "به آوردگاهی برافگنده خوار"
  },
  {
    "poem_id": 1545,
    "vorder": 41,
    "position": 0,
    "text": "چو او را چنان زار و کشته بدید"
  },
  {
    "poem_id": 1545,
    "vorder": 42,
    "position": 1,
    "text": "همه جامهٔ خسروی بردرید"
  },
  {
    "poem_id": 1545,
    "vorder": 43,
    "position": 0,
    "text": "فرود آمد از شولک خوب رنگ"
  },
  {
    "poem_id": 1545,
    "vorder": 44,
    "position": 1,
    "text": "به ریش خود اندر زده هر دو چنگ"
  },
  {
    "poem_id": 1545,
    "vorder": 45,
    "position": 0,
    "text": "همی گفت کی شاه گردان بلخ"
  },
  {
    "poem_id": 1545,
    "vorder": 46,
    "position": 1,
    "text": "همه زندگانی ما کرده تلخ"
  },
  {
    "poem_id": 1545,
    "vorder": 47,
    "position": 0,
    "text": "دریغا سوارا شها خسروا"
  },
  {
    "poem_id": 1545,
    "vorder": 48,
    "position": 1,
    "text": "نبرده دلیرا گزیده گوا"
  },
  {
    "poem_id": 1545,
    "vorder": 49,
    "position": 0,
    "text": "ستون منا پردهٔ کشورا"
  },
  {
    "poem_id": 1545,
    "vorder": 50,
    "position": 1,
    "text": "چراغ جهان افسر لشکرا"
  },
  {
    "poem_id": 1545,
    "vorder": 51,
    "position": 0,
    "text": "فرود آمد و برگرفتش ز خاک"
  },
  {
    "poem_id": 1545,
    "vorder": 52,
    "position": 1,
    "text": "به دست خودش روی بسترد پاک"
  },
  {
    "poem_id": 1545,
    "vorder": 53,
    "position": 0,
    "text": "به تابوت زرینش اندر نهاد"
  },
  {
    "poem_id": 1545,
    "vorder": 54,
    "position": 1,
    "text": "تو گفتی زریر از بنه خود نزاد"
  },
  {
    "poem_id": 1545,
    "vorder": 55,
    "position": 0,
    "text": "کیان زادگان و جوانان خویش"
  },
  {
    "poem_id": 1545,
    "vorder": 56,
    "position": 1,
    "text": "به تابوتها در نهادند پیش"
  },
  {
    "poem_id": 1545,
    "vorder": 57,
    "position": 0,
    "text": "بفرمود تا کشتگان بشمرند"
  },
  {
    "poem_id": 1545,
    "vorder": 58,
    "position": 1,
    "text": "کسی را که خستست بیرون برند"
  },
  {
    "poem_id": 1545,
    "vorder": 59,
    "position": 0,
    "text": "بگردید بر گرد آن رزمگاه"
  },
  {
    "poem_id": 1545,
    "vorder": 60,
    "position": 1,
    "text": "به کوه و بیابان و بر دشت و راه"
  },
  {
    "poem_id": 1545,
    "vorder": 61,
    "position": 0,
    "text": "از ایرانیان کشته بد سی‌هزار"
  },
  {
    "poem_id": 1545,
    "vorder": 62,
    "position": 1,
    "text": "ازان هفتصد سرکش و نامدار"
  },
  {
    "poem_id": 1545,
    "vorder": 63,
    "position": 0,
    "text": "هزار و چل از نامور خسته بود"
  },
  {
    "poem_id": 1545,
    "vorder": 64,
    "position": 1,
    "text": "که از پای پیلان به در جسته بود"
  },
  {
    "poem_id": 1545,
    "vorder": 65,
    "position": 0,
    "text": "وزان دیگران کشته بد صد هزار"
  },
  {
    "poem_id": 1545,
    "vorder": 66,
    "position": 1,
    "text": "هزار و صد و شست و سه نامدار"
  },
  {
    "poem_id": 1545,
    "vorder": 67,
    "position": 0,
    "text": "ز خسته بدی سه هزار و دویست"
  },
  {
    "poem_id": 1545,
    "vorder": 68,
    "position": 1,
    "text": "برین جای بر تا توانی مه ایست"
  }
]