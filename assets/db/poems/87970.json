[
  {
    "poem_id": 87970,
    "vorder": 1,
    "position": 0,
    "text": "سه روزش درنگ آمد اندر چرم"
  },
  {
    "poem_id": 87970,
    "vorder": 2,
    "position": 1,
    "text": "چهارم برآمد ز شیپور دم"
  },
  {
    "poem_id": 87970,
    "vorder": 3,
    "position": 0,
    "text": "سپه برگرفت و بزد نای و کوس"
  },
  {
    "poem_id": 87970,
    "vorder": 4,
    "position": 1,
    "text": "زمین کوه تا کوه گشت آبنوس"
  },
  {
    "poem_id": 87970,
    "vorder": 5,
    "position": 0,
    "text": "هرآنکس که دیدی ز توران سپاه"
  },
  {
    "poem_id": 87970,
    "vorder": 6,
    "position": 1,
    "text": "بکشتی تنش را فگندی براه"
  },
  {
    "poem_id": 87970,
    "vorder": 7,
    "position": 0,
    "text": "همه مرزها کرد بی‌تار و پود"
  },
  {
    "poem_id": 87970,
    "vorder": 8,
    "position": 1,
    "text": "همی رفت پیروز تا کاسه‌رود"
  },
  {
    "poem_id": 87970,
    "vorder": 9,
    "position": 0,
    "text": "بدان مرز لشکر فرود آورید"
  },
  {
    "poem_id": 87970,
    "vorder": 10,
    "position": 1,
    "text": "زمین گشت زان خیمه‌ها ناپدید"
  },
  {
    "poem_id": 87970,
    "vorder": 11,
    "position": 0,
    "text": "خبر شد بترکان کز ایران سپاه"
  },
  {
    "poem_id": 87970,
    "vorder": 12,
    "position": 1,
    "text": "سوی کاسه رود اندر آمد براه"
  },
  {
    "poem_id": 87970,
    "vorder": 13,
    "position": 0,
    "text": "ز ترکان بیامد دلیری جوان"
  },
  {
    "poem_id": 87970,
    "vorder": 14,
    "position": 1,
    "text": "پلاشان بیداردل پهلوان"
  },
  {
    "poem_id": 87970,
    "vorder": 15,
    "position": 0,
    "text": "بیامد که لشکر همی بنگرد"
  },
  {
    "poem_id": 87970,
    "vorder": 16,
    "position": 1,
    "text": "درفش سران را همی بشمرد"
  },
  {
    "poem_id": 87970,
    "vorder": 17,
    "position": 0,
    "text": "بلشکرگه اندر یکی کوه بود"
  },
  {
    "poem_id": 87970,
    "vorder": 18,
    "position": 1,
    "text": "بلند و بیکسو ز انبوه بود"
  },
  {
    "poem_id": 87970,
    "vorder": 19,
    "position": 0,
    "text": "نشسته برو گیو و بیژن بهم"
  },
  {
    "poem_id": 87970,
    "vorder": 20,
    "position": 1,
    "text": "همی رفت هرگونه از بیش و کم"
  },
  {
    "poem_id": 87970,
    "vorder": 21,
    "position": 0,
    "text": "درفش پلاشان ز توران سپاه"
  },
  {
    "poem_id": 87970,
    "vorder": 22,
    "position": 1,
    "text": "بدیدار ایشان برآمد ز راه"
  },
  {
    "poem_id": 87970,
    "vorder": 23,
    "position": 0,
    "text": "چو از دور گیو دلاور بدید"
  },
  {
    "poem_id": 87970,
    "vorder": 24,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 87970,
    "vorder": 25,
    "position": 0,
    "text": "چنین گفت کامد پلاشان شیر"
  },
  {
    "poem_id": 87970,
    "vorder": 26,
    "position": 1,
    "text": "یکی نامداری سواری دلیر"
  },
  {
    "poem_id": 87970,
    "vorder": 27,
    "position": 0,
    "text": "شوم گر سرش را ببرم ز تن"
  },
  {
    "poem_id": 87970,
    "vorder": 28,
    "position": 1,
    "text": "گرش بسته آرم بدین انجمن"
  },
  {
    "poem_id": 87970,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت بیژن که گر شهریار"
  },
  {
    "poem_id": 87970,
    "vorder": 30,
    "position": 1,
    "text": "مرا داد خلعت بدین کارزار"
  },
  {
    "poem_id": 87970,
    "vorder": 31,
    "position": 0,
    "text": "بفرمان مرا بست باید کمر"
  },
  {
    "poem_id": 87970,
    "vorder": 32,
    "position": 1,
    "text": "برزم پلاشان پرخاشخر"
  },
  {
    "poem_id": 87970,
    "vorder": 33,
    "position": 0,
    "text": "به بیژن چنین گفت گیو دلیر"
  },
  {
    "poem_id": 87970,
    "vorder": 34,
    "position": 1,
    "text": "که مشتاب در چنگ این نره شیر"
  },
  {
    "poem_id": 87970,
    "vorder": 35,
    "position": 0,
    "text": "نباید که با او نتابی بجنگ"
  },
  {
    "poem_id": 87970,
    "vorder": 36,
    "position": 1,
    "text": "کنی روز بر من برین جنگ تنگ"
  },
  {
    "poem_id": 87970,
    "vorder": 37,
    "position": 0,
    "text": "پلاشان چو شیر است در مرغزار"
  },
  {
    "poem_id": 87970,
    "vorder": 38,
    "position": 1,
    "text": "جز از مرد جنگی نجوید شکار"
  },
  {
    "poem_id": 87970,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت بیژن مرا زین سخن"
  },
  {
    "poem_id": 87970,
    "vorder": 40,
    "position": 1,
    "text": "به پیش جهاندار ننگی مکن"
  },
  {
    "poem_id": 87970,
    "vorder": 41,
    "position": 0,
    "text": "سلیح سیاوش مرا ده بجنگ"
  },
  {
    "poem_id": 87970,
    "vorder": 42,
    "position": 1,
    "text": "پس آنگه نگه کن شکار پلنگ"
  },
  {
    "poem_id": 87970,
    "vorder": 43,
    "position": 0,
    "text": "بدو داد گیو دلیر آن زره"
  },
  {
    "poem_id": 87970,
    "vorder": 44,
    "position": 1,
    "text": "همی بست بیژن زره را گره"
  },
  {
    "poem_id": 87970,
    "vorder": 45,
    "position": 0,
    "text": "یکی بارهٔ تیزرو برنشست"
  },
  {
    "poem_id": 87970,
    "vorder": 46,
    "position": 1,
    "text": "بهامون خرامید نیزه بدست"
  },
  {
    "poem_id": 87970,
    "vorder": 47,
    "position": 0,
    "text": "پلاشان یکی آهو افگنده بود"
  },
  {
    "poem_id": 87970,
    "vorder": 48,
    "position": 1,
    "text": "کبابش بر آتش پراگنده بود"
  },
  {
    "poem_id": 87970,
    "vorder": 49,
    "position": 0,
    "text": "همی خورد و اسپش چران و چمان"
  },
  {
    "poem_id": 87970,
    "vorder": 50,
    "position": 1,
    "text": "پلاشان نشسته به بازو کمان"
  },
  {
    "poem_id": 87970,
    "vorder": 51,
    "position": 0,
    "text": "چو اسپش ز دور اسپ بیژن بدید"
  },
  {
    "poem_id": 87970,
    "vorder": 52,
    "position": 1,
    "text": "خروشی برآورد و اندر دمید"
  },
  {
    "poem_id": 87970,
    "vorder": 53,
    "position": 0,
    "text": "پلاشان بدانست کامد سوار"
  },
  {
    "poem_id": 87970,
    "vorder": 54,
    "position": 1,
    "text": "بیامد بسیچیدهٔ کارزار"
  },
  {
    "poem_id": 87970,
    "vorder": 55,
    "position": 0,
    "text": "یکی بانگ برزد به بیژن بلند"
  },
  {
    "poem_id": 87970,
    "vorder": 56,
    "position": 1,
    "text": "منم گفت شیراوژن و و دیوبند"
  },
  {
    "poem_id": 87970,
    "vorder": 57,
    "position": 0,
    "text": "بگو آشکارا که نام تو چیست"
  },
  {
    "poem_id": 87970,
    "vorder": 58,
    "position": 1,
    "text": "که اختر همی بر تو خواهد گریست"
  },
  {
    "poem_id": 87970,
    "vorder": 59,
    "position": 0,
    "text": "دلاور بدو گفت من بیژنم"
  },
  {
    "poem_id": 87970,
    "vorder": 60,
    "position": 1,
    "text": "برزم اندرون پیل و رویین‌تنم"
  },
  {
    "poem_id": 87970,
    "vorder": 61,
    "position": 0,
    "text": "نیا شیر جنگی پدر گیو گرد"
  },
  {
    "poem_id": 87970,
    "vorder": 62,
    "position": 1,
    "text": "هم اکنون ببینی ز من دستبرد"
  },
  {
    "poem_id": 87970,
    "vorder": 63,
    "position": 0,
    "text": "بروز بلا در دم کارزار"
  },
  {
    "poem_id": 87970,
    "vorder": 64,
    "position": 1,
    "text": "تو بر کوه چون گرگ مردار خواه"
  },
  {
    "poem_id": 87970,
    "vorder": 65,
    "position": 0,
    "text": "همی دود و خاکستر و خون خوری"
  },
  {
    "poem_id": 87970,
    "vorder": 66,
    "position": 1,
    "text": "گه آمد که لشکر بهامون بری"
  },
  {
    "poem_id": 87970,
    "vorder": 67,
    "position": 0,
    "text": "پلاشان بپاسخ نکرد ایچ یاد"
  },
  {
    "poem_id": 87970,
    "vorder": 68,
    "position": 1,
    "text": "برانگیخت آن پیل‌تن را چو باد"
  },
  {
    "poem_id": 87970,
    "vorder": 69,
    "position": 0,
    "text": "سواران بنیزه برآویختند"
  },
  {
    "poem_id": 87970,
    "vorder": 70,
    "position": 1,
    "text": "یکی گرد تیره برانگیختند"
  },
  {
    "poem_id": 87970,
    "vorder": 71,
    "position": 0,
    "text": "سنانهای نیزه بهم برشکست"
  },
  {
    "poem_id": 87970,
    "vorder": 72,
    "position": 1,
    "text": "یلان سوی شمشیر بردند دست"
  },
  {
    "poem_id": 87970,
    "vorder": 73,
    "position": 0,
    "text": "بزخم اندرون تیغ شد لخت لخت"
  },
  {
    "poem_id": 87970,
    "vorder": 74,
    "position": 1,
    "text": "ببودند لرزان چو شاخ درخت"
  },
  {
    "poem_id": 87970,
    "vorder": 75,
    "position": 0,
    "text": "بآب اندرون غرقه شد بارگی"
  },
  {
    "poem_id": 87970,
    "vorder": 76,
    "position": 1,
    "text": "سرانشان غمی گشت یکبارگی"
  },
  {
    "poem_id": 87970,
    "vorder": 77,
    "position": 0,
    "text": "عمود گران برکشیدند باز"
  },
  {
    "poem_id": 87970,
    "vorder": 78,
    "position": 1,
    "text": "دو شیر سرافراز و دو رزمساز"
  },
  {
    "poem_id": 87970,
    "vorder": 79,
    "position": 0,
    "text": "چنین تا برآورد بیژن خروش"
  },
  {
    "poem_id": 87970,
    "vorder": 80,
    "position": 1,
    "text": "عمودگران برنهاده بدوش"
  },
  {
    "poem_id": 87970,
    "vorder": 81,
    "position": 0,
    "text": "بزد بر میان پلاشان گرد"
  },
  {
    "poem_id": 87970,
    "vorder": 82,
    "position": 1,
    "text": "همه مهرهٔ پشت بشکست خرد"
  },
  {
    "poem_id": 87970,
    "vorder": 83,
    "position": 0,
    "text": "ز بالای اسپ اندر آمد تنش"
  },
  {
    "poem_id": 87970,
    "vorder": 84,
    "position": 1,
    "text": "نگون شد بر و مغفر و جوشنش"
  },
  {
    "poem_id": 87970,
    "vorder": 85,
    "position": 0,
    "text": "فرود آمد از باره بیژن چو گرد"
  },
  {
    "poem_id": 87970,
    "vorder": 86,
    "position": 1,
    "text": "سر مرد جنگی ز تن دور کرد"
  },
  {
    "poem_id": 87970,
    "vorder": 87,
    "position": 0,
    "text": "سلیح و سر و اسپ آن نامجوی"
  },
  {
    "poem_id": 87970,
    "vorder": 88,
    "position": 1,
    "text": "بیاورد و سوی پدر کرد روی"
  },
  {
    "poem_id": 87970,
    "vorder": 89,
    "position": 0,
    "text": "دل گیو بد زان سخن پر ز درد"
  },
  {
    "poem_id": 87970,
    "vorder": 90,
    "position": 1,
    "text": "که چون گردد آن باد روز نبرد"
  },
  {
    "poem_id": 87970,
    "vorder": 91,
    "position": 0,
    "text": "خروشان و جوشان بدان دیده‌گاه"
  },
  {
    "poem_id": 87970,
    "vorder": 92,
    "position": 1,
    "text": "که تا گرد بیژن کی آید ز راه"
  },
  {
    "poem_id": 87970,
    "vorder": 93,
    "position": 0,
    "text": "همی آمد از راه پور جوان"
  },
  {
    "poem_id": 87970,
    "vorder": 94,
    "position": 1,
    "text": "سر و جوشن و اسپ آن پهلوان"
  },
  {
    "poem_id": 87970,
    "vorder": 95,
    "position": 0,
    "text": "بیاورد و بنهاد پیش پدر"
  },
  {
    "poem_id": 87970,
    "vorder": 96,
    "position": 1,
    "text": "بدو گفت پیروز باش ای پسر"
  },
  {
    "poem_id": 87970,
    "vorder": 97,
    "position": 0,
    "text": "برفتند با شادمانی ز جای"
  },
  {
    "poem_id": 87970,
    "vorder": 98,
    "position": 1,
    "text": "نهادند سر سوی پرده‌سرای"
  },
  {
    "poem_id": 87970,
    "vorder": 99,
    "position": 0,
    "text": "بیاورد پیش سپهبد سرش"
  },
  {
    "poem_id": 87970,
    "vorder": 100,
    "position": 1,
    "text": "همان اسپ با جوشن و مغفرش"
  },
  {
    "poem_id": 87970,
    "vorder": 101,
    "position": 0,
    "text": "چنان شاد شد زان سخن پهلوان"
  },
  {
    "poem_id": 87970,
    "vorder": 102,
    "position": 1,
    "text": "که گفتی برافشاند خواهد روان"
  },
  {
    "poem_id": 87970,
    "vorder": 103,
    "position": 0,
    "text": "بدو گفت کای پور پشت سپاه"
  },
  {
    "poem_id": 87970,
    "vorder": 104,
    "position": 1,
    "text": "سر نامداران و دیهیم شاه"
  },
  {
    "poem_id": 87970,
    "vorder": 105,
    "position": 0,
    "text": "همیشه بزی شاد و برترمنش"
  },
  {
    "poem_id": 87970,
    "vorder": 106,
    "position": 1,
    "text": "ز تو دور بادا بد بدکنش"
  }
]