[
  {
    "poem_id": 1814,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس به هرسو یکی نامه کرد"
  },
  {
    "poem_id": 1814,
    "vorder": 2,
    "position": 1,
    "text": "به جایی که درویش بد جامه کرد"
  },
  {
    "poem_id": 1814,
    "vorder": 3,
    "position": 0,
    "text": "بپرسید هرجا که بی‌رنج کیست"
  },
  {
    "poem_id": 1814,
    "vorder": 4,
    "position": 1,
    "text": "به هرجای درویش و بی‌گنج کیست"
  },
  {
    "poem_id": 1814,
    "vorder": 5,
    "position": 0,
    "text": "ز کار جهان یکسر آگه کنید"
  },
  {
    "poem_id": 1814,
    "vorder": 6,
    "position": 1,
    "text": "دلم را سوی روشنی ره کنید"
  },
  {
    "poem_id": 1814,
    "vorder": 7,
    "position": 0,
    "text": "بیامدش پاسخ ز هر کشوری"
  },
  {
    "poem_id": 1814,
    "vorder": 8,
    "position": 1,
    "text": "ز هر نامداری و هر مهتری"
  },
  {
    "poem_id": 1814,
    "vorder": 9,
    "position": 0,
    "text": "که آباد بینیم روی زمین"
  },
  {
    "poem_id": 1814,
    "vorder": 10,
    "position": 1,
    "text": "به هرجای پیوسته شد آفرین"
  },
  {
    "poem_id": 1814,
    "vorder": 11,
    "position": 0,
    "text": "مگر مرد درویش کز شهریار"
  },
  {
    "poem_id": 1814,
    "vorder": 12,
    "position": 1,
    "text": "بنالد همی از بد روزگار"
  },
  {
    "poem_id": 1814,
    "vorder": 13,
    "position": 0,
    "text": "که چون می گسارد توانگر همی"
  },
  {
    "poem_id": 1814,
    "vorder": 14,
    "position": 1,
    "text": "به سر بر ز گل دارد افسر همی"
  },
  {
    "poem_id": 1814,
    "vorder": 15,
    "position": 0,
    "text": "به آواز رامشگران می خورند"
  },
  {
    "poem_id": 1814,
    "vorder": 16,
    "position": 1,
    "text": "چو ما مردمان را به کس نشمرند"
  },
  {
    "poem_id": 1814,
    "vorder": 17,
    "position": 0,
    "text": "تهی دست بی‌رود و گل می خورد"
  },
  {
    "poem_id": 1814,
    "vorder": 18,
    "position": 1,
    "text": "توانگر همانا ندارد خرد"
  },
  {
    "poem_id": 1814,
    "vorder": 19,
    "position": 0,
    "text": "بخندید زان نامه بیدار شاه"
  },
  {
    "poem_id": 1814,
    "vorder": 20,
    "position": 1,
    "text": "هیونی برافگند پویان به راه"
  },
  {
    "poem_id": 1814,
    "vorder": 21,
    "position": 0,
    "text": "به نزدیک شنگل فرستاد کس"
  },
  {
    "poem_id": 1814,
    "vorder": 22,
    "position": 1,
    "text": "چنین گفت کای شاه فریادرس"
  },
  {
    "poem_id": 1814,
    "vorder": 23,
    "position": 0,
    "text": "ازان لوریان برگزین ده هزار"
  },
  {
    "poem_id": 1814,
    "vorder": 24,
    "position": 1,
    "text": "نر و ماده بر زخم بربط سوار"
  },
  {
    "poem_id": 1814,
    "vorder": 25,
    "position": 0,
    "text": "به ایران فرستش که رامشگری"
  },
  {
    "poem_id": 1814,
    "vorder": 26,
    "position": 1,
    "text": "کند پیش هر کهتری بهتری"
  },
  {
    "poem_id": 1814,
    "vorder": 27,
    "position": 0,
    "text": "چو برخواند آن نامه شنگل تمام"
  },
  {
    "poem_id": 1814,
    "vorder": 28,
    "position": 1,
    "text": "گزین کرد زان لوریان به نام"
  },
  {
    "poem_id": 1814,
    "vorder": 29,
    "position": 0,
    "text": "به ایران فرستاد نزدیک شاه"
  },
  {
    "poem_id": 1814,
    "vorder": 30,
    "position": 1,
    "text": "چنان کان بود در خور نیک‌خواه"
  },
  {
    "poem_id": 1814,
    "vorder": 31,
    "position": 0,
    "text": "چو لوری بیامد به درگاه شاه"
  },
  {
    "poem_id": 1814,
    "vorder": 32,
    "position": 1,
    "text": "بفرمود تا برگشادند راه"
  },
  {
    "poem_id": 1814,
    "vorder": 33,
    "position": 0,
    "text": "به هریک یکی گاو داد و خری"
  },
  {
    "poem_id": 1814,
    "vorder": 34,
    "position": 1,
    "text": "ز لوری همی ساخت برزیگری"
  },
  {
    "poem_id": 1814,
    "vorder": 35,
    "position": 0,
    "text": "همان نیز خروار گندم هزار"
  },
  {
    "poem_id": 1814,
    "vorder": 36,
    "position": 1,
    "text": "بدیشان سپرد آنک بد پایدار"
  },
  {
    "poem_id": 1814,
    "vorder": 37,
    "position": 0,
    "text": "بدان تا بورزد به گاو و به خر"
  },
  {
    "poem_id": 1814,
    "vorder": 38,
    "position": 1,
    "text": "ز گندم کند تخم و آرد به بر"
  },
  {
    "poem_id": 1814,
    "vorder": 39,
    "position": 0,
    "text": "کند پیش درویش رامشگری"
  },
  {
    "poem_id": 1814,
    "vorder": 40,
    "position": 1,
    "text": "چو آزادگان را کند کهتری"
  },
  {
    "poem_id": 1814,
    "vorder": 41,
    "position": 0,
    "text": "بشد لوری و گاو و گندم بخورد"
  },
  {
    "poem_id": 1814,
    "vorder": 42,
    "position": 1,
    "text": "بیامد سر سال رخساره زرد"
  },
  {
    "poem_id": 1814,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت شاه این نه کار تو بود"
  },
  {
    "poem_id": 1814,
    "vorder": 44,
    "position": 1,
    "text": "پراگندن تخم و کشت و درود"
  },
  {
    "poem_id": 1814,
    "vorder": 45,
    "position": 0,
    "text": "خری ماند اکنون بنه برنهید"
  },
  {
    "poem_id": 1814,
    "vorder": 46,
    "position": 1,
    "text": "بسازید رود و بریشم دهید"
  },
  {
    "poem_id": 1814,
    "vorder": 47,
    "position": 0,
    "text": "کنون لوری از پاک گفتار اوی"
  },
  {
    "poem_id": 1814,
    "vorder": 48,
    "position": 1,
    "text": "همی گردد اندر جهان چاره‌جوی"
  },
  {
    "poem_id": 1814,
    "vorder": 49,
    "position": 0,
    "text": "سگ و کبک بفزود بر گفت شاه"
  },
  {
    "poem_id": 1814,
    "vorder": 50,
    "position": 1,
    "text": "شب و روز پویان به دزدی به راه"
  }
]