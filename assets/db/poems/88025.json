[
  {
    "poem_id": 88025,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد به پیروز شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 2,
    "position": 1,
    "text": "که آمد ز توران به ایران سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 3,
    "position": 0,
    "text": "جفاپیشه بدگوهر افراسیاب"
  },
  {
    "poem_id": 88025,
    "vorder": 4,
    "position": 1,
    "text": "ز کینه نیابد شب و روز خواب"
  },
  {
    "poem_id": 88025,
    "vorder": 5,
    "position": 0,
    "text": "برآورد خواهد همی سر ز ننگ"
  },
  {
    "poem_id": 88025,
    "vorder": 6,
    "position": 1,
    "text": "ز هر سو فرستاد لشکر بجنگ"
  },
  {
    "poem_id": 88025,
    "vorder": 7,
    "position": 0,
    "text": "همی زهر ساید به نوک سنان"
  },
  {
    "poem_id": 88025,
    "vorder": 8,
    "position": 1,
    "text": "که تابد مگر سوی ایران عنان"
  },
  {
    "poem_id": 88025,
    "vorder": 9,
    "position": 0,
    "text": "سواران جنگی چو سیصد هزار"
  },
  {
    "poem_id": 88025,
    "vorder": 10,
    "position": 1,
    "text": "به جیحون همی کرد خواهد گذار"
  },
  {
    "poem_id": 88025,
    "vorder": 11,
    "position": 0,
    "text": "سپاهی که هنگام ننگ و نبرد"
  },
  {
    "poem_id": 88025,
    "vorder": 12,
    "position": 1,
    "text": "ز جیحون به گردون برآورد گرد"
  },
  {
    "poem_id": 88025,
    "vorder": 13,
    "position": 0,
    "text": "دلیران به درگاه افراسیاب"
  },
  {
    "poem_id": 88025,
    "vorder": 14,
    "position": 1,
    "text": "ز بانگ تبیره نیابند خواب"
  },
  {
    "poem_id": 88025,
    "vorder": 15,
    "position": 0,
    "text": "ز آوای شیپور و زخم درای"
  },
  {
    "poem_id": 88025,
    "vorder": 16,
    "position": 1,
    "text": "تو گویی برآید همی دل ز جای"
  },
  {
    "poem_id": 88025,
    "vorder": 17,
    "position": 0,
    "text": "گر آید به ایران به جنگ آن سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 18,
    "position": 1,
    "text": "هژبر دلاور نیاید به راه"
  },
  {
    "poem_id": 88025,
    "vorder": 19,
    "position": 0,
    "text": "سر مرز توران به پیران سپرد"
  },
  {
    "poem_id": 88025,
    "vorder": 20,
    "position": 1,
    "text": "سپاهی فرستاد با او نه خرد"
  },
  {
    "poem_id": 88025,
    "vorder": 21,
    "position": 0,
    "text": "سوی مرز خوارزم پنجه هزار"
  },
  {
    "poem_id": 88025,
    "vorder": 22,
    "position": 1,
    "text": "کمربسته رفت از در کارزار"
  },
  {
    "poem_id": 88025,
    "vorder": 23,
    "position": 0,
    "text": "سپهدارشان شیدهٔ شیر دل"
  },
  {
    "poem_id": 88025,
    "vorder": 24,
    "position": 1,
    "text": "کز آتش ستاند به شمشیر دل"
  },
  {
    "poem_id": 88025,
    "vorder": 25,
    "position": 0,
    "text": "سپاهی به کردار پیلان مست"
  },
  {
    "poem_id": 88025,
    "vorder": 26,
    "position": 1,
    "text": "که با جنگ ایشان شود کوه پست"
  },
  {
    "poem_id": 88025,
    "vorder": 27,
    "position": 0,
    "text": "چو بشنید گفتار کاراگهان"
  },
  {
    "poem_id": 88025,
    "vorder": 28,
    "position": 1,
    "text": "پراندیشه بنشست شاه جهان"
  },
  {
    "poem_id": 88025,
    "vorder": 29,
    "position": 0,
    "text": "به کاراگهان گفت کای بخردان"
  },
  {
    "poem_id": 88025,
    "vorder": 30,
    "position": 1,
    "text": "من ایدون شنیدستم از موبدان"
  },
  {
    "poem_id": 88025,
    "vorder": 31,
    "position": 0,
    "text": "که چون ماه ترکان برآید بلند"
  },
  {
    "poem_id": 88025,
    "vorder": 32,
    "position": 1,
    "text": "ز خورشید ایرانش آید گزند"
  },
  {
    "poem_id": 88025,
    "vorder": 33,
    "position": 0,
    "text": "سیه مار کو را سر آید بکوب"
  },
  {
    "poem_id": 88025,
    "vorder": 34,
    "position": 1,
    "text": "ز سوراخ پیچان شود سوی چوب"
  },
  {
    "poem_id": 88025,
    "vorder": 35,
    "position": 0,
    "text": "چو خسرو به بیداد کارد درخت"
  },
  {
    "poem_id": 88025,
    "vorder": 36,
    "position": 1,
    "text": "بگردد بر او پادشاهی و تخت"
  },
  {
    "poem_id": 88025,
    "vorder": 37,
    "position": 0,
    "text": "همه موبدان را بر خویش خواند"
  },
  {
    "poem_id": 88025,
    "vorder": 38,
    "position": 1,
    "text": "شنیده سخن پیش ایشان براند"
  },
  {
    "poem_id": 88025,
    "vorder": 39,
    "position": 0,
    "text": "نشستند با شاه ایران به راز"
  },
  {
    "poem_id": 88025,
    "vorder": 40,
    "position": 1,
    "text": "بزرگان فرزانه و رزم ساز"
  },
  {
    "poem_id": 88025,
    "vorder": 41,
    "position": 0,
    "text": "چو دستان سام و چو گودرز و گیو"
  },
  {
    "poem_id": 88025,
    "vorder": 42,
    "position": 1,
    "text": "چو شیدوش و فرهاد و رهام نیو"
  },
  {
    "poem_id": 88025,
    "vorder": 43,
    "position": 0,
    "text": "چو طوس و چو رستم یل پهلوان"
  },
  {
    "poem_id": 88025,
    "vorder": 44,
    "position": 1,
    "text": "فریبرز و شاپور شیر دمان"
  },
  {
    "poem_id": 88025,
    "vorder": 45,
    "position": 0,
    "text": "دگر بیژن گیو با گستهم"
  },
  {
    "poem_id": 88025,
    "vorder": 46,
    "position": 1,
    "text": "چو گرگین و چون زنگه و گژدهم"
  },
  {
    "poem_id": 88025,
    "vorder": 47,
    "position": 0,
    "text": "جز این نامداران لشکر همه"
  },
  {
    "poem_id": 88025,
    "vorder": 48,
    "position": 1,
    "text": "که بودند شاه جهان را رمه"
  },
  {
    "poem_id": 88025,
    "vorder": 49,
    "position": 0,
    "text": "ابا پهلوانان چنین گفت شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 50,
    "position": 1,
    "text": "که ترکان همی رزم جویند و گاه"
  },
  {
    "poem_id": 88025,
    "vorder": 51,
    "position": 0,
    "text": "چو دشمن سپه کرد و شد تیز چنگ"
  },
  {
    "poem_id": 88025,
    "vorder": 52,
    "position": 1,
    "text": "بباید بسیچید ما را به جنگ"
  },
  {
    "poem_id": 88025,
    "vorder": 53,
    "position": 0,
    "text": "بفرمود تا بوق با گاودم"
  },
  {
    "poem_id": 88025,
    "vorder": 54,
    "position": 1,
    "text": "دمیدند و بستند رویینه خم"
  },
  {
    "poem_id": 88025,
    "vorder": 55,
    "position": 0,
    "text": "از ایوان به میدان خرامید شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 56,
    "position": 1,
    "text": "بیاراستند از بر پیل گاه"
  },
  {
    "poem_id": 88025,
    "vorder": 57,
    "position": 0,
    "text": "بزد مهره در جام بر پشت پیل"
  },
  {
    "poem_id": 88025,
    "vorder": 58,
    "position": 1,
    "text": "زمین را تو گفتی براندود نیل"
  },
  {
    "poem_id": 88025,
    "vorder": 59,
    "position": 0,
    "text": "هوا نیلگون شد زمین رنگ رنگ"
  },
  {
    "poem_id": 88025,
    "vorder": 60,
    "position": 1,
    "text": "دلیران لشکر به سان پلنگ"
  },
  {
    "poem_id": 88025,
    "vorder": 61,
    "position": 0,
    "text": "به چنگ اندرون گرز و دل پر ز کین"
  },
  {
    "poem_id": 88025,
    "vorder": 62,
    "position": 1,
    "text": "ز گردان چو دریای جوشان زمین"
  },
  {
    "poem_id": 88025,
    "vorder": 63,
    "position": 0,
    "text": "خروشی برآمد ز درگاه شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 64,
    "position": 1,
    "text": "که ای پهلوانان ایران سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 65,
    "position": 0,
    "text": "کسی کو بساید عنان و رکیب"
  },
  {
    "poem_id": 88025,
    "vorder": 66,
    "position": 1,
    "text": "نباید که یابد به خانه شکیب"
  },
  {
    "poem_id": 88025,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود کز روم وز هندوان"
  },
  {
    "poem_id": 88025,
    "vorder": 68,
    "position": 1,
    "text": "سواران جنگی گزیده گوان"
  },
  {
    "poem_id": 88025,
    "vorder": 69,
    "position": 0,
    "text": "دلیران گردنکش از تازیان"
  },
  {
    "poem_id": 88025,
    "vorder": 70,
    "position": 1,
    "text": "بسیچیدهٔ جنگ شیر ژیان"
  },
  {
    "poem_id": 88025,
    "vorder": 71,
    "position": 0,
    "text": "کمربسته خواهند سیصد هزار"
  },
  {
    "poem_id": 88025,
    "vorder": 72,
    "position": 1,
    "text": "ز دشت سواران نیزه گزار"
  },
  {
    "poem_id": 88025,
    "vorder": 73,
    "position": 0,
    "text": "هر آن کو چهل روزه را نزد شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 74,
    "position": 1,
    "text": "نیاید نبیند به سر بر کلاه"
  },
  {
    "poem_id": 88025,
    "vorder": 75,
    "position": 0,
    "text": "پراگنده بر گرد کشور سوار"
  },
  {
    "poem_id": 88025,
    "vorder": 76,
    "position": 1,
    "text": "فرستاده با نامه شهریار"
  },
  {
    "poem_id": 88025,
    "vorder": 77,
    "position": 0,
    "text": "دو هفته برآمد به فرمان شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 78,
    "position": 1,
    "text": "بجنبید در پادشاهی سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 79,
    "position": 0,
    "text": "ز لشکر همه کشور آمد به جوش"
  },
  {
    "poem_id": 88025,
    "vorder": 80,
    "position": 1,
    "text": "ز گیتی بر آمد سراسر خروش"
  },
  {
    "poem_id": 88025,
    "vorder": 81,
    "position": 0,
    "text": "به شبگیر ، گاه خروش خروس"
  },
  {
    "poem_id": 88025,
    "vorder": 82,
    "position": 1,
    "text": "ز هر سوی برخاست آوای کوس"
  },
  {
    "poem_id": 88025,
    "vorder": 83,
    "position": 0,
    "text": "بزرگان هر کشوری با سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 84,
    "position": 1,
    "text": "نهادند سر سوی درگاه شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 85,
    "position": 0,
    "text": "در گنجهای کهن باز کرد"
  },
  {
    "poem_id": 88025,
    "vorder": 86,
    "position": 1,
    "text": "سپه را درم دادن آغاز کرد"
  },
  {
    "poem_id": 88025,
    "vorder": 87,
    "position": 0,
    "text": "همه لشکر از گنج و دینار شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 88,
    "position": 1,
    "text": "به سر بر نهادند گوهر کلاه"
  },
  {
    "poem_id": 88025,
    "vorder": 89,
    "position": 0,
    "text": "به برگستوان و به جوشن چو کوه"
  },
  {
    "poem_id": 88025,
    "vorder": 90,
    "position": 1,
    "text": "شدند انجمن لشکری همگروه"
  },
  {
    "poem_id": 88025,
    "vorder": 91,
    "position": 0,
    "text": "چو شد کار لشکر همه ساخته"
  },
  {
    "poem_id": 88025,
    "vorder": 92,
    "position": 1,
    "text": "وز ایشان دل شاه پرداخته"
  },
  {
    "poem_id": 88025,
    "vorder": 93,
    "position": 0,
    "text": "نخستین از آن لشکر نامدار"
  },
  {
    "poem_id": 88025,
    "vorder": 94,
    "position": 1,
    "text": "سواران شمشیر زن سی هزار"
  },
  {
    "poem_id": 88025,
    "vorder": 95,
    "position": 0,
    "text": "گزین کرد خسرو به رستم سپرد"
  },
  {
    "poem_id": 88025,
    "vorder": 96,
    "position": 1,
    "text": "بدو گفت کای نامبردار گرد"
  },
  {
    "poem_id": 88025,
    "vorder": 97,
    "position": 0,
    "text": "ره سیستان گیر و برکش پگاه"
  },
  {
    "poem_id": 88025,
    "vorder": 98,
    "position": 1,
    "text": "به هندوستان اندر آور سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 99,
    "position": 0,
    "text": "ز غزنین برو تا به راه برین"
  },
  {
    "poem_id": 88025,
    "vorder": 100,
    "position": 1,
    "text": "چو گردد ترا تاج و تخت و نگین"
  },
  {
    "poem_id": 88025,
    "vorder": 101,
    "position": 0,
    "text": "چو آن پادشاهی شود یکسره"
  },
  {
    "poem_id": 88025,
    "vorder": 102,
    "position": 1,
    "text": "به آبشخور آید پلنگ و بره"
  },
  {
    "poem_id": 88025,
    "vorder": 103,
    "position": 0,
    "text": "فرامرز را ده کلاه و نگین"
  },
  {
    "poem_id": 88025,
    "vorder": 104,
    "position": 1,
    "text": "کسی کو بخواهد ز لشکر گزین"
  },
  {
    "poem_id": 88025,
    "vorder": 105,
    "position": 0,
    "text": "بزن کوس رویین و شیپور و نای"
  },
  {
    "poem_id": 88025,
    "vorder": 106,
    "position": 1,
    "text": "به کشمیر و کابل فزون زین مپای"
  },
  {
    "poem_id": 88025,
    "vorder": 107,
    "position": 0,
    "text": "که ما را سر از جنگ افراسیاب"
  },
  {
    "poem_id": 88025,
    "vorder": 108,
    "position": 1,
    "text": "نیابد همی خورد و آرام و خواب"
  },
  {
    "poem_id": 88025,
    "vorder": 109,
    "position": 0,
    "text": "الانان و غزدژ به لهراسب داد"
  },
  {
    "poem_id": 88025,
    "vorder": 110,
    "position": 1,
    "text": "بدو گفت کای گرد خسرو نژاد"
  },
  {
    "poem_id": 88025,
    "vorder": 111,
    "position": 0,
    "text": "برو با سپاهی به کردار کوه"
  },
  {
    "poem_id": 88025,
    "vorder": 112,
    "position": 1,
    "text": "گزین کن ز گردان لشکر گروه"
  },
  {
    "poem_id": 88025,
    "vorder": 113,
    "position": 0,
    "text": "سواران شایستهٔ کارزار"
  },
  {
    "poem_id": 88025,
    "vorder": 114,
    "position": 1,
    "text": "ببر تا برآری ز دشمن دمار"
  },
  {
    "poem_id": 88025,
    "vorder": 115,
    "position": 0,
    "text": "به اشکش بفرمود تا سی هزار"
  },
  {
    "poem_id": 88025,
    "vorder": 116,
    "position": 1,
    "text": "دمنده هژبران نیزه گزار"
  },
  {
    "poem_id": 88025,
    "vorder": 117,
    "position": 0,
    "text": "برد سوی خوارزم کوس بزرگ"
  },
  {
    "poem_id": 88025,
    "vorder": 118,
    "position": 1,
    "text": "سپاهی به کردار درنده گرگ"
  },
  {
    "poem_id": 88025,
    "vorder": 119,
    "position": 0,
    "text": "زند بر در شهر خوارزم گاه"
  },
  {
    "poem_id": 88025,
    "vorder": 120,
    "position": 1,
    "text": "ابا شیدهٔ رزم زن کینه خواه"
  },
  {
    "poem_id": 88025,
    "vorder": 121,
    "position": 0,
    "text": "سپاه چهارم به گودرز داد"
  },
  {
    "poem_id": 88025,
    "vorder": 122,
    "position": 1,
    "text": "چه مایه ورا پند و اندرز داد"
  },
  {
    "poem_id": 88025,
    "vorder": 123,
    "position": 0,
    "text": "که رو با بزرگان ایران به هم"
  },
  {
    "poem_id": 88025,
    "vorder": 124,
    "position": 1,
    "text": "چو گرگین و چون زنگه و گستهم"
  },
  {
    "poem_id": 88025,
    "vorder": 125,
    "position": 0,
    "text": "زواره فریبرز و فرهاد و گیو"
  },
  {
    "poem_id": 88025,
    "vorder": 126,
    "position": 1,
    "text": "گرازه سپهدار و رهام نیو"
  },
  {
    "poem_id": 88025,
    "vorder": 127,
    "position": 0,
    "text": "بفرمود بستن کمرشان به جنگ"
  },
  {
    "poem_id": 88025,
    "vorder": 128,
    "position": 1,
    "text": "سوی رزم توران شدن بی درنگ"
  },
  {
    "poem_id": 88025,
    "vorder": 129,
    "position": 0,
    "text": "سپهدار گودرز کشوادگان"
  },
  {
    "poem_id": 88025,
    "vorder": 130,
    "position": 1,
    "text": "همه پهلوانان و آزادگان"
  },
  {
    "poem_id": 88025,
    "vorder": 131,
    "position": 0,
    "text": "نشستند بر زین به فرمان شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 132,
    "position": 1,
    "text": "سپهدار گودرز پیش سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 133,
    "position": 0,
    "text": "به گودرز فرمود پس شهریار"
  },
  {
    "poem_id": 88025,
    "vorder": 134,
    "position": 1,
    "text": "چو رفتی کمر بستهٔ کارزار"
  },
  {
    "poem_id": 88025,
    "vorder": 135,
    "position": 0,
    "text": "نگر تا نیازی به بیداد دست"
  },
  {
    "poem_id": 88025,
    "vorder": 136,
    "position": 1,
    "text": "نگردانی ایوان آباد پست"
  },
  {
    "poem_id": 88025,
    "vorder": 137,
    "position": 0,
    "text": "کسی کو به جنگت نبندد میان"
  },
  {
    "poem_id": 88025,
    "vorder": 138,
    "position": 1,
    "text": "چنان ساز کش از تو ناید زیان"
  },
  {
    "poem_id": 88025,
    "vorder": 139,
    "position": 0,
    "text": "که نپسندد از ما بدی دادگر"
  },
  {
    "poem_id": 88025,
    "vorder": 140,
    "position": 1,
    "text": "سپنجست گیتی و ما برگذر"
  },
  {
    "poem_id": 88025,
    "vorder": 141,
    "position": 0,
    "text": "چو لشکر سوی مرز توران بری"
  },
  {
    "poem_id": 88025,
    "vorder": 142,
    "position": 1,
    "text": "مکن تیز دل را به آتش سری"
  },
  {
    "poem_id": 88025,
    "vorder": 143,
    "position": 0,
    "text": "نگر تا نجوشی به کردار طوس"
  },
  {
    "poem_id": 88025,
    "vorder": 144,
    "position": 1,
    "text": "نبندی به هر کار بر پیل کوس"
  },
  {
    "poem_id": 88025,
    "vorder": 145,
    "position": 0,
    "text": "جهاندیده‌ای سوی پیران فرست"
  },
  {
    "poem_id": 88025,
    "vorder": 146,
    "position": 1,
    "text": "هشیوار ، وز یادگیران فرست"
  },
  {
    "poem_id": 88025,
    "vorder": 147,
    "position": 0,
    "text": "به پند فراوانش بگشای گوش"
  },
  {
    "poem_id": 88025,
    "vorder": 148,
    "position": 1,
    "text": "بر او چادر مهربانی بپوش"
  },
  {
    "poem_id": 88025,
    "vorder": 149,
    "position": 0,
    "text": "به هر کار با هر کسی داد کن"
  },
  {
    "poem_id": 88025,
    "vorder": 150,
    "position": 1,
    "text": "ز یزدان نیکی دهش یاد کن"
  },
  {
    "poem_id": 88025,
    "vorder": 151,
    "position": 0,
    "text": "چنین گفت سالار لشکر به شاه"
  },
  {
    "poem_id": 88025,
    "vorder": 152,
    "position": 1,
    "text": "که فرمان تو برتر از شید و ماه"
  },
  {
    "poem_id": 88025,
    "vorder": 153,
    "position": 0,
    "text": "بدان سان شوم کم تو فرمان دهی"
  },
  {
    "poem_id": 88025,
    "vorder": 154,
    "position": 1,
    "text": "تو شاه جهانداری و من رهی"
  },
  {
    "poem_id": 88025,
    "vorder": 155,
    "position": 0,
    "text": "برآمد خروش از در پهلوان"
  },
  {
    "poem_id": 88025,
    "vorder": 156,
    "position": 1,
    "text": "ز بانگ تبیره زمین شد نوان"
  },
  {
    "poem_id": 88025,
    "vorder": 157,
    "position": 0,
    "text": "به لشکرگه آمد دمادم سپاه"
  },
  {
    "poem_id": 88025,
    "vorder": 158,
    "position": 1,
    "text": "جهان شد ز گرد سواران سیاه"
  },
  {
    "poem_id": 88025,
    "vorder": 159,
    "position": 0,
    "text": "به پیش سپاه اندرون پیل ، شست"
  },
  {
    "poem_id": 88025,
    "vorder": 160,
    "position": 1,
    "text": "جهان پست گشته ز پیلان مست"
  },
  {
    "poem_id": 88025,
    "vorder": 161,
    "position": 0,
    "text": "وزان ژنده پیلان جنگی چهار"
  },
  {
    "poem_id": 88025,
    "vorder": 162,
    "position": 1,
    "text": "بیاراسته از در شهریار"
  },
  {
    "poem_id": 88025,
    "vorder": 163,
    "position": 0,
    "text": "نهادند بر پشتشان تخت زر"
  },
  {
    "poem_id": 88025,
    "vorder": 164,
    "position": 1,
    "text": "نشستنگه شاه با زیب و فر"
  },
  {
    "poem_id": 88025,
    "vorder": 165,
    "position": 0,
    "text": "به گودرز فرمود تا بر نشست"
  },
  {
    "poem_id": 88025,
    "vorder": 166,
    "position": 1,
    "text": "بر آن تخت زر ، از بر پیل مست"
  },
  {
    "poem_id": 88025,
    "vorder": 167,
    "position": 0,
    "text": "برانگیخت پیلان و برخاست گرد"
  },
  {
    "poem_id": 88025,
    "vorder": 168,
    "position": 1,
    "text": "مر آن را به نیک اختری یاد کرد"
  },
  {
    "poem_id": 88025,
    "vorder": 169,
    "position": 0,
    "text": "که از جان پیران برآریم دود"
  },
  {
    "poem_id": 88025,
    "vorder": 170,
    "position": 1,
    "text": "بر آن سان که گرد پی پیل بود"
  }
]