[
  {
    "poem_id": 1642,
    "vorder": 1,
    "position": 0,
    "text": "دلارای چون آن سخنها شنید"
  },
  {
    "poem_id": 1642,
    "vorder": 2,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1642,
    "vorder": 3,
    "position": 0,
    "text": "ز دارا ز دیده ببارید خون"
  },
  {
    "poem_id": 1642,
    "vorder": 4,
    "position": 1,
    "text": "که بد ریخته زیر خاک اندرون"
  },
  {
    "poem_id": 1642,
    "vorder": 5,
    "position": 0,
    "text": "نویسندهٔ نامه را پیش خواند"
  },
  {
    "poem_id": 1642,
    "vorder": 6,
    "position": 1,
    "text": "همه خون ز مژگان به رخ برفشاند"
  },
  {
    "poem_id": 1642,
    "vorder": 7,
    "position": 0,
    "text": "مر آن نامه را خوب پاسخ نوشت"
  },
  {
    "poem_id": 1642,
    "vorder": 8,
    "position": 1,
    "text": "سخنهای با مغز و فرخ نوشت"
  },
  {
    "poem_id": 1642,
    "vorder": 9,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1642,
    "vorder": 10,
    "position": 1,
    "text": "جهاندار دادار پروردگار"
  },
  {
    "poem_id": 1642,
    "vorder": 11,
    "position": 0,
    "text": "دگر گفت کز کار گردان سپهر"
  },
  {
    "poem_id": 1642,
    "vorder": 12,
    "position": 1,
    "text": "کزویست پرخاش و آرام و مهر"
  },
  {
    "poem_id": 1642,
    "vorder": 13,
    "position": 0,
    "text": "همی فر دارا همی خواستیم"
  },
  {
    "poem_id": 1642,
    "vorder": 14,
    "position": 1,
    "text": "زبان را به نام وی آراستیم"
  },
  {
    "poem_id": 1642,
    "vorder": 15,
    "position": 0,
    "text": "کنون چون زمان وی اندر گذشت"
  },
  {
    "poem_id": 1642,
    "vorder": 16,
    "position": 1,
    "text": "سر گاه او چوب تابوت گشت"
  },
  {
    "poem_id": 1642,
    "vorder": 17,
    "position": 0,
    "text": "ترا خواهم اندر جهان نیکوی"
  },
  {
    "poem_id": 1642,
    "vorder": 18,
    "position": 1,
    "text": "بزرگی و پیروزی و خسروی"
  },
  {
    "poem_id": 1642,
    "vorder": 19,
    "position": 0,
    "text": "به کام تو خواهم که باشد جهان"
  },
  {
    "poem_id": 1642,
    "vorder": 20,
    "position": 1,
    "text": "برین آشکارا ندارم نهان"
  },
  {
    "poem_id": 1642,
    "vorder": 21,
    "position": 0,
    "text": "شنیدم همه هرچ گفتی ز مهر"
  },
  {
    "poem_id": 1642,
    "vorder": 22,
    "position": 1,
    "text": "که از جان تو شاد بادا سپهر"
  },
  {
    "poem_id": 1642,
    "vorder": 23,
    "position": 0,
    "text": "ازان دخمه و دار وز ماهیار"
  },
  {
    "poem_id": 1642,
    "vorder": 24,
    "position": 1,
    "text": "مکافات بدخواه جانوشیار"
  },
  {
    "poem_id": 1642,
    "vorder": 25,
    "position": 0,
    "text": "چو خون خداوند ریزد کسی"
  },
  {
    "poem_id": 1642,
    "vorder": 26,
    "position": 1,
    "text": "به گیتی درنگش نباشد بسی"
  },
  {
    "poem_id": 1642,
    "vorder": 27,
    "position": 0,
    "text": "دگر آنک جستی همی آشتی"
  },
  {
    "poem_id": 1642,
    "vorder": 28,
    "position": 1,
    "text": "بسی روز با پند بگذاشتی"
  },
  {
    "poem_id": 1642,
    "vorder": 29,
    "position": 0,
    "text": "نیاید ز شاهان پرستندگی"
  },
  {
    "poem_id": 1642,
    "vorder": 30,
    "position": 1,
    "text": "نجوید کس از تاجور بندگی"
  },
  {
    "poem_id": 1642,
    "vorder": 31,
    "position": 0,
    "text": "به جای شهنشاه ما را توی"
  },
  {
    "poem_id": 1642,
    "vorder": 32,
    "position": 1,
    "text": "چو خورشید شد ماه ما را توی"
  },
  {
    "poem_id": 1642,
    "vorder": 33,
    "position": 0,
    "text": "مبادا به گیتی به جز کام تو"
  },
  {
    "poem_id": 1642,
    "vorder": 34,
    "position": 1,
    "text": "همیشه بر ایوانها نام تو"
  },
  {
    "poem_id": 1642,
    "vorder": 35,
    "position": 0,
    "text": "دگر آنک از روشنک یاد کرد"
  },
  {
    "poem_id": 1642,
    "vorder": 36,
    "position": 1,
    "text": "دل ما بدان آرزو شاد کرد"
  },
  {
    "poem_id": 1642,
    "vorder": 37,
    "position": 0,
    "text": "پرستندهٔ تست ما بنده‌ایم"
  },
  {
    "poem_id": 1642,
    "vorder": 38,
    "position": 1,
    "text": "به فرمان و رایت سرافگنده‌ایم"
  },
  {
    "poem_id": 1642,
    "vorder": 39,
    "position": 0,
    "text": "درودت فرستاد و پاسخ نوشت"
  },
  {
    "poem_id": 1642,
    "vorder": 40,
    "position": 1,
    "text": "یکی خوب پاسخ بسان بهشت"
  },
  {
    "poem_id": 1642,
    "vorder": 41,
    "position": 0,
    "text": "چو شاه زمانه ترا برگزید"
  },
  {
    "poem_id": 1642,
    "vorder": 42,
    "position": 1,
    "text": "سر از رای او کس نیارد کشید"
  },
  {
    "poem_id": 1642,
    "vorder": 43,
    "position": 0,
    "text": "نوشتیم نامه سوی مهتران"
  },
  {
    "poem_id": 1642,
    "vorder": 44,
    "position": 1,
    "text": "به پهلو نژادان جنگاوران"
  },
  {
    "poem_id": 1642,
    "vorder": 45,
    "position": 0,
    "text": "که فرمان داراست فرمان تو"
  },
  {
    "poem_id": 1642,
    "vorder": 46,
    "position": 1,
    "text": "نپیچد کسی سر ز پیمان تو"
  },
  {
    "poem_id": 1642,
    "vorder": 47,
    "position": 0,
    "text": "فرستاده را جامه و بدره داد"
  },
  {
    "poem_id": 1642,
    "vorder": 48,
    "position": 1,
    "text": "ز گنجش ز هرگونه‌ای بهره داد"
  },
  {
    "poem_id": 1642,
    "vorder": 49,
    "position": 0,
    "text": "چو رومی به نزد سکندر رسید"
  },
  {
    "poem_id": 1642,
    "vorder": 50,
    "position": 1,
    "text": "همه یاد کرد آنچ دید و شنید"
  },
  {
    "poem_id": 1642,
    "vorder": 51,
    "position": 0,
    "text": "وزان تخت و آیین و آن بارگاه"
  },
  {
    "poem_id": 1642,
    "vorder": 52,
    "position": 1,
    "text": "تو گفتی که زنده‌ست بر گاه شاه"
  },
  {
    "poem_id": 1642,
    "vorder": 53,
    "position": 0,
    "text": "سکندر ز گفتار او گشت شاد"
  },
  {
    "poem_id": 1642,
    "vorder": 54,
    "position": 1,
    "text": "به آرام تاج کیی بر نهاد"
  }
]