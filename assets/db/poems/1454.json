[
  {
    "poem_id": 1454,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که ابلیس روزی پگاه"
  },
  {
    "poem_id": 1454,
    "vorder": 2,
    "position": 1,
    "text": "یکی انجمن کرد پنهان ز شاه"
  },
  {
    "poem_id": 1454,
    "vorder": 3,
    "position": 0,
    "text": "به دیوان چنین گفت کامروز کار"
  },
  {
    "poem_id": 1454,
    "vorder": 4,
    "position": 1,
    "text": "به رنج و به سختیست با شهریار"
  },
  {
    "poem_id": 1454,
    "vorder": 5,
    "position": 0,
    "text": "یکی دیو باید کنون نغزدست"
  },
  {
    "poem_id": 1454,
    "vorder": 6,
    "position": 1,
    "text": "که داند ز هرگونه رای و نشست"
  },
  {
    "poem_id": 1454,
    "vorder": 7,
    "position": 0,
    "text": "شود جان کاووس بیره کند"
  },
  {
    "poem_id": 1454,
    "vorder": 8,
    "position": 1,
    "text": "به دیوان برین رنج کوته کند"
  },
  {
    "poem_id": 1454,
    "vorder": 9,
    "position": 0,
    "text": "بگرداندش سر ز یزدان پاک"
  },
  {
    "poem_id": 1454,
    "vorder": 10,
    "position": 1,
    "text": "فشاند بر آن فر زیباش خاک"
  },
  {
    "poem_id": 1454,
    "vorder": 11,
    "position": 0,
    "text": "شنیدند و بر دل گرفتند یاد"
  },
  {
    "poem_id": 1454,
    "vorder": 12,
    "position": 1,
    "text": "کس از بیم کاووس پاسخ نداد"
  },
  {
    "poem_id": 1454,
    "vorder": 13,
    "position": 0,
    "text": "یکی دیو دژخیم بر پای خاست"
  },
  {
    "poem_id": 1454,
    "vorder": 14,
    "position": 1,
    "text": "چنین گفت کاین چربدستی مراست"
  },
  {
    "poem_id": 1454,
    "vorder": 15,
    "position": 0,
    "text": "غلامی بیاراست از خویشتن"
  },
  {
    "poem_id": 1454,
    "vorder": 16,
    "position": 1,
    "text": "سخن‌گوی و شایستهٔ انجمن"
  },
  {
    "poem_id": 1454,
    "vorder": 17,
    "position": 0,
    "text": "همی بود تا یک زمان شهریار"
  },
  {
    "poem_id": 1454,
    "vorder": 18,
    "position": 1,
    "text": "ز پهلو برون شد ز بهر شکار"
  },
  {
    "poem_id": 1454,
    "vorder": 19,
    "position": 0,
    "text": "بیامد بر او زمین بوس داد"
  },
  {
    "poem_id": 1454,
    "vorder": 20,
    "position": 1,
    "text": "یکی دستهٔ گل به کاووس داد"
  },
  {
    "poem_id": 1454,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت کاین فر زیبای تو"
  },
  {
    "poem_id": 1454,
    "vorder": 22,
    "position": 1,
    "text": "همی چرخ‌گردان سزد جای تو"
  },
  {
    "poem_id": 1454,
    "vorder": 23,
    "position": 0,
    "text": "به کام تو شد روی گیتی همه"
  },
  {
    "poem_id": 1454,
    "vorder": 24,
    "position": 1,
    "text": "شبانی و گردنکشان چون رمه"
  },
  {
    "poem_id": 1454,
    "vorder": 25,
    "position": 0,
    "text": "یکی کار ماندست کاندر جهان"
  },
  {
    "poem_id": 1454,
    "vorder": 26,
    "position": 1,
    "text": "نشان تو هرگز نگردد نهان"
  },
  {
    "poem_id": 1454,
    "vorder": 27,
    "position": 0,
    "text": "چه دارد همی آفتاب از تو راز"
  },
  {
    "poem_id": 1454,
    "vorder": 28,
    "position": 1,
    "text": "که چون گردد اندر نشیب و فراز"
  },
  {
    "poem_id": 1454,
    "vorder": 29,
    "position": 0,
    "text": "چگونست ماه و شب و روز چیست"
  },
  {
    "poem_id": 1454,
    "vorder": 30,
    "position": 1,
    "text": "برین گردش چرخ سالار کیست"
  },
  {
    "poem_id": 1454,
    "vorder": 31,
    "position": 0,
    "text": "دل شاه ازان دیو بی‌راه شد"
  },
  {
    "poem_id": 1454,
    "vorder": 32,
    "position": 1,
    "text": "روانش ز اندیشه کوتاه شد"
  },
  {
    "poem_id": 1454,
    "vorder": 33,
    "position": 0,
    "text": "گمانش چنان شد که گردان سپهر"
  },
  {
    "poem_id": 1454,
    "vorder": 34,
    "position": 1,
    "text": "به گیتی مراو را نمودست چهر"
  },
  {
    "poem_id": 1454,
    "vorder": 35,
    "position": 0,
    "text": "ندانست کاین چرخ را مایه نیست"
  },
  {
    "poem_id": 1454,
    "vorder": 36,
    "position": 1,
    "text": "ستاره فراوان و ایزد یکیست"
  },
  {
    "poem_id": 1454,
    "vorder": 37,
    "position": 0,
    "text": "همه زیر فرمانش بیچاره‌اند"
  },
  {
    "poem_id": 1454,
    "vorder": 38,
    "position": 1,
    "text": "که با سوزش و جنگ و پتیاره‌اند"
  },
  {
    "poem_id": 1454,
    "vorder": 39,
    "position": 0,
    "text": "جهان آفرین بی‌نیازست ازین"
  },
  {
    "poem_id": 1454,
    "vorder": 40,
    "position": 1,
    "text": "ز بهر تو باید سپهر و زمین"
  },
  {
    "poem_id": 1454,
    "vorder": 41,
    "position": 0,
    "text": "پراندیشه شد جان آن پادشا"
  },
  {
    "poem_id": 1454,
    "vorder": 42,
    "position": 1,
    "text": "که تا چون شود بی پر اندر هوا"
  },
  {
    "poem_id": 1454,
    "vorder": 43,
    "position": 0,
    "text": "ز دانندگان بس بپرسید شاه"
  },
  {
    "poem_id": 1454,
    "vorder": 44,
    "position": 1,
    "text": "کزین خاک چندست تا چرخ ماه"
  },
  {
    "poem_id": 1454,
    "vorder": 45,
    "position": 0,
    "text": "ستاره شمر گفت و خسرو شنید"
  },
  {
    "poem_id": 1454,
    "vorder": 46,
    "position": 1,
    "text": "یکی کژ و ناخوب چاره گزید"
  },
  {
    "poem_id": 1454,
    "vorder": 47,
    "position": 0,
    "text": "بفرمود پس تا به هنگام خواب"
  },
  {
    "poem_id": 1454,
    "vorder": 48,
    "position": 1,
    "text": "برفتند سوی نشیم عقاب"
  },
  {
    "poem_id": 1454,
    "vorder": 49,
    "position": 0,
    "text": "ازان بچه بسیار برداشتند"
  },
  {
    "poem_id": 1454,
    "vorder": 50,
    "position": 1,
    "text": "به هر خانه‌ای بر دو بگذاشتند"
  },
  {
    "poem_id": 1454,
    "vorder": 51,
    "position": 0,
    "text": "همی پرورانیدشان سال و ماه"
  },
  {
    "poem_id": 1454,
    "vorder": 52,
    "position": 1,
    "text": "به مرغ و به گوشت بره چندگاه"
  },
  {
    "poem_id": 1454,
    "vorder": 53,
    "position": 0,
    "text": "چو نیرو گرفتند هر یک چو شیر"
  },
  {
    "poem_id": 1454,
    "vorder": 54,
    "position": 1,
    "text": "بدان سان که غرم آوریدند زیر"
  },
  {
    "poem_id": 1454,
    "vorder": 55,
    "position": 0,
    "text": "ز عود قماری یکی تخت کرد"
  },
  {
    "poem_id": 1454,
    "vorder": 56,
    "position": 1,
    "text": "سر درزها را به زر سخت کرد"
  },
  {
    "poem_id": 1454,
    "vorder": 57,
    "position": 0,
    "text": "به پهلوش بر نیزهای دراز"
  },
  {
    "poem_id": 1454,
    "vorder": 58,
    "position": 1,
    "text": "ببست و بران‌گونه بر کرد ساز"
  },
  {
    "poem_id": 1454,
    "vorder": 59,
    "position": 0,
    "text": "بیاویخت از نیزه ران بره"
  },
  {
    "poem_id": 1454,
    "vorder": 60,
    "position": 1,
    "text": "ببست اندر اندیشه دل یکسره"
  },
  {
    "poem_id": 1454,
    "vorder": 61,
    "position": 0,
    "text": "ازن پس عقاب دلاور چهار"
  },
  {
    "poem_id": 1454,
    "vorder": 62,
    "position": 1,
    "text": "بیاورد و بر تخت بست استوار"
  },
  {
    "poem_id": 1454,
    "vorder": 63,
    "position": 0,
    "text": "نشست از بر تخت کاووس شاه"
  },
  {
    "poem_id": 1454,
    "vorder": 64,
    "position": 1,
    "text": "که اهریمنش برده بد دل ز راه"
  },
  {
    "poem_id": 1454,
    "vorder": 65,
    "position": 0,
    "text": "چو شد گرسنه تیز پران عقاب"
  },
  {
    "poem_id": 1454,
    "vorder": 66,
    "position": 1,
    "text": "سوی گوشت کردند هر یک شتاب"
  },
  {
    "poem_id": 1454,
    "vorder": 67,
    "position": 0,
    "text": "ز روی زمین تخت برداشتند"
  },
  {
    "poem_id": 1454,
    "vorder": 68,
    "position": 1,
    "text": "ز هامون به ابر اندر افراشتند"
  },
  {
    "poem_id": 1454,
    "vorder": 69,
    "position": 0,
    "text": "بدان حد که شان بود نیرو به جای"
  },
  {
    "poem_id": 1454,
    "vorder": 70,
    "position": 1,
    "text": "سوی گوشت کردند آهنگ و رای"
  },
  {
    "poem_id": 1454,
    "vorder": 71,
    "position": 0,
    "text": "شنیدم که کاووس شد بر فلک"
  },
  {
    "poem_id": 1454,
    "vorder": 72,
    "position": 1,
    "text": "همی رفت تا بر رسد بر ملک"
  },
  {
    "poem_id": 1454,
    "vorder": 73,
    "position": 0,
    "text": "دگر گفت ازان رفت بر آسمان"
  },
  {
    "poem_id": 1454,
    "vorder": 74,
    "position": 1,
    "text": "که تا جنگ سازد به تیر و کمان"
  },
  {
    "poem_id": 1454,
    "vorder": 75,
    "position": 0,
    "text": "ز هر گونه‌ای هست آواز این"
  },
  {
    "poem_id": 1454,
    "vorder": 76,
    "position": 1,
    "text": "نداند به جز پر خرد راز این"
  },
  {
    "poem_id": 1454,
    "vorder": 77,
    "position": 0,
    "text": "پریدند بسیار و ماندند باز"
  },
  {
    "poem_id": 1454,
    "vorder": 78,
    "position": 1,
    "text": "چنین باشد آنکس که گیردش آز"
  },
  {
    "poem_id": 1454,
    "vorder": 79,
    "position": 0,
    "text": "چو با مرغ پرنده نیرو نماند"
  },
  {
    "poem_id": 1454,
    "vorder": 80,
    "position": 1,
    "text": "غمی گشت پرهاب خوی درنشاند"
  },
  {
    "poem_id": 1454,
    "vorder": 81,
    "position": 0,
    "text": "نگونسار گشتند ز ابر سیاه"
  },
  {
    "poem_id": 1454,
    "vorder": 82,
    "position": 1,
    "text": "کشان بر زمین از هوا تخت شاه"
  },
  {
    "poem_id": 1454,
    "vorder": 83,
    "position": 0,
    "text": "سوی بیشهٔ شیرچین آمدند"
  },
  {
    "poem_id": 1454,
    "vorder": 84,
    "position": 1,
    "text": "به آمل بروی زمین آمدند"
  },
  {
    "poem_id": 1454,
    "vorder": 85,
    "position": 0,
    "text": "نکردش تباه از شگفتی جهان"
  },
  {
    "poem_id": 1454,
    "vorder": 86,
    "position": 1,
    "text": "همی بودنی داشت اندر نهان"
  },
  {
    "poem_id": 1454,
    "vorder": 87,
    "position": 0,
    "text": "سیاووش زو خواست کاید پدید"
  },
  {
    "poem_id": 1454,
    "vorder": 88,
    "position": 1,
    "text": "ببایست لختی چمید و چرید"
  },
  {
    "poem_id": 1454,
    "vorder": 89,
    "position": 0,
    "text": "به جای بزرگی و تخت نشست"
  },
  {
    "poem_id": 1454,
    "vorder": 90,
    "position": 1,
    "text": "پشیمانی و درد بودش به دست"
  },
  {
    "poem_id": 1454,
    "vorder": 91,
    "position": 0,
    "text": "بمانده به بیشه درون زار و خوار"
  },
  {
    "poem_id": 1454,
    "vorder": 92,
    "position": 1,
    "text": "نیایش همی کرد با کردگار"
  }
]