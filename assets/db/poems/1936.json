[
  {
    "poem_id": 1936,
    "vorder": 1,
    "position": 0,
    "text": "چنین داد خوانیم بر یزدگرد"
  },
  {
    "poem_id": 1936,
    "vorder": 2,
    "position": 1,
    "text": "وگر کینه خوانیم ازین هفت گرد"
  },
  {
    "poem_id": 1936,
    "vorder": 3,
    "position": 0,
    "text": "اگر خود نداند همی کین و داد"
  },
  {
    "poem_id": 1936,
    "vorder": 4,
    "position": 1,
    "text": "مرا فیلسوف ایچ پاسخ نداد"
  },
  {
    "poem_id": 1936,
    "vorder": 5,
    "position": 0,
    "text": "وگر گفت دینی همه بسته گفت"
  },
  {
    "poem_id": 1936,
    "vorder": 6,
    "position": 1,
    "text": "بماند همی پاسخ اندر نهفت"
  },
  {
    "poem_id": 1936,
    "vorder": 7,
    "position": 0,
    "text": "اگر هیچ گنجست ای نیک رای"
  },
  {
    "poem_id": 1936,
    "vorder": 8,
    "position": 1,
    "text": "بیارای و دل را به فردا مپای"
  },
  {
    "poem_id": 1936,
    "vorder": 9,
    "position": 0,
    "text": "که گیتی همی بر تو بر بگذرد"
  },
  {
    "poem_id": 1936,
    "vorder": 10,
    "position": 1,
    "text": "زمانه دم ما همی‌بشمرد"
  },
  {
    "poem_id": 1936,
    "vorder": 11,
    "position": 0,
    "text": "در خوردنت چیره کن برنهاد"
  },
  {
    "poem_id": 1936,
    "vorder": 12,
    "position": 1,
    "text": "اگر خود بمانی دهد آنک داد"
  },
  {
    "poem_id": 1936,
    "vorder": 13,
    "position": 0,
    "text": "مرا دخل و خرج ار برابر بدی"
  },
  {
    "poem_id": 1936,
    "vorder": 14,
    "position": 1,
    "text": "زمانه مرا چون برادر بدی"
  },
  {
    "poem_id": 1936,
    "vorder": 15,
    "position": 0,
    "text": "تگرگ آمد امسال بر سان مرگ"
  },
  {
    "poem_id": 1936,
    "vorder": 16,
    "position": 1,
    "text": "مرا مرگ بهتر بُدی از تگرگ"
  },
  {
    "poem_id": 1936,
    "vorder": 17,
    "position": 0,
    "text": "در هیزم و گندم و گوسفند"
  },
  {
    "poem_id": 1936,
    "vorder": 18,
    "position": 1,
    "text": "ببست این برآورده چرخ بلند"
  },
  {
    "poem_id": 1936,
    "vorder": 19,
    "position": 0,
    "text": "می‌ آور که از روزمان بس نماند"
  },
  {
    "poem_id": 1936,
    "vorder": 20,
    "position": 1,
    "text": "چنین بود تا بود و بر کس نماند"
  }
]