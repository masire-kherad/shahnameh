[
  {
    "poem_id": 1552,
    "vorder": 1,
    "position": 0,
    "text": "چو این نامه‌ افتاد در دست من"
  },
  {
    "poem_id": 1552,
    "vorder": 2,
    "position": 1,
    "text": "به ماهی گراینده شد شست من"
  },
  {
    "poem_id": 1552,
    "vorder": 3,
    "position": 0,
    "text": "نگه کردم این نظم سست آمدم"
  },
  {
    "poem_id": 1552,
    "vorder": 4,
    "position": 1,
    "text": "بسی بیت ناتندرست آمدم"
  },
  {
    "poem_id": 1552,
    "vorder": 5,
    "position": 0,
    "text": "من این زان بگفتم که تا شهریار"
  },
  {
    "poem_id": 1552,
    "vorder": 6,
    "position": 1,
    "text": "بداند سخن گفتن نابکار"
  },
  {
    "poem_id": 1552,
    "vorder": 7,
    "position": 0,
    "text": "دو گوهر بد این با دو گوهر فروش"
  },
  {
    "poem_id": 1552,
    "vorder": 8,
    "position": 1,
    "text": "کنون شاه دارد به گفتار گوش"
  },
  {
    "poem_id": 1552,
    "vorder": 9,
    "position": 0,
    "text": "سخن چون بدین گونه بایدت گفت"
  },
  {
    "poem_id": 1552,
    "vorder": 10,
    "position": 1,
    "text": "مگو و مکن طبع با رنج جفت"
  },
  {
    "poem_id": 1552,
    "vorder": 11,
    "position": 0,
    "text": "چو بند روان بینی و رنج تن"
  },
  {
    "poem_id": 1552,
    "vorder": 12,
    "position": 1,
    "text": "به کانی که گوهر نیابی مکن"
  },
  {
    "poem_id": 1552,
    "vorder": 13,
    "position": 0,
    "text": "چو طبعی نباشد چو آب روان"
  },
  {
    "poem_id": 1552,
    "vorder": 14,
    "position": 1,
    "text": "مبر سوی این نامهٔ خسروان"
  },
  {
    "poem_id": 1552,
    "vorder": 15,
    "position": 0,
    "text": "دهن گر بماند ز خوردن تهی"
  },
  {
    "poem_id": 1552,
    "vorder": 16,
    "position": 1,
    "text": "ازان به که ناساز خوانی نهی"
  },
  {
    "poem_id": 1552,
    "vorder": 17,
    "position": 0,
    "text": "یکی نامه بود از گه باستان"
  },
  {
    "poem_id": 1552,
    "vorder": 18,
    "position": 1,
    "text": "سخنهای آن برمنش راستان"
  },
  {
    "poem_id": 1552,
    "vorder": 19,
    "position": 0,
    "text": "چو جامی گهر بود و منثور بود"
  },
  {
    "poem_id": 1552,
    "vorder": 20,
    "position": 1,
    "text": "طبایع ز پیوند او دور بود"
  },
  {
    "poem_id": 1552,
    "vorder": 21,
    "position": 0,
    "text": "گذشته برو سالیان شش هزار"
  },
  {
    "poem_id": 1552,
    "vorder": 22,
    "position": 1,
    "text": "گر ایدونک پرسش نماید شمار"
  },
  {
    "poem_id": 1552,
    "vorder": 23,
    "position": 0,
    "text": "نبردی به پیوند او کس گمان"
  },
  {
    "poem_id": 1552,
    "vorder": 24,
    "position": 1,
    "text": "پر اندیشه گشت این دل شادمان"
  },
  {
    "poem_id": 1552,
    "vorder": 25,
    "position": 0,
    "text": "گرفتم به گوینده بر آفرین"
  },
  {
    "poem_id": 1552,
    "vorder": 26,
    "position": 1,
    "text": "که پیوند را راه داد اندرین"
  },
  {
    "poem_id": 1552,
    "vorder": 27,
    "position": 0,
    "text": "اگرچه نپیوست جز اندکی"
  },
  {
    "poem_id": 1552,
    "vorder": 28,
    "position": 1,
    "text": "ز رزم و ز بزم از هزاران یکی"
  },
  {
    "poem_id": 1552,
    "vorder": 29,
    "position": 0,
    "text": "همو بود گوینده را راه بر"
  },
  {
    "poem_id": 1552,
    "vorder": 30,
    "position": 1,
    "text": "که بنشاند شاهی ابر گاه‌بر"
  },
  {
    "poem_id": 1552,
    "vorder": 31,
    "position": 0,
    "text": "همی یافت از مهتران ارج و گنج"
  },
  {
    "poem_id": 1552,
    "vorder": 32,
    "position": 1,
    "text": "ز خوی بد خویش بودی به رنج"
  },
  {
    "poem_id": 1552,
    "vorder": 33,
    "position": 0,
    "text": "ستایندهٔ شهریاران بدی"
  },
  {
    "poem_id": 1552,
    "vorder": 34,
    "position": 1,
    "text": "به کاخ افسر نامداران بدی"
  },
  {
    "poem_id": 1552,
    "vorder": 35,
    "position": 0,
    "text": "به شهر اندرون گشته گشتی سخن"
  },
  {
    "poem_id": 1552,
    "vorder": 36,
    "position": 1,
    "text": "ازو نو شدی روزگار کهن"
  },
  {
    "poem_id": 1552,
    "vorder": 37,
    "position": 0,
    "text": "من این نامه فرخ گرفتم به فال"
  },
  {
    "poem_id": 1552,
    "vorder": 38,
    "position": 1,
    "text": "بسی رنج بردم به بسیار سال"
  },
  {
    "poem_id": 1552,
    "vorder": 39,
    "position": 0,
    "text": "ندیدم سرافراز بخشنده‌ای"
  },
  {
    "poem_id": 1552,
    "vorder": 40,
    "position": 1,
    "text": "به گاه کیان‌بر درخشنده‌ای"
  },
  {
    "poem_id": 1552,
    "vorder": 41,
    "position": 0,
    "text": "مرا این سخن بر دل آسان نبود"
  },
  {
    "poem_id": 1552,
    "vorder": 42,
    "position": 1,
    "text": "بجز خامشی هیچ درمان نبود"
  },
  {
    "poem_id": 1552,
    "vorder": 43,
    "position": 0,
    "text": "نشستنگه مردم نیک‌بخت"
  },
  {
    "poem_id": 1552,
    "vorder": 44,
    "position": 1,
    "text": "یکی باغ دیدم سراسر درخت"
  },
  {
    "poem_id": 1552,
    "vorder": 45,
    "position": 0,
    "text": "به جایی نبد هیچ پیدا درش"
  },
  {
    "poem_id": 1552,
    "vorder": 46,
    "position": 1,
    "text": "بجز نام شاهی نبد افسرش"
  },
  {
    "poem_id": 1552,
    "vorder": 47,
    "position": 0,
    "text": "که گر در خور باغ بایستمی"
  },
  {
    "poem_id": 1552,
    "vorder": 48,
    "position": 1,
    "text": "اگر نیک بودی بشایستمی"
  },
  {
    "poem_id": 1552,
    "vorder": 49,
    "position": 0,
    "text": "سخن را چو بگذاشتم سال بیست"
  },
  {
    "poem_id": 1552,
    "vorder": 50,
    "position": 1,
    "text": "بدان تا سزاوار این رنج کیست"
  },
  {
    "poem_id": 1552,
    "vorder": 51,
    "position": 0,
    "text": "ابوالقاسم آن شهریار جهان"
  },
  {
    "poem_id": 1552,
    "vorder": 52,
    "position": 1,
    "text": "کزو تازه شد تاج شاهنشاهان"
  },
  {
    "poem_id": 1552,
    "vorder": 53,
    "position": 0,
    "text": "جهاندار محمود با فر و جود"
  },
  {
    "poem_id": 1552,
    "vorder": 54,
    "position": 1,
    "text": "که او را کند ماه و کیوان سجود"
  },
  {
    "poem_id": 1552,
    "vorder": 55,
    "position": 0,
    "text": "سر نامه را نام او تاج گشت"
  },
  {
    "poem_id": 1552,
    "vorder": 56,
    "position": 1,
    "text": "به فرش دل تیره چون عاج گشت"
  },
  {
    "poem_id": 1552,
    "vorder": 57,
    "position": 0,
    "text": "به بخش و به داد و به رای و هنر"
  },
  {
    "poem_id": 1552,
    "vorder": 58,
    "position": 1,
    "text": "نبد تاج را زو سزاوارتر"
  },
  {
    "poem_id": 1552,
    "vorder": 59,
    "position": 0,
    "text": "بیامد نشست از بر تخت داد"
  },
  {
    "poem_id": 1552,
    "vorder": 60,
    "position": 1,
    "text": "جهاندار چون او ندارد به یاد"
  },
  {
    "poem_id": 1552,
    "vorder": 61,
    "position": 0,
    "text": "ز شاهان پیشی همی بگذرد"
  },
  {
    "poem_id": 1552,
    "vorder": 62,
    "position": 1,
    "text": "نفس داستان را همی نشمرد(؟)"
  },
  {
    "poem_id": 1552,
    "vorder": 63,
    "position": 0,
    "text": "چه دینار بر چشم او بر چه خاک"
  },
  {
    "poem_id": 1552,
    "vorder": 64,
    "position": 1,
    "text": "به رزم و به بزم اندرش نیست باک"
  },
  {
    "poem_id": 1552,
    "vorder": 65,
    "position": 0,
    "text": "گه بزم زر و گه رزم تیغ"
  },
  {
    "poem_id": 1552,
    "vorder": 66,
    "position": 1,
    "text": "ز خواهنده هرگز ندارد دریغ"
  }
]