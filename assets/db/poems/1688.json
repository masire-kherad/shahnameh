[
  {
    "poem_id": 1688,
    "vorder": 1,
    "position": 0,
    "text": "کنون ای سراینده فرتوت مرد"
  },
  {
    "poem_id": 1688,
    "vorder": 2,
    "position": 1,
    "text": "سوی گاه اشکانیان بازگرد"
  },
  {
    "poem_id": 1688,
    "vorder": 3,
    "position": 0,
    "text": "چه گفت اندر آن نامهٔ راستان"
  },
  {
    "poem_id": 1688,
    "vorder": 4,
    "position": 1,
    "text": "که گوینده یاد آرد از باستان"
  },
  {
    "poem_id": 1688,
    "vorder": 5,
    "position": 0,
    "text": "پس از روزگار سکندر جهان"
  },
  {
    "poem_id": 1688,
    "vorder": 6,
    "position": 1,
    "text": "چه گوید کِرا بود تخت مهان"
  },
  {
    "poem_id": 1688,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت داننده دهقان چاچ"
  },
  {
    "poem_id": 1688,
    "vorder": 8,
    "position": 1,
    "text": "کزان پس کسی را نبد تخت عاج"
  },
  {
    "poem_id": 1688,
    "vorder": 9,
    "position": 0,
    "text": "بزرگان که از تخم آرش بدند"
  },
  {
    "poem_id": 1688,
    "vorder": 10,
    "position": 1,
    "text": "دلیر و سبکسار و سرکش بدند"
  },
  {
    "poem_id": 1688,
    "vorder": 11,
    "position": 0,
    "text": "به گیتی به هر گوشه‌ای بر یکی"
  },
  {
    "poem_id": 1688,
    "vorder": 12,
    "position": 1,
    "text": "گرفته ز هر کشوری اندکی"
  },
  {
    "poem_id": 1688,
    "vorder": 13,
    "position": 0,
    "text": "چو بر تختشان شاد بنشاندند"
  },
  {
    "poem_id": 1688,
    "vorder": 14,
    "position": 1,
    "text": "ملوک طوایف همی خواندند"
  },
  {
    "poem_id": 1688,
    "vorder": 15,
    "position": 0,
    "text": "برین گونه بگذشت سالی دویست"
  },
  {
    "poem_id": 1688,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی که اندر زمین شاه نیست"
  },
  {
    "poem_id": 1688,
    "vorder": 17,
    "position": 0,
    "text": "نکردند یاد این ازان آن ازین"
  },
  {
    "poem_id": 1688,
    "vorder": 18,
    "position": 1,
    "text": "برآسود یک چند روی زمین"
  },
  {
    "poem_id": 1688,
    "vorder": 19,
    "position": 0,
    "text": "سکندر سگالید زین‌گونه رای"
  },
  {
    "poem_id": 1688,
    "vorder": 20,
    "position": 1,
    "text": "که تا روم آباد ماند به جای"
  },
  {
    "poem_id": 1688,
    "vorder": 21,
    "position": 0,
    "text": "نخست اشک بود از نژاد قباد"
  },
  {
    "poem_id": 1688,
    "vorder": 22,
    "position": 1,
    "text": "دگر گرد شاپور خسرو نژاد"
  },
  {
    "poem_id": 1688,
    "vorder": 23,
    "position": 0,
    "text": "ز یک دست گودرز اشکانیان"
  },
  {
    "poem_id": 1688,
    "vorder": 24,
    "position": 1,
    "text": "چو بیژن که بود از نژاد کیان"
  },
  {
    "poem_id": 1688,
    "vorder": 25,
    "position": 0,
    "text": "چو نرسی و چون اورمزد بزرگ"
  },
  {
    "poem_id": 1688,
    "vorder": 26,
    "position": 1,
    "text": "چو آرش که بد نامدار سترگ"
  },
  {
    "poem_id": 1688,
    "vorder": 27,
    "position": 0,
    "text": "چو زو بگذری نامدار اردوان"
  },
  {
    "poem_id": 1688,
    "vorder": 28,
    "position": 1,
    "text": "خردمند و با رای و روشن‌روان"
  },
  {
    "poem_id": 1688,
    "vorder": 29,
    "position": 0,
    "text": "چو بنشست بهرام ز اشکانیان"
  },
  {
    "poem_id": 1688,
    "vorder": 30,
    "position": 1,
    "text": "ببخشید گنجی بارزانیان"
  },
  {
    "poem_id": 1688,
    "vorder": 31,
    "position": 0,
    "text": "ورا خواندند اردوان بزرگ"
  },
  {
    "poem_id": 1688,
    "vorder": 32,
    "position": 1,
    "text": "که از میش بگسست چنگال گرگ"
  },
  {
    "poem_id": 1688,
    "vorder": 33,
    "position": 0,
    "text": "ورا بود شیراز تا اصفهان"
  },
  {
    "poem_id": 1688,
    "vorder": 34,
    "position": 1,
    "text": "که داننده خواندش مرز مهان"
  },
  {
    "poem_id": 1688,
    "vorder": 35,
    "position": 0,
    "text": "به اصطخر بد بابک از دست اوی"
  },
  {
    "poem_id": 1688,
    "vorder": 36,
    "position": 1,
    "text": "که تنین خروشان بد از شست اوی"
  },
  {
    "poem_id": 1688,
    "vorder": 37,
    "position": 0,
    "text": "چو کوتاه شد شاخ و هم بیخشان"
  },
  {
    "poem_id": 1688,
    "vorder": 38,
    "position": 1,
    "text": "نگوید جهاندار تاریخشان"
  },
  {
    "poem_id": 1688,
    "vorder": 39,
    "position": 0,
    "text": "کزیشان جز از نام نشنیده‌ام"
  },
  {
    "poem_id": 1688,
    "vorder": 40,
    "position": 1,
    "text": "نه در نامهٔ خسروان دیده‌ام"
  },
  {
    "poem_id": 1688,
    "vorder": 41,
    "position": 0,
    "text": "سکندر چو نومید گشت از جهان"
  },
  {
    "poem_id": 1688,
    "vorder": 42,
    "position": 1,
    "text": "بیفگند رایی میان مهان"
  },
  {
    "poem_id": 1688,
    "vorder": 43,
    "position": 0,
    "text": "بدان تا نگیرد کس از روم یاد"
  },
  {
    "poem_id": 1688,
    "vorder": 44,
    "position": 1,
    "text": "بماند مران کشور آباد و شاد"
  },
  {
    "poem_id": 1688,
    "vorder": 45,
    "position": 0,
    "text": "چو دانا بود بر زمین شهریار"
  },
  {
    "poem_id": 1688,
    "vorder": 46,
    "position": 1,
    "text": "چنین آورد دانش شاه بار"
  }
]