[
  {
    "poem_id": 1387,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تابان برآمد ز کوه"
  },
  {
    "poem_id": 1387,
    "vorder": 2,
    "position": 1,
    "text": "برفتند گردان همه همگروه"
  },
  {
    "poem_id": 1387,
    "vorder": 3,
    "position": 0,
    "text": "بدیدند مر پهلوان را پگاه"
  },
  {
    "poem_id": 1387,
    "vorder": 4,
    "position": 1,
    "text": "وزان جایگه برگرفتند راه"
  },
  {
    "poem_id": 1387,
    "vorder": 5,
    "position": 0,
    "text": "سپهبد فرستاد خواننده را"
  },
  {
    "poem_id": 1387,
    "vorder": 6,
    "position": 1,
    "text": "که خواند بزرگان داننده را"
  },
  {
    "poem_id": 1387,
    "vorder": 7,
    "position": 0,
    "text": "چو دستور فرزانه با موبدان"
  },
  {
    "poem_id": 1387,
    "vorder": 8,
    "position": 1,
    "text": "سرافراز گردان و فرخ ردان"
  },
  {
    "poem_id": 1387,
    "vorder": 9,
    "position": 0,
    "text": "به شادی بر پهلوان آمدند"
  },
  {
    "poem_id": 1387,
    "vorder": 10,
    "position": 1,
    "text": "خردمند و روشن روان آمدند"
  },
  {
    "poem_id": 1387,
    "vorder": 11,
    "position": 0,
    "text": "زبان تیز بگشاد دستان سام"
  },
  {
    "poem_id": 1387,
    "vorder": 12,
    "position": 1,
    "text": "لبی پر ز خنده دلی شادکام"
  },
  {
    "poem_id": 1387,
    "vorder": 13,
    "position": 0,
    "text": "نخست آفرین جهاندار کرد"
  },
  {
    "poem_id": 1387,
    "vorder": 14,
    "position": 1,
    "text": "دل موبد از خواب بیدار کرد"
  },
  {
    "poem_id": 1387,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت کز داور راد و پاک"
  },
  {
    "poem_id": 1387,
    "vorder": 16,
    "position": 1,
    "text": "دل ما پر امید و ترس است و باک"
  },
  {
    "poem_id": 1387,
    "vorder": 17,
    "position": 0,
    "text": "به بخشایش امید و ترس از گناه"
  },
  {
    "poem_id": 1387,
    "vorder": 18,
    "position": 1,
    "text": "به فرمانها ژرف کردن نگاه"
  },
  {
    "poem_id": 1387,
    "vorder": 19,
    "position": 0,
    "text": "ستودن مراو را چنان چون توان"
  },
  {
    "poem_id": 1387,
    "vorder": 20,
    "position": 1,
    "text": "شب و روز بودن به پیشش نوان"
  },
  {
    "poem_id": 1387,
    "vorder": 21,
    "position": 0,
    "text": "خداوند گردنده خورشید و ماه"
  },
  {
    "poem_id": 1387,
    "vorder": 22,
    "position": 1,
    "text": "روان را به نیکی نماینده راه"
  },
  {
    "poem_id": 1387,
    "vorder": 23,
    "position": 0,
    "text": "بدویست گیهان خرم به پای"
  },
  {
    "poem_id": 1387,
    "vorder": 24,
    "position": 1,
    "text": "همو داد و داور به هر دو سرای"
  },
  {
    "poem_id": 1387,
    "vorder": 25,
    "position": 0,
    "text": "بهار آرد و تیرماه و خزان"
  },
  {
    "poem_id": 1387,
    "vorder": 26,
    "position": 1,
    "text": "برآرد پر از میوه دار رزان"
  },
  {
    "poem_id": 1387,
    "vorder": 27,
    "position": 0,
    "text": "جوان داردش گاه با رنگ و بوی"
  },
  {
    "poem_id": 1387,
    "vorder": 28,
    "position": 1,
    "text": "گهش پیر بینی دژم کرده روی"
  },
  {
    "poem_id": 1387,
    "vorder": 29,
    "position": 0,
    "text": "ز فرمان و رایش کسی نگذرد"
  },
  {
    "poem_id": 1387,
    "vorder": 30,
    "position": 1,
    "text": "پی مور بی او زمین نسپرد"
  },
  {
    "poem_id": 1387,
    "vorder": 31,
    "position": 0,
    "text": "بدانگه که لوح آفرید و قلم"
  },
  {
    "poem_id": 1387,
    "vorder": 32,
    "position": 1,
    "text": "بزد بر همه بودنیها رقم"
  },
  {
    "poem_id": 1387,
    "vorder": 33,
    "position": 0,
    "text": "جهان را فزایش ز جفت آفرید"
  },
  {
    "poem_id": 1387,
    "vorder": 34,
    "position": 1,
    "text": "که از یک فزونی نیاید پدید"
  },
  {
    "poem_id": 1387,
    "vorder": 35,
    "position": 0,
    "text": "ز چرخ بلند اندر آمد سخن"
  },
  {
    "poem_id": 1387,
    "vorder": 36,
    "position": 1,
    "text": "سراسر همین است گیتی ز بن"
  },
  {
    "poem_id": 1387,
    "vorder": 37,
    "position": 0,
    "text": "زمانه به مردم شد آراسته"
  },
  {
    "poem_id": 1387,
    "vorder": 38,
    "position": 1,
    "text": "وزو ارج گیرد همی خواسته"
  },
  {
    "poem_id": 1387,
    "vorder": 39,
    "position": 0,
    "text": "اگر نیستی جفت اندر جهان"
  },
  {
    "poem_id": 1387,
    "vorder": 40,
    "position": 1,
    "text": "بماندی توانای اندر نهان"
  },
  {
    "poem_id": 1387,
    "vorder": 41,
    "position": 0,
    "text": "و دیگر که مایه ز دین خدای"
  },
  {
    "poem_id": 1387,
    "vorder": 42,
    "position": 1,
    "text": "ندیدم که ماندی جوان را بجای"
  },
  {
    "poem_id": 1387,
    "vorder": 43,
    "position": 0,
    "text": "بویژه که باشد ز تخم بزرگ"
  },
  {
    "poem_id": 1387,
    "vorder": 44,
    "position": 1,
    "text": "چو بی‌جفت باشد بماند سترگ"
  },
  {
    "poem_id": 1387,
    "vorder": 45,
    "position": 0,
    "text": "چه نیکوتر از پهلوان جوان"
  },
  {
    "poem_id": 1387,
    "vorder": 46,
    "position": 1,
    "text": "که گردد به فرزند روشن روان"
  },
  {
    "poem_id": 1387,
    "vorder": 47,
    "position": 0,
    "text": "چو هنگام رفتن فراز آیدش"
  },
  {
    "poem_id": 1387,
    "vorder": 48,
    "position": 1,
    "text": "به فرزند نو روز بازآیدش"
  },
  {
    "poem_id": 1387,
    "vorder": 49,
    "position": 0,
    "text": "به گیتی بماند ز فرزند نام"
  },
  {
    "poem_id": 1387,
    "vorder": 50,
    "position": 1,
    "text": "که این پور زالست و آن پور سام"
  },
  {
    "poem_id": 1387,
    "vorder": 51,
    "position": 0,
    "text": "بدو گردد آراسته تاج و تخت"
  },
  {
    "poem_id": 1387,
    "vorder": 52,
    "position": 1,
    "text": "ازان رفته نام و بدین مانده بخت"
  },
  {
    "poem_id": 1387,
    "vorder": 53,
    "position": 0,
    "text": "کنون این همه داستان منست"
  },
  {
    "poem_id": 1387,
    "vorder": 54,
    "position": 1,
    "text": "گل و نرگس بوستان منست"
  },
  {
    "poem_id": 1387,
    "vorder": 55,
    "position": 0,
    "text": "که از من رمیدست صبر و خرد"
  },
  {
    "poem_id": 1387,
    "vorder": 56,
    "position": 1,
    "text": "بگویید کاین را چه اندر خورد"
  },
  {
    "poem_id": 1387,
    "vorder": 57,
    "position": 0,
    "text": "نگفتم من این تا نگشتم غمی"
  },
  {
    "poem_id": 1387,
    "vorder": 58,
    "position": 1,
    "text": "به مغز و خرد در نیامد کمی"
  },
  {
    "poem_id": 1387,
    "vorder": 59,
    "position": 0,
    "text": "همه کاخ مهراب مهر منست"
  },
  {
    "poem_id": 1387,
    "vorder": 60,
    "position": 1,
    "text": "زمینش چو گردان سپهر منست"
  },
  {
    "poem_id": 1387,
    "vorder": 61,
    "position": 0,
    "text": "دلم گشت با دخت سیندخت رام"
  },
  {
    "poem_id": 1387,
    "vorder": 62,
    "position": 1,
    "text": "چه گوینده باشد بدین رام سام"
  },
  {
    "poem_id": 1387,
    "vorder": 63,
    "position": 0,
    "text": "شود رام گویی منوچهر شاه"
  },
  {
    "poem_id": 1387,
    "vorder": 64,
    "position": 1,
    "text": "جوانی گمانی برد یا گناه"
  },
  {
    "poem_id": 1387,
    "vorder": 65,
    "position": 0,
    "text": "چه مهتر چه کهتر چو شد جفت جوی"
  },
  {
    "poem_id": 1387,
    "vorder": 66,
    "position": 1,
    "text": "سوی دین و آیین نهادست روی"
  },
  {
    "poem_id": 1387,
    "vorder": 67,
    "position": 0,
    "text": "بدین در خردمند را جنگ نیست"
  },
  {
    "poem_id": 1387,
    "vorder": 68,
    "position": 1,
    "text": "که هم راه دینست و هم ننگ نیست"
  },
  {
    "poem_id": 1387,
    "vorder": 69,
    "position": 0,
    "text": "چه گوید کنون موبد پیش بین"
  },
  {
    "poem_id": 1387,
    "vorder": 70,
    "position": 1,
    "text": "چه دانید فرزانگان اندرین"
  },
  {
    "poem_id": 1387,
    "vorder": 71,
    "position": 0,
    "text": "ببستند لب موبدان و ردان"
  },
  {
    "poem_id": 1387,
    "vorder": 72,
    "position": 1,
    "text": "سخن بسته شد بر لب بخردان"
  },
  {
    "poem_id": 1387,
    "vorder": 73,
    "position": 0,
    "text": "که ضحاک مهراب را بد نیا"
  },
  {
    "poem_id": 1387,
    "vorder": 74,
    "position": 1,
    "text": "دل شاه ازیشان پر از کیمیا"
  },
  {
    "poem_id": 1387,
    "vorder": 75,
    "position": 0,
    "text": "گشاده سخن کس نیارست گفت"
  },
  {
    "poem_id": 1387,
    "vorder": 76,
    "position": 1,
    "text": "که نشنید کس نوش با نیش جفت"
  },
  {
    "poem_id": 1387,
    "vorder": 77,
    "position": 0,
    "text": "چو نشنید از ایشان سپهبد سخن"
  },
  {
    "poem_id": 1387,
    "vorder": 78,
    "position": 1,
    "text": "بجوشید و رای نو افگند بن"
  },
  {
    "poem_id": 1387,
    "vorder": 79,
    "position": 0,
    "text": "که دانم که چون این پژوهش کنید"
  },
  {
    "poem_id": 1387,
    "vorder": 80,
    "position": 1,
    "text": "بدین رای بر من نکوهش کنید"
  },
  {
    "poem_id": 1387,
    "vorder": 81,
    "position": 0,
    "text": "ولیکن هر آنکو بود پر منش"
  },
  {
    "poem_id": 1387,
    "vorder": 82,
    "position": 1,
    "text": "بباید شنیدن بسی سرزنش"
  },
  {
    "poem_id": 1387,
    "vorder": 83,
    "position": 0,
    "text": "مرا اندرین گر نمایش کنید"
  },
  {
    "poem_id": 1387,
    "vorder": 84,
    "position": 1,
    "text": "وزین بند راه گشایش کنید"
  },
  {
    "poem_id": 1387,
    "vorder": 85,
    "position": 0,
    "text": "به جای شما آن کنم در جهان"
  },
  {
    "poem_id": 1387,
    "vorder": 86,
    "position": 1,
    "text": "که با کهتران کس نکرد از مهان"
  },
  {
    "poem_id": 1387,
    "vorder": 87,
    "position": 0,
    "text": "ز خوبی و از نیکی و راستی"
  },
  {
    "poem_id": 1387,
    "vorder": 88,
    "position": 1,
    "text": "ز بد ناورم بر شما کاستی"
  },
  {
    "poem_id": 1387,
    "vorder": 89,
    "position": 0,
    "text": "همه موبدان پاسخ آراستند"
  },
  {
    "poem_id": 1387,
    "vorder": 90,
    "position": 1,
    "text": "همه کام و آرام او خواستند"
  },
  {
    "poem_id": 1387,
    "vorder": 91,
    "position": 0,
    "text": "که ما مر ترا یک به یک بنده‌ایم"
  },
  {
    "poem_id": 1387,
    "vorder": 92,
    "position": 1,
    "text": "نه از بس شگفتی سرافگنده‌ایم"
  },
  {
    "poem_id": 1387,
    "vorder": 93,
    "position": 0,
    "text": "ابا آنکه مهراب ازین پایه نیست"
  },
  {
    "poem_id": 1387,
    "vorder": 94,
    "position": 1,
    "text": "بزرگست و گرد و سبک مایه نیست"
  },
  {
    "poem_id": 1387,
    "vorder": 95,
    "position": 0,
    "text": "بدانست کز گوهر اژدهاست"
  },
  {
    "poem_id": 1387,
    "vorder": 96,
    "position": 1,
    "text": "و گر چند بر تازیان پادشاست"
  },
  {
    "poem_id": 1387,
    "vorder": 97,
    "position": 0,
    "text": "اگر شاه رابد نگردد گمان"
  },
  {
    "poem_id": 1387,
    "vorder": 98,
    "position": 1,
    "text": "نباشد ازو ننگ بر دودمان"
  },
  {
    "poem_id": 1387,
    "vorder": 99,
    "position": 0,
    "text": "یکی نامه باید سوی پهلوان"
  },
  {
    "poem_id": 1387,
    "vorder": 100,
    "position": 1,
    "text": "چنان چون تو دانی به روشن روان"
  },
  {
    "poem_id": 1387,
    "vorder": 101,
    "position": 0,
    "text": "ترا خود خرد زان ما بیشتر"
  },
  {
    "poem_id": 1387,
    "vorder": 102,
    "position": 1,
    "text": "روان و گمانت به اندیشتر"
  },
  {
    "poem_id": 1387,
    "vorder": 103,
    "position": 0,
    "text": "مگر کو یکی نامه نزدیک شاه"
  },
  {
    "poem_id": 1387,
    "vorder": 104,
    "position": 1,
    "text": "فرستد کند رای او را نگاه"
  },
  {
    "poem_id": 1387,
    "vorder": 105,
    "position": 0,
    "text": "منوچهر هم رای سام سوار"
  },
  {
    "poem_id": 1387,
    "vorder": 106,
    "position": 1,
    "text": "نپردازد از ره بدین مایه کار"
  },
  {
    "poem_id": 1387,
    "vorder": 107,
    "position": 0,
    "text": "سپهبد نویسنده را پیش خواند"
  },
  {
    "poem_id": 1387,
    "vorder": 108,
    "position": 1,
    "text": "دل آگنده بودش همه برفشاند"
  },
  {
    "poem_id": 1387,
    "vorder": 109,
    "position": 0,
    "text": "یکی نامه فرمود نزدیک سام"
  },
  {
    "poem_id": 1387,
    "vorder": 110,
    "position": 1,
    "text": "سراسر نوید و درود و خرام"
  },
  {
    "poem_id": 1387,
    "vorder": 111,
    "position": 0,
    "text": "ز خط نخست آفرین گسترید"
  },
  {
    "poem_id": 1387,
    "vorder": 112,
    "position": 1,
    "text": "بدان دادگر کو جهان آفرید"
  },
  {
    "poem_id": 1387,
    "vorder": 113,
    "position": 0,
    "text": "ازویست شادی ازویست زور"
  },
  {
    "poem_id": 1387,
    "vorder": 114,
    "position": 1,
    "text": "خداوند کیوان و ناهید و هور"
  },
  {
    "poem_id": 1387,
    "vorder": 115,
    "position": 0,
    "text": "خداوند هست و خداوند نیست"
  },
  {
    "poem_id": 1387,
    "vorder": 116,
    "position": 1,
    "text": "همه بندگانیم و ایزد یکیست"
  },
  {
    "poem_id": 1387,
    "vorder": 117,
    "position": 0,
    "text": "ازو باد بر سام نیرم درود"
  },
  {
    "poem_id": 1387,
    "vorder": 118,
    "position": 1,
    "text": "خداوند کوپال و شمشیر و خود"
  },
  {
    "poem_id": 1387,
    "vorder": 119,
    "position": 0,
    "text": "چمانندهٔ دیزه هنگام گرد"
  },
  {
    "poem_id": 1387,
    "vorder": 120,
    "position": 1,
    "text": "چرانندهٔ کرگس اندر نبرد"
  },
  {
    "poem_id": 1387,
    "vorder": 121,
    "position": 0,
    "text": "فزایندهٔ باد آوردگاه"
  },
  {
    "poem_id": 1387,
    "vorder": 122,
    "position": 1,
    "text": "فشانندهٔ خون ز ابر سیاه"
  },
  {
    "poem_id": 1387,
    "vorder": 123,
    "position": 0,
    "text": "گرایندهٔ تاج و زرین کمر"
  },
  {
    "poem_id": 1387,
    "vorder": 124,
    "position": 1,
    "text": "نشانندهٔ زال بر تخت زر"
  },
  {
    "poem_id": 1387,
    "vorder": 125,
    "position": 0,
    "text": "به مردی هنر در هنر ساخته"
  },
  {
    "poem_id": 1387,
    "vorder": 126,
    "position": 1,
    "text": "خرد از هنرها برافراخته"
  },
  {
    "poem_id": 1387,
    "vorder": 127,
    "position": 0,
    "text": "من او را بسان یکی بنده‌ام"
  },
  {
    "poem_id": 1387,
    "vorder": 128,
    "position": 1,
    "text": "به مهرش روان و دل آگنده‌ام"
  },
  {
    "poem_id": 1387,
    "vorder": 129,
    "position": 0,
    "text": "ز مادر بزادم بران سان که دید"
  },
  {
    "poem_id": 1387,
    "vorder": 130,
    "position": 1,
    "text": "ز گردون به من بر ستمها رسید"
  },
  {
    "poem_id": 1387,
    "vorder": 131,
    "position": 0,
    "text": "پدر بود در ناز و خز و پرند"
  },
  {
    "poem_id": 1387,
    "vorder": 132,
    "position": 1,
    "text": "مرا برده سیمرغ بر کوه هند"
  },
  {
    "poem_id": 1387,
    "vorder": 133,
    "position": 0,
    "text": "نیازم بد آنکو شکار آورد"
  },
  {
    "poem_id": 1387,
    "vorder": 134,
    "position": 1,
    "text": "ابا بچه‌ام در شمار آورد"
  },
  {
    "poem_id": 1387,
    "vorder": 135,
    "position": 0,
    "text": "همی پوست از باد بر من بسوخت"
  },
  {
    "poem_id": 1387,
    "vorder": 136,
    "position": 1,
    "text": "زمان تا زمان خاک چشمم بدوخت"
  },
  {
    "poem_id": 1387,
    "vorder": 137,
    "position": 0,
    "text": "همی خواندندی مرا پور سام"
  },
  {
    "poem_id": 1387,
    "vorder": 138,
    "position": 1,
    "text": "به اورنگ بر سام و من در کنام"
  },
  {
    "poem_id": 1387,
    "vorder": 139,
    "position": 0,
    "text": "چو یزدان چنین راند اندر بوش"
  },
  {
    "poem_id": 1387,
    "vorder": 140,
    "position": 1,
    "text": "بران بود چرخ روان را روش"
  },
  {
    "poem_id": 1387,
    "vorder": 141,
    "position": 0,
    "text": "کس از داد یزدان نیابد گریغ"
  },
  {
    "poem_id": 1387,
    "vorder": 142,
    "position": 1,
    "text": "وگرچه بپرد برآید به میغ"
  },
  {
    "poem_id": 1387,
    "vorder": 143,
    "position": 0,
    "text": "سنان گر بدندان بخاید دلیر"
  },
  {
    "poem_id": 1387,
    "vorder": 144,
    "position": 1,
    "text": "بدرد ز آواز او چرم شیر"
  },
  {
    "poem_id": 1387,
    "vorder": 145,
    "position": 0,
    "text": "گرفتار فرمان یزدان بود"
  },
  {
    "poem_id": 1387,
    "vorder": 146,
    "position": 1,
    "text": "وگر چند دندانش سندان بود"
  },
  {
    "poem_id": 1387,
    "vorder": 147,
    "position": 0,
    "text": "یکی کار پیش آمدم دل شکن"
  },
  {
    "poem_id": 1387,
    "vorder": 148,
    "position": 1,
    "text": "که نتوان ستودنش بر انجمن"
  },
  {
    "poem_id": 1387,
    "vorder": 149,
    "position": 0,
    "text": "پدر گر دلیرست و نراژدهاست"
  },
  {
    "poem_id": 1387,
    "vorder": 150,
    "position": 1,
    "text": "اگر بشنود راز بنده رواست"
  },
  {
    "poem_id": 1387,
    "vorder": 151,
    "position": 0,
    "text": "من از دخت مهراب گریان شدم"
  },
  {
    "poem_id": 1387,
    "vorder": 152,
    "position": 1,
    "text": "چو بر آتش تیز بریان شدم"
  },
  {
    "poem_id": 1387,
    "vorder": 153,
    "position": 0,
    "text": "ستاره شب تیره یار منست"
  },
  {
    "poem_id": 1387,
    "vorder": 154,
    "position": 1,
    "text": "من آنم که دریا کنار منست"
  },
  {
    "poem_id": 1387,
    "vorder": 155,
    "position": 0,
    "text": "به رنجی رسیدستم از خویشتن"
  },
  {
    "poem_id": 1387,
    "vorder": 156,
    "position": 1,
    "text": "که بر من بگرید همه انجمن"
  },
  {
    "poem_id": 1387,
    "vorder": 157,
    "position": 0,
    "text": "اگرچه دلم دید چندین ستم"
  },
  {
    "poem_id": 1387,
    "vorder": 158,
    "position": 1,
    "text": "نیارم زدن جز به فرمانت دم"
  },
  {
    "poem_id": 1387,
    "vorder": 159,
    "position": 0,
    "text": "چه فرماید اکنون جهان پهلوان"
  },
  {
    "poem_id": 1387,
    "vorder": 160,
    "position": 1,
    "text": "گشایم ازین رنج و سختی روان"
  },
  {
    "poem_id": 1387,
    "vorder": 161,
    "position": 0,
    "text": "ز پیمان نگردد سپهبد پدر"
  },
  {
    "poem_id": 1387,
    "vorder": 162,
    "position": 1,
    "text": "بدین کار دستور باشد مگر"
  },
  {
    "poem_id": 1387,
    "vorder": 163,
    "position": 0,
    "text": "که من دخت مهراب را جفت خویش"
  },
  {
    "poem_id": 1387,
    "vorder": 164,
    "position": 1,
    "text": "کنم راستی را به آیین و کیش"
  },
  {
    "poem_id": 1387,
    "vorder": 165,
    "position": 0,
    "text": "به پیمان چنین رفت پیش گروه"
  },
  {
    "poem_id": 1387,
    "vorder": 166,
    "position": 1,
    "text": "چو باز آوریدم ز البرز کوه"
  },
  {
    "poem_id": 1387,
    "vorder": 167,
    "position": 0,
    "text": "که هیچ آرزو بر دلت نگسلم"
  },
  {
    "poem_id": 1387,
    "vorder": 168,
    "position": 1,
    "text": "کنون اندرین است بسته دلم"
  },
  {
    "poem_id": 1387,
    "vorder": 169,
    "position": 0,
    "text": "سواری به کردار آذر گشسپ"
  },
  {
    "poem_id": 1387,
    "vorder": 170,
    "position": 1,
    "text": "ز کابل سوی سام شد بر دو اسپ"
  },
  {
    "poem_id": 1387,
    "vorder": 171,
    "position": 0,
    "text": "بفرمود و گفت ار بماند یکی"
  },
  {
    "poem_id": 1387,
    "vorder": 172,
    "position": 1,
    "text": "نباید ترا دم زدن اندکی"
  },
  {
    "poem_id": 1387,
    "vorder": 173,
    "position": 0,
    "text": "به دیگر تو پای اندر آور برو"
  },
  {
    "poem_id": 1387,
    "vorder": 174,
    "position": 1,
    "text": "برین سان همی تاز تا پیش گو"
  },
  {
    "poem_id": 1387,
    "vorder": 175,
    "position": 0,
    "text": "فرستاده در پیش او باد گشت"
  },
  {
    "poem_id": 1387,
    "vorder": 176,
    "position": 1,
    "text": "به زیر اندرش چرمه پولاد گشت"
  },
  {
    "poem_id": 1387,
    "vorder": 177,
    "position": 0,
    "text": "چو نزدیکی گرگساران رسید"
  },
  {
    "poem_id": 1387,
    "vorder": 178,
    "position": 1,
    "text": "یکایک ز دورش سپهبد بدید"
  },
  {
    "poem_id": 1387,
    "vorder": 179,
    "position": 0,
    "text": "همی گشت گرد یکی کوهسار"
  },
  {
    "poem_id": 1387,
    "vorder": 180,
    "position": 1,
    "text": "چماننده یوز و رمنده شکار"
  },
  {
    "poem_id": 1387,
    "vorder": 181,
    "position": 0,
    "text": "چنین گفت با غمگساران خویش"
  },
  {
    "poem_id": 1387,
    "vorder": 182,
    "position": 1,
    "text": "بدان کار دیده سواران خویش"
  },
  {
    "poem_id": 1387,
    "vorder": 183,
    "position": 0,
    "text": "که آمد سواری دمان کابلی"
  },
  {
    "poem_id": 1387,
    "vorder": 184,
    "position": 1,
    "text": "چمان چرمهٔ زیر او زابلی"
  },
  {
    "poem_id": 1387,
    "vorder": 185,
    "position": 0,
    "text": "فرستادهٔ زال باشد درست"
  },
  {
    "poem_id": 1387,
    "vorder": 186,
    "position": 1,
    "text": "ازو آگهی جست باید نخست"
  },
  {
    "poem_id": 1387,
    "vorder": 187,
    "position": 0,
    "text": "ز دستان و ایران و از شهریار"
  },
  {
    "poem_id": 1387,
    "vorder": 188,
    "position": 1,
    "text": "همی کرد باید سخن خواستار"
  },
  {
    "poem_id": 1387,
    "vorder": 189,
    "position": 0,
    "text": "هم اندر زمان پیش او شد سوار"
  },
  {
    "poem_id": 1387,
    "vorder": 190,
    "position": 1,
    "text": "به دست اندرون نامهٔ نامدار"
  },
  {
    "poem_id": 1387,
    "vorder": 191,
    "position": 0,
    "text": "فرود آمد و خاک را بوس داد"
  },
  {
    "poem_id": 1387,
    "vorder": 192,
    "position": 1,
    "text": "بسی از جهان آفرین کرد یاد"
  },
  {
    "poem_id": 1387,
    "vorder": 193,
    "position": 0,
    "text": "بپرسید و بستد ازو نامه سام"
  },
  {
    "poem_id": 1387,
    "vorder": 194,
    "position": 1,
    "text": "فرستاده گفت آنچه بود از پیام"
  },
  {
    "poem_id": 1387,
    "vorder": 195,
    "position": 0,
    "text": "سپهدار بگشاد از نامه بند"
  },
  {
    "poem_id": 1387,
    "vorder": 196,
    "position": 1,
    "text": "فرود آمد از تیغ کوه بلند"
  },
  {
    "poem_id": 1387,
    "vorder": 197,
    "position": 0,
    "text": "سخنهای دستان سراسر بخواند"
  },
  {
    "poem_id": 1387,
    "vorder": 198,
    "position": 1,
    "text": "بپژمرد و بر جای خیره بماند"
  },
  {
    "poem_id": 1387,
    "vorder": 199,
    "position": 0,
    "text": "پسندش نیامد چنان آرزوی"
  },
  {
    "poem_id": 1387,
    "vorder": 200,
    "position": 1,
    "text": "دگرگونه بایستش او را به خوی"
  },
  {
    "poem_id": 1387,
    "vorder": 201,
    "position": 0,
    "text": "چنین داد پاسخ که آمد پدید"
  },
  {
    "poem_id": 1387,
    "vorder": 202,
    "position": 1,
    "text": "سخن هر چه از گوهر بد سزید"
  },
  {
    "poem_id": 1387,
    "vorder": 203,
    "position": 0,
    "text": "چو مرغ ژیان باشد آموزگار"
  },
  {
    "poem_id": 1387,
    "vorder": 204,
    "position": 1,
    "text": "چنین کام دل جوید از روزگار"
  },
  {
    "poem_id": 1387,
    "vorder": 205,
    "position": 0,
    "text": "ز نخچیر کامد سوی خانه باز"
  },
  {
    "poem_id": 1387,
    "vorder": 206,
    "position": 1,
    "text": "به دلش اندر اندیشه آمد دراز"
  },
  {
    "poem_id": 1387,
    "vorder": 207,
    "position": 0,
    "text": "همی گفت اگر گویم این نیست رای"
  },
  {
    "poem_id": 1387,
    "vorder": 208,
    "position": 1,
    "text": "مکن داوری سوی دانش گرای"
  },
  {
    "poem_id": 1387,
    "vorder": 209,
    "position": 0,
    "text": "سوی شهریاران سر انجمن"
  },
  {
    "poem_id": 1387,
    "vorder": 210,
    "position": 1,
    "text": "شوم خام گفتار و پیمان شکن"
  },
  {
    "poem_id": 1387,
    "vorder": 211,
    "position": 0,
    "text": "و گر گویم آری و کامت رواست"
  },
  {
    "poem_id": 1387,
    "vorder": 212,
    "position": 1,
    "text": "بپرداز دل را بدانچت هواست"
  },
  {
    "poem_id": 1387,
    "vorder": 213,
    "position": 0,
    "text": "ازین مرغ پرورده وان دیوزاد"
  },
  {
    "poem_id": 1387,
    "vorder": 214,
    "position": 1,
    "text": "چه گویی چگونه برآید نژاد"
  },
  {
    "poem_id": 1387,
    "vorder": 215,
    "position": 0,
    "text": "سرش گشت از اندیشهٔ دل گران"
  },
  {
    "poem_id": 1387,
    "vorder": 216,
    "position": 1,
    "text": "بخفت و نیاسوده گشت اندران"
  },
  {
    "poem_id": 1387,
    "vorder": 217,
    "position": 0,
    "text": "سخن هر چه بر بنده دشوارتر"
  },
  {
    "poem_id": 1387,
    "vorder": 218,
    "position": 1,
    "text": "دلش خسته‌تر زان و تن زارتر"
  },
  {
    "poem_id": 1387,
    "vorder": 219,
    "position": 0,
    "text": "گشاده‌تر آن باشد اندر نهان"
  },
  {
    "poem_id": 1387,
    "vorder": 220,
    "position": 1,
    "text": "چو فرمان دهد کردگار جهان"
  }
]