[
  {
    "poem_id": 1535,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد به گشتاسپ شاه"
  },
  {
    "poem_id": 1535,
    "vorder": 2,
    "position": 1,
    "text": "که سالار چین جملگی با سپاه"
  },
  {
    "poem_id": 1535,
    "vorder": 3,
    "position": 0,
    "text": "بیاراسته آمد از جای خویش"
  },
  {
    "poem_id": 1535,
    "vorder": 4,
    "position": 1,
    "text": "خشاش یلش را فرستاد پیش"
  },
  {
    "poem_id": 1535,
    "vorder": 5,
    "position": 0,
    "text": "چو بشنید کو رفت با لشکرش"
  },
  {
    "poem_id": 1535,
    "vorder": 6,
    "position": 1,
    "text": "که ویران کند آن نکو کشورش"
  },
  {
    "poem_id": 1535,
    "vorder": 7,
    "position": 0,
    "text": "سپهبدش را گفت فردا پگاه"
  },
  {
    "poem_id": 1535,
    "vorder": 8,
    "position": 1,
    "text": "بیارای پیل و بیاور سپاه"
  },
  {
    "poem_id": 1535,
    "vorder": 9,
    "position": 0,
    "text": "سوی مرزدارانش نامه نوشت"
  },
  {
    "poem_id": 1535,
    "vorder": 10,
    "position": 1,
    "text": "که خاقان ره راد مردی بهشت"
  },
  {
    "poem_id": 1535,
    "vorder": 11,
    "position": 0,
    "text": "بیایید یکسر به درگاه من"
  },
  {
    "poem_id": 1535,
    "vorder": 12,
    "position": 1,
    "text": "که بر مرز بگذشت بد خواه من"
  },
  {
    "poem_id": 1535,
    "vorder": 13,
    "position": 0,
    "text": "چو نامه سوی راد مردان رسید"
  },
  {
    "poem_id": 1535,
    "vorder": 14,
    "position": 1,
    "text": "که آمد جهانجوی دشمن پدید"
  },
  {
    "poem_id": 1535,
    "vorder": 15,
    "position": 0,
    "text": "سپاهی بیامد به درگاه شاه"
  },
  {
    "poem_id": 1535,
    "vorder": 16,
    "position": 1,
    "text": "که چندان نبد بر زمین بر گیاه"
  },
  {
    "poem_id": 1535,
    "vorder": 17,
    "position": 0,
    "text": "ز بهر جهانگیر شاه کیان"
  },
  {
    "poem_id": 1535,
    "vorder": 18,
    "position": 1,
    "text": "ببستند گردان گیتی میان"
  },
  {
    "poem_id": 1535,
    "vorder": 19,
    "position": 0,
    "text": "به درگاه خسرو نهادند روی"
  },
  {
    "poem_id": 1535,
    "vorder": 20,
    "position": 1,
    "text": "همه مرزداران به فرمان اوی"
  },
  {
    "poem_id": 1535,
    "vorder": 21,
    "position": 0,
    "text": "برین برنیامد بسی روزگار"
  },
  {
    "poem_id": 1535,
    "vorder": 22,
    "position": 1,
    "text": "که گرد از گزیده هزاران هزار"
  },
  {
    "poem_id": 1535,
    "vorder": 23,
    "position": 0,
    "text": "فراز آمده بود مر شاه را"
  },
  {
    "poem_id": 1535,
    "vorder": 24,
    "position": 1,
    "text": "کی نامدار و نکو خواه را"
  },
  {
    "poem_id": 1535,
    "vorder": 25,
    "position": 0,
    "text": "به لشکرگه آمد سپه را بدید"
  },
  {
    "poem_id": 1535,
    "vorder": 26,
    "position": 1,
    "text": "که شایسته بد رزم را برگزید"
  },
  {
    "poem_id": 1535,
    "vorder": 27,
    "position": 0,
    "text": "ازان شادمان گشت فرخنده شاه"
  },
  {
    "poem_id": 1535,
    "vorder": 28,
    "position": 1,
    "text": "دلش خیره آمد زبی مر سپاه"
  },
  {
    "poem_id": 1535,
    "vorder": 29,
    "position": 0,
    "text": "دگر روز گشتاسپ با موبدان"
  },
  {
    "poem_id": 1535,
    "vorder": 30,
    "position": 1,
    "text": "ردان و بزرگان و اسپهبدان"
  },
  {
    "poem_id": 1535,
    "vorder": 31,
    "position": 0,
    "text": "گشاد آن در گنج پر کرده جم"
  },
  {
    "poem_id": 1535,
    "vorder": 32,
    "position": 1,
    "text": "سپه را بداد او دو ساله درم"
  },
  {
    "poem_id": 1535,
    "vorder": 33,
    "position": 0,
    "text": "چو روزی ببخشید و جوشن بداد"
  },
  {
    "poem_id": 1535,
    "vorder": 34,
    "position": 1,
    "text": "بزد نای و کوس و بنه بر نهاد"
  },
  {
    "poem_id": 1535,
    "vorder": 35,
    "position": 0,
    "text": "بفرمود بردن ز پیش سپاه"
  },
  {
    "poem_id": 1535,
    "vorder": 36,
    "position": 1,
    "text": "درفش همایون فرخنده شاه"
  },
  {
    "poem_id": 1535,
    "vorder": 37,
    "position": 0,
    "text": "سوی رزم ارجاسپ لشکر کشید"
  },
  {
    "poem_id": 1535,
    "vorder": 38,
    "position": 1,
    "text": "سپاهی که هرگز چنان کس ندید"
  },
  {
    "poem_id": 1535,
    "vorder": 39,
    "position": 0,
    "text": "ز تاریکی و گرد پای سپاه"
  },
  {
    "poem_id": 1535,
    "vorder": 40,
    "position": 1,
    "text": "کسی روز روشن ندید ایچ راه"
  },
  {
    "poem_id": 1535,
    "vorder": 41,
    "position": 0,
    "text": "ز بس بانگ اسپان و از بس خروش"
  },
  {
    "poem_id": 1535,
    "vorder": 42,
    "position": 1,
    "text": "همی نالهٔ کوس نشنید گوش"
  },
  {
    "poem_id": 1535,
    "vorder": 43,
    "position": 0,
    "text": "درفش فراوان برافراشته"
  },
  {
    "poem_id": 1535,
    "vorder": 44,
    "position": 1,
    "text": "همه نیزه‌ها ز ابر بگذاشته"
  },
  {
    "poem_id": 1535,
    "vorder": 45,
    "position": 0,
    "text": "چو رسته درخت از بر کوهسار"
  },
  {
    "poem_id": 1535,
    "vorder": 46,
    "position": 1,
    "text": "چو بیشه نیستان به وقت بهار"
  },
  {
    "poem_id": 1535,
    "vorder": 47,
    "position": 0,
    "text": "ازین سان همی رفت گشتاسپ شاه"
  },
  {
    "poem_id": 1535,
    "vorder": 48,
    "position": 1,
    "text": "ز کشور به کشور همی شد سپاه"
  }
]