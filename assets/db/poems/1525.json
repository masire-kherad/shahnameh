[
  {
    "poem_id": 1525,
    "vorder": 1,
    "position": 0,
    "text": "پر اندیشه بنشست لهراسپ دیر"
  },
  {
    "poem_id": 1525,
    "vorder": 2,
    "position": 1,
    "text": "بفرمود تا پیش او شد زریر"
  },
  {
    "poem_id": 1525,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت کاین جز برادرت نیست"
  },
  {
    "poem_id": 1525,
    "vorder": 4,
    "position": 1,
    "text": "بدین چاره بشتاب وایدر مه‌ایست"
  },
  {
    "poem_id": 1525,
    "vorder": 5,
    "position": 0,
    "text": "درنگ آوری کار گردد تباه"
  },
  {
    "poem_id": 1525,
    "vorder": 6,
    "position": 1,
    "text": "میاسا و اسپ درنگی مخواه"
  },
  {
    "poem_id": 1525,
    "vorder": 7,
    "position": 0,
    "text": "ببر تخت و بالا و زرینه کفش"
  },
  {
    "poem_id": 1525,
    "vorder": 8,
    "position": 1,
    "text": "همان تاج با کاویانی درفش"
  },
  {
    "poem_id": 1525,
    "vorder": 9,
    "position": 0,
    "text": "من این پادشاهی مر او را دهم"
  },
  {
    "poem_id": 1525,
    "vorder": 10,
    "position": 1,
    "text": "برین بر سرش بر سپاسی نهم"
  },
  {
    "poem_id": 1525,
    "vorder": 11,
    "position": 0,
    "text": "تو ز ایدر برو تا حلب کینه‌جوی"
  },
  {
    "poem_id": 1525,
    "vorder": 12,
    "position": 1,
    "text": "سپه را جز از جنگ چیزی مگوی"
  },
  {
    "poem_id": 1525,
    "vorder": 13,
    "position": 0,
    "text": "زریر ستوده به لهراسپ گفت"
  },
  {
    "poem_id": 1525,
    "vorder": 14,
    "position": 1,
    "text": "که این راز بیرون کشیم از نهفت"
  },
  {
    "poem_id": 1525,
    "vorder": 15,
    "position": 0,
    "text": "گر اویست فرمان‌بر و مهترست"
  },
  {
    "poem_id": 1525,
    "vorder": 16,
    "position": 1,
    "text": "ورا هرک مهتر بود کهترست"
  },
  {
    "poem_id": 1525,
    "vorder": 17,
    "position": 0,
    "text": "بگفت این و برساخت در حال کار"
  },
  {
    "poem_id": 1525,
    "vorder": 18,
    "position": 1,
    "text": "گزیده یکی لشکری نامدار"
  },
  {
    "poem_id": 1525,
    "vorder": 19,
    "position": 0,
    "text": "نبیرهٔ برزگان و آزادگان"
  },
  {
    "poem_id": 1525,
    "vorder": 20,
    "position": 1,
    "text": "ز کاوس و گودرز کشوادگان"
  },
  {
    "poem_id": 1525,
    "vorder": 21,
    "position": 0,
    "text": "ز تخم زرسپ آنک بودند نیز"
  },
  {
    "poem_id": 1525,
    "vorder": 22,
    "position": 1,
    "text": "چو بهرام شیراوژن و ریونیز"
  },
  {
    "poem_id": 1525,
    "vorder": 23,
    "position": 0,
    "text": "همی رفت هر مهتری با دو اسپ"
  },
  {
    "poem_id": 1525,
    "vorder": 24,
    "position": 1,
    "text": "فروزان به کردار آذرگشسپ"
  },
  {
    "poem_id": 1525,
    "vorder": 25,
    "position": 0,
    "text": "نیاسود کس تا به مرز حلب"
  },
  {
    "poem_id": 1525,
    "vorder": 26,
    "position": 1,
    "text": "جهان شد پر از جنگ و جوش و شغب"
  },
  {
    "poem_id": 1525,
    "vorder": 27,
    "position": 0,
    "text": "درفش همایون برافراختند"
  },
  {
    "poem_id": 1525,
    "vorder": 28,
    "position": 1,
    "text": "سراپرده و خیمه‌ها ساختند"
  },
  {
    "poem_id": 1525,
    "vorder": 29,
    "position": 0,
    "text": "زریر سپهبد سپه را بماند"
  },
  {
    "poem_id": 1525,
    "vorder": 30,
    "position": 1,
    "text": "به بهرام گردنکش و خود براند"
  },
  {
    "poem_id": 1525,
    "vorder": 31,
    "position": 0,
    "text": "بسان کسی کو پیامی برد"
  },
  {
    "poem_id": 1525,
    "vorder": 32,
    "position": 1,
    "text": "وگر نزد شاهی خرامی برد"
  },
  {
    "poem_id": 1525,
    "vorder": 33,
    "position": 0,
    "text": "ازان ویژگان پنج تن را ببرد"
  },
  {
    "poem_id": 1525,
    "vorder": 34,
    "position": 1,
    "text": "که بودند با مغز و هشیار و گرد"
  },
  {
    "poem_id": 1525,
    "vorder": 35,
    "position": 0,
    "text": "چو نزدیک درگاه قیصر رسید"
  },
  {
    "poem_id": 1525,
    "vorder": 36,
    "position": 1,
    "text": "به درگاه سالار بارش بدید"
  },
  {
    "poem_id": 1525,
    "vorder": 37,
    "position": 0,
    "text": "به در بر همه فرش دیبا کشید"
  },
  {
    "poem_id": 1525,
    "vorder": 38,
    "position": 1,
    "text": "بیامد به قیصر بگفت آنچ دید"
  },
  {
    "poem_id": 1525,
    "vorder": 39,
    "position": 0,
    "text": "به کاخ اندرون بود قیصر دژم"
  },
  {
    "poem_id": 1525,
    "vorder": 40,
    "position": 1,
    "text": "چو قالوس و گشتاسپ با او بهم"
  },
  {
    "poem_id": 1525,
    "vorder": 41,
    "position": 0,
    "text": "بدو آگهی داد سالار بار"
  },
  {
    "poem_id": 1525,
    "vorder": 42,
    "position": 1,
    "text": "که آمد به درگه زریر سوار"
  },
  {
    "poem_id": 1525,
    "vorder": 43,
    "position": 0,
    "text": "چو قیصر شنید این سخن بار داد"
  },
  {
    "poem_id": 1525,
    "vorder": 44,
    "position": 1,
    "text": "ازان آمدن گشت گشتاسپ شاد"
  },
  {
    "poem_id": 1525,
    "vorder": 45,
    "position": 0,
    "text": "زریر اندر آمد چو سرو بلند"
  },
  {
    "poem_id": 1525,
    "vorder": 46,
    "position": 1,
    "text": "نشست از بر تخت آن ارجمند"
  },
  {
    "poem_id": 1525,
    "vorder": 47,
    "position": 0,
    "text": "ز قیصر بپرسید و پوزش گرفت"
  },
  {
    "poem_id": 1525,
    "vorder": 48,
    "position": 1,
    "text": "همان رومیان را فروزش گرفت"
  },
  {
    "poem_id": 1525,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت قیصر فرخ‌زاد را"
  },
  {
    "poem_id": 1525,
    "vorder": 50,
    "position": 1,
    "text": "نپرسی نداری به دل داد را"
  },
  {
    "poem_id": 1525,
    "vorder": 51,
    "position": 0,
    "text": "به قیصر چنین گفت فرخ زریر"
  },
  {
    "poem_id": 1525,
    "vorder": 52,
    "position": 1,
    "text": "که این بنده از بندگی گشت سیر"
  },
  {
    "poem_id": 1525,
    "vorder": 53,
    "position": 0,
    "text": "گریزان بیامد ز درگاه شاه"
  },
  {
    "poem_id": 1525,
    "vorder": 54,
    "position": 1,
    "text": "کنون یافت ایدر چنین پایگاه"
  },
  {
    "poem_id": 1525,
    "vorder": 55,
    "position": 0,
    "text": "چو گشتاسپ بشنید پاسخ نداد"
  },
  {
    "poem_id": 1525,
    "vorder": 56,
    "position": 1,
    "text": "تو گفتی ز ایران نیامدش یاد"
  },
  {
    "poem_id": 1525,
    "vorder": 57,
    "position": 0,
    "text": "چو قیصر شنید این سخن زان جوان"
  },
  {
    "poem_id": 1525,
    "vorder": 58,
    "position": 1,
    "text": "پراندیشه شد مرد روشن‌روان"
  },
  {
    "poem_id": 1525,
    "vorder": 59,
    "position": 0,
    "text": "که شاید بدن این سخن کو بگفت"
  },
  {
    "poem_id": 1525,
    "vorder": 60,
    "position": 1,
    "text": "جز از راستی نیست اندر نهفت"
  },
  {
    "poem_id": 1525,
    "vorder": 61,
    "position": 0,
    "text": "به قیصر ز لهراسپ پیغام داد"
  },
  {
    "poem_id": 1525,
    "vorder": 62,
    "position": 1,
    "text": "که گر دادگر سر نه پیچد ز داد"
  },
  {
    "poem_id": 1525,
    "vorder": 63,
    "position": 0,
    "text": "ازین پس نشستم برومست و بس"
  },
  {
    "poem_id": 1525,
    "vorder": 64,
    "position": 1,
    "text": "به ایران نمانیم بسیار کس"
  },
  {
    "poem_id": 1525,
    "vorder": 65,
    "position": 0,
    "text": "تو ز ایدر برو گو بیارای جنگ"
  },
  {
    "poem_id": 1525,
    "vorder": 66,
    "position": 1,
    "text": "سخن چون شنیدی نباید درنگ"
  },
  {
    "poem_id": 1525,
    "vorder": 67,
    "position": 0,
    "text": "نه ایران خزر گشت و الیاس من"
  },
  {
    "poem_id": 1525,
    "vorder": 68,
    "position": 1,
    "text": "که سر برکشیدی از آن انجمن"
  },
  {
    "poem_id": 1525,
    "vorder": 69,
    "position": 0,
    "text": "چنین داد پاسخ که من جنگ را"
  },
  {
    "poem_id": 1525,
    "vorder": 70,
    "position": 1,
    "text": "بیازم همی هر سوی چنگ را"
  },
  {
    "poem_id": 1525,
    "vorder": 71,
    "position": 0,
    "text": "تو اکنون فرستاده‌ای بازگرد"
  },
  {
    "poem_id": 1525,
    "vorder": 72,
    "position": 1,
    "text": "بسازیم ناچار جای نبرد"
  },
  {
    "poem_id": 1525,
    "vorder": 73,
    "position": 0,
    "text": "ز قیصر چو بنشید فرخ زریر"
  },
  {
    "poem_id": 1525,
    "vorder": 74,
    "position": 1,
    "text": "غمی شد ز پاسخ فروماند دیر"
  }
]