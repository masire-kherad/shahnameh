[
  {
    "poem_id": 1715,
    "vorder": 1,
    "position": 0,
    "text": "بسی برنیامد برین روزگار"
  },
  {
    "poem_id": 1715,
    "vorder": 2,
    "position": 1,
    "text": "که سرو سهی چون گل آمد به بار"
  },
  {
    "poem_id": 1715,
    "vorder": 3,
    "position": 0,
    "text": "چو نه ماه بگذشت بر ماه‌روی"
  },
  {
    "poem_id": 1715,
    "vorder": 4,
    "position": 1,
    "text": "یکی کودک آمد به بالای اوی"
  },
  {
    "poem_id": 1715,
    "vorder": 5,
    "position": 0,
    "text": "تو گفتی که بازآمد اسفندیار"
  },
  {
    "poem_id": 1715,
    "vorder": 6,
    "position": 1,
    "text": "وگر نامدار اردشیر سوار"
  },
  {
    "poem_id": 1715,
    "vorder": 7,
    "position": 0,
    "text": "ورا نام شاپور کرد اورمزد"
  },
  {
    "poem_id": 1715,
    "vorder": 8,
    "position": 1,
    "text": "که سروی بد اندر میان فرزد"
  },
  {
    "poem_id": 1715,
    "vorder": 9,
    "position": 0,
    "text": "چنین تا برآمد برین هفت سال"
  },
  {
    "poem_id": 1715,
    "vorder": 10,
    "position": 1,
    "text": "ببود اورمزد از جهان بی‌همال"
  },
  {
    "poem_id": 1715,
    "vorder": 11,
    "position": 0,
    "text": "ز هرکس نهانش همی داشتند"
  },
  {
    "poem_id": 1715,
    "vorder": 12,
    "position": 1,
    "text": "به جایی ببازیش نگذاشتند"
  },
  {
    "poem_id": 1715,
    "vorder": 13,
    "position": 0,
    "text": "به نخچیر شد هفت روز اردشیر"
  },
  {
    "poem_id": 1715,
    "vorder": 14,
    "position": 1,
    "text": "بشد نیز شاپور نخچیرگیر"
  },
  {
    "poem_id": 1715,
    "vorder": 15,
    "position": 0,
    "text": "نهان اورمزد از میان گروه"
  },
  {
    "poem_id": 1715,
    "vorder": 16,
    "position": 1,
    "text": "بیامد کز آموختن شد ستوه"
  },
  {
    "poem_id": 1715,
    "vorder": 17,
    "position": 0,
    "text": "دوان شد به میدان شاه اردشیر"
  },
  {
    "poem_id": 1715,
    "vorder": 18,
    "position": 1,
    "text": "کمانی به یک دست و دیگر دو تیر"
  },
  {
    "poem_id": 1715,
    "vorder": 19,
    "position": 0,
    "text": "ابا کودکان چند و چوگان و گوی"
  },
  {
    "poem_id": 1715,
    "vorder": 20,
    "position": 1,
    "text": "به میدان شاه اندر آمد ز کوی"
  },
  {
    "poem_id": 1715,
    "vorder": 21,
    "position": 0,
    "text": "جهاندار هم در زمان با سپاه"
  },
  {
    "poem_id": 1715,
    "vorder": 22,
    "position": 1,
    "text": "به میدان بیامد ز نخچیرگاه"
  },
  {
    "poem_id": 1715,
    "vorder": 23,
    "position": 0,
    "text": "ابا موبدان موبد تیزویر"
  },
  {
    "poem_id": 1715,
    "vorder": 24,
    "position": 1,
    "text": "به نزدیک ایوان رسید اردشیر"
  },
  {
    "poem_id": 1715,
    "vorder": 25,
    "position": 0,
    "text": "بزد کودکی نیز چوگان ز راه"
  },
  {
    "poem_id": 1715,
    "vorder": 26,
    "position": 1,
    "text": "بشد گوی گردان به نزدیک شاه"
  },
  {
    "poem_id": 1715,
    "vorder": 27,
    "position": 0,
    "text": "نرفتند زیشان پس گوی کس"
  },
  {
    "poem_id": 1715,
    "vorder": 28,
    "position": 1,
    "text": "بماندند بر جای ناکام بس"
  },
  {
    "poem_id": 1715,
    "vorder": 29,
    "position": 0,
    "text": "دوان اورمزد از میانه برفت"
  },
  {
    "poem_id": 1715,
    "vorder": 30,
    "position": 1,
    "text": "به پیش جهاندار چون باد تفت"
  },
  {
    "poem_id": 1715,
    "vorder": 31,
    "position": 0,
    "text": "ز پیش نیا زود برداشت گوی"
  },
  {
    "poem_id": 1715,
    "vorder": 32,
    "position": 1,
    "text": "ازو گشت لشکر پر از گفت‌وگوی"
  },
  {
    "poem_id": 1715,
    "vorder": 33,
    "position": 0,
    "text": "ازان پس خروشی برآورد سخت"
  },
  {
    "poem_id": 1715,
    "vorder": 34,
    "position": 1,
    "text": "کزو خیره شد شاه پیروز بخت"
  },
  {
    "poem_id": 1715,
    "vorder": 35,
    "position": 0,
    "text": "به موبد چنین گفت کین پاک‌زاد"
  },
  {
    "poem_id": 1715,
    "vorder": 36,
    "position": 1,
    "text": "نگه کن که تا از که دارد نژاد"
  },
  {
    "poem_id": 1715,
    "vorder": 37,
    "position": 0,
    "text": "بپرسید موبد ندانست کس"
  },
  {
    "poem_id": 1715,
    "vorder": 38,
    "position": 1,
    "text": "همه خامشی برگزیدند و بس"
  },
  {
    "poem_id": 1715,
    "vorder": 39,
    "position": 0,
    "text": "به موبد چنین گفت پس شهریار"
  },
  {
    "poem_id": 1715,
    "vorder": 40,
    "position": 1,
    "text": "که بردارش از خاک و نزد من آر"
  },
  {
    "poem_id": 1715,
    "vorder": 41,
    "position": 0,
    "text": "بشد موبد و برگرفتش ز گرد"
  },
  {
    "poem_id": 1715,
    "vorder": 42,
    "position": 1,
    "text": "ببردش بر شاه آزادمرد"
  },
  {
    "poem_id": 1715,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت شاه این گرانمایه خرد"
  },
  {
    "poem_id": 1715,
    "vorder": 44,
    "position": 1,
    "text": "ترا از نژاد که باید شمرد"
  },
  {
    "poem_id": 1715,
    "vorder": 45,
    "position": 0,
    "text": "نترسید کودک به آواز گفت"
  },
  {
    "poem_id": 1715,
    "vorder": 46,
    "position": 1,
    "text": "که نام نژادم نباید نهفت"
  },
  {
    "poem_id": 1715,
    "vorder": 47,
    "position": 0,
    "text": "منم پور شاپور کو پور تست"
  },
  {
    "poem_id": 1715,
    "vorder": 48,
    "position": 1,
    "text": "ز فرزند مهرک نژاد درست"
  },
  {
    "poem_id": 1715,
    "vorder": 49,
    "position": 0,
    "text": "فروماند زان کار گیتی شگفت"
  },
  {
    "poem_id": 1715,
    "vorder": 50,
    "position": 1,
    "text": "بخندید و اندیشه اندر گرفت"
  },
  {
    "poem_id": 1715,
    "vorder": 51,
    "position": 0,
    "text": "بفرمود تا رفت شاپور پیش"
  },
  {
    "poem_id": 1715,
    "vorder": 52,
    "position": 1,
    "text": "به پرسش گرفتش ز اندازه بیش"
  },
  {
    "poem_id": 1715,
    "vorder": 53,
    "position": 0,
    "text": "بترسید شاپور آزادمرد"
  },
  {
    "poem_id": 1715,
    "vorder": 54,
    "position": 1,
    "text": "دلش گشت پردرد و رخساره زرد"
  },
  {
    "poem_id": 1715,
    "vorder": 55,
    "position": 0,
    "text": "بخندید زو نامور شهریار"
  },
  {
    "poem_id": 1715,
    "vorder": 56,
    "position": 1,
    "text": "بدو گفت فرزند پنهان مدار"
  },
  {
    "poem_id": 1715,
    "vorder": 57,
    "position": 0,
    "text": "پسر باید از هرک باشد رواست"
  },
  {
    "poem_id": 1715,
    "vorder": 58,
    "position": 1,
    "text": "که گویند کاین بچه پادشاست"
  },
  {
    "poem_id": 1715,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت شاپور نوشه بدی"
  },
  {
    "poem_id": 1715,
    "vorder": 60,
    "position": 1,
    "text": "جهان را به دیدار توشه بدی"
  },
  {
    "poem_id": 1715,
    "vorder": 61,
    "position": 0,
    "text": "ز پشت منست این و نام اورمزد"
  },
  {
    "poem_id": 1715,
    "vorder": 62,
    "position": 1,
    "text": "درخشنده چون لاله اندر فرزد"
  },
  {
    "poem_id": 1715,
    "vorder": 63,
    "position": 0,
    "text": "نهان داشتم چندش از شهریار"
  },
  {
    "poem_id": 1715,
    "vorder": 64,
    "position": 1,
    "text": "بدان تا برآید بر از میوه‌دار"
  },
  {
    "poem_id": 1715,
    "vorder": 65,
    "position": 0,
    "text": "گرانمایه از دختر مهرک است"
  },
  {
    "poem_id": 1715,
    "vorder": 66,
    "position": 1,
    "text": "ز پشت منست این مرا بی‌شکست"
  },
  {
    "poem_id": 1715,
    "vorder": 67,
    "position": 0,
    "text": "ز آب و ز چاه آن کجا رفته بود"
  },
  {
    "poem_id": 1715,
    "vorder": 68,
    "position": 1,
    "text": "پسر گفت و پرسید و چندی شنود"
  },
  {
    "poem_id": 1715,
    "vorder": 69,
    "position": 0,
    "text": "ز گفتار او شاد شد اردشیر"
  },
  {
    "poem_id": 1715,
    "vorder": 70,
    "position": 1,
    "text": "به ایوان خرامید خود با وزیر"
  },
  {
    "poem_id": 1715,
    "vorder": 71,
    "position": 0,
    "text": "گرفته دلاویز را بر کنار"
  },
  {
    "poem_id": 1715,
    "vorder": 72,
    "position": 1,
    "text": "ز ایوان سوی تخت شد شهریار"
  },
  {
    "poem_id": 1715,
    "vorder": 73,
    "position": 0,
    "text": "بیاراست زرین یکی زیرگاه"
  },
  {
    "poem_id": 1715,
    "vorder": 74,
    "position": 1,
    "text": "یکی طوق فرمود و زرین کلاه"
  },
  {
    "poem_id": 1715,
    "vorder": 75,
    "position": 0,
    "text": "سر خرد کودک بیاراستند"
  },
  {
    "poem_id": 1715,
    "vorder": 76,
    "position": 1,
    "text": "بس از گنج در و گهر خواستند"
  },
  {
    "poem_id": 1715,
    "vorder": 77,
    "position": 0,
    "text": "همی ریخت تا شد سرش ناپدید"
  },
  {
    "poem_id": 1715,
    "vorder": 78,
    "position": 1,
    "text": "تنش را نیا زان میان برکشید"
  },
  {
    "poem_id": 1715,
    "vorder": 79,
    "position": 0,
    "text": "بسی زر و گوهر به درویش داد"
  },
  {
    "poem_id": 1715,
    "vorder": 80,
    "position": 1,
    "text": "خردمند را خواسته بیش داد"
  },
  {
    "poem_id": 1715,
    "vorder": 81,
    "position": 0,
    "text": "به دیبا بیاراست آتشکده"
  },
  {
    "poem_id": 1715,
    "vorder": 82,
    "position": 1,
    "text": "هم ایوان نوروز و کاخ سده"
  },
  {
    "poem_id": 1715,
    "vorder": 83,
    "position": 0,
    "text": "یکی بزمگه ساخت با مهتران"
  },
  {
    "poem_id": 1715,
    "vorder": 84,
    "position": 1,
    "text": "نشستند هرجای رامشگران"
  },
  {
    "poem_id": 1715,
    "vorder": 85,
    "position": 0,
    "text": "چنین گفت با نامداران شهر"
  },
  {
    "poem_id": 1715,
    "vorder": 86,
    "position": 1,
    "text": "هرانکس که او از خرد داشت بهر"
  },
  {
    "poem_id": 1715,
    "vorder": 87,
    "position": 0,
    "text": "که از گفت دانا ستاره شمر"
  },
  {
    "poem_id": 1715,
    "vorder": 88,
    "position": 1,
    "text": "نباید که هرگز کند کس گذر"
  },
  {
    "poem_id": 1715,
    "vorder": 89,
    "position": 0,
    "text": "چنین گفته بد کید هندی که بخت"
  },
  {
    "poem_id": 1715,
    "vorder": 90,
    "position": 1,
    "text": "نگردد ترا ساز و خرم به تخت"
  },
  {
    "poem_id": 1715,
    "vorder": 91,
    "position": 0,
    "text": "نه کشور نه افسر نه گنج و سپاه"
  },
  {
    "poem_id": 1715,
    "vorder": 92,
    "position": 1,
    "text": "نه دیهیم شاهی نه فر کلاه"
  },
  {
    "poem_id": 1715,
    "vorder": 93,
    "position": 0,
    "text": "مگر تخمهٔ مهرک نوش‌زاد"
  },
  {
    "poem_id": 1715,
    "vorder": 94,
    "position": 1,
    "text": "بیامیزد آن دوده با ان نژاد"
  },
  {
    "poem_id": 1715,
    "vorder": 95,
    "position": 0,
    "text": "کنون سالیان اندر آمد به هشت"
  },
  {
    "poem_id": 1715,
    "vorder": 96,
    "position": 1,
    "text": "که جز به آرزو چرخ بر ما نگشت"
  },
  {
    "poem_id": 1715,
    "vorder": 97,
    "position": 0,
    "text": "چو شاپور رفت اندر آرام خویش"
  },
  {
    "poem_id": 1715,
    "vorder": 98,
    "position": 1,
    "text": "ز گیتی ندیده به جز کام خویش"
  },
  {
    "poem_id": 1715,
    "vorder": 99,
    "position": 0,
    "text": "زمین هفت کشور مرا گشت راست"
  },
  {
    "poem_id": 1715,
    "vorder": 100,
    "position": 1,
    "text": "دلم یافت از بخت چیزی که خواست"
  },
  {
    "poem_id": 1715,
    "vorder": 101,
    "position": 0,
    "text": "وزان پس بر کارداران اوی"
  },
  {
    "poem_id": 1715,
    "vorder": 102,
    "position": 1,
    "text": "شهنشاه کردند عنوان اوی"
  }
]