[
  {
    "poem_id": 52176,
    "vorder": 1,
    "position": 0,
    "text": "ازان دشت بهرام یل بنگرید"
  },
  {
    "poem_id": 52176,
    "vorder": 2,
    "position": 1,
    "text": "یکی کاخ پرمایه آمد پدید"
  },
  {
    "poem_id": 52176,
    "vorder": 3,
    "position": 0,
    "text": "بران کاخ بنهاد بهرام روی"
  },
  {
    "poem_id": 52176,
    "vorder": 4,
    "position": 1,
    "text": "همان گور پیش اندرون راه جوی"
  },
  {
    "poem_id": 52176,
    "vorder": 5,
    "position": 0,
    "text": "همی‌راند تا پیش آن کاخ اسب"
  },
  {
    "poem_id": 52176,
    "vorder": 6,
    "position": 1,
    "text": "پس پشت او بود ایزد گشسب"
  },
  {
    "poem_id": 52176,
    "vorder": 7,
    "position": 0,
    "text": "عنان تگاور بدو داد وگفت"
  },
  {
    "poem_id": 52176,
    "vorder": 8,
    "position": 1,
    "text": "که با تو همیشه خرد باد جفت"
  },
  {
    "poem_id": 52176,
    "vorder": 9,
    "position": 0,
    "text": "پیاده ز دهلیز کاخ اندرون"
  },
  {
    "poem_id": 52176,
    "vorder": 10,
    "position": 1,
    "text": "همی‌رفت بهرام بی‌رهنمون"
  },
  {
    "poem_id": 52176,
    "vorder": 11,
    "position": 0,
    "text": "زمانی بدر بود ایزد گشسب"
  },
  {
    "poem_id": 52176,
    "vorder": 12,
    "position": 1,
    "text": "گرفته بدست آن گرانمایه اسب"
  },
  {
    "poem_id": 52176,
    "vorder": 13,
    "position": 0,
    "text": "یلان سینه آمد پس او دوان"
  },
  {
    "poem_id": 52176,
    "vorder": 14,
    "position": 1,
    "text": "براسب تگاور ببسته میان"
  },
  {
    "poem_id": 52176,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت ایزد گشسب دلیر"
  },
  {
    "poem_id": 52176,
    "vorder": 16,
    "position": 1,
    "text": "که‌ای پرهنر نامبرد شیر"
  },
  {
    "poem_id": 52176,
    "vorder": 17,
    "position": 0,
    "text": "ببین تا کجا رفت سالار ما"
  },
  {
    "poem_id": 52176,
    "vorder": 18,
    "position": 1,
    "text": "سپهبد یل نامبردار ما"
  },
  {
    "poem_id": 52176,
    "vorder": 19,
    "position": 0,
    "text": "یلان سینه درکاخ بنهاد روی"
  },
  {
    "poem_id": 52176,
    "vorder": 20,
    "position": 1,
    "text": "دلی پر ز اندیشه سالار جوی"
  },
  {
    "poem_id": 52176,
    "vorder": 21,
    "position": 0,
    "text": "یکی طاق و ایوان فرخنده دید"
  },
  {
    "poem_id": 52176,
    "vorder": 22,
    "position": 1,
    "text": "کزان سان به ایران نه دید وشنید"
  },
  {
    "poem_id": 52176,
    "vorder": 23,
    "position": 0,
    "text": "نهاده بایوان او تخت زر"
  },
  {
    "poem_id": 52176,
    "vorder": 24,
    "position": 1,
    "text": "نشانده بهر پایه‌ای درگهر"
  },
  {
    "poem_id": 52176,
    "vorder": 25,
    "position": 0,
    "text": "بران تخت فرشی ز دیبای روم"
  },
  {
    "poem_id": 52176,
    "vorder": 26,
    "position": 1,
    "text": "همه پیکرش گوهر و زر بوم"
  },
  {
    "poem_id": 52176,
    "vorder": 27,
    "position": 0,
    "text": "نشسته برو بر زنی تاجدار"
  },
  {
    "poem_id": 52176,
    "vorder": 28,
    "position": 1,
    "text": "به بالا چو سرو و به رخ چون بهار"
  },
  {
    "poem_id": 52176,
    "vorder": 29,
    "position": 0,
    "text": "بر تخت زرین یکی زیرگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 30,
    "position": 1,
    "text": "نشسته برو پهلوان سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 31,
    "position": 0,
    "text": "فراوان پرستنده بر گرد تخت"
  },
  {
    "poem_id": 52176,
    "vorder": 32,
    "position": 1,
    "text": "بتان پری روی بیدار بخت"
  },
  {
    "poem_id": 52176,
    "vorder": 33,
    "position": 0,
    "text": "چو آن زن یلان سینه را دید گفت"
  },
  {
    "poem_id": 52176,
    "vorder": 34,
    "position": 1,
    "text": "پرستنده‌ای راکه‌ای خوب جفت"
  },
  {
    "poem_id": 52176,
    "vorder": 35,
    "position": 0,
    "text": "برو تیز و آن شیر دل را بگوی"
  },
  {
    "poem_id": 52176,
    "vorder": 36,
    "position": 1,
    "text": "که ایدر تو را آمدن نیست روی"
  },
  {
    "poem_id": 52176,
    "vorder": 37,
    "position": 0,
    "text": "همی‌باش نزدیک یاران خویش"
  },
  {
    "poem_id": 52176,
    "vorder": 38,
    "position": 1,
    "text": "هم اکنون بیادت بهرام پیش"
  },
  {
    "poem_id": 52176,
    "vorder": 39,
    "position": 0,
    "text": "بدین سان پیامش ز بهرام ده"
  },
  {
    "poem_id": 52176,
    "vorder": 40,
    "position": 1,
    "text": "دلش را به برگشتن آرام ده"
  },
  {
    "poem_id": 52176,
    "vorder": 41,
    "position": 0,
    "text": "همانگه پرستنده‌گان را به راه"
  },
  {
    "poem_id": 52176,
    "vorder": 42,
    "position": 1,
    "text": "ز ایوان برافگند نزد سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 43,
    "position": 0,
    "text": "که تا اسب گردان به آخر برند"
  },
  {
    "poem_id": 52176,
    "vorder": 44,
    "position": 1,
    "text": "پرآگند زینها همه بشمرند"
  },
  {
    "poem_id": 52176,
    "vorder": 45,
    "position": 0,
    "text": "درباغ بگشاد پالیزبان"
  },
  {
    "poem_id": 52176,
    "vorder": 46,
    "position": 1,
    "text": "بفرمان آن تا زه رخ میزبان"
  },
  {
    "poem_id": 52176,
    "vorder": 47,
    "position": 0,
    "text": "بیامد یکی مرد مهترپرست"
  },
  {
    "poem_id": 52176,
    "vorder": 48,
    "position": 1,
    "text": "بباغ از پی و واژ و برسم بدست"
  },
  {
    "poem_id": 52176,
    "vorder": 49,
    "position": 0,
    "text": "نهادند خوان گرد باغ اندرون"
  },
  {
    "poem_id": 52176,
    "vorder": 50,
    "position": 1,
    "text": "خورش ساختند ازگمانی فزون"
  },
  {
    "poem_id": 52176,
    "vorder": 51,
    "position": 0,
    "text": "چونان خورده شد اسب گردنگشان"
  },
  {
    "poem_id": 52176,
    "vorder": 52,
    "position": 1,
    "text": "ببردند پویان بجای نشان"
  },
  {
    "poem_id": 52176,
    "vorder": 53,
    "position": 0,
    "text": "بدان زن چوبرگشت بهرام گفت"
  },
  {
    "poem_id": 52176,
    "vorder": 54,
    "position": 1,
    "text": "که با تاج تو مشتری باد جفت"
  },
  {
    "poem_id": 52176,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت پیروزگر باش زن"
  },
  {
    "poem_id": 52176,
    "vorder": 56,
    "position": 1,
    "text": "همیشه شکیبا دل ورای زن"
  },
  {
    "poem_id": 52176,
    "vorder": 57,
    "position": 0,
    "text": "چوبهرام زان کاخ آمد برون"
  },
  {
    "poem_id": 52176,
    "vorder": 58,
    "position": 1,
    "text": "تو گفتی ببارید از چشم خون"
  },
  {
    "poem_id": 52176,
    "vorder": 59,
    "position": 0,
    "text": "منش را دگر کرد و پاسخ دگر"
  },
  {
    "poem_id": 52176,
    "vorder": 60,
    "position": 1,
    "text": "توگفتی بپروین برآورد سر"
  },
  {
    "poem_id": 52176,
    "vorder": 61,
    "position": 0,
    "text": "بیامد هم اندر پی نره گور"
  },
  {
    "poem_id": 52176,
    "vorder": 62,
    "position": 1,
    "text": "سپهبد پس اندر همی‌راند بور"
  },
  {
    "poem_id": 52176,
    "vorder": 63,
    "position": 0,
    "text": "چنین تا ازان بیشه آمد برون"
  },
  {
    "poem_id": 52176,
    "vorder": 64,
    "position": 1,
    "text": "همی‌بود بهرام را رهنمون"
  },
  {
    "poem_id": 52176,
    "vorder": 65,
    "position": 0,
    "text": "بشهر اندر آمد زنخچیرگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 66,
    "position": 1,
    "text": "ازان کار بگشاد لب برسپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 67,
    "position": 0,
    "text": "نگه کرد خراد برزین بدوی"
  },
  {
    "poem_id": 52176,
    "vorder": 68,
    "position": 1,
    "text": "چنین گفت کای مهتر راست گوی"
  },
  {
    "poem_id": 52176,
    "vorder": 69,
    "position": 0,
    "text": "بنخچیرگاه این شگفتی چه بود"
  },
  {
    "poem_id": 52176,
    "vorder": 70,
    "position": 1,
    "text": "که آنکس ندید و نه هرگز شنود"
  },
  {
    "poem_id": 52176,
    "vorder": 71,
    "position": 0,
    "text": "ورا پهلوان هیچ پاسخ نداد"
  },
  {
    "poem_id": 52176,
    "vorder": 72,
    "position": 1,
    "text": "دژم بود سر سوی ایوان نهاد"
  },
  {
    "poem_id": 52176,
    "vorder": 73,
    "position": 0,
    "text": "دگر روز چون سیمگون گشت راغ"
  },
  {
    "poem_id": 52176,
    "vorder": 74,
    "position": 1,
    "text": "پدید آمد آن زرد رخشان چراغ"
  },
  {
    "poem_id": 52176,
    "vorder": 75,
    "position": 0,
    "text": "بگسترد فرشی ز دیبای چین"
  },
  {
    "poem_id": 52176,
    "vorder": 76,
    "position": 1,
    "text": "تو گفتی مگر آسمان شد زمین"
  },
  {
    "poem_id": 52176,
    "vorder": 77,
    "position": 0,
    "text": "همه کاخ کرسی زرین نهاد"
  },
  {
    "poem_id": 52176,
    "vorder": 78,
    "position": 1,
    "text": "ز دیبای زربفت بالین نهاد"
  },
  {
    "poem_id": 52176,
    "vorder": 79,
    "position": 0,
    "text": "نهادند زرین یکی زیرگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 80,
    "position": 1,
    "text": "نشسته برو پهلوان سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 81,
    "position": 0,
    "text": "نشستی بیاراست شاهنشهی"
  },
  {
    "poem_id": 52176,
    "vorder": 82,
    "position": 1,
    "text": "نهاده به سر بر کلاه مهی"
  },
  {
    "poem_id": 52176,
    "vorder": 83,
    "position": 0,
    "text": "نگه کرد کارش دبیر بزرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 84,
    "position": 1,
    "text": "بدانست کو شد دلیر و سترگ"
  },
  {
    "poem_id": 52176,
    "vorder": 85,
    "position": 0,
    "text": "چو نزدیک خراد برزین رسید"
  },
  {
    "poem_id": 52176,
    "vorder": 86,
    "position": 1,
    "text": "بگفت آنچ دانست و دید و شنید"
  },
  {
    "poem_id": 52176,
    "vorder": 87,
    "position": 0,
    "text": "چو خراد برزین شنید این سخن"
  },
  {
    "poem_id": 52176,
    "vorder": 88,
    "position": 1,
    "text": "بدانست کان رنجها شد کهن"
  },
  {
    "poem_id": 52176,
    "vorder": 89,
    "position": 0,
    "text": "چنین گفت پس با گرامی دبیر"
  },
  {
    "poem_id": 52176,
    "vorder": 90,
    "position": 1,
    "text": "که کاری چنین بر دل آسان مگیر"
  },
  {
    "poem_id": 52176,
    "vorder": 91,
    "position": 0,
    "text": "نباید گشاد اندرین کارلب"
  },
  {
    "poem_id": 52176,
    "vorder": 92,
    "position": 1,
    "text": "بر شاه باید شدن تیره شب"
  },
  {
    "poem_id": 52176,
    "vorder": 93,
    "position": 0,
    "text": "چوبهرام را دل پراز تاج گشت"
  },
  {
    "poem_id": 52176,
    "vorder": 94,
    "position": 1,
    "text": "همان تخت زیراندرش عاج گشت"
  },
  {
    "poem_id": 52176,
    "vorder": 95,
    "position": 0,
    "text": "زدند اندران کار هرگونه رای"
  },
  {
    "poem_id": 52176,
    "vorder": 96,
    "position": 1,
    "text": "همه چاره از رفتن آمد بجای"
  },
  {
    "poem_id": 52176,
    "vorder": 97,
    "position": 0,
    "text": "چورنگ گریز اندر آمیختند"
  },
  {
    "poem_id": 52176,
    "vorder": 98,
    "position": 1,
    "text": "شب تیره از بلخ بگریختند"
  },
  {
    "poem_id": 52176,
    "vorder": 99,
    "position": 0,
    "text": "سپهبد چو آگه شد ازکارشان"
  },
  {
    "poem_id": 52176,
    "vorder": 100,
    "position": 1,
    "text": "ز روشن روانهای بیدارشان"
  },
  {
    "poem_id": 52176,
    "vorder": 101,
    "position": 0,
    "text": "یلان سینه را گفت با صد سوار"
  },
  {
    "poem_id": 52176,
    "vorder": 102,
    "position": 1,
    "text": "بتاز از پس این دو ناهوشیار"
  },
  {
    "poem_id": 52176,
    "vorder": 103,
    "position": 0,
    "text": "بیامد از آنجا بکردار گرد"
  },
  {
    "poem_id": 52176,
    "vorder": 104,
    "position": 1,
    "text": "ابا او دلیران روز نبرد"
  },
  {
    "poem_id": 52176,
    "vorder": 105,
    "position": 0,
    "text": "همی‌راند تا در دبیر بزرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 106,
    "position": 1,
    "text": "رسید و برآشفت برسان گرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 107,
    "position": 0,
    "text": "ازو چیز بستد همه هرچ داشت"
  },
  {
    "poem_id": 52176,
    "vorder": 108,
    "position": 1,
    "text": "ببند گرانش ز ره بازگشت"
  },
  {
    "poem_id": 52176,
    "vorder": 109,
    "position": 0,
    "text": "به نزدیک بهرام بردش ز راه"
  },
  {
    "poem_id": 52176,
    "vorder": 110,
    "position": 1,
    "text": "بدان تاکند بیگنه را تباه"
  },
  {
    "poem_id": 52176,
    "vorder": 111,
    "position": 0,
    "text": "بدو گفت بهرام کای دیوساز"
  },
  {
    "poem_id": 52176,
    "vorder": 112,
    "position": 1,
    "text": "چرارفتی از پیش من بی‌جواز"
  },
  {
    "poem_id": 52176,
    "vorder": 113,
    "position": 0,
    "text": "چنین داد پاسخ که ای پهلوان"
  },
  {
    "poem_id": 52176,
    "vorder": 114,
    "position": 1,
    "text": "مراکرد خراد برزین نوان"
  },
  {
    "poem_id": 52176,
    "vorder": 115,
    "position": 0,
    "text": "همی‌گفت کایدر بدن روی نیست"
  },
  {
    "poem_id": 52176,
    "vorder": 116,
    "position": 1,
    "text": "درنگ تو جز کام بدگوی نیست"
  },
  {
    "poem_id": 52176,
    "vorder": 117,
    "position": 0,
    "text": "مرا و تو را بیم کشتن بود"
  },
  {
    "poem_id": 52176,
    "vorder": 118,
    "position": 1,
    "text": "ز ایدر مگر بازگشتن بود"
  },
  {
    "poem_id": 52176,
    "vorder": 119,
    "position": 0,
    "text": "چوبهرام را پهلوان سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 120,
    "position": 1,
    "text": "ببردند آب اندران بارگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 121,
    "position": 0,
    "text": "بدو گفت بهرام شاید بدن"
  },
  {
    "poem_id": 52176,
    "vorder": 122,
    "position": 1,
    "text": "بنیک وببد رای باید زدن"
  },
  {
    "poem_id": 52176,
    "vorder": 123,
    "position": 0,
    "text": "زیانی که بودش همه باز داد"
  },
  {
    "poem_id": 52176,
    "vorder": 124,
    "position": 1,
    "text": "هم از گنج خویشش بسی ساز داد"
  },
  {
    "poem_id": 52176,
    "vorder": 125,
    "position": 0,
    "text": "بدو گفت زان پس که تو ساز خویش"
  },
  {
    "poem_id": 52176,
    "vorder": 126,
    "position": 1,
    "text": "بژرفی نگه دار و مگریز بیش"
  },
  {
    "poem_id": 52176,
    "vorder": 127,
    "position": 0,
    "text": "وزین روی خراد برزین نهان"
  },
  {
    "poem_id": 52176,
    "vorder": 128,
    "position": 1,
    "text": "همی‌تاخت تا نزد شاه جهان"
  },
  {
    "poem_id": 52176,
    "vorder": 129,
    "position": 0,
    "text": "همه گفتنیها بدوبازگفت"
  },
  {
    "poem_id": 52176,
    "vorder": 130,
    "position": 1,
    "text": "همه رازها برگشاد از نهفت"
  },
  {
    "poem_id": 52176,
    "vorder": 131,
    "position": 0,
    "text": "چنین تا ازان بیشه و مرغزار"
  },
  {
    "poem_id": 52176,
    "vorder": 132,
    "position": 1,
    "text": "یکایک همی‌گفت با شهریار"
  },
  {
    "poem_id": 52176,
    "vorder": 133,
    "position": 0,
    "text": "وزان رفتن گور و آن راه تنگ"
  },
  {
    "poem_id": 52176,
    "vorder": 134,
    "position": 1,
    "text": "ز آرام بهرام و چندین درنگ"
  },
  {
    "poem_id": 52176,
    "vorder": 135,
    "position": 0,
    "text": "وزان رفتن کاخ گوهرنگار"
  },
  {
    "poem_id": 52176,
    "vorder": 136,
    "position": 1,
    "text": "پرستندگان و زن تاجدار"
  },
  {
    "poem_id": 52176,
    "vorder": 137,
    "position": 0,
    "text": "یکایک بگفت آن کجا دیده بود"
  },
  {
    "poem_id": 52176,
    "vorder": 138,
    "position": 1,
    "text": "دگر هرچ‌ازکار پرسیده بود"
  },
  {
    "poem_id": 52176,
    "vorder": 139,
    "position": 0,
    "text": "ازان تاجورماند اندر شگفت"
  },
  {
    "poem_id": 52176,
    "vorder": 140,
    "position": 1,
    "text": "سخن هرچ بشنید در دل گرفت"
  },
  {
    "poem_id": 52176,
    "vorder": 141,
    "position": 0,
    "text": "چوگفتار موبد بیاد آمدش"
  },
  {
    "poem_id": 52176,
    "vorder": 142,
    "position": 1,
    "text": "ز دل بر یکی سرد باد آمدش"
  },
  {
    "poem_id": 52176,
    "vorder": 143,
    "position": 0,
    "text": "همان نیز گفتار آن فال‌گوی"
  },
  {
    "poem_id": 52176,
    "vorder": 144,
    "position": 1,
    "text": "که گفت او بپیچد ز تخت تو روی"
  },
  {
    "poem_id": 52176,
    "vorder": 145,
    "position": 0,
    "text": "سبک موبد موبدان را بخواند"
  },
  {
    "poem_id": 52176,
    "vorder": 146,
    "position": 1,
    "text": "بران جای خراد برزین نشاند"
  },
  {
    "poem_id": 52176,
    "vorder": 147,
    "position": 0,
    "text": "بخراد برزین چنین گفت شاه"
  },
  {
    "poem_id": 52176,
    "vorder": 148,
    "position": 1,
    "text": "که بگشای لب تا چه دیدی به راه"
  },
  {
    "poem_id": 52176,
    "vorder": 149,
    "position": 0,
    "text": "بفرمان هرمز زبان برگشاد"
  },
  {
    "poem_id": 52176,
    "vorder": 150,
    "position": 1,
    "text": "سخنها یکایک همه کرد یاد"
  },
  {
    "poem_id": 52176,
    "vorder": 151,
    "position": 0,
    "text": "بدوشاه گفت این چه شاید بدن"
  },
  {
    "poem_id": 52176,
    "vorder": 152,
    "position": 1,
    "text": "همه داستانها بباید زدن"
  },
  {
    "poem_id": 52176,
    "vorder": 153,
    "position": 0,
    "text": "که در بیشه گوری بود رهنمای"
  },
  {
    "poem_id": 52176,
    "vorder": 154,
    "position": 1,
    "text": "میان بیابان بی‌بر سرای"
  },
  {
    "poem_id": 52176,
    "vorder": 155,
    "position": 0,
    "text": "برتخت زرین یکی تاجدار"
  },
  {
    "poem_id": 52176,
    "vorder": 156,
    "position": 1,
    "text": "پرستار پیش اندرون شاهوار"
  },
  {
    "poem_id": 52176,
    "vorder": 157,
    "position": 0,
    "text": "بکردار خوابیست این داستان"
  },
  {
    "poem_id": 52176,
    "vorder": 158,
    "position": 1,
    "text": "که برخواند از گفته باستان"
  },
  {
    "poem_id": 52176,
    "vorder": 159,
    "position": 0,
    "text": "چنین گفت موبد بشاه جهان"
  },
  {
    "poem_id": 52176,
    "vorder": 160,
    "position": 1,
    "text": "که آن گور دیوی بود درنهان"
  },
  {
    "poem_id": 52176,
    "vorder": 161,
    "position": 0,
    "text": "چوبهرام را خواند از راستی"
  },
  {
    "poem_id": 52176,
    "vorder": 162,
    "position": 1,
    "text": "پدید آمد اندر دلش کاستی"
  },
  {
    "poem_id": 52176,
    "vorder": 163,
    "position": 0,
    "text": "همان کاخ جادوستانی شناس"
  },
  {
    "poem_id": 52176,
    "vorder": 164,
    "position": 1,
    "text": "بدان تخت جادو زنی ناسپاس"
  },
  {
    "poem_id": 52176,
    "vorder": 165,
    "position": 0,
    "text": "که بهرام را آن سترگی نمود"
  },
  {
    "poem_id": 52176,
    "vorder": 166,
    "position": 1,
    "text": "چنان تاج وتخت بزرگی نمود"
  },
  {
    "poem_id": 52176,
    "vorder": 167,
    "position": 0,
    "text": "چوبرگشت ازو پرمنش گشت ومست"
  },
  {
    "poem_id": 52176,
    "vorder": 168,
    "position": 1,
    "text": "چنان دان که هرگز نیاید بدست"
  },
  {
    "poem_id": 52176,
    "vorder": 169,
    "position": 0,
    "text": "کنون چاره‌ای کن که تا آن سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 170,
    "position": 1,
    "text": "ز بلخ آوری سوی این بارگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 171,
    "position": 0,
    "text": "پشیمان شد از دوکدان شهریار"
  },
  {
    "poem_id": 52176,
    "vorder": 172,
    "position": 1,
    "text": "وزان پنبه وجامهٔ نابکار"
  },
  {
    "poem_id": 52176,
    "vorder": 173,
    "position": 0,
    "text": "برین بر نیامد بسی روزگار"
  },
  {
    "poem_id": 52176,
    "vorder": 174,
    "position": 1,
    "text": "که آمد کس از پهلوان سوار"
  },
  {
    "poem_id": 52176,
    "vorder": 175,
    "position": 0,
    "text": "یکی سله پرخنجری داشته"
  },
  {
    "poem_id": 52176,
    "vorder": 176,
    "position": 1,
    "text": "یکایک سرتیغ برگاشته"
  },
  {
    "poem_id": 52176,
    "vorder": 177,
    "position": 0,
    "text": "بیاورد وبنهاد درپیش شاه"
  },
  {
    "poem_id": 52176,
    "vorder": 178,
    "position": 1,
    "text": "همی‌کرد شاه اندر آهن نگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 179,
    "position": 0,
    "text": "بفرمود تا تیغها بشکنند"
  },
  {
    "poem_id": 52176,
    "vorder": 180,
    "position": 1,
    "text": "دران سلهٔ نابکار افگنند"
  },
  {
    "poem_id": 52176,
    "vorder": 181,
    "position": 0,
    "text": "فرستاد نزدیک بهرام باز"
  },
  {
    "poem_id": 52176,
    "vorder": 182,
    "position": 1,
    "text": "سخنهای پیکار و رزم دراز"
  },
  {
    "poem_id": 52176,
    "vorder": 183,
    "position": 0,
    "text": "بدو نیمه کرده نهاده‌بجای"
  },
  {
    "poem_id": 52176,
    "vorder": 184,
    "position": 1,
    "text": "پراندیشه شد مرد برگشته رای"
  },
  {
    "poem_id": 52176,
    "vorder": 185,
    "position": 0,
    "text": "فرستاد وایرانیان را بخواند"
  },
  {
    "poem_id": 52176,
    "vorder": 186,
    "position": 1,
    "text": "همه گرد آن سله اندرنشاند"
  },
  {
    "poem_id": 52176,
    "vorder": 187,
    "position": 0,
    "text": "چنین گفت کین هدیهٔ شهریار"
  },
  {
    "poem_id": 52176,
    "vorder": 188,
    "position": 1,
    "text": "ببینید واین را مدارید خوار"
  },
  {
    "poem_id": 52176,
    "vorder": 189,
    "position": 0,
    "text": "پراندیشه شد لشکر ازکار شاه"
  },
  {
    "poem_id": 52176,
    "vorder": 190,
    "position": 1,
    "text": "به گفتار آن پهلوان سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 191,
    "position": 0,
    "text": "که یک روزمان هدیه شهریار"
  },
  {
    "poem_id": 52176,
    "vorder": 192,
    "position": 1,
    "text": "بود دوک وآن جامهٔ پرنگار"
  },
  {
    "poem_id": 52176,
    "vorder": 193,
    "position": 0,
    "text": "شکسته دگر باره خنجر بود"
  },
  {
    "poem_id": 52176,
    "vorder": 194,
    "position": 1,
    "text": "ز زخم و ز دشنام بتر بود"
  },
  {
    "poem_id": 52176,
    "vorder": 195,
    "position": 0,
    "text": "چنین شاه برگاه هرگز مباد"
  },
  {
    "poem_id": 52176,
    "vorder": 196,
    "position": 1,
    "text": "نه آنکس که گیرد ازو نیز یاد"
  },
  {
    "poem_id": 52176,
    "vorder": 197,
    "position": 0,
    "text": "اگر نیز بهرام پورگشسب"
  },
  {
    "poem_id": 52176,
    "vorder": 198,
    "position": 1,
    "text": "بران خاک درگاه بگذارد اسب"
  },
  {
    "poem_id": 52176,
    "vorder": 199,
    "position": 0,
    "text": "زبهرام مه مغز بادا مه پوست"
  },
  {
    "poem_id": 52176,
    "vorder": 200,
    "position": 1,
    "text": "نه آن کم بها را که بهرام ازوست"
  },
  {
    "poem_id": 52176,
    "vorder": 201,
    "position": 0,
    "text": "سپهبد چو گفتار ایشان شنید"
  },
  {
    "poem_id": 52176,
    "vorder": 202,
    "position": 1,
    "text": "دل لشکر از تاجور خسته دید"
  },
  {
    "poem_id": 52176,
    "vorder": 203,
    "position": 0,
    "text": "بلشکر چنین گفت پس پهلوان"
  },
  {
    "poem_id": 52176,
    "vorder": 204,
    "position": 1,
    "text": "که بیدار باشید و روشن روان"
  },
  {
    "poem_id": 52176,
    "vorder": 205,
    "position": 0,
    "text": "که خراد برزین برشهریار"
  },
  {
    "poem_id": 52176,
    "vorder": 206,
    "position": 1,
    "text": "سخنهای پوشیده کردآشکار"
  },
  {
    "poem_id": 52176,
    "vorder": 207,
    "position": 0,
    "text": "کنون یک بیک چارهٔ جان کنید"
  },
  {
    "poem_id": 52176,
    "vorder": 208,
    "position": 1,
    "text": "همه بامن امروز پیمان کنید"
  },
  {
    "poem_id": 52176,
    "vorder": 209,
    "position": 0,
    "text": "مگر کس فرستم زلشکر به راه"
  },
  {
    "poem_id": 52176,
    "vorder": 210,
    "position": 1,
    "text": "که دارند ما را زلشکر نگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 211,
    "position": 0,
    "text": "وگرنه مرا روز برگشته گیر"
  },
  {
    "poem_id": 52176,
    "vorder": 212,
    "position": 1,
    "text": "سپه رایکایک همه کشته گیر"
  },
  {
    "poem_id": 52176,
    "vorder": 213,
    "position": 0,
    "text": "بگفت این وخود ساز دیگر گرفت"
  },
  {
    "poem_id": 52176,
    "vorder": 214,
    "position": 1,
    "text": "نگه کن کنون تا بمانی شگفت"
  },
  {
    "poem_id": 52176,
    "vorder": 215,
    "position": 0,
    "text": "پراگند بر گرد کشور سوار"
  },
  {
    "poem_id": 52176,
    "vorder": 216,
    "position": 1,
    "text": "بدان تا مگر نامه شهریار"
  },
  {
    "poem_id": 52176,
    "vorder": 217,
    "position": 0,
    "text": "بیاید به نزدیک ایرانیان"
  },
  {
    "poem_id": 52176,
    "vorder": 218,
    "position": 1,
    "text": "ببندند پیکار وکین را میان"
  },
  {
    "poem_id": 52176,
    "vorder": 219,
    "position": 0,
    "text": "برین نیز بگذشت یک روزگار"
  },
  {
    "poem_id": 52176,
    "vorder": 220,
    "position": 1,
    "text": "نخواندند کس نامه شهریار"
  },
  {
    "poem_id": 52176,
    "vorder": 221,
    "position": 0,
    "text": "ازان پس گرانمایگان را بخواند"
  },
  {
    "poem_id": 52176,
    "vorder": 222,
    "position": 1,
    "text": "بسی رازها پیش ایشان براند"
  },
  {
    "poem_id": 52176,
    "vorder": 223,
    "position": 0,
    "text": "چوهمدان گشسب ودبیر بزرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 224,
    "position": 1,
    "text": "یلان سینه آن نامدار سترگ"
  },
  {
    "poem_id": 52176,
    "vorder": 225,
    "position": 0,
    "text": "چوبهرام گرد آن سیاوش نژاد"
  },
  {
    "poem_id": 52176,
    "vorder": 226,
    "position": 1,
    "text": "چوپیدا گشسب آن خردمند وراد"
  },
  {
    "poem_id": 52176,
    "vorder": 227,
    "position": 0,
    "text": "همی رای زد با چنین مهتران"
  },
  {
    "poem_id": 52176,
    "vorder": 228,
    "position": 1,
    "text": "که بودند شیران کنداوران"
  },
  {
    "poem_id": 52176,
    "vorder": 229,
    "position": 0,
    "text": "چنین گفت پس پهلوان سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 230,
    "position": 1,
    "text": "بدان لشکر تیزگم کرده راه"
  },
  {
    "poem_id": 52176,
    "vorder": 231,
    "position": 0,
    "text": "که‌ای نامداران گردن فراز"
  },
  {
    "poem_id": 52176,
    "vorder": 232,
    "position": 1,
    "text": "برای شما هرکسی را نیاز"
  },
  {
    "poem_id": 52176,
    "vorder": 233,
    "position": 0,
    "text": "ز ما مهتر آزرده شد بی‌گناه"
  },
  {
    "poem_id": 52176,
    "vorder": 234,
    "position": 1,
    "text": "چنین سربپیچید زآیین وراه"
  },
  {
    "poem_id": 52176,
    "vorder": 235,
    "position": 0,
    "text": "چه سازید ودرمان این کارچیست"
  },
  {
    "poem_id": 52176,
    "vorder": 236,
    "position": 1,
    "text": "نباید که برخسته باید گریست"
  },
  {
    "poem_id": 52176,
    "vorder": 237,
    "position": 0,
    "text": "هرآنکس که پوشید درد ازپزشک"
  },
  {
    "poem_id": 52176,
    "vorder": 238,
    "position": 1,
    "text": "زمژگان فروریخت خونین سرشک"
  },
  {
    "poem_id": 52176,
    "vorder": 239,
    "position": 0,
    "text": "زدانندگان گر بپوشیم راز"
  },
  {
    "poem_id": 52176,
    "vorder": 240,
    "position": 1,
    "text": "شود کارآسان بما بر دراز"
  },
  {
    "poem_id": 52176,
    "vorder": 241,
    "position": 0,
    "text": "کنون دردمندیم اندرجهان"
  },
  {
    "poem_id": 52176,
    "vorder": 242,
    "position": 1,
    "text": "بداننده گوییم یکسر نهان"
  },
  {
    "poem_id": 52176,
    "vorder": 243,
    "position": 0,
    "text": "برفتیم ز ایران چنین کینه خواه"
  },
  {
    "poem_id": 52176,
    "vorder": 244,
    "position": 1,
    "text": "بدین مایه لشکر بفرمان شاه"
  },
  {
    "poem_id": 52176,
    "vorder": 245,
    "position": 0,
    "text": "ازین بیش لشکر نبیند کسی"
  },
  {
    "poem_id": 52176,
    "vorder": 246,
    "position": 1,
    "text": "وگر چند ماند بگیتی بسی"
  },
  {
    "poem_id": 52176,
    "vorder": 247,
    "position": 0,
    "text": "چوپرمودهٔ گرد با ساوه شاه"
  },
  {
    "poem_id": 52176,
    "vorder": 248,
    "position": 1,
    "text": "اگر سوی ایران کشیدی سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 249,
    "position": 0,
    "text": "نیرزید ایران بیک مهره موم"
  },
  {
    "poem_id": 52176,
    "vorder": 250,
    "position": 1,
    "text": "وزان پس همی‌داشت آهنگ روم"
  },
  {
    "poem_id": 52176,
    "vorder": 251,
    "position": 0,
    "text": "بپرموده و ساوه شاه آن رسید"
  },
  {
    "poem_id": 52176,
    "vorder": 252,
    "position": 1,
    "text": "که کس درجهان آن شگفتی ندید"
  },
  {
    "poem_id": 52176,
    "vorder": 253,
    "position": 0,
    "text": "اگر چه فراوان کشیدیم رنج"
  },
  {
    "poem_id": 52176,
    "vorder": 254,
    "position": 1,
    "text": "نه شان پیل ماندیم زان پس نه گنج"
  },
  {
    "poem_id": 52176,
    "vorder": 255,
    "position": 0,
    "text": "بنوی یکی گنج بنهاد شاه"
  },
  {
    "poem_id": 52176,
    "vorder": 256,
    "position": 1,
    "text": "توانگر شد آشفته شد بر سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 257,
    "position": 0,
    "text": "کنون چارهٔ دام او چون کنیم"
  },
  {
    "poem_id": 52176,
    "vorder": 258,
    "position": 1,
    "text": "که آسان سر از بند بیرون کنیم"
  },
  {
    "poem_id": 52176,
    "vorder": 259,
    "position": 0,
    "text": "شهنشاه راکارهاساختست"
  },
  {
    "poem_id": 52176,
    "vorder": 260,
    "position": 1,
    "text": "وزین چاره بی‌رنج پرداختست"
  },
  {
    "poem_id": 52176,
    "vorder": 261,
    "position": 0,
    "text": "شما هریکی چارهٔ جان کنید"
  },
  {
    "poem_id": 52176,
    "vorder": 262,
    "position": 1,
    "text": "بدین خستگی تاچه درمان کنید"
  },
  {
    "poem_id": 52176,
    "vorder": 263,
    "position": 0,
    "text": "من از راز پردخته کردم دلم"
  },
  {
    "poem_id": 52176,
    "vorder": 264,
    "position": 1,
    "text": "زتیمارجان را همی‌بگسلم"
  },
  {
    "poem_id": 52176,
    "vorder": 265,
    "position": 0,
    "text": "پس پردهٔ نامور پهلوان"
  },
  {
    "poem_id": 52176,
    "vorder": 266,
    "position": 1,
    "text": "یکی خواهرش بود روشن روان"
  },
  {
    "poem_id": 52176,
    "vorder": 267,
    "position": 0,
    "text": "خردمند راگردیه نام بود"
  },
  {
    "poem_id": 52176,
    "vorder": 268,
    "position": 1,
    "text": "دلارام وانجام بهرام بود"
  },
  {
    "poem_id": 52176,
    "vorder": 269,
    "position": 0,
    "text": "چواز پرده گفت برادر شنید"
  },
  {
    "poem_id": 52176,
    "vorder": 270,
    "position": 1,
    "text": "برآشفت وز کین دلش بردمید"
  },
  {
    "poem_id": 52176,
    "vorder": 271,
    "position": 0,
    "text": "بران انجمن شد سری پرسخن"
  },
  {
    "poem_id": 52176,
    "vorder": 272,
    "position": 1,
    "text": "زبان پر ز گفتارهای کهن"
  },
  {
    "poem_id": 52176,
    "vorder": 273,
    "position": 0,
    "text": "برادر چو آواز خواهر شنید"
  },
  {
    "poem_id": 52176,
    "vorder": 274,
    "position": 1,
    "text": "زگفتار وپاسخ فرو آرمید"
  },
  {
    "poem_id": 52176,
    "vorder": 275,
    "position": 0,
    "text": "چنان هم زگفتار ایرانیان"
  },
  {
    "poem_id": 52176,
    "vorder": 276,
    "position": 1,
    "text": "بماندند یکسر زبیم زیان"
  },
  {
    "poem_id": 52176,
    "vorder": 277,
    "position": 0,
    "text": "چنین گفت پس گردیه با سپاه"
  },
  {
    "poem_id": 52176,
    "vorder": 278,
    "position": 1,
    "text": "که‌ای نامداران جوینده راه"
  },
  {
    "poem_id": 52176,
    "vorder": 279,
    "position": 0,
    "text": "زگفتار خامش چرا ماندید"
  },
  {
    "poem_id": 52176,
    "vorder": 280,
    "position": 1,
    "text": "چنین از جگر خون برافشاندید"
  },
  {
    "poem_id": 52176,
    "vorder": 281,
    "position": 0,
    "text": "ز ایران سرانید وجنگ‌آوران"
  },
  {
    "poem_id": 52176,
    "vorder": 282,
    "position": 1,
    "text": "خردمند ودانا وافسونگران"
  },
  {
    "poem_id": 52176,
    "vorder": 283,
    "position": 0,
    "text": "چه بینید یکسر به کار اندرون"
  },
  {
    "poem_id": 52176,
    "vorder": 284,
    "position": 1,
    "text": "چه بازی نهید اندرین دشت خون"
  },
  {
    "poem_id": 52176,
    "vorder": 285,
    "position": 0,
    "text": "چنین گفت ایزد گشسب سوار"
  },
  {
    "poem_id": 52176,
    "vorder": 286,
    "position": 1,
    "text": "که‌ای ازگرانمایگان یادگار"
  },
  {
    "poem_id": 52176,
    "vorder": 287,
    "position": 0,
    "text": "زبانهای ماگر شود تیغ نیز"
  },
  {
    "poem_id": 52176,
    "vorder": 288,
    "position": 1,
    "text": "زدریای رای تو گیرد گریز"
  },
  {
    "poem_id": 52176,
    "vorder": 289,
    "position": 0,
    "text": "همه کارهای شما ایزدیست"
  },
  {
    "poem_id": 52176,
    "vorder": 290,
    "position": 1,
    "text": "زمردی و ز دانش و بخردیست"
  },
  {
    "poem_id": 52176,
    "vorder": 291,
    "position": 0,
    "text": "نباید که رای پلنگ آوریم"
  },
  {
    "poem_id": 52176,
    "vorder": 292,
    "position": 1,
    "text": "که با هرکسی رای جنگ آوریم"
  },
  {
    "poem_id": 52176,
    "vorder": 293,
    "position": 0,
    "text": "مجویید ازین پس کس ازمن سخن"
  },
  {
    "poem_id": 52176,
    "vorder": 294,
    "position": 1,
    "text": "کزین باره‌ام پاسخ آمد ببن"
  },
  {
    "poem_id": 52176,
    "vorder": 295,
    "position": 0,
    "text": "اگر جنگ سازید یاری کنیم"
  },
  {
    "poem_id": 52176,
    "vorder": 296,
    "position": 1,
    "text": "به پیش سواران سواری کنیم"
  },
  {
    "poem_id": 52176,
    "vorder": 297,
    "position": 0,
    "text": "چوخشنود باشد ز من پهلوان"
  },
  {
    "poem_id": 52176,
    "vorder": 298,
    "position": 1,
    "text": "برآنم که جاوید مانم جوان"
  },
  {
    "poem_id": 52176,
    "vorder": 299,
    "position": 0,
    "text": "چوبهرام بشنید گفتار اوی"
  },
  {
    "poem_id": 52176,
    "vorder": 300,
    "position": 1,
    "text": "میانجی همی‌دید کردار اوی"
  },
  {
    "poem_id": 52176,
    "vorder": 301,
    "position": 0,
    "text": "ازان پس یلان سینه را دید وگفت"
  },
  {
    "poem_id": 52176,
    "vorder": 302,
    "position": 1,
    "text": "که اکنون چه داری سخن درنهفت"
  },
  {
    "poem_id": 52176,
    "vorder": 303,
    "position": 0,
    "text": "یلان سینه گفت ای سپهدار گرد"
  },
  {
    "poem_id": 52176,
    "vorder": 304,
    "position": 1,
    "text": "هرآنکس که اوراه یزدان سپرد"
  },
  {
    "poem_id": 52176,
    "vorder": 305,
    "position": 0,
    "text": "چو پیروزی و فرهی یابد اوی"
  },
  {
    "poem_id": 52176,
    "vorder": 306,
    "position": 1,
    "text": "بسوی بدی هیچ‌نشتابد اوی"
  },
  {
    "poem_id": 52176,
    "vorder": 307,
    "position": 0,
    "text": "که آن آفرین باز نفرین شود"
  },
  {
    "poem_id": 52176,
    "vorder": 308,
    "position": 1,
    "text": "وزو چرخ گردنده پرکین شود"
  },
  {
    "poem_id": 52176,
    "vorder": 309,
    "position": 0,
    "text": "چو یزدان تو را فرهی داد و بخت"
  },
  {
    "poem_id": 52176,
    "vorder": 310,
    "position": 1,
    "text": "همه لشکر گنج با تاج وتخت"
  },
  {
    "poem_id": 52176,
    "vorder": 311,
    "position": 0,
    "text": "ازو گر پذیری بافزون شود"
  },
  {
    "poem_id": 52176,
    "vorder": 312,
    "position": 1,
    "text": "دل از ناسپاسی پرازخون شود"
  },
  {
    "poem_id": 52176,
    "vorder": 313,
    "position": 0,
    "text": "ازان پس ببهرام بهرام گفت"
  },
  {
    "poem_id": 52176,
    "vorder": 314,
    "position": 1,
    "text": "که‌ای با خردیاروبا رای جفت"
  },
  {
    "poem_id": 52176,
    "vorder": 315,
    "position": 0,
    "text": "چه گویی کزین جستن تخت وگنج"
  },
  {
    "poem_id": 52176,
    "vorder": 316,
    "position": 1,
    "text": "بزرگیست فرجام گر درد ورنج"
  },
  {
    "poem_id": 52176,
    "vorder": 317,
    "position": 0,
    "text": "بخندید بهرام ازان داوری"
  },
  {
    "poem_id": 52176,
    "vorder": 318,
    "position": 1,
    "text": "ازان پس برانداخت انگشتری"
  },
  {
    "poem_id": 52176,
    "vorder": 319,
    "position": 0,
    "text": "بدو گفت چندانک این در هوا"
  },
  {
    "poem_id": 52176,
    "vorder": 320,
    "position": 1,
    "text": "بماند شود بنده‌ای پادشا"
  },
  {
    "poem_id": 52176,
    "vorder": 321,
    "position": 0,
    "text": "بدو گفت کین را مپندار خرد"
  },
  {
    "poem_id": 52176,
    "vorder": 322,
    "position": 1,
    "text": "که دیهیم را خرد نتوان شمرد"
  },
  {
    "poem_id": 52176,
    "vorder": 323,
    "position": 0,
    "text": "چنین گفت زان پس بپیداگشسب"
  },
  {
    "poem_id": 52176,
    "vorder": 324,
    "position": 1,
    "text": "که‌ای تیغ زن شیر تازنده اسب"
  },
  {
    "poem_id": 52176,
    "vorder": 325,
    "position": 0,
    "text": "چه بینی چه گویی بدین کار ما"
  },
  {
    "poem_id": 52176,
    "vorder": 326,
    "position": 1,
    "text": "بود گاه شاهی سزاوار ما"
  },
  {
    "poem_id": 52176,
    "vorder": 327,
    "position": 0,
    "text": "چنین گفت پیداگشسب سوار"
  },
  {
    "poem_id": 52176,
    "vorder": 328,
    "position": 1,
    "text": "که‌ای از یلان جهان یادگار"
  },
  {
    "poem_id": 52176,
    "vorder": 329,
    "position": 0,
    "text": "یکی موبدی داستان زد برین"
  },
  {
    "poem_id": 52176,
    "vorder": 330,
    "position": 1,
    "text": "که هرکس که دانا بد وپیش بین"
  },
  {
    "poem_id": 52176,
    "vorder": 331,
    "position": 0,
    "text": "اگر پادشاهی کند یک زمان"
  },
  {
    "poem_id": 52176,
    "vorder": 332,
    "position": 1,
    "text": "روانش بپرد سوی آسمان"
  },
  {
    "poem_id": 52176,
    "vorder": 333,
    "position": 0,
    "text": "به ازبنده بودن بسال دراز"
  },
  {
    "poem_id": 52176,
    "vorder": 334,
    "position": 1,
    "text": "به گنج جهاندار بردن نیاز"
  },
  {
    "poem_id": 52176,
    "vorder": 335,
    "position": 0,
    "text": "چنین گفت پس با دبیر بزرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 336,
    "position": 1,
    "text": "که بگشای لب را تو ای پیرگرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 337,
    "position": 0,
    "text": "دبیر بزرگ آن زمان لب ببست"
  },
  {
    "poem_id": 52176,
    "vorder": 338,
    "position": 1,
    "text": "بانبوه اندیشه اندر نشست"
  },
  {
    "poem_id": 52176,
    "vorder": 339,
    "position": 0,
    "text": "ازان پس چنین گفت بهرام را"
  },
  {
    "poem_id": 52176,
    "vorder": 340,
    "position": 1,
    "text": "که هرکس که جویا بود کامرا"
  },
  {
    "poem_id": 52176,
    "vorder": 341,
    "position": 0,
    "text": "چودرخور بجوید بیابد همان"
  },
  {
    "poem_id": 52176,
    "vorder": 342,
    "position": 1,
    "text": "درازست ویازنده دست زمان"
  },
  {
    "poem_id": 52176,
    "vorder": 343,
    "position": 0,
    "text": "زچیزی که بخشش کند دادگر"
  },
  {
    "poem_id": 52176,
    "vorder": 344,
    "position": 1,
    "text": "چنان دان که کوشش بیاید ببر"
  },
  {
    "poem_id": 52176,
    "vorder": 345,
    "position": 0,
    "text": "بهمدان گشسب آن زمان گفت باز"
  },
  {
    "poem_id": 52176,
    "vorder": 346,
    "position": 1,
    "text": "که‌ای گشته اندر نشیب وفراز"
  },
  {
    "poem_id": 52176,
    "vorder": 347,
    "position": 0,
    "text": "سخن هرچ‌گویی بروی کسان"
  },
  {
    "poem_id": 52176,
    "vorder": 348,
    "position": 1,
    "text": "شود باد وکردار او نارسان"
  },
  {
    "poem_id": 52176,
    "vorder": 349,
    "position": 0,
    "text": "بگو آنچ دانی به کار اندورن"
  },
  {
    "poem_id": 52176,
    "vorder": 350,
    "position": 1,
    "text": "زنیک وبد روزگار اندرون"
  },
  {
    "poem_id": 52176,
    "vorder": 351,
    "position": 0,
    "text": "چنین گفت همدان گشسب بلند"
  },
  {
    "poem_id": 52176,
    "vorder": 352,
    "position": 1,
    "text": "که‌ای نزد پرمایگان ارجمند"
  },
  {
    "poem_id": 52176,
    "vorder": 353,
    "position": 0,
    "text": "زناآمده بد بترسی همی"
  },
  {
    "poem_id": 52176,
    "vorder": 354,
    "position": 1,
    "text": "زدیهیم شاهان چه پرسی همی"
  },
  {
    "poem_id": 52176,
    "vorder": 355,
    "position": 0,
    "text": "بکن کار وکرده به یزدان سپار"
  },
  {
    "poem_id": 52176,
    "vorder": 356,
    "position": 1,
    "text": "بخرما چه یازی چوترسی زخار"
  },
  {
    "poem_id": 52176,
    "vorder": 357,
    "position": 0,
    "text": "تن آسان نگردد سرانجمن"
  },
  {
    "poem_id": 52176,
    "vorder": 358,
    "position": 1,
    "text": "همه بیم جان باشد ورنج تن"
  },
  {
    "poem_id": 52176,
    "vorder": 359,
    "position": 0,
    "text": "زگفتارشان خواهر پهلوان"
  },
  {
    "poem_id": 52176,
    "vorder": 360,
    "position": 1,
    "text": "همی‌بود پیچان وتیره روان"
  },
  {
    "poem_id": 52176,
    "vorder": 361,
    "position": 0,
    "text": "بران داوری هیچ نگشاد لب"
  },
  {
    "poem_id": 52176,
    "vorder": 362,
    "position": 1,
    "text": "زبرگشتن هور تا نیم شب"
  },
  {
    "poem_id": 52176,
    "vorder": 363,
    "position": 0,
    "text": "بدو گفت بهرام کای پاک تن"
  },
  {
    "poem_id": 52176,
    "vorder": 364,
    "position": 1,
    "text": "چه بینی به گفتار این انجمن"
  },
  {
    "poem_id": 52176,
    "vorder": 365,
    "position": 0,
    "text": "ورا گردیه هیچ پاسخ نداد"
  },
  {
    "poem_id": 52176,
    "vorder": 366,
    "position": 1,
    "text": "نه از رای آن مهتران بود شاد"
  },
  {
    "poem_id": 52176,
    "vorder": 367,
    "position": 0,
    "text": "چنین گفت اوبا دبیر بزرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 368,
    "position": 1,
    "text": "که‌ای مرد بدساز چون پیرگرگ"
  },
  {
    "poem_id": 52176,
    "vorder": 369,
    "position": 0,
    "text": "گمانت چنینست کین تاج وتخت"
  },
  {
    "poem_id": 52176,
    "vorder": 370,
    "position": 1,
    "text": "سپاه بزرگی و پیروزبخت"
  },
  {
    "poem_id": 52176,
    "vorder": 371,
    "position": 0,
    "text": "ز گیتی کسی را نبد آرزوی"
  },
  {
    "poem_id": 52176,
    "vorder": 372,
    "position": 1,
    "text": "ازان نامداران آزاده خوی"
  },
  {
    "poem_id": 52176,
    "vorder": 373,
    "position": 0,
    "text": "مگر شاهی آسانتر از بندگیست"
  },
  {
    "poem_id": 52176,
    "vorder": 374,
    "position": 1,
    "text": "بدین دانش تو بباید گریست"
  },
  {
    "poem_id": 52176,
    "vorder": 375,
    "position": 0,
    "text": "بر آیین شاهان پیشین رویم"
  },
  {
    "poem_id": 52176,
    "vorder": 376,
    "position": 1,
    "text": "سخن‌های آن برتران بشنویم"
  },
  {
    "poem_id": 52176,
    "vorder": 377,
    "position": 0,
    "text": "چنین داد پاسخ مر او را دبیر"
  },
  {
    "poem_id": 52176,
    "vorder": 378,
    "position": 1,
    "text": "که گر رای من نیستت جایگیر"
  },
  {
    "poem_id": 52176,
    "vorder": 379,
    "position": 0,
    "text": "هم آن گوی وآن کن که رای آیدت"
  },
  {
    "poem_id": 52176,
    "vorder": 380,
    "position": 1,
    "text": "بران رو که دل رهنمای آیدت"
  },
  {
    "poem_id": 52176,
    "vorder": 381,
    "position": 0,
    "text": "همان خواهرش نیز بهرام را"
  },
  {
    "poem_id": 52176,
    "vorder": 382,
    "position": 1,
    "text": "بگفت آن سواران خودکام را"
  },
  {
    "poem_id": 52176,
    "vorder": 383,
    "position": 0,
    "text": "نه نیکوست این دانش ورای تو"
  },
  {
    "poem_id": 52176,
    "vorder": 384,
    "position": 1,
    "text": "بکژی خرامد همی پای تو"
  },
  {
    "poem_id": 52176,
    "vorder": 385,
    "position": 0,
    "text": "بسی بد که بیکار بدتخت شاه"
  },
  {
    "poem_id": 52176,
    "vorder": 386,
    "position": 1,
    "text": "نکرد اندرو هیچ‌کهتر نگاه"
  },
  {
    "poem_id": 52176,
    "vorder": 387,
    "position": 0,
    "text": "جهان را بمردی نگه داشتند"
  },
  {
    "poem_id": 52176,
    "vorder": 388,
    "position": 1,
    "text": "یکی چشم برتخت نگماشتند"
  },
  {
    "poem_id": 52176,
    "vorder": 389,
    "position": 0,
    "text": "هرآنکس که دانا بدو پاک مغز"
  },
  {
    "poem_id": 52176,
    "vorder": 390,
    "position": 1,
    "text": "زهرگونه اندیشه‌ای راند نغز"
  },
  {
    "poem_id": 52176,
    "vorder": 391,
    "position": 0,
    "text": "بداند که شاهی به ازبندگیست"
  },
  {
    "poem_id": 52176,
    "vorder": 392,
    "position": 1,
    "text": "همان سرافرازی زافگندگیست"
  },
  {
    "poem_id": 52176,
    "vorder": 393,
    "position": 0,
    "text": "نبودند یازان بتخت کیان"
  },
  {
    "poem_id": 52176,
    "vorder": 394,
    "position": 1,
    "text": "همه بندگی را کمر برمیان"
  },
  {
    "poem_id": 52176,
    "vorder": 395,
    "position": 0,
    "text": "ببستند و زیشان بهی خواستند"
  },
  {
    "poem_id": 52176,
    "vorder": 396,
    "position": 1,
    "text": "همه دل بفرمانش آراستند"
  },
  {
    "poem_id": 52176,
    "vorder": 397,
    "position": 0,
    "text": "نه بیگانه زیبای افسر بود"
  },
  {
    "poem_id": 52176,
    "vorder": 398,
    "position": 1,
    "text": "سزای بزرگی بگوهر بود"
  },
  {
    "poem_id": 52176,
    "vorder": 399,
    "position": 0,
    "text": "زکاوس شاه اندرآیم نخست"
  },
  {
    "poem_id": 52176,
    "vorder": 400,
    "position": 1,
    "text": "کجا راه یزدان همی‌بازجست"
  },
  {
    "poem_id": 52176,
    "vorder": 401,
    "position": 0,
    "text": "که برآسمان اختران بشمرد"
  },
  {
    "poem_id": 52176,
    "vorder": 402,
    "position": 1,
    "text": "خم چرخ گردنده رابشکرد"
  },
  {
    "poem_id": 52176,
    "vorder": 403,
    "position": 0,
    "text": "به خواری و زاری بساری فتاد"
  },
  {
    "poem_id": 52176,
    "vorder": 404,
    "position": 1,
    "text": "از اندیشهٔ کژ وز بدنهاد"
  }
]