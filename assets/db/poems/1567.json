[
  {
    "poem_id": 1567,
    "vorder": 1,
    "position": 0,
    "text": "چو یک پاس بگذشت از تیره شب"
  },
  {
    "poem_id": 1567,
    "vorder": 2,
    "position": 1,
    "text": "به پیش اندر آمد خروش جلب"
  },
  {
    "poem_id": 1567,
    "vorder": 3,
    "position": 0,
    "text": "بخندید بر بارگی شاه نو"
  },
  {
    "poem_id": 1567,
    "vorder": 4,
    "position": 1,
    "text": "ز دم سپه رفت تا پیش رو"
  },
  {
    "poem_id": 1567,
    "vorder": 5,
    "position": 0,
    "text": "سپهدار چون پیش لشکر کشید"
  },
  {
    "poem_id": 1567,
    "vorder": 6,
    "position": 1,
    "text": "یکی ژرف دریای بی‌بن بدید"
  },
  {
    "poem_id": 1567,
    "vorder": 7,
    "position": 0,
    "text": "هیونی که بود اندران کاروان"
  },
  {
    "poem_id": 1567,
    "vorder": 8,
    "position": 1,
    "text": "کجا پیش رو داشتی ساروان"
  },
  {
    "poem_id": 1567,
    "vorder": 9,
    "position": 0,
    "text": "همی پیش رو غرقه گشت اندر آب"
  },
  {
    "poem_id": 1567,
    "vorder": 10,
    "position": 1,
    "text": "سپهبد بزد چنگ هم در شتاب"
  },
  {
    "poem_id": 1567,
    "vorder": 11,
    "position": 0,
    "text": "گرفتش دو ران بر کشیدش ز گل"
  },
  {
    "poem_id": 1567,
    "vorder": 12,
    "position": 1,
    "text": "بترسید بدخواه ترک چگل"
  },
  {
    "poem_id": 1567,
    "vorder": 13,
    "position": 0,
    "text": "بفرمود تا گرگسار نژند"
  },
  {
    "poem_id": 1567,
    "vorder": 14,
    "position": 1,
    "text": "شود داغ دل پیش بر پای بند"
  },
  {
    "poem_id": 1567,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت کای ریمن گرگسار"
  },
  {
    "poem_id": 1567,
    "vorder": 16,
    "position": 1,
    "text": "گرفتار بر دست اسفندیار"
  },
  {
    "poem_id": 1567,
    "vorder": 17,
    "position": 0,
    "text": "نگفتی که ایدر نیابی تو آب"
  },
  {
    "poem_id": 1567,
    "vorder": 18,
    "position": 1,
    "text": "بسوزد ترا تابش آفتاب"
  },
  {
    "poem_id": 1567,
    "vorder": 19,
    "position": 0,
    "text": "چرا کردی ای بدتن از آب خاک"
  },
  {
    "poem_id": 1567,
    "vorder": 20,
    "position": 1,
    "text": "سپه را همه کرده بودی هلاک"
  },
  {
    "poem_id": 1567,
    "vorder": 21,
    "position": 0,
    "text": "چنین داد پاسخ که مرگ سپاه"
  },
  {
    "poem_id": 1567,
    "vorder": 22,
    "position": 1,
    "text": "مرا روشناییست چون هور و ماه"
  },
  {
    "poem_id": 1567,
    "vorder": 23,
    "position": 0,
    "text": "چه بینم همی از تو جز پای‌بند"
  },
  {
    "poem_id": 1567,
    "vorder": 24,
    "position": 1,
    "text": "چه خواهم ترا جز بلا و گزند"
  },
  {
    "poem_id": 1567,
    "vorder": 25,
    "position": 0,
    "text": "سپهبد بخندید و بگشاد چشم"
  },
  {
    "poem_id": 1567,
    "vorder": 26,
    "position": 1,
    "text": "فرو ماند زان ترک و بفزود خشم"
  },
  {
    "poem_id": 1567,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت کای کم خرد گرگسار"
  },
  {
    "poem_id": 1567,
    "vorder": 28,
    "position": 1,
    "text": "چو پیروز گردم من از کارزار"
  },
  {
    "poem_id": 1567,
    "vorder": 29,
    "position": 0,
    "text": "به رویین دژت بر سپهبد کنم"
  },
  {
    "poem_id": 1567,
    "vorder": 30,
    "position": 1,
    "text": "مبادا که هرگز بتو بد کنم"
  },
  {
    "poem_id": 1567,
    "vorder": 31,
    "position": 0,
    "text": "همه پادشاهی سراسر تراست"
  },
  {
    "poem_id": 1567,
    "vorder": 32,
    "position": 1,
    "text": "چو با ما کنی در سخن راه راست"
  },
  {
    "poem_id": 1567,
    "vorder": 33,
    "position": 0,
    "text": "نیازارم آن را که فرزند تست"
  },
  {
    "poem_id": 1567,
    "vorder": 34,
    "position": 1,
    "text": "هم آن را که از دوده پیوند تست"
  },
  {
    "poem_id": 1567,
    "vorder": 35,
    "position": 0,
    "text": "چو بشنید گفتار او گرگسار"
  },
  {
    "poem_id": 1567,
    "vorder": 36,
    "position": 1,
    "text": "پرامید شد جانش از شهریار"
  },
  {
    "poem_id": 1567,
    "vorder": 37,
    "position": 0,
    "text": "ز گفتار او ماند اندر شگفت"
  },
  {
    "poem_id": 1567,
    "vorder": 38,
    "position": 1,
    "text": "زمین را ببوسید و پوزش گرفت"
  },
  {
    "poem_id": 1567,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت شاه آنچ گفتی گذشت"
  },
  {
    "poem_id": 1567,
    "vorder": 40,
    "position": 1,
    "text": "ز گفتار خامت نگشت آب دشت"
  },
  {
    "poem_id": 1567,
    "vorder": 41,
    "position": 0,
    "text": "گذرگاه این آب دریا کجاست"
  },
  {
    "poem_id": 1567,
    "vorder": 42,
    "position": 1,
    "text": "بباید نمودن به ما راه راست"
  },
  {
    "poem_id": 1567,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت با آهن از آبگیر"
  },
  {
    "poem_id": 1567,
    "vorder": 44,
    "position": 1,
    "text": "نیابد گذر پر و پیکان تیر"
  },
  {
    "poem_id": 1567,
    "vorder": 45,
    "position": 0,
    "text": "تهمتن فروماند اندر شگفت"
  },
  {
    "poem_id": 1567,
    "vorder": 46,
    "position": 1,
    "text": "هم‌اندر زمان بند او برگرفت"
  },
  {
    "poem_id": 1567,
    "vorder": 47,
    "position": 0,
    "text": "به دریای آب اندرون گرگسار"
  },
  {
    "poem_id": 1567,
    "vorder": 48,
    "position": 1,
    "text": "بیامد هیونی گرفته مهار"
  },
  {
    "poem_id": 1567,
    "vorder": 49,
    "position": 0,
    "text": "سپهبد بفرمود تا مشگ آب"
  },
  {
    "poem_id": 1567,
    "vorder": 50,
    "position": 1,
    "text": "بریزند در آب و در ماهتاب"
  },
  {
    "poem_id": 1567,
    "vorder": 51,
    "position": 0,
    "text": "به دریا سبک‌بار شد بارگی"
  },
  {
    "poem_id": 1567,
    "vorder": 52,
    "position": 1,
    "text": "سپاه اندر آمد به یکبارگی"
  },
  {
    "poem_id": 1567,
    "vorder": 53,
    "position": 0,
    "text": "چو آمد به خشکی سپاه و بنه"
  },
  {
    "poem_id": 1567,
    "vorder": 54,
    "position": 1,
    "text": "ببد میسره راست با میمنه"
  },
  {
    "poem_id": 1567,
    "vorder": 55,
    "position": 0,
    "text": "به نزدیک رویین دژ آمد سپاه"
  },
  {
    "poem_id": 1567,
    "vorder": 56,
    "position": 1,
    "text": "چنان شد که فرسنگ ده ماند راه"
  },
  {
    "poem_id": 1567,
    "vorder": 57,
    "position": 0,
    "text": "سر جنگجویان به خوردن نشست"
  },
  {
    "poem_id": 1567,
    "vorder": 58,
    "position": 1,
    "text": "پرستنده شد جام باده به دست"
  },
  {
    "poem_id": 1567,
    "vorder": 59,
    "position": 0,
    "text": "بفرمود تا جوشن و خود و گبر"
  },
  {
    "poem_id": 1567,
    "vorder": 60,
    "position": 1,
    "text": "ببردند با تیغ پیش هژبر"
  },
  {
    "poem_id": 1567,
    "vorder": 61,
    "position": 0,
    "text": "گشاده بفرمود تا گرگسار"
  },
  {
    "poem_id": 1567,
    "vorder": 62,
    "position": 1,
    "text": "بیامد به پیش یل اسفندیار"
  },
  {
    "poem_id": 1567,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت کاکنون گذشتی ز بد"
  },
  {
    "poem_id": 1567,
    "vorder": 64,
    "position": 1,
    "text": "ز تو خوبی و راست گفتن سزد"
  },
  {
    "poem_id": 1567,
    "vorder": 65,
    "position": 0,
    "text": "چو از تن ببرم سر ارجاسپ را"
  },
  {
    "poem_id": 1567,
    "vorder": 66,
    "position": 1,
    "text": "درخشان کنم جان لهراسپ را"
  },
  {
    "poem_id": 1567,
    "vorder": 67,
    "position": 0,
    "text": "چو کهرم که از خون فرشیدورد"
  },
  {
    "poem_id": 1567,
    "vorder": 68,
    "position": 1,
    "text": "دل لشکری کرد پر خون و درد"
  },
  {
    "poem_id": 1567,
    "vorder": 69,
    "position": 0,
    "text": "دگر اندریمان که پیروز گشت"
  },
  {
    "poem_id": 1567,
    "vorder": 70,
    "position": 1,
    "text": "بکشت از دلیران ما سی و هشت"
  },
  {
    "poem_id": 1567,
    "vorder": 71,
    "position": 0,
    "text": "سرانشان ببرم به کین نیا"
  },
  {
    "poem_id": 1567,
    "vorder": 72,
    "position": 1,
    "text": "پدید آرم از هر دری کیمیا"
  },
  {
    "poem_id": 1567,
    "vorder": 73,
    "position": 0,
    "text": "همه گورشان کام شیران کنم"
  },
  {
    "poem_id": 1567,
    "vorder": 74,
    "position": 1,
    "text": "به کام دلیران ایران کنم"
  },
  {
    "poem_id": 1567,
    "vorder": 75,
    "position": 0,
    "text": "سراسر بدوزم جگرشان به تیر"
  },
  {
    "poem_id": 1567,
    "vorder": 76,
    "position": 1,
    "text": "بیارم زن و کودکانشان اسیر"
  },
  {
    "poem_id": 1567,
    "vorder": 77,
    "position": 0,
    "text": "ترا شاد خوانیم ازین گر دژم"
  },
  {
    "poem_id": 1567,
    "vorder": 78,
    "position": 1,
    "text": "بگوی آنچ داری به دل بیش و کم"
  },
  {
    "poem_id": 1567,
    "vorder": 79,
    "position": 0,
    "text": "دل گرگسار اندران تنگ شد"
  },
  {
    "poem_id": 1567,
    "vorder": 80,
    "position": 1,
    "text": "روان و زبانش پر آژنگ شد"
  },
  {
    "poem_id": 1567,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت تا چند گویی چنین"
  },
  {
    "poem_id": 1567,
    "vorder": 82,
    "position": 1,
    "text": "که بر تو مبادا به داد آفرین"
  },
  {
    "poem_id": 1567,
    "vorder": 83,
    "position": 0,
    "text": "همه اختر بد به جان تو باد"
  },
  {
    "poem_id": 1567,
    "vorder": 84,
    "position": 1,
    "text": "بریده به خنجر میان تو باد"
  },
  {
    "poem_id": 1567,
    "vorder": 85,
    "position": 0,
    "text": "به خاک اندر افگنده پر خون تنت"
  },
  {
    "poem_id": 1567,
    "vorder": 86,
    "position": 1,
    "text": "زمین بستر و گرد پیراهنت"
  },
  {
    "poem_id": 1567,
    "vorder": 87,
    "position": 0,
    "text": "ز گفتار او تیز شد نامدار"
  },
  {
    "poem_id": 1567,
    "vorder": 88,
    "position": 1,
    "text": "برآشفت با تنگدل گرگسار"
  },
  {
    "poem_id": 1567,
    "vorder": 89,
    "position": 0,
    "text": "یکی تیغ هندی بزد بر سرش"
  },
  {
    "poem_id": 1567,
    "vorder": 90,
    "position": 1,
    "text": "ز تارک به دو نیم شد تا برش"
  },
  {
    "poem_id": 1567,
    "vorder": 91,
    "position": 0,
    "text": "به دریا فگندش هم‌اندر زمان"
  },
  {
    "poem_id": 1567,
    "vorder": 92,
    "position": 1,
    "text": "خور ماهیان شد تن بدگمان"
  },
  {
    "poem_id": 1567,
    "vorder": 93,
    "position": 0,
    "text": "وزان جایگه باره را بر نشست"
  },
  {
    "poem_id": 1567,
    "vorder": 94,
    "position": 1,
    "text": "به تندی میان یلی را ببست"
  },
  {
    "poem_id": 1567,
    "vorder": 95,
    "position": 0,
    "text": "به بالا برآمد به دژ بنگرید"
  },
  {
    "poem_id": 1567,
    "vorder": 96,
    "position": 1,
    "text": "یکی ساده دژ آهنین باره دید"
  },
  {
    "poem_id": 1567,
    "vorder": 97,
    "position": 0,
    "text": "سه فرسنگ بالا و پهنا چهل"
  },
  {
    "poem_id": 1567,
    "vorder": 98,
    "position": 1,
    "text": "بجایی ندید اندر او آب و گل"
  },
  {
    "poem_id": 1567,
    "vorder": 99,
    "position": 0,
    "text": "به پهنای دیوار او بر سوار"
  },
  {
    "poem_id": 1567,
    "vorder": 100,
    "position": 1,
    "text": "برفتی برابر بروبر چهار"
  },
  {
    "poem_id": 1567,
    "vorder": 101,
    "position": 0,
    "text": "چو اسفندیار آن شگفتی بدید"
  },
  {
    "poem_id": 1567,
    "vorder": 102,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1567,
    "vorder": 103,
    "position": 0,
    "text": "چنین گفت کاین را نشاید ستد"
  },
  {
    "poem_id": 1567,
    "vorder": 104,
    "position": 1,
    "text": "بد آمد به روی من از راه بد"
  },
  {
    "poem_id": 1567,
    "vorder": 105,
    "position": 0,
    "text": "دریغ این همه رنج و پیکار ما"
  },
  {
    "poem_id": 1567,
    "vorder": 106,
    "position": 1,
    "text": "پشیمانی آمد همه کار ما"
  },
  {
    "poem_id": 1567,
    "vorder": 107,
    "position": 0,
    "text": "به گرد بیابان همه بنگرید"
  },
  {
    "poem_id": 1567,
    "vorder": 108,
    "position": 1,
    "text": "دو ترک اندران دشت پوینده دید"
  },
  {
    "poem_id": 1567,
    "vorder": 109,
    "position": 0,
    "text": "همی رفت پیش اندرون چار سگ"
  },
  {
    "poem_id": 1567,
    "vorder": 110,
    "position": 1,
    "text": "سگانی که گیرند آهو به تگ"
  },
  {
    "poem_id": 1567,
    "vorder": 111,
    "position": 0,
    "text": "ز بالا فرود آمد اسفندیار"
  },
  {
    "poem_id": 1567,
    "vorder": 112,
    "position": 1,
    "text": "به چنگ اندرون نیزهٔ کارزار"
  },
  {
    "poem_id": 1567,
    "vorder": 113,
    "position": 0,
    "text": "بپرسید و گفت این دژ نامدار"
  },
  {
    "poem_id": 1567,
    "vorder": 114,
    "position": 1,
    "text": "چه جایست و چندست بر وی سوار"
  },
  {
    "poem_id": 1567,
    "vorder": 115,
    "position": 0,
    "text": "ز ارجاسپ چندی سخن راندند"
  },
  {
    "poem_id": 1567,
    "vorder": 116,
    "position": 1,
    "text": "همه دفتر دژ برو خواندند"
  },
  {
    "poem_id": 1567,
    "vorder": 117,
    "position": 0,
    "text": "که بالا و پهنای دژ را ببین"
  },
  {
    "poem_id": 1567,
    "vorder": 118,
    "position": 1,
    "text": "دری سوی ایران دگر سوی چین"
  },
  {
    "poem_id": 1567,
    "vorder": 119,
    "position": 0,
    "text": "بدو اندرون تیغ‌زن سی‌هزار"
  },
  {
    "poem_id": 1567,
    "vorder": 120,
    "position": 1,
    "text": "سواران گردنکش و نامدار"
  },
  {
    "poem_id": 1567,
    "vorder": 121,
    "position": 0,
    "text": "همه پیش ارجاسپ چون بنده‌اند"
  },
  {
    "poem_id": 1567,
    "vorder": 122,
    "position": 1,
    "text": "به فرمان و رایش سرافگنده‌اند"
  },
  {
    "poem_id": 1567,
    "vorder": 123,
    "position": 0,
    "text": "خورش هست چندانک اندازه نیست"
  },
  {
    "poem_id": 1567,
    "vorder": 124,
    "position": 1,
    "text": "به خوشه درون بار اگر تازه نیست"
  },
  {
    "poem_id": 1567,
    "vorder": 125,
    "position": 0,
    "text": "اگر در ببندد به ده سال شاه"
  },
  {
    "poem_id": 1567,
    "vorder": 126,
    "position": 1,
    "text": "خورش هست چندانک باید سپاه"
  },
  {
    "poem_id": 1567,
    "vorder": 127,
    "position": 0,
