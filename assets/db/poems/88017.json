[
  {
    "poem_id": 88017,
    "vorder": 1,
    "position": 0,
    "text": "چو گرگین نشان تهمتن شنید"
  },
  {
    "poem_id": 88017,
    "vorder": 2,
    "position": 1,
    "text": "بدانست کآمد غمش را کلید"
  },
  {
    "poem_id": 88017,
    "vorder": 3,
    "position": 0,
    "text": "فرستاد نزدیک رستم پیام"
  },
  {
    "poem_id": 88017,
    "vorder": 4,
    "position": 1,
    "text": "که ای تیغ بخت و وفا را نیام"
  },
  {
    "poem_id": 88017,
    "vorder": 5,
    "position": 0,
    "text": "درخت بزرگی و گنج وفا"
  },
  {
    "poem_id": 88017,
    "vorder": 6,
    "position": 1,
    "text": "در رادمردی و بند بلا"
  },
  {
    "poem_id": 88017,
    "vorder": 7,
    "position": 0,
    "text": "گرت رنج ناید ز گفتار من"
  },
  {
    "poem_id": 88017,
    "vorder": 8,
    "position": 1,
    "text": "سخن گسترانی ز کردار من"
  },
  {
    "poem_id": 88017,
    "vorder": 9,
    "position": 0,
    "text": "نگه کن بدین گنبد گوژپشت"
  },
  {
    "poem_id": 88017,
    "vorder": 10,
    "position": 1,
    "text": "که خیره چراغ دلم را بکشت"
  },
  {
    "poem_id": 88017,
    "vorder": 11,
    "position": 0,
    "text": "بتاریکی اندر مرا ره نمود"
  },
  {
    "poem_id": 88017,
    "vorder": 12,
    "position": 1,
    "text": "نوشته چنین بود بود آنچ بود"
  },
  {
    "poem_id": 88017,
    "vorder": 13,
    "position": 0,
    "text": "بر آتش نهم خویشتن پیش شاه"
  },
  {
    "poem_id": 88017,
    "vorder": 14,
    "position": 1,
    "text": "گر آمرزش آرد مرا زین گناه"
  },
  {
    "poem_id": 88017,
    "vorder": 15,
    "position": 0,
    "text": "مگر باز گردد ز بد نام من"
  },
  {
    "poem_id": 88017,
    "vorder": 16,
    "position": 1,
    "text": "بپیران سر این بد سرانجام من"
  },
  {
    "poem_id": 88017,
    "vorder": 17,
    "position": 0,
    "text": "مرا گر بخواهی ز شاه جوان"
  },
  {
    "poem_id": 88017,
    "vorder": 18,
    "position": 1,
    "text": "چو غرم ژیان با تو آیم دوان"
  },
  {
    "poem_id": 88017,
    "vorder": 19,
    "position": 0,
    "text": "شوم پیش بیژن بغلتم بخاک"
  },
  {
    "poem_id": 88017,
    "vorder": 20,
    "position": 1,
    "text": "مگر بازیابم من آن کیش پاک"
  },
  {
    "poem_id": 88017,
    "vorder": 21,
    "position": 0,
    "text": "چو پیغام گرگین برستم رسید"
  },
  {
    "poem_id": 88017,
    "vorder": 22,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 88017,
    "vorder": 23,
    "position": 0,
    "text": "بپیچید ازان درد و پیغام اوی"
  },
  {
    "poem_id": 88017,
    "vorder": 24,
    "position": 1,
    "text": "غم آمدش ازان بیهده کام اوی"
  },
  {
    "poem_id": 88017,
    "vorder": 25,
    "position": 0,
    "text": "فرستاده را گفت رو باز گرد"
  },
  {
    "poem_id": 88017,
    "vorder": 26,
    "position": 1,
    "text": "بگویش که ای خیره ناپاک مرد"
  },
  {
    "poem_id": 88017,
    "vorder": 27,
    "position": 0,
    "text": "تو نشنیدی آن داستان پلنگ"
  },
  {
    "poem_id": 88017,
    "vorder": 28,
    "position": 1,
    "text": "بدان ژرف دریا که زد با نهنگ"
  },
  {
    "poem_id": 88017,
    "vorder": 29,
    "position": 0,
    "text": "که گر بر خرد چیره گردد هوا"
  },
  {
    "poem_id": 88017,
    "vorder": 30,
    "position": 1,
    "text": "نیابد ز چنگ هوا کس رها"
  },
  {
    "poem_id": 88017,
    "vorder": 31,
    "position": 0,
    "text": "خردمند کرد هوا را بزیر"
  },
  {
    "poem_id": 88017,
    "vorder": 32,
    "position": 1,
    "text": "بود داستانش چو شیر دلیر"
  },
  {
    "poem_id": 88017,
    "vorder": 33,
    "position": 0,
    "text": "نبایدش بردن بنخچیر روی"
  },
  {
    "poem_id": 88017,
    "vorder": 34,
    "position": 1,
    "text": "نه نیز از ددان رنجش آید بدوی"
  },
  {
    "poem_id": 88017,
    "vorder": 35,
    "position": 0,
    "text": "تو دستان نمودی چو روباه پیر"
  },
  {
    "poem_id": 88017,
    "vorder": 36,
    "position": 1,
    "text": "ندیدی همی دام نخچیرگیر"
  },
  {
    "poem_id": 88017,
    "vorder": 37,
    "position": 0,
    "text": "نشاید کزین بیهده کام تو"
  },
  {
    "poem_id": 88017,
    "vorder": 38,
    "position": 1,
    "text": "که من پیش خسرو برم نام تو"
  },
  {
    "poem_id": 88017,
    "vorder": 39,
    "position": 0,
    "text": "ولیکن چو اکنون ببیچارگی"
  },
  {
    "poem_id": 88017,
    "vorder": 40,
    "position": 1,
    "text": "فرو مانده گشتی بیکبارگی"
  },
  {
    "poem_id": 88017,
    "vorder": 41,
    "position": 0,
    "text": "ز خسرو بخواهم گناه ترا"
  },
  {
    "poem_id": 88017,
    "vorder": 42,
    "position": 1,
    "text": "بیفروزم این تیره ماه ترا"
  },
  {
    "poem_id": 88017,
    "vorder": 43,
    "position": 0,
    "text": "اگر بیژن از بند یابد رها"
  },
  {
    "poem_id": 88017,
    "vorder": 44,
    "position": 1,
    "text": "بفرمان دادار گیهان خدا"
  },
  {
    "poem_id": 88017,
    "vorder": 45,
    "position": 0,
    "text": "رهاگشتی از بند و رستی بجان"
  },
  {
    "poem_id": 88017,
    "vorder": 46,
    "position": 1,
    "text": "ز تو دور شد کینهٔ بدگمان"
  },
  {
    "poem_id": 88017,
    "vorder": 47,
    "position": 0,
    "text": "وگر جز برین روی گردد سپهر"
  },
  {
    "poem_id": 88017,
    "vorder": 48,
    "position": 1,
    "text": "ز جان و تن خویش بردار مهر"
  },
  {
    "poem_id": 88017,
    "vorder": 49,
    "position": 0,
    "text": "نخستین من آیم بدین کینه‌خواه"
  },
  {
    "poem_id": 88017,
    "vorder": 50,
    "position": 1,
    "text": "بنیروی یزدان و فرمان شاه"
  },
  {
    "poem_id": 88017,
    "vorder": 51,
    "position": 0,
    "text": "وگر من نیایم چو گودرز و گیو"
  },
  {
    "poem_id": 88017,
    "vorder": 52,
    "position": 1,
    "text": "بخواهد ز تو کینهٔ پور نیو"
  },
  {
    "poem_id": 88017,
    "vorder": 53,
    "position": 0,
    "text": "برآمد برین کار یک روز و شب"
  },
  {
    "poem_id": 88017,
    "vorder": 54,
    "position": 1,
    "text": "و زین گفته بر شاه نگشاد لب"
  },
  {
    "poem_id": 88017,
    "vorder": 55,
    "position": 0,
    "text": "دوم روز چون شاه بنمود تاج"
  },
  {
    "poem_id": 88017,
    "vorder": 56,
    "position": 1,
    "text": "نشست از بر سیمگون تخت عاج"
  },
  {
    "poem_id": 88017,
    "vorder": 57,
    "position": 0,
    "text": "بیامد تهمتن بگسترد بر"
  },
  {
    "poem_id": 88017,
    "vorder": 58,
    "position": 1,
    "text": "بخواهش بر شاه خورشید فر"
  },
  {
    "poem_id": 88017,
    "vorder": 59,
    "position": 0,
    "text": "ز گرگین سخن گفت با شهریار"
  },
  {
    "poem_id": 88017,
    "vorder": 60,
    "position": 1,
    "text": "ازان گم شده بخت و بد روزگار"
  },
  {
    "poem_id": 88017,
    "vorder": 61,
    "position": 0,
    "text": "بدو گفت شاه ای سپهدار من"
  },
  {
    "poem_id": 88017,
    "vorder": 62,
    "position": 1,
    "text": "همی بگسلی بند و زنهار من"
  },
  {
    "poem_id": 88017,
    "vorder": 63,
    "position": 0,
    "text": "که سوگند خوردم بتخت و کلاه"
  },
  {
    "poem_id": 88017,
    "vorder": 64,
    "position": 1,
    "text": "بدارای بهرام و خورشید و ماه"
  },
  {
    "poem_id": 88017,
    "vorder": 65,
    "position": 0,
    "text": "که گرگین نبیند ز من جز بلا"
  },
  {
    "poem_id": 88017,
    "vorder": 66,
    "position": 1,
    "text": "مگر بیژن از بند یابد رها"
  },
  {
    "poem_id": 88017,
    "vorder": 67,
    "position": 0,
    "text": "جزین آرزو هرچ باید بخواه"
  },
  {
    "poem_id": 88017,
    "vorder": 68,
    "position": 1,
    "text": "ز تخت و ز مهر و ز تیغ و کلاه"
  },
  {
    "poem_id": 88017,
    "vorder": 69,
    "position": 0,
    "text": "پس آنگه چنین گفت رستم بشاه"
  },
  {
    "poem_id": 88017,
    "vorder": 70,
    "position": 1,
    "text": "که ای پرهنر نامور پیشگاه"
  },
  {
    "poem_id": 88017,
    "vorder": 71,
    "position": 0,
    "text": "اگر بد سگالید پیچد همی"
  },
  {
    "poem_id": 88017,
    "vorder": 72,
    "position": 1,
    "text": "فدا کردن جان بسیچد همی"
  },
  {
    "poem_id": 88017,
    "vorder": 73,
    "position": 0,
    "text": "گر آمرزش شاه نایدش پیش"
  },
  {
    "poem_id": 88017,
    "vorder": 74,
    "position": 1,
    "text": "نبودیش نام و برآید ز کیش"
  },
  {
    "poem_id": 88017,
    "vorder": 75,
    "position": 0,
    "text": "هرآن کس که گردد ز راه خرد"
  },
  {
    "poem_id": 88017,
    "vorder": 76,
    "position": 1,
    "text": "سرانجام پیچد ز کردار خود"
  },
  {
    "poem_id": 88017,
    "vorder": 77,
    "position": 0,
    "text": "سزد گر کنی یاد کردار اوی"
  },
  {
    "poem_id": 88017,
    "vorder": 78,
    "position": 1,
    "text": "همیشه بهر کینه پیکار اوی"
  },
  {
    "poem_id": 88017,
    "vorder": 79,
    "position": 0,
    "text": "بپیش نیاکانت بسته کمر"
  },
  {
    "poem_id": 88017,
    "vorder": 80,
    "position": 1,
    "text": "بهر کینه گه با یکی کینه ور"
  },
  {
    "poem_id": 88017,
    "vorder": 81,
    "position": 0,
    "text": "اگر شاه بیند بمن بخشدش"
  },
  {
    "poem_id": 88017,
    "vorder": 82,
    "position": 1,
    "text": "مگر اختر نیک بدرخشدش"
  },
  {
    "poem_id": 88017,
    "vorder": 83,
    "position": 0,
    "text": "برستم ببخشید پیروز شاه"
  },
  {
    "poem_id": 88017,
    "vorder": 84,
    "position": 1,
    "text": "رهانیدش از بند و تاریک چاه"
  },
  {
    "poem_id": 88017,
    "vorder": 85,
    "position": 0,
    "text": "ز رستم بپرسید پس شهریار"
  },
  {
    "poem_id": 88017,
    "vorder": 86,
    "position": 1,
    "text": "که چون راند خواهی برین گونه کار"
  },
  {
    "poem_id": 88017,
    "vorder": 87,
    "position": 0,
    "text": "چه باید ز گنج و زلشکر بخواه"
  },
  {
    "poem_id": 88017,
    "vorder": 88,
    "position": 1,
    "text": "که باید که با تو بیاید براه"
  },
  {
    "poem_id": 88017,
    "vorder": 89,
    "position": 0,
    "text": "بترسم ز بد گوهر افراسیاب"
  },
  {
    "poem_id": 88017,
    "vorder": 90,
    "position": 1,
    "text": "که بر جان بیژن بگیرد شتاب"
  },
  {
    "poem_id": 88017,
    "vorder": 91,
    "position": 0,
    "text": "یکی بادسارست دیو نژند"
  },
  {
    "poem_id": 88017,
    "vorder": 92,
    "position": 1,
    "text": "بسی خوانده افسون و نیرنگ و بند"
  },
  {
    "poem_id": 88017,
    "vorder": 93,
    "position": 0,
    "text": "بجنباندش اهرمن دل ز جای"
  },
  {
    "poem_id": 88017,
    "vorder": 94,
    "position": 1,
    "text": "بیندازد آن تیغ زن را زپای"
  },
  {
    "poem_id": 88017,
    "vorder": 95,
    "position": 0,
    "text": "چنین گفت رستم بشاه جهان"
  },
  {
    "poem_id": 88017,
    "vorder": 96,
    "position": 1,
    "text": "که این کار ببسیچم اندر نهان"
  },
  {
    "poem_id": 88017,
    "vorder": 97,
    "position": 0,
    "text": "کلید چنین بند باشد فریب"
  },
  {
    "poem_id": 88017,
    "vorder": 98,
    "position": 1,
    "text": "نباید برین کار کردن نهیب"
  },
  {
    "poem_id": 88017,
    "vorder": 99,
    "position": 0,
    "text": "نه هنگام گرزست و تیغ و سنان"
  },
  {
    "poem_id": 88017,
    "vorder": 100,
    "position": 1,
    "text": "بدین کار باید کشیدن عنان"
  },
  {
    "poem_id": 88017,
    "vorder": 101,
    "position": 0,
    "text": "فراوان گهر باید و زرو سیم"
  },
  {
    "poem_id": 88017,
    "vorder": 102,
    "position": 1,
    "text": "برفتن پر امید و بودن به بیم"
  },
  {
    "poem_id": 88017,
    "vorder": 103,
    "position": 0,
    "text": "بکردار بازارگانان شدن"
  },
  {
    "poem_id": 88017,
    "vorder": 104,
    "position": 1,
    "text": "شکیبا فراوان بتوران بدن"
  },
  {
    "poem_id": 88017,
    "vorder": 105,
    "position": 0,
    "text": "ز گستردنی هم ز پوشیدنی"
  },
  {
    "poem_id": 88017,
    "vorder": 106,
    "position": 1,
    "text": "بباید بهایی و بخشیدنی"
  },
  {
    "poem_id": 88017,
    "vorder": 107,
    "position": 0,
    "text": "چو بشنید خسرو ز رستم سخن"
  },
  {
    "poem_id": 88017,
    "vorder": 108,
    "position": 1,
    "text": "بفرمود تا گنجهای کهن"
  },
  {
    "poem_id": 88017,
    "vorder": 109,
    "position": 0,
    "text": "همه پاک بگشاد گنجور شاه"
  },
  {
    "poem_id": 88017,
    "vorder": 110,
    "position": 1,
    "text": "بدینار و گوهر بیاراست گاه"
  },
  {
    "poem_id": 88017,
    "vorder": 111,
    "position": 0,
    "text": "تهمتن بیامد همه بنگرید"
  },
  {
    "poem_id": 88017,
    "vorder": 112,
    "position": 1,
    "text": "هر آنچش ببایست زان برگزید"
  },
  {
    "poem_id": 88017,
    "vorder": 113,
    "position": 0,
    "text": "ازان صد شتر بار دینار کرد"
  },
  {
    "poem_id": 88017,
    "vorder": 114,
    "position": 1,
    "text": "صد اشتر ز گنج درم بار کرد"
  },
  {
    "poem_id": 88017,
    "vorder": 115,
    "position": 0,
    "text": "بفرمود رستم بسالار بار"
  },
  {
    "poem_id": 88017,
    "vorder": 116,
    "position": 1,
    "text": "که بگزین ز گردان لشکر هزار"
  },
  {
    "poem_id": 88017,
    "vorder": 117,
    "position": 0,
    "text": "ز مردان گردنکش و نامور"
  },
  {
    "poem_id": 88017,
    "vorder": 118,
    "position": 1,
    "text": "بباید تنی چند بسته کمر"
  },
  {
    "poem_id": 88017,
    "vorder": 119,
    "position": 0,
    "text": "چو گرگین و چون زنگهٔ شاوران"
  },
  {
    "poem_id": 88017,
    "vorder": 120,
    "position": 1,
    "text": "دگر گستهم شیر جنگ آوران"
  },
  {
    "poem_id": 88017,
    "vorder": 121,
    "position": 0,
    "text": "چهارم گرازه که راند سپاه"
  },
  {
    "poem_id": 88017,
    "vorder": 122,
    "position": 1,
    "text": "فروهل نگهبان تخت و کلاه"
  },
  {
    "poem_id": 88017,
    "vorder": 123,
    "position": 0,
    "text": "چو فرهاد و رهام گرد دلیر"
  },
  {
    "poem_id": 88017,
    "vorder": 124,
    "position": 1,
    "text": "چو اشکش که صید آورد نره شیر"
  },
  {
    "poem_id": 88017,
    "vorder": 125,
    "position": 0,
    "text": "چنین هفت یل باید آراسته"
  },
  {
    "poem_id": 88017,
    "vorder": 126,
    "position": 1,
    "text": "نگهبان این لشکر و خواسته"
  },
  {
    "poem_id": 88017,
    "vorder": 127,
    "position": 0,
    "text": "همه تاج و زیور بینداختند"
  },
  {
