[
  {
    "poem_id": 1758,
    "vorder": 1,
    "position": 0,
    "text": "پدر آرزو کرد بهرام را"
  },
  {
    "poem_id": 1758,
    "vorder": 2,
    "position": 1,
    "text": "چه بهرام خورشید خودکام را"
  },
  {
    "poem_id": 1758,
    "vorder": 3,
    "position": 0,
    "text": "به منذر چنین گفت بهرام شیر"
  },
  {
    "poem_id": 1758,
    "vorder": 4,
    "position": 1,
    "text": "که هرچند مانیم نزد تو دیر"
  },
  {
    "poem_id": 1758,
    "vorder": 5,
    "position": 0,
    "text": "همان آرزوی پدر خیزدم"
  },
  {
    "poem_id": 1758,
    "vorder": 6,
    "position": 1,
    "text": "چو ایمن شوم در برانگیزدم"
  },
  {
    "poem_id": 1758,
    "vorder": 7,
    "position": 0,
    "text": "برآرست منذر چو بایست کار"
  },
  {
    "poem_id": 1758,
    "vorder": 8,
    "position": 1,
    "text": "ز شهر یمن هدیهٔ شهریار"
  },
  {
    "poem_id": 1758,
    "vorder": 9,
    "position": 0,
    "text": "ز اسپان تازی به زرین ستام"
  },
  {
    "poem_id": 1758,
    "vorder": 10,
    "position": 1,
    "text": "ز چیزی که پرمایه بردند نام"
  },
  {
    "poem_id": 1758,
    "vorder": 11,
    "position": 0,
    "text": "ز برد یمانی و تیغ یمن"
  },
  {
    "poem_id": 1758,
    "vorder": 12,
    "position": 1,
    "text": "دگر هرچ معدنش بد در عدن"
  },
  {
    "poem_id": 1758,
    "vorder": 13,
    "position": 0,
    "text": "چو نعمان که با شاه همراه بود"
  },
  {
    "poem_id": 1758,
    "vorder": 14,
    "position": 1,
    "text": "به نزدیک او افسر ماه بود"
  },
  {
    "poem_id": 1758,
    "vorder": 15,
    "position": 0,
    "text": "چنین تا به شهر صطخر آمدند"
  },
  {
    "poem_id": 1758,
    "vorder": 16,
    "position": 1,
    "text": "که از شاه‌زاد به فخر آمدند"
  },
  {
    "poem_id": 1758,
    "vorder": 17,
    "position": 0,
    "text": "ازان پس چو آگاهی آمد به شاه"
  },
  {
    "poem_id": 1758,
    "vorder": 18,
    "position": 1,
    "text": "ز فرزند و نعمان تازی به راه"
  },
  {
    "poem_id": 1758,
    "vorder": 19,
    "position": 0,
    "text": "بیامد هم‌انگاه نزد پدر"
  },
  {
    "poem_id": 1758,
    "vorder": 20,
    "position": 1,
    "text": "چو دیدش پدر را برآورد سر"
  },
  {
    "poem_id": 1758,
    "vorder": 21,
    "position": 0,
    "text": "به پیش کیی تخت او سرفراز"
  },
  {
    "poem_id": 1758,
    "vorder": 22,
    "position": 1,
    "text": "بیامد شتابان و بردش نماز"
  },
  {
    "poem_id": 1758,
    "vorder": 23,
    "position": 0,
    "text": "چو بهرام را دید بیدار شاه"
  },
  {
    "poem_id": 1758,
    "vorder": 24,
    "position": 1,
    "text": "بدان فر و آن شاخ و آن گردگاه"
  },
  {
    "poem_id": 1758,
    "vorder": 25,
    "position": 0,
    "text": "شگفتی فروماند از کار اوی"
  },
  {
    "poem_id": 1758,
    "vorder": 26,
    "position": 1,
    "text": "ز بالا و فرهنگ و دیدار اوی"
  },
  {
    "poem_id": 1758,
    "vorder": 27,
    "position": 0,
    "text": "فراوان بپرسید و بنواختش"
  },
  {
    "poem_id": 1758,
    "vorder": 28,
    "position": 1,
    "text": "به نزدیک خود جایگه ساختش"
  },
  {
    "poem_id": 1758,
    "vorder": 29,
    "position": 0,
    "text": "به برزن درون جای نعمان گزید"
  },
  {
    "poem_id": 1758,
    "vorder": 30,
    "position": 1,
    "text": "یکی کاخ بهرام را چون سزید"
  },
  {
    "poem_id": 1758,
    "vorder": 31,
    "position": 0,
    "text": "فرستاد نزدیک او بندگان"
  },
  {
    "poem_id": 1758,
    "vorder": 32,
    "position": 1,
    "text": "چو اندر خور او پرستندگان"
  },
  {
    "poem_id": 1758,
    "vorder": 33,
    "position": 0,
    "text": "شب و روز بهرام پیش پدر"
  },
  {
    "poem_id": 1758,
    "vorder": 34,
    "position": 1,
    "text": "همی از پرستش نخارید سر"
  },
  {
    "poem_id": 1758,
    "vorder": 35,
    "position": 0,
    "text": "چو یک ماه نعمان ببد نزد شاه"
  },
  {
    "poem_id": 1758,
    "vorder": 36,
    "position": 1,
    "text": "همی خواست تا بازگردد به راه"
  },
  {
    "poem_id": 1758,
    "vorder": 37,
    "position": 0,
    "text": "بشب کس فرستاد و او را بخواند"
  },
  {
    "poem_id": 1758,
    "vorder": 38,
    "position": 1,
    "text": "برابرش بر تخت شاهی نشاند"
  },
  {
    "poem_id": 1758,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت منذر بسی رنج دید"
  },
  {
    "poem_id": 1758,
    "vorder": 40,
    "position": 1,
    "text": "که آزاده بهرام را پرورید"
  },
  {
    "poem_id": 1758,
    "vorder": 41,
    "position": 0,
    "text": "بدین کار پاداش نزد منست"
  },
  {
    "poem_id": 1758,
    "vorder": 42,
    "position": 1,
    "text": "بهار شما اورمزد منست"
  },
  {
    "poem_id": 1758,
    "vorder": 43,
    "position": 0,
    "text": "پسندیدم این رای و فرهنگ اوی"
  },
  {
    "poem_id": 1758,
    "vorder": 44,
    "position": 1,
    "text": "که سوی خرد بینم آهنگ اوی"
  },
  {
    "poem_id": 1758,
    "vorder": 45,
    "position": 0,
    "text": "تو چون دیر ماندی بدین بارگاه"
  },
  {
    "poem_id": 1758,
    "vorder": 46,
    "position": 1,
    "text": "پدر چشم دارد همانا به راه"
  },
  {
    "poem_id": 1758,
    "vorder": 47,
    "position": 0,
    "text": "ز دینار گنجیش پنجه هزار"
  },
  {
    "poem_id": 1758,
    "vorder": 48,
    "position": 1,
    "text": "بدادند با جامهٔ شهریار"
  },
  {
    "poem_id": 1758,
    "vorder": 49,
    "position": 0,
    "text": "ز آخر به سیمین و زرین لگام"
  },
  {
    "poem_id": 1758,
    "vorder": 50,
    "position": 1,
    "text": "ده اسپ گرانمایه بردند نام"
  },
  {
    "poem_id": 1758,
    "vorder": 51,
    "position": 0,
    "text": "ز گستردنیهای زیبنده نیز"
  },
  {
    "poem_id": 1758,
    "vorder": 52,
    "position": 1,
    "text": "ز رنگ و ز بوی و ز هرگونه چیز"
  },
  {
    "poem_id": 1758,
    "vorder": 53,
    "position": 0,
    "text": "ز گنج جهاندار ایران ببرد"
  },
  {
    "poem_id": 1758,
    "vorder": 54,
    "position": 1,
    "text": "یکایک به نعمان منذر سپرد"
  },
  {
    "poem_id": 1758,
    "vorder": 55,
    "position": 0,
    "text": "به شادی در بخشش اندر گشاد"
  },
  {
    "poem_id": 1758,
    "vorder": 56,
    "position": 1,
    "text": "بر اندازه یارانش را هدیه داد"
  },
  {
    "poem_id": 1758,
    "vorder": 57,
    "position": 0,
    "text": "به منذر یکی نامه بنوشت شاه"
  },
  {
    "poem_id": 1758,
    "vorder": 58,
    "position": 1,
    "text": "چنانچون بود در خور پیشگاه"
  },
  {
    "poem_id": 1758,
    "vorder": 59,
    "position": 0,
    "text": "به آزادی از کار فرزند اوی"
  },
  {
    "poem_id": 1758,
    "vorder": 60,
    "position": 1,
    "text": "که شاه یمن گشت پیوند اوی"
  },
  {
    "poem_id": 1758,
    "vorder": 61,
    "position": 0,
    "text": "به پاداش این کار یازم همی"
  },
  {
    "poem_id": 1758,
    "vorder": 62,
    "position": 1,
    "text": "به چونین پسر سرفرازم همی"
  },
  {
    "poem_id": 1758,
    "vorder": 63,
    "position": 0,
    "text": "یکی نامه بنوشت بهرام گور"
  },
  {
    "poem_id": 1758,
    "vorder": 64,
    "position": 1,
    "text": "که کار من ایدر تباهست و شور"
  },
  {
    "poem_id": 1758,
    "vorder": 65,
    "position": 0,
    "text": "نه این بود چشم امیدم به شاه"
  },
  {
    "poem_id": 1758,
    "vorder": 66,
    "position": 1,
    "text": "که زین سان کند سوی کهتر نگاه"
  },
  {
    "poem_id": 1758,
    "vorder": 67,
    "position": 0,
    "text": "نه فرزندم ایدر نه چون چاکری"
  },
  {
    "poem_id": 1758,
    "vorder": 68,
    "position": 1,
    "text": "نه چون کهتری شاددل بر دری"
  },
  {
    "poem_id": 1758,
    "vorder": 69,
    "position": 0,
    "text": "به نعمان بگفت آنچ بودش نهان"
  },
  {
    "poem_id": 1758,
    "vorder": 70,
    "position": 1,
    "text": "ز بد راه و آیین شاه جهان"
  },
  {
    "poem_id": 1758,
    "vorder": 71,
    "position": 0,
    "text": "چو نعمان برفت از در شهریار"
  },
  {
    "poem_id": 1758,
    "vorder": 72,
    "position": 1,
    "text": "بیامد بر منذر نامدار"
  },
  {
    "poem_id": 1758,
    "vorder": 73,
    "position": 0,
    "text": "بدو نامهٔ شاه گیتی بداد"
  },
  {
    "poem_id": 1758,
    "vorder": 74,
    "position": 1,
    "text": "ببوسید منذر به سر بر نهاد"
  },
  {
    "poem_id": 1758,
    "vorder": 75,
    "position": 0,
    "text": "وزان هدیه‌ها شادمانی نمود"
  },
  {
    "poem_id": 1758,
    "vorder": 76,
    "position": 1,
    "text": "بران آفرین آفرین برفزود"
  },
  {
    "poem_id": 1758,
    "vorder": 77,
    "position": 0,
    "text": "وزان پس فرستاده اندر نهفت"
  },
  {
    "poem_id": 1758,
    "vorder": 78,
    "position": 1,
    "text": "ز بهرام چندی به منذر بگفت"
  },
  {
    "poem_id": 1758,
    "vorder": 79,
    "position": 0,
    "text": "پس آن نامه برخواند پیشش دبیر"
  },
  {
    "poem_id": 1758,
    "vorder": 80,
    "position": 1,
    "text": "رخ نامور گشت همچون زریر"
  },
  {
    "poem_id": 1758,
    "vorder": 81,
    "position": 0,
    "text": "هم‌اندر زمان زود پاسخ نوشت"
  },
  {
    "poem_id": 1758,
    "vorder": 82,
    "position": 1,
    "text": "سخنهای با مغز و فرخ نوشت"
  },
  {
    "poem_id": 1758,
    "vorder": 83,
    "position": 0,
    "text": "چنین گفت کای مهتر نامور"
  },
  {
    "poem_id": 1758,
    "vorder": 84,
    "position": 1,
    "text": "نگر سر نپیچی ز راه پدر"
  },
  {
    "poem_id": 1758,
    "vorder": 85,
    "position": 0,
    "text": "به نیک و بد شاه خرسند باش"
  },
  {
    "poem_id": 1758,
    "vorder": 86,
    "position": 1,
    "text": "پرستنده باش و خردمند باش"
  },
  {
    "poem_id": 1758,
    "vorder": 87,
    "position": 0,
    "text": "بدیها به صبر از مهان بگذرد"
  },
  {
    "poem_id": 1758,
    "vorder": 88,
    "position": 1,
    "text": "سر مرد باید که دارد خرد"
  },
  {
    "poem_id": 1758,
    "vorder": 89,
    "position": 0,
    "text": "سپهر روان را چنین است رای"
  },
  {
    "poem_id": 1758,
    "vorder": 90,
    "position": 1,
    "text": "تو با رای او هیچ مفزای پای"
  },
  {
    "poem_id": 1758,
    "vorder": 91,
    "position": 0,
    "text": "دلی را پر از مهر دارد سپهر"
  },
  {
    "poem_id": 1758,
    "vorder": 92,
    "position": 1,
    "text": "دلی پر ز کین و پر آژنگ چهر"
  },
  {
    "poem_id": 1758,
    "vorder": 93,
    "position": 0,
    "text": "جهاندار گیتی چنین آفرید"
  },
  {
    "poem_id": 1758,
    "vorder": 94,
    "position": 1,
    "text": "چنان کو چماند بباید چمید"
  },
  {
    "poem_id": 1758,
    "vorder": 95,
    "position": 0,
    "text": "ازین پس ترا هرچ آید به کار"
  },
  {
    "poem_id": 1758,
    "vorder": 96,
    "position": 1,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1758,
    "vorder": 97,
    "position": 0,
    "text": "فرستم نگر دل نداری به رنج"
  },
  {
    "poem_id": 1758,
    "vorder": 98,
    "position": 1,
    "text": "نیرزد پراگنده رنج تو گنج"
  },
  {
    "poem_id": 1758,
    "vorder": 99,
    "position": 0,
    "text": "ز دینار گنجی کنون ده هزار"
  },
  {
    "poem_id": 1758,
    "vorder": 100,
    "position": 1,
    "text": "فرستادم اینک ز بهر نثار"
  },
  {
    "poem_id": 1758,
    "vorder": 101,
    "position": 0,
    "text": "پرستار کو رهنمای تو بود"
  },
  {
    "poem_id": 1758,
    "vorder": 102,
    "position": 1,
    "text": "به پرده درون دلگشای تو بود"
  },
  {
    "poem_id": 1758,
    "vorder": 103,
    "position": 0,
    "text": "فرستادم اینک به نزدیک تو"
  },
  {
    "poem_id": 1758,
    "vorder": 104,
    "position": 1,
    "text": "که روشن کند جان تاریک تو"
  },
  {
    "poem_id": 1758,
    "vorder": 105,
    "position": 0,
    "text": "هرانگه که دینار بردی به کار"
  },
  {
    "poem_id": 1758,
    "vorder": 106,
    "position": 1,
    "text": "گرانی مکن هیچ بر شهریار"
  },
  {
    "poem_id": 1758,
    "vorder": 107,
    "position": 0,
    "text": "که دیگر فرستمت بسیار نیز"
  },
  {
    "poem_id": 1758,
    "vorder": 108,
    "position": 1,
    "text": "وزین پادشاهی ز هرگونه چیز"
  },
  {
    "poem_id": 1758,
    "vorder": 109,
    "position": 0,
    "text": "پرستنده باش و ستاینده باش"
  },
  {
    "poem_id": 1758,
    "vorder": 110,
    "position": 1,
    "text": "به کار پرستش فزاینده باش"
  },
  {
    "poem_id": 1758,
    "vorder": 111,
    "position": 0,
    "text": "تو آن خوی بد را ز شاه جهان"
  },
  {
    "poem_id": 1758,
    "vorder": 112,
    "position": 1,
    "text": "جدا کرد نتوانی اندر نهان"
  },
  {
    "poem_id": 1758,
    "vorder": 113,
    "position": 0,
    "text": "فرستاد زان تازیان ده سوار"
  },
  {
    "poem_id": 1758,
    "vorder": 114,
    "position": 1,
    "text": "سخن‌گوی و بینادل و دوستدار"
  },
  {
    "poem_id": 1758,
    "vorder": 115,
    "position": 0,
    "text": "رسیدند نزدیک بهرامشاه"
  },
  {
    "poem_id": 1758,
    "vorder": 116,
    "position": 1,
    "text": "ابا بدره و برده و نیک‌خواه"
  },
  {
    "poem_id": 1758,
    "vorder": 117,
    "position": 0,
    "text": "خردمند بهرام زان شاد شد"
  },
  {
    "poem_id": 1758,
    "vorder": 118,
    "position": 1,
    "text": "همه دردها بر دلش باد شد"
  },
  {
    "poem_id": 1758,
    "vorder": 119,
    "position": 0,
    "text": "وزان پس بدان پند شاه عرب"
  },
  {
    "poem_id": 1758,
    "vorder": 120,
    "position": 1,
    "text": "پرستش بدی کار او روز و شب"
  }
]