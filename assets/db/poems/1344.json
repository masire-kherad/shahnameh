[
  {
    "poem_id": 1344,
    "vorder": 1,
    "position": 0,
    "text": "چو ابلیس پیوسته دید آن سخن"
  },
  {
    "poem_id": 1344,
    "vorder": 2,
    "position": 1,
    "text": "یکی بند بد را نو افگند بن"
  },
  {
    "poem_id": 1344,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت گر سوی من تافتی"
  },
  {
    "poem_id": 1344,
    "vorder": 4,
    "position": 1,
    "text": "ز گیتی همه کام دل یافتی"
  },
  {
    "poem_id": 1344,
    "vorder": 5,
    "position": 0,
    "text": "اگر همچنین نیز پیمان کنی"
  },
  {
    "poem_id": 1344,
    "vorder": 6,
    "position": 1,
    "text": "نپیچی ز گفتار و فرمان کنی"
  },
  {
    "poem_id": 1344,
    "vorder": 7,
    "position": 0,
    "text": "جهان سربه‌سر پادشاهی تو راست"
  },
  {
    "poem_id": 1344,
    "vorder": 8,
    "position": 1,
    "text": "دد و مردم و مرغ و ماهی تو راست"
  },
  {
    "poem_id": 1344,
    "vorder": 9,
    "position": 0,
    "text": "چو این کرده شد ساز دیگر گرفت"
  },
  {
    "poem_id": 1344,
    "vorder": 10,
    "position": 1,
    "text": "یکی چاره کرد از شگفتی شگفت"
  },
  {
    "poem_id": 1344,
    "vorder": 11,
    "position": 0,
    "text": "جوانی برآراست از خویشتن"
  },
  {
    "poem_id": 1344,
    "vorder": 12,
    "position": 1,
    "text": "سخنگوی و بینا دل و رایزن"
  },
  {
    "poem_id": 1344,
    "vorder": 13,
    "position": 0,
    "text": "همیدون به ضحاک بنهاد روی"
  },
  {
    "poem_id": 1344,
    "vorder": 14,
    "position": 1,
    "text": "نبودش به جز آفرین گفت و گوی"
  },
  {
    "poem_id": 1344,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت اگر شاه را در خورم"
  },
  {
    "poem_id": 1344,
    "vorder": 16,
    "position": 1,
    "text": "یکی نامور پاک خوالیگرم"
  },
  {
    "poem_id": 1344,
    "vorder": 17,
    "position": 0,
    "text": "چو بشنید ضحاک بنواختش"
  },
  {
    "poem_id": 1344,
    "vorder": 18,
    "position": 1,
    "text": "ز بهر خورش جایگه ساختش"
  },
  {
    "poem_id": 1344,
    "vorder": 19,
    "position": 0,
    "text": "کلید خورش خانهٔ پادشا"
  },
  {
    "poem_id": 1344,
    "vorder": 20,
    "position": 1,
    "text": "بدو داد دستور فرمانروا"
  },
  {
    "poem_id": 1344,
    "vorder": 21,
    "position": 0,
    "text": "فراوان نبود آن زمان پرورش"
  },
  {
    "poem_id": 1344,
    "vorder": 22,
    "position": 1,
    "text": "که کمتر بد از خوردنی‌ها خورش"
  },
  {
    "poem_id": 1344,
    "vorder": 23,
    "position": 0,
    "text": "ز هر گوشت از مرغ و از چارپای"
  },
  {
    "poem_id": 1344,
    "vorder": 24,
    "position": 1,
    "text": "خورشگر بیاورد یک یک به جای"
  },
  {
    "poem_id": 1344,
    "vorder": 25,
    "position": 0,
    "text": "به خونش بپرورد بر سان شیر"
  },
  {
    "poem_id": 1344,
    "vorder": 26,
    "position": 1,
    "text": "بدان تا کند پادشا را دلیر"
  },
  {
    "poem_id": 1344,
    "vorder": 27,
    "position": 0,
    "text": "سخن هر چه گویدش فرمان کند"
  },
  {
    "poem_id": 1344,
    "vorder": 28,
    "position": 1,
    "text": "به فرمان او دل گروگان کند"
  },
  {
    "poem_id": 1344,
    "vorder": 29,
    "position": 0,
    "text": "خورش زردهٔ خایه دادش نخست"
  },
  {
    "poem_id": 1344,
    "vorder": 30,
    "position": 1,
    "text": "بدان داشتش یک زمان تندرست"
  },
  {
    "poem_id": 1344,
    "vorder": 31,
    "position": 0,
    "text": "بخورد و بر او آفرین کرد سخت"
  },
  {
    "poem_id": 1344,
    "vorder": 32,
    "position": 1,
    "text": "مزه یافت خواندش ورا نیک‌بخت"
  },
  {
    "poem_id": 1344,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت ابلیس نیرنگ‌ساز"
  },
  {
    "poem_id": 1344,
    "vorder": 34,
    "position": 1,
    "text": "که شادان زی ای شاه گردنفراز"
  },
  {
    "poem_id": 1344,
    "vorder": 35,
    "position": 0,
    "text": "که فردات از آن گونه سازم خورش"
  },
  {
    "poem_id": 1344,
    "vorder": 36,
    "position": 1,
    "text": "کز او باشدت سربه‌سر پرورش"
  },
  {
    "poem_id": 1344,
    "vorder": 37,
    "position": 0,
    "text": "برفت و همه شب سگالش گرفت"
  },
  {
    "poem_id": 1344,
    "vorder": 38,
    "position": 1,
    "text": "که فردا ز خوردن چه سازد شگفت"
  },
  {
    "poem_id": 1344,
    "vorder": 39,
    "position": 0,
    "text": "خورش‌ها ز کبک و تذرو سپید"
  },
  {
    "poem_id": 1344,
    "vorder": 40,
    "position": 1,
    "text": "بسازید و آمد دلی پر امید"
  },
  {
    "poem_id": 1344,
    "vorder": 41,
    "position": 0,
    "text": "شه تازیان چون به نان دست برد"
  },
  {
    "poem_id": 1344,
    "vorder": 42,
    "position": 1,
    "text": "سر کم خرد مهر او را سپرد"
  },
  {
    "poem_id": 1344,
    "vorder": 43,
    "position": 0,
    "text": "سیم روز خوان را به مرغ و بره"
  },
  {
    "poem_id": 1344,
    "vorder": 44,
    "position": 1,
    "text": "بیاراستش گونه گون یک‌سره"
  },
  {
    "poem_id": 1344,
    "vorder": 45,
    "position": 0,
    "text": "به روز چهارم چو بنهاد خوان"
  },
  {
    "poem_id": 1344,
    "vorder": 46,
    "position": 1,
    "text": "خورش ساخت از پشت گاو جوان"
  },
  {
    "poem_id": 1344,
    "vorder": 47,
    "position": 0,
    "text": "بدو اندرون زعفران و گلاب"
  },
  {
    "poem_id": 1344,
    "vorder": 48,
    "position": 1,
    "text": "همان سالخورده می و مشک ناب"
  },
  {
    "poem_id": 1344,
    "vorder": 49,
    "position": 0,
    "text": "چو ضحاک دست اندر آورد و خورد"
  },
  {
    "poem_id": 1344,
    "vorder": 50,
    "position": 1,
    "text": "شگفت آمدش زان هشیوار مرد"
  },
  {
    "poem_id": 1344,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت بنگر که از آرزوی"
  },
  {
    "poem_id": 1344,
    "vorder": 52,
    "position": 1,
    "text": "چه خواهی بگو با من ای نیک‌خوی"
  },
  {
    "poem_id": 1344,
    "vorder": 53,
    "position": 0,
    "text": "خورشگر بدو گفت کای پادشا"
  },
  {
    "poem_id": 1344,
    "vorder": 54,
    "position": 1,
    "text": "همیشه بزی شاد و فرمانروا"
  },
  {
    "poem_id": 1344,
    "vorder": 55,
    "position": 0,
    "text": "مرا دل سراسر پر از مهر تو است"
  },
  {
    "poem_id": 1344,
    "vorder": 56,
    "position": 1,
    "text": "همه توشهٔ جانم از چهر تو است"
  },
  {
    "poem_id": 1344,
    "vorder": 57,
    "position": 0,
    "text": "یکی حاجتستم به نزدیک شاه"
  },
  {
    "poem_id": 1344,
    "vorder": 58,
    "position": 1,
    "text": "و گرچه مرا نیست این پایگاه"
  },
  {
    "poem_id": 1344,
    "vorder": 59,
    "position": 0,
    "text": "که فرمان دهد تا سر کتف اوی"
  },
  {
    "poem_id": 1344,
    "vorder": 60,
    "position": 1,
    "text": "ببوسم بدو بر نهم چشم و روی"
  },
  {
    "poem_id": 1344,
    "vorder": 61,
    "position": 0,
    "text": "چو ضحاک بشنید گفتار اوی"
  },
  {
    "poem_id": 1344,
    "vorder": 62,
    "position": 1,
    "text": "نهانی ندانست بازار اوی"
  },
  {
    "poem_id": 1344,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت دارم من این کام تو"
  },
  {
    "poem_id": 1344,
    "vorder": 64,
    "position": 1,
    "text": "بلندی بگیرد از این نام تو"
  },
  {
    "poem_id": 1344,
    "vorder": 65,
    "position": 0,
    "text": "بفرمود تا دیو چون جفت او"
  },
  {
    "poem_id": 1344,
    "vorder": 66,
    "position": 1,
    "text": "همی بوسه داد از بر سفت او"
  },
  {
    "poem_id": 1344,
    "vorder": 67,
    "position": 0,
    "text": "ببوسید و شد بر زمین ناپدید"
  },
  {
    "poem_id": 1344,
    "vorder": 68,
    "position": 1,
    "text": "کس اندر جهان این شگفتی ندید"
  },
  {
    "poem_id": 1344,
    "vorder": 69,
    "position": 0,
    "text": "دو مار سیه از دو کتفش برست"
  },
  {
    "poem_id": 1344,
    "vorder": 70,
    "position": 1,
    "text": "غمی گشت و از هر سویی چاره جست"
  },
  {
    "poem_id": 1344,
    "vorder": 71,
    "position": 0,
    "text": "سرانجام ببرید هر دو ز کفت"
  },
  {
    "poem_id": 1344,
    "vorder": 72,
    "position": 1,
    "text": "سزد گر بمانی بدین در شگفت"
  },
  {
    "poem_id": 1344,
    "vorder": 73,
    "position": 0,
    "text": "چو شاخ درخت آن دو مار سیاه"
  },
  {
    "poem_id": 1344,
    "vorder": 74,
    "position": 1,
    "text": "برآمد دگر باره از کتف شاه"
  },
  {
    "poem_id": 1344,
    "vorder": 75,
    "position": 0,
    "text": "پزشکان فرزانه گرد آمدند"
  },
  {
    "poem_id": 1344,
    "vorder": 76,
    "position": 1,
    "text": "همه یک به یک داستان‌ها زدند"
  },
  {
    "poem_id": 1344,
    "vorder": 77,
    "position": 0,
    "text": "ز هر گونه نیرنگ‌ها ساختند"
  },
  {
    "poem_id": 1344,
    "vorder": 78,
    "position": 1,
    "text": "مر آن درد را چاره نشناختند"
  },
  {
    "poem_id": 1344,
    "vorder": 79,
    "position": 0,
    "text": "به سان پزشکی پس ابلیس تفت"
  },
  {
    "poem_id": 1344,
    "vorder": 80,
    "position": 1,
    "text": "به فرزانگی نزد ضحاک رفت"
  },
  {
    "poem_id": 1344,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت کاین بودنی کار بود"
  },
  {
    "poem_id": 1344,
    "vorder": 82,
    "position": 1,
    "text": "بمان تا چه گردد نباید درود"
  },
  {
    "poem_id": 1344,
    "vorder": 83,
    "position": 0,
    "text": "خورش ساز و آرامشان ده به خورد"
  },
  {
    "poem_id": 1344,
    "vorder": 84,
    "position": 1,
    "text": "نباید جز این چاره‌ای نیز کرد"
  },
  {
    "poem_id": 1344,
    "vorder": 85,
    "position": 0,
    "text": "به جز مغز مردم مده‌شان خورش"
  },
  {
    "poem_id": 1344,
    "vorder": 86,
    "position": 1,
    "text": "مگر خود بمیرند از این پرورش"
  },
  {
    "poem_id": 1344,
    "vorder": 87,
    "position": 0,
    "text": "نگر تا که ابلیس از این گفت‌وگوی"
  },
  {
    "poem_id": 1344,
    "vorder": 88,
    "position": 1,
    "text": "چه کرد و چه خواست اندر این جستجوی"
  },
  {
    "poem_id": 1344,
    "vorder": 89,
    "position": 0,
    "text": "مگر تا یکی چاره سازد نهان"
  },
  {
    "poem_id": 1344,
    "vorder": 90,
    "position": 1,
    "text": "که پردخته گردد ز مردم جهان"
  }
]