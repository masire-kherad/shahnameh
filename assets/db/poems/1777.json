[
  {
    "poem_id": 1777,
    "vorder": 1,
    "position": 0,
    "text": "برین‌گونه بگذشت سالی تمام"
  },
  {
    "poem_id": 1777,
    "vorder": 2,
    "position": 1,
    "text": "همی داشتی هرکسی می حرام"
  },
  {
    "poem_id": 1777,
    "vorder": 3,
    "position": 0,
    "text": "همان شه چو مجلس بیاراستی"
  },
  {
    "poem_id": 1777,
    "vorder": 4,
    "position": 1,
    "text": "همان نامهٔ باستان خواستی"
  },
  {
    "poem_id": 1777,
    "vorder": 5,
    "position": 0,
    "text": "چنین بود تا کودکی کفشگر"
  },
  {
    "poem_id": 1777,
    "vorder": 6,
    "position": 1,
    "text": "زنی خواست با چیز و نام و گهر"
  },
  {
    "poem_id": 1777,
    "vorder": 7,
    "position": 0,
    "text": "نبودش دران کار افزار سخت"
  },
  {
    "poem_id": 1777,
    "vorder": 8,
    "position": 1,
    "text": "همی زار بگریست مامش ز بخت"
  },
  {
    "poem_id": 1777,
    "vorder": 9,
    "position": 0,
    "text": "همانا نهان داشت لختی نبید"
  },
  {
    "poem_id": 1777,
    "vorder": 10,
    "position": 1,
    "text": "پسر را بدان خانه اندر کشید"
  },
  {
    "poem_id": 1777,
    "vorder": 11,
    "position": 0,
    "text": "به پور جوان گفت کاین هفت جام"
  },
  {
    "poem_id": 1777,
    "vorder": 12,
    "position": 1,
    "text": "بخور تا شوی ایمن و شادکام"
  },
  {
    "poem_id": 1777,
    "vorder": 13,
    "position": 0,
    "text": "مگر بشکنی امشب آن مهر تنگ"
  },
  {
    "poem_id": 1777,
    "vorder": 14,
    "position": 1,
    "text": "کلنگ از نمد کی کند کان سنگ"
  },
  {
    "poem_id": 1777,
    "vorder": 15,
    "position": 0,
    "text": "بزد کفشگر جام می هفت و هشت"
  },
  {
    "poem_id": 1777,
    "vorder": 16,
    "position": 1,
    "text": "هم‌اندر زمان آتشش سخت گشت"
  },
  {
    "poem_id": 1777,
    "vorder": 17,
    "position": 0,
    "text": "جوانمرد را جام گستاخ کرد"
  },
  {
    "poem_id": 1777,
    "vorder": 18,
    "position": 1,
    "text": "بیامد در خانه سوراخ کرد"
  },
  {
    "poem_id": 1777,
    "vorder": 19,
    "position": 0,
    "text": "وزان جایگه شد به درگاه خویش"
  },
  {
    "poem_id": 1777,
    "vorder": 20,
    "position": 1,
    "text": "شده شاددل یافته راه خویش"
  },
  {
    "poem_id": 1777,
    "vorder": 21,
    "position": 0,
    "text": "چنان بد که از خانه شیران شاه"
  },
  {
    "poem_id": 1777,
    "vorder": 22,
    "position": 1,
    "text": "یکی شیر بگسست و آمد به راه"
  },
  {
    "poem_id": 1777,
    "vorder": 23,
    "position": 0,
    "text": "ازان می همی کفشگر مست بود"
  },
  {
    "poem_id": 1777,
    "vorder": 24,
    "position": 1,
    "text": "به دیده ندید آنچ بایست بود"
  },
  {
    "poem_id": 1777,
    "vorder": 25,
    "position": 0,
    "text": "بشد تیز و بر شیر غران نشست"
  },
  {
    "poem_id": 1777,
    "vorder": 26,
    "position": 1,
    "text": "بیازید و بگرفت گوشش به دست"
  },
  {
    "poem_id": 1777,
    "vorder": 27,
    "position": 0,
    "text": "بران شیر غران پسر شیر بود"
  },
  {
    "poem_id": 1777,
    "vorder": 28,
    "position": 1,
    "text": "جوان از بر و شیر در زیر بود"
  },
  {
    "poem_id": 1777,
    "vorder": 29,
    "position": 0,
    "text": "همی شد دوان شیروان چون نوند"
  },
  {
    "poem_id": 1777,
    "vorder": 30,
    "position": 1,
    "text": "به یک دست زنجیر و دیگر کمند"
  },
  {
    "poem_id": 1777,
    "vorder": 31,
    "position": 0,
    "text": "چو آن شیربان جهاندار شاه"
  },
  {
    "poem_id": 1777,
    "vorder": 32,
    "position": 1,
    "text": "بیامد ز خانه بدان جایگاه"
  },
  {
    "poem_id": 1777,
    "vorder": 33,
    "position": 0,
    "text": "یکی کفشگر دید بر پشت شیر"
  },
  {
    "poem_id": 1777,
    "vorder": 34,
    "position": 1,
    "text": "نشسته چو بر خر سواری دلیر"
  },
  {
    "poem_id": 1777,
    "vorder": 35,
    "position": 0,
    "text": "بیامد دوان تا در بارگاه"
  },
  {
    "poem_id": 1777,
    "vorder": 36,
    "position": 1,
    "text": "دلیر اندر آمد به نزدیک شاه"
  },
  {
    "poem_id": 1777,
    "vorder": 37,
    "position": 0,
    "text": "بگفت آن دلیری کزو دیده بود"
  },
  {
    "poem_id": 1777,
    "vorder": 38,
    "position": 1,
    "text": "به دیده بدید آنچ نشنیده بود"
  },
  {
    "poem_id": 1777,
    "vorder": 39,
    "position": 0,
    "text": "جهاندار زان در شگفتی بماند"
  },
  {
    "poem_id": 1777,
    "vorder": 40,
    "position": 1,
    "text": "همه موبدان و ردان را بخواند"
  },
  {
    "poem_id": 1777,
    "vorder": 41,
    "position": 0,
    "text": "به موبد چنین گفت کاین کفشگر"
  },
  {
    "poem_id": 1777,
    "vorder": 42,
    "position": 1,
    "text": "نگه کن که تا از که دارد گهر"
  },
  {
    "poem_id": 1777,
    "vorder": 43,
    "position": 0,
    "text": "همان مادرش چون سخن شد دراز"
  },
  {
    "poem_id": 1777,
    "vorder": 44,
    "position": 1,
    "text": "دوان شد بر شاه و بگشاد راز"
  },
  {
    "poem_id": 1777,
    "vorder": 45,
    "position": 0,
    "text": "نخست آفرین کرد بر شهریار"
  },
  {
    "poem_id": 1777,
    "vorder": 46,
    "position": 1,
    "text": "که شادان بزی تا بود روزگار"
  },
  {
    "poem_id": 1777,
    "vorder": 47,
    "position": 0,
    "text": "چنین گفت کاین نورسیده به جای"
  },
  {
    "poem_id": 1777,
    "vorder": 48,
    "position": 1,
    "text": "یکی زن گزین کرد و شد کدخدای"
  },
  {
    "poem_id": 1777,
    "vorder": 49,
    "position": 0,
    "text": "به کار اندرون نایژه سست بود"
  },
  {
    "poem_id": 1777,
    "vorder": 50,
    "position": 1,
    "text": "دلش گفتی از سست خودرست بود"
  },
  {
    "poem_id": 1777,
    "vorder": 51,
    "position": 0,
    "text": "بدادم سه جام نبیدش نهان"
  },
  {
    "poem_id": 1777,
    "vorder": 52,
    "position": 1,
    "text": "که ماند کس از تخم او در جهان"
  },
  {
    "poem_id": 1777,
    "vorder": 53,
    "position": 0,
    "text": "هم‌اندر زمان لعل گشتش رخان"
  },
  {
    "poem_id": 1777,
    "vorder": 54,
    "position": 1,
    "text": "نمد سر برآورد و گشت استخوان"
  },
  {
    "poem_id": 1777,
    "vorder": 55,
    "position": 0,
    "text": "نژادش نبد جز سه جام نبید"
  },
  {
    "poem_id": 1777,
    "vorder": 56,
    "position": 1,
    "text": "که دانست کاین شاه خواهد شنید"
  },
  {
    "poem_id": 1777,
    "vorder": 57,
    "position": 0,
    "text": "بخندید زان پیرزن شاه گفت"
  },
  {
    "poem_id": 1777,
    "vorder": 58,
    "position": 1,
    "text": "که این داستان را نشاید نهفت"
  },
  {
    "poem_id": 1777,
    "vorder": 59,
    "position": 0,
    "text": "به موبد چنین گفت کاکنون نبید"
  },
  {
    "poem_id": 1777,
    "vorder": 60,
    "position": 1,
    "text": "حلالست میخواره باید گزید"
  },
  {
    "poem_id": 1777,
    "vorder": 61,
    "position": 0,
    "text": "که چندان خورد می که بر نره شیر"
  },
  {
    "poem_id": 1777,
    "vorder": 62,
    "position": 1,
    "text": "نشیند نیارد ورا شیر زیر"
  },
  {
    "poem_id": 1777,
    "vorder": 63,
    "position": 0,
    "text": "نه چندان که چشمش کلاغ سیاه"
  },
  {
    "poem_id": 1777,
    "vorder": 64,
    "position": 1,
    "text": "همی برکند رفته از نزد شاه"
  },
  {
    "poem_id": 1777,
    "vorder": 65,
    "position": 0,
    "text": "خروشی برآمد هم‌انگه ز در"
  },
  {
    "poem_id": 1777,
    "vorder": 66,
    "position": 1,
    "text": "که ای پهلوانان زرین کمر"
  },
  {
    "poem_id": 1777,
    "vorder": 67,
    "position": 0,
    "text": "به اندازه‌بر هرکسی می خورید"
  },
  {
    "poem_id": 1777,
    "vorder": 68,
    "position": 1,
    "text": "به آغاز و فرجام خود بنگرید"
  },
  {
    "poem_id": 1777,
    "vorder": 69,
    "position": 0,
    "text": "چو می‌تان به شادی بود رهنمون"
  },
  {
    "poem_id": 1777,
    "vorder": 70,
    "position": 1,
    "text": "بکوشید تا تن نگردد زبون"
  }
]