[
  {
    "poem_id": 1574,
    "vorder": 1,
    "position": 0,
    "text": "چو آن نامه برخواند اسفندیار"
  },
  {
    "poem_id": 1574,
    "vorder": 2,
    "position": 1,
    "text": "ببخشید دینار و برساخت کار"
  },
  {
    "poem_id": 1574,
    "vorder": 3,
    "position": 0,
    "text": "جز از گنج ارجاسپ چیزی نماند"
  },
  {
    "poem_id": 1574,
    "vorder": 4,
    "position": 1,
    "text": "همه گنج خویشان او برفشاند"
  },
  {
    "poem_id": 1574,
    "vorder": 5,
    "position": 0,
    "text": "سپاهش همه زو توانگر شدند"
  },
  {
    "poem_id": 1574,
    "vorder": 6,
    "position": 1,
    "text": "از اندازهٔ کار برتر شدند"
  },
  {
    "poem_id": 1574,
    "vorder": 7,
    "position": 0,
    "text": "شتر بود و اسپان به دشت و به کوه"
  },
  {
    "poem_id": 1574,
    "vorder": 8,
    "position": 1,
    "text": "به داغ سپهدار توران گروه"
  },
  {
    "poem_id": 1574,
    "vorder": 9,
    "position": 0,
    "text": "هیون خواست از هر دری ده‌هزار"
  },
  {
    "poem_id": 1574,
    "vorder": 10,
    "position": 1,
    "text": "پراگنده از دشت وز کوهسار"
  },
  {
    "poem_id": 1574,
    "vorder": 11,
    "position": 0,
    "text": "همه گنج ارجاسپ در باز کرد"
  },
  {
    "poem_id": 1574,
    "vorder": 12,
    "position": 1,
    "text": "به کپان درم سختن آغاز کرد"
  },
  {
    "poem_id": 1574,
    "vorder": 13,
    "position": 0,
    "text": "هزار اشتر از گنج دینار شاه"
  },
  {
    "poem_id": 1574,
    "vorder": 14,
    "position": 1,
    "text": "چو سیصد ز دیبا و تخت و کلاه"
  },
  {
    "poem_id": 1574,
    "vorder": 15,
    "position": 0,
    "text": "صد از مشک و ز عنبر و گوهران"
  },
  {
    "poem_id": 1574,
    "vorder": 16,
    "position": 1,
    "text": "صد از تاج وز نامدار افسران"
  },
  {
    "poem_id": 1574,
    "vorder": 17,
    "position": 0,
    "text": "از افگندنیهای دیبا هزار"
  },
  {
    "poem_id": 1574,
    "vorder": 18,
    "position": 1,
    "text": "بفرمود تا برنهادند بار"
  },
  {
    "poem_id": 1574,
    "vorder": 19,
    "position": 0,
    "text": "چو سیصد شتر جامهٔ چینیان"
  },
  {
    "poem_id": 1574,
    "vorder": 20,
    "position": 1,
    "text": "ز منسوج و زربفت وز پرنیان"
  },
  {
    "poem_id": 1574,
    "vorder": 21,
    "position": 0,
    "text": "عماری بسیچید و دیبا جلیل"
  },
  {
    "poem_id": 1574,
    "vorder": 22,
    "position": 1,
    "text": "کنیزک ببردند چینی دو خیل"
  },
  {
    "poem_id": 1574,
    "vorder": 23,
    "position": 0,
    "text": "به رخ چون بهار و به بالا چو سرو"
  },
  {
    "poem_id": 1574,
    "vorder": 24,
    "position": 1,
    "text": "میانها چو غرو و به رفتن تذرو"
  },
  {
    "poem_id": 1574,
    "vorder": 25,
    "position": 0,
    "text": "ابا خواهران یل اسفندیار"
  },
  {
    "poem_id": 1574,
    "vorder": 26,
    "position": 1,
    "text": "برفتند بت روی صد نامدار"
  },
  {
    "poem_id": 1574,
    "vorder": 27,
    "position": 0,
    "text": "ز پوشیده رویان ارجاسپ پنج"
  },
  {
    "poem_id": 1574,
    "vorder": 28,
    "position": 1,
    "text": "ببردند بامویه و درد و رنج"
  },
  {
    "poem_id": 1574,
    "vorder": 29,
    "position": 0,
    "text": "دو خواهر دو دختر یکی مادرش"
  },
  {
    "poem_id": 1574,
    "vorder": 30,
    "position": 1,
    "text": "پر از درد و با سوک و خسته برش"
  },
  {
    "poem_id": 1574,
    "vorder": 31,
    "position": 0,
    "text": "چو آتش به رویین دژ اندر فگند"
  },
  {
    "poem_id": 1574,
    "vorder": 32,
    "position": 1,
    "text": "زبانه برآمد به چرخ بلند"
  },
  {
    "poem_id": 1574,
    "vorder": 33,
    "position": 0,
    "text": "همه بارهٔ شهر زد بر زمین"
  },
  {
    "poem_id": 1574,
    "vorder": 34,
    "position": 1,
    "text": "برآورد گرد از بر و بوم چین"
  },
  {
    "poem_id": 1574,
    "vorder": 35,
    "position": 0,
    "text": "سه پور جوان را سپهدار گفت"
  },
  {
    "poem_id": 1574,
    "vorder": 36,
    "position": 1,
    "text": "پراگنده باشید با گنج جفت"
  },
  {
    "poem_id": 1574,
    "vorder": 37,
    "position": 0,
    "text": "به راه ار کسی سر بپیچد ز داد"
  },
  {
    "poem_id": 1574,
    "vorder": 38,
    "position": 1,
    "text": "سرانشان به خنجر ببرید شاد"
  },
  {
    "poem_id": 1574,
    "vorder": 39,
    "position": 0,
    "text": "شما راه سوی بیابان برید"
  },
  {
    "poem_id": 1574,
    "vorder": 40,
    "position": 1,
    "text": "سنانها چو خورشید تابان برید"
  },
  {
    "poem_id": 1574,
    "vorder": 41,
    "position": 0,
    "text": "سوی هفتخوان من به نخجیر شیر"
  },
  {
    "poem_id": 1574,
    "vorder": 42,
    "position": 1,
    "text": "بیابم شما ره مپویید دیر"
  },
  {
    "poem_id": 1574,
    "vorder": 43,
    "position": 0,
    "text": "نخستین بگیرم سر راه را"
  },
  {
    "poem_id": 1574,
    "vorder": 44,
    "position": 1,
    "text": "ببینم شما را سر ماه را"
  },
  {
    "poem_id": 1574,
    "vorder": 45,
    "position": 0,
    "text": "سوی هفتخوان آمد اسفندیار"
  },
  {
    "poem_id": 1574,
    "vorder": 46,
    "position": 1,
    "text": "به نخجیر با لشکری نامدار"
  },
  {
    "poem_id": 1574,
    "vorder": 47,
    "position": 0,
    "text": "چو نزدیک آن جای سرما رسید"
  },
  {
    "poem_id": 1574,
    "vorder": 48,
    "position": 1,
    "text": "همه خواسته گرد بر جای دید"
  },
  {
    "poem_id": 1574,
    "vorder": 49,
    "position": 0,
    "text": "هوا خوش‌گوار و زمین پرنگار"
  },
  {
    "poem_id": 1574,
    "vorder": 50,
    "position": 1,
    "text": "تو گفتی به تیر اندر آمد بهار"
  },
  {
    "poem_id": 1574,
    "vorder": 51,
    "position": 0,
    "text": "وزان جایگه خواسته برگرفت"
  },
  {
    "poem_id": 1574,
    "vorder": 52,
    "position": 1,
    "text": "همی ماند از کار اختر شگفت"
  },
  {
    "poem_id": 1574,
    "vorder": 53,
    "position": 0,
    "text": "چو نزدیکی شهر ایران رسید"
  },
  {
    "poem_id": 1574,
    "vorder": 54,
    "position": 1,
    "text": "به جای دلیران و شیران رسید"
  },
  {
    "poem_id": 1574,
    "vorder": 55,
    "position": 0,
    "text": "دو هفته همی بود با یوز و باز"
  },
  {
    "poem_id": 1574,
    "vorder": 56,
    "position": 1,
    "text": "غمی بود از رنج راه دراز"
  },
  {
    "poem_id": 1574,
    "vorder": 57,
    "position": 0,
    "text": "سه فرزند پرمایه را چشم داشت"
  },
  {
    "poem_id": 1574,
    "vorder": 58,
    "position": 1,
    "text": "ز دیر آمدنشان به دل خشم داشت"
  },
  {
    "poem_id": 1574,
    "vorder": 59,
    "position": 0,
    "text": "به نزد پدر چو بیامد پسر"
  },
  {
    "poem_id": 1574,
    "vorder": 60,
    "position": 1,
    "text": "بخندید با هر یکی تاجور"
  },
  {
    "poem_id": 1574,
    "vorder": 61,
    "position": 0,
    "text": "که راهی درشت این که من کوفتم"
  },
  {
    "poem_id": 1574,
    "vorder": 62,
    "position": 1,
    "text": "ز دیر آمدنتان برآشوفتم"
  },
  {
    "poem_id": 1574,
    "vorder": 63,
    "position": 0,
    "text": "زمین بوسه دادند هر سه پسر"
  },
  {
    "poem_id": 1574,
    "vorder": 64,
    "position": 1,
    "text": "که چون تو که باشد به گیتی پدر"
  },
  {
    "poem_id": 1574,
    "vorder": 65,
    "position": 0,
    "text": "وزان جایگه سوی ایران کشید"
  },
  {
    "poem_id": 1574,
    "vorder": 66,
    "position": 1,
    "text": "همه گنج سوی دلیران کشید"
  },
  {
    "poem_id": 1574,
    "vorder": 67,
    "position": 0,
    "text": "همه شهر ایران بیاراستند"
  },
  {
    "poem_id": 1574,
    "vorder": 68,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1574,
    "vorder": 69,
    "position": 0,
    "text": "ز دیوارها جامه آویختند"
  },
  {
    "poem_id": 1574,
    "vorder": 70,
    "position": 1,
    "text": "زبر مشک و عنبر همی بیختند"
  },
  {
    "poem_id": 1574,
    "vorder": 71,
    "position": 0,
    "text": "هوا پر ز آوای رامشگران"
  },
  {
    "poem_id": 1574,
    "vorder": 72,
    "position": 1,
    "text": "زمین پر سواران نیزه‌وران"
  },
  {
    "poem_id": 1574,
    "vorder": 73,
    "position": 0,
    "text": "چو گشتاسپ بشنید رامش گزید"
  },
  {
    "poem_id": 1574,
    "vorder": 74,
    "position": 1,
    "text": "به آواز او جام می درکشید"
  },
  {
    "poem_id": 1574,
    "vorder": 75,
    "position": 0,
    "text": "ز لشکر بفرمود تا هرک بود"
  },
  {
    "poem_id": 1574,
    "vorder": 76,
    "position": 1,
    "text": "ز کشور کسی کو بزرگی نمود"
  },
  {
    "poem_id": 1574,
    "vorder": 77,
    "position": 0,
    "text": "همه با درفش و تبیره شدند"
  },
  {
    "poem_id": 1574,
    "vorder": 78,
    "position": 1,
    "text": "بزرگان لشکر پذیره شدند"
  },
  {
    "poem_id": 1574,
    "vorder": 79,
    "position": 0,
    "text": "پدر رفت با نامور بخردان"
  },
  {
    "poem_id": 1574,
    "vorder": 80,
    "position": 1,
    "text": "بزرگان فرزانه و موبدان"
  },
  {
    "poem_id": 1574,
    "vorder": 81,
    "position": 0,
    "text": "بیامد به پیش پسر تازه‌روی"
  },
  {
    "poem_id": 1574,
    "vorder": 82,
    "position": 1,
    "text": "همه شهر ایران پر از گفت و گوی"
  },
  {
    "poem_id": 1574,
    "vorder": 83,
    "position": 0,
    "text": "چو روی پدر دید شاه جوان"
  },
  {
    "poem_id": 1574,
    "vorder": 84,
    "position": 1,
    "text": "دلش گشت شادان و روشن‌روان"
  },
  {
    "poem_id": 1574,
    "vorder": 85,
    "position": 0,
    "text": "برانگیخت از جای شبرنگ را"
  },
  {
    "poem_id": 1574,
    "vorder": 86,
    "position": 1,
    "text": "فروزندهٔ آتش جنگ را"
  },
  {
    "poem_id": 1574,
    "vorder": 87,
    "position": 0,
    "text": "بیامد پدر را به بر در گرفت"
  },
  {
    "poem_id": 1574,
    "vorder": 88,
    "position": 1,
    "text": "پدر ماند از کار او در شگفت"
  },
  {
    "poem_id": 1574,
    "vorder": 89,
    "position": 0,
    "text": "بسی خواند بر فر او آفرین"
  },
  {
    "poem_id": 1574,
    "vorder": 90,
    "position": 1,
    "text": "که بی‌تو مبادا زمان و زمین"
  },
  {
    "poem_id": 1574,
    "vorder": 91,
    "position": 0,
    "text": "وزانجا به ایوان شاه آمدند"
  },
  {
    "poem_id": 1574,
    "vorder": 92,
    "position": 1,
    "text": "جهانی ورا نیکخواه آمدند"
  },
  {
    "poem_id": 1574,
    "vorder": 93,
    "position": 0,
    "text": "بیاراست گشتاسپ ایوان و تخت"
  },
  {
    "poem_id": 1574,
    "vorder": 94,
    "position": 1,
    "text": "دلش گشت خرم بدان نیک‌بخت"
  },
  {
    "poem_id": 1574,
    "vorder": 95,
    "position": 0,
    "text": "به ایوانها در نهادند خوان"
  },
  {
    "poem_id": 1574,
    "vorder": 96,
    "position": 1,
    "text": "به سالار گفتا مهان را بخوان"
  },
  {
    "poem_id": 1574,
    "vorder": 97,
    "position": 0,
    "text": "بیامد ز هر گنبدی میگسار"
  },
  {
    "poem_id": 1574,
    "vorder": 98,
    "position": 1,
    "text": "به نزدیک آن نامور شهریار"
  },
  {
    "poem_id": 1574,
    "vorder": 99,
    "position": 0,
    "text": "می خسروانی به جام بلور"
  },
  {
    "poem_id": 1574,
    "vorder": 100,
    "position": 1,
    "text": "گسارنده می داد رخشان چو هور"
  },
  {
    "poem_id": 1574,
    "vorder": 101,
    "position": 0,
    "text": "همه چهرهٔ دوستان برفروخت"
  },
  {
    "poem_id": 1574,
    "vorder": 102,
    "position": 1,
    "text": "دل دشمنان را به آتش بسوخت"
  },
  {
    "poem_id": 1574,
    "vorder": 103,
    "position": 0,
    "text": "پسر خورد با شرم یاد پدر"
  },
  {
    "poem_id": 1574,
    "vorder": 104,
    "position": 1,
    "text": "پدر همچنان نیز یاد پسر"
  },
  {
    "poem_id": 1574,
    "vorder": 105,
    "position": 0,
    "text": "بپرسید گشتاسپ از هفتخوان"
  },
  {
    "poem_id": 1574,
    "vorder": 106,
    "position": 1,
    "text": "پدر را پسر گفت نامه بخوان"
  },
  {
    "poem_id": 1574,
    "vorder": 107,
    "position": 0,
    "text": "سخنهای دیرینه یاد آوریم"
  },
  {
    "poem_id": 1574,
    "vorder": 108,
    "position": 1,
    "text": "به گفتار لب را به داد آوریم"
  },
  {
    "poem_id": 1574,
    "vorder": 109,
    "position": 0,
    "text": "چو فردا به هشیاری آن بشنوی"
  },
  {
    "poem_id": 1574,
    "vorder": 110,
    "position": 1,
    "text": "به پیروزی دادگر بگروی"
  },
  {
    "poem_id": 1574,
    "vorder": 111,
    "position": 0,
    "text": "برفتند هرکس که گشتند مست"
  },
  {
    "poem_id": 1574,
    "vorder": 112,
    "position": 1,
    "text": "یکی ماه‌رخ دست ایشان به دست"
  },
  {
    "poem_id": 1574,
    "vorder": 113,
    "position": 0,
    "text": "سرآمد کنون قصهٔ هفتخوان"
  },
  {
    "poem_id": 1574,
    "vorder": 114,
    "position": 1,
    "text": "به نام جهان داور این را بخوان"
  },
  {
    "poem_id": 1574,
    "vorder": 115,
    "position": 0,
    "text": "که او داد بر نیک و بد دستگاه"
  },
  {
    "poem_id": 1574,
    "vorder": 116,
    "position": 1,
    "text": "خداوند خورشید و تابنده ماه"
  },
  {
    "poem_id": 1574,
    "vorder": 117,
    "position": 0,
    "text": "اگر شاه پیروز بپسندد این"
  },
  {
    "poem_id": 1574,
    "vorder": 118,
    "position": 1,
    "text": "نهادیم بر چرخ گردنده زین"
  }
]