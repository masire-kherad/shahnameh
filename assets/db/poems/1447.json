[
  {
    "poem_id": 1447,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس چنین کرد کاووس رای"
  },
  {
    "poem_id": 1447,
    "vorder": 2,
    "position": 1,
    "text": "که در پادشاهی بجنبد ز جای"
  },
  {
    "poem_id": 1447,
    "vorder": 3,
    "position": 0,
    "text": "از ایران بشد تا به توران و چین"
  },
  {
    "poem_id": 1447,
    "vorder": 4,
    "position": 1,
    "text": "گذر کرد ازان پس به مکران زمین"
  },
  {
    "poem_id": 1447,
    "vorder": 5,
    "position": 0,
    "text": "ز مکران شد آراسته تا زره"
  },
  {
    "poem_id": 1447,
    "vorder": 6,
    "position": 1,
    "text": "میانها ندید ایچ رنج از گره"
  },
  {
    "poem_id": 1447,
    "vorder": 7,
    "position": 0,
    "text": "پذیرفت هر مهتری باژ و ساو"
  },
  {
    "poem_id": 1447,
    "vorder": 8,
    "position": 1,
    "text": "نکرد آزمون گاو با شیر تاو"
  },
  {
    "poem_id": 1447,
    "vorder": 9,
    "position": 0,
    "text": "چنین هم گرازان به بربر شدند"
  },
  {
    "poem_id": 1447,
    "vorder": 10,
    "position": 1,
    "text": "جهانجوی با تخت و افسر شدند"
  },
  {
    "poem_id": 1447,
    "vorder": 11,
    "position": 0,
    "text": "شه بربرستان بیاراست جنگ"
  },
  {
    "poem_id": 1447,
    "vorder": 12,
    "position": 1,
    "text": "زمانه دگرگونه‌تر شد به رنگ"
  },
  {
    "poem_id": 1447,
    "vorder": 13,
    "position": 0,
    "text": "سپاهی بیامد ز بربر به رزم"
  },
  {
    "poem_id": 1447,
    "vorder": 14,
    "position": 1,
    "text": "که برخاست از لشکر شاه بزم"
  },
  {
    "poem_id": 1447,
    "vorder": 15,
    "position": 0,
    "text": "هوا گفتی از نیزه چون بیشه گشت"
  },
  {
    "poem_id": 1447,
    "vorder": 16,
    "position": 1,
    "text": "خور از گرد اسپان پراندیشه گشت"
  },
  {
    "poem_id": 1447,
    "vorder": 17,
    "position": 0,
    "text": "ز گرد سپه پیل شد ناپدید"
  },
  {
    "poem_id": 1447,
    "vorder": 18,
    "position": 1,
    "text": "کس از خاک دست و عنان را ندید"
  },
  {
    "poem_id": 1447,
    "vorder": 19,
    "position": 0,
    "text": "به زخم اندر آمد همی فوج فوج"
  },
  {
    "poem_id": 1447,
    "vorder": 20,
    "position": 1,
    "text": "بران سان که برخیزد از آب موج"
  },
  {
    "poem_id": 1447,
    "vorder": 21,
    "position": 0,
    "text": "چو گودرز گیتی بران گونه دید"
  },
  {
    "poem_id": 1447,
    "vorder": 22,
    "position": 1,
    "text": "عمود گران از میان برکشید"
  },
  {
    "poem_id": 1447,
    "vorder": 23,
    "position": 0,
    "text": "بزد اسپ با نامداران هزار"
  },
  {
    "poem_id": 1447,
    "vorder": 24,
    "position": 1,
    "text": "ابا نیزه و تیر جوشن گذار"
  },
  {
    "poem_id": 1447,
    "vorder": 25,
    "position": 0,
    "text": "برآویخت و بدرید قلب سپاه"
  },
  {
    "poem_id": 1447,
    "vorder": 26,
    "position": 1,
    "text": "دمان از پس اندر همی رفت شاه"
  },
  {
    "poem_id": 1447,
    "vorder": 27,
    "position": 0,
    "text": "تو گفتی ز بربر سواری نماند"
  },
  {
    "poem_id": 1447,
    "vorder": 28,
    "position": 1,
    "text": "به گرد اندرون نیزه‌داری نماند"
  },
  {
    "poem_id": 1447,
    "vorder": 29,
    "position": 0,
    "text": "به شهر اندرون هرکه بد سالخورد"
  },
  {
    "poem_id": 1447,
    "vorder": 30,
    "position": 1,
    "text": "چو برگشته دیدند باد نبرد"
  },
  {
    "poem_id": 1447,
    "vorder": 31,
    "position": 0,
    "text": "همه پیش کاووس شاه آمدند"
  },
  {
    "poem_id": 1447,
    "vorder": 32,
    "position": 1,
    "text": "جگرخسته و پرگناه آمدند"
  },
  {
    "poem_id": 1447,
    "vorder": 33,
    "position": 0,
    "text": "که ما شاه را چاکر و بنده‌ایم"
  },
  {
    "poem_id": 1447,
    "vorder": 34,
    "position": 1,
    "text": "همه باژ را گردن افگنده‌ایم"
  },
  {
    "poem_id": 1447,
    "vorder": 35,
    "position": 0,
    "text": "به جای درم زر و گوهر دهیم"
  },
  {
    "poem_id": 1447,
    "vorder": 36,
    "position": 1,
    "text": "سپاسی ز گنجور بر سر نهیم"
  },
  {
    "poem_id": 1447,
    "vorder": 37,
    "position": 0,
    "text": "ببخشود کاووس و بنواختشان"
  },
  {
    "poem_id": 1447,
    "vorder": 38,
    "position": 1,
    "text": "یکی راه و آیین نو ساختشان"
  },
  {
    "poem_id": 1447,
    "vorder": 39,
    "position": 0,
    "text": "وزان جایگه بانگ سنج و درای"
  },
  {
    "poem_id": 1447,
    "vorder": 40,
    "position": 1,
    "text": "برآمد ابا نالهٔ کره‌نای"
  },
  {
    "poem_id": 1447,
    "vorder": 41,
    "position": 0,
    "text": "چو آمد بر شهر مکران گذر"
  },
  {
    "poem_id": 1447,
    "vorder": 42,
    "position": 1,
    "text": "سوی کوه قاف آمد و باختر"
  },
  {
    "poem_id": 1447,
    "vorder": 43,
    "position": 0,
    "text": "چو آگاهی آمد بریشان ز شاه"
  },
  {
    "poem_id": 1447,
    "vorder": 44,
    "position": 1,
    "text": "نیایش‌کنان برگرفتند راه"
  },
  {
    "poem_id": 1447,
    "vorder": 45,
    "position": 0,
    "text": "پذیره شدندش همه مهتران"
  },
  {
    "poem_id": 1447,
    "vorder": 46,
    "position": 1,
    "text": "به سر برنهادند باژ گران"
  },
  {
    "poem_id": 1447,
    "vorder": 47,
    "position": 0,
    "text": "چو فرمان گزیدند بگرفت راه"
  },
  {
    "poem_id": 1447,
    "vorder": 48,
    "position": 1,
    "text": "بی‌آزار رفتند شاه و سپاه"
  },
  {
    "poem_id": 1447,
    "vorder": 49,
    "position": 0,
    "text": "سپه ره سوی زابلستان کشید"
  },
  {
    "poem_id": 1447,
    "vorder": 50,
    "position": 1,
    "text": "به مهمانی پور دستان کشید"
  },
  {
    "poem_id": 1447,
    "vorder": 51,
    "position": 0,
    "text": "ببد شاه یک ماه در نیمروز"
  },
  {
    "poem_id": 1447,
    "vorder": 52,
    "position": 1,
    "text": "گهی رود و می خواست گه باز و یوز"
  },
  {
    "poem_id": 1447,
    "vorder": 53,
    "position": 0,
    "text": "برین برنیامد بسی روزگار"
  },
  {
    "poem_id": 1447,
    "vorder": 54,
    "position": 1,
    "text": "که بر گوشهٔ گلستان رست خار"
  },
  {
    "poem_id": 1447,
    "vorder": 55,
    "position": 0,
    "text": "کس از آزمایش نیابد جواز"
  },
  {
    "poem_id": 1447,
    "vorder": 56,
    "position": 1,
    "text": "نشیب آیدش چون شود بر فراز"
  },
  {
    "poem_id": 1447,
    "vorder": 57,
    "position": 0,
    "text": "چو شد کار گیتی بران راستی"
  },
  {
    "poem_id": 1447,
    "vorder": 58,
    "position": 1,
    "text": "پدید آمد از تازیان کاستی"
  },
  {
    "poem_id": 1447,
    "vorder": 59,
    "position": 0,
    "text": "یکی با گهر مرد با گنج و نام"
  },
  {
    "poem_id": 1447,
    "vorder": 60,
    "position": 1,
    "text": "درفشی برافراخت از مصر و شام"
  },
  {
    "poem_id": 1447,
    "vorder": 61,
    "position": 0,
    "text": "ز کاووس کی روی برتافتند"
  },
  {
    "poem_id": 1447,
    "vorder": 62,
    "position": 1,
    "text": "در کهتری خوار بگذاشتند"
  },
  {
    "poem_id": 1447,
    "vorder": 63,
    "position": 0,
    "text": "چو آمد به شاه جهان آگهی"
  },
  {
    "poem_id": 1447,
    "vorder": 64,
    "position": 1,
    "text": "که انباز دارد به شاهنشهی"
  },
  {
    "poem_id": 1447,
    "vorder": 65,
    "position": 0,
    "text": "بزد کوس و برداشت از نیمروز"
  },
  {
    "poem_id": 1447,
    "vorder": 66,
    "position": 1,
    "text": "سپه شاد دل شاه گیتی‌فروز"
  },
  {
    "poem_id": 1447,
    "vorder": 67,
    "position": 0,
    "text": "همه بر سپرها نبشتند نام"
  },
  {
    "poem_id": 1447,
    "vorder": 68,
    "position": 1,
    "text": "بجوشید شمشیرها در نیام"
  },
  {
    "poem_id": 1447,
    "vorder": 69,
    "position": 0,
    "text": "سپه را ز هامون به دریا کشید"
  },
  {
    "poem_id": 1447,
    "vorder": 70,
    "position": 1,
    "text": "بدان سو کجا دشمن آمد پدید"
  },
  {
    "poem_id": 1447,
    "vorder": 71,
    "position": 0,
    "text": "بی‌اندازه کشتی و زورق بساخت"
  },
  {
    "poem_id": 1447,
    "vorder": 72,
    "position": 1,
    "text": "برآشفت و بر آب لشکر نشاخت"
  },
  {
    "poem_id": 1447,
    "vorder": 73,
    "position": 0,
    "text": "همانا که فرسنگ بودی هزار"
  },
  {
    "poem_id": 1447,
    "vorder": 74,
    "position": 1,
    "text": "اگر پای با راه کردی شمار"
  },
  {
    "poem_id": 1447,
    "vorder": 75,
    "position": 0,
    "text": "همی راند تا در میان سه شهر"
  },
  {
    "poem_id": 1447,
    "vorder": 76,
    "position": 1,
    "text": "ز گیتی برین‌گونه جویند بهر"
  },
  {
    "poem_id": 1447,
    "vorder": 77,
    "position": 0,
    "text": "به دست چپش مصر و بربر به راست"
  },
  {
    "poem_id": 1447,
    "vorder": 78,
    "position": 1,
    "text": "زره در میانه بر آن سو که خواست"
  },
  {
    "poem_id": 1447,
    "vorder": 79,
    "position": 0,
    "text": "به پیش اندرون شهر هاماوران"
  },
  {
    "poem_id": 1447,
    "vorder": 80,
    "position": 1,
    "text": "به هر کشوری در سپاهی گران"
  },
  {
    "poem_id": 1447,
    "vorder": 81,
    "position": 0,
    "text": "خبر شد بدیشان که کاووس شاه"
  },
  {
    "poem_id": 1447,
    "vorder": 82,
    "position": 1,
    "text": "برآمد ز آب زره با سپاه"
  },
  {
    "poem_id": 1447,
    "vorder": 83,
    "position": 0,
    "text": "هم‌آواز گشتند یک با دگر"
  },
  {
    "poem_id": 1447,
    "vorder": 84,
    "position": 1,
    "text": "سپه را سوی بربر آمد گذر"
  },
  {
    "poem_id": 1447,
    "vorder": 85,
    "position": 0,
    "text": "یکی گشت چندان یل تیغ‌زن"
  },
  {
    "poem_id": 1447,
    "vorder": 86,
    "position": 1,
    "text": "به بربرستان در شدند انجمن"
  },
  {
    "poem_id": 1447,
    "vorder": 87,
    "position": 0,
    "text": "سپاهی که دریا و صحرا و کوه"
  },
  {
    "poem_id": 1447,
    "vorder": 88,
    "position": 1,
    "text": "شد از نعل اسپان ایشان ستوه"
  },
  {
    "poem_id": 1447,
    "vorder": 89,
    "position": 0,
    "text": "نبد شیر درنده را خوابگاه"
  },
  {
    "poem_id": 1447,
    "vorder": 90,
    "position": 1,
    "text": "نه گور ژیان یافت بر دشت راه"
  },
  {
    "poem_id": 1447,
    "vorder": 91,
    "position": 0,
    "text": "پلنگ از بر سنگ و ماهی در آب"
  },
  {
    "poem_id": 1447,
    "vorder": 92,
    "position": 1,
    "text": "هم اندر هوا ابر و پران عقاب"
  },
  {
    "poem_id": 1447,
    "vorder": 93,
    "position": 0,
    "text": "همی راه جستند و کی بود راه"
  },
  {
    "poem_id": 1447,
    "vorder": 94,
    "position": 1,
    "text": "دد و دام را بر چنان رزمگاه"
  },
  {
    "poem_id": 1447,
    "vorder": 95,
    "position": 0,
    "text": "چو کاووس لشکر به خشکی کشید"
  },
  {
    "poem_id": 1447,
    "vorder": 96,
    "position": 1,
    "text": "کس اندر جهان کوه و صحرا ندید"
  },
  {
    "poem_id": 1447,
    "vorder": 97,
    "position": 0,
    "text": "جهان گفتی از تیغ وز جوشن است"
  },
  {
    "poem_id": 1447,
    "vorder": 98,
    "position": 1,
    "text": "ستاره ز نوک سنان روشن است"
  },
  {
    "poem_id": 1447,
    "vorder": 99,
    "position": 0,
    "text": "ز بس خود زرین و زرین سپر"
  },
  {
    "poem_id": 1447,
    "vorder": 100,
    "position": 1,
    "text": "به گردن برآورده رخشان تبر"
  },
  {
    "poem_id": 1447,
    "vorder": 101,
    "position": 0,
    "text": "تو گفتی زمین شد سپهر روان"
  },
  {
    "poem_id": 1447,
    "vorder": 102,
    "position": 1,
    "text": "همی بارد از تیغ هندی روان"
  },
  {
    "poem_id": 1447,
    "vorder": 103,
    "position": 0,
    "text": "ز مغفر هوا گشت چون سندروس"
  },
  {
    "poem_id": 1447,
    "vorder": 104,
    "position": 1,
    "text": "زمین سر به سر تیره چون آبنوس"
  },
  {
    "poem_id": 1447,
    "vorder": 105,
    "position": 0,
    "text": "بدرید کوه از دم گاودم"
  },
  {
    "poem_id": 1447,
    "vorder": 106,
    "position": 1,
    "text": "زمین آمد از سم اسپان به خم"
  },
  {
    "poem_id": 1447,
    "vorder": 107,
    "position": 0,
    "text": "ز بانگ تبیره به بربرستان"
  },
  {
    "poem_id": 1447,
    "vorder": 108,
    "position": 1,
    "text": "تو گفتی زمین گشت لشکرستان"
  },
  {
    "poem_id": 1447,
    "vorder": 109,
    "position": 0,
    "text": "برآمد ز ایران سپه بوق و کوس"
  },
  {
    "poem_id": 1447,
    "vorder": 110,
    "position": 1,
    "text": "برون رفت گرگین و فرهاد و طوس"
  },
  {
    "poem_id": 1447,
    "vorder": 111,
    "position": 0,
    "text": "وزان سوی گودرز کشواد بود"
  },
  {
    "poem_id": 1447,
    "vorder": 112,
    "position": 1,
    "text": "چو گیو و چو شیدوش و میلاد بود"
  },
  {
    "poem_id": 1447,
    "vorder": 113,
    "position": 0,
    "text": "فگندند بر یال اسپان عنان"
  },
  {
    "poem_id": 1447,
    "vorder": 114,
    "position": 1,
    "text": "به زهر آب دادند نوک سنان"
  },
  {
    "poem_id": 1447,
    "vorder": 115,
    "position": 0,
    "text": "چو بر کوههٔ زین نهادند سر"
  },
  {
    "poem_id": 1447,
    "vorder": 116,
    "position": 1,
    "text": "خروش آمد و چاک چاک تبر"
  },
  {
    "poem_id": 1447,
    "vorder": 117,
    "position": 0,
    "text": "تو گفتی همی سنگ آهن کنند"
  },
  {
    "poem_id": 1447,
    "vorder": 118,
    "position": 1,
    "text": "وگر آسمان بر زمین برزنند"
  },
  {
    "poem_id": 1447,
    "vorder": 119,
    "position": 0,
    "text": "بجنبید کاووس در قلب‌گاه"
  },
  {
    "poem_id": 1447,
    "vorder": 120,
    "position": 1,
    "text": "سپاه اندرآمد به پیش سپاه"
  },
  {
    "poem_id": 1447,
    "vorder": 121,
    "position": 0,
    "text": "جهان گشت تاری سراسر ز گرد"
  },
  {
    "poem_id": 1447,
    "vorder": 122,
    "position": 1,
    "text": "ببارید شنگرف بر لاژورد"
  },
  {
    "poem_id": 1447,
    "vorder": 123,
    "position": 0,
    "text": "تو گفتی هوا ژاله بارد همی"
  },
  {
    "poem_id": 1447,
    "vorder": 124,
    "position": 1,
    "text": "به سنگ اندرون لاله کارد همی"
  },
  {
    "poem_id": 1447,
    "vorder": 125,
    "position": 0,
    "text": "ز چشم سنان آتش آمد برون"
  },
  {
    "poem_id": 1447,
    "vorder": 126,
    "position": 1,
    "text": "زمین شد به کردار دریای خون"
  },
  {
    "poem_id": 1447,
    "vorder": 127,
    "position": 0,
    "text": "سه لشکر چنان شد ز ایرانیان"
  },
  {
    "poem_id": 1447,
    "vorder": 128,
    "position": 1,
    "text": "که سر باز نشناختند از میان"
  },
  {
    "poem_id": 1447,
    "vorder": 129,
    "position": 0,
    "text": "نخستین سپهدار هاماوران"
  },
  {
    "poem_id": 1447,
    "vorder": 130,
    "position": 1,
    "text": "بیفگند شمشیر و گرز گران"
  },
  {
    "poem_id": 1447,
    "vorder": 131,
    "position": 0,
    "text": "غمی گشت وز شاه زنهار خواست"
  },
  {
    "poem_id": 1447,
    "vorder": 132,
    "position": 1,
    "text": "بدانست کان روزگار بلاست"
  },
  {
    "poem_id": 1447,
    "vorder": 133,
    "position": 0,
    "text": "به پیمان که از شهر هاماوران"
  },
  {
    "poem_id": 1447,
    "vorder": 134,
    "position": 1,
    "text": "سپهبد دهد ساو و باژ گران"
  },
  {
    "poem_id": 1447,
    "vorder": 135,
    "position": 0,
    "text": "ز اسپ و سلیح و ز تخت و کلاه"
  },
  {
    "poem_id": 1447,
    "vorder": 136,
    "position": 1,
    "text": "فرستد به نزدیک کاووس شاه"
  },
  {
    "poem_id": 1447,
    "vorder": 137,
    "position": 0,
    "text": "چو این داده باشد برو بگذرد"
  },
  {
    "poem_id": 1447,
    "vorder": 138,
    "position": 1,
    "text": "سپاهش بروبوم او نسپرد"
  },
  {
    "poem_id": 1447,
    "vorder": 139,
    "position": 0,
    "text": "ز گوینده بشنید کاووس کی"
  },
  {
    "poem_id": 1447,
    "vorder": 140,
    "position": 1,
    "text": "برین گفتها پاسخ افگند پی"
  },
  {
    "poem_id": 1447,
    "vorder": 141,
    "position": 0,
    "text": "که یکسر همه در پناه منید"
  },
  {
    "poem_id": 1447,
    "vorder": 142,
    "position": 1,
    "text": "پرستندهٔ تاج و گاه منید"
  }
