[
  {
    "poem_id": 1935,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید ماهوی بیدادگر"
  },
  {
    "poem_id": 1935,
    "vorder": 2,
    "position": 1,
    "text": "سخن‌ها کجا گفت او را پسر"
  },
  {
    "poem_id": 1935,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت با آسیابان که خیز"
  },
  {
    "poem_id": 1935,
    "vorder": 4,
    "position": 1,
    "text": "سواران ببر خون دشمن بریز"
  },
  {
    "poem_id": 1935,
    "vorder": 5,
    "position": 0,
    "text": "چو بشنید از او آسیابان سخُن"
  },
  {
    "poem_id": 1935,
    "vorder": 6,
    "position": 1,
    "text": "نه سر دید از آن کار پیدا نه بن"
  },
  {
    "poem_id": 1935,
    "vorder": 7,
    "position": 0,
    "text": "شبانگاه نیران خرداد ماه"
  },
  {
    "poem_id": 1935,
    "vorder": 8,
    "position": 1,
    "text": "سوی آسیا رفت نزدیک شاه"
  },
  {
    "poem_id": 1935,
    "vorder": 9,
    "position": 0,
    "text": "ز درگاه ماهوی چون شد برون"
  },
  {
    "poem_id": 1935,
    "vorder": 10,
    "position": 1,
    "text": "دو دیده پر از آب، دل پر ز خون"
  },
  {
    "poem_id": 1935,
    "vorder": 11,
    "position": 0,
    "text": "سواران فرستاد ماهوی زود"
  },
  {
    "poem_id": 1935,
    "vorder": 12,
    "position": 1,
    "text": "پس آسیابان به کردار دود"
  },
  {
    "poem_id": 1935,
    "vorder": 13,
    "position": 0,
    "text": "بفرمود تا تاج و آن گوشوار"
  },
  {
    "poem_id": 1935,
    "vorder": 14,
    "position": 1,
    "text": "همان مهر و آن جامهٔ شاه‌وار"
  },
  {
    "poem_id": 1935,
    "vorder": 15,
    "position": 0,
    "text": "نباید که یک‌سر پر از خون کنند"
  },
  {
    "poem_id": 1935,
    "vorder": 16,
    "position": 1,
    "text": "ز تن جامهٔ شاه بیرون کنند"
  },
  {
    "poem_id": 1935,
    "vorder": 17,
    "position": 0,
    "text": "بشد آسیابان دو دیده پرآب"
  },
  {
    "poem_id": 1935,
    "vorder": 18,
    "position": 1,
    "text": "به زردی دو رخساره چون آفتاب"
  },
  {
    "poem_id": 1935,
    "vorder": 19,
    "position": 0,
    "text": "همی گفت کای روشن کردگار"
  },
  {
    "poem_id": 1935,
    "vorder": 20,
    "position": 1,
    "text": "تویی برتر از گردش روزگار"
  },
  {
    "poem_id": 1935,
    "vorder": 21,
    "position": 0,
    "text": "تو زین ناپسندیده فرمان او"
  },
  {
    "poem_id": 1935,
    "vorder": 22,
    "position": 1,
    "text": "هم اکنون بپیچان تن و جان او"
  },
  {
    "poem_id": 1935,
    "vorder": 23,
    "position": 0,
    "text": "برِ شاه شد دل پر از شرم و باک"
  },
  {
    "poem_id": 1935,
    "vorder": 24,
    "position": 1,
    "text": "رخانش پرآب و دهانش چو خاک"
  },
  {
    "poem_id": 1935,
    "vorder": 25,
    "position": 0,
    "text": "به نزدیک تنگ اندر آمد به هوش"
  },
  {
    "poem_id": 1935,
    "vorder": 26,
    "position": 1,
    "text": "چنان چون کسی راز گوید به گوش"
  },
  {
    "poem_id": 1935,
    "vorder": 27,
    "position": 0,
    "text": "یکی دشنه زد بر تهیگاه شاه"
  },
  {
    "poem_id": 1935,
    "vorder": 28,
    "position": 1,
    "text": "رها شد به زخم اندر از شاه آه"
  },
  {
    "poem_id": 1935,
    "vorder": 29,
    "position": 0,
    "text": "به خاک اندر آمد سر و افسرش"
  },
  {
    "poem_id": 1935,
    "vorder": 30,
    "position": 1,
    "text": "همان نان کشکین به پیش اندرش"
  },
  {
    "poem_id": 1935,
    "vorder": 31,
    "position": 0,
    "text": "اگر راه یابد کسی زین جهان"
  },
  {
    "poem_id": 1935,
    "vorder": 32,
    "position": 1,
    "text": "بباشد، ندارد خرد در نهان"
  },
  {
    "poem_id": 1935,
    "vorder": 33,
    "position": 0,
    "text": "ز پرورده سیر آید این هفت گرد"
  },
  {
    "poem_id": 1935,
    "vorder": 34,
    "position": 1,
    "text": "شود کشته بر بی‌گنه یزدگرد"
  },
  {
    "poem_id": 1935,
    "vorder": 35,
    "position": 0,
    "text": "بر این گونه بر تاجداری بمرد"
  },
  {
    "poem_id": 1935,
    "vorder": 36,
    "position": 1,
    "text": "که از لشکر او سواری نبرد"
  },
  {
    "poem_id": 1935,
    "vorder": 37,
    "position": 0,
    "text": "خرد نیست با گرد گردان سپهر"
  },
  {
    "poem_id": 1935,
    "vorder": 38,
    "position": 1,
    "text": "نه پیدا بود رنج و خشمش ز مهر"
  },
  {
    "poem_id": 1935,
    "vorder": 39,
    "position": 0,
    "text": "همان به که گیتی نبینی به چشم"
  },
  {
    "poem_id": 1935,
    "vorder": 40,
    "position": 1,
    "text": "نداری ز کردار او مهر و خشم"
  },
  {
    "poem_id": 1935,
    "vorder": 41,
    "position": 0,
    "text": "سواران ماهوی شوریده‌بخت"
  },
  {
    "poem_id": 1935,
    "vorder": 42,
    "position": 1,
    "text": "بدیدند کآن خسروانی درخت"
  },
  {
    "poem_id": 1935,
    "vorder": 43,
    "position": 0,
    "text": "ز تخت و ز آوردگه آرمید"
  },
  {
    "poem_id": 1935,
    "vorder": 44,
    "position": 1,
    "text": "بشد هر کسی روی او را بدید"
  },
  {
    "poem_id": 1935,
    "vorder": 45,
    "position": 0,
    "text": "گشادند بند قبای بنفش"
  },
  {
    "poem_id": 1935,
    "vorder": 46,
    "position": 1,
    "text": "همان افسر و طوق و زرّینه‌کفش"
  },
  {
    "poem_id": 1935,
    "vorder": 47,
    "position": 0,
    "text": "فگنده تن شاه ایران به خاک"
  },
  {
    "poem_id": 1935,
    "vorder": 48,
    "position": 1,
    "text": "پر از خون و پهلو به شمشیر چاک"
  },
  {
    "poem_id": 1935,
    "vorder": 49,
    "position": 0,
    "text": "ز پیش شهنشاه برخاستند"
  },
  {
    "poem_id": 1935,
    "vorder": 50,
    "position": 1,
    "text": "زبان را به نفرین بیاراستند"
  },
  {
    "poem_id": 1935,
    "vorder": 51,
    "position": 0,
    "text": "که ماهوی را باد تن همچنین"
  },
  {
    "poem_id": 1935,
    "vorder": 52,
    "position": 1,
    "text": "پر از خون فگنده به روی زمین"
  },
  {
    "poem_id": 1935,
    "vorder": 53,
    "position": 0,
    "text": "به نزدیک ماهوی رفتند زود"
  },
  {
    "poem_id": 1935,
    "vorder": 54,
    "position": 1,
    "text": "ابا یاره و گوهر نابسود"
  },
  {
    "poem_id": 1935,
    "vorder": 55,
    "position": 0,
    "text": "به ماهوی گفتند کآن شهریار"
  },
  {
    "poem_id": 1935,
    "vorder": 56,
    "position": 1,
    "text": "بر آمد ز آرام و از کارزار"
  },
  {
    "poem_id": 1935,
    "vorder": 57,
    "position": 0,
    "text": "بفرمود کو را به هنگام خواب"
  },
  {
    "poem_id": 1935,
    "vorder": 58,
    "position": 1,
    "text": "از آن آسیا افگنند اندر آب"
  },
  {
    "poem_id": 1935,
    "vorder": 59,
    "position": 0,
    "text": "بشد تیز بدمهر دو پیشکار"
  },
  {
    "poem_id": 1935,
    "vorder": 60,
    "position": 1,
    "text": "کشیدند پرخون تن شهریار"
  },
  {
    "poem_id": 1935,
    "vorder": 61,
    "position": 0,
    "text": "کجا ارج آن کشته نشناختند"
  },
  {
    "poem_id": 1935,
    "vorder": 62,
    "position": 1,
    "text": "به گرداب زرق اندر انداختند"
  },
  {
    "poem_id": 1935,
    "vorder": 63,
    "position": 0,
    "text": "چو شب روز شد مردم آمد پدید"
  },
  {
    "poem_id": 1935,
    "vorder": 64,
    "position": 1,
    "text": "دو مرد گرانمایه آنجا رسید"
  },
  {
    "poem_id": 1935,
    "vorder": 65,
    "position": 0,
    "text": "از آن سوگواران پرهیزگار"
  },
  {
    "poem_id": 1935,
    "vorder": 66,
    "position": 1,
    "text": "بیامد یکی بر لب جویبار"
  },
  {
    "poem_id": 1935,
    "vorder": 67,
    "position": 0,
    "text": "تن او برهنه بدید اندر آب"
  },
  {
    "poem_id": 1935,
    "vorder": 68,
    "position": 1,
    "text": "بشورید و آمد هم اندر شتاب"
  },
  {
    "poem_id": 1935,
    "vorder": 69,
    "position": 0,
    "text": "چنین تا در خانه راهب رسید"
  },
  {
    "poem_id": 1935,
    "vorder": 70,
    "position": 1,
    "text": "بدان سوگواران بگفت آن چه دید"
  },
  {
    "poem_id": 1935,
    "vorder": 71,
    "position": 0,
    "text": "که شاه زمانه به غرق اندرست"
  },
  {
    "poem_id": 1935,
    "vorder": 72,
    "position": 1,
    "text": "برهنه به گرداب زرق اندرست"
  },
  {
    "poem_id": 1935,
    "vorder": 73,
    "position": 0,
    "text": "برفتند زان سوگواران بسی"
  },
  {
    "poem_id": 1935,
    "vorder": 74,
    "position": 1,
    "text": "سُکوبا و رهبان ز هر در کسی"
  },
  {
    "poem_id": 1935,
    "vorder": 75,
    "position": 0,
    "text": "خروشی بر آمد ز راهب به درد"
  },
  {
    "poem_id": 1935,
    "vorder": 76,
    "position": 1,
    "text": "که ای تاجور شاه آزادمرد"
  },
  {
    "poem_id": 1935,
    "vorder": 77,
    "position": 0,
    "text": "چنین گفت راهب که این کس ندید"
  },
  {
    "poem_id": 1935,
    "vorder": 78,
    "position": 1,
    "text": "نه پیش از مسیح این سخن کس شنید"
  },
  {
    "poem_id": 1935,
    "vorder": 79,
    "position": 0,
    "text": "که بر شهریاری زند بنده‌ای"
  },
  {
    "poem_id": 1935,
    "vorder": 80,
    "position": 1,
    "text": "یکی بدنژادی و افگنده‌ای"
  },
  {
    "poem_id": 1935,
    "vorder": 81,
    "position": 0,
    "text": "بپرورد تا بر تنش بد رسد"
  },
  {
    "poem_id": 1935,
    "vorder": 82,
    "position": 1,
    "text": "از این بهر ماهوی نفرین سزد"
  },
  {
    "poem_id": 1935,
    "vorder": 83,
    "position": 0,
    "text": "دریغ آن سر و تاج و بالای تو"
  },
  {
    "poem_id": 1935,
    "vorder": 84,
    "position": 1,
    "text": "دریغ آن دل و دانش و رای تو"
  },
  {
    "poem_id": 1935,
    "vorder": 85,
    "position": 0,
    "text": "دریغ آن سر تخمهٔ اردشیر"
  },
  {
    "poem_id": 1935,
    "vorder": 86,
    "position": 1,
    "text": "دریغ این جوان و سوار هژیر"
  },
  {
    "poem_id": 1935,
    "vorder": 87,
    "position": 0,
    "text": "تنومند بودی خرد با روان"
  },
  {
    "poem_id": 1935,
    "vorder": 88,
    "position": 1,
    "text": "ببردی خبر زین به نوشین‌روان"
  },
  {
    "poem_id": 1935,
    "vorder": 89,
    "position": 0,
    "text": "که در آسیا ماه‌روی تو را"
  },
  {
    "poem_id": 1935,
    "vorder": 90,
    "position": 1,
    "text": "جهاندار و دیهیم‌جوی تو را"
  },
  {
    "poem_id": 1935,
    "vorder": 91,
    "position": 0,
    "text": "به دشنه جگرگاه بشکافتند"
  },
  {
    "poem_id": 1935,
    "vorder": 92,
    "position": 1,
    "text": "برهنه به آب اندر انداختند"
  },
  {
    "poem_id": 1935,
    "vorder": 93,
    "position": 0,
    "text": "سکوبا از آن سوگواران چهار"
  },
  {
    "poem_id": 1935,
    "vorder": 94,
    "position": 1,
    "text": "برهنه شدند اندران جویبار"
  },
  {
    "poem_id": 1935,
    "vorder": 95,
    "position": 0,
    "text": "گشاده تن شهریار جوان"
  },
  {
    "poem_id": 1935,
    "vorder": 96,
    "position": 1,
    "text": "نبیره‌ی جهاندار نوشین‌روان"
  },
  {
    "poem_id": 1935,
    "vorder": 97,
    "position": 0,
    "text": "به خشکی کشیدند زان آبگیر"
  },
  {
    "poem_id": 1935,
    "vorder": 98,
    "position": 1,
    "text": "بسی مویه کردند برنا و پیر"
  },
  {
    "poem_id": 1935,
    "vorder": 99,
    "position": 0,
    "text": "به باغ اندرون دخمه‌ای ساختند"
  },
  {
    "poem_id": 1935,
    "vorder": 100,
    "position": 1,
    "text": "سرش را به ابر اندر افراختند"
  },
  {
    "poem_id": 1935,
    "vorder": 101,
    "position": 0,
    "text": "سر زخم آن دشنه کردند خشک"
  },
  {
    "poem_id": 1935,
    "vorder": 102,
    "position": 1,
    "text": "به دبق و به قیر و به کافور و مشک"
  },
  {
    "poem_id": 1935,
    "vorder": 103,
    "position": 0,
    "text": "بیاراستندش به دیبای زرد"
  },
  {
    "poem_id": 1935,
    "vorder": 104,
    "position": 1,
    "text": "قصب زیر و دستی زبر لاژورد"
  },
  {
    "poem_id": 1935,
    "vorder": 105,
    "position": 0,
    "text": "می و مشک و کافور و چندی گلاب"
  },
  {
    "poem_id": 1935,
    "vorder": 106,
    "position": 1,
    "text": "سکوبا بیندود بر جای خواب"
  },
  {
    "poem_id": 1935,
    "vorder": 107,
    "position": 0,
    "text": "چه گفت آن گرانمایه دهقان مرو"
  },
  {
    "poem_id": 1935,
    "vorder": 108,
    "position": 1,
    "text": "که بنهفت بالای آن زادسرو"
  },
  {
    "poem_id": 1935,
    "vorder": 109,
    "position": 0,
    "text": "که بخشش ز کوشش بود در نهان"
  },
  {
    "poem_id": 1935,
    "vorder": 110,
    "position": 1,
    "text": "که خشنود بیرون شود زین جهان"
  },
  {
    "poem_id": 1935,
    "vorder": 111,
    "position": 0,
    "text": "دگر گفت اگر چند خندان بود"
  },
  {
    "poem_id": 1935,
    "vorder": 112,
    "position": 1,
    "text": "چنان دان که از دردمندان بود"
  },
  {
    "poem_id": 1935,
    "vorder": 113,
    "position": 0,
    "text": "که از چرخ گردان پذیرد فریب"
  },
  {
    "poem_id": 1935,
    "vorder": 114,
    "position": 1,
    "text": "که او را نماید فراز و نشیب"
  },
  {
    "poem_id": 1935,
    "vorder": 115,
    "position": 0,
    "text": "دگر گفت کآن را تو دانا مخوان"
  },
  {
    "poem_id": 1935,
    "vorder": 116,
    "position": 1,
    "text": "که تن را پرستد نه راه روان"
  },
  {
    "poem_id": 1935,
    "vorder": 117,
    "position": 0,
    "text": "همی خواسته جوید و نام بد"
  },
  {
    "poem_id": 1935,
    "vorder": 118,
    "position": 1,
    "text": "بترسد روانش ز فرجام بد"
  },
  {
    "poem_id": 1935,
    "vorder": 119,
    "position": 0,
    "text": "دگر گفت اگر شاه لب را ببست"
  },
  {
    "poem_id": 1935,
    "vorder": 120,
    "position": 1,
    "text": "نبیند همی تاج و تخت نشست"
  },
  {
    "poem_id": 1935,
    "vorder": 121,
    "position": 0,
    "text": "نه مهر و پرستندهٔ بارگاه"
  },
  {
    "poem_id": 1935,
    "vorder": 122,
    "position": 1,
    "text": "نه افسر نه کشور نه تاج و کلاه"
  },
  {
    "poem_id": 1935,
    "vorder": 123,
    "position": 0,
    "text": "دگر گفت کز خوب گفتار اوی"
  },
  {
    "poem_id": 1935,
    "vorder": 124,
    "position": 1,
    "text": "ستایش ندارم سزاوار اوی"
  },
  {
    "poem_id": 1935,
    "vorder": 125,
    "position": 0,
    "text": "همی سرو کشت او به باغ بهشت"
  },
  {
    "poem_id": 1935,
    "vorder": 126,
    "position": 1,
    "text": "ببیند روانش درختی که کشت"
  },
  {
    "poem_id": 1935,
    "vorder": 127,
    "position": 0,
    "text": "دگر گفت یزدان روانت ببرد"
  },
  {
    "poem_id": 1935,
    "vorder": 128,
    "position": 1,
    "text": "تنت را بدین سوگواران سپرد"
  },
  {
    "poem_id": 1935,
    "vorder": 129,
    "position": 0,
    "text": "روان تو را سودمند این بود"
  },
  {
    "poem_id": 1935,
    "vorder": 130,
    "position": 1,
    "text": "تن بدکنش را گزند این بود"
  },
  {
    "poem_id": 1935,
    "vorder": 131,
    "position": 0,
    "text": "کنون در بهشت است بازار شاه"
  },
  {
    "poem_id": 1935,
    "vorder": 132,
    "position": 1,
    "text": "به دوزخ کند جان بدخواه راه"
  },
  {
    "poem_id": 1935,
    "vorder": 133,
    "position": 0,
    "text": "دگر گفت کای شاه دانش‌پذیر"
  },
  {
    "poem_id": 1935,
    "vorder": 134,
    "position": 1,
    "text": "که با شهریاری و با اردشیر"
  },
  {
    "poem_id": 1935,
    "vorder": 135,
    "position": 0,
    "text": "درودی همان بر که کشتی به باغ"
  },
  {
    "poem_id": 1935,
    "vorder": 136,
    "position": 1,
    "text": "درفشان شد آن خسروانی چراغ"
  },
  {
    "poem_id": 1935,
    "vorder": 137,
    "position": 0,
    "text": "دگر گفت کای شهریار جوان"
  },
  {
    "poem_id": 1935,
    "vorder": 138,
    "position": 1,
    "text": "بخفتی و بیدار بودت روان"
  },
  {
    "poem_id": 1935,
    "vorder": 139,
    "position": 0,
    "text": "لبت خامش و جان به چندین گله"
  },
  {
    "poem_id": 1935,
    "vorder": 140,
    "position": 1,
    "text": "برفت و تنت ماند ایدر یله"
  },
  {
    "poem_id": 1935,
    "vorder": 141,
    "position": 0,
    "text": "تو بیکاری و جان به کار اندر است"
  },
  {
    "poem_id": 1935,
    "vorder": 142,
    "position": 1,
    "text": "تن بدسگالت به بار اندر است"
  },
  {
    "poem_id": 1935,
    "vorder": 143,
    "position": 0,
    "text": "بگوید روان گر زبان بسته شد"
  },
  {
    "poem_id": 1935,
    "vorder": 144,
    "position": 1,
    "text": "بیاسود جان گر تنت خسته شد"
  },
  {
    "poem_id": 1935,
    "vorder": 145,
    "position": 0,
    "text": "اگر دست بیکار گشت از عنان"
  },
  {
    "poem_id": 1935,
    "vorder": 146,
    "position": 1,
    "text": "روانت به چنگ اندر آرد سنان"
  },
  {
    "poem_id": 1935,
    "vorder": 147,
    "position": 0,
    "text": "دگر گفت کای نامبردار نو"
  },
  {
    "poem_id": 1935,
    "vorder": 148,
    "position": 1,
    "text": "تو رفتی و کردار شد پیش رو"
  },
  {
    "poem_id": 1935,
    "vorder": 149,
    "position": 0,
    "text": "تو را در بهشت است تخت این بس است"
  },
  {
    "poem_id": 1935,
    "vorder": 150,
    "position": 1,
    "text": "زمین بلا بهر دیگر کس است"
  },
  {
    "poem_id": 1935,
    "vorder": 151,
    "position": 0,
    "text": "دگر گفت کآن کس که او چون تو کُشت"
  },
  {
    "poem_id": 1935,
    "vorder": 152,
    "position": 1,
    "text": "ببیند کنون روزگار درشت"
  },
  {
    "poem_id": 1935,
    "vorder": 153,
    "position": 0,
    "text": "سُقُف گفت ما بندگان تویم"
  },
  {
    "poem_id": 1935,
    "vorder": 154,
    "position": 1,
    "text": "نیایش‌کن پاک‌جان تویم"
  },
  {
    "poem_id": 1935,
    "vorder": 155,
    "position": 0,
    "text": "که این دخمه پر لاله باغ تو باد"
  },
  {
    "poem_id": 1935,
    "vorder": 156,
    "position": 1,
    "text": "کفن دشت شادی و راغ تو باد"
  },
  {
    "poem_id": 1935,
    "vorder": 157,
    "position": 0,
    "text": "بگفتند و تابوت برداشتند"
  },
  {
    "poem_id": 1935,
    "vorder": 158,
    "position": 1,
    "text": "ز هامون سوی دخمه بگذاشتند"
  },
  {
    "poem_id": 1935,
    "vorder": 159,
    "position": 0,
    "text": "بر آن خوابگه رفت ناکام شاه"
  },
  {
    "poem_id": 1935,
    "vorder": 160,
    "position": 1,
    "text": "سر آمد بر او رنج و تخت و کلاه"
  }
]