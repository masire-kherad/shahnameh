[
  {
    "poem_id": 1912,
    "vorder": 1,
    "position": 0,
    "text": "چو شیروی بنشست برتخت ناز"
  },
  {
    "poem_id": 1912,
    "vorder": 2,
    "position": 1,
    "text": "به سر برنهاد آن کیی تاج آز"
  },
  {
    "poem_id": 1912,
    "vorder": 3,
    "position": 0,
    "text": "برفتند گوینده ایرانیان"
  },
  {
    "poem_id": 1912,
    "vorder": 4,
    "position": 1,
    "text": "برو خواندند آفرین کیان"
  },
  {
    "poem_id": 1912,
    "vorder": 5,
    "position": 0,
    "text": "همی‌گفت هریک به بانگ بلند"
  },
  {
    "poem_id": 1912,
    "vorder": 6,
    "position": 1,
    "text": "که ای پر هنر خسرو ارجمند"
  },
  {
    "poem_id": 1912,
    "vorder": 7,
    "position": 0,
    "text": "چنان هم که یزدان تو را داد تاج"
  },
  {
    "poem_id": 1912,
    "vorder": 8,
    "position": 1,
    "text": "نشستی به آرام بر تخت عاج"
  },
  {
    "poem_id": 1912,
    "vorder": 9,
    "position": 0,
    "text": "بماناد گیتی به فرزند تو"
  },
  {
    "poem_id": 1912,
    "vorder": 10,
    "position": 1,
    "text": "چنین هم به خویشان و پیوند تو"
  },
  {
    "poem_id": 1912,
    "vorder": 11,
    "position": 0,
    "text": "چنین داد پاسخ بدیشان قباد"
  },
  {
    "poem_id": 1912,
    "vorder": 12,
    "position": 1,
    "text": "که همواره پیروز باشید و شاد"
  },
  {
    "poem_id": 1912,
    "vorder": 13,
    "position": 0,
    "text": "نباشیم تا جاودان بدکنش"
  },
  {
    "poem_id": 1912,
    "vorder": 14,
    "position": 1,
    "text": "چه نیکو بود داد باخوش منش"
  },
  {
    "poem_id": 1912,
    "vorder": 15,
    "position": 0,
    "text": "جهان را بداریم با ایمنی"
  },
  {
    "poem_id": 1912,
    "vorder": 16,
    "position": 1,
    "text": "ببُریم کردار آهرمنی"
  },
  {
    "poem_id": 1912,
    "vorder": 17,
    "position": 0,
    "text": "ز بایسته‌تر کار پیشی مرا"
  },
  {
    "poem_id": 1912,
    "vorder": 18,
    "position": 1,
    "text": "که افزون بود فر و خویشی مرا"
  },
  {
    "poem_id": 1912,
    "vorder": 19,
    "position": 0,
    "text": "پیامی فرستم به نزد پدر"
  },
  {
    "poem_id": 1912,
    "vorder": 20,
    "position": 1,
    "text": "بگویم بدو این سخن در به در"
  },
  {
    "poem_id": 1912,
    "vorder": 21,
    "position": 0,
    "text": "ز ناخوب کاری که او راندست"
  },
  {
    "poem_id": 1912,
    "vorder": 22,
    "position": 1,
    "text": "برین گونه کاری به پیش آمدست"
  },
  {
    "poem_id": 1912,
    "vorder": 23,
    "position": 0,
    "text": "به یزدان کند پوزش او از گناه"
  },
  {
    "poem_id": 1912,
    "vorder": 24,
    "position": 1,
    "text": "گراینده گردد به آیین و راه"
  },
  {
    "poem_id": 1912,
    "vorder": 25,
    "position": 0,
    "text": "بپردازم آن گه به کار جهان"
  },
  {
    "poem_id": 1912,
    "vorder": 26,
    "position": 1,
    "text": "بکوشم به داد آشکار و نهان"
  },
  {
    "poem_id": 1912,
    "vorder": 27,
    "position": 0,
    "text": "به جای نکوکار نیکی کنیم"
  },
  {
    "poem_id": 1912,
    "vorder": 28,
    "position": 1,
    "text": "دل مرد درویش رانشکنیم"
  },
  {
    "poem_id": 1912,
    "vorder": 29,
    "position": 0,
    "text": "دوتن بایدم راد و نیکوسخن"
  },
  {
    "poem_id": 1912,
    "vorder": 30,
    "position": 1,
    "text": "کجا یاد دارند ز کار کهن"
  },
  {
    "poem_id": 1912,
    "vorder": 31,
    "position": 0,
    "text": "بدان انجمن گفت کاین کارکیست"
  },
  {
    "poem_id": 1912,
    "vorder": 32,
    "position": 1,
    "text": "ز ایرانیان پاک و بیدار کیست"
  },
  {
    "poem_id": 1912,
    "vorder": 33,
    "position": 0,
    "text": "نمودند گردان سراسر به چشم"
  },
  {
    "poem_id": 1912,
    "vorder": 34,
    "position": 1,
    "text": "دو استاد را گر نگیرند خشم"
  },
  {
    "poem_id": 1912,
    "vorder": 35,
    "position": 0,
    "text": "بدانست شیروی کایرانیان"
  },
  {
    "poem_id": 1912,
    "vorder": 36,
    "position": 1,
    "text": "که را برگزینند پاک از میان"
  },
  {
    "poem_id": 1912,
    "vorder": 37,
    "position": 0,
    "text": "چو اشتاد و خراد برزین پیر"
  },
  {
    "poem_id": 1912,
    "vorder": 38,
    "position": 1,
    "text": "دو دانا و گوینده و یادگیر"
  },
  {
    "poem_id": 1912,
    "vorder": 39,
    "position": 0,
    "text": "بدیشان چنین گفت کای بخردان"
  },
  {
    "poem_id": 1912,
    "vorder": 40,
    "position": 1,
    "text": "جهاندیده و کارکرده ردان"
  },
  {
    "poem_id": 1912,
    "vorder": 41,
    "position": 0,
    "text": "مدارید کار جهان را به رنج"
  },
  {
    "poem_id": 1912,
    "vorder": 42,
    "position": 1,
    "text": "که از رنج یابد سرافراز گنج"
  },
  {
    "poem_id": 1912,
    "vorder": 43,
    "position": 0,
    "text": "دو داننده بی‌کام برخاستند"
  },
  {
    "poem_id": 1912,
    "vorder": 44,
    "position": 1,
    "text": "پر از آب مژگان بیاراستند"
  },
  {
    "poem_id": 1912,
    "vorder": 45,
    "position": 0,
    "text": "چو خراد بر زین و اشتاگشسپ"
  },
  {
    "poem_id": 1912,
    "vorder": 46,
    "position": 1,
    "text": "به فرمان نشستند هر دو بر اسپ"
  },
  {
    "poem_id": 1912,
    "vorder": 47,
    "position": 0,
    "text": "بدیشان چنین گفت کز دل کنون"
  },
  {
    "poem_id": 1912,
    "vorder": 48,
    "position": 1,
    "text": "بباید گرفتن ره طیسفون"
  },
  {
    "poem_id": 1912,
    "vorder": 49,
    "position": 0,
    "text": "پیامی رسانید نزد پدر"
  },
  {
    "poem_id": 1912,
    "vorder": 50,
    "position": 1,
    "text": "سخن یادگیری همه در بدر"
  },
  {
    "poem_id": 1912,
    "vorder": 51,
    "position": 0,
    "text": "بگویی که ما را نبد این گناه"
  },
  {
    "poem_id": 1912,
    "vorder": 52,
    "position": 1,
    "text": "نه ایرانیان را بد این دستگاه"
  },
  {
    "poem_id": 1912,
    "vorder": 53,
    "position": 0,
    "text": "که باد افرهٔ ایزدی یافتی"
  },
  {
    "poem_id": 1912,
    "vorder": 54,
    "position": 1,
    "text": "چو از نیکوی روی بر تافتی"
  },
  {
    "poem_id": 1912,
    "vorder": 55,
    "position": 0,
    "text": "یکی آنک ناباک خون پدر"
  },
  {
    "poem_id": 1912,
    "vorder": 56,
    "position": 1,
    "text": "نریزد ز تن پاک زاده پسر"
  },
  {
    "poem_id": 1912,
    "vorder": 57,
    "position": 0,
    "text": "نباشد همان نیز هم داستان"
  },
  {
    "poem_id": 1912,
    "vorder": 58,
    "position": 1,
    "text": "که پیشش کسی گوید این داستان"
  },
  {
    "poem_id": 1912,
    "vorder": 59,
    "position": 0,
    "text": "دگر آنک گیتی پر از گنج تست"
  },
  {
    "poem_id": 1912,
    "vorder": 60,
    "position": 1,
    "text": "رسیده به هر کشوری رنج تست"
  },
  {
    "poem_id": 1912,
    "vorder": 61,
    "position": 0,
    "text": "نبودی بدین نیز هم داستان"
  },
  {
    "poem_id": 1912,
    "vorder": 62,
    "position": 1,
    "text": "پر از درد کردی دل راستان"
  },
  {
    "poem_id": 1912,
    "vorder": 63,
    "position": 0,
    "text": "سدیگر که چندان دلیر و سوار"
  },
  {
    "poem_id": 1912,
    "vorder": 64,
    "position": 1,
    "text": "که بود اندر ایران همه نامدار"
  },
  {
    "poem_id": 1912,
    "vorder": 65,
    "position": 0,
    "text": "نبودند شادان ز فرزند خویش"
  },
  {
    "poem_id": 1912,
    "vorder": 66,
    "position": 1,
    "text": "ز بوم و بر و پاک پیوند خویش"
  },
  {
    "poem_id": 1912,
    "vorder": 67,
    "position": 0,
    "text": "یکی سوی چین بد یکی سوی روم"
  },
  {
    "poem_id": 1912,
    "vorder": 68,
    "position": 1,
    "text": "پراگنده گشته به هر مرز و بوم"
  },
  {
    "poem_id": 1912,
    "vorder": 69,
    "position": 0,
    "text": "دگر آنک قیصر بجای تو کرد"
  },
  {
    "poem_id": 1912,
    "vorder": 70,
    "position": 1,
    "text": "ز هر گونه از تو چه تیمار خورد"
  },
  {
    "poem_id": 1912,
    "vorder": 71,
    "position": 0,
    "text": "سپه داد و دختر تو را داد نیز"
  },
  {
    "poem_id": 1912,
    "vorder": 72,
    "position": 1,
    "text": "همان گنج و با گنج بسیار چیز"
  },
  {
    "poem_id": 1912,
    "vorder": 73,
    "position": 0,
    "text": "همی‌خواست دار مسیحا به روم"
  },
  {
    "poem_id": 1912,
    "vorder": 74,
    "position": 1,
    "text": "بدان تا شود خرم آباد بوم"
  },
  {
    "poem_id": 1912,
    "vorder": 75,
    "position": 0,
    "text": "به گنج تو از دار عیسی چه سود"
  },
  {
    "poem_id": 1912,
    "vorder": 76,
    "position": 1,
    "text": "که قیصر به خوبی همی شاد بود"
  },
  {
    "poem_id": 1912,
    "vorder": 77,
    "position": 0,
    "text": "ز بیچارگان خواسته بستدی"
  },
  {
    "poem_id": 1912,
    "vorder": 78,
    "position": 1,
    "text": "ز نفرین به روی تو آمد بدی"
  },
  {
    "poem_id": 1912,
    "vorder": 79,
    "position": 0,
    "text": "ز یزدان شناس آنچ آمدت پیش"
  },
  {
    "poem_id": 1912,
    "vorder": 80,
    "position": 1,
    "text": "بر اندیش زان زشت کردار خویش"
  },
  {
    "poem_id": 1912,
    "vorder": 81,
    "position": 0,
    "text": "بدان بد که کردی بهانه منم"
  },
  {
    "poem_id": 1912,
    "vorder": 82,
    "position": 1,
    "text": "سخن را نخست آستانه منم"
  },
  {
    "poem_id": 1912,
    "vorder": 83,
    "position": 0,
    "text": "به یزدان که از من نبد این گناه"
  },
  {
    "poem_id": 1912,
    "vorder": 84,
    "position": 1,
    "text": "نجستم که ویران شود گاه شاه"
  },
  {
    "poem_id": 1912,
    "vorder": 85,
    "position": 0,
    "text": "کنون پوزش این همه بازجوی"
  },
  {
    "poem_id": 1912,
    "vorder": 86,
    "position": 1,
    "text": "بدین نامداران ایران بگوی"
  },
  {
    "poem_id": 1912,
    "vorder": 87,
    "position": 0,
    "text": "ز هر بد که کردی به یزدان گرای"
  },
  {
    "poem_id": 1912,
    "vorder": 88,
    "position": 1,
    "text": "کجا هست بر نیکوی رهنمای"
  },
  {
    "poem_id": 1912,
    "vorder": 89,
    "position": 0,
    "text": "مگر مر تو را او بود دستگیر"
  },
  {
    "poem_id": 1912,
    "vorder": 90,
    "position": 1,
    "text": "بدین رنجهایی که بودت گزیر"
  },
  {
    "poem_id": 1912,
    "vorder": 91,
    "position": 0,
    "text": "دگر آنک فرزند بودت دو هشت"
  },
  {
    "poem_id": 1912,
    "vorder": 92,
    "position": 1,
    "text": "شب و روز ایشان به زندان گذشت"
  },
  {
    "poem_id": 1912,
    "vorder": 93,
    "position": 0,
    "text": "به در بر کسی ایمن از تو نخفت"
  },
  {
    "poem_id": 1912,
    "vorder": 94,
    "position": 1,
    "text": "ز بیم تو بگذاشتندی نهفت"
  },
  {
    "poem_id": 1912,
    "vorder": 95,
    "position": 0,
    "text": "چو بشنید پیغام او این دو مرد"
  },
  {
    "poem_id": 1912,
    "vorder": 96,
    "position": 1,
    "text": "برفتند دلها پر از داغ و درد"
  },
  {
    "poem_id": 1912,
    "vorder": 97,
    "position": 0,
    "text": "برین گونه تا کشور طیسفون"
  },
  {
    "poem_id": 1912,
    "vorder": 98,
    "position": 1,
    "text": "همه دیده پرآب و دل پر ز خون"
  },
  {
    "poem_id": 1912,
    "vorder": 99,
    "position": 0,
    "text": "نشسته بدر بر گلینوش بود"
  },
  {
    "poem_id": 1912,
    "vorder": 100,
    "position": 1,
    "text": "که گفتی زمین زو پر از جوش بود"
  },
  {
    "poem_id": 1912,
    "vorder": 101,
    "position": 0,
    "text": "همه لشکرش یک سر آراسته"
  },
  {
    "poem_id": 1912,
    "vorder": 102,
    "position": 1,
    "text": "کشیده همه تیغ و پیراسته"
  },
  {
    "poem_id": 1912,
    "vorder": 103,
    "position": 0,
    "text": "ابا جوشن و خود بسته میان"
  },
  {
    "poem_id": 1912,
    "vorder": 104,
    "position": 1,
    "text": "همان تازی اسپان به برگستوان"
  },
  {
    "poem_id": 1912,
    "vorder": 105,
    "position": 0,
    "text": "به جنگ اندرون گرز پولاد داشت"
  },
  {
    "poem_id": 1912,
    "vorder": 106,
    "position": 1,
    "text": "همه دل پر از آتش و باد داشت"
  },
  {
    "poem_id": 1912,
    "vorder": 107,
    "position": 0,
    "text": "چو خراد برزین و اشتاگشسپ"
  },
  {
    "poem_id": 1912,
    "vorder": 108,
    "position": 1,
    "text": "فرود آمدند این دو دانا از اسپ"
  },
  {
    "poem_id": 1912,
    "vorder": 109,
    "position": 0,
    "text": "گلینوش بر پای جست آن زمان"
  },
  {
    "poem_id": 1912,
    "vorder": 110,
    "position": 1,
    "text": "ز دیدار ایشان ببد شادمان"
  },
  {
    "poem_id": 1912,
    "vorder": 111,
    "position": 0,
    "text": "بجایی که بایست بنشاندشان"
  },
  {
    "poem_id": 1912,
    "vorder": 112,
    "position": 1,
    "text": "همی مهتر نامور خواندشان"
  },
  {
    "poem_id": 1912,
    "vorder": 113,
    "position": 0,
    "text": "سخن گوی خراد برزین نخست"
  },
  {
    "poem_id": 1912,
    "vorder": 114,
    "position": 1,
    "text": "زبان را به آب دلیری بشست"
  },
  {
    "poem_id": 1912,
    "vorder": 115,
    "position": 0,
    "text": "گلینوش را گفت فرخ قباد"
  },
  {
    "poem_id": 1912,
    "vorder": 116,
    "position": 1,
    "text": "به آرام تاج کیان برنهاد"
  },
  {
    "poem_id": 1912,
    "vorder": 117,
    "position": 0,
    "text": "به ایران و توران و روم آگهیست"
  },
  {
    "poem_id": 1912,
    "vorder": 118,
    "position": 1,
    "text": "که شیروی بر تخت شاهنشهیست"
  },
  {
    "poem_id": 1912,
    "vorder": 119,
    "position": 0,
    "text": "تواین جوشن و خود و گبر و کمان"
  },
  {
    "poem_id": 1912,
    "vorder": 120,
    "position": 1,
    "text": "چه داری همی کیستت بد گمان"
  },
  {
    "poem_id": 1912,
    "vorder": 121,
    "position": 0,
    "text": "گلینوش گفت ای جهاندیده مرد"
  },
  {
    "poem_id": 1912,
    "vorder": 122,
    "position": 1,
    "text": "به کام تو بادا همه کارکرد"
  },
  {
    "poem_id": 1912,
    "vorder": 123,
    "position": 0,
    "text": "که تیمار بردی ز نازک تنم"
  },
  {
    "poem_id": 1912,
    "vorder": 124,
    "position": 1,
    "text": "کجا آهنین بود پیراهنم"
  },
  {
    "poem_id": 1912,
    "vorder": 125,
    "position": 0,
    "text": "برین مهر بر آفرین خوانمت"
  },
  {
    "poem_id": 1912,
    "vorder": 126,
    "position": 1,
    "text": "سزایی که گوهر برافشانمت"
  },
  {
    "poem_id": 1912,
    "vorder": 127,
    "position": 0,
    "text": "نباشد به جز خوب گفتار تو"
  },
  {
    "poem_id": 1912,
    "vorder": 128,
    "position": 1,
    "text": "که خورشید بادا نگهدار تو"
  },
  {
    "poem_id": 1912,
    "vorder": 129,
    "position": 0,
    "text": "به کاری کجا آمدستی بگوی"
  },
  {
    "poem_id": 1912,
    "vorder": 130,
    "position": 1,
    "text": "پس آنگه سخنهای من بازجوی"
  },
  {
    "poem_id": 1912,
    "vorder": 131,
    "position": 0,
    "text": "چنین داد پاسخ که فرخ قباد"
  },
  {
    "poem_id": 1912,
    "vorder": 132,
    "position": 1,
    "text": "به خسرو مرا چند پیغام داد"
  },
  {
    "poem_id": 1912,
    "vorder": 133,
    "position": 0,
    "text": "اگر باز خواهی بگویم همه"
  },
  {
    "poem_id": 1912,
    "vorder": 134,
    "position": 1,
    "text": "پیام جهاندار شاه رمه"
  },
  {
    "poem_id": 1912,
    "vorder": 135,
    "position": 0,
    "text": "گلینوش گفت این گرانمایه مرد"
  },
  {
    "poem_id": 1912,
    "vorder": 136,
    "position": 1,
    "text": "که داند سخنها همه یاد کرد"
  },
  {
    "poem_id": 1912,
    "vorder": 137,
    "position": 0,
    "text": "ز لیکن مرا شاه ایران قباد"
  },
  {
    "poem_id": 1912,
    "vorder": 138,
    "position": 1,
    "text": "بسی اندرین پند و اندرز داد"
  },
  {
    "poem_id": 1912,
    "vorder": 139,
    "position": 0,
    "text": "که همداستانی مکن روز و شب"
  },
  {
    "poem_id": 1912,
    "vorder": 140,
    "position": 1,
    "text": "که کس پیش خسرو گشاید دو لب"
  },
  {
    "poem_id": 1912,
    "vorder": 141,
    "position": 0,
    "text": "مگر آنک گفتار او بشنوی"
  },
  {
    "poem_id": 1912,
    "vorder": 142,
    "position": 1,
    "text": "اگر پارسی گوید ار پهلوی"
  },
  {
    "poem_id": 1912,
    "vorder": 143,
    "position": 0,
    "text": "چنین گفت اشتاد کای شادکام"
  },
  {
    "poem_id": 1912,
    "vorder": 144,
    "position": 1,
    "text": "من اندر نهانی ندارم پیام"
  },
  {
    "poem_id": 1912,
    "vorder": 145,
    "position": 0,
    "text": "پیامیست کان تیغ بار آورد"
  },
  {
    "poem_id": 1912,
    "vorder": 146,
    "position": 1,
    "text": "سر سرکشان در کنار آورد"
  },
  {
    "poem_id": 1912,
    "vorder": 147,
    "position": 0,
    "text": "تو اکنون ز خسرو برین بارخواه"
  },
  {
    "poem_id": 1912,
    "vorder": 148,
    "position": 1,
    "text": "بدان تا بگویم پیامش ز شاه"
  },
  {
    "poem_id": 1912,
    "vorder": 149,
    "position": 0,
    "text": "گلینوش بشنید و بر پای جست"
  },
  {
    "poem_id": 1912,
    "vorder": 150,
    "position": 1,
    "text": "همه بندها رابهم برشکست"
  },
  {
    "poem_id": 1912,
    "vorder": 151,
    "position": 0,
    "text": "بر شاه شد دست کرده بکش"
  },
  {
    "poem_id": 1912,
    "vorder": 152,
    "position": 1,
    "text": "چنان چون بباید پرستارفش"
  },
  {
    "poem_id": 1912,
    "vorder": 153,
    "position": 0,
    "text": "بدو گفت شاها انوشه بدی"
  },
  {
    "poem_id": 1912,
    "vorder": 154,
    "position": 1,
    "text": "مبادا دل تو نژند از بدی"
  },
  {
    "poem_id": 1912,
    "vorder": 155,
    "position": 0,
    "text": "چو اشتاد و خراد برزین به شاه"
  },
  {
    "poem_id": 1912,
    "vorder": 156,
    "position": 1,
    "text": "پیام آوریدند زان بارگاه"
  },
  {
    "poem_id": 1912,
    "vorder": 157,
    "position": 0,
    "text": "بخندید خسرو به آواز گفت"
  },
  {
    "poem_id": 1912,
    "vorder": 158,
    "position": 1,
    "text": "که این رای تو با خرد نیست جفت"
  },
  {
    "poem_id": 1912,
    "vorder": 159,
    "position": 0,
    "text": "گرو شهریارست پس من کیم"
  },
  {
    "poem_id": 1912,
    "vorder": 160,
    "position": 1,
    "text": "درین تنگ زندان ز بهر چیم"
  },
  {
    "poem_id": 1912,
    "vorder": 161,
    "position": 0,
    "text": "که از من همی بار بایدت خواست"
  },
  {
    "poem_id": 1912,
    "vorder": 162,
    "position": 1,
    "text": "اگر کژ گویی اگر راه راست"
  },
  {
    "poem_id": 1912,
    "vorder": 163,
    "position": 0,
    "text": "بیامد گلینوش نزد گوان"
  },
  {
    "poem_id": 1912,
    "vorder": 164,
    "position": 1,
    "text": "بگفت این سخن گفتن پهلوان"
  },
  {
    "poem_id": 1912,
    "vorder": 165,
    "position": 0,
    "text": "کنون دست کرده بکش در شوید"
  },
  {
    "poem_id": 1912,
    "vorder": 166,
    "position": 1,
    "text": "بگویید و گفتار او بشنوید"
  },
  {
    "poem_id": 1912,
    "vorder": 167,
    "position": 0,
    "text": "دو مرد خردمند و پاکیزه‌گوی"
  },
  {
    "poem_id": 1912,
    "vorder": 168,
    "position": 1,
    "text": "به دستار چینی بپوشید روی"
  },
  {
    "poem_id": 1912,
    "vorder": 169,
    "position": 0,
    "text": "چو دیدند بردند پیشش نماز"
  },
  {
    "poem_id": 1912,
    "vorder": 170,
    "position": 1,
    "text": "ببودند هر دو زمانی دراز"
  },
  {
    "poem_id": 1912,
    "vorder": 171,
    "position": 0,
    "text": "جهاندار بر شادورد بزرگ"
  },
  {
    "poem_id": 1912,
    "vorder": 172,
    "position": 1,
    "text": "نوشته همه پیکرش میش و گرگ"
  },
  {
    "poem_id": 1912,
    "vorder": 173,
    "position": 0,
    "text": "همان زر و گوهر برو بافته"
  },
  {
    "poem_id": 1912,
    "vorder": 174,
    "position": 1,
    "text": "سراسر یک اندر دگر تافته"
  },
  {
    "poem_id": 1912,
    "vorder": 175,
    "position": 0,
    "text": "نهالیش در زیر دیبای زرد"
  },
  {
    "poem_id": 1912,
    "vorder": 176,
    "position": 1,
    "text": "پس پشت او مسند لاژورد"
  },
  {
    "poem_id": 1912,
    "vorder": 177,
    "position": 0,
    "text": "بهی تناور گرفته بدست"
  },
  {
    "poem_id": 1912,
    "vorder": 178,
    "position": 1,
    "text": "دژم خفته بر جایگاه نشست"
  },
  {
    "poem_id": 1912,
    "vorder": 179,
    "position": 0,
    "text": "چودید آن دو مرد گرانمایه را"
  },
  {
    "poem_id": 1912,
    "vorder": 180,
    "position": 1,
    "text": "به دانایی اندر سرمایه را"
  },
  {
    "poem_id": 1912,
    "vorder": 181,
    "position": 0,
    "text": "از آن خفتگی خویشتن کرد راست"
  },
  {
    "poem_id": 1912,
    "vorder": 182,
    "position": 1,
    "text": "جهان آفریننده را یار خواست"
  },
  {
    "poem_id": 1912,
    "vorder": 183,
    "position": 0,
    "text": "به بالین نهاد آن گرامی بهی"
  },
  {
    "poem_id": 1912,
    "vorder": 184,
    "position": 1,
    "text": "بدان تا بپرسید ز هر دو رهی"
  },
  {
    "poem_id": 1912,
    "vorder": 185,
    "position": 0,
    "text": "بهی زان دو بالش به نرمی بگشت"
  },
  {
    "poem_id": 1912,
    "vorder": 186,
    "position": 1,
    "text": "بی‌آزار گردان ز مرقد گذشت"
  },
  {
    "poem_id": 1912,
    "vorder": 187,
    "position": 0,
    "text": "بدین گونه تا شادورد مهین"
  },
  {
    "poem_id": 1912,
    "vorder": 188,
    "position": 1,
    "text": "همی‌گشت تاشد به روی زمین"
  },
  {
    "poem_id": 1912,
    "vorder": 189,
    "position": 0,
    "text": "به پویید اشتاد و آن برگرفت"
  },
  {
    "poem_id": 1912,
    "vorder": 190,
    "position": 1,
    "text": "به مالیدش از خاک و بر سر گرفت"
  },
  {
    "poem_id": 1912,
    "vorder": 191,
    "position": 0,
    "text": "جهاندار از اشتاد برگاشت روی"
  },
  {
    "poem_id": 1912,
    "vorder": 192,
    "position": 1,
    "text": "بدان تا ندید از بهی رنگ و بوی"
  },
  {
    "poem_id": 1912,
    "vorder": 193,
    "position": 0,
    "text": "بهی رانهادند بر شادورد"
  },
  {
    "poem_id": 1912,
    "vorder": 194,
    "position": 1,
    "text": "همی‌بود برپای پیش این دو مرد"
  },
  {
    "poem_id": 1912,
    "vorder": 195,
    "position": 0,
    "text": "پر اندیشه شد نامدار از بهی"
  },
  {
    "poem_id": 1912,
    "vorder": 196,
    "position": 1,
    "text": "ندید اندر و هیچ فال بهی"
  },
  {
    "poem_id": 1912,
    "vorder": 197,
    "position": 0,
    "text": "همانگه سوی آسمان کرد روی"
  },
  {
    "poem_id": 1912,
    "vorder": 198,
    "position": 1,
    "text": "چنین گفت کای داور راست گوی"
  },
  {
    "poem_id": 1912,
    "vorder": 199,
    "position": 0,
    "text": "که برگیرد آن راکه تو افگنی"
  },
  {
    "poem_id": 1912,
    "vorder": 200,
    "position": 1,
    "text": "که پیوندد آن را که تو بشکنی"
  },
  {
    "poem_id": 1912,
    "vorder": 201,
    "position": 0,
    "text": "چو از دوده‌ام بخت روشن بگشت"
  },
  {
    "poem_id": 1912,
    "vorder": 202,
    "position": 1,
    "text": "غم آورد چون روشنایی گذشت"
  },
  {
    "poem_id": 1912,
    "vorder": 203,
    "position": 0,
    "text": "به اشتاد گفت آنچ داری پیام"
  },
  {
    "poem_id": 1912,
    "vorder": 204,
    "position": 1,
    "text": "ازان بی منش کودک زشت کام"
  },
  {
    "poem_id": 1912,
    "vorder": 205,
    "position": 0,
    "text": "وزان بد سگالان که بی‌دانشند"
  },
  {
    "poem_id": 1912,
    "vorder": 206,
    "position": 1,
    "text": "ز بی دانشی ویژه بی رامش‌اند"
  },
  {
    "poem_id": 1912,
    "vorder": 207,
    "position": 0,
    "text": "همان زان سپاه پراگندگان"
  },
  {
    "poem_id": 1912,
    "vorder": 208,
    "position": 1,
    "text": "پر اندیشه و تیره دل بندگان"
  },
  {
    "poem_id": 1912,
    "vorder": 209,
    "position": 0,
    "text": "بخواهد شدن بخت زین دودمان"
  },
  {
    "poem_id": 1912,
    "vorder": 210,
    "position": 1,
    "text": "نماند درین تخمه کس شادمان"
  },
  {
    "poem_id": 1912,
    "vorder": 211,
    "position": 0,
    "text": "سوی ناسزایان شود تاج وتخت"
  },
  {
    "poem_id": 1912,
    "vorder": 212,
    "position": 1,
    "text": "تبه گردد این خسروانی درخت"
  },
  {
    "poem_id": 1912,
    "vorder": 213,
    "position": 0,
    "text": "نماند بزرگی به فرزند من"
  },
  {
    "poem_id": 1912,
    "vorder": 214,
    "position": 1,
    "text": "نه بر دوده و خویش و پیوند من"
  },
  {
    "poem_id": 1912,
    "vorder": 215,
    "position": 0,
    "text": "همه دوستان ویژه دشمن شوند"
  },
  {
    "poem_id": 1912,
    "vorder": 216,
    "position": 1,
    "text": "بدین دوده بَدگوی و بَدتَن شوند"
  },
  {
    "poem_id": 1912,
    "vorder": 217,
    "position": 0,
    "text": "نهان آشکارا بکرد این بهی"
  },
  {
    "poem_id": 1912,
    "vorder": 218,
    "position": 1,
    "text": "که بی تو شود تخت شاهی تهی"
  },
  {
    "poem_id": 1912,
    "vorder": 219,
    "position": 0,
    "text": "سخن هرچ بشنیدی اکنون بگوی"
  },
  {
    "poem_id": 1912,
    "vorder": 220,
    "position": 1,
    "text": "پیامش مرا کمتر از آب جوی"
  },
  {
    "poem_id": 1912,
    "vorder": 221,
    "position": 0,
    "text": "گشادند گویا زبان این دو مرد"
  },
  {
    "poem_id": 1912,
    "vorder": 222,
    "position": 1,
    "text": "برآورد پیچان یکی باد سرد"
  }
]