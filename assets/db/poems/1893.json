[
  {
    "poem_id": 1893,
    "vorder": 1,
    "position": 0,
    "text": "دو هفته برآمد بدو گفت شاه"
  },
  {
    "poem_id": 1893,
    "vorder": 2,
    "position": 1,
    "text": "به خورشید و ماه و به تخت و کلاه"
  },
  {
    "poem_id": 1893,
    "vorder": 3,
    "position": 0,
    "text": "که برگویی آن جنگ خاقانیان"
  },
  {
    "poem_id": 1893,
    "vorder": 4,
    "position": 1,
    "text": "ببندی کمر همچنان بر میان"
  },
  {
    "poem_id": 1893,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت شاها انوشه بدی"
  },
  {
    "poem_id": 1893,
    "vorder": 6,
    "position": 1,
    "text": "روان را به دیدار توشه بدی"
  },
  {
    "poem_id": 1893,
    "vorder": 7,
    "position": 0,
    "text": "بفرمای تا اسپ و زین آورند"
  },
  {
    "poem_id": 1893,
    "vorder": 8,
    "position": 1,
    "text": "کمان و کمند و کمین آورند"
  },
  {
    "poem_id": 1893,
    "vorder": 9,
    "position": 0,
    "text": "همان نیزه و خود و خفتان جنگ"
  },
  {
    "poem_id": 1893,
    "vorder": 10,
    "position": 1,
    "text": "یکی ترکش آگنده تیر خدنگ"
  },
  {
    "poem_id": 1893,
    "vorder": 11,
    "position": 0,
    "text": "پرستنده‌ای را بفرمود شاه"
  },
  {
    "poem_id": 1893,
    "vorder": 12,
    "position": 1,
    "text": "که درباغ گلشن بیارای گاه"
  },
  {
    "poem_id": 1893,
    "vorder": 13,
    "position": 0,
    "text": "برفتند بیدار دل بندگان"
  },
  {
    "poem_id": 1893,
    "vorder": 14,
    "position": 1,
    "text": "ز ترک و ز رومی پرستندگان"
  },
  {
    "poem_id": 1893,
    "vorder": 15,
    "position": 0,
    "text": "ز خوبان رومی هزار و دویست"
  },
  {
    "poem_id": 1893,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی به باغ اندرون راه نیست"
  },
  {
    "poem_id": 1893,
    "vorder": 17,
    "position": 0,
    "text": "چو خورشید شیرین به پیش اندرون"
  },
  {
    "poem_id": 1893,
    "vorder": 18,
    "position": 1,
    "text": "خرامان به بالای سیمین ستون"
  },
  {
    "poem_id": 1893,
    "vorder": 19,
    "position": 0,
    "text": "بشد گردیه تا به نزدیک شاه"
  },
  {
    "poem_id": 1893,
    "vorder": 20,
    "position": 1,
    "text": "زره خواست از ترک و رومی کلاه"
  },
  {
    "poem_id": 1893,
    "vorder": 21,
    "position": 0,
    "text": "بیامد خرامان ز جای نشست"
  },
  {
    "poem_id": 1893,
    "vorder": 22,
    "position": 1,
    "text": "کمر بر میان بست و نیزه بدست"
  },
  {
    "poem_id": 1893,
    "vorder": 23,
    "position": 0,
    "text": "بشاه جهان گفت دستور باش"
  },
  {
    "poem_id": 1893,
    "vorder": 24,
    "position": 1,
    "text": "یکی چشم بگشا ز بد دور باش"
  },
  {
    "poem_id": 1893,
    "vorder": 25,
    "position": 0,
    "text": "بدان پر هنر زن بفرمود شاه"
  },
  {
    "poem_id": 1893,
    "vorder": 26,
    "position": 1,
    "text": "زن آمد به نزدیک اسپ سیاه"
  },
  {
    "poem_id": 1893,
    "vorder": 27,
    "position": 0,
    "text": "بن نیزه را بر زمین برنهاد"
  },
  {
    "poem_id": 1893,
    "vorder": 28,
    "position": 1,
    "text": "ز بالا بزین اندرآمد چوباد"
  },
  {
    "poem_id": 1893,
    "vorder": 29,
    "position": 0,
    "text": "به باغ اندر آورد گاهی گرفت"
  },
  {
    "poem_id": 1893,
    "vorder": 30,
    "position": 1,
    "text": "چپ وراست بیگانه راهی گرفت"
  },
  {
    "poem_id": 1893,
    "vorder": 31,
    "position": 0,
    "text": "همی هر زمان باره برگاشتی"
  },
  {
    "poem_id": 1893,
    "vorder": 32,
    "position": 1,
    "text": "وز ابر سیه نعره برداشتی"
  },
  {
    "poem_id": 1893,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت هنگام جنگ تبرگ"
  },
  {
    "poem_id": 1893,
    "vorder": 34,
    "position": 1,
    "text": "بدین گونه بودم چو غرنده گرگ"
  },
  {
    "poem_id": 1893,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت شیرین که ای شهریار"
  },
  {
    "poem_id": 1893,
    "vorder": 36,
    "position": 1,
    "text": "بدشمن دهی آلت کار زار"
  },
  {
    "poem_id": 1893,
    "vorder": 37,
    "position": 0,
    "text": "تو با جامه پاک بر تخت زر"
  },
  {
    "poem_id": 1893,
    "vorder": 38,
    "position": 1,
    "text": "ورا هر زمان برتو باشد گذر"
  },
  {
    "poem_id": 1893,
    "vorder": 39,
    "position": 0,
    "text": "بخنده به شیرین چنین گفت شاه"
  },
  {
    "poem_id": 1893,
    "vorder": 40,
    "position": 1,
    "text": "کزین زن جز از دوستداری مخواه"
  },
  {
    "poem_id": 1893,
    "vorder": 41,
    "position": 0,
    "text": "همی‌تاخت گرد اندرش گردیه"
  },
  {
    "poem_id": 1893,
    "vorder": 42,
    "position": 1,
    "text": "برآورد گاهی برش گردیه"
  },
  {
    "poem_id": 1893,
    "vorder": 43,
    "position": 0,
    "text": "بدو مانده بد خسرو اندر شگفت"
  },
  {
    "poem_id": 1893,
    "vorder": 44,
    "position": 1,
    "text": "بدان برز و بالا و آن یال و کفت"
  },
  {
    "poem_id": 1893,
    "vorder": 45,
    "position": 0,
    "text": "چنین گفت با گردیه شهریار"
  },
  {
    "poem_id": 1893,
    "vorder": 46,
    "position": 1,
    "text": "که بی‌عیبی از گردش روزگار"
  },
  {
    "poem_id": 1893,
    "vorder": 47,
    "position": 0,
    "text": "کنون تا ببینم که با جام می"
  },
  {
    "poem_id": 1893,
    "vorder": 48,
    "position": 1,
    "text": "یکی سست باشی اگر سخت پی"
  },
  {
    "poem_id": 1893,
    "vorder": 49,
    "position": 0,
    "text": "بگرد جهان چار سالار من"
  },
  {
    "poem_id": 1893,
    "vorder": 50,
    "position": 1,
    "text": "که هستند بر جان نگهبان من"
  },
  {
    "poem_id": 1893,
    "vorder": 51,
    "position": 0,
    "text": "ابا هریکی زان ده و دو هزار"
  },
  {
    "poem_id": 1893,
    "vorder": 52,
    "position": 1,
    "text": "ز ایران بپای اند جنگی سوار"
  },
  {
    "poem_id": 1893,
    "vorder": 53,
    "position": 0,
    "text": "چنین هم به مشکوی زرین من"
  },
  {
    "poem_id": 1893,
    "vorder": 54,
    "position": 1,
    "text": "چه در خانهٔ گوهر آگین من"
  },
  {
    "poem_id": 1893,
    "vorder": 55,
    "position": 0,
    "text": "پرستار باشد ده و دو هزار"
  },
  {
    "poem_id": 1893,
    "vorder": 56,
    "position": 1,
    "text": "همه پاک با طوق و با گوشوار"
  },
  {
    "poem_id": 1893,
    "vorder": 57,
    "position": 0,
    "text": "ازان پس نگهدار ایشان توی"
  },
  {
    "poem_id": 1893,
    "vorder": 58,
    "position": 1,
    "text": "که با رنج و تیمار خویشان توی"
  },
  {
    "poem_id": 1893,
    "vorder": 59,
    "position": 0,
    "text": "نخواهم که گویند زیشان سخن"
  },
  {
    "poem_id": 1893,
    "vorder": 60,
    "position": 1,
    "text": "جز از تو اگر نو بود گر کهن"
  },
  {
    "poem_id": 1893,
    "vorder": 61,
    "position": 0,
    "text": "شنید آن سخن گردیه شاد شد"
  },
  {
    "poem_id": 1893,
    "vorder": 62,
    "position": 1,
    "text": "ز بیغارهٔ دشمن آزاد شد"
  },
  {
    "poem_id": 1893,
    "vorder": 63,
    "position": 0,
    "text": "همی‌رفت روی زمین را بروی"
  },
  {
    "poem_id": 1893,
    "vorder": 64,
    "position": 1,
    "text": "همی آفرین خواند بر فر اوی"
  }
]