[
  {
    "poem_id": 1924,
    "vorder": 1,
    "position": 0,
    "text": "چو بگذشت زو شاه شد یزدگرد"
  },
  {
    "poem_id": 1924,
    "vorder": 2,
    "position": 1,
    "text": "به ماه سفندار مذ روز ارد"
  },
  {
    "poem_id": 1924,
    "vorder": 3,
    "position": 0,
    "text": "چه گفت آن سخنگوی مرد دلیر"
  },
  {
    "poem_id": 1924,
    "vorder": 4,
    "position": 1,
    "text": "چو از گردش روز برگشت سیر"
  },
  {
    "poem_id": 1924,
    "vorder": 5,
    "position": 0,
    "text": "که باری نزادی مرا مادرم"
  },
  {
    "poem_id": 1924,
    "vorder": 6,
    "position": 1,
    "text": "نگشتی سپهر بلند از برم"
  },
  {
    "poem_id": 1924,
    "vorder": 7,
    "position": 0,
    "text": "به پرگار تنگ و میان دو گوی"
  },
  {
    "poem_id": 1924,
    "vorder": 8,
    "position": 1,
    "text": "چه گویم جز از خامشی نیست روی"
  },
  {
    "poem_id": 1924,
    "vorder": 9,
    "position": 0,
    "text": "نه روز بزرگی نه روز نیاز"
  },
  {
    "poem_id": 1924,
    "vorder": 10,
    "position": 1,
    "text": "نماند همی برکسی بر دراز"
  },
  {
    "poem_id": 1924,
    "vorder": 11,
    "position": 0,
    "text": "زمانه ز ما نیست چون بنگری"
  },
  {
    "poem_id": 1924,
    "vorder": 12,
    "position": 1,
    "text": "ندارد کسی آلت داوری"
  },
  {
    "poem_id": 1924,
    "vorder": 13,
    "position": 0,
    "text": "به یارای خوان و به پیمای جام"
  },
  {
    "poem_id": 1924,
    "vorder": 14,
    "position": 1,
    "text": "ز تیمار گیتی مبر هیچ نام"
  },
  {
    "poem_id": 1924,
    "vorder": 15,
    "position": 0,
    "text": "اگر چرخ گردان کشد زین تو"
  },
  {
    "poem_id": 1924,
    "vorder": 16,
    "position": 1,
    "text": "سرانجام خاکست بالین تو"
  },
  {
    "poem_id": 1924,
    "vorder": 17,
    "position": 0,
    "text": "دلت را به تیمار چندین مبند"
  },
  {
    "poem_id": 1924,
    "vorder": 18,
    "position": 1,
    "text": "بس ایمن مشو بر سپهر بلند"
  },
  {
    "poem_id": 1924,
    "vorder": 19,
    "position": 0,
    "text": "که با پیل و با شیربازی کند"
  },
  {
    "poem_id": 1924,
    "vorder": 20,
    "position": 1,
    "text": "چنان دان که از بی‌نیازی کند"
  },
  {
    "poem_id": 1924,
    "vorder": 21,
    "position": 0,
    "text": "تو بیجان شوی او بماند دراز"
  },
  {
    "poem_id": 1924,
    "vorder": 22,
    "position": 1,
    "text": "درازست گفتار چندین مناز"
  },
  {
    "poem_id": 1924,
    "vorder": 23,
    "position": 0,
    "text": "تو از آفریدون فزونتر نه ای"
  },
  {
    "poem_id": 1924,
    "vorder": 24,
    "position": 1,
    "text": "چو پرویز باتخت و افسر نه ای"
  },
  {
    "poem_id": 1924,
    "vorder": 25,
    "position": 0,
    "text": "به ژرفی نگه کن که با یزدگرد"
  },
  {
    "poem_id": 1924,
    "vorder": 26,
    "position": 1,
    "text": "چه کرد این برافراخته هفت گرد"
  },
  {
    "poem_id": 1924,
    "vorder": 27,
    "position": 0,
    "text": "چو بر خسروی گاه بنشست شاد"
  },
  {
    "poem_id": 1924,
    "vorder": 28,
    "position": 1,
    "text": "کلاه بزرگی به سر برنهاد"
  },
  {
    "poem_id": 1924,
    "vorder": 29,
    "position": 0,
    "text": "چنین گفت کز دور چرخ روان"
  },
  {
    "poem_id": 1924,
    "vorder": 30,
    "position": 1,
    "text": "منم پاک فرزند نوشین روان"
  },
  {
    "poem_id": 1924,
    "vorder": 31,
    "position": 0,
    "text": "پدر بر پدر پادشاهی مراست"
  },
  {
    "poem_id": 1924,
    "vorder": 32,
    "position": 1,
    "text": "خور و خوشه و برج ماهی مراست"
  },
  {
    "poem_id": 1924,
    "vorder": 33,
    "position": 0,
    "text": "بزرگی دهم هر که کهتر بود"
  },
  {
    "poem_id": 1924,
    "vorder": 34,
    "position": 1,
    "text": "نیازارم آن راکه مهتر بود"
  },
  {
    "poem_id": 1924,
    "vorder": 35,
    "position": 0,
    "text": "نجویم بزرگی و فرزانگی"
  },
  {
    "poem_id": 1924,
    "vorder": 36,
    "position": 1,
    "text": "همان رزم و تندی و مردانگی"
  },
  {
    "poem_id": 1924,
    "vorder": 37,
    "position": 0,
    "text": "که برکس نماند همی زور و بخت"
  },
  {
    "poem_id": 1924,
    "vorder": 38,
    "position": 1,
    "text": "نه گنج و نه دیهیم شاهی نه تخت"
  },
  {
    "poem_id": 1924,
    "vorder": 39,
    "position": 0,
    "text": "همی نام جاوید باید نه کام"
  },
  {
    "poem_id": 1924,
    "vorder": 40,
    "position": 1,
    "text": "بینداز کام و برافراز نام"
  },
  {
    "poem_id": 1924,
    "vorder": 41,
    "position": 0,
    "text": "برین گونه تا سال شد بر دو هشت"
  },
  {
    "poem_id": 1924,
    "vorder": 42,
    "position": 1,
    "text": "همی ماه و خورشید بر سر گذشت"
  }
]