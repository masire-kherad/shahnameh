[
  {
    "poem_id": 1853,
    "vorder": 1,
    "position": 0,
    "text": "ببود اندر آن شهر خسرو سه روز"
  },
  {
    "poem_id": 1853,
    "vorder": 2,
    "position": 1,
    "text": "چهارم چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 1853,
    "vorder": 3,
    "position": 0,
    "text": "بابر اندر آورد برنده تیغ"
  },
  {
    "poem_id": 1853,
    "vorder": 4,
    "position": 1,
    "text": "جهانجوی شد سوی راه وریغ"
  },
  {
    "poem_id": 1853,
    "vorder": 5,
    "position": 0,
    "text": "که اوریغ بد نام آن شارستان"
  },
  {
    "poem_id": 1853,
    "vorder": 6,
    "position": 1,
    "text": "بدو در چلیپا و بیمارستان"
  },
  {
    "poem_id": 1853,
    "vorder": 7,
    "position": 0,
    "text": "ببی راه پیدا یکی دیر بود"
  },
  {
    "poem_id": 1853,
    "vorder": 8,
    "position": 1,
    "text": "جهانجوی آواز راهب شنود"
  },
  {
    "poem_id": 1853,
    "vorder": 9,
    "position": 0,
    "text": "به نزدیک دیر آمد آواز داد"
  },
  {
    "poem_id": 1853,
    "vorder": 10,
    "position": 1,
    "text": "که کردار تو جز پرستش مباد"
  },
  {
    "poem_id": 1853,
    "vorder": 11,
    "position": 0,
    "text": "گر از دیر دیرینه آیی فرود"
  },
  {
    "poem_id": 1853,
    "vorder": 12,
    "position": 1,
    "text": "زنیکی دهش باد برتو درود"
  },
  {
    "poem_id": 1853,
    "vorder": 13,
    "position": 0,
    "text": "هم آنگاه راهب چو آوا شنید"
  },
  {
    "poem_id": 1853,
    "vorder": 14,
    "position": 1,
    "text": "فرود آمد از دیر و او را بدید"
  },
  {
    "poem_id": 1853,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت خسرو تویی بی‌گمان"
  },
  {
    "poem_id": 1853,
    "vorder": 16,
    "position": 1,
    "text": "زتخت پدرگشته نا شادمان"
  },
  {
    "poem_id": 1853,
    "vorder": 17,
    "position": 0,
    "text": "زدست یکی بدکنش بنده‌ای"
  },
  {
    "poem_id": 1853,
    "vorder": 18,
    "position": 1,
    "text": "پلیدی منی فش پرستنده‌ای"
  },
  {
    "poem_id": 1853,
    "vorder": 19,
    "position": 0,
    "text": "چوگفتار راهب بی‌اندازه شد"
  },
  {
    "poem_id": 1853,
    "vorder": 20,
    "position": 1,
    "text": "دل خسرو از مهر او تازه شد"
  },
  {
    "poem_id": 1853,
    "vorder": 21,
    "position": 0,
    "text": "ز گفتار او در شگفتی بماند"
  },
  {
    "poem_id": 1853,
    "vorder": 22,
    "position": 1,
    "text": "برو بر جهان آفرین رابخواند"
  },
  {
    "poem_id": 1853,
    "vorder": 23,
    "position": 0,
    "text": "ز پشت صلیبی بیازید دست"
  },
  {
    "poem_id": 1853,
    "vorder": 24,
    "position": 1,
    "text": "بپرسیدن مرد یزدان پرست"
  },
  {
    "poem_id": 1853,
    "vorder": 25,
    "position": 0,
    "text": "پرستنده چون دید بردش نماز"
  },
  {
    "poem_id": 1853,
    "vorder": 26,
    "position": 1,
    "text": "سخن گفت با او زمانی دراز"
  },
  {
    "poem_id": 1853,
    "vorder": 27,
    "position": 0,
    "text": "یکی آزمون را بدو گفت شاه"
  },
  {
    "poem_id": 1853,
    "vorder": 28,
    "position": 1,
    "text": "که من کهتری‌ام ز ایران سپاه"
  },
  {
    "poem_id": 1853,
    "vorder": 29,
    "position": 0,
    "text": "پیامی همی نزد قیصر برم"
  },
  {
    "poem_id": 1853,
    "vorder": 30,
    "position": 1,
    "text": "چو پاسخ دهد سوی مهتر برم"
  },
  {
    "poem_id": 1853,
    "vorder": 31,
    "position": 0,
    "text": "گرین رفتن من همایون بود"
  },
  {
    "poem_id": 1853,
    "vorder": 32,
    "position": 1,
    "text": "نگه کن که فرجام من چون بود"
  },
  {
    "poem_id": 1853,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت راهب که چونین مگوی"
  },
  {
    "poem_id": 1853,
    "vorder": 34,
    "position": 1,
    "text": "توشاهی مکن خویشتن شاه جوی"
  },
  {
    "poem_id": 1853,
    "vorder": 35,
    "position": 0,
    "text": "چو دیدمت گفتم سراسر سخن"
  },
  {
    "poem_id": 1853,
    "vorder": 36,
    "position": 1,
    "text": "مرا هر زمان آزمایش مکن"
  },
  {
    "poem_id": 1853,
    "vorder": 37,
    "position": 0,
    "text": "نباید دروغ ایچ دردین تو"
  },
  {
    "poem_id": 1853,
    "vorder": 38,
    "position": 1,
    "text": "نه کژی برین راه و آیین تو"
  },
  {
    "poem_id": 1853,
    "vorder": 39,
    "position": 0,
    "text": "بسی رنج دیدی و آویختی"
  },
  {
    "poem_id": 1853,
    "vorder": 40,
    "position": 1,
    "text": "سرانجام زین بنده بگریختی"
  },
  {
    "poem_id": 1853,
    "vorder": 41,
    "position": 0,
    "text": "ز گفتار او ماند خسرو شگفت"
  },
  {
    "poem_id": 1853,
    "vorder": 42,
    "position": 1,
    "text": "چو شرم آمدش پوزش اندر گرفت"
  },
  {
    "poem_id": 1853,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت راهب که پوزش مکن"
  },
  {
    "poem_id": 1853,
    "vorder": 44,
    "position": 1,
    "text": "بپرس از من از بودنیها سخن"
  },
  {
    "poem_id": 1853,
    "vorder": 45,
    "position": 0,
    "text": "بدین آمدن شاد و گستاخ باش"
  },
  {
    "poem_id": 1853,
    "vorder": 46,
    "position": 1,
    "text": "جهان را یکی بارور شاخ باش"
  },
  {
    "poem_id": 1853,
    "vorder": 47,
    "position": 0,
    "text": "که یزدان تو را بی‌نیازی دهد"
  },
  {
    "poem_id": 1853,
    "vorder": 48,
    "position": 1,
    "text": "بلند اخترت سرفرازی دهد"
  },
  {
    "poem_id": 1853,
    "vorder": 49,
    "position": 0,
    "text": "ز قیصر بیابی سلیح و سپاه"
  },
  {
    "poem_id": 1853,
    "vorder": 50,
    "position": 1,
    "text": "یکی دختری از در تاج و گاه"
  },
  {
    "poem_id": 1853,
    "vorder": 51,
    "position": 0,
    "text": "چو با بندگان کار زارت بود"
  },
  {
    "poem_id": 1853,
    "vorder": 52,
    "position": 1,
    "text": "جهاندار بیدار یارت بود"
  },
  {
    "poem_id": 1853,
    "vorder": 53,
    "position": 0,
    "text": "سرانجام بگریزد آن بد نژاد"
  },
  {
    "poem_id": 1853,
    "vorder": 54,
    "position": 1,
    "text": "فراوان کند روز نیکیش یاد"
  },
  {
    "poem_id": 1853,
    "vorder": 55,
    "position": 0,
    "text": "وزان رزم جایی فتد دور دست"
  },
  {
    "poem_id": 1853,
    "vorder": 56,
    "position": 1,
    "text": "بسازد بران بوم جای نشست"
  },
  {
    "poem_id": 1853,
    "vorder": 57,
    "position": 0,
    "text": "چو دوری گزیند ز فرمان تو"
  },
  {
    "poem_id": 1853,
    "vorder": 58,
    "position": 1,
    "text": "بریزند خونش به پیمان تو"
  },
  {
    "poem_id": 1853,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت خسرو جزین خود مباد"
  },
  {
    "poem_id": 1853,
    "vorder": 60,
    "position": 1,
    "text": "که کردی تو ای پیرداننده یاد"
  },
  {
    "poem_id": 1853,
    "vorder": 61,
    "position": 0,
    "text": "چوگویی بدین چند باشد درنگ"
  },
  {
    "poem_id": 1853,
    "vorder": 62,
    "position": 1,
    "text": "که آید مرا پادشاهی بچنگ"
  },
  {
    "poem_id": 1853,
    "vorder": 63,
    "position": 0,
    "text": "چنین داد پاسخ که ده با دو ماه"
  },
  {
    "poem_id": 1853,
    "vorder": 64,
    "position": 1,
    "text": "برین برگذرد بازیابی کلاه"
  },
  {
    "poem_id": 1853,
    "vorder": 65,
    "position": 0,
    "text": "اگر بر سر آید ده وپنج روز"
  },
  {
    "poem_id": 1853,
    "vorder": 66,
    "position": 1,
    "text": "تو گردی شهنشاه گیتی فروز"
  },
  {
    "poem_id": 1853,
    "vorder": 67,
    "position": 0,
    "text": "بپرسید خسرو کزین انجمن"
  },
  {
    "poem_id": 1853,
    "vorder": 68,
    "position": 1,
    "text": "که کوشد به رنج و به آزار تن"
  },
  {
    "poem_id": 1853,
    "vorder": 69,
    "position": 0,
    "text": "چنین داد پاسخ که بستام نام"
  },
  {
    "poem_id": 1853,
    "vorder": 70,
    "position": 1,
    "text": "گوی برمنش باشد و شادکام"
  },
  {
    "poem_id": 1853,
    "vorder": 71,
    "position": 0,
    "text": "دگر آنک خوانی و را خال خویش"
  },
  {
    "poem_id": 1853,
    "vorder": 72,
    "position": 1,
    "text": "بدو تازه دانی مه و سال خویش"
  },
  {
    "poem_id": 1853,
    "vorder": 73,
    "position": 0,
    "text": "بپرهیز زان مرد ناسودمند"
  },
  {
    "poem_id": 1853,
    "vorder": 74,
    "position": 1,
    "text": "که باشدت زو درد و رنج و گزند"
  },
  {
    "poem_id": 1853,
    "vorder": 75,
    "position": 0,
    "text": "بر آشفت خسرو به بستام گفت"
  },
  {
    "poem_id": 1853,
    "vorder": 76,
    "position": 1,
    "text": "که با من سخن برگشا از نهفت"
  },
  {
    "poem_id": 1853,
    "vorder": 77,
    "position": 0,
    "text": "تو را مادرت نام گستهم کرد"
  },
  {
    "poem_id": 1853,
    "vorder": 78,
    "position": 1,
    "text": "تو گویی که بستامم اندر نبرد"
  },
  {
    "poem_id": 1853,
    "vorder": 79,
    "position": 0,
    "text": "به راهب چنین گفت کینست خال"
  },
  {
    "poem_id": 1853,
    "vorder": 80,
    "position": 1,
    "text": "به خون بود با مادر من همال"
  },
  {
    "poem_id": 1853,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت راهب که آری همین"
  },
  {
    "poem_id": 1853,
    "vorder": 82,
    "position": 1,
    "text": "ز گستهم بینی بسی رنج و کین"
  },
  {
    "poem_id": 1853,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت خسرو که ای رای زن"
  },
  {
    "poem_id": 1853,
    "vorder": 84,
    "position": 1,
    "text": "ازان پس چه گویی چه خواهد بدن"
  },
  {
    "poem_id": 1853,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت راهب که مندیش زین"
  },
  {
    "poem_id": 1853,
    "vorder": 86,
    "position": 1,
    "text": "کزان پس نبینی جز از آفرین"
  },
  {
    "poem_id": 1853,
    "vorder": 87,
    "position": 0,
    "text": "نیاید بروی تو دیگر بدی"
  },
  {
    "poem_id": 1853,
    "vorder": 88,
    "position": 1,
    "text": "مگر سخت کاری بود ایزدی"
  },
  {
    "poem_id": 1853,
    "vorder": 89,
    "position": 0,
    "text": "بر آشوبد این سرکش آرام تو"
  },
  {
    "poem_id": 1853,
    "vorder": 90,
    "position": 1,
    "text": "ازان پس نباشد به جز کام تو"
  },
  {
    "poem_id": 1853,
    "vorder": 91,
    "position": 0,
    "text": "اگر چند بد گردد این بدگمان"
  },
  {
    "poem_id": 1853,
    "vorder": 92,
    "position": 1,
    "text": "همانش بدست تو باشد زمان"
  },
  {
    "poem_id": 1853,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت گستهم کای شهریار"
  },
  {
    "poem_id": 1853,
    "vorder": 94,
    "position": 1,
    "text": "دلت را بدین هیچ رنجه مدار"
  },
  {
    "poem_id": 1853,
    "vorder": 95,
    "position": 0,
    "text": "به پاکیزه یزدان که ماه آفرید"
  },
  {
    "poem_id": 1853,
    "vorder": 96,
    "position": 1,
    "text": "جهان را بسان تو شاه آفرید"
  },
  {
    "poem_id": 1853,
    "vorder": 97,
    "position": 0,
    "text": "به آذرگشسپ و به خورشید و ماه"
  },
  {
    "poem_id": 1853,
    "vorder": 98,
    "position": 1,
    "text": "به جان و سر نامبردار شاه"
  },
  {
    "poem_id": 1853,
    "vorder": 99,
    "position": 0,
    "text": "به گفتار ترسا نگر نگروی"
  },
  {
    "poem_id": 1853,
    "vorder": 100,
    "position": 1,
    "text": "سخن گفتن ناسزا نشنوی"
  },
  {
    "poem_id": 1853,
    "vorder": 101,
    "position": 0,
    "text": "مرا ایمنی ده ز گفتار اوی"
  },
  {
    "poem_id": 1853,
    "vorder": 102,
    "position": 1,
    "text": "چوسوگند خوردم بهانه مجوی"
  },
  {
    "poem_id": 1853,
    "vorder": 103,
    "position": 0,
    "text": "که هرگز نسازم بدی درنهان"
  },
  {
    "poem_id": 1853,
    "vorder": 104,
    "position": 1,
    "text": "براندیش از کردگار جهان"
  },
  {
    "poem_id": 1853,
    "vorder": 105,
    "position": 0,
    "text": "بدو گفت خسرو که از ترسگار"
  },
  {
    "poem_id": 1853,
    "vorder": 106,
    "position": 1,
    "text": "نیاید سخن گفت نابکار"
  },
  {
    "poem_id": 1853,
    "vorder": 107,
    "position": 0,
    "text": "ز تو نیز هرگز ندیدم بدی"
  },
  {
    "poem_id": 1853,
    "vorder": 108,
    "position": 1,
    "text": "نیازی به کژی و نابخردی"
  },
  {
    "poem_id": 1853,
    "vorder": 109,
    "position": 0,
    "text": "ولیکن ز کار سپهر بلند"
  },
  {
    "poem_id": 1853,
    "vorder": 110,
    "position": 1,
    "text": "نباشد شگفت ار شوی پر گزند"
  },
  {
    "poem_id": 1853,
    "vorder": 111,
    "position": 0,
    "text": "چو بایسته کاری بود ایزدی"
  },
  {
    "poem_id": 1853,
    "vorder": 112,
    "position": 1,
    "text": "بیکسو شود دانش و بخردی"
  },
  {
    "poem_id": 1853,
    "vorder": 113,
    "position": 0,
    "text": "به راهب چنین گفت پس شهریار"
  },
  {
    "poem_id": 1853,
    "vorder": 114,
    "position": 1,
    "text": "که شاداب دل باش و به روزگار"
  },
  {
    "poem_id": 1853,
    "vorder": 115,
    "position": 0,
    "text": "وزان دیر چون برق رخشان زمیغ"
  },
  {
    "poem_id": 1853,
    "vorder": 116,
    "position": 1,
    "text": "بیامد سوی شارستان و ریغ"
  },
  {
    "poem_id": 1853,
    "vorder": 117,
    "position": 0,
    "text": "پذیره شدندش بزرگان شهر"
  },
  {
    "poem_id": 1853,
    "vorder": 118,
    "position": 1,
    "text": "کسی را که از مردمی بود بهر"
  }
]