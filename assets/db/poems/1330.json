[
  {
    "poem_id": 1330,
    "vorder": 1,
    "position": 0,
    "text": "دلِ روشنِ من چو برگشت از اوی"
  },
  {
    "poem_id": 1330,
    "vorder": 2,
    "position": 1,
    "text": "سوی تختِ شاهِ جهان کَرد روی"
  },
  {
    "poem_id": 1330,
    "vorder": 3,
    "position": 0,
    "text": "که این نامه را دَستِ پیش آوَرَم"
  },
  {
    "poem_id": 1330,
    "vorder": 4,
    "position": 1,
    "text": "زِ دفتر به گفتارِ خویش آوَرَم"
  },
  {
    "poem_id": 1330,
    "vorder": 5,
    "position": 0,
    "text": "بِپُرسیدَم از هر کسی بی‌شُمار"
  },
  {
    "poem_id": 1330,
    "vorder": 6,
    "position": 1,
    "text": "بتَرسیدَم از گردشِ روزگار"
  },
  {
    "poem_id": 1330,
    "vorder": 7,
    "position": 0,
    "text": "مَگر خود دِرَنگم نباشَد بَسی"
  },
  {
    "poem_id": 1330,
    "vorder": 8,
    "position": 1,
    "text": "ببایَد سِپُردَن به دیگر کَسی"
  },
  {
    "poem_id": 1330,
    "vorder": 9,
    "position": 0,
    "text": "و دیگر که گَنجَم وَفادار نیست"
  },
  {
    "poem_id": 1330,
    "vorder": 10,
    "position": 1,
    "text": "همین رَنج را کَس خریدار نیست"
  },
  {
    "poem_id": 1330,
    "vorder": 11,
    "position": 0,
    "text": "بر این گونه یِک چَند بُگذاشتَم"
  },
  {
    "poem_id": 1330,
    "vorder": 12,
    "position": 1,
    "text": "سخن را نَهُفته هَمی داشتَم"
  },
  {
    "poem_id": 1330,
    "vorder": 13,
    "position": 0,
    "text": "سَراسَر زَمانه پُر از جَنگ بود"
  },
  {
    "poem_id": 1330,
    "vorder": 14,
    "position": 1,
    "text": "به جویندگان بَر جَهان تَنگ بود"
  },
  {
    "poem_id": 1330,
    "vorder": 15,
    "position": 0,
    "text": "زِ نیکو سُخن بِهْ چه اَندر جَهان"
  },
  {
    "poem_id": 1330,
    "vorder": 16,
    "position": 1,
    "text": "به نَزدِ سُخن سَنجِ فَرُّخ مَهان"
  },
  {
    "poem_id": 1330,
    "vorder": 17,
    "position": 0,
    "text": "اگر نامَدی این سخن از خُدای"
  },
  {
    "poem_id": 1330,
    "vorder": 18,
    "position": 1,
    "text": "نَبی کِی بُدی نَزدِ ما رَهنُمای"
  },
  {
    "poem_id": 1330,
    "vorder": 19,
    "position": 0,
    "text": "به شَهرَم یکی مِهربان دوست بود"
  },
  {
    "poem_id": 1330,
    "vorder": 20,
    "position": 1,
    "text": "تو گفتی که با مَن به یِک پوست بود"
  },
  {
    "poem_id": 1330,
    "vorder": 21,
    "position": 0,
    "text": "مَرا گُفت خوب آمَد این رای تو"
  },
  {
    "poem_id": 1330,
    "vorder": 22,
    "position": 1,
    "text": "به نیکی گِراید هَمی پای تو"
  },
  {
    "poem_id": 1330,
    "vorder": 23,
    "position": 0,
    "text": "نِبِشته من این نامهٔ پَهلَوی"
  },
  {
    "poem_id": 1330,
    "vorder": 24,
    "position": 1,
    "text": "به پیشِ تو آرَم مَگَر نَغنَوی"
  },
  {
    "poem_id": 1330,
    "vorder": 25,
    "position": 0,
    "text": "گشاده زَبان و جوانیت هَست"
  },
  {
    "poem_id": 1330,
    "vorder": 26,
    "position": 1,
    "text": "سخن گفتنِ پَهلوانیت هَست"
  },
  {
    "poem_id": 1330,
    "vorder": 27,
    "position": 0,
    "text": "شو این نامهٔ خسروان باز گوی"
  },
  {
    "poem_id": 1330,
    "vorder": 28,
    "position": 1,
    "text": "بدین جوی نَزدِ مَهان آبروی"
  },
  {
    "poem_id": 1330,
    "vorder": 29,
    "position": 0,
    "text": "چو آوَرد این نامه نَزدیکِ مَن"
  },
  {
    "poem_id": 1330,
    "vorder": 30,
    "position": 1,
    "text": "بَر اَفروخت این جانِ تاریکِ مَن"
  }
]