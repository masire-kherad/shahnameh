[
  {
    "poem_id": 1655,
    "vorder": 1,
    "position": 0,
    "text": "چو آن نامه برخواند فور سترگ"
  },
  {
    "poem_id": 1655,
    "vorder": 2,
    "position": 1,
    "text": "برآشفت زان نامدار بزرگ"
  },
  {
    "poem_id": 1655,
    "vorder": 3,
    "position": 0,
    "text": "هم‌آنگه یکی تند پاسخ نوشت"
  },
  {
    "poem_id": 1655,
    "vorder": 4,
    "position": 1,
    "text": "به پالیز کینه درختی بکشت"
  },
  {
    "poem_id": 1655,
    "vorder": 5,
    "position": 0,
    "text": "سر نامه گفت از خداوند پاک"
  },
  {
    "poem_id": 1655,
    "vorder": 6,
    "position": 1,
    "text": "بباید که باشیم با ترس و باک"
  },
  {
    "poem_id": 1655,
    "vorder": 7,
    "position": 0,
    "text": "نگوییم چندین سخن بر گزاف"
  },
  {
    "poem_id": 1655,
    "vorder": 8,
    "position": 1,
    "text": "که بیچاره باشد خداوند لاف"
  },
  {
    "poem_id": 1655,
    "vorder": 9,
    "position": 0,
    "text": "مرا پیش خوانی ترا شرم نیست"
  },
  {
    "poem_id": 1655,
    "vorder": 10,
    "position": 1,
    "text": "خرد را بر مغزت آزرم نیست"
  },
  {
    "poem_id": 1655,
    "vorder": 11,
    "position": 0,
    "text": "اگر فیلقوس این نوشتی به فور"
  },
  {
    "poem_id": 1655,
    "vorder": 12,
    "position": 1,
    "text": "تو نیز آن هم آغاز و بردار شور"
  },
  {
    "poem_id": 1655,
    "vorder": 13,
    "position": 0,
    "text": "ز دارا بدین سان شده‌ستی دلیر"
  },
  {
    "poem_id": 1655,
    "vorder": 14,
    "position": 1,
    "text": "کزو گشته بُد چرخ گردنده سیر"
  },
  {
    "poem_id": 1655,
    "vorder": 15,
    "position": 0,
    "text": "چو بر تخمه‌ای بگذرد روزگار"
  },
  {
    "poem_id": 1655,
    "vorder": 16,
    "position": 1,
    "text": "نسازند با پند آموزگار"
  },
  {
    "poem_id": 1655,
    "vorder": 17,
    "position": 0,
    "text": "همان نیز بزم آمدت رزم کید"
  },
  {
    "poem_id": 1655,
    "vorder": 18,
    "position": 1,
    "text": "بر آنی که شاهانت گشتند صید"
  },
  {
    "poem_id": 1655,
    "vorder": 19,
    "position": 0,
    "text": "برین‌گونه عنوان برین سان سخن"
  },
  {
    "poem_id": 1655,
    "vorder": 20,
    "position": 1,
    "text": "نیامد به‌ما زان کیان کهن"
  },
  {
    "poem_id": 1655,
    "vorder": 21,
    "position": 0,
    "text": "منم فور وز فور دارم نژاد"
  },
  {
    "poem_id": 1655,
    "vorder": 22,
    "position": 1,
    "text": "که از قیصران کس نکردیم یاد"
  },
  {
    "poem_id": 1655,
    "vorder": 23,
    "position": 0,
    "text": "بدانگه که دار مرا یار خواست"
  },
  {
    "poem_id": 1655,
    "vorder": 24,
    "position": 1,
    "text": "دل و بخت با او ندیدیم راست"
  },
  {
    "poem_id": 1655,
    "vorder": 25,
    "position": 0,
    "text": "همی ژنده‌پیلان فرستادمش"
  },
  {
    "poem_id": 1655,
    "vorder": 26,
    "position": 1,
    "text": "همیدون به بازی زمان دادمش"
  },
  {
    "poem_id": 1655,
    "vorder": 27,
    "position": 0,
    "text": "که بر دست آن بنده‌بر کشته شد"
  },
  {
    "poem_id": 1655,
    "vorder": 28,
    "position": 1,
    "text": "سر بخت ایرانیان گشته شد"
  },
  {
    "poem_id": 1655,
    "vorder": 29,
    "position": 0,
    "text": "گر او را ز دستور بد بد رسید"
  },
  {
    "poem_id": 1655,
    "vorder": 30,
    "position": 1,
    "text": "چرا شد خرد در سرت ناپدید"
  },
  {
    "poem_id": 1655,
    "vorder": 31,
    "position": 0,
    "text": "تو در جنگ چندین دلیری مکن"
  },
  {
    "poem_id": 1655,
    "vorder": 32,
    "position": 1,
    "text": "که با مات کوتاه باشد سخن"
  },
  {
    "poem_id": 1655,
    "vorder": 33,
    "position": 0,
    "text": "ببینی کنون ژنده پیل و سپاه"
  },
  {
    "poem_id": 1655,
    "vorder": 34,
    "position": 1,
    "text": "که پیشت ببندند بر باد راه"
  },
  {
    "poem_id": 1655,
    "vorder": 35,
    "position": 0,
    "text": "همی رای تو برترین گشتن است"
  },
  {
    "poem_id": 1655,
    "vorder": 36,
    "position": 1,
    "text": "نهان تو چون رنگ آهرمن است"
  },
  {
    "poem_id": 1655,
    "vorder": 37,
    "position": 0,
    "text": "به گیتی همه تخم زفتی مکار"
  },
  {
    "poem_id": 1655,
    "vorder": 38,
    "position": 1,
    "text": "بترس از گزند و بد روزگار"
  },
  {
    "poem_id": 1655,
    "vorder": 39,
    "position": 0,
    "text": "بدین نامه ما نیکویی خواستیم"
  },
  {
    "poem_id": 1655,
    "vorder": 40,
    "position": 1,
    "text": "منقش دلت را بیاراستیم"
  }
]