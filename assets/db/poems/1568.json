[
  {
    "poem_id": 1568,
    "vorder": 1,
    "position": 0,
    "text": "وز انجا بیامد به پرده‌سرای"
  },
  {
    "poem_id": 1568,
    "vorder": 2,
    "position": 1,
    "text": "ز بیگانه پردخت کردند جای"
  },
  {
    "poem_id": 1568,
    "vorder": 3,
    "position": 0,
    "text": "پشوتن بشد نزد اسفندیار"
  },
  {
    "poem_id": 1568,
    "vorder": 4,
    "position": 1,
    "text": "سخن رفت هرگونه از کارزار"
  },
  {
    "poem_id": 1568,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت جنگی چنین دژ به جنگ"
  },
  {
    "poem_id": 1568,
    "vorder": 6,
    "position": 1,
    "text": "به سال فراوان نیاید به چنگ"
  },
  {
    "poem_id": 1568,
    "vorder": 7,
    "position": 0,
    "text": "مگر خوار گیرم تن خویش را"
  },
  {
    "poem_id": 1568,
    "vorder": 8,
    "position": 1,
    "text": "یکی چاره سازم بداندیش را"
  },
  {
    "poem_id": 1568,
    "vorder": 9,
    "position": 0,
    "text": "توایدر شب و روز بیدار باش"
  },
  {
    "poem_id": 1568,
    "vorder": 10,
    "position": 1,
    "text": "سپه را ز دشمن نگهدار باش"
  },
  {
    "poem_id": 1568,
    "vorder": 11,
    "position": 0,
    "text": "تن آنگه شود بی‌گمان ارجمند"
  },
  {
    "poem_id": 1568,
    "vorder": 12,
    "position": 1,
    "text": "سزاوار شاهی و تخت بلند"
  },
  {
    "poem_id": 1568,
    "vorder": 13,
    "position": 0,
    "text": "کز انبوه دشمن نترسد به جنگ"
  },
  {
    "poem_id": 1568,
    "vorder": 14,
    "position": 1,
    "text": "به کوه از پلنگ و به آب از نهنگ"
  },
  {
    "poem_id": 1568,
    "vorder": 15,
    "position": 0,
    "text": "به جایی فریب و به جایی نهیب"
  },
  {
    "poem_id": 1568,
    "vorder": 16,
    "position": 1,
    "text": "گهی فر و زیب و گهی در نشیب"
  },
  {
    "poem_id": 1568,
    "vorder": 17,
    "position": 0,
    "text": "چو بازارگانی بدین دژ شوم"
  },
  {
    "poem_id": 1568,
    "vorder": 18,
    "position": 1,
    "text": "نگویم که شیر جهان پهلوم"
  },
  {
    "poem_id": 1568,
    "vorder": 19,
    "position": 0,
    "text": "فراز آورم چاره از هر دری"
  },
  {
    "poem_id": 1568,
    "vorder": 20,
    "position": 1,
    "text": "بخوانم ز هر دانشی دفتری"
  },
  {
    "poem_id": 1568,
    "vorder": 21,
    "position": 0,
    "text": "تو بی‌دیده‌بان و طلایه مباش"
  },
  {
    "poem_id": 1568,
    "vorder": 22,
    "position": 1,
    "text": "ز هر دانشی سست مایه مباش"
  },
  {
    "poem_id": 1568,
    "vorder": 23,
    "position": 0,
    "text": "اگر دیده‌بان دود بیند به روز"
  },
  {
    "poem_id": 1568,
    "vorder": 24,
    "position": 1,
    "text": "شب آتش چو خورشید گیتی فروز"
  },
  {
    "poem_id": 1568,
    "vorder": 25,
    "position": 0,
    "text": "چنین دان که آن کار کرد منست"
  },
  {
    "poem_id": 1568,
    "vorder": 26,
    "position": 1,
    "text": "نه از چارهٔ هم نبرد منست"
  },
  {
    "poem_id": 1568,
    "vorder": 27,
    "position": 0,
    "text": "سپه را بیارای و ز ایدر بران"
  },
  {
    "poem_id": 1568,
    "vorder": 28,
    "position": 1,
    "text": "زره‌دار با خود و گرز گران"
  },
  {
    "poem_id": 1568,
    "vorder": 29,
    "position": 0,
    "text": "درفش من از دور بر پای کن"
  },
  {
    "poem_id": 1568,
    "vorder": 30,
    "position": 1,
    "text": "سپه را به قلب اندرون جای کن"
  },
  {
    "poem_id": 1568,
    "vorder": 31,
    "position": 0,
    "text": "بران تیز با گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1568,
    "vorder": 32,
    "position": 1,
    "text": "چنان کن که خوانندت اسفندیار"
  },
  {
    "poem_id": 1568,
    "vorder": 33,
    "position": 0,
    "text": "وزان جایگه ساربان را بخواند"
  },
  {
    "poem_id": 1568,
    "vorder": 34,
    "position": 1,
    "text": "به پیش پشوتن به زانو نشاند"
  },
  {
    "poem_id": 1568,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت صد بارکش سرخ‌موی"
  },
  {
    "poem_id": 1568,
    "vorder": 36,
    "position": 1,
    "text": "بیاور سرافراز با رنگ و بوی"
  },
  {
    "poem_id": 1568,
    "vorder": 37,
    "position": 0,
    "text": "ازو ده شتر بار دینار کن"
  },
  {
    "poem_id": 1568,
    "vorder": 38,
    "position": 1,
    "text": "دگر پنج دیبای چین بارکن"
  },
  {
    "poem_id": 1568,
    "vorder": 39,
    "position": 0,
    "text": "دگر پنج هرگونه‌ای گوهران"
  },
  {
    "poem_id": 1568,
    "vorder": 40,
    "position": 1,
    "text": "یکی تخت زرین و تاج سران"
  },
  {
    "poem_id": 1568,
    "vorder": 41,
    "position": 0,
    "text": "بیاورد صندوق هشتاد جفت"
  },
  {
    "poem_id": 1568,
    "vorder": 42,
    "position": 1,
    "text": "همه بند صندوقها در نهفت"
  },
  {
    "poem_id": 1568,
    "vorder": 43,
    "position": 0,
    "text": "صد و شست مرد از یلان برگزید"
  },
  {
    "poem_id": 1568,
    "vorder": 44,
    "position": 1,
    "text": "کزیشان نهانش نیاید پدید"
  },
  {
    "poem_id": 1568,
    "vorder": 45,
    "position": 0,
    "text": "تنی بیست از نامداران خویش"
  },
  {
    "poem_id": 1568,
    "vorder": 46,
    "position": 1,
    "text": "سرافراز و خنجرگزاران خویش"
  },
  {
    "poem_id": 1568,
    "vorder": 47,
    "position": 0,
    "text": "بفرمود تا بر سر کاروان"
  },
  {
    "poem_id": 1568,
    "vorder": 48,
    "position": 1,
    "text": "بوند آن گرانمایگان ساروان"
  },
  {
    "poem_id": 1568,
    "vorder": 49,
    "position": 0,
    "text": "به پای اندرون کفش و در تن گلیم"
  },
  {
    "poem_id": 1568,
    "vorder": 50,
    "position": 1,
    "text": "به بار اندرون گوهر و زر و سیم"
  },
  {
    "poem_id": 1568,
    "vorder": 51,
    "position": 0,
    "text": "سپهبد به دژ روی بنهاد تفت"
  },
  {
    "poem_id": 1568,
    "vorder": 52,
    "position": 1,
    "text": "به کردار بازارگانان برفت"
  },
  {
    "poem_id": 1568,
    "vorder": 53,
    "position": 0,
    "text": "همی راند با نامور کاروان"
  },
  {
    "poem_id": 1568,
    "vorder": 54,
    "position": 1,
    "text": "یلان سرافراز چون ساروان"
  },
  {
    "poem_id": 1568,
    "vorder": 55,
    "position": 0,
    "text": "چو نزدیک دژ شد برفت او ز پیش"
  },
  {
    "poem_id": 1568,
    "vorder": 56,
    "position": 1,
    "text": "بدید آن دل و رای هشیار خویش"
  },
  {
    "poem_id": 1568,
    "vorder": 57,
    "position": 0,
    "text": "چو بانگ درای آمد از کاروان"
  },
  {
    "poem_id": 1568,
    "vorder": 58,
    "position": 1,
    "text": "همی رفت پیش اندرون ساروان"
  },
  {
    "poem_id": 1568,
    "vorder": 59,
    "position": 0,
    "text": "به دژ نامدارن خبر یافتند"
  },
  {
    "poem_id": 1568,
    "vorder": 60,
    "position": 1,
    "text": "فراوان بگفتند و بشتافتند"
  },
  {
    "poem_id": 1568,
    "vorder": 61,
    "position": 0,
    "text": "که آمد یکی مرد بازارگان"
  },
  {
    "poem_id": 1568,
    "vorder": 62,
    "position": 1,
    "text": "درمگان فرو شد به دینارگان"
  },
  {
    "poem_id": 1568,
    "vorder": 63,
    "position": 0,
    "text": "بزرگان دژ پیش باز آمدند"
  },
  {
    "poem_id": 1568,
    "vorder": 64,
    "position": 1,
    "text": "خریدار و گردن‌فراز آمدند"
  },
  {
    "poem_id": 1568,
    "vorder": 65,
    "position": 0,
    "text": "بپرسید هریک ز سالار بار"
  },
  {
    "poem_id": 1568,
    "vorder": 66,
    "position": 1,
    "text": "کزین بارها چیست کاید به کار"
  },
  {
    "poem_id": 1568,
    "vorder": 67,
    "position": 0,
    "text": "چنین داد پاسخ که باری نخست"
  },
  {
    "poem_id": 1568,
    "vorder": 68,
    "position": 1,
    "text": "به تن شاه باید که بینم درست"
  },
  {
    "poem_id": 1568,
    "vorder": 69,
    "position": 0,
    "text": "توانایی خویش پیدا کنم"
  },
  {
    "poem_id": 1568,
    "vorder": 70,
    "position": 1,
    "text": "چو فرمان دهد دیده دریا کنم"
  },
  {
    "poem_id": 1568,
    "vorder": 71,
    "position": 0,
    "text": "شتربار بنهاد و خود رفت پیش"
  },
  {
    "poem_id": 1568,
    "vorder": 72,
    "position": 1,
    "text": "که تا چون کند تیز بازار خویش"
  },
  {
    "poem_id": 1568,
    "vorder": 73,
    "position": 0,
    "text": "یکی طاس پر گوهر شاهوار"
  },
  {
    "poem_id": 1568,
    "vorder": 74,
    "position": 1,
    "text": "ز دینار چندی ز بهر نثار"
  },
  {
    "poem_id": 1568,
    "vorder": 75,
    "position": 0,
    "text": "که بر تافتش ساعد و آستین"
  },
  {
    "poem_id": 1568,
    "vorder": 76,
    "position": 1,
    "text": "یکی اسپ و دو جامه دیبای چین"
  },
  {
    "poem_id": 1568,
    "vorder": 77,
    "position": 0,
    "text": "بران طاس پوشیده‌تایی حریر"
  },
  {
    "poem_id": 1568,
    "vorder": 78,
    "position": 1,
    "text": "حریر از بر و زیر مشک و عبیر"
  },
  {
    "poem_id": 1568,
    "vorder": 79,
    "position": 0,
    "text": "به نزدیک ارجاسپ شد چاره‌جوی"
  },
  {
    "poem_id": 1568,
    "vorder": 80,
    "position": 1,
    "text": "به دیبا بیاراسته رنگ و بوی"
  },
  {
    "poem_id": 1568,
    "vorder": 81,
    "position": 0,
    "text": "چو دیدش فرو ریخت دینار و گفت"
  },
  {
    "poem_id": 1568,
    "vorder": 82,
    "position": 1,
    "text": "که با شهریاران خرد باد جفت"
  },
  {
    "poem_id": 1568,
    "vorder": 83,
    "position": 0,
    "text": "یکی مردم ای شاه بازارگان"
  },
  {
    "poem_id": 1568,
    "vorder": 84,
    "position": 1,
    "text": "پدر ترک و مادر ز آزادگان"
  },
  {
    "poem_id": 1568,
    "vorder": 85,
    "position": 0,
    "text": "ز توران به خرم به ایران برم"
  },
  {
    "poem_id": 1568,
    "vorder": 86,
    "position": 1,
    "text": "وگر سوی دشت دلیران برم"
  },
  {
    "poem_id": 1568,
    "vorder": 87,
    "position": 0,
    "text": "یکی کاروانی شتر با منست"
  },
  {
    "poem_id": 1568,
    "vorder": 88,
    "position": 1,
    "text": "ز پوشیدنی جامه‌های نشست"
  },
  {
    "poem_id": 1568,
    "vorder": 89,
    "position": 0,
    "text": "هم از گوهر و افسر و رنگ و بوی"
  },
  {
    "poem_id": 1568,
    "vorder": 90,
    "position": 1,
    "text": "فروشنده‌ام هم خریدار جوی"
  },
  {
    "poem_id": 1568,
    "vorder": 91,
    "position": 0,
    "text": "به بیرون دژ کاله بگذاشتم"
  },
  {
    "poem_id": 1568,
    "vorder": 92,
    "position": 1,
    "text": "جهان در پناه تو پنداشتم"
  },
  {
    "poem_id": 1568,
    "vorder": 93,
    "position": 0,
    "text": "اگر شاه بیند که این کاروان"
  },
  {
    "poem_id": 1568,
    "vorder": 94,
    "position": 1,
    "text": "به دروازهٔ دژ کشد ساروان"
  },
  {
    "poem_id": 1568,
    "vorder": 95,
    "position": 0,
    "text": "به بخت تو از هر بد ایمن شوم"
  },
  {
    "poem_id": 1568,
    "vorder": 96,
    "position": 1,
    "text": "بدین سایهٔ مهر تو بغنوم"
  },
  {
    "poem_id": 1568,
    "vorder": 97,
    "position": 0,
    "text": "چنین داد پاسخ که دل شاددار"
  },
  {
    "poem_id": 1568,
    "vorder": 98,
    "position": 1,
    "text": "ز هر بد تن خویش آزاد دار"
  },
  {
    "poem_id": 1568,
    "vorder": 99,
    "position": 0,
    "text": "نیازاردت کس به توران زمین"
  },
  {
    "poem_id": 1568,
    "vorder": 100,
    "position": 1,
    "text": "همان گر گرایی به ماچین و چین"
  },
  {
    "poem_id": 1568,
    "vorder": 101,
    "position": 0,
    "text": "بفرمود پس تا سرای فراخ"
  },
  {
    "poem_id": 1568,
    "vorder": 102,
    "position": 1,
    "text": "به دژ بر یکی کلبه در پیش کاخ"
  },
  {
    "poem_id": 1568,
    "vorder": 103,
    "position": 0,
    "text": "به رویین دژاندر مر او را دهند"
  },
  {
    "poem_id": 1568,
    "vorder": 104,
    "position": 1,
    "text": "همه بارش از دشت بر سر نهند"
  },
  {
    "poem_id": 1568,
    "vorder": 105,
    "position": 0,
    "text": "بسازد بران کلبه بازارگاه"
  },
  {
    "poem_id": 1568,
    "vorder": 106,
    "position": 1,
    "text": "همی داردش ایمن اندر پناه"
  },
  {
    "poem_id": 1568,
    "vorder": 107,
    "position": 0,
    "text": "برفتند و صندوقها را به پشت"
  },
  {
    "poem_id": 1568,
    "vorder": 108,
    "position": 1,
    "text": "کشیدند و ماهار اشتر به مشت"
  },
  {
    "poem_id": 1568,
    "vorder": 109,
    "position": 0,
    "text": "یکی مرد بخرد بپرسید و گفت"
  },
  {
    "poem_id": 1568,
    "vorder": 110,
    "position": 1,
    "text": "که صندوق را چیست اندر نهفت"
  },
  {
    "poem_id": 1568,
    "vorder": 111,
    "position": 0,
    "text": "کشنده بدو گفت ما هوش خویش"
  },
  {
    "poem_id": 1568,
    "vorder": 112,
    "position": 1,
    "text": "نهادیم ناچار بر دوش خویش"
  },
  {
    "poem_id": 1568,
    "vorder": 113,
    "position": 0,
    "text": "یکی کلبه برساخت اسفندیار"
  },
  {
    "poem_id": 1568,
    "vorder": 114,
    "position": 1,
    "text": "بیاراست همچون گل اندر بهار"
  },
  {
    "poem_id": 1568,
    "vorder": 115,
    "position": 0,
    "text": "ز هر سو فراوان خریدار خاست"
  },
  {
    "poem_id": 1568,
    "vorder": 116,
    "position": 1,
    "text": "بران کلبه بر تیز بازار خاست"
  },
  {
    "poem_id": 1568,
    "vorder": 117,
    "position": 0,
    "text": "ببود آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1568,
    "vorder": 118,
    "position": 1,
    "text": "ز ایوان دوان شد به نزدیک شاه"
  },
  {
    "poem_id": 1568,
    "vorder": 119,
    "position": 0,
    "text": "ز دینار وز مشک و دیبا سه تخت"
  },
  {
    "poem_id": 1568,
    "vorder": 120,
    "position": 1,
    "text": "همی برد پیش اندرون نیکبخت"
  },
  {
    "poem_id": 1568,
    "vorder": 121,
    "position": 0,
    "text": "بیامد ببوسید روی زمین"
  },
  {
    "poem_id": 1568,
    "vorder": 122,
    "position": 1,
    "text": "بر ارجاسپ چندی بکرد آفرین"
  },
  {
    "poem_id": 1568,
    "vorder": 123,
    "position": 0,
    "text": "چنین گفت کاین مایه‌ور کاروان"
  },
  {
    "poem_id": 1568,
    "vorder": 124,
    "position": 1,
    "text": "همی راندم تیز با ساروان"
  },
  {
    "poem_id": 1568,
    "vorder": 125,
    "position": 0,
    "text": "بدو اندرون یاره و افسرست"
  },
  {
    "poem_id": 1568,
    "vorder": 126,
    "position": 1,
    "text": "که شاه سرافراز را در خورست"
  },
  {
    "poem_id": 1568,
    "vorder": 127,
    "position": 0,
    "text": "بگوید به گنجور تا خواسته"
  },
  {
    "poem_id": 1568,
    "vorder": 128,
    "position": 1,
    "text": "ببیند همه کلبه آراسته"
  },
  {
    "poem_id": 1568,
    "vorder": 129,
    "position": 0,
    "text": "اگر هیچ شایسته بیند به گنج"
  },
  {
    "poem_id": 1568,
    "vorder": 130,
    "position": 1,
    "text": "بیارد همانا ندارد به رنج"
  },
  {
    "poem_id": 1568,
    "vorder": 131,
    "position": 0,
    "text": "پذیرفتن از شهریار زمین"
  },
  {
    "poem_id": 1568,
    "vorder": 132,
    "position": 1,
    "text": "ز بازارگان پوزش و آفرین"
  },
  {
    "poem_id": 1568,
    "vorder": 133,
    "position": 0,
    "text": "بخندید ارجاسپ و بنواختش"
  },
  {
    "poem_id": 1568,
    "vorder": 134,
    "position": 1,
    "text": "گرانمایه‌تر پایگه ساختش"
  },
  {
    "poem_id": 1568,
    "vorder": 135,
    "position": 0,
    "text": "چه نامی بدو گفت خراد نام"
  },
  {
    "poem_id": 1568,
    "vorder": 136,
    "position": 1,
    "text": "جهانجوی با رادی و شادکام"
  },
  {
    "poem_id": 1568,
    "vorder": 137,
    "position": 0,
    "text": "به خراد گفت ای رد زاد مرد"
  },
  {
    "poem_id": 1568,
    "vorder": 138,
    "position": 1,
    "text": "به رنجی همی گرد پوزش مگرد"
  },
  {
    "poem_id": 1568,
    "vorder": 139,
    "position": 0,
    "text": "ز دربان نباید ترا بار خواست"
  },
  {
    "poem_id": 1568,
    "vorder": 140,
    "position": 1,
    "text": "به نزد من آی آنگهی کت هواست"
  },
  {
    "poem_id": 1568,
    "vorder": 141,
    "position": 0,
    "text": "ازان پس بپرسیدش از رنج راه"
  },
  {
    "poem_id": 1568,
    "vorder": 142,
    "position": 1,
    "text": "ز ایران و توران و کار سپاه"
  },
  {
    "poem_id": 1568,
    "vorder": 143,
    "position": 0,
    "text": "چنین داد پاسخ که من ماه پنج"
  },
  {
    "poem_id": 1568,
    "vorder": 144,
    "position": 1,
    "text": "کشیدم به راه اندرون درد و رنج"
  },
  {
    "poem_id": 1568,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت از کار اسفندیار"
  },
  {
    "poem_id": 1568,
    "vorder": 146,
    "position": 1,
    "text": "به ایران خبر بود وز گرگسار"
  },
  {
    "poem_id": 1568,
    "vorder": 147,
    "position": 0,
    "text": "چنین داد پاسخ که ای نیک‌خوی"
  },
  {
    "poem_id": 1568,
    "vorder": 148,
    "position": 1,
    "text": "سخن راند زین هر کسی بارزوی"
  },
  {
    "poem_id": 1568,
    "vorder": 149,
    "position": 0,
    "text": "یکی گفت کاسفندیار از پدر"
  },
  {
    "poem_id": 1568,
    "vorder": 150,
    "position": 1,
    "text": "پرآزار گشت و بپیچید سر"
  },
  {
    "poem_id": 1568,
    "vorder": 151,
    "position": 0,
    "text": "دگر گفت کو از دژ گنبدان"
  },
  {
    "poem_id": 1568,
    "vorder": 152,
    "position": 1,
    "text": "سپه برد و شد بر ره هفتخوان"
  },
  {
    "poem_id": 1568,
    "vorder": 153,
    "position": 0,
    "text": "که رزم آزماید به توران زمین"
  },
  {
    "poem_id": 1568,
    "vorder": 154,
    "position": 1,
    "text": "بخواهد به مردی ز ارجاسپ کین"
  },
  {
    "poem_id": 1568,
    "vorder": 155,
    "position": 0,
    "text": "بخندید ارجاسپ گفت این سخن"
  },
  {
    "poem_id": 1568,
    "vorder": 156,
    "position": 1,
    "text": "نگوید جهاندیده مرد کهن"
  },
  {
    "poem_id": 1568,
    "vorder": 157,
    "position": 0,
    "text": "اگر کرگس آید سوی هفتخوان"
  },
  {
    "poem_id": 1568,
    "vorder": 158,
    "position": 1,
    "text": "مرا اهرمن خوان و مردم مخوان"
  },
  {
    "poem_id": 1568,
    "vorder": 159,
    "position": 0,
    "text": "چو بشنید جنگی زمین بوسه داد"
  },
  {
    "poem_id": 1568,
    "vorder": 160,
    "position": 1,
    "text": "بیامد ز ایوان ارجاسپ شاد"
  },
  {
    "poem_id": 1568,
    "vorder": 161,
    "position": 0,
    "text": "در کلبه را نامور باز کرد"
  },
  {
    "poem_id": 1568,
    "vorder": 162,
    "position": 1,
    "text": "ز بازارگان دژ پرآواز کرد"
  },
  {
    "poem_id": 1568,
    "vorder": 163,
    "position": 0,
    "text": "همی بود چندی خرید و فروخت"
  },
  {
    "poem_id": 1568,
    "vorder": 164,
    "position": 1,
    "text": "همی هرکسی چشم خود را بدوخت"
  },
  {
    "poem_id": 1568,
    "vorder": 165,
    "position": 0,
    "text": "ز دینارگان یک درم بستدی"
  },
  {
    "poem_id": 1568,
    "vorder": 166,
    "position": 1,
    "text": "همی این بران آن برین برزدی"
  }
]