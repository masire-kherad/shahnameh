[
  {
    "poem_id": 1388,
    "vorder": 1,
    "position": 0,
    "text": "چو برخاست از خواب با موبدان"
  },
  {
    "poem_id": 1388,
    "vorder": 2,
    "position": 1,
    "text": "یکی انجمن کرد با بخردان"
  },
  {
    "poem_id": 1388,
    "vorder": 3,
    "position": 0,
    "text": "گشاد آن سخن بر ستاره شمر"
  },
  {
    "poem_id": 1388,
    "vorder": 4,
    "position": 1,
    "text": "که فرجام این بر چه باشد گذر"
  },
  {
    "poem_id": 1388,
    "vorder": 5,
    "position": 0,
    "text": "دو گوهر چو آب و چو آتش به هم"
  },
  {
    "poem_id": 1388,
    "vorder": 6,
    "position": 1,
    "text": "برآمیخته باشد از بن ستم"
  },
  {
    "poem_id": 1388,
    "vorder": 7,
    "position": 0,
    "text": "همانا که باشد به روز شمار"
  },
  {
    "poem_id": 1388,
    "vorder": 8,
    "position": 1,
    "text": "فریدون و ضحاک را کارزار"
  },
  {
    "poem_id": 1388,
    "vorder": 9,
    "position": 0,
    "text": "از اختر بجوئید و پاسخ دهید"
  },
  {
    "poem_id": 1388,
    "vorder": 10,
    "position": 1,
    "text": "همه کار و کردار فرخ نهید"
  },
  {
    "poem_id": 1388,
    "vorder": 11,
    "position": 0,
    "text": "ستاره‌شناسان به روز دراز"
  },
  {
    "poem_id": 1388,
    "vorder": 12,
    "position": 1,
    "text": "همی ز آسمان بازجستند راز"
  },
  {
    "poem_id": 1388,
    "vorder": 13,
    "position": 0,
    "text": "بدیدند و با خنده پیش آمدند"
  },
  {
    "poem_id": 1388,
    "vorder": 14,
    "position": 1,
    "text": "که دو دشمن از بخت خویش آمدند"
  },
  {
    "poem_id": 1388,
    "vorder": 15,
    "position": 0,
    "text": "به سام نریمان ستاره شمر"
  },
  {
    "poem_id": 1388,
    "vorder": 16,
    "position": 1,
    "text": "چنین گفت کای گرد زرین کمر"
  },
  {
    "poem_id": 1388,
    "vorder": 17,
    "position": 0,
    "text": "ترا مژده از دخت مهراب و زال"
  },
  {
    "poem_id": 1388,
    "vorder": 18,
    "position": 1,
    "text": "که باشند هر دو به شادی همال"
  },
  {
    "poem_id": 1388,
    "vorder": 19,
    "position": 0,
    "text": "ازین دو هنرمند پیلی ژیان"
  },
  {
    "poem_id": 1388,
    "vorder": 20,
    "position": 1,
    "text": "بیاید ببندد به مردی میان"
  },
  {
    "poem_id": 1388,
    "vorder": 21,
    "position": 0,
    "text": "جهان زیرپای اندر آرد به تیغ"
  },
  {
    "poem_id": 1388,
    "vorder": 22,
    "position": 1,
    "text": "نهد تخت شاه از بر پشت میغ"
  },
  {
    "poem_id": 1388,
    "vorder": 23,
    "position": 0,
    "text": "ببرد پی بدسگالان ز خاک"
  },
  {
    "poem_id": 1388,
    "vorder": 24,
    "position": 1,
    "text": "به روی زمین بر نماند مغاک"
  },
  {
    "poem_id": 1388,
    "vorder": 25,
    "position": 0,
    "text": "نه سگسار ماند نه مازندران"
  },
  {
    "poem_id": 1388,
    "vorder": 26,
    "position": 1,
    "text": "زمین را بشوید به گرز گران"
  },
  {
    "poem_id": 1388,
    "vorder": 27,
    "position": 0,
    "text": "به خواب اندرد آرد سر دردمند"
  },
  {
    "poem_id": 1388,
    "vorder": 28,
    "position": 1,
    "text": "ببندد در جنگ و راه گزند"
  },
  {
    "poem_id": 1388,
    "vorder": 29,
    "position": 0,
    "text": "بدو باشد ایرانیان را امید"
  },
  {
    "poem_id": 1388,
    "vorder": 30,
    "position": 1,
    "text": "ازو پهلوان را خرام و نوید"
  },
  {
    "poem_id": 1388,
    "vorder": 31,
    "position": 0,
    "text": "پی باره‌ای کو چماند به جنگ"
  },
  {
    "poem_id": 1388,
    "vorder": 32,
    "position": 1,
    "text": "بمالد برو روی جنگی پلنگ"
  },
  {
    "poem_id": 1388,
    "vorder": 33,
    "position": 0,
    "text": "خنک پادشاهی که هنگام او"
  },
  {
    "poem_id": 1388,
    "vorder": 34,
    "position": 1,
    "text": "زمانه به شاهی برد نام او"
  },
  {
    "poem_id": 1388,
    "vorder": 35,
    "position": 0,
    "text": "چو بشنید گفتار اخترشناس"
  },
  {
    "poem_id": 1388,
    "vorder": 36,
    "position": 1,
    "text": "بخندید و پذرفت ازیشان سپاس"
  },
  {
    "poem_id": 1388,
    "vorder": 37,
    "position": 0,
    "text": "ببخشیدشان بی‌کران زر و سیم"
  },
  {
    "poem_id": 1388,
    "vorder": 38,
    "position": 1,
    "text": "چو آرامش آمد به هنگام بیم"
  },
  {
    "poem_id": 1388,
    "vorder": 39,
    "position": 0,
    "text": "فرستادهٔ زال را پیش خواند"
  },
  {
    "poem_id": 1388,
    "vorder": 40,
    "position": 1,
    "text": "زهر گونه با او سخنها براند"
  },
  {
    "poem_id": 1388,
    "vorder": 41,
    "position": 0,
    "text": "بگفتش که با او به خوبی بگوی"
  },
  {
    "poem_id": 1388,
    "vorder": 42,
    "position": 1,
    "text": "که این آرزو را نبد هیچ روی"
  },
  {
    "poem_id": 1388,
    "vorder": 43,
    "position": 0,
    "text": "ولیکن چو پیمان چنین بد نخست"
  },
  {
    "poem_id": 1388,
    "vorder": 44,
    "position": 1,
    "text": "بهانه نشاید به بیداد جست"
  },
  {
    "poem_id": 1388,
    "vorder": 45,
    "position": 0,
    "text": "من اینک به شبگیر ازین رزمگاه"
  },
  {
    "poem_id": 1388,
    "vorder": 46,
    "position": 1,
    "text": "سوی شهر ایران گذارم سپاه"
  },
  {
    "poem_id": 1388,
    "vorder": 47,
    "position": 0,
    "text": "فرستاده را داد چندی درم"
  },
  {
    "poem_id": 1388,
    "vorder": 48,
    "position": 1,
    "text": "بدو گفت خیره مزن هیچ دم"
  },
  {
    "poem_id": 1388,
    "vorder": 49,
    "position": 0,
    "text": "گسی کردش و خود به راه ایستاد"
  },
  {
    "poem_id": 1388,
    "vorder": 50,
    "position": 1,
    "text": "سپاه و سپهبد از آن کار شاد"
  },
  {
    "poem_id": 1388,
    "vorder": 51,
    "position": 0,
    "text": "ببستند از آن گرگساران هزار"
  },
  {
    "poem_id": 1388,
    "vorder": 52,
    "position": 1,
    "text": "پیاده به زاری کشیدند خوار"
  },
  {
    "poem_id": 1388,
    "vorder": 53,
    "position": 0,
    "text": "دو بهره چو از تیره شب درگذشت"
  },
  {
    "poem_id": 1388,
    "vorder": 54,
    "position": 1,
    "text": "خروش سواران برآمد ز دشت"
  },
  {
    "poem_id": 1388,
    "vorder": 55,
    "position": 0,
    "text": "همان نالهٔ کوس با کره نای"
  },
  {
    "poem_id": 1388,
    "vorder": 56,
    "position": 1,
    "text": "برآمد ز دهلیز پرده‌سرای"
  },
  {
    "poem_id": 1388,
    "vorder": 57,
    "position": 0,
    "text": "سپهبد سوی شهر ایران کشید"
  },
  {
    "poem_id": 1388,
    "vorder": 58,
    "position": 1,
    "text": "سپه را به نزد دلیران کشید"
  },
  {
    "poem_id": 1388,
    "vorder": 59,
    "position": 0,
    "text": "فرستاده آمد دوان سوی زال"
  },
  {
    "poem_id": 1388,
    "vorder": 60,
    "position": 1,
    "text": "ابا بخت پیروز و فرخنده فال"
  },
  {
    "poem_id": 1388,
    "vorder": 61,
    "position": 0,
    "text": "گرفت آفرین زال بر کردگار"
  },
  {
    "poem_id": 1388,
    "vorder": 62,
    "position": 1,
    "text": "بران بخشش گردش روزگار"
  },
  {
    "poem_id": 1388,
    "vorder": 63,
    "position": 0,
    "text": "درم داد و دینار درویش را"
  },
  {
    "poem_id": 1388,
    "vorder": 64,
    "position": 1,
    "text": "نوازنده شد مردم خویش را"
  }
]