[
  {
    "poem_id": 1487,
    "vorder": 1,
    "position": 0,
    "text": "هیونی بیاراست کاووس شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 2,
    "position": 1,
    "text": "بفرمود تا بازگردد به راه"
  },
  {
    "poem_id": 1487,
    "vorder": 3,
    "position": 0,
    "text": "نویسندهٔ نامه را پیش خواند"
  },
  {
    "poem_id": 1487,
    "vorder": 4,
    "position": 1,
    "text": "به کرسی زر پیکرش برنشاند"
  },
  {
    "poem_id": 1487,
    "vorder": 5,
    "position": 0,
    "text": "یکی نامه فرمود پر خشم و جنگ"
  },
  {
    "poem_id": 1487,
    "vorder": 6,
    "position": 1,
    "text": "زبان تیز و رخساره چون بادرنگ"
  },
  {
    "poem_id": 1487,
    "vorder": 7,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1487,
    "vorder": 8,
    "position": 1,
    "text": "خداوند آرامش و کارزار"
  },
  {
    "poem_id": 1487,
    "vorder": 9,
    "position": 0,
    "text": "خداوند بهرام و کیوان و ماه"
  },
  {
    "poem_id": 1487,
    "vorder": 10,
    "position": 1,
    "text": "خداوند نیک و بد و فر و جاه"
  },
  {
    "poem_id": 1487,
    "vorder": 11,
    "position": 0,
    "text": "بفرمان اویست گردان سپهر"
  },
  {
    "poem_id": 1487,
    "vorder": 12,
    "position": 1,
    "text": "ازو بازگسترده هرجای مهر"
  },
  {
    "poem_id": 1487,
    "vorder": 13,
    "position": 0,
    "text": "ترا ای جوان تندرستی و بخت"
  },
  {
    "poem_id": 1487,
    "vorder": 14,
    "position": 1,
    "text": "همیشه بماناد با تاج و تخت"
  },
  {
    "poem_id": 1487,
    "vorder": 15,
    "position": 0,
    "text": "اگر بر دلت رای من تیره گشت"
  },
  {
    "poem_id": 1487,
    "vorder": 16,
    "position": 1,
    "text": "ز خواب جوانی سرت خیره گشت"
  },
  {
    "poem_id": 1487,
    "vorder": 17,
    "position": 0,
    "text": "شنیدی که دشمن به ایران چه کرد"
  },
  {
    "poem_id": 1487,
    "vorder": 18,
    "position": 1,
    "text": "چو پیروز شد روزگار نبرد"
  },
  {
    "poem_id": 1487,
    "vorder": 19,
    "position": 0,
    "text": "کنون خیره آزرم دشمن مجوی"
  },
  {
    "poem_id": 1487,
    "vorder": 20,
    "position": 1,
    "text": "برین بارگه بر مبر آبروی"
  },
  {
    "poem_id": 1487,
    "vorder": 21,
    "position": 0,
    "text": "منه با جوانی سر اندر فریب"
  },
  {
    "poem_id": 1487,
    "vorder": 22,
    "position": 1,
    "text": "گر از چرخ‌گردان نخواهی نهیب"
  },
  {
    "poem_id": 1487,
    "vorder": 23,
    "position": 0,
    "text": "که من زان فریبنده گفتار او"
  },
  {
    "poem_id": 1487,
    "vorder": 24,
    "position": 1,
    "text": "بسی بازگشتم ز پیکار او"
  },
  {
    "poem_id": 1487,
    "vorder": 25,
    "position": 0,
    "text": "ترا گر فریبد نباشد شگفت"
  },
  {
    "poem_id": 1487,
    "vorder": 26,
    "position": 1,
    "text": "مرا از خود اندازه باید گرفت"
  },
  {
    "poem_id": 1487,
    "vorder": 27,
    "position": 0,
    "text": "نرفت ایچ با من سخن ز آشتی"
  },
  {
    "poem_id": 1487,
    "vorder": 28,
    "position": 1,
    "text": "ز فرمان من روی برگاشتی"
  },
  {
    "poem_id": 1487,
    "vorder": 29,
    "position": 0,
    "text": "همان رستم از گنج آراسته"
  },
  {
    "poem_id": 1487,
    "vorder": 30,
    "position": 1,
    "text": "نخواهد شدن سیر از خواسته"
  },
  {
    "poem_id": 1487,
    "vorder": 31,
    "position": 0,
    "text": "ازان مردری تاج شاهنشهی"
  },
  {
    "poem_id": 1487,
    "vorder": 32,
    "position": 1,
    "text": "ترا شد سر از جنگ جستن تهی"
  },
  {
    "poem_id": 1487,
    "vorder": 33,
    "position": 0,
    "text": "در بی‌نیازی به شمشیر جوی"
  },
  {
    "poem_id": 1487,
    "vorder": 34,
    "position": 1,
    "text": "به کشور بود شاه را آبروی"
  },
  {
    "poem_id": 1487,
    "vorder": 35,
    "position": 0,
    "text": "چو طوس سپهبد رسد پیش تو"
  },
  {
    "poem_id": 1487,
    "vorder": 36,
    "position": 1,
    "text": "بسازد چو باید کم و بیش تو"
  },
  {
    "poem_id": 1487,
    "vorder": 37,
    "position": 0,
    "text": "گروگان که داری به بند گران"
  },
  {
    "poem_id": 1487,
    "vorder": 38,
    "position": 1,
    "text": "هم اندر زمان بارکن بر خران"
  },
  {
    "poem_id": 1487,
    "vorder": 39,
    "position": 0,
    "text": "پرستار وز خواسته هرچ هست"
  },
  {
    "poem_id": 1487,
    "vorder": 40,
    "position": 1,
    "text": "به زودی مر آن را به درگه فرست"
  },
  {
    "poem_id": 1487,
    "vorder": 41,
    "position": 0,
    "text": "تو شوکین و آویختن را بساز"
  },
  {
    "poem_id": 1487,
    "vorder": 42,
    "position": 1,
    "text": "ازین در سخن‌ها مگردان دراز"
  },
  {
    "poem_id": 1487,
    "vorder": 43,
    "position": 0,
    "text": "چو تو ساز جنگ شبیخون کنی"
  },
  {
    "poem_id": 1487,
    "vorder": 44,
    "position": 1,
    "text": "ز خاک سیه رود جیحون کنی"
  },
  {
    "poem_id": 1487,
    "vorder": 45,
    "position": 0,
    "text": "سپهبد سراندر نیارد به خواب"
  },
  {
    "poem_id": 1487,
    "vorder": 46,
    "position": 1,
    "text": "بیاید به جنگ تو افراسیاب"
  },
  {
    "poem_id": 1487,
    "vorder": 47,
    "position": 0,
    "text": "و گر مهر داری بران اهرمن"
  },
  {
    "poem_id": 1487,
    "vorder": 48,
    "position": 1,
    "text": "نخواهی که خواندت پیمان شکن"
  },
  {
    "poem_id": 1487,
    "vorder": 49,
    "position": 0,
    "text": "سپه طوس رد را ده و بازگرد"
  },
  {
    "poem_id": 1487,
    "vorder": 50,
    "position": 1,
    "text": "نه‌ای مرد پرخاش روز نبرد"
  },
  {
    "poem_id": 1487,
    "vorder": 51,
    "position": 0,
    "text": "تو با خوبرویان برآمیختی"
  },
  {
    "poem_id": 1487,
    "vorder": 52,
    "position": 1,
    "text": "به بزم اندر از رزم بگریختی"
  },
  {
    "poem_id": 1487,
    "vorder": 53,
    "position": 0,
    "text": "نهادند بر نامه بر مهر شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 54,
    "position": 1,
    "text": "هیون پر برآورد و ببرید راه"
  },
  {
    "poem_id": 1487,
    "vorder": 55,
    "position": 0,
    "text": "چو نامه به نزد سیاوش رسید"
  },
  {
    "poem_id": 1487,
    "vorder": 56,
    "position": 1,
    "text": "بران گونه گفتار ناخوب دید"
  },
  {
    "poem_id": 1487,
    "vorder": 57,
    "position": 0,
    "text": "فرستاده را خواند و پرسید چست"
  },
  {
    "poem_id": 1487,
    "vorder": 58,
    "position": 1,
    "text": "ازو کرد یکسر سخنها درست"
  },
  {
    "poem_id": 1487,
    "vorder": 59,
    "position": 0,
    "text": "بگفت آنک با پیلتن رفته بود"
  },
  {
    "poem_id": 1487,
    "vorder": 60,
    "position": 1,
    "text": "ز طوس و ز کاووس کاشفته بود"
  },
  {
    "poem_id": 1487,
    "vorder": 61,
    "position": 0,
    "text": "سیاوش چو بشنید گفتار اوی"
  },
  {
    "poem_id": 1487,
    "vorder": 62,
    "position": 1,
    "text": "ز رستم غمی گشت و برتافت روی"
  },
  {
    "poem_id": 1487,
    "vorder": 63,
    "position": 0,
    "text": "ز کار پدر دل پراندیشه کرد"
  },
  {
    "poem_id": 1487,
    "vorder": 64,
    "position": 1,
    "text": "ز ترکان و از روزگار نبرد"
  },
  {
    "poem_id": 1487,
    "vorder": 65,
    "position": 0,
    "text": "همی گفت صد مرد ترک و سوار"
  },
  {
    "poem_id": 1487,
    "vorder": 66,
    "position": 1,
    "text": "ز خویشان شاهی چنین نامدار"
  },
  {
    "poem_id": 1487,
    "vorder": 67,
    "position": 0,
    "text": "همه نیک خواه و همه بی‌گناه"
  },
  {
    "poem_id": 1487,
    "vorder": 68,
    "position": 1,
    "text": "اگرشان فرستم به نزدیک شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 69,
    "position": 0,
    "text": "نپرسد نه اندیشد از کارشان"
  },
  {
    "poem_id": 1487,
    "vorder": 70,
    "position": 1,
    "text": "همانگه کند زنده بر دارشان"
  },
  {
    "poem_id": 1487,
    "vorder": 71,
    "position": 0,
    "text": "به نزدیک یزدان چه پوزش برم"
  },
  {
    "poem_id": 1487,
    "vorder": 72,
    "position": 1,
    "text": "بد آید ز کار پدر بر سرم"
  },
  {
    "poem_id": 1487,
    "vorder": 73,
    "position": 0,
    "text": "ور ایدونک جنگ آورم بی‌گناه"
  },
  {
    "poem_id": 1487,
    "vorder": 74,
    "position": 1,
    "text": "چنان خیره با شاه توران سپاه"
  },
  {
    "poem_id": 1487,
    "vorder": 75,
    "position": 0,
    "text": "جهاندار نپسندد این بد ز من"
  },
  {
    "poem_id": 1487,
    "vorder": 76,
    "position": 1,
    "text": "گشایند بر من زبان انجمن"
  },
  {
    "poem_id": 1487,
    "vorder": 77,
    "position": 0,
    "text": "وگر بازگردم به نزدیک شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 78,
    "position": 1,
    "text": "به طوس سپهبد سپارم سپاه"
  },
  {
    "poem_id": 1487,
    "vorder": 79,
    "position": 0,
    "text": "ازو نیز هم بر تنم بد رسد"
  },
  {
    "poem_id": 1487,
    "vorder": 80,
    "position": 1,
    "text": "چپ و راست بد بینم و پیش بد"
  },
  {
    "poem_id": 1487,
    "vorder": 81,
    "position": 0,
    "text": "نیاید ز سودابه خود جز بدی"
  },
  {
    "poem_id": 1487,
    "vorder": 82,
    "position": 1,
    "text": "ندانم چه خواهد رسید ایزدی"
  },
  {
    "poem_id": 1487,
    "vorder": 83,
    "position": 0,
    "text": "دو تن را ز لشکر ز کندآوران"
  },
  {
    "poem_id": 1487,
    "vorder": 84,
    "position": 1,
    "text": "چو بهرام و چون زنگهٔ شاوران"
  },
  {
    "poem_id": 1487,
    "vorder": 85,
    "position": 0,
    "text": "بران رازشان خواند نزدیک خویش"
  },
  {
    "poem_id": 1487,
    "vorder": 86,
    "position": 1,
    "text": "بپرداخت ایوان و بنشاند پیش"
  },
  {
    "poem_id": 1487,
    "vorder": 87,
    "position": 0,
    "text": "که رازش به هم بود با هر دو تن"
  },
  {
    "poem_id": 1487,
    "vorder": 88,
    "position": 1,
    "text": "ازان پس که رستم شد از انجمن"
  },
  {
    "poem_id": 1487,
    "vorder": 89,
    "position": 0,
    "text": "بدیشان چنین گفت کز بخت بد"
  },
  {
    "poem_id": 1487,
    "vorder": 90,
    "position": 1,
    "text": "فراوان همی بر تنم بد رسد"
  },
  {
    "poem_id": 1487,
    "vorder": 91,
    "position": 0,
    "text": "بدان مهربانی دل شهریار"
  },
  {
    "poem_id": 1487,
    "vorder": 92,
    "position": 1,
    "text": "بسان درختی پر از برگ و بار"
  },
  {
    "poem_id": 1487,
    "vorder": 93,
    "position": 0,
    "text": "چو سودابه او را فریبنده گشت"
  },
  {
    "poem_id": 1487,
    "vorder": 94,
    "position": 1,
    "text": "تو گفتی که زهر گزاینده گشت"
  },
  {
    "poem_id": 1487,
    "vorder": 95,
    "position": 0,
    "text": "شبستان او گشت زندان من"
  },
  {
    "poem_id": 1487,
    "vorder": 96,
    "position": 1,
    "text": "غمی شد دل و بخت خندان من"
  },
  {
    "poem_id": 1487,
    "vorder": 97,
    "position": 0,
    "text": "چنین رفت بر سر مرا روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 98,
    "position": 1,
    "text": "که با مهر او آتش آورد بار"
  },
  {
    "poem_id": 1487,
    "vorder": 99,
    "position": 0,
    "text": "گزیدم بدان شوربختیم جنگ"
  },
  {
    "poem_id": 1487,
    "vorder": 100,
    "position": 1,
    "text": "مگر دور مانم ز چنگ نهنگ"
  },
  {
    "poem_id": 1487,
    "vorder": 101,
    "position": 0,
    "text": "به بلخ اندرون بود چندان سپاه"
  },
  {
    "poem_id": 1487,
    "vorder": 102,
    "position": 1,
    "text": "سپهبد چو گرسیوز کینه‌خواه"
  },
  {
    "poem_id": 1487,
    "vorder": 103,
    "position": 0,
    "text": "نشسته به سغد اندرون شهریار"
  },
  {
    "poem_id": 1487,
    "vorder": 104,
    "position": 1,
    "text": "پر از کینه با تیغ زن صدهزار"
  },
  {
    "poem_id": 1487,
    "vorder": 105,
    "position": 0,
    "text": "برفتیم بر سان باد دمان"
  },
  {
    "poem_id": 1487,
    "vorder": 106,
    "position": 1,
    "text": "نجستیم در جنگ ایشان زمان"
  },
  {
    "poem_id": 1487,
    "vorder": 107,
    "position": 0,
    "text": "چو کشور سراسر بپرداختند"
  },
  {
    "poem_id": 1487,
    "vorder": 108,
    "position": 1,
    "text": "گروگان و آن هدیه‌ها ساختند"
  },
  {
    "poem_id": 1487,
    "vorder": 109,
    "position": 0,
    "text": "همه موبدان آن نمودند راه"
  },
  {
    "poem_id": 1487,
    "vorder": 110,
    "position": 1,
    "text": "که ما بازگردیم زین رزم‌گاه"
  },
  {
    "poem_id": 1487,
    "vorder": 111,
    "position": 0,
    "text": "پسندش نیامد همی کار من"
  },
  {
    "poem_id": 1487,
    "vorder": 112,
    "position": 1,
    "text": "بکوشد به رنج و به آزار من"
  },
  {
    "poem_id": 1487,
    "vorder": 113,
    "position": 0,
    "text": "به خیره همی جنگ فرمایدم"
  },
  {
    "poem_id": 1487,
    "vorder": 114,
    "position": 1,
    "text": "بترسم که سوگند بگزایدم"
  },
  {
    "poem_id": 1487,
    "vorder": 115,
    "position": 0,
    "text": "وراگر ز بهر فزونیست جنگ"
  },
  {
    "poem_id": 1487,
    "vorder": 116,
    "position": 1,
    "text": "چو گنج آمد و کشور آمد به چنگ"
  },
  {
    "poem_id": 1487,
    "vorder": 117,
    "position": 0,
    "text": "چه باید همی خیره خون ریختن"
  },
  {
    "poem_id": 1487,
    "vorder": 118,
    "position": 1,
    "text": "چنین دل به کین اندر آویختن"
  },
  {
    "poem_id": 1487,
    "vorder": 119,
    "position": 0,
    "text": "همی سر ز یزدان نباید کشید"
  },
  {
    "poem_id": 1487,
    "vorder": 120,
    "position": 1,
    "text": "فراوان نکوهش بباید شنید"
  },
  {
    "poem_id": 1487,
    "vorder": 121,
    "position": 0,
    "text": "دو گیتی همی برد خواهد ز من"
  },
  {
    "poem_id": 1487,
    "vorder": 122,
    "position": 1,
    "text": "بمانم به کام دل اهرمن"
  },
  {
    "poem_id": 1487,
    "vorder": 123,
    "position": 0,
    "text": "نزادی مرا کاشکی مادرم"
  },
  {
    "poem_id": 1487,
    "vorder": 124,
    "position": 1,
    "text": "وگر زاد مرگ آمدی بر سرم"
  },
  {
    "poem_id": 1487,
    "vorder": 125,
    "position": 0,
    "text": "که چندین بلاها بباید کشید"
  },
  {
    "poem_id": 1487,
    "vorder": 126,
    "position": 1,
    "text": "ز گیتی همی زهر باید چشید"
  },
  {
    "poem_id": 1487,
    "vorder": 127,
    "position": 0,
    "text": "بدین گونه پیمان که من کرده‌ام"
  },
  {
    "poem_id": 1487,
    "vorder": 128,
    "position": 1,
    "text": "به یزدان و سوگندها خورده‌ام"
  },
  {
    "poem_id": 1487,
    "vorder": 129,
    "position": 0,
    "text": "اگر سر بگردانم از راستی"
  },
  {
    "poem_id": 1487,
    "vorder": 130,
    "position": 1,
    "text": "فراز آید از هر سوی کاستی"
  },
  {
    "poem_id": 1487,
    "vorder": 131,
    "position": 0,
    "text": "پراگنده شد در جهان این سخن"
  },
  {
    "poem_id": 1487,
    "vorder": 132,
    "position": 1,
    "text": "که با شاه ترکان فگندیم بن"
  },
  {
    "poem_id": 1487,
    "vorder": 133,
    "position": 0,
    "text": "زبان برگشایند هر کس به بد"
  },
  {
    "poem_id": 1487,
    "vorder": 134,
    "position": 1,
    "text": "به هرجای بر من چنان چون سزد"
  },
  {
    "poem_id": 1487,
    "vorder": 135,
    "position": 0,
    "text": "به کین بازگشتن بریدن ز دین"
  },
  {
    "poem_id": 1487,
    "vorder": 136,
    "position": 1,
    "text": "کشیدن سر از آسمان و زمین"
  },
  {
    "poem_id": 1487,
    "vorder": 137,
    "position": 0,
    "text": "چنین کی پسندد ز من کردگار"
  },
  {
    "poem_id": 1487,
    "vorder": 138,
    "position": 1,
    "text": "کجا بر دهد گردش روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 139,
    "position": 0,
    "text": "شوم کشوری جویم اندر جهان"
  },
  {
    "poem_id": 1487,
    "vorder": 140,
    "position": 1,
    "text": "که نامم ز کاووس ماند نهان"
  },
  {
    "poem_id": 1487,
    "vorder": 141,
    "position": 0,
    "text": "که روشن زمانه بران سان بود"
  },
  {
    "poem_id": 1487,
    "vorder": 142,
    "position": 1,
    "text": "که فرمان دادار گیهان بود"
  },
  {
    "poem_id": 1487,
    "vorder": 143,
    "position": 0,
    "text": "سری کش نباشد ز مغز آگهی"
  },
  {
    "poem_id": 1487,
    "vorder": 144,
    "position": 1,
    "text": "نه از بتری باز داند بهی"
  },
  {
    "poem_id": 1487,
    "vorder": 145,
    "position": 0,
    "text": "قباد آمد و رفت و گیتی سپرد"
  },
  {
    "poem_id": 1487,
    "vorder": 146,
    "position": 1,
    "text": "ورا نیز هم رفته باید شمرد"
  },
  {
    "poem_id": 1487,
    "vorder": 147,
    "position": 0,
    "text": "تو ای نامور زنگه شاوران"
  },
  {
    "poem_id": 1487,
    "vorder": 148,
    "position": 1,
    "text": "بیارای تن را به رنج گران"
  },
  {
    "poem_id": 1487,
    "vorder": 149,
    "position": 0,
    "text": "برو تا به درگاه افرسیاب"
  },
  {
    "poem_id": 1487,
    "vorder": 150,
    "position": 1,
    "text": "درنگی مباش و منه سر به خواب"
  },
  {
    "poem_id": 1487,
    "vorder": 151,
    "position": 0,
    "text": "گروگان و این خواسته هرچ هست"
  },
  {
    "poem_id": 1487,
    "vorder": 152,
    "position": 1,
    "text": "ز دینار و ز تاج و تخت نشست"
  },
  {
    "poem_id": 1487,
    "vorder": 153,
    "position": 0,
    "text": "ببر همچنین جمله تا پیش اوی"
  },
  {
    "poem_id": 1487,
    "vorder": 154,
    "position": 1,
    "text": "بگویش که ما را چه آمد به روی"
  },
  {
    "poem_id": 1487,
    "vorder": 155,
    "position": 0,
    "text": "بفرمود بهرام گودرز را"
  },
  {
    "poem_id": 1487,
    "vorder": 156,
    "position": 1,
    "text": "که این نامور لشکر و مرز را"
  },
  {
    "poem_id": 1487,
    "vorder": 157,
    "position": 0,
    "text": "سپردم ترا گنج و پیلان کوس"
  },
  {
    "poem_id": 1487,
    "vorder": 158,
    "position": 1,
    "text": "بمان تا بیاید سپهدار طوس"
  },
  {
    "poem_id": 1487,
    "vorder": 159,
    "position": 0,
    "text": "بدو ده تو این لشکر و خواسته"
  },
  {
    "poem_id": 1487,
    "vorder": 160,
    "position": 1,
    "text": "همه کارها یکسر آراسته"
  },
  {
    "poem_id": 1487,
    "vorder": 161,
    "position": 0,
    "text": "یکایک برو بر شمر هرچ هست"
  },
  {
    "poem_id": 1487,
    "vorder": 162,
    "position": 1,
    "text": "ز گنج و ز تاج و ز تخت نشست"
  },
  {
    "poem_id": 1487,
    "vorder": 163,
    "position": 0,
    "text": "چو بهرام بشنید گفتار اوی"
  },
  {
    "poem_id": 1487,
    "vorder": 164,
    "position": 1,
    "text": "دلش گشت پیچان به تیمار اوی"
  },
  {
    "poem_id": 1487,
    "vorder": 165,
    "position": 0,
    "text": "ببارید خون زنگهٔ شاوران"
  },
  {
    "poem_id": 1487,
    "vorder": 166,
    "position": 1,
    "text": "بنفرید بر بوم هاماوران"
  },
  {
    "poem_id": 1487,
    "vorder": 167,
    "position": 0,
    "text": "پر از غم نشستند هر دو به هم"
  },
  {
    "poem_id": 1487,
    "vorder": 168,
    "position": 1,
    "text": "روانشان ز گفتار او شد دژم"
  },
  {
    "poem_id": 1487,
    "vorder": 169,
    "position": 0,
    "text": "بدو باز گفتند کاین رای نیست"
  },
  {
    "poem_id": 1487,
    "vorder": 170,
    "position": 1,
    "text": "ترا بی‌پدر در جهان جای نیست"
  },
  {
    "poem_id": 1487,
    "vorder": 171,
    "position": 0,
    "text": "یکی نامه بنویس نزدیک شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 172,
    "position": 1,
    "text": "دگر باره زو پیلتن را بخواه"
  },
  {
    "poem_id": 1487,
    "vorder": 173,
    "position": 0,
    "text": "اگر جنگ فرمان دهد جنگ ساز"
  },
  {
    "poem_id": 1487,
    "vorder": 174,
    "position": 1,
    "text": "مکن خیره اندیشهٔ دل دراز"
  },
  {
    "poem_id": 1487,
    "vorder": 175,
    "position": 0,
    "text": "مگردان به ما بر دژم روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 176,
    "position": 1,
    "text": "چو آمد درخت بزرگی به بار"
  },
  {
    "poem_id": 1487,
    "vorder": 177,
    "position": 0,
    "text": "نپذرفت زان دو خردمند پند"
  },
  {
    "poem_id": 1487,
    "vorder": 178,
    "position": 1,
    "text": "دگرگونه بد راز چرخ بلند"
  },
  {
    "poem_id": 1487,
    "vorder": 179,
    "position": 0,
    "text": "چنین داد پاسخ که فرمان شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 180,
    "position": 1,
    "text": "برانم که برتر ز خورشید و ماه"
  },
  {
    "poem_id": 1487,
    "vorder": 181,
    "position": 0,
    "text": "ولیکن به فرمان یزدان دلیر"
  },
  {
    "poem_id": 1487,
    "vorder": 182,
    "position": 1,
    "text": "نباشد ز خاشاک تا پیل و شیر"
  },
  {
    "poem_id": 1487,
    "vorder": 183,
    "position": 0,
    "text": "کسی کاو ز فرمان یزدان بتافت"
  },
  {
    "poem_id": 1487,
    "vorder": 184,
    "position": 1,
    "text": "سراسیمه شد خویشتن را نیافت"
  },
  {
    "poem_id": 1487,
    "vorder": 185,
    "position": 0,
    "text": "همی دست یازید باید به خون"
  },
  {
    "poem_id": 1487,
    "vorder": 186,
    "position": 1,
    "text": "به کین دو کشور بدن رهنمون"
  },
  {
    "poem_id": 1487,
    "vorder": 187,
    "position": 0,
    "text": "وزان پس که داند کزین کارزار"
  },
  {
    "poem_id": 1487,
    "vorder": 188,
    "position": 1,
    "text": "کرا برکشد گردش روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 189,
    "position": 0,
    "text": "ز بهر نوا هم بیازارد او"
  },
  {
    "poem_id": 1487,
    "vorder": 190,
    "position": 1,
    "text": "سخنهای گم کرده بازآرد او"
  },
  {
    "poem_id": 1487,
    "vorder": 191,
    "position": 0,
    "text": "همان خشم و پیگار بار آورد"
  },
  {
    "poem_id": 1487,
    "vorder": 192,
    "position": 1,
    "text": "سرشک غم اندر کنار آورد"
  },
  {
    "poem_id": 1487,
    "vorder": 193,
    "position": 0,
    "text": "اگر تیره‌تان شد دل از کار من"
  },
  {
    "poem_id": 1487,
    "vorder": 194,
    "position": 1,
    "text": "بپیچید سرتان ز گفتار من"
  },
  {
    "poem_id": 1487,
    "vorder": 195,
    "position": 0,
    "text": "فرستاده خود باشم و رهنمای"
  },
  {
    "poem_id": 1487,
    "vorder": 196,
    "position": 1,
    "text": "بمانم برین دشت پرده‌سرای"
  },
  {
    "poem_id": 1487,
    "vorder": 197,
    "position": 0,
    "text": "سیاوش چو پاسخ چنین داد باز"
  },
  {
    "poem_id": 1487,
    "vorder": 198,
    "position": 1,
    "text": "بپژمرد جان دو گردن فراز"
  },
  {
    "poem_id": 1487,
    "vorder": 199,
    "position": 0,
    "text": "ز بیم جداییش گریان شدند"
  },
  {
    "poem_id": 1487,
    "vorder": 200,
    "position": 1,
    "text": "چو بر آتش تیز بریان شدند"
  },
  {
    "poem_id": 1487,
    "vorder": 201,
    "position": 0,
    "text": "همی دید چشم بد روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 202,
    "position": 1,
    "text": "که اندر نهان چیست با شهریار"
  },
  {
    "poem_id": 1487,
    "vorder": 203,
    "position": 0,
    "text": "نخواهد بدن نیز دیدار او"
  },
  {
    "poem_id": 1487,
    "vorder": 204,
    "position": 1,
    "text": "ازان چشم گریان شد از کار او"
  },
  {
    "poem_id": 1487,
    "vorder": 205,
    "position": 0,
    "text": "چنین گفت زنگه که ما بنده‌ایم"
  },
  {
    "poem_id": 1487,
    "vorder": 206,
    "position": 1,
    "text": "به مهر سپهبد دل آگنده‌ایم"
  },
  {
    "poem_id": 1487,
    "vorder": 207,
    "position": 0,
    "text": "فدای تو بادا تن و جان ما"
  },
  {
    "poem_id": 1487,
    "vorder": 208,
    "position": 1,
    "text": "چنین باد تا مرگ پیمان ما"
  },
  {
    "poem_id": 1487,
    "vorder": 209,
    "position": 0,
    "text": "چو پاسخ چنین یافت از نیکخواه"
  },
  {
    "poem_id": 1487,
    "vorder": 210,
    "position": 1,
    "text": "چنین گفت با زنگه بیدار شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 211,
    "position": 0,
    "text": "که رو شاه توران سپه را بگوی"
  },
  {
    "poem_id": 1487,
    "vorder": 212,
    "position": 1,
    "text": "که زین کار ما را چه آمد بروی"
  },
  {
    "poem_id": 1487,
    "vorder": 213,
    "position": 0,
    "text": "ازین آشتی جنگ بهر منست"
  },
  {
    "poem_id": 1487,
    "vorder": 214,
    "position": 1,
    "text": "همه نوش تو درد و زهر منست"
  },
  {
    "poem_id": 1487,
    "vorder": 215,
    "position": 0,
    "text": "ز پیمان تو سر نگردد تهی"
  },
  {
    "poem_id": 1487,
    "vorder": 216,
    "position": 1,
    "text": "وگر دور مانم ز تخت مهی"
  },
  {
    "poem_id": 1487,
    "vorder": 217,
    "position": 0,
    "text": "جهاندار یزدان پناه منست"
  },
  {
    "poem_id": 1487,
    "vorder": 218,
    "position": 1,
    "text": "زمین تخت و گردون کلاه منست"
  },
  {
    "poem_id": 1487,
    "vorder": 219,
    "position": 0,
    "text": "و دیگر که بر خیره ناکرده کار"
  },
  {
    "poem_id": 1487,
    "vorder": 220,
    "position": 1,
    "text": "نشایست رفتن بر شهریار"
  },
  {
    "poem_id": 1487,
    "vorder": 221,
    "position": 0,
    "text": "یکی راه بگشای تا بگذرم"
  },
  {
    "poem_id": 1487,
    "vorder": 222,
    "position": 1,
    "text": "بجایی که کرد ایزد آبشخورم"
  },
  {
    "poem_id": 1487,
    "vorder": 223,
    "position": 0,
    "text": "یکی کشوری جویم اندر جهان"
  },
  {
    "poem_id": 1487,
    "vorder": 224,
    "position": 1,
    "text": "که نامم ز کاووس ماند نهان"
  },
  {
    "poem_id": 1487,
    "vorder": 225,
    "position": 0,
    "text": "ز خوی بد او سخن نشنوم"
  },
  {
    "poem_id": 1487,
    "vorder": 226,
    "position": 1,
    "text": "ز پیگار او یک زمان بغنوم"
  },
  {
    "poem_id": 1487,
    "vorder": 227,
    "position": 0,
    "text": "بشد زنگه با نامور صد سوار"
  },
  {
    "poem_id": 1487,
    "vorder": 228,
    "position": 1,
    "text": "گروگان ببرد از در شهریار"
  },
  {
    "poem_id": 1487,
    "vorder": 229,
    "position": 0,
    "text": "چو در شهر سالار ترکان رسید"
  },
  {
    "poem_id": 1487,
    "vorder": 230,
    "position": 1,
    "text": "خروش آمد و دیده‌بانش بدید"
  },
  {
    "poem_id": 1487,
    "vorder": 231,
    "position": 0,
    "text": "پذیره شدش نامداری بزرگ"
  },
  {
    "poem_id": 1487,
    "vorder": 232,
    "position": 1,
    "text": "کجا نام او بود جنگی طورگ"
  },
  {
    "poem_id": 1487,
    "vorder": 233,
    "position": 0,
    "text": "چو زنگه بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 234,
    "position": 1,
    "text": "سپهدار برخاست از پیشگاه"
  },
  {
    "poem_id": 1487,
    "vorder": 235,
    "position": 0,
    "text": "گرفتش به بر تنگ و بنواختش"
  },
  {
    "poem_id": 1487,
    "vorder": 236,
    "position": 1,
    "text": "گرامی بر خویش بنشاختش"
  },
  {
    "poem_id": 1487,
    "vorder": 237,
    "position": 0,
    "text": "چو بنشست با شاه پیغام داد"
  },
  {
    "poem_id": 1487,
    "vorder": 238,
    "position": 1,
    "text": "سراسر سخنها بدو کرد یاد"
  },
  {
    "poem_id": 1487,
    "vorder": 239,
    "position": 0,
    "text": "چو بشنید پیچان شد افراسیاب"
  },
  {
    "poem_id": 1487,
    "vorder": 240,
    "position": 1,
    "text": "دلش گشت پر درد و سر پر ز تاب"
  },
  {
    "poem_id": 1487,
    "vorder": 241,
    "position": 0,
    "text": "بفرمود تا جایگه ساختند"
  },
  {
    "poem_id": 1487,
    "vorder": 242,
    "position": 1,
    "text": "ورا چون سزا بود بنواختند"
  },
  {
    "poem_id": 1487,
    "vorder": 243,
    "position": 0,
    "text": "چو پیران بیامد تهی کرد جای"
  },
  {
    "poem_id": 1487,
    "vorder": 244,
    "position": 1,
    "text": "سخن رفت با نامور کدخدای"
  },
  {
    "poem_id": 1487,
    "vorder": 245,
    "position": 0,
    "text": "ز کاووس وز خام گفتار او"
  },
  {
    "poem_id": 1487,
    "vorder": 246,
    "position": 1,
    "text": "ز خوی بد و رای و پیگار او"
  },
  {
    "poem_id": 1487,
    "vorder": 247,
    "position": 0,
    "text": "همی گفت و رخساره کرده دژم"
  },
  {
    "poem_id": 1487,
    "vorder": 248,
    "position": 1,
    "text": "ز کار سیاووش دل پر ز غم"
  },
  {
    "poem_id": 1487,
    "vorder": 249,
    "position": 0,
    "text": "فرستادن زنگهٔ شاوران"
  },
  {
    "poem_id": 1487,
    "vorder": 250,
    "position": 1,
    "text": "همه یاد کرد از کران تا کران"
  },
  {
    "poem_id": 1487,
    "vorder": 251,
    "position": 0,
    "text": "بپرسید کاین را چه درمان کنیم"
  },
  {
    "poem_id": 1487,
    "vorder": 252,
    "position": 1,
    "text": "وزین چاره جستن چه پیمان کنیم"
  },
  {
    "poem_id": 1487,
    "vorder": 253,
    "position": 0,
    "text": "بدو گفت پیران که ای شهریار"
  },
  {
    "poem_id": 1487,
    "vorder": 254,
    "position": 1,
    "text": "انوشه بدی تا بود روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 255,
    "position": 0,
    "text": "تو از ما به هر کار داناتری"
  },
  {
    "poem_id": 1487,
    "vorder": 256,
    "position": 1,
    "text": "ببایستها بر تواناتری"
  },
  {
    "poem_id": 1487,
    "vorder": 257,
    "position": 0,
    "text": "گمان و دل و دانش و رای من"
  },
  {
    "poem_id": 1487,
    "vorder": 258,
    "position": 1,
    "text": "چنینست اندیشه بر جای من"
  },
  {
    "poem_id": 1487,
    "vorder": 259,
    "position": 0,
    "text": "که هر کس که بر نیکوی در جهان"
  },
  {
    "poem_id": 1487,
    "vorder": 260,
    "position": 1,
    "text": "توانا بود آشکار و نهان"
  },
  {
    "poem_id": 1487,
    "vorder": 261,
    "position": 0,
    "text": "ازین شاهزاده نگیرند باز"
  },
  {
    "poem_id": 1487,
    "vorder": 262,
    "position": 1,
    "text": "زگنج و ز رنج آنچ آید فراز"
  },
  {
    "poem_id": 1487,
    "vorder": 263,
    "position": 0,
    "text": "من ایدون شنیدم که اندر جهان"
  },
  {
    "poem_id": 1487,
    "vorder": 264,
    "position": 1,
    "text": "کسی نیست مانند او از مهان"
  },
  {
    "poem_id": 1487,
    "vorder": 265,
    "position": 0,
    "text": "به بالا و دیدار و آهستگی"
  },
  {
    "poem_id": 1487,
    "vorder": 266,
    "position": 1,
    "text": "به فرهنگ و رای و به شایستگی"
  },
  {
    "poem_id": 1487,
    "vorder": 267,
    "position": 0,
    "text": "هنر با خرد نیز بیش از نژاد"
  },
  {
    "poem_id": 1487,
    "vorder": 268,
    "position": 1,
    "text": "ز مادر چنو شاهزاده نزاد"
  },
  {
    "poem_id": 1487,
    "vorder": 269,
    "position": 0,
    "text": "بدیدن کنون از شنیدن بهست"
  },
  {
    "poem_id": 1487,
    "vorder": 270,
    "position": 1,
    "text": "گرانمایه و شاهزاد و مهست"
  },
  {
    "poem_id": 1487,
    "vorder": 271,
    "position": 0,
    "text": "وگر خود جز اینش نبودی هنر"
  },
  {
    "poem_id": 1487,
    "vorder": 272,
    "position": 1,
    "text": "که از خون صد نامور با پدر"
  },
  {
    "poem_id": 1487,
    "vorder": 273,
    "position": 0,
    "text": "برآشفت و بگذاشت تخت و کلاه"
  },
  {
    "poem_id": 1487,
    "vorder": 274,
    "position": 1,
    "text": "همی از تو جوید بدین گونه راه"
  },
  {
    "poem_id": 1487,
    "vorder": 275,
    "position": 0,
    "text": "نه نیکو نماید ز راه خرد"
  },
  {
    "poem_id": 1487,
    "vorder": 276,
    "position": 1,
    "text": "کزین کشور آن نامور بگذرد"
  },
  {
    "poem_id": 1487,
    "vorder": 277,
    "position": 0,
    "text": "ترا سرزنش باشد از مهتران"
  },
  {
    "poem_id": 1487,
    "vorder": 278,
    "position": 1,
    "text": "سر او همان از تو گردد گران"
  },
  {
    "poem_id": 1487,
    "vorder": 279,
    "position": 0,
    "text": "و دیگر که کاووس شد پیرسر"
  },
  {
    "poem_id": 1487,
    "vorder": 280,
    "position": 1,
    "text": "ز تخت آمدش روزگار گذر"
  },
  {
    "poem_id": 1487,
    "vorder": 281,
    "position": 0,
    "text": "سیاوش جوانست و با فرهی"
  },
  {
    "poem_id": 1487,
    "vorder": 282,
    "position": 1,
    "text": "بدو ماند آیین و تخت مهی"
  },
  {
    "poem_id": 1487,
    "vorder": 283,
    "position": 0,
    "text": "اگر شاه بیند به رای بلند"
  },
  {
    "poem_id": 1487,
    "vorder": 284,
    "position": 1,
    "text": "نویسد یکی نامهٔ سودمند"
  },
  {
    "poem_id": 1487,
    "vorder": 285,
    "position": 0,
    "text": "چنان چون نوازنده فرزند را"
  },
  {
    "poem_id": 1487,
    "vorder": 286,
    "position": 1,
    "text": "نوازد جوان خردمند را"
  },
  {
    "poem_id": 1487,
    "vorder": 287,
    "position": 0,
    "text": "یکی جای سازد بدین کشورش"
  },
  {
    "poem_id": 1487,
    "vorder": 288,
    "position": 1,
    "text": "بدارد سزاوار اندر خورش"
  },
  {
    "poem_id": 1487,
    "vorder": 289,
    "position": 0,
    "text": "بر آیین دهد دخترش را بدوی"
  },
  {
    "poem_id": 1487,
    "vorder": 290,
    "position": 1,
    "text": "بداردش با ناز و با آبروی"
  },
  {
    "poem_id": 1487,
    "vorder": 291,
    "position": 0,
    "text": "مگر کاو بماند به نزدیک شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 292,
    "position": 1,
    "text": "کند کشور و بومت آرامگاه"
  },
  {
    "poem_id": 1487,
    "vorder": 293,
    "position": 0,
    "text": "و گر باز گردد سوی شهریار"
  },
  {
    "poem_id": 1487,
    "vorder": 294,
    "position": 1,
    "text": "ترا بهتری باشد از روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 295,
    "position": 0,
    "text": "سپاسی بود نزد شاه زمین"
  },
  {
    "poem_id": 1487,
    "vorder": 296,
    "position": 1,
    "text": "بزرگان گیتی کنند آفرین"
  },
  {
    "poem_id": 1487,
    "vorder": 297,
    "position": 0,
    "text": "برآساید از کین دو کشور مگر"
  },
  {
    "poem_id": 1487,
    "vorder": 298,
    "position": 1,
    "text": "اگر آردش نزد ما دادگر"
  },
  {
    "poem_id": 1487,
    "vorder": 299,
    "position": 0,
    "text": "ز داد جهان آفرین این سزاست"
  },
  {
    "poem_id": 1487,
    "vorder": 300,
    "position": 1,
    "text": "که گردد زمانه بدین جنگ راست"
  },
  {
    "poem_id": 1487,
    "vorder": 301,
    "position": 0,
    "text": "چو سالار گفتار پیران شنید"
  },
  {
    "poem_id": 1487,
    "vorder": 302,
    "position": 1,
    "text": "چنان هم همه بودنیها بدید"
  },
  {
    "poem_id": 1487,
    "vorder": 303,
    "position": 0,
    "text": "پس اندیشه کرد اندر آن یک زمان"
  },
  {
    "poem_id": 1487,
    "vorder": 304,
    "position": 1,
    "text": "همی داشت بر نیک و بد بر گمان"
  },
  {
    "poem_id": 1487,
    "vorder": 305,
    "position": 0,
    "text": "چنین داد پاسخ به پیران پیر"
  },
  {
    "poem_id": 1487,
    "vorder": 306,
    "position": 1,
    "text": "که هست اینک گفتی همه دلپذیر"
  },
  {
    "poem_id": 1487,
    "vorder": 307,
    "position": 0,
    "text": "ولیکن شنیدم یکی داستان"
  },
  {
    "poem_id": 1487,
    "vorder": 308,
    "position": 1,
    "text": "که باشد بدین رای همداستان"
  },
  {
    "poem_id": 1487,
    "vorder": 309,
    "position": 0,
    "text": "که چون بچهٔ شیر نر پروری"
  },
  {
    "poem_id": 1487,
    "vorder": 310,
    "position": 1,
    "text": "چو دندان کند تیز کیفر بری"
  },
  {
    "poem_id": 1487,
    "vorder": 311,
    "position": 0,
    "text": "چو با زور و با چنگ برخیزد او"
  },
  {
    "poem_id": 1487,
    "vorder": 312,
    "position": 1,
    "text": "به پروردگار اندر آویزد او"
  },
  {
    "poem_id": 1487,
    "vorder": 313,
    "position": 0,
    "text": "بدو گفت پیران کاندر خرد"
  },
  {
    "poem_id": 1487,
    "vorder": 314,
    "position": 1,
    "text": "یکی شاه کندآوران بنگرد"
  },
  {
    "poem_id": 1487,
    "vorder": 315,
    "position": 0,
    "text": "کسی کز پدر کژی و خوی بد"
  },
  {
    "poem_id": 1487,
    "vorder": 316,
    "position": 1,
    "text": "نگیرد ازو بدخویی کی سزد"
  },
  {
    "poem_id": 1487,
    "vorder": 317,
    "position": 0,
    "text": "نبینی که کاووس دیرینه گشت"
  },
  {
    "poem_id": 1487,
    "vorder": 318,
    "position": 1,
    "text": "چو دیرینه گشت او بباید گذشت"
  },
  {
    "poem_id": 1487,
    "vorder": 319,
    "position": 0,
    "text": "سیاوش بگیرد جهان فراخ"
  },
  {
    "poem_id": 1487,
    "vorder": 320,
    "position": 1,
    "text": "بسی گنج بی‌رنج و ایوان و کاخ"
  },
  {
    "poem_id": 1487,
    "vorder": 321,
    "position": 0,
    "text": "دو کشور ترا باشد و تاج و تخت"
  },
  {
    "poem_id": 1487,
    "vorder": 322,
    "position": 1,
    "text": "چنین خود که یابد مگر نیک‌بخت"
  },
  {
    "poem_id": 1487,
    "vorder": 323,
    "position": 0,
    "text": "چو بشنید افراسیاب این سخن"
  },
  {
    "poem_id": 1487,
    "vorder": 324,
    "position": 1,
    "text": "یکی رای با دانش افگند بن"
  },
  {
    "poem_id": 1487,
    "vorder": 325,
    "position": 0,
    "text": "دبیر جهان‌دیده را پیش خواند"
  },
  {
    "poem_id": 1487,
    "vorder": 326,
    "position": 1,
    "text": "زبان برگشاد و سخن برفشاند"
  },
  {
    "poem_id": 1487,
    "vorder": 327,
    "position": 0,
    "text": "نخستین که بر خامه بنهاد دست"
  },
  {
    "poem_id": 1487,
    "vorder": 328,
    "position": 1,
    "text": "به عنبر سر خامه را کرد مست"
  },
  {
    "poem_id": 1487,
    "vorder": 329,
    "position": 0,
    "text": "جهان آفرین را ستایش گرفت"
  },
  {
    "poem_id": 1487,
    "vorder": 330,
    "position": 1,
    "text": "بزرگی و دانش نمایش گرفت"
  },
  {
    "poem_id": 1487,
    "vorder": 331,
    "position": 0,
    "text": "کجا برترست از مکان و زمان"
  },
  {
    "poem_id": 1487,
    "vorder": 332,
    "position": 1,
    "text": "بدو کی رسد بندگی را گمان"
  },
  {
    "poem_id": 1487,
    "vorder": 333,
    "position": 0,
    "text": "خداوند جانست و آن خرد"
  },
  {
    "poem_id": 1487,
    "vorder": 334,
    "position": 1,
    "text": "خردمند را داد او پرورد"
  },
  {
    "poem_id": 1487,
    "vorder": 335,
    "position": 0,
    "text": "ازو باد بر شاهزاده درود"
  },
  {
    "poem_id": 1487,
    "vorder": 336,
    "position": 1,
    "text": "خداوند گوپال و شمشیر و خود"
  },
  {
    "poem_id": 1487,
    "vorder": 337,
    "position": 0,
    "text": "خداوند شرم و خداوند باک"
  },
  {
    "poem_id": 1487,
    "vorder": 338,
    "position": 1,
    "text": "ز بیداد و کژی دل و دست پاک"
  },
  {
    "poem_id": 1487,
    "vorder": 339,
    "position": 0,
    "text": "شنیدم پیام از کران تا کران"
  },
  {
    "poem_id": 1487,
    "vorder": 340,
    "position": 1,
    "text": "ز بیدار دل زنگهٔ شاوران"
  },
  {
    "poem_id": 1487,
    "vorder": 341,
    "position": 0,
    "text": "غمی شد دلم زانک شاه جهان"
  },
  {
    "poem_id": 1487,
    "vorder": 342,
    "position": 1,
    "text": "چنین تیز شد با تو اندر نهان"
  },
  {
    "poem_id": 1487,
    "vorder": 343,
    "position": 0,
    "text": "ولیکن به گیتی به جز تاج و تخت"
  },
  {
    "poem_id": 1487,
    "vorder": 344,
    "position": 1,
    "text": "چه جوید خردمند بیدار بخت"
  },
  {
    "poem_id": 1487,
    "vorder": 345,
    "position": 0,
    "text": "ترا این همه ایدر آراستست"
  },
  {
    "poem_id": 1487,
    "vorder": 346,
    "position": 1,
    "text": "اگر شهریاری و گر خواستست"
  },
  {
    "poem_id": 1487,
    "vorder": 347,
    "position": 0,
    "text": "همه شهر توران برندت نماز"
  },
  {
    "poem_id": 1487,
    "vorder": 348,
    "position": 1,
    "text": "مرا خود به مهر تو باشد نیاز"
  },
  {
    "poem_id": 1487,
    "vorder": 349,
    "position": 0,
    "text": "تو فرزند باشی و من چون پدر"
  },
  {
    "poem_id": 1487,
    "vorder": 350,
    "position": 1,
    "text": "پدر پیش فرزند بسته کمر"
  },
  {
    "poem_id": 1487,
    "vorder": 351,
    "position": 0,
    "text": "چنان دان که کاووس بر تو به مهر"
  },
  {
    "poem_id": 1487,
    "vorder": 352,
    "position": 1,
    "text": "بران گونه یک روز نگشاد چهر"
  },
  {
    "poem_id": 1487,
    "vorder": 353,
    "position": 0,
    "text": "کجا من گشایم در گنج بست"
  },
  {
    "poem_id": 1487,
    "vorder": 354,
    "position": 1,
    "text": "سپارم به تو تاج و تخت نشست"
  },
  {
    "poem_id": 1487,
    "vorder": 355,
    "position": 0,
    "text": "بدارمت بی‌رنج فرزندوار"
  },
  {
    "poem_id": 1487,
    "vorder": 356,
    "position": 1,
    "text": "به گیتی تو مانی زمن یادگار"
  },
  {
    "poem_id": 1487,
    "vorder": 357,
    "position": 0,
    "text": "چو از کشورم بگذری در جهان"
  },
  {
    "poem_id": 1487,
    "vorder": 358,
    "position": 1,
    "text": "نکوهش کنندم کهان و مهان"
  },
  {
    "poem_id": 1487,
    "vorder": 359,
    "position": 0,
    "text": "وزین روی دشوار یابی گذر"
  },
  {
    "poem_id": 1487,
    "vorder": 360,
    "position": 1,
    "text": "مگر ایزدی باشد آیین و فر"
  },
  {
    "poem_id": 1487,
    "vorder": 361,
    "position": 0,
    "text": "بدین راه پیدا نبینی زمین"
  },
  {
    "poem_id": 1487,
    "vorder": 362,
    "position": 1,
    "text": "گذر کرد باید به دریای چین"
  },
  {
    "poem_id": 1487,
    "vorder": 363,
    "position": 0,
    "text": "ازین کرد یزدان ترا بی نیاز"
  },
  {
    "poem_id": 1487,
    "vorder": 364,
    "position": 1,
    "text": "هم ایدر بباش و به خوبی بناز"
  },
  {
    "poem_id": 1487,
    "vorder": 365,
    "position": 0,
    "text": "سپاه و در گنج و شهر آن تست"
  },
  {
    "poem_id": 1487,
    "vorder": 366,
    "position": 1,
    "text": "به رفتن بهانه نبایدت جست"
  },
  {
    "poem_id": 1487,
    "vorder": 367,
    "position": 0,
    "text": "چو رای آیدت آشتی با پدر"
  },
  {
    "poem_id": 1487,
    "vorder": 368,
    "position": 1,
    "text": "سپارم ترا تاج و زرین کمر"
  },
  {
    "poem_id": 1487,
    "vorder": 369,
    "position": 0,
    "text": "که ز ایدر به ایران شوی با سپاه"
  },
  {
    "poem_id": 1487,
    "vorder": 370,
    "position": 1,
    "text": "ببندم به دلسوزگی با تو راه"
  },
  {
    "poem_id": 1487,
    "vorder": 371,
    "position": 0,
    "text": "نماند ترا با پدر جنگ دیر"
  },
  {
    "poem_id": 1487,
    "vorder": 372,
    "position": 1,
    "text": "کهن شد سرش گردد از جنگ سیر"
  },
  {
    "poem_id": 1487,
    "vorder": 373,
    "position": 0,
    "text": "گر آتش ببیند پی شصت و پنج"
  },
  {
    "poem_id": 1487,
    "vorder": 374,
    "position": 1,
    "text": "رسد آتش از باد پیری به رنج"
  },
  {
    "poem_id": 1487,
    "vorder": 375,
    "position": 0,
    "text": "ترا باشد ایران و گنج و سپاه"
  },
  {
    "poem_id": 1487,
    "vorder": 376,
    "position": 1,
    "text": "ز کشور به کشور رساند کلاه"
  },
  {
    "poem_id": 1487,
    "vorder": 377,
    "position": 0,
    "text": "پذیرفتم از پاک یزدان که من"
  },
  {
    "poem_id": 1487,
    "vorder": 378,
    "position": 1,
    "text": "بکوشم به خوبی به جان و به تن"
  },
  {
    "poem_id": 1487,
    "vorder": 379,
    "position": 0,
    "text": "نفرمایم و خود نسازم به بد"
  },
  {
    "poem_id": 1487,
    "vorder": 380,
    "position": 1,
    "text": "به اندیشه دل را نیازم به بد"
  },
  {
    "poem_id": 1487,
    "vorder": 381,
    "position": 0,
    "text": "چو نامه به مهر اندر آورد شاه"
  },
  {
    "poem_id": 1487,
    "vorder": 382,
    "position": 1,
    "text": "بفرمود تا زنگهٔ نیک‌خواه"
  },
  {
    "poem_id": 1487,
    "vorder": 383,
    "position": 0,
    "text": "به زودی به رفتن ببندد کمر"
  },
  {
    "poem_id": 1487,
    "vorder": 384,
    "position": 1,
    "text": "یکی خلعت آراست با سیم و زر"
  },
  {
    "poem_id": 1487,
    "vorder": 385,
    "position": 0,
    "text": "یکی اسپ بر سر ستام گران"
  },
  {
    "poem_id": 1487,
    "vorder": 386,
    "position": 1,
    "text": "بیامد دمان زنگهٔ شاوران"
  },
  {
    "poem_id": 1487,
    "vorder": 387,
    "position": 0,
    "text": "چو نزدیک تخت سیاوش رسید"
  },
  {
    "poem_id": 1487,
    "vorder": 388,
    "position": 1,
    "text": "بگفت آنچ پرسید و بشنید و دید"
  },
  {
    "poem_id": 1487,
    "vorder": 389,
    "position": 0,
    "text": "سیاوش به یک روی زان شاد شد"
  },
  {
    "poem_id": 1487,
    "vorder": 390,
    "position": 1,
    "text": "به دیگر پر از درد و فریاد شد"
  },
  {
    "poem_id": 1487,
    "vorder": 391,
    "position": 0,
    "text": "که دشمن همی دوست بایست کرد"
  },
  {
    "poem_id": 1487,
    "vorder": 392,
    "position": 1,
    "text": "ز آتش کجا بردمد باد سرد"
  },
  {
    "poem_id": 1487,
    "vorder": 393,
    "position": 0,
    "text": "یکی نامه بنوشت نزد پدر"
  },
  {
    "poem_id": 1487,
    "vorder": 394,
    "position": 1,
    "text": "همه یاد کرد آنچ بد در به در"
  },
  {
    "poem_id": 1487,
    "vorder": 395,
    "position": 0,
    "text": "که من با جوانی خرد یافتم"
  },
  {
    "poem_id": 1487,
    "vorder": 396,
    "position": 1,
    "text": "بهر نیک و بد نیز بشتافتم"
  },
  {
    "poem_id": 1487,
    "vorder": 397,
    "position": 0,
    "text": "از آن زن یکی مغز شاه جهان"
  },
  {
    "poem_id": 1487,
    "vorder": 398,
    "position": 1,
    "text": "دل من برافروخت اندر نهان"
  },
  {
    "poem_id": 1487,
    "vorder": 399,
    "position": 0,
    "text": "شبستان او درد من شد نخست"
  },
  {
    "poem_id": 1487,
    "vorder": 400,
    "position": 1,
    "text": "ز خون دلم رخ ببایست شست"
  },
  {
    "poem_id": 1487,
    "vorder": 401,
    "position": 0,
    "text": "ببایست بر کوه آتش گذشت"
  },
  {
    "poem_id": 1487,
    "vorder": 402,
    "position": 1,
    "text": "مرا زار بگریست آهو به دشت"
  },
  {
    "poem_id": 1487,
    "vorder": 403,
    "position": 0,
    "text": "ازان ننگ و خواری به جنگ آمدم"
  },
  {
    "poem_id": 1487,
    "vorder": 404,
    "position": 1,
    "text": "خرامان به چنگ نهنگ آمدم"
  },
  {
    "poem_id": 1487,
    "vorder": 405,
    "position": 0,
    "text": "دو کشور بدین آشتی شاد گشت"
  },
  {
    "poem_id": 1487,
    "vorder": 406,
    "position": 1,
    "text": "دل شاه چون تیغ پولاد گشت"
  },
  {
    "poem_id": 1487,
    "vorder": 407,
    "position": 0,
    "text": "نیاید همی هیچ کارش پسند"
  },
  {
    "poem_id": 1487,
    "vorder": 408,
    "position": 1,
    "text": "گشادن همان و همان بود بند"
  },
  {
    "poem_id": 1487,
    "vorder": 409,
    "position": 0,
    "text": "چو چشمش ز دیدار من گشت سیر"
  },
  {
    "poem_id": 1487,
    "vorder": 410,
    "position": 1,
    "text": "بر سیر دیده نباشند دیر"
  },
  {
    "poem_id": 1487,
    "vorder": 411,
    "position": 0,
    "text": "ز شادی مبادا دل او رها"
  },
  {
    "poem_id": 1487,
    "vorder": 412,
    "position": 1,
    "text": "شدم من ز غم در دم اژدها"
  },
  {
    "poem_id": 1487,
    "vorder": 413,
    "position": 0,
    "text": "ندانم کزین کار بر من سپهر"
  },
  {
    "poem_id": 1487,
    "vorder": 414,
    "position": 1,
    "text": "چه دارد به راز اندر از کین و مهر"
  },
  {
    "poem_id": 1487,
    "vorder": 415,
    "position": 0,
    "text": "ازان پس بفرمود بهرام را"
  },
  {
    "poem_id": 1487,
    "vorder": 416,
    "position": 1,
    "text": "که اندر جهان تازه کن کام را"
  },
  {
    "poem_id": 1487,
    "vorder": 417,
    "position": 0,
    "text": "سپردم ترا تاج و پرده‌سرای"
  },
  {
    "poem_id": 1487,
    "vorder": 418,
    "position": 1,
    "text": "همان گنج آگنده و تخت و جای"
  },
  {
    "poem_id": 1487,
    "vorder": 419,
    "position": 0,
    "text": "درفش و سواران و پیلان کوس"
  },
  {
    "poem_id": 1487,
    "vorder": 420,
    "position": 1,
    "text": "چو ایدر بیاید سپهدار طوس"
  },
  {
    "poem_id": 1487,
    "vorder": 421,
    "position": 0,
    "text": "چنین هم پذیرفته او را سپار"
  },
  {
    "poem_id": 1487,
    "vorder": 422,
    "position": 1,
    "text": "تو بیدار دل باش و به روزگار"
  },
  {
    "poem_id": 1487,
    "vorder": 423,
    "position": 0,
    "text": "ز دیده ببارید خوناب زرد"
  },
  {
    "poem_id": 1487,
    "vorder": 424,
    "position": 1,
    "text": "لب رادمردان پر از باد سرد"
  },
  {
    "poem_id": 1487,
    "vorder": 425,
    "position": 0,
    "text": "ز لشکر گزین کرد سیصد سوار"
  },
  {
    "poem_id": 1487,
    "vorder": 426,
    "position": 1,
    "text": "همه گرد و شایستهٔ کارزار"
  },
  {
    "poem_id": 1487,
    "vorder": 427,
    "position": 0,
    "text": "صد اسپ گزیده به زرین ستام"
  },
  {
    "poem_id": 1487,
    "vorder": 428,
    "position": 1,
    "text": "پرستار و زرین کمر صد غلام"
  },
  {
    "poem_id": 1487,
    "vorder": 429,
    "position": 0,
    "text": "بفرمود تا پیش او آورند"
  },
  {
    "poem_id": 1487,
    "vorder": 430,
    "position": 1,
    "text": "سلیح و ستام و کمر بشمرند"
  },
  {
    "poem_id": 1487,
    "vorder": 431,
    "position": 0,
    "text": "درم نیز چندان که بودش به کار"
  },
  {
    "poem_id": 1487,
    "vorder": 432,
    "position": 1,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1487,
    "vorder": 433,
    "position": 0,
    "text": "ازان پس گرانمایگان را بخواند"
  },
  {
    "poem_id": 1487,
    "vorder": 434,
    "position": 1,
    "text": "سخنهای بایسته چندی براند"
  },
  {
    "poem_id": 1487,
    "vorder": 435,
    "position": 0,
    "text": "چنین گفت کز نزد افراسیاب"
  },
  {
    "poem_id": 1487,
    "vorder": 436,
    "position": 1,
    "text": "گذشتست پیران بدین روی آب"
  },
  {
    "poem_id": 1487,
    "vorder": 437,
    "position": 0,
    "text": "یکی راز پیغام دارد به من"
  },
  {
    "poem_id": 1487,
    "vorder": 438,
    "position": 1,
    "text": "که ایمن به دویست از انجمن"
  },
  {
    "poem_id": 1487,
    "vorder": 439,
    "position": 0,
    "text": "همی سازم اکنون پذیره شدن"
  },
  {
    "poem_id": 1487,
    "vorder": 440,
    "position": 1,
    "text": "شما را هم ایدر بباید بدن"
  },
  {
    "poem_id": 1487,
    "vorder": 441,
    "position": 0,
    "text": "همه سوی بهرام دارید روی"
  },
  {
    "poem_id": 1487,
    "vorder": 442,
    "position": 1,
    "text": "مپیچد دل را ز گفتار اوی"
  },
  {
    "poem_id": 1487,
    "vorder": 443,
    "position": 0,
    "text": "همی بوسه دادند گردان زمین"
  },
  {
    "poem_id": 1487,
    "vorder": 444,
    "position": 1,
    "text": "بران خوب سالار باآفرین"
  }
]