[
  {
    "poem_id": 1877,
    "vorder": 1,
    "position": 0,
    "text": "چو پیدا شد ازآسمان گرد ماه"
  },
  {
    "poem_id": 1877,
    "vorder": 2,
    "position": 1,
    "text": "شب تیره بفشاند گرد سیاه"
  },
  {
    "poem_id": 1877,
    "vorder": 3,
    "position": 0,
    "text": "پراکنده گشتند و مستان شدند"
  },
  {
    "poem_id": 1877,
    "vorder": 4,
    "position": 1,
    "text": "وز آنجای هرکس به ایوان شدند"
  },
  {
    "poem_id": 1877,
    "vorder": 5,
    "position": 0,
    "text": "چو پیداشد آن فرخورشید زرد"
  },
  {
    "poem_id": 1877,
    "vorder": 6,
    "position": 1,
    "text": "به پیچید زلف شب لاژورد"
  },
  {
    "poem_id": 1877,
    "vorder": 7,
    "position": 0,
    "text": "قژ آگند پوشید بهرام گرد"
  },
  {
    "poem_id": 1877,
    "vorder": 8,
    "position": 1,
    "text": "گرامی تنش را به یزدان سپرد"
  },
  {
    "poem_id": 1877,
    "vorder": 9,
    "position": 0,
    "text": "کمند و کمان برد و شش چوبه تیر"
  },
  {
    "poem_id": 1877,
    "vorder": 10,
    "position": 1,
    "text": "یکی نیزه دو شاخ نخچیرگیر"
  },
  {
    "poem_id": 1877,
    "vorder": 11,
    "position": 0,
    "text": "چوآمد به نزدیک آن برزکوه"
  },
  {
    "poem_id": 1877,
    "vorder": 12,
    "position": 1,
    "text": "بفرمود تا بازگردد گروه"
  },
  {
    "poem_id": 1877,
    "vorder": 13,
    "position": 0,
    "text": "بران شیر کپی چو نزدیک شد"
  },
  {
    "poem_id": 1877,
    "vorder": 14,
    "position": 1,
    "text": "تو گفتی برو کوه تاریک شد"
  },
  {
    "poem_id": 1877,
    "vorder": 15,
    "position": 0,
    "text": "میان اندارن کوه خارا ببست"
  },
  {
    "poem_id": 1877,
    "vorder": 16,
    "position": 1,
    "text": "بخم کمند از بر زین نشست"
  },
  {
    "poem_id": 1877,
    "vorder": 17,
    "position": 0,
    "text": "کمان را بمالید وبر زه نهاد"
  },
  {
    "poem_id": 1877,
    "vorder": 18,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد باد"
  },
  {
    "poem_id": 1877,
    "vorder": 19,
    "position": 0,
    "text": "چو بر اژدها برشدی موی‌تر"
  },
  {
    "poem_id": 1877,
    "vorder": 20,
    "position": 1,
    "text": "نبودی برو تیر کس کارگر"
  },
  {
    "poem_id": 1877,
    "vorder": 21,
    "position": 0,
    "text": "شد آن شیر کپی به چشمه درون"
  },
  {
    "poem_id": 1877,
    "vorder": 22,
    "position": 1,
    "text": "به غلتید و برخاست و آمد برون"
  },
  {
    "poem_id": 1877,
    "vorder": 23,
    "position": 0,
    "text": "بغرید و بر زد بران سنگ دست"
  },
  {
    "poem_id": 1877,
    "vorder": 24,
    "position": 1,
    "text": "همی آتش از کوه خارا بجست"
  },
  {
    "poem_id": 1877,
    "vorder": 25,
    "position": 0,
    "text": "کمان را بمالید بهرام گرد"
  },
  {
    "poem_id": 1877,
    "vorder": 26,
    "position": 1,
    "text": "به تیر از هوا روشنایی ببرد"
  },
  {
    "poem_id": 1877,
    "vorder": 27,
    "position": 0,
    "text": "خدنگی بینداخت شیر دلیر"
  },
  {
    "poem_id": 1877,
    "vorder": 28,
    "position": 1,
    "text": "برشیر کپی شد از جنگ سیر"
  },
  {
    "poem_id": 1877,
    "vorder": 29,
    "position": 0,
    "text": "دگر تیر بهرام زد بر سرش"
  },
  {
    "poem_id": 1877,
    "vorder": 30,
    "position": 1,
    "text": "فرو ریخت چون آب خون ازبرش"
  },
  {
    "poem_id": 1877,
    "vorder": 31,
    "position": 0,
    "text": "سیوم تیر و چارم بزد بر دهانش"
  },
  {
    "poem_id": 1877,
    "vorder": 32,
    "position": 1,
    "text": "که بردوخت برهم دهان و زبانش"
  },
  {
    "poem_id": 1877,
    "vorder": 33,
    "position": 0,
    "text": "به پنجم بزد تیر بر چنگ اوی"
  },
  {
    "poem_id": 1877,
    "vorder": 34,
    "position": 1,
    "text": "همی‌دید نیروی و آهنگ اوی"
  },
  {
    "poem_id": 1877,
    "vorder": 35,
    "position": 0,
    "text": "بهشتم میانش گشاد از کمند"
  },
  {
    "poem_id": 1877,
    "vorder": 36,
    "position": 1,
    "text": "بجست از بر کوهسار بلند"
  },
  {
    "poem_id": 1877,
    "vorder": 37,
    "position": 0,
    "text": "بزد نیزه‌ای بر میان دده"
  },
  {
    "poem_id": 1877,
    "vorder": 38,
    "position": 1,
    "text": "که شد سنگ خارا به خون آژده"
  },
  {
    "poem_id": 1877,
    "vorder": 39,
    "position": 0,
    "text": "وزان پس بشمشیر یازید مرد"
  },
  {
    "poem_id": 1877,
    "vorder": 40,
    "position": 1,
    "text": "تن اژدها را به دونیم کرد"
  },
  {
    "poem_id": 1877,
    "vorder": 41,
    "position": 0,
    "text": "سر از تن جدا کند و بفگند خوار"
  },
  {
    "poem_id": 1877,
    "vorder": 42,
    "position": 1,
    "text": "ازان پس فرود آمد از کوهسار"
  },
  {
    "poem_id": 1877,
    "vorder": 43,
    "position": 0,
    "text": "ازان بیشه خاقان و خاتون برفت"
  },
  {
    "poem_id": 1877,
    "vorder": 44,
    "position": 1,
    "text": "دمان و دنان تا برکوه تفت"
  },
  {
    "poem_id": 1877,
    "vorder": 45,
    "position": 0,
    "text": "خروشی برآمد ز گردان چین"
  },
  {
    "poem_id": 1877,
    "vorder": 46,
    "position": 1,
    "text": "کز آواز گفتی بلرزد زمین"
  },
  {
    "poem_id": 1877,
    "vorder": 47,
    "position": 0,
    "text": "به بهرام برآفرین خواندند"
  },
  {
    "poem_id": 1877,
    "vorder": 48,
    "position": 1,
    "text": "بسی گوهر و زر برافشاندند"
  },
  {
    "poem_id": 1877,
    "vorder": 49,
    "position": 0,
    "text": "چو خاتون بشد دست او بوس داد"
  },
  {
    "poem_id": 1877,
    "vorder": 50,
    "position": 1,
    "text": "برفتند گردان فرخ نژاد"
  },
  {
    "poem_id": 1877,
    "vorder": 51,
    "position": 0,
    "text": "همه هم زبان آفرین خواندند"
  },
  {
    "poem_id": 1877,
    "vorder": 52,
    "position": 1,
    "text": "ورا شاه ایران زمین خواندند"
  },
  {
    "poem_id": 1877,
    "vorder": 53,
    "position": 0,
    "text": "گرفتش سپهدار چین در کنار"
  },
  {
    "poem_id": 1877,
    "vorder": 54,
    "position": 1,
    "text": "وزان پس ورا خواندی شهریار"
  },
  {
    "poem_id": 1877,
    "vorder": 55,
    "position": 0,
    "text": "چو خاقان چینی به ایوان رسید"
  },
  {
    "poem_id": 1877,
    "vorder": 56,
    "position": 1,
    "text": "فرستاده‌ای مهربان برگزید"
  },
  {
    "poem_id": 1877,
    "vorder": 57,
    "position": 0,
    "text": "فرستاد ده بدره گنجی درم"
  },
  {
    "poem_id": 1877,
    "vorder": 58,
    "position": 1,
    "text": "همان بدره و برده از بیش و کم"
  },
  {
    "poem_id": 1877,
    "vorder": 59,
    "position": 0,
    "text": "که رو پیش بهرام جنگی بگوی"
  },
  {
    "poem_id": 1877,
    "vorder": 60,
    "position": 1,
    "text": "که نزدیک ما یافتی آب روی"
  },
  {
    "poem_id": 1877,
    "vorder": 61,
    "position": 0,
    "text": "پس پردهٔ ما یکی دخترست"
  },
  {
    "poem_id": 1877,
    "vorder": 62,
    "position": 1,
    "text": "که بر تارک اختران افسرست"
  },
  {
    "poem_id": 1877,
    "vorder": 63,
    "position": 0,
    "text": "کنون گر بخواهی ز من دخترم"
  },
  {
    "poem_id": 1877,
    "vorder": 64,
    "position": 1,
    "text": "سپارم بتو لشکر و کشورم"
  },
  {
    "poem_id": 1877,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت بهرام کاری رواست"
  },
  {
    "poem_id": 1877,
    "vorder": 66,
    "position": 1,
    "text": "جهاندار بر بندگان پادشاست"
  },
  {
    "poem_id": 1877,
    "vorder": 67,
    "position": 0,
    "text": "به بهرام داد آن زمان دخترش"
  },
  {
    "poem_id": 1877,
    "vorder": 68,
    "position": 1,
    "text": "به فرمان او شد همه کشورش"
  },
  {
    "poem_id": 1877,
    "vorder": 69,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1877,
    "vorder": 70,
    "position": 1,
    "text": "نوشتند منشور نو بر حریر"
  },
  {
    "poem_id": 1877,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت هرکس کز ایران سرست"
  },
  {
    "poem_id": 1877,
    "vorder": 72,
    "position": 1,
    "text": "ببخشش نگر تا کرا در خورست"
  },
  {
    "poem_id": 1877,
    "vorder": 73,
    "position": 0,
    "text": "بر آیین چین خلعت آراستند"
  },
  {
    "poem_id": 1877,
    "vorder": 74,
    "position": 1,
    "text": "فراوان کلاه و کمر خواستند"
  },
  {
    "poem_id": 1877,
    "vorder": 75,
    "position": 0,
    "text": "جزاز داد و خورد شکارش نبود"
  },
  {
    "poem_id": 1877,
    "vorder": 76,
    "position": 1,
    "text": "غم گردش روزگارش نبود"
  },
  {
    "poem_id": 1877,
    "vorder": 77,
    "position": 0,
    "text": "بزرگان چینی و گردنکشان"
  },
  {
    "poem_id": 1877,
    "vorder": 78,
    "position": 1,
    "text": "ز بهرام یل داشتندی نشان"
  },
  {
    "poem_id": 1877,
    "vorder": 79,
    "position": 0,
    "text": "همه چین همی‌گفت ما بنده‌ایم"
  },
  {
    "poem_id": 1877,
    "vorder": 80,
    "position": 1,
    "text": "ز بهر تو اندر جهان زنده‌ایم"
  },
  {
    "poem_id": 1877,
    "vorder": 81,
    "position": 0,
    "text": "همی‌خورد بهرام و بخشید چیز"
  },
  {
    "poem_id": 1877,
    "vorder": 82,
    "position": 1,
    "text": "برو بر بسی آفرین بود نیز"
  }
]