[
  {
    "poem_id": 1364,
    "vorder": 1,
    "position": 0,
    "text": "فرستادهٔ سلم چون گشت باز"
  },
  {
    "poem_id": 1364,
    "vorder": 2,
    "position": 1,
    "text": "شهنشاه بنشست و بگشاد راز"
  },
  {
    "poem_id": 1364,
    "vorder": 3,
    "position": 0,
    "text": "گرامی جهانجوی را پیش خواند"
  },
  {
    "poem_id": 1364,
    "vorder": 4,
    "position": 1,
    "text": "همه گفتها پیش او بازراند"
  },
  {
    "poem_id": 1364,
    "vorder": 5,
    "position": 0,
    "text": "ورا گفت کان دو پسر جنگجوی"
  },
  {
    "poem_id": 1364,
    "vorder": 6,
    "position": 1,
    "text": "ز خاور سوی ما نهادند روی"
  },
  {
    "poem_id": 1364,
    "vorder": 7,
    "position": 0,
    "text": "از اختر چنین استشان بهره خود"
  },
  {
    "poem_id": 1364,
    "vorder": 8,
    "position": 1,
    "text": "که باشند شادان به کردار بد"
  },
  {
    "poem_id": 1364,
    "vorder": 9,
    "position": 0,
    "text": "دگر آنکه دو کشور آبشخورست"
  },
  {
    "poem_id": 1364,
    "vorder": 10,
    "position": 1,
    "text": "که آن بومها را درشتی برست"
  },
  {
    "poem_id": 1364,
    "vorder": 11,
    "position": 0,
    "text": "برادرت چندان برادر بود"
  },
  {
    "poem_id": 1364,
    "vorder": 12,
    "position": 1,
    "text": "کجا مر ترا بر سر افسر بود"
  },
  {
    "poem_id": 1364,
    "vorder": 13,
    "position": 0,
    "text": "چو پژمرده شد روی رنگین تو"
  },
  {
    "poem_id": 1364,
    "vorder": 14,
    "position": 1,
    "text": "نگردد دگر گرد بالین تو"
  },
  {
    "poem_id": 1364,
    "vorder": 15,
    "position": 0,
    "text": "تو گر پیش شمشیر مهرآوری"
  },
  {
    "poem_id": 1364,
    "vorder": 16,
    "position": 1,
    "text": "سرت گردد آشفته از داوری"
  },
  {
    "poem_id": 1364,
    "vorder": 17,
    "position": 0,
    "text": "دو فرزند من کز دو دوش جهان"
  },
  {
    "poem_id": 1364,
    "vorder": 18,
    "position": 1,
    "text": "برینسان گشادند بر من زبان"
  },
  {
    "poem_id": 1364,
    "vorder": 19,
    "position": 0,
    "text": "گرت سر بکارست بپسیچ کار"
  },
  {
    "poem_id": 1364,
    "vorder": 20,
    "position": 1,
    "text": "در گنج بگشای و بربند بار"
  },
  {
    "poem_id": 1364,
    "vorder": 21,
    "position": 0,
    "text": "تو گر چاشت را دست یازی به جام"
  },
  {
    "poem_id": 1364,
    "vorder": 22,
    "position": 1,
    "text": "و گر نه خورند ای پسر بر تو شام"
  },
  {
    "poem_id": 1364,
    "vorder": 23,
    "position": 0,
    "text": "نباید ز گیتی ترا یار کس"
  },
  {
    "poem_id": 1364,
    "vorder": 24,
    "position": 1,
    "text": "بی‌آزاری و راستی یار بس"
  },
  {
    "poem_id": 1364,
    "vorder": 25,
    "position": 0,
    "text": "نگه کرد پس ایرج نامور"
  },
  {
    "poem_id": 1364,
    "vorder": 26,
    "position": 1,
    "text": "برآن مهربان پاک فرخ پدر"
  },
  {
    "poem_id": 1364,
    "vorder": 27,
    "position": 0,
    "text": "چنین داد پاسخ که ای شهریار"
  },
  {
    "poem_id": 1364,
    "vorder": 28,
    "position": 1,
    "text": "نگه کن بدین گردش روزگار"
  },
  {
    "poem_id": 1364,
    "vorder": 29,
    "position": 0,
    "text": "که چون باد بر ما همی بگذرد"
  },
  {
    "poem_id": 1364,
    "vorder": 30,
    "position": 1,
    "text": "خردمند مردم چرا غم خورد"
  },
  {
    "poem_id": 1364,
    "vorder": 31,
    "position": 0,
    "text": "همی پژمراند رخ ارغوان"
  },
  {
    "poem_id": 1364,
    "vorder": 32,
    "position": 1,
    "text": "کند تیره دیدار روشن‌روان"
  },
  {
    "poem_id": 1364,
    "vorder": 33,
    "position": 0,
    "text": "به آغاز گنج است و فرجام رنج"
  },
  {
    "poem_id": 1364,
    "vorder": 34,
    "position": 1,
    "text": "پس از رنج رفتن ز جای سپنچ"
  },
  {
    "poem_id": 1364,
    "vorder": 35,
    "position": 0,
    "text": "چو بستر ز خاکست و بالین ز خشت"
  },
  {
    "poem_id": 1364,
    "vorder": 36,
    "position": 1,
    "text": "درختی چرا باید امروز کشت"
  },
  {
    "poem_id": 1364,
    "vorder": 37,
    "position": 0,
    "text": "که هر چند چرخ از برش بگذرد"
  },
  {
    "poem_id": 1364,
    "vorder": 38,
    "position": 1,
    "text": "تنش خون خورد بار کین آورد"
  },
  {
    "poem_id": 1364,
    "vorder": 39,
    "position": 0,
    "text": "خداوند شمشیر و گاه و نگین"
  },
  {
    "poem_id": 1364,
    "vorder": 40,
    "position": 1,
    "text": "چو ما دید بسیار و بیند زمین"
  },
  {
    "poem_id": 1364,
    "vorder": 41,
    "position": 0,
    "text": "از آن تاجور نامداران پیش"
  },
  {
    "poem_id": 1364,
    "vorder": 42,
    "position": 1,
    "text": "ندیدند کین اندر آیین خویش"
  },
  {
    "poem_id": 1364,
    "vorder": 43,
    "position": 0,
    "text": "چو دستور باشد مرا شهریار"
  },
  {
    "poem_id": 1364,
    "vorder": 44,
    "position": 1,
    "text": "به بد نگذرانم بد روزگار"
  },
  {
    "poem_id": 1364,
    "vorder": 45,
    "position": 0,
    "text": "نباید مرا تاج و تخت و کلاه"
  },
  {
    "poem_id": 1364,
    "vorder": 46,
    "position": 1,
    "text": "شوم پیش ایشان دوان بی‌سپاه"
  },
  {
    "poem_id": 1364,
    "vorder": 47,
    "position": 0,
    "text": "بگویم که ای نامداران من"
  },
  {
    "poem_id": 1364,
    "vorder": 48,
    "position": 1,
    "text": "چنان چون گرامی تن و جان من"
  },
  {
    "poem_id": 1364,
    "vorder": 49,
    "position": 0,
    "text": "به بیهوده از شهریار زمین"
  },
  {
    "poem_id": 1364,
    "vorder": 50,
    "position": 1,
    "text": "مدارید خشم و مدارید کین"
  },
  {
    "poem_id": 1364,
    "vorder": 51,
    "position": 0,
    "text": "به گیتی مدارید چندین امید"
  },
  {
    "poem_id": 1364,
    "vorder": 52,
    "position": 1,
    "text": "نگر تا چه بد کرد با جمشید"
  },
  {
    "poem_id": 1364,
    "vorder": 53,
    "position": 0,
    "text": "به فرجام هم شد ز گیتی بدر"
  },
  {
    "poem_id": 1364,
    "vorder": 54,
    "position": 1,
    "text": "نماندش همان تاج و تخت و کمر"
  },
  {
    "poem_id": 1364,
    "vorder": 55,
    "position": 0,
    "text": "مرا با شما هم به فرجام کار"
  },
  {
    "poem_id": 1364,
    "vorder": 56,
    "position": 1,
    "text": "بباید چشیدن بد روزگار"
  },
  {
    "poem_id": 1364,
    "vorder": 57,
    "position": 0,
    "text": "دل کینه ورشان بدین آورم"
  },
  {
    "poem_id": 1364,
    "vorder": 58,
    "position": 1,
    "text": "سزاوارتر زانکه کین آورم"
  },
  {
    "poem_id": 1364,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت شاه ای خردمند پور"
  },
  {
    "poem_id": 1364,
    "vorder": 60,
    "position": 1,
    "text": "برادر همی رزم جوید تو سور"
  },
  {
    "poem_id": 1364,
    "vorder": 61,
    "position": 0,
    "text": "مرا این سخن یاد باید گرفت"
  },
  {
    "poem_id": 1364,
    "vorder": 62,
    "position": 1,
    "text": "ز مه روشنایی نیاید شگفت"
  },
  {
    "poem_id": 1364,
    "vorder": 63,
    "position": 0,
    "text": "ز تو پر خرد پاسخ ایدون سزید"
  },
  {
    "poem_id": 1364,
    "vorder": 64,
    "position": 1,
    "text": "دلت مهر پیوند ایشان گزید"
  },
  {
    "poem_id": 1364,
    "vorder": 65,
    "position": 0,
    "text": "ولیکن چو جانی شود بی‌بها"
  },
  {
    "poem_id": 1364,
    "vorder": 66,
    "position": 1,
    "text": "نهد پر خرد در دم اژدها"
  },
  {
    "poem_id": 1364,
    "vorder": 67,
    "position": 0,
    "text": "چه پیش آیدش جز گزاینده زهر"
  },
  {
    "poem_id": 1364,
    "vorder": 68,
    "position": 1,
    "text": "کش از آفرینش چنین است بهر"
  },
  {
    "poem_id": 1364,
    "vorder": 69,
    "position": 0,
    "text": "ترا ای پسر گر چنین است رای"
  },
  {
    "poem_id": 1364,
    "vorder": 70,
    "position": 1,
    "text": "بیارای کار و بپرداز جای"
  },
  {
    "poem_id": 1364,
    "vorder": 71,
    "position": 0,
    "text": "پرستنده چند از میان سپاه"
  },
  {
    "poem_id": 1364,
    "vorder": 72,
    "position": 1,
    "text": "بفرمای کایند با تو به راه"
  },
  {
    "poem_id": 1364,
    "vorder": 73,
    "position": 0,
    "text": "ز درد دل اکنون یکی نامه من"
  },
  {
    "poem_id": 1364,
    "vorder": 74,
    "position": 1,
    "text": "نویسم فرستم بدان انجمن"
  },
  {
    "poem_id": 1364,
    "vorder": 75,
    "position": 0,
    "text": "مگر باز بینم ترا تن درست"
  },
  {
    "poem_id": 1364,
    "vorder": 76,
    "position": 1,
    "text": "که روشن روانم به دیدار تست"
  }
]