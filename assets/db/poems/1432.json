[
  {
    "poem_id": 1432,
    "vorder": 1,
    "position": 0,
    "text": "چو زال سپهبد ز پهلو برفت"
  },
  {
    "poem_id": 1432,
    "vorder": 2,
    "position": 1,
    "text": "دمادم سپه روی بنهاد و تفت"
  },
  {
    "poem_id": 1432,
    "vorder": 3,
    "position": 0,
    "text": "به طوس و به گودرز فرمود شاه"
  },
  {
    "poem_id": 1432,
    "vorder": 4,
    "position": 1,
    "text": "کشیدن سپه سر نهادن به راه"
  },
  {
    "poem_id": 1432,
    "vorder": 5,
    "position": 0,
    "text": "چو شب روز شد شاه و جنگ‌آوران"
  },
  {
    "poem_id": 1432,
    "vorder": 6,
    "position": 1,
    "text": "نهادند سر سوی مازندران"
  },
  {
    "poem_id": 1432,
    "vorder": 7,
    "position": 0,
    "text": "به میلاد بسپرد ایران زمین"
  },
  {
    "poem_id": 1432,
    "vorder": 8,
    "position": 1,
    "text": "کلید در گنج و تاج و نگین"
  },
  {
    "poem_id": 1432,
    "vorder": 9,
    "position": 0,
    "text": "بدو گفت گر دشمن آید پدید"
  },
  {
    "poem_id": 1432,
    "vorder": 10,
    "position": 1,
    "text": "ترا تیغ کینه بباید کشید"
  },
  {
    "poem_id": 1432,
    "vorder": 11,
    "position": 0,
    "text": "ز هر بد به زال و به رستم پناه"
  },
  {
    "poem_id": 1432,
    "vorder": 12,
    "position": 1,
    "text": "که پشت سپاهند و زیبای گاه"
  },
  {
    "poem_id": 1432,
    "vorder": 13,
    "position": 0,
    "text": "دگر روز برخاست آوای کوس"
  },
  {
    "poem_id": 1432,
    "vorder": 14,
    "position": 1,
    "text": "سپه را همی راند گودرز و طوس"
  },
  {
    "poem_id": 1432,
    "vorder": 15,
    "position": 0,
    "text": "همی رفت کاووس لشکر فروز"
  },
  {
    "poem_id": 1432,
    "vorder": 16,
    "position": 1,
    "text": "بزد گاه بر پیش کوه اسپروز"
  },
  {
    "poem_id": 1432,
    "vorder": 17,
    "position": 0,
    "text": "به جایی که پنهان شود آفتاب"
  },
  {
    "poem_id": 1432,
    "vorder": 18,
    "position": 1,
    "text": "بدان جایگه ساخت آرام و خواب"
  },
  {
    "poem_id": 1432,
    "vorder": 19,
    "position": 0,
    "text": "کجا جای دیوان دژخیم بود"
  },
  {
    "poem_id": 1432,
    "vorder": 20,
    "position": 1,
    "text": "بدان جایگه پیل را بیم بود"
  },
  {
    "poem_id": 1432,
    "vorder": 21,
    "position": 0,
    "text": "بگسترد زربفت بر میش سار"
  },
  {
    "poem_id": 1432,
    "vorder": 22,
    "position": 1,
    "text": "هوا پر ز بوی از می خوشگوار"
  },
  {
    "poem_id": 1432,
    "vorder": 23,
    "position": 0,
    "text": "همه پهلوانان فرخنده پی"
  },
  {
    "poem_id": 1432,
    "vorder": 24,
    "position": 1,
    "text": "نشستند بر تخت کاووس کی"
  },
  {
    "poem_id": 1432,
    "vorder": 25,
    "position": 0,
    "text": "همه شب می و مجلس آراستند"
  },
  {
    "poem_id": 1432,
    "vorder": 26,
    "position": 1,
    "text": "به شبگیر کز خواب برخاستند"
  },
  {
    "poem_id": 1432,
    "vorder": 27,
    "position": 0,
    "text": "پراگنده نزدیک شاه آمدند"
  },
  {
    "poem_id": 1432,
    "vorder": 28,
    "position": 1,
    "text": "کمر بسته و با کلاه آمدند"
  },
  {
    "poem_id": 1432,
    "vorder": 29,
    "position": 0,
    "text": "بفرمود پس گیو را شهریار"
  },
  {
    "poem_id": 1432,
    "vorder": 30,
    "position": 1,
    "text": "دوباره ز لشکر گزیدن هزار"
  },
  {
    "poem_id": 1432,
    "vorder": 31,
    "position": 0,
    "text": "کسی کاو گراید به گرز گران"
  },
  {
    "poem_id": 1432,
    "vorder": 32,
    "position": 1,
    "text": "گشایندهٔ شهر مازندران"
  },
  {
    "poem_id": 1432,
    "vorder": 33,
    "position": 0,
    "text": "هر آنکس که بینی ز پیر و جوان"
  },
  {
    "poem_id": 1432,
    "vorder": 34,
    "position": 1,
    "text": "تنی کن که با او نباشد روان"
  },
  {
    "poem_id": 1432,
    "vorder": 35,
    "position": 0,
    "text": "وزو هرچ آباد بینی بسوز"
  },
  {
    "poem_id": 1432,
    "vorder": 36,
    "position": 1,
    "text": "شب آور به جایی که باشی به روز"
  },
  {
    "poem_id": 1432,
    "vorder": 37,
    "position": 0,
    "text": "چنین تا به دیوان رسد آگهی"
  },
  {
    "poem_id": 1432,
    "vorder": 38,
    "position": 1,
    "text": "جهان کن سراسر ز دیوان تهی"
  },
  {
    "poem_id": 1432,
    "vorder": 39,
    "position": 0,
    "text": "کمر بست و رفت از بر شاه گیو"
  },
  {
    "poem_id": 1432,
    "vorder": 40,
    "position": 1,
    "text": "ز لشکر گزین کرد گردان نیو"
  },
  {
    "poem_id": 1432,
    "vorder": 41,
    "position": 0,
    "text": "بشد تا در شهر مازندران"
  },
  {
    "poem_id": 1432,
    "vorder": 42,
    "position": 1,
    "text": "ببارید شمشیر و گرز گران"
  },
  {
    "poem_id": 1432,
    "vorder": 43,
    "position": 0,
    "text": "زن و کودک و مرد با دستوار"
  },
  {
    "poem_id": 1432,
    "vorder": 44,
    "position": 1,
    "text": "نیافت از سر تیغ او زینهار"
  },
  {
    "poem_id": 1432,
    "vorder": 45,
    "position": 0,
    "text": "همی کرد غارت همی سوخت شهر"
  },
  {
    "poem_id": 1432,
    "vorder": 46,
    "position": 1,
    "text": "بپالود بر جای تریاک زهر"
  },
  {
    "poem_id": 1432,
    "vorder": 47,
    "position": 0,
    "text": "یکی چون بهشت برین شهر دید"
  },
  {
    "poem_id": 1432,
    "vorder": 48,
    "position": 1,
    "text": "پر از خرمی بر درش بهر دید"
  },
  {
    "poem_id": 1432,
    "vorder": 49,
    "position": 0,
    "text": "به هر برزنی بر فزون از هزار"
  },
  {
    "poem_id": 1432,
    "vorder": 50,
    "position": 1,
    "text": "پرستار با طوق و با گوشوار"
  },
  {
    "poem_id": 1432,
    "vorder": 51,
    "position": 0,
    "text": "پرستنده زین بیشتر با کلاه"
  },
  {
    "poem_id": 1432,
    "vorder": 52,
    "position": 1,
    "text": "به چهره به کردار تابنده ماه"
  },
  {
    "poem_id": 1432,
    "vorder": 53,
    "position": 0,
    "text": "به هر جای گنجی پراگنده زر"
  },
  {
    "poem_id": 1432,
    "vorder": 54,
    "position": 1,
    "text": "به یک جای دینار سرخ و گهر"
  },
  {
    "poem_id": 1432,
    "vorder": 55,
    "position": 0,
    "text": "بی‌اندازه گرد اندرش چارپای"
  },
  {
    "poem_id": 1432,
    "vorder": 56,
    "position": 1,
    "text": "بهشتیست گفتی همیدون به جای"
  },
  {
    "poem_id": 1432,
    "vorder": 57,
    "position": 0,
    "text": "به کاووس بردند از او آگهی"
  },
  {
    "poem_id": 1432,
    "vorder": 58,
    "position": 1,
    "text": "ازان خرمی جای و آن فرهی"
  },
  {
    "poem_id": 1432,
    "vorder": 59,
    "position": 0,
    "text": "همی گفت خرم زیاد آنک گفت"
  },
  {
    "poem_id": 1432,
    "vorder": 60,
    "position": 1,
    "text": "که مازندران را بهشتست جفت"
  },
  {
    "poem_id": 1432,
    "vorder": 61,
    "position": 0,
    "text": "همه شهر گویی مگر بتکده‌ست"
  },
  {
    "poem_id": 1432,
    "vorder": 62,
    "position": 1,
    "text": "ز دیبای چین بر گل آذین زدست"
  },
  {
    "poem_id": 1432,
    "vorder": 63,
    "position": 0,
    "text": "بتان بهشتند گویی درست"
  },
  {
    "poem_id": 1432,
    "vorder": 64,
    "position": 1,
    "text": "به گلنارشان روی رضوان بشست"
  },
  {
    "poem_id": 1432,
    "vorder": 65,
    "position": 0,
    "text": "چو یک هفته بگذشت ایرانیان"
  },
  {
    "poem_id": 1432,
    "vorder": 66,
    "position": 1,
    "text": "ز غارت گشادند یکسر میان"
  },
  {
    "poem_id": 1432,
    "vorder": 67,
    "position": 0,
    "text": "خبر شد سوی شاه مازندران"
  },
  {
    "poem_id": 1432,
    "vorder": 68,
    "position": 1,
    "text": "دلش گشت پر درد و سر شد گران"
  },
  {
    "poem_id": 1432,
    "vorder": 69,
    "position": 0,
    "text": "ز دیوان به پیش اندرون سنجه بود"
  },
  {
    "poem_id": 1432,
    "vorder": 70,
    "position": 1,
    "text": "که جان و تنش زان سخن رنجه بود"
  },
  {
    "poem_id": 1432,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت رو نزد دیو سپید"
  },
  {
    "poem_id": 1432,
    "vorder": 72,
    "position": 1,
    "text": "چنان رو که بر چرخ گردنده شید"
  },
  {
    "poem_id": 1432,
    "vorder": 73,
    "position": 0,
    "text": "بگویش که آمد به مازندران"
  },
  {
    "poem_id": 1432,
    "vorder": 74,
    "position": 1,
    "text": "بغارت از ایران سپاهی گران"
  },
  {
    "poem_id": 1432,
    "vorder": 75,
    "position": 0,
    "text": "جهانجوی کاووس شان پیش رو"
  },
  {
    "poem_id": 1432,
    "vorder": 76,
    "position": 1,
    "text": "یکی لشگری جنگ سازان نو"
  },
  {
    "poem_id": 1432,
    "vorder": 77,
    "position": 0,
    "text": "کنون گر نباشی تو فریادرس"
  },
  {
    "poem_id": 1432,
    "vorder": 78,
    "position": 1,
    "text": "نبینی بمازندران زنده کس"
  },
  {
    "poem_id": 1432,
    "vorder": 79,
    "position": 0,
    "text": "چو بشنید پیغام سنجه نهفت"
  },
  {
    "poem_id": 1432,
    "vorder": 80,
    "position": 1,
    "text": "بر دیو پیغام شه بازگفت"
  },
  {
    "poem_id": 1432,
    "vorder": 81,
    "position": 0,
    "text": "چنین پاسخش داد دیو سپید"
  },
  {
    "poem_id": 1432,
    "vorder": 82,
    "position": 1,
    "text": "که از روزگاران مشو ناامید"
  },
  {
    "poem_id": 1432,
    "vorder": 83,
    "position": 0,
    "text": "بیایم کنون با سپاهی گران"
  },
  {
    "poem_id": 1432,
    "vorder": 84,
    "position": 1,
    "text": "ببرم پی او ز مازندران"
  },
  {
    "poem_id": 1432,
    "vorder": 85,
    "position": 0,
    "text": "شب آمد یکی ابر شد با سپاه"
  },
  {
    "poem_id": 1432,
    "vorder": 86,
    "position": 1,
    "text": "جهان کرد چون روی زنگی سیاه"
  },
  {
    "poem_id": 1432,
    "vorder": 87,
    "position": 0,
    "text": "چو دریای قارست گفتی جهان"
  },
  {
    "poem_id": 1432,
    "vorder": 88,
    "position": 1,
    "text": "همه روشناییش گشته نهان"
  },
  {
    "poem_id": 1432,
    "vorder": 89,
    "position": 0,
    "text": "یکی خیمه زد بر سر او دود و قیر"
  },
  {
    "poem_id": 1432,
    "vorder": 90,
    "position": 1,
    "text": "سیه شد جهان چشمها خیره خیر"
  },
  {
    "poem_id": 1432,
    "vorder": 91,
    "position": 0,
    "text": "چو بگذشت شب روز نزدیک شد"
  },
  {
    "poem_id": 1432,
    "vorder": 92,
    "position": 1,
    "text": "جهانجوی را چشم تاریک شد"
  },
  {
    "poem_id": 1432,
    "vorder": 93,
    "position": 0,
    "text": "ز لشکر دو بهره شده تیره چشم"
  },
  {
    "poem_id": 1432,
    "vorder": 94,
    "position": 1,
    "text": "سر نامداران ازو پر ز خشم"
  },
  {
    "poem_id": 1432,
    "vorder": 95,
    "position": 0,
    "text": "از ایشان فراوان تبه کرد نیز"
  },
  {
    "poem_id": 1432,
    "vorder": 96,
    "position": 1,
    "text": "نبود از بدبخت ماننده چیز"
  },
  {
    "poem_id": 1432,
    "vorder": 97,
    "position": 0,
    "text": "چو تاریک شد چشم کاووس شاه"
  },
  {
    "poem_id": 1432,
    "vorder": 98,
    "position": 1,
    "text": "بد آمد ز کردار او بر سپاه"
  },
  {
    "poem_id": 1432,
    "vorder": 99,
    "position": 0,
    "text": "همه گنج تاراج و لشکر اسیر"
  },
  {
    "poem_id": 1432,
    "vorder": 100,
    "position": 1,
    "text": "جوان دولت و بخت برگشت پیر"
  },
  {
    "poem_id": 1432,
    "vorder": 101,
    "position": 0,
    "text": "همه داستان یاد باید گرفت"
  },
  {
    "poem_id": 1432,
    "vorder": 102,
    "position": 1,
    "text": "که خیره نماید شگفت از شگفت"
  },
  {
    "poem_id": 1432,
    "vorder": 103,
    "position": 0,
    "text": "سپهبد چنین گفت چون دید رنج"
  },
  {
    "poem_id": 1432,
    "vorder": 104,
    "position": 1,
    "text": "که دستور بیدار بهتر ز گنج"
  },
  {
    "poem_id": 1432,
    "vorder": 105,
    "position": 0,
    "text": "به سختی چو یک هفته اندر کشید"
  },
  {
    "poem_id": 1432,
    "vorder": 106,
    "position": 1,
    "text": "به دیده ز ایرانیان کس ندید"
  },
  {
    "poem_id": 1432,
    "vorder": 107,
    "position": 0,
    "text": "بهشتم بغرید دیو سپید"
  },
  {
    "poem_id": 1432,
    "vorder": 108,
    "position": 1,
    "text": "که ای شاه بی‌بر به کردار بید"
  },
  {
    "poem_id": 1432,
    "vorder": 109,
    "position": 0,
    "text": "همی برتری را بیاراستی"
  },
  {
    "poem_id": 1432,
    "vorder": 110,
    "position": 1,
    "text": "چراگاه مازندران خواستی"
  },
  {
    "poem_id": 1432,
    "vorder": 111,
    "position": 0,
    "text": "همی نیروی خویش چون پیل مست"
  },
  {
    "poem_id": 1432,
    "vorder": 112,
    "position": 1,
    "text": "بدیدی و کس را ندادی تو دست"
  },
  {
    "poem_id": 1432,
    "vorder": 113,
    "position": 0,
    "text": "چو با تاج و با تخت نشکیفتی"
  },
  {
    "poem_id": 1432,
    "vorder": 114,
    "position": 1,
    "text": "خرد را بدین‌گونه بفریفتی"
  },
  {
    "poem_id": 1432,
    "vorder": 115,
    "position": 0,
    "text": "کنون آنچ اندر خور کار تست"
  },
  {
    "poem_id": 1432,
    "vorder": 116,
    "position": 1,
    "text": "دلت یافت آن آرزوها که جست"
  },
  {
    "poem_id": 1432,
    "vorder": 117,
    "position": 0,
    "text": "ازان نره دیوان خنجرگذار"
  },
  {
    "poem_id": 1432,
    "vorder": 118,
    "position": 1,
    "text": "گزین کرد جنگی ده و دوهزار"
  },
  {
    "poem_id": 1432,
    "vorder": 119,
    "position": 0,
    "text": "بر ایرانیان بر نگهدار کرد"
  },
  {
    "poem_id": 1432,
    "vorder": 120,
    "position": 1,
    "text": "سر سرکشان پر ز تیمار کرد"
  },
  {
    "poem_id": 1432,
    "vorder": 121,
    "position": 0,
    "text": "سران را همه بندها ساختند"
  },
  {
    "poem_id": 1432,
    "vorder": 122,
    "position": 1,
    "text": "چو از بند و بستن بپرداختند"
  },
  {
    "poem_id": 1432,
    "vorder": 123,
    "position": 0,
    "text": "خورش دادشان اندکی جان سپوز"
  },
  {
    "poem_id": 1432,
    "vorder": 124,
    "position": 1,
    "text": "بدان تا گذارند روزی به روز"
  },
  {
    "poem_id": 1432,
    "vorder": 125,
    "position": 0,
    "text": "ازان پس همه گنج شاه جهان"
  },
  {
    "poem_id": 1432,
    "vorder": 126,
    "position": 1,
    "text": "چه از تاج یاقوت و گرز گران"
  },
  {
    "poem_id": 1432,
    "vorder": 127,
    "position": 0,
