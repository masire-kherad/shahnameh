[
  {
    "poem_id": 1780,
    "vorder": 1,
    "position": 0,
    "text": "دگر هفته آمد به نخچیرگاه"
  },
  {
    "poem_id": 1780,
    "vorder": 2,
    "position": 1,
    "text": "خود و موبدان و ردان سپاه"
  },
  {
    "poem_id": 1780,
    "vorder": 3,
    "position": 0,
    "text": "بیامد یکی سرد مهترپرست"
  },
  {
    "poem_id": 1780,
    "vorder": 4,
    "position": 1,
    "text": "چو باد دمان با گرازی به دست"
  },
  {
    "poem_id": 1780,
    "vorder": 5,
    "position": 0,
    "text": "بپرسید مهتر که بهرامشاه"
  },
  {
    "poem_id": 1780,
    "vorder": 6,
    "position": 1,
    "text": "کجا باشد اندر میان سپاه"
  },
  {
    "poem_id": 1780,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت هرکس که تو شاه را"
  },
  {
    "poem_id": 1780,
    "vorder": 8,
    "position": 1,
    "text": "چه جویی نگویی به ما راه را"
  },
  {
    "poem_id": 1780,
    "vorder": 9,
    "position": 0,
    "text": "چنین داد پاسخ که تا روی شاه"
  },
  {
    "poem_id": 1780,
    "vorder": 10,
    "position": 1,
    "text": "نبینم نگویم سخن با سپاه"
  },
  {
    "poem_id": 1780,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت موبد چه باید بگوی"
  },
  {
    "poem_id": 1780,
    "vorder": 12,
    "position": 1,
    "text": "تو شاه جهان را ندانی به روی"
  },
  {
    "poem_id": 1780,
    "vorder": 13,
    "position": 0,
    "text": "بر شاه بردند جوینده را"
  },
  {
    "poem_id": 1780,
    "vorder": 14,
    "position": 1,
    "text": "چنان دانشی مرد گوینده را"
  },
  {
    "poem_id": 1780,
    "vorder": 15,
    "position": 0,
    "text": "بیامد چو بهرام را دید گفت"
  },
  {
    "poem_id": 1780,
    "vorder": 16,
    "position": 1,
    "text": "که با تو سخن دارم اندر نهفت"
  },
  {
    "poem_id": 1780,
    "vorder": 17,
    "position": 0,
    "text": "عنان را بپیچید بهرام گور"
  },
  {
    "poem_id": 1780,
    "vorder": 18,
    "position": 1,
    "text": "ز دیدار لشکر برون راند دور"
  },
  {
    "poem_id": 1780,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت مرد این جهاندیده شاه"
  },
  {
    "poem_id": 1780,
    "vorder": 20,
    "position": 1,
    "text": "به گفتار من کرد باید نگاه"
  },
  {
    "poem_id": 1780,
    "vorder": 21,
    "position": 0,
    "text": "بدین مرز دهقانم و کدخدای"
  },
  {
    "poem_id": 1780,
    "vorder": 22,
    "position": 1,
    "text": "خدای بر و بوم و ورز و سرای"
  },
  {
    "poem_id": 1780,
    "vorder": 23,
    "position": 0,
    "text": "همی آب بردم بدین مرز خویش"
  },
  {
    "poem_id": 1780,
    "vorder": 24,
    "position": 1,
    "text": "که در کار پیدا کنم ارز خویش"
  },
  {
    "poem_id": 1780,
    "vorder": 25,
    "position": 0,
    "text": "چو بسیار گشت آب گستاخ شد"
  },
  {
    "poem_id": 1780,
    "vorder": 26,
    "position": 1,
    "text": "میان یکی مرز سوراخ شد"
  },
  {
    "poem_id": 1780,
    "vorder": 27,
    "position": 0,
    "text": "شگفتی خروشی به گوش آمدم"
  },
  {
    "poem_id": 1780,
    "vorder": 28,
    "position": 1,
    "text": "کزان بیم جای خروش آمدم"
  },
  {
    "poem_id": 1780,
    "vorder": 29,
    "position": 0,
    "text": "همی اندران جای آواز سنج"
  },
  {
    "poem_id": 1780,
    "vorder": 30,
    "position": 1,
    "text": "خروشش همی ره نماید به گنج"
  },
  {
    "poem_id": 1780,
    "vorder": 31,
    "position": 0,
    "text": "چو بشنید بهرام آنجا کشید"
  },
  {
    "poem_id": 1780,
    "vorder": 32,
    "position": 1,
    "text": "همه دشت پر سبزه و آب دید"
  },
  {
    "poem_id": 1780,
    "vorder": 33,
    "position": 0,
    "text": "بفرمود تا کارگر با گراز"
  },
  {
    "poem_id": 1780,
    "vorder": 34,
    "position": 1,
    "text": "بیارند چندی ز راه دراز"
  },
  {
    "poem_id": 1780,
    "vorder": 35,
    "position": 0,
    "text": "فرود آمد از باره شاه بلند"
  },
  {
    "poem_id": 1780,
    "vorder": 36,
    "position": 1,
    "text": "شراعی زدند از برکشتمند"
  },
  {
    "poem_id": 1780,
    "vorder": 37,
    "position": 0,
    "text": "شب آمد گوان شمعی افروختند"
  },
  {
    "poem_id": 1780,
    "vorder": 38,
    "position": 1,
    "text": "به هر جای آتش همی سوختند"
  },
  {
    "poem_id": 1780,
    "vorder": 39,
    "position": 0,
    "text": "ز دریا چو خورشید برزد درفش"
  },
  {
    "poem_id": 1780,
    "vorder": 40,
    "position": 1,
    "text": "چو مصقول کرد این سرای بنفش"
  },
  {
    "poem_id": 1780,
    "vorder": 41,
    "position": 0,
    "text": "ز هر سو برفتند کاریگران"
  },
  {
    "poem_id": 1780,
    "vorder": 42,
    "position": 1,
    "text": "شدند انجمن چون سپاهی گران"
  },
  {
    "poem_id": 1780,
    "vorder": 43,
    "position": 0,
    "text": "زمین را به کندن گرفتند پاک"
  },
  {
    "poem_id": 1780,
    "vorder": 44,
    "position": 1,
    "text": "شد آن جای هامون سراسر مغاک"
  },
  {
    "poem_id": 1780,
    "vorder": 45,
    "position": 0,
    "text": "ز کندن چو گشتند مردم ستوه"
  },
  {
    "poem_id": 1780,
    "vorder": 46,
    "position": 1,
    "text": "پدید آمد از خاک چیزی چو کوه"
  },
  {
    "poem_id": 1780,
    "vorder": 47,
    "position": 0,
    "text": "یکی خانه‌ای کرده از پخته خشت"
  },
  {
    "poem_id": 1780,
    "vorder": 48,
    "position": 1,
    "text": "به ساروج کرده بسان بهشت"
  },
  {
    "poem_id": 1780,
    "vorder": 49,
    "position": 0,
    "text": "کننده تبر زد همی از برش"
  },
  {
    "poem_id": 1780,
    "vorder": 50,
    "position": 1,
    "text": "پدید آمد از دور جای درش"
  },
  {
    "poem_id": 1780,
    "vorder": 51,
    "position": 0,
    "text": "چو موبد بدید اندر آمد به در"
  },
  {
    "poem_id": 1780,
    "vorder": 52,
    "position": 1,
    "text": "ابا او یکی ایرمانی دگر"
  },
  {
    "poem_id": 1780,
    "vorder": 53,
    "position": 0,
    "text": "یکی خانه دیدند پهن و دراز"
  },
  {
    "poem_id": 1780,
    "vorder": 54,
    "position": 1,
    "text": "برآورده بالای او چند باز"
  },
  {
    "poem_id": 1780,
    "vorder": 55,
    "position": 0,
    "text": "ز زر کرده بر پای دو گاومیش"
  },
  {
    "poem_id": 1780,
    "vorder": 56,
    "position": 1,
    "text": "یکی آخری کرده زرینش پیش"
  },
  {
    "poem_id": 1780,
    "vorder": 57,
    "position": 0,
    "text": "زبرجد به آخر درون ریخته"
  },
  {
    "poem_id": 1780,
    "vorder": 58,
    "position": 1,
    "text": "به یاقوت سرخ اندر آمیخته"
  },
  {
    "poem_id": 1780,
    "vorder": 59,
    "position": 0,
    "text": "چو دو گاو گردون میانش تهی"
  },
  {
    "poem_id": 1780,
    "vorder": 60,
    "position": 1,
    "text": "شکمشان پر از نار و سیب و بهی"
  },
  {
    "poem_id": 1780,
    "vorder": 61,
    "position": 0,
    "text": "میان بهی در خوشاب بود"
  },
  {
    "poem_id": 1780,
    "vorder": 62,
    "position": 1,
    "text": "که هر دانه‌ای قطرهٔ آب بود"
  },
  {
    "poem_id": 1780,
    "vorder": 63,
    "position": 0,
    "text": "همان گاو را چشم یاقوت بود"
  },
  {
    "poem_id": 1780,
    "vorder": 64,
    "position": 1,
    "text": "ز پیری سر گاو فرتوت بود"
  },
  {
    "poem_id": 1780,
    "vorder": 65,
    "position": 0,
    "text": "همه گرد بر گرد او شیر و گور"
  },
  {
    "poem_id": 1780,
    "vorder": 66,
    "position": 1,
    "text": "یکی دیده یاقوت و دیگر بلور"
  },
  {
    "poem_id": 1780,
    "vorder": 67,
    "position": 0,
    "text": "تذروان زرین و طاوس زر"
  },
  {
    "poem_id": 1780,
    "vorder": 68,
    "position": 1,
    "text": "همه سینه و چشمهاشان گهر"
  },
  {
    "poem_id": 1780,
    "vorder": 69,
    "position": 0,
    "text": "چو دستور دید آن بر شاه شد"
  },
  {
    "poem_id": 1780,
    "vorder": 70,
    "position": 1,
    "text": "به رای بلند افسر ماه شد"
  },
  {
    "poem_id": 1780,
    "vorder": 71,
    "position": 0,
    "text": "به نرمی به شاه جهان گفت خیز"
  },
  {
    "poem_id": 1780,
    "vorder": 72,
    "position": 1,
    "text": "که آمد همی گنجها را جهیز"
  },
  {
    "poem_id": 1780,
    "vorder": 73,
    "position": 0,
    "text": "یکی خانهٔ گوهر آمد پدید"
  },
  {
    "poem_id": 1780,
    "vorder": 74,
    "position": 1,
    "text": "که چرخ فلک داشت آن را کلید"
  },
  {
    "poem_id": 1780,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت بنگر که بر گنج نام"
  },
  {
    "poem_id": 1780,
    "vorder": 76,
    "position": 1,
    "text": "نویسد کسی کش بود گنج کام"
  },
  {
    "poem_id": 1780,
    "vorder": 77,
    "position": 0,
    "text": "نگه کن بدان گنج تا نام کیست"
  },
  {
    "poem_id": 1780,
    "vorder": 78,
    "position": 1,
    "text": "گر آگندن او به ایام کیست"
  },
  {
    "poem_id": 1780,
    "vorder": 79,
    "position": 0,
    "text": "بیامد سر موبدان چون شنید"
  },
  {
    "poem_id": 1780,
    "vorder": 80,
    "position": 1,
    "text": "بران گاو بر مهر جمشید دید"
  },
  {
    "poem_id": 1780,
    "vorder": 81,
    "position": 0,
    "text": "به شاه جهان گفت کردم نگاه"
  },
  {
    "poem_id": 1780,
    "vorder": 82,
    "position": 1,
    "text": "نوشتست بر گاو جمشید شاه"
  },
  {
    "poem_id": 1780,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت شاه ای سر موبدان"
  },
  {
    "poem_id": 1780,
    "vorder": 84,
    "position": 1,
    "text": "به هر کار داناتر از بخردان"
  },
  {
    "poem_id": 1780,
    "vorder": 85,
    "position": 0,
    "text": "ز گنجی که جمشید بنهاد پیش"
  },
  {
    "poem_id": 1780,
    "vorder": 86,
    "position": 1,
    "text": "چرا کرد باید مرا گنج خویش"
  },
  {
    "poem_id": 1780,
    "vorder": 87,
    "position": 0,
    "text": "هر آن گنج کان جز به شمشیر و داد"
  },
  {
    "poem_id": 1780,
    "vorder": 88,
    "position": 1,
    "text": "فراز آید آن پادشاهی مباد"
  },
  {
    "poem_id": 1780,
    "vorder": 89,
    "position": 0,
    "text": "به ارزانیان ده همه هرچ هست"
  },
  {
    "poem_id": 1780,
    "vorder": 90,
    "position": 1,
    "text": "مبادا که آید به ما برشکست"
  },
  {
    "poem_id": 1780,
    "vorder": 91,
    "position": 0,
    "text": "اگر نام باید که پیدا کنیم"
  },
  {
    "poem_id": 1780,
    "vorder": 92,
    "position": 1,
    "text": "به داد و به شمشیر گنج آگنیم"
  },
  {
    "poem_id": 1780,
    "vorder": 93,
    "position": 0,
    "text": "نباید سپاه مرا بهره زین"
  },
  {
    "poem_id": 1780,
    "vorder": 94,
    "position": 1,
    "text": "نه تنگست بر ما زمان و زمین"
  },
  {
    "poem_id": 1780,
    "vorder": 95,
    "position": 0,
    "text": "فروشید گوهر به زر و به سیم"
  },
  {
    "poem_id": 1780,
    "vorder": 96,
    "position": 1,
    "text": "زن بیوه و کودکان یتیم"
  },
  {
    "poem_id": 1780,
    "vorder": 97,
    "position": 0,
    "text": "تهی‌دست مردم که دارند نام"
  },
  {
    "poem_id": 1780,
    "vorder": 98,
    "position": 1,
    "text": "گسسته دل از نام و آرام و کام"
  },
  {
    "poem_id": 1780,
    "vorder": 99,
    "position": 0,
    "text": "ز ویران و آباد گرد آورید"
  },
  {
    "poem_id": 1780,
    "vorder": 100,
    "position": 1,
    "text": "ازان پس یکایک همه بشمرید"
  },
  {
    "poem_id": 1780,
    "vorder": 101,
    "position": 0,
    "text": "ببخشید دینار گنج و درم"
  },
  {
    "poem_id": 1780,
    "vorder": 102,
    "position": 1,
    "text": "به مزد روان جهاندار جم"
  },
  {
    "poem_id": 1780,
    "vorder": 103,
    "position": 0,
    "text": "ازان ده یک آنرا که بنمود راه"
  },
  {
    "poem_id": 1780,
    "vorder": 104,
    "position": 1,
    "text": "همی شاه جست از میان سپاه"
  },
  {
    "poem_id": 1780,
    "vorder": 105,
    "position": 0,
    "text": "مرا تا جوان باشم و تن درست"
  },
  {
    "poem_id": 1780,
    "vorder": 106,
    "position": 1,
    "text": "چرا بایدم گنج جمشید جست"
  },
  {
    "poem_id": 1780,
    "vorder": 107,
    "position": 0,
    "text": "گهر هرک بستاند از جمشید"
  },
  {
    "poem_id": 1780,
    "vorder": 108,
    "position": 1,
    "text": "به گیتی مبادش به نیکی امید"
  },
  {
    "poem_id": 1780,
    "vorder": 109,
    "position": 0,
    "text": "چو با لشکرم تن به رنج آوریم"
  },
  {
    "poem_id": 1780,
    "vorder": 110,
    "position": 1,
    "text": "ز روم و ز چین نام و گنج آوریم"
  },
  {
    "poem_id": 1780,
    "vorder": 111,
    "position": 0,
    "text": "مرا اسپ شبدیز و شمشیر تیز"
  },
  {
    "poem_id": 1780,
    "vorder": 112,
    "position": 1,
    "text": "نگیرم فریب و ندانم گریز"
  },
  {
    "poem_id": 1780,
    "vorder": 113,
    "position": 0,
    "text": "وزان جایگه شد سوی گنج خویش"
  },
  {
    "poem_id": 1780,
    "vorder": 114,
    "position": 1,
    "text": "که گرد آورید از خوی و رنج خویش"
  },
  {
    "poem_id": 1780,
    "vorder": 115,
    "position": 0,
    "text": "بیاورد گردان کشورش را"
  },
  {
    "poem_id": 1780,
    "vorder": 116,
    "position": 1,
    "text": "درم داد یکساله لشکرش را"
  },
  {
    "poem_id": 1780,
    "vorder": 117,
    "position": 0,
    "text": "یکی بزمگه ساخت چون نوبهار"
  },
  {
    "poem_id": 1780,
    "vorder": 118,
    "position": 1,
    "text": "بیاراست ایوان گوهرنگار"
  },
  {
    "poem_id": 1780,
    "vorder": 119,
    "position": 0,
    "text": "می لعل رخشان به جام بلور"
  },
  {
    "poem_id": 1780,
    "vorder": 120,
    "position": 1,
    "text": "چو شد خرم و شاد بهرام گور"
  },
  {
    "poem_id": 1780,
    "vorder": 121,
    "position": 0,
    "text": "به یاران چنین گفت کای سرکشان"
  },
  {
    "poem_id": 1780,
    "vorder": 122,
    "position": 1,
    "text": "شنیده ز تخت بزرگی نشان"
  },
  {
    "poem_id": 1780,
    "vorder": 123,
    "position": 0,
    "text": "ز هوشنگ تا نوذر نامدار"
  },
  {
    "poem_id": 1780,
    "vorder": 124,
    "position": 1,
    "text": "کجا ز آفریدون بد او یادگار"
  },
  {
    "poem_id": 1780,
    "vorder": 125,
    "position": 0,
    "text": "برین هم نشان تا سر کیقباد"
  },
  {
    "poem_id": 1780,
    "vorder": 126,
    "position": 1,
    "text": "که تاج فریدون به سر بر نهاد"
  },
  {
    "poem_id": 1780,
    "vorder": 127,
    "position": 0,
    "text": "ببینید تا زان بزرگان که ماند"
  },
  {
    "poem_id": 1780,
    "vorder": 128,
    "position": 1,
    "text": "بریشان به جز آفرین را که خواند"
  },
  {
    "poem_id": 1780,
    "vorder": 129,
    "position": 0,
    "text": "چو کوتاه شد گردش روزگار"
  },
  {
    "poem_id": 1780,
    "vorder": 130,
    "position": 1,
    "text": "سخن ماند زان مهتران یادگار"
  },
  {
    "poem_id": 1780,
    "vorder": 131,
    "position": 0,
    "text": "که این را منش بود و آن را نبود"
  },
  {
    "poem_id": 1780,
    "vorder": 132,
    "position": 1,
    "text": "یکی را نکوهش دگر را ستود"
  },
  {
    "poem_id": 1780,
    "vorder": 133,
    "position": 0,
    "text": "یکایک به نوبت همه بگذریم"
  },
  {
    "poem_id": 1780,
    "vorder": 134,
    "position": 1,
    "text": "سزد گر جهان را به بد نسپریم"
  },
  {
    "poem_id": 1780,
    "vorder": 135,
    "position": 0,
    "text": "چرا گنج آن رفتگان آوریم"
  },
  {
    "poem_id": 1780,
    "vorder": 136,
    "position": 1,
    "text": "وگر دل به دینارشان گستریم"
  },
  {
    "poem_id": 1780,
    "vorder": 137,
    "position": 0,
    "text": "نبندم دل اندر سرای سپنج"
  },
  {
    "poem_id": 1780,
    "vorder": 138,
    "position": 1,
    "text": "ننازم به تاج و نیازم به گنج"
  },
  {
    "poem_id": 1780,
    "vorder": 139,
    "position": 0,
    "text": "چو روزی به شادی همی بگذرد"
  },
  {
    "poem_id": 1780,
    "vorder": 140,
    "position": 1,
    "text": "خردمند مردم چرا غم خورد"
  },
  {
    "poem_id": 1780,
    "vorder": 141,
    "position": 0,
    "text": "هرانکس کزین زیردستان ما"
  },
  {
    "poem_id": 1780,
    "vorder": 142,
    "position": 1,
    "text": "ز دهقان و از در پرستان ما"
  },
  {
    "poem_id": 1780,
    "vorder": 143,
    "position": 0,
    "text": "بنالد یکی کهتر از رنج من"
  },
  {
    "poem_id": 1780,
    "vorder": 144,
    "position": 1,
    "text": "مبادا سر وافسر وگنج من"
  },
  {
    "poem_id": 1780,
    "vorder": 145,
    "position": 0,
    "text": "یکی پیر بد نام او ماهیار"
  },
  {
    "poem_id": 1780,
    "vorder": 146,
    "position": 1,
    "text": "شده سال او بر صد و شست و چار"
  },
  {
    "poem_id": 1780,
    "vorder": 147,
    "position": 0,
    "text": "چو آواز بشنید بر پای خاست"
  },
  {
    "poem_id": 1780,
    "vorder": 148,
    "position": 1,
    "text": "چنین گفت کای مهتر داد و راست"
  },
  {
    "poem_id": 1780,
    "vorder": 149,
    "position": 0,
    "text": "چنین یافتم از فریدون و جم"
  },
  {
    "poem_id": 1780,
    "vorder": 150,
    "position": 1,
    "text": "وزان نامداران هر بیش و کم"
  },
  {
    "poem_id": 1780,
    "vorder": 151,
    "position": 0,
    "text": "چو تو شاه ننشست کس در جهان"
  },
  {
    "poem_id": 1780,
    "vorder": 152,
    "position": 1,
    "text": "نه کس این شنید از کهان و مهان"
  },
  {
    "poem_id": 1780,
    "vorder": 153,
    "position": 0,
    "text": "به هنگام جم چون سخن راندند"
  },
  {
    "poem_id": 1780,
    "vorder": 154,
    "position": 1,
    "text": "ورا گنج گاوان همی خواندند"
  },
  {
    "poem_id": 1780,
    "vorder": 155,
    "position": 0,
    "text": "چو گنجی پراگنده‌ای در جهان"
  },
  {
    "poem_id": 1780,
    "vorder": 156,
    "position": 1,
    "text": "میان کهان و میان مهان"
  },
  {
    "poem_id": 1780,
    "vorder": 157,
    "position": 0,
    "text": "دلت گر به درهای دریاستی"
  },
  {
    "poem_id": 1780,
    "vorder": 158,
    "position": 1,
    "text": "ز دریا گهر موج برخاستی"
  },
  {
    "poem_id": 1780,
    "vorder": 159,
    "position": 0,
    "text": "ندانست کس در جهان کان کجاست"
  },
  {
    "poem_id": 1780,
    "vorder": 160,
    "position": 1,
    "text": "به خاکست گر در دم اژدهاست"
  },
  {
    "poem_id": 1780,
    "vorder": 161,
    "position": 0,
    "text": "تو چون یافتی ننگریدی به گنج"
  },
  {
    "poem_id": 1780,
    "vorder": 162,
    "position": 1,
    "text": "که ننگ آمدت این سرای سپنج"
  },
  {
    "poem_id": 1780,
    "vorder": 163,
    "position": 0,
    "text": "به دریا همانا که چندین گهر"
  },
  {
    "poem_id": 1780,
    "vorder": 164,
    "position": 1,
    "text": "به دیده ندیدست کس بیشتر"
  },
  {
    "poem_id": 1780,
    "vorder": 165,
    "position": 0,
    "text": "به دوریش بخشیدی این گوهران"
  },
  {
    "poem_id": 1780,
    "vorder": 166,
    "position": 1,
    "text": "همان گاو گوهر کران تا کران"
  },
  {
    "poem_id": 1780,
    "vorder": 167,
    "position": 0,
    "text": "پس از رفتنت نام تو زنده باد"
  },
  {
    "poem_id": 1780,
    "vorder": 168,
    "position": 1,
    "text": "تو آباد و پیروز و بخت از تو شاد"
  },
  {
    "poem_id": 1780,
    "vorder": 169,
    "position": 0,
    "text": "بسی دفتر خسروان زین سخن"
  },
  {
    "poem_id": 1780,
    "vorder": 170,
    "position": 1,
    "text": "سیه گردد و هم نیاید به بن"
  }
]