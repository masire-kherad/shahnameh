[
  {
    "poem_id": 1639,
    "vorder": 1,
    "position": 0,
    "text": "ز کرمان کس آمد سوی اصفهان"
  },
  {
    "poem_id": 1639,
    "vorder": 2,
    "position": 1,
    "text": "به جایی که بودند ز ایران مهان"
  },
  {
    "poem_id": 1639,
    "vorder": 3,
    "position": 0,
    "text": "به نزدیک پوشیده‌رویان شاه"
  },
  {
    "poem_id": 1639,
    "vorder": 4,
    "position": 1,
    "text": "بیامد یکی مرد با دستگاه"
  },
  {
    "poem_id": 1639,
    "vorder": 5,
    "position": 0,
    "text": "بدیشان درود سکندر ببرد"
  },
  {
    "poem_id": 1639,
    "vorder": 6,
    "position": 1,
    "text": "همه کار دارا بر ایشان شمرد"
  },
  {
    "poem_id": 1639,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت کز مرگ شاهان داد"
  },
  {
    "poem_id": 1639,
    "vorder": 8,
    "position": 1,
    "text": "نباشد دل دشمن و دوست شاد"
  },
  {
    "poem_id": 1639,
    "vorder": 9,
    "position": 0,
    "text": "بدانید کامروز دارا منم"
  },
  {
    "poem_id": 1639,
    "vorder": 10,
    "position": 1,
    "text": "گر او شد نهان آشکارا منم"
  },
  {
    "poem_id": 1639,
    "vorder": 11,
    "position": 0,
    "text": "فزونست ازان نیکویها که بود"
  },
  {
    "poem_id": 1639,
    "vorder": 12,
    "position": 1,
    "text": "به تیمار رخ را نشاید شخود"
  },
  {
    "poem_id": 1639,
    "vorder": 13,
    "position": 0,
    "text": "همه مرگ راییم شاه و سپاه"
  },
  {
    "poem_id": 1639,
    "vorder": 14,
    "position": 1,
    "text": "اگر دیر مانیم اگر چند گاه"
  },
  {
    "poem_id": 1639,
    "vorder": 15,
    "position": 0,
    "text": "بنه سوی شهر صطخر آورید"
  },
  {
    "poem_id": 1639,
    "vorder": 16,
    "position": 1,
    "text": "بپیوند ما نیز فخر آورید"
  },
  {
    "poem_id": 1639,
    "vorder": 17,
    "position": 0,
    "text": "همانست ایران که بود از نخست"
  },
  {
    "poem_id": 1639,
    "vorder": 18,
    "position": 1,
    "text": "بباشید شادان‌دل و تن‌درست"
  },
  {
    "poem_id": 1639,
    "vorder": 19,
    "position": 0,
    "text": "نوشتند نامه به هر کشوری"
  },
  {
    "poem_id": 1639,
    "vorder": 20,
    "position": 1,
    "text": "به هر نامداری و هر مهتری"
  },
  {
    "poem_id": 1639,
    "vorder": 21,
    "position": 0,
    "text": "ز اسکندر فیلقوس بزرگ"
  },
  {
    "poem_id": 1639,
    "vorder": 22,
    "position": 1,
    "text": "جهانگیر و با کینه‌جویان سترگ"
  },
  {
    "poem_id": 1639,
    "vorder": 23,
    "position": 0,
    "text": "بداد و دهش دل توانگر کنید"
  },
  {
    "poem_id": 1639,
    "vorder": 24,
    "position": 1,
    "text": "بر آزادگی بر سر افسر کنید"
  },
  {
    "poem_id": 1639,
    "vorder": 25,
    "position": 0,
    "text": "که فرجام هم روزمان بگذرد"
  },
  {
    "poem_id": 1639,
    "vorder": 26,
    "position": 1,
    "text": "زمانه پی ما همی بشمرد"
  },
  {
    "poem_id": 1639,
    "vorder": 27,
    "position": 0,
    "text": "سوی موبدان نامه‌ای همچنین"
  },
  {
    "poem_id": 1639,
    "vorder": 28,
    "position": 1,
    "text": "پرافروزش و پوزش و آفرین"
  },
  {
    "poem_id": 1639,
    "vorder": 29,
    "position": 0,
    "text": "سر نامه از پادشاه کیان"
  },
  {
    "poem_id": 1639,
    "vorder": 30,
    "position": 1,
    "text": "سوی کاردانان ایرانیان"
  },
  {
    "poem_id": 1639,
    "vorder": 31,
    "position": 0,
    "text": "چو عنبر سر خامهٔ چین بشست"
  },
  {
    "poem_id": 1639,
    "vorder": 32,
    "position": 1,
    "text": "سر نامه بود آفرین از نخست"
  },
  {
    "poem_id": 1639,
    "vorder": 33,
    "position": 0,
    "text": "بران دادگر کو جهان آفرید"
  },
  {
    "poem_id": 1639,
    "vorder": 34,
    "position": 1,
    "text": "پس از آشکارا نهان آفرید"
  },
  {
    "poem_id": 1639,
    "vorder": 35,
    "position": 0,
    "text": "دو گیتی پدید آمد از کاف و نون"
  },
  {
    "poem_id": 1639,
    "vorder": 36,
    "position": 1,
    "text": "چرانی به فرمان او در نه چون"
  },
  {
    "poem_id": 1639,
    "vorder": 37,
    "position": 0,
    "text": "سپهری برین سان که بینی روان"
  },
  {
    "poem_id": 1639,
    "vorder": 38,
    "position": 1,
    "text": "توانا و دانا جز او را مخوان"
  },
  {
    "poem_id": 1639,
    "vorder": 39,
    "position": 0,
    "text": "بباشد به فرمان او هرچ خواست"
  },
  {
    "poem_id": 1639,
    "vorder": 40,
    "position": 1,
    "text": "همه بندگانیم و او پادشاست"
  },
  {
    "poem_id": 1639,
    "vorder": 41,
    "position": 0,
    "text": "ازو باد بر نامداران درود"
  },
  {
    "poem_id": 1639,
    "vorder": 42,
    "position": 1,
    "text": "بر اندازهٔ هر یکی بر فزود"
  },
  {
    "poem_id": 1639,
    "vorder": 43,
    "position": 0,
    "text": "جز از نیک‌نامی و فرهنگ و داد"
  },
  {
    "poem_id": 1639,
    "vorder": 44,
    "position": 1,
    "text": "ز کردار گیتی مگیرید یاد"
  },
  {
    "poem_id": 1639,
    "vorder": 45,
    "position": 0,
    "text": "به پیروزی اندر غم آمد مرا"
  },
  {
    "poem_id": 1639,
    "vorder": 46,
    "position": 1,
    "text": "به سور اندرون ماتم آمد مرا"
  },
  {
    "poem_id": 1639,
    "vorder": 47,
    "position": 0,
    "text": "بدارندهٔ آفتاب بلند"
  },
  {
    "poem_id": 1639,
    "vorder": 48,
    "position": 1,
    "text": "که بر جان دارا نجستم گزند"
  },
  {
    "poem_id": 1639,
    "vorder": 49,
    "position": 0,
    "text": "مر آن شاه را دشمن از خانه بود"
  },
  {
    "poem_id": 1639,
    "vorder": 50,
    "position": 1,
    "text": "یکی بنده بودش نه بیگانه بود"
  },
  {
    "poem_id": 1639,
    "vorder": 51,
    "position": 0,
    "text": "کنون یافت بادافره ایزدی"
  },
  {
    "poem_id": 1639,
    "vorder": 52,
    "position": 1,
    "text": "چو بد ساخت آمد به رویش بدی"
  },
  {
    "poem_id": 1639,
    "vorder": 53,
    "position": 0,
    "text": "شما داد جویید و پیمان کنید"
  },
  {
    "poem_id": 1639,
    "vorder": 54,
    "position": 1,
    "text": "زبان را به پیمان گروگان کنید"
  },
  {
    "poem_id": 1639,
    "vorder": 55,
    "position": 0,
    "text": "چو خواهید کز چرخ یابید بخت"
  },
  {
    "poem_id": 1639,
    "vorder": 56,
    "position": 1,
    "text": "ز من بدره و برده و تاج و تخت"
  },
  {
    "poem_id": 1639,
    "vorder": 57,
    "position": 0,
    "text": "پر از درد داراست روشن دلم"
  },
  {
    "poem_id": 1639,
    "vorder": 58,
    "position": 1,
    "text": "بکوشم کز اندرز او نگسلم"
  },
  {
    "poem_id": 1639,
    "vorder": 59,
    "position": 0,
    "text": "هرانکس که آید بدین بارگاه"
  },
  {
    "poem_id": 1639,
    "vorder": 60,
    "position": 1,
    "text": "درم یابد و ارج و تخت و کلاه"
  },
  {
    "poem_id": 1639,
    "vorder": 61,
    "position": 0,
    "text": "چو خواهد که باشد به ایوان خویش"
  },
  {
    "poem_id": 1639,
    "vorder": 62,
    "position": 1,
    "text": "نگردد گریزان ز پیمان خویش"
  },
  {
    "poem_id": 1639,
    "vorder": 63,
    "position": 0,
    "text": "بیابند چیزی که خواهد ز گنج"
  },
  {
    "poem_id": 1639,
    "vorder": 64,
    "position": 1,
    "text": "ازان پس نبیند کسی درد و رنج"
  },
  {
    "poem_id": 1639,
    "vorder": 65,
    "position": 0,
    "text": "درم را به نام سکندر زنید"
  },
  {
    "poem_id": 1639,
    "vorder": 66,
    "position": 1,
    "text": "بکوشید و پیمان ما مشکنید"
  },
  {
    "poem_id": 1639,
    "vorder": 67,
    "position": 0,
    "text": "نشستنگه شهریاران خویش"
  },
  {
    "poem_id": 1639,
    "vorder": 68,
    "position": 1,
    "text": "بسازید زین پس به آیین پیش"
  },
  {
    "poem_id": 1639,
    "vorder": 69,
    "position": 0,
    "text": "مدارید بازار بی‌پاسبان"
  },
  {
    "poem_id": 1639,
    "vorder": 70,
    "position": 1,
    "text": "که راند همی نام من بر زبان"
  },
  {
    "poem_id": 1639,
    "vorder": 71,
    "position": 0,
    "text": "مدارید بی‌مرزبان مرز خویش"
  },
  {
    "poem_id": 1639,
    "vorder": 72,
    "position": 1,
    "text": "پدید آورید اندرین ارز خویش"
  },
  {
    "poem_id": 1639,
    "vorder": 73,
    "position": 0,
    "text": "بدان تا نباشد ز دزدان گزند"
  },
  {
    "poem_id": 1639,
    "vorder": 74,
    "position": 1,
    "text": "بمانید شادان‌دل و سودمند"
  },
  {
    "poem_id": 1639,
    "vorder": 75,
    "position": 0,
    "text": "ز هر شهر زیبا پرستنده‌ای"
  },
  {
    "poem_id": 1639,
    "vorder": 76,
    "position": 1,
    "text": "پر از شرم بیداردل بنده‌ای"
  },
  {
    "poem_id": 1639,
    "vorder": 77,
    "position": 0,
    "text": "که شاید به مشکوی زرین ما"
  },
  {
    "poem_id": 1639,
    "vorder": 78,
    "position": 1,
    "text": "بداند پرستیدن آیین ما"
  },
  {
    "poem_id": 1639,
    "vorder": 79,
    "position": 0,
    "text": "چنان کو برفتن نباشد دژم"
  },
  {
    "poem_id": 1639,
    "vorder": 80,
    "position": 1,
    "text": "نشاید که بر برده باشد ستم"
  },
  {
    "poem_id": 1639,
    "vorder": 81,
    "position": 0,
    "text": "فرستید سوی شبستان ما"
  },
  {
    "poem_id": 1639,
    "vorder": 82,
    "position": 1,
    "text": "به نزدیک خسروپرستان ما"
  },
  {
    "poem_id": 1639,
    "vorder": 83,
    "position": 0,
    "text": "غریبان که بر شهرها بگذرند"
  },
  {
    "poem_id": 1639,
    "vorder": 84,
    "position": 1,
    "text": "چماننده پای و لبان ناچرند"
  },
  {
    "poem_id": 1639,
    "vorder": 85,
    "position": 0,
    "text": "دل از عیب صافی و صوفی به نام"
  },
  {
    "poem_id": 1639,
    "vorder": 86,
    "position": 1,
    "text": "به دوریشی اندر دلی شادکام"
  },
  {
    "poem_id": 1639,
    "vorder": 87,
    "position": 0,
    "text": "ز خواهندگان نامشان سر کنید"
  },
  {
    "poem_id": 1639,
    "vorder": 88,
    "position": 1,
    "text": "شمار اندر آغاز دفتر کنید"
  },
  {
    "poem_id": 1639,
    "vorder": 89,
    "position": 0,
    "text": "هرآنکس که هست از شما مستمند"
  },
  {
    "poem_id": 1639,
    "vorder": 90,
    "position": 1,
    "text": "کجا یافت از کارداری گزند"
  },
  {
    "poem_id": 1639,
    "vorder": 91,
    "position": 0,
    "text": "دل و پشت بیدادگر بشکنید"
  },
  {
    "poem_id": 1639,
    "vorder": 92,
    "position": 1,
    "text": "همه بیخ و شاخش ز بن برکنید"
  },
  {
    "poem_id": 1639,
    "vorder": 93,
    "position": 0,
    "text": "نهادن بد و کار کردن بدوی"
  },
  {
    "poem_id": 1639,
    "vorder": 94,
    "position": 1,
    "text": "بیابم همان چون کنم جست و جوی"
  },
  {
    "poem_id": 1639,
    "vorder": 95,
    "position": 0,
    "text": "کنم زنده بر دار بدنام را"
  },
  {
    "poem_id": 1639,
    "vorder": 96,
    "position": 1,
    "text": "که گم کرد ز آغاز فرجام را"
  },
  {
    "poem_id": 1639,
    "vorder": 97,
    "position": 0,
    "text": "کسی کو ز فرمان ما بگذرد"
  },
  {
    "poem_id": 1639,
    "vorder": 98,
    "position": 1,
    "text": "به فرجام زان کار کیفر برد"
  },
  {
    "poem_id": 1639,
    "vorder": 99,
    "position": 0,
    "text": "چو نامه فرستاده شد برگرفت"
  },
  {
    "poem_id": 1639,
    "vorder": 100,
    "position": 1,
    "text": "جهانی به آرام در بر گرفت"
  },
  {
    "poem_id": 1639,
    "vorder": 101,
    "position": 0,
    "text": "ز کرمان بیامد به شهر صطخر"
  },
  {
    "poem_id": 1639,
    "vorder": 102,
    "position": 1,
    "text": "به سر بر نهاد آن کیی تاج فخر"
  },
  {
    "poem_id": 1639,
    "vorder": 103,
    "position": 0,
    "text": "تو راز جهان تا توانی مجوی"
  },
  {
    "poem_id": 1639,
    "vorder": 104,
    "position": 1,
    "text": "که او زود پیچد ز جوینده روی"
  }
]