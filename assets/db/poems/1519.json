[
  {
    "poem_id": 1519,
    "vorder": 1,
    "position": 0,
    "text": "چو نزدیک شد بیشه و جای گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 2,
    "position": 1,
    "text": "بپیچید میرین و مرد سترگ"
  },
  {
    "poem_id": 1519,
    "vorder": 3,
    "position": 0,
    "text": "به گشتاسپ بنمود به انگشت راست"
  },
  {
    "poem_id": 1519,
    "vorder": 4,
    "position": 1,
    "text": "که آن اژدها را نشیمن کجاست"
  },
  {
    "poem_id": 1519,
    "vorder": 5,
    "position": 0,
    "text": "وزو بازگشتند هر دو به‌درد"
  },
  {
    "poem_id": 1519,
    "vorder": 6,
    "position": 1,
    "text": "پر از خون دل و دیده پر آب زرد"
  },
  {
    "poem_id": 1519,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت هیشوی کان سرفراز"
  },
  {
    "poem_id": 1519,
    "vorder": 8,
    "position": 1,
    "text": "دلیرست و دانا و هم رزمساز"
  },
  {
    "poem_id": 1519,
    "vorder": 9,
    "position": 0,
    "text": "بترسم بروبر ز چنگال گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 10,
    "position": 1,
    "text": "که گردد تباه این جوان سترگ"
  },
  {
    "poem_id": 1519,
    "vorder": 11,
    "position": 0,
    "text": "چو گشتاسپ نزدیک آن بیشه شد"
  },
  {
    "poem_id": 1519,
    "vorder": 12,
    "position": 1,
    "text": "دل رزمسازش پر اندیشه شد"
  },
  {
    "poem_id": 1519,
    "vorder": 13,
    "position": 0,
    "text": "فرود آمد از بارهٔ سرفراز"
  },
  {
    "poem_id": 1519,
    "vorder": 14,
    "position": 1,
    "text": "به پیش جهاندار و بردش نماز"
  },
  {
    "poem_id": 1519,
    "vorder": 15,
    "position": 0,
    "text": "همی‌گفت ایا پاک پروردگار"
  },
  {
    "poem_id": 1519,
    "vorder": 16,
    "position": 1,
    "text": "فروزندهٔ گردش روزگار"
  },
  {
    "poem_id": 1519,
    "vorder": 17,
    "position": 0,
    "text": "تو باشی بدین بد مرا دستگیر"
  },
  {
    "poem_id": 1519,
    "vorder": 18,
    "position": 1,
    "text": "ببخشای بر جان لهراسپ پیر"
  },
  {
    "poem_id": 1519,
    "vorder": 19,
    "position": 0,
    "text": "که گر بر من این اژدهای بزرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 20,
    "position": 1,
    "text": "که خواند ورا ناخردمند گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 21,
    "position": 0,
    "text": "شود پادشاه چون پدر بشنود"
  },
  {
    "poem_id": 1519,
    "vorder": 22,
    "position": 1,
    "text": "خروشان شود زان سپس نغنود"
  },
  {
    "poem_id": 1519,
    "vorder": 23,
    "position": 0,
    "text": "بماند پر از درد چون بیهشان"
  },
  {
    "poem_id": 1519,
    "vorder": 24,
    "position": 1,
    "text": "به هر کس خروشان و جویا نشان"
  },
  {
    "poem_id": 1519,
    "vorder": 25,
    "position": 0,
    "text": "اگر من شوم زین بد دد ستوه"
  },
  {
    "poem_id": 1519,
    "vorder": 26,
    "position": 1,
    "text": "بپوشم سر از شرم پیش گروه"
  },
  {
    "poem_id": 1519,
    "vorder": 27,
    "position": 0,
    "text": "بگفت این و بر بارگی برنشست"
  },
  {
    "poem_id": 1519,
    "vorder": 28,
    "position": 1,
    "text": "خروشان و جوشان و تیغی به‌دست"
  },
  {
    "poem_id": 1519,
    "vorder": 29,
    "position": 0,
    "text": "کمانی به زه بر به بازو درون"
  },
  {
    "poem_id": 1519,
    "vorder": 30,
    "position": 1,
    "text": "همی‌رفت بیدار دل پر ز خون"
  },
  {
    "poem_id": 1519,
    "vorder": 31,
    "position": 0,
    "text": "ز ره چون به تنگ اندر آمد سوار"
  },
  {
    "poem_id": 1519,
    "vorder": 32,
    "position": 1,
    "text": "بغرید برسان ابر بهار"
  },
  {
    "poem_id": 1519,
    "vorder": 33,
    "position": 0,
    "text": "چو گرگ از در بیشه او را بدید"
  },
  {
    "poem_id": 1519,
    "vorder": 34,
    "position": 1,
    "text": "خروشی به ابر سیه برکشید"
  },
  {
    "poem_id": 1519,
    "vorder": 35,
    "position": 0,
    "text": "همی‌کند روی زمین را به چنگ"
  },
  {
    "poem_id": 1519,
    "vorder": 36,
    "position": 1,
    "text": "نه بر گونهٔ شیر و چنگ پلنگ"
  },
  {
    "poem_id": 1519,
    "vorder": 37,
    "position": 0,
    "text": "چو گشتاسپ آن اژدها را بدید"
  },
  {
    "poem_id": 1519,
    "vorder": 38,
    "position": 1,
    "text": "کمان را به زه کرد و اندر کشید"
  },
  {
    "poem_id": 1519,
    "vorder": 39,
    "position": 0,
    "text": "چو باد از برش تیرباران گرفت"
  },
  {
    "poem_id": 1519,
    "vorder": 40,
    "position": 1,
    "text": "کمان را چو ابر بهاران گرفت"
  },
  {
    "poem_id": 1519,
    "vorder": 41,
    "position": 0,
    "text": "دد از تیر گشتاسپی خسته شد"
  },
  {
    "poem_id": 1519,
    "vorder": 42,
    "position": 1,
    "text": "دلیریش با درد پیوسته شد"
  },
  {
    "poem_id": 1519,
    "vorder": 43,
    "position": 0,
    "text": "بیاسود و برخاست از جای گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 44,
    "position": 1,
    "text": "بیامد بسان هیون سترگ"
  },
  {
    "poem_id": 1519,
    "vorder": 45,
    "position": 0,
    "text": "سرو چون گوزنان به پیش اندرون"
  },
  {
    "poem_id": 1519,
    "vorder": 46,
    "position": 1,
    "text": "تن از زخم پر درد و دل پر ز خون"
  },
  {
    "poem_id": 1519,
    "vorder": 47,
    "position": 0,
    "text": "چو نزدیک اسپ اندر آمد ز راه"
  },
  {
    "poem_id": 1519,
    "vorder": 48,
    "position": 1,
    "text": "سرونی بزد بر سرین سیاه"
  },
  {
    "poem_id": 1519,
    "vorder": 49,
    "position": 0,
    "text": "که از خایه تا ناف او بردرید"
  },
  {
    "poem_id": 1519,
    "vorder": 50,
    "position": 1,
    "text": "جهان‌جوی تیغ از میان برکشید"
  },
  {
    "poem_id": 1519,
    "vorder": 51,
    "position": 0,
    "text": "پیاده بزد بر میان سرش"
  },
  {
    "poem_id": 1519,
    "vorder": 52,
    "position": 1,
    "text": "بدو نیم شد پشت و یال و برش"
  },
  {
    "poem_id": 1519,
    "vorder": 53,
    "position": 0,
    "text": "بیامد به پیش خداوند دد"
  },
  {
    "poem_id": 1519,
    "vorder": 54,
    "position": 1,
    "text": "خداوند هر دانش و نیک و بد"
  },
  {
    "poem_id": 1519,
    "vorder": 55,
    "position": 0,
    "text": "همی آفرین خواند بر کردگار"
  },
  {
    "poem_id": 1519,
    "vorder": 56,
    "position": 1,
    "text": "که ای آفرینندهٔ روزگار"
  },
  {
    "poem_id": 1519,
    "vorder": 57,
    "position": 0,
    "text": "تویی راه گم کرده را رهنمای"
  },
  {
    "poem_id": 1519,
    "vorder": 58,
    "position": 1,
    "text": "تویی برتر برترین یک خدای"
  },
  {
    "poem_id": 1519,
    "vorder": 59,
    "position": 0,
    "text": "همه کام و پیروزی از کام تست"
  },
  {
    "poem_id": 1519,
    "vorder": 60,
    "position": 1,
    "text": "همه فر و دانایی از نام تست"
  },
  {
    "poem_id": 1519,
    "vorder": 61,
    "position": 0,
    "text": "چو برگشت از جایگاه نماز"
  },
  {
    "poem_id": 1519,
    "vorder": 62,
    "position": 1,
    "text": "بکند آن دو دندان که بودش دراز"
  },
  {
    "poem_id": 1519,
    "vorder": 63,
    "position": 0,
    "text": "وزان بیشه تنها سر اندر کشید"
  },
  {
    "poem_id": 1519,
    "vorder": 64,
    "position": 1,
    "text": "همی‌رفت تا پیش دریا رسید"
  },
  {
    "poem_id": 1519,
    "vorder": 65,
    "position": 0,
    "text": "بر آب هیشوی و میرین به درد"
  },
  {
    "poem_id": 1519,
    "vorder": 66,
    "position": 1,
    "text": "نشسته زبان‌ها پر از یاد کرد"
  },
  {
    "poem_id": 1519,
    "vorder": 67,
    "position": 0,
    "text": "سخنشان ز گشتاسپ بود و ز گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 68,
    "position": 1,
    "text": "که زارا سوار دلیر و سترگ"
  },
  {
    "poem_id": 1519,
    "vorder": 69,
    "position": 0,
    "text": "که اکنون به رزمی بزرگ اندرست"
  },
  {
    "poem_id": 1519,
    "vorder": 70,
    "position": 1,
    "text": "دریده به چنگال گرگ اندرست"
  },
  {
    "poem_id": 1519,
    "vorder": 71,
    "position": 0,
    "text": "چو گشتاسپ آمد پیاده پدید"
  },
  {
    "poem_id": 1519,
    "vorder": 72,
    "position": 1,
    "text": "پر از خون و رخ چون گل شنبلید"
  },
  {
    "poem_id": 1519,
    "vorder": 73,
    "position": 0,
    "text": "چو دیدنش از جای برخاستند"
  },
  {
    "poem_id": 1519,
    "vorder": 74,
    "position": 1,
    "text": "به زاری خروشیدن آراستند"
  },
  {
    "poem_id": 1519,
    "vorder": 75,
    "position": 0,
    "text": "به زاری گرفتندش اندر کنار"
  },
  {
    "poem_id": 1519,
    "vorder": 76,
    "position": 1,
    "text": "رخان زرد و مژگان چو ابر بهار"
  },
  {
    "poem_id": 1519,
    "vorder": 77,
    "position": 0,
    "text": "که چون بود با گرگ پیکار تو"
  },
  {
    "poem_id": 1519,
    "vorder": 78,
    "position": 1,
    "text": "دل ما پر از خون بد از کار تو"
  },
  {
    "poem_id": 1519,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای نیک‌رای"
  },
  {
    "poem_id": 1519,
    "vorder": 80,
    "position": 1,
    "text": "به روم اندرون نیست بیم از خدای"
  },
  {
    "poem_id": 1519,
    "vorder": 81,
    "position": 0,
    "text": "بران سان یکی اژدهای دلیر"
  },
  {
    "poem_id": 1519,
    "vorder": 82,
    "position": 1,
    "text": "به کشور بمانند تا سال دیر"
  },
  {
    "poem_id": 1519,
    "vorder": 83,
    "position": 0,
    "text": "برآید جهانی شود زو هلاک"
  },
  {
    "poem_id": 1519,
    "vorder": 84,
    "position": 1,
    "text": "چه قیصر مر او را چه یک مشت خاک"
  },
  {
    "poem_id": 1519,
    "vorder": 85,
    "position": 0,
    "text": "به شمشیر سلمش زدم به دو نیم"
  },
  {
    "poem_id": 1519,
    "vorder": 86,
    "position": 1,
    "text": "سرآمد شما را همه ترس و بیم"
  },
  {
    "poem_id": 1519,
    "vorder": 87,
    "position": 0,
    "text": "شوید آن شگفتی ببینید گرم"
  },
  {
    "poem_id": 1519,
    "vorder": 88,
    "position": 1,
    "text": "کزان بیشتر کس ندیدست چرم"
  },
  {
    "poem_id": 1519,
    "vorder": 89,
    "position": 0,
    "text": "یکی ژنده پیل‌ست گویی به پوست"
  },
  {
    "poem_id": 1519,
    "vorder": 90,
    "position": 1,
    "text": "همه بیشه بالا و پهنای اوست"
  },
  {
    "poem_id": 1519,
    "vorder": 91,
    "position": 0,
    "text": "بران بیشه رفتند هر دو دوان"
  },
  {
    "poem_id": 1519,
    "vorder": 92,
    "position": 1,
    "text": "ز گفتار او شاد و روشن‌روان"
  },
  {
    "poem_id": 1519,
    "vorder": 93,
    "position": 0,
    "text": "بدیدند گرگی به بالای پیل"
  },
  {
    "poem_id": 1519,
    "vorder": 94,
    "position": 1,
    "text": "به چنگال شیران و همرنگ نیل"
  },
  {
    "poem_id": 1519,
    "vorder": 95,
    "position": 0,
    "text": "بدو زخم کرده ز سر تا به پای"
  },
  {
    "poem_id": 1519,
    "vorder": 96,
    "position": 1,
    "text": "دو شیر‌ست گویی فتاده به‌جای"
  },
  {
    "poem_id": 1519,
    "vorder": 97,
    "position": 0,
    "text": "چو دیدند کردند زو آفرین"
  },
  {
    "poem_id": 1519,
    "vorder": 98,
    "position": 1,
    "text": "بران فرمند آفتاب زمین"
  },
  {
    "poem_id": 1519,
    "vorder": 99,
    "position": 0,
    "text": "دلی شاد زان بیشه باز آمدند"
  },
  {
    "poem_id": 1519,
    "vorder": 100,
    "position": 1,
    "text": "بر شیر جنگی فراز آمدند"
  },
  {
    "poem_id": 1519,
    "vorder": 101,
    "position": 0,
    "text": "بسی هدیه آورد میرین برش"
  },
  {
    "poem_id": 1519,
    "vorder": 102,
    "position": 1,
    "text": "بر آن‌سان که بد مرد را در خورش"
  },
  {
    "poem_id": 1519,
    "vorder": 103,
    "position": 0,
    "text": "بجز دیگر اسپی نپذرفت زوی"
  },
  {
    "poem_id": 1519,
    "vorder": 104,
    "position": 1,
    "text": "وزانجا سوی خانه بنهاد روی"
  },
  {
    "poem_id": 1519,
    "vorder": 105,
    "position": 0,
    "text": "چو آمد ز دریا به آرام خویش"
  },
  {
    "poem_id": 1519,
    "vorder": 106,
    "position": 1,
    "text": "کتایون بینادلش رفت پیش"
  },
  {
    "poem_id": 1519,
    "vorder": 107,
    "position": 0,
    "text": "بدو گفت جوشن کجا یافتی"
  },
  {
    "poem_id": 1519,
    "vorder": 108,
    "position": 1,
    "text": "کز ایدر به نخچیر بشتافتی"
  },
  {
    "poem_id": 1519,
    "vorder": 109,
    "position": 0,
    "text": "چنین داد پاسخ که از شهر من"
  },
  {
    "poem_id": 1519,
    "vorder": 110,
    "position": 1,
    "text": "بیامد یکی نامور انجمن"
  },
  {
    "poem_id": 1519,
    "vorder": 111,
    "position": 0,
    "text": "مرا هدیه این جوشن و تیغ و خود"
  },
  {
    "poem_id": 1519,
    "vorder": 112,
    "position": 1,
    "text": "بدادند و چندی ز خویشان درود"
  },
  {
    "poem_id": 1519,
    "vorder": 113,
    "position": 0,
    "text": "کتایون می‌ آورد همچون گلاب"
  },
  {
    "poem_id": 1519,
    "vorder": 114,
    "position": 1,
    "text": "همی‌خورد با شوی تا گاه خواب"
  },
  {
    "poem_id": 1519,
    "vorder": 115,
    "position": 0,
    "text": "بخفتند شادان دو اختر گرای"
  },
  {
    "poem_id": 1519,
    "vorder": 116,
    "position": 1,
    "text": "جوانمرد هزمان بجستی ز جای"
  },
  {
    "poem_id": 1519,
    "vorder": 117,
    "position": 0,
    "text": "بدیدی به خواب اندرون رزم گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 118,
    "position": 1,
    "text": "به کردار نر اژدهای سترگ"
  },
  {
    "poem_id": 1519,
    "vorder": 119,
    "position": 0,
    "text": "کتایون بدو گفت امشب چه بود"
  },
  {
    "poem_id": 1519,
    "vorder": 120,
    "position": 1,
    "text": "که هزمان بترسی چنین نابسود"
  },
  {
    "poem_id": 1519,
    "vorder": 121,
    "position": 0,
    "text": "چنین داد پاسخ که من تخت خویش"
  },
  {
    "poem_id": 1519,
    "vorder": 122,
    "position": 1,
    "text": "بدیدم به خواب اختر و بخت خویش"
  },
  {
    "poem_id": 1519,
    "vorder": 123,
    "position": 0,
    "text": "کتایون بدانست کو را نژاد"
  },
  {
    "poem_id": 1519,
    "vorder": 124,
    "position": 1,
    "text": "ز شاهی بود یک‌دل و یک‌نهاد"
  },
  {
    "poem_id": 1519,
    "vorder": 125,
    "position": 0,
    "text": "بزرگست و با او نگوید همی"
  },
  {
    "poem_id": 1519,
    "vorder": 126,
    "position": 1,
    "text": "ز قیصر بلندی نجوید همی"
  },
  {
    "poem_id": 1519,
    "vorder": 127,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای ماهروی"
  },
  {
    "poem_id": 1519,
    "vorder": 128,
    "position": 1,
    "text": "سمن‌خد و سیمین‌بر و مشکبوی"
  },
  {
    "poem_id": 1519,
    "vorder": 129,
    "position": 0,
    "text": "بیارای تا ما به ایران شویم"
  },
  {
    "poem_id": 1519,
    "vorder": 130,
    "position": 1,
    "text": "از ایدر به جای دلیران شویم"
  },
  {
    "poem_id": 1519,
    "vorder": 131,
    "position": 0,
    "text": "ببینی بر و بوم فرخنده را"
  },
  {
    "poem_id": 1519,
    "vorder": 132,
    "position": 1,
    "text": "همان شاه با داد و بخشنده را"
  },
  {
    "poem_id": 1519,
    "vorder": 133,
    "position": 0,
    "text": "کتایون بدو گفت خیره مگوی"
  },
  {
    "poem_id": 1519,
    "vorder": 134,
    "position": 1,
    "text": "به تیزی چنین راه رفتن مجوی"
  },
  {
    "poem_id": 1519,
    "vorder": 135,
    "position": 0,
    "text": "چو ز ایدر به رفتن نهی روی را"
  },
  {
    "poem_id": 1519,
    "vorder": 136,
    "position": 1,
    "text": "هم آواز کن پیش هیشوی را"
  },
  {
    "poem_id": 1519,
    "vorder": 137,
    "position": 0,
    "text": "مگر بگذراند به کشتی ترا"
  },
  {
    "poem_id": 1519,
    "vorder": 138,
    "position": 1,
    "text": "جهان تازه شد چون گذشتی ترا"
  },
  {
    "poem_id": 1519,
    "vorder": 139,
    "position": 0,
    "text": "من ایدر بمانم به رنج دراز"
  },
  {
    "poem_id": 1519,
    "vorder": 140,
    "position": 1,
    "text": "ندانم که کی بینمت نیز باز"
  },
  {
    "poem_id": 1519,
    "vorder": 141,
    "position": 0,
    "text": "به نارفته در جامه گریان شدند"
  },
  {
    "poem_id": 1519,
    "vorder": 142,
    "position": 1,
    "text": "بران آتش درد بریان شدند"
  },
  {
    "poem_id": 1519,
    "vorder": 143,
    "position": 0,
    "text": "چو از چرخ بفروخت گردنده شید"
  },
  {
    "poem_id": 1519,
    "vorder": 144,
    "position": 1,
    "text": "جوانان بیداردل پر امید"
  },
  {
    "poem_id": 1519,
    "vorder": 145,
    "position": 0,
    "text": "ازان خانهٔ بزم برخاستند"
  },
  {
    "poem_id": 1519,
    "vorder": 146,
    "position": 1,
    "text": "ز هر گونه‌ای گفتن آراستند"
  },
  {
    "poem_id": 1519,
    "vorder": 147,
    "position": 0,
    "text": "که تا چون شود بر سر ما سپهر"
  },
  {
    "poem_id": 1519,
    "vorder": 148,
    "position": 1,
    "text": "به تندی گذارد جهان گر به مهر"
  },
  {
    "poem_id": 1519,
    "vorder": 149,
    "position": 0,
    "text": "وزان روی چون باد میرین برفت"
  },
  {
    "poem_id": 1519,
    "vorder": 150,
    "position": 1,
    "text": "به نزدیک قیصر خرامید تفت"
  },
  {
    "poem_id": 1519,
    "vorder": 151,
    "position": 0,
    "text": "چنین گفت کای نامدار بزرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 152,
    "position": 1,
    "text": "به پایان رسید آن زیان‌های گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 153,
    "position": 0,
    "text": "همه بیشه سرتابسر اژدهاست"
  },
  {
    "poem_id": 1519,
    "vorder": 154,
    "position": 1,
    "text": "تو نیز ار شگفتی ببینی رواست"
  },
  {
    "poem_id": 1519,
    "vorder": 155,
    "position": 0,
    "text": "بیامد دمان کرد آهنگ من"
  },
  {
    "poem_id": 1519,
    "vorder": 156,
    "position": 1,
    "text": "یکی خنجری یافت از چنگ من"
  },
  {
    "poem_id": 1519,
    "vorder": 157,
    "position": 0,
    "text": "ز سر تا میانش بدو نیم شد"
  },
  {
    "poem_id": 1519,
    "vorder": 158,
    "position": 1,
    "text": "دل دیو زان زخم پر بیم شد"
  },
  {
    "poem_id": 1519,
    "vorder": 159,
    "position": 0,
    "text": "ببالید قیصر ز گفتار اوی"
  },
  {
    "poem_id": 1519,
    "vorder": 160,
    "position": 1,
    "text": "برافروخت پژمرده رخسار اوی"
  },
  {
    "poem_id": 1519,
    "vorder": 161,
    "position": 0,
    "text": "بفرمود تا گاو گردون برند"
  },
  {
    "poem_id": 1519,
    "vorder": 162,
    "position": 1,
    "text": "سراپرده از شهر بیرون برند"
  },
  {
    "poem_id": 1519,
    "vorder": 163,
    "position": 0,
    "text": "یکی بزمگاهی بیاراستند"
  },
  {
    "poem_id": 1519,
    "vorder": 164,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1519,
    "vorder": 165,
    "position": 0,
    "text": "ببردند گاوان گردون کشان"
  },
  {
    "poem_id": 1519,
    "vorder": 166,
    "position": 1,
    "text": "بران بیشه کز گرگ بودی نشان"
  },
  {
    "poem_id": 1519,
    "vorder": 167,
    "position": 0,
    "text": "برفتند و دیدند پیلی ژیان"
  },
  {
    "poem_id": 1519,
    "vorder": 168,
    "position": 1,
    "text": "به خنجر بریده ز سر تا میان"
  },
  {
    "poem_id": 1519,
    "vorder": 169,
    "position": 0,
    "text": "چو بیرون کشیدندش از مرغزار"
  },
  {
    "poem_id": 1519,
    "vorder": 170,
    "position": 1,
    "text": "به گاوان گردون‌کش تاودار"
  },
  {
    "poem_id": 1519,
    "vorder": 171,
    "position": 0,
    "text": "جهانی نظاره بران پیر گرگ"
  },
  {
    "poem_id": 1519,
    "vorder": 172,
    "position": 1,
    "text": "چه گرگ آن ژیان نره شیر سترگ"
  },
  {
    "poem_id": 1519,
    "vorder": 173,
    "position": 0,
    "text": "چو قیصر بدید آن تن پیل مست"
  },
  {
    "poem_id": 1519,
    "vorder": 174,
    "position": 1,
    "text": "ز شادی بسی دست بر زد به‌دست"
  },
  {
    "poem_id": 1519,
    "vorder": 175,
    "position": 0,
    "text": "همان روز قیصر سقف را بخواند"
  },
  {
    "poem_id": 1519,
    "vorder": 176,
    "position": 1,
    "text": "به ایوان و دختر به میرین رساند"
  },
  {
    "poem_id": 1519,
    "vorder": 177,
    "position": 0,
    "text": "نوشتند نامه به‌هر کشوری"
  },
  {
    "poem_id": 1519,
    "vorder": 178,
    "position": 1,
    "text": "سکوبا و بطریق و هر مهتری"
  },
  {
    "poem_id": 1519,
    "vorder": 179,
    "position": 0,
    "text": "که میرین شیر آن سرافراز روم"
  },
  {
    "poem_id": 1519,
    "vorder": 180,
    "position": 1,
    "text": "ز گرگ دلاور تهی کرد بوم"
  }
]