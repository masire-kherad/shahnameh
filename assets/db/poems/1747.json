[
  {
    "poem_id": 1747,
    "vorder": 1,
    "position": 0,
    "text": "ز شاهیش بگذشت پنجاه سال"
  },
  {
    "poem_id": 1747,
    "vorder": 2,
    "position": 1,
    "text": "که اندر زمانه نبودش همال"
  },
  {
    "poem_id": 1747,
    "vorder": 3,
    "position": 0,
    "text": "بیامد یکی مرد گویا ز چین"
  },
  {
    "poem_id": 1747,
    "vorder": 4,
    "position": 1,
    "text": "که چون او مصور نبیند زمین"
  },
  {
    "poem_id": 1747,
    "vorder": 5,
    "position": 0,
    "text": "بدان چربه دستی رسیده به کام"
  },
  {
    "poem_id": 1747,
    "vorder": 6,
    "position": 1,
    "text": "یکی برمنش مرد مانی به نام"
  },
  {
    "poem_id": 1747,
    "vorder": 7,
    "position": 0,
    "text": "به صورتگری گفت پیغمبرم"
  },
  {
    "poem_id": 1747,
    "vorder": 8,
    "position": 1,
    "text": "ز دین‌آوران جهان برترم"
  },
  {
    "poem_id": 1747,
    "vorder": 9,
    "position": 0,
    "text": "ز چین نزد شاپور شد بار خواست"
  },
  {
    "poem_id": 1747,
    "vorder": 10,
    "position": 1,
    "text": "به پیغمبری شاه را یار خواست"
  },
  {
    "poem_id": 1747,
    "vorder": 11,
    "position": 0,
    "text": "سخن گفت مرد گشاده‌زبان"
  },
  {
    "poem_id": 1747,
    "vorder": 12,
    "position": 1,
    "text": "جهاندار شد زان سخن بدگمان"
  },
  {
    "poem_id": 1747,
    "vorder": 13,
    "position": 0,
    "text": "سرش تیز شد موبدان را بخواند"
  },
  {
    "poem_id": 1747,
    "vorder": 14,
    "position": 1,
    "text": "زمانی فراوان سخنها براند"
  },
  {
    "poem_id": 1747,
    "vorder": 15,
    "position": 0,
    "text": "کزین مرد چینی و چیره‌زبان"
  },
  {
    "poem_id": 1747,
    "vorder": 16,
    "position": 1,
    "text": "فتادستم از دین او در گمان"
  },
  {
    "poem_id": 1747,
    "vorder": 17,
    "position": 0,
    "text": "بگویید و هم زو سخن بشنوید"
  },
  {
    "poem_id": 1747,
    "vorder": 18,
    "position": 1,
    "text": "مگر خود به گفتار او بگروید"
  },
  {
    "poem_id": 1747,
    "vorder": 19,
    "position": 0,
    "text": "بگفتند کین مرد صورت پرست"
  },
  {
    "poem_id": 1747,
    "vorder": 20,
    "position": 1,
    "text": "نه بر مایهٔ موبدان موبه دست"
  },
  {
    "poem_id": 1747,
    "vorder": 21,
    "position": 0,
    "text": "زمانی سخن بشنو او را بخوان"
  },
  {
    "poem_id": 1747,
    "vorder": 22,
    "position": 1,
    "text": "چو بیند ورا کی گشاید زبان"
  },
  {
    "poem_id": 1747,
    "vorder": 23,
    "position": 0,
    "text": "بفرمود تا موبد آمدش پیش"
  },
  {
    "poem_id": 1747,
    "vorder": 24,
    "position": 1,
    "text": "سخن گفت با او ز اندازه بیش"
  },
  {
    "poem_id": 1747,
    "vorder": 25,
    "position": 0,
    "text": "فرو ماند مانی میان سخن"
  },
  {
    "poem_id": 1747,
    "vorder": 26,
    "position": 1,
    "text": "به گفتار موبد ز دین کهن"
  },
  {
    "poem_id": 1747,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت کای مرد صورت پرست"
  },
  {
    "poem_id": 1747,
    "vorder": 28,
    "position": 1,
    "text": "به یزدان چرا آختی خیره‌دست"
  },
  {
    "poem_id": 1747,
    "vorder": 29,
    "position": 0,
    "text": "کسی کو بلند آسمان آفرید"
  },
  {
    "poem_id": 1747,
    "vorder": 30,
    "position": 1,
    "text": "بدو در مکان و زمان آفرید"
  },
  {
    "poem_id": 1747,
    "vorder": 31,
    "position": 0,
    "text": "کجا نور و ظلمت بدو اندرست"
  },
  {
    "poem_id": 1747,
    "vorder": 32,
    "position": 1,
    "text": "ز هر گوهری گوهرش برترست"
  },
  {
    "poem_id": 1747,
    "vorder": 33,
    "position": 0,
    "text": "شب و روز و گردان سپهر بلند"
  },
  {
    "poem_id": 1747,
    "vorder": 34,
    "position": 1,
    "text": "کزویت پناهست و زویت گزند"
  },
  {
    "poem_id": 1747,
    "vorder": 35,
    "position": 0,
    "text": "همه کردهٔ کردگارست و بس"
  },
  {
    "poem_id": 1747,
    "vorder": 36,
    "position": 1,
    "text": "جزو کرد نتواند این کرده کس"
  },
  {
    "poem_id": 1747,
    "vorder": 37,
    "position": 0,
    "text": "به برهان صورت چرا بگروی"
  },
  {
    "poem_id": 1747,
    "vorder": 38,
    "position": 1,
    "text": "همی پند دین‌آوران نشنوی"
  },
  {
    "poem_id": 1747,
    "vorder": 39,
    "position": 0,
    "text": "همه جفت و همتا و یزدان یکیست"
  },
  {
    "poem_id": 1747,
    "vorder": 40,
    "position": 1,
    "text": "جز از بندگی کردنت رای نیست"
  },
  {
    "poem_id": 1747,
    "vorder": 41,
    "position": 0,
    "text": "گرین صورت کرده جنبان کنی"
  },
  {
    "poem_id": 1747,
    "vorder": 42,
    "position": 1,
    "text": "سزد گر ز جنبده برهان کنی"
  },
  {
    "poem_id": 1747,
    "vorder": 43,
    "position": 0,
    "text": "ندانی که برهان نیاید به کار"
  },
  {
    "poem_id": 1747,
    "vorder": 44,
    "position": 1,
    "text": "ندارد کسی این سخن استوار"
  },
  {
    "poem_id": 1747,
    "vorder": 45,
    "position": 0,
    "text": "اگر اهرمن جفت یزدان بدی"
  },
  {
    "poem_id": 1747,
    "vorder": 46,
    "position": 1,
    "text": "شب تیره چون روز خندان بدی"
  },
  {
    "poem_id": 1747,
    "vorder": 47,
    "position": 0,
    "text": "همه ساله بودی شب و روز راست"
  },
  {
    "poem_id": 1747,
    "vorder": 48,
    "position": 1,
    "text": "به گردش فزونی نبودی نه کاست"
  },
  {
    "poem_id": 1747,
    "vorder": 49,
    "position": 0,
    "text": "نگنجد جهان‌آفرین در گمان"
  },
  {
    "poem_id": 1747,
    "vorder": 50,
    "position": 1,
    "text": "که او برترست از زمان و مکان"
  },
  {
    "poem_id": 1747,
    "vorder": 51,
    "position": 0,
    "text": "سخنهای دیوانگانست و بس"
  },
  {
    "poem_id": 1747,
    "vorder": 52,
    "position": 1,
    "text": "بدین‌بر نباشد ترا یار کس"
  },
  {
    "poem_id": 1747,
    "vorder": 53,
    "position": 0,
    "text": "سخنها جزین نیز بسیار گفت"
  },
  {
    "poem_id": 1747,
    "vorder": 54,
    "position": 1,
    "text": "که با دانش و مردمی بود جفت"
  },
  {
    "poem_id": 1747,
    "vorder": 55,
    "position": 0,
    "text": "فرو ماند مانی ز گفتار اوی"
  },
  {
    "poem_id": 1747,
    "vorder": 56,
    "position": 1,
    "text": "بپژمرد شاداب بازار اوی"
  },
  {
    "poem_id": 1747,
    "vorder": 57,
    "position": 0,
    "text": "ز مانی برآشفت پس شهریار"
  },
  {
    "poem_id": 1747,
    "vorder": 58,
    "position": 1,
    "text": "برو تنگ شد گردش روزگار"
  },
  {
    "poem_id": 1747,
    "vorder": 59,
    "position": 0,
    "text": "بفرمود پس تاش برداشتند"
  },
  {
    "poem_id": 1747,
    "vorder": 60,
    "position": 1,
    "text": "به خواری ز درگاه بگذاشتند"
  },
  {
    "poem_id": 1747,
    "vorder": 61,
    "position": 0,
    "text": "چنین گفت کاین مرد صورت‌پرست"
  },
  {
    "poem_id": 1747,
    "vorder": 62,
    "position": 1,
    "text": "نگنجد همی در سرای نشست"
  },
  {
    "poem_id": 1747,
    "vorder": 63,
    "position": 0,
    "text": "چو آشوب و آرام گیتی به دوست"
  },
  {
    "poem_id": 1747,
    "vorder": 64,
    "position": 1,
    "text": "بباید کشیدن سراپاش پوست"
  },
  {
    "poem_id": 1747,
    "vorder": 65,
    "position": 0,
    "text": "همان خامش آگنده باید به کاه"
  },
  {
    "poem_id": 1747,
    "vorder": 66,
    "position": 1,
    "text": "بدان تا نجوید کس این پایگاه"
  },
  {
    "poem_id": 1747,
    "vorder": 67,
    "position": 0,
    "text": "بیاویختند از در شارستان"
  },
  {
    "poem_id": 1747,
    "vorder": 68,
    "position": 1,
    "text": "دگر پیش دیوار بیمارستان"
  },
  {
    "poem_id": 1747,
    "vorder": 69,
    "position": 0,
    "text": "جهانی برو آفرین خواندند"
  },
  {
    "poem_id": 1747,
    "vorder": 70,
    "position": 1,
    "text": "همی خاک بر کشته افشاندند"
  }
]