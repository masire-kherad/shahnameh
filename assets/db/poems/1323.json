[
  {
    "poem_id": 1323,
    "vorder": 1,
    "position": 0,
    "text": "از آغاز باید که دانی دُرُست"
  },
  {
    "poem_id": 1323,
    "vorder": 2,
    "position": 1,
    "text": "سَرِ مایهٔ گوهَران از نُخُست"
  },
  {
    "poem_id": 1323,
    "vorder": 3,
    "position": 0,
    "text": "که یَزدان زِ ناچیز چیز آفرید"
  },
  {
    "poem_id": 1323,
    "vorder": 4,
    "position": 1,
    "text": "بِدان تا توانایی آرَد پَدید"
  },
  {
    "poem_id": 1323,
    "vorder": 5,
    "position": 0,
    "text": "سَرِ مایهٔ گوهران این چهار"
  },
  {
    "poem_id": 1323,
    "vorder": 6,
    "position": 1,
    "text": "بَرآوَرده بی‌رَنج و بی‌روزگار"
  },
  {
    "poem_id": 1323,
    "vorder": 7,
    "position": 0,
    "text": "یکی آتشی بَر شُده تابناک"
  },
  {
    "poem_id": 1323,
    "vorder": 8,
    "position": 1,
    "text": "میان آب و باد از بَرِ تیره خاک"
  },
  {
    "poem_id": 1323,
    "vorder": 9,
    "position": 0,
    "text": "نخُستین که آتش به جُنبش دَمید"
  },
  {
    "poem_id": 1323,
    "vorder": 10,
    "position": 1,
    "text": "زِ گرمیش پَس خُشکی آمد پَدید"
  },
  {
    "poem_id": 1323,
    "vorder": 11,
    "position": 0,
    "text": "و زان پَس زِ آرام سَردی نُمود"
  },
  {
    "poem_id": 1323,
    "vorder": 12,
    "position": 1,
    "text": "زِ سَردی هَمان باز تَری فُزود"
  },
  {
    "poem_id": 1323,
    "vorder": 13,
    "position": 0,
    "text": "چو این چار گوهَر به جای آمدند"
  },
  {
    "poem_id": 1323,
    "vorder": 14,
    "position": 1,
    "text": "زِ بَهرِ سِپَنجی سَرای آمدند"
  },
  {
    "poem_id": 1323,
    "vorder": 15,
    "position": 0,
    "text": "گُهرها یِک اَندر دِگَر ساخته"
  },
  {
    "poem_id": 1323,
    "vorder": 16,
    "position": 1,
    "text": "زِ هَر گونه گَردن بَراَفراخته"
  },
  {
    "poem_id": 1323,
    "vorder": 17,
    "position": 0,
    "text": "پَدید آمد این گُنبدِ تیز رو"
  },
  {
    "poem_id": 1323,
    "vorder": 18,
    "position": 1,
    "text": "شگفتی نمایندهٔ نو به‌ نو"
  },
  {
    "poem_id": 1323,
    "vorder": 19,
    "position": 0,
    "text": "اَبَر دَه و دو هَفت شُد کَدخُدای"
  },
  {
    "poem_id": 1323,
    "vorder": 20,
    "position": 1,
    "text": "گرفتند هَر یِک سزاوار جای"
  },
  {
    "poem_id": 1323,
    "vorder": 21,
    "position": 0,
    "text": "دَرِ بَخشش و دادن آمد پَدید"
  },
  {
    "poem_id": 1323,
    "vorder": 22,
    "position": 1,
    "text": "ببخشید دانا چُنان چون سَزید"
  },
  {
    "poem_id": 1323,
    "vorder": 23,
    "position": 0,
    "text": "فلک‌ها یِک اَندر دِگَر بَسته شُد"
  },
  {
    "poem_id": 1323,
    "vorder": 24,
    "position": 1,
    "text": "بِجُنبید چون کار پیوسته شُد"
  },
  {
    "poem_id": 1323,
    "vorder": 25,
    "position": 0,
    "text": "چو دریا و چون کوه و چون دَشت و راغ"
  },
  {
    "poem_id": 1323,
    "vorder": 26,
    "position": 1,
    "text": "زَمین شُد به کِردارِ روشَن چراغ"
  },
  {
    "poem_id": 1323,
    "vorder": 27,
    "position": 0,
    "text": "بِبالید کوه آب‌ها بَر دَمید"
  },
  {
    "poem_id": 1323,
    "vorder": 28,
    "position": 1,
    "text": "سَرِ رُستَنی سوی بالا کشید"
  },
  {
    "poem_id": 1323,
    "vorder": 29,
    "position": 0,
    "text": "زمین را بُلندی نَبُد جایگاه"
  },
  {
    "poem_id": 1323,
    "vorder": 30,
    "position": 1,
    "text": "یکی مَرکزی تیره بود و سیاه"
  },
  {
    "poem_id": 1323,
    "vorder": 31,
    "position": 0,
    "text": "ستاره بَر او بَرشِگِفتی نُمود"
  },
  {
    "poem_id": 1323,
    "vorder": 32,
    "position": 1,
    "text": "به خاک اَندرون روشنایی فُزود"
  },
  {
    "poem_id": 1323,
    "vorder": 33,
    "position": 0,
    "text": "هَمی بَر شُد آتش فُرود آمد آب"
  },
  {
    "poem_id": 1323,
    "vorder": 34,
    "position": 1,
    "text": "هَمی گَشت گِردِ زمین آفتاب"
  },
  {
    "poem_id": 1323,
    "vorder": 35,
    "position": 0,
    "text": "گیا رُست با چَند گونه درخت"
  },
  {
    "poem_id": 1323,
    "vorder": 36,
    "position": 1,
    "text": "به زیر اَندر آمد سَران‌شان زِ بَخت"
  },
  {
    "poem_id": 1323,
    "vorder": 37,
    "position": 0,
    "text": "بِبالَد نَدارد جُز این نیرویی"
  },
  {
    "poem_id": 1323,
    "vorder": 38,
    "position": 1,
    "text": "نپویَد چو پویَندگان هَر سویی"
  },
  {
    "poem_id": 1323,
    "vorder": 39,
    "position": 0,
    "text": "و زان پَس چو جُنبَنده آمد پَدید"
  },
  {
    "poem_id": 1323,
    "vorder": 40,
    "position": 1,
    "text": "همه رُستَنی زیرِ خویش آورید"
  },
  {
    "poem_id": 1323,
    "vorder": 41,
    "position": 0,
    "text": "خور و خواب و آرام جوید هَمی"
  },
  {
    "poem_id": 1323,
    "vorder": 42,
    "position": 1,
    "text": "و زان زندگی کام جوید هَمی"
  },
  {
    "poem_id": 1323,
    "vorder": 43,
    "position": 0,
    "text": "نه گویا زَبان وُ نه جویا خِرَد"
  },
  {
    "poem_id": 1323,
    "vorder": 44,
    "position": 1,
    "text": "زِ خاک و زِ خاشاک تَن پَروَرَد"
  },
  {
    "poem_id": 1323,
    "vorder": 45,
    "position": 0,
    "text": "نَداند بَد و نیکِ فرجامِ کار"
  },
  {
    "poem_id": 1323,
    "vorder": 46,
    "position": 1,
    "text": "نخواهد از او بَندگی کِردگار"
  },
  {
    "poem_id": 1323,
    "vorder": 47,
    "position": 0,
    "text": "چو دانا تَوانا بُد و دادگَر"
  },
  {
    "poem_id": 1323,
    "vorder": 48,
    "position": 1,
    "text": "از ایرا نکرد ایچ پنهان هنر"
  },
  {
    "poem_id": 1323,
    "vorder": 49,
    "position": 0,
    "text": "چُنین است فَرجامِ کارِ جَهان"
  },
  {
    "poem_id": 1323,
    "vorder": 50,
    "position": 1,
    "text": "نَداند کسی آشکار و نهان"
  }
]