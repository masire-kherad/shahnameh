[
  {
    "poem_id": 87956,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید بنمود بالای خویش"
  },
  {
    "poem_id": 87956,
    "vorder": 2,
    "position": 1,
    "text": "نشست از بر تند بالای خویش"
  },
  {
    "poem_id": 87956,
    "vorder": 3,
    "position": 0,
    "text": "بزیر اندر آورد برج بره"
  },
  {
    "poem_id": 87956,
    "vorder": 4,
    "position": 1,
    "text": "چنین تا زمین زرد شد یکسره"
  },
  {
    "poem_id": 87956,
    "vorder": 5,
    "position": 0,
    "text": "تبیره برآمد ز درگاه طوس"
  },
  {
    "poem_id": 87956,
    "vorder": 6,
    "position": 1,
    "text": "همان نالهٔ بوق و آوای کوس"
  },
  {
    "poem_id": 87956,
    "vorder": 7,
    "position": 0,
    "text": "ز کشور برآمد سراسر خروش"
  },
  {
    "poem_id": 87956,
    "vorder": 8,
    "position": 1,
    "text": "زمین پرخروش و هوا پر ز جوش"
  },
  {
    "poem_id": 87956,
    "vorder": 9,
    "position": 0,
    "text": "از آواز اسپان و گرد سپاه"
  },
  {
    "poem_id": 87956,
    "vorder": 10,
    "position": 1,
    "text": "بشد قیرگون روی خورشید و ماه"
  },
  {
    "poem_id": 87956,
    "vorder": 11,
    "position": 0,
    "text": "ز چاک سلیح و ز آوای پیل"
  },
  {
    "poem_id": 87956,
    "vorder": 12,
    "position": 1,
    "text": "تو گفتی بیاگند گیتی به نیل"
  },
  {
    "poem_id": 87956,
    "vorder": 13,
    "position": 0,
    "text": "هوا سرخ و زرد و کبود و بنفش"
  },
  {
    "poem_id": 87956,
    "vorder": 14,
    "position": 1,
    "text": "ز تابیدن کاویانی درفش"
  },
  {
    "poem_id": 87956,
    "vorder": 15,
    "position": 0,
    "text": "بگردش سواران گودرزیان"
  },
  {
    "poem_id": 87956,
    "vorder": 16,
    "position": 1,
    "text": "میان اندرون اختر کاویان"
  },
  {
    "poem_id": 87956,
    "vorder": 17,
    "position": 0,
    "text": "سپهدار با افسر و گرز و نای"
  },
  {
    "poem_id": 87956,
    "vorder": 18,
    "position": 1,
    "text": "بیامد ز بالای پرده‌سرای"
  },
  {
    "poem_id": 87956,
    "vorder": 19,
    "position": 0,
    "text": "بشد طوس با کاویانی درفش"
  },
  {
    "poem_id": 87956,
    "vorder": 20,
    "position": 1,
    "text": "بپای اندرون کرده زرینه کفش"
  },
  {
    "poem_id": 87956,
    "vorder": 21,
    "position": 0,
    "text": "یکی پیل پیکر درفش از برش"
  },
  {
    "poem_id": 87956,
    "vorder": 22,
    "position": 1,
    "text": "بابر اندر آورده تابان سرش"
  },
  {
    "poem_id": 87956,
    "vorder": 23,
    "position": 0,
    "text": "بزرگان که با طوق و افسر بدند"
  },
  {
    "poem_id": 87956,
    "vorder": 24,
    "position": 1,
    "text": "جهانجوی وز تخم نوذر بدند"
  },
  {
    "poem_id": 87956,
    "vorder": 25,
    "position": 0,
    "text": "برفتند یکسر چو کوهی سیاه"
  },
  {
    "poem_id": 87956,
    "vorder": 26,
    "position": 1,
    "text": "گرازان و تازان بنزدیک شاه"
  },
  {
    "poem_id": 87956,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود تا نامداران گرد"
  },
  {
    "poem_id": 87956,
    "vorder": 28,
    "position": 1,
    "text": "ز لشکر سپهبد سوی شاه برد"
  },
  {
    "poem_id": 87956,
    "vorder": 29,
    "position": 0,
    "text": "چو لشکر همه نزد شاه آمدند"
  },
  {
    "poem_id": 87956,
    "vorder": 30,
    "position": 1,
    "text": "دمان با درفش و کلاه آمدند"
  },
  {
    "poem_id": 87956,
    "vorder": 31,
    "position": 0,
    "text": "بدیشان چنین گفت بیدار شاه"
  },
  {
    "poem_id": 87956,
    "vorder": 32,
    "position": 1,
    "text": "که طوس سپهبد به پیش سپاه"
  },
  {
    "poem_id": 87956,
    "vorder": 33,
    "position": 0,
    "text": "بپایست با اختر کاویان"
  },
  {
    "poem_id": 87956,
    "vorder": 34,
    "position": 1,
    "text": "بفرمان او بست باید میان"
  },
  {
    "poem_id": 87956,
    "vorder": 35,
    "position": 0,
    "text": "بدو داد مهری به پیش سپاه"
  },
  {
    "poem_id": 87956,
    "vorder": 36,
    "position": 1,
    "text": "که سالار اویست و جوینده راه"
  },
  {
    "poem_id": 87956,
    "vorder": 37,
    "position": 0,
    "text": "بفرمان او بود باید همه"
  },
  {
    "poem_id": 87956,
    "vorder": 38,
    "position": 1,
    "text": "کجا بندها زو گشاید همه"
  },
  {
    "poem_id": 87956,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت مگذر ز پیمان من"
  },
  {
    "poem_id": 87956,
    "vorder": 40,
    "position": 1,
    "text": "نگه‌دار آیین و فرمان من"
  },
  {
    "poem_id": 87956,
    "vorder": 41,
    "position": 0,
    "text": "نیازرد باید کسی را براه"
  },
  {
    "poem_id": 87956,
    "vorder": 42,
    "position": 1,
    "text": "چنینست آیین تخت و کلاه"
  },
  {
    "poem_id": 87956,
    "vorder": 43,
    "position": 0,
    "text": "کشاورز گر مردم پیشه‌ور"
  },
  {
    "poem_id": 87956,
    "vorder": 44,
    "position": 1,
    "text": "کسی کو بلشکر نبندد کمر"
  },
  {
    "poem_id": 87956,
    "vorder": 45,
    "position": 0,
    "text": "نباید که بر وی وزد باد سرد"
  },
  {
    "poem_id": 87956,
    "vorder": 46,
    "position": 1,
    "text": "مکوش ایچ جز با کسی همنبرد"
  },
  {
    "poem_id": 87956,
    "vorder": 47,
    "position": 0,
    "text": "نباید نمودن ببی رنج رنج"
  },
  {
    "poem_id": 87956,
    "vorder": 48,
    "position": 1,
    "text": "که بر کس نماند سرای سپنج"
  },
  {
    "poem_id": 87956,
    "vorder": 49,
    "position": 0,
    "text": "گذر زی کلات ایچ گونه مکن"
  },
  {
    "poem_id": 87956,
    "vorder": 50,
    "position": 1,
    "text": "گر آن ره روی خام گردد سخن"
  },
  {
    "poem_id": 87956,
    "vorder": 51,
    "position": 0,
    "text": "روان سیاوش چو خورشید باد"
  },
  {
    "poem_id": 87956,
    "vorder": 52,
    "position": 1,
    "text": "بدان گیتیش جای امید باد"
  },
  {
    "poem_id": 87956,
    "vorder": 53,
    "position": 0,
    "text": "پسر بودش از دخت پیران یکی"
  },
  {
    "poem_id": 87956,
    "vorder": 54,
    "position": 1,
    "text": "که پیدا نبود از پدر اندکی"
  },
  {
    "poem_id": 87956,
    "vorder": 55,
    "position": 0,
    "text": "برادر به من نیز ماننده بود"
  },
  {
    "poem_id": 87956,
    "vorder": 56,
    "position": 1,
    "text": "جوان بود و همسال و فرخنده بود"
  },
  {
    "poem_id": 87956,
    "vorder": 57,
    "position": 0,
    "text": "کنون در کلاتست و با مادرست"
  },
  {
    "poem_id": 87956,
    "vorder": 58,
    "position": 1,
    "text": "جهانجوی با فر و با لشکرست"
  },
  {
    "poem_id": 87956,
    "vorder": 59,
    "position": 0,
    "text": "نداند کسی را ز ایران بنام"
  },
  {
    "poem_id": 87956,
    "vorder": 60,
    "position": 1,
    "text": "ازان سو نباید کشیدن لگام"
  },
  {
    "poem_id": 87956,
    "vorder": 61,
    "position": 0,
    "text": "سپه دارد و نامداران جنگ"
  },
  {
    "poem_id": 87956,
    "vorder": 62,
    "position": 1,
    "text": "یکی کوه بر راه دشوار و تنگ"
  },
  {
    "poem_id": 87956,
    "vorder": 63,
    "position": 0,
    "text": "همو مرد جنگست و گرد و سوار"
  },
  {
    "poem_id": 87956,
    "vorder": 64,
    "position": 1,
    "text": "بگوهر بزرگ و بتن نامدار"
  },
  {
    "poem_id": 87956,
    "vorder": 65,
    "position": 0,
    "text": "براه بیابان بباید شدن"
  },
  {
    "poem_id": 87956,
    "vorder": 66,
    "position": 1,
    "text": "نه نیکو بود راه شیران زدن"
  },
  {
    "poem_id": 87956,
    "vorder": 67,
    "position": 0,
    "text": "چنین گفت پس طوس با شهریار"
  },
  {
    "poem_id": 87956,
    "vorder": 68,
    "position": 1,
    "text": "که از رای تو نگذرد روزگار"
  },
  {
    "poem_id": 87956,
    "vorder": 69,
    "position": 0,
    "text": "براهی روم کم تو فرمان دهی"
  },
  {
    "poem_id": 87956,
    "vorder": 70,
    "position": 1,
    "text": "نیاید ز فرمان تو جز بهی"
  }
]