[
  {
    "poem_id": 1369,
    "vorder": 1,
    "position": 0,
    "text": "برآمد برین نیز یک چندگاه"
  },
  {
    "poem_id": 1369,
    "vorder": 2,
    "position": 1,
    "text": "شبستان ایرج نگه کرد شاه"
  },
  {
    "poem_id": 1369,
    "vorder": 3,
    "position": 0,
    "text": "یکی خوب و چهره پرستنده دید"
  },
  {
    "poem_id": 1369,
    "vorder": 4,
    "position": 1,
    "text": "کجا نام او بود ماه‌آفرید"
  },
  {
    "poem_id": 1369,
    "vorder": 5,
    "position": 0,
    "text": "که ایرج برو مهر بسیار داشت"
  },
  {
    "poem_id": 1369,
    "vorder": 6,
    "position": 1,
    "text": "قضا را کنیزک ازو بار داشت"
  },
  {
    "poem_id": 1369,
    "vorder": 7,
    "position": 0,
    "text": "پری چهره را بچه بود در نهان"
  },
  {
    "poem_id": 1369,
    "vorder": 8,
    "position": 1,
    "text": "از آن شاد شد شهریار جهان"
  },
  {
    "poem_id": 1369,
    "vorder": 9,
    "position": 0,
    "text": "از آن خوب‌رخ شد دلش پرامید"
  },
  {
    "poem_id": 1369,
    "vorder": 10,
    "position": 1,
    "text": "به کین پسر داد دل را نوید"
  },
  {
    "poem_id": 1369,
    "vorder": 11,
    "position": 0,
    "text": "چو هنگامهٔ زادن آمد پدید"
  },
  {
    "poem_id": 1369,
    "vorder": 12,
    "position": 1,
    "text": "یکی دختر آمد ز ماه آفرید"
  },
  {
    "poem_id": 1369,
    "vorder": 13,
    "position": 0,
    "text": "جهانی گرفتند پروردنش"
  },
  {
    "poem_id": 1369,
    "vorder": 14,
    "position": 1,
    "text": "برآمد به ناز و بزرگی تنش"
  },
  {
    "poem_id": 1369,
    "vorder": 15,
    "position": 0,
    "text": "مر آن ماه‌رخ را ز سر تا به پای"
  },
  {
    "poem_id": 1369,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی مگر ایرجستی به جای"
  },
  {
    "poem_id": 1369,
    "vorder": 17,
    "position": 0,
    "text": "چو بر جست و آمدش هنگام شوی"
  },
  {
    "poem_id": 1369,
    "vorder": 18,
    "position": 1,
    "text": "چو پروین شدش روی و چون مشک موی"
  },
  {
    "poem_id": 1369,
    "vorder": 19,
    "position": 0,
    "text": "نیا نامزد کرد شویش پشنگ"
  },
  {
    "poem_id": 1369,
    "vorder": 20,
    "position": 1,
    "text": "بدو داد و چندی برآمد درنگ"
  },
  {
    "poem_id": 1369,
    "vorder": 21,
    "position": 0,
    "text": "یکی پور زاد آن هنرمند ماه"
  },
  {
    "poem_id": 1369,
    "vorder": 22,
    "position": 1,
    "text": "چگونه سزاوار تخت و کلاه"
  },
  {
    "poem_id": 1369,
    "vorder": 23,
    "position": 0,
    "text": "چو از مادر مهربان شد جدا"
  },
  {
    "poem_id": 1369,
    "vorder": 24,
    "position": 1,
    "text": "سبک تاختندش به نزد نیا"
  },
  {
    "poem_id": 1369,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت موبد که ای تاجور"
  },
  {
    "poem_id": 1369,
    "vorder": 26,
    "position": 1,
    "text": "یکی شادکن دل به ایرج نگر"
  },
  {
    "poem_id": 1369,
    "vorder": 27,
    "position": 0,
    "text": "جهان‌بخش را لب پر از خنده شد"
  },
  {
    "poem_id": 1369,
    "vorder": 28,
    "position": 1,
    "text": "تو گفتی مگر ایرجش زنده شد"
  },
  {
    "poem_id": 1369,
    "vorder": 29,
    "position": 0,
    "text": "نهاد آن گرانمایه را برکنار"
  },
  {
    "poem_id": 1369,
    "vorder": 30,
    "position": 1,
    "text": "نیایش همی کرد با کردگار"
  },
  {
    "poem_id": 1369,
    "vorder": 31,
    "position": 0,
    "text": "همی گفت کاین روز فرخنده باد"
  },
  {
    "poem_id": 1369,
    "vorder": 32,
    "position": 1,
    "text": "دل بدسگالان ما کنده باد"
  },
  {
    "poem_id": 1369,
    "vorder": 33,
    "position": 0,
    "text": "همان کز جهان آفرین کرد یاد"
  },
  {
    "poem_id": 1369,
    "vorder": 34,
    "position": 1,
    "text": "ببخشود و دیده بدو باز داد"
  },
  {
    "poem_id": 1369,
    "vorder": 35,
    "position": 0,
    "text": "فریدون چو روشن جهان را بدید"
  },
  {
    "poem_id": 1369,
    "vorder": 36,
    "position": 1,
    "text": "به چهر نوآمد سبک بنگرید"
  },
  {
    "poem_id": 1369,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت کز پاک مام و پدر"
  },
  {
    "poem_id": 1369,
    "vorder": 38,
    "position": 1,
    "text": "یکی شاخ شایسته آمد به بر"
  },
  {
    "poem_id": 1369,
    "vorder": 39,
    "position": 0,
    "text": "می روشن آمد ز پرمایه جام"
  },
  {
    "poem_id": 1369,
    "vorder": 40,
    "position": 1,
    "text": "مر آن چهر دارد منوچهر نام"
  },
  {
    "poem_id": 1369,
    "vorder": 41,
    "position": 0,
    "text": "چنان پروریدش که باد هوا"
  },
  {
    "poem_id": 1369,
    "vorder": 42,
    "position": 1,
    "text": "برو بر گذشتی نبودی روا"
  },
  {
    "poem_id": 1369,
    "vorder": 43,
    "position": 0,
    "text": "پرستنده‌ای کش به بر داشتی"
  },
  {
    "poem_id": 1369,
    "vorder": 44,
    "position": 1,
    "text": "زمین را به پی هیچ نگذاشتی"
  },
  {
    "poem_id": 1369,
    "vorder": 45,
    "position": 0,
    "text": "به پای اندرش مشک سارا بدی"
  },
  {
    "poem_id": 1369,
    "vorder": 46,
    "position": 1,
    "text": "روان بر سرش چتر دیبا بدی"
  },
  {
    "poem_id": 1369,
    "vorder": 47,
    "position": 0,
    "text": "چنین تا برآمد برو سالیان"
  },
  {
    "poem_id": 1369,
    "vorder": 48,
    "position": 1,
    "text": "نیامدش ز اختر زمانی زیان"
  },
  {
    "poem_id": 1369,
    "vorder": 49,
    "position": 0,
    "text": "هنرها که آید شهان را به کار"
  },
  {
    "poem_id": 1369,
    "vorder": 50,
    "position": 1,
    "text": "بیاموختش نامور شهریار"
  },
  {
    "poem_id": 1369,
    "vorder": 51,
    "position": 0,
    "text": "چو چشم و دل پادشا باز شد"
  },
  {
    "poem_id": 1369,
    "vorder": 52,
    "position": 1,
    "text": "سپه نیز با او هم آواز شد"
  },
  {
    "poem_id": 1369,
    "vorder": 53,
    "position": 0,
    "text": "نیا تخت زرین و گرز گران"
  },
  {
    "poem_id": 1369,
    "vorder": 54,
    "position": 1,
    "text": "بدو داد و پیروزه تاج سران"
  },
  {
    "poem_id": 1369,
    "vorder": 55,
    "position": 0,
    "text": "سراپردهٔ دیبهٔ هفت‌رنگ"
  },
  {
    "poem_id": 1369,
    "vorder": 56,
    "position": 1,
    "text": "بدو اندرون خیمه‌های پلنگ"
  },
  {
    "poem_id": 1369,
    "vorder": 57,
    "position": 0,
    "text": "چه اسپان تازی به زرین ستام"
  },
  {
    "poem_id": 1369,
    "vorder": 58,
    "position": 1,
    "text": "چه شمشیر هندی به زرین نیام"
  },
  {
    "poem_id": 1369,
    "vorder": 59,
    "position": 0,
    "text": "چه از جوشن و ترگ و رومی زره"
  },
  {
    "poem_id": 1369,
    "vorder": 60,
    "position": 1,
    "text": "گشادند مر بندها را گره"
  },
  {
    "poem_id": 1369,
    "vorder": 61,
    "position": 0,
    "text": "کمانهای چاچی وتیر خدنگ"
  },
  {
    "poem_id": 1369,
    "vorder": 62,
    "position": 1,
    "text": "سپرهای چینی و ژوپین جنگ"
  },
  {
    "poem_id": 1369,
    "vorder": 63,
    "position": 0,
    "text": "برین گونه آراسته گنجها"
  },
  {
    "poem_id": 1369,
    "vorder": 64,
    "position": 1,
    "text": "که بودش به گرد آمده رنجها"
  },
  {
    "poem_id": 1369,
    "vorder": 65,
    "position": 0,
    "text": "سراسر سزای منوچهر دید"
  },
  {
    "poem_id": 1369,
    "vorder": 66,
    "position": 1,
    "text": "دل خویش را زو پر از مهر دید"
  },
  {
    "poem_id": 1369,
    "vorder": 67,
    "position": 0,
    "text": "کلید در گنج آراسته"
  },
  {
    "poem_id": 1369,
    "vorder": 68,
    "position": 1,
    "text": "به گنجور او داد با خواسته"
  },
  {
    "poem_id": 1369,
    "vorder": 69,
    "position": 0,
    "text": "همه پهلوانان لشکرش را"
  },
  {
    "poem_id": 1369,
    "vorder": 70,
    "position": 1,
    "text": "همه نامداران کشورش را"
  },
  {
    "poem_id": 1369,
    "vorder": 71,
    "position": 0,
    "text": "بفرمود تا پیش او آمدند"
  },
  {
    "poem_id": 1369,
    "vorder": 72,
    "position": 1,
    "text": "همه با دلی کینه‌جو آمدند"
  },
  {
    "poem_id": 1369,
    "vorder": 73,
    "position": 0,
    "text": "به شاهی برو آفرین خواندند"
  },
  {
    "poem_id": 1369,
    "vorder": 74,
    "position": 1,
    "text": "زبرجد به تاجش برافشاندند"
  },
  {
    "poem_id": 1369,
    "vorder": 75,
    "position": 0,
    "text": "چو جشنی بد این روزگار بزرگ"
  },
  {
    "poem_id": 1369,
    "vorder": 76,
    "position": 1,
    "text": "شده در جهان میش پیدا ز گرگ"
  },
  {
    "poem_id": 1369,
    "vorder": 77,
    "position": 0,
    "text": "سپهدار چون قارن کاوگان"
  },
  {
    "poem_id": 1369,
    "vorder": 78,
    "position": 1,
    "text": "سپهکش چو شیروی و چون آوگان"
  },
  {
    "poem_id": 1369,
    "vorder": 79,
    "position": 0,
    "text": "چو شد ساخته کار لشکر همه"
  },
  {
    "poem_id": 1369,
    "vorder": 80,
    "position": 1,
    "text": "برآمد سر شهریار از رمه"
  }
]