[
  {
    "poem_id": 1723,
    "vorder": 1,
    "position": 0,
    "text": "وزان پس پراگنده شد آگهی"
  },
  {
    "poem_id": 1723,
    "vorder": 2,
    "position": 1,
    "text": "که بیکار شد تخت شاهنشهی"
  },
  {
    "poem_id": 1723,
    "vorder": 3,
    "position": 0,
    "text": "بمرد اردشیر آن خردمند شاه"
  },
  {
    "poem_id": 1723,
    "vorder": 4,
    "position": 1,
    "text": "به شاپور بسپرد گنج و سپاه"
  },
  {
    "poem_id": 1723,
    "vorder": 5,
    "position": 0,
    "text": "خروشی برآمد ز هر مرز و بوم"
  },
  {
    "poem_id": 1723,
    "vorder": 6,
    "position": 1,
    "text": "ز قیدافه برداشتند باژ روم"
  },
  {
    "poem_id": 1723,
    "vorder": 7,
    "position": 0,
    "text": "چو آگاهی آمد به شاپور شاه"
  },
  {
    "poem_id": 1723,
    "vorder": 8,
    "position": 1,
    "text": "بیاراست کوس و درفش و سپاه"
  },
  {
    "poem_id": 1723,
    "vorder": 9,
    "position": 0,
    "text": "همی راند تا پیش التوینه"
  },
  {
    "poem_id": 1723,
    "vorder": 10,
    "position": 1,
    "text": "سپاهی سبک بی‌نیاز از بنه"
  },
  {
    "poem_id": 1723,
    "vorder": 11,
    "position": 0,
    "text": "سپاهی ز قیدافه آمد برون"
  },
  {
    "poem_id": 1723,
    "vorder": 12,
    "position": 1,
    "text": "که از گرد خورشید شد تیره‌گون"
  },
  {
    "poem_id": 1723,
    "vorder": 13,
    "position": 0,
    "text": "ز التوینه هم‌چنین لشکری"
  },
  {
    "poem_id": 1723,
    "vorder": 14,
    "position": 1,
    "text": "بیامد سپهدارشان مهتری"
  },
  {
    "poem_id": 1723,
    "vorder": 15,
    "position": 0,
    "text": "برانوش بد نام آن پهلوان"
  },
  {
    "poem_id": 1723,
    "vorder": 16,
    "position": 1,
    "text": "سواری سرافراز و روشن‌روان"
  },
  {
    "poem_id": 1723,
    "vorder": 17,
    "position": 0,
    "text": "کجا بود بر قیصران ارجمند"
  },
  {
    "poem_id": 1723,
    "vorder": 18,
    "position": 1,
    "text": "کمند افگنی نامداری بلند"
  },
  {
    "poem_id": 1723,
    "vorder": 19,
    "position": 0,
    "text": "چو برخاست آواز کوس از دو روی"
  },
  {
    "poem_id": 1723,
    "vorder": 20,
    "position": 1,
    "text": "ز قلب اندر آمد گو نامجوی"
  },
  {
    "poem_id": 1723,
    "vorder": 21,
    "position": 0,
    "text": "وزین سو بشد نامداری دلیر"
  },
  {
    "poem_id": 1723,
    "vorder": 22,
    "position": 1,
    "text": "کجا نام او بود گرزسپ شیر"
  },
  {
    "poem_id": 1723,
    "vorder": 23,
    "position": 0,
    "text": "برآمد ز هر دو سپه کوس و غو"
  },
  {
    "poem_id": 1723,
    "vorder": 24,
    "position": 1,
    "text": "بجنبید در قلبگه شاه نو"
  },
  {
    "poem_id": 1723,
    "vorder": 25,
    "position": 0,
    "text": "ز بس نالهٔ بوق و هندی درای"
  },
  {
    "poem_id": 1723,
    "vorder": 26,
    "position": 1,
    "text": "همی چرخ و ماه‌اندر آمد ز جای"
  },
  {
    "poem_id": 1723,
    "vorder": 27,
    "position": 0,
    "text": "تبیره ببستند بر پشت پیل"
  },
  {
    "poem_id": 1723,
    "vorder": 28,
    "position": 1,
    "text": "همی‌بر شد آوازشان بر دو میل"
  },
  {
    "poem_id": 1723,
    "vorder": 29,
    "position": 0,
    "text": "زمین جنب جنبان شد و پر ز گرد"
  },
  {
    "poem_id": 1723,
    "vorder": 30,
    "position": 1,
    "text": "چو آتش درخشان سنان نبرد"
  },
  {
    "poem_id": 1723,
    "vorder": 31,
    "position": 0,
    "text": "روانی کجا با خرد بود جفت"
  },
  {
    "poem_id": 1723,
    "vorder": 32,
    "position": 1,
    "text": "ستاره همی بارد از چرخ گفت"
  },
  {
    "poem_id": 1723,
    "vorder": 33,
    "position": 0,
    "text": "برانوش جنگی به قلب اندرون"
  },
  {
    "poem_id": 1723,
    "vorder": 34,
    "position": 1,
    "text": "گرفتار شد با دلی پر ز خون"
  },
  {
    "poem_id": 1723,
    "vorder": 35,
    "position": 0,
    "text": "وزان رومیان کشته شد سه هزار"
  },
  {
    "poem_id": 1723,
    "vorder": 36,
    "position": 1,
    "text": "بالتوینه در صف کارزار"
  },
  {
    "poem_id": 1723,
    "vorder": 37,
    "position": 0,
    "text": "هزار و دو سیصد گرفتار شد"
  },
  {
    "poem_id": 1723,
    "vorder": 38,
    "position": 1,
    "text": "دل جنگیان پر ز تیمار شد"
  },
  {
    "poem_id": 1723,
    "vorder": 39,
    "position": 0,
    "text": "فرستاد قیصر یکی یادگیر"
  },
  {
    "poem_id": 1723,
    "vorder": 40,
    "position": 1,
    "text": "به نزدیک شاپور شاه اردشیر"
  },
  {
    "poem_id": 1723,
    "vorder": 41,
    "position": 0,
    "text": "که چندین تو از بهر دینار خون"
  },
  {
    "poem_id": 1723,
    "vorder": 42,
    "position": 1,
    "text": "بریزی تو با داور رهنمون"
  },
  {
    "poem_id": 1723,
    "vorder": 43,
    "position": 0,
    "text": "چه گویی چو پرسند روز شمار"
  },
  {
    "poem_id": 1723,
    "vorder": 44,
    "position": 1,
    "text": "چه پوزش کنی پیش پروردگار"
  },
  {
    "poem_id": 1723,
    "vorder": 45,
    "position": 0,
    "text": "فرستیم باژی چنان هم که بود"
  },
  {
    "poem_id": 1723,
    "vorder": 46,
    "position": 1,
    "text": "برین نیز دردی نباید فزود"
  },
  {
    "poem_id": 1723,
    "vorder": 47,
    "position": 0,
    "text": "همان نیز با باژ فرمان کنیم"
  },
  {
    "poem_id": 1723,
    "vorder": 48,
    "position": 1,
    "text": "ز خویشان فراوان گروگان کنیم"
  },
  {
    "poem_id": 1723,
    "vorder": 49,
    "position": 0,
    "text": "ز التوینه بازگردی رواست"
  },
  {
    "poem_id": 1723,
    "vorder": 50,
    "position": 1,
    "text": "فرستیم با باژ هرچت هواست"
  },
  {
    "poem_id": 1723,
    "vorder": 51,
    "position": 0,
    "text": "همی بود شاپور تا باژ و ساو"
  },
  {
    "poem_id": 1723,
    "vorder": 52,
    "position": 1,
    "text": "فرستاد قیصر ده انبان گاو"
  },
  {
    "poem_id": 1723,
    "vorder": 53,
    "position": 0,
    "text": "غلام و پرستار رومی هزار"
  },
  {
    "poem_id": 1723,
    "vorder": 54,
    "position": 1,
    "text": "گرانمایه دیبا نه اندر شمار"
  },
  {
    "poem_id": 1723,
    "vorder": 55,
    "position": 0,
    "text": "بالتوینه در ببد روز هفت"
  },
  {
    "poem_id": 1723,
    "vorder": 56,
    "position": 1,
    "text": "ز روم اندر آمد به اهواز رفت"
  },
  {
    "poem_id": 1723,
    "vorder": 57,
    "position": 0,
    "text": "یکی شارستان نام شاپور گرد"
  },
  {
    "poem_id": 1723,
    "vorder": 58,
    "position": 1,
    "text": "برآورد و پرداخت در روز ارد"
  },
  {
    "poem_id": 1723,
    "vorder": 59,
    "position": 0,
    "text": "همی برد سالار زان شهر رنج"
  },
  {
    "poem_id": 1723,
    "vorder": 60,
    "position": 1,
    "text": "بپردخت بسیار با رنج گنج"
  },
  {
    "poem_id": 1723,
    "vorder": 61,
    "position": 0,
    "text": "یکی شارستان بود آباد بوم"
  },
  {
    "poem_id": 1723,
    "vorder": 62,
    "position": 1,
    "text": "بپردخت بهر اسیران روم"
  },
  {
    "poem_id": 1723,
    "vorder": 63,
    "position": 0,
    "text": "در خوزیان دارد این بوم و بر"
  },
  {
    "poem_id": 1723,
    "vorder": 64,
    "position": 1,
    "text": "که دارند هرکس بروبر گذر"
  },
  {
    "poem_id": 1723,
    "vorder": 65,
    "position": 0,
    "text": "به پارس اندرون شارستان بلند"
  },
  {
    "poem_id": 1723,
    "vorder": 66,
    "position": 1,
    "text": "برآورد پاکیزه و سودمند"
  },
  {
    "poem_id": 1723,
    "vorder": 67,
    "position": 0,
    "text": "یکی شارستان کرد در سیستان"
  },
  {
    "poem_id": 1723,
    "vorder": 68,
    "position": 1,
    "text": "در آنجای بسیار خرماستان"
  },
  {
    "poem_id": 1723,
    "vorder": 69,
    "position": 0,
    "text": "که یک نیم او کرده بود اردشیر"
  },
  {
    "poem_id": 1723,
    "vorder": 70,
    "position": 1,
    "text": "دگر نیم شاپور گرد و دلیر"
  },
  {
    "poem_id": 1723,
    "vorder": 71,
    "position": 0,
    "text": "کهن دژ به شهر نشاپور کرد"
  },
  {
    "poem_id": 1723,
    "vorder": 72,
    "position": 1,
    "text": "که گویند با داد شاپور کرد"
  },
  {
    "poem_id": 1723,
    "vorder": 73,
    "position": 0,
    "text": "همی برد هر سو برانوش را"
  },
  {
    "poem_id": 1723,
    "vorder": 74,
    "position": 1,
    "text": "بدو داشتی در سخن گوش را"
  },
  {
    "poem_id": 1723,
    "vorder": 75,
    "position": 0,
    "text": "یکی رود بد پهن در شوشتر"
  },
  {
    "poem_id": 1723,
    "vorder": 76,
    "position": 1,
    "text": "که ماهی نکردی بروبر گذر"
  },
  {
    "poem_id": 1723,
    "vorder": 77,
    "position": 0,
    "text": "برانوش را گفت گر هندسی"
  },
  {
    "poem_id": 1723,
    "vorder": 78,
    "position": 1,
    "text": "پلی ساز آنجا چنانچون رسی"
  },
  {
    "poem_id": 1723,
    "vorder": 79,
    "position": 0,
    "text": "که ما بازگردیم و آن پل به جای"
  },
  {
    "poem_id": 1723,
    "vorder": 80,
    "position": 1,
    "text": "بماند به دانایی رهنمای"
  },
  {
    "poem_id": 1723,
    "vorder": 81,
    "position": 0,
    "text": "به رش کرده بالای این پل هزار"
  },
  {
    "poem_id": 1723,
    "vorder": 82,
    "position": 1,
    "text": "بخواهی ز گنج آنچ آید به کار"
  },
  {
    "poem_id": 1723,
    "vorder": 83,
    "position": 0,
    "text": "تو از دانشی فیلسوفان روم"
  },
  {
    "poem_id": 1723,
    "vorder": 84,
    "position": 1,
    "text": "فراز آر چندی بران مرز و بوم"
  },
  {
    "poem_id": 1723,
    "vorder": 85,
    "position": 0,
    "text": "چو این پل برآید سوی خان خویش"
  },
  {
    "poem_id": 1723,
    "vorder": 86,
    "position": 1,
    "text": "برو تازیان باش مهمان خویش"
  },
  {
    "poem_id": 1723,
    "vorder": 87,
    "position": 0,
    "text": "ابا شادمانی و با ایمنی"
  },
  {
    "poem_id": 1723,
    "vorder": 88,
    "position": 1,
    "text": "ز بد دور وز دست اهریمنی"
  },
  {
    "poem_id": 1723,
    "vorder": 89,
    "position": 0,
    "text": "به تدبیر آن پل باستاد مرد"
  },
  {
    "poem_id": 1723,
    "vorder": 90,
    "position": 1,
    "text": "فراز آوریدش بران کارکرد"
  },
  {
    "poem_id": 1723,
    "vorder": 91,
    "position": 0,
    "text": "بپردخت شاپور گنجی بران"
  },
  {
    "poem_id": 1723,
    "vorder": 92,
    "position": 1,
    "text": "که زان باشد آسانی مردمان"
  },
  {
    "poem_id": 1723,
    "vorder": 93,
    "position": 0,
    "text": "چو شد شه برانوش کرد آن تمام"
  },
  {
    "poem_id": 1723,
    "vorder": 94,
    "position": 1,
    "text": "پلی کرد بالا هزارانش گام"
  },
  {
    "poem_id": 1723,
    "vorder": 95,
    "position": 0,
    "text": "چو شد پل تمام او ز ششتر برفت"
  },
  {
    "poem_id": 1723,
    "vorder": 96,
    "position": 1,
    "text": "سوی خان خود روی بنهاد تفت"
  }
]