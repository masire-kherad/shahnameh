[
  {
    "poem_id": 1699,
    "vorder": 1,
    "position": 0,
    "text": "سپاهی ز اصطخر بی‌مر ببرد"
  },
  {
    "poem_id": 1699,
    "vorder": 2,
    "position": 1,
    "text": "بشد ساخته تا کند رزم کرد"
  },
  {
    "poem_id": 1699,
    "vorder": 3,
    "position": 0,
    "text": "به نیکی ز یزدان همی جست مزد"
  },
  {
    "poem_id": 1699,
    "vorder": 4,
    "position": 1,
    "text": "که ریزد بر آن بوم و بر خون دزد"
  },
  {
    "poem_id": 1699,
    "vorder": 5,
    "position": 0,
    "text": "چو شاه اردشیر اندرآمد به تنگ"
  },
  {
    "poem_id": 1699,
    "vorder": 6,
    "position": 1,
    "text": "پذیره شدش کرد بی‌مر به جنگ"
  },
  {
    "poem_id": 1699,
    "vorder": 7,
    "position": 0,
    "text": "یکی کار بدخوار دشوار گشت"
  },
  {
    "poem_id": 1699,
    "vorder": 8,
    "position": 1,
    "text": "ابا کرد کشور همه یار گشت"
  },
  {
    "poem_id": 1699,
    "vorder": 9,
    "position": 0,
    "text": "یکی لشکری کرد بد پارسی"
  },
  {
    "poem_id": 1699,
    "vorder": 10,
    "position": 1,
    "text": "فزونتر ز گردان او یک به سی"
  },
  {
    "poem_id": 1699,
    "vorder": 11,
    "position": 0,
    "text": "یکی روز تا شب برآویختند"
  },
  {
    "poem_id": 1699,
    "vorder": 12,
    "position": 1,
    "text": "سپاه جهاندار بگریختند"
  },
  {
    "poem_id": 1699,
    "vorder": 13,
    "position": 0,
    "text": "ز بس کشته و خسته بر دشت جنگ"
  },
  {
    "poem_id": 1699,
    "vorder": 14,
    "position": 1,
    "text": "شد آوردگه را همه جای تنگ"
  },
  {
    "poem_id": 1699,
    "vorder": 15,
    "position": 0,
    "text": "جز از شاه با خوارمایه سپاه"
  },
  {
    "poem_id": 1699,
    "vorder": 16,
    "position": 1,
    "text": "نبد نامداران بدان رزمگاه"
  },
  {
    "poem_id": 1699,
    "vorder": 17,
    "position": 0,
    "text": "ز خورشید تابان وز گرد و خاک"
  },
  {
    "poem_id": 1699,
    "vorder": 18,
    "position": 1,
    "text": "زبانها شد از تشنگی چاک چاک"
  },
  {
    "poem_id": 1699,
    "vorder": 19,
    "position": 0,
    "text": "هم‌انگه درفشی برآورد شب"
  },
  {
    "poem_id": 1699,
    "vorder": 20,
    "position": 1,
    "text": "که بنشاند آن جنگ و جوش و جلب"
  },
  {
    "poem_id": 1699,
    "vorder": 21,
    "position": 0,
    "text": "یکی آتشی دید بر سوی کوه"
  },
  {
    "poem_id": 1699,
    "vorder": 22,
    "position": 1,
    "text": "بیامد جهاندار با آن گروه"
  },
  {
    "poem_id": 1699,
    "vorder": 23,
    "position": 0,
    "text": "سوی آتش آورد روی ا ردشیر"
  },
  {
    "poem_id": 1699,
    "vorder": 24,
    "position": 1,
    "text": "همان اندکی مرد برنا و پیر"
  },
  {
    "poem_id": 1699,
    "vorder": 25,
    "position": 0,
    "text": "چو تنگ اندر آمد شبانان بدید"
  },
  {
    "poem_id": 1699,
    "vorder": 26,
    "position": 1,
    "text": "بران میش و بز پاسبانان بدید"
  },
  {
    "poem_id": 1699,
    "vorder": 27,
    "position": 0,
    "text": "فرود آمد از باره شاه و سپاه"
  },
  {
    "poem_id": 1699,
    "vorder": 28,
    "position": 1,
    "text": "دهانش پر از خاک آوردگاه"
  },
  {
    "poem_id": 1699,
    "vorder": 29,
    "position": 0,
    "text": "ازیشان سبک اردشیر آب خواست"
  },
  {
    "poem_id": 1699,
    "vorder": 30,
    "position": 1,
    "text": "هم‌انگه ببردند با آب ماست"
  },
  {
    "poem_id": 1699,
    "vorder": 31,
    "position": 0,
    "text": "بیاسود و لختی چرید آنچ دید"
  },
  {
    "poem_id": 1699,
    "vorder": 32,
    "position": 1,
    "text": "شب تیره خفتان به سر بر کشید"
  },
  {
    "poem_id": 1699,
    "vorder": 33,
    "position": 0,
    "text": "ز خفتان شایسته بد بسترش"
  },
  {
    "poem_id": 1699,
    "vorder": 34,
    "position": 1,
    "text": "به بالین نهاد آن کیی مغفرش"
  },
  {
    "poem_id": 1699,
    "vorder": 35,
    "position": 0,
    "text": "سپیده چو برزد ز دریای آب"
  },
  {
    "poem_id": 1699,
    "vorder": 36,
    "position": 1,
    "text": "سر شاه ایران برآمد ز خواب"
  },
  {
    "poem_id": 1699,
    "vorder": 37,
    "position": 0,
    "text": "بیامد به بالین او سرشبان"
  },
  {
    "poem_id": 1699,
    "vorder": 38,
    "position": 1,
    "text": "که پدرام باد از تو روز و شبان"
  },
  {
    "poem_id": 1699,
    "vorder": 39,
    "position": 0,
    "text": "چه آمد که این جای راه تو بود"
  },
  {
    "poem_id": 1699,
    "vorder": 40,
    "position": 1,
    "text": "که نه در خور خوابگاه تو بود"
  },
  {
    "poem_id": 1699,
    "vorder": 41,
    "position": 0,
    "text": "بپرسید زان سرشبان راه شاه"
  },
  {
    "poem_id": 1699,
    "vorder": 42,
    "position": 1,
    "text": "کز ایدر کجا یابم آرامگاه"
  },
  {
    "poem_id": 1699,
    "vorder": 43,
    "position": 0,
    "text": "چنین داد پاسخ که آباد جای"
  },
  {
    "poem_id": 1699,
    "vorder": 44,
    "position": 1,
    "text": "نیابی مگر باشدت رهنمای"
  },
  {
    "poem_id": 1699,
    "vorder": 45,
    "position": 0,
    "text": "از ایدر کنون چار فرسنگ راه"
  },
  {
    "poem_id": 1699,
    "vorder": 46,
    "position": 1,
    "text": "چو رفتی پدید آید آرامگاه"
  },
  {
    "poem_id": 1699,
    "vorder": 47,
    "position": 0,
    "text": "وزان روی پیوسته شد ده به ده"
  },
  {
    "poem_id": 1699,
    "vorder": 48,
    "position": 1,
    "text": "به ده در یکی نامبردار مه"
  },
  {
    "poem_id": 1699,
    "vorder": 49,
    "position": 0,
    "text": "چو بشنید زان سرشبان اردشیر"
  },
  {
    "poem_id": 1699,
    "vorder": 50,
    "position": 1,
    "text": "ببرد از رمه راهبر چند پیر"
  },
  {
    "poem_id": 1699,
    "vorder": 51,
    "position": 0,
    "text": "سپهبد ز کوه اندر آمد بده"
  },
  {
    "poem_id": 1699,
    "vorder": 52,
    "position": 1,
    "text": "ازان ده سبک پیش او رفت مه"
  },
  {
    "poem_id": 1699,
    "vorder": 53,
    "position": 0,
    "text": "سواران فرستاد برنا و پیر"
  },
  {
    "poem_id": 1699,
    "vorder": 54,
    "position": 1,
    "text": "ازان شهر تا خورهٔ اردشیر"
  },
  {
    "poem_id": 1699,
    "vorder": 55,
    "position": 0,
    "text": "سپه را چو آگاهی آمد ز شاه"
  },
  {
    "poem_id": 1699,
    "vorder": 56,
    "position": 1,
    "text": "همه شاددل برگرفتند راه"
  },
  {
    "poem_id": 1699,
    "vorder": 57,
    "position": 0,
    "text": "به کردان فرستاده کارآگهان"
  },
  {
    "poem_id": 1699,
    "vorder": 58,
    "position": 1,
    "text": "کجا کار ایشان بجوید نهان"
  },
  {
    "poem_id": 1699,
    "vorder": 59,
    "position": 0,
    "text": "برفتند پویان و بازآمدند"
  },
  {
    "poem_id": 1699,
    "vorder": 60,
    "position": 1,
    "text": "بر شاه ایران فراز آمدند"
  },
  {
    "poem_id": 1699,
    "vorder": 61,
    "position": 0,
    "text": "که ایشان همه نامجویند و شاد"
  },
  {
    "poem_id": 1699,
    "vorder": 62,
    "position": 1,
    "text": "ندارد کسی بر دل از شاه یاد"
  },
  {
    "poem_id": 1699,
    "vorder": 63,
    "position": 0,
    "text": "برآنند کاندر صطخر اردشیر"
  },
  {
    "poem_id": 1699,
    "vorder": 64,
    "position": 1,
    "text": "کهن گشت و شد بخت برناش پیر"
  },
  {
    "poem_id": 1699,
    "vorder": 65,
    "position": 0,
    "text": "چو بشنید شاه این سخن شاد شد"
  },
  {
    "poem_id": 1699,
    "vorder": 66,
    "position": 1,
    "text": "گذشته سخن بر دلش باد شد"
  },
  {
    "poem_id": 1699,
    "vorder": 67,
    "position": 0,
    "text": "گزین کرد ازان لشکر نامدار"
  },
  {
    "poem_id": 1699,
    "vorder": 68,
    "position": 1,
    "text": "سواران شمشیرزن سی هزار"
  },
  {
    "poem_id": 1699,
    "vorder": 69,
    "position": 0,
    "text": "کماندار با تیر و ترکش هزار"
  },
  {
    "poem_id": 1699,
    "vorder": 70,
    "position": 1,
    "text": "بیاورد با خویشتن شهریار"
  }
]