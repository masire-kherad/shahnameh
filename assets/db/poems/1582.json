[
  {
    "poem_id": 1582,
    "vorder": 1,
    "position": 0,
    "text": "سخنهای آن نامور پیشگاه"
  },
  {
    "poem_id": 1582,
    "vorder": 2,
    "position": 1,
    "text": "چو بشنید بهمن بیامد به راه"
  },
  {
    "poem_id": 1582,
    "vorder": 3,
    "position": 0,
    "text": "بپوشید زربفت شاهنشهی"
  },
  {
    "poem_id": 1582,
    "vorder": 4,
    "position": 1,
    "text": "بسر بر نهاد آن کلاه مهی"
  },
  {
    "poem_id": 1582,
    "vorder": 5,
    "position": 0,
    "text": "خرامان بیامد ز پرده‌سرای"
  },
  {
    "poem_id": 1582,
    "vorder": 6,
    "position": 1,
    "text": "درفشی درفشان پس او به پای"
  },
  {
    "poem_id": 1582,
    "vorder": 7,
    "position": 0,
    "text": "جهانجوی بگذشت بر هیرمند"
  },
  {
    "poem_id": 1582,
    "vorder": 8,
    "position": 1,
    "text": "جوانی سرافراز و اسپی بلند"
  },
  {
    "poem_id": 1582,
    "vorder": 9,
    "position": 0,
    "text": "هم‌اندر زمان دیده‌بانش بدید"
  },
  {
    "poem_id": 1582,
    "vorder": 10,
    "position": 1,
    "text": "سوی زاولستان فغان برکشید"
  },
  {
    "poem_id": 1582,
    "vorder": 11,
    "position": 0,
    "text": "که آمد نبرده سواری دلیر"
  },
  {
    "poem_id": 1582,
    "vorder": 12,
    "position": 1,
    "text": "به هرّای زرین سیاهی به زیر"
  },
  {
    "poem_id": 1582,
    "vorder": 13,
    "position": 0,
    "text": "پس پشت او خوار مایه سوار"
  },
  {
    "poem_id": 1582,
    "vorder": 14,
    "position": 1,
    "text": "تن‌آسان گذشت از لب جویبار"
  },
  {
    "poem_id": 1582,
    "vorder": 15,
    "position": 0,
    "text": "هم‌اندر زمان زال زر برنشست"
  },
  {
    "poem_id": 1582,
    "vorder": 16,
    "position": 1,
    "text": "کمندی به فتراک و گرزی به دست"
  },
  {
    "poem_id": 1582,
    "vorder": 17,
    "position": 0,
    "text": "بیامد ز دیده مر او را بدید"
  },
  {
    "poem_id": 1582,
    "vorder": 18,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1582,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت کین نامور پهلوست"
  },
  {
    "poem_id": 1582,
    "vorder": 20,
    "position": 1,
    "text": "سرافراز با جامهٔ خسروست"
  },
  {
    "poem_id": 1582,
    "vorder": 21,
    "position": 0,
    "text": "ز لهراسپ دارد همانا نژاد"
  },
  {
    "poem_id": 1582,
    "vorder": 22,
    "position": 1,
    "text": "پی او برین بوم فرخنده باد"
  },
  {
    "poem_id": 1582,
    "vorder": 23,
    "position": 0,
    "text": "ز دیده بیامد به درگاه رفت"
  },
  {
    "poem_id": 1582,
    "vorder": 24,
    "position": 1,
    "text": "زمانی به اندیشه بر زین بخفت"
  },
  {
    "poem_id": 1582,
    "vorder": 25,
    "position": 0,
    "text": "هم‌اندر زمان بهمن آمد پدید"
  },
  {
    "poem_id": 1582,
    "vorder": 26,
    "position": 1,
    "text": "ازو رایت خسروی گسترید"
  },
  {
    "poem_id": 1582,
    "vorder": 27,
    "position": 0,
    "text": "ندانست مرد جوان زال را"
  },
  {
    "poem_id": 1582,
    "vorder": 28,
    "position": 1,
    "text": "بیفراخت آن خسروی یال را"
  },
  {
    "poem_id": 1582,
    "vorder": 29,
    "position": 0,
    "text": "چو نزدیکتر گشت آواز داد"
  },
  {
    "poem_id": 1582,
    "vorder": 30,
    "position": 1,
    "text": "بدو گفت کای مرد دهقان‌نژاد"
  },
  {
    "poem_id": 1582,
    "vorder": 31,
    "position": 0,
    "text": "سرانجمن پور دستان کجاست"
  },
  {
    "poem_id": 1582,
    "vorder": 32,
    "position": 1,
    "text": "که دارد زمانه بدو پشت راست"
  },
  {
    "poem_id": 1582,
    "vorder": 33,
    "position": 0,
    "text": "که آمد به زاول گو اسفندیار"
  },
  {
    "poem_id": 1582,
    "vorder": 34,
    "position": 1,
    "text": "سراپرده زد بر لب رودبار"
  },
  {
    "poem_id": 1582,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت زال ای پسر کام جوی"
  },
  {
    "poem_id": 1582,
    "vorder": 36,
    "position": 1,
    "text": "فرود آی و می خواه و آرام جوی"
  },
  {
    "poem_id": 1582,
    "vorder": 37,
    "position": 0,
    "text": "کنون رستم آید ز نخچیرگاه"
  },
  {
    "poem_id": 1582,
    "vorder": 38,
    "position": 1,
    "text": "زواره فرامرز و چندی سپاه"
  },
  {
    "poem_id": 1582,
    "vorder": 39,
    "position": 0,
    "text": "تو با این سواران بباش ارجمند"
  },
  {
    "poem_id": 1582,
    "vorder": 40,
    "position": 1,
    "text": "بیارای دل را به بگماز چند"
  },
  {
    "poem_id": 1582,
    "vorder": 41,
    "position": 0,
    "text": "چنین داد پاسخ که اسفندیار"
  },
  {
    "poem_id": 1582,
    "vorder": 42,
    "position": 1,
    "text": "نفرمودمان رامش و میگسار"
  },
  {
    "poem_id": 1582,
    "vorder": 43,
    "position": 0,
    "text": "گزین کن یکی مرد جوینده راه"
  },
  {
    "poem_id": 1582,
    "vorder": 44,
    "position": 1,
    "text": "که با من بیاید به نخچیرگاه"
  },
  {
    "poem_id": 1582,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت دستان که نام تو چیست"
  },
  {
    "poem_id": 1582,
    "vorder": 46,
    "position": 1,
    "text": "همی بگذری تیز کام تو چیست"
  },
  {
    "poem_id": 1582,
    "vorder": 47,
    "position": 0,
    "text": "برآنم که تو خویش لهراسپی"
  },
  {
    "poem_id": 1582,
    "vorder": 48,
    "position": 1,
    "text": "گر از تخمهٔ شاه گشتاسپی"
  },
  {
    "poem_id": 1582,
    "vorder": 49,
    "position": 0,
    "text": "چنین داد پاسخ که من بهمنم"
  },
  {
    "poem_id": 1582,
    "vorder": 50,
    "position": 1,
    "text": "نبیرهٔ جهاندار رویین تنم"
  },
  {
    "poem_id": 1582,
    "vorder": 51,
    "position": 0,
    "text": "چو بشنید گفتار آن سرفراز"
  },
  {
    "poem_id": 1582,
    "vorder": 52,
    "position": 1,
    "text": "فرود آمد از باره بردش نماز"
  },
  {
    "poem_id": 1582,
    "vorder": 53,
    "position": 0,
    "text": "بخندید بهمن پیاده ببود"
  },
  {
    "poem_id": 1582,
    "vorder": 54,
    "position": 1,
    "text": "بپرسیدش و گفت بهمن شنود"
  },
  {
    "poem_id": 1582,
    "vorder": 55,
    "position": 0,
    "text": "بسی خواهشش کرد کایدر بایست"
  },
  {
    "poem_id": 1582,
    "vorder": 56,
    "position": 1,
    "text": "چنین تیز رفتن ترا روی نیست"
  },
  {
    "poem_id": 1582,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت فرمان اسفندیار"
  },
  {
    "poem_id": 1582,
    "vorder": 58,
    "position": 1,
    "text": "نشاید گرفتن چنین سست و خوار"
  },
  {
    "poem_id": 1582,
    "vorder": 59,
    "position": 0,
    "text": "گزین کرد مردی که دانست راه"
  },
  {
    "poem_id": 1582,
    "vorder": 60,
    "position": 1,
    "text": "فرستاده با او به نخچیرگاه"
  },
  {
    "poem_id": 1582,
    "vorder": 61,
    "position": 0,
    "text": "همی رفت پیش اندرون رهنمون"
  },
  {
    "poem_id": 1582,
    "vorder": 62,
    "position": 1,
    "text": "جهاندیده‌ای نام او شیرخون"
  },
  {
    "poem_id": 1582,
    "vorder": 63,
    "position": 0,
    "text": "به انگشت بنمود نخچیرگاه"
  },
  {
    "poem_id": 1582,
    "vorder": 64,
    "position": 1,
    "text": "هم‌اندر زمان بازگشت او ز راه"
  }
]