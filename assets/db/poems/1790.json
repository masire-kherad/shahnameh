[
  {
    "poem_id": 1790,
    "vorder": 1,
    "position": 0,
    "text": "وزان روی بهرام بیدار بود"
  },
  {
    "poem_id": 1790,
    "vorder": 2,
    "position": 1,
    "text": "سپه را ز دشمن نگهدار بود"
  },
  {
    "poem_id": 1790,
    "vorder": 3,
    "position": 0,
    "text": "شب و روز کارآگهان داشتی"
  },
  {
    "poem_id": 1790,
    "vorder": 4,
    "position": 1,
    "text": "سپه را ز دشمن نهان داشتی"
  },
  {
    "poem_id": 1790,
    "vorder": 5,
    "position": 0,
    "text": "چو آگهی آمد به بهرامشاه"
  },
  {
    "poem_id": 1790,
    "vorder": 6,
    "position": 1,
    "text": "که خاقان به مروست و چندان سپاه"
  },
  {
    "poem_id": 1790,
    "vorder": 7,
    "position": 0,
    "text": "بیاورد لشکر ز آذر گشسپ"
  },
  {
    "poem_id": 1790,
    "vorder": 8,
    "position": 1,
    "text": "همه بی‌بنه هر یکی با دو اسپ"
  },
  {
    "poem_id": 1790,
    "vorder": 9,
    "position": 0,
    "text": "قبا جوشن و ترگ رومی کلاه"
  },
  {
    "poem_id": 1790,
    "vorder": 10,
    "position": 1,
    "text": "شب و روز چون باد تازان به راه"
  },
  {
    "poem_id": 1790,
    "vorder": 11,
    "position": 0,
    "text": "همی تاخت لشکر چو از کوه سیل"
  },
  {
    "poem_id": 1790,
    "vorder": 12,
    "position": 1,
    "text": "به آمل گذشت از در اردبیل"
  },
  {
    "poem_id": 1790,
    "vorder": 13,
    "position": 0,
    "text": "ز آمل بیامد به گرگان کشید"
  },
  {
    "poem_id": 1790,
    "vorder": 14,
    "position": 1,
    "text": "همی درد و رنج بزرگان کشید"
  },
  {
    "poem_id": 1790,
    "vorder": 15,
    "position": 0,
    "text": "ز گرگان بیامد به شهر نسا"
  },
  {
    "poem_id": 1790,
    "vorder": 16,
    "position": 1,
    "text": "یکی رهنمون پیش پر کیمیا"
  },
  {
    "poem_id": 1790,
    "vorder": 17,
    "position": 0,
    "text": "به کوه و بیابان بی‌راه رفت"
  },
  {
    "poem_id": 1790,
    "vorder": 18,
    "position": 1,
    "text": "به روز و به شب‌گاه و بی‌گاه رفت"
  },
  {
    "poem_id": 1790,
    "vorder": 19,
    "position": 0,
    "text": "به روز اندرون دیده‌بان داشتی"
  },
  {
    "poem_id": 1790,
    "vorder": 20,
    "position": 1,
    "text": "به تیره شبان پاسبان داشتی"
  },
  {
    "poem_id": 1790,
    "vorder": 21,
    "position": 0,
    "text": "بدین‌سان بیامد به نزدیک مرو"
  },
  {
    "poem_id": 1790,
    "vorder": 22,
    "position": 1,
    "text": "نپرد بدان گونه پران تذرو"
  },
  {
    "poem_id": 1790,
    "vorder": 23,
    "position": 0,
    "text": "نوندی بیامد ز کارآگهان"
  },
  {
    "poem_id": 1790,
    "vorder": 24,
    "position": 1,
    "text": "که خاقان شب و روز بی‌اندهان"
  },
  {
    "poem_id": 1790,
    "vorder": 25,
    "position": 0,
    "text": "به تدبیر نخچیر کشمیهن است"
  },
  {
    "poem_id": 1790,
    "vorder": 26,
    "position": 1,
    "text": "که دستورش ازکهل اهریمنست"
  },
  {
    "poem_id": 1790,
    "vorder": 27,
    "position": 0,
    "text": "چو بهرام بشنید زان شاد شد"
  },
  {
    "poem_id": 1790,
    "vorder": 28,
    "position": 1,
    "text": "همه رنجها بر دلش باد شد"
  },
  {
    "poem_id": 1790,
    "vorder": 29,
    "position": 0,
    "text": "برآسود روزی بدان رزمگاه"
  },
  {
    "poem_id": 1790,
    "vorder": 30,
    "position": 1,
    "text": "چو آسوده‌تر گشت شاه و سپاه"
  },
  {
    "poem_id": 1790,
    "vorder": 31,
    "position": 0,
    "text": "به کشمیهن آمد به هنگام روز"
  },
  {
    "poem_id": 1790,
    "vorder": 32,
    "position": 1,
    "text": "که برزد سر از کوه گیتی فروز"
  },
  {
    "poem_id": 1790,
    "vorder": 33,
    "position": 0,
    "text": "همه گوش پرنالهٔ بوق شد"
  },
  {
    "poem_id": 1790,
    "vorder": 34,
    "position": 1,
    "text": "همه چشم پر رنگ منجوق شد"
  },
  {
    "poem_id": 1790,
    "vorder": 35,
    "position": 0,
    "text": "دهاده برآمد ز نخچیرگاه"
  },
  {
    "poem_id": 1790,
    "vorder": 36,
    "position": 1,
    "text": "پرآواز شد گوش شاه و سپاه"
  },
  {
    "poem_id": 1790,
    "vorder": 37,
    "position": 0,
    "text": "بدرید از آواز گوش هژبر"
  },
  {
    "poem_id": 1790,
    "vorder": 38,
    "position": 1,
    "text": "تو گفتی همی ژاله بارد ز ابر"
  },
  {
    "poem_id": 1790,
    "vorder": 39,
    "position": 0,
    "text": "چو خاقان ز نخچیر بیدار شد"
  },
  {
    "poem_id": 1790,
    "vorder": 40,
    "position": 1,
    "text": "به دست خزروان گرفتار شد"
  },
  {
    "poem_id": 1790,
    "vorder": 41,
    "position": 0,
    "text": "چنان شد ز خون خاک آوردگاه"
  },
  {
    "poem_id": 1790,
    "vorder": 42,
    "position": 1,
    "text": "که گفتی همی تیربارد ز ماه"
  },
  {
    "poem_id": 1790,
    "vorder": 43,
    "position": 0,
    "text": "چو سیصد تن از نامداران چین"
  },
  {
    "poem_id": 1790,
    "vorder": 44,
    "position": 1,
    "text": "گرفتند و بستند بر پشت زین"
  },
  {
    "poem_id": 1790,
    "vorder": 45,
    "position": 0,
    "text": "چو خاقان چینی گرفتار شد"
  },
  {
    "poem_id": 1790,
    "vorder": 46,
    "position": 1,
    "text": "ازان خواب آنگاه بیدار شد"
  },
  {
    "poem_id": 1790,
    "vorder": 47,
    "position": 0,
    "text": "سپهبد ز کشمیهن آمد به مرو"
  },
  {
    "poem_id": 1790,
    "vorder": 48,
    "position": 1,
    "text": "شد از تاختن چارپایان چو غرو"
  },
  {
    "poem_id": 1790,
    "vorder": 49,
    "position": 0,
    "text": "به مرو اندر از چینیان کس نماند"
  },
  {
    "poem_id": 1790,
    "vorder": 50,
    "position": 1,
    "text": "بکشتند وز جنگیان بس نماند"
  },
  {
    "poem_id": 1790,
    "vorder": 51,
    "position": 0,
    "text": "هرانکس کزیشان گریزان برفت"
  },
  {
    "poem_id": 1790,
    "vorder": 52,
    "position": 1,
    "text": "پس‌اندر همی تاخت بهرام تفت"
  },
  {
    "poem_id": 1790,
    "vorder": 53,
    "position": 0,
    "text": "برین‌سان همی‌راند فرسنگ سی"
  },
  {
    "poem_id": 1790,
    "vorder": 54,
    "position": 1,
    "text": "پس پشت او قارن پارسی"
  },
  {
    "poem_id": 1790,
    "vorder": 55,
    "position": 0,
    "text": "چو برگشت و آمد به نخچیرگاه"
  },
  {
    "poem_id": 1790,
    "vorder": 56,
    "position": 1,
    "text": "ببخشید چیز کسان بر سپاه"
  },
  {
    "poem_id": 1790,
    "vorder": 57,
    "position": 0,
    "text": "ز پیروزی چین چو سربر فراخت"
  },
  {
    "poem_id": 1790,
    "vorder": 58,
    "position": 1,
    "text": "همه کامگاری ز یزدان شناخت"
  },
  {
    "poem_id": 1790,
    "vorder": 59,
    "position": 0,
    "text": "کجا داد بر نیک و بد دستگاه"
  },
  {
    "poem_id": 1790,
    "vorder": 60,
    "position": 1,
    "text": "که دارندهٔ آفتابست و ماه"
  }
]