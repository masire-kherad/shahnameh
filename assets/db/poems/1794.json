[
  {
    "poem_id": 1794,
    "vorder": 1,
    "position": 0,
    "text": "سیوم روز بزم ردان ساختند"
  },
  {
    "poem_id": 1794,
    "vorder": 2,
    "position": 1,
    "text": "نویسنده را پیش بنشاختند"
  },
  {
    "poem_id": 1794,
    "vorder": 3,
    "position": 0,
    "text": "به می خوردن اندر چو بگشاد چهر"
  },
  {
    "poem_id": 1794,
    "vorder": 4,
    "position": 1,
    "text": "یکی نامه بنوشت شادان به مهر"
  },
  {
    "poem_id": 1794,
    "vorder": 5,
    "position": 0,
    "text": "سر نامه کرد آفرین از نخست"
  },
  {
    "poem_id": 1794,
    "vorder": 6,
    "position": 1,
    "text": "بران کو روان را به شادی بشست"
  },
  {
    "poem_id": 1794,
    "vorder": 7,
    "position": 0,
    "text": "خرد بر دل خویش پیرایه کرد"
  },
  {
    "poem_id": 1794,
    "vorder": 8,
    "position": 1,
    "text": "به رنج تن از مردمی مایه کرد"
  },
  {
    "poem_id": 1794,
    "vorder": 9,
    "position": 0,
    "text": "همه نیکویها ز یزدان شناخت"
  },
  {
    "poem_id": 1794,
    "vorder": 10,
    "position": 1,
    "text": "خرد جست و با مرد دانا بساخت"
  },
  {
    "poem_id": 1794,
    "vorder": 11,
    "position": 0,
    "text": "بدانید کز داد جز نیکویی"
  },
  {
    "poem_id": 1794,
    "vorder": 12,
    "position": 1,
    "text": "نیاید نکوبد در بدخویی"
  },
  {
    "poem_id": 1794,
    "vorder": 13,
    "position": 0,
    "text": "هرانکس که از کارداران ما"
  },
  {
    "poem_id": 1794,
    "vorder": 14,
    "position": 1,
    "text": "سرافراز و جنگی سواران ما"
  },
  {
    "poem_id": 1794,
    "vorder": 15,
    "position": 0,
    "text": "بنالد نه بیند به جز چاه و دار"
  },
  {
    "poem_id": 1794,
    "vorder": 16,
    "position": 1,
    "text": "وگر کشته بر خاک افگنده خوار"
  },
  {
    "poem_id": 1794,
    "vorder": 17,
    "position": 0,
    "text": "بکوشید تا رنجها کم کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 18,
    "position": 1,
    "text": "دل غمگنان شاد و بی‌غم کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 19,
    "position": 0,
    "text": "که گیتی فراوان نماند به کس"
  },
  {
    "poem_id": 1794,
    "vorder": 20,
    "position": 1,
    "text": "بی‌آزاری و داد جویید و بس"
  },
  {
    "poem_id": 1794,
    "vorder": 21,
    "position": 0,
    "text": "بدین گیتی اندر نشانه منم"
  },
  {
    "poem_id": 1794,
    "vorder": 22,
    "position": 1,
    "text": "سر راستی را بهانه منم"
  },
  {
    "poem_id": 1794,
    "vorder": 23,
    "position": 0,
    "text": "که چندان سپه کرد آهنگ من"
  },
  {
    "poem_id": 1794,
    "vorder": 24,
    "position": 1,
    "text": "هم آهنگ این نامدار انجمن"
  },
  {
    "poem_id": 1794,
    "vorder": 25,
    "position": 0,
    "text": "از ایدر برفتم به اندک سپاه"
  },
  {
    "poem_id": 1794,
    "vorder": 26,
    "position": 1,
    "text": "شدند آنک بدخواه بد نیک خواه"
  },
  {
    "poem_id": 1794,
    "vorder": 27,
    "position": 0,
    "text": "یکی نامداری چو خاقان چین"
  },
  {
    "poem_id": 1794,
    "vorder": 28,
    "position": 1,
    "text": "جهاندار با تاج و تخت و نگین"
  },
  {
    "poem_id": 1794,
    "vorder": 29,
    "position": 0,
    "text": "به دست من‌اندر گرفتار شد"
  },
  {
    "poem_id": 1794,
    "vorder": 30,
    "position": 1,
    "text": "سر بخت ترکان نگونسار شد"
  },
  {
    "poem_id": 1794,
    "vorder": 31,
    "position": 0,
    "text": "مرا کرد پیروز یزدان پاک"
  },
  {
    "poem_id": 1794,
    "vorder": 32,
    "position": 1,
    "text": "سر دشمنان رفت در زیر خاک"
  },
  {
    "poem_id": 1794,
    "vorder": 33,
    "position": 0,
    "text": "جز از بندگی پیشهٔ من مباد"
  },
  {
    "poem_id": 1794,
    "vorder": 34,
    "position": 1,
    "text": "جز از راست اندیشهٔ من مباد"
  },
  {
    "poem_id": 1794,
    "vorder": 35,
    "position": 0,
    "text": "نخواهم خراج از جهان هفت سال"
  },
  {
    "poem_id": 1794,
    "vorder": 36,
    "position": 1,
    "text": "اگر زیردستی بود گر همال"
  },
  {
    "poem_id": 1794,
    "vorder": 37,
    "position": 0,
    "text": "به هر کارداری و خودکامه‌ای"
  },
  {
    "poem_id": 1794,
    "vorder": 38,
    "position": 1,
    "text": "نوشتند بر پهلوی نامه‌ای"
  },
  {
    "poem_id": 1794,
    "vorder": 39,
    "position": 0,
    "text": "که از زیردستان جز از رسم و داد"
  },
  {
    "poem_id": 1794,
    "vorder": 40,
    "position": 1,
    "text": "نرانید و از بد نگیرید یاد"
  },
  {
    "poem_id": 1794,
    "vorder": 41,
    "position": 0,
    "text": "هرانکس که درویش باشد به شهر"
  },
  {
    "poem_id": 1794,
    "vorder": 42,
    "position": 1,
    "text": "که از روز شادی نیابند بهر"
  },
  {
    "poem_id": 1794,
    "vorder": 43,
    "position": 0,
    "text": "فرستید نزدیک ما نامشان"
  },
  {
    "poem_id": 1794,
    "vorder": 44,
    "position": 1,
    "text": "برآریم زان آرزو کامشان"
  },
  {
    "poem_id": 1794,
    "vorder": 45,
    "position": 0,
    "text": "دگر هرک هستند پهلونژاد"
  },
  {
    "poem_id": 1794,
    "vorder": 46,
    "position": 1,
    "text": "که گیرند از رفتن رنج یاد"
  },
  {
    "poem_id": 1794,
    "vorder": 47,
    "position": 0,
    "text": "هم از گنج ما بی‌نیازی دهید"
  },
  {
    "poem_id": 1794,
    "vorder": 48,
    "position": 1,
    "text": "خردمند را سرفرازی دهید"
  },
  {
    "poem_id": 1794,
    "vorder": 49,
    "position": 0,
    "text": "کسی را که فامست و دستش تهیست"
  },
  {
    "poem_id": 1794,
    "vorder": 50,
    "position": 1,
    "text": "به هر کار بی‌ارج و بی فرهیست"
  },
  {
    "poem_id": 1794,
    "vorder": 51,
    "position": 0,
    "text": "هم از گنج‌ماشان بتوزید فام"
  },
  {
    "poem_id": 1794,
    "vorder": 52,
    "position": 1,
    "text": "به دیوانهایشان نویسید نام"
  },
  {
    "poem_id": 1794,
    "vorder": 53,
    "position": 0,
    "text": "ز یزدان بخواهید تا هم چنین"
  },
  {
    "poem_id": 1794,
    "vorder": 54,
    "position": 1,
    "text": "دل ما بدارد به آیین و دین"
  },
  {
    "poem_id": 1794,
    "vorder": 55,
    "position": 0,
    "text": "بدین مهر ما شادمانی کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 56,
    "position": 1,
    "text": "بران مهتران مهربانی کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 57,
    "position": 0,
    "text": "همان بندگان را مدارید خوار"
  },
  {
    "poem_id": 1794,
    "vorder": 58,
    "position": 1,
    "text": "که هستند هم بندهٔ کردگار"
  },
  {
    "poem_id": 1794,
    "vorder": 59,
    "position": 0,
    "text": "کسی کش بود پایهٔ سنگیان"
  },
  {
    "poem_id": 1794,
    "vorder": 60,
    "position": 1,
    "text": "دهد کودکان را به فرهنگیان"
  },
  {
    "poem_id": 1794,
    "vorder": 61,
    "position": 0,
    "text": "به دانش روان را توانگر کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 62,
    "position": 1,
    "text": "خرد را ز تن بر سر افسر کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 63,
    "position": 0,
    "text": "ز چیز کسان دور دارید دست"
  },
  {
    "poem_id": 1794,
    "vorder": 64,
    "position": 1,
    "text": "بی‌آزار باشید و یزدان‌پرست"
  },
  {
    "poem_id": 1794,
    "vorder": 65,
    "position": 0,
    "text": "بکوشید و پیمان ما مشکنید"
  },
  {
    "poem_id": 1794,
    "vorder": 66,
    "position": 1,
    "text": "پی و بیخ و پیوند بد برکنید"
  },
  {
    "poem_id": 1794,
    "vorder": 67,
    "position": 0,
    "text": "به یزدان پناهید و فرمان کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 68,
    "position": 1,
    "text": "روان را به مهرش گروگان کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 69,
    "position": 0,
    "text": "مجویید آزار همسایگان"
  },
  {
    "poem_id": 1794,
    "vorder": 70,
    "position": 1,
    "text": "هم آن بزرگان و پرمایگان"
  },
  {
    "poem_id": 1794,
    "vorder": 71,
    "position": 0,
    "text": "هرانکس که ناچیز بد چیره گشت"
  },
  {
    "poem_id": 1794,
    "vorder": 72,
    "position": 1,
    "text": "وز اندازهٔ کهتری برگذشت"
  },
  {
    "poem_id": 1794,
    "vorder": 73,
    "position": 0,
    "text": "بزرگش مخوانید کان برتری"
  },
  {
    "poem_id": 1794,
    "vorder": 74,
    "position": 1,
    "text": "سبک بازگردد سوی کهتری"
  },
  {
    "poem_id": 1794,
    "vorder": 75,
    "position": 0,
    "text": "ز درویش چیزی مدارید باز"
  },
  {
    "poem_id": 1794,
    "vorder": 76,
    "position": 1,
    "text": "هرانکس که هست از شما بی‌نیاز"
  },
  {
    "poem_id": 1794,
    "vorder": 77,
    "position": 0,
    "text": "به پاکان گرایید و نیکی کنید"
  },
  {
    "poem_id": 1794,
    "vorder": 78,
    "position": 1,
    "text": "دل و پشت خواهندگان مشکنید"
  },
  {
    "poem_id": 1794,
    "vorder": 79,
    "position": 0,
    "text": "هران چیز کان دور گشت از پسند"
  },
  {
    "poem_id": 1794,
    "vorder": 80,
    "position": 1,
    "text": "بدان چیز نزدیک باشد گزند"
  },
  {
    "poem_id": 1794,
    "vorder": 81,
    "position": 0,
    "text": "ز دارنده بر جان آنکس درود"
  },
  {
    "poem_id": 1794,
    "vorder": 82,
    "position": 1,
    "text": "که از مردمی باشدش تار و پود"
  },
  {
    "poem_id": 1794,
    "vorder": 83,
    "position": 0,
    "text": "چو اندر نوشتند چینی حریر"
  },
  {
    "poem_id": 1794,
    "vorder": 84,
    "position": 1,
    "text": "سر خامه را کرد مشکین دبیر"
  },
  {
    "poem_id": 1794,
    "vorder": 85,
    "position": 0,
    "text": "به عنوان برش شاه گیتی نوشت"
  },
  {
    "poem_id": 1794,
    "vorder": 86,
    "position": 1,
    "text": "دل داد و دانندهٔ خوب و زشت"
  },
  {
    "poem_id": 1794,
    "vorder": 87,
    "position": 0,
    "text": "خداوند بخشایش و فر و زور"
  },
  {
    "poem_id": 1794,
    "vorder": 88,
    "position": 1,
    "text": "شهنشاه بخشنده بهرام گور"
  },
  {
    "poem_id": 1794,
    "vorder": 89,
    "position": 0,
    "text": "سوی مرزبانان فرمانبران"
  },
  {
    "poem_id": 1794,
    "vorder": 90,
    "position": 1,
    "text": "خردمند و دانا و جنگی سران"
  },
  {
    "poem_id": 1794,
    "vorder": 91,
    "position": 0,
    "text": "به هر سو نوند و سوار و هیون"
  },
  {
    "poem_id": 1794,
    "vorder": 92,
    "position": 1,
    "text": "همی رفت با نامهٔ رهنمون"
  },
  {
    "poem_id": 1794,
    "vorder": 93,
    "position": 0,
    "text": "چو آن نامه آمد به هر کشوری"
  },
  {
    "poem_id": 1794,
    "vorder": 94,
    "position": 1,
    "text": "به هر نامداری و هر مهتری"
  },
  {
    "poem_id": 1794,
    "vorder": 95,
    "position": 0,
    "text": "همی گفت هرکس که یزدان سپاس"
  },
  {
    "poem_id": 1794,
    "vorder": 96,
    "position": 1,
    "text": "که هست این جهاندار یزدان شناس"
  },
  {
    "poem_id": 1794,
    "vorder": 97,
    "position": 0,
    "text": "زن و مرد و کودک به هامون شدند"
  },
  {
    "poem_id": 1794,
    "vorder": 98,
    "position": 1,
    "text": "به هر کشور از خانه بیرون شدند"
  },
  {
    "poem_id": 1794,
    "vorder": 99,
    "position": 0,
    "text": "همی خواندند آفرین نهان"
  },
  {
    "poem_id": 1794,
    "vorder": 100,
    "position": 1,
    "text": "بران دادگر شهریار جهان"
  },
  {
    "poem_id": 1794,
    "vorder": 101,
    "position": 0,
    "text": "ازان پس به خوردن بیاراستند"
  },
  {
    "poem_id": 1794,
    "vorder": 102,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1794,
    "vorder": 103,
    "position": 0,
    "text": "یکی نیمه از روز خوردن بدی"
  },
  {
    "poem_id": 1794,
    "vorder": 104,
    "position": 1,
    "text": "دگر نیمه زو کارکردن بدی"
  },
  {
    "poem_id": 1794,
    "vorder": 105,
    "position": 0,
    "text": "همی نو به هر بامدادی پگاه"
  },
  {
    "poem_id": 1794,
    "vorder": 106,
    "position": 1,
    "text": "خروشی بدی پیش درگاه شاه"
  },
  {
    "poem_id": 1794,
    "vorder": 107,
    "position": 0,
    "text": "که هرکس که دارد خورید و دهید"
  },
  {
    "poem_id": 1794,
    "vorder": 108,
    "position": 1,
    "text": "سپاسی ز خوردن به خود برنهید"
  },
  {
    "poem_id": 1794,
    "vorder": 109,
    "position": 0,
    "text": "کسی کش نیازست آید به گنج"
  },
  {
    "poem_id": 1794,
    "vorder": 110,
    "position": 1,
    "text": "ستاند ز گنج درم سخته پنج"
  },
  {
    "poem_id": 1794,
    "vorder": 111,
    "position": 0,
    "text": "سه من تافته بادهٔ سالخورده"
  },
  {
    "poem_id": 1794,
    "vorder": 112,
    "position": 1,
    "text": "به رنگ گل نار و با رنگ زرد"
  },
  {
    "poem_id": 1794,
    "vorder": 113,
    "position": 0,
    "text": "جهانی به رامش نهادند روی"
  },
  {
    "poem_id": 1794,
    "vorder": 114,
    "position": 1,
    "text": "پرآواز میخواره شد شهر و کوی"
  },
  {
    "poem_id": 1794,
    "vorder": 115,
    "position": 0,
    "text": "چنان بد که از بید و گل افسری"
  },
  {
    "poem_id": 1794,
    "vorder": 116,
    "position": 1,
    "text": "ز دیدار او خواستندی کری"
  },
  {
    "poem_id": 1794,
    "vorder": 117,
    "position": 0,
    "text": "یکی شاخ نرگس به تای درم"
  },
  {
    "poem_id": 1794,
    "vorder": 118,
    "position": 1,
    "text": "خریدی کسی زان نگشتی دژم"
  },
  {
    "poem_id": 1794,
    "vorder": 119,
    "position": 0,
    "text": "ز شادی جوان شد دل مرد پیر"
  },
  {
    "poem_id": 1794,
    "vorder": 120,
    "position": 1,
    "text": "به چشمه درون آبها گشت شیر"
  },
  {
    "poem_id": 1794,
    "vorder": 121,
    "position": 0,
    "text": "جهانجوی کرد از جهاندار یاد"
  },
  {
    "poem_id": 1794,
    "vorder": 122,
    "position": 1,
    "text": "که یکسر جهان دید زان‌گونه شاد"
  }
]