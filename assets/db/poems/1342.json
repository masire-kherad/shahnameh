[
  {
    "poem_id": 1342,
    "vorder": 1,
    "position": 0,
    "text": "گرانمایه جمشید فرزند او"
  },
  {
    "poem_id": 1342,
    "vorder": 2,
    "position": 1,
    "text": "کمر بست یک‌دل پر از پند او"
  },
  {
    "poem_id": 1342,
    "vorder": 3,
    "position": 0,
    "text": "برآمد بر آن تخت فرّخ پدر"
  },
  {
    "poem_id": 1342,
    "vorder": 4,
    "position": 1,
    "text": "به رسم کیان بر سرش تاج زر"
  },
  {
    "poem_id": 1342,
    "vorder": 5,
    "position": 0,
    "text": "کمر بست با فرّ شاهنشهی"
  },
  {
    "poem_id": 1342,
    "vorder": 6,
    "position": 1,
    "text": "جهان گشت سرتاسر او را رهی"
  },
  {
    "poem_id": 1342,
    "vorder": 7,
    "position": 0,
    "text": "زمانه بر آسود از داوری"
  },
  {
    "poem_id": 1342,
    "vorder": 8,
    "position": 1,
    "text": "به فرمان او دیو و مرغ و پری"
  },
  {
    "poem_id": 1342,
    "vorder": 9,
    "position": 0,
    "text": "جهان را فزوده بدو آبروی"
  },
  {
    "poem_id": 1342,
    "vorder": 10,
    "position": 1,
    "text": "فروزان شده تخت شاهی بدوی"
  },
  {
    "poem_id": 1342,
    "vorder": 11,
    "position": 0,
    "text": "منم گفت با فرّهٔ ایزدی"
  },
  {
    "poem_id": 1342,
    "vorder": 12,
    "position": 1,
    "text": "همم شهریاری همم موبدی"
  },
  {
    "poem_id": 1342,
    "vorder": 13,
    "position": 0,
    "text": "بدان را ز بد دست کوته کنم"
  },
  {
    "poem_id": 1342,
    "vorder": 14,
    "position": 1,
    "text": "روان را سوی روشنی ره کنم"
  },
  {
    "poem_id": 1342,
    "vorder": 15,
    "position": 0,
    "text": "نخست آلت جنگ را دست برد"
  },
  {
    "poem_id": 1342,
    "vorder": 16,
    "position": 1,
    "text": "در نام جستن به گردان سپرد"
  },
  {
    "poem_id": 1342,
    "vorder": 17,
    "position": 0,
    "text": "به فرّ کیی نرم کرد آهنا"
  },
  {
    "poem_id": 1342,
    "vorder": 18,
    "position": 1,
    "text": "چو خود و زره کرد و چون جوشنا"
  },
  {
    "poem_id": 1342,
    "vorder": 19,
    "position": 0,
    "text": "چو خفتان و تیغ و چو برگستوان"
  },
  {
    "poem_id": 1342,
    "vorder": 20,
    "position": 1,
    "text": "همه کرد پیدا به روشن روان"
  },
  {
    "poem_id": 1342,
    "vorder": 21,
    "position": 0,
    "text": "بدین اندرون سال پنجاه رنج"
  },
  {
    "poem_id": 1342,
    "vorder": 22,
    "position": 1,
    "text": "ببرد و از این چند بنهاد گنج"
  },
  {
    "poem_id": 1342,
    "vorder": 23,
    "position": 0,
    "text": "دگر پنجه اندیشهٔ جامه کرد"
  },
  {
    "poem_id": 1342,
    "vorder": 24,
    "position": 1,
    "text": "که پوشند هنگام ننگ و نبرد"
  },
  {
    "poem_id": 1342,
    "vorder": 25,
    "position": 0,
    "text": "ز کتّان و ابریشم و موی قز"
  },
  {
    "poem_id": 1342,
    "vorder": 26,
    "position": 1,
    "text": "قصب کرد پر مایه دیبا و خز"
  },
  {
    "poem_id": 1342,
    "vorder": 27,
    "position": 0,
    "text": "بیاموختشان رشتن و تافتن"
  },
  {
    "poem_id": 1342,
    "vorder": 28,
    "position": 1,
    "text": "به تار اندرون پود را بافتن"
  },
  {
    "poem_id": 1342,
    "vorder": 29,
    "position": 0,
    "text": "چو شد بافته شستن و دوختن"
  },
  {
    "poem_id": 1342,
    "vorder": 30,
    "position": 1,
    "text": "گرفتند از او یک‌سر آموختن"
  },
  {
    "poem_id": 1342,
    "vorder": 31,
    "position": 0,
    "text": "چو این کرده شد ساز دیگر نهاد"
  },
  {
    "poem_id": 1342,
    "vorder": 32,
    "position": 1,
    "text": "زمانه بدو شاد و او نیز شاد"
  },
  {
    "poem_id": 1342,
    "vorder": 33,
    "position": 0,
    "text": "ز هر انجمن پیشه‌ور گرد کرد"
  },
  {
    "poem_id": 1342,
    "vorder": 34,
    "position": 1,
    "text": "بدین اندرون نیز پنجاه خورد"
  },
  {
    "poem_id": 1342,
    "vorder": 35,
    "position": 0,
    "text": "گروهی که کاتوزیان خوانی‌اش"
  },
  {
    "poem_id": 1342,
    "vorder": 36,
    "position": 1,
    "text": "به رسم پرستندگان دانی‌اش"
  },
  {
    "poem_id": 1342,
    "vorder": 37,
    "position": 0,
    "text": "جدا کردشان از میان گروه"
  },
  {
    "poem_id": 1342,
    "vorder": 38,
    "position": 1,
    "text": "پرستنده را جایگه کرد کوه"
  },
  {
    "poem_id": 1342,
    "vorder": 39,
    "position": 0,
    "text": "بدان تا پرستش بود کارشان"
  },
  {
    "poem_id": 1342,
    "vorder": 40,
    "position": 1,
    "text": "نوان پیش روشن جهاندارشان"
  },
  {
    "poem_id": 1342,
    "vorder": 41,
    "position": 0,
    "text": "صفی بر دگر دست بنشاندند"
  },
  {
    "poem_id": 1342,
    "vorder": 42,
    "position": 1,
    "text": "همی نام نیساریان خواندند"
  },
  {
    "poem_id": 1342,
    "vorder": 43,
    "position": 0,
    "text": "کجا شیر مردان جنگ آورند"
  },
  {
    "poem_id": 1342,
    "vorder": 44,
    "position": 1,
    "text": "فروزندهٔ لشکر و کشورند"
  },
  {
    "poem_id": 1342,
    "vorder": 45,
    "position": 0,
    "text": "کز ایشان بود تخت شاهی به جای"
  },
  {
    "poem_id": 1342,
    "vorder": 46,
    "position": 1,
    "text": "و ز ایشان بود نام مردی به پای"
  },
  {
    "poem_id": 1342,
    "vorder": 47,
    "position": 0,
    "text": "بسودی سه دیگر گره را شناس"
  },
  {
    "poem_id": 1342,
    "vorder": 48,
    "position": 1,
    "text": "کجا نیست از کس بر ایشان سپاس"
  },
  {
    "poem_id": 1342,
    "vorder": 49,
    "position": 0,
    "text": "بکارند و ورزند و خود بدروند"
  },
  {
    "poem_id": 1342,
    "vorder": 50,
    "position": 1,
    "text": "به گاه خورش سرزنش نشنوند"
  },
  {
    "poem_id": 1342,
    "vorder": 51,
    "position": 0,
    "text": "ز فرمان تن‌آزاده و ژنده‌پوش"
  },
  {
    "poem_id": 1342,
    "vorder": 52,
    "position": 1,
    "text": "ز آواز پیغاره آسوده گوش"
  },
  {
    "poem_id": 1342,
    "vorder": 53,
    "position": 0,
    "text": "تن آزاد و آباد گیتی بر اوی"
  },
  {
    "poem_id": 1342,
    "vorder": 54,
    "position": 1,
    "text": "بر آسوده از داور و گفتگوی"
  },
  {
    "poem_id": 1342,
    "vorder": 55,
    "position": 0,
    "text": "چه گفت آن سخن‌گوی آزاده مرد"
  },
  {
    "poem_id": 1342,
    "vorder": 56,
    "position": 1,
    "text": "که آزاده را کاهلی بنده کرد"
  },
  {
    "poem_id": 1342,
    "vorder": 57,
    "position": 0,
    "text": "چهارم که خوانند اهتوخوشی"
  },
  {
    "poem_id": 1342,
    "vorder": 58,
    "position": 1,
    "text": "همان دست‌ورزان ابا سرکشی"
  },
  {
    "poem_id": 1342,
    "vorder": 59,
    "position": 0,
    "text": "کجا کارشان همگنان پیشه بود"
  },
  {
    "poem_id": 1342,
    "vorder": 60,
    "position": 1,
    "text": "روانشان همیشه پر اندیشه بود"
  },
  {
    "poem_id": 1342,
    "vorder": 61,
    "position": 0,
    "text": "بدین اندرون سال پنجاه نیز"
  },
  {
    "poem_id": 1342,
    "vorder": 62,
    "position": 1,
    "text": "بخورد و بورزید و بخشید چیز"
  },
  {
    "poem_id": 1342,
    "vorder": 63,
    "position": 0,
    "text": "از این هر یکی را یکی پایگاه"
  },
  {
    "poem_id": 1342,
    "vorder": 64,
    "position": 1,
    "text": "سزاوار بگزید و بنمود راه"
  },
  {
    "poem_id": 1342,
    "vorder": 65,
    "position": 0,
    "text": "که تا هر کس اندازهٔ خویش را"
  },
  {
    "poem_id": 1342,
    "vorder": 66,
    "position": 1,
    "text": "ببیند بداند کم و بیش را"
  },
  {
    "poem_id": 1342,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود پس دیو ناپاک را"
  },
  {
    "poem_id": 1342,
    "vorder": 68,
    "position": 1,
    "text": "به آب اندر آمیختن خاک را"
  },
  {
    "poem_id": 1342,
    "vorder": 69,
    "position": 0,
    "text": "هر آنچ از گل آمد چو بشناختند"
  },
  {
    "poem_id": 1342,
    "vorder": 70,
    "position": 1,
    "text": "سبک خشت را کالبد ساختند"
  },
  {
    "poem_id": 1342,
    "vorder": 71,
    "position": 0,
    "text": "به سنگ و به گچ دیو دیوار کرد"
  },
  {
    "poem_id": 1342,
    "vorder": 72,
    "position": 1,
    "text": "نخست از بَرَش هندسی کار کرد"
  },
  {
    "poem_id": 1342,
    "vorder": 73,
    "position": 0,
    "text": "چو گرمابه و کاخ‌های بلند"
  },
  {
    "poem_id": 1342,
    "vorder": 74,
    "position": 1,
    "text": "چو ایوان که باشد پناه از گزند"
  },
  {
    "poem_id": 1342,
    "vorder": 75,
    "position": 0,
    "text": "ز خارا گهر جست یک روزگار"
  },
  {
    "poem_id": 1342,
    "vorder": 76,
    "position": 1,
    "text": "همی کرد از او روشنی خواستار"
  },
  {
    "poem_id": 1342,
    "vorder": 77,
    "position": 0,
    "text": "به چنگ آمدش چند گونه گهر"
  },
  {
    "poem_id": 1342,
    "vorder": 78,
    "position": 1,
    "text": "چو یاقوت و بیجاده و سیم و زر"
  },
  {
    "poem_id": 1342,
    "vorder": 79,
    "position": 0,
    "text": "ز خارا به افسون برون آورید"
  },
  {
    "poem_id": 1342,
    "vorder": 80,
    "position": 1,
    "text": "شد آراسته بندها را کلید"
  },
  {
    "poem_id": 1342,
    "vorder": 81,
    "position": 0,
    "text": "دگر بوی‌های خوش آورد باز"
  },
  {
    "poem_id": 1342,
    "vorder": 82,
    "position": 1,
    "text": "که دارند مردم به بویش نیاز"
  },
  {
    "poem_id": 1342,
    "vorder": 83,
    "position": 0,
    "text": "چو بان و چو کافور و چون مشک ناب"
  },
  {
    "poem_id": 1342,
    "vorder": 84,
    "position": 1,
    "text": "چو عود و چو عنبر چو روشن گلاب"
  },
  {
    "poem_id": 1342,
    "vorder": 85,
    "position": 0,
    "text": "پزشکی و درمان هر دردمند"
  },
  {
    "poem_id": 1342,
    "vorder": 86,
    "position": 1,
    "text": "در تندرستی و راه گزند"
  },
  {
    "poem_id": 1342,
    "vorder": 87,
    "position": 0,
    "text": "همان رازها کرد نیز آشکار"
  },
  {
    "poem_id": 1342,
    "vorder": 88,
    "position": 1,
    "text": "جهان را نیامد چنو خواستار"
  },
  {
    "poem_id": 1342,
    "vorder": 89,
    "position": 0,
    "text": "گذر کرد از آن پس به کشتی بر آب"
  },
  {
    "poem_id": 1342,
    "vorder": 90,
    "position": 1,
    "text": "ز کشور به کشور گرفتی شتاب"
  },
  {
    "poem_id": 1342,
    "vorder": 91,
    "position": 0,
    "text": "چنین سال پنجه برنجید نیز"
  },
  {
    "poem_id": 1342,
    "vorder": 92,
    "position": 1,
    "text": "ندید از هنر بر خرد بسته چیز"
  },
  {
    "poem_id": 1342,
    "vorder": 93,
    "position": 0,
    "text": "همه کردنی‌ها چو آمد به جای"
  },
  {
    "poem_id": 1342,
    "vorder": 94,
    "position": 1,
    "text": "ز جای مهی برتر آورد پای"
  },
  {
    "poem_id": 1342,
    "vorder": 95,
    "position": 0,
    "text": "به فرّ کیانی یکی تخت ساخت"
  },
  {
    "poem_id": 1342,
    "vorder": 96,
    "position": 1,
    "text": "چه مایه بدو گوهر اندر نشاخت"
  },
  {
    "poem_id": 1342,
    "vorder": 97,
    "position": 0,
    "text": "که چون خواستی دیو برداشتی"
  },
  {
    "poem_id": 1342,
    "vorder": 98,
    "position": 1,
    "text": "ز هامون به گردون برافراشتی"
  },
  {
    "poem_id": 1342,
    "vorder": 99,
    "position": 0,
    "text": "چو خورشید تابان میان هوا"
  },
  {
    "poem_id": 1342,
    "vorder": 100,
    "position": 1,
    "text": "نشسته بر او شاه فرمانروا"
  },
  {
    "poem_id": 1342,
    "vorder": 101,
    "position": 0,
    "text": "جهان انجمن شد بر آن تخت او"
  },
  {
    "poem_id": 1342,
    "vorder": 102,
    "position": 1,
    "text": "شگفتی فرومانده از بخت او"
  },
  {
    "poem_id": 1342,
    "vorder": 103,
    "position": 0,
    "text": "به جمشید بر گوهر افشاندند"
  },
  {
    "poem_id": 1342,
    "vorder": 104,
    "position": 1,
    "text": "مر آن روز را روز نو خواندند"
  },
  {
    "poem_id": 1342,
    "vorder": 105,
    "position": 0,
    "text": "سر سال نو هرمز فرودین"
  },
  {
    "poem_id": 1342,
    "vorder": 106,
    "position": 1,
    "text": "بر آسوده از رنج روی زمین"
  },
  {
    "poem_id": 1342,
    "vorder": 107,
    "position": 0,
    "text": "بزرگان به شادی بیاراستند"
  },
  {
    "poem_id": 1342,
    "vorder": 108,
    "position": 1,
    "text": "می و جام و رامشگران خواستند"
  },
  {
    "poem_id": 1342,
    "vorder": 109,
    "position": 0,
    "text": "چنین جشن فرخ از آن روزگار"
  },
  {
    "poem_id": 1342,
    "vorder": 110,
    "position": 1,
    "text": "به ما ماند از آن خسروان یادگار"
  },
  {
    "poem_id": 1342,
    "vorder": 111,
    "position": 0,
    "text": "چنین سال سیصد همی رفت کار"
  },
  {
    "poem_id": 1342,
    "vorder": 112,
    "position": 1,
    "text": "ندیدند مرگ اندر آن روزگار"
  },
  {
    "poem_id": 1342,
    "vorder": 113,
    "position": 0,
    "text": "ز رنج و ز بدشان نبد آگهی"
  },
  {
    "poem_id": 1342,
    "vorder": 114,
    "position": 1,
    "text": "میان بسته دیوان به سان رهی"
  },
  {
    "poem_id": 1342,
    "vorder": 115,
    "position": 0,
    "text": "به فرمان مردم نهاده دو گوش"
  },
  {
    "poem_id": 1342,
    "vorder": 116,
    "position": 1,
    "text": "ز رامش جهان پر ز آوای نوش"
  },
  {
    "poem_id": 1342,
    "vorder": 117,
    "position": 0,
    "text": "چنین تا بر آمد بر این روزگار"
  },
  {
    "poem_id": 1342,
    "vorder": 118,
    "position": 1,
    "text": "ندیدند جز خوبی از کردگار"
  },
  {
    "poem_id": 1342,
    "vorder": 119,
    "position": 0,
    "text": "جهان سربه‌سر گشت او را رهی"
  },
  {
    "poem_id": 1342,
    "vorder": 120,
    "position": 1,
    "text": "نشسته جهاندار با فرّهی"
  },
  {
    "poem_id": 1342,
    "vorder": 121,
    "position": 0,
    "text": "یکایک به تخت مهی بنگرید"
  },
  {
    "poem_id": 1342,
    "vorder": 122,
    "position": 1,
    "text": "به گیتی جز از خویشتن را ندید"
  },
  {
    "poem_id": 1342,
    "vorder": 123,
    "position": 0,
    "text": "منی کرد آن شاه یزدان شناس"
  },
  {
    "poem_id": 1342,
    "vorder": 124,
    "position": 1,
    "text": "ز یزدان بپیچید و شد ناسپاس"
  },
  {
    "poem_id": 1342,
    "vorder": 125,
    "position": 0,
    "text": "گرانمایگان را ز لشگر بخواند"
  },
  {
    "poem_id": 1342,
    "vorder": 126,
    "position": 1,
    "text": "چه مایه سخن پیش ایشان براند"
  },
  {
    "poem_id": 1342,
    "vorder": 127,
    "position": 0,
    "text": "چنین گفت با سالخورده مهان"
  },
  {
    "poem_id": 1342,
    "vorder": 128,
    "position": 1,
    "text": "که جز خویشتن را ندانم جهان"
  },
  {
    "poem_id": 1342,
    "vorder": 129,
    "position": 0,
    "text": "هنر در جهان از من آمد پدید"
  },
  {
    "poem_id": 1342,
    "vorder": 130,
    "position": 1,
    "text": "چو من نامور تخت شاهی ندید"
  },
  {
    "poem_id": 1342,
    "vorder": 131,
    "position": 0,
    "text": "جهان را به خوبی من آراستم"
  },
  {
    "poem_id": 1342,
    "vorder": 132,
    "position": 1,
    "text": "چنان است گیتی کجا خواستم"
  },
  {
    "poem_id": 1342,
    "vorder": 133,
    "position": 0,
    "text": "خور و خواب و آرامتان از من است"
  },
  {
    "poem_id": 1342,
    "vorder": 134,
    "position": 1,
    "text": "همان کوشش و کامتان از من است"
  },
  {
    "poem_id": 1342,
    "vorder": 135,
    "position": 0,
    "text": "بزرگی و دیهیم شاهی مراست"
  },
  {
    "poem_id": 1342,
    "vorder": 136,
    "position": 1,
    "text": "که گوید که جز من کسی پادشاست"
  },
  {
    "poem_id": 1342,
    "vorder": 137,
    "position": 0,
    "text": "همه موبدان سرفگنده نگون"
  },
  {
    "poem_id": 1342,
    "vorder": 138,
    "position": 1,
    "text": "چرا کس نیارست گفتن نه چون"
  },
  {
    "poem_id": 1342,
    "vorder": 139,
    "position": 0,
    "text": "چو این گفته شد فرّ یزدان از اوی"
  },
  {
    "poem_id": 1342,
    "vorder": 140,
    "position": 1,
    "text": "بگشت و جهان شد پر از گفت‌وگوی"
  },
  {
    "poem_id": 1342,
    "vorder": 141,
    "position": 0,
    "text": "منی چون بپیوست با کردگار"
  },
  {
    "poem_id": 1342,
    "vorder": 142,
    "position": 1,
    "text": "شکست اندر آورد و برگشت کار"
  },
  {
    "poem_id": 1342,
    "vorder": 143,
    "position": 0,
    "text": "چه گفت آن سخن‌گوی با فرّ و هوش"
  },
  {
    "poem_id": 1342,
    "vorder": 144,
    "position": 1,
    "text": "چو خسرو شوی بندگی را بکوش"
  },
  {
    "poem_id": 1342,
    "vorder": 145,
    "position": 0,
    "text": "به یزدان هر آن کس که شد ناسپاس"
  },
  {
    "poem_id": 1342,
    "vorder": 146,
    "position": 1,
    "text": "به دلش اندر آید ز هر سو هراس"
  },
  {
    "poem_id": 1342,
    "vorder": 147,
    "position": 0,
    "text": "به جمشید بر تیره‌گون گشت روز"
  },
  {
    "poem_id": 1342,
    "vorder": 148,
    "position": 1,
    "text": "همی کاست آن فرّ گیتی‌فروز"
  }
