[
  {
    "poem_id": 1887,
    "vorder": 1,
    "position": 0,
    "text": "ز لشکر بسی زینهاری شدند"
  },
  {
    "poem_id": 1887,
    "vorder": 2,
    "position": 1,
    "text": "به نزدیک خاقان به زاری شدند"
  },
  {
    "poem_id": 1887,
    "vorder": 3,
    "position": 0,
    "text": "برادر بیامد به نزدیک اوی"
  },
  {
    "poem_id": 1887,
    "vorder": 4,
    "position": 1,
    "text": "که ای نامور مهتر جنگ جوی"
  },
  {
    "poem_id": 1887,
    "vorder": 5,
    "position": 0,
    "text": "سپاه دلاور به ایران کشید"
  },
  {
    "poem_id": 1887,
    "vorder": 6,
    "position": 1,
    "text": "بسی زینهاری بر ما رسید"
  },
  {
    "poem_id": 1887,
    "vorder": 7,
    "position": 0,
    "text": "ازین ننگ تا جاودان بر درت"
  },
  {
    "poem_id": 1887,
    "vorder": 8,
    "position": 1,
    "text": "بخندد همی لشکر و کشورت"
  },
  {
    "poem_id": 1887,
    "vorder": 9,
    "position": 0,
    "text": "سپهدار چین کان سخنها شنید"
  },
  {
    "poem_id": 1887,
    "vorder": 10,
    "position": 1,
    "text": "شد از خشم رنگ رخش ناپدید"
  },
  {
    "poem_id": 1887,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت بشتاب و برکش سپاه"
  },
  {
    "poem_id": 1887,
    "vorder": 12,
    "position": 1,
    "text": "نگه کن که لشکر کجا شد به راه"
  },
  {
    "poem_id": 1887,
    "vorder": 13,
    "position": 0,
    "text": "بریشان رسی هیچ تندی مکن"
  },
  {
    "poem_id": 1887,
    "vorder": 14,
    "position": 1,
    "text": "نخستین فراز آر شیرین سخن"
  },
  {
    "poem_id": 1887,
    "vorder": 15,
    "position": 0,
    "text": "ازیشان نداند کسی راه ما"
  },
  {
    "poem_id": 1887,
    "vorder": 16,
    "position": 1,
    "text": "مگر بشکنی پشت بدخواه ما"
  },
  {
    "poem_id": 1887,
    "vorder": 17,
    "position": 0,
    "text": "به خوبی سخن گوی و بنوازشان"
  },
  {
    "poem_id": 1887,
    "vorder": 18,
    "position": 1,
    "text": "به مردانگی سر بر افرازشان"
  },
  {
    "poem_id": 1887,
    "vorder": 19,
    "position": 0,
    "text": "وگر هیچ سازد کسی با تو جنگ"
  },
  {
    "poem_id": 1887,
    "vorder": 20,
    "position": 1,
    "text": "تو مردی کن و دور باش از درنگ"
  },
  {
    "poem_id": 1887,
    "vorder": 21,
    "position": 0,
    "text": "ازیشان یکی گورستان کن به مرو"
  },
  {
    "poem_id": 1887,
    "vorder": 22,
    "position": 1,
    "text": "که گردد زمین همچو پر تذرو"
  },
  {
    "poem_id": 1887,
    "vorder": 23,
    "position": 0,
    "text": "بیامد سپهدار با شش هزار"
  },
  {
    "poem_id": 1887,
    "vorder": 24,
    "position": 1,
    "text": "گزیده ز ترکان جنگی سوار"
  },
  {
    "poem_id": 1887,
    "vorder": 25,
    "position": 0,
    "text": "به روز چهارم بریشان رسید"
  },
  {
    "poem_id": 1887,
    "vorder": 26,
    "position": 1,
    "text": "زن شیر دل چون سپه را بدید"
  },
  {
    "poem_id": 1887,
    "vorder": 27,
    "position": 0,
    "text": "ازیشان به دل بر نکرد ایچ یاد"
  },
  {
    "poem_id": 1887,
    "vorder": 28,
    "position": 1,
    "text": "زلشکر سوی ساربان شد چوباد"
  },
  {
    "poem_id": 1887,
    "vorder": 29,
    "position": 0,
    "text": "یکایک بنه از پس پشت کرد"
  },
  {
    "poem_id": 1887,
    "vorder": 30,
    "position": 1,
    "text": "بیامد نگه کرد جای نبرد"
  },
  {
    "poem_id": 1887,
    "vorder": 31,
    "position": 0,
    "text": "سلیح برادر به پوشید زن"
  },
  {
    "poem_id": 1887,
    "vorder": 32,
    "position": 1,
    "text": "نشست از بر باره گام زن"
  },
  {
    "poem_id": 1887,
    "vorder": 33,
    "position": 0,
    "text": "دو لشکر برابر کشیدند صف"
  },
  {
    "poem_id": 1887,
    "vorder": 34,
    "position": 1,
    "text": "همه جانها برنهاده به کف"
  },
  {
    "poem_id": 1887,
    "vorder": 35,
    "position": 0,
    "text": "به پیش سپاه اندر آمد تبرگ"
  },
  {
    "poem_id": 1887,
    "vorder": 36,
    "position": 1,
    "text": "که خاقان ورا خواندی پیر گرگ"
  },
  {
    "poem_id": 1887,
    "vorder": 37,
    "position": 0,
    "text": "به ایرانیان گفت کان پاک زن"
  },
  {
    "poem_id": 1887,
    "vorder": 38,
    "position": 1,
    "text": "مگر نیست با این بزرگ انجمن"
  },
  {
    "poem_id": 1887,
    "vorder": 39,
    "position": 0,
    "text": "بشد گردیه با سلیح گران"
  },
  {
    "poem_id": 1887,
    "vorder": 40,
    "position": 1,
    "text": "میان بسته برسان جنگاوران"
  },
  {
    "poem_id": 1887,
    "vorder": 41,
    "position": 0,
    "text": "دلاور تبرگش ندانست باز"
  },
  {
    "poem_id": 1887,
    "vorder": 42,
    "position": 1,
    "text": "بزد پاشنه شد بر او فراز"
  },
  {
    "poem_id": 1887,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت کان خواهرکشته شاه"
  },
  {
    "poem_id": 1887,
    "vorder": 44,
    "position": 1,
    "text": "کجا جویمش در میان سپاه"
  },
  {
    "poem_id": 1887,
    "vorder": 45,
    "position": 0,
    "text": "که با او مرا هست چندی سخن"
  },
  {
    "poem_id": 1887,
    "vorder": 46,
    "position": 1,
    "text": "چه از نو چه از روزگار کهن"
  },
  {
    "poem_id": 1887,
    "vorder": 47,
    "position": 0,
    "text": "بدو گردیه گفت اینک منم"
  },
  {
    "poem_id": 1887,
    "vorder": 48,
    "position": 1,
    "text": "که بر شیر درنده اسپ افگنم"
  },
  {
    "poem_id": 1887,
    "vorder": 49,
    "position": 0,
    "text": "چو بشنید آواز او را تبرگ"
  },
  {
    "poem_id": 1887,
    "vorder": 50,
    "position": 1,
    "text": "بران اسپ جنگی چو شیر سترگ"
  },
  {
    "poem_id": 1887,
    "vorder": 51,
    "position": 0,
    "text": "شگفت آمدش گفت خاقان چین"
  },
  {
    "poem_id": 1887,
    "vorder": 52,
    "position": 1,
    "text": "تو را کرد زین پادشاهی گزین"
  },
  {
    "poem_id": 1887,
    "vorder": 53,
    "position": 0,
    "text": "بدان تا تو باشی ورا یادگار"
  },
  {
    "poem_id": 1887,
    "vorder": 54,
    "position": 1,
    "text": "ز بهرام شیر آن گزیده سوار"
  },
  {
    "poem_id": 1887,
    "vorder": 55,
    "position": 0,
    "text": "همی‌گفت پاداش آن نیکوی"
  },
  {
    "poem_id": 1887,
    "vorder": 56,
    "position": 1,
    "text": "بجای آورم چون سخن بشنوی"
  },
  {
    "poem_id": 1887,
    "vorder": 57,
    "position": 0,
    "text": "مرا گفت بشتاب و او را بگوی"
  },
  {
    "poem_id": 1887,
    "vorder": 58,
    "position": 1,
    "text": "که گر زآنک گفتم ندیدی تو روی"
  },
  {
    "poem_id": 1887,
    "vorder": 59,
    "position": 0,
    "text": "چنان دان که این خود نگفتم ز بن"
  },
  {
    "poem_id": 1887,
    "vorder": 60,
    "position": 1,
    "text": "مگر نیز باز آمدم زان سخن"
  },
  {
    "poem_id": 1887,
    "vorder": 61,
    "position": 0,
    "text": "ازین مرز رفتن مرا روی نیست"
  },
  {
    "poem_id": 1887,
    "vorder": 62,
    "position": 1,
    "text": "مکن آرزو گر تو را شوی نیست"
  },
  {
    "poem_id": 1887,
    "vorder": 63,
    "position": 0,
    "text": "سخنها برین گونه پیوند کن"
  },
  {
    "poem_id": 1887,
    "vorder": 64,
    "position": 1,
    "text": "وگر پند نپذیردت بند کن"
  },
  {
    "poem_id": 1887,
    "vorder": 65,
    "position": 0,
    "text": "همان را که او را بدان داشتست"
  },
  {
    "poem_id": 1887,
    "vorder": 66,
    "position": 1,
    "text": "سخنها ز اندازه بگذاشتست"
  },
  {
    "poem_id": 1887,
    "vorder": 67,
    "position": 0,
    "text": "بدو گردیه گفت کز رزمگاه"
  },
  {
    "poem_id": 1887,
    "vorder": 68,
    "position": 1,
    "text": "به یکسو شویم از میان سپاه"
  },
  {
    "poem_id": 1887,
    "vorder": 69,
    "position": 0,
    "text": "سخن هرچ گفتی تو پاسخ دهم"
  },
  {
    "poem_id": 1887,
    "vorder": 70,
    "position": 1,
    "text": "تو را اندرین رای فرخ نهم"
  },
  {
    "poem_id": 1887,
    "vorder": 71,
    "position": 0,
    "text": "ز پیش سپاه اندر آمد تبرگ"
  },
  {
    "poem_id": 1887,
    "vorder": 72,
    "position": 1,
    "text": "بیامد بر نامدار سترگ"
  },
  {
    "poem_id": 1887,
    "vorder": 73,
    "position": 0,
    "text": "چو تنها بدیدش زن چاره جوی"
  },
  {
    "poem_id": 1887,
    "vorder": 74,
    "position": 1,
    "text": "از آن مغفر تیره بگشاد روی"
  },
  {
    "poem_id": 1887,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت بهرام را دیده‌ای"
  },
  {
    "poem_id": 1887,
    "vorder": 76,
    "position": 1,
    "text": "سواری و رزمش پسندیده ای"
  },
  {
    "poem_id": 1887,
    "vorder": 77,
    "position": 0,
    "text": "مرا بود هم مادر و هم پدر"
  },
  {
    "poem_id": 1887,
    "vorder": 78,
    "position": 1,
    "text": "کنون روزگار وی آمد به سر"
  },
  {
    "poem_id": 1887,
    "vorder": 79,
    "position": 0,
    "text": "کنون من تو را آزمایش کنم"
  },
  {
    "poem_id": 1887,
    "vorder": 80,
    "position": 1,
    "text": "یکی سوی رزمت نمایش کنم"
  },
  {
    "poem_id": 1887,
    "vorder": 81,
    "position": 0,
    "text": "اگر از در شوی یابی بگوی"
  },
  {
    "poem_id": 1887,
    "vorder": 82,
    "position": 1,
    "text": "همانا مرا خود پسندست شوی"
  },
  {
    "poem_id": 1887,
    "vorder": 83,
    "position": 0,
    "text": "بگفت این وزان پس برانگیخت اسپ"
  },
  {
    "poem_id": 1887,
    "vorder": 84,
    "position": 1,
    "text": "پس او همی‌تاخت ایزد گشسپ"
  },
  {
    "poem_id": 1887,
    "vorder": 85,
    "position": 0,
    "text": "یکی نیزه زد بر کمربند اوی"
  },
  {
    "poem_id": 1887,
    "vorder": 86,
    "position": 1,
    "text": "که بگسست خفتان و پیوند اوی"
  },
  {
    "poem_id": 1887,
    "vorder": 87,
    "position": 0,
    "text": "یلان سینه با آن گزیده سپاه"
  },
  {
    "poem_id": 1887,
    "vorder": 88,
    "position": 1,
    "text": "برانگیخت اسپ اندر آن رزمگاه"
  },
  {
    "poem_id": 1887,
    "vorder": 89,
    "position": 0,
    "text": "همه لشکر چین بهم بر شکست"
  },
  {
    "poem_id": 1887,
    "vorder": 90,
    "position": 1,
    "text": "بسی کشت و افگند و چندی بخست"
  },
  {
    "poem_id": 1887,
    "vorder": 91,
    "position": 0,
    "text": "دو فرسنگ لشکر همی‌شد ز پس"
  },
  {
    "poem_id": 1887,
    "vorder": 92,
    "position": 1,
    "text": "بر اسپان نماندند بسیار کس"
  },
  {
    "poem_id": 1887,
    "vorder": 93,
    "position": 0,
    "text": "سراسر همه دشت شد رود خون"
  },
  {
    "poem_id": 1887,
    "vorder": 94,
    "position": 1,
    "text": "یکی بی‌سر و دیگری سرنگون"
  }
]