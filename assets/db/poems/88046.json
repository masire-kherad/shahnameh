[
  {
    "poem_id": 88046,
    "vorder": 1,
    "position": 0,
    "text": "چهارم فروهل بد و زنگله"
  },
  {
    "poem_id": 88046,
    "vorder": 2,
    "position": 1,
    "text": "دو جنگی به کردار شیر یله"
  },
  {
    "poem_id": 88046,
    "vorder": 3,
    "position": 0,
    "text": "به ایران نبرده به تیر و کمان"
  },
  {
    "poem_id": 88046,
    "vorder": 4,
    "position": 1,
    "text": "نبد چون فروهل دگر بدگمان"
  },
  {
    "poem_id": 88046,
    "vorder": 5,
    "position": 0,
    "text": "چو از دور ترک دژم را بدید"
  },
  {
    "poem_id": 88046,
    "vorder": 6,
    "position": 1,
    "text": "کمان را به زه کرد و اندر کشید"
  },
  {
    "poem_id": 88046,
    "vorder": 7,
    "position": 0,
    "text": "برآورد زان تیرهای خدنگ"
  },
  {
    "poem_id": 88046,
    "vorder": 8,
    "position": 1,
    "text": "گرفته کمان رفت پیشش به جنگ"
  },
  {
    "poem_id": 88046,
    "vorder": 9,
    "position": 0,
    "text": "ابر زنگله تیرباران گرفت"
  },
  {
    "poem_id": 88046,
    "vorder": 10,
    "position": 1,
    "text": "ز هر سو کمین سواران گرفت"
  },
  {
    "poem_id": 88046,
    "vorder": 11,
    "position": 0,
    "text": "خدنگی به رانش برآمد چو باد"
  },
  {
    "poem_id": 88046,
    "vorder": 12,
    "position": 1,
    "text": "که بگذشت بر مرد و بر اسب شاد"
  },
  {
    "poem_id": 88046,
    "vorder": 13,
    "position": 0,
    "text": "به روی اندر آمد تگاور ز درد"
  },
  {
    "poem_id": 88046,
    "vorder": 14,
    "position": 1,
    "text": "جدا شد از او زنگله روی زرد"
  },
  {
    "poem_id": 88046,
    "vorder": 15,
    "position": 0,
    "text": "نگون شد سر زنگله جان بداد"
  },
  {
    "poem_id": 88046,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی همانا ز مادر نزاد"
  },
  {
    "poem_id": 88046,
    "vorder": 17,
    "position": 0,
    "text": "فروهل فروجست و ببرید سر"
  },
  {
    "poem_id": 88046,
    "vorder": 18,
    "position": 1,
    "text": "برون کرد خفتان رومی ز بر"
  },
  {
    "poem_id": 88046,
    "vorder": 19,
    "position": 0,
    "text": "سرش را به فتراک زین برببست"
  },
  {
    "poem_id": 88046,
    "vorder": 20,
    "position": 1,
    "text": "بیامد گرفت اسب او را به دست"
  },
  {
    "poem_id": 88046,
    "vorder": 21,
    "position": 0,
    "text": "به بالا برآمد به سان پلنگ"
  },
  {
    "poem_id": 88046,
    "vorder": 22,
    "position": 1,
    "text": "به خون غرقه گشته بر و تیغ و چنگ"
  },
  {
    "poem_id": 88046,
    "vorder": 23,
    "position": 0,
    "text": "درفش خجسته برآورد راست"
  },
  {
    "poem_id": 88046,
    "vorder": 24,
    "position": 1,
    "text": "شده شادمان یافته هرچ خواست"
  },
  {
    "poem_id": 88046,
    "vorder": 25,
    "position": 0,
    "text": "خروشید زان پس که پیروز باد"
  },
  {
    "poem_id": 88046,
    "vorder": 26,
    "position": 1,
    "text": "سر خسروان شاه فرخ نژاد"
  }
]