[
  {
    "poem_id": 1441,
    "vorder": 1,
    "position": 0,
    "text": "یکی نامه‌ای بر حریر سپید"
  },
  {
    "poem_id": 1441,
    "vorder": 2,
    "position": 1,
    "text": "بدو اندرون چند بیم و امید"
  },
  {
    "poem_id": 1441,
    "vorder": 3,
    "position": 0,
    "text": "دبیری خردمند بنوشت خوب"
  },
  {
    "poem_id": 1441,
    "vorder": 4,
    "position": 1,
    "text": "پدید آورید اندرو زشت و خوب"
  },
  {
    "poem_id": 1441,
    "vorder": 5,
    "position": 0,
    "text": "نخست آفرین کرد بر دادگر"
  },
  {
    "poem_id": 1441,
    "vorder": 6,
    "position": 1,
    "text": "کزو دید پیدا به گیتی هنر"
  },
  {
    "poem_id": 1441,
    "vorder": 7,
    "position": 0,
    "text": "خرد داد و گردان سپهر آفرید"
  },
  {
    "poem_id": 1441,
    "vorder": 8,
    "position": 1,
    "text": "درشتی و تندی و مهر آفرید"
  },
  {
    "poem_id": 1441,
    "vorder": 9,
    "position": 0,
    "text": "به نیک و به بد دادمان دستگاه"
  },
  {
    "poem_id": 1441,
    "vorder": 10,
    "position": 1,
    "text": "خداوند گردنده خورشید و ماه"
  },
  {
    "poem_id": 1441,
    "vorder": 11,
    "position": 0,
    "text": "اگر دادگر باشی و پاک دین"
  },
  {
    "poem_id": 1441,
    "vorder": 12,
    "position": 1,
    "text": "ز هر کس نیابی به جز آفرین"
  },
  {
    "poem_id": 1441,
    "vorder": 13,
    "position": 0,
    "text": "وگر بدنشان باشی و بدکنش"
  },
  {
    "poem_id": 1441,
    "vorder": 14,
    "position": 1,
    "text": "ز چرخ بلند آیدت سرزنش"
  },
  {
    "poem_id": 1441,
    "vorder": 15,
    "position": 0,
    "text": "جهاندار اگر دادگر باشدی"
  },
  {
    "poem_id": 1441,
    "vorder": 16,
    "position": 1,
    "text": "ز فرمان او کی گذر باشدی"
  },
  {
    "poem_id": 1441,
    "vorder": 17,
    "position": 0,
    "text": "سزای تو دیدی که یزدان چه کرد"
  },
  {
    "poem_id": 1441,
    "vorder": 18,
    "position": 1,
    "text": "ز دیو و ز جادو برآورد گرد"
  },
  {
    "poem_id": 1441,
    "vorder": 19,
    "position": 0,
    "text": "کنون گر شوی آگه از روزگار"
  },
  {
    "poem_id": 1441,
    "vorder": 20,
    "position": 1,
    "text": "روان و خرد بادت آموزگار"
  },
  {
    "poem_id": 1441,
    "vorder": 21,
    "position": 0,
    "text": "همانجا بمان تاج مازندران"
  },
  {
    "poem_id": 1441,
    "vorder": 22,
    "position": 1,
    "text": "بدین بارگاه آی چون کهتران"
  },
  {
    "poem_id": 1441,
    "vorder": 23,
    "position": 0,
    "text": "که با چنگ رستم ندارید تاو"
  },
  {
    "poem_id": 1441,
    "vorder": 24,
    "position": 1,
    "text": "بده زود بر کام ما باژ و ساو"
  },
  {
    "poem_id": 1441,
    "vorder": 25,
    "position": 0,
    "text": "وگر گاه مازندران بایدت"
  },
  {
    "poem_id": 1441,
    "vorder": 26,
    "position": 1,
    "text": "مگر زین نشان راه بگشایدت"
  },
  {
    "poem_id": 1441,
    "vorder": 27,
    "position": 0,
    "text": "وگرنه چو ارژنگ و دیو سپید"
  },
  {
    "poem_id": 1441,
    "vorder": 28,
    "position": 1,
    "text": "دلت کرد باید ز جان ناامید"
  },
  {
    "poem_id": 1441,
    "vorder": 29,
    "position": 0,
    "text": "بخواند آن زمان شاه فرهاد را"
  },
  {
    "poem_id": 1441,
    "vorder": 30,
    "position": 1,
    "text": "گرایندهٔ تیغ پولاد را"
  },
  {
    "poem_id": 1441,
    "vorder": 31,
    "position": 0,
    "text": "گزین بزرگان آن شهر بود"
  },
  {
    "poem_id": 1441,
    "vorder": 32,
    "position": 1,
    "text": "ز بی‌کاری و رنج بی‌بهر بود"
  },
  {
    "poem_id": 1441,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت کاین نامهٔ پندمند"
  },
  {
    "poem_id": 1441,
    "vorder": 34,
    "position": 1,
    "text": "ببر سوی آن دیو جسته ز بند"
  },
  {
    "poem_id": 1441,
    "vorder": 35,
    "position": 0,
    "text": "چو از شاه بشنید فرهاد گرد"
  },
  {
    "poem_id": 1441,
    "vorder": 36,
    "position": 1,
    "text": "زمین را ببوسید و نامه ببرد"
  },
  {
    "poem_id": 1441,
    "vorder": 37,
    "position": 0,
    "text": "به شهری کجا سست پایان بدند"
  },
  {
    "poem_id": 1441,
    "vorder": 38,
    "position": 1,
    "text": "سواران پولادخایان بدند"
  },
  {
    "poem_id": 1441,
    "vorder": 39,
    "position": 0,
    "text": "هم آنکس که بودند پا از دوال"
  },
  {
    "poem_id": 1441,
    "vorder": 40,
    "position": 1,
    "text": "لقبشان چنین بود بسیار سال"
  },
  {
    "poem_id": 1441,
    "vorder": 41,
    "position": 0,
    "text": "بدان شهر بد شاه مازندران"
  },
  {
    "poem_id": 1441,
    "vorder": 42,
    "position": 1,
    "text": "هم آنجا دلیران و کندآوران"
  },
  {
    "poem_id": 1441,
    "vorder": 43,
    "position": 0,
    "text": "چو بشنید کز نزد کاووس شاه"
  },
  {
    "poem_id": 1441,
    "vorder": 44,
    "position": 1,
    "text": "فرستاده‌ای باهش آمد ز راه"
  },
  {
    "poem_id": 1441,
    "vorder": 45,
    "position": 0,
    "text": "پذیره شدن را سپاه گران"
  },
  {
    "poem_id": 1441,
    "vorder": 46,
    "position": 1,
    "text": "دلیران و شیران مازندران"
  },
  {
    "poem_id": 1441,
    "vorder": 47,
    "position": 0,
    "text": "ز لشکر یکایک همه برگزید"
  },
  {
    "poem_id": 1441,
    "vorder": 48,
    "position": 1,
    "text": "ازیشان هنر خواست کاید پدید"
  },
  {
    "poem_id": 1441,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت کامروز فرزانگی"
  },
  {
    "poem_id": 1441,
    "vorder": 50,
    "position": 1,
    "text": "جدا کرد نتوان ز دیوانگی"
  },
  {
    "poem_id": 1441,
    "vorder": 51,
    "position": 0,
    "text": "همه راه و رسم پلنگ آورید"
  },
  {
    "poem_id": 1441,
    "vorder": 52,
    "position": 1,
    "text": "سر هوشمندان به چنگ آورید"
  },
  {
    "poem_id": 1441,
    "vorder": 53,
    "position": 0,
    "text": "پذیره شدندش پر از چین به روی"
  },
  {
    "poem_id": 1441,
    "vorder": 54,
    "position": 1,
    "text": "سخنشان نرفت ایچ بر آرزوی"
  },
  {
    "poem_id": 1441,
    "vorder": 55,
    "position": 0,
    "text": "یکی دست بگرفت و بفشاردش"
  },
  {
    "poem_id": 1441,
    "vorder": 56,
    "position": 1,
    "text": "پی و استخوانها بیازاردش"
  },
  {
    "poem_id": 1441,
    "vorder": 57,
    "position": 0,
    "text": "نگشت ایچ فرهاد را روی زرد"
  },
  {
    "poem_id": 1441,
    "vorder": 58,
    "position": 1,
    "text": "نیامد برو رنج بسیار و درد"
  },
  {
    "poem_id": 1441,
    "vorder": 59,
    "position": 0,
    "text": "ببردند فرهاد را نزد شاه"
  },
  {
    "poem_id": 1441,
    "vorder": 60,
    "position": 1,
    "text": "ز کاووس پرسید و ز رنج راه"
  },
  {
    "poem_id": 1441,
    "vorder": 61,
    "position": 0,
    "text": "پس آن نامه بنهاد پیش دبیر"
  },
  {
    "poem_id": 1441,
    "vorder": 62,
    "position": 1,
    "text": "می و مشک انداخته پر حریر"
  },
  {
    "poem_id": 1441,
    "vorder": 63,
    "position": 0,
    "text": "چو آگه شد از رستم و کار دیو"
  },
  {
    "poem_id": 1441,
    "vorder": 64,
    "position": 1,
    "text": "پر از خون شدش دیده دل پرغریو"
  },
  {
    "poem_id": 1441,
    "vorder": 65,
    "position": 0,
    "text": "به دل گفت پنهان شود آفتاب"
  },
  {
    "poem_id": 1441,
    "vorder": 66,
    "position": 1,
    "text": "شب آید بود گاه آرام و خواب"
  },
  {
    "poem_id": 1441,
    "vorder": 67,
    "position": 0,
    "text": "ز رستم نخواهد جهان آرمید"
  },
  {
    "poem_id": 1441,
    "vorder": 68,
    "position": 1,
    "text": "نخواهد شدن نام او ناپدید"
  },
  {
    "poem_id": 1441,
    "vorder": 69,
    "position": 0,
    "text": "غمی گشت از ارژنگ و دیو سپید"
  },
  {
    "poem_id": 1441,
    "vorder": 70,
    "position": 1,
    "text": "که شد کشته پولاد غندی و بید"
  },
  {
    "poem_id": 1441,
    "vorder": 71,
    "position": 0,
    "text": "چو آن نامهٔ شاه یکسر بخواند"
  },
  {
    "poem_id": 1441,
    "vorder": 72,
    "position": 1,
    "text": "دو دیده به خون دل اندر نشاند"
  }
]