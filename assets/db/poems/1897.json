[
  {
    "poem_id": 1897,
    "vorder": 1,
    "position": 0,
    "text": "چو بر پادشاهیش شد پنج‌سال"
  },
  {
    "poem_id": 1897,
    "vorder": 2,
    "position": 1,
    "text": "به گیتی نبودش سراسر همال"
  },
  {
    "poem_id": 1897,
    "vorder": 3,
    "position": 0,
    "text": "ششم سال زان دخت قیصر چو ماه"
  },
  {
    "poem_id": 1897,
    "vorder": 4,
    "position": 1,
    "text": "یکی پورش آمد همانند شاه"
  },
  {
    "poem_id": 1897,
    "vorder": 5,
    "position": 0,
    "text": "نبود آن زمان رسم بانگ نماز"
  },
  {
    "poem_id": 1897,
    "vorder": 6,
    "position": 1,
    "text": "به گوش چنان پروریده بناز"
  },
  {
    "poem_id": 1897,
    "vorder": 7,
    "position": 0,
    "text": "یکی نام گفتی مر او را پدر"
  },
  {
    "poem_id": 1897,
    "vorder": 8,
    "position": 1,
    "text": "نهانی دگر آشکارا دگر"
  },
  {
    "poem_id": 1897,
    "vorder": 9,
    "position": 0,
    "text": "نهانی به گفتی بگوش اندرون"
  },
  {
    "poem_id": 1897,
    "vorder": 10,
    "position": 1,
    "text": "همی‌خواندی آشکارا برون"
  },
  {
    "poem_id": 1897,
    "vorder": 11,
    "position": 0,
    "text": "بگوش اندرون خواند خسرو قباد"
  },
  {
    "poem_id": 1897,
    "vorder": 12,
    "position": 1,
    "text": "همی‌گفت شیر وی فرخ نژاد"
  },
  {
    "poem_id": 1897,
    "vorder": 13,
    "position": 0,
    "text": "چو شب کودک آمد گذشته سه پاس"
  },
  {
    "poem_id": 1897,
    "vorder": 14,
    "position": 1,
    "text": "بیامد بر خسرو اخترشناس"
  },
  {
    "poem_id": 1897,
    "vorder": 15,
    "position": 0,
    "text": "از اخترشناسان بپرسید شاه"
  },
  {
    "poem_id": 1897,
    "vorder": 16,
    "position": 1,
    "text": "که هرکس که دارند اختر نگاه"
  },
  {
    "poem_id": 1897,
    "vorder": 17,
    "position": 0,
    "text": "بدیدی که فرجام این کار چیست"
  },
  {
    "poem_id": 1897,
    "vorder": 18,
    "position": 1,
    "text": "ز زیچ اختر این جهاندار چیست"
  },
  {
    "poem_id": 1897,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ ستاره شمر"
  },
  {
    "poem_id": 1897,
    "vorder": 20,
    "position": 1,
    "text": "که بر چرخ گردان نیابی گذر"
  },
  {
    "poem_id": 1897,
    "vorder": 21,
    "position": 0,
    "text": "ازین کودک آشوب گیرد زمین"
  },
  {
    "poem_id": 1897,
    "vorder": 22,
    "position": 1,
    "text": "نخواند سپاهت برو آفرین"
  },
  {
    "poem_id": 1897,
    "vorder": 23,
    "position": 0,
    "text": "هم از راه یزدان بگردد به نیز"
  },
  {
    "poem_id": 1897,
    "vorder": 24,
    "position": 1,
    "text": "ازین بیشتر چون سراییم چیز"
  },
  {
    "poem_id": 1897,
    "vorder": 25,
    "position": 0,
    "text": "دل شاه غمگین شد از کارشان"
  },
  {
    "poem_id": 1897,
    "vorder": 26,
    "position": 1,
    "text": "وزان ناسزاوار گفتارشان"
  },
  {
    "poem_id": 1897,
    "vorder": 27,
    "position": 0,
    "text": "چنین گفت با مرد داننده شاه"
  },
  {
    "poem_id": 1897,
    "vorder": 28,
    "position": 1,
    "text": "که نیکو کنید اندر اختر نگاه"
  },
  {
    "poem_id": 1897,
    "vorder": 29,
    "position": 0,
    "text": "نگر تا نگردد زبانتان برین"
  },
  {
    "poem_id": 1897,
    "vorder": 30,
    "position": 1,
    "text": "به پیش بزرگان ایران زمین"
  },
  {
    "poem_id": 1897,
    "vorder": 31,
    "position": 0,
    "text": "همی‌داشت آن اختران را نگاه"
  },
  {
    "poem_id": 1897,
    "vorder": 32,
    "position": 1,
    "text": "نهاده بران بسته بر مهر شاه"
  },
  {
    "poem_id": 1897,
    "vorder": 33,
    "position": 0,
    "text": "پر اندیشه بد زان سخن شهریار"
  },
  {
    "poem_id": 1897,
    "vorder": 34,
    "position": 1,
    "text": "بران هفته کس را ندادند بار"
  },
  {
    "poem_id": 1897,
    "vorder": 35,
    "position": 0,
    "text": "ز نخچیر و از می به یکسو کشید"
  },
  {
    "poem_id": 1897,
    "vorder": 36,
    "position": 1,
    "text": "بدان چندگه روی کس را ندید"
  },
  {
    "poem_id": 1897,
    "vorder": 37,
    "position": 0,
    "text": "همه مهتران سوی موبد شدند"
  },
  {
    "poem_id": 1897,
    "vorder": 38,
    "position": 1,
    "text": "ز هر گونه‌ای داستانها زدند"
  },
  {
    "poem_id": 1897,
    "vorder": 39,
    "position": 0,
    "text": "بدان تا چه بد نامور شاه را"
  },
  {
    "poem_id": 1897,
    "vorder": 40,
    "position": 1,
    "text": "که بربست بر کهتران راه را"
  },
  {
    "poem_id": 1897,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید موبد بشد نزد شاه"
  },
  {
    "poem_id": 1897,
    "vorder": 42,
    "position": 1,
    "text": "بدو داد یکسر پیام سپاه"
  },
  {
    "poem_id": 1897,
    "vorder": 43,
    "position": 0,
    "text": "چنین داد پاسخ ورا شهریار"
  },
  {
    "poem_id": 1897,
    "vorder": 44,
    "position": 1,
    "text": "که من تنگ دل گشتم از روزگار"
  },
  {
    "poem_id": 1897,
    "vorder": 45,
    "position": 0,
    "text": "ز گفتار این مرد اخترشناس"
  },
  {
    "poem_id": 1897,
    "vorder": 46,
    "position": 1,
    "text": "ز گردون گردان شدم ناسپاس"
  },
  {
    "poem_id": 1897,
    "vorder": 47,
    "position": 0,
    "text": "به گنجور گفت آن یکی پرنیان"
  },
  {
    "poem_id": 1897,
    "vorder": 48,
    "position": 1,
    "text": "بیاور یکی رقعه اندر میان"
  },
  {
    "poem_id": 1897,
    "vorder": 49,
    "position": 0,
    "text": "بیاورد گنجور و موبد بدید"
  },
  {
    "poem_id": 1897,
    "vorder": 50,
    "position": 1,
    "text": "دلش تنگ شد خامشی برگزید"
  },
  {
    "poem_id": 1897,
    "vorder": 51,
    "position": 0,
    "text": "ازان پس بدو گفت یزدان بس است"
  },
  {
    "poem_id": 1897,
    "vorder": 52,
    "position": 1,
    "text": "کجا برتر از دانش هر کس است"
  },
  {
    "poem_id": 1897,
    "vorder": 53,
    "position": 0,
    "text": "گر ایدون که ناچار گردان سپهر"
  },
  {
    "poem_id": 1897,
    "vorder": 54,
    "position": 1,
    "text": "دگرگون نماید به جوینده چهر"
  },
  {
    "poem_id": 1897,
    "vorder": 55,
    "position": 0,
    "text": "به تیمار کی باز گردد ز بد"
  },
  {
    "poem_id": 1897,
    "vorder": 56,
    "position": 1,
    "text": "چنین گفته از دانشی کی سزد"
  },
  {
    "poem_id": 1897,
    "vorder": 57,
    "position": 0,
    "text": "جز از شادمانیت هرگز مباد"
  },
  {
    "poem_id": 1897,
    "vorder": 58,
    "position": 1,
    "text": "ز گفتار ایشان مکن هیچ یاد"
  },
  {
    "poem_id": 1897,
    "vorder": 59,
    "position": 0,
    "text": "ز موبد چو بشنید خسرو سخن"
  },
  {
    "poem_id": 1897,
    "vorder": 60,
    "position": 1,
    "text": "بخندید و کاری نو افگند بن"
  },
  {
    "poem_id": 1897,
    "vorder": 61,
    "position": 0,
    "text": "دبیر پسندیده را خواند پیش"
  },
  {
    "poem_id": 1897,
    "vorder": 62,
    "position": 1,
    "text": "سخن گفت با او ز اندازه بیش"
  }
]