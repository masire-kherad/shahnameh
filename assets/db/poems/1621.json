[
  {
    "poem_id": 1621,
    "vorder": 1,
    "position": 0,
    "text": "به گازر چنین گفت روزی که من"
  },
  {
    "poem_id": 1621,
    "vorder": 2,
    "position": 1,
    "text": "همی این نهان دارم از انجمن"
  },
  {
    "poem_id": 1621,
    "vorder": 3,
    "position": 0,
    "text": "نجنبد همی بر تو بر مهر من"
  },
  {
    "poem_id": 1621,
    "vorder": 4,
    "position": 1,
    "text": "نماند به چهر تو هم چهر من"
  },
  {
    "poem_id": 1621,
    "vorder": 5,
    "position": 0,
    "text": "شگفت آیدم چون پسر خوانیم"
  },
  {
    "poem_id": 1621,
    "vorder": 6,
    "position": 1,
    "text": "به دکان بر خویش بنشانیم"
  },
  {
    "poem_id": 1621,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت گازر که اینت سخن"
  },
  {
    "poem_id": 1621,
    "vorder": 8,
    "position": 1,
    "text": "دریغ آن شده رنجهای کهن"
  },
  {
    "poem_id": 1621,
    "vorder": 9,
    "position": 0,
    "text": "تراگر منش زان من برتر است"
  },
  {
    "poem_id": 1621,
    "vorder": 10,
    "position": 1,
    "text": "پدرجوی را راز با مادر است"
  },
  {
    "poem_id": 1621,
    "vorder": 11,
    "position": 0,
    "text": "چنان بد که یک روز گازر برفت"
  },
  {
    "poem_id": 1621,
    "vorder": 12,
    "position": 1,
    "text": "ز خانه سوی رود یازید تفت"
  },
  {
    "poem_id": 1621,
    "vorder": 13,
    "position": 0,
    "text": "در خانه را تنگ داراب بست"
  },
  {
    "poem_id": 1621,
    "vorder": 14,
    "position": 1,
    "text": "بیامد به شمشیر یازید دست"
  },
  {
    "poem_id": 1621,
    "vorder": 15,
    "position": 0,
    "text": "به زن گفت کژی و تاری مجوی"
  },
  {
    "poem_id": 1621,
    "vorder": 16,
    "position": 1,
    "text": "هرآنچت بپرسم سخن راست گوی"
  },
  {
    "poem_id": 1621,
    "vorder": 17,
    "position": 0,
    "text": "شما را که باشم به گوهر کیم"
  },
  {
    "poem_id": 1621,
    "vorder": 18,
    "position": 1,
    "text": "به نزدیک گازر ز بهر چیم"
  },
  {
    "poem_id": 1621,
    "vorder": 19,
    "position": 0,
    "text": "زن گازر از بیم زنهار خواست"
  },
  {
    "poem_id": 1621,
    "vorder": 20,
    "position": 1,
    "text": "خداوند داننده را یار خواست"
  },
  {
    "poem_id": 1621,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت خون سر من مجوی"
  },
  {
    "poem_id": 1621,
    "vorder": 22,
    "position": 1,
    "text": "بگویم ترا هرچ گفتی بگوی"
  },
  {
    "poem_id": 1621,
    "vorder": 23,
    "position": 0,
    "text": "سخنها یکایک بر و بر شمرد"
  },
  {
    "poem_id": 1621,
    "vorder": 24,
    "position": 1,
    "text": "بکوشید وز کار کژی نبرد"
  },
  {
    "poem_id": 1621,
    "vorder": 25,
    "position": 0,
    "text": "ز صندوق وز کودک شیرخوار"
  },
  {
    "poem_id": 1621,
    "vorder": 26,
    "position": 1,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1621,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت ما دستکاران بدیم"
  },
  {
    "poem_id": 1621,
    "vorder": 28,
    "position": 1,
    "text": "نه از تخمهٔ کامکاران بدیم"
  },
  {
    "poem_id": 1621,
    "vorder": 29,
    "position": 0,
    "text": "ازان تو داریم چیزی که هست"
  },
  {
    "poem_id": 1621,
    "vorder": 30,
    "position": 1,
    "text": "ز پوشیدنی جامه و برنشست"
  },
  {
    "poem_id": 1621,
    "vorder": 31,
    "position": 0,
    "text": "پرستنده ماییم و فرمان تراست"
  },
  {
    "poem_id": 1621,
    "vorder": 32,
    "position": 1,
    "text": "نگر تا چه باید تن و جان تراست"
  },
  {
    "poem_id": 1621,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید داراب خیره بماند"
  },
  {
    "poem_id": 1621,
    "vorder": 34,
    "position": 1,
    "text": "روان را به اندیشه اندر نشاند"
  },
  {
    "poem_id": 1621,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت زین خواسته هیچ ماند"
  },
  {
    "poem_id": 1621,
    "vorder": 36,
    "position": 1,
    "text": "وگر گازر آن را همه برفشاند"
  },
  {
    "poem_id": 1621,
    "vorder": 37,
    "position": 0,
    "text": "که باشد بهای یکی بارگی"
  },
  {
    "poem_id": 1621,
    "vorder": 38,
    "position": 1,
    "text": "بدین روز کندی و بیچارگی"
  },
  {
    "poem_id": 1621,
    "vorder": 39,
    "position": 0,
    "text": "چنین داد پاسخ که بیش است ازین"
  },
  {
    "poem_id": 1621,
    "vorder": 40,
    "position": 1,
    "text": "درخت برومند و باغ و زمین"
  },
  {
    "poem_id": 1621,
    "vorder": 41,
    "position": 0,
    "text": "بدو داد دینار چندانک بود"
  },
  {
    "poem_id": 1621,
    "vorder": 42,
    "position": 1,
    "text": "بماند آن گران گوهر نابسود"
  },
  {
    "poem_id": 1621,
    "vorder": 43,
    "position": 0,
    "text": "به دینار اسپی خرید او پسند"
  },
  {
    "poem_id": 1621,
    "vorder": 44,
    "position": 1,
    "text": "یکی کم‌بها زین و دیگر کمند"
  },
  {
    "poem_id": 1621,
    "vorder": 45,
    "position": 0,
    "text": "یکی مرزبان بود با سنگ و رای"
  },
  {
    "poem_id": 1621,
    "vorder": 46,
    "position": 1,
    "text": "بزرگ و پسندیده و رهنمای"
  },
  {
    "poem_id": 1621,
    "vorder": 47,
    "position": 0,
    "text": "خرامید داراب نزدیک اوی"
  },
  {
    "poem_id": 1621,
    "vorder": 48,
    "position": 1,
    "text": "پراندیشه بد جان تاریک اوی"
  },
  {
    "poem_id": 1621,
    "vorder": 49,
    "position": 0,
    "text": "همی داشتش مرزبان ارجمند"
  },
  {
    "poem_id": 1621,
    "vorder": 50,
    "position": 1,
    "text": "ز گیتی نیامد بروبر گزند"
  },
  {
    "poem_id": 1621,
    "vorder": 51,
    "position": 0,
    "text": "چنان بد که آمد سپاهی ز روم"
  },
  {
    "poem_id": 1621,
    "vorder": 52,
    "position": 1,
    "text": "به غارت بران مرز آباد بوم"
  },
  {
    "poem_id": 1621,
    "vorder": 53,
    "position": 0,
    "text": "به رزم اندرون مرزبان کشته شد"
  },
  {
    "poem_id": 1621,
    "vorder": 54,
    "position": 1,
    "text": "سر لشکرش زان سخن گشته شد"
  },
  {
    "poem_id": 1621,
    "vorder": 55,
    "position": 0,
    "text": "چو آگاهی آمد به نزد همای"
  },
  {
    "poem_id": 1621,
    "vorder": 56,
    "position": 1,
    "text": "که رومی نهاد اندرین مرز پای"
  },
  {
    "poem_id": 1621,
    "vorder": 57,
    "position": 0,
    "text": "یکی مرد بد نام او رشنواد"
  },
  {
    "poem_id": 1621,
    "vorder": 58,
    "position": 1,
    "text": "سپهبد بد او هم سپهبدنژاد"
  },
  {
    "poem_id": 1621,
    "vorder": 59,
    "position": 0,
    "text": "بفرمود تا برکشد سوی روم"
  },
  {
    "poem_id": 1621,
    "vorder": 60,
    "position": 1,
    "text": "به شمشیر ویران کند روی بوم"
  },
  {
    "poem_id": 1621,
    "vorder": 61,
    "position": 0,
    "text": "سپه گرد کرد آن زمان رشنواد"
  },
  {
    "poem_id": 1621,
    "vorder": 62,
    "position": 1,
    "text": "عرض‌گاه بنهاد و روزی بداد"
  },
  {
    "poem_id": 1621,
    "vorder": 63,
    "position": 0,
    "text": "چو بشنید داراب شد شادکام"
  },
  {
    "poem_id": 1621,
    "vorder": 64,
    "position": 1,
    "text": "به نزدیک او رفت و بنوشت نام"
  },
  {
    "poem_id": 1621,
    "vorder": 65,
    "position": 0,
    "text": "سپه چون فراوان شد از هر دری"
  },
  {
    "poem_id": 1621,
    "vorder": 66,
    "position": 1,
    "text": "همی آمد از هر سوی لشکری"
  },
  {
    "poem_id": 1621,
    "vorder": 67,
    "position": 0,
    "text": "بیامد ز کاخ همایون همای"
  },
  {
    "poem_id": 1621,
    "vorder": 68,
    "position": 1,
    "text": "خود و مرزبانان پاکیزه‌رای"
  },
  {
    "poem_id": 1621,
    "vorder": 69,
    "position": 0,
    "text": "بدان تا سپه پیش او بگذرند"
  },
  {
    "poem_id": 1621,
    "vorder": 70,
    "position": 1,
    "text": "تن و نام و دیوانها بشمرند"
  },
  {
    "poem_id": 1621,
    "vorder": 71,
    "position": 0,
    "text": "همی بود چندی بران پهن دشت"
  },
  {
    "poem_id": 1621,
    "vorder": 72,
    "position": 1,
    "text": "چو لشکر فراوان برو برگذشت"
  },
  {
    "poem_id": 1621,
    "vorder": 73,
    "position": 0,
    "text": "چو داراب را دید با فر و برز"
  },
  {
    "poem_id": 1621,
    "vorder": 74,
    "position": 1,
    "text": "به گردن برآورده پولاد گرز"
  },
  {
    "poem_id": 1621,
    "vorder": 75,
    "position": 0,
    "text": "تو گفتی همه دشت پهنای اوست"
  },
  {
    "poem_id": 1621,
    "vorder": 76,
    "position": 1,
    "text": "زمین زیر پوینده بالای اوست"
  },
  {
    "poem_id": 1621,
    "vorder": 77,
    "position": 0,
    "text": "چو دید آن بر و چهرهٔ دلپذیر"
  },
  {
    "poem_id": 1621,
    "vorder": 78,
    "position": 1,
    "text": "ز پستان مادر بپالود شیر"
  },
  {
    "poem_id": 1621,
    "vorder": 79,
    "position": 0,
    "text": "بپرسید و گفت این سوار از کجاست"
  },
  {
    "poem_id": 1621,
    "vorder": 80,
    "position": 1,
    "text": "بدین شاخ و این برز و بالای راست"
  },
  {
    "poem_id": 1621,
    "vorder": 81,
    "position": 0,
    "text": "نماید که این نامداری بود"
  },
  {
    "poem_id": 1621,
    "vorder": 82,
    "position": 1,
    "text": "خردمند و جنگی سواری بود"
  },
  {
    "poem_id": 1621,
    "vorder": 83,
    "position": 0,
    "text": "دلیر و سرافراز و کنداور است"
  },
  {
    "poem_id": 1621,
    "vorder": 84,
    "position": 1,
    "text": "ولیکن سلیحش نه اندرخور است"
  },
  {
    "poem_id": 1621,
    "vorder": 85,
    "position": 0,
    "text": "چو داراب را فرمند آمدش"
  },
  {
    "poem_id": 1621,
    "vorder": 86,
    "position": 1,
    "text": "سپه را سراسر پسند آمدش"
  },
  {
    "poem_id": 1621,
    "vorder": 87,
    "position": 0,
    "text": "ز اختر یکی روزگاری گزید"
  },
  {
    "poem_id": 1621,
    "vorder": 88,
    "position": 1,
    "text": "ز بهر سپهبد چنان چون سزید"
  },
  {
    "poem_id": 1621,
    "vorder": 89,
    "position": 0,
    "text": "چو جنگ‌آوران را یکی گشت رای"
  },
  {
    "poem_id": 1621,
    "vorder": 90,
    "position": 1,
    "text": "ببردند لشکر ز پیش همای"
  },
  {
    "poem_id": 1621,
    "vorder": 91,
    "position": 0,
    "text": "فرستاد بیدار کارآگهان"
  },
  {
    "poem_id": 1621,
    "vorder": 92,
    "position": 1,
    "text": "بدان تا نماند سخن در نهان"
  },
  {
    "poem_id": 1621,
    "vorder": 93,
    "position": 0,
    "text": "ز نیک و بد لشکر آگاه بود"
  },
  {
    "poem_id": 1621,
    "vorder": 94,
    "position": 1,
    "text": "ز بدها گمانیش کوتاه بود"
  },
  {
    "poem_id": 1621,
    "vorder": 95,
    "position": 0,
    "text": "همی رفت منزل به منزل سپاه"
  },
  {
    "poem_id": 1621,
    "vorder": 96,
    "position": 1,
    "text": "زمین پر سپاه آسمان پر ز ماه"
  }
]