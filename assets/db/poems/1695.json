[
  {
    "poem_id": 1695,
    "vorder": 1,
    "position": 0,
    "text": "چو شب روز شد بامداد پگاه"
  },
  {
    "poem_id": 1695,
    "vorder": 2,
    "position": 1,
    "text": "بفرمود تا بازگردد سپاه"
  },
  {
    "poem_id": 1695,
    "vorder": 3,
    "position": 0,
    "text": "بیامد دو رخساره همرنگ نی"
  },
  {
    "poem_id": 1695,
    "vorder": 4,
    "position": 1,
    "text": "چو شب تیره گشت اندر آمد بری"
  },
  {
    "poem_id": 1695,
    "vorder": 5,
    "position": 0,
    "text": "یکی نامه بنوشت نزد پسر"
  },
  {
    "poem_id": 1695,
    "vorder": 6,
    "position": 1,
    "text": "که کژی به باغ اندر آورد بر"
  },
  {
    "poem_id": 1695,
    "vorder": 7,
    "position": 0,
    "text": "چنان شد ز بالین ما اردشیر"
  },
  {
    "poem_id": 1695,
    "vorder": 8,
    "position": 1,
    "text": "کزان سان نجست از کمان ایچ تیر"
  },
  {
    "poem_id": 1695,
    "vorder": 9,
    "position": 0,
    "text": "سوی پارس آمد بجویش نهان"
  },
  {
    "poem_id": 1695,
    "vorder": 10,
    "position": 1,
    "text": "مگوی این سخن با کسی در جهان"
  }
]