[
  {
    "poem_id": 88061,
    "vorder": 1,
    "position": 0,
    "text": "چو شد کار پیران ویسه به سر"
  },
  {
    "poem_id": 88061,
    "vorder": 2,
    "position": 1,
    "text": "به جنگ دگر شاه پیروزگر"
  },
  {
    "poem_id": 88061,
    "vorder": 3,
    "position": 0,
    "text": "بیاراست از هر سوی مهتران"
  },
  {
    "poem_id": 88061,
    "vorder": 4,
    "position": 1,
    "text": "برفتند با لشکری بی‌کران"
  },
  {
    "poem_id": 88061,
    "vorder": 5,
    "position": 0,
    "text": "برآمد خروشیدن کرنای"
  },
  {
    "poem_id": 88061,
    "vorder": 6,
    "position": 1,
    "text": "به هامون کشیدند پرده‌سرای"
  },
  {
    "poem_id": 88061,
    "vorder": 7,
    "position": 0,
    "text": "به شهر اندرون جای خفتن نماند"
  },
  {
    "poem_id": 88061,
    "vorder": 8,
    "position": 1,
    "text": "به دشت اندرون راه رفتن نماند"
  },
  {
    "poem_id": 88061,
    "vorder": 9,
    "position": 0,
    "text": "یکی تخت پیروزه بر پشت پیل"
  },
  {
    "poem_id": 88061,
    "vorder": 10,
    "position": 1,
    "text": "نهادند و شد روی گیتی چو نیل"
  },
  {
    "poem_id": 88061,
    "vorder": 11,
    "position": 0,
    "text": "نشست از بر تخت با تاج شاه"
  },
  {
    "poem_id": 88061,
    "vorder": 12,
    "position": 1,
    "text": "خروش آمد از دشت وز بارگاه"
  },
  {
    "poem_id": 88061,
    "vorder": 13,
    "position": 0,
    "text": "چو بر پشت پیل آن شه نامور"
  },
  {
    "poem_id": 88061,
    "vorder": 14,
    "position": 1,
    "text": "زدی مهره در جام و بستی کمر"
  },
  {
    "poem_id": 88061,
    "vorder": 15,
    "position": 0,
    "text": "نبودی به هر پادشاهی روا"
  },
  {
    "poem_id": 88061,
    "vorder": 16,
    "position": 1,
    "text": "نشستن مگر بر در پادشا"
  },
  {
    "poem_id": 88061,
    "vorder": 17,
    "position": 0,
    "text": "از آن نامور خسرو سرکشان"
  },
  {
    "poem_id": 88061,
    "vorder": 18,
    "position": 1,
    "text": "چنین بود در پادشاهی نشان"
  },
  {
    "poem_id": 88061,
    "vorder": 19,
    "position": 0,
    "text": "به مرزی که لشکر فرستاده بود"
  },
  {
    "poem_id": 88061,
    "vorder": 20,
    "position": 1,
    "text": "بسی پند و اندرزها داده بود"
  },
  {
    "poem_id": 88061,
    "vorder": 21,
    "position": 0,
    "text": "چو لهراسب و چون اشکش تیز چنگ"
  },
  {
    "poem_id": 88061,
    "vorder": 22,
    "position": 1,
    "text": "که از ژرف دریا ربودی نهنگ"
  },
  {
    "poem_id": 88061,
    "vorder": 23,
    "position": 0,
    "text": "دگر نامور رستم پهلوان"
  },
  {
    "poem_id": 88061,
    "vorder": 24,
    "position": 1,
    "text": "پسندیده و راد و روشن روان"
  },
  {
    "poem_id": 88061,
    "vorder": 25,
    "position": 0,
    "text": "بفرمودشان بازگشتن به در"
  },
  {
    "poem_id": 88061,
    "vorder": 26,
    "position": 1,
    "text": "هر آن کس که بد گرد و پرخاشخر"
  },
  {
    "poem_id": 88061,
    "vorder": 27,
    "position": 0,
    "text": "در گنج بگشاد و روزی بداد"
  },
  {
    "poem_id": 88061,
    "vorder": 28,
    "position": 1,
    "text": "بسی از روان پدر کرد یاد"
  },
  {
    "poem_id": 88061,
    "vorder": 29,
    "position": 0,
    "text": "سه تن را گزین کرد زان انجمن"
  },
  {
    "poem_id": 88061,
    "vorder": 30,
    "position": 1,
    "text": "سخن گوی و روشن دل و تیغ زن"
  },
  {
    "poem_id": 88061,
    "vorder": 31,
    "position": 0,
    "text": "چو رستم که بد پهلوان بزرگ"
  },
  {
    "poem_id": 88061,
    "vorder": 32,
    "position": 1,
    "text": "چو گودرز بینادل آن پیر گرگ"
  },
  {
    "poem_id": 88061,
    "vorder": 33,
    "position": 0,
    "text": "دگر پهلوان طوس زرینه کفش"
  },
  {
    "poem_id": 88061,
    "vorder": 34,
    "position": 1,
    "text": "کجا بود با کاویانی درفش"
  },
  {
    "poem_id": 88061,
    "vorder": 35,
    "position": 0,
    "text": "به هر نامداری و خودکامه‌ای"
  },
  {
    "poem_id": 88061,
    "vorder": 36,
    "position": 1,
    "text": "نبشتند بر پهلوی نامه‌ای"
  },
  {
    "poem_id": 88061,
    "vorder": 37,
    "position": 0,
    "text": "فرستادگان خواست از انجمن"
  },
  {
    "poem_id": 88061,
    "vorder": 38,
    "position": 1,
    "text": "زبان آور و بخرد و رای زن"
  },
  {
    "poem_id": 88061,
    "vorder": 39,
    "position": 0,
    "text": "که پیروز کیخسرو از پشت پیل"
  },
  {
    "poem_id": 88061,
    "vorder": 40,
    "position": 1,
    "text": "بزد مهره و گشت گیتی چو نیل"
  },
  {
    "poem_id": 88061,
    "vorder": 41,
    "position": 0,
    "text": "مه آرام بادا شما را مه خواب"
  },
  {
    "poem_id": 88061,
    "vorder": 42,
    "position": 1,
    "text": "مگر ساختن رزم افراسیاب"
  },
  {
    "poem_id": 88061,
    "vorder": 43,
    "position": 0,
    "text": "چو آن نامه برخواند هر مهتری"
  },
  {
    "poem_id": 88061,
    "vorder": 44,
    "position": 1,
    "text": "کجا بود در پادشاهی سری"
  },
  {
    "poem_id": 88061,
    "vorder": 45,
    "position": 0,
    "text": "ز گردان گیتی برآمد خروش"
  },
  {
    "poem_id": 88061,
    "vorder": 46,
    "position": 1,
    "text": "زمین همچو دریا برآمد به جوش"
  },
  {
    "poem_id": 88061,
    "vorder": 47,
    "position": 0,
    "text": "بزرگان هر کشوری با سپاه"
  },
  {
    "poem_id": 88061,
    "vorder": 48,
    "position": 1,
    "text": "نهادند سر سوی درگاه شاه"
  },
  {
    "poem_id": 88061,
    "vorder": 49,
    "position": 0,
    "text": "چو شد ساخته جنگ را لشکری"
  },
  {
    "poem_id": 88061,
    "vorder": 50,
    "position": 1,
    "text": "ز هر نامداری به هر کشوری"
  },
  {
    "poem_id": 88061,
    "vorder": 51,
    "position": 0,
    "text": "از آن پس بگردید گرد سپاه"
  },
  {
    "poem_id": 88061,
    "vorder": 52,
    "position": 1,
    "text": "بیاراست بر هر سوی رزمگاه"
  },
  {
    "poem_id": 88061,
    "vorder": 53,
    "position": 0,
    "text": "گزین کرد زان لشکر نامدار"
  },
  {
    "poem_id": 88061,
    "vorder": 54,
    "position": 1,
    "text": "سواران شمشیر زن سی هزار"
  },
  {
    "poem_id": 88061,
    "vorder": 55,
    "position": 0,
    "text": "که باشند با او به قلب اندرون"
  },
  {
    "poem_id": 88061,
    "vorder": 56,
    "position": 1,
    "text": "همه جنگ را دست شسته به خون"
  },
  {
    "poem_id": 88061,
    "vorder": 57,
    "position": 0,
    "text": "به یک دست مر طوس را کرد جای"
  },
  {
    "poem_id": 88061,
    "vorder": 58,
    "position": 1,
    "text": "منوشان خوزان فرخنده رای"
  },
  {
    "poem_id": 88061,
    "vorder": 59,
    "position": 0,
    "text": "که بر کشور خوزیان بود شاه"
  },
  {
    "poem_id": 88061,
    "vorder": 60,
    "position": 1,
    "text": "بسی نامداران زرین کلاه"
  },
  {
    "poem_id": 88061,
    "vorder": 61,
    "position": 0,
    "text": "دو تن نیز بودند هم رزم سوز"
  },
  {
    "poem_id": 88061,
    "vorder": 62,
    "position": 1,
    "text": "چو گوران شه آن گرد لشگر فروز"
  },
  {
    "poem_id": 88061,
    "vorder": 63,
    "position": 0,
    "text": "وز او نیوتر آرش رزم زن"
  },
  {
    "poem_id": 88061,
    "vorder": 64,
    "position": 1,
    "text": "به هر کار پیروز و لشکرشکن"
  },
  {
    "poem_id": 88061,
    "vorder": 65,
    "position": 0,
    "text": "یکی آنک بر کشوری شاه بود"
  },
  {
    "poem_id": 88061,
    "vorder": 66,
    "position": 1,
    "text": "گه رزم با بخت همراه بود"
  },
  {
    "poem_id": 88061,
    "vorder": 67,
    "position": 0,
    "text": "دگر شاه کرمان که هنگام جنگ"
  },
  {
    "poem_id": 88061,
    "vorder": 68,
    "position": 1,
    "text": "نکردی به دل یاد رای درنگ"
  },
  {
    "poem_id": 88061,
    "vorder": 69,
    "position": 0,
    "text": "چو صیاع فرزانه شاه یمن"
  },
  {
    "poem_id": 88061,
    "vorder": 70,
    "position": 1,
    "text": "دگر شیر دل ایرج پیل تن"
  },
  {
    "poem_id": 88061,
    "vorder": 71,
    "position": 0,
    "text": "که بر شهر کابل بد او پادشا"
  },
  {
    "poem_id": 88061,
    "vorder": 72,
    "position": 1,
    "text": "جهاندار و بیدار و فرمان روا"
  },
  {
    "poem_id": 88061,
    "vorder": 73,
    "position": 0,
    "text": "هر آنکس که از تخمهٔ کیقباد"
  },
  {
    "poem_id": 88061,
    "vorder": 74,
    "position": 1,
    "text": "بزرگان بادانش و بانژاد"
  },
  {
    "poem_id": 88061,
    "vorder": 75,
    "position": 0,
    "text": "چو شماخ سوری شه سوریان"
  },
  {
    "poem_id": 88061,
    "vorder": 76,
    "position": 1,
    "text": "کجا رزم را بود بسته میان"
  },
  {
    "poem_id": 88061,
    "vorder": 77,
    "position": 0,
    "text": "فروتر از او گیوهٔ رزم زن"
  },
  {
    "poem_id": 88061,
    "vorder": 78,
    "position": 1,
    "text": "به هر کار پیروز و لشکر شکن"
  },
  {
    "poem_id": 88061,
    "vorder": 79,
    "position": 0,
    "text": "که بر شهر داور بد او پادشا"
  },
  {
    "poem_id": 88061,
    "vorder": 80,
    "position": 1,
    "text": "جهانگیر و فرزانه و پارسا"
  },
  {
    "poem_id": 88061,
    "vorder": 81,
    "position": 0,
    "text": "به دست چپ خویش بر پای کرد"
  },
  {
    "poem_id": 88061,
    "vorder": 82,
    "position": 1,
    "text": "دلفروز را لشکر آرای کرد"
  },
  {
    "poem_id": 88061,
    "vorder": 83,
    "position": 0,
    "text": "بزرگان که از تخم پورست تیغ"
  },
  {
    "poem_id": 88061,
    "vorder": 84,
    "position": 1,
    "text": "زدندی شب تیره بر باد میغ"
  },
  {
    "poem_id": 88061,
    "vorder": 85,
    "position": 0,
    "text": "هر آنکس که بود او ز تخم زرسب"
  },
  {
    "poem_id": 88061,
    "vorder": 86,
    "position": 1,
    "text": "پرستندهٔ فرخ آذر گشسب"
  },
  {
    "poem_id": 88061,
    "vorder": 87,
    "position": 0,
    "text": "دگر بیژن گیو و رهام گرد"
  },
  {
    "poem_id": 88061,
    "vorder": 88,
    "position": 1,
    "text": "کجا شاهشان از بزرگان شمرد"
  },
  {
    "poem_id": 88061,
    "vorder": 89,
    "position": 0,
    "text": "چو گرگین میلاد و گردان ری"
  },
  {
    "poem_id": 88061,
    "vorder": 90,
    "position": 1,
    "text": "برفتند یکسر به فرمان کی"
  },
  {
    "poem_id": 88061,
    "vorder": 91,
    "position": 0,
    "text": "پس پشت او را نگه داشتند"
  },
  {
    "poem_id": 88061,
    "vorder": 92,
    "position": 1,
    "text": "همه نیزه از ابر بگذاشتند"
  },
  {
    "poem_id": 88061,
    "vorder": 93,
    "position": 0,
    "text": "به رستم سپرد آن زمان میمنه"
  },
  {
    "poem_id": 88061,
    "vorder": 94,
    "position": 1,
    "text": "که بود او سپاهی شکن یک تنه"
  },
  {
    "poem_id": 88061,
    "vorder": 95,
    "position": 0,
    "text": "هر آنکس که از زابلستان بدند"
  },
  {
    "poem_id": 88061,
    "vorder": 96,
    "position": 1,
    "text": "وگر کهتر و خویش دستان بدند"
  },
  {
    "poem_id": 88061,
    "vorder": 97,
    "position": 0,
    "text": "بدیشان سپرد آن زمان دست راست"
  },
  {
    "poem_id": 88061,
    "vorder": 98,
    "position": 1,
    "text": "همی نام و آرایش جنگ خواست"
  },
  {
    "poem_id": 88061,
    "vorder": 99,
    "position": 0,
    "text": "سپاهی گزین کرد بر میسره"
  },
  {
    "poem_id": 88061,
    "vorder": 100,
    "position": 1,
    "text": "چو خورشید تابان ز برج بره"
  },
  {
    "poem_id": 88061,
    "vorder": 101,
    "position": 0,
    "text": "سپهدار گودرز کشواد بود"
  },
  {
    "poem_id": 88061,
    "vorder": 102,
    "position": 1,
    "text": "هجیر و چو شیدوش و فرهاد بود"
  },
  {
    "poem_id": 88061,
    "vorder": 103,
    "position": 0,
    "text": "بزرگان که از بردع و اردبیل"
  },
  {
    "poem_id": 88061,
    "vorder": 104,
    "position": 1,
    "text": "به پیش جهاندار بودند خیل"
  },
  {
    "poem_id": 88061,
    "vorder": 105,
    "position": 0,
    "text": "سپهدار گودرز را خواستند"
  },
  {
    "poem_id": 88061,
    "vorder": 106,
    "position": 1,
    "text": "چپ لشکرش را بیاراستند"
  },
  {
    "poem_id": 88061,
    "vorder": 107,
    "position": 0,
    "text": "بفرمود تا پیش قلب سپاه"
  },
  {
    "poem_id": 88061,
    "vorder": 108,
    "position": 1,
    "text": "به پیلان جنگی ببستند راه"
  },
  {
    "poem_id": 88061,
    "vorder": 109,
    "position": 0,
    "text": "نهادند صندوق بر پشت پیل"
  },
  {
    "poem_id": 88061,
    "vorder": 110,
    "position": 1,
    "text": "زمین شد به کردار دریای نیل"
  },
  {
    "poem_id": 88061,
    "vorder": 111,
    "position": 0,
    "text": "هزار از دلیران روز نبرد"
  },
  {
    "poem_id": 88061,
    "vorder": 112,
    "position": 1,
    "text": "به صندوق بر ناوک انداز کرد"
  },
  {
    "poem_id": 88061,
    "vorder": 113,
    "position": 0,
    "text": "نگهبان هر پیل سیصد سوار"
  },
  {
    "poem_id": 88061,
    "vorder": 114,
    "position": 1,
    "text": "همه جنگ‌جوی و همه نیزه‌دار"
  },
  {
    "poem_id": 88061,
    "vorder": 115,
    "position": 0,
    "text": "ز بغداد گردان جنگاوران"
  },
  {
    "poem_id": 88061,
    "vorder": 116,
    "position": 1,
    "text": "که بودند با زنگهٔ شاوران"
  },
  {
    "poem_id": 88061,
    "vorder": 117,
    "position": 0,
    "text": "سپاهی گزیده ز گردان بلخ"
  },
  {
    "poem_id": 88061,
    "vorder": 118,
    "position": 1,
    "text": "بفرمود تا با کمانهای چرخ"
  },
  {
    "poem_id": 88061,
    "vorder": 119,
    "position": 0,
    "text": "پیاده ببودند بر پیش پیل"
  },
  {
    "poem_id": 88061,
    "vorder": 120,
    "position": 1,
    "text": "که گر کوه پیش آمدی بر دو میل"
  },
  {
    "poem_id": 88061,
    "vorder": 121,
    "position": 0,
    "text": "دل سنگ بگذاشتندی به تیر"
  },
  {
    "poem_id": 88061,
    "vorder": 122,
    "position": 1,
    "text": "نبودی کس آن زخم را دستگیر"
  },
  {
    "poem_id": 88061,
    "vorder": 123,
    "position": 0,
    "text": "پیاده پس پیل کرده به پای"
  },
  {
    "poem_id": 88061,
    "vorder": 124,
    "position": 1,
    "text": "ابا نه رشی نیزهٔ سرگرای"
  },
  {
    "poem_id": 88061,
    "vorder": 125,
    "position": 0,
    "text": "سپرهای گیلی به پیش اندرون"
  },
  {
    "poem_id": 88061,
    "vorder": 126,
    "position": 1,
    "text": "همی از جگرشان بجوشید خون"
  },
  {
    "poem_id": 88061,
    "vorder": 127,
    "position": 0,
    "text": "پیاده صفی از پس نیزه‌دار"
  },
  {
    "poem_id": 88061,
    "vorder": 128,
    "position": 1,
    "text": "سپردار با تیر جوشن‌گذار"
  },
  {
    "poem_id": 88061,
    "vorder": 129,
    "position": 0,
    "text": "پس پشت ایشان سواران جنگ"
  },
  {
    "poem_id": 88061,
    "vorder": 130,
    "position": 1,
    "text": "برآگنده ترکش ز تیر خدنگ"
  },
  {
    "poem_id": 88061,
    "vorder": 131,
    "position": 0,
    "text": "ز خاور سپاهی گزین کرد شاه"
  },
  {
    "poem_id": 88061,
    "vorder": 132,
    "position": 1,
    "text": "سپردار با درع و رومی کلاه"
  },
  {
    "poem_id": 88061,
    "vorder": 133,
    "position": 0,
    "text": "ز گردان گردنکشان سی هزار"
  },
  {
    "poem_id": 88061,
    "vorder": 134,
    "position": 1,
    "text": "فریبرز را داد جنگی سوار"
  },
  {
    "poem_id": 88061,
    "vorder": 135,
    "position": 0,
    "text": "ابا شاه شهر دهستان تخوار"
  },
  {
    "poem_id": 88061,
    "vorder": 136,
    "position": 1,
    "text": "که جنگ بداندیش بودیش خوار"
  },
  {
    "poem_id": 88061,
    "vorder": 137,
    "position": 0,
    "text": "ز بغداد و گردن فرازان کرخ"
  },
  {
    "poem_id": 88061,
    "vorder": 138,
    "position": 1,
    "text": "بفرمود تا با کمانهای چرخ"
  },
  {
    "poem_id": 88061,
    "vorder": 139,
    "position": 0,
    "text": "به پیش اندرون تیرباران کنند"
  },
  {
    "poem_id": 88061,
    "vorder": 140,
    "position": 1,
    "text": "هوا را چو ابر بهاران کنند"
  },
  {
    "poem_id": 88061,
    "vorder": 141,
    "position": 0,
    "text": "به دست فریبرز نستوه بود"
  },
  {
    "poem_id": 88061,
    "vorder": 142,
    "position": 1,
    "text": "که نزدیک او لشکر انبوه بود"
  },
  {
    "poem_id": 88061,
    "vorder": 143,
    "position": 0,
    "text": "بزرگان رزم آزموده سران"
  },
  {
    "poem_id": 88061,
    "vorder": 144,
    "position": 1,
    "text": "ز دشت سواران نیزه وران"
  },
  {
    "poem_id": 88061,
    "vorder": 145,
    "position": 0,
    "text": "سر مایه و پیشروشان زهیر"
  },
  {
    "poem_id": 88061,
    "vorder": 146,
    "position": 1,
    "text": "که آهو ربودی ز چنگال شیر"
  },
  {
    "poem_id": 88061,
    "vorder": 147,
    "position": 0,
    "text": "بفرمود تا نزد نستوه شد"
  },
  {
    "poem_id": 88061,
    "vorder": 148,
    "position": 1,
    "text": "چپ لشکر شاه چون کوه شد"
  },
  {
    "poem_id": 88061,
    "vorder": 149,
    "position": 0,
    "text": "سپاهی بد از روم و بربرستان"
  },
  {
    "poem_id": 88061,
    "vorder": 150,
    "position": 1,
    "text": "گوی پیشرو نام لشکرستان"
  },
  {
    "poem_id": 88061,
    "vorder": 151,
    "position": 0,
    "text": "سوار و پیاده بدی سی هزار"
  },
  {
    "poem_id": 88061,
    "vorder": 152,
    "position": 1,
    "text": "برفتند با ساقهٔ شهریار"
  },
  {
    "poem_id": 88061,
    "vorder": 153,
    "position": 0,
    "text": "دگر لشکری کز خراسان بدند"
  },
  {
    "poem_id": 88061,
    "vorder": 154,
    "position": 1,
    "text": "جهانجوی و مردم شناسان بدند"
  },
  {
    "poem_id": 88061,
    "vorder": 155,
    "position": 0,
    "text": "منوچهر آرش نگهدارشان"
  },
  {
    "poem_id": 88061,
    "vorder": 156,
    "position": 1,
    "text": "گه نام جستن سپهدارشان"
  },
  {
    "poem_id": 88061,
    "vorder": 157,
    "position": 0,
    "text": "دگر نامداری گروخان نژاد"
  },
  {
    "poem_id": 88061,
    "vorder": 158,
    "position": 1,
    "text": "جهاندار وز تخمهٔ کیقباد"
  },
  {
    "poem_id": 88061,
    "vorder": 159,
    "position": 0,
    "text": "کجا نام آن شاه پیروز بود"
  },
  {
    "poem_id": 88061,
    "vorder": 160,
    "position": 1,
    "text": "سپهبد دل و لشکر افروز بود"
  },
  {
    "poem_id": 88061,
    "vorder": 161,
    "position": 0,
    "text": "شه غرچگان بود بر سان شیر"
  },
  {
    "poem_id": 88061,
    "vorder": 162,
    "position": 1,
    "text": "کجا ژنده پیل آوریدی به زیر"
  },
  {
    "poem_id": 88061,
    "vorder": 163,
    "position": 0,
    "text": "به دست منوچهرشان جای کرد"
  },
  {
    "poem_id": 88061,
    "vorder": 164,
    "position": 1,
    "text": "سر تخمه را لشکر آرای کرد"
  },
  {
    "poem_id": 88061,
    "vorder": 165,
    "position": 0,
    "text": "بزرگان که از کوه قاف آمدند"
  },
  {
    "poem_id": 88061,
    "vorder": 166,
    "position": 1,
    "text": "ابا نیزه و تیغ لاف آمدند"
  },
  {
    "poem_id": 88061,
    "vorder": 167,
    "position": 0,
    "text": "سپاهی ز تخم فریدون و جم"
  },
  {
    "poem_id": 88061,
    "vorder": 168,
    "position": 1,
    "text": "پر از خون دل از تخمهٔ زادشم"
  },
  {
    "poem_id": 88061,
    "vorder": 169,
    "position": 0,
    "text": "از این دست شمشیرزن سی هزار"
  },
  {
    "poem_id": 88061,
    "vorder": 170,
    "position": 1,
    "text": "جهاندار وز تخمهٔ شهریار"
  },
  {
    "poem_id": 88061,
    "vorder": 171,
    "position": 0,
    "text": "سپرد این سپه گیو گودرز را"
  },
  {
    "poem_id": 88061,
    "vorder": 172,
    "position": 1,
    "text": "بدو تازه شد دل همه مرز را"
  },
  {
    "poem_id": 88061,
    "vorder": 173,
    "position": 0,
    "text": "به یاری به پشت سپهدار گیو"
  },
  {
    "poem_id": 88061,
    "vorder": 174,
    "position": 1,
    "text": "برفتند گردان بیدار و نیو"
  },
  {
    "poem_id": 88061,
    "vorder": 175,
    "position": 0,
    "text": "فرستاد بر میمنه ده هزار"
  },
  {
    "poem_id": 88061,
    "vorder": 176,
    "position": 1,
    "text": "دلاور سواران خنجر گزار"
  },
  {
    "poem_id": 88061,
    "vorder": 177,
    "position": 0,
    "text": "سپه ده هزار از دلیران گرد"
  },
  {
    "poem_id": 88061,
    "vorder": 178,
    "position": 1,
    "text": "پس پشت گودرز کشواد برد"
  },
  {
    "poem_id": 88061,
    "vorder": 179,
    "position": 0,
    "text": "دمادم بشد برتهٔ تیغ زن"
  },
  {
    "poem_id": 88061,
    "vorder": 180,
    "position": 1,
    "text": "ابا کوهیار اندر آن انجمن"
  },
  {
    "poem_id": 88061,
    "vorder": 181,
    "position": 0,
    "text": "به مردی شود جنگ را یار گیو"
  },
  {
    "poem_id": 88061,
    "vorder": 182,
    "position": 1,
    "text": "سپاهی سرافراز و گردان نیو"
  },
  {
    "poem_id": 88061,
    "vorder": 183,
    "position": 0,
    "text": "زواره بد این جنگ را پیشرو"
  },
  {
    "poem_id": 88061,
    "vorder": 184,
    "position": 1,
    "text": "سپاهی همه جنگ سازان نو"
  },
  {
    "poem_id": 88061,
    "vorder": 185,
    "position": 0,
    "text": "به پیش اندرون قارن رزم زن"
  },
  {
    "poem_id": 88061,
    "vorder": 186,
    "position": 1,
    "text": "سر نامداران آن انجمن"
  },
  {
    "poem_id": 88061,
    "vorder": 187,
    "position": 0,
    "text": "بدان تا میان دو رویه سپاه"
  },
  {
    "poem_id": 88061,
    "vorder": 188,
    "position": 1,
    "text": "بود گرد اسب افگن و رزمخواه"
  },
  {
    "poem_id": 88061,
    "vorder": 189,
    "position": 0,
    "text": "از آن پس به گستهم گژدهم گفت"
  },
  {
    "poem_id": 88061,
    "vorder": 190,
    "position": 1,
    "text": "که با قارن رزم زن باش جفت"
  },
  {
    "poem_id": 88061,
    "vorder": 191,
    "position": 0,
    "text": "بفرمود تا اندمان پور طوس"
  },
  {
    "poem_id": 88061,
    "vorder": 192,
    "position": 1,
    "text": "بگردد به هر جای با پیل و کوس"
  },
  {
    "poem_id": 88061,
    "vorder": 193,
    "position": 0,
    "text": "بدان تا ببندد ز بیداد دست"
  },
  {
    "poem_id": 88061,
    "vorder": 194,
    "position": 1,
    "text": "کسی را کجا نیست یزدان پرست"
  },
  {
    "poem_id": 88061,
    "vorder": 195,
    "position": 0,
    "text": "نباشد کس از خوردنی بی‌نوا"
  },
  {
    "poem_id": 88061,
    "vorder": 196,
    "position": 1,
    "text": "ستم نیز بر کس ندارد روا"
  },
  {
    "poem_id": 88061,
    "vorder": 197,
    "position": 0,
    "text": "جهان پر ز گردون بد و گاومیش"
  },
  {
    "poem_id": 88061,
    "vorder": 198,
    "position": 1,
    "text": "ز بهر خورش را همی راند پیش"
  },
  {
    "poem_id": 88061,
    "vorder": 199,
    "position": 0,
    "text": "بخواهد همی هرچ باید ز شاه"
  },
  {
    "poem_id": 88061,
    "vorder": 200,
    "position": 1,
    "text": "به هر کار باشد زبان سپاه"
  },
  {
    "poem_id": 88061,
    "vorder": 201,
    "position": 0,
    "text": "بهر سو طلایه پدیدار کرد"
  },
  {
    "poem_id": 88061,
    "vorder": 202,
    "position": 1,
    "text": "سر خفته از خواب بیدار کرد"
  },
  {
    "poem_id": 88061,
    "vorder": 203,
    "position": 0,
    "text": "به هر سو برفتند کارآگهان"
  },
  {
    "poem_id": 88061,
    "vorder": 204,
    "position": 1,
    "text": "همی جست بیدار کار جهان"
  },
  {
    "poem_id": 88061,
    "vorder": 205,
    "position": 0,
    "text": "کجا کوه بد دیده‌بان داشتی"
  },
  {
    "poem_id": 88061,
    "vorder": 206,
    "position": 1,
    "text": "سپه را پراگنده نگذاشتی"
  },
  {
    "poem_id": 88061,
    "vorder": 207,
    "position": 0,
    "text": "همه کوه و غار و بیابان و دشت"
  },
  {
    "poem_id": 88061,
    "vorder": 208,
    "position": 1,
    "text": "به هر سو همی گرد لشکر بگشت"
  },
  {
    "poem_id": 88061,
    "vorder": 209,
    "position": 0,
    "text": "عنانها یک اندر دگر ساخته"
  },
  {
    "poem_id": 88061,
    "vorder": 210,
    "position": 1,
    "text": "همه جنگ را گردن افراخته"
  },
  {
    "poem_id": 88061,
    "vorder": 211,
    "position": 0,
    "text": "از ایشان کسی را نبد بیم و رنج"
  },
  {
    "poem_id": 88061,
    "vorder": 212,
    "position": 1,
    "text": "همی راند با خویشتن شاه گنج"
  },
  {
    "poem_id": 88061,
    "vorder": 213,
    "position": 0,
    "text": "بر این گونه چون شاه لشکر بساخت"
  },
  {
    "poem_id": 88061,
    "vorder": 214,
    "position": 1,
    "text": "به گردون کلاه کیی برفراخت"
  },
  {
    "poem_id": 88061,
    "vorder": 215,
    "position": 0,
    "text": "دل مرد بدساز با نیک خوی"
  },
  {
    "poem_id": 88061,
    "vorder": 216,
    "position": 1,
    "text": "جز از جنگ جستن نکرد آرزوی"
  }
]