[
  {
    "poem_id": 1604,
    "vorder": 1,
    "position": 0,
    "text": "یکی نغز تابوت کرد آهنین"
  },
  {
    "poem_id": 1604,
    "vorder": 2,
    "position": 1,
    "text": "بگسترد فرشی ز دیبای چین"
  },
  {
    "poem_id": 1604,
    "vorder": 3,
    "position": 0,
    "text": "بیندود یک روی آهن به قیر"
  },
  {
    "poem_id": 1604,
    "vorder": 4,
    "position": 1,
    "text": "پراگند بر قیر مشک و عبیر"
  },
  {
    "poem_id": 1604,
    "vorder": 5,
    "position": 0,
    "text": "ز دیبای زربفت کردش کفن"
  },
  {
    "poem_id": 1604,
    "vorder": 6,
    "position": 1,
    "text": "خروشان برو نامدار انجمن"
  },
  {
    "poem_id": 1604,
    "vorder": 7,
    "position": 0,
    "text": "ازان پس بپوشید روشن برش"
  },
  {
    "poem_id": 1604,
    "vorder": 8,
    "position": 1,
    "text": "ز پیروزه بر سر نهاد افسرش"
  },
  {
    "poem_id": 1604,
    "vorder": 9,
    "position": 0,
    "text": "سر تنگ تابوت کردند سخت"
  },
  {
    "poem_id": 1604,
    "vorder": 10,
    "position": 1,
    "text": "شد آن بارور خسروانی درخت"
  },
  {
    "poem_id": 1604,
    "vorder": 11,
    "position": 0,
    "text": "چل اشتر بیاورد رستم گزین"
  },
  {
    "poem_id": 1604,
    "vorder": 12,
    "position": 1,
    "text": "ز بالا فروهشته دیبای چین"
  },
  {
    "poem_id": 1604,
    "vorder": 13,
    "position": 0,
    "text": "دو اشتر بدی زیر تابوت شاه"
  },
  {
    "poem_id": 1604,
    "vorder": 14,
    "position": 1,
    "text": "چپ و راست پیش و پس‌اندر سپاه"
  },
  {
    "poem_id": 1604,
    "vorder": 15,
    "position": 0,
    "text": "همه خسته روی و همه کنده موی"
  },
  {
    "poem_id": 1604,
    "vorder": 16,
    "position": 1,
    "text": "زبان شاه گوی و روان شاه‌جوی"
  },
  {
    "poem_id": 1604,
    "vorder": 17,
    "position": 0,
    "text": "بریده بش و دم اسپ سیاه"
  },
  {
    "poem_id": 1604,
    "vorder": 18,
    "position": 1,
    "text": "پشوتن همی برد پیش سپاه"
  },
  {
    "poem_id": 1604,
    "vorder": 19,
    "position": 0,
    "text": "برو بر نهاده نگونسار زین"
  },
  {
    "poem_id": 1604,
    "vorder": 20,
    "position": 1,
    "text": "ز زین اندرآویخته گرز کین"
  },
  {
    "poem_id": 1604,
    "vorder": 21,
    "position": 0,
    "text": "همان نامور خود و خفتان اوی"
  },
  {
    "poem_id": 1604,
    "vorder": 22,
    "position": 1,
    "text": "همان جوله و مغفر جنگجوی"
  },
  {
    "poem_id": 1604,
    "vorder": 23,
    "position": 0,
    "text": "سپه رفت و بهمن به زابل بماند"
  },
  {
    "poem_id": 1604,
    "vorder": 24,
    "position": 1,
    "text": "به مژگان همی خون دل برفشاند"
  },
  {
    "poem_id": 1604,
    "vorder": 25,
    "position": 0,
    "text": "تهمتن ببردش به ایوان خویش"
  },
  {
    "poem_id": 1604,
    "vorder": 26,
    "position": 1,
    "text": "همی پرورانید چون جان خویش"
  },
  {
    "poem_id": 1604,
    "vorder": 27,
    "position": 0,
    "text": "به گشتاسپ آگاهی آمد ز راه"
  },
  {
    "poem_id": 1604,
    "vorder": 28,
    "position": 1,
    "text": "نگون شد سر نامبردار شاه"
  },
  {
    "poem_id": 1604,
    "vorder": 29,
    "position": 0,
    "text": "همی جامه را چاک زد بر برش"
  },
  {
    "poem_id": 1604,
    "vorder": 30,
    "position": 1,
    "text": "به خاک اندر آمد سر و افسرش"
  },
  {
    "poem_id": 1604,
    "vorder": 31,
    "position": 0,
    "text": "خروشی برآمد ز ایوان به زار"
  },
  {
    "poem_id": 1604,
    "vorder": 32,
    "position": 1,
    "text": "جهان شد پر از نام اسفندیار"
  },
  {
    "poem_id": 1604,
    "vorder": 33,
    "position": 0,
    "text": "به ایران ز هر سو که رفت آگهی"
  },
  {
    "poem_id": 1604,
    "vorder": 34,
    "position": 1,
    "text": "بینداخت هرکس کلاه مهی"
  },
  {
    "poem_id": 1604,
    "vorder": 35,
    "position": 0,
    "text": "همی گفت گشتاسپ کای پاک دین"
  },
  {
    "poem_id": 1604,
    "vorder": 36,
    "position": 1,
    "text": "که چون تو نبیند زمان و زمین"
  },
  {
    "poem_id": 1604,
    "vorder": 37,
    "position": 0,
    "text": "پس از روزگار منوچهر باز"
  },
  {
    "poem_id": 1604,
    "vorder": 38,
    "position": 1,
    "text": "نیامد چو تو نیز گردنفراز"
  },
  {
    "poem_id": 1604,
    "vorder": 39,
    "position": 0,
    "text": "بیالود تیغ و بپالود کیش"
  },
  {
    "poem_id": 1604,
    "vorder": 40,
    "position": 1,
    "text": "مهان را همی داشت بر جای خویش"
  },
  {
    "poem_id": 1604,
    "vorder": 41,
    "position": 0,
    "text": "بزرگان ایران گرفتند خشم"
  },
  {
    "poem_id": 1604,
    "vorder": 42,
    "position": 1,
    "text": "ز آزرم گشتاسپ شستند چشم"
  },
  {
    "poem_id": 1604,
    "vorder": 43,
    "position": 0,
    "text": "به آواز گفتند کای شوربخت"
  },
  {
    "poem_id": 1604,
    "vorder": 44,
    "position": 1,
    "text": "چو اسفندیاری تو از بهر تخت"
  },
  {
    "poem_id": 1604,
    "vorder": 45,
    "position": 0,
    "text": "به زابل فرستی به کشتن دهی"
  },
  {
    "poem_id": 1604,
    "vorder": 46,
    "position": 1,
    "text": "تو بر گاه تاج مهی برنهی"
  },
  {
    "poem_id": 1604,
    "vorder": 47,
    "position": 0,
    "text": "سرت را ز تاج کیان شرم باد"
  },
  {
    "poem_id": 1604,
    "vorder": 48,
    "position": 1,
    "text": "به رفتن پی اخترت نرم باد"
  },
  {
    "poem_id": 1604,
    "vorder": 49,
    "position": 0,
    "text": "برفتند یکسر ز ایوان او"
  },
  {
    "poem_id": 1604,
    "vorder": 50,
    "position": 1,
    "text": "پر از خاک شد کاخ و دیوان او"
  },
  {
    "poem_id": 1604,
    "vorder": 51,
    "position": 0,
    "text": "چو آگاه شد مادر و خواهران"
  },
  {
    "poem_id": 1604,
    "vorder": 52,
    "position": 1,
    "text": "ز ایوان برفتند با دختران"
  },
  {
    "poem_id": 1604,
    "vorder": 53,
    "position": 0,
    "text": "برهنه سر و پای پرگرد و خاک"
  },
  {
    "poem_id": 1604,
    "vorder": 54,
    "position": 1,
    "text": "به تن بر همه جامه کردند چاک"
  },
  {
    "poem_id": 1604,
    "vorder": 55,
    "position": 0,
    "text": "پشوتن همی رفت گریان به راه"
  },
  {
    "poem_id": 1604,
    "vorder": 56,
    "position": 1,
    "text": "پس پشت تابوت و اسپ سیاه"
  },
  {
    "poem_id": 1604,
    "vorder": 57,
    "position": 0,
    "text": "زنان از پشوتن درآویختند"
  },
  {
    "poem_id": 1604,
    "vorder": 58,
    "position": 1,
    "text": "همی خون ز مژگان فرو ریختند"
  },
  {
    "poem_id": 1604,
    "vorder": 59,
    "position": 0,
    "text": "که این بند تابوت را برگشای"
  },
  {
    "poem_id": 1604,
    "vorder": 60,
    "position": 1,
    "text": "تن خسته یک بار ما را نمای"
  },
  {
    "poem_id": 1604,
    "vorder": 61,
    "position": 0,
    "text": "پشوتن غمی شد میان زنان"
  },
  {
    "poem_id": 1604,
    "vorder": 62,
    "position": 1,
    "text": "خروشان و گوشت از دو بازو کنان"
  },
  {
    "poem_id": 1604,
    "vorder": 63,
    "position": 0,
    "text": "به آهنگران گفت سوهان تیز"
  },
  {
    "poem_id": 1604,
    "vorder": 64,
    "position": 1,
    "text": "بیارید کامد کنون رستخیز"
  },
  {
    "poem_id": 1604,
    "vorder": 65,
    "position": 0,
    "text": "سر تنگ تابوت را باز کرد"
  },
  {
    "poem_id": 1604,
    "vorder": 66,
    "position": 1,
    "text": "به نوی یکی مویه آغاز کرد"
  },
  {
    "poem_id": 1604,
    "vorder": 67,
    "position": 0,
    "text": "چو مادرش با خواهران روی شاه"
  },
  {
    "poem_id": 1604,
    "vorder": 68,
    "position": 1,
    "text": "پر از مشک دیدند ریش سیاه"
  },
  {
    "poem_id": 1604,
    "vorder": 69,
    "position": 0,
    "text": "برفتند یکسر ز بالین شاه"
  },
  {
    "poem_id": 1604,
    "vorder": 70,
    "position": 1,
    "text": "خروشان به نزدیک اسپ سیاه"
  },
  {
    "poem_id": 1604,
    "vorder": 71,
    "position": 0,
    "text": "بسودند پر مهر یال و برش"
  },
  {
    "poem_id": 1604,
    "vorder": 72,
    "position": 1,
    "text": "کتایون همی ریخت خاک از برش"
  },
  {
    "poem_id": 1604,
    "vorder": 73,
    "position": 0,
    "text": "کزو شاه را روز برگشته بود"
  },
  {
    "poem_id": 1604,
    "vorder": 74,
    "position": 1,
    "text": "به آورد بر پشت او کشته بود"
  },
  {
    "poem_id": 1604,
    "vorder": 75,
    "position": 0,
    "text": "کزین پس کرا برد خواهی به جنگ"
  },
  {
    "poem_id": 1604,
    "vorder": 76,
    "position": 1,
    "text": "کرا داد خواهی به چنگ نهنگ"
  },
  {
    "poem_id": 1604,
    "vorder": 77,
    "position": 0,
    "text": "به یالش همی اندرآویختند"
  },
  {
    "poem_id": 1604,
    "vorder": 78,
    "position": 1,
    "text": "همی خاک بر تارکش ریختند"
  },
  {
    "poem_id": 1604,
    "vorder": 79,
    "position": 0,
    "text": "به ابر اندر آمد خروش سپاه"
  },
  {
    "poem_id": 1604,
    "vorder": 80,
    "position": 1,
    "text": "پشوتن بیامد به ایوان شاه"
  },
  {
    "poem_id": 1604,
    "vorder": 81,
    "position": 0,
    "text": "خروشید و دیدش نبردش نماز"
  },
  {
    "poem_id": 1604,
    "vorder": 82,
    "position": 1,
    "text": "بیامد به نزدیک تختش فراز"
  },
  {
    "poem_id": 1604,
    "vorder": 83,
    "position": 0,
    "text": "به آواز گفت ای سر سرکشان"
  },
  {
    "poem_id": 1604,
    "vorder": 84,
    "position": 1,
    "text": "ز برگشتن بختت آمد نشان"
  },
  {
    "poem_id": 1604,
    "vorder": 85,
    "position": 0,
    "text": "ازین با تن خویش بد کرده‌ای"
  },
  {
    "poem_id": 1604,
    "vorder": 86,
    "position": 1,
    "text": "دم از شهر ایران برآورده‌ای"
  },
  {
    "poem_id": 1604,
    "vorder": 87,
    "position": 0,
    "text": "ز تو دور شد فره و بخردی"
  },
  {
    "poem_id": 1604,
    "vorder": 88,
    "position": 1,
    "text": "بیابی تو بادافره ایزدی"
  },
  {
    "poem_id": 1604,
    "vorder": 89,
    "position": 0,
    "text": "شکسته شد این نامور پشت تو"
  },
  {
    "poem_id": 1604,
    "vorder": 90,
    "position": 1,
    "text": "کزین پس بود باد در مشت تو"
  },
  {
    "poem_id": 1604,
    "vorder": 91,
    "position": 0,
    "text": "پسر را به خون دادی از بهر تخت"
  },
  {
    "poem_id": 1604,
    "vorder": 92,
    "position": 1,
    "text": "که مه تخت بیناد چشمت مه بخت"
  },
  {
    "poem_id": 1604,
    "vorder": 93,
    "position": 0,
    "text": "جهانی پر از دشمن و پر بدان"
  },
  {
    "poem_id": 1604,
    "vorder": 94,
    "position": 1,
    "text": "نماند بتو تاج تا جاودان"
  },
  {
    "poem_id": 1604,
    "vorder": 95,
    "position": 0,
    "text": "بدین گیتیت در نکوهش بود"
  },
  {
    "poem_id": 1604,
    "vorder": 96,
    "position": 1,
    "text": "به روز شمارت پژوهش بود"
  },
  {
    "poem_id": 1604,
    "vorder": 97,
    "position": 0,
    "text": "بگفت این و رخ سوی جاماسپ کرد"
  },
  {
    "poem_id": 1604,
    "vorder": 98,
    "position": 1,
    "text": "که ای شوم بدکیش و بدزاد مرد"
  },
  {
    "poem_id": 1604,
    "vorder": 99,
    "position": 0,
    "text": "ز گیتی ندانی سخن جز دروغ"
  },
  {
    "poem_id": 1604,
    "vorder": 100,
    "position": 1,
    "text": "به کژی گرفتی ز هرکس فروغ"
  },
  {
    "poem_id": 1604,
    "vorder": 101,
    "position": 0,
    "text": "میان کیان دشمنی افگنی"
  },
  {
    "poem_id": 1604,
    "vorder": 102,
    "position": 1,
    "text": "همی این بدان آن بدین برزنی"
  },
  {
    "poem_id": 1604,
    "vorder": 103,
    "position": 0,
    "text": "ندانی همی جز بد آموختن"
  },
  {
    "poem_id": 1604,
    "vorder": 104,
    "position": 1,
    "text": "گسستن ز نیکی بدی توختن"
  },
  {
    "poem_id": 1604,
    "vorder": 105,
    "position": 0,
    "text": "یکی کشت کردی تو اندر جهان"
  },
  {
    "poem_id": 1604,
    "vorder": 106,
    "position": 1,
    "text": "که کس ندرود آشکار و نهان"
  },
  {
    "poem_id": 1604,
    "vorder": 107,
    "position": 0,
    "text": "بزرگی به گفتار تو کشته شد"
  },
  {
    "poem_id": 1604,
    "vorder": 108,
    "position": 1,
    "text": "که روز بزرگان همه گشته شد"
  },
  {
    "poem_id": 1604,
    "vorder": 109,
    "position": 0,
    "text": "تو آموختی شاه را راه کژ"
  },
  {
    "poem_id": 1604,
    "vorder": 110,
    "position": 1,
    "text": "ایا پیر بی‌راه و کوتاه و کژ"
  },
  {
    "poem_id": 1604,
    "vorder": 111,
    "position": 0,
    "text": "تو گفتی که هوش یل اسفندیار"
  },
  {
    "poem_id": 1604,
    "vorder": 112,
    "position": 1,
    "text": "بود بر کف رستم نامدار"
  },
  {
    "poem_id": 1604,
    "vorder": 113,
    "position": 0,
    "text": "بگفت این و گویا زبان برگشاد"
  },
  {
    "poem_id": 1604,
    "vorder": 114,
    "position": 1,
    "text": "همه پند و اندرز او کرد یاد"
  },
  {
    "poem_id": 1604,
    "vorder": 115,
    "position": 0,
    "text": "هم اندرز بهمن به رستم بگفت"
  },
  {
    "poem_id": 1604,
    "vorder": 116,
    "position": 1,
    "text": "برآورد رازی که بود از نهفت"
  },
  {
    "poem_id": 1604,
    "vorder": 117,
    "position": 0,
    "text": "چو بشنید اندرز او شهریار"
  },
  {
    "poem_id": 1604,
    "vorder": 118,
    "position": 1,
    "text": "پشیمان شد از کار اسفندیار"
  },
  {
    "poem_id": 1604,
    "vorder": 119,
    "position": 0,
    "text": "پشوتن بگفت آنچ بودش نهان"
  },
  {
    "poem_id": 1604,
    "vorder": 120,
    "position": 1,
    "text": "به آواز با شهریار جهان"
  },
  {
    "poem_id": 1604,
    "vorder": 121,
    "position": 0,
    "text": "چو پردخته گشت از بزرگان سرای"
  },
  {
    "poem_id": 1604,
    "vorder": 122,
    "position": 1,
    "text": "برفتند به آفرید و همای"
  },
  {
    "poem_id": 1604,
    "vorder": 123,
    "position": 0,
    "text": "به پیش پدر بر بخستند روی"
  },
  {
    "poem_id": 1604,
    "vorder": 124,
    "position": 1,
    "text": "ز درد برادر بکندند موی"
  },
  {
    "poem_id": 1604,
    "vorder": 125,
    "position": 0,
    "text": "به گشتاسپ گفتند کای نامدار"
  },
  {
    "poem_id": 1604,
    "vorder": 126,
    "position": 1,
    "text": "نیندیشی از کار اسفندیار"
  },
  {
    "poem_id": 1604,
    "vorder": 127,
    "position": 0,
    "text": "کجا شد نخستین به کین زریر"
  },
  {
    "poem_id": 1604,
    "vorder": 128,
    "position": 1,
    "text": "همی گور بستد ز چنگال شیر"
  },
  {
    "poem_id": 1604,
    "vorder": 129,
    "position": 0,
    "text": "ز ترکان همی کین او بازخواست"
  },
  {
    "poem_id": 1604,
    "vorder": 130,
    "position": 1,
    "text": "بدو شد همی پادشاهیت راست"
  },
  {
    "poem_id": 1604,
    "vorder": 131,
    "position": 0,
    "text": "به گفتار بدگوش کردی به بند"
  },
  {
    "poem_id": 1604,
    "vorder": 132,
    "position": 1,
    "text": "بغل گران و به گرز و کمند"
  },
  {
    "poem_id": 1604,
    "vorder": 133,
    "position": 0,
    "text": "چو او بسته آمد نیا کشته شد"
  },
  {
    "poem_id": 1604,
    "vorder": 134,
    "position": 1,
    "text": "سپه را همه روز برگشته شد"
  },
  {
    "poem_id": 1604,
    "vorder": 135,
    "position": 0,
    "text": "چو ارجاسپ آمد ز خلخ به بلخ"
  },
  {
    "poem_id": 1604,
    "vorder": 136,
    "position": 1,
    "text": "همه زندگانی شد از رنج تلخ"
  },
  {
    "poem_id": 1604,
    "vorder": 137,
    "position": 0,
    "text": "چو ما را که پوشیده داریم روی"
  },
  {
    "poem_id": 1604,
    "vorder": 138,
    "position": 1,
    "text": "برهنه بیاورد ز ایوان به کوی"
  },
  {
    "poem_id": 1604,
    "vorder": 139,
    "position": 0,
    "text": "چو نوش‌آذر زردهشتی بکشت"
  },
  {
    "poem_id": 1604,
    "vorder": 140,
    "position": 1,
    "text": "گرفت آن زمان پادشاهی به مشت"
  },
  {
    "poem_id": 1604,
    "vorder": 141,
    "position": 0,
    "text": "تو دانی که فرزند مردی چه کرد"
  },
  {
    "poem_id": 1604,
    "vorder": 142,
    "position": 1,
    "text": "برآورد ازیشان دم و دود و گرد"
  },
  {
    "poem_id": 1604,
    "vorder": 143,
    "position": 0,
    "text": "ز رویین دژ آورد ما را برت"
  },
  {
    "poem_id": 1604,
    "vorder": 144,
    "position": 1,
    "text": "نگهبان کشور بد و افسرت"
  },
  {
    "poem_id": 1604,
    "vorder": 145,
    "position": 0,
    "text": "از ایدر به زابل فرستادیش"
  },
  {
    "poem_id": 1604,
    "vorder": 146,
    "position": 1,
    "text": "بسی پند و اندرزها دادیش"
  },
  {
    "poem_id": 1604,
    "vorder": 147,
    "position": 0,
    "text": "که تا از پی تاج بیجان شود"
  },
  {
    "poem_id": 1604,
    "vorder": 148,
    "position": 1,
    "text": "جهانی برو زار و پیچان شود"
  },
  {
    "poem_id": 1604,
    "vorder": 149,
    "position": 0,
    "text": "نه سیمرغ کشتش نه رستم نه زال"
  },
  {
    "poem_id": 1604,
    "vorder": 150,
    "position": 1,
    "text": "تو کشتی مر او را چو کشتی منال"
  },
  {
    "poem_id": 1604,
    "vorder": 151,
    "position": 0,
    "text": "ترا شرم بادا ز ریش سپید"
  },
  {
    "poem_id": 1604,
    "vorder": 152,
    "position": 1,
    "text": "که فرزند کشتی ز بهر امید"
  },
  {
    "poem_id": 1604,
    "vorder": 153,
    "position": 0,
    "text": "جهاندار پیش از تو بسیار بود"
  },
  {
    "poem_id": 1604,
    "vorder": 154,
    "position": 1,
    "text": "که بر تخت شاهی سزاوار بود"
  },
  {
    "poem_id": 1604,
    "vorder": 155,
    "position": 0,
    "text": "به کشتن ندادند فرزند را"
  },
  {
    "poem_id": 1604,
    "vorder": 156,
    "position": 1,
    "text": "نه از دودهٔ خویش و پیوند را"
  },
  {
    "poem_id": 1604,
    "vorder": 157,
    "position": 0,
    "text": "چنین گفت پس با پشوتن که خیز"
  },
  {
    "poem_id": 1604,
    "vorder": 158,
    "position": 1,
    "text": "برین آتش تیزبر آب ریز"
  },
  {
    "poem_id": 1604,
    "vorder": 159,
    "position": 0,
    "text": "بیامد پشوتن ز ایوان شاه"
  },
  {
    "poem_id": 1604,
    "vorder": 160,
    "position": 1,
    "text": "زنان را بیاورد زان جایگاه"
  },
  {
    "poem_id": 1604,
    "vorder": 161,
    "position": 0,
    "text": "پشوتن چنین گفت با مادرش"
  },
  {
    "poem_id": 1604,
    "vorder": 162,
    "position": 1,
    "text": "که چندین به تنگی چه کوبی درش"
  },
  {
    "poem_id": 1604,
    "vorder": 163,
    "position": 0,
    "text": "که او شاد خفتست و روشن‌روان"
  },
  {
    "poem_id": 1604,
    "vorder": 164,
    "position": 1,
    "text": "چو سیر آمد از مرز و از مرزبان"
  },
  {
    "poem_id": 1604,
    "vorder": 165,
    "position": 0,
    "text": "بپذرفت مادر ز دین‌دار پند"
  },
  {
    "poem_id": 1604,
    "vorder": 166,
    "position": 1,
    "text": "به داد خداوند کرد او پسند"
  },
  {
    "poem_id": 1604,
    "vorder": 167,
    "position": 0,
    "text": "ازان پس به سالی به هر برزنی"
  },
  {
    "poem_id": 1604,
    "vorder": 168,
    "position": 1,
    "text": "به ایران خروشی بد و شیونی"
  },
  {
    "poem_id": 1604,
    "vorder": 169,
    "position": 0,
    "text": "ز تیر گز و بند دستان زال"
  },
  {
    "poem_id": 1604,
    "vorder": 170,
    "position": 1,
    "text": "همی مویه کردند بسیار سال"
  }
]