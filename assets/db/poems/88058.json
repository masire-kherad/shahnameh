[
  {
    "poem_id": 88058,
    "vorder": 1,
    "position": 0,
    "text": "چو از روز نه ساعت اندر گذشت"
  },
  {
    "poem_id": 88058,
    "vorder": 2,
    "position": 1,
    "text": "خور از گنبد چرخ گردان بگشت"
  },
  {
    "poem_id": 88058,
    "vorder": 3,
    "position": 0,
    "text": "جهاندار خسرو به نزد سپاه"
  },
  {
    "poem_id": 88058,
    "vorder": 4,
    "position": 1,
    "text": "بیامد بدان دشت آوردگاه"
  },
  {
    "poem_id": 88058,
    "vorder": 5,
    "position": 0,
    "text": "پذیره شدندش سراسر سران"
  },
  {
    "poem_id": 88058,
    "vorder": 6,
    "position": 1,
    "text": "همه نامداران و جنگاوران"
  },
  {
    "poem_id": 88058,
    "vorder": 7,
    "position": 0,
    "text": "بر او خواندند آفرین بخردان"
  },
  {
    "poem_id": 88058,
    "vorder": 8,
    "position": 1,
    "text": "که ای شهریار و سر موبدان"
  },
  {
    "poem_id": 88058,
    "vorder": 9,
    "position": 0,
    "text": "چنان هم همی بود بر اسب شاه"
  },
  {
    "poem_id": 88058,
    "vorder": 10,
    "position": 1,
    "text": "بدان تا ببینند رویش سپاه"
  },
  {
    "poem_id": 88058,
    "vorder": 11,
    "position": 0,
    "text": "بر ایشان همی خواند شاه آفرین"
  },
  {
    "poem_id": 88058,
    "vorder": 12,
    "position": 1,
    "text": "که آباد بادا به گردان زمین"
  },
  {
    "poem_id": 88058,
    "vorder": 13,
    "position": 0,
    "text": "به آیین پس پشت لشکر چو کوه"
  },
  {
    "poem_id": 88058,
    "vorder": 14,
    "position": 1,
    "text": "همی رفت گودرز با آن گروه"
  },
  {
    "poem_id": 88058,
    "vorder": 15,
    "position": 0,
    "text": "سر کشتگان را فگنده نگون"
  },
  {
    "poem_id": 88058,
    "vorder": 16,
    "position": 1,
    "text": "سلیح و تن و جامه هاشان به خون"
  },
  {
    "poem_id": 88058,
    "vorder": 17,
    "position": 0,
    "text": "همان ده مبارز کز آوردگاه"
  },
  {
    "poem_id": 88058,
    "vorder": 18,
    "position": 1,
    "text": "بیاورده بودند گردان شاه"
  },
  {
    "poem_id": 88058,
    "vorder": 19,
    "position": 0,
    "text": "پس لشکر اندر همی راندند"
  },
  {
    "poem_id": 88058,
    "vorder": 20,
    "position": 1,
    "text": "ابر شهریار آفرین خواندند"
  },
  {
    "poem_id": 88058,
    "vorder": 21,
    "position": 0,
    "text": "چو گودرز نزدیک خسرو رسید"
  },
  {
    "poem_id": 88058,
    "vorder": 22,
    "position": 1,
    "text": "پیاده شد از دور کو را بدید"
  },
  {
    "poem_id": 88058,
    "vorder": 23,
    "position": 0,
    "text": "ستایش کنان پهلوان سپاه"
  },
  {
    "poem_id": 88058,
    "vorder": 24,
    "position": 1,
    "text": "بیامد بغلتید در پیش شاه"
  },
  {
    "poem_id": 88058,
    "vorder": 25,
    "position": 0,
    "text": "همه کشتگان را به خسرو نمود"
  },
  {
    "poem_id": 88058,
    "vorder": 26,
    "position": 1,
    "text": "بگفتش که همرزم هر کس که بود"
  },
  {
    "poem_id": 88058,
    "vorder": 27,
    "position": 0,
    "text": "گروی زره را بیاورد گیو"
  },
  {
    "poem_id": 88058,
    "vorder": 28,
    "position": 1,
    "text": "دمان با سپهدار پیران نیو"
  },
  {
    "poem_id": 88058,
    "vorder": 29,
    "position": 0,
    "text": "ز اسب اندر آمد سبک شهریار"
  },
  {
    "poem_id": 88058,
    "vorder": 30,
    "position": 1,
    "text": "نیایش همی کرد بر کردگار"
  },
  {
    "poem_id": 88058,
    "vorder": 31,
    "position": 0,
    "text": "ز یزدان سپاس و بدویم پناه"
  },
  {
    "poem_id": 88058,
    "vorder": 32,
    "position": 1,
    "text": "که او داد پیروزی و دستگاه"
  },
  {
    "poem_id": 88058,
    "vorder": 33,
    "position": 0,
    "text": "ز دادار بر پهلوان آفرین"
  },
  {
    "poem_id": 88058,
    "vorder": 34,
    "position": 1,
    "text": "همی خواند و بر لشکرش همچنین"
  },
  {
    "poem_id": 88058,
    "vorder": 35,
    "position": 0,
    "text": "که ای نامداران فرخنده پی"
  },
  {
    "poem_id": 88058,
    "vorder": 36,
    "position": 1,
    "text": "شما آتش و دشمنان خشک نی"
  },
  {
    "poem_id": 88058,
    "vorder": 37,
    "position": 0,
    "text": "سپهدار گودرز با دودمان"
  },
  {
    "poem_id": 88058,
    "vorder": 38,
    "position": 1,
    "text": "ز بهر دل من چو آتش دمان"
  },
  {
    "poem_id": 88058,
    "vorder": 39,
    "position": 0,
    "text": "همه جان و تن ها فدا کرده‌اند"
  },
  {
    "poem_id": 88058,
    "vorder": 40,
    "position": 1,
    "text": "دم از شهر توران برآورده‌اند"
  },
  {
    "poem_id": 88058,
    "vorder": 41,
    "position": 0,
    "text": "کنون گنج و شاهی مرا با شماست"
  },
  {
    "poem_id": 88058,
    "vorder": 42,
    "position": 1,
    "text": "ندارم دریغ از شما دست راست"
  },
  {
    "poem_id": 88058,
    "vorder": 43,
    "position": 0,
    "text": "از آن پس بدان کشتگان بنگرید"
  },
  {
    "poem_id": 88058,
    "vorder": 44,
    "position": 1,
    "text": "چو روی سپهدار پیران بدید"
  },
  {
    "poem_id": 88058,
    "vorder": 45,
    "position": 0,
    "text": "فروریخت آب از دو دیده به درد"
  },
  {
    "poem_id": 88058,
    "vorder": 46,
    "position": 1,
    "text": "که کردار نیکی همی یاد کرد"
  },
  {
    "poem_id": 88058,
    "vorder": 47,
    "position": 0,
    "text": "به پیرانش بر دل از آن سان بسوخت"
  },
  {
    "poem_id": 88058,
    "vorder": 48,
    "position": 1,
    "text": "تو گفتی به دلش آتشی برفروخت"
  },
  {
    "poem_id": 88058,
    "vorder": 49,
    "position": 0,
    "text": "یکی داستان زد پس از مرگ اوی"
  },
  {
    "poem_id": 88058,
    "vorder": 50,
    "position": 1,
    "text": "به خون دو دیده بیالود روی"
  },
  {
    "poem_id": 88058,
    "vorder": 51,
    "position": 0,
    "text": "که بخت بد است اژدهای دژم"
  },
  {
    "poem_id": 88058,
    "vorder": 52,
    "position": 1,
    "text": "به دام آورد شیر شرزه به دم"
  },
  {
    "poem_id": 88058,
    "vorder": 53,
    "position": 0,
    "text": "به مردی نیابد کسی زو رها"
  },
  {
    "poem_id": 88058,
    "vorder": 54,
    "position": 1,
    "text": "چنین آمد این تیزچنگ اژدها"
  },
  {
    "poem_id": 88058,
    "vorder": 55,
    "position": 0,
    "text": "کشیدی همه ساله تیمار من"
  },
  {
    "poem_id": 88058,
    "vorder": 56,
    "position": 1,
    "text": "میان بسته بودی به پیکار من"
  },
  {
    "poem_id": 88058,
    "vorder": 57,
    "position": 0,
    "text": "ز خون سیاوش پر از درد بود"
  },
  {
    "poem_id": 88058,
    "vorder": 58,
    "position": 1,
    "text": "بدانگه کسی را نیازرد بود"
  },
  {
    "poem_id": 88058,
    "vorder": 59,
    "position": 0,
    "text": "چنان مهربان بود دژخیم شد"
  },
  {
    "poem_id": 88058,
    "vorder": 60,
    "position": 1,
    "text": "وز او شهر ایران پر از بیم شد"
  },
  {
    "poem_id": 88058,
    "vorder": 61,
    "position": 0,
    "text": "مر او را ببرد اهرمن دل ز جای"
  },
  {
    "poem_id": 88058,
    "vorder": 62,
    "position": 1,
    "text": "دگرگونه پیش اندر آورد پای"
  },
  {
    "poem_id": 88058,
    "vorder": 63,
    "position": 0,
    "text": "فراوان همی خیره دادمش پند"
  },
  {
    "poem_id": 88058,
    "vorder": 64,
    "position": 1,
    "text": "نیامدش گفتار من سودمند"
  },
  {
    "poem_id": 88058,
    "vorder": 65,
    "position": 0,
    "text": "از افراسیابش نه برگشت سر"
  },
  {
    "poem_id": 88058,
    "vorder": 66,
    "position": 1,
    "text": "کنون شهریارش چنین داد بر"
  },
  {
    "poem_id": 88058,
    "vorder": 67,
    "position": 0,
    "text": "مکافات او ما جز این خواستیم"
  },
  {
    "poem_id": 88058,
    "vorder": 68,
    "position": 1,
    "text": "همی گاه و دیهیمش آراستیم"
  },
  {
    "poem_id": 88058,
    "vorder": 69,
    "position": 0,
    "text": "از اندیشهٔ ما سخن درگذشت"
  },
  {
    "poem_id": 88058,
    "vorder": 70,
    "position": 1,
    "text": "فلک بر سرش بر دگرگونه گشت"
  },
  {
    "poem_id": 88058,
    "vorder": 71,
    "position": 0,
    "text": "به دل بر جفا کرد بر جای مهر"
  },
  {
    "poem_id": 88058,
    "vorder": 72,
    "position": 1,
    "text": "بدین سر دگرگونه بنمود چهر"
  },
  {
    "poem_id": 88058,
    "vorder": 73,
    "position": 0,
    "text": "کنون پند گودرز و فرمان من"
  },
  {
    "poem_id": 88058,
    "vorder": 74,
    "position": 1,
    "text": "بیفگند گفتار و پیمان من"
  },
  {
    "poem_id": 88058,
    "vorder": 75,
    "position": 0,
    "text": "تبه کرد مهر دل پاک را"
  },
  {
    "poem_id": 88058,
    "vorder": 76,
    "position": 1,
    "text": "به زهر اندر آمیخت تریاک را"
  },
  {
    "poem_id": 88058,
    "vorder": 77,
    "position": 0,
    "text": "که آمد به جنگ شما با سپاه"
  },
  {
    "poem_id": 88058,
    "vorder": 78,
    "position": 1,
    "text": "که چندان شد از شهر ایران تباه"
  },
  {
    "poem_id": 88058,
    "vorder": 79,
    "position": 0,
    "text": "ز توران بسیچید و آمد دمان"
  },
  {
    "poem_id": 88058,
    "vorder": 80,
    "position": 1,
    "text": "که ژوپین گودرز بودش زمان"
  },
  {
    "poem_id": 88058,
    "vorder": 81,
    "position": 0,
    "text": "پسر با برادر کلاه و کمر"
  },
  {
    "poem_id": 88058,
    "vorder": 82,
    "position": 1,
    "text": "سلیح و سپاه و همه بوم و بر"
  },
  {
    "poem_id": 88058,
    "vorder": 83,
    "position": 0,
    "text": "بداد از پی مهر افراسیاب"
  },
  {
    "poem_id": 88058,
    "vorder": 84,
    "position": 1,
    "text": "زمانه بر او کرد چندین شتاب"
  },
  {
    "poem_id": 88058,
    "vorder": 85,
    "position": 0,
    "text": "بفرمود تا مشک و کافور ناب"
  },
  {
    "poem_id": 88058,
    "vorder": 86,
    "position": 1,
    "text": "به عنبر برآمیخته با گلاب"
  },
  {
    "poem_id": 88058,
    "vorder": 87,
    "position": 0,
    "text": "تنش را بیالود زان سر به سر"
  },
  {
    "poem_id": 88058,
    "vorder": 88,
    "position": 1,
    "text": "به کافور و مشکش بیاگند سر"
  },
  {
    "poem_id": 88058,
    "vorder": 89,
    "position": 0,
    "text": "به دیبای رومی تن پاک اوی"
  },
  {
    "poem_id": 88058,
    "vorder": 90,
    "position": 1,
    "text": "بپوشید آن جان ناپاک اوی"
  },
  {
    "poem_id": 88058,
    "vorder": 91,
    "position": 0,
    "text": "یکی دخمه فرمود خسرو به مهر"
  },
  {
    "poem_id": 88058,
    "vorder": 92,
    "position": 1,
    "text": "بر آورده سر تا به گردان سپهر"
  },
  {
    "poem_id": 88058,
    "vorder": 93,
    "position": 0,
    "text": "نهاد اندر او تختهای گران"
  },
  {
    "poem_id": 88058,
    "vorder": 94,
    "position": 1,
    "text": "چنانچون بود در خور مهتران"
  },
  {
    "poem_id": 88058,
    "vorder": 95,
    "position": 0,
    "text": "نهادند مر پهلوان را به گاه"
  },
  {
    "poem_id": 88058,
    "vorder": 96,
    "position": 1,
    "text": "کمر بر میان و به سر بر کلاه"
  },
  {
    "poem_id": 88058,
    "vorder": 97,
    "position": 0,
    "text": "چنین است کردار این پر فریب"
  },
  {
    "poem_id": 88058,
    "vorder": 98,
    "position": 1,
    "text": "چه مایه فراز است و چندی نشیب"
  },
  {
    "poem_id": 88058,
    "vorder": 99,
    "position": 0,
    "text": "خردمند را دل ز کردار اوی"
  },
  {
    "poem_id": 88058,
    "vorder": 100,
    "position": 1,
    "text": "بماند همی خیره از کار اوی"
  },
  {
    "poem_id": 88058,
    "vorder": 101,
    "position": 0,
    "text": "از آن پس گروی زره را بدید"
  },
  {
    "poem_id": 88058,
    "vorder": 102,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 88058,
    "vorder": 103,
    "position": 0,
    "text": "نگه کرد خسرو بدان زشت روی"
  },
  {
    "poem_id": 88058,
    "vorder": 104,
    "position": 1,
    "text": "چو دیوی به سر بر فروهشته موی"
  },
  {
    "poem_id": 88058,
    "vorder": 105,
    "position": 0,
    "text": "همی گفت کای کردگار جهان"
  },
  {
    "poem_id": 88058,
    "vorder": 106,
    "position": 1,
    "text": "تو دانی همی آشکار و نهان"
  },
  {
    "poem_id": 88058,
    "vorder": 107,
    "position": 0,
    "text": "همانا که کاووس بد کرده بود"
  },
  {
    "poem_id": 88058,
    "vorder": 108,
    "position": 1,
    "text": "به پاداش از او زهر و کین آزمود"
  },
  {
    "poem_id": 88058,
    "vorder": 109,
    "position": 0,
    "text": "که دیوی چنین بر سیاوش گماشت"
  },
  {
    "poem_id": 88058,
    "vorder": 110,
    "position": 1,
    "text": "ندانم جز این کینه بر دل چه داشت"
  },
  {
    "poem_id": 88058,
    "vorder": 111,
    "position": 0,
    "text": "ولیکن به پیروزی یک خدای"
  },
  {
    "poem_id": 88058,
    "vorder": 112,
    "position": 1,
    "text": "جهاندار نیکی ده و رهنمای"
  },
  {
    "poem_id": 88058,
    "vorder": 113,
    "position": 0,
    "text": "که خون سیاوش ز افراسیاب"
  },
  {
    "poem_id": 88058,
    "vorder": 114,
    "position": 1,
    "text": "بخواهم بدین کینه گیرم شتاب"
  },
  {
    "poem_id": 88058,
    "vorder": 115,
    "position": 0,
    "text": "گروی زره را گره تا گره"
  },
  {
    "poem_id": 88058,
    "vorder": 116,
    "position": 1,
    "text": "بفرمود تا برکشیدند زه"
  },
  {
    "poem_id": 88058,
    "vorder": 117,
    "position": 0,
    "text": "چو بندش جدا شد سرش را ز بند"
  },
  {
    "poem_id": 88058,
    "vorder": 118,
    "position": 1,
    "text": "بریدند همچون سر گوسفند"
  },
  {
    "poem_id": 88058,
    "vorder": 119,
    "position": 0,
    "text": "بفرمود او را فگندن به آب"
  },
  {
    "poem_id": 88058,
    "vorder": 120,
    "position": 1,
    "text": "بگفتا چنین بینم افراسیاب"
  },
  {
    "poem_id": 88058,
    "vorder": 121,
    "position": 0,
    "text": "ببد شاه چندی بر آن رزمگاه"
  },
  {
    "poem_id": 88058,
    "vorder": 122,
    "position": 1,
    "text": "بدان تا کند ساز کار سپاه"
  },
  {
    "poem_id": 88058,
    "vorder": 123,
    "position": 0,
    "text": "دهد پادشاهی که را در خور است"
  },
  {
    "poem_id": 88058,
    "vorder": 124,
    "position": 1,
    "text": "کسی کز در خلعت و افسر است"
  },
  {
    "poem_id": 88058,
    "vorder": 125,
    "position": 0,
