[
  {
    "poem_id": 1606,
    "vorder": 1,
    "position": 0,
    "text": "یکی پیر بد نامش آزاد سرو"
  },
  {
    "poem_id": 1606,
    "vorder": 2,
    "position": 1,
    "text": "که با احمد سهل بودی به مرو"
  },
  {
    "poem_id": 1606,
    "vorder": 3,
    "position": 0,
    "text": "دلی پر ز دانش سری پر سخن"
  },
  {
    "poem_id": 1606,
    "vorder": 4,
    "position": 1,
    "text": "زبان پر ز گفتارهای کهن"
  },
  {
    "poem_id": 1606,
    "vorder": 5,
    "position": 0,
    "text": "کجا نامهٔ خسروان داشتی"
  },
  {
    "poem_id": 1606,
    "vorder": 6,
    "position": 1,
    "text": "تن و پیکر پهلوان داشتی"
  },
  {
    "poem_id": 1606,
    "vorder": 7,
    "position": 0,
    "text": "به سام نریمان کشیدی نژاد"
  },
  {
    "poem_id": 1606,
    "vorder": 8,
    "position": 1,
    "text": "بسی داشتی رزم رستم به یاد"
  },
  {
    "poem_id": 1606,
    "vorder": 9,
    "position": 0,
    "text": "بگویم کنون آنچ ازو یافتم"
  },
  {
    "poem_id": 1606,
    "vorder": 10,
    "position": 1,
    "text": "سخن را یک اندر دگر بافتم"
  },
  {
    "poem_id": 1606,
    "vorder": 11,
    "position": 0,
    "text": "اگر مانم اندر سپنجی سرای"
  },
  {
    "poem_id": 1606,
    "vorder": 12,
    "position": 1,
    "text": "روان و خرد باشدم رهنمای"
  },
  {
    "poem_id": 1606,
    "vorder": 13,
    "position": 0,
    "text": "سرآرم من این نامهٔ باستان"
  },
  {
    "poem_id": 1606,
    "vorder": 14,
    "position": 1,
    "text": "به گیتی بمانم یکی داستان"
  },
  {
    "poem_id": 1606,
    "vorder": 15,
    "position": 0,
    "text": "به نام جهاندار محمود شاه"
  },
  {
    "poem_id": 1606,
    "vorder": 16,
    "position": 1,
    "text": "ابوالقاسم آن فر دیهیم و گاه"
  },
  {
    "poem_id": 1606,
    "vorder": 17,
    "position": 0,
    "text": "خداوند ایران و نیران و هند"
  },
  {
    "poem_id": 1606,
    "vorder": 18,
    "position": 1,
    "text": "ز فرش جهان شد چو رومی پرند"
  },
  {
    "poem_id": 1606,
    "vorder": 19,
    "position": 0,
    "text": "به بخشش همی گنج بپراگند"
  },
  {
    "poem_id": 1606,
    "vorder": 20,
    "position": 1,
    "text": "به دانایی از گنج نام آگند"
  },
  {
    "poem_id": 1606,
    "vorder": 21,
    "position": 0,
    "text": "بزرگست و چون سالیان بگذرد"
  },
  {
    "poem_id": 1606,
    "vorder": 22,
    "position": 1,
    "text": "ازو گوید آنکس که دارد خرد"
  },
  {
    "poem_id": 1606,
    "vorder": 23,
    "position": 0,
    "text": "ز رزم و ز بزم و ز بخش و شکار"
  },
  {
    "poem_id": 1606,
    "vorder": 24,
    "position": 1,
    "text": "ز دادش جهان شد چو خرم بهار"
  },
  {
    "poem_id": 1606,
    "vorder": 25,
    "position": 0,
    "text": "خنک آنک بیند کلاه ورا"
  },
  {
    "poem_id": 1606,
    "vorder": 26,
    "position": 1,
    "text": "همان بارگاه و سپاه ورا"
  },
  {
    "poem_id": 1606,
    "vorder": 27,
    "position": 0,
    "text": "دو گوش و دو پای من آهو گرفت"
  },
  {
    "poem_id": 1606,
    "vorder": 28,
    "position": 1,
    "text": "تهی دستی و سال نیرو گرفت"
  },
  {
    "poem_id": 1606,
    "vorder": 29,
    "position": 0,
    "text": "ببستم برین گونه بدخواه بخت"
  },
  {
    "poem_id": 1606,
    "vorder": 30,
    "position": 1,
    "text": "بنالم ز بخت بد و سال سخت"
  },
  {
    "poem_id": 1606,
    "vorder": 31,
    "position": 0,
    "text": "شب و روز خوانم همی آفرین"
  },
  {
    "poem_id": 1606,
    "vorder": 32,
    "position": 1,
    "text": "بران دادگر شهریار زمین"
  },
  {
    "poem_id": 1606,
    "vorder": 33,
    "position": 0,
    "text": "همه شهر با من بدین یاورند"
  },
  {
    "poem_id": 1606,
    "vorder": 34,
    "position": 1,
    "text": "جز آنکس که بددین و بدگوهرند"
  },
  {
    "poem_id": 1606,
    "vorder": 35,
    "position": 0,
    "text": "که تا او به تخت کیی برنشست"
  },
  {
    "poem_id": 1606,
    "vorder": 36,
    "position": 1,
    "text": "در کین و دست بدی را ببست"
  },
  {
    "poem_id": 1606,
    "vorder": 37,
    "position": 0,
    "text": "بپیچاند آن را که بیشی کند"
  },
  {
    "poem_id": 1606,
    "vorder": 38,
    "position": 1,
    "text": "وگر چند بیشی ز پیشی کند"
  },
  {
    "poem_id": 1606,
    "vorder": 39,
    "position": 0,
    "text": "ببخشاید آن را که دارد خرد"
  },
  {
    "poem_id": 1606,
    "vorder": 40,
    "position": 1,
    "text": "ز اندازهٔ روز برنگذرد"
  },
  {
    "poem_id": 1606,
    "vorder": 41,
    "position": 0,
    "text": "ازو یادگاری کنم در جهان"
  },
  {
    "poem_id": 1606,
    "vorder": 42,
    "position": 1,
    "text": "که تا هست مردم نگردد نهان"
  },
  {
    "poem_id": 1606,
    "vorder": 43,
    "position": 0,
    "text": "بدین نامهٔ شهریاران پیش"
  },
  {
    "poem_id": 1606,
    "vorder": 44,
    "position": 1,
    "text": "بزرگان و جنگی سواران پیش"
  },
  {
    "poem_id": 1606,
    "vorder": 45,
    "position": 0,
    "text": "همه رزم و بزمست و رای و سخن"
  },
  {
    "poem_id": 1606,
    "vorder": 46,
    "position": 1,
    "text": "گذشته بسی روزگار کهن"
  },
  {
    "poem_id": 1606,
    "vorder": 47,
    "position": 0,
    "text": "همان دانش و دین و پرهیز و رای"
  },
  {
    "poem_id": 1606,
    "vorder": 48,
    "position": 1,
    "text": "همان رهنمونی به دیگر سرای"
  },
  {
    "poem_id": 1606,
    "vorder": 49,
    "position": 0,
    "text": "ز چیزی کزیشان پسند آیدش"
  },
  {
    "poem_id": 1606,
    "vorder": 50,
    "position": 1,
    "text": "همین روز را سودمند آیدش"
  },
  {
    "poem_id": 1606,
    "vorder": 51,
    "position": 0,
    "text": "کزان برتران یادگارش بود"
  },
  {
    "poem_id": 1606,
    "vorder": 52,
    "position": 1,
    "text": "همان مونس روزگارش بود"
  },
  {
    "poem_id": 1606,
    "vorder": 53,
    "position": 0,
    "text": "همی چشم دارم بدین روزگار"
  },
  {
    "poem_id": 1606,
    "vorder": 54,
    "position": 1,
    "text": "که دینار یابم من از شهریار"
  },
  {
    "poem_id": 1606,
    "vorder": 55,
    "position": 0,
    "text": "دگر چشم دارم به دیگر سرای"
  },
  {
    "poem_id": 1606,
    "vorder": 56,
    "position": 1,
    "text": "که آمرزش آید مرا از خدای"
  },
  {
    "poem_id": 1606,
    "vorder": 57,
    "position": 0,
    "text": "که از من پس از مرگ ماند نشان"
  },
  {
    "poem_id": 1606,
    "vorder": 58,
    "position": 1,
    "text": "ز گنج شهنشاه گردنکشان"
  },
  {
    "poem_id": 1606,
    "vorder": 59,
    "position": 0,
    "text": "کنون بازگردم به گفتار سرو"
  },
  {
    "poem_id": 1606,
    "vorder": 60,
    "position": 1,
    "text": "فروزندهٔ سهل ماهان به مرو"
  }
]