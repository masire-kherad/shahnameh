[
  {
    "poem_id": 1588,
    "vorder": 1,
    "position": 0,
    "text": "نشست از بر رخش چون پیل مست"
  },
  {
    "poem_id": 1588,
    "vorder": 2,
    "position": 1,
    "text": "یکی گُرزهٔ گاو پیکر به دست"
  },
  {
    "poem_id": 1588,
    "vorder": 3,
    "position": 0,
    "text": "بیامد دمان تا به نزدیک آب"
  },
  {
    "poem_id": 1588,
    "vorder": 4,
    "position": 1,
    "text": "سپه را به دیدار او بد شتاب"
  },
  {
    "poem_id": 1588,
    "vorder": 5,
    "position": 0,
    "text": "هرانکس که از لشکر او را بدید"
  },
  {
    "poem_id": 1588,
    "vorder": 6,
    "position": 1,
    "text": "دلش مهر و پیوند او برگزید"
  },
  {
    "poem_id": 1588,
    "vorder": 7,
    "position": 0,
    "text": "همی گفت هرکس که این نامدار"
  },
  {
    "poem_id": 1588,
    "vorder": 8,
    "position": 1,
    "text": "نماند به کس جز به سام سوار"
  },
  {
    "poem_id": 1588,
    "vorder": 9,
    "position": 0,
    "text": "برین کوههٔ زین که آهنست"
  },
  {
    "poem_id": 1588,
    "vorder": 10,
    "position": 1,
    "text": "همان رخش گویی که آهرمنست"
  },
  {
    "poem_id": 1588,
    "vorder": 11,
    "position": 0,
    "text": "اگر هم نبردش بود ژنده پیل"
  },
  {
    "poem_id": 1588,
    "vorder": 12,
    "position": 1,
    "text": "برافشاند از تارک پیل نیل"
  },
  {
    "poem_id": 1588,
    "vorder": 13,
    "position": 0,
    "text": "کسی مرد ازین سان به گیتی ندید"
  },
  {
    "poem_id": 1588,
    "vorder": 14,
    "position": 1,
    "text": "نه از نامداران پیشین شنید"
  },
  {
    "poem_id": 1588,
    "vorder": 15,
    "position": 0,
    "text": "خرد نیست اندر سر شهریار"
  },
  {
    "poem_id": 1588,
    "vorder": 16,
    "position": 1,
    "text": "که جوید ازین نامور کارزار"
  },
  {
    "poem_id": 1588,
    "vorder": 17,
    "position": 0,
    "text": "برین سان همی از پی تاج و گاه"
  },
  {
    "poem_id": 1588,
    "vorder": 18,
    "position": 1,
    "text": "به کشتن دهد نامداری چو ماه"
  },
  {
    "poem_id": 1588,
    "vorder": 19,
    "position": 0,
    "text": "به پیری سوی گنج یازان ترست"
  },
  {
    "poem_id": 1588,
    "vorder": 20,
    "position": 1,
    "text": "به مهر و به دیهیم نازان ترست"
  },
  {
    "poem_id": 1588,
    "vorder": 21,
    "position": 0,
    "text": "همی آمد از دور رستم چو شیر"
  },
  {
    "poem_id": 1588,
    "vorder": 22,
    "position": 1,
    "text": "به زیر اندرون اژدهای دلیر"
  },
  {
    "poem_id": 1588,
    "vorder": 23,
    "position": 0,
    "text": "چو آمد به نزدیک اسفندیار"
  },
  {
    "poem_id": 1588,
    "vorder": 24,
    "position": 1,
    "text": "هم‌انگه پذیره شدش نامدار"
  },
  {
    "poem_id": 1588,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت رستم که ای پهلوان"
  },
  {
    "poem_id": 1588,
    "vorder": 26,
    "position": 1,
    "text": "نوآیین و نوساز و فرخ جوان"
  },
  {
    "poem_id": 1588,
    "vorder": 27,
    "position": 0,
    "text": "خرامی نیرزید مهمان تو"
  },
  {
    "poem_id": 1588,
    "vorder": 28,
    "position": 1,
    "text": "چنین بود تا بود پیمان تو"
  },
  {
    "poem_id": 1588,
    "vorder": 29,
    "position": 0,
    "text": "سخن هرچ گویم همه یاد گیر"
  },
  {
    "poem_id": 1588,
    "vorder": 30,
    "position": 1,
    "text": "مشو تیز با پیر بر خیره خیر"
  },
  {
    "poem_id": 1588,
    "vorder": 31,
    "position": 0,
    "text": "همی خویشتن را بزرگ آیدت"
  },
  {
    "poem_id": 1588,
    "vorder": 32,
    "position": 1,
    "text": "وزین نامداران سترگ آیدت"
  },
  {
    "poem_id": 1588,
    "vorder": 33,
    "position": 0,
    "text": "همانا به مردی سبک داریم"
  },
  {
    "poem_id": 1588,
    "vorder": 34,
    "position": 1,
    "text": "به رای و به دانش تنک داریم"
  },
  {
    "poem_id": 1588,
    "vorder": 35,
    "position": 0,
    "text": "به گیتی چنان دان که رستم منم"
  },
  {
    "poem_id": 1588,
    "vorder": 36,
    "position": 1,
    "text": "فروزندهٔ تخم نیرم منم"
  },
  {
    "poem_id": 1588,
    "vorder": 37,
    "position": 0,
    "text": "بخاید ز من چنگ دیو سپید"
  },
  {
    "poem_id": 1588,
    "vorder": 38,
    "position": 1,
    "text": "بسی جادوان را کنم ناامید"
  },
  {
    "poem_id": 1588,
    "vorder": 39,
    "position": 0,
    "text": "بزرگان که دیدند ببر مرا"
  },
  {
    "poem_id": 1588,
    "vorder": 40,
    "position": 1,
    "text": "همان رخش غران هژبر مرا"
  },
  {
    "poem_id": 1588,
    "vorder": 41,
    "position": 0,
    "text": "چو کاموس جنگی چو خاقان چین"
  },
  {
    "poem_id": 1588,
    "vorder": 42,
    "position": 1,
    "text": "سواران جنگی و مردان کین"
  },
  {
    "poem_id": 1588,
    "vorder": 43,
    "position": 0,
    "text": "که از پشت زینشان به خم کمند"
  },
  {
    "poem_id": 1588,
    "vorder": 44,
    "position": 1,
    "text": "ربودم سر و پای کردم به بند"
  },
  {
    "poem_id": 1588,
    "vorder": 45,
    "position": 0,
    "text": "نگهدار ایران و توران منم"
  },
  {
    "poem_id": 1588,
    "vorder": 46,
    "position": 1,
    "text": "به هر جای پشت دلیران منم"
  },
  {
    "poem_id": 1588,
    "vorder": 47,
    "position": 0,
    "text": "ازین خواهش من مشو بدگمان"
  },
  {
    "poem_id": 1588,
    "vorder": 48,
    "position": 1,
    "text": "مدان خویشتن برتر از آسمان"
  },
  {
    "poem_id": 1588,
    "vorder": 49,
    "position": 0,
    "text": "من از بهر این فر و اورند تو"
  },
  {
    "poem_id": 1588,
    "vorder": 50,
    "position": 1,
    "text": "بجویم همی رای و پیوند تو"
  },
  {
    "poem_id": 1588,
    "vorder": 51,
    "position": 0,
    "text": "نخواهم که چون تو یکی شهریار"
  },
  {
    "poem_id": 1588,
    "vorder": 52,
    "position": 1,
    "text": "تبه دارد از چنگ من روزگار"
  },
  {
    "poem_id": 1588,
    "vorder": 53,
    "position": 0,
    "text": "که من سام یل را بخوانم دلیر"
  },
  {
    "poem_id": 1588,
    "vorder": 54,
    "position": 1,
    "text": "کزو بیشه بگذاشتی نره شیر"
  },
  {
    "poem_id": 1588,
    "vorder": 55,
    "position": 0,
    "text": "به گیتی منم زو کنون یادگار"
  },
  {
    "poem_id": 1588,
    "vorder": 56,
    "position": 1,
    "text": "دگر شاهزاده یل اسفندیار"
  },
  {
    "poem_id": 1588,
    "vorder": 57,
    "position": 0,
    "text": "بسی پهلوان جهان بوده‌ام"
  },
  {
    "poem_id": 1588,
    "vorder": 58,
    "position": 1,
    "text": "سخنها ز هر گونه بشنوده‌ام"
  },
  {
    "poem_id": 1588,
    "vorder": 59,
    "position": 0,
    "text": "سپاسم ز یزدان که بگذشت سال"
  },
  {
    "poem_id": 1588,
    "vorder": 60,
    "position": 1,
    "text": "بدیدم یکی شاه فرخ همال"
  },
  {
    "poem_id": 1588,
    "vorder": 61,
    "position": 0,
    "text": "که کین خواهد از مرد ناپاک دین"
  },
  {
    "poem_id": 1588,
    "vorder": 62,
    "position": 1,
    "text": "جهانی برو بر کنند آفرین"
  },
  {
    "poem_id": 1588,
    "vorder": 63,
    "position": 0,
    "text": "توی نامور پرهنر شهریار"
  },
  {
    "poem_id": 1588,
    "vorder": 64,
    "position": 1,
    "text": "به جنگ اندرون افسر کارزار"
  },
  {
    "poem_id": 1588,
    "vorder": 65,
    "position": 0,
    "text": "بخندید از رستم اسفندیار"
  },
  {
    "poem_id": 1588,
    "vorder": 66,
    "position": 1,
    "text": "بدو گفت کای پور سام سوار"
  },
  {
    "poem_id": 1588,
    "vorder": 67,
    "position": 0,
    "text": "شدی تنگدل چون نیامد خرام"
  },
  {
    "poem_id": 1588,
    "vorder": 68,
    "position": 1,
    "text": "نجستم همی زین سخن کام و نام"
  },
  {
    "poem_id": 1588,
    "vorder": 69,
    "position": 0,
    "text": "چنین گرم بد روز و راه دراز"
  },
  {
    "poem_id": 1588,
    "vorder": 70,
    "position": 1,
    "text": "نکردم ترا رنجه تندی مساز"
  },
  {
    "poem_id": 1588,
    "vorder": 71,
    "position": 0,
    "text": "همی گفتم از بامداد پگاه"
  },
  {
    "poem_id": 1588,
    "vorder": 72,
    "position": 1,
    "text": "به پوزش بسازم سوی داد راه"
  },
  {
    "poem_id": 1588,
    "vorder": 73,
    "position": 0,
    "text": "به دیدار دستان شوم شادمان"
  },
  {
    "poem_id": 1588,
    "vorder": 74,
    "position": 1,
    "text": "به تو شاد دارم روان یک زمان"
  },
  {
    "poem_id": 1588,
    "vorder": 75,
    "position": 0,
    "text": "کنون تو بدین رنج برداشتی"
  },
  {
    "poem_id": 1588,
    "vorder": 76,
    "position": 1,
    "text": "به دشت آمدی خانه بگذاشتی"
  },
  {
    "poem_id": 1588,
    "vorder": 77,
    "position": 0,
    "text": "به آرام بنشین و بردار جام"
  },
  {
    "poem_id": 1588,
    "vorder": 78,
    "position": 1,
    "text": "ز تندی و تیزی مبر هیچ نام"
  },
  {
    "poem_id": 1588,
    "vorder": 79,
    "position": 0,
    "text": "به دست چپ خویش بر جای کرد"
  },
  {
    "poem_id": 1588,
    "vorder": 80,
    "position": 1,
    "text": "ز رستم همی مجلس آرای کرد"
  },
  {
    "poem_id": 1588,
    "vorder": 81,
    "position": 0,
    "text": "جهاندیده گفت این نه جای منست"
  },
  {
    "poem_id": 1588,
    "vorder": 82,
    "position": 1,
    "text": "بجایی نشینم که رای منست"
  },
  {
    "poem_id": 1588,
    "vorder": 83,
    "position": 0,
    "text": "تهمتن بفرمود کز دست راست"
  },
  {
    "poem_id": 1588,
    "vorder": 84,
    "position": 1,
    "text": "نشستی بیارای ازان کم سزاست"
  },
  {
    "poem_id": 1588,
    "vorder": 85,
    "position": 0,
    "text": "چنین گفت با شاهزاده به خشم"
  },
  {
    "poem_id": 1588,
    "vorder": 86,
    "position": 1,
    "text": "که آیین من بین و بگشای چشم"
  },
  {
    "poem_id": 1588,
    "vorder": 87,
    "position": 0,
    "text": "هنر بین و این نامور گوهرم"
  },
  {
    "poem_id": 1588,
    "vorder": 88,
    "position": 1,
    "text": "که از تخمهٔ سام کنداورم"
  },
  {
    "poem_id": 1588,
    "vorder": 89,
    "position": 0,
    "text": "هنر باید از مرد و فر و نژاد"
  },
  {
    "poem_id": 1588,
    "vorder": 90,
    "position": 1,
    "text": "کفی راد دارد دلی پر ز داد"
  },
  {
    "poem_id": 1588,
    "vorder": 91,
    "position": 0,
    "text": "سزاوار من گر ترا نیست جای"
  },
  {
    "poem_id": 1588,
    "vorder": 92,
    "position": 1,
    "text": "مرا هست پیروزی و هوش و رای"
  },
  {
    "poem_id": 1588,
    "vorder": 93,
    "position": 0,
    "text": "ازان پس بفرمود فرزند شاه"
  },
  {
    "poem_id": 1588,
    "vorder": 94,
    "position": 1,
    "text": "که کرسی زرین نهد پیش گاه"
  },
  {
    "poem_id": 1588,
    "vorder": 95,
    "position": 0,
    "text": "بدان تا گو نامور پهلوان"
  },
  {
    "poem_id": 1588,
    "vorder": 96,
    "position": 1,
    "text": "نشیند بر شهریار جوان"
  },
  {
    "poem_id": 1588,
    "vorder": 97,
    "position": 0,
    "text": "بیامد بران کرسی زر نشست"
  },
  {
    "poem_id": 1588,
    "vorder": 98,
    "position": 1,
    "text": "پر از خشم بویا ترنجی بدست"
  }
]