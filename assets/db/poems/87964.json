[
  {
    "poem_id": 87964,
    "vorder": 1,
    "position": 0,
    "text": "تخوار سراینده گفت آن زمان"
  },
  {
    "poem_id": 87964,
    "vorder": 2,
    "position": 1,
    "text": "که آمد بر کوه کوهی دمان"
  },
  {
    "poem_id": 87964,
    "vorder": 3,
    "position": 0,
    "text": "سپهدار طوسست کامد بجنگ"
  },
  {
    "poem_id": 87964,
    "vorder": 4,
    "position": 1,
    "text": "نتابی تو با کار دیده نهنگ"
  },
  {
    "poem_id": 87964,
    "vorder": 5,
    "position": 0,
    "text": "برو تا در دژ ببندیم سخت"
  },
  {
    "poem_id": 87964,
    "vorder": 6,
    "position": 1,
    "text": "ببینیم تا چیست فرجام بخت"
  },
  {
    "poem_id": 87964,
    "vorder": 7,
    "position": 0,
    "text": "چو فرزند و داماد او را برزم"
  },
  {
    "poem_id": 87964,
    "vorder": 8,
    "position": 1,
    "text": "تبه کردی اکنون میندیش بزم"
  },
  {
    "poem_id": 87964,
    "vorder": 9,
    "position": 0,
    "text": "فرود جوان تیز شد با تخوار"
  },
  {
    "poem_id": 87964,
    "vorder": 10,
    "position": 1,
    "text": "که چون رزم پیش آید و کارزار"
  },
  {
    "poem_id": 87964,
    "vorder": 11,
    "position": 0,
    "text": "چه طوس و چه شیر و چه پیل ژیان"
  },
  {
    "poem_id": 87964,
    "vorder": 12,
    "position": 1,
    "text": "چه جنگی نهنگ و چه ببر بیان"
  },
  {
    "poem_id": 87964,
    "vorder": 13,
    "position": 0,
    "text": "بجنگ اندرون مرد را دل دهند"
  },
  {
    "poem_id": 87964,
    "vorder": 14,
    "position": 1,
    "text": "نه بر آتش تیز بر گل نهند"
  },
  {
    "poem_id": 87964,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت با شاهزاده تخوار"
  },
  {
    "poem_id": 87964,
    "vorder": 16,
    "position": 1,
    "text": "که شاهان سخن را ندارند خوار"
  },
  {
    "poem_id": 87964,
    "vorder": 17,
    "position": 0,
    "text": "تو هم یک سواری اگر ز آهنی"
  },
  {
    "poem_id": 87964,
    "vorder": 18,
    "position": 1,
    "text": "همی کوه خارا ز بن برکنی"
  },
  {
    "poem_id": 87964,
    "vorder": 19,
    "position": 0,
    "text": "از ایرانیان نامور سی هزار"
  },
  {
    "poem_id": 87964,
    "vorder": 20,
    "position": 1,
    "text": "برزم تو آیند بر کوهسار"
  },
  {
    "poem_id": 87964,
    "vorder": 21,
    "position": 0,
    "text": "نه دژ ماند اینجا نه سنگ و نه خاک"
  },
  {
    "poem_id": 87964,
    "vorder": 22,
    "position": 1,
    "text": "سراسر ز جا اندر آرند پاک"
  },
  {
    "poem_id": 87964,
    "vorder": 23,
    "position": 0,
    "text": "وگر طوس را زین گزندی رسد"
  },
  {
    "poem_id": 87964,
    "vorder": 24,
    "position": 1,
    "text": "به خسرو ز دردش نژندی رسد"
  },
  {
    "poem_id": 87964,
    "vorder": 25,
    "position": 0,
    "text": "بکین پدرت اندر آید شکست"
  },
  {
    "poem_id": 87964,
    "vorder": 26,
    "position": 1,
    "text": "شکستی که هرگز نشایدش بست"
  },
  {
    "poem_id": 87964,
    "vorder": 27,
    "position": 0,
    "text": "بگردان عنان و مینداز تیر"
  },
  {
    "poem_id": 87964,
    "vorder": 28,
    "position": 1,
    "text": "بدژ شو مبر رنج بر خیره‌خیر"
  },
  {
    "poem_id": 87964,
    "vorder": 29,
    "position": 0,
    "text": "سخن هرچ از پیش بایست گفت"
  },
  {
    "poem_id": 87964,
    "vorder": 30,
    "position": 1,
    "text": "نگفت و همی داشت اندر نهفت"
  },
  {
    "poem_id": 87964,
    "vorder": 31,
    "position": 0,
    "text": "ز بی‌مایه دستور ناکاردان"
  },
  {
    "poem_id": 87964,
    "vorder": 32,
    "position": 1,
    "text": "ورا جنگ سود آمد و جان زیان"
  }
]