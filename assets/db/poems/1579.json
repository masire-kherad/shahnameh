[
  {
    "poem_id": 1579,
    "vorder": 1,
    "position": 0,
    "text": "کتایون چو بشنید شد پر ز خشم"
  },
  {
    "poem_id": 1579,
    "vorder": 2,
    "position": 1,
    "text": "به پیش پسر شد پر از آب چشم"
  },
  {
    "poem_id": 1579,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت با فرخ اسفندیار"
  },
  {
    "poem_id": 1579,
    "vorder": 4,
    "position": 1,
    "text": "که ای از کیان جهان یادگار"
  },
  {
    "poem_id": 1579,
    "vorder": 5,
    "position": 0,
    "text": "ز بهمن شنیدم که از گلستان"
  },
  {
    "poem_id": 1579,
    "vorder": 6,
    "position": 1,
    "text": "همی رفت خواهی به زابلستان"
  },
  {
    "poem_id": 1579,
    "vorder": 7,
    "position": 0,
    "text": "ببندی همی رستم زال را"
  },
  {
    "poem_id": 1579,
    "vorder": 8,
    "position": 1,
    "text": "خداوند شمشیر و گوپال را"
  },
  {
    "poem_id": 1579,
    "vorder": 9,
    "position": 0,
    "text": "ز گیتی همی پند مادر نیوش"
  },
  {
    "poem_id": 1579,
    "vorder": 10,
    "position": 1,
    "text": "به بد تیز مشتاب و چندین مکوش"
  },
  {
    "poem_id": 1579,
    "vorder": 11,
    "position": 0,
    "text": "سواری که باشد به نیروی پیل"
  },
  {
    "poem_id": 1579,
    "vorder": 12,
    "position": 1,
    "text": "ز خون راند اندر زمین جوی نیل"
  },
  {
    "poem_id": 1579,
    "vorder": 13,
    "position": 0,
    "text": "بدرد جگرگاه دیو سپید"
  },
  {
    "poem_id": 1579,
    "vorder": 14,
    "position": 1,
    "text": "ز شمشیر او گم کند راه شید"
  },
  {
    "poem_id": 1579,
    "vorder": 15,
    "position": 0,
    "text": "همان ماه هاماوران را بکشت"
  },
  {
    "poem_id": 1579,
    "vorder": 16,
    "position": 1,
    "text": "نیارست گفتن کس او را درشت"
  },
  {
    "poem_id": 1579,
    "vorder": 17,
    "position": 0,
    "text": "همانا چو سهراب دیگر سوار"
  },
  {
    "poem_id": 1579,
    "vorder": 18,
    "position": 1,
    "text": "نبودست جنگی گه کارزار"
  },
  {
    "poem_id": 1579,
    "vorder": 19,
    "position": 0,
    "text": "به چنگ پدر در به هنگام جنگ"
  },
  {
    "poem_id": 1579,
    "vorder": 20,
    "position": 1,
    "text": "به آوردگه کشته شد بی‌درنگ"
  },
  {
    "poem_id": 1579,
    "vorder": 21,
    "position": 0,
    "text": "به کین سیاوش ز افراسیاب"
  },
  {
    "poem_id": 1579,
    "vorder": 22,
    "position": 1,
    "text": "ز خون کرد گیتی چو دریای آب"
  },
  {
    "poem_id": 1579,
    "vorder": 23,
    "position": 0,
    "text": "که نفرین بر این تخت و این تاج باد"
  },
  {
    "poem_id": 1579,
    "vorder": 24,
    "position": 1,
    "text": "بر این کشتن و شور و تاراج باد"
  },
  {
    "poem_id": 1579,
    "vorder": 25,
    "position": 0,
    "text": "مده از پی تاج سر را به باد"
  },
  {
    "poem_id": 1579,
    "vorder": 26,
    "position": 1,
    "text": "که با تاج شاهی ز مادر نزاد"
  },
  {
    "poem_id": 1579,
    "vorder": 27,
    "position": 0,
    "text": "پدر پیر سر گشت و برنا توی"
  },
  {
    "poem_id": 1579,
    "vorder": 28,
    "position": 1,
    "text": "به زور و به مردی توانا توی"
  },
  {
    "poem_id": 1579,
    "vorder": 29,
    "position": 0,
    "text": "سپه یکسره بر تو دارند چشم"
  },
  {
    "poem_id": 1579,
    "vorder": 30,
    "position": 1,
    "text": "میفگن تن اندر بلایی به خشم"
  },
  {
    "poem_id": 1579,
    "vorder": 31,
    "position": 0,
    "text": "جز از سیستان در جهان جای هست"
  },
  {
    "poem_id": 1579,
    "vorder": 32,
    "position": 1,
    "text": "دلیری مکن تیز منمای دست"
  },
  {
    "poem_id": 1579,
    "vorder": 33,
    "position": 0,
    "text": "مرا خاکسار دو گیتی مکن"
  },
  {
    "poem_id": 1579,
    "vorder": 34,
    "position": 1,
    "text": "ازین مهربان مام بشنو سخن"
  },
  {
    "poem_id": 1579,
    "vorder": 35,
    "position": 0,
    "text": "چنین پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1579,
    "vorder": 36,
    "position": 1,
    "text": "که ای مهربان این سخن یاددار"
  },
  {
    "poem_id": 1579,
    "vorder": 37,
    "position": 0,
    "text": "همانست رستم که دانی همی"
  },
  {
    "poem_id": 1579,
    "vorder": 38,
    "position": 1,
    "text": "هنرهاش چون زند خوانی همی"
  },
  {
    "poem_id": 1579,
    "vorder": 39,
    "position": 0,
    "text": "نکوکارتر زو به ایران کسی"
  },
  {
    "poem_id": 1579,
    "vorder": 40,
    "position": 1,
    "text": "نیابی و گر چند پویی بسی"
  },
  {
    "poem_id": 1579,
    "vorder": 41,
    "position": 0,
    "text": "چو او را به بستن نباشد روا"
  },
  {
    "poem_id": 1579,
    "vorder": 42,
    "position": 1,
    "text": "چنین بد نه خوب آید از پادشا"
  },
  {
    "poem_id": 1579,
    "vorder": 43,
    "position": 0,
    "text": "ولیکن نباید شکستن دلم"
  },
  {
    "poem_id": 1579,
    "vorder": 44,
    "position": 1,
    "text": "که چون بشکنی دل ز جان بگسلم"
  },
  {
    "poem_id": 1579,
    "vorder": 45,
    "position": 0,
    "text": "چگونه کشم سر ز فرمان شاه"
  },
  {
    "poem_id": 1579,
    "vorder": 46,
    "position": 1,
    "text": "چگونه گذارم چنین دستگاه"
  },
  {
    "poem_id": 1579,
    "vorder": 47,
    "position": 0,
    "text": "مرا گر به زاول سرآید زمان"
  },
  {
    "poem_id": 1579,
    "vorder": 48,
    "position": 1,
    "text": "بدان سو کشد اخترم بی‌گمان"
  },
  {
    "poem_id": 1579,
    "vorder": 49,
    "position": 0,
    "text": "چو رستم بیاید به فرمان من"
  },
  {
    "poem_id": 1579,
    "vorder": 50,
    "position": 1,
    "text": "ز من نشنود سرد هرگز سخن"
  },
  {
    "poem_id": 1579,
    "vorder": 51,
    "position": 0,
    "text": "ببارید خون از مژه مادرش"
  },
  {
    "poem_id": 1579,
    "vorder": 52,
    "position": 1,
    "text": "همه پاک بر کند موی از سرش"
  },
  {
    "poem_id": 1579,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت کای ژنده پیل ژیان"
  },
  {
    "poem_id": 1579,
    "vorder": 54,
    "position": 1,
    "text": "همی خوار گیری ز نیرو روان"
  },
  {
    "poem_id": 1579,
    "vorder": 55,
    "position": 0,
    "text": "نباشی بسنده تو با پیلتن"
  },
  {
    "poem_id": 1579,
    "vorder": 56,
    "position": 1,
    "text": "از ایدر مرو بی یکی انجمن"
  },
  {
    "poem_id": 1579,
    "vorder": 57,
    "position": 0,
    "text": "مبر پیش پیل ژیان هوش خویش"
  },
  {
    "poem_id": 1579,
    "vorder": 58,
    "position": 1,
    "text": "نهاده بدین گونه بر دوش خویش"
  },
  {
    "poem_id": 1579,
    "vorder": 59,
    "position": 0,
    "text": "اگر زین نشان رای تو رفتنست"
  },
  {
    "poem_id": 1579,
    "vorder": 60,
    "position": 1,
    "text": "همه کام بدگوهر آهرمنست"
  },
  {
    "poem_id": 1579,
    "vorder": 61,
    "position": 0,
    "text": "به دوزخ مبر کودکان را به پای"
  },
  {
    "poem_id": 1579,
    "vorder": 62,
    "position": 1,
    "text": "که دانا بخواند ترا پاک رای"
  },
  {
    "poem_id": 1579,
    "vorder": 63,
    "position": 0,
    "text": "به مادر چنین گفت پس جنگجوی"
  },
  {
    "poem_id": 1579,
    "vorder": 64,
    "position": 1,
    "text": "که نابردن کودکان نیست روی"
  },
  {
    "poem_id": 1579,
    "vorder": 65,
    "position": 0,
    "text": "چو با زن پس پرده باشد جوان"
  },
  {
    "poem_id": 1579,
    "vorder": 66,
    "position": 1,
    "text": "بماند منش پست و تیره‌روان"
  },
  {
    "poem_id": 1579,
    "vorder": 67,
    "position": 0,
    "text": "به هر رزمگه باید او را نگاه"
  },
  {
    "poem_id": 1579,
    "vorder": 68,
    "position": 1,
    "text": "گذارد بهر زخم گوپال شاه"
  },
  {
    "poem_id": 1579,
    "vorder": 69,
    "position": 0,
    "text": "مرا لشکری خود نیاید به کار"
  },
  {
    "poem_id": 1579,
    "vorder": 70,
    "position": 1,
    "text": "جز از خویش و پیوند و چندی سوار"
  },
  {
    "poem_id": 1579,
    "vorder": 71,
    "position": 0,
    "text": "ز پیش پسر مادر مهربان"
  },
  {
    "poem_id": 1579,
    "vorder": 72,
    "position": 1,
    "text": "بیامد پر از درد و تیره‌روان"
  },
  {
    "poem_id": 1579,
    "vorder": 73,
    "position": 0,
    "text": "همه شب ز مهر پسر مادرش"
  },
  {
    "poem_id": 1579,
    "vorder": 74,
    "position": 1,
    "text": "ز دیده همی ریخت خون بر برش"
  }
]