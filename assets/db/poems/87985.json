  {
    "poem_id": 87985,
    "vorder": 138,
    "position": 1,
    "text": "خور و خواب و آرام بر کوه و سنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 139,
    "position": 0,
    "text": "چو فردا برآید ز کوه آفتاب"
