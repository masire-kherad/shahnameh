[
  {
    "poem_id": 87985,
    "vorder": 1,
    "position": 0,
    "text": "سپه برنشاند و بنه برنهاد"
  },
  {
    "poem_id": 87985,
    "vorder": 2,
    "position": 1,
    "text": "وزان کشتنگان کرد بسیار یاد"
  },
  {
    "poem_id": 87985,
    "vorder": 3,
    "position": 0,
    "text": "ازین سان همی رفت روز و شبان"
  },
  {
    "poem_id": 87985,
    "vorder": 4,
    "position": 1,
    "text": "پر از غم دل و ناچریده لبان"
  },
  {
    "poem_id": 87985,
    "vorder": 5,
    "position": 0,
    "text": "همه دیده پر خون و دل پر ز داغ"
  },
  {
    "poem_id": 87985,
    "vorder": 6,
    "position": 1,
    "text": "ز رنج روان گشته چون پر زاغ"
  },
  {
    "poem_id": 87985,
    "vorder": 7,
    "position": 0,
    "text": "چو نزدیک کوه هماون رسید"
  },
  {
    "poem_id": 87985,
    "vorder": 8,
    "position": 1,
    "text": "بران دامن کوه لشکر کشید"
  },
  {
    "poem_id": 87985,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت طوس سپهبد بگیو"
  },
  {
    "poem_id": 87985,
    "vorder": 10,
    "position": 1,
    "text": "که ای پر خرد نامبردار نیو"
  },
  {
    "poem_id": 87985,
    "vorder": 11,
    "position": 0,
    "text": "سه روزست تا زین نشان تاختی"
  },
  {
    "poem_id": 87985,
    "vorder": 12,
    "position": 1,
    "text": "بخواب و بخوردن نپرداختی"
  },
  {
    "poem_id": 87985,
    "vorder": 13,
    "position": 0,
    "text": "بیا و بیاسا و چیزی بخور"
  },
  {
    "poem_id": 87985,
    "vorder": 14,
    "position": 1,
    "text": "برامش و جامه بنمای سر"
  },
  {
    "poem_id": 87985,
    "vorder": 15,
    "position": 0,
    "text": "که من بی‌گمانم که پیران بجنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 16,
    "position": 1,
    "text": "پس ما بیاید کنون بی‌درنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 17,
    "position": 0,
    "text": "کسی را که آسوده‌تر زین گروه"
  },
  {
    "poem_id": 87985,
    "vorder": 18,
    "position": 1,
    "text": "به بیژن بمان و تو برشو بکوه"
  },
  {
    "poem_id": 87985,
    "vorder": 19,
    "position": 0,
    "text": "همه خستگان را سوی که کشید"
  },
  {
    "poem_id": 87985,
    "vorder": 20,
    "position": 1,
    "text": "ز آسودگان لشکری برگزید"
  },
  {
    "poem_id": 87985,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت کین کوه سر جای ماست"
  },
  {
    "poem_id": 87985,
    "vorder": 22,
    "position": 1,
    "text": "بباید کنون خویشتن کرد راست"
  },
  {
    "poem_id": 87985,
    "vorder": 23,
    "position": 0,
    "text": "طلایه ز کوه اندر آمد بدشت"
  },
  {
    "poem_id": 87985,
    "vorder": 24,
    "position": 1,
    "text": "بدان تا بریشان نشاید گذشت"
  },
  {
    "poem_id": 87985,
    "vorder": 25,
    "position": 0,
    "text": "خروش نگهبان و آوای زنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 26,
    "position": 1,
    "text": "تو گفتی بجوش آمد از کوه سنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 27,
    "position": 0,
    "text": "هم‌آنگه برآمد ز چرخ آفتاب"
  },
  {
    "poem_id": 87985,
    "vorder": 28,
    "position": 1,
    "text": "جهان گشت برسان دریای آب"
  },
  {
    "poem_id": 87985,
    "vorder": 29,
    "position": 0,
    "text": "ز درگاه پیران برآمد خروش"
  },
  {
    "poem_id": 87985,
    "vorder": 30,
    "position": 1,
    "text": "چنان شد که برخیزد از خاک جوش"
  },
  {
    "poem_id": 87985,
    "vorder": 31,
    "position": 0,
    "text": "بهومان چنین گفت کاکنون بجنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 32,
    "position": 1,
    "text": "نباید همانا فراوان درنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 33,
    "position": 0,
    "text": "سواران دشمن همه کشته‌اند"
  },
  {
    "poem_id": 87985,
    "vorder": 34,
    "position": 1,
    "text": "وگر خسته از جنگ برگشته‌اند"
  },
  {
    "poem_id": 87985,
    "vorder": 35,
    "position": 0,
    "text": "بزد کوس و از دشت برخاست غو"
  },
  {
    "poem_id": 87985,
    "vorder": 36,
    "position": 1,
    "text": "همی رفت پیش سپه پیشرو"
  },
  {
    "poem_id": 87985,
    "vorder": 37,
    "position": 0,
    "text": "رسیدند ترکان بدان رزمگاه"
  },
  {
    "poem_id": 87985,
    "vorder": 38,
    "position": 1,
    "text": "همه رزمگه خیمه بد بی‌سپاه"
  },
  {
    "poem_id": 87985,
    "vorder": 39,
    "position": 0,
    "text": "بشد نزد پیران یکی مژده‌خواه"
  },
  {
    "poem_id": 87985,
    "vorder": 40,
    "position": 1,
    "text": "که کس نیست ایدر ز ایران سپاه"
  },
  {
    "poem_id": 87985,
    "vorder": 41,
    "position": 0,
    "text": "ز لشکر بشادی برآمد خروش"
  },
  {
    "poem_id": 87985,
    "vorder": 42,
    "position": 1,
    "text": "بفرمان پیران نهادند گوش"
  },
  {
    "poem_id": 87985,
    "vorder": 43,
    "position": 0,
    "text": "سپهبد چنین گفت با بخردان"
  },
  {
    "poem_id": 87985,
    "vorder": 44,
    "position": 1,
    "text": "که ای نامور پرهنر موبدان"
  },
  {
    "poem_id": 87985,
    "vorder": 45,
    "position": 0,
    "text": "چه سازیم و این را چه دانید رای"
  },
  {
    "poem_id": 87985,
    "vorder": 46,
    "position": 1,
    "text": "که اکنون ز دشمن تهی ماند جای"
  },
  {
    "poem_id": 87985,
    "vorder": 47,
    "position": 0,
    "text": "سواران لشکر ز پیر و جوان"
  },
  {
    "poem_id": 87985,
    "vorder": 48,
    "position": 1,
    "text": "همه تیز گفتند با پهلوان"
  },
  {
    "poem_id": 87985,
    "vorder": 49,
    "position": 0,
    "text": "که لشکر گریزان شد از پیش ما"
  },
  {
    "poem_id": 87985,
    "vorder": 50,
    "position": 1,
    "text": "شکست آمد اندر بداندیش ما"
  },
  {
    "poem_id": 87985,
    "vorder": 51,
    "position": 0,
    "text": "یکی رزمگاهست پر خون و خاک"
  },
  {
    "poem_id": 87985,
    "vorder": 52,
    "position": 1,
    "text": "ازیشان نه هنگام بیم است و باک"
  },
  {
    "poem_id": 87985,
    "vorder": 53,
    "position": 0,
    "text": "بباید پی دشمن اندر گرفت"
  },
  {
    "poem_id": 87985,
    "vorder": 54,
    "position": 1,
    "text": "ز مولش سزد گر بمانی شگفت"
  },
  {
    "poem_id": 87985,
    "vorder": 55,
    "position": 0,
    "text": "گریزان ز باد اندرآید بب"
  },
  {
    "poem_id": 87985,
    "vorder": 56,
    "position": 1,
    "text": "به آید ز مولیدن ایدر شتاب"
  },
  {
    "poem_id": 87985,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت پیران که هنگام جنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 58,
    "position": 1,
    "text": "شود سست پای شتاب از درنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 59,
    "position": 0,
    "text": "سپاهی بکردار دریای آب"
  },
  {
    "poem_id": 87985,
    "vorder": 60,
    "position": 1,
    "text": "شدست انجمن پیش افراسیاب"
  },
  {
    "poem_id": 87985,
    "vorder": 61,
    "position": 0,
    "text": "بمانیم تا آن سپاه گران"
  },
  {
    "poem_id": 87985,
    "vorder": 62,
    "position": 1,
    "text": "بیایند گردان و جنگ‌آوران"
  },
  {
    "poem_id": 87985,
    "vorder": 63,
    "position": 0,
    "text": "ازان پس بایران نمانیم کس"
  },
  {
    "poem_id": 87985,
    "vorder": 64,
    "position": 1,
    "text": "چنین است رای خردمند و بس"
  },
  {
    "poem_id": 87985,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت هومان که ای پهلوان"
  },
  {
    "poem_id": 87985,
    "vorder": 66,
    "position": 1,
    "text": "مرنجان بدین کار چندین روان"
  },
  {
    "poem_id": 87985,
    "vorder": 67,
    "position": 0,
    "text": "سپاهی بدان زور و آن جوش و دم"
  },
  {
    "poem_id": 87985,
    "vorder": 68,
    "position": 1,
    "text": "شدی روی دریا ازیشان دژم"
  },
  {
    "poem_id": 87985,
    "vorder": 69,
    "position": 0,
    "text": "کنون خیمه و گاه و پرده‌سرای"
  },
  {
    "poem_id": 87985,
    "vorder": 70,
    "position": 1,
    "text": "همه مانده برجای و رفته ز جای"
  },
  {
    "poem_id": 87985,
    "vorder": 71,
    "position": 0,
    "text": "چنان دان که رفتن ز بیچارگیست"
  },
  {
    "poem_id": 87985,
    "vorder": 72,
    "position": 1,
    "text": "نمودن بما پشت یکبارگیست"
  },
  {
    "poem_id": 87985,
    "vorder": 73,
    "position": 0,
    "text": "نمانیم تا نزد خسرو شوند"
  },
  {
    "poem_id": 87985,
    "vorder": 74,
    "position": 1,
    "text": "بدرگاه او لشکری نو شوند"
  },
  {
    "poem_id": 87985,
    "vorder": 75,
    "position": 0,
    "text": "ز زابلستان رستم آید بجنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 76,
    "position": 1,
    "text": "زیانی بود سهمگین زین درنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 77,
    "position": 0,
    "text": "کنون ساختن باید و تاختن"
  },
  {
    "poem_id": 87985,
    "vorder": 78,
    "position": 1,
    "text": "فسونها و نیرنگها ساختن"
  },
  {
    "poem_id": 87985,
    "vorder": 79,
    "position": 0,
    "text": "چو گودرز را با سپهدار طوس"
  },
  {
    "poem_id": 87985,
    "vorder": 80,
    "position": 1,
    "text": "درفش همایون و پیلان و کوس"
  },
  {
    "poem_id": 87985,
    "vorder": 81,
    "position": 0,
    "text": "همه بی‌گمانی بچنگ آوریم"
  },
  {
    "poem_id": 87985,
    "vorder": 82,
    "position": 1,
    "text": "بد آید چو ایدر درنگ آوریم"
  },
  {
    "poem_id": 87985,
    "vorder": 83,
    "position": 0,
    "text": "چنین داد پاسخ بدو پهلوان"
  },
  {
    "poem_id": 87985,
    "vorder": 84,
    "position": 1,
    "text": "که بیداردل باش و روشن‌روان"
  },
  {
    "poem_id": 87985,
    "vorder": 85,
    "position": 0,
    "text": "چنان کن که نیک‌اختر و رای تست"
  },
  {
    "poem_id": 87985,
    "vorder": 86,
    "position": 1,
    "text": "که چرخ فلک زیر بالای تست"
  },
  {
    "poem_id": 87985,
    "vorder": 87,
    "position": 0,
    "text": "پس لشکر اندر گرفتند راه"
  },
  {
    "poem_id": 87985,
    "vorder": 88,
    "position": 1,
    "text": "سپهدار پیران و توران سپاه"
  },
  {
    "poem_id": 87985,
    "vorder": 89,
    "position": 0,
    "text": "به لهاک فرمود کاکنون مایست"
  },
  {
    "poem_id": 87985,
    "vorder": 90,
    "position": 1,
    "text": "بگردان عنان با سواری دویست"
  },
  {
    "poem_id": 87985,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت مگشای بند از میان"
  },
  {
    "poem_id": 87985,
    "vorder": 92,
    "position": 1,
    "text": "ببین تا کجایند ایرانیان"
  },
  {
    "poem_id": 87985,
    "vorder": 93,
    "position": 0,
    "text": "همی رفت لهاک برسان باد"
  },
  {
    "poem_id": 87985,
    "vorder": 94,
    "position": 1,
    "text": "ز خواب و ز خوردن نکرد ایچ یاد"
  },
  {
    "poem_id": 87985,
    "vorder": 95,
    "position": 0,
    "text": "چو نیمی ز تیره شب اندر گذشت"
  },
  {
    "poem_id": 87985,
    "vorder": 96,
    "position": 1,
    "text": "طلایه بدیدش بتاریک دشت"
  },
  {
    "poem_id": 87985,
    "vorder": 97,
    "position": 0,
    "text": "خروش آمد از کوه و آوای زنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 98,
    "position": 1,
    "text": "ندید ایچ لهاک جای درنگ"
  },
  {
    "poem_id": 87985,
    "vorder": 99,
    "position": 0,
    "text": "بنزدیک پیران بیامد ز راه"
  },
  {
    "poem_id": 87985,
    "vorder": 100,
    "position": 1,
    "text": "بدو آگهی داد ز ایران سپاه"
  },
  {
    "poem_id": 87985,
    "vorder": 101,
    "position": 0,
    "text": "که ایشان بکوه هماون درند"
  },
  {
    "poem_id": 87985,
    "vorder": 102,
    "position": 1,
    "text": "همه بسته بر پیش راه گزند"
  },
  {
    "poem_id": 87985,
    "vorder": 103,
    "position": 0,
    "text": "بهومان بفرمود پیران که زود"
  },
  {
    "poem_id": 87985,
    "vorder": 104,
    "position": 1,
    "text": "عنان و رکیبت بباید بسود"
  },
  {
    "poem_id": 87985,
    "vorder": 105,
    "position": 0,
    "text": "ببر چند باید ز لشکر سوار"
  },
  {
    "poem_id": 87985,
    "vorder": 106,
    "position": 1,
    "text": "ز گردان گردنکش نامدار"
  },
  {
    "poem_id": 87985,
    "vorder": 107,
    "position": 0,
    "text": "که ایرانیان با درفش و سپاه"
  },
  {
    "poem_id": 87985,
    "vorder": 108,
    "position": 1,
    "text": "گرفتند کوه هماون پناه"
  },
  {
    "poem_id": 87985,
    "vorder": 109,
    "position": 0,
    "text": "ازین رزم رنج آید اکنون بروی"
  },
  {
    "poem_id": 87985,
    "vorder": 110,
    "position": 1,
    "text": "خرد تیز کن چارهٔ کار جوی"
  },
  {
    "poem_id": 87985,
    "vorder": 111,
    "position": 0,
    "text": "گر آن مرد با کاویانی درفش"
  },
  {
    "poem_id": 87985,
    "vorder": 112,
    "position": 1,
    "text": "بیاری، شود روی ایشان بنفش"
  },
  {
    "poem_id": 87985,
    "vorder": 113,
    "position": 0,
    "text": "اگر دستیابی بشمشیر تیز"
  },
  {
    "poem_id": 87985,
    "vorder": 114,
    "position": 1,
    "text": "درفش و همه نیزه کن ریزریز"
  },
  {
    "poem_id": 87985,
    "vorder": 115,
    "position": 0,
    "text": "من اینک پس‌اندر چو باد دمان"
  },
  {
    "poem_id": 87985,
    "vorder": 116,
    "position": 1,
    "text": "بیایم نسازم درنگ و زمان"
  },
  {
    "poem_id": 87985,
    "vorder": 117,
    "position": 0,
    "text": "گزین کرد هومان ز لشکر سوار"
  },
  {
    "poem_id": 87985,
    "vorder": 118,
    "position": 1,
    "text": "سپردار و شمشیرزن سی‌هزار"
  },
  {
    "poem_id": 87985,
    "vorder": 119,
    "position": 0,
    "text": "چو خورشید تابنده بنمود تاج"
  },
  {
    "poem_id": 87985,
    "vorder": 120,
    "position": 1,
    "text": "بگسترد کافور بر تخت عاج"
  },
  {
    "poem_id": 87985,
    "vorder": 121,
    "position": 0,
    "text": "پدید آمد از دور گرد سپاه"
  },
  {
    "poem_id": 87985,
    "vorder": 122,
    "position": 1,
    "text": "غو دیده‌بان آمد از دیده‌گاه"
  },
  {
    "poem_id": 87985,
    "vorder": 123,
    "position": 0,
    "text": "که آمد ز ترکان سپاهی پدید"
  },
  {
    "poem_id": 87985,
    "vorder": 124,
    "position": 1,
    "text": "بابر سیه گردشان برکشید"
  },
  {
    "poem_id": 87985,
    "vorder": 125,
    "position": 0,
    "text": "چو بشنید جوشن بپوشید طوس"
  },
  {
    "poem_id": 87985,
    "vorder": 126,
    "position": 1,
    "text": "برآمد دم بوق و آوای کوس"
  },
  {
    "poem_id": 87985,
    "vorder": 127,
    "position": 0,
    "text": "سواران ایران همه همگروه"
  },
  {
    "poem_id": 87985,
    "vorder": 128,
    "position": 1,
    "text": "رده برکشیدند بر پیش کوه"
  },
  {
    "poem_id": 87985,
    "vorder": 129,
    "position": 0,
    "text": "چو هومان بدید آن سپاه گران"
  },
  {
    "poem_id": 87985,
    "vorder": 130,
    "position": 1,
    "text": "گراییدن گرز و تیغ سران"
  },
  {
    "poem_id": 87985,
    "vorder": 131,
    "position": 0,
    "text": "چنین گفت هومان بگودرز و طوس"
  },
  {
    "poem_id": 87985,
    "vorder": 132,
    "position": 1,
    "text": "کز ایران برفتید با پیل و کوس"
  },
  {
    "poem_id": 87985,
    "vorder": 133,
    "position": 0,
    "text": "سوس شهر ترکان بکین آختن"
  },
  {
    "poem_id": 87985,
    "vorder": 134,
    "position": 1,
    "text": "بدان روی لشکر برون تاختن"
  },
  {
    "poem_id": 87985,
    "vorder": 135,
    "position": 0,
    "text": "کنون برگزیدی چو نخچیر کوه"
