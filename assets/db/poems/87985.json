  {
    "poem_id": 87985,
    "vorder": 136,
    "position": 1,
    "text": "شدستی ز گردان توران ستوه"
  },
  {
    "poem_id": 87985,
    "vorder": 137,
    "position": 0,
    "text": "نیایدت زین کار خود شرم و ننگ"
