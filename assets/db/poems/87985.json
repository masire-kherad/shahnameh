  },
  {
    "poem_id": 87985,
    "vorder": 144,
    "position": 1,
    "text": "که اندیشهٔ ما دگرگونه بود"
  },
  {
    "poem_id": 87985,
    "vorder": 145,
    "position": 0,
    "text": "دگرگونه بود آنچ انداختیم"
