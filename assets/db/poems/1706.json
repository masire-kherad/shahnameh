[
  {
    "poem_id": 1706,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه شد سوی جنگ کرم"
  },
  {
    "poem_id": 1706,
    "vorder": 2,
    "position": 1,
    "text": "سپاهش همی کرد آهنگ کرم"
  },
  {
    "poem_id": 1706,
    "vorder": 3,
    "position": 0,
    "text": "بیاورد لشکر ده و دو هزار"
  },
  {
    "poem_id": 1706,
    "vorder": 4,
    "position": 1,
    "text": "جهاندیده و کارکرده سوار"
  },
  {
    "poem_id": 1706,
    "vorder": 5,
    "position": 0,
    "text": "پراگنده لشکر چو شد همگروه"
  },
  {
    "poem_id": 1706,
    "vorder": 6,
    "position": 1,
    "text": "بیاوردشان تا میان دو کوه"
  },
  {
    "poem_id": 1706,
    "vorder": 7,
    "position": 0,
    "text": "یکی مرد بد نام او شهرگیر"
  },
  {
    "poem_id": 1706,
    "vorder": 8,
    "position": 1,
    "text": "خردمند سالار شاه اردشیر"
  },
  {
    "poem_id": 1706,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت پس شاه با پهلوان"
  },
  {
    "poem_id": 1706,
    "vorder": 10,
    "position": 1,
    "text": "که ایدر همی باش روشن‌روان"
  },
  {
    "poem_id": 1706,
    "vorder": 11,
    "position": 0,
    "text": "شب و روز کرده طلایه به پای"
  },
  {
    "poem_id": 1706,
    "vorder": 12,
    "position": 1,
    "text": "سواران با دانش و رهنمای"
  },
  {
    "poem_id": 1706,
    "vorder": 13,
    "position": 0,
    "text": "همان دیده‌بان دار و هم پاسبان"
  },
  {
    "poem_id": 1706,
    "vorder": 14,
    "position": 1,
    "text": "نگهبان لشکر به روز و شبان"
  },
  {
    "poem_id": 1706,
    "vorder": 15,
    "position": 0,
    "text": "من اکنون بسازم یکی کیمیا"
  },
  {
    "poem_id": 1706,
    "vorder": 16,
    "position": 1,
    "text": "چو اسفندیار آنک بودم نیا"
  },
  {
    "poem_id": 1706,
    "vorder": 17,
    "position": 0,
    "text": "اگر دیده‌بان دود بیند به روز"
  },
  {
    "poem_id": 1706,
    "vorder": 18,
    "position": 1,
    "text": "شب آتش چو خورشید گیتی فروز"
  },
  {
    "poem_id": 1706,
    "vorder": 19,
    "position": 0,
    "text": "بدانید کامد به سر کار کرم"
  },
  {
    "poem_id": 1706,
    "vorder": 20,
    "position": 1,
    "text": "گذشت اختر و روز بازار کرم"
  },
  {
    "poem_id": 1706,
    "vorder": 21,
    "position": 0,
    "text": "گزین کرد زان مهتران هفت مرد"
  },
  {
    "poem_id": 1706,
    "vorder": 22,
    "position": 1,
    "text": "دلیران و شیران روز نبرد"
  },
  {
    "poem_id": 1706,
    "vorder": 23,
    "position": 0,
    "text": "هرآنکس که بودی هم‌آواز اوی"
  },
  {
    "poem_id": 1706,
    "vorder": 24,
    "position": 1,
    "text": "نگفتی به باد هوا راز اوی"
  },
  {
    "poem_id": 1706,
    "vorder": 25,
    "position": 0,
    "text": "بسی گوهر از گنج بگزید نیز"
  },
  {
    "poem_id": 1706,
    "vorder": 26,
    "position": 1,
    "text": "ز دیبا و دینار و هرگونه چیز"
  },
  {
    "poem_id": 1706,
    "vorder": 27,
    "position": 0,
    "text": "به چشم خرد چیز ناچیز کرد"
  },
  {
    "poem_id": 1706,
    "vorder": 28,
    "position": 1,
    "text": "دو صندوق پر سرب و ارزیز کرد"
  },
  {
    "poem_id": 1706,
    "vorder": 29,
    "position": 0,
    "text": "یکی دیگ رویین به بار اندرون"
  },
  {
    "poem_id": 1706,
    "vorder": 30,
    "position": 1,
    "text": "که استاد بود او به کار اندرون"
  },
  {
    "poem_id": 1706,
    "vorder": 31,
    "position": 0,
    "text": "چو از بردنی جامه‌ها کرد راست"
  },
  {
    "poem_id": 1706,
    "vorder": 32,
    "position": 1,
    "text": "ز سالار آخر خری ده بخواست"
  },
  {
    "poem_id": 1706,
    "vorder": 33,
    "position": 0,
    "text": "چو خربندگان جامه‌های گلیم"
  },
  {
    "poem_id": 1706,
    "vorder": 34,
    "position": 1,
    "text": "بپوشید و بارش همه زر و سیم"
  },
  {
    "poem_id": 1706,
    "vorder": 35,
    "position": 0,
    "text": "همی شد خلیده‌دل و راه‌جوی"
  },
  {
    "poem_id": 1706,
    "vorder": 36,
    "position": 1,
    "text": "ز لشگر سوی دژ نهادند روی"
  },
  {
    "poem_id": 1706,
    "vorder": 37,
    "position": 0,
    "text": "همان روستایی دو مرد جوان"
  },
  {
    "poem_id": 1706,
    "vorder": 38,
    "position": 1,
    "text": "که بودند روزی ورا میزبان"
  },
  {
    "poem_id": 1706,
    "vorder": 39,
    "position": 0,
    "text": "از آن انجمن برد با خویشتن"
  },
  {
    "poem_id": 1706,
    "vorder": 40,
    "position": 1,
    "text": "که هم دوست بودند و هم رای‌زن"
  },
  {
    "poem_id": 1706,
    "vorder": 41,
    "position": 0,
    "text": "همی رفت همراه آن کاروان"
  },
  {
    "poem_id": 1706,
    "vorder": 42,
    "position": 1,
    "text": "به رسم یکی مرد بازارگان"
  },
  {
    "poem_id": 1706,
    "vorder": 43,
    "position": 0,
    "text": "چو از راه نزدیکی دژ رسید"
  },
  {
    "poem_id": 1706,
    "vorder": 44,
    "position": 1,
    "text": "دژ و باره و شهر از دور دید"
  },
  {
    "poem_id": 1706,
    "vorder": 45,
    "position": 0,
    "text": "پرستندهٔ کرم بد شست مرد"
  },
  {
    "poem_id": 1706,
    "vorder": 46,
    "position": 1,
    "text": "نپرداختندی کس از کارکرد"
  },
  {
    "poem_id": 1706,
    "vorder": 47,
    "position": 0,
    "text": "نگه کرد یک تن به آواز گفت"
  },
  {
    "poem_id": 1706,
    "vorder": 48,
    "position": 1,
    "text": "که صندوق را چیست اندر نهفت"
  },
  {
    "poem_id": 1706,
    "vorder": 49,
    "position": 0,
    "text": "چنین داد پاسخ بدو شهریار"
  },
  {
    "poem_id": 1706,
    "vorder": 50,
    "position": 1,
    "text": "که هرگونه‌ای چیز دارم به بار"
  },
  {
    "poem_id": 1706,
    "vorder": 51,
    "position": 0,
    "text": "ز پیرایه و جامه و سیم و زر"
  },
  {
    "poem_id": 1706,
    "vorder": 52,
    "position": 1,
    "text": "ز دینار و دیبا و در و گهر"
  },
  {
    "poem_id": 1706,
    "vorder": 53,
    "position": 0,
    "text": "به بازارگانی خراسانیم"
  },
  {
    "poem_id": 1706,
    "vorder": 54,
    "position": 1,
    "text": "به رنج اندرون بی تن‌آسانیم"
  },
  {
    "poem_id": 1706,
    "vorder": 55,
    "position": 0,
    "text": "بسی خواسته کردم از بخت کرم"
  },
  {
    "poem_id": 1706,
    "vorder": 56,
    "position": 1,
    "text": "کنون آمدم شاد تا تخت کرم"
  },
  {
    "poem_id": 1706,
    "vorder": 57,
    "position": 0,
    "text": "اگر بر پرستش فزایم رواست"
  },
  {
    "poem_id": 1706,
    "vorder": 58,
    "position": 1,
    "text": "که از بخت او کار من گشت راست"
  },
  {
    "poem_id": 1706,
    "vorder": 59,
    "position": 0,
    "text": "پرستنده کرم بگشاد راز"
  },
  {
    "poem_id": 1706,
    "vorder": 60,
    "position": 1,
    "text": "هم‌انگه در دژ گشادند باز"
  },
  {
    "poem_id": 1706,
    "vorder": 61,
    "position": 0,
    "text": "چو آن بار او راند اندر حصار"
  },
  {
    "poem_id": 1706,
    "vorder": 62,
    "position": 1,
    "text": "بیاراست کار از در نامدار"
  },
  {
    "poem_id": 1706,
    "vorder": 63,
    "position": 0,
    "text": "سر بار بگشاد زود اردشیر"
  },
  {
    "poem_id": 1706,
    "vorder": 64,
    "position": 1,
    "text": "ببخشید چیزی که بد زو گزیر"
  },
  {
    "poem_id": 1706,
    "vorder": 65,
    "position": 0,
    "text": "یکی سفره پیش پرستندگان"
  },
  {
    "poem_id": 1706,
    "vorder": 66,
    "position": 1,
    "text": "بگسترد و برخاست چون بندگان"
  },
  {
    "poem_id": 1706,
    "vorder": 67,
    "position": 0,
    "text": "ز صندوق بگشاد و بند و کلید"
  },
  {
    "poem_id": 1706,
    "vorder": 68,
    "position": 1,
    "text": "برآورد و برداشت جام نبید"
  },
  {
    "poem_id": 1706,
    "vorder": 69,
    "position": 0,
    "text": "هرانکس که زی کرم بردی خورش"
  },
  {
    "poem_id": 1706,
    "vorder": 70,
    "position": 1,
    "text": "ز شیر و برنج آنچ بد پرورش"
  },
  {
    "poem_id": 1706,
    "vorder": 71,
    "position": 0,
    "text": "بپیچید گردن ز جام نبید"
  },
  {
    "poem_id": 1706,
    "vorder": 72,
    "position": 1,
    "text": "که نوبت بدش جای مستی ندید"
  },
  {
    "poem_id": 1706,
    "vorder": 73,
    "position": 0,
    "text": "چو بشنید بر پای جست اردشیر"
  },
  {
    "poem_id": 1706,
    "vorder": 74,
    "position": 1,
    "text": "که با من فراوان برنجست و شیر"
  },
  {
    "poem_id": 1706,
    "vorder": 75,
    "position": 0,
    "text": "به دستوری سرپرستان سه روز"
  },
  {
    "poem_id": 1706,
    "vorder": 76,
    "position": 1,
    "text": "مر او را بخوردن منم دلفروز"
  },
  {
    "poem_id": 1706,
    "vorder": 77,
    "position": 0,
    "text": "مگر من شوم در جهان شهره‌ای"
  },
  {
    "poem_id": 1706,
    "vorder": 78,
    "position": 1,
    "text": "مرا باشد از اخترش بهره‌ای"
  },
  {
    "poem_id": 1706,
    "vorder": 79,
    "position": 0,
    "text": "شما می گسارید با من سه روز"
  },
  {
    "poem_id": 1706,
    "vorder": 80,
    "position": 1,
    "text": "چهارم چو خورشید گیتی فروز"
  },
  {
    "poem_id": 1706,
    "vorder": 81,
    "position": 0,
    "text": "برآید یکی کلبه سازم فراخ"
  },
  {
    "poem_id": 1706,
    "vorder": 82,
    "position": 1,
    "text": "سر طاق برتر ز ایوان و کاخ"
  },
  {
    "poem_id": 1706,
    "vorder": 83,
    "position": 0,
    "text": "فروشنده‌ام هم خریدارجوی"
  },
  {
    "poem_id": 1706,
    "vorder": 84,
    "position": 1,
    "text": "فزاید مرا نزد کرم آبروی"
  },
  {
    "poem_id": 1706,
    "vorder": 85,
    "position": 0,
    "text": "برآمد همه کام او زین سخن"
  },
  {
    "poem_id": 1706,
    "vorder": 86,
    "position": 1,
    "text": "بگفتند کو را پرستش تو کن"
  },
  {
    "poem_id": 1706,
    "vorder": 87,
    "position": 0,
    "text": "برآورد خربنده هرگونه رنگ"
  },
  {
    "poem_id": 1706,
    "vorder": 88,
    "position": 1,
    "text": "پرستنده بنشست با می به چنگ"
  },
  {
    "poem_id": 1706,
    "vorder": 89,
    "position": 0,
    "text": "بخوردند می چند و مستان شدند"
  },
  {
    "poem_id": 1706,
    "vorder": 90,
    "position": 1,
    "text": "پرستندگان می پرستان شدند"
  },
  {
    "poem_id": 1706,
    "vorder": 91,
    "position": 0,
    "text": "چو از جام می سست شدشان زبان"
  },
  {
    "poem_id": 1706,
    "vorder": 92,
    "position": 1,
    "text": "بیامد جهاندار با میزبان"
  },
  {
    "poem_id": 1706,
    "vorder": 93,
    "position": 0,
    "text": "بیاورد ارزیز و رویین لوید"
  },
  {
    "poem_id": 1706,
    "vorder": 94,
    "position": 1,
    "text": "برافروخت آتش به روز سپید"
  },
  {
    "poem_id": 1706,
    "vorder": 95,
    "position": 0,
    "text": "چو آن کرم را بود گاه خورش"
  },
  {
    "poem_id": 1706,
    "vorder": 96,
    "position": 1,
    "text": "ز ارزیز جوشان بدش پرورش"
  },
  {
    "poem_id": 1706,
    "vorder": 97,
    "position": 0,
    "text": "زبانش بدیدند همرنگ سنج"
  },
  {
    "poem_id": 1706,
    "vorder": 98,
    "position": 1,
    "text": "بران‌سان که از پیش خوردی برنج"
  },
  {
    "poem_id": 1706,
    "vorder": 99,
    "position": 0,
    "text": "فرو ریخت ارزیز مرد جوان"
  },
  {
    "poem_id": 1706,
    "vorder": 100,
    "position": 1,
    "text": "به کنده درون کرم شد ناتوان"
  },
  {
    "poem_id": 1706,
    "vorder": 101,
    "position": 0,
    "text": "تراکی برآمد ز حلقوم اوی"
  },
  {
    "poem_id": 1706,
    "vorder": 102,
    "position": 1,
    "text": "که لرزان شد آن کنده و بوم اوی"
  },
  {
    "poem_id": 1706,
    "vorder": 103,
    "position": 0,
    "text": "بشد با جوانان چو باد اردشیر"
  },
  {
    "poem_id": 1706,
    "vorder": 104,
    "position": 1,
    "text": "ابا گرز و شمشیر و گوپال و تیر"
  },
  {
    "poem_id": 1706,
    "vorder": 105,
    "position": 0,
    "text": "پرستندگان را که بودند مست"
  },
  {
    "poem_id": 1706,
    "vorder": 106,
    "position": 1,
    "text": "یکی زنده از تیغ ایشان نجست"
  },
  {
    "poem_id": 1706,
    "vorder": 107,
    "position": 0,
    "text": "برانگیخت از بام دژ تیره دود"
  },
  {
    "poem_id": 1706,
    "vorder": 108,
    "position": 1,
    "text": "دلیری به سالار لشکر نمود"
  },
  {
    "poem_id": 1706,
    "vorder": 109,
    "position": 0,
    "text": "دوان دیده‌بان شد بر شهرگیر"
  },
  {
    "poem_id": 1706,
    "vorder": 110,
    "position": 1,
    "text": "که پیروزگر گشت شاه اردشیر"
  },
  {
    "poem_id": 1706,
    "vorder": 111,
    "position": 0,
    "text": "بیامد سبک پهلوان با سپاه"
  },
  {
    "poem_id": 1706,
    "vorder": 112,
    "position": 1,
    "text": "بیاورد لشکر به نزدیک شاه"
  }
]