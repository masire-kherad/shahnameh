[
  {
    "poem_id": 1873,
    "vorder": 1,
    "position": 0,
    "text": "مرا سال بگذشت برشست و پنج"
  },
  {
    "poem_id": 1873,
    "vorder": 2,
    "position": 1,
    "text": "نه نیکو بود گر بیازم به گنج"
  },
  {
    "poem_id": 1873,
    "vorder": 3,
    "position": 0,
    "text": "مگر بهره بر گیرم از پند خویش"
  },
  {
    "poem_id": 1873,
    "vorder": 4,
    "position": 1,
    "text": "بر اندیشم از مرگ فرزند خویش"
  },
  {
    "poem_id": 1873,
    "vorder": 5,
    "position": 0,
    "text": "مرا بود نوبت برفت آن جوان"
  },
  {
    "poem_id": 1873,
    "vorder": 6,
    "position": 1,
    "text": "ز دردش منم چون تن بی‌روان"
  },
  {
    "poem_id": 1873,
    "vorder": 7,
    "position": 0,
    "text": "شتابم همی تا مگر یابمش"
  },
  {
    "poem_id": 1873,
    "vorder": 8,
    "position": 1,
    "text": "چویابم به بیغاره بشتابمش"
  },
  {
    "poem_id": 1873,
    "vorder": 9,
    "position": 0,
    "text": "که نوبت مرا بود بی‌کام من"
  },
  {
    "poem_id": 1873,
    "vorder": 10,
    "position": 1,
    "text": "چرا رفتی و بردی آرام من"
  },
  {
    "poem_id": 1873,
    "vorder": 11,
    "position": 0,
    "text": "ز بدها تو بودی مرا دستگیر"
  },
  {
    "poem_id": 1873,
    "vorder": 12,
    "position": 1,
    "text": "چرا چاره جستی ز همراه پیر"
  },
  {
    "poem_id": 1873,
    "vorder": 13,
    "position": 0,
    "text": "مگر همرهان جوان یافتی"
  },
  {
    "poem_id": 1873,
    "vorder": 14,
    "position": 1,
    "text": "که از پیش من تیز بشتافتی"
  },
  {
    "poem_id": 1873,
    "vorder": 15,
    "position": 0,
    "text": "جوان را چو شد سال برسی و هفت"
  },
  {
    "poem_id": 1873,
    "vorder": 16,
    "position": 1,
    "text": "نه بر آرزو یافت گیتی برفت"
  },
  {
    "poem_id": 1873,
    "vorder": 17,
    "position": 0,
    "text": "همی‌بود همواره با من درشت"
  },
  {
    "poem_id": 1873,
    "vorder": 18,
    "position": 1,
    "text": "برآشفت و یکباره بنمود پشت"
  },
  {
    "poem_id": 1873,
    "vorder": 19,
    "position": 0,
    "text": "برفت و غم و رنجش ایدر بماند"
  },
  {
    "poem_id": 1873,
    "vorder": 20,
    "position": 1,
    "text": "دل و دیدهٔ من به خون درنشاند"
  },
  {
    "poem_id": 1873,
    "vorder": 21,
    "position": 0,
    "text": "کنون او سوی روشنایی رسید"
  },
  {
    "poem_id": 1873,
    "vorder": 22,
    "position": 1,
    "text": "پدر را همی جای خواهد گزید"
  },
  {
    "poem_id": 1873,
    "vorder": 23,
    "position": 0,
    "text": "برآمد چنین روزگار دراز"
  },
  {
    "poem_id": 1873,
    "vorder": 24,
    "position": 1,
    "text": "کزان همرهان کس نگشتند باز"
  },
  {
    "poem_id": 1873,
    "vorder": 25,
    "position": 0,
    "text": "همانا مرا چشم دارد همی"
  },
  {
    "poem_id": 1873,
    "vorder": 26,
    "position": 1,
    "text": "ز دیر آمدن خشم دارد همی"
  },
  {
    "poem_id": 1873,
    "vorder": 27,
    "position": 0,
    "text": "ورا سال سی بد مرا شصت و هفت"
  },
  {
    "poem_id": 1873,
    "vorder": 28,
    "position": 1,
    "text": "نپرسید زین پیر و تنها برفت"
  },
  {
    "poem_id": 1873,
    "vorder": 29,
    "position": 0,
    "text": "وی اندر شتاب و من اندر درنگ"
  },
  {
    "poem_id": 1873,
    "vorder": 30,
    "position": 1,
    "text": "ز کردارها تا چه آید به چنگ"
  },
  {
    "poem_id": 1873,
    "vorder": 31,
    "position": 0,
    "text": "روان تو دارنده روشن کناد"
  },
  {
    "poem_id": 1873,
    "vorder": 32,
    "position": 1,
    "text": "خرد پیش جان تو جوشن کناد"
  },
  {
    "poem_id": 1873,
    "vorder": 33,
    "position": 0,
    "text": "همی‌خواهم از کردگار جهان"
  },
  {
    "poem_id": 1873,
    "vorder": 34,
    "position": 1,
    "text": "ز روزی ده آشکار و نهان"
  },
  {
    "poem_id": 1873,
    "vorder": 35,
    "position": 0,
    "text": "که یکسر ببخشد گناه مرا"
  },
  {
    "poem_id": 1873,
    "vorder": 36,
    "position": 1,
    "text": "درخشان کند تیره گاه مرا"
  }
]