[
  {
    "poem_id": 1832,
    "vorder": 1,
    "position": 0,
    "text": "یکی پیر بد پهلوانی سخن"
  },
  {
    "poem_id": 1832,
    "vorder": 2,
    "position": 1,
    "text": "به گفتار و کردار گشته کهن"
  },
  {
    "poem_id": 1832,
    "vorder": 3,
    "position": 0,
    "text": "چنین گوید از دفتر پهلوان"
  },
  {
    "poem_id": 1832,
    "vorder": 4,
    "position": 1,
    "text": "که پرسید موبد ز نوشین‌روان"
  },
  {
    "poem_id": 1832,
    "vorder": 5,
    "position": 0,
    "text": "که آن چیست کز کردگار جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 6,
    "position": 1,
    "text": "بخواهد پرستنده اندر نهان"
  },
  {
    "poem_id": 1832,
    "vorder": 7,
    "position": 0,
    "text": "بدان آرزو نیز پاسخ دهد"
  },
  {
    "poem_id": 1832,
    "vorder": 8,
    "position": 1,
    "text": "بدان پاسخش بخت فرخ نهد"
  },
  {
    "poem_id": 1832,
    "vorder": 9,
    "position": 0,
    "text": "یکی دست برداشته به آسمان"
  },
  {
    "poem_id": 1832,
    "vorder": 10,
    "position": 1,
    "text": "همی‌خواهد از کردگار جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 11,
    "position": 0,
    "text": "نیابد به خواهش همه آرزو"
  },
  {
    "poem_id": 1832,
    "vorder": 12,
    "position": 1,
    "text": "دو چشمش پر از آب و پر چینش رو"
  },
  {
    "poem_id": 1832,
    "vorder": 13,
    "position": 0,
    "text": "به موبد چنین گفت پیروز شاه"
  },
  {
    "poem_id": 1832,
    "vorder": 14,
    "position": 1,
    "text": "که خواهش ز یزدان به اندازه خواه"
  },
  {
    "poem_id": 1832,
    "vorder": 15,
    "position": 0,
    "text": "کزان آرزو دل پر از خون شود"
  },
  {
    "poem_id": 1832,
    "vorder": 16,
    "position": 1,
    "text": "که خواهد که ز اندازه بیرون شود"
  },
  {
    "poem_id": 1832,
    "vorder": 17,
    "position": 0,
    "text": "بپرسید نیکی کرا درخورست"
  },
  {
    "poem_id": 1832,
    "vorder": 18,
    "position": 1,
    "text": "به نام بزرگی که زیباتر‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ که هرکس که گنج"
  },
  {
    "poem_id": 1832,
    "vorder": 20,
    "position": 1,
    "text": "بیابد پراگنده نابرده رنج"
  },
  {
    "poem_id": 1832,
    "vorder": 21,
    "position": 0,
    "text": "نبخشد نباشد سزاوار تخت"
  },
  {
    "poem_id": 1832,
    "vorder": 22,
    "position": 1,
    "text": "زمان تا زمان تیره گرددش بخت"
  },
  {
    "poem_id": 1832,
    "vorder": 23,
    "position": 0,
    "text": "ز هستی و بخشش بود مرد مه"
  },
  {
    "poem_id": 1832,
    "vorder": 24,
    "position": 1,
    "text": "تو ار گنج داری نبخشی نه به"
  },
  {
    "poem_id": 1832,
    "vorder": 25,
    "position": 0,
    "text": "بگفتش خرد را که بنیاد چیست"
  },
  {
    "poem_id": 1832,
    "vorder": 26,
    "position": 1,
    "text": "به‌شاخ و به‌برگ خرد شاد کیست"
  },
  {
    "poem_id": 1832,
    "vorder": 27,
    "position": 0,
    "text": "چنین داد پاسخ که داناست شاد"
  },
  {
    "poem_id": 1832,
    "vorder": 28,
    "position": 1,
    "text": "دگر آنک شرمش بود با نژاد"
  },
  {
    "poem_id": 1832,
    "vorder": 29,
    "position": 0,
    "text": "بپرسید دانش کرا سودمند"
  },
  {
    "poem_id": 1832,
    "vorder": 30,
    "position": 1,
    "text": "کدامست بی‌دانش و بی‌گزند"
  },
  {
    "poem_id": 1832,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد پاسخ که هر کو خرد"
  },
  {
    "poem_id": 1832,
    "vorder": 32,
    "position": 1,
    "text": "بپرورد جان را همی‌پرورد"
  },
  {
    "poem_id": 1832,
    "vorder": 33,
    "position": 0,
    "text": "ز بیشی خرد را بود سودمند"
  },
  {
    "poem_id": 1832,
    "vorder": 34,
    "position": 1,
    "text": "همان بی‌خرد باشد اندر گزند"
  },
  {
    "poem_id": 1832,
    "vorder": 35,
    "position": 0,
    "text": "بگفت‌ش که دانش به از فر شاه"
  },
  {
    "poem_id": 1832,
    "vorder": 36,
    "position": 1,
    "text": "که فر و بزرگی‌ست زیبای گاه"
  },
  {
    "poem_id": 1832,
    "vorder": 37,
    "position": 0,
    "text": "چنین داد پاسخ که دانا به فر"
  },
  {
    "poem_id": 1832,
    "vorder": 38,
    "position": 1,
    "text": "بگیرد جهان سر به سر زیر پر"
  },
  {
    "poem_id": 1832,
    "vorder": 39,
    "position": 0,
    "text": "خرد باید و نام و فر و نژاد"
  },
  {
    "poem_id": 1832,
    "vorder": 40,
    "position": 1,
    "text": "بدین چار گیرد سپهر از تو یاد"
  },
  {
    "poem_id": 1832,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت زان پس که زیبای تخت"
  },
  {
    "poem_id": 1832,
    "vorder": 42,
    "position": 1,
    "text": "کدامست وز کیست ناشاد بخت"
  },
  {
    "poem_id": 1832,
    "vorder": 43,
    "position": 0,
    "text": "چنین داد پاسخ که یاری نخست"
  },
  {
    "poem_id": 1832,
    "vorder": 44,
    "position": 1,
    "text": "بباید ز شاه جهاندار جست"
  },
  {
    "poem_id": 1832,
    "vorder": 45,
    "position": 0,
    "text": "دگر بخشش و دانش و رسم گاه"
  },
  {
    "poem_id": 1832,
    "vorder": 46,
    "position": 1,
    "text": "دلش پر ز بخشایش دادخواه"
  },
  {
    "poem_id": 1832,
    "vorder": 47,
    "position": 0,
    "text": "ششم نیز کانرا دهد مهتری"
  },
  {
    "poem_id": 1832,
    "vorder": 48,
    "position": 1,
    "text": "که باشد سزوار بر بهتری"
  },
  {
    "poem_id": 1832,
    "vorder": 49,
    "position": 0,
    "text": "به هفتم که از نیک و بد در جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 50,
    "position": 1,
    "text": "سخن‌ها بروبر نماند نهان"
  },
  {
    "poem_id": 1832,
    "vorder": 51,
    "position": 0,
    "text": "چو فر و خرد دارد و دین و بخت"
  },
  {
    "poem_id": 1832,
    "vorder": 52,
    "position": 1,
    "text": "سزوار تاج است و زیبای تخت"
  },
  {
    "poem_id": 1832,
    "vorder": 53,
    "position": 0,
    "text": "به هشتم که دشمن بداند ز دوست"
  },
  {
    "poem_id": 1832,
    "vorder": 54,
    "position": 1,
    "text": "بی‌آزاری از شهریاران نکوست"
  },
  {
    "poem_id": 1832,
    "vorder": 55,
    "position": 0,
    "text": "نماند پس از مرگ او نام زشت"
  },
  {
    "poem_id": 1832,
    "vorder": 56,
    "position": 1,
    "text": "بیابد به فرجام خرم بهشت"
  },
  {
    "poem_id": 1832,
    "vorder": 57,
    "position": 0,
    "text": "بپرسیدش از داد و خردک منش"
  },
  {
    "poem_id": 1832,
    "vorder": 58,
    "position": 1,
    "text": "ز نیکی وز مردم بدکنش"
  },
  {
    "poem_id": 1832,
    "vorder": 59,
    "position": 0,
    "text": "چنین داد پاسخ که آز و نیاز"
  },
  {
    "poem_id": 1832,
    "vorder": 60,
    "position": 1,
    "text": "دو دیوند بد‌گوهر و دیر‌ساز"
  },
  {
    "poem_id": 1832,
    "vorder": 61,
    "position": 0,
    "text": "هرآنکس که بیشی کند آرزوی"
  },
  {
    "poem_id": 1832,
    "vorder": 62,
    "position": 1,
    "text": "بدو دیو او باز گردد به خوی"
  },
  {
    "poem_id": 1832,
    "vorder": 63,
    "position": 0,
    "text": "وگر سفلگی برگزید او ز رنج"
  },
  {
    "poem_id": 1832,
    "vorder": 64,
    "position": 1,
    "text": "گزیند برین خاک آگنده گنج"
  },
  {
    "poem_id": 1832,
    "vorder": 65,
    "position": 0,
    "text": "چو بیچاره دیوی بود دیرساز"
  },
  {
    "poem_id": 1832,
    "vorder": 66,
    "position": 1,
    "text": "که هر دو به یک خو گرایند باز"
  },
  {
    "poem_id": 1832,
    "vorder": 67,
    "position": 0,
    "text": "بپرسید و گفتا که چندست و چیست"
  },
  {
    "poem_id": 1832,
    "vorder": 68,
    "position": 1,
    "text": "که بهری برو هم بباید گریست"
  },
  {
    "poem_id": 1832,
    "vorder": 69,
    "position": 0,
    "text": "دگر بهر ازو گنج و تاجست و نام"
  },
  {
    "poem_id": 1832,
    "vorder": 70,
    "position": 1,
    "text": "ازان مستمندیم و زین شادکام"
  },
  {
    "poem_id": 1832,
    "vorder": 71,
    "position": 0,
    "text": "چنین داد پاسخ که دانا سخن"
  },
  {
    "poem_id": 1832,
    "vorder": 72,
    "position": 1,
    "text": "ببخشید و اندیشه افگند بن"
  },
  {
    "poem_id": 1832,
    "vorder": 73,
    "position": 0,
    "text": "نخستین سخن گفتن سودمند"
  },
  {
    "poem_id": 1832,
    "vorder": 74,
    "position": 1,
    "text": "خوش آواز خواند ورا بی‌گزند"
  },
  {
    "poem_id": 1832,
    "vorder": 75,
    "position": 0,
    "text": "دگر آنک پیمان سخن خواستن"
  },
  {
    "poem_id": 1832,
    "vorder": 76,
    "position": 1,
    "text": "سخنگوی و بینا دل آراستن"
  },
  {
    "poem_id": 1832,
    "vorder": 77,
    "position": 0,
    "text": "که چندان سراید که آید به کار"
  },
  {
    "poem_id": 1832,
    "vorder": 78,
    "position": 1,
    "text": "وزو ماند اندر جهان یادگار"
  },
  {
    "poem_id": 1832,
    "vorder": 79,
    "position": 0,
    "text": "سه دیگر سخنگوی هنگام‌جوی"
  },
  {
    "poem_id": 1832,
    "vorder": 80,
    "position": 1,
    "text": "بماند همه ساله بر آب روی"
  },
  {
    "poem_id": 1832,
    "vorder": 81,
    "position": 0,
    "text": "چهارم که دانا دلارای خواند"
  },
  {
    "poem_id": 1832,
    "vorder": 82,
    "position": 1,
    "text": "سراینده را مرد بارای خواند"
  },
  {
    "poem_id": 1832,
    "vorder": 83,
    "position": 0,
    "text": "که پیوسته گوید سراسر سخن"
  },
  {
    "poem_id": 1832,
    "vorder": 84,
    "position": 1,
    "text": "اگر نو بود داستان گر کهن"
  },
  {
    "poem_id": 1832,
    "vorder": 85,
    "position": 0,
    "text": "به پنجم که باشد سخنگوی گرم"
  },
  {
    "poem_id": 1832,
    "vorder": 86,
    "position": 1,
    "text": "به شیرین سخن هم به آواز نرم"
  },
  {
    "poem_id": 1832,
    "vorder": 87,
    "position": 0,
    "text": "سخن چون یک اندر دگر بافتی"
  },
  {
    "poem_id": 1832,
    "vorder": 88,
    "position": 1,
    "text": "ازو بی‌گمان کام دل یافتی"
  },
  {
    "poem_id": 1832,
    "vorder": 89,
    "position": 0,
    "text": "بپرسید چندی که آموختی"
  },
  {
    "poem_id": 1832,
    "vorder": 90,
    "position": 1,
    "text": "روان را به دانش بیفروختی"
  },
  {
    "poem_id": 1832,
    "vorder": 91,
    "position": 0,
    "text": "چنین گفت کز هرک آموختم"
  },
  {
    "poem_id": 1832,
    "vorder": 92,
    "position": 1,
    "text": "همه فام جان و خرد توختم"
  },
  {
    "poem_id": 1832,
    "vorder": 93,
    "position": 0,
    "text": "همی‌پرسم از ناسزایان سخن"
  },
  {
    "poem_id": 1832,
    "vorder": 94,
    "position": 1,
    "text": "چه گویی که دانش کی آید به بن"
  },
  {
    "poem_id": 1832,
    "vorder": 95,
    "position": 0,
    "text": "به دانش نگر دور باش از گناه"
  },
  {
    "poem_id": 1832,
    "vorder": 96,
    "position": 1,
    "text": "که دانش گرامی‌تر از تاج و گاه"
  },
  {
    "poem_id": 1832,
    "vorder": 97,
    "position": 0,
    "text": "بپرسید کس را از آموختن"
  },
  {
    "poem_id": 1832,
    "vorder": 98,
    "position": 1,
    "text": "ستایش ندیدم و افروختن"
  },
  {
    "poem_id": 1832,
    "vorder": 99,
    "position": 0,
    "text": "که نیزش ز دانا بباید شنید"
  },
  {
    "poem_id": 1832,
    "vorder": 100,
    "position": 1,
    "text": "نگویم کسی کو به‌جایی رسید"
  },
  {
    "poem_id": 1832,
    "vorder": 101,
    "position": 0,
    "text": "چنین داد پاسخ که از گنج سیر"
  },
  {
    "poem_id": 1832,
    "vorder": 102,
    "position": 1,
    "text": "که آید مگر خاکش آرد به زیر"
  },
  {
    "poem_id": 1832,
    "vorder": 103,
    "position": 0,
    "text": "در دانش از گنج نامی‌ترست"
  },
  {
    "poem_id": 1832,
    "vorder": 104,
    "position": 1,
    "text": "همان نزد دانا گرامی‌ترست"
  },
  {
    "poem_id": 1832,
    "vorder": 105,
    "position": 0,
    "text": "سخن ماند از ما همی یادگار"
  },
  {
    "poem_id": 1832,
    "vorder": 106,
    "position": 1,
    "text": "تو با گنج دانش برابر مدار"
  },
  {
    "poem_id": 1832,
    "vorder": 107,
    "position": 0,
    "text": "بپرسید دانا شود مرد پیر"
  },
  {
    "poem_id": 1832,
    "vorder": 108,
    "position": 1,
    "text": "گر آموزشی باشد و یاد‌گیر"
  },
  {
    "poem_id": 1832,
    "vorder": 109,
    "position": 0,
    "text": "چنین داد پاسخ که دانای پیر"
  },
  {
    "poem_id": 1832,
    "vorder": 110,
    "position": 1,
    "text": "ز دانش جوانی بود ناگزیر"
  },
  {
    "poem_id": 1832,
    "vorder": 111,
    "position": 0,
    "text": "بر ابله جوانی گزینی رواست"
  },
  {
    "poem_id": 1832,
    "vorder": 112,
    "position": 1,
    "text": "که بی‌گور او خاک او بی‌نواست"
  },
  {
    "poem_id": 1832,
    "vorder": 113,
    "position": 0,
    "text": "بپرسید کز تخت شاهنشهان"
  },
  {
    "poem_id": 1832,
    "vorder": 114,
    "position": 1,
    "text": "بکردی همه شهریار جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 115,
    "position": 0,
    "text": "کنون نامشان بیش یاد آوریم"
  },
  {
    "poem_id": 1832,
    "vorder": 116,
    "position": 1,
    "text": "بیاد از جگر سرد باد آوریم"
  },
  {
    "poem_id": 1832,
    "vorder": 117,
    "position": 0,
    "text": "چنین داد پاسخ که در دل نبود"
  },
  {
    "poem_id": 1832,
    "vorder": 118,
    "position": 1,
    "text": "که آن رسم را خود نباید ستود"
  },
  {
    "poem_id": 1832,
    "vorder": 119,
    "position": 0,
    "text": "به شمشیر و داد این جهان داشتن"
  },
  {
    "poem_id": 1832,
    "vorder": 120,
    "position": 1,
    "text": "چنین رفتن و خوار بگذاشتن"
  },
  {
    "poem_id": 1832,
    "vorder": 121,
    "position": 0,
    "text": "بپرسید با هر کسی پیش ازین"
  },
  {
    "poem_id": 1832,
    "vorder": 122,
    "position": 1,
    "text": "سخن راندی نامور بیش ازین"
  },
  {
    "poem_id": 1832,
    "vorder": 123,
    "position": 0,
    "text": "سبک دارد اکنون نگوید سخن"
  },
  {
    "poem_id": 1832,
    "vorder": 124,
    "position": 1,
    "text": "نه از نو نه از روزگار کهن"
  },
  {
    "poem_id": 1832,
    "vorder": 125,
    "position": 0,
    "text": "چنین داد پاسخ که گفتار بس"
  },
  {
    "poem_id": 1832,
    "vorder": 126,
    "position": 1,
    "text": "به کردار جویم همه دسترس"
  },
  {
    "poem_id": 1832,
    "vorder": 127,
    "position": 0,
    "text": "بپرسید هنگام شاهان نماز"
  },
  {
    "poem_id": 1832,
    "vorder": 128,
    "position": 1,
    "text": "نبودی چنین پیش ایشان دراز"
  },
  {
    "poem_id": 1832,
    "vorder": 129,
    "position": 0,
    "text": "شما را ستایش فزونست ازان"
  },
  {
    "poem_id": 1832,
    "vorder": 130,
    "position": 1,
    "text": "خروش و نیایش فزون‌ست ازان"
  },
  {
    "poem_id": 1832,
    "vorder": 131,
    "position": 0,
    "text": "چنین داد پاسخ که یزدان پاک"
  },
  {
    "poem_id": 1832,
    "vorder": 132,
    "position": 1,
    "text": "پرستنده را سر برآرد ز خاک"
  },
  {
    "poem_id": 1832,
    "vorder": 133,
    "position": 0,
    "text": "فلک را گزارنده او کند"
  },
  {
    "poem_id": 1832,
    "vorder": 134,
    "position": 1,
    "text": "جهان را همه بندهٔ او کند"
  },
  {
    "poem_id": 1832,
    "vorder": 135,
    "position": 0,
    "text": "گر این بنده آن را نداند بها"
  },
  {
    "poem_id": 1832,
    "vorder": 136,
    "position": 1,
    "text": "مبادا ز درد و ز سختی رها"
  },
  {
    "poem_id": 1832,
    "vorder": 137,
    "position": 0,
    "text": "بپرسید تا تو شدی شهریار"
  },
  {
    "poem_id": 1832,
    "vorder": 138,
    "position": 1,
    "text": "سپاست فزون چیست از کردگار"
  },
  {
    "poem_id": 1832,
    "vorder": 139,
    "position": 0,
    "text": "کزان مر تو را دانش افزون شده‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 140,
    "position": 1,
    "text": "دل بدسگالان پر از خون شده‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 141,
    "position": 0,
    "text": "چنین داد پاسخ که از کردگار"
  },
  {
    "poem_id": 1832,
    "vorder": 142,
    "position": 1,
    "text": "سپاس آنک گشتیم به روزگار"
  },
  {
    "poem_id": 1832,
    "vorder": 143,
    "position": 0,
    "text": "کسی پیش من بر فزونی نجست"
  },
  {
    "poem_id": 1832,
    "vorder": 144,
    "position": 1,
    "text": "وز آواز من دست بد را بشست"
  },
  {
    "poem_id": 1832,
    "vorder": 145,
    "position": 0,
    "text": "زبون بود بدخواه در جنگ من"
  },
  {
    "poem_id": 1832,
    "vorder": 146,
    "position": 1,
    "text": "چو گوپال من دید و اورنگ من"
  },
  {
    "poem_id": 1832,
    "vorder": 147,
    "position": 0,
    "text": "بپرسید در جنگ خاور بُدی"
  },
  {
    "poem_id": 1832,
    "vorder": 148,
    "position": 1,
    "text": "چنان تیز چنگ و دلاور بدی"
  },
  {
    "poem_id": 1832,
    "vorder": 149,
    "position": 0,
    "text": "چو با باختر ساختی ساز جنگ"
  },
  {
    "poem_id": 1832,
    "vorder": 150,
    "position": 1,
    "text": "شکیبایی آراستی با درنگ"
  },
  {
    "poem_id": 1832,
    "vorder": 151,
    "position": 0,
    "text": "چنین داد پاسخ که مرد جوان"
  },
  {
    "poem_id": 1832,
    "vorder": 152,
    "position": 1,
    "text": "نیندیشد از رنج و درد روان"
  },
  {
    "poem_id": 1832,
    "vorder": 153,
    "position": 0,
    "text": "هرآنگه که سال اندر آید به شست"
  },
  {
    "poem_id": 1832,
    "vorder": 154,
    "position": 1,
    "text": "به پیش مدارا بباید نشست"
  },
  {
    "poem_id": 1832,
    "vorder": 155,
    "position": 0,
    "text": "سپاس از جهاندار پروردگار"
  },
  {
    "poem_id": 1832,
    "vorder": 156,
    "position": 1,
    "text": "کزویست نیک و بد روزگار"
  },
  {
    "poem_id": 1832,
    "vorder": 157,
    "position": 0,
    "text": "که روز جوانی هنر داشتیم"
  },
  {
    "poem_id": 1832,
    "vorder": 158,
    "position": 1,
    "text": "بد و نیک را خوار نگذاشتیم"
  },
  {
    "poem_id": 1832,
    "vorder": 159,
    "position": 0,
    "text": "کنون روز پیری به دانندگی"
  },
  {
    "poem_id": 1832,
    "vorder": 160,
    "position": 1,
    "text": "به رای و به گنج و فشانندگی"
  },
  {
    "poem_id": 1832,
    "vorder": 161,
    "position": 0,
    "text": "جهان زیر آیین و فرهنگ ماست"
  },
  {
    "poem_id": 1832,
    "vorder": 162,
    "position": 1,
    "text": "سپهر روان جوشن جنگ ماست"
  },
  {
    "poem_id": 1832,
    "vorder": 163,
    "position": 0,
    "text": "بدو گفت شاهان پیشین دراز"
  },
  {
    "poem_id": 1832,
    "vorder": 164,
    "position": 1,
    "text": "سخن خواستند آشکارا و راز"
  },
  {
    "poem_id": 1832,
    "vorder": 165,
    "position": 0,
    "text": "شما را سخن کمتر و داد بیش"
  },
  {
    "poem_id": 1832,
    "vorder": 166,
    "position": 1,
    "text": "فزون داری از نامداران پیش"
  },
  {
    "poem_id": 1832,
    "vorder": 167,
    "position": 0,
    "text": "چنین داد پاسخ که هر شهریار"
  },
  {
    "poem_id": 1832,
    "vorder": 168,
    "position": 1,
    "text": "که باشد ورا یار پروردگار"
  },
  {
    "poem_id": 1832,
    "vorder": 169,
    "position": 0,
    "text": "ندارد تن خویش با رنج و درد"
  },
  {
    "poem_id": 1832,
    "vorder": 170,
    "position": 1,
    "text": "جهان را نگهبان هرآنکس که کرد"
  },
  {
    "poem_id": 1832,
    "vorder": 171,
    "position": 0,
    "text": "بپرسید شادان دل شهریار"
  },
  {
    "poem_id": 1832,
    "vorder": 172,
    "position": 1,
    "text": "پر اندیشه بینم بدین روزگار"
  },
  {
    "poem_id": 1832,
    "vorder": 173,
    "position": 0,
    "text": "چنین داد پاسخ که بیم گزند"
  },
  {
    "poem_id": 1832,
    "vorder": 174,
    "position": 1,
    "text": "ندارد به دل مردم هوشمند"
  },
  {
    "poem_id": 1832,
    "vorder": 175,
    "position": 0,
    "text": "بدو گفت شاهان پیشین ز بزم"
  },
  {
    "poem_id": 1832,
    "vorder": 176,
    "position": 1,
    "text": "نبردند جان را به‌اندازه رزم"
  },
  {
    "poem_id": 1832,
    "vorder": 177,
    "position": 0,
    "text": "چنین داد پاسخ که ایشان ز جام"
  },
  {
    "poem_id": 1832,
    "vorder": 178,
    "position": 1,
    "text": "نکردند هرگز به دل یاد نام"
  },
  {
    "poem_id": 1832,
    "vorder": 179,
    "position": 0,
    "text": "مرا نام بر جام چیره شده‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 180,
    "position": 1,
    "text": "روانم زمان‌را پذیره شده‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 181,
    "position": 0,
    "text": "بپرسید هرکس که شاهان بدند"
  },
  {
    "poem_id": 1832,
    "vorder": 182,
    "position": 1,
    "text": "تن خویشتن را نگهبان بدند"
  },
  {
    "poem_id": 1832,
    "vorder": 183,
    "position": 0,
    "text": "به دارو و درمان و کار پزشک"
  },
  {
    "poem_id": 1832,
    "vorder": 184,
    "position": 1,
    "text": "بدان تا نپالود باید سرشک"
  },
  {
    "poem_id": 1832,
    "vorder": 185,
    "position": 0,
    "text": "چنین داد پاسخ که تن بی‌زمان"
  },
  {
    "poem_id": 1832,
    "vorder": 186,
    "position": 1,
    "text": "که پیش آید از گردش آسمان"
  },
  {
    "poem_id": 1832,
    "vorder": 187,
    "position": 0,
    "text": "بجایست دارو نیاید به کار"
  },
  {
    "poem_id": 1832,
    "vorder": 188,
    "position": 1,
    "text": "نگه داردش گردش روزگار"
  },
  {
    "poem_id": 1832,
    "vorder": 189,
    "position": 0,
    "text": "چو هنگامه رفتن آمد فراز"
  },
  {
    "poem_id": 1832,
    "vorder": 190,
    "position": 1,
    "text": "زمانه نگردد به پرهیز باز"
  },
  {
    "poem_id": 1832,
    "vorder": 191,
    "position": 0,
    "text": "بپرسید چندان ستایش کنند"
  },
  {
    "poem_id": 1832,
    "vorder": 192,
    "position": 1,
    "text": "جهان‌آفرین را نیایش کنند"
  },
  {
    "poem_id": 1832,
    "vorder": 193,
    "position": 0,
    "text": "زمانی نباشد بدان شادمان"
  },
  {
    "poem_id": 1832,
    "vorder": 194,
    "position": 1,
    "text": "به اندیشه دارد همیشه روان"
  },
  {
    "poem_id": 1832,
    "vorder": 195,
    "position": 0,
    "text": "چنین داد پاسخ که اندیشه نیست"
  },
  {
    "poem_id": 1832,
    "vorder": 196,
    "position": 1,
    "text": "دل شاه با چرخ گردان یکی‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 197,
    "position": 0,
    "text": "بترسم که هرکو ستایش کند"
  },
  {
    "poem_id": 1832,
    "vorder": 198,
    "position": 1,
    "text": "مگر بیم ما را نیایش کند"
  },
  {
    "poem_id": 1832,
    "vorder": 199,
    "position": 0,
    "text": "ستایش نشاید فزون زآنک هست"
  },
  {
    "poem_id": 1832,
    "vorder": 200,
    "position": 1,
    "text": "نجوییم راز دل زیردست"
  },
  {
    "poem_id": 1832,
    "vorder": 201,
    "position": 0,
    "text": "بدو گفت شادی ز فرزند چیست"
  },
  {
    "poem_id": 1832,
    "vorder": 202,
    "position": 1,
    "text": "همان آرزوها ز پیوند چیست"
  },
  {
    "poem_id": 1832,
    "vorder": 203,
    "position": 0,
    "text": "چنین داد پاسخ که هرکو جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 204,
    "position": 1,
    "text": "به فرزند ماند نگردد نهان"
  },
  {
    "poem_id": 1832,
    "vorder": 205,
    "position": 0,
    "text": "چو فرزند باشد بیابد مزه"
  },
  {
    "poem_id": 1832,
    "vorder": 206,
    "position": 1,
    "text": "ز بهر مزه دور گردد بزه"
  },
  {
    "poem_id": 1832,
    "vorder": 207,
    "position": 0,
    "text": "وگر بگذرد کم بود درد اوی"
  },
  {
    "poem_id": 1832,
    "vorder": 208,
    "position": 1,
    "text": "که فرزند بیند رخ زرد اوی"
  },
  {
    "poem_id": 1832,
    "vorder": 209,
    "position": 0,
    "text": "بپرسد که گیتی تن آسان کراست"
  },
  {
    "poem_id": 1832,
    "vorder": 210,
    "position": 1,
    "text": "ز کردار نیکو پشیمان چراست"
  },
  {
    "poem_id": 1832,
    "vorder": 211,
    "position": 0,
    "text": "چنین داد پاسخ که یزدان‌پرست"
  },
  {
    "poem_id": 1832,
    "vorder": 212,
    "position": 1,
    "text": "بگیرد عنان زمانه به‌دست"
  },
  {
    "poem_id": 1832,
    "vorder": 213,
    "position": 0,
    "text": "فزونی نجوید تن‌آسان شود"
  },
  {
    "poem_id": 1832,
    "vorder": 214,
    "position": 1,
    "text": "چو بیشی سگالد هراسان شود"
  },
  {
    "poem_id": 1832,
    "vorder": 215,
    "position": 0,
    "text": "دگر آنک گفتی ز کردار نیک"
  },
  {
    "poem_id": 1832,
    "vorder": 216,
    "position": 1,
    "text": "نهان دل و جان به بازار نیک"
  },
  {
    "poem_id": 1832,
    "vorder": 217,
    "position": 0,
    "text": "ز گیتی زبون‌تر مر آن را شناس"
  },
  {
    "poem_id": 1832,
    "vorder": 218,
    "position": 1,
    "text": "که نیکی سگالید با ناسپاس"
  },
  {
    "poem_id": 1832,
    "vorder": 219,
    "position": 0,
    "text": "بپرسید کان کس که بد کرد و مرد"
  },
  {
    "poem_id": 1832,
    "vorder": 220,
    "position": 1,
    "text": "ز دیوان جهان نام او را سترد"
  },
  {
    "poem_id": 1832,
    "vorder": 221,
    "position": 0,
    "text": "هران کس که نیکی کند بگذرد"
  },
  {
    "poem_id": 1832,
    "vorder": 222,
    "position": 1,
    "text": "زمانه نفس را همی‌بشمرد"
  },
  {
    "poem_id": 1832,
    "vorder": 223,
    "position": 0,
    "text": "چه باید همی نیکویی را ستود"
  },
  {
    "poem_id": 1832,
    "vorder": 224,
    "position": 1,
    "text": "چو مرگ آمد و نیک و بد را درود"
  },
  {
    "poem_id": 1832,
    "vorder": 225,
    "position": 0,
    "text": "چنین داد پاسخ که کردار نیک"
  },
  {
    "poem_id": 1832,
    "vorder": 226,
    "position": 1,
    "text": "بیابد به هر جای بازار نیک"
  },
  {
    "poem_id": 1832,
    "vorder": 227,
    "position": 0,
    "text": "نمرد آنکه او نیک کردار مرد"
  },
  {
    "poem_id": 1832,
    "vorder": 228,
    "position": 1,
    "text": "بیاسود و جان را به یزدان سپرد"
  },
  {
    "poem_id": 1832,
    "vorder": 229,
    "position": 0,
    "text": "وزان کس که ماند همی نام بد"
  },
  {
    "poem_id": 1832,
    "vorder": 230,
    "position": 1,
    "text": "از آغاز بد بود و فرجام بد"
  },
  {
    "poem_id": 1832,
    "vorder": 231,
    "position": 0,
    "text": "نیاسود هرکس کزو باز ماند"
  },
  {
    "poem_id": 1832,
    "vorder": 232,
    "position": 1,
    "text": "وزو در زمانه بد آواز ماند"
  },
  {
    "poem_id": 1832,
    "vorder": 233,
    "position": 0,
    "text": "بپرسد چه کارست برتر ز مرگ"
  },
  {
    "poem_id": 1832,
    "vorder": 234,
    "position": 1,
    "text": "اگر باشد این را چه سازیم برگ"
  },
  {
    "poem_id": 1832,
    "vorder": 235,
    "position": 0,
    "text": "چنین داد پاسخ کزین تیره خاک"
  },
  {
    "poem_id": 1832,
    "vorder": 236,
    "position": 1,
    "text": "اگر بگذری یافتی جان پاک"
  },
  {
    "poem_id": 1832,
    "vorder": 237,
    "position": 0,
    "text": "هرآنکس که در بیم و اندوه زیست"
  },
  {
    "poem_id": 1832,
    "vorder": 238,
    "position": 1,
    "text": "بران زندگی زار باید گریست"
  },
  {
    "poem_id": 1832,
    "vorder": 239,
    "position": 0,
    "text": "بپرسد کزین دو گران‌تر کدام"
  },
  {
    "poem_id": 1832,
    "vorder": 240,
    "position": 1,
    "text": "کزوییم پر درد و ناشادکام"
  },
  {
    "poem_id": 1832,
    "vorder": 241,
    "position": 0,
    "text": "چنین داد پاسخ که هم‌سنگ کوه"
  },
  {
    "poem_id": 1832,
    "vorder": 242,
    "position": 1,
    "text": "جز اندوه مشمر که گردد ستوه"
  },
  {
    "poem_id": 1832,
    "vorder": 243,
    "position": 0,
    "text": "چه بیمست اگر بیم اندوه نیست"
  },
  {
    "poem_id": 1832,
    "vorder": 244,
    "position": 1,
    "text": "به گیتی جز اندوه نستوه نیست"
  },
  {
    "poem_id": 1832,
    "vorder": 245,
    "position": 0,
    "text": "بپرسید کز ما که با گنج‌تر"
  },
  {
    "poem_id": 1832,
    "vorder": 246,
    "position": 1,
    "text": "چنین گفت کان کس که بی‌رنج‌تر"
  },
  {
    "poem_id": 1832,
    "vorder": 247,
    "position": 0,
    "text": "بپرسید که او کدامست زشت"
  },
  {
    "poem_id": 1832,
    "vorder": 248,
    "position": 1,
    "text": "که از ارج دورست و دور از بهشت"
  },
  {
    "poem_id": 1832,
    "vorder": 249,
    "position": 0,
    "text": "چنین داد پاسخ که زن‌را که شرم"
  },
  {
    "poem_id": 1832,
    "vorder": 250,
    "position": 1,
    "text": "نباشد به گیتی نه آواز نرم"
  },
  {
    "poem_id": 1832,
    "vorder": 251,
    "position": 0,
    "text": "ز مردان بتر آنک نادان بود"
  },
  {
    "poem_id": 1832,
    "vorder": 252,
    "position": 1,
    "text": "همه زندگانی به زندان بود"
  },
  {
    "poem_id": 1832,
    "vorder": 253,
    "position": 0,
    "text": "بگرود به یزدان و تن پرگناه"
  },
  {
    "poem_id": 1832,
    "vorder": 254,
    "position": 1,
    "text": "بدی بر دل خویش کرده سیاه"
  },
  {
    "poem_id": 1832,
    "vorder": 255,
    "position": 0,
    "text": "بپرسید مردم کدامست راست"
  },
  {
    "poem_id": 1832,
    "vorder": 256,
    "position": 1,
    "text": "که جان و خرد بر دل او گواست"
  },
  {
    "poem_id": 1832,
    "vorder": 257,
    "position": 0,
    "text": "چنین گفت کانکو به سود و زیان"
  },
  {
    "poem_id": 1832,
    "vorder": 258,
    "position": 1,
    "text": "نگوید نبندد بدی را میان"
  },
  {
    "poem_id": 1832,
    "vorder": 259,
    "position": 0,
    "text": "بپرسید کزو خو چه نیکوترست"
  },
  {
    "poem_id": 1832,
    "vorder": 260,
    "position": 1,
    "text": "که آن بر سر مردمان افسر‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 261,
    "position": 0,
    "text": "چنین داد پاسخ که چون بردبار"
  },
  {
    "poem_id": 1832,
    "vorder": 262,
    "position": 1,
    "text": "بود مرد نایدش افسون به کار"
  },
  {
    "poem_id": 1832,
    "vorder": 263,
    "position": 0,
    "text": "نه آن کز پی سودمندی کند"
  },
  {
    "poem_id": 1832,
    "vorder": 264,
    "position": 1,
    "text": "وگر نیز رای بلندی کند"
  },
  {
    "poem_id": 1832,
    "vorder": 265,
    "position": 0,
    "text": "چو رادی که پاداش رادی نجست"
  },
  {
    "poem_id": 1832,
    "vorder": 266,
    "position": 1,
    "text": "ببخشید و تاریکی از دل بشست"
  },
  {
    "poem_id": 1832,
    "vorder": 267,
    "position": 0,
    "text": "سه دیگر چو کوشایی ایزدی"
  },
  {
    "poem_id": 1832,
    "vorder": 268,
    "position": 1,
    "text": "که از جان پاک آید و بخردی"
  },
  {
    "poem_id": 1832,
    "vorder": 269,
    "position": 0,
    "text": "بپرسید در دل هراس از چه بیش"
  },
  {
    "poem_id": 1832,
    "vorder": 270,
    "position": 1,
    "text": "بدو گفت کز رنج و کردار خویش"
  },
  {
    "poem_id": 1832,
    "vorder": 271,
    "position": 0,
    "text": "بپرسید بخشش کدامست به"
  },
  {
    "poem_id": 1832,
    "vorder": 272,
    "position": 1,
    "text": "که بخشنده گردد سرافراز و مه"
  },
  {
    "poem_id": 1832,
    "vorder": 273,
    "position": 0,
    "text": "چنین داد پاسخ کز ارزانیان"
  },
  {
    "poem_id": 1832,
    "vorder": 274,
    "position": 1,
    "text": "مدارید باز ایچ سود و زیان"
  },
  {
    "poem_id": 1832,
    "vorder": 275,
    "position": 0,
    "text": "بپرسید موبد ز کار جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 276,
    "position": 1,
    "text": "سخن برگشاد آشکار و نهان"
  },
  {
    "poem_id": 1832,
    "vorder": 277,
    "position": 0,
    "text": "که آیین کژ بینم و ناپسند"
  },
  {
    "poem_id": 1832,
    "vorder": 278,
    "position": 1,
    "text": "دگر گردش کار ناسودمند"
  },
  {
    "poem_id": 1832,
    "vorder": 279,
    "position": 0,
    "text": "چنین داد پاسخ که زین چرخ پیر"
  },
  {
    "poem_id": 1832,
    "vorder": 280,
    "position": 1,
    "text": "اگر هست بادانش و یادگیر"
  },
  {
    "poem_id": 1832,
    "vorder": 281,
    "position": 0,
    "text": "بزرگست و داننده و برترست"
  },
  {
    "poem_id": 1832,
    "vorder": 282,
    "position": 1,
    "text": "که بر داوران جهان داورست"
  },
  {
    "poem_id": 1832,
    "vorder": 283,
    "position": 0,
    "text": "بد آیین مشو دور باش از پسند"
  },
  {
    "poem_id": 1832,
    "vorder": 284,
    "position": 1,
    "text": "مبین ایچ ازو سود و ناسودمند"
  },
  {
    "poem_id": 1832,
    "vorder": 285,
    "position": 0,
    "text": "بد و نیک از او دان کش انباز نیست"
  },
  {
    "poem_id": 1832,
    "vorder": 286,
    "position": 1,
    "text": "به کاریش فرجام و آغاز نیست"
  },
  {
    "poem_id": 1832,
    "vorder": 287,
    "position": 0,
    "text": "چو گوید بباش آنچ گوید بدست"
  },
  {
    "poem_id": 1832,
    "vorder": 288,
    "position": 1,
    "text": "همو بود تا بود و تا هست هست"
  },
  {
    "poem_id": 1832,
    "vorder": 289,
    "position": 0,
    "text": "بپرسید کز درد بر کیست رنج"
  },
  {
    "poem_id": 1832,
    "vorder": 290,
    "position": 1,
    "text": "که تن چون سرایست و جان را سپنج"
  },
  {
    "poem_id": 1832,
    "vorder": 291,
    "position": 0,
    "text": "چنین داد پاسخ که این پوده پوست"
  },
  {
    "poem_id": 1832,
    "vorder": 292,
    "position": 1,
    "text": "بود رنجه چندانک مغز اندروست"
  },
  {
    "poem_id": 1832,
    "vorder": 293,
    "position": 0,
    "text": "چو پالود زو جان ندارد خرد"
  },
  {
    "poem_id": 1832,
    "vorder": 294,
    "position": 1,
    "text": "که بر خاک باشد چو جان بگذرد"
  },
  {
    "poem_id": 1832,
    "vorder": 295,
    "position": 0,
    "text": "بپرسید موبد ز پرهیز و گفت"
  },
  {
    "poem_id": 1832,
    "vorder": 296,
    "position": 1,
    "text": "که آز و نیاز از که باید نهفت"
  },
  {
    "poem_id": 1832,
    "vorder": 297,
    "position": 0,
    "text": "چنین داد پاسخ که آز و نیاز"
  },
  {
    "poem_id": 1832,
    "vorder": 298,
    "position": 1,
    "text": "سزد گر ندارد خردمند باز"
  },
  {
    "poem_id": 1832,
    "vorder": 299,
    "position": 0,
    "text": "تو از آز باشی همیشه به رنج"
  },
  {
    "poem_id": 1832,
    "vorder": 300,
    "position": 1,
    "text": "که همواره سیری نیابی ز گنج"
  },
  {
    "poem_id": 1832,
    "vorder": 301,
    "position": 0,
    "text": "بپرسید کز شهریاران که بیش"
  },
  {
    "poem_id": 1832,
    "vorder": 302,
    "position": 1,
    "text": "به هوش و به آیین و با رای و کیش"
  },
  {
    "poem_id": 1832,
    "vorder": 303,
    "position": 0,
    "text": "چنین داد پاسخ که آن پادشا"
  },
  {
    "poem_id": 1832,
    "vorder": 304,
    "position": 1,
    "text": "که باشد پرستنده و پارسا"
  },
  {
    "poem_id": 1832,
    "vorder": 305,
    "position": 0,
    "text": "ز دادار دارنده دارد سپاس"
  },
  {
    "poem_id": 1832,
    "vorder": 306,
    "position": 1,
    "text": "نباشد کس از رنج او در هراس"
  },
  {
    "poem_id": 1832,
    "vorder": 307,
    "position": 0,
    "text": "پرامید دارد دل نیک‌مرد"
  },
  {
    "poem_id": 1832,
    "vorder": 308,
    "position": 1,
    "text": "دل بدکنش را پر از بیم و درد"
  },
  {
    "poem_id": 1832,
    "vorder": 309,
    "position": 0,
    "text": "سپه را بیاراید از گنج خویش"
  },
  {
    "poem_id": 1832,
    "vorder": 310,
    "position": 1,
    "text": "سوی بدسگال افگند رنج خویش"
  },
  {
    "poem_id": 1832,
    "vorder": 311,
    "position": 0,
    "text": "سخن پرسد از بخردان جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 312,
    "position": 1,
    "text": "بد و نیک دارد ز دشمن نهان"
  },
  {
    "poem_id": 1832,
    "vorder": 313,
    "position": 0,
    "text": "بپرسید کار پرستش به چیست"
  },
  {
    "poem_id": 1832,
    "vorder": 314,
    "position": 1,
    "text": "به نیکی یزدان گراینده کیست"
  },
  {
    "poem_id": 1832,
    "vorder": 315,
    "position": 0,
    "text": "چنین داد پاسخ که تاریک‌خوی"
  },
  {
    "poem_id": 1832,
    "vorder": 316,
    "position": 1,
    "text": "روان اندر آرد به باریک موی"
  },
  {
    "poem_id": 1832,
    "vorder": 317,
    "position": 0,
    "text": "نخست آنک داند که هست و یکی‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 318,
    "position": 1,
    "text": "ترا زین نشان رهنمای اندکی‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 319,
    "position": 0,
    "text": "ازو دارد از کار نیکی سپاس"
  },
  {
    "poem_id": 1832,
    "vorder": 320,
    "position": 1,
    "text": "بدو باشد ایمن و زو در هراس"
  },
  {
    "poem_id": 1832,
    "vorder": 321,
    "position": 0,
    "text": "هراس تو آنگه که جویی گزند"
  },
  {
    "poem_id": 1832,
    "vorder": 322,
    "position": 1,
    "text": "وزو ایمنی چون بود سودمند"
  },
  {
    "poem_id": 1832,
    "vorder": 323,
    "position": 0,
    "text": "وگر نیک‌دل باشی و راه‌جوی"
  },
  {
    "poem_id": 1832,
    "vorder": 324,
    "position": 1,
    "text": "بود نزد هر کس تو را آبروی"
  },
  {
    "poem_id": 1832,
    "vorder": 325,
    "position": 0,
    "text": "وگر بدکنش باشی و بد تنه"
  },
  {
    "poem_id": 1832,
    "vorder": 326,
    "position": 1,
    "text": "به دوزخ فرستاده باشی بنه"
  },
  {
    "poem_id": 1832,
    "vorder": 327,
    "position": 0,
    "text": "مباش ایچ گستاخ با این جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 328,
    "position": 1,
    "text": "که او راز خویش از تو دارد نهان"
  },
  {
    "poem_id": 1832,
    "vorder": 329,
    "position": 0,
    "text": "گراینده باشی به کردار دین"
  },
  {
    "poem_id": 1832,
    "vorder": 330,
    "position": 1,
    "text": "بداری بدین روزگار گزین"
  },
  {
    "poem_id": 1832,
    "vorder": 331,
    "position": 0,
    "text": "خرد را کنی با دل آموزگار"
  },
  {
    "poem_id": 1832,
    "vorder": 332,
    "position": 1,
    "text": "بکوشی که نفریبدت روزگار"
  },
  {
    "poem_id": 1832,
    "vorder": 333,
    "position": 0,
    "text": "همان نیز یاد گنهکار مرد"
  },
  {
    "poem_id": 1832,
    "vorder": 334,
    "position": 1,
    "text": "نباشی به بازار ننگ و نبرد"
  },
  {
    "poem_id": 1832,
    "vorder": 335,
    "position": 0,
    "text": "غم آن جهان از پی این جهان"
  },
  {
    "poem_id": 1832,
    "vorder": 336,
    "position": 1,
    "text": "نباید که داری به دل در نهان"
  },
  {
    "poem_id": 1832,
    "vorder": 337,
    "position": 0,
    "text": "نشستنت همواره با بخردان"
  },
  {
    "poem_id": 1832,
    "vorder": 338,
    "position": 1,
    "text": "گراینده رامش جاودان"
  },
  {
    "poem_id": 1832,
    "vorder": 339,
    "position": 0,
    "text": "گراینده بادی به فرهنگ و رای"
  },
  {
    "poem_id": 1832,
    "vorder": 340,
    "position": 1,
    "text": "به یزدان خرد بایدت رهنمای"
  },
  {
    "poem_id": 1832,
    "vorder": 341,
    "position": 0,
    "text": "از اندازه بر نگذرانی سخن"
  },
  {
    "poem_id": 1832,
    "vorder": 342,
    "position": 1,
    "text": "که تو نو به کاری گیتی کهن"
  },
  {
    "poem_id": 1832,
    "vorder": 343,
    "position": 0,
    "text": "نگرداندت رامش و رود مست"
  },
  {
    "poem_id": 1832,
    "vorder": 344,
    "position": 1,
    "text": "نباشدت با مردم بد نشست"
  },
  {
    "poem_id": 1832,
    "vorder": 345,
    "position": 0,
    "text": "بپیچی دل از هرچ نابودنی‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 346,
    "position": 1,
    "text": "ببخشای آن را که بخشودنی‌ست"
  },
  {
    "poem_id": 1832,
    "vorder": 347,
    "position": 0,
    "text": "نداری دریغ آنچه داری ز دوست"
  },
  {
    "poem_id": 1832,
    "vorder": 348,
    "position": 1,
    "text": "اگر دیده خواهد اگر مغز و پوست"
  },
  {
    "poem_id": 1832,
    "vorder": 349,
    "position": 0,
    "text": "اگر دوست با دوست گیرد شمار"
  },
  {
    "poem_id": 1832,
    "vorder": 350,
    "position": 1,
    "text": "نباید که باشد میانجی به کار"
  },
  {
    "poem_id": 1832,
    "vorder": 351,
    "position": 0,
    "text": "چو با مرد بدخواه باشد نشست"
  },
  {
    "poem_id": 1832,
    "vorder": 352,
    "position": 1,
    "text": "چنان کن که نگشاید او بر تو دست"
  },
  {
    "poem_id": 1832,
    "vorder": 353,
    "position": 0,
    "text": "چو جوید کسی راه بایستگی"
  },
  {
    "poem_id": 1832,
    "vorder": 354,
    "position": 1,
    "text": "هنر باید و شرم و شایستگی"
  },
  {
    "poem_id": 1832,
    "vorder": 355,
    "position": 0,
    "text": "نباید زبان از هنر چیره‌تر"
  },
  {
    "poem_id": 1832,
    "vorder": 356,
    "position": 1,
    "text": "دروغ از هنر نشمرد دادگر"
  },
  {
    "poem_id": 1832,
    "vorder": 357,
    "position": 0,
    "text": "نداند کسی را بزرگی به چیز"
  },
  {
    "poem_id": 1832,
    "vorder": 358,
    "position": 1,
    "text": "نه خواری به ناچیز دارد بنیز"
  },
  {
    "poem_id": 1832,
    "vorder": 359,
    "position": 0,
    "text": "اگر بدگمانی گشاید زبان"
  },
  {
    "poem_id": 1832,
    "vorder": 360,
    "position": 1,
    "text": "تو تندی مکن هیچ با بدگمان"
  },
  {
    "poem_id": 1832,
    "vorder": 361,
    "position": 0,
    "text": "ازان پس چو سستی گمانی برد"
  },
  {
    "poem_id": 1832,
    "vorder": 362,
    "position": 1,
    "text": "وز اندازه گفتار او بگذرد"
  },
  {
    "poem_id": 1832,
    "vorder": 363,
    "position": 0,
    "text": "تو پاسخ مر او را به اندازه گوی"
  },
  {
    "poem_id": 1832,
    "vorder": 364,
    "position": 1,
    "text": "سخن‌های چرب آور و تازه گوی"
  },
  {
    "poem_id": 1832,
    "vorder": 365,
    "position": 0,
    "text": "به آزرم اگر بفگنی سوی خویش"
  },
  {
    "poem_id": 1832,
    "vorder": 366,
    "position": 1,
    "text": "پشیمانی آید به فرجام پیش"
  },
  {
    "poem_id": 1832,
    "vorder": 367,
    "position": 0,
    "text": "چو بیکار باشی مشو رامشی"
  },
  {
    "poem_id": 1832,
    "vorder": 368,
    "position": 1,
    "text": "نه کارست بیکاری ار باهشی"
  },
  {
    "poem_id": 1832,
    "vorder": 369,
    "position": 0,
    "text": "ز هرکار کردن تو را ننگ نیست"
  },
  {
    "poem_id": 1832,
    "vorder": 370,
    "position": 1,
    "text": "اگر چند با بوی و با رنگ نیست"
  },
  {
    "poem_id": 1832,
    "vorder": 371,
    "position": 0,
    "text": "به نیکی به هر کار کوشا بود"
  },
  {
    "poem_id": 1832,
    "vorder": 372,
    "position": 1,
    "text": "همیشه به دانش نیوشا بود"
  },
  {
    "poem_id": 1832,
    "vorder": 373,
    "position": 0,
    "text": "به کاری نیازد که فرجام اوی"
  },
  {
    "poem_id": 1832,
    "vorder": 374,
    "position": 1,
    "text": "پشیمانی و تندی آرد به روی"
  },
  {
    "poem_id": 1832,
    "vorder": 375,
    "position": 0,
    "text": "ببخشاید از درد بر مستمند"
  },
  {
    "poem_id": 1832,
    "vorder": 376,
    "position": 1,
    "text": "نیارد دلش سوی درد و گزند"
  },
  {
    "poem_id": 1832,
    "vorder": 377,
    "position": 0,
    "text": "خردمند کو دل کند بردبار"
  },
  {
    "poem_id": 1832,
    "vorder": 378,
    "position": 1,
    "text": "نباشد به چشم جهاندار خوار"
  },
  {
    "poem_id": 1832,
    "vorder": 379,
    "position": 0,
    "text": "بداند که چندست با او هنر"
  },
  {
    "poem_id": 1832,
    "vorder": 380,
    "position": 1,
    "text": "به اندازه یابد ز هر کار بر"
  },
  {
    "poem_id": 1832,
    "vorder": 381,
    "position": 0,
    "text": "گر افزون ازان دوست بستایدش"
  },
  {
    "poem_id": 1832,
    "vorder": 382,
    "position": 1,
    "text": "بلندی و کژی بیفزایدش"
  },
  {
    "poem_id": 1832,
    "vorder": 383,
    "position": 0,
    "text": "همان مرد ایزد ندارد به رنج"
  },
  {
    "poem_id": 1832,
    "vorder": 384,
    "position": 1,
    "text": "وگر چند گردد پراگنده گنج"
  },
  {
    "poem_id": 1832,
    "vorder": 385,
    "position": 0,
    "text": "پرستش کند پیشه و راستی"
  },
  {
    "poem_id": 1832,
    "vorder": 386,
    "position": 1,
    "text": "بپیچد ز بی‌راهی و کاستی"
  },
  {
    "poem_id": 1832,
    "vorder": 387,
    "position": 0,
    "text": "برین برگ واین شاخها آخت دست"
  },
  {
    "poem_id": 1832,
    "vorder": 388,
    "position": 1,
    "text": "هنرمند دینی و یزدان‌پرست"
  },
  {
    "poem_id": 1832,
    "vorder": 389,
    "position": 0,
    "text": "همانست رای و همینست راه"
  },
  {
    "poem_id": 1832,
    "vorder": 390,
    "position": 1,
    "text": "به یزدان گرای و به یزدان پناه"
  },
  {
    "poem_id": 1832,
    "vorder": 391,
    "position": 0,
    "text": "اگر دادگر باشدی شهریار"
  },
  {
    "poem_id": 1832,
    "vorder": 392,
    "position": 1,
    "text": "ازو ماند اندر جهان یادگار"
  },
  {
    "poem_id": 1832,
    "vorder": 393,
    "position": 0,
    "text": "چنان هم که از داد نوشین‌روان"
  },
  {
    "poem_id": 1832,
    "vorder": 394,
    "position": 1,
    "text": "کجا خاک شد نام ماندش جوان"
  }
