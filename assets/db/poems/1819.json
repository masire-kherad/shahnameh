[
  {
    "poem_id": 1819,
    "vorder": 1,
    "position": 0,
    "text": "چو بنشست با سوگ ماهی بلاش"
  },
  {
    "poem_id": 1819,
    "vorder": 2,
    "position": 1,
    "text": "سرش پر ز گرد و رخش پرخراش"
  },
  {
    "poem_id": 1819,
    "vorder": 3,
    "position": 0,
    "text": "سپاه آمد و موبد موبدان"
  },
  {
    "poem_id": 1819,
    "vorder": 4,
    "position": 1,
    "text": "هر آنکس که بود از رد و بخردان"
  },
  {
    "poem_id": 1819,
    "vorder": 5,
    "position": 0,
    "text": "فراوان بگفتند با او ز پند"
  },
  {
    "poem_id": 1819,
    "vorder": 6,
    "position": 1,
    "text": "سخنها که بودی ورا سودمند"
  },
  {
    "poem_id": 1819,
    "vorder": 7,
    "position": 0,
    "text": "بران تخت شاهیش بنشاندند"
  },
  {
    "poem_id": 1819,
    "vorder": 8,
    "position": 1,
    "text": "بسی زر و گوهر برافشاندند"
  },
  {
    "poem_id": 1819,
    "vorder": 9,
    "position": 0,
    "text": "چو بنشست بر گاه گفت ای ردان"
  },
  {
    "poem_id": 1819,
    "vorder": 10,
    "position": 1,
    "text": "بجویید رای و دل بخردان"
  },
  {
    "poem_id": 1819,
    "vorder": 11,
    "position": 0,
    "text": "شما را بزرگیست نزدیک من"
  },
  {
    "poem_id": 1819,
    "vorder": 12,
    "position": 1,
    "text": "چو روشن شود رای تاریک من"
  },
  {
    "poem_id": 1819,
    "vorder": 13,
    "position": 0,
    "text": "به گیتی هر آنکس که نیکی کند"
  },
  {
    "poem_id": 1819,
    "vorder": 14,
    "position": 1,
    "text": "بکوشد که تا رای ما نشکند"
  },
  {
    "poem_id": 1819,
    "vorder": 15,
    "position": 0,
    "text": "هر آنکس کجا باشد او بدسگال"
  },
  {
    "poem_id": 1819,
    "vorder": 16,
    "position": 1,
    "text": "که خواهد همی کار خود را همال"
  },
  {
    "poem_id": 1819,
    "vorder": 17,
    "position": 0,
    "text": "نخستین به پندش توانگر کنم"
  },
  {
    "poem_id": 1819,
    "vorder": 18,
    "position": 1,
    "text": "چو نپذیرد از خونش افسر کنم"
  },
  {
    "poem_id": 1819,
    "vorder": 19,
    "position": 0,
    "text": "هرآنگه که زین لشکر دین‌پرست"
  },
  {
    "poem_id": 1819,
    "vorder": 20,
    "position": 1,
    "text": "بنالد بر ما یکی زیردست"
  },
  {
    "poem_id": 1819,
    "vorder": 21,
    "position": 0,
    "text": "دل مرد بیدادگر بشکنم"
  },
  {
    "poem_id": 1819,
    "vorder": 22,
    "position": 1,
    "text": "همه بیخ و شاخش ز بن برکنم"
  },
  {
    "poem_id": 1819,
    "vorder": 23,
    "position": 0,
    "text": "مباشید گستاخ با پادشا"
  },
  {
    "poem_id": 1819,
    "vorder": 24,
    "position": 1,
    "text": "بویژه کسی کو بود پارسا"
  },
  {
    "poem_id": 1819,
    "vorder": 25,
    "position": 0,
    "text": "که او گاه زهرست و گه پای‌زهر"
  },
  {
    "poem_id": 1819,
    "vorder": 26,
    "position": 1,
    "text": "مجویید از زهر تریاک بهر"
  },
  {
    "poem_id": 1819,
    "vorder": 27,
    "position": 0,
    "text": "ز گیتی تو خوشنودی شاه‌جوی"
  },
  {
    "poem_id": 1819,
    "vorder": 28,
    "position": 1,
    "text": "مشو پیش تختش مگر تازه‌روی"
  },
  {
    "poem_id": 1819,
    "vorder": 29,
    "position": 0,
    "text": "چو خشم آورد شاه پوزش گزین"
  },
  {
    "poem_id": 1819,
    "vorder": 30,
    "position": 1,
    "text": "همی خوان به بیداد و دادآفرین"
  },
  {
    "poem_id": 1819,
    "vorder": 31,
    "position": 0,
    "text": "هرآنگه که گویی که دانا شدم"
  },
  {
    "poem_id": 1819,
    "vorder": 32,
    "position": 1,
    "text": "به هر دانشی بر توانا شدم"
  },
  {
    "poem_id": 1819,
    "vorder": 33,
    "position": 0,
    "text": "چنان دان که نادان‌تری آن زمان"
  },
  {
    "poem_id": 1819,
    "vorder": 34,
    "position": 1,
    "text": "مشو بر تن خویش بر بدگمان"
  },
  {
    "poem_id": 1819,
    "vorder": 35,
    "position": 0,
    "text": "وگر کار بندید پند مرا"
  },
  {
    "poem_id": 1819,
    "vorder": 36,
    "position": 1,
    "text": "سخن گفتن سودمند مرا"
  },
  {
    "poem_id": 1819,
    "vorder": 37,
    "position": 0,
    "text": "ز شاهان داننده یابید گنج"
  },
  {
    "poem_id": 1819,
    "vorder": 38,
    "position": 1,
    "text": "کسی را ز دانش ندیدم به رنج"
  },
  {
    "poem_id": 1819,
    "vorder": 39,
    "position": 0,
    "text": "برو مهتران آفرین خواندند"
  },
  {
    "poem_id": 1819,
    "vorder": 40,
    "position": 1,
    "text": "ز دانایی او فرو ماندند"
  },
  {
    "poem_id": 1819,
    "vorder": 41,
    "position": 0,
    "text": "برفتند خشنود ز ایوان اوی"
  },
  {
    "poem_id": 1819,
    "vorder": 42,
    "position": 1,
    "text": "به یزدان سپرده تن و جان اوی"
  },
  {
    "poem_id": 1819,
    "vorder": 43,
    "position": 0,
    "text": "بدآنگه که پیروز شد سوی جنگ"
  },
  {
    "poem_id": 1819,
    "vorder": 44,
    "position": 1,
    "text": "یکی پهلوان جست با رای و سنگ"
  },
  {
    "poem_id": 1819,
    "vorder": 45,
    "position": 0,
    "text": "که باشد نگهبان تخت و کلاه"
  },
  {
    "poem_id": 1819,
    "vorder": 46,
    "position": 1,
    "text": "بلاش جوان را بود نیکخواه"
  },
  {
    "poem_id": 1819,
    "vorder": 47,
    "position": 0,
    "text": "بدان کار شایسته بد سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 48,
    "position": 1,
    "text": "یکی نامور بود پاکیزه‌رای"
  },
  {
    "poem_id": 1819,
    "vorder": 49,
    "position": 0,
    "text": "جهاندیده از شهر شیراز بود"
  },
  {
    "poem_id": 1819,
    "vorder": 50,
    "position": 1,
    "text": "سپهبددل و گردن‌افراز بود"
  },
  {
    "poem_id": 1819,
    "vorder": 51,
    "position": 0,
    "text": "هم او مرزبان بد بزابلستان"
  },
  {
    "poem_id": 1819,
    "vorder": 52,
    "position": 1,
    "text": "ببست و بغزنین و کابلستان"
  },
  {
    "poem_id": 1819,
    "vorder": 53,
    "position": 0,
    "text": "چو آگاهی آمد سوی سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 54,
    "position": 1,
    "text": "ز پیروز بی‌رای و بی‌رهنمای"
  },
  {
    "poem_id": 1819,
    "vorder": 55,
    "position": 0,
    "text": "ز مژگان سرشکش به رخ برچکید"
  },
  {
    "poem_id": 1819,
    "vorder": 56,
    "position": 1,
    "text": "همه جامهٔ پهلوی بردرید"
  },
  {
    "poem_id": 1819,
    "vorder": 57,
    "position": 0,
    "text": "ز سر برگرفتند گردان کلاه"
  },
  {
    "poem_id": 1819,
    "vorder": 58,
    "position": 1,
    "text": "به ماتم نشستند با سوگ شاه"
  },
  {
    "poem_id": 1819,
    "vorder": 59,
    "position": 0,
    "text": "همی‌گفت بر کینهٔ شهریار"
  },
  {
    "poem_id": 1819,
    "vorder": 60,
    "position": 1,
    "text": "بلاش جوان چون بود خواستار"
  },
  {
    "poem_id": 1819,
    "vorder": 61,
    "position": 0,
    "text": "بدانست کان کار بی‌سود شد"
  },
  {
    "poem_id": 1819,
    "vorder": 62,
    "position": 1,
    "text": "سر تاج شاهی پر از دود شد"
  },
  {
    "poem_id": 1819,
    "vorder": 63,
    "position": 0,
    "text": "سپاه پراگنده را گرد کرد"
  },
  {
    "poem_id": 1819,
    "vorder": 64,
    "position": 1,
    "text": "بزد کوس وز دشت برخاست گرد"
  },
  {
    "poem_id": 1819,
    "vorder": 65,
    "position": 0,
    "text": "فراز آمدش تیغزن صد هزار"
  },
  {
    "poem_id": 1819,
    "vorder": 66,
    "position": 1,
    "text": "همه جنگجوی از در کارزار"
  },
  {
    "poem_id": 1819,
    "vorder": 67,
    "position": 0,
    "text": "درم داد و آن لشکر آباد کرد"
  },
  {
    "poem_id": 1819,
    "vorder": 68,
    "position": 1,
    "text": "دل مردم کینه‌ور شاد کرد"
  },
  {
    "poem_id": 1819,
    "vorder": 69,
    "position": 0,
    "text": "فرستاده‌ای خواند شیرین‌زبان"
  },
  {
    "poem_id": 1819,
    "vorder": 70,
    "position": 1,
    "text": "خردمند و بیدار و روشن‌روان"
  },
  {
    "poem_id": 1819,
    "vorder": 71,
    "position": 0,
    "text": "یکی نامه بنوشت پر داغ و درد"
  },
  {
    "poem_id": 1819,
    "vorder": 72,
    "position": 1,
    "text": "دو دیده پر از آب و رخسار زرد"
  },
  {
    "poem_id": 1819,
    "vorder": 73,
    "position": 0,
    "text": "به نامه درون پندها یاد داد"
  },
  {
    "poem_id": 1819,
    "vorder": 74,
    "position": 1,
    "text": "ز جمشید و کیخسرو کیقباد"
  },
  {
    "poem_id": 1819,
    "vorder": 75,
    "position": 0,
    "text": "وزان پس فرستاد نزد بلاش"
  },
  {
    "poem_id": 1819,
    "vorder": 76,
    "position": 1,
    "text": "که شاها تو از مرگ غمگین مباش"
  },
  {
    "poem_id": 1819,
    "vorder": 77,
    "position": 0,
    "text": "که این مرگ هر کس نخواهد چشید"
  },
  {
    "poem_id": 1819,
    "vorder": 78,
    "position": 1,
    "text": "شکیبایی و نام باید گزید"
  },
  {
    "poem_id": 1819,
    "vorder": 79,
    "position": 0,
    "text": "ز باد آمده باز گردد بدم"
  },
  {
    "poem_id": 1819,
    "vorder": 80,
    "position": 1,
    "text": "یکی داد خواندش و دیگر ستم"
  },
  {
    "poem_id": 1819,
    "vorder": 81,
    "position": 0,
    "text": "کنون من به دستوری شهریار"
  },
  {
    "poem_id": 1819,
    "vorder": 82,
    "position": 1,
    "text": "بسیجم برین گونه بر کارزار"
  },
  {
    "poem_id": 1819,
    "vorder": 83,
    "position": 0,
    "text": "کزین کینه و خون پیروز شاه"
  },
  {
    "poem_id": 1819,
    "vorder": 84,
    "position": 1,
    "text": "بنالد ز چرخ روان هور و ماه"
  },
  {
    "poem_id": 1819,
    "vorder": 85,
    "position": 0,
    "text": "فرستاده زین روی برداشت پای"
  },
  {
    "poem_id": 1819,
    "vorder": 86,
    "position": 1,
    "text": "وزان سوی گریان بشد باز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 87,
    "position": 0,
    "text": "بیاراست لشکر چو پر تذرو"
  },
  {
    "poem_id": 1819,
    "vorder": 88,
    "position": 1,
    "text": "بیامد ز زاولستان سوی مرو"
  },
  {
    "poem_id": 1819,
    "vorder": 89,
    "position": 0,
    "text": "یکی مرد بگزید بیداردل"
  },
  {
    "poem_id": 1819,
    "vorder": 90,
    "position": 1,
    "text": "که آهسته دارد به گفتار دل"
  },
  {
    "poem_id": 1819,
    "vorder": 91,
    "position": 0,
    "text": "نویسندهٔ نامه را گفت خیز"
  },
  {
    "poem_id": 1819,
    "vorder": 92,
    "position": 1,
    "text": "که آمد سر خامه را رستخیز"
  },
  {
    "poem_id": 1819,
    "vorder": 93,
    "position": 0,
    "text": "یکی نامه بنویس زی خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 94,
    "position": 1,
    "text": "که ای بی‌خرد روبه دیوساز"
  },
  {
    "poem_id": 1819,
    "vorder": 95,
    "position": 0,
    "text": "گنهکار کردی به یزدان تنت"
  },
  {
    "poem_id": 1819,
    "vorder": 96,
    "position": 1,
    "text": "شود مویه گر بر تو پیراهنت"
  },
  {
    "poem_id": 1819,
    "vorder": 97,
    "position": 0,
    "text": "به شاه آنک تو کردی ای بیوفا"
  },
  {
    "poem_id": 1819,
    "vorder": 98,
    "position": 1,
    "text": "ببینی کنون زور تیغ جفا"
  },
  {
    "poem_id": 1819,
    "vorder": 99,
    "position": 0,
    "text": "به کشتی شهنشاه را بی‌گناه"
  },
  {
    "poem_id": 1819,
    "vorder": 100,
    "position": 1,
    "text": "نبیره جهاندار بهرام شاه"
  },
  {
    "poem_id": 1819,
    "vorder": 101,
    "position": 0,
    "text": "یکی کین نو ساختی در جهان"
  },
  {
    "poem_id": 1819,
    "vorder": 102,
    "position": 1,
    "text": "که آن کینه هرگز نگردد نهان"
  },
  {
    "poem_id": 1819,
    "vorder": 103,
    "position": 0,
    "text": "چرا پیش او چون یکی چابلوس"
  },
  {
    "poem_id": 1819,
    "vorder": 104,
    "position": 1,
    "text": "نرفتی چو برخاست آوای کوس"
  },
  {
    "poem_id": 1819,
    "vorder": 105,
    "position": 0,
    "text": "نیای تو زین خاندان زنده بود"
  },
  {
    "poem_id": 1819,
    "vorder": 106,
    "position": 1,
    "text": "پدر پیش بهرام پاینده بود"
  },
  {
    "poem_id": 1819,
    "vorder": 107,
    "position": 0,
    "text": "من اینک به مرو آمدم کینه‌خواه"
  },
  {
    "poem_id": 1819,
    "vorder": 108,
    "position": 1,
    "text": "نماند به هیتالیان تاج و گاه"
  },
  {
    "poem_id": 1819,
    "vorder": 109,
    "position": 0,
    "text": "اسیران و آن خواسته هرچ هست"
  },
  {
    "poem_id": 1819,
    "vorder": 110,
    "position": 1,
    "text": "که از رزمگاه آمدستت بدست"
  },
  {
    "poem_id": 1819,
    "vorder": 111,
    "position": 0,
    "text": "همه بازخواهم به شمشیر کین"
  },
  {
    "poem_id": 1819,
    "vorder": 112,
    "position": 1,
    "text": "به مرو آورم خاک توران زمین"
  },
  {
    "poem_id": 1819,
    "vorder": 113,
    "position": 0,
    "text": "نمانم جهان را بفرزند تو"
  },
  {
    "poem_id": 1819,
    "vorder": 114,
    "position": 1,
    "text": "نه بر دوده و خویش و پیوند تو"
  },
  {
    "poem_id": 1819,
    "vorder": 115,
    "position": 0,
    "text": "بفرمان یزدان ببرم سرت"
  },
  {
    "poem_id": 1819,
    "vorder": 116,
    "position": 1,
    "text": "ز خون همچو دریا کنم کشورت"
  },
  {
    "poem_id": 1819,
    "vorder": 117,
    "position": 0,
    "text": "نه کین باشد این چند گویم دراز"
  },
  {
    "poem_id": 1819,
    "vorder": 118,
    "position": 1,
    "text": "که از کین پیروز با خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 119,
    "position": 0,
    "text": "شود زیر خاک پی من تباه"
  },
  {
    "poem_id": 1819,
    "vorder": 120,
    "position": 1,
    "text": "به یزدان روانش بود دادخواه"
  },
  {
    "poem_id": 1819,
    "vorder": 121,
    "position": 0,
    "text": "فرستاده با نامهٔ سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 122,
    "position": 1,
    "text": "بیامد چو شیر دلاور ز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 123,
    "position": 0,
    "text": "چو آشفته آمد بر خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 124,
    "position": 1,
    "text": "بشد پیش تخت و ببردش نماز"
  },
  {
    "poem_id": 1819,
    "vorder": 125,
    "position": 0,
    "text": "بدو داد پس نامهٔ سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 126,
    "position": 1,
    "text": "همی‌بود یک چند پیشش بپای"
  },
  {
    "poem_id": 1819,
    "vorder": 127,
    "position": 0,
    "text": "نویسندهٔ نامه را داد و گفت"
  },
  {
    "poem_id": 1819,
    "vorder": 128,
    "position": 1,
    "text": "که پنهان بگوی آنچ نرمست و زفت"
  },
  {
    "poem_id": 1819,
    "vorder": 129,
    "position": 0,
    "text": "به مهتر چنین گفت مرد دبیر"
  },
  {
    "poem_id": 1819,
    "vorder": 130,
    "position": 1,
    "text": "که این نامه پر گرز و تیغست و تیر"
  },
  {
    "poem_id": 1819,
    "vorder": 131,
    "position": 0,
    "text": "شکسته شد آن مرد جنگ‌آزمای"
  },
  {
    "poem_id": 1819,
    "vorder": 132,
    "position": 1,
    "text": "ازان پر سخن نامهٔ سوفزار"
  },
  {
    "poem_id": 1819,
    "vorder": 133,
    "position": 0,
    "text": "هم اندر زمان زود پاسخ نبشت"
  },
  {
    "poem_id": 1819,
    "vorder": 134,
    "position": 1,
    "text": "سخن هرچ بود اندرو خوب و زشت"
  },
  {
    "poem_id": 1819,
    "vorder": 135,
    "position": 0,
    "text": "نخستین چنین گفت کز کردگار"
  },
  {
    "poem_id": 1819,
    "vorder": 136,
    "position": 1,
    "text": "بترسیم وز گردش روزگار"
  },
  {
    "poem_id": 1819,
    "vorder": 137,
    "position": 0,
    "text": "که هر کس که بودست یزدان‌پرست"
  },
  {
    "poem_id": 1819,
    "vorder": 138,
    "position": 1,
    "text": "نیاورد در عهد شاهان شکست"
  },
  {
    "poem_id": 1819,
    "vorder": 139,
    "position": 0,
    "text": "فرستادمش نامهٔ پندمند"
  },
  {
    "poem_id": 1819,
    "vorder": 140,
    "position": 1,
    "text": "دگر عهد آن شهریار بلند"
  },
  {
    "poem_id": 1819,
    "vorder": 141,
    "position": 0,
    "text": "برو خوار بود آنچ گفتم سخن"
  },
  {
    "poem_id": 1819,
    "vorder": 142,
    "position": 1,
    "text": "هم اندیشهٔ روزگار کهن"
  },
  {
    "poem_id": 1819,
    "vorder": 143,
    "position": 0,
    "text": "چو او کینه‌ور گشت و من چاره‌جوی"
  },
  {
    "poem_id": 1819,
    "vorder": 144,
    "position": 1,
    "text": "سپه را چو روی اندر آمد به روی"
  },
  {
    "poem_id": 1819,
    "vorder": 145,
    "position": 0,
    "text": "به پیروز بر اختر آشفته شد"
  },
  {
    "poem_id": 1819,
    "vorder": 146,
    "position": 1,
    "text": "نه برکام من شاه تو کشته شد"
  },
  {
    "poem_id": 1819,
    "vorder": 147,
    "position": 0,
    "text": "چو بشکست پیمان شاهان داد"
  },
  {
    "poem_id": 1819,
    "vorder": 148,
    "position": 1,
    "text": "نبود از جوانیش یک روز شاد"
  },
  {
    "poem_id": 1819,
    "vorder": 149,
    "position": 0,
    "text": "نیامد پسند جهان‌آفرین"
  },
  {
    "poem_id": 1819,
    "vorder": 150,
    "position": 1,
    "text": "تو گویی که بگرفت پایش زمین"
  },
  {
    "poem_id": 1819,
    "vorder": 151,
    "position": 0,
    "text": "هر آنکس که عهد نیا بشکند"
  },
  {
    "poem_id": 1819,
    "vorder": 152,
    "position": 1,
    "text": "سر راستی را بپای افگند"
  },
  {
    "poem_id": 1819,
    "vorder": 153,
    "position": 0,
    "text": "چو پیروز باشد به دشت نبرد"
  },
  {
    "poem_id": 1819,
    "vorder": 154,
    "position": 1,
    "text": "شکسته بکنده درون پر ز گرد"
  },
  {
    "poem_id": 1819,
    "vorder": 155,
    "position": 0,
    "text": "گر آیی تو ایدر هم آراستست"
  },
  {
    "poem_id": 1819,
    "vorder": 156,
    "position": 1,
    "text": "نه جنگ و نه جنگ‌آوران کاستست"
  },
  {
    "poem_id": 1819,
    "vorder": 157,
    "position": 0,
    "text": "فرستاده با نامه تازان ز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 158,
    "position": 1,
    "text": "به یک هفته آمد سوی سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 159,
    "position": 0,
    "text": "چو برخواند آن نامه را پهلوان"
  },
  {
    "poem_id": 1819,
    "vorder": 160,
    "position": 1,
    "text": "به دشنام بگشاد گویا زبان"
  },
  {
    "poem_id": 1819,
    "vorder": 161,
    "position": 0,
    "text": "ز میدان خروشیدن گاودم"
  },
  {
    "poem_id": 1819,
    "vorder": 162,
    "position": 1,
    "text": "شنیدند و آوای رویینه خم"
  },
  {
    "poem_id": 1819,
    "vorder": 163,
    "position": 0,
    "text": "بکش میهن آورد چندان سپاه"
  },
  {
    "poem_id": 1819,
    "vorder": 164,
    "position": 1,
    "text": "که بر چرخ خورشید گم کرد راه"
  },
  {
    "poem_id": 1819,
    "vorder": 165,
    "position": 0,
    "text": "برین همنشان روز بگذاشتند"
  },
  {
    "poem_id": 1819,
    "vorder": 166,
    "position": 1,
    "text": "همی راه را خانه پنداشتند"
  },
  {
    "poem_id": 1819,
    "vorder": 167,
    "position": 0,
    "text": "چو آگاهی آمد سوی خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 168,
    "position": 1,
    "text": "به دشت آمد و جنگ را کرد ساز"
  },
  {
    "poem_id": 1819,
    "vorder": 169,
    "position": 0,
    "text": "به پیکند شد رزمگاهی گزید"
  },
  {
    "poem_id": 1819,
    "vorder": 170,
    "position": 1,
    "text": "که چرخ روان روی هامون ندید"
  },
  {
    "poem_id": 1819,
    "vorder": 171,
    "position": 0,
    "text": "وزین روی پر کینه دل سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 172,
    "position": 1,
    "text": "به کردار باد اندر آمد ز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 173,
    "position": 0,
    "text": "چو شب تیره شد پهلوان سپاه"
  },
  {
    "poem_id": 1819,
    "vorder": 174,
    "position": 1,
    "text": "به پیلان آسوده بربست راه"
  },
  {
    "poem_id": 1819,
    "vorder": 175,
    "position": 0,
    "text": "طلایه همی‌گشت بر هر دو سوی"
  },
  {
    "poem_id": 1819,
    "vorder": 176,
    "position": 1,
    "text": "جهان شد پر آواز پرخاشجوی"
  },
  {
    "poem_id": 1819,
    "vorder": 177,
    "position": 0,
    "text": "غو پاسبانان و بانگ جرس"
  },
  {
    "poem_id": 1819,
    "vorder": 178,
    "position": 1,
    "text": "همی‌آمد از دور بر پیش و پس"
  },
  {
    "poem_id": 1819,
    "vorder": 179,
    "position": 0,
    "text": "چنین تا پدید آمد از میغ شید"
  },
  {
    "poem_id": 1819,
    "vorder": 180,
    "position": 1,
    "text": "در و دشت شد چون بلور سپید"
  },
  {
    "poem_id": 1819,
    "vorder": 181,
    "position": 0,
    "text": "دو لشکر همی جنگ را ساختند"
  },
  {
    "poem_id": 1819,
    "vorder": 182,
    "position": 1,
    "text": "درفش بزرگی برافراختند"
  },
  {
    "poem_id": 1819,
    "vorder": 183,
    "position": 0,
    "text": "از آواز گردان پرخاشخر"
  },
  {
    "poem_id": 1819,
    "vorder": 184,
    "position": 1,
    "text": "بدرید مر اژدها را جگر"
  },
  {
    "poem_id": 1819,
    "vorder": 185,
    "position": 0,
    "text": "هوا دام کرکس شد از پر تیر"
  },
  {
    "poem_id": 1819,
    "vorder": 186,
    "position": 1,
    "text": "زمین شد ز خون سران آبگیر"
  },
  {
    "poem_id": 1819,
    "vorder": 187,
    "position": 0,
    "text": "ز هر سو ز مردان تلی کشته بود"
  },
  {
    "poem_id": 1819,
    "vorder": 188,
    "position": 1,
    "text": "کرا از جهان روز برگشته بود"
  },
  {
    "poem_id": 1819,
    "vorder": 189,
    "position": 0,
    "text": "بجنبید بر قلبگه سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 190,
    "position": 1,
    "text": "یکایک سپاه اندر آمد ز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 191,
    "position": 0,
    "text": "وزان روی با تیغ کین خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 192,
    "position": 1,
    "text": "بپیچید و آمد به تنگی فراز"
  },
  {
    "poem_id": 1819,
    "vorder": 193,
    "position": 0,
    "text": "یکی تیغ زد بر سرش سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 194,
    "position": 1,
    "text": "سپاه اندر آمد به تندی ز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 195,
    "position": 0,
    "text": "بجست از کف تیغزن خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 196,
    "position": 1,
    "text": "به شیب اندر انداخت اسب از فراز"
  },
  {
    "poem_id": 1819,
    "vorder": 197,
    "position": 0,
    "text": "بدید آنک شد روزگارش درشت"
  },
  {
    "poem_id": 1819,
    "vorder": 198,
    "position": 1,
    "text": "عنان را بپیچید و بنمود پشت"
  },
  {
    "poem_id": 1819,
    "vorder": 199,
    "position": 0,
    "text": "چو باد دمان از پسش سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 200,
    "position": 1,
    "text": "همی‌تاخت با نیزهٔ سرگرای"
  },
  {
    "poem_id": 1819,
    "vorder": 201,
    "position": 0,
    "text": "بسی کرد زان نامداران اسیر"
  },
  {
    "poem_id": 1819,
    "vorder": 202,
    "position": 1,
    "text": "بسی کشته شد هم بپیکان و تیر"
  },
  {
    "poem_id": 1819,
    "vorder": 203,
    "position": 0,
    "text": "همی‌تاخت تا پیش لشکر رسید"
  },
  {
    "poem_id": 1819,
    "vorder": 204,
    "position": 1,
    "text": "بره بر بسی کشته و خسته دید"
  },
  {
    "poem_id": 1819,
    "vorder": 205,
    "position": 0,
    "text": "ز بالا نگه کرد پس خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 206,
    "position": 1,
    "text": "سپه را به هامون نشیب و فراز"
  },
  {
    "poem_id": 1819,
    "vorder": 207,
    "position": 0,
    "text": "همه دشت پرکشته و خواسته"
  },
  {
    "poem_id": 1819,
    "vorder": 208,
    "position": 1,
    "text": "شده دشت چون چرخ آراسته"
  },
  {
    "poem_id": 1819,
    "vorder": 209,
    "position": 0,
    "text": "سلیح و کمرها و اسب و رهی"
  },
  {
    "poem_id": 1819,
    "vorder": 210,
    "position": 1,
    "text": "ستام و سنان و کلاه مهی"
  },
  {
    "poem_id": 1819,
    "vorder": 211,
    "position": 0,
    "text": "همی‌برد هر کس بر سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 212,
    "position": 1,
    "text": "تلی گشته چون کوه البرز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 213,
    "position": 0,
    "text": "ببخشید یکسر همه بر سپاه"
  },
  {
    "poem_id": 1819,
    "vorder": 214,
    "position": 1,
    "text": "نکرد اندر آن چیز ترکان نگاه"
  },
  {
    "poem_id": 1819,
    "vorder": 215,
    "position": 0,
    "text": "به لشکر چنین گفت کامروز کار"
  },
  {
    "poem_id": 1819,
    "vorder": 216,
    "position": 1,
    "text": "به کام ما بد از روزگار"
  },
  {
    "poem_id": 1819,
    "vorder": 217,
    "position": 0,
    "text": "چو خورشید بنماید از چرخ دست"
  },
  {
    "poem_id": 1819,
    "vorder": 218,
    "position": 1,
    "text": "برین دشت خیره نباید نشست"
  },
  {
    "poem_id": 1819,
    "vorder": 219,
    "position": 0,
    "text": "به کین شهنشاه ایران شویم"
  },
  {
    "poem_id": 1819,
    "vorder": 220,
    "position": 1,
    "text": "برین دز به کردار شیران شویم"
  },
  {
    "poem_id": 1819,
    "vorder": 221,
    "position": 0,
    "text": "همه لشکرش دست بر برزدند"
  },
  {
    "poem_id": 1819,
    "vorder": 222,
    "position": 1,
    "text": "همی هر کسی رای دیگر زدند"
  },
  {
    "poem_id": 1819,
    "vorder": 223,
    "position": 0,
    "text": "برین همنشان تا ز خم سپهر"
  },
  {
    "poem_id": 1819,
    "vorder": 224,
    "position": 1,
    "text": "پدید آمد آن زیور تاج مهر"
  },
  {
    "poem_id": 1819,
    "vorder": 225,
    "position": 0,
    "text": "تبیره برآمد ز پرده‌سرای"
  },
  {
    "poem_id": 1819,
    "vorder": 226,
    "position": 1,
    "text": "نشست از بر باره بر سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 227,
    "position": 0,
    "text": "فرستاده‌ای آمد از خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 228,
    "position": 1,
    "text": "به نزدیک سالار گردن‌فراز"
  },
  {
    "poem_id": 1819,
    "vorder": 229,
    "position": 0,
    "text": "که از جنگ و پیکار و خون ریختن"
  },
  {
    "poem_id": 1819,
    "vorder": 230,
    "position": 1,
    "text": "نباشد جز از رنج و آویختن"
  },
  {
    "poem_id": 1819,
    "vorder": 231,
    "position": 0,
    "text": "دو مرد خردمند نیکو گمان"
  },
  {
    "poem_id": 1819,
    "vorder": 232,
    "position": 1,
    "text": "به دوزخ فرستیم هر دو روان"
  },
  {
    "poem_id": 1819,
    "vorder": 233,
    "position": 0,
    "text": "اگر بازجویی ز راه ردی"
  },
  {
    "poem_id": 1819,
    "vorder": 234,
    "position": 1,
    "text": "بدانی که آن کار بد ایزدی"
  },
  {
    "poem_id": 1819,
    "vorder": 235,
    "position": 0,
    "text": "نه بر باد شد کشته پیروزشاه"
  },
  {
    "poem_id": 1819,
    "vorder": 236,
    "position": 1,
    "text": "کز اختر سرآمد بدو سال و ماه"
  },
  {
    "poem_id": 1819,
    "vorder": 237,
    "position": 0,
    "text": "گنهکار شد زانک بشکست عهد"
  },
  {
    "poem_id": 1819,
    "vorder": 238,
    "position": 1,
    "text": "گزین کرد حنظل بینداخت شهد"
  },
  {
    "poem_id": 1819,
    "vorder": 239,
    "position": 0,
    "text": "کنون بودنی بود و بر ما گذشت"
  },
  {
    "poem_id": 1819,
    "vorder": 240,
    "position": 1,
    "text": "خنک آنک گرد گذشته نگشت"
  },
  {
    "poem_id": 1819,
    "vorder": 241,
    "position": 0,
    "text": "اسیران وز خواسته هرچ بود"
  },
  {
    "poem_id": 1819,
    "vorder": 242,
    "position": 1,
    "text": "ز سیم و زر و گوهر نابسود"
  },
  {
    "poem_id": 1819,
    "vorder": 243,
    "position": 0,
    "text": "ز اسب و سلیح و ز تاج و ز تخت"
  },
  {
    "poem_id": 1819,
    "vorder": 244,
    "position": 1,
    "text": "که آن روز بگذاشت پیروزبخت"
  },
  {
    "poem_id": 1819,
    "vorder": 245,
    "position": 0,
    "text": "فرستم همه نزد سالار شاه"
  },
  {
    "poem_id": 1819,
    "vorder": 246,
    "position": 1,
    "text": "سراپرده و گنج و پیل و سپاه"
  },
  {
    "poem_id": 1819,
    "vorder": 247,
    "position": 0,
    "text": "چو پیروزگر سوی ایران شوی"
  },
  {
    "poem_id": 1819,
    "vorder": 248,
    "position": 1,
    "text": "به نزدیک شاه دلیران شوی"
  },
  {
    "poem_id": 1819,
    "vorder": 249,
    "position": 0,
    "text": "نباشد مرا سوی ایران بسیچ"
  },
  {
    "poem_id": 1819,
    "vorder": 250,
    "position": 1,
    "text": "تو از عهد بهرام گردن مپیچ"
  },
  {
    "poem_id": 1819,
    "vorder": 251,
    "position": 0,
    "text": "شهنشاه گیتی ببخشید راست"
  },
  {
    "poem_id": 1819,
    "vorder": 252,
    "position": 1,
    "text": "مرا ترک و چین است و ایران تو راست"
  },
  {
    "poem_id": 1819,
    "vorder": 253,
    "position": 0,
    "text": "چو بشنید پیغام او سوفراز"
  },
  {
    "poem_id": 1819,
    "vorder": 254,
    "position": 1,
    "text": "بیاورد لشکر به پرده‌سرای"
  },
  {
    "poem_id": 1819,
    "vorder": 255,
    "position": 0,
    "text": "فرستاده را گفت پیش سپاه"
  },
  {
    "poem_id": 1819,
    "vorder": 256,
    "position": 1,
    "text": "بگوی آنچ بشنیدی از رزمخواه"
  },
  {
    "poem_id": 1819,
    "vorder": 257,
    "position": 0,
    "text": "بیامد فرستادهٔ خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 258,
    "position": 1,
    "text": "بگفت آنچ بود آشکارا و راز"
  },
  {
    "poem_id": 1819,
    "vorder": 259,
    "position": 0,
    "text": "چنین گفت لشکر که فرمان تو راست"
  },
  {
    "poem_id": 1819,
    "vorder": 260,
    "position": 1,
    "text": "بدین آشتی رای و پیمان تو راست"
  },
  {
    "poem_id": 1819,
    "vorder": 261,
    "position": 0,
    "text": "به ایران نداند کسی از تو به"
  },
  {
    "poem_id": 1819,
    "vorder": 262,
    "position": 1,
    "text": "بما بر تویی شاه و سالار و مه"
  },
  {
    "poem_id": 1819,
    "vorder": 263,
    "position": 0,
    "text": "چنین گفت با سرکشان سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 264,
    "position": 1,
    "text": "که امروز ما را جزین نیست رای"
  },
  {
    "poem_id": 1819,
    "vorder": 265,
    "position": 0,
    "text": "کزیشان ازین پس نجوییم جنگ"
  },
  {
    "poem_id": 1819,
    "vorder": 266,
    "position": 1,
    "text": "به ایران بریم این سپه بی‌درنگ"
  },
  {
    "poem_id": 1819,
    "vorder": 267,
    "position": 0,
    "text": "که در دست ایشان بود کیقباد"
  },
  {
    "poem_id": 1819,
    "vorder": 268,
    "position": 1,
    "text": "چو فرزند پیروز خسرو نژاد"
  },
  {
    "poem_id": 1819,
    "vorder": 269,
    "position": 0,
    "text": "همان موبد موبدان اردشیر"
  },
  {
    "poem_id": 1819,
    "vorder": 270,
    "position": 1,
    "text": "ز لشکر بزرگان برنا و پیر"
  },
  {
    "poem_id": 1819,
    "vorder": 271,
    "position": 0,
    "text": "اگر جنگ سازیم با خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 272,
    "position": 1,
    "text": "شودکار بی‌سود بر ما دراز"
  },
  {
    "poem_id": 1819,
    "vorder": 273,
    "position": 0,
    "text": "کشد آنک دارد ز ایران اسیر"
  },
  {
    "poem_id": 1819,
    "vorder": 274,
    "position": 1,
    "text": "قباد جهانجوی چون اردشیر"
  },
  {
    "poem_id": 1819,
    "vorder": 275,
    "position": 0,
    "text": "اگر نیستی در میانه قباد"
  },
  {
    "poem_id": 1819,
    "vorder": 276,
    "position": 1,
    "text": "ز موبد نکردی دل و مغز یاد"
  },
  {
    "poem_id": 1819,
    "vorder": 277,
    "position": 0,
    "text": "گر او را ز ترکان بد آید بروی"
  },
  {
    "poem_id": 1819,
    "vorder": 278,
    "position": 1,
    "text": "نماند به ایران جز از گفت و گوی"
  },
  {
    "poem_id": 1819,
    "vorder": 279,
    "position": 0,
    "text": "یکی ننگ باشد که تا رستخیز"
  },
  {
    "poem_id": 1819,
    "vorder": 280,
    "position": 1,
    "text": "بماند میان دلیران ستیز"
  },
  {
    "poem_id": 1819,
    "vorder": 281,
    "position": 0,
    "text": "فرستاده را نغز پاسخ دهیم"
  },
  {
    "poem_id": 1819,
    "vorder": 282,
    "position": 1,
    "text": "درین آشتی رای فرخ نهیم"
  },
  {
    "poem_id": 1819,
    "vorder": 283,
    "position": 0,
    "text": "مگر باز بینیم روی قباد"
  },
  {
    "poem_id": 1819,
    "vorder": 284,
    "position": 1,
    "text": "که بی او سر پادشاهی مباد"
  },
  {
    "poem_id": 1819,
    "vorder": 285,
    "position": 0,
    "text": "همان موبد پاکدل اردشیر"
  },
  {
    "poem_id": 1819,
    "vorder": 286,
    "position": 1,
    "text": "کسی را که بینید برنا و پیر"
  },
  {
    "poem_id": 1819,
    "vorder": 287,
    "position": 0,
    "text": "فرستاده را خواند پس پهلوان"
  },
  {
    "poem_id": 1819,
    "vorder": 288,
    "position": 1,
    "text": "سخن گفت با او به شیرین زبان"
  },
  {
    "poem_id": 1819,
    "vorder": 289,
    "position": 0,
    "text": "چنین گفت کاین ایزدی بود و بس"
  },
  {
    "poem_id": 1819,
    "vorder": 290,
    "position": 1,
    "text": "جهان بد سگالد نگوید بکس"
  },
  {
    "poem_id": 1819,
    "vorder": 291,
    "position": 0,
    "text": "بزرگان ایران که هستند اسیر"
  },
  {
    "poem_id": 1819,
    "vorder": 292,
    "position": 1,
    "text": "قبادست با نامدار اردشیر"
  },
  {
    "poem_id": 1819,
    "vorder": 293,
    "position": 0,
    "text": "دگر هر که دارید بر نای بند"
  },
  {
    "poem_id": 1819,
    "vorder": 294,
    "position": 1,
    "text": "فرستید سوی منش ارجمند"
  },
  {
    "poem_id": 1819,
    "vorder": 295,
    "position": 0,
    "text": "دگر خواسته هرچ دارید نیز"
  },
  {
    "poem_id": 1819,
    "vorder": 296,
    "position": 1,
    "text": "ز دینار وز تاج و هرگونه چیز"
  },
  {
    "poem_id": 1819,
    "vorder": 297,
    "position": 0,
    "text": "یکایک فرستید نزدیک من"
  },
  {
    "poem_id": 1819,
    "vorder": 298,
    "position": 1,
    "text": "به پیش بزرگان این انجمن"
  },
  {
    "poem_id": 1819,
    "vorder": 299,
    "position": 0,
    "text": "به تاراج و کشتن نیازیم دست"
  },
  {
    "poem_id": 1819,
    "vorder": 300,
    "position": 1,
    "text": "که ما بی‌نیازیم و یزدان‌پرست"
  },
  {
    "poem_id": 1819,
    "vorder": 301,
    "position": 0,
    "text": "ز جیحون به روز دهم بگذریم"
  },
  {
    "poem_id": 1819,
    "vorder": 302,
    "position": 1,
    "text": "وزان پس پیی خاک را نسپریم"
  },
  {
    "poem_id": 1819,
    "vorder": 303,
    "position": 0,
    "text": "همه هرچ گفتم تو را گوش‌دار"
  },
  {
    "poem_id": 1819,
    "vorder": 304,
    "position": 1,
    "text": "چو رفتی یکایک برو برشمار"
  },
  {
    "poem_id": 1819,
    "vorder": 305,
    "position": 0,
    "text": "فرستاده هم در زمان گشت باز"
  },
  {
    "poem_id": 1819,
    "vorder": 306,
    "position": 1,
    "text": "بیامد گرازان بر خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 307,
    "position": 0,
    "text": "بگفت آنچ بشنید وزو گشت شاد"
  },
  {
    "poem_id": 1819,
    "vorder": 308,
    "position": 1,
    "text": "همانگاه برداشت بند قباد"
  },
  {
    "poem_id": 1819,
    "vorder": 309,
    "position": 0,
    "text": "همان خواسته سر به سر گرد کرد"
  },
  {
    "poem_id": 1819,
    "vorder": 310,
    "position": 1,
    "text": "کجا یافت از خاک و دشت نبرد"
  },
  {
    "poem_id": 1819,
    "vorder": 311,
    "position": 0,
    "text": "همان تخت با تاج پیروز شاه"
  },
  {
    "poem_id": 1819,
    "vorder": 312,
    "position": 1,
    "text": "چو چیز پراگندهٔ آن سپاه"
  },
  {
    "poem_id": 1819,
    "vorder": 313,
    "position": 0,
    "text": "فرستاد یکسر سوی سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 314,
    "position": 1,
    "text": "به دست یکی مرد پاکیزه‌رای"
  },
  {
    "poem_id": 1819,
    "vorder": 315,
    "position": 0,
    "text": "چو لشکر بدیدند روی قباد"
  },
  {
    "poem_id": 1819,
    "vorder": 316,
    "position": 1,
    "text": "ز دیدار او انجمن گشت شاد"
  },
  {
    "poem_id": 1819,
    "vorder": 317,
    "position": 0,
    "text": "بزرگان همه خیمه بگذاشتند"
  },
  {
    "poem_id": 1819,
    "vorder": 318,
    "position": 1,
    "text": "همه دست بر آسمان داشتند"
  },
  {
    "poem_id": 1819,
    "vorder": 319,
    "position": 0,
    "text": "که پور شهنشاه را بی‌گزند"
  },
  {
    "poem_id": 1819,
    "vorder": 320,
    "position": 1,
    "text": "بدیدند با هرک بد ارجمند"
  },
  {
    "poem_id": 1819,
    "vorder": 321,
    "position": 0,
    "text": "همانگه فروهشت پرده‌سرای"
  },
  {
    "poem_id": 1819,
    "vorder": 322,
    "position": 1,
    "text": "سپهبد باسب اندر آورد پای"
  },
  {
    "poem_id": 1819,
    "vorder": 323,
    "position": 0,
    "text": "ز جیحون گذر کرد پیروز و شاد"
  },
  {
    "poem_id": 1819,
    "vorder": 324,
    "position": 1,
    "text": "ابا نامور موبد و کیقباد"
  },
  {
    "poem_id": 1819,
    "vorder": 325,
    "position": 0,
    "text": "چو آگاهی آمد به ایران زمین"
  },
  {
    "poem_id": 1819,
    "vorder": 326,
    "position": 1,
    "text": "ازان نیک‌پی مهتر بفرین"
  },
  {
    "poem_id": 1819,
    "vorder": 327,
    "position": 0,
    "text": "همان جنگ و پیکار با خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 328,
    "position": 1,
    "text": "ز رای چنان مرد نیرنگ‌ساز"
  },
  {
    "poem_id": 1819,
    "vorder": 329,
    "position": 0,
    "text": "همان موبد موبدان اردشیر"
  },
  {
    "poem_id": 1819,
    "vorder": 330,
    "position": 1,
    "text": "اسیران که بودند برنا و پیر"
  },
  {
    "poem_id": 1819,
    "vorder": 331,
    "position": 0,
    "text": "که از جنگ برگشت پیروز و شاد"
  },
  {
    "poem_id": 1819,
    "vorder": 332,
    "position": 1,
    "text": "گشاده شد از بند پای قباد"
  },
  {
    "poem_id": 1819,
    "vorder": 333,
    "position": 0,
    "text": "بیاورد و اکنون ز جیحون گذشت"
  },
  {
    "poem_id": 1819,
    "vorder": 334,
    "position": 1,
    "text": "ز ایران سپاهست بر کوه و دشت"
  },
  {
    "poem_id": 1819,
    "vorder": 335,
    "position": 0,
    "text": "خروشی ز ایران برآمد که گوش"
  },
  {
    "poem_id": 1819,
    "vorder": 336,
    "position": 1,
    "text": "تو گفتی همی کر شود زان خروش"
  },
  {
    "poem_id": 1819,
    "vorder": 337,
    "position": 0,
    "text": "بزرگان فرزانه برخاستند"
  },
  {
    "poem_id": 1819,
    "vorder": 338,
    "position": 1,
    "text": "پذیره شدن را بیاراستند"
  },
  {
    "poem_id": 1819,
    "vorder": 339,
    "position": 0,
    "text": "بلاش آن زمان تخت زرین نهاد"
  },
  {
    "poem_id": 1819,
    "vorder": 340,
    "position": 1,
    "text": "که تا برنشیند برو کیقباد"
  },
  {
    "poem_id": 1819,
    "vorder": 341,
    "position": 0,
    "text": "چو آمد به شهر اندرون سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 342,
    "position": 1,
    "text": "بزرگان برفتند یک سر ز جای"
  },
  {
    "poem_id": 1819,
    "vorder": 343,
    "position": 0,
    "text": "پذیره شدن را بیاراست شاه"
  },
  {
    "poem_id": 1819,
    "vorder": 344,
    "position": 1,
    "text": "همی‌رفت با آنک بودش سپاه"
  },
  {
    "poem_id": 1819,
    "vorder": 345,
    "position": 0,
    "text": "بلاش آن زمان دید روی قباد"
  },
  {
    "poem_id": 1819,
    "vorder": 346,
    "position": 1,
    "text": "رها گشته از بند پیروز و شاد"
  },
  {
    "poem_id": 1819,
    "vorder": 347,
    "position": 0,
    "text": "مر او را سبک شاه در برگرفت"
  },
  {
    "poem_id": 1819,
    "vorder": 348,
    "position": 1,
    "text": "ز هیتال و چین دست بر سر گرفت"
  },
  {
    "poem_id": 1819,
    "vorder": 349,
    "position": 0,
    "text": "ز راه اندر ایوان شاه آمدند"
  },
  {
    "poem_id": 1819,
    "vorder": 350,
    "position": 1,
    "text": "گشاده‌دل و نیک‌خواه آمدند"
  },
  {
    "poem_id": 1819,
    "vorder": 351,
    "position": 0,
    "text": "بفرمود تا خوان بیاراستند"
  },
  {
    "poem_id": 1819,
    "vorder": 352,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1819,
    "vorder": 353,
    "position": 0,
    "text": "همی‌بود جشنی نه بر آرزوی"
  },
  {
    "poem_id": 1819,
    "vorder": 354,
    "position": 1,
    "text": "ز تیمار پیروز آزاده‌خوی"
  },
  {
    "poem_id": 1819,
    "vorder": 355,
    "position": 0,
    "text": "همه چامه گر سوفزا را ستود"
  },
  {
    "poem_id": 1819,
    "vorder": 356,
    "position": 1,
    "text": "ببربط همی رزم ترکان سرود"
  },
  {
    "poem_id": 1819,
    "vorder": 357,
    "position": 0,
    "text": "مهان را همه چشم بر سوفزای"
  },
  {
    "poem_id": 1819,
    "vorder": 358,
    "position": 1,
    "text": "ازو گشته شاد و بدو داده رای"
  },
  {
    "poem_id": 1819,
    "vorder": 359,
    "position": 0,
    "text": "همه شهر ایران بدو گشت باز"
  },
  {
    "poem_id": 1819,
    "vorder": 360,
    "position": 1,
    "text": "کسی را که بد کینهٔ خوشنواز"
  },
  {
    "poem_id": 1819,
    "vorder": 361,
    "position": 0,
    "text": "بدان پهلوان دل همی شاد کرد"
  },
  {
    "poem_id": 1819,
    "vorder": 362,
    "position": 1,
    "text": "روان را ز اندیشه آزاد کرد"
  },
  {
    "poem_id": 1819,
    "vorder": 363,
    "position": 0,
    "text": "ببد سوفزای از جهان بی‌همال"
  },
  {
    "poem_id": 1819,
    "vorder": 364,
    "position": 1,
    "text": "همی‌رفت زین گونه تا چار سال"
  },
  {
    "poem_id": 1819,
    "vorder": 365,
    "position": 0,
    "text": "نبودی جز آن چیز کو خواستی"
  },
  {
    "poem_id": 1819,
    "vorder": 366,
    "position": 1,
    "text": "جهان را به رای خود آراستی"
  },
  {
    "poem_id": 1819,
    "vorder": 367,
    "position": 0,
    "text": "چر فرمان او گشت در شهر فاش"
  },
  {
    "poem_id": 1819,
    "vorder": 368,
    "position": 1,
    "text": "به خوبی بپرداخت گاه از بلاش"
  },
  {
    "poem_id": 1819,
    "vorder": 369,
    "position": 0,
    "text": "بدو گفت شاهی نرانی همی"
  },
  {
    "poem_id": 1819,
    "vorder": 370,
    "position": 1,
    "text": "بدان را ز نیکان ندانی همی"
  },
  {
    "poem_id": 1819,
    "vorder": 371,
    "position": 0,
    "text": "همی پادشاهی به بازی کنی"
  },
  {
    "poem_id": 1819,
    "vorder": 372,
    "position": 1,
    "text": "ز پری وز بی‌نیازی کنی"
  },
  {
    "poem_id": 1819,
    "vorder": 373,
    "position": 0,
    "text": "قباد از تو در کار داناترست"
  },
  {
    "poem_id": 1819,
    "vorder": 374,
    "position": 1,
    "text": "بدین پادشاهی تواناترست"
  },
  {
    "poem_id": 1819,
    "vorder": 375,
    "position": 0,
    "text": "به ایوان خویش اندر آمد بلاش"
  },
  {
    "poem_id": 1819,
    "vorder": 376,
    "position": 1,
    "text": "نیارست گفتن که ایدر مباش"
  },
  {
    "poem_id": 1819,
    "vorder": 377,
    "position": 0,
    "text": "همی‌گفت بی‌رنج تخت این بود"
  },
  {
    "poem_id": 1819,
    "vorder": 378,
    "position": 1,
    "text": "که بی‌کوشش و درد و نفرین بود"
  }
]