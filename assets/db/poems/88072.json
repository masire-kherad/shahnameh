[
  {
    "poem_id": 88072,
    "vorder": 1,
    "position": 0,
    "text": "دگر روز چون خور برآمد ز راغ"
  },
  {
    "poem_id": 88072,
    "vorder": 2,
    "position": 1,
    "text": "نهاد از بر چرخ زرین چراغ"
  },
  {
    "poem_id": 88072,
    "vorder": 3,
    "position": 0,
    "text": "خروشی برآمد بلند از حصار"
  },
  {
    "poem_id": 88072,
    "vorder": 4,
    "position": 1,
    "text": "پر اندیشه شد زان سخن شهریار"
  },
  {
    "poem_id": 88072,
    "vorder": 5,
    "position": 0,
    "text": "همانگه در دژ گشادند باز"
  },
  {
    "poem_id": 88072,
    "vorder": 6,
    "position": 1,
    "text": "برهنه شد از روی پوشیده راز"
  },
  {
    "poem_id": 88072,
    "vorder": 7,
    "position": 0,
    "text": "بیامد ز دژ جهن با ده سوار"
  },
  {
    "poem_id": 88072,
    "vorder": 8,
    "position": 1,
    "text": "خردمند و بادانش و مایه دار"
  },
  {
    "poem_id": 88072,
    "vorder": 9,
    "position": 0,
    "text": "بشد پیش دهلیز پرده سرای"
  },
  {
    "poem_id": 88072,
    "vorder": 10,
    "position": 1,
    "text": "همی بود با نامداران به پای"
  },
  {
    "poem_id": 88072,
    "vorder": 11,
    "position": 0,
    "text": "از آن پس بیامد منوشان گرد"
  },
  {
    "poem_id": 88072,
    "vorder": 12,
    "position": 1,
    "text": "خرد یافته جهن را پیش برد"
  },
  {
    "poem_id": 88072,
    "vorder": 13,
    "position": 0,
    "text": "خردمند چون پیش خسرو رسید"
  },
  {
    "poem_id": 88072,
    "vorder": 14,
    "position": 1,
    "text": "شد از آب دیده رخش ناپدید"
  },
  {
    "poem_id": 88072,
    "vorder": 15,
    "position": 0,
    "text": "بماند اندر او جهن جنگی شگفت"
  },
  {
    "poem_id": 88072,
    "vorder": 16,
    "position": 1,
    "text": "کلاه بزرگی ز سر بر گرفت"
  },
  {
    "poem_id": 88072,
    "vorder": 17,
    "position": 0,
    "text": "چو آمد به نزدیک تختش فراز"
  },
  {
    "poem_id": 88072,
    "vorder": 18,
    "position": 1,
    "text": "بر او آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 88072,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت کای نامور شهریار"
  },
  {
    "poem_id": 88072,
    "vorder": 20,
    "position": 1,
    "text": "همیشه جهان را به شادی گذار"
  },
  {
    "poem_id": 88072,
    "vorder": 21,
    "position": 0,
    "text": "بر و بوم ما بر تو فرخنده باد"
  },
  {
    "poem_id": 88072,
    "vorder": 22,
    "position": 1,
    "text": "دل و چشم بدخواه تو کنده باد"
  },
  {
    "poem_id": 88072,
    "vorder": 23,
    "position": 0,
    "text": "همیشه بدی شاد و یزدان پرست"
  },
  {
    "poem_id": 88072,
    "vorder": 24,
    "position": 1,
    "text": "بر و بوم ما پیش گسترده دست"
  },
  {
    "poem_id": 88072,
    "vorder": 25,
    "position": 0,
    "text": "خجسته شدن باد و باز آمدن"
  },
  {
    "poem_id": 88072,
    "vorder": 26,
    "position": 1,
    "text": "به نیکی همی داستانها زدن"
  },
  {
    "poem_id": 88072,
    "vorder": 27,
    "position": 0,
    "text": "پیامی گزارم ز افراسیاب"
  },
  {
    "poem_id": 88072,
    "vorder": 28,
    "position": 1,
    "text": "اگر شاه را زان نگیرد شتاب"
  },
  {
    "poem_id": 88072,
    "vorder": 29,
    "position": 0,
    "text": "چو از جهن گفتار بشنید شاه"
  },
  {
    "poem_id": 88072,
    "vorder": 30,
    "position": 1,
    "text": "بفرمود زرین یکی پیشگاه"
  },
  {
    "poem_id": 88072,
    "vorder": 31,
    "position": 0,
    "text": "نهادند زیر خردمند مرد"
  },
  {
    "poem_id": 88072,
    "vorder": 32,
    "position": 1,
    "text": "نشست و پیام پدر یاد کرد"
  },
  {
    "poem_id": 88072,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت با شاه کافراسیاب"
  },
  {
    "poem_id": 88072,
    "vorder": 34,
    "position": 1,
    "text": "نشستست پر درد و مژگان پر آب"
  },
  {
    "poem_id": 88072,
    "vorder": 35,
    "position": 0,
    "text": "نخستین درودی رسانم به شاه"
  },
  {
    "poem_id": 88072,
    "vorder": 36,
    "position": 1,
    "text": "از آن داغ دل شاه توران سپاه"
  },
  {
    "poem_id": 88072,
    "vorder": 37,
    "position": 0,
    "text": "که یزدان سپاس و بدویم پناه"
  },
  {
    "poem_id": 88072,
    "vorder": 38,
    "position": 1,
    "text": "که فرزند دیدم بدین پایگاه"
  },
  {
    "poem_id": 88072,
    "vorder": 39,
    "position": 0,
    "text": "که لشکر کشد شهریاری کند"
  },
  {
    "poem_id": 88072,
    "vorder": 40,
    "position": 1,
    "text": "به پیش سواران سواری کند"
  },
  {
    "poem_id": 88072,
    "vorder": 41,
    "position": 0,
    "text": "ز راه پدر شاه تا کیقباد"
  },
  {
    "poem_id": 88072,
    "vorder": 42,
    "position": 1,
    "text": "ز مادر سوی تور دارد نژاد"
  },
  {
    "poem_id": 88072,
    "vorder": 43,
    "position": 0,
    "text": "ز شاهان گیتی سرش برترست"
  },
  {
    "poem_id": 88072,
    "vorder": 44,
    "position": 1,
    "text": "به چین نام او تخت را افسرست"
  },
  {
    "poem_id": 88072,
    "vorder": 45,
    "position": 0,
    "text": "به ابر اندرون تیز پران عقاب"
  },
  {
    "poem_id": 88072,
    "vorder": 46,
    "position": 1,
    "text": "نهنگ دلاور به دریای آب"
  },
  {
    "poem_id": 88072,
    "vorder": 47,
    "position": 0,
    "text": "همه پاسبانان تخت ویند"
  },
  {
    "poem_id": 88072,
    "vorder": 48,
    "position": 1,
    "text": "دد و دام شادان به بخت ویند"
  },
  {
    "poem_id": 88072,
    "vorder": 49,
    "position": 0,
    "text": "بزرگان که با تاج و با زیورند"
  },
  {
    "poem_id": 88072,
    "vorder": 50,
    "position": 1,
    "text": "به روی زمین مر ترا کهترند"
  },
  {
    "poem_id": 88072,
    "vorder": 51,
    "position": 0,
    "text": "شگفتی تر از کار دیو نژند"
  },
  {
    "poem_id": 88072,
    "vorder": 52,
    "position": 1,
    "text": "که هرگز نخواهد به ما جز گزند"
  },
  {
    "poem_id": 88072,
    "vorder": 53,
    "position": 0,
    "text": "بدان مهربانی و آن راستی"
  },
  {
    "poem_id": 88072,
    "vorder": 54,
    "position": 1,
    "text": "چرا شد دل من سوی کاستی"
  },
  {
    "poem_id": 88072,
    "vorder": 55,
    "position": 0,
    "text": "که بر دست من پور کاووس شاه"
  },
  {
    "poem_id": 88072,
    "vorder": 56,
    "position": 1,
    "text": "سیاووش رد کشته شد بی گناه"
  },
  {
    "poem_id": 88072,
    "vorder": 57,
    "position": 0,
    "text": "جگر خسته‌ام ز این سخن پر ز درد"
  },
  {
    "poem_id": 88072,
    "vorder": 58,
    "position": 1,
    "text": "نشسته به یکسو ز خواب و ز خورد"
  },
  {
    "poem_id": 88072,
    "vorder": 59,
    "position": 0,
    "text": "نه من کشتم او را که ناپاک دیو"
  },
  {
    "poem_id": 88072,
    "vorder": 60,
    "position": 1,
    "text": "ببرد از دلم ترس گیهان خدیو"
  },
  {
    "poem_id": 88072,
    "vorder": 61,
    "position": 0,
    "text": "زمانه ورا بد بهانه مرا"
  },
  {
    "poem_id": 88072,
    "vorder": 62,
    "position": 1,
    "text": "به چنگ اندرون بد فسانه مرا"
  },
  {
    "poem_id": 88072,
    "vorder": 63,
    "position": 0,
    "text": "تو اکنون خردمندی و پادشا"
  },
  {
    "poem_id": 88072,
    "vorder": 64,
    "position": 1,
    "text": "پذیرندهٔ مردم پارسا"
  },
  {
    "poem_id": 88072,
    "vorder": 65,
    "position": 0,
    "text": "نگه کن که تا چند شهر فراخ"
  },
  {
    "poem_id": 88072,
    "vorder": 66,
    "position": 1,
    "text": "پر از باغ و ایوان و میدان و کاخ"
  },
  {
    "poem_id": 88072,
    "vorder": 67,
    "position": 0,
    "text": "شدست اندر این کینه جستن خراب"
  },
  {
    "poem_id": 88072,
    "vorder": 68,
    "position": 1,
    "text": "بهانه سیاووش و افراسیاب"
  },
  {
    "poem_id": 88072,
    "vorder": 69,
    "position": 0,
    "text": "همان کارزاری سواران جنگ"
  },
  {
    "poem_id": 88072,
    "vorder": 70,
    "position": 1,
    "text": "به تن همچو پیل و به زور نهنگ"
  },
  {
    "poem_id": 88072,
    "vorder": 71,
    "position": 0,
    "text": "که جز کام شیران کفنشان نبود"
  },
  {
    "poem_id": 88072,
    "vorder": 72,
    "position": 1,
    "text": "سری نیز نزدیک تنشان نبود"
  },
  {
    "poem_id": 88072,
    "vorder": 73,
    "position": 0,
    "text": "یکی منزل اندر بیابان نماند"
  },
  {
    "poem_id": 88072,
    "vorder": 74,
    "position": 1,
    "text": "به کشور جز از دشت ویران نماند"
  },
  {
    "poem_id": 88072,
    "vorder": 75,
    "position": 0,
    "text": "جز از کینه و زخم شمشیر تیز"
  },
  {
    "poem_id": 88072,
    "vorder": 76,
    "position": 1,
    "text": "نماند ز ما نام تا رستخیز"
  },
  {
    "poem_id": 88072,
    "vorder": 77,
    "position": 0,
    "text": "نیاید جهان آفرین را پسند"
  },
  {
    "poem_id": 88072,
    "vorder": 78,
    "position": 1,
    "text": "به فرجام پیچان شویم از گزند"
  },
  {
    "poem_id": 88072,
    "vorder": 79,
    "position": 0,
    "text": "وگر جنگ جویی همی بیگمان"
  },
  {
    "poem_id": 88072,
    "vorder": 80,
    "position": 1,
    "text": "نیاساید از کین دلت یک زمان"
  },
  {
    "poem_id": 88072,
    "vorder": 81,
    "position": 0,
    "text": "نگه کن بدین گردش روزگار"
  },
  {
    "poem_id": 88072,
    "vorder": 82,
    "position": 1,
    "text": "جز او را مکن بر دل آموزگار"
  },
  {
    "poem_id": 88072,
    "vorder": 83,
    "position": 0,
    "text": "که ما در حصاریم و هامون تراست"
  },
  {
    "poem_id": 88072,
    "vorder": 84,
    "position": 1,
    "text": "سری پر ز کین دل پر از خون تراست"
  },
  {
    "poem_id": 88072,
    "vorder": 85,
    "position": 0,
    "text": "همی گنگ خوانم بهشت منست"
  },
  {
    "poem_id": 88072,
    "vorder": 86,
    "position": 1,
    "text": "برآوردهٔ بوم و کشت منست"
  },
  {
    "poem_id": 88072,
    "vorder": 87,
    "position": 0,
    "text": "هم ایدر مرا گنج و ایدر سپاه"
  },
  {
    "poem_id": 88072,
    "vorder": 88,
    "position": 1,
    "text": "هم ایدر نگین و هم ایدر کلاه"
  },
  {
    "poem_id": 88072,
    "vorder": 89,
    "position": 0,
    "text": "هم اینجام کشت و هم اینجام خورد"
  },
  {
    "poem_id": 88072,
    "vorder": 90,
    "position": 1,
    "text": "هم اینجام مردان روز نبرد"
  },
  {
    "poem_id": 88072,
    "vorder": 91,
    "position": 0,
    "text": "ترا گاه گرمی و خوشی گذشت"
  },
  {
    "poem_id": 88072,
    "vorder": 92,
    "position": 1,
    "text": "گل و لاله و رنگ وشی گذشت"
  },
  {
    "poem_id": 88072,
    "vorder": 93,
    "position": 0,
    "text": "زمستان و سرما به پیش اندرست"
  },
  {
    "poem_id": 88072,
    "vorder": 94,
    "position": 1,
    "text": "که بر نیزه‌ها گردد افسرده دست"
  },
  {
    "poem_id": 88072,
    "vorder": 95,
    "position": 0,
    "text": "به دامن چو ابر اندرافگند چین"
  },
  {
    "poem_id": 88072,
    "vorder": 96,
    "position": 1,
    "text": "بر و بوم ما سنگ گردد زمین"
  },
  {
    "poem_id": 88072,
    "vorder": 97,
    "position": 0,
    "text": "ز هر سو که خوانم بیاید سپاه"
  },
  {
    "poem_id": 88072,
    "vorder": 98,
    "position": 1,
    "text": "نتابی تو با گردش هور و ماه"
  },
  {
    "poem_id": 88072,
    "vorder": 99,
    "position": 0,
    "text": "ور ایدون گمانی که هر کارزار"
  },
  {
    "poem_id": 88072,
    "vorder": 100,
    "position": 1,
    "text": "ترا بردهد اختر روزگار"
  },
  {
    "poem_id": 88072,
    "vorder": 101,
    "position": 0,
    "text": "از اندیشه گردون مگر بگذرد"
  },
  {
    "poem_id": 88072,
    "vorder": 102,
    "position": 1,
    "text": "ز رنج تو دیگر کسی برخورد"
  },
  {
    "poem_id": 88072,
    "vorder": 103,
    "position": 0,
    "text": "گر ایدونک گویی که ترکان چین"
  },
  {
    "poem_id": 88072,
    "vorder": 104,
    "position": 1,
    "text": "بگیرم زنم آسمان بر زمین"
  },
  {
    "poem_id": 88072,
    "vorder": 105,
    "position": 0,
    "text": "به شمشیر بگذارم این انجمن"
  },
  {
    "poem_id": 88072,
    "vorder": 106,
    "position": 1,
    "text": "به دست تو آیم گرفتار من"
  },
  {
    "poem_id": 88072,
    "vorder": 107,
    "position": 0,
    "text": "مپندار کاین نیز نابود نیست"
  },
  {
    "poem_id": 88072,
    "vorder": 108,
    "position": 1,
    "text": "نساید کسی کو نفرسود نیست"
  },
  {
    "poem_id": 88072,
    "vorder": 109,
    "position": 0,
    "text": "نبیرهٔ سر خسروان زادشم"
  },
  {
    "poem_id": 88072,
    "vorder": 110,
    "position": 1,
    "text": "ز پشت فریدون وز تخم جم"
  },
  {
    "poem_id": 88072,
    "vorder": 111,
    "position": 0,
    "text": "مرا دانش ایزدی هست و فر"
  },
  {
    "poem_id": 88072,
    "vorder": 112,
    "position": 1,
    "text": "همان یاورم ایزد دادگر"
  },
  {
    "poem_id": 88072,
    "vorder": 113,
    "position": 0,
    "text": "چو تنگ اندر آید بد روزگار"
  },
  {
    "poem_id": 88072,
    "vorder": 114,
    "position": 1,
    "text": "نخواهد دلم پند آموزگار"
  },
  {
    "poem_id": 88072,
    "vorder": 115,
    "position": 0,
    "text": "به فرمان یزدان به هنگام خواب"
  },
  {
    "poem_id": 88072,
    "vorder": 116,
    "position": 1,
    "text": "شوم چون ستاره بر آفتاب"
  },
  {
    "poem_id": 88072,
    "vorder": 117,
    "position": 0,
    "text": "به دریای کیماک بر بگذرم"
  },
  {
    "poem_id": 88072,
    "vorder": 118,
    "position": 1,
    "text": "سپارم ترا لشکر و کشورم"
  },
  {
    "poem_id": 88072,
    "vorder": 119,
    "position": 0,
    "text": "مرا گنگ و دژ باشد آرامگاه"
  },
  {
    "poem_id": 88072,
    "vorder": 120,
    "position": 1,
    "text": "نبیند مرا نیز شاه و سپاه"
  },
  {
    "poem_id": 88072,
    "vorder": 121,
    "position": 0,
    "text": "چو آید مرا روز کین خواستن"
  },
  {
    "poem_id": 88072,
    "vorder": 122,
    "position": 1,
    "text": "ببین آن زمان لشکر آراستن"
  },
  {
    "poem_id": 88072,
    "vorder": 123,
    "position": 0,
    "text": "بیایم بخواهم ز تو کین خویش"
  },
  {
    "poem_id": 88072,
    "vorder": 124,
    "position": 1,
    "text": "به هر جای پیدا کنم دین خویش"
  },
  {
    "poem_id": 88072,
    "vorder": 125,
    "position": 0,
    "text": "و گر کینه از مغز بیرون کنی"
  },
  {
    "poem_id": 88072,
    "vorder": 126,
    "position": 1,
    "text": "به مهر اندر این کشور افسون کنی"
  },
  {
    "poem_id": 88072,
    "vorder": 127,
    "position": 0,
    "text": "گشایم در گنج تاج و کمر"
  },
  {
    "poem_id": 88072,
    "vorder": 128,
    "position": 1,
    "text": "همان تخت و دینار و جام گهر"
  },
  {
    "poem_id": 88072,
    "vorder": 129,
    "position": 0,
    "text": "که تور فریدون به ایرج نداد"
  },
  {
    "poem_id": 88072,
    "vorder": 130,
    "position": 1,
    "text": "تو بردار وز کین مکن هیچ یاد"
  },
  {
    "poem_id": 88072,
    "vorder": 131,
    "position": 0,
    "text": "و گر چین و ماچین بگیری رواست"
  },
  {
    "poem_id": 88072,
    "vorder": 132,
    "position": 1,
    "text": "بدان رای ران دل همی کت هواست"
  },
  {
    "poem_id": 88072,
    "vorder": 133,
    "position": 0,
    "text": "خراسان و مکران زمین پیش تست"
  },
  {
    "poem_id": 88072,
    "vorder": 134,
    "position": 1,
    "text": "مرا شادکامی کم و بیش تست"
  },
  {
    "poem_id": 88072,
    "vorder": 135,
    "position": 0,
    "text": "به راهی که بگذشت کاووس شاه"
  },
  {
    "poem_id": 88072,
    "vorder": 136,
    "position": 1,
    "text": "فرستمت چندان که باید سپاه"
  },
  {
    "poem_id": 88072,
    "vorder": 137,
    "position": 0,
    "text": "همه لشکرت را توانگر کنم"
  },
  {
    "poem_id": 88072,
    "vorder": 138,
    "position": 1,
    "text": "ترا تخت زرین و افسر کنم"
  },
  {
    "poem_id": 88072,
    "vorder": 139,
    "position": 0,
    "text": "همت یار باشم به هر کارزار"
  },
  {
    "poem_id": 88072,
    "vorder": 140,
    "position": 1,
    "text": "به هر انجمن خوانمت شهریار"
  },
  {
    "poem_id": 88072,
    "vorder": 141,
    "position": 0,
    "text": "گر از پند من سر بپیچی همی"
  },
  {
    "poem_id": 88072,
    "vorder": 142,
    "position": 1,
    "text": "و گر با نیاکان بسیچی همی"
  },
  {
    "poem_id": 88072,
    "vorder": 143,
    "position": 0,
    "text": "چو ز این باز گردی بیارای جنگ"
  },
  {
    "poem_id": 88072,
    "vorder": 144,
    "position": 1,
    "text": "منم ساخته جنگ را چون پلنگ"
  }
]