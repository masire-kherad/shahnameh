[
  {
    "poem_id": 1537,
    "vorder": 1,
    "position": 0,
    "text": "چو جاماسپ گفت این سپیده دمید"
  },
  {
    "poem_id": 1537,
    "vorder": 2,
    "position": 1,
    "text": "فروغ ستاره بشد ناپدید"
  },
  {
    "poem_id": 1537,
    "vorder": 3,
    "position": 0,
    "text": "سپه را به هامون فرود آورید"
  },
  {
    "poem_id": 1537,
    "vorder": 4,
    "position": 1,
    "text": "بزد کوس بر پیل و لشکر کشید"
  },
  {
    "poem_id": 1537,
    "vorder": 5,
    "position": 0,
    "text": "وزانجا خرامید تا رزمگاه"
  },
  {
    "poem_id": 1537,
    "vorder": 6,
    "position": 1,
    "text": "فرود آورید آن گزیده سپاه"
  },
  {
    "poem_id": 1537,
    "vorder": 7,
    "position": 0,
    "text": "به گاهی که باد سپیده دمان"
  },
  {
    "poem_id": 1537,
    "vorder": 8,
    "position": 1,
    "text": "به کاخ آرد از باغ بوی گلان"
  },
  {
    "poem_id": 1537,
    "vorder": 9,
    "position": 0,
    "text": "فرستاده بد هر سوی دیده‌بان"
  },
  {
    "poem_id": 1537,
    "vorder": 10,
    "position": 1,
    "text": "چنانچون بود رسم آزادگان"
  },
  {
    "poem_id": 1537,
    "vorder": 11,
    "position": 0,
    "text": "بیامد سواری و گفتا به شاه"
  },
  {
    "poem_id": 1537,
    "vorder": 12,
    "position": 1,
    "text": "که شاها به نزدیکی آمد سپاه"
  },
  {
    "poem_id": 1537,
    "vorder": 13,
    "position": 0,
    "text": "سپاهیست ای شهریار زمین"
  },
  {
    "poem_id": 1537,
    "vorder": 14,
    "position": 1,
    "text": "که هرگز چنان نامد از ترک و چین"
  },
  {
    "poem_id": 1537,
    "vorder": 15,
    "position": 0,
    "text": "به نزدیکی ما فرود آمدند"
  },
  {
    "poem_id": 1537,
    "vorder": 16,
    "position": 1,
    "text": "به کوه و در و دشت خیمه زدند"
  },
  {
    "poem_id": 1537,
    "vorder": 17,
    "position": 0,
    "text": "سپهدارشان دیده‌بان برگزید"
  },
  {
    "poem_id": 1537,
    "vorder": 18,
    "position": 1,
    "text": "فرستاد و دیده به دیده رسید"
  },
  {
    "poem_id": 1537,
    "vorder": 19,
    "position": 0,
    "text": "پس آزاده گشتاسپ شاه دلیر"
  },
  {
    "poem_id": 1537,
    "vorder": 20,
    "position": 1,
    "text": "سپهبدش را خواند فرخ زریر"
  },
  {
    "poem_id": 1537,
    "vorder": 21,
    "position": 0,
    "text": "درفشی بدو داد و گفتا بتاز"
  },
  {
    "poem_id": 1537,
    "vorder": 22,
    "position": 1,
    "text": "بیارای پیلان و لشکر بساز"
  },
  {
    "poem_id": 1537,
    "vorder": 23,
    "position": 0,
    "text": "سپهبد بشد لشکرش راست کرد"
  },
  {
    "poem_id": 1537,
    "vorder": 24,
    "position": 1,
    "text": "همی رزم سالار چین خواست کرد"
  },
  {
    "poem_id": 1537,
    "vorder": 25,
    "position": 0,
    "text": "بدادش جهاندار پنجه هزار"
  },
  {
    "poem_id": 1537,
    "vorder": 26,
    "position": 1,
    "text": "سوار گزیده به اسفندیار"
  },
  {
    "poem_id": 1537,
    "vorder": 27,
    "position": 0,
    "text": "بدو داد یک دست زان لشکرش"
  },
  {
    "poem_id": 1537,
    "vorder": 28,
    "position": 1,
    "text": "که شیری دلش بود و پیلی برش"
  },
  {
    "poem_id": 1537,
    "vorder": 29,
    "position": 0,
    "text": "دگر دست لشکرش را همچنان"
  },
  {
    "poem_id": 1537,
    "vorder": 30,
    "position": 1,
    "text": "برآراست از شیر دل سرکشان"
  },
  {
    "poem_id": 1537,
    "vorder": 31,
    "position": 0,
    "text": "به گرد گرامی سپرد آن سپاه"
  },
  {
    "poem_id": 1537,
    "vorder": 32,
    "position": 1,
    "text": "که شیر جهان بود و همتای شاه"
  },
  {
    "poem_id": 1537,
    "vorder": 33,
    "position": 0,
    "text": "پس پشت لشکر به بستور داد"
  },
  {
    "poem_id": 1537,
    "vorder": 34,
    "position": 1,
    "text": "چراغ سپهدار خسرو نژاد"
  },
  {
    "poem_id": 1537,
    "vorder": 35,
    "position": 0,
    "text": "چو لشکر بیاراست و بر شد به کوه"
  },
  {
    "poem_id": 1537,
    "vorder": 36,
    "position": 1,
    "text": "غمی گشته از رنج و گشته ستوه"
  },
  {
    "poem_id": 1537,
    "vorder": 37,
    "position": 0,
    "text": "نشست از بر خوب تابنده گاه"
  },
  {
    "poem_id": 1537,
    "vorder": 38,
    "position": 1,
    "text": "همی کرد زانجا به لشکر نگاه"
  },
  {
    "poem_id": 1537,
    "vorder": 39,
    "position": 0,
    "text": "پس ارجاسپ شاه دلیران چین"
  },
  {
    "poem_id": 1537,
    "vorder": 40,
    "position": 1,
    "text": "بیاراست لشکرش را همچنین"
  },
  {
    "poem_id": 1537,
    "vorder": 41,
    "position": 0,
    "text": "جدا کرد از خلخی سی هزار"
  },
  {
    "poem_id": 1537,
    "vorder": 42,
    "position": 1,
    "text": "جهان آزموده نبرده سوار"
  },
  {
    "poem_id": 1537,
    "vorder": 43,
    "position": 0,
    "text": "فرستادشان سوی آن بیدرفش"
  },
  {
    "poem_id": 1537,
    "vorder": 44,
    "position": 1,
    "text": "که کوس مهین داشت و رنگین درفش"
  },
  {
    "poem_id": 1537,
    "vorder": 45,
    "position": 0,
    "text": "بدو داد یک دست زان لشکرش"
  },
  {
    "poem_id": 1537,
    "vorder": 46,
    "position": 1,
    "text": "که شیر ژیان نامدی همبرش"
  },
  {
    "poem_id": 1537,
    "vorder": 47,
    "position": 0,
    "text": "دگر دست را داد بر گرگسار"
  },
  {
    "poem_id": 1537,
    "vorder": 48,
    "position": 1,
    "text": "بدادش سوار گزین صدهزار"
  },
  {
    "poem_id": 1537,
    "vorder": 49,
    "position": 0,
    "text": "میان‌گاه لشکرش را همچنین"
  },
  {
    "poem_id": 1537,
    "vorder": 50,
    "position": 1,
    "text": "سپاهی بیاراست خوب و گزین"
  },
  {
    "poem_id": 1537,
    "vorder": 51,
    "position": 0,
    "text": "بدادش بدان جادوی خویش کام"
  },
  {
    "poem_id": 1537,
    "vorder": 52,
    "position": 1,
    "text": "کجا نام خواست و هزارانش نام"
  },
  {
    "poem_id": 1537,
    "vorder": 53,
    "position": 0,
    "text": "خود و صدهزاران سواران گرد"
  },
  {
    "poem_id": 1537,
    "vorder": 54,
    "position": 1,
    "text": "نموده همه در جهان دستبرد"
  },
  {
    "poem_id": 1537,
    "vorder": 55,
    "position": 0,
    "text": "نگاهش همی داشت پشت سپاه"
  },
  {
    "poem_id": 1537,
    "vorder": 56,
    "position": 1,
    "text": "همی کرد هر سوی لشکر نگاه"
  },
  {
    "poem_id": 1537,
    "vorder": 57,
    "position": 0,
    "text": "پسر داشتی یک گرانمایه مرد"
  },
  {
    "poem_id": 1537,
    "vorder": 58,
    "position": 1,
    "text": "جهاندیده و دیده هر گرم و سرد"
  },
  {
    "poem_id": 1537,
    "vorder": 59,
    "position": 0,
    "text": "سواری جهاندیده نامش کهرم"
  },
  {
    "poem_id": 1537,
    "vorder": 60,
    "position": 1,
    "text": "رسیده بسی بر سرش سرد و گرم"
  },
  {
    "poem_id": 1537,
    "vorder": 61,
    "position": 0,
    "text": "مران پور خود را سپهدار کرد"
  },
  {
    "poem_id": 1537,
    "vorder": 62,
    "position": 1,
    "text": "بران لشکر گشن سالار کرد"
  }
]