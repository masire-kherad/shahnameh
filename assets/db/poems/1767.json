[
  {
    "poem_id": 1767,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت بهرام کای مهتران"
  },
  {
    "poem_id": 1767,
    "vorder": 2,
    "position": 1,
    "text": "جهاندیده و کارکرده سران"
  },
  {
    "poem_id": 1767,
    "vorder": 3,
    "position": 0,
    "text": "همه راست گفتید و زین بترست"
  },
  {
    "poem_id": 1767,
    "vorder": 4,
    "position": 1,
    "text": "پدر را نکوهش کنم در خورست"
  },
  {
    "poem_id": 1767,
    "vorder": 5,
    "position": 0,
    "text": "ازین چاشنی هست نزدیک من"
  },
  {
    "poem_id": 1767,
    "vorder": 6,
    "position": 1,
    "text": "کزان تیره شد رای تاریک من"
  },
  {
    "poem_id": 1767,
    "vorder": 7,
    "position": 0,
    "text": "چو ایوان او بود زندان من"
  },
  {
    "poem_id": 1767,
    "vorder": 8,
    "position": 1,
    "text": "چو بخشایش آورد یزدان من"
  },
  {
    "poem_id": 1767,
    "vorder": 9,
    "position": 0,
    "text": "رهانید طینوشم از دست اوی"
  },
  {
    "poem_id": 1767,
    "vorder": 10,
    "position": 1,
    "text": "بشد خسته کام من از شست اوی"
  },
  {
    "poem_id": 1767,
    "vorder": 11,
    "position": 0,
    "text": "ازان کرده‌ام دست منذر پناه"
  },
  {
    "poem_id": 1767,
    "vorder": 12,
    "position": 1,
    "text": "که هرگز ندیدم نوازش ز شاه"
  },
  {
    "poem_id": 1767,
    "vorder": 13,
    "position": 0,
    "text": "بدان خو مبادا که مردم بود"
  },
  {
    "poem_id": 1767,
    "vorder": 14,
    "position": 1,
    "text": "چو باشد پی مردمی گم بود"
  },
  {
    "poem_id": 1767,
    "vorder": 15,
    "position": 0,
    "text": "سپاسم ز یزدان که دارم خرد"
  },
  {
    "poem_id": 1767,
    "vorder": 16,
    "position": 1,
    "text": "روانم همی از خرد برخورد"
  },
  {
    "poem_id": 1767,
    "vorder": 17,
    "position": 0,
    "text": "ز یزدان همی خواستم تاکنون"
  },
  {
    "poem_id": 1767,
    "vorder": 18,
    "position": 1,
    "text": "که باشد به خوبی مرا رهنمون"
  },
  {
    "poem_id": 1767,
    "vorder": 19,
    "position": 0,
    "text": "که تا هرچ با مردمان کرد شاه"
  },
  {
    "poem_id": 1767,
    "vorder": 20,
    "position": 1,
    "text": "بشوییم ما جان و دل زان گناه"
  },
  {
    "poem_id": 1767,
    "vorder": 21,
    "position": 0,
    "text": "به کام دل زیردستان منم"
  },
  {
    "poem_id": 1767,
    "vorder": 22,
    "position": 1,
    "text": "بر آیین یزدان‌پرستان منم"
  },
  {
    "poem_id": 1767,
    "vorder": 23,
    "position": 0,
    "text": "شبان باشم و زیردستان رمه"
  },
  {
    "poem_id": 1767,
    "vorder": 24,
    "position": 1,
    "text": "تن‌آسانی و داد جویم همه"
  },
  {
    "poem_id": 1767,
    "vorder": 25,
    "position": 0,
    "text": "منش هست و فرهنگ و رای و هنر"
  },
  {
    "poem_id": 1767,
    "vorder": 26,
    "position": 1,
    "text": "ندارد هنر شاه بیدادگر"
  },
  {
    "poem_id": 1767,
    "vorder": 27,
    "position": 0,
    "text": "لئیمی و کژی ز بیچارگیست"
  },
  {
    "poem_id": 1767,
    "vorder": 28,
    "position": 1,
    "text": "به بیدادگر بر بباید گریست"
  },
  {
    "poem_id": 1767,
    "vorder": 29,
    "position": 0,
    "text": "پدر بر پدر پادشاهی مراست"
  },
  {
    "poem_id": 1767,
    "vorder": 30,
    "position": 1,
    "text": "خردمندی و نیکخواهی مراست"
  },
  {
    "poem_id": 1767,
    "vorder": 31,
    "position": 0,
    "text": "ز شاپور بهرام تا اردشیر"
  },
  {
    "poem_id": 1767,
    "vorder": 32,
    "position": 1,
    "text": "همه شهریاران برنا و پیر"
  },
  {
    "poem_id": 1767,
    "vorder": 33,
    "position": 0,
    "text": "پدر بر پدربر نیای منند"
  },
  {
    "poem_id": 1767,
    "vorder": 34,
    "position": 1,
    "text": "به دین و خرد رهنمای منند"
  },
  {
    "poem_id": 1767,
    "vorder": 35,
    "position": 0,
    "text": "ز مادر نبیرهٔ شمیران شهم"
  },
  {
    "poem_id": 1767,
    "vorder": 36,
    "position": 1,
    "text": "ز هر گوهری با خرد همرهم"
  },
  {
    "poem_id": 1767,
    "vorder": 37,
    "position": 0,
    "text": "هنر هم خرد هم بزرگیم هست"
  },
  {
    "poem_id": 1767,
    "vorder": 38,
    "position": 1,
    "text": "سواری و مردی و نیروی دست"
  },
  {
    "poem_id": 1767,
    "vorder": 39,
    "position": 0,
    "text": "کسی را ندارم ز مردان به مرد"
  },
  {
    "poem_id": 1767,
    "vorder": 40,
    "position": 1,
    "text": "به رزم و به بزم و به هر کارکرد"
  },
  {
    "poem_id": 1767,
    "vorder": 41,
    "position": 0,
    "text": "نهفته مرا گنج آگنده هست"
  },
  {
    "poem_id": 1767,
    "vorder": 42,
    "position": 1,
    "text": "همان نامداران خسروپرست"
  },
  {
    "poem_id": 1767,
    "vorder": 43,
    "position": 0,
    "text": "جهان یکسر آباد دارم به داد"
  },
  {
    "poem_id": 1767,
    "vorder": 44,
    "position": 1,
    "text": "شما یکسر آباد باشید و شاد"
  },
  {
    "poem_id": 1767,
    "vorder": 45,
    "position": 0,
    "text": "هران بوم کز رنج ویران شدست"
  },
  {
    "poem_id": 1767,
    "vorder": 46,
    "position": 1,
    "text": "ز بیدادی شاه ایران شدست"
  },
  {
    "poem_id": 1767,
    "vorder": 47,
    "position": 0,
    "text": "من آباد گردانم آن را به داد"
  },
  {
    "poem_id": 1767,
    "vorder": 48,
    "position": 1,
    "text": "همه زیردستان بمانند شاد"
  },
  {
    "poem_id": 1767,
    "vorder": 49,
    "position": 0,
    "text": "یکی با شما نیز پیمان کنم"
  },
  {
    "poem_id": 1767,
    "vorder": 50,
    "position": 1,
    "text": "زبان را به یزدان گروگان کنم"
  },
  {
    "poem_id": 1767,
    "vorder": 51,
    "position": 0,
    "text": "بیاریم شاهنشهی تخت عاج"
  },
  {
    "poem_id": 1767,
    "vorder": 52,
    "position": 1,
    "text": "برش در میان تنگ بنهیم تاج"
  },
  {
    "poem_id": 1767,
    "vorder": 53,
    "position": 0,
    "text": "ز بیشه دو شیر ژیان آوریم"
  },
  {
    "poem_id": 1767,
    "vorder": 54,
    "position": 1,
    "text": "همان تاج را در میان آوریم"
  },
  {
    "poem_id": 1767,
    "vorder": 55,
    "position": 0,
    "text": "ببندیم شیر ژیان بر دو سوی"
  },
  {
    "poem_id": 1767,
    "vorder": 56,
    "position": 1,
    "text": "کسی را که شاهی کند آرزوی"
  },
  {
    "poem_id": 1767,
    "vorder": 57,
    "position": 0,
    "text": "شود تاج برگیرد از تخت عاج"
  },
  {
    "poem_id": 1767,
    "vorder": 58,
    "position": 1,
    "text": "به سر برنهد نامبردار تاج"
  },
  {
    "poem_id": 1767,
    "vorder": 59,
    "position": 0,
    "text": "به شاهی نشیند میان دو شیر"
  },
  {
    "poem_id": 1767,
    "vorder": 60,
    "position": 1,
    "text": "میان شاه و تاج از بر و تخت زیر"
  },
  {
    "poem_id": 1767,
    "vorder": 61,
    "position": 0,
    "text": "جز او را نخواهیم کس پادشا"
  },
  {
    "poem_id": 1767,
    "vorder": 62,
    "position": 1,
    "text": "اگر دادگر باشد و پارسا"
  },
  {
    "poem_id": 1767,
    "vorder": 63,
    "position": 0,
    "text": "وگر زین که گفتم بتابید یال"
  },
  {
    "poem_id": 1767,
    "vorder": 64,
    "position": 1,
    "text": "گزینید گردنکشی را همال"
  },
  {
    "poem_id": 1767,
    "vorder": 65,
    "position": 0,
    "text": "به جایی که چون من بود پیش رو"
  },
  {
    "poem_id": 1767,
    "vorder": 66,
    "position": 1,
    "text": "سنان سواران بود خار و خو"
  },
  {
    "poem_id": 1767,
    "vorder": 67,
    "position": 0,
    "text": "من و منذر و گرز و شمشیر تیز"
  },
  {
    "poem_id": 1767,
    "vorder": 68,
    "position": 1,
    "text": "ندانند گردان تازی گریز"
  },
  {
    "poem_id": 1767,
    "vorder": 69,
    "position": 0,
    "text": "برآریم گرد از شهنشاهتان"
  },
  {
    "poem_id": 1767,
    "vorder": 70,
    "position": 1,
    "text": "همان از بر و بوم وز گاهتان"
  },
  {
    "poem_id": 1767,
    "vorder": 71,
    "position": 0,
    "text": "کنون آنچ گفتیم پاسخ دهید"
  },
  {
    "poem_id": 1767,
    "vorder": 72,
    "position": 1,
    "text": "بدین داوری رای فرخ نهید"
  },
  {
    "poem_id": 1767,
    "vorder": 73,
    "position": 0,
    "text": "بگفت این و برخاست و در خیمه شد"
  },
  {
    "poem_id": 1767,
    "vorder": 74,
    "position": 1,
    "text": "جهانی ز گفتارش آسیمه شد"
  },
  {
    "poem_id": 1767,
    "vorder": 75,
    "position": 0,
    "text": "به ایران رد و موبدان هرک بود"
  },
  {
    "poem_id": 1767,
    "vorder": 76,
    "position": 1,
    "text": "که گفتار آن شاه دانا شنود"
  },
  {
    "poem_id": 1767,
    "vorder": 77,
    "position": 0,
    "text": "بگفتند کین فره ایزدیست"
  },
  {
    "poem_id": 1767,
    "vorder": 78,
    "position": 1,
    "text": "نه از راه کژی و نابخردیست"
  },
  {
    "poem_id": 1767,
    "vorder": 79,
    "position": 0,
    "text": "نگوید همی یک سخن جز به داد"
  },
  {
    "poem_id": 1767,
    "vorder": 80,
    "position": 1,
    "text": "سزد گر دل از داد داریم شاد"
  },
  {
    "poem_id": 1767,
    "vorder": 81,
    "position": 0,
    "text": "کنون آنک گفت او ز شیر ژیان"
  },
  {
    "poem_id": 1767,
    "vorder": 82,
    "position": 1,
    "text": "یکی تاج و تخت کیی بر میان"
  },
  {
    "poem_id": 1767,
    "vorder": 83,
    "position": 0,
    "text": "گر او را بدرند شیران نر"
  },
  {
    "poem_id": 1767,
    "vorder": 84,
    "position": 1,
    "text": "ز خونش بپرسد ز ما دادگر"
  },
  {
    "poem_id": 1767,
    "vorder": 85,
    "position": 0,
    "text": "چو خود گفت و این رسم بد خود نهاد"
  },
  {
    "poem_id": 1767,
    "vorder": 86,
    "position": 1,
    "text": "همان کز به مرگش نباشیم شاد"
  },
  {
    "poem_id": 1767,
    "vorder": 87,
    "position": 0,
    "text": "ور ایدون کجا تاج بردارد اوی"
  },
  {
    "poem_id": 1767,
    "vorder": 88,
    "position": 1,
    "text": "به فر از فریدون گذر دارد اوی"
  },
  {
    "poem_id": 1767,
    "vorder": 89,
    "position": 0,
    "text": "جز از شهریارش نخوانیم کس"
  },
  {
    "poem_id": 1767,
    "vorder": 90,
    "position": 1,
    "text": "ز گفتارها داد دادیم و بس"
  }
]