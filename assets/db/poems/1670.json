[
  {
    "poem_id": 1670,
    "vorder": 1,
    "position": 0,
    "text": "چو نزدیکی نرم‌پایان رسید"
  },
  {
    "poem_id": 1670,
    "vorder": 2,
    "position": 1,
    "text": "نگه کرد و مردم بی‌اندازه دید"
  },
  {
    "poem_id": 1670,
    "vorder": 3,
    "position": 0,
    "text": "نه اسپ و نه جوشن نه تیغ و نه گرز"
  },
  {
    "poem_id": 1670,
    "vorder": 4,
    "position": 1,
    "text": "ازان هر یکی چون یکی سرو برز"
  },
  {
    "poem_id": 1670,
    "vorder": 5,
    "position": 0,
    "text": "چو رعد خروشان برآمد غریو"
  },
  {
    "poem_id": 1670,
    "vorder": 6,
    "position": 1,
    "text": "برهنه سپاهی به کردار دیو"
  },
  {
    "poem_id": 1670,
    "vorder": 7,
    "position": 0,
    "text": "یکی سنگ‌باران بکردند سخت"
  },
  {
    "poem_id": 1670,
    "vorder": 8,
    "position": 1,
    "text": "چو باد خزان برزند بر درخت"
  },
  {
    "poem_id": 1670,
    "vorder": 9,
    "position": 0,
    "text": "به تیر و به تیغ اندر آمد سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 10,
    "position": 1,
    "text": "تو گفتی که شد روز روشن سیاه"
  },
  {
    "poem_id": 1670,
    "vorder": 11,
    "position": 0,
    "text": "چو از نرم‌پایان فراوان بماند"
  },
  {
    "poem_id": 1670,
    "vorder": 12,
    "position": 1,
    "text": "سکندر برآسود و لشکر براند"
  },
  {
    "poem_id": 1670,
    "vorder": 13,
    "position": 0,
    "text": "بشد تازیان تا به شهری رسید"
  },
  {
    "poem_id": 1670,
    "vorder": 14,
    "position": 1,
    "text": "که آن را کران و میانه ندید"
  },
  {
    "poem_id": 1670,
    "vorder": 15,
    "position": 0,
    "text": "به آیین همه پیش باز آمدند"
  },
  {
    "poem_id": 1670,
    "vorder": 16,
    "position": 1,
    "text": "گشاده‌دل و بی‌نیاز آمدند"
  },
  {
    "poem_id": 1670,
    "vorder": 17,
    "position": 0,
    "text": "ببردند هرگونه گستردنی"
  },
  {
    "poem_id": 1670,
    "vorder": 18,
    "position": 1,
    "text": "ز پوشیدنیها و از خوردنی"
  },
  {
    "poem_id": 1670,
    "vorder": 19,
    "position": 0,
    "text": "سکندر بپرسید و بنواختشان"
  },
  {
    "poem_id": 1670,
    "vorder": 20,
    "position": 1,
    "text": "براندازه بر پایگه ساختشان"
  },
  {
    "poem_id": 1670,
    "vorder": 21,
    "position": 0,
    "text": "کشیدند بر دشت پرده‌سرای"
  },
  {
    "poem_id": 1670,
    "vorder": 22,
    "position": 1,
    "text": "سپاهش نجست اندر آن شهر جای"
  },
  {
    "poem_id": 1670,
    "vorder": 23,
    "position": 0,
    "text": "سر اندر ستاره یکی کوه دید"
  },
  {
    "poem_id": 1670,
    "vorder": 24,
    "position": 1,
    "text": "تو گفتی که گردون بخواهد کشید"
  },
  {
    "poem_id": 1670,
    "vorder": 25,
    "position": 0,
    "text": "بران کوه مردم بدی اندکی"
  },
  {
    "poem_id": 1670,
    "vorder": 26,
    "position": 1,
    "text": "شب تیره زیشان نماندی یکی"
  },
  {
    "poem_id": 1670,
    "vorder": 27,
    "position": 0,
    "text": "بپرسید ازیشان سکندر که راه"
  },
  {
    "poem_id": 1670,
    "vorder": 28,
    "position": 1,
    "text": "کدامست و چون راند باید سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 29,
    "position": 0,
    "text": "همه یکسره خواندند آفرین"
  },
  {
    "poem_id": 1670,
    "vorder": 30,
    "position": 1,
    "text": "که ای نامور شهریار زمین"
  },
  {
    "poem_id": 1670,
    "vorder": 31,
    "position": 0,
    "text": "به رفتن برین کوه بودی گذر"
  },
  {
    "poem_id": 1670,
    "vorder": 32,
    "position": 1,
    "text": "اگر برگذشتی برو راه‌بر"
  },
  {
    "poem_id": 1670,
    "vorder": 33,
    "position": 0,
    "text": "یکی اژدهایست زان روی کوه"
  },
  {
    "poem_id": 1670,
    "vorder": 34,
    "position": 1,
    "text": "که مرغ آید از رنج زهرش ستوه"
  },
  {
    "poem_id": 1670,
    "vorder": 35,
    "position": 0,
    "text": "نیارد گذشتن بروبر سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 36,
    "position": 1,
    "text": "همی دود زهرش برآید به ماه"
  },
  {
    "poem_id": 1670,
    "vorder": 37,
    "position": 0,
    "text": "همی آتش افروزد از کام اوی"
  },
  {
    "poem_id": 1670,
    "vorder": 38,
    "position": 1,
    "text": "دو گیسو بود پیل را دام اوی"
  },
  {
    "poem_id": 1670,
    "vorder": 39,
    "position": 0,
    "text": "همه شهر با او نداریم تاو"
  },
  {
    "poem_id": 1670,
    "vorder": 40,
    "position": 1,
    "text": "خورش بایدش هر شبی پنج گاو"
  },
  {
    "poem_id": 1670,
    "vorder": 41,
    "position": 0,
    "text": "بجوییم و بر کوه خارا بریم"
  },
  {
    "poem_id": 1670,
    "vorder": 42,
    "position": 1,
    "text": "پر اندیشه و پر مدارا بریم"
  },
  {
    "poem_id": 1670,
    "vorder": 43,
    "position": 0,
    "text": "بدان تا نیاید بدین روی کوه"
  },
  {
    "poem_id": 1670,
    "vorder": 44,
    "position": 1,
    "text": "نینجامید از ما گروها گروه"
  },
  {
    "poem_id": 1670,
    "vorder": 45,
    "position": 0,
    "text": "بفرمود سالار دیهیم جوی"
  },
  {
    "poem_id": 1670,
    "vorder": 46,
    "position": 1,
    "text": "که آن روز ندهند چیز بدوی"
  },
  {
    "poem_id": 1670,
    "vorder": 47,
    "position": 0,
    "text": "چو گاه خورش درگذشت اژدها"
  },
  {
    "poem_id": 1670,
    "vorder": 48,
    "position": 1,
    "text": "بیامد چو آتش بران تند جا"
  },
  {
    "poem_id": 1670,
    "vorder": 49,
    "position": 0,
    "text": "سکندر بفرمود تا لشکرش"
  },
  {
    "poem_id": 1670,
    "vorder": 50,
    "position": 1,
    "text": "یکی تیرباران کنند ازبرش"
  },
  {
    "poem_id": 1670,
    "vorder": 51,
    "position": 0,
    "text": "بزد یک دم آن اژدهای پلید"
  },
  {
    "poem_id": 1670,
    "vorder": 52,
    "position": 1,
    "text": "تنی چند ازیشان به دم درکشید"
  },
  {
    "poem_id": 1670,
    "vorder": 53,
    "position": 0,
    "text": "بفرمود اسکندر فیلقوس"
  },
  {
    "poem_id": 1670,
    "vorder": 54,
    "position": 1,
    "text": "تبیره به زخم آوریدند و کوس"
  },
  {
    "poem_id": 1670,
    "vorder": 55,
    "position": 0,
    "text": "همان بی‌کران آتش افروختند"
  },
  {
    "poem_id": 1670,
    "vorder": 56,
    "position": 1,
    "text": "به هرجای مشعل همی سوختند"
  },
  {
    "poem_id": 1670,
    "vorder": 57,
    "position": 0,
    "text": "چو کوه از تبیره پرآواز گشت"
  },
  {
    "poem_id": 1670,
    "vorder": 58,
    "position": 1,
    "text": "بترسید ازان اژدها بازگشت"
  },
  {
    "poem_id": 1670,
    "vorder": 59,
    "position": 0,
    "text": "چو خورشید برزد سر از برج گاو"
  },
  {
    "poem_id": 1670,
    "vorder": 60,
    "position": 1,
    "text": "ز گلزاربرخاست بانگ چکاو"
  },
  {
    "poem_id": 1670,
    "vorder": 61,
    "position": 0,
    "text": "چو آن اژدها را خورش بود گاه"
  },
  {
    "poem_id": 1670,
    "vorder": 62,
    "position": 1,
    "text": "ز مردان لشکر گزین کرد شاه"
  },
  {
    "poem_id": 1670,
    "vorder": 63,
    "position": 0,
    "text": "درم داد سالار چندی ز گنج"
  },
  {
    "poem_id": 1670,
    "vorder": 64,
    "position": 1,
    "text": "بیاورد با خویشتن گاو پنج"
  },
  {
    "poem_id": 1670,
    "vorder": 65,
    "position": 0,
    "text": "بکشت و ز سرشان برآهخت پوست"
  },
  {
    "poem_id": 1670,
    "vorder": 66,
    "position": 1,
    "text": "بدان جادوی داده دل مرد دوست"
  },
  {
    "poem_id": 1670,
    "vorder": 67,
    "position": 0,
    "text": "بیاگند چرمش به زهر و به نفت"
  },
  {
    "poem_id": 1670,
    "vorder": 68,
    "position": 1,
    "text": "سوی اژدها روی بنهاد تفت"
  },
  {
    "poem_id": 1670,
    "vorder": 69,
    "position": 0,
    "text": "مران چرمها را پر از باد کرد"
  },
  {
    "poem_id": 1670,
    "vorder": 70,
    "position": 1,
    "text": "ز دادار نیکی دهش یاد کرد"
  },
  {
    "poem_id": 1670,
    "vorder": 71,
    "position": 0,
    "text": "بفرمود تا پوست برداشتند"
  },
  {
    "poem_id": 1670,
    "vorder": 72,
    "position": 1,
    "text": "همی دست بر دست بگذاشتند"
  },
  {
    "poem_id": 1670,
    "vorder": 73,
    "position": 0,
    "text": "چو نزدیکی اژدها رفت شاه"
  },
  {
    "poem_id": 1670,
    "vorder": 74,
    "position": 1,
    "text": "بسان یکی ابر دیدش سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 75,
    "position": 0,
    "text": "زبانش کبود و دو چشمش چو خون"
  },
  {
    "poem_id": 1670,
    "vorder": 76,
    "position": 1,
    "text": "همی آتش آمد ز کامش برون"
  },
  {
    "poem_id": 1670,
    "vorder": 77,
    "position": 0,
    "text": "چو گاو از سر کوه بنداختند"
  },
  {
    "poem_id": 1670,
    "vorder": 78,
    "position": 1,
    "text": "بران اژدها دل بپرداختند"
  },
  {
    "poem_id": 1670,
    "vorder": 79,
    "position": 0,
    "text": "فرو برد چون باد گاو اژدها"
  },
  {
    "poem_id": 1670,
    "vorder": 80,
    "position": 1,
    "text": "چو آمد ز چنگ دلیران رها"
  },
  {
    "poem_id": 1670,
    "vorder": 81,
    "position": 0,
    "text": "چو از گاو پیوندش آگنده شد"
  },
  {
    "poem_id": 1670,
    "vorder": 82,
    "position": 1,
    "text": "بر اندام زهرش پراگنده شد"
  },
  {
    "poem_id": 1670,
    "vorder": 83,
    "position": 0,
    "text": "همه رودگانیش سوراخ کرد"
  },
  {
    "poem_id": 1670,
    "vorder": 84,
    "position": 1,
    "text": "به مغز و به پی راه گستاخ کرد"
  },
  {
    "poem_id": 1670,
    "vorder": 85,
    "position": 0,
    "text": "همی زد سرش را بران کوه سنگ"
  },
  {
    "poem_id": 1670,
    "vorder": 86,
    "position": 1,
    "text": "چنین تا برآمد زمانی درنگ"
  },
  {
    "poem_id": 1670,
    "vorder": 87,
    "position": 0,
    "text": "سپاهی بروبر ببارید تیر"
  },
  {
    "poem_id": 1670,
    "vorder": 88,
    "position": 1,
    "text": "به پای آمد آن کوه نخچیرگیر"
  },
  {
    "poem_id": 1670,
    "vorder": 89,
    "position": 0,
    "text": "وزان جایگه تیز لشکر براند"
  },
  {
    "poem_id": 1670,
    "vorder": 90,
    "position": 1,
    "text": "تن اژدها را هم‌انجا بماند"
  },
  {
    "poem_id": 1670,
    "vorder": 91,
    "position": 0,
    "text": "بیاورد لشکر به کوهی دگر"
  },
  {
    "poem_id": 1670,
    "vorder": 92,
    "position": 1,
    "text": "کزان خیره شد مرد پرخاشخر"
  },
  {
    "poem_id": 1670,
    "vorder": 93,
    "position": 0,
    "text": "بلندیش بینا همی دیر دید"
  },
  {
    "poem_id": 1670,
    "vorder": 94,
    "position": 1,
    "text": "سر کوه چون تیغ و شمشیر دید"
  },
  {
    "poem_id": 1670,
    "vorder": 95,
    "position": 0,
    "text": "یکی تخت زرین بران تیغ کوه"
  },
  {
    "poem_id": 1670,
    "vorder": 96,
    "position": 1,
    "text": "ز انبوه یکسو و دور از گروه"
  },
  {
    "poem_id": 1670,
    "vorder": 97,
    "position": 0,
    "text": "یکی مرده مرد اندران تخت‌بر"
  },
  {
    "poem_id": 1670,
    "vorder": 98,
    "position": 1,
    "text": "همانا که بودش پس از مرگ فر"
  },
  {
    "poem_id": 1670,
    "vorder": 99,
    "position": 0,
    "text": "ز دیبا کشیده برو چادری"
  },
  {
    "poem_id": 1670,
    "vorder": 100,
    "position": 1,
    "text": "ز هر گوهری بر سرش افسری"
  },
  {
    "poem_id": 1670,
    "vorder": 101,
    "position": 0,
    "text": "همه گرد بر گرد او سیم و زر"
  },
  {
    "poem_id": 1670,
    "vorder": 102,
    "position": 1,
    "text": "کسی را نبودی بروبر گذر"
  },
  {
    "poem_id": 1670,
    "vorder": 103,
    "position": 0,
    "text": "هرآنکس که رفتی بران کوهسار"
  },
  {
    "poem_id": 1670,
    "vorder": 104,
    "position": 1,
    "text": "که از مرده چیزی کند خواستار"
  },
  {
    "poem_id": 1670,
    "vorder": 105,
    "position": 0,
    "text": "بران کوه از بیم لرزان شدی"
  },
  {
    "poem_id": 1670,
    "vorder": 106,
    "position": 1,
    "text": "به مردی و بر جای ریزان شدی"
  },
  {
    "poem_id": 1670,
    "vorder": 107,
    "position": 0,
    "text": "سکندر برآمد بران کوه‌سر"
  },
  {
    "poem_id": 1670,
    "vorder": 108,
    "position": 1,
    "text": "نظاره بران مرد با سیم و زر"
  },
  {
    "poem_id": 1670,
    "vorder": 109,
    "position": 0,
    "text": "یکی بانگ بشنید کای شهریار"
  },
  {
    "poem_id": 1670,
    "vorder": 110,
    "position": 1,
    "text": "بسی بردی اندر جهان روزگار"
  },
  {
    "poem_id": 1670,
    "vorder": 111,
    "position": 0,
    "text": "بسی تخت شاهان بپرداختی"
  },
  {
    "poem_id": 1670,
    "vorder": 112,
    "position": 1,
    "text": "سرت را به گردون برافراختی"
  },
  {
    "poem_id": 1670,
    "vorder": 113,
    "position": 0,
    "text": "بسی دشمن و دوست کردی تباه"
  },
  {
    "poem_id": 1670,
    "vorder": 114,
    "position": 1,
    "text": "ز گیتی کنون بازگشتست گاه"
  },
  {
    "poem_id": 1670,
    "vorder": 115,
    "position": 0,
    "text": "رخ شاه ز آواز شد چون چراغ"
  },
  {
    "poem_id": 1670,
    "vorder": 116,
    "position": 1,
    "text": "ازان کوه برگشت دل پر ز داغ"
  },
  {
    "poem_id": 1670,
    "vorder": 117,
    "position": 0,
    "text": "همی رفت با نامداران روم"
  },
  {
    "poem_id": 1670,
    "vorder": 118,
    "position": 1,
    "text": "بدان شارستان شد که خوانی هروم"
  },
  {
    "poem_id": 1670,
    "vorder": 119,
    "position": 0,
    "text": "که آن شهر یکسر زنان داشتند"
  },
  {
    "poem_id": 1670,
    "vorder": 120,
    "position": 1,
    "text": "کسی را دران شهر نگذاشتند"
  },
  {
    "poem_id": 1670,
    "vorder": 121,
    "position": 0,
    "text": "سوی راست پستان چو آن زنان"
  },
  {
    "poem_id": 1670,
    "vorder": 122,
    "position": 1,
    "text": "بسان یکی نار بر پرنیان"
  },
  {
    "poem_id": 1670,
    "vorder": 123,
    "position": 0,
    "text": "سوی چپ به کردار جوینده مرد"
  },
  {
    "poem_id": 1670,
    "vorder": 124,
    "position": 1,
    "text": "که جوشن بپوشد به روز نبرد"
  },
  {
    "poem_id": 1670,
    "vorder": 125,
    "position": 0,
    "text": "چو آمد به نزدیک شهر هروم"
  },
  {
    "poem_id": 1670,
    "vorder": 126,
    "position": 1,
    "text": "سرافراز با نامداران روم"
  },
  {
    "poem_id": 1670,
    "vorder": 127,
    "position": 0,
    "text": "یکی نامه بنوشت با رسم و داد"
  },
  {
    "poem_id": 1670,
    "vorder": 128,
    "position": 1,
    "text": "چنانچون بود مرد فرخ‌نژاد"
  },
  {
    "poem_id": 1670,
    "vorder": 129,
    "position": 0,
    "text": "به عنوان بر از شاه ایران و روم"
  },
  {
    "poem_id": 1670,
    "vorder": 130,
    "position": 1,
    "text": "سوی آنک دارند مرز هروم"
  },
  {
    "poem_id": 1670,
    "vorder": 131,
    "position": 0,
    "text": "سر نامه از کردگار سپهر"
  },
  {
    "poem_id": 1670,
    "vorder": 132,
    "position": 1,
    "text": "کزویست بخشایش و داد و مهر"
  },
  {
    "poem_id": 1670,
    "vorder": 133,
    "position": 0,
    "text": "هرانکس که دارد روانش خرد"
  },
  {
    "poem_id": 1670,
    "vorder": 134,
    "position": 1,
    "text": "جهان را به عمری همی بسپرد"
  },
  {
    "poem_id": 1670,
    "vorder": 135,
    "position": 0,
    "text": "شنید آنک ما در جهان کرده‌ایم"
  },
  {
    "poem_id": 1670,
    "vorder": 136,
    "position": 1,
    "text": "سر مهتری بر کجا برده‌ایم"
  },
  {
    "poem_id": 1670,
    "vorder": 137,
    "position": 0,
    "text": "کسی کو ز فرمان ما سر بتافت"
  },
  {
    "poem_id": 1670,
    "vorder": 138,
    "position": 1,
    "text": "نهالی به جز خاک تیره نیافت"
  },
  {
    "poem_id": 1670,
    "vorder": 139,
    "position": 0,
    "text": "نخواهم که جایی بود در جهان"
  },
  {
    "poem_id": 1670,
    "vorder": 140,
    "position": 1,
    "text": "که دیدار آن باشد از من نهان"
  },
  {
    "poem_id": 1670,
    "vorder": 141,
    "position": 0,
    "text": "گر آیم مرا با شما نیست رزم"
  },
  {
    "poem_id": 1670,
    "vorder": 142,
    "position": 1,
    "text": "به دل آشتی دارم و رای بزم"
  },
  {
    "poem_id": 1670,
    "vorder": 143,
    "position": 0,
    "text": "اگر هیچ دارید داننده‌ای"
  },
  {
    "poem_id": 1670,
    "vorder": 144,
    "position": 1,
    "text": "خردمند و بیدار خواننده‌ای"
  },
  {
    "poem_id": 1670,
    "vorder": 145,
    "position": 0,
    "text": "چو برخواند این نامهٔ پندمند"
  },
  {
    "poem_id": 1670,
    "vorder": 146,
    "position": 1,
    "text": "برآنکس که هست از شما ارجمند"
  },
  {
    "poem_id": 1670,
    "vorder": 147,
    "position": 0,
    "text": "ببندید پیش آمدن را میان"
  },
  {
    "poem_id": 1670,
    "vorder": 148,
    "position": 1,
    "text": "کزین آمدن کس ندارد زیان"
  },
  {
    "poem_id": 1670,
    "vorder": 149,
    "position": 0,
    "text": "بفرمود تا فیلسوفی ز روم"
  },
  {
    "poem_id": 1670,
    "vorder": 150,
    "position": 1,
    "text": "برد نامه نزدیک شهر هروم"
  },
  {
    "poem_id": 1670,
    "vorder": 151,
    "position": 0,
    "text": "بسی نیز شیرین سخنها بگفت"
  },
  {
    "poem_id": 1670,
    "vorder": 152,
    "position": 1,
    "text": "فرستاده خود با خرد بود جفت"
  },
  {
    "poem_id": 1670,
    "vorder": 153,
    "position": 0,
    "text": "چو دانا به نزدیک ایشان رسید"
  },
  {
    "poem_id": 1670,
    "vorder": 154,
    "position": 1,
    "text": "همه شهر زن دید و مردی ندید"
  },
  {
    "poem_id": 1670,
    "vorder": 155,
    "position": 0,
    "text": "همه لشکر از شهر بیرون شدند"
  },
  {
    "poem_id": 1670,
    "vorder": 156,
    "position": 1,
    "text": "به دیدار رومی به هامون شدند"
  },
  {
    "poem_id": 1670,
    "vorder": 157,
    "position": 0,
    "text": "بران نامه‌بر شد جهان انجمن"
  },
  {
    "poem_id": 1670,
    "vorder": 158,
    "position": 1,
    "text": "ازیشان هرانکس که بد رای زن"
  },
  {
    "poem_id": 1670,
    "vorder": 159,
    "position": 0,
    "text": "چو این نامه برخواند دانای شهر"
  },
  {
    "poem_id": 1670,
    "vorder": 160,
    "position": 1,
    "text": "ز رای دل شاه برداشت بهر"
  },
  {
    "poem_id": 1670,
    "vorder": 161,
    "position": 0,
    "text": "نشستند و پاسخ نوشتند باز"
  },
  {
    "poem_id": 1670,
    "vorder": 162,
    "position": 1,
    "text": "که دایم بزی شاه گردن فراز"
  },
  {
    "poem_id": 1670,
    "vorder": 163,
    "position": 0,
    "text": "فرستاده را پیش بنشاندیم"
  },
  {
    "poem_id": 1670,
    "vorder": 164,
    "position": 1,
    "text": "یکایک همه نامه برخواندیم"
  },
  {
    "poem_id": 1670,
    "vorder": 165,
    "position": 0,
    "text": "نخستین که گفتی ز شاهان سخن"
  },
  {
    "poem_id": 1670,
    "vorder": 166,
    "position": 1,
    "text": "ز پیروزی و رزمهای کهن"
  },
  {
    "poem_id": 1670,
    "vorder": 167,
    "position": 0,
    "text": "اگر لشکر آری به شهر هروم"
  },
  {
    "poem_id": 1670,
    "vorder": 168,
    "position": 1,
    "text": "نبینی ز نعل و پی اسپ بوم"
  },
  {
    "poem_id": 1670,
    "vorder": 169,
    "position": 0,
    "text": "بی‌اندازه در شهر ما برزنست"
  },
  {
    "poem_id": 1670,
    "vorder": 170,
    "position": 1,
    "text": "بهر برزنی بر هزاران زنست"
  },
  {
    "poem_id": 1670,
    "vorder": 171,
    "position": 0,
    "text": "همه شب به خفتان جنگ اندریم"
  },
  {
    "poem_id": 1670,
    "vorder": 172,
    "position": 1,
    "text": "ز بهر فزونی به تنگ اندریم"
  },
  {
    "poem_id": 1670,
    "vorder": 173,
    "position": 0,
    "text": "ز چندین یکی را نبودست شوی"
  },
  {
    "poem_id": 1670,
    "vorder": 174,
    "position": 1,
    "text": "که دوشیزگانیم و پوشیده‌روی"
  },
  {
    "poem_id": 1670,
    "vorder": 175,
    "position": 0,
    "text": "ز هر سو که آیی برین بوم و بر"
  },
  {
    "poem_id": 1670,
    "vorder": 176,
    "position": 1,
    "text": "بجز ژرف دریا نبینی گذر"
  },
  {
    "poem_id": 1670,
    "vorder": 177,
    "position": 0,
    "text": "ز ما هر زنی کو گراید بشوی"
  },
  {
    "poem_id": 1670,
    "vorder": 178,
    "position": 1,
    "text": "ازان پس کس او را نه‌بینیم روی"
  },
  {
    "poem_id": 1670,
    "vorder": 179,
    "position": 0,
    "text": "بباید گذشتن به دریای ژرف"
  },
  {
    "poem_id": 1670,
    "vorder": 180,
    "position": 1,
    "text": "اگر خوش و گر نیز باریده برف"
  },
  {
    "poem_id": 1670,
    "vorder": 181,
    "position": 0,
    "text": "اگر دختر آیدش چون کردشوی"
  },
  {
    "poem_id": 1670,
    "vorder": 182,
    "position": 1,
    "text": "زن‌آسا و جویندهٔ رنگ و بوی"
  },
  {
    "poem_id": 1670,
    "vorder": 183,
    "position": 0,
    "text": "هم آن خانه جاوید جای وی است"
  },
  {
    "poem_id": 1670,
    "vorder": 184,
    "position": 1,
    "text": "بلند آسمانش هوای وی است"
  },
  {
    "poem_id": 1670,
    "vorder": 185,
    "position": 0,
    "text": "وگر مردوش باشد و سرفراز"
  },
  {
    "poem_id": 1670,
    "vorder": 186,
    "position": 1,
    "text": "بسوی هرومش فرستند باز"
  },
  {
    "poem_id": 1670,
    "vorder": 187,
    "position": 0,
    "text": "وگر زو پسر زاید آنجا که هست"
  },
  {
    "poem_id": 1670,
    "vorder": 188,
    "position": 1,
    "text": "بباشد نباشد بر ماش دست"
  },
  {
    "poem_id": 1670,
    "vorder": 189,
    "position": 0,
    "text": "ز ما هرک او روزگار نبرد"
  },
  {
    "poem_id": 1670,
    "vorder": 190,
    "position": 1,
    "text": "از اسپ اندر آرد یکی شیرمرد"
  },
  {
    "poem_id": 1670,
    "vorder": 191,
    "position": 0,
    "text": "یکی تاج زرینش بر سر نهیم"
  },
  {
    "poem_id": 1670,
    "vorder": 192,
    "position": 1,
    "text": "همان تخت او بر دو پیکر نهیم"
  },
  {
    "poem_id": 1670,
    "vorder": 193,
    "position": 0,
    "text": "همانا ز ما زن بود سی‌هزار"
  },
  {
    "poem_id": 1670,
    "vorder": 194,
    "position": 1,
    "text": "که با تاج زرند و با گوشوار"
  },
  {
    "poem_id": 1670,
    "vorder": 195,
    "position": 0,
    "text": "که مردی ز گردنکشان روز جنگ"
  },
  {
    "poem_id": 1670,
    "vorder": 196,
    "position": 1,
    "text": "به چنگال او خاک شد بی‌درنگ"
  },
  {
    "poem_id": 1670,
    "vorder": 197,
    "position": 0,
    "text": "تو مردی بزرگی و نامت بلند"
  },
  {
    "poem_id": 1670,
    "vorder": 198,
    "position": 1,
    "text": "در نام بر خویشتن در مبند"
  },
  {
    "poem_id": 1670,
    "vorder": 199,
    "position": 0,
    "text": "که گویند با زن برآویختنی"
  },
  {
    "poem_id": 1670,
    "vorder": 200,
    "position": 1,
    "text": "ز آویختن نیز بگریختی"
  },
  {
    "poem_id": 1670,
    "vorder": 201,
    "position": 0,
    "text": "یکی ننگ باشد ترا زین سخن"
  },
  {
    "poem_id": 1670,
    "vorder": 202,
    "position": 1,
    "text": "که تا هست گیتی نگردد کهن"
  },
  {
    "poem_id": 1670,
    "vorder": 203,
    "position": 0,
    "text": "چه خواهی که با نامداران روم"
  },
  {
    "poem_id": 1670,
    "vorder": 204,
    "position": 1,
    "text": "بیایی بگردی به مرز هروم"
  },
  {
    "poem_id": 1670,
    "vorder": 205,
    "position": 0,
    "text": "چو با راستی باشی و مردمی"
  },
  {
    "poem_id": 1670,
    "vorder": 206,
    "position": 1,
    "text": "نبینی جز از خوبی و خرمی"
  },
  {
    "poem_id": 1670,
    "vorder": 207,
    "position": 0,
    "text": "به پیش تو آریم چندان سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 208,
    "position": 1,
    "text": "که تیره شود بر تو خورشید و ماه"
  },
  {
    "poem_id": 1670,
    "vorder": 209,
    "position": 0,
    "text": "چو آن پاسخ نامه شد اسپری"
  },
  {
    "poem_id": 1670,
    "vorder": 210,
    "position": 1,
    "text": "زنی بود گویا به پیغمبری"
  },
  {
    "poem_id": 1670,
    "vorder": 211,
    "position": 0,
    "text": "ابا تاج و با جامهٔ شاهوار"
  },
  {
    "poem_id": 1670,
    "vorder": 212,
    "position": 1,
    "text": "همی رفت با خوب‌رخ ده سوار"
  },
  {
    "poem_id": 1670,
    "vorder": 213,
    "position": 0,
    "text": "چو آمد خرامان به نزدیک شاه"
  },
  {
    "poem_id": 1670,
    "vorder": 214,
    "position": 1,
    "text": "پذیره فرستاد چندی به راه"
  },
  {
    "poem_id": 1670,
    "vorder": 215,
    "position": 0,
    "text": "زن نامبردار نامه بداد"
  },
  {
    "poem_id": 1670,
    "vorder": 216,
    "position": 1,
    "text": "پیام دلیران همه کرد یاد"
  },
  {
    "poem_id": 1670,
    "vorder": 217,
    "position": 0,
    "text": "سکندر چو آن پاسخ نامه دید"
  },
  {
    "poem_id": 1670,
    "vorder": 218,
    "position": 1,
    "text": "خردمند و بینادلی برگزید"
  },
  {
    "poem_id": 1670,
    "vorder": 219,
    "position": 0,
    "text": "بدیشان پیامی فرستاد و گفت"
  },
  {
    "poem_id": 1670,
    "vorder": 220,
    "position": 1,
    "text": "که با مغز مردم خرد باد جفت"
  },
  {
    "poem_id": 1670,
    "vorder": 221,
    "position": 0,
    "text": "به گرد جهان شهریاری نماند"
  },
  {
    "poem_id": 1670,
    "vorder": 222,
    "position": 1,
    "text": "همان بر زمین نامداری نماند"
  },
  {
    "poem_id": 1670,
    "vorder": 223,
    "position": 0,
    "text": "که نه سربسر پیش من کهترند"
  },
  {
    "poem_id": 1670,
    "vorder": 224,
    "position": 1,
    "text": "وگرچه بلندند و نیک‌اخترند"
  },
  {
    "poem_id": 1670,
    "vorder": 225,
    "position": 0,
    "text": "مرا گرد کافور و خاک سیاه"
  },
  {
    "poem_id": 1670,
    "vorder": 226,
    "position": 1,
    "text": "همانست و هم بزم و هم رزمگاه"
  },
  {
    "poem_id": 1670,
    "vorder": 227,
    "position": 0,
    "text": "نه من جنگ را آمدم تازیان"
  },
  {
    "poem_id": 1670,
    "vorder": 228,
    "position": 1,
    "text": "به پیلان و کوس و تبیره زنان"
  },
  {
    "poem_id": 1670,
    "vorder": 229,
    "position": 0,
    "text": "سپاهی برین سان که هامون و کوه"
  },
  {
    "poem_id": 1670,
    "vorder": 230,
    "position": 1,
    "text": "همی گردد از سم اسپان ستوه"
  },
  {
    "poem_id": 1670,
    "vorder": 231,
    "position": 0,
    "text": "مرا رای دیدار شهر شماست"
  },
  {
    "poem_id": 1670,
    "vorder": 232,
    "position": 1,
    "text": "گر آیید نزدیک ما هم رواست"
  },
  {
    "poem_id": 1670,
    "vorder": 233,
    "position": 0,
    "text": "چو دیدار باشد برانم سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 234,
    "position": 1,
    "text": "نباشم فراوان بدین جایگاه"
  },
  {
    "poem_id": 1670,
    "vorder": 235,
    "position": 0,
    "text": "ببینیم تا چیستتان رای و فر"
  },
  {
    "poem_id": 1670,
    "vorder": 236,
    "position": 1,
    "text": "سواری و زیبایی و پای و پر"
  },
  {
    "poem_id": 1670,
    "vorder": 237,
    "position": 0,
    "text": "ز کار زهشتان بپرسم نهان"
  },
  {
    "poem_id": 1670,
    "vorder": 238,
    "position": 1,
    "text": "که بی‌مرد زن چون بود در جهان"
  },
  {
    "poem_id": 1670,
    "vorder": 239,
    "position": 0,
    "text": "اگر مرگ باشد فزونی ز کیست"
  },
  {
    "poem_id": 1670,
    "vorder": 240,
    "position": 1,
    "text": "به بینم که فرجام این کار چیست"
  },
  {
    "poem_id": 1670,
    "vorder": 241,
    "position": 0,
    "text": "فرستاده آمد سخنها بگفت"
  },
  {
    "poem_id": 1670,
    "vorder": 242,
    "position": 1,
    "text": "همه راز بیرون کشید از نهفت"
  },
  {
    "poem_id": 1670,
    "vorder": 243,
    "position": 0,
    "text": "بزرگان یکی انجمن ساختند"
  },
  {
    "poem_id": 1670,
    "vorder": 244,
    "position": 1,
    "text": "ز گفتار دل را بپرداختند"
  },
  {
    "poem_id": 1670,
    "vorder": 245,
    "position": 0,
    "text": "که ما برگزیدیم زن دو هزار"
  },
  {
    "poem_id": 1670,
    "vorder": 246,
    "position": 1,
    "text": "سخن‌گوی و داننده و هوشیار"
  },
  {
    "poem_id": 1670,
    "vorder": 247,
    "position": 0,
    "text": "ابا هر صدی بسته ده تاج زر"
  },
  {
    "poem_id": 1670,
    "vorder": 248,
    "position": 1,
    "text": "بدو در نشانده فراوان گهر"
  },
  {
    "poem_id": 1670,
    "vorder": 249,
    "position": 0,
    "text": "چو گرد آید آن تاج باشد دویست"
  },
  {
    "poem_id": 1670,
    "vorder": 250,
    "position": 1,
    "text": "که هر یک جز اندر خور شاه نیست"
  },
  {
    "poem_id": 1670,
    "vorder": 251,
    "position": 0,
    "text": "یکایک بسختیم و کردیم تل"
  },
  {
    "poem_id": 1670,
    "vorder": 252,
    "position": 1,
    "text": "اباگوهران هر یکی سی رطل"
  },
  {
    "poem_id": 1670,
    "vorder": 253,
    "position": 0,
    "text": "چو دانیم کامد به نزدیک شاه"
  },
  {
    "poem_id": 1670,
    "vorder": 254,
    "position": 1,
    "text": "یکایک پذیره شویمش به راه"
  },
  {
    "poem_id": 1670,
    "vorder": 255,
    "position": 0,
    "text": "چو آمد به نزدیک ما آگهی"
  },
  {
    "poem_id": 1670,
    "vorder": 256,
    "position": 1,
    "text": "ز دانایی شاه وز فرهی"
  },
  {
    "poem_id": 1670,
    "vorder": 257,
    "position": 0,
    "text": "فرستاده برگشت و پاسخ بگفت"
  },
  {
    "poem_id": 1670,
    "vorder": 258,
    "position": 1,
    "text": "سخنها همه با خرد بود جفت"
  },
  {
    "poem_id": 1670,
    "vorder": 259,
    "position": 0,
    "text": "سکندر ز منزل سپه برگرفت"
  },
  {
    "poem_id": 1670,
    "vorder": 260,
    "position": 1,
    "text": "ز کار زنان مانده اندر شگفت"
  },
  {
    "poem_id": 1670,
    "vorder": 261,
    "position": 0,
    "text": "دو منزل بیامد یکی باد خاست"
  },
  {
    "poem_id": 1670,
    "vorder": 262,
    "position": 1,
    "text": "وزو برف با کوه و درگشت راست"
  },
  {
    "poem_id": 1670,
    "vorder": 263,
    "position": 0,
    "text": "تبه شد بسی مردم پایکار"
  },
  {
    "poem_id": 1670,
    "vorder": 264,
    "position": 1,
    "text": "ز سرما و برف اندر آن روزگار"
  },
  {
    "poem_id": 1670,
    "vorder": 265,
    "position": 0,
    "text": "برآمد یکی ابر و دودی سیاه"
  },
  {
    "poem_id": 1670,
    "vorder": 266,
    "position": 1,
    "text": "بر آتش همی رفت گفتی سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 267,
    "position": 0,
    "text": "زره کتف آزادگان را بسوخت"
  },
  {
    "poem_id": 1670,
    "vorder": 268,
    "position": 1,
    "text": "ز نعل سواران زمین برفروخت"
  },
  {
    "poem_id": 1670,
    "vorder": 269,
    "position": 0,
    "text": "بدین هم نشان تا به شهری رسید"
  },
  {
    "poem_id": 1670,
    "vorder": 270,
    "position": 1,
    "text": "که مردم بسان شب تیره دید"
  },
  {
    "poem_id": 1670,
    "vorder": 271,
    "position": 0,
    "text": "فروهشته لفچ و برآورده کفچ"
  },
  {
    "poem_id": 1670,
    "vorder": 272,
    "position": 1,
    "text": "به کردار قیر و شبه کفچ و لفچ"
  },
  {
    "poem_id": 1670,
    "vorder": 273,
    "position": 0,
    "text": "همه دیده‌هاشان به کردار خون"
  },
  {
    "poem_id": 1670,
    "vorder": 274,
    "position": 1,
    "text": "همی از دهان آتش آمد برون"
  },
  {
    "poem_id": 1670,
    "vorder": 275,
    "position": 0,
    "text": "بسی پیل بردند پیشش به راه"
  },
  {
    "poem_id": 1670,
    "vorder": 276,
    "position": 1,
    "text": "همان هدیه مردمان سیاه"
  },
  {
    "poem_id": 1670,
    "vorder": 277,
    "position": 0,
    "text": "بگفتند کین برف و باد دمان"
  },
  {
    "poem_id": 1670,
    "vorder": 278,
    "position": 1,
    "text": "ز ما بود کامد شما را زیان"
  },
  {
    "poem_id": 1670,
    "vorder": 279,
    "position": 0,
    "text": "که هرگز بدین شهر نگذشت کس"
  },
  {
    "poem_id": 1670,
    "vorder": 280,
    "position": 1,
    "text": "ترا و سپاه تو دیدیم و بس"
  },
  {
    "poem_id": 1670,
    "vorder": 281,
    "position": 0,
    "text": "ببود اندر آن شهر یک ماه شاه"
  },
  {
    "poem_id": 1670,
    "vorder": 282,
    "position": 1,
    "text": "چو آسوده گشتند شاه و سپاه"
  },
  {
    "poem_id": 1670,
    "vorder": 283,
    "position": 0,
    "text": "ازنجا بیامد دمان و دنان"
  },
  {
    "poem_id": 1670,
    "vorder": 284,
    "position": 1,
    "text": "دل‌آراسته سوی شهر زنان"
  },
  {
    "poem_id": 1670,
    "vorder": 285,
    "position": 0,
    "text": "ز دریا گذر کرد زن دو هزار"
  },
  {
    "poem_id": 1670,
    "vorder": 286,
    "position": 1,
    "text": "همه پاک با افسر و گوشوار"
  },
  {
    "poem_id": 1670,
    "vorder": 287,
    "position": 0,
    "text": "یکی بیشه بد پر ز آب و درخت"
  },
  {
    "poem_id": 1670,
    "vorder": 288,
    "position": 1,
    "text": "همه جای روشن‌دل و نیکبخت"
  },
  {
    "poem_id": 1670,
    "vorder": 289,
    "position": 0,
    "text": "خورش گرد کردند بر مرغزار"
  },
  {
    "poem_id": 1670,
    "vorder": 290,
    "position": 1,
    "text": "ز گستردنیها به رنگ و نگار"
  },
  {
    "poem_id": 1670,
    "vorder": 291,
    "position": 0,
    "text": "چو آمد سکندر به شهر هروم"
  },
  {
    "poem_id": 1670,
    "vorder": 292,
    "position": 1,
    "text": "زنان پیش رفتند ز آباد بوم"
  },
  {
    "poem_id": 1670,
    "vorder": 293,
    "position": 0,
    "text": "ببردند پس تاجها پیش اوی"
  },
  {
    "poem_id": 1670,
    "vorder": 294,
    "position": 1,
    "text": "همان جامه و گوهر و رنگ و بوی"
  },
  {
    "poem_id": 1670,
    "vorder": 295,
    "position": 0,
    "text": "سکندر بپذرفت و بنواختشان"
  },
  {
    "poem_id": 1670,
    "vorder": 296,
    "position": 1,
    "text": "بران خرمی جایگه ساختشان"
  },
  {
    "poem_id": 1670,
    "vorder": 297,
    "position": 0,
    "text": "چو شب روز شد اندرآمد به شهر"
  },
  {
    "poem_id": 1670,
    "vorder": 298,
    "position": 1,
    "text": "به دیدار برداشت زان شهر بهر"
  },
  {
    "poem_id": 1670,
    "vorder": 299,
    "position": 0,
    "text": "کم و بیش ایشان همی بازجست"
  },
  {
    "poem_id": 1670,
    "vorder": 300,
    "position": 1,
    "text": "همی بود تا رازها شد درست"
  }
]