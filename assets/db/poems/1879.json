[
  {
    "poem_id": 1879,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس چو بشنید بهرام گرد"
  },
  {
    "poem_id": 1879,
    "vorder": 2,
    "position": 1,
    "text": "کز ایران به خاقان کسی نامه برد"
  },
  {
    "poem_id": 1879,
    "vorder": 3,
    "position": 0,
    "text": "بیامد دمان پیش خاقان چین"
  },
  {
    "poem_id": 1879,
    "vorder": 4,
    "position": 1,
    "text": "بدو گفت کای مهتر به آفرین"
  },
  {
    "poem_id": 1879,
    "vorder": 5,
    "position": 0,
    "text": "شنیدم که آن ریمن بد هنر"
  },
  {
    "poem_id": 1879,
    "vorder": 6,
    "position": 1,
    "text": "همی نامه سازد یک اندر دگر"
  },
  {
    "poem_id": 1879,
    "vorder": 7,
    "position": 0,
    "text": "سپاهی دلاور ز چین برگزین"
  },
  {
    "poem_id": 1879,
    "vorder": 8,
    "position": 1,
    "text": "بدان تا تو را گردد ایران زمین"
  },
  {
    "poem_id": 1879,
    "vorder": 9,
    "position": 0,
    "text": "بگیرم به شمشیر ایران و روم"
  },
  {
    "poem_id": 1879,
    "vorder": 10,
    "position": 1,
    "text": "تو راشاه خوانم بران مرز و بوم"
  },
  {
    "poem_id": 1879,
    "vorder": 11,
    "position": 0,
    "text": "بنام تو بر پاسبانان به شب"
  },
  {
    "poem_id": 1879,
    "vorder": 12,
    "position": 1,
    "text": "به ایران و توران گشایند لب"
  },
  {
    "poem_id": 1879,
    "vorder": 13,
    "position": 0,
    "text": "ببرم سر خسرو بی‌هنر"
  },
  {
    "poem_id": 1879,
    "vorder": 14,
    "position": 1,
    "text": "که مه پای بادا ازیشان مه سر"
  },
  {
    "poem_id": 1879,
    "vorder": 15,
    "position": 0,
    "text": "چون من کهتری را ببندم میان"
  },
  {
    "poem_id": 1879,
    "vorder": 16,
    "position": 1,
    "text": "ز بن برکنم تخم ساسانیان"
  },
  {
    "poem_id": 1879,
    "vorder": 17,
    "position": 0,
    "text": "چو بشنید خاقان پر اندیشه شد"
  },
  {
    "poem_id": 1879,
    "vorder": 18,
    "position": 1,
    "text": "ورا در دل اندیشه چون بیشه شد"
  },
  {
    "poem_id": 1879,
    "vorder": 19,
    "position": 0,
    "text": "بخواند آنکس‌ان را که بودند پیر"
  },
  {
    "poem_id": 1879,
    "vorder": 20,
    "position": 1,
    "text": "سخنگوی و داننده و یادگیر"
  },
  {
    "poem_id": 1879,
    "vorder": 21,
    "position": 0,
    "text": "بدیشان بگفت آنچ بهرام گفت"
  },
  {
    "poem_id": 1879,
    "vorder": 22,
    "position": 1,
    "text": "همه رازها برگشاد از نهفت"
  },
  {
    "poem_id": 1879,
    "vorder": 23,
    "position": 0,
    "text": "چنین یافت پاسخ ز فرزانگان"
  },
  {
    "poem_id": 1879,
    "vorder": 24,
    "position": 1,
    "text": "ز خویشان نزدیک و بیگانگان"
  },
  {
    "poem_id": 1879,
    "vorder": 25,
    "position": 0,
    "text": "که این کارخوارست و دشوارنیز"
  },
  {
    "poem_id": 1879,
    "vorder": 26,
    "position": 1,
    "text": "که بر تخم ساسان پرآمد قفیز"
  },
  {
    "poem_id": 1879,
    "vorder": 27,
    "position": 0,
    "text": "ولیکن چو بهرم راند سپاه"
  },
  {
    "poem_id": 1879,
    "vorder": 28,
    "position": 1,
    "text": "نماید خردمند را رای و راه"
  },
  {
    "poem_id": 1879,
    "vorder": 29,
    "position": 0,
    "text": "به ایران بسی دوستدارش بود"
  },
  {
    "poem_id": 1879,
    "vorder": 30,
    "position": 1,
    "text": "چو خاقان یکی خویش و یارش بود"
  },
  {
    "poem_id": 1879,
    "vorder": 31,
    "position": 0,
    "text": "برآید ببخت تو این کار زود"
  },
  {
    "poem_id": 1879,
    "vorder": 32,
    "position": 1,
    "text": "سخنهای بهرام باید شنود"
  },
  {
    "poem_id": 1879,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید بهرام دل تازه شد"
  },
  {
    "poem_id": 1879,
    "vorder": 34,
    "position": 1,
    "text": "بخندید و بر دیگر اندازه شد"
  },
  {
    "poem_id": 1879,
    "vorder": 35,
    "position": 0,
    "text": "بران برنهادند یکسر گوان"
  },
  {
    "poem_id": 1879,
    "vorder": 36,
    "position": 1,
    "text": "که بگزید باید دو مردجوان"
  },
  {
    "poem_id": 1879,
    "vorder": 37,
    "position": 0,
    "text": "که زیبد بران هر دو بر مهتری"
  },
  {
    "poem_id": 1879,
    "vorder": 38,
    "position": 1,
    "text": "همان رنج کش باید و لشکری"
  },
  {
    "poem_id": 1879,
    "vorder": 39,
    "position": 0,
    "text": "به چین مهتری بود حسنوی نام"
  },
  {
    "poem_id": 1879,
    "vorder": 40,
    "position": 1,
    "text": "دگر سرکشی بود زنگوی نام"
  },
  {
    "poem_id": 1879,
    "vorder": 41,
    "position": 0,
    "text": "فرستاد خاقان یلان رابخواند"
  },
  {
    "poem_id": 1879,
    "vorder": 42,
    "position": 1,
    "text": "به دیوان دینار دادن نشاند"
  },
  {
    "poem_id": 1879,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت مهتر بدین هر دو مرد"
  },
  {
    "poem_id": 1879,
    "vorder": 44,
    "position": 1,
    "text": "که هشیار باشید روز نبرد"
  },
  {
    "poem_id": 1879,
    "vorder": 45,
    "position": 0,
    "text": "همیشه به بهرام دارید چشم"
  },
  {
    "poem_id": 1879,
    "vorder": 46,
    "position": 1,
    "text": "چه هنگام شادی چه هنگام خشم"
  },
  {
    "poem_id": 1879,
    "vorder": 47,
    "position": 0,
    "text": "گذرهای جیحون بدارید پاک"
  },
  {
    "poem_id": 1879,
    "vorder": 48,
    "position": 1,
    "text": "ز جیحون به گردون برآرید خاک"
  },
  {
    "poem_id": 1879,
    "vorder": 49,
    "position": 0,
    "text": "سپاهی دلاور بدیشان سپرد"
  },
  {
    "poem_id": 1879,
    "vorder": 50,
    "position": 1,
    "text": "همه نامداران و شیران گرد"
  },
  {
    "poem_id": 1879,
    "vorder": 51,
    "position": 0,
    "text": "برآمد ز درگاه بهرام کوس"
  },
  {
    "poem_id": 1879,
    "vorder": 52,
    "position": 1,
    "text": "رخ خورشد از گرد چون آبنوس"
  },
  {
    "poem_id": 1879,
    "vorder": 53,
    "position": 0,
    "text": "ز چین روی یکسر به ایران نهاد"
  },
  {
    "poem_id": 1879,
    "vorder": 54,
    "position": 1,
    "text": "به روز سفندار مذ بامداد"
  }
]