[
  {
    "poem_id": 88082,
    "vorder": 1,
    "position": 0,
    "text": "به جیحون گذر کرد بر سوی بلخ"
  },
  {
    "poem_id": 88082,
    "vorder": 2,
    "position": 1,
    "text": "چشیده ز گیتی بسی شور و تلخ"
  },
  {
    "poem_id": 88082,
    "vorder": 3,
    "position": 0,
    "text": "به بلخ اندرون بود یک ماه شاه"
  },
  {
    "poem_id": 88082,
    "vorder": 4,
    "position": 1,
    "text": "سر ماه بر بلخ بگزید راه"
  },
  {
    "poem_id": 88082,
    "vorder": 5,
    "position": 0,
    "text": "به هر شهر در نامور مهتری"
  },
  {
    "poem_id": 88082,
    "vorder": 6,
    "position": 1,
    "text": "بماندی سرافراز با لشکری"
  },
  {
    "poem_id": 88082,
    "vorder": 7,
    "position": 0,
    "text": "ببستند آذین به بیراه و راه"
  },
  {
    "poem_id": 88082,
    "vorder": 8,
    "position": 1,
    "text": "به جایی که بگذشت شاه و سپاه"
  },
  {
    "poem_id": 88082,
    "vorder": 9,
    "position": 0,
    "text": "همه بوم کشور بیاراستند"
  },
  {
    "poem_id": 88082,
    "vorder": 10,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 88082,
    "vorder": 11,
    "position": 0,
    "text": "درم ریختند از بر و زعفران"
  },
  {
    "poem_id": 88082,
    "vorder": 12,
    "position": 1,
    "text": "چه دینار و مشک از کران تا کران"
  },
  {
    "poem_id": 88082,
    "vorder": 13,
    "position": 0,
    "text": "به شهر اندرون هر که درویش بود"
  },
  {
    "poem_id": 88082,
    "vorder": 14,
    "position": 1,
    "text": "وگر سازش از کوشش خویش بود"
  },
  {
    "poem_id": 88082,
    "vorder": 15,
    "position": 0,
    "text": "درم داد مر هر یکی را ز گنج"
  },
  {
    "poem_id": 88082,
    "vorder": 16,
    "position": 1,
    "text": "پراگنده شد بدره پنجاه و پنج"
  },
  {
    "poem_id": 88082,
    "vorder": 17,
    "position": 0,
    "text": "سر هفته را کرد آهنگ ری"
  },
  {
    "poem_id": 88082,
    "vorder": 18,
    "position": 1,
    "text": "سوی پارس نزدیک کاووس کی"
  },
  {
    "poem_id": 88082,
    "vorder": 19,
    "position": 0,
    "text": "دو هفته به ری نیز بخشید و خورد"
  },
  {
    "poem_id": 88082,
    "vorder": 20,
    "position": 1,
    "text": "سیم هفته آهنگ بغداد کرد"
  },
  {
    "poem_id": 88082,
    "vorder": 21,
    "position": 0,
    "text": "هیونان فرستاد چندی ز ری"
  },
  {
    "poem_id": 88082,
    "vorder": 22,
    "position": 1,
    "text": "به نزدیک کاووس فرخنده‌پی"
  },
  {
    "poem_id": 88082,
    "vorder": 23,
    "position": 0,
    "text": "دل پیر زان آگهی تازه شد"
  },
  {
    "poem_id": 88082,
    "vorder": 24,
    "position": 1,
    "text": "تو گفتی که بر دیگر اندازه شد"
  },
  {
    "poem_id": 88082,
    "vorder": 25,
    "position": 0,
    "text": "به ایوانها تخت زرین نهاد"
  },
  {
    "poem_id": 88082,
    "vorder": 26,
    "position": 1,
    "text": "به خانه در آرایش چین نهاد"
  },
  {
    "poem_id": 88082,
    "vorder": 27,
    "position": 0,
    "text": "ببستند آذین به شهر و به راه"
  },
  {
    "poem_id": 88082,
    "vorder": 28,
    "position": 1,
    "text": "همه برزن و کوی و بازارگاه"
  },
  {
    "poem_id": 88082,
    "vorder": 29,
    "position": 0,
    "text": "پذیره شدندش همه مهتران"
  },
  {
    "poem_id": 88082,
    "vorder": 30,
    "position": 1,
    "text": "بزرگان هر شهر و کنداوران"
  },
  {
    "poem_id": 88082,
    "vorder": 31,
    "position": 0,
    "text": "همه راه و بی راه گنبد زده"
  },
  {
    "poem_id": 88082,
    "vorder": 32,
    "position": 1,
    "text": "جهان شد چو دیبا به زر آزده"
  },
  {
    "poem_id": 88082,
    "vorder": 33,
    "position": 0,
    "text": "همه مشک با گوهر آمیختند"
  },
  {
    "poem_id": 88082,
    "vorder": 34,
    "position": 1,
    "text": "ز گنبد به سرها فرو ریختند"
  },
  {
    "poem_id": 88082,
    "vorder": 35,
    "position": 0,
    "text": "چو بیرون شد از شهر کاووس کی"
  },
  {
    "poem_id": 88082,
    "vorder": 36,
    "position": 1,
    "text": "ابا نامداران فرخنده‌پی"
  },
  {
    "poem_id": 88082,
    "vorder": 37,
    "position": 0,
    "text": "سوی طالقان آمد و مرو رود"
  },
  {
    "poem_id": 88082,
    "vorder": 38,
    "position": 1,
    "text": "جهان بود پر بانگ و آوای رود"
  },
  {
    "poem_id": 88082,
    "vorder": 39,
    "position": 0,
    "text": "و زآن پس به راه نشاپور شاه"
  },
  {
    "poem_id": 88082,
    "vorder": 40,
    "position": 1,
    "text": "بدیدند مر یکدگر را به راه"
  },
  {
    "poem_id": 88082,
    "vorder": 41,
    "position": 0,
    "text": "نیا را چو دید از کران شاه نو"
  },
  {
    "poem_id": 88082,
    "vorder": 42,
    "position": 1,
    "text": "برانگیخت آن باره تندرو"
  },
  {
    "poem_id": 88082,
    "vorder": 43,
    "position": 0,
    "text": "بر او بر نیا برگرفت آفرین"
  },
  {
    "poem_id": 88082,
    "vorder": 44,
    "position": 1,
    "text": "ستایش سزای جهان آفرین"
  },
  {
    "poem_id": 88082,
    "vorder": 45,
    "position": 0,
    "text": "همی گفت بی‌تو مبادا جهان"
  },
  {
    "poem_id": 88082,
    "vorder": 46,
    "position": 1,
    "text": "نه تخت بزرگی نه تاج مهان"
  },
  {
    "poem_id": 88082,
    "vorder": 47,
    "position": 0,
    "text": "که خورشید چون تو ندیدست شاه"
  },
  {
    "poem_id": 88082,
    "vorder": 48,
    "position": 1,
    "text": "نه جوشن نه اسب و نه تخت و کلاه"
  },
  {
    "poem_id": 88082,
    "vorder": 49,
    "position": 0,
    "text": "ز جمشید تا بآفریدون رسید"
  },
  {
    "poem_id": 88082,
    "vorder": 50,
    "position": 1,
    "text": "سپهر و زمین چون تو شاهی ندید"
  },
  {
    "poem_id": 88082,
    "vorder": 51,
    "position": 0,
    "text": "نه زین سان کسی رنج برد از مهان"
  },
  {
    "poem_id": 88082,
    "vorder": 52,
    "position": 1,
    "text": "نه دید آشکارا نهان جهان"
  },
  {
    "poem_id": 88082,
    "vorder": 53,
    "position": 0,
    "text": "که روشن جهان بر تو فرخنده باد"
  },
  {
    "poem_id": 88082,
    "vorder": 54,
    "position": 1,
    "text": "دل و جان بدخواه تو کنده باد"
  },
  {
    "poem_id": 88082,
    "vorder": 55,
    "position": 0,
    "text": "سیاوش گرش روز باز آمدی"
  },
  {
    "poem_id": 88082,
    "vorder": 56,
    "position": 1,
    "text": "به فر تو او را نیاز آمدی"
  },
  {
    "poem_id": 88082,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت شاه این ز بخت تو بود"
  },
  {
    "poem_id": 88082,
    "vorder": 58,
    "position": 1,
    "text": "برومند شاخ درخت تو بود"
  },
  {
    "poem_id": 88082,
    "vorder": 59,
    "position": 0,
    "text": "زبرجد بیاورد و یاقوت و زر"
  },
  {
    "poem_id": 88082,
    "vorder": 60,
    "position": 1,
    "text": "همی ریخت بر تارک شاه بر"
  },
  {
    "poem_id": 88082,
    "vorder": 61,
    "position": 0,
    "text": "بدین گونه تا تخت گوهرنگار"
  },
  {
    "poem_id": 88082,
    "vorder": 62,
    "position": 1,
    "text": "بشد پایه ها ناپدید از نثار"
  },
  {
    "poem_id": 88082,
    "vorder": 63,
    "position": 0,
    "text": "بفرمود پس کانجمن را بخوان"
  },
  {
    "poem_id": 88082,
    "vorder": 64,
    "position": 1,
    "text": "به ایوان دیگر بیارای خوان"
  },
  {
    "poem_id": 88082,
    "vorder": 65,
    "position": 0,
    "text": "نشستند در گلشن زرنگار"
  },
  {
    "poem_id": 88082,
    "vorder": 66,
    "position": 1,
    "text": "بزرگان پرمایه با شهریار"
  },
  {
    "poem_id": 88082,
    "vorder": 67,
    "position": 0,
    "text": "همی گفت شاه آن شگفتی که دید"
  },
  {
    "poem_id": 88082,
    "vorder": 68,
    "position": 1,
    "text": "به دریا در و نامداران شنید"
  },
  {
    "poem_id": 88082,
    "vorder": 69,
    "position": 0,
    "text": "ز دریا و از گنگ دژ یاد کرد"
  },
  {
    "poem_id": 88082,
    "vorder": 70,
    "position": 1,
    "text": "لب نامداران پر از باد کرد"
  },
  {
    "poem_id": 88082,
    "vorder": 71,
    "position": 0,
    "text": "از آن خرمی دشت و آن شهر و راغ"
  },
  {
    "poem_id": 88082,
    "vorder": 72,
    "position": 1,
    "text": "شمرها و پالیزها چون چراغ"
  },
  {
    "poem_id": 88082,
    "vorder": 73,
    "position": 0,
    "text": "بدو ماند کاووس کی در شگفت"
  },
  {
    "poem_id": 88082,
    "vorder": 74,
    "position": 1,
    "text": "ز کردارش اندازه‌ها برگرفت"
  },
  {
    "poem_id": 88082,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت روز نو و ماه نو"
  },
  {
    "poem_id": 88082,
    "vorder": 76,
    "position": 1,
    "text": "چو گفتارهای نو و شاه نو"
  },
  {
    "poem_id": 88082,
    "vorder": 77,
    "position": 0,
    "text": "نه کس چون تو اندر جهان شاه دید"
  },
  {
    "poem_id": 88082,
    "vorder": 78,
    "position": 1,
    "text": "نه این داستان گوش هر کس شنید"
  },
  {
    "poem_id": 88082,
    "vorder": 79,
    "position": 0,
    "text": "کنون تا بدین اختری نو کنیم"
  },
  {
    "poem_id": 88082,
    "vorder": 80,
    "position": 1,
    "text": "به مردی همه یاد خسرو کنیم"
  },
  {
    "poem_id": 88082,
    "vorder": 81,
    "position": 0,
    "text": "بیاراست آن گلشن زرنگار"
  },
  {
    "poem_id": 88082,
    "vorder": 82,
    "position": 1,
    "text": "می آورد یاقوت‌لب میگسار"
  },
  {
    "poem_id": 88082,
    "vorder": 83,
    "position": 0,
    "text": "به یک هفته ز ایوان کاووس کی"
  },
  {
    "poem_id": 88082,
    "vorder": 84,
    "position": 1,
    "text": "همی موج برخاست از جام می"
  },
  {
    "poem_id": 88082,
    "vorder": 85,
    "position": 0,
    "text": "به هشتم در گنج بگشاد شاه"
  },
  {
    "poem_id": 88082,
    "vorder": 86,
    "position": 1,
    "text": "همی ساخت آن رنج را پایگاه"
  },
  {
    "poem_id": 88082,
    "vorder": 87,
    "position": 0,
    "text": "بزرگان که بودند با او به هم"
  },
  {
    "poem_id": 88082,
    "vorder": 88,
    "position": 1,
    "text": "به رزم و به بزم و به شادی و غم"
  },
  {
    "poem_id": 88082,
    "vorder": 89,
    "position": 0,
    "text": "به اندازه‌شان خلعت آراستند"
  },
  {
    "poem_id": 88082,
    "vorder": 90,
    "position": 1,
    "text": "ز گنج آنچه پرمایه‌تر خواستند"
  },
  {
    "poem_id": 88082,
    "vorder": 91,
    "position": 0,
    "text": "برفتند هر کس سوی کشوری"
  },
  {
    "poem_id": 88082,
    "vorder": 92,
    "position": 1,
    "text": "سرافراز با نامور لشکری"
  },
  {
    "poem_id": 88082,
    "vorder": 93,
    "position": 0,
    "text": "بپرداخت زآن پس به کار سپاه"
  },
  {
    "poem_id": 88082,
    "vorder": 94,
    "position": 1,
    "text": "درم داد یک‌ساله از گنج شاه"
  },
  {
    "poem_id": 88082,
    "vorder": 95,
    "position": 0,
    "text": "وزآن پس نشستند بی‌انجمن"
  },
  {
    "poem_id": 88082,
    "vorder": 96,
    "position": 1,
    "text": "نیا و جهانجوی با رای‌زن"
  },
  {
    "poem_id": 88082,
    "vorder": 97,
    "position": 0,
    "text": "چنین گفت خسرو به کاووس شاه"
  },
  {
    "poem_id": 88082,
    "vorder": 98,
    "position": 1,
    "text": "جز از کردگار از که جوییم راه"
  },
  {
    "poem_id": 88082,
    "vorder": 99,
    "position": 0,
    "text": "بیابان و یک‌ساله دریا و کوه"
  },
  {
    "poem_id": 88082,
    "vorder": 100,
    "position": 1,
    "text": "برفتیم با داغ دل یک گروه"
  },
  {
    "poem_id": 88082,
    "vorder": 101,
    "position": 0,
    "text": "به هامون و کوه و به دریای آب"
  },
  {
    "poem_id": 88082,
    "vorder": 102,
    "position": 1,
    "text": "نشانی ندیدیم ز افراسیاب"
  },
  {
    "poem_id": 88082,
    "vorder": 103,
    "position": 0,
    "text": "گر او یک زمان اندر آید به گنگ"
  },
  {
    "poem_id": 88082,
    "vorder": 104,
    "position": 1,
    "text": "سپاه آرد از هر سویی بیدرنگ"
  },
  {
    "poem_id": 88082,
    "vorder": 105,
    "position": 0,
    "text": "همه رنج و سختی به پیش اندرست"
  },
  {
    "poem_id": 88082,
    "vorder": 106,
    "position": 1,
    "text": "اگر چندمان دادگر یاورست"
  },
  {
    "poem_id": 88082,
    "vorder": 107,
    "position": 0,
    "text": "نیا چون شنید از نبیره سخن"
  },
  {
    "poem_id": 88082,
    "vorder": 108,
    "position": 1,
    "text": "یکی پند پیرانه افگند بن"
  },
  {
    "poem_id": 88082,
    "vorder": 109,
    "position": 0,
    "text": "بدو گفت ما همچنین بر دو اسب"
  },
  {
    "poem_id": 88082,
    "vorder": 110,
    "position": 1,
    "text": "بتازیم تا خان آذرگشسب"
  },
  {
    "poem_id": 88082,
    "vorder": 111,
    "position": 0,
    "text": "سر و تن بشوییم با پا و دست"
  },
  {
    "poem_id": 88082,
    "vorder": 112,
    "position": 1,
    "text": "چنانچون بود مرد یزدان پرست"
  },
  {
    "poem_id": 88082,
    "vorder": 113,
    "position": 0,
    "text": "ابا باژ با کردگار جهان"
  },
  {
    "poem_id": 88082,
    "vorder": 114,
    "position": 1,
    "text": "بدو بر کنیم آفرین نهان"
  },
  {
    "poem_id": 88082,
    "vorder": 115,
    "position": 0,
    "text": "بباشیم بر پیش آتش به پای"
  },
  {
    "poem_id": 88082,
    "vorder": 116,
    "position": 1,
    "text": "مگر پاک یزدان بود رهنمای"
  },
  {
    "poem_id": 88082,
    "vorder": 117,
    "position": 0,
    "text": "به جایی که او دارد آرامگاه"
  },
  {
    "poem_id": 88082,
    "vorder": 118,
    "position": 1,
    "text": "نماید نماینده داد راه"
  },
  {
    "poem_id": 88082,
    "vorder": 119,
    "position": 0,
    "text": "بر این باژ گشتند هر دو یکی"
  },
  {
    "poem_id": 88082,
    "vorder": 120,
    "position": 1,
    "text": "نگردید یک تن ز راه اندکی"
  },
  {
    "poem_id": 88082,
    "vorder": 121,
    "position": 0,
    "text": "نشستند با باژ هر دو بر اسب"
  },
  {
    "poem_id": 88082,
    "vorder": 122,
    "position": 1,
    "text": "دوان تا سوی خان آذرگشسب"
  },
  {
    "poem_id": 88082,
    "vorder": 123,
    "position": 0,
    "text": "پر از بیم دل یک به یک پرامید"
  },
  {
    "poem_id": 88082,
    "vorder": 124,
    "position": 1,
    "text": "برفتند با جامه‌های سپید"
  },
  {
    "poem_id": 88082,
    "vorder": 125,
    "position": 0,
