[
  {
    "poem_id": 88010,
    "vorder": 1,
    "position": 0,
    "text": "شتر یافت چندان و چندان گله"
  },
  {
    "poem_id": 88010,
    "vorder": 2,
    "position": 1,
    "text": "که از بارگی شد سپه بی‌گله"
  },
  {
    "poem_id": 88010,
    "vorder": 3,
    "position": 0,
    "text": "ز توران سپه برنهادند رخت"
  },
  {
    "poem_id": 88010,
    "vorder": 4,
    "position": 1,
    "text": "سلیح گرانمایه و تاج و تخت"
  },
  {
    "poem_id": 88010,
    "vorder": 5,
    "position": 0,
    "text": "خروش آمد و نالهٔ گاودم"
  },
  {
    "poem_id": 88010,
    "vorder": 6,
    "position": 1,
    "text": "جرس برکشیدند و رویینه خم"
  },
  {
    "poem_id": 88010,
    "vorder": 7,
    "position": 0,
    "text": "سوی شهر ایران نهادند روی"
  },
  {
    "poem_id": 88010,
    "vorder": 8,
    "position": 1,
    "text": "سپاهی بران گونه با رنگ و بوی"
  },
  {
    "poem_id": 88010,
    "vorder": 9,
    "position": 0,
    "text": "چو آگاهی آمد ز رستم بشاه"
  },
  {
    "poem_id": 88010,
    "vorder": 10,
    "position": 1,
    "text": "خروش آمد از شهر وز بارگاه"
  },
  {
    "poem_id": 88010,
    "vorder": 11,
    "position": 0,
    "text": "از ایران تبیره برآمد بابر"
  },
  {
    "poem_id": 88010,
    "vorder": 12,
    "position": 1,
    "text": "که آمد خداوند گوپال و ببر"
  },
  {
    "poem_id": 88010,
    "vorder": 13,
    "position": 0,
    "text": "یکی شادمانی بد اندر جهان"
  },
  {
    "poem_id": 88010,
    "vorder": 14,
    "position": 1,
    "text": "خنیده میان کهان و مهان"
  },
  {
    "poem_id": 88010,
    "vorder": 15,
    "position": 0,
    "text": "دل شاه شد چون بهشت برین"
  },
  {
    "poem_id": 88010,
    "vorder": 16,
    "position": 1,
    "text": "همی خواند بر کردگار آفرین"
  },
  {
    "poem_id": 88010,
    "vorder": 17,
    "position": 0,
    "text": "بفرمود تا پیل بردند پیش"
  },
  {
    "poem_id": 88010,
    "vorder": 18,
    "position": 1,
    "text": "بجنبید کیخسرو از جای خویش"
  },
  {
    "poem_id": 88010,
    "vorder": 19,
    "position": 0,
    "text": "جهانی به‌آیین شد آراسته"
  },
  {
    "poem_id": 88010,
    "vorder": 20,
    "position": 1,
    "text": "می و رود و رامشگر و خواسته"
  },
  {
    "poem_id": 88010,
    "vorder": 21,
    "position": 0,
    "text": "تبیره برآمد ز هر جای و نای"
  },
  {
    "poem_id": 88010,
    "vorder": 22,
    "position": 1,
    "text": "چو شاه جهان اندر آمد ز جای"
  },
  {
    "poem_id": 88010,
    "vorder": 23,
    "position": 0,
    "text": "همه روی پیل از کران تا کران"
  },
  {
    "poem_id": 88010,
    "vorder": 24,
    "position": 1,
    "text": "پر از مشک بود و می و زعفران"
  },
  {
    "poem_id": 88010,
    "vorder": 25,
    "position": 0,
    "text": "ز افسر سر پیلبان پرنگار"
  },
  {
    "poem_id": 88010,
    "vorder": 26,
    "position": 1,
    "text": "ز گوش اندر آویخته گوشوار"
  },
  {
    "poem_id": 88010,
    "vorder": 27,
    "position": 0,
    "text": "بسی زعفران و درم ریختند"
  },
  {
    "poem_id": 88010,
    "vorder": 28,
    "position": 1,
    "text": "ز بر مشک و عنبر همی بیختند"
  },
  {
    "poem_id": 88010,
    "vorder": 29,
    "position": 0,
    "text": "همه شهر آوای رامشگران"
  },
  {
    "poem_id": 88010,
    "vorder": 30,
    "position": 1,
    "text": "نشسته ز هر سو کران تا کران"
  },
  {
    "poem_id": 88010,
    "vorder": 31,
    "position": 0,
    "text": "چنان بد جهان را ز شادی و داد"
  },
  {
    "poem_id": 88010,
    "vorder": 32,
    "position": 1,
    "text": "که گیتی روان را دوامست و شاد"
  },
  {
    "poem_id": 88010,
    "vorder": 33,
    "position": 0,
    "text": "تهمتن چو تاج سرافراز دید"
  },
  {
    "poem_id": 88010,
    "vorder": 34,
    "position": 1,
    "text": "جهانی سراسر پرآواز دید"
  },
  {
    "poem_id": 88010,
    "vorder": 35,
    "position": 0,
    "text": "فرود آمد و برد پیشش نماز"
  },
  {
    "poem_id": 88010,
    "vorder": 36,
    "position": 1,
    "text": "بپرسید خسرو ز راه دراز"
  },
  {
    "poem_id": 88010,
    "vorder": 37,
    "position": 0,
    "text": "گرفتش بآغوش در شاه تنگ"
  },
  {
    "poem_id": 88010,
    "vorder": 38,
    "position": 1,
    "text": "چنین تا برآمد زمانی درنگ"
  },
  {
    "poem_id": 88010,
    "vorder": 39,
    "position": 0,
    "text": "همی آفرین خواند شاه جهان"
  },
  {
    "poem_id": 88010,
    "vorder": 40,
    "position": 1,
    "text": "بران نامور موبد و پهلوان"
  },
  {
    "poem_id": 88010,
    "vorder": 41,
    "position": 0,
    "text": "بفرمود تا پیلتن برنشست"
  },
  {
    "poem_id": 88010,
    "vorder": 42,
    "position": 1,
    "text": "گرفته همه راه دستش بدست"
  },
  {
    "poem_id": 88010,
    "vorder": 43,
    "position": 0,
    "text": "همی گفت چندین چرا ماندی"
  },
  {
    "poem_id": 88010,
    "vorder": 44,
    "position": 1,
    "text": "که بر ما همی آتش افشاندی"
  },
  {
    "poem_id": 88010,
    "vorder": 45,
    "position": 0,
    "text": "چو طوس و فریبرز و گودرز و گیو"
  },
  {
    "poem_id": 88010,
    "vorder": 46,
    "position": 1,
    "text": "چو رهام و گرگین و گردان نیو"
  },
  {
    "poem_id": 88010,
    "vorder": 47,
    "position": 0,
    "text": "ز ره سوی ایوان شاه آمدند"
  },
  {
    "poem_id": 88010,
    "vorder": 48,
    "position": 1,
    "text": "بدان نامور بارگاه آمدند"
  },
  {
    "poem_id": 88010,
    "vorder": 49,
    "position": 0,
    "text": "نشست از بر تخت زر شهریار"
  },
  {
    "poem_id": 88010,
    "vorder": 50,
    "position": 1,
    "text": "بنزدیک او رستم نامدار"
  },
  {
    "poem_id": 88010,
    "vorder": 51,
    "position": 0,
    "text": "فریبرز و گودرز و رهام و گیو"
  },
  {
    "poem_id": 88010,
    "vorder": 52,
    "position": 1,
    "text": "نشستند با نامداران نیو"
  },
  {
    "poem_id": 88010,
    "vorder": 53,
    "position": 0,
    "text": "سخن گفت کیخسرو از رزمگاه"
  },
  {
    "poem_id": 88010,
    "vorder": 54,
    "position": 1,
    "text": "ازان رنج و پیگار توران سپاه"
  },
  {
    "poem_id": 88010,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت گودرز کای شهریار"
  },
  {
    "poem_id": 88010,
    "vorder": 56,
    "position": 1,
    "text": "سخنها درازست زین کارزار"
  },
  {
    "poem_id": 88010,
    "vorder": 57,
    "position": 0,
    "text": "می و جام و آرام باید نخست"
  },
  {
    "poem_id": 88010,
    "vorder": 58,
    "position": 1,
    "text": "پس آنگاه ازین کار پرسی درست"
  },
  {
    "poem_id": 88010,
    "vorder": 59,
    "position": 0,
    "text": "نهادند خوان و بخندید شاه"
  },
  {
    "poem_id": 88010,
    "vorder": 60,
    "position": 1,
    "text": "که ناهار بودی همانا به راه"
  },
  {
    "poem_id": 88010,
    "vorder": 61,
    "position": 0,
    "text": "بخوان بر می آورد و رامشگران"
  },
  {
    "poem_id": 88010,
    "vorder": 62,
    "position": 1,
    "text": "بپرسش گرفت از کران تا کران"
  },
  {
    "poem_id": 88010,
    "vorder": 63,
    "position": 0,
    "text": "ز افراسیاب وز پولادوند"
  },
  {
    "poem_id": 88010,
    "vorder": 64,
    "position": 1,
    "text": "ز کشتی و از تابداده کمند"
  },
  {
    "poem_id": 88010,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت گودرز کای شهریار"
  },
  {
    "poem_id": 88010,
    "vorder": 66,
    "position": 1,
    "text": "ز مادر نزاید چو رستم سوار"
  },
  {
    "poem_id": 88010,
    "vorder": 67,
    "position": 0,
    "text": "اگر دیو پیش آید ار اژدها"
  },
  {
    "poem_id": 88010,
    "vorder": 68,
    "position": 1,
    "text": "ز چنگ درازش نیابد رها"
  },
  {
    "poem_id": 88010,
    "vorder": 69,
    "position": 0,
    "text": "هزار افرین باد بر شهریار"
  },
  {
    "poem_id": 88010,
    "vorder": 70,
    "position": 1,
    "text": "بویژه برین شیردل نامدار"
  },
  {
    "poem_id": 88010,
    "vorder": 71,
    "position": 0,
    "text": "بگفت آنچ کرد او بپولادوند"
  },
  {
    "poem_id": 88010,
    "vorder": 72,
    "position": 1,
    "text": "ز کشتی و نیرنگ وز رنگ و بند"
  },
  {
    "poem_id": 88010,
    "vorder": 73,
    "position": 0,
    "text": "ز افگندن دیو وز کشتنش"
  },
  {
    "poem_id": 88010,
    "vorder": 74,
    "position": 1,
    "text": "همان جنگ و پیگار و کین جستنش"
  },
  {
    "poem_id": 88010,
    "vorder": 75,
    "position": 0,
    "text": "چو افتاد بر خاک زو رفت هوش"
  },
  {
    "poem_id": 88010,
    "vorder": 76,
    "position": 1,
    "text": "برآمد ز گردان دیوان خروش"
  },
  {
    "poem_id": 88010,
    "vorder": 77,
    "position": 0,
    "text": "چو آمد بهوش آن سرافراز دیو"
  },
  {
    "poem_id": 88010,
    "vorder": 78,
    "position": 1,
    "text": "برآمد بناگاه زو یک غریو"
  },
  {
    "poem_id": 88010,
    "vorder": 79,
    "position": 0,
    "text": "همانگه درآمد باسپ و برفت"
  },
  {
    "poem_id": 88010,
    "vorder": 80,
    "position": 1,
    "text": "همی بند جانش ز رستم بکفت"
  },
  {
    "poem_id": 88010,
    "vorder": 81,
    "position": 0,
    "text": "چنان شاد شد زان سخن تاجور"
  },
  {
    "poem_id": 88010,
    "vorder": 82,
    "position": 1,
    "text": "که گفتی ز ایوان برآورد سر"
  },
  {
    "poem_id": 88010,
    "vorder": 83,
    "position": 0,
    "text": "چنین داد پاسخ که ای پهلوان"
  },
  {
    "poem_id": 88010,
    "vorder": 84,
    "position": 1,
    "text": "توی پیر و بیدار و روشن‌روان"
  },
  {
    "poem_id": 88010,
    "vorder": 85,
    "position": 0,
    "text": "کسی کش خرد باشد آموزگار"
  },
  {
    "poem_id": 88010,
    "vorder": 86,
    "position": 1,
    "text": "نگه داردش گردش روزگار"
  },
  {
    "poem_id": 88010,
    "vorder": 87,
    "position": 0,
    "text": "ازین پهلوان چشم بد دور باد"
  },
  {
    "poem_id": 88010,
    "vorder": 88,
    "position": 1,
    "text": "همه زندگانیش در سور باد"
  },
  {
    "poem_id": 88010,
    "vorder": 89,
    "position": 0,
    "text": "همی بود یک هفته با می بدست"
  },
  {
    "poem_id": 88010,
    "vorder": 90,
    "position": 1,
    "text": "ازو شادمان تاج و تخت و نشست"
  },
  {
    "poem_id": 88010,
    "vorder": 91,
    "position": 0,
    "text": "سخنهای رستم بنای و برود"
  },
  {
    "poem_id": 88010,
    "vorder": 92,
    "position": 1,
    "text": "بگفتند بر پهلوانی سرود"
  },
  {
    "poem_id": 88010,
    "vorder": 93,
    "position": 0,
    "text": "تهمتن بیک ماه نزدیک شاه"
  },
  {
    "poem_id": 88010,
    "vorder": 94,
    "position": 1,
    "text": "همی بود با جام در پیشگاه"
  },
  {
    "poem_id": 88010,
    "vorder": 95,
    "position": 0,
    "text": "ازان پس چنین گفت با شهریار"
  },
  {
    "poem_id": 88010,
    "vorder": 96,
    "position": 1,
    "text": "که ای پرهنر نامور تاجدار"
  },
  {
    "poem_id": 88010,
    "vorder": 97,
    "position": 0,
    "text": "جهاندار با دانش و نیک‌خوست"
  },
  {
    "poem_id": 88010,
    "vorder": 98,
    "position": 1,
    "text": "ولیکن مرا چهر زال آرزوست"
  },
  {
    "poem_id": 88010,
    "vorder": 99,
    "position": 0,
    "text": "در گنج بگشاد شاه جهان"
  },
  {
    "poem_id": 88010,
    "vorder": 100,
    "position": 1,
    "text": "ز پرمایه چیزی که بودش نهان"
  },
  {
    "poem_id": 88010,
    "vorder": 101,
    "position": 0,
    "text": "ز یاقوت وز تاج و انگشتری"
  },
  {
    "poem_id": 88010,
    "vorder": 102,
    "position": 1,
    "text": "ز دینار وز جامهٔ ششتری"
  },
  {
    "poem_id": 88010,
    "vorder": 103,
    "position": 0,
    "text": "پرستار با افسر و گوشوار"
  },
  {
    "poem_id": 88010,
    "vorder": 104,
    "position": 1,
    "text": "همان جعد مویان سیمین عذار"
  },
  {
    "poem_id": 88010,
    "vorder": 105,
    "position": 0,
    "text": "طبقهای زرین پر از مشک و عود"
  },
  {
    "poem_id": 88010,
    "vorder": 106,
    "position": 1,
    "text": "دو نعلین زرین و زرین عمود"
  },
  {
    "poem_id": 88010,
    "vorder": 107,
    "position": 0,
    "text": "برو بافته گوهر شاهوار"
  },
  {
    "poem_id": 88010,
    "vorder": 108,
    "position": 1,
    "text": "چنانچون بود در خور شهریار"
  },
  {
    "poem_id": 88010,
    "vorder": 109,
    "position": 0,
    "text": "بنزد تهمتن فرستاد شاه"
  },
  {
    "poem_id": 88010,
    "vorder": 110,
    "position": 1,
    "text": "دو منزل همی رفت با او براه"
  },
  {
    "poem_id": 88010,
    "vorder": 111,
    "position": 0,
    "text": "چو خسرو غمی شد ز راه دراز"
  },
  {
    "poem_id": 88010,
    "vorder": 112,
    "position": 1,
    "text": "فرود آمد و برد رستم نماز"
  },
  {
    "poem_id": 88010,
    "vorder": 113,
    "position": 0,
    "text": "ورا کرد پدرود و ز ایران برفت"
  },
  {
    "poem_id": 88010,
    "vorder": 114,
    "position": 1,
    "text": "سوی زابلستان خرامید تفت"
  },
  {
    "poem_id": 88010,
    "vorder": 115,
    "position": 0,
    "text": "سراسر جهان گشت بر شاه راست"
  },
  {
    "poem_id": 88010,
    "vorder": 116,
    "position": 1,
    "text": "همی گشت گیتی بران سان که خواست"
  },
  {
    "poem_id": 88010,
    "vorder": 117,
    "position": 0,
    "text": "سر آوردم این رزم کاموس نیز"
  },
  {
    "poem_id": 88010,
    "vorder": 118,
    "position": 1,
    "text": "درازست و کم نیست زو یک پشیز"
  },
  {
    "poem_id": 88010,
    "vorder": 119,
    "position": 0,
    "text": "گر از داستان یک سخن کم بدی"
  },
  {
    "poem_id": 88010,
    "vorder": 120,
    "position": 1,
    "text": "روان مرا جای ماتم بدی"
  },
  {
    "poem_id": 88010,
    "vorder": 121,
    "position": 0,
    "text": "دلم شادمان شد ز پولادوند"
  },
  {
    "poem_id": 88010,
    "vorder": 122,
    "position": 1,
    "text": "که بفزود بر بند پولاد بند"
  }
]