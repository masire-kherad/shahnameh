[
  {
    "poem_id": 88087,
    "vorder": 1,
    "position": 0,
    "text": "بر این گونه تا سالیان گشت شصت"
  },
  {
    "poem_id": 88087,
    "vorder": 2,
    "position": 1,
    "text": "جهان شد همه شاه را زیردست"
  },
  {
    "poem_id": 88087,
    "vorder": 3,
    "position": 0,
    "text": "پراندیشه شد مایه‌ور جان شاه"
  },
  {
    "poem_id": 88087,
    "vorder": 4,
    "position": 1,
    "text": "از آن رفتن کار و آن دستگاه"
  },
  {
    "poem_id": 88087,
    "vorder": 5,
    "position": 0,
    "text": "همی گفت ویران و آباد بوم"
  },
  {
    "poem_id": 88087,
    "vorder": 6,
    "position": 1,
    "text": "ز چین و ز هند و ز توران و روم"
  },
  {
    "poem_id": 88087,
    "vorder": 7,
    "position": 0,
    "text": "هم از خاوران تا در باختر"
  },
  {
    "poem_id": 88087,
    "vorder": 8,
    "position": 1,
    "text": "ز کوه و بیابان وز خشک و تر"
  },
  {
    "poem_id": 88087,
    "vorder": 9,
    "position": 0,
    "text": "سراسر ز بدخواه کردم تهی"
  },
  {
    "poem_id": 88087,
    "vorder": 10,
    "position": 1,
    "text": "مرا گشت فرمان و گاه مهی"
  },
  {
    "poem_id": 88087,
    "vorder": 11,
    "position": 0,
    "text": "جهان از بداندیش بی‌بیم شد"
  },
  {
    "poem_id": 88087,
    "vorder": 12,
    "position": 1,
    "text": "دل اهرمن ز این به دو نیم شد"
  },
  {
    "poem_id": 88087,
    "vorder": 13,
    "position": 0,
    "text": "ز یزدان همه آرزو یافتم"
  },
  {
    "poem_id": 88087,
    "vorder": 14,
    "position": 1,
    "text": "وگر دل همه سوی کین تافتم"
  },
  {
    "poem_id": 88087,
    "vorder": 15,
    "position": 0,
    "text": "روانم نباید که آرد منی"
  },
  {
    "poem_id": 88087,
    "vorder": 16,
    "position": 1,
    "text": "بداندیشی و کیش آهرمنی"
  },
  {
    "poem_id": 88087,
    "vorder": 17,
    "position": 0,
    "text": "شوم همچو ضحاک تازی و جم"
  },
  {
    "poem_id": 88087,
    "vorder": 18,
    "position": 1,
    "text": "که با سلم و تور اندر آیم به زم"
  },
  {
    "poem_id": 88087,
    "vorder": 19,
    "position": 0,
    "text": "به یک سو چو کاووس دارم نیا"
  },
  {
    "poem_id": 88087,
    "vorder": 20,
    "position": 1,
    "text": "دگر سو چو توران پر از کیمیا"
  },
  {
    "poem_id": 88087,
    "vorder": 21,
    "position": 0,
    "text": "چو کاووس و چون جادو افراسیاب"
  },
  {
    "poem_id": 88087,
    "vorder": 22,
    "position": 1,
    "text": "که جز روی کژی ندیدی به خواب"
  },
  {
    "poem_id": 88087,
    "vorder": 23,
    "position": 0,
    "text": "به یزدان شوم یک زمان ناسپاس"
  },
  {
    "poem_id": 88087,
    "vorder": 24,
    "position": 1,
    "text": "به روشن روان اندر آرم هراس"
  },
  {
    "poem_id": 88087,
    "vorder": 25,
    "position": 0,
    "text": "ز من بگسلد فره ایزدی"
  },
  {
    "poem_id": 88087,
    "vorder": 26,
    "position": 1,
    "text": "گر آیم به کژی و راه بدی"
  },
  {
    "poem_id": 88087,
    "vorder": 27,
    "position": 0,
    "text": "از آن پس بر آن تیرگی بگذرم"
  },
  {
    "poem_id": 88087,
    "vorder": 28,
    "position": 1,
    "text": "به خاک اندر آید سر و افسرم"
  },
  {
    "poem_id": 88087,
    "vorder": 29,
    "position": 0,
    "text": "به گیتی بماند ز من نام بد"
  },
  {
    "poem_id": 88087,
    "vorder": 30,
    "position": 1,
    "text": "همان پیش یزدان سرانجام بد"
  },
  {
    "poem_id": 88087,
    "vorder": 31,
    "position": 0,
    "text": "تبه گرددم چهر و رنگ رخان"
  },
  {
    "poem_id": 88087,
    "vorder": 32,
    "position": 1,
    "text": "بریزد به خاک اندرون استخوان"
  },
  {
    "poem_id": 88087,
    "vorder": 33,
    "position": 0,
    "text": "هنر کم شود ناسپاسی به جای"
  },
  {
    "poem_id": 88087,
    "vorder": 34,
    "position": 1,
    "text": "روان تیره گردد به دیگر سرای"
  },
  {
    "poem_id": 88087,
    "vorder": 35,
    "position": 0,
    "text": "گرفته کسی تاج و تخت مرا"
  },
  {
    "poem_id": 88087,
    "vorder": 36,
    "position": 1,
    "text": "به پای اندر آورده بخت مرا"
  },
  {
    "poem_id": 88087,
    "vorder": 37,
    "position": 0,
    "text": "ز من نام ماند بدی یادگار"
  },
  {
    "poem_id": 88087,
    "vorder": 38,
    "position": 1,
    "text": "گل رنجهای کهن گشته خار"
  },
  {
    "poem_id": 88087,
    "vorder": 39,
    "position": 0,
    "text": "من اکنون چو کین پدر خواستم"
  },
  {
    "poem_id": 88087,
    "vorder": 40,
    "position": 1,
    "text": "جهانی به خوبی بیاراستم"
  },
  {
    "poem_id": 88087,
    "vorder": 41,
    "position": 0,
    "text": "بکشتم کسی را که بایست کشت"
  },
  {
    "poem_id": 88087,
    "vorder": 42,
    "position": 1,
    "text": "که بد کژ و با راه یزدان درشت"
  },
  {
    "poem_id": 88087,
    "vorder": 43,
    "position": 0,
    "text": "به آباد و ویران درختی نماند"
  },
  {
    "poem_id": 88087,
    "vorder": 44,
    "position": 1,
    "text": "که منشور تخت مرا برنخواند"
  },
  {
    "poem_id": 88087,
    "vorder": 45,
    "position": 0,
    "text": "بزرگان گیتی مرا کهترند"
  },
  {
    "poem_id": 88087,
    "vorder": 46,
    "position": 1,
    "text": "وگر چند با گنج و با افسرند"
  },
  {
    "poem_id": 88087,
    "vorder": 47,
    "position": 0,
    "text": "سپاسم ز یزدان که او داد فر"
  },
  {
    "poem_id": 88087,
    "vorder": 48,
    "position": 1,
    "text": "همان گردش اختر و پای و پر"
  },
  {
    "poem_id": 88087,
    "vorder": 49,
    "position": 0,
    "text": "کنون آن به آید که من راه‌جوی"
  },
  {
    "poem_id": 88087,
    "vorder": 50,
    "position": 1,
    "text": "شوم پیش یزدان پر از آب روی"
  },
  {
    "poem_id": 88087,
    "vorder": 51,
    "position": 0,
    "text": "مگر هم بدین خوبی اندر نهان"
  },
  {
    "poem_id": 88087,
    "vorder": 52,
    "position": 1,
    "text": "پرستندهٔ کردگار جهان"
  },
  {
    "poem_id": 88087,
    "vorder": 53,
    "position": 0,
    "text": "روانم بدان جای نیکان برد"
  },
  {
    "poem_id": 88087,
    "vorder": 54,
    "position": 1,
    "text": "که این تاج و تخت مهی بگذرد"
  },
  {
    "poem_id": 88087,
    "vorder": 55,
    "position": 0,
    "text": "نیابد کسی ز این فزون کام و نام"
  },
  {
    "poem_id": 88087,
    "vorder": 56,
    "position": 1,
    "text": "بزرگی و خوبی و آرام و جام"
  },
  {
    "poem_id": 88087,
    "vorder": 57,
    "position": 0,
    "text": "رسیدیم و دیدیم راز جهان"
  },
  {
    "poem_id": 88087,
    "vorder": 58,
    "position": 1,
    "text": "بد و نیک هم آشکار و نهان"
  },
  {
    "poem_id": 88087,
    "vorder": 59,
    "position": 0,
    "text": "کشاورز دیدیم گر تاجور"
  },
  {
    "poem_id": 88087,
    "vorder": 60,
    "position": 1,
    "text": "سرانجام بر مرگ باشد گذر"
  },
  {
    "poem_id": 88087,
    "vorder": 61,
    "position": 0,
    "text": "به سالار نوبت بفرمود شاه"
  },
  {
    "poem_id": 88087,
    "vorder": 62,
    "position": 1,
    "text": "که هر کس که آید بدین بارگاه"
  },
  {
    "poem_id": 88087,
    "vorder": 63,
    "position": 0,
    "text": "ورا بازگردان به نیکو سخن"
  },
  {
    "poem_id": 88087,
    "vorder": 64,
    "position": 1,
    "text": "همه مردمی جوی و تندی مکن"
  },
  {
    "poem_id": 88087,
    "vorder": 65,
    "position": 0,
    "text": "ببست آن در بارگاه کیان"
  },
  {
    "poem_id": 88087,
    "vorder": 66,
    "position": 1,
    "text": "خروشان بیامد گشاده‌میان"
  },
  {
    "poem_id": 88087,
    "vorder": 67,
    "position": 0,
    "text": "ز بهر پرستش سر و تن بشست"
  },
  {
    "poem_id": 88087,
    "vorder": 68,
    "position": 1,
    "text": "به شمع خرد راه یزدان بجست"
  },
  {
    "poem_id": 88087,
    "vorder": 69,
    "position": 0,
    "text": "بپوشید پس جامهٔ نو سپید"
  },
  {
    "poem_id": 88087,
    "vorder": 70,
    "position": 1,
    "text": "نیایش کنان رفت دل پر امید"
  },
  {
    "poem_id": 88087,
    "vorder": 71,
    "position": 0,
    "text": "بیامد خرامان به جای نماز"
  },
  {
    "poem_id": 88087,
    "vorder": 72,
    "position": 1,
    "text": "همی گفت با داور پاک راز"
  },
  {
    "poem_id": 88087,
    "vorder": 73,
    "position": 0,
    "text": "همی گفت کای برتر از جان پاک"
  },
  {
    "poem_id": 88087,
    "vorder": 74,
    "position": 1,
    "text": "برآرندهٔ آتش از تیره خاک"
  },
  {
    "poem_id": 88087,
    "vorder": 75,
    "position": 0,
    "text": "مرا بین و چندی خرد ده مرا"
  },
  {
    "poem_id": 88087,
    "vorder": 76,
    "position": 1,
    "text": "هم اندیشهٔ نیک و بد ده مرا"
  },
  {
    "poem_id": 88087,
    "vorder": 77,
    "position": 0,
    "text": "ترا تا بباشم نیایش کنم"
  },
  {
    "poem_id": 88087,
    "vorder": 78,
    "position": 1,
    "text": "بدین نیکویها فزایش کنم"
  },
  {
    "poem_id": 88087,
    "vorder": 79,
    "position": 0,
    "text": "بیامرز رفته گناه مرا"
  },
  {
    "poem_id": 88087,
    "vorder": 80,
    "position": 1,
    "text": "ز کژی بکش دستگاه مرا"
  },
  {
    "poem_id": 88087,
    "vorder": 81,
    "position": 0,
    "text": "بگردان ز جانم بد روزگار"
  },
  {
    "poem_id": 88087,
    "vorder": 82,
    "position": 1,
    "text": "همان چارهٔ دیو آموزگار"
  },
  {
    "poem_id": 88087,
    "vorder": 83,
    "position": 0,
    "text": "بدان تا چو کاووس و ضحاک و جم"
  },
  {
    "poem_id": 88087,
    "vorder": 84,
    "position": 1,
    "text": "نگیرد هوا بر روانم ستم"
  },
  {
    "poem_id": 88087,
    "vorder": 85,
    "position": 0,
    "text": "چو بر من بپوشد در راستی"
  },
  {
    "poem_id": 88087,
    "vorder": 86,
    "position": 1,
    "text": "به نیرو شود کژی و کاستی"
  },
  {
    "poem_id": 88087,
    "vorder": 87,
    "position": 0,
    "text": "بگردان ز من دیو را دستگاه"
  },
  {
    "poem_id": 88087,
    "vorder": 88,
    "position": 1,
    "text": "بدان تا ندارد روانم تباه"
  },
  {
    "poem_id": 88087,
    "vorder": 89,
    "position": 0,
    "text": "نگه‌دار بر من همین راه و سان"
  },
  {
    "poem_id": 88087,
    "vorder": 90,
    "position": 1,
    "text": "روانم بدان جای نیکان رسان"
  }
]