[
  {
    "poem_id": 1613,
    "vorder": 1,
    "position": 0,
    "text": "چو شد روزگار تهمتن به سر"
  },
  {
    "poem_id": 1613,
    "vorder": 2,
    "position": 1,
    "text": "به پیش آورم داستانی دگر"
  },
  {
    "poem_id": 1613,
    "vorder": 3,
    "position": 0,
    "text": "چو گشتاسپ را تیره شد روی بخت"
  },
  {
    "poem_id": 1613,
    "vorder": 4,
    "position": 1,
    "text": "بیاورد جاماسپ را پیش تخت"
  },
  {
    "poem_id": 1613,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کز کار اسفندیار"
  },
  {
    "poem_id": 1613,
    "vorder": 6,
    "position": 1,
    "text": "چنان داغ دل گشتم و سوکوار"
  },
  {
    "poem_id": 1613,
    "vorder": 7,
    "position": 0,
    "text": "که روزی نبد زندگانیم خوش"
  },
  {
    "poem_id": 1613,
    "vorder": 8,
    "position": 1,
    "text": "دژم بودم از اختر کینه‌کش"
  },
  {
    "poem_id": 1613,
    "vorder": 9,
    "position": 0,
    "text": "پس از من کنون شاه بهمن بود"
  },
  {
    "poem_id": 1613,
    "vorder": 10,
    "position": 1,
    "text": "همان رازدارش پشوتن بود"
  },
  {
    "poem_id": 1613,
    "vorder": 11,
    "position": 0,
    "text": "مپیچید سرها ز فرمان اوی"
  },
  {
    "poem_id": 1613,
    "vorder": 12,
    "position": 1,
    "text": "مگیرید دوری ز پیمان اوی"
  },
  {
    "poem_id": 1613,
    "vorder": 13,
    "position": 0,
    "text": "یکایک بویدش نماینده راه"
  },
  {
    "poem_id": 1613,
    "vorder": 14,
    "position": 1,
    "text": "که اویست زیبای تخت و کلاه"
  },
  {
    "poem_id": 1613,
    "vorder": 15,
    "position": 0,
    "text": "بدو داد پس گنجها را کلید"
  },
  {
    "poem_id": 1613,
    "vorder": 16,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1613,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت کار من اندر گذشت"
  },
  {
    "poem_id": 1613,
    "vorder": 18,
    "position": 1,
    "text": "هم از تارکم آب برتر گذشت"
  },
  {
    "poem_id": 1613,
    "vorder": 19,
    "position": 0,
    "text": "نشستم به شاهی صد و بیست سال"
  },
  {
    "poem_id": 1613,
    "vorder": 20,
    "position": 1,
    "text": "ندیدم به گیتی کسی را همال"
  },
  {
    "poem_id": 1613,
    "vorder": 21,
    "position": 0,
    "text": "تو اکنون همی کوش و با داد باش"
  },
  {
    "poem_id": 1613,
    "vorder": 22,
    "position": 1,
    "text": "چو داد آوری از غم آزاد باش"
  },
  {
    "poem_id": 1613,
    "vorder": 23,
    "position": 0,
    "text": "خردمند را شاد و نزدیک دار"
  },
  {
    "poem_id": 1613,
    "vorder": 24,
    "position": 1,
    "text": "جهان بر بداندیش تاریک دار"
  },
  {
    "poem_id": 1613,
    "vorder": 25,
    "position": 0,
    "text": "همه راستی کن که از راستی"
  },
  {
    "poem_id": 1613,
    "vorder": 26,
    "position": 1,
    "text": "بپیچد سر از کژی و کاستی"
  },
  {
    "poem_id": 1613,
    "vorder": 27,
    "position": 0,
    "text": "سپردم ترا تخت و دیهیم و گنج"
  },
  {
    "poem_id": 1613,
    "vorder": 28,
    "position": 1,
    "text": "ازان پس که بردم بسی گرم و رنج"
  },
  {
    "poem_id": 1613,
    "vorder": 29,
    "position": 0,
    "text": "بگفت این و شد روزگارش به سر"
  },
  {
    "poem_id": 1613,
    "vorder": 30,
    "position": 1,
    "text": "زمان گذشته نیامد به بر"
  },
  {
    "poem_id": 1613,
    "vorder": 31,
    "position": 0,
    "text": "یکی دخمه کردندش از شیز و عاج"
  },
  {
    "poem_id": 1613,
    "vorder": 32,
    "position": 1,
    "text": "برآویختند از بر گاه تاج"
  },
  {
    "poem_id": 1613,
    "vorder": 33,
    "position": 0,
    "text": "همین بودش از رنج و ز گنج بهر"
  },
  {
    "poem_id": 1613,
    "vorder": 34,
    "position": 1,
    "text": "بدید از پس نوش و تریاک زهر"
  },
  {
    "poem_id": 1613,
    "vorder": 35,
    "position": 0,
    "text": "اگر بودن اینست شادی چراست"
  },
  {
    "poem_id": 1613,
    "vorder": 36,
    "position": 1,
    "text": "شد از مرگ درویش با شاه راست"
  },
  {
    "poem_id": 1613,
    "vorder": 37,
    "position": 0,
    "text": "بخور هرچ برزی و بد را مکوش"
  },
  {
    "poem_id": 1613,
    "vorder": 38,
    "position": 1,
    "text": "به مرد خردمند بسپار گوش"
  },
  {
    "poem_id": 1613,
    "vorder": 39,
    "position": 0,
    "text": "گذر کرد همراه و ما ماندیم"
  },
  {
    "poem_id": 1613,
    "vorder": 40,
    "position": 1,
    "text": "ز کار گذشته بسی خواندیم"
  },
  {
    "poem_id": 1613,
    "vorder": 41,
    "position": 0,
    "text": "به منزل رسید آنک پوینده بود"
  },
  {
    "poem_id": 1613,
    "vorder": 42,
    "position": 1,
    "text": "رهی یافت آن کس که جوینده بود"
  },
  {
    "poem_id": 1613,
    "vorder": 43,
    "position": 0,
    "text": "نگیرد ترا دست جز نیکوی"
  },
  {
    "poem_id": 1613,
    "vorder": 44,
    "position": 1,
    "text": "گر از پیر دانا سخن بشنوی"
  },
  {
    "poem_id": 1613,
    "vorder": 45,
    "position": 0,
    "text": "کنون رنج در کار بهمن بریم"
  },
  {
    "poem_id": 1613,
    "vorder": 46,
    "position": 1,
    "text": "خرد پیش دانا پشوتن بریم"
  }
]