[
  {
    "poem_id": 1527,
    "vorder": 1,
    "position": 0,
    "text": "چنان دید گوینده یک شب به خواب"
  },
  {
    "poem_id": 1527,
    "vorder": 2,
    "position": 1,
    "text": "که یک جام می داشتی چون گلاب"
  },
  {
    "poem_id": 1527,
    "vorder": 3,
    "position": 0,
    "text": "دقیقی ز جایی پدید آمدی"
  },
  {
    "poem_id": 1527,
    "vorder": 4,
    "position": 1,
    "text": "بران جام می داستانها زدی"
  },
  {
    "poem_id": 1527,
    "vorder": 5,
    "position": 0,
    "text": "به فردوسی آواز دادی که می"
  },
  {
    "poem_id": 1527,
    "vorder": 6,
    "position": 1,
    "text": "مخور جز بر آیین کاوس کی"
  },
  {
    "poem_id": 1527,
    "vorder": 7,
    "position": 0,
    "text": "که شاهی ز گیتی گزیدی که بخت"
  },
  {
    "poem_id": 1527,
    "vorder": 8,
    "position": 1,
    "text": "بدو نازد و لشگر و تاج و تخت"
  },
  {
    "poem_id": 1527,
    "vorder": 9,
    "position": 0,
    "text": "شهنشاه محمود گیرنده شهر"
  },
  {
    "poem_id": 1527,
    "vorder": 10,
    "position": 1,
    "text": "ز شادی به هر کس رسانیده بهر"
  },
  {
    "poem_id": 1527,
    "vorder": 11,
    "position": 0,
    "text": "از امروز تا سال هشتاد و پنج"
  },
  {
    "poem_id": 1527,
    "vorder": 12,
    "position": 1,
    "text": "بکاهدش رنج و نکاهدش گنج"
  },
  {
    "poem_id": 1527,
    "vorder": 13,
    "position": 0,
    "text": "ازین پس به چین اندر آرد سپاه"
  },
  {
    "poem_id": 1527,
    "vorder": 14,
    "position": 1,
    "text": "همه مهتران برگشایند راه"
  },
  {
    "poem_id": 1527,
    "vorder": 15,
    "position": 0,
    "text": "نبایدش گفتن کسی را درشت"
  },
  {
    "poem_id": 1527,
    "vorder": 16,
    "position": 1,
    "text": "همه تاج شاهانش آمد به مشت"
  },
  {
    "poem_id": 1527,
    "vorder": 17,
    "position": 0,
    "text": "بدین نامه گر چند بشتافتی"
  },
  {
    "poem_id": 1527,
    "vorder": 18,
    "position": 1,
    "text": "کنون هرچ جستی همه یافتی"
  },
  {
    "poem_id": 1527,
    "vorder": 19,
    "position": 0,
    "text": "ازین باره من پیش گفتم سخن"
  },
  {
    "poem_id": 1527,
    "vorder": 20,
    "position": 1,
    "text": "سخن را نیامد سراسر به بن"
  },
  {
    "poem_id": 1527,
    "vorder": 21,
    "position": 0,
    "text": "ز گشتاسپ و ارجاسپ بیتی هزار"
  },
  {
    "poem_id": 1527,
    "vorder": 22,
    "position": 1,
    "text": "بگفتم سرآمد مرا روزگار"
  },
  {
    "poem_id": 1527,
    "vorder": 23,
    "position": 0,
    "text": "گر آن مایه نزد شهنشه رسد"
  },
  {
    "poem_id": 1527,
    "vorder": 24,
    "position": 1,
    "text": "روان من از خاک بر مه رسد"
  },
  {
    "poem_id": 1527,
    "vorder": 25,
    "position": 0,
    "text": "کنون من بگویم سخن کو بگفت"
  },
  {
    "poem_id": 1527,
    "vorder": 26,
    "position": 1,
    "text": "منم زنده او گشت با خاک جفت"
  }
]