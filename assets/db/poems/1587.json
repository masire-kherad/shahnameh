[
  {
    "poem_id": 1587,
    "vorder": 1,
    "position": 0,
    "text": "چو رستم برفت از لب هیرمند"
  },
  {
    "poem_id": 1587,
    "vorder": 2,
    "position": 1,
    "text": "پراندیشه شد نامدار بلند"
  },
  {
    "poem_id": 1587,
    "vorder": 3,
    "position": 0,
    "text": "پشوتن که بد شاه را رهنمای"
  },
  {
    "poem_id": 1587,
    "vorder": 4,
    "position": 1,
    "text": "بیامد هم‌انگه به پرده سرای"
  },
  {
    "poem_id": 1587,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت با او یل اسفندیار"
  },
  {
    "poem_id": 1587,
    "vorder": 6,
    "position": 1,
    "text": "که کاری گرفتیم دشخوار خوار"
  },
  {
    "poem_id": 1587,
    "vorder": 7,
    "position": 0,
    "text": "به ایوان رستم مرا کار نیست"
  },
  {
    "poem_id": 1587,
    "vorder": 8,
    "position": 1,
    "text": "ورا نزد من نیز دیدار نیست"
  },
  {
    "poem_id": 1587,
    "vorder": 9,
    "position": 0,
    "text": "همان گر نیاید نخوانمش نیز"
  },
  {
    "poem_id": 1587,
    "vorder": 10,
    "position": 1,
    "text": "گر از ما یکی را برآید قفیز"
  },
  {
    "poem_id": 1587,
    "vorder": 11,
    "position": 0,
    "text": "دل زنده از کشته بریان شود"
  },
  {
    "poem_id": 1587,
    "vorder": 12,
    "position": 1,
    "text": "سر از آشناییش گریان شود"
  },
  {
    "poem_id": 1587,
    "vorder": 13,
    "position": 0,
    "text": "پشوتن بدو گفت کای نامدار"
  },
  {
    "poem_id": 1587,
    "vorder": 14,
    "position": 1,
    "text": "برادر که یابد چو اسفندیار"
  },
  {
    "poem_id": 1587,
    "vorder": 15,
    "position": 0,
    "text": "به یزدان که دیدم شما را نخست"
  },
  {
    "poem_id": 1587,
    "vorder": 16,
    "position": 1,
    "text": "که یک نامور با دگر کین نجست"
  },
  {
    "poem_id": 1587,
    "vorder": 17,
    "position": 0,
    "text": "دلم گشت زان کار چون نوبهار"
  },
  {
    "poem_id": 1587,
    "vorder": 18,
    "position": 1,
    "text": "هم از رستم و هم از اسفندیار"
  },
  {
    "poem_id": 1587,
    "vorder": 19,
    "position": 0,
    "text": "چو در کارتان باز کردم نگاه"
  },
  {
    "poem_id": 1587,
    "vorder": 20,
    "position": 1,
    "text": "ببندد همی بر خرد دیو راه"
  },
  {
    "poem_id": 1587,
    "vorder": 21,
    "position": 0,
    "text": "تو آگاهی از کار دین و خرد"
  },
  {
    "poem_id": 1587,
    "vorder": 22,
    "position": 1,
    "text": "روانت همیشه خرد پرورد"
  },
  {
    "poem_id": 1587,
    "vorder": 23,
    "position": 0,
    "text": "بپرهیز و با جان ستیزه مکن"
  },
  {
    "poem_id": 1587,
    "vorder": 24,
    "position": 1,
    "text": "نیوشنده باش از برادر سخن"
  },
  {
    "poem_id": 1587,
    "vorder": 25,
    "position": 0,
    "text": "شنیدم همه هرچ رستم بگفت"
  },
  {
    "poem_id": 1587,
    "vorder": 26,
    "position": 1,
    "text": "بزرگیش با مردمی بود جفت"
  },
  {
    "poem_id": 1587,
    "vorder": 27,
    "position": 0,
    "text": "نساید دو پای ورا بند تو"
  },
  {
    "poem_id": 1587,
    "vorder": 28,
    "position": 1,
    "text": "نیاید سبک سوی پیوند تو"
  },
  {
    "poem_id": 1587,
    "vorder": 29,
    "position": 0,
    "text": "سوار جهان پور دستان سام"
  },
  {
    "poem_id": 1587,
    "vorder": 30,
    "position": 1,
    "text": "به بازی سراندر نیارد به دام"
  },
  {
    "poem_id": 1587,
    "vorder": 31,
    "position": 0,
    "text": "چنو پهلوانی ز گردنکشان"
  },
  {
    "poem_id": 1587,
    "vorder": 32,
    "position": 1,
    "text": "ندادست دانا به گیتی نشان"
  },
  {
    "poem_id": 1587,
    "vorder": 33,
    "position": 0,
    "text": "چگونه توان کرد پایش به بند"
  },
  {
    "poem_id": 1587,
    "vorder": 34,
    "position": 1,
    "text": "مگوی آنکه هرگز نیاید پسند"
  },
  {
    "poem_id": 1587,
    "vorder": 35,
    "position": 0,
    "text": "سخنهای ناخوب و نادلپذیر"
  },
  {
    "poem_id": 1587,
    "vorder": 36,
    "position": 1,
    "text": "سزد گر نگوید یل شیرگیر"
  },
  {
    "poem_id": 1587,
    "vorder": 37,
    "position": 0,
    "text": "بترسم که این کار گردد دراز"
  },
  {
    "poem_id": 1587,
    "vorder": 38,
    "position": 1,
    "text": "به زشتی میان دو گردن فراز"
  },
  {
    "poem_id": 1587,
    "vorder": 39,
    "position": 0,
    "text": "بزرگی و از شاه داناتری"
  },
  {
    "poem_id": 1587,
    "vorder": 40,
    "position": 1,
    "text": "به مردی و گردی تواناتری"
  },
  {
    "poem_id": 1587,
    "vorder": 41,
    "position": 0,
    "text": "یکی بزم جوید یکی رزم و کین"
  },
  {
    "poem_id": 1587,
    "vorder": 42,
    "position": 1,
    "text": "نگه کن که تا کیست با آفرین"
  },
  {
    "poem_id": 1587,
    "vorder": 43,
    "position": 0,
    "text": "چنین داد پاسخ ورا نامدار"
  },
  {
    "poem_id": 1587,
    "vorder": 44,
    "position": 1,
    "text": "که گر من بپیچم سر از شهریار"
  },
  {
    "poem_id": 1587,
    "vorder": 45,
    "position": 0,
    "text": "بدین گیتی‌اندر نکوهش بود"
  },
  {
    "poem_id": 1587,
    "vorder": 46,
    "position": 1,
    "text": "همان پیش یزدان پژوهش بود"
  },
  {
    "poem_id": 1587,
    "vorder": 47,
    "position": 0,
    "text": "دو گیتی به رستم نخواهم فروخت"
  },
  {
    "poem_id": 1587,
    "vorder": 48,
    "position": 1,
    "text": "کسی چشم دین را به سوزن ندوخت"
  },
  {
    "poem_id": 1587,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت هر چیز کامد ز پند"
  },
  {
    "poem_id": 1587,
    "vorder": 50,
    "position": 1,
    "text": "تن پاک و جان ترا سودمند"
  },
  {
    "poem_id": 1587,
    "vorder": 51,
    "position": 0,
    "text": "همه گفتم اکنون بهی برگزین"
  },
  {
    "poem_id": 1587,
    "vorder": 52,
    "position": 1,
    "text": "دل شهریاران نیازد به کین"
  },
  {
    "poem_id": 1587,
    "vorder": 53,
    "position": 0,
    "text": "سپهبد ز خوالیگران خواست خوان"
  },
  {
    "poem_id": 1587,
    "vorder": 54,
    "position": 1,
    "text": "کسی را نفرمود کو را بخوان"
  },
  {
    "poem_id": 1587,
    "vorder": 55,
    "position": 0,
    "text": "چو نان خورده شد جام می برگرفت"
  },
  {
    "poem_id": 1587,
    "vorder": 56,
    "position": 1,
    "text": "ز رویین دژ آنگه سخن درگرفت"
  },
  {
    "poem_id": 1587,
    "vorder": 57,
    "position": 0,
    "text": "ازان مردی خود همی یاد کرد"
  },
  {
    "poem_id": 1587,
    "vorder": 58,
    "position": 1,
    "text": "به یاد شهنشاه جامی بخورد"
  },
  {
    "poem_id": 1587,
    "vorder": 59,
    "position": 0,
    "text": "همی بود رستم به ایوان خویش"
  },
  {
    "poem_id": 1587,
    "vorder": 60,
    "position": 1,
    "text": "ز خوردن نگه داشت پیمان خویش"
  },
  {
    "poem_id": 1587,
    "vorder": 61,
    "position": 0,
    "text": "چو چندی برآمد نیامد کسی"
  },
  {
    "poem_id": 1587,
    "vorder": 62,
    "position": 1,
    "text": "نگه کرد رستم به ره بر بسی"
  },
  {
    "poem_id": 1587,
    "vorder": 63,
    "position": 0,
    "text": "چو هنگام نان خوردن اندر گذشت"
  },
  {
    "poem_id": 1587,
    "vorder": 64,
    "position": 1,
    "text": "ز مغز دلیر آب برتر گذشت"
  },
  {
    "poem_id": 1587,
    "vorder": 65,
    "position": 0,
    "text": "بخندید و گفت ای برادر تو خوان"
  },
  {
    "poem_id": 1587,
    "vorder": 66,
    "position": 1,
    "text": "بیارای و آزادگان را بخوان"
  },
  {
    "poem_id": 1587,
    "vorder": 67,
    "position": 0,
    "text": "گرینست آیین اسفندیار"
  },
  {
    "poem_id": 1587,
    "vorder": 68,
    "position": 1,
    "text": "تو آیین این نامور یاد دار"
  },
  {
    "poem_id": 1587,
    "vorder": 69,
    "position": 0,
    "text": "بفرمود تا رخش را زین کنند"
  },
  {
    "poem_id": 1587,
    "vorder": 70,
    "position": 1,
    "text": "همان زین به آرایش چین کنند"
  },
  {
    "poem_id": 1587,
    "vorder": 71,
    "position": 0,
    "text": "شوم باز گویم به اسفندیار"
  },
  {
    "poem_id": 1587,
    "vorder": 72,
    "position": 1,
    "text": "کجا کار ما را گرفتست خوار"
  }
]