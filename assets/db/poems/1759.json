[
  {
    "poem_id": 1759,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که یک روز در بزمگاه"
  },
  {
    "poem_id": 1759,
    "vorder": 2,
    "position": 1,
    "text": "همی بود بر پای در پیش شاه"
  },
  {
    "poem_id": 1759,
    "vorder": 3,
    "position": 0,
    "text": "چو شد تیره بر پای خواب آمدش"
  },
  {
    "poem_id": 1759,
    "vorder": 4,
    "position": 1,
    "text": "هم از ایستادن شتاب آمدش"
  },
  {
    "poem_id": 1759,
    "vorder": 5,
    "position": 0,
    "text": "پدر چون بدیدش بهم برده چشم"
  },
  {
    "poem_id": 1759,
    "vorder": 6,
    "position": 1,
    "text": "به تندی یکی بانگ برزد به خشم"
  },
  {
    "poem_id": 1759,
    "vorder": 7,
    "position": 0,
    "text": "به دژخیم فرمود کو را ببر"
  },
  {
    "poem_id": 1759,
    "vorder": 8,
    "position": 1,
    "text": "کزین پس نبیند کلاه و کمر"
  },
  {
    "poem_id": 1759,
    "vorder": 9,
    "position": 0,
    "text": "بدو خانه زندان کن و بازگرد"
  },
  {
    "poem_id": 1759,
    "vorder": 10,
    "position": 1,
    "text": "نزیبد برو گاه و ننگ و نبرد"
  },
  {
    "poem_id": 1759,
    "vorder": 11,
    "position": 0,
    "text": "به ایوان همی بود خسته جگر"
  },
  {
    "poem_id": 1759,
    "vorder": 12,
    "position": 1,
    "text": "ندید اندران سال روی پدر"
  },
  {
    "poem_id": 1759,
    "vorder": 13,
    "position": 0,
    "text": "مگر مهر و نوروز و جشن سده"
  },
  {
    "poem_id": 1759,
    "vorder": 14,
    "position": 1,
    "text": "که او پیش رفتی میان رده"
  },
  {
    "poem_id": 1759,
    "vorder": 15,
    "position": 0,
    "text": "چنان بد که طینوش رومی ز راه"
  },
  {
    "poem_id": 1759,
    "vorder": 16,
    "position": 1,
    "text": "فرستاده آمد به نزدیک شاه"
  },
  {
    "poem_id": 1759,
    "vorder": 17,
    "position": 0,
    "text": "ابا بدره و برده و باژ روم"
  },
  {
    "poem_id": 1759,
    "vorder": 18,
    "position": 1,
    "text": "فرستاد قیصر به آباد بوم"
  },
  {
    "poem_id": 1759,
    "vorder": 19,
    "position": 0,
    "text": "چو آمد شهنشاه بنواختش"
  },
  {
    "poem_id": 1759,
    "vorder": 20,
    "position": 1,
    "text": "سزاوار او جایگه ساختش"
  },
  {
    "poem_id": 1759,
    "vorder": 21,
    "position": 0,
    "text": "فرستاد بهرام زی او پیام"
  },
  {
    "poem_id": 1759,
    "vorder": 22,
    "position": 1,
    "text": "که ای مرد بیدار گسترده کام"
  },
  {
    "poem_id": 1759,
    "vorder": 23,
    "position": 0,
    "text": "ز کهتر به چیزی بیازرد شاه"
  },
  {
    "poem_id": 1759,
    "vorder": 24,
    "position": 1,
    "text": "ازو دور گشتم چنین بی‌گناه"
  },
  {
    "poem_id": 1759,
    "vorder": 25,
    "position": 0,
    "text": "تو خواهش کنی گر ترا بخشدم"
  },
  {
    "poem_id": 1759,
    "vorder": 26,
    "position": 1,
    "text": "مگر بخت پژمرده بدرخشدم"
  },
  {
    "poem_id": 1759,
    "vorder": 27,
    "position": 0,
    "text": "سوی دایگانم فرستد مگر"
  },
  {
    "poem_id": 1759,
    "vorder": 28,
    "position": 1,
    "text": "که منذر مرا به ز مام و پدر"
  },
  {
    "poem_id": 1759,
    "vorder": 29,
    "position": 0,
    "text": "چو طینوش بشنید پیغام اوی"
  },
  {
    "poem_id": 1759,
    "vorder": 30,
    "position": 1,
    "text": "برآورد ازان آرزو کام اوی"
  },
  {
    "poem_id": 1759,
    "vorder": 31,
    "position": 0,
    "text": "دل‌آزار بهرام زان شاد گشت"
  },
  {
    "poem_id": 1759,
    "vorder": 32,
    "position": 1,
    "text": "وزان بند بی‌مایه آزاد گشت"
  },
  {
    "poem_id": 1759,
    "vorder": 33,
    "position": 0,
    "text": "به درویش بخشید بسیار چیز"
  },
  {
    "poem_id": 1759,
    "vorder": 34,
    "position": 1,
    "text": "وزان جایگه رفتن آراست نیز"
  },
  {
    "poem_id": 1759,
    "vorder": 35,
    "position": 0,
    "text": "همه زیردستان خود را بخواند"
  },
  {
    "poem_id": 1759,
    "vorder": 36,
    "position": 1,
    "text": "شب تیره چون باد لشکر براند"
  },
  {
    "poem_id": 1759,
    "vorder": 37,
    "position": 0,
    "text": "به یاران همی گفت یزدان سپاس"
  },
  {
    "poem_id": 1759,
    "vorder": 38,
    "position": 1,
    "text": "که رفتیم و ایمن شدیم از هراس"
  },
  {
    "poem_id": 1759,
    "vorder": 39,
    "position": 0,
    "text": "چو آمد به نزدیک شهر یمن"
  },
  {
    "poem_id": 1759,
    "vorder": 40,
    "position": 1,
    "text": "پذیره شدش کودک و مرد و زن"
  },
  {
    "poem_id": 1759,
    "vorder": 41,
    "position": 0,
    "text": "برفتند نعمان و منذر ز جای"
  },
  {
    "poem_id": 1759,
    "vorder": 42,
    "position": 1,
    "text": "همان نیزه‌داران پاکیزه‌رای"
  },
  {
    "poem_id": 1759,
    "vorder": 43,
    "position": 0,
    "text": "چو منذر ببهرام نزدیک شد"
  },
  {
    "poem_id": 1759,
    "vorder": 44,
    "position": 1,
    "text": "ز گرد سپه روز تاریک شد"
  },
  {
    "poem_id": 1759,
    "vorder": 45,
    "position": 0,
    "text": "پیاده شدند آن دو آزادمرد"
  },
  {
    "poem_id": 1759,
    "vorder": 46,
    "position": 1,
    "text": "همی گفت بهرام تیمار و درد"
  },
  {
    "poem_id": 1759,
    "vorder": 47,
    "position": 0,
    "text": "ز گفتار او چند منذر گریست"
  },
  {
    "poem_id": 1759,
    "vorder": 48,
    "position": 1,
    "text": "بپرسید گفت اختر شاه چیست"
  },
  {
    "poem_id": 1759,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت بهرام کو خود مباد"
  },
  {
    "poem_id": 1759,
    "vorder": 50,
    "position": 1,
    "text": "که گیرد ز شوم اخترش نیز یاد"
  },
  {
    "poem_id": 1759,
    "vorder": 51,
    "position": 0,
    "text": "که هر کو نیاید به راه خرد"
  },
  {
    "poem_id": 1759,
    "vorder": 52,
    "position": 1,
    "text": "ز کردار ترسم که کیفر برد"
  },
  {
    "poem_id": 1759,
    "vorder": 53,
    "position": 0,
    "text": "فرود آوریدش هم‌انجا که بود"
  },
  {
    "poem_id": 1759,
    "vorder": 54,
    "position": 1,
    "text": "بران نیکوی نیکویها فزود"
  },
  {
    "poem_id": 1759,
    "vorder": 55,
    "position": 0,
    "text": "بجز بزم و میدان نبودیش کار"
  },
  {
    "poem_id": 1759,
    "vorder": 56,
    "position": 1,
    "text": "وگر بخشش و کوشش کارزار"
  }
]