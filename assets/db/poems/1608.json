[
  {
    "poem_id": 1608,
    "vorder": 1,
    "position": 0,
    "text": "بداختر چو از شهر کابل برفت"
  },
  {
    "poem_id": 1608,
    "vorder": 2,
    "position": 1,
    "text": "بدان دشت نخچیر شد شاه تفت"
  },
  {
    "poem_id": 1608,
    "vorder": 3,
    "position": 0,
    "text": "ببرد از میان لشکری چاه‌کن"
  },
  {
    "poem_id": 1608,
    "vorder": 4,
    "position": 1,
    "text": "کجا نام بردند زان انجمن"
  },
  {
    "poem_id": 1608,
    "vorder": 5,
    "position": 0,
    "text": "سراسر همه دشت نخچیرگاه"
  },
  {
    "poem_id": 1608,
    "vorder": 6,
    "position": 1,
    "text": "همه چاه بد کنده در زیر راه"
  },
  {
    "poem_id": 1608,
    "vorder": 7,
    "position": 0,
    "text": "زده حربه‌ها را بن اندر زمین"
  },
  {
    "poem_id": 1608,
    "vorder": 8,
    "position": 1,
    "text": "همان نیز ژوپین و شمشیر کین"
  },
  {
    "poem_id": 1608,
    "vorder": 9,
    "position": 0,
    "text": "به خاشاک کرده سر چاه کور"
  },
  {
    "poem_id": 1608,
    "vorder": 10,
    "position": 1,
    "text": "که مردم ندیدی نه چشم ستور"
  },
  {
    "poem_id": 1608,
    "vorder": 11,
    "position": 0,
    "text": "چو رستم دمان سر برفتن نهاد"
  },
  {
    "poem_id": 1608,
    "vorder": 12,
    "position": 1,
    "text": "سواری برافگند پویان شغاد"
  },
  {
    "poem_id": 1608,
    "vorder": 13,
    "position": 0,
    "text": "که آمد گو پیلتن با سپاه"
  },
  {
    "poem_id": 1608,
    "vorder": 14,
    "position": 1,
    "text": "بیا پیش وزان کرده زنهار خواه"
  },
  {
    "poem_id": 1608,
    "vorder": 15,
    "position": 0,
    "text": "سپهدار کابل بیامد ز شهر"
  },
  {
    "poem_id": 1608,
    "vorder": 16,
    "position": 1,
    "text": "زبان پرسخن دل پر از کین و زهر"
  },
  {
    "poem_id": 1608,
    "vorder": 17,
    "position": 0,
    "text": "چو چشمش به روی تهمتن رسید"
  },
  {
    "poem_id": 1608,
    "vorder": 18,
    "position": 1,
    "text": "پیاده شد از باره کو را بدید"
  },
  {
    "poem_id": 1608,
    "vorder": 19,
    "position": 0,
    "text": "ز سرشارهٔ هندوی برگرفت"
  },
  {
    "poem_id": 1608,
    "vorder": 20,
    "position": 1,
    "text": "برهنه شد و دست بر سر گرفت"
  },
  {
    "poem_id": 1608,
    "vorder": 21,
    "position": 0,
    "text": "همان موزه از پای بیرون کشید"
  },
  {
    "poem_id": 1608,
    "vorder": 22,
    "position": 1,
    "text": "به زاری ز مژگان همی خون کشید"
  },
  {
    "poem_id": 1608,
    "vorder": 23,
    "position": 0,
    "text": "دو رخ را به خاک سیه بر نهاد"
  },
  {
    "poem_id": 1608,
    "vorder": 24,
    "position": 1,
    "text": "همی کرد پوزش ز کار شغاد"
  },
  {
    "poem_id": 1608,
    "vorder": 25,
    "position": 0,
    "text": "که گر مست شد بنده از بیهشی"
  },
  {
    "poem_id": 1608,
    "vorder": 26,
    "position": 1,
    "text": "نمود اندران بیهشی سرکشی"
  },
  {
    "poem_id": 1608,
    "vorder": 27,
    "position": 0,
    "text": "سزد گر ببخشی گناه مرا"
  },
  {
    "poem_id": 1608,
    "vorder": 28,
    "position": 1,
    "text": "کنی تازه آیین و راه مرا"
  },
  {
    "poem_id": 1608,
    "vorder": 29,
    "position": 0,
    "text": "همی رفت پیشش برهنه دو پای"
  },
  {
    "poem_id": 1608,
    "vorder": 30,
    "position": 1,
    "text": "سری پر ز کینه دلی پر ز رای"
  },
  {
    "poem_id": 1608,
    "vorder": 31,
    "position": 0,
    "text": "ببخشید رستم گناه ورا"
  },
  {
    "poem_id": 1608,
    "vorder": 32,
    "position": 1,
    "text": "بیفزود زان پایگاه ورا"
  },
  {
    "poem_id": 1608,
    "vorder": 33,
    "position": 0,
    "text": "بفرمود تا سر بپوشید و پای"
  },
  {
    "poem_id": 1608,
    "vorder": 34,
    "position": 1,
    "text": "به زین بر نشست و بیامد ز جای"
  },
  {
    "poem_id": 1608,
    "vorder": 35,
    "position": 0,
    "text": "بر شهر کابل یکی جای بود"
  },
  {
    "poem_id": 1608,
    "vorder": 36,
    "position": 1,
    "text": "ز سبزی زمینش دلارای بود"
  },
  {
    "poem_id": 1608,
    "vorder": 37,
    "position": 0,
    "text": "بدو اندرون چشمه بود و درخت"
  },
  {
    "poem_id": 1608,
    "vorder": 38,
    "position": 1,
    "text": "به شادی نهادند هرجای تخت"
  },
  {
    "poem_id": 1608,
    "vorder": 39,
    "position": 0,
    "text": "بسی خوردنیها بیاورد شاه"
  },
  {
    "poem_id": 1608,
    "vorder": 40,
    "position": 1,
    "text": "بیاراست خرم یکی جشنگاه"
  },
  {
    "poem_id": 1608,
    "vorder": 41,
    "position": 0,
    "text": "می آورد و رامشگران را بخواند"
  },
  {
    "poem_id": 1608,
    "vorder": 42,
    "position": 1,
    "text": "مهان را به تخت مهی بر نشاند"
  },
  {
    "poem_id": 1608,
    "vorder": 43,
    "position": 0,
    "text": "ازان پس به رستم چنین گفت شاه"
  },
  {
    "poem_id": 1608,
    "vorder": 44,
    "position": 1,
    "text": "که چون رایت آید به نخچیرگاه"
  },
  {
    "poem_id": 1608,
    "vorder": 45,
    "position": 0,
    "text": "یکی جای دارم برین دشت و کوه"
  },
  {
    "poem_id": 1608,
    "vorder": 46,
    "position": 1,
    "text": "به هر جای نخچیر گشته گروه"
  },
  {
    "poem_id": 1608,
    "vorder": 47,
    "position": 0,
    "text": "همه دشت غرمست و آهو و گور"
  },
  {
    "poem_id": 1608,
    "vorder": 48,
    "position": 1,
    "text": "کسی را که باشد تگاور ستور"
  },
  {
    "poem_id": 1608,
    "vorder": 49,
    "position": 0,
    "text": "به چنگ آیدش گور و آهو به دشت"
  },
  {
    "poem_id": 1608,
    "vorder": 50,
    "position": 1,
    "text": "ازان دشت خرم نشاید گذشت"
  },
  {
    "poem_id": 1608,
    "vorder": 51,
    "position": 0,
    "text": "ز گفتار او رستم آمد به شور"
  },
  {
    "poem_id": 1608,
    "vorder": 52,
    "position": 1,
    "text": "ازان دشت پرآب و نخچیرگور"
  },
  {
    "poem_id": 1608,
    "vorder": 53,
    "position": 0,
    "text": "به چیزی که آید کسی را زمان"
  },
  {
    "poem_id": 1608,
    "vorder": 54,
    "position": 1,
    "text": "بپیچد دلش کور گردد گمان"
  },
  {
    "poem_id": 1608,
    "vorder": 55,
    "position": 0,
    "text": "چنین است کار جهان جهان"
  },
  {
    "poem_id": 1608,
    "vorder": 56,
    "position": 1,
    "text": "نخواهد گشادن بمابر نهان"
  },
  {
    "poem_id": 1608,
    "vorder": 57,
    "position": 0,
    "text": "به دریا نهنگ و به هامون پلنگ"
  },
  {
    "poem_id": 1608,
    "vorder": 58,
    "position": 1,
    "text": "همان شیر جنگاور تیزچنگ"
  },
  {
    "poem_id": 1608,
    "vorder": 59,
    "position": 0,
    "text": "ابا پشه و مور در چنگ مرگ"
  },
  {
    "poem_id": 1608,
    "vorder": 60,
    "position": 1,
    "text": "یکی باشد ایدر بدن نیست برگ"
  },
  {
    "poem_id": 1608,
    "vorder": 61,
    "position": 0,
    "text": "بفرمود تا رخش را زین کنند"
  },
  {
    "poem_id": 1608,
    "vorder": 62,
    "position": 1,
    "text": "همه دشت پر باز و شاهین کنند"
  },
  {
    "poem_id": 1608,
    "vorder": 63,
    "position": 0,
    "text": "کمان کیانی به زه بر نهاد"
  },
  {
    "poem_id": 1608,
    "vorder": 64,
    "position": 1,
    "text": "همی راند بر دشت او با شغاد"
  },
  {
    "poem_id": 1608,
    "vorder": 65,
    "position": 0,
    "text": "زواره همی رفت با پیلتن"
  },
  {
    "poem_id": 1608,
    "vorder": 66,
    "position": 1,
    "text": "تنی چند ازان نامدار انجمن"
  },
  {
    "poem_id": 1608,
    "vorder": 67,
    "position": 0,
    "text": "به نخچیر لشکر پراگنده شد"
  },
  {
    "poem_id": 1608,
    "vorder": 68,
    "position": 1,
    "text": "اگر کنده گر سوی آگنده شد"
  },
  {
    "poem_id": 1608,
    "vorder": 69,
    "position": 0,
    "text": "زواره تهمتن بران راه بود"
  },
  {
    "poem_id": 1608,
    "vorder": 70,
    "position": 1,
    "text": "ز بهر زمان کاندران چاه بود"
  },
  {
    "poem_id": 1608,
    "vorder": 71,
    "position": 0,
    "text": "همی رخش زان خاک می‌یافت بوی"
  },
  {
    "poem_id": 1608,
    "vorder": 72,
    "position": 1,
    "text": "تن خویش را کرد چون گردگوی"
  },
  {
    "poem_id": 1608,
    "vorder": 73,
    "position": 0,
    "text": "همی جست و ترسان شد از بوی خاک"
  },
  {
    "poem_id": 1608,
    "vorder": 74,
    "position": 1,
    "text": "زمین را به نعلش همی کرد چاک"
  },
  {
    "poem_id": 1608,
    "vorder": 75,
    "position": 0,
    "text": "بزد گام رخش تگاور به راه"
  },
  {
    "poem_id": 1608,
    "vorder": 76,
    "position": 1,
    "text": "چنین تا بیامد میان دو چاه"
  },
  {
    "poem_id": 1608,
    "vorder": 77,
    "position": 0,
    "text": "دل رستم از رخش شد پر ز خشم"
  },
  {
    "poem_id": 1608,
    "vorder": 78,
    "position": 1,
    "text": "زمانش خرد را بپوشید چشم"
  },
  {
    "poem_id": 1608,
    "vorder": 79,
    "position": 0,
    "text": "یکی تازیانه برآورد نرم"
  },
  {
    "poem_id": 1608,
    "vorder": 80,
    "position": 1,
    "text": "بزد نیک دل رخش را کرد گرم"
  },
  {
    "poem_id": 1608,
    "vorder": 81,
    "position": 0,
    "text": "چو او تنگ شد در میان دو چاه"
  },
  {
    "poem_id": 1608,
    "vorder": 82,
    "position": 1,
    "text": "ز چنگ زمانه همی جست راه"
  },
  {
    "poem_id": 1608,
    "vorder": 83,
    "position": 0,
    "text": "دو پایش فروشد به یک چاهسار"
  },
  {
    "poem_id": 1608,
    "vorder": 84,
    "position": 1,
    "text": "نبد جای آویزش و کارزار"
  },
  {
    "poem_id": 1608,
    "vorder": 85,
    "position": 0,
    "text": "بن چاه پر حربه و تیغ تیز"
  },
  {
    "poem_id": 1608,
    "vorder": 86,
    "position": 1,
    "text": "نبد جای مردی و راه گریز"
  },
  {
    "poem_id": 1608,
    "vorder": 87,
    "position": 0,
    "text": "بدرید پهلوی رخش سترگ"
  },
  {
    "poem_id": 1608,
    "vorder": 88,
    "position": 1,
    "text": "بر و پای آن پهلوان بزرگ"
  },
  {
    "poem_id": 1608,
    "vorder": 89,
    "position": 0,
    "text": "به مردی تن خویش را برکشید"
  },
  {
    "poem_id": 1608,
    "vorder": 90,
    "position": 1,
    "text": "دلیر از بن چاه بر سر کشید"
  }
]