[
  {
    "poem_id": 1838,
    "vorder": 1,
    "position": 0,
    "text": "چو پنهان شد آن چادر آبنوس"
  },
  {
    "poem_id": 1838,
    "vorder": 2,
    "position": 1,
    "text": "بگوش آمد از دوربانگ خروش"
  },
  {
    "poem_id": 1838,
    "vorder": 3,
    "position": 0,
    "text": "جهانگیر شد تابنزد پدر"
  },
  {
    "poem_id": 1838,
    "vorder": 4,
    "position": 1,
    "text": "نهانش پر ازدرد وخسته جگر"
  },
  {
    "poem_id": 1838,
    "vorder": 5,
    "position": 0,
    "text": "چو دیدش بنالید و بردش نماز"
  },
  {
    "poem_id": 1838,
    "vorder": 6,
    "position": 1,
    "text": "همی‌بود پیشش زمانی دراز"
  },
  {
    "poem_id": 1838,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت کای شاه نابختیار"
  },
  {
    "poem_id": 1838,
    "vorder": 8,
    "position": 1,
    "text": "ز نوشین روان در جهان یادگار"
  },
  {
    "poem_id": 1838,
    "vorder": 9,
    "position": 0,
    "text": "تو دانی که گر بودمی پشت تو"
  },
  {
    "poem_id": 1838,
    "vorder": 10,
    "position": 1,
    "text": "بسوزن نخستی سر انگشت تو"
  },
  {
    "poem_id": 1838,
    "vorder": 11,
    "position": 0,
    "text": "نگر تا چه فرمایی اکنون مرا"
  },
  {
    "poem_id": 1838,
    "vorder": 12,
    "position": 1,
    "text": "غم آمد تو را دل پر از خون مرا"
  },
  {
    "poem_id": 1838,
    "vorder": 13,
    "position": 0,
    "text": "گر ای دون که فرمان دهی بر درت"
  },
  {
    "poem_id": 1838,
    "vorder": 14,
    "position": 1,
    "text": "یکی بنده‌ام پاسبان سرت"
  },
  {
    "poem_id": 1838,
    "vorder": 15,
    "position": 0,
    "text": "نجویم کلاه و نخواهم سپاه"
  },
  {
    "poem_id": 1838,
    "vorder": 16,
    "position": 1,
    "text": "ببرم سرخویش در پیش شاه"
  },
  {
    "poem_id": 1838,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت هرمزد ای پرخرد"
  },
  {
    "poem_id": 1838,
    "vorder": 18,
    "position": 1,
    "text": "همین روز سختی ز من بگذرد"
  },
  {
    "poem_id": 1838,
    "vorder": 19,
    "position": 0,
    "text": "مرا نزد تو آرزو بد سه چیز"
  },
  {
    "poem_id": 1838,
    "vorder": 20,
    "position": 1,
    "text": "برین بر فزونی نخواهیم نیز"
  },
  {
    "poem_id": 1838,
    "vorder": 21,
    "position": 0,
    "text": "یکی آنک شبگیر هر بامداد"
  },
  {
    "poem_id": 1838,
    "vorder": 22,
    "position": 1,
    "text": "کنی گوش ما را به آواز شاد"
  },
  {
    "poem_id": 1838,
    "vorder": 23,
    "position": 0,
    "text": "و دیگر سواری ز گردنکشان"
  },
  {
    "poem_id": 1838,
    "vorder": 24,
    "position": 1,
    "text": "که از رزم دیرینه دارد نشان"
  },
  {
    "poem_id": 1838,
    "vorder": 25,
    "position": 0,
    "text": "بر من فرستی که از کارزار"
  },
  {
    "poem_id": 1838,
    "vorder": 26,
    "position": 1,
    "text": "سخن گوید و کرده باشد شکار"
  },
  {
    "poem_id": 1838,
    "vorder": 27,
    "position": 0,
    "text": "دگر آنک داننده مرد کهن"
  },
  {
    "poem_id": 1838,
    "vorder": 28,
    "position": 1,
    "text": "که از شهریاران گزارد سخن"
  },
  {
    "poem_id": 1838,
    "vorder": 29,
    "position": 0,
    "text": "نوشته یکی دفتر آرد مرا"
  },
  {
    "poem_id": 1838,
    "vorder": 30,
    "position": 1,
    "text": "بدان درد و سختی سرآرد مرا"
  },
  {
    "poem_id": 1838,
    "vorder": 31,
    "position": 0,
    "text": "سیم آرزوی آنک خال تواند"
  },
  {
    "poem_id": 1838,
    "vorder": 32,
    "position": 1,
    "text": "پرستنده و ناهمال تواند"
  },
  {
    "poem_id": 1838,
    "vorder": 33,
    "position": 0,
    "text": "نبینند زین پس جهان را بچشم"
  },
  {
    "poem_id": 1838,
    "vorder": 34,
    "position": 1,
    "text": "بریشان برانی برین سوک خشم"
  },
  {
    "poem_id": 1838,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت خسرو که ای شهریار"
  },
  {
    "poem_id": 1838,
    "vorder": 36,
    "position": 1,
    "text": "مباد آنک برچشم تو سوکوار"
  },
  {
    "poem_id": 1838,
    "vorder": 37,
    "position": 0,
    "text": "نباشد و گرچه بود درنهان"
  },
  {
    "poem_id": 1838,
    "vorder": 38,
    "position": 1,
    "text": "که بدخواه تو دور بادازجهان"
  },
  {
    "poem_id": 1838,
    "vorder": 39,
    "position": 0,
    "text": "ولیکن نگه کن بروشن روان"
  },
  {
    "poem_id": 1838,
    "vorder": 40,
    "position": 1,
    "text": "که بهرام چوبینه شد پهلوان"
  },
  {
    "poem_id": 1838,
    "vorder": 41,
    "position": 0,
    "text": "سپاهست با او فزون از شمار"
  },
  {
    "poem_id": 1838,
    "vorder": 42,
    "position": 1,
    "text": "سواران و گردان خنجرگزار"
  },
  {
    "poem_id": 1838,
    "vorder": 43,
    "position": 0,
    "text": "اگر ما بگستهم یازیم دست"
  },
  {
    "poem_id": 1838,
    "vorder": 44,
    "position": 1,
    "text": "بگیتی نیابیم جای نشست"
  },
  {
    "poem_id": 1838,
    "vorder": 45,
    "position": 0,
    "text": "دگر آنک باشد دبیر کهن"
  },
  {
    "poem_id": 1838,
    "vorder": 46,
    "position": 1,
    "text": "که برشاه خواند گذشته سخن"
  },
  {
    "poem_id": 1838,
    "vorder": 47,
    "position": 0,
    "text": "سواری که پرورده باشد برزم"
  },
  {
    "poem_id": 1838,
    "vorder": 48,
    "position": 1,
    "text": "بداند همان نیز آیین بزم"
  },
  {
    "poem_id": 1838,
    "vorder": 49,
    "position": 0,
    "text": "ازین هر زمان نو فرستم یکی"
  },
  {
    "poem_id": 1838,
    "vorder": 50,
    "position": 1,
    "text": "تو با درد پژمان مباش اندکی"
  },
  {
    "poem_id": 1838,
    "vorder": 51,
    "position": 0,
    "text": "مدان این زگستهم کاین ایزدیست"
  },
  {
    "poem_id": 1838,
    "vorder": 52,
    "position": 1,
    "text": "ز گفتار و کردار نابخردیست"
  },
  {
    "poem_id": 1838,
    "vorder": 53,
    "position": 0,
    "text": "دل تو بدین درد خرسند باد"
  },
  {
    "poem_id": 1838,
    "vorder": 54,
    "position": 1,
    "text": "همان با خرد نیز پیوند باد"
  },
  {
    "poem_id": 1838,
    "vorder": 55,
    "position": 0,
    "text": "بگفت این و گریان بیامد زپیش"
  },
  {
    "poem_id": 1838,
    "vorder": 56,
    "position": 1,
    "text": "نکرد آشکارا بکس راز خویش"
  },
  {
    "poem_id": 1838,
    "vorder": 57,
    "position": 0,
    "text": "پسر مهربان‌تر بد از شهریار"
  },
  {
    "poem_id": 1838,
    "vorder": 58,
    "position": 1,
    "text": "بدین داستان زد یکی هوشیار"
  },
  {
    "poem_id": 1838,
    "vorder": 59,
    "position": 0,
    "text": "که یار زبان چرب و شیرین سخن"
  },
  {
    "poem_id": 1838,
    "vorder": 60,
    "position": 1,
    "text": "که از پیر نستوه گشته کهن"
  },
  {
    "poem_id": 1838,
    "vorder": 61,
    "position": 0,
    "text": "هنرمند گر مردم بی‌هنر"
  },
  {
    "poem_id": 1838,
    "vorder": 62,
    "position": 1,
    "text": "بفرجام هم خاک دارد ببر"
  }
]