[
  {
    "poem_id": 88039,
    "vorder": 1,
    "position": 0,
    "text": "به شبگیر چون تاج بر سر نهاد"
  },
  {
    "poem_id": 88039,
    "vorder": 2,
    "position": 1,
    "text": "همانگه فرستاده را در گشاد"
  },
  {
    "poem_id": 88039,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا بازگردد به جای"
  },
  {
    "poem_id": 88039,
    "vorder": 4,
    "position": 1,
    "text": "سوی نامور بندهٔ کدخدای"
  },
  {
    "poem_id": 88039,
    "vorder": 5,
    "position": 0,
    "text": "چنین پاسخ آورد کو را بگوی"
  },
  {
    "poem_id": 88039,
    "vorder": 6,
    "position": 1,
    "text": "که ای مهربان نیکدل راستگوی"
  },
  {
    "poem_id": 88039,
    "vorder": 7,
    "position": 0,
    "text": "تو تا زادی از مادر پاکتن"
  },
  {
    "poem_id": 88039,
    "vorder": 8,
    "position": 1,
    "text": "سرافراز بودی به هر انجمن"
  },
  {
    "poem_id": 88039,
    "vorder": 9,
    "position": 0,
    "text": "ترا بیشتر نزد من دستگاه"
  },
  {
    "poem_id": 88039,
    "vorder": 10,
    "position": 1,
    "text": "توی برتر از پهلوانان به جاه"
  },
  {
    "poem_id": 88039,
    "vorder": 11,
    "position": 0,
    "text": "همیشه یکی جوشنی پیش من"
  },
  {
    "poem_id": 88039,
    "vorder": 12,
    "position": 1,
    "text": "سپر کرده جان و فدی کرده تن"
  },
  {
    "poem_id": 88039,
    "vorder": 13,
    "position": 0,
    "text": "همیدون به هر کار با گنج خویش"
  },
  {
    "poem_id": 88039,
    "vorder": 14,
    "position": 1,
    "text": "گزیده ز بهر منی رنج خویش"
  },
  {
    "poem_id": 88039,
    "vorder": 15,
    "position": 0,
    "text": "تو بردی ز چین تا به ایران سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 16,
    "position": 1,
    "text": "تو کردی دل و بخت دشمن سیاه"
  },
  {
    "poem_id": 88039,
    "vorder": 17,
    "position": 0,
    "text": "نبیند سپه چون تو سالار نیز"
  },
  {
    "poem_id": 88039,
    "vorder": 18,
    "position": 1,
    "text": "نبندد کمر چون تو هشیار نیز"
  },
  {
    "poem_id": 88039,
    "vorder": 19,
    "position": 0,
    "text": "ز تور و پشنگ ار دراید به مهر"
  },
  {
    "poem_id": 88039,
    "vorder": 20,
    "position": 1,
    "text": "چو تو پهلوان نیز نارد سپهر"
  },
  {
    "poem_id": 88039,
    "vorder": 21,
    "position": 0,
    "text": "نخست آنک گفتی من از انجمن"
  },
  {
    "poem_id": 88039,
    "vorder": 22,
    "position": 1,
    "text": "گنهکار دارم همی خویشتن"
  },
  {
    "poem_id": 88039,
    "vorder": 23,
    "position": 0,
    "text": "که کیخسرو آمد ز توران زمین"
  },
  {
    "poem_id": 88039,
    "vorder": 24,
    "position": 1,
    "text": "به ایران و با ما بگسترد کین"
  },
  {
    "poem_id": 88039,
    "vorder": 25,
    "position": 0,
    "text": "بدین من که شاهم نیازرده‌ام"
  },
  {
    "poem_id": 88039,
    "vorder": 26,
    "position": 1,
    "text": "به دل هرگز این یاد ناورده‌ام"
  },
  {
    "poem_id": 88039,
    "vorder": 27,
    "position": 0,
    "text": "نباید که باشی بدین تنگدل"
  },
  {
    "poem_id": 88039,
    "vorder": 28,
    "position": 1,
    "text": "ز تیمار یابد ترا زنگ دل"
  },
  {
    "poem_id": 88039,
    "vorder": 29,
    "position": 0,
    "text": "که آن بودنی بود از کردگار"
  },
  {
    "poem_id": 88039,
    "vorder": 30,
    "position": 1,
    "text": "نیامد بدین بد کس آموزگار"
  },
  {
    "poem_id": 88039,
    "vorder": 31,
    "position": 0,
    "text": "که کیخسرو از من نگیرد فروغ"
  },
  {
    "poem_id": 88039,
    "vorder": 32,
    "position": 1,
    "text": "نبیره مخوانش که باشد دروغ"
  },
  {
    "poem_id": 88039,
    "vorder": 33,
    "position": 0,
    "text": "نباشم همیدون من او را نیا"
  },
  {
    "poem_id": 88039,
    "vorder": 34,
    "position": 1,
    "text": "نجویم همی ز این سخن کیمیا"
  },
  {
    "poem_id": 88039,
    "vorder": 35,
    "position": 0,
    "text": "بدین کار او کس گنهکار نیست"
  },
  {
    "poem_id": 88039,
    "vorder": 36,
    "position": 1,
    "text": "مرا با جهاندار پیکار نیست"
  },
  {
    "poem_id": 88039,
    "vorder": 37,
    "position": 0,
    "text": "چنین بود و این بودنی کار بود"
  },
  {
    "poem_id": 88039,
    "vorder": 38,
    "position": 1,
    "text": "مرا از تو در دل چه آزار بود"
  },
  {
    "poem_id": 88039,
    "vorder": 39,
    "position": 0,
    "text": "و دیگر که گفتی ز کار سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 40,
    "position": 1,
    "text": "ز گردیدن تیره خورشید و ماه"
  },
  {
    "poem_id": 88039,
    "vorder": 41,
    "position": 0,
    "text": "همیشه چنینست کار نبرد"
  },
  {
    "poem_id": 88039,
    "vorder": 42,
    "position": 1,
    "text": "ز هر سو همی گردد این تیره گرد"
  },
  {
    "poem_id": 88039,
    "vorder": 43,
    "position": 0,
    "text": "گهی برکشد تا به خورشید سر"
  },
  {
    "poem_id": 88039,
    "vorder": 44,
    "position": 1,
    "text": "گهی اندر آرد ز خورشید بر"
  },
  {
    "poem_id": 88039,
    "vorder": 45,
    "position": 0,
    "text": "به یکسان نگردد سپهر بلند"
  },
  {
    "poem_id": 88039,
    "vorder": 46,
    "position": 1,
    "text": "گهی شاد دارد گهی مستمند"
  },
  {
    "poem_id": 88039,
    "vorder": 47,
    "position": 0,
    "text": "گهی با می و رود و رامشگران"
  },
  {
    "poem_id": 88039,
    "vorder": 48,
    "position": 1,
    "text": "گهی با غم و گرم و با اندهان"
  },
  {
    "poem_id": 88039,
    "vorder": 49,
    "position": 0,
    "text": "تو دل را بدین درد خسته مدار"
  },
  {
    "poem_id": 88039,
    "vorder": 50,
    "position": 1,
    "text": "روان را بدین کار بسته مدار"
  },
  {
    "poem_id": 88039,
    "vorder": 51,
    "position": 0,
    "text": "سخن گفتن کشتگان گشت خواب"
  },
  {
    "poem_id": 88039,
    "vorder": 52,
    "position": 1,
    "text": "ز کین برادر تو سر برمتاب"
  },
  {
    "poem_id": 88039,
    "vorder": 53,
    "position": 0,
    "text": "دلی کو ز درد برادر شخود"
  },
  {
    "poem_id": 88039,
    "vorder": 54,
    "position": 1,
    "text": "علاج پزشکان نداردش سود"
  },
  {
    "poem_id": 88039,
    "vorder": 55,
    "position": 0,
    "text": "سه دیگر که گفتی که خسرو پگاه"
  },
  {
    "poem_id": 88039,
    "vorder": 56,
    "position": 1,
    "text": "به جنگ اندر آید همی با سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 57,
    "position": 0,
    "text": "مبیناد چشم کس آن روزگار"
  },
  {
    "poem_id": 88039,
    "vorder": 58,
    "position": 1,
    "text": "که او پیشدستی نماید به کار"
  },
  {
    "poem_id": 88039,
    "vorder": 59,
    "position": 0,
    "text": "که من خود بر آنم کز ایدر سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 60,
    "position": 1,
    "text": "از آن سوی جیحون گذارم به راه"
  },
  {
    "poem_id": 88039,
    "vorder": 61,
    "position": 0,
    "text": "نه گودرز مانم نه خسرو نه طوس"
  },
  {
    "poem_id": 88039,
    "vorder": 62,
    "position": 1,
    "text": "نه گاه و نه تاج و نه بوق و نه کوس"
  },
  {
    "poem_id": 88039,
    "vorder": 63,
    "position": 0,
    "text": "به ایران از آن گونه رانم سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 64,
    "position": 1,
    "text": "کزان پس نبیند کسی تاج و گاه"
  },
  {
    "poem_id": 88039,
    "vorder": 65,
    "position": 0,
    "text": "به کیخسرو این پس نمانم جهان"
  },
  {
    "poem_id": 88039,
    "vorder": 66,
    "position": 1,
    "text": "به سر بر فرود آیمش ناگهان"
  },
  {
    "poem_id": 88039,
    "vorder": 67,
    "position": 0,
    "text": "به خنجر از آن سان ببرم سرش"
  },
  {
    "poem_id": 88039,
    "vorder": 68,
    "position": 1,
    "text": "که گرید بدو لشکر و کشورش"
  },
  {
    "poem_id": 88039,
    "vorder": 69,
    "position": 0,
    "text": "مگر کآسمانی دگرگونه کار"
  },
  {
    "poem_id": 88039,
    "vorder": 70,
    "position": 1,
    "text": "فراز آید از گردش روزگار"
  },
  {
    "poem_id": 88039,
    "vorder": 71,
    "position": 0,
    "text": "ترا ای جهاندیدهٔ سرافراز"
  },
  {
    "poem_id": 88039,
    "vorder": 72,
    "position": 1,
    "text": "نکردست یزدان به چیزی نیاز"
  },
  {
    "poem_id": 88039,
    "vorder": 73,
    "position": 0,
    "text": "ز مردان وز گنج و نیروی دست"
  },
  {
    "poem_id": 88039,
    "vorder": 74,
    "position": 1,
    "text": "همه ایزدی هرچ بایدت هست"
  },
  {
    "poem_id": 88039,
    "vorder": 75,
    "position": 0,
    "text": "یکی نامور لشکری ده هزار"
  },
  {
    "poem_id": 88039,
    "vorder": 76,
    "position": 1,
    "text": "دلیر و خردمند و گرد و سوار"
  },
  {
    "poem_id": 88039,
    "vorder": 77,
    "position": 0,
    "text": "فرستادم اینک به نزدیک تو"
  },
  {
    "poem_id": 88039,
    "vorder": 78,
    "position": 1,
    "text": "که روشن کند جان تاریک تو"
  },
  {
    "poem_id": 88039,
    "vorder": 79,
    "position": 0,
    "text": "از ایرانیان ده وز اینها یکی"
  },
  {
    "poem_id": 88039,
    "vorder": 80,
    "position": 1,
    "text": "به چشم یکی ده سوار اندکی"
  },
  {
    "poem_id": 88039,
    "vorder": 81,
    "position": 0,
    "text": "چو لشکر به نزد تو آید مپای"
  },
  {
    "poem_id": 88039,
    "vorder": 82,
    "position": 1,
    "text": "سر و تاج گودرز بگسل ز جای"
  },
  {
    "poem_id": 88039,
    "vorder": 83,
    "position": 0,
    "text": "همان کوه کو کرده دارد حصار"
  },
  {
    "poem_id": 88039,
    "vorder": 84,
    "position": 1,
    "text": "به اسبان جنگی ز پا اندر آر"
  },
  {
    "poem_id": 88039,
    "vorder": 85,
    "position": 0,
    "text": "مکش دست از ایشان به خون ریختن"
  },
  {
    "poem_id": 88039,
    "vorder": 86,
    "position": 1,
    "text": "تو پیروز باشی به آویختن"
  },
  {
    "poem_id": 88039,
    "vorder": 87,
    "position": 0,
    "text": "ممان زنده ز ایشان به گیتی کسی"
  },
  {
    "poem_id": 88039,
    "vorder": 88,
    "position": 1,
    "text": "که نزد تو آید از ایشان بسی"
  },
  {
    "poem_id": 88039,
    "vorder": 89,
    "position": 0,
    "text": "فرستاده بشنید پیغام شاه"
  },
  {
    "poem_id": 88039,
    "vorder": 90,
    "position": 1,
    "text": "بیامد بر پهلوان سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 91,
    "position": 0,
    "text": "به پیش اندر آمد به سان شمن"
  },
  {
    "poem_id": 88039,
    "vorder": 92,
    "position": 1,
    "text": "خمیده چو از بار شاخ سمن"
  },
  {
    "poem_id": 88039,
    "vorder": 93,
    "position": 0,
    "text": "به پیران رسانید پیغام شاه"
  },
  {
    "poem_id": 88039,
    "vorder": 94,
    "position": 1,
    "text": "وز آن نامداران جنگی سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 95,
    "position": 0,
    "text": "چو بشنید پیران سپه را بخواند"
  },
  {
    "poem_id": 88039,
    "vorder": 96,
    "position": 1,
    "text": "فرستاده چون این سخن باز راند"
  },
  {
    "poem_id": 88039,
    "vorder": 97,
    "position": 0,
    "text": "سپه را سراسر همه داد دل"
  },
  {
    "poem_id": 88039,
    "vorder": 98,
    "position": 1,
    "text": "که از غم بباشید آزاد دل"
  },
  {
    "poem_id": 88039,
    "vorder": 99,
    "position": 0,
    "text": "نهانی روانش پر از درد بود"
  },
  {
    "poem_id": 88039,
    "vorder": 100,
    "position": 1,
    "text": "پر از خون دل و بخت برگرد بود"
  },
  {
    "poem_id": 88039,
    "vorder": 101,
    "position": 0,
    "text": "که از هر سوی لشکر شهریار"
  },
  {
    "poem_id": 88039,
    "vorder": 102,
    "position": 1,
    "text": "همی کاسته دید در کارزار"
  },
  {
    "poem_id": 88039,
    "vorder": 103,
    "position": 0,
    "text": "هم از شاه خسرو دلش بود تنگ"
  },
  {
    "poem_id": 88039,
    "vorder": 104,
    "position": 1,
    "text": "بترسید کآید یکایک به جنگ"
  },
  {
    "poem_id": 88039,
    "vorder": 105,
    "position": 0,
    "text": "به یزدان چنین گفت کای کردگار"
  },
  {
    "poem_id": 88039,
    "vorder": 106,
    "position": 1,
    "text": "چه مایه شگفت اندر این روزگار"
  },
  {
    "poem_id": 88039,
    "vorder": 107,
    "position": 0,
    "text": "که را برکشیدی تو افگنده نیست"
  },
  {
    "poem_id": 88039,
    "vorder": 108,
    "position": 1,
    "text": "جز از تو جهاندار دارنده نیست"
  },
  {
    "poem_id": 88039,
    "vorder": 109,
    "position": 0,
    "text": "به خسرو نگر تا جز از کردگار"
  },
  {
    "poem_id": 88039,
    "vorder": 110,
    "position": 1,
    "text": "که دانست کآید یکی شهریار"
  },
  {
    "poem_id": 88039,
    "vorder": 111,
    "position": 0,
    "text": "نگه کن بدین کار گردنده دهر"
  },
  {
    "poem_id": 88039,
    "vorder": 112,
    "position": 1,
    "text": "مر آن را که از خویشتن کرد بهر"
  },
  {
    "poem_id": 88039,
    "vorder": 113,
    "position": 0,
    "text": "برآرد گل تازه از خار خشک"
  },
  {
    "poem_id": 88039,
    "vorder": 114,
    "position": 1,
    "text": "شود خاک با بخت بیدار مشک"
  },
  {
    "poem_id": 88039,
    "vorder": 115,
    "position": 0,
    "text": "شگفتی‌تر آنک از پی آز مرد"
  },
  {
    "poem_id": 88039,
    "vorder": 116,
    "position": 1,
    "text": "همیشه دل خویش دارد به درد"
  },
  {
    "poem_id": 88039,
    "vorder": 117,
    "position": 0,
    "text": "میان نیا و نبیره دو شاه"
  },
  {
    "poem_id": 88039,
    "vorder": 118,
    "position": 1,
    "text": "ندانم چرا باید این کینه‌گاه"
  },
  {
    "poem_id": 88039,
    "vorder": 119,
    "position": 0,
    "text": "دو شاه و دو کشور چنین جنگجوی"
  },
  {
    "poem_id": 88039,
    "vorder": 120,
    "position": 1,
    "text": "دو لشکر به روی اندر آورده روی"
  },
  {
    "poem_id": 88039,
    "vorder": 121,
    "position": 0,
    "text": "چه گویی سرانجام این کارزار"
  },
  {
    "poem_id": 88039,
    "vorder": 122,
    "position": 1,
    "text": "که را برکشد گردش روزگار"
  },
  {
    "poem_id": 88039,
    "vorder": 123,
    "position": 0,
    "text": "پس آنگه به یزدان بنالید زار"
  },
  {
    "poem_id": 88039,
    "vorder": 124,
    "position": 1,
    "text": "که ای روشن دادگر کردگار"
  },
  {
    "poem_id": 88039,
    "vorder": 125,
    "position": 0,
    "text": "گر افراسیاب اندر این کینه‌گاه"
  },
  {
    "poem_id": 88039,
    "vorder": 126,
    "position": 1,
    "text": "ابا نامداران توران سپاه"
  },
  {
    "poem_id": 88039,
    "vorder": 127,
    "position": 0,
    "text": "بدین رزمگه کشته خواهد شدن"
  },
  {
    "poem_id": 88039,
    "vorder": 128,
    "position": 1,
    "text": "سربخت ما گشته خواهد شدن"
  },
  {
    "poem_id": 88039,
    "vorder": 129,
    "position": 0,
    "text": "چو کیخسرو آید ز ایران به کین"
  },
  {
    "poem_id": 88039,
    "vorder": 130,
    "position": 1,
    "text": "بدو بازگردد سراسر زمین"
  },
  {
    "poem_id": 88039,
    "vorder": 131,
    "position": 0,
    "text": "روا باشد ار خسته در جوشنم"
  },
  {
    "poem_id": 88039,
    "vorder": 132,
    "position": 1,
    "text": "برآرد روان کردگار از تنم"
  },
  {
    "poem_id": 88039,
    "vorder": 133,
    "position": 0,
    "text": "مبیناد هرگز جهانبین من"
  },
  {
    "poem_id": 88039,
    "vorder": 134,
    "position": 1,
    "text": "گرفته کسی راه و آیین من"
  },
  {
    "poem_id": 88039,
    "vorder": 135,
    "position": 0,
    "text": "که را گردش روز با کام نیست"
  },
  {
    "poem_id": 88039,
    "vorder": 136,
    "position": 1,
    "text": "ورا زندگانی و مرگش یکیست"
  },
  {
    "poem_id": 88039,
    "vorder": 137,
    "position": 0,
    "text": "وز آن پس ز ایران سپه کرنای"
  },
  {
    "poem_id": 88039,
    "vorder": 138,
    "position": 1,
    "text": "برآمد دم بوق و هندی درای"
  }
]