[
  {
    "poem_id": 88045,
    "vorder": 1,
    "position": 0,
    "text": "سه دیگر سیامک ز توران سپاه"
  },
  {
    "poem_id": 88045,
    "vorder": 2,
    "position": 1,
    "text": "بشد با گرازه به آوردگاه"
  },
  {
    "poem_id": 88045,
    "vorder": 3,
    "position": 0,
    "text": "برفتند و نیزه گرفته به دست"
  },
  {
    "poem_id": 88045,
    "vorder": 4,
    "position": 1,
    "text": "خروشان به کردار پیلان مست"
  },
  {
    "poem_id": 88045,
    "vorder": 5,
    "position": 0,
    "text": "پر از جنگ و پر خشم کینه‌وران"
  },
  {
    "poem_id": 88045,
    "vorder": 6,
    "position": 1,
    "text": "گرفتند زان پس عمود گران"
  },
  {
    "poem_id": 88045,
    "vorder": 7,
    "position": 0,
    "text": "چو شیران جنگی برآشوفتند"
  },
  {
    "poem_id": 88045,
    "vorder": 8,
    "position": 1,
    "text": "همی بر سر یکدگر کوفتند"
  },
  {
    "poem_id": 88045,
    "vorder": 9,
    "position": 0,
    "text": "زبانشان شد از تشنگی لخت لخت"
  },
  {
    "poem_id": 88045,
    "vorder": 10,
    "position": 1,
    "text": "به تنگی فراز آمد آن کار سخت"
  },
  {
    "poem_id": 88045,
    "vorder": 11,
    "position": 0,
    "text": "پیاده شدند و برآویختند"
  },
  {
    "poem_id": 88045,
    "vorder": 12,
    "position": 1,
    "text": "همی گرد کینه برانگیختند"
  },
  {
    "poem_id": 88045,
    "vorder": 13,
    "position": 0,
    "text": "گرازه بزد دست بر سان شیر"
  },
  {
    "poem_id": 88045,
    "vorder": 14,
    "position": 1,
    "text": "مر او را چو باد اندر آورد زیر"
  },
  {
    "poem_id": 88045,
    "vorder": 15,
    "position": 0,
    "text": "چنان سخت زد بر زمین کاستخوانش"
  },
  {
    "poem_id": 88045,
    "vorder": 16,
    "position": 1,
    "text": "شکست و برآمد ز تن نیز جانش"
  },
  {
    "poem_id": 88045,
    "vorder": 17,
    "position": 0,
    "text": "گرازه هم آنگه ببستش به اسب"
  },
  {
    "poem_id": 88045,
    "vorder": 18,
    "position": 1,
    "text": "نشست از بر زین چو آذرگشسب"
  },
  {
    "poem_id": 88045,
    "vorder": 19,
    "position": 0,
    "text": "گرفت آنگه اسب سیامک به دست"
  },
  {
    "poem_id": 88045,
    "vorder": 20,
    "position": 1,
    "text": "به بالا برآمد بکردار مست"
  },
  {
    "poem_id": 88045,
    "vorder": 21,
    "position": 0,
    "text": "درفش خجسته به دست اندرون"
  },
  {
    "poem_id": 88045,
    "vorder": 22,
    "position": 1,
    "text": "گرازان و شادان و دشمن نگون"
  },
  {
    "poem_id": 88045,
    "vorder": 23,
    "position": 0,
    "text": "خروشان و جوشان و نعره زنان"
  },
  {
    "poem_id": 88045,
    "vorder": 24,
    "position": 1,
    "text": "ابر پهلوان آفرین برکنان"
  }
]