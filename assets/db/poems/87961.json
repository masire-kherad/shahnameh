[
  {
    "poem_id": 87961,
    "vorder": 1,
    "position": 0,
    "text": "چو بهرام برگشت با طوس گفت"
  },
  {
    "poem_id": 87961,
    "vorder": 2,
    "position": 1,
    "text": "که با جان پاکت خرد باد جفت"
  },
  {
    "poem_id": 87961,
    "vorder": 3,
    "position": 0,
    "text": "بدان کان فرودست فرزند شاه"
  },
  {
    "poem_id": 87961,
    "vorder": 4,
    "position": 1,
    "text": "سیاوش که شد کشته بر بی گناه"
  },
  {
    "poem_id": 87961,
    "vorder": 5,
    "position": 0,
    "text": "نمود آن نشانی که اندر نژاد"
  },
  {
    "poem_id": 87961,
    "vorder": 6,
    "position": 1,
    "text": "ز کاوس دارند و ز کیقباد"
  },
  {
    "poem_id": 87961,
    "vorder": 7,
    "position": 0,
    "text": "ترا شاه کیخسرو اندرز کرد"
  },
  {
    "poem_id": 87961,
    "vorder": 8,
    "position": 1,
    "text": "که گرد فرود سیاوش مگرد"
  },
  {
    "poem_id": 87961,
    "vorder": 9,
    "position": 0,
    "text": "چنین داد پاسخ ستمکاره طوس"
  },
  {
    "poem_id": 87961,
    "vorder": 10,
    "position": 1,
    "text": "که من دارم این لشکر و بوق و کوس"
  },
  {
    "poem_id": 87961,
    "vorder": 11,
    "position": 0,
    "text": "ترا گفتم او را بنزد من آر"
  },
  {
    "poem_id": 87961,
    "vorder": 12,
    "position": 1,
    "text": "سخن هیچگونه مکن خواستار"
  },
  {
    "poem_id": 87961,
    "vorder": 13,
    "position": 0,
    "text": "گر او شهریارست پس من کیم"
  },
  {
    "poem_id": 87961,
    "vorder": 14,
    "position": 1,
    "text": "برین کوه گوید ز بهر چیم"
  },
  {
    "poem_id": 87961,
    "vorder": 15,
    "position": 0,
    "text": "یکی ترک‌زاده چو زاغ سیاه"
  },
  {
    "poem_id": 87961,
    "vorder": 16,
    "position": 1,
    "text": "برین گونه بگرفت راه سپاه"
  },
  {
    "poem_id": 87961,
    "vorder": 17,
    "position": 0,
    "text": "نبینم ز خودکامه گودرزیان"
  },
  {
    "poem_id": 87961,
    "vorder": 18,
    "position": 1,
    "text": "مگر آنک دارد سپه را زیان"
  },
  {
    "poem_id": 87961,
    "vorder": 19,
    "position": 0,
    "text": "بترسیدی از بی‌هنر یک سوار"
  },
  {
    "poem_id": 87961,
    "vorder": 20,
    "position": 1,
    "text": "نه شیر ژیان بود بر کوهسار"
  },
  {
    "poem_id": 87961,
    "vorder": 21,
    "position": 0,
    "text": "سپه دید و برگشت سوی فریب"
  },
  {
    "poem_id": 87961,
    "vorder": 22,
    "position": 1,
    "text": "بخیره سپردی فراز و نشیب"
  }
]