[
  {
    "poem_id": 1434,
    "vorder": 1,
    "position": 0,
    "text": "برون رفت پس پهلو نیمروز"
  },
  {
    "poem_id": 1434,
    "vorder": 2,
    "position": 1,
    "text": "ز پیش پدر گرد گیتی فروز"
  },
  {
    "poem_id": 1434,
    "vorder": 3,
    "position": 0,
    "text": "دو روزه بیک روزه بگذاشتی"
  },
  {
    "poem_id": 1434,
    "vorder": 4,
    "position": 1,
    "text": "شب تیره را روز پنداشتی"
  },
  {
    "poem_id": 1434,
    "vorder": 5,
    "position": 0,
    "text": "بدین سان همی رخش ببرید راه"
  },
  {
    "poem_id": 1434,
    "vorder": 6,
    "position": 1,
    "text": "بتابنده روز و شبان سیاه"
  },
  {
    "poem_id": 1434,
    "vorder": 7,
    "position": 0,
    "text": "تنش چون خورش جست و آمد به شور"
  },
  {
    "poem_id": 1434,
    "vorder": 8,
    "position": 1,
    "text": "یکی دشت پیش آمدش پر ز گور"
  },
  {
    "poem_id": 1434,
    "vorder": 9,
    "position": 0,
    "text": "یکی رخش را تیز بنمود ران"
  },
  {
    "poem_id": 1434,
    "vorder": 10,
    "position": 1,
    "text": "تگ گور شد از تگ او گران"
  },
  {
    "poem_id": 1434,
    "vorder": 11,
    "position": 0,
    "text": "کمند و پی رخش و رستم سوار"
  },
  {
    "poem_id": 1434,
    "vorder": 12,
    "position": 1,
    "text": "نیابد ازو دام و دد زینهار"
  },
  {
    "poem_id": 1434,
    "vorder": 13,
    "position": 0,
    "text": "کمند کیانی بینداخت شیر"
  },
  {
    "poem_id": 1434,
    "vorder": 14,
    "position": 1,
    "text": "به حلقه درآورد گور دلیر"
  },
  {
    "poem_id": 1434,
    "vorder": 15,
    "position": 0,
    "text": "کشید و بیفگند گور آن زمان"
  },
  {
    "poem_id": 1434,
    "vorder": 16,
    "position": 1,
    "text": "بیامد برش چون هژبر دمان"
  },
  {
    "poem_id": 1434,
    "vorder": 17,
    "position": 0,
    "text": "ز پیکان تیرآتشی برفروخت"
  },
  {
    "poem_id": 1434,
    "vorder": 18,
    "position": 1,
    "text": "بدو خاک و خاشاک و هیزم بسوخت"
  },
  {
    "poem_id": 1434,
    "vorder": 19,
    "position": 0,
    "text": "بران آتش تیز بریانش کرد"
  },
  {
    "poem_id": 1434,
    "vorder": 20,
    "position": 1,
    "text": "ازان پس که بی‌پوست و بی‌جانش کرد"
  },
  {
    "poem_id": 1434,
    "vorder": 21,
    "position": 0,
    "text": "بخورد و بینداخت زو استخوان"
  },
  {
    "poem_id": 1434,
    "vorder": 22,
    "position": 1,
    "text": "همین بود دیگ و همین بود خوان"
  },
  {
    "poem_id": 1434,
    "vorder": 23,
    "position": 0,
    "text": "لگام از سر رخش برداشت خوار"
  },
  {
    "poem_id": 1434,
    "vorder": 24,
    "position": 1,
    "text": "چرا دید و بگذاشت در مرغزار"
  },
  {
    "poem_id": 1434,
    "vorder": 25,
    "position": 0,
    "text": "بر نیستان بستر خواب ساخت"
  },
  {
    "poem_id": 1434,
    "vorder": 26,
    "position": 1,
    "text": "در بیم را جای ایمن شناخت"
  },
  {
    "poem_id": 1434,
    "vorder": 27,
    "position": 0,
    "text": "دران نیستان بیشهٔ شیر بود"
  },
  {
    "poem_id": 1434,
    "vorder": 28,
    "position": 1,
    "text": "که پیلی نیارست ازو نی درود"
  },
  {
    "poem_id": 1434,
    "vorder": 29,
    "position": 0,
    "text": "چو یک پاس بگذشت درنده شیر"
  },
  {
    "poem_id": 1434,
    "vorder": 30,
    "position": 1,
    "text": "به سوی کنام خود آمد دلیر"
  },
  {
    "poem_id": 1434,
    "vorder": 31,
    "position": 0,
    "text": "بر نی یکی پیل را خفته دید"
  },
  {
    "poem_id": 1434,
    "vorder": 32,
    "position": 1,
    "text": "بر او یکی اسپ آشفته دید"
  },
  {
    "poem_id": 1434,
    "vorder": 33,
    "position": 0,
    "text": "نخست اسپ را گفت باید شکست"
  },
  {
    "poem_id": 1434,
    "vorder": 34,
    "position": 1,
    "text": "چو خواهم سوارم خود آید به دست"
  },
  {
    "poem_id": 1434,
    "vorder": 35,
    "position": 0,
    "text": "سوی رخش رخشان برآمد دمان"
  },
  {
    "poem_id": 1434,
    "vorder": 36,
    "position": 1,
    "text": "چو آتش بجوشید رخش آن زمان"
  },
  {
    "poem_id": 1434,
    "vorder": 37,
    "position": 0,
    "text": "دو دست اندر آورد و زد بر سرش"
  },
  {
    "poem_id": 1434,
    "vorder": 38,
    "position": 1,
    "text": "همان تیز دندان به پشت اندرش"
  },
  {
    "poem_id": 1434,
    "vorder": 39,
    "position": 0,
    "text": "همی زد بران خاک تا پاره کرد"
  },
  {
    "poem_id": 1434,
    "vorder": 40,
    "position": 1,
    "text": "ددی را بران چاره بیچاره کرد"
  },
  {
    "poem_id": 1434,
    "vorder": 41,
    "position": 0,
    "text": "چو بیدار شد رستم تیزچنگ"
  },
  {
    "poem_id": 1434,
    "vorder": 42,
    "position": 1,
    "text": "جهان دید بر شیر تاریک و تنگ"
  },
  {
    "poem_id": 1434,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت با رخش کای هوشیار"
  },
  {
    "poem_id": 1434,
    "vorder": 44,
    "position": 1,
    "text": "که گفتت که با شیر کن کارزار"
  },
  {
    "poem_id": 1434,
    "vorder": 45,
    "position": 0,
    "text": "اگر تو شدی کشته در چنگ اوی"
  },
  {
    "poem_id": 1434,
    "vorder": 46,
    "position": 1,
    "text": "من این گرز و این مغفر جنگجوی"
  },
  {
    "poem_id": 1434,
    "vorder": 47,
    "position": 0,
    "text": "چگونه کشیدی به مازندران"
  },
  {
    "poem_id": 1434,
    "vorder": 48,
    "position": 1,
    "text": "کمند کیانی و گرز گران"
  },
  {
    "poem_id": 1434,
    "vorder": 49,
    "position": 0,
    "text": "چرا نامدی نزد من با خروش"
  },
  {
    "poem_id": 1434,
    "vorder": 50,
    "position": 1,
    "text": "خروش توام چون رسیدی به گوش"
  },
  {
    "poem_id": 1434,
    "vorder": 51,
    "position": 0,
    "text": "سرم گر ز خواب خوش آگه شدی"
  },
  {
    "poem_id": 1434,
    "vorder": 52,
    "position": 1,
    "text": "ترا جنگ با شیر کوته شدی"
  },
  {
    "poem_id": 1434,
    "vorder": 53,
    "position": 0,
    "text": "چو خورشید برزد سر از تیره کوه"
  },
  {
    "poem_id": 1434,
    "vorder": 54,
    "position": 1,
    "text": "تهمتن ز خواب خوش آمد ستوه"
  },
  {
    "poem_id": 1434,
    "vorder": 55,
    "position": 0,
    "text": "تن رخش بسترد و زین برنهاد"
  },
  {
    "poem_id": 1434,
    "vorder": 56,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد یاد"
  }
]