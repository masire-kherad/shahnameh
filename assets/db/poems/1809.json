[
  {
    "poem_id": 1809,
    "vorder": 1,
    "position": 0,
    "text": "سواری ز قنوج تازان برفت"
  },
  {
    "poem_id": 1809,
    "vorder": 2,
    "position": 1,
    "text": "به آگاهی رفتن شاه تفت"
  },
  {
    "poem_id": 1809,
    "vorder": 3,
    "position": 0,
    "text": "که برزوی و ایرانیان رفته‌اند"
  },
  {
    "poem_id": 1809,
    "vorder": 4,
    "position": 1,
    "text": "همان دختر شاه را برده‌اند"
  },
  {
    "poem_id": 1809,
    "vorder": 5,
    "position": 0,
    "text": "شنید این سخن شنگل از نیک‌خواه"
  },
  {
    "poem_id": 1809,
    "vorder": 6,
    "position": 1,
    "text": "چو آتش بیامد ز نخچیرگاه"
  },
  {
    "poem_id": 1809,
    "vorder": 7,
    "position": 0,
    "text": "همه لشکر خویش را برنشاند"
  },
  {
    "poem_id": 1809,
    "vorder": 8,
    "position": 1,
    "text": "پس شاه بهرام لشکر براند"
  },
  {
    "poem_id": 1809,
    "vorder": 9,
    "position": 0,
    "text": "بدین‌گونه تا پیش دریا رسید"
  },
  {
    "poem_id": 1809,
    "vorder": 10,
    "position": 1,
    "text": "سپینود و بهرام یل را بدید"
  },
  {
    "poem_id": 1809,
    "vorder": 11,
    "position": 0,
    "text": "غمی گشت و بگذاشت دریا به خشم"
  },
  {
    "poem_id": 1809,
    "vorder": 12,
    "position": 1,
    "text": "ازان سوی دریا چو بر کرد چشم"
  },
  {
    "poem_id": 1809,
    "vorder": 13,
    "position": 0,
    "text": "بدیدش سپینود و بهرام را"
  },
  {
    "poem_id": 1809,
    "vorder": 14,
    "position": 1,
    "text": "مران مرد بی‌باک خودکام را"
  },
  {
    "poem_id": 1809,
    "vorder": 15,
    "position": 0,
    "text": "به دختر چنین گفت کای بدنژاد"
  },
  {
    "poem_id": 1809,
    "vorder": 16,
    "position": 1,
    "text": "که چون تو ز تخم بزرگان مباد"
  },
  {
    "poem_id": 1809,
    "vorder": 17,
    "position": 0,
    "text": "تو با این فریبنده مرد دلیر"
  },
  {
    "poem_id": 1809,
    "vorder": 18,
    "position": 1,
    "text": "ز دریا گذشتی به کردار شیر"
  },
  {
    "poem_id": 1809,
    "vorder": 19,
    "position": 0,
    "text": "که بی‌آگهی من به ایران شوی"
  },
  {
    "poem_id": 1809,
    "vorder": 20,
    "position": 1,
    "text": "ز مینوی خرم به ویران شوی"
  },
  {
    "poem_id": 1809,
    "vorder": 21,
    "position": 0,
    "text": "ببینی کنون زخم ژوپین من"
  },
  {
    "poem_id": 1809,
    "vorder": 22,
    "position": 1,
    "text": "چو ناگاه رفتی ز بالین من"
  },
  {
    "poem_id": 1809,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت بهرام کای بدنشان"
  },
  {
    "poem_id": 1809,
    "vorder": 24,
    "position": 1,
    "text": "چرا تاختی باره چون بیهشان"
  },
  {
    "poem_id": 1809,
    "vorder": 25,
    "position": 0,
    "text": "مرا آزمودی گه کارزار"
  },
  {
    "poem_id": 1809,
    "vorder": 26,
    "position": 1,
    "text": "چنانم که با باده و میگسار"
  },
  {
    "poem_id": 1809,
    "vorder": 27,
    "position": 0,
    "text": "تو دانی که از هندوان صدهزار"
  },
  {
    "poem_id": 1809,
    "vorder": 28,
    "position": 1,
    "text": "بود پیش من کمتر از یک سوار"
  },
  {
    "poem_id": 1809,
    "vorder": 29,
    "position": 0,
    "text": "چو من باشم و نامور یار سی"
  },
  {
    "poem_id": 1809,
    "vorder": 30,
    "position": 1,
    "text": "زره‌دار با خنجر پارسی"
  },
  {
    "poem_id": 1809,
    "vorder": 31,
    "position": 0,
    "text": "پر از خون کنم کشور هندوان"
  },
  {
    "poem_id": 1809,
    "vorder": 32,
    "position": 1,
    "text": "نمانم که باشد کسی با روان"
  },
  {
    "poem_id": 1809,
    "vorder": 33,
    "position": 0,
    "text": "بدانست شنگل که او راست گفت"
  },
  {
    "poem_id": 1809,
    "vorder": 34,
    "position": 1,
    "text": "دلیری و گردی نشاید نهفت"
  },
  {
    "poem_id": 1809,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت شنگل که فرزند را"
  },
  {
    "poem_id": 1809,
    "vorder": 36,
    "position": 1,
    "text": "بیفگندم و خویش و پیوند را"
  },
  {
    "poem_id": 1809,
    "vorder": 37,
    "position": 0,
    "text": "ز دیده گرامی‌ترت داشتم"
  },
  {
    "poem_id": 1809,
    "vorder": 38,
    "position": 1,
    "text": "به سر بر همی افسرت داشتم"
  },
  {
    "poem_id": 1809,
    "vorder": 39,
    "position": 0,
    "text": "ترا دادم آن را که خود خواستی"
  },
  {
    "poem_id": 1809,
    "vorder": 40,
    "position": 1,
    "text": "مرا راستی بد ترا کاستی"
  },
  {
    "poem_id": 1809,
    "vorder": 41,
    "position": 0,
    "text": "جفا برگزیدی به جای وفا"
  },
  {
    "poem_id": 1809,
    "vorder": 42,
    "position": 1,
    "text": "وفا را جفا کی پسندی سزا"
  },
  {
    "poem_id": 1809,
    "vorder": 43,
    "position": 0,
    "text": "چه گویم تراکانک فرزند بود"
  },
  {
    "poem_id": 1809,
    "vorder": 44,
    "position": 1,
    "text": "به اندیشهٔ من خردمند بود"
  },
  {
    "poem_id": 1809,
    "vorder": 45,
    "position": 0,
    "text": "کنون چون دلاور سواری شدست"
  },
  {
    "poem_id": 1809,
    "vorder": 46,
    "position": 1,
    "text": "گمانم که او شهریاری شدست"
  },
  {
    "poem_id": 1809,
    "vorder": 47,
    "position": 0,
    "text": "دل پارسی باوفا کی بود"
  },
  {
    "poem_id": 1809,
    "vorder": 48,
    "position": 1,
    "text": "چو آری کند رای او نی بود"
  },
  {
    "poem_id": 1809,
    "vorder": 49,
    "position": 0,
    "text": "چنان بچهٔ شیر بودی درست"
  },
  {
    "poem_id": 1809,
    "vorder": 50,
    "position": 1,
    "text": "که از خون دل دایگانش بشست"
  },
  {
    "poem_id": 1809,
    "vorder": 51,
    "position": 0,
    "text": "چو دندان برآورد و شد تیز چنگ"
  },
  {
    "poem_id": 1809,
    "vorder": 52,
    "position": 1,
    "text": "به پروردگار آمدش رای جنگ"
  },
  {
    "poem_id": 1809,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت بهرام چون دانیم"
  },
  {
    "poem_id": 1809,
    "vorder": 54,
    "position": 1,
    "text": "بداندیش و بدساز چون خوانیم"
  },
  {
    "poem_id": 1809,
    "vorder": 55,
    "position": 0,
    "text": "به رفتن نباشد مرا سرزنش"
  },
  {
    "poem_id": 1809,
    "vorder": 56,
    "position": 1,
    "text": "نخواهی مرا بددل و بدکنش"
  },
  {
    "poem_id": 1809,
    "vorder": 57,
    "position": 0,
    "text": "شهنشاه ایران و توران منم"
  },
  {
    "poem_id": 1809,
    "vorder": 58,
    "position": 1,
    "text": "سپهدار و پشت دلیران منم"
  },
  {
    "poem_id": 1809,
    "vorder": 59,
    "position": 0,
    "text": "ازین پس سزای تو نیکی کنم"
  },
  {
    "poem_id": 1809,
    "vorder": 60,
    "position": 1,
    "text": "سر بدسگالت ز تن برکنم"
  },
  {
    "poem_id": 1809,
    "vorder": 61,
    "position": 0,
    "text": "به ایران به جای پدر دارمت"
  },
  {
    "poem_id": 1809,
    "vorder": 62,
    "position": 1,
    "text": "هم از باژ کشور نیازارمت"
  },
  {
    "poem_id": 1809,
    "vorder": 63,
    "position": 0,
    "text": "همان دخترت شمع خاور بود"
  },
  {
    "poem_id": 1809,
    "vorder": 64,
    "position": 1,
    "text": "سر بانوان را چو افسر بود"
  },
  {
    "poem_id": 1809,
    "vorder": 65,
    "position": 0,
    "text": "ز گفتار او ماند شنگل شگفت"
  },
  {
    "poem_id": 1809,
    "vorder": 66,
    "position": 1,
    "text": "ز سر شارهٔ هندوی برگرفت"
  },
  {
    "poem_id": 1809,
    "vorder": 67,
    "position": 0,
    "text": "بزد اسپ وز پیش چندان سپاه"
  },
  {
    "poem_id": 1809,
    "vorder": 68,
    "position": 1,
    "text": "بیامد به پوزش به نزدیک شاه"
  },
  {
    "poem_id": 1809,
    "vorder": 69,
    "position": 0,
    "text": "شهنشاه را شاد در بر گرفت"
  },
  {
    "poem_id": 1809,
    "vorder": 70,
    "position": 1,
    "text": "وزان گفتها پوزش اندر گرفت"
  },
  {
    "poem_id": 1809,
    "vorder": 71,
    "position": 0,
    "text": "به دیدار بهرام شد شادکام"
  },
  {
    "poem_id": 1809,
    "vorder": 72,
    "position": 1,
    "text": "بیاراست خوان و بیاورد جام"
  },
  {
    "poem_id": 1809,
    "vorder": 73,
    "position": 0,
    "text": "برآورد بهرام راز از نهفت"
  },
  {
    "poem_id": 1809,
    "vorder": 74,
    "position": 1,
    "text": "سخنهای ایرانیان باز گفت"
  },
  {
    "poem_id": 1809,
    "vorder": 75,
    "position": 0,
    "text": "که کردار چون بود و اندیشه چون"
  },
  {
    "poem_id": 1809,
    "vorder": 76,
    "position": 1,
    "text": "که بودم بدین داستان رهنمون"
  },
  {
    "poem_id": 1809,
    "vorder": 77,
    "position": 0,
    "text": "می چند خوردند و برخاستند"
  },
  {
    "poem_id": 1809,
    "vorder": 78,
    "position": 1,
    "text": "زبان را به پوزش بیاراستند"
  },
  {
    "poem_id": 1809,
    "vorder": 79,
    "position": 0,
    "text": "دو شاه دلارای یزدان‌پرست"
  },
  {
    "poem_id": 1809,
    "vorder": 80,
    "position": 1,
    "text": "وفا را بسودند بر دست دست"
  },
  {
    "poem_id": 1809,
    "vorder": 81,
    "position": 0,
    "text": "کزین پس دل از راستی نشکنیم"
  },
  {
    "poem_id": 1809,
    "vorder": 82,
    "position": 1,
    "text": "همی بیخ کژی ز بن برکنیم"
  },
  {
    "poem_id": 1809,
    "vorder": 83,
    "position": 0,
    "text": "وفادار باشیم تا جاودان"
  },
  {
    "poem_id": 1809,
    "vorder": 84,
    "position": 1,
    "text": "سخن بشنویم از لب بخردان"
  },
  {
    "poem_id": 1809,
    "vorder": 85,
    "position": 0,
    "text": "سپینود را نیز پدرود کرد"
  },
  {
    "poem_id": 1809,
    "vorder": 86,
    "position": 1,
    "text": "بر خویش تار و برش پود کرد"
  },
  {
    "poem_id": 1809,
    "vorder": 87,
    "position": 0,
    "text": "سبک پشت بر یکدگر گاشتند"
  },
  {
    "poem_id": 1809,
    "vorder": 88,
    "position": 1,
    "text": "دل کینه بر جای بگذاشتند"
  },
  {
    "poem_id": 1809,
    "vorder": 89,
    "position": 0,
    "text": "یکی سوی خشک و یکی سوی آب"
  },
  {
    "poem_id": 1809,
    "vorder": 90,
    "position": 1,
    "text": "برفتند شادان‌دل و پرشتاب"
  }
]