[
  {
    "poem_id": 1708,
    "vorder": 1,
    "position": 0,
    "text": "به بغداد بنشست بر تخت عاج"
  },
  {
    "poem_id": 1708,
    "vorder": 2,
    "position": 1,
    "text": "به سر برنهاد آن دلفروز تاج"
  },
  {
    "poem_id": 1708,
    "vorder": 3,
    "position": 0,
    "text": "کمر بسته و گرز شاهان به دست"
  },
  {
    "poem_id": 1708,
    "vorder": 4,
    "position": 1,
    "text": "بیاراسته جایگاه نشست"
  },
  {
    "poem_id": 1708,
    "vorder": 5,
    "position": 0,
    "text": "شهنشاه خواندند زان پس ورا"
  },
  {
    "poem_id": 1708,
    "vorder": 6,
    "position": 1,
    "text": "ز گشتاسپ نشناختی کس ورا"
  },
  {
    "poem_id": 1708,
    "vorder": 7,
    "position": 0,
    "text": "چو تاج بزرگی به سر برنهاد"
  },
  {
    "poem_id": 1708,
    "vorder": 8,
    "position": 1,
    "text": "چنین کرد بر تخت پیروزه یاد"
  },
  {
    "poem_id": 1708,
    "vorder": 9,
    "position": 0,
    "text": "که اندر جهان داد گنج منست"
  },
  {
    "poem_id": 1708,
    "vorder": 10,
    "position": 1,
    "text": "جهان زنده از بخت و رنج منست"
  },
  {
    "poem_id": 1708,
    "vorder": 11,
    "position": 0,
    "text": "کس این گنج نتواند از من ستد"
  },
  {
    "poem_id": 1708,
    "vorder": 12,
    "position": 1,
    "text": "بد آید به مردم ز کردار بد"
  },
  {
    "poem_id": 1708,
    "vorder": 13,
    "position": 0,
    "text": "چو خشنود باشد جهاندار پاک"
  },
  {
    "poem_id": 1708,
    "vorder": 14,
    "position": 1,
    "text": "ندارد دریغ از من این تیره خاک"
  },
  {
    "poem_id": 1708,
    "vorder": 15,
    "position": 0,
    "text": "جهان سر به سر در پناه منست"
  },
  {
    "poem_id": 1708,
    "vorder": 16,
    "position": 1,
    "text": "پسندیدن داد راه منست"
  },
  {
    "poem_id": 1708,
    "vorder": 17,
    "position": 0,
    "text": "نباید که از کارداران من"
  },
  {
    "poem_id": 1708,
    "vorder": 18,
    "position": 1,
    "text": "ز سرهنگ و جنگی سواران من"
  },
  {
    "poem_id": 1708,
    "vorder": 19,
    "position": 0,
    "text": "بخسپد کسی دل پر از آرزوی"
  },
  {
    "poem_id": 1708,
    "vorder": 20,
    "position": 1,
    "text": "گر از بنده گر مردم نیک‌خوی"
  },
  {
    "poem_id": 1708,
    "vorder": 21,
    "position": 0,
    "text": "گشادست بر هرکس این بارگاه"
  },
  {
    "poem_id": 1708,
    "vorder": 22,
    "position": 1,
    "text": "ز بدخواه وز مردم نیک‌خواه"
  },
  {
    "poem_id": 1708,
    "vorder": 23,
    "position": 0,
    "text": "همه انجمن خواندند آفرین"
  },
  {
    "poem_id": 1708,
    "vorder": 24,
    "position": 1,
    "text": "که آباد بادا به دادت زمین"
  },
  {
    "poem_id": 1708,
    "vorder": 25,
    "position": 0,
    "text": "فرستاد بر هر سوی لشکری"
  },
  {
    "poem_id": 1708,
    "vorder": 26,
    "position": 1,
    "text": "که هرجا که باشد ز دشمن سری"
  },
  {
    "poem_id": 1708,
    "vorder": 27,
    "position": 0,
    "text": "سر کینه‌ورشان به راه آورید"
  },
  {
    "poem_id": 1708,
    "vorder": 28,
    "position": 1,
    "text": "گر آیین شمشیر و گاه آورید"
  }
]