[
  {
    "poem_id": 1735,
    "vorder": 1,
    "position": 0,
    "text": "به شبگیر شاپور یل برنشست"
  },
  {
    "poem_id": 1735,
    "vorder": 2,
    "position": 1,
    "text": "همی رفت جوشان کمانی به دست"
  },
  {
    "poem_id": 1735,
    "vorder": 3,
    "position": 0,
    "text": "سیه جوشن خسروی در برش"
  },
  {
    "poem_id": 1735,
    "vorder": 4,
    "position": 1,
    "text": "درفشان درفش سیه بر سرش"
  },
  {
    "poem_id": 1735,
    "vorder": 5,
    "position": 0,
    "text": "ز دیوار دژ مالکه بنگرید"
  },
  {
    "poem_id": 1735,
    "vorder": 6,
    "position": 1,
    "text": "درفش و سر نامداران بدید"
  },
  {
    "poem_id": 1735,
    "vorder": 7,
    "position": 0,
    "text": "چو گل رنگ رخسار و چون مشک موی"
  },
  {
    "poem_id": 1735,
    "vorder": 8,
    "position": 1,
    "text": "به رنگ طبرخون گل مشک بوی"
  },
  {
    "poem_id": 1735,
    "vorder": 9,
    "position": 0,
    "text": "بشد خواب و آرام زان خوب چهر"
  },
  {
    "poem_id": 1735,
    "vorder": 10,
    "position": 1,
    "text": "بر دایه شد با دلی پر ز مهر"
  },
  {
    "poem_id": 1735,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت کین شاه خورشیدفش"
  },
  {
    "poem_id": 1735,
    "vorder": 12,
    "position": 1,
    "text": "که ایدر بیامد چنین کینه‌کش"
  },
  {
    "poem_id": 1735,
    "vorder": 13,
    "position": 0,
    "text": "بزرگی او چون نهان منست"
  },
  {
    "poem_id": 1735,
    "vorder": 14,
    "position": 1,
    "text": "جهان خوانمش کو جهان منست"
  },
  {
    "poem_id": 1735,
    "vorder": 15,
    "position": 0,
    "text": "پیامی ز من نزد شاپور بر"
  },
  {
    "poem_id": 1735,
    "vorder": 16,
    "position": 1,
    "text": "به رزم آمدست او ز من سور بر"
  },
  {
    "poem_id": 1735,
    "vorder": 17,
    "position": 0,
    "text": "بگویش که با تو ز یک گوهرم"
  },
  {
    "poem_id": 1735,
    "vorder": 18,
    "position": 1,
    "text": "هم از تخم نرسی کنداورم"
  },
  {
    "poem_id": 1735,
    "vorder": 19,
    "position": 0,
    "text": "همان نیز با کین نه هم گوشه‌ام"
  },
  {
    "poem_id": 1735,
    "vorder": 20,
    "position": 1,
    "text": "که خویش توام دختر نوشه‌ام"
  },
  {
    "poem_id": 1735,
    "vorder": 21,
    "position": 0,
    "text": "مرا گر بخواهی حصار آن تست"
  },
  {
    "poem_id": 1735,
    "vorder": 22,
    "position": 1,
    "text": "چو ایوان بیابی نگار آن تست"
  },
  {
    "poem_id": 1735,
    "vorder": 23,
    "position": 0,
    "text": "برین کار با دایه پیمان کنی"
  },
  {
    "poem_id": 1735,
    "vorder": 24,
    "position": 1,
    "text": "زبان در بزرگی گروگان کنی"
  },
  {
    "poem_id": 1735,
    "vorder": 25,
    "position": 0,
    "text": "بدو دایه گفت آنچ فرمان دهی"
  },
  {
    "poem_id": 1735,
    "vorder": 26,
    "position": 1,
    "text": "بگویم بیارمت زو آگهی"
  },
  {
    "poem_id": 1735,
    "vorder": 27,
    "position": 0,
    "text": "چو شب در زمین پادشاهی گرفت"
  },
  {
    "poem_id": 1735,
    "vorder": 28,
    "position": 1,
    "text": "ز دریا به دریا سپاهی گرفت"
  },
  {
    "poem_id": 1735,
    "vorder": 29,
    "position": 0,
    "text": "زمین تیره‌گون کوه چون نیل شد"
  },
  {
    "poem_id": 1735,
    "vorder": 30,
    "position": 1,
    "text": "ستاره به کردار قندیل شد"
  },
  {
    "poem_id": 1735,
    "vorder": 31,
    "position": 0,
    "text": "تو گویی که شمعست سیصدهزار"
  },
  {
    "poem_id": 1735,
    "vorder": 32,
    "position": 1,
    "text": "بیاویخته ز آسمان حصار"
  },
  {
    "poem_id": 1735,
    "vorder": 33,
    "position": 0,
    "text": "بشد دایه لرزان پر از ترس و بیم"
  },
  {
    "poem_id": 1735,
    "vorder": 34,
    "position": 1,
    "text": "ز طایر همی شد دلش بدو نیم"
  },
  {
    "poem_id": 1735,
    "vorder": 35,
    "position": 0,
    "text": "چو آمد به نزدیک پرده‌سرای"
  },
  {
    "poem_id": 1735,
    "vorder": 36,
    "position": 1,
    "text": "خرامید نزدیک آن پاک‌رای"
  },
  {
    "poem_id": 1735,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت اگر نزد شاهم بری"
  },
  {
    "poem_id": 1735,
    "vorder": 38,
    "position": 1,
    "text": "بیابی ز من تاج و انگشتری"
  },
  {
    "poem_id": 1735,
    "vorder": 39,
    "position": 0,
    "text": "هشیوار سالار بارش ببرد"
  },
  {
    "poem_id": 1735,
    "vorder": 40,
    "position": 1,
    "text": "ز دهلیز پرده بر شاه گرد"
  },
  {
    "poem_id": 1735,
    "vorder": 41,
    "position": 0,
    "text": "بیامد زمین را به مژگان برفت"
  },
  {
    "poem_id": 1735,
    "vorder": 42,
    "position": 1,
    "text": "سخن هرچ بشنید با شاه گفت"
  },
  {
    "poem_id": 1735,
    "vorder": 43,
    "position": 0,
    "text": "ز گفتار او شاد شد شهریار"
  },
  {
    "poem_id": 1735,
    "vorder": 44,
    "position": 1,
    "text": "بخندید و دینار دادش هزار"
  },
  {
    "poem_id": 1735,
    "vorder": 45,
    "position": 0,
    "text": "دو یاره یکی طوق و انگشتری"
  },
  {
    "poem_id": 1735,
    "vorder": 46,
    "position": 1,
    "text": "ز دیبای چینی و از بربری"
  },
  {
    "poem_id": 1735,
    "vorder": 47,
    "position": 0,
    "text": "چنین داد پاسخ که با ماه روی"
  },
  {
    "poem_id": 1735,
    "vorder": 48,
    "position": 1,
    "text": "به خوبی سخنها فراوان بگوی"
  },
  {
    "poem_id": 1735,
    "vorder": 49,
    "position": 0,
    "text": "بگویش که گفت او به خورشید و ماه"
  },
  {
    "poem_id": 1735,
    "vorder": 50,
    "position": 1,
    "text": "به زنار و زردشت و فرخ کلاه"
  },
  {
    "poem_id": 1735,
    "vorder": 51,
    "position": 0,
    "text": "که هر چیز کز من بخواهی همی"
  },
  {
    "poem_id": 1735,
    "vorder": 52,
    "position": 1,
    "text": "گر از پادشاهی بکاهی همی"
  },
  {
    "poem_id": 1735,
    "vorder": 53,
    "position": 0,
    "text": "ز من هیچ بد نشنود گوش تو"
  },
  {
    "poem_id": 1735,
    "vorder": 54,
    "position": 1,
    "text": "نجویم جدایی ز آغوش تو"
  },
  {
    "poem_id": 1735,
    "vorder": 55,
    "position": 0,
    "text": "خریدارم او را به تخت و کلاه"
  },
  {
    "poem_id": 1735,
    "vorder": 56,
    "position": 1,
    "text": "به فرمان یزدان و گنج و سپاه"
  },
  {
    "poem_id": 1735,
    "vorder": 57,
    "position": 0,
    "text": "چو بشنید پاسخ هم اندر زمان"
  },
  {
    "poem_id": 1735,
    "vorder": 58,
    "position": 1,
    "text": "ز پرده بیامد بر دژ دوان"
  },
  {
    "poem_id": 1735,
    "vorder": 59,
    "position": 0,
    "text": "شنیده بران سرو سیمین بگفت"
  },
  {
    "poem_id": 1735,
    "vorder": 60,
    "position": 1,
    "text": "که خورشید ناهید را گشت جفت"
  },
  {
    "poem_id": 1735,
    "vorder": 61,
    "position": 0,
    "text": "ز بالا و دیدار شاپور شاه"
  },
  {
    "poem_id": 1735,
    "vorder": 62,
    "position": 1,
    "text": "بگفت آنچ آمد به تابنده ماه"
  }
]