[
  {
    "poem_id": 1820,
    "vorder": 1,
    "position": 0,
    "text": "چو بر تخت بنشست فرخ قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 2,
    "position": 1,
    "text": "کلاه بزرگی به سر برنهاد"
  },
  {
    "poem_id": 1820,
    "vorder": 3,
    "position": 0,
    "text": "سوی طیسفون شد ز شهر صطخر"
  },
  {
    "poem_id": 1820,
    "vorder": 4,
    "position": 1,
    "text": "که آزادگان را بدو بود فخر"
  },
  {
    "poem_id": 1820,
    "vorder": 5,
    "position": 0,
    "text": "چو بر تخت پیروز بنشست گفت"
  },
  {
    "poem_id": 1820,
    "vorder": 6,
    "position": 1,
    "text": "که از من مدارید چیزی نهفت"
  },
  {
    "poem_id": 1820,
    "vorder": 7,
    "position": 0,
    "text": "شما را سوی من گشادست راه"
  },
  {
    "poem_id": 1820,
    "vorder": 8,
    "position": 1,
    "text": "به روز سپید و شبان سیاه"
  },
  {
    "poem_id": 1820,
    "vorder": 9,
    "position": 0,
    "text": "بزرگ آن کسی کو به گفتار راست"
  },
  {
    "poem_id": 1820,
    "vorder": 10,
    "position": 1,
    "text": "زبان را بیاراست و کژی نخواست"
  },
  {
    "poem_id": 1820,
    "vorder": 11,
    "position": 0,
    "text": "چو بخشایش آرد به خشم اندرون"
  },
  {
    "poem_id": 1820,
    "vorder": 12,
    "position": 1,
    "text": "سر راستان خواندش رهنمون"
  },
  {
    "poem_id": 1820,
    "vorder": 13,
    "position": 0,
    "text": "نهد تخت خشنودی اندر جهان"
  },
  {
    "poem_id": 1820,
    "vorder": 14,
    "position": 1,
    "text": "بیابد به داد آفرین مهان"
  },
  {
    "poem_id": 1820,
    "vorder": 15,
    "position": 0,
    "text": "دل خویش را دور دارد ز کین"
  },
  {
    "poem_id": 1820,
    "vorder": 16,
    "position": 1,
    "text": "مهان و کهانش کنند آفرین"
  },
  {
    "poem_id": 1820,
    "vorder": 17,
    "position": 0,
    "text": "هر آن گه که شد پادشا کژ گوی"
  },
  {
    "poem_id": 1820,
    "vorder": 18,
    "position": 1,
    "text": "ز کژی شود شاه پیکارجوی"
  },
  {
    "poem_id": 1820,
    "vorder": 19,
    "position": 0,
    "text": "سخن را بباید شنیدن نخست"
  },
  {
    "poem_id": 1820,
    "vorder": 20,
    "position": 1,
    "text": "چو دانا شود پاسخ آید درست"
  },
  {
    "poem_id": 1820,
    "vorder": 21,
    "position": 0,
    "text": "چو داننده مردم بود آزوِر"
  },
  {
    "poem_id": 1820,
    "vorder": 22,
    "position": 1,
    "text": "همی دانش او نیاید به بر"
  },
  {
    "poem_id": 1820,
    "vorder": 23,
    "position": 0,
    "text": "هر آن گه که دانا بود پرشتاب"
  },
  {
    "poem_id": 1820,
    "vorder": 24,
    "position": 1,
    "text": "چه دانش مر او را چه در سر شراب"
  },
  {
    "poem_id": 1820,
    "vorder": 25,
    "position": 0,
    "text": "چنان هم که باید دل لشکری"
  },
  {
    "poem_id": 1820,
    "vorder": 26,
    "position": 1,
    "text": "همه در نکوهش کند کهتری"
  },
  {
    "poem_id": 1820,
    "vorder": 27,
    "position": 0,
    "text": "توانگر کجا سخت باشد به چیز"
  },
  {
    "poem_id": 1820,
    "vorder": 28,
    "position": 1,
    "text": "فرومایه‌تر شد ز درویش نیز"
  },
  {
    "poem_id": 1820,
    "vorder": 29,
    "position": 0,
    "text": "چو درویش نادان کند مهتری"
  },
  {
    "poem_id": 1820,
    "vorder": 30,
    "position": 1,
    "text": "به دیوانگی ماند این داوری"
  },
  {
    "poem_id": 1820,
    "vorder": 31,
    "position": 0,
    "text": "چو عیب تن خویش داند کسی"
  },
  {
    "poem_id": 1820,
    "vorder": 32,
    "position": 1,
    "text": "ز عیب کسان برنخواند بسی"
  },
  {
    "poem_id": 1820,
    "vorder": 33,
    "position": 0,
    "text": "ستون خرد بردباری بود"
  },
  {
    "poem_id": 1820,
    "vorder": 34,
    "position": 1,
    "text": "چو تندی کند تن به خواری بود"
  },
  {
    "poem_id": 1820,
    "vorder": 35,
    "position": 0,
    "text": "چو خرسند گشتی به داد خدای"
  },
  {
    "poem_id": 1820,
    "vorder": 36,
    "position": 1,
    "text": "توانگر شدی یکدل و پاکرای"
  },
  {
    "poem_id": 1820,
    "vorder": 37,
    "position": 0,
    "text": "گر آزاد داری تنت را ز رنج"
  },
  {
    "poem_id": 1820,
    "vorder": 38,
    "position": 1,
    "text": "تن مرد بی‌رنج بهتر ز گنج"
  },
  {
    "poem_id": 1820,
    "vorder": 39,
    "position": 0,
    "text": "هر آن کس که بخشش کند با کسی"
  },
  {
    "poem_id": 1820,
    "vorder": 40,
    "position": 1,
    "text": "بمیرد تنش نام ماند بسی"
  },
  {
    "poem_id": 1820,
    "vorder": 41,
    "position": 0,
    "text": "همه سر به سر دست نیکی برید"
  },
  {
    "poem_id": 1820,
    "vorder": 42,
    "position": 1,
    "text": "جهان جهان را به بد مسپرید"
  },
  {
    "poem_id": 1820,
    "vorder": 43,
    "position": 0,
    "text": "همه مهتران آفرین خواندند"
  },
  {
    "poem_id": 1820,
    "vorder": 44,
    "position": 1,
    "text": "زبرجد به تاجش برافشاندند"
  },
  {
    "poem_id": 1820,
    "vorder": 45,
    "position": 0,
    "text": "جوان بود سالش سه پنج و یکی"
  },
  {
    "poem_id": 1820,
    "vorder": 46,
    "position": 1,
    "text": "ز شاهی ورا بهره بود اندکی"
  },
  {
    "poem_id": 1820,
    "vorder": 47,
    "position": 0,
    "text": "همی‌راند کار جهان سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 48,
    "position": 1,
    "text": "قباد اندر ایران نبد کدخدای"
  },
  {
    "poem_id": 1820,
    "vorder": 49,
    "position": 0,
    "text": "همه کار او پهلوان راندی"
  },
  {
    "poem_id": 1820,
    "vorder": 50,
    "position": 1,
    "text": "کسی را بر شاه ننشاندی"
  },
  {
    "poem_id": 1820,
    "vorder": 51,
    "position": 0,
    "text": "نه موبد بد او را نه فرمان روای"
  },
  {
    "poem_id": 1820,
    "vorder": 52,
    "position": 1,
    "text": "جهان بد به دستوری سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 53,
    "position": 0,
    "text": "چنین بود تا بیست و سه ساله گشت"
  },
  {
    "poem_id": 1820,
    "vorder": 54,
    "position": 1,
    "text": "به جام اندرون باده چون لاله گشت"
  },
  {
    "poem_id": 1820,
    "vorder": 55,
    "position": 0,
    "text": "بیامد بر تاجور سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 56,
    "position": 1,
    "text": "به دستوری بازگشتن به جای"
  },
  {
    "poem_id": 1820,
    "vorder": 57,
    "position": 0,
    "text": "سپهبد خود و لشکرش ساز کرد"
  },
  {
    "poem_id": 1820,
    "vorder": 58,
    "position": 1,
    "text": "بزد کوس و آهنگ شیراز کرد"
  },
  {
    "poem_id": 1820,
    "vorder": 59,
    "position": 0,
    "text": "همی‌رفت شادان سوی شهر خویش"
  },
  {
    "poem_id": 1820,
    "vorder": 60,
    "position": 1,
    "text": "ز هر کام برداشته بهر خویش"
  },
  {
    "poem_id": 1820,
    "vorder": 61,
    "position": 0,
    "text": "همه پارس او را شده چون رهی"
  },
  {
    "poem_id": 1820,
    "vorder": 62,
    "position": 1,
    "text": "همی‌بود با تاج شاهنشهی"
  },
  {
    "poem_id": 1820,
    "vorder": 63,
    "position": 0,
    "text": "بدان بد که من شاه بنشاندم"
  },
  {
    "poem_id": 1820,
    "vorder": 64,
    "position": 1,
    "text": "به شاهی بر او آفرین خواندم"
  },
  {
    "poem_id": 1820,
    "vorder": 65,
    "position": 0,
    "text": "گر از من کسی زشت گوید بدوی"
  },
  {
    "poem_id": 1820,
    "vorder": 66,
    "position": 1,
    "text": "ورا سرد گوید براند ز روی"
  },
  {
    "poem_id": 1820,
    "vorder": 67,
    "position": 0,
    "text": "همی باژ جستی ز هر کشوری"
  },
  {
    "poem_id": 1820,
    "vorder": 68,
    "position": 1,
    "text": "ز هر نامداری و هر مهتری"
  },
  {
    "poem_id": 1820,
    "vorder": 69,
    "position": 0,
    "text": "چو آگاهی آمد به سوی قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 70,
    "position": 1,
    "text": "ز شیراز وز کار بیداد و داد"
  },
  {
    "poem_id": 1820,
    "vorder": 71,
    "position": 0,
    "text": "همی‌گفت هر کس که جز نام شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 72,
    "position": 1,
    "text": "ندارد ز ایران ز گنج و سپاه"
  },
  {
    "poem_id": 1820,
    "vorder": 73,
    "position": 0,
    "text": "نه فرمانش باشد به چیزی نه رای"
  },
  {
    "poem_id": 1820,
    "vorder": 74,
    "position": 1,
    "text": "جهان شد همه بندهٔ سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 75,
    "position": 0,
    "text": "هر آن کس که بد رازدار قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 76,
    "position": 1,
    "text": "بر او بر سخنها همی‌کرد یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 77,
    "position": 0,
    "text": "که از پادشاهی به نامی بسند"
  },
  {
    "poem_id": 1820,
    "vorder": 78,
    "position": 1,
    "text": "چرا کردی ای شهریار بلند"
  },
  {
    "poem_id": 1820,
    "vorder": 79,
    "position": 0,
    "text": "ز گنج تو آگنده‌تر گنج او"
  },
  {
    "poem_id": 1820,
    "vorder": 80,
    "position": 1,
    "text": "بباید گسست از جهان رنج او"
  },
  {
    "poem_id": 1820,
    "vorder": 81,
    "position": 0,
    "text": "همه پارس چون بندهٔ او شدند"
  },
  {
    "poem_id": 1820,
    "vorder": 82,
    "position": 1,
    "text": "بزرگان پرستندهٔ او شدند"
  },
  {
    "poem_id": 1820,
    "vorder": 83,
    "position": 0,
    "text": "ز گفتار بد شد دل کیقباد"
  },
  {
    "poem_id": 1820,
    "vorder": 84,
    "position": 1,
    "text": "ز رنجش به دل برنکرد ایچ یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 85,
    "position": 0,
    "text": "همی‌گفت گر من فرستم سپاه"
  },
  {
    "poem_id": 1820,
    "vorder": 86,
    "position": 1,
    "text": "سر او بگردد شود رزمخواه"
  },
  {
    "poem_id": 1820,
    "vorder": 87,
    "position": 0,
    "text": "چو من دشمنی کرده باشم به گنج"
  },
  {
    "poem_id": 1820,
    "vorder": 88,
    "position": 1,
    "text": "از او دید باید بسی درد و رنج"
  },
  {
    "poem_id": 1820,
    "vorder": 89,
    "position": 0,
    "text": "کند هر کسی یاد کردار اوی"
  },
  {
    "poem_id": 1820,
    "vorder": 90,
    "position": 1,
    "text": "نهانی ندانند بازار اوی"
  },
  {
    "poem_id": 1820,
    "vorder": 91,
    "position": 0,
    "text": "ندارم ز ایران یکی رزمخواه"
  },
  {
    "poem_id": 1820,
    "vorder": 92,
    "position": 1,
    "text": "کز ایدر شود پیش او با سپاه"
  },
  {
    "poem_id": 1820,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت فرزانه مندیش ز این"
  },
  {
    "poem_id": 1820,
    "vorder": 94,
    "position": 1,
    "text": "که او شهریاری شود بآفرین"
  },
  {
    "poem_id": 1820,
    "vorder": 95,
    "position": 0,
    "text": "تو را بندگانند و سالار هست"
  },
  {
    "poem_id": 1820,
    "vorder": 96,
    "position": 1,
    "text": "که سایند بر چرخ گردنده دست"
  },
  {
    "poem_id": 1820,
    "vorder": 97,
    "position": 0,
    "text": "چو شاپور رازی بیاید ز جای"
  },
  {
    "poem_id": 1820,
    "vorder": 98,
    "position": 1,
    "text": "به درد دل بدکنش سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 99,
    "position": 0,
    "text": "شنید این سخن شاه و نیرو گرفت"
  },
  {
    "poem_id": 1820,
    "vorder": 100,
    "position": 1,
    "text": "هنرها بشست از دل آهو گرفت"
  },
  {
    "poem_id": 1820,
    "vorder": 101,
    "position": 0,
    "text": "همانگه جهاندیده‌ای کیقباد"
  },
  {
    "poem_id": 1820,
    "vorder": 102,
    "position": 1,
    "text": "بفرمود تا برنشیند چو باد"
  },
  {
    "poem_id": 1820,
    "vorder": 103,
    "position": 0,
    "text": "به نزدیک شاپور رازی شود"
  },
  {
    "poem_id": 1820,
    "vorder": 104,
    "position": 1,
    "text": "بر آواز نخچیر و بازی شود"
  },
  {
    "poem_id": 1820,
    "vorder": 105,
    "position": 0,
    "text": "هم اندر زمان برنشاند ورا"
  },
  {
    "poem_id": 1820,
    "vorder": 106,
    "position": 1,
    "text": "ز ری سوی درگاه خواند ورا"
  },
  {
    "poem_id": 1820,
    "vorder": 107,
    "position": 0,
    "text": "دو اسبه فرستاده آمد به ری"
  },
  {
    "poem_id": 1820,
    "vorder": 108,
    "position": 1,
    "text": "چو باد خزانی به هنگام دی"
  },
  {
    "poem_id": 1820,
    "vorder": 109,
    "position": 0,
    "text": "چو دیدش بپرسید سالار بار"
  },
  {
    "poem_id": 1820,
    "vorder": 110,
    "position": 1,
    "text": "وز او بستد آن نامهٔ شهریار"
  },
  {
    "poem_id": 1820,
    "vorder": 111,
    "position": 0,
    "text": "بیامد به شاپور رازی سپرد"
  },
  {
    "poem_id": 1820,
    "vorder": 112,
    "position": 1,
    "text": "سوار سرافراز را پیش برد"
  },
  {
    "poem_id": 1820,
    "vorder": 113,
    "position": 0,
    "text": "بر او خواند آن نامهٔ کیقباد"
  },
  {
    "poem_id": 1820,
    "vorder": 114,
    "position": 1,
    "text": "بخندید شاپور مهرک‌نژاد"
  },
  {
    "poem_id": 1820,
    "vorder": 115,
    "position": 0,
    "text": "که جز سوفزا دشمن اندر جهان"
  },
  {
    "poem_id": 1820,
    "vorder": 116,
    "position": 1,
    "text": "ورا نیست در آشکار و نهان"
  },
  {
    "poem_id": 1820,
    "vorder": 117,
    "position": 0,
    "text": "ز هر جای فرمانبران را بخواند"
  },
  {
    "poem_id": 1820,
    "vorder": 118,
    "position": 1,
    "text": "سوی طیسفون تیز لشکر براند"
  },
  {
    "poem_id": 1820,
    "vorder": 119,
    "position": 0,
    "text": "چو آورد لشکر به نزدیک شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 120,
    "position": 1,
    "text": "هم اندر زمان برگشادند راه"
  },
  {
    "poem_id": 1820,
    "vorder": 121,
    "position": 0,
    "text": "چو دیدش جهاندار بنواختش"
  },
  {
    "poem_id": 1820,
    "vorder": 122,
    "position": 1,
    "text": "بر تخت پیروزه بنشاختش"
  },
  {
    "poem_id": 1820,
    "vorder": 123,
    "position": 0,
    "text": "بدو گفت ز این تاج بی‌بهره‌ام"
  },
  {
    "poem_id": 1820,
    "vorder": 124,
    "position": 1,
    "text": "به بی‌بهرگی در جهان شهره‌ام"
  },
  {
    "poem_id": 1820,
    "vorder": 125,
    "position": 0,
    "text": "همه سوفزا راست بهر از مهی"
  },
  {
    "poem_id": 1820,
    "vorder": 126,
    "position": 1,
    "text": "همی نام بینم ز شاهنشهی"
  },
  {
    "poem_id": 1820,
    "vorder": 127,
    "position": 0,
    "text": "از این داد و بیداد در گردنم"
  },
  {
    "poem_id": 1820,
    "vorder": 128,
    "position": 1,
    "text": "به فرجام روزی بپیچد تنم"
  },
  {
    "poem_id": 1820,
    "vorder": 129,
    "position": 0,
    "text": "به ایران برادر بدی کدخدای"
  },
  {
    "poem_id": 1820,
    "vorder": 130,
    "position": 1,
    "text": "به هستی ز بیدادگر سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 131,
    "position": 0,
    "text": "بدو گفت شاپور کای شهریار"
  },
  {
    "poem_id": 1820,
    "vorder": 132,
    "position": 1,
    "text": "دلت را بدین کار رنجه مدار"
  },
  {
    "poem_id": 1820,
    "vorder": 133,
    "position": 0,
    "text": "یکی نامه باید نوشتن درشت"
  },
  {
    "poem_id": 1820,
    "vorder": 134,
    "position": 1,
    "text": "تو را نام و فر و نژادست و پشت"
  },
  {
    "poem_id": 1820,
    "vorder": 135,
    "position": 0,
    "text": "بگویی که از تخت شاهنشاهی"
  },
  {
    "poem_id": 1820,
    "vorder": 136,
    "position": 1,
    "text": "مرا بهره رنجست و گنج تهی"
  },
  {
    "poem_id": 1820,
    "vorder": 137,
    "position": 0,
    "text": "تویی باژخواه و منم با گناه"
  },
  {
    "poem_id": 1820,
    "vorder": 138,
    "position": 1,
    "text": "نخواهم که خوانی مرا نیز شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 139,
    "position": 0,
    "text": "فرستادم اینک یکی پهلوان"
  },
  {
    "poem_id": 1820,
    "vorder": 140,
    "position": 1,
    "text": "ز کردار تو چند باشم نوان"
  },
  {
    "poem_id": 1820,
    "vorder": 141,
    "position": 0,
    "text": "چو نامه بدین‌گونه باشد بدوی"
  },
  {
    "poem_id": 1820,
    "vorder": 142,
    "position": 1,
    "text": "چو من دشمن و لشکری جنگجوی"
  },
  {
    "poem_id": 1820,
    "vorder": 143,
    "position": 0,
    "text": "نمانم که بر هم زند نیز چشم"
  },
  {
    "poem_id": 1820,
    "vorder": 144,
    "position": 1,
    "text": "نگویم سخن پیش او جز به خشم"
  },
  {
    "poem_id": 1820,
    "vorder": 145,
    "position": 0,
    "text": "نویسندهٔ نامه را خواندند"
  },
  {
    "poem_id": 1820,
    "vorder": 146,
    "position": 1,
    "text": "به نزدیک شاپور بنشاندند"
  },
  {
    "poem_id": 1820,
    "vorder": 147,
    "position": 0,
    "text": "بگفت آن سخنها که با شاه گفت"
  },
  {
    "poem_id": 1820,
    "vorder": 148,
    "position": 1,
    "text": "شد آن کلک بیجاده با قار جفت"
  },
  {
    "poem_id": 1820,
    "vorder": 149,
    "position": 0,
    "text": "چو بر نامه بر مهر بنهاد شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 150,
    "position": 1,
    "text": "بیاورد شاپور لشکر به راه"
  },
  {
    "poem_id": 1820,
    "vorder": 151,
    "position": 0,
    "text": "گزین کرد پس هرکه بد نامدار"
  },
  {
    "poem_id": 1820,
    "vorder": 152,
    "position": 1,
    "text": "پراگنده از لشکر شهریار"
  },
  {
    "poem_id": 1820,
    "vorder": 153,
    "position": 0,
    "text": "خود و نامداران پرخاشجوی"
  },
  {
    "poem_id": 1820,
    "vorder": 154,
    "position": 1,
    "text": "سوی شهر شیراز بنهاد روی"
  },
  {
    "poem_id": 1820,
    "vorder": 155,
    "position": 0,
    "text": "چو آگاه شد زآن سخن سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 156,
    "position": 1,
    "text": "همانگه بیاورد لشکر ز جای"
  },
  {
    "poem_id": 1820,
    "vorder": 157,
    "position": 0,
    "text": "پذیره شدش با سپاهی گران"
  },
  {
    "poem_id": 1820,
    "vorder": 158,
    "position": 1,
    "text": "گزیده سواران و جوشنوران"
  },
  {
    "poem_id": 1820,
    "vorder": 159,
    "position": 0,
    "text": "رسیدند پس یک به دیگر فراز"
  },
  {
    "poem_id": 1820,
    "vorder": 160,
    "position": 1,
    "text": "فرود آمدند آن دو گردن‌فراز"
  },
  {
    "poem_id": 1820,
    "vorder": 161,
    "position": 0,
    "text": "چو بنشست شاپور با سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 162,
    "position": 1,
    "text": "فراوان زدند از بد و نیک رای"
  },
  {
    "poem_id": 1820,
    "vorder": 163,
    "position": 0,
    "text": "بدو داد پس نامهٔ شهریار"
  },
  {
    "poem_id": 1820,
    "vorder": 164,
    "position": 1,
    "text": "سخن رفت هرگونه دشوار و خوار"
  },
  {
    "poem_id": 1820,
    "vorder": 165,
    "position": 0,
    "text": "چو برخواند آن نامه را پهلوان"
  },
  {
    "poem_id": 1820,
    "vorder": 166,
    "position": 1,
    "text": "بپژمرد و شد کند و تیره‌روان"
  },
  {
    "poem_id": 1820,
    "vorder": 167,
    "position": 0,
    "text": "چو آن نامه برخواند شاپور گفت"
  },
  {
    "poem_id": 1820,
    "vorder": 168,
    "position": 1,
    "text": "که اکنون سخن را نباید نهفت"
  },
  {
    "poem_id": 1820,
    "vorder": 169,
    "position": 0,
    "text": "تو را بند فرمود شاه جهان"
  },
  {
    "poem_id": 1820,
    "vorder": 170,
    "position": 1,
    "text": "فراوان بنالید پیش مهان"
  },
  {
    "poem_id": 1820,
    "vorder": 171,
    "position": 0,
    "text": "بر آن سان که برخوانده‌ای نامه را"
  },
  {
    "poem_id": 1820,
    "vorder": 172,
    "position": 1,
    "text": "تو دانی شهنشاه خودکامه را"
  },
  {
    "poem_id": 1820,
    "vorder": 173,
    "position": 0,
    "text": "چنین داد پاسخ بدو پهلوان"
  },
  {
    "poem_id": 1820,
    "vorder": 174,
    "position": 1,
    "text": "که داند مرا شهریار جهان"
  },
  {
    "poem_id": 1820,
    "vorder": 175,
    "position": 0,
    "text": "بدان رنج و سختی که بردم ز شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 176,
    "position": 1,
    "text": "برفتم ز زابلستان با سپاه"
  },
  {
    "poem_id": 1820,
    "vorder": 177,
    "position": 0,
    "text": "به مردی رهانیدم او را ز بند"
  },
  {
    "poem_id": 1820,
    "vorder": 178,
    "position": 1,
    "text": "نماندم که آید به رویش گزند"
  },
  {
    "poem_id": 1820,
    "vorder": 179,
    "position": 0,
    "text": "مرا داستان بود نزدیک شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 180,
    "position": 1,
    "text": "همان نزد گردان ایران سپاه"
  },
  {
    "poem_id": 1820,
    "vorder": 181,
    "position": 0,
    "text": "گر ایدون که بندست پاداش من"
  },
  {
    "poem_id": 1820,
    "vorder": 182,
    "position": 1,
    "text": "تو را چنگ دادن به پرخاش من"
  },
  {
    "poem_id": 1820,
    "vorder": 183,
    "position": 0,
    "text": "نخواهم زمان از تو پایم ببند"
  },
  {
    "poem_id": 1820,
    "vorder": 184,
    "position": 1,
    "text": "بدارد مرا بند او سودمند"
  },
  {
    "poem_id": 1820,
    "vorder": 185,
    "position": 0,
    "text": "ز یزدان وز لشکرم نیست شرم"
  },
  {
    "poem_id": 1820,
    "vorder": 186,
    "position": 1,
    "text": "که من چند پالوده‌ام خون گرم"
  },
  {
    "poem_id": 1820,
    "vorder": 187,
    "position": 0,
    "text": "بدانگه کجا شاه در بند بود"
  },
  {
    "poem_id": 1820,
    "vorder": 188,
    "position": 1,
    "text": "به یزدان مرا سخت سوگند بود"
  },
  {
    "poem_id": 1820,
    "vorder": 189,
    "position": 0,
    "text": "که دستم نبیند مگر دست تیغ"
  },
  {
    "poem_id": 1820,
    "vorder": 190,
    "position": 1,
    "text": "به جنگ آفتاب اندر آرم به میغ"
  },
  {
    "poem_id": 1820,
    "vorder": 191,
    "position": 0,
    "text": "مگر سر دهم گر سر خوشنواز"
  },
  {
    "poem_id": 1820,
    "vorder": 192,
    "position": 1,
    "text": "به مردی ز تخت اندر آرم به گاز"
  },
  {
    "poem_id": 1820,
    "vorder": 193,
    "position": 0,
    "text": "کنونم که فرمود بندم سزاست"
  },
  {
    "poem_id": 1820,
    "vorder": 194,
    "position": 1,
    "text": "سخنهای ناسودمندم سزاست"
  },
  {
    "poem_id": 1820,
    "vorder": 195,
    "position": 0,
    "text": "ز فرمان او هیچ گونه مگرد"
  },
  {
    "poem_id": 1820,
    "vorder": 196,
    "position": 1,
    "text": "چو پیرایه دان بند بر پای مرد"
  },
  {
    "poem_id": 1820,
    "vorder": 197,
    "position": 0,
    "text": "چو بنشست شاپور پایش ببست"
  },
  {
    "poem_id": 1820,
    "vorder": 198,
    "position": 1,
    "text": "بزد نای رویین و خود برنشست"
  },
  {
    "poem_id": 1820,
    "vorder": 199,
    "position": 0,
    "text": "بیاوردش از پارس پیش قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 200,
    "position": 1,
    "text": "قباد از گذشته نکرد ایچ یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 201,
    "position": 0,
    "text": "بفرمود کو را به زندان برند"
  },
  {
    "poem_id": 1820,
    "vorder": 202,
    "position": 1,
    "text": "به نزدیک ناهوشمندان برند"
  },
  {
    "poem_id": 1820,
    "vorder": 203,
    "position": 0,
    "text": "به شیراز فرمود تا هرچه بود"
  },
  {
    "poem_id": 1820,
    "vorder": 204,
    "position": 1,
    "text": "ز مردان و گنج و ز کشت و درود"
  },
  {
    "poem_id": 1820,
    "vorder": 205,
    "position": 0,
    "text": "بیاورد یک سر سوی طیسفون"
  },
  {
    "poem_id": 1820,
    "vorder": 206,
    "position": 1,
    "text": "سپردش به گنجور او رهنمون"
  },
  {
    "poem_id": 1820,
    "vorder": 207,
    "position": 0,
    "text": "چو یک هفته بگذشت هرگونه رای"
  },
  {
    "poem_id": 1820,
    "vorder": 208,
    "position": 1,
    "text": "همی‌راند با موبد از سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 209,
    "position": 0,
    "text": "چنین گفت پس شاه را رهنمون"
  },
  {
    "poem_id": 1820,
    "vorder": 210,
    "position": 1,
    "text": "که یارند با او همه طیسفون"
  },
  {
    "poem_id": 1820,
    "vorder": 211,
    "position": 0,
    "text": "همه لشکر و زیردستان ما"
  },
  {
    "poem_id": 1820,
    "vorder": 212,
    "position": 1,
    "text": "ز دهقان وز در پرستان ما"
  },
  {
    "poem_id": 1820,
    "vorder": 213,
    "position": 0,
    "text": "گر او اندر ایران بماند درست"
  },
  {
    "poem_id": 1820,
    "vorder": 214,
    "position": 1,
    "text": "ز شاهی بباید تو را دست شست"
  },
  {
    "poem_id": 1820,
    "vorder": 215,
    "position": 0,
    "text": "بداندیش شاه جهان کشته به"
  },
  {
    "poem_id": 1820,
    "vorder": 216,
    "position": 1,
    "text": "سر بخت بدخواه برگشته به"
  },
  {
    "poem_id": 1820,
    "vorder": 217,
    "position": 0,
    "text": "چو بشنید مهتر ز موبد سخن"
  },
  {
    "poem_id": 1820,
    "vorder": 218,
    "position": 1,
    "text": "بنو تاخت و بیزار شد از کهن"
  },
  {
    "poem_id": 1820,
    "vorder": 219,
    "position": 0,
    "text": "بفرمود پس تاش بیجان کنند"
  },
  {
    "poem_id": 1820,
    "vorder": 220,
    "position": 1,
    "text": "بر او بر دل و دیده پیچان کنند"
  },
  {
    "poem_id": 1820,
    "vorder": 221,
    "position": 0,
    "text": "بکردند پس پهلوان را تباه"
  },
  {
    "poem_id": 1820,
    "vorder": 222,
    "position": 1,
    "text": "شد آن گرد فرزانه و نیک‌خواه"
  },
  {
    "poem_id": 1820,
    "vorder": 223,
    "position": 0,
    "text": "چو آگاهی آمد به ایرانیان"
  },
  {
    "poem_id": 1820,
    "vorder": 224,
    "position": 1,
    "text": "که آن پیلتن را سرآمد زمان"
  },
  {
    "poem_id": 1820,
    "vorder": 225,
    "position": 0,
    "text": "خروشی برآمد ز ایران به درد"
  },
  {
    "poem_id": 1820,
    "vorder": 226,
    "position": 1,
    "text": "زن و مرد و کودک همی مویه کرد"
  },
  {
    "poem_id": 1820,
    "vorder": 227,
    "position": 0,
    "text": "برآشفت ایران و برخاست گرد"
  },
  {
    "poem_id": 1820,
    "vorder": 228,
    "position": 1,
    "text": "همی هر کسی کرد ساز نبرد"
  },
  {
    "poem_id": 1820,
    "vorder": 229,
    "position": 0,
    "text": "همی‌گفت هرکس که تخت قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 230,
    "position": 1,
    "text": "اگر سوفزا شد به ایران مباد"
  },
  {
    "poem_id": 1820,
    "vorder": 231,
    "position": 0,
    "text": "سپاهی و شهری همه شد یکی"
  },
  {
    "poem_id": 1820,
    "vorder": 232,
    "position": 1,
    "text": "نبردند نام قباد اندکی"
  },
  {
    "poem_id": 1820,
    "vorder": 233,
    "position": 0,
    "text": "برفتند یکسر به ایوان شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 234,
    "position": 1,
    "text": "ز بدگوی پردرد و فریادخواه"
  },
  {
    "poem_id": 1820,
    "vorder": 235,
    "position": 0,
    "text": "کسی را که بر شاه بدگوی بود"
  },
  {
    "poem_id": 1820,
    "vorder": 236,
    "position": 1,
    "text": "بداندیش او و بلاجوی بود"
  },
  {
    "poem_id": 1820,
    "vorder": 237,
    "position": 0,
    "text": "بکشتند و بردند ز ایوان کشان"
  },
  {
    "poem_id": 1820,
    "vorder": 238,
    "position": 1,
    "text": "ز جاماسب جستند چندی نشان"
  },
  {
    "poem_id": 1820,
    "vorder": 239,
    "position": 0,
    "text": "که کهتر برادر بد و سرفراز"
  },
  {
    "poem_id": 1820,
    "vorder": 240,
    "position": 1,
    "text": "قبادش همی‌پروریدی به ناز"
  },
  {
    "poem_id": 1820,
    "vorder": 241,
    "position": 0,
    "text": "ورا برگزیدند و بنشاندند"
  },
  {
    "poem_id": 1820,
    "vorder": 242,
    "position": 1,
    "text": "به شاهی بر او آفرین خواندند"
  },
  {
    "poem_id": 1820,
    "vorder": 243,
    "position": 0,
    "text": "به آهن ببستند پای قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 244,
    "position": 1,
    "text": "ز فر و نژادش نکردند یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 245,
    "position": 0,
    "text": "چنینست رسم سرای کهن"
  },
  {
    "poem_id": 1820,
    "vorder": 246,
    "position": 1,
    "text": "سرش هیچ پیدا نبینی ز بن"
  },
  {
    "poem_id": 1820,
    "vorder": 247,
    "position": 0,
    "text": "یکی پور بد سوفزا را گزین"
  },
  {
    "poem_id": 1820,
    "vorder": 248,
    "position": 1,
    "text": "خردمند و پاکیزه و بآفرین"
  },
  {
    "poem_id": 1820,
    "vorder": 249,
    "position": 0,
    "text": "جوانی بی‌آزار و زرمهر نام"
  },
  {
    "poem_id": 1820,
    "vorder": 250,
    "position": 1,
    "text": "که از مهر او بد پدر شادکام"
  },
  {
    "poem_id": 1820,
    "vorder": 251,
    "position": 0,
    "text": "سپردند بسته بدو شاه را"
  },
  {
    "poem_id": 1820,
    "vorder": 252,
    "position": 1,
    "text": "بدان گونه بد رای بدخواه را"
  },
  {
    "poem_id": 1820,
    "vorder": 253,
    "position": 0,
    "text": "که آن مهربان کینهٔ سوفزای"
  },
  {
    "poem_id": 1820,
    "vorder": 254,
    "position": 1,
    "text": "بخواهد به درد از جهان کدخدای"
  },
  {
    "poem_id": 1820,
    "vorder": 255,
    "position": 0,
    "text": "بی‌آزار زرمهر یزدان‌پرست"
  },
  {
    "poem_id": 1820,
    "vorder": 256,
    "position": 1,
    "text": "نسودی به بد با جهاندار دست"
  },
  {
    "poem_id": 1820,
    "vorder": 257,
    "position": 0,
    "text": "پرستش همی‌کرد پیش قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 258,
    "position": 1,
    "text": "وز آن بد نکرد ایچ بر شاه یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 259,
    "position": 0,
    "text": "جهاندار ز او ماند اندر شگفت"
  },
  {
    "poem_id": 1820,
    "vorder": 260,
    "position": 1,
    "text": "ز کردار او مردمی برگرفت"
  },
  {
    "poem_id": 1820,
    "vorder": 261,
    "position": 0,
    "text": "همی‌کرد پوزش که بدخواه من"
  },
  {
    "poem_id": 1820,
    "vorder": 262,
    "position": 1,
    "text": "پرآشوب کرد اختر و ماه من"
  },
  {
    "poem_id": 1820,
    "vorder": 263,
    "position": 0,
    "text": "گر ایدون که یابم رهایی ز بند"
  },
  {
    "poem_id": 1820,
    "vorder": 264,
    "position": 1,
    "text": "تو را باشد از هر بدی سودمند"
  },
  {
    "poem_id": 1820,
    "vorder": 265,
    "position": 0,
    "text": "ز دل پاک بردارم آزار تو"
  },
  {
    "poem_id": 1820,
    "vorder": 266,
    "position": 1,
    "text": "کنم چشم روشن به دیدار تو"
  },
  {
    "poem_id": 1820,
    "vorder": 267,
    "position": 0,
    "text": "بدو گفت زرمهر کای شهریار"
  },
  {
    "poem_id": 1820,
    "vorder": 268,
    "position": 1,
    "text": "زبان را بدین باز رنجه مدار"
  },
  {
    "poem_id": 1820,
    "vorder": 269,
    "position": 0,
    "text": "پدر گر نکرد آنچه بایست کرد"
  },
  {
    "poem_id": 1820,
    "vorder": 270,
    "position": 1,
    "text": "ز مرگش پسر گرم و تیمار خورد"
  },
  {
    "poem_id": 1820,
    "vorder": 271,
    "position": 0,
    "text": "تو را من به سان یکی بنده‌ام"
  },
  {
    "poem_id": 1820,
    "vorder": 272,
    "position": 1,
    "text": "به پیش تو اندر پرستنده‌ام"
  },
  {
    "poem_id": 1820,
    "vorder": 273,
    "position": 0,
    "text": "چو گویی به سوگند پیمان کنم"
  },
  {
    "poem_id": 1820,
    "vorder": 274,
    "position": 1,
    "text": "که هرگز وفای تو را نشکنم"
  },
  {
    "poem_id": 1820,
    "vorder": 275,
    "position": 0,
    "text": "از او ایمنی یافت جان قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 276,
    "position": 1,
    "text": "ز گفتار آن پر خرد گشت شاد"
  },
  {
    "poem_id": 1820,
    "vorder": 277,
    "position": 0,
    "text": "وز آن پس بدو راز بگشاد و گفت"
  },
  {
    "poem_id": 1820,
    "vorder": 278,
    "position": 1,
    "text": "که اندیشه از تو تخواهم نهفت"
  },
  {
    "poem_id": 1820,
    "vorder": 279,
    "position": 0,
    "text": "گشادست بر پنج تن راز من"
  },
  {
    "poem_id": 1820,
    "vorder": 280,
    "position": 1,
    "text": "جز این نشنود یک تن آواز من"
  },
  {
    "poem_id": 1820,
    "vorder": 281,
    "position": 0,
    "text": "همین تاج و تخت از تو دارم سپاس"
  },
  {
    "poem_id": 1820,
    "vorder": 282,
    "position": 1,
    "text": "بوم جاودانه تو را حق‌شناس"
  },
  {
    "poem_id": 1820,
    "vorder": 283,
    "position": 0,
    "text": "چو بشنید زر مهر پاکیزه‌رای"
  },
  {
    "poem_id": 1820,
    "vorder": 284,
    "position": 1,
    "text": "سبک بند را برگشادش ز پای"
  },
  {
    "poem_id": 1820,
    "vorder": 285,
    "position": 0,
    "text": "فرستاد و آن پنج تن را بخواند"
  },
  {
    "poem_id": 1820,
    "vorder": 286,
    "position": 1,
    "text": "همه رازها پیش ایشان براند"
  },
  {
    "poem_id": 1820,
    "vorder": 287,
    "position": 0,
    "text": "شب تیره از شهر بیرون شدند"
  },
  {
    "poem_id": 1820,
    "vorder": 288,
    "position": 1,
    "text": "ز دیدار دشمن به هامون شدند"
  },
  {
    "poem_id": 1820,
    "vorder": 289,
    "position": 0,
    "text": "سوی شاه هیتال کردند روی"
  },
  {
    "poem_id": 1820,
    "vorder": 290,
    "position": 1,
    "text": "ز اندیشگان خسته و راه جوی"
  },
  {
    "poem_id": 1820,
    "vorder": 291,
    "position": 0,
    "text": "بر این گونه سرگشته آن هفت مرد"
  },
  {
    "poem_id": 1820,
    "vorder": 292,
    "position": 1,
    "text": "به اهواز رفتند تازان چو گرد"
  },
  {
    "poem_id": 1820,
    "vorder": 293,
    "position": 0,
    "text": "رسیدند پویان به پرمایه ده"
  },
  {
    "poem_id": 1820,
    "vorder": 294,
    "position": 1,
    "text": "به ده در یکی نامبردار مه"
  },
  {
    "poem_id": 1820,
    "vorder": 295,
    "position": 0,
    "text": "بدان خان دهقان فرود آمدند"
  },
  {
    "poem_id": 1820,
    "vorder": 296,
    "position": 1,
    "text": "ببودند و یک هفته دم برزدند"
  },
  {
    "poem_id": 1820,
    "vorder": 297,
    "position": 0,
    "text": "یکی دختری داشت دهقان چو ماه"
  },
  {
    "poem_id": 1820,
    "vorder": 298,
    "position": 1,
    "text": "ز مشک سیه بر سرش بر کلاه"
  },
  {
    "poem_id": 1820,
    "vorder": 299,
    "position": 0,
    "text": "جهانجوی چون روی دختر بدید"
  },
  {
    "poem_id": 1820,
    "vorder": 300,
    "position": 1,
    "text": "ز مغز جوان شد خرد ناپدید"
  },
  {
    "poem_id": 1820,
    "vorder": 301,
    "position": 0,
    "text": "همانگه بیامد به زرمهر گفت"
  },
  {
    "poem_id": 1820,
    "vorder": 302,
    "position": 1,
    "text": "که با تو سخن دارم اندر نهفت"
  },
  {
    "poem_id": 1820,
    "vorder": 303,
    "position": 0,
    "text": "برو راز من پیش دهقان بگوی"
  },
  {
    "poem_id": 1820,
    "vorder": 304,
    "position": 1,
    "text": "مگر جفت من گردد این خوبروی"
  },
  {
    "poem_id": 1820,
    "vorder": 305,
    "position": 0,
    "text": "بشد تیز و رازش به دهقان بگفت"
  },
  {
    "poem_id": 1820,
    "vorder": 306,
    "position": 1,
    "text": "که این دخترت را کسی نیست جفت"
  },
  {
    "poem_id": 1820,
    "vorder": 307,
    "position": 0,
    "text": "یکی پاک انبازش آمد به جای"
  },
  {
    "poem_id": 1820,
    "vorder": 308,
    "position": 1,
    "text": "که گردی بر اهواز بر کدخدای"
  },
  {
    "poem_id": 1820,
    "vorder": 309,
    "position": 0,
    "text": "گرانمایه دهقان به زرمهر گفت"
  },
  {
    "poem_id": 1820,
    "vorder": 310,
    "position": 1,
    "text": "که این دختر خوب را نیست جفت"
  },
  {
    "poem_id": 1820,
    "vorder": 311,
    "position": 0,
    "text": "اگر شاید این مرد فرمان تو راست"
  },
  {
    "poem_id": 1820,
    "vorder": 312,
    "position": 1,
    "text": "مر این را بدان ده که او را هواست"
  },
  {
    "poem_id": 1820,
    "vorder": 313,
    "position": 0,
    "text": "بیامد خردمند نزد قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 314,
    "position": 1,
    "text": "چنین گفت کاین ماه جفت تو باد"
  },
  {
    "poem_id": 1820,
    "vorder": 315,
    "position": 0,
    "text": "پسندیدی و ناگهان دیدیش"
  },
  {
    "poem_id": 1820,
    "vorder": 316,
    "position": 1,
    "text": "بدان سان که دیدی پسندیدیش"
  },
  {
    "poem_id": 1820,
    "vorder": 317,
    "position": 0,
    "text": "قباد آن پری روی را پیش خواند"
  },
  {
    "poem_id": 1820,
    "vorder": 318,
    "position": 1,
    "text": "به زانوی کنداورش برنشاند"
  },
  {
    "poem_id": 1820,
    "vorder": 319,
    "position": 0,
    "text": "ابا او یک انگشتری بود و بس"
  },
  {
    "poem_id": 1820,
    "vorder": 320,
    "position": 1,
    "text": "که ارزش به گیتی ندانست کس"
  },
  {
    "poem_id": 1820,
    "vorder": 321,
    "position": 0,
    "text": "بدو داد و گفت این نگین را بدار"
  },
  {
    "poem_id": 1820,
    "vorder": 322,
    "position": 1,
    "text": "بود روز کاین را بود خواستار"
  },
  {
    "poem_id": 1820,
    "vorder": 323,
    "position": 0,
    "text": "بدان ده یکی هفته از بهر ماه"
  },
  {
    "poem_id": 1820,
    "vorder": 324,
    "position": 1,
    "text": "همی‌بود و هشتم بیامد به راه"
  },
  {
    "poem_id": 1820,
    "vorder": 325,
    "position": 0,
    "text": "بر شاه هیتال شد کیقباد"
  },
  {
    "poem_id": 1820,
    "vorder": 326,
    "position": 1,
    "text": "گذشته سخنها بدو کرد یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 327,
    "position": 0,
    "text": "بگفت آنچه کردند ایرانیان"
  },
  {
    "poem_id": 1820,
    "vorder": 328,
    "position": 1,
    "text": "بدی را ببستند یک یک میان"
  },
  {
    "poem_id": 1820,
    "vorder": 329,
    "position": 0,
    "text": "بدو گفت شاه از بد خوشنواز"
  },
  {
    "poem_id": 1820,
    "vorder": 330,
    "position": 1,
    "text": "همانا بدین روزت آمد نیاز"
  },
  {
    "poem_id": 1820,
    "vorder": 331,
    "position": 0,
    "text": "به پیمان سپارم تو را لشکری"
  },
  {
    "poem_id": 1820,
    "vorder": 332,
    "position": 1,
    "text": "از آن هر یکی بر سران افسری"
  },
  {
    "poem_id": 1820,
    "vorder": 333,
    "position": 0,
    "text": "که گر باز یابی تو گنج و کلاه"
  },
  {
    "poem_id": 1820,
    "vorder": 334,
    "position": 1,
    "text": "چغانی بباشد تو را نیکخواه"
  },
  {
    "poem_id": 1820,
    "vorder": 335,
    "position": 0,
    "text": "مرا باشد این مرز و فرمان تو را"
  },
  {
    "poem_id": 1820,
    "vorder": 336,
    "position": 1,
    "text": "ز کرده نباشد پشیمان تو را"
  },
  {
    "poem_id": 1820,
    "vorder": 337,
    "position": 0,
    "text": "زبردست را گفت خندان قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 338,
    "position": 1,
    "text": "کزین بوم هرگز نگیریم یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 339,
    "position": 0,
    "text": "چو خواهی فرستمت بی‌مر سپاه"
  },
  {
    "poem_id": 1820,
    "vorder": 340,
    "position": 1,
    "text": "چغانی که باشد که یازد به گاه"
  },
  {
    "poem_id": 1820,
    "vorder": 341,
    "position": 0,
    "text": "چو کردند عهد آن دو گردن فراز"
  },
  {
    "poem_id": 1820,
    "vorder": 342,
    "position": 1,
    "text": "در گنج زر و درم کرد باز"
  },
  {
    "poem_id": 1820,
    "vorder": 343,
    "position": 0,
    "text": "به شاه جهاندار دادش رمه"
  },
  {
    "poem_id": 1820,
    "vorder": 344,
    "position": 1,
    "text": "سلیح سواران و لشکر همه"
  },
  {
    "poem_id": 1820,
    "vorder": 345,
    "position": 0,
    "text": "بپذرفت شمشیرزن سی‌هزار"
  },
  {
    "poem_id": 1820,
    "vorder": 346,
    "position": 1,
    "text": "همه نامداران گرد و سوار"
  },
  {
    "poem_id": 1820,
    "vorder": 347,
    "position": 0,
    "text": "ز هیتالیان سوی اهواز شد"
  },
  {
    "poem_id": 1820,
    "vorder": 348,
    "position": 1,
    "text": "سراسر جهان زو پر آواز شد"
  },
  {
    "poem_id": 1820,
    "vorder": 349,
    "position": 0,
    "text": "چو نزدیکی خان دهقان رسید"
  },
  {
    "poem_id": 1820,
    "vorder": 350,
    "position": 1,
    "text": "بسی مردم از خانه بیرون دوید"
  },
  {
    "poem_id": 1820,
    "vorder": 351,
    "position": 0,
    "text": "یکی مژده بردند نزد قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 352,
    "position": 1,
    "text": "که این پور بر شاه فرخنده باد"
  },
  {
    "poem_id": 1820,
    "vorder": 353,
    "position": 0,
    "text": "پسر زاد جفت تو در شب یکی"
  },
  {
    "poem_id": 1820,
    "vorder": 354,
    "position": 1,
    "text": "که از ماه پیدا نبود اندکی"
  },
  {
    "poem_id": 1820,
    "vorder": 355,
    "position": 0,
    "text": "چو بشنید در خانه شد شادکام"
  },
  {
    "poem_id": 1820,
    "vorder": 356,
    "position": 1,
    "text": "همانگاه کسریش کردند نام"
  },
  {
    "poem_id": 1820,
    "vorder": 357,
    "position": 0,
    "text": "ز دهقان بپرسید زان پس قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 358,
    "position": 1,
    "text": "که ای نیکبخت از که داری نژاد"
  },
  {
    "poem_id": 1820,
    "vorder": 359,
    "position": 0,
    "text": "بدو گفت کز آفریدون گرد"
  },
  {
    "poem_id": 1820,
    "vorder": 360,
    "position": 1,
    "text": "که از تخم ضحاک شاهی ببرد"
  },
  {
    "poem_id": 1820,
    "vorder": 361,
    "position": 0,
    "text": "پدرم این چنین گفت و من این چنین"
  },
  {
    "poem_id": 1820,
    "vorder": 362,
    "position": 1,
    "text": "که بر آفریدون کنیم آفرین"
  },
  {
    "poem_id": 1820,
    "vorder": 363,
    "position": 0,
    "text": "ز گفتار او شادتر شد قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 364,
    "position": 1,
    "text": "ز روزی که تاج کیی برنهاد"
  },
  {
    "poem_id": 1820,
    "vorder": 365,
    "position": 0,
    "text": "عماری بسیجید و آمد به راه"
  },
  {
    "poem_id": 1820,
    "vorder": 366,
    "position": 1,
    "text": "نشسته بدو اندرون جفت شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 367,
    "position": 0,
    "text": "بیاورد لشکر سوی طیسفون"
  },
  {
    "poem_id": 1820,
    "vorder": 368,
    "position": 1,
    "text": "دل از درد ایرانیان پر ز خون"
  },
  {
    "poem_id": 1820,
    "vorder": 369,
    "position": 0,
    "text": "به ایران همه سالخورده ردان"
  },
  {
    "poem_id": 1820,
    "vorder": 370,
    "position": 1,
    "text": "نشستند با نامور بخردان"
  },
  {
    "poem_id": 1820,
    "vorder": 371,
    "position": 0,
    "text": "که این کار گردد به ما بر دراز"
  },
  {
    "poem_id": 1820,
    "vorder": 372,
    "position": 1,
    "text": "میان دو شهزاد گردن‌فراز"
  },
  {
    "poem_id": 1820,
    "vorder": 373,
    "position": 0,
    "text": "ز روم و ز چین لشکر آید کنون"
  },
  {
    "poem_id": 1820,
    "vorder": 374,
    "position": 1,
    "text": "بریزند ز این مرز بسیار خون"
  },
  {
    "poem_id": 1820,
    "vorder": 375,
    "position": 0,
    "text": "بباید خرامید سوی قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 376,
    "position": 1,
    "text": "مگر کان سخنها نگیرد به یاد"
  },
  {
    "poem_id": 1820,
    "vorder": 377,
    "position": 0,
    "text": "بیاریم جاماسب ده ساله را"
  },
  {
    "poem_id": 1820,
    "vorder": 378,
    "position": 1,
    "text": "که با در همتا کند ژاله را"
  },
  {
    "poem_id": 1820,
    "vorder": 379,
    "position": 0,
    "text": "مگرمان ز تاراج و خون ریختن"
  },
  {
    "poem_id": 1820,
    "vorder": 380,
    "position": 1,
    "text": "به یک سو گراییم ز آویختن"
  },
  {
    "poem_id": 1820,
    "vorder": 381,
    "position": 0,
    "text": "برفتند یکسر سوی کیقباد"
  },
  {
    "poem_id": 1820,
    "vorder": 382,
    "position": 1,
    "text": "بگفتند کای شاه خسرونژاد"
  },
  {
    "poem_id": 1820,
    "vorder": 383,
    "position": 0,
    "text": "گر از تو دل مردمان خسته شد"
  },
  {
    "poem_id": 1820,
    "vorder": 384,
    "position": 1,
    "text": "به شوخی دل و دیدها شسته شد"
  },
  {
    "poem_id": 1820,
    "vorder": 385,
    "position": 0,
    "text": "کنون کامرانی بدان کت هواست"
  },
  {
    "poem_id": 1820,
    "vorder": 386,
    "position": 1,
    "text": "که شاه جهان بر جهان پادشاست"
  },
  {
    "poem_id": 1820,
    "vorder": 387,
    "position": 0,
    "text": "پیاده همه پیش او در دوان"
  },
  {
    "poem_id": 1820,
    "vorder": 388,
    "position": 1,
    "text": "برفتند پر خاک تیره‌روان"
  },
  {
    "poem_id": 1820,
    "vorder": 389,
    "position": 0,
    "text": "گناه بزرگان ببخشید شاه"
  },
  {
    "poem_id": 1820,
    "vorder": 390,
    "position": 1,
    "text": "ز خون ریختن کرد پوزش به راه"
  },
  {
    "poem_id": 1820,
    "vorder": 391,
    "position": 0,
    "text": "ببخشید جاماسب را همچنین"
  },
  {
    "poem_id": 1820,
    "vorder": 392,
    "position": 1,
    "text": "بزرگان بر او خواندند آفرین"
  },
  {
    "poem_id": 1820,
    "vorder": 393,
    "position": 0,
    "text": "بیامد به تخت کیی برنشست"
  },
  {
    "poem_id": 1820,
    "vorder": 394,
    "position": 1,
    "text": "ورا گشت جاماسب مهترپرست"
  },
  {
    "poem_id": 1820,
    "vorder": 395,
    "position": 0,
    "text": "بر این گونه تا گشت کسری بزرگ"
  },
  {
    "poem_id": 1820,
    "vorder": 396,
    "position": 1,
    "text": "یکی کودکی شد دلیر و سترگ"
  },
  {
    "poem_id": 1820,
    "vorder": 397,
    "position": 0,
    "text": "به فرهنگیان داد فرزند را"
  },
  {
    "poem_id": 1820,
    "vorder": 398,
    "position": 1,
    "text": "چنان بار شاخ برومند را"
  },
  {
    "poem_id": 1820,
    "vorder": 399,
    "position": 0,
    "text": "همه کار ایران و توران بساخت"
  },
  {
    "poem_id": 1820,
    "vorder": 400,
    "position": 1,
    "text": "بگردون کلاه مهی برفراخت"
  },
  {
    "poem_id": 1820,
    "vorder": 401,
    "position": 0,
    "text": "وز آن پس بیاورد لشکر به روم"
  },
  {
    "poem_id": 1820,
    "vorder": 402,
    "position": 1,
    "text": "شد آن بارهٔ او چو یک مهره موم"
  },
  {
    "poem_id": 1820,
    "vorder": 403,
    "position": 0,
    "text": "همه بوم و بر آتش اندر زدند"
  },
  {
    "poem_id": 1820,
    "vorder": 404,
    "position": 1,
    "text": "همه رومیان دست بر سر زدند"
  },
  {
    "poem_id": 1820,
    "vorder": 405,
    "position": 0,
    "text": "همی‌کرد زان بوم و بر خارستان"
  },
  {
    "poem_id": 1820,
    "vorder": 406,
    "position": 1,
    "text": "ازو خواست زنهار دو شارستان"
  },
  {
    "poem_id": 1820,
    "vorder": 407,
    "position": 0,
    "text": "یکی مندیا و دگر فارقین"
  },
  {
    "poem_id": 1820,
    "vorder": 408,
    "position": 1,
    "text": "بیامختشان زند و بنهاد دین"
  },
  {
    "poem_id": 1820,
    "vorder": 409,
    "position": 0,
    "text": "نهاد اندر آن مرز آتشکده"
  },
  {
    "poem_id": 1820,
    "vorder": 410,
    "position": 1,
    "text": "بزرگی به نوروز و جشن سده"
  },
  {
    "poem_id": 1820,
    "vorder": 411,
    "position": 0,
    "text": "مداین پی افگند جای کیان"
  },
  {
    "poem_id": 1820,
    "vorder": 412,
    "position": 1,
    "text": "پراگنده بسیار سود و زیان"
  },
  {
    "poem_id": 1820,
    "vorder": 413,
    "position": 0,
    "text": "از اهواز تا پارس یک شارستان"
  },
  {
    "poem_id": 1820,
    "vorder": 414,
    "position": 1,
    "text": "بکرد و برآورد بیمارستان"
  },
  {
    "poem_id": 1820,
    "vorder": 415,
    "position": 0,
    "text": "اران خواند آن شارستان را قباد"
  },
  {
    "poem_id": 1820,
    "vorder": 416,
    "position": 1,
    "text": "که تازی کنون نام حلوان نهاد"
  },
  {
    "poem_id": 1820,
    "vorder": 417,
    "position": 0,
    "text": "گشادند هر جای رودی ز آب"
  },
  {
    "poem_id": 1820,
    "vorder": 418,
    "position": 1,
    "text": "زمین شد پر از جای آرام و خواب"
  }
]