[
  {
    "poem_id": 87992,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید زد پنجه بر پشت گاو"
  },
  {
    "poem_id": 87992,
    "vorder": 2,
    "position": 1,
    "text": "ز هامون برآمد خروش چکاو"
  },
  {
    "poem_id": 87992,
    "vorder": 3,
    "position": 0,
    "text": "ز درگاه کاموس برخاست غو"
  },
  {
    "poem_id": 87992,
    "vorder": 4,
    "position": 1,
    "text": "که او بود اسپ افگن و پیش رو"
  },
  {
    "poem_id": 87992,
    "vorder": 5,
    "position": 0,
    "text": "سپاه انجمن کرد و جوشن بداد"
  },
  {
    "poem_id": 87992,
    "vorder": 6,
    "position": 1,
    "text": "دلش پر ز رزم و سرش پر ز باد"
  },
  {
    "poem_id": 87992,
    "vorder": 7,
    "position": 0,
    "text": "زره بود در زیر پیراهنش"
  },
  {
    "poem_id": 87992,
    "vorder": 8,
    "position": 1,
    "text": "کله ترگ بود و قبا جوشنش"
  },
  {
    "poem_id": 87992,
    "vorder": 9,
    "position": 0,
    "text": "بایران خروش آمد از دیده‌گاه"
  },
  {
    "poem_id": 87992,
    "vorder": 10,
    "position": 1,
    "text": "کزین روی تنگ اندر آمد سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 11,
    "position": 0,
    "text": "درفش سپهبد گو پیلتن"
  },
  {
    "poem_id": 87992,
    "vorder": 12,
    "position": 1,
    "text": "پدید آمد از دور با انجمن"
  },
  {
    "poem_id": 87992,
    "vorder": 13,
    "position": 0,
    "text": "وزین روی دیگر ز توران سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 14,
    "position": 1,
    "text": "هوا گشت برسان ابر سیاه"
  },
  {
    "poem_id": 87992,
    "vorder": 15,
    "position": 0,
    "text": "سپهبد سواری چو یک لخت کوه"
  },
  {
    "poem_id": 87992,
    "vorder": 16,
    "position": 1,
    "text": "زمین گشته از نعل اسپش ستوه"
  },
  {
    "poem_id": 87992,
    "vorder": 17,
    "position": 0,
    "text": "یکی گرز همچون سر گاومیش"
  },
  {
    "poem_id": 87992,
    "vorder": 18,
    "position": 1,
    "text": "سپاه از پس و نیزه‌دارانش پیش"
  },
  {
    "poem_id": 87992,
    "vorder": 19,
    "position": 0,
    "text": "همی جوشد از گرز آن یال و کفت"
  },
  {
    "poem_id": 87992,
    "vorder": 20,
    "position": 1,
    "text": "سزد گر بمانی ازو در شگفت"
  },
  {
    "poem_id": 87992,
    "vorder": 21,
    "position": 0,
    "text": "وزین روی ایران سپهدار طوس"
  },
  {
    "poem_id": 87992,
    "vorder": 22,
    "position": 1,
    "text": "بابر اندر آورد آوای کوس"
  },
  {
    "poem_id": 87992,
    "vorder": 23,
    "position": 0,
    "text": "خروشیدن دیده‌بان پهلوان"
  },
  {
    "poem_id": 87992,
    "vorder": 24,
    "position": 1,
    "text": "چو بشنید شد شاد و روشن‌روان"
  },
  {
    "poem_id": 87992,
    "vorder": 25,
    "position": 0,
    "text": "ز نزدیک گودرز کشواد تفت"
  },
  {
    "poem_id": 87992,
    "vorder": 26,
    "position": 1,
    "text": "سواری بنزد فریبرز رفت"
  },
  {
    "poem_id": 87992,
    "vorder": 27,
    "position": 0,
    "text": "که توران سپه سوی جنگ آمدند"
  },
  {
    "poem_id": 87992,
    "vorder": 28,
    "position": 1,
    "text": "رده برکشیدند و تنگ آمدند"
  },
  {
    "poem_id": 87992,
    "vorder": 29,
    "position": 0,
    "text": "تو آن کن که از گوهر تو سزاست"
  },
  {
    "poem_id": 87992,
    "vorder": 30,
    "position": 1,
    "text": "که تو مهتری و پدر پادشاست"
  },
  {
    "poem_id": 87992,
    "vorder": 31,
    "position": 0,
    "text": "که گرد تهمتن برآمد ز راه"
  },
  {
    "poem_id": 87992,
    "vorder": 32,
    "position": 1,
    "text": "هم اکنون بیاید بدین رزمگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 33,
    "position": 0,
    "text": "فریبرز با لشکری گرد نیو"
  },
  {
    "poem_id": 87992,
    "vorder": 34,
    "position": 1,
    "text": "بیامد بپیوست با طوس و گیو"
  },
  {
    "poem_id": 87992,
    "vorder": 35,
    "position": 0,
    "text": "بر کوه لشکر بیاراستند"
  },
  {
    "poem_id": 87992,
    "vorder": 36,
    "position": 1,
    "text": "درفش خجسته بپیراستند"
  },
  {
    "poem_id": 87992,
    "vorder": 37,
    "position": 0,
    "text": "چو با میسره راست شد میمنه"
  },
  {
    "poem_id": 87992,
    "vorder": 38,
    "position": 1,
    "text": "همان ساقه و قلب و جای بنه"
  },
  {
    "poem_id": 87992,
    "vorder": 39,
    "position": 0,
    "text": "برآمد خروشیدن کرنای"
  },
  {
    "poem_id": 87992,
    "vorder": 40,
    "position": 1,
    "text": "سپه چون سپهر اندر آمد ز جای"
  },
  {
    "poem_id": 87992,
    "vorder": 41,
    "position": 0,
    "text": "چو کاموس تنگ اندر آمد بجنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 42,
    "position": 1,
    "text": "بهامون زمانی نبودش درنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 43,
    "position": 0,
    "text": "سپه را بکردار دریای آب"
  },
  {
    "poem_id": 87992,
    "vorder": 44,
    "position": 1,
    "text": "که از کوه سیل اندر آید شتاب"
  },
  {
    "poem_id": 87992,
    "vorder": 45,
    "position": 0,
    "text": "بیاورد و پیش هماون رسید"
  },
  {
    "poem_id": 87992,
    "vorder": 46,
    "position": 1,
    "text": "هوا نیلگون شد زمین ناپدید"
  },
  {
    "poem_id": 87992,
    "vorder": 47,
    "position": 0,
    "text": "چو نزدیک شد سر سوی کوه کرد"
  },
  {
    "poem_id": 87992,
    "vorder": 48,
    "position": 1,
    "text": "پر از خنده رخ سوی انبوه کرد"
  },
  {
    "poem_id": 87992,
    "vorder": 49,
    "position": 0,
    "text": "که این لشکری گشن و کنداورست"
  },
  {
    "poem_id": 87992,
    "vorder": 50,
    "position": 1,
    "text": "نه پیران و هومان و آن لشکرست"
  },
  {
    "poem_id": 87992,
    "vorder": 51,
    "position": 0,
    "text": "که دارید ز ایرانیان جنگجوی"
  },
  {
    "poem_id": 87992,
    "vorder": 52,
    "position": 1,
    "text": "که با من بروی اندر آرند روی"
  },
  {
    "poem_id": 87992,
    "vorder": 53,
    "position": 0,
    "text": "ببینید بالا و برز مرا"
  },
  {
    "poem_id": 87992,
    "vorder": 54,
    "position": 1,
    "text": "برو بازوی و تیغ و گرز مرا"
  },
  {
    "poem_id": 87992,
    "vorder": 55,
    "position": 0,
    "text": "چو بشنید گیو این سخن بردمید"
  },
  {
    "poem_id": 87992,
    "vorder": 56,
    "position": 1,
    "text": "برآشفت و تیغ از میان برکشید"
  },
  {
    "poem_id": 87992,
    "vorder": 57,
    "position": 0,
    "text": "چو نزدیک‌تر شد بکاموس گفت"
  },
  {
    "poem_id": 87992,
    "vorder": 58,
    "position": 1,
    "text": "که این را مگر ژنده پیلست جفت"
  },
  {
    "poem_id": 87992,
    "vorder": 59,
    "position": 0,
    "text": "کمان برکشید و بزه بر نهاد"
  },
  {
    "poem_id": 87992,
    "vorder": 60,
    "position": 1,
    "text": "ز دادار نیکی دهش کرد یاد"
  },
  {
    "poem_id": 87992,
    "vorder": 61,
    "position": 0,
    "text": "بکاموس بر تیرباران گرفت"
  },
  {
    "poem_id": 87992,
    "vorder": 62,
    "position": 1,
    "text": "کمان را چو ابر بهاران گرفت"
  },
  {
    "poem_id": 87992,
    "vorder": 63,
    "position": 0,
    "text": "چو کاموس دست و گشادش بدید"
  },
  {
    "poem_id": 87992,
    "vorder": 64,
    "position": 1,
    "text": "بزیر سپر کرد سر ناپدید"
  },
  {
    "poem_id": 87992,
    "vorder": 65,
    "position": 0,
    "text": "بنیزه درآمد بکردار گرگ"
  },
  {
    "poem_id": 87992,
    "vorder": 66,
    "position": 1,
    "text": "چو شیری برافراز پیلی سترگ"
  },
  {
    "poem_id": 87992,
    "vorder": 67,
    "position": 0,
    "text": "چو آمد بنزدیک بدخواه اوی"
  },
  {
    "poem_id": 87992,
    "vorder": 68,
    "position": 1,
    "text": "یکی نیزه زد بر کمرگاه اوی"
  },
  {
    "poem_id": 87992,
    "vorder": 69,
    "position": 0,
    "text": "چو شد گیو جنبان بزین اندرون"
  },
  {
    "poem_id": 87992,
    "vorder": 70,
    "position": 1,
    "text": "ازو دور شد نیزهٔ آبگون"
  },
  {
    "poem_id": 87992,
    "vorder": 71,
    "position": 0,
    "text": "سبک تیغ را برکشید از نیام"
  },
  {
    "poem_id": 87992,
    "vorder": 72,
    "position": 1,
    "text": "خروشید و جوشید و برگفت نام"
  },
  {
    "poem_id": 87992,
    "vorder": 73,
    "position": 0,
    "text": "به پیش سوار اندر آمد دژم"
  },
  {
    "poem_id": 87992,
    "vorder": 74,
    "position": 1,
    "text": "بزد تیغ و شد نیزهٔ او قلم"
  },
  {
    "poem_id": 87992,
    "vorder": 75,
    "position": 0,
    "text": "ز قلب سپه طوس چون بنگرید"
  },
  {
    "poem_id": 87992,
    "vorder": 76,
    "position": 1,
    "text": "نگه کرد و جنگ دلیران بدید"
  },
  {
    "poem_id": 87992,
    "vorder": 77,
    "position": 0,
    "text": "بدانست کو مرد کاموس نیست"
  },
  {
    "poem_id": 87992,
    "vorder": 78,
    "position": 1,
    "text": "چنو نیزه‌ور نیز جز طوس نیست"
  },
  {
    "poem_id": 87992,
    "vorder": 79,
    "position": 0,
    "text": "خروشان بیامد ز قلب سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 80,
    "position": 1,
    "text": "بیاری بر گیو شد کینه‌خواه"
  },
  {
    "poem_id": 87992,
    "vorder": 81,
    "position": 0,
    "text": "عنان را بپیچید کاموس تنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 82,
    "position": 1,
    "text": "میان دو گرد اندر آمد بجنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 83,
    "position": 0,
    "text": "ز تگ اسپ طوس دلاور بماند"
  },
  {
    "poem_id": 87992,
    "vorder": 84,
    "position": 1,
    "text": "سپهبد برو نام یزدان بخواند"
  },
  {
    "poem_id": 87992,
    "vorder": 85,
    "position": 0,
    "text": "به نیزه پیاده به آوردگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 86,
    "position": 1,
    "text": "همی گشت با او بپیش سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 87,
    "position": 0,
    "text": "دو گرد گرانمایه و یک سوار"
  },
  {
    "poem_id": 87992,
    "vorder": 88,
    "position": 1,
    "text": "کشانی نشد سیر زان کارزار"
  },
  {
    "poem_id": 87992,
    "vorder": 89,
    "position": 0,
    "text": "برین گونه تا تیره شد جای هور"
  },
  {
    "poem_id": 87992,
    "vorder": 90,
    "position": 1,
    "text": "همی بود بر دشت هر گونه شور"
  },
  {
    "poem_id": 87992,
    "vorder": 91,
    "position": 0,
    "text": "چو شد دشت بر گونهٔ آبنوس"
  },
  {
    "poem_id": 87992,
    "vorder": 92,
    "position": 1,
    "text": "پراگنده گشتند کاموس و طوس"
  },
  {
    "poem_id": 87992,
    "vorder": 93,
    "position": 0,
    "text": "سوی خیمه رفتند هر دو گروه"
  },
  {
    "poem_id": 87992,
    "vorder": 94,
    "position": 1,
    "text": "یکی سوی دشت و دگر سوی کوه"
  },
  {
    "poem_id": 87992,
    "vorder": 95,
    "position": 0,
    "text": "چو گردون تهی شد ز خورشید و ماه"
  },
  {
    "poem_id": 87992,
    "vorder": 96,
    "position": 1,
    "text": "طلایه برون شد ز هر دو سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 97,
    "position": 0,
    "text": "ازان دیده گه دیده، بگشاد لب"
  },
  {
    "poem_id": 87992,
    "vorder": 98,
    "position": 1,
    "text": "که شد دشت پر خاک و تاریک شب"
  },
  {
    "poem_id": 87992,
    "vorder": 99,
    "position": 0,
    "text": "پر از گفتگویست هامون و راغ"
  },
  {
    "poem_id": 87992,
    "vorder": 100,
    "position": 1,
    "text": "میان یلان نیز چندین چراغ"
  },
  {
    "poem_id": 87992,
    "vorder": 101,
    "position": 0,
    "text": "همانا که آمد گو پیلتن"
  },
  {
    "poem_id": 87992,
    "vorder": 102,
    "position": 1,
    "text": "دمان و ز زابل یکی انجمن"
  },
  {
    "poem_id": 87992,
    "vorder": 103,
    "position": 0,
    "text": "چو بشنید گودرز کشواد تفت"
  },
  {
    "poem_id": 87992,
    "vorder": 104,
    "position": 1,
    "text": "شب تیره از کوه خارا برفت"
  },
  {
    "poem_id": 87992,
    "vorder": 105,
    "position": 0,
    "text": "پدید آمد آن اژدهافش درفش"
  },
  {
    "poem_id": 87992,
    "vorder": 106,
    "position": 1,
    "text": "شب تیره‌گون کرد گیتی بنفش"
  },
  {
    "poem_id": 87992,
    "vorder": 107,
    "position": 0,
    "text": "چو گودرز روی تهمتن بدید"
  },
  {
    "poem_id": 87992,
    "vorder": 108,
    "position": 1,
    "text": "شد از آب دیده رخش ناپدید"
  },
  {
    "poem_id": 87992,
    "vorder": 109,
    "position": 0,
    "text": "پیاده شد از اسپ و رستم همان"
  },
  {
    "poem_id": 87992,
    "vorder": 110,
    "position": 1,
    "text": "پیاده بیامد چو باد دمان"
  },
  {
    "poem_id": 87992,
    "vorder": 111,
    "position": 0,
    "text": "گرفتند مر یکدگر را کنار"
  },
  {
    "poem_id": 87992,
    "vorder": 112,
    "position": 1,
    "text": "ز هر دو برآمد خروشی بزار"
  },
  {
    "poem_id": 87992,
    "vorder": 113,
    "position": 0,
    "text": "ازان نامدارن گودرزیان"
  },
  {
    "poem_id": 87992,
    "vorder": 114,
    "position": 1,
    "text": "که از کینه جستن سرآمد زمان"
  },
  {
    "poem_id": 87992,
    "vorder": 115,
    "position": 0,
    "text": "بدو گفت گودرز کای پهلوان"
  },
  {
    "poem_id": 87992,
    "vorder": 116,
    "position": 1,
    "text": "هشیوار و جنگی و روشن‌روان"
  },
  {
    "poem_id": 87992,
    "vorder": 117,
    "position": 0,
    "text": "همی تاج و گاه از تو گیرد فروغ"
  },
  {
    "poem_id": 87992,
    "vorder": 118,
    "position": 1,
    "text": "سخن هرچ گویی نباشد دروغ"
  },
  {
    "poem_id": 87992,
    "vorder": 119,
    "position": 0,
    "text": "تو ایرانیان را ز مام و پدر"
  },
  {
    "poem_id": 87992,
    "vorder": 120,
    "position": 1,
    "text": "بهی هم ز گنج و ز تخت و گهر"
  },
  {
    "poem_id": 87992,
    "vorder": 121,
    "position": 0,
    "text": "چنانیم بی‌تو چو ماهی بخاک"
  },
  {
    "poem_id": 87992,
    "vorder": 122,
    "position": 1,
    "text": "بتنگ اندرون سر تن اندر هلاک"
  },
  {
    "poem_id": 87992,
    "vorder": 123,
    "position": 0,
    "text": "چو دیدم کنون خوب چهر ترا"
  },
  {
    "poem_id": 87992,
    "vorder": 124,
    "position": 1,
    "text": "همین پرسش گرم و مهر ترا"
  },
  {
    "poem_id": 87992,
    "vorder": 125,
    "position": 0,
    "text": "مرا سوگ آن ارجمندان نماند"
  },
  {
    "poem_id": 87992,
    "vorder": 126,
    "position": 1,
    "text": "ببخت تو جز روی خندان نماند"
  },
  {
    "poem_id": 87992,
    "vorder": 127,
    "position": 0,
    "text": "بدو گفت رستم که دل شاد دار"
  },
  {
    "poem_id": 87992,
    "vorder": 128,
    "position": 1,
    "text": "ز غمهای گیتی سر آزاد دار"
  },
  {
    "poem_id": 87992,
    "vorder": 129,
    "position": 0,
    "text": "که گیتی سراسر فریبست و بند"
  },
  {
    "poem_id": 87992,
    "vorder": 130,
    "position": 1,
    "text": "گهی سودمندی و گاهی گزند"
  },
  {
    "poem_id": 87992,
    "vorder": 131,
    "position": 0,
    "text": "یکی را ببستر یکی را بجنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 132,
    "position": 1,
    "text": "یکی را بنام و یکی را بننگ"
  },
  {
    "poem_id": 87992,
    "vorder": 133,
    "position": 0,
    "text": "همی رفت باید کزین چاره نیست"
  },
  {
    "poem_id": 87992,
    "vorder": 134,
    "position": 1,
    "text": "مرا نیز از مرگ پتیاره نیست"
  },
  {
    "poem_id": 87992,
    "vorder": 135,
    "position": 0,
    "text": "روان تو از درد بی‌درد باد"
  },
  {
    "poem_id": 87992,
    "vorder": 136,
    "position": 1,
    "text": "همه رفتن ما بآورد باد"
  },
  {
    "poem_id": 87992,
    "vorder": 137,
    "position": 0,
    "text": "ازان پس چو آگاه شد طوس و گیو"
  },
  {
    "poem_id": 87992,
    "vorder": 138,
    "position": 1,
    "text": "ز ایران نبرده سواران نیو"
  },
  {
    "poem_id": 87992,
    "vorder": 139,
    "position": 0,
    "text": "که رستم به کوه هماون رسید"
  },
  {
    "poem_id": 87992,
    "vorder": 140,
    "position": 1,
    "text": "مر او را جهاندیده گودرز دید"
  },
  {
    "poem_id": 87992,
    "vorder": 141,
    "position": 0,
    "text": "برفتند چون باد لشکر ز جای"
  },
  {
    "poem_id": 87992,
    "vorder": 142,
    "position": 1,
    "text": "خروش آمد و نالهٔ کرنای"
  },
  {
    "poem_id": 87992,
    "vorder": 143,
    "position": 0,
    "text": "چو آمد درفش تهمتن پدید"
  },
  {
    "poem_id": 87992,
    "vorder": 144,
    "position": 1,
    "text": "شب تیره لشکر برستم رسید"
  },
  {
    "poem_id": 87992,
    "vorder": 145,
    "position": 0,
    "text": "سپاه و سپهبد پیاده شدند"
  },
  {
    "poem_id": 87992,
    "vorder": 146,
    "position": 1,
    "text": "میان بسته و دلگشاده شدند"
  },
  {
    "poem_id": 87992,
    "vorder": 147,
    "position": 0,
    "text": "خروشی برآمد ز لشکر بدرد"
  },
  {
    "poem_id": 87992,
    "vorder": 148,
    "position": 1,
    "text": "ازان کشتگان زیر خاک نبرد"
  },
  {
    "poem_id": 87992,
    "vorder": 149,
    "position": 0,
    "text": "دل رستم از درد ایشان بخست"
  },
  {
    "poem_id": 87992,
    "vorder": 150,
    "position": 1,
    "text": "بکینه بنوی میان را ببست"
  },
  {
    "poem_id": 87992,
    "vorder": 151,
    "position": 0,
    "text": "بنالید ازان پس بدرد سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 152,
    "position": 1,
    "text": "چو آگه شد از کار آوردگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 153,
    "position": 0,
    "text": "بسی پندها داد و گفت ای سران"
  },
  {
    "poem_id": 87992,
    "vorder": 154,
    "position": 1,
    "text": "بپیش آمد امروز رزمی گران"
  },
  {
    "poem_id": 87992,
    "vorder": 155,
    "position": 0,
    "text": "چنین است آغاز و فرجام جنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 156,
    "position": 1,
    "text": "یکی تاج یابد یکی گور تنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 157,
    "position": 0,
    "text": "سراپرده زد گرد گیتی‌فروز"
  },
  {
    "poem_id": 87992,
    "vorder": 158,
    "position": 1,
    "text": "پس پشت او لشکر نیمروز"
  },
  {
    "poem_id": 87992,
    "vorder": 159,
    "position": 0,
    "text": "بکوه اندرون خیمه‌ها ساختند"
  },
  {
    "poem_id": 87992,
    "vorder": 160,
    "position": 1,
    "text": "درفش سپهبد برافراختند"
  },
  {
    "poem_id": 87992,
    "vorder": 161,
    "position": 0,
    "text": "نشست از بر تخت بر پیلتن"
  },
  {
    "poem_id": 87992,
    "vorder": 162,
    "position": 1,
    "text": "بزرگان لشکر شدند انجمن"
  },
  {
    "poem_id": 87992,
    "vorder": 163,
    "position": 0,
    "text": "ز یک دست بنشست گودرز و گیو"
  },
  {
    "poem_id": 87992,
    "vorder": 164,
    "position": 1,
    "text": "بدست دگر طوس و گردان نیو"
  },
  {
    "poem_id": 87992,
    "vorder": 165,
    "position": 0,
    "text": "فروزان یکی شمع بنهاد پیش"
  },
  {
    "poem_id": 87992,
    "vorder": 166,
    "position": 1,
    "text": "سخن رفت هر گونه بر کم و بیش"
  },
  {
    "poem_id": 87992,
    "vorder": 167,
    "position": 0,
    "text": "ز کار بزرگان و جنگ سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 168,
    "position": 1,
    "text": "ز رخشنده خورشید و گردنده ماه"
  },
  {
    "poem_id": 87992,
    "vorder": 169,
    "position": 0,
    "text": "فراوان ازان لشکر بی‌شمار"
  },
  {
    "poem_id": 87992,
    "vorder": 170,
    "position": 1,
    "text": "بگفتند با مهتر نامدار"
  },
  {
    "poem_id": 87992,
    "vorder": 171,
    "position": 0,
    "text": "ز کاموس و شنگل ز خاقان چین"
  },
  {
    "poem_id": 87992,
    "vorder": 172,
    "position": 1,
    "text": "ز منشور جنگی و مردان کین"
  },
  {
    "poem_id": 87992,
    "vorder": 173,
    "position": 0,
    "text": "ز کاموس خود جای گفتار نیست"
  },
  {
    "poem_id": 87992,
    "vorder": 174,
    "position": 1,
    "text": "که ما را بدو راه دیدار نیست"
  },
  {
    "poem_id": 87992,
    "vorder": 175,
    "position": 0,
    "text": "درختیست بارش همه گرز و تیغ"
  },
  {
    "poem_id": 87992,
    "vorder": 176,
    "position": 1,
    "text": "نترسد اگر سنگ بارد ز میغ"
  },
  {
    "poem_id": 87992,
    "vorder": 177,
    "position": 0,
    "text": "ز پیلان جنگی ندارد گریز"
  },
  {
    "poem_id": 87992,
    "vorder": 178,
    "position": 1,
    "text": "سرش پر ز کینست و دل پر ستیز"
  },
  {
    "poem_id": 87992,
    "vorder": 179,
    "position": 0,
    "text": "ازین کوه تا پیش دریای شهد"
  },
  {
    "poem_id": 87992,
    "vorder": 180,
    "position": 1,
    "text": "درفش و سپاهست و پیلان و مهد"
  },
  {
    "poem_id": 87992,
    "vorder": 181,
    "position": 0,
    "text": "اگر سوی ما پهلوان سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 182,
    "position": 1,
    "text": "نکردی گذر کار گشتی تباه"
  },
  {
    "poem_id": 87992,
    "vorder": 183,
    "position": 0,
    "text": "سپاس از خداوند پیروزگر"
  },
  {
    "poem_id": 87992,
    "vorder": 184,
    "position": 1,
    "text": "که او آورد رنج و سختی بسر"
  },
  {
    "poem_id": 87992,
    "vorder": 185,
    "position": 0,
    "text": "تن ما بتو زنده شد بی‌گمان"
  },
  {
    "poem_id": 87992,
    "vorder": 186,
    "position": 1,
    "text": "نبد هیچ کس را امید زمان"
  },
  {
    "poem_id": 87992,
    "vorder": 187,
    "position": 0,
    "text": "ازان کشتگان یک زمان پهلوان"
  },
  {
    "poem_id": 87992,
    "vorder": 188,
    "position": 1,
    "text": "همی بود گریان و تیره‌روان"
  },
  {
    "poem_id": 87992,
    "vorder": 189,
    "position": 0,
    "text": "ازان پس چنین گفت کز چرخ ماه"
  },
  {
    "poem_id": 87992,
    "vorder": 190,
    "position": 1,
    "text": "برو تا سر تیره خاک سیاه"
  },
  {
    "poem_id": 87992,
    "vorder": 191,
    "position": 0,
    "text": "نبینی مگر گرم و تیمار و رنج"
  },
  {
    "poem_id": 87992,
    "vorder": 192,
    "position": 1,
    "text": "برینست رسم سرای سپنج"
  },
  {
    "poem_id": 87992,
    "vorder": 193,
    "position": 0,
    "text": "گزافست کردار گردان سپهر"
  },
  {
    "poem_id": 87992,
    "vorder": 194,
    "position": 1,
    "text": "گهی زهر و جنگست و گه نوش و مهر"
  },
  {
    "poem_id": 87992,
    "vorder": 195,
    "position": 0,
    "text": "اگر کشته گر مرده هم بگذریم"
  },
  {
    "poem_id": 87992,
    "vorder": 196,
    "position": 1,
    "text": "سزد گر بچون و چرا ننگریم"
  },
  {
    "poem_id": 87992,
    "vorder": 197,
    "position": 0,
    "text": "چنان رفت باید که آید زمان"
  },
  {
    "poem_id": 87992,
    "vorder": 198,
    "position": 1,
    "text": "مشو تیز با گردش آسمان"
  },
  {
    "poem_id": 87992,
    "vorder": 199,
    "position": 0,
    "text": "جهاندار پیروزگر یار باد"
  },
  {
    "poem_id": 87992,
    "vorder": 200,
    "position": 1,
    "text": "سر بخت دشمن نگونسار باد"
  },
  {
    "poem_id": 87992,
    "vorder": 201,
    "position": 0,
    "text": "ازین پس همه کینه باز آوریم"
  },
  {
    "poem_id": 87992,
    "vorder": 202,
    "position": 1,
    "text": "جهان را بایران نیاز آوریم"
  },
  {
    "poem_id": 87992,
    "vorder": 203,
    "position": 0,
    "text": "بزرگان همه خواندند آفرین"
  },
  {
    "poem_id": 87992,
    "vorder": 204,
    "position": 1,
    "text": "که بی‌تو مبادا زمان و زمین"
  },
  {
    "poem_id": 87992,
    "vorder": 205,
    "position": 0,
    "text": "همیشه بدی نامبردار و شاد"
  },
  {
    "poem_id": 87992,
    "vorder": 206,
    "position": 1,
    "text": "در شاه پیروز بی‌تو مباد"
  },
  {
    "poem_id": 87992,
    "vorder": 207,
    "position": 0,
    "text": "چو از کوه بفروخت گیتی فروز"
  },
  {
    "poem_id": 87992,
    "vorder": 208,
    "position": 1,
    "text": "دو زلف شب تیره بگرفت روز"
  },
  {
    "poem_id": 87992,
    "vorder": 209,
    "position": 0,
    "text": "ازان چادر قیر بیرون کشید"
  },
  {
    "poem_id": 87992,
    "vorder": 210,
    "position": 1,
    "text": "بدندان لب ماه در خون کشید"
  },
  {
    "poem_id": 87992,
    "vorder": 211,
    "position": 0,
    "text": "تبیره برآمد ز هر دو سرای"
  },
  {
    "poem_id": 87992,
    "vorder": 212,
    "position": 1,
    "text": "برفتند گردان لشکر ز جای"
  },
  {
    "poem_id": 87992,
    "vorder": 213,
    "position": 0,
    "text": "سپهدار هومان به پیش سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 214,
    "position": 1,
    "text": "بیامد همی کرد هر سو نگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 215,
    "position": 0,
    "text": "که ایرانیان را که یار آمدست"
  },
  {
    "poem_id": 87992,
    "vorder": 216,
    "position": 1,
    "text": "که خرگاه و خیمه بکار آمدست"
  },
  {
    "poem_id": 87992,
    "vorder": 217,
    "position": 0,
    "text": "ز پیروزه دیبا سراپرده دید"
  },
  {
    "poem_id": 87992,
    "vorder": 218,
    "position": 1,
    "text": "فراوان بگرد اندرش پرده دید"
  },
  {
    "poem_id": 87992,
    "vorder": 219,
    "position": 0,
    "text": "درفش و سنان سپهبد بپیش"
  },
  {
    "poem_id": 87992,
    "vorder": 220,
    "position": 1,
    "text": "همان گردش اختر بد بپیش"
  },
  {
    "poem_id": 87992,
    "vorder": 221,
    "position": 0,
    "text": "سراپرده‌ای دید دیگر سیاه"
  },
  {
    "poem_id": 87992,
    "vorder": 222,
    "position": 1,
    "text": "درفشی درفشان بکردار ماه"
  },
  {
    "poem_id": 87992,
    "vorder": 223,
    "position": 0,
    "text": "فریبرز کاوس با پیل و کوس"
  },
  {
    "poem_id": 87992,
    "vorder": 224,
    "position": 1,
    "text": "فراوان زده خیمه نزدیک طوس"
  },
  {
    "poem_id": 87992,
    "vorder": 225,
    "position": 0,
    "text": "بیامد پر از غم بپیران بگفت"
  },
  {
    "poem_id": 87992,
    "vorder": 226,
    "position": 1,
    "text": "که شد روز با رنج بسیار جفت"
  },
  {
    "poem_id": 87992,
    "vorder": 227,
    "position": 0,
    "text": "کز ایران ده و دار و بانگ خروش"
  },
  {
    "poem_id": 87992,
    "vorder": 228,
    "position": 1,
    "text": "فراوان ز هر شب فزون بود دوش"
  },
  {
    "poem_id": 87992,
    "vorder": 229,
    "position": 0,
    "text": "بتنها برفتم ز خیمه پگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 230,
    "position": 1,
    "text": "بلشکر بهر جای کردم نگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 231,
    "position": 0,
    "text": "از ایران فراوان سپاه آمدست"
  },
  {
    "poem_id": 87992,
    "vorder": 232,
    "position": 1,
    "text": "بیاری برین رزمگاه آمدست"
  },
  {
    "poem_id": 87992,
    "vorder": 233,
    "position": 0,
    "text": "ز دیبا یکی سبز پرده‌سرای"
  },
  {
    "poem_id": 87992,
    "vorder": 234,
    "position": 1,
    "text": "یکی اژدهافش درفشی بپای"
  },
  {
    "poem_id": 87992,
    "vorder": 235,
    "position": 0,
    "text": "سپاهی بگرد اندرش زابلی"
  },
  {
    "poem_id": 87992,
    "vorder": 236,
    "position": 1,
    "text": "سپردار و با خنجر کابلی"
  },
  {
    "poem_id": 87992,
    "vorder": 237,
    "position": 0,
    "text": "گمانم که رستم ز نزدیک شاه"
  },
  {
    "poem_id": 87992,
    "vorder": 238,
    "position": 1,
    "text": "بیاری بیامد بدین رزمگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 239,
    "position": 0,
    "text": "بدو گفت پیران که بد روزگار"
  },
  {
    "poem_id": 87992,
    "vorder": 240,
    "position": 1,
    "text": "اگر رستم آید بدین کارزار"
  },
  {
    "poem_id": 87992,
    "vorder": 241,
    "position": 0,
    "text": "نه کاموس ماند نه خاقان چین"
  },
  {
    "poem_id": 87992,
    "vorder": 242,
    "position": 1,
    "text": "نه شنگل نه گردان توران زمین"
  },
  {
    "poem_id": 87992,
    "vorder": 243,
    "position": 0,
    "text": "هم‌انگه ز لشکر گه اندر کشید"
  },
  {
    "poem_id": 87992,
    "vorder": 244,
    "position": 1,
    "text": "بیامد سپهدار را بنگرید"
  },
  {
    "poem_id": 87992,
    "vorder": 245,
    "position": 0,
    "text": "وزانجا دمان سوی کاموس شد"
  },
  {
    "poem_id": 87992,
    "vorder": 246,
    "position": 1,
    "text": "بنزدیک منشور و فرطوس شد"
  },
  {
    "poem_id": 87992,
    "vorder": 247,
    "position": 0,
    "text": "که شبگیر ز ایدر برفتم پگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 248,
    "position": 1,
    "text": "بگشتم همه گرد ایران سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 249,
    "position": 0,
    "text": "بیاری فراوان سپاه آمدست"
  },
  {
    "poem_id": 87992,
    "vorder": 250,
    "position": 1,
    "text": "بسی کینه‌ور رزمخواه آمدست"
  },
  {
    "poem_id": 87992,
    "vorder": 251,
    "position": 0,
    "text": "گمانم که آن رستم پیلتن"
  },
  {
    "poem_id": 87992,
    "vorder": 252,
    "position": 1,
    "text": "که گفتم همی پیش این انجمن"
  },
  {
    "poem_id": 87992,
    "vorder": 253,
    "position": 0,
    "text": "برفت از در شاه ایران سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 254,
    "position": 1,
    "text": "بیاری بیامد بدین رزمگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 255,
    "position": 0,
    "text": "بدو گفت کاموس کای پر خرد"
  },
  {
    "poem_id": 87992,
    "vorder": 256,
    "position": 1,
    "text": "دلت یکسر اندیشهٔ بد برد"
  },
  {
    "poem_id": 87992,
    "vorder": 257,
    "position": 0,
    "text": "چنان دان که کیخسرو آمد بجنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 258,
    "position": 1,
    "text": "مکن خیره دل را بدین کار تنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 259,
    "position": 0,
    "text": "ز رستم چه رانی تو چندین سخن"
  },
  {
    "poem_id": 87992,
    "vorder": 260,
    "position": 1,
    "text": "ز زابلستان یاد چندین مکن"
  },
  {
    "poem_id": 87992,
    "vorder": 261,
    "position": 0,
    "text": "درفش مرا گر ببیند به چنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 262,
    "position": 1,
    "text": "بدریای چین بر خروشد نهنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 263,
    "position": 0,
    "text": "برو لشکر آرای و برکش سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 264,
    "position": 1,
    "text": "درفش اندر آور به آوردگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 265,
    "position": 0,
    "text": "چو من با سپاه اندر آیم بجنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 266,
    "position": 1,
    "text": "نباید که باشد شما را درنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 267,
    "position": 0,
    "text": "ببینی تو پیکار مردان کنون"
  },
  {
    "poem_id": 87992,
    "vorder": 268,
    "position": 1,
    "text": "شده دشت یکسر چو دریای خون"
  },
  {
    "poem_id": 87992,
    "vorder": 269,
    "position": 0,
    "text": "دل پهلوان زان سخن شاد گشت"
  },
  {
    "poem_id": 87992,
    "vorder": 270,
    "position": 1,
    "text": "ز اندیشهٔ رستم آزاد گشت"
  },
  {
    "poem_id": 87992,
    "vorder": 271,
    "position": 0,
    "text": "سپه را همه ترگ و جوشن بداد"
  },
  {
    "poem_id": 87992,
    "vorder": 272,
    "position": 1,
    "text": "همی کرد گفتار کاموس یاد"
  },
  {
    "poem_id": 87992,
    "vorder": 273,
    "position": 0,
    "text": "وزان جایگه پیش خاقان چین"
  },
  {
    "poem_id": 87992,
    "vorder": 274,
    "position": 1,
    "text": "بیامد ببوسید روی زمین"
  },
  {
    "poem_id": 87992,
    "vorder": 275,
    "position": 0,
    "text": "بدو گفت شاها انوشه بدی"
  },
  {
    "poem_id": 87992,
    "vorder": 276,
    "position": 1,
    "text": "روانرا بدیدار توشه بدی"
  },
  {
    "poem_id": 87992,
    "vorder": 277,
    "position": 0,
    "text": "بریدی یکی راه دشوار و دور"
  },
  {
    "poem_id": 87992,
    "vorder": 278,
    "position": 1,
    "text": "خریدی چنین رنج ما را بسور"
  },
  {
    "poem_id": 87992,
    "vorder": 279,
    "position": 0,
    "text": "بدین سان بآزرم افراسیاب"
  },
  {
    "poem_id": 87992,
    "vorder": 280,
    "position": 1,
    "text": "گذشتی به کشتی ز دریای آب"
  },
  {
    "poem_id": 87992,
    "vorder": 281,
    "position": 0,
    "text": "سپاه از تو دارد همی پشت راست"
  },
  {
    "poem_id": 87992,
    "vorder": 282,
    "position": 1,
    "text": "چنان کن که از گوهر تو سزاست"
  },
  {
    "poem_id": 87992,
    "vorder": 283,
    "position": 0,
    "text": "بیارای پیلان بزنگ و درای"
  },
  {
    "poem_id": 87992,
    "vorder": 284,
    "position": 1,
    "text": "جهان پر کن از نالهٔ کرنای"
  },
  {
    "poem_id": 87992,
    "vorder": 285,
    "position": 0,
    "text": "من امروز جنگ آورم با سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 286,
    "position": 1,
    "text": "تو با پیل و با کوس در قلبگاه"
  },
  {
    "poem_id": 87992,
    "vorder": 287,
    "position": 0,
    "text": "نگه دار پشت سپاه مرا"
  },
  {
    "poem_id": 87992,
    "vorder": 288,
    "position": 1,
    "text": "بابر اندر آور کلاه مرا"
  },
  {
    "poem_id": 87992,
    "vorder": 289,
    "position": 0,
    "text": "چنین گفت کاموس جنگی بمن"
  },
  {
    "poem_id": 87992,
    "vorder": 290,
    "position": 1,
    "text": "که تو پیش‌رو باش زین انجمن"
  },
  {
    "poem_id": 87992,
    "vorder": 291,
    "position": 0,
    "text": "بسی سخت سوگندهای دراز"
  },
  {
    "poem_id": 87992,
    "vorder": 292,
    "position": 1,
    "text": "بخورد و بر آهیخت گرز از فراز"
  },
  {
    "poem_id": 87992,
    "vorder": 293,
    "position": 0,
    "text": "که امروز من جز بدین گرز جنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 294,
    "position": 1,
    "text": "نسازم وگر بارد از ابر سنگ"
  },
  {
    "poem_id": 87992,
    "vorder": 295,
    "position": 0,
    "text": "چو بشنید خاقان بزد کرنای"
  },
  {
    "poem_id": 87992,
    "vorder": 296,
    "position": 1,
    "text": "تو گفتی که کوه اندر آمد ز جای"
  },
  {
    "poem_id": 87992,
    "vorder": 297,
    "position": 0,
    "text": "ز بانگ تبیره زمین و سپهر"
  },
  {
    "poem_id": 87992,
    "vorder": 298,
    "position": 1,
    "text": "بپوشید کوه و بیفگند مهر"
  },
  {
    "poem_id": 87992,
    "vorder": 299,
    "position": 0,
    "text": "بفرمود تا مهد بر پشت پیل"
  },
  {
    "poem_id": 87992,
    "vorder": 300,
    "position": 1,
    "text": "ببستند و شد روی گیتی چو نیل"
  },
  {
    "poem_id": 87992,
    "vorder": 301,
    "position": 0,
    "text": "بیامد گرازان بقلب سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 302,
    "position": 1,
    "text": "شد از گرد خورشید تابان سیاه"
  },
  {
    "poem_id": 87992,
    "vorder": 303,
    "position": 0,
    "text": "خروشیدن زنگ و هندی درای"
  },
  {
    "poem_id": 87992,
    "vorder": 304,
    "position": 1,
    "text": "همی دل برآورد گفتی ز جای"
  },
  {
    "poem_id": 87992,
    "vorder": 305,
    "position": 0,
    "text": "ز بس تخت پیروزه بر پشت پیل"
  },
  {
    "poem_id": 87992,
    "vorder": 306,
    "position": 1,
    "text": "درفشان بکردار دریای نیل"
  },
  {
    "poem_id": 87992,
    "vorder": 307,
    "position": 0,
    "text": "بچشم اندرون روشنایی نماند"
  },
  {
    "poem_id": 87992,
    "vorder": 308,
    "position": 1,
    "text": "همی با روان آشنایی نماند"
  },
  {
    "poem_id": 87992,
    "vorder": 309,
    "position": 0,
    "text": "پر از گرد شد چشم و کام سپهر"
  },
  {
    "poem_id": 87992,
    "vorder": 310,
    "position": 1,
    "text": "تو گفتی بقیر اندر اندود چهر"
  },
  {
    "poem_id": 87992,
    "vorder": 311,
    "position": 0,
    "text": "چو خاقان بیامد بقلب سپاه"
  },
  {
    "poem_id": 87992,
    "vorder": 312,
    "position": 1,
    "text": "بچرخ اندرون ماه گم کرد راه"
  },
  {
    "poem_id": 87992,
    "vorder": 313,
    "position": 0,
    "text": "ز کاموس چون کوه شد میمنه"
  },
  {
    "poem_id": 87992,
    "vorder": 314,
    "position": 1,
    "text": "کشیدند بر سوی هامون بنه"
  },
  {
    "poem_id": 87992,
    "vorder": 315,
    "position": 0,
    "text": "سوی میسره نیز پیران برفت"
  },
  {
    "poem_id": 87992,
    "vorder": 316,
    "position": 1,
    "text": "برادرش هومان و کلباد تفت"
  },
  {
    "poem_id": 87992,
    "vorder": 317,
    "position": 0,
    "text": "چو رستم بدید آنک خاقان چه کرد"
  },
  {
    "poem_id": 87992,
    "vorder": 318,
    "position": 1,
    "text": "بیاراست در قلب جای نبرد"
  },
  {
    "poem_id": 87992,
    "vorder": 319,
    "position": 0,
    "text": "چنین گفت رستم که گردان سپهر"
  },
  {
    "poem_id": 87992,
    "vorder": 320,
    "position": 1,
    "text": "ببینیم تا بر که گردد بمهر"
  },
  {
    "poem_id": 87992,
    "vorder": 321,
    "position": 0,
    "text": "چگونه بود بخشش آسمان"
  },
  {
    "poem_id": 87992,
    "vorder": 322,
    "position": 1,
    "text": "کرا زین بزرگان سرآید زمان"
  },
  {
    "poem_id": 87992,
    "vorder": 323,
    "position": 0,
    "text": "درنگی نبودم براه اندکی"
  },
  {
    "poem_id": 87992,
    "vorder": 324,
    "position": 1,
    "text": "دو منزل همی کرد رخشم یکی"
  },
  {
    "poem_id": 87992,
    "vorder": 325,
    "position": 0,
    "text": "کنون سم این بارگی کوفتست"
  },
  {
    "poem_id": 87992,
    "vorder": 326,
    "position": 1,
    "text": "ز راه دراز اندر آشوفتست"
  },
  {
    "poem_id": 87992,
    "vorder": 327,
    "position": 0,
    "text": "نیارم برو کرد نیرو بسی"
  },
  {
    "poem_id": 87992,
    "vorder": 328,
    "position": 1,
    "text": "شدن جنگ جویان به پیش کسی"
  },
  {
    "poem_id": 87992,
    "vorder": 329,
    "position": 0,
    "text": "یک امروز در جنگ یاری کنید"
  },
  {
    "poem_id": 87992,
    "vorder": 330,
    "position": 1,
    "text": "برین دشمنان کامگاری کنید"
  },
  {
    "poem_id": 87992,
    "vorder": 331,
    "position": 0,
    "text": "که گردان سپهر جهان یار ماست"
  },
  {
    "poem_id": 87992,
    "vorder": 332,
    "position": 1,
    "text": "مه و مهر گردون نگهدار ماست"
  },
  {
    "poem_id": 87992,
    "vorder": 333,
    "position": 0,
    "text": "بفرمود تا طوس بربست کوس"
  },
  {
    "poem_id": 87992,
    "vorder": 334,
    "position": 1,
    "text": "بیاراست لشکر چو چشم خروس"
  },
  {
    "poem_id": 87992,
    "vorder": 335,
    "position": 0,
    "text": "سپهبد بزد نای و رویینه خم"
  },
  {
    "poem_id": 87992,
    "vorder": 336,
    "position": 1,
    "text": "خروش آمد و نالهٔ گاودم"
  },
  {
    "poem_id": 87992,
    "vorder": 337,
    "position": 0,
    "text": "بیاراست گودرز بر میمنه"
  },
  {
    "poem_id": 87992,
    "vorder": 338,
    "position": 1,
    "text": "فرستاد بر کوه خارا بنه"
  },
  {
    "poem_id": 87992,
    "vorder": 339,
    "position": 0,
    "text": "فریبرز کاوس بر میسره"
  },
  {
    "poem_id": 87992,
    "vorder": 340,
    "position": 1,
    "text": "جهان چون نیستان شده یکسره"
  },
  {
    "poem_id": 87992,
    "vorder": 341,
    "position": 0,
    "text": "بقلب اندرون طوس نوذر بپای"
  },
  {
    "poem_id": 87992,
    "vorder": 342,
    "position": 1,
    "text": "زمین شد پر از نالهٔ کرنای"
  },
  {
    "poem_id": 87992,
    "vorder": 343,
    "position": 0,
    "text": "جهان شد بگرد اندرون ناپدید"
  },
  {
    "poem_id": 87992,
    "vorder": 344,
    "position": 1,
    "text": "کسی از یلان خویشتن را ندید"
  },
  {
    "poem_id": 87992,
    "vorder": 345,
    "position": 0,
    "text": "بشد پیلتن تا سر تیغ کوه"
  },
  {
    "poem_id": 87992,
    "vorder": 346,
    "position": 1,
    "text": "بدیدار خاقان و توران گروه"
  },
  {
    "poem_id": 87992,
    "vorder": 347,
    "position": 0,
    "text": "سپه دید چندانک دریای روم"
  },
  {
    "poem_id": 87992,
    "vorder": 348,
    "position": 1,
    "text": "ازیشان نمودی چو یک مهره موم"
  },
  {
    "poem_id": 87992,
    "vorder": 349,
    "position": 0,
    "text": "کشانی و شگنی و سقلاب و هند"
  },
  {
    "poem_id": 87992,
    "vorder": 350,
    "position": 1,
    "text": "چغانی و رومی و وهری و سند"
  },
  {
    "poem_id": 87992,
    "vorder": 351,
    "position": 0,
    "text": "جهانی شده سرخ و زرد و سیاه"
  },
  {
    "poem_id": 87992,
    "vorder": 352,
    "position": 1,
    "text": "دگرگونه جوشن دگرگون کلاه"
  },
  {
    "poem_id": 87992,
    "vorder": 353,
    "position": 0,
    "text": "زبانی دگرگون بهر گوشه‌ای"
  },
  {
    "poem_id": 87992,
    "vorder": 354,
    "position": 1,
    "text": "درفش نوآیین و نو توشه‌ای"
  },
  {
    "poem_id": 87992,
    "vorder": 355,
    "position": 0,
    "text": "ز پیلان و آرایش و تخت عاج"
  },
  {
    "poem_id": 87992,
    "vorder": 356,
    "position": 1,
    "text": "همان یاره و افسر و طوق و تاج"
  },
  {
    "poem_id": 87992,
    "vorder": 357,
    "position": 0,
    "text": "جهان بود یکسر چو باغ بهشت"
  },
  {
    "poem_id": 87992,
    "vorder": 358,
    "position": 1,
    "text": "بدیدار ایشان شده خوب زشت"
  },
  {
    "poem_id": 87992,
    "vorder": 359,
    "position": 0,
    "text": "بران کوه سر ماند رستم شگفت"
  },
  {
    "poem_id": 87992,
    "vorder": 360,
    "position": 1,
    "text": "ببرگشتن اندیشه اندر گرفت"
  },
  {
    "poem_id": 87992,
    "vorder": 361,
    "position": 0,
    "text": "که تا چون نماید بما چرخ مهر"
  },
  {
    "poem_id": 87992,
    "vorder": 362,
    "position": 1,
    "text": "چه بازی کند پیر گشته سپهر"
  },
  {
    "poem_id": 87992,
    "vorder": 363,
    "position": 0,
    "text": "فرود آمد از کوه و دل بد نکرد"
  },
  {
    "poem_id": 87992,
    "vorder": 364,
    "position": 1,
    "text": "گذر بر سپاه و سپهبد نکرد"
  },
  {
    "poem_id": 87992,
    "vorder": 365,
    "position": 0,
    "text": "همی گفت تا من کمر بسته‌ام"
  },
  {
    "poem_id": 87992,
    "vorder": 366,
    "position": 1,
    "text": "بیک جای یک سال ننشسته‌ام"
  },
  {
    "poem_id": 87992,
    "vorder": 367,
    "position": 0,
    "text": "فراوان سپه دیده‌ام پیش ازین"
  },
  {
    "poem_id": 87992,
    "vorder": 368,
    "position": 1,
    "text": "ندانم که لشکر بود بیش ازین"
  },
  {
    "poem_id": 87992,
    "vorder": 369,
    "position": 0,
    "text": "بفرمود تا برکشیدند کوس"
  },
  {
    "poem_id": 87992,
    "vorder": 370,
    "position": 1,
    "text": "بجنگ اندر آمد سپهدار طوس"
  },
  {
    "poem_id": 87992,
    "vorder": 371,
    "position": 0,
    "text": "ازان کوه سر سوی هامون کشید"
  },
  {
    "poem_id": 87992,
    "vorder": 372,
    "position": 1,
    "text": "همی نیزه از کینه در خون کشید"
  },
  {
    "poem_id": 87992,
    "vorder": 373,
    "position": 0,
    "text": "بیک نیمه از روز لشکر گذشت"
  },
  {
    "poem_id": 87992,
    "vorder": 374,
    "position": 1,
    "text": "کشیدند صف بر دو فرسنگ دشت"
  },
  {
    "poem_id": 87992,
    "vorder": 375,
    "position": 0,
    "text": "ز گرد سپه روشنایی نماند"
  },
  {
    "poem_id": 87992,
    "vorder": 376,
    "position": 1,
    "text": "ز خورشید شب را جدایی نماند"
  },
  {
    "poem_id": 87992,
    "vorder": 377,
    "position": 0,
    "text": "ز تیر و ز پیکان هوا تیره گشت"
  },
  {
    "poem_id": 87992,
    "vorder": 378,
    "position": 1,
    "text": "همی آفتاب اندران خیره گشت"
  },
  {
    "poem_id": 87992,
    "vorder": 379,
    "position": 0,
    "text": "خروش سواران و اسپان ز دشت"
  },
  {
    "poem_id": 87992,
    "vorder": 380,
    "position": 1,
    "text": "ز بهرام و کیوان همی برگذشت"
