[
  {
    "poem_id": 1787,
    "vorder": 1,
    "position": 0,
    "text": "دگر هفته تنها به نخچیر شد"
  },
  {
    "poem_id": 1787,
    "vorder": 2,
    "position": 1,
    "text": "دژم بود با ترکش و تیر شد"
  },
  {
    "poem_id": 1787,
    "vorder": 3,
    "position": 0,
    "text": "ز خورشید تابنده شد دشت گرم"
  },
  {
    "poem_id": 1787,
    "vorder": 4,
    "position": 1,
    "text": "سپهبد ز نخچیر برگشت نرم"
  },
  {
    "poem_id": 1787,
    "vorder": 5,
    "position": 0,
    "text": "سوی کاخ بازارگانی رسید"
  },
  {
    "poem_id": 1787,
    "vorder": 6,
    "position": 1,
    "text": "به هر سو نگه کرد و کس را ندید"
  },
  {
    "poem_id": 1787,
    "vorder": 7,
    "position": 0,
    "text": "ببازارگان گفت ما را سپنج"
  },
  {
    "poem_id": 1787,
    "vorder": 8,
    "position": 1,
    "text": "توان داد کز ما نبینی تو رنج"
  },
  {
    "poem_id": 1787,
    "vorder": 9,
    "position": 0,
    "text": "چو بازارگانش فرود آورید"
  },
  {
    "poem_id": 1787,
    "vorder": 10,
    "position": 1,
    "text": "مر او را یکی خوابگه برگزید"
  },
  {
    "poem_id": 1787,
    "vorder": 11,
    "position": 0,
    "text": "همی بود نالان ز درد شکم"
  },
  {
    "poem_id": 1787,
    "vorder": 12,
    "position": 1,
    "text": "به بازارگان داد لختی درم"
  },
  {
    "poem_id": 1787,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت لختی نبید کهن"
  },
  {
    "poem_id": 1787,
    "vorder": 14,
    "position": 1,
    "text": "ابا مغز بادام بریان بکن"
  },
  {
    "poem_id": 1787,
    "vorder": 15,
    "position": 0,
    "text": "اگر خانگی مرغ باشد رواست"
  },
  {
    "poem_id": 1787,
    "vorder": 16,
    "position": 1,
    "text": "کزین آرزوها دلم را هواست"
  },
  {
    "poem_id": 1787,
    "vorder": 17,
    "position": 0,
    "text": "نیاورد بازارگان آنچ گفت"
  },
  {
    "poem_id": 1787,
    "vorder": 18,
    "position": 1,
    "text": "نبد مغز بادامش اندر نهفت"
  },
  {
    "poem_id": 1787,
    "vorder": 19,
    "position": 0,
    "text": "چو تاریک شد میزبان رفت نرم"
  },
  {
    "poem_id": 1787,
    "vorder": 20,
    "position": 1,
    "text": "یکی مرغ بریان بیاورد گرم"
  },
  {
    "poem_id": 1787,
    "vorder": 21,
    "position": 0,
    "text": "بیاراست خوان پیش بهرام برد"
  },
  {
    "poem_id": 1787,
    "vorder": 22,
    "position": 1,
    "text": "به بازارگان گفت بهرام گرد"
  },
  {
    "poem_id": 1787,
    "vorder": 23,
    "position": 0,
    "text": "که از تو نبید کهن خواستم"
  },
  {
    "poem_id": 1787,
    "vorder": 24,
    "position": 1,
    "text": "زبان را به خواهش بیاراستم"
  },
  {
    "poem_id": 1787,
    "vorder": 25,
    "position": 0,
    "text": "نیاوردی و داده بودم درم"
  },
  {
    "poem_id": 1787,
    "vorder": 26,
    "position": 1,
    "text": "که نالنده بودم ز درد شکم"
  },
  {
    "poem_id": 1787,
    "vorder": 27,
    "position": 0,
    "text": "چنین داد پاسخ که ای بی‌خرد"
  },
  {
    "poem_id": 1787,
    "vorder": 28,
    "position": 1,
    "text": "نداری خرد کو روان پرورد"
  },
  {
    "poem_id": 1787,
    "vorder": 29,
    "position": 0,
    "text": "چو آوردم این مرغ بریان گرم"
  },
  {
    "poem_id": 1787,
    "vorder": 30,
    "position": 1,
    "text": "فزون خواستن نیست آیین و شرم"
  },
  {
    "poem_id": 1787,
    "vorder": 31,
    "position": 0,
    "text": "چو بشنید بهرام زو این سخن"
  },
  {
    "poem_id": 1787,
    "vorder": 32,
    "position": 1,
    "text": "بشد آرزوی نبید کهن"
  },
  {
    "poem_id": 1787,
    "vorder": 33,
    "position": 0,
    "text": "پشیمان شد از گفت خود نان بخورد"
  },
  {
    "poem_id": 1787,
    "vorder": 34,
    "position": 1,
    "text": "برو نیز یاد گذشته نکرد"
  },
  {
    "poem_id": 1787,
    "vorder": 35,
    "position": 0,
    "text": "چو هنگامهٔ خوابش آمد بخفت"
  },
  {
    "poem_id": 1787,
    "vorder": 36,
    "position": 1,
    "text": "به بازارگان نیز چیزی نگفت"
  },
  {
    "poem_id": 1787,
    "vorder": 37,
    "position": 0,
    "text": "ز دریای جوشان چو خور بردمید"
  },
  {
    "poem_id": 1787,
    "vorder": 38,
    "position": 1,
    "text": "شد آن چادر قیرگون ناپدید"
  },
  {
    "poem_id": 1787,
    "vorder": 39,
    "position": 0,
    "text": "همی گفت پرمایه بازارگان"
  },
  {
    "poem_id": 1787,
    "vorder": 40,
    "position": 1,
    "text": "به شاگرد کای مرد ناکاردان"
  },
  {
    "poem_id": 1787,
    "vorder": 41,
    "position": 0,
    "text": "مران مرغ کارزش نبد یک درم"
  },
  {
    "poem_id": 1787,
    "vorder": 42,
    "position": 1,
    "text": "خریدی به افزون و کردی ستم"
  },
  {
    "poem_id": 1787,
    "vorder": 43,
    "position": 0,
    "text": "گر ارزان خریدی ابا این سوار"
  },
  {
    "poem_id": 1787,
    "vorder": 44,
    "position": 1,
    "text": "نبودی مرا تیره شب کارزار"
  },
  {
    "poem_id": 1787,
    "vorder": 45,
    "position": 0,
    "text": "خریدی مر او را به دانگی پنیر"
  },
  {
    "poem_id": 1787,
    "vorder": 46,
    "position": 1,
    "text": "بدی با من امروز چون آب و شیر"
  },
  {
    "poem_id": 1787,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت اگر این نه کار منست"
  },
  {
    "poem_id": 1787,
    "vorder": 48,
    "position": 1,
    "text": "چنان دان که مرغ از شمار منست"
  },
  {
    "poem_id": 1787,
    "vorder": 49,
    "position": 0,
    "text": "تو مهمان من باش با این سوار"
  },
  {
    "poem_id": 1787,
    "vorder": 50,
    "position": 1,
    "text": "بدین مرغ با من مکن کارزار"
  },
  {
    "poem_id": 1787,
    "vorder": 51,
    "position": 0,
    "text": "چو بهرام برخاست از خواب خوش"
  },
  {
    "poem_id": 1787,
    "vorder": 52,
    "position": 1,
    "text": "بشد نزد آن بارهٔ دست‌کش"
  },
  {
    "poem_id": 1787,
    "vorder": 53,
    "position": 0,
    "text": "که زین برنهد تا به ایوان شود"
  },
  {
    "poem_id": 1787,
    "vorder": 54,
    "position": 1,
    "text": "کلاهش ز ایوان به کیوان شود"
  },
  {
    "poem_id": 1787,
    "vorder": 55,
    "position": 0,
    "text": "چو شاگرد دیدش به بهرام گفت"
  },
  {
    "poem_id": 1787,
    "vorder": 56,
    "position": 1,
    "text": "که امروز با من به بد باش جفت"
  },
  {
    "poem_id": 1787,
    "vorder": 57,
    "position": 0,
    "text": "بشد شاه و بنشست بر تخت اوی"
  },
  {
    "poem_id": 1787,
    "vorder": 58,
    "position": 1,
    "text": "شگفتی فروماند از بخت اوی"
  },
  {
    "poem_id": 1787,
    "vorder": 59,
    "position": 0,
    "text": "جوان رفت و آورد خایه دویست"
  },
  {
    "poem_id": 1787,
    "vorder": 60,
    "position": 1,
    "text": "به استاد گفت ای گرامی مه‌ایست"
  },
  {
    "poem_id": 1787,
    "vorder": 61,
    "position": 0,
    "text": "یکی مرغ بریان با نان گرم"
  },
  {
    "poem_id": 1787,
    "vorder": 62,
    "position": 1,
    "text": "نبید کهن آر و بادام نرم"
  },
  {
    "poem_id": 1787,
    "vorder": 63,
    "position": 0,
    "text": "بشد نزد بهرام گفت ای سوار"
  },
  {
    "poem_id": 1787,
    "vorder": 64,
    "position": 1,
    "text": "همی خایه کردی تو دی خواستار"
  },
  {
    "poem_id": 1787,
    "vorder": 65,
    "position": 0,
    "text": "کنون آرزوها بیاریم گرم"
  },
  {
    "poem_id": 1787,
    "vorder": 66,
    "position": 1,
    "text": "هم از چندگونه خورشهای نرم"
  },
  {
    "poem_id": 1787,
    "vorder": 67,
    "position": 0,
    "text": "بگفت این و زان پس به بازار شد"
  },
  {
    "poem_id": 1787,
    "vorder": 68,
    "position": 1,
    "text": "به ساز دگرگون خریدار شد"
  },
  {
    "poem_id": 1787,
    "vorder": 69,
    "position": 0,
    "text": "شکر جست و بادام و مرغ و بره"
  },
  {
    "poem_id": 1787,
    "vorder": 70,
    "position": 1,
    "text": "که آرایش خوان کند یکسره"
  },
  {
    "poem_id": 1787,
    "vorder": 71,
    "position": 0,
    "text": "می و زعفران برد و مشک و گلاب"
  },
  {
    "poem_id": 1787,
    "vorder": 72,
    "position": 1,
    "text": "سوی خانه شد با دلی پرشتاب"
  },
  {
    "poem_id": 1787,
    "vorder": 73,
    "position": 0,
    "text": "بیاورد خوان با خورشهای نغز"
  },
  {
    "poem_id": 1787,
    "vorder": 74,
    "position": 1,
    "text": "جوان بر منش بود و پاکیزه‌مغز"
  },
  {
    "poem_id": 1787,
    "vorder": 75,
    "position": 0,
    "text": "چو نان خورده شد جام پر می‌ببرد"
  },
  {
    "poem_id": 1787,
    "vorder": 76,
    "position": 1,
    "text": "نخستنی به بهرام خسرو سپرد"
  },
  {
    "poem_id": 1787,
    "vorder": 77,
    "position": 0,
    "text": "بدین‌گونه تا شاد و خرم شدند"
  },
  {
    "poem_id": 1787,
    "vorder": 78,
    "position": 1,
    "text": "ز خردک به جام دمادم شدند"
  },
  {
    "poem_id": 1787,
    "vorder": 79,
    "position": 0,
    "text": "چنین گفت با میزبان شهریار"
  },
  {
    "poem_id": 1787,
    "vorder": 80,
    "position": 1,
    "text": "که بهرام ما را کند خواستار"
  },
  {
    "poem_id": 1787,
    "vorder": 81,
    "position": 0,
    "text": "شما می گسارید و مستان شوید"
  },
  {
    "poem_id": 1787,
    "vorder": 82,
    "position": 1,
    "text": "مجنبید تا می پرستان شوید"
  },
  {
    "poem_id": 1787,
    "vorder": 83,
    "position": 0,
    "text": "بمالید پس باره را زین نهاد"
  },
  {
    "poem_id": 1787,
    "vorder": 84,
    "position": 1,
    "text": "سوی گلشن آمد ز می گشته شاد"
  },
  {
    "poem_id": 1787,
    "vorder": 85,
    "position": 0,
    "text": "به بازارگان گفت چندین مکوش"
  },
  {
    "poem_id": 1787,
    "vorder": 86,
    "position": 1,
    "text": "از افزونی این مرد ارزان فروش"
  },
  {
    "poem_id": 1787,
    "vorder": 87,
    "position": 0,
    "text": "به دانگی مرا دوش بفروختی"
  },
  {
    "poem_id": 1787,
    "vorder": 88,
    "position": 1,
    "text": "همی چشم شاگرد را دوختی"
  },
  {
    "poem_id": 1787,
    "vorder": 89,
    "position": 0,
    "text": "که مرغی خریدی فزون از بها"
  },
  {
    "poem_id": 1787,
    "vorder": 90,
    "position": 1,
    "text": "نهادی مرا در دم اژدها"
  },
  {
    "poem_id": 1787,
    "vorder": 91,
    "position": 0,
    "text": "بگفت این به بازارگان و برفت"
  },
  {
    "poem_id": 1787,
    "vorder": 92,
    "position": 1,
    "text": "سوی گاه شاهی خرامید تفت"
  },
  {
    "poem_id": 1787,
    "vorder": 93,
    "position": 0,
    "text": "چو خورشید بر تخت بنمود تاج"
  },
  {
    "poem_id": 1787,
    "vorder": 94,
    "position": 1,
    "text": "جهانبان نشست از بر تخت عاج"
  },
  {
    "poem_id": 1787,
    "vorder": 95,
    "position": 0,
    "text": "بفرمود خسرو به سالار بار"
  },
  {
    "poem_id": 1787,
    "vorder": 96,
    "position": 1,
    "text": "که بازارگان را کند خواستار"
  },
  {
    "poem_id": 1787,
    "vorder": 97,
    "position": 0,
    "text": "بیارند شاگرد با او بهم"
  },
  {
    "poem_id": 1787,
    "vorder": 98,
    "position": 1,
    "text": "یکی شاد ازیشان و دیگر دژم"
  },
  {
    "poem_id": 1787,
    "vorder": 99,
    "position": 0,
    "text": "چو شاگرد و استاد رفتند زود"
  },
  {
    "poem_id": 1787,
    "vorder": 100,
    "position": 1,
    "text": "به پیش شهنشاه ایران چو دود"
  },
  {
    "poem_id": 1787,
    "vorder": 101,
    "position": 0,
    "text": "چو شاگرد را دید بنواختش"
  },
  {
    "poem_id": 1787,
    "vorder": 102,
    "position": 1,
    "text": "بر مهتران شاد بنشاختش"
  },
  {
    "poem_id": 1787,
    "vorder": 103,
    "position": 0,
    "text": "یکی بدره بردند نزدیک اوی"
  },
  {
    "poem_id": 1787,
    "vorder": 104,
    "position": 1,
    "text": "که چون ماه شد جان تاریک اوی"
  },
  {
    "poem_id": 1787,
    "vorder": 105,
    "position": 0,
    "text": "به بازارگان گفت تا زنده‌ای"
  },
  {
    "poem_id": 1787,
    "vorder": 106,
    "position": 1,
    "text": "چنان دان که شاگرد را بنده‌ای"
  },
  {
    "poem_id": 1787,
    "vorder": 107,
    "position": 0,
    "text": "همان نیز هر ماهیانی دوبار"
  },
  {
    "poem_id": 1787,
    "vorder": 108,
    "position": 1,
    "text": "درم شست گنجی بروبر شمار"
  },
  {
    "poem_id": 1787,
    "vorder": 109,
    "position": 0,
    "text": "به چیز تو شاگرد مهمان کند"
  },
  {
    "poem_id": 1787,
    "vorder": 110,
    "position": 1,
    "text": "دل مرد آزاده خندان کند"
  },
  {
    "poem_id": 1787,
    "vorder": 111,
    "position": 0,
    "text": "به موبد چنین گفت زان پس که شاه"
  },
  {
    "poem_id": 1787,
    "vorder": 112,
    "position": 1,
    "text": "چو کار جهان را ندارد نگاه"
  },
  {
    "poem_id": 1787,
    "vorder": 113,
    "position": 0,
    "text": "چه داند که مردم کدامست به"
  },
  {
    "poem_id": 1787,
    "vorder": 114,
    "position": 1,
    "text": "چگونه شناسد کهان را ز مه"
  }
]