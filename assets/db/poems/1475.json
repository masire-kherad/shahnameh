[
  {
    "poem_id": 1475,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تابان برآورد پر"
  },
  {
    "poem_id": 1475,
    "vorder": 2,
    "position": 1,
    "text": "سیه زاغ پران فرو برد سر"
  },
  {
    "poem_id": 1475,
    "vorder": 3,
    "position": 0,
    "text": "تهمتن بپوشید ببربیان"
  },
  {
    "poem_id": 1475,
    "vorder": 4,
    "position": 1,
    "text": "نشست از بر ژنده پیل ژیان"
  },
  {
    "poem_id": 1475,
    "vorder": 5,
    "position": 0,
    "text": "کمندی به فتراک بر بست شست"
  },
  {
    "poem_id": 1475,
    "vorder": 6,
    "position": 1,
    "text": "یکی تیغ هندی گرفته بدست"
  },
  {
    "poem_id": 1475,
    "vorder": 7,
    "position": 0,
    "text": "بیامد بران دشت آوردگاه"
  },
  {
    "poem_id": 1475,
    "vorder": 8,
    "position": 1,
    "text": "نهاده به سر بر ز آهن کلاه"
  },
  {
    "poem_id": 1475,
    "vorder": 9,
    "position": 0,
    "text": "همه تلخی از بهر بیشی بود"
  },
  {
    "poem_id": 1475,
    "vorder": 10,
    "position": 1,
    "text": "مبادا که با آز خویشی بود"
  },
  {
    "poem_id": 1475,
    "vorder": 11,
    "position": 0,
    "text": "وزان روی سهراب با انجمن"
  },
  {
    "poem_id": 1475,
    "vorder": 12,
    "position": 1,
    "text": "همی می گسارید با رودزن"
  },
  {
    "poem_id": 1475,
    "vorder": 13,
    "position": 0,
    "text": "به هومان چنین گفت کاین شیرمرد"
  },
  {
    "poem_id": 1475,
    "vorder": 14,
    "position": 1,
    "text": "که با من همی‌گردد اندر نبرد"
  },
  {
    "poem_id": 1475,
    "vorder": 15,
    "position": 0,
    "text": "ز بالای من نیست بالاش کم"
  },
  {
    "poem_id": 1475,
    "vorder": 16,
    "position": 1,
    "text": "برزم اندرون دل ندارد دژم"
  },
  {
    "poem_id": 1475,
    "vorder": 17,
    "position": 0,
    "text": "بر و کتف و یالش همانند من"
  },
  {
    "poem_id": 1475,
    "vorder": 18,
    "position": 1,
    "text": "تو گویی که داننده بر زد رسن"
  },
  {
    "poem_id": 1475,
    "vorder": 19,
    "position": 0,
    "text": "نشان‌های مادر بیابم همی"
  },
  {
    "poem_id": 1475,
    "vorder": 20,
    "position": 1,
    "text": "بدان نیز لختی بتابم همی"
  },
  {
    "poem_id": 1475,
    "vorder": 21,
    "position": 0,
    "text": "گمانی برم من که او رستمست"
  },
  {
    "poem_id": 1475,
    "vorder": 22,
    "position": 1,
    "text": "که چون او بگیتی نبرده کمست"
  },
  {
    "poem_id": 1475,
    "vorder": 23,
    "position": 0,
    "text": "نباید که من با پدر جنگجوی"
  },
  {
    "poem_id": 1475,
    "vorder": 24,
    "position": 1,
    "text": "شوم خیره‌روی اندر آرم بروی"
  },
  {
    "poem_id": 1475,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت هومان که در کارزار"
  },
  {
    "poem_id": 1475,
    "vorder": 26,
    "position": 1,
    "text": "رسیدست رستم به من اند بار"
  },
  {
    "poem_id": 1475,
    "vorder": 27,
    "position": 0,
    "text": "شنیدم که در جنگ مازندران"
  },
  {
    "poem_id": 1475,
    "vorder": 28,
    "position": 1,
    "text": "چه کرد آن دلاور به گُرز گران"
  },
  {
    "poem_id": 1475,
    "vorder": 29,
    "position": 0,
    "text": "بدین رخش ماند همی رخش اوی"
  },
  {
    "poem_id": 1475,
    "vorder": 30,
    "position": 1,
    "text": "ولیکن ندارد پی و پخش اوی"
  },
  {
    "poem_id": 1475,
    "vorder": 31,
    "position": 0,
    "text": "به شبگیر چون بردمید آفتاب"
  },
  {
    "poem_id": 1475,
    "vorder": 32,
    "position": 1,
    "text": "سر جنگجویان برآمد ز خواب"
  },
  {
    "poem_id": 1475,
    "vorder": 33,
    "position": 0,
    "text": "بپوشید سهراب خفتان رزم"
  },
  {
    "poem_id": 1475,
    "vorder": 34,
    "position": 1,
    "text": "سرش پر ز رزم و دلش پر ز بزم"
  },
  {
    "poem_id": 1475,
    "vorder": 35,
    "position": 0,
    "text": "بیامد خروشان بران دشت جنگ"
  },
  {
    "poem_id": 1475,
    "vorder": 36,
    "position": 1,
    "text": "به چنگ اندرون گُرزهٔ گاورنگ"
  },
  {
    "poem_id": 1475,
    "vorder": 37,
    "position": 0,
    "text": "ز رستم بپرسید خندان دو لب"
  },
  {
    "poem_id": 1475,
    "vorder": 38,
    "position": 1,
    "text": "تو گفتی که با او به هم بود شب"
  },
  {
    "poem_id": 1475,
    "vorder": 39,
    "position": 0,
    "text": "که شب چون بدت روز چون خاستی"
  },
  {
    "poem_id": 1475,
    "vorder": 40,
    "position": 1,
    "text": "ز پیگار بر دل چه آراستی"
  },
  {
    "poem_id": 1475,
    "vorder": 41,
    "position": 0,
    "text": "ز کف بفگن این گُرز و شمشیر کین"
  },
  {
    "poem_id": 1475,
    "vorder": 42,
    "position": 1,
    "text": "بزن جنگ و بیداد را بر زمین"
  },
  {
    "poem_id": 1475,
    "vorder": 43,
    "position": 0,
    "text": "نشینیم هر دو پیاده به هم"
  },
  {
    "poem_id": 1475,
    "vorder": 44,
    "position": 1,
    "text": "به می تازه داریم روی دژم"
  },
  {
    "poem_id": 1475,
    "vorder": 45,
    "position": 0,
    "text": "به پیش جهاندار پیمان کنیم"
  },
  {
    "poem_id": 1475,
    "vorder": 46,
    "position": 1,
    "text": "دل از جنگ جستن پشیمان کنیم"
  },
  {
    "poem_id": 1475,
    "vorder": 47,
    "position": 0,
    "text": "همان تا کسی دیگر آید به رزم"
  },
  {
    "poem_id": 1475,
    "vorder": 48,
    "position": 1,
    "text": "تو با من بساز و بیارای بزم"
  },
  {
    "poem_id": 1475,
    "vorder": 49,
    "position": 0,
    "text": "دل من همی با تو مهر آورد"
  },
  {
    "poem_id": 1475,
    "vorder": 50,
    "position": 1,
    "text": "همی آب شرمم به چهر آورد"
  },
  {
    "poem_id": 1475,
    "vorder": 51,
    "position": 0,
    "text": "همانا که داری ز گردان نژاد"
  },
  {
    "poem_id": 1475,
    "vorder": 52,
    "position": 1,
    "text": "کنی پیش من گوهر خویش یاد"
  },
  {
    "poem_id": 1475,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت رستم که‌ای نامجوی"
  },
  {
    "poem_id": 1475,
    "vorder": 54,
    "position": 1,
    "text": "نبودیم هرگز بدین گفت‌وگوی"
  },
  {
    "poem_id": 1475,
    "vorder": 55,
    "position": 0,
    "text": "ز کشتی گرفتن سخن بود دوش"
  },
  {
    "poem_id": 1475,
    "vorder": 56,
    "position": 1,
    "text": "نگیرم فریب تو زین در مکوش"
  },
  {
    "poem_id": 1475,
    "vorder": 57,
    "position": 0,
    "text": "نه من کودکم گر تو هستی جوان"
  },
  {
    "poem_id": 1475,
    "vorder": 58,
    "position": 1,
    "text": "به کشتی کمر بسته‌ام بر میان"
  },
  {
    "poem_id": 1475,
    "vorder": 59,
    "position": 0,
    "text": "بکوشیم و فرجام کار آن بود"
  },
  {
    "poem_id": 1475,
    "vorder": 60,
    "position": 1,
    "text": "که فرمان و رای جهانبان بود"
  },
  {
    "poem_id": 1475,
    "vorder": 61,
    "position": 0,
    "text": "بسی گشته‌ام در فراز و نشیب"
  },
  {
    "poem_id": 1475,
    "vorder": 62,
    "position": 1,
    "text": "نیم مرد گفتار و بند و فریب"
  },
  {
    "poem_id": 1475,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت سهراب کز مرد پیر"
  },
  {
    "poem_id": 1475,
    "vorder": 64,
    "position": 1,
    "text": "نباشد سخن زین نشان دلپذیر"
  },
  {
    "poem_id": 1475,
    "vorder": 65,
    "position": 0,
    "text": "مرا آرزو بد که در بسترت"
  },
  {
    "poem_id": 1475,
    "vorder": 66,
    "position": 1,
    "text": "برآید به هنگام هوش از برت"
  },
  {
    "poem_id": 1475,
    "vorder": 67,
    "position": 0,
    "text": "کسی کز تو ماند ستودان کند"
  },
  {
    "poem_id": 1475,
    "vorder": 68,
    "position": 1,
    "text": "بپرد روان تن به زندان کند"
  },
  {
    "poem_id": 1475,
    "vorder": 69,
    "position": 0,
    "text": "اگر هوش تو زیر دست منست"
  },
  {
    "poem_id": 1475,
    "vorder": 70,
    "position": 1,
    "text": "به فرمان یزدان بساییم دست"
  },
  {
    "poem_id": 1475,
    "vorder": 71,
    "position": 0,
    "text": "از اسپان جنگی فرود آمدند"
  },
  {
    "poem_id": 1475,
    "vorder": 72,
    "position": 1,
    "text": "هشیوار با گبر و خود آمدند"
  },
  {
    "poem_id": 1475,
    "vorder": 73,
    "position": 0,
    "text": "ببستند بر سنگ اسپ نبرد"
  },
  {
    "poem_id": 1475,
    "vorder": 74,
    "position": 1,
    "text": "برفتند هر دو روان پر ز گرد"
  },
  {
    "poem_id": 1475,
    "vorder": 75,
    "position": 0,
    "text": "بکشتی گرفتن برآویختند"
  },
  {
    "poem_id": 1475,
    "vorder": 76,
    "position": 1,
    "text": "ز تن خون و خوی را فرو ریختند"
  },
  {
    "poem_id": 1475,
    "vorder": 77,
    "position": 0,
    "text": "بزد دست سهراب چون پیل مست"
  },
  {
    "poem_id": 1475,
    "vorder": 78,
    "position": 1,
    "text": "برآوردش از جای و بنهاد پست"
  },
  {
    "poem_id": 1475,
    "vorder": 79,
    "position": 0,
    "text": "به کردار شیری که بر گور نر"
  },
  {
    "poem_id": 1475,
    "vorder": 80,
    "position": 1,
    "text": "زند چنگ و گور اندر آید به سر"
  },
  {
    "poem_id": 1475,
    "vorder": 81,
    "position": 0,
    "text": "نشست از بر سینهٔ پیلتن"
  },
  {
    "poem_id": 1475,
    "vorder": 82,
    "position": 1,
    "text": "پر از خاک چنگال و روی و دهن"
  },
  {
    "poem_id": 1475,
    "vorder": 83,
    "position": 0,
    "text": "یکی خنجری آبگون برکشید"
  },
  {
    "poem_id": 1475,
    "vorder": 84,
    "position": 1,
    "text": "همی‌خواست از تن سرش را برید"
  },
  {
    "poem_id": 1475,
    "vorder": 85,
    "position": 0,
    "text": "به سهراب گفت ای یل شیرگیر"
  },
  {
    "poem_id": 1475,
    "vorder": 86,
    "position": 1,
    "text": "کمندافگن و گرد و شمشیرگیر"
  },
  {
    "poem_id": 1475,
    "vorder": 87,
    "position": 0,
    "text": "دگرگونه‌تر باشد آیین ما"
  },
  {
    "poem_id": 1475,
    "vorder": 88,
    "position": 1,
    "text": "جزین باشد آرایش دین ما"
  },
  {
    "poem_id": 1475,
    "vorder": 89,
    "position": 0,
    "text": "کسی کاو بکشتی نبرد آورد"
  },
  {
    "poem_id": 1475,
    "vorder": 90,
    "position": 1,
    "text": "سر مهتری زیر گرد آورد"
  },
  {
    "poem_id": 1475,
    "vorder": 91,
    "position": 0,
    "text": "نخستین که پشتش نهد بر زمین"
  },
  {
    "poem_id": 1475,
    "vorder": 92,
    "position": 1,
    "text": "نبرد سرش گرچه باشد به کین"
  },
  {
    "poem_id": 1475,
    "vorder": 93,
    "position": 0,
    "text": "گرش بار دیگر به زیر آورد"
  },
  {
    "poem_id": 1475,
    "vorder": 94,
    "position": 1,
    "text": "ز افگندنش نام شیر آورد"
  },
  {
    "poem_id": 1475,
    "vorder": 95,
    "position": 0,
    "text": "بدان چاره از چنگ آن اژدها"
  },
  {
    "poem_id": 1475,
    "vorder": 96,
    "position": 1,
    "text": "همی‌خواست کاید ز کشتن رها"
  },
  {
    "poem_id": 1475,
    "vorder": 97,
    "position": 0,
    "text": "دلیر جوان سر به گفتار پیر"
  },
  {
    "poem_id": 1475,
    "vorder": 98,
    "position": 1,
    "text": "بداد و ببود این سخن دلپذیر"
  },
  {
    "poem_id": 1475,
    "vorder": 99,
    "position": 0,
    "text": "یکی از دلی و دوم از زمان"
  },
  {
    "poem_id": 1475,
    "vorder": 100,
    "position": 1,
    "text": "سوم از جوانمردیش بی‌گمان"
  },
  {
    "poem_id": 1475,
    "vorder": 101,
    "position": 0,
    "text": "رها کرد زو دست و آمد به دشت"
  },
  {
    "poem_id": 1475,
    "vorder": 102,
    "position": 1,
    "text": "چو شیری که بر پیش آهو گذشت"
  },
  {
    "poem_id": 1475,
    "vorder": 103,
    "position": 0,
    "text": "همی‌کرد نخچیر و یادش نبود"
  },
  {
    "poem_id": 1475,
    "vorder": 104,
    "position": 1,
    "text": "ازان کس که با او نبرد آزمود"
  },
  {
    "poem_id": 1475,
    "vorder": 105,
    "position": 0,
    "text": "همی دیر شد تا که هومان چو گرد"
  },
  {
    "poem_id": 1475,
    "vorder": 106,
    "position": 1,
    "text": "بیامد بپرسیدش از هم نبرد"
  },
  {
    "poem_id": 1475,
    "vorder": 107,
    "position": 0,
    "text": "به هومان بگفت آن کجا رفته بود"
  },
  {
    "poem_id": 1475,
    "vorder": 108,
    "position": 1,
    "text": "سخن هرچه رستم بدو گفته بود"
  },
  {
    "poem_id": 1475,
    "vorder": 109,
    "position": 0,
    "text": "بدو گفت هومان گرد ای جوان"
  },
  {
    "poem_id": 1475,
    "vorder": 110,
    "position": 1,
    "text": "به سیری رسیدی همانا ز جان"
  },
  {
    "poem_id": 1475,
    "vorder": 111,
    "position": 0,
    "text": "دریغ این بر و بازو و یال تو"
  },
  {
    "poem_id": 1475,
    "vorder": 112,
    "position": 1,
    "text": "میان یلی چنگ و گوپال تو"
  },
  {
    "poem_id": 1475,
    "vorder": 113,
    "position": 0,
    "text": "هژبری که آورده بودی بدام"
  },
  {
    "poem_id": 1475,
    "vorder": 114,
    "position": 1,
    "text": "رها کردی از دام و شد کار خام"
  },
  {
    "poem_id": 1475,
    "vorder": 115,
    "position": 0,
    "text": "نگه کن کزین بیهده کارکرد"
  },
  {
    "poem_id": 1475,
    "vorder": 116,
    "position": 1,
    "text": "چه آرد به پیشت به دیگر نبرد"
  },
  {
    "poem_id": 1475,
    "vorder": 117,
    "position": 0,
    "text": "بگفت و دل از جان او برگرفت"
  },
  {
    "poem_id": 1475,
    "vorder": 118,
    "position": 1,
    "text": "پرانده همی ماند ازو در شگفت"
  },
  {
    "poem_id": 1475,
    "vorder": 119,
    "position": 0,
    "text": "به لشکرگه خویش بنهاد روی"
  },
  {
    "poem_id": 1475,
    "vorder": 120,
    "position": 1,
    "text": "به خشم و دل از غم پر از کار اوی"
  },
  {
    "poem_id": 1475,
    "vorder": 121,
    "position": 0,
    "text": "یکی داستان زد برین شهریار"
  },
  {
    "poem_id": 1475,
    "vorder": 122,
    "position": 1,
    "text": "که دشمن مدار ارچه خردست خوار"
  },
  {
    "poem_id": 1475,
    "vorder": 123,
    "position": 0,
    "text": "چو رستم ز دست وی آزاد شد"
  },
  {
    "poem_id": 1475,
    "vorder": 124,
    "position": 1,
    "text": "بسان یکی تیغ پولاد شد"
  },
  {
    "poem_id": 1475,
    "vorder": 125,
    "position": 0,
    "text": "خرامان بشد سوی آب روان"
  },
  {
    "poem_id": 1475,
    "vorder": 126,
    "position": 1,
    "text": "چنان چون شده باز یابد روان"
  },
  {
    "poem_id": 1475,
    "vorder": 127,
    "position": 0,
