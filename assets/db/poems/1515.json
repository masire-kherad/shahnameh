[
  {
    "poem_id": 1515,
    "vorder": 1,
    "position": 0,
    "text": "همی بود گشتاسپ دل مستمند"
  },
  {
    "poem_id": 1515,
    "vorder": 2,
    "position": 1,
    "text": "خروشان و جوشان ز چرخ بلند"
  },
  {
    "poem_id": 1515,
    "vorder": 3,
    "position": 0,
    "text": "نیامد ز گیتیش جز زهر بهر"
  },
  {
    "poem_id": 1515,
    "vorder": 4,
    "position": 1,
    "text": "یکی روستا دید نزدیک شهر"
  },
  {
    "poem_id": 1515,
    "vorder": 5,
    "position": 0,
    "text": "درخت و گل و آبهای روان"
  },
  {
    "poem_id": 1515,
    "vorder": 6,
    "position": 1,
    "text": "نشستنگه شاد مرد جوان"
  },
  {
    "poem_id": 1515,
    "vorder": 7,
    "position": 0,
    "text": "درختی گشن سایه بر پیش آب"
  },
  {
    "poem_id": 1515,
    "vorder": 8,
    "position": 1,
    "text": "نهان گشته زو چشمهٔ آفتاب"
  },
  {
    "poem_id": 1515,
    "vorder": 9,
    "position": 0,
    "text": "بران سایه بنشست مرد جوان"
  },
  {
    "poem_id": 1515,
    "vorder": 10,
    "position": 1,
    "text": "پر از درد پیچان و تیره‌روان"
  },
  {
    "poem_id": 1515,
    "vorder": 11,
    "position": 0,
    "text": "همی گفت کای داور کردگار"
  },
  {
    "poem_id": 1515,
    "vorder": 12,
    "position": 1,
    "text": "غم آمد مرا بهره زین روزگار"
  },
  {
    "poem_id": 1515,
    "vorder": 13,
    "position": 0,
    "text": "نبینم همی اختر خویش بد"
  },
  {
    "poem_id": 1515,
    "vorder": 14,
    "position": 1,
    "text": "ندانم چرا بر سرم بد رسد"
  },
  {
    "poem_id": 1515,
    "vorder": 15,
    "position": 0,
    "text": "یکی نامور زان پسندیده ده"
  },
  {
    "poem_id": 1515,
    "vorder": 16,
    "position": 1,
    "text": "گذر کرد بر وی که او بود مه"
  },
  {
    "poem_id": 1515,
    "vorder": 17,
    "position": 0,
    "text": "ورا دید با دیدگان پر ز خون"
  },
  {
    "poem_id": 1515,
    "vorder": 18,
    "position": 1,
    "text": "به زیر زنخ دست کرده ستون"
  },
  {
    "poem_id": 1515,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت کای پاک مرد جوان"
  },
  {
    "poem_id": 1515,
    "vorder": 20,
    "position": 1,
    "text": "چرایی پر از درد و تیره‌روان"
  },
  {
    "poem_id": 1515,
    "vorder": 21,
    "position": 0,
    "text": "اگر آیدت رای ایوان من"
  },
  {
    "poem_id": 1515,
    "vorder": 22,
    "position": 1,
    "text": "بوی شاد یکچند مهمان من"
  },
  {
    "poem_id": 1515,
    "vorder": 23,
    "position": 0,
    "text": "مگر کین غمان بر دلت کم شود"
  },
  {
    "poem_id": 1515,
    "vorder": 24,
    "position": 1,
    "text": "سر تیر مژگانت بی نم شود"
  },
  {
    "poem_id": 1515,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت گشتاسپ کای نامجوی"
  },
  {
    "poem_id": 1515,
    "vorder": 26,
    "position": 1,
    "text": "نژاد تو از کیست با من بگوی"
  },
  {
    "poem_id": 1515,
    "vorder": 27,
    "position": 0,
    "text": "چنین داد پاسخ ورا کدخدای"
  },
  {
    "poem_id": 1515,
    "vorder": 28,
    "position": 1,
    "text": "کزین پرسش اکنون ترا چیست رای"
  },
  {
    "poem_id": 1515,
    "vorder": 29,
    "position": 0,
    "text": "من از تخم شاه آفریدون گرد"
  },
  {
    "poem_id": 1515,
    "vorder": 30,
    "position": 1,
    "text": "کزان تخمه کس در جهان نیست خرد"
  },
  {
    "poem_id": 1515,
    "vorder": 31,
    "position": 0,
    "text": "چو بشنید گشتاسپ برداشت پای"
  },
  {
    "poem_id": 1515,
    "vorder": 32,
    "position": 1,
    "text": "همی رفت با نامور کدخدای"
  },
  {
    "poem_id": 1515,
    "vorder": 33,
    "position": 0,
    "text": "چو آن مهتر آمد سوی خان خویش"
  },
  {
    "poem_id": 1515,
    "vorder": 34,
    "position": 1,
    "text": "به مهمان بیاراست ایوان خویش"
  },
  {
    "poem_id": 1515,
    "vorder": 35,
    "position": 0,
    "text": "بسان برادر همی داشتش"
  },
  {
    "poem_id": 1515,
    "vorder": 36,
    "position": 1,
    "text": "زمانی به ناکام نگذاشتش"
  },
  {
    "poem_id": 1515,
    "vorder": 37,
    "position": 0,
    "text": "زمانه برین نیز چندی بگشت"
  },
  {
    "poem_id": 1515,
    "vorder": 38,
    "position": 1,
    "text": "برین کار بر ماهیان برگذشت"
  }
]