[
  {
    "poem_id": 1419,
    "vorder": 1,
    "position": 0,
    "text": "شبی زال بنشست هنگام خواب"
  },
  {
    "poem_id": 1419,
    "vorder": 2,
    "position": 1,
    "text": "سخن گفت بسیار ز افراسیاب"
  },
  {
    "poem_id": 1419,
    "vorder": 3,
    "position": 0,
    "text": "هم از رزم‌زن نامداران خویش"
  },
  {
    "poem_id": 1419,
    "vorder": 4,
    "position": 1,
    "text": "وزان پهلوانان و یاران خویش"
  },
  {
    "poem_id": 1419,
    "vorder": 5,
    "position": 0,
    "text": "همی‌گفت هرچند کز پهلوان"
  },
  {
    "poem_id": 1419,
    "vorder": 6,
    "position": 1,
    "text": "بود بخت بیدار و روشن روان"
  },
  {
    "poem_id": 1419,
    "vorder": 7,
    "position": 0,
    "text": "بباید یکی شاه خسرو‌نژاد"
  },
  {
    "poem_id": 1419,
    "vorder": 8,
    "position": 1,
    "text": "که دارد گذشته سخن‌ها به‌یاد"
  },
  {
    "poem_id": 1419,
    "vorder": 9,
    "position": 0,
    "text": "به‌کردار کشتی‌ست کار سپاه"
  },
  {
    "poem_id": 1419,
    "vorder": 10,
    "position": 1,
    "text": "همش باد و هم بادبان تخت شاه"
  },
  {
    "poem_id": 1419,
    "vorder": 11,
    "position": 0,
    "text": "اگر داردی طوس و گستهم فر"
  },
  {
    "poem_id": 1419,
    "vorder": 12,
    "position": 1,
    "text": "سپاه است و گردان بسیار مر"
  },
  {
    "poem_id": 1419,
    "vorder": 13,
    "position": 0,
    "text": "نزیبد بر ایشان همی تاج و تخت"
  },
  {
    "poem_id": 1419,
    "vorder": 14,
    "position": 1,
    "text": "بباید یکی شاه بیداربخت"
  },
  {
    "poem_id": 1419,
    "vorder": 15,
    "position": 0,
    "text": "که باشد بدو فرهٔ ایزدی"
  },
  {
    "poem_id": 1419,
    "vorder": 16,
    "position": 1,
    "text": "بتابد ز دیهیم او بخردی"
  },
  {
    "poem_id": 1419,
    "vorder": 17,
    "position": 0,
    "text": "ز تخم فریدون بجُستند چند"
  },
  {
    "poem_id": 1419,
    "vorder": 18,
    "position": 1,
    "text": "یکی شاه، زیبای تخت بلند"
  },
  {
    "poem_id": 1419,
    "vorder": 19,
    "position": 0,
    "text": "ندیدند جز پور طهماسپ زو"
  },
  {
    "poem_id": 1419,
    "vorder": 20,
    "position": 1,
    "text": "که زور کیان داشت و فرهنگ گو"
  },
  {
    "poem_id": 1419,
    "vorder": 21,
    "position": 0,
    "text": "بشد قارن و موبد و مرزبان"
  },
  {
    "poem_id": 1419,
    "vorder": 22,
    "position": 1,
    "text": "سپاهی ز بامین و ز گرزبان"
  },
  {
    "poem_id": 1419,
    "vorder": 23,
    "position": 0,
    "text": "یکی مژده بردند نزدیک زو"
  },
  {
    "poem_id": 1419,
    "vorder": 24,
    "position": 1,
    "text": "که تاج فریدون به تو گشت نو"
  },
  {
    "poem_id": 1419,
    "vorder": 25,
    "position": 0,
    "text": "سپهدار دستان و یکسر سپاه"
  },
  {
    "poem_id": 1419,
    "vorder": 26,
    "position": 1,
    "text": "ترا خواستند ای سزاوار گاه"
  },
  {
    "poem_id": 1419,
    "vorder": 27,
    "position": 0,
    "text": "چو بشنید زو گفتهٔ موبدان"
  },
  {
    "poem_id": 1419,
    "vorder": 28,
    "position": 1,
    "text": "همان گفتهٔ قارن و بخردان"
  },
  {
    "poem_id": 1419,
    "vorder": 29,
    "position": 0,
    "text": "بیامد به نزدیک ایران سپاه"
  },
  {
    "poem_id": 1419,
    "vorder": 30,
    "position": 1,
    "text": "به سر بر نهاده کیانی کلاه"
  },
  {
    "poem_id": 1419,
    "vorder": 31,
    "position": 0,
    "text": "به‌شاهی بر او آفرین خواند زال"
  },
  {
    "poem_id": 1419,
    "vorder": 32,
    "position": 1,
    "text": "نشست از بر تخت زو پنج سال"
  },
  {
    "poem_id": 1419,
    "vorder": 33,
    "position": 0,
    "text": "کهن بود بر سال هشتاد مرد"
  },
  {
    "poem_id": 1419,
    "vorder": 34,
    "position": 1,
    "text": "به‌داد و به‌خوبی جهان تازه‌کرد"
  },
  {
    "poem_id": 1419,
    "vorder": 35,
    "position": 0,
    "text": "سپه را ز کار بدی باز داشت"
  },
  {
    "poem_id": 1419,
    "vorder": 36,
    "position": 1,
    "text": "که با پاک یزدان یکی راز داشت"
  },
  {
    "poem_id": 1419,
    "vorder": 37,
    "position": 0,
    "text": "گرفتن نیارست و بستن کسی"
  },
  {
    "poem_id": 1419,
    "vorder": 38,
    "position": 1,
    "text": "وزان پس ندیدند کشتن بسی"
  },
  {
    "poem_id": 1419,
    "vorder": 39,
    "position": 0,
    "text": "همان بد که تنگی بد اندر جهان"
  },
  {
    "poem_id": 1419,
    "vorder": 40,
    "position": 1,
    "text": "شده خشک خاک و گیا را دهان"
  },
  {
    "poem_id": 1419,
    "vorder": 41,
    "position": 0,
    "text": "نیامد همی ز آسمان هیچ نم"
  },
  {
    "poem_id": 1419,
    "vorder": 42,
    "position": 1,
    "text": "همی برکشیدند نان با درم"
  },
  {
    "poem_id": 1419,
    "vorder": 43,
    "position": 0,
    "text": "دو لشکر بران گونه تا هشت ماه"
  },
  {
    "poem_id": 1419,
    "vorder": 44,
    "position": 1,
    "text": "به روی اندر آورده روی سپاه"
  },
  {
    "poem_id": 1419,
    "vorder": 45,
    "position": 0,
    "text": "نکردند یک‌روز جنگی گران"
  },
  {
    "poem_id": 1419,
    "vorder": 46,
    "position": 1,
    "text": "نه روز یلان بود و رزم سران"
  },
  {
    "poem_id": 1419,
    "vorder": 47,
    "position": 0,
    "text": "ز تنگی چنان شد که چاره نماند"
  },
  {
    "poem_id": 1419,
    "vorder": 48,
    "position": 1,
    "text": "سپه را همی پود و تاره نماند"
  },
  {
    "poem_id": 1419,
    "vorder": 49,
    "position": 0,
    "text": "سخن رفتشان یک به‌یک هم‌زبان"
  },
  {
    "poem_id": 1419,
    "vorder": 50,
    "position": 1,
    "text": "که از ماست بر ما بد آسمان"
  },
  {
    "poem_id": 1419,
    "vorder": 51,
    "position": 0,
    "text": "ز هر دو سپه خاست فریاد و غَو"
  },
  {
    "poem_id": 1419,
    "vorder": 52,
    "position": 1,
    "text": "فرستاده آمد به نزدیک زو"
  },
  {
    "poem_id": 1419,
    "vorder": 53,
    "position": 0,
    "text": "که گر بهر ما زین سرای سپنج"
  },
  {
    "poem_id": 1419,
    "vorder": 54,
    "position": 1,
    "text": "نیامد به جز درد و اندوه و رنج"
  },
  {
    "poem_id": 1419,
    "vorder": 55,
    "position": 0,
    "text": "بیا تا ببخشیم روی زمین"
  },
  {
    "poem_id": 1419,
    "vorder": 56,
    "position": 1,
    "text": "سراییم یک با دگر آفرین"
  },
  {
    "poem_id": 1419,
    "vorder": 57,
    "position": 0,
    "text": "سر نامداران تهی شد ز جنگ"
  },
  {
    "poem_id": 1419,
    "vorder": 58,
    "position": 1,
    "text": "ز تنگی نبد روزگار درنگ"
  },
  {
    "poem_id": 1419,
    "vorder": 59,
    "position": 0,
    "text": "بر آن برنهادند هر دو سخن"
  },
  {
    "poem_id": 1419,
    "vorder": 60,
    "position": 1,
    "text": "که در دل ندارند کین کهن"
  },
  {
    "poem_id": 1419,
    "vorder": 61,
    "position": 0,
    "text": "ببخشند گیتی به رسم و به داد"
  },
  {
    "poem_id": 1419,
    "vorder": 62,
    "position": 1,
    "text": "ز کار گذشته نیارند یاد"
  },
  {
    "poem_id": 1419,
    "vorder": 63,
    "position": 0,
    "text": "ز دریای پیکند تا مرز تور"
  },
  {
    "poem_id": 1419,
    "vorder": 64,
    "position": 1,
    "text": "ازان بخش گیتی ز نزدیک و دور"
  },
  {
    "poem_id": 1419,
    "vorder": 65,
    "position": 0,
    "text": "روارو چنین تا به چین و ختن"
  },
  {
    "poem_id": 1419,
    "vorder": 66,
    "position": 1,
    "text": "سپردند شاهی بران انجمن"
  },
  {
    "poem_id": 1419,
    "vorder": 67,
    "position": 0,
    "text": "ز مرزی کجا مرز خرگاه بود"
  },
  {
    "poem_id": 1419,
    "vorder": 68,
    "position": 1,
    "text": "ازو زال را دست کوتاه بود"
  },
  {
    "poem_id": 1419,
    "vorder": 69,
    "position": 0,
    "text": "وزین روی ترکان نجویند راه"
  },
  {
    "poem_id": 1419,
    "vorder": 70,
    "position": 1,
    "text": "چنین بخش کردند تخت و کلاه"
  },
  {
    "poem_id": 1419,
    "vorder": 71,
    "position": 0,
    "text": "سوی پارس لشکر برون راند زو"
  },
  {
    "poem_id": 1419,
    "vorder": 72,
    "position": 1,
    "text": "کهن بود لیکن جهان کرد نو"
  },
  {
    "poem_id": 1419,
    "vorder": 73,
    "position": 0,
    "text": "سوی زابلستان بشد زال زر"
  },
  {
    "poem_id": 1419,
    "vorder": 74,
    "position": 1,
    "text": "جهانی گرفتند هر یک به بر"
  },
  {
    "poem_id": 1419,
    "vorder": 75,
    "position": 0,
    "text": "پر از غلغل و رعد شد کوهسار"
  },
  {
    "poem_id": 1419,
    "vorder": 76,
    "position": 1,
    "text": "زمین شد پر از رنگ و بوی و نگار"
  },
  {
    "poem_id": 1419,
    "vorder": 77,
    "position": 0,
    "text": "جهان چون عروسی رسیده جوان"
  },
  {
    "poem_id": 1419,
    "vorder": 78,
    "position": 1,
    "text": "پر از چشمه و باغ و آب روان"
  },
  {
    "poem_id": 1419,
    "vorder": 79,
    "position": 0,
    "text": "چو مردم بدارد نهاد پلنگ"
  },
  {
    "poem_id": 1419,
    "vorder": 80,
    "position": 1,
    "text": "بگردد زمانه بر او تار و تنگ"
  },
  {
    "poem_id": 1419,
    "vorder": 81,
    "position": 0,
    "text": "مهان را همه انجمن کرد زو"
  },
  {
    "poem_id": 1419,
    "vorder": 82,
    "position": 1,
    "text": "به دادار بر آفرین خواند نو"
  },
  {
    "poem_id": 1419,
    "vorder": 83,
    "position": 0,
    "text": "فراخی که آمد ز تنگی پدید"
  },
  {
    "poem_id": 1419,
    "vorder": 84,
    "position": 1,
    "text": "جهان آفرین داشت آن را کلید"
  },
  {
    "poem_id": 1419,
    "vorder": 85,
    "position": 0,
    "text": "به هر سو یکی جشن‌گه ساختند"
  },
  {
    "poem_id": 1419,
    "vorder": 86,
    "position": 1,
    "text": "دل از کین و نفرین بپرداختند"
  },
  {
    "poem_id": 1419,
    "vorder": 87,
    "position": 0,
    "text": "چنین تا برآمد برین سال پنج"
  },
  {
    "poem_id": 1419,
    "vorder": 88,
    "position": 1,
    "text": "نبودند آگه کس از درد و رنج"
  },
  {
    "poem_id": 1419,
    "vorder": 89,
    "position": 0,
    "text": "ببد بخت ایرانیان کندرو"
  },
  {
    "poem_id": 1419,
    "vorder": 90,
    "position": 1,
    "text": "شد آن دادگستر جهاندار زو"
  }
]