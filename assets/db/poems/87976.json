[
  {
    "poem_id": 87976,
    "vorder": 1,
    "position": 0,
    "text": "چو آمد سر ماه هنگام جنگ"
  },
  {
    "poem_id": 87976,
    "vorder": 2,
    "position": 1,
    "text": "ز پیمان بگشتند و از نام و ننگ"
  },
  {
    "poem_id": 87976,
    "vorder": 3,
    "position": 0,
    "text": "خروشی برآمد ز هر دو سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 4,
    "position": 1,
    "text": "برفتند یکسر سوی رزمگاه"
  },
  {
    "poem_id": 87976,
    "vorder": 5,
    "position": 0,
    "text": "ز بس ناله بوق و هندی درای"
  },
  {
    "poem_id": 87976,
    "vorder": 6,
    "position": 1,
    "text": "همی آسمان اندر آمد ز جای"
  },
  {
    "poem_id": 87976,
    "vorder": 7,
    "position": 0,
    "text": "هم از یال اسپان و دست و عنان"
  },
  {
    "poem_id": 87976,
    "vorder": 8,
    "position": 1,
    "text": "ز گوپال و تیغ و کمان و سنان"
  },
  {
    "poem_id": 87976,
    "vorder": 9,
    "position": 0,
    "text": "تو گفتی جهان دام نر اژدهاست"
  },
  {
    "poem_id": 87976,
    "vorder": 10,
    "position": 1,
    "text": "وگر آسمان بر زمین گشت راست"
  },
  {
    "poem_id": 87976,
    "vorder": 11,
    "position": 0,
    "text": "نبد پشه را روزگار گذر"
  },
  {
    "poem_id": 87976,
    "vorder": 12,
    "position": 1,
    "text": "ز بس گرز و تیغ و سنان و سپر"
  },
  {
    "poem_id": 87976,
    "vorder": 13,
    "position": 0,
    "text": "سوی میمنه گیو گودرز بود"
  },
  {
    "poem_id": 87976,
    "vorder": 14,
    "position": 1,
    "text": "رد و موبد و مهتر مرز بود"
  },
  {
    "poem_id": 87976,
    "vorder": 15,
    "position": 0,
    "text": "سوی میسره اشکش تیزچنگ"
  },
  {
    "poem_id": 87976,
    "vorder": 16,
    "position": 1,
    "text": "که دریای خون راند هنگام جنگ"
  },
  {
    "poem_id": 87976,
    "vorder": 17,
    "position": 0,
    "text": "یلان با فریبرز کاوس شاه"
  },
  {
    "poem_id": 87976,
    "vorder": 18,
    "position": 1,
    "text": "درفش از پس پشت در قلبگاه"
  },
  {
    "poem_id": 87976,
    "vorder": 19,
    "position": 0,
    "text": "فریبرز با لشکر خویش گفت"
  },
  {
    "poem_id": 87976,
    "vorder": 20,
    "position": 1,
    "text": "که ما را هنرها شد اندر نهفت"
  },
  {
    "poem_id": 87976,
    "vorder": 21,
    "position": 0,
    "text": "یک امروز چون شیر جنگ آوریم"
  },
  {
    "poem_id": 87976,
    "vorder": 22,
    "position": 1,
    "text": "جهان بر بداندیش تنگ آوریم"
  },
  {
    "poem_id": 87976,
    "vorder": 23,
    "position": 0,
    "text": "کزین ننگ تا جاودان بر سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 24,
    "position": 1,
    "text": "بخندد همی گرز و رومی کلاه"
  },
  {
    "poem_id": 87976,
    "vorder": 25,
    "position": 0,
    "text": "یکی تیرباران بکردند سخت"
  },
  {
    "poem_id": 87976,
    "vorder": 26,
    "position": 1,
    "text": "چو باد خزانی که ریزد درخت"
  },
  {
    "poem_id": 87976,
    "vorder": 27,
    "position": 0,
    "text": "تو گفتی هوا پر کرگس شدست"
  },
  {
    "poem_id": 87976,
    "vorder": 28,
    "position": 1,
    "text": "زمین از پی پیل پامس شدست"
  },
  {
    "poem_id": 87976,
    "vorder": 29,
    "position": 0,
    "text": "نبد بر هوا مرغ را جایگاه"
  },
  {
    "poem_id": 87976,
    "vorder": 30,
    "position": 1,
    "text": "ز تیر و ز گرز و ز گرد سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 31,
    "position": 0,
    "text": "درفشیدن تیغ الماس گون"
  },
  {
    "poem_id": 87976,
    "vorder": 32,
    "position": 1,
    "text": "بکردار آتش بگرد اندرون"
  },
  {
    "poem_id": 87976,
    "vorder": 33,
    "position": 0,
    "text": "تو گفتی زمین روی زنگی شدست"
  },
  {
    "poem_id": 87976,
    "vorder": 34,
    "position": 1,
    "text": "ستاره دل پیل جنگی شدست"
  },
  {
    "poem_id": 87976,
    "vorder": 35,
    "position": 0,
    "text": "ز بس نیزه و گرز و شمشیر تیز"
  },
  {
    "poem_id": 87976,
    "vorder": 36,
    "position": 1,
    "text": "برآمد همی از جهان رستخیز"
  },
  {
    "poem_id": 87976,
    "vorder": 37,
    "position": 0,
    "text": "ز قلب سپه گیو شد پیش صف"
  },
  {
    "poem_id": 87976,
    "vorder": 38,
    "position": 1,
    "text": "خروشان و بر لب برآورده کف"
  },
  {
    "poem_id": 87976,
    "vorder": 39,
    "position": 0,
    "text": "ابا نامداران گودرزیان"
  },
  {
    "poem_id": 87976,
    "vorder": 40,
    "position": 1,
    "text": "کزیشان بدی راه سود و زیان"
  },
  {
    "poem_id": 87976,
    "vorder": 41,
    "position": 0,
    "text": "بتیغ و بنیزه برآویختند"
  },
  {
    "poem_id": 87976,
    "vorder": 42,
    "position": 1,
    "text": "همی ز آهن آتش فرو ریختند"
  },
  {
    "poem_id": 87976,
    "vorder": 43,
    "position": 0,
    "text": "چو شد رزم گودرز و پیران درشت"
  },
  {
    "poem_id": 87976,
    "vorder": 44,
    "position": 1,
    "text": "چو نهصد تن از تخم پیران بکشت"
  },
  {
    "poem_id": 87976,
    "vorder": 45,
    "position": 0,
    "text": "چو دیدند لهاک و فرشیدورد"
  },
  {
    "poem_id": 87976,
    "vorder": 46,
    "position": 1,
    "text": "کزان لشکر گشن برخاست گرد"
  },
  {
    "poem_id": 87976,
    "vorder": 47,
    "position": 0,
    "text": "یکی حمله بردند برسوی گیو"
  },
  {
    "poem_id": 87976,
    "vorder": 48,
    "position": 1,
    "text": "بران گرزداران و شیران نیو"
  },
  {
    "poem_id": 87976,
    "vorder": 49,
    "position": 0,
    "text": "ببارید تیر از کمان سران"
  },
  {
    "poem_id": 87976,
    "vorder": 50,
    "position": 1,
    "text": "بران نامداران جوشن‌وران"
  },
  {
    "poem_id": 87976,
    "vorder": 51,
    "position": 0,
    "text": "چنان شد که کس روی کشور ندید"
  },
  {
    "poem_id": 87976,
    "vorder": 52,
    "position": 1,
    "text": "ز بس کشتگان شد زمین ناپدید"
  },
  {
    "poem_id": 87976,
    "vorder": 53,
    "position": 0,
    "text": "یکی پشت بر دیگری برنگاشت"
  },
  {
    "poem_id": 87976,
    "vorder": 54,
    "position": 1,
    "text": "نه بگذاشت آن جایگه را که داشت"
  },
  {
    "poem_id": 87976,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت هومان به فرشیدورد"
  },
  {
    "poem_id": 87976,
    "vorder": 56,
    "position": 1,
    "text": "که با قلبگه جست باید نبرد"
  },
  {
    "poem_id": 87976,
    "vorder": 57,
    "position": 0,
    "text": "فریبرز باید کزان قلبگاه"
  },
  {
    "poem_id": 87976,
    "vorder": 58,
    "position": 1,
    "text": "گریزان بیاید ز پشت سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 59,
    "position": 0,
    "text": "پس آسان بود جنگ با میمنه"
  },
  {
    "poem_id": 87976,
    "vorder": 60,
    "position": 1,
    "text": "بچنگ آید آن رزمگاه و بنه"
  },
  {
    "poem_id": 87976,
    "vorder": 61,
    "position": 0,
    "text": "برفتند پس تا بقلب سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 62,
    "position": 1,
    "text": "بجنگ فریبرز کاوس شاه"
  },
  {
    "poem_id": 87976,
    "vorder": 63,
    "position": 0,
    "text": "ز هومان گریزان بشد پهلوان"
  },
  {
    "poem_id": 87976,
    "vorder": 64,
    "position": 1,
    "text": "شکست اندر آمد برزم گوان"
  },
  {
    "poem_id": 87976,
    "vorder": 65,
    "position": 0,
    "text": "بدادند گردنکشان جای خویش"
  },
  {
    "poem_id": 87976,
    "vorder": 66,
    "position": 1,
    "text": "نبودند گستاخ با رای خویش"
  },
  {
    "poem_id": 87976,
    "vorder": 67,
    "position": 0,
    "text": "یکایک بدشمن سپردند جای"
  },
  {
    "poem_id": 87976,
    "vorder": 68,
    "position": 1,
    "text": "ز گردان ایران نبد کس بپای"
  },
  {
    "poem_id": 87976,
    "vorder": 69,
    "position": 0,
    "text": "بماندند بر جای کوس و درفش"
  },
  {
    "poem_id": 87976,
    "vorder": 70,
    "position": 1,
    "text": "ز پیکارشان دیده‌ها شد بنفش"
  },
  {
    "poem_id": 87976,
    "vorder": 71,
    "position": 0,
    "text": "دلیران بدشمن نمودند پشت"
  },
  {
    "poem_id": 87976,
    "vorder": 72,
    "position": 1,
    "text": "ازان کارزار انده آمد بمشت"
  },
  {
    "poem_id": 87976,
    "vorder": 73,
    "position": 0,
    "text": "نگون گشته کوس و درفش و سنان"
  },
  {
    "poem_id": 87976,
    "vorder": 74,
    "position": 1,
    "text": "نبود ایچ پیدا رکیب از عنان"
  },
  {
    "poem_id": 87976,
    "vorder": 75,
    "position": 0,
    "text": "چو دشمن ز هر سو بانبوه شد"
  },
  {
    "poem_id": 87976,
    "vorder": 76,
    "position": 1,
    "text": "فریبرز بر دامن کوه شد"
  },
  {
    "poem_id": 87976,
    "vorder": 77,
    "position": 0,
    "text": "برفتند ز ایرانیان هرک زیست"
  },
  {
    "poem_id": 87976,
    "vorder": 78,
    "position": 1,
    "text": "بران زندگانی بباید گریست"
  },
  {
    "poem_id": 87976,
    "vorder": 79,
    "position": 0,
    "text": "همی بود بر جای گودرز و گیو"
  },
  {
    "poem_id": 87976,
    "vorder": 80,
    "position": 1,
    "text": "ز لشکر بسی نامبردار نیو"
  },
  {
    "poem_id": 87976,
    "vorder": 81,
    "position": 0,
    "text": "چو گودرز کشواد بر قلبگاه"
  },
  {
    "poem_id": 87976,
    "vorder": 82,
    "position": 1,
    "text": "درفش فریبرز کاوس شاه"
  },
  {
    "poem_id": 87976,
    "vorder": 83,
    "position": 0,
    "text": "ندید و یلان سپه را ندید"
  },
  {
    "poem_id": 87976,
    "vorder": 84,
    "position": 1,
    "text": "بکردار آتش دلش بردمید"
  },
  {
    "poem_id": 87976,
    "vorder": 85,
    "position": 0,
    "text": "عنان کرد پیچان براه گریز"
  },
  {
    "poem_id": 87976,
    "vorder": 86,
    "position": 1,
    "text": "برآمد ز گودرزیان رستخیز"
  },
  {
    "poem_id": 87976,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت گیو ای سپهدار پیر"
  },
  {
    "poem_id": 87976,
    "vorder": 88,
    "position": 1,
    "text": "بسی دیده‌ای گرز و گوپال و تیر"
  },
  {
    "poem_id": 87976,
    "vorder": 89,
    "position": 0,
    "text": "اگر تو ز پیران بخواهی گریخت"
  },
  {
    "poem_id": 87976,
    "vorder": 90,
    "position": 1,
    "text": "بباید بسر بر مرا خاک ریخت"
  },
  {
    "poem_id": 87976,
    "vorder": 91,
    "position": 0,
    "text": "نماند کسی زنده اندر جهان"
  },
  {
    "poem_id": 87976,
    "vorder": 92,
    "position": 1,
    "text": "دلیران و کارآزموده مهان"
  },
  {
    "poem_id": 87976,
    "vorder": 93,
    "position": 0,
    "text": "ز مردن مرا و ترا چاره نیست"
  },
  {
    "poem_id": 87976,
    "vorder": 94,
    "position": 1,
    "text": "درنگی تر از مرگ پتیاره نیست"
  },
  {
    "poem_id": 87976,
    "vorder": 95,
    "position": 0,
    "text": "چو پیش آمد این روزگار درشت"
  },
  {
    "poem_id": 87976,
    "vorder": 96,
    "position": 1,
    "text": "ترا روی بینند بهتر که پشت"
  },
  {
    "poem_id": 87976,
    "vorder": 97,
    "position": 0,
    "text": "بپیچیم زین جایگه سوی جنگ"
  },
  {
    "poem_id": 87976,
    "vorder": 98,
    "position": 1,
    "text": "نیاریم بر خاک کشواد ننگ"
  },
  {
    "poem_id": 87976,
    "vorder": 99,
    "position": 0,
    "text": "ز دانا تو نشنیدی آن داستان"
  },
  {
    "poem_id": 87976,
    "vorder": 100,
    "position": 1,
    "text": "که برگوید از گفتهٔ باستان"
  },
  {
    "poem_id": 87976,
    "vorder": 101,
    "position": 0,
    "text": "که گر دو برادر نهد پشت پشت"
  },
  {
    "poem_id": 87976,
    "vorder": 102,
    "position": 1,
    "text": "تن کوه را سنگ ماند بمشت"
  },
  {
    "poem_id": 87976,
    "vorder": 103,
    "position": 0,
    "text": "تو باشی و هفتاد جنگی پسر"
  },
  {
    "poem_id": 87976,
    "vorder": 104,
    "position": 1,
    "text": "ز دوده ستوده بسی نامور"
  },
  {
    "poem_id": 87976,
    "vorder": 105,
    "position": 0,
    "text": "بخنجر دل دشمنان بشکنیم"
  },
  {
    "poem_id": 87976,
    "vorder": 106,
    "position": 1,
    "text": "وگر کوه باشد ز بن برکنیم"
  },
  {
    "poem_id": 87976,
    "vorder": 107,
    "position": 0,
    "text": "چو گودرز بشنید گفتار گیو"
  },
  {
    "poem_id": 87976,
    "vorder": 108,
    "position": 1,
    "text": "بدید آن سر و ترگ بیدار نیو"
  },
  {
    "poem_id": 87976,
    "vorder": 109,
    "position": 0,
    "text": "پشیمان شد از دانش و رای خویش"
  },
  {
    "poem_id": 87976,
    "vorder": 110,
    "position": 1,
    "text": "بیفشارد بر جایگه پای خویش"
  },
  {
    "poem_id": 87976,
    "vorder": 111,
    "position": 0,
    "text": "گرازه برون آمد و گستهم"
  },
  {
    "poem_id": 87976,
    "vorder": 112,
    "position": 1,
    "text": "ابا برته و زنگهٔ یل بهم"
  },
  {
    "poem_id": 87976,
    "vorder": 113,
    "position": 0,
    "text": "بخوردند سوگندهای گران"
  },
  {
    "poem_id": 87976,
    "vorder": 114,
    "position": 1,
    "text": "که پیمان شکستن نبود اندران"
  },
  {
    "poem_id": 87976,
    "vorder": 115,
    "position": 0,
    "text": "کزین رزمگه برنتابیم روی"
  },
  {
    "poem_id": 87976,
    "vorder": 116,
    "position": 1,
    "text": "گر از گرز خون اندر آید بجوی"
  },
  {
    "poem_id": 87976,
    "vorder": 117,
    "position": 0,
    "text": "وزان جایگه ران بیفشاردند"
  },
  {
    "poem_id": 87976,
    "vorder": 118,
    "position": 1,
    "text": "برزم اندرون گرز بگذاردند"
  },
  {
    "poem_id": 87976,
    "vorder": 119,
    "position": 0,
    "text": "ز هر سو سپه بیکران کشته شد"
  },
  {
    "poem_id": 87976,
    "vorder": 120,
    "position": 1,
    "text": "زمانه همی بر بدی گشته شد"
  },
  {
    "poem_id": 87976,
    "vorder": 121,
    "position": 0,
    "text": "به بیژن چنین گفت گودرز پیر"
  },
  {
    "poem_id": 87976,
    "vorder": 122,
    "position": 1,
    "text": "کز ایدر برو زود برسان تیر"
  },
  {
    "poem_id": 87976,
    "vorder": 123,
    "position": 0,
    "text": "بسوی فریبرز برکش عنان"
  },
  {
    "poem_id": 87976,
    "vorder": 124,
    "position": 1,
    "text": "بپیش من آر اختر کاویان"
  },
  {
    "poem_id": 87976,
    "vorder": 125,
    "position": 0,
    "text": "مگر خود فریبرز با آن درفش"
  },
  {
    "poem_id": 87976,
    "vorder": 126,
    "position": 1,
    "text": "بیاید کند روی دشمن بنفش"
  },
  {
    "poem_id": 87976,
    "vorder": 127,
    "position": 0,
    "text": "چو بشنید بیژن برانگیخت اسپ"
  },
  {
    "poem_id": 87976,
    "vorder": 128,
    "position": 1,
    "text": "بیامد بکردار آذرگشسپ"
  },
  {
    "poem_id": 87976,
    "vorder": 129,
    "position": 0,
    "text": "بنزد فریبرز و با او بگفت"
  },
  {
    "poem_id": 87976,
    "vorder": 130,
    "position": 1,
    "text": "که ایدر چه داری سپه در نهفت"
  },
  {
    "poem_id": 87976,
    "vorder": 131,
    "position": 0,
    "text": "عنان را چو گردان یکی برگرای"
  },
  {
    "poem_id": 87976,
    "vorder": 132,
    "position": 1,
    "text": "برین کوه سر بر فزون زین مپای"
  },
  {
    "poem_id": 87976,
    "vorder": 133,
    "position": 0,
    "text": "اگر تو نیایی مرا ده درفش"
  },
  {
    "poem_id": 87976,
    "vorder": 134,
    "position": 1,
    "text": "سواران و این تیغهای بنفش"
  },
  {
    "poem_id": 87976,
    "vorder": 135,
    "position": 0,
    "text": "چو بیژن سخن با فریبرز گفت"
  },
  {
    "poem_id": 87976,
    "vorder": 136,
    "position": 1,
    "text": "نکرد او خرد با دل خویش جفت"
  },
  {
    "poem_id": 87976,
    "vorder": 137,
    "position": 0,
    "text": "یکی بانگ برزد به بیژن که رو"
  },
  {
    "poem_id": 87976,
    "vorder": 138,
    "position": 1,
    "text": "که در کار تندی و در جنگ نو"
  },
  {
    "poem_id": 87976,
    "vorder": 139,
    "position": 0,
    "text": "مرا شاه داد این درفش و سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 140,
    "position": 1,
    "text": "همین پهلوانی و تخت و کلاه"
  },
  {
    "poem_id": 87976,
    "vorder": 141,
    "position": 0,
    "text": "درفش از در بیژن گیو نیست"
  },
  {
    "poem_id": 87976,
    "vorder": 142,
    "position": 1,
    "text": "نه اندر جهان سربسر نیو نیست"
  },
  {
    "poem_id": 87976,
    "vorder": 143,
    "position": 0,
    "text": "یکی تیغ بگرفت بیژن بنفش"
  },
  {
    "poem_id": 87976,
    "vorder": 144,
    "position": 1,
    "text": "بزد ناگهان بر میان درفش"
  },
  {
    "poem_id": 87976,
    "vorder": 145,
    "position": 0,
    "text": "بدو نیمه کرد اختر کاویان"
  },
  {
    "poem_id": 87976,
    "vorder": 146,
    "position": 1,
    "text": "یکی نیمه برداشت گرد از میان"
  },
  {
    "poem_id": 87976,
    "vorder": 147,
    "position": 0,
    "text": "بیامد که آرد بنزد سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 148,
    "position": 1,
    "text": "چو ترکان بدیدند اختر براه"
  },
  {
    "poem_id": 87976,
    "vorder": 149,
    "position": 0,
    "text": "یکی شیردل لشکری جنگجوی"
  },
  {
    "poem_id": 87976,
    "vorder": 150,
    "position": 1,
    "text": "همه سوی بیژن نهادند روی"
  },
  {
    "poem_id": 87976,
    "vorder": 151,
    "position": 0,
    "text": "کشیدند گوپال و تیغ بنفش"
  },
  {
    "poem_id": 87976,
    "vorder": 152,
    "position": 1,
    "text": "به پیکار آن کاویانی درفش"
  },
  {
    "poem_id": 87976,
    "vorder": 153,
    "position": 0,
    "text": "چنین گفت هومان که آن اخترست"
  },
  {
    "poem_id": 87976,
    "vorder": 154,
    "position": 1,
    "text": "که نیروی ایران بدو اندر است"
  },
  {
    "poem_id": 87976,
    "vorder": 155,
    "position": 0,
    "text": "درفش بنفش ار بچنگ آوریم"
  },
  {
    "poem_id": 87976,
    "vorder": 156,
    "position": 1,
    "text": "جهان جمله بر شاه تنگ آوریم"
  },
  {
    "poem_id": 87976,
    "vorder": 157,
    "position": 0,
    "text": "کمان را بزه کرد بیژن چو گرد"
  },
  {
    "poem_id": 87976,
    "vorder": 158,
    "position": 1,
    "text": "بریشان یکی تیرباران بکرد"
  },
  {
    "poem_id": 87976,
    "vorder": 159,
    "position": 0,
    "text": "سپه یکسر از تیر او دور شد"
  },
  {
    "poem_id": 87976,
    "vorder": 160,
    "position": 1,
    "text": "همی گرگ درنده را سور شد"
  },
  {
    "poem_id": 87976,
    "vorder": 161,
    "position": 0,
    "text": "بگفتند با گیو و با گستهم"
  },
  {
    "poem_id": 87976,
    "vorder": 162,
    "position": 1,
    "text": "سواران که بودند با او بهم"
  },
  {
    "poem_id": 87976,
    "vorder": 163,
    "position": 0,
    "text": "که مان رفت باید بتوران سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 164,
    "position": 1,
    "text": "ربودن ازیشان همی تاج و گاه"
  },
  {
    "poem_id": 87976,
    "vorder": 165,
    "position": 0,
    "text": "ز گردان ایران دلاور سران"
  },
  {
    "poem_id": 87976,
    "vorder": 166,
    "position": 1,
    "text": "برفتند بسیار نیزه‌وران"
  },
  {
    "poem_id": 87976,
    "vorder": 167,
    "position": 0,
    "text": "بکشتند زیشان فراوان سوار"
  },
  {
    "poem_id": 87976,
    "vorder": 168,
    "position": 1,
    "text": "بیامد ز ره بیژن نامدار"
  },
  {
    "poem_id": 87976,
    "vorder": 169,
    "position": 0,
    "text": "سپاه اندر آمد بگرد درفش"
  },
  {
    "poem_id": 87976,
    "vorder": 170,
    "position": 1,
    "text": "هوا شد ز گرد سواران بنفش"
  },
  {
    "poem_id": 87976,
    "vorder": 171,
    "position": 0,
    "text": "دگر باره از جای برخاستند"
  },
  {
    "poem_id": 87976,
    "vorder": 172,
    "position": 1,
    "text": "بران دشت رزمی نو آراستند"
  },
  {
    "poem_id": 87976,
    "vorder": 173,
    "position": 0,
    "text": "به پیش سپه کشته شد ریونیز"
  },
  {
    "poem_id": 87976,
    "vorder": 174,
    "position": 1,
    "text": "که کاوس را بد چو جان عزیز"
  },
  {
    "poem_id": 87976,
    "vorder": 175,
    "position": 0,
    "text": "یکی تاجور شاه کهتر پسر"
  },
  {
    "poem_id": 87976,
    "vorder": 176,
    "position": 1,
    "text": "نیاز فریبرز و جان پدر"
  },
  {
    "poem_id": 87976,
    "vorder": 177,
    "position": 0,
    "text": "سر و تاج او اندر آمد بخاک"
  },
  {
    "poem_id": 87976,
    "vorder": 178,
    "position": 1,
    "text": "بسی نامور جامه کردند چاک"
  },
  {
    "poem_id": 87976,
    "vorder": 179,
    "position": 0,
    "text": "ازان پس خروشی برآورد گیو"
  },
  {
    "poem_id": 87976,
    "vorder": 180,
    "position": 1,
    "text": "که ای نامداران و گردان نیو"
  },
  {
    "poem_id": 87976,
    "vorder": 181,
    "position": 0,
    "text": "چنویی نبود اندرین رزمگاه"
  },
  {
    "poem_id": 87976,
    "vorder": 182,
    "position": 1,
    "text": "جوان و سرافراز و فرزند شاه"
  },
  {
    "poem_id": 87976,
    "vorder": 183,
    "position": 0,
    "text": "نبیره جهاندار کاوس پیر"
  },
  {
    "poem_id": 87976,
    "vorder": 184,
    "position": 1,
    "text": "سه تن کشته شد زار بر خیره خیر"
  },
  {
    "poem_id": 87976,
    "vorder": 185,
    "position": 0,
    "text": "فرود سیاوش چون ریونیز"
  },
  {
    "poem_id": 87976,
    "vorder": 186,
    "position": 1,
    "text": "بگیتی فزون زین شگفتی چه چیز"
  },
  {
    "poem_id": 87976,
    "vorder": 187,
    "position": 0,
    "text": "اگر تاج آن نارسیده جوان"
  },
  {
    "poem_id": 87976,
    "vorder": 188,
    "position": 1,
    "text": "بدشمن رسد شرم دارد روان"
  },
  {
    "poem_id": 87976,
    "vorder": 189,
    "position": 0,
    "text": "اگر من بجنبم ازین رزمگاه"
  },
  {
    "poem_id": 87976,
    "vorder": 190,
    "position": 1,
    "text": "شکست اندر آید بایران سپاه"
  },
  {
    "poem_id": 87976,
    "vorder": 191,
    "position": 0,
    "text": "نباید که آن افسر شهریار"
  },
  {
    "poem_id": 87976,
    "vorder": 192,
    "position": 1,
    "text": "بترکان رسد در صف کارزار"
  },
  {
    "poem_id": 87976,
    "vorder": 193,
    "position": 0,
    "text": "فزاید بر این ننگها ننگ نیز"
  },
  {
    "poem_id": 87976,
    "vorder": 194,
    "position": 1,
    "text": "ازین افسر و کشتن ریو نیز"
  },
  {
    "poem_id": 87976,
    "vorder": 195,
    "position": 0,
    "text": "چنان بد که بشنید آواز گیو"
  },
  {
    "poem_id": 87976,
    "vorder": 196,
    "position": 1,
    "text": "سپهبد سرافراز پیران نیو"
  },
  {
    "poem_id": 87976,
    "vorder": 197,
    "position": 0,
    "text": "برامد بنوی یکی کارزار"
  },
  {
    "poem_id": 87976,
    "vorder": 198,
    "position": 1,
    "text": "ز لشکر بران افسر نامدار"
  },
  {
    "poem_id": 87976,
    "vorder": 199,
    "position": 0,
    "text": "فراوان ز هر سو سپه کشته شد"
  },
  {
    "poem_id": 87976,
    "vorder": 200,
    "position": 1,
    "text": "سربخت گردنکشان گشته شد"
  },
  {
    "poem_id": 87976,
    "vorder": 201,
    "position": 0,
    "text": "برآویخت چون شیر بهرام گرد"
  },
  {
    "poem_id": 87976,
    "vorder": 202,
    "position": 1,
    "text": "بنیزه بریشان یکی حمله برد"
  },
  {
    "poem_id": 87976,
    "vorder": 203,
    "position": 0,
    "text": "بنوک سنان تاج را برگرفت"
  },
  {
    "poem_id": 87976,
    "vorder": 204,
    "position": 1,
    "text": "دو لشکر بدو مانده اندر شگفت"
  },
  {
    "poem_id": 87976,
    "vorder": 205,
    "position": 0,
    "text": "همی بود زان گونه تا تیره گشت"
  },
  {
    "poem_id": 87976,
    "vorder": 206,
    "position": 1,
    "text": "همی دیده از تیرگی خیره گشت"
  },
  {
    "poem_id": 87976,
    "vorder": 207,
    "position": 0,
    "text": "چنین هر زمانی برآشوفتند"
  },
  {
    "poem_id": 87976,
    "vorder": 208,
    "position": 1,
    "text": "همی بر سر یکدگر کوفتند"
  },
  {
    "poem_id": 87976,
    "vorder": 209,
    "position": 0,
    "text": "ز گودرزیان هشت تن زنده بود"
  },
  {
    "poem_id": 87976,
    "vorder": 210,
    "position": 1,
    "text": "بران رزمگه دیگر افگنده بود"
  },
  {
    "poem_id": 87976,
    "vorder": 211,
    "position": 0,
    "text": "هم از تخمهٔ گیو چون بیست و پنج"
  },
  {
    "poem_id": 87976,
    "vorder": 212,
    "position": 1,
    "text": "که بودند زیبای دیهیم و گنج"
  },
  {
    "poem_id": 87976,
    "vorder": 213,
    "position": 0,
    "text": "هم از تخم کاوس هفتاد مرد"
  },
  {
    "poem_id": 87976,
    "vorder": 214,
    "position": 1,
    "text": "سواران و شیران روز نبرد"
  },
  {
    "poem_id": 87976,
    "vorder": 215,
    "position": 0,
    "text": "جز از ریونیز آن سر تاجدار"
  },
  {
    "poem_id": 87976,
    "vorder": 216,
    "position": 1,
    "text": "سزد گر نیاید کسی در شمار"
  },
  {
    "poem_id": 87976,
    "vorder": 217,
    "position": 0,
    "text": "چو سیصد تن از تخم افراسیاب"
  },
  {
    "poem_id": 87976,
    "vorder": 218,
    "position": 1,
    "text": "کجا بختشان اندر آمد بخواب"
  },
  {
    "poem_id": 87976,
    "vorder": 219,
    "position": 0,
    "text": "ز خویشان پیران چو نهصد سوار"
  },
  {
    "poem_id": 87976,
    "vorder": 220,
    "position": 1,
    "text": "کم آمد برین روز در کارزار"
  },
  {
    "poem_id": 87976,
    "vorder": 221,
    "position": 0,
    "text": "همان دست پیران بد و روز اوی"
  },
  {
    "poem_id": 87976,
    "vorder": 222,
    "position": 1,
    "text": "ازان اختر گیتی‌افروز اوی"
  },
  {
    "poem_id": 87976,
    "vorder": 223,
    "position": 0,
    "text": "نبد روز پیکار ایرانیان"
  },
  {
    "poem_id": 87976,
    "vorder": 224,
    "position": 1,
    "text": "ازان جنگ جستن سرآمد زمان"
  },
  {
    "poem_id": 87976,
    "vorder": 225,
    "position": 0,
    "text": "از آوردگه روی برگاشتند"
  },
  {
    "poem_id": 87976,
    "vorder": 226,
    "position": 1,
    "text": "همی خستگان خوار بگذاشتند"
  },
  {
    "poem_id": 87976,
    "vorder": 227,
    "position": 0,
    "text": "بدانگه کجا بخت برگشته بود"
  },
  {
    "poem_id": 87976,
    "vorder": 228,
    "position": 1,
    "text": "دمان بارهٔ گستهم کشته بود"
  },
  {
    "poem_id": 87976,
    "vorder": 229,
    "position": 0,
    "text": "پیاده همی رفت نیزه بدست"
  },
  {
    "poem_id": 87976,
    "vorder": 230,
    "position": 1,
    "text": "ابا جوشن و خود برسان مست"
  },
  {
    "poem_id": 87976,
    "vorder": 231,
    "position": 0,
    "text": "چو بیژن بگستهم نزدیک شد"
  },
  {
    "poem_id": 87976,
    "vorder": 232,
    "position": 1,
    "text": "شب آمد همی روز تاریک شد"
  },
  {
    "poem_id": 87976,
    "vorder": 233,
    "position": 0,
    "text": "بدو گفت هین برنشین از پسم"
  },
  {
    "poem_id": 87976,
    "vorder": 234,
    "position": 1,
    "text": "گرامی‌تر از تو نباشد کسم"
  },
  {
    "poem_id": 87976,
    "vorder": 235,
    "position": 0,
    "text": "نشستند هر دو بران بارگی"
  },
  {
    "poem_id": 87976,
    "vorder": 236,
    "position": 1,
    "text": "چو خورشید شد تیره یکبارگی"
  },
  {
    "poem_id": 87976,
    "vorder": 237,
    "position": 0,
    "text": "همه سوی آن دامن کوهسار"
  },
  {
    "poem_id": 87976,
    "vorder": 238,
    "position": 1,
    "text": "گریزان برفتند برگشته کار"
  },
  {
    "poem_id": 87976,
    "vorder": 239,
    "position": 0,
    "text": "سواران ترکان همه شاددل"
  },
  {
    "poem_id": 87976,
    "vorder": 240,
    "position": 1,
    "text": "ز رنج و ز غم گشته آزاددل"
  },
  {
    "poem_id": 87976,
    "vorder": 241,
    "position": 0,
    "text": "بلشکرگه خویش بازآمدند"
  },
  {
    "poem_id": 87976,
    "vorder": 242,
    "position": 1,
    "text": "گرازنده و بزم ساز آمدند"
  },
  {
    "poem_id": 87976,
    "vorder": 243,
    "position": 0,
    "text": "ز گردان ایران برآمد خروش"
  },
  {
    "poem_id": 87976,
    "vorder": 244,
    "position": 1,
    "text": "همی کر شد از نالهٔ کوس گوش"
  }
]