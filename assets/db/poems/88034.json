[
  {
    "poem_id": 88034,
    "vorder": 1,
    "position": 0,
    "text": "نویسندهٔ نامه را خواند و گفت"
  },
  {
    "poem_id": 88034,
    "vorder": 2,
    "position": 1,
    "text": "برآورد خواهم نهان از نهفت"
  },
  {
    "poem_id": 88034,
    "vorder": 3,
    "position": 0,
    "text": "اگر برگشایی تو لب را ز بند"
  },
  {
    "poem_id": 88034,
    "vorder": 4,
    "position": 1,
    "text": "زبان آورد بر سرت بر گزند"
  },
  {
    "poem_id": 88034,
    "vorder": 5,
    "position": 0,
    "text": "یکی نامه فرمود نزدیک شاه"
  },
  {
    "poem_id": 88034,
    "vorder": 6,
    "position": 1,
    "text": "به آگاه کردن ز کار سپاه"
  },
  {
    "poem_id": 88034,
    "vorder": 7,
    "position": 0,
    "text": "به خسرو نمود آن کجا رفته بود"
  },
  {
    "poem_id": 88034,
    "vorder": 8,
    "position": 1,
    "text": "سخن هرچ پیران بدو گفته بود"
  },
  {
    "poem_id": 88034,
    "vorder": 9,
    "position": 0,
    "text": "فرستادن گیو و پیوند و مهر"
  },
  {
    "poem_id": 88034,
    "vorder": 10,
    "position": 1,
    "text": "نمودن بدو کار گردان سپهر"
  },
  {
    "poem_id": 88034,
    "vorder": 11,
    "position": 0,
    "text": "ز پاسخ که دادند مر گیو را"
  },
  {
    "poem_id": 88034,
    "vorder": 12,
    "position": 1,
    "text": "بزرگان و فرزانهٔ نیو را"
  },
  {
    "poem_id": 88034,
    "vorder": 13,
    "position": 0,
    "text": "وز آن لشکری کز پسش چون پلنگ"
  },
  {
    "poem_id": 88034,
    "vorder": 14,
    "position": 1,
    "text": "بیاورد سوی کنابد به جنگ"
  },
  {
    "poem_id": 88034,
    "vorder": 15,
    "position": 0,
    "text": "از آن پس کجا رزمگه ساختند"
  },
  {
    "poem_id": 88034,
    "vorder": 16,
    "position": 1,
    "text": "وز آن رزم دل را بپرداختند"
  },
  {
    "poem_id": 88034,
    "vorder": 17,
    "position": 0,
    "text": "ز هومان و نستیهن جنگجوی"
  },
  {
    "poem_id": 88034,
    "vorder": 18,
    "position": 1,
    "text": "سراسر همه یاد کرد اندر اوی"
  },
  {
    "poem_id": 88034,
    "vorder": 19,
    "position": 0,
    "text": "ز کردار بیژن که روز نبرد"
  },
  {
    "poem_id": 88034,
    "vorder": 20,
    "position": 1,
    "text": "بدان گرزداران توران چه کرد"
  },
  {
    "poem_id": 88034,
    "vorder": 21,
    "position": 0,
    "text": "سخن سر به سر چون همه گفته بود"
  },
  {
    "poem_id": 88034,
    "vorder": 22,
    "position": 1,
    "text": "ز پیکار و جنگ آن کجا رفته بود"
  },
  {
    "poem_id": 88034,
    "vorder": 23,
    "position": 0,
    "text": "بپردخت زان پس به افراسیاب"
  },
  {
    "poem_id": 88034,
    "vorder": 24,
    "position": 1,
    "text": "که با لشکر آمد به نزدیک آب"
  },
  {
    "poem_id": 88034,
    "vorder": 25,
    "position": 0,
    "text": "گر او از لب رود جیحون سپاه"
  },
  {
    "poem_id": 88034,
    "vorder": 26,
    "position": 1,
    "text": "به ایران گذارد سپه را به راه"
  },
  {
    "poem_id": 88034,
    "vorder": 27,
    "position": 0,
    "text": "تو دانی که با او نداریم پای"
  },
  {
    "poem_id": 88034,
    "vorder": 28,
    "position": 1,
    "text": "ایا فرخجسته جهان کدخدای"
  },
  {
    "poem_id": 88034,
    "vorder": 29,
    "position": 0,
    "text": "مگر خسرو آید به پشت سپاه"
  },
  {
    "poem_id": 88034,
    "vorder": 30,
    "position": 1,
    "text": "به سر بر نهد بندگان را کلاه"
  },
  {
    "poem_id": 88034,
    "vorder": 31,
    "position": 0,
    "text": "ور ایدونک پیران کند دست پیش"
  },
  {
    "poem_id": 88034,
    "vorder": 32,
    "position": 1,
    "text": "بخواهد سپه یاور از شاه خویش"
  },
  {
    "poem_id": 88034,
    "vorder": 33,
    "position": 0,
    "text": "به خسرو رسد زان سپس آگهی"
  },
  {
    "poem_id": 88034,
    "vorder": 34,
    "position": 1,
    "text": "ک با او چه سازد به بختت رهی"
  },
  {
    "poem_id": 88034,
    "vorder": 35,
    "position": 0,
    "text": "و دیگر که از رستم دیو بند"
  },
  {
    "poem_id": 88034,
    "vorder": 36,
    "position": 1,
    "text": "ز لهراسب وز اشکش هوشمند"
  },
  {
    "poem_id": 88034,
    "vorder": 37,
    "position": 0,
    "text": "ز کردار ایشان به کهتر خبر"
  },
  {
    "poem_id": 88034,
    "vorder": 38,
    "position": 1,
    "text": "رساند مگر شاه پیروزگر"
  },
  {
    "poem_id": 88034,
    "vorder": 39,
    "position": 0,
    "text": "چو نامه به مهر اندر آورد و بند"
  },
  {
    "poem_id": 88034,
    "vorder": 40,
    "position": 1,
    "text": "بفرمود تا بر ستور نوند"
  },
  {
    "poem_id": 88034,
    "vorder": 41,
    "position": 0,
    "text": "نشستنگه خسروی ساختند"
  },
  {
    "poem_id": 88034,
    "vorder": 42,
    "position": 1,
    "text": "فراوان تگاور برون تاختند"
  },
  {
    "poem_id": 88034,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود تا رفت پیشش هجیر"
  },
  {
    "poem_id": 88034,
    "vorder": 44,
    "position": 1,
    "text": "جوانی به کردار هشیار و پیر"
  },
  {
    "poem_id": 88034,
    "vorder": 45,
    "position": 0,
    "text": "بگفت آن سخن سر به سر پهلوان"
  },
  {
    "poem_id": 88034,
    "vorder": 46,
    "position": 1,
    "text": "به پیش هشیوار پور جوان"
  },
  {
    "poem_id": 88034,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت کای پور هشیاردل"
  },
  {
    "poem_id": 88034,
    "vorder": 48,
    "position": 1,
    "text": "یکی تیز گردان بدین کار دل"
  },
  {
    "poem_id": 88034,
    "vorder": 49,
    "position": 0,
    "text": "اگر مر تو را نزد من دستگاه"
  },
  {
    "poem_id": 88034,
    "vorder": 50,
    "position": 1,
    "text": "همی جست باید کنونست گاه"
  },
  {
    "poem_id": 88034,
    "vorder": 51,
    "position": 0,
    "text": "چو بستانی این نامه هم در زمان"
  },
  {
    "poem_id": 88034,
    "vorder": 52,
    "position": 1,
    "text": "برو هم به کردار باد دمان"
  },
  {
    "poem_id": 88034,
    "vorder": 53,
    "position": 0,
    "text": "شب و روز ماسای و سر بر مخار"
  },
  {
    "poem_id": 88034,
    "vorder": 54,
    "position": 1,
    "text": "ببر نامهٔ من بر شهریار"
  },
  {
    "poem_id": 88034,
    "vorder": 55,
    "position": 0,
    "text": "به پدرود کردن گرفتش به بر"
  },
  {
    "poem_id": 88034,
    "vorder": 56,
    "position": 1,
    "text": "برون آمد از پیش فرخ پدر"
  },
  {
    "poem_id": 88034,
    "vorder": 57,
    "position": 0,
    "text": "ز لشکر دو تن را بر خویش خواند"
  },
  {
    "poem_id": 88034,
    "vorder": 58,
    "position": 1,
    "text": "سبکشان به اسب تگاور نشاند"
  },
  {
    "poem_id": 88034,
    "vorder": 59,
    "position": 0,
    "text": "برون شد ز پرده‌سرای پدر"
  },
  {
    "poem_id": 88034,
    "vorder": 60,
    "position": 1,
    "text": "به هر منزلی بر هیونی دگر"
  },
  {
    "poem_id": 88034,
    "vorder": 61,
    "position": 0,
    "text": "خور و خواب و آرامشان بر ستور"
  },
  {
    "poem_id": 88034,
    "vorder": 62,
    "position": 1,
    "text": "چه تاریکی شب چه تابنده هور"
  },
  {
    "poem_id": 88034,
    "vorder": 63,
    "position": 0,
    "text": "بر آن گونه پویان به راه آمدند"
  },
  {
    "poem_id": 88034,
    "vorder": 64,
    "position": 1,
    "text": "به یک هفته نزدیک شاه آمدند"
  },
  {
    "poem_id": 88034,
    "vorder": 65,
    "position": 0,
    "text": "چو از راه ایران بیامد سوار"
  },
  {
    "poem_id": 88034,
    "vorder": 66,
    "position": 1,
    "text": "کس آمد بر خسرو نامدار"
  },
  {
    "poem_id": 88034,
    "vorder": 67,
    "position": 0,
    "text": "پذیره فرستاد شماخ را"
  },
  {
    "poem_id": 88034,
    "vorder": 68,
    "position": 1,
    "text": "چه مایه دلیران گستاخ را"
  },
  {
    "poem_id": 88034,
    "vorder": 69,
    "position": 0,
    "text": "بپرسید چون دید روی هجیر"
  },
  {
    "poem_id": 88034,
    "vorder": 70,
    "position": 1,
    "text": "که ای پهلوان‌زادهٔ شیرگیر"
  },
  {
    "poem_id": 88034,
    "vorder": 71,
    "position": 0,
    "text": "درودست باری که بس ناگهان"
  },
  {
    "poem_id": 88034,
    "vorder": 72,
    "position": 1,
    "text": "رسیدی به نزدیک شاه جهان"
  },
  {
    "poem_id": 88034,
    "vorder": 73,
    "position": 0,
    "text": "بفرمود تا پرده برداشتند"
  },
  {
    "poem_id": 88034,
    "vorder": 74,
    "position": 1,
    "text": "به اسبش ز درگاه بگذاشتند"
  },
  {
    "poem_id": 88034,
    "vorder": 75,
    "position": 0,
    "text": "هجیر اندر آمد چو خسرو بدوی"
  },
  {
    "poem_id": 88034,
    "vorder": 76,
    "position": 1,
    "text": "نگه کرد پیشش بمالید روی"
  },
  {
    "poem_id": 88034,
    "vorder": 77,
    "position": 0,
    "text": "بپرسید بسیار و بنشاندش"
  },
  {
    "poem_id": 88034,
    "vorder": 78,
    "position": 1,
    "text": "هزاران هجیر آفرین خواندش"
  },
  {
    "poem_id": 88034,
    "vorder": 79,
    "position": 0,
    "text": "ز گوهر یکی تاج پیروزه شاه"
  },
  {
    "poem_id": 88034,
    "vorder": 80,
    "position": 1,
    "text": "به سر بر نهادش چو رخشنده ماه"
  },
  {
    "poem_id": 88034,
    "vorder": 81,
    "position": 0,
    "text": "ز گودرز وز مهتران سپاه"
  },
  {
    "poem_id": 88034,
    "vorder": 82,
    "position": 1,
    "text": "ز هر یک یکایک بپرسید شاه"
  },
  {
    "poem_id": 88034,
    "vorder": 83,
    "position": 0,
    "text": "درود بزرگان به خسرو بداد"
  },
  {
    "poem_id": 88034,
    "vorder": 84,
    "position": 1,
    "text": "همه کار لشکر بر او کرد یاد"
  },
  {
    "poem_id": 88034,
    "vorder": 85,
    "position": 0,
    "text": "بدو داد پس نامهٔ پهلوان"
  },
  {
    "poem_id": 88034,
    "vorder": 86,
    "position": 1,
    "text": "جوان خردمند روشن‌روان"
  },
  {
    "poem_id": 88034,
    "vorder": 87,
    "position": 0,
    "text": "نویسنده را پیش بنشاندند"
  },
  {
    "poem_id": 88034,
    "vorder": 88,
    "position": 1,
    "text": "بفرمود تا نامه برخواندند"
  },
  {
    "poem_id": 88034,
    "vorder": 89,
    "position": 0,
    "text": "چو برخواند نامه به خسرو دبیر"
  },
  {
    "poem_id": 88034,
    "vorder": 90,
    "position": 1,
    "text": "ز یاقوت رخشان دهان هجیر"
  },
  {
    "poem_id": 88034,
    "vorder": 91,
    "position": 0,
    "text": "بیاگند وز آن پس به گنجور گفت"
  },
  {
    "poem_id": 88034,
    "vorder": 92,
    "position": 1,
    "text": "که دینار و دیبا بیار از نهفت"
  },
  {
    "poem_id": 88034,
    "vorder": 93,
    "position": 0,
    "text": "بیاورد بدره چو فرمان شنید"
  },
  {
    "poem_id": 88034,
    "vorder": 94,
    "position": 1,
    "text": "همی ریخت تا شد سرش ناپدید"
  },
  {
    "poem_id": 88034,
    "vorder": 95,
    "position": 0,
    "text": "بیاورد پس جامه زرنگار"
  },
  {
    "poem_id": 88034,
    "vorder": 96,
    "position": 1,
    "text": "چنان چون بود از در شهریار"
  },
  {
    "poem_id": 88034,
    "vorder": 97,
    "position": 0,
    "text": "همیدون ببردند پیش هجیر"
  },
  {
    "poem_id": 88034,
    "vorder": 98,
    "position": 1,
    "text": "ابا زین زرین ده اسب هژیر"
  },
  {
    "poem_id": 88034,
    "vorder": 99,
    "position": 0,
    "text": "به یارانش بر خلعت افگند نیز"
  },
  {
    "poem_id": 88034,
    "vorder": 100,
    "position": 1,
    "text": "درم داد و دینار و هرگونه چیز"
  },
  {
    "poem_id": 88034,
    "vorder": 101,
    "position": 0,
    "text": "از آن پس چو از جای برخاستند"
  },
  {
    "poem_id": 88034,
    "vorder": 102,
    "position": 1,
    "text": "نشستنگه می بیاراستند"
  },
  {
    "poem_id": 88034,
    "vorder": 103,
    "position": 0,
    "text": "هجیر و بزرگان خسروپرست"
  },
  {
    "poem_id": 88034,
    "vorder": 104,
    "position": 1,
    "text": "گرفتند یکسر همه می به دست"
  },
  {
    "poem_id": 88034,
    "vorder": 105,
    "position": 0,
    "text": "نشستند یک روز و یک شب به هم"
  },
  {
    "poem_id": 88034,
    "vorder": 106,
    "position": 1,
    "text": "همی رای زد خسرو از بیش و کم"
  },
  {
    "poem_id": 88034,
    "vorder": 107,
    "position": 0,
    "text": "به شبگیر خسرو سر و تن بشست"
  },
  {
    "poem_id": 88034,
    "vorder": 108,
    "position": 1,
    "text": "به پیش جهانداور آمد نخست"
  },
  {
    "poem_id": 88034,
    "vorder": 109,
    "position": 0,
    "text": "بپوشید نو جامهٔ بندگی"
  },
  {
    "poem_id": 88034,
    "vorder": 110,
    "position": 1,
    "text": "دو دیده چو ابری به بارندگی"
  },
  {
    "poem_id": 88034,
    "vorder": 111,
    "position": 0,
    "text": "دوتایی شده پشت و بنهاد سر"
  },
  {
    "poem_id": 88034,
    "vorder": 112,
    "position": 1,
    "text": "همی آفرین خواند بر دادگر"
  },
  {
    "poem_id": 88034,
    "vorder": 113,
    "position": 0,
    "text": "از او خواست پیروزی و فرهی"
  },
  {
    "poem_id": 88034,
    "vorder": 114,
    "position": 1,
    "text": "بدو جست دیهیم و تخت مهی"
  },
  {
    "poem_id": 88034,
    "vorder": 115,
    "position": 0,
    "text": "به یزدان بنالید ز افراسیاب"
  },
  {
    "poem_id": 88034,
    "vorder": 116,
    "position": 1,
    "text": "به درد از دو دیده فرو ریخت آب"
  },
  {
    "poem_id": 88034,
    "vorder": 117,
    "position": 0,
    "text": "وز آنجا بیامد چو سرو سهی"
  },
  {
    "poem_id": 88034,
    "vorder": 118,
    "position": 1,
    "text": "نشست از بر گاه شاههنشهی"
  }
]