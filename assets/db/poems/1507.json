[
  {
    "poem_id": 1507,
    "vorder": 1,
    "position": 0,
    "text": "شبی چون شبه روی شسته به قیر"
  },
  {
    "poem_id": 1507,
    "vorder": 2,
    "position": 1,
    "text": "نه بهرام پیدا نه کیوان نه تیر"
  },
  {
    "poem_id": 1507,
    "vorder": 3,
    "position": 0,
    "text": "دگرگونه آرایشی کرد ماه"
  },
  {
    "poem_id": 1507,
    "vorder": 4,
    "position": 1,
    "text": "بسیچ گذر کرد بر پیشگاه"
  },
  {
    "poem_id": 1507,
    "vorder": 5,
    "position": 0,
    "text": "شده تیره اندر سرای درنگ"
  },
  {
    "poem_id": 1507,
    "vorder": 6,
    "position": 1,
    "text": "میان کرده باریک و دل کرده تنگ"
  },
  {
    "poem_id": 1507,
    "vorder": 7,
    "position": 0,
    "text": "ز تاجش سه بهره شده لاژورد"
  },
  {
    "poem_id": 1507,
    "vorder": 8,
    "position": 1,
    "text": "سپرده هوا را به زنگار و گرد"
  },
  {
    "poem_id": 1507,
    "vorder": 9,
    "position": 0,
    "text": "سپاه شب تیره بر دشت و راغ"
  },
  {
    "poem_id": 1507,
    "vorder": 10,
    "position": 1,
    "text": "یکی فرش گسترده از پرّ زاغ"
  },
  {
    "poem_id": 1507,
    "vorder": 11,
    "position": 0,
    "text": "نموده ز هر سو به چشم اهرمن"
  },
  {
    "poem_id": 1507,
    "vorder": 12,
    "position": 1,
    "text": "چو مار سیه باز کرده دهن"
  },
  {
    "poem_id": 1507,
    "vorder": 13,
    "position": 0,
    "text": "چو پولاد زنگار خورده سپهر"
  },
  {
    "poem_id": 1507,
    "vorder": 14,
    "position": 1,
    "text": "تو گفتی به قیر اندر اندود چهر"
  },
  {
    "poem_id": 1507,
    "vorder": 15,
    "position": 0,
    "text": "هرآنگه که برزد یکی باد سرد"
  },
  {
    "poem_id": 1507,
    "vorder": 16,
    "position": 1,
    "text": "چو زنگی برانگیخت ز انگشت گرد"
  },
  {
    "poem_id": 1507,
    "vorder": 17,
    "position": 0,
    "text": "چنان گشت باغ و لب جویبار"
  },
  {
    "poem_id": 1507,
    "vorder": 18,
    "position": 1,
    "text": "کجا موج خیزد ز دریای قار"
  },
  {
    "poem_id": 1507,
    "vorder": 19,
    "position": 0,
    "text": "فرو ماند گردون گردان به جای"
  },
  {
    "poem_id": 1507,
    "vorder": 20,
    "position": 1,
    "text": "شده سست خورشید را دست و پای"
  },
  {
    "poem_id": 1507,
    "vorder": 21,
    "position": 0,
    "text": "سپهر اندر آن چادر قیرگون"
  },
  {
    "poem_id": 1507,
    "vorder": 22,
    "position": 1,
    "text": "تو گفتی شدستی به خواب اندرون"
  },
  {
    "poem_id": 1507,
    "vorder": 23,
    "position": 0,
    "text": "جهان از دل خویشتن پر هراس"
  },
  {
    "poem_id": 1507,
    "vorder": 24,
    "position": 1,
    "text": "جرس برکشیده نگهبان پاس"
  },
  {
    "poem_id": 1507,
    "vorder": 25,
    "position": 0,
    "text": "نه آوای مرغ و نه هُرّای دد"
  },
  {
    "poem_id": 1507,
    "vorder": 26,
    "position": 1,
    "text": "زمانه زبان بسته از نیک و بد"
  },
  {
    "poem_id": 1507,
    "vorder": 27,
    "position": 0,
    "text": "نبد هیچ پیدا نشیب از فراز"
  },
  {
    "poem_id": 1507,
    "vorder": 28,
    "position": 1,
    "text": "دلم تنگ شد زان شب دیریاز"
  },
  {
    "poem_id": 1507,
    "vorder": 29,
    "position": 0,
    "text": "بدان تنگی اندر بجستم ز جای"
  },
  {
    "poem_id": 1507,
    "vorder": 30,
    "position": 1,
    "text": "یکی مهربان بودم اندر سرای"
  },
  {
    "poem_id": 1507,
    "vorder": 31,
    "position": 0,
    "text": "خروشیدم و خواستم زو چراغ"
  },
  {
    "poem_id": 1507,
    "vorder": 32,
    "position": 1,
    "text": "برفت آن بت مهربانم ز باغ"
  },
  {
    "poem_id": 1507,
    "vorder": 33,
    "position": 0,
    "text": "مرا گفت شمعت چه‌ باید همی"
  },
  {
    "poem_id": 1507,
    "vorder": 34,
    "position": 1,
    "text": "شب تیره خوابت بباید همی"
  },
  {
    "poem_id": 1507,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفتم ای بت نیم مرد خواب"
  },
  {
    "poem_id": 1507,
    "vorder": 36,
    "position": 1,
    "text": "یکی شمع پیش آر چون آفتاب"
  },
  {
    "poem_id": 1507,
    "vorder": 37,
    "position": 0,
    "text": "بنه پیشم و بزم را ساز کن"
  },
  {
    "poem_id": 1507,
    "vorder": 38,
    "position": 1,
    "text": "به چنگ آر چنگ و می آغاز کن"
  },
  {
    "poem_id": 1507,
    "vorder": 39,
    "position": 0,
    "text": "بیاورد شمع و بیامد به باغ"
  },
  {
    "poem_id": 1507,
    "vorder": 40,
    "position": 1,
    "text": "برافروخت رخشنده شمع و چراغ"
  },
  {
    "poem_id": 1507,
    "vorder": 41,
    "position": 0,
    "text": "می آورد و نار و ترنج و بهی"
  },
  {
    "poem_id": 1507,
    "vorder": 42,
    "position": 1,
    "text": "زدوده یکی جام شاهنشهی"
  },
  {
    "poem_id": 1507,
    "vorder": 43,
    "position": 0,
    "text": "مرا گفت برخیز و دل شاددار"
  },
  {
    "poem_id": 1507,
    "vorder": 44,
    "position": 1,
    "text": "روان را ز درد و غم آزاد دار"
  },
  {
    "poem_id": 1507,
    "vorder": 45,
    "position": 0,
    "text": "نگر تا که دل را نداری تباه"
  },
  {
    "poem_id": 1507,
    "vorder": 46,
    "position": 1,
    "text": "ز اندیشه و داد فریاد خواه"
  },
  {
    "poem_id": 1507,
    "vorder": 47,
    "position": 0,
    "text": "جهان چون گذاری همی بگذرد"
  },
  {
    "poem_id": 1507,
    "vorder": 48,
    "position": 1,
    "text": "خردمند مردم چرا غم خورد"
  },
  {
    "poem_id": 1507,
    "vorder": 49,
    "position": 0,
    "text": "گهی می گسارید و گه چنگ ساخت"
  },
  {
    "poem_id": 1507,
    "vorder": 50,
    "position": 1,
    "text": "تو گفتی که هاروت نیرنگ ساخت"
  },
  {
    "poem_id": 1507,
    "vorder": 51,
    "position": 0,
    "text": "دلم بر همه کام پیروز کرد"
  },
  {
    "poem_id": 1507,
    "vorder": 52,
    "position": 1,
    "text": "که بر من شب تیره نوروز کرد"
  },
  {
    "poem_id": 1507,
    "vorder": 53,
    "position": 0,
    "text": "بدان سرو بن گفتم ای ماهروی"
  },
  {
    "poem_id": 1507,
    "vorder": 54,
    "position": 1,
    "text": "یکی داستان امشبم بازگوی"
  },
  {
    "poem_id": 1507,
    "vorder": 55,
    "position": 0,
    "text": "که دل گیرد از مهر او فر و مهر"
  },
  {
    "poem_id": 1507,
    "vorder": 56,
    "position": 1,
    "text": "بدو اندرون خیره ماند سپهر"
  },
  {
    "poem_id": 1507,
    "vorder": 57,
    "position": 0,
    "text": "مرا مهربان یار بشنو چه‌ گفت"
  },
  {
    "poem_id": 1507,
    "vorder": 58,
    "position": 1,
    "text": "ازان پس که با کام گشتیم جفت"
  },
  {
    "poem_id": 1507,
    "vorder": 59,
    "position": 0,
    "text": "بپیمای می تا یکی داستان"
  },
  {
    "poem_id": 1507,
    "vorder": 60,
    "position": 1,
    "text": "بگویَمْت از گفتهٔ باستان"
  },
  {
    "poem_id": 1507,
    "vorder": 61,
    "position": 0,
    "text": "پر از چاره و مهر و نیرنگ و جنگ"
  },
  {
    "poem_id": 1507,
    "vorder": 62,
    "position": 1,
    "text": "همان از در مرد فرهنگ و سنگ"
  },
  {
    "poem_id": 1507,
    "vorder": 63,
    "position": 0,
    "text": "بگفتم بیار ای بت خوب چهر"
  },
  {
    "poem_id": 1507,
    "vorder": 64,
    "position": 1,
    "text": "بخوان داستان و بیفزای مهر"
  },
  {
    "poem_id": 1507,
    "vorder": 65,
    "position": 0,
    "text": "ز نیک و بد چرخ ناسازگار"
  },
  {
    "poem_id": 1507,
    "vorder": 66,
    "position": 1,
    "text": "که آرد به مردم ز هرگونه کار"
  },
  {
    "poem_id": 1507,
    "vorder": 67,
    "position": 0,
    "text": "نگر تا نداری دل خویش تنگ"
  },
  {
    "poem_id": 1507,
    "vorder": 68,
    "position": 1,
    "text": "بتابی ازو چند جویی درنگ"
  },
  {
    "poem_id": 1507,
    "vorder": 69,
    "position": 0,
    "text": "نداند کسی راه و سامان اوی"
  },
  {
    "poem_id": 1507,
    "vorder": 70,
    "position": 1,
    "text": "نه پیدا بود درد و درمان اوی"
  },
  {
    "poem_id": 1507,
    "vorder": 71,
    "position": 0,
    "text": "پس آنگه بگفت ار ز من بشنوی"
  },
  {
    "poem_id": 1507,
    "vorder": 72,
    "position": 1,
    "text": "به شعر آری از دفتر پهلوی"
  },
  {
    "poem_id": 1507,
    "vorder": 73,
    "position": 0,
    "text": "همت گویم و هم پذیرم سپاس"
  },
  {
    "poem_id": 1507,
    "vorder": 74,
    "position": 1,
    "text": "کنون بشنو ای جفت نیکی‌شناس"
  }
]