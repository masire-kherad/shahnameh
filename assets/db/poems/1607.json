[
  {
    "poem_id": 1607,
    "vorder": 1,
    "position": 0,
    "text": "چنین گوید آن پیر دانش‌پژوه"
  },
  {
    "poem_id": 1607,
    "vorder": 2,
    "position": 1,
    "text": "هنرمند و گوینده و با شکوه"
  },
  {
    "poem_id": 1607,
    "vorder": 3,
    "position": 0,
    "text": "که در پرده بد زال را برده‌ای"
  },
  {
    "poem_id": 1607,
    "vorder": 4,
    "position": 1,
    "text": "نوازندهٔ رود و گوینده‌ای"
  },
  {
    "poem_id": 1607,
    "vorder": 5,
    "position": 0,
    "text": "کنیزک پسر زاد روزی یکی"
  },
  {
    "poem_id": 1607,
    "vorder": 6,
    "position": 1,
    "text": "که ازماه پیدا نبود اندکی"
  },
  {
    "poem_id": 1607,
    "vorder": 7,
    "position": 0,
    "text": "به بالا و دیدار سام سوار"
  },
  {
    "poem_id": 1607,
    "vorder": 8,
    "position": 1,
    "text": "ازو شاد شد دودهٔ نامدار"
  },
  {
    "poem_id": 1607,
    "vorder": 9,
    "position": 0,
    "text": "ستاره‌شناسان و کنداوران"
  },
  {
    "poem_id": 1607,
    "vorder": 10,
    "position": 1,
    "text": "ز کشمیر و کابل گزیده سران"
  },
  {
    "poem_id": 1607,
    "vorder": 11,
    "position": 0,
    "text": "ز آتش‌پرست و ز یزدان‌پرست"
  },
  {
    "poem_id": 1607,
    "vorder": 12,
    "position": 1,
    "text": "برفتند با زیج رومی به دست"
  },
  {
    "poem_id": 1607,
    "vorder": 13,
    "position": 0,
    "text": "گرفتند یکسر شمار سپهر"
  },
  {
    "poem_id": 1607,
    "vorder": 14,
    "position": 1,
    "text": "که دارد بران کودک خرد مهر"
  },
  {
    "poem_id": 1607,
    "vorder": 15,
    "position": 0,
    "text": "ستاره شمرکان شگفتی بدید"
  },
  {
    "poem_id": 1607,
    "vorder": 16,
    "position": 1,
    "text": "همی این بدان آن بدین بنگرید"
  },
  {
    "poem_id": 1607,
    "vorder": 17,
    "position": 0,
    "text": "بگفتند با زال سام سوار"
  },
  {
    "poem_id": 1607,
    "vorder": 18,
    "position": 1,
    "text": "که ای از بلند اختران یادگار"
  },
  {
    "poem_id": 1607,
    "vorder": 19,
    "position": 0,
    "text": "گرفتیم و جستیم راز سپهر"
  },
  {
    "poem_id": 1607,
    "vorder": 20,
    "position": 1,
    "text": "ندارد بدین کودک خرد مهر"
  },
  {
    "poem_id": 1607,
    "vorder": 21,
    "position": 0,
    "text": "چو این خوب چهره به مردی رسد"
  },
  {
    "poem_id": 1607,
    "vorder": 22,
    "position": 1,
    "text": "به گاه دلیری و گردی رسد"
  },
  {
    "poem_id": 1607,
    "vorder": 23,
    "position": 0,
    "text": "کند تخمهٔ سام نیرم تباه"
  },
  {
    "poem_id": 1607,
    "vorder": 24,
    "position": 1,
    "text": "شکست اندرآرد بدین دستگاه"
  },
  {
    "poem_id": 1607,
    "vorder": 25,
    "position": 0,
    "text": "همه سیستان زو شود پرخروش"
  },
  {
    "poem_id": 1607,
    "vorder": 26,
    "position": 1,
    "text": "همه شهر ایران برآید به جوش"
  },
  {
    "poem_id": 1607,
    "vorder": 27,
    "position": 0,
    "text": "شود تلخ ازو روز بر هر کسی"
  },
  {
    "poem_id": 1607,
    "vorder": 28,
    "position": 1,
    "text": "ازان پس به گیتی نماند بسی"
  },
  {
    "poem_id": 1607,
    "vorder": 29,
    "position": 0,
    "text": "غمی گشت زان کار دستان سام"
  },
  {
    "poem_id": 1607,
    "vorder": 30,
    "position": 1,
    "text": "ز دادار گیتی همی برد نام"
  },
  {
    "poem_id": 1607,
    "vorder": 31,
    "position": 0,
    "text": "به یزدان چنین گفت کای رهنمای"
  },
  {
    "poem_id": 1607,
    "vorder": 32,
    "position": 1,
    "text": "تو داری سپهر روان را به پای"
  },
  {
    "poem_id": 1607,
    "vorder": 33,
    "position": 0,
    "text": "به هر کار پشت و پناهم توی"
  },
  {
    "poem_id": 1607,
    "vorder": 34,
    "position": 1,
    "text": "نمایندهٔ رای و راهم توی"
  },
  {
    "poem_id": 1607,
    "vorder": 35,
    "position": 0,
    "text": "سپهر آفریدی و اختر همان"
  },
  {
    "poem_id": 1607,
    "vorder": 36,
    "position": 1,
    "text": "همه نیکویی باد ما را گمان"
  },
  {
    "poem_id": 1607,
    "vorder": 37,
    "position": 0,
    "text": "بجز کام و آرام و خوبی مباد"
  },
  {
    "poem_id": 1607,
    "vorder": 38,
    "position": 1,
    "text": "ورا نام کرد آن سپهبد شغاد"
  },
  {
    "poem_id": 1607,
    "vorder": 39,
    "position": 0,
    "text": "همی داشت مادر چو شد سیر شیر"
  },
  {
    "poem_id": 1607,
    "vorder": 40,
    "position": 1,
    "text": "دلارام و گوینده و یادگیر"
  },
  {
    "poem_id": 1607,
    "vorder": 41,
    "position": 0,
    "text": "بران سال کودک برافراخت یال"
  },
  {
    "poem_id": 1607,
    "vorder": 42,
    "position": 1,
    "text": "بر شاه کابل فرستاد زال"
  },
  {
    "poem_id": 1607,
    "vorder": 43,
    "position": 0,
    "text": "جوان شد به بالای سرو بلند"
  },
  {
    "poem_id": 1607,
    "vorder": 44,
    "position": 1,
    "text": "سواری دلاور به گرز و کمند"
  },
  {
    "poem_id": 1607,
    "vorder": 45,
    "position": 0,
    "text": "سپهدار کابل بدو بنگرید"
  },
  {
    "poem_id": 1607,
    "vorder": 46,
    "position": 1,
    "text": "همی تاج و تخت کیان را سزید"
  },
  {
    "poem_id": 1607,
    "vorder": 47,
    "position": 0,
    "text": "به گیتی به دیدار او بود شاد"
  },
  {
    "poem_id": 1607,
    "vorder": 48,
    "position": 1,
    "text": "بدو داد دختر ز بهر نژاد"
  },
  {
    "poem_id": 1607,
    "vorder": 49,
    "position": 0,
    "text": "ز گنج بزرگ آنچ بد در خورش"
  },
  {
    "poem_id": 1607,
    "vorder": 50,
    "position": 1,
    "text": "فرستاد با نامور دخترش"
  },
  {
    "poem_id": 1607,
    "vorder": 51,
    "position": 0,
    "text": "همی داشتش چون یکی تازه سیب"
  },
  {
    "poem_id": 1607,
    "vorder": 52,
    "position": 1,
    "text": "کز اختر نبودی بروبر نهیب"
  },
  {
    "poem_id": 1607,
    "vorder": 53,
    "position": 0,
    "text": "بزرگان ایران و هندوستان"
  },
  {
    "poem_id": 1607,
    "vorder": 54,
    "position": 1,
    "text": "ز رستم زدندی همی داستان"
  },
  {
    "poem_id": 1607,
    "vorder": 55,
    "position": 0,
    "text": "چنان بد که هر سال یک چرم گاو"
  },
  {
    "poem_id": 1607,
    "vorder": 56,
    "position": 1,
    "text": "ز کابل همی خواستی باژ و ساو"
  },
  {
    "poem_id": 1607,
    "vorder": 57,
    "position": 0,
    "text": "در اندیشهٔ مهتر کابلی"
  },
  {
    "poem_id": 1607,
    "vorder": 58,
    "position": 1,
    "text": "چنان بد کزو رستم زابلی"
  },
  {
    "poem_id": 1607,
    "vorder": 59,
    "position": 0,
    "text": "نگیرد ز کار درم نیز یاد"
  },
  {
    "poem_id": 1607,
    "vorder": 60,
    "position": 1,
    "text": "ازان پس که داماد او شد شغاد"
  },
  {
    "poem_id": 1607,
    "vorder": 61,
    "position": 0,
    "text": "چو هنگام باژ آمد آن بستدند"
  },
  {
    "poem_id": 1607,
    "vorder": 62,
    "position": 1,
    "text": "همه کابلستان بهم بر زدند"
  },
  {
    "poem_id": 1607,
    "vorder": 63,
    "position": 0,
    "text": "دژم شد ز کار برادر شغاد"
  },
  {
    "poem_id": 1607,
    "vorder": 64,
    "position": 1,
    "text": "نکرد آن سخن پیش کس نیز یاد"
  },
  {
    "poem_id": 1607,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت با شاه کابل نهان"
  },
  {
    "poem_id": 1607,
    "vorder": 66,
    "position": 1,
    "text": "که من سیر گشتم ز کار جهان"
  },
  {
    "poem_id": 1607,
    "vorder": 67,
    "position": 0,
    "text": "برادر که او را ز من شرم نیست"
  },
  {
    "poem_id": 1607,
    "vorder": 68,
    "position": 1,
    "text": "مرا سوی او راه و آزرم نیست"
  },
  {
    "poem_id": 1607,
    "vorder": 69,
    "position": 0,
    "text": "چه مهتر برادر چه بیگانه‌ای"
  },
  {
    "poem_id": 1607,
    "vorder": 70,
    "position": 1,
    "text": "چه فرزانه مردی چه دیوانه‌ای"
  },
  {
    "poem_id": 1607,
    "vorder": 71,
    "position": 0,
    "text": "بسازیم و او را به دام آوریم"
  },
  {
    "poem_id": 1607,
    "vorder": 72,
    "position": 1,
    "text": "به گیتی بدین کار نام آوریم"
  },
  {
    "poem_id": 1607,
    "vorder": 73,
    "position": 0,
    "text": "بگفتند و هر دو برابر شدند"
  },
  {
    "poem_id": 1607,
    "vorder": 74,
    "position": 1,
    "text": "به اندیشه از ماه برتر شدند"
  },
  {
    "poem_id": 1607,
    "vorder": 75,
    "position": 0,
    "text": "نگر تا چه گفتست مرد خرد"
  },
  {
    "poem_id": 1607,
    "vorder": 76,
    "position": 1,
    "text": "که هرکس که بد کرد کیفر برد"
  },
  {
    "poem_id": 1607,
    "vorder": 77,
    "position": 0,
    "text": "شبی تا برآمد ز کوه آفتاب"
  },
  {
    "poem_id": 1607,
    "vorder": 78,
    "position": 1,
    "text": "دو تن را سر اندر نیامد به خواب"
  },
  {
    "poem_id": 1607,
    "vorder": 79,
    "position": 0,
    "text": "که ما نام او از جهان کم کنیم"
  },
  {
    "poem_id": 1607,
    "vorder": 80,
    "position": 1,
    "text": "دل و دیدهٔ زال پر نم کنیم"
  },
  {
    "poem_id": 1607,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت با شاه کابل شغاد"
  },
  {
    "poem_id": 1607,
    "vorder": 82,
    "position": 1,
    "text": "که گر زین سخن داد خواهیم داد"
  },
  {
    "poem_id": 1607,
    "vorder": 83,
    "position": 0,
    "text": "یکی سور کن مهتران را بخوان"
  },
  {
    "poem_id": 1607,
    "vorder": 84,
    "position": 1,
    "text": "می و رود و رامشگران را بخوان"
  },
  {
    "poem_id": 1607,
    "vorder": 85,
    "position": 0,
    "text": "به می خوردن اندر مرا سرد گوی"
  },
  {
    "poem_id": 1607,
    "vorder": 86,
    "position": 1,
    "text": "میان کیان ناجوانمرد گوی"
  },
  {
    "poem_id": 1607,
    "vorder": 87,
    "position": 0,
    "text": "ز خواری شوم سوی زابلستان"
  },
  {
    "poem_id": 1607,
    "vorder": 88,
    "position": 1,
    "text": "بنالم ز سالار کابلستان"
  },
  {
    "poem_id": 1607,
    "vorder": 89,
    "position": 0,
    "text": "چه پیش برادر چه پیش پدر"
  },
  {
    "poem_id": 1607,
    "vorder": 90,
    "position": 1,
    "text": "ترا ناسزا خوانم و بدگهر"
  },
  {
    "poem_id": 1607,
    "vorder": 91,
    "position": 0,
    "text": "برآشوبد او را سر از بهر من"
  },
  {
    "poem_id": 1607,
    "vorder": 92,
    "position": 1,
    "text": "بیابد برین نامور شهر من"
  },
  {
    "poem_id": 1607,
    "vorder": 93,
    "position": 0,
    "text": "برآید چنین کار بر دست ما"
  },
  {
    "poem_id": 1607,
    "vorder": 94,
    "position": 1,
    "text": "به چرخ فلک‌بر بود شست ما"
  },
  {
    "poem_id": 1607,
    "vorder": 95,
    "position": 0,
    "text": "تو نخچیرگاهی نگه کن به راه"
  },
  {
    "poem_id": 1607,
    "vorder": 96,
    "position": 1,
    "text": "بکن چاه چندی به نخچیرگاه"
  },
  {
    "poem_id": 1607,
    "vorder": 97,
    "position": 0,
    "text": "براندازهٔ رستم و رخش ساز"
  },
  {
    "poem_id": 1607,
    "vorder": 98,
    "position": 1,
    "text": "به بن در نشان تیغهای دراز"
  },
  {
    "poem_id": 1607,
    "vorder": 99,
    "position": 0,
    "text": "همان نیزه و حربهٔ آبگون"
  },
  {
    "poem_id": 1607,
    "vorder": 100,
    "position": 1,
    "text": "سنان از بر و نیزه زیر اندرون"
  },
  {
    "poem_id": 1607,
    "vorder": 101,
    "position": 0,
    "text": "اگر صد کنی چاه بهتر ز پنج"
  },
  {
    "poem_id": 1607,
    "vorder": 102,
    "position": 1,
    "text": "چو خواهی که آسوده گردی ز رنج"
  },
  {
    "poem_id": 1607,
    "vorder": 103,
    "position": 0,
    "text": "بجای آر صد مرد نیرنگ ساز"
  },
  {
    "poem_id": 1607,
    "vorder": 104,
    "position": 1,
    "text": "بکن چاه و بر باد مگشای راز"
  },
  {
    "poem_id": 1607,
    "vorder": 105,
    "position": 0,
    "text": "سر چاه را سخت کن زان سپس"
  },
  {
    "poem_id": 1607,
    "vorder": 106,
    "position": 1,
    "text": "مگوی این سخن نیز با هیچ‌کس"
  },
  {
    "poem_id": 1607,
    "vorder": 107,
    "position": 0,
    "text": "بشد شاه و رای از منش دور کرد"
  },
  {
    "poem_id": 1607,
    "vorder": 108,
    "position": 1,
    "text": "به گفتار آن بی‌خرد سور کرد"
  },
  {
    "poem_id": 1607,
    "vorder": 109,
    "position": 0,
    "text": "مهان را سراسر ز کابل بخواند"
  },
  {
    "poem_id": 1607,
    "vorder": 110,
    "position": 1,
    "text": "بخوان پسندیده‌شان برنشاند"
  },
  {
    "poem_id": 1607,
    "vorder": 111,
    "position": 0,
    "text": "چو نان خورده شد مجلس آراستند"
  },
  {
    "poem_id": 1607,
    "vorder": 112,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1607,
    "vorder": 113,
    "position": 0,
    "text": "چو سر پر شد از بادهٔ خسروی"
  },
  {
    "poem_id": 1607,
    "vorder": 114,
    "position": 1,
    "text": "شغاد اندر آشفت از بدخوی"
  },
  {
    "poem_id": 1607,
    "vorder": 115,
    "position": 0,
    "text": "چنین گفت با شاه کابل که من"
  },
  {
    "poem_id": 1607,
    "vorder": 116,
    "position": 1,
    "text": "همی سرفرازم به هر انجمن"
  },
  {
    "poem_id": 1607,
    "vorder": 117,
    "position": 0,
    "text": "برادر چو رستم چو دستان پدر"
  },
  {
    "poem_id": 1607,
    "vorder": 118,
    "position": 1,
    "text": "ازین نامورتر که دارد گهر"
  },
  {
    "poem_id": 1607,
    "vorder": 119,
    "position": 0,
    "text": "ازو شاه کابل برآشفت و گفت"
  },
  {
    "poem_id": 1607,
    "vorder": 120,
    "position": 1,
    "text": "که چندین چه داری سخن در نهفت"
  },
  {
    "poem_id": 1607,
    "vorder": 121,
    "position": 0,
    "text": "تو از تخمهٔ سام نیرم نه‌ای"
  },
  {
    "poem_id": 1607,
    "vorder": 122,
    "position": 1,
    "text": "برادر نه‌ای خویش رستم نه‌ای"
  },
  {
    "poem_id": 1607,
    "vorder": 123,
    "position": 0,
    "text": "نکردست یاد از تو دستان سام"
  },
  {
    "poem_id": 1607,
    "vorder": 124,
    "position": 1,
    "text": "برادر ز تو کی برد نیز نام"
  },
  {
    "poem_id": 1607,
    "vorder": 125,
    "position": 0,
    "text": "تو از چاکران کمتری بر درش"
  },
  {
    "poem_id": 1607,
    "vorder": 126,
    "position": 1,
    "text": "برادر نخواند ترا مادرش"
  },
  {
    "poem_id": 1607,
    "vorder": 127,
    "position": 0,
    "text": "ز گفتار او تنگ‌دل شد شغاد"
  },
  {
    "poem_id": 1607,
    "vorder": 128,
    "position": 1,
    "text": "برآشفت و سر سوی زابل نهاد"
  },
  {
    "poem_id": 1607,
    "vorder": 129,
    "position": 0,
    "text": "همی رفت با کابلی چند مرد"
  },
  {
    "poem_id": 1607,
    "vorder": 130,
    "position": 1,
    "text": "دلی پر ز کین لب پر از باد سرد"
  },
  {
    "poem_id": 1607,
    "vorder": 131,
    "position": 0,
    "text": "بیامد به درگاه فرخ پدر"
  },
  {
    "poem_id": 1607,
    "vorder": 132,
    "position": 1,
    "text": "دلی پر ز چاره پر از کینه سر"
  },
  {
    "poem_id": 1607,
    "vorder": 133,
    "position": 0,
    "text": "هم‌انگه چو روی پسر دید زال"
  },
  {
    "poem_id": 1607,
    "vorder": 134,
    "position": 1,
    "text": "چنان برز و بالا و آن فر و یال"
  },
  {
    "poem_id": 1607,
    "vorder": 135,
    "position": 0,
    "text": "بپرسید بسیار و بنواختش"
  },
  {
    "poem_id": 1607,
    "vorder": 136,
    "position": 1,
    "text": "هم‌انگه بر پیلتن تاختش"
  },
  {
    "poem_id": 1607,
    "vorder": 137,
    "position": 0,
    "text": "ز دیدار او شاد شد پهلوان"
  },
  {
    "poem_id": 1607,
    "vorder": 138,
    "position": 1,
    "text": "چو دیدش خردمند و روشن‌روان"
  },
  {
    "poem_id": 1607,
    "vorder": 139,
    "position": 0,
    "text": "چنین گفت کز تخمهٔ سام شیر"
  },
  {
    "poem_id": 1607,
    "vorder": 140,
    "position": 1,
    "text": "نزاید مگر زورمند و دلیر"
  },
  {
    "poem_id": 1607,
    "vorder": 141,
    "position": 0,
    "text": "چگونه است کار تو با کابلی"
  },
  {
    "poem_id": 1607,
    "vorder": 142,
    "position": 1,
    "text": "چه گویند از رستم زابلی"
  },
  {
    "poem_id": 1607,
    "vorder": 143,
    "position": 0,
    "text": "چنین داد پاسخ به رستم شغاد"
  },
  {
    "poem_id": 1607,
    "vorder": 144,
    "position": 1,
    "text": "که از شاه کابل مکن نیز یاد"
  },
  {
    "poem_id": 1607,
    "vorder": 145,
    "position": 0,
    "text": "ازو نیکویی بد مرا پیش ازین"
  },
  {
    "poem_id": 1607,
    "vorder": 146,
    "position": 1,
    "text": "چو دیدی مرا خواندی آفرین"
  },
  {
    "poem_id": 1607,
    "vorder": 147,
    "position": 0,
    "text": "کنون می خورد چنگ سازد همی"
  },
  {
    "poem_id": 1607,
    "vorder": 148,
    "position": 1,
    "text": "سر از هر کسی برفرازد همی"
  },
  {
    "poem_id": 1607,
    "vorder": 149,
    "position": 0,
    "text": "مرابر سر انجمن خوار کرد"
  },
  {
    "poem_id": 1607,
    "vorder": 150,
    "position": 1,
    "text": "همان گوهر بد پدیدار کرد"
  },
  {
    "poem_id": 1607,
    "vorder": 151,
    "position": 0,
    "text": "همی گفت تا کی ازین باژ و ساو"
  },
  {
    "poem_id": 1607,
    "vorder": 152,
    "position": 1,
    "text": "نه با سیستان ما نداریم تاو"
  },
  {
    "poem_id": 1607,
    "vorder": 153,
    "position": 0,
    "text": "ازین پس نگوییم کو رستمست"
  },
  {
    "poem_id": 1607,
    "vorder": 154,
    "position": 1,
    "text": "نه زو مردی و گوهر ما کمست"
  },
  {
    "poem_id": 1607,
    "vorder": 155,
    "position": 0,
    "text": "نه فرزند زالی مرا گفت نیز"
  },
  {
    "poem_id": 1607,
    "vorder": 156,
    "position": 1,
    "text": "وگر هستی او خود نیرزد به چیز"
  },
  {
    "poem_id": 1607,
    "vorder": 157,
    "position": 0,
    "text": "ازان مهتران شد دلم پر ز درد"
  },
  {
    "poem_id": 1607,
    "vorder": 158,
    "position": 1,
    "text": "ز کابل براندم دو رخساره زرد"
  },
  {
    "poem_id": 1607,
    "vorder": 159,
    "position": 0,
    "text": "چو بشنید رستم برآشفت و گفت"
  },
  {
    "poem_id": 1607,
    "vorder": 160,
    "position": 1,
    "text": "که هرگز نماند سخن در نهفت"
  },
  {
    "poem_id": 1607,
    "vorder": 161,
    "position": 0,
    "text": "ازو نیر مندیش وز لشکرش"
  },
  {
    "poem_id": 1607,
    "vorder": 162,
    "position": 1,
    "text": "که مه لشکرش باد و مه افسرش"
  },
  {
    "poem_id": 1607,
    "vorder": 163,
    "position": 0,
    "text": "من او را بدین گفته بیجان کنم"
  },
  {
    "poem_id": 1607,
    "vorder": 164,
    "position": 1,
    "text": "برو بر دل دوده پیچان کنم"
  },
  {
    "poem_id": 1607,
    "vorder": 165,
    "position": 0,
    "text": "ترا برنشانم بر تخت اوی"
  },
  {
    "poem_id": 1607,
    "vorder": 166,
    "position": 1,
    "text": "به خاک اندر آرم سر بخت اوی"
  },
  {
    "poem_id": 1607,
    "vorder": 167,
    "position": 0,
    "text": "همی داشتش روی چند ارجمند"
  },
  {
    "poem_id": 1607,
    "vorder": 168,
    "position": 1,
    "text": "سپرده بدو جایگاه بلند"
  },
  {
    "poem_id": 1607,
    "vorder": 169,
    "position": 0,
    "text": "ز لشگر گزین کرد شایسته مرد"
  },
  {
    "poem_id": 1607,
    "vorder": 170,
    "position": 1,
    "text": "کسی را که زیبا بود در نبرد"
  },
  {
    "poem_id": 1607,
    "vorder": 171,
    "position": 0,
    "text": "بفرمود تا ساز رفتن کنند"
  },
  {
    "poem_id": 1607,
    "vorder": 172,
    "position": 1,
    "text": "ز زابل به کابل نشستن کنند"
  },
  {
    "poem_id": 1607,
    "vorder": 173,
    "position": 0,
    "text": "چو شد کار لشکر همه ساخته"
  },
  {
    "poem_id": 1607,
    "vorder": 174,
    "position": 1,
    "text": "دل پهلوان گشت پرداخته"
  },
  {
    "poem_id": 1607,
    "vorder": 175,
    "position": 0,
    "text": "بیامد بر مرد جنگی شغاد"
  },
  {
    "poem_id": 1607,
    "vorder": 176,
    "position": 1,
    "text": "که با شاه کابل مکن رزم یاد"
  },
  {
    "poem_id": 1607,
    "vorder": 177,
    "position": 0,
    "text": "که گر نام تو برنویسم بر آب"
  },
  {
    "poem_id": 1607,
    "vorder": 178,
    "position": 1,
    "text": "به کابل نیابد کس آرام و خواب"
  },
  {
    "poem_id": 1607,
    "vorder": 179,
    "position": 0,
    "text": "که یارد که پیش تو آید به جنگ"
  },
  {
    "poem_id": 1607,
    "vorder": 180,
    "position": 1,
    "text": "وگر تو بجنبی که سازد درنگ"
  },
  {
    "poem_id": 1607,
    "vorder": 181,
    "position": 0,
    "text": "برآنم که او زین پشمان شدست"
  },
  {
    "poem_id": 1607,
    "vorder": 182,
    "position": 1,
    "text": "وزین رفتنم سوی درمان شدست"
  },
  {
    "poem_id": 1607,
    "vorder": 183,
    "position": 0,
    "text": "بیارد کنون پیش خواهشگران"
  },
  {
    "poem_id": 1607,
    "vorder": 184,
    "position": 1,
    "text": "ز کابل گزیده فراوان سران"
  },
  {
    "poem_id": 1607,
    "vorder": 185,
    "position": 0,
    "text": "چنین گفت رستم که اینست راه"
  },
  {
    "poem_id": 1607,
    "vorder": 186,
    "position": 1,
    "text": "مرا خود به کابل نباید سپاه"
  },
  {
    "poem_id": 1607,
    "vorder": 187,
    "position": 0,
    "text": "زواره بس و نامور صد سوار"
  },
  {
    "poem_id": 1607,
    "vorder": 188,
    "position": 1,
    "text": "پیاده همان نیز صد نامدار"
  }
]