[
  {
    "poem_id": 1341,
    "vorder": 1,
    "position": 0,
    "text": "پسر بد مر او را یکی هوشمند"
  },
  {
    "poem_id": 1341,
    "vorder": 2,
    "position": 1,
    "text": "گرانمایه طهمورث دیو بند"
  },
  {
    "poem_id": 1341,
    "vorder": 3,
    "position": 0,
    "text": "بیامد به تخت پدر بر نشست"
  },
  {
    "poem_id": 1341,
    "vorder": 4,
    "position": 1,
    "text": "به شاهی کمر بر میان بر ببست"
  },
  {
    "poem_id": 1341,
    "vorder": 5,
    "position": 0,
    "text": "همه موبدان را ز لشکر بخواند"
  },
  {
    "poem_id": 1341,
    "vorder": 6,
    "position": 1,
    "text": "به خوبی چه مایه سخن‌ها براند"
  },
  {
    "poem_id": 1341,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت کامروز تخت و کلاه"
  },
  {
    "poem_id": 1341,
    "vorder": 8,
    "position": 1,
    "text": "مرا زیبد این تاج و گنج و سپاه"
  },
  {
    "poem_id": 1341,
    "vorder": 9,
    "position": 0,
    "text": "جهان از بدی‌ها بشویم به رای"
  },
  {
    "poem_id": 1341,
    "vorder": 10,
    "position": 1,
    "text": "پس آنگه کنم درگهی گرد پای"
  },
  {
    "poem_id": 1341,
    "vorder": 11,
    "position": 0,
    "text": "ز هر جای کوته کنم دست دیو"
  },
  {
    "poem_id": 1341,
    "vorder": 12,
    "position": 1,
    "text": "که من بود خواهم جهان را خدیو"
  },
  {
    "poem_id": 1341,
    "vorder": 13,
    "position": 0,
    "text": "هر آن چیز کاندر جهان سودمند"
  },
  {
    "poem_id": 1341,
    "vorder": 14,
    "position": 1,
    "text": "کنم آشکارا گشایم ز بند"
  },
  {
    "poem_id": 1341,
    "vorder": 15,
    "position": 0,
    "text": "پس از پشت میش و بره پشم و موی"
  },
  {
    "poem_id": 1341,
    "vorder": 16,
    "position": 1,
    "text": "برید و به رشتن نهادند روی"
  },
  {
    "poem_id": 1341,
    "vorder": 17,
    "position": 0,
    "text": "به کوشش از او کرد پوشش به رای"
  },
  {
    "poem_id": 1341,
    "vorder": 18,
    "position": 1,
    "text": "به گستردنی بد هم او رهنمای"
  },
  {
    "poem_id": 1341,
    "vorder": 19,
    "position": 0,
    "text": "ز پویندگان هر چه بد تیز رو"
  },
  {
    "poem_id": 1341,
    "vorder": 20,
    "position": 1,
    "text": "خورش کردشان سبزه و کاه و جو"
  },
  {
    "poem_id": 1341,
    "vorder": 21,
    "position": 0,
    "text": "رمنده ددان را همه بنگرید"
  },
  {
    "poem_id": 1341,
    "vorder": 22,
    "position": 1,
    "text": "سیه گوش و یوز از میان برگزید"
  },
  {
    "poem_id": 1341,
    "vorder": 23,
    "position": 0,
    "text": "به چاره بیاوردش از دشت و کوه"
  },
  {
    "poem_id": 1341,
    "vorder": 24,
    "position": 1,
    "text": "به بند آمدند آن که بد زان گروه"
  },
  {
    "poem_id": 1341,
    "vorder": 25,
    "position": 0,
    "text": "ز مرغان مر آن را که بد نیک تاز"
  },
  {
    "poem_id": 1341,
    "vorder": 26,
    "position": 1,
    "text": "چو باز و چو شاهین گردن فراز"
  },
  {
    "poem_id": 1341,
    "vorder": 27,
    "position": 0,
    "text": "بیاورد و آموختن‌شان گرفت"
  },
  {
    "poem_id": 1341,
    "vorder": 28,
    "position": 1,
    "text": "جهانی بدو مانده اندر شگفت"
  },
  {
    "poem_id": 1341,
    "vorder": 29,
    "position": 0,
    "text": "چو این کرده شد ماکیان و خروس"
  },
  {
    "poem_id": 1341,
    "vorder": 30,
    "position": 1,
    "text": "کجا بر خروشد گه زخم کوس"
  },
  {
    "poem_id": 1341,
    "vorder": 31,
    "position": 0,
    "text": "بیاورد و یک‌سر به مردم کشید"
  },
  {
    "poem_id": 1341,
    "vorder": 32,
    "position": 1,
    "text": "نهفته همه سودمندش گزید"
  },
  {
    "poem_id": 1341,
    "vorder": 33,
    "position": 0,
    "text": "بفرمودشان تا نوازند گرم"
  },
  {
    "poem_id": 1341,
    "vorder": 34,
    "position": 1,
    "text": "نخوانندشان جز به آواز نرم"
  },
  {
    "poem_id": 1341,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت کاین را ستایش کنید"
  },
  {
    "poem_id": 1341,
    "vorder": 36,
    "position": 1,
    "text": "جهان آفرین را نیایش کنید"
  },
  {
    "poem_id": 1341,
    "vorder": 37,
    "position": 0,
    "text": "که او دادمان بر ددان دستگاه"
  },
  {
    "poem_id": 1341,
    "vorder": 38,
    "position": 1,
    "text": "ستایش مر او را که بنمود راه"
  },
  {
    "poem_id": 1341,
    "vorder": 39,
    "position": 0,
    "text": "مر او را یکی پاک دستور بود"
  },
  {
    "poem_id": 1341,
    "vorder": 40,
    "position": 1,
    "text": "که رایش ز کردار بد دور بود"
  },
  {
    "poem_id": 1341,
    "vorder": 41,
    "position": 0,
    "text": "خنیده به هر جای شهرسپ نام"
  },
  {
    "poem_id": 1341,
    "vorder": 42,
    "position": 1,
    "text": "نزد جز به نیکی به هر جای گام"
  },
  {
    "poem_id": 1341,
    "vorder": 43,
    "position": 0,
    "text": "همه روز بسته ز خوردن دو لب"
  },
  {
    "poem_id": 1341,
    "vorder": 44,
    "position": 1,
    "text": "به پیش جهاندار بر پای شب"
  },
  {
    "poem_id": 1341,
    "vorder": 45,
    "position": 0,
    "text": "چنان بر دل هر کسی بود دوست"
  },
  {
    "poem_id": 1341,
    "vorder": 46,
    "position": 1,
    "text": "نماز شب و روزه آیین اوست"
  },
  {
    "poem_id": 1341,
    "vorder": 47,
    "position": 0,
    "text": "سر مایه بد اختر شاه را"
  },
  {
    "poem_id": 1341,
    "vorder": 48,
    "position": 1,
    "text": "در بسته بد جان بدخواه را"
  },
  {
    "poem_id": 1341,
    "vorder": 49,
    "position": 0,
    "text": "همه راه نیکی نمودی به شاه"
  },
  {
    "poem_id": 1341,
    "vorder": 50,
    "position": 1,
    "text": "همه راستی خواستی پایگاه"
  },
  {
    "poem_id": 1341,
    "vorder": 51,
    "position": 0,
    "text": "چنان شاه پالوده گشت از بدی"
  },
  {
    "poem_id": 1341,
    "vorder": 52,
    "position": 1,
    "text": "که تابید ازو فرّهٔ ایزدی"
  },
  {
    "poem_id": 1341,
    "vorder": 53,
    "position": 0,
    "text": "برفت اهرمن را به افسون ببست"
  },
  {
    "poem_id": 1341,
    "vorder": 54,
    "position": 1,
    "text": "چو بر تیز رو بارگی بر نشست"
  },
  {
    "poem_id": 1341,
    "vorder": 55,
    "position": 0,
    "text": "زمان تا زمان زینش بر ساختی"
  },
  {
    "poem_id": 1341,
    "vorder": 56,
    "position": 1,
    "text": "همی گرد گیتی‌ش بر تاختی"
  },
  {
    "poem_id": 1341,
    "vorder": 57,
    "position": 0,
    "text": "چو دیوان بدیدند کردار او"
  },
  {
    "poem_id": 1341,
    "vorder": 58,
    "position": 1,
    "text": "کشیدند گردن ز گفتار او"
  },
  {
    "poem_id": 1341,
    "vorder": 59,
    "position": 0,
    "text": "شدند انجمن دیو بسیار مر"
  },
  {
    "poem_id": 1341,
    "vorder": 60,
    "position": 1,
    "text": "که پردخته مانند از او تاج و فرّ"
  },
  {
    "poem_id": 1341,
    "vorder": 61,
    "position": 0,
    "text": "چو طهمورث آگه شد از کارشان"
  },
  {
    "poem_id": 1341,
    "vorder": 62,
    "position": 1,
    "text": "بر آشفت و بشکست بازارشان"
  },
  {
    "poem_id": 1341,
    "vorder": 63,
    "position": 0,
    "text": "به فرّ جهاندار بستش میان"
  },
  {
    "poem_id": 1341,
    "vorder": 64,
    "position": 1,
    "text": "به گردن بر آورد گرز گران"
  },
  {
    "poem_id": 1341,
    "vorder": 65,
    "position": 0,
    "text": "همه نرّه دیوان و افسونگران"
  },
  {
    "poem_id": 1341,
    "vorder": 66,
    "position": 1,
    "text": "برفتند جادو سپاهی گران"
  },
  {
    "poem_id": 1341,
    "vorder": 67,
    "position": 0,
    "text": "دمنده سیه دیوشان پیش‌رو"
  },
  {
    "poem_id": 1341,
    "vorder": 68,
    "position": 1,
    "text": "همی بآسمان برکشیدند غو"
  },
  {
    "poem_id": 1341,
    "vorder": 69,
    "position": 0,
    "text": "جهاندار طهمورث بافرین"
  },
  {
    "poem_id": 1341,
    "vorder": 70,
    "position": 1,
    "text": "بیامد کمربستهٔ جنگ و کین"
  },
  {
    "poem_id": 1341,
    "vorder": 71,
    "position": 0,
    "text": "یکایک بیاراست با دیو جنگ"
  },
  {
    "poem_id": 1341,
    "vorder": 72,
    "position": 1,
    "text": "نبد جنگشان را فراوان درنگ"
  },
  {
    "poem_id": 1341,
    "vorder": 73,
    "position": 0,
    "text": "از ایشان دو بهره به افسون ببست"
  },
  {
    "poem_id": 1341,
    "vorder": 74,
    "position": 1,
    "text": "دگرشان به گرز گران کرد پست"
  },
  {
    "poem_id": 1341,
    "vorder": 75,
    "position": 0,
    "text": "کشیدندشان خسته و بسته خوار"
  },
  {
    "poem_id": 1341,
    "vorder": 76,
    "position": 1,
    "text": "به جان خواستند آن زمان زینهار"
  },
  {
    "poem_id": 1341,
    "vorder": 77,
    "position": 0,
    "text": "که ما را مکش تا یکی نو هنر"
  },
  {
    "poem_id": 1341,
    "vorder": 78,
    "position": 1,
    "text": "بیاموزی از ما که‌ت آید به بر"
  },
  {
    "poem_id": 1341,
    "vorder": 79,
    "position": 0,
    "text": "کی نامور دادشان زینهار"
  },
  {
    "poem_id": 1341,
    "vorder": 80,
    "position": 1,
    "text": "بدان تا نهانی کنند آشکار"
  },
  {
    "poem_id": 1341,
    "vorder": 81,
    "position": 0,
    "text": "چو آزاد گشتند از بند او"
  },
  {
    "poem_id": 1341,
    "vorder": 82,
    "position": 1,
    "text": "بجستند ناچار پیوند او"
  },
  {
    "poem_id": 1341,
    "vorder": 83,
    "position": 0,
    "text": "نبشتن به خسرو بیاموختند"
  },
  {
    "poem_id": 1341,
    "vorder": 84,
    "position": 1,
    "text": "دلش را به دانش برافروختند"
  },
  {
    "poem_id": 1341,
    "vorder": 85,
    "position": 0,
    "text": "نبشتن یکی نه، که نزدیک سی"
  },
  {
    "poem_id": 1341,
    "vorder": 86,
    "position": 1,
    "text": "چه رومی، چه تازی و چه پارسی"
  },
  {
    "poem_id": 1341,
    "vorder": 87,
    "position": 0,
    "text": "چه سغدی، چه چینی و چه پهلوی"
  },
  {
    "poem_id": 1341,
    "vorder": 88,
    "position": 1,
    "text": "ز هر گونه‌ای کان همی بشنوی"
  },
  {
    "poem_id": 1341,
    "vorder": 89,
    "position": 0,
    "text": "جهاندار سی سال از این بیشتر"
  },
  {
    "poem_id": 1341,
    "vorder": 90,
    "position": 1,
    "text": "چه گونه پدید آوریدی هنر"
  },
  {
    "poem_id": 1341,
    "vorder": 91,
    "position": 0,
    "text": "برفت و سر آمد بر او روزگار"
  },
  {
    "poem_id": 1341,
    "vorder": 92,
    "position": 1,
    "text": "همه رنج او ماند از او یادگار"
  }
]