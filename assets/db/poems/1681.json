[
  {
    "poem_id": 1681,
    "vorder": 1,
    "position": 0,
    "text": "بدانست کش مرگ نزدیک شد"
  },
  {
    "poem_id": 1681,
    "vorder": 2,
    "position": 1,
    "text": "بروبر همی روز تاریک شد"
  },
  {
    "poem_id": 1681,
    "vorder": 3,
    "position": 0,
    "text": "بران بودش اندیشه کاندر جهان"
  },
  {
    "poem_id": 1681,
    "vorder": 4,
    "position": 1,
    "text": "نماند کسی از نژاد مهان"
  },
  {
    "poem_id": 1681,
    "vorder": 5,
    "position": 0,
    "text": "که لشکر کشد جنگ را سوی روم"
  },
  {
    "poem_id": 1681,
    "vorder": 6,
    "position": 1,
    "text": "نهد پی بران خاک آباد بوم"
  },
  {
    "poem_id": 1681,
    "vorder": 7,
    "position": 0,
    "text": "چو مغز اندرین کار خودکامه کرد"
  },
  {
    "poem_id": 1681,
    "vorder": 8,
    "position": 1,
    "text": "هم‌انگه سطالیس را نامه کرد"
  },
  {
    "poem_id": 1681,
    "vorder": 9,
    "position": 0,
    "text": "هرانکس کجا بد ز تخم کیان"
  },
  {
    "poem_id": 1681,
    "vorder": 10,
    "position": 1,
    "text": "بفرمودشان تا ببندد میان"
  },
  {
    "poem_id": 1681,
    "vorder": 11,
    "position": 0,
    "text": "همه روی را سوی درگه کنند"
  },
  {
    "poem_id": 1681,
    "vorder": 12,
    "position": 1,
    "text": "ز بدها گمانیش کوته کنند"
  },
  {
    "poem_id": 1681,
    "vorder": 13,
    "position": 0,
    "text": "چو این نامه بردند نزد حکیم"
  },
  {
    "poem_id": 1681,
    "vorder": 14,
    "position": 1,
    "text": "دل ارسطالیس شد به دو نیم"
  },
  {
    "poem_id": 1681,
    "vorder": 15,
    "position": 0,
    "text": "هم‌اندر زمان پاسخ نامه کرد"
  },
  {
    "poem_id": 1681,
    "vorder": 16,
    "position": 1,
    "text": "ز مژگان تو گفتی سر خامه کرد"
  },
  {
    "poem_id": 1681,
    "vorder": 17,
    "position": 0,
    "text": "که آن نامهٔ شاه گیهان رسید"
  },
  {
    "poem_id": 1681,
    "vorder": 18,
    "position": 1,
    "text": "ز بدکام دستش بباید کشید"
  },
  {
    "poem_id": 1681,
    "vorder": 19,
    "position": 0,
    "text": "ازان بد که کردی میندیش نیز"
  },
  {
    "poem_id": 1681,
    "vorder": 20,
    "position": 1,
    "text": "از اندیشه درویش را بخش چیز"
  },
  {
    "poem_id": 1681,
    "vorder": 21,
    "position": 0,
    "text": "بپرهیز و جان را به یزدان سپار"
  },
  {
    "poem_id": 1681,
    "vorder": 22,
    "position": 1,
    "text": "به گیتی جز از تخم نیکی مکار"
  },
  {
    "poem_id": 1681,
    "vorder": 23,
    "position": 0,
    "text": "همه مرگ راییم تا زنده‌ایم"
  },
  {
    "poem_id": 1681,
    "vorder": 24,
    "position": 1,
    "text": "به بیچارگی در سرافگنده‌ایم"
  },
  {
    "poem_id": 1681,
    "vorder": 25,
    "position": 0,
    "text": "نه هرکس که شد پادشاهی ببرد"
  },
  {
    "poem_id": 1681,
    "vorder": 26,
    "position": 1,
    "text": "برفت و بزرگی کسی را سپرد"
  },
  {
    "poem_id": 1681,
    "vorder": 27,
    "position": 0,
    "text": "بپرهیز و خون بزرگان مریز"
  },
  {
    "poem_id": 1681,
    "vorder": 28,
    "position": 1,
    "text": "که نفرین بود بر تو تا رستخیز"
  },
  {
    "poem_id": 1681,
    "vorder": 29,
    "position": 0,
    "text": "و دیگر که چون اندر ایران سپاه"
  },
  {
    "poem_id": 1681,
    "vorder": 30,
    "position": 1,
    "text": "نباشد همان شاه در پیش‌گاه"
  },
  {
    "poem_id": 1681,
    "vorder": 31,
    "position": 0,
    "text": "ز ترک و ز هند و ز سقلاب و چین"
  },
  {
    "poem_id": 1681,
    "vorder": 32,
    "position": 1,
    "text": "سپاه آید از هر سوی هم‌چنین"
  },
  {
    "poem_id": 1681,
    "vorder": 33,
    "position": 0,
    "text": "به روم آید آنکس که ایران گرفت"
  },
  {
    "poem_id": 1681,
    "vorder": 34,
    "position": 1,
    "text": "اگر کین بسیچد نباشد شگفت"
  },
  {
    "poem_id": 1681,
    "vorder": 35,
    "position": 0,
    "text": "هرآنکس که هست از نژاد کیان"
  },
  {
    "poem_id": 1681,
    "vorder": 36,
    "position": 1,
    "text": "نباید که از باد یابد زیان"
  },
  {
    "poem_id": 1681,
    "vorder": 37,
    "position": 0,
    "text": "بزرگان و آزادگان را بخوان"
  },
  {
    "poem_id": 1681,
    "vorder": 38,
    "position": 1,
    "text": "به بخش و به سور و به رای و به خوان"
  },
  {
    "poem_id": 1681,
    "vorder": 39,
    "position": 0,
    "text": "سزاوار هر مهتری کشوری"
  },
  {
    "poem_id": 1681,
    "vorder": 40,
    "position": 1,
    "text": "بیارای و آغاز کن دفتری"
  },
  {
    "poem_id": 1681,
    "vorder": 41,
    "position": 0,
    "text": "به نام بزرگان و آزادگان"
  },
  {
    "poem_id": 1681,
    "vorder": 42,
    "position": 1,
    "text": "کزیشان جهان یافتی رایگان"
  },
  {
    "poem_id": 1681,
    "vorder": 43,
    "position": 0,
    "text": "یکی را مده بر دگر دستگاه"
  },
  {
    "poem_id": 1681,
    "vorder": 44,
    "position": 1,
    "text": "کسی را مخوان بر جهان نیز شاه"
  },
  {
    "poem_id": 1681,
    "vorder": 45,
    "position": 0,
    "text": "سپر کن کیان را همه پیش بوم"
  },
  {
    "poem_id": 1681,
    "vorder": 46,
    "position": 1,
    "text": "چو خواهی که لشکر نیاید به روم"
  },
  {
    "poem_id": 1681,
    "vorder": 47,
    "position": 0,
    "text": "سکندر چو پاسخ بران گونه یافت"
  },
  {
    "poem_id": 1681,
    "vorder": 48,
    "position": 1,
    "text": "به اندیشه و رای دیگر شتافت"
  },
  {
    "poem_id": 1681,
    "vorder": 49,
    "position": 0,
    "text": "بزرگان و آزادگان را ز دهر"
  },
  {
    "poem_id": 1681,
    "vorder": 50,
    "position": 1,
    "text": "کسی را کش از مردمی بود بهر"
  },
  {
    "poem_id": 1681,
    "vorder": 51,
    "position": 0,
    "text": "بفرمود تا پیش او خواندند"
  },
  {
    "poem_id": 1681,
    "vorder": 52,
    "position": 1,
    "text": "به جای سزاوار بنشاندند"
  },
  {
    "poem_id": 1681,
    "vorder": 53,
    "position": 0,
    "text": "یکی عهد بنوشت تا هر یکی"
  },
  {
    "poem_id": 1681,
    "vorder": 54,
    "position": 1,
    "text": "فزونی نجوید ز دهر اندکی"
  },
  {
    "poem_id": 1681,
    "vorder": 55,
    "position": 0,
    "text": "بران نامداران جوینده کام"
  },
  {
    "poem_id": 1681,
    "vorder": 56,
    "position": 1,
    "text": "ملوک طوایف نهادند نام"
  },
  {
    "poem_id": 1681,
    "vorder": 57,
    "position": 0,
    "text": "همان شب سکندر به بابل رسید"
  },
  {
    "poem_id": 1681,
    "vorder": 58,
    "position": 1,
    "text": "مهان را به دیدار خود شاد دید"
  },
  {
    "poem_id": 1681,
    "vorder": 59,
    "position": 0,
    "text": "یکی کودک آمد زنی را به شب"
  },
  {
    "poem_id": 1681,
    "vorder": 60,
    "position": 1,
    "text": "بدو ماند هرکس که دیدش عجب"
  },
  {
    "poem_id": 1681,
    "vorder": 61,
    "position": 0,
    "text": "سرش چون سر شیر و بر پای سم"
  },
  {
    "poem_id": 1681,
    "vorder": 62,
    "position": 1,
    "text": "چو مردم بر و کتف و چون گاو دم"
  },
  {
    "poem_id": 1681,
    "vorder": 63,
    "position": 0,
    "text": "بمرد از شگفتی هم‌آنگه که زاد"
  },
  {
    "poem_id": 1681,
    "vorder": 64,
    "position": 1,
    "text": "سزد گر نباشد ازان زن نژاد"
  },
  {
    "poem_id": 1681,
    "vorder": 65,
    "position": 0,
    "text": "ببردند هم در زمان نزد شاه"
  },
  {
    "poem_id": 1681,
    "vorder": 66,
    "position": 1,
    "text": "بدو کرد شاه از شگفتی نگاه"
  },
  {
    "poem_id": 1681,
    "vorder": 67,
    "position": 0,
    "text": "به فالش بد آمد هم‌انگاه گفت"
  },
  {
    "poem_id": 1681,
    "vorder": 68,
    "position": 1,
    "text": "که این بچه در خاک باید نهفت"
  },
  {
    "poem_id": 1681,
    "vorder": 69,
    "position": 0,
    "text": "ز اخترشناسان بسی پیش خواند"
  },
  {
    "poem_id": 1681,
    "vorder": 70,
    "position": 1,
    "text": "وزان کودک مرده چندی براند"
  },
  {
    "poem_id": 1681,
    "vorder": 71,
    "position": 0,
    "text": "ستاره‌شمر زان غمی گشت سخت"
  },
  {
    "poem_id": 1681,
    "vorder": 72,
    "position": 1,
    "text": "بپوشید بر خسرو نیک‌بخت"
  },
  {
    "poem_id": 1681,
    "vorder": 73,
    "position": 0,
    "text": "ز اخترشناسان بپرسید و گفت"
  },
  {
    "poem_id": 1681,
    "vorder": 74,
    "position": 1,
    "text": "که گر هیچ ماند سخن در نهفت"
  },
  {
    "poem_id": 1681,
    "vorder": 75,
    "position": 0,
    "text": "هم‌اکنون ببرم سرانتان ز تن"
  },
  {
    "poem_id": 1681,
    "vorder": 76,
    "position": 1,
    "text": "نیابید جز کام شیران کفن"
  },
  {
    "poem_id": 1681,
    "vorder": 77,
    "position": 0,
    "text": "ستاره‌شمر چون برآشفت شاه"
  },
  {
    "poem_id": 1681,
    "vorder": 78,
    "position": 1,
    "text": "بدو گفت کای نامور پیشگاه"
  },
  {
    "poem_id": 1681,
    "vorder": 79,
    "position": 0,
    "text": "تو بر اختر شیر زادی نخست"
  },
  {
    "poem_id": 1681,
    "vorder": 80,
    "position": 1,
    "text": "بر موبدان و ردان شد درست"
  },
  {
    "poem_id": 1681,
    "vorder": 81,
    "position": 0,
    "text": "سر کودک مرده بینی چو شیر"
  },
  {
    "poem_id": 1681,
    "vorder": 82,
    "position": 1,
    "text": "بگردد سر پادشاهیت زیر"
  },
  {
    "poem_id": 1681,
    "vorder": 83,
    "position": 0,
    "text": "پرآشوب گردد زمین چندگاه"
  },
  {
    "poem_id": 1681,
    "vorder": 84,
    "position": 1,
    "text": "چنین تا نشیند یکی پیشگاه"
  },
  {
    "poem_id": 1681,
    "vorder": 85,
    "position": 0,
    "text": "ستاره‌شمر بیش ازین هرک بود"
  },
  {
    "poem_id": 1681,
    "vorder": 86,
    "position": 1,
    "text": "همی گفت و آن را نشانه نمود"
  },
  {
    "poem_id": 1681,
    "vorder": 87,
    "position": 0,
    "text": "سکندر چو بشنید زان شد غمی"
  },
  {
    "poem_id": 1681,
    "vorder": 88,
    "position": 1,
    "text": "به رای و به مغزش درآمد کمی"
  },
  {
    "poem_id": 1681,
    "vorder": 89,
    "position": 0,
    "text": "چنین گفت کز مرگ خود چاره نیست"
  },
  {
    "poem_id": 1681,
    "vorder": 90,
    "position": 1,
    "text": "مرا دل پر اندیشه زین باره نیست"
  },
  {
    "poem_id": 1681,
    "vorder": 91,
    "position": 0,
    "text": "مرا بیش ازین زندگانی نبود"
  },
  {
    "poem_id": 1681,
    "vorder": 92,
    "position": 1,
    "text": "زمانه نکاهد نخواهد فزود"
  }
]