[
  {
    "poem_id": 1702,
    "vorder": 1,
    "position": 0,
    "text": "ز شهر کجاران برآمد نفیر"
  },
  {
    "poem_id": 1702,
    "vorder": 2,
    "position": 1,
    "text": "برفتند با نیزه و تیغ و تیر"
  },
  {
    "poem_id": 1702,
    "vorder": 3,
    "position": 0,
    "text": "هیم رفت پیش اندرون هفتواد"
  },
  {
    "poem_id": 1702,
    "vorder": 4,
    "position": 1,
    "text": "به جنگ اندرون داد مردی بداد"
  },
  {
    "poem_id": 1702,
    "vorder": 5,
    "position": 0,
    "text": "همه شهر بگرفت و او را بکشت"
  },
  {
    "poem_id": 1702,
    "vorder": 6,
    "position": 1,
    "text": "بسی گوهر و گنجش آمد به مشت"
  },
  {
    "poem_id": 1702,
    "vorder": 7,
    "position": 0,
    "text": "به نزدیک او مردم انبوه شد"
  },
  {
    "poem_id": 1702,
    "vorder": 8,
    "position": 1,
    "text": "ز شهر کجاران سوی کوه شد"
  },
  {
    "poem_id": 1702,
    "vorder": 9,
    "position": 0,
    "text": "یکی دژ بکرد از بر تیغ کوه"
  },
  {
    "poem_id": 1702,
    "vorder": 10,
    "position": 1,
    "text": "شد آن شهر با او همه همگروه"
  },
  {
    "poem_id": 1702,
    "vorder": 11,
    "position": 0,
    "text": "نهاد اندران دژ دری آهنین"
  },
  {
    "poem_id": 1702,
    "vorder": 12,
    "position": 1,
    "text": "هم آرامگه بود هم جای کین"
  },
  {
    "poem_id": 1702,
    "vorder": 13,
    "position": 0,
    "text": "یکی چشمه‌ای بود بر کوهسار"
  },
  {
    "poem_id": 1702,
    "vorder": 14,
    "position": 1,
    "text": "ز تخت اندرآمد میان حصار"
  },
  {
    "poem_id": 1702,
    "vorder": 15,
    "position": 0,
    "text": "یکی باره‌ای کرد گرداندرش"
  },
  {
    "poem_id": 1702,
    "vorder": 16,
    "position": 1,
    "text": "که بینا به دیده ندیدی سرش"
  },
  {
    "poem_id": 1702,
    "vorder": 17,
    "position": 0,
    "text": "چو آن کرم را گشت صندوق تنگ"
  },
  {
    "poem_id": 1702,
    "vorder": 18,
    "position": 1,
    "text": "یکی حوض کردند بر کوه سنگ"
  },
  {
    "poem_id": 1702,
    "vorder": 19,
    "position": 0,
    "text": "چو ساروج و سنگ از هوا گشت گرم"
  },
  {
    "poem_id": 1702,
    "vorder": 20,
    "position": 1,
    "text": "نهادند کرم اندرو نرم نرم"
  },
  {
    "poem_id": 1702,
    "vorder": 21,
    "position": 0,
    "text": "چنان بد که دارنده هر بامداد"
  },
  {
    "poem_id": 1702,
    "vorder": 22,
    "position": 1,
    "text": "برفتی دوان از بر هفتواد"
  },
  {
    "poem_id": 1702,
    "vorder": 23,
    "position": 0,
    "text": "گزیدی به رنجش علف ساختی"
  },
  {
    "poem_id": 1702,
    "vorder": 24,
    "position": 1,
    "text": "تن آگنده کرم آن پرداختی"
  },
  {
    "poem_id": 1702,
    "vorder": 25,
    "position": 0,
    "text": "بر آمد برین کار بر پنج سال"
  },
  {
    "poem_id": 1702,
    "vorder": 26,
    "position": 1,
    "text": "چو پیلی شد آن کرم با شاخ و یال"
  },
  {
    "poem_id": 1702,
    "vorder": 27,
    "position": 0,
    "text": "چو یک چند بگذشت بر هفتواد"
  },
  {
    "poem_id": 1702,
    "vorder": 28,
    "position": 1,
    "text": "بر آواز آن کرم کرمان نهاد"
  },
  {
    "poem_id": 1702,
    "vorder": 29,
    "position": 0,
    "text": "همان دخت خرم نگهدار کرم"
  },
  {
    "poem_id": 1702,
    "vorder": 30,
    "position": 1,
    "text": "پدر گشته جنگی سپهدار کرم"
  },
  {
    "poem_id": 1702,
    "vorder": 31,
    "position": 0,
    "text": "بیاراستندش وزیر و دبیر"
  },
  {
    "poem_id": 1702,
    "vorder": 32,
    "position": 1,
    "text": "به رنجش بدی خوردن و شهد و شیر"
  },
  {
    "poem_id": 1702,
    "vorder": 33,
    "position": 0,
    "text": "سپهبد بدی بر دژ هفتواد"
  },
  {
    "poem_id": 1702,
    "vorder": 34,
    "position": 1,
    "text": "همان پرسش کار بیداد و داد"
  },
  {
    "poem_id": 1702,
    "vorder": 35,
    "position": 0,
    "text": "سپاهی و دستور و سالار بار"
  },
  {
    "poem_id": 1702,
    "vorder": 36,
    "position": 1,
    "text": "هران چیز کاید شهان را به کار"
  },
  {
    "poem_id": 1702,
    "vorder": 37,
    "position": 0,
    "text": "همه هرچ بایستش آراستند"
  },
  {
    "poem_id": 1702,
    "vorder": 38,
    "position": 1,
    "text": "چنانچون شهان را بپیراستند"
  },
  {
    "poem_id": 1702,
    "vorder": 39,
    "position": 0,
    "text": "به کشور پراگنده شد لشکرش"
  },
  {
    "poem_id": 1702,
    "vorder": 40,
    "position": 1,
    "text": "همه گشت آراسته کشورش"
  },
  {
    "poem_id": 1702,
    "vorder": 41,
    "position": 0,
    "text": "ز دریای چین تا به کرمان رسید"
  },
  {
    "poem_id": 1702,
    "vorder": 42,
    "position": 1,
    "text": "همه روی کشور سپه گسترید"
  },
  {
    "poem_id": 1702,
    "vorder": 43,
    "position": 0,
    "text": "پسر هفت با تیغ‌زن ده هزار"
  },
  {
    "poem_id": 1702,
    "vorder": 44,
    "position": 1,
    "text": "همان گنج با آلت کارزار"
  },
  {
    "poem_id": 1702,
    "vorder": 45,
    "position": 0,
    "text": "هران پادشا کو کشیدی به جنگ"
  },
  {
    "poem_id": 1702,
    "vorder": 46,
    "position": 1,
    "text": "چو رفتی سپاهش بر کرم تنگ"
  },
  {
    "poem_id": 1702,
    "vorder": 47,
    "position": 0,
    "text": "شکسته شدی لشکری کامدی"
  },
  {
    "poem_id": 1702,
    "vorder": 48,
    "position": 1,
    "text": "چو آواز این داستان بشندی"
  },
  {
    "poem_id": 1702,
    "vorder": 49,
    "position": 0,
    "text": "چنان شد دژ نامور هفتواد"
  },
  {
    "poem_id": 1702,
    "vorder": 50,
    "position": 1,
    "text": "که گردش نیارست جنبید باد"
  },
  {
    "poem_id": 1702,
    "vorder": 51,
    "position": 0,
    "text": "همی گشت هر روز برترش بخت"
  },
  {
    "poem_id": 1702,
    "vorder": 52,
    "position": 1,
    "text": "یکی خویشتن را بیاراست سخت"
  },
  {
    "poem_id": 1702,
    "vorder": 53,
    "position": 0,
    "text": "همی خواندندی ورا شهریار"
  },
  {
    "poem_id": 1702,
    "vorder": 54,
    "position": 1,
    "text": "سر مرد بخرد ازو در خمار"
  },
  {
    "poem_id": 1702,
    "vorder": 55,
    "position": 0,
    "text": "سپهبد که بودی به مرز اندرون"
  },
  {
    "poem_id": 1702,
    "vorder": 56,
    "position": 1,
    "text": "به یک چنگ در جنگ کردش زبون"
  },
  {
    "poem_id": 1702,
    "vorder": 57,
    "position": 0,
    "text": "نتابید با او کسی بر به جنگ"
  },
  {
    "poem_id": 1702,
    "vorder": 58,
    "position": 1,
    "text": "برآمد برین نیز چندی درنگ"
  },
  {
    "poem_id": 1702,
    "vorder": 59,
    "position": 0,
    "text": "حصاری شدش پر ز گنج و سپاه"
  },
  {
    "poem_id": 1702,
    "vorder": 60,
    "position": 1,
    "text": "ندیدی بران باره‌بر باد راه"
  }
]