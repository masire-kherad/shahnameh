[
  {
    "poem_id": 1750,
    "vorder": 1,
    "position": 0,
    "text": "چو بنشست بر گاه شاه اردشیر"
  },
  {
    "poem_id": 1750,
    "vorder": 2,
    "position": 1,
    "text": "بیاراست آن تخت شاپور پیر"
  },
  {
    "poem_id": 1750,
    "vorder": 3,
    "position": 0,
    "text": "کمر بست و ایرانیان را بخواند"
  },
  {
    "poem_id": 1750,
    "vorder": 4,
    "position": 1,
    "text": "بر پایهٔ تخت زرین نشاند"
  },
  {
    "poem_id": 1750,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کز دور چرخ بلند"
  },
  {
    "poem_id": 1750,
    "vorder": 6,
    "position": 1,
    "text": "نخواهم که باشد کسی را گزند"
  },
  {
    "poem_id": 1750,
    "vorder": 7,
    "position": 0,
    "text": "جهان گر شود رام با کام من"
  },
  {
    "poem_id": 1750,
    "vorder": 8,
    "position": 1,
    "text": "ببینند تیزی و آرام من"
  },
  {
    "poem_id": 1750,
    "vorder": 9,
    "position": 0,
    "text": "ور ایدونک با ما نسازد جهان"
  },
  {
    "poem_id": 1750,
    "vorder": 10,
    "position": 1,
    "text": "بسازیم ما با جهان جهان"
  },
  {
    "poem_id": 1750,
    "vorder": 11,
    "position": 0,
    "text": "برادر جهان ویژه ما را سپرد"
  },
  {
    "poem_id": 1750,
    "vorder": 12,
    "position": 1,
    "text": "ازیرا که فرزند او بود خرد"
  },
  {
    "poem_id": 1750,
    "vorder": 13,
    "position": 0,
    "text": "فرستم روان ورا آفرین"
  },
  {
    "poem_id": 1750,
    "vorder": 14,
    "position": 1,
    "text": "که از بدسگالان بشست او زمین"
  },
  {
    "poem_id": 1750,
    "vorder": 15,
    "position": 0,
    "text": "چو شاپور شاپور گردد بلند"
  },
  {
    "poem_id": 1750,
    "vorder": 16,
    "position": 1,
    "text": "شود نزد او گاه و تاج ارجمند"
  },
  {
    "poem_id": 1750,
    "vorder": 17,
    "position": 0,
    "text": "سپارم بدو گاه و تاج و سپاه"
  },
  {
    "poem_id": 1750,
    "vorder": 18,
    "position": 1,
    "text": "که پیمان چنین کرد شاپور شاه"
  },
  {
    "poem_id": 1750,
    "vorder": 19,
    "position": 0,
    "text": "من این تخت را پایکار وی‌ام"
  },
  {
    "poem_id": 1750,
    "vorder": 20,
    "position": 1,
    "text": "همان از پدر یادگار وی‌ام"
  },
  {
    "poem_id": 1750,
    "vorder": 21,
    "position": 0,
    "text": "شما یکسره داد یاد آورید"
  },
  {
    "poem_id": 1750,
    "vorder": 22,
    "position": 1,
    "text": "بکوشید و آیین و داد آورید"
  },
  {
    "poem_id": 1750,
    "vorder": 23,
    "position": 0,
    "text": "چنان دان که خوردیم و بر ما گذشت"
  },
  {
    "poem_id": 1750,
    "vorder": 24,
    "position": 1,
    "text": "چو مردی همه رنج ما باد گشت"
  },
  {
    "poem_id": 1750,
    "vorder": 25,
    "position": 0,
    "text": "چو ده سال گیتی همی داشت راست"
  },
  {
    "poem_id": 1750,
    "vorder": 26,
    "position": 1,
    "text": "بخورد و ببخشید چیزی که خواست"
  },
  {
    "poem_id": 1750,
    "vorder": 27,
    "position": 0,
    "text": "نجست از کسی باژ و ساو و خراج"
  },
  {
    "poem_id": 1750,
    "vorder": 28,
    "position": 1,
    "text": "همی رایگان داشت آن گاه و تاج"
  },
  {
    "poem_id": 1750,
    "vorder": 29,
    "position": 0,
    "text": "مر او را نکوکار زان خواندند"
  },
  {
    "poem_id": 1750,
    "vorder": 30,
    "position": 1,
    "text": "که هرکس تن‌آسان ازو ماندند"
  },
  {
    "poem_id": 1750,
    "vorder": 31,
    "position": 0,
    "text": "چو شاپور گشت از در تاج و گاه"
  },
  {
    "poem_id": 1750,
    "vorder": 32,
    "position": 1,
    "text": "مر او را سپرد آن خجسته کلاه"
  },
  {
    "poem_id": 1750,
    "vorder": 33,
    "position": 0,
    "text": "نگشت آن دلاور ز پیمان خویش"
  },
  {
    "poem_id": 1750,
    "vorder": 34,
    "position": 1,
    "text": "به مردی نگه داشت سامان خویش"
  }
]