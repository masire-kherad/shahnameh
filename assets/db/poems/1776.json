[
  {
    "poem_id": 1776,
    "vorder": 1,
    "position": 0,
    "text": "چو بنشست می خواست از بامداد"
  },
  {
    "poem_id": 1776,
    "vorder": 2,
    "position": 1,
    "text": "بزرگان لشکر برفتند شاد"
  },
  {
    "poem_id": 1776,
    "vorder": 3,
    "position": 0,
    "text": "بیامد هم‌انگه یکی مرد مه"
  },
  {
    "poem_id": 1776,
    "vorder": 4,
    "position": 1,
    "text": "ورا میوه آورد چندی ز ده"
  },
  {
    "poem_id": 1776,
    "vorder": 5,
    "position": 0,
    "text": "شتربارها نار و سیب و بهی"
  },
  {
    "poem_id": 1776,
    "vorder": 6,
    "position": 1,
    "text": "ز گل دسته‌ها کرده شاهنشهی"
  },
  {
    "poem_id": 1776,
    "vorder": 7,
    "position": 0,
    "text": "جهاندار چون دید بنواختش"
  },
  {
    "poem_id": 1776,
    "vorder": 8,
    "position": 1,
    "text": "میان یلان پایگه ساختش"
  },
  {
    "poem_id": 1776,
    "vorder": 9,
    "position": 0,
    "text": "همین مه که با میوه و بوی بود"
  },
  {
    "poem_id": 1776,
    "vorder": 10,
    "position": 1,
    "text": "ورا پهلوی نام کبروی بود"
  },
  {
    "poem_id": 1776,
    "vorder": 11,
    "position": 0,
    "text": "به روی جهاندار جام نبید"
  },
  {
    "poem_id": 1776,
    "vorder": 12,
    "position": 1,
    "text": "دو من را به یکبار اندر کشید"
  },
  {
    "poem_id": 1776,
    "vorder": 13,
    "position": 0,
    "text": "چو شد مرد خرم ز دیدار شاه"
  },
  {
    "poem_id": 1776,
    "vorder": 14,
    "position": 1,
    "text": "ازان نامداران و آن جشنگاه"
  },
  {
    "poem_id": 1776,
    "vorder": 15,
    "position": 0,
    "text": "یکی جام دیگر پر از می بلور"
  },
  {
    "poem_id": 1776,
    "vorder": 16,
    "position": 1,
    "text": "به دلش اندر افتاد زان جام شور"
  },
  {
    "poem_id": 1776,
    "vorder": 17,
    "position": 0,
    "text": "ز پیش بزرگان بیازید دست"
  },
  {
    "poem_id": 1776,
    "vorder": 18,
    "position": 1,
    "text": "بدان جام می تاخت و بر پای جست"
  },
  {
    "poem_id": 1776,
    "vorder": 19,
    "position": 0,
    "text": "به یاد شهنشاه بگرفت جام"
  },
  {
    "poem_id": 1776,
    "vorder": 20,
    "position": 1,
    "text": "منم گفت میخواره کبروی نام"
  },
  {
    "poem_id": 1776,
    "vorder": 21,
    "position": 0,
    "text": "به روی شهنشاه جام نبید"
  },
  {
    "poem_id": 1776,
    "vorder": 22,
    "position": 1,
    "text": "چو من درکشم یار خواهم گزید"
  },
  {
    "poem_id": 1776,
    "vorder": 23,
    "position": 0,
    "text": "به جام اندرون بود می پنج من"
  },
  {
    "poem_id": 1776,
    "vorder": 24,
    "position": 1,
    "text": "خورم هفت ازین بر سر انجمن"
  },
  {
    "poem_id": 1776,
    "vorder": 25,
    "position": 0,
    "text": "پس انگه سوی ده روم من به هوش"
  },
  {
    "poem_id": 1776,
    "vorder": 26,
    "position": 1,
    "text": "ز من نشنود کس به مستی خروش"
  },
  {
    "poem_id": 1776,
    "vorder": 27,
    "position": 0,
    "text": "چنان هفت جام پر از می بخورد"
  },
  {
    "poem_id": 1776,
    "vorder": 28,
    "position": 1,
    "text": "ازان می پرستان برآورد گرد"
  },
  {
    "poem_id": 1776,
    "vorder": 29,
    "position": 0,
    "text": "به دستوری شاه بیرون گذشت"
  },
  {
    "poem_id": 1776,
    "vorder": 30,
    "position": 1,
    "text": "که داند که می در تنش چون گذشت"
  },
  {
    "poem_id": 1776,
    "vorder": 31,
    "position": 0,
    "text": "وزان جای خرم بیامد به دشت"
  },
  {
    "poem_id": 1776,
    "vorder": 32,
    "position": 1,
    "text": "چو در سینهٔ مرد، می گرم گشت"
  },
  {
    "poem_id": 1776,
    "vorder": 33,
    "position": 0,
    "text": "برانگیخت اسپ از میان گروه"
  },
  {
    "poem_id": 1776,
    "vorder": 34,
    "position": 1,
    "text": "ز هامون همی تاخت تا پیش کوه"
  },
  {
    "poem_id": 1776,
    "vorder": 35,
    "position": 0,
    "text": "فرود آمد از باره جایی نهفت"
  },
  {
    "poem_id": 1776,
    "vorder": 36,
    "position": 1,
    "text": "یله کرد و در سایهٔ کوه خفت"
  },
  {
    "poem_id": 1776,
    "vorder": 37,
    "position": 0,
    "text": "ز کوه اندرآمد کلاغ سیاه"
  },
  {
    "poem_id": 1776,
    "vorder": 38,
    "position": 1,
    "text": "دو چشمش بکند اندران خوابگاه"
  },
  {
    "poem_id": 1776,
    "vorder": 39,
    "position": 0,
    "text": "همی تاختند از پس‌اندر گروه"
  },
  {
    "poem_id": 1776,
    "vorder": 40,
    "position": 1,
    "text": "ورا مرده دیدند بر پیش کوه"
  },
  {
    "poem_id": 1776,
    "vorder": 41,
    "position": 0,
    "text": "دو چشمش ز سر کنده زاغ سیاه"
  },
  {
    "poem_id": 1776,
    "vorder": 42,
    "position": 1,
    "text": "برش اسپ او ایستاده به راه"
  },
  {
    "poem_id": 1776,
    "vorder": 43,
    "position": 0,
    "text": "برو کهترانش خروشان شدند"
  },
  {
    "poem_id": 1776,
    "vorder": 44,
    "position": 1,
    "text": "وزان مجلس و جام جوشان شدند"
  },
  {
    "poem_id": 1776,
    "vorder": 45,
    "position": 0,
    "text": "چو بهرام برخاست از خوابگاه"
  },
  {
    "poem_id": 1776,
    "vorder": 46,
    "position": 1,
    "text": "بیامد بر او یکی نیک‌خواه"
  },
  {
    "poem_id": 1776,
    "vorder": 47,
    "position": 0,
    "text": "که کبروی را چشم روشن کلاغ"
  },
  {
    "poem_id": 1776,
    "vorder": 48,
    "position": 1,
    "text": "ز مستی بکندست در پیش راغ"
  },
  {
    "poem_id": 1776,
    "vorder": 49,
    "position": 0,
    "text": "رخ شهریار جهان زرد شد"
  },
  {
    "poem_id": 1776,
    "vorder": 50,
    "position": 1,
    "text": "ز تیمار کبروی پر درد شد"
  },
  {
    "poem_id": 1776,
    "vorder": 51,
    "position": 0,
    "text": "هم‌انگه برآمد ز درگه خروش"
  },
  {
    "poem_id": 1776,
    "vorder": 52,
    "position": 1,
    "text": "که ای نامداران با فر و هوش"
  },
  {
    "poem_id": 1776,
    "vorder": 53,
    "position": 0,
    "text": "حرامست می در جهان سربسر"
  },
  {
    "poem_id": 1776,
    "vorder": 54,
    "position": 1,
    "text": "اگر زیردستت گر نامور"
  }
]