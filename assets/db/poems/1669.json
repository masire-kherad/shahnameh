[
  {
    "poem_id": 1669,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه رفت خورشیدفش"
  },
  {
    "poem_id": 1669,
    "vorder": 2,
    "position": 1,
    "text": "بیامد دمان تا زمین حبش"
  },
  {
    "poem_id": 1669,
    "vorder": 3,
    "position": 0,
    "text": "ز مردم زمین بود چون پر زاغ"
  },
  {
    "poem_id": 1669,
    "vorder": 4,
    "position": 1,
    "text": "سیه گشته و چشمها چون چراغ"
  },
  {
    "poem_id": 1669,
    "vorder": 5,
    "position": 0,
    "text": "تناور یکی لشکری زورمند"
  },
  {
    "poem_id": 1669,
    "vorder": 6,
    "position": 1,
    "text": "برهنه تن و پوست و بالابلند"
  },
  {
    "poem_id": 1669,
    "vorder": 7,
    "position": 0,
    "text": "چو از دور دیدند گرد سپاه"
  },
  {
    "poem_id": 1669,
    "vorder": 8,
    "position": 1,
    "text": "خروشی برآمد ز ابر سیاه"
  },
  {
    "poem_id": 1669,
    "vorder": 9,
    "position": 0,
    "text": "سپاه انجمن شد هزاران هزار"
  },
  {
    "poem_id": 1669,
    "vorder": 10,
    "position": 1,
    "text": "وران تیره شد دیدهٔ شهریار"
  },
  {
    "poem_id": 1669,
    "vorder": 11,
    "position": 0,
    "text": "به سوی سکندر نهادند سر"
  },
  {
    "poem_id": 1669,
    "vorder": 12,
    "position": 1,
    "text": "بکشتند بسیار پرخاشخر"
  },
  {
    "poem_id": 1669,
    "vorder": 13,
    "position": 0,
    "text": "به جای سنان استخوان داشتند"
  },
  {
    "poem_id": 1669,
    "vorder": 14,
    "position": 1,
    "text": "همی بر تن مرد بگذاشتند"
  },
  {
    "poem_id": 1669,
    "vorder": 15,
    "position": 0,
    "text": "به لشکر بفرمود پس شهریار"
  },
  {
    "poem_id": 1669,
    "vorder": 16,
    "position": 1,
    "text": "که برداشتند آلت کارزار"
  },
  {
    "poem_id": 1669,
    "vorder": 17,
    "position": 0,
    "text": "برهنه به جنگ اندر آمد حبش"
  },
  {
    "poem_id": 1669,
    "vorder": 18,
    "position": 1,
    "text": "غمی گشت زان لشکر شیرفش"
  },
  {
    "poem_id": 1669,
    "vorder": 19,
    "position": 0,
    "text": "بکشتند زیشان فزون از شمار"
  },
  {
    "poem_id": 1669,
    "vorder": 20,
    "position": 1,
    "text": "بپیچید دیگر سر از کارزار"
  },
  {
    "poem_id": 1669,
    "vorder": 21,
    "position": 0,
    "text": "ز خون ریختن گشت روی زمین"
  },
  {
    "poem_id": 1669,
    "vorder": 22,
    "position": 1,
    "text": "سراسر به کردار دریای چین"
  },
  {
    "poem_id": 1669,
    "vorder": 23,
    "position": 0,
    "text": "چو از خون در و دشت آلوده شد"
  },
  {
    "poem_id": 1669,
    "vorder": 24,
    "position": 1,
    "text": "ز کشته به هر جای بر توده شد"
  },
  {
    "poem_id": 1669,
    "vorder": 25,
    "position": 0,
    "text": "چو بر توده خاشاکها برزدند"
  },
  {
    "poem_id": 1669,
    "vorder": 26,
    "position": 1,
    "text": "بفرمود تا آتش اندر زدند"
  },
  {
    "poem_id": 1669,
    "vorder": 27,
    "position": 0,
    "text": "چو شب گشت بشنید آواز گرگ"
  },
  {
    "poem_id": 1669,
    "vorder": 28,
    "position": 1,
    "text": "سکندر بپوشید خفتان و ترگ"
  },
  {
    "poem_id": 1669,
    "vorder": 29,
    "position": 0,
    "text": "یکی پیش رو بود مهتر ز پیل"
  },
  {
    "poem_id": 1669,
    "vorder": 30,
    "position": 1,
    "text": "به سر بر سرو داشت همرنگ نیل"
  },
  {
    "poem_id": 1669,
    "vorder": 31,
    "position": 0,
    "text": "ازین نامداران فراوان بکشت"
  },
  {
    "poem_id": 1669,
    "vorder": 32,
    "position": 1,
    "text": "بسی حمله بردند و ننمود پشت"
  },
  {
    "poem_id": 1669,
    "vorder": 33,
    "position": 0,
    "text": "بکشتند فرجام کارش به تیر"
  },
  {
    "poem_id": 1669,
    "vorder": 34,
    "position": 1,
    "text": "یکی آهنین کوه بد پیل گیر"
  },
  {
    "poem_id": 1669,
    "vorder": 35,
    "position": 0,
    "text": "وزان جایگه تیز لشکر براند"
  },
  {
    "poem_id": 1669,
    "vorder": 36,
    "position": 1,
    "text": "بسی نام دادار گیهان بخواند"
  }
]