[
  {
    "poem_id": 1894,
    "vorder": 1,
    "position": 0,
    "text": "برآمد برین روزگاری دراز"
  },
  {
    "poem_id": 1894,
    "vorder": 2,
    "position": 1,
    "text": "نبد گردیه را به چیزی نیاز"
  },
  {
    "poem_id": 1894,
    "vorder": 3,
    "position": 0,
    "text": "چنین می همی‌خورد با بخردان"
  },
  {
    "poem_id": 1894,
    "vorder": 4,
    "position": 1,
    "text": "بزرگان و رزم آزموده ردان"
  },
  {
    "poem_id": 1894,
    "vorder": 5,
    "position": 0,
    "text": "بدان مجلس اندر یکی جام بود"
  },
  {
    "poem_id": 1894,
    "vorder": 6,
    "position": 1,
    "text": "نوشته برو نام بهرام بود"
  },
  {
    "poem_id": 1894,
    "vorder": 7,
    "position": 0,
    "text": "بفرمود تا جام بنداختند"
  },
  {
    "poem_id": 1894,
    "vorder": 8,
    "position": 1,
    "text": "وزان هرکسی دل بپرداختند"
  },
  {
    "poem_id": 1894,
    "vorder": 9,
    "position": 0,
    "text": "گرفتند نفرین به بهرام بر"
  },
  {
    "poem_id": 1894,
    "vorder": 10,
    "position": 1,
    "text": "بران جام و آرندهٔ جام بر"
  },
  {
    "poem_id": 1894,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت که اکنون بر بوم ری"
  },
  {
    "poem_id": 1894,
    "vorder": 12,
    "position": 1,
    "text": "به کوبند پیلان جنگی بپی"
  },
  {
    "poem_id": 1894,
    "vorder": 13,
    "position": 0,
    "text": "همه مردم از شهر بیرون کنند"
  },
  {
    "poem_id": 1894,
    "vorder": 14,
    "position": 1,
    "text": "همه ری بپی دشت و هامون کنند"
  },
  {
    "poem_id": 1894,
    "vorder": 15,
    "position": 0,
    "text": "گرانمایه دستور با شهریار"
  },
  {
    "poem_id": 1894,
    "vorder": 16,
    "position": 1,
    "text": "چنین گفت کای از کیان یادگار"
  },
  {
    "poem_id": 1894,
    "vorder": 17,
    "position": 0,
    "text": "نگه کن که شهری بزرگست ری"
  },
  {
    "poem_id": 1894,
    "vorder": 18,
    "position": 1,
    "text": "نشاید که کوبند پیلان بپی"
  },
  {
    "poem_id": 1894,
    "vorder": 19,
    "position": 0,
    "text": "که یزدان دران کار همداستان"
  },
  {
    "poem_id": 1894,
    "vorder": 20,
    "position": 1,
    "text": "نباشد نه هم بر زمین راستان"
  },
  {
    "poem_id": 1894,
    "vorder": 21,
    "position": 0,
    "text": "به دستور گفت آن زمان شهریار"
  },
  {
    "poem_id": 1894,
    "vorder": 22,
    "position": 1,
    "text": "که بد گوهری باید و نابکار"
  },
  {
    "poem_id": 1894,
    "vorder": 23,
    "position": 0,
    "text": "که یک چند باشد بری مرزبان"
  },
  {
    "poem_id": 1894,
    "vorder": 24,
    "position": 1,
    "text": "یکی مرد بی دانش و بد زبان"
  },
  {
    "poem_id": 1894,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت بهمن که گر شهریار"
  },
  {
    "poem_id": 1894,
    "vorder": 26,
    "position": 1,
    "text": "بخواهد نشان چنین نابکار"
  },
  {
    "poem_id": 1894,
    "vorder": 27,
    "position": 0,
    "text": "بجوییم و این را بجا آوریم"
  },
  {
    "poem_id": 1894,
    "vorder": 28,
    "position": 1,
    "text": "نباید که بی‌رهنما آوریم"
  },
  {
    "poem_id": 1894,
    "vorder": 29,
    "position": 0,
    "text": "چنین گفت خسرو که بسیارگوی"
  },
  {
    "poem_id": 1894,
    "vorder": 30,
    "position": 1,
    "text": "نژند اختری بایدم سرخ موی"
  },
  {
    "poem_id": 1894,
    "vorder": 31,
    "position": 0,
    "text": "تنش سرخ و بینی کژ وروی زشت"
  },
  {
    "poem_id": 1894,
    "vorder": 32,
    "position": 1,
    "text": "همان دوزخی روی دور از بهشت"
  },
  {
    "poem_id": 1894,
    "vorder": 33,
    "position": 0,
    "text": "یکی مرد بدنام و رخساره زرد"
  },
  {
    "poem_id": 1894,
    "vorder": 34,
    "position": 1,
    "text": "بد اندیش و کوتاه دل پر ز درد"
  },
  {
    "poem_id": 1894,
    "vorder": 35,
    "position": 0,
    "text": "همان بد دل و سفله و بی‌فروغ"
  },
  {
    "poem_id": 1894,
    "vorder": 36,
    "position": 1,
    "text": "سرش پر ز کین و زبان پر دروغ"
  },
  {
    "poem_id": 1894,
    "vorder": 37,
    "position": 0,
    "text": "دو چشمش کژ و سبز و دندان بزرگ"
  },
  {
    "poem_id": 1894,
    "vorder": 38,
    "position": 1,
    "text": "براه اندرون کژ رود همچو گرگ"
  },
  {
    "poem_id": 1894,
    "vorder": 39,
    "position": 0,
    "text": "همه موبدان مانده زو در شگفت"
  },
  {
    "poem_id": 1894,
    "vorder": 40,
    "position": 1,
    "text": "که تا یاد خسرو چنین چون گرفت"
  },
  {
    "poem_id": 1894,
    "vorder": 41,
    "position": 0,
    "text": "همی‌جست هرکس بگرد جهان"
  },
  {
    "poem_id": 1894,
    "vorder": 42,
    "position": 1,
    "text": "ز شهر کسان از کهان و مهان"
  },
  {
    "poem_id": 1894,
    "vorder": 43,
    "position": 0,
    "text": "چنان بد که روزی یکی نزد شاه"
  },
  {
    "poem_id": 1894,
    "vorder": 44,
    "position": 1,
    "text": "بیامد کزین گونه مردی به راه"
  },
  {
    "poem_id": 1894,
    "vorder": 45,
    "position": 0,
    "text": "بدیدم بیارم به فرمان کی"
  },
  {
    "poem_id": 1894,
    "vorder": 46,
    "position": 1,
    "text": "بدان تا فرستدش خسرو به ری"
  },
  {
    "poem_id": 1894,
    "vorder": 47,
    "position": 0,
    "text": "بفرمود تا نزد او آورند"
  },
  {
    "poem_id": 1894,
    "vorder": 48,
    "position": 1,
    "text": "وز آنگونه بازی بکو آورند"
  },
  {
    "poem_id": 1894,
    "vorder": 49,
    "position": 0,
    "text": "ببردند زین گونه مردی برش"
  },
  {
    "poem_id": 1894,
    "vorder": 50,
    "position": 1,
    "text": "بخندید زو کشور و لشکرش"
  },
  {
    "poem_id": 1894,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت خسرو ز کردار بد"
  },
  {
    "poem_id": 1894,
    "vorder": 52,
    "position": 1,
    "text": "چه داری بیاد ای بد بی‌خرد"
  },
  {
    "poem_id": 1894,
    "vorder": 53,
    "position": 0,
    "text": "چنین گفت با شاه کز کار بد"
  },
  {
    "poem_id": 1894,
    "vorder": 54,
    "position": 1,
    "text": "نیاسایم و نیست با من خرد"
  },
  {
    "poem_id": 1894,
    "vorder": 55,
    "position": 0,
    "text": "سخن هرچ گویی دگرگون کنم"
  },
  {
    "poem_id": 1894,
    "vorder": 56,
    "position": 1,
    "text": "تن و جان مردم پر از خون کنم"
  },
  {
    "poem_id": 1894,
    "vorder": 57,
    "position": 0,
    "text": "سرمایهٔ من دروغست و بس"
  },
  {
    "poem_id": 1894,
    "vorder": 58,
    "position": 1,
    "text": "سوی راستی نیستم دست رس"
  },
  {
    "poem_id": 1894,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت خسرو که بد اخترت"
  },
  {
    "poem_id": 1894,
    "vorder": 60,
    "position": 1,
    "text": "نوشته مبادا جزین بر سرت"
  },
  {
    "poem_id": 1894,
    "vorder": 61,
    "position": 0,
    "text": "به دیوان نوشتند منشور ری"
  },
  {
    "poem_id": 1894,
    "vorder": 62,
    "position": 1,
    "text": "ز زشتی بزرگی شد آن شوم پی"
  },
  {
    "poem_id": 1894,
    "vorder": 63,
    "position": 0,
    "text": "سپاه پراگنده او را سپرد"
  },
  {
    "poem_id": 1894,
    "vorder": 64,
    "position": 1,
    "text": "برفت از درو نام زشتی ببرد"
  },
  {
    "poem_id": 1894,
    "vorder": 65,
    "position": 0,
    "text": "چوآمد بری مرد ناتندرست"
  },
  {
    "poem_id": 1894,
    "vorder": 66,
    "position": 1,
    "text": "دل و دیده از شرم یزدان بشست"
  },
  {
    "poem_id": 1894,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود تا ناودانهای بام"
  },
  {
    "poem_id": 1894,
    "vorder": 68,
    "position": 1,
    "text": "بکندند و او شد بران شادکام"
  },
  {
    "poem_id": 1894,
    "vorder": 69,
    "position": 0,
    "text": "وزان پس همه گربکان رابکشت"
  },
  {
    "poem_id": 1894,
    "vorder": 70,
    "position": 1,
    "text": "دل کد خدایان ازو شد درشت"
  },
  {
    "poem_id": 1894,
    "vorder": 71,
    "position": 0,
    "text": "به هرسو همی‌رفت با رهنمای"
  },
  {
    "poem_id": 1894,
    "vorder": 72,
    "position": 1,
    "text": "منادیگری پیش او بر بپای"
  },
  {
    "poem_id": 1894,
    "vorder": 73,
    "position": 0,
    "text": "همی‌گفت گر ناودانی بجای"
  },
  {
    "poem_id": 1894,
    "vorder": 74,
    "position": 1,
    "text": "ببینی و گر گربه‌ای در سرای"
  },
  {
    "poem_id": 1894,
    "vorder": 75,
    "position": 0,
    "text": "بدان بوم وبر آتش اندر زنم"
  },
  {
    "poem_id": 1894,
    "vorder": 76,
    "position": 1,
    "text": "ز برشان همی سنگ بر سرزنم"
  },
  {
    "poem_id": 1894,
    "vorder": 77,
    "position": 0,
    "text": "همی‌جست جایی که بد یک درم"
  },
  {
    "poem_id": 1894,
    "vorder": 78,
    "position": 1,
    "text": "خداوند او را فگندی به غم"
  },
  {
    "poem_id": 1894,
    "vorder": 79,
    "position": 0,
    "text": "همه خانه از موش بگذاشتند"
  },
  {
    "poem_id": 1894,
    "vorder": 80,
    "position": 1,
    "text": "دل از بوم آباد برداشتند"
  },
  {
    "poem_id": 1894,
    "vorder": 81,
    "position": 0,
    "text": "چو باران بدی ناودانی نبود"
  },
  {
    "poem_id": 1894,
    "vorder": 82,
    "position": 1,
    "text": "به شهر اندرون پاسبانی نبود"
  },
  {
    "poem_id": 1894,
    "vorder": 83,
    "position": 0,
    "text": "ازان زشت بد کامهٔ شوم پی"
  },
  {
    "poem_id": 1894,
    "vorder": 84,
    "position": 1,
    "text": "که آمد ز درگاه خسرو بری"
  },
  {
    "poem_id": 1894,
    "vorder": 85,
    "position": 0,
    "text": "شد آن شهر آباد یکسر خراب"
  },
  {
    "poem_id": 1894,
    "vorder": 86,
    "position": 1,
    "text": "به سر بر همی‌تافتی آفتاب"
  },
  {
    "poem_id": 1894,
    "vorder": 87,
    "position": 0,
    "text": "همه شهر یکسر پر از داغ و درد"
  },
  {
    "poem_id": 1894,
    "vorder": 88,
    "position": 1,
    "text": "کس اندر جهان یاد ایشان نکرد"
  }
]