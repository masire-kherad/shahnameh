[
  {
    "poem_id": 1386,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تابنده شد ناپدید"
  },
  {
    "poem_id": 1386,
    "vorder": 2,
    "position": 1,
    "text": "در حجره بستند و گم شد کلید"
  },
  {
    "poem_id": 1386,
    "vorder": 3,
    "position": 0,
    "text": "پرستنده شد سوی دستان سام"
  },
  {
    "poem_id": 1386,
    "vorder": 4,
    "position": 1,
    "text": "که شد ساخته کار بگذار گام"
  },
  {
    "poem_id": 1386,
    "vorder": 5,
    "position": 0,
    "text": "سپهبد سوی کاخ بنهاد روی"
  },
  {
    "poem_id": 1386,
    "vorder": 6,
    "position": 1,
    "text": "چنان چون بود مردم جفت جوی"
  },
  {
    "poem_id": 1386,
    "vorder": 7,
    "position": 0,
    "text": "برآمد سیه چشم گلرخ به بام"
  },
  {
    "poem_id": 1386,
    "vorder": 8,
    "position": 1,
    "text": "چو سرو سهی بر سرش ماه تام"
  },
  {
    "poem_id": 1386,
    "vorder": 9,
    "position": 0,
    "text": "چو از دور دستان سام سوار"
  },
  {
    "poem_id": 1386,
    "vorder": 10,
    "position": 1,
    "text": "پدید آمد آن دختر نامدار"
  },
  {
    "poem_id": 1386,
    "vorder": 11,
    "position": 0,
    "text": "دو بیجاده بگشاد و آواز داد"
  },
  {
    "poem_id": 1386,
    "vorder": 12,
    "position": 1,
    "text": "که شاد آمدی ای جوانمرد شاد"
  },
  {
    "poem_id": 1386,
    "vorder": 13,
    "position": 0,
    "text": "درود جهان آفرین بر تو باد"
  },
  {
    "poem_id": 1386,
    "vorder": 14,
    "position": 1,
    "text": "خم چرخ گردان زمین تو باد"
  },
  {
    "poem_id": 1386,
    "vorder": 15,
    "position": 0,
    "text": "پیاده بدین سان ز پرده سرای"
  },
  {
    "poem_id": 1386,
    "vorder": 16,
    "position": 1,
    "text": "برنجیدت این خسروانی دو پای"
  },
  {
    "poem_id": 1386,
    "vorder": 17,
    "position": 0,
    "text": "سپهبد کزان گونه آوا شنید"
  },
  {
    "poem_id": 1386,
    "vorder": 18,
    "position": 1,
    "text": "نگه کرد و خورشید رخ را بدید"
  },
  {
    "poem_id": 1386,
    "vorder": 19,
    "position": 0,
    "text": "شده بام از آن گوهر تابناک"
  },
  {
    "poem_id": 1386,
    "vorder": 20,
    "position": 1,
    "text": "به جای گل سرخ یاقوت خاک"
  },
  {
    "poem_id": 1386,
    "vorder": 21,
    "position": 0,
    "text": "چنین داد پاسخ که ای ماه چهر"
  },
  {
    "poem_id": 1386,
    "vorder": 22,
    "position": 1,
    "text": "درودت ز من آفرین از سپهر"
  },
  {
    "poem_id": 1386,
    "vorder": 23,
    "position": 0,
    "text": "چه مایه شبان دیده اندر سماک"
  },
  {
    "poem_id": 1386,
    "vorder": 24,
    "position": 1,
    "text": "خروشان بدم پیش یزدان پاک"
  },
  {
    "poem_id": 1386,
    "vorder": 25,
    "position": 0,
    "text": "همی خواستم تا خدای جهان"
  },
  {
    "poem_id": 1386,
    "vorder": 26,
    "position": 1,
    "text": "نماید مرا رویت اندر نهان"
  },
  {
    "poem_id": 1386,
    "vorder": 27,
    "position": 0,
    "text": "کنون شاد گشتم به آواز تو"
  },
  {
    "poem_id": 1386,
    "vorder": 28,
    "position": 1,
    "text": "بدین خوب گفتار با ناز تو"
  },
  {
    "poem_id": 1386,
    "vorder": 29,
    "position": 0,
    "text": "یکی چارهٔ راه دیدار جوی"
  },
  {
    "poem_id": 1386,
    "vorder": 30,
    "position": 1,
    "text": "چه پرسی تو بر باره و من به کوی"
  },
  {
    "poem_id": 1386,
    "vorder": 31,
    "position": 0,
    "text": "پری روی گفت سپهبد شنود"
  },
  {
    "poem_id": 1386,
    "vorder": 32,
    "position": 1,
    "text": "سر شعر گلنار بگشاد زود"
  },
  {
    "poem_id": 1386,
    "vorder": 33,
    "position": 0,
    "text": "کمندی گشاد او ز سرو بلند"
  },
  {
    "poem_id": 1386,
    "vorder": 34,
    "position": 1,
    "text": "کس از مشک زان سان نپیچد کمند"
  },
  {
    "poem_id": 1386,
    "vorder": 35,
    "position": 0,
    "text": "خم اندر خم و مار بر مار بر"
  },
  {
    "poem_id": 1386,
    "vorder": 36,
    "position": 1,
    "text": "بران غبغبش نار بر نار بر"
  },
  {
    "poem_id": 1386,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت بر تاز و برکش میان"
  },
  {
    "poem_id": 1386,
    "vorder": 38,
    "position": 1,
    "text": "بر شیر بگشای و چنگ کیان"
  },
  {
    "poem_id": 1386,
    "vorder": 39,
    "position": 0,
    "text": "بگیر این سیه گیسو از یک سوم"
  },
  {
    "poem_id": 1386,
    "vorder": 40,
    "position": 1,
    "text": "ز بهر تو باید همی گیسوم"
  },
  {
    "poem_id": 1386,
    "vorder": 41,
    "position": 0,
    "text": "نگه کرد زال اندران ماه روی"
  },
  {
    "poem_id": 1386,
    "vorder": 42,
    "position": 1,
    "text": "شگفتی بماند اندران روی و موی"
  },
  {
    "poem_id": 1386,
    "vorder": 43,
    "position": 0,
    "text": "چنین داد پاسخ که این نیست داد"
  },
  {
    "poem_id": 1386,
    "vorder": 44,
    "position": 1,
    "text": "چنین روز خورشید روشن مباد"
  },
  {
    "poem_id": 1386,
    "vorder": 45,
    "position": 0,
    "text": "که من دست را خیره بر جان زنم"
  },
  {
    "poem_id": 1386,
    "vorder": 46,
    "position": 1,
    "text": "برین خسته دل تیز پیکان زنم"
  },
  {
    "poem_id": 1386,
    "vorder": 47,
    "position": 0,
    "text": "کمند از رهی بستد و داد خم"
  },
  {
    "poem_id": 1386,
    "vorder": 48,
    "position": 1,
    "text": "بیفگند خوار و نزد ایچ دم"
  },
  {
    "poem_id": 1386,
    "vorder": 49,
    "position": 0,
    "text": "به حلقه درآمد سر کنگره"
  },
  {
    "poem_id": 1386,
    "vorder": 50,
    "position": 1,
    "text": "برآمد ز بن تا به سر یکسره"
  },
  {
    "poem_id": 1386,
    "vorder": 51,
    "position": 0,
    "text": "چو بر بام آن باره بنشست باز"
  },
  {
    "poem_id": 1386,
    "vorder": 52,
    "position": 1,
    "text": "برآمد پری روی و بردش نماز"
  },
  {
    "poem_id": 1386,
    "vorder": 53,
    "position": 0,
    "text": "گرفت آن زمان دست دستان به دست"
  },
  {
    "poem_id": 1386,
    "vorder": 54,
    "position": 1,
    "text": "برفتند هر دو به کردار مست"
  },
  {
    "poem_id": 1386,
    "vorder": 55,
    "position": 0,
    "text": "فرود آمد از بام کاخ بلند"
  },
  {
    "poem_id": 1386,
    "vorder": 56,
    "position": 1,
    "text": "به دست اندرون دست شاخ بلند"
  },
  {
    "poem_id": 1386,
    "vorder": 57,
    "position": 0,
    "text": "سوی خانهٔ زرنگار آمدند"
  },
  {
    "poem_id": 1386,
    "vorder": 58,
    "position": 1,
    "text": "بران مجلس شاهوار آمدند"
  },
  {
    "poem_id": 1386,
    "vorder": 59,
    "position": 0,
    "text": "بهشتی بد آراسته پر ز نور"
  },
  {
    "poem_id": 1386,
    "vorder": 60,
    "position": 1,
    "text": "پرستنده بر پای و بر پیش حور"
  },
  {
    "poem_id": 1386,
    "vorder": 61,
    "position": 0,
    "text": "شگفت اندرو مانده بد زال زر"
  },
  {
    "poem_id": 1386,
    "vorder": 62,
    "position": 1,
    "text": "برآن روی و آن موی و بالا و فر"
  },
  {
    "poem_id": 1386,
    "vorder": 63,
    "position": 0,
    "text": "ابا یاره و طوق و با گوشوار"
  },
  {
    "poem_id": 1386,
    "vorder": 64,
    "position": 1,
    "text": "ز دینار و گوهر چو باغ بهار"
  },
  {
    "poem_id": 1386,
    "vorder": 65,
    "position": 0,
    "text": "دو رخساره چون لاله اندر سمن"
  },
  {
    "poem_id": 1386,
    "vorder": 66,
    "position": 1,
    "text": "سر جعد زلفش شکن بر شکن"
  },
  {
    "poem_id": 1386,
    "vorder": 67,
    "position": 0,
    "text": "همان زال با فر شاهنشهی"
  },
  {
    "poem_id": 1386,
    "vorder": 68,
    "position": 1,
    "text": "نشسته بر ماه بر فرهی"
  },
  {
    "poem_id": 1386,
    "vorder": 69,
    "position": 0,
    "text": "حمایل یکی دشنه اندر برش"
  },
  {
    "poem_id": 1386,
    "vorder": 70,
    "position": 1,
    "text": "ز یاقوت سرخ افسری بر سرش"
  },
  {
    "poem_id": 1386,
    "vorder": 71,
    "position": 0,
    "text": "همی بود بوس و کنار و نبید"
  },
  {
    "poem_id": 1386,
    "vorder": 72,
    "position": 1,
    "text": "مگر شیر کو گور را نشکرید"
  },
  {
    "poem_id": 1386,
    "vorder": 73,
    "position": 0,
    "text": "سپهبد چنین گفت با ماه‌روی"
  },
  {
    "poem_id": 1386,
    "vorder": 74,
    "position": 1,
    "text": "که ای سرو سیمین بر و رنگ بوی"
  },
  {
    "poem_id": 1386,
    "vorder": 75,
    "position": 0,
    "text": "منوچهر اگر بشنود داستان"
  },
  {
    "poem_id": 1386,
    "vorder": 76,
    "position": 1,
    "text": "نباشد برین کار همداستان"
  },
  {
    "poem_id": 1386,
    "vorder": 77,
    "position": 0,
    "text": "همان سام نیرم برآرد خروش"
  },
  {
    "poem_id": 1386,
    "vorder": 78,
    "position": 1,
    "text": "ازین کار بر من شود او بجوش"
  },
  {
    "poem_id": 1386,
    "vorder": 79,
    "position": 0,
    "text": "ولیکن نه پرمایه جانست و تن"
  },
  {
    "poem_id": 1386,
    "vorder": 80,
    "position": 1,
    "text": "همان خوار گیرم بپوشم کفن"
  },
  {
    "poem_id": 1386,
    "vorder": 81,
    "position": 0,
    "text": "پذیرفتم از دادگر داورم"
  },
  {
    "poem_id": 1386,
    "vorder": 82,
    "position": 1,
    "text": "که هرگز ز پیمان تو نگذرم"
  },
  {
    "poem_id": 1386,
    "vorder": 83,
    "position": 0,
    "text": "شوم پیش یزدان ستایش کنم"
  },
  {
    "poem_id": 1386,
    "vorder": 84,
    "position": 1,
    "text": "چو ایزد پرستان نیایش کنم"
  },
  {
    "poem_id": 1386,
    "vorder": 85,
    "position": 0,
    "text": "مگر کو دل سام و شاه زمین"
  },
  {
    "poem_id": 1386,
    "vorder": 86,
    "position": 1,
    "text": "بشوید ز خشم و ز پیکار و کین"
  },
  {
    "poem_id": 1386,
    "vorder": 87,
    "position": 0,
    "text": "جهان آفرین بشنود گفت من"
  },
  {
    "poem_id": 1386,
    "vorder": 88,
    "position": 1,
    "text": "مگر کاشکارا شوی جفت من"
  },
  {
    "poem_id": 1386,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت رودابه من همچنین"
  },
  {
    "poem_id": 1386,
    "vorder": 90,
    "position": 1,
    "text": "پذیرفتم از داور کیش و دین"
  },
  {
    "poem_id": 1386,
    "vorder": 91,
    "position": 0,
    "text": "که بر من نباشد کسی پادشا"
  },
  {
    "poem_id": 1386,
    "vorder": 92,
    "position": 1,
    "text": "جهان آفرین بر زبانم گوا"
  },
  {
    "poem_id": 1386,
    "vorder": 93,
    "position": 0,
    "text": "جز از پهلوان جهان زال زر"
  },
  {
    "poem_id": 1386,
    "vorder": 94,
    "position": 1,
    "text": "که با تخت و تاجست وبا زیب و فر"
  },
  {
    "poem_id": 1386,
    "vorder": 95,
    "position": 0,
    "text": "همی مهرشان هر زمان بیش بود"
  },
  {
    "poem_id": 1386,
    "vorder": 96,
    "position": 1,
    "text": "خرد دور بود آرزو پیش بود"
  },
  {
    "poem_id": 1386,
    "vorder": 97,
    "position": 0,
    "text": "چنین تا سپیده برآمد ز جای"
  },
  {
    "poem_id": 1386,
    "vorder": 98,
    "position": 1,
    "text": "تبیره برآمد ز پرده‌سرای"
  },
  {
    "poem_id": 1386,
    "vorder": 99,
    "position": 0,
    "text": "پس آن ماه را شید پدرود کرد"
  },
  {
    "poem_id": 1386,
    "vorder": 100,
    "position": 1,
    "text": "بر خویش تار و برش پود کرد"
  },
  {
    "poem_id": 1386,
    "vorder": 101,
    "position": 0,
    "text": "ز بالا کمند اندر افگند زال"
  },
  {
    "poem_id": 1386,
    "vorder": 102,
    "position": 1,
    "text": "فرود آمد از کاخ فرخ همال"
  }
]