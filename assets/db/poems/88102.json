[
  {
    "poem_id": 88102,
    "vorder": 1,
    "position": 0,
    "text": "ز کار بزرگان چو پردخته شد"
  },
  {
    "poem_id": 88102,
    "vorder": 2,
    "position": 1,
    "text": "شهنشاه زآن رنجها رخته شد"
  },
  {
    "poem_id": 88102,
    "vorder": 3,
    "position": 0,
    "text": "از آن مهتران نام لهراسب ماند"
  },
  {
    "poem_id": 88102,
    "vorder": 4,
    "position": 1,
    "text": "که از دفتر شاه کس برنخواند"
  },
  {
    "poem_id": 88102,
    "vorder": 5,
    "position": 0,
    "text": "به بیژن بفرمود تا با کلاه"
  },
  {
    "poem_id": 88102,
    "vorder": 6,
    "position": 1,
    "text": "بیاورد لهراسب را نزد شاه"
  },
  {
    "poem_id": 88102,
    "vorder": 7,
    "position": 0,
    "text": "چو دیدش جهاندار برپای جست"
  },
  {
    "poem_id": 88102,
    "vorder": 8,
    "position": 1,
    "text": "بر او آفرین کرد و بگشاد دست"
  },
  {
    "poem_id": 88102,
    "vorder": 9,
    "position": 0,
    "text": "فرود آمد از نامور تخت عاج"
  },
  {
    "poem_id": 88102,
    "vorder": 10,
    "position": 1,
    "text": "ز سر برگرفت آن دل‌افروز تاج"
  },
  {
    "poem_id": 88102,
    "vorder": 11,
    "position": 0,
    "text": "به لهراسب بسپرد و کرد آفرین"
  },
  {
    "poem_id": 88102,
    "vorder": 12,
    "position": 1,
    "text": "همه پادشاهی ایران زمین"
  },
  {
    "poem_id": 88102,
    "vorder": 13,
    "position": 0,
    "text": "همی کرد پدرود آن تخت عاج"
  },
  {
    "poem_id": 88102,
    "vorder": 14,
    "position": 1,
    "text": "بر او آفرین کرد و بر تخت و تاج"
  },
  {
    "poem_id": 88102,
    "vorder": 15,
    "position": 0,
    "text": "که این تاج نو بر تو فرخنده باد"
  },
  {
    "poem_id": 88102,
    "vorder": 16,
    "position": 1,
    "text": "جهان سر به سر پیش تو بنده باد"
  },
  {
    "poem_id": 88102,
    "vorder": 17,
    "position": 0,
    "text": "سپردم به تو شاهی و تاج و گنج"
  },
  {
    "poem_id": 88102,
    "vorder": 18,
    "position": 1,
    "text": "از آن پس که دیدم بسی درد و رنج"
  },
  {
    "poem_id": 88102,
    "vorder": 19,
    "position": 0,
    "text": "مگردان زبان ز این سپس جز بداد"
  },
  {
    "poem_id": 88102,
    "vorder": 20,
    "position": 1,
    "text": "که از داد باشی تو پیروز و شاد"
  },
  {
    "poem_id": 88102,
    "vorder": 21,
    "position": 0,
    "text": "مکن دیو را آشنا با روان"
  },
  {
    "poem_id": 88102,
    "vorder": 22,
    "position": 1,
    "text": "چو خواهی که بختت بماند جوان"
  },
  {
    "poem_id": 88102,
    "vorder": 23,
    "position": 0,
    "text": "خردمند باش و بی‌آزار باش"
  },
  {
    "poem_id": 88102,
    "vorder": 24,
    "position": 1,
    "text": "همیشه روان را نگهدار باش"
  },
  {
    "poem_id": 88102,
    "vorder": 25,
    "position": 0,
    "text": "به ایرانیان گفت کز بخت اوی"
  },
  {
    "poem_id": 88102,
    "vorder": 26,
    "position": 1,
    "text": "بباشید شادان دل از تخت اوی"
  },
  {
    "poem_id": 88102,
    "vorder": 27,
    "position": 0,
    "text": "شگفت اندر او مانده ایرانیان"
  },
  {
    "poem_id": 88102,
    "vorder": 28,
    "position": 1,
    "text": "برآشفته هر یک چو شیر ژیان"
  },
  {
    "poem_id": 88102,
    "vorder": 29,
    "position": 0,
    "text": "همی هر کسی در شگفتی بماند"
  },
  {
    "poem_id": 88102,
    "vorder": 30,
    "position": 1,
    "text": "که لهراسب را شاه بایست خواند"
  },
  {
    "poem_id": 88102,
    "vorder": 31,
    "position": 0,
    "text": "از آن انجمن زال بر پای خاست"
  },
  {
    "poem_id": 88102,
    "vorder": 32,
    "position": 1,
    "text": "بگفت آنچه بودش به دل رای راست"
  },
  {
    "poem_id": 88102,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت کای شهریار بلند"
  },
  {
    "poem_id": 88102,
    "vorder": 34,
    "position": 1,
    "text": "سزد گر کنی خاک را ارجمند"
  },
  {
    "poem_id": 88102,
    "vorder": 35,
    "position": 0,
    "text": "سر بخت آن کس پر از خاک باد"
  },
  {
    "poem_id": 88102,
    "vorder": 36,
    "position": 1,
    "text": "روان ورا خاک تریاک باد"
  },
  {
    "poem_id": 88102,
    "vorder": 37,
    "position": 0,
    "text": "که لهراسب را شاه خواند به داد"
  },
  {
    "poem_id": 88102,
    "vorder": 38,
    "position": 1,
    "text": "ز بیداد هرگز نگیریم یاد"
  },
  {
    "poem_id": 88102,
    "vorder": 39,
    "position": 0,
    "text": "به ایران چو آمد به نزد زرسب"
  },
  {
    "poem_id": 88102,
    "vorder": 40,
    "position": 1,
    "text": "فرومایه‌ای دیدمش با یک اسب"
  },
  {
    "poem_id": 88102,
    "vorder": 41,
    "position": 0,
    "text": "به جنگ الانان فرستادیش"
  },
  {
    "poem_id": 88102,
    "vorder": 42,
    "position": 1,
    "text": "سپاه و درفش و کمر دادیش"
  },
  {
    "poem_id": 88102,
    "vorder": 43,
    "position": 0,
    "text": "ز چندین بزرگان خسرو نژاد"
  },
  {
    "poem_id": 88102,
    "vorder": 44,
    "position": 1,
    "text": "نیامد کسی بر دل شاه یاد"
  },
  {
    "poem_id": 88102,
    "vorder": 45,
    "position": 0,
    "text": "نژادش ندانم ندیدم هنر"
  },
  {
    "poem_id": 88102,
    "vorder": 46,
    "position": 1,
    "text": "از این گونه نشنیده‌ام تاجور"
  },
  {
    "poem_id": 88102,
    "vorder": 47,
    "position": 0,
    "text": "خروشی برآمد ز ایرانیان"
  },
  {
    "poem_id": 88102,
    "vorder": 48,
    "position": 1,
    "text": "کز این پس نبندیم شاها میان"
  },
  {
    "poem_id": 88102,
    "vorder": 49,
    "position": 0,
    "text": "نجوییم کس نام در کارزار"
  },
  {
    "poem_id": 88102,
    "vorder": 50,
    "position": 1,
    "text": "چو لهراسب را کی کند شهریار"
  },
  {
    "poem_id": 88102,
    "vorder": 51,
    "position": 0,
    "text": "چو بشنید خسرو ز دستان سخن"
  },
  {
    "poem_id": 88102,
    "vorder": 52,
    "position": 1,
    "text": "بدو گفت مشتاب و تندی مکن"
  },
  {
    "poem_id": 88102,
    "vorder": 53,
    "position": 0,
    "text": "که هر کس که بیداد گوید همی"
  },
  {
    "poem_id": 88102,
    "vorder": 54,
    "position": 1,
    "text": "به جز دود ز آتش نجوید همی"
  },
  {
    "poem_id": 88102,
    "vorder": 55,
    "position": 0,
    "text": "که نپسندد از ما بدی دادگر"
  },
  {
    "poem_id": 88102,
    "vorder": 56,
    "position": 1,
    "text": "نه هر کاو بدی کرد بیند گهر"
  },
  {
    "poem_id": 88102,
    "vorder": 57,
    "position": 0,
    "text": "که یزدان کسی را کند نیک بخت"
  },
  {
    "poem_id": 88102,
    "vorder": 58,
    "position": 1,
    "text": "سزاوار شاهی و زیبای تخت"
  },
  {
    "poem_id": 88102,
    "vorder": 59,
    "position": 0,
    "text": "جهان‌آفرین بر روانم گواست"
  },
  {
    "poem_id": 88102,
    "vorder": 60,
    "position": 1,
    "text": "که گشت این سخنها به لهراسب راست"
  },
  {
    "poem_id": 88102,
    "vorder": 61,
    "position": 0,
    "text": "که دارد همی شرم و دین و خرد"
  },
  {
    "poem_id": 88102,
    "vorder": 62,
    "position": 1,
    "text": "ز کردار نیکی همی برخورد"
  },
  {
    "poem_id": 88102,
    "vorder": 63,
    "position": 0,
    "text": "نبیرهٔ جهاندار هوشنگ هست"
  },
  {
    "poem_id": 88102,
    "vorder": 64,
    "position": 1,
    "text": "خردمند و بینادل و پاک‌دست"
  },
  {
    "poem_id": 88102,
    "vorder": 65,
    "position": 0,
    "text": "پی جادوان بگسلاند ز خاک"
  },
  {
    "poem_id": 88102,
    "vorder": 66,
    "position": 1,
    "text": "پدید آورد راه یزدان پاک"
  },
  {
    "poem_id": 88102,
    "vorder": 67,
    "position": 0,
    "text": "زمانه جوان گردد از پند اوی"
  },
  {
    "poem_id": 88102,
    "vorder": 68,
    "position": 1,
    "text": "بدین هم بود پاک فرزند اوی"
  },
  {
    "poem_id": 88102,
    "vorder": 69,
    "position": 0,
    "text": "به  شاهی بر او آفرین گسترید"
  },
  {
    "poem_id": 88102,
    "vorder": 70,
    "position": 1,
    "text": "وز این پند و اندرز من مگذرید"
  },
  {
    "poem_id": 88102,
    "vorder": 71,
    "position": 0,
    "text": "هر آن کس کز اندرز من درگذشت"
  },
  {
    "poem_id": 88102,
    "vorder": 72,
    "position": 1,
    "text": "همه رنج او پیش من باد گشت"
  },
  {
    "poem_id": 88102,
    "vorder": 73,
    "position": 0,
    "text": "چنین هم ز یزدان بود ناسپاس"
  },
  {
    "poem_id": 88102,
    "vorder": 74,
    "position": 1,
    "text": "به دلش اندر آید ز هر سو هراس"
  },
  {
    "poem_id": 88102,
    "vorder": 75,
    "position": 0,
    "text": "چو بشنید زال این سخنهای پاک"
  },
  {
    "poem_id": 88102,
    "vorder": 76,
    "position": 1,
    "text": "بیازید انگشت و بر زد به خاک"
  },
  {
    "poem_id": 88102,
    "vorder": 77,
    "position": 0,
    "text": "بیالود لب را به خاک سیاه"
  },
  {
    "poem_id": 88102,
    "vorder": 78,
    "position": 1,
    "text": "به آواز لهراسب را خواند شاه"
  },
  {
    "poem_id": 88102,
    "vorder": 79,
    "position": 0,
    "text": "به شاه جهان گفت خرم بدی"
  },
  {
    "poem_id": 88102,
    "vorder": 80,
    "position": 1,
    "text": "همیشه ز تو دور دست بدی"
  },
  {
    "poem_id": 88102,
    "vorder": 81,
    "position": 0,
    "text": "که دانست جز شاه پیروز و راد"
  },
  {
    "poem_id": 88102,
    "vorder": 82,
    "position": 1,
    "text": "که لهراسب دارد ز شاهان نژاد"
  },
  {
    "poem_id": 88102,
    "vorder": 83,
    "position": 0,
    "text": "چو سوگند خوردم به خاک سیاه"
  },
  {
    "poem_id": 88102,
    "vorder": 84,
    "position": 1,
    "text": "لب آلوده شد مشمر آن از گناه"
  }
]