[
  {
    "poem_id": 1734,
    "vorder": 1,
    "position": 0,
    "text": "چو یک چند بگذشت بر شاه روز"
  },
  {
    "poem_id": 1734,
    "vorder": 2,
    "position": 1,
    "text": "فروزنده شد تاج گیتی فروز"
  },
  {
    "poem_id": 1734,
    "vorder": 3,
    "position": 0,
    "text": "ز غسانیان طایر شیردل"
  },
  {
    "poem_id": 1734,
    "vorder": 4,
    "position": 1,
    "text": "که دادی فلک را به شمشیر دل"
  },
  {
    "poem_id": 1734,
    "vorder": 5,
    "position": 0,
    "text": "سپاهی ز رومی و از قادسی"
  },
  {
    "poem_id": 1734,
    "vorder": 6,
    "position": 1,
    "text": "ز بحرین و از کرد وز پارسی"
  },
  {
    "poem_id": 1734,
    "vorder": 7,
    "position": 0,
    "text": "بیامد به پیرامن طیسفون"
  },
  {
    "poem_id": 1734,
    "vorder": 8,
    "position": 1,
    "text": "سپاهی ز اندازه بیش اندرون"
  },
  {
    "poem_id": 1734,
    "vorder": 9,
    "position": 0,
    "text": "به تاراج داد آن همه بوم و بر"
  },
  {
    "poem_id": 1734,
    "vorder": 10,
    "position": 1,
    "text": "کرا بود با او پی و پا و پر"
  },
  {
    "poem_id": 1734,
    "vorder": 11,
    "position": 0,
    "text": "ز پیوند نرسی یکی یادگار"
  },
  {
    "poem_id": 1734,
    "vorder": 12,
    "position": 1,
    "text": "کجا نوشه بد نام آن نوبهار"
  },
  {
    "poem_id": 1734,
    "vorder": 13,
    "position": 0,
    "text": "بیامد به ایوان آن ماه‌روی"
  },
  {
    "poem_id": 1734,
    "vorder": 14,
    "position": 1,
    "text": "همه طیسفون گشت پر گفت‌وگوی"
  },
  {
    "poem_id": 1734,
    "vorder": 15,
    "position": 0,
    "text": "ز ایوانش بردند و کردند اسیر"
  },
  {
    "poem_id": 1734,
    "vorder": 16,
    "position": 1,
    "text": "که دانا نبودند و دانش‌پذیر"
  },
  {
    "poem_id": 1734,
    "vorder": 17,
    "position": 0,
    "text": "چو یک سال نزدیک طایر بماند"
  },
  {
    "poem_id": 1734,
    "vorder": 18,
    "position": 1,
    "text": "ز اندیشگان دل به خون در نشاند"
  },
  {
    "poem_id": 1734,
    "vorder": 19,
    "position": 0,
    "text": "ز طایر یکی دختش آمد چو ماه"
  },
  {
    "poem_id": 1734,
    "vorder": 20,
    "position": 1,
    "text": "تو گفتی که نرسیست با تاج و گاه"
  },
  {
    "poem_id": 1734,
    "vorder": 21,
    "position": 0,
    "text": "پدر مالکه نام کردش چو دید"
  },
  {
    "poem_id": 1734,
    "vorder": 22,
    "position": 1,
    "text": "که دختش همی مملکت را سزید"
  },
  {
    "poem_id": 1734,
    "vorder": 23,
    "position": 0,
    "text": "چو شاپور را سال شد بیست و شش"
  },
  {
    "poem_id": 1734,
    "vorder": 24,
    "position": 1,
    "text": "مهی‌وش کیی گشت خورشیدفش"
  },
  {
    "poem_id": 1734,
    "vorder": 25,
    "position": 0,
    "text": "به دشت آمد و لشکرش را بدید"
  },
  {
    "poem_id": 1734,
    "vorder": 26,
    "position": 1,
    "text": "ده و دو هزار از یلان برگزید"
  },
  {
    "poem_id": 1734,
    "vorder": 27,
    "position": 0,
    "text": "ابا هر یکی بادپایی هیون"
  },
  {
    "poem_id": 1734,
    "vorder": 28,
    "position": 1,
    "text": "به پیش اندرون مرد صد رهنمون"
  },
  {
    "poem_id": 1734,
    "vorder": 29,
    "position": 0,
    "text": "هیون برنشستند و اسپان به دست"
  },
  {
    "poem_id": 1734,
    "vorder": 30,
    "position": 1,
    "text": "برفتند گردان خسروپرست"
  },
  {
    "poem_id": 1734,
    "vorder": 31,
    "position": 0,
    "text": "ازان پس ابا ویژگان برنشست"
  },
  {
    "poem_id": 1734,
    "vorder": 32,
    "position": 1,
    "text": "میان کیی تاختن را بببست"
  },
  {
    "poem_id": 1734,
    "vorder": 33,
    "position": 0,
    "text": "برفت از پس شاه غسانیان"
  },
  {
    "poem_id": 1734,
    "vorder": 34,
    "position": 1,
    "text": "سرافراز طایر هژبر ژیان"
  },
  {
    "poem_id": 1734,
    "vorder": 35,
    "position": 0,
    "text": "فراوان کس از لشکر او بکشت"
  },
  {
    "poem_id": 1734,
    "vorder": 36,
    "position": 1,
    "text": "چو طایر چنان دید بنمود پشت"
  },
  {
    "poem_id": 1734,
    "vorder": 37,
    "position": 0,
    "text": "برآمد خروشیدن داروگیر"
  },
  {
    "poem_id": 1734,
    "vorder": 38,
    "position": 1,
    "text": "ازیشان گرفتند چندی اسیر"
  },
  {
    "poem_id": 1734,
    "vorder": 39,
    "position": 0,
    "text": "که اندازهٔ آن ندانست کس"
  },
  {
    "poem_id": 1734,
    "vorder": 40,
    "position": 1,
    "text": "برفتند آن ماندگان زان سپس"
  },
  {
    "poem_id": 1734,
    "vorder": 41,
    "position": 0,
    "text": "حصاری شدند آن سپه در یمن"
  },
  {
    "poem_id": 1734,
    "vorder": 42,
    "position": 1,
    "text": "خروش آمد از کودک و مرد و زن"
  },
  {
    "poem_id": 1734,
    "vorder": 43,
    "position": 0,
    "text": "بیاورد شاپور چندان سپاه"
  },
  {
    "poem_id": 1734,
    "vorder": 44,
    "position": 1,
    "text": "که بر مور و بر پشه بربست راه"
  },
  {
    "poem_id": 1734,
    "vorder": 45,
    "position": 0,
    "text": "ورا با سپاهش به دژ در بیافت"
  },
  {
    "poem_id": 1734,
    "vorder": 46,
    "position": 1,
    "text": "در جنگ و راه گریزش نیافت"
  },
  {
    "poem_id": 1734,
    "vorder": 47,
    "position": 0,
    "text": "شب و روز یک ماهشان جنگ بود"
  },
  {
    "poem_id": 1734,
    "vorder": 48,
    "position": 1,
    "text": "سپه را به دژ بر علف تنگ بود"
  }
]