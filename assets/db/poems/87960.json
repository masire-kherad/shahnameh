[
  {
    "poem_id": 87960,
    "vorder": 1,
    "position": 0,
    "text": "چو ایرانیان از بر کوهسار"
  },
  {
    "poem_id": 87960,
    "vorder": 2,
    "position": 1,
    "text": "بدیدند جای فرود و تخوار"
  },
  {
    "poem_id": 87960,
    "vorder": 3,
    "position": 0,
    "text": "برآشفت ازیشان سپهدار طوس"
  },
  {
    "poem_id": 87960,
    "vorder": 4,
    "position": 1,
    "text": "فروداشت بر جای پیلان و کوس"
  },
  {
    "poem_id": 87960,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کز لشکر نامدار"
  },
  {
    "poem_id": 87960,
    "vorder": 6,
    "position": 1,
    "text": "سواری بباید کنون نیک‌یار"
  },
  {
    "poem_id": 87960,
    "vorder": 7,
    "position": 0,
    "text": "که جوشان شود زین میان گروه"
  },
  {
    "poem_id": 87960,
    "vorder": 8,
    "position": 1,
    "text": "برد اسپ تا بر سر تیغ کوه"
  },
  {
    "poem_id": 87960,
    "vorder": 9,
    "position": 0,
    "text": "ببیند که آن دو دلاور کیند"
  },
  {
    "poem_id": 87960,
    "vorder": 10,
    "position": 1,
    "text": "بران کوه سر بر ز بهر چیند"
  },
  {
    "poem_id": 87960,
    "vorder": 11,
    "position": 0,
    "text": "گر ایدونک از لشکر ما یکیست"
  },
  {
    "poem_id": 87960,
    "vorder": 12,
    "position": 1,
    "text": "زند بر سرش تازیانه دویست"
  },
  {
    "poem_id": 87960,
    "vorder": 13,
    "position": 0,
    "text": "وگر ترک باشند و پرخاش جوی"
  },
  {
    "poem_id": 87960,
    "vorder": 14,
    "position": 1,
    "text": "ببندد کشانش بیارد بروی"
  },
  {
    "poem_id": 87960,
    "vorder": 15,
    "position": 0,
    "text": "وگر کشته آید سپارد بخاک"
  },
  {
    "poem_id": 87960,
    "vorder": 16,
    "position": 1,
    "text": "سزد گر ندارد از آن بیم و باک"
  },
  {
    "poem_id": 87960,
    "vorder": 17,
    "position": 0,
    "text": "ورایدونک باشد ز کارآگهان"
  },
  {
    "poem_id": 87960,
    "vorder": 18,
    "position": 1,
    "text": "که بشمرد خواهد سپه را نهان"
  },
  {
    "poem_id": 87960,
    "vorder": 19,
    "position": 0,
    "text": "همانجا بدونیم باید زدن"
  },
  {
    "poem_id": 87960,
    "vorder": 20,
    "position": 1,
    "text": "فروهشتن از کوه و باز آمدن"
  },
  {
    "poem_id": 87960,
    "vorder": 21,
    "position": 0,
    "text": "بسالار بهرام گودرز گفت"
  },
  {
    "poem_id": 87960,
    "vorder": 22,
    "position": 1,
    "text": "که این کار بر من نشاید نهفت"
  },
  {
    "poem_id": 87960,
    "vorder": 23,
    "position": 0,
    "text": "روم هرچ گفتی بجای آورم"
  },
  {
    "poem_id": 87960,
    "vorder": 24,
    "position": 1,
    "text": "سر کوه یکسر بپای آورم"
  },
  {
    "poem_id": 87960,
    "vorder": 25,
    "position": 0,
    "text": "بزد اسپ و راند از میان گروه"
  },
  {
    "poem_id": 87960,
    "vorder": 26,
    "position": 1,
    "text": "پراندیشه بنهاد سر سوی کوه"
  },
  {
    "poem_id": 87960,
    "vorder": 27,
    "position": 0,
    "text": "چنین گفت پس نامور با تخوار"
  },
  {
    "poem_id": 87960,
    "vorder": 28,
    "position": 1,
    "text": "که این کیست کامد چنین خوارخوار"
  },
  {
    "poem_id": 87960,
    "vorder": 29,
    "position": 0,
    "text": "همانانیندیشد از ما همی"
  },
  {
    "poem_id": 87960,
    "vorder": 30,
    "position": 1,
    "text": "بتندی برآید ببالا همی"
  },
  {
    "poem_id": 87960,
    "vorder": 31,
    "position": 0,
    "text": "یکی باره‌ای برنشسته سمند"
  },
  {
    "poem_id": 87960,
    "vorder": 32,
    "position": 1,
    "text": "بفتراک بربسته دارد کمند"
  },
  {
    "poem_id": 87960,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت پس رای‌زن با فرود"
  },
  {
    "poem_id": 87960,
    "vorder": 34,
    "position": 1,
    "text": "که این را بتندی نباید بسود"
  },
  {
    "poem_id": 87960,
    "vorder": 35,
    "position": 0,
    "text": "بنام و نشانش ندانم همی"
  },
  {
    "poem_id": 87960,
    "vorder": 36,
    "position": 1,
    "text": "ز گودرزیانش گمانم همی"
  },
  {
    "poem_id": 87960,
    "vorder": 37,
    "position": 0,
    "text": "چو خسرو ز توران بایران رسید"
  },
  {
    "poem_id": 87960,
    "vorder": 38,
    "position": 1,
    "text": "یکی مغفر شاه شد ناپدید"
  },
  {
    "poem_id": 87960,
    "vorder": 39,
    "position": 0,
    "text": "گمانی همی آن برم بر سرش"
  },
  {
    "poem_id": 87960,
    "vorder": 40,
    "position": 1,
    "text": "زره تا میان خسروانی برش"
  },
  {
    "poem_id": 87960,
    "vorder": 41,
    "position": 0,
    "text": "ز گودرز دارد همانا نژاد"
  },
  {
    "poem_id": 87960,
    "vorder": 42,
    "position": 1,
    "text": "یکی لب بپرسش بباید گشاد"
  },
  {
    "poem_id": 87960,
    "vorder": 43,
    "position": 0,
    "text": "چو بهرام بر شد ببالای تیغ"
  },
  {
    "poem_id": 87960,
    "vorder": 44,
    "position": 1,
    "text": "بغرید برسان غرنده میغ"
  },
  {
    "poem_id": 87960,
    "vorder": 45,
    "position": 0,
    "text": "چه مردی بدو گفت بر کوهسار"
  },
  {
    "poem_id": 87960,
    "vorder": 46,
    "position": 1,
    "text": "نبینی همی لشکر بیشمار"
  },
  {
    "poem_id": 87960,
    "vorder": 47,
    "position": 0,
    "text": "همی نشنوی نالهٔ بوق و کوس"
  },
  {
    "poem_id": 87960,
    "vorder": 48,
    "position": 1,
    "text": "نترسی ز سالار بیدار طوس"
  },
  {
    "poem_id": 87960,
    "vorder": 49,
    "position": 0,
    "text": "فرودش چنین پاسخ آورد باز"
  },
  {
    "poem_id": 87960,
    "vorder": 50,
    "position": 1,
    "text": "که تندی ندیدی تو تندی مساز"
  },
  {
    "poem_id": 87960,
    "vorder": 51,
    "position": 0,
    "text": "سخن نرم گوی ای جهاندیده مرد"
  },
  {
    "poem_id": 87960,
    "vorder": 52,
    "position": 1,
    "text": "میارای لب را بگفتار سرد"
  },
  {
    "poem_id": 87960,
    "vorder": 53,
    "position": 0,
    "text": "نه تو شیر جنگی و من گور دشت"
  },
  {
    "poem_id": 87960,
    "vorder": 54,
    "position": 1,
    "text": "برین گونه بر ما نشاید گذشت"
  },
  {
    "poem_id": 87960,
    "vorder": 55,
    "position": 0,
    "text": "فزونی نداری تو چیزی ز من"
  },
  {
    "poem_id": 87960,
    "vorder": 56,
    "position": 1,
    "text": "بگردی و مردی و نیروی تن"
  },
  {
    "poem_id": 87960,
    "vorder": 57,
    "position": 0,
    "text": "سر و دست و پای و دل و مغز و هوش"
  },
  {
    "poem_id": 87960,
    "vorder": 58,
    "position": 1,
    "text": "زبانی سراینده و چشم و گوش"
  },
  {
    "poem_id": 87960,
    "vorder": 59,
    "position": 0,
    "text": "نگه کن بمن تا مرا نیز هست"
  },
  {
    "poem_id": 87960,
    "vorder": 60,
    "position": 1,
    "text": "اگر هست بیهوده منمای دست"
  },
  {
    "poem_id": 87960,
    "vorder": 61,
    "position": 0,
    "text": "سخن پرسمت گر تو پاسخ دهی"
  },
  {
    "poem_id": 87960,
    "vorder": 62,
    "position": 1,
    "text": "شوم شاد اگر رای فرخ نهی"
  },
  {
    "poem_id": 87960,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت بهرام بر گوی هین"
  },
  {
    "poem_id": 87960,
    "vorder": 64,
    "position": 1,
    "text": "تو بر آسمانی و من بر زمین"
  },
  {
    "poem_id": 87960,
    "vorder": 65,
    "position": 0,
    "text": "فرود آن زمان گفت سالار کیست"
  },
  {
    "poem_id": 87960,
    "vorder": 66,
    "position": 1,
    "text": "برزم اندرون نامبردار کیست"
  },
  {
    "poem_id": 87960,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت بهرام سالار طوس"
  },
  {
    "poem_id": 87960,
    "vorder": 68,
    "position": 1,
    "text": "که با اختر کاویانست و کوس"
  },
  {
    "poem_id": 87960,
    "vorder": 69,
    "position": 0,
    "text": "ز گردان چو گودرز و رهام و گیو"
  },
  {
    "poem_id": 87960,
    "vorder": 70,
    "position": 1,
    "text": "چو گرگین و شیدوش و فرهاد نیو"
  },
  {
    "poem_id": 87960,
    "vorder": 71,
    "position": 0,
    "text": "چو گستهم و چون زنگهٔ شاوران"
  },
  {
    "poem_id": 87960,
    "vorder": 72,
    "position": 1,
    "text": "گرازه سر مرد کنداوران"
  },
  {
    "poem_id": 87960,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت کز چه ز بهرام نام"
  },
  {
    "poem_id": 87960,
    "vorder": 74,
    "position": 1,
    "text": "نبردی و بگذاشتی کار خام"
  },
  {
    "poem_id": 87960,
    "vorder": 75,
    "position": 0,
    "text": "ز گودرزیان ما بدوییم شاد"
  },
  {
    "poem_id": 87960,
    "vorder": 76,
    "position": 1,
    "text": "مرا زو نکردی بلب هیچ یاد"
  },
  {
    "poem_id": 87960,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت بهرام کای شیرمرد"
  },
  {
    "poem_id": 87960,
    "vorder": 78,
    "position": 1,
    "text": "چنین یاد بهرام با تو که کرد"
  },
  {
    "poem_id": 87960,
    "vorder": 79,
    "position": 0,
    "text": "چنین داد پاسخ مر او را فرود"
  },
  {
    "poem_id": 87960,
    "vorder": 80,
    "position": 1,
    "text": "که این داستان من ز مادر شنود"
  },
  {
    "poem_id": 87960,
    "vorder": 81,
    "position": 0,
    "text": "مرا گفت چون پیشت آید سپاه"
  },
  {
    "poem_id": 87960,
    "vorder": 82,
    "position": 1,
    "text": "پذیره شو و نام بهرام خواه"
  },
  {
    "poem_id": 87960,
    "vorder": 83,
    "position": 0,
    "text": "دگر نامداری ز کنداوران"
  },
  {
    "poem_id": 87960,
    "vorder": 84,
    "position": 1,
    "text": "کجا نام او زنگهٔ شاوران"
  },
  {
    "poem_id": 87960,
    "vorder": 85,
    "position": 0,
    "text": "همانند همشیرگان پدر"
  },
  {
    "poem_id": 87960,
    "vorder": 86,
    "position": 1,
    "text": "سزد گر بر ایشان بجویی گذر"
  },
  {
    "poem_id": 87960,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت بهرام کای نیکبخت"
  },
  {
    "poem_id": 87960,
    "vorder": 88,
    "position": 1,
    "text": "تویی بار آن خسروانی درخت"
  },
  {
    "poem_id": 87960,
    "vorder": 89,
    "position": 0,
    "text": "فرودی تو ای شهریار جوان"
  },
  {
    "poem_id": 87960,
    "vorder": 90,
    "position": 1,
    "text": "که جاوید بادی به روشن‌روان"
  },
  {
    "poem_id": 87960,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت کآری فرودم درست"
  },
  {
    "poem_id": 87960,
    "vorder": 92,
    "position": 1,
    "text": "ازان سرو افگنده شاخی برست"
  },
  {
    "poem_id": 87960,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت بهرام بنمای تن"
  },
  {
    "poem_id": 87960,
    "vorder": 94,
    "position": 1,
    "text": "برهنه نشان سیاوش بمن"
  },
  {
    "poem_id": 87960,
    "vorder": 95,
    "position": 0,
    "text": "به بهرام بنمود بازو فرود"
  },
  {
    "poem_id": 87960,
    "vorder": 96,
    "position": 1,
    "text": "ز عنبر بگل بر یکی خال بود"
  },
  {
    "poem_id": 87960,
    "vorder": 97,
    "position": 0,
    "text": "کزان گونه بتگر بپرگار چین"
  },
  {
    "poem_id": 87960,
    "vorder": 98,
    "position": 1,
    "text": "نداند نگارید کس بر زمین"
  },
  {
    "poem_id": 87960,
    "vorder": 99,
    "position": 0,
    "text": "بدانست کو از نژاد قباد"
  },
  {
    "poem_id": 87960,
    "vorder": 100,
    "position": 1,
    "text": "ز تخم سیاووش دارد نژاد"
  },
  {
    "poem_id": 87960,
    "vorder": 101,
    "position": 0,
    "text": "برو آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 87960,
    "vorder": 102,
    "position": 1,
    "text": "برآمد ببالای تند و دراز"
  },
  {
    "poem_id": 87960,
    "vorder": 103,
    "position": 0,
    "text": "فرود آمد از اسپ شاه جوان"
  },
  {
    "poem_id": 87960,
    "vorder": 104,
    "position": 1,
    "text": "نشست از بر سنگ روشن‌روان"
  },
  {
    "poem_id": 87960,
    "vorder": 105,
    "position": 0,
    "text": "ببهرام گفت ای سرافراز مرد"
  },
  {
    "poem_id": 87960,
    "vorder": 106,
    "position": 1,
    "text": "جهاندار و بیدار و شیر نبرد"
  },
  {
    "poem_id": 87960,
    "vorder": 107,
    "position": 0,
    "text": "دو چشم من ار زنده دیدی پدر"
  },
  {
    "poem_id": 87960,
    "vorder": 108,
    "position": 1,
    "text": "همانا نگشتی ازین شادتر"
  },
  {
    "poem_id": 87960,
    "vorder": 109,
    "position": 0,
    "text": "که دیدم ترا شاد و روشن‌روان"
  },
  {
    "poem_id": 87960,
    "vorder": 110,
    "position": 1,
    "text": "هنرمند و بینادل و پهلوان"
  },
  {
    "poem_id": 87960,
    "vorder": 111,
    "position": 0,
    "text": "بدان آمدستم بدین تیغ‌کوه"
  },
  {
    "poem_id": 87960,
    "vorder": 112,
    "position": 1,
    "text": "که از نامداران ایران گروه"
  },
  {
    "poem_id": 87960,
    "vorder": 113,
    "position": 0,
    "text": "بپرسم ز مردی که سالار کیست"
  },
  {
    "poem_id": 87960,
    "vorder": 114,
    "position": 1,
    "text": "برزم اندرون نامبردار کیست"
  },
  {
    "poem_id": 87960,
    "vorder": 115,
    "position": 0,
    "text": "یکی سور سازم چنانچون توان"
  },
  {
    "poem_id": 87960,
    "vorder": 116,
    "position": 1,
    "text": "ببینم بشادی رخ پهلوان"
  },
  {
    "poem_id": 87960,
    "vorder": 117,
    "position": 0,
    "text": "ز اسپ و ز شمشیر و گرز و کمر"
  },
  {
    "poem_id": 87960,
    "vorder": 118,
    "position": 1,
    "text": "ببخشم ز هر چیز بسیار مر"
  },
  {
    "poem_id": 87960,
    "vorder": 119,
    "position": 0,
    "text": "وزان پس گرایم به پیش سپاه"
  },
  {
    "poem_id": 87960,
    "vorder": 120,
    "position": 1,
    "text": "بتوران شوم داغ‌دل کینه‌خواه"
  },
  {
    "poem_id": 87960,
    "vorder": 121,
    "position": 0,
    "text": "سزاوار این جستن کین منم"
  },
  {
    "poem_id": 87960,
    "vorder": 122,
    "position": 1,
    "text": "بجنگ آتش تیز برزین منم"
  },
  {
    "poem_id": 87960,
    "vorder": 123,
    "position": 0,
    "text": "سزد گر بگویی تو با پهلوان"
  },
  {
    "poem_id": 87960,
    "vorder": 124,
    "position": 1,
    "text": "که آید برین سنگ روشن‌روان"
  },
  {
    "poem_id": 87960,
    "vorder": 125,
    "position": 0,
    "text": "بباشیم یک هفته ایدر بهم"
  },
  {
    "poem_id": 87960,
    "vorder": 126,
    "position": 1,
    "text": "سگالیم هرگونه از بیش و کم"
  },
  {
    "poem_id": 87960,
    "vorder": 127,
    "position": 0,
    "text": "به هشتم چو برخیزد آوای کوس"
  },
  {
    "poem_id": 87960,
    "vorder": 128,
    "position": 1,
    "text": "بزین اندر آید سپهدار طوس"
  },
  {
    "poem_id": 87960,
    "vorder": 129,
    "position": 0,
    "text": "میان را ببندم بکین پدر"
  },
  {
    "poem_id": 87960,
    "vorder": 130,
    "position": 1,
    "text": "یکی جنگ سازم بدرد جگر"
  },
  {
    "poem_id": 87960,
    "vorder": 131,
    "position": 0,
    "text": "که با شیر جنگ آشنایی دهد"
  },
  {
    "poem_id": 87960,
    "vorder": 132,
    "position": 1,
    "text": "ز نر پر کرگس گوایی دهد"
  },
  {
    "poem_id": 87960,
    "vorder": 133,
    "position": 0,
    "text": "که اندر جهان کینه را زین نشان"
  },
  {
    "poem_id": 87960,
    "vorder": 134,
    "position": 1,
    "text": "نبندد میان کس ز گردنکشان"
  },
  {
    "poem_id": 87960,
    "vorder": 135,
    "position": 0,
    "text": "بدو گفت بهرام کای شهریار"
  },
  {
    "poem_id": 87960,
    "vorder": 136,
    "position": 1,
    "text": "جوان و هنرمند و گرد و سوار"
  },
  {
    "poem_id": 87960,
    "vorder": 137,
    "position": 0,
    "text": "بگویم من این هرچ گفتی بطوس"
  },
  {
    "poem_id": 87960,
    "vorder": 138,
    "position": 1,
    "text": "بخواهش دهم نیز بر دست بوس"
  },
  {
    "poem_id": 87960,
    "vorder": 139,
    "position": 0,
    "text": "ولیکن سپهبد خردمند نیست"
  },
  {
    "poem_id": 87960,
    "vorder": 140,
    "position": 1,
    "text": "سر و مغز او از در پند نیست"
  },
  {
    "poem_id": 87960,
    "vorder": 141,
    "position": 0,
    "text": "هنر دارد و خواسته هم نژاد"
  },
  {
    "poem_id": 87960,
    "vorder": 142,
    "position": 1,
    "text": "نیارد همی بر دل از شاه یاد"
  },
  {
    "poem_id": 87960,
    "vorder": 143,
    "position": 0,
    "text": "بشورید با گیو و گودرز و شاه"
  },
  {
    "poem_id": 87960,
    "vorder": 144,
    "position": 1,
    "text": "ز بهر فریبرز و تخت و کلاه"
  },
  {
    "poem_id": 87960,
    "vorder": 145,
    "position": 0,
    "text": "همی گوید از تخمهٔ نوذرم"
  },
  {
    "poem_id": 87960,
    "vorder": 146,
    "position": 1,
    "text": "جهان را بشاهی خود اندر خورم"
  },
  {
    "poem_id": 87960,
    "vorder": 147,
    "position": 0,
    "text": "سزد گر بپیچد ز گفتار من"
  },
  {
    "poem_id": 87960,
    "vorder": 148,
    "position": 1,
    "text": "گراید بتندی ز کردار من"
  },
  {
    "poem_id": 87960,
    "vorder": 149,
    "position": 0,
    "text": "جز از من هرآنکس که آید برت"
  },
  {
    "poem_id": 87960,
    "vorder": 150,
    "position": 1,
    "text": "نباید که بیند سر و مغفرت"
  },
  {
    "poem_id": 87960,
    "vorder": 151,
    "position": 0,
    "text": "که خودکامه مردیست بی تار و پود"
  },
  {
    "poem_id": 87960,
    "vorder": 152,
    "position": 1,
    "text": "کسی دیگر آید نیارد درود"
  },
  {
    "poem_id": 87960,
    "vorder": 153,
    "position": 0,
    "text": "و دیگر که با ما دلش نیست راست"
  },
  {
    "poem_id": 87960,
    "vorder": 154,
    "position": 1,
    "text": "که شاهی همی با فریبرز خواست"
  },
  {
    "poem_id": 87960,
    "vorder": 155,
    "position": 0,
    "text": "مرا گفت بنگر که بر کوه کیست"
  },
  {
    "poem_id": 87960,
    "vorder": 156,
    "position": 1,
    "text": "چو رفتی مپرسش که از بهر چیست"
  },
  {
    "poem_id": 87960,
    "vorder": 157,
    "position": 0,
    "text": "بگرز و بخنجر سخن گوی و بس"
  },
  {
    "poem_id": 87960,
    "vorder": 158,
    "position": 1,
    "text": "چرا باشد این روز بر کوه‌کس"
  },
  {
    "poem_id": 87960,
    "vorder": 159,
    "position": 0,
    "text": "بمژده من آیم چنو گشت رام"
  },
  {
    "poem_id": 87960,
    "vorder": 160,
    "position": 1,
    "text": "ترا پیش لشکر برم شادکام"
  },
  {
    "poem_id": 87960,
    "vorder": 161,
    "position": 0,
    "text": "وگر جز ز من دیگر آید کسی"
  },
  {
    "poem_id": 87960,
    "vorder": 162,
    "position": 1,
    "text": "نباید بدو بودن ایمن بسی"
  },
  {
    "poem_id": 87960,
    "vorder": 163,
    "position": 0,
    "text": "نیاید بر تو به جز یک سوار"
  },
  {
    "poem_id": 87960,
    "vorder": 164,
    "position": 1,
    "text": "چنینست آیین این نامدار"
  },
  {
    "poem_id": 87960,
    "vorder": 165,
    "position": 0,
    "text": "چو آید ببین تا چه آیدت رای"
  },
  {
    "poem_id": 87960,
    "vorder": 166,
    "position": 1,
    "text": "در دژ ببند و مپرداز جای"
  },
  {
    "poem_id": 87960,
    "vorder": 167,
    "position": 0,
    "text": "یکی گرز پیروزه دسته بزر"
  },
  {
    "poem_id": 87960,
    "vorder": 168,
    "position": 1,
    "text": "فرود آن زمان برکشید از کمر"
  },
  {
    "poem_id": 87960,
    "vorder": 169,
    "position": 0,
    "text": "بدو داد و گفت این ز من یادگار"
  },
  {
    "poem_id": 87960,
    "vorder": 170,
    "position": 1,
    "text": "همی دار تا خودکی آید بکار"
  },
  {
    "poem_id": 87960,
    "vorder": 171,
    "position": 0,
    "text": "چو طوس سپهبد پذیرد خرام"
  },
  {
    "poem_id": 87960,
    "vorder": 172,
    "position": 1,
    "text": "بباشیم روشن‌دل و شادکام"
  },
  {
    "poem_id": 87960,
    "vorder": 173,
    "position": 0,
    "text": "جزین هدیه‌ها باشد و اسپ و زین"
  },
  {
    "poem_id": 87960,
    "vorder": 174,
    "position": 1,
    "text": "بزر افسر و خسروانی نگین"
  }
]