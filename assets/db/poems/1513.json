[
  {
    "poem_id": 1513,
    "vorder": 1,
    "position": 0,
    "text": "شب تیره شبدیز لهراسپی"
  },
  {
    "poem_id": 1513,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد با زین گشتاسپی"
  },
  {
    "poem_id": 1513,
    "vorder": 3,
    "position": 0,
    "text": "بپوشید زربفت رومی قبای"
  },
  {
    "poem_id": 1513,
    "vorder": 4,
    "position": 1,
    "text": "ز تاج اندر آویخت پر همای"
  },
  {
    "poem_id": 1513,
    "vorder": 5,
    "position": 0,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1513,
    "vorder": 6,
    "position": 1,
    "text": "بیاورد چندان کش آمد به کار"
  },
  {
    "poem_id": 1513,
    "vorder": 7,
    "position": 0,
    "text": "از ایران سوی روم بنهاد روی"
  },
  {
    "poem_id": 1513,
    "vorder": 8,
    "position": 1,
    "text": "به دل گاه جوی و روان راه جوی"
  },
  {
    "poem_id": 1513,
    "vorder": 9,
    "position": 0,
    "text": "پدر چون ز گشتاسپ آگاه شد"
  },
  {
    "poem_id": 1513,
    "vorder": 10,
    "position": 1,
    "text": "بپیچید و شادیش کوتاه شد"
  },
  {
    "poem_id": 1513,
    "vorder": 11,
    "position": 0,
    "text": "زریر و همه بخردان را بخواند"
  },
  {
    "poem_id": 1513,
    "vorder": 12,
    "position": 1,
    "text": "ز گشتاسپ چندی سخنها براند"
  },
  {
    "poem_id": 1513,
    "vorder": 13,
    "position": 0,
    "text": "بدیشان چنین گفت کاین شیر مرد"
  },
  {
    "poem_id": 1513,
    "vorder": 14,
    "position": 1,
    "text": "سر تاجدار اندر آرد به گرد"
  },
  {
    "poem_id": 1513,
    "vorder": 15,
    "position": 0,
    "text": "چه بینید و این را چه درمان کنید"
  },
  {
    "poem_id": 1513,
    "vorder": 16,
    "position": 1,
    "text": "نشاید که این بر دل آسان کنید"
  },
  {
    "poem_id": 1513,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت موبد که این نیک بخت"
  },
  {
    "poem_id": 1513,
    "vorder": 18,
    "position": 1,
    "text": "گرامی به مردان بود تاج و تخت"
  },
  {
    "poem_id": 1513,
    "vorder": 19,
    "position": 0,
    "text": "چو گشتاسپ فرزند کس را نبود"
  },
  {
    "poem_id": 1513,
    "vorder": 20,
    "position": 1,
    "text": "نه هرگز کس از نامداران شنود"
  },
  {
    "poem_id": 1513,
    "vorder": 21,
    "position": 0,
    "text": "ز هر سو بباید فرستاد کس"
  },
  {
    "poem_id": 1513,
    "vorder": 22,
    "position": 1,
    "text": "دلاور بزرگان فریادرس"
  },
  {
    "poem_id": 1513,
    "vorder": 23,
    "position": 0,
    "text": "گر او بازگردد تو زفتی مکن"
  },
  {
    "poem_id": 1513,
    "vorder": 24,
    "position": 1,
    "text": "هنرجوی و با آز جفتی مکن"
  },
  {
    "poem_id": 1513,
    "vorder": 25,
    "position": 0,
    "text": "که تاج کیان چون تو بیند بسی"
  },
  {
    "poem_id": 1513,
    "vorder": 26,
    "position": 1,
    "text": "نماند همی مهر او بر کسی"
  },
  {
    "poem_id": 1513,
    "vorder": 27,
    "position": 0,
    "text": "به گشتاسپ ده زین جهان کشوری"
  },
  {
    "poem_id": 1513,
    "vorder": 28,
    "position": 1,
    "text": "بنه بر سرش نامدار افسری"
  },
  {
    "poem_id": 1513,
    "vorder": 29,
    "position": 0,
    "text": "جز از پهلوان رستم نامدار"
  },
  {
    "poem_id": 1513,
    "vorder": 30,
    "position": 1,
    "text": "به گیتی نبینیم چون او سوار"
  },
  {
    "poem_id": 1513,
    "vorder": 31,
    "position": 0,
    "text": "به بالا و دیدار و فرهنگ و هوش"
  },
  {
    "poem_id": 1513,
    "vorder": 32,
    "position": 1,
    "text": "چنو نامور نیز نشنید گوش"
  },
  {
    "poem_id": 1513,
    "vorder": 33,
    "position": 0,
    "text": "فرستاد لهراسپ چندی مهان"
  },
  {
    "poem_id": 1513,
    "vorder": 34,
    "position": 1,
    "text": "به جستن گرفتند گرد جهان"
  },
  {
    "poem_id": 1513,
    "vorder": 35,
    "position": 0,
    "text": "برفتند و نومید بازآمدند"
  },
  {
    "poem_id": 1513,
    "vorder": 36,
    "position": 1,
    "text": "که با اختر دیرساز آمدند"
  },
  {
    "poem_id": 1513,
    "vorder": 37,
    "position": 0,
    "text": "نکوهش از آن بهر لهراسپ بود"
  },
  {
    "poem_id": 1513,
    "vorder": 38,
    "position": 1,
    "text": "غم و رنج تن بهر گشتاسپ بود"
  }
]