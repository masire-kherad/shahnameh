[
  {
    "poem_id": 1661,
    "vorder": 1,
    "position": 0,
    "text": "چو اسکندر آن نامهٔ او بخواند"
  },
  {
    "poem_id": 1661,
    "vorder": 2,
    "position": 1,
    "text": "بزد نای رویین و لشکر براند"
  },
  {
    "poem_id": 1661,
    "vorder": 3,
    "position": 0,
    "text": "همی رفت یک ماه پویان به راه"
  },
  {
    "poem_id": 1661,
    "vorder": 4,
    "position": 1,
    "text": "چو آمد سوی مرز او با سپاه"
  },
  {
    "poem_id": 1661,
    "vorder": 5,
    "position": 0,
    "text": "یکی پادشا بود فریان به نام"
  },
  {
    "poem_id": 1661,
    "vorder": 6,
    "position": 1,
    "text": "ابا لشکر و گنج و گسترده کام"
  },
  {
    "poem_id": 1661,
    "vorder": 7,
    "position": 0,
    "text": "یکی شارستان داشت با ساز جنگ"
  },
  {
    "poem_id": 1661,
    "vorder": 8,
    "position": 1,
    "text": "سراپردهٔ او ندیدی پلنگ"
  },
  {
    "poem_id": 1661,
    "vorder": 9,
    "position": 0,
    "text": "بیاورد لشکر گرفت آن حصار"
  },
  {
    "poem_id": 1661,
    "vorder": 10,
    "position": 1,
    "text": "بران بارهٔ دژ گذشتی سوار"
  },
  {
    "poem_id": 1661,
    "vorder": 11,
    "position": 0,
    "text": "سکندر بفرمود تا جاثلیق"
  },
  {
    "poem_id": 1661,
    "vorder": 12,
    "position": 1,
    "text": "بیاورد عراده و منجنیق"
  },
  {
    "poem_id": 1661,
    "vorder": 13,
    "position": 0,
    "text": "به یک هفته بستد حصار بلند"
  },
  {
    "poem_id": 1661,
    "vorder": 14,
    "position": 1,
    "text": "به شهر اندر آمد سپاه ارجمند"
  },
  {
    "poem_id": 1661,
    "vorder": 15,
    "position": 0,
    "text": "سکندر چو آمد به شهر اندرون"
  },
  {
    "poem_id": 1661,
    "vorder": 16,
    "position": 1,
    "text": "بفرمود کز کس نریزند خون"
  },
  {
    "poem_id": 1661,
    "vorder": 17,
    "position": 0,
    "text": "یکی پور قیدافه داماد بود"
  },
  {
    "poem_id": 1661,
    "vorder": 18,
    "position": 1,
    "text": "بدین شهر فریان بدو شاد بود"
  },
  {
    "poem_id": 1661,
    "vorder": 19,
    "position": 0,
    "text": "بدو داده بد دختر ارجمند"
  },
  {
    "poem_id": 1661,
    "vorder": 20,
    "position": 1,
    "text": "کلاهش به قیدافه گشته بلند"
  },
  {
    "poem_id": 1661,
    "vorder": 21,
    "position": 0,
    "text": "که داماد را نام بد قیدروش"
  },
  {
    "poem_id": 1661,
    "vorder": 22,
    "position": 1,
    "text": "بدو داده فریان دل و چشم و گوش"
  },
  {
    "poem_id": 1661,
    "vorder": 23,
    "position": 0,
    "text": "یکی مرد بد نام او شهرگیر"
  },
  {
    "poem_id": 1661,
    "vorder": 24,
    "position": 1,
    "text": "به دستش زن و شوی گشته اسیر"
  },
  {
    "poem_id": 1661,
    "vorder": 25,
    "position": 0,
    "text": "سکندر بدانست کان مرد کیست"
  },
  {
    "poem_id": 1661,
    "vorder": 26,
    "position": 1,
    "text": "بجستش که درمان آن کار چیست"
  },
  {
    "poem_id": 1661,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود تا پیش او شد وزیر"
  },
  {
    "poem_id": 1661,
    "vorder": 28,
    "position": 1,
    "text": "بدو داد فرمان و تاج و سریر"
  },
  {
    "poem_id": 1661,
    "vorder": 29,
    "position": 0,
    "text": "خردمند را بیطقون بود نام"
  },
  {
    "poem_id": 1661,
    "vorder": 30,
    "position": 1,
    "text": "یکی رای زن مرد گسترده کام"
  },
  {
    "poem_id": 1661,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت کاید به پیشت عروس"
  },
  {
    "poem_id": 1661,
    "vorder": 32,
    "position": 1,
    "text": "ترا خوانم اسکندر فیلقوس"
  },
  {
    "poem_id": 1661,
    "vorder": 33,
    "position": 0,
    "text": "تو بنشین به آیین و رسم کیان"
  },
  {
    "poem_id": 1661,
    "vorder": 34,
    "position": 1,
    "text": "چو من پیشت آیم کمر بر میان"
  },
  {
    "poem_id": 1661,
    "vorder": 35,
    "position": 0,
    "text": "بفرمای تا گردن قیدروش"
  },
  {
    "poem_id": 1661,
    "vorder": 36,
    "position": 1,
    "text": "ببرد دژآگاه جنگی ز دوش"
  },
  {
    "poem_id": 1661,
    "vorder": 37,
    "position": 0,
    "text": "من آیم به پیشت به خواهشگری"
  },
  {
    "poem_id": 1661,
    "vorder": 38,
    "position": 1,
    "text": "نمایم فراوان ترا کهتری"
  },
  {
    "poem_id": 1661,
    "vorder": 39,
    "position": 0,
    "text": "نشستنگهی ساز بی‌انجمن"
  },
  {
    "poem_id": 1661,
    "vorder": 40,
    "position": 1,
    "text": "چو خواهش فزایم ببخشی بمن"
  },
  {
    "poem_id": 1661,
    "vorder": 41,
    "position": 0,
    "text": "شد آن مرد دستور با درد جفت"
  },
  {
    "poem_id": 1661,
    "vorder": 42,
    "position": 1,
    "text": "ندانست کان را چه باشد نهفت"
  },
  {
    "poem_id": 1661,
    "vorder": 43,
    "position": 0,
    "text": "ازان پس بدو گفت شاه جهان"
  },
  {
    "poem_id": 1661,
    "vorder": 44,
    "position": 1,
    "text": "که این کار باید که ماند نهان"
  },
  {
    "poem_id": 1661,
    "vorder": 45,
    "position": 0,
    "text": "مرا چون فرستادگان پیش خوان"
  },
  {
    "poem_id": 1661,
    "vorder": 46,
    "position": 1,
    "text": "سخنهای قیدافه چندی بران"
  },
  {
    "poem_id": 1661,
    "vorder": 47,
    "position": 0,
    "text": "مرا شاد بفرست با ده سوار"
  },
  {
    "poem_id": 1661,
    "vorder": 48,
    "position": 1,
    "text": "که رو نامه بر زود و پاسخ بیار"
  },
  {
    "poem_id": 1661,
    "vorder": 49,
    "position": 0,
    "text": "بدو بیطقون گفت کایدون کنم"
  },
  {
    "poem_id": 1661,
    "vorder": 50,
    "position": 1,
    "text": "به فرمان برین چاره افسون کنم"
  },
  {
    "poem_id": 1661,
    "vorder": 51,
    "position": 0,
    "text": "به شبگیر خورشید خنجر کشید"
  },
  {
    "poem_id": 1661,
    "vorder": 52,
    "position": 1,
    "text": "شب تیره از بیم شد ناپدید"
  },
  {
    "poem_id": 1661,
    "vorder": 53,
    "position": 0,
    "text": "نشست از بر تخت بر بیطقون"
  },
  {
    "poem_id": 1661,
    "vorder": 54,
    "position": 1,
    "text": "پر از شرم رخ دل پر از آب خون"
  },
  {
    "poem_id": 1661,
    "vorder": 55,
    "position": 0,
    "text": "سکندر به پیش اندرون با کمر"
  },
  {
    "poem_id": 1661,
    "vorder": 56,
    "position": 1,
    "text": "گشاده درچاره و بسته در"
  },
  {
    "poem_id": 1661,
    "vorder": 57,
    "position": 0,
    "text": "چون آن پور قیدافه را شهرگیر"
  },
  {
    "poem_id": 1661,
    "vorder": 58,
    "position": 1,
    "text": "بیاورد گریان گرفته اسیر"
  },
  {
    "poem_id": 1661,
    "vorder": 59,
    "position": 0,
    "text": "زنش هم چنان نیز با بوی و رنگ"
  },
  {
    "poem_id": 1661,
    "vorder": 60,
    "position": 1,
    "text": "گرفته جوان چنگ او را به چنگ"
  },
  {
    "poem_id": 1661,
    "vorder": 61,
    "position": 0,
    "text": "سبک بیطقون گفت کین مرد کیست"
  },
  {
    "poem_id": 1661,
    "vorder": 62,
    "position": 1,
    "text": "کش از درد چندین بباید گریست"
  },
  {
    "poem_id": 1661,
    "vorder": 63,
    "position": 0,
    "text": "چنین داد پاسخ که بازآر هوش"
  },
  {
    "poem_id": 1661,
    "vorder": 64,
    "position": 1,
    "text": "که من پور قیدافه‌ام قیدروش"
  },
  {
    "poem_id": 1661,
    "vorder": 65,
    "position": 0,
    "text": "جزین دخت فریان مرا نیست جفت"
  },
  {
    "poem_id": 1661,
    "vorder": 66,
    "position": 1,
    "text": "که دارد پس پردهٔ من نهفت"
  },
  {
    "poem_id": 1661,
    "vorder": 67,
    "position": 0,
    "text": "برآنم که او را سوی خان خویش"
  },
  {
    "poem_id": 1661,
    "vorder": 68,
    "position": 1,
    "text": "برم تا بدارمش چون جان خویش"
  },
  {
    "poem_id": 1661,
    "vorder": 69,
    "position": 0,
    "text": "اسیرم کنون در کف شهرگیر"
  },
  {
    "poem_id": 1661,
    "vorder": 70,
    "position": 1,
    "text": "روان خسته از اختر و تن به تیر"
  },
  {
    "poem_id": 1661,
    "vorder": 71,
    "position": 0,
    "text": "چو بشنید زو این سخن بیطقون"
  },
  {
    "poem_id": 1661,
    "vorder": 72,
    "position": 1,
    "text": "سرش گشت پر درد و دل پر ز خون"
  },
  {
    "poem_id": 1661,
    "vorder": 73,
    "position": 0,
    "text": "برآشفت ازان پس به دژخیم گفت"
  },
  {
    "poem_id": 1661,
    "vorder": 74,
    "position": 1,
    "text": "که این هر دو را خاک باید نهفت"
  },
  {
    "poem_id": 1661,
    "vorder": 75,
    "position": 0,
    "text": "چنین هم به بند اندرون با زنش"
  },
  {
    "poem_id": 1661,
    "vorder": 76,
    "position": 1,
    "text": "به شمشیر هندی بزن گردنش"
  },
  {
    "poem_id": 1661,
    "vorder": 77,
    "position": 0,
    "text": "سکندر بیامد زمین بوس داد"
  },
  {
    "poem_id": 1661,
    "vorder": 78,
    "position": 1,
    "text": "بدو گفت کای شاه قیصر نژاد"
  },
  {
    "poem_id": 1661,
    "vorder": 79,
    "position": 0,
    "text": "اگر خون ایشان ببخشی به من"
  },
  {
    "poem_id": 1661,
    "vorder": 80,
    "position": 1,
    "text": "سرافراز گردم به هر انجمن"
  },
  {
    "poem_id": 1661,
    "vorder": 81,
    "position": 0,
    "text": "سر بیگناهان چه بری به کین"
  },
  {
    "poem_id": 1661,
    "vorder": 82,
    "position": 1,
    "text": "که نپسندد از ما جهان‌آفرین"
  },
  {
    "poem_id": 1661,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت بیداردل بیطقون"
  },
  {
    "poem_id": 1661,
    "vorder": 84,
    "position": 1,
    "text": "که آزاد کردی دو تن را ز خون"
  },
  {
    "poem_id": 1661,
    "vorder": 85,
    "position": 0,
    "text": "سبک بیطقون گفت با قیدروش"
  },
  {
    "poem_id": 1661,
    "vorder": 86,
    "position": 1,
    "text": "که بردی سر دور مانده ز دوش"
  },
  {
    "poem_id": 1661,
    "vorder": 87,
    "position": 0,
    "text": "فرستم کنون با تو او را بهم"
  },
  {
    "poem_id": 1661,
    "vorder": 88,
    "position": 1,
    "text": "بخواند به مادرت بر بیش و کم"
  },
  {
    "poem_id": 1661,
    "vorder": 89,
    "position": 0,
    "text": "اگر ساو و باژم فرستد نکوست"
  },
  {
    "poem_id": 1661,
    "vorder": 90,
    "position": 1,
    "text": "کسی را ندرد بدین جنگ پوست"
  },
  {
    "poem_id": 1661,
    "vorder": 91,
    "position": 0,
    "text": "نگه کن بدین پاک دستور من"
  },
  {
    "poem_id": 1661,
    "vorder": 92,
    "position": 1,
    "text": "که گوید بدو رزم گر سور من"
  },
  {
    "poem_id": 1661,
    "vorder": 93,
    "position": 0,
    "text": "تو آن کن ز خوبی که او با تو کرد"
  },
  {
    "poem_id": 1661,
    "vorder": 94,
    "position": 1,
    "text": "به پاداش پیچد دل رادمرد"
  },
  {
    "poem_id": 1661,
    "vorder": 95,
    "position": 0,
    "text": "چو این پاسخ نامه یابی ز شاه"
  },
  {
    "poem_id": 1661,
    "vorder": 96,
    "position": 1,
    "text": "به خوبی ورا بازگردان ز راه"
  },
  {
    "poem_id": 1661,
    "vorder": 97,
    "position": 0,
    "text": "چنین گفت با بیقطون قیدروش"
  },
  {
    "poem_id": 1661,
    "vorder": 98,
    "position": 1,
    "text": "که زو بر ندارم دل و چشم و گوش"
  },
  {
    "poem_id": 1661,
    "vorder": 99,
    "position": 0,
    "text": "چگونه مر او را ندارم چو جان"
  },
  {
    "poem_id": 1661,
    "vorder": 100,
    "position": 1,
    "text": "کزو یافتم جفت و شیرین‌روان"
  }
]