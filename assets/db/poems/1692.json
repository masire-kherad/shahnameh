[
  {
    "poem_id": 1692,
    "vorder": 1,
    "position": 0,
    "text": "یکی کاخ بود اردوان را بلند"
  },
  {
    "poem_id": 1692,
    "vorder": 2,
    "position": 1,
    "text": "به کاخ اندرون بنده‌ای ارجمند"
  },
  {
    "poem_id": 1692,
    "vorder": 3,
    "position": 0,
    "text": "که گلنار بد نام آن ماه‌روی"
  },
  {
    "poem_id": 1692,
    "vorder": 4,
    "position": 1,
    "text": "نگاری پر از گوهر و رنگ و بوی"
  },
  {
    "poem_id": 1692,
    "vorder": 5,
    "position": 0,
    "text": "بر اردوان همچو دستور بود"
  },
  {
    "poem_id": 1692,
    "vorder": 6,
    "position": 1,
    "text": "بران خواسته نیز گنجور بود"
  },
  {
    "poem_id": 1692,
    "vorder": 7,
    "position": 0,
    "text": "بروبر گرامی‌تر از جان بدی"
  },
  {
    "poem_id": 1692,
    "vorder": 8,
    "position": 1,
    "text": "به دیدار او شاد و خندان بدی"
  },
  {
    "poem_id": 1692,
    "vorder": 9,
    "position": 0,
    "text": "چنان بد که روزی برآمد به بام"
  },
  {
    "poem_id": 1692,
    "vorder": 10,
    "position": 1,
    "text": "دلش گشت زان خرمی شادکام"
  },
  {
    "poem_id": 1692,
    "vorder": 11,
    "position": 0,
    "text": "نگه کرد خندان لب اردشیر"
  },
  {
    "poem_id": 1692,
    "vorder": 12,
    "position": 1,
    "text": "جوان در دل ماه شد جایگیر"
  },
  {
    "poem_id": 1692,
    "vorder": 13,
    "position": 0,
    "text": "همی بود تا روز تاریک شد"
  },
  {
    "poem_id": 1692,
    "vorder": 14,
    "position": 1,
    "text": "همانا به شب روز نزدیک شد"
  },
  {
    "poem_id": 1692,
    "vorder": 15,
    "position": 0,
    "text": "کمندی بران کنگره بر ببست"
  },
  {
    "poem_id": 1692,
    "vorder": 16,
    "position": 1,
    "text": "گره زد برو چند و ببسود دست"
  },
  {
    "poem_id": 1692,
    "vorder": 17,
    "position": 0,
    "text": "به گستاخی از باره آمد فرود"
  },
  {
    "poem_id": 1692,
    "vorder": 18,
    "position": 1,
    "text": "همی داد نیکی دهش را درود"
  },
  {
    "poem_id": 1692,
    "vorder": 19,
    "position": 0,
    "text": "بیامد خرامان بر اردشیر"
  },
  {
    "poem_id": 1692,
    "vorder": 20,
    "position": 1,
    "text": "پر از گوهر و بوی مشک و عبیر"
  },
  {
    "poem_id": 1692,
    "vorder": 21,
    "position": 0,
    "text": "ز بالین دیبا سرش برگرفت"
  },
  {
    "poem_id": 1692,
    "vorder": 22,
    "position": 1,
    "text": "چو بیدار شد تنگ در بر گرفت"
  },
  {
    "poem_id": 1692,
    "vorder": 23,
    "position": 0,
    "text": "نگه کرد برنا بران خوب‌روی"
  },
  {
    "poem_id": 1692,
    "vorder": 24,
    "position": 1,
    "text": "بدان موی و آن روی و آن رنگ و بوی"
  },
  {
    "poem_id": 1692,
    "vorder": 25,
    "position": 0,
    "text": "بدان ماه گفت از کجا خاستی"
  },
  {
    "poem_id": 1692,
    "vorder": 26,
    "position": 1,
    "text": "که پرغم دلم را بیاراستی"
  },
  {
    "poem_id": 1692,
    "vorder": 27,
    "position": 0,
    "text": "چنین داد پاسخ که من بنده‌ام"
  },
  {
    "poem_id": 1692,
    "vorder": 28,
    "position": 1,
    "text": "ز گیتی به دیدار تو زنده‌ام"
  },
  {
    "poem_id": 1692,
    "vorder": 29,
    "position": 0,
    "text": "دلارام گنجور شاه اردوان"
  },
  {
    "poem_id": 1692,
    "vorder": 30,
    "position": 1,
    "text": "که از من بود شاد و روشن‌روان"
  },
  {
    "poem_id": 1692,
    "vorder": 31,
    "position": 0,
    "text": "کنون گر پذیری ترا بنده‌ام"
  },
  {
    "poem_id": 1692,
    "vorder": 32,
    "position": 1,
    "text": "دل و جان به مهر تو آگنده‌ام"
  },
  {
    "poem_id": 1692,
    "vorder": 33,
    "position": 0,
    "text": "بیایم چو خواهی به نزدیک تو"
  },
  {
    "poem_id": 1692,
    "vorder": 34,
    "position": 1,
    "text": "درفشان کنم روز تاریک تو"
  },
  {
    "poem_id": 1692,
    "vorder": 35,
    "position": 0,
    "text": "چو لختی برآمد برین روزگار"
  },
  {
    "poem_id": 1692,
    "vorder": 36,
    "position": 1,
    "text": "شکست اندر آمد به آموزگار"
  },
  {
    "poem_id": 1692,
    "vorder": 37,
    "position": 0,
    "text": "جهاندیده بیدار بابک بمرد"
  },
  {
    "poem_id": 1692,
    "vorder": 38,
    "position": 1,
    "text": "سرای کهن دیگری را سپرد"
  },
  {
    "poem_id": 1692,
    "vorder": 39,
    "position": 0,
    "text": "چو آگاهی آمد سوی اردوان"
  },
  {
    "poem_id": 1692,
    "vorder": 40,
    "position": 1,
    "text": "پر از غم شد و تیره گشتش روان"
  },
  {
    "poem_id": 1692,
    "vorder": 41,
    "position": 0,
    "text": "گرفتند هر مهتری یاد پارس"
  },
  {
    "poem_id": 1692,
    "vorder": 42,
    "position": 1,
    "text": "سپهبد به مهتر پسر داد پارس"
  },
  {
    "poem_id": 1692,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود تا کوس بیرون برند"
  },
  {
    "poem_id": 1692,
    "vorder": 44,
    "position": 1,
    "text": "ز درگاه لشکر به هامون برند"
  },
  {
    "poem_id": 1692,
    "vorder": 45,
    "position": 0,
    "text": "جهان تیره شد بر دل اردشیر"
  },
  {
    "poem_id": 1692,
    "vorder": 46,
    "position": 1,
    "text": "ازان پیر روشن‌دل و دستگیر"
  },
  {
    "poem_id": 1692,
    "vorder": 47,
    "position": 0,
    "text": "دل از لشکر اردوان برگرفت"
  },
  {
    "poem_id": 1692,
    "vorder": 48,
    "position": 1,
    "text": "وزان آگهی رای دیگر گرفت"
  },
  {
    "poem_id": 1692,
    "vorder": 49,
    "position": 0,
    "text": "که از درد او بد دلش پرستیز"
  },
  {
    "poem_id": 1692,
    "vorder": 50,
    "position": 1,
    "text": "به هر سو همی جست راه گریز"
  },
  {
    "poem_id": 1692,
    "vorder": 51,
    "position": 0,
    "text": "ازان پس چنان بد که شاه اردوان"
  },
  {
    "poem_id": 1692,
    "vorder": 52,
    "position": 1,
    "text": "ز اخترشناسان روشن‌روان"
  },
  {
    "poem_id": 1692,
    "vorder": 53,
    "position": 0,
    "text": "بیاورد چندی به درگاه خویش"
  },
  {
    "poem_id": 1692,
    "vorder": 54,
    "position": 1,
    "text": "همی بازجست اختر و راه خویش"
  },
  {
    "poem_id": 1692,
    "vorder": 55,
    "position": 0,
    "text": "همان نیز تا گردش روزگار"
  },
  {
    "poem_id": 1692,
    "vorder": 56,
    "position": 1,
    "text": "ازان پس کرا باشد آموزگار"
  },
  {
    "poem_id": 1692,
    "vorder": 57,
    "position": 0,
    "text": "فرستادشان نزد گلنار شاه"
  },
  {
    "poem_id": 1692,
    "vorder": 58,
    "position": 1,
    "text": "بدان تا کنند اختران را نگاه"
  },
  {
    "poem_id": 1692,
    "vorder": 59,
    "position": 0,
    "text": "سه روز اندر آن کار شد روزگار"
  },
  {
    "poem_id": 1692,
    "vorder": 60,
    "position": 1,
    "text": "نگه کرده شد طالع شهریار"
  },
  {
    "poem_id": 1692,
    "vorder": 61,
    "position": 0,
    "text": "چو گنجور بشنید آوازشان"
  },
  {
    "poem_id": 1692,
    "vorder": 62,
    "position": 1,
    "text": "سخن گفتن از طالع و رازشان"
  },
  {
    "poem_id": 1692,
    "vorder": 63,
    "position": 0,
    "text": "سیم روز تا شب گذشته سه پاس"
  },
  {
    "poem_id": 1692,
    "vorder": 64,
    "position": 1,
    "text": "کنیزک بپردخت ز اخترشناس"
  },
  {
    "poem_id": 1692,
    "vorder": 65,
    "position": 0,
    "text": "پر از آرزو دل لبان پر ز باد"
  },
  {
    "poem_id": 1692,
    "vorder": 66,
    "position": 1,
    "text": "همی داشت گفتار ایشان به یاد"
  },
  {
    "poem_id": 1692,
    "vorder": 67,
    "position": 0,
    "text": "چهارم بشد مرد روشن‌روان"
  },
  {
    "poem_id": 1692,
    "vorder": 68,
    "position": 1,
    "text": "که بگشاید آن راز با اردوان"
  },
  {
    "poem_id": 1692,
    "vorder": 69,
    "position": 0,
    "text": "برفتند با زیجها برکنار"
  },
  {
    "poem_id": 1692,
    "vorder": 70,
    "position": 1,
    "text": "ز کاخ کنیزک بر شهریار"
  },
  {
    "poem_id": 1692,
    "vorder": 71,
    "position": 0,
    "text": "بگفتند راز سپهر بلند"
  },
  {
    "poem_id": 1692,
    "vorder": 72,
    "position": 1,
    "text": "همان حکم او بر چه و چون و چند"
  },
  {
    "poem_id": 1692,
    "vorder": 73,
    "position": 0,
    "text": "کزین پس کنون تانه بس روزگار"
  },
  {
    "poem_id": 1692,
    "vorder": 74,
    "position": 1,
    "text": "ز چیزی بپیچد دل نامدار"
  },
  {
    "poem_id": 1692,
    "vorder": 75,
    "position": 0,
    "text": "که بگریزد از مهتری کهتری"
  },
  {
    "poem_id": 1692,
    "vorder": 76,
    "position": 1,
    "text": "سپهبد نژادی و کنداوری"
  },
  {
    "poem_id": 1692,
    "vorder": 77,
    "position": 0,
    "text": "وزان پس شود شهریاری بلند"
  },
  {
    "poem_id": 1692,
    "vorder": 78,
    "position": 1,
    "text": "جهاندار و نیک‌اختر و سودمند"
  },
  {
    "poem_id": 1692,
    "vorder": 79,
    "position": 0,
    "text": "دل نامور مهتر نیک‌بخت"
  },
  {
    "poem_id": 1692,
    "vorder": 80,
    "position": 1,
    "text": "ز گفتار ایشان غمی گشت سخت"
  }
]