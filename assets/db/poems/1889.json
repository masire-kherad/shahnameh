[
  {
    "poem_id": 1889,
    "vorder": 1,
    "position": 0,
    "text": "ازآن پس به آرام بنشست شاه"
  },
  {
    "poem_id": 1889,
    "vorder": 2,
    "position": 1,
    "text": "چو برخاست بهرام جنگی ز راه"
  },
  {
    "poem_id": 1889,
    "vorder": 3,
    "position": 0,
    "text": "ندید از بزرگان کسی کینه جوی"
  },
  {
    "poem_id": 1889,
    "vorder": 4,
    "position": 1,
    "text": "که با او بروی اندر آورد روی"
  },
  {
    "poem_id": 1889,
    "vorder": 5,
    "position": 0,
    "text": "به دستور پاکیزه یک روز گفت"
  },
  {
    "poem_id": 1889,
    "vorder": 6,
    "position": 1,
    "text": "که اندیشه تا کی بود در نهفت"
  },
  {
    "poem_id": 1889,
    "vorder": 7,
    "position": 0,
    "text": "کشندهٔ پدر هر زمان پیش من"
  },
  {
    "poem_id": 1889,
    "vorder": 8,
    "position": 1,
    "text": "همی‌بگذرد چون بود خویش من"
  },
  {
    "poem_id": 1889,
    "vorder": 9,
    "position": 0,
    "text": "چوروشن روانم پر از خون بود"
  },
  {
    "poem_id": 1889,
    "vorder": 10,
    "position": 1,
    "text": "همی پادشاهی کنم چون بود"
  },
  {
    "poem_id": 1889,
    "vorder": 11,
    "position": 0,
    "text": "نهادند خوان و می چند خورد"
  },
  {
    "poem_id": 1889,
    "vorder": 12,
    "position": 1,
    "text": "هم آن روز بندوی رابند کرد"
  },
  {
    "poem_id": 1889,
    "vorder": 13,
    "position": 0,
    "text": "ازان پس چنین گفت با رهنما"
  },
  {
    "poem_id": 1889,
    "vorder": 14,
    "position": 1,
    "text": "که او را هم‌اکنون ببردست وپا"
  },
  {
    "poem_id": 1889,
    "vorder": 15,
    "position": 0,
    "text": "بریدند هم در زمان او بمرد"
  },
  {
    "poem_id": 1889,
    "vorder": 16,
    "position": 1,
    "text": "پر از خون روانش به خسرو سپرد"
  }
]