[
  {
    "poem_id": 52172,
    "vorder": 1,
    "position": 0,
    "text": "ز گفتار او شاد شد ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 2,
    "position": 1,
    "text": "بدو گفت مانا که اینست راه"
  },
  {
    "poem_id": 52172,
    "vorder": 3,
    "position": 0,
    "text": "چو خراد برزین سوی خانه رفت"
  },
  {
    "poem_id": 52172,
    "vorder": 4,
    "position": 1,
    "text": "برآمد شب تیره از کوه تفت"
  },
  {
    "poem_id": 52172,
    "vorder": 5,
    "position": 0,
    "text": "بسیجید و برساخت راه گریز"
  },
  {
    "poem_id": 52172,
    "vorder": 6,
    "position": 1,
    "text": "بدان تا نیاید بدو رستخیز"
  },
  {
    "poem_id": 52172,
    "vorder": 7,
    "position": 0,
    "text": "بدانگه که شب تیره‌تر گشت شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 8,
    "position": 1,
    "text": "به فغفور فرمود تا بی‌سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 9,
    "position": 0,
    "text": "ز پیش پدر تا در پهلوان"
  },
  {
    "poem_id": 52172,
    "vorder": 10,
    "position": 1,
    "text": "بیامد خردمند مرد جوان"
  },
  {
    "poem_id": 52172,
    "vorder": 11,
    "position": 0,
    "text": "چو آمد به نزدیک ایران سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 12,
    "position": 1,
    "text": "سواری برافگند فرزند شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 13,
    "position": 0,
    "text": "که پرسد که این جنگجویان کیند"
  },
  {
    "poem_id": 52172,
    "vorder": 14,
    "position": 1,
    "text": "ازین تاختن ساخته بر چیند"
  },
  {
    "poem_id": 52172,
    "vorder": 15,
    "position": 0,
    "text": "ز ترکان سواری بیامد چو گرد"
  },
  {
    "poem_id": 52172,
    "vorder": 16,
    "position": 1,
    "text": "خروشید کای نامداران مرد"
  },
  {
    "poem_id": 52172,
    "vorder": 17,
    "position": 0,
    "text": "سپهبد کدامست و سالار کیست"
  },
  {
    "poem_id": 52172,
    "vorder": 18,
    "position": 1,
    "text": "به رزم اندرون نامبُردار کیست"
  },
  {
    "poem_id": 52172,
    "vorder": 19,
    "position": 0,
    "text": "که فغفور چشم و دل ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 20,
    "position": 1,
    "text": "ورا دید خواهد همی بی‌سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 21,
    "position": 0,
    "text": "ز لشکر بیامد یکی رزمجوی"
  },
  {
    "poem_id": 52172,
    "vorder": 22,
    "position": 1,
    "text": "به بهرام گفت آنچ بشنید زوی"
  },
  {
    "poem_id": 52172,
    "vorder": 23,
    "position": 0,
    "text": "سپهدار آمد ز پرده سرای"
  },
  {
    "poem_id": 52172,
    "vorder": 24,
    "position": 1,
    "text": "درفشی دُرفشان به سر بر به پای"
  },
  {
    "poem_id": 52172,
    "vorder": 25,
    "position": 0,
    "text": "چو فغفور چینی بدیدش بتاخت"
  },
  {
    "poem_id": 52172,
    "vorder": 26,
    "position": 1,
    "text": "سمند جهان را به خوی درنشاخت"
  },
  {
    "poem_id": 52172,
    "vorder": 27,
    "position": 0,
    "text": "بپرسید و گفت از کجا رانده‌ای"
  },
  {
    "poem_id": 52172,
    "vorder": 28,
    "position": 1,
    "text": "کنون ایستاده چرا مانده‌ای"
  },
  {
    "poem_id": 52172,
    "vorder": 29,
    "position": 0,
    "text": "شنیدم که از پارس بگریختی"
  },
  {
    "poem_id": 52172,
    "vorder": 30,
    "position": 1,
    "text": "که آزرده گشتی وخون ریختی"
  },
  {
    "poem_id": 52172,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت بهرام کین خود مباد"
  },
  {
    "poem_id": 52172,
    "vorder": 32,
    "position": 1,
    "text": "که با شاه ایران کنم کینه یاد"
  },
  {
    "poem_id": 52172,
    "vorder": 33,
    "position": 0,
    "text": "من ایدون به رزم آمدم با سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 34,
    "position": 1,
    "text": "ز بغداد رفتم به فرمان شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 35,
    "position": 0,
    "text": "چو از لشکر ساوه‌شاه آگهی"
  },
  {
    "poem_id": 52172,
    "vorder": 36,
    "position": 1,
    "text": "بیامد بدان بارگاه مهی"
  },
  {
    "poem_id": 52172,
    "vorder": 37,
    "position": 0,
    "text": "مرا گفت رو راه ایشان بگیر"
  },
  {
    "poem_id": 52172,
    "vorder": 38,
    "position": 1,
    "text": "به گُرز و سنان و به شمشیر و تیر"
  },
  {
    "poem_id": 52172,
    "vorder": 39,
    "position": 0,
    "text": "چو بشنید فغفور برگشت زود"
  },
  {
    "poem_id": 52172,
    "vorder": 40,
    "position": 1,
    "text": "به پیش پدر شد بگفت آنچه بود"
  },
  {
    "poem_id": 52172,
    "vorder": 41,
    "position": 0,
    "text": "شنید آن سخن شاه شد بدگمان"
  },
  {
    "poem_id": 52172,
    "vorder": 42,
    "position": 1,
    "text": "فرستاده را جست هم در زمان"
  },
  {
    "poem_id": 52172,
    "vorder": 43,
    "position": 0,
    "text": "یکی گفت خراد برزین گریخت"
  },
  {
    "poem_id": 52172,
    "vorder": 44,
    "position": 1,
    "text": "همی ز آمدن خون ز مژگان بریخت"
  },
  {
    "poem_id": 52172,
    "vorder": 45,
    "position": 0,
    "text": "چنین گفت پس با پسر ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 46,
    "position": 1,
    "text": "که این بدگمان مرد چون یافت راه"
  },
  {
    "poem_id": 52172,
    "vorder": 47,
    "position": 0,
    "text": "شب تیره و لشکری بی‌شمار"
  },
  {
    "poem_id": 52172,
    "vorder": 48,
    "position": 1,
    "text": "طلایه چرا شد چنین سست و خوار"
  },
  {
    "poem_id": 52172,
    "vorder": 49,
    "position": 0,
    "text": "وزان پس فرستاد مرد کهن"
  },
  {
    "poem_id": 52172,
    "vorder": 50,
    "position": 1,
    "text": "به نزدیک بهرام چیره سخن"
  },
  {
    "poem_id": 52172,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت رو پارسی را بگوی"
  },
  {
    "poem_id": 52172,
    "vorder": 52,
    "position": 1,
    "text": "که ایدر به خیره مریز آب روی"
  },
  {
    "poem_id": 52172,
    "vorder": 53,
    "position": 0,
    "text": "همانا که این مایه دانی درست"
  },
  {
    "poem_id": 52172,
    "vorder": 54,
    "position": 1,
    "text": "کزین پادشاه تو مرگ تو جست"
  },
  {
    "poem_id": 52172,
    "vorder": 55,
    "position": 0,
    "text": "به جنگت فرستاد نزد کسی"
  },
  {
    "poem_id": 52172,
    "vorder": 56,
    "position": 1,
    "text": "که همتا ندارد به گیتی بسی"
  },
  {
    "poem_id": 52172,
    "vorder": 57,
    "position": 0,
    "text": "تو را گفت رو راه بر من بگیر"
  },
  {
    "poem_id": 52172,
    "vorder": 58,
    "position": 1,
    "text": "شنیدی تو گفتار نادلپذیر"
  },
  {
    "poem_id": 52172,
    "vorder": 59,
    "position": 0,
    "text": "اگر کوه نزد من آید به راه"
  },
  {
    "poem_id": 52172,
    "vorder": 60,
    "position": 1,
    "text": "به پای اندر آرم به پیل و سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 61,
    "position": 0,
    "text": "چو بشنید بهرام گفتار اوی"
  },
  {
    "poem_id": 52172,
    "vorder": 62,
    "position": 1,
    "text": "بخندید زان تیز بازار اوی"
  },
  {
    "poem_id": 52172,
    "vorder": 63,
    "position": 0,
    "text": "چنین داد پاسخ که شاه جهان"
  },
  {
    "poem_id": 52172,
    "vorder": 64,
    "position": 1,
    "text": "اگر مرگ من جوید اندر نهان"
  },
  {
    "poem_id": 52172,
    "vorder": 65,
    "position": 0,
    "text": "چو خشنود باشد ز من شایدم"
  },
  {
    "poem_id": 52172,
    "vorder": 66,
    "position": 1,
    "text": "اگر خاک بالا بپیمایدم"
  },
  {
    "poem_id": 52172,
    "vorder": 67,
    "position": 0,
    "text": "فرستاده آمد بر ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 68,
    "position": 1,
    "text": "بگفت آنچ بشنید زان رزمخواه"
  },
  {
    "poem_id": 52172,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت رو پارسی را بگوی"
  },
  {
    "poem_id": 52172,
    "vorder": 70,
    "position": 1,
    "text": "که چندین چرا بایدت گفت و گوی"
  },
  {
    "poem_id": 52172,
    "vorder": 71,
    "position": 0,
    "text": "چرا آمده‌ستی بدین بارگاه"
  },
  {
    "poem_id": 52172,
    "vorder": 72,
    "position": 1,
    "text": "ز ما آرزو هرچ باید بخواه"
  },
  {
    "poem_id": 52172,
    "vorder": 73,
    "position": 0,
    "text": "فرستاده آمد به بهرام گفت"
  },
  {
    "poem_id": 52172,
    "vorder": 74,
    "position": 1,
    "text": "که رازی که داری بر آر از نهفت"
  },
  {
    "poem_id": 52172,
    "vorder": 75,
    "position": 0,
    "text": "که این شهریاریست نیک اختری"
  },
  {
    "poem_id": 52172,
    "vorder": 76,
    "position": 1,
    "text": "بجوید همی چون تو فرمانبری"
  },
  {
    "poem_id": 52172,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت بهرام کو را بگوی"
  },
  {
    "poem_id": 52172,
    "vorder": 78,
    "position": 1,
    "text": "که گر رزمجویی بهانه مجوی"
  },
  {
    "poem_id": 52172,
    "vorder": 79,
    "position": 0,
    "text": "گر ایدون که‌ با شهریار جهان"
  },
  {
    "poem_id": 52172,
    "vorder": 80,
    "position": 1,
    "text": "همی آشتی جویی اندر نهان"
  },
  {
    "poem_id": 52172,
    "vorder": 81,
    "position": 0,
    "text": "تو را اندرین مرز مهمان کنم"
  },
  {
    "poem_id": 52172,
    "vorder": 82,
    "position": 1,
    "text": "به چیزی که گویی تو فرمان کنم"
  },
  {
    "poem_id": 52172,
    "vorder": 83,
    "position": 0,
    "text": "ببخشم سپاه تو را سیم و زر"
  },
  {
    "poem_id": 52172,
    "vorder": 84,
    "position": 1,
    "text": "کرا درخور آید کلاه و کمر"
  },
  {
    "poem_id": 52172,
    "vorder": 85,
    "position": 0,
    "text": "سواری فرستیم نزدیک شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 86,
    "position": 1,
    "text": "بدان تا به راه آیدت نیم راه"
  },
  {
    "poem_id": 52172,
    "vorder": 87,
    "position": 0,
    "text": "بسان همالان علف سازدت"
  },
  {
    "poem_id": 52172,
    "vorder": 88,
    "position": 1,
    "text": "اگر دوستی شاه بنوازدت"
  },
  {
    "poem_id": 52172,
    "vorder": 89,
    "position": 0,
    "text": "ور ایدون که ایدر به جنگ آمدی"
  },
  {
    "poem_id": 52172,
    "vorder": 90,
    "position": 1,
    "text": "به دریا به جنگ نهنگ آمدی"
  },
  {
    "poem_id": 52172,
    "vorder": 91,
    "position": 0,
    "text": "چنان بازگردی ز دشت هری"
  },
  {
    "poem_id": 52172,
    "vorder": 92,
    "position": 1,
    "text": "که بر تو بگریند هر مهتری"
  },
  {
    "poem_id": 52172,
    "vorder": 93,
    "position": 0,
    "text": "به برگشتنت پیش در چاه باد"
  },
  {
    "poem_id": 52172,
    "vorder": 94,
    "position": 1,
    "text": "پست باد و بارانت همراه باد"
  },
  {
    "poem_id": 52172,
    "vorder": 95,
    "position": 0,
    "text": "نیاوردت ایدر مگر بخت بد"
  },
  {
    "poem_id": 52172,
    "vorder": 96,
    "position": 1,
    "text": "همی‌ خواست تا بر سرت بد رسد"
  },
  {
    "poem_id": 52172,
    "vorder": 97,
    "position": 0,
    "text": "فرستاده برگشت و آمد چو باد"
  },
  {
    "poem_id": 52172,
    "vorder": 98,
    "position": 1,
    "text": "پیام جهان جوی یک یک بداد"
  },
  {
    "poem_id": 52172,
    "vorder": 99,
    "position": 0,
    "text": "چو بشنید پیغام او ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 100,
    "position": 1,
    "text": "برآشفت زان نامور رزمخواه"
  },
  {
    "poem_id": 52172,
    "vorder": 101,
    "position": 0,
    "text": "ازان سرد گفتن دلش تنگ شد"
  },
  {
    "poem_id": 52172,
    "vorder": 102,
    "position": 1,
    "text": "رخانش ز اندیشه بی‌رنگ شد"
  },
  {
    "poem_id": 52172,
    "vorder": 103,
    "position": 0,
    "text": "فرستاده را گفت رو باز گرد"
  },
  {
    "poem_id": 52172,
    "vorder": 104,
    "position": 1,
    "text": "پیامی ببر نزد آن دیومرد"
  },
  {
    "poem_id": 52172,
    "vorder": 105,
    "position": 0,
    "text": "بگویش که در جنگ تو نیست نام"
  },
  {
    "poem_id": 52172,
    "vorder": 106,
    "position": 1,
    "text": "نه از کشتنت نیز یابیم کام"
  },
  {
    "poem_id": 52172,
    "vorder": 107,
    "position": 0,
    "text": "چو شاه تو بر در مرا کهترند"
  },
  {
    "poem_id": 52172,
    "vorder": 108,
    "position": 1,
    "text": "تو را کمترین چاکران مهترند"
  },
  {
    "poem_id": 52172,
    "vorder": 109,
    "position": 0,
    "text": "گر ایدون که‌ زنهار خواهی ز من"
  },
  {
    "poem_id": 52172,
    "vorder": 110,
    "position": 1,
    "text": "سرت برگذارم ازین انجمن"
  },
  {
    "poem_id": 52172,
    "vorder": 111,
    "position": 0,
    "text": "فراوان بیابی زمن خواسته"
  },
  {
    "poem_id": 52172,
    "vorder": 112,
    "position": 1,
    "text": "شود لشکرت یکسر آراسته"
  },
  {
    "poem_id": 52172,
    "vorder": 113,
    "position": 0,
    "text": "به گفتار بی سود و دیوانگی"
  },
  {
    "poem_id": 52172,
    "vorder": 114,
    "position": 1,
    "text": "نجوید جهانجوی مردانگی"
  },
  {
    "poem_id": 52172,
    "vorder": 115,
    "position": 0,
    "text": "فرستادهٔ مرد گردنفراز"
  },
  {
    "poem_id": 52172,
    "vorder": 116,
    "position": 1,
    "text": "بیامد به نزدیک بهرام باز"
  },
  {
    "poem_id": 52172,
    "vorder": 117,
    "position": 0,
    "text": "بگفت آن گزاینده پیغام اوی"
  },
  {
    "poem_id": 52172,
    "vorder": 118,
    "position": 1,
    "text": "همانا که بد زان سخن کام اوی"
  },
  {
    "poem_id": 52172,
    "vorder": 119,
    "position": 0,
    "text": "چو بشنید با مرد گوینده گفت"
  },
  {
    "poem_id": 52172,
    "vorder": 120,
    "position": 1,
    "text": "که پاسخ ز مهتر نباید نهفت"
  },
  {
    "poem_id": 52172,
    "vorder": 121,
    "position": 0,
    "text": "بگویش که گر من چنین کهترم"
  },
  {
    "poem_id": 52172,
    "vorder": 122,
    "position": 1,
    "text": "نه ننگ آید از کهتری بر سرم"
  },
  {
    "poem_id": 52172,
    "vorder": 123,
    "position": 0,
    "text": "شهنشاه و آن لشکر از ننگ تو"
  },
  {
    "poem_id": 52172,
    "vorder": 124,
    "position": 1,
    "text": "به تندی نجوید همی جنگ تو"
  },
  {
    "poem_id": 52172,
    "vorder": 125,
    "position": 0,
    "text": "من از خردگی رانده‌ام با سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 126,
    "position": 1,
    "text": "که ویران کنم لشکر ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 127,
    "position": 0,
    "text": "ببرم سرت را برم نزد شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 128,
    "position": 1,
    "text": "نیرزد که بر نیزه سازم به راه"
  },
  {
    "poem_id": 52172,
    "vorder": 129,
    "position": 0,
    "text": "چو من زینهاری بود ننگ تو"
  },
  {
    "poem_id": 52172,
    "vorder": 130,
    "position": 1,
    "text": "بدین خردگی کردم آهنگ تو"
  },
  {
    "poem_id": 52172,
    "vorder": 131,
    "position": 0,
    "text": "نبینی مرا جز به روز نبرد"
  },
  {
    "poem_id": 52172,
    "vorder": 132,
    "position": 1,
    "text": "درفشی پس پشت من لاژورد"
  },
  {
    "poem_id": 52172,
    "vorder": 133,
    "position": 0,
    "text": "که دیدار آن اژدها مرگ‌ تست"
  },
  {
    "poem_id": 52172,
    "vorder": 134,
    "position": 1,
    "text": "نیام سنانم سر و ترگ تست"
  },
  {
    "poem_id": 52172,
    "vorder": 135,
    "position": 0,
    "text": "چو بشنید گفتارهای درشت"
  },
  {
    "poem_id": 52172,
    "vorder": 136,
    "position": 1,
    "text": "فرستادهٔ ساوه بنمود پشت"
  },
  {
    "poem_id": 52172,
    "vorder": 137,
    "position": 0,
    "text": "بیامد بگفت آنچ دید و شنید"
  },
  {
    "poem_id": 52172,
    "vorder": 138,
    "position": 1,
    "text": "سر شاه ترکان ز کین بردمید"
  },
  {
    "poem_id": 52172,
    "vorder": 139,
    "position": 0,
    "text": "بفرمود تا کوس بیرون برند"
  },
  {
    "poem_id": 52172,
    "vorder": 140,
    "position": 1,
    "text": "سرافراز پیلان به هامون برند"
  },
  {
    "poem_id": 52172,
    "vorder": 141,
    "position": 0,
    "text": "سیه شد همه کشور از گرد سم"
  },
  {
    "poem_id": 52172,
    "vorder": 142,
    "position": 1,
    "text": "برآمد خروشیدن گاودم"
  },
  {
    "poem_id": 52172,
    "vorder": 143,
    "position": 0,
    "text": "چو بشنید بهرام کآمد سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 144,
    "position": 1,
    "text": "در و دشت شد سرخ و زرد و سیاه"
  },
  {
    "poem_id": 52172,
    "vorder": 145,
    "position": 0,
    "text": "سپه را بفرمود تا برنشست"
  },
  {
    "poem_id": 52172,
    "vorder": 146,
    "position": 1,
    "text": "بیامد زره دار و گهُرزی به دست"
  },
  {
    "poem_id": 52172,
    "vorder": 147,
    "position": 0,
    "text": "پس پشت بد شارستان هری"
  },
  {
    "poem_id": 52172,
    "vorder": 148,
    "position": 1,
    "text": "به پیش اندرون تیغ زن لشکری"
  },
  {
    "poem_id": 52172,
    "vorder": 149,
    "position": 0,
    "text": "بیاراست با میمنه میسره"
  },
  {
    "poem_id": 52172,
    "vorder": 150,
    "position": 1,
    "text": "سپاهی همه کینه کش یکسره"
  },
  {
    "poem_id": 52172,
    "vorder": 151,
    "position": 0,
    "text": "تو گفتی جهان یکسر از آهنست"
  },
  {
    "poem_id": 52172,
    "vorder": 152,
    "position": 1,
    "text": "ستاره ز نوک سنان روشنست"
  },
  {
    "poem_id": 52172,
    "vorder": 153,
    "position": 0,
    "text": "نگه کرد زان رزمگاه ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 154,
    "position": 1,
    "text": "به آرایش و ساز آن رزمگاه"
  },
  {
    "poem_id": 52172,
    "vorder": 155,
    "position": 0,
    "text": "هری از پس پشت بهرام بود"
  },
  {
    "poem_id": 52172,
    "vorder": 156,
    "position": 1,
    "text": "همه جای خود تنگ و ناکام بود"
  },
  {
    "poem_id": 52172,
    "vorder": 157,
    "position": 0,
    "text": "چنین گفت پس باسواران خویش"
  },
  {
    "poem_id": 52172,
    "vorder": 158,
    "position": 1,
    "text": "جهاندیده و غمگساران خویش"
  },
  {
    "poem_id": 52172,
    "vorder": 159,
    "position": 0,
    "text": "که آمد فریبنده‌ای نزد من"
  },
  {
    "poem_id": 52172,
    "vorder": 160,
    "position": 1,
    "text": "ازان پارسی مهتر انجمن"
  },
  {
    "poem_id": 52172,
    "vorder": 161,
    "position": 0,
    "text": "همی‌بود تا آن سپه شارستان"
  },
  {
    "poem_id": 52172,
    "vorder": 162,
    "position": 1,
    "text": "گرفتند و شد جای من خارستان"
  },
  {
    "poem_id": 52172,
    "vorder": 163,
    "position": 0,
    "text": "بدان جای تنگی صفی برکشید"
  },
  {
    "poem_id": 52172,
    "vorder": 164,
    "position": 1,
    "text": "هوا نیلگون شد زمین ناپدید"
  },
  {
    "poem_id": 52172,
    "vorder": 165,
    "position": 0,
    "text": "سپه بود بر میمنه چل هزار"
  },
  {
    "poem_id": 52172,
    "vorder": 166,
    "position": 1,
    "text": "که تنگ آمدش جای خنجرگزار"
  },
  {
    "poem_id": 52172,
    "vorder": 167,
    "position": 0,
    "text": "همان چل هزار از دلیران مرد"
  },
  {
    "poem_id": 52172,
    "vorder": 168,
    "position": 1,
    "text": "پس پشت لشکرش بر پای کرد"
  },
  {
    "poem_id": 52172,
    "vorder": 169,
    "position": 0,
    "text": "ز لشکر بسی نیز بیکار بود"
  },
  {
    "poem_id": 52172,
    "vorder": 170,
    "position": 1,
    "text": "بدان تنگی اندر گرفتار بود"
  },
  {
    "poem_id": 52172,
    "vorder": 171,
    "position": 0,
    "text": "چو دیوار پیلان به پیش سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 172,
    "position": 1,
    "text": "فراز آوریدند و بستند راه"
  },
  {
    "poem_id": 52172,
    "vorder": 173,
    "position": 0,
    "text": "پس اندر غمی شد دل ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 174,
    "position": 1,
    "text": "که تنگ آمدش جایگاه سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 175,
    "position": 0,
    "text": "تو گفتی بگرید همی بخت اوی"
  },
  {
    "poem_id": 52172,
    "vorder": 176,
    "position": 1,
    "text": "که بیکار خواهد بدن تخت اوی"
  },
  {
    "poem_id": 52172,
    "vorder": 177,
    "position": 0,
    "text": "دگر باره گردی زبان آوری"
  },
  {
    "poem_id": 52172,
    "vorder": 178,
    "position": 1,
    "text": "فریبنده مردی ز دشت هری"
  },
  {
    "poem_id": 52172,
    "vorder": 179,
    "position": 0,
    "text": "فرستاد نزدیک بهرام و گفت"
  },
  {
    "poem_id": 52172,
    "vorder": 180,
    "position": 1,
    "text": "که بخت سپهری تو را نیست جفت"
  },
  {
    "poem_id": 52172,
    "vorder": 181,
    "position": 0,
    "text": "همی‌ بشنوی چند پند و سخن"
  },
  {
    "poem_id": 52172,
    "vorder": 182,
    "position": 1,
    "text": "خرد یار کن چشم دل بازکن"
  },
  {
    "poem_id": 52172,
    "vorder": 183,
    "position": 0,
    "text": "دو تن یافته‌ستی که اندر جهان"
  },
  {
    "poem_id": 52172,
    "vorder": 184,
    "position": 1,
    "text": "چو ایشان نبود از نژاد مهان"
  },
  {
    "poem_id": 52172,
    "vorder": 185,
    "position": 0,
    "text": "چو خورشید بر آسمان روشنند"
  },
  {
    "poem_id": 52172,
    "vorder": 186,
    "position": 1,
    "text": "ز مردی همه ساله در جوشنند"
  },
  {
    "poem_id": 52172,
    "vorder": 187,
    "position": 0,
    "text": "یکی من که شاهم جهان را به داد"
  },
  {
    "poem_id": 52172,
    "vorder": 188,
    "position": 1,
    "text": "دگر نیز فرزند فرخ نژاد"
  },
  {
    "poem_id": 52172,
    "vorder": 189,
    "position": 0,
    "text": "سپاهم فزونتر ز برگ درخت"
  },
  {
    "poem_id": 52172,
    "vorder": 190,
    "position": 1,
    "text": "اگر بشمرد مردم نیکبخت"
  },
  {
    "poem_id": 52172,
    "vorder": 191,
    "position": 0,
    "text": "گراز پیل و لشکر بگیرم شمار"
  },
  {
    "poem_id": 52172,
    "vorder": 192,
    "position": 1,
    "text": "بخندی ز باران ابر بهار"
  },
  {
    "poem_id": 52172,
    "vorder": 193,
    "position": 0,
    "text": "سلیحست و خرگاه و پرده سرای"
  },
  {
    "poem_id": 52172,
    "vorder": 194,
    "position": 1,
    "text": "فزون زانک اندیشه آرد به جای"
  },
  {
    "poem_id": 52172,
    "vorder": 195,
    "position": 0,
    "text": "ز اسبان و مردان بیابان و کوه"
  },
  {
    "poem_id": 52172,
    "vorder": 196,
    "position": 1,
    "text": "اگر بشمرد نیز گردد ستوه"
  },
  {
    "poem_id": 52172,
    "vorder": 197,
    "position": 0,
    "text": "همه شهریاران مرا کهترند"
  },
  {
    "poem_id": 52172,
    "vorder": 198,
    "position": 1,
    "text": "اگر کهتری را خود اندر خورند"
  },
  {
    "poem_id": 52172,
    "vorder": 199,
    "position": 0,
    "text": "اگر گرددی آب دریا روان"
  },
  {
    "poem_id": 52172,
    "vorder": 200,
    "position": 1,
    "text": "وگر کوه را پای باشد دوان"
  },
  {
    "poem_id": 52172,
    "vorder": 201,
    "position": 0,
    "text": "نبردارد از جای گنج مرا"
  },
  {
    "poem_id": 52172,
    "vorder": 202,
    "position": 1,
    "text": "سلیح مرا ساز رنج مرا"
  },
  {
    "poem_id": 52172,
    "vorder": 203,
    "position": 0,
    "text": "جز از پارسی مهترت در جهان"
  },
  {
    "poem_id": 52172,
    "vorder": 204,
    "position": 1,
    "text": "مرا شاه خوانند فرخ مهان"
  },
  {
    "poem_id": 52172,
    "vorder": 205,
    "position": 0,
    "text": "تو را هم زمانه به دست منست"
  },
  {
    "poem_id": 52172,
    "vorder": 206,
    "position": 1,
    "text": "به پیش روان من این روشنست"
  },
  {
    "poem_id": 52172,
    "vorder": 207,
    "position": 0,
    "text": "اگر من ز جای اندر آرم سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 208,
    "position": 1,
    "text": "ببندند بر مور و بر پشه راه"
  },
  {
    "poem_id": 52172,
    "vorder": 209,
    "position": 0,
    "text": "همان پیل بر گستوان‌ور هزار"
  },
  {
    "poem_id": 52172,
    "vorder": 210,
    "position": 1,
    "text": "که بگریزد از بوی ایشان سوار"
  },
  {
    "poem_id": 52172,
    "vorder": 211,
    "position": 0,
    "text": "به ایران زمین هرک پیش آیدم"
  },
  {
    "poem_id": 52172,
    "vorder": 212,
    "position": 1,
    "text": "ازان آمدن رنج نفزایدم"
  },
  {
    "poem_id": 52172,
    "vorder": 213,
    "position": 0,
    "text": "از ایدر مرا تا در طیسفون"
  },
  {
    "poem_id": 52172,
    "vorder": 214,
    "position": 1,
    "text": "سپاهست مانا که باشد فزون"
  },
  {
    "poem_id": 52172,
    "vorder": 215,
    "position": 0,
    "text": "تو را ای بد اختر که بفریفته‌ست"
  },
  {
    "poem_id": 52172,
    "vorder": 216,
    "position": 1,
    "text": "فریبندهٔ تو مگر شیفته‌ست"
  },
  {
    "poem_id": 52172,
    "vorder": 217,
    "position": 0,
    "text": "تو را بر تن خویشتن مهر نیست"
  },
  {
    "poem_id": 52172,
    "vorder": 218,
    "position": 1,
    "text": "وگر هست مهر تو را چهر نیست"
  },
  {
    "poem_id": 52172,
    "vorder": 219,
    "position": 0,
    "text": "که نشناسدی چشم او نیک و بد"
  },
  {
    "poem_id": 52172,
    "vorder": 220,
    "position": 1,
    "text": "گزاف از خرد یافته کی سزد"
  },
  {
    "poem_id": 52172,
    "vorder": 221,
    "position": 0,
    "text": "بپرهیز زین جنگ و پیش من آی"
  },
  {
    "poem_id": 52172,
    "vorder": 222,
    "position": 1,
    "text": "نمانم که مانی زمانی به پای"
  },
  {
    "poem_id": 52172,
    "vorder": 223,
    "position": 0,
    "text": "تو را کدخدایی و دختر دهم"
  },
  {
    "poem_id": 52172,
    "vorder": 224,
    "position": 1,
    "text": "همان ارجمندی و اختر دهم"
  },
  {
    "poem_id": 52172,
    "vorder": 225,
    "position": 0,
    "text": "بیابی به نزدیک من مهتری"
  },
  {
    "poem_id": 52172,
    "vorder": 226,
    "position": 1,
    "text": "شوی بی‌نیاز از بد کهتری"
  },
  {
    "poem_id": 52172,
    "vorder": 227,
    "position": 0,
    "text": "چوکشته شود شاه ایران به جنگ"
  },
  {
    "poem_id": 52172,
    "vorder": 228,
    "position": 1,
    "text": "تو را آید آن تاج و تختش به چنگ"
  },
  {
    "poem_id": 52172,
    "vorder": 229,
    "position": 0,
    "text": "وزان جایگه من شوم سوی روم"
  },
  {
    "poem_id": 52172,
    "vorder": 230,
    "position": 1,
    "text": "تو را مانم این لشکر و گنج و بوم"
  },
  {
    "poem_id": 52172,
    "vorder": 231,
    "position": 0,
    "text": "ازان گفتم این کم پسند آمدی"
  },
  {
    "poem_id": 52172,
    "vorder": 232,
    "position": 1,
    "text": "بدین کارها فرمند آمدی"
  },
  {
    "poem_id": 52172,
    "vorder": 233,
    "position": 0,
    "text": "سپه تاختن دانی و کیمیا"
  },
  {
    "poem_id": 52172,
    "vorder": 234,
    "position": 1,
    "text": "سپهبد به دستت پدر گر نیا"
  },
  {
    "poem_id": 52172,
    "vorder": 235,
    "position": 0,
    "text": "ز ما این نه گفتار آرایشست"
  },
  {
    "poem_id": 52172,
    "vorder": 236,
    "position": 1,
    "text": "مرا بر تو بر، جای بخشایشست"
  },
  {
    "poem_id": 52172,
    "vorder": 237,
    "position": 0,
    "text": "بدین روز با خوارمایه سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 238,
    "position": 1,
    "text": "برابر یکی ساختی رزمگاه"
  },
  {
    "poem_id": 52172,
    "vorder": 239,
    "position": 0,
    "text": "نیابی جز این نیز پیغام من"
  },
  {
    "poem_id": 52172,
    "vorder": 240,
    "position": 1,
    "text": "اگر سربپیچانی از کام من"
  },
  {
    "poem_id": 52172,
    "vorder": 241,
    "position": 0,
    "text": "فرستاده گفت و سپهبد شنید"
  },
  {
    "poem_id": 52172,
    "vorder": 242,
    "position": 1,
    "text": "به پاسخ سخن تیره آمد پدید"
  },
  {
    "poem_id": 52172,
    "vorder": 243,
    "position": 0,
    "text": "چنین داد پاسخ که ای بدنشان"
  },
  {
    "poem_id": 52172,
    "vorder": 244,
    "position": 1,
    "text": "میان بزرگان و گردنکشان"
  },
  {
    "poem_id": 52172,
    "vorder": 245,
    "position": 0,
    "text": "جهاندار بی‌سود و بسیارگوی"
  },
  {
    "poem_id": 52172,
    "vorder": 246,
    "position": 1,
    "text": "نماندش نزد کسی آبروی"
  },
  {
    "poem_id": 52172,
    "vorder": 247,
    "position": 0,
    "text": "به پیشین سخن وآنچ گفتی ز پس"
  },
  {
    "poem_id": 52172,
    "vorder": 248,
    "position": 1,
    "text": "به گفتار دیدم تو را دسترس"
  },
  {
    "poem_id": 52172,
    "vorder": 249,
    "position": 0,
    "text": "کسی را که آید زمانه به سر"
  },
  {
    "poem_id": 52172,
    "vorder": 250,
    "position": 1,
    "text": "ز مردم به گفتار جوید هنر"
  },
  {
    "poem_id": 52172,
    "vorder": 251,
    "position": 0,
    "text": "شنیدم سخنهای ناسودمند"
  },
  {
    "poem_id": 52172,
    "vorder": 252,
    "position": 1,
    "text": "دلی گشته ترسان ز بیم گزند"
  },
  {
    "poem_id": 52172,
    "vorder": 253,
    "position": 0,
    "text": "یکی آنک گفتی کشم شاه را"
  },
  {
    "poem_id": 52172,
    "vorder": 254,
    "position": 1,
    "text": "سپارم به تو لشکر و گاه را"
  },
  {
    "poem_id": 52172,
    "vorder": 255,
    "position": 0,
    "text": "یکی داستان زد برین مرد مه"
  },
  {
    "poem_id": 52172,
    "vorder": 256,
    "position": 1,
    "text": "که درویش را چون برانی ز ده"
  },
  {
    "poem_id": 52172,
    "vorder": 257,
    "position": 0,
    "text": "نگوید که جز مهتر ده بدم"
  },
  {
    "poem_id": 52172,
    "vorder": 258,
    "position": 1,
    "text": "همه بنده بودند و من مه بدم"
  },
  {
    "poem_id": 52172,
    "vorder": 259,
    "position": 0,
    "text": "بدین کار ما برنیاید دو روز"
  },
  {
    "poem_id": 52172,
    "vorder": 260,
    "position": 1,
    "text": "که بفروزد از چرخ گیتی فروز"
  },
  {
    "poem_id": 52172,
    "vorder": 261,
    "position": 0,
    "text": "که بر نیزه‌ها بر سرت خون فشان"
  },
  {
    "poem_id": 52172,
    "vorder": 262,
    "position": 1,
    "text": "فرستم بر شاه گردنکشان"
  },
  {
    "poem_id": 52172,
    "vorder": 263,
    "position": 0,
    "text": "دگر آنک گفتی تو از دخترت"
  },
  {
    "poem_id": 52172,
    "vorder": 264,
    "position": 1,
    "text": "هم از گنج وز لشکر و کشورت"
  },
  {
    "poem_id": 52172,
    "vorder": 265,
    "position": 0,
    "text": "مرا از تو آنگاه بودی سپاس"
  },
  {
    "poem_id": 52172,
    "vorder": 266,
    "position": 1,
    "text": "تو را خواندمی شاه و نیکی شناس"
  },
  {
    "poem_id": 52172,
    "vorder": 267,
    "position": 0,
    "text": "که دختر به من داده‌ای آن زمان"
  },
  {
    "poem_id": 52172,
    "vorder": 268,
    "position": 1,
    "text": "که از تخت ایران نبردی گمان"
  },
  {
    "poem_id": 52172,
    "vorder": 269,
    "position": 0,
    "text": "فرستاده‌ای گنج آراسته"
  },
  {
    "poem_id": 52172,
    "vorder": 270,
    "position": 1,
    "text": "به نزدیک من دختر و خواسته"
  },
  {
    "poem_id": 52172,
    "vorder": 271,
    "position": 0,
    "text": "چو من دوست بودی به ایران تو را"
  },
  {
    "poem_id": 52172,
    "vorder": 272,
    "position": 1,
    "text": "نه رزم آمدی با دلیران تو را"
  },
  {
    "poem_id": 52172,
    "vorder": 273,
    "position": 0,
    "text": "کنون نیزهٔ من به گوشَت رسید"
  },
  {
    "poem_id": 52172,
    "vorder": 274,
    "position": 1,
    "text": "سرت را به خنجر بخواهم برید"
  },
  {
    "poem_id": 52172,
    "vorder": 275,
    "position": 0,
    "text": "چو رفتی سر و تاج و گنجت مراست"
  },
  {
    "poem_id": 52172,
    "vorder": 276,
    "position": 1,
    "text": "همان دختر و برده رنجت مراست"
  },
  {
    "poem_id": 52172,
    "vorder": 277,
    "position": 0,
    "text": "دگر آنک گفتی فزون از شمار"
  },
  {
    "poem_id": 52172,
    "vorder": 278,
    "position": 1,
    "text": "مرا تاج و تختست و پیل و سوار"
  },
  {
    "poem_id": 52172,
    "vorder": 279,
    "position": 0,
    "text": "برین داستان زد یکی نامدار"
  },
  {
    "poem_id": 52172,
    "vorder": 280,
    "position": 1,
    "text": "که پیچان شد اندر صف کارزار"
  },
  {
    "poem_id": 52172,
    "vorder": 281,
    "position": 0,
    "text": "که چندان کند سگ به تیزی شتاب"
  },
  {
    "poem_id": 52172,
    "vorder": 282,
    "position": 1,
    "text": "که از کام او دورتر باشد آب"
  },
  {
    "poem_id": 52172,
    "vorder": 283,
    "position": 0,
    "text": "ببردند دیوان دلت را ز راه"
  },
  {
    "poem_id": 52172,
    "vorder": 284,
    "position": 1,
    "text": "که نزدیک شاه آمدی رزمخواه"
  },
  {
    "poem_id": 52172,
    "vorder": 285,
    "position": 0,
    "text": "بپیچی ز باد افره ایزدی"
  },
  {
    "poem_id": 52172,
    "vorder": 286,
    "position": 1,
    "text": "هم از کرده و کارهای بدی"
  },
  {
    "poem_id": 52172,
    "vorder": 287,
    "position": 0,
    "text": "دگر آنک گفتی مرا کهترند"
  },
  {
    "poem_id": 52172,
    "vorder": 288,
    "position": 1,
    "text": "بزرگان که با طوق و با افسرند"
  },
  {
    "poem_id": 52172,
    "vorder": 289,
    "position": 0,
    "text": "همه شارستانهای گیتی مراست"
  },
  {
    "poem_id": 52172,
    "vorder": 290,
    "position": 1,
    "text": "زمانه برین بر که گفتم گواست"
  },
  {
    "poem_id": 52172,
    "vorder": 291,
    "position": 0,
    "text": "سوی شارستانها گشادست راه"
  },
  {
    "poem_id": 52172,
    "vorder": 292,
    "position": 1,
    "text": "چه کهتر بدان مرز پوید چه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 293,
    "position": 0,
    "text": "اگر تو بکوبی در شارستان"
  },
  {
    "poem_id": 52172,
    "vorder": 294,
    "position": 1,
    "text": "به شاهی نیابی مگر خارستان"
  },
  {
    "poem_id": 52172,
    "vorder": 295,
    "position": 0,
    "text": "دگر آنک بخشیدنی خواستی"
  },
  {
    "poem_id": 52172,
    "vorder": 296,
    "position": 1,
    "text": "ز مردی مرا دوری آراستی"
  },
  {
    "poem_id": 52172,
    "vorder": 297,
    "position": 0,
    "text": "چو بینی سنانم ببخشاییم"
  },
  {
    "poem_id": 52172,
    "vorder": 298,
    "position": 1,
    "text": "همان زیردستی نفرماییم"
  },
  {
    "poem_id": 52172,
    "vorder": 299,
    "position": 0,
    "text": "سپاه تو را کام و راه تو را"
  },
  {
    "poem_id": 52172,
    "vorder": 300,
    "position": 1,
    "text": "همان زنده پیلان و گاه تو را"
  },
  {
    "poem_id": 52172,
    "vorder": 301,
    "position": 0,
    "text": "چو صف برکشیدم ندارم به چیز"
  },
  {
    "poem_id": 52172,
    "vorder": 302,
    "position": 1,
    "text": "نیندیشم از لشکرت یک پشیز"
  },
  {
    "poem_id": 52172,
    "vorder": 303,
    "position": 0,
    "text": "اگر شهریاری تو چندین دروغ"
  },
  {
    "poem_id": 52172,
    "vorder": 304,
    "position": 1,
    "text": "بگویی نگیری به گیتی فروغ"
  },
  {
    "poem_id": 52172,
    "vorder": 305,
    "position": 0,
    "text": "زمان داده‌ام شاه را تا سه روز"
  },
  {
    "poem_id": 52172,
    "vorder": 306,
    "position": 1,
    "text": "که پیدا شود فر گیتی فروز"
  },
  {
    "poem_id": 52172,
    "vorder": 307,
    "position": 0,
    "text": "بریده سرت را بدان بارگاه"
  },
  {
    "poem_id": 52172,
    "vorder": 308,
    "position": 1,
    "text": "ببینند بر نیزه در پیش شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 309,
    "position": 0,
    "text": "فرستاده آمد دو رخ چون زریر"
  },
  {
    "poem_id": 52172,
    "vorder": 310,
    "position": 1,
    "text": "شده بارور بخت برناش پیر"
  },
  {
    "poem_id": 52172,
    "vorder": 311,
    "position": 0,
    "text": "همی‌داد پیغام با ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 312,
    "position": 1,
    "text": "چو بشنید شد روی مهتر سیاه"
  },
  {
    "poem_id": 52172,
    "vorder": 313,
    "position": 0,
    "text": "بدو گفت فغفور کین لابه چیست"
  },
  {
    "poem_id": 52172,
    "vorder": 314,
    "position": 1,
    "text": "بران مایه لشکر بباید گریست"
  },
  {
    "poem_id": 52172,
    "vorder": 315,
    "position": 0,
    "text": "بیامد به دهلیز پرده سرای"
  },
  {
    "poem_id": 52172,
    "vorder": 316,
    "position": 1,
    "text": "بفرمود تا سنج و هندی درای"
  },
  {
    "poem_id": 52172,
    "vorder": 317,
    "position": 0,
    "text": "بیارند با زنده پیلان و کوس"
  },
  {
    "poem_id": 52172,
    "vorder": 318,
    "position": 1,
    "text": "کنند آسمان را به رنگ آبنوس"
  },
  {
    "poem_id": 52172,
    "vorder": 319,
    "position": 0,
    "text": "چو این نامور جنگ را کرد ساز"
  },
  {
    "poem_id": 52172,
    "vorder": 320,
    "position": 1,
    "text": "پر اندیشه شد شاه گردن فراز"
  },
  {
    "poem_id": 52172,
    "vorder": 321,
    "position": 0,
    "text": "به فرزند گفت ای گزین سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 322,
    "position": 1,
    "text": "مکن جنگ تا بامداد پگاه"
  },
  {
    "poem_id": 52172,
    "vorder": 323,
    "position": 0,
    "text": "شدند از دو رویه سپه باز جای"
  },
  {
    "poem_id": 52172,
    "vorder": 324,
    "position": 1,
    "text": "طلایه بیامد ز پرده سرای"
  },
  {
    "poem_id": 52172,
    "vorder": 325,
    "position": 0,
    "text": "بر افراختند آتش از هر دو روی"
  },
  {
    "poem_id": 52172,
    "vorder": 326,
    "position": 1,
    "text": "جهان شد ز لشکر پر از گفت و گوی"
  },
  {
    "poem_id": 52172,
    "vorder": 327,
    "position": 0,
    "text": "چو بهرام در خیمه تنها بماند"
  },
  {
    "poem_id": 52172,
    "vorder": 328,
    "position": 1,
    "text": "فرستاد و ایرانیان را بخواند"
  },
  {
    "poem_id": 52172,
    "vorder": 329,
    "position": 0,
    "text": "همی رای زد جنگ را با سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 330,
    "position": 1,
    "text": "برینگونه تا گشت گیتی سیاه"
  },
  {
    "poem_id": 52172,
    "vorder": 331,
    "position": 0,
    "text": "بخفتند ترکان و پر مایگان"
  },
  {
    "poem_id": 52172,
    "vorder": 332,
    "position": 1,
    "text": "جهان شد جهانجویی را رایگان"
  },
  {
    "poem_id": 52172,
    "vorder": 333,
    "position": 0,
    "text": "چو بهرام جنگی به خیمه بخفت"
  },
  {
    "poem_id": 52172,
    "vorder": 334,
    "position": 1,
    "text": "همه شب دلش بود با جنگ جفت"
  },
  {
    "poem_id": 52172,
    "vorder": 335,
    "position": 0,
    "text": "چنان دید در خواب بهرام شیر"
  },
  {
    "poem_id": 52172,
    "vorder": 336,
    "position": 1,
    "text": "که ترکان شدندی به جنگ‌ش دلیر"
  },
  {
    "poem_id": 52172,
    "vorder": 337,
    "position": 0,
    "text": "سپاهش سراسر شکسته شدی"
  },
  {
    "poem_id": 52172,
    "vorder": 338,
    "position": 1,
    "text": "برو راه بی‌راه و بسته شدی"
  },
  {
    "poem_id": 52172,
    "vorder": 339,
    "position": 0,
    "text": "همی‌خواسته از یلان زینهار"
  },
  {
    "poem_id": 52172,
    "vorder": 340,
    "position": 1,
    "text": "پیاده بماندی نبودیش یار"
  },
  {
    "poem_id": 52172,
    "vorder": 341,
    "position": 0,
    "text": "غمی شد چو از خواب بیدار شد"
  },
  {
    "poem_id": 52172,
    "vorder": 342,
    "position": 1,
    "text": "سر پر هنر پر ز تیمار شد"
  },
  {
    "poem_id": 52172,
    "vorder": 343,
    "position": 0,
    "text": "شب تیره با درد و غم بود جفت"
  },
  {
    "poem_id": 52172,
    "vorder": 344,
    "position": 1,
    "text": "بپوشید آن خواب و با کس نگفت"
  },
  {
    "poem_id": 52172,
    "vorder": 345,
    "position": 0,
    "text": "همانگاه خراد برزین ز راه"
  },
  {
    "poem_id": 52172,
    "vorder": 346,
    "position": 1,
    "text": "بیامد که بگریخت از ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 347,
    "position": 0,
    "text": "همی‌ گفت ازان چاره اندر گریز"
  },
  {
    "poem_id": 52172,
    "vorder": 348,
    "position": 1,
    "text": "ازان لشکر گشن و آن رستخیز"
  },
  {
    "poem_id": 52172,
    "vorder": 349,
    "position": 0,
    "text": "که کس درجهان زان فزونتر سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 350,
    "position": 1,
    "text": "نبیند که هستند با ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 351,
    "position": 0,
    "text": "به بهرام گفت ازچه سخت ایمنی"
  },
  {
    "poem_id": 52172,
    "vorder": 352,
    "position": 1,
    "text": "نگه کن بدین دام آهرمنی"
  },
  {
    "poem_id": 52172,
    "vorder": 353,
    "position": 0,
    "text": "مده جان ایرانیان را به باد"
  },
  {
    "poem_id": 52172,
    "vorder": 354,
    "position": 1,
    "text": "نگه کن بدین نامداران به داد"
  },
  {
    "poem_id": 52172,
    "vorder": 355,
    "position": 0,
    "text": "ز مردی ببخشای برجان خویش"
  },
  {
    "poem_id": 52172,
    "vorder": 356,
    "position": 1,
    "text": "که هرگز نیامد چنین کار پیش"
  },
  {
    "poem_id": 52172,
    "vorder": 357,
    "position": 0,
    "text": "بدو گفت بهرام کز شهر تو"
  },
  {
    "poem_id": 52172,
    "vorder": 358,
    "position": 1,
    "text": "ز گیتی نیامد جزین بهر تو"
  },
  {
    "poem_id": 52172,
    "vorder": 359,
    "position": 0,
    "text": "که ماهی فروشند یکسر همه"
  },
  {
    "poem_id": 52172,
    "vorder": 360,
    "position": 1,
    "text": "به تموز تا روزگار دمه"
  },
  {
    "poem_id": 52172,
    "vorder": 361,
    "position": 0,
    "text": "تو را پیشه دامست بر آبگیر"
  },
  {
    "poem_id": 52172,
    "vorder": 362,
    "position": 1,
    "text": "نه مردی به گوپال و شمشیر و تیر"
  },
  {
    "poem_id": 52172,
    "vorder": 363,
    "position": 0,
    "text": "چو خور برزند سر ز کوه سیاه"
  },
  {
    "poem_id": 52172,
    "vorder": 364,
    "position": 1,
    "text": "نمایم تو را جنگ با ساوه شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 365,
    "position": 0,
    "text": "چو بر زد سر از چشمه شیر شید"
  },
  {
    "poem_id": 52172,
    "vorder": 366,
    "position": 1,
    "text": "جهان گشت چون روی رومی سپید"
  },
  {
    "poem_id": 52172,
    "vorder": 367,
    "position": 0,
    "text": "بزد نای رویین و برشد خروش"
  },
  {
    "poem_id": 52172,
    "vorder": 368,
    "position": 1,
    "text": "زمین آمد از نعل اسبان به جوش"
  },
  {
    "poem_id": 52172,
    "vorder": 369,
    "position": 0,
    "text": "سپه را بیاراست و خود برنشست"
  },
  {
    "poem_id": 52172,
    "vorder": 370,
    "position": 1,
    "text": "یکی گُرز پرخاش دیده به دست"
  },
  {
    "poem_id": 52172,
    "vorder": 371,
    "position": 0,
    "text": "شمردند بر میمنه سه هزار"
  },
  {
    "poem_id": 52172,
    "vorder": 372,
    "position": 1,
    "text": "زره دار و کارآزموده سوار"
  },
  {
    "poem_id": 52172,
    "vorder": 373,
    "position": 0,
    "text": "فرستاده بر میسره همچنین"
  },
  {
    "poem_id": 52172,
    "vorder": 374,
    "position": 1,
    "text": "سواران جنگی و مردان کین"
  },
  {
    "poem_id": 52172,
    "vorder": 375,
    "position": 0,
    "text": "به یک دست بر بود آذر گشسب"
  },
  {
    "poem_id": 52172,
    "vorder": 376,
    "position": 1,
    "text": "پرستنده فرخ ایزد گشسب"
  },
  {
    "poem_id": 52172,
    "vorder": 377,
    "position": 0,
    "text": "به دست چپش بود پیدا گشسب"
  },
  {
    "poem_id": 52172,
    "vorder": 378,
    "position": 1,
    "text": "که بگذاشتی آب دریا براسب"
  },
  {
    "poem_id": 52172,
    "vorder": 379,
    "position": 0,
    "text": "پس پشت ایشان یلان سینه بود"
  },
  {
    "poem_id": 52172,
    "vorder": 380,
    "position": 1,
    "text": "که با جوشن و گُرز دیرینه بود"
  },
  {
    "poem_id": 52172,
    "vorder": 381,
    "position": 0,
    "text": "به پیش اندرون بود همدان گشسب"
  },
  {
    "poem_id": 52172,
    "vorder": 382,
    "position": 1,
    "text": "که در نی زدی آتش از سم اسب"
  },
  {
    "poem_id": 52172,
    "vorder": 383,
    "position": 0,
    "text": "ابا هر یکی سه هزار از یلان"
  },
  {
    "poem_id": 52172,
    "vorder": 384,
    "position": 1,
    "text": "سواران جنگی و جنگ آوران"
  },
  {
    "poem_id": 52172,
    "vorder": 385,
    "position": 0,
    "text": "خروشی برآمد ز پیش سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 386,
    "position": 1,
    "text": "که ای گُرزداران زرین کلاه"
  },
  {
    "poem_id": 52172,
    "vorder": 387,
    "position": 0,
    "text": "ز لشکر کسی کو گریزد ز جنگ"
  },
  {
    "poem_id": 52172,
    "vorder": 388,
    "position": 1,
    "text": "اگر شیر پیش آیدش گر پلنگ"
  },
  {
    "poem_id": 52172,
    "vorder": 389,
    "position": 0,
    "text": "به یزدان که از تن ببرم سرش"
  },
  {
    "poem_id": 52172,
    "vorder": 390,
    "position": 1,
    "text": "به آتش بسوزم تن و پیکرش"
  },
  {
    "poem_id": 52172,
    "vorder": 391,
    "position": 0,
    "text": "ز دو سوی لشکرش دو راه بود"
  },
  {
    "poem_id": 52172,
    "vorder": 392,
    "position": 1,
    "text": "که بگریختن راه کوتاه بود"
  },
  {
    "poem_id": 52172,
    "vorder": 393,
    "position": 0,
    "text": "برآورد ده رش به گل هر دو راه"
  },
  {
    "poem_id": 52172,
    "vorder": 394,
    "position": 1,
    "text": "همی‌بود خود در میان سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 395,
    "position": 0,
    "text": "دبیر بزرگ جهاندار شاه"
  },
  {
    "poem_id": 52172,
    "vorder": 396,
    "position": 1,
    "text": "بیامد بر پهلوان سپاه"
  },
  {
    "poem_id": 52172,
    "vorder": 397,
    "position": 0,
    "text": "بدو گفت کاین را خود اندازه نیست"
  },
  {
    "poem_id": 52172,
    "vorder": 398,
    "position": 1,
    "text": "گزاف زبان تو را تازه نیست"
  },
  {
    "poem_id": 52172,
    "vorder": 399,
    "position": 0,
    "text": "ز لشکر نگه کن برین رزمگاه"
  },
  {
    "poem_id": 52172,
    "vorder": 400,
    "position": 1,
    "text": "چو موی سپیدیم و گاو سیاه"
  },
  {
    "poem_id": 52172,
    "vorder": 401,
    "position": 0,
    "text": "بدین جنگ تنگی به ایران شود"
  },
  {
    "poem_id": 52172,
    "vorder": 402,
    "position": 1,
    "text": "برو بوم ما پاک ویران شود"
  },
  {
    "poem_id": 52172,
    "vorder": 403,
    "position": 0,
    "text": "نه خاکست پیدا نه دریا نه کوه"
  },
  {
    "poem_id": 52172,
    "vorder": 404,
    "position": 1,
    "text": "ز بس تیغ داران توران گروه"
  },
  {
    "poem_id": 52172,
    "vorder": 405,
    "position": 0,
    "text": "یکی برخروشید بهرام سخت"
  },
  {
    "poem_id": 52172,
    "vorder": 406,
    "position": 1,
    "text": "ورا گفت کای بد دل شوربخت"
  },
  {
    "poem_id": 52172,
    "vorder": 407,
    "position": 0,
    "text": "تو را از دواتست و قرطاس بر"
  },
  {
    "poem_id": 52172,
    "vorder": 408,
    "position": 1,
    "text": "ز لشکر که گفتت که مردم شمر"
  },
  {
    "poem_id": 52172,
    "vorder": 409,
    "position": 0,
    "text": "بیامد به خراد برزین بگفت"
  },
  {
    "poem_id": 52172,
    "vorder": 410,
    "position": 1,
    "text": "که بهرام را نیست جز دیو جفت"
  },
  {
    "poem_id": 52172,
    "vorder": 411,
    "position": 0,
    "text": "دبیران بجستند راه گریز"
  },
  {
    "poem_id": 52172,
    "vorder": 412,
    "position": 1,
    "text": "بدان تا نبیند کسی رستخیز"
  },
  {
    "poem_id": 52172,
    "vorder": 413,
    "position": 0,
    "text": "ز بیم شهنشاه و بهرام شیر"
  },
  {
    "poem_id": 52172,
    "vorder": 414,
    "position": 1,
    "text": "تلی برگزیدند هر دو دبیر"
  },
  {
    "poem_id": 52172,
    "vorder": 415,
    "position": 0,
    "text": "یکی تند بالا بد از رزم دور"
  },
  {
    "poem_id": 52172,
    "vorder": 416,
    "position": 1,
    "text": "به یک سو ز راه سواران تور"
  },
  {
    "poem_id": 52172,
    "vorder": 417,
    "position": 0,
    "text": "برفتند هر دو بران برز راه"
  },
  {
    "poem_id": 52172,
    "vorder": 418,
    "position": 1,
    "text": "که شاییست کردن به لشکر نگاه"
  },
  {
    "poem_id": 52172,
    "vorder": 419,
    "position": 0,
    "text": "نهادند بر ترگ بهرام چشم"
  },
  {
    "poem_id": 52172,
    "vorder": 420,
    "position": 1,
    "text": "که تا چون کند جنگ هنگام خشم"
  },
  {
    "poem_id": 52172,
    "vorder": 421,
    "position": 0,
    "text": "چو بهرام جنگی سپه راست کرد"
  },
  {
    "poem_id": 52172,
    "vorder": 422,
    "position": 1,
    "text": "خروشان بیامد ز جای نبرد"
  },
  {
    "poem_id": 52172,
    "vorder": 423,
    "position": 0,
    "text": "بغلتید در پیش یزدان به خاک"
  },
  {
    "poem_id": 52172,
    "vorder": 424,
    "position": 1,
    "text": "همی‌ گفت کای داور داد و پاک"
  },
  {
    "poem_id": 52172,
    "vorder": 425,
    "position": 0,
    "text": "گرین جنگ بیداد بینی همی"
  },
  {
    "poem_id": 52172,
    "vorder": 426,
    "position": 1,
    "text": "ز من ساوه را برگزینی همی"
  },
  {
    "poem_id": 52172,
    "vorder": 427,
    "position": 0,
    "text": "دلم را به رزم اندر آرام ده"
  },
  {
    "poem_id": 52172,
    "vorder": 428,
    "position": 1,
    "text": "به ایرانیان بر، ورا کام ده"
  },
  {
    "poem_id": 52172,
    "vorder": 429,
    "position": 0,
    "text": "اگر من ز بهر تو کوشم همی"
  },
  {
    "poem_id": 52172,
    "vorder": 430,
    "position": 1,
    "text": "به رزم اندرون سر فروشم همی"
  },
  {
    "poem_id": 52172,
    "vorder": 431,
    "position": 0,
    "text": "مرا و سپاه مرا شاد کن"
  },
  {
    "poem_id": 52172,
    "vorder": 432,
    "position": 1,
    "text": "وزین جنگ ما گیتی آباد کن"
  },
  {
    "poem_id": 52172,
    "vorder": 433,
    "position": 0,
    "text": "خروشان ازان جایگه برنشست"
  },
  {
    "poem_id": 52172,
    "vorder": 434,
    "position": 1,
    "text": "یکی گُرزهٔ گاو پیکر به دست"
  }
]