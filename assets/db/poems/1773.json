[
  {
    "poem_id": 1773,
    "vorder": 1,
    "position": 0,
    "text": "ز پیش سواران چو ره برگرفت"
  },
  {
    "poem_id": 1773,
    "vorder": 2,
    "position": 1,
    "text": "سوی خان بی‌بر به راهام تفت"
  },
  {
    "poem_id": 1773,
    "vorder": 3,
    "position": 0,
    "text": "بزد در بگفتا که بی‌شهریار"
  },
  {
    "poem_id": 1773,
    "vorder": 4,
    "position": 1,
    "text": "بماندم چو او بازماند از شکار"
  },
  {
    "poem_id": 1773,
    "vorder": 5,
    "position": 0,
    "text": "شب آمد ندانم همی راه را"
  },
  {
    "poem_id": 1773,
    "vorder": 6,
    "position": 1,
    "text": "نیابم همی لشکر و شاه را"
  },
  {
    "poem_id": 1773,
    "vorder": 7,
    "position": 0,
    "text": "گر امشب بدین خانه یابم سپنج"
  },
  {
    "poem_id": 1773,
    "vorder": 8,
    "position": 1,
    "text": "نباشد کسی را ز من هیچ رنج"
  },
  {
    "poem_id": 1773,
    "vorder": 9,
    "position": 0,
    "text": "به پیش به راهام شد پیشکار"
  },
  {
    "poem_id": 1773,
    "vorder": 10,
    "position": 1,
    "text": "بگفت آنچ بشنید ازان نامدار"
  },
  {
    "poem_id": 1773,
    "vorder": 11,
    "position": 0,
    "text": "به راهام گفت ایچ ازین در مرنج"
  },
  {
    "poem_id": 1773,
    "vorder": 12,
    "position": 1,
    "text": "بگویش که ایدر نیابی سپنج"
  },
  {
    "poem_id": 1773,
    "vorder": 13,
    "position": 0,
    "text": "بیامد فرستاده با او بگفت"
  },
  {
    "poem_id": 1773,
    "vorder": 14,
    "position": 1,
    "text": "که ایدر ترا نیست جای نهفت"
  },
  {
    "poem_id": 1773,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت بهرام با او بگوی"
  },
  {
    "poem_id": 1773,
    "vorder": 16,
    "position": 1,
    "text": "کز ایدر گذشتن مرا نیست روی"
  },
  {
    "poem_id": 1773,
    "vorder": 17,
    "position": 0,
    "text": "همی از تو من خانه خواهم سپنج"
  },
  {
    "poem_id": 1773,
    "vorder": 18,
    "position": 1,
    "text": "نیارم به چیزت ازان پس به رنج"
  },
  {
    "poem_id": 1773,
    "vorder": 19,
    "position": 0,
    "text": "چو بشنید پویان بشد پیشکار"
  },
  {
    "poem_id": 1773,
    "vorder": 20,
    "position": 1,
    "text": "به نزد به راهام گفت این سوار"
  },
  {
    "poem_id": 1773,
    "vorder": 21,
    "position": 0,
    "text": "همی ز ایدر امشب نخواهد گذشت"
  },
  {
    "poem_id": 1773,
    "vorder": 22,
    "position": 1,
    "text": "سخن گفتن و رای بسیار گشت"
  },
  {
    "poem_id": 1773,
    "vorder": 23,
    "position": 0,
    "text": "به راهام گفتش که رو بی‌درنگ"
  },
  {
    "poem_id": 1773,
    "vorder": 24,
    "position": 1,
    "text": "بگویش که این جایگاهیست تنگ"
  },
  {
    "poem_id": 1773,
    "vorder": 25,
    "position": 0,
    "text": "جهودیست درویش و شب گرسنه"
  },
  {
    "poem_id": 1773,
    "vorder": 26,
    "position": 1,
    "text": "بخسپد همی بر زمین برهنه"
  },
  {
    "poem_id": 1773,
    "vorder": 27,
    "position": 0,
    "text": "بگفتند و بهرام گفت ار سپنج"
  },
  {
    "poem_id": 1773,
    "vorder": 28,
    "position": 1,
    "text": "نیابم بدین خانه آیدت رنج"
  },
  {
    "poem_id": 1773,
    "vorder": 29,
    "position": 0,
    "text": "بدین در بخسپم نجویم سرای"
  },
  {
    "poem_id": 1773,
    "vorder": 30,
    "position": 1,
    "text": "نخواهم به چیزی دگر کرد رای"
  },
  {
    "poem_id": 1773,
    "vorder": 31,
    "position": 0,
    "text": "به راهام گفت ای نبرده سوار"
  },
  {
    "poem_id": 1773,
    "vorder": 32,
    "position": 1,
    "text": "همی رنجه داری مرا خوارخوار"
  },
  {
    "poem_id": 1773,
    "vorder": 33,
    "position": 0,
    "text": "بخسپی و چیزت بدزدد کسی"
  },
  {
    "poem_id": 1773,
    "vorder": 34,
    "position": 1,
    "text": "ازان رنجه داری مرا تو بسی"
  },
  {
    "poem_id": 1773,
    "vorder": 35,
    "position": 0,
    "text": "به خانه درآی ار جهان تنگ شد"
  },
  {
    "poem_id": 1773,
    "vorder": 36,
    "position": 1,
    "text": "همه کار بی‌برگ و بی‌رنگ شد"
  },
  {
    "poem_id": 1773,
    "vorder": 37,
    "position": 0,
    "text": "به پیمان که چیزی نخواهی ز من"
  },
  {
    "poem_id": 1773,
    "vorder": 38,
    "position": 1,
    "text": "ندارم به مرگ آبچین و کفن"
  },
  {
    "poem_id": 1773,
    "vorder": 39,
    "position": 0,
    "text": "هم امشب ترا و نشست ترا"
  },
  {
    "poem_id": 1773,
    "vorder": 40,
    "position": 1,
    "text": "خورش باید و نیست چیزی مرا"
  },
  {
    "poem_id": 1773,
    "vorder": 41,
    "position": 0,
    "text": "گر این اسپ سرگین و آب افگند"
  },
  {
    "poem_id": 1773,
    "vorder": 42,
    "position": 1,
    "text": "وگر خشت این خانه را بشکند"
  },
  {
    "poem_id": 1773,
    "vorder": 43,
    "position": 0,
    "text": "به شبگیر سرگینش بیرون کنی"
  },
  {
    "poem_id": 1773,
    "vorder": 44,
    "position": 1,
    "text": "بروبی و خاکش به هامون کنی"
  },
  {
    "poem_id": 1773,
    "vorder": 45,
    "position": 0,
    "text": "همان خشت را نیز تاوان دهی"
  },
  {
    "poem_id": 1773,
    "vorder": 46,
    "position": 1,
    "text": "چو بیدار گردی ز خواب آن دهی"
  },
  {
    "poem_id": 1773,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت بهرام پیمان کنم"
  },
  {
    "poem_id": 1773,
    "vorder": 48,
    "position": 1,
    "text": "برین رنجها سر گروگان کنم"
  },
  {
    "poem_id": 1773,
    "vorder": 49,
    "position": 0,
    "text": "فرود آمد و اسپ را با لگام"
  },
  {
    "poem_id": 1773,
    "vorder": 50,
    "position": 1,
    "text": "ببست و برآهخت تیغ از نیام"
  },
  {
    "poem_id": 1773,
    "vorder": 51,
    "position": 0,
    "text": "نمدزین بگسترد و بالینش زین"
  },
  {
    "poem_id": 1773,
    "vorder": 52,
    "position": 1,
    "text": "بخفت و دو پایش کشان بر زمین"
  },
  {
    "poem_id": 1773,
    "vorder": 53,
    "position": 0,
    "text": "جهود آن در خانه از پس ببست"
  },
  {
    "poem_id": 1773,
    "vorder": 54,
    "position": 1,
    "text": "بیاورد خوان و به خوردن نشست"
  },
  {
    "poem_id": 1773,
    "vorder": 55,
    "position": 0,
    "text": "ازان پس به بهرام گفت ای سوار"
  },
  {
    "poem_id": 1773,
    "vorder": 56,
    "position": 1,
    "text": "چو این داستان بشنوی یاد دار"
  },
  {
    "poem_id": 1773,
    "vorder": 57,
    "position": 0,
    "text": "به گیتی هرانکس که دارد خورد"
  },
  {
    "poem_id": 1773,
    "vorder": 58,
    "position": 1,
    "text": "سوی مردم بی‌نوا ننگرد"
  },
  {
    "poem_id": 1773,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت بهرام کاین داستان"
  },
  {
    "poem_id": 1773,
    "vorder": 60,
    "position": 1,
    "text": "شنیدستم از گفتهٔ باستان"
  },
  {
    "poem_id": 1773,
    "vorder": 61,
    "position": 0,
    "text": "شنیدم به گفتار و دیدم کنون"
  },
  {
    "poem_id": 1773,
    "vorder": 62,
    "position": 1,
    "text": "که برخواندی از گفتهٔ رهنمون"
  },
  {
    "poem_id": 1773,
    "vorder": 63,
    "position": 0,
    "text": "می آورد چون خورده شد نان جهود"
  },
  {
    "poem_id": 1773,
    "vorder": 64,
    "position": 1,
    "text": "ازان می ورا شادمانی فزود"
  },
  {
    "poem_id": 1773,
    "vorder": 65,
    "position": 0,
    "text": "خروشید کای رنج‌دیده سوار"
  },
  {
    "poem_id": 1773,
    "vorder": 66,
    "position": 1,
    "text": "برین داستان کهن گوش‌دار"
  },
  {
    "poem_id": 1773,
    "vorder": 67,
    "position": 0,
    "text": "که هرکس که دارد دلش روشنست"
  },
  {
    "poem_id": 1773,
    "vorder": 68,
    "position": 1,
    "text": "درم پیش او چون یکی جوشنست"
  },
  {
    "poem_id": 1773,
    "vorder": 69,
    "position": 0,
    "text": "کسی کو ندارد بود خشک لب"
  },
  {
    "poem_id": 1773,
    "vorder": 70,
    "position": 1,
    "text": "چنانچون توی گرسنه نیم‌شب"
  },
  {
    "poem_id": 1773,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت بهرام کاین بس شگفت"
  },
  {
    "poem_id": 1773,
    "vorder": 72,
    "position": 1,
    "text": "به گیتی مرین یاد باید گرفت"
  },
  {
    "poem_id": 1773,
    "vorder": 73,
    "position": 0,
    "text": "که از جام یابی سرانجام نیک"
  },
  {
    "poem_id": 1773,
    "vorder": 74,
    "position": 1,
    "text": "خنک میگسار و می و جام نیک"
  },
  {
    "poem_id": 1773,
    "vorder": 75,
    "position": 0,
    "text": "چو از کوه خنجر برآورد هور"
  },
  {
    "poem_id": 1773,
    "vorder": 76,
    "position": 1,
    "text": "گریزان شد از خانه بهرام گور"
  },
  {
    "poem_id": 1773,
    "vorder": 77,
    "position": 0,
    "text": "بران چرمهٔ ناچران زین نهاد"
  },
  {
    "poem_id": 1773,
    "vorder": 78,
    "position": 1,
    "text": "چه زین از برش خشک بالین نهاد"
  },
  {
    "poem_id": 1773,
    "vorder": 79,
    "position": 0,
    "text": "بیامد به راهام گفت ای سوار"
  },
  {
    "poem_id": 1773,
    "vorder": 80,
    "position": 1,
    "text": "به گفتار خود بر کنون پای‌دار"
  },
  {
    "poem_id": 1773,
    "vorder": 81,
    "position": 0,
    "text": "تو گفتی که سرگین این بارگی"
  },
  {
    "poem_id": 1773,
    "vorder": 82,
    "position": 1,
    "text": "به جاروب روبم به یکبارگی"
  },
  {
    "poem_id": 1773,
    "vorder": 83,
    "position": 0,
    "text": "کنون آنچ گفتی بروب و ببر"
  },
  {
    "poem_id": 1773,
    "vorder": 84,
    "position": 1,
    "text": "به رنجم ز مهمان بیدادگر"
  },
  {
    "poem_id": 1773,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت بهرام شو پایکار"
  },
  {
    "poem_id": 1773,
    "vorder": 86,
    "position": 1,
    "text": "بیاور که سرگین کشد بر کنار"
  },
  {
    "poem_id": 1773,
    "vorder": 87,
    "position": 0,
    "text": "دهم زر که تا خاک بیرون برد"
  },
  {
    "poem_id": 1773,
    "vorder": 88,
    "position": 1,
    "text": "وزین خانهٔ تو به هامون برد"
  },
  {
    "poem_id": 1773,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت من کس ندارم که خاک"
  },
  {
    "poem_id": 1773,
    "vorder": 90,
    "position": 1,
    "text": "بروبد برد ریزد اندر مغاک"
  },
  {
    "poem_id": 1773,
    "vorder": 91,
    "position": 0,
    "text": "تو پیمان که کردی به کژی مبر"
  },
  {
    "poem_id": 1773,
    "vorder": 92,
    "position": 1,
    "text": "نباید که خوانمت بیدادگر"
  },
  {
    "poem_id": 1773,
    "vorder": 93,
    "position": 0,
    "text": "چو بشنید بهرام ازو این سخن"
  },
  {
    "poem_id": 1773,
    "vorder": 94,
    "position": 1,
    "text": "یکی تازه اندیشه افگند بن"
  },
  {
    "poem_id": 1773,
    "vorder": 95,
    "position": 0,
    "text": "یکی خوب دستار بودش حریر"
  },
  {
    "poem_id": 1773,
    "vorder": 96,
    "position": 1,
    "text": "به موزه درون پر ز مشک و عبیر"
  },
  {
    "poem_id": 1773,
    "vorder": 97,
    "position": 0,
    "text": "برون کرد و سرگین بدو کرد پاک"
  },
  {
    "poem_id": 1773,
    "vorder": 98,
    "position": 1,
    "text": "بینداخت با خاک اندر مغاک"
  },
  {
    "poem_id": 1773,
    "vorder": 99,
    "position": 0,
    "text": "به راهام را گفت کای پارسا"
  },
  {
    "poem_id": 1773,
    "vorder": 100,
    "position": 1,
    "text": "گر آزادیم بشنود پادشا"
  },
  {
    "poem_id": 1773,
    "vorder": 101,
    "position": 0,
    "text": "ترا از جهان بی‌نیازی دهد"
  },
  {
    "poem_id": 1773,
    "vorder": 102,
    "position": 1,
    "text": "بر مهتران سرفرازی دهد"
  }
]