[
  {
    "poem_id": 1671,
    "vorder": 1,
    "position": 0,
    "text": "بپرسید هرچیز و دریا بدید"
  },
  {
    "poem_id": 1671,
    "vorder": 2,
    "position": 1,
    "text": "وزان روی لشکر به مغرب کشید"
  },
  {
    "poem_id": 1671,
    "vorder": 3,
    "position": 0,
    "text": "یکی شارستان پیشش آمد بزرگ"
  },
  {
    "poem_id": 1671,
    "vorder": 4,
    "position": 1,
    "text": "بدو اندرون مردمانی سترگ"
  },
  {
    "poem_id": 1671,
    "vorder": 5,
    "position": 0,
    "text": "همه روی سرخ و همه موی زرد"
  },
  {
    "poem_id": 1671,
    "vorder": 6,
    "position": 1,
    "text": "همه در خور جنگ روز نبرد"
  },
  {
    "poem_id": 1671,
    "vorder": 7,
    "position": 0,
    "text": "به فرمان به پیش سکندر شدند"
  },
  {
    "poem_id": 1671,
    "vorder": 8,
    "position": 1,
    "text": "دو تا گشته و دست بر سر شدند"
  },
  {
    "poem_id": 1671,
    "vorder": 9,
    "position": 0,
    "text": "سکندر بپرسید از سرکشان"
  },
  {
    "poem_id": 1671,
    "vorder": 10,
    "position": 1,
    "text": "که ایدر چه دارد شگفتی نشان"
  },
  {
    "poem_id": 1671,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت با او یکی مرد پیر"
  },
  {
    "poem_id": 1671,
    "vorder": 12,
    "position": 1,
    "text": "که ای شاه نیک‌اختر و شهرگیر"
  },
  {
    "poem_id": 1671,
    "vorder": 13,
    "position": 0,
    "text": "یکی آبگیرست زان روی شهر"
  },
  {
    "poem_id": 1671,
    "vorder": 14,
    "position": 1,
    "text": "کزان آب کس را ندیدیم بهر"
  },
  {
    "poem_id": 1671,
    "vorder": 15,
    "position": 0,
    "text": "چو خورشید تابان بدانجا رسید"
  },
  {
    "poem_id": 1671,
    "vorder": 16,
    "position": 1,
    "text": "بران ژرف دریا شود ناپدید"
  },
  {
    "poem_id": 1671,
    "vorder": 17,
    "position": 0,
    "text": "پس چشمه‌در تیره گردد جهان"
  },
  {
    "poem_id": 1671,
    "vorder": 18,
    "position": 1,
    "text": "شود آشکارای گیتی نهان"
  },
  {
    "poem_id": 1671,
    "vorder": 19,
    "position": 0,
    "text": "وزان جای تاریک چندان سخن"
  },
  {
    "poem_id": 1671,
    "vorder": 20,
    "position": 1,
    "text": "شنیدم که هرگز نیاید به بن"
  },
  {
    "poem_id": 1671,
    "vorder": 21,
    "position": 0,
    "text": "خرد یافته مرد یزدان‌پرست"
  },
  {
    "poem_id": 1671,
    "vorder": 22,
    "position": 1,
    "text": "بدو در یکی چشمه گوید که هست"
  },
  {
    "poem_id": 1671,
    "vorder": 23,
    "position": 0,
    "text": "گشاده سخن مرد با رای و کام"
  },
  {
    "poem_id": 1671,
    "vorder": 24,
    "position": 1,
    "text": "همی آب حیوانش خواند به نام"
  },
  {
    "poem_id": 1671,
    "vorder": 25,
    "position": 0,
    "text": "چنین گفت روشن‌دل پر خرد"
  },
  {
    "poem_id": 1671,
    "vorder": 26,
    "position": 1,
    "text": "که هرک آب حیوان خورد کی مرد"
  },
  {
    "poem_id": 1671,
    "vorder": 27,
    "position": 0,
    "text": "ز فردوس دارد بران چشمه راه"
  },
  {
    "poem_id": 1671,
    "vorder": 28,
    "position": 1,
    "text": "بشوید برآن تن بریزد گناه"
  },
  {
    "poem_id": 1671,
    "vorder": 29,
    "position": 0,
    "text": "بپرسید پس شه که تاریک جای"
  },
  {
    "poem_id": 1671,
    "vorder": 30,
    "position": 1,
    "text": "بدو اندرون چون رود چارپای"
  },
  {
    "poem_id": 1671,
    "vorder": 31,
    "position": 0,
    "text": "چنین پاسخ آورد یزدان‌پرست"
  },
  {
    "poem_id": 1671,
    "vorder": 32,
    "position": 1,
    "text": "کزان راه بر کره باید نشست"
  },
  {
    "poem_id": 1671,
    "vorder": 33,
    "position": 0,
    "text": "به چوپان بفرمود کاسپ یله"
  },
  {
    "poem_id": 1671,
    "vorder": 34,
    "position": 1,
    "text": "سراسر به لشکرگه آرد گله"
  },
  {
    "poem_id": 1671,
    "vorder": 35,
    "position": 0,
    "text": "گزین کرد زو بارگی ده هزار"
  },
  {
    "poem_id": 1671,
    "vorder": 36,
    "position": 1,
    "text": "همه چار سال از در کارزار"
  }
]