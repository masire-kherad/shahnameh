[
  {
    "poem_id": 1544,
    "vorder": 1,
    "position": 0,
    "text": "چو بازآورید آن گرانمایه کین"
  },
  {
    "poem_id": 1544,
    "vorder": 2,
    "position": 1,
    "text": "بر اسپ زریری برافگند زین"
  },
  {
    "poem_id": 1544,
    "vorder": 3,
    "position": 0,
    "text": "خرامید تازان به آوردگاه"
  },
  {
    "poem_id": 1544,
    "vorder": 4,
    "position": 1,
    "text": "به سه بهره کرد آن کیانی سپاه"
  },
  {
    "poem_id": 1544,
    "vorder": 5,
    "position": 0,
    "text": "ازان سه یکی را به بستور داد"
  },
  {
    "poem_id": 1544,
    "vorder": 6,
    "position": 1,
    "text": "دگر آن سپهدار فرخ‌نژاد"
  },
  {
    "poem_id": 1544,
    "vorder": 7,
    "position": 0,
    "text": "دگر بهره را بر برادر سپرد"
  },
  {
    "poem_id": 1544,
    "vorder": 8,
    "position": 1,
    "text": "بزرگان ایران و مردان گرد"
  },
  {
    "poem_id": 1544,
    "vorder": 9,
    "position": 0,
    "text": "سیم بهره را سوی خود بازداشت"
  },
  {
    "poem_id": 1544,
    "vorder": 10,
    "position": 1,
    "text": "که چون ابر غرنده آواز داشت"
  },
  {
    "poem_id": 1544,
    "vorder": 11,
    "position": 0,
    "text": "چو بستور فرخنده و پاک تن"
  },
  {
    "poem_id": 1544,
    "vorder": 12,
    "position": 1,
    "text": "دگر فرش آورد شمشیر زن"
  },
  {
    "poem_id": 1544,
    "vorder": 13,
    "position": 0,
    "text": "بهم ایستادند از پیش اوی"
  },
  {
    "poem_id": 1544,
    "vorder": 14,
    "position": 1,
    "text": "که لشکر شکستن بدی کیش اوی"
  },
  {
    "poem_id": 1544,
    "vorder": 15,
    "position": 0,
    "text": "همیدون ببستند پیمان برین"
  },
  {
    "poem_id": 1544,
    "vorder": 16,
    "position": 1,
    "text": "که گر تیغ دشمن بدرد زمین"
  },
  {
    "poem_id": 1544,
    "vorder": 17,
    "position": 0,
    "text": "نگردیم یک تن ازین جنگ باز"
  },
  {
    "poem_id": 1544,
    "vorder": 18,
    "position": 1,
    "text": "نداریم زین بدکنان چنگ باز"
  },
  {
    "poem_id": 1544,
    "vorder": 19,
    "position": 0,
    "text": "بر اسپان بکردند تنگ استوار"
  },
  {
    "poem_id": 1544,
    "vorder": 20,
    "position": 1,
    "text": "برفتند یکدل سوی کارزار"
  },
  {
    "poem_id": 1544,
    "vorder": 21,
    "position": 0,
    "text": "چو ایشان فگندند اسپ از میان"
  },
  {
    "poem_id": 1544,
    "vorder": 22,
    "position": 1,
    "text": "گوان و جوانان ایرانیان"
  },
  {
    "poem_id": 1544,
    "vorder": 23,
    "position": 0,
    "text": "همه یکسر از جای برخاستند"
  },
  {
    "poem_id": 1544,
    "vorder": 24,
    "position": 1,
    "text": "جهان را به جوشن بیاراستند"
  },
  {
    "poem_id": 1544,
    "vorder": 25,
    "position": 0,
    "text": "ازیشان بکشتند چندان سپاه"
  },
  {
    "poem_id": 1544,
    "vorder": 26,
    "position": 1,
    "text": "کزان تنگ شد جای آوردگاه"
  },
  {
    "poem_id": 1544,
    "vorder": 27,
    "position": 0,
    "text": "چنان خون همی رفت بر کوه و دشت"
  },
  {
    "poem_id": 1544,
    "vorder": 28,
    "position": 1,
    "text": "کزان آسیاها به خون بربگشت"
  },
  {
    "poem_id": 1544,
    "vorder": 29,
    "position": 0,
    "text": "چو ارجاسپ آن دید کامدش پیش"
  },
  {
    "poem_id": 1544,
    "vorder": 30,
    "position": 1,
    "text": "ابا نامداران و مردان خویش"
  },
  {
    "poem_id": 1544,
    "vorder": 31,
    "position": 0,
    "text": "گو گردکش نیزه اندر نهاد"
  },
  {
    "poem_id": 1544,
    "vorder": 32,
    "position": 1,
    "text": "بران گردگیران یبغو نژاد"
  },
  {
    "poem_id": 1544,
    "vorder": 33,
    "position": 0,
    "text": "همی دوختشان سینه‌ها باز پشت"
  },
  {
    "poem_id": 1544,
    "vorder": 34,
    "position": 1,
    "text": "چنان تا همه سرکشان را بکشت"
  },
  {
    "poem_id": 1544,
    "vorder": 35,
    "position": 0,
    "text": "چو دانست خاقان که ماندند بس"
  },
  {
    "poem_id": 1544,
    "vorder": 36,
    "position": 1,
    "text": "نیارد شدن پیش او هیچ‌کس"
  },
  {
    "poem_id": 1544,
    "vorder": 37,
    "position": 0,
    "text": "سپه جنب جنبان شد و کار گشت"
  },
  {
    "poem_id": 1544,
    "vorder": 38,
    "position": 1,
    "text": "همی بود تا روز اندر گذشت"
  },
  {
    "poem_id": 1544,
    "vorder": 39,
    "position": 0,
    "text": "همانگاه اندر گریغ اوفتاد"
  },
  {
    "poem_id": 1544,
    "vorder": 40,
    "position": 1,
    "text": "بشد رویش اندر بیابان نهاد"
  },
  {
    "poem_id": 1544,
    "vorder": 41,
    "position": 0,
    "text": "پس اندر نهادند ایرانیان"
  },
  {
    "poem_id": 1544,
    "vorder": 42,
    "position": 1,
    "text": "بدان بی‌مره لشکر چینیان"
  },
  {
    "poem_id": 1544,
    "vorder": 43,
    "position": 0,
    "text": "بکشتند زیشان به هر سو بسی"
  },
  {
    "poem_id": 1544,
    "vorder": 44,
    "position": 1,
    "text": "نبخشودشان ای شگفتی کسی"
  }
]