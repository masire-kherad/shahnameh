[
  {
    "poem_id": 1675,
    "vorder": 1,
    "position": 0,
    "text": "سوی باختر شد چو خاور بدید"
  },
  {
    "poem_id": 1675,
    "vorder": 2,
    "position": 1,
    "text": "ز گیتی همی رای رفتن گزید"
  },
  {
    "poem_id": 1675,
    "vorder": 3,
    "position": 0,
    "text": "بره‌بر یکی شارستان دید پاک"
  },
  {
    "poem_id": 1675,
    "vorder": 4,
    "position": 1,
    "text": "که نگذشت گویی بروباد و خاک"
  },
  {
    "poem_id": 1675,
    "vorder": 5,
    "position": 0,
    "text": "چو آواز کوس آمد از پشت پیل"
  },
  {
    "poem_id": 1675,
    "vorder": 6,
    "position": 1,
    "text": "پذیره شدندش بزرگان دو میل"
  },
  {
    "poem_id": 1675,
    "vorder": 7,
    "position": 0,
    "text": "جهانجوی چون دید بنواختشان"
  },
  {
    "poem_id": 1675,
    "vorder": 8,
    "position": 1,
    "text": "به خورشید گردن برافراختشان"
  },
  {
    "poem_id": 1675,
    "vorder": 9,
    "position": 0,
    "text": "بپرسید کایدر چه باشد شگفت"
  },
  {
    "poem_id": 1675,
    "vorder": 10,
    "position": 1,
    "text": "کزان برتر اندازه نتوان گرفت"
  },
  {
    "poem_id": 1675,
    "vorder": 11,
    "position": 0,
    "text": "زبان برگشادند بر شهریار"
  },
  {
    "poem_id": 1675,
    "vorder": 12,
    "position": 1,
    "text": "به نالیدن از گردش روزگار"
  },
  {
    "poem_id": 1675,
    "vorder": 13,
    "position": 0,
    "text": "که ما را یکی کار پیش است سخت"
  },
  {
    "poem_id": 1675,
    "vorder": 14,
    "position": 1,
    "text": "بگوییم با شاه پیروزبخت"
  },
  {
    "poem_id": 1675,
    "vorder": 15,
    "position": 0,
    "text": "بدین کوه سر تا به ابر اندرون"
  },
  {
    "poem_id": 1675,
    "vorder": 16,
    "position": 1,
    "text": "دل ما پر از رنج و دردست و خون"
  },
  {
    "poem_id": 1675,
    "vorder": 17,
    "position": 0,
    "text": "ز چیزی که ما را بدو تاب نیست"
  },
  {
    "poem_id": 1675,
    "vorder": 18,
    "position": 1,
    "text": "ز یاجوج و ماجوج مان خواب نیست"
  },
  {
    "poem_id": 1675,
    "vorder": 19,
    "position": 0,
    "text": "چو آیند بهری سوی شهر ما"
  },
  {
    "poem_id": 1675,
    "vorder": 20,
    "position": 1,
    "text": "غم و رنج باشد همه بهر ما"
  },
  {
    "poem_id": 1675,
    "vorder": 21,
    "position": 0,
    "text": "همه رویهاشان چو روی هیون"
  },
  {
    "poem_id": 1675,
    "vorder": 22,
    "position": 1,
    "text": "زبانها سیه دیده‌ها پر ز خون"
  },
  {
    "poem_id": 1675,
    "vorder": 23,
    "position": 0,
    "text": "سیه روی و دندانها چون گراز"
  },
  {
    "poem_id": 1675,
    "vorder": 24,
    "position": 1,
    "text": "که یارد شدن نزد ایشان فراز"
  },
  {
    "poem_id": 1675,
    "vorder": 25,
    "position": 0,
    "text": "همه تن پر از موی و موی همچو نیل"
  },
  {
    "poem_id": 1675,
    "vorder": 26,
    "position": 1,
    "text": "بر و سینه و گوشهاشان چو پیل"
  },
  {
    "poem_id": 1675,
    "vorder": 27,
    "position": 0,
    "text": "بخسپند یکی گوش بستر کنند"
  },
  {
    "poem_id": 1675,
    "vorder": 28,
    "position": 1,
    "text": "دگر بر تن خویش چادر کنند"
  },
  {
    "poem_id": 1675,
    "vorder": 29,
    "position": 0,
    "text": "ز هر ماده‌ای بچه زاید هزار"
  },
  {
    "poem_id": 1675,
    "vorder": 30,
    "position": 1,
    "text": "کم و بیش ایشان که داند شمار"
  },
  {
    "poem_id": 1675,
    "vorder": 31,
    "position": 0,
    "text": "به گرد آمدن چون ستوران شوند"
  },
  {
    "poem_id": 1675,
    "vorder": 32,
    "position": 1,
    "text": "تگ آرند و بر سان گوران شوند"
  },
  {
    "poem_id": 1675,
    "vorder": 33,
    "position": 0,
    "text": "بهاران کز ابر اندر آید خروش"
  },
  {
    "poem_id": 1675,
    "vorder": 34,
    "position": 1,
    "text": "همان سبز دریا برآید به جوش"
  },
  {
    "poem_id": 1675,
    "vorder": 35,
    "position": 0,
    "text": "چو تنین ازان موج بردارد ابر"
  },
  {
    "poem_id": 1675,
    "vorder": 36,
    "position": 1,
    "text": "هوا برخروشد بسان هژبر"
  },
  {
    "poem_id": 1675,
    "vorder": 37,
    "position": 0,
    "text": "فرود افگند ابر تنین چو کوه"
  },
  {
    "poem_id": 1675,
    "vorder": 38,
    "position": 1,
    "text": "بیایند زیشان گروها گروه"
  },
  {
    "poem_id": 1675,
    "vorder": 39,
    "position": 0,
    "text": "خورش آن بود سال تا سالشان"
  },
  {
    "poem_id": 1675,
    "vorder": 40,
    "position": 1,
    "text": "که آگنده گردد بر و یالشان"
  },
  {
    "poem_id": 1675,
    "vorder": 41,
    "position": 0,
    "text": "گیاشان بود زان سپس خوردنی"
  },
  {
    "poem_id": 1675,
    "vorder": 42,
    "position": 1,
    "text": "بیارند هر سو ز آوردنی"
  },
  {
    "poem_id": 1675,
    "vorder": 43,
    "position": 0,
    "text": "چو سرما بود سخت لاغر شوند"
  },
  {
    "poem_id": 1675,
    "vorder": 44,
    "position": 1,
    "text": "به آواز بر سان کفتر شوند"
  },
  {
    "poem_id": 1675,
    "vorder": 45,
    "position": 0,
    "text": "بهاران ببینی به کردار گرگ"
  },
  {
    "poem_id": 1675,
    "vorder": 46,
    "position": 1,
    "text": "بغرند بر سان پیل سترگ"
  },
  {
    "poem_id": 1675,
    "vorder": 47,
    "position": 0,
    "text": "اگر پادشا چاره‌ای سازدی"
  },
  {
    "poem_id": 1675,
    "vorder": 48,
    "position": 1,
    "text": "کزین غم دل ما بپردازدی"
  },
  {
    "poem_id": 1675,
    "vorder": 49,
    "position": 0,
    "text": "بسی آفرین یابد از هرکسی"
  },
  {
    "poem_id": 1675,
    "vorder": 50,
    "position": 1,
    "text": "ازان پس به گیتی بماند بسی"
  },
  {
    "poem_id": 1675,
    "vorder": 51,
    "position": 0,
    "text": "بزرگی کن و رنج ما را بساز"
  },
  {
    "poem_id": 1675,
    "vorder": 52,
    "position": 1,
    "text": "هم از پاک یزدان نه‌ای بی‌نیاز"
  },
  {
    "poem_id": 1675,
    "vorder": 53,
    "position": 0,
    "text": "سکندر بماند اندر ایشان شگفت"
  },
  {
    "poem_id": 1675,
    "vorder": 54,
    "position": 1,
    "text": "غمی گشت و اندیشه‌ها برگرفت"
  },
  {
    "poem_id": 1675,
    "vorder": 55,
    "position": 0,
    "text": "چنین داد پاسخ که از ماست گنج"
  },
  {
    "poem_id": 1675,
    "vorder": 56,
    "position": 1,
    "text": "ز شهر شما یارمندی و رنج"
  },
  {
    "poem_id": 1675,
    "vorder": 57,
    "position": 0,
    "text": "برآرم من این راه ایشان به رای"
  },
  {
    "poem_id": 1675,
    "vorder": 58,
    "position": 1,
    "text": "بنیروی نیکی دهش یک خدای"
  },
  {
    "poem_id": 1675,
    "vorder": 59,
    "position": 0,
    "text": "یکایک بگفتند کای شهریار"
  },
  {
    "poem_id": 1675,
    "vorder": 60,
    "position": 1,
    "text": "ز تو دور بادا بد روزگار"
  },
  {
    "poem_id": 1675,
    "vorder": 61,
    "position": 0,
    "text": "ز ما هرچ باید همه بنده‌ایم"
  },
  {
    "poem_id": 1675,
    "vorder": 62,
    "position": 1,
    "text": "پرستنده باشیم تا زنده‌ایم"
  },
  {
    "poem_id": 1675,
    "vorder": 63,
    "position": 0,
    "text": "بیاریم چندانک خواهی تو چیز"
  },
  {
    "poem_id": 1675,
    "vorder": 64,
    "position": 1,
    "text": "کزین بیش کاری نداریم نیز"
  },
  {
    "poem_id": 1675,
    "vorder": 65,
    "position": 0,
    "text": "سکندر بیامد نگه کرد کوه"
  },
  {
    "poem_id": 1675,
    "vorder": 66,
    "position": 1,
    "text": "بیاورد زان فیلسوفان گروه"
  },
  {
    "poem_id": 1675,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود کاهنگران آورید"
  },
  {
    "poem_id": 1675,
    "vorder": 68,
    "position": 1,
    "text": "مس و روی و پتک گران آورید"
  },
  {
    "poem_id": 1675,
    "vorder": 69,
    "position": 0,
    "text": "کج و سنگ و هیزم فزون از شمار"
  },
  {
    "poem_id": 1675,
    "vorder": 70,
    "position": 1,
    "text": "بیارید چندانک آید به کار"
  },
  {
    "poem_id": 1675,
    "vorder": 71,
    "position": 0,
    "text": "بی‌اندازه بردند چیزی که خواست"
  },
  {
    "poem_id": 1675,
    "vorder": 72,
    "position": 1,
    "text": "چو شد ساخته کار و اندیشه راست"
  },
  {
    "poem_id": 1675,
    "vorder": 73,
    "position": 0,
    "text": "ز دیوارگر هم ز آهنگران"
  },
  {
    "poem_id": 1675,
    "vorder": 74,
    "position": 1,
    "text": "هرانکس که استاد بود اندران"
  },
  {
    "poem_id": 1675,
    "vorder": 75,
    "position": 0,
    "text": "ز گیتی به پیش سکندر شدند"
  },
  {
    "poem_id": 1675,
    "vorder": 76,
    "position": 1,
    "text": "بدان کار بایسته یاور شدند"
  },
  {
    "poem_id": 1675,
    "vorder": 77,
    "position": 0,
    "text": "ز هر کشوری دانشی شد گروه"
  },
  {
    "poem_id": 1675,
    "vorder": 78,
    "position": 1,
    "text": "دو دیوار کرد از دو پهلوی کوه"
  },
  {
    "poem_id": 1675,
    "vorder": 79,
    "position": 0,
    "text": "ز بن تا سر تیغ بالای اوی"
  },
  {
    "poem_id": 1675,
    "vorder": 80,
    "position": 1,
    "text": "چو صد شاه‌رش کرده پهنای اوی"
  },
  {
    "poem_id": 1675,
    "vorder": 81,
    "position": 0,
    "text": "ازو یک رش انگشت و آهن یکی"
  },
  {
    "poem_id": 1675,
    "vorder": 82,
    "position": 1,
    "text": "پراگنده مس در میان اندکی"
  },
  {
    "poem_id": 1675,
    "vorder": 83,
    "position": 0,
    "text": "همی ریخت گوگردش اندر میان"
  },
  {
    "poem_id": 1675,
    "vorder": 84,
    "position": 1,
    "text": "چنین باشد افسون دانا کیان"
  },
  {
    "poem_id": 1675,
    "vorder": 85,
    "position": 0,
    "text": "همی ریخت هر گوهری یک رده"
  },
  {
    "poem_id": 1675,
    "vorder": 86,
    "position": 1,
    "text": "چو از خاک تا تیغ شد آژده"
  },
  {
    "poem_id": 1675,
    "vorder": 87,
    "position": 0,
    "text": "بسی نفت و روغن برآمیختند"
  },
  {
    "poem_id": 1675,
    "vorder": 88,
    "position": 1,
    "text": "همی بر سر گوهران ریختند"
  },
  {
    "poem_id": 1675,
    "vorder": 89,
    "position": 0,
    "text": "به خروار انگشت بر سر زدند"
  },
  {
    "poem_id": 1675,
    "vorder": 90,
    "position": 1,
    "text": "بفرمود تا آتش اندر زدند"
  },
  {
    "poem_id": 1675,
    "vorder": 91,
    "position": 0,
    "text": "دم آورد و آهنگران صدهزار"
  },
  {
    "poem_id": 1675,
    "vorder": 92,
    "position": 1,
    "text": "به فرمان پیروزگر شهریار"
  },
  {
    "poem_id": 1675,
    "vorder": 93,
    "position": 0,
    "text": "خروش دمنده برآمد ز کوه"
  },
  {
    "poem_id": 1675,
    "vorder": 94,
    "position": 1,
    "text": "ستاره شد از تف آتش ستوه"
  },
  {
    "poem_id": 1675,
    "vorder": 95,
    "position": 0,
    "text": "چنین روزگاری برآمد بران"
  },
  {
    "poem_id": 1675,
    "vorder": 96,
    "position": 1,
    "text": "دم آتش و رنج آهنگران"
  },
  {
    "poem_id": 1675,
    "vorder": 97,
    "position": 0,
    "text": "گهرها یک اندر دگر ساختند"
  },
  {
    "poem_id": 1675,
    "vorder": 98,
    "position": 1,
    "text": "وزان آتش تیز بگداختند"
  },
  {
    "poem_id": 1675,
    "vorder": 99,
    "position": 0,
    "text": "ز یاجوج و ماجوج گیتی برست"
  },
  {
    "poem_id": 1675,
    "vorder": 100,
    "position": 1,
    "text": "زمین گشت جای خرام و نشست"
  },
  {
    "poem_id": 1675,
    "vorder": 101,
    "position": 0,
    "text": "برش پانصد بود بالای اوی"
  },
  {
    "poem_id": 1675,
    "vorder": 102,
    "position": 1,
    "text": "چو سیصد بدی نیز پهنای اوی"
  },
  {
    "poem_id": 1675,
    "vorder": 103,
    "position": 0,
    "text": "ازان نامور سد اسکندری"
  },
  {
    "poem_id": 1675,
    "vorder": 104,
    "position": 1,
    "text": "جهانی برست از بد داوری"
  },
  {
    "poem_id": 1675,
    "vorder": 105,
    "position": 0,
    "text": "برو مهتران خواندند آفرین"
  },
  {
    "poem_id": 1675,
    "vorder": 106,
    "position": 1,
    "text": "که بی‌تو مبادا زمان و زمین"
  },
  {
    "poem_id": 1675,
    "vorder": 107,
    "position": 0,
    "text": "ز چیزی که بود اندران جایگاه"
  },
  {
    "poem_id": 1675,
    "vorder": 108,
    "position": 1,
    "text": "فراوان ببردند نزدیک شاه"
  },
  {
    "poem_id": 1675,
    "vorder": 109,
    "position": 0,
    "text": "نپذرفت ازیشان و خود برگرفت"
  },
  {
    "poem_id": 1675,
    "vorder": 110,
    "position": 1,
    "text": "جهان مانده زان کار اندر شگفت"
  }
]