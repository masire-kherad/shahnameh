[
  {
    "poem_id": 1358,
    "vorder": 1,
    "position": 0,
    "text": "فریدون چو شد بر جهان کامگار"
  },
  {
    "poem_id": 1358,
    "vorder": 2,
    "position": 1,
    "text": "ندانست جز خویشتن شهریار"
  },
  {
    "poem_id": 1358,
    "vorder": 3,
    "position": 0,
    "text": "به رسم کیان تاج و تخت مهی"
  },
  {
    "poem_id": 1358,
    "vorder": 4,
    "position": 1,
    "text": "بیاراست با کاخ شاهنشهی"
  },
  {
    "poem_id": 1358,
    "vorder": 5,
    "position": 0,
    "text": "به روز خجسته سر مهر‌ماه"
  },
  {
    "poem_id": 1358,
    "vorder": 6,
    "position": 1,
    "text": "به سر بر نهاد آن کیانی کلاه"
  },
  {
    "poem_id": 1358,
    "vorder": 7,
    "position": 0,
    "text": "زمانه بی‌اندوه گشت از بدی"
  },
  {
    "poem_id": 1358,
    "vorder": 8,
    "position": 1,
    "text": "گرفتند هر کس ره ایزدی"
  },
  {
    "poem_id": 1358,
    "vorder": 9,
    "position": 0,
    "text": "دل از داوری‌ها بپرداختند"
  },
  {
    "poem_id": 1358,
    "vorder": 10,
    "position": 1,
    "text": "به آیین یکی جشن نو ساختند"
  },
  {
    "poem_id": 1358,
    "vorder": 11,
    "position": 0,
    "text": "نشستند فرزانگان شادکام"
  },
  {
    "poem_id": 1358,
    "vorder": 12,
    "position": 1,
    "text": "گرفتند هر یک ز یاقوت جام"
  },
  {
    "poem_id": 1358,
    "vorder": 13,
    "position": 0,
    "text": "می روشن و چهرهٔ شاه نو"
  },
  {
    "poem_id": 1358,
    "vorder": 14,
    "position": 1,
    "text": "جهان نو ز داد و سر ماه نو"
  },
  {
    "poem_id": 1358,
    "vorder": 15,
    "position": 0,
    "text": "بفرمود تا آتش افروختند"
  },
  {
    "poem_id": 1358,
    "vorder": 16,
    "position": 1,
    "text": "همه عنبر و زعفران سوختند"
  },
  {
    "poem_id": 1358,
    "vorder": 17,
    "position": 0,
    "text": "پرستیدن مهرگان دین اوست"
  },
  {
    "poem_id": 1358,
    "vorder": 18,
    "position": 1,
    "text": "تن‌آسانی و خوردن آیین اوست"
  },
  {
    "poem_id": 1358,
    "vorder": 19,
    "position": 0,
    "text": "اگر یادگار‌ است از او ماه مهر"
  },
  {
    "poem_id": 1358,
    "vorder": 20,
    "position": 1,
    "text": "بکوش و به رنج ایچ منمای چهر"
  },
  {
    "poem_id": 1358,
    "vorder": 21,
    "position": 0,
    "text": "ورا بد جهان سالیان پانصد"
  },
  {
    "poem_id": 1358,
    "vorder": 22,
    "position": 1,
    "text": "نیفکند یک روز بنیاد بد"
  },
  {
    "poem_id": 1358,
    "vorder": 23,
    "position": 0,
    "text": "جهان چون برو بر نماند ای پسر"
  },
  {
    "poem_id": 1358,
    "vorder": 24,
    "position": 1,
    "text": "تو نیز آز مپرست و انده مخور"
  },
  {
    "poem_id": 1358,
    "vorder": 25,
    "position": 0,
    "text": "نماند چنین دان جهان بر کسی"
  },
  {
    "poem_id": 1358,
    "vorder": 26,
    "position": 1,
    "text": "درو شادکامی نیابی بسی"
  },
  {
    "poem_id": 1358,
    "vorder": 27,
    "position": 0,
    "text": "فرانک نه آگاه بد زین نهان"
  },
  {
    "poem_id": 1358,
    "vorder": 28,
    "position": 1,
    "text": "که فرزند او شاه شد بر جهان"
  },
  {
    "poem_id": 1358,
    "vorder": 29,
    "position": 0,
    "text": "ز ضحاک شد تخت شاهی تهی"
  },
  {
    "poem_id": 1358,
    "vorder": 30,
    "position": 1,
    "text": "سرآمد برو روزگار مهی"
  },
  {
    "poem_id": 1358,
    "vorder": 31,
    "position": 0,
    "text": "پس آگاهی آمد ز فرخ پسر"
  },
  {
    "poem_id": 1358,
    "vorder": 32,
    "position": 1,
    "text": "به مادر که فرزند شد تاجور"
  },
  {
    "poem_id": 1358,
    "vorder": 33,
    "position": 0,
    "text": "نیایش‌کنان شد سر و تن بشست"
  },
  {
    "poem_id": 1358,
    "vorder": 34,
    "position": 1,
    "text": "به پیش جهان‌داور آمد نخست"
  },
  {
    "poem_id": 1358,
    "vorder": 35,
    "position": 0,
    "text": "نهاد آن سرش پست بر خاک بر"
  },
  {
    "poem_id": 1358,
    "vorder": 36,
    "position": 1,
    "text": "همی‌خواند نفرین به ضحاک بر"
  },
  {
    "poem_id": 1358,
    "vorder": 37,
    "position": 0,
    "text": "همی آفرین خواند بر کردگار"
  },
  {
    "poem_id": 1358,
    "vorder": 38,
    "position": 1,
    "text": "بر آن شادمان گردش روزگار"
  },
  {
    "poem_id": 1358,
    "vorder": 39,
    "position": 0,
    "text": "وزان پس کسی را که بودش نیاز"
  },
  {
    "poem_id": 1358,
    "vorder": 40,
    "position": 1,
    "text": "همی‌داشت روز بد خویش راز"
  },
  {
    "poem_id": 1358,
    "vorder": 41,
    "position": 0,
    "text": "نهانش نوا کرد و کس را نگفت"
  },
  {
    "poem_id": 1358,
    "vorder": 42,
    "position": 1,
    "text": "همان راز او داشت اندر نهفت"
  },
  {
    "poem_id": 1358,
    "vorder": 43,
    "position": 0,
    "text": "یکی هفته زین گونه بخشید چیز"
  },
  {
    "poem_id": 1358,
    "vorder": 44,
    "position": 1,
    "text": "چنان شد که درویش نشناخت نیز"
  },
  {
    "poem_id": 1358,
    "vorder": 45,
    "position": 0,
    "text": "دگر هفته مر بزم را کرد ساز"
  },
  {
    "poem_id": 1358,
    "vorder": 46,
    "position": 1,
    "text": "مهانی که بودند گردن فراز"
  },
  {
    "poem_id": 1358,
    "vorder": 47,
    "position": 0,
    "text": "بیاراست چون بوستان خان خویش"
  },
  {
    "poem_id": 1358,
    "vorder": 48,
    "position": 1,
    "text": "مهان را همه کرد مهمان خویش"
  },
  {
    "poem_id": 1358,
    "vorder": 49,
    "position": 0,
    "text": "وزان پس همه گنج آراسته"
  },
  {
    "poem_id": 1358,
    "vorder": 50,
    "position": 1,
    "text": "فراز آوریده نهان خواسته"
  },
  {
    "poem_id": 1358,
    "vorder": 51,
    "position": 0,
    "text": "همان گنج‌ها را گشادن گرفت"
  },
  {
    "poem_id": 1358,
    "vorder": 52,
    "position": 1,
    "text": "نهاده همه رای دادن گرفت"
  },
  {
    "poem_id": 1358,
    "vorder": 53,
    "position": 0,
    "text": "گشادن در گنج را گاه دید"
  },
  {
    "poem_id": 1358,
    "vorder": 54,
    "position": 1,
    "text": "درم خوار شد چون پسر شاه دید"
  },
  {
    "poem_id": 1358,
    "vorder": 55,
    "position": 0,
    "text": "همان جامه و گوهر شاهوار"
  },
  {
    "poem_id": 1358,
    "vorder": 56,
    "position": 1,
    "text": "همان اسپ تازی به زرین عذار"
  },
  {
    "poem_id": 1358,
    "vorder": 57,
    "position": 0,
    "text": "همان جوشن و خود و زوپین و تیغ"
  },
  {
    "poem_id": 1358,
    "vorder": 58,
    "position": 1,
    "text": "کلاه و کمر هم نبودش دریغ"
  },
  {
    "poem_id": 1358,
    "vorder": 59,
    "position": 0,
    "text": "همه خواسته بر شتر بار کرد"
  },
  {
    "poem_id": 1358,
    "vorder": 60,
    "position": 1,
    "text": "دل پاک سوی جهاندار کرد"
  },
  {
    "poem_id": 1358,
    "vorder": 61,
    "position": 0,
    "text": "فرستاد نزدیک فرزند چیز"
  },
  {
    "poem_id": 1358,
    "vorder": 62,
    "position": 1,
    "text": "زبانی پر از آفرین داشت نیز"
  },
  {
    "poem_id": 1358,
    "vorder": 63,
    "position": 0,
    "text": "چو آن خواسته دید شاه زمین"
  },
  {
    "poem_id": 1358,
    "vorder": 64,
    "position": 1,
    "text": "بپذرفت و بر مام کرد آفرین"
  },
  {
    "poem_id": 1358,
    "vorder": 65,
    "position": 0,
    "text": "بزرگان لشگر چو بشناختند"
  },
  {
    "poem_id": 1358,
    "vorder": 66,
    "position": 1,
    "text": "بر شهریار جهان تاختند"
  },
  {
    "poem_id": 1358,
    "vorder": 67,
    "position": 0,
    "text": "که ای شاه پیروز‌ِ یزدان‌شناس"
  },
  {
    "poem_id": 1358,
    "vorder": 68,
    "position": 1,
    "text": "ستایش مر او را وزویت سپاس"
  },
  {
    "poem_id": 1358,
    "vorder": 69,
    "position": 0,
    "text": "چنین روز روزت فزون باد بخت"
  },
  {
    "poem_id": 1358,
    "vorder": 70,
    "position": 1,
    "text": "بد اندیشگان را نگون باد بخت"
  },
  {
    "poem_id": 1358,
    "vorder": 71,
    "position": 0,
    "text": "ترا باد پیروزی از آسمان"
  },
  {
    "poem_id": 1358,
    "vorder": 72,
    "position": 1,
    "text": "مبادا به جز داد و نیکی گمان"
  },
  {
    "poem_id": 1358,
    "vorder": 73,
    "position": 0,
    "text": "وزان پس جهان‌دیدگان سوی شاه"
  },
  {
    "poem_id": 1358,
    "vorder": 74,
    "position": 1,
    "text": "ز هر گوشه‌ای برگرفتند راه"
  },
  {
    "poem_id": 1358,
    "vorder": 75,
    "position": 0,
    "text": "همه زر و گوهر برآمیختند"
  },
  {
    "poem_id": 1358,
    "vorder": 76,
    "position": 1,
    "text": "به تاج سپهبد فرو ریختند"
  },
  {
    "poem_id": 1358,
    "vorder": 77,
    "position": 0,
    "text": "همان مهتران از همه کشور‌ش"
  },
  {
    "poem_id": 1358,
    "vorder": 78,
    "position": 1,
    "text": "بدان خرمی صف زده بر درش"
  },
  {
    "poem_id": 1358,
    "vorder": 79,
    "position": 0,
    "text": "ز یزدان همی‌خواستند آفرین"
  },
  {
    "poem_id": 1358,
    "vorder": 80,
    "position": 1,
    "text": "بران تاج و تخت و کلاه و نگین"
  },
  {
    "poem_id": 1358,
    "vorder": 81,
    "position": 0,
    "text": "همه دست برداشته به آسمان"
  },
  {
    "poem_id": 1358,
    "vorder": 82,
    "position": 1,
    "text": "همی خواندندش به نیکی گمان"
  },
  {
    "poem_id": 1358,
    "vorder": 83,
    "position": 0,
    "text": "که جاوید بادا چنین شهریار"
  },
  {
    "poem_id": 1358,
    "vorder": 84,
    "position": 1,
    "text": "برومند بادا چنین روزگار"
  },
  {
    "poem_id": 1358,
    "vorder": 85,
    "position": 0,
    "text": "وزان پس فریدون به گرد جهان"
  },
  {
    "poem_id": 1358,
    "vorder": 86,
    "position": 1,
    "text": "بگردید و دید آشکار و نهان"
  },
  {
    "poem_id": 1358,
    "vorder": 87,
    "position": 0,
    "text": "هران چیز کز راه بیداد دید"
  },
  {
    "poem_id": 1358,
    "vorder": 88,
    "position": 1,
    "text": "هر آن بوم و بر کان نه آباد دید"
  },
  {
    "poem_id": 1358,
    "vorder": 89,
    "position": 0,
    "text": "به نیکی ببست از همه دست بد"
  },
  {
    "poem_id": 1358,
    "vorder": 90,
    "position": 1,
    "text": "چنانک از ره هوشیاران سزد"
  },
  {
    "poem_id": 1358,
    "vorder": 91,
    "position": 0,
    "text": "بیاراست گیتی بسان بهشت"
  },
  {
    "poem_id": 1358,
    "vorder": 92,
    "position": 1,
    "text": "به جای گیا سرو گلبن بکشت"
  },
  {
    "poem_id": 1358,
    "vorder": 93,
    "position": 0,
    "text": "از آمل گذر سوی تمیشه کرد"
  },
  {
    "poem_id": 1358,
    "vorder": 94,
    "position": 1,
    "text": "نشست اندر آن نامور بیشه کرد"
  },
  {
    "poem_id": 1358,
    "vorder": 95,
    "position": 0,
    "text": "کجا کز جهان گوش خوانی همی"
  },
  {
    "poem_id": 1358,
    "vorder": 96,
    "position": 1,
    "text": "جز این نیز نامش ندانی همی"
  }
]