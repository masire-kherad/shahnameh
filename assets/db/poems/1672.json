[
  {
    "poem_id": 1672,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه شاد لشگر براند"
  },
  {
    "poem_id": 1672,
    "vorder": 2,
    "position": 1,
    "text": "بزرگان بیدار دل را بخواند"
  },
  {
    "poem_id": 1672,
    "vorder": 3,
    "position": 0,
    "text": "همی رفت تا سوی شهری رسید"
  },
  {
    "poem_id": 1672,
    "vorder": 4,
    "position": 1,
    "text": "که آن را میان و کرانه ندید"
  },
  {
    "poem_id": 1672,
    "vorder": 5,
    "position": 0,
    "text": "همه هرچ باید بدو در فراخ"
  },
  {
    "poem_id": 1672,
    "vorder": 6,
    "position": 1,
    "text": "پر از باغ و میدان و ایوان و کاخ"
  },
  {
    "poem_id": 1672,
    "vorder": 7,
    "position": 0,
    "text": "فرود آمد و بامداد پگاه"
  },
  {
    "poem_id": 1672,
    "vorder": 8,
    "position": 1,
    "text": "به نزدیک آن چشمه شد بی‌سپاه"
  },
  {
    "poem_id": 1672,
    "vorder": 9,
    "position": 0,
    "text": "که دهقان ورا نام حیوان نهاد"
  },
  {
    "poem_id": 1672,
    "vorder": 10,
    "position": 1,
    "text": "چو از بخشش پهلوان کرد یاد"
  },
  {
    "poem_id": 1672,
    "vorder": 11,
    "position": 0,
    "text": "همی بود تا گشت خورشید زرد"
  },
  {
    "poem_id": 1672,
    "vorder": 12,
    "position": 1,
    "text": "فرو شد بران چشمهٔ لاژورد"
  },
  {
    "poem_id": 1672,
    "vorder": 13,
    "position": 0,
    "text": "ز یزدان پاک آن شگفتی بدید"
  },
  {
    "poem_id": 1672,
    "vorder": 14,
    "position": 1,
    "text": "که خورشید گشت از جهان ناپدید"
  },
  {
    "poem_id": 1672,
    "vorder": 15,
    "position": 0,
    "text": "بیامد به لشکرگه خویش باز"
  },
  {
    "poem_id": 1672,
    "vorder": 16,
    "position": 1,
    "text": "دلی پر ز اندیشه‌های دراز"
  },
  {
    "poem_id": 1672,
    "vorder": 17,
    "position": 0,
    "text": "شب تیره کرد از جهاندار یاد"
  },
  {
    "poem_id": 1672,
    "vorder": 18,
    "position": 1,
    "text": "پس اندیشه بر آب حیوان نهاد"
  },
  {
    "poem_id": 1672,
    "vorder": 19,
    "position": 0,
    "text": "شکیبا ز لشگر هرانکس که دید"
  },
  {
    "poem_id": 1672,
    "vorder": 20,
    "position": 1,
    "text": "نخست از میان سپه برگزید"
  },
  {
    "poem_id": 1672,
    "vorder": 21,
    "position": 0,
    "text": "چهل روزه افزون خورش برگرفت"
  },
  {
    "poem_id": 1672,
    "vorder": 22,
    "position": 1,
    "text": "بیامد دمان تا چه بیند شگفت"
  },
  {
    "poem_id": 1672,
    "vorder": 23,
    "position": 0,
    "text": "سپه را بران شارستان جای کرد"
  },
  {
    "poem_id": 1672,
    "vorder": 24,
    "position": 1,
    "text": "یکی پیش رو چست بر پای کرد"
  },
  {
    "poem_id": 1672,
    "vorder": 25,
    "position": 0,
    "text": "ورا اندر آن خضر بد رای زن"
  },
  {
    "poem_id": 1672,
    "vorder": 26,
    "position": 1,
    "text": "سر نامداران آن انجمن"
  },
  {
    "poem_id": 1672,
    "vorder": 27,
    "position": 0,
    "text": "سکندر بیامد به فرمان اوی"
  },
  {
    "poem_id": 1672,
    "vorder": 28,
    "position": 1,
    "text": "دل و جان سپرده به پیمان اوی"
  },
  {
    "poem_id": 1672,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت کای مرد بیداردل"
  },
  {
    "poem_id": 1672,
    "vorder": 30,
    "position": 1,
    "text": "یکی تیز گردان بدین کار دل"
  },
  {
    "poem_id": 1672,
    "vorder": 31,
    "position": 0,
    "text": "اگر آب حیوان به چنگ آوریم"
  },
  {
    "poem_id": 1672,
    "vorder": 32,
    "position": 1,
    "text": "بسی بر پرستش درنگ آوریم"
  },
  {
    "poem_id": 1672,
    "vorder": 33,
    "position": 0,
    "text": "نمیرد کسی کو روان پرورد"
  },
  {
    "poem_id": 1672,
    "vorder": 34,
    "position": 1,
    "text": "به یزدان پناهد ز راه خرد"
  },
  {
    "poem_id": 1672,
    "vorder": 35,
    "position": 0,
    "text": "دو مهرست با من که چون آفتاب"
  },
  {
    "poem_id": 1672,
    "vorder": 36,
    "position": 1,
    "text": "بتابد شب تیره چون بیند آب"
  },
  {
    "poem_id": 1672,
    "vorder": 37,
    "position": 0,
    "text": "یکی زان تو برگیر و در پیش باش"
  },
  {
    "poem_id": 1672,
    "vorder": 38,
    "position": 1,
    "text": "نگهبان جان و تن خویش باش"
  },
  {
    "poem_id": 1672,
    "vorder": 39,
    "position": 0,
    "text": "دگر مهره باشد مرا شمع راه"
  },
  {
    "poem_id": 1672,
    "vorder": 40,
    "position": 1,
    "text": "به تاریک اندر شوم با سپاه"
  },
  {
    "poem_id": 1672,
    "vorder": 41,
    "position": 0,
    "text": "ببینیم تا کردگار جهان"
  },
  {
    "poem_id": 1672,
    "vorder": 42,
    "position": 1,
    "text": "بدین آشکارا چه دارد نهان"
  },
  {
    "poem_id": 1672,
    "vorder": 43,
    "position": 0,
    "text": "توی پیش رو گر پناه من اوست"
  },
  {
    "poem_id": 1672,
    "vorder": 44,
    "position": 1,
    "text": "نمایندهٔ رای و راه من اوست"
  },
  {
    "poem_id": 1672,
    "vorder": 45,
    "position": 0,
    "text": "چو لشگر سوی آب حیوان گذشت"
  },
  {
    "poem_id": 1672,
    "vorder": 46,
    "position": 1,
    "text": "خروش آمد الله اکبر ز دشت"
  },
  {
    "poem_id": 1672,
    "vorder": 47,
    "position": 0,
    "text": "چو از منزلی خضر برداشتی"
  },
  {
    "poem_id": 1672,
    "vorder": 48,
    "position": 1,
    "text": "خورشها ز هرگونه بگذاشتی"
  },
  {
    "poem_id": 1672,
    "vorder": 49,
    "position": 0,
    "text": "همی رفت ازین سان دو روز و دو شب"
  },
  {
    "poem_id": 1672,
    "vorder": 50,
    "position": 1,
    "text": "کسی را به خوردن نجنبید لب"
  },
  {
    "poem_id": 1672,
    "vorder": 51,
    "position": 0,
    "text": "سه دیگر به تاریکی اندر دو راه"
  },
  {
    "poem_id": 1672,
    "vorder": 52,
    "position": 1,
    "text": "پدید آمد و گم شد از خضر شاه"
  },
  {
    "poem_id": 1672,
    "vorder": 53,
    "position": 0,
    "text": "پیمبر سوی آب حیوان کشید"
  },
  {
    "poem_id": 1672,
    "vorder": 54,
    "position": 1,
    "text": "سر زندگانی به کیوان کشید"
  },
  {
    "poem_id": 1672,
    "vorder": 55,
    "position": 0,
    "text": "بران آب روشن سر و تن بشست"
  },
  {
    "poem_id": 1672,
    "vorder": 56,
    "position": 1,
    "text": "نگهدار جز پاک یزدان نجست"
  },
  {
    "poem_id": 1672,
    "vorder": 57,
    "position": 0,
    "text": "بخورد و برآسود و برگشت زود"
  },
  {
    "poem_id": 1672,
    "vorder": 58,
    "position": 1,
    "text": "ستایش همی بافرین بر فزود"
  }
]