[
  {
    "poem_id": 1687,
    "vorder": 1,
    "position": 0,
    "text": "کنون پادشاه جهان را ستای"
  },
  {
    "poem_id": 1687,
    "vorder": 2,
    "position": 1,
    "text": "به رزم و به بزم و به دانش گرای"
  },
  {
    "poem_id": 1687,
    "vorder": 3,
    "position": 0,
    "text": "سرافراز محمود فرخنده‌رای"
  },
  {
    "poem_id": 1687,
    "vorder": 4,
    "position": 1,
    "text": "کزویست نام بزرگی به جای"
  },
  {
    "poem_id": 1687,
    "vorder": 5,
    "position": 0,
    "text": "جهاندار ابوالقاسم پر خرد"
  },
  {
    "poem_id": 1687,
    "vorder": 6,
    "position": 1,
    "text": "که رایش همی از خرد برخورد"
  },
  {
    "poem_id": 1687,
    "vorder": 7,
    "position": 0,
    "text": "همی باد تا جاودان شاد دل"
  },
  {
    "poem_id": 1687,
    "vorder": 8,
    "position": 1,
    "text": "ز رنج و ز غم گشته آزاد دل"
  },
  {
    "poem_id": 1687,
    "vorder": 9,
    "position": 0,
    "text": "شهنشاه ایران و زابلستان"
  },
  {
    "poem_id": 1687,
    "vorder": 10,
    "position": 1,
    "text": "ز قنوج تا مرز کابلستان"
  },
  {
    "poem_id": 1687,
    "vorder": 11,
    "position": 0,
    "text": "برو آفرین باد و بر لشکرش"
  },
  {
    "poem_id": 1687,
    "vorder": 12,
    "position": 1,
    "text": "چه بر خویش و بر دوده و کشورش"
  },
  {
    "poem_id": 1687,
    "vorder": 13,
    "position": 0,
    "text": "جهاندار سالار او میر نصر"
  },
  {
    "poem_id": 1687,
    "vorder": 14,
    "position": 1,
    "text": "کزو شادمانست گردنده عصر"
  },
  {
    "poem_id": 1687,
    "vorder": 15,
    "position": 0,
    "text": "دریغش نیاید ز بخشیدن ایچ"
  },
  {
    "poem_id": 1687,
    "vorder": 16,
    "position": 1,
    "text": "نه آرام گیرد به روز بسیچ"
  },
  {
    "poem_id": 1687,
    "vorder": 17,
    "position": 0,
    "text": "چو جنگ آیدش پیش جنگ آورد"
  },
  {
    "poem_id": 1687,
    "vorder": 18,
    "position": 1,
    "text": "سر شهریاران به چنگ آورد"
  },
  {
    "poem_id": 1687,
    "vorder": 19,
    "position": 0,
    "text": "برآنکس که بخشش کند گنج خویش"
  },
  {
    "poem_id": 1687,
    "vorder": 20,
    "position": 1,
    "text": "ببخشد نه‌اندیشد از رنج خویش"
  },
  {
    "poem_id": 1687,
    "vorder": 21,
    "position": 0,
    "text": "جهان تاجهاندار محمود باد"
  },
  {
    "poem_id": 1687,
    "vorder": 22,
    "position": 1,
    "text": "وزو بخشش و داد موجود باد"
  },
  {
    "poem_id": 1687,
    "vorder": 23,
    "position": 0,
    "text": "سپهدار چون بوالمظفر بود"
  },
  {
    "poem_id": 1687,
    "vorder": 24,
    "position": 1,
    "text": "سرلشکر از ماه برتر بود"
  },
  {
    "poem_id": 1687,
    "vorder": 25,
    "position": 0,
    "text": "که پیروز نامست و پیروزبخت"
  },
  {
    "poem_id": 1687,
    "vorder": 26,
    "position": 1,
    "text": "همی بگذرد تیر او بر درخت"
  },
  {
    "poem_id": 1687,
    "vorder": 27,
    "position": 0,
    "text": "همیشه تن شاه بی‌رنج باد"
  },
  {
    "poem_id": 1687,
    "vorder": 28,
    "position": 1,
    "text": "نشستش همه بر سر گنج باد"
  },
  {
    "poem_id": 1687,
    "vorder": 29,
    "position": 0,
    "text": "همیدون سپهدار او شاد باد"
  },
  {
    "poem_id": 1687,
    "vorder": 30,
    "position": 1,
    "text": "دلش روشن و گنجش آباد باد"
  },
  {
    "poem_id": 1687,
    "vorder": 31,
    "position": 0,
    "text": "چنین تا به پایست گردان سپهر"
  },
  {
    "poem_id": 1687,
    "vorder": 32,
    "position": 1,
    "text": "ازین تخمه هرگز مبراد مهر"
  },
  {
    "poem_id": 1687,
    "vorder": 33,
    "position": 0,
    "text": "پدر بر پدر بر پسر بر پسر"
  },
  {
    "poem_id": 1687,
    "vorder": 34,
    "position": 1,
    "text": "همه تاجدارند و پیروزگر"
  },
  {
    "poem_id": 1687,
    "vorder": 35,
    "position": 0,
    "text": "گذشته ز شوال ده با چهار"
  },
  {
    "poem_id": 1687,
    "vorder": 36,
    "position": 1,
    "text": "یکی آفرین باد بر شهریار"
  },
  {
    "poem_id": 1687,
    "vorder": 37,
    "position": 0,
    "text": "کزین مژده دادیم رسم خراج"
  },
  {
    "poem_id": 1687,
    "vorder": 38,
    "position": 1,
    "text": "که فرمان بد از شاه با فر و تاج"
  },
  {
    "poem_id": 1687,
    "vorder": 39,
    "position": 0,
    "text": "که سالی خراجی نخواهند بیش"
  },
  {
    "poem_id": 1687,
    "vorder": 40,
    "position": 1,
    "text": "ز دین‌دار بیدار وز مرد کیش"
  },
  {
    "poem_id": 1687,
    "vorder": 41,
    "position": 0,
    "text": "بدین عهد نوشین‌روان تازه شد"
  },
  {
    "poem_id": 1687,
    "vorder": 42,
    "position": 1,
    "text": "همه کار بر دیگر اندازه شد"
  },
  {
    "poem_id": 1687,
    "vorder": 43,
    "position": 0,
    "text": "چو آمد بران روزگاری دراز"
  },
  {
    "poem_id": 1687,
    "vorder": 44,
    "position": 1,
    "text": "همی بفگند چادر داد باز"
  },
  {
    "poem_id": 1687,
    "vorder": 45,
    "position": 0,
    "text": "ببینی بدین داد و نیکی گمان"
  },
  {
    "poem_id": 1687,
    "vorder": 46,
    "position": 1,
    "text": "که او خلعتی یابد از آسمان"
  },
  {
    "poem_id": 1687,
    "vorder": 47,
    "position": 0,
    "text": "که هرگز نگردد کهن بر برش"
  },
  {
    "poem_id": 1687,
    "vorder": 48,
    "position": 1,
    "text": "بماند کلاه کیان بر سرش"
  },
  {
    "poem_id": 1687,
    "vorder": 49,
    "position": 0,
    "text": "سرش سبز باد و تنش بی‌گزند"
  },
  {
    "poem_id": 1687,
    "vorder": 50,
    "position": 1,
    "text": "منش برگذشته ز چرخ بلند"
  },
  {
    "poem_id": 1687,
    "vorder": 51,
    "position": 0,
    "text": "ندارد کسی خوار فال مرا"
  },
  {
    "poem_id": 1687,
    "vorder": 52,
    "position": 1,
    "text": "کجا بشمرد ماه و سال مرا"
  },
  {
    "poem_id": 1687,
    "vorder": 53,
    "position": 0,
    "text": "نگه کن که این نامه تا جاودان"
  },
  {
    "poem_id": 1687,
    "vorder": 54,
    "position": 1,
    "text": "درفشی بود بر سر بخردان"
  },
  {
    "poem_id": 1687,
    "vorder": 55,
    "position": 0,
    "text": "بماند بسی روزگاران چنین"
  },
  {
    "poem_id": 1687,
    "vorder": 56,
    "position": 1,
    "text": "که خوانند هرکس برو آفرین"
  },
  {
    "poem_id": 1687,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت نوشین روان قباد"
  },
  {
    "poem_id": 1687,
    "vorder": 58,
    "position": 1,
    "text": "که چون شاه را دل بپیچد ز داد"
  },
  {
    "poem_id": 1687,
    "vorder": 59,
    "position": 0,
    "text": "کند چرخ منشور او را سیاه"
  },
  {
    "poem_id": 1687,
    "vorder": 60,
    "position": 1,
    "text": "ستاره نخواند ورا نیز شاه"
  },
  {
    "poem_id": 1687,
    "vorder": 61,
    "position": 0,
    "text": "ستم نامهٔ عزل شاهان بود"
  },
  {
    "poem_id": 1687,
    "vorder": 62,
    "position": 1,
    "text": "چو درد دل بیگناهان بود"
  },
  {
    "poem_id": 1687,
    "vorder": 63,
    "position": 0,
    "text": "بماناد تا جاودان این گهر"
  },
  {
    "poem_id": 1687,
    "vorder": 64,
    "position": 1,
    "text": "هنرمند و بادانش و دادگر"
  },
  {
    "poem_id": 1687,
    "vorder": 65,
    "position": 0,
    "text": "نباشد جهان بر کسی پایدار"
  },
  {
    "poem_id": 1687,
    "vorder": 66,
    "position": 1,
    "text": "همه نام نیکو بود یادگار"
  },
  {
    "poem_id": 1687,
    "vorder": 67,
    "position": 0,
    "text": "کجا شد فریدون و ضحاک و جم"
  },
  {
    "poem_id": 1687,
    "vorder": 68,
    "position": 1,
    "text": "مهان عرب خسروان عجم"
  },
  {
    "poem_id": 1687,
    "vorder": 69,
    "position": 0,
    "text": "کجا آن بزرگان ساسانیان"
  },
  {
    "poem_id": 1687,
    "vorder": 70,
    "position": 1,
    "text": "ز بهرامیان تا به سامانیان"
  },
  {
    "poem_id": 1687,
    "vorder": 71,
    "position": 0,
    "text": "نکوهیده‌تر شاه ضحاک بود"
  },
  {
    "poem_id": 1687,
    "vorder": 72,
    "position": 1,
    "text": "که بیدادگر بود و ناپاک بود"
  },
  {
    "poem_id": 1687,
    "vorder": 73,
    "position": 0,
    "text": "فریدون فرخ ستایش ببرد"
  },
  {
    "poem_id": 1687,
    "vorder": 74,
    "position": 1,
    "text": "بمرد او و جاوید نامش نمرد"
  },
  {
    "poem_id": 1687,
    "vorder": 75,
    "position": 0,
    "text": "سخن ماند اندر جهان یادگار"
  },
  {
    "poem_id": 1687,
    "vorder": 76,
    "position": 1,
    "text": "سخن بهتر از گوهر شاهوار"
  },
  {
    "poem_id": 1687,
    "vorder": 77,
    "position": 0,
    "text": "ستایش نبرد آنک بیداد بود"
  },
  {
    "poem_id": 1687,
    "vorder": 78,
    "position": 1,
    "text": "به گنج و به تخت مهی شاد بود"
  },
  {
    "poem_id": 1687,
    "vorder": 79,
    "position": 0,
    "text": "گسسته شود در جهان کام اوی"
  },
  {
    "poem_id": 1687,
    "vorder": 80,
    "position": 1,
    "text": "نخواند به گیتی کسی نام اوی"
  },
  {
    "poem_id": 1687,
    "vorder": 81,
    "position": 0,
    "text": "ازین نامهٔ شاه دشمن‌گداز"
  },
  {
    "poem_id": 1687,
    "vorder": 82,
    "position": 1,
    "text": "که بادا همه ساله بر تخت ناز"
  },
  {
    "poem_id": 1687,
    "vorder": 83,
    "position": 0,
    "text": "همه مردم از خانها شد به دشت"
  },
  {
    "poem_id": 1687,
    "vorder": 84,
    "position": 1,
    "text": "نیایش همی ز آسمان برگذشت"
  },
  {
    "poem_id": 1687,
    "vorder": 85,
    "position": 0,
    "text": "که جاوید بادا سر تاجدار"
  },
  {
    "poem_id": 1687,
    "vorder": 86,
    "position": 1,
    "text": "خجسته برو گردش روزگار"
  },
  {
    "poem_id": 1687,
    "vorder": 87,
    "position": 0,
    "text": "ز گیتی مبیناد جز کام خویش"
  },
  {
    "poem_id": 1687,
    "vorder": 88,
    "position": 1,
    "text": "نوشته بر ایوانها نام خویش"
  },
  {
    "poem_id": 1687,
    "vorder": 89,
    "position": 0,
    "text": "همان دوده و لشکر و کشورش"
  },
  {
    "poem_id": 1687,
    "vorder": 90,
    "position": 1,
    "text": "همان خسروی قامت و منظرش"
  }
]