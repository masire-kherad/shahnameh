[
  {
    "poem_id": 88020,
    "vorder": 1,
    "position": 0,
    "text": "بدانگه که رستم ببربر گره"
  },
  {
    "poem_id": 88020,
    "vorder": 2,
    "position": 1,
    "text": "برافگند و زد بر گره بر زره"
  },
  {
    "poem_id": 88020,
    "vorder": 3,
    "position": 0,
    "text": "بشد پیش یزدان خورشید و ماه"
  },
  {
    "poem_id": 88020,
    "vorder": 4,
    "position": 1,
    "text": "بیامد بدو کرد پشت و پناه"
  },
  {
    "poem_id": 88020,
    "vorder": 5,
    "position": 0,
    "text": "همی گفت چشم بدان کور باد"
  },
  {
    "poem_id": 88020,
    "vorder": 6,
    "position": 1,
    "text": "بدین کار بیژن مرا زور باد"
  },
  {
    "poem_id": 88020,
    "vorder": 7,
    "position": 0,
    "text": "بگردان بفرمود تا همچنین"
  },
  {
    "poem_id": 88020,
    "vorder": 8,
    "position": 1,
    "text": "ببستند بر گردگه بند کین"
  },
  {
    "poem_id": 88020,
    "vorder": 9,
    "position": 0,
    "text": "بر اسبان نهادند زین خدنگ"
  },
  {
    "poem_id": 88020,
    "vorder": 10,
    "position": 1,
    "text": "همه جنگ را تیز کردند چنگ"
  },
  {
    "poem_id": 88020,
    "vorder": 11,
    "position": 0,
    "text": "تهمتن برخشنده بنهاد روی"
  },
  {
    "poem_id": 88020,
    "vorder": 12,
    "position": 1,
    "text": "همی رفت پیش اندرون راه جوی"
  },
  {
    "poem_id": 88020,
    "vorder": 13,
    "position": 0,
    "text": "چو آمد بر سنگ اکوان فراز"
  },
  {
    "poem_id": 88020,
    "vorder": 14,
    "position": 1,
    "text": "بدان چاه اندوه و گرم و گداز"
  },
  {
    "poem_id": 88020,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت با نامور هفت گرد"
  },
  {
    "poem_id": 88020,
    "vorder": 16,
    "position": 1,
    "text": "که روی زمین را بباید سترد"
  },
  {
    "poem_id": 88020,
    "vorder": 17,
    "position": 0,
    "text": "بباید شما را کنون ساختن"
  },
  {
    "poem_id": 88020,
    "vorder": 18,
    "position": 1,
    "text": "سر چاه از سنگ پرداختن"
  },
  {
    "poem_id": 88020,
    "vorder": 19,
    "position": 0,
    "text": "پیاده شدند آن سران سپاه"
  },
  {
    "poem_id": 88020,
    "vorder": 20,
    "position": 1,
    "text": "کزان سنگ پردخت مانند چاه"
  },
  {
    "poem_id": 88020,
    "vorder": 21,
    "position": 0,
    "text": "بسودند بسیار بر سنگ چنگ"
  },
  {
    "poem_id": 88020,
    "vorder": 22,
    "position": 1,
    "text": "شده مانده گردان و آسوده سنگ"
  },
  {
    "poem_id": 88020,
    "vorder": 23,
    "position": 0,
    "text": "چو از نامداران بپالود خوی"
  },
  {
    "poem_id": 88020,
    "vorder": 24,
    "position": 1,
    "text": "که سنگ از سر چاه ننهاد پی"
  },
  {
    "poem_id": 88020,
    "vorder": 25,
    "position": 0,
    "text": "ز رخش اندر آمد گو شیرنر"
  },
  {
    "poem_id": 88020,
    "vorder": 26,
    "position": 1,
    "text": "زره دامنش را بزد بر کمر"
  },
  {
    "poem_id": 88020,
    "vorder": 27,
    "position": 0,
    "text": "ز یزدان جان آفرین زور خواست"
  },
  {
    "poem_id": 88020,
    "vorder": 28,
    "position": 1,
    "text": "بزد دست و آن سنگ برداشت داست"
  },
  {
    "poem_id": 88020,
    "vorder": 29,
    "position": 0,
    "text": "بینداخت در بیشهٔ شهر چین"
  },
  {
    "poem_id": 88020,
    "vorder": 30,
    "position": 1,
    "text": "بلرزید ازان سنگ روی زمین"
  },
  {
    "poem_id": 88020,
    "vorder": 31,
    "position": 0,
    "text": "ز بیژن بپرسید و نالید زار"
  },
  {
    "poem_id": 88020,
    "vorder": 32,
    "position": 1,
    "text": "که چون بود کارت ببد روزگار"
  },
  {
    "poem_id": 88020,
    "vorder": 33,
    "position": 0,
    "text": "همه نوش بودی ز گیتیت بهر"
  },
  {
    "poem_id": 88020,
    "vorder": 34,
    "position": 1,
    "text": "ز دستش چرا بستدی جام زهر"
  },
  {
    "poem_id": 88020,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت بیژن ز تاریک چاه"
  },
  {
    "poem_id": 88020,
    "vorder": 36,
    "position": 1,
    "text": "که چون بود بر پهلوان رنج راه"
  },
  {
    "poem_id": 88020,
    "vorder": 37,
    "position": 0,
    "text": "مرا چون خروش تو آمد بگوش"
  },
  {
    "poem_id": 88020,
    "vorder": 38,
    "position": 1,
    "text": "همه زهر گیتی مرا گشت نوش"
  },
  {
    "poem_id": 88020,
    "vorder": 39,
    "position": 0,
    "text": "بدین سان که بینی مرا خان و مان"
  },
  {
    "poem_id": 88020,
    "vorder": 40,
    "position": 1,
    "text": "ز آهن زمین و ز سنگ آسمان"
  },
  {
    "poem_id": 88020,
    "vorder": 41,
    "position": 0,
    "text": "بکنده دلم زین سرای سپنج"
  },
  {
    "poem_id": 88020,
    "vorder": 42,
    "position": 1,
    "text": "ز بس درد و سختی و اندوه و رنج"
  },
  {
    "poem_id": 88020,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت رستم که بر جان تو"
  },
  {
    "poem_id": 88020,
    "vorder": 44,
    "position": 1,
    "text": "ببخشود روشن جهانبان تو"
  },
  {
    "poem_id": 88020,
    "vorder": 45,
    "position": 0,
    "text": "کنون ای خردمند آزاده خوی"
  },
  {
    "poem_id": 88020,
    "vorder": 46,
    "position": 1,
    "text": "مرا هست با تو یکی آرزوی"
  },
  {
    "poem_id": 88020,
    "vorder": 47,
    "position": 0,
    "text": "بمن بخش گرگین میلاد را"
  },
  {
    "poem_id": 88020,
    "vorder": 48,
    "position": 1,
    "text": "ز دل دور کن کین و بیداد را"
  },
  {
    "poem_id": 88020,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت بیژن که ای یار من"
  },
  {
    "poem_id": 88020,
    "vorder": 50,
    "position": 1,
    "text": "ندانی که چون بود پیکار من"
  },
  {
    "poem_id": 88020,
    "vorder": 51,
    "position": 0,
    "text": "ندانی تو ای مهتر شیرمرد"
  },
  {
    "poem_id": 88020,
    "vorder": 52,
    "position": 1,
    "text": "که گرگین میلاد با من چه کرد"
  },
  {
    "poem_id": 88020,
    "vorder": 53,
    "position": 0,
    "text": "گرافتد بروبر جهانبین من"
  },
  {
    "poem_id": 88020,
    "vorder": 54,
    "position": 1,
    "text": "برو رستخیز آید از کین من"
  },
  {
    "poem_id": 88020,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت رستم که گر بدخوی"
  },
  {
    "poem_id": 88020,
    "vorder": 56,
    "position": 1,
    "text": "بیاری و گفتار من نشنوی"
  },
  {
    "poem_id": 88020,
    "vorder": 57,
    "position": 0,
    "text": "بمانم ترا بسته در چاه پای"
  },
  {
    "poem_id": 88020,
    "vorder": 58,
    "position": 1,
    "text": "برخش اندر آرم شوم باز جای"
  },
  {
    "poem_id": 88020,
    "vorder": 59,
    "position": 0,
    "text": "چو گفتار رستم رسیدش بگوش"
  },
  {
    "poem_id": 88020,
    "vorder": 60,
    "position": 1,
    "text": "ازان تنگ زندان برآمد خروش"
  },
  {
    "poem_id": 88020,
    "vorder": 61,
    "position": 0,
    "text": "چنین داد پاسخ که بد بخت من"
  },
  {
    "poem_id": 88020,
    "vorder": 62,
    "position": 1,
    "text": "ز گردان وز دوده و انجمن"
  },
  {
    "poem_id": 88020,
    "vorder": 63,
    "position": 0,
    "text": "ز گرگین بدان بد که بر من رسید"
  },
  {
    "poem_id": 88020,
    "vorder": 64,
    "position": 1,
    "text": "چنین روز نیزم بباید کشید"
  },
  {
    "poem_id": 88020,
    "vorder": 65,
    "position": 0,
    "text": "کشیدیم و گشتیم خشنود ازوی"
  },
  {
    "poem_id": 88020,
    "vorder": 66,
    "position": 1,
    "text": "ز کینه دل من بیاسود ازوی"
  },
  {
    "poem_id": 88020,
    "vorder": 67,
    "position": 0,
    "text": "فروهشت رستم بزندان کمند"
  },
  {
    "poem_id": 88020,
    "vorder": 68,
    "position": 1,
    "text": "برآوردش از چاه با پای‌بند"
  },
  {
    "poem_id": 88020,
    "vorder": 69,
    "position": 0,
    "text": "برهنه تن و موی و ناخن دراز"
  },
  {
    "poem_id": 88020,
    "vorder": 70,
    "position": 1,
    "text": "گدازیده از رنج و درد و نیاز"
  },
  {
    "poem_id": 88020,
    "vorder": 71,
    "position": 0,
    "text": "همه تن پر از خون و رخساره زرد"
  },
  {
    "poem_id": 88020,
    "vorder": 72,
    "position": 1,
    "text": "ازان بند زنجیر زنگار خورد"
  },
  {
    "poem_id": 88020,
    "vorder": 73,
    "position": 0,
    "text": "خروشید رستم چو او را بدید"
  },
  {
    "poem_id": 88020,
    "vorder": 74,
    "position": 1,
    "text": "همه تن در آهن شده ناپدید"
  },
  {
    "poem_id": 88020,
    "vorder": 75,
    "position": 0,
    "text": "بزد دست و بگسست زنجیر و بند"
  },
  {
    "poem_id": 88020,
    "vorder": 76,
    "position": 1,
    "text": "رها کرد ازو حلقهٔ پای بند"
  },
  {
    "poem_id": 88020,
    "vorder": 77,
    "position": 0,
    "text": "سوی خانه رفتند زان چاهسار"
  },
  {
    "poem_id": 88020,
    "vorder": 78,
    "position": 1,
    "text": "بیک دست بیژن بدیگر زوار"
  },
  {
    "poem_id": 88020,
    "vorder": 79,
    "position": 0,
    "text": "تهمتن بفرمود شستن سرش"
  },
  {
    "poem_id": 88020,
    "vorder": 80,
    "position": 1,
    "text": "یکی جامه پوشید نو بر برش"
  },
  {
    "poem_id": 88020,
    "vorder": 81,
    "position": 0,
    "text": "ازان پس چو گرگین بنزدیک اوی"
  },
  {
    "poem_id": 88020,
    "vorder": 82,
    "position": 1,
    "text": "بیامد بمالید بر خاک روی"
  },
  {
    "poem_id": 88020,
    "vorder": 83,
    "position": 0,
    "text": "ز کردار بد پوزش آورد پیش"
  },
  {
    "poem_id": 88020,
    "vorder": 84,
    "position": 1,
    "text": "بپیچید زان خام کردار خویش"
  },
  {
    "poem_id": 88020,
    "vorder": 85,
    "position": 0,
    "text": "دل بیژن از کینش آمد براه"
  },
  {
    "poem_id": 88020,
    "vorder": 86,
    "position": 1,
    "text": "مکافات ناورد پیش گناه"
  },
  {
    "poem_id": 88020,
    "vorder": 87,
    "position": 0,
    "text": "شتر بار کردند و اسبان بزین"
  },
  {
    "poem_id": 88020,
    "vorder": 88,
    "position": 1,
    "text": "بپوشید رستم سلیح گزین"
  },
  {
    "poem_id": 88020,
    "vorder": 89,
    "position": 0,
    "text": "نشستند بر باره ناموران"
  },
  {
    "poem_id": 88020,
    "vorder": 90,
    "position": 1,
    "text": "کشیدند شمشیر و گرز گران"
  },
  {
    "poem_id": 88020,
    "vorder": 91,
    "position": 0,
    "text": "گسی کرد بار و برآراست کار"
  },
  {
    "poem_id": 88020,
    "vorder": 92,
    "position": 1,
    "text": "چنانچون بود در خور کارزار"
  },
  {
    "poem_id": 88020,
    "vorder": 93,
    "position": 0,
    "text": "بشد با بنه اشکش تیزهوش"
  },
  {
    "poem_id": 88020,
    "vorder": 94,
    "position": 1,
    "text": "که دارد سپه را بهرجای گوش"
  },
  {
    "poem_id": 88020,
    "vorder": 95,
    "position": 0,
    "text": "به بیژن بفرمود رستم که شو"
  },
  {
    "poem_id": 88020,
    "vorder": 96,
    "position": 1,
    "text": "تو با اشکش و با منیژه برو"
  },
  {
    "poem_id": 88020,
    "vorder": 97,
    "position": 0,
    "text": "که ما امشب از کین افراسیاب"
  },
  {
    "poem_id": 88020,
    "vorder": 98,
    "position": 1,
    "text": "نیابیم آرام و نه خورد و خواب"
  },
  {
    "poem_id": 88020,
    "vorder": 99,
    "position": 0,
    "text": "یکی کار سازم کنون بر درش"
  },
  {
    "poem_id": 88020,
    "vorder": 100,
    "position": 1,
    "text": "که فردا بخندد برو کشورش"
  },
  {
    "poem_id": 88020,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت بیژن منم پیش‌رو"
  },
  {
    "poem_id": 88020,
    "vorder": 102,
    "position": 1,
    "text": "که از من همی کینه سازند نو"
  }
]