[
  {
    "poem_id": 1799,
    "vorder": 1,
    "position": 0,
    "text": "وزیر خردمند بر پای خاست"
  },
  {
    "poem_id": 1799,
    "vorder": 2,
    "position": 1,
    "text": "چنین گفت کی خسرو داد و راست"
  },
  {
    "poem_id": 1799,
    "vorder": 3,
    "position": 0,
    "text": "جهان از بداندیش بی بیم گشت"
  },
  {
    "poem_id": 1799,
    "vorder": 4,
    "position": 1,
    "text": "وزین مرزها رنج و سختی گذشت"
  },
  {
    "poem_id": 1799,
    "vorder": 5,
    "position": 0,
    "text": "مگر نامور شنگل از هندوان"
  },
  {
    "poem_id": 1799,
    "vorder": 6,
    "position": 1,
    "text": "که از داد پیچیده دارد روان"
  },
  {
    "poem_id": 1799,
    "vorder": 7,
    "position": 0,
    "text": "ز هندوستان تا در مرز چین"
  },
  {
    "poem_id": 1799,
    "vorder": 8,
    "position": 1,
    "text": "ز دزدان پرآشوب دارد زمین"
  },
  {
    "poem_id": 1799,
    "vorder": 9,
    "position": 0,
    "text": "به ایران همی دست یازد به بد"
  },
  {
    "poem_id": 1799,
    "vorder": 10,
    "position": 1,
    "text": "بدین داستان کارسازی سزد"
  },
  {
    "poem_id": 1799,
    "vorder": 11,
    "position": 0,
    "text": "تو شاهی و شنگل نگهبان هند"
  },
  {
    "poem_id": 1799,
    "vorder": 12,
    "position": 1,
    "text": "چرا باژ خواهد ز چین و ز سند"
  },
  {
    "poem_id": 1799,
    "vorder": 13,
    "position": 0,
    "text": "براندیش و تدبیر آن بازجوی"
  },
  {
    "poem_id": 1799,
    "vorder": 14,
    "position": 1,
    "text": "نباید که ناخوبی آید بروی"
  },
  {
    "poem_id": 1799,
    "vorder": 15,
    "position": 0,
    "text": "چو بشنید شاه آن پراندیشه شد"
  },
  {
    "poem_id": 1799,
    "vorder": 16,
    "position": 1,
    "text": "جهان پیش او چون یکی بیشه شد"
  },
  {
    "poem_id": 1799,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت کاین کار من در نهان"
  },
  {
    "poem_id": 1799,
    "vorder": 18,
    "position": 1,
    "text": "بسازم نگویم به کس در جهان"
  },
  {
    "poem_id": 1799,
    "vorder": 19,
    "position": 0,
    "text": "به تنها ببینم سپاه ورا"
  },
  {
    "poem_id": 1799,
    "vorder": 20,
    "position": 1,
    "text": "همان رسم شاهی و گاه ورا"
  },
  {
    "poem_id": 1799,
    "vorder": 21,
    "position": 0,
    "text": "شوم پیش او چون فرستادگان"
  },
  {
    "poem_id": 1799,
    "vorder": 22,
    "position": 1,
    "text": "نگویم به ایران به آزادگان"
  },
  {
    "poem_id": 1799,
    "vorder": 23,
    "position": 0,
    "text": "بشد پاک دستور او با دبیر"
  },
  {
    "poem_id": 1799,
    "vorder": 24,
    "position": 1,
    "text": "جزو هرکسی آنک بد ناگزیر"
  },
  {
    "poem_id": 1799,
    "vorder": 25,
    "position": 0,
    "text": "بگفتند هرگونه از بیش و کم"
  },
  {
    "poem_id": 1799,
    "vorder": 26,
    "position": 1,
    "text": "ببردند قرطاس و مشک و قلم"
  },
  {
    "poem_id": 1799,
    "vorder": 27,
    "position": 0,
    "text": "یکی نامه بنوشت پر پند و رای"
  },
  {
    "poem_id": 1799,
    "vorder": 28,
    "position": 1,
    "text": "پر از دانش و آفرین خدای"
  },
  {
    "poem_id": 1799,
    "vorder": 29,
    "position": 0,
    "text": "سر نامه کرد از نخست آفرین"
  },
  {
    "poem_id": 1799,
    "vorder": 30,
    "position": 1,
    "text": "ز یزدان برآنکس که جست آفرین"
  },
  {
    "poem_id": 1799,
    "vorder": 31,
    "position": 0,
    "text": "خداوند هست و خداوند نیست"
  },
  {
    "poem_id": 1799,
    "vorder": 32,
    "position": 1,
    "text": "همه چیز جفتست و ایزد یکیست"
  },
  {
    "poem_id": 1799,
    "vorder": 33,
    "position": 0,
    "text": "ز چیزی کجا او دهد بنده را"
  },
  {
    "poem_id": 1799,
    "vorder": 34,
    "position": 1,
    "text": "پرستنده و تاج دارنده را"
  },
  {
    "poem_id": 1799,
    "vorder": 35,
    "position": 0,
    "text": "فزون از خرد نیست اندر جهان"
  },
  {
    "poem_id": 1799,
    "vorder": 36,
    "position": 1,
    "text": "فروزنده کهتران و مهان"
  },
  {
    "poem_id": 1799,
    "vorder": 37,
    "position": 0,
    "text": "هرانکس که او شاد شد از خرد"
  },
  {
    "poem_id": 1799,
    "vorder": 38,
    "position": 1,
    "text": "جهان را به کردار بد نسپرد"
  },
  {
    "poem_id": 1799,
    "vorder": 39,
    "position": 0,
    "text": "پشیمان نشد هر که نیکی گزید"
  },
  {
    "poem_id": 1799,
    "vorder": 40,
    "position": 1,
    "text": "که بد آب دانش نیارد مزید"
  },
  {
    "poem_id": 1799,
    "vorder": 41,
    "position": 0,
    "text": "رهاند خرد مرد را از بلا"
  },
  {
    "poem_id": 1799,
    "vorder": 42,
    "position": 1,
    "text": "مبادا کسی در بلا مبتلا"
  },
  {
    "poem_id": 1799,
    "vorder": 43,
    "position": 0,
    "text": "نخستین نشان خرد آن بود"
  },
  {
    "poem_id": 1799,
    "vorder": 44,
    "position": 1,
    "text": "که از بد همه‌ساله ترسان بود"
  },
  {
    "poem_id": 1799,
    "vorder": 45,
    "position": 0,
    "text": "بداند تن خویش را در نهان"
  },
  {
    "poem_id": 1799,
    "vorder": 46,
    "position": 1,
    "text": "به چشم خرد جست راز جهان"
  },
  {
    "poem_id": 1799,
    "vorder": 47,
    "position": 0,
    "text": "خرد افسر شهریاران بود"
  },
  {
    "poem_id": 1799,
    "vorder": 48,
    "position": 1,
    "text": "همان زیور نامداران بود"
  },
  {
    "poem_id": 1799,
    "vorder": 49,
    "position": 0,
    "text": "بداند بد و نیک مرد خرد"
  },
  {
    "poem_id": 1799,
    "vorder": 50,
    "position": 1,
    "text": "بکوشد به داد و بپیچد ز بد"
  },
  {
    "poem_id": 1799,
    "vorder": 51,
    "position": 0,
    "text": "تو اندازهٔ خود ندانی همی"
  },
  {
    "poem_id": 1799,
    "vorder": 52,
    "position": 1,
    "text": "روان را به خون در نشانی همی"
  },
  {
    "poem_id": 1799,
    "vorder": 53,
    "position": 0,
    "text": "اگر تاجدار زمانه منم"
  },
  {
    "poem_id": 1799,
    "vorder": 54,
    "position": 1,
    "text": "به خوبی و زشتی بهانه منم"
  },
  {
    "poem_id": 1799,
    "vorder": 55,
    "position": 0,
    "text": "تو شاهی کنی کی بود راستی"
  },
  {
    "poem_id": 1799,
    "vorder": 56,
    "position": 1,
    "text": "پدید آید از هر سوی کاستی"
  },
  {
    "poem_id": 1799,
    "vorder": 57,
    "position": 0,
    "text": "نه آیین شاهان بود تاختن"
  },
  {
    "poem_id": 1799,
    "vorder": 58,
    "position": 1,
    "text": "چنین با بداندیشگان ساختن"
  },
  {
    "poem_id": 1799,
    "vorder": 59,
    "position": 0,
    "text": "نیای تو ما را پرستنده بود"
  },
  {
    "poem_id": 1799,
    "vorder": 60,
    "position": 1,
    "text": "پدر پیش شاهان ما بنده بود"
  },
  {
    "poem_id": 1799,
    "vorder": 61,
    "position": 0,
    "text": "کس از ما نبودند همداستان"
  },
  {
    "poem_id": 1799,
    "vorder": 62,
    "position": 1,
    "text": "که دیر آمدی باژ هندوستان"
  },
  {
    "poem_id": 1799,
    "vorder": 63,
    "position": 0,
    "text": "نگه کن کنون روز خاقان چین"
  },
  {
    "poem_id": 1799,
    "vorder": 64,
    "position": 1,
    "text": "که از چین بیامد به ایران زمین"
  },
  {
    "poem_id": 1799,
    "vorder": 65,
    "position": 0,
    "text": "به تاراج داد آنک آورده بود"
  },
  {
    "poem_id": 1799,
    "vorder": 66,
    "position": 1,
    "text": "بپیچید زان بد که خود کرده بود"
  },
  {
    "poem_id": 1799,
    "vorder": 67,
    "position": 0,
    "text": "چنین هم همی بینم آیین تو"
  },
  {
    "poem_id": 1799,
    "vorder": 68,
    "position": 1,
    "text": "همان بخشش و فره دین تو"
  },
  {
    "poem_id": 1799,
    "vorder": 69,
    "position": 0,
    "text": "مرا ساز جنگست و هم خواسته"
  },
  {
    "poem_id": 1799,
    "vorder": 70,
    "position": 1,
    "text": "همان لشکر یکدل آراسته"
  },
  {
    "poem_id": 1799,
    "vorder": 71,
    "position": 0,
    "text": "ترا با دلیران من پای نیست"
  },
  {
    "poem_id": 1799,
    "vorder": 72,
    "position": 1,
    "text": "به هند اندرون لشکر آرای نیست"
  },
  {
    "poem_id": 1799,
    "vorder": 73,
    "position": 0,
    "text": "تو اندر گمانی ز نیروی خویش"
  },
  {
    "poem_id": 1799,
    "vorder": 74,
    "position": 1,
    "text": "همی پیش دریا بری جوی خویش"
  },
  {
    "poem_id": 1799,
    "vorder": 75,
    "position": 0,
    "text": "فرستادم اینک فرستاده‌ای"
  },
  {
    "poem_id": 1799,
    "vorder": 76,
    "position": 1,
    "text": "سخن‌گوی با دانش آزاده‌ای"
  },
  {
    "poem_id": 1799,
    "vorder": 77,
    "position": 0,
    "text": "اگر باژ بفرست اگر جنگ را"
  },
  {
    "poem_id": 1799,
    "vorder": 78,
    "position": 1,
    "text": "به بی‌دانشی سخت کن تنگ را"
  },
  {
    "poem_id": 1799,
    "vorder": 79,
    "position": 0,
    "text": "ز ما باد بر جان آنکس درود"
  },
  {
    "poem_id": 1799,
    "vorder": 80,
    "position": 1,
    "text": "که داد و خرد باشدش تار و پود"
  },
  {
    "poem_id": 1799,
    "vorder": 81,
    "position": 0,
    "text": "چو خط از نسیم هوا گشت خشک"
  },
  {
    "poem_id": 1799,
    "vorder": 82,
    "position": 1,
    "text": "نوشتند و بر وی پراگند مشک"
  },
  {
    "poem_id": 1799,
    "vorder": 83,
    "position": 0,
    "text": "به عنوانش بر نام بهرام کرد"
  },
  {
    "poem_id": 1799,
    "vorder": 84,
    "position": 1,
    "text": "که دادش سر هر بدی رام کرد"
  },
  {
    "poem_id": 1799,
    "vorder": 85,
    "position": 0,
    "text": "که تاج کیان یافت از یزدگرد"
  },
  {
    "poem_id": 1799,
    "vorder": 86,
    "position": 1,
    "text": "به خرداد ماه اندرون روز ارد"
  },
  {
    "poem_id": 1799,
    "vorder": 87,
    "position": 0,
    "text": "سپهدار مرز و نگهدار بوم"
  },
  {
    "poem_id": 1799,
    "vorder": 88,
    "position": 1,
    "text": "ستانندهٔ باژ سقلاب و روم"
  },
  {
    "poem_id": 1799,
    "vorder": 89,
    "position": 0,
    "text": "به نزدیک شنگل نگهبان هند"
  },
  {
    "poem_id": 1799,
    "vorder": 90,
    "position": 1,
    "text": "ز دریای قنوج تا مرز سند"
  }
]