[
  {
    "poem_id": 1793,
    "vorder": 1,
    "position": 0,
    "text": "چو شد ساخته کار آتشکده"
  },
  {
    "poem_id": 1793,
    "vorder": 2,
    "position": 1,
    "text": "همان جای نوروز و جشن سده"
  },
  {
    "poem_id": 1793,
    "vorder": 3,
    "position": 0,
    "text": "بیامد سوی آذرآبادگان"
  },
  {
    "poem_id": 1793,
    "vorder": 4,
    "position": 1,
    "text": "خود و نامداران و آزادگان"
  },
  {
    "poem_id": 1793,
    "vorder": 5,
    "position": 0,
    "text": "پرستندگان پیش آذر شدند"
  },
  {
    "poem_id": 1793,
    "vorder": 6,
    "position": 1,
    "text": "همه موبدان دست بر سر شدند"
  },
  {
    "poem_id": 1793,
    "vorder": 7,
    "position": 0,
    "text": "پرستندگان را ببخشید چیز"
  },
  {
    "poem_id": 1793,
    "vorder": 8,
    "position": 1,
    "text": "وز آتشکده روی بنهاد تیز"
  },
  {
    "poem_id": 1793,
    "vorder": 9,
    "position": 0,
    "text": "خرامان بیامد به شهر صطخر"
  },
  {
    "poem_id": 1793,
    "vorder": 10,
    "position": 1,
    "text": "که شاهنشهان را بدان بود فخر"
  },
  {
    "poem_id": 1793,
    "vorder": 11,
    "position": 0,
    "text": "پراگنده از چرم گاوان میش"
  },
  {
    "poem_id": 1793,
    "vorder": 12,
    "position": 1,
    "text": "که بر پشت پیلان همی راند پیش"
  },
  {
    "poem_id": 1793,
    "vorder": 13,
    "position": 0,
    "text": "هزار و صد و شست قنطار بود"
  },
  {
    "poem_id": 1793,
    "vorder": 14,
    "position": 1,
    "text": "درم بو ازو نیز و دینار بود"
  },
  {
    "poem_id": 1793,
    "vorder": 15,
    "position": 0,
    "text": "که بر پهلوی موبد پارسی"
  },
  {
    "poem_id": 1793,
    "vorder": 16,
    "position": 1,
    "text": "همی نام بردیش پیداوسی"
  },
  {
    "poem_id": 1793,
    "vorder": 17,
    "position": 0,
    "text": "بیاورد پس مشکهای ادیم"
  },
  {
    "poem_id": 1793,
    "vorder": 18,
    "position": 1,
    "text": "بگسترد و شادان برو ریخت سیم"
  },
  {
    "poem_id": 1793,
    "vorder": 19,
    "position": 0,
    "text": "به ره بر هران پل که ویران بدید"
  },
  {
    "poem_id": 1793,
    "vorder": 20,
    "position": 1,
    "text": "رباطی که از کاروانان شنید"
  },
  {
    "poem_id": 1793,
    "vorder": 21,
    "position": 0,
    "text": "ز گیتی دگر هرکه درویش بود"
  },
  {
    "poem_id": 1793,
    "vorder": 22,
    "position": 1,
    "text": "وگر نانش از کوشش خویش بود"
  },
  {
    "poem_id": 1793,
    "vorder": 23,
    "position": 0,
    "text": "سدیگر به کپان بسختید سیم"
  },
  {
    "poem_id": 1793,
    "vorder": 24,
    "position": 1,
    "text": "زن بیوه و کودکان یتیم"
  },
  {
    "poem_id": 1793,
    "vorder": 25,
    "position": 0,
    "text": "چهارم هران پیر کز کارکرد"
  },
  {
    "poem_id": 1793,
    "vorder": 26,
    "position": 1,
    "text": "فروماند وز روز ننگ و نبرد"
  },
  {
    "poem_id": 1793,
    "vorder": 27,
    "position": 0,
    "text": "به پنجم هرانکس که بد با نژاد"
  },
  {
    "poem_id": 1793,
    "vorder": 28,
    "position": 1,
    "text": "توانگر نکردی ازو هیچ یاد"
  },
  {
    "poem_id": 1793,
    "vorder": 29,
    "position": 0,
    "text": "ششم هرکه آمد ز راه دراز"
  },
  {
    "poem_id": 1793,
    "vorder": 30,
    "position": 1,
    "text": "همی داشت درویشی خویش راز"
  },
  {
    "poem_id": 1793,
    "vorder": 31,
    "position": 0,
    "text": "بدیشان ببخشید چندین درم"
  },
  {
    "poem_id": 1793,
    "vorder": 32,
    "position": 1,
    "text": "نبد شاه روزی ز بخشش دژم"
  },
  {
    "poem_id": 1793,
    "vorder": 33,
    "position": 0,
    "text": "غنیمت همه بهر لشکر نهاد"
  },
  {
    "poem_id": 1793,
    "vorder": 34,
    "position": 1,
    "text": "نیامدش از آگندن گنج باد"
  },
  {
    "poem_id": 1793,
    "vorder": 35,
    "position": 0,
    "text": "بفرمود پس تاج خاقان چین"
  },
  {
    "poem_id": 1793,
    "vorder": 36,
    "position": 1,
    "text": "که پیش آورد مردم پاک‌دین"
  },
  {
    "poem_id": 1793,
    "vorder": 37,
    "position": 0,
    "text": "گهرها که بود اندرو آژده"
  },
  {
    "poem_id": 1793,
    "vorder": 38,
    "position": 1,
    "text": "بکندند و دیوار آتشکده"
  },
  {
    "poem_id": 1793,
    "vorder": 39,
    "position": 0,
    "text": "به زر و به گوهر بیاراستند"
  },
  {
    "poem_id": 1793,
    "vorder": 40,
    "position": 1,
    "text": "سر تخت آذر بپیراستند"
  },
  {
    "poem_id": 1793,
    "vorder": 41,
    "position": 0,
    "text": "وزان جایگه شد سوی طیسفون"
  },
  {
    "poem_id": 1793,
    "vorder": 42,
    "position": 1,
    "text": "که نرسی بد و موبد رهنمون"
  },
  {
    "poem_id": 1793,
    "vorder": 43,
    "position": 0,
    "text": "پذیره شدندش همه مهتران"
  },
  {
    "poem_id": 1793,
    "vorder": 44,
    "position": 1,
    "text": "بزرگان ایران و کنداوران"
  },
  {
    "poem_id": 1793,
    "vorder": 45,
    "position": 0,
    "text": "چو نرسی بدید آن سر و تاج شاه"
  },
  {
    "poem_id": 1793,
    "vorder": 46,
    "position": 1,
    "text": "درفش دلفروز و چندان سپاه"
  },
  {
    "poem_id": 1793,
    "vorder": 47,
    "position": 0,
    "text": "پیاده شد و برد پیشش نماز"
  },
  {
    "poem_id": 1793,
    "vorder": 48,
    "position": 1,
    "text": "بزرگان و هم موبد سرفراز"
  },
  {
    "poem_id": 1793,
    "vorder": 49,
    "position": 0,
    "text": "بفرمود بهرام تا برنشست"
  },
  {
    "poem_id": 1793,
    "vorder": 50,
    "position": 1,
    "text": "گرفت آن زمان دست او را به دست"
  },
  {
    "poem_id": 1793,
    "vorder": 51,
    "position": 0,
    "text": "بیامد نشست از بر تخت زر"
  },
  {
    "poem_id": 1793,
    "vorder": 52,
    "position": 1,
    "text": "بزرگان به پیش اندرون با کمر"
  },
  {
    "poem_id": 1793,
    "vorder": 53,
    "position": 0,
    "text": "ببخشید گنجی به مرد نیاز"
  },
  {
    "poem_id": 1793,
    "vorder": 54,
    "position": 1,
    "text": "در تنگ زندان گشادند باز"
  },
  {
    "poem_id": 1793,
    "vorder": 55,
    "position": 0,
    "text": "زمانه پر از رامش و داد شد"
  },
  {
    "poem_id": 1793,
    "vorder": 56,
    "position": 1,
    "text": "دل غمگنان از غم آزاد شد"
  },
  {
    "poem_id": 1793,
    "vorder": 57,
    "position": 0,
    "text": "ز هر کشوری رنج و غم دور کرد"
  },
  {
    "poem_id": 1793,
    "vorder": 58,
    "position": 1,
    "text": "ز بهر بزرگان یکی سور کرد"
  },
  {
    "poem_id": 1793,
    "vorder": 59,
    "position": 0,
    "text": "بدان سور هرکس که بشتافتی"
  },
  {
    "poem_id": 1793,
    "vorder": 60,
    "position": 1,
    "text": "همه خلعت مهتری یافتی"
  }
]