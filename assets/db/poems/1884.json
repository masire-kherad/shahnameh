[
  {
    "poem_id": 1884,
    "vorder": 1,
    "position": 0,
    "text": "چوخراد برزین به خسرو رسید"
  },
  {
    "poem_id": 1884,
    "vorder": 2,
    "position": 1,
    "text": "بگفت آن کجا کرد و دید و شنید"
  },
  {
    "poem_id": 1884,
    "vorder": 3,
    "position": 0,
    "text": "دل شاه پرویز ازان شاد شد"
  },
  {
    "poem_id": 1884,
    "vorder": 4,
    "position": 1,
    "text": "کزان بد گهر دشمن آزاد شد"
  },
  {
    "poem_id": 1884,
    "vorder": 5,
    "position": 0,
    "text": "به درویش بخشید چندی درم"
  },
  {
    "poem_id": 1884,
    "vorder": 6,
    "position": 1,
    "text": "ز پوشیدنیها و از بیش وکم"
  },
  {
    "poem_id": 1884,
    "vorder": 7,
    "position": 0,
    "text": "بهر پادشاهی و خودکامه‌ای"
  },
  {
    "poem_id": 1884,
    "vorder": 8,
    "position": 1,
    "text": "نوشتند بر پهلوی نامه‌ای"
  },
  {
    "poem_id": 1884,
    "vorder": 9,
    "position": 0,
    "text": "که دارای دارنده یزدان چه کرد"
  },
  {
    "poem_id": 1884,
    "vorder": 10,
    "position": 1,
    "text": "ز دشمن چگونه برآورد گرد"
  },
  {
    "poem_id": 1884,
    "vorder": 11,
    "position": 0,
    "text": "به قیصر یکی نامه بنوشت شاه"
  },
  {
    "poem_id": 1884,
    "vorder": 12,
    "position": 1,
    "text": "چناچون بود درخور پیشگاه"
  },
  {
    "poem_id": 1884,
    "vorder": 13,
    "position": 0,
    "text": "به یک هفته مجلس بیاراستند"
  },
  {
    "poem_id": 1884,
    "vorder": 14,
    "position": 1,
    "text": "بهر برزنی رود و می‌خواستند"
  },
  {
    "poem_id": 1884,
    "vorder": 15,
    "position": 0,
    "text": "به آتشکده هم فرستاد چیز"
  },
  {
    "poem_id": 1884,
    "vorder": 16,
    "position": 1,
    "text": "بران موبدان خلعت افگند نیز"
  },
  {
    "poem_id": 1884,
    "vorder": 17,
    "position": 0,
    "text": "بخراد برزین چنین گفت شاه"
  },
  {
    "poem_id": 1884,
    "vorder": 18,
    "position": 1,
    "text": "که زیبد تو راگر دهم تاج و گاه"
  },
  {
    "poem_id": 1884,
    "vorder": 19,
    "position": 0,
    "text": "دهانش پر از گوهر شاهوار"
  },
  {
    "poem_id": 1884,
    "vorder": 20,
    "position": 1,
    "text": "بیاگند و دینار چون صد هزار"
  },
  {
    "poem_id": 1884,
    "vorder": 21,
    "position": 0,
    "text": "همی‌ریخت گنجور در پای اوی"
  },
  {
    "poem_id": 1884,
    "vorder": 22,
    "position": 1,
    "text": "برین گونه تا تنگ شد جای اوی"
  },
  {
    "poem_id": 1884,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت هرکس که پیچد ز راه"
  },
  {
    "poem_id": 1884,
    "vorder": 24,
    "position": 1,
    "text": "شود روز روشن برو بر سیاه"
  },
  {
    "poem_id": 1884,
    "vorder": 25,
    "position": 0,
    "text": "چو بهرام باشد به دشت نبرد"
  },
  {
    "poem_id": 1884,
    "vorder": 26,
    "position": 1,
    "text": "کزو ترک پیرش برآورد گرد"
  },
  {
    "poem_id": 1884,
    "vorder": 27,
    "position": 0,
    "text": "همه موبدان خواندند آفرین"
  },
  {
    "poem_id": 1884,
    "vorder": 28,
    "position": 1,
    "text": "که بی تو مبیناد کهتر زمین"
  },
  {
    "poem_id": 1884,
    "vorder": 29,
    "position": 0,
    "text": "چو بهرام باد آنک با مهر تو"
  },
  {
    "poem_id": 1884,
    "vorder": 30,
    "position": 1,
    "text": "نخواهد که رخشان بود چهر تو"
  }
]