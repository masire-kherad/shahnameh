[
  {
    "poem_id": 88027,
    "vorder": 1,
    "position": 0,
    "text": "چو گیو اندر آمد به پیش پدر"
  },
  {
    "poem_id": 88027,
    "vorder": 2,
    "position": 1,
    "text": "همی گفت پاسخ همه دربه در"
  },
  {
    "poem_id": 88027,
    "vorder": 3,
    "position": 0,
    "text": "به گودرز گفت اندر آور سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 4,
    "position": 1,
    "text": "به جایی که سازی همی رزمگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 5,
    "position": 0,
    "text": "که او را همی آشتی رای نیست"
  },
  {
    "poem_id": 88027,
    "vorder": 6,
    "position": 1,
    "text": "به دلش اندرون داد را جای نیست"
  },
  {
    "poem_id": 88027,
    "vorder": 7,
    "position": 0,
    "text": "ز هر گونه با او سخن راندم"
  },
  {
    "poem_id": 88027,
    "vorder": 8,
    "position": 1,
    "text": "همه هرچ گفتی بر او خواندم"
  },
  {
    "poem_id": 88027,
    "vorder": 9,
    "position": 0,
    "text": "چو آمد پدیدار از ایشان گناه"
  },
  {
    "poem_id": 88027,
    "vorder": 10,
    "position": 1,
    "text": "هیونی برافگند نزدیک شاه"
  },
  {
    "poem_id": 88027,
    "vorder": 11,
    "position": 0,
    "text": "که گودرز و گیو اندر آمد به جنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 12,
    "position": 1,
    "text": "سپه باید ایدر مرا بی درنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 13,
    "position": 0,
    "text": "سپاه آمد از نزد افراسیاب"
  },
  {
    "poem_id": 88027,
    "vorder": 14,
    "position": 1,
    "text": "چو ما بازگشتیم بگذاشت آب"
  },
  {
    "poem_id": 88027,
    "vorder": 15,
    "position": 0,
    "text": "کنون کینه را کوس بر پیل بست"
  },
  {
    "poem_id": 88027,
    "vorder": 16,
    "position": 1,
    "text": "همی جنگ ما را کند پیشدست"
  },
  {
    "poem_id": 88027,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت با گیو پس پهلوان"
  },
  {
    "poem_id": 88027,
    "vorder": 18,
    "position": 1,
    "text": "که پیران به سیری رسید از روان"
  },
  {
    "poem_id": 88027,
    "vorder": 19,
    "position": 0,
    "text": "همین داشتم چشم زان بد نهان"
  },
  {
    "poem_id": 88027,
    "vorder": 20,
    "position": 1,
    "text": "ولیکن به فرمان شاه جهان"
  },
  {
    "poem_id": 88027,
    "vorder": 21,
    "position": 0,
    "text": "ببایست رفتن که چاره نبود"
  },
  {
    "poem_id": 88027,
    "vorder": 22,
    "position": 1,
    "text": "دلش را کنون شهریار آزمود"
  },
  {
    "poem_id": 88027,
    "vorder": 23,
    "position": 0,
    "text": "یکی داستان گفته بودم به شاه"
  },
  {
    "poem_id": 88027,
    "vorder": 24,
    "position": 1,
    "text": "چو فرمود لشکر کشیدن به راه"
  },
  {
    "poem_id": 88027,
    "vorder": 25,
    "position": 0,
    "text": "که دل را ز مهر کسی برگسل"
  },
  {
    "poem_id": 88027,
    "vorder": 26,
    "position": 1,
    "text": "کجا نیستش با زبان راست دل"
  },
  {
    "poem_id": 88027,
    "vorder": 27,
    "position": 0,
    "text": "همه مهر پیران به ترکان بر است"
  },
  {
    "poem_id": 88027,
    "vorder": 28,
    "position": 1,
    "text": "بشوید همی شاه از او پاک دست"
  },
  {
    "poem_id": 88027,
    "vorder": 29,
    "position": 0,
    "text": "چو پیران سپاه از کنابد براند"
  },
  {
    "poem_id": 88027,
    "vorder": 30,
    "position": 1,
    "text": "به روز اندرون روشنایی نماند"
  },
  {
    "poem_id": 88027,
    "vorder": 31,
    "position": 0,
    "text": "سواران جوشن وران صد هزار"
  },
  {
    "poem_id": 88027,
    "vorder": 32,
    "position": 1,
    "text": "ز ترکان کمربستهٔ کارزار"
  },
  {
    "poem_id": 88027,
    "vorder": 33,
    "position": 0,
    "text": "برفتند بسته کمرها به جنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 34,
    "position": 1,
    "text": "همه نیزه و تیغ هندی به چنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 35,
    "position": 0,
    "text": "چو دانست گودرز کآمد سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 36,
    "position": 1,
    "text": "بزد کوس و آمد ز زیبد به راه"
  },
  {
    "poem_id": 88027,
    "vorder": 37,
    "position": 0,
    "text": "ز کوه اندر آمد به هامون گذشت"
  },
  {
    "poem_id": 88027,
    "vorder": 38,
    "position": 1,
    "text": "کشیدند لشکر بر آن پهن دشت"
  },
  {
    "poem_id": 88027,
    "vorder": 39,
    "position": 0,
    "text": "به کردار کوه از دو رویه سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 40,
    "position": 1,
    "text": "ز آهن به سر بر نهاده کلاه"
  },
  {
    "poem_id": 88027,
    "vorder": 41,
    "position": 0,
    "text": "برآمد خروشیدن کرنای"
  },
  {
    "poem_id": 88027,
    "vorder": 42,
    "position": 1,
    "text": "بجنبد همی کوه گفتی ز جای"
  },
  {
    "poem_id": 88027,
    "vorder": 43,
    "position": 0,
    "text": "ز زیبد همی تا کنابد سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 44,
    "position": 1,
    "text": "در و دشت از ایشان کبود و سیاه"
  },
  {
    "poem_id": 88027,
    "vorder": 45,
    "position": 0,
    "text": "ز گرد سپه روز روشن نماند"
  },
  {
    "poem_id": 88027,
    "vorder": 46,
    "position": 1,
    "text": "ز نیزه هوا جز به جوشن نماند"
  },
  {
    "poem_id": 88027,
    "vorder": 47,
    "position": 0,
    "text": "وز آواز اسبان و گرد سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 48,
    "position": 1,
    "text": "بشد روشنایی ز خورشید و ماه"
  },
  {
    "poem_id": 88027,
    "vorder": 49,
    "position": 0,
    "text": "ستاره سنان بود و خورشید تیغ"
  },
  {
    "poem_id": 88027,
    "vorder": 50,
    "position": 1,
    "text": "از آهن زمین بود ، وز گرز میغ"
  },
  {
    "poem_id": 88027,
    "vorder": 51,
    "position": 0,
    "text": "بتوفید از آواز گردان زمین"
  },
  {
    "poem_id": 88027,
    "vorder": 52,
    "position": 1,
    "text": "ز ترگ و سنان آسمان آهنین"
  },
  {
    "poem_id": 88027,
    "vorder": 53,
    "position": 0,
    "text": "چو گودرز ، توران سپه را بدید"
  },
  {
    "poem_id": 88027,
    "vorder": 54,
    "position": 1,
    "text": "که بر سان دریا زمین بردمید"
  },
  {
    "poem_id": 88027,
    "vorder": 55,
    "position": 0,
    "text": "درفش از درفش و گروه از گروه"
  },
  {
    "poem_id": 88027,
    "vorder": 56,
    "position": 1,
    "text": "گسسته نشد شب برآمد ز کوه"
  },
  {
    "poem_id": 88027,
    "vorder": 57,
    "position": 0,
    "text": "چو شب تیره شد پیل پیش سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 58,
    "position": 1,
    "text": "فراز آوریدند و بستند راه"
  },
  {
    "poem_id": 88027,
    "vorder": 59,
    "position": 0,
    "text": "برافروختند آتش از هردو روی"
  },
  {
    "poem_id": 88027,
    "vorder": 60,
    "position": 1,
    "text": "از آواز گردان پرخاشجوی"
  },
  {
    "poem_id": 88027,
    "vorder": 61,
    "position": 0,
    "text": "جهان سربه سر گفتی آهرمنست"
  },
  {
    "poem_id": 88027,
    "vorder": 62,
    "position": 1,
    "text": "به دامن بر از آستین دشمنست"
  },
  {
    "poem_id": 88027,
    "vorder": 63,
    "position": 0,
    "text": "ز بانگ تبیره به سنگ اندرون"
  },
  {
    "poem_id": 88027,
    "vorder": 64,
    "position": 1,
    "text": "به درد دل اندر شب قیر گون"
  },
  {
    "poem_id": 88027,
    "vorder": 65,
    "position": 0,
    "text": "سپیده برآمد ز کوه سیاه"
  },
  {
    "poem_id": 88027,
    "vorder": 66,
    "position": 1,
    "text": "سپهدار ایران به پیش سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 67,
    "position": 0,
    "text": "به آسوده اسب اندر آورد پای"
  },
  {
    "poem_id": 88027,
    "vorder": 68,
    "position": 1,
    "text": "یلان را به هر سو همی ساخت جای"
  },
  {
    "poem_id": 88027,
    "vorder": 69,
    "position": 0,
    "text": "سپه را سوی میمنه کوه بود"
  },
  {
    "poem_id": 88027,
    "vorder": 70,
    "position": 1,
    "text": "ز جنگ دلیران بی‌اندوه بود"
  },
  {
    "poem_id": 88027,
    "vorder": 71,
    "position": 0,
    "text": "سوی میسره رود آب روان"
  },
  {
    "poem_id": 88027,
    "vorder": 72,
    "position": 1,
    "text": "چنان در خور آمد چو تن را روان"
  },
  {
    "poem_id": 88027,
    "vorder": 73,
    "position": 0,
    "text": "پیاده که اندر خور کارزار"
  },
  {
    "poem_id": 88027,
    "vorder": 74,
    "position": 1,
    "text": "بفرمود تا پیش روی سوار"
  },
  {
    "poem_id": 88027,
    "vorder": 75,
    "position": 0,
    "text": "صفی بر کشیدند نیزه‌وران"
  },
  {
    "poem_id": 88027,
    "vorder": 76,
    "position": 1,
    "text": "ابا گرزداران و کنداوران"
  },
  {
    "poem_id": 88027,
    "vorder": 77,
    "position": 0,
    "text": "همیدون پیاده بسی نیزه‌دار"
  },
  {
    "poem_id": 88027,
    "vorder": 78,
    "position": 1,
    "text": "چه با ترکش و تیر و جوشن‌گذار"
  },
  {
    "poem_id": 88027,
    "vorder": 79,
    "position": 0,
    "text": "کمانها فگنده به بازو درون"
  },
  {
    "poem_id": 88027,
    "vorder": 80,
    "position": 1,
    "text": "همی از جگرشان بجوشید خون"
  },
  {
    "poem_id": 88027,
    "vorder": 81,
    "position": 0,
    "text": "پس پشت ایشان سواران جنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 82,
    "position": 1,
    "text": "کز آتش به خنجر ببردند رنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 83,
    "position": 0,
    "text": "پس پشت لشکر ز پیلان گروه"
  },
  {
    "poem_id": 88027,
    "vorder": 84,
    "position": 1,
    "text": "زمین از پی پیل گشته ستوه"
  },
  {
    "poem_id": 88027,
    "vorder": 85,
    "position": 0,
    "text": "درفش خجسته میان سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 86,
    "position": 1,
    "text": "ز گوهر درفشان به کردار ماه"
  },
  {
    "poem_id": 88027,
    "vorder": 87,
    "position": 0,
    "text": "ز پیلان زمین سربه سر پیلگون"
  },
  {
    "poem_id": 88027,
    "vorder": 88,
    "position": 1,
    "text": "ز گرد سواران هوا نیلگون"
  },
  {
    "poem_id": 88027,
    "vorder": 89,
    "position": 0,
    "text": "درخشیدن تیغهای بنفش"
  },
  {
    "poem_id": 88027,
    "vorder": 90,
    "position": 1,
    "text": "از آن سایهٔ کاویانی درفش"
  },
  {
    "poem_id": 88027,
    "vorder": 91,
    "position": 0,
    "text": "تو گفتی که اندر شب تیره‌چهر"
  },
  {
    "poem_id": 88027,
    "vorder": 92,
    "position": 1,
    "text": "ستاره همی برفشاند سپهر"
  },
  {
    "poem_id": 88027,
    "vorder": 93,
    "position": 0,
    "text": "بیاراست لشکر به سان بهشت"
  },
  {
    "poem_id": 88027,
    "vorder": 94,
    "position": 1,
    "text": "به باغ وفا سرو کینه بکشت"
  },
  {
    "poem_id": 88027,
    "vorder": 95,
    "position": 0,
    "text": "فریبزر را داد پس میمنه"
  },
  {
    "poem_id": 88027,
    "vorder": 96,
    "position": 1,
    "text": "پس پشت لشکر حصار و بنه"
  },
  {
    "poem_id": 88027,
    "vorder": 97,
    "position": 0,
    "text": "گرازه سر تخمهٔ گیوگان"
  },
  {
    "poem_id": 88027,
    "vorder": 98,
    "position": 1,
    "text": "زواره نگهدار تخت کیان"
  },
  {
    "poem_id": 88027,
    "vorder": 99,
    "position": 0,
    "text": "به یاری فریبرز برخاستند"
  },
  {
    "poem_id": 88027,
    "vorder": 100,
    "position": 1,
    "text": "به یک روی لشکر بیاراستند"
  },
  {
    "poem_id": 88027,
    "vorder": 101,
    "position": 0,
    "text": "به رهام فرمود پس پهلوان"
  },
  {
    "poem_id": 88027,
    "vorder": 102,
    "position": 1,
    "text": "که ای تاج و تخت و خرد را روان"
  },
  {
    "poem_id": 88027,
    "vorder": 103,
    "position": 0,
    "text": "برو با سواران سوی میسره"
  },
  {
    "poem_id": 88027,
    "vorder": 104,
    "position": 1,
    "text": "نگه‌دار چنگال گرگ از بره"
  },
  {
    "poem_id": 88027,
    "vorder": 105,
    "position": 0,
    "text": "بیفروز لشکرگه از فر خویش"
  },
  {
    "poem_id": 88027,
    "vorder": 106,
    "position": 1,
    "text": "سپه را همی دار در بر خویش"
  },
  {
    "poem_id": 88027,
    "vorder": 107,
    "position": 0,
    "text": "بدان آبگون خنجر نیو سوز"
  },
  {
    "poem_id": 88027,
    "vorder": 108,
    "position": 1,
    "text": "چو شیر ژیان با یلان رزم توز"
  },
  {
    "poem_id": 88027,
    "vorder": 109,
    "position": 0,
    "text": "برفتند یارانش با او به هم"
  },
  {
    "poem_id": 88027,
    "vorder": 110,
    "position": 1,
    "text": "ز گردان لشکر یکی گستهم"
  },
  {
    "poem_id": 88027,
    "vorder": 111,
    "position": 0,
    "text": "دگر گژدهم رزم را ناگزیر"
  },
  {
    "poem_id": 88027,
    "vorder": 112,
    "position": 1,
    "text": "فروهل که بگذارد از سنگ تیر"
  },
  {
    "poem_id": 88027,
    "vorder": 113,
    "position": 0,
    "text": "بفرمود با گیو تا دو هزار"
  },
  {
    "poem_id": 88027,
    "vorder": 114,
    "position": 1,
    "text": "برفتند برگستوان‌ور سوار"
  },
  {
    "poem_id": 88027,
    "vorder": 115,
    "position": 0,
    "text": "سپرد آن زمان پشت لشکر بدوی"
  },
  {
    "poem_id": 88027,
    "vorder": 116,
    "position": 1,
    "text": "که بد جای گردان پرخاشجوی"
  },
  {
    "poem_id": 88027,
    "vorder": 117,
    "position": 0,
    "text": "برفتند با گیو جنگاوران"
  },
  {
    "poem_id": 88027,
    "vorder": 118,
    "position": 1,
    "text": "چو گرگین و چون زنگهٔ شاوران"
  },
  {
    "poem_id": 88027,
    "vorder": 119,
    "position": 0,
    "text": "درفشی فرستاد و سیصد سوار"
  },
  {
    "poem_id": 88027,
    "vorder": 120,
    "position": 1,
    "text": "نگهبان لشکر سوی رودبار"
  },
  {
    "poem_id": 88027,
    "vorder": 121,
    "position": 0,
    "text": "همیدون فرستاد بر سوی کوه"
  },
  {
    "poem_id": 88027,
    "vorder": 122,
    "position": 1,
    "text": "درفشی و سیصد ز گردان گروه"
  },
  {
    "poem_id": 88027,
    "vorder": 123,
    "position": 0,
    "text": "یکی دیده‌بان بر سر کوهسار"
  },
  {
    "poem_id": 88027,
    "vorder": 124,
    "position": 1,
    "text": "نگهبان روز و ستاره شمار"
  },
  {
    "poem_id": 88027,
    "vorder": 125,
    "position": 0,
    "text": "شب و روز گردن برافراخته"
  },
  {
    "poem_id": 88027,
    "vorder": 126,
    "position": 1,
    "text": "از آن دیده‌گه دیده‌بان ساخته"
  },
  {
    "poem_id": 88027,
    "vorder": 127,
    "position": 0,
    "text": "بجستی همی تا ز توران سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 128,
    "position": 1,
    "text": "پی مور دیدی نهاده به راه"
  },
  {
    "poem_id": 88027,
    "vorder": 129,
    "position": 0,
    "text": "ز دیده خروشیدن آراستی"
  },
  {
    "poem_id": 88027,
    "vorder": 130,
    "position": 1,
    "text": "بگفتی به گودرز و برخاستی"
  },
  {
    "poem_id": 88027,
    "vorder": 131,
    "position": 0,
    "text": "بدان سان بیاراست آن رزمگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 132,
    "position": 1,
    "text": "که رزم آرزو کرد خورشید و ماه"
  },
  {
    "poem_id": 88027,
    "vorder": 133,
    "position": 0,
    "text": "چو سالار شایسته باشد به جنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 134,
    "position": 1,
    "text": "نترسد سپاه از دلاور نهنگ"
  },
  {
    "poem_id": 88027,
    "vorder": 135,
    "position": 0,
    "text": "از آن پس بیامد به سالارگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 136,
    "position": 1,
    "text": "که دارد سپه را ز دشمن نگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 137,
    "position": 0,
    "text": "درفش دلفروز بر پای کرد"
  },
  {
    "poem_id": 88027,
    "vorder": 138,
    "position": 1,
    "text": "سپه را به قلب اندرون جای کرد"
  },
  {
    "poem_id": 88027,
    "vorder": 139,
    "position": 0,
    "text": "سران را همه خواند نزدیک خویش"
  },
  {
    "poem_id": 88027,
    "vorder": 140,
    "position": 1,
    "text": "پس پشت شیدوش ، و فرهاد پیش"
  },
  {
    "poem_id": 88027,
    "vorder": 141,
    "position": 0,
    "text": "به دست چپش رزم‌دیده هجیر"
  },
  {
    "poem_id": 88027,
    "vorder": 142,
    "position": 1,
    "text": "سوی راست کتمارهٔ شیرگیر"
  },
  {
    "poem_id": 88027,
    "vorder": 143,
    "position": 0,
    "text": "ببستند ز آهن به گردش سرای"
  },
  {
    "poem_id": 88027,
    "vorder": 144,
    "position": 1,
    "text": "پس پشت ، پیلان جنگی به پای"
  },
  {
    "poem_id": 88027,
    "vorder": 145,
    "position": 0,
    "text": "سپهدار گودرزشان در میان"
  },
  {
    "poem_id": 88027,
    "vorder": 146,
    "position": 1,
    "text": "درفش از برش سایهٔ کاویان"
  },
  {
    "poem_id": 88027,
    "vorder": 147,
    "position": 0,
    "text": "همی بستد از ماه و خورشید نور"
  },
  {
    "poem_id": 88027,
    "vorder": 148,
    "position": 1,
    "text": "نگه کرد پیران به لشکر ز دور"
  },
  {
    "poem_id": 88027,
    "vorder": 149,
    "position": 0,
    "text": "بدان ساز و آن لشکر آراستن"
  },
  {
    "poem_id": 88027,
    "vorder": 150,
    "position": 1,
    "text": "دل از ننگ و تیمار پیراستن"
  },
  {
    "poem_id": 88027,
    "vorder": 151,
    "position": 0,
    "text": "در و دشت و کوه و بیابان سنان"
  },
  {
    "poem_id": 88027,
    "vorder": 152,
    "position": 1,
    "text": "عنان بافته سر به سر با عنان"
  },
  {
    "poem_id": 88027,
    "vorder": 153,
    "position": 0,
    "text": "سپهدار پیران غمی گشت سخت"
  },
  {
    "poem_id": 88027,
    "vorder": 154,
    "position": 1,
    "text": "برآشفت با تیره خورشید بخت"
  },
  {
    "poem_id": 88027,
    "vorder": 155,
    "position": 0,
    "text": "از آن پس نگه کرد جای سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 156,
    "position": 1,
    "text": "نیامدش بر آرزو رزمگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 157,
    "position": 0,
    "text": "نه آوردگه دید و نه جای صف"
  },
  {
    "poem_id": 88027,
    "vorder": 158,
    "position": 1,
    "text": "همی بر زد از خشم کف را به کف"
  },
  {
    "poem_id": 88027,
    "vorder": 159,
    "position": 0,
    "text": "بر این گونه کآمد ببایست ساخت"
  },
  {
    "poem_id": 88027,
    "vorder": 160,
    "position": 1,
    "text": "چو سوی یلان چنگ بایست آخت"
  },
  {
    "poem_id": 88027,
    "vorder": 161,
    "position": 0,
    "text": "پس از نامداران افراسیاب"
  },
  {
    "poem_id": 88027,
    "vorder": 162,
    "position": 1,
    "text": "کسی کش سر از کینه گیرد شتاب"
  },
  {
    "poem_id": 88027,
    "vorder": 163,
    "position": 0,
    "text": "گزین کرد شمشیرزن سی‌هزار"
  },
  {
    "poem_id": 88027,
    "vorder": 164,
    "position": 1,
    "text": "که بودند شایستهٔ کارزار"
  },
  {
    "poem_id": 88027,
    "vorder": 165,
    "position": 0,
    "text": "به هومان سپرد آن زمان قلبگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 166,
    "position": 1,
    "text": "سپاهی هژبر اوژن و رزمخواه"
  },
  {
    "poem_id": 88027,
    "vorder": 167,
    "position": 0,
    "text": "بخواند اندریمان و او خواست را"
  },
  {
    "poem_id": 88027,
    "vorder": 168,
    "position": 1,
    "text": "نهاد چپ لشکر و راست را"
  },
  {
    "poem_id": 88027,
    "vorder": 169,
    "position": 0,
    "text": "چپ لشکرش را بدیشان سپرد"
  },
  {
    "poem_id": 88027,
    "vorder": 170,
    "position": 1,
    "text": "ابا سی‌هزار از دلیران گرد"
  },
  {
    "poem_id": 88027,
    "vorder": 171,
    "position": 0,
    "text": "چو لهاک جنگی و فرشیدورد"
  },
  {
    "poem_id": 88027,
    "vorder": 172,
    "position": 1,
    "text": "ابا سی‌هزار از دلیران مرد"
  },
  {
    "poem_id": 88027,
    "vorder": 173,
    "position": 0,
    "text": "گرفتند بر میمنه جایگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 174,
    "position": 1,
    "text": "جهان سر به سر گشت ز آهن سیاه"
  },
  {
    "poem_id": 88027,
    "vorder": 175,
    "position": 0,
    "text": "چو زنگولهٔ گرد و کلباد را"
  },
  {
    "poem_id": 88027,
    "vorder": 176,
    "position": 1,
    "text": "سپهرم که بد روز فریاد را"
  },
  {
    "poem_id": 88027,
    "vorder": 177,
    "position": 0,
    "text": "برفتند با نیزه‌ور ده هزار"
  },
  {
    "poem_id": 88027,
    "vorder": 178,
    "position": 1,
    "text": "به پشت سواران خنجرگزار"
  },
  {
    "poem_id": 88027,
    "vorder": 179,
    "position": 0,
    "text": "برون رفت رویین رویینه‌تن"
  },
  {
    "poem_id": 88027,
    "vorder": 180,
    "position": 1,
    "text": "ابا ده هزار از یلان ختن"
  },
  {
    "poem_id": 88027,
    "vorder": 181,
    "position": 0,
    "text": "بدان تا دران بیشه اندر چو شیر"
  },
  {
    "poem_id": 88027,
    "vorder": 182,
    "position": 1,
    "text": "کمینگه کند با یلان دلیر"
  },
  {
    "poem_id": 88027,
    "vorder": 183,
    "position": 0,
    "text": "طلایه فرستاد بر سوی کوه"
  },
  {
    "poem_id": 88027,
    "vorder": 184,
    "position": 1,
    "text": "سپهدار ایران شود زو ستوه"
  },
  {
    "poem_id": 88027,
    "vorder": 185,
    "position": 0,
    "text": "گر از رزمگه پی نهد پیشتر"
  },
  {
    "poem_id": 88027,
    "vorder": 186,
    "position": 1,
    "text": "وگر جنبد از خویشتن بیشتر"
  },
  {
    "poem_id": 88027,
    "vorder": 187,
    "position": 0,
    "text": "سپهدار رویین به کردار شیر"
  },
  {
    "poem_id": 88027,
    "vorder": 188,
    "position": 1,
    "text": "پس پشت او اندر آید دلیر"
  },
  {
    "poem_id": 88027,
    "vorder": 189,
    "position": 0,
    "text": "همان دیده‌بان بر سر کوه کرد"
  },
  {
    "poem_id": 88027,
    "vorder": 190,
    "position": 1,
    "text": "که جنگ سواران بی‌اندوه کرد"
  },
  {
    "poem_id": 88027,
    "vorder": 191,
    "position": 0,
    "text": "ز ایرانیان گر سواری ز دور"
  },
  {
    "poem_id": 88027,
    "vorder": 192,
    "position": 1,
    "text": "عنان تافتی سوی پیکار تور"
  },
  {
    "poem_id": 88027,
    "vorder": 193,
    "position": 0,
    "text": "نگهبان دیده گرفتی خروش"
  },
  {
    "poem_id": 88027,
    "vorder": 194,
    "position": 1,
    "text": "همه رزمگاه آمدی زو به جوش"
  },
  {
    "poem_id": 88027,
    "vorder": 195,
    "position": 0,
    "text": "دو لشکر به روی اندر آورد روی"
  },
  {
    "poem_id": 88027,
    "vorder": 196,
    "position": 1,
    "text": "همه نامداران پرخاشجوی"
  },
  {
    "poem_id": 88027,
    "vorder": 197,
    "position": 0,
    "text": "چنین ایستاده سه روز و سه شب"
  },
  {
    "poem_id": 88027,
    "vorder": 198,
    "position": 1,
    "text": "یکی را به گفتن نجنبید لب"
  },
  {
    "poem_id": 88027,
    "vorder": 199,
    "position": 0,
    "text": "همی گفت گودرز گر پشت خویش"
  },
  {
    "poem_id": 88027,
    "vorder": 200,
    "position": 1,
    "text": "سپارم بدیشان نهم پای پیش"
  },
  {
    "poem_id": 88027,
    "vorder": 201,
    "position": 0,
    "text": "سپاه اندر آید پس پشت من"
  },
  {
    "poem_id": 88027,
    "vorder": 202,
    "position": 1,
    "text": "نماند جز از باد در مشت من"
  },
  {
    "poem_id": 88027,
    "vorder": 203,
    "position": 0,
    "text": "شب و روز بر پای پیش سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 204,
    "position": 1,
    "text": "همی جست نیک اختر هور و ماه"
  },
  {
    "poem_id": 88027,
    "vorder": 205,
    "position": 0,
    "text": "که روزی که آن روز نیک‌اخترست"
  },
  {
    "poem_id": 88027,
    "vorder": 206,
    "position": 1,
    "text": "کدامست و جنبش که را بهترست"
  },
  {
    "poem_id": 88027,
    "vorder": 207,
    "position": 0,
    "text": "کجا بردمد باد روز نبرد"
  },
  {
    "poem_id": 88027,
    "vorder": 208,
    "position": 1,
    "text": "که چشم سواران بپوشد به گرد"
  },
  {
    "poem_id": 88027,
    "vorder": 209,
    "position": 0,
    "text": "بریشان بیابم مگر دستگاه"
  },
  {
    "poem_id": 88027,
    "vorder": 210,
    "position": 1,
    "text": "به کردار باد اندر آرم سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 211,
    "position": 0,
    "text": "نهاده سپهدار پیران دو چشم"
  },
  {
    "poem_id": 88027,
    "vorder": 212,
    "position": 1,
    "text": "که گودرز را دل بجوشد ز خشم"
  },
  {
    "poem_id": 88027,
    "vorder": 213,
    "position": 0,
    "text": "کند پشت بر دشت و راند سپاه"
  },
  {
    "poem_id": 88027,
    "vorder": 214,
    "position": 1,
    "text": "سپاه اندر آرد به پشت سپاه"
  }
]