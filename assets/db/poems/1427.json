[
  {
    "poem_id": 1427,
    "vorder": 1,
    "position": 0,
    "text": "برفت از لب رود نزد پشنگ"
  },
  {
    "poem_id": 1427,
    "vorder": 2,
    "position": 1,
    "text": "زبان پر ز گفتار و کوتاه چنگ"
  },
  {
    "poem_id": 1427,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت کای نامبردار شاه"
  },
  {
    "poem_id": 1427,
    "vorder": 4,
    "position": 1,
    "text": "ترا بود ازین جنگ جستن گناه"
  },
  {
    "poem_id": 1427,
    "vorder": 5,
    "position": 0,
    "text": "یکی آنکه پیمان شکستن ز شاه"
  },
  {
    "poem_id": 1427,
    "vorder": 6,
    "position": 1,
    "text": "بزرگان پیشین ندیدند راه"
  },
  {
    "poem_id": 1427,
    "vorder": 7,
    "position": 0,
    "text": "نه از تخم ایرج جهان پاک شد"
  },
  {
    "poem_id": 1427,
    "vorder": 8,
    "position": 1,
    "text": "نه زهر گزاینده تریاک شد"
  },
  {
    "poem_id": 1427,
    "vorder": 9,
    "position": 0,
    "text": "یکی کم شود دیگر آید به جای"
  },
  {
    "poem_id": 1427,
    "vorder": 10,
    "position": 1,
    "text": "جهان را نمانند بی‌کدخدای"
  },
  {
    "poem_id": 1427,
    "vorder": 11,
    "position": 0,
    "text": "قباد آمد و تاج بر سر نهاد"
  },
  {
    "poem_id": 1427,
    "vorder": 12,
    "position": 1,
    "text": "به کینه یکی نو در اندر گشاد"
  },
  {
    "poem_id": 1427,
    "vorder": 13,
    "position": 0,
    "text": "سواری پدید آمد از تخم سام"
  },
  {
    "poem_id": 1427,
    "vorder": 14,
    "position": 1,
    "text": "که دستانش رستم نهاده‌ست نام"
  },
  {
    "poem_id": 1427,
    "vorder": 15,
    "position": 0,
    "text": "بیامد بسان نهنگ دژم"
  },
  {
    "poem_id": 1427,
    "vorder": 16,
    "position": 1,
    "text": "که گفتی زمین را بسوزد به دم"
  },
  {
    "poem_id": 1427,
    "vorder": 17,
    "position": 0,
    "text": "همی تاخت اندر فراز و نشیب"
  },
  {
    "poem_id": 1427,
    "vorder": 18,
    "position": 1,
    "text": "همی زد به گُرز و به تیغ و رکیب"
  },
  {
    "poem_id": 1427,
    "vorder": 19,
    "position": 0,
    "text": "ز گُرزش هوا شد پر از چاک چاک"
  },
  {
    "poem_id": 1427,
    "vorder": 20,
    "position": 1,
    "text": "نیرزید جانم به یک مشت خاک"
  },
  {
    "poem_id": 1427,
    "vorder": 21,
    "position": 0,
    "text": "همه لشکر ما به هم بردرید"
  },
  {
    "poem_id": 1427,
    "vorder": 22,
    "position": 1,
    "text": "کس اندر جهان این شگفتی ندید"
  },
  {
    "poem_id": 1427,
    "vorder": 23,
    "position": 0,
    "text": "درفش مرا دید بر یک کران"
  },
  {
    "poem_id": 1427,
    "vorder": 24,
    "position": 1,
    "text": "به زین اندر آورد گُرز گران"
  },
  {
    "poem_id": 1427,
    "vorder": 25,
    "position": 0,
    "text": "چنان برگرفتم ز زین خدنگ"
  },
  {
    "poem_id": 1427,
    "vorder": 26,
    "position": 1,
    "text": "که گفتی ندارم به یک پشه سنگ"
  },
  {
    "poem_id": 1427,
    "vorder": 27,
    "position": 0,
    "text": "کمربند بگسست و بند قبای"
  },
  {
    "poem_id": 1427,
    "vorder": 28,
    "position": 1,
    "text": "ز چنگش فتادم نگون زیر پای"
  },
  {
    "poem_id": 1427,
    "vorder": 29,
    "position": 0,
    "text": "بدان زور هرگز نباشد هژبر"
  },
  {
    "poem_id": 1427,
    "vorder": 30,
    "position": 1,
    "text": "دو پایش به خاک اندر و سر به ابر"
  },
  {
    "poem_id": 1427,
    "vorder": 31,
    "position": 0,
    "text": "سواران جنگی همه همگروه"
  },
  {
    "poem_id": 1427,
    "vorder": 32,
    "position": 1,
    "text": "کشیدندم از پیش آن لخت کوه"
  },
  {
    "poem_id": 1427,
    "vorder": 33,
    "position": 0,
    "text": "تو دانی که شاهی دل و چنگ من"
  },
  {
    "poem_id": 1427,
    "vorder": 34,
    "position": 1,
    "text": "به جنگ اندرون زور و آهنگ من"
  },
  {
    "poem_id": 1427,
    "vorder": 35,
    "position": 0,
    "text": "به دست وی اندر یکی پشه‌ام"
  },
  {
    "poem_id": 1427,
    "vorder": 36,
    "position": 1,
    "text": "وزان آفرینش پر اندیشه‌ام"
  },
  {
    "poem_id": 1427,
    "vorder": 37,
    "position": 0,
    "text": "یکی پیلتن دیدم و شیرچنگ"
  },
  {
    "poem_id": 1427,
    "vorder": 38,
    "position": 1,
    "text": "نه هوش و نه دانش نه رای و درنگ"
  },
  {
    "poem_id": 1427,
    "vorder": 39,
    "position": 0,
    "text": "عنان را سپرده بران پیل مست"
  },
  {
    "poem_id": 1427,
    "vorder": 40,
    "position": 1,
    "text": "یکی گُرزهٔ گاو‌پیکر بدست"
  },
  {
    "poem_id": 1427,
    "vorder": 41,
    "position": 0,
    "text": "همانا که کوپال سیصدهزار"
  },
  {
    "poem_id": 1427,
    "vorder": 42,
    "position": 1,
    "text": "زدندش بران تارک ترگ‌دار"
  },
  {
    "poem_id": 1427,
    "vorder": 43,
    "position": 0,
    "text": "تو گفتی که از آهنش کرده‌اند"
  },
  {
    "poem_id": 1427,
    "vorder": 44,
    "position": 1,
    "text": "ز سنگ و ز رویش برآورده‌اند"
  },
  {
    "poem_id": 1427,
    "vorder": 45,
    "position": 0,
    "text": "چه دریاش پیش و چه ببر بیان"
  },
  {
    "poem_id": 1427,
    "vorder": 46,
    "position": 1,
    "text": "چه درنده شیر و چه پیل ژیان"
  },
  {
    "poem_id": 1427,
    "vorder": 47,
    "position": 0,
    "text": "همی‌تاخت یکسان چو روز شکار"
  },
  {
    "poem_id": 1427,
    "vorder": 48,
    "position": 1,
    "text": "به بازی همی‌آمدش کارزار"
  },
  {
    "poem_id": 1427,
    "vorder": 49,
    "position": 0,
    "text": "چنو گر بدی سام را دستبرد"
  },
  {
    "poem_id": 1427,
    "vorder": 50,
    "position": 1,
    "text": "به ترکان نماندی سرافراز گرد"
  },
  {
    "poem_id": 1427,
    "vorder": 51,
    "position": 0,
    "text": "جز از آشتی جستنت رای نیست"
  },
  {
    "poem_id": 1427,
    "vorder": 52,
    "position": 1,
    "text": "که با او سپاه ترا پای نیست"
  },
  {
    "poem_id": 1427,
    "vorder": 53,
    "position": 0,
    "text": "زمینی کجا آفریدون گرد"
  },
  {
    "poem_id": 1427,
    "vorder": 54,
    "position": 1,
    "text": "بدانگه به تور دلاور سپرد"
  },
  {
    "poem_id": 1427,
    "vorder": 55,
    "position": 0,
    "text": "به من داده بودند و بخشیده راست"
  },
  {
    "poem_id": 1427,
    "vorder": 56,
    "position": 1,
    "text": "ترا کین پیشین نبایست خواست"
  },
  {
    "poem_id": 1427,
    "vorder": 57,
    "position": 0,
    "text": "تو دانی که دیدن نه چون آگهیست"
  },
  {
    "poem_id": 1427,
    "vorder": 58,
    "position": 1,
    "text": "میان شنیدن همیشه تهیست"
  },
  {
    "poem_id": 1427,
    "vorder": 59,
    "position": 0,
    "text": "گلستان که امروز باشد ببار"
  },
  {
    "poem_id": 1427,
    "vorder": 60,
    "position": 1,
    "text": "تو فردا چنی گل نیاید بکار"
  },
  {
    "poem_id": 1427,
    "vorder": 61,
    "position": 0,
    "text": "از امروز کاری بفردا ممان"
  },
  {
    "poem_id": 1427,
    "vorder": 62,
    "position": 1,
    "text": "که داند که فردا چه گردد زمان؟"
  },
  {
    "poem_id": 1427,
    "vorder": 63,
    "position": 0,
    "text": "ترا جنگ ایران چو بازی نمود"
  },
  {
    "poem_id": 1427,
    "vorder": 64,
    "position": 1,
    "text": "ز بازی سپه را درازی فزود"
  },
  {
    "poem_id": 1427,
    "vorder": 65,
    "position": 0,
    "text": "نگر تا چه مایه ستام بزر"
  },
  {
    "poem_id": 1427,
    "vorder": 66,
    "position": 1,
    "text": "هم از ترگ زرین و زرین سپر"
  },
  {
    "poem_id": 1427,
    "vorder": 67,
    "position": 0,
    "text": "همان تازی اسپان زرین لگام"
  },
  {
    "poem_id": 1427,
    "vorder": 68,
    "position": 1,
    "text": "همان تیغ هندی به زرین نیام"
  },
  {
    "poem_id": 1427,
    "vorder": 69,
    "position": 0,
    "text": "ازین بیشتر نامداران گرد"
  },
  {
    "poem_id": 1427,
    "vorder": 70,
    "position": 1,
    "text": "قباد اندر آمد به خواری ببرد"
  },
  {
    "poem_id": 1427,
    "vorder": 71,
    "position": 0,
    "text": "چو کلباد و چون بارمان دلیر"
  },
  {
    "poem_id": 1427,
    "vorder": 72,
    "position": 1,
    "text": "که بودی شکارش همه نره شیر"
  },
  {
    "poem_id": 1427,
    "vorder": 73,
    "position": 0,
    "text": "خزروان کجا زال بشکست خرد"
  },
  {
    "poem_id": 1427,
    "vorder": 74,
    "position": 1,
    "text": "نمودش به گُرز گران دستبرد"
  },
  {
    "poem_id": 1427,
    "vorder": 75,
    "position": 0,
    "text": "شماساس کین‌توز لشکر‌پناه"
  },
  {
    "poem_id": 1427,
    "vorder": 76,
    "position": 1,
    "text": "که قارن بکشتش به آوردگاه"
  },
  {
    "poem_id": 1427,
    "vorder": 77,
    "position": 0,
    "text": "جزین نامدران کین صدهزار"
  },
  {
    "poem_id": 1427,
    "vorder": 78,
    "position": 1,
    "text": "فزون کشته آمد گه کارزار"
  },
  {
    "poem_id": 1427,
    "vorder": 79,
    "position": 0,
    "text": "بتر زین همه نام و ننگ شکست"
  },
  {
    "poem_id": 1427,
    "vorder": 80,
    "position": 1,
    "text": "شکستی که هرگز نشایدش بست"
  },
  {
    "poem_id": 1427,
    "vorder": 81,
    "position": 0,
    "text": "گر از من سر نامور گشته‌شد"
  },
  {
    "poem_id": 1427,
    "vorder": 82,
    "position": 1,
    "text": "که اغریرث پرخرد کشته‌شد"
  },
  {
    "poem_id": 1427,
    "vorder": 83,
    "position": 0,
    "text": "جوانی بد و نیکی روزگار"
  },
  {
    "poem_id": 1427,
    "vorder": 84,
    "position": 1,
    "text": "من امروز را دی گرفتم شمار"
  },
  {
    "poem_id": 1427,
    "vorder": 85,
    "position": 0,
    "text": "که پیش آمدندم همان سرکشان"
  },
  {
    "poem_id": 1427,
    "vorder": 86,
    "position": 1,
    "text": "پس پشت هر یک درفشی کشان"
  },
  {
    "poem_id": 1427,
    "vorder": 87,
    "position": 0,
    "text": "بسی یاد دادندم از روزگار"
  },
  {
    "poem_id": 1427,
    "vorder": 88,
    "position": 1,
    "text": "دمان از پس و من دوان زار و خوار"
  },
  {
    "poem_id": 1427,
    "vorder": 89,
    "position": 0,
    "text": "کنون از گذشته مکن هیچ یاد"
  },
  {
    "poem_id": 1427,
    "vorder": 90,
    "position": 1,
    "text": "سوی آشتی یاز با کیقباد"
  },
  {
    "poem_id": 1427,
    "vorder": 91,
    "position": 0,
    "text": "گرت دیگر آید یکی آرزوی"
  },
  {
    "poem_id": 1427,
    "vorder": 92,
    "position": 1,
    "text": "به گرد اندر آید سپه چارسوی"
  },
  {
    "poem_id": 1427,
    "vorder": 93,
    "position": 0,
    "text": "به یک دست رستم که تابنده هور"
  },
  {
    "poem_id": 1427,
    "vorder": 94,
    "position": 1,
    "text": "گه رزم با او نتابد به زور"
  },
  {
    "poem_id": 1427,
    "vorder": 95,
    "position": 0,
    "text": "به روی دگر قارن رزم‌زن"
  },
  {
    "poem_id": 1427,
    "vorder": 96,
    "position": 1,
    "text": "که چشمش ندیده‌ست هرگز شکن"
  },
  {
    "poem_id": 1427,
    "vorder": 97,
    "position": 0,
    "text": "سه دیگر چو کشواد زرین‌کلاه"
  },
  {
    "poem_id": 1427,
    "vorder": 98,
    "position": 1,
    "text": "که آمد به آمل ببرد آن سپاه"
  },
  {
    "poem_id": 1427,
    "vorder": 99,
    "position": 0,
    "text": "چهارم چو مهراب کابل خدای"
  },
  {
    "poem_id": 1427,
    "vorder": 100,
    "position": 1,
    "text": "که دستور شاهست و زابل خدای"
  }
]