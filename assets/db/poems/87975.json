[
  {
    "poem_id": 87975,
    "vorder": 1,
    "position": 0,
    "text": "فریبرز بنهاد بر سر کلاه"
  },
  {
    "poem_id": 87975,
    "vorder": 2,
    "position": 1,
    "text": "که هم پهلوان بود و هم پور شاه"
  },
  {
    "poem_id": 87975,
    "vorder": 3,
    "position": 0,
    "text": "ازان پس بفرمود رهام را"
  },
  {
    "poem_id": 87975,
    "vorder": 4,
    "position": 1,
    "text": "که پیدا کند با گهر نام را"
  },
  {
    "poem_id": 87975,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت رو پیش پیران خرام"
  },
  {
    "poem_id": 87975,
    "vorder": 6,
    "position": 1,
    "text": "ز من نزد آن پهلوان بر پیام"
  },
  {
    "poem_id": 87975,
    "vorder": 7,
    "position": 0,
    "text": "بگویش که کردار گردان سپهر"
  },
  {
    "poem_id": 87975,
    "vorder": 8,
    "position": 1,
    "text": "همیشه چنین بود پر درد و مهر"
  },
  {
    "poem_id": 87975,
    "vorder": 9,
    "position": 0,
    "text": "یکی را برآرد بچرخ بلند"
  },
  {
    "poem_id": 87975,
    "vorder": 10,
    "position": 1,
    "text": "یکی را کند زار و خوار و نژند"
  },
  {
    "poem_id": 87975,
    "vorder": 11,
    "position": 0,
    "text": "کسی کو بلاجست گرد آن بود"
  },
  {
    "poem_id": 87975,
    "vorder": 12,
    "position": 1,
    "text": "شبیخون نه کردار مردان بود"
  },
  {
    "poem_id": 87975,
    "vorder": 13,
    "position": 0,
    "text": "شبیخون نسازند کنداوران"
  },
  {
    "poem_id": 87975,
    "vorder": 14,
    "position": 1,
    "text": "کسی کو گراید بگرز گران"
  },
  {
    "poem_id": 87975,
    "vorder": 15,
    "position": 0,
    "text": "تو گر با درنگی درنگ آوریم"
  },
  {
    "poem_id": 87975,
    "vorder": 16,
    "position": 1,
    "text": "گرت رای جنگست جنگ آوریم"
  },
  {
    "poem_id": 87975,
    "vorder": 17,
    "position": 0,
    "text": "ز پیش فریبرز رهام گرد"
  },
  {
    "poem_id": 87975,
    "vorder": 18,
    "position": 1,
    "text": "برون رفت و پیغام و نامه ببرد"
  },
  {
    "poem_id": 87975,
    "vorder": 19,
    "position": 0,
    "text": "بیامد طلایه بدیدش براه"
  },
  {
    "poem_id": 87975,
    "vorder": 20,
    "position": 1,
    "text": "بپرسیدش از نام وز جایگاه"
  },
  {
    "poem_id": 87975,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت رهام جنگی منم"
  },
  {
    "poem_id": 87975,
    "vorder": 22,
    "position": 1,
    "text": "هنرمند و بیدار و سنگی منم"
  },
  {
    "poem_id": 87975,
    "vorder": 23,
    "position": 0,
    "text": "پیام فریبرز کاوس شاه"
  },
  {
    "poem_id": 87975,
    "vorder": 24,
    "position": 1,
    "text": "به پیران رسانم بدین رزمگاه"
  },
  {
    "poem_id": 87975,
    "vorder": 25,
    "position": 0,
    "text": "ز پیش طلایه سواری چو گرد"
  },
  {
    "poem_id": 87975,
    "vorder": 26,
    "position": 1,
    "text": "بیامد سخنها همه یاد کرد"
  },
  {
    "poem_id": 87975,
    "vorder": 27,
    "position": 0,
    "text": "که رهام گودرز زان رزمگاه"
  },
  {
    "poem_id": 87975,
    "vorder": 28,
    "position": 1,
    "text": "بیامد سوی پهلوان سپاه"
  },
  {
    "poem_id": 87975,
    "vorder": 29,
    "position": 0,
    "text": "بفرمود تا پیش اوی آورند"
  },
  {
    "poem_id": 87975,
    "vorder": 30,
    "position": 1,
    "text": "گشاده‌دل و تازه‌روی آورند"
  },
  {
    "poem_id": 87975,
    "vorder": 31,
    "position": 0,
    "text": "سراینده رهام شد پیش اوی"
  },
  {
    "poem_id": 87975,
    "vorder": 32,
    "position": 1,
    "text": "بترس از نهان بداندیش اوی"
  },
  {
    "poem_id": 87975,
    "vorder": 33,
    "position": 0,
    "text": "چو پیران ورا دید بنواختش"
  },
  {
    "poem_id": 87975,
    "vorder": 34,
    "position": 1,
    "text": "بپرسید و بر تخت بنشاختش"
  },
  {
    "poem_id": 87975,
    "vorder": 35,
    "position": 0,
    "text": "برآورد رهام راز از نهفت"
  },
  {
    "poem_id": 87975,
    "vorder": 36,
    "position": 1,
    "text": "پیام فریبرز با او بگفت"
  },
  {
    "poem_id": 87975,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت پیران برهام گرد"
  },
  {
    "poem_id": 87975,
    "vorder": 38,
    "position": 1,
    "text": "که این جنگ را خرد نتوان شمرد"
  },
  {
    "poem_id": 87975,
    "vorder": 39,
    "position": 0,
    "text": "شما را بد این پیش دستی بجنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 40,
    "position": 1,
    "text": "ندیدیم با طوس رای و درنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 41,
    "position": 0,
    "text": "بمرز اندر آمد چو گرگ سترگ"
  },
  {
    "poem_id": 87975,
    "vorder": 42,
    "position": 1,
    "text": "همی کشت بی‌باک خرد و بزرگ"
  },
  {
    "poem_id": 87975,
    "vorder": 43,
    "position": 0,
    "text": "چه مایه بکشت و چه مایه ببرد"
  },
  {
    "poem_id": 87975,
    "vorder": 44,
    "position": 1,
    "text": "بدو نیک این مرز یکسان شمرد"
  },
  {
    "poem_id": 87975,
    "vorder": 45,
    "position": 0,
    "text": "مکافات این بد کنون یافتند"
  },
  {
    "poem_id": 87975,
    "vorder": 46,
    "position": 1,
    "text": "اگر چند با کینه بشتافتند"
  },
  {
    "poem_id": 87975,
    "vorder": 47,
    "position": 0,
    "text": "کنون گر تویی پهلوان سپاه"
  },
  {
    "poem_id": 87975,
    "vorder": 48,
    "position": 1,
    "text": "چنانچون ترا باید از من بخواه"
  },
  {
    "poem_id": 87975,
    "vorder": 49,
    "position": 0,
    "text": "گر ایدونک یک ماه خواهی درنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 50,
    "position": 1,
    "text": "ز لشکر نیاید سواری بجنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 51,
    "position": 0,
    "text": "وگر جنگ جویی منم برکنار"
  },
  {
    "poem_id": 87975,
    "vorder": 52,
    "position": 1,
    "text": "بیارای و برکش صف کارزار"
  },
  {
    "poem_id": 87975,
    "vorder": 53,
    "position": 0,
    "text": "چو یک مه بدین آرزو بشمرید"
  },
  {
    "poem_id": 87975,
    "vorder": 54,
    "position": 1,
    "text": "که از مرز توران‌زمین بگذرید"
  },
  {
    "poem_id": 87975,
    "vorder": 55,
    "position": 0,
    "text": "برانید لشکر سوی مرز خویش"
  },
  {
    "poem_id": 87975,
    "vorder": 56,
    "position": 1,
    "text": "ببینید یکسر همه ارز خویش"
  },
  {
    "poem_id": 87975,
    "vorder": 57,
    "position": 0,
    "text": "وگرنه بجنگ اندر آرید چنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 58,
    "position": 1,
    "text": "مخواهید زین پس زمان و درنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 59,
    "position": 0,
    "text": "یکی خلعت آراست رهام را"
  },
  {
    "poem_id": 87975,
    "vorder": 60,
    "position": 1,
    "text": "چنانچون بود درخور نام را"
  },
  {
    "poem_id": 87975,
    "vorder": 61,
    "position": 0,
    "text": "بنزد فریبرز رهام گرد"
  },
  {
    "poem_id": 87975,
    "vorder": 62,
    "position": 1,
    "text": "بیاورد نامه چنانچون ببرد"
  },
  {
    "poem_id": 87975,
    "vorder": 63,
    "position": 0,
    "text": "فریبرز چون یافت روز درنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 64,
    "position": 1,
    "text": "بهر سو بیازید چون شیرچنگ"
  },
  {
    "poem_id": 87975,
    "vorder": 65,
    "position": 0,
    "text": "سر بدره‌ها را گشادن گرفت"
  },
  {
    "poem_id": 87975,
    "vorder": 66,
    "position": 1,
    "text": "نهاده همه رای دادن گرفت"
  },
  {
    "poem_id": 87975,
    "vorder": 67,
    "position": 0,
    "text": "کشیدند و لشکر بیاراستند"
  },
  {
    "poem_id": 87975,
    "vorder": 68,
    "position": 1,
    "text": "ز هر چیز لختی بپیراستند"
  }
]