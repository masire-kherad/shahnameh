[
  {
    "poem_id": 1717,
    "vorder": 1,
    "position": 0,
    "text": "چو از روم وز چین وز ترک و هند"
  },
  {
    "poem_id": 1717,
    "vorder": 2,
    "position": 1,
    "text": "جهان شد مر او را چو رومی پرند"
  },
  {
    "poem_id": 1717,
    "vorder": 3,
    "position": 0,
    "text": "ز هر مرز پیوسته شد باژ و ساو"
  },
  {
    "poem_id": 1717,
    "vorder": 4,
    "position": 1,
    "text": "کسی را نبد با جهاندار تاو"
  },
  {
    "poem_id": 1717,
    "vorder": 5,
    "position": 0,
    "text": "همه مهتران را ز ایران بخواند"
  },
  {
    "poem_id": 1717,
    "vorder": 6,
    "position": 1,
    "text": "سزاوار بر تخت شاهی نشاند"
  },
  {
    "poem_id": 1717,
    "vorder": 7,
    "position": 0,
    "text": "ازان پس شهنشاه بر پای خاست"
  },
  {
    "poem_id": 1717,
    "vorder": 8,
    "position": 1,
    "text": "به خوبی بیاراست گفتار راست"
  },
  {
    "poem_id": 1717,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت کای نامداران شهر"
  },
  {
    "poem_id": 1717,
    "vorder": 10,
    "position": 1,
    "text": "ز رای و خرد هرک دارید بهر"
  },
  {
    "poem_id": 1717,
    "vorder": 11,
    "position": 0,
    "text": "بدانید کاین تیرگردان سپهر"
  },
  {
    "poem_id": 1717,
    "vorder": 12,
    "position": 1,
    "text": "ننازد به داد و نیازد به مهر"
  },
  {
    "poem_id": 1717,
    "vorder": 13,
    "position": 0,
    "text": "یکی را چو خواهد برآرد بلند"
  },
  {
    "poem_id": 1717,
    "vorder": 14,
    "position": 1,
    "text": "هم آخر سپارد به خاک نژند"
  },
  {
    "poem_id": 1717,
    "vorder": 15,
    "position": 0,
    "text": "نماند به جز نام زو در جهان"
  },
  {
    "poem_id": 1717,
    "vorder": 16,
    "position": 1,
    "text": "همه رنج با او شود در نهان"
  },
  {
    "poem_id": 1717,
    "vorder": 17,
    "position": 0,
    "text": "به گیتی ممانید جز نام نیک"
  },
  {
    "poem_id": 1717,
    "vorder": 18,
    "position": 1,
    "text": "هرانکس که خواهد سرانجام نیک"
  },
  {
    "poem_id": 1717,
    "vorder": 19,
    "position": 0,
    "text": "ترا روزگار اورمزد آن بود"
  },
  {
    "poem_id": 1717,
    "vorder": 20,
    "position": 1,
    "text": "که خشنودی پاک یزدان بود"
  },
  {
    "poem_id": 1717,
    "vorder": 21,
    "position": 0,
    "text": "به یزدان گرای و به یزدان گشای"
  },
  {
    "poem_id": 1717,
    "vorder": 22,
    "position": 1,
    "text": "که دارنده اویست و نیکی فزای"
  },
  {
    "poem_id": 1717,
    "vorder": 23,
    "position": 0,
    "text": "ز هر بد به دادار گیهان پناه"
  },
  {
    "poem_id": 1717,
    "vorder": 24,
    "position": 1,
    "text": "که او راست بر نیک و بد دستگاه"
  },
  {
    "poem_id": 1717,
    "vorder": 25,
    "position": 0,
    "text": "کند بر تو آسان همه کار سخت"
  },
  {
    "poem_id": 1717,
    "vorder": 26,
    "position": 1,
    "text": "ز رای دلفروز و پیروز بخت"
  },
  {
    "poem_id": 1717,
    "vorder": 27,
    "position": 0,
    "text": "نخستین ز کار من اندازه گیر"
  },
  {
    "poem_id": 1717,
    "vorder": 28,
    "position": 1,
    "text": "گذشته بد و نیک من تازه گیر"
  },
  {
    "poem_id": 1717,
    "vorder": 29,
    "position": 0,
    "text": "که کردم به دادار گیهان پناه"
  },
  {
    "poem_id": 1717,
    "vorder": 30,
    "position": 1,
    "text": "مرا داد بر نیک و بد دستگاه"
  },
  {
    "poem_id": 1717,
    "vorder": 31,
    "position": 0,
    "text": "زمین هفت کشور به شاهی مراست"
  },
  {
    "poem_id": 1717,
    "vorder": 32,
    "position": 1,
    "text": "چنان کز خداوندی او سزاست"
  },
  {
    "poem_id": 1717,
    "vorder": 33,
    "position": 0,
    "text": "همی باژ خواهم ز روم و ز هند"
  },
  {
    "poem_id": 1717,
    "vorder": 34,
    "position": 1,
    "text": "جهان شد مرا همچو رومی پرند"
  },
  {
    "poem_id": 1717,
    "vorder": 35,
    "position": 0,
    "text": "سپاسم ز یزدان که او داد زور"
  },
  {
    "poem_id": 1717,
    "vorder": 36,
    "position": 1,
    "text": "بلند اختر و بخش کیوان و هور"
  },
  {
    "poem_id": 1717,
    "vorder": 37,
    "position": 0,
    "text": "ستایش که داند سزاوار اوی"
  },
  {
    "poem_id": 1717,
    "vorder": 38,
    "position": 1,
    "text": "نیایش بر آیین و کردار اوی"
  },
  {
    "poem_id": 1717,
    "vorder": 39,
    "position": 0,
    "text": "مگر کو دهد بازمان زندگی"
  },
  {
    "poem_id": 1717,
    "vorder": 40,
    "position": 1,
    "text": "بماند بزرگی و تابندگی"
  },
  {
    "poem_id": 1717,
    "vorder": 41,
    "position": 0,
    "text": "کنون هرچ خواهیم کردن ز داد"
  },
  {
    "poem_id": 1717,
    "vorder": 42,
    "position": 1,
    "text": "بکوشیم وز داد باشیم شاد"
  },
  {
    "poem_id": 1717,
    "vorder": 43,
    "position": 0,
    "text": "ز ده یک مرا چند بر شهرهاست"
  },
  {
    "poem_id": 1717,
    "vorder": 44,
    "position": 1,
    "text": "که دهقان و موبد بران بر گواست"
  },
  {
    "poem_id": 1717,
    "vorder": 45,
    "position": 0,
    "text": "چو باید شما را ببخشم همه"
  },
  {
    "poem_id": 1717,
    "vorder": 46,
    "position": 1,
    "text": "همان ده یک و بوم و باژ و رمه"
  },
  {
    "poem_id": 1717,
    "vorder": 47,
    "position": 0,
    "text": "مگر آنک آید شما را فزون"
  },
  {
    "poem_id": 1717,
    "vorder": 48,
    "position": 1,
    "text": "بیارد سوی گنج ما رهنمون"
  },
  {
    "poem_id": 1717,
    "vorder": 49,
    "position": 0,
    "text": "ز ده یک که من بستدم پیش ازین"
  },
  {
    "poem_id": 1717,
    "vorder": 50,
    "position": 1,
    "text": "ز باژ آنچ کم بود گر بیش ازین"
  },
  {
    "poem_id": 1717,
    "vorder": 51,
    "position": 0,
    "text": "همی از پی سود بردم به کار"
  },
  {
    "poem_id": 1717,
    "vorder": 52,
    "position": 1,
    "text": "به در داشتن لشکر بی‌شمار"
  },
  {
    "poem_id": 1717,
    "vorder": 53,
    "position": 0,
    "text": "بزرگی شما جستم و ایمنی"
  },
  {
    "poem_id": 1717,
    "vorder": 54,
    "position": 1,
    "text": "نهان کردن کیش آهرمنی"
  },
  {
    "poem_id": 1717,
    "vorder": 55,
    "position": 0,
    "text": "شما دست یکسر به یزدان زنید"
  },
  {
    "poem_id": 1717,
    "vorder": 56,
    "position": 1,
    "text": "بکوشید و پیمان او مشکنید"
  },
  {
    "poem_id": 1717,
    "vorder": 57,
    "position": 0,
    "text": "که بخشنده اویست و دارنده اوی"
  },
  {
    "poem_id": 1717,
    "vorder": 58,
    "position": 1,
    "text": "بلند آسمان را نگارنده اوی"
  },
  {
    "poem_id": 1717,
    "vorder": 59,
    "position": 0,
    "text": "ستمدیده را اوست فریادرس"
  },
  {
    "poem_id": 1717,
    "vorder": 60,
    "position": 1,
    "text": "منازید با نازش او به کس"
  },
  {
    "poem_id": 1717,
    "vorder": 61,
    "position": 0,
    "text": "نباید نهادن دل اندر فریب"
  },
  {
    "poem_id": 1717,
    "vorder": 62,
    "position": 1,
    "text": "که پیش فراز اندر آید نشیب"
  },
  {
    "poem_id": 1717,
    "vorder": 63,
    "position": 0,
    "text": "کجا آنک بر سود تاجش به ابر"
  },
  {
    "poem_id": 1717,
    "vorder": 64,
    "position": 1,
    "text": "کجا آنک بودی شکارش هژبر"
  },
  {
    "poem_id": 1717,
    "vorder": 65,
    "position": 0,
    "text": "نهالی همه خاک دارند و خشت"
  },
  {
    "poem_id": 1717,
    "vorder": 66,
    "position": 1,
    "text": "خنک آنک جز تخم نیکی نکشت"
  },
  {
    "poem_id": 1717,
    "vorder": 67,
    "position": 0,
    "text": "همه هرک هست اندرین مرز من"
  },
  {
    "poem_id": 1717,
    "vorder": 68,
    "position": 1,
    "text": "کجا گوش دارند اندرز من"
  },
  {
    "poem_id": 1717,
    "vorder": 69,
    "position": 0,
    "text": "نمایم شما را کنون راه پنج"
  },
  {
    "poem_id": 1717,
    "vorder": 70,
    "position": 1,
    "text": "که سودش فزون آید از تاج و گنج"
  }
]