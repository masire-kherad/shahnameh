[
  {
    "poem_id": 1540,
    "vorder": 1,
    "position": 0,
    "text": "دو هفته برآمد برین کارزار"
  },
  {
    "poem_id": 1540,
    "vorder": 2,
    "position": 1,
    "text": "که هزمان همی تیره‌تر گشت کار"
  },
  {
    "poem_id": 1540,
    "vorder": 3,
    "position": 0,
    "text": "به پیش اندر آمد نبرده زریر"
  },
  {
    "poem_id": 1540,
    "vorder": 4,
    "position": 1,
    "text": "سمندی بزرگ اندر آورده زیر"
  },
  {
    "poem_id": 1540,
    "vorder": 5,
    "position": 0,
    "text": "به لشکرگه دشمن اندر فتاد"
  },
  {
    "poem_id": 1540,
    "vorder": 6,
    "position": 1,
    "text": "چو اندر گیا آتش و تیز باد"
  },
  {
    "poem_id": 1540,
    "vorder": 7,
    "position": 0,
    "text": "همی کشت زیشان همی خوابنید"
  },
  {
    "poem_id": 1540,
    "vorder": 8,
    "position": 1,
    "text": "مر او را نه استاد هرکش بدید"
  },
  {
    "poem_id": 1540,
    "vorder": 9,
    "position": 0,
    "text": "چو ارجاسپ دانست کان پورشاه"
  },
  {
    "poem_id": 1540,
    "vorder": 10,
    "position": 1,
    "text": "سپه را همی کرد خواهد تباه"
  },
  {
    "poem_id": 1540,
    "vorder": 11,
    "position": 0,
    "text": "بدان لشکر خویش آواز داد"
  },
  {
    "poem_id": 1540,
    "vorder": 12,
    "position": 1,
    "text": "که چونین همی داد خواهید داد"
  },
  {
    "poem_id": 1540,
    "vorder": 13,
    "position": 0,
    "text": "دو هفته برآمد برین بر درنگ"
  },
  {
    "poem_id": 1540,
    "vorder": 14,
    "position": 1,
    "text": "نبینم همی روی فرجام جنگ"
  },
  {
    "poem_id": 1540,
    "vorder": 15,
    "position": 0,
    "text": "بکردند گردان گشتاسپ شاه"
  },
  {
    "poem_id": 1540,
    "vorder": 16,
    "position": 1,
    "text": "بسی نامداران لشکر تباه"
  },
  {
    "poem_id": 1540,
    "vorder": 17,
    "position": 0,
    "text": "کنون اندر آمد میانه زریر"
  },
  {
    "poem_id": 1540,
    "vorder": 18,
    "position": 1,
    "text": "چو گرگ دژآگاه و شیر دلیر"
  },
  {
    "poem_id": 1540,
    "vorder": 19,
    "position": 0,
    "text": "بکشت او همه پاک مردان من"
  },
  {
    "poem_id": 1540,
    "vorder": 20,
    "position": 1,
    "text": "سرافراز گردان و ترکان من"
  },
  {
    "poem_id": 1540,
    "vorder": 21,
    "position": 0,
    "text": "یکی چاره باید سگالیدنا"
  },
  {
    "poem_id": 1540,
    "vorder": 22,
    "position": 1,
    "text": "و گرنه ره ترک مالیدنا"
  },
  {
    "poem_id": 1540,
    "vorder": 23,
    "position": 0,
    "text": "برین گر بماند زمانی چنین"
  },
  {
    "poem_id": 1540,
    "vorder": 24,
    "position": 1,
    "text": "نه ایتاش ماند نه خلخ نه چین"
  },
  {
    "poem_id": 1540,
    "vorder": 25,
    "position": 0,
    "text": "کدامست مرد از شما نام خواه"
  },
  {
    "poem_id": 1540,
    "vorder": 26,
    "position": 1,
    "text": "که آید پدید از میان سپاه"
  },
  {
    "poem_id": 1540,
    "vorder": 27,
    "position": 0,
    "text": "یکی ترگ داری خرامد به پیش"
  },
  {
    "poem_id": 1540,
    "vorder": 28,
    "position": 1,
    "text": "خنیده کند در جهان نام خویش"
  },
  {
    "poem_id": 1540,
    "vorder": 29,
    "position": 0,
    "text": "هران کز میان باره انگیزند"
  },
  {
    "poem_id": 1540,
    "vorder": 30,
    "position": 1,
    "text": "بگرداندش پشت و بگریزند"
  },
  {
    "poem_id": 1540,
    "vorder": 31,
    "position": 0,
    "text": "من او را دهم دختر خویش را"
  },
  {
    "poem_id": 1540,
    "vorder": 32,
    "position": 1,
    "text": "سپارم بدو لشکر خویش را"
  },
  {
    "poem_id": 1540,
    "vorder": 33,
    "position": 0,
    "text": "سپاهش ندادند پاسوخ باز"
  },
  {
    "poem_id": 1540,
    "vorder": 34,
    "position": 1,
    "text": "بترسیده بد لشکر سرفراز"
  },
  {
    "poem_id": 1540,
    "vorder": 35,
    "position": 0,
    "text": "چو شیر اندرافتاد و چون پیل مست"
  },
  {
    "poem_id": 1540,
    "vorder": 36,
    "position": 1,
    "text": "همی کشت زیشان همی کرد پست"
  },
  {
    "poem_id": 1540,
    "vorder": 37,
    "position": 0,
    "text": "همی کوفتشان هر سوی زیر پای"
  },
  {
    "poem_id": 1540,
    "vorder": 38,
    "position": 1,
    "text": "سپهدار ایران فرخنده رای"
  },
  {
    "poem_id": 1540,
    "vorder": 39,
    "position": 0,
    "text": "چو ارجاسپ دید آن چنان خیره شد"
  },
  {
    "poem_id": 1540,
    "vorder": 40,
    "position": 1,
    "text": "که روز سپیدش شب تیره شد"
  },
  {
    "poem_id": 1540,
    "vorder": 41,
    "position": 0,
    "text": "دگر باره گفت ای بزرگان من"
  },
  {
    "poem_id": 1540,
    "vorder": 42,
    "position": 1,
    "text": "تگینان لشکر گزینان من"
  },
  {
    "poem_id": 1540,
    "vorder": 43,
    "position": 0,
    "text": "ببینید خویشان و پیوستگان"
  },
  {
    "poem_id": 1540,
    "vorder": 44,
    "position": 1,
    "text": "ببینید نالیدن خستگان"
  },
  {
    "poem_id": 1540,
    "vorder": 45,
    "position": 0,
    "text": "ازان زخم آن پهلو آتشی"
  },
  {
    "poem_id": 1540,
    "vorder": 46,
    "position": 1,
    "text": "که سامیش گرزست و تیر آرشی"
  },
  {
    "poem_id": 1540,
    "vorder": 47,
    "position": 0,
    "text": "که گفتی بسوزد همی لشکرم"
  },
  {
    "poem_id": 1540,
    "vorder": 48,
    "position": 1,
    "text": "کنون برفروزد همی کشورم"
  },
  {
    "poem_id": 1540,
    "vorder": 49,
    "position": 0,
    "text": "کدامست مرد از شما چیره دست"
  },
  {
    "poem_id": 1540,
    "vorder": 50,
    "position": 1,
    "text": "که بیرون شود پیش این پیل مست"
  },
  {
    "poem_id": 1540,
    "vorder": 51,
    "position": 0,
    "text": "هرانکو بدان گردکش یازدا"
  },
  {
    "poem_id": 1540,
    "vorder": 52,
    "position": 1,
    "text": "مر او را  ازان باره بندازدا"
  },
  {
    "poem_id": 1540,
    "vorder": 53,
    "position": 0,
    "text": "چو بخشنده‌ام بیش بسپارمش"
  },
  {
    "poem_id": 1540,
    "vorder": 54,
    "position": 1,
    "text": "کلاه از بر چرخ بگذارمش"
  },
  {
    "poem_id": 1540,
    "vorder": 55,
    "position": 0,
    "text": "همیدون نداد ایچ کس پاسخش"
  },
  {
    "poem_id": 1540,
    "vorder": 56,
    "position": 1,
    "text": "بشد خیره و زرد گشت آن رخش"
  },
  {
    "poem_id": 1540,
    "vorder": 57,
    "position": 0,
    "text": "سه بار این سخن را بریشان براند"
  },
  {
    "poem_id": 1540,
    "vorder": 58,
    "position": 1,
    "text": "چو پاسخ نیامدش خامش بماند"
  },
  {
    "poem_id": 1540,
    "vorder": 59,
    "position": 0,
    "text": "بیامد پس آن بیدرفش سترگ"
  },
  {
    "poem_id": 1540,
    "vorder": 60,
    "position": 1,
    "text": "پلید و بد و جادوی و پیر گرگ"
  },
  {
    "poem_id": 1540,
    "vorder": 61,
    "position": 0,
    "text": "به ارچاسپ گفت ای بلند آفتاب"
  },
  {
    "poem_id": 1540,
    "vorder": 62,
    "position": 1,
    "text": "به زور و به تن همچو افراسیاب"
  },
  {
    "poem_id": 1540,
    "vorder": 63,
    "position": 0,
    "text": "به پیش تو آوردم این جان خویش"
  },
  {
    "poem_id": 1540,
    "vorder": 64,
    "position": 1,
    "text": "سپر کردم این جان شیرینت پیش"
  },
  {
    "poem_id": 1540,
    "vorder": 65,
    "position": 0,
    "text": "شوم پیش آن پیل آشفته مست"
  },
  {
    "poem_id": 1540,
    "vorder": 66,
    "position": 1,
    "text": "گر ایدونک یابم بران پیل دست"
  },
  {
    "poem_id": 1540,
    "vorder": 67,
    "position": 0,
    "text": "به خاک افگنم تنش ای شهریار"
  },
  {
    "poem_id": 1540,
    "vorder": 68,
    "position": 1,
    "text": "مگر بر دهد گردش روزگار"
  },
  {
    "poem_id": 1540,
    "vorder": 69,
    "position": 0,
    "text": "ازو شاد شد شاه و کرد آفرین"
  },
  {
    "poem_id": 1540,
    "vorder": 70,
    "position": 1,
    "text": "بدادش بدو بارهٔ خویش و زین"
  },
  {
    "poem_id": 1540,
    "vorder": 71,
    "position": 0,
    "text": "بدو داد ژوپین زهرابدار"
  },
  {
    "poem_id": 1540,
    "vorder": 72,
    "position": 1,
    "text": "که از آهنین کوه کردی گذار"
  },
  {
    "poem_id": 1540,
    "vorder": 73,
    "position": 0,
    "text": "چو شد جادوی زشت ناباکدار"
  },
  {
    "poem_id": 1540,
    "vorder": 74,
    "position": 1,
    "text": "سوی آن خردمند گرد سوار"
  },
  {
    "poem_id": 1540,
    "vorder": 75,
    "position": 0,
    "text": "چو از دور دیدش برآورد خشم"
  },
  {
    "poem_id": 1540,
    "vorder": 76,
    "position": 1,
    "text": "پر از خاک روی و پر از خون دو چشم"
  },
  {
    "poem_id": 1540,
    "vorder": 77,
    "position": 0,
    "text": "به دست اندرون گرز چون سام یل"
  },
  {
    "poem_id": 1540,
    "vorder": 78,
    "position": 1,
    "text": "به پیش اندرون کشته چون کوه تل"
  },
  {
    "poem_id": 1540,
    "vorder": 79,
    "position": 0,
    "text": "نیارست رفتنش بر پیش روی"
  },
  {
    "poem_id": 1540,
    "vorder": 80,
    "position": 1,
    "text": "ز پنهان همی تاخت بر گرد اوی"
  },
  {
    "poem_id": 1540,
    "vorder": 81,
    "position": 0,
    "text": "بینداخت ژوپین زهرابدار"
  },
  {
    "poem_id": 1540,
    "vorder": 82,
    "position": 1,
    "text": "ز پنهان بران شاهزاده سوار"
  },
  {
    "poem_id": 1540,
    "vorder": 83,
    "position": 0,
    "text": "گذاره شد از خسروی جوشنش"
  },
  {
    "poem_id": 1540,
    "vorder": 84,
    "position": 1,
    "text": "به خون غرقه شد شهریاری تنش"
  },
  {
    "poem_id": 1540,
    "vorder": 85,
    "position": 0,
    "text": "ز باره در افتاد پس شهریار"
  },
  {
    "poem_id": 1540,
    "vorder": 86,
    "position": 1,
    "text": "دریغ آن نکو شاهزاده سوار"
  },
  {
    "poem_id": 1540,
    "vorder": 87,
    "position": 0,
    "text": "فرود آمد آن بیدرفش پلید"
  },
  {
    "poem_id": 1540,
    "vorder": 88,
    "position": 1,
    "text": "سلیحش همه پاک بیرون کشید"
  },
  {
    "poem_id": 1540,
    "vorder": 89,
    "position": 0,
    "text": "سوی شاه چین برد اسپ و کمرش"
  },
  {
    "poem_id": 1540,
    "vorder": 90,
    "position": 1,
    "text": "درفش سیه افسر پرگهرش"
  },
  {
    "poem_id": 1540,
    "vorder": 91,
    "position": 0,
    "text": "سپاهش همه بانگ برداشتند"
  },
  {
    "poem_id": 1540,
    "vorder": 92,
    "position": 1,
    "text": "همی نعره از ابر بگذاشتند"
  },
  {
    "poem_id": 1540,
    "vorder": 93,
    "position": 0,
    "text": "چو گشتاسپ از کوه سر بنگرید"
  },
  {
    "poem_id": 1540,
    "vorder": 94,
    "position": 1,
    "text": "مر او را بدان رزمگه بر ندید"
  },
  {
    "poem_id": 1540,
    "vorder": 95,
    "position": 0,
    "text": "گمانی برم گفت کان گرد ماه"
  },
  {
    "poem_id": 1540,
    "vorder": 96,
    "position": 1,
    "text": "که روشن بدی زو همه رزمگاه"
  },
  {
    "poem_id": 1540,
    "vorder": 97,
    "position": 0,
    "text": "نبرده برادرم فرخ زریر"
  },
  {
    "poem_id": 1540,
    "vorder": 98,
    "position": 1,
    "text": "که شیر ژیان آوریدی به زیر"
  },
  {
    "poem_id": 1540,
    "vorder": 99,
    "position": 0,
    "text": "فگندست بر باره از تاختن"
  },
  {
    "poem_id": 1540,
    "vorder": 100,
    "position": 1,
    "text": "بماندند گردان ز انداختن"
  },
  {
    "poem_id": 1540,
    "vorder": 101,
    "position": 0,
    "text": "نیاید همی بانگ شه زادگان"
  },
  {
    "poem_id": 1540,
    "vorder": 102,
    "position": 1,
    "text": "مگر کشته شد شاه آزادگان"
  },
  {
    "poem_id": 1540,
    "vorder": 103,
    "position": 0,
    "text": "هیونی بتازید تا رزمگاه"
  },
  {
    "poem_id": 1540,
    "vorder": 104,
    "position": 1,
    "text": "به نزدیکی آن درفش سیاه"
  },
  {
    "poem_id": 1540,
    "vorder": 105,
    "position": 0,
    "text": "ببینید کان شاه من چون شدست"
  },
  {
    "poem_id": 1540,
    "vorder": 106,
    "position": 1,
    "text": "کم از درد او دل پر از خون شدست"
  },
  {
    "poem_id": 1540,
    "vorder": 107,
    "position": 0,
    "text": "بدین اندرون بود شاه جهان"
  },
  {
    "poem_id": 1540,
    "vorder": 108,
    "position": 1,
    "text": "که آمد یکی خون ز دیده چکان"
  },
  {
    "poem_id": 1540,
    "vorder": 109,
    "position": 0,
    "text": "به شاه جهان گفت ماه ترا"
  },
  {
    "poem_id": 1540,
    "vorder": 110,
    "position": 1,
    "text": "نگهدار تاج و سپاه ترا"
  },
  {
    "poem_id": 1540,
    "vorder": 111,
    "position": 0,
    "text": "جهان پهلوان آن زریر سوار"
  },
  {
    "poem_id": 1540,
    "vorder": 112,
    "position": 1,
    "text": "سواران ترکان بکشتند زار"
  },
  {
    "poem_id": 1540,
    "vorder": 113,
    "position": 0,
    "text": "سر جادوان جهان بیدرفش"
  },
  {
    "poem_id": 1540,
    "vorder": 114,
    "position": 1,
    "text": "مر او را بیفگند و برد آن درفش"
  },
  {
    "poem_id": 1540,
    "vorder": 115,
    "position": 0,
    "text": "چو آگاهی کشتن او رسید"
  },
  {
    "poem_id": 1540,
    "vorder": 116,
    "position": 1,
    "text": "به شاه جهانجوی و مرگش بدید"
  },
  {
    "poem_id": 1540,
    "vorder": 117,
    "position": 0,
    "text": "همه جامه تا پای بدرید پاک"
  },
  {
    "poem_id": 1540,
    "vorder": 118,
    "position": 1,
    "text": "بران خسروی تاج پاشید خاک"
  },
  {
    "poem_id": 1540,
    "vorder": 119,
    "position": 0,
    "text": "همی گفت گشتاسپ کای شهریار"
  },
  {
    "poem_id": 1540,
    "vorder": 120,
    "position": 1,
    "text": "چراغ دلت را بکشتند زار"
  },
  {
    "poem_id": 1540,
    "vorder": 121,
    "position": 0,
    "text": "ز پس گفت داننده جاماسپ را"
  },
  {
    "poem_id": 1540,
    "vorder": 122,
    "position": 1,
    "text": "چه گویم کنون شاه لهراسپ را"
  },
  {
    "poem_id": 1540,
    "vorder": 123,
    "position": 0,
    "text": "چگونه فرستم فرسته بدر"
  },
  {
    "poem_id": 1540,
    "vorder": 124,
    "position": 1,
    "text": "چه گویم بدان پیر گشته پدر"
  },
  {
    "poem_id": 1540,
    "vorder": 125,
    "position": 0,
    "text": "چه گویم چه کردم نگار ترا"
  },
  {
    "poem_id": 1540,
    "vorder": 126,
    "position": 1,
    "text": "که برد آن نبرده سوار ترا"
  },
  {
    "poem_id": 1540,
    "vorder": 127,
    "position": 0,
