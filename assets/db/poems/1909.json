[
  {
    "poem_id": 1909,
    "vorder": 1,
    "position": 0,
    "text": "بدانست هم زادفرخ که شاه"
  },
  {
    "poem_id": 1909,
    "vorder": 2,
    "position": 1,
    "text": "ز لشکر همه زو شناسد گناه"
  },
  {
    "poem_id": 1909,
    "vorder": 3,
    "position": 0,
    "text": "چو آمد برون آن بد اندیش شاه"
  },
  {
    "poem_id": 1909,
    "vorder": 4,
    "position": 1,
    "text": "نیارست شد نیز در پیشگاه"
  },
  {
    "poem_id": 1909,
    "vorder": 5,
    "position": 0,
    "text": "بدر بر همی‌بود تا هرکسی"
  },
  {
    "poem_id": 1909,
    "vorder": 6,
    "position": 1,
    "text": "همی‌کرد زان آزمایش بسی"
  },
  {
    "poem_id": 1909,
    "vorder": 7,
    "position": 0,
    "text": "همی‌ساخت همواره تا آن سپاه"
  },
  {
    "poem_id": 1909,
    "vorder": 8,
    "position": 1,
    "text": "بپیچید یکسر ز فرمان شاه"
  },
  {
    "poem_id": 1909,
    "vorder": 9,
    "position": 0,
    "text": "همی‌راند با هر کسی داستان"
  },
  {
    "poem_id": 1909,
    "vorder": 10,
    "position": 1,
    "text": "شدند اندر آن کار همداستان"
  },
  {
    "poem_id": 1909,
    "vorder": 11,
    "position": 0,
    "text": "که شاهی دگر برنشیند به تخت"
  },
  {
    "poem_id": 1909,
    "vorder": 12,
    "position": 1,
    "text": "کزین دور شد فرو آیین و بخت"
  },
  {
    "poem_id": 1909,
    "vorder": 13,
    "position": 0,
    "text": "بر زادفرخ یکی پیر بود"
  },
  {
    "poem_id": 1909,
    "vorder": 14,
    "position": 1,
    "text": "که برکارها کردن آژیر بود"
  },
  {
    "poem_id": 1909,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت با زادفرخ که شاه"
  },
  {
    "poem_id": 1909,
    "vorder": 16,
    "position": 1,
    "text": "همی از تو بیند گناه سپاه"
  },
  {
    "poem_id": 1909,
    "vorder": 17,
    "position": 0,
    "text": "کنون تا یکی شهریاری پدید"
  },
  {
    "poem_id": 1909,
    "vorder": 18,
    "position": 1,
    "text": "نیاری فزون زین نباید چخید"
  },
  {
    "poem_id": 1909,
    "vorder": 19,
    "position": 0,
    "text": "که این بوم آباد ویران شود"
  },
  {
    "poem_id": 1909,
    "vorder": 20,
    "position": 1,
    "text": "از اندوه ایران چو نیران شود"
  },
  {
    "poem_id": 1909,
    "vorder": 21,
    "position": 0,
    "text": "نگه کرد باید به فرزند اوی"
  },
  {
    "poem_id": 1909,
    "vorder": 22,
    "position": 1,
    "text": "کدامست با شرم و بی‌گفت و گوی"
  },
  {
    "poem_id": 1909,
    "vorder": 23,
    "position": 0,
    "text": "ورا شاد بر تخت باید نشاند"
  },
  {
    "poem_id": 1909,
    "vorder": 24,
    "position": 1,
    "text": "بران تاج دینار باید فشاند"
  },
  {
    "poem_id": 1909,
    "vorder": 25,
    "position": 0,
    "text": "چو شیروی بیدار مهتر پسر"
  },
  {
    "poem_id": 1909,
    "vorder": 26,
    "position": 1,
    "text": "به زندان بود کس نباید دگر"
  },
  {
    "poem_id": 1909,
    "vorder": 27,
    "position": 0,
    "text": "همی رای زد زین نشان هرکسی"
  },
  {
    "poem_id": 1909,
    "vorder": 28,
    "position": 1,
    "text": "برین روز و شب برنیامد بسی"
  },
  {
    "poem_id": 1909,
    "vorder": 29,
    "position": 0,
    "text": "که برخاست گرد سپاه تخوار"
  },
  {
    "poem_id": 1909,
    "vorder": 30,
    "position": 1,
    "text": "همه کارها زو گرفتند خوار"
  },
  {
    "poem_id": 1909,
    "vorder": 31,
    "position": 0,
    "text": "پذیره شدش زادفرخ به راه"
  },
  {
    "poem_id": 1909,
    "vorder": 32,
    "position": 1,
    "text": "فراوان برفتند با او سپاه"
  },
  {
    "poem_id": 1909,
    "vorder": 33,
    "position": 0,
    "text": "رسیدند پس یک بدیگر فراز"
  },
  {
    "poem_id": 1909,
    "vorder": 34,
    "position": 1,
    "text": "سخن رفت چند آشکارا و راز"
  },
  {
    "poem_id": 1909,
    "vorder": 35,
    "position": 0,
    "text": "همان زاد فرخ زبان برگشاد"
  },
  {
    "poem_id": 1909,
    "vorder": 36,
    "position": 1,
    "text": "بدی های خسرو همه کرد یاد"
  },
  {
    "poem_id": 1909,
    "vorder": 37,
    "position": 0,
    "text": "همی‌گفت لشکر به مردی و رای"
  },
  {
    "poem_id": 1909,
    "vorder": 38,
    "position": 1,
    "text": "همی‌کرد خواهند شاهی بپای"
  },
  {
    "poem_id": 1909,
    "vorder": 39,
    "position": 0,
    "text": "سپهبد چنین داد پاسخ بدوی"
  },
  {
    "poem_id": 1909,
    "vorder": 40,
    "position": 1,
    "text": "که من نیستم چامهٔ گفت وگوی"
  },
  {
    "poem_id": 1909,
    "vorder": 41,
    "position": 0,
    "text": "اگر با سپاه اندر آیم به جنگ"
  },
  {
    "poem_id": 1909,
    "vorder": 42,
    "position": 1,
    "text": "کنم بر بدان جهان جای تنگ"
  },
  {
    "poem_id": 1909,
    "vorder": 43,
    "position": 0,
    "text": "گرامی بد این شهریار جوان"
  },
  {
    "poem_id": 1909,
    "vorder": 44,
    "position": 1,
    "text": "به نزد کنارنگ و هم پهلوان"
  },
  {
    "poem_id": 1909,
    "vorder": 45,
    "position": 0,
    "text": "چو روز چنان مرد کرد او سیاه"
  },
  {
    "poem_id": 1909,
    "vorder": 46,
    "position": 1,
    "text": "مبادا که بیند کسی تاج و گاه"
  },
  {
    "poem_id": 1909,
    "vorder": 47,
    "position": 0,
    "text": "نژند آن زمان شد که بیداد شد"
  },
  {
    "poem_id": 1909,
    "vorder": 48,
    "position": 1,
    "text": "به بیدادگر بندگان شاد شد"
  },
  {
    "poem_id": 1909,
    "vorder": 49,
    "position": 0,
    "text": "سخنهاش چون زاد فرخ شنید"
  },
  {
    "poem_id": 1909,
    "vorder": 50,
    "position": 1,
    "text": "مر او را ز ایرانیان برگزید"
  },
  {
    "poem_id": 1909,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت کاکنون به زندان شویم"
  },
  {
    "poem_id": 1909,
    "vorder": 52,
    "position": 1,
    "text": "به نزدیک آن مستمندان شویم"
  },
  {
    "poem_id": 1909,
    "vorder": 53,
    "position": 0,
    "text": "بیاریم بی‌باک شیروی را"
  },
  {
    "poem_id": 1909,
    "vorder": 54,
    "position": 1,
    "text": "جوان و دلیر جهانجوی را"
  },
  {
    "poem_id": 1909,
    "vorder": 55,
    "position": 0,
    "text": "سپهبد نگهبان زندان اوست"
  },
  {
    "poem_id": 1909,
    "vorder": 56,
    "position": 1,
    "text": "کزو داشتی بیشتر مغز و پوست"
  },
  {
    "poem_id": 1909,
    "vorder": 57,
    "position": 0,
    "text": "ابا شش هزار آزموده سوار"
  },
  {
    "poem_id": 1909,
    "vorder": 58,
    "position": 1,
    "text": "همی‌دارد آن بستگان را به زار"
  },
  {
    "poem_id": 1909,
    "vorder": 59,
    "position": 0,
    "text": "چنین گفت با زاد فرخ تخوار"
  },
  {
    "poem_id": 1909,
    "vorder": 60,
    "position": 1,
    "text": "که کار سپهبد گرفتیم خوار"
  },
  {
    "poem_id": 1909,
    "vorder": 61,
    "position": 0,
    "text": "گرین بخت پرویز گردد جوان"
  },
  {
    "poem_id": 1909,
    "vorder": 62,
    "position": 1,
    "text": "نماند به ایران یکی پهلوان"
  },
  {
    "poem_id": 1909,
    "vorder": 63,
    "position": 0,
    "text": "مگر دار دارند گر چاه وبند"
  },
  {
    "poem_id": 1909,
    "vorder": 64,
    "position": 1,
    "text": "نماند به ایران کسی بی‌گزند"
  },
  {
    "poem_id": 1909,
    "vorder": 65,
    "position": 0,
    "text": "بگفت این و از جای برکند اسپ"
  },
  {
    "poem_id": 1909,
    "vorder": 66,
    "position": 1,
    "text": "همی‌تاخت برسان آذر گشسپ"
  },
  {
    "poem_id": 1909,
    "vorder": 67,
    "position": 0,
    "text": "سپاه اندر آورد یکسر به جنگ"
  },
  {
    "poem_id": 1909,
    "vorder": 68,
    "position": 1,
    "text": "سپهبد پذیره شدش بی درنگ"
  },
  {
    "poem_id": 1909,
    "vorder": 69,
    "position": 0,
    "text": "سر لشکر نامور گشته شد"
  },
  {
    "poem_id": 1909,
    "vorder": 70,
    "position": 1,
    "text": "سپهبد به جنگ اندرون کشته شد"
  },
  {
    "poem_id": 1909,
    "vorder": 71,
    "position": 0,
    "text": "پراگنده شد لشکر شهریار"
  },
  {
    "poem_id": 1909,
    "vorder": 72,
    "position": 1,
    "text": "سیه گشت روز و تبه گشت کار"
  },
  {
    "poem_id": 1909,
    "vorder": 73,
    "position": 0,
    "text": "به زندان تنگ اندر آمد تخوار"
  },
  {
    "poem_id": 1909,
    "vorder": 74,
    "position": 1,
    "text": "بدان چاره با جامهٔ کارزار"
  },
  {
    "poem_id": 1909,
    "vorder": 75,
    "position": 0,
    "text": "به شیروی گردنکش آواز داد"
  },
  {
    "poem_id": 1909,
    "vorder": 76,
    "position": 1,
    "text": "سبک پاسخش نامور باز داد"
  },
  {
    "poem_id": 1909,
    "vorder": 77,
    "position": 0,
    "text": "بدانست شیروی کان سرفراز"
  },
  {
    "poem_id": 1909,
    "vorder": 78,
    "position": 1,
    "text": "بدانگه به زندان چرا شد فراز"
  },
  {
    "poem_id": 1909,
    "vorder": 79,
    "position": 0,
    "text": "چو روی تخوار او فروزان بدید"
  },
  {
    "poem_id": 1909,
    "vorder": 80,
    "position": 1,
    "text": "از اندوه چندان دلش بردمید"
  },
  {
    "poem_id": 1909,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت گریان که خسرو کجاست"
  },
  {
    "poem_id": 1909,
    "vorder": 82,
    "position": 1,
    "text": "رها کردن مانه کار شماست"
  },
  {
    "poem_id": 1909,
    "vorder": 83,
    "position": 0,
    "text": "چنین گفت با شاه‌زاده تخوار"
  },
  {
    "poem_id": 1909,
    "vorder": 84,
    "position": 1,
    "text": "که گر مردمی کام شیران مخوار"
  },
  {
    "poem_id": 1909,
    "vorder": 85,
    "position": 0,
    "text": "اگر تو بدین کار همداستان"
  },
  {
    "poem_id": 1909,
    "vorder": 86,
    "position": 1,
    "text": "نباشی تو کم گیر زین راستان"
  },
  {
    "poem_id": 1909,
    "vorder": 87,
    "position": 0,
    "text": "یکی کم بود شاید از شانزده"
  },
  {
    "poem_id": 1909,
    "vorder": 88,
    "position": 1,
    "text": "برادر بماند تو را پانزده"
  },
  {
    "poem_id": 1909,
    "vorder": 89,
    "position": 0,
    "text": "بشایند هرکس به شاهنشهی"
  },
  {
    "poem_id": 1909,
    "vorder": 90,
    "position": 1,
    "text": "بدیشان بود شاد تخت مهی"
  },
  {
    "poem_id": 1909,
    "vorder": 91,
    "position": 0,
    "text": "فروماند شیروی گریان بجای"
  },
  {
    "poem_id": 1909,
    "vorder": 92,
    "position": 1,
    "text": "ازان خانهٔ تنگ بگذارد پای"
  }
]