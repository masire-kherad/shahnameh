[
  {
    "poem_id": 1797,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید بر چرخ بنمود دست"
  },
  {
    "poem_id": 1797,
    "vorder": 2,
    "position": 1,
    "text": "شهنشاه بر تخت زرین نشست"
  },
  {
    "poem_id": 1797,
    "vorder": 3,
    "position": 0,
    "text": "فرستادهٔ قیصر آمد به در"
  },
  {
    "poem_id": 1797,
    "vorder": 4,
    "position": 1,
    "text": "خرد یافته موبد پرگهر"
  },
  {
    "poem_id": 1797,
    "vorder": 5,
    "position": 0,
    "text": "به پیش شهنشاه رفتند شاد"
  },
  {
    "poem_id": 1797,
    "vorder": 6,
    "position": 1,
    "text": "سخنها ز هرگونه کردند یاد"
  },
  {
    "poem_id": 1797,
    "vorder": 7,
    "position": 0,
    "text": "فرستاده را موبد شاه گفت"
  },
  {
    "poem_id": 1797,
    "vorder": 8,
    "position": 1,
    "text": "که ای مرد هشیار بی‌یار و جفت"
  },
  {
    "poem_id": 1797,
    "vorder": 9,
    "position": 0,
    "text": "ز گیتی زیانکارتر کار چیست"
  },
  {
    "poem_id": 1797,
    "vorder": 10,
    "position": 1,
    "text": "که بر کردهٔ او بباید گریست"
  },
  {
    "poem_id": 1797,
    "vorder": 11,
    "position": 0,
    "text": "چه دانی تو اندر جهان سودمند"
  },
  {
    "poem_id": 1797,
    "vorder": 12,
    "position": 1,
    "text": "که از کردنش مرد گردد بلند"
  },
  {
    "poem_id": 1797,
    "vorder": 13,
    "position": 0,
    "text": "فرستاده گفت آنک دانا بود"
  },
  {
    "poem_id": 1797,
    "vorder": 14,
    "position": 1,
    "text": "همیشه بزرگ و توانا بود"
  },
  {
    "poem_id": 1797,
    "vorder": 15,
    "position": 0,
    "text": "تن مرد نادان ز گل خوارتر"
  },
  {
    "poem_id": 1797,
    "vorder": 16,
    "position": 1,
    "text": "به هر نیکئی ناسزاوارتر"
  },
  {
    "poem_id": 1797,
    "vorder": 17,
    "position": 0,
    "text": "ز نادان و دانا زدی داستان"
  },
  {
    "poem_id": 1797,
    "vorder": 18,
    "position": 1,
    "text": "شنیدی مگر پاسخ راستان"
  },
  {
    "poem_id": 1797,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت موبد که نیکو نگر"
  },
  {
    "poem_id": 1797,
    "vorder": 20,
    "position": 1,
    "text": "بیندیش و ماهی به خشکی مبر"
  },
  {
    "poem_id": 1797,
    "vorder": 21,
    "position": 0,
    "text": "فرستاده گفت ای پسندیده مرد"
  },
  {
    "poem_id": 1797,
    "vorder": 22,
    "position": 1,
    "text": "سخن‌ها ز دانش توان یاد کرد"
  },
  {
    "poem_id": 1797,
    "vorder": 23,
    "position": 0,
    "text": "تو این گر دگرگونه دانی بگوی"
  },
  {
    "poem_id": 1797,
    "vorder": 24,
    "position": 1,
    "text": "که از دانش افزون شود آبروی"
  },
  {
    "poem_id": 1797,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت موبد که اندیشه کن"
  },
  {
    "poem_id": 1797,
    "vorder": 26,
    "position": 1,
    "text": "کز اندیشه بازیب گردد سخن"
  },
  {
    "poem_id": 1797,
    "vorder": 27,
    "position": 0,
    "text": "ز گیتی هرانکو بی‌آزارتر"
  },
  {
    "poem_id": 1797,
    "vorder": 28,
    "position": 1,
    "text": "چنان دان که مرگش زیانکارتر"
  },
  {
    "poem_id": 1797,
    "vorder": 29,
    "position": 0,
    "text": "به مرگ بدان شاد باشی رواست"
  },
  {
    "poem_id": 1797,
    "vorder": 30,
    "position": 1,
    "text": "چو زاید بد و نیک تن مرگ راست"
  },
  {
    "poem_id": 1797,
    "vorder": 31,
    "position": 0,
    "text": "ازین سودمندی بود زان زیان"
  },
  {
    "poem_id": 1797,
    "vorder": 32,
    "position": 1,
    "text": "خرد را میانجی کن اندر میان"
  },
  {
    "poem_id": 1797,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید رومی پسند آمدش"
  },
  {
    "poem_id": 1797,
    "vorder": 34,
    "position": 1,
    "text": "سخنهای او سودمند آمدش"
  },
  {
    "poem_id": 1797,
    "vorder": 35,
    "position": 0,
    "text": "بخندید و بر شاه کرد آفرین"
  },
  {
    "poem_id": 1797,
    "vorder": 36,
    "position": 1,
    "text": "بدو گفت فرخنده ایران زمین"
  },
  {
    "poem_id": 1797,
    "vorder": 37,
    "position": 0,
    "text": "که تخت شهنشاه بیند همی"
  },
  {
    "poem_id": 1797,
    "vorder": 38,
    "position": 1,
    "text": "چو موبد بروبر نشیند همی"
  },
  {
    "poem_id": 1797,
    "vorder": 39,
    "position": 0,
    "text": "به دانش جهان را بلند افسری"
  },
  {
    "poem_id": 1797,
    "vorder": 40,
    "position": 1,
    "text": "به موبد ز هر مهتری برتری"
  },
  {
    "poem_id": 1797,
    "vorder": 41,
    "position": 0,
    "text": "اگر باژ خواهی ز قیصر رواست"
  },
  {
    "poem_id": 1797,
    "vorder": 42,
    "position": 1,
    "text": "ک دستور تو بر جهان پادشاست"
  },
  {
    "poem_id": 1797,
    "vorder": 43,
    "position": 0,
    "text": "ز گفتار او شاد شد شهریار"
  },
  {
    "poem_id": 1797,
    "vorder": 44,
    "position": 1,
    "text": "دلش تازه شد چو گل اندر بهار"
  },
  {
    "poem_id": 1797,
    "vorder": 45,
    "position": 0,
    "text": "برون شد فرستاده از پیش شاه"
  },
  {
    "poem_id": 1797,
    "vorder": 46,
    "position": 1,
    "text": "شب آمد برآمد درفش سیاه"
  },
  {
    "poem_id": 1797,
    "vorder": 47,
    "position": 0,
    "text": "پدید آمد آن چادر مشکبوی"
  },
  {
    "poem_id": 1797,
    "vorder": 48,
    "position": 1,
    "text": "به عنبر بیالود خورشید روی"
  },
  {
    "poem_id": 1797,
    "vorder": 49,
    "position": 0,
    "text": "شکیبا نبد گنبد تیزگرد"
  },
  {
    "poem_id": 1797,
    "vorder": 50,
    "position": 1,
    "text": "سر خفته از خواب بیدار کرد"
  },
  {
    "poem_id": 1797,
    "vorder": 51,
    "position": 0,
    "text": "درفشی بزد چشمهٔ آفتاب"
  },
  {
    "poem_id": 1797,
    "vorder": 52,
    "position": 1,
    "text": "سر شاه گیتی سبک شد ز خواب"
  },
  {
    "poem_id": 1797,
    "vorder": 53,
    "position": 0,
    "text": "در بار بگشاد سالار بار"
  },
  {
    "poem_id": 1797,
    "vorder": 54,
    "position": 1,
    "text": "نشست از بر تخت خود شهریار"
  },
  {
    "poem_id": 1797,
    "vorder": 55,
    "position": 0,
    "text": "بفرمود تا خلعت آراستند"
  },
  {
    "poem_id": 1797,
    "vorder": 56,
    "position": 1,
    "text": "فرستاده را پیش او خواستند"
  },
  {
    "poem_id": 1797,
    "vorder": 57,
    "position": 0,
    "text": "ز سیمین و زرین و اسپ و ستام"
  },
  {
    "poem_id": 1797,
    "vorder": 58,
    "position": 1,
    "text": "ز دینار گیتی که بردند نام"
  },
  {
    "poem_id": 1797,
    "vorder": 59,
    "position": 0,
    "text": "ز دینار و گوهر ز مشک و عبیر"
  },
  {
    "poem_id": 1797,
    "vorder": 60,
    "position": 1,
    "text": "فزون گشت از اندیشهٔ تیزویر"
  }
]