[
  {
    "poem_id": 1876,
    "vorder": 1,
    "position": 0,
    "text": "چو چندی برآمد برین روزگار"
  },
  {
    "poem_id": 1876,
    "vorder": 2,
    "position": 1,
    "text": "شب و روز آسایش آموزگار"
  },
  {
    "poem_id": 1876,
    "vorder": 3,
    "position": 0,
    "text": "چنان بد که در کوه چین آن زمان"
  },
  {
    "poem_id": 1876,
    "vorder": 4,
    "position": 1,
    "text": "دد و دام بودی فزون از گمان"
  },
  {
    "poem_id": 1876,
    "vorder": 5,
    "position": 0,
    "text": "ددی بود مهتر ز اسپی بتن"
  },
  {
    "poem_id": 1876,
    "vorder": 6,
    "position": 1,
    "text": "فروهشته چون مشک گیسو رسن"
  },
  {
    "poem_id": 1876,
    "vorder": 7,
    "position": 0,
    "text": "به تن زرد و گوش و دهانش سیاه"
  },
  {
    "poem_id": 1876,
    "vorder": 8,
    "position": 1,
    "text": "ندیدی کس او را مگر گرمگاه"
  },
  {
    "poem_id": 1876,
    "vorder": 9,
    "position": 0,
    "text": "دو چنگش به کردار چنگ هژبر"
  },
  {
    "poem_id": 1876,
    "vorder": 10,
    "position": 1,
    "text": "خروشش همی‌برگذشتی ز ابر"
  },
  {
    "poem_id": 1876,
    "vorder": 11,
    "position": 0,
    "text": "همی سنگ را درکشیدی به دم"
  },
  {
    "poem_id": 1876,
    "vorder": 12,
    "position": 1,
    "text": "شده روز ازو بر بزرگان دژم"
  },
  {
    "poem_id": 1876,
    "vorder": 13,
    "position": 0,
    "text": "ورا شیر کپی همی‌خواندند"
  },
  {
    "poem_id": 1876,
    "vorder": 14,
    "position": 1,
    "text": "ز رنجش همه بوم در ماندند"
  },
  {
    "poem_id": 1876,
    "vorder": 15,
    "position": 0,
    "text": "یکی دختری داشت خاتون چوماه"
  },
  {
    "poem_id": 1876,
    "vorder": 16,
    "position": 1,
    "text": "اگر ماه دارد دو زلف سیاه"
  },
  {
    "poem_id": 1876,
    "vorder": 17,
    "position": 0,
    "text": "دو لب سرخ و بینی چو تیغ قلم"
  },
  {
    "poem_id": 1876,
    "vorder": 18,
    "position": 1,
    "text": "دو بیجاده خندان و نرگس دژم"
  },
  {
    "poem_id": 1876,
    "vorder": 19,
    "position": 0,
    "text": "بران دخت لرزان بدی مام وباب"
  },
  {
    "poem_id": 1876,
    "vorder": 20,
    "position": 1,
    "text": "اگر تافتی بر سرش آفتاب"
  },
  {
    "poem_id": 1876,
    "vorder": 21,
    "position": 0,
    "text": "چنان بد که روزی پیاده به دشت"
  },
  {
    "poem_id": 1876,
    "vorder": 22,
    "position": 1,
    "text": "همی گرد آن مرغزاران بگشت"
  },
  {
    "poem_id": 1876,
    "vorder": 23,
    "position": 0,
    "text": "جهاندار خاقان ز بهر شکار"
  },
  {
    "poem_id": 1876,
    "vorder": 24,
    "position": 1,
    "text": "بدشتی دگر بود زان مرغزار"
  },
  {
    "poem_id": 1876,
    "vorder": 25,
    "position": 0,
    "text": "همان نیز خاتون به کاخ اندورن"
  },
  {
    "poem_id": 1876,
    "vorder": 26,
    "position": 1,
    "text": "همی رای زد با یکی رهنمون"
  },
  {
    "poem_id": 1876,
    "vorder": 27,
    "position": 0,
    "text": "چو آن شیر کپی ز کوهش بدید"
  },
  {
    "poem_id": 1876,
    "vorder": 28,
    "position": 1,
    "text": "فرود آمد او را به دم درکشید"
  },
  {
    "poem_id": 1876,
    "vorder": 29,
    "position": 0,
    "text": "بیک دم شد او از جهان در نهان"
  },
  {
    "poem_id": 1876,
    "vorder": 30,
    "position": 1,
    "text": "سرآمد بران خوب چهره جهان"
  },
  {
    "poem_id": 1876,
    "vorder": 31,
    "position": 0,
    "text": "چو خاقان شنید آن سیه کرد روی"
  },
  {
    "poem_id": 1876,
    "vorder": 32,
    "position": 1,
    "text": "همان مادرش نیر بر کند موی"
  },
  {
    "poem_id": 1876,
    "vorder": 33,
    "position": 0,
    "text": "ز دردش همه ساله گریان بدند"
  },
  {
    "poem_id": 1876,
    "vorder": 34,
    "position": 1,
    "text": "چو بر آتش تیز بریان بدند"
  },
  {
    "poem_id": 1876,
    "vorder": 35,
    "position": 0,
    "text": "همی چاره جستند زان اژدها"
  },
  {
    "poem_id": 1876,
    "vorder": 36,
    "position": 1,
    "text": "که تا چین کی آید ز چنگش رها"
  },
  {
    "poem_id": 1876,
    "vorder": 37,
    "position": 0,
    "text": "چو بهرام جنگ مقاتوره کرد"
  },
  {
    "poem_id": 1876,
    "vorder": 38,
    "position": 1,
    "text": "وزان مرد جنگی برآورد گرد"
  },
  {
    "poem_id": 1876,
    "vorder": 39,
    "position": 0,
    "text": "همی‌رفت خاتون بدیدار اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 40,
    "position": 1,
    "text": "بهر کس همی‌گفت کردار اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 41,
    "position": 0,
    "text": "چنان بد که یک روز دیدش سوار"
  },
  {
    "poem_id": 1876,
    "vorder": 42,
    "position": 1,
    "text": "از ایران همان نیز صد نامدار"
  },
  {
    "poem_id": 1876,
    "vorder": 43,
    "position": 0,
    "text": "پیاده فراوان به پیش اندرون"
  },
  {
    "poem_id": 1876,
    "vorder": 44,
    "position": 1,
    "text": "همی‌راند بهرام با رهنمون"
  },
  {
    "poem_id": 1876,
    "vorder": 45,
    "position": 0,
    "text": "بپرسید خاتون که این مرد کیست"
  },
  {
    "poem_id": 1876,
    "vorder": 46,
    "position": 1,
    "text": "که با برز و با فرهٔ ایزدیست"
  },
  {
    "poem_id": 1876,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت کهتر که دوری ز کام"
  },
  {
    "poem_id": 1876,
    "vorder": 48,
    "position": 1,
    "text": "که بهرام یل راندانی بنام"
  },
  {
    "poem_id": 1876,
    "vorder": 49,
    "position": 0,
    "text": "به ایران یکی چند گه شاه بود"
  },
  {
    "poem_id": 1876,
    "vorder": 50,
    "position": 1,
    "text": "سرتاج او برتر از ماه بود"
  },
  {
    "poem_id": 1876,
    "vorder": 51,
    "position": 0,
    "text": "بزرگانش خوانند بهرام گرد"
  },
  {
    "poem_id": 1876,
    "vorder": 52,
    "position": 1,
    "text": "که از خسروان نام مردی ببرد"
  },
  {
    "poem_id": 1876,
    "vorder": 53,
    "position": 0,
    "text": "کنون تا بیامد ز ایران بچین"
  },
  {
    "poem_id": 1876,
    "vorder": 54,
    "position": 1,
    "text": "بلرزد همی زیر اسپش زمین"
  },
  {
    "poem_id": 1876,
    "vorder": 55,
    "position": 0,
    "text": "خداوند خواند همی مهترش"
  },
  {
    "poem_id": 1876,
    "vorder": 56,
    "position": 1,
    "text": "همی تاج شاهی نهد بر سرش"
  },
  {
    "poem_id": 1876,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت خاتون که با فر اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 58,
    "position": 1,
    "text": "سزد گر بنازیم در پر اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 59,
    "position": 0,
    "text": "یکی آرزو زو بخواهم درست"
  },
  {
    "poem_id": 1876,
    "vorder": 60,
    "position": 1,
    "text": "چو خاقان نگردد بدان کارسست"
  },
  {
    "poem_id": 1876,
    "vorder": 61,
    "position": 0,
    "text": "بخواهد مگر ز اژدها کین من"
  },
  {
    "poem_id": 1876,
    "vorder": 62,
    "position": 1,
    "text": "برو بشنود درد و نفرین من"
  },
  {
    "poem_id": 1876,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت کهتر گر این داستان"
  },
  {
    "poem_id": 1876,
    "vorder": 64,
    "position": 1,
    "text": "بخواند برو مهتر راستان"
  },
  {
    "poem_id": 1876,
    "vorder": 65,
    "position": 0,
    "text": "تو از شیر کپی نیابی نشان"
  },
  {
    "poem_id": 1876,
    "vorder": 66,
    "position": 1,
    "text": "مگر کشته و گرگ پایش کشان"
  },
  {
    "poem_id": 1876,
    "vorder": 67,
    "position": 0,
    "text": "چو خاتون شنید این سخن شاد شد"
  },
  {
    "poem_id": 1876,
    "vorder": 68,
    "position": 1,
    "text": "ز تیمار آن دختر آزاد شد"
  },
  {
    "poem_id": 1876,
    "vorder": 69,
    "position": 0,
    "text": "همی‌تاخت تا پیش خاقان رسید"
  },
  {
    "poem_id": 1876,
    "vorder": 70,
    "position": 1,
    "text": "یکایک بگفت آنچ دید وشنید"
  },
  {
    "poem_id": 1876,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت خاقان که عاری بود"
  },
  {
    "poem_id": 1876,
    "vorder": 72,
    "position": 1,
    "text": "بجایی که چون من سواری بود"
  },
  {
    "poem_id": 1876,
    "vorder": 73,
    "position": 0,
    "text": "همی شیر کپی خورد دخترم"
  },
  {
    "poem_id": 1876,
    "vorder": 74,
    "position": 1,
    "text": "بگوییم و ننگی شود گوهرم"
  },
  {
    "poem_id": 1876,
    "vorder": 75,
    "position": 0,
    "text": "ندانند کان اژدهای دژم"
  },
  {
    "poem_id": 1876,
    "vorder": 76,
    "position": 1,
    "text": "همی کوه آهن رباید به دم"
  },
  {
    "poem_id": 1876,
    "vorder": 77,
    "position": 0,
    "text": "اگر دختر شاه نامی بود"
  },
  {
    "poem_id": 1876,
    "vorder": 78,
    "position": 1,
    "text": "همان شاه را جان گرامی بود"
  },
  {
    "poem_id": 1876,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت خاتون که من کین خویش"
  },
  {
    "poem_id": 1876,
    "vorder": 80,
    "position": 1,
    "text": "بخواهم ز بهر جهان بین خویش"
  },
  {
    "poem_id": 1876,
    "vorder": 81,
    "position": 0,
    "text": "اگر ننگ باشد وگر نام من"
  },
  {
    "poem_id": 1876,
    "vorder": 82,
    "position": 1,
    "text": "بگویم برآید مگر کام من"
  },
  {
    "poem_id": 1876,
    "vorder": 83,
    "position": 0,
    "text": "برآمد برین نیز روز دراز"
  },
  {
    "poem_id": 1876,
    "vorder": 84,
    "position": 1,
    "text": "نهانی ز هرکس همی‌داشت راز"
  },
  {
    "poem_id": 1876,
    "vorder": 85,
    "position": 0,
    "text": "چنان بد که خاقان یکی سور کرد"
  },
  {
    "poem_id": 1876,
    "vorder": 86,
    "position": 1,
    "text": "جهان را بران سور پر نور کرد"
  },
  {
    "poem_id": 1876,
    "vorder": 87,
    "position": 0,
    "text": "فرستاد بهرام یل رابخواند"
  },
  {
    "poem_id": 1876,
    "vorder": 88,
    "position": 1,
    "text": "چو آمدش برتخت زرین نشاند"
  },
  {
    "poem_id": 1876,
    "vorder": 89,
    "position": 0,
    "text": "چو خاتون پس پرده آوا شنید"
  },
  {
    "poem_id": 1876,
    "vorder": 90,
    "position": 1,
    "text": "بشد تیز و بهرام یل را بدید"
  },
  {
    "poem_id": 1876,
    "vorder": 91,
    "position": 0,
    "text": "فراوانش بستود وکرد آفرین"
  },
  {
    "poem_id": 1876,
    "vorder": 92,
    "position": 1,
    "text": "که آباد بادا بتو ترک و چین"
  },
  {
    "poem_id": 1876,
    "vorder": 93,
    "position": 0,
    "text": "یکی آرزو خواهم از شهریار"
  },
  {
    "poem_id": 1876,
    "vorder": 94,
    "position": 1,
    "text": "که باشد بران آرزو کامگار"
  },
  {
    "poem_id": 1876,
    "vorder": 95,
    "position": 0,
    "text": "بدو گفت بهرام فرمان تو راست"
  },
  {
    "poem_id": 1876,
    "vorder": 96,
    "position": 1,
    "text": "برین آرزو کام و پیمان تو راست"
  },
  {
    "poem_id": 1876,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت خاتون کز ایدر نه دور"
  },
  {
    "poem_id": 1876,
    "vorder": 98,
    "position": 1,
    "text": "یکی مرغزارست زیبای سور"
  },
  {
    "poem_id": 1876,
    "vorder": 99,
    "position": 0,
    "text": "جوانان چین اندران مرغزار"
  },
  {
    "poem_id": 1876,
    "vorder": 100,
    "position": 1,
    "text": "یکی جشن سازند گاه بهار"
  },
  {
    "poem_id": 1876,
    "vorder": 101,
    "position": 0,
    "text": "ازان بیشه پرتاب یک تیروار"
  },
  {
    "poem_id": 1876,
    "vorder": 102,
    "position": 1,
    "text": "یکی کوه بینی سیه‌تر ز قار"
  },
  {
    "poem_id": 1876,
    "vorder": 103,
    "position": 0,
    "text": "بران کوه خارا یکی اژدهاست"
  },
  {
    "poem_id": 1876,
    "vorder": 104,
    "position": 1,
    "text": "که این کشور چین ازو در بلاست"
  },
  {
    "poem_id": 1876,
    "vorder": 105,
    "position": 0,
    "text": "یکی شیر کپیش خواند همی"
  },
  {
    "poem_id": 1876,
    "vorder": 106,
    "position": 1,
    "text": "دگر نیز نامش نداند همی"
  },
  {
    "poem_id": 1876,
    "vorder": 107,
    "position": 0,
    "text": "یکی دخترم بد ز خاقان چین"
  },
  {
    "poem_id": 1876,
    "vorder": 108,
    "position": 1,
    "text": "که خورشید کردی برو آفرین"
  },
  {
    "poem_id": 1876,
    "vorder": 109,
    "position": 0,
    "text": "از ایوان بشد نزد آن جشنگاه"
  },
  {
    "poem_id": 1876,
    "vorder": 110,
    "position": 1,
    "text": "که خاقان به نخچیر بد با سپاه"
  },
  {
    "poem_id": 1876,
    "vorder": 111,
    "position": 0,
    "text": "بیامد ز کوه اژدهای دژم"
  },
  {
    "poem_id": 1876,
    "vorder": 112,
    "position": 1,
    "text": "کشید آن بهار مرا او بدم"
  },
  {
    "poem_id": 1876,
    "vorder": 113,
    "position": 0,
    "text": "کنون هر بهاری بران مرغزار"
  },
  {
    "poem_id": 1876,
    "vorder": 114,
    "position": 1,
    "text": "چنان هم بیاید ز بهر شکار"
  },
  {
    "poem_id": 1876,
    "vorder": 115,
    "position": 0,
    "text": "برین شهر ما را جوانی نماند"
  },
  {
    "poem_id": 1876,
    "vorder": 116,
    "position": 1,
    "text": "همان نامور پهلوانی نماند"
  },
  {
    "poem_id": 1876,
    "vorder": 117,
    "position": 0,
    "text": "شدند از پی شیرکپی هلاک"
  },
  {
    "poem_id": 1876,
    "vorder": 118,
    "position": 1,
    "text": "برانگیخت از بوم آباد خاک"
  },
  {
    "poem_id": 1876,
    "vorder": 119,
    "position": 0,
    "text": "سواران چینی ومردان کار"
  },
  {
    "poem_id": 1876,
    "vorder": 120,
    "position": 1,
    "text": "بسی تاختند اندران کوهسار"
  },
  {
    "poem_id": 1876,
    "vorder": 121,
    "position": 0,
    "text": "چو از دور بینند چنگال اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 122,
    "position": 1,
    "text": "برو پشت و گوش و سر و یال اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 123,
    "position": 0,
    "text": "بغرد بدرد دل مرد جنگ"
  },
  {
    "poem_id": 1876,
    "vorder": 124,
    "position": 1,
    "text": "مر او را چه شیر و چه پیل و نهنگ"
  },
  {
    "poem_id": 1876,
    "vorder": 125,
    "position": 0,
    "text": "کس اندر نیارد شدن پیش اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 126,
    "position": 1,
    "text": "چوگیرد شمار کم و بیش اوی"
  },
  {
    "poem_id": 1876,
    "vorder": 127,
    "position": 0,
    "text": "بدو گفت بهرام فردا پگاه"
  },
  {
    "poem_id": 1876,
    "vorder": 128,
    "position": 1,
    "text": "بیایم ببینم من این جشنگاه"
  },
  {
    "poem_id": 1876,
    "vorder": 129,
    "position": 0,
