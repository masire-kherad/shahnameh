[
  {
    "poem_id": 1375,
    "vorder": 1,
    "position": 0,
    "text": "به شاه آفریدون یکی نامه کرد"
  },
  {
    "poem_id": 1375,
    "vorder": 2,
    "position": 1,
    "text": "ز مشک و ز عنبر سر خامه کرد"
  },
  {
    "poem_id": 1375,
    "vorder": 3,
    "position": 0,
    "text": "نخست از جهان آفرین کرد یاد"
  },
  {
    "poem_id": 1375,
    "vorder": 4,
    "position": 1,
    "text": "خداوند خوبی و پاکی و داد"
  },
  {
    "poem_id": 1375,
    "vorder": 5,
    "position": 0,
    "text": "سپاس از جهاندار فریادرس"
  },
  {
    "poem_id": 1375,
    "vorder": 6,
    "position": 1,
    "text": "نگیرد به سختی جز او دست کس"
  },
  {
    "poem_id": 1375,
    "vorder": 7,
    "position": 0,
    "text": "دگر آفرین بر فریدون برز"
  },
  {
    "poem_id": 1375,
    "vorder": 8,
    "position": 1,
    "text": "خداوند تاج و خداوند گرز"
  },
  {
    "poem_id": 1375,
    "vorder": 9,
    "position": 0,
    "text": "همش داد و هم دین و هم فرهی"
  },
  {
    "poem_id": 1375,
    "vorder": 10,
    "position": 1,
    "text": "همش تاج و هم تخت شاهنشهی"
  },
  {
    "poem_id": 1375,
    "vorder": 11,
    "position": 0,
    "text": "همه راستی راست از بخت اوست"
  },
  {
    "poem_id": 1375,
    "vorder": 12,
    "position": 1,
    "text": "همه فر و زیبایی از تخت اوست"
  },
  {
    "poem_id": 1375,
    "vorder": 13,
    "position": 0,
    "text": "رسیدم به خوبی بتوران زمین"
  },
  {
    "poem_id": 1375,
    "vorder": 14,
    "position": 1,
    "text": "سپه برکشیدیم و جستیم کین"
  },
  {
    "poem_id": 1375,
    "vorder": 15,
    "position": 0,
    "text": "سه جنگ گران کرده شد در سه روز"
  },
  {
    "poem_id": 1375,
    "vorder": 16,
    "position": 1,
    "text": "چه در شب چه در هور گیتی فروز"
  },
  {
    "poem_id": 1375,
    "vorder": 17,
    "position": 0,
    "text": "از ایشان شبیخون و از ماکمین"
  },
  {
    "poem_id": 1375,
    "vorder": 18,
    "position": 1,
    "text": "کشیدیم و جستیم هر گونه کین"
  },
  {
    "poem_id": 1375,
    "vorder": 19,
    "position": 0,
    "text": "شنیدم که ساز شبیخون گرفت"
  },
  {
    "poem_id": 1375,
    "vorder": 20,
    "position": 1,
    "text": "ز بیچارگی بند افسون گرفت"
  },
  {
    "poem_id": 1375,
    "vorder": 21,
    "position": 0,
    "text": "کمین ساختم از پس پشت اوی"
  },
  {
    "poem_id": 1375,
    "vorder": 22,
    "position": 1,
    "text": "نماندم به جز باد در مشت اوی"
  },
  {
    "poem_id": 1375,
    "vorder": 23,
    "position": 0,
    "text": "یکایک چو از جنگ برگاشت روی"
  },
  {
    "poem_id": 1375,
    "vorder": 24,
    "position": 1,
    "text": "پی اندر گرفتم رسیدم بدوی"
  },
  {
    "poem_id": 1375,
    "vorder": 25,
    "position": 0,
    "text": "بخفتانش بر نیزه بگذاشتم"
  },
  {
    "poem_id": 1375,
    "vorder": 26,
    "position": 1,
    "text": "به نیرو ازان زینش برداشتم"
  },
  {
    "poem_id": 1375,
    "vorder": 27,
    "position": 0,
    "text": "بینداختم چون یکی اژدها"
  },
  {
    "poem_id": 1375,
    "vorder": 28,
    "position": 1,
    "text": "بریدم سرش از تن بی‌بها"
  },
  {
    "poem_id": 1375,
    "vorder": 29,
    "position": 0,
    "text": "فرستادم اینک به نزد نیا"
  },
  {
    "poem_id": 1375,
    "vorder": 30,
    "position": 1,
    "text": "بسازم کنون سلم را کیمیا"
  },
  {
    "poem_id": 1375,
    "vorder": 31,
    "position": 0,
    "text": "چنان چون سر ایرج شهریار"
  },
  {
    "poem_id": 1375,
    "vorder": 32,
    "position": 1,
    "text": "به تابوت زر اندر افگند خوار"
  },
  {
    "poem_id": 1375,
    "vorder": 33,
    "position": 0,
    "text": "به نامه درون این سخن کرد یاد"
  },
  {
    "poem_id": 1375,
    "vorder": 34,
    "position": 1,
    "text": "هیونی برافگند برسان باد"
  },
  {
    "poem_id": 1375,
    "vorder": 35,
    "position": 0,
    "text": "فرستاده آمد رخی پر ز شرم"
  },
  {
    "poem_id": 1375,
    "vorder": 36,
    "position": 1,
    "text": "دو چشم از فریدون پر از آب گرم"
  },
  {
    "poem_id": 1375,
    "vorder": 37,
    "position": 0,
    "text": "که چون برد خواهد سر شاه چین"
  },
  {
    "poem_id": 1375,
    "vorder": 38,
    "position": 1,
    "text": "بریده بر شاه ایران زمین"
  },
  {
    "poem_id": 1375,
    "vorder": 39,
    "position": 0,
    "text": "که فرزند گر سر بپیچید ز دین"
  },
  {
    "poem_id": 1375,
    "vorder": 40,
    "position": 1,
    "text": "پدر را بدو مهر افزون ز کین"
  },
  {
    "poem_id": 1375,
    "vorder": 41,
    "position": 0,
    "text": "گنه بس گران بود و پوزش نبرد"
  },
  {
    "poem_id": 1375,
    "vorder": 42,
    "position": 1,
    "text": "و دیگر که کین خواه او بود گرد"
  },
  {
    "poem_id": 1375,
    "vorder": 43,
    "position": 0,
    "text": "بیامد فرستادهٔ شوخ روی"
  },
  {
    "poem_id": 1375,
    "vorder": 44,
    "position": 1,
    "text": "سر تور بنهاد در پیش اوی"
  },
  {
    "poem_id": 1375,
    "vorder": 45,
    "position": 0,
    "text": "فریدون همی بر منوچهر بر"
  },
  {
    "poem_id": 1375,
    "vorder": 46,
    "position": 1,
    "text": "یکی آفرین خواست از دادگر"
  }
]