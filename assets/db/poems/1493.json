[
  {
    "poem_id": 1493,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد به کاووس شاه"
  },
  {
    "poem_id": 1493,
    "vorder": 2,
    "position": 1,
    "text": "که شد روزگار سیاوش تباه"
  },
  {
    "poem_id": 1493,
    "vorder": 3,
    "position": 0,
    "text": "به کردار مرغان سرش را ز تن"
  },
  {
    "poem_id": 1493,
    "vorder": 4,
    "position": 1,
    "text": "جدا کرد سالار آن انجمن"
  },
  {
    "poem_id": 1493,
    "vorder": 5,
    "position": 0,
    "text": "ابر بی‌گناهش به خنجر به زار"
  },
  {
    "poem_id": 1493,
    "vorder": 6,
    "position": 1,
    "text": "بریدند سر زان تن شاهوار"
  },
  {
    "poem_id": 1493,
    "vorder": 7,
    "position": 0,
    "text": "بنالد همی بلبل از شاخ سرو"
  },
  {
    "poem_id": 1493,
    "vorder": 8,
    "position": 1,
    "text": "چو دراج زیر گلان با تذرو"
  },
  {
    "poem_id": 1493,
    "vorder": 9,
    "position": 0,
    "text": "همه شهر توران پر از داغ و درد"
  },
  {
    "poem_id": 1493,
    "vorder": 10,
    "position": 1,
    "text": "به بیشه درون برگ گلنار زرد"
  },
  {
    "poem_id": 1493,
    "vorder": 11,
    "position": 0,
    "text": "گرفتند شیون به هر کوهسار"
  },
  {
    "poem_id": 1493,
    "vorder": 12,
    "position": 1,
    "text": "نه فریادرس بود و نه خواستار"
  },
  {
    "poem_id": 1493,
    "vorder": 13,
    "position": 0,
    "text": "چو این گفته بشنید کاووس شاه"
  },
  {
    "poem_id": 1493,
    "vorder": 14,
    "position": 1,
    "text": "سر نامدارش نگون شد ز گاه"
  },
  {
    "poem_id": 1493,
    "vorder": 15,
    "position": 0,
    "text": "بر و جامه بدرید و رخ را بکند"
  },
  {
    "poem_id": 1493,
    "vorder": 16,
    "position": 1,
    "text": "به خاک اندر آمد ز تخت بلند"
  },
  {
    "poem_id": 1493,
    "vorder": 17,
    "position": 0,
    "text": "برفتند با مویه ایرانیان"
  },
  {
    "poem_id": 1493,
    "vorder": 18,
    "position": 1,
    "text": "بدان سوگ بسته به زاری میان"
  },
  {
    "poem_id": 1493,
    "vorder": 19,
    "position": 0,
    "text": "همه دیده پرخون و رخساره زرد"
  },
  {
    "poem_id": 1493,
    "vorder": 20,
    "position": 1,
    "text": "زبان از سیاوش پر از یادکرد"
  },
  {
    "poem_id": 1493,
    "vorder": 21,
    "position": 0,
    "text": "چو طوس و چو گودرز و گیو دلیر"
  },
  {
    "poem_id": 1493,
    "vorder": 22,
    "position": 1,
    "text": "چو شاپور و فرهاد و رهام شیر"
  },
  {
    "poem_id": 1493,
    "vorder": 23,
    "position": 0,
    "text": "همه جامه کرده کبود و سیاه"
  },
  {
    "poem_id": 1493,
    "vorder": 24,
    "position": 1,
    "text": "همه خاک بر سر بجای کلاه"
  },
  {
    "poem_id": 1493,
    "vorder": 25,
    "position": 0,
    "text": "پس آگاهی آمد سوی نیمروز"
  },
  {
    "poem_id": 1493,
    "vorder": 26,
    "position": 1,
    "text": "به نزدیک سالار گیتی فروز"
  },
  {
    "poem_id": 1493,
    "vorder": 27,
    "position": 0,
    "text": "که از شهر ایران برآمد خروش"
  },
  {
    "poem_id": 1493,
    "vorder": 28,
    "position": 1,
    "text": "همی خاک تیره برآمد به جوش"
  },
  {
    "poem_id": 1493,
    "vorder": 29,
    "position": 0,
    "text": "پراگند کاووس بر یال خاک"
  },
  {
    "poem_id": 1493,
    "vorder": 30,
    "position": 1,
    "text": "همه جامهٔ خسروی کرد چاک"
  },
  {
    "poem_id": 1493,
    "vorder": 31,
    "position": 0,
    "text": "تهمتن چو بشنید زو رفت هوش"
  },
  {
    "poem_id": 1493,
    "vorder": 32,
    "position": 1,
    "text": "ز زابل به زاری برآمد خروش"
  },
  {
    "poem_id": 1493,
    "vorder": 33,
    "position": 0,
    "text": "به چنگال رخساره بشخود زال"
  },
  {
    "poem_id": 1493,
    "vorder": 34,
    "position": 1,
    "text": "همی ریخت خاک از بر شاخ و یال"
  },
  {
    "poem_id": 1493,
    "vorder": 35,
    "position": 0,
    "text": "چو یک هفته با سوگ بود و دژم"
  },
  {
    "poem_id": 1493,
    "vorder": 36,
    "position": 1,
    "text": "به هشتم برآمد ز شیپور دم"
  },
  {
    "poem_id": 1493,
    "vorder": 37,
    "position": 0,
    "text": "سپاهی فراوان بر پیلتن"
  },
  {
    "poem_id": 1493,
    "vorder": 38,
    "position": 1,
    "text": "ز کشمیر و کابل شدند انجمن"
  },
  {
    "poem_id": 1493,
    "vorder": 39,
    "position": 0,
    "text": "به درگاه کاووس بنهاد روی"
  },
  {
    "poem_id": 1493,
    "vorder": 40,
    "position": 1,
    "text": "دو دیده پر از آب و دل کینه جوی"
  },
  {
    "poem_id": 1493,
    "vorder": 41,
    "position": 0,
    "text": "چو نزدیکی شهر ایران رسید"
  },
  {
    "poem_id": 1493,
    "vorder": 42,
    "position": 1,
    "text": "همه جامهٔ پهلوی بردرید"
  },
  {
    "poem_id": 1493,
    "vorder": 43,
    "position": 0,
    "text": "به دادار دارنده سوگند خورد"
  },
  {
    "poem_id": 1493,
    "vorder": 44,
    "position": 1,
    "text": "که هرگز تنم بی‌سلیح نبرد"
  },
  {
    "poem_id": 1493,
    "vorder": 45,
    "position": 0,
    "text": "نباشد بشویم سرم را ز خاک"
  },
  {
    "poem_id": 1493,
    "vorder": 46,
    "position": 1,
    "text": "همه بر تن غم بود سوگناک"
  },
  {
    "poem_id": 1493,
    "vorder": 47,
    "position": 0,
    "text": "کله ترگ و شمشیر جام منست"
  },
  {
    "poem_id": 1493,
    "vorder": 48,
    "position": 1,
    "text": "به بازو خم خام دام منست"
  },
  {
    "poem_id": 1493,
    "vorder": 49,
    "position": 0,
    "text": "چو آمد به نزدیک کاووس کی"
  },
  {
    "poem_id": 1493,
    "vorder": 50,
    "position": 1,
    "text": "سرش بود پرخاک و پرخاک پی"
  },
  {
    "poem_id": 1493,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت خوی بد ای شهریار"
  },
  {
    "poem_id": 1493,
    "vorder": 52,
    "position": 1,
    "text": "پراگندی و تخمت آمد ببار"
  },
  {
    "poem_id": 1493,
    "vorder": 53,
    "position": 0,
    "text": "ترا مهر سودابه و بدخوی"
  },
  {
    "poem_id": 1493,
    "vorder": 54,
    "position": 1,
    "text": "ز سر برگرفت افسر خسروی"
  },
  {
    "poem_id": 1493,
    "vorder": 55,
    "position": 0,
    "text": "کنون آشکارا ببینی همی"
  },
  {
    "poem_id": 1493,
    "vorder": 56,
    "position": 1,
    "text": "که بر موج دریا نشینی همی"
  },
  {
    "poem_id": 1493,
    "vorder": 57,
    "position": 0,
    "text": "از اندیشهٔ خرد و شاه سترگ"
  },
  {
    "poem_id": 1493,
    "vorder": 58,
    "position": 1,
    "text": "بیامد به ما بر زیانی بزرگ"
  },
  {
    "poem_id": 1493,
    "vorder": 59,
    "position": 0,
    "text": "کسی کاو بود مهتر انجمن"
  },
  {
    "poem_id": 1493,
    "vorder": 60,
    "position": 1,
    "text": "کفن بهتر او را ز فرمان زن"
  },
  {
    "poem_id": 1493,
    "vorder": 61,
    "position": 0,
    "text": "سیاوش به گفتار زن شد به باد"
  },
  {
    "poem_id": 1493,
    "vorder": 62,
    "position": 1,
    "text": "خجسته زنی کاو ز مادر نزاد"
  },
  {
    "poem_id": 1493,
    "vorder": 63,
    "position": 0,
    "text": "دریغ آن بر و برز و بالای او"
  },
  {
    "poem_id": 1493,
    "vorder": 64,
    "position": 1,
    "text": "رکیب و خم خسرو آرای او"
  },
  {
    "poem_id": 1493,
    "vorder": 65,
    "position": 0,
    "text": "دریغ آن گو نامبرده سوار"
  },
  {
    "poem_id": 1493,
    "vorder": 66,
    "position": 1,
    "text": "که چون او نبیند دگر روزگار"
  },
  {
    "poem_id": 1493,
    "vorder": 67,
    "position": 0,
    "text": "چو در بزم بودی بهاران بدی"
  },
  {
    "poem_id": 1493,
    "vorder": 68,
    "position": 1,
    "text": "به رزم افسر نامداران بدی"
  },
  {
    "poem_id": 1493,
    "vorder": 69,
    "position": 0,
    "text": "همی جنگ با چشم گریان کنم"
  },
  {
    "poem_id": 1493,
    "vorder": 70,
    "position": 1,
    "text": "جهان چون دل خویش بریان کنم"
  },
  {
    "poem_id": 1493,
    "vorder": 71,
    "position": 0,
    "text": "نگه کرد کاووس بر چهر او"
  },
  {
    "poem_id": 1493,
    "vorder": 72,
    "position": 1,
    "text": "بدید اشک خونین و آن مهر او"
  },
  {
    "poem_id": 1493,
    "vorder": 73,
    "position": 0,
    "text": "نداد ایچ پاسخ مر او را ز شرم"
  },
  {
    "poem_id": 1493,
    "vorder": 74,
    "position": 1,
    "text": "فرو ریخت از دیدگان آب گرم"
  },
  {
    "poem_id": 1493,
    "vorder": 75,
    "position": 0,
    "text": "تهمتن برفت از بر تخت اوی"
  },
  {
    "poem_id": 1493,
    "vorder": 76,
    "position": 1,
    "text": "سوی خان سودابه بنهاد روی"
  },
  {
    "poem_id": 1493,
    "vorder": 77,
    "position": 0,
    "text": "ز پرده به گیسوش بیرون کشید"
  },
  {
    "poem_id": 1493,
    "vorder": 78,
    "position": 1,
    "text": "ز تخت بزرگیش در خون کشید"
  },
  {
    "poem_id": 1493,
    "vorder": 79,
    "position": 0,
    "text": "به خنجر به دو نیم کردش به راه"
  },
  {
    "poem_id": 1493,
    "vorder": 80,
    "position": 1,
    "text": "نجنبید بر جای کاووس شاه"
  },
  {
    "poem_id": 1493,
    "vorder": 81,
    "position": 0,
    "text": "بیامد به درگاه با سوگ و درد"
  },
  {
    "poem_id": 1493,
    "vorder": 82,
    "position": 1,
    "text": "پر از خون دل و دیده رخساره زرد"
  },
  {
    "poem_id": 1493,
    "vorder": 83,
    "position": 0,
    "text": "همه شهر ایران به ماتم شدند"
  },
  {
    "poem_id": 1493,
    "vorder": 84,
    "position": 1,
    "text": "پر از درد نزدیک رستم شدند"
  },
  {
    "poem_id": 1493,
    "vorder": 85,
    "position": 0,
    "text": "چو یک هفته با سوگ و با آب چشم"
  },
  {
    "poem_id": 1493,
    "vorder": 86,
    "position": 1,
    "text": "به درگاه بنشست پر درد و خشم"
  },
  {
    "poem_id": 1493,
    "vorder": 87,
    "position": 0,
    "text": "به هشتم بزد نای رویین و کوس"
  },
  {
    "poem_id": 1493,
    "vorder": 88,
    "position": 1,
    "text": "بیامد به درگاه گودرز و طوس"
  },
  {
    "poem_id": 1493,
    "vorder": 89,
    "position": 0,
    "text": "چو فرهاد و شیدوش و گرگین و گیو"
  },
  {
    "poem_id": 1493,
    "vorder": 90,
    "position": 1,
    "text": "چو بهرام و رهام و شاپور نیو"
  },
  {
    "poem_id": 1493,
    "vorder": 91,
    "position": 0,
    "text": "فریبرز کاووس درنده شیر"
  },
  {
    "poem_id": 1493,
    "vorder": 92,
    "position": 1,
    "text": "گرازه که بود اژدهای دلیر"
  },
  {
    "poem_id": 1493,
    "vorder": 93,
    "position": 0,
    "text": "فرامرز رستم که بد پیش رو"
  },
  {
    "poem_id": 1493,
    "vorder": 94,
    "position": 1,
    "text": "نگهبان هر مرز و سالار نو"
  },
  {
    "poem_id": 1493,
    "vorder": 95,
    "position": 0,
    "text": "به گردان چنین گفت رستم که من"
  },
  {
    "poem_id": 1493,
    "vorder": 96,
    "position": 1,
    "text": "برین کینه دادم دل و جان و تن"
  },
  {
    "poem_id": 1493,
    "vorder": 97,
    "position": 0,
    "text": "که اندر جهان چون سیاوش سوار"
  },
  {
    "poem_id": 1493,
    "vorder": 98,
    "position": 1,
    "text": "نبندد کمر نیز یک نامدار"
  },
  {
    "poem_id": 1493,
    "vorder": 99,
    "position": 0,
    "text": "چنین کار یکسر مدارید خرد"
  },
  {
    "poem_id": 1493,
    "vorder": 100,
    "position": 1,
    "text": "چنین کینه را خرد نتوان شمرد"
  },
  {
    "poem_id": 1493,
    "vorder": 101,
    "position": 0,
    "text": "ز دلها همه ترس بیرون کنید"
  },
  {
    "poem_id": 1493,
    "vorder": 102,
    "position": 1,
    "text": "زمین را ز خون رود جیحون کنید"
  },
  {
    "poem_id": 1493,
    "vorder": 103,
    "position": 0,
    "text": "به یزدان که تا در جهان زنده‌ام"
  },
  {
    "poem_id": 1493,
    "vorder": 104,
    "position": 1,
    "text": "به کین سیاوش دل آگنده‌ام"
  },
  {
    "poem_id": 1493,
    "vorder": 105,
    "position": 0,
    "text": "بران تشت زرین کجا خون اوی"
  },
  {
    "poem_id": 1493,
    "vorder": 106,
    "position": 1,
    "text": "فرو ریخت ناکاردیده گروی"
  },
  {
    "poem_id": 1493,
    "vorder": 107,
    "position": 0,
    "text": "بمالید خواهم همی روی و چشم"
  },
  {
    "poem_id": 1493,
    "vorder": 108,
    "position": 1,
    "text": "مگر بر دلم کم شود درد و خشم"
  },
  {
    "poem_id": 1493,
    "vorder": 109,
    "position": 0,
    "text": "وگر همچنانم بود بسته چنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 110,
    "position": 1,
    "text": "نهاده به گردن درون پالهنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 111,
    "position": 0,
    "text": "به خاک اندرون خوار چون گوسفند"
  },
  {
    "poem_id": 1493,
    "vorder": 112,
    "position": 1,
    "text": "کشندم دو بازو به خم کمند"
  },
  {
    "poem_id": 1493,
    "vorder": 113,
    "position": 0,
    "text": "و گر نه من و گرز و شمشیر تیز"
  },
  {
    "poem_id": 1493,
    "vorder": 114,
    "position": 1,
    "text": "برانگیزم اندر جهان رستخیز"
  },
  {
    "poem_id": 1493,
    "vorder": 115,
    "position": 0,
    "text": "نبیند دو چشمم مگر گرد رزم"
  },
  {
    "poem_id": 1493,
    "vorder": 116,
    "position": 1,
    "text": "حرامست بر من می و جام و بزم"
  },
  {
    "poem_id": 1493,
    "vorder": 117,
    "position": 0,
    "text": "به درگاه هر پهلوانی که بود"
  },
  {
    "poem_id": 1493,
    "vorder": 118,
    "position": 1,
    "text": "چو زان گونه آواز رستم شنود"
  },
  {
    "poem_id": 1493,
    "vorder": 119,
    "position": 0,
    "text": "همه برگرفتند با او خروش"
  },
  {
    "poem_id": 1493,
    "vorder": 120,
    "position": 1,
    "text": "تو گفتی که میدان برآمد به جوش"
  },
  {
    "poem_id": 1493,
    "vorder": 121,
    "position": 0,
    "text": "ز میدان یکی بانگ برشد به ابر"
  },
  {
    "poem_id": 1493,
    "vorder": 122,
    "position": 1,
    "text": "تو گفتی زمین شد به کام هژبر"
  },
  {
    "poem_id": 1493,
    "vorder": 123,
    "position": 0,
    "text": "بزد مهره بر پشت پیلان به جام"
  },
  {
    "poem_id": 1493,
    "vorder": 124,
    "position": 1,
    "text": "یلان بر کشیدند تیغ از نیام"
  },
  {
    "poem_id": 1493,
    "vorder": 125,
    "position": 0,
    "text": "برآمد خروشیدن گاودم"
  },
  {
    "poem_id": 1493,
    "vorder": 126,
    "position": 1,
    "text": "دم نای رویین و رویینه خم"
  },
  {
    "poem_id": 1493,
    "vorder": 127,
    "position": 0,
    "text": "جهان پر شد از کین افراسیاب"
  },
  {
    "poem_id": 1493,
    "vorder": 128,
    "position": 1,
    "text": "به دریا تو گفتی به جوش آمد آب"
  },
  {
    "poem_id": 1493,
    "vorder": 129,
    "position": 0,
    "text": "نبد جای پوینده را بر زمین"
  },
  {
    "poem_id": 1493,
    "vorder": 130,
    "position": 1,
    "text": "ز نیزه هوا ماند اندر کمین"
  },
  {
    "poem_id": 1493,
    "vorder": 131,
    "position": 0,
    "text": "ستاره به جنگ اندر آمد نخست"
  },
  {
    "poem_id": 1493,
    "vorder": 132,
    "position": 1,
    "text": "زمین و زمان دست خون را بشست"
  },
  {
    "poem_id": 1493,
    "vorder": 133,
    "position": 0,
    "text": "ببستند گردان ایران میان"
  },
  {
    "poem_id": 1493,
    "vorder": 134,
    "position": 1,
    "text": "به پیش اندرون اختر کاویان"
  },
  {
    "poem_id": 1493,
    "vorder": 135,
    "position": 0,
    "text": "گزین کرد پس رستم زابلی"
  },
  {
    "poem_id": 1493,
    "vorder": 136,
    "position": 1,
    "text": "ز گردان شمشیرزن کابلی"
  },
  {
    "poem_id": 1493,
    "vorder": 137,
    "position": 0,
    "text": "ز ایران و از بیشهٔ نارون"
  },
  {
    "poem_id": 1493,
    "vorder": 138,
    "position": 1,
    "text": "ده و دو هزار از یلان انجمن"
  },
  {
    "poem_id": 1493,
    "vorder": 139,
    "position": 0,
    "text": "سپه را فرامرز بد پیش‌رو"
  },
  {
    "poem_id": 1493,
    "vorder": 140,
    "position": 1,
    "text": "که فرزند گو بود و سالار نو"
  },
  {
    "poem_id": 1493,
    "vorder": 141,
    "position": 0,
    "text": "همی رفت تا مرز توران رسید"
  },
  {
    "poem_id": 1493,
    "vorder": 142,
    "position": 1,
    "text": "ز دشمن کسی را به ره بر ندید"
  },
  {
    "poem_id": 1493,
    "vorder": 143,
    "position": 0,
    "text": "دران مرز شاه سپیجاب بود"
  },
  {
    "poem_id": 1493,
    "vorder": 144,
    "position": 1,
    "text": "که با لشکر و گنج و با آب بود"
  },
  {
    "poem_id": 1493,
    "vorder": 145,
    "position": 0,
    "text": "ورازاد بد نام آن پهلوان"
  },
  {
    "poem_id": 1493,
    "vorder": 146,
    "position": 1,
    "text": "دلیر و سپه تاز و روشن روان"
  },
  {
    "poem_id": 1493,
    "vorder": 147,
    "position": 0,
    "text": "سپه بود شمشیرزن سی هزار"
  },
  {
    "poem_id": 1493,
    "vorder": 148,
    "position": 1,
    "text": "همه رزم جوی از در کارزار"
  },
  {
    "poem_id": 1493,
    "vorder": 149,
    "position": 0,
    "text": "ورازاد از قلب لشکر برفت"
  },
  {
    "poem_id": 1493,
    "vorder": 150,
    "position": 1,
    "text": "بیامد به نزد فرامرز تفت"
  },
  {
    "poem_id": 1493,
    "vorder": 151,
    "position": 0,
    "text": "بپرسید و گفتش چه مردی بگوی"
  },
  {
    "poem_id": 1493,
    "vorder": 152,
    "position": 1,
    "text": "چرا کرده‌ای سوی این مرز روی"
  },
  {
    "poem_id": 1493,
    "vorder": 153,
    "position": 0,
    "text": "سزد گر بگویی مرا نام خویش"
  },
  {
    "poem_id": 1493,
    "vorder": 154,
    "position": 1,
    "text": "بجویی ازین کار فرجام خویش"
  },
  {
    "poem_id": 1493,
    "vorder": 155,
    "position": 0,
    "text": "همانا به فرمان شاه آمدی"
  },
  {
    "poem_id": 1493,
    "vorder": 156,
    "position": 1,
    "text": "گر از پهلوان سپاه آمدی"
  },
  {
    "poem_id": 1493,
    "vorder": 157,
    "position": 0,
    "text": "چه داری ز افراسیاب آگهی"
  },
  {
    "poem_id": 1493,
    "vorder": 158,
    "position": 1,
    "text": "ز اورنگ و ز تاج و تخت مهی"
  },
  {
    "poem_id": 1493,
    "vorder": 159,
    "position": 0,
    "text": "نباید که بی‌نام بر دست من"
  },
  {
    "poem_id": 1493,
    "vorder": 160,
    "position": 1,
    "text": "روانت برآید ز تاریک تن"
  },
  {
    "poem_id": 1493,
    "vorder": 161,
    "position": 0,
    "text": "فرامرز گفت ای گو شوربخت"
  },
  {
    "poem_id": 1493,
    "vorder": 162,
    "position": 1,
    "text": "منم بار آن خسروانی درخت"
  },
  {
    "poem_id": 1493,
    "vorder": 163,
    "position": 0,
    "text": "که از نام او شیر پیچان شود"
  },
  {
    "poem_id": 1493,
    "vorder": 164,
    "position": 1,
    "text": "چو خشم آورد پیل بیجان شود"
  },
  {
    "poem_id": 1493,
    "vorder": 165,
    "position": 0,
    "text": "مرا با تو بدگوهر دیوزاد"
  },
  {
    "poem_id": 1493,
    "vorder": 166,
    "position": 1,
    "text": "چرا کرد باید همی نام یاد"
  },
  {
    "poem_id": 1493,
    "vorder": 167,
    "position": 0,
    "text": "گو پیلتن با سپاه از پس است"
  },
  {
    "poem_id": 1493,
    "vorder": 168,
    "position": 1,
    "text": "که اندر جهان کینه خواه او بس است"
  },
  {
    "poem_id": 1493,
    "vorder": 169,
    "position": 0,
    "text": "به کین سیاوش کمر بر میان"
  },
  {
    "poem_id": 1493,
    "vorder": 170,
    "position": 1,
    "text": "ببست و بیامد چو شیر ژیان"
  },
  {
    "poem_id": 1493,
    "vorder": 171,
    "position": 0,
    "text": "برآرد ازین مرز بی‌ارز دود"
  },
  {
    "poem_id": 1493,
    "vorder": 172,
    "position": 1,
    "text": "هوا گرد او را نیارد بسود"
  },
  {
    "poem_id": 1493,
    "vorder": 173,
    "position": 0,
    "text": "ورازاد بشنید گفتار او"
  },
  {
    "poem_id": 1493,
    "vorder": 174,
    "position": 1,
    "text": "همی خوار دانست پیگار او"
  },
  {
    "poem_id": 1493,
    "vorder": 175,
    "position": 0,
    "text": "به لشکر بفرمود کاندر دهید"
  },
  {
    "poem_id": 1493,
    "vorder": 176,
    "position": 1,
    "text": "کمان‌ها سراسر به زه بر نهید"
  },
  {
    "poem_id": 1493,
    "vorder": 177,
    "position": 0,
    "text": "رده بر کشید از دو رویه سپاه"
  },
  {
    "poem_id": 1493,
    "vorder": 178,
    "position": 1,
    "text": "به سر بر نهادند ز آهن کلاه"
  },
  {
    "poem_id": 1493,
    "vorder": 179,
    "position": 0,
    "text": "ز هر سو برآمد ز گردان خروش"
  },
  {
    "poem_id": 1493,
    "vorder": 180,
    "position": 1,
    "text": "همی کر شد از نالهٔ کوس گوش"
  },
  {
    "poem_id": 1493,
    "vorder": 181,
    "position": 0,
    "text": "چو آواز کوس آمد و کرنای"
  },
  {
    "poem_id": 1493,
    "vorder": 182,
    "position": 1,
    "text": "فرامرز را دل برآمد ز جای"
  },
  {
    "poem_id": 1493,
    "vorder": 183,
    "position": 0,
    "text": "به یک حمله اندر ز گردان هزار"
  },
  {
    "poem_id": 1493,
    "vorder": 184,
    "position": 1,
    "text": "بیفگند و برگشت از کارزار"
  },
  {
    "poem_id": 1493,
    "vorder": 185,
    "position": 0,
    "text": "دگر حمله کردش هزار و دویست"
  },
  {
    "poem_id": 1493,
    "vorder": 186,
    "position": 1,
    "text": "ورازاد را گفت لشکر مه‌ایست"
  },
  {
    "poem_id": 1493,
    "vorder": 187,
    "position": 0,
    "text": "که امروز بادافرَهِ ایزدیست"
  },
  {
    "poem_id": 1493,
    "vorder": 188,
    "position": 1,
    "text": "مکافات بد را ز یزدان بدیست"
  },
  {
    "poem_id": 1493,
    "vorder": 189,
    "position": 0,
    "text": "چنین لشکر گشن و چندین سوار"
  },
  {
    "poem_id": 1493,
    "vorder": 190,
    "position": 1,
    "text": "سراسیمه شد از یکی نامدار"
  },
  {
    "poem_id": 1493,
    "vorder": 191,
    "position": 0,
    "text": "همی شد فرامرز نیزه به دست"
  },
  {
    "poem_id": 1493,
    "vorder": 192,
    "position": 1,
    "text": "ورازاد را راه یزدان ببست"
  },
  {
    "poem_id": 1493,
    "vorder": 193,
    "position": 0,
    "text": "فرامرز جنگی چو او را بدید"
  },
  {
    "poem_id": 1493,
    "vorder": 194,
    "position": 1,
    "text": "خروشی چو شیر ژیان برکشید"
  },
  {
    "poem_id": 1493,
    "vorder": 195,
    "position": 0,
    "text": "برانگیخت از جای شبرنگ را"
  },
  {
    "poem_id": 1493,
    "vorder": 196,
    "position": 1,
    "text": "بیفشرد بر نیزه بر چنگ را"
  },
  {
    "poem_id": 1493,
    "vorder": 197,
    "position": 0,
    "text": "یکی نیزه زد بر کمربند او"
  },
  {
    "poem_id": 1493,
    "vorder": 198,
    "position": 1,
    "text": "که بگسست زیر زره بند او"
  },
  {
    "poem_id": 1493,
    "vorder": 199,
    "position": 0,
    "text": "چنان برگرفتش ز زین خدنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 200,
    "position": 1,
    "text": "که گفتی یک پشه دارد به چنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 201,
    "position": 0,
    "text": "بیفگند بر خاک و آمد فرود"
  },
  {
    "poem_id": 1493,
    "vorder": 202,
    "position": 1,
    "text": "سیاووش را داد چندی درود"
  },
  {
    "poem_id": 1493,
    "vorder": 203,
    "position": 0,
    "text": "سر نامور دور کرد از تنش"
  },
  {
    "poem_id": 1493,
    "vorder": 204,
    "position": 1,
    "text": "پر از خون بیالود پیراهنش"
  },
  {
    "poem_id": 1493,
    "vorder": 205,
    "position": 0,
    "text": "چنین گفت کاینت سر کین نخست"
  },
  {
    "poem_id": 1493,
    "vorder": 206,
    "position": 1,
    "text": "پراگنده شد تخم پرخاش و رست"
  },
  {
    "poem_id": 1493,
    "vorder": 207,
    "position": 0,
    "text": "همه بوم و بر آتش اندرفگند"
  },
  {
    "poem_id": 1493,
    "vorder": 208,
    "position": 1,
    "text": "همی دود برشد به چرخ بلند"
  },
  {
    "poem_id": 1493,
    "vorder": 209,
    "position": 0,
    "text": "یکی نامه بنوشت نزد پدر"
  },
  {
    "poem_id": 1493,
    "vorder": 210,
    "position": 1,
    "text": "ز کار ورازاد پرخاشخر"
  },
  {
    "poem_id": 1493,
    "vorder": 211,
    "position": 0,
    "text": "که چون برگشادم در کین و جنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 212,
    "position": 1,
    "text": "ورا برگرفتم ز زین پلنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 213,
    "position": 0,
    "text": "به کین سیاوش بریدم سرش"
  },
  {
    "poem_id": 1493,
    "vorder": 214,
    "position": 1,
    "text": "برافروختم آتش از کشورش"
  },
  {
    "poem_id": 1493,
    "vorder": 215,
    "position": 0,
    "text": "وزان سو نوندی بیامد به راه"
  },
  {
    "poem_id": 1493,
    "vorder": 216,
    "position": 1,
    "text": "به نزدیک سالار توران سپاه"
  },
  {
    "poem_id": 1493,
    "vorder": 217,
    "position": 0,
    "text": "که آمد به کین رستم پیلتن"
  },
  {
    "poem_id": 1493,
    "vorder": 218,
    "position": 1,
    "text": "بزرگان ایران شدند انجمن"
  },
  {
    "poem_id": 1493,
    "vorder": 219,
    "position": 0,
    "text": "ورازاد را سر بریدند زار"
  },
  {
    "poem_id": 1493,
    "vorder": 220,
    "position": 1,
    "text": "برانگیخت از مرز توران دمار"
  },
  {
    "poem_id": 1493,
    "vorder": 221,
    "position": 0,
    "text": "سپه را سراسر بهم بر زدند"
  },
  {
    "poem_id": 1493,
    "vorder": 222,
    "position": 1,
    "text": "به بوم و به بر آتش اندر زدند"
  },
  {
    "poem_id": 1493,
    "vorder": 223,
    "position": 0,
    "text": "چو بشنید افراسیاب این سخن"
  },
  {
    "poem_id": 1493,
    "vorder": 224,
    "position": 1,
    "text": "غمی شد ز کردارهای کهن"
  },
  {
    "poem_id": 1493,
    "vorder": 225,
    "position": 0,
    "text": "نماند ایچ بر دشت ز اسپان یله"
  },
  {
    "poem_id": 1493,
    "vorder": 226,
    "position": 1,
    "text": "بیاورد چوپان به میدان گله"
  },
  {
    "poem_id": 1493,
    "vorder": 227,
    "position": 0,
    "text": "در گنج گوپال و برگستوان"
  },
  {
    "poem_id": 1493,
    "vorder": 228,
    "position": 1,
    "text": "همان نیزه و خنجر هندوان"
  },
  {
    "poem_id": 1493,
    "vorder": 229,
    "position": 0,
    "text": "همان گنج دینار و در و گهر"
  },
  {
    "poem_id": 1493,
    "vorder": 230,
    "position": 1,
    "text": "همان افسر و طوق زرین کمر"
  },
  {
    "poem_id": 1493,
    "vorder": 231,
    "position": 0,
    "text": "ز دستور گنجور بستد کلید"
  },
  {
    "poem_id": 1493,
    "vorder": 232,
    "position": 1,
    "text": "همه کاخ و میدان درم گسترید"
  },
  {
    "poem_id": 1493,
    "vorder": 233,
    "position": 0,
    "text": "چو لشکر سراسر شد آراسته"
  },
  {
    "poem_id": 1493,
    "vorder": 234,
    "position": 1,
    "text": "بریشان پراگنده شد خواسته"
  },
  {
    "poem_id": 1493,
    "vorder": 235,
    "position": 0,
    "text": "بزد کوس رویین و هندی درای"
  },
  {
    "poem_id": 1493,
    "vorder": 236,
    "position": 1,
    "text": "سواران سوی رزم کردند رای"
  },
  {
    "poem_id": 1493,
    "vorder": 237,
    "position": 0,
    "text": "سپهدار از گنگ بیرون کشید"
  },
  {
    "poem_id": 1493,
    "vorder": 238,
    "position": 1,
    "text": "سپه را ز تنگی به هامون کشید"
  },
  {
    "poem_id": 1493,
    "vorder": 239,
    "position": 0,
    "text": "فرستاد و مر سرخه را پیش خواند"
  },
  {
    "poem_id": 1493,
    "vorder": 240,
    "position": 1,
    "text": "ز رستم بسی داستانها براند"
  },
  {
    "poem_id": 1493,
    "vorder": 241,
    "position": 0,
    "text": "بدو گفت شمشیرزن سی هزار"
  },
  {
    "poem_id": 1493,
    "vorder": 242,
    "position": 1,
    "text": "ببر نامدار از در کارزار"
  },
  {
    "poem_id": 1493,
    "vorder": 243,
    "position": 0,
    "text": "نگه دار جان از بد پور زال"
  },
  {
    "poem_id": 1493,
    "vorder": 244,
    "position": 1,
    "text": "به رزمت نباشد جزو کس همال"
  },
  {
    "poem_id": 1493,
    "vorder": 245,
    "position": 0,
    "text": "تو فرزندی و نیکخواه منی"
  },
  {
    "poem_id": 1493,
    "vorder": 246,
    "position": 1,
    "text": "ستون سپاهی و ماه منی"
  },
  {
    "poem_id": 1493,
    "vorder": 247,
    "position": 0,
    "text": "چو بیدار دل باشی و راه‌جوی"
  },
  {
    "poem_id": 1493,
    "vorder": 248,
    "position": 1,
    "text": "که یارد نهادن بروی تو روی"
  },
  {
    "poem_id": 1493,
    "vorder": 249,
    "position": 0,
    "text": "کنون پیش رو باش و بیدار باش"
  },
  {
    "poem_id": 1493,
    "vorder": 250,
    "position": 1,
    "text": "سپه را ز دشمن نگهدار باش"
  },
  {
    "poem_id": 1493,
    "vorder": 251,
    "position": 0,
    "text": "ز پیش پدر سرخه بیرون کشید"
  },
  {
    "poem_id": 1493,
    "vorder": 252,
    "position": 1,
    "text": "درفش و سپه را به هامون کشید"
  },
  {
    "poem_id": 1493,
    "vorder": 253,
    "position": 0,
    "text": "طلایه چو گرد سپه دید تفت"
  },
  {
    "poem_id": 1493,
    "vorder": 254,
    "position": 1,
    "text": "بپیچید و سوی فرامرز رفت"
  },
  {
    "poem_id": 1493,
    "vorder": 255,
    "position": 0,
    "text": "از ایران سپه برشد آوای کوس"
  },
  {
    "poem_id": 1493,
    "vorder": 256,
    "position": 1,
    "text": "ز گرد سپه شد هوا آبنوس"
  },
  {
    "poem_id": 1493,
    "vorder": 257,
    "position": 0,
    "text": "خروش سواران و گرد سپاه"
  },
  {
    "poem_id": 1493,
    "vorder": 258,
    "position": 1,
    "text": "چو شب کرد گیتی نهان گشت ماه"
  },
  {
    "poem_id": 1493,
    "vorder": 259,
    "position": 0,
    "text": "درخشیدن تیغ الماس گون"
  },
  {
    "poem_id": 1493,
    "vorder": 260,
    "position": 1,
    "text": "سنانهای آهار داده به خون"
  },
  {
    "poem_id": 1493,
    "vorder": 261,
    "position": 0,
    "text": "تو گفتی که برشد به گیتی بخار"
  },
  {
    "poem_id": 1493,
    "vorder": 262,
    "position": 1,
    "text": "برافروختند آتش کارزار"
  },
  {
    "poem_id": 1493,
    "vorder": 263,
    "position": 0,
    "text": "ز کشته فگنده به هر سو سران"
  },
  {
    "poem_id": 1493,
    "vorder": 264,
    "position": 1,
    "text": "زمین کوه گشت از کران تا کران"
  },
  {
    "poem_id": 1493,
    "vorder": 265,
    "position": 0,
    "text": "چو سرخه بران گونه پیگار دید"
  },
  {
    "poem_id": 1493,
    "vorder": 266,
    "position": 1,
    "text": "درفش فرامرز سالار دید"
  },
  {
    "poem_id": 1493,
    "vorder": 267,
    "position": 0,
    "text": "عنان را به بور سرافراز داد"
  },
  {
    "poem_id": 1493,
    "vorder": 268,
    "position": 1,
    "text": "به نیزه درآمد کمان باز داد"
  },
  {
    "poem_id": 1493,
    "vorder": 269,
    "position": 0,
    "text": "فرامرز بگذاشت قلب سپاه"
  },
  {
    "poem_id": 1493,
    "vorder": 270,
    "position": 1,
    "text": "بر سرخه با نیزه شد کینه‌خواه"
  },
  {
    "poem_id": 1493,
    "vorder": 271,
    "position": 0,
    "text": "یکی نیزه زد همچو آذرگشسپ"
  },
  {
    "poem_id": 1493,
    "vorder": 272,
    "position": 1,
    "text": "ز کوهه ببردش سوی یال اسپ"
  },
  {
    "poem_id": 1493,
    "vorder": 273,
    "position": 0,
    "text": "ز ترکان به یاری او آمدند"
  },
  {
    "poem_id": 1493,
    "vorder": 274,
    "position": 1,
    "text": "پر از جنگ و پرخاشجو آمدند"
  },
  {
    "poem_id": 1493,
    "vorder": 275,
    "position": 0,
    "text": "از آشوب ترکان و از رزم سخت"
  },
  {
    "poem_id": 1493,
    "vorder": 276,
    "position": 1,
    "text": "فرامرز را نیزه شد لخت لخت"
  },
  {
    "poem_id": 1493,
    "vorder": 277,
    "position": 0,
    "text": "بدانست سرخه که پایاب اوی"
  },
  {
    "poem_id": 1493,
    "vorder": 278,
    "position": 1,
    "text": "ندارد غمی گشت و برگاشت روی"
  },
  {
    "poem_id": 1493,
    "vorder": 279,
    "position": 0,
    "text": "پس اندر فرامرز با تیغ تیز"
  },
  {
    "poem_id": 1493,
    "vorder": 280,
    "position": 1,
    "text": "همی تاخت و انگیخته رستخیز"
  },
  {
    "poem_id": 1493,
    "vorder": 281,
    "position": 0,
    "text": "سواران ایران به کردار دیو"
  },
  {
    "poem_id": 1493,
    "vorder": 282,
    "position": 1,
    "text": "دمان از پسش برکشیده غریو"
  },
  {
    "poem_id": 1493,
    "vorder": 283,
    "position": 0,
    "text": "فرامرز چون سرخه را یافت چنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 284,
    "position": 1,
    "text": "بیازید زان سان که یازد پلنگ"
  },
  {
    "poem_id": 1493,
    "vorder": 285,
    "position": 0,
    "text": "گرفتش کمربند و از پشت زین"
  },
  {
    "poem_id": 1493,
    "vorder": 286,
    "position": 1,
    "text": "برآورد و زد ناگهان بر زمین"
  },
  {
    "poem_id": 1493,
    "vorder": 287,
    "position": 0,
    "text": "پیاده به پیش اندر افگند خوار"
  },
  {
    "poem_id": 1493,
    "vorder": 288,
    "position": 1,
    "text": "به لشکرگه آوردش از کارزار"
  },
  {
    "poem_id": 1493,
    "vorder": 289,
    "position": 0,
    "text": "درفش تهمتن همانگه ز راه"
  },
  {
    "poem_id": 1493,
    "vorder": 290,
    "position": 1,
    "text": "پدید آمد و گرد پیل و سپاه"
  },
  {
    "poem_id": 1493,
    "vorder": 291,
    "position": 0,
    "text": "فرامرز پیش پدر شد چو گرد"
  },
  {
    "poem_id": 1493,
    "vorder": 292,
    "position": 1,
    "text": "به پیروزی از روزگار نبرد"
  },
  {
    "poem_id": 1493,
    "vorder": 293,
    "position": 0,
    "text": "به پیش اندرون سرخه را بسته دست"
  },
  {
    "poem_id": 1493,
    "vorder": 294,
    "position": 1,
    "text": "بکرده ورازاد را یال پست"
  },
  {
    "poem_id": 1493,
    "vorder": 295,
    "position": 0,
    "text": "همه غار و هامون پر از کشته بود"
  },
  {
    "poem_id": 1493,
    "vorder": 296,
    "position": 1,
    "text": "سر دشمن از رزم برگشته بود"
  },
  {
    "poem_id": 1493,
    "vorder": 297,
    "position": 0,
    "text": "سپاه آفرین خواند بر پهلوان"
  },
  {
    "poem_id": 1493,
    "vorder": 298,
    "position": 1,
    "text": "بران نامبردار پور جوان"
  },
  {
    "poem_id": 1493,
    "vorder": 299,
    "position": 0,
    "text": "تهمتن برو آفرین کرد نیز"
  },
  {
    "poem_id": 1493,
    "vorder": 300,
    "position": 1,
    "text": "به درویش بخشید بسیار چیز"
  },
  {
    "poem_id": 1493,
    "vorder": 301,
    "position": 0,
    "text": "یکی داستان زد برو پیلتن"
  },
  {
    "poem_id": 1493,
    "vorder": 302,
    "position": 1,
    "text": "که هر کس که سر برکشد ز انجمن"
  },
  {
    "poem_id": 1493,
    "vorder": 303,
    "position": 0,
    "text": "خرد باید و گوهر نامدار"
  },
  {
    "poem_id": 1493,
    "vorder": 304,
    "position": 1,
    "text": "هنر یار و فرهنگش آموزگار"
  },
  {
    "poem_id": 1493,
    "vorder": 305,
    "position": 0,
    "text": "چو این گوهران را بجا آورد"
  },
  {
    "poem_id": 1493,
    "vorder": 306,
    "position": 1,
    "text": "دلاور شود پر و پا آورد"
  },
  {
    "poem_id": 1493,
    "vorder": 307,
    "position": 0,
    "text": "از آتش نبینی جز افروختن"
  },
  {
    "poem_id": 1493,
    "vorder": 308,
    "position": 1,
    "text": "جهانی چو پیش آیدش سوختن"
  },
  {
    "poem_id": 1493,
    "vorder": 309,
    "position": 0,
    "text": "فرامرز نشگفت اگر سرکش است"
  },
  {
    "poem_id": 1493,
    "vorder": 310,
    "position": 1,
    "text": "که پولاد را دل پر از آتش است"
  },
  {
    "poem_id": 1493,
    "vorder": 311,
    "position": 0,
    "text": "چو آورد با سنگ خارا کند"
  },
  {
    "poem_id": 1493,
    "vorder": 312,
    "position": 1,
    "text": "ز دل راز خویش آشکارا کند"
  },
  {
    "poem_id": 1493,
    "vorder": 313,
    "position": 0,
    "text": "به سرخه نگه کرد پس پیلتن"
  },
  {
    "poem_id": 1493,
    "vorder": 314,
    "position": 1,
    "text": "یکی سرو آزاده بد بر چمن"
  },
  {
    "poem_id": 1493,
    "vorder": 315,
    "position": 0,
    "text": "برش چون بر شیر و رخ چون بهار"
  },
  {
    "poem_id": 1493,
    "vorder": 316,
    "position": 1,
    "text": "ز مشک سیه کرده بر گل نگار"
  },
  {
    "poem_id": 1493,
    "vorder": 317,
    "position": 0,
    "text": "بفرمود پس تا برندش به دشت"
  },
  {
    "poem_id": 1493,
    "vorder": 318,
    "position": 1,
    "text": "ابا خنجر و روزبانان و تشت"
  },
  {
    "poem_id": 1493,
    "vorder": 319,
    "position": 0,
    "text": "ببندند دستش به خم کمند"
  },
  {
    "poem_id": 1493,
    "vorder": 320,
    "position": 1,
    "text": "بخوابند بر خاک چون گوسفند"
  },
  {
    "poem_id": 1493,
    "vorder": 321,
    "position": 0,
    "text": "بسان سیاوش سرش را ز تن"
  },
  {
    "poem_id": 1493,
    "vorder": 322,
    "position": 1,
    "text": "ببرند و کرگس بپوشد کفن"
  },
  {
    "poem_id": 1493,
    "vorder": 323,
    "position": 0,
    "text": "چو بشنید طوس سپهبد برفت"
  },
  {
    "poem_id": 1493,
    "vorder": 324,
    "position": 1,
    "text": "به خون ریختن روی بنهاد تفت"
  },
  {
    "poem_id": 1493,
    "vorder": 325,
    "position": 0,
    "text": "بدو سرخه گفت ای سرافراز شاه"
  },
  {
    "poem_id": 1493,
    "vorder": 326,
    "position": 1,
    "text": "چه ریزی همی خون من بی‌گناه"
  },
  {
    "poem_id": 1493,
    "vorder": 327,
    "position": 0,
    "text": "سیاوش مرا بود هم سال و دوست"
  },
  {
    "poem_id": 1493,
    "vorder": 328,
    "position": 1,
    "text": "روانم پر از درد و اندوه اوست"
  },
  {
    "poem_id": 1493,
    "vorder": 329,
    "position": 0,
    "text": "مرا دیده پرآب بد روز و شب"
  },
  {
    "poem_id": 1493,
    "vorder": 330,
    "position": 1,
    "text": "همیشه به نفرین گشاده دو لب"
  },
  {
    "poem_id": 1493,
    "vorder": 331,
    "position": 0,
    "text": "بران کس که آن تشت و خنجر گرفت"
  },
  {
    "poem_id": 1493,
    "vorder": 332,
    "position": 1,
    "text": "بران کس که آن شاه را سرگرفت"
  },
  {
    "poem_id": 1493,
    "vorder": 333,
    "position": 0,
    "text": "دل طوس بخشایش آورد سخت"
  },
  {
    "poem_id": 1493,
    "vorder": 334,
    "position": 1,
    "text": "بران نامبردار برگشته بخت"
  },
  {
    "poem_id": 1493,
    "vorder": 335,
    "position": 0,
    "text": "بر رستم آمد بگفت این سخن"
  },
  {
    "poem_id": 1493,
    "vorder": 336,
    "position": 1,
    "text": "که پور سپهدار افگند بن"
  },
  {
    "poem_id": 1493,
    "vorder": 337,
    "position": 0,
    "text": "چنین گفت رستم که گر شهریار"
  },
  {
    "poem_id": 1493,
    "vorder": 338,
    "position": 1,
    "text": "چنان خسته‌دل شاید و سوگوار"
  },
  {
    "poem_id": 1493,
    "vorder": 339,
    "position": 0,
    "text": "همیشه دل و جان افراسیاب"
  },
  {
    "poem_id": 1493,
    "vorder": 340,
    "position": 1,
    "text": "پر از درد باد و دو دیده پرآب"
  },
  {
    "poem_id": 1493,
    "vorder": 341,
    "position": 0,
    "text": "همان تشت و خنجر زواره ببرد"
  },
  {
    "poem_id": 1493,
    "vorder": 342,
    "position": 1,
    "text": "بدان روزبانان لشکر سپرد"
  },
  {
    "poem_id": 1493,
    "vorder": 343,
    "position": 0,
    "text": "سرش را به خنجر ببرید زار"
  },
  {
    "poem_id": 1493,
    "vorder": 344,
    "position": 1,
    "text": "زمانی خروشید و برگشت کار"
  },
  {
    "poem_id": 1493,
    "vorder": 345,
    "position": 0,
    "text": "بریده سر و تنش بر دار کرد"
  },
  {
    "poem_id": 1493,
    "vorder": 346,
    "position": 1,
    "text": "دو پایش زبر سر نگونسار کرد"
  },
  {
    "poem_id": 1493,
    "vorder": 347,
    "position": 0,
    "text": "بران کشته از کین برافشاند خاک"
  },
  {
    "poem_id": 1493,
    "vorder": 348,
    "position": 1,
    "text": "تنش را به خنجر بکردند چاک"
  },
  {
    "poem_id": 1493,
    "vorder": 349,
    "position": 0,
    "text": "جهانا چه خواهی ز پروردگان"
  },
  {
    "poem_id": 1493,
    "vorder": 350,
    "position": 1,
    "text": "چه پروردگان داغ دل بردگان"
  }
]