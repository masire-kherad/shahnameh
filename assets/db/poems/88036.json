[
  {
    "poem_id": 88036,
    "vorder": 1,
    "position": 0,
    "text": "یکی نامه فرمود پس تا دبیر"
  },
  {
    "poem_id": 88036,
    "vorder": 2,
    "position": 1,
    "text": "نویسد سوی پهلوان دلپذیر"
  },
  {
    "poem_id": 88036,
    "vorder": 3,
    "position": 0,
    "text": "سر نامه کرد آفرین بزرگ"
  },
  {
    "poem_id": 88036,
    "vorder": 4,
    "position": 1,
    "text": "به یزدان پناهش ز دیو سترگ"
  },
  {
    "poem_id": 88036,
    "vorder": 5,
    "position": 0,
    "text": "دگر گفت کز کردگار جهان"
  },
  {
    "poem_id": 88036,
    "vorder": 6,
    "position": 1,
    "text": "بخواهم همی آشکار و نهان"
  },
  {
    "poem_id": 88036,
    "vorder": 7,
    "position": 0,
    "text": "مگر کز میان دو رویه سپاه"
  },
  {
    "poem_id": 88036,
    "vorder": 8,
    "position": 1,
    "text": "جهاندار بردارد این کینه‌گاه"
  },
  {
    "poem_id": 88036,
    "vorder": 9,
    "position": 0,
    "text": "اگر تو که گودرزی آن خواستی"
  },
  {
    "poem_id": 88036,
    "vorder": 10,
    "position": 1,
    "text": "که گیتی به کینه بیاراستی"
  },
  {
    "poem_id": 88036,
    "vorder": 11,
    "position": 0,
    "text": "برآمد از این کینه گه کام تو"
  },
  {
    "poem_id": 88036,
    "vorder": 12,
    "position": 1,
    "text": "چه گویی چه باشد سرانجام تو"
  },
  {
    "poem_id": 88036,
    "vorder": 13,
    "position": 0,
    "text": "نگه کن که چندان دلیران من"
  },
  {
    "poem_id": 88036,
    "vorder": 14,
    "position": 1,
    "text": "ز خویشان نزدیک و شیران من"
  },
  {
    "poem_id": 88036,
    "vorder": 15,
    "position": 0,
    "text": "تن بی سرانشان فگندی به خاک"
  },
  {
    "poem_id": 88036,
    "vorder": 16,
    "position": 1,
    "text": "ز یزدان نداری همی شرم و باک"
  },
  {
    "poem_id": 88036,
    "vorder": 17,
    "position": 0,
    "text": "ز مهر و خرد روی برتافتی"
  },
  {
    "poem_id": 88036,
    "vorder": 18,
    "position": 1,
    "text": "کنون آنچ جستی همه یافتی"
  },
  {
    "poem_id": 88036,
    "vorder": 19,
    "position": 0,
    "text": "گه آمد که گردی از این کینه سیر"
  },
  {
    "poem_id": 88036,
    "vorder": 20,
    "position": 1,
    "text": "به خون ریختن چند باشی دلیر"
  },
  {
    "poem_id": 88036,
    "vorder": 21,
    "position": 0,
    "text": "نگه کن کز ایران و توران سوار"
  },
  {
    "poem_id": 88036,
    "vorder": 22,
    "position": 1,
    "text": "چه مایه تبه شد بدین کارزار"
  },
  {
    "poem_id": 88036,
    "vorder": 23,
    "position": 0,
    "text": "به کین جستن مرده‌ای ناپدید"
  },
  {
    "poem_id": 88036,
    "vorder": 24,
    "position": 1,
    "text": "سر زندگان چند باید برید"
  },
  {
    "poem_id": 88036,
    "vorder": 25,
    "position": 0,
    "text": "گه آمد که بخشایش آید ترا"
  },
  {
    "poem_id": 88036,
    "vorder": 26,
    "position": 1,
    "text": "ز کین جستن آسایش آید ترا"
  },
  {
    "poem_id": 88036,
    "vorder": 27,
    "position": 0,
    "text": "اگر بازیابی شده روزگار"
  },
  {
    "poem_id": 88036,
    "vorder": 28,
    "position": 1,
    "text": "به گیتی درون تخم کینه مکار"
  },
  {
    "poem_id": 88036,
    "vorder": 29,
    "position": 0,
    "text": "روانت مرنجان و مگذار تن"
  },
  {
    "poem_id": 88036,
    "vorder": 30,
    "position": 1,
    "text": "ز خون ریختن بازکش خویشتن"
  },
  {
    "poem_id": 88036,
    "vorder": 31,
    "position": 0,
    "text": "پس از مرگ نفرین بود بر کسی"
  },
  {
    "poem_id": 88036,
    "vorder": 32,
    "position": 1,
    "text": "کز او نام زشتی بماند بسی"
  },
  {
    "poem_id": 88036,
    "vorder": 33,
    "position": 0,
    "text": "نباید که زشتی بماندت نام"
  },
  {
    "poem_id": 88036,
    "vorder": 34,
    "position": 1,
    "text": "وگر تو بدان سر شوی شادکام"
  },
  {
    "poem_id": 88036,
    "vorder": 35,
    "position": 0,
    "text": "هر آنگه که موی سیه شد سپید"
  },
  {
    "poem_id": 88036,
    "vorder": 36,
    "position": 1,
    "text": "ببودن نماند فراوان امید"
  },
  {
    "poem_id": 88036,
    "vorder": 37,
    "position": 0,
    "text": "بترسم که گر بار دیگر سپاه"
  },
  {
    "poem_id": 88036,
    "vorder": 38,
    "position": 1,
    "text": "به جنگ اندر آید بدین رزمگاه"
  },
  {
    "poem_id": 88036,
    "vorder": 39,
    "position": 0,
    "text": "نبینی ز هر دو سپه کس بپای"
  },
  {
    "poem_id": 88036,
    "vorder": 40,
    "position": 1,
    "text": "برفته روان تن بمانده به جای"
  },
  {
    "poem_id": 88036,
    "vorder": 41,
    "position": 0,
    "text": "از آن پس که داند که پیروز کیست"
  },
  {
    "poem_id": 88036,
    "vorder": 42,
    "position": 1,
    "text": "نگون‌بخت گر گیتی افروز کیست"
  },
  {
    "poem_id": 88036,
    "vorder": 43,
    "position": 0,
    "text": "ور ایدونک پیکار و خون ریختن"
  },
  {
    "poem_id": 88036,
    "vorder": 44,
    "position": 1,
    "text": "بدین رزمگه با من آویختن"
  },
  {
    "poem_id": 88036,
    "vorder": 45,
    "position": 0,
    "text": "کزین سان همی جنگ شیران کنی"
  },
  {
    "poem_id": 88036,
    "vorder": 46,
    "position": 1,
    "text": "همی از پی شهر ایران کنی"
  },
  {
    "poem_id": 88036,
    "vorder": 47,
    "position": 0,
    "text": "بگو تا من اکنون هم اندر شتاب"
  },
  {
    "poem_id": 88036,
    "vorder": 48,
    "position": 1,
    "text": "نوندی فرستم به افراسیاب"
  },
  {
    "poem_id": 88036,
    "vorder": 49,
    "position": 0,
    "text": "بدان تا بفرمایدم تا زمین"
  },
  {
    "poem_id": 88036,
    "vorder": 50,
    "position": 1,
    "text": "ببخشیم و پس درنوردیم کین"
  },
  {
    "poem_id": 88036,
    "vorder": 51,
    "position": 0,
    "text": "چنانچون به گاه منوچهر شاه"
  },
  {
    "poem_id": 88036,
    "vorder": 52,
    "position": 1,
    "text": "به بخشش همی داشت گیتی نگاه"
  },
  {
    "poem_id": 88036,
    "vorder": 53,
    "position": 0,
    "text": "هر آن شهر کز مرز ایران نهی"
  },
  {
    "poem_id": 88036,
    "vorder": 54,
    "position": 1,
    "text": "بگو تا کنیم آن ز ترکان تهی"
  },
  {
    "poem_id": 88036,
    "vorder": 55,
    "position": 0,
    "text": "وز آباد و ویران و هر بوم و بر"
  },
  {
    "poem_id": 88036,
    "vorder": 56,
    "position": 1,
    "text": "که فرمود کیخسرو دادگر"
  },
  {
    "poem_id": 88036,
    "vorder": 57,
    "position": 0,
    "text": "از ایران به کوه اندر آید نخست"
  },
  {
    "poem_id": 88036,
    "vorder": 58,
    "position": 1,
    "text": "در غرچگان از بر بوم بست"
  },
  {
    "poem_id": 88036,
    "vorder": 59,
    "position": 0,
    "text": "دگر طالقان شهر تا فاریاب"
  },
  {
    "poem_id": 88036,
    "vorder": 60,
    "position": 1,
    "text": "همیدون در بلخ تا اندر آب"
  },
  {
    "poem_id": 88036,
    "vorder": 61,
    "position": 0,
    "text": "دگر پنجهیر و در بامیان"
  },
  {
    "poem_id": 88036,
    "vorder": 62,
    "position": 1,
    "text": "سر مرز ایران و جای کیان"
  },
  {
    "poem_id": 88036,
    "vorder": 63,
    "position": 0,
    "text": "دگر گوزگانان فرخنده جای"
  },
  {
    "poem_id": 88036,
    "vorder": 64,
    "position": 1,
    "text": "نهادست نامش جهان کدخدای"
  },
  {
    "poem_id": 88036,
    "vorder": 65,
    "position": 0,
    "text": "دگر مولیان تا در بدخشان"
  },
  {
    "poem_id": 88036,
    "vorder": 66,
    "position": 1,
    "text": "همینست از این پادشاهی نشان"
  },
  {
    "poem_id": 88036,
    "vorder": 67,
    "position": 0,
    "text": "فروتر دگر دشت آموی و زم"
  },
  {
    "poem_id": 88036,
    "vorder": 68,
    "position": 1,
    "text": "که با شهر ختلان براید برم"
  },
  {
    "poem_id": 88036,
    "vorder": 69,
    "position": 0,
    "text": "چه شگنان وز ترمذ ویسه گرد"
  },
  {
    "poem_id": 88036,
    "vorder": 70,
    "position": 1,
    "text": "بخارا و شهری که هستش بگرد"
  },
  {
    "poem_id": 88036,
    "vorder": 71,
    "position": 0,
    "text": "همیدون برو تا در سغد نیز"
  },
  {
    "poem_id": 88036,
    "vorder": 72,
    "position": 1,
    "text": "نجوید کس آن پادشاهی بنیز"
  },
  {
    "poem_id": 88036,
    "vorder": 73,
    "position": 0,
    "text": "وز آن سو که شد رستم گرد سوز"
  },
  {
    "poem_id": 88036,
    "vorder": 74,
    "position": 1,
    "text": "سپارم بدو کشور نیمروز"
  },
  {
    "poem_id": 88036,
    "vorder": 75,
    "position": 0,
    "text": "ز کوه و ز هامون بخوانم سپاه"
  },
  {
    "poem_id": 88036,
    "vorder": 76,
    "position": 1,
    "text": "سوی باختر برگشاییم راه"
  },
  {
    "poem_id": 88036,
    "vorder": 77,
    "position": 0,
    "text": "بپردازم این تا در هندوان"
  },
  {
    "poem_id": 88036,
    "vorder": 78,
    "position": 1,
    "text": "نداریم تاریک از این پس روان"
  },
  {
    "poem_id": 88036,
    "vorder": 79,
    "position": 0,
    "text": "ز کشمیر وز کابل و قندهار"
  },
  {
    "poem_id": 88036,
    "vorder": 80,
    "position": 1,
    "text": "شما را بود آن همه ز این شمار"
  },
  {
    "poem_id": 88036,
    "vorder": 81,
    "position": 0,
    "text": "وز آن سو که لهراسب شد جنگجوی"
  },
  {
    "poem_id": 88036,
    "vorder": 82,
    "position": 1,
    "text": "الانان و غر در سپارم بدوی"
  },
  {
    "poem_id": 88036,
    "vorder": 83,
    "position": 0,
    "text": "از این مرز پیوسته تا کوه قاف"
  },
  {
    "poem_id": 88036,
    "vorder": 84,
    "position": 1,
    "text": "به خسرو سپاریم بی‌جنگ و لاف"
  },
  {
    "poem_id": 88036,
    "vorder": 85,
    "position": 0,
    "text": "وز آن سو که اشکش بشد همچنین"
  },
  {
    "poem_id": 88036,
    "vorder": 86,
    "position": 1,
    "text": "بپردازم اکنون سراسر زمین"
  },
  {
    "poem_id": 88036,
    "vorder": 87,
    "position": 0,
    "text": "وز آن پس که این کرده باشم همه"
  },
  {
    "poem_id": 88036,
    "vorder": 88,
    "position": 1,
    "text": "ز هر سو بر خویش خوانم رمه"
  },
  {
    "poem_id": 88036,
    "vorder": 89,
    "position": 0,
    "text": "به سوگند پیمان کنم پیش تو"
  },
  {
    "poem_id": 88036,
    "vorder": 90,
    "position": 1,
    "text": "کز این پس نباشم بداندیش تو"
  },
  {
    "poem_id": 88036,
    "vorder": 91,
    "position": 0,
    "text": "بدانی که ما راستی خواستیم"
  },
  {
    "poem_id": 88036,
    "vorder": 92,
    "position": 1,
    "text": "به مهر و وفا دل بیاراستیم"
  },
  {
    "poem_id": 88036,
    "vorder": 93,
    "position": 0,
    "text": "سوی شاه ترکان فرستم خبر"
  },
  {
    "poem_id": 88036,
    "vorder": 94,
    "position": 1,
    "text": "که ما را ز کینه بپیچید سر"
  },
  {
    "poem_id": 88036,
    "vorder": 95,
    "position": 0,
    "text": "همیدون تو نزدیک خسرو به مهر"
  },
  {
    "poem_id": 88036,
    "vorder": 96,
    "position": 1,
    "text": "یکی نامه بنویس و بنمای چهر"
  },
  {
    "poem_id": 88036,
    "vorder": 97,
    "position": 0,
    "text": "چنین از ره مهر و پیکار من"
  },
  {
    "poem_id": 88036,
    "vorder": 98,
    "position": 1,
    "text": "ز خون ریختن با تو گفتار من"
  },
  {
    "poem_id": 88036,
    "vorder": 99,
    "position": 0,
    "text": "چو پیمان همه کرده باشیم راست"
  },
  {
    "poem_id": 88036,
    "vorder": 100,
    "position": 1,
    "text": "ز من خواسته هرچ خسرو بخواست"
  },
  {
    "poem_id": 88036,
    "vorder": 101,
    "position": 0,
    "text": "فرستم همه سر به سر نزد شاه"
  },
  {
    "poem_id": 88036,
    "vorder": 102,
    "position": 1,
    "text": "در کین ببندد مگر بر سپاه"
  },
  {
    "poem_id": 88036,
    "vorder": 103,
    "position": 0,
    "text": "از آن پس که این کرده باشیم نیز"
  },
  {
    "poem_id": 88036,
    "vorder": 104,
    "position": 1,
    "text": "گروگان فرستاده و داده چیز"
  },
  {
    "poem_id": 88036,
    "vorder": 105,
    "position": 0,
    "text": "بپیوندم این مهر و آیین و دین"
  },
  {
    "poem_id": 88036,
    "vorder": 106,
    "position": 1,
    "text": "بدوزم به دست وفا چشم کین"
  },
  {
    "poem_id": 88036,
    "vorder": 107,
    "position": 0,
    "text": "که بشکست هنگام شاه بزرگ"
  },
  {
    "poem_id": 88036,
    "vorder": 108,
    "position": 1,
    "text": "ز بد گوهر تور و سلم سترگ"
  },
  {
    "poem_id": 88036,
    "vorder": 109,
    "position": 0,
    "text": "فریدون که از درد سرگشته شد"
  },
  {
    "poem_id": 88036,
    "vorder": 110,
    "position": 1,
    "text": "کجا ایرج نامور کشته شد"
  },
  {
    "poem_id": 88036,
    "vorder": 111,
    "position": 0,
    "text": "ز من هرچ باید به نیکی بخواه"
  },
  {
    "poem_id": 88036,
    "vorder": 112,
    "position": 1,
    "text": "از آن پس بر این نامه کن نزد شاه"
  },
  {
    "poem_id": 88036,
    "vorder": 113,
    "position": 0,
    "text": "نباید کز این خوب گفتار من"
  },
  {
    "poem_id": 88036,
    "vorder": 114,
    "position": 1,
    "text": "به سستی گمانی برند انجمن"
  },
  {
    "poem_id": 88036,
    "vorder": 115,
    "position": 0,
    "text": "که من جز به مهر این نگویم همی"
  },
  {
    "poem_id": 88036,
    "vorder": 116,
    "position": 1,
    "text": "سرانجام نیکی بجویم همی"
  },
  {
    "poem_id": 88036,
    "vorder": 117,
    "position": 0,
    "text": "مرا گنج و مردان از آن تو بیش"
  },
  {
    "poem_id": 88036,
    "vorder": 118,
    "position": 1,
    "text": "به مردانگی نام از آن تو پیش"
  },
  {
    "poem_id": 88036,
    "vorder": 119,
    "position": 0,
    "text": "ولیکن بدین کینه انگیختن"
  },
  {
    "poem_id": 88036,
    "vorder": 120,
    "position": 1,
    "text": "به بیداد هر جای خون ریختن"
  },
  {
    "poem_id": 88036,
    "vorder": 121,
    "position": 0,
    "text": "بسوزد همی بر سپه بر دلم"
  },
  {
    "poem_id": 88036,
    "vorder": 122,
    "position": 1,
    "text": "بکوشم که کین از میان بگسلم"
  },
  {
    "poem_id": 88036,
    "vorder": 123,
    "position": 0,
    "text": "سه دیگر که از کردگار جهان"
  },
  {
    "poem_id": 88036,
    "vorder": 124,
    "position": 1,
    "text": "بترسم همی آشکار و نهان"
  },
  {
    "poem_id": 88036,
    "vorder": 125,
    "position": 0,
    "text": "که نپسندد از ما بدی دادگر"
  },
  {
    "poem_id": 88036,
    "vorder": 126,
    "position": 1,
    "text": "گزافه نبردارد این شور و شر"
  },
  {
    "poem_id": 88036,
    "vorder": 127,
    "position": 0,
    "text": "اگر سر بپیچی ز گفتار من"
  },
  {
    "poem_id": 88036,
    "vorder": 128,
    "position": 1,
    "text": "نجویی همه ژرف کردار من"
  },
  {
    "poem_id": 88036,
    "vorder": 129,
    "position": 0,
    "text": "گنهکار دانی مرا بی‌گناه"
  },
  {
    "poem_id": 88036,
    "vorder": 130,
    "position": 1,
    "text": "نخواهی به گفتار کردن نگاه"
  },
  {
    "poem_id": 88036,
    "vorder": 131,
    "position": 0,
    "text": "کجا داد و بیداد نزدت یکیست"
  },
  {
    "poem_id": 88036,
    "vorder": 132,
    "position": 1,
    "text": "جز از کینه گستردنت رای نیست"
  },
  {
    "poem_id": 88036,
    "vorder": 133,
    "position": 0,
    "text": "گزین کن ز گردان ایران سران"
  },
  {
    "poem_id": 88036,
    "vorder": 134,
    "position": 1,
    "text": "کسی کو گراید به گرز گران"
  },
  {
    "poem_id": 88036,
    "vorder": 135,
    "position": 0,
    "text": "همیدون من از لشکر خویش مرد"
  },
  {
    "poem_id": 88036,
    "vorder": 136,
    "position": 1,
    "text": "گزینم چو باید ز بهر نبرد"
  },
  {
    "poem_id": 88036,
    "vorder": 137,
    "position": 0,
    "text": "همه یک به دیگر فراز آوریم"
  },
  {
    "poem_id": 88036,
    "vorder": 138,
    "position": 1,
    "text": "سران را ز سر سوی گاز آوریم"
  },
  {
    "poem_id": 88036,
    "vorder": 139,
    "position": 0,
    "text": "همیدون من و تو به آوردگاه"
  },
  {
    "poem_id": 88036,
    "vorder": 140,
    "position": 1,
    "text": "بگردیم یک با دگر کینه‌خواه"
  },
  {
    "poem_id": 88036,
    "vorder": 141,
    "position": 0,
    "text": "مگر بیگناهان ز خون ریختن"
  },
  {
    "poem_id": 88036,
    "vorder": 142,
    "position": 1,
    "text": "به آسایش آیند ز آویختن"
  },
  {
    "poem_id": 88036,
    "vorder": 143,
    "position": 0,
    "text": "کسی کش گنهکار داری همی"
  },
  {
    "poem_id": 88036,
    "vorder": 144,
    "position": 1,
    "text": "وز او بر دل آزار داری همی"
  },
  {
    "poem_id": 88036,
    "vorder": 145,
    "position": 0,
    "text": "به پیش تو آرم به روز نبرد"
  },
  {
    "poem_id": 88036,
    "vorder": 146,
    "position": 1,
    "text": "ببایدت پیمان یکی نیز کرد"
  },
  {
    "poem_id": 88036,
    "vorder": 147,
    "position": 0,
    "text": "که بر ما تو گر دست یابی به خون"
  },
  {
    "poem_id": 88036,
    "vorder": 148,
    "position": 1,
    "text": "شود بخت گردان ترکان نگون"
  },
  {
    "poem_id": 88036,
    "vorder": 149,
    "position": 0,
    "text": "نیازاری از بن سپاه مرا"
  },
  {
    "poem_id": 88036,
    "vorder": 150,
    "position": 1,
    "text": "نسوزی بر و بوم و گاه مرا"
  },
  {
    "poem_id": 88036,
    "vorder": 151,
    "position": 0,
    "text": "گذرشان دهی تا به توران شوند"
  },
  {
    "poem_id": 88036,
    "vorder": 152,
    "position": 1,
    "text": "کمین را نسازی بر ایشان کمند"
  },
  {
    "poem_id": 88036,
    "vorder": 153,
    "position": 0,
    "text": "وگر من شوم بر تو پیروزگر"
  },
  {
    "poem_id": 88036,
    "vorder": 154,
    "position": 1,
    "text": "دهد مر مرا اختر نیک بر"
  },
  {
    "poem_id": 88036,
    "vorder": 155,
    "position": 0,
    "text": "نسازم به ایرانیان بر کمین"
  },
  {
    "poem_id": 88036,
    "vorder": 156,
    "position": 1,
    "text": "نگیریم خشم و نجوییم کین"
  },
  {
    "poem_id": 88036,
    "vorder": 157,
    "position": 0,
    "text": "سوی شهر ایران دهم راهشان"
  },
  {
    "poem_id": 88036,
    "vorder": 158,
    "position": 1,
    "text": "گذارم یکایک سوی شاهشان"
  },
  {
    "poem_id": 88036,
    "vorder": 159,
    "position": 0,
    "text": "از ایشان نگردد یکی کاسته"
  },
  {
    "poem_id": 88036,
    "vorder": 160,
    "position": 1,
    "text": "شوند ایمن از جان وز خواسته"
  },
  {
    "poem_id": 88036,
    "vorder": 161,
    "position": 0,
    "text": "ور ایدونک زین سان نجویی نبرد"
  },
  {
    "poem_id": 88036,
    "vorder": 162,
    "position": 1,
    "text": "دگرگونه خواهی همی کار کرد"
  },
  {
    "poem_id": 88036,
    "vorder": 163,
    "position": 0,
    "text": "به انبوه جویی همی کارزار"
  },
  {
    "poem_id": 88036,
    "vorder": 164,
    "position": 1,
    "text": "سپه را سراسر به جنگ اند آر"
  },
  {
    "poem_id": 88036,
    "vorder": 165,
    "position": 0,
    "text": "هر آن خون که آید به کین ریخته"
  },
  {
    "poem_id": 88036,
    "vorder": 166,
    "position": 1,
    "text": "تو باشی بدان گیتی آویخته"
  },
  {
    "poem_id": 88036,
    "vorder": 167,
    "position": 0,
    "text": "ببست از بر نامه بر بند را"
  },
  {
    "poem_id": 88036,
    "vorder": 168,
    "position": 1,
    "text": "بخواند آن گرانمایه فرزند را"
  },
  {
    "poem_id": 88036,
    "vorder": 169,
    "position": 0,
    "text": "پسر بد مر او را سر انجمن"
  },
  {
    "poem_id": 88036,
    "vorder": 170,
    "position": 1,
    "text": "یکی نام رویین و رویینه تن"
  },
  {
    "poem_id": 88036,
    "vorder": 171,
    "position": 0,
    "text": "بدو گفت نزدیک گودرز شو"
  },
  {
    "poem_id": 88036,
    "vorder": 172,
    "position": 1,
    "text": "سخن گوی هشیار و پاسخ شنو"
  },
  {
    "poem_id": 88036,
    "vorder": 173,
    "position": 0,
    "text": "چو رویین برفت از در نامور"
  },
  {
    "poem_id": 88036,
    "vorder": 174,
    "position": 1,
    "text": "فرستاده با ده سوار دگر"
  },
  {
    "poem_id": 88036,
    "vorder": 175,
    "position": 0,
    "text": "بیامد خردمند روشن‌روان"
  },
  {
    "poem_id": 88036,
    "vorder": 176,
    "position": 1,
    "text": "دمان تا سراپردهٔ پهلوان"
  },
  {
    "poem_id": 88036,
    "vorder": 177,
    "position": 0,
    "text": "چو رویین پیران به درگه رسید"
  },
  {
    "poem_id": 88036,
    "vorder": 178,
    "position": 1,
    "text": "سوی پهلوان سپه کس دوید"
  },
  {
    "poem_id": 88036,
    "vorder": 179,
    "position": 0,
    "text": "فرستاده را خواند پس پهلوان"
  },
  {
    "poem_id": 88036,
    "vorder": 180,
    "position": 1,
    "text": "دمان از پس پرده آمد جوان"
  },
  {
    "poem_id": 88036,
    "vorder": 181,
    "position": 0,
    "text": "بیامد چو گودرز را دید دست"
  },
  {
    "poem_id": 88036,
    "vorder": 182,
    "position": 1,
    "text": "به کش کرد و سر پیش بنهاد پست"
  },
  {
    "poem_id": 88036,
    "vorder": 183,
    "position": 0,
    "text": "سپهدار بر جست و او را چو دود"
  },
  {
    "poem_id": 88036,
    "vorder": 184,
    "position": 1,
    "text": "به آغوش تنگ اندر آورد زود"
  },
  {
    "poem_id": 88036,
    "vorder": 185,
    "position": 0,
    "text": "ز پیران بپرسید وز لشکرش"
  },
  {
    "poem_id": 88036,
    "vorder": 186,
    "position": 1,
    "text": "ز گردان وز شاه وز کشورش"
  },
  {
    "poem_id": 88036,
    "vorder": 187,
    "position": 0,
    "text": "خردمند رویین پس آن نامه پیش"
  },
  {
    "poem_id": 88036,
    "vorder": 188,
    "position": 1,
    "text": "بیاورد و بگزارد پیغام خویش"
  },
  {
    "poem_id": 88036,
    "vorder": 189,
    "position": 0,
    "text": "دبیر آمد و نامه برخواند زود"
  },
  {
    "poem_id": 88036,
    "vorder": 190,
    "position": 1,
    "text": "به گودرز گفت آنچ در نامه بود"
  },
  {
    "poem_id": 88036,
    "vorder": 191,
    "position": 0,
    "text": "چو نامه به گودرز برخواندند"
  },
  {
    "poem_id": 88036,
    "vorder": 192,
    "position": 1,
    "text": "همه نامداران فرو ماندند"
  },
  {
    "poem_id": 88036,
    "vorder": 193,
    "position": 0,
    "text": "ز بس چرب‌گفتار وز پند خوب"
  },
  {
    "poem_id": 88036,
    "vorder": 194,
    "position": 1,
    "text": "نمودن بدو راه و پیوند خوب"
  },
  {
    "poem_id": 88036,
    "vorder": 195,
    "position": 0,
    "text": "خردمند پیران که در نامه یاد"
  },
  {
    "poem_id": 88036,
    "vorder": 196,
    "position": 1,
    "text": "چه آورد وز پند نیکو چه داد"
  },
  {
    "poem_id": 88036,
    "vorder": 197,
    "position": 0,
    "text": "به رویین چنین گفت پس پهلوان"
  },
  {
    "poem_id": 88036,
    "vorder": 198,
    "position": 1,
    "text": "که‌ای پور سالار و فرخ جوان"
  },
  {
    "poem_id": 88036,
    "vorder": 199,
    "position": 0,
    "text": "تو مهمان ما بود باید نخست"
  },
  {
    "poem_id": 88036,
    "vorder": 200,
    "position": 1,
    "text": "پس این پاسخ نامه بایدت جست"
  },
  {
    "poem_id": 88036,
    "vorder": 201,
    "position": 0,
    "text": "سراپردهٔ نو بپرداختند"
  },
  {
    "poem_id": 88036,
    "vorder": 202,
    "position": 1,
    "text": "نشستنگه خسروی ساختند"
  },
  {
    "poem_id": 88036,
    "vorder": 203,
    "position": 0,
    "text": "به دیبای رومی بیاراستند"
  },
  {
    "poem_id": 88036,
    "vorder": 204,
    "position": 1,
    "text": "خورش ها و رامشگران خواستند"
  },
  {
    "poem_id": 88036,
    "vorder": 205,
    "position": 0,
    "text": "پراندیشه گشته دل پهلوان"
  },
  {
    "poem_id": 88036,
    "vorder": 206,
    "position": 1,
    "text": "نبشته ابا رای‌زن موبدان"
  },
  {
    "poem_id": 88036,
    "vorder": 207,
    "position": 0,
    "text": "همی پاسخ نامه آراستند"
  },
  {
    "poem_id": 88036,
    "vorder": 208,
    "position": 1,
    "text": "سخن هرچ نیکوتر آن خواستند"
  },
  {
    "poem_id": 88036,
    "vorder": 209,
    "position": 0,
    "text": "به یک هفته گودرز با رود و می"
  },
  {
    "poem_id": 88036,
    "vorder": 210,
    "position": 1,
    "text": "همی نامه را پاسخ افگند پی"
  },
  {
    "poem_id": 88036,
    "vorder": 211,
    "position": 0,
    "text": "ز بالا چو خورشید گیتی فروز"
  },
  {
    "poem_id": 88036,
    "vorder": 212,
    "position": 1,
    "text": "بگشتی سپهبد گه نیم‌روز"
  },
  {
    "poem_id": 88036,
    "vorder": 213,
    "position": 0,
    "text": "می و رود و مجلس بیاراستی"
  },
  {
    "poem_id": 88036,
    "vorder": 214,
    "position": 1,
    "text": "فرستاده را پیش خود خواستی"
  },
  {
    "poem_id": 88036,
    "vorder": 215,
    "position": 0,
    "text": "چو یک هفته بگذشت هشتم پگاه"
  },
  {
    "poem_id": 88036,
    "vorder": 216,
    "position": 1,
    "text": "نویسنده را خواند سالار شاه"
  },
  {
    "poem_id": 88036,
    "vorder": 217,
    "position": 0,
    "text": "بفرمود تا نامه پاسخ نوشت"
  },
  {
    "poem_id": 88036,
    "vorder": 218,
    "position": 1,
    "text": "درختی به نوی به کینه بکشت"
  }
]