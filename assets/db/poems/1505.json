[
  {
    "poem_id": 1505,
    "vorder": 1,
    "position": 0,
    "text": "کنون ای خردمند روشن‌روان"
  },
  {
    "poem_id": 1505,
    "vorder": 2,
    "position": 1,
    "text": "بجز نام یزدان مگردان زبان"
  },
  {
    "poem_id": 1505,
    "vorder": 3,
    "position": 0,
    "text": "که اویست بر نیک و بد رهنمای"
  },
  {
    "poem_id": 1505,
    "vorder": 4,
    "position": 1,
    "text": "وزویست گردون گردان بجای"
  },
  {
    "poem_id": 1505,
    "vorder": 5,
    "position": 0,
    "text": "همی بگذرد بر تو ایام تو"
  },
  {
    "poem_id": 1505,
    "vorder": 6,
    "position": 1,
    "text": "سرایی جزین باشد آرام تو"
  },
  {
    "poem_id": 1505,
    "vorder": 7,
    "position": 0,
    "text": "چو باشی بدین گفته همداستان"
  },
  {
    "poem_id": 1505,
    "vorder": 8,
    "position": 1,
    "text": "که دهقان همی گوید از باستان"
  },
  {
    "poem_id": 1505,
    "vorder": 9,
    "position": 0,
    "text": "ازان پس خبر شد بخاقان چین"
  },
  {
    "poem_id": 1505,
    "vorder": 10,
    "position": 1,
    "text": "که شد کشته کاموس بر دشت کین"
  },
  {
    "poem_id": 1505,
    "vorder": 11,
    "position": 0,
    "text": "کشانی و شگنی و گردان بلخ"
  },
  {
    "poem_id": 1505,
    "vorder": 12,
    "position": 1,
    "text": "ز کاموس‌شان تیره شد روز و تلخ"
  },
  {
    "poem_id": 1505,
    "vorder": 13,
    "position": 0,
    "text": "همه یک بدیگر نهادند روی"
  },
  {
    "poem_id": 1505,
    "vorder": 14,
    "position": 1,
    "text": "که این پرهنر مرد پرخاشجوی"
  },
  {
    "poem_id": 1505,
    "vorder": 15,
    "position": 0,
    "text": "چه مردست و این مرد را نام چیست"
  },
  {
    "poem_id": 1505,
    "vorder": 16,
    "position": 1,
    "text": "هم آورد او در جهان مرد کیست"
  },
  {
    "poem_id": 1505,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت هومان به پیران شیر"
  },
  {
    "poem_id": 1505,
    "vorder": 18,
    "position": 1,
    "text": "که امروز شد جانم از رزم سیر"
  },
  {
    "poem_id": 1505,
    "vorder": 19,
    "position": 0,
    "text": "دلیران ما چون فرازند چنگ"
  },
  {
    "poem_id": 1505,
    "vorder": 20,
    "position": 1,
    "text": "که شد کشته کاموس جنگی بجنگ"
  },
  {
    "poem_id": 1505,
    "vorder": 21,
    "position": 0,
    "text": "بگیتی چنو نامداری نبود"
  },
  {
    "poem_id": 1505,
    "vorder": 22,
    "position": 1,
    "text": "وزو پیلتن تر سواری نبود"
  },
  {
    "poem_id": 1505,
    "vorder": 23,
    "position": 0,
    "text": "چو کاموس گو را بخم کمند"
  },
  {
    "poem_id": 1505,
    "vorder": 24,
    "position": 1,
    "text": "به آوردگه بر توان کرد بند"
  },
  {
    "poem_id": 1505,
    "vorder": 25,
    "position": 0,
    "text": "سزد گر سر پیل را روز کین"
  },
  {
    "poem_id": 1505,
    "vorder": 26,
    "position": 1,
    "text": "بگیرد برآرد زند بر زمین"
  },
  {
    "poem_id": 1505,
    "vorder": 27,
    "position": 0,
    "text": "سپه سربسر پیش خاقان شدند"
  },
  {
    "poem_id": 1505,
    "vorder": 28,
    "position": 1,
    "text": "ز کاموس با درد و گریان شدند"
  },
  {
    "poem_id": 1505,
    "vorder": 29,
    "position": 0,
    "text": "که آغاز و فرجام این رزمگاه"
  },
  {
    "poem_id": 1505,
    "vorder": 30,
    "position": 1,
    "text": "شنیدی و دیدی بنزد سپاه"
  },
  {
    "poem_id": 1505,
    "vorder": 31,
    "position": 0,
    "text": "کنون چارهٔ کار ما بازجوی"
  },
  {
    "poem_id": 1505,
    "vorder": 32,
    "position": 1,
    "text": "بتنها تن خویش و کس را مگوی"
  },
  {
    "poem_id": 1505,
    "vorder": 33,
    "position": 0,
    "text": "بلشکر نگه کن ز کارآگهان"
  },
  {
    "poem_id": 1505,
    "vorder": 34,
    "position": 1,
    "text": "کسی کو سخن باز جوید نهان"
  },
  {
    "poem_id": 1505,
    "vorder": 35,
    "position": 0,
    "text": "ببیند که این شیر دل مرد کیست"
  },
  {
    "poem_id": 1505,
    "vorder": 36,
    "position": 1,
    "text": "وزین لشکر او را هم آورد کیست"
  },
  {
    "poem_id": 1505,
    "vorder": 37,
    "position": 0,
    "text": "از آن پس همه تن بکشتن دهیم"
  },
  {
    "poem_id": 1505,
    "vorder": 38,
    "position": 1,
    "text": "به آوردگه بر سر و تن نهیم"
  },
  {
    "poem_id": 1505,
    "vorder": 39,
    "position": 0,
    "text": "بپیران چنین گفت خاقان چین"
  },
  {
    "poem_id": 1505,
    "vorder": 40,
    "position": 1,
    "text": "که خود درد ازینست و تیمار ازین"
  },
  {
    "poem_id": 1505,
    "vorder": 41,
    "position": 0,
    "text": "که تا کیست زان لشکر پرگزند"
  },
  {
    "poem_id": 1505,
    "vorder": 42,
    "position": 1,
    "text": "کجا پیل گیرد بخم کمند"
  },
  {
    "poem_id": 1505,
    "vorder": 43,
    "position": 0,
    "text": "ابا آنک از مرگ خود چاره نیست"
  },
  {
    "poem_id": 1505,
    "vorder": 44,
    "position": 1,
    "text": "ره خواهش و پرسش و یاره نیست"
  },
  {
    "poem_id": 1505,
    "vorder": 45,
    "position": 0,
    "text": "ز مادر همه مرگ را زاده‌ایم"
  },
  {
    "poem_id": 1505,
    "vorder": 46,
    "position": 1,
    "text": "بناکام گردن بدو داده‌ایم"
  },
  {
    "poem_id": 1505,
    "vorder": 47,
    "position": 0,
    "text": "کس از گردش آسمان نگذرد"
  },
  {
    "poem_id": 1505,
    "vorder": 48,
    "position": 1,
    "text": "وگر بر زمین پیل را بشکرد"
  },
  {
    "poem_id": 1505,
    "vorder": 49,
    "position": 0,
    "text": "شما دل مدارید ازو مستمند"
  },
  {
    "poem_id": 1505,
    "vorder": 50,
    "position": 1,
    "text": "کجا کشته شد زیر خم کمند"
  },
  {
    "poem_id": 1505,
    "vorder": 51,
    "position": 0,
    "text": "مر آن را که کاموس ازو شد هلاک"
  },
  {
    "poem_id": 1505,
    "vorder": 52,
    "position": 1,
    "text": "ببند کمند اندر آرم بخاک"
  },
  {
    "poem_id": 1505,
    "vorder": 53,
    "position": 0,
    "text": "همه شهر ایران کنم رود آب"
  },
  {
    "poem_id": 1505,
    "vorder": 54,
    "position": 1,
    "text": "بکام دل خسرو افراسیاب"
  },
  {
    "poem_id": 1505,
    "vorder": 55,
    "position": 0,
    "text": "ز لشکر بسی نامور گرد کرد"
  },
  {
    "poem_id": 1505,
    "vorder": 56,
    "position": 1,
    "text": "ز خنجرگزاران و مردان مرد"
  },
  {
    "poem_id": 1505,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت کین مرد جنگی بتیر"
  },
  {
    "poem_id": 1505,
    "vorder": 58,
    "position": 1,
    "text": "سوار کمندافگن و گردگیر"
  },
  {
    "poem_id": 1505,
    "vorder": 59,
    "position": 0,
    "text": "نگه کرد باید که جایش کجاست"
  },
  {
    "poem_id": 1505,
    "vorder": 60,
    "position": 1,
    "text": "بگرد چپ لشکر و دست راست"
  },
  {
    "poem_id": 1505,
    "vorder": 61,
    "position": 0,
    "text": "هم از شهر پرسد هم از نام او"
  },
  {
    "poem_id": 1505,
    "vorder": 62,
    "position": 1,
    "text": "ازانپس بسازیم فرجام او"
  },
  {
    "poem_id": 1505,
    "vorder": 63,
    "position": 0,
    "text": "سواری سرافراز و خسروپرست"
  },
  {
    "poem_id": 1505,
    "vorder": 64,
    "position": 1,
    "text": "بیامد ببر زد برین کار دست"
  },
  {
    "poem_id": 1505,
    "vorder": 65,
    "position": 0,
    "text": "که چنگش بدش نام و جوینده بود"
  },
  {
    "poem_id": 1505,
    "vorder": 66,
    "position": 1,
    "text": "دلیر و به هر کار پوینده بود"
  },
  {
    "poem_id": 1505,
    "vorder": 67,
    "position": 0,
    "text": "بخاقان چنین گفت کای سرفراز"
  },
  {
    "poem_id": 1505,
    "vorder": 68,
    "position": 1,
    "text": "جهان را بمهر تو بادا نیاز"
  },
  {
    "poem_id": 1505,
    "vorder": 69,
    "position": 0,
    "text": "گر او شیر جنگیست بیجان کنم"
  },
  {
    "poem_id": 1505,
    "vorder": 70,
    "position": 1,
    "text": "بدانگه که سر سوی ایران کنم"
  },
  {
    "poem_id": 1505,
    "vorder": 71,
    "position": 0,
    "text": "بتنها تن خویش جنگ‌آورم"
  },
  {
    "poem_id": 1505,
    "vorder": 72,
    "position": 1,
    "text": "همه نام او زیر ننگ آورم"
  },
  {
    "poem_id": 1505,
    "vorder": 73,
    "position": 0,
    "text": "ازو کین کاموس جویم نخست"
  },
  {
    "poem_id": 1505,
    "vorder": 74,
    "position": 1,
    "text": "پس از مرگ نامش بیارم درست"
  },
  {
    "poem_id": 1505,
    "vorder": 75,
    "position": 0,
    "text": "برو آفرین کرد خاقان چین"
  },
  {
    "poem_id": 1505,
    "vorder": 76,
    "position": 1,
    "text": "بپیشش ببوسید چنگش زمین"
  },
  {
    "poem_id": 1505,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت ار این کینه بازآوری"
  },
  {
    "poem_id": 1505,
    "vorder": 78,
    "position": 1,
    "text": "سوی من سر بی‌نیاز آوری"
  },
  {
    "poem_id": 1505,
    "vorder": 79,
    "position": 0,
    "text": "ببخشمت چندان گهرها ز گنج"
  },
  {
    "poem_id": 1505,
    "vorder": 80,
    "position": 1,
    "text": "کزان پس نباید کشیدنت رنج"
  }
]