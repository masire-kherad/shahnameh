[
  {
    "poem_id": 88029,
    "vorder": 1,
    "position": 0,
    "text": "وز آن لشکر ترک هومان دلیر"
  },
  {
    "poem_id": 88029,
    "vorder": 2,
    "position": 1,
    "text": "به پیش برادر بیامد چو شیر"
  },
  {
    "poem_id": 88029,
    "vorder": 3,
    "position": 0,
    "text": "که ای پهلوان رد افراسیاب"
  },
  {
    "poem_id": 88029,
    "vorder": 4,
    "position": 1,
    "text": "گرفت اندر این دشت ما را شتاب"
  },
  {
    "poem_id": 88029,
    "vorder": 5,
    "position": 0,
    "text": "به هفتم فراز آمد این روزگار"
  },
  {
    "poem_id": 88029,
    "vorder": 6,
    "position": 1,
    "text": "میان بسته در جنگ چندین سوار"
  },
  {
    "poem_id": 88029,
    "vorder": 7,
    "position": 0,
    "text": "از آهن میان سوده و دل ز کین"
  },
  {
    "poem_id": 88029,
    "vorder": 8,
    "position": 1,
    "text": "نهاده دو دیده به ایران زمین"
  },
  {
    "poem_id": 88029,
    "vorder": 9,
    "position": 0,
    "text": "چه داری به روی اندر آورده روی"
  },
  {
    "poem_id": 88029,
    "vorder": 10,
    "position": 1,
    "text": "چه اندیشه داری به دل در بگوی"
  },
  {
    "poem_id": 88029,
    "vorder": 11,
    "position": 0,
    "text": "گرت رای جنگست جنگ آزمای"
  },
  {
    "poem_id": 88029,
    "vorder": 12,
    "position": 1,
    "text": "ورت رای برگشتن ایدر مپای"
  },
  {
    "poem_id": 88029,
    "vorder": 13,
    "position": 0,
    "text": "که ننگست از این بر تو ای پهلوان"
  },
  {
    "poem_id": 88029,
    "vorder": 14,
    "position": 1,
    "text": "بدین کار خندند پیر و جوان"
  },
  {
    "poem_id": 88029,
    "vorder": 15,
    "position": 0,
    "text": "همان لشکرست این که از ما بجنگ"
  },
  {
    "poem_id": 88029,
    "vorder": 16,
    "position": 1,
    "text": "برفتند و رفته ز روی آب و رنگ"
  },
  {
    "poem_id": 88029,
    "vorder": 17,
    "position": 0,
    "text": "کز ایشان همه رزمگه کشته بود"
  },
  {
    "poem_id": 88029,
    "vorder": 18,
    "position": 1,
    "text": "زمین سر به سر رود خون گشته بود"
  },
  {
    "poem_id": 88029,
    "vorder": 19,
    "position": 0,
    "text": "نه زین نامداران سواری کم است"
  },
  {
    "poem_id": 88029,
    "vorder": 20,
    "position": 1,
    "text": "نه آن دوده را پهلوان رستم است"
  },
  {
    "poem_id": 88029,
    "vorder": 21,
    "position": 0,
    "text": "گرت آرزو نیست خون ریختن"
  },
  {
    "poem_id": 88029,
    "vorder": 22,
    "position": 1,
    "text": "نخواهی همی لشکر انگیختن"
  },
  {
    "poem_id": 88029,
    "vorder": 23,
    "position": 0,
    "text": "ز جنگ‌آوران لشکری برگزین"
  },
  {
    "poem_id": 88029,
    "vorder": 24,
    "position": 1,
    "text": "به من ده تو بنگر کنون رزم و کین"
  },
  {
    "poem_id": 88029,
    "vorder": 25,
    "position": 0,
    "text": "چو بشنید پیران ز هومان سخن"
  },
  {
    "poem_id": 88029,
    "vorder": 26,
    "position": 1,
    "text": "بدو گفت مشتاب و تندی مکن"
  },
  {
    "poem_id": 88029,
    "vorder": 27,
    "position": 0,
    "text": "بدان ای برادر که این رزمخواه"
  },
  {
    "poem_id": 88029,
    "vorder": 28,
    "position": 1,
    "text": "که آمد چنین پیش ما با سپاه"
  },
  {
    "poem_id": 88029,
    "vorder": 29,
    "position": 0,
    "text": "گزین بزرگان کیخسروست"
  },
  {
    "poem_id": 88029,
    "vorder": 30,
    "position": 1,
    "text": "سر نامداران هر پهلوست"
  },
  {
    "poem_id": 88029,
    "vorder": 31,
    "position": 0,
    "text": "یکی آنک کیخسرو از شاه من"
  },
  {
    "poem_id": 88029,
    "vorder": 32,
    "position": 1,
    "text": "بدو سر فرازد به هر انجمن"
  },
  {
    "poem_id": 88029,
    "vorder": 33,
    "position": 0,
    "text": "و دیگر که از پهلوانان شاه"
  },
  {
    "poem_id": 88029,
    "vorder": 34,
    "position": 1,
    "text": "ندانم چو گودرز کس را به جاه"
  },
  {
    "poem_id": 88029,
    "vorder": 35,
    "position": 0,
    "text": "به گردن‌فرازی و مردانگی"
  },
  {
    "poem_id": 88029,
    "vorder": 36,
    "position": 1,
    "text": "به رای هشیوار و فرزانگی"
  },
  {
    "poem_id": 88029,
    "vorder": 37,
    "position": 0,
    "text": "سه دیگر که پرداغ دارد جگر"
  },
  {
    "poem_id": 88029,
    "vorder": 38,
    "position": 1,
    "text": "پر از خون دل از درد چندان پسر"
  },
  {
    "poem_id": 88029,
    "vorder": 39,
    "position": 0,
    "text": "که از تن سرانشان جدا مانده‌ایم"
  },
  {
    "poem_id": 88029,
    "vorder": 40,
    "position": 1,
    "text": "زمین را به خون گرد بنشانده‌ایم"
  },
  {
    "poem_id": 88029,
    "vorder": 41,
    "position": 0,
    "text": "کنون تا به تنش اندرون جان بود"
  },
  {
    "poem_id": 88029,
    "vorder": 42,
    "position": 1,
    "text": "بر این کینه چون مار پیچان بود"
  },
  {
    "poem_id": 88029,
    "vorder": 43,
    "position": 0,
    "text": "چهارم که لشکر میان دو کوه"
  },
  {
    "poem_id": 88029,
    "vorder": 44,
    "position": 1,
    "text": "فرود آوریدست و کرده گروه"
  },
  {
    "poem_id": 88029,
    "vorder": 45,
    "position": 0,
    "text": "ز هر سو که پویی بدو راه نیست"
  },
  {
    "poem_id": 88029,
    "vorder": 46,
    "position": 1,
    "text": "براندیش کین رنج کوتاه نیست"
  },
  {
    "poem_id": 88029,
    "vorder": 47,
    "position": 0,
    "text": "بکوشید باید بدان تا مگر"
  },
  {
    "poem_id": 88029,
    "vorder": 48,
    "position": 1,
    "text": "از آن کوه‌پایه برآرند سر"
  },
  {
    "poem_id": 88029,
    "vorder": 49,
    "position": 0,
    "text": "مگر مانده گردند و سستی کنند"
  },
  {
    "poem_id": 88029,
    "vorder": 50,
    "position": 1,
    "text": "به جنگ اندرون پیشدستی کنند"
  },
  {
    "poem_id": 88029,
    "vorder": 51,
    "position": 0,
    "text": "چو از کوه بیرون کند لشکرش"
  },
  {
    "poem_id": 88029,
    "vorder": 52,
    "position": 1,
    "text": "یکی تیرباران کنم بر سرش"
  },
  {
    "poem_id": 88029,
    "vorder": 53,
    "position": 0,
    "text": "چو دیوار گرد اندر آریمشان"
  },
  {
    "poem_id": 88029,
    "vorder": 54,
    "position": 1,
    "text": "چو شیر ژیان در بر آریمشان"
  },
  {
    "poem_id": 88029,
    "vorder": 55,
    "position": 0,
    "text": "بر ایشان بگردد همه کام ما"
  },
  {
    "poem_id": 88029,
    "vorder": 56,
    "position": 1,
    "text": "برآید به خورشید بر نام ما"
  },
  {
    "poem_id": 88029,
    "vorder": 57,
    "position": 0,
    "text": "تو پشت سپاهی و سالار شاه"
  },
  {
    "poem_id": 88029,
    "vorder": 58,
    "position": 1,
    "text": "برآورده از چرخ گردان کلاه"
  },
  {
    "poem_id": 88029,
    "vorder": 59,
    "position": 0,
    "text": "کسی کو به نام بلندش نیاز"
  },
  {
    "poem_id": 88029,
    "vorder": 60,
    "position": 1,
    "text": "نباشد چه گردد همی گرد آز"
  },
  {
    "poem_id": 88029,
    "vorder": 61,
    "position": 0,
    "text": "و دیگر که از نامداران جنگ"
  },
  {
    "poem_id": 88029,
    "vorder": 62,
    "position": 1,
    "text": "نیاید کسی نزد ما بی‌درنگ"
  },
  {
    "poem_id": 88029,
    "vorder": 63,
    "position": 0,
    "text": "ز گردان کسی را که بی‌نام‌تر"
  },
  {
    "poem_id": 88029,
    "vorder": 64,
    "position": 1,
    "text": "ز جنگ سواران بی‌آرام‌تر"
  },
  {
    "poem_id": 88029,
    "vorder": 65,
    "position": 0,
    "text": "ز لشکر فرستد به پیشت بکین"
  },
  {
    "poem_id": 88029,
    "vorder": 66,
    "position": 1,
    "text": "اگر برنوردی بر او بر زمین"
  },
  {
    "poem_id": 88029,
    "vorder": 67,
    "position": 0,
    "text": "ترا نام از آن برنیاید بلند"
  },
  {
    "poem_id": 88029,
    "vorder": 68,
    "position": 1,
    "text": "به ایرانیان نیز ناید گزند"
  },
  {
    "poem_id": 88029,
    "vorder": 69,
    "position": 0,
    "text": "وگر بر تو بر دست یابد به خون"
  },
  {
    "poem_id": 88029,
    "vorder": 70,
    "position": 1,
    "text": "شوند این دلیران ترکان زبون"
  },
  {
    "poem_id": 88029,
    "vorder": 71,
    "position": 0,
    "text": "نگه کرد هومان به گفتار اوی"
  },
  {
    "poem_id": 88029,
    "vorder": 72,
    "position": 1,
    "text": "همی خیره دانست پیکار اوی"
  },
  {
    "poem_id": 88029,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد پاسخ کز ایران سوار"
  },
  {
    "poem_id": 88029,
    "vorder": 74,
    "position": 1,
    "text": "نباشد که با من کند کارزار"
  },
  {
    "poem_id": 88029,
    "vorder": 75,
    "position": 0,
    "text": "ترا خود همین مهربانیست خوی"
  },
  {
    "poem_id": 88029,
    "vorder": 76,
    "position": 1,
    "text": "مرا کارزار آمدست آرزوی"
  },
  {
    "poem_id": 88029,
    "vorder": 77,
    "position": 0,
    "text": "وگر کت به کین جستن آهنگ نیست"
  },
  {
    "poem_id": 88029,
    "vorder": 78,
    "position": 1,
    "text": "به دلت اندرون آتش جنگ نیست"
  },
  {
    "poem_id": 88029,
    "vorder": 79,
    "position": 0,
    "text": "کنم آنچ باید بدین رزمگاه"
  },
  {
    "poem_id": 88029,
    "vorder": 80,
    "position": 1,
    "text": "نمایم هنرها به ایران سپاه"
  },
  {
    "poem_id": 88029,
    "vorder": 81,
    "position": 0,
    "text": "شوم چرمهٔ گامزن زین کنم"
  },
  {
    "poem_id": 88029,
    "vorder": 82,
    "position": 1,
    "text": "سپیده دمان جستن کین کنم"
  }
]