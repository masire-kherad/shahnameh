[
  {
    "poem_id": 88101,
    "vorder": 1,
    "position": 0,
    "text": "چو گودرز بنشست برخاست طوس"
  },
  {
    "poem_id": 88101,
    "vorder": 2,
    "position": 1,
    "text": "بشد پیش خسرو زمین داد بوس"
  },
  {
    "poem_id": 88101,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت شاها انوشه بدی"
  },
  {
    "poem_id": 88101,
    "vorder": 4,
    "position": 1,
    "text": "همیشه ز تو دور دست بدی"
  },
  {
    "poem_id": 88101,
    "vorder": 5,
    "position": 0,
    "text": "منم ز این بزرگان فریدون نژاد"
  },
  {
    "poem_id": 88101,
    "vorder": 6,
    "position": 1,
    "text": "ز نام آوران تا بیامد قباد"
  },
  {
    "poem_id": 88101,
    "vorder": 7,
    "position": 0,
    "text": "کمر بسته‌ام پیش ایرانیان"
  },
  {
    "poem_id": 88101,
    "vorder": 8,
    "position": 1,
    "text": "که نگشادم از بند هرگز میان"
  },
  {
    "poem_id": 88101,
    "vorder": 9,
    "position": 0,
    "text": "به کوه هماون ز جوشن تنم"
  },
  {
    "poem_id": 88101,
    "vorder": 10,
    "position": 1,
    "text": "بخست و همان بود پیراهنم"
  },
  {
    "poem_id": 88101,
    "vorder": 11,
    "position": 0,
    "text": "به کین سیاوش بر آن رزمگاه"
  },
  {
    "poem_id": 88101,
    "vorder": 12,
    "position": 1,
    "text": "بدم هر شبی پاسبان سپاه"
  },
  {
    "poem_id": 88101,
    "vorder": 13,
    "position": 0,
    "text": "به لاون سپه را نکردم رها"
  },
  {
    "poem_id": 88101,
    "vorder": 14,
    "position": 1,
    "text": "همی بودم اندر دم اژدها"
  },
  {
    "poem_id": 88101,
    "vorder": 15,
    "position": 0,
    "text": "به مازندران بسته کاووس بود"
  },
  {
    "poem_id": 88101,
    "vorder": 16,
    "position": 1,
    "text": "دگر بند بر گردن طوس بود"
  },
  {
    "poem_id": 88101,
    "vorder": 17,
    "position": 0,
    "text": "نکردم سپه را به جایی یله"
  },
  {
    "poem_id": 88101,
    "vorder": 18,
    "position": 1,
    "text": "نه از من کسی کرد هرگز گله"
  },
  {
    "poem_id": 88101,
    "vorder": 19,
    "position": 0,
    "text": "کنون شاه سیر آمد از تاج و گنج"
  },
  {
    "poem_id": 88101,
    "vorder": 20,
    "position": 1,
    "text": "همی بگذرد ز این سرای سپنج"
  },
  {
    "poem_id": 88101,
    "vorder": 21,
    "position": 0,
    "text": "چه فرمایدم چیست نیروی من"
  },
  {
    "poem_id": 88101,
    "vorder": 22,
    "position": 1,
    "text": "تو دانی هنرها و آهوی من"
  },
  {
    "poem_id": 88101,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد پاسخ بدو شهریار"
  },
  {
    "poem_id": 88101,
    "vorder": 24,
    "position": 1,
    "text": "که بیش است رنج تو از روزگار"
  },
  {
    "poem_id": 88101,
    "vorder": 25,
    "position": 0,
    "text": "همی باش با کاویانی درفش"
  },
  {
    "poem_id": 88101,
    "vorder": 26,
    "position": 1,
    "text": "تو باشی سپهدار زرینه کفش"
  },
  {
    "poem_id": 88101,
    "vorder": 27,
    "position": 0,
    "text": "بدین مرز گیتی خراسان تراست"
  },
  {
    "poem_id": 88101,
    "vorder": 28,
    "position": 1,
    "text": "از این نامداران تن‌آسان تراست"
  },
  {
    "poem_id": 88101,
    "vorder": 29,
    "position": 0,
    "text": "نبشتند عهدی بر آن هم نشان"
  },
  {
    "poem_id": 88101,
    "vorder": 30,
    "position": 1,
    "text": "به پیش بزرگان گردنکشان"
  },
  {
    "poem_id": 88101,
    "vorder": 31,
    "position": 0,
    "text": "نهادند بر عهد بر مهر زر"
  },
  {
    "poem_id": 88101,
    "vorder": 32,
    "position": 1,
    "text": "یکی طوق زرین و زرین کمر"
  },
  {
    "poem_id": 88101,
    "vorder": 33,
    "position": 0,
    "text": "بدو داد و کردش بسی آفرین"
  },
  {
    "poem_id": 88101,
    "vorder": 34,
    "position": 1,
    "text": "که از تو مبادا دلی پر ز کین"
  }
]