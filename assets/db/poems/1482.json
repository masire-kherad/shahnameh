[
  {
    "poem_id": 1482,
    "vorder": 1,
    "position": 0,
    "text": "بسی برنیامد برین روزگار"
  },
  {
    "poem_id": 1482,
    "vorder": 2,
    "position": 1,
    "text": "که رنگ اندر آمد به خرم بهار"
  },
  {
    "poem_id": 1482,
    "vorder": 3,
    "position": 0,
    "text": "جدا گشت زو کودکی چون پری"
  },
  {
    "poem_id": 1482,
    "vorder": 4,
    "position": 1,
    "text": "به چهره بسان بت آزری"
  },
  {
    "poem_id": 1482,
    "vorder": 5,
    "position": 0,
    "text": "بگفتند با شاه کاووس کی"
  },
  {
    "poem_id": 1482,
    "vorder": 6,
    "position": 1,
    "text": "که برخوردی از ماه فرخنده‌پی"
  },
  {
    "poem_id": 1482,
    "vorder": 7,
    "position": 0,
    "text": "یکی بچهٔ فرخ آمد پدید"
  },
  {
    "poem_id": 1482,
    "vorder": 8,
    "position": 1,
    "text": "کنون تخت بر ابر باید کشید"
  },
  {
    "poem_id": 1482,
    "vorder": 9,
    "position": 0,
    "text": "جهان گشت ازان خوب پر گفت و گوی"
  },
  {
    "poem_id": 1482,
    "vorder": 10,
    "position": 1,
    "text": "کزان گونه نشنید کس موی و روی"
  },
  {
    "poem_id": 1482,
    "vorder": 11,
    "position": 0,
    "text": "جهاندار نامش سیاوخش کرد"
  },
  {
    "poem_id": 1482,
    "vorder": 12,
    "position": 1,
    "text": "برو چرخ گردنده را بخش کرد"
  },
  {
    "poem_id": 1482,
    "vorder": 13,
    "position": 0,
    "text": "ازان کاو شمارد سپهر بلند"
  },
  {
    "poem_id": 1482,
    "vorder": 14,
    "position": 1,
    "text": "بدانست نیک و بد و چون و چند"
  },
  {
    "poem_id": 1482,
    "vorder": 15,
    "position": 0,
    "text": "ستاره بران بچه آشفته دید"
  },
  {
    "poem_id": 1482,
    "vorder": 16,
    "position": 1,
    "text": "غمی گشت چون بخت او خفته دید"
  },
  {
    "poem_id": 1482,
    "vorder": 17,
    "position": 0,
    "text": "بدید از بد و نیک آزار او"
  },
  {
    "poem_id": 1482,
    "vorder": 18,
    "position": 1,
    "text": "به یزدان پناهید از کار او"
  },
  {
    "poem_id": 1482,
    "vorder": 19,
    "position": 0,
    "text": "چنین تا برآمد برین روزگار"
  },
  {
    "poem_id": 1482,
    "vorder": 20,
    "position": 1,
    "text": "تهمتن بیامد بر شهریار"
  },
  {
    "poem_id": 1482,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت کاین کودک شیرفش"
  },
  {
    "poem_id": 1482,
    "vorder": 22,
    "position": 1,
    "text": "مرا پرورانید باید به کش"
  },
  {
    "poem_id": 1482,
    "vorder": 23,
    "position": 0,
    "text": "چو دارندگان ترا مایه نیست"
  },
  {
    "poem_id": 1482,
    "vorder": 24,
    "position": 1,
    "text": "مر او را بگیتی چو من دایه نیست"
  },
  {
    "poem_id": 1482,
    "vorder": 25,
    "position": 0,
    "text": "بسی مهتر اندیشه کرد اندر آن"
  },
  {
    "poem_id": 1482,
    "vorder": 26,
    "position": 1,
    "text": "نیمد همی بر دلش بر گران"
  },
  {
    "poem_id": 1482,
    "vorder": 27,
    "position": 0,
    "text": "به رستم سپردش دل و دیده را"
  },
  {
    "poem_id": 1482,
    "vorder": 28,
    "position": 1,
    "text": "جهانجوی گرد پسندیده را"
  },
  {
    "poem_id": 1482,
    "vorder": 29,
    "position": 0,
    "text": "تهمتن ببردش به زابلستان"
  },
  {
    "poem_id": 1482,
    "vorder": 30,
    "position": 1,
    "text": "نشستن‌گهش ساخت در گلستان"
  },
  {
    "poem_id": 1482,
    "vorder": 31,
    "position": 0,
    "text": "سواری و تیر و کمان و کمند"
  },
  {
    "poem_id": 1482,
    "vorder": 32,
    "position": 1,
    "text": "عنان و رکیب و چه و چون و چند"
  },
  {
    "poem_id": 1482,
    "vorder": 33,
    "position": 0,
    "text": "نشستن‌گه مجلس و میگسار"
  },
  {
    "poem_id": 1482,
    "vorder": 34,
    "position": 1,
    "text": "همان باز و شاهین و کار شکار"
  },
  {
    "poem_id": 1482,
    "vorder": 35,
    "position": 0,
    "text": "ز داد و ز بیداد و تخت و کلاه"
  },
  {
    "poem_id": 1482,
    "vorder": 36,
    "position": 1,
    "text": "سخن گفتن رزم و راندن سپاه"
  },
  {
    "poem_id": 1482,
    "vorder": 37,
    "position": 0,
    "text": "هنرها بیاموختش سر به سر"
  },
  {
    "poem_id": 1482,
    "vorder": 38,
    "position": 1,
    "text": "بسی رنج برداشت و آمد به بر"
  },
  {
    "poem_id": 1482,
    "vorder": 39,
    "position": 0,
    "text": "سیاوش چنان شد که اندر جهان"
  },
  {
    "poem_id": 1482,
    "vorder": 40,
    "position": 1,
    "text": "به مانند او کس نبود از مهان"
  },
  {
    "poem_id": 1482,
    "vorder": 41,
    "position": 0,
    "text": "چو یک چند بگذشت و او شد بلند"
  },
  {
    "poem_id": 1482,
    "vorder": 42,
    "position": 1,
    "text": "سوی گردن شیر شد با کمند"
  },
  {
    "poem_id": 1482,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت با رستم سرفراز"
  },
  {
    "poem_id": 1482,
    "vorder": 44,
    "position": 1,
    "text": "که آمد به دیدار شاهم نیاز"
  },
  {
    "poem_id": 1482,
    "vorder": 45,
    "position": 0,
    "text": "بسی رنج بردی و دل سوختی"
  },
  {
    "poem_id": 1482,
    "vorder": 46,
    "position": 1,
    "text": "هنرهای شاهانم آموختی"
  },
  {
    "poem_id": 1482,
    "vorder": 47,
    "position": 0,
    "text": "پدر باید اکنون که بیند ز من"
  },
  {
    "poem_id": 1482,
    "vorder": 48,
    "position": 1,
    "text": "هنرهای آموزش پیلتن"
  },
  {
    "poem_id": 1482,
    "vorder": 49,
    "position": 0,
    "text": "گو شیردل کار او را بساخت"
  },
  {
    "poem_id": 1482,
    "vorder": 50,
    "position": 1,
    "text": "فرستادگان را ز هر سو بتاخت"
  },
  {
    "poem_id": 1482,
    "vorder": 51,
    "position": 0,
    "text": "ز اسپ و پرستنده و سیم و زر"
  },
  {
    "poem_id": 1482,
    "vorder": 52,
    "position": 1,
    "text": "ز مهر و ز تخت و کلاه و کمر"
  },
  {
    "poem_id": 1482,
    "vorder": 53,
    "position": 0,
    "text": "ز پوشیدنی هم ز گستردنی"
  },
  {
    "poem_id": 1482,
    "vorder": 54,
    "position": 1,
    "text": "ز هر سو بیاورد آوردنی"
  },
  {
    "poem_id": 1482,
    "vorder": 55,
    "position": 0,
    "text": "ازین هر چه در گنج رستم نبود"
  },
  {
    "poem_id": 1482,
    "vorder": 56,
    "position": 1,
    "text": "ز گیتی فرستاد و آورد زود"
  },
  {
    "poem_id": 1482,
    "vorder": 57,
    "position": 0,
    "text": "گسی کرد ازان گونه او را به راه"
  },
  {
    "poem_id": 1482,
    "vorder": 58,
    "position": 1,
    "text": "که شد بر سیاوش نظاره سپاه"
  },
  {
    "poem_id": 1482,
    "vorder": 59,
    "position": 0,
    "text": "همی رفت با او تهمتن به هم"
  },
  {
    "poem_id": 1482,
    "vorder": 60,
    "position": 1,
    "text": "بدان تا نباشد سپهبد دژم"
  },
  {
    "poem_id": 1482,
    "vorder": 61,
    "position": 0,
    "text": "جهانی به آیین بیاراستند"
  },
  {
    "poem_id": 1482,
    "vorder": 62,
    "position": 1,
    "text": "چو خشنودی نامور خواستند"
  },
  {
    "poem_id": 1482,
    "vorder": 63,
    "position": 0,
    "text": "همه زر به عنبر برآمیختند"
  },
  {
    "poem_id": 1482,
    "vorder": 64,
    "position": 1,
    "text": "ز گنبد به سر بر همی ریختند"
  },
  {
    "poem_id": 1482,
    "vorder": 65,
    "position": 0,
    "text": "جهان گشته پر شادی و خواسته"
  },
  {
    "poem_id": 1482,
    "vorder": 66,
    "position": 1,
    "text": "در و بام هر برزن آراسته"
  },
  {
    "poem_id": 1482,
    "vorder": 67,
    "position": 0,
    "text": "به زیر پی تازی اسپان درم"
  },
  {
    "poem_id": 1482,
    "vorder": 68,
    "position": 1,
    "text": "به ایران نبودند یک تن دژم"
  },
  {
    "poem_id": 1482,
    "vorder": 69,
    "position": 0,
    "text": "همه یال اسپ از کران تا کران"
  },
  {
    "poem_id": 1482,
    "vorder": 70,
    "position": 1,
    "text": "براندوده مشک و می و زعفران"
  },
  {
    "poem_id": 1482,
    "vorder": 71,
    "position": 0,
    "text": "چو آمد به کاووس شاه آگهی"
  },
  {
    "poem_id": 1482,
    "vorder": 72,
    "position": 1,
    "text": "که آمد سیاووش با فرهی"
  },
  {
    "poem_id": 1482,
    "vorder": 73,
    "position": 0,
    "text": "بفرمود تا با سپه گیو و طوس"
  },
  {
    "poem_id": 1482,
    "vorder": 74,
    "position": 1,
    "text": "برفتند با نای رویین و کوس"
  },
  {
    "poem_id": 1482,
    "vorder": 75,
    "position": 0,
    "text": "همه نامداران شدند انجمن"
  },
  {
    "poem_id": 1482,
    "vorder": 76,
    "position": 1,
    "text": "چو گرگین و خراد لشکرشکن"
  },
  {
    "poem_id": 1482,
    "vorder": 77,
    "position": 0,
    "text": "پذیره برفتند یکسر ز جای"
  },
  {
    "poem_id": 1482,
    "vorder": 78,
    "position": 1,
    "text": "به نزد سیاووش فرخنده رای"
  },
  {
    "poem_id": 1482,
    "vorder": 79,
    "position": 0,
    "text": "چو دیدند گردان گو پور شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 80,
    "position": 1,
    "text": "خروش آمد و برگشادند راه"
  },
  {
    "poem_id": 1482,
    "vorder": 81,
    "position": 0,
    "text": "پرستار با مجمر و بوی خوش"
  },
  {
    "poem_id": 1482,
    "vorder": 82,
    "position": 1,
    "text": "نظاره برو دست کرده به کش"
  },
  {
    "poem_id": 1482,
    "vorder": 83,
    "position": 0,
    "text": "بهر کنج در سیصد استاده بود"
  },
  {
    "poem_id": 1482,
    "vorder": 84,
    "position": 1,
    "text": "میان در سیاووش آزاده بود"
  },
  {
    "poem_id": 1482,
    "vorder": 85,
    "position": 0,
    "text": "بسی زر و گوهر برافشاندند"
  },
  {
    "poem_id": 1482,
    "vorder": 86,
    "position": 1,
    "text": "سراسر همه آفرین خواندند"
  },
  {
    "poem_id": 1482,
    "vorder": 87,
    "position": 0,
    "text": "چو کاووس را دید بر تخت عاج"
  },
  {
    "poem_id": 1482,
    "vorder": 88,
    "position": 1,
    "text": "ز یاقوت رخشنده بر سرش تاج"
  },
  {
    "poem_id": 1482,
    "vorder": 89,
    "position": 0,
    "text": "نخست آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1482,
    "vorder": 90,
    "position": 1,
    "text": "زمانی همی گفت با خاک راز"
  },
  {
    "poem_id": 1482,
    "vorder": 91,
    "position": 0,
    "text": "وزان پس بیامد بر شهریار"
  },
  {
    "poem_id": 1482,
    "vorder": 92,
    "position": 1,
    "text": "سپهبد گرفتش سر اندر کنار"
  },
  {
    "poem_id": 1482,
    "vorder": 93,
    "position": 0,
    "text": "شگفتی ز دیدار او خیره ماند"
  },
  {
    "poem_id": 1482,
    "vorder": 94,
    "position": 1,
    "text": "بروبر همی نام یزدان بخواند"
  },
  {
    "poem_id": 1482,
    "vorder": 95,
    "position": 0,
    "text": "بدان اندکی سال و چندان خرد"
  },
  {
    "poem_id": 1482,
    "vorder": 96,
    "position": 1,
    "text": "که گفتی روانش خرد پرورد"
  },
  {
    "poem_id": 1482,
    "vorder": 97,
    "position": 0,
    "text": "بسی آفرین بر جهان آفرین"
  },
  {
    "poem_id": 1482,
    "vorder": 98,
    "position": 1,
    "text": "بخواند و بمالید رخ بر زمین"
  },
  {
    "poem_id": 1482,
    "vorder": 99,
    "position": 0,
    "text": "همی گفت کای کردگار سپهر"
  },
  {
    "poem_id": 1482,
    "vorder": 100,
    "position": 1,
    "text": "خداوند هوش و خداوند مهر"
  },
  {
    "poem_id": 1482,
    "vorder": 101,
    "position": 0,
    "text": "همه نیکویها به گیتی ز تست"
  },
  {
    "poem_id": 1482,
    "vorder": 102,
    "position": 1,
    "text": "نیایش ز فرزند گیرم نخست"
  },
  {
    "poem_id": 1482,
    "vorder": 103,
    "position": 0,
    "text": "ز رستم بپرسید و بنواختش"
  },
  {
    "poem_id": 1482,
    "vorder": 104,
    "position": 1,
    "text": "بران تخت پیروزه بنشاختش"
  },
  {
    "poem_id": 1482,
    "vorder": 105,
    "position": 0,
    "text": "بزرگان ایران همه با نثار"
  },
  {
    "poem_id": 1482,
    "vorder": 106,
    "position": 1,
    "text": "برفتند شادان بر شهریار"
  },
  {
    "poem_id": 1482,
    "vorder": 107,
    "position": 0,
    "text": "ز فر سیاوش فرو ماندند"
  },
  {
    "poem_id": 1482,
    "vorder": 108,
    "position": 1,
    "text": "بدادار برآفرین خواندند"
  },
  {
    "poem_id": 1482,
    "vorder": 109,
    "position": 0,
    "text": "بفرمود تا پیشش ایرانیان"
  },
  {
    "poem_id": 1482,
    "vorder": 110,
    "position": 1,
    "text": "ببستند گردان لشکر میان"
  },
  {
    "poem_id": 1482,
    "vorder": 111,
    "position": 0,
    "text": "به کاخ و به باغ و به میدان اوی"
  },
  {
    "poem_id": 1482,
    "vorder": 112,
    "position": 1,
    "text": "جهانی به شادی نهادند روی"
  },
  {
    "poem_id": 1482,
    "vorder": 113,
    "position": 0,
    "text": "به هر جای جشنی بیاراستند"
  },
  {
    "poem_id": 1482,
    "vorder": 114,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1482,
    "vorder": 115,
    "position": 0,
    "text": "یکی سور فرمود کاندر جهان"
  },
  {
    "poem_id": 1482,
    "vorder": 116,
    "position": 1,
    "text": "کسی پیش از وی نکرد از مهان"
  },
  {
    "poem_id": 1482,
    "vorder": 117,
    "position": 0,
    "text": "به یک هفته زان گونه بودند شاد"
  },
  {
    "poem_id": 1482,
    "vorder": 118,
    "position": 1,
    "text": "به هشتم در گنجها برگشاد"
  },
  {
    "poem_id": 1482,
    "vorder": 119,
    "position": 0,
    "text": "ز هر چیز گنجی بفرمود شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 120,
    "position": 1,
    "text": "ز مهر و ز تیع و ز تخت و کلاه"
  },
  {
    "poem_id": 1482,
    "vorder": 121,
    "position": 0,
    "text": "از اسپان تازی به زین پلنگ"
  },
  {
    "poem_id": 1482,
    "vorder": 122,
    "position": 1,
    "text": "ز برگستوان و ز خفتان جنگ"
  },
  {
    "poem_id": 1482,
    "vorder": 123,
    "position": 0,
    "text": "ز دینار و از بدره‌های درم"
  },
  {
    "poem_id": 1482,
    "vorder": 124,
    "position": 1,
    "text": "ز دیبای و از گوهر بیش و کم"
  },
  {
    "poem_id": 1482,
    "vorder": 125,
    "position": 0,
    "text": "جز افسر که هنگام افسر نبود"
  },
  {
    "poem_id": 1482,
    "vorder": 126,
    "position": 1,
    "text": "بدان کودکی تاج در خور نبود"
  },
  {
    "poem_id": 1482,
    "vorder": 127,
    "position": 0,
    "text": "سیاووش را داد و کردش نوید"
  },
  {
    "poem_id": 1482,
    "vorder": 128,
    "position": 1,
    "text": "ز خوبی بدادش فراوان امید"
  },
  {
    "poem_id": 1482,
    "vorder": 129,
    "position": 0,
    "text": "چنین هفت سالش همی آزمود"
  },
  {
    "poem_id": 1482,
    "vorder": 130,
    "position": 1,
    "text": "به هر کار جز پاک زاده نبود"
  },
  {
    "poem_id": 1482,
    "vorder": 131,
    "position": 0,
    "text": "بهشتم بفرمود تا تاج زر"
  },
  {
    "poem_id": 1482,
    "vorder": 132,
    "position": 1,
    "text": "ز گوهر درافشان کلاه و کمر"
  },
  {
    "poem_id": 1482,
    "vorder": 133,
    "position": 0,
    "text": "نبشتند منشور بر پرنیان"
  },
  {
    "poem_id": 1482,
    "vorder": 134,
    "position": 1,
    "text": "به رسم بزرگان و فر کیان"
  },
  {
    "poem_id": 1482,
    "vorder": 135,
    "position": 0,
    "text": "زمین کهستان ورا داد شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 136,
    "position": 1,
    "text": "که بود او سزای بزرگی و گاه"
  },
  {
    "poem_id": 1482,
    "vorder": 137,
    "position": 0,
    "text": "چنین خواندندش همی پیشتر"
  },
  {
    "poem_id": 1482,
    "vorder": 138,
    "position": 1,
    "text": "که خوانی ورا ماوراء النهر بر"
  },
  {
    "poem_id": 1482,
    "vorder": 139,
    "position": 0,
    "text": "برآمد برین نیز یک روزگار"
  },
  {
    "poem_id": 1482,
    "vorder": 140,
    "position": 1,
    "text": "چنان بد که سودابهٔ پرنگار"
  },
  {
    "poem_id": 1482,
    "vorder": 141,
    "position": 0,
    "text": "ز ناگاه روی سیاوش بدید"
  },
  {
    "poem_id": 1482,
    "vorder": 142,
    "position": 1,
    "text": "پراندیشه گشت و دلش بردمید"
  },
  {
    "poem_id": 1482,
    "vorder": 143,
    "position": 0,
    "text": "چنان شد که گفتی طراز نخ است"
  },
  {
    "poem_id": 1482,
    "vorder": 144,
    "position": 1,
    "text": "وگر پیش آتش نهاده یخ است"
  },
  {
    "poem_id": 1482,
    "vorder": 145,
    "position": 0,
    "text": "کسی را فرستاد نزدیک اوی"
  },
  {
    "poem_id": 1482,
    "vorder": 146,
    "position": 1,
    "text": "که پنهان سیاووش را این بگوی"
  },
  {
    "poem_id": 1482,
    "vorder": 147,
    "position": 0,
    "text": "که اندر شبستان شاه جهان"
  },
  {
    "poem_id": 1482,
    "vorder": 148,
    "position": 1,
    "text": "نباشد شگفت ار شوی ناگهان"
  },
  {
    "poem_id": 1482,
    "vorder": 149,
    "position": 0,
    "text": "فرستاده رفت و بدادش پیام"
  },
  {
    "poem_id": 1482,
    "vorder": 150,
    "position": 1,
    "text": "برآشفت زان کار او نیکنام"
  },
  {
    "poem_id": 1482,
    "vorder": 151,
    "position": 0,
    "text": "بدو گفت مرد شبستان نیم"
  },
  {
    "poem_id": 1482,
    "vorder": 152,
    "position": 1,
    "text": "مجویم که بابند و دستان نیم"
  },
  {
    "poem_id": 1482,
    "vorder": 153,
    "position": 0,
    "text": "دگر روز شبگیر سودابه رفت"
  },
  {
    "poem_id": 1482,
    "vorder": 154,
    "position": 1,
    "text": "بر شاه ایران خرامید تفت"
  },
  {
    "poem_id": 1482,
    "vorder": 155,
    "position": 0,
    "text": "بدو گفت کای شهریار سپاه"
  },
  {
    "poem_id": 1482,
    "vorder": 156,
    "position": 1,
    "text": "که چون تو ندیدست خورشید و ماه"
  },
  {
    "poem_id": 1482,
    "vorder": 157,
    "position": 0,
    "text": "نه اندر زمین کس چو فرزند تو"
  },
  {
    "poem_id": 1482,
    "vorder": 158,
    "position": 1,
    "text": "جهان شاد بادا به پیوند تو"
  },
  {
    "poem_id": 1482,
    "vorder": 159,
    "position": 0,
    "text": "فرستش به سوی شبستان خویش"
  },
  {
    "poem_id": 1482,
    "vorder": 160,
    "position": 1,
    "text": "بر خواهران و فغستان خویش"
  },
  {
    "poem_id": 1482,
    "vorder": 161,
    "position": 0,
    "text": "همه روی پوشیدگان را ز مهر"
  },
  {
    "poem_id": 1482,
    "vorder": 162,
    "position": 1,
    "text": "پر ازخون دلست و پر از آب چهر"
  },
  {
    "poem_id": 1482,
    "vorder": 163,
    "position": 0,
    "text": "نمازش برند و نثار آورند"
  },
  {
    "poem_id": 1482,
    "vorder": 164,
    "position": 1,
    "text": "درخت پرستش به بار آورند"
  },
  {
    "poem_id": 1482,
    "vorder": 165,
    "position": 0,
    "text": "بدو گفت شاه این سخن در خورست"
  },
  {
    "poem_id": 1482,
    "vorder": 166,
    "position": 1,
    "text": "برو بر ترا مهر صد مادرست"
  },
  {
    "poem_id": 1482,
    "vorder": 167,
    "position": 0,
    "text": "سپهبد سیاووش را خواند و گفت"
  },
  {
    "poem_id": 1482,
    "vorder": 168,
    "position": 1,
    "text": "که خون و رگ و مهر نتوان نهفت"
  },
  {
    "poem_id": 1482,
    "vorder": 169,
    "position": 0,
    "text": "پس پردهٔ من ترا خواهرست"
  },
  {
    "poem_id": 1482,
    "vorder": 170,
    "position": 1,
    "text": "چو سودابه خود مهربان مادرست"
  },
  {
    "poem_id": 1482,
    "vorder": 171,
    "position": 0,
    "text": "ترا پاک یزدان چنان آفرید"
  },
  {
    "poem_id": 1482,
    "vorder": 172,
    "position": 1,
    "text": "که مهر آورد بر تو هرکت بدید"
  },
  {
    "poem_id": 1482,
    "vorder": 173,
    "position": 0,
    "text": "به ویژه که پیوستهٔ خون بود"
  },
  {
    "poem_id": 1482,
    "vorder": 174,
    "position": 1,
    "text": "چو از دور بیند ترا چون بود"
  },
  {
    "poem_id": 1482,
    "vorder": 175,
    "position": 0,
    "text": "پس پرده پوشیدگان را ببین"
  },
  {
    "poem_id": 1482,
    "vorder": 176,
    "position": 1,
    "text": "زمانی بمان تا کنند آفرین"
  },
  {
    "poem_id": 1482,
    "vorder": 177,
    "position": 0,
    "text": "سیاوش چو بشنید گفتار شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 178,
    "position": 1,
    "text": "همی کرد خیره بدو در نگاه"
  },
  {
    "poem_id": 1482,
    "vorder": 179,
    "position": 0,
    "text": "زمانی همی با دل اندیشه کرد"
  },
  {
    "poem_id": 1482,
    "vorder": 180,
    "position": 1,
    "text": "بکوشید تا دل بشوید ز گرد"
  },
  {
    "poem_id": 1482,
    "vorder": 181,
    "position": 0,
    "text": "گمانی چنان برد کاو را پدر"
  },
  {
    "poem_id": 1482,
    "vorder": 182,
    "position": 1,
    "text": "پژوهد همی تا چه دارد به سر"
  },
  {
    "poem_id": 1482,
    "vorder": 183,
    "position": 0,
    "text": "که بسیاردان است و چیره زبان"
  },
  {
    "poem_id": 1482,
    "vorder": 184,
    "position": 1,
    "text": "هشیوار و بینادل و بدگمان"
  },
  {
    "poem_id": 1482,
    "vorder": 185,
    "position": 0,
    "text": "بپیچید و بر خویشتن راز کرد"
  },
  {
    "poem_id": 1482,
    "vorder": 186,
    "position": 1,
    "text": "از انجام آهنگ آغاز کرد"
  },
  {
    "poem_id": 1482,
    "vorder": 187,
    "position": 0,
    "text": "که گر من شوم در شبستان اوی"
  },
  {
    "poem_id": 1482,
    "vorder": 188,
    "position": 1,
    "text": "ز سودابه یابم بسی گفت و گوی"
  },
  {
    "poem_id": 1482,
    "vorder": 189,
    "position": 0,
    "text": "سیاوش چنین داد پاسخ که شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 190,
    "position": 1,
    "text": "مرا داد فرمان و تخت و کلاه"
  },
  {
    "poem_id": 1482,
    "vorder": 191,
    "position": 0,
    "text": "کز آنجایگه کآفتاب بلند"
  },
  {
    "poem_id": 1482,
    "vorder": 192,
    "position": 1,
    "text": "برآید کند خاک را ارجمند"
  },
  {
    "poem_id": 1482,
    "vorder": 193,
    "position": 0,
    "text": "چو تو شاه ننهاد بر سر کلاه"
  },
  {
    "poem_id": 1482,
    "vorder": 194,
    "position": 1,
    "text": "به خوبی و دانش به آیین و راه"
  },
  {
    "poem_id": 1482,
    "vorder": 195,
    "position": 0,
    "text": "مرا موبدان ساز با بخردان"
  },
  {
    "poem_id": 1482,
    "vorder": 196,
    "position": 1,
    "text": "بزرگان و کارآزموده ردان"
  },
  {
    "poem_id": 1482,
    "vorder": 197,
    "position": 0,
    "text": "دگر نیزه و گرز و تیر و کمان"
  },
  {
    "poem_id": 1482,
    "vorder": 198,
    "position": 1,
    "text": "که چون پیچم اندر صف بدگمان"
  },
  {
    "poem_id": 1482,
    "vorder": 199,
    "position": 0,
    "text": "دگرگاه شاهان و آیین بار"
  },
  {
    "poem_id": 1482,
    "vorder": 200,
    "position": 1,
    "text": "دگر بزم و رزم و می و میگسار"
  },
  {
    "poem_id": 1482,
    "vorder": 201,
    "position": 0,
    "text": "چه آموزم اندر شبستان شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 202,
    "position": 1,
    "text": "بدانش زنان کی نمایند راه"
  },
  {
    "poem_id": 1482,
    "vorder": 203,
    "position": 0,
    "text": "گر ایدونک فرمان شاه این بود"
  },
  {
    "poem_id": 1482,
    "vorder": 204,
    "position": 1,
    "text": "ورا پیش من رفتن آیین بود"
  },
  {
    "poem_id": 1482,
    "vorder": 205,
    "position": 0,
    "text": "بدو گفت شاه ای پسر شاد باش"
  },
  {
    "poem_id": 1482,
    "vorder": 206,
    "position": 1,
    "text": "همیشه خرد را تو بنیاد باش"
  },
  {
    "poem_id": 1482,
    "vorder": 207,
    "position": 0,
    "text": "سخن کم شنیدم بدین نیکوی"
  },
  {
    "poem_id": 1482,
    "vorder": 208,
    "position": 1,
    "text": "فزاید همی مغز کاین بشنوی"
  },
  {
    "poem_id": 1482,
    "vorder": 209,
    "position": 0,
    "text": "مدار ایچ اندیشهٔ بد به دل"
  },
  {
    "poem_id": 1482,
    "vorder": 210,
    "position": 1,
    "text": "همه شادی آرای و غم برگسل"
  },
  {
    "poem_id": 1482,
    "vorder": 211,
    "position": 0,
    "text": "ببین پردگی کودکان را یکی"
  },
  {
    "poem_id": 1482,
    "vorder": 212,
    "position": 1,
    "text": "مگر شادمانه شوند اندکی"
  },
  {
    "poem_id": 1482,
    "vorder": 213,
    "position": 0,
    "text": "پس پرده اندر ترا خواهرست"
  },
  {
    "poem_id": 1482,
    "vorder": 214,
    "position": 1,
    "text": "پر از مهر و سودابه چون مادرست"
  },
  {
    "poem_id": 1482,
    "vorder": 215,
    "position": 0,
    "text": "سیاوش چنین گفت کز بامداد"
  },
  {
    "poem_id": 1482,
    "vorder": 216,
    "position": 1,
    "text": "بیایم کنم هر چه او کرد یاد"
  },
  {
    "poem_id": 1482,
    "vorder": 217,
    "position": 0,
    "text": "یکی مرد بد نام او هیربد"
  },
  {
    "poem_id": 1482,
    "vorder": 218,
    "position": 1,
    "text": "زدوده دل و مغز و رایش ز بد"
  },
  {
    "poem_id": 1482,
    "vorder": 219,
    "position": 0,
    "text": "که بتخانه را هیچ نگذاشتی"
  },
  {
    "poem_id": 1482,
    "vorder": 220,
    "position": 1,
    "text": "کلید در پرده او داشتی"
  },
  {
    "poem_id": 1482,
    "vorder": 221,
    "position": 0,
    "text": "سپهدار ایران به فرزانه گفت"
  },
  {
    "poem_id": 1482,
    "vorder": 222,
    "position": 1,
    "text": "که چون برکشد تیغ هور از نهفت"
  },
  {
    "poem_id": 1482,
    "vorder": 223,
    "position": 0,
    "text": "به پیش سیاوش همی رو بهوش"
  },
  {
    "poem_id": 1482,
    "vorder": 224,
    "position": 1,
    "text": "نگر تا چه فرماید آن دار گوش"
  },
  {
    "poem_id": 1482,
    "vorder": 225,
    "position": 0,
    "text": "به سودابه فرمود تا پیش اوی"
  },
  {
    "poem_id": 1482,
    "vorder": 226,
    "position": 1,
    "text": "نثار آورد گوهر و مشک و بوی"
  },
  {
    "poem_id": 1482,
    "vorder": 227,
    "position": 0,
    "text": "پرستندگان نیز با خواهران"
  },
  {
    "poem_id": 1482,
    "vorder": 228,
    "position": 1,
    "text": "زبرجد فشانند بر زعفران"
  },
  {
    "poem_id": 1482,
    "vorder": 229,
    "position": 0,
    "text": "چو خورشید برزد سر از کوهسار"
  },
  {
    "poem_id": 1482,
    "vorder": 230,
    "position": 1,
    "text": "سیاوش برآمد بر شهریار"
  },
  {
    "poem_id": 1482,
    "vorder": 231,
    "position": 0,
    "text": "برو آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1482,
    "vorder": 232,
    "position": 1,
    "text": "سخن گفت با او سپهد به راز"
  },
  {
    "poem_id": 1482,
    "vorder": 233,
    "position": 0,
    "text": "چو پردخته شد هیربد را بخواند"
  },
  {
    "poem_id": 1482,
    "vorder": 234,
    "position": 1,
    "text": "سخنهای شایسته چندی براند"
  },
  {
    "poem_id": 1482,
    "vorder": 235,
    "position": 0,
    "text": "سیاووش را گفت با او برو"
  },
  {
    "poem_id": 1482,
    "vorder": 236,
    "position": 1,
    "text": "بیارای دل را به دیدار نو"
  },
  {
    "poem_id": 1482,
    "vorder": 237,
    "position": 0,
    "text": "برفتند هر دو به یک جا به هم"
  },
  {
    "poem_id": 1482,
    "vorder": 238,
    "position": 1,
    "text": "روان شادمان و تهی دل ز غم"
  },
  {
    "poem_id": 1482,
    "vorder": 239,
    "position": 0,
    "text": "چو برداشت پرده ز در هیربد"
  },
  {
    "poem_id": 1482,
    "vorder": 240,
    "position": 1,
    "text": "سیاوش همی بود ترسان ز بد"
  },
  {
    "poem_id": 1482,
    "vorder": 241,
    "position": 0,
    "text": "شبستان همه پیشباز آمدند"
  },
  {
    "poem_id": 1482,
    "vorder": 242,
    "position": 1,
    "text": "پر از شادی و بزم ساز آمدند"
  },
  {
    "poem_id": 1482,
    "vorder": 243,
    "position": 0,
    "text": "همه جام بود از کران تا کران"
  },
  {
    "poem_id": 1482,
    "vorder": 244,
    "position": 1,
    "text": "پر از مشک و دینار و پر زعفران"
  },
  {
    "poem_id": 1482,
    "vorder": 245,
    "position": 0,
    "text": "درم زیر پایش همی ریختند"
  },
  {
    "poem_id": 1482,
    "vorder": 246,
    "position": 1,
    "text": "عقیق و زبرجد برآمیختند"
  },
  {
    "poem_id": 1482,
    "vorder": 247,
    "position": 0,
    "text": "زمین بود در زیر دیبای چین"
  },
  {
    "poem_id": 1482,
    "vorder": 248,
    "position": 1,
    "text": "پر از در خوشاب روی زمین"
  },
  {
    "poem_id": 1482,
    "vorder": 249,
    "position": 0,
    "text": "می و رود و آوای رامشگران"
  },
  {
    "poem_id": 1482,
    "vorder": 250,
    "position": 1,
    "text": "همه بر سران افسران گران"
  },
  {
    "poem_id": 1482,
    "vorder": 251,
    "position": 0,
    "text": "شبستان بهشتی شد آراسته"
  },
  {
    "poem_id": 1482,
    "vorder": 252,
    "position": 1,
    "text": "پر از خوبرویان و پرخواسته"
  },
  {
    "poem_id": 1482,
    "vorder": 253,
    "position": 0,
    "text": "سیاوش چو نزدیک ایوان رسید"
  },
  {
    "poem_id": 1482,
    "vorder": 254,
    "position": 1,
    "text": "یکی تخت زرین درفشنده دید"
  },
  {
    "poem_id": 1482,
    "vorder": 255,
    "position": 0,
    "text": "برو بر ز پیروزه کرده نگار"
  },
  {
    "poem_id": 1482,
    "vorder": 256,
    "position": 1,
    "text": "به دیبا بیاراسته شاهوار"
  },
  {
    "poem_id": 1482,
    "vorder": 257,
    "position": 0,
    "text": "بران تخت سودابه ماه روی"
  },
  {
    "poem_id": 1482,
    "vorder": 258,
    "position": 1,
    "text": "بسان بهشتی پر از رنگ و بوی"
  },
  {
    "poem_id": 1482,
    "vorder": 259,
    "position": 0,
    "text": "نشسته چو تابان سهیل یمن"
  },
  {
    "poem_id": 1482,
    "vorder": 260,
    "position": 1,
    "text": "سر جعد زلفش سراسر شکن"
  },
  {
    "poem_id": 1482,
    "vorder": 261,
    "position": 0,
    "text": "یکی تاج بر سر نهاده بلند"
  },
  {
    "poem_id": 1482,
    "vorder": 262,
    "position": 1,
    "text": "فرو هشته تا پای مشکین کمند"
  },
  {
    "poem_id": 1482,
    "vorder": 263,
    "position": 0,
    "text": "پرستار نعلین زرین بدست"
  },
  {
    "poem_id": 1482,
    "vorder": 264,
    "position": 1,
    "text": "به پای ایستاده سرافگنده پست"
  },
  {
    "poem_id": 1482,
    "vorder": 265,
    "position": 0,
    "text": "سیاوش چو از پیش پرده برفت"
  },
  {
    "poem_id": 1482,
    "vorder": 266,
    "position": 1,
    "text": "فرود آمد از تخت سودابه تفت"
  },
  {
    "poem_id": 1482,
    "vorder": 267,
    "position": 0,
    "text": "بیامد خرامان و بردش نماز"
  },
  {
    "poem_id": 1482,
    "vorder": 268,
    "position": 1,
    "text": "به بر در گرفتش زمانی دراز"
  },
  {
    "poem_id": 1482,
    "vorder": 269,
    "position": 0,
    "text": "همی چشم و رویش ببوسید دیر"
  },
  {
    "poem_id": 1482,
    "vorder": 270,
    "position": 1,
    "text": "نیامد ز دیدار آن شاه سیر"
  },
  {
    "poem_id": 1482,
    "vorder": 271,
    "position": 0,
    "text": "همی گفت صد ره ز یزدان سپاس"
  },
  {
    "poem_id": 1482,
    "vorder": 272,
    "position": 1,
    "text": "نیایش کنم روز و شب بر سه پاس"
  },
  {
    "poem_id": 1482,
    "vorder": 273,
    "position": 0,
    "text": "که کس را بسان تو فرزند نیست"
  },
  {
    "poem_id": 1482,
    "vorder": 274,
    "position": 1,
    "text": "همان شاه را نیز پیوند نیست"
  },
  {
    "poem_id": 1482,
    "vorder": 275,
    "position": 0,
    "text": "سیاوش بدانست کان مهر چیست"
  },
  {
    "poem_id": 1482,
    "vorder": 276,
    "position": 1,
    "text": "چنان دوستی نز ره ایزدیست"
  },
  {
    "poem_id": 1482,
    "vorder": 277,
    "position": 0,
    "text": "به نزدیک خواهر خرامید زود"
  },
  {
    "poem_id": 1482,
    "vorder": 278,
    "position": 1,
    "text": "که آن جایگه کار ناساز بود"
  },
  {
    "poem_id": 1482,
    "vorder": 279,
    "position": 0,
    "text": "برو خواهران آفرین خواندند"
  },
  {
    "poem_id": 1482,
    "vorder": 280,
    "position": 1,
    "text": "به کرسی زرینش بنشاندند"
  },
  {
    "poem_id": 1482,
    "vorder": 281,
    "position": 0,
    "text": "بر خواهران بد زمانی دراز"
  },
  {
    "poem_id": 1482,
    "vorder": 282,
    "position": 1,
    "text": "خرامان بیامد سوی تخت باز"
  },
  {
    "poem_id": 1482,
    "vorder": 283,
    "position": 0,
    "text": "شبستان همه شد پر از گفت‌وگوی"
  },
  {
    "poem_id": 1482,
    "vorder": 284,
    "position": 1,
    "text": "که اینت سر و تاج فرهنگ جوی"
  },
  {
    "poem_id": 1482,
    "vorder": 285,
    "position": 0,
    "text": "تو گویی به مردم نماند همی"
  },
  {
    "poem_id": 1482,
    "vorder": 286,
    "position": 1,
    "text": "روانش خرد برفشاند همی"
  },
  {
    "poem_id": 1482,
    "vorder": 287,
    "position": 0,
    "text": "سیاوش به پیش پدر شد بگفت"
  },
  {
    "poem_id": 1482,
    "vorder": 288,
    "position": 1,
    "text": "که دیدم به پرده‌سرای نهفت"
  },
  {
    "poem_id": 1482,
    "vorder": 289,
    "position": 0,
    "text": "همه نیکویی در جهان بهر تست"
  },
  {
    "poem_id": 1482,
    "vorder": 290,
    "position": 1,
    "text": "ز یزدان بهانه نبایدت جست"
  },
  {
    "poem_id": 1482,
    "vorder": 291,
    "position": 0,
    "text": "ز جم و فریدون و هوشنگ شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 292,
    "position": 1,
    "text": "فزونی به گنج و به شمشیر و گاه"
  },
  {
    "poem_id": 1482,
    "vorder": 293,
    "position": 0,
    "text": "ز گفتار او شاد شد شهریار"
  },
  {
    "poem_id": 1482,
    "vorder": 294,
    "position": 1,
    "text": "بیاراست ایوان چو خرم بهار"
  },
  {
    "poem_id": 1482,
    "vorder": 295,
    "position": 0,
    "text": "می و بربط و نای برساختند"
  },
  {
    "poem_id": 1482,
    "vorder": 296,
    "position": 1,
    "text": "دل از بودنیها بپرداختند"
  },
  {
    "poem_id": 1482,
    "vorder": 297,
    "position": 0,
    "text": "چو شب گشت پیدا و شد روز تار"
  },
  {
    "poem_id": 1482,
    "vorder": 298,
    "position": 1,
    "text": "شد اندر شبستان شه نامدار"
  },
  {
    "poem_id": 1482,
    "vorder": 299,
    "position": 0,
    "text": "پژوهنده سودابه را شاه گفت"
  },
  {
    "poem_id": 1482,
    "vorder": 300,
    "position": 1,
    "text": "که این رازت از من نباید نهفت"
  },
  {
    "poem_id": 1482,
    "vorder": 301,
    "position": 0,
    "text": "ز فرهنگ و رای سیاوش بگوی"
  },
  {
    "poem_id": 1482,
    "vorder": 302,
    "position": 1,
    "text": "ز بالا و دیدار و گفتار اوی"
  },
  {
    "poem_id": 1482,
    "vorder": 303,
    "position": 0,
    "text": "پسند تو آمد خردمند هست"
  },
  {
    "poem_id": 1482,
    "vorder": 304,
    "position": 1,
    "text": "از آواز به گر ز دیدن بهست"
  },
  {
    "poem_id": 1482,
    "vorder": 305,
    "position": 0,
    "text": "بدو گفت سودابه همتای شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 306,
    "position": 1,
    "text": "ندیدست بر گاه خورشید و ماه"
  },
  {
    "poem_id": 1482,
    "vorder": 307,
    "position": 0,
    "text": "چو فرزند تو کیست اندر جهان"
  },
  {
    "poem_id": 1482,
    "vorder": 308,
    "position": 1,
    "text": "چرا گفت باید سخن در نهان"
  },
  {
    "poem_id": 1482,
    "vorder": 309,
    "position": 0,
    "text": "بدو گفت شاه ار به مردی رسد"
  },
  {
    "poem_id": 1482,
    "vorder": 310,
    "position": 1,
    "text": "نباید که بیند ورا چشم بد"
  },
  {
    "poem_id": 1482,
    "vorder": 311,
    "position": 0,
    "text": "بدو گفت سودابه گر گفت من"
  },
  {
    "poem_id": 1482,
    "vorder": 312,
    "position": 1,
    "text": "پذیره شود رای را جفت من"
  },
  {
    "poem_id": 1482,
    "vorder": 313,
    "position": 0,
    "text": "هم از تخم خویشش یکی زن دهم"
  },
  {
    "poem_id": 1482,
    "vorder": 314,
    "position": 1,
    "text": "نه از نامداران برزن دهم"
  },
  {
    "poem_id": 1482,
    "vorder": 315,
    "position": 0,
    "text": "که فرزند آرد ورا در جهان"
  },
  {
    "poem_id": 1482,
    "vorder": 316,
    "position": 1,
    "text": "به دیدار او در میان مهان"
  },
  {
    "poem_id": 1482,
    "vorder": 317,
    "position": 0,
    "text": "مرا دخترانند مانند تو"
  },
  {
    "poem_id": 1482,
    "vorder": 318,
    "position": 1,
    "text": "ز تخم تو و پاک پیوند تو"
  },
  {
    "poem_id": 1482,
    "vorder": 319,
    "position": 0,
    "text": "گر از تخم کی آرش و کی پشین"
  },
  {
    "poem_id": 1482,
    "vorder": 320,
    "position": 1,
    "text": "بخواهد به شادی کند آفرین"
  },
  {
    "poem_id": 1482,
    "vorder": 321,
    "position": 0,
    "text": "بدو گفت این خود بکام منست"
  },
  {
    "poem_id": 1482,
    "vorder": 322,
    "position": 1,
    "text": "بزرگی به فرجام نام منست"
  },
  {
    "poem_id": 1482,
    "vorder": 323,
    "position": 0,
    "text": "سیاوش به شبگیر شد نزد شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 324,
    "position": 1,
    "text": "همی آفرین خواند بر تاج و گاه"
  },
  {
    "poem_id": 1482,
    "vorder": 325,
    "position": 0,
    "text": "پدر با پسر راز گفتن گرفت"
  },
  {
    "poem_id": 1482,
    "vorder": 326,
    "position": 1,
    "text": "ز بیگانه مردم نهفتن گرفت"
  },
  {
    "poem_id": 1482,
    "vorder": 327,
    "position": 0,
    "text": "همی گفت کز کردگار جهان"
  },
  {
    "poem_id": 1482,
    "vorder": 328,
    "position": 1,
    "text": "یکی آرزو دارم اندر نهان"
  },
  {
    "poem_id": 1482,
    "vorder": 329,
    "position": 0,
    "text": "که ماند ز تو نام من یادگار"
  },
  {
    "poem_id": 1482,
    "vorder": 330,
    "position": 1,
    "text": "ز تخم تو آید یکی شهریار"
  },
  {
    "poem_id": 1482,
    "vorder": 331,
    "position": 0,
    "text": "چنان کز تو من گشته‌ام تازه روی"
  },
  {
    "poem_id": 1482,
    "vorder": 332,
    "position": 1,
    "text": "تو دل برگشایی به دیدار اوی"
  },
  {
    "poem_id": 1482,
    "vorder": 333,
    "position": 0,
    "text": "چنین یافتم اخترت را نشان"
  },
  {
    "poem_id": 1482,
    "vorder": 334,
    "position": 1,
    "text": "ز گفت ستاره شمر موبدان"
  },
  {
    "poem_id": 1482,
    "vorder": 335,
    "position": 0,
    "text": "که از پشت تو شهریاری بود"
  },
  {
    "poem_id": 1482,
    "vorder": 336,
    "position": 1,
    "text": "که اندر جهان یادگاری بود"
  },
  {
    "poem_id": 1482,
    "vorder": 337,
    "position": 0,
    "text": "کنون از بزرگان یکی برگزین"
  },
  {
    "poem_id": 1482,
    "vorder": 338,
    "position": 1,
    "text": "نگه کن پس پردهٔ کی پشین"
  },
  {
    "poem_id": 1482,
    "vorder": 339,
    "position": 0,
    "text": "به خان کی آرش همان نیز هست"
  },
  {
    "poem_id": 1482,
    "vorder": 340,
    "position": 1,
    "text": "ز هر سو بیارای و بپساو دست"
  },
  {
    "poem_id": 1482,
    "vorder": 341,
    "position": 0,
    "text": "بدو گفت من شاه را بنده‌ام"
  },
  {
    "poem_id": 1482,
    "vorder": 342,
    "position": 1,
    "text": "به فرمان و رایش سرافگنده‌ام"
  },
  {
    "poem_id": 1482,
    "vorder": 343,
    "position": 0,
    "text": "هرآن کس که او برگزیند رواست"
  },
  {
    "poem_id": 1482,
    "vorder": 344,
    "position": 1,
    "text": "جهاندار بربندگان پادشاست"
  },
  {
    "poem_id": 1482,
    "vorder": 345,
    "position": 0,
    "text": "نباید که سودابه این بشنود"
  },
  {
    "poem_id": 1482,
    "vorder": 346,
    "position": 1,
    "text": "دگرگونه گوید بدین نگرود"
  },
  {
    "poem_id": 1482,
    "vorder": 347,
    "position": 0,
    "text": "به سودابه زین‌گونه گفتار نیست"
  },
  {
    "poem_id": 1482,
    "vorder": 348,
    "position": 1,
    "text": "مرا در شبستان او کار نیست"
  },
  {
    "poem_id": 1482,
    "vorder": 349,
    "position": 0,
    "text": "ز گفت سیاوش بخندید شاه"
  },
  {
    "poem_id": 1482,
    "vorder": 350,
    "position": 1,
    "text": "نه آگاه بد ز آب در زیر کاه"
  },
  {
    "poem_id": 1482,
    "vorder": 351,
    "position": 0,
    "text": "گزین تو باید بدو گفت زن"
  },
  {
    "poem_id": 1482,
    "vorder": 352,
    "position": 1,
    "text": "ازو هیچ مندیش وز انجمن"
  },
  {
    "poem_id": 1482,
    "vorder": 353,
    "position": 0,
    "text": "که گفتار او مهربانی بود"
  },
  {
    "poem_id": 1482,
    "vorder": 354,
    "position": 1,
    "text": "به جان تو بر پاسبانی بود"
  },
  {
    "poem_id": 1482,
    "vorder": 355,
    "position": 0,
    "text": "سیاوش ز گفتار او شاد شد"
  },
  {
    "poem_id": 1482,
    "vorder": 356,
    "position": 1,
    "text": "نهانش ز اندیشه آزاد شد"
  },
  {
    "poem_id": 1482,
    "vorder": 357,
    "position": 0,
    "text": "به شاه جهان بر ستایش گرفت"
  },
  {
    "poem_id": 1482,
    "vorder": 358,
    "position": 1,
    "text": "نوان پیش تختش نیایش گرفت"
  },
  {
    "poem_id": 1482,
    "vorder": 359,
    "position": 0,
    "text": "نهانی ز سودابهٔ چاره‌گر"
  },
  {
    "poem_id": 1482,
    "vorder": 360,
    "position": 1,
    "text": "همی بود پیچان و خسته جگر"
  },
  {
    "poem_id": 1482,
    "vorder": 361,
    "position": 0,
    "text": "بدانست کان نیز گفتار اوست"
  },
  {
    "poem_id": 1482,
    "vorder": 362,
    "position": 1,
    "text": "همی زو بدرید بر تنش پوست"
  }
]