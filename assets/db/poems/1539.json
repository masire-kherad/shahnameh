[
  {
    "poem_id": 1539,
    "vorder": 1,
    "position": 0,
    "text": "بیامد سر سروران سپاه"
  },
  {
    "poem_id": 1539,
    "vorder": 2,
    "position": 1,
    "text": "پسر تهم جاماسپ دستور شاه"
  },
  {
    "poem_id": 1539,
    "vorder": 3,
    "position": 0,
    "text": "نبرده سواری گرامیش نام"
  },
  {
    "poem_id": 1539,
    "vorder": 4,
    "position": 1,
    "text": "به مانندهٔ پور دستان سام"
  },
  {
    "poem_id": 1539,
    "vorder": 5,
    "position": 0,
    "text": "یکی چرمه‌ای برنشسته سمند"
  },
  {
    "poem_id": 1539,
    "vorder": 6,
    "position": 1,
    "text": "یکی گام زن بارهٔ بی‌گزند"
  },
  {
    "poem_id": 1539,
    "vorder": 7,
    "position": 0,
    "text": "چمانندهٔ چرمهٔ نونده جوان"
  },
  {
    "poem_id": 1539,
    "vorder": 8,
    "position": 1,
    "text": "یکی کوه پاره ست گوی روان"
  },
  {
    "poem_id": 1539,
    "vorder": 9,
    "position": 0,
    "text": "به پیش صف چینیان ایستاد"
  },
  {
    "poem_id": 1539,
    "vorder": 10,
    "position": 1,
    "text": "خداوند بهزاد را کرد یاد"
  },
  {
    "poem_id": 1539,
    "vorder": 11,
    "position": 0,
    "text": "کدامست گفت از شما شیردل"
  },
  {
    "poem_id": 1539,
    "vorder": 12,
    "position": 1,
    "text": "که آید سوی نیزهٔ جان گسل"
  },
  {
    "poem_id": 1539,
    "vorder": 13,
    "position": 0,
    "text": "کجا باشد آن جادوی خویش کام"
  },
  {
    "poem_id": 1539,
    "vorder": 14,
    "position": 1,
    "text": "کجا خواست نام و هزارانش نام"
  },
  {
    "poem_id": 1539,
    "vorder": 15,
    "position": 0,
    "text": "برفت آن زمان پیش او نامخواست"
  },
  {
    "poem_id": 1539,
    "vorder": 16,
    "position": 1,
    "text": "تو گفتی که همچو ستونست راست"
  },
  {
    "poem_id": 1539,
    "vorder": 17,
    "position": 0,
    "text": "بگشتند هر دو سوار هژیر"
  },
  {
    "poem_id": 1539,
    "vorder": 18,
    "position": 1,
    "text": "به گرز و به نیزه به شمشیر و تیر"
  },
  {
    "poem_id": 1539,
    "vorder": 19,
    "position": 0,
    "text": "گرامی گوی بود با زور شیر"
  },
  {
    "poem_id": 1539,
    "vorder": 20,
    "position": 1,
    "text": "نتابید با او سوار دلیر"
  },
  {
    "poem_id": 1539,
    "vorder": 21,
    "position": 0,
    "text": "گرفت از گرامی نبرده گریغ"
  },
  {
    "poem_id": 1539,
    "vorder": 22,
    "position": 1,
    "text": "گرامی کفش بود برنده تیغ"
  },
  {
    "poem_id": 1539,
    "vorder": 23,
    "position": 0,
    "text": "گرامی خرامید با خشم تیز"
  },
  {
    "poem_id": 1539,
    "vorder": 24,
    "position": 1,
    "text": "دل از کینهٔ کشتگان پر ستیز"
  },
  {
    "poem_id": 1539,
    "vorder": 25,
    "position": 0,
    "text": "میان صف دشمن اندر فتاد"
  },
  {
    "poem_id": 1539,
    "vorder": 26,
    "position": 1,
    "text": "پس از دامن کوه برخاست باد"
  },
  {
    "poem_id": 1539,
    "vorder": 27,
    "position": 0,
    "text": "سپاه از دو رو بر هم آویختند"
  },
  {
    "poem_id": 1539,
    "vorder": 28,
    "position": 1,
    "text": "و گرد از دو لشکر برانگیختند"
  },
  {
    "poem_id": 1539,
    "vorder": 29,
    "position": 0,
    "text": "بدان شورش اندر میان سپاه"
  },
  {
    "poem_id": 1539,
    "vorder": 30,
    "position": 1,
    "text": "ازان زخم گردان و گرد سیاه"
  },
  {
    "poem_id": 1539,
    "vorder": 31,
    "position": 0,
    "text": "بیفتاد از دست ایرانیان"
  },
  {
    "poem_id": 1539,
    "vorder": 32,
    "position": 1,
    "text": "درفش فروزندهٔ کاویان"
  },
  {
    "poem_id": 1539,
    "vorder": 33,
    "position": 0,
    "text": "گرامی بدید آن درفش چو نیل"
  },
  {
    "poem_id": 1539,
    "vorder": 34,
    "position": 1,
    "text": "که افگنده بودند از پشت پیل"
  },
  {
    "poem_id": 1539,
    "vorder": 35,
    "position": 0,
    "text": "فرود آمد و بر گرفت آن ز خاک"
  },
  {
    "poem_id": 1539,
    "vorder": 36,
    "position": 1,
    "text": "بیفشاند از خاک و بسترد پاک"
  },
  {
    "poem_id": 1539,
    "vorder": 37,
    "position": 0,
    "text": "چو او را بدیدند گردان چین"
  },
  {
    "poem_id": 1539,
    "vorder": 38,
    "position": 1,
    "text": "که آن نیزهٔ نامدار گزین"
  },
  {
    "poem_id": 1539,
    "vorder": 39,
    "position": 0,
    "text": "ازان خاک برداشت ، بسترد و برد"
  },
  {
    "poem_id": 1539,
    "vorder": 40,
    "position": 1,
    "text": "به گردش گرفتند مردان گرد"
  },
  {
    "poem_id": 1539,
    "vorder": 41,
    "position": 0,
    "text": "ز هر سو به گردش همی تاختند"
  },
  {
    "poem_id": 1539,
    "vorder": 42,
    "position": 1,
    "text": "به شمشیر دستش بینداختند"
  },
  {
    "poem_id": 1539,
    "vorder": 43,
    "position": 0,
    "text": "درفش فریدون به دندان گرفت"
  },
  {
    "poem_id": 1539,
    "vorder": 44,
    "position": 1,
    "text": "همی زد به یک دست گرز ای شگفت"
  },
  {
    "poem_id": 1539,
    "vorder": 45,
    "position": 0,
    "text": "سرانجام کارش بکشتند زار"
  },
  {
    "poem_id": 1539,
    "vorder": 46,
    "position": 1,
    "text": "بران گرم خاکش فگندند خوار"
  },
  {
    "poem_id": 1539,
    "vorder": 47,
    "position": 0,
    "text": "دریغ آن نبرده سوار هژبر"
  },
  {
    "poem_id": 1539,
    "vorder": 48,
    "position": 1,
    "text": "که بازش ندید آن خردمند پیر"
  },
  {
    "poem_id": 1539,
    "vorder": 49,
    "position": 0,
    "text": "بیامد هم آنگاه بستور شیر"
  },
  {
    "poem_id": 1539,
    "vorder": 50,
    "position": 1,
    "text": "نبرده کیان زاده پور زریر"
  },
  {
    "poem_id": 1539,
    "vorder": 51,
    "position": 0,
    "text": "بکشت او ازان دشمنان بی‌شمار"
  },
  {
    "poem_id": 1539,
    "vorder": 52,
    "position": 1,
    "text": "که آویخت اندر بد روزگار"
  },
  {
    "poem_id": 1539,
    "vorder": 53,
    "position": 0,
    "text": "سرانجام برگشت پیروز و شاد"
  },
  {
    "poem_id": 1539,
    "vorder": 54,
    "position": 1,
    "text": "به پیش پدر باز شد و ایستاد"
  },
  {
    "poem_id": 1539,
    "vorder": 55,
    "position": 0,
    "text": "بیامد پس آن برگزیده سوار"
  },
  {
    "poem_id": 1539,
    "vorder": 56,
    "position": 1,
    "text": "پس شهریار جهان نیوزار"
  },
  {
    "poem_id": 1539,
    "vorder": 57,
    "position": 0,
    "text": "به زیر اندرون تیزرو شولکی"
  },
  {
    "poem_id": 1539,
    "vorder": 58,
    "position": 1,
    "text": "که نبود چنان از هزاران یکی"
  },
  {
    "poem_id": 1539,
    "vorder": 59,
    "position": 0,
    "text": "بیامد بران تیره آوردگاه"
  },
  {
    "poem_id": 1539,
    "vorder": 60,
    "position": 1,
    "text": "به آواز گفت ای گزیده سپاه"
  },
  {
    "poem_id": 1539,
    "vorder": 61,
    "position": 0,
    "text": "کدامست مرد از شما نامدار"
  },
  {
    "poem_id": 1539,
    "vorder": 62,
    "position": 1,
    "text": "جهاندیده و گرد و نیزه‌گزار"
  },
  {
    "poem_id": 1539,
    "vorder": 63,
    "position": 0,
    "text": "که پیش من آیند نیزه به دست"
  },
  {
    "poem_id": 1539,
    "vorder": 64,
    "position": 1,
    "text": "که امروز در پیش مرد آمدست"
  },
  {
    "poem_id": 1539,
    "vorder": 65,
    "position": 0,
    "text": "سواران چین پیش او تاختند"
  },
  {
    "poem_id": 1539,
    "vorder": 66,
    "position": 1,
    "text": "برافگندنش را همی ساختند"
  },
  {
    "poem_id": 1539,
    "vorder": 67,
    "position": 0,
    "text": "سوار جهانجوی مرد دلیر"
  },
  {
    "poem_id": 1539,
    "vorder": 68,
    "position": 1,
    "text": "چو پیل دژآگاه و چون نره شیر"
  },
  {
    "poem_id": 1539,
    "vorder": 69,
    "position": 0,
    "text": "همی گشت بر گرد مردان چین"
  },
  {
    "poem_id": 1539,
    "vorder": 70,
    "position": 1,
    "text": "تو گفتی همی بر نوردد زمین"
  },
  {
    "poem_id": 1539,
    "vorder": 71,
    "position": 0,
    "text": "بکشت از گوان جهان شست مرد"
  },
  {
    "poem_id": 1539,
    "vorder": 72,
    "position": 1,
    "text": "دران تاختنها به گرز نبرد"
  },
  {
    "poem_id": 1539,
    "vorder": 73,
    "position": 0,
    "text": "سرانجامش آمد یکی تیر چرخ"
  },
  {
    "poem_id": 1539,
    "vorder": 74,
    "position": 1,
    "text": "چنان آمده بودش از چرخ برخ"
  },
  {
    "poem_id": 1539,
    "vorder": 75,
    "position": 0,
    "text": "بیفتاد زان شولک خوب رنگ"
  },
  {
    "poem_id": 1539,
    "vorder": 76,
    "position": 1,
    "text": "بمرد و نرست اینت فرجام جنگ"
  },
  {
    "poem_id": 1539,
    "vorder": 77,
    "position": 0,
    "text": "دریغ آن سوار گرانمایه نیز"
  },
  {
    "poem_id": 1539,
    "vorder": 78,
    "position": 1,
    "text": "که افگنده شد رایگان بر نه چیز"
  },
  {
    "poem_id": 1539,
    "vorder": 79,
    "position": 0,
    "text": "که همچون پدر بود و همتای اوی"
  },
  {
    "poem_id": 1539,
    "vorder": 80,
    "position": 1,
    "text": "دریغ آن نکو روی و بالای اوی"
  },
  {
    "poem_id": 1539,
    "vorder": 81,
    "position": 0,
    "text": "چو کشته شد آن نامبرده سوار"
  },
  {
    "poem_id": 1539,
    "vorder": 82,
    "position": 1,
    "text": "ز گردان به گردش هزاران هزار"
  },
  {
    "poem_id": 1539,
    "vorder": 83,
    "position": 0,
    "text": "بهر گوشه‌ای بر هم آویختند"
  },
  {
    "poem_id": 1539,
    "vorder": 84,
    "position": 1,
    "text": "ز روی زمین گرد انگیختند"
  },
  {
    "poem_id": 1539,
    "vorder": 85,
    "position": 0,
    "text": "برآمد برین رزم کردن دو هفت"
  },
  {
    "poem_id": 1539,
    "vorder": 86,
    "position": 1,
    "text": "کزیشان سواری زمانی نخفت"
  },
  {
    "poem_id": 1539,
    "vorder": 87,
    "position": 0,
    "text": "زمینها پر از کشته و خسته شد"
  },
  {
    "poem_id": 1539,
    "vorder": 88,
    "position": 1,
    "text": "سراپرده‌ها نیز بربسته شد"
  },
  {
    "poem_id": 1539,
    "vorder": 89,
    "position": 0,
    "text": "در و دشتها شد همه لاله‌گون"
  },
  {
    "poem_id": 1539,
    "vorder": 90,
    "position": 1,
    "text": "به دشت و بیابان همی رفت خون"
  },
  {
    "poem_id": 1539,
    "vorder": 91,
    "position": 0,
    "text": "چنان بد ز بس کشته آن رزمگاه"
  },
  {
    "poem_id": 1539,
    "vorder": 92,
    "position": 1,
    "text": "که بد می‌توانست رفتن به راه"
  }
]