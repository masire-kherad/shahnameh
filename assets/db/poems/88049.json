[
  {
    "poem_id": 88049,
    "vorder": 1,
    "position": 0,
    "text": "برون تاخت هفتم ز گردان هجیر"
  },
  {
    "poem_id": 88049,
    "vorder": 2,
    "position": 1,
    "text": "یکی نامداری سواری هژیر"
  },
  {
    "poem_id": 88049,
    "vorder": 3,
    "position": 0,
    "text": "سپهرم ز خویشان افراسیاب"
  },
  {
    "poem_id": 88049,
    "vorder": 4,
    "position": 1,
    "text": "یکی نامور بود با جاه و آب"
  },
  {
    "poem_id": 88049,
    "vorder": 5,
    "position": 0,
    "text": "ابا پور گودرز رزم آزمود"
  },
  {
    "poem_id": 88049,
    "vorder": 6,
    "position": 1,
    "text": "که چون او به لشکر سواری نبود"
  },
  {
    "poem_id": 88049,
    "vorder": 7,
    "position": 0,
    "text": "برفتند هر دو به جای نبرد"
  },
  {
    "poem_id": 88049,
    "vorder": 8,
    "position": 1,
    "text": "برآمد ز آوردگه تیره گرد"
  },
  {
    "poem_id": 88049,
    "vorder": 9,
    "position": 0,
    "text": "به شمشیر هر دو برآویختند"
  },
  {
    "poem_id": 88049,
    "vorder": 10,
    "position": 1,
    "text": "همی زآهن آتش فروریختند"
  },
  {
    "poem_id": 88049,
    "vorder": 11,
    "position": 0,
    "text": "هجیر دلاور به کردار شیر"
  },
  {
    "poem_id": 88049,
    "vorder": 12,
    "position": 1,
    "text": "به روی سپهرم درآمد دلیر"
  },
  {
    "poem_id": 88049,
    "vorder": 13,
    "position": 0,
    "text": "به نام جهان‌آفرین کردگار"
  },
  {
    "poem_id": 88049,
    "vorder": 14,
    "position": 1,
    "text": "به بخت جهاندار با شهریار"
  },
  {
    "poem_id": 88049,
    "vorder": 15,
    "position": 0,
    "text": "یکی تیغ زد بر سر و ترگ اوی"
  },
  {
    "poem_id": 88049,
    "vorder": 16,
    "position": 1,
    "text": "که آمد هم اندر زمان مرگ اوی"
  },
  {
    "poem_id": 88049,
    "vorder": 17,
    "position": 0,
    "text": "درافتاد ز اسبش هم آنگه نگون"
  },
  {
    "poem_id": 88049,
    "vorder": 18,
    "position": 1,
    "text": "به زاری و خواری دهن پر ز خون"
  },
  {
    "poem_id": 88049,
    "vorder": 19,
    "position": 0,
    "text": "فرود آمد از باره فرخ هجیر"
  },
  {
    "poem_id": 88049,
    "vorder": 20,
    "position": 1,
    "text": "مر او را ببست از بر زین چو شیر"
  },
  {
    "poem_id": 88049,
    "vorder": 21,
    "position": 0,
    "text": "نشست از بر اسب و آن اسب اوی"
  },
  {
    "poem_id": 88049,
    "vorder": 22,
    "position": 1,
    "text": "گرفته عنان و درآورده روی"
  },
  {
    "poem_id": 88049,
    "vorder": 23,
    "position": 0,
    "text": "برآمد به بالا و کرد آفرین"
  },
  {
    "poem_id": 88049,
    "vorder": 24,
    "position": 1,
    "text": "بر آن اختر نیک و فرخ زمین"
  },
  {
    "poem_id": 88049,
    "vorder": 25,
    "position": 0,
    "text": "همی زور و بخت از جهاندار دید"
  },
  {
    "poem_id": 88049,
    "vorder": 26,
    "position": 1,
    "text": "وز آن گردش بخت بیدار دید"
  }
]