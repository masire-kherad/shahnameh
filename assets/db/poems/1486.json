[
  {
    "poem_id": 1486,
    "vorder": 1,
    "position": 0,
    "text": "بیاورد گرسیوز آن خواسته"
  },
  {
    "poem_id": 1486,
    "vorder": 2,
    "position": 1,
    "text": "که روی زمین زو شد آراسته"
  },
  {
    "poem_id": 1486,
    "vorder": 3,
    "position": 0,
    "text": "دمان تا لب رود جیحون رسید"
  },
  {
    "poem_id": 1486,
    "vorder": 4,
    "position": 1,
    "text": "ز گردان فرستاده‌ای برگزید"
  },
  {
    "poem_id": 1486,
    "vorder": 5,
    "position": 0,
    "text": "بدان تا رساند به شاه آگهی"
  },
  {
    "poem_id": 1486,
    "vorder": 6,
    "position": 1,
    "text": "که گرسیوز آمد بدان فرهی"
  },
  {
    "poem_id": 1486,
    "vorder": 7,
    "position": 0,
    "text": "به کشتی به یکروز بگذاشت آب"
  },
  {
    "poem_id": 1486,
    "vorder": 8,
    "position": 1,
    "text": "بیامد سوی بلخ دل پر شتاب"
  },
  {
    "poem_id": 1486,
    "vorder": 9,
    "position": 0,
    "text": "فرستاده آمد به درگاه شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 10,
    "position": 1,
    "text": "بگفتند گرسیوز آمد به راه"
  },
  {
    "poem_id": 1486,
    "vorder": 11,
    "position": 0,
    "text": "سیاوش گو پیلتن را بخواند"
  },
  {
    "poem_id": 1486,
    "vorder": 12,
    "position": 1,
    "text": "وزین داستان چند گونه براند"
  },
  {
    "poem_id": 1486,
    "vorder": 13,
    "position": 0,
    "text": "چو گرسیوز آمد به درگاه شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 14,
    "position": 1,
    "text": "بفرمود تا برگشادند راه"
  },
  {
    "poem_id": 1486,
    "vorder": 15,
    "position": 0,
    "text": "سیاووش ورا دید بر پای خاست"
  },
  {
    "poem_id": 1486,
    "vorder": 16,
    "position": 1,
    "text": "بخندید و بسیار پوزش بخواست"
  },
  {
    "poem_id": 1486,
    "vorder": 17,
    "position": 0,
    "text": "ببوسید گرسیوز از دور خاک"
  },
  {
    "poem_id": 1486,
    "vorder": 18,
    "position": 1,
    "text": "رخش پر ز شرم و دلش پر ز باک"
  },
  {
    "poem_id": 1486,
    "vorder": 19,
    "position": 0,
    "text": "سیاووش بنشاندش زیر تخت"
  },
  {
    "poem_id": 1486,
    "vorder": 20,
    "position": 1,
    "text": "از افراسیابش بپرسید سخت"
  },
  {
    "poem_id": 1486,
    "vorder": 21,
    "position": 0,
    "text": "چو بنشست گرسیوز از گاه نو"
  },
  {
    "poem_id": 1486,
    "vorder": 22,
    "position": 1,
    "text": "بدید آن سر وافسر شاه نو"
  },
  {
    "poem_id": 1486,
    "vorder": 23,
    "position": 0,
    "text": "به رستم چنین گفت کافراسیاب"
  },
  {
    "poem_id": 1486,
    "vorder": 24,
    "position": 1,
    "text": "چو از تو خبر یافت اندر شتاب"
  },
  {
    "poem_id": 1486,
    "vorder": 25,
    "position": 0,
    "text": "یکی یادگاری به نزدیک شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 26,
    "position": 1,
    "text": "فرستاد با من کنون در به راه"
  },
  {
    "poem_id": 1486,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود تا پرده برداشتند"
  },
  {
    "poem_id": 1486,
    "vorder": 28,
    "position": 1,
    "text": "به چشم سیاووش بگذاشتند"
  },
  {
    "poem_id": 1486,
    "vorder": 29,
    "position": 0,
    "text": "ز دروازهٔ شهر تا بارگاه"
  },
  {
    "poem_id": 1486,
    "vorder": 30,
    "position": 1,
    "text": "درم بود و اسپ و غلام و کلاه"
  },
  {
    "poem_id": 1486,
    "vorder": 31,
    "position": 0,
    "text": "کس اندازه نشناخت آنرا که چند"
  },
  {
    "poem_id": 1486,
    "vorder": 32,
    "position": 1,
    "text": "ز دینار وَز تاج و تخت بلند"
  },
  {
    "poem_id": 1486,
    "vorder": 33,
    "position": 0,
    "text": "غلامان همه با کلاه و کمر"
  },
  {
    "poem_id": 1486,
    "vorder": 34,
    "position": 1,
    "text": "پرستنده با یاره و طوق زر"
  },
  {
    "poem_id": 1486,
    "vorder": 35,
    "position": 0,
    "text": "پسند آمدش سخت بگشاد روی"
  },
  {
    "poem_id": 1486,
    "vorder": 36,
    "position": 1,
    "text": "نگه کرد و بشنید پیغام اوی"
  },
  {
    "poem_id": 1486,
    "vorder": 37,
    "position": 0,
    "text": "تهمتن بدو گفت یک هفته شاد"
  },
  {
    "poem_id": 1486,
    "vorder": 38,
    "position": 1,
    "text": "همی باش تا پاسخ آریم یاد"
  },
  {
    "poem_id": 1486,
    "vorder": 39,
    "position": 0,
    "text": "بدین خواهش اندیشه باید بسی"
  },
  {
    "poem_id": 1486,
    "vorder": 40,
    "position": 1,
    "text": "همان نیز پرسیدن از هر کسی"
  },
  {
    "poem_id": 1486,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید گرسیوز پیش بین"
  },
  {
    "poem_id": 1486,
    "vorder": 42,
    "position": 1,
    "text": "زمین را ببوسید و کرد آفرین"
  },
  {
    "poem_id": 1486,
    "vorder": 43,
    "position": 0,
    "text": "یکی خانه او را بیاراستند"
  },
  {
    "poem_id": 1486,
    "vorder": 44,
    "position": 1,
    "text": "به دیبا و خوالیگران خواستند"
  },
  {
    "poem_id": 1486,
    "vorder": 45,
    "position": 0,
    "text": "نشستند بیدار هر دو به هم"
  },
  {
    "poem_id": 1486,
    "vorder": 46,
    "position": 1,
    "text": "سگالش گرفتند بر بیش و کم"
  },
  {
    "poem_id": 1486,
    "vorder": 47,
    "position": 0,
    "text": "ازان کار شد پیلتن بدگمان"
  },
  {
    "poem_id": 1486,
    "vorder": 48,
    "position": 1,
    "text": "کزان گونه گرسیوز آمد دمان"
  },
  {
    "poem_id": 1486,
    "vorder": 49,
    "position": 0,
    "text": "طلایه ز هر سو برون تاختند"
  },
  {
    "poem_id": 1486,
    "vorder": 50,
    "position": 1,
    "text": "چنان چون ببایست برساختند"
  },
  {
    "poem_id": 1486,
    "vorder": 51,
    "position": 0,
    "text": "سیاوش ز رستم بپرسید و گفت"
  },
  {
    "poem_id": 1486,
    "vorder": 52,
    "position": 1,
    "text": "که این راز بیرون کنید از نهفت"
  },
  {
    "poem_id": 1486,
    "vorder": 53,
    "position": 0,
    "text": "که این آشتی جستن از بهر چیست"
  },
  {
    "poem_id": 1486,
    "vorder": 54,
    "position": 1,
    "text": "نگه کن که تریاک این زهر چیست"
  },
  {
    "poem_id": 1486,
    "vorder": 55,
    "position": 0,
    "text": "ز پیوستهٔ خون به نزدیک اوی"
  },
  {
    "poem_id": 1486,
    "vorder": 56,
    "position": 1,
    "text": "ببین تا کدامند صد نامجوی"
  },
  {
    "poem_id": 1486,
    "vorder": 57,
    "position": 0,
    "text": "گروگان فرستد به نزدیک ما"
  },
  {
    "poem_id": 1486,
    "vorder": 58,
    "position": 1,
    "text": "کند روشن این رای تاریک ما"
  },
  {
    "poem_id": 1486,
    "vorder": 59,
    "position": 0,
    "text": "نباید که از ما غمی شد ز بیم"
  },
  {
    "poem_id": 1486,
    "vorder": 60,
    "position": 1,
    "text": "همی طبل سازد به زیر گلیم"
  },
  {
    "poem_id": 1486,
    "vorder": 61,
    "position": 0,
    "text": "چو این کرده باشیم نزدیک شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 62,
    "position": 1,
    "text": "فرستاده باید یکی نیک‌خواه"
  },
  {
    "poem_id": 1486,
    "vorder": 63,
    "position": 0,
    "text": "برد زین سخن نزد او آگهی"
  },
  {
    "poem_id": 1486,
    "vorder": 64,
    "position": 1,
    "text": "مگر مغز گرداند از کین تهی"
  },
  {
    "poem_id": 1486,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت رستم که اینست رای"
  },
  {
    "poem_id": 1486,
    "vorder": 66,
    "position": 1,
    "text": "جزین روی پیمان نیاید بجای"
  },
  {
    "poem_id": 1486,
    "vorder": 67,
    "position": 0,
    "text": "به شبگیر گرسیوز آمد بدر"
  },
  {
    "poem_id": 1486,
    "vorder": 68,
    "position": 1,
    "text": "چنان چون بود با کلاه و کمر"
  },
  {
    "poem_id": 1486,
    "vorder": 69,
    "position": 0,
    "text": "بیامد به پیش سیاوش زمین"
  },
  {
    "poem_id": 1486,
    "vorder": 70,
    "position": 1,
    "text": "ببوسید و بر شاه کرد آفرین"
  },
  {
    "poem_id": 1486,
    "vorder": 71,
    "position": 0,
    "text": "سیاوش بدو گفت کز کار تو"
  },
  {
    "poem_id": 1486,
    "vorder": 72,
    "position": 1,
    "text": "پراندیشه بودم ز گفتار تو"
  },
  {
    "poem_id": 1486,
    "vorder": 73,
    "position": 0,
    "text": "کنون رای یکسر بران شد درست"
  },
  {
    "poem_id": 1486,
    "vorder": 74,
    "position": 1,
    "text": "که از کینه دل را بخواهیم شست"
  },
  {
    "poem_id": 1486,
    "vorder": 75,
    "position": 0,
    "text": "تو پاسخ فرستی به افراسیاب"
  },
  {
    "poem_id": 1486,
    "vorder": 76,
    "position": 1,
    "text": "که از کین اگر شد سرت پر شتاب"
  },
  {
    "poem_id": 1486,
    "vorder": 77,
    "position": 0,
    "text": "کسی کاو ببیند سرانجام بد"
  },
  {
    "poem_id": 1486,
    "vorder": 78,
    "position": 1,
    "text": "ز کردار بد بازگشتش سزد"
  },
  {
    "poem_id": 1486,
    "vorder": 79,
    "position": 0,
    "text": "دلی کز خرد گردد آراسته"
  },
  {
    "poem_id": 1486,
    "vorder": 80,
    "position": 1,
    "text": "یکی گنج گردد پر از خواسته"
  },
  {
    "poem_id": 1486,
    "vorder": 81,
    "position": 0,
    "text": "اگر زیر نوش اندرون زهر نیست"
  },
  {
    "poem_id": 1486,
    "vorder": 82,
    "position": 1,
    "text": "دلت را ز رنج و زیان بهر نیست"
  },
  {
    "poem_id": 1486,
    "vorder": 83,
    "position": 0,
    "text": "چو پیمان همی کرد خواهی درست"
  },
  {
    "poem_id": 1486,
    "vorder": 84,
    "position": 1,
    "text": "که آزار و کینه نخواهیم جست"
  },
  {
    "poem_id": 1486,
    "vorder": 85,
    "position": 0,
    "text": "ز گردان که رستم بداند همی"
  },
  {
    "poem_id": 1486,
    "vorder": 86,
    "position": 1,
    "text": "کجا نامشان بر تو خواند همی"
  },
  {
    "poem_id": 1486,
    "vorder": 87,
    "position": 0,
    "text": "بر من فرستی به رسم نوا"
  },
  {
    "poem_id": 1486,
    "vorder": 88,
    "position": 1,
    "text": "که باشد به گفتار تو بر گوا"
  },
  {
    "poem_id": 1486,
    "vorder": 89,
    "position": 0,
    "text": "و دیگر ز ایران زمین هرچ هست"
  },
  {
    "poem_id": 1486,
    "vorder": 90,
    "position": 1,
    "text": "که آن شهرها را تو داری به دست"
  },
  {
    "poem_id": 1486,
    "vorder": 91,
    "position": 0,
    "text": "بپردازی و خود به توران شوی"
  },
  {
    "poem_id": 1486,
    "vorder": 92,
    "position": 1,
    "text": "زمانی ز جنگ و ز کین بغنوی"
  },
  {
    "poem_id": 1486,
    "vorder": 93,
    "position": 0,
    "text": "نباشد جز از راستی در میان"
  },
  {
    "poem_id": 1486,
    "vorder": 94,
    "position": 1,
    "text": "به کینه نبندم کمر بر میان"
  },
  {
    "poem_id": 1486,
    "vorder": 95,
    "position": 0,
    "text": "فرستم یکی نامه نزدیک شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 96,
    "position": 1,
    "text": "مگر بشتی باز خواند سپاه"
  },
  {
    "poem_id": 1486,
    "vorder": 97,
    "position": 0,
    "text": "برافگند گرسیوز اندر زمان"
  },
  {
    "poem_id": 1486,
    "vorder": 98,
    "position": 1,
    "text": "فرستاده‌ای چون هژبر دمان"
  },
  {
    "poem_id": 1486,
    "vorder": 99,
    "position": 0,
    "text": "بدو گفت خیره منه سر به خواب"
  },
  {
    "poem_id": 1486,
    "vorder": 100,
    "position": 1,
    "text": "برو تازیان نزد افراسیاب"
  },
  {
    "poem_id": 1486,
    "vorder": 101,
    "position": 0,
    "text": "بگویش که من تیز بشتافتم"
  },
  {
    "poem_id": 1486,
    "vorder": 102,
    "position": 1,
    "text": "همی هرچ جستم همه یافتم"
  },
  {
    "poem_id": 1486,
    "vorder": 103,
    "position": 0,
    "text": "گروگان همی خواهد از شهریار"
  },
  {
    "poem_id": 1486,
    "vorder": 104,
    "position": 1,
    "text": "چو خواهی که برگردد از کارزار"
  },
  {
    "poem_id": 1486,
    "vorder": 105,
    "position": 0,
    "text": "فرستاده آمد بدادش پیام"
  },
  {
    "poem_id": 1486,
    "vorder": 106,
    "position": 1,
    "text": "ز شاه و ز گرسیوز نیک‌نام"
  },
  {
    "poem_id": 1486,
    "vorder": 107,
    "position": 0,
    "text": "چو گفت فرستاده بشنید شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 108,
    "position": 1,
    "text": "فراوان بپیچید و گم کرد راه"
  },
  {
    "poem_id": 1486,
    "vorder": 109,
    "position": 0,
    "text": "همی گفت صد تن ز خویشان من"
  },
  {
    "poem_id": 1486,
    "vorder": 110,
    "position": 1,
    "text": "گر ایدونک کم گردد از انجمن"
  },
  {
    "poem_id": 1486,
    "vorder": 111,
    "position": 0,
    "text": "شکست اندر آید بدین بارگاه"
  },
  {
    "poem_id": 1486,
    "vorder": 112,
    "position": 1,
    "text": "نماند بر من کسی نیک‌خواه"
  },
  {
    "poem_id": 1486,
    "vorder": 113,
    "position": 0,
    "text": "وگر گویم از من گروگان مجوی"
  },
  {
    "poem_id": 1486,
    "vorder": 114,
    "position": 1,
    "text": "دروغ آیدش سر به سر گفت و گوی"
  },
  {
    "poem_id": 1486,
    "vorder": 115,
    "position": 0,
    "text": "فرستاد باید بر او نوا"
  },
  {
    "poem_id": 1486,
    "vorder": 116,
    "position": 1,
    "text": "اگر بی گروگان ندارد روا"
  },
  {
    "poem_id": 1486,
    "vorder": 117,
    "position": 0,
    "text": "بران سان که رستم همی نام برد"
  },
  {
    "poem_id": 1486,
    "vorder": 118,
    "position": 1,
    "text": "ز خویشان نزدیک صد بر شمرد"
  },
  {
    "poem_id": 1486,
    "vorder": 119,
    "position": 0,
    "text": "بر شاه ایران فرستادشان"
  },
  {
    "poem_id": 1486,
    "vorder": 120,
    "position": 1,
    "text": "بسی خلعت و نیکوی دادشان"
  },
  {
    "poem_id": 1486,
    "vorder": 121,
    "position": 0,
    "text": "بفرمود تا کوس با کره‌نای"
  },
  {
    "poem_id": 1486,
    "vorder": 122,
    "position": 1,
    "text": "زدند و فروهشت پرده‌سرای"
  },
  {
    "poem_id": 1486,
    "vorder": 123,
    "position": 0,
    "text": "به خارا و سغد و سمرقند و چاچ"
  },
  {
    "poem_id": 1486,
    "vorder": 124,
    "position": 1,
    "text": "سپیجاب و آن کشور و تخت عاج"
  },
  {
    "poem_id": 1486,
    "vorder": 125,
    "position": 0,
    "text": "تهی کرد و شد با سپه سوی گنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 126,
    "position": 1,
    "text": "بهانه نجست و فریب و درنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 127,
    "position": 0,
    "text": "چو از رفتنش رستم آگاه شد"
  },
  {
    "poem_id": 1486,
    "vorder": 128,
    "position": 1,
    "text": "روانش ز اندیشه کوتاه شد"
  },
  {
    "poem_id": 1486,
    "vorder": 129,
    "position": 0,
    "text": "به نزد سیاوش بیامد چو گرد"
  },
  {
    "poem_id": 1486,
    "vorder": 130,
    "position": 1,
    "text": "شنیده سخنها همه یاد کرد"
  },
  {
    "poem_id": 1486,
    "vorder": 131,
    "position": 0,
    "text": "بدو گفت چون کارها گشت راست"
  },
  {
    "poem_id": 1486,
    "vorder": 132,
    "position": 1,
    "text": "چو گرسیوز ار بازگردد رواست"
  },
  {
    "poem_id": 1486,
    "vorder": 133,
    "position": 0,
    "text": "بفرمود تا خلعت آراستند"
  },
  {
    "poem_id": 1486,
    "vorder": 134,
    "position": 1,
    "text": "سلیح و کلاه و کمر خواستند"
  },
  {
    "poem_id": 1486,
    "vorder": 135,
    "position": 0,
    "text": "یکی اسپ تازی به زرین ستام"
  },
  {
    "poem_id": 1486,
    "vorder": 136,
    "position": 1,
    "text": "یکی تیغ هندی به زرین نیام"
  },
  {
    "poem_id": 1486,
    "vorder": 137,
    "position": 0,
    "text": "چو گرسیوز آن خلعت شاه دید"
  },
  {
    "poem_id": 1486,
    "vorder": 138,
    "position": 1,
    "text": "تو گفتی مگر بر زمین ماه دید"
  },
  {
    "poem_id": 1486,
    "vorder": 139,
    "position": 0,
    "text": "بشد با زبانی پر از آفرین"
  },
  {
    "poem_id": 1486,
    "vorder": 140,
    "position": 1,
    "text": "تو گفتی مگر بر نوردد زمین"
  },
  {
    "poem_id": 1486,
    "vorder": 141,
    "position": 0,
    "text": "سیاوش نشست از بر تخت عاج"
  },
  {
    "poem_id": 1486,
    "vorder": 142,
    "position": 1,
    "text": "بیاویخته بر سر عاج تاج"
  },
  {
    "poem_id": 1486,
    "vorder": 143,
    "position": 0,
    "text": "همی رای زد با یکی چرب‌گوی"
  },
  {
    "poem_id": 1486,
    "vorder": 144,
    "position": 1,
    "text": "کسی کاو سخن را دهد رنگ و بوی"
  },
  {
    "poem_id": 1486,
    "vorder": 145,
    "position": 0,
    "text": "ز لشکر همی جست گردی سوار"
  },
  {
    "poem_id": 1486,
    "vorder": 146,
    "position": 1,
    "text": "که با او بسازد دم شهریار"
  },
  {
    "poem_id": 1486,
    "vorder": 147,
    "position": 0,
    "text": "چنین گفت با او گو پیلتن"
  },
  {
    "poem_id": 1486,
    "vorder": 148,
    "position": 1,
    "text": "کزین در که یارد گشادن سخن"
  },
  {
    "poem_id": 1486,
    "vorder": 149,
    "position": 0,
    "text": "همانست کاووس کز پیش بود"
  },
  {
    "poem_id": 1486,
    "vorder": 150,
    "position": 1,
    "text": "ز تندی نکاهد نخواهد فزود"
  },
  {
    "poem_id": 1486,
    "vorder": 151,
    "position": 0,
    "text": "مگر من شوم نزد شاه جهان"
  },
  {
    "poem_id": 1486,
    "vorder": 152,
    "position": 1,
    "text": "کنم آشکارا برو بر نهان"
  },
  {
    "poem_id": 1486,
    "vorder": 153,
    "position": 0,
    "text": "ببرم زمین گر تو فرمان دهی"
  },
  {
    "poem_id": 1486,
    "vorder": 154,
    "position": 1,
    "text": "ز رفتن نبینم همی جز بهی"
  },
  {
    "poem_id": 1486,
    "vorder": 155,
    "position": 0,
    "text": "سیاوش ز گفتار او شاد شد"
  },
  {
    "poem_id": 1486,
    "vorder": 156,
    "position": 1,
    "text": "حدیث فرستادگان باد شد"
  },
  {
    "poem_id": 1486,
    "vorder": 157,
    "position": 0,
    "text": "سپهدار بنشست و رستم به هم"
  },
  {
    "poem_id": 1486,
    "vorder": 158,
    "position": 1,
    "text": "سخن راند هرگونه از بیش و کم"
  },
  {
    "poem_id": 1486,
    "vorder": 159,
    "position": 0,
    "text": "بفرمود تا رفت پیشش دبیر"
  },
  {
    "poem_id": 1486,
    "vorder": 160,
    "position": 1,
    "text": "نوشتن یکی نامه‌ای بر حریر"
  },
  {
    "poem_id": 1486,
    "vorder": 161,
    "position": 0,
    "text": "نخست آفرین کرد بر دادگر"
  },
  {
    "poem_id": 1486,
    "vorder": 162,
    "position": 1,
    "text": "کزو دید نیروی و فر و هنر"
  },
  {
    "poem_id": 1486,
    "vorder": 163,
    "position": 0,
    "text": "خداوند هوش و زمان و مکان"
  },
  {
    "poem_id": 1486,
    "vorder": 164,
    "position": 1,
    "text": "خرد پروراند همی با روان"
  },
  {
    "poem_id": 1486,
    "vorder": 165,
    "position": 0,
    "text": "گذر نیست کس را ز فرمان او"
  },
  {
    "poem_id": 1486,
    "vorder": 166,
    "position": 1,
    "text": "کسی کاو بگردد ز پیمان او"
  },
  {
    "poem_id": 1486,
    "vorder": 167,
    "position": 0,
    "text": "ز گیتی نبیند مگر کاستی"
  },
  {
    "poem_id": 1486,
    "vorder": 168,
    "position": 1,
    "text": "بدو باشد افزونی و راستی"
  },
  {
    "poem_id": 1486,
    "vorder": 169,
    "position": 0,
    "text": "ازو باد بر شهریار آفرین"
  },
  {
    "poem_id": 1486,
    "vorder": 170,
    "position": 1,
    "text": "جهاندار وز نامداران گزین"
  },
  {
    "poem_id": 1486,
    "vorder": 171,
    "position": 0,
    "text": "رسیده به هر نیک و بد رای او"
  },
  {
    "poem_id": 1486,
    "vorder": 172,
    "position": 1,
    "text": "ستودن خرد گشته بالای او"
  },
  {
    "poem_id": 1486,
    "vorder": 173,
    "position": 0,
    "text": "رسیدم به بلخ و به خرم بهار"
  },
  {
    "poem_id": 1486,
    "vorder": 174,
    "position": 1,
    "text": "همه شادمان بودم از روزگار"
  },
  {
    "poem_id": 1486,
    "vorder": 175,
    "position": 0,
    "text": "ز من چون خبر یافت افراسیاب"
  },
  {
    "poem_id": 1486,
    "vorder": 176,
    "position": 1,
    "text": "سیه شد به چشم اندرش آفتاب"
  },
  {
    "poem_id": 1486,
    "vorder": 177,
    "position": 0,
    "text": "بدانست کش کار دشوار گشت"
  },
  {
    "poem_id": 1486,
    "vorder": 178,
    "position": 1,
    "text": "جهان تیره شد بخت او خوار گشت"
  },
  {
    "poem_id": 1486,
    "vorder": 179,
    "position": 0,
    "text": "بیامد برادرش با خواسته"
  },
  {
    "poem_id": 1486,
    "vorder": 180,
    "position": 1,
    "text": "بسی خوبرویان آراسته"
  },
  {
    "poem_id": 1486,
    "vorder": 181,
    "position": 0,
    "text": "که زنهار خواهد ز شاه جهان"
  },
  {
    "poem_id": 1486,
    "vorder": 182,
    "position": 1,
    "text": "سپارد بدو تاج و تخت مهان"
  },
  {
    "poem_id": 1486,
    "vorder": 183,
    "position": 0,
    "text": "بسنده کند زین جهان مرز خویش"
  },
  {
    "poem_id": 1486,
    "vorder": 184,
    "position": 1,
    "text": "بداند همی پایه و ارز خویش"
  },
  {
    "poem_id": 1486,
    "vorder": 185,
    "position": 0,
    "text": "از ایران زمین بسپرد تیره خاک"
  },
  {
    "poem_id": 1486,
    "vorder": 186,
    "position": 1,
    "text": "بشوید دل از کینه و جنگ پاک"
  },
  {
    "poem_id": 1486,
    "vorder": 187,
    "position": 0,
    "text": "ز خویشان فرستاد صد نزد من"
  },
  {
    "poem_id": 1486,
    "vorder": 188,
    "position": 1,
    "text": "بدین خواهش آمد گو پیلتن"
  },
  {
    "poem_id": 1486,
    "vorder": 189,
    "position": 0,
    "text": "گر او را ببخشد ز مهرش سزاست"
  },
  {
    "poem_id": 1486,
    "vorder": 190,
    "position": 1,
    "text": "که بر مهر او چهر او بر گواست"
  },
  {
    "poem_id": 1486,
    "vorder": 191,
    "position": 0,
    "text": "چو بنوشت نامه یل جنگجوی"
  },
  {
    "poem_id": 1486,
    "vorder": 192,
    "position": 1,
    "text": "سوی شاه کاووس بنهاد روی"
  },
  {
    "poem_id": 1486,
    "vorder": 193,
    "position": 0,
    "text": "وزان روی گرسیوز نیک‌خواه"
  },
  {
    "poem_id": 1486,
    "vorder": 194,
    "position": 1,
    "text": "بیامد بر شاه توران سپاه"
  },
  {
    "poem_id": 1486,
    "vorder": 195,
    "position": 0,
    "text": "همه داستان سیاوش بگفت"
  },
  {
    "poem_id": 1486,
    "vorder": 196,
    "position": 1,
    "text": "که او را ز شاهان کسی نیست جفت"
  },
  {
    "poem_id": 1486,
    "vorder": 197,
    "position": 0,
    "text": "ز خوبی دیدار و کردار او"
  },
  {
    "poem_id": 1486,
    "vorder": 198,
    "position": 1,
    "text": "ز هوش و دل و شرم و گفتار او"
  },
  {
    "poem_id": 1486,
    "vorder": 199,
    "position": 0,
    "text": "دلیر و سخن‌گوی و گرد و سوار"
  },
  {
    "poem_id": 1486,
    "vorder": 200,
    "position": 1,
    "text": "تو گویی خرد دارد اندر کنار"
  },
  {
    "poem_id": 1486,
    "vorder": 201,
    "position": 0,
    "text": "بخندید و با او چنین گفت شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 202,
    "position": 1,
    "text": "که چاره به از جنگ ای نیک‌خواه"
  },
  {
    "poem_id": 1486,
    "vorder": 203,
    "position": 0,
    "text": "و دیگر کزان خوابم آمد نهیب"
  },
  {
    "poem_id": 1486,
    "vorder": 204,
    "position": 1,
    "text": "ز بالا بدیدم نشان نشیب"
  },
  {
    "poem_id": 1486,
    "vorder": 205,
    "position": 0,
    "text": "پر از درد گشتم سوی چاره باز"
  },
  {
    "poem_id": 1486,
    "vorder": 206,
    "position": 1,
    "text": "بدان تا نبینم نشیب و فراز"
  },
  {
    "poem_id": 1486,
    "vorder": 207,
    "position": 0,
    "text": "به گنج و درم چاره آراستم"
  },
  {
    "poem_id": 1486,
    "vorder": 208,
    "position": 1,
    "text": "کنون شد بران سان که من خواستم"
  },
  {
    "poem_id": 1486,
    "vorder": 209,
    "position": 0,
    "text": "وزان روی چون رستم شیرمرد"
  },
  {
    "poem_id": 1486,
    "vorder": 210,
    "position": 1,
    "text": "بیامد بر شاه ایران چو گرد"
  },
  {
    "poem_id": 1486,
    "vorder": 211,
    "position": 0,
    "text": "به پیش اندر آمد بکش کرده دست"
  },
  {
    "poem_id": 1486,
    "vorder": 212,
    "position": 1,
    "text": "برآمده سپهبد ز جای نشست"
  },
  {
    "poem_id": 1486,
    "vorder": 213,
    "position": 0,
    "text": "بپرسید و بگرفتش اندر کنار"
  },
  {
    "poem_id": 1486,
    "vorder": 214,
    "position": 1,
    "text": "ز فرزند و از گردش روزگار"
  },
  {
    "poem_id": 1486,
    "vorder": 215,
    "position": 0,
    "text": "ز گردان و از رزم و کار سپاه"
  },
  {
    "poem_id": 1486,
    "vorder": 216,
    "position": 1,
    "text": "وزان تا چرا بازگشت او ز راه"
  },
  {
    "poem_id": 1486,
    "vorder": 217,
    "position": 0,
    "text": "نخست از سیاوش زبان برگشاد"
  },
  {
    "poem_id": 1486,
    "vorder": 218,
    "position": 1,
    "text": "ستودش فراوان و نامه بداد"
  },
  {
    "poem_id": 1486,
    "vorder": 219,
    "position": 0,
    "text": "چو نامه برو خواند فرخ دبیر"
  },
  {
    "poem_id": 1486,
    "vorder": 220,
    "position": 1,
    "text": "رخ شهریار جهان شد چو قیر"
  },
  {
    "poem_id": 1486,
    "vorder": 221,
    "position": 0,
    "text": "به رستم چنین گفت گیرم که اوی"
  },
  {
    "poem_id": 1486,
    "vorder": 222,
    "position": 1,
    "text": "جوانست و بد نارسیده بروی"
  },
  {
    "poem_id": 1486,
    "vorder": 223,
    "position": 0,
    "text": "چو تو نیست اندر جهان سر به سر"
  },
  {
    "poem_id": 1486,
    "vorder": 224,
    "position": 1,
    "text": "به جنگ از تو جویند شیران هنر"
  },
  {
    "poem_id": 1486,
    "vorder": 225,
    "position": 0,
    "text": "ندیدی بدیهای افراسیاب"
  },
  {
    "poem_id": 1486,
    "vorder": 226,
    "position": 1,
    "text": "که گم شد ز ما خورد و آرام و خواب"
  },
  {
    "poem_id": 1486,
    "vorder": 227,
    "position": 0,
    "text": "مرا رفت بایست کردم درنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 228,
    "position": 1,
    "text": "مرا بود با او سری پر ز جنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 229,
    "position": 0,
    "text": "نرفتم که گفتند ز ایدر مرو"
  },
  {
    "poem_id": 1486,
    "vorder": 230,
    "position": 1,
    "text": "بمان تا بسیچد جهاندار نو"
  },
  {
    "poem_id": 1486,
    "vorder": 231,
    "position": 0,
    "text": "چو بادافرهٔ ایزدی خواست بود"
  },
  {
    "poem_id": 1486,
    "vorder": 232,
    "position": 1,
    "text": "مکافات بدها بدی خواست بود"
  },
  {
    "poem_id": 1486,
    "vorder": 233,
    "position": 0,
    "text": "شما را بدان مردری خواسته"
  },
  {
    "poem_id": 1486,
    "vorder": 234,
    "position": 1,
    "text": "بدان گونه بر شد دل آراسته"
  },
  {
    "poem_id": 1486,
    "vorder": 235,
    "position": 0,
    "text": "کجا بستد از هر کسی بی‌گناه"
  },
  {
    "poem_id": 1486,
    "vorder": 236,
    "position": 1,
    "text": "بدان تا بپیچیدتان دل ز راه"
  },
  {
    "poem_id": 1486,
    "vorder": 237,
    "position": 0,
    "text": "به صد ترک بیچاره و بدنژاد"
  },
  {
    "poem_id": 1486,
    "vorder": 238,
    "position": 1,
    "text": "که نام پدرشان ندارید یاد"
  },
  {
    "poem_id": 1486,
    "vorder": 239,
    "position": 0,
    "text": "کنون از گروگان کی اندیشد او"
  },
  {
    "poem_id": 1486,
    "vorder": 240,
    "position": 1,
    "text": "همان پیش چشمش همان خاک کو"
  },
  {
    "poem_id": 1486,
    "vorder": 241,
    "position": 0,
    "text": "شما گر خرد را بسیچید کار"
  },
  {
    "poem_id": 1486,
    "vorder": 242,
    "position": 1,
    "text": "نه من سیرم از جنگ و از کارزار"
  },
  {
    "poem_id": 1486,
    "vorder": 243,
    "position": 0,
    "text": "به نزد سیاوش فرستم کنون"
  },
  {
    "poem_id": 1486,
    "vorder": 244,
    "position": 1,
    "text": "یکی مرد پردانش و پرفسون"
  },
  {
    "poem_id": 1486,
    "vorder": 245,
    "position": 0,
    "text": "بفرمایمش کآتشی کن بلند"
  },
  {
    "poem_id": 1486,
    "vorder": 246,
    "position": 1,
    "text": "ببند گران پای ترکان ببند"
  },
  {
    "poem_id": 1486,
    "vorder": 247,
    "position": 0,
    "text": "برآتش بنه خواسته هرچ هست"
  },
  {
    "poem_id": 1486,
    "vorder": 248,
    "position": 1,
    "text": "نگر تا نیازی به یک چیز دست"
  },
  {
    "poem_id": 1486,
    "vorder": 249,
    "position": 0,
    "text": "پس آن بستگان را بر من فرست"
  },
  {
    "poem_id": 1486,
    "vorder": 250,
    "position": 1,
    "text": "که من سر بخواهم ز تن‌شان گسست"
  },
  {
    "poem_id": 1486,
    "vorder": 251,
    "position": 0,
    "text": "تو با لشکر خویش سر پر ز جنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 252,
    "position": 1,
    "text": "برو تا به درگاه او بی‌درنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 253,
    "position": 0,
    "text": "همه دست بگشای تا یکسره"
  },
  {
    "poem_id": 1486,
    "vorder": 254,
    "position": 1,
    "text": "چو گرگ اندر آید به پیش بره"
  },
  {
    "poem_id": 1486,
    "vorder": 255,
    "position": 0,
    "text": "چو تو سازگیری بد آموختن"
  },
  {
    "poem_id": 1486,
    "vorder": 256,
    "position": 1,
    "text": "سپاهت کند غارت و سوختن"
  },
  {
    "poem_id": 1486,
    "vorder": 257,
    "position": 0,
    "text": "بیاید بجنگ تو افراسیاب"
  },
  {
    "poem_id": 1486,
    "vorder": 258,
    "position": 1,
    "text": "چو گردد برو ناخوش آرام و خواب"
  },
  {
    "poem_id": 1486,
    "vorder": 259,
    "position": 0,
    "text": "تهمتن بدو گفت کای شهریار"
  },
  {
    "poem_id": 1486,
    "vorder": 260,
    "position": 1,
    "text": "دلت را بدین کار غمگین مدار"
  },
  {
    "poem_id": 1486,
    "vorder": 261,
    "position": 0,
    "text": "سخن بشنو از من تو ای شه نخست"
  },
  {
    "poem_id": 1486,
    "vorder": 262,
    "position": 1,
    "text": "پس آنگه جهان زیر فرمان تست"
  },
  {
    "poem_id": 1486,
    "vorder": 263,
    "position": 0,
    "text": "تو گفتی که بر جنگ افراسیاب"
  },
  {
    "poem_id": 1486,
    "vorder": 264,
    "position": 1,
    "text": "مران تیز لشکر بران روی آب"
  },
  {
    "poem_id": 1486,
    "vorder": 265,
    "position": 0,
    "text": "بمانید تا او بیاید به جنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 266,
    "position": 1,
    "text": "که او خود شتاب آورد بی‌درنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 267,
    "position": 0,
    "text": "ببودیم یک چند در جنگ سست"
  },
  {
    "poem_id": 1486,
    "vorder": 268,
    "position": 1,
    "text": "در آشتی او گشاد از نخست"
  },
  {
    "poem_id": 1486,
    "vorder": 269,
    "position": 0,
    "text": "کسی کاشتی جوید و سور و بزم"
  },
  {
    "poem_id": 1486,
    "vorder": 270,
    "position": 1,
    "text": "نه نیکو بود پیش رفتن برزم"
  },
  {
    "poem_id": 1486,
    "vorder": 271,
    "position": 0,
    "text": "و دیگر که پیمان شکستن ز شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 272,
    "position": 1,
    "text": "نباشد پسندیدهٔ نیک‌خواه"
  },
  {
    "poem_id": 1486,
    "vorder": 273,
    "position": 0,
    "text": "سیاوش چو پیروز بودی بجنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 274,
    "position": 1,
    "text": "برفتی بسان دلاور پلنگ"
  },
  {
    "poem_id": 1486,
    "vorder": 275,
    "position": 0,
    "text": "چه جستی جز از تخت و تاج و نگین"
  },
  {
    "poem_id": 1486,
    "vorder": 276,
    "position": 1,
    "text": "تن آسانی و گنج ایران زمین"
  },
  {
    "poem_id": 1486,
    "vorder": 277,
    "position": 0,
    "text": "همه یافتی جنگ خیره مجوی"
  },
  {
    "poem_id": 1486,
    "vorder": 278,
    "position": 1,
    "text": "دل روشنت به آب تیره مشوی"
  },
  {
    "poem_id": 1486,
    "vorder": 279,
    "position": 0,
    "text": "گر افراسیاب این سخنها که گفت"
  },
  {
    "poem_id": 1486,
    "vorder": 280,
    "position": 1,
    "text": "به پیمان شکستن بخواهد نهفت"
  },
  {
    "poem_id": 1486,
    "vorder": 281,
    "position": 0,
    "text": "هم از جنگ جستن نگشتیم سیر"
  },
  {
    "poem_id": 1486,
    "vorder": 282,
    "position": 1,
    "text": "بجایست شمشیر و چنگال شیر"
  },
  {
    "poem_id": 1486,
    "vorder": 283,
    "position": 0,
    "text": "ز فرزند پیمان شکستن مخواه"
  },
  {
    "poem_id": 1486,
    "vorder": 284,
    "position": 1,
    "text": "مکن آنچ نه اندر خورد با کلاه"
  },
  {
    "poem_id": 1486,
    "vorder": 285,
    "position": 0,
    "text": "نهانی چرا گفت باید سخن"
  },
  {
    "poem_id": 1486,
    "vorder": 286,
    "position": 1,
    "text": "سیاوش ز پیمان نگردد ز بن"
  },
  {
    "poem_id": 1486,
    "vorder": 287,
    "position": 0,
    "text": "وزین کار کاندیشه کردست شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 288,
    "position": 1,
    "text": "بر آشوبد این نامور پیشگاه"
  },
  {
    "poem_id": 1486,
    "vorder": 289,
    "position": 0,
    "text": "چو کاووس بشنید شد پر ز خشم"
  },
  {
    "poem_id": 1486,
    "vorder": 290,
    "position": 1,
    "text": "برآشفت زان کار و بگشاد چشم"
  },
  {
    "poem_id": 1486,
    "vorder": 291,
    "position": 0,
    "text": "به رستم چنین گفت شاه جهان"
  },
  {
    "poem_id": 1486,
    "vorder": 292,
    "position": 1,
    "text": "که ایدون نماند سخن در نهان"
  },
  {
    "poem_id": 1486,
    "vorder": 293,
    "position": 0,
    "text": "که این در سر او تو افگنده‌ای"
  },
  {
    "poem_id": 1486,
    "vorder": 294,
    "position": 1,
    "text": "چنین بیخ کین از دلش کنده‌ای"
  },
  {
    "poem_id": 1486,
    "vorder": 295,
    "position": 0,
    "text": "تن آسانی خویش جستی برین"
  },
  {
    "poem_id": 1486,
    "vorder": 296,
    "position": 1,
    "text": "نه افروزش تاج و تخت و نگین"
  },
  {
    "poem_id": 1486,
    "vorder": 297,
    "position": 0,
    "text": "تو ایدر بمان تا سپهدار طوس"
  },
  {
    "poem_id": 1486,
    "vorder": 298,
    "position": 1,
    "text": "ببندد برین کار بر پیل کوس"
  },
  {
    "poem_id": 1486,
    "vorder": 299,
    "position": 0,
    "text": "من اکنون هیونی فرستم به بلخ"
  },
  {
    "poem_id": 1486,
    "vorder": 300,
    "position": 1,
    "text": "یکی نامهٔ با سخنهای تلخ"
  },
  {
    "poem_id": 1486,
    "vorder": 301,
    "position": 0,
    "text": "سیاوش اگر سر ز پیمان من"
  },
  {
    "poem_id": 1486,
    "vorder": 302,
    "position": 1,
    "text": "بپیچد نیاید به فرمان من"
  },
  {
    "poem_id": 1486,
    "vorder": 303,
    "position": 0,
    "text": "بطوس سپهبد سپارد سپاه"
  },
  {
    "poem_id": 1486,
    "vorder": 304,
    "position": 1,
    "text": "خود و ویژگان باز گردد به راه"
  },
  {
    "poem_id": 1486,
    "vorder": 305,
    "position": 0,
    "text": "ببیند ز من هرچ اندر خورست"
  },
  {
    "poem_id": 1486,
    "vorder": 306,
    "position": 1,
    "text": "گر او را چنین داوری در سرست"
  },
  {
    "poem_id": 1486,
    "vorder": 307,
    "position": 0,
    "text": "غمی گشت رستم به آواز گفت"
  },
  {
    "poem_id": 1486,
    "vorder": 308,
    "position": 1,
    "text": "که گردون سر من بیارد نهفت"
  },
  {
    "poem_id": 1486,
    "vorder": 309,
    "position": 0,
    "text": "اگر طوس جنگی‌تر از رستم است"
  },
  {
    "poem_id": 1486,
    "vorder": 310,
    "position": 1,
    "text": "چنان دان که رستم ز گیتی کم است"
  },
  {
    "poem_id": 1486,
    "vorder": 311,
    "position": 0,
    "text": "بگفت این و بیرون شد از پیش اوی"
  },
  {
    "poem_id": 1486,
    "vorder": 312,
    "position": 1,
    "text": "پر از خشم چشم و پر آژنگ روی"
  },
  {
    "poem_id": 1486,
    "vorder": 313,
    "position": 0,
    "text": "هم اندر زمان طوس را خواند شاه"
  },
  {
    "poem_id": 1486,
    "vorder": 314,
    "position": 1,
    "text": "بفرمود لشکر کشیدن به راه"
  },
  {
    "poem_id": 1486,
    "vorder": 315,
    "position": 0,
    "text": "چو بیرون شد از پیش کاووس طوس"
  },
  {
    "poem_id": 1486,
    "vorder": 316,
    "position": 1,
    "text": "بفرمود تا لشکر و بوق و کوس"
  },
  {
    "poem_id": 1486,
    "vorder": 317,
    "position": 0,
    "text": "بسازند و آرایش ره کنند"
  },
  {
    "poem_id": 1486,
    "vorder": 318,
    "position": 1,
    "text": "وزان رزمگه راه کوته کنند"
  }
]