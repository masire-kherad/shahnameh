[
  {
    "poem_id": 88080,
    "vorder": 1,
    "position": 0,
    "text": "فرستادهٔ شاه چون بازگشت"
  },
  {
    "poem_id": 88080,
    "vorder": 2,
    "position": 1,
    "text": "همه شهر مکران پرآواز گشت"
  },
  {
    "poem_id": 88080,
    "vorder": 3,
    "position": 0,
    "text": "زمین کوه تا کوه لشکر گرفت"
  },
  {
    "poem_id": 88080,
    "vorder": 4,
    "position": 1,
    "text": "همه تیز و مکران سپه برگرفت"
  },
  {
    "poem_id": 88080,
    "vorder": 5,
    "position": 0,
    "text": "بیاورد پیلان جنگی دویست"
  },
  {
    "poem_id": 88080,
    "vorder": 6,
    "position": 1,
    "text": "تو گفتی که اندر زمین جای نیست"
  },
  {
    "poem_id": 88080,
    "vorder": 7,
    "position": 0,
    "text": "از آواز اسبان و جوش سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 8,
    "position": 1,
    "text": "همی ماه بر چرخ گم کرد راه"
  },
  {
    "poem_id": 88080,
    "vorder": 9,
    "position": 0,
    "text": "تو گفتی برآمد زمین بآسمان"
  },
  {
    "poem_id": 88080,
    "vorder": 10,
    "position": 1,
    "text": "وگر گشت خورشید اندر نهان"
  },
  {
    "poem_id": 88080,
    "vorder": 11,
    "position": 0,
    "text": "طلایه بیامد به نزدیک شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 12,
    "position": 1,
    "text": "که مکران سیه شد ز گرد سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 13,
    "position": 0,
    "text": "همه روی کشور درفشست و پیل"
  },
  {
    "poem_id": 88080,
    "vorder": 14,
    "position": 1,
    "text": "ببیند کنون شهریار از دو میل"
  },
  {
    "poem_id": 88080,
    "vorder": 15,
    "position": 0,
    "text": "بفرمود تا برکشیدند صف"
  },
  {
    "poem_id": 88080,
    "vorder": 16,
    "position": 1,
    "text": "گرفتند گوپال و خنجر به کف"
  },
  {
    "poem_id": 88080,
    "vorder": 17,
    "position": 0,
    "text": "ز مکران طلایه بیامد به دشت"
  },
  {
    "poem_id": 88080,
    "vorder": 18,
    "position": 1,
    "text": "همه شب همی گرد لشکر بگشت"
  },
  {
    "poem_id": 88080,
    "vorder": 19,
    "position": 0,
    "text": "نگهبان لشکر از ایران تخوار"
  },
  {
    "poem_id": 88080,
    "vorder": 20,
    "position": 1,
    "text": "که بودی به نزدیک او رزم خوار"
  },
  {
    "poem_id": 88080,
    "vorder": 21,
    "position": 0,
    "text": "بیامد برآویخت با او به هم"
  },
  {
    "poem_id": 88080,
    "vorder": 22,
    "position": 1,
    "text": "چو پیل سرافراز و شیر دژم"
  },
  {
    "poem_id": 88080,
    "vorder": 23,
    "position": 0,
    "text": "بزد تیغ و او را به دو نیم کرد"
  },
  {
    "poem_id": 88080,
    "vorder": 24,
    "position": 1,
    "text": "دل شاه مکران پر از بیم کرد"
  },
  {
    "poem_id": 88080,
    "vorder": 25,
    "position": 0,
    "text": "دو لشکر بر آن گونه صف برکشید"
  },
  {
    "poem_id": 88080,
    "vorder": 26,
    "position": 1,
    "text": "که از گرد شد آسمان ناپدید"
  },
  {
    "poem_id": 88080,
    "vorder": 27,
    "position": 0,
    "text": "سپاه اندر آمد دو رویه چو کوه"
  },
  {
    "poem_id": 88080,
    "vorder": 28,
    "position": 1,
    "text": "رده برکشیدند هر دو گروه"
  },
  {
    "poem_id": 88080,
    "vorder": 29,
    "position": 0,
    "text": "به قلب اندر آمد سپهدار طوس"
  },
  {
    "poem_id": 88080,
    "vorder": 30,
    "position": 1,
    "text": "جهان شد پر از نالهٔ بوق و کوس"
  },
  {
    "poem_id": 88080,
    "vorder": 31,
    "position": 0,
    "text": "به پیش اندرون کاویانی درفش"
  },
  {
    "poem_id": 88080,
    "vorder": 32,
    "position": 1,
    "text": "پس پشت گردان زرینه کفش"
  },
  {
    "poem_id": 88080,
    "vorder": 33,
    "position": 0,
    "text": "هوا پر ز پیکان شد و پر و تیر"
  },
  {
    "poem_id": 88080,
    "vorder": 34,
    "position": 1,
    "text": "جهان شد به کردار دریای قیر"
  },
  {
    "poem_id": 88080,
    "vorder": 35,
    "position": 0,
    "text": "به قلب اندرون شاه مکران بخست"
  },
  {
    "poem_id": 88080,
    "vorder": 36,
    "position": 1,
    "text": "وزآن خستگی جان او هم برست"
  },
  {
    "poem_id": 88080,
    "vorder": 37,
    "position": 0,
    "text": "یکی گفت شاها سرش را بریم"
  },
  {
    "poem_id": 88080,
    "vorder": 38,
    "position": 1,
    "text": "بدو گفت شاه اندر او ننگریم"
  },
  {
    "poem_id": 88080,
    "vorder": 39,
    "position": 0,
    "text": "سر شهریاران نبرد ز تن"
  },
  {
    "poem_id": 88080,
    "vorder": 40,
    "position": 1,
    "text": "مگر نیز از تخمهٔ اهرمن"
  },
  {
    "poem_id": 88080,
    "vorder": 41,
    "position": 0,
    "text": "برهنه نباید که گردد تنش"
  },
  {
    "poem_id": 88080,
    "vorder": 42,
    "position": 1,
    "text": "بر آن هم نشان خسته در جوشنش"
  },
  {
    "poem_id": 88080,
    "vorder": 43,
    "position": 0,
    "text": "یکی دخمه سازید مشک و گلاب"
  },
  {
    "poem_id": 88080,
    "vorder": 44,
    "position": 1,
    "text": "چنانچون بود شاه را جای خواب"
  },
  {
    "poem_id": 88080,
    "vorder": 45,
    "position": 0,
    "text": "بپوشید رویش به دیبای چین"
  },
  {
    "poem_id": 88080,
    "vorder": 46,
    "position": 1,
    "text": "که مرگ بزرگان بود همچنین"
  },
  {
    "poem_id": 88080,
    "vorder": 47,
    "position": 0,
    "text": "و زآن انجمن کشته شد ده هزار"
  },
  {
    "poem_id": 88080,
    "vorder": 48,
    "position": 1,
    "text": "سواران و گردان خنجرگزار"
  },
  {
    "poem_id": 88080,
    "vorder": 49,
    "position": 0,
    "text": "هزار و صد و چل گرفتار شد"
  },
  {
    "poem_id": 88080,
    "vorder": 50,
    "position": 1,
    "text": "سر زندگان پر ز تیمار شد"
  },
  {
    "poem_id": 88080,
    "vorder": 51,
    "position": 0,
    "text": "ببردند پیلان و آن خواسته"
  },
  {
    "poem_id": 88080,
    "vorder": 52,
    "position": 1,
    "text": "سراپرده و گاه آراسته"
  },
  {
    "poem_id": 88080,
    "vorder": 53,
    "position": 0,
    "text": "بزرگان ایران توانگر شدند"
  },
  {
    "poem_id": 88080,
    "vorder": 54,
    "position": 1,
    "text": "بسی نیز با تخت و افسر شدند"
  },
  {
    "poem_id": 88080,
    "vorder": 55,
    "position": 0,
    "text": "از آن پس دلیران پرخاشجوی"
  },
  {
    "poem_id": 88080,
    "vorder": 56,
    "position": 1,
    "text": "به تاراج مکران نهادند روی"
  },
  {
    "poem_id": 88080,
    "vorder": 57,
    "position": 0,
    "text": "خروش زنان خاست از دشت و شهر"
  },
  {
    "poem_id": 88080,
    "vorder": 58,
    "position": 1,
    "text": "چشیدند زان رنج بسیار بهر"
  },
  {
    "poem_id": 88080,
    "vorder": 59,
    "position": 0,
    "text": "به درهای شهر آتش اندر زدند"
  },
  {
    "poem_id": 88080,
    "vorder": 60,
    "position": 1,
    "text": "همی آسمان بر زمین برزدند"
  },
  {
    "poem_id": 88080,
    "vorder": 61,
    "position": 0,
    "text": "بخستند ز ایشان فراوان به تیر"
  },
  {
    "poem_id": 88080,
    "vorder": 62,
    "position": 1,
    "text": "زن و کودک خرد کردند اسیر"
  },
  {
    "poem_id": 88080,
    "vorder": 63,
    "position": 0,
    "text": "چو کم شد از آن انجمن خشم شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 64,
    "position": 1,
    "text": "بفرمود تا باز گردد سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 65,
    "position": 0,
    "text": "بفرمود تا اشکش تیز هوش"
  },
  {
    "poem_id": 88080,
    "vorder": 66,
    "position": 1,
    "text": "بیارامد از غارت و جنگ و جوش"
  },
  {
    "poem_id": 88080,
    "vorder": 67,
    "position": 0,
    "text": "کسی را نماند که زشتی کند"
  },
  {
    "poem_id": 88080,
    "vorder": 68,
    "position": 1,
    "text": "وگر با نژندی درشتی کند"
  },
  {
    "poem_id": 88080,
    "vorder": 69,
    "position": 0,
    "text": "از آن شهر هر کس که بد پارسا"
  },
  {
    "poem_id": 88080,
    "vorder": 70,
    "position": 1,
    "text": "به پوزش بیامد بر پادشا"
  },
  {
    "poem_id": 88080,
    "vorder": 71,
    "position": 0,
    "text": "که ما بیگناهیم و بیچاره‌ایم"
  },
  {
    "poem_id": 88080,
    "vorder": 72,
    "position": 1,
    "text": "همیشه به رنج ستمکاره‌ایم"
  },
  {
    "poem_id": 88080,
    "vorder": 73,
    "position": 0,
    "text": "گر ایدون که بیند سر بی‌گناه"
  },
  {
    "poem_id": 88080,
    "vorder": 74,
    "position": 1,
    "text": "ببخشد سزاوار باشد ز شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 75,
    "position": 0,
    "text": "از ایشان چو بشنید فرخنده شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 76,
    "position": 1,
    "text": "بفرمود تا بانگ زد بر سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 77,
    "position": 0,
    "text": "خروشی برآمد ز پرده‌سرای"
  },
  {
    "poem_id": 88080,
    "vorder": 78,
    "position": 1,
    "text": "که ای پهلوانان فرخنده رای"
  },
  {
    "poem_id": 88080,
    "vorder": 79,
    "position": 0,
    "text": "از این پس گر آید ز جایی خروش"
  },
  {
    "poem_id": 88080,
    "vorder": 80,
    "position": 1,
    "text": "ز بیدادی و غارت و جنگ و جوش"
  },
  {
    "poem_id": 88080,
    "vorder": 81,
    "position": 0,
    "text": "ستمکارگان را کنم به دو نیم"
  },
  {
    "poem_id": 88080,
    "vorder": 82,
    "position": 1,
    "text": "کسی کو ندارد ز دادار بیم"
  },
  {
    "poem_id": 88080,
    "vorder": 83,
    "position": 0,
    "text": "جهاندار سالی به مکران بماند"
  },
  {
    "poem_id": 88080,
    "vorder": 84,
    "position": 1,
    "text": "ز هر جای کشتی گران را بخواند"
  },
  {
    "poem_id": 88080,
    "vorder": 85,
    "position": 0,
    "text": "چو آمد بهار و زمین گشت سبز"
  },
  {
    "poem_id": 88080,
    "vorder": 86,
    "position": 1,
    "text": "همه کوه پر لاله و دشت سبز"
  },
  {
    "poem_id": 88080,
    "vorder": 87,
    "position": 0,
    "text": "چراگاه اسبان و جای شکار"
  },
  {
    "poem_id": 88080,
    "vorder": 88,
    "position": 1,
    "text": "بیاراست باغ از گل و میوه‌دار"
  },
  {
    "poem_id": 88080,
    "vorder": 89,
    "position": 0,
    "text": "به اشکش بفرمود تا با سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 90,
    "position": 1,
    "text": "به مکران بباشد یکی چندگاه"
  },
  {
    "poem_id": 88080,
    "vorder": 91,
    "position": 0,
    "text": "نجوید جز از خوبی و راستی"
  },
  {
    "poem_id": 88080,
    "vorder": 92,
    "position": 1,
    "text": "نیارد به کار اندرون کاستی"
  },
  {
    "poem_id": 88080,
    "vorder": 93,
    "position": 0,
    "text": "و زآن شهر راه بیابان گرفت"
  },
  {
    "poem_id": 88080,
    "vorder": 94,
    "position": 1,
    "text": "همه رنجها بر دل آسان گرفت"
  },
  {
    "poem_id": 88080,
    "vorder": 95,
    "position": 0,
    "text": "چنان شد به فرمان یزدان پاک"
  },
  {
    "poem_id": 88080,
    "vorder": 96,
    "position": 1,
    "text": "که اندر بیابان ندیدند خاک"
  },
  {
    "poem_id": 88080,
    "vorder": 97,
    "position": 0,
    "text": "هوا پر ز ابر و زمین پر ز خوید"
  },
  {
    "poem_id": 88080,
    "vorder": 98,
    "position": 1,
    "text": "جهانی پر از لاله و شنبلید"
  },
  {
    "poem_id": 88080,
    "vorder": 99,
    "position": 0,
    "text": "خورشهای مردم ببردند پیش"
  },
  {
    "poem_id": 88080,
    "vorder": 100,
    "position": 1,
    "text": "به گردون به زیر اندرون گاومیش"
  },
  {
    "poem_id": 88080,
    "vorder": 101,
    "position": 0,
    "text": "به دشت اندرون سبزه و جای خواب"
  },
  {
    "poem_id": 88080,
    "vorder": 102,
    "position": 1,
    "text": "هوا پر ز ابر و زمین پر ز آب"
  },
  {
    "poem_id": 88080,
    "vorder": 103,
    "position": 0,
    "text": "چو آمد به نزدیک آب زره"
  },
  {
    "poem_id": 88080,
    "vorder": 104,
    "position": 1,
    "text": "گشادند گردان میان از گره"
  },
  {
    "poem_id": 88080,
    "vorder": 105,
    "position": 0,
    "text": "همه چاره سازان دریا به راه"
  },
  {
    "poem_id": 88080,
    "vorder": 106,
    "position": 1,
    "text": "ز چین و ز مکران همی برد شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 107,
    "position": 0,
    "text": "به خشکی بکرد آنچه بایست کرد"
  },
  {
    "poem_id": 88080,
    "vorder": 108,
    "position": 1,
    "text": "چو کشتی به آب اندر افگند مرد"
  },
  {
    "poem_id": 88080,
    "vorder": 109,
    "position": 0,
    "text": "بفرمود تا توشه برداشتند"
  },
  {
    "poem_id": 88080,
    "vorder": 110,
    "position": 1,
    "text": "به یک ساله ره راه بگذاشتند"
  },
  {
    "poem_id": 88080,
    "vorder": 111,
    "position": 0,
    "text": "جهاندار نیک اختر و راه‌جوی"
  },
  {
    "poem_id": 88080,
    "vorder": 112,
    "position": 1,
    "text": "برفت از لب آب با آب روی"
  },
  {
    "poem_id": 88080,
    "vorder": 113,
    "position": 0,
    "text": "بر آن بندگی بر نیایش گرفت"
  },
  {
    "poem_id": 88080,
    "vorder": 114,
    "position": 1,
    "text": "جهان آفرین را ستایش گرفت"
  },
  {
    "poem_id": 88080,
    "vorder": 115,
    "position": 0,
    "text": "همی خواست از کردگار بلند"
  },
  {
    "poem_id": 88080,
    "vorder": 116,
    "position": 1,
    "text": "کز آبش به خشکی برد بی‌گزند"
  },
  {
    "poem_id": 88080,
    "vorder": 117,
    "position": 0,
    "text": "همان ساز جنگ و سپاه ورا"
  },
  {
    "poem_id": 88080,
    "vorder": 118,
    "position": 1,
    "text": "بزرگان ایران و گاه ورا"
  },
  {
    "poem_id": 88080,
    "vorder": 119,
    "position": 0,
    "text": "همی گفت کای کردگار جهان"
  },
  {
    "poem_id": 88080,
    "vorder": 120,
    "position": 1,
    "text": "شناسندهٔ آشکار و نهان"
  },
  {
    "poem_id": 88080,
    "vorder": 121,
    "position": 0,
    "text": "نگهدار خشکی و دریا توی"
  },
  {
    "poem_id": 88080,
    "vorder": 122,
    "position": 1,
    "text": "خدای ثری و ثریا توی"
  },
  {
    "poem_id": 88080,
    "vorder": 123,
    "position": 0,
    "text": "نگه‌دار جان و سپاه مرا"
  },
  {
    "poem_id": 88080,
    "vorder": 124,
    "position": 1,
    "text": "همان تخت و گنج و کلاه مرا"
  },
  {
    "poem_id": 88080,
    "vorder": 125,
    "position": 0,
    "text": "پرآشوب دریا از آن گونه بود"
  },
  {
    "poem_id": 88080,
    "vorder": 126,
    "position": 1,
    "text": "کز او کس نرستی بدان برشخود"
  },
  {
    "poem_id": 88080,
    "vorder": 127,
    "position": 0,
    "text": "به شش ماه کشتی برفتی به آب"
  },
  {
    "poem_id": 88080,
    "vorder": 128,
    "position": 1,
    "text": "کز او ساختی هر کسی جای خواب"
  },
  {
    "poem_id": 88080,
    "vorder": 129,
    "position": 0,
    "text": "به هفتم که نیمی گذشتی ز سال"
  },
  {
    "poem_id": 88080,
    "vorder": 130,
    "position": 1,
    "text": "شدی کژ و بی راه باد شمال"
  },
  {
    "poem_id": 88080,
    "vorder": 131,
    "position": 0,
    "text": "سر بادبان تیز برگاشتی"
  },
  {
    "poem_id": 88080,
    "vorder": 132,
    "position": 1,
    "text": "چو برق درخشنده بگماشتی"
  },
  {
    "poem_id": 88080,
    "vorder": 133,
    "position": 0,
    "text": "به راهی کشیدیش موج مدد"
  },
  {
    "poem_id": 88080,
    "vorder": 134,
    "position": 1,
    "text": "که ملاح خواندش فم الاسد"
  },
  {
    "poem_id": 88080,
    "vorder": 135,
    "position": 0,
    "text": "چنان خواست یزدان که باد هوا"
  },
  {
    "poem_id": 88080,
    "vorder": 136,
    "position": 1,
    "text": "نشد کژ با اختر پادشا"
  },
  {
    "poem_id": 88080,
    "vorder": 137,
    "position": 0,
    "text": "شگفت اندر آن آب مانده سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 138,
    "position": 1,
    "text": "نمودی به انگشت هر یک به شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 139,
    "position": 0,
    "text": "به آب اندرون شیر دیدند و گاو"
  },
  {
    "poem_id": 88080,
    "vorder": 140,
    "position": 1,
    "text": "همی داشتی گاو با شیر تاو"
  },
  {
    "poem_id": 88080,
    "vorder": 141,
    "position": 0,
    "text": "همان مردم و مویها چون کمند"
  },
  {
    "poem_id": 88080,
    "vorder": 142,
    "position": 1,
    "text": "همه تن پر از پشم چون گوسفند"
  },
  {
    "poem_id": 88080,
    "vorder": 143,
    "position": 0,
    "text": "گروهی سران چون سر گاومیش"
  },
  {
    "poem_id": 88080,
    "vorder": 144,
    "position": 1,
    "text": "دو دست از پس مردم و پای پیش"
  },
  {
    "poem_id": 88080,
    "vorder": 145,
    "position": 0,
    "text": "یکی سر چو ماهی و تن چون نهنگ"
  },
  {
    "poem_id": 88080,
    "vorder": 146,
    "position": 1,
    "text": "یکی پای چون گور و تن چون پلنگ"
  },
  {
    "poem_id": 88080,
    "vorder": 147,
    "position": 0,
    "text": "نمودی همی این بدان آن بدین"
  },
  {
    "poem_id": 88080,
    "vorder": 148,
    "position": 1,
    "text": "به دادار بر خواندند آفرین"
  },
  {
    "poem_id": 88080,
    "vorder": 149,
    "position": 0,
    "text": "به بخشایش کردگار سپهر"
  },
  {
    "poem_id": 88080,
    "vorder": 150,
    "position": 1,
    "text": "هوا شد خوش و باد ننمود چهر"
  },
  {
    "poem_id": 88080,
    "vorder": 151,
    "position": 0,
    "text": "گذشتند بر آب بر هفت ماه"
  },
  {
    "poem_id": 88080,
    "vorder": 152,
    "position": 1,
    "text": "که بادی نکرد اندر ایشان نگاه"
  },
  {
    "poem_id": 88080,
    "vorder": 153,
    "position": 0,
    "text": "چو خسرو ز دریا به خشکی رسید"
  },
  {
    "poem_id": 88080,
    "vorder": 154,
    "position": 1,
    "text": "نگه کرد هامون جهان را بدید"
  },
  {
    "poem_id": 88080,
    "vorder": 155,
    "position": 0,
    "text": "بیامد به پیش جهان آفرین"
  },
  {
    "poem_id": 88080,
    "vorder": 156,
    "position": 1,
    "text": "بمالید بر خاک رخ بر زمین"
  },
  {
    "poem_id": 88080,
    "vorder": 157,
    "position": 0,
    "text": "برآورد کشتی و زورق ز آب"
  },
  {
    "poem_id": 88080,
    "vorder": 158,
    "position": 1,
    "text": "شتاب آمدش بود جای شتاب"
  },
  {
    "poem_id": 88080,
    "vorder": 159,
    "position": 0,
    "text": "بیابانش پیش آمد و ریگ و دشت"
  },
  {
    "poem_id": 88080,
    "vorder": 160,
    "position": 1,
    "text": "تن‌آسان به ریگ روان برگذشت"
  },
  {
    "poem_id": 88080,
    "vorder": 161,
    "position": 0,
    "text": "همه شهرها دید بر سان چین"
  },
  {
    "poem_id": 88080,
    "vorder": 162,
    "position": 1,
    "text": "زبانها به کردار مکران زمین"
  },
  {
    "poem_id": 88080,
    "vorder": 163,
    "position": 0,
    "text": "بدان شهرها در بیاسود شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 164,
    "position": 1,
    "text": "خورش خواست چندی ز بهر سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 165,
    "position": 0,
    "text": "سپرد آن زمین گیو را شهریار"
  },
  {
    "poem_id": 88080,
    "vorder": 166,
    "position": 1,
    "text": "بدو گفت بر خوردی از روزگار"
  },
  {
    "poem_id": 88080,
    "vorder": 167,
    "position": 0,
    "text": "درشتی مکن با گنهکار نیز"
  },
  {
    "poem_id": 88080,
    "vorder": 168,
    "position": 1,
    "text": "که بی رنج شد مردم از گنج و چیز"
  },
  {
    "poem_id": 88080,
    "vorder": 169,
    "position": 0,
    "text": "از این پس ندارم کسی را به کس"
  },
  {
    "poem_id": 88080,
    "vorder": 170,
    "position": 1,
    "text": "پرستش کنم پیش فریادرس"
  },
  {
    "poem_id": 88080,
    "vorder": 171,
    "position": 0,
    "text": "ز لشکر یکی نامور برگزید"
  },
  {
    "poem_id": 88080,
    "vorder": 172,
    "position": 1,
    "text": "که گفتار هر کس بداند شنید"
  },
  {
    "poem_id": 88080,
    "vorder": 173,
    "position": 0,
    "text": "فرستاد نزدیک شاهان پیام"
  },
  {
    "poem_id": 88080,
    "vorder": 174,
    "position": 1,
    "text": "که هر کس که او جوید آرام و کام"
  },
  {
    "poem_id": 88080,
    "vorder": 175,
    "position": 0,
    "text": "بیایند خرم بدین بارگاه"
  },
  {
    "poem_id": 88080,
    "vorder": 176,
    "position": 1,
    "text": "برفتند یکسر به فرمان شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 177,
    "position": 0,
    "text": "یکی سر نپیچید زان مهتران"
  },
  {
    "poem_id": 88080,
    "vorder": 178,
    "position": 1,
    "text": "به درگاه رفتند چون کهتران"
  },
  {
    "poem_id": 88080,
    "vorder": 179,
    "position": 0,
    "text": "چو دیدار بد شاه بنواختشان"
  },
  {
    "poem_id": 88080,
    "vorder": 180,
    "position": 1,
    "text": "به خورشید گردن برافراختشان"
  },
  {
    "poem_id": 88080,
    "vorder": 181,
    "position": 0,
    "text": "پس از گنگ دژ باز جست آگهی"
  },
  {
    "poem_id": 88080,
    "vorder": 182,
    "position": 1,
    "text": "ز افراسیاب و ز تخت مهی"
  },
  {
    "poem_id": 88080,
    "vorder": 183,
    "position": 0,
    "text": "چنین گفت گوینده‌ای زان گروه"
  },
  {
    "poem_id": 88080,
    "vorder": 184,
    "position": 1,
    "text": "که ایدر نه آبست پیشت نه کوه"
  },
  {
    "poem_id": 88080,
    "vorder": 185,
    "position": 0,
    "text": "اگر بشمری سر به سر نیک و بد"
  },
  {
    "poem_id": 88080,
    "vorder": 186,
    "position": 1,
    "text": "فزون نیست تا گنگ فرسنگ صد"
  },
  {
    "poem_id": 88080,
    "vorder": 187,
    "position": 0,
    "text": "کنون تا برآمد ز دریای آب"
  },
  {
    "poem_id": 88080,
    "vorder": 188,
    "position": 1,
    "text": "به گنگست با مردم افراسیاب"
  },
  {
    "poem_id": 88080,
    "vorder": 189,
    "position": 0,
    "text": "از آن آگهی شاد شد شهریار"
  },
  {
    "poem_id": 88080,
    "vorder": 190,
    "position": 1,
    "text": "شد آن رنجها بر دلش نیز خوار"
  },
  {
    "poem_id": 88080,
    "vorder": 191,
    "position": 0,
    "text": "در آن مرزها خلعت آراستند"
  },
  {
    "poem_id": 88080,
    "vorder": 192,
    "position": 1,
    "text": "پس اسب جهاندیدگان خواستند"
  },
  {
    "poem_id": 88080,
    "vorder": 193,
    "position": 0,
    "text": "بفرمود تا بازگشتند شاه"
  },
  {
    "poem_id": 88080,
    "vorder": 194,
    "position": 1,
    "text": "سوی گنگ دژ رفت با آن سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 195,
    "position": 0,
    "text": "بر آن سو که پور سیاوش براند"
  },
  {
    "poem_id": 88080,
    "vorder": 196,
    "position": 1,
    "text": "ز بیداد مردم فراوان نماند"
  },
  {
    "poem_id": 88080,
    "vorder": 197,
    "position": 0,
    "text": "سپه را بیاراست و روزی بداد"
  },
  {
    "poem_id": 88080,
    "vorder": 198,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد یاد"
  },
  {
    "poem_id": 88080,
    "vorder": 199,
    "position": 0,
    "text": "همی گفت هر کس که جوید بدی"
  },
  {
    "poem_id": 88080,
    "vorder": 200,
    "position": 1,
    "text": "بپیچد ز باد افره ایزدی"
  },
  {
    "poem_id": 88080,
    "vorder": 201,
    "position": 0,
    "text": "نباید که باشید یک تن به شهر"
  },
  {
    "poem_id": 88080,
    "vorder": 202,
    "position": 1,
    "text": "گر از رنج یابد پی مور بهر"
  },
  {
    "poem_id": 88080,
    "vorder": 203,
    "position": 0,
    "text": "چهانجوی چون گنگ دژ را بدید"
  },
  {
    "poem_id": 88080,
    "vorder": 204,
    "position": 1,
    "text": "شد از آب دیده رخش ناپدید"
  },
  {
    "poem_id": 88080,
    "vorder": 205,
    "position": 0,
    "text": "پیاده شد از اسب و رخ بر زمین"
  },
  {
    "poem_id": 88080,
    "vorder": 206,
    "position": 1,
    "text": "همی کرد بر کردگار آفرین"
  },
  {
    "poem_id": 88080,
    "vorder": 207,
    "position": 0,
    "text": "همی گفت کای داور داد و پاک"
  },
  {
    "poem_id": 88080,
    "vorder": 208,
    "position": 1,
    "text": "یکی بنده‌ام دل پر از ترس و باک"
  },
  {
    "poem_id": 88080,
    "vorder": 209,
    "position": 0,
    "text": "که این بارهٔ شارستان پدر"
  },
  {
    "poem_id": 88080,
    "vorder": 210,
    "position": 1,
    "text": "بدیدم برآورده از ماه سر"
  },
  {
    "poem_id": 88080,
    "vorder": 211,
    "position": 0,
    "text": "سیاوش که از فر یزدان پاک"
  },
  {
    "poem_id": 88080,
    "vorder": 212,
    "position": 1,
    "text": "چنین باره‌ای برکشید از مغاک"
  },
  {
    "poem_id": 88080,
    "vorder": 213,
    "position": 0,
    "text": "ستمگر بد آن کو به بد آخت دست"
  },
  {
    "poem_id": 88080,
    "vorder": 214,
    "position": 1,
    "text": "دل هر کس از کشتن او بخست"
  },
  {
    "poem_id": 88080,
    "vorder": 215,
    "position": 0,
    "text": "بر آن باره بگریست یکسر سپاه"
  },
  {
    "poem_id": 88080,
    "vorder": 216,
    "position": 1,
    "text": "ز خون سیاوش که بد بیگناه"
  },
  {
    "poem_id": 88080,
    "vorder": 217,
    "position": 0,
    "text": "به دست بداندیش بر کشته شد"
  },
  {
    "poem_id": 88080,
    "vorder": 218,
    "position": 1,
    "text": "چنین تخم کین در جهان کشته شد"
  }
]