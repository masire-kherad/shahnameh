[
  {
    "poem_id": 1354,
    "vorder": 1,
    "position": 0,
    "text": "چو آمد به نزدیک اروندرود"
  },
  {
    "poem_id": 1354,
    "vorder": 2,
    "position": 1,
    "text": "فرستاد زی رودبانان درود"
  },
  {
    "poem_id": 1354,
    "vorder": 3,
    "position": 0,
    "text": "بران رودبان گفت پیروز شاه"
  },
  {
    "poem_id": 1354,
    "vorder": 4,
    "position": 1,
    "text": "که کشتی برافگن هم اکنون به راه"
  },
  {
    "poem_id": 1354,
    "vorder": 5,
    "position": 0,
    "text": "مرا با سپاهم بدان سو رسان"
  },
  {
    "poem_id": 1354,
    "vorder": 6,
    "position": 1,
    "text": "از اینها کسی را بدین سو ممان"
  },
  {
    "poem_id": 1354,
    "vorder": 7,
    "position": 0,
    "text": "بدان تا گذر یابم از روی آب"
  },
  {
    "poem_id": 1354,
    "vorder": 8,
    "position": 1,
    "text": "به کشتی و زورق هم اندر شتاب"
  },
  {
    "poem_id": 1354,
    "vorder": 9,
    "position": 0,
    "text": "نیاورد کشتی نگهبان رود"
  },
  {
    "poem_id": 1354,
    "vorder": 10,
    "position": 1,
    "text": "نیامد بگفت فریدون فرود"
  },
  {
    "poem_id": 1354,
    "vorder": 11,
    "position": 0,
    "text": "چنین داد پاسخ که شاه جهان"
  },
  {
    "poem_id": 1354,
    "vorder": 12,
    "position": 1,
    "text": "چنین گفت با من سخن در نهان"
  },
  {
    "poem_id": 1354,
    "vorder": 13,
    "position": 0,
    "text": "که مگذار یک پشه را تا نخست"
  },
  {
    "poem_id": 1354,
    "vorder": 14,
    "position": 1,
    "text": "جوازی بیابی و مهری درست"
  },
  {
    "poem_id": 1354,
    "vorder": 15,
    "position": 0,
    "text": "فریدون چو بشنید شد خشمناک"
  },
  {
    "poem_id": 1354,
    "vorder": 16,
    "position": 1,
    "text": "ازان ژرف دریا نیامدش باک"
  },
  {
    "poem_id": 1354,
    "vorder": 17,
    "position": 0,
    "text": "هم آنگه میان کیانی ببست"
  },
  {
    "poem_id": 1354,
    "vorder": 18,
    "position": 1,
    "text": "بران بارهٔ تیزتک بر نشست"
  },
  {
    "poem_id": 1354,
    "vorder": 19,
    "position": 0,
    "text": "سرش تیز شد کینه و جنگ را"
  },
  {
    "poem_id": 1354,
    "vorder": 20,
    "position": 1,
    "text": "به آب اندر افگند گلرنگ را"
  },
  {
    "poem_id": 1354,
    "vorder": 21,
    "position": 0,
    "text": "ببستند یارانش یکسر کمر"
  },
  {
    "poem_id": 1354,
    "vorder": 22,
    "position": 1,
    "text": "همیدون به دریا نهادند سر"
  },
  {
    "poem_id": 1354,
    "vorder": 23,
    "position": 0,
    "text": "بر آن بادپایان با آفرین"
  },
  {
    "poem_id": 1354,
    "vorder": 24,
    "position": 1,
    "text": "به آب اندرون غرقه کردند زین"
  },
  {
    "poem_id": 1354,
    "vorder": 25,
    "position": 0,
    "text": "به خشکی رسیدند سر کینه جوی"
  },
  {
    "poem_id": 1354,
    "vorder": 26,
    "position": 1,
    "text": "به بیت‌المقدس نهادند روی"
  },
  {
    "poem_id": 1354,
    "vorder": 27,
    "position": 0,
    "text": "که بر پهلوانی زبان راندند"
  },
  {
    "poem_id": 1354,
    "vorder": 28,
    "position": 1,
    "text": "همی کنگ دژهودجش خواندند"
  },
  {
    "poem_id": 1354,
    "vorder": 29,
    "position": 0,
    "text": "به تازی کنون خانهٔ پاک دان"
  },
  {
    "poem_id": 1354,
    "vorder": 30,
    "position": 1,
    "text": "برآورده ایوان ضحاک دان"
  },
  {
    "poem_id": 1354,
    "vorder": 31,
    "position": 0,
    "text": "چو از دشت نزدیک شهر آمدند"
  },
  {
    "poem_id": 1354,
    "vorder": 32,
    "position": 1,
    "text": "کزان شهر جوینده بهر آمدند"
  },
  {
    "poem_id": 1354,
    "vorder": 33,
    "position": 0,
    "text": "ز یک میل کرد آفریدون نگاه"
  },
  {
    "poem_id": 1354,
    "vorder": 34,
    "position": 1,
    "text": "یکی کاخ دید اندر آن شهر شاه"
  },
  {
    "poem_id": 1354,
    "vorder": 35,
    "position": 0,
    "text": "فروزنده چون مشتری بر سپهر"
  },
  {
    "poem_id": 1354,
    "vorder": 36,
    "position": 1,
    "text": "همه جای شادی و آرام و مهر"
  },
  {
    "poem_id": 1354,
    "vorder": 37,
    "position": 0,
    "text": "که ایوانش برتر ز کیوان نمود"
  },
  {
    "poem_id": 1354,
    "vorder": 38,
    "position": 1,
    "text": "که گفتی ستاره بخواهد بسود"
  },
  {
    "poem_id": 1354,
    "vorder": 39,
    "position": 0,
    "text": "بدانست کان خانهٔ اژدهاست"
  },
  {
    "poem_id": 1354,
    "vorder": 40,
    "position": 1,
    "text": "که جای بزرگی و جای بهاست"
  },
  {
    "poem_id": 1354,
    "vorder": 41,
    "position": 0,
    "text": "به یارانش گفت آنکه بر تیره خاک"
  },
  {
    "poem_id": 1354,
    "vorder": 42,
    "position": 1,
    "text": "برآرد چنین برز جای از مغاک"
  },
  {
    "poem_id": 1354,
    "vorder": 43,
    "position": 0,
    "text": "بترسم همی زانکه با او جهان"
  },
  {
    "poem_id": 1354,
    "vorder": 44,
    "position": 1,
    "text": "مگر راز دارد یکی در نهان"
  },
  {
    "poem_id": 1354,
    "vorder": 45,
    "position": 0,
    "text": "بباید که ما را بدین جای تنگ"
  },
  {
    "poem_id": 1354,
    "vorder": 46,
    "position": 1,
    "text": "شتابیدن آید به روز درنگ"
  },
  {
    "poem_id": 1354,
    "vorder": 47,
    "position": 0,
    "text": "بگفت و به گرز گران دست برد"
  },
  {
    "poem_id": 1354,
    "vorder": 48,
    "position": 1,
    "text": "عنان بارهٔ تیزتک را سپرد"
  },
  {
    "poem_id": 1354,
    "vorder": 49,
    "position": 0,
    "text": "تو گفتی یکی آتشستی درست"
  },
  {
    "poem_id": 1354,
    "vorder": 50,
    "position": 1,
    "text": "که پیش نگهبان ایوان برست"
  },
  {
    "poem_id": 1354,
    "vorder": 51,
    "position": 0,
    "text": "گران گرز برداشت از پیش زین"
  },
  {
    "poem_id": 1354,
    "vorder": 52,
    "position": 1,
    "text": "تو گفتی همی بر نوردد زمین"
  },
  {
    "poem_id": 1354,
    "vorder": 53,
    "position": 0,
    "text": "کس از روزبانان به در بر نماند"
  },
  {
    "poem_id": 1354,
    "vorder": 54,
    "position": 1,
    "text": "فریدون جهان آفرین را بخواند"
  },
  {
    "poem_id": 1354,
    "vorder": 55,
    "position": 0,
    "text": "به اسب اندر آمد به کاخ بزرگ"
  },
  {
    "poem_id": 1354,
    "vorder": 56,
    "position": 1,
    "text": "جهان ناسپرده جوان سترگ"
  }
]