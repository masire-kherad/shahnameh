[
  {
    "poem_id": 1503,
    "vorder": 1,
    "position": 0,
    "text": "جهانجوی چون شد سرافراز و گرد"
  },
  {
    "poem_id": 1503,
    "vorder": 2,
    "position": 1,
    "text": "سپه را بدشمن نشاید سپرد"
  },
  {
    "poem_id": 1503,
    "vorder": 3,
    "position": 0,
    "text": "سرشک اندر آید بمژگان ز رشک"
  },
  {
    "poem_id": 1503,
    "vorder": 4,
    "position": 1,
    "text": "سرشکی که درمان نداند پزشک"
  },
  {
    "poem_id": 1503,
    "vorder": 5,
    "position": 0,
    "text": "کسی کز نژاد بزرگان بود"
  },
  {
    "poem_id": 1503,
    "vorder": 6,
    "position": 1,
    "text": "به بیشی بماند سترگ آن بود"
  },
  {
    "poem_id": 1503,
    "vorder": 7,
    "position": 0,
    "text": "چو بی‌کام دل بنده باید بدن"
  },
  {
    "poem_id": 1503,
    "vorder": 8,
    "position": 1,
    "text": "بکام کسی داستانها زدن"
  },
  {
    "poem_id": 1503,
    "vorder": 9,
    "position": 0,
    "text": "سپهبد چو خواند ورا دوستدار"
  },
  {
    "poem_id": 1503,
    "vorder": 10,
    "position": 1,
    "text": "نباشد خرد با دلش سازگار"
  },
  {
    "poem_id": 1503,
    "vorder": 11,
    "position": 0,
    "text": "گرش زآرزو بازدارد سپهر"
  },
  {
    "poem_id": 1503,
    "vorder": 12,
    "position": 1,
    "text": "همان آفرینش نخواند بمهر"
  },
  {
    "poem_id": 1503,
    "vorder": 13,
    "position": 0,
    "text": "ورا هیچ خوبی نخواهد به دل"
  },
  {
    "poem_id": 1503,
    "vorder": 14,
    "position": 1,
    "text": "شود آرزوهای او دلگسل"
  },
  {
    "poem_id": 1503,
    "vorder": 15,
    "position": 0,
    "text": "و دیگر کش از بن نباشد خرد"
  },
  {
    "poem_id": 1503,
    "vorder": 16,
    "position": 1,
    "text": "خردمندش از مردمان نشمرد"
  },
  {
    "poem_id": 1503,
    "vorder": 17,
    "position": 0,
    "text": "چو این داستان سربسر بشنوی"
  },
  {
    "poem_id": 1503,
    "vorder": 18,
    "position": 1,
    "text": "ببینی سر مایهٔ بدخوی"
  }
]