[
  {
    "poem_id": 87974,
    "vorder": 1,
    "position": 0,
    "text": "دبیر خردمند را پیش خواند"
  },
  {
    "poem_id": 87974,
    "vorder": 2,
    "position": 1,
    "text": "دل آگنده بودش ز غم برفشاند"
  },
  {
    "poem_id": 87974,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامه بنوشت پر آب چشم"
  },
  {
    "poem_id": 87974,
    "vorder": 4,
    "position": 1,
    "text": "ز بهر برادر پر از درد و خشم"
  },
  {
    "poem_id": 87974,
    "vorder": 5,
    "position": 0,
    "text": "بسوی فریبرز کاوس شاه"
  },
  {
    "poem_id": 87974,
    "vorder": 6,
    "position": 1,
    "text": "یکی سوی پرمایگان سپاه"
  },
  {
    "poem_id": 87974,
    "vorder": 7,
    "position": 0,
    "text": "سر نامه بود از نخست آفرین"
  },
  {
    "poem_id": 87974,
    "vorder": 8,
    "position": 1,
    "text": "چنانچون بود رسم آیین و دین"
  },
  {
    "poem_id": 87974,
    "vorder": 9,
    "position": 0,
    "text": "بنام خداوند خورشید و ماه"
  },
  {
    "poem_id": 87974,
    "vorder": 10,
    "position": 1,
    "text": "کجا داد بر نیکوی دستگاه"
  },
  {
    "poem_id": 87974,
    "vorder": 11,
    "position": 0,
    "text": "جهان و مکان و زمان آفرید"
  },
  {
    "poem_id": 87974,
    "vorder": 12,
    "position": 1,
    "text": "پی مور و پیل گران آفرید"
  },
  {
    "poem_id": 87974,
    "vorder": 13,
    "position": 0,
    "text": "ازویست پیروزی و زو شکیب"
  },
  {
    "poem_id": 87974,
    "vorder": 14,
    "position": 1,
    "text": "بنیک و ببد زو رسد کام و زیب"
  },
  {
    "poem_id": 87974,
    "vorder": 15,
    "position": 0,
    "text": "خرد داد و جان و تن زورمند"
  },
  {
    "poem_id": 87974,
    "vorder": 16,
    "position": 1,
    "text": "بزرگی و دیهیم و تخت بلند"
  },
  {
    "poem_id": 87974,
    "vorder": 17,
    "position": 0,
    "text": "رهایی نیابد سر از بند اوی"
  },
  {
    "poem_id": 87974,
    "vorder": 18,
    "position": 1,
    "text": "یکی را همه فر و اورند اوی"
  },
  {
    "poem_id": 87974,
    "vorder": 19,
    "position": 0,
    "text": "یکی را دگر شوربختی دهد"
  },
  {
    "poem_id": 87974,
    "vorder": 20,
    "position": 1,
    "text": "نیاز و غم و درد و سختی دهد"
  },
  {
    "poem_id": 87974,
    "vorder": 21,
    "position": 0,
    "text": "ز رخشنده خورشید تا تیره خاک"
  },
  {
    "poem_id": 87974,
    "vorder": 22,
    "position": 1,
    "text": "همه داد بینم ز یزدان پاک"
  },
  {
    "poem_id": 87974,
    "vorder": 23,
    "position": 0,
    "text": "بشد طوس با کاویانی درفش"
  },
  {
    "poem_id": 87974,
    "vorder": 24,
    "position": 1,
    "text": "ز لشکر چهل مرد زرینه کفش"
  },
  {
    "poem_id": 87974,
    "vorder": 25,
    "position": 0,
    "text": "بتوران فرستادمش با سپاه"
  },
  {
    "poem_id": 87974,
    "vorder": 26,
    "position": 1,
    "text": "برادر شد از کین نخستین تباه"
  },
  {
    "poem_id": 87974,
    "vorder": 27,
    "position": 0,
    "text": "بایران چنو هیچ مهتر مباد"
  },
  {
    "poem_id": 87974,
    "vorder": 28,
    "position": 1,
    "text": "وزین گونه سالار لشکر مباد"
  },
  {
    "poem_id": 87974,
    "vorder": 29,
    "position": 0,
    "text": "دریغا برادر فرود جوان"
  },
  {
    "poem_id": 87974,
    "vorder": 30,
    "position": 1,
    "text": "سر نامداران و پشت گوان"
  },
  {
    "poem_id": 87974,
    "vorder": 31,
    "position": 0,
    "text": "ز کین پدر زار و گریان بدم"
  },
  {
    "poem_id": 87974,
    "vorder": 32,
    "position": 1,
    "text": "بران درد یک چند بریان بدم"
  },
  {
    "poem_id": 87974,
    "vorder": 33,
    "position": 0,
    "text": "کنون بر برادر بباید گریست"
  },
  {
    "poem_id": 87974,
    "vorder": 34,
    "position": 1,
    "text": "ندانم مرا دشمن و دوست کیست"
  },
  {
    "poem_id": 87974,
    "vorder": 35,
    "position": 0,
    "text": "مرو گفتم او را براه چرم"
  },
  {
    "poem_id": 87974,
    "vorder": 36,
    "position": 1,
    "text": "مزن بر کلات و سپدکوه دم"
  },
  {
    "poem_id": 87974,
    "vorder": 37,
    "position": 0,
    "text": "بران ره فرودست و با لشکرست"
  },
  {
    "poem_id": 87974,
    "vorder": 38,
    "position": 1,
    "text": "همان کی نژاد است و کنداور است"
  },
  {
    "poem_id": 87974,
    "vorder": 39,
    "position": 0,
    "text": "نداند که این لشکر از بن کیند"
  },
  {
    "poem_id": 87974,
    "vorder": 40,
    "position": 1,
    "text": "از ایران سپاهند گر خود چیند"
  },
  {
    "poem_id": 87974,
    "vorder": 41,
    "position": 0,
    "text": "ازان کوه جنگ آورد بی‌گمان"
  },
  {
    "poem_id": 87974,
    "vorder": 42,
    "position": 1,
    "text": "فراوان سران را سرآرد زمان"
  },
  {
    "poem_id": 87974,
    "vorder": 43,
    "position": 0,
    "text": "دریغ آنچنان گرد خسرونژاد"
  },
  {
    "poem_id": 87974,
    "vorder": 44,
    "position": 1,
    "text": "که طوس فرومایه دادش بباد"
  },
  {
    "poem_id": 87974,
    "vorder": 45,
    "position": 0,
    "text": "اگر پیش از این او سپهبد بدست"
  },
  {
    "poem_id": 87974,
    "vorder": 46,
    "position": 1,
    "text": "ز کاوس شاه اختر بد بدست"
  },
  {
    "poem_id": 87974,
    "vorder": 47,
    "position": 0,
    "text": "برزم اندرون نیز خواب آیدش"
  },
  {
    "poem_id": 87974,
    "vorder": 48,
    "position": 1,
    "text": "چو بی می‌نشیند شتاب آیدش"
  },
  {
    "poem_id": 87974,
    "vorder": 49,
    "position": 0,
    "text": "هنرها همه هست نزدیک اوی"
  },
  {
    "poem_id": 87974,
    "vorder": 50,
    "position": 1,
    "text": "مبادا چنان جان تاریک اوی"
  },
  {
    "poem_id": 87974,
    "vorder": 51,
    "position": 0,
    "text": "چو این نامه خوانی هم‌اندر شتاب"
  },
  {
    "poem_id": 87974,
    "vorder": 52,
    "position": 1,
    "text": "ز دل دور کن خورد آرام و خواب"
  },
  {
    "poem_id": 87974,
    "vorder": 53,
    "position": 0,
    "text": "سبک طوس را بازگردان بجای"
  },
  {
    "poem_id": 87974,
    "vorder": 54,
    "position": 1,
    "text": "ز فرمان مگرد و مزن هیچ رای"
  },
  {
    "poem_id": 87974,
    "vorder": 55,
    "position": 0,
    "text": "سپهدار و سالار زرینه کفش"
  },
  {
    "poem_id": 87974,
    "vorder": 56,
    "position": 1,
    "text": "تو می باش با کاویانی درفش"
  },
  {
    "poem_id": 87974,
    "vorder": 57,
    "position": 0,
    "text": "سرافراز گودرز ازان انجمن"
  },
  {
    "poem_id": 87974,
    "vorder": 58,
    "position": 1,
    "text": "بهر کار باشد ترا رای زن"
  },
  {
    "poem_id": 87974,
    "vorder": 59,
    "position": 0,
    "text": "مکن هیچ در جنگ جستن شتاب"
  },
  {
    "poem_id": 87974,
    "vorder": 60,
    "position": 1,
    "text": "ز می دور باش و مپیمای خواب"
  },
  {
    "poem_id": 87974,
    "vorder": 61,
    "position": 0,
    "text": "بتندی مجو ایچ رزم از نخست"
  },
  {
    "poem_id": 87974,
    "vorder": 62,
    "position": 1,
    "text": "همی باش تا خسته گردد درست"
  },
  {
    "poem_id": 87974,
    "vorder": 63,
    "position": 0,
    "text": "ترا پیش رو گیو باشد بجنگ"
  },
  {
    "poem_id": 87974,
    "vorder": 64,
    "position": 1,
    "text": "که با فر و برزست و چنگ پلنگ"
  },
  {
    "poem_id": 87974,
    "vorder": 65,
    "position": 0,
    "text": "فرازآور از هر سوی ساز رزم"
  },
  {
    "poem_id": 87974,
    "vorder": 66,
    "position": 1,
    "text": "مبادا که آید ترا رای بزم"
  },
  {
    "poem_id": 87974,
    "vorder": 67,
    "position": 0,
    "text": "نهاد از بر نامه بر مهر شاه"
  },
  {
    "poem_id": 87974,
    "vorder": 68,
    "position": 1,
    "text": "فرستاده را گفت برکش براه"
  },
  {
    "poem_id": 87974,
    "vorder": 69,
    "position": 0,
    "text": "ز رفتن شب و روز ماسای هیچ"
  },
  {
    "poem_id": 87974,
    "vorder": 70,
    "position": 1,
    "text": "بهر منزلی اسپ دیگر بسیچ"
  },
  {
    "poem_id": 87974,
    "vorder": 71,
    "position": 0,
    "text": "بیامد فرستاده هم زین نشان"
  },
  {
    "poem_id": 87974,
    "vorder": 72,
    "position": 1,
    "text": "بنزدیک آن نامور سرکشان"
  },
  {
    "poem_id": 87974,
    "vorder": 73,
    "position": 0,
    "text": "بنزد فریبرز شد نامه دار"
  },
  {
    "poem_id": 87974,
    "vorder": 74,
    "position": 1,
    "text": "بدو داد پس نامهٔ شهریار"
  },
  {
    "poem_id": 87974,
    "vorder": 75,
    "position": 0,
    "text": "فریبرز طوس و یلان را بخواند"
  },
  {
    "poem_id": 87974,
    "vorder": 76,
    "position": 1,
    "text": "ز کار گذشته فراوان براند"
  },
  {
    "poem_id": 87974,
    "vorder": 77,
    "position": 0,
    "text": "همان نامور گیو و گودرز را"
  },
  {
    "poem_id": 87974,
    "vorder": 78,
    "position": 1,
    "text": "سواران و گردان آن مرز را"
  },
  {
    "poem_id": 87974,
    "vorder": 79,
    "position": 0,
    "text": "چو برخواند آن نامهٔ شهریار"
  },
  {
    "poem_id": 87974,
    "vorder": 80,
    "position": 1,
    "text": "جهان را درختی نو آمد ببار"
  },
  {
    "poem_id": 87974,
    "vorder": 81,
    "position": 0,
    "text": "بزرگان و شیران ایران زمین"
  },
  {
    "poem_id": 87974,
    "vorder": 82,
    "position": 1,
    "text": "همه شاه را خواندند آفرین"
  },
  {
    "poem_id": 87974,
    "vorder": 83,
    "position": 0,
    "text": "بیاورد طوس آن گرامی درفش"
  },
  {
    "poem_id": 87974,
    "vorder": 84,
    "position": 1,
    "text": "ابا کوس و پیلان و زرینه کفش"
  },
  {
    "poem_id": 87974,
    "vorder": 85,
    "position": 0,
    "text": "بنزد فریبرز بردند و گفت"
  },
  {
    "poem_id": 87974,
    "vorder": 86,
    "position": 1,
    "text": "که آمد سزا را سزاوار جفت"
  },
  {
    "poem_id": 87974,
    "vorder": 87,
    "position": 0,
    "text": "همه ساله بخت تو پیروز باد"
  },
  {
    "poem_id": 87974,
    "vorder": 88,
    "position": 1,
    "text": "همه روزگار تو نوروز باد"
  },
  {
    "poem_id": 87974,
    "vorder": 89,
    "position": 0,
    "text": "برفت و ببرد آنک بد نوذری"
  },
  {
    "poem_id": 87974,
    "vorder": 90,
    "position": 1,
    "text": "سواران جنگ‌آور و لشکری"
  },
  {
    "poem_id": 87974,
    "vorder": 91,
    "position": 0,
    "text": "بنزدیک شاه آمد از دشت جنگ"
  },
  {
    "poem_id": 87974,
    "vorder": 92,
    "position": 1,
    "text": "بره‌بر نکرد ایچ‌گونه درنگ"
  },
  {
    "poem_id": 87974,
    "vorder": 93,
    "position": 0,
    "text": "زمین را ببوسید در پیش شاه"
  },
  {
    "poem_id": 87974,
    "vorder": 94,
    "position": 1,
    "text": "نکرد ایچ خسرو بدو در نگاه"
  },
  {
    "poem_id": 87974,
    "vorder": 95,
    "position": 0,
    "text": "بدشنام بگشاد لب شهریار"
  },
  {
    "poem_id": 87974,
    "vorder": 96,
    "position": 1,
    "text": "بران انجمن طوس را کرد خوار"
  },
  {
    "poem_id": 87974,
    "vorder": 97,
    "position": 0,
    "text": "ازان پس بدو گفت کای بدنشان"
  },
  {
    "poem_id": 87974,
    "vorder": 98,
    "position": 1,
    "text": "که کمباد نامت ز گردنکشان"
  },
  {
    "poem_id": 87974,
    "vorder": 99,
    "position": 0,
    "text": "نترسی همی از جهاندار پاک"
  },
  {
    "poem_id": 87974,
    "vorder": 100,
    "position": 1,
    "text": "ز گردان نیامد ترا شرم و باک"
  },
  {
    "poem_id": 87974,
    "vorder": 101,
    "position": 0,
    "text": "نگفتم مرو سوی راه چرم"
  },
  {
    "poem_id": 87974,
    "vorder": 102,
    "position": 1,
    "text": "برفتی و دادی دل من به غم"
  },
  {
    "poem_id": 87974,
    "vorder": 103,
    "position": 0,
    "text": "نخستین بکین من آراستی"
  },
  {
    "poem_id": 87974,
    "vorder": 104,
    "position": 1,
    "text": "نژاد سیاوش را کاستی"
  },
  {
    "poem_id": 87974,
    "vorder": 105,
    "position": 0,
    "text": "برادر سرافراز جنگی فرود"
  },
  {
    "poem_id": 87974,
    "vorder": 106,
    "position": 1,
    "text": "کجا هم چنو در زمانه نبود"
  },
  {
    "poem_id": 87974,
    "vorder": 107,
    "position": 0,
    "text": "بکشتی کسی را که در کارزار"
  },
  {
    "poem_id": 87974,
    "vorder": 108,
    "position": 1,
    "text": "چو تو لشکری خواستی روزکار"
  },
  {
    "poem_id": 87974,
    "vorder": 109,
    "position": 0,
    "text": "وزان پس که رفتی بران رزمگاه"
  },
  {
    "poem_id": 87974,
    "vorder": 110,
    "position": 1,
    "text": "نبودت به جز رامش و بزمگاه"
  },
  {
    "poem_id": 87974,
    "vorder": 111,
    "position": 0,
    "text": "ترا جایگه نیست در شارستان"
  },
  {
    "poem_id": 87974,
    "vorder": 112,
    "position": 1,
    "text": "بزیبد ترا بند و بیمارستان"
  },
  {
    "poem_id": 87974,
    "vorder": 113,
    "position": 0,
    "text": "ترا پیش آزادگان کار نیست"
  },
  {
    "poem_id": 87974,
    "vorder": 114,
    "position": 1,
    "text": "کجا مر ترا رای هشیار نیست"
  },
  {
    "poem_id": 87974,
    "vorder": 115,
    "position": 0,
    "text": "سزاوار مسماری و بند و غل"
  },
  {
    "poem_id": 87974,
    "vorder": 116,
    "position": 1,
    "text": "نه اندر خور تاج و دیهیم و مل"
  },
  {
    "poem_id": 87974,
    "vorder": 117,
    "position": 0,
    "text": "نژاد منوچهر و ریش سپید"
  },
  {
    "poem_id": 87974,
    "vorder": 118,
    "position": 1,
    "text": "ترا داد بر زندگانی امید"
  },
  {
    "poem_id": 87974,
    "vorder": 119,
    "position": 0,
    "text": "وگرنه بفرمودمی تا سرت"
  },
  {
    "poem_id": 87974,
    "vorder": 120,
    "position": 1,
    "text": "بداندیش کردی جدا از برت"
  },
  {
    "poem_id": 87974,
    "vorder": 121,
    "position": 0,
    "text": "برو جاودان خانه زندان توست"
  },
  {
    "poem_id": 87974,
    "vorder": 122,
    "position": 1,
    "text": "همان گوهر بد نگهبان توست"
  },
  {
    "poem_id": 87974,
    "vorder": 123,
    "position": 0,
    "text": "ز پیشش براند و بفرمود بند"
  },
  {
    "poem_id": 87974,
    "vorder": 124,
    "position": 1,
    "text": "به بند از دلش بیخ شادی بکند"
  }
]