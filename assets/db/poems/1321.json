[
  {
    "poem_id": 1321,
    "vorder": 1,
    "position": 0,
    "text": "به نام خداوند جان و خرد"
  },
  {
    "poem_id": 1321,
    "vorder": 2,
    "position": 1,
    "text": "کز این برتر اندیشه بر نگذرد"
  },
  {
    "poem_id": 1321,
    "vorder": 3,
    "position": 0,
    "text": "خداوندِ نام و خداوندِ جای"
  },
  {
    "poem_id": 1321,
    "vorder": 4,
    "position": 1,
    "text": "خداوندِ روزی‌دِهِ رهنمای"
  },
  {
    "poem_id": 1321,
    "vorder": 5,
    "position": 0,
    "text": "خداوند کیوان و گَردان‌سپهر"
  },
  {
    "poem_id": 1321,
    "vorder": 6,
    "position": 1,
    "text": "فروزندهٔ ماه و ناهید و مهر"
  },
  {
    "poem_id": 1321,
    "vorder": 7,
    "position": 0,
    "text": "ز نام و نشان و گمان برتر است"
  },
  {
    "poem_id": 1321,
    "vorder": 8,
    "position": 1,
    "text": "نگارندهٔ برشده پیکر است"
  },
  {
    "poem_id": 1321,
    "vorder": 9,
    "position": 0,
    "text": "به بینندگان آفریننده را"
  },
  {
    "poem_id": 1321,
    "vorder": 10,
    "position": 1,
    "text": "نبینی مرنجان دو بیننده را"
  },
  {
    "poem_id": 1321,
    "vorder": 11,
    "position": 0,
    "text": "نیابد بدو نیز اندیشه راه"
  },
  {
    "poem_id": 1321,
    "vorder": 12,
    "position": 1,
    "text": "که او برتر از نام و از جایگاه"
  },
  {
    "poem_id": 1321,
    "vorder": 13,
    "position": 0,
    "text": "سخن هر چه زین گوهران بگذرد"
  },
  {
    "poem_id": 1321,
    "vorder": 14,
    "position": 1,
    "text": "نیابد بدو راه جان و خرد"
  },
  {
    "poem_id": 1321,
    "vorder": 15,
    "position": 0,
    "text": "خرد گر سخن برگزیند همی"
  },
  {
    "poem_id": 1321,
    "vorder": 16,
    "position": 1,
    "text": "همان را گزیند که بیند همی"
  },
  {
    "poem_id": 1321,
    "vorder": 17,
    "position": 0,
    "text": "ستودن نداند کس او را چو هست"
  },
  {
    "poem_id": 1321,
    "vorder": 18,
    "position": 1,
    "text": "میانْ بندگی را ببایدْت بست"
  },
  {
    "poem_id": 1321,
    "vorder": 19,
    "position": 0,
    "text": "خرد را و جان را همی‌سَنجد اوی"
  },
  {
    "poem_id": 1321,
    "vorder": 20,
    "position": 1,
    "text": "در اندیشهٔ سَخته کِی گُنجد اوی؟"
  },
  {
    "poem_id": 1321,
    "vorder": 21,
    "position": 0,
    "text": "بدین آلت رای و جان و زبان"
  },
  {
    "poem_id": 1321,
    "vorder": 22,
    "position": 1,
    "text": "ستود آفریننده را کِی توان؟"
  },
  {
    "poem_id": 1321,
    "vorder": 23,
    "position": 0,
    "text": "به هستیش باید که خستو شوی"
  },
  {
    "poem_id": 1321,
    "vorder": 24,
    "position": 1,
    "text": "ز گفتار بیکار یکسو شوی"
  },
  {
    "poem_id": 1321,
    "vorder": 25,
    "position": 0,
    "text": "پرستنده باشیّ و جوینده راه"
  },
  {
    "poem_id": 1321,
    "vorder": 26,
    "position": 1,
    "text": "به ژرفی به فرمانْش کردن نگاه"
  },
  {
    "poem_id": 1321,
    "vorder": 27,
    "position": 0,
    "text": "توانا بود هر که دانا بود"
  },
  {
    "poem_id": 1321,
    "vorder": 28,
    "position": 1,
    "text": "ز دانش دل پیر برنا بود"
  },
  {
    "poem_id": 1321,
    "vorder": 29,
    "position": 0,
    "text": "از این پرده برتر سخن‌گاه نیست"
  },
  {
    "poem_id": 1321,
    "vorder": 30,
    "position": 1,
    "text": "ز هستی مر اندیشه را راه نیست"
  }
]