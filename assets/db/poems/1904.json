[
  {
    "poem_id": 1904,
    "vorder": 1,
    "position": 0,
    "text": "کنون داستان گوی در داستان"
  },
  {
    "poem_id": 1904,
    "vorder": 2,
    "position": 1,
    "text": "ازان یک دل ویک زبان راستان"
  },
  {
    "poem_id": 1904,
    "vorder": 3,
    "position": 0,
    "text": "ز تختی که خوانی ورا طاق دیس"
  },
  {
    "poem_id": 1904,
    "vorder": 4,
    "position": 1,
    "text": "که بنهاد پرویز دراسپریس"
  },
  {
    "poem_id": 1904,
    "vorder": 5,
    "position": 0,
    "text": "سرمایهٔ آن ز ضحاک بود"
  },
  {
    "poem_id": 1904,
    "vorder": 6,
    "position": 1,
    "text": "که ناپارسا بود و ناپاک بود"
  },
  {
    "poem_id": 1904,
    "vorder": 7,
    "position": 0,
    "text": "بگاهی که رفت آفریدون گرد"
  },
  {
    "poem_id": 1904,
    "vorder": 8,
    "position": 1,
    "text": "وزان تازیان نام مردی ببرد"
  },
  {
    "poem_id": 1904,
    "vorder": 9,
    "position": 0,
    "text": "یکی مرد بد در دماوند کوه"
  },
  {
    "poem_id": 1904,
    "vorder": 10,
    "position": 1,
    "text": "که شاهش جدا داشتی ازگروه"
  },
  {
    "poem_id": 1904,
    "vorder": 11,
    "position": 0,
    "text": "کجا جهن برزین بدی نام اوی"
  },
  {
    "poem_id": 1904,
    "vorder": 12,
    "position": 1,
    "text": "رسیده بهر کشوری کام اوی"
  },
  {
    "poem_id": 1904,
    "vorder": 13,
    "position": 0,
    "text": "یکی نامور شاه را تخت ساخت"
  },
  {
    "poem_id": 1904,
    "vorder": 14,
    "position": 1,
    "text": "گهر گرد بر گرد او در نشاخت"
  },
  {
    "poem_id": 1904,
    "vorder": 15,
    "position": 0,
    "text": "که شاه آفریدون بدوشاد بود"
  },
  {
    "poem_id": 1904,
    "vorder": 16,
    "position": 1,
    "text": "که آن تخت پرمایه آزاد بود"
  },
  {
    "poem_id": 1904,
    "vorder": 17,
    "position": 0,
    "text": "درم داد مر جهن را سی‌هزار"
  },
  {
    "poem_id": 1904,
    "vorder": 18,
    "position": 1,
    "text": "یکی تاج زرین و دو گوشوار"
  },
  {
    "poem_id": 1904,
    "vorder": 19,
    "position": 0,
    "text": "همان عهد ساری و آمل نوشت"
  },
  {
    "poem_id": 1904,
    "vorder": 20,
    "position": 1,
    "text": "که بد مرز منشور او چون بهشت"
  },
  {
    "poem_id": 1904,
    "vorder": 21,
    "position": 0,
    "text": "بدانگه که ایران به ایرج رسید"
  },
  {
    "poem_id": 1904,
    "vorder": 22,
    "position": 1,
    "text": "کزان نامداران وی آمد پدید"
  },
  {
    "poem_id": 1904,
    "vorder": 23,
    "position": 0,
    "text": "جهاندار شاه آفریدون سه چیز"
  },
  {
    "poem_id": 1904,
    "vorder": 24,
    "position": 1,
    "text": "بران پادشاهی برافزود نیز"
  },
  {
    "poem_id": 1904,
    "vorder": 25,
    "position": 0,
    "text": "یکی تخت و آن گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1904,
    "vorder": 26,
    "position": 1,
    "text": "که ماندست زو در جهان یادگار"
  },
  {
    "poem_id": 1904,
    "vorder": 27,
    "position": 0,
    "text": "سدیگر کجا هفت چشمه گهر"
  },
  {
    "poem_id": 1904,
    "vorder": 28,
    "position": 1,
    "text": "همی‌خواندی نام او دادگر"
  },
  {
    "poem_id": 1904,
    "vorder": 29,
    "position": 0,
    "text": "چو ایرج بشد زو بماند این سه چیز"
  },
  {
    "poem_id": 1904,
    "vorder": 30,
    "position": 1,
    "text": "همان شاد بد زو منوچهر نیز"
  },
  {
    "poem_id": 1904,
    "vorder": 31,
    "position": 0,
    "text": "هر آنکس که او تاج شاهی بسود"
  },
  {
    "poem_id": 1904,
    "vorder": 32,
    "position": 1,
    "text": "بران تخت چیزی همی‌برفزود"
  },
  {
    "poem_id": 1904,
    "vorder": 33,
    "position": 0,
    "text": "چو آمد به کیخسرو نیک بخت"
  },
  {
    "poem_id": 1904,
    "vorder": 34,
    "position": 1,
    "text": "فراوان بیفزود بالای تخت"
  },
  {
    "poem_id": 1904,
    "vorder": 35,
    "position": 0,
    "text": "برین هم نشان تا به لهراسپ شد"
  },
  {
    "poem_id": 1904,
    "vorder": 36,
    "position": 1,
    "text": "وزو همچنان تا به گشتاسپ شد"
  },
  {
    "poem_id": 1904,
    "vorder": 37,
    "position": 0,
    "text": "چو گشتاسپ آن تخت رادید گفت"
  },
  {
    "poem_id": 1904,
    "vorder": 38,
    "position": 1,
    "text": "که کار بزرگان نشاید نهفت"
  },
  {
    "poem_id": 1904,
    "vorder": 39,
    "position": 0,
    "text": "به جاماسپ گفت ای گرانمایه مرد"
  },
  {
    "poem_id": 1904,
    "vorder": 40,
    "position": 1,
    "text": "فزونی چه داری به دین کارکرد"
  },
  {
    "poem_id": 1904,
    "vorder": 41,
    "position": 0,
    "text": "یکایک ببین تا چه خواهی فزود"
  },
  {
    "poem_id": 1904,
    "vorder": 42,
    "position": 1,
    "text": "پس از مرگ ما راکه خواهد ستود"
  },
  {
    "poem_id": 1904,
    "vorder": 43,
    "position": 0,
    "text": "چو جا ماسپ آن تخت رابنگرید"
  },
  {
    "poem_id": 1904,
    "vorder": 44,
    "position": 1,
    "text": "بدید از در گنج دانش کلید"
  },
  {
    "poem_id": 1904,
    "vorder": 45,
    "position": 0,
    "text": "برو بر شمار سپهر بلند"
  },
  {
    "poem_id": 1904,
    "vorder": 46,
    "position": 1,
    "text": "همی‌کرد پیدا چه و چون وچند"
  },
  {
    "poem_id": 1904,
    "vorder": 47,
    "position": 0,
    "text": "ز کیوان همه نقشها تا به ماه"
  },
  {
    "poem_id": 1904,
    "vorder": 48,
    "position": 1,
    "text": "بران تخت کرد او به فرمان شاه"
  },
  {
    "poem_id": 1904,
    "vorder": 49,
    "position": 0,
    "text": "چنین تابگاه سکندر رسید"
  },
  {
    "poem_id": 1904,
    "vorder": 50,
    "position": 1,
    "text": "ز شاهان هر آنکس که آن گاه دید"
  },
  {
    "poem_id": 1904,
    "vorder": 51,
    "position": 0,
    "text": "همی‌برفزودی برو چند چیز"
  },
  {
    "poem_id": 1904,
    "vorder": 52,
    "position": 1,
    "text": "ز زر و ز سیم و ز عاج و ز شیز"
  },
  {
    "poem_id": 1904,
    "vorder": 53,
    "position": 0,
    "text": "مر آن را سکندر همه پاره کرد"
  },
  {
    "poem_id": 1904,
    "vorder": 54,
    "position": 1,
    "text": "ز بی دانشی کار یکباره کرد"
  },
  {
    "poem_id": 1904,
    "vorder": 55,
    "position": 0,
    "text": "بسی از بزرگان نهان داشتند"
  },
  {
    "poem_id": 1904,
    "vorder": 56,
    "position": 1,
    "text": "همی دست بر دست بگذاشتند"
  },
  {
    "poem_id": 1904,
    "vorder": 57,
    "position": 0,
    "text": "بدین گونه بد تا سر اردشیر"
  },
  {
    "poem_id": 1904,
    "vorder": 58,
    "position": 1,
    "text": "کجا گشته بد نام آن تخت پیر"
  },
  {
    "poem_id": 1904,
    "vorder": 59,
    "position": 0,
    "text": "ازان تخت جایی نشانی نیافت"
  },
  {
    "poem_id": 1904,
    "vorder": 60,
    "position": 1,
    "text": "بران آرزو سوی دیگر شتاف"
  },
  {
    "poem_id": 1904,
    "vorder": 61,
    "position": 0,
    "text": "بمرد او و آن تخت ازو بازماند"
  },
  {
    "poem_id": 1904,
    "vorder": 62,
    "position": 1,
    "text": "ازان پس که کام بزرگی براند"
  },
  {
    "poem_id": 1904,
    "vorder": 63,
    "position": 0,
    "text": "بدین گونه بد تا به پرویزشاه"
  },
  {
    "poem_id": 1904,
    "vorder": 64,
    "position": 1,
    "text": "رسید آن گرامی سزاوار گاه"
  },
  {
    "poem_id": 1904,
    "vorder": 65,
    "position": 0,
    "text": "ز هر کشوری مهتران رابخواند"
  },
  {
    "poem_id": 1904,
    "vorder": 66,
    "position": 1,
    "text": "وزان تخت چندی سخنها براند"
  },
  {
    "poem_id": 1904,
    "vorder": 67,
    "position": 0,
    "text": "ازیشان فراوان شکسته بیافت"
  },
  {
    "poem_id": 1904,
    "vorder": 68,
    "position": 1,
    "text": "به شادی سوی گرد کردن شتافت"
  },
  {
    "poem_id": 1904,
    "vorder": 69,
    "position": 0,
    "text": "بیاورد پس تخت شاه اردشیر"
  },
  {
    "poem_id": 1904,
    "vorder": 70,
    "position": 1,
    "text": "ز ایران هر آنکس که بد تیزویر"
  },
  {
    "poem_id": 1904,
    "vorder": 71,
    "position": 0,
    "text": "بهم بر زدند آن سزاوار تخت"
  },
  {
    "poem_id": 1904,
    "vorder": 72,
    "position": 1,
    "text": "به هنگام آن شاه پیروزبخت"
  },
  {
    "poem_id": 1904,
    "vorder": 73,
    "position": 0,
    "text": "ورا درگر آمد ز روم و ز چین"
  },
  {
    "poem_id": 1904,
    "vorder": 74,
    "position": 1,
    "text": "ز مکران و بغداد و ایران زمین"
  },
  {
    "poem_id": 1904,
    "vorder": 75,
    "position": 0,
    "text": "هزار و صد و بیست استاد بود"
  },
  {
    "poem_id": 1904,
    "vorder": 76,
    "position": 1,
    "text": "که کردار آن تختشان یادبود"
  },
  {
    "poem_id": 1904,
    "vorder": 77,
    "position": 0,
    "text": "که او را بنا شاه گشتاسپ کرد"
  },
  {
    "poem_id": 1904,
    "vorder": 78,
    "position": 1,
    "text": "برای و به تدبیر جاماسپ کرد"
  },
  {
    "poem_id": 1904,
    "vorder": 79,
    "position": 0,
    "text": "ابا هریکی مرد شاگرد سی"
  },
  {
    "poem_id": 1904,
    "vorder": 80,
    "position": 1,
    "text": "ز رومی و بغدادی و پارسی"
  },
  {
    "poem_id": 1904,
    "vorder": 81,
    "position": 0,
    "text": "نفرمود تا یک زمان دم زدند"
  },
  {
    "poem_id": 1904,
    "vorder": 82,
    "position": 1,
    "text": "بدو سال تا تخت برهم زدند"
  },
  {
    "poem_id": 1904,
    "vorder": 83,
    "position": 0,
    "text": "چوبر پای کردند تخت بلند"
  },
  {
    "poem_id": 1904,
    "vorder": 84,
    "position": 1,
    "text": "درخشنده شد روی بخت بلند"
  },
  {
    "poem_id": 1904,
    "vorder": 85,
    "position": 0,
    "text": "برش بود بالای صد شاه رش"
  },
  {
    "poem_id": 1904,
    "vorder": 86,
    "position": 1,
    "text": "چو هفتاد رش برنهی ازبرش"
  },
  {
    "poem_id": 1904,
    "vorder": 87,
    "position": 0,
    "text": "صد و بیست رش نیز پهناش بود"
  },
  {
    "poem_id": 1904,
    "vorder": 88,
    "position": 1,
    "text": "که پهناش کمتر ز بالاش بود"
  },
  {
    "poem_id": 1904,
    "vorder": 89,
    "position": 0,
    "text": "بلندیش پنجاه و صد شاه رش"
  },
  {
    "poem_id": 1904,
    "vorder": 90,
    "position": 1,
    "text": "چنان بد که بر ابر سودی سرش"
  },
  {
    "poem_id": 1904,
    "vorder": 91,
    "position": 0,
    "text": "همان شاه رش هر رشی زو سه رش"
  },
  {
    "poem_id": 1904,
    "vorder": 92,
    "position": 1,
    "text": "کزان سر بدیدی بن کشورش"
  },
  {
    "poem_id": 1904,
    "vorder": 93,
    "position": 0,
    "text": "بسی روز در ماه هر بامداد"
  },
  {
    "poem_id": 1904,
    "vorder": 94,
    "position": 1,
    "text": "یکی فرش بودی به دیگر نهاد"
  },
  {
    "poem_id": 1904,
    "vorder": 95,
    "position": 0,
    "text": "همان تخت به دوازده لخت بود"
  },
  {
    "poem_id": 1904,
    "vorder": 96,
    "position": 1,
    "text": "جهانی سراسر همه تخت بود"
  },
  {
    "poem_id": 1904,
    "vorder": 97,
    "position": 0,
    "text": "برو بش زرین صد و چل هزار"
  },
  {
    "poem_id": 1904,
    "vorder": 98,
    "position": 1,
    "text": "ز پیروزه بر زر کرده نگار"
  },
  {
    "poem_id": 1904,
    "vorder": 99,
    "position": 0,
    "text": "همه نقرهٔ خام بد میخ بش"
  },
  {
    "poem_id": 1904,
    "vorder": 100,
    "position": 1,
    "text": "یکی صد به مثقال با شست و شش"
  },
  {
    "poem_id": 1904,
    "vorder": 101,
    "position": 0,
    "text": "چو اندر بره خور نهادی چراغ"
  },
  {
    "poem_id": 1904,
    "vorder": 102,
    "position": 1,
    "text": "پسش دشت بودی و در پیش باغ"
  },
  {
    "poem_id": 1904,
    "vorder": 103,
    "position": 0,
    "text": "چوخورشید درشیرگشتی درشت"
  },
  {
    "poem_id": 1904,
    "vorder": 104,
    "position": 1,
    "text": "مرآن تخت را سوی او بود پشت"
  },
  {
    "poem_id": 1904,
    "vorder": 105,
    "position": 0,
    "text": "چو هنگامهٔ تیر ماه آمدی"
  },
  {
    "poem_id": 1904,
    "vorder": 106,
    "position": 1,
    "text": "گه میوه و جشنگاه آمدی"
  },
  {
    "poem_id": 1904,
    "vorder": 107,
    "position": 0,
    "text": "سوی میوه و باغ بودیش روی"
  },
  {
    "poem_id": 1904,
    "vorder": 108,
    "position": 1,
    "text": "بدان تا بیابد زهرمیوه بوی"
  },
  {
    "poem_id": 1904,
    "vorder": 109,
    "position": 0,
    "text": "زمستان که بودی گه باد و نم"
  },
  {
    "poem_id": 1904,
    "vorder": 110,
    "position": 1,
    "text": "بر آن تخت برکس نبودی دژم"
  },
  {
    "poem_id": 1904,
    "vorder": 111,
    "position": 0,
    "text": "همه طاقها بود بسته ازار"
  },
  {
    "poem_id": 1904,
    "vorder": 112,
    "position": 1,
    "text": "ز خز و سمور از در شهریار"
  },
  {
    "poem_id": 1904,
    "vorder": 113,
    "position": 0,
    "text": "همان گوی زرین و سیمین هزار"
  },
  {
    "poem_id": 1904,
    "vorder": 114,
    "position": 1,
    "text": "بر آتش همی‌تافتی جامه‌دار"
  },
  {
    "poem_id": 1904,
    "vorder": 115,
    "position": 0,
    "text": "به مثقال ازان هریکی پانصد"
  },
  {
    "poem_id": 1904,
    "vorder": 116,
    "position": 1,
    "text": "کز آتش شدی سرخ همچون بسد"
  },
  {
    "poem_id": 1904,
    "vorder": 117,
    "position": 0,
    "text": "یکی نیمه زو اندر آتش بدی"
  },
  {
    "poem_id": 1904,
    "vorder": 118,
    "position": 1,
    "text": "دگر پیش گردان سرکش بدی"
  },
  {
    "poem_id": 1904,
    "vorder": 119,
    "position": 0,
    "text": "شمار ستاره ده و دو و هفت"
  },
  {
    "poem_id": 1904,
    "vorder": 120,
    "position": 1,
    "text": "همان ماه تابان ببرجی که رفت"
  },
  {
    "poem_id": 1904,
    "vorder": 121,
    "position": 0,
    "text": "چه زو ایستاده چه مانده بجا"
  },
  {
    "poem_id": 1904,
    "vorder": 122,
    "position": 1,
    "text": "بدیدی به چشم سر اخترگرا"
  },
  {
    "poem_id": 1904,
    "vorder": 123,
    "position": 0,
    "text": "ز شب نیز دیدی که چندی گذشت"
  },
  {
    "poem_id": 1904,
    "vorder": 124,
    "position": 1,
    "text": "سپهر از بر خاک بر چند گشت"
  },
  {
    "poem_id": 1904,
    "vorder": 125,
    "position": 0,
    "text": "ازان تختها چند زرین بدی"
  },
  {
    "poem_id": 1904,
    "vorder": 126,
    "position": 1,
    "text": "چه مایه ز زر گوهر آگین بدی"
  },
  {
    "poem_id": 1904,
    "vorder": 127,
    "position": 0,
    "text": "شمارش ندانست کردن کسی"
  },
  {
    "poem_id": 1904,
    "vorder": 128,
    "position": 1,
    "text": "اگر چند بودیش دانش بسی"
  },
  {
    "poem_id": 1904,
    "vorder": 129,
    "position": 0,
    "text": "هرآن گوهری کش بهاخوار بود"
  },
  {
    "poem_id": 1904,
    "vorder": 130,
    "position": 1,
    "text": "کمابیش هفتاد دینار بود"
  },
  {
    "poem_id": 1904,
    "vorder": 131,
    "position": 0,
    "text": "بسی نیز بگذشت بر هفتصد"
  },
  {
    "poem_id": 1904,
    "vorder": 132,
    "position": 1,
    "text": "همی‌گیر زین گونه از نیک و بد"
  },
  {
    "poem_id": 1904,
    "vorder": 133,
    "position": 0,
    "text": "بسی سرخ گوگرد بد کش بها"
  },
  {
    "poem_id": 1904,
    "vorder": 134,
    "position": 1,
    "text": "ندانست کس مایه و منتها"
  },
  {
    "poem_id": 1904,
    "vorder": 135,
    "position": 0,
    "text": "که روشن بدی در شب تیره چهر"
  },
  {
    "poem_id": 1904,
    "vorder": 136,
    "position": 1,
    "text": "چوناهید رخشان شدی بر سپهر"
  },
  {
    "poem_id": 1904,
    "vorder": 137,
    "position": 0,
    "text": "دو تخت از بر تخت پرمایه بود"
  },
  {
    "poem_id": 1904,
    "vorder": 138,
    "position": 1,
    "text": "ز گوهر بسی مایه بر مایه بود"
  },
  {
    "poem_id": 1904,
    "vorder": 139,
    "position": 0,
    "text": "کهین تخت را نام بد میش سار"
  },
  {
    "poem_id": 1904,
    "vorder": 140,
    "position": 1,
    "text": "سر میش بودی برو بر نگار"
  },
  {
    "poem_id": 1904,
    "vorder": 141,
    "position": 0,
    "text": "مهین تخت راخواندی لاژورد"
  },
  {
    "poem_id": 1904,
    "vorder": 142,
    "position": 1,
    "text": "که هرگز نبودی برو باد و گرد"
  },
  {
    "poem_id": 1904,
    "vorder": 143,
    "position": 0,
    "text": "سه دیگر سراسر ز پیروزه بود"
  },
  {
    "poem_id": 1904,
    "vorder": 144,
    "position": 1,
    "text": "بدو هر که دیدیش دلسوزه بود"
  },
  {
    "poem_id": 1904,
    "vorder": 145,
    "position": 0,
    "text": "ازین تا بدان پایه بودی چهار"
  },
  {
    "poem_id": 1904,
    "vorder": 146,
    "position": 1,
    "text": "همه پایه زرین و گوهرنگار"
  },
  {
    "poem_id": 1904,
    "vorder": 147,
    "position": 0,
    "text": "هرآنکس که دهقان بد و زیردست"
  },
  {
    "poem_id": 1904,
    "vorder": 148,
    "position": 1,
    "text": "ورا میش سر بود جای نشست"
  },
  {
    "poem_id": 1904,
    "vorder": 149,
    "position": 0,
    "text": "سواران ناباک روز نبرد"
  },
  {
    "poem_id": 1904,
    "vorder": 150,
    "position": 1,
    "text": "شدندی بران گنبد لاژورد"
  },
  {
    "poem_id": 1904,
    "vorder": 151,
    "position": 0,
    "text": "به پیروزه بر جای دستور بود"
  },
  {
    "poem_id": 1904,
    "vorder": 152,
    "position": 1,
    "text": "که از کدخداییش رنجور بود"
  },
  {
    "poem_id": 1904,
    "vorder": 153,
    "position": 0,
    "text": "چو بر تخت پیروزه بودی نشست"
  },
  {
    "poem_id": 1904,
    "vorder": 154,
    "position": 1,
    "text": "خردمند بودی و مهترپرست"
  },
  {
    "poem_id": 1904,
    "vorder": 155,
    "position": 0,
    "text": "چو رفتی به دستوری رهنمای"
  },
  {
    "poem_id": 1904,
    "vorder": 156,
    "position": 1,
    "text": "مگر یافتی نزد پرویز جای"
  },
  {
    "poem_id": 1904,
    "vorder": 157,
    "position": 0,
    "text": "یکی جامه افکنده بد زربفت"
  },
  {
    "poem_id": 1904,
    "vorder": 158,
    "position": 1,
    "text": "برش بود وبالاش پنجاه و هفت"
  },
  {
    "poem_id": 1904,
    "vorder": 159,
    "position": 0,
    "text": "بگوهر همه ریشه‌ها بافته"
  },
  {
    "poem_id": 1904,
    "vorder": 160,
    "position": 1,
    "text": "زبر شوشهٔ زر برو تافته"
  },
  {
    "poem_id": 1904,
    "vorder": 161,
    "position": 0,
    "text": "بدو کرده پیدانشان سپهر"
  },
  {
    "poem_id": 1904,
    "vorder": 162,
    "position": 1,
    "text": "چو بهرام و کیوان و چون ماه و مهر"
  },
  {
    "poem_id": 1904,
    "vorder": 163,
    "position": 0,
    "text": "ز کیوان و تیر و ز گردنده ماه"
  },
  {
    "poem_id": 1904,
    "vorder": 164,
    "position": 1,
    "text": "پدیدار کرده ز هر دستگاه"
  },
  {
    "poem_id": 1904,
    "vorder": 165,
    "position": 0,
    "text": "هم از هفت کشور برو بر نشان"
  },
  {
    "poem_id": 1904,
    "vorder": 166,
    "position": 1,
    "text": "ز دهقان و از رزم گردنکشان"
  },
  {
    "poem_id": 1904,
    "vorder": 167,
    "position": 0,
    "text": "برو بر نشان چل و هشت شاه"
  },
  {
    "poem_id": 1904,
    "vorder": 168,
    "position": 1,
    "text": "پدیدار کرده سر تاج و گاه"
  },
  {
    "poem_id": 1904,
    "vorder": 169,
    "position": 0,
    "text": "برو بافته تاج شاهنشهان"
  },
  {
    "poem_id": 1904,
    "vorder": 170,
    "position": 1,
    "text": "چنان جامه هرگز نبد درجهان"
  },
  {
    "poem_id": 1904,
    "vorder": 171,
    "position": 0,
    "text": "به چین دریکی مرد بد بی‌همال"
  },
  {
    "poem_id": 1904,
    "vorder": 172,
    "position": 1,
    "text": "همی‌بافت آن جامه راهفت سال"
  },
  {
    "poem_id": 1904,
    "vorder": 173,
    "position": 0,
    "text": "سرسال نو هرمز فرودین"
  },
  {
    "poem_id": 1904,
    "vorder": 174,
    "position": 1,
    "text": "بیامد بر شاه ایران زمین"
  },
  {
    "poem_id": 1904,
    "vorder": 175,
    "position": 0,
    "text": "ببرد آن کیی فرش نزدیک شاه"
  },
  {
    "poem_id": 1904,
    "vorder": 176,
    "position": 1,
    "text": "گران مایگان برگرفتند راه"
  },
  {
    "poem_id": 1904,
    "vorder": 177,
    "position": 0,
    "text": "بگسترد روز نو آن جامه را"
  },
  {
    "poem_id": 1904,
    "vorder": 178,
    "position": 1,
    "text": "ز شادی جداکرد خودکامه را"
  },
  {
    "poem_id": 1904,
    "vorder": 179,
    "position": 0,
    "text": "بران جامه بر مجلس آراستند"
  },
  {
    "poem_id": 1904,
    "vorder": 180,
    "position": 1,
    "text": "نوازندهٔ رود و می خواستند"
  },
  {
    "poem_id": 1904,
    "vorder": 181,
    "position": 0,
    "text": "همی آفرین خواند سرکش به رود"
  },
  {
    "poem_id": 1904,
    "vorder": 182,
    "position": 1,
    "text": "شهنشاه را داد چندی درود"
  },
  {
    "poem_id": 1904,
    "vorder": 183,
    "position": 0,
    "text": "بزرگان برو گوهر افشاندند"
  },
  {
    "poem_id": 1904,
    "vorder": 184,
    "position": 1,
    "text": "که فرش بزرگش همی‌خواندند"
  }
]