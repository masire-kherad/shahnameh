[
  {
    "poem_id": 1442,
    "vorder": 1,
    "position": 0,
    "text": "چنین داد پاسخ به کاووس کی"
  },
  {
    "poem_id": 1442,
    "vorder": 2,
    "position": 1,
    "text": "که گر آب دریا بود نیز می"
  },
  {
    "poem_id": 1442,
    "vorder": 3,
    "position": 0,
    "text": "مرا بارگه زان تو برترست"
  },
  {
    "poem_id": 1442,
    "vorder": 4,
    "position": 1,
    "text": "هزاران هزارم فزون لشکرست"
  },
  {
    "poem_id": 1442,
    "vorder": 5,
    "position": 0,
    "text": "به هر سو که بنهند بر جنگ روی"
  },
  {
    "poem_id": 1442,
    "vorder": 6,
    "position": 1,
    "text": "نماند به سنگ اندرون رنگ و بوی"
  },
  {
    "poem_id": 1442,
    "vorder": 7,
    "position": 0,
    "text": "بیارم کنون لشکری شیرفش"
  },
  {
    "poem_id": 1442,
    "vorder": 8,
    "position": 1,
    "text": "برآرم شما را سر از خواب خوش"
  },
  {
    "poem_id": 1442,
    "vorder": 9,
    "position": 0,
    "text": "ز پیلان جنگی هزار و دویست"
  },
  {
    "poem_id": 1442,
    "vorder": 10,
    "position": 1,
    "text": "که در بارگاه تو یک پیل نیست"
  },
  {
    "poem_id": 1442,
    "vorder": 11,
    "position": 0,
    "text": "از ایران برآرم یکی تیره خاک"
  },
  {
    "poem_id": 1442,
    "vorder": 12,
    "position": 1,
    "text": "بلندی ندانند باز از مغاک"
  },
  {
    "poem_id": 1442,
    "vorder": 13,
    "position": 0,
    "text": "چو بشنید فرهاد ازو داوری"
  },
  {
    "poem_id": 1442,
    "vorder": 14,
    "position": 1,
    "text": "بلندی و تندی و کندآوری"
  },
  {
    "poem_id": 1442,
    "vorder": 15,
    "position": 0,
    "text": "بکوشید تا پاسخ نامه یافت"
  },
  {
    "poem_id": 1442,
    "vorder": 16,
    "position": 1,
    "text": "عنان سوی سالار ایران شتافت"
  },
  {
    "poem_id": 1442,
    "vorder": 17,
    "position": 0,
    "text": "بیامد بگفت آنچ دید و شنید"
  },
  {
    "poem_id": 1442,
    "vorder": 18,
    "position": 1,
    "text": "همه پردهٔ رازها بردرید"
  },
  {
    "poem_id": 1442,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت کاو ز آسمان برترست"
  },
  {
    "poem_id": 1442,
    "vorder": 20,
    "position": 1,
    "text": "نه رای بلندش به زیر اندرست"
  },
  {
    "poem_id": 1442,
    "vorder": 21,
    "position": 0,
    "text": "ز گفتار من سر بپیچید نیز"
  },
  {
    "poem_id": 1442,
    "vorder": 22,
    "position": 1,
    "text": "جهان پیش چشمش نیرزد به چیز"
  },
  {
    "poem_id": 1442,
    "vorder": 23,
    "position": 0,
    "text": "جهاندار مر پهلوان را بخواند"
  },
  {
    "poem_id": 1442,
    "vorder": 24,
    "position": 1,
    "text": "همه گفت فرهاد با او براند"
  },
  {
    "poem_id": 1442,
    "vorder": 25,
    "position": 0,
    "text": "چنین گفت کاووس با پیلتن"
  },
  {
    "poem_id": 1442,
    "vorder": 26,
    "position": 1,
    "text": "کزین ننگ بگذارم این انجمن"
  },
  {
    "poem_id": 1442,
    "vorder": 27,
    "position": 0,
    "text": "چو بشنید رستم چنین گفت باز"
  },
  {
    "poem_id": 1442,
    "vorder": 28,
    "position": 1,
    "text": "به پیش شهنشاه کهتر نواز"
  },
  {
    "poem_id": 1442,
    "vorder": 29,
    "position": 0,
    "text": "مرا برد باید بر او پیام"
  },
  {
    "poem_id": 1442,
    "vorder": 30,
    "position": 1,
    "text": "سخن برگشایم چو تیغ از نیام"
  },
  {
    "poem_id": 1442,
    "vorder": 31,
    "position": 0,
    "text": "یکی نامه باید چو برنده تیغ"
  },
  {
    "poem_id": 1442,
    "vorder": 32,
    "position": 1,
    "text": "پیامی به کردار غرنده میغ"
  },
  {
    "poem_id": 1442,
    "vorder": 33,
    "position": 0,
    "text": "شوم چون فرستاده‌ای نزد اوی"
  },
  {
    "poem_id": 1442,
    "vorder": 34,
    "position": 1,
    "text": "به گفتار خون اندر آرم به جوی"
  },
  {
    "poem_id": 1442,
    "vorder": 35,
    "position": 0,
    "text": "به پاسخ چنین گفت کاووس شاه"
  },
  {
    "poem_id": 1442,
    "vorder": 36,
    "position": 1,
    "text": "که از تو فروزد نگین و کلاه"
  },
  {
    "poem_id": 1442,
    "vorder": 37,
    "position": 0,
    "text": "پیمبر تویی هم تو پیل دلیر"
  },
  {
    "poem_id": 1442,
    "vorder": 38,
    "position": 1,
    "text": "به هر کینه گه بر سرافراز شیر"
  },
  {
    "poem_id": 1442,
    "vorder": 39,
    "position": 0,
    "text": "بفرمود تا رفت پیشش دبیر"
  },
  {
    "poem_id": 1442,
    "vorder": 40,
    "position": 1,
    "text": "سر خامه را کرد پیکان تیر"
  },
  {
    "poem_id": 1442,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت کاین گفتن نابکار"
  },
  {
    "poem_id": 1442,
    "vorder": 42,
    "position": 1,
    "text": "نه خوب آید از مردم هوشیار"
  },
  {
    "poem_id": 1442,
    "vorder": 43,
    "position": 0,
    "text": "اگر سرکنی زین فزونی تهی"
  },
  {
    "poem_id": 1442,
    "vorder": 44,
    "position": 1,
    "text": "به فرمان گرایی بسان رهی"
  },
  {
    "poem_id": 1442,
    "vorder": 45,
    "position": 0,
    "text": "وگرنه به جنگ تو لشگر کشم"
  },
  {
    "poem_id": 1442,
    "vorder": 46,
    "position": 1,
    "text": "ز دریا به دریا سپه برکشم"
  },
  {
    "poem_id": 1442,
    "vorder": 47,
    "position": 0,
    "text": "روان بداندیش دیو سپید"
  },
  {
    "poem_id": 1442,
    "vorder": 48,
    "position": 1,
    "text": "دهد کرگسان را به مغزت نوید"
  }
]