[
  {
    "poem_id": 1516,
    "vorder": 1,
    "position": 0,
    "text": "چنان بود قیصر بدانگه برای"
  },
  {
    "poem_id": 1516,
    "vorder": 2,
    "position": 1,
    "text": "که چون دختر او رسیدی بجای"
  },
  {
    "poem_id": 1516,
    "vorder": 3,
    "position": 0,
    "text": "چو گشتی بلند اختر و جفت جوی"
  },
  {
    "poem_id": 1516,
    "vorder": 4,
    "position": 1,
    "text": "بدیدی که آمدش هنگام شوی"
  },
  {
    "poem_id": 1516,
    "vorder": 5,
    "position": 0,
    "text": "یکی گرد کردی به کاخ انجمن"
  },
  {
    "poem_id": 1516,
    "vorder": 6,
    "position": 1,
    "text": "بزرگان فرزانه و رای زن"
  },
  {
    "poem_id": 1516,
    "vorder": 7,
    "position": 0,
    "text": "هرانکس که بودی مر او را همال"
  },
  {
    "poem_id": 1516,
    "vorder": 8,
    "position": 1,
    "text": "ازان نامدارن برآورده یال"
  },
  {
    "poem_id": 1516,
    "vorder": 9,
    "position": 0,
    "text": "ز کاخ پدر دختر ماه‌روی"
  },
  {
    "poem_id": 1516,
    "vorder": 10,
    "position": 1,
    "text": "بگشتی بران انجمن جفت جوی"
  },
  {
    "poem_id": 1516,
    "vorder": 11,
    "position": 0,
    "text": "پرستنده بودی به گرد اندرش"
  },
  {
    "poem_id": 1516,
    "vorder": 12,
    "position": 1,
    "text": "ز مردم نبودی پدید افسرش"
  },
  {
    "poem_id": 1516,
    "vorder": 13,
    "position": 0,
    "text": "پس پردهٔ قیصر آن روزگار"
  },
  {
    "poem_id": 1516,
    "vorder": 14,
    "position": 1,
    "text": "سه بد دختر اندر جهان نامدار"
  },
  {
    "poem_id": 1516,
    "vorder": 15,
    "position": 0,
    "text": "به بالا و دیدار و آهستگی"
  },
  {
    "poem_id": 1516,
    "vorder": 16,
    "position": 1,
    "text": "به بایستگی هم به شایستگی"
  },
  {
    "poem_id": 1516,
    "vorder": 17,
    "position": 0,
    "text": "یکی بود مهتر کتایون به نام"
  },
  {
    "poem_id": 1516,
    "vorder": 18,
    "position": 1,
    "text": "خردمند و روشن‌دل و شادکام"
  },
  {
    "poem_id": 1516,
    "vorder": 19,
    "position": 0,
    "text": "کتایون چنان دید یک شب به خواب"
  },
  {
    "poem_id": 1516,
    "vorder": 20,
    "position": 1,
    "text": "که روشن شدی کشور از آفتاب"
  },
  {
    "poem_id": 1516,
    "vorder": 21,
    "position": 0,
    "text": "یکی انجمن مرد پیدا شدی"
  },
  {
    "poem_id": 1516,
    "vorder": 22,
    "position": 1,
    "text": "از انبوه مردم ثریا شدی"
  },
  {
    "poem_id": 1516,
    "vorder": 23,
    "position": 0,
    "text": "سر انجمن بود بیگانه‌ای"
  },
  {
    "poem_id": 1516,
    "vorder": 24,
    "position": 1,
    "text": "غریبی دل آزار و فرزانه‌ای"
  },
  {
    "poem_id": 1516,
    "vorder": 25,
    "position": 0,
    "text": "به بالای سرو و به دیدار ماه"
  },
  {
    "poem_id": 1516,
    "vorder": 26,
    "position": 1,
    "text": "نشستنش چون بر سر گاه شاه"
  },
  {
    "poem_id": 1516,
    "vorder": 27,
    "position": 0,
    "text": "یکی دسته دادی کتایون بدوی"
  },
  {
    "poem_id": 1516,
    "vorder": 28,
    "position": 1,
    "text": "وزو بستدی دستهٔ رنگ و بوی"
  },
  {
    "poem_id": 1516,
    "vorder": 29,
    "position": 0,
    "text": "یکی انجمن کرد قیصر بزرگ"
  },
  {
    "poem_id": 1516,
    "vorder": 30,
    "position": 1,
    "text": "هر آن کس که بودند گرد و سترگ"
  },
  {
    "poem_id": 1516,
    "vorder": 31,
    "position": 0,
    "text": "به شبگیر چون بردمید آفتاب"
  },
  {
    "poem_id": 1516,
    "vorder": 32,
    "position": 1,
    "text": "سر نامداران برآمد ز خواب"
  },
  {
    "poem_id": 1516,
    "vorder": 33,
    "position": 0,
    "text": "بران انجمن شاد بنشاندند"
  },
  {
    "poem_id": 1516,
    "vorder": 34,
    "position": 1,
    "text": "ازان پس پری‌چهره را خواندند"
  },
  {
    "poem_id": 1516,
    "vorder": 35,
    "position": 0,
    "text": "کتایون بشد با پرستار شست"
  },
  {
    "poem_id": 1516,
    "vorder": 36,
    "position": 1,
    "text": "یکی دسته گل هر یکی را به دست"
  },
  {
    "poem_id": 1516,
    "vorder": 37,
    "position": 0,
    "text": "همی گشت چندان کش آمد ستوه"
  },
  {
    "poem_id": 1516,
    "vorder": 38,
    "position": 1,
    "text": "پسندش نیامد کسی زان گروه"
  },
  {
    "poem_id": 1516,
    "vorder": 39,
    "position": 0,
    "text": "از ایوان سوی پرده بنهاد روی"
  },
  {
    "poem_id": 1516,
    "vorder": 40,
    "position": 1,
    "text": "خرامان و پویان و دل جفت‌جوی"
  },
  {
    "poem_id": 1516,
    "vorder": 41,
    "position": 0,
    "text": "هم آنگه زمین گشت چون پر زاغ"
  },
  {
    "poem_id": 1516,
    "vorder": 42,
    "position": 1,
    "text": "چنین تا سر از کوه بر زد چراغ"
  },
  {
    "poem_id": 1516,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود قیصر که از کهتران"
  },
  {
    "poem_id": 1516,
    "vorder": 44,
    "position": 1,
    "text": "به روم اندرون مایه‌ور مهتران"
  },
  {
    "poem_id": 1516,
    "vorder": 45,
    "position": 0,
    "text": "بیارند یکسر به کاخ بلند"
  },
  {
    "poem_id": 1516,
    "vorder": 46,
    "position": 1,
    "text": "بدان تا که باشد به خوبی پسند"
  },
  {
    "poem_id": 1516,
    "vorder": 47,
    "position": 0,
    "text": "چو آگاهی آمد به هر مهتری"
  },
  {
    "poem_id": 1516,
    "vorder": 48,
    "position": 1,
    "text": "بهر نامداری و کنداوری"
  },
  {
    "poem_id": 1516,
    "vorder": 49,
    "position": 0,
    "text": "خردمند مهتر به گشتاسپ گفت"
  },
  {
    "poem_id": 1516,
    "vorder": 50,
    "position": 1,
    "text": "که چندین چه باشی تو اندر نهفت"
  },
  {
    "poem_id": 1516,
    "vorder": 51,
    "position": 0,
    "text": "برو تا مگر تاج و گاه مهی"
  },
  {
    "poem_id": 1516,
    "vorder": 52,
    "position": 1,
    "text": "ببینی دلت گردد از غم تهی"
  },
  {
    "poem_id": 1516,
    "vorder": 53,
    "position": 0,
    "text": "چو بشنید گشتاسپ با او برفت"
  },
  {
    "poem_id": 1516,
    "vorder": 54,
    "position": 1,
    "text": "به ایوان قیصر خرامید تفت"
  },
  {
    "poem_id": 1516,
    "vorder": 55,
    "position": 0,
    "text": "به پیغوله‌ای شد فرود از مهان"
  },
  {
    "poem_id": 1516,
    "vorder": 56,
    "position": 1,
    "text": "پر از درد بنشست خسته نهان"
  },
  {
    "poem_id": 1516,
    "vorder": 57,
    "position": 0,
    "text": "برفتند بیدار دل بندگان"
  },
  {
    "poem_id": 1516,
    "vorder": 58,
    "position": 1,
    "text": "کتایون و گل رخ پرستندگان"
  },
  {
    "poem_id": 1516,
    "vorder": 59,
    "position": 0,
    "text": "همی گشت بر گرد ایوان خویش"
  },
  {
    "poem_id": 1516,
    "vorder": 60,
    "position": 1,
    "text": "پسش بخردان و پرستار پیش"
  },
  {
    "poem_id": 1516,
    "vorder": 61,
    "position": 0,
    "text": "چو از دور گشتاسپ را دید گفت"
  },
  {
    "poem_id": 1516,
    "vorder": 62,
    "position": 1,
    "text": "که آن خواب سر برکشید از نهفت"
  },
  {
    "poem_id": 1516,
    "vorder": 63,
    "position": 0,
    "text": "بدان مایه‌ور نامدار افسرش"
  },
  {
    "poem_id": 1516,
    "vorder": 64,
    "position": 1,
    "text": "هم‌آنگه بیاراست خرم سرش"
  },
  {
    "poem_id": 1516,
    "vorder": 65,
    "position": 0,
    "text": "چو دستور آموزگار آن بدید"
  },
  {
    "poem_id": 1516,
    "vorder": 66,
    "position": 1,
    "text": "هم اندر زمان پیش قیصر دوید"
  },
  {
    "poem_id": 1516,
    "vorder": 67,
    "position": 0,
    "text": "که مردی گزین کرد از انجمن"
  },
  {
    "poem_id": 1516,
    "vorder": 68,
    "position": 1,
    "text": "به بالای سرو سهی در چمن"
  },
  {
    "poem_id": 1516,
    "vorder": 69,
    "position": 0,
    "text": "به رخ چون گلستان و با یال و کفت"
  },
  {
    "poem_id": 1516,
    "vorder": 70,
    "position": 1,
    "text": "که هرکش ببیند بماند شگفت"
  },
  {
    "poem_id": 1516,
    "vorder": 71,
    "position": 0,
    "text": "بد آنست کو را ندانیم کیست"
  },
  {
    "poem_id": 1516,
    "vorder": 72,
    "position": 1,
    "text": "تو گویی همه فره ایزدیست"
  },
  {
    "poem_id": 1516,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد پاسخ که دختر مباد"
  },
  {
    "poem_id": 1516,
    "vorder": 74,
    "position": 1,
    "text": "که از پرده عیب آورد بر نژاد"
  },
  {
    "poem_id": 1516,
    "vorder": 75,
    "position": 0,
    "text": "اگر من سپارم بدو دخترم"
  },
  {
    "poem_id": 1516,
    "vorder": 76,
    "position": 1,
    "text": "به ننگ اندرون پست گردد سرم"
  },
  {
    "poem_id": 1516,
    "vorder": 77,
    "position": 0,
    "text": "هم او را و آنرا که او برگزید"
  },
  {
    "poem_id": 1516,
    "vorder": 78,
    "position": 1,
    "text": "به کاخ اندرون سر بباید برید"
  },
  {
    "poem_id": 1516,
    "vorder": 79,
    "position": 0,
    "text": "سقف گفت کاین نیست کاری گران"
  },
  {
    "poem_id": 1516,
    "vorder": 80,
    "position": 1,
    "text": "که پیش از تو بودند چندی سران"
  },
  {
    "poem_id": 1516,
    "vorder": 81,
    "position": 0,
    "text": "تو با دخترت گفتی انباز جوی"
  },
  {
    "poem_id": 1516,
    "vorder": 82,
    "position": 1,
    "text": "نگفتی که رومی سرافراز جوی"
  },
  {
    "poem_id": 1516,
    "vorder": 83,
    "position": 0,
    "text": "کنون جست آنرا که آمدش خوش"
  },
  {
    "poem_id": 1516,
    "vorder": 84,
    "position": 1,
    "text": "تو از راه یزدان سرت را مکش"
  },
  {
    "poem_id": 1516,
    "vorder": 85,
    "position": 0,
    "text": "چنین بود رسم نیاکان تو"
  },
  {
    "poem_id": 1516,
    "vorder": 86,
    "position": 1,
    "text": "سرافراز و دین‌دار و پاکان تو"
  },
  {
    "poem_id": 1516,
    "vorder": 87,
    "position": 0,
    "text": "به آیین این شد پی افگنده روم"
  },
  {
    "poem_id": 1516,
    "vorder": 88,
    "position": 1,
    "text": "تو راهی مگیر اندر آباد بوم"
  },
  {
    "poem_id": 1516,
    "vorder": 89,
    "position": 0,
    "text": "همایون نباشد چنین خود مگوی"
  },
  {
    "poem_id": 1516,
    "vorder": 90,
    "position": 1,
    "text": "به راهی که هرگز نرفتی مپوی"
  }
]