[
  {
    "poem_id": 1795,
    "vorder": 1,
    "position": 0,
    "text": "به نرسی چنین گفت یک روز شاه"
  },
  {
    "poem_id": 1795,
    "vorder": 2,
    "position": 1,
    "text": "کز ایدر برو با نگین و کلاه"
  },
  {
    "poem_id": 1795,
    "vorder": 3,
    "position": 0,
    "text": "خراسان ترا دادم آباد کن"
  },
  {
    "poem_id": 1795,
    "vorder": 4,
    "position": 1,
    "text": "دل زیردستان به ما شاد کن"
  },
  {
    "poem_id": 1795,
    "vorder": 5,
    "position": 0,
    "text": "نگر تا نباشی به جز دادگر"
  },
  {
    "poem_id": 1795,
    "vorder": 6,
    "position": 1,
    "text": "میاویز چنگ اندرین رهگذر"
  },
  {
    "poem_id": 1795,
    "vorder": 7,
    "position": 0,
    "text": "پدر کرد بیداد و پیچد ازان"
  },
  {
    "poem_id": 1795,
    "vorder": 8,
    "position": 1,
    "text": "چو مردی برهنه ز باد خزان"
  },
  {
    "poem_id": 1795,
    "vorder": 9,
    "position": 0,
    "text": "بفرمود تا خلعتش ساختند"
  },
  {
    "poem_id": 1795,
    "vorder": 10,
    "position": 1,
    "text": "گرانمایه گنجی بپرداختند"
  },
  {
    "poem_id": 1795,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت یزدان پناه تو باد"
  },
  {
    "poem_id": 1795,
    "vorder": 12,
    "position": 1,
    "text": "سر تخت خورشید گاه تو باد"
  },
  {
    "poem_id": 1795,
    "vorder": 13,
    "position": 0,
    "text": "به رفتن دو هفته درنگ آمدش"
  },
  {
    "poem_id": 1795,
    "vorder": 14,
    "position": 1,
    "text": "تن‌آسان خراسان به چنگ آمدش"
  },
  {
    "poem_id": 1795,
    "vorder": 15,
    "position": 0,
    "text": "چو نرسی بشد هفته‌ای برگذشت"
  },
  {
    "poem_id": 1795,
    "vorder": 16,
    "position": 1,
    "text": "دل شاه ز اندیشه پردخته گشت"
  },
  {
    "poem_id": 1795,
    "vorder": 17,
    "position": 0,
    "text": "بفرمود تا موبد موبدان"
  },
  {
    "poem_id": 1795,
    "vorder": 18,
    "position": 1,
    "text": "برفت و بیاورد چندی ردان"
  },
  {
    "poem_id": 1795,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت شد کار قیصر دراز"
  },
  {
    "poem_id": 1795,
    "vorder": 20,
    "position": 1,
    "text": "رسولش همی دیر یابد جواز"
  },
  {
    "poem_id": 1795,
    "vorder": 21,
    "position": 0,
    "text": "چه مردست و اندر خرد تا کجاست"
  },
  {
    "poem_id": 1795,
    "vorder": 22,
    "position": 1,
    "text": "که دارد روان از خرد پشت راست"
  },
  {
    "poem_id": 1795,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت موبد انوشه بدی"
  },
  {
    "poem_id": 1795,
    "vorder": 24,
    "position": 1,
    "text": "جهاندار و با فره ایزدی"
  },
  {
    "poem_id": 1795,
    "vorder": 25,
    "position": 0,
    "text": "یکی مرد پیرست با رای و شرم"
  },
  {
    "poem_id": 1795,
    "vorder": 26,
    "position": 1,
    "text": "سخن گفتنش چرب و آواز نرم"
  },
  {
    "poem_id": 1795,
    "vorder": 27,
    "position": 0,
    "text": "کسی کش فلاطون به دست اوستاد"
  },
  {
    "poem_id": 1795,
    "vorder": 28,
    "position": 1,
    "text": "خردمند و بادانش و بانژاد"
  },
  {
    "poem_id": 1795,
    "vorder": 29,
    "position": 0,
    "text": "یکی برمنش بود کامد ز روم"
  },
  {
    "poem_id": 1795,
    "vorder": 30,
    "position": 1,
    "text": "کنون خیره گشت اندرین مرز و بوم"
  },
  {
    "poem_id": 1795,
    "vorder": 31,
    "position": 0,
    "text": "بپژمرد چون لاله در ماه دی"
  },
  {
    "poem_id": 1795,
    "vorder": 32,
    "position": 1,
    "text": "تنش خشک و رخساره همرنگ نی"
  },
  {
    "poem_id": 1795,
    "vorder": 33,
    "position": 0,
    "text": "همه کهترانش به کردار میش"
  },
  {
    "poem_id": 1795,
    "vorder": 34,
    "position": 1,
    "text": "که روز شکارش سگ آید به پیش"
  },
  {
    "poem_id": 1795,
    "vorder": 35,
    "position": 0,
    "text": "به کندی و تندی بما ننگرید"
  },
  {
    "poem_id": 1795,
    "vorder": 36,
    "position": 1,
    "text": "وزین مرز کس را به کس نشمرید"
  },
  {
    "poem_id": 1795,
    "vorder": 37,
    "position": 0,
    "text": "به موبد چنین گفت بهرام گور"
  },
  {
    "poem_id": 1795,
    "vorder": 38,
    "position": 1,
    "text": "که یزدان دهد فر و دیهیم و زور"
  },
  {
    "poem_id": 1795,
    "vorder": 39,
    "position": 0,
    "text": "مرا گر جهاندار پیروز کرد"
  },
  {
    "poem_id": 1795,
    "vorder": 40,
    "position": 1,
    "text": "شب تیره بر بخت من روز کرد"
  },
  {
    "poem_id": 1795,
    "vorder": 41,
    "position": 0,
    "text": "یکی قیصر روم و قیصر نژاد"
  },
  {
    "poem_id": 1795,
    "vorder": 42,
    "position": 1,
    "text": "فریدون ورا تاج بر سر نهاد"
  },
  {
    "poem_id": 1795,
    "vorder": 43,
    "position": 0,
    "text": "بزرگست وز سلم دارد نژاد"
  },
  {
    "poem_id": 1795,
    "vorder": 44,
    "position": 1,
    "text": "ز شاهان فزون‌تر به رسم و به داد"
  },
  {
    "poem_id": 1795,
    "vorder": 45,
    "position": 0,
    "text": "کنون مردمی کرد و فرزانگی"
  },
  {
    "poem_id": 1795,
    "vorder": 46,
    "position": 1,
    "text": "چو خاقان نیامد به دیوانگی"
  },
  {
    "poem_id": 1795,
    "vorder": 47,
    "position": 0,
    "text": "ورا پیش خوانیم هنگام بار"
  },
  {
    "poem_id": 1795,
    "vorder": 48,
    "position": 1,
    "text": "سخن تا چه گوید که آید به کار"
  },
  {
    "poem_id": 1795,
    "vorder": 49,
    "position": 0,
    "text": "وزان پس به خوبی فرستمش باز"
  },
  {
    "poem_id": 1795,
    "vorder": 50,
    "position": 1,
    "text": "ز مردم نیم در جهان بی‌نیاز"
  },
  {
    "poem_id": 1795,
    "vorder": 51,
    "position": 0,
    "text": "یکی رزم جوید سپاه آورد"
  },
  {
    "poem_id": 1795,
    "vorder": 52,
    "position": 1,
    "text": "دگر بزم و زرین کلاه آورد"
  },
  {
    "poem_id": 1795,
    "vorder": 53,
    "position": 0,
    "text": "مرا ارج ایشان بباید شناخت"
  },
  {
    "poem_id": 1795,
    "vorder": 54,
    "position": 1,
    "text": "بزرگ آنک با نامداران بساخت"
  },
  {
    "poem_id": 1795,
    "vorder": 55,
    "position": 0,
    "text": "برو آفرین کرد موبد به مهر"
  },
  {
    "poem_id": 1795,
    "vorder": 56,
    "position": 1,
    "text": "که شادان بدی تا بگردد سپهر"
  }
]