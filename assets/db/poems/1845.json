[
  {
    "poem_id": 1845,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه شد به پیش پدر"
  },
  {
    "poem_id": 1845,
    "vorder": 2,
    "position": 1,
    "text": "دودیده پراز آب و پر خون جگر"
  },
  {
    "poem_id": 1845,
    "vorder": 3,
    "position": 0,
    "text": "چو روی پدر دید بردش نماز"
  },
  {
    "poem_id": 1845,
    "vorder": 4,
    "position": 1,
    "text": "همی‌بود پیشش زمانی دراز"
  },
  {
    "poem_id": 1845,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کاین پهلوان سوار"
  },
  {
    "poem_id": 1845,
    "vorder": 6,
    "position": 1,
    "text": "که او را گزین کردی ای شهریار"
  },
  {
    "poem_id": 1845,
    "vorder": 7,
    "position": 0,
    "text": "بیامد چوشاهان که دارند فر"
  },
  {
    "poem_id": 1845,
    "vorder": 8,
    "position": 1,
    "text": "سپاهی بیاورد بسیارمر"
  },
  {
    "poem_id": 1845,
    "vorder": 9,
    "position": 0,
    "text": "بگفتم سخن هرچ آمد ز پند"
  },
  {
    "poem_id": 1845,
    "vorder": 10,
    "position": 1,
    "text": "برو پند من بر نبد سودمند"
  },
  {
    "poem_id": 1845,
    "vorder": 11,
    "position": 0,
    "text": "همه جنگ و پرخاش بدکام اوی"
  },
  {
    "poem_id": 1845,
    "vorder": 12,
    "position": 1,
    "text": "که هرگز مبادا روان نام اوی"
  },
  {
    "poem_id": 1845,
    "vorder": 13,
    "position": 0,
    "text": "بناکام رزمی گران کرده شد"
  },
  {
    "poem_id": 1845,
    "vorder": 14,
    "position": 1,
    "text": "فراوان کس از اختر آزرده شد"
  },
  {
    "poem_id": 1845,
    "vorder": 15,
    "position": 0,
    "text": "زمن بازگشتند یکسر سپاه"
  },
  {
    "poem_id": 1845,
    "vorder": 16,
    "position": 1,
    "text": "ندیدند گفتی مرا جزبه راه"
  },
  {
    "poem_id": 1845,
    "vorder": 17,
    "position": 0,
    "text": "همی شاه خوانند بهرام را"
  },
  {
    "poem_id": 1845,
    "vorder": 18,
    "position": 1,
    "text": "ندیدند آغاز فرجام را"
  },
  {
    "poem_id": 1845,
    "vorder": 19,
    "position": 0,
    "text": "پس من کنون تا پل نهروان"
  },
  {
    "poem_id": 1845,
    "vorder": 20,
    "position": 1,
    "text": "بیاورد لشکر چو کوهی گران"
  },
  {
    "poem_id": 1845,
    "vorder": 21,
    "position": 0,
    "text": "چوشد کاربی برگ بگریختم"
  },
  {
    "poem_id": 1845,
    "vorder": 22,
    "position": 1,
    "text": "بدام بلا در نیاویختم"
  },
  {
    "poem_id": 1845,
    "vorder": 23,
    "position": 0,
    "text": "نگه کردم اکنون به سود و زیان"
  },
  {
    "poem_id": 1845,
    "vorder": 24,
    "position": 1,
    "text": "نباشند یاور مگر تازیان"
  },
  {
    "poem_id": 1845,
    "vorder": 25,
    "position": 0,
    "text": "گر ای دون که فرمان دهد شهریار"
  },
  {
    "poem_id": 1845,
    "vorder": 26,
    "position": 1,
    "text": "سواران تازی برم بی‌شمار"
  },
  {
    "poem_id": 1845,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت هرمز که این رای نیست"
  },
  {
    "poem_id": 1845,
    "vorder": 28,
    "position": 1,
    "text": "که اکنون تو را پای برجای نیست"
  },
  {
    "poem_id": 1845,
    "vorder": 29,
    "position": 0,
    "text": "نباشند یاور تو را تازیان"
  },
  {
    "poem_id": 1845,
    "vorder": 30,
    "position": 1,
    "text": "چوجایی نبینند سود و زیان"
  },
  {
    "poem_id": 1845,
    "vorder": 31,
    "position": 0,
    "text": "بدرد دل اندر تو را زار نیز"
  },
  {
    "poem_id": 1845,
    "vorder": 32,
    "position": 1,
    "text": "بدشمن سپارند از بهر چیز"
  },
  {
    "poem_id": 1845,
    "vorder": 33,
    "position": 0,
    "text": "بدین کار پشت تو یزدان بود"
  },
  {
    "poem_id": 1845,
    "vorder": 34,
    "position": 1,
    "text": "همآواز تو بخت خندان بود"
  },
  {
    "poem_id": 1845,
    "vorder": 35,
    "position": 0,
    "text": "چو بگذاشت خواهی همی مرز وبوم"
  },
  {
    "poem_id": 1845,
    "vorder": 36,
    "position": 1,
    "text": "از ایدر برو تازیان تا بروم"
  },
  {
    "poem_id": 1845,
    "vorder": 37,
    "position": 0,
    "text": "سخنهای این بندهٔ چاره جوی"
  },
  {
    "poem_id": 1845,
    "vorder": 38,
    "position": 1,
    "text": "چو رفتی یکایک بقیصر بگوی"
  },
  {
    "poem_id": 1845,
    "vorder": 39,
    "position": 0,
    "text": "بجایی که دین است و هم وخواستست"
  },
  {
    "poem_id": 1845,
    "vorder": 40,
    "position": 1,
    "text": "سلیح و سپاه وی آراستست"
  },
  {
    "poem_id": 1845,
    "vorder": 41,
    "position": 0,
    "text": "فریدونیان نیز خویش تواند"
  },
  {
    "poem_id": 1845,
    "vorder": 42,
    "position": 1,
    "text": "چوکارت شود سخت پیش تواند"
  },
  {
    "poem_id": 1845,
    "vorder": 43,
    "position": 0,
    "text": "چو بشنید خسرو زمین بوس داد"
  },
  {
    "poem_id": 1845,
    "vorder": 44,
    "position": 1,
    "text": "بسی بر نهان آفرین کرد یاد"
  },
  {
    "poem_id": 1845,
    "vorder": 45,
    "position": 0,
    "text": "ببندوی و گردوی و گستهم گفت"
  },
  {
    "poem_id": 1845,
    "vorder": 46,
    "position": 1,
    "text": "که ما با غم و رنج گشتیم جفت"
  },
  {
    "poem_id": 1845,
    "vorder": 47,
    "position": 0,
    "text": "بسازید و یکسر بنه برنهید"
  },
  {
    "poem_id": 1845,
    "vorder": 48,
    "position": 1,
    "text": "برو بوم ایران بدشمن دهید"
  },
  {
    "poem_id": 1845,
    "vorder": 49,
    "position": 0,
    "text": "بگفت این و از دیده آواز خاست"
  },
  {
    "poem_id": 1845,
    "vorder": 50,
    "position": 1,
    "text": "که‌ای شاه نیک اختر و داد وراست"
  },
  {
    "poem_id": 1845,
    "vorder": 51,
    "position": 0,
    "text": "یکی گرد تیره برآمد ز راه"
  },
  {
    "poem_id": 1845,
    "vorder": 52,
    "position": 1,
    "text": "درفشی درفشان میان سپاه"
  },
  {
    "poem_id": 1845,
    "vorder": 53,
    "position": 0,
    "text": "درفشی کجا پیکرش اژدهاست"
  },
  {
    "poem_id": 1845,
    "vorder": 54,
    "position": 1,
    "text": "که چوبینه بر نهروان کرد راست"
  },
  {
    "poem_id": 1845,
    "vorder": 55,
    "position": 0,
    "text": "چوبشنید خسرو بیامد بدر"
  },
  {
    "poem_id": 1845,
    "vorder": 56,
    "position": 1,
    "text": "گریزان برفت او ز پیش پدر"
  },
  {
    "poem_id": 1845,
    "vorder": 57,
    "position": 0,
    "text": "همی‌شد سوی روم برسان گرد"
  },
  {
    "poem_id": 1845,
    "vorder": 58,
    "position": 1,
    "text": "درفشی پس پشت او لاژورد"
  },
  {
    "poem_id": 1845,
    "vorder": 59,
    "position": 0,
    "text": "بپیچید یال و بر و روی را"
  },
  {
    "poem_id": 1845,
    "vorder": 60,
    "position": 1,
    "text": "نگه کرد گستهم و بند وی را"
  },
  {
    "poem_id": 1845,
    "vorder": 61,
    "position": 0,
    "text": "همی‌راندند آن دو تن نرم نرم"
  },
  {
    "poem_id": 1845,
    "vorder": 62,
    "position": 1,
    "text": "خروشید خسرو به آوای گرم"
  },
  {
    "poem_id": 1845,
    "vorder": 63,
    "position": 0,
    "text": "همانا سران تان ز پیش آمدست"
  },
  {
    "poem_id": 1845,
    "vorder": 64,
    "position": 1,
    "text": "که بدخواه تان همچو خویش آمدست"
  },
  {
    "poem_id": 1845,
    "vorder": 65,
    "position": 0,
    "text": "اگر نه چنین نرم راندن چراست"
  },
  {
    "poem_id": 1845,
    "vorder": 66,
    "position": 1,
    "text": "که بهرام نزدیک پشت شماست"
  },
  {
    "poem_id": 1845,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت بندوی کای شهریار"
  },
  {
    "poem_id": 1845,
    "vorder": 68,
    "position": 1,
    "text": "دلت را ببهرام رنجه مدار"
  },
  {
    "poem_id": 1845,
    "vorder": 69,
    "position": 0,
    "text": "کجا گرد ما را نبیند ز راه"
  },
  {
    "poem_id": 1845,
    "vorder": 70,
    "position": 1,
    "text": "که دورست ز ایدر درفش سیاه"
  },
  {
    "poem_id": 1845,
    "vorder": 71,
    "position": 0,
    "text": "چنین است یارانت را گفت و گوی"
  },
  {
    "poem_id": 1845,
    "vorder": 72,
    "position": 1,
    "text": "که ما را بدین تاختن نیست روی"
  },
  {
    "poem_id": 1845,
    "vorder": 73,
    "position": 0,
    "text": "چو چوبینه آید بایوان شاه"
  },
  {
    "poem_id": 1845,
    "vorder": 74,
    "position": 1,
    "text": "هم آنگه به هرمز دهد تاج وگاه"
  },
  {
    "poem_id": 1845,
    "vorder": 75,
    "position": 0,
    "text": "نشیند چو دستور بردست اوی"
  },
  {
    "poem_id": 1845,
    "vorder": 76,
    "position": 1,
    "text": "بدریا رسد کارگر شست اوی"
  },
  {
    "poem_id": 1845,
    "vorder": 77,
    "position": 0,
    "text": "بقیصر یکی نامه از شهریار"
  },
  {
    "poem_id": 1845,
    "vorder": 78,
    "position": 1,
    "text": "نویسد که این بندهٔ نابکار"
  },
  {
    "poem_id": 1845,
    "vorder": 79,
    "position": 0,
    "text": "گریزان برفتست زین مرز وبوم"
  },
  {
    "poem_id": 1845,
    "vorder": 80,
    "position": 1,
    "text": "نباید که آرام گیرد بروم"
  },
  {
    "poem_id": 1845,
    "vorder": 81,
    "position": 0,
    "text": "هم آنگه که او خویشتن کرد راست"
  },
  {
    "poem_id": 1845,
    "vorder": 82,
    "position": 1,
    "text": "نژندی وکژی ازین بهر ماست"
  },
  {
    "poem_id": 1845,
    "vorder": 83,
    "position": 0,
    "text": "چو آید بران مرز بندش کنید"
  },
  {
    "poem_id": 1845,
    "vorder": 84,
    "position": 1,
    "text": "دل شادمان را گزندش کنید"
  },
  {
    "poem_id": 1845,
    "vorder": 85,
    "position": 0,
    "text": "بدین بارگاهش فرستید باز"
  },
  {
    "poem_id": 1845,
    "vorder": 86,
    "position": 1,
    "text": "ممانید تا گردد او سرفراز"
  },
  {
    "poem_id": 1845,
    "vorder": 87,
    "position": 0,
    "text": "ببندید هم در زمان با سپاه"
  },
  {
    "poem_id": 1845,
    "vorder": 88,
    "position": 1,
    "text": "فرستید گریان بدین جایگاه"
  },
  {
    "poem_id": 1845,
    "vorder": 89,
    "position": 0,
    "text": "چنین داد پاسخ که از بخت بد"
  },
  {
    "poem_id": 1845,
    "vorder": 90,
    "position": 1,
    "text": "سزد زین نشان هرچ بر ما رسد"
  },
  {
    "poem_id": 1845,
    "vorder": 91,
    "position": 0,
    "text": "سخنها درازست و کاری درشت"
  },
  {
    "poem_id": 1845,
    "vorder": 92,
    "position": 1,
    "text": "به یزدان کنون باز هشتیم پشت"
  },
  {
    "poem_id": 1845,
    "vorder": 93,
    "position": 0,
    "text": "براند اسپ وگفت آنچ از خوب و زشت"
  },
  {
    "poem_id": 1845,
    "vorder": 94,
    "position": 1,
    "text": "جهاندار برتارک ما نبشت"
  },
  {
    "poem_id": 1845,
    "vorder": 95,
    "position": 0,
    "text": "بباشد نگردد باندیشه باز"
  },
  {
    "poem_id": 1845,
    "vorder": 96,
    "position": 1,
    "text": "مبادا که آید بدشمن نیاز"
  },
  {
    "poem_id": 1845,
    "vorder": 97,
    "position": 0,
    "text": "چو او برگذشت این دو بیدادگر"
  },
  {
    "poem_id": 1845,
    "vorder": 98,
    "position": 1,
    "text": "ازو بازگشتند پر کینه سر"
  },
  {
    "poem_id": 1845,
    "vorder": 99,
    "position": 0,
    "text": "زراه اندر ایوان شاه آمدند"
  },
  {
    "poem_id": 1845,
    "vorder": 100,
    "position": 1,
    "text": "پراز رنج و دل پرگناه آمدند"
  },
  {
    "poem_id": 1845,
    "vorder": 101,
    "position": 0,
    "text": "ز در چون رسیدند نزدیک تخت"
  },
  {
    "poem_id": 1845,
    "vorder": 102,
    "position": 1,
    "text": "زهی از کمان باز کردند سخت"
  },
  {
    "poem_id": 1845,
    "vorder": 103,
    "position": 0,
    "text": "فگندند ناگاه در گردنش"
  },
  {
    "poem_id": 1845,
    "vorder": 104,
    "position": 1,
    "text": "بیاویختند آن گرامی تنش"
  },
  {
    "poem_id": 1845,
    "vorder": 105,
    "position": 0,
    "text": "شد آن تاج و آن تخت شاهنشهان"
  },
  {
    "poem_id": 1845,
    "vorder": 106,
    "position": 1,
    "text": "توگفتی که هرمز نبد درجهان"
  },
  {
    "poem_id": 1845,
    "vorder": 107,
    "position": 0,
    "text": "چنین است آیین گردنده دهر"
  },
  {
    "poem_id": 1845,
    "vorder": 108,
    "position": 1,
    "text": "گهی نوش بار آورد گاه زهر"
  },
  {
    "poem_id": 1845,
    "vorder": 109,
    "position": 0,
    "text": "اگر مایه اینست سودش مجوی"
  },
  {
    "poem_id": 1845,
    "vorder": 110,
    "position": 1,
    "text": "که درجستنش رنجت آید بروی"
  },
  {
    "poem_id": 1845,
    "vorder": 111,
    "position": 0,
    "text": "چوشد گردش روز هرمز بپای"
  },
  {
    "poem_id": 1845,
    "vorder": 112,
    "position": 1,
    "text": "تهی ماند زان تخت فرخنده جای"
  },
  {
    "poem_id": 1845,
    "vorder": 113,
    "position": 0,
    "text": "هم آنگاه برخاست آواز کوس"
  },
  {
    "poem_id": 1845,
    "vorder": 114,
    "position": 1,
    "text": "رخ خونیان گشت چون سندروس"
  },
  {
    "poem_id": 1845,
    "vorder": 115,
    "position": 0,
    "text": "درفش سپهبد هم آنگه ز راه"
  },
  {
    "poem_id": 1845,
    "vorder": 116,
    "position": 1,
    "text": "پدید آمد اندر میان سپاه"
  },
  {
    "poem_id": 1845,
    "vorder": 117,
    "position": 0,
    "text": "جفا پیشه گستهم و بند وی تیز"
  },
  {
    "poem_id": 1845,
    "vorder": 118,
    "position": 1,
    "text": "گرفتند زان کاخ راه گریز"
  },
  {
    "poem_id": 1845,
    "vorder": 119,
    "position": 0,
    "text": "چنین تا بخسرو رسید این دومرد"
  },
  {
    "poem_id": 1845,
    "vorder": 120,
    "position": 1,
    "text": "جهانجوی چون دیدشان روی زرد"
  },
  {
    "poem_id": 1845,
    "vorder": 121,
    "position": 0,
    "text": "بدانست کایشان دو دل پر ز راز"
  },
  {
    "poem_id": 1845,
    "vorder": 122,
    "position": 1,
    "text": "چرا از جهاندار گشتند باز"
  },
  {
    "poem_id": 1845,
    "vorder": 123,
    "position": 0,
    "text": "برخساره شد چون گل شنبلید"
  },
  {
    "poem_id": 1845,
    "vorder": 124,
    "position": 1,
    "text": "نکرد آن سخن بر دلیران پدید"
  },
  {
    "poem_id": 1845,
    "vorder": 125,
    "position": 0,
    "text": "بدیشان چنین گفت کزشاه راه"
  },
  {
    "poem_id": 1845,
    "vorder": 126,
    "position": 1,
    "text": "بگردید کامد بتنگی سپاه"
  },
  {
