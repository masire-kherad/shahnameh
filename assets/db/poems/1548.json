[
  {
    "poem_id": 1548,
    "vorder": 1,
    "position": 0,
    "text": "یکی روز بنشست کی شهریار"
  },
  {
    "poem_id": 1548,
    "vorder": 2,
    "position": 1,
    "text": "به رامش بخورد او می خوش‌گوار"
  },
  {
    "poem_id": 1548,
    "vorder": 3,
    "position": 0,
    "text": "یکی سرکشی بود نامش گُرَزم"
  },
  {
    "poem_id": 1548,
    "vorder": 4,
    "position": 1,
    "text": "گوی نامجو آزموده به رزم"
  },
  {
    "poem_id": 1548,
    "vorder": 5,
    "position": 0,
    "text": "به دل کین همی داشت ز اسفندیار"
  },
  {
    "poem_id": 1548,
    "vorder": 6,
    "position": 1,
    "text": "ندانم چه شان بود از آغاز کار"
  },
  {
    "poem_id": 1548,
    "vorder": 7,
    "position": 0,
    "text": "به هر جای کاواز او آمدی"
  },
  {
    "poem_id": 1548,
    "vorder": 8,
    "position": 1,
    "text": "ازو زشت گفتی و طعنه زدی"
  },
  {
    "poem_id": 1548,
    "vorder": 9,
    "position": 0,
    "text": "نشسته بد او پیش فرخنده شاه"
  },
  {
    "poem_id": 1548,
    "vorder": 10,
    "position": 1,
    "text": "رخ از درد زرد و دل از کین تباه"
  },
  {
    "poem_id": 1548,
    "vorder": 11,
    "position": 0,
    "text": "فراز آمد از شاهزاده سخن"
  },
  {
    "poem_id": 1548,
    "vorder": 12,
    "position": 1,
    "text": "نگر تا چه بد آهو افگند بن"
  },
  {
    "poem_id": 1548,
    "vorder": 13,
    "position": 0,
    "text": "هوازی یکی دست بر دست زد"
  },
  {
    "poem_id": 1548,
    "vorder": 14,
    "position": 1,
    "text": "چو دشمن بود گفت فرزند بد"
  },
  {
    "poem_id": 1548,
    "vorder": 15,
    "position": 0,
    "text": "فرازش نباید کشیدن به پیش"
  },
  {
    "poem_id": 1548,
    "vorder": 16,
    "position": 1,
    "text": "چنین گفت آن موبد راست کیش"
  },
  {
    "poem_id": 1548,
    "vorder": 17,
    "position": 0,
    "text": "که چون پور با سهم و مهتر شود"
  },
  {
    "poem_id": 1548,
    "vorder": 18,
    "position": 1,
    "text": "ازو باب را روز بتر شود"
  },
  {
    "poem_id": 1548,
    "vorder": 19,
    "position": 0,
    "text": "رهی کز خداوند سر برکشید"
  },
  {
    "poem_id": 1548,
    "vorder": 20,
    "position": 1,
    "text": "از اندازه‌اش سر بباید برید"
  },
  {
    "poem_id": 1548,
    "vorder": 21,
    "position": 0,
    "text": "چو از رازدار این شنیدم نخست"
  },
  {
    "poem_id": 1548,
    "vorder": 22,
    "position": 1,
    "text": "نیامد مرا این گمانی درست"
  },
  {
    "poem_id": 1548,
    "vorder": 23,
    "position": 0,
    "text": "جهانجوی گفت این سخن چیست باز"
  },
  {
    "poem_id": 1548,
    "vorder": 24,
    "position": 1,
    "text": "خداوند این راز که وین چه راز"
  },
  {
    "poem_id": 1548,
    "vorder": 25,
    "position": 0,
    "text": "کیان شاه را گفت کای راست گوی"
  },
  {
    "poem_id": 1548,
    "vorder": 26,
    "position": 1,
    "text": "چنین راز گفتن کنون نیست روی"
  },
  {
    "poem_id": 1548,
    "vorder": 27,
    "position": 0,
    "text": "سر شهریاران تهی کرد جای"
  },
  {
    "poem_id": 1548,
    "vorder": 28,
    "position": 1,
    "text": "فریبنده را گفت نزد من آی"
  },
  {
    "poem_id": 1548,
    "vorder": 29,
    "position": 0,
    "text": "بگوی این همه سر بسر پیش من"
  },
  {
    "poem_id": 1548,
    "vorder": 30,
    "position": 1,
    "text": "نهان چیست زان اژدها کیش من"
  },
  {
    "poem_id": 1548,
    "vorder": 31,
    "position": 0,
    "text": "گُرَزم بد آهوش گفت از خرد"
  },
  {
    "poem_id": 1548,
    "vorder": 32,
    "position": 1,
    "text": "نباید جز آن چیز کاندر خورد"
  },
  {
    "poem_id": 1548,
    "vorder": 33,
    "position": 0,
    "text": "مرا شاه کرد از جهان بی‌نیاز"
  },
  {
    "poem_id": 1548,
    "vorder": 34,
    "position": 1,
    "text": "سزد گر ندارم بد از شاه باز"
  },
  {
    "poem_id": 1548,
    "vorder": 35,
    "position": 0,
    "text": "ندارم من از شاه خود باز پند"
  },
  {
    "poem_id": 1548,
    "vorder": 36,
    "position": 1,
    "text": "وگرچه مرا او را نیاد پسند"
  },
  {
    "poem_id": 1548,
    "vorder": 37,
    "position": 0,
    "text": "که گر راز گویمش و او نشنود"
  },
  {
    "poem_id": 1548,
    "vorder": 38,
    "position": 1,
    "text": "به از راز کردنش پنهان شود"
  },
  {
    "poem_id": 1548,
    "vorder": 39,
    "position": 0,
    "text": "بدان ای شهنشاه کاسفندیار"
  },
  {
    "poem_id": 1548,
    "vorder": 40,
    "position": 1,
    "text": "بسیچد همی رزم را روی کار"
  },
  {
    "poem_id": 1548,
    "vorder": 41,
    "position": 0,
    "text": "بسی لشکر آمد به نزدیک اوی"
  },
  {
    "poem_id": 1548,
    "vorder": 42,
    "position": 1,
    "text": "جهانی سوی او نهادست روی"
  },
  {
    "poem_id": 1548,
    "vorder": 43,
    "position": 0,
    "text": "بر آنست اکنون که بندد ترا"
  },
  {
    "poem_id": 1548,
    "vorder": 44,
    "position": 1,
    "text": "به شاهی همی بد پسندد ترا"
  },
  {
    "poem_id": 1548,
    "vorder": 45,
    "position": 0,
    "text": "تراگر به دست آورید و ببست"
  },
  {
    "poem_id": 1548,
    "vorder": 46,
    "position": 1,
    "text": "کند مر جهان را همه زیردست"
  },
  {
    "poem_id": 1548,
    "vorder": 47,
    "position": 0,
    "text": "تو دانی که آنست اسفندیار"
  },
  {
    "poem_id": 1548,
    "vorder": 48,
    "position": 1,
    "text": "که اورا به رزم اندرون نیست یار"
  },
  {
    "poem_id": 1548,
    "vorder": 49,
    "position": 0,
    "text": "چنو حلقه کرد آن کمند بتاب"
  },
  {
    "poem_id": 1548,
    "vorder": 50,
    "position": 1,
    "text": "پذیره نیارد شدن آفتاب"
  },
  {
    "poem_id": 1548,
    "vorder": 51,
    "position": 0,
    "text": "کنون از شنیده بگفتمت راست"
  },
  {
    "poem_id": 1548,
    "vorder": 52,
    "position": 1,
    "text": "تو به دان کنون رای و فرمان تراست"
  },
  {
    "poem_id": 1548,
    "vorder": 53,
    "position": 0,
    "text": "چو با شاه ایران گُرَزم این براند"
  },
  {
    "poem_id": 1548,
    "vorder": 54,
    "position": 1,
    "text": "گو نامبردار خیره بماند"
  },
  {
    "poem_id": 1548,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت هرگز که دید این شگفت"
  },
  {
    "poem_id": 1548,
    "vorder": 56,
    "position": 1,
    "text": "دژم گشت وز پور کینه گرفت"
  },
  {
    "poem_id": 1548,
    "vorder": 57,
    "position": 0,
    "text": "نخورد ایچ می نیز و رامش نکرد"
  },
  {
    "poem_id": 1548,
    "vorder": 58,
    "position": 1,
    "text": "ابی بزم بنشست با باد سرد"
  },
  {
    "poem_id": 1548,
    "vorder": 59,
    "position": 0,
    "text": "از اندیشگان نامد آن شبش خواب"
  },
  {
    "poem_id": 1548,
    "vorder": 60,
    "position": 1,
    "text": "ز اسفندیارش گرفته شتاب"
  },
  {
    "poem_id": 1548,
    "vorder": 61,
    "position": 0,
    "text": "چو از کوهساران سپیده دمید"
  },
  {
    "poem_id": 1548,
    "vorder": 62,
    "position": 1,
    "text": "فروغ ستاره ببد ناپدید"
  },
  {
    "poem_id": 1548,
    "vorder": 63,
    "position": 0,
    "text": "بخواند آن جهاندیده جاماسپ را"
  },
  {
    "poem_id": 1548,
    "vorder": 64,
    "position": 1,
    "text": "کجا بیش دیدست لهراسپ را"
  },
  {
    "poem_id": 1548,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت شو پیش اسفندیار"
  },
  {
    "poem_id": 1548,
    "vorder": 66,
    "position": 1,
    "text": "بخوان و مر او را به ره باش یار"
  },
  {
    "poem_id": 1548,
    "vorder": 67,
    "position": 0,
    "text": "بگویش که برخیز و نزد من آی"
  },
  {
    "poem_id": 1548,
    "vorder": 68,
    "position": 1,
    "text": "چو نامه بخوانی به ره بر مپای"
  },
  {
    "poem_id": 1548,
    "vorder": 69,
    "position": 0,
    "text": "که کاری بزرگست پیش اندرا"
  },
  {
    "poem_id": 1548,
    "vorder": 70,
    "position": 1,
    "text": "تو پایی همی این همه کشورا"
  },
  {
    "poem_id": 1548,
    "vorder": 71,
    "position": 0,
    "text": "یکی کار اکنون همی بایدا"
  },
  {
    "poem_id": 1548,
    "vorder": 72,
    "position": 1,
    "text": "که بی‌تو چنین کار برنایدا"
  },
  {
    "poem_id": 1548,
    "vorder": 73,
    "position": 0,
    "text": "نوشته نوشتش یکی استوار"
  },
  {
    "poem_id": 1548,
    "vorder": 74,
    "position": 1,
    "text": "که ای نامور فرخ اسفندیار"
  },
  {
    "poem_id": 1548,
    "vorder": 75,
    "position": 0,
    "text": "فرستادم این پیر جاماسپ را"
  },
  {
    "poem_id": 1548,
    "vorder": 76,
    "position": 1,
    "text": "که دستور بد شاه لهراسپ را"
  },
  {
    "poem_id": 1548,
    "vorder": 77,
    "position": 0,
    "text": "چو او را ببینی میان را ببند"
  },
  {
    "poem_id": 1548,
    "vorder": 78,
    "position": 1,
    "text": "ابا او بیا بر ستور نوند"
  },
  {
    "poem_id": 1548,
    "vorder": 79,
    "position": 0,
    "text": "اگر خفته‌ای زود برجه به پای"
  },
  {
    "poem_id": 1548,
    "vorder": 80,
    "position": 1,
    "text": "وگر خود بپایی زمانی مپای"
  },
  {
    "poem_id": 1548,
    "vorder": 81,
    "position": 0,
    "text": "خردمند شد نامهٔ شاه برد"
  },
  {
    "poem_id": 1548,
    "vorder": 82,
    "position": 1,
    "text": "به تازنده کوه و بیابان سپرد"
  }
]