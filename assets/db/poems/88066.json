[
  {
    "poem_id": 88066,
    "vorder": 1,
    "position": 0,
    "text": "چو روشن شد آن چادر لاژورد"
  },
  {
    "poem_id": 88066,
    "vorder": 2,
    "position": 1,
    "text": "جهان شد به کردار یاقوت زرد"
  },
  {
    "poem_id": 88066,
    "vorder": 3,
    "position": 0,
    "text": "نشست از بر اسب جنگی پشنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 4,
    "position": 1,
    "text": "ز باد جوانی سرش پر ز جنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 5,
    "position": 0,
    "text": "به  جوشن بپوشید روشن برش"
  },
  {
    "poem_id": 88066,
    "vorder": 6,
    "position": 1,
    "text": "ز آهن کلاه کیان بر سرش"
  },
  {
    "poem_id": 88066,
    "vorder": 7,
    "position": 0,
    "text": "درفشش یکی ترک جنگی به چنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 8,
    "position": 1,
    "text": "خرامان بیامد به سان پلنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 9,
    "position": 0,
    "text": "چو آمد به نزدیک ایران سپاه"
  },
  {
    "poem_id": 88066,
    "vorder": 10,
    "position": 1,
    "text": "یکی نامداری بشد نزد شاه"
  },
  {
    "poem_id": 88066,
    "vorder": 11,
    "position": 0,
    "text": "که آمد سواری میان دو صف"
  },
  {
    "poem_id": 88066,
    "vorder": 12,
    "position": 1,
    "text": "سرافراز و جوشان و تیغی به کف"
  },
  {
    "poem_id": 88066,
    "vorder": 13,
    "position": 0,
    "text": "بخندید از او شاه و جوشن بخواست"
  },
  {
    "poem_id": 88066,
    "vorder": 14,
    "position": 1,
    "text": "درفش بزرگی برآورد راست"
  },
  {
    "poem_id": 88066,
    "vorder": 15,
    "position": 0,
    "text": "یکی ترگ زرین به سر بر نهاد"
  },
  {
    "poem_id": 88066,
    "vorder": 16,
    "position": 1,
    "text": "درفشش به رهام گودرز داد"
  },
  {
    "poem_id": 88066,
    "vorder": 17,
    "position": 0,
    "text": "همه لشکرش زار و گریان شدند"
  },
  {
    "poem_id": 88066,
    "vorder": 18,
    "position": 1,
    "text": "چو بر آتش تیز بریان شدند"
  },
  {
    "poem_id": 88066,
    "vorder": 19,
    "position": 0,
    "text": "خروشی بر آمد که ای شهریار"
  },
  {
    "poem_id": 88066,
    "vorder": 20,
    "position": 1,
    "text": "به آهن تن خویش رنجه مدار"
  },
  {
    "poem_id": 88066,
    "vorder": 21,
    "position": 0,
    "text": "شهان را همه تخت بودی نشست"
  },
  {
    "poem_id": 88066,
    "vorder": 22,
    "position": 1,
    "text": "که بر کین کمر بر میان تو بست"
  },
  {
    "poem_id": 88066,
    "vorder": 23,
    "position": 0,
    "text": "که جز خاک تیره نشستش مباد"
  },
  {
    "poem_id": 88066,
    "vorder": 24,
    "position": 1,
    "text": "به هیچ آرزو کام و دستش مباد"
  },
  {
    "poem_id": 88066,
    "vorder": 25,
    "position": 0,
    "text": "سپهدار با جوشن و گرز و خود"
  },
  {
    "poem_id": 88066,
    "vorder": 26,
    "position": 1,
    "text": "به لشکر فرستاد چندی درود"
  },
  {
    "poem_id": 88066,
    "vorder": 27,
    "position": 0,
    "text": "که یک تن مجنبید ز این رزمگاه"
  },
  {
    "poem_id": 88066,
    "vorder": 28,
    "position": 1,
    "text": "چپ و راست و قلب و جناح سپاه"
  },
  {
    "poem_id": 88066,
    "vorder": 29,
    "position": 0,
    "text": "نباید که جوید کسی جنگ و جوش"
  },
  {
    "poem_id": 88066,
    "vorder": 30,
    "position": 1,
    "text": "به رهام گودرز دارید گوش"
  },
  {
    "poem_id": 88066,
    "vorder": 31,
    "position": 0,
    "text": "چو خورشید بر چرخ گردد بلند"
  },
  {
    "poem_id": 88066,
    "vorder": 32,
    "position": 1,
    "text": "ببینید تا بر که آید گزند"
  },
  {
    "poem_id": 88066,
    "vorder": 33,
    "position": 0,
    "text": "شما هیچ دل را مدارید تنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 34,
    "position": 1,
    "text": "چنینست آغاز و فرجام جنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 35,
    "position": 0,
    "text": "گهی بر فراز و گهی در نشیب"
  },
  {
    "poem_id": 88066,
    "vorder": 36,
    "position": 1,
    "text": "گهی شادکامی گهی با نهیب"
  },
  {
    "poem_id": 88066,
    "vorder": 37,
    "position": 0,
    "text": "برانگیخت شبرنگ بهزاد را"
  },
  {
    "poem_id": 88066,
    "vorder": 38,
    "position": 1,
    "text": "که دریافتی روز تگ باد را"
  },
  {
    "poem_id": 88066,
    "vorder": 39,
    "position": 0,
    "text": "میان بسته با نیزه و خود و گبر"
  },
  {
    "poem_id": 88066,
    "vorder": 40,
    "position": 1,
    "text": "همی گرد اسبش بر آمد به ابر"
  },
  {
    "poem_id": 88066,
    "vorder": 41,
    "position": 0,
    "text": "میان دو صف شیده او را بدید"
  },
  {
    "poem_id": 88066,
    "vorder": 42,
    "position": 1,
    "text": "یکی باد سرد از جگر بر کشید"
  },
  {
    "poem_id": 88066,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت پور سیاوش رد"
  },
  {
    "poem_id": 88066,
    "vorder": 44,
    "position": 1,
    "text": "توی ای پسندیدهٔ پرخرد"
  },
  {
    "poem_id": 88066,
    "vorder": 45,
    "position": 0,
    "text": "نبیره جهاندار توران سپاه"
  },
  {
    "poem_id": 88066,
    "vorder": 46,
    "position": 1,
    "text": "که ساید همی ترگ بر چرخ ماه"
  },
  {
    "poem_id": 88066,
    "vorder": 47,
    "position": 0,
    "text": "جز آنی که بر تو گمانی برد"
  },
  {
    "poem_id": 88066,
    "vorder": 48,
    "position": 1,
    "text": "جهاندیده‌ای کو خرد پرورد"
  },
  {
    "poem_id": 88066,
    "vorder": 49,
    "position": 0,
    "text": "اگر مغز بودیت با خال خویش"
  },
  {
    "poem_id": 88066,
    "vorder": 50,
    "position": 1,
    "text": "نکردی چنین جنگ را دست پیش"
  },
  {
    "poem_id": 88066,
    "vorder": 51,
    "position": 0,
    "text": "اگر جنگ‌جویی ز پیش سپاه"
  },
  {
    "poem_id": 88066,
    "vorder": 52,
    "position": 1,
    "text": "برو دور بگزین یکی رزمگاه"
  },
  {
    "poem_id": 88066,
    "vorder": 53,
    "position": 0,
    "text": "کز ایران و توران نبینند کس"
  },
  {
    "poem_id": 88066,
    "vorder": 54,
    "position": 1,
    "text": "نخواهیم یاران فریادرس"
  },
  {
    "poem_id": 88066,
    "vorder": 55,
    "position": 0,
    "text": "چنین داد پاسخ بدو شهریار"
  },
  {
    "poem_id": 88066,
    "vorder": 56,
    "position": 1,
    "text": "که ای شیر درنده در کارزار"
  },
  {
    "poem_id": 88066,
    "vorder": 57,
    "position": 0,
    "text": "منم داغ‌دل پور آن بیگناه"
  },
  {
    "poem_id": 88066,
    "vorder": 58,
    "position": 1,
    "text": "سیاوش که شد کشته بر دست شاه"
  },
  {
    "poem_id": 88066,
    "vorder": 59,
    "position": 0,
    "text": "بدین دشت از ایران به کین آمدم"
  },
  {
    "poem_id": 88066,
    "vorder": 60,
    "position": 1,
    "text": "نه از بهر گاه و نگین آمدم"
  },
  {
    "poem_id": 88066,
    "vorder": 61,
    "position": 0,
    "text": "ز پیش پدر چون که برخاستی"
  },
  {
    "poem_id": 88066,
    "vorder": 62,
    "position": 1,
    "text": "ز لشکر نبرد مرا خواستی"
  },
  {
    "poem_id": 88066,
    "vorder": 63,
    "position": 0,
    "text": "مرا خواستی کس نبودی روا"
  },
  {
    "poem_id": 88066,
    "vorder": 64,
    "position": 1,
    "text": "که پیشت فرستادمی ناسزا"
  },
  {
    "poem_id": 88066,
    "vorder": 65,
    "position": 0,
    "text": "کنون آرزو کن یکی رزمگاه"
  },
  {
    "poem_id": 88066,
    "vorder": 66,
    "position": 1,
    "text": "به دیدار دور از میان سپاه"
  },
  {
    "poem_id": 88066,
    "vorder": 67,
    "position": 0,
    "text": "نهادند پیمان که از هر دو روی"
  },
  {
    "poem_id": 88066,
    "vorder": 68,
    "position": 1,
    "text": "به یاری نیاید کسی کینه‌جوی"
  },
  {
    "poem_id": 88066,
    "vorder": 69,
    "position": 0,
    "text": "هم اینها که دارند با ما درفش"
  },
  {
    "poem_id": 88066,
    "vorder": 70,
    "position": 1,
    "text": "ز بد روی ایشان نگردد بنفش"
  },
  {
    "poem_id": 88066,
    "vorder": 71,
    "position": 0,
    "text": "برفتند هر دو ز لشکر به دور"
  },
  {
    "poem_id": 88066,
    "vorder": 72,
    "position": 1,
    "text": "چنانچون شود مرد شادان به سور"
  },
  {
    "poem_id": 88066,
    "vorder": 73,
    "position": 0,
    "text": "بیابان که آن از در رزم بود"
  },
  {
    "poem_id": 88066,
    "vorder": 74,
    "position": 1,
    "text": "بدان جایگه مرز خوارزم بود"
  },
  {
    "poem_id": 88066,
    "vorder": 75,
    "position": 0,
    "text": "رسیدند جایی که شیر و پلنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 76,
    "position": 1,
    "text": "بدان شخ بی آب ننهاد چنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 77,
    "position": 0,
    "text": "نپرید بر آسمانش عقاب"
  },
  {
    "poem_id": 88066,
    "vorder": 78,
    "position": 1,
    "text": "از او بهره‌ای شخ و بهری سراب"
  },
  {
    "poem_id": 88066,
    "vorder": 79,
    "position": 0,
    "text": "نهادند آوردگاهی بزرگ"
  },
  {
    "poem_id": 88066,
    "vorder": 80,
    "position": 1,
    "text": "دو اسب و دو جنگی به سان دو گرگ"
  },
  {
    "poem_id": 88066,
    "vorder": 81,
    "position": 0,
    "text": "سواران چو شیران اخته زهار"
  },
  {
    "poem_id": 88066,
    "vorder": 82,
    "position": 1,
    "text": "که باشند پر خشم روز شکار"
  },
  {
    "poem_id": 88066,
    "vorder": 83,
    "position": 0,
    "text": "بگشتند با نیزه‌های دراز"
  },
  {
    "poem_id": 88066,
    "vorder": 84,
    "position": 1,
    "text": "چو خورشید تابنده گشت از فراز"
  },
  {
    "poem_id": 88066,
    "vorder": 85,
    "position": 0,
    "text": "نماند ایچ بر نیزه‌هاشان سنان"
  },
  {
    "poem_id": 88066,
    "vorder": 86,
    "position": 1,
    "text": "پر از آب برگستوان و عنان"
  },
  {
    "poem_id": 88066,
    "vorder": 87,
    "position": 0,
    "text": "به رومی عمود و به شمشیر و تیر"
  },
  {
    "poem_id": 88066,
    "vorder": 88,
    "position": 1,
    "text": "بگشتند با یکدگر ناگزیر"
  },
  {
    "poem_id": 88066,
    "vorder": 89,
    "position": 0,
    "text": "زمین شد ز گرد سواران سیاه"
  },
  {
    "poem_id": 88066,
    "vorder": 90,
    "position": 1,
    "text": "نگشتند سیر اندر آوردگاه"
  },
  {
    "poem_id": 88066,
    "vorder": 91,
    "position": 0,
    "text": "چو شیده دل و زور خسرو بدید"
  },
  {
    "poem_id": 88066,
    "vorder": 92,
    "position": 1,
    "text": "ز مژگان سرشکش به رخ برچکید"
  },
  {
    "poem_id": 88066,
    "vorder": 93,
    "position": 0,
    "text": "بدانست کان فره ایزدیست"
  },
  {
    "poem_id": 88066,
    "vorder": 94,
    "position": 1,
    "text": "از او بر تن خویش باید گریست"
  },
  {
    "poem_id": 88066,
    "vorder": 95,
    "position": 0,
    "text": "همان اسبش از تشنگی شد غمی"
  },
  {
    "poem_id": 88066,
    "vorder": 96,
    "position": 1,
    "text": "به نیروی مرد اندر آمد کمی"
  },
  {
    "poem_id": 88066,
    "vorder": 97,
    "position": 0,
    "text": "چو درمانده شد با دل اندیشه کرد"
  },
  {
    "poem_id": 88066,
    "vorder": 98,
    "position": 1,
    "text": "که گر شاه را گویم اندر نبرد"
  },
  {
    "poem_id": 88066,
    "vorder": 99,
    "position": 0,
    "text": "بیا تا به کشتی پیاده شویم"
  },
  {
    "poem_id": 88066,
    "vorder": 100,
    "position": 1,
    "text": "ز خوی هر دو آهار داده شویم"
  },
  {
    "poem_id": 88066,
    "vorder": 101,
    "position": 0,
    "text": "پیاده نگردد که عار آیدش"
  },
  {
    "poem_id": 88066,
    "vorder": 102,
    "position": 1,
    "text": "ز شاهی تن خویش خوار آیدش"
  },
  {
    "poem_id": 88066,
    "vorder": 103,
    "position": 0,
    "text": "بدین چاره گر ز او نیابم رها"
  },
  {
    "poem_id": 88066,
    "vorder": 104,
    "position": 1,
    "text": "شدم بی گمان در دم اژدها"
  },
  {
    "poem_id": 88066,
    "vorder": 105,
    "position": 0,
    "text": "بدو گفت شاها به تیغ و سنان"
  },
  {
    "poem_id": 88066,
    "vorder": 106,
    "position": 1,
    "text": "کند هر کسی جنگ و پیچد عنان"
  },
  {
    "poem_id": 88066,
    "vorder": 107,
    "position": 0,
    "text": "پیاده به آید که جوییم جنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 108,
    "position": 1,
    "text": "به کردار شیران بیازیم چنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 109,
    "position": 0,
    "text": "جهاندار خسرو هم اندر زمان"
  },
  {
    "poem_id": 88066,
    "vorder": 110,
    "position": 1,
    "text": "بدانست اندیشهٔ بدگمان"
  },
  {
    "poem_id": 88066,
    "vorder": 111,
    "position": 0,
    "text": "به دل گفت کاین شیر با زور و چنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 112,
    "position": 1,
    "text": "نبیره فریدون و پور پشنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 113,
    "position": 0,
    "text": "گر آسوده گردد تن آسان کند"
  },
  {
    "poem_id": 88066,
    "vorder": 114,
    "position": 1,
    "text": "بسی شیر دل را هراسان کند"
  },
  {
    "poem_id": 88066,
    "vorder": 115,
    "position": 0,
    "text": "اگر من پیاده نگردم به جنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 116,
    "position": 1,
    "text": "به ایرانیان بر کند جای تنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 117,
    "position": 0,
    "text": "بدو گفت رهام کای تاجور"
  },
  {
    "poem_id": 88066,
    "vorder": 118,
    "position": 1,
    "text": "بدین کار ننگی مگردان گهر"
  },
  {
    "poem_id": 88066,
    "vorder": 119,
    "position": 0,
    "text": "چو خسرو پیاده کند کارزار"
  },
  {
    "poem_id": 88066,
    "vorder": 120,
    "position": 1,
    "text": "چه باید بر این دشت چندین سوار"
  },
  {
    "poem_id": 88066,
    "vorder": 121,
    "position": 0,
    "text": "اگر پای بر خاک باید نهاد"
  },
  {
    "poem_id": 88066,
    "vorder": 122,
    "position": 1,
    "text": "من از تخم کشواد دارم نژاد"
  },
  {
    "poem_id": 88066,
    "vorder": 123,
    "position": 0,
    "text": "بمان تا شوم پیش او جنگ‌ساز"
  },
  {
    "poem_id": 88066,
    "vorder": 124,
    "position": 1,
    "text": "نه شاه جهاندار گردن فراز"
  },
  {
    "poem_id": 88066,
    "vorder": 125,
    "position": 0,
    "text": "به رهام گفت آن زمان شهریار"
  },
  {
    "poem_id": 88066,
    "vorder": 126,
    "position": 1,
    "text": "که ای مهربان پهلوان سوار"
  },
  {
    "poem_id": 88066,
    "vorder": 127,
    "position": 0,
    "text": "چو شیده دلاور ز تخم پشنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 128,
    "position": 1,
    "text": "چنان دان که با تو نیاید به جنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 129,
    "position": 0,
    "text": "ترا نیز با رزم او پای نیست"
  },
  {
    "poem_id": 88066,
    "vorder": 130,
    "position": 1,
    "text": "به ترکان چون او لشکر آرای نیست"
  },
  {
    "poem_id": 88066,
    "vorder": 131,
    "position": 0,
    "text": "یکی مرد جنگی فریدون نژاد"
  },
  {
    "poem_id": 88066,
    "vorder": 132,
    "position": 1,
    "text": "که چون او دلاور ز مادر نزاد"
  },
  {
    "poem_id": 88066,
    "vorder": 133,
    "position": 0,
    "text": "نباشد مرا ننگ رفتن به جنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 134,
    "position": 1,
    "text": "پیاده بسازیم جنگ پلنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 135,
    "position": 0,
    "text": "وزان سو بر شیده شد ترجمان"
  },
  {
    "poem_id": 88066,
    "vorder": 136,
    "position": 1,
    "text": "که دوری گزین از بد بدگمان"
  },
  {
    "poem_id": 88066,
    "vorder": 137,
    "position": 0,
    "text": "جز از بازگشتن ترا رای نیست"
  },
  {
    "poem_id": 88066,
    "vorder": 138,
    "position": 1,
    "text": "که با جنگ خسرو ترا پای نیست"
  },
  {
    "poem_id": 88066,
    "vorder": 139,
    "position": 0,
    "text": "به هنگام کردن ز دشمن گریز"
  },
  {
    "poem_id": 88066,
    "vorder": 140,
    "position": 1,
    "text": "به از کشتن و جستن رستخیز"
  },
  {
    "poem_id": 88066,
    "vorder": 141,
    "position": 0,
    "text": "بدان نامور ترجمان شیده گفت"
  },
  {
    "poem_id": 88066,
    "vorder": 142,
    "position": 1,
    "text": "که آورد مردان نشاید نهفت"
  },
  {
    "poem_id": 88066,
    "vorder": 143,
    "position": 0,
    "text": "چنان دان که تا من ببستم کمر"
  },
  {
    "poem_id": 88066,
    "vorder": 144,
    "position": 1,
    "text": "همی برفرازم به خورشید سر"
  },
  {
    "poem_id": 88066,
    "vorder": 145,
    "position": 0,
    "text": "بدین زور و این فره و دستبرد"
  },
  {
    "poem_id": 88066,
    "vorder": 146,
    "position": 1,
    "text": "ندیدم به آوردگه نیز گرد"
  },
  {
    "poem_id": 88066,
    "vorder": 147,
    "position": 0,
    "text": "ولیکن ستودان مرا از گریز"
  },
  {
    "poem_id": 88066,
    "vorder": 148,
    "position": 1,
    "text": "به آید چو گیرم به کاری ستیز"
  },
  {
    "poem_id": 88066,
    "vorder": 149,
    "position": 0,
    "text": "هم از گردش چرخ بر بگذرم"
  },
  {
    "poem_id": 88066,
    "vorder": 150,
    "position": 1,
    "text": "وگر دیدهٔ اژدها بسپرم"
  },
  {
    "poem_id": 88066,
    "vorder": 151,
    "position": 0,
    "text": "گر ایدر مرا هوش بر دست اوست"
  },
  {
    "poem_id": 88066,
    "vorder": 152,
    "position": 1,
    "text": "نه دشمن ز من باز دارد نه دوست"
  },
  {
    "poem_id": 88066,
    "vorder": 153,
    "position": 0,
    "text": "ندانم من این زور مردی ز چیست"
  },
  {
    "poem_id": 88066,
    "vorder": 154,
    "position": 1,
    "text": "بر این نامور فره ایزدیست"
  },
  {
    "poem_id": 88066,
    "vorder": 155,
    "position": 0,
    "text": "پیاده مگر دست یابم بدوی"
  },
  {
    "poem_id": 88066,
    "vorder": 156,
    "position": 1,
    "text": "به پیکار خون اندر آرم به جوی"
  },
  {
    "poem_id": 88066,
    "vorder": 157,
    "position": 0,
    "text": "به شیده چنین گفت شاه جهان"
  },
  {
    "poem_id": 88066,
    "vorder": 158,
    "position": 1,
    "text": "که ای نامدار از نژاد مهان"
  },
  {
    "poem_id": 88066,
    "vorder": 159,
    "position": 0,
    "text": "ز تخم کیان بی گمان کس نبود"
  },
  {
    "poem_id": 88066,
    "vorder": 160,
    "position": 1,
    "text": "که هرگز پیاده نبرد آزمود"
  },
  {
    "poem_id": 88066,
    "vorder": 161,
    "position": 0,
    "text": "ولیکن ترا گر چنینست کام"
  },
  {
    "poem_id": 88066,
    "vorder": 162,
    "position": 1,
    "text": "نپیچم ز رای تو هرگز لگام"
  },
  {
    "poem_id": 88066,
    "vorder": 163,
    "position": 0,
    "text": "فرود آمد از اسب شبرنگ شاه"
  },
  {
    "poem_id": 88066,
    "vorder": 164,
    "position": 1,
    "text": "ز سر برگرفت آن کیانی کلاه"
  },
  {
    "poem_id": 88066,
    "vorder": 165,
    "position": 0,
    "text": "به رهام داد آن گرانمایه اسب"
  },
  {
    "poem_id": 88066,
    "vorder": 166,
    "position": 1,
    "text": "پیاده بیامد چو آذرگشسب"
  },
  {
    "poem_id": 88066,
    "vorder": 167,
    "position": 0,
    "text": "پیاده چو از دور دیدش پشنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 168,
    "position": 1,
    "text": "فرود آمد از باره جنگی پلنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 169,
    "position": 0,
    "text": "به هامون چو پیلان بر آویختند"
  },
  {
    "poem_id": 88066,
    "vorder": 170,
    "position": 1,
    "text": "همی خاک با خون برآمیختند"
  },
  {
    "poem_id": 88066,
    "vorder": 171,
    "position": 0,
    "text": "چو شیده بدید آن بر و برز شاه"
  },
  {
    "poem_id": 88066,
    "vorder": 172,
    "position": 1,
    "text": "همان ایزدی فر و آن دستگاه"
  },
  {
    "poem_id": 88066,
    "vorder": 173,
    "position": 0,
    "text": "همی جست کآید مگر ز او رها"
  },
  {
    "poem_id": 88066,
    "vorder": 174,
    "position": 1,
    "text": "که چون سر بشد تن نیارد بها"
  },
  {
    "poem_id": 88066,
    "vorder": 175,
    "position": 0,
    "text": "چو آگاه شد خسرو از رای اوی"
  },
  {
    "poem_id": 88066,
    "vorder": 176,
    "position": 1,
    "text": "وز آن زور و آن برز بالای اوی"
  },
  {
    "poem_id": 88066,
    "vorder": 177,
    "position": 0,
    "text": "گرفتش به چپ گردن و راست پشت"
  },
  {
    "poem_id": 88066,
    "vorder": 178,
    "position": 1,
    "text": "برآورد و زد بر زمین بر درشت"
  },
  {
    "poem_id": 88066,
    "vorder": 179,
    "position": 0,
    "text": "همه مهرهٔ پشت او همچو نی"
  },
  {
    "poem_id": 88066,
    "vorder": 180,
    "position": 1,
    "text": "شد از درد ریزان و بگسست پی"
  },
  {
    "poem_id": 88066,
    "vorder": 181,
    "position": 0,
    "text": "یکی تیغ تیز از میان بر کشید"
  },
  {
    "poem_id": 88066,
    "vorder": 182,
    "position": 1,
    "text": "سراسر دل نامور بر درید"
  },
  {
    "poem_id": 88066,
    "vorder": 183,
    "position": 0,
    "text": "بر او کرد جوشن همه چاک چاک"
  },
  {
    "poem_id": 88066,
    "vorder": 184,
    "position": 1,
    "text": "همی ریخت بر تارک از درد خاک"
  },
  {
    "poem_id": 88066,
    "vorder": 185,
    "position": 0,
    "text": "به رهام گفت این بد بدسگال"
  },
  {
    "poem_id": 88066,
    "vorder": 186,
    "position": 1,
    "text": "دلیر و سبکسر مرا بود خال"
  },
  {
    "poem_id": 88066,
    "vorder": 187,
    "position": 0,
    "text": "پس از کشتنش مهربانی کنید"
  },
  {
    "poem_id": 88066,
    "vorder": 188,
    "position": 1,
    "text": "یکی دخمهٔ خسروانی کنید"
  },
  {
    "poem_id": 88066,
    "vorder": 189,
    "position": 0,
    "text": "تنش را به مشک و عبیر و گلاب"
  },
  {
    "poem_id": 88066,
    "vorder": 190,
    "position": 1,
    "text": "بشویید مغزش به کافور ناب"
  },
  {
    "poem_id": 88066,
    "vorder": 191,
    "position": 0,
    "text": "به گردنش بر طوق مشکین نهید"
  },
  {
    "poem_id": 88066,
    "vorder": 192,
    "position": 1,
    "text": "کله بر سرش عنبرآگین نهید"
  },
  {
    "poem_id": 88066,
    "vorder": 193,
    "position": 0,
    "text": "نگه کرد پس ترجمانش ز راه"
  },
  {
    "poem_id": 88066,
    "vorder": 194,
    "position": 1,
    "text": "بدید آن تن نامبردار شاه"
  },
  {
    "poem_id": 88066,
    "vorder": 195,
    "position": 0,
    "text": "که با خون از آن ریگ برداشتند"
  },
  {
    "poem_id": 88066,
    "vorder": 196,
    "position": 1,
    "text": "سوی لشکر شاه بگذاشتند"
  },
  {
    "poem_id": 88066,
    "vorder": 197,
    "position": 0,
    "text": "بیامد خروشان به نزدیک شاه"
  },
  {
    "poem_id": 88066,
    "vorder": 198,
    "position": 1,
    "text": "که ای نامور دادگر پیشگاه"
  },
  {
    "poem_id": 88066,
    "vorder": 199,
    "position": 0,
    "text": "یکی بنده بودم من او را نوان"
  },
  {
    "poem_id": 88066,
    "vorder": 200,
    "position": 1,
    "text": "نه جنگی سواری و نه پهلوان"
  },
  {
    "poem_id": 88066,
    "vorder": 201,
    "position": 0,
    "text": "به من بر ببخشای شاها به مهر"
  },
  {
    "poem_id": 88066,
    "vorder": 202,
    "position": 1,
    "text": "که از جان تو شاد بادا سپهر"
  },
  {
    "poem_id": 88066,
    "vorder": 203,
    "position": 0,
    "text": "بدو گفت شاه آنچه دیدی ز من"
  },
  {
    "poem_id": 88066,
    "vorder": 204,
    "position": 1,
    "text": "نیا را بگوی اندر آن انجمن"
  },
  {
    "poem_id": 88066,
    "vorder": 205,
    "position": 0,
    "text": "زمین را ببوسید و کرد آفرین"
  },
  {
    "poem_id": 88066,
    "vorder": 206,
    "position": 1,
    "text": "بسیچید ره سوی سالار چین"
  },
  {
    "poem_id": 88066,
    "vorder": 207,
    "position": 0,
    "text": "وز آن دشت کیخسرو کینه‌جوی"
  },
  {
    "poem_id": 88066,
    "vorder": 208,
    "position": 1,
    "text": "سوی لشکر خویش بنهاد روی"
  },
  {
    "poem_id": 88066,
    "vorder": 209,
    "position": 0,
    "text": "خروشی بر آمد ز ایران سپاه"
  },
  {
    "poem_id": 88066,
    "vorder": 210,
    "position": 1,
    "text": "که بخشایش آورد خورشید و ماه"
  },
  {
    "poem_id": 88066,
    "vorder": 211,
    "position": 0,
    "text": "بیامد همانگاه گودرز و گیو"
  },
  {
    "poem_id": 88066,
    "vorder": 212,
    "position": 1,
    "text": "چو شیدوش و رستم چو گرگین نیو"
  },
  {
    "poem_id": 88066,
    "vorder": 213,
    "position": 0,
    "text": "همه بوسه دادند پیشش زمین"
  },
  {
    "poem_id": 88066,
    "vorder": 214,
    "position": 1,
    "text": "بسی شاه را خواندند آفرین"
  },
  {
    "poem_id": 88066,
    "vorder": 215,
    "position": 0,
    "text": "وز آن روی ترکان دو دیده به راه"
  },
  {
    "poem_id": 88066,
    "vorder": 216,
    "position": 1,
    "text": "که شیده کی آید ز آوردگاه"
  },
  {
    "poem_id": 88066,
    "vorder": 217,
    "position": 0,
    "text": "سواری همی شد بر آن ریگ نرم"
  },
  {
    "poem_id": 88066,
    "vorder": 218,
    "position": 1,
    "text": "برهنه سر و دیده پر خون و گرم"
  },
  {
    "poem_id": 88066,
    "vorder": 219,
    "position": 0,
    "text": "بیامد به نزدیک افراسیاب"
  },
  {
    "poem_id": 88066,
    "vorder": 220,
    "position": 1,
    "text": "دل از درد خسته دو دیده پر آب"
  },
  {
    "poem_id": 88066,
    "vorder": 221,
    "position": 0,
    "text": "برآورد پوشیده راز از نهفت"
  },
  {
    "poem_id": 88066,
    "vorder": 222,
    "position": 1,
    "text": "همه پیش سالار ترکان بگفت"
  },
  {
    "poem_id": 88066,
    "vorder": 223,
    "position": 0,
    "text": "جهاندار گشت از جهان ناامید"
  },
  {
    "poem_id": 88066,
    "vorder": 224,
    "position": 1,
    "text": "بکند آن چو کافور موی سپید"
  },
  {
    "poem_id": 88066,
    "vorder": 225,
    "position": 0,
    "text": "به سر بر پراگند ریگ روان"
  },
  {
    "poem_id": 88066,
    "vorder": 226,
    "position": 1,
    "text": "ز لشکر برفت آن که بد پهلوان"
  },
  {
    "poem_id": 88066,
    "vorder": 227,
    "position": 0,
    "text": "رخ شاه ترکان هر آن کس که دید"
  },
  {
    "poem_id": 88066,
    "vorder": 228,
    "position": 1,
    "text": "بر و جامه و دل همه بردرید"
  },
  {
    "poem_id": 88066,
    "vorder": 229,
    "position": 0,
    "text": "چنین گفت با مویه افراسیاب"
  },
  {
    "poem_id": 88066,
    "vorder": 230,
    "position": 1,
    "text": "کز این پس نه آرام جویم نه خواب"
  },
  {
    "poem_id": 88066,
    "vorder": 231,
    "position": 0,
    "text": "مرا اندر این سوگ یاری کنید"
  },
  {
    "poem_id": 88066,
    "vorder": 232,
    "position": 1,
    "text": "همه تن به تن سوگواری کنید"
  },
  {
    "poem_id": 88066,
    "vorder": 233,
    "position": 0,
    "text": "نه بیند سر تیغ ما را نیام"
  },
  {
    "poem_id": 88066,
    "vorder": 234,
    "position": 1,
    "text": "نه هرگز بوم ز این سپس شادکام"
  },
  {
    "poem_id": 88066,
    "vorder": 235,
    "position": 0,
    "text": "ز مردم شمر ار ز دام و دده"
  },
  {
    "poem_id": 88066,
    "vorder": 236,
    "position": 1,
    "text": "دلی کاو نباشد به درد آژده"
  },
  {
    "poem_id": 88066,
    "vorder": 237,
    "position": 0,
    "text": "مبادا بدان دیده در آب و شرم"
  },
  {
    "poem_id": 88066,
    "vorder": 238,
    "position": 1,
    "text": "که از درد ما نیست پر خون گرم"
  },
  {
    "poem_id": 88066,
    "vorder": 239,
    "position": 0,
    "text": "از آن ماه‌دیدار جنگی سوار"
  },
  {
    "poem_id": 88066,
    "vorder": 240,
    "position": 1,
    "text": "از آن سروبن بر لب جویبار"
  },
  {
    "poem_id": 88066,
    "vorder": 241,
    "position": 0,
    "text": "همی ریخت از دیده خونین سرشک"
  },
  {
    "poem_id": 88066,
    "vorder": 242,
    "position": 1,
    "text": "ز دردی که درمان نداند پزشک"
  },
  {
    "poem_id": 88066,
    "vorder": 243,
    "position": 0,
    "text": "همه نامداران پاسخ‌گزار"
  },
  {
    "poem_id": 88066,
    "vorder": 244,
    "position": 1,
    "text": "زبان برگشادند بر شهریار"
  },
  {
    "poem_id": 88066,
    "vorder": 245,
    "position": 0,
    "text": "که این دادگر بر تو آسان کناد"
  },
  {
    "poem_id": 88066,
    "vorder": 246,
    "position": 1,
    "text": "بداندیش را دل هراسان کناد"
  },
  {
    "poem_id": 88066,
    "vorder": 247,
    "position": 0,
    "text": "ز ما نیز یک تن نسازد درنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 248,
    "position": 1,
    "text": "شب و روز بر درد و کین پشنگ"
  },
  {
    "poem_id": 88066,
    "vorder": 249,
    "position": 0,
    "text": "سپه را همه دل خروشان کنیم"
  },
  {
