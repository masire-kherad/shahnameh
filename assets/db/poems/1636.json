[
  {
    "poem_id": 1636,
    "vorder": 1,
    "position": 0,
    "text": "دبیر جهاندیده را پیش خواند"
  },
  {
    "poem_id": 1636,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد نزدیک گاهش نشاند"
  },
  {
    "poem_id": 1636,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامه بنوشت با داغ و درد"
  },
  {
    "poem_id": 1636,
    "vorder": 4,
    "position": 1,
    "text": "دو دیده پر از خون و رخ لاژورد"
  },
  {
    "poem_id": 1636,
    "vorder": 5,
    "position": 0,
    "text": "ز دارای داراب بن اردشیر"
  },
  {
    "poem_id": 1636,
    "vorder": 6,
    "position": 1,
    "text": "سوی قیصر اسکندر شهرگیر"
  },
  {
    "poem_id": 1636,
    "vorder": 7,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1636,
    "vorder": 8,
    "position": 1,
    "text": "که زو دید نیک و بد روزگار"
  },
  {
    "poem_id": 1636,
    "vorder": 9,
    "position": 0,
    "text": "دگر گفت کز گردش آسمان"
  },
  {
    "poem_id": 1636,
    "vorder": 10,
    "position": 1,
    "text": "خردمند برنگذرد بی‌گمان"
  },
  {
    "poem_id": 1636,
    "vorder": 11,
    "position": 0,
    "text": "کزو شادمانیم و زو ناشکیب"
  },
  {
    "poem_id": 1636,
    "vorder": 12,
    "position": 1,
    "text": "گهی در فراز و گهی در نشیب"
  },
  {
    "poem_id": 1636,
    "vorder": 13,
    "position": 0,
    "text": "نه مردی بد این رزم ما با سپاه"
  },
  {
    "poem_id": 1636,
    "vorder": 14,
    "position": 1,
    "text": "مگر بخشش و گردش هور و ماه"
  },
  {
    "poem_id": 1636,
    "vorder": 15,
    "position": 0,
    "text": "کنون بودنی بود و ما دل به درد"
  },
  {
    "poem_id": 1636,
    "vorder": 16,
    "position": 1,
    "text": "چه داریم ازین گنبد لاژورد"
  },
  {
    "poem_id": 1636,
    "vorder": 17,
    "position": 0,
    "text": "کنون گر بسازی و پیمان کنی"
  },
  {
    "poem_id": 1636,
    "vorder": 18,
    "position": 1,
    "text": "دل از جنگ ایران پشیمان کنی"
  },
  {
    "poem_id": 1636,
    "vorder": 19,
    "position": 0,
    "text": "همه گنج گشتاسپ و اسفندیار"
  },
  {
    "poem_id": 1636,
    "vorder": 20,
    "position": 1,
    "text": "همان یاره و تاج گوهرنگار"
  },
  {
    "poem_id": 1636,
    "vorder": 21,
    "position": 0,
    "text": "فرستم به گنج تو از گنج خویش"
  },
  {
    "poem_id": 1636,
    "vorder": 22,
    "position": 1,
    "text": "همان نیز ورزیدهٔ رنج خویش"
  },
  {
    "poem_id": 1636,
    "vorder": 23,
    "position": 0,
    "text": "همان مر ترا یار باشم به جنگ"
  },
  {
    "poem_id": 1636,
    "vorder": 24,
    "position": 1,
    "text": "به روز و شبانت نسازم درنگ"
  },
  {
    "poem_id": 1636,
    "vorder": 25,
    "position": 0,
    "text": "کسی را که داری ز پیوند من"
  },
  {
    "poem_id": 1636,
    "vorder": 26,
    "position": 1,
    "text": "ز پوشیده‌رویان و فرزند من"
  },
  {
    "poem_id": 1636,
    "vorder": 27,
    "position": 0,
    "text": "بر من فرستی نباشد شگفت"
  },
  {
    "poem_id": 1636,
    "vorder": 28,
    "position": 1,
    "text": "جهانجوی را کین نباید گرفت"
  },
  {
    "poem_id": 1636,
    "vorder": 29,
    "position": 0,
    "text": "ز پوشیده‌رویان به جز سرزنش"
  },
  {
    "poem_id": 1636,
    "vorder": 30,
    "position": 1,
    "text": "نباشد ز شاهان برتر منش"
  },
  {
    "poem_id": 1636,
    "vorder": 31,
    "position": 0,
    "text": "چو نامه بخواند خداوند هوش"
  },
  {
    "poem_id": 1636,
    "vorder": 32,
    "position": 1,
    "text": "بیاراید این رای پاسخ‌نیوش"
  },
  {
    "poem_id": 1636,
    "vorder": 33,
    "position": 0,
    "text": "هیونی ز کرمان بیامد دوان"
  },
  {
    "poem_id": 1636,
    "vorder": 34,
    "position": 1,
    "text": "به نزدیک اسکندر بدگمان"
  },
  {
    "poem_id": 1636,
    "vorder": 35,
    "position": 0,
    "text": "سکندر چو آن نامه برخواند گفت"
  },
  {
    "poem_id": 1636,
    "vorder": 36,
    "position": 1,
    "text": "که با جان دارا خرد باد جفت"
  },
  {
    "poem_id": 1636,
    "vorder": 37,
    "position": 0,
    "text": "کسی کو گراید به پیوند اوی"
  },
  {
    "poem_id": 1636,
    "vorder": 38,
    "position": 1,
    "text": "به پوشیده‌رویان و فرزند اوی"
  },
  {
    "poem_id": 1636,
    "vorder": 39,
    "position": 0,
    "text": "نبیند مگر تخته گور تخت"
  },
  {
    "poem_id": 1636,
    "vorder": 40,
    "position": 1,
    "text": "گر آویخته سر ز شاخ درخت"
  },
  {
    "poem_id": 1636,
    "vorder": 41,
    "position": 0,
    "text": "همه به اصفهانند بی‌درد و رنج"
  },
  {
    "poem_id": 1636,
    "vorder": 42,
    "position": 1,
    "text": "ازیشان مبادا که خواهیم گنج"
  },
  {
    "poem_id": 1636,
    "vorder": 43,
    "position": 0,
    "text": "تو گر سوی ایران خرامی رواست"
  },
  {
    "poem_id": 1636,
    "vorder": 44,
    "position": 1,
    "text": "همه پادشاهی سراسر تراست"
  },
  {
    "poem_id": 1636,
    "vorder": 45,
    "position": 0,
    "text": "ز فرمان تو یک زمان نگذریم"
  },
  {
    "poem_id": 1636,
    "vorder": 46,
    "position": 1,
    "text": "نفس نیز بی‌راه تو نشمریم"
  },
  {
    "poem_id": 1636,
    "vorder": 47,
    "position": 0,
    "text": "بکردار کشتی بیامد هیون"
  },
  {
    "poem_id": 1636,
    "vorder": 48,
    "position": 1,
    "text": "دل و دیدهٔ تاجور پر ز خون"
  }
]