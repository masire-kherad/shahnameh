[
  {
    "poem_id": 1698,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد سوی اردوان"
  },
  {
    "poem_id": 1698,
    "vorder": 2,
    "position": 1,
    "text": "دلش گشت پربیم و تیره‌روان"
  },
  {
    "poem_id": 1698,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت کین راز چرخ بلند"
  },
  {
    "poem_id": 1698,
    "vorder": 4,
    "position": 1,
    "text": "همی گفت با من خداوند پند"
  },
  {
    "poem_id": 1698,
    "vorder": 5,
    "position": 0,
    "text": "هران بد کز اندیشه بیرون بود"
  },
  {
    "poem_id": 1698,
    "vorder": 6,
    "position": 1,
    "text": "ز بخشش به کوشش گذر چون بود"
  },
  {
    "poem_id": 1698,
    "vorder": 7,
    "position": 0,
    "text": "گمانی نبردم که از اردشیر"
  },
  {
    "poem_id": 1698,
    "vorder": 8,
    "position": 1,
    "text": "یکی نامجوی آید و شهرگیر"
  },
  {
    "poem_id": 1698,
    "vorder": 9,
    "position": 0,
    "text": "در گنج بگشاد و روزی بداد"
  },
  {
    "poem_id": 1698,
    "vorder": 10,
    "position": 1,
    "text": "سپه بر گرفت و بنه برنهاد"
  },
  {
    "poem_id": 1698,
    "vorder": 11,
    "position": 0,
    "text": "ز گیل و ز دیلم بیامد سپاه"
  },
  {
    "poem_id": 1698,
    "vorder": 12,
    "position": 1,
    "text": "همی گرد لشکر برآمد به ماه"
  },
  {
    "poem_id": 1698,
    "vorder": 13,
    "position": 0,
    "text": "وزان روی لشکر بیاورد شاه"
  },
  {
    "poem_id": 1698,
    "vorder": 14,
    "position": 1,
    "text": "سپاهی که بر باد بربست راه"
  },
  {
    "poem_id": 1698,
    "vorder": 15,
    "position": 0,
    "text": "ز بس نالهٔ بوق و با کرنای"
  },
  {
    "poem_id": 1698,
    "vorder": 16,
    "position": 1,
    "text": "ترنگیدن زنگ و هندی درای"
  },
  {
    "poem_id": 1698,
    "vorder": 17,
    "position": 0,
    "text": "میان دو لشکر دو پرتاب ماند"
  },
  {
    "poem_id": 1698,
    "vorder": 18,
    "position": 1,
    "text": "به خاک اندرون مار بی‌تاب ماند"
  },
  {
    "poem_id": 1698,
    "vorder": 19,
    "position": 0,
    "text": "خروشان سپاه و درفشان درفش"
  },
  {
    "poem_id": 1698,
    "vorder": 20,
    "position": 1,
    "text": "سرافشان دل از تیغهای بنفش"
  },
  {
    "poem_id": 1698,
    "vorder": 21,
    "position": 0,
    "text": "چهل روز زین سان همی جنگ بود"
  },
  {
    "poem_id": 1698,
    "vorder": 22,
    "position": 1,
    "text": "بران زیردستان جهان تنگ بود"
  },
  {
    "poem_id": 1698,
    "vorder": 23,
    "position": 0,
    "text": "ز هرگونه‌ای تنگ شد خوردنی"
  },
  {
    "poem_id": 1698,
    "vorder": 24,
    "position": 1,
    "text": "همان تنگ شد راه آوردنی"
  },
  {
    "poem_id": 1698,
    "vorder": 25,
    "position": 0,
    "text": "ز بس کشته شد روی هامون چو کوه"
  },
  {
    "poem_id": 1698,
    "vorder": 26,
    "position": 1,
    "text": "بشد خسته از زندگانی ستوه"
  },
  {
    "poem_id": 1698,
    "vorder": 27,
    "position": 0,
    "text": "سرانجام ابری برآمد سیاه"
  },
  {
    "poem_id": 1698,
    "vorder": 28,
    "position": 1,
    "text": "بشد کوشش و رزم را دستگاه"
  },
  {
    "poem_id": 1698,
    "vorder": 29,
    "position": 0,
    "text": "یکی باد برخاست از انجمن"
  },
  {
    "poem_id": 1698,
    "vorder": 30,
    "position": 1,
    "text": "دل جنگیان گشت زان پرشکن"
  },
  {
    "poem_id": 1698,
    "vorder": 31,
    "position": 0,
    "text": "بتوفید کوه و بلرزید دشت"
  },
  {
    "poem_id": 1698,
    "vorder": 32,
    "position": 1,
    "text": "خروشش همی از هوا برگذشت"
  },
  {
    "poem_id": 1698,
    "vorder": 33,
    "position": 0,
    "text": "بترسید زان لشکر اردوان"
  },
  {
    "poem_id": 1698,
    "vorder": 34,
    "position": 1,
    "text": "شدند اندرین یک سخن هم‌زبان"
  },
  {
    "poem_id": 1698,
    "vorder": 35,
    "position": 0,
    "text": "که این کار بر اردوان ایزدیست"
  },
  {
    "poem_id": 1698,
    "vorder": 36,
    "position": 1,
    "text": "بدین لشکر اکنون بباید گریست"
  },
  {
    "poem_id": 1698,
    "vorder": 37,
    "position": 0,
    "text": "به روزی کجا سخت شد کارزار"
  },
  {
    "poem_id": 1698,
    "vorder": 38,
    "position": 1,
    "text": "همه خواستند آنگهی زینهار"
  },
  {
    "poem_id": 1698,
    "vorder": 39,
    "position": 0,
    "text": "بیامد ز قلب سپاه اردشیر"
  },
  {
    "poem_id": 1698,
    "vorder": 40,
    "position": 1,
    "text": "چکاچاک برخاست و باران تیر"
  },
  {
    "poem_id": 1698,
    "vorder": 41,
    "position": 0,
    "text": "گرفتار شد در میان اردوان"
  },
  {
    "poem_id": 1698,
    "vorder": 42,
    "position": 1,
    "text": "بداد از پی تاج شیرین روان"
  },
  {
    "poem_id": 1698,
    "vorder": 43,
    "position": 0,
    "text": "به دست یکی مرد خراد نام"
  },
  {
    "poem_id": 1698,
    "vorder": 44,
    "position": 1,
    "text": "چو بگرفت بردش گرفته لگام"
  },
  {
    "poem_id": 1698,
    "vorder": 45,
    "position": 0,
    "text": "به پیش جهانجوی بردش اسیر"
  },
  {
    "poem_id": 1698,
    "vorder": 46,
    "position": 1,
    "text": "ز دور اردوان را بدید اردشیر"
  },
  {
    "poem_id": 1698,
    "vorder": 47,
    "position": 0,
    "text": "فرود آمد از باره شاه اردوان"
  },
  {
    "poem_id": 1698,
    "vorder": 48,
    "position": 1,
    "text": "تنش خستهٔ تیر و تیره‌روان"
  },
  {
    "poem_id": 1698,
    "vorder": 49,
    "position": 0,
    "text": "به دژخیم فرمود شاه اردشیر"
  },
  {
    "poem_id": 1698,
    "vorder": 50,
    "position": 1,
    "text": "که رو دشمن پادشا را بگیر"
  },
  {
    "poem_id": 1698,
    "vorder": 51,
    "position": 0,
    "text": "به خنجر میانش به دو نیم کن"
  },
  {
    "poem_id": 1698,
    "vorder": 52,
    "position": 1,
    "text": "دل بدسگالان پر از بیم کن"
  },
  {
    "poem_id": 1698,
    "vorder": 53,
    "position": 0,
    "text": "بیامد دژآگاه و فرمان گزید"
  },
  {
    "poem_id": 1698,
    "vorder": 54,
    "position": 1,
    "text": "شد آن نامدار از جهان ناپدید"
  },
  {
    "poem_id": 1698,
    "vorder": 55,
    "position": 0,
    "text": "چنین است کردار این چرخ پیر"
  },
  {
    "poem_id": 1698,
    "vorder": 56,
    "position": 1,
    "text": "چه با اردوان و چه با اردشیر"
  },
  {
    "poem_id": 1698,
    "vorder": 57,
    "position": 0,
    "text": "اگر تا ستاره برآرد بلند"
  },
  {
    "poem_id": 1698,
    "vorder": 58,
    "position": 1,
    "text": "سپارد هم آخر به خاک نژند"
  },
  {
    "poem_id": 1698,
    "vorder": 59,
    "position": 0,
    "text": "دو فرزند او هم گرفتار شد"
  },
  {
    "poem_id": 1698,
    "vorder": 60,
    "position": 1,
    "text": "برو تخمهٔ آرشی خوار شد"
  },
  {
    "poem_id": 1698,
    "vorder": 61,
    "position": 0,
    "text": "مر آن هر دو را پای کرده به بند"
  },
  {
    "poem_id": 1698,
    "vorder": 62,
    "position": 1,
    "text": "به زندان فرستاد شاه بلند"
  },
  {
    "poem_id": 1698,
    "vorder": 63,
    "position": 0,
    "text": "دو بدمهر از رزم بگریختند"
  },
  {
    "poem_id": 1698,
    "vorder": 64,
    "position": 1,
    "text": "به دام بلا در نیاویختند"
  },
  {
    "poem_id": 1698,
    "vorder": 65,
    "position": 0,
    "text": "برفتند گریان به هندوستان"
  },
  {
    "poem_id": 1698,
    "vorder": 66,
    "position": 1,
    "text": "سزد گر کنی زین سخن داستان"
  },
  {
    "poem_id": 1698,
    "vorder": 67,
    "position": 0,
    "text": "همه رزمگه پر ستام و کمر"
  },
  {
    "poem_id": 1698,
    "vorder": 68,
    "position": 1,
    "text": "پر از آلت و لشکر و سیم و زر"
  },
  {
    "poem_id": 1698,
    "vorder": 69,
    "position": 0,
    "text": "بفرمود تا گرد کردند شاه"
  },
  {
    "poem_id": 1698,
    "vorder": 70,
    "position": 1,
    "text": "ببخشید زان پس همه بر سپاه"
  },
  {
    "poem_id": 1698,
    "vorder": 71,
    "position": 0,
    "text": "برفت از میان بزرگان سباک"
  },
  {
    "poem_id": 1698,
    "vorder": 72,
    "position": 1,
    "text": "تن اردوان را ز خون کرد پاک"
  },
  {
    "poem_id": 1698,
    "vorder": 73,
    "position": 0,
    "text": "خروشان بشستش ز خاک نبرد"
  },
  {
    "poem_id": 1698,
    "vorder": 74,
    "position": 1,
    "text": "بر آیین شاهان یکی دخمه کرد"
  },
  {
    "poem_id": 1698,
    "vorder": 75,
    "position": 0,
    "text": "به دیبا بپوشید خسته برش"
  },
  {
    "poem_id": 1698,
    "vorder": 76,
    "position": 1,
    "text": "ز کافور کرد افسری بر سرش"
  },
  {
    "poem_id": 1698,
    "vorder": 77,
    "position": 0,
    "text": "به پیمود آن خاک کاخش به پی"
  },
  {
    "poem_id": 1698,
    "vorder": 78,
    "position": 1,
    "text": "ز لشکر هران‌کس که شد سوی ری"
  },
  {
    "poem_id": 1698,
    "vorder": 79,
    "position": 0,
    "text": "وزان پس بیامد بر اردشیر"
  },
  {
    "poem_id": 1698,
    "vorder": 80,
    "position": 1,
    "text": "چنین گفت کای شاه دانش‌پذیر"
  },
  {
    "poem_id": 1698,
    "vorder": 81,
    "position": 0,
    "text": "تو فرمان بر و دختر او بخواه"
  },
  {
    "poem_id": 1698,
    "vorder": 82,
    "position": 1,
    "text": "که با فر و برزست و با تاج و گاه"
  },
  {
    "poem_id": 1698,
    "vorder": 83,
    "position": 0,
    "text": "به دست آیدت افسر و تاج و گنج"
  },
  {
    "poem_id": 1698,
    "vorder": 84,
    "position": 1,
    "text": "کجا اردوان گرد کرد آن به رنج"
  },
  {
    "poem_id": 1698,
    "vorder": 85,
    "position": 0,
    "text": "ازو پند بشنید و گفتا رواست"
  },
  {
    "poem_id": 1698,
    "vorder": 86,
    "position": 1,
    "text": "هم اندر زمان دختر او بخواست"
  },
  {
    "poem_id": 1698,
    "vorder": 87,
    "position": 0,
    "text": "به ایوان او بد همی یک دو ماه"
  },
  {
    "poem_id": 1698,
    "vorder": 88,
    "position": 1,
    "text": "توانگر سپهبد توانگر سپاه"
  },
  {
    "poem_id": 1698,
    "vorder": 89,
    "position": 0,
    "text": "سوی پارس آمد ز ری نامجوی"
  },
  {
    "poem_id": 1698,
    "vorder": 90,
    "position": 1,
    "text": "برآسوده از رزم وز گفت‌وگوی"
  },
  {
    "poem_id": 1698,
    "vorder": 91,
    "position": 0,
    "text": "یکی شارستان کرد پر کاخ و باغ"
  },
  {
    "poem_id": 1698,
    "vorder": 92,
    "position": 1,
    "text": "بدو اندرون چشمه و دشت و راغ"
  },
  {
    "poem_id": 1698,
    "vorder": 93,
    "position": 0,
    "text": "که اکنون گرانمایه دهقان پیر"
  },
  {
    "poem_id": 1698,
    "vorder": 94,
    "position": 1,
    "text": "همی خواندش خوره اردشیر"
  },
  {
    "poem_id": 1698,
    "vorder": 95,
    "position": 0,
    "text": "یکی چشمه بد بی‌کران اندروی"
  },
  {
    "poem_id": 1698,
    "vorder": 96,
    "position": 1,
    "text": "فراوان ازو رود بگشاد و جوی"
  },
  {
    "poem_id": 1698,
    "vorder": 97,
    "position": 0,
    "text": "برآورد زان چشمه آتشکده"
  },
  {
    "poem_id": 1698,
    "vorder": 98,
    "position": 1,
    "text": "بدو تازه شد مهر و جشن سده"
  },
  {
    "poem_id": 1698,
    "vorder": 99,
    "position": 0,
    "text": "به گرد اندرش باغ و میدان و کاخ"
  },
  {
    "poem_id": 1698,
    "vorder": 100,
    "position": 1,
    "text": "برآورده شد جایگاه فراخ"
  },
  {
    "poem_id": 1698,
    "vorder": 101,
    "position": 0,
    "text": "چو شد شاه با دانش و فر و زور"
  },
  {
    "poem_id": 1698,
    "vorder": 102,
    "position": 1,
    "text": "همی خواندش مرزبان شهر گور"
  },
  {
    "poem_id": 1698,
    "vorder": 103,
    "position": 0,
    "text": "به گرد اندرش روستاها بساخت"
  },
  {
    "poem_id": 1698,
    "vorder": 104,
    "position": 1,
    "text": "چو آباد کردش کس اندر نشاخت"
  },
  {
    "poem_id": 1698,
    "vorder": 105,
    "position": 0,
    "text": "به جایی یکی ژرف دریا بدید"
  },
  {
    "poem_id": 1698,
    "vorder": 106,
    "position": 1,
    "text": "همی کوه بایست پیشش برید"
  },
  {
    "poem_id": 1698,
    "vorder": 107,
    "position": 0,
    "text": "ببردند میتین و مردان کار"
  },
  {
    "poem_id": 1698,
    "vorder": 108,
    "position": 1,
    "text": "وزان کوه ببرید صد جویبار"
  },
  {
    "poem_id": 1698,
    "vorder": 109,
    "position": 0,
    "text": "همی راند از کوه تا شهر گور"
  },
  {
    "poem_id": 1698,
    "vorder": 110,
    "position": 1,
    "text": "شد آن شارستان پر سرای و ستور"
  }
]