[
  {
    "poem_id": 1502,
    "vorder": 1,
    "position": 0,
    "text": "به پالیز چون برکشد سرو شاخ"
  },
  {
    "poem_id": 1502,
    "vorder": 2,
    "position": 1,
    "text": "سر شاخ سبزش برآید ز کاخ"
  },
  {
    "poem_id": 1502,
    "vorder": 3,
    "position": 0,
    "text": "به بالای او شاد باشد درخت"
  },
  {
    "poem_id": 1502,
    "vorder": 4,
    "position": 1,
    "text": "چو بیندش بینادل و نیک‌بخت"
  },
  {
    "poem_id": 1502,
    "vorder": 5,
    "position": 0,
    "text": "سزد گر گمانی برد بر سه چیز"
  },
  {
    "poem_id": 1502,
    "vorder": 6,
    "position": 1,
    "text": "کزین سه گذشتی چه چیزست نیز"
  },
  {
    "poem_id": 1502,
    "vorder": 7,
    "position": 0,
    "text": "هنر با نژادست و با گوهر است"
  },
  {
    "poem_id": 1502,
    "vorder": 8,
    "position": 1,
    "text": "سه چیزست و هر سه به‌بنداندرست"
  },
  {
    "poem_id": 1502,
    "vorder": 9,
    "position": 0,
    "text": "هنر کی بود تا نباشد گهر"
  },
  {
    "poem_id": 1502,
    "vorder": 10,
    "position": 1,
    "text": "نژاده بسی دیده‌ای بی‌هنر"
  },
  {
    "poem_id": 1502,
    "vorder": 11,
    "position": 0,
    "text": "گهر آنک از فر یزدان بود"
  },
  {
    "poem_id": 1502,
    "vorder": 12,
    "position": 1,
    "text": "نیازد به بد دست و بد نشنود"
  },
  {
    "poem_id": 1502,
    "vorder": 13,
    "position": 0,
    "text": "نژاد آنک باشد ز تخم پدر"
  },
  {
    "poem_id": 1502,
    "vorder": 14,
    "position": 1,
    "text": "سزد کاید از تخم پاکیزه بر"
  },
  {
    "poem_id": 1502,
    "vorder": 15,
    "position": 0,
    "text": "هنر گر بیاموزی از هر کسی"
  },
  {
    "poem_id": 1502,
    "vorder": 16,
    "position": 1,
    "text": "بکوشی و پیچی ز رنجش بسی"
  },
  {
    "poem_id": 1502,
    "vorder": 17,
    "position": 0,
    "text": "ازین هر سه گوهر بود مایه‌دار"
  },
  {
    "poem_id": 1502,
    "vorder": 18,
    "position": 1,
    "text": "که زیبا بود خلعت کردگار"
  },
  {
    "poem_id": 1502,
    "vorder": 19,
    "position": 0,
    "text": "چو هر سه بیابی خرد بایدت"
  },
  {
    "poem_id": 1502,
    "vorder": 20,
    "position": 1,
    "text": "شناسندهٔ نیک و بد بایدت"
  },
  {
    "poem_id": 1502,
    "vorder": 21,
    "position": 0,
    "text": "چو این چار با یک تن آید بهم"
  },
  {
    "poem_id": 1502,
    "vorder": 22,
    "position": 1,
    "text": "براساید از آز وز رنج و غم"
  },
  {
    "poem_id": 1502,
    "vorder": 23,
    "position": 0,
    "text": "مگر مرگ کز مرگ خود چاره نیست"
  },
  {
    "poem_id": 1502,
    "vorder": 24,
    "position": 1,
    "text": "وزین بدتر از بخت پتیاره نیست"
  },
  {
    "poem_id": 1502,
    "vorder": 25,
    "position": 0,
    "text": "جهانجوی از این چار بد بی‌نیاز"
  },
  {
    "poem_id": 1502,
    "vorder": 26,
    "position": 1,
    "text": "همش بخت سازنده بود از فراز"
  },
  {
    "poem_id": 1502,
    "vorder": 27,
    "position": 0,
    "text": "سخن راند گویا بدین داستان"
  },
  {
    "poem_id": 1502,
    "vorder": 28,
    "position": 1,
    "text": "دگر گوید از گفتهٔ باستان"
  },
  {
    "poem_id": 1502,
    "vorder": 29,
    "position": 0,
    "text": "کنون بازگردم به آغاز کار"
  },
  {
    "poem_id": 1502,
    "vorder": 30,
    "position": 1,
    "text": "که چون بود کردار آن شهریار"
  },
  {
    "poem_id": 1502,
    "vorder": 31,
    "position": 0,
    "text": "چو تاج بزرگی بسر برنهاد"
  },
  {
    "poem_id": 1502,
    "vorder": 32,
    "position": 1,
    "text": "ازو شاد شد تاج و او نیز شاد"
  },
  {
    "poem_id": 1502,
    "vorder": 33,
    "position": 0,
    "text": "به هر جای ویرانی آباد کرد"
  },
  {
    "poem_id": 1502,
    "vorder": 34,
    "position": 1,
    "text": "دل غمگنان از غم آزاد کرد"
  },
  {
    "poem_id": 1502,
    "vorder": 35,
    "position": 0,
    "text": "از ابر بهاران ببارید نم"
  },
  {
    "poem_id": 1502,
    "vorder": 36,
    "position": 1,
    "text": "ز روی زمین زنگ بزدود غم"
  },
  {
    "poem_id": 1502,
    "vorder": 37,
    "position": 0,
    "text": "جهان گشت پر سبزه و رود آب"
  },
  {
    "poem_id": 1502,
    "vorder": 38,
    "position": 1,
    "text": "سر غمگنان اندر آمد به خواب"
  },
  {
    "poem_id": 1502,
    "vorder": 39,
    "position": 0,
    "text": "زمین چون بهشتی شد آراسته"
  },
  {
    "poem_id": 1502,
    "vorder": 40,
    "position": 1,
    "text": "ز داد و ز بخشش پر از خواسته"
  },
  {
    "poem_id": 1502,
    "vorder": 41,
    "position": 0,
    "text": "چو جم و فریدون بیاراست گاه"
  },
  {
    "poem_id": 1502,
    "vorder": 42,
    "position": 1,
    "text": "ز داد و ز بخشش نیاسود شاه"
  },
  {
    "poem_id": 1502,
    "vorder": 43,
    "position": 0,
    "text": "جهان شد پر از خوبی و ایمنی"
  },
  {
    "poem_id": 1502,
    "vorder": 44,
    "position": 1,
    "text": "ز بد بسته شد دست اهریمنی"
  },
  {
    "poem_id": 1502,
    "vorder": 45,
    "position": 0,
    "text": "فرستادگان آمد از هر سوی"
  },
  {
    "poem_id": 1502,
    "vorder": 46,
    "position": 1,
    "text": "ز هر نامداری و هر پهلوی"
  },
  {
    "poem_id": 1502,
    "vorder": 47,
    "position": 0,
    "text": "پس آگاهی آمد سوی نیمروز"
  },
  {
    "poem_id": 1502,
    "vorder": 48,
    "position": 1,
    "text": "بنزد سپهدار گیتی‌فروز"
  },
  {
    "poem_id": 1502,
    "vorder": 49,
    "position": 0,
    "text": "که خسرو ز توران به ایران رسید"
  },
  {
    "poem_id": 1502,
    "vorder": 50,
    "position": 1,
    "text": "نشست از بر تخت کو را سزید"
  },
  {
    "poem_id": 1502,
    "vorder": 51,
    "position": 0,
    "text": "بیاراست رستم به دیدار شاه"
  },
  {
    "poem_id": 1502,
    "vorder": 52,
    "position": 1,
    "text": "ببیند که تا هست زیبای گاه"
  },
  {
    "poem_id": 1502,
    "vorder": 53,
    "position": 0,
    "text": "ابا زالِ سامِ نریمان بهم"
  },
  {
    "poem_id": 1502,
    "vorder": 54,
    "position": 1,
    "text": "بزرگان کابل همه بیش و کم"
  },
  {
    "poem_id": 1502,
    "vorder": 55,
    "position": 0,
    "text": "سپاهی که شد دشت چون آبنوس"
  },
  {
    "poem_id": 1502,
    "vorder": 56,
    "position": 1,
    "text": "بدرید هر گوش ز اوای کوس"
  },
  {
    "poem_id": 1502,
    "vorder": 57,
    "position": 0,
    "text": "سوی شهر ایران گرفتند راه"
  },
  {
    "poem_id": 1502,
    "vorder": 58,
    "position": 1,
    "text": "زواره فرامرز و پیل و سپاه"
  },
  {
    "poem_id": 1502,
    "vorder": 59,
    "position": 0,
    "text": "به پیش اندرون زال با انجمن"
  },
  {
    "poem_id": 1502,
    "vorder": 60,
    "position": 1,
    "text": "درفش بنفش از پس پیلتن"
  },
  {
    "poem_id": 1502,
    "vorder": 61,
    "position": 0,
    "text": "پس آگاهی آمد بر شهریار"
  },
  {
    "poem_id": 1502,
    "vorder": 62,
    "position": 1,
    "text": "که آمد ز ره پهلوان سوار"
  },
  {
    "poem_id": 1502,
    "vorder": 63,
    "position": 0,
    "text": "زواره فرامرز و دستان سام"
  },
  {
    "poem_id": 1502,
    "vorder": 64,
    "position": 1,
    "text": "بزرگان که هستند با جاه و نام"
  },
  {
    "poem_id": 1502,
    "vorder": 65,
    "position": 0,
    "text": "دل شاه شد زان سخن شادمان"
  },
  {
    "poem_id": 1502,
    "vorder": 66,
    "position": 1,
    "text": "سراینده را گفت کاباد مان"
  },
  {
    "poem_id": 1502,
    "vorder": 67,
    "position": 0,
    "text": "که اویست پروردگار پدر"
  },
  {
    "poem_id": 1502,
    "vorder": 68,
    "position": 1,
    "text": "وزویست پیدا به گیتی هنر"
  },
  {
    "poem_id": 1502,
    "vorder": 69,
    "position": 0,
    "text": "بفرمود تا گیو و گودرز و طوس"
  },
  {
    "poem_id": 1502,
    "vorder": 70,
    "position": 1,
    "text": "برفتند با نای رویین و کوس"
  },
  {
    "poem_id": 1502,
    "vorder": 71,
    "position": 0,
    "text": "تبیره برآمد ز درگاه شاه"
  },
  {
    "poem_id": 1502,
    "vorder": 72,
    "position": 1,
    "text": "همه برنهادند گردان کلاه"
  },
  {
    "poem_id": 1502,
    "vorder": 73,
    "position": 0,
    "text": "یکی لشکر از جای برخاستند"
  },
  {
    "poem_id": 1502,
    "vorder": 74,
    "position": 1,
    "text": "پذیره شدن را بیاراستند"
  },
  {
    "poem_id": 1502,
    "vorder": 75,
    "position": 0,
    "text": "ز پهلو به پهلو پذیره شدند"
  },
  {
    "poem_id": 1502,
    "vorder": 76,
    "position": 1,
    "text": "همه با درفش و تبیره شدند"
  },
  {
    "poem_id": 1502,
    "vorder": 77,
    "position": 0,
    "text": "برفتند پیشش به دو روزه راه"
  },
  {
    "poem_id": 1502,
    "vorder": 78,
    "position": 1,
    "text": "چنین پهلوانان و چندین سپاه"
  },
  {
    "poem_id": 1502,
    "vorder": 79,
    "position": 0,
    "text": "درفش تهمتن چو آمد پدید"
  },
  {
    "poem_id": 1502,
    "vorder": 80,
    "position": 1,
    "text": "به خورشید گرد سپه بردمید"
  },
  {
    "poem_id": 1502,
    "vorder": 81,
    "position": 0,
    "text": "خروش آمد و نالهٔ بوق و کوس"
  },
  {
    "poem_id": 1502,
    "vorder": 82,
    "position": 1,
    "text": "ز قلب سپه گیو و گودرز و طوس"
  },
  {
    "poem_id": 1502,
    "vorder": 83,
    "position": 0,
    "text": "به پیش گو پیلتن راندند"
  },
  {
    "poem_id": 1502,
    "vorder": 84,
    "position": 1,
    "text": "به شادی برو آفرین خواندند"
  },
  {
    "poem_id": 1502,
    "vorder": 85,
    "position": 0,
    "text": "گرفتند هر سه ورا در کنار"
  },
  {
    "poem_id": 1502,
    "vorder": 86,
    "position": 1,
    "text": "بپرسید شیراوژن از شهریار"
  },
  {
    "poem_id": 1502,
    "vorder": 87,
    "position": 0,
    "text": "ز رستم سوی زال سام آمدند"
  },
  {
    "poem_id": 1502,
    "vorder": 88,
    "position": 1,
    "text": "گشاده دل و شادکام آمدند"
  },
  {
    "poem_id": 1502,
    "vorder": 89,
    "position": 0,
    "text": "نهادند سوی فرامرز روی"
  },
  {
    "poem_id": 1502,
    "vorder": 90,
    "position": 1,
    "text": "گرفتند شادی به دیدار اوی"
  },
  {
    "poem_id": 1502,
    "vorder": 91,
    "position": 0,
    "text": "وزان جایگه سوی شاه آمدند"
  },
  {
    "poem_id": 1502,
    "vorder": 92,
    "position": 1,
    "text": "به دیدار فرخ کلاه آمدند"
  },
  {
    "poem_id": 1502,
    "vorder": 93,
    "position": 0,
    "text": "چو خسرو گو پیلتن را بدید"
  },
  {
    "poem_id": 1502,
    "vorder": 94,
    "position": 1,
    "text": "سرشکش ز مژگان به رخ بر چکید"
  },
  {
    "poem_id": 1502,
    "vorder": 95,
    "position": 0,
    "text": "فرود آمد از تخت و کرد آفرین"
  },
  {
    "poem_id": 1502,
    "vorder": 96,
    "position": 1,
    "text": "تهمتن ببوسید روی زمین"
  },
  {
    "poem_id": 1502,
    "vorder": 97,
    "position": 0,
    "text": "به رستم چنین گفت کای پهلوان"
  },
  {
    "poem_id": 1502,
    "vorder": 98,
    "position": 1,
    "text": "همیشه بدی شاد و روشن‌روان"
  },
  {
    "poem_id": 1502,
    "vorder": 99,
    "position": 0,
    "text": "به گیتی خردمند و خامش تویی"
  },
  {
    "poem_id": 1502,
    "vorder": 100,
    "position": 1,
    "text": "که پروردگار سیاوش تویی"
  },
  {
    "poem_id": 1502,
    "vorder": 101,
    "position": 0,
    "text": "سر زال زان پس به بر در گرفت"
  },
  {
    "poem_id": 1502,
    "vorder": 102,
    "position": 1,
    "text": "ز بهر پدر دست بر سر گرفت"
  },
  {
    "poem_id": 1502,
    "vorder": 103,
    "position": 0,
    "text": "گوان را به تخت مهی برنشاند"
  },
  {
    "poem_id": 1502,
    "vorder": 104,
    "position": 1,
    "text": "بریشان همی نام یزدان بخواند"
  },
  {
    "poem_id": 1502,
    "vorder": 105,
    "position": 0,
    "text": "نگه کرد رستم سرو پای اوی"
  },
  {
    "poem_id": 1502,
    "vorder": 106,
    "position": 1,
    "text": "نشست و سخن گفتن و رای اوی"
  },
  {
    "poem_id": 1502,
    "vorder": 107,
    "position": 0,
    "text": "رخش گشت پرخون و دل پر ز درد"
  },
  {
    "poem_id": 1502,
    "vorder": 108,
    "position": 1,
    "text": "زکار سیاوش بسی یاد کرد"
  },
  {
    "poem_id": 1502,
    "vorder": 109,
    "position": 0,
    "text": "به شاه جهان گفت کای شهریار"
  },
  {
    "poem_id": 1502,
    "vorder": 110,
    "position": 1,
    "text": "جهان را تویی از پدر یادگار"
  },
  {
    "poem_id": 1502,
    "vorder": 111,
    "position": 0,
    "text": "ندیدم من اندر جهان تاج‌ور"
  },
  {
    "poem_id": 1502,
    "vorder": 112,
    "position": 1,
    "text": "بدین فر و مانندگی پدر"
  },
  {
    "poem_id": 1502,
    "vorder": 113,
    "position": 0,
    "text": "وزان پس چو از تخت برخاستند"
  },
  {
    "poem_id": 1502,
    "vorder": 114,
    "position": 1,
    "text": "نهادند خوان و می آراستند"
  },
  {
    "poem_id": 1502,
    "vorder": 115,
    "position": 0,
    "text": "جهاندار تا نیمی از شب نخفت"
  },
  {
    "poem_id": 1502,
    "vorder": 116,
    "position": 1,
    "text": "گذشته سخنها همه بازگفت"
  }
]