[
  {
    "poem_id": 1356,
    "vorder": 1,
    "position": 0,
    "text": "چو کشور ز ضحاک بودی تهی"
  },
  {
    "poem_id": 1356,
    "vorder": 2,
    "position": 1,
    "text": "یکی مایه‌ور بد به سان رهی"
  },
  {
    "poem_id": 1356,
    "vorder": 3,
    "position": 0,
    "text": "که او داشتی گنج و تخت و سرای"
  },
  {
    "poem_id": 1356,
    "vorder": 4,
    "position": 1,
    "text": "شگفتی به دلسوزگی کدخدای"
  },
  {
    "poem_id": 1356,
    "vorder": 5,
    "position": 0,
    "text": "ورا کندرو خواندندی بنام"
  },
  {
    "poem_id": 1356,
    "vorder": 6,
    "position": 1,
    "text": "به کندی زدی پیش بیداد گام"
  },
  {
    "poem_id": 1356,
    "vorder": 7,
    "position": 0,
    "text": "به کاخ اندر آمد دوان کندرو"
  },
  {
    "poem_id": 1356,
    "vorder": 8,
    "position": 1,
    "text": "در ایوان یکی تاجور دید نو"
  },
  {
    "poem_id": 1356,
    "vorder": 9,
    "position": 0,
    "text": "نشسته به آرام در پیشگاه"
  },
  {
    "poem_id": 1356,
    "vorder": 10,
    "position": 1,
    "text": "چو سرو بلند از برش گرد ماه"
  },
  {
    "poem_id": 1356,
    "vorder": 11,
    "position": 0,
    "text": "ز یک دست سرو سهی شهرناز"
  },
  {
    "poem_id": 1356,
    "vorder": 12,
    "position": 1,
    "text": "به دست دگر ماه‌روی ارنواز"
  },
  {
    "poem_id": 1356,
    "vorder": 13,
    "position": 0,
    "text": "همه شهر یک‌سر پر از لشکرش"
  },
  {
    "poem_id": 1356,
    "vorder": 14,
    "position": 1,
    "text": "کمربستگان صف زده بر درش"
  },
  {
    "poem_id": 1356,
    "vorder": 15,
    "position": 0,
    "text": "نه آسیمه گشت و نه پرسید راز"
  },
  {
    "poem_id": 1356,
    "vorder": 16,
    "position": 1,
    "text": "نیایش‌کنان رفت و بردش نماز"
  },
  {
    "poem_id": 1356,
    "vorder": 17,
    "position": 0,
    "text": "بر او آفرین کرد کای شهریار"
  },
  {
    "poem_id": 1356,
    "vorder": 18,
    "position": 1,
    "text": "همیشه بزی تا بود روزگار"
  },
  {
    "poem_id": 1356,
    "vorder": 19,
    "position": 0,
    "text": "خجسته نشست تو با فرهی"
  },
  {
    "poem_id": 1356,
    "vorder": 20,
    "position": 1,
    "text": "که هستی سزاوار شاهنشهی"
  },
  {
    "poem_id": 1356,
    "vorder": 21,
    "position": 0,
    "text": "جهان هفت کشور تو را بنده باد"
  },
  {
    "poem_id": 1356,
    "vorder": 22,
    "position": 1,
    "text": "سرت برتر از ابر بارنده باد"
  },
  {
    "poem_id": 1356,
    "vorder": 23,
    "position": 0,
    "text": "فریدونش فرمود تا رفت پیش"
  },
  {
    "poem_id": 1356,
    "vorder": 24,
    "position": 1,
    "text": "بکرد آشکارا همه راز خویش"
  },
  {
    "poem_id": 1356,
    "vorder": 25,
    "position": 0,
    "text": "بفرمود شاه دلاور بدوی"
  },
  {
    "poem_id": 1356,
    "vorder": 26,
    "position": 1,
    "text": "که رو آلت تخت شاهی بجوی"
  },
  {
    "poem_id": 1356,
    "vorder": 27,
    "position": 0,
    "text": "نبیذ آر و رامشگران را بخوان"
  },
  {
    "poem_id": 1356,
    "vorder": 28,
    "position": 1,
    "text": "بپیمای جام و بیارای خوان"
  },
  {
    "poem_id": 1356,
    "vorder": 29,
    "position": 0,
    "text": "کسی کاو به رامش سزای من است"
  },
  {
    "poem_id": 1356,
    "vorder": 30,
    "position": 1,
    "text": "به دانش همان دلزدای من است"
  },
  {
    "poem_id": 1356,
    "vorder": 31,
    "position": 0,
    "text": "بیار انجمن کن بر تخت من"
  },
  {
    "poem_id": 1356,
    "vorder": 32,
    "position": 1,
    "text": "چنان چون بود در خور بخت من"
  },
  {
    "poem_id": 1356,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید از او این سخن کدخدای"
  },
  {
    "poem_id": 1356,
    "vorder": 34,
    "position": 1,
    "text": "بکرد آنچه گفتش بدو رهنمای"
  },
  {
    "poem_id": 1356,
    "vorder": 35,
    "position": 0,
    "text": "می روشن آورد و رامشگران"
  },
  {
    "poem_id": 1356,
    "vorder": 36,
    "position": 1,
    "text": "همان در خورش با گهر مهتران"
  },
  {
    "poem_id": 1356,
    "vorder": 37,
    "position": 0,
    "text": "فریدون غم افکند و رامش گزید"
  },
  {
    "poem_id": 1356,
    "vorder": 38,
    "position": 1,
    "text": "شبی کرد جشنی چنان چون سزید"
  },
  {
    "poem_id": 1356,
    "vorder": 39,
    "position": 0,
    "text": "چو شد رام گیتی دوان کندرو"
  },
  {
    "poem_id": 1356,
    "vorder": 40,
    "position": 1,
    "text": "برون آمد از پیش سالار نو"
  },
  {
    "poem_id": 1356,
    "vorder": 41,
    "position": 0,
    "text": "نشست از بر بارهٔ راه‌جوی"
  },
  {
    "poem_id": 1356,
    "vorder": 42,
    "position": 1,
    "text": "سوی شاه ضحاک بنهاد روی"
  },
  {
    "poem_id": 1356,
    "vorder": 43,
    "position": 0,
    "text": "بیآمد چو پیش سپهبد رسید"
  },
  {
    "poem_id": 1356,
    "vorder": 44,
    "position": 1,
    "text": "سراسر بگفت آنچه دید و شنید"
  },
  {
    "poem_id": 1356,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت کای شاه گردنکشان"
  },
  {
    "poem_id": 1356,
    "vorder": 46,
    "position": 1,
    "text": "به برگشتن کارت آمد نشان"
  },
  {
    "poem_id": 1356,
    "vorder": 47,
    "position": 0,
    "text": "سه مرد سرافراز با لشکری"
  },
  {
    "poem_id": 1356,
    "vorder": 48,
    "position": 1,
    "text": "فراز آمدند از دگر کشوری"
  },
  {
    "poem_id": 1356,
    "vorder": 49,
    "position": 0,
    "text": "از آن سه یکی کهتر اندر میان"
  },
  {
    "poem_id": 1356,
    "vorder": 50,
    "position": 1,
    "text": "به بالای سرو و به چهر کیان"
  },
  {
    "poem_id": 1356,
    "vorder": 51,
    "position": 0,
    "text": "به سال است کهتر فزونیش بیش"
  },
  {
    "poem_id": 1356,
    "vorder": 52,
    "position": 1,
    "text": "از آن مهتران او نهد پای پیش"
  },
  {
    "poem_id": 1356,
    "vorder": 53,
    "position": 0,
    "text": "یکی گُرز دارد چو یک لخت کوه"
  },
  {
    "poem_id": 1356,
    "vorder": 54,
    "position": 1,
    "text": "همی تابد اندر میان گروه"
  },
  {
    "poem_id": 1356,
    "vorder": 55,
    "position": 0,
    "text": "به اسپ اندر آمد به ایوان شاه"
  },
  {
    "poem_id": 1356,
    "vorder": 56,
    "position": 1,
    "text": "دو پرمایه با او همیدون براه"
  },
  {
    "poem_id": 1356,
    "vorder": 57,
    "position": 0,
    "text": "بیآمد به تخت کئی بر نشست"
  },
  {
    "poem_id": 1356,
    "vorder": 58,
    "position": 1,
    "text": "همه بند و نیرنگ تو کرد پست"
  },
  {
    "poem_id": 1356,
    "vorder": 59,
    "position": 0,
    "text": "هر آن کس که بود اندر ایوان تو"
  },
  {
    "poem_id": 1356,
    "vorder": 60,
    "position": 1,
    "text": "ز مردان مرد و ز دیوان تو"
  },
  {
    "poem_id": 1356,
    "vorder": 61,
    "position": 0,
    "text": "سر از پای یک‌سر فرو ریختشان"
  },
  {
    "poem_id": 1356,
    "vorder": 62,
    "position": 1,
    "text": "همه مغز با خون برآمیختشان"
  },
  {
    "poem_id": 1356,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت ضحاک شاید بدن"
  },
  {
    "poem_id": 1356,
    "vorder": 64,
    "position": 1,
    "text": "که مهمان بود شاد باید بدن"
  },
  {
    "poem_id": 1356,
    "vorder": 65,
    "position": 0,
    "text": "چنین داد پاسخ ورا پیشکار"
  },
  {
    "poem_id": 1356,
    "vorder": 66,
    "position": 1,
    "text": "که مهمان ابا گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1356,
    "vorder": 67,
    "position": 0,
    "text": "به مردی نشیند به آرام تو"
  },
  {
    "poem_id": 1356,
    "vorder": 68,
    "position": 1,
    "text": "ز تاج و کمر بسترد نام تو"
  },
  {
    "poem_id": 1356,
    "vorder": 69,
    "position": 0,
    "text": "به آیین خویش آورد ناسپاس"
  },
  {
    "poem_id": 1356,
    "vorder": 70,
    "position": 1,
    "text": "چنین گر تو مهمان شناسی شناس"
  },
  {
    "poem_id": 1356,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت ضحاک چندین منال"
  },
  {
    "poem_id": 1356,
    "vorder": 72,
    "position": 1,
    "text": "که مهمان گستاخ بهتر به فال"
  },
  {
    "poem_id": 1356,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد پاسخ بدو کندرو"
  },
  {
    "poem_id": 1356,
    "vorder": 74,
    "position": 1,
    "text": "که آری شنیدم تو پاسخ شنو"
  },
  {
    "poem_id": 1356,
    "vorder": 75,
    "position": 0,
    "text": "گر این نامور هست مهمان تو"
  },
  {
    "poem_id": 1356,
    "vorder": 76,
    "position": 1,
    "text": "چه کارستش اندر شبستان تو"
  },
  {
    "poem_id": 1356,
    "vorder": 77,
    "position": 0,
    "text": "که با دختران جهاندار جم"
  },
  {
    "poem_id": 1356,
    "vorder": 78,
    "position": 1,
    "text": "نشیند زند رای بر بیش و کم"
  },
  {
    "poem_id": 1356,
    "vorder": 79,
    "position": 0,
    "text": "به یک دست گیرد رخ شهرناز"
  },
  {
    "poem_id": 1356,
    "vorder": 80,
    "position": 1,
    "text": "به دیگر عقیق لب ارنواز"
  },
  {
    "poem_id": 1356,
    "vorder": 81,
    "position": 0,
    "text": "شب تیره‌گون خود بتر زین کند"
  },
  {
    "poem_id": 1356,
    "vorder": 82,
    "position": 1,
    "text": "به زیر سر از مشک بالین کند"
  },
  {
    "poem_id": 1356,
    "vorder": 83,
    "position": 0,
    "text": "چو مشک آن دو گیسوی دو ماه تو"
  },
  {
    "poem_id": 1356,
    "vorder": 84,
    "position": 1,
    "text": "که بودند همواره دلخواه تو"
  },
  {
    "poem_id": 1356,
    "vorder": 85,
    "position": 0,
    "text": "بگیرد به برشان چو شد نیم مست"
  },
  {
    "poem_id": 1356,
    "vorder": 86,
    "position": 1,
    "text": "بدین گونه مهمان نباید به دست"
  },
  {
    "poem_id": 1356,
    "vorder": 87,
    "position": 0,
    "text": "برآشفت ضحاک برسان کرگ"
  },
  {
    "poem_id": 1356,
    "vorder": 88,
    "position": 1,
    "text": "شنید آن سخن کآرزو کرد مرگ"
  },
  {
    "poem_id": 1356,
    "vorder": 89,
    "position": 0,
    "text": "به دشنام زشت و به آواز سخت"
  },
  {
    "poem_id": 1356,
    "vorder": 90,
    "position": 1,
    "text": "شگفتی بشورید با شور بخت"
  },
  {
    "poem_id": 1356,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت هرگز تو در خان من"
  },
  {
    "poem_id": 1356,
    "vorder": 92,
    "position": 1,
    "text": "از این پس نباشی نگهبان من"
  },
  {
    "poem_id": 1356,
    "vorder": 93,
    "position": 0,
    "text": "چنین داد پاسخ ورا پیشکار"
  },
  {
    "poem_id": 1356,
    "vorder": 94,
    "position": 1,
    "text": "که ایدون گمانم من ای شهریار"
  },
  {
    "poem_id": 1356,
    "vorder": 95,
    "position": 0,
    "text": "کز آن بخت هرگز نباشدت بهر"
  },
  {
    "poem_id": 1356,
    "vorder": 96,
    "position": 1,
    "text": "به من چون دهی کدخدایی شهر"
  },
  {
    "poem_id": 1356,
    "vorder": 97,
    "position": 0,
    "text": "چو بی‌بهره باشی ز گاه مهی"
  },
  {
    "poem_id": 1356,
    "vorder": 98,
    "position": 1,
    "text": "مرا کارسازندگی چون دهی"
  },
  {
    "poem_id": 1356,
    "vorder": 99,
    "position": 0,
    "text": "چرا تو نسازی همی کار خویش"
  },
  {
    "poem_id": 1356,
    "vorder": 100,
    "position": 1,
    "text": "که هرگز نیامدت از این کار پیش"
  },
  {
    "poem_id": 1356,
    "vorder": 101,
    "position": 0,
    "text": "ز تاج بزرگی چو موی از خمیر"
  },
  {
    "poem_id": 1356,
    "vorder": 102,
    "position": 1,
    "text": "برون آمدی مهترا چاره گیر"
  },
  {
    "poem_id": 1356,
    "vorder": 103,
    "position": 0,
    "text": "تو را دشمن آمد به گه برنشست"
  },
  {
    "poem_id": 1356,
    "vorder": 104,
    "position": 1,
    "text": "یکی گُرزهٔ گاوپیکر به دست"
  },
  {
    "poem_id": 1356,
    "vorder": 105,
    "position": 0,
    "text": "همه بند و نیرنگت از رنگ برد"
  },
  {
    "poem_id": 1356,
    "vorder": 106,
    "position": 1,
    "text": "دلارام بگرفت و گاهت سپرد"
  }
]