[
  {
    "poem_id": 1817,
    "vorder": 1,
    "position": 0,
    "text": "چو هرمز برآمد به تخت پدر"
  },
  {
    "poem_id": 1817,
    "vorder": 2,
    "position": 1,
    "text": "به سر برنهاد آن کیی تاج زر"
  },
  {
    "poem_id": 1817,
    "vorder": 3,
    "position": 0,
    "text": "چو پیروز را ویژه گفتی ز خشم"
  },
  {
    "poem_id": 1817,
    "vorder": 4,
    "position": 1,
    "text": "همی آب رشک اندر آمد به چشم"
  },
  {
    "poem_id": 1817,
    "vorder": 5,
    "position": 0,
    "text": "سوی شاه هیتال شد ناگهان"
  },
  {
    "poem_id": 1817,
    "vorder": 6,
    "position": 1,
    "text": "ابا لشکر و گنج و چندی مهان"
  },
  {
    "poem_id": 1817,
    "vorder": 7,
    "position": 0,
    "text": "چغانی شهی بُد فغانیش نام"
  },
  {
    "poem_id": 1817,
    "vorder": 8,
    "position": 1,
    "text": "جهانجوی با لشکر و گنج و کام"
  },
  {
    "poem_id": 1817,
    "vorder": 9,
    "position": 0,
    "text": "فغانیش را گفت کای نیک‌خواه"
  },
  {
    "poem_id": 1817,
    "vorder": 10,
    "position": 1,
    "text": "دو فرزند بودیم زیبای گاه"
  },
  {
    "poem_id": 1817,
    "vorder": 11,
    "position": 0,
    "text": "پدر تاج شاهی به کهتر سپرد"
  },
  {
    "poem_id": 1817,
    "vorder": 12,
    "position": 1,
    "text": "چو بیدادگر بد سپرد و بمرد"
  },
  {
    "poem_id": 1817,
    "vorder": 13,
    "position": 0,
    "text": "چو لشکر دهی مر مرا گنج هست"
  },
  {
    "poem_id": 1817,
    "vorder": 14,
    "position": 1,
    "text": "سلیح و بزرگی و نیروی دست"
  },
  {
    "poem_id": 1817,
    "vorder": 15,
    "position": 0,
    "text": "فغانی بدو گفت که آری رواست"
  },
  {
    "poem_id": 1817,
    "vorder": 16,
    "position": 1,
    "text": "جهاندار هم بر پدر پادشاست"
  },
  {
    "poem_id": 1817,
    "vorder": 17,
    "position": 0,
    "text": "به پیمان سپارم سپاهی تو را"
  },
  {
    "poem_id": 1817,
    "vorder": 18,
    "position": 1,
    "text": "نمایم سوی داد راهی تو را"
  },
  {
    "poem_id": 1817,
    "vorder": 19,
    "position": 0,
    "text": "که باشد مرا ترمذ و ویسه‌گرد"
  },
  {
    "poem_id": 1817,
    "vorder": 20,
    "position": 1,
    "text": "که خون عهد این دارم از یزدگرد"
  },
  {
    "poem_id": 1817,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت پیروز کآری رواست"
  },
  {
    "poem_id": 1817,
    "vorder": 22,
    "position": 1,
    "text": "فزون زان به تو پادشاهی سزاست"
  },
  {
    "poem_id": 1817,
    "vorder": 23,
    "position": 0,
    "text": "بدو داد شمشیرزن سی‌هزار"
  },
  {
    "poem_id": 1817,
    "vorder": 24,
    "position": 1,
    "text": "ز هیتالیان لشکری نامدار"
  },
  {
    "poem_id": 1817,
    "vorder": 25,
    "position": 0,
    "text": "سپاهی بیاورد پیروزشاه"
  },
  {
    "poem_id": 1817,
    "vorder": 26,
    "position": 1,
    "text": "که از گرد تاریک شد چرخ ماه"
  },
  {
    "poem_id": 1817,
    "vorder": 27,
    "position": 0,
    "text": "برآویخت با هرمز شهریار"
  },
  {
    "poem_id": 1817,
    "vorder": 28,
    "position": 1,
    "text": "فراوان ببودستشان کارزار"
  },
  {
    "poem_id": 1817,
    "vorder": 29,
    "position": 0,
    "text": "سرانجام هرمز گرفتار شد"
  },
  {
    "poem_id": 1817,
    "vorder": 30,
    "position": 1,
    "text": "همه تاج‌ها پیش او خوار شد"
  },
  {
    "poem_id": 1817,
    "vorder": 31,
    "position": 0,
    "text": "چو پیروز روی برادر بدید"
  },
  {
    "poem_id": 1817,
    "vorder": 32,
    "position": 1,
    "text": "دلش مهر پیوند او برگزید"
  },
  {
    "poem_id": 1817,
    "vorder": 33,
    "position": 0,
    "text": "بفرمود تا بارگی برنشست"
  },
  {
    "poem_id": 1817,
    "vorder": 34,
    "position": 1,
    "text": "بشد تیز و ببسود رویش به دست"
  },
  {
    "poem_id": 1817,
    "vorder": 35,
    "position": 0,
    "text": "فرستاد بازش به ایوان خویش"
  },
  {
    "poem_id": 1817,
    "vorder": 36,
    "position": 1,
    "text": "بدو خوانده بد عهد و پیمان خویش"
  }
]