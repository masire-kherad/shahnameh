[
  {
    "poem_id": 1632,
    "vorder": 1,
    "position": 0,
    "text": "سکندر چو بشنید کامد سپاه"
  },
  {
    "poem_id": 1632,
    "vorder": 2,
    "position": 1,
    "text": "پذیره شدن را بپیمود راه"
  },
  {
    "poem_id": 1632,
    "vorder": 3,
    "position": 0,
    "text": "میان دو لشکر دو فرسنگ ماند"
  },
  {
    "poem_id": 1632,
    "vorder": 4,
    "position": 1,
    "text": "سکندر گرانمایگان را بخواند"
  },
  {
    "poem_id": 1632,
    "vorder": 5,
    "position": 0,
    "text": "چو سیر آمد از گفتهٔ رهنمای"
  },
  {
    "poem_id": 1632,
    "vorder": 6,
    "position": 1,
    "text": "چنین گفت کاکنون جزین نیست رای"
  },
  {
    "poem_id": 1632,
    "vorder": 7,
    "position": 0,
    "text": "که من چون فرستاده‌ای پیش اوی"
  },
  {
    "poem_id": 1632,
    "vorder": 8,
    "position": 1,
    "text": "شوم برگرایم کم و بیش اوی"
  },
  {
    "poem_id": 1632,
    "vorder": 9,
    "position": 0,
    "text": "کمر خواست پرگوهر شاهوار"
  },
  {
    "poem_id": 1632,
    "vorder": 10,
    "position": 1,
    "text": "یکی خسروی جامهٔ زرنگار"
  },
  {
    "poem_id": 1632,
    "vorder": 11,
    "position": 0,
    "text": "ببردند بالای زرین ستام"
  },
  {
    "poem_id": 1632,
    "vorder": 12,
    "position": 1,
    "text": "به زین اندرون تیغ زرین نیام"
  },
  {
    "poem_id": 1632,
    "vorder": 13,
    "position": 0,
    "text": "سواری ده از رومیان برگزید"
  },
  {
    "poem_id": 1632,
    "vorder": 14,
    "position": 1,
    "text": "که دانند هرگونه گفت و شنید"
  },
  {
    "poem_id": 1632,
    "vorder": 15,
    "position": 0,
    "text": "ز لشکر بیامد سپیده دمان"
  },
  {
    "poem_id": 1632,
    "vorder": 16,
    "position": 1,
    "text": "خود و نامداران ابا ترجمان"
  },
  {
    "poem_id": 1632,
    "vorder": 17,
    "position": 0,
    "text": "چو آمد به نزدیک دارا فراز"
  },
  {
    "poem_id": 1632,
    "vorder": 18,
    "position": 1,
    "text": "پیاده شد و برد پیشش نماز"
  },
  {
    "poem_id": 1632,
    "vorder": 19,
    "position": 0,
    "text": "جهاندار دارا مر او را بخواند"
  },
  {
    "poem_id": 1632,
    "vorder": 20,
    "position": 1,
    "text": "بپرسید و بر زیر گاهش نشاند"
  },
  {
    "poem_id": 1632,
    "vorder": 21,
    "position": 0,
    "text": "همه نامداران فروماندند"
  },
  {
    "poem_id": 1632,
    "vorder": 22,
    "position": 1,
    "text": "بروبر نهان آفرین خواندند"
  },
  {
    "poem_id": 1632,
    "vorder": 23,
    "position": 0,
    "text": "ز دیدار آن فر و فرهنگ او"
  },
  {
    "poem_id": 1632,
    "vorder": 24,
    "position": 1,
    "text": "ز بالا و از شاخ و آهنگ او"
  },
  {
    "poem_id": 1632,
    "vorder": 25,
    "position": 0,
    "text": "همانگه چو بنشست بر پای خاست"
  },
  {
    "poem_id": 1632,
    "vorder": 26,
    "position": 1,
    "text": "پیام سکندر بیاراست راست"
  },
  {
    "poem_id": 1632,
    "vorder": 27,
    "position": 0,
    "text": "نخست آفرین کرد بر شهریار"
  },
  {
    "poem_id": 1632,
    "vorder": 28,
    "position": 1,
    "text": "که جاوید بادا سر تاج‌دار"
  },
  {
    "poem_id": 1632,
    "vorder": 29,
    "position": 0,
    "text": "سکندر چنین گفت کای نیک‌نام"
  },
  {
    "poem_id": 1632,
    "vorder": 30,
    "position": 1,
    "text": "به گیتی بهرجای گسترده کام"
  },
  {
    "poem_id": 1632,
    "vorder": 31,
    "position": 0,
    "text": "مرا آرزو نیست با شاه جنگ"
  },
  {
    "poem_id": 1632,
    "vorder": 32,
    "position": 1,
    "text": "نه بر بوم ایران گرفتن درنگ"
  },
  {
    "poem_id": 1632,
    "vorder": 33,
    "position": 0,
    "text": "برآنم که گرد زمین اندکی"
  },
  {
    "poem_id": 1632,
    "vorder": 34,
    "position": 1,
    "text": "بگردم ببینم جهان را یکی"
  },
  {
    "poem_id": 1632,
    "vorder": 35,
    "position": 0,
    "text": "همه راستی خواهم و نیکویی"
  },
  {
    "poem_id": 1632,
    "vorder": 36,
    "position": 1,
    "text": "به ویژه که سالار ایران تویی"
  },
  {
    "poem_id": 1632,
    "vorder": 37,
    "position": 0,
    "text": "اگر خاک داری تو از من دریغ"
  },
  {
    "poem_id": 1632,
    "vorder": 38,
    "position": 1,
    "text": "نشاید سپردن هوا را چو میغ"
  },
  {
    "poem_id": 1632,
    "vorder": 39,
    "position": 0,
    "text": "چنین با سپاه آمدی پیش من"
  },
  {
    "poem_id": 1632,
    "vorder": 40,
    "position": 1,
    "text": "نه آگاهی از رای کم بیش من"
  },
  {
    "poem_id": 1632,
    "vorder": 41,
    "position": 0,
    "text": "چو رزم آوری باتو رزم آورم"
  },
  {
    "poem_id": 1632,
    "vorder": 42,
    "position": 1,
    "text": "ازین بوم بی‌رزم برنگذرم"
  },
  {
    "poem_id": 1632,
    "vorder": 43,
    "position": 0,
    "text": "گزین کن یکی روزگار نبرد"
  },
  {
    "poem_id": 1632,
    "vorder": 44,
    "position": 1,
    "text": "برین باش و زین آرزو برمگرد"
  },
  {
    "poem_id": 1632,
    "vorder": 45,
    "position": 0,
    "text": "که من سر نپیچم ز جنگ سران"
  },
  {
    "poem_id": 1632,
    "vorder": 46,
    "position": 1,
    "text": "وگر چند باشد سپاهی گران"
  },
  {
    "poem_id": 1632,
    "vorder": 47,
    "position": 0,
    "text": "چو دارا بدید آن دل و رای او"
  },
  {
    "poem_id": 1632,
    "vorder": 48,
    "position": 1,
    "text": "سخن گفتن و فر و بالای او"
  },
  {
    "poem_id": 1632,
    "vorder": 49,
    "position": 0,
    "text": "تو گفتی که داراست بر تخت عاج"
  },
  {
    "poem_id": 1632,
    "vorder": 50,
    "position": 1,
    "text": "ابا یاره و طوق و با فر و تاج"
  },
  {
    "poem_id": 1632,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت نام و نژاد تو چیست"
  },
  {
    "poem_id": 1632,
    "vorder": 52,
    "position": 1,
    "text": "که بر فر و شاخت نشان کییست"
  },
  {
    "poem_id": 1632,
    "vorder": 53,
    "position": 0,
    "text": "از اندازهٔ کهتران برتری"
  },
  {
    "poem_id": 1632,
    "vorder": 54,
    "position": 1,
    "text": "من ایدون گمانم که اسکندری"
  },
  {
    "poem_id": 1632,
    "vorder": 55,
    "position": 0,
    "text": "بدین فر و بالا و گفتار و چهر"
  },
  {
    "poem_id": 1632,
    "vorder": 56,
    "position": 1,
    "text": "مگر تخت را پروریدت سپهر"
  },
  {
    "poem_id": 1632,
    "vorder": 57,
    "position": 0,
    "text": "چنین داد پاسخ که این کس نکرد"
  },
  {
    "poem_id": 1632,
    "vorder": 58,
    "position": 1,
    "text": "نه در آشتی و نه اندر نبرد"
  },
  {
    "poem_id": 1632,
    "vorder": 59,
    "position": 0,
    "text": "نه گویندگان بر درش کمترند"
  },
  {
    "poem_id": 1632,
    "vorder": 60,
    "position": 1,
    "text": "که بر تارک بخردان افسرند"
  },
  {
    "poem_id": 1632,
    "vorder": 61,
    "position": 0,
    "text": "کجا خود پیام آرد از خویشتن"
  },
  {
    "poem_id": 1632,
    "vorder": 62,
    "position": 1,
    "text": "چنان شهریاری سر انجمن"
  },
  {
    "poem_id": 1632,
    "vorder": 63,
    "position": 0,
    "text": "سکندر بدان مایه دارد خرد"
  },
  {
    "poem_id": 1632,
    "vorder": 64,
    "position": 1,
    "text": "که از رای پیشینگان بگذرد"
  },
  {
    "poem_id": 1632,
    "vorder": 65,
    "position": 0,
    "text": "پیامم سپهبد بدین گونه داد"
  },
  {
    "poem_id": 1632,
    "vorder": 66,
    "position": 1,
    "text": "بگفتم به شاه آنچ او کرد یاد"
  },
  {
    "poem_id": 1632,
    "vorder": 67,
    "position": 0,
    "text": "بیاراستندش یکی جایگاه"
  },
  {
    "poem_id": 1632,
    "vorder": 68,
    "position": 1,
    "text": "چنانچون بود درخور پایگاه"
  },
  {
    "poem_id": 1632,
    "vorder": 69,
    "position": 0,
    "text": "سپهدار ایران چو بنهاد خوان"
  },
  {
    "poem_id": 1632,
    "vorder": 70,
    "position": 1,
    "text": "به سالار فرمود کو را بخوان"
  },
  {
    "poem_id": 1632,
    "vorder": 71,
    "position": 0,
    "text": "چو نان خورده شد مجلس آراستند"
  },
  {
    "poem_id": 1632,
    "vorder": 72,
    "position": 1,
    "text": "می و رود و رامشگران خواستند"
  },
  {
    "poem_id": 1632,
    "vorder": 73,
    "position": 0,
    "text": "سکندر چو خوردی می خوشگوار"
  },
  {
    "poem_id": 1632,
    "vorder": 74,
    "position": 1,
    "text": "نهادی سبک جام را بر کنار"
  },
  {
    "poem_id": 1632,
    "vorder": 75,
    "position": 0,
    "text": "چنین تا می و جام چندی بگشت"
  },
  {
    "poem_id": 1632,
    "vorder": 76,
    "position": 1,
    "text": "نهادن ز اندازه اندر گذشت"
  },
  {
    "poem_id": 1632,
    "vorder": 77,
    "position": 0,
    "text": "دهنده بیامد به دارا بگفت"
  },
  {
    "poem_id": 1632,
    "vorder": 78,
    "position": 1,
    "text": "که رومی شد امروز با جام جفت"
  },
  {
    "poem_id": 1632,
    "vorder": 79,
    "position": 0,
    "text": "بفرمود تا زو بپرسند شاه"
  },
  {
    "poem_id": 1632,
    "vorder": 80,
    "position": 1,
    "text": "که جام نبید از چه داری نگاه"
  },
  {
    "poem_id": 1632,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت ساقی که ای شیر فش"
  },
  {
    "poem_id": 1632,
    "vorder": 82,
    "position": 1,
    "text": "چه داری همی جام زرین به کش"
  },
  {
    "poem_id": 1632,
    "vorder": 83,
    "position": 0,
    "text": "سکندر چنین داد پاسخ که جام"
  },
  {
    "poem_id": 1632,
    "vorder": 84,
    "position": 1,
    "text": "فرستاده را باشد ای نیک‌نام"
  },
  {
    "poem_id": 1632,
    "vorder": 85,
    "position": 0,
    "text": "گر آیین ایران جز اینست راه"
  },
  {
    "poem_id": 1632,
    "vorder": 86,
    "position": 1,
    "text": "ببر جام زرین سوی گنج شاه"
  },
  {
    "poem_id": 1632,
    "vorder": 87,
    "position": 0,
    "text": "بخندید از آیین او شهریار"
  },
  {
    "poem_id": 1632,
    "vorder": 88,
    "position": 1,
    "text": "یکی جام پرگوهر شاهوار"
  },
  {
    "poem_id": 1632,
    "vorder": 89,
    "position": 0,
    "text": "بفرمود تا بر کفش برنهند"
  },
  {
    "poem_id": 1632,
    "vorder": 90,
    "position": 1,
    "text": "یکی سرخ یاقوت بر سر نهند"
  },
  {
    "poem_id": 1632,
    "vorder": 91,
    "position": 0,
    "text": "هم‌اندر زمان باژ خواهان روم"
  },
  {
    "poem_id": 1632,
    "vorder": 92,
    "position": 1,
    "text": "کجا رفته بودند زان مرز و بوم"
  },
  {
    "poem_id": 1632,
    "vorder": 93,
    "position": 0,
    "text": "ز خانه بدان بزمگاه آمدند"
  },
  {
    "poem_id": 1632,
    "vorder": 94,
    "position": 1,
    "text": "خرامان به نزدیک شاه آمدند"
  },
  {
    "poem_id": 1632,
    "vorder": 95,
    "position": 0,
    "text": "فرستاده روی سکندر بدید"
  },
  {
    "poem_id": 1632,
    "vorder": 96,
    "position": 1,
    "text": "بر شاه رفت آفرین گسترید"
  },
  {
    "poem_id": 1632,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت کاین مهتر اسکندرست"
  },
  {
    "poem_id": 1632,
    "vorder": 98,
    "position": 1,
    "text": "که بر تخت با گرز و با افسرست"
  },
  {
    "poem_id": 1632,
    "vorder": 99,
    "position": 0,
    "text": "بدانگه که ما را بفرمود شاه"
  },
  {
    "poem_id": 1632,
    "vorder": 100,
    "position": 1,
    "text": "برفتیم نزدیک او باژخواه"
  },
  {
    "poem_id": 1632,
    "vorder": 101,
    "position": 0,
    "text": "برآشفت و ما را بدان خوار کرد"
  },
  {
    "poem_id": 1632,
    "vorder": 102,
    "position": 1,
    "text": "به گفتار با شاه پیکار کرد"
  },
  {
    "poem_id": 1632,
    "vorder": 103,
    "position": 0,
    "text": "چو از پادشاهیش بگریختم"
  },
  {
    "poem_id": 1632,
    "vorder": 104,
    "position": 1,
    "text": "شب تیره اسپان برانگیختم"
  },
  {
    "poem_id": 1632,
    "vorder": 105,
    "position": 0,
    "text": "ندیدیم مانندهٔ او به روم"
  },
  {
    "poem_id": 1632,
    "vorder": 106,
    "position": 1,
    "text": "دلیر آمدست اندرین مرز و بوم"
  },
  {
    "poem_id": 1632,
    "vorder": 107,
    "position": 0,
    "text": "همی برگراید سپاه ترا"
  },
  {
    "poem_id": 1632,
    "vorder": 108,
    "position": 1,
    "text": "همان گنج و تخت و کلاه ترا"
  },
  {
    "poem_id": 1632,
    "vorder": 109,
    "position": 0,
    "text": "چو گفت فرستاده بشنید شاه"
  },
  {
    "poem_id": 1632,
    "vorder": 110,
    "position": 1,
    "text": "فزون کرد سوی سکندر نگاه"
  },
  {
    "poem_id": 1632,
    "vorder": 111,
    "position": 0,
    "text": "سکندر بدانست کاندر نهان"
  },
  {
    "poem_id": 1632,
    "vorder": 112,
    "position": 1,
    "text": "چه گفتند با شهریار جهان"
  },
  {
    "poem_id": 1632,
    "vorder": 113,
    "position": 0,
    "text": "همی بود تا تیره‌تر گشت روز"
  },
  {
    "poem_id": 1632,
    "vorder": 114,
    "position": 1,
    "text": "سوی باختر گشت گیتی‌فروز"
  },
  {
    "poem_id": 1632,
    "vorder": 115,
    "position": 0,
    "text": "بیامد به دهلیز پرده‌سرای"
  },
  {
    "poem_id": 1632,
    "vorder": 116,
    "position": 1,
    "text": "دلاور به اسپ اندر آورد پای"
  },
  {
    "poem_id": 1632,
    "vorder": 117,
    "position": 0,
    "text": "چنین گفت پس با سواران خویش"
  },
  {
    "poem_id": 1632,
    "vorder": 118,
    "position": 1,
    "text": "بلنداختر و نامداران خویش"
  },
  {
    "poem_id": 1632,
    "vorder": 119,
    "position": 0,
    "text": "که ما را کنون جان به اسپ اندرست"
  },
  {
    "poem_id": 1632,
    "vorder": 120,
    "position": 1,
    "text": "چو سستی کند باد ماند به دست"
  },
  {
    "poem_id": 1632,
    "vorder": 121,
    "position": 0,
    "text": "همه بادپایان برانگیختند"
  },
  {
    "poem_id": 1632,
    "vorder": 122,
    "position": 1,
    "text": "ز پیش جهاندار بگریختند"
  },
  {
    "poem_id": 1632,
    "vorder": 123,
    "position": 0,
    "text": "چو دارا سر و افسر او ندید"
  },
  {
    "poem_id": 1632,
    "vorder": 124,
    "position": 1,
    "text": "به تاریکی از چشم شد ناپدید"
  },
  {
    "poem_id": 1632,
    "vorder": 125,
    "position": 0,
    "text": "نگهبان فرستاد هم در زمان"
  },
  {
    "poem_id": 1632,
    "vorder": 126,
    "position": 1,
    "text": "به نزدیکی خیمهٔ بدگمان"
  },
  {
    "poem_id": 1632,
    "vorder": 127,
    "position": 0,
    "text": "چو رفتند بیداردل رفته بود"
  },
  {
    "poem_id": 1632,
    "vorder": 128,
    "position": 1,
    "text": "نه بخت چنان پادشا خفته بود"
  },
  {
    "poem_id": 1632,
    "vorder": 129,
    "position": 0,
    "text": "پس او فرستاد دارا سوار"
  },
  {
    "poem_id": 1632,
    "vorder": 130,
    "position": 1,
    "text": "دلیران و پرخاشجویان هزار"
  },
  {
    "poem_id": 1632,
    "vorder": 131,
    "position": 0,
    "text": "چو باد از پس او همی تاختند"
  },
  {
    "poem_id": 1632,
    "vorder": 132,
    "position": 1,
    "text": "شب تیرهٔ بد راه نشناختند"
  },
  {
    "poem_id": 1632,
    "vorder": 133,
    "position": 0,
    "text": "طلایه بدیدند گشتند باز"
  },
  {
    "poem_id": 1632,
    "vorder": 134,
    "position": 1,
    "text": "نبد سود جز رنج و راه دراز"
  },
  {
    "poem_id": 1632,
    "vorder": 135,
    "position": 0,
    "text": "چو اسکندر آمد به پرده‌سرای"
  },
  {
    "poem_id": 1632,
    "vorder": 136,
    "position": 1,
    "text": "برفتند گردان رومی ز جای"
  },
  {
    "poem_id": 1632,
    "vorder": 137,
    "position": 0,
    "text": "بدیدند شب شاه را شادکام"
  },
  {
    "poem_id": 1632,
    "vorder": 138,
    "position": 1,
    "text": "به پیش اندرون پرگهر چار جام"
  },
  {
    "poem_id": 1632,
    "vorder": 139,
    "position": 0,
    "text": "به گردان چنین گفت کاباد بید"
  },
  {
    "poem_id": 1632,
    "vorder": 140,
    "position": 1,
    "text": "بدین فرخی فال ما شاد بید"
  },
  {
    "poem_id": 1632,
    "vorder": 141,
    "position": 0,
    "text": "که این جام پیروزی جان ماست"
  },
  {
    "poem_id": 1632,
    "vorder": 142,
    "position": 1,
    "text": "سر اختران زیر فرمان ماست"
  },
  {
    "poem_id": 1632,
    "vorder": 143,
    "position": 0,
    "text": "هم از لشکرش برگرفتم شمار"
  },
  {
    "poem_id": 1632,
    "vorder": 144,
    "position": 1,
    "text": "فراوان کم است از شنیده سوار"
  },
  {
    "poem_id": 1632,
    "vorder": 145,
    "position": 0,
    "text": "همه جنگ را تیغها برکشید"
  },
  {
    "poem_id": 1632,
    "vorder": 146,
    "position": 1,
    "text": "وزین دشت هامون سر اندرکشید"
  },
  {
    "poem_id": 1632,
    "vorder": 147,
    "position": 0,
    "text": "چو در جنگ تن را به رنج آورید"
  },
  {
    "poem_id": 1632,
    "vorder": 148,
    "position": 1,
    "text": "ازان رنج شاهی و گنج آورید"
  },
  {
    "poem_id": 1632,
    "vorder": 149,
    "position": 0,
    "text": "جهان آفریننده یار منست"
  },
  {
    "poem_id": 1632,
    "vorder": 150,
    "position": 1,
    "text": "سر اختر اندر کنار منست"
  },
  {
    "poem_id": 1632,
    "vorder": 151,
    "position": 0,
    "text": "بزرگان برو خواندند آفرین"
  },
  {
    "poem_id": 1632,
    "vorder": 152,
    "position": 1,
    "text": "که آباد بادا به قیصر زمین"
  },
  {
    "poem_id": 1632,
    "vorder": 153,
    "position": 0,
    "text": "فدای تو بادا تن و جان ما"
  },
  {
    "poem_id": 1632,
    "vorder": 154,
    "position": 1,
    "text": "برینست جاوید پیمان ما"
  },
  {
    "poem_id": 1632,
    "vorder": 155,
    "position": 0,
    "text": "ز شاهان که یارد بدن یار تو"
  },
  {
    "poem_id": 1632,
    "vorder": 156,
    "position": 1,
    "text": "به مردی و بالا و دیدار تو"
  }
]