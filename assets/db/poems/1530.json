[
  {
    "poem_id": 1530,
    "vorder": 1,
    "position": 0,
    "text": "چو چندی برآمد برین روزگار"
  },
  {
    "poem_id": 1530,
    "vorder": 2,
    "position": 1,
    "text": "خجسته ببود اختر شهریار"
  },
  {
    "poem_id": 1530,
    "vorder": 3,
    "position": 0,
    "text": "به شاه کیان گفت زردشت پیر"
  },
  {
    "poem_id": 1530,
    "vorder": 4,
    "position": 1,
    "text": "که در دین ما این نباشد هژیر"
  },
  {
    "poem_id": 1530,
    "vorder": 5,
    "position": 0,
    "text": "که تو باژ بدهی به سالار چین"
  },
  {
    "poem_id": 1530,
    "vorder": 6,
    "position": 1,
    "text": "نه اندر خور دین ما باشد این"
  },
  {
    "poem_id": 1530,
    "vorder": 7,
    "position": 0,
    "text": "نباشم برین نیز همداستان"
  },
  {
    "poem_id": 1530,
    "vorder": 8,
    "position": 1,
    "text": "که شاهان ما درگه باستان"
  },
  {
    "poem_id": 1530,
    "vorder": 9,
    "position": 0,
    "text": "به ترکان نداد ایچ کس باژ و ساو"
  },
  {
    "poem_id": 1530,
    "vorder": 10,
    "position": 1,
    "text": "برین روزگار گذشته بتاو"
  },
  {
    "poem_id": 1530,
    "vorder": 11,
    "position": 0,
    "text": "پذیرفت گشتاسپ گفتا که نیز"
  },
  {
    "poem_id": 1530,
    "vorder": 12,
    "position": 1,
    "text": "نفرمایمش دادن این باژ چیز"
  },
  {
    "poem_id": 1530,
    "vorder": 13,
    "position": 0,
    "text": "پس آگاه شد نره دیوی ازین"
  },
  {
    "poem_id": 1530,
    "vorder": 14,
    "position": 1,
    "text": "هم‌اندرز زمان شد سوی شاه چین"
  },
  {
    "poem_id": 1530,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت کای شهریار جهان"
  },
  {
    "poem_id": 1530,
    "vorder": 16,
    "position": 1,
    "text": "جهان یکسره پیش تو چون کهان"
  },
  {
    "poem_id": 1530,
    "vorder": 17,
    "position": 0,
    "text": "به جای آوریدند فرمان تو"
  },
  {
    "poem_id": 1530,
    "vorder": 18,
    "position": 1,
    "text": "نتابد کسی سر ز پیمان تو"
  },
  {
    "poem_id": 1530,
    "vorder": 19,
    "position": 0,
    "text": "مگر پورلهراسپ گشتاسپ شاه"
  },
  {
    "poem_id": 1530,
    "vorder": 20,
    "position": 1,
    "text": "که آرد همی سوی ترکان سپاه"
  },
  {
    "poem_id": 1530,
    "vorder": 21,
    "position": 0,
    "text": "برد آشکارا همه دشمنی"
  },
  {
    "poem_id": 1530,
    "vorder": 22,
    "position": 1,
    "text": "ابا تو چنو کرد یارد منی"
  },
  {
    "poem_id": 1530,
    "vorder": 23,
    "position": 0,
    "text": "چو ارجاسپ بشنید گفتار دیو"
  },
  {
    "poem_id": 1530,
    "vorder": 24,
    "position": 1,
    "text": "فرود آمد از گاه گیهان خدیو"
  },
  {
    "poem_id": 1530,
    "vorder": 25,
    "position": 0,
    "text": "از اندوه او سست و بیمار شد"
  },
  {
    "poem_id": 1530,
    "vorder": 26,
    "position": 1,
    "text": "دل و جان او پر ز تیمار شد"
  },
  {
    "poem_id": 1530,
    "vorder": 27,
    "position": 0,
    "text": "تگینان لشکرش را پیش خواند"
  },
  {
    "poem_id": 1530,
    "vorder": 28,
    "position": 1,
    "text": "شنیده سخن پیش ایشان براند"
  },
  {
    "poem_id": 1530,
    "vorder": 29,
    "position": 0,
    "text": "بدانید گفتا کز ایران زمین"
  },
  {
    "poem_id": 1530,
    "vorder": 30,
    "position": 1,
    "text": "بشد فره و دانش و پاک دین"
  },
  {
    "poem_id": 1530,
    "vorder": 31,
    "position": 0,
    "text": "یکی جادو آمد به دین آوری"
  },
  {
    "poem_id": 1530,
    "vorder": 32,
    "position": 1,
    "text": "به ایران به دعوی پیغمبری"
  },
  {
    "poem_id": 1530,
    "vorder": 33,
    "position": 0,
    "text": "همی گوید از آسمان آمدم"
  },
  {
    "poem_id": 1530,
    "vorder": 34,
    "position": 1,
    "text": "ز نزد خدای جهان آمدم"
  },
  {
    "poem_id": 1530,
    "vorder": 35,
    "position": 0,
    "text": "خداوند را دیدم اندر بهشت"
  },
  {
    "poem_id": 1530,
    "vorder": 36,
    "position": 1,
    "text": "من این زند و استا همه زو نوشت"
  },
  {
    "poem_id": 1530,
    "vorder": 37,
    "position": 0,
    "text": "بدوزخ درون دیدم آهرمنا"
  },
  {
    "poem_id": 1530,
    "vorder": 38,
    "position": 1,
    "text": "نیارستمش گشت پیرامنا"
  },
  {
    "poem_id": 1530,
    "vorder": 39,
    "position": 0,
    "text": "گروگر فرستادم از بهر دین"
  },
  {
    "poem_id": 1530,
    "vorder": 40,
    "position": 1,
    "text": "بیارای گفتا به دانش زمین"
  },
  {
    "poem_id": 1530,
    "vorder": 41,
    "position": 0,
    "text": "سرنامداران ایران سپاه"
  },
  {
    "poem_id": 1530,
    "vorder": 42,
    "position": 1,
    "text": "گرانمایه فرزند لهراسپ شاه"
  },
  {
    "poem_id": 1530,
    "vorder": 43,
    "position": 0,
    "text": "که گشتاسپ خوانندش ایرانیان"
  },
  {
    "poem_id": 1530,
    "vorder": 44,
    "position": 1,
    "text": "ببست او یکی کشتی بر میان"
  },
  {
    "poem_id": 1530,
    "vorder": 45,
    "position": 0,
    "text": "برادرش نیز آن سوار دلیر"
  },
  {
    "poem_id": 1530,
    "vorder": 46,
    "position": 1,
    "text": "سپهدار ایران که نامش زریر"
  },
  {
    "poem_id": 1530,
    "vorder": 47,
    "position": 0,
    "text": "همه پیش آن دین پژوه آمدند"
  },
  {
    "poem_id": 1530,
    "vorder": 48,
    "position": 1,
    "text": "ازان پیر جادو ستوه آمدند"
  },
  {
    "poem_id": 1530,
    "vorder": 49,
    "position": 0,
    "text": "گرفتند ازو سربسر دین اوی"
  },
  {
    "poem_id": 1530,
    "vorder": 50,
    "position": 1,
    "text": "جهان شد پر از راه و آیین اوی"
  },
  {
    "poem_id": 1530,
    "vorder": 51,
    "position": 0,
    "text": "نشست او به ایران به پیغمبری"
  },
  {
    "poem_id": 1530,
    "vorder": 52,
    "position": 1,
    "text": "به کاری چنان یافه و سرسری"
  },
  {
    "poem_id": 1530,
    "vorder": 53,
    "position": 0,
    "text": "یکی نامه باید نوشتن کنون"
  },
  {
    "poem_id": 1530,
    "vorder": 54,
    "position": 1,
    "text": "سوی آن زده سر ز فرمان برون"
  },
  {
    "poem_id": 1530,
    "vorder": 55,
    "position": 0,
    "text": "ببایدش دادن بسی خواسته"
  },
  {
    "poem_id": 1530,
    "vorder": 56,
    "position": 1,
    "text": "که نیکو بود داده ناخواسته"
  },
  {
    "poem_id": 1530,
    "vorder": 57,
    "position": 0,
    "text": "مر او را بگویی کزین راه زشت"
  },
  {
    "poem_id": 1530,
    "vorder": 58,
    "position": 1,
    "text": "بگرد و بترس از خدای بهشت"
  },
  {
    "poem_id": 1530,
    "vorder": 59,
    "position": 0,
    "text": "مر آن پیر ناپاک را دور کن"
  },
  {
    "poem_id": 1530,
    "vorder": 60,
    "position": 1,
    "text": "بر آیین ما بر یکی سور کن"
  },
  {
    "poem_id": 1530,
    "vorder": 61,
    "position": 0,
    "text": "گر ایدونک نپذیرد از ما سخن"
  },
  {
    "poem_id": 1530,
    "vorder": 62,
    "position": 1,
    "text": "کند روی تازه بما بر کهن"
  },
  {
    "poem_id": 1530,
    "vorder": 63,
    "position": 0,
    "text": "سپاه پراگنده باز آوریم"
  },
  {
    "poem_id": 1530,
    "vorder": 64,
    "position": 1,
    "text": "یکی خوب لشکر فراز آوریم"
  },
  {
    "poem_id": 1530,
    "vorder": 65,
    "position": 0,
    "text": "به ایران شویم از پس کار اوی"
  },
  {
    "poem_id": 1530,
    "vorder": 66,
    "position": 1,
    "text": "نترسیم از آزار و پیکار اوی"
  },
  {
    "poem_id": 1530,
    "vorder": 67,
    "position": 0,
    "text": "برانیمش از پیش و خوارش کنیم"
  },
  {
    "poem_id": 1530,
    "vorder": 68,
    "position": 1,
    "text": "ببندیم و زنده به دارش کنیم"
  }
]