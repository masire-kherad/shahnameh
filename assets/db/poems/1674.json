[
  {
    "poem_id": 1674,
    "vorder": 1,
    "position": 0,
    "text": "سکندر چو بشنید شد سوی کوه"
  },
  {
    "poem_id": 1674,
    "vorder": 2,
    "position": 1,
    "text": "به دیدار بر تیغ شد بی‌گروه"
  },
  {
    "poem_id": 1674,
    "vorder": 3,
    "position": 0,
    "text": "سرافیل را دید صوری به دست"
  },
  {
    "poem_id": 1674,
    "vorder": 4,
    "position": 1,
    "text": "برافراخته سر ز جای نشست"
  },
  {
    "poem_id": 1674,
    "vorder": 5,
    "position": 0,
    "text": "پر از باد لب دیدگان پرزنم"
  },
  {
    "poem_id": 1674,
    "vorder": 6,
    "position": 1,
    "text": "که فرمان یزدان کی آید که دم"
  },
  {
    "poem_id": 1674,
    "vorder": 7,
    "position": 0,
    "text": "چو بر کوه روی سکندر بدید"
  },
  {
    "poem_id": 1674,
    "vorder": 8,
    "position": 1,
    "text": "چو رعد خروشان فغان برکشید"
  },
  {
    "poem_id": 1674,
    "vorder": 9,
    "position": 0,
    "text": "که ای بندهٔ آز چندین مکوش"
  },
  {
    "poem_id": 1674,
    "vorder": 10,
    "position": 1,
    "text": "که روزی به گوش آیدت یک خروش"
  },
  {
    "poem_id": 1674,
    "vorder": 11,
    "position": 0,
    "text": "که چندین مرنج از پی تاج و تخت"
  },
  {
    "poem_id": 1674,
    "vorder": 12,
    "position": 1,
    "text": "به رفتن بیارای و بربند رخت"
  },
  {
    "poem_id": 1674,
    "vorder": 13,
    "position": 0,
    "text": "چنین داد پاسخ بدو شهریار"
  },
  {
    "poem_id": 1674,
    "vorder": 14,
    "position": 1,
    "text": "که بهر من این آمد از روزگار"
  },
  {
    "poem_id": 1674,
    "vorder": 15,
    "position": 0,
    "text": "که جز جنبش و گردش اندر جهان"
  },
  {
    "poem_id": 1674,
    "vorder": 16,
    "position": 1,
    "text": "نبینم همی آشکار و نهان"
  },
  {
    "poem_id": 1674,
    "vorder": 17,
    "position": 0,
    "text": "ازان کوه با ناله آمد فرود"
  },
  {
    "poem_id": 1674,
    "vorder": 18,
    "position": 1,
    "text": "همی داد نیکی دهش را درود"
  },
  {
    "poem_id": 1674,
    "vorder": 19,
    "position": 0,
    "text": "بران راه تاریک بنهاد روی"
  },
  {
    "poem_id": 1674,
    "vorder": 20,
    "position": 1,
    "text": "به پیش اندرون مردم راه‌جوی"
  },
  {
    "poem_id": 1674,
    "vorder": 21,
    "position": 0,
    "text": "چو آمد به تاریکی اندر سپاه"
  },
  {
    "poem_id": 1674,
    "vorder": 22,
    "position": 1,
    "text": "خروشی برآمد ز کوه سیاه"
  },
  {
    "poem_id": 1674,
    "vorder": 23,
    "position": 0,
    "text": "که هرکس که بردارد از کوه سنگ"
  },
  {
    "poem_id": 1674,
    "vorder": 24,
    "position": 1,
    "text": "پشیمان شود ز آنک دارد به چنگ"
  },
  {
    "poem_id": 1674,
    "vorder": 25,
    "position": 0,
    "text": "وگر برندارد پشیمان شود"
  },
  {
    "poem_id": 1674,
    "vorder": 26,
    "position": 1,
    "text": "به هر درد دل سوی درمان شود"
  },
  {
    "poem_id": 1674,
    "vorder": 27,
    "position": 0,
    "text": "سپه سوی آواز بنهاد گوش"
  },
  {
    "poem_id": 1674,
    "vorder": 28,
    "position": 1,
    "text": "پراندیشه شد هرکسی زان خروش"
  },
  {
    "poem_id": 1674,
    "vorder": 29,
    "position": 0,
    "text": "که بردارد آن سنگ اگر بگذرد"
  },
  {
    "poem_id": 1674,
    "vorder": 30,
    "position": 1,
    "text": "پی رنج ناآمده نشمرد"
  },
  {
    "poem_id": 1674,
    "vorder": 31,
    "position": 0,
    "text": "یکی گفت کین رنج هست از گناه"
  },
  {
    "poem_id": 1674,
    "vorder": 32,
    "position": 1,
    "text": "پشیمانی و سنگ بردن به راه"
  },
  {
    "poem_id": 1674,
    "vorder": 33,
    "position": 0,
    "text": "دگر گفت لختی بباید کشید"
  },
  {
    "poem_id": 1674,
    "vorder": 34,
    "position": 1,
    "text": "مگر درد و رنجش نباید چشید"
  },
  {
    "poem_id": 1674,
    "vorder": 35,
    "position": 0,
    "text": "یکی برد زان سنگ و دیگر نبرد"
  },
  {
    "poem_id": 1674,
    "vorder": 36,
    "position": 1,
    "text": "یکی دیگر از کاهلی داشت خرد"
  },
  {
    "poem_id": 1674,
    "vorder": 37,
    "position": 0,
    "text": "چو از آب حیوان به هامون شدند"
  },
  {
    "poem_id": 1674,
    "vorder": 38,
    "position": 1,
    "text": "ز تاریکی راه بیرون شدند"
  },
  {
    "poem_id": 1674,
    "vorder": 39,
    "position": 0,
    "text": "بجستند هرکس بر و آستی"
  },
  {
    "poem_id": 1674,
    "vorder": 40,
    "position": 1,
    "text": "پدیدار شد کژی و کاستی"
  },
  {
    "poem_id": 1674,
    "vorder": 41,
    "position": 0,
    "text": "کنار یکی پر ز یاقوت بود"
  },
  {
    "poem_id": 1674,
    "vorder": 42,
    "position": 1,
    "text": "یکی را پر از گوهر نابسود"
  },
  {
    "poem_id": 1674,
    "vorder": 43,
    "position": 0,
    "text": "پشیمان شد آنکس که کم داشت اوی"
  },
  {
    "poem_id": 1674,
    "vorder": 44,
    "position": 1,
    "text": "زبرجد چنان خار بگذاشت اوی"
  },
  {
    "poem_id": 1674,
    "vorder": 45,
    "position": 0,
    "text": "پشیمان‌تر آنکس که خود برنداشت"
  },
  {
    "poem_id": 1674,
    "vorder": 46,
    "position": 1,
    "text": "ازان گوهر پربها سر بگاشت"
  },
  {
    "poem_id": 1674,
    "vorder": 47,
    "position": 0,
    "text": "دو هفته بر آن جایگه بر بماند"
  },
  {
    "poem_id": 1674,
    "vorder": 48,
    "position": 1,
    "text": "چو آسوده‌تر گشت لشکر براند"
  }
]