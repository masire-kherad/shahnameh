[
  {
    "poem_id": 1899,
    "vorder": 1,
    "position": 0,
    "text": "چویک ماه شد نامه پاسخ نوشت"
  },
  {
    "poem_id": 1899,
    "vorder": 2,
    "position": 1,
    "text": "سخنهای با مغز و فرخ نوشت"
  },
  {
    "poem_id": 1899,
    "vorder": 3,
    "position": 0,
    "text": "سرنامه گفت آفرین مهان"
  },
  {
    "poem_id": 1899,
    "vorder": 4,
    "position": 1,
    "text": "بران باد کو باد دارد جهان"
  },
  {
    "poem_id": 1899,
    "vorder": 5,
    "position": 0,
    "text": "بد و نیک بیند ز یزدان پاک"
  },
  {
    "poem_id": 1899,
    "vorder": 6,
    "position": 1,
    "text": "وزو دارد اندر جهان بیم و باک"
  },
  {
    "poem_id": 1899,
    "vorder": 7,
    "position": 0,
    "text": "کند آفرین بر خداوند مهر"
  },
  {
    "poem_id": 1899,
    "vorder": 8,
    "position": 1,
    "text": "کزین گونه بر پای دارد سپهر"
  },
  {
    "poem_id": 1899,
    "vorder": 9,
    "position": 0,
    "text": "نخست آنک کردی ستایش مرا"
  },
  {
    "poem_id": 1899,
    "vorder": 10,
    "position": 1,
    "text": "به نامه نمودی نیایش مرا"
  },
  {
    "poem_id": 1899,
    "vorder": 11,
    "position": 0,
    "text": "بدانستم و شاد گشتم بدان"
  },
  {
    "poem_id": 1899,
    "vorder": 12,
    "position": 1,
    "text": "سخن گفتن تاجور بخردان"
  },
  {
    "poem_id": 1899,
    "vorder": 13,
    "position": 0,
    "text": "پذیرفتم آن نامور گنج تو"
  },
  {
    "poem_id": 1899,
    "vorder": 14,
    "position": 1,
    "text": "نخواهم که چندان بود رنج تو"
  },
  {
    "poem_id": 1899,
    "vorder": 15,
    "position": 0,
    "text": "ازیرا جهاندار یزدان پاک"
  },
  {
    "poem_id": 1899,
    "vorder": 16,
    "position": 1,
    "text": "برآورد بوم تو را بر سماک"
  },
  {
    "poem_id": 1899,
    "vorder": 17,
    "position": 0,
    "text": "ز هند و ز سقلاب و چین و خزر"
  },
  {
    "poem_id": 1899,
    "vorder": 18,
    "position": 1,
    "text": "چنین ارجمند آمد آن بوم و بر"
  },
  {
    "poem_id": 1899,
    "vorder": 19,
    "position": 0,
    "text": "چه مردی چه دانش چه پرهیز و دین"
  },
  {
    "poem_id": 1899,
    "vorder": 20,
    "position": 1,
    "text": "ز یزدان شما را رسید آفرین"
  },
  {
    "poem_id": 1899,
    "vorder": 21,
    "position": 0,
    "text": "چو کار آمدم پیش یارم بدی"
  },
  {
    "poem_id": 1899,
    "vorder": 22,
    "position": 1,
    "text": "بهر دانشی غمگسارم بدی"
  },
  {
    "poem_id": 1899,
    "vorder": 23,
    "position": 0,
    "text": "چنان شاد گشتم ز پیوند تو"
  },
  {
    "poem_id": 1899,
    "vorder": 24,
    "position": 1,
    "text": "بدین پر هنر پاک فرزند تو"
  },
  {
    "poem_id": 1899,
    "vorder": 25,
    "position": 0,
    "text": "که کهتر نباشد به فرزند خویش"
  },
  {
    "poem_id": 1899,
    "vorder": 26,
    "position": 1,
    "text": "ببوم و بر و پاک پیوند خویش"
  },
  {
    "poem_id": 1899,
    "vorder": 27,
    "position": 0,
    "text": "همه مهتران پشت برگاشتند"
  },
  {
    "poem_id": 1899,
    "vorder": 28,
    "position": 1,
    "text": "مرا در جهان خوار بگذاشتند"
  },
  {
    "poem_id": 1899,
    "vorder": 29,
    "position": 0,
    "text": "تو تنها بجای پدر بودیم"
  },
  {
    "poem_id": 1899,
    "vorder": 30,
    "position": 1,
    "text": "همان از پدر بیشتر بودیم"
  },
  {
    "poem_id": 1899,
    "vorder": 31,
    "position": 0,
    "text": "تو را همچنان دارم اکنون که شاه"
  },
  {
    "poem_id": 1899,
    "vorder": 32,
    "position": 1,
    "text": "پدر بیند آزاده و نیک خواه"
  },
  {
    "poem_id": 1899,
    "vorder": 33,
    "position": 0,
    "text": "دگر هرچ گفتی ز شیروی من"
  },
  {
    "poem_id": 1899,
    "vorder": 34,
    "position": 1,
    "text": "ازان پاک تن پشت و نیروی من"
  },
  {
    "poem_id": 1899,
    "vorder": 35,
    "position": 0,
    "text": "بدانستم و آفرین خواندم"
  },
  {
    "poem_id": 1899,
    "vorder": 36,
    "position": 1,
    "text": "بران دین تو را پاک دین خواندم"
  },
  {
    "poem_id": 1899,
    "vorder": 37,
    "position": 0,
    "text": "دگر هرچ گفتی ز پاکیزه دین"
  },
  {
    "poem_id": 1899,
    "vorder": 38,
    "position": 1,
    "text": "ز یکشنبدی روزهٔ به آفرین"
  },
  {
    "poem_id": 1899,
    "vorder": 39,
    "position": 0,
    "text": "همه خواند بر ما یکایک دبیر"
  },
  {
    "poem_id": 1899,
    "vorder": 40,
    "position": 1,
    "text": "سخنهای بایسته و دلپذیر"
  },
  {
    "poem_id": 1899,
    "vorder": 41,
    "position": 0,
    "text": "بما بر ز دین کهن ننگ نیست"
  },
  {
    "poem_id": 1899,
    "vorder": 42,
    "position": 1,
    "text": "به گیتی به از دین هوشنگ نیست"
  },
  {
    "poem_id": 1899,
    "vorder": 43,
    "position": 0,
    "text": "همه داد و نیکی و شرمست و مهر"
  },
  {
    "poem_id": 1899,
    "vorder": 44,
    "position": 1,
    "text": "نگه کردن اندر شمار سپهر"
  },
  {
    "poem_id": 1899,
    "vorder": 45,
    "position": 0,
    "text": "به هستی یزدان نیوشان ترم"
  },
  {
    "poem_id": 1899,
    "vorder": 46,
    "position": 1,
    "text": "همیشه سوی داد کوشان ترم"
  },
  {
    "poem_id": 1899,
    "vorder": 47,
    "position": 0,
    "text": "ندانیم انباز و پیوند و جفت"
  },
  {
    "poem_id": 1899,
    "vorder": 48,
    "position": 1,
    "text": "نگردد نهان و نگردد نهفت"
  },
  {
    "poem_id": 1899,
    "vorder": 49,
    "position": 0,
    "text": "در اندیشهٔ دل نگنجد خدای"
  },
  {
    "poem_id": 1899,
    "vorder": 50,
    "position": 1,
    "text": "به هستی همو باشدت رهنمای"
  },
  {
    "poem_id": 1899,
    "vorder": 51,
    "position": 0,
    "text": "دگر کت ز دار مسیحا سخن"
  },
  {
    "poem_id": 1899,
    "vorder": 52,
    "position": 1,
    "text": "بیاد آمد از روزگار کهن"
  },
  {
    "poem_id": 1899,
    "vorder": 53,
    "position": 0,
    "text": "مدان دین که باشد به خوبی بپای"
  },
  {
    "poem_id": 1899,
    "vorder": 54,
    "position": 1,
    "text": "بدان دین نباشد خرد رهنمای"
  },
  {
    "poem_id": 1899,
    "vorder": 55,
    "position": 0,
    "text": "کسی را که خوانی همی سوگوار"
  },
  {
    "poem_id": 1899,
    "vorder": 56,
    "position": 1,
    "text": "که کردند پیغمبرش را بدار"
  },
  {
    "poem_id": 1899,
    "vorder": 57,
    "position": 0,
    "text": "که گوید که فرزند یزدان بد اوی"
  },
  {
    "poem_id": 1899,
    "vorder": 58,
    "position": 1,
    "text": "بران دار بر کشته خندان بد اوی"
  },
  {
    "poem_id": 1899,
    "vorder": 59,
    "position": 0,
    "text": "چو پور پدر رفت سوی پدر"
  },
  {
    "poem_id": 1899,
    "vorder": 60,
    "position": 1,
    "text": "تو اندوه این چوب پوده مخور"
  },
  {
    "poem_id": 1899,
    "vorder": 61,
    "position": 0,
    "text": "ز قیصر چو بیهوده آمد سخن"
  },
  {
    "poem_id": 1899,
    "vorder": 62,
    "position": 1,
    "text": "بخندد برین کار مرد کهن"
  },
  {
    "poem_id": 1899,
    "vorder": 63,
    "position": 0,
    "text": "همان دار عیسی نیرزد به رنج"
  },
  {
    "poem_id": 1899,
    "vorder": 64,
    "position": 1,
    "text": "که شاهان نهادند آن را به گنج"
  },
  {
    "poem_id": 1899,
    "vorder": 65,
    "position": 0,
    "text": "از ایران چو چوبی فرستم بروم"
  },
  {
    "poem_id": 1899,
    "vorder": 66,
    "position": 1,
    "text": "بخندد بما بر همه مرز و بوم"
  },
  {
    "poem_id": 1899,
    "vorder": 67,
    "position": 0,
    "text": "به موبد نباید که ترسا شدم"
  },
  {
    "poem_id": 1899,
    "vorder": 68,
    "position": 1,
    "text": "گر از بهر مریم سکوبا شدم"
  },
  {
    "poem_id": 1899,
    "vorder": 69,
    "position": 0,
    "text": "دگر آرزو هرچ باید بخواه"
  },
  {
    "poem_id": 1899,
    "vorder": 70,
    "position": 1,
    "text": "شمار سوی ما گشادست راه"
  },
  {
    "poem_id": 1899,
    "vorder": 71,
    "position": 0,
    "text": "پسندیدم آن هدیه های تو نیز"
  },
  {
    "poem_id": 1899,
    "vorder": 72,
    "position": 1,
    "text": "کجا رنج بردی ز هر گونه چیز"
  },
  {
    "poem_id": 1899,
    "vorder": 73,
    "position": 0,
    "text": "به شیروی بخشیدم این برده رنج"
  },
  {
    "poem_id": 1899,
    "vorder": 74,
    "position": 1,
    "text": "پی افگندم او را یکی تازه گنج"
  },
  {
    "poem_id": 1899,
    "vorder": 75,
    "position": 0,
    "text": "ز روم و ز ایران پر اندیشه‌ام"
  },
  {
    "poem_id": 1899,
    "vorder": 76,
    "position": 1,
    "text": "شب تیره اندیشه شد پیشه‌ام"
  },
  {
    "poem_id": 1899,
    "vorder": 77,
    "position": 0,
    "text": "بترسم که شیروی گردد بلند"
  },
  {
    "poem_id": 1899,
    "vorder": 78,
    "position": 1,
    "text": "رساند به روم و به ایران گزند"
  },
  {
    "poem_id": 1899,
    "vorder": 79,
    "position": 0,
    "text": "نخست اندر آید ز سلم بزرگ"
  },
  {
    "poem_id": 1899,
    "vorder": 80,
    "position": 1,
    "text": "ز اسکندر آن کینه دار سترگ"
  },
  {
    "poem_id": 1899,
    "vorder": 81,
    "position": 0,
    "text": "ز کین نو آیین و کین کهن"
  },
  {
    "poem_id": 1899,
    "vorder": 82,
    "position": 1,
    "text": "مگر در جهان تازه گردد سخن"
  },
  {
    "poem_id": 1899,
    "vorder": 83,
    "position": 0,
    "text": "سخنها که پرسیدم از دخترت"
  },
  {
    "poem_id": 1899,
    "vorder": 84,
    "position": 1,
    "text": "چنان دان که او تازه کرد افسرت"
  },
  {
    "poem_id": 1899,
    "vorder": 85,
    "position": 0,
    "text": "بدین مسیحا بکوشد همی"
  },
  {
    "poem_id": 1899,
    "vorder": 86,
    "position": 1,
    "text": "سخنهای ما کم نیوشد همی"
  },
  {
    "poem_id": 1899,
    "vorder": 87,
    "position": 0,
    "text": "به آرام شادست و پیروزبخت"
  },
  {
    "poem_id": 1899,
    "vorder": 88,
    "position": 1,
    "text": "بدین خسروانی نو آیین درخت"
  },
  {
    "poem_id": 1899,
    "vorder": 89,
    "position": 0,
    "text": "همیشه جهاندار یار تو باد"
  },
  {
    "poem_id": 1899,
    "vorder": 90,
    "position": 1,
    "text": "سر اختر اندر کنار تو باد"
  },
  {
    "poem_id": 1899,
    "vorder": 91,
    "position": 0,
    "text": "نهادند بر نامه بر مهر شاه"
  },
  {
    "poem_id": 1899,
    "vorder": 92,
    "position": 1,
    "text": "همی‌داشت خراد برزین نگاه"
  },
  {
    "poem_id": 1899,
    "vorder": 93,
    "position": 0,
    "text": "گشادند زان پس در گنج باز"
  },
  {
    "poem_id": 1899,
    "vorder": 94,
    "position": 1,
    "text": "کجا گرد کرد او به روز دراز"
  },
  {
    "poem_id": 1899,
    "vorder": 95,
    "position": 0,
    "text": "نخستین صد و شست  بنداوسی"
  },
  {
    "poem_id": 1899,
    "vorder": 96,
    "position": 1,
    "text": "که پنداوسی خواندش پارسی"
  },
  {
    "poem_id": 1899,
    "vorder": 97,
    "position": 0,
    "text": "به گوهر بیاگنده هر یک چو سنگ"
  },
  {
    "poem_id": 1899,
    "vorder": 98,
    "position": 1,
    "text": "نهادند بر هر یکی مهر تنگ"
  },
  {
    "poem_id": 1899,
    "vorder": 99,
    "position": 0,
    "text": "بران هر یکی دانه ها صد هزار"
  },
  {
    "poem_id": 1899,
    "vorder": 100,
    "position": 1,
    "text": "بها بود بر دفتر شهریار"
  },
  {
    "poem_id": 1899,
    "vorder": 101,
    "position": 0,
    "text": "بیاورد سیصد شتر سرخ موی"
  },
  {
    "poem_id": 1899,
    "vorder": 102,
    "position": 1,
    "text": "سیه چشم و آراسته راه جوی"
  },
  {
    "poem_id": 1899,
    "vorder": 103,
    "position": 0,
    "text": "مران هر یکی را درم دو هزار"
  },
  {
    "poem_id": 1899,
    "vorder": 104,
    "position": 1,
    "text": "بها داده بد نامور شهریار"
  },
  {
    "poem_id": 1899,
    "vorder": 105,
    "position": 0,
    "text": "ز دیبای چینی صد و چل هزار"
  },
  {
    "poem_id": 1899,
    "vorder": 106,
    "position": 1,
    "text": "ازان چند زربفت گوهرنگار"
  },
  {
    "poem_id": 1899,
    "vorder": 107,
    "position": 0,
    "text": "دگر پانصد در خوشاب بود"
  },
  {
    "poem_id": 1899,
    "vorder": 108,
    "position": 1,
    "text": "که هر دانه‌ای قطرهٔ آب بود"
  },
  {
    "poem_id": 1899,
    "vorder": 109,
    "position": 0,
    "text": "صد و شست یاقوت چون ناردان"
  },
  {
    "poem_id": 1899,
    "vorder": 110,
    "position": 1,
    "text": "پسندیدهٔ مردم کاردان"
  },
  {
    "poem_id": 1899,
    "vorder": 111,
    "position": 0,
    "text": "ز هندی و چینی و از بربری"
  },
  {
    "poem_id": 1899,
    "vorder": 112,
    "position": 1,
    "text": "ز مصری و از جامهٔ پهلوی"
  },
  {
    "poem_id": 1899,
    "vorder": 113,
    "position": 0,
    "text": "ز چیزی که خیزد ز هر کشوری"
  },
  {
    "poem_id": 1899,
    "vorder": 114,
    "position": 1,
    "text": "که چونان نبد در جهان دیگری"
  },
  {
    "poem_id": 1899,
    "vorder": 115,
    "position": 0,
    "text": "فرستاد سیصد شتروار بار"
  },
  {
    "poem_id": 1899,
    "vorder": 116,
    "position": 1,
    "text": "از ایران بر قیصر نامدار"
  },
  {
    "poem_id": 1899,
    "vorder": 117,
    "position": 0,
    "text": "یکی خلعت افگند بر خانگی"
  },
  {
    "poem_id": 1899,
    "vorder": 118,
    "position": 1,
    "text": "فزون‌تر ز خویشی و بیگانگی"
  },
  {
    "poem_id": 1899,
    "vorder": 119,
    "position": 0,
    "text": "همان جامه و تخت و اسب و ستام"
  },
  {
    "poem_id": 1899,
    "vorder": 120,
    "position": 1,
    "text": "ز پوشیدنیها که بردیم نام"
  },
  {
    "poem_id": 1899,
    "vorder": 121,
    "position": 0,
    "text": "بدینسان چنین صد شتر بارکرد"
  },
  {
    "poem_id": 1899,
    "vorder": 122,
    "position": 1,
    "text": "از آن ده شتربار دینار کرد"
  },
  {
    "poem_id": 1899,
    "vorder": 123,
    "position": 0,
    "text": "ببخشید بر فیلسوفان درم"
  },
  {
    "poem_id": 1899,
    "vorder": 124,
    "position": 1,
    "text": "ز دینار و هرگونه‌ای بیش وکم"
  },
  {
    "poem_id": 1899,
    "vorder": 125,
    "position": 0,
    "text": "برفتند شادان ازان مرز وبوم"
  },
  {
    "poem_id": 1899,
    "vorder": 126,
    "position": 1,
    "text": "به نزدیک قیصر ز ایران بروم"
  },
  {
    "poem_id": 1899,
    "vorder": 127,
    "position": 0,
    "text": "همه مهتران خواندند آفرین"
  },
  {
    "poem_id": 1899,
    "vorder": 128,
    "position": 1,
    "text": "بران پر هنر شهریار زمین"
  },
  {
    "poem_id": 1899,
    "vorder": 129,
    "position": 0,
    "text": "کنون داستان کهن نو کنیم"
  },
