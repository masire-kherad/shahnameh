[
  {
    "poem_id": 87967,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت شاه جوان با تخوار"
  },
  {
    "poem_id": 87967,
    "vorder": 2,
    "position": 1,
    "text": "که آمد بنوی یکی نامدار"
  },
  {
    "poem_id": 87967,
    "vorder": 3,
    "position": 0,
    "text": "نگه کن ببین تا ورا نام چیست"
  },
  {
    "poem_id": 87967,
    "vorder": 4,
    "position": 1,
    "text": "بدین مرد جنگی که خواهد گریست"
  },
  {
    "poem_id": 87967,
    "vorder": 5,
    "position": 0,
    "text": "بخسرو تخوار سراینده گفت"
  },
  {
    "poem_id": 87967,
    "vorder": 6,
    "position": 1,
    "text": "که این را ز ایران کسی نیست جفت"
  },
  {
    "poem_id": 87967,
    "vorder": 7,
    "position": 0,
    "text": "که فرزند گیوست مردی دلیر"
  },
  {
    "poem_id": 87967,
    "vorder": 8,
    "position": 1,
    "text": "بهر رزم پیروز باشد چو شیر"
  },
  {
    "poem_id": 87967,
    "vorder": 9,
    "position": 0,
    "text": "ندارد جز او گیو فرزند نیز"
  },
  {
    "poem_id": 87967,
    "vorder": 10,
    "position": 1,
    "text": "گرامیترستش ز گنج و ز چیز"
  },
  {
    "poem_id": 87967,
    "vorder": 11,
    "position": 0,
    "text": "تو اکنون سوی بارگی دار دست"
  },
  {
    "poem_id": 87967,
    "vorder": 12,
    "position": 1,
    "text": "دل شاه ایران نشاید شکست"
  },
  {
    "poem_id": 87967,
    "vorder": 13,
    "position": 0,
    "text": "و دیگر که دارد همی آن زره"
  },
  {
    "poem_id": 87967,
    "vorder": 14,
    "position": 1,
    "text": "کجا گیو زد بر میان برگره"
  },
  {
    "poem_id": 87967,
    "vorder": 15,
    "position": 0,
    "text": "برو تیر و ژوپین نیابد گذار"
  },
  {
    "poem_id": 87967,
    "vorder": 16,
    "position": 1,
    "text": "سزد گر پیاده کند کارزار"
  },
  {
    "poem_id": 87967,
    "vorder": 17,
    "position": 0,
    "text": "تو با او بسنده نباشی بجنگ"
  },
  {
    "poem_id": 87967,
    "vorder": 18,
    "position": 1,
    "text": "نگه کن که الماس دارد بچنگ"
  },
  {
    "poem_id": 87967,
    "vorder": 19,
    "position": 0,
    "text": "بزد تیر بر اسپ بیژن فرود"
  },
  {
    "poem_id": 87967,
    "vorder": 20,
    "position": 1,
    "text": "تو گفتی باسپ اندرون جان نبود"
  },
  {
    "poem_id": 87967,
    "vorder": 21,
    "position": 0,
    "text": "بیفتاد و بیژن جدا گشت ازوی"
  },
  {
    "poem_id": 87967,
    "vorder": 22,
    "position": 1,
    "text": "سوی تیغ با تیغ بنهاد روی"
  },
  {
    "poem_id": 87967,
    "vorder": 23,
    "position": 0,
    "text": "یکی نعره زد کای سوار دلیر"
  },
  {
    "poem_id": 87967,
    "vorder": 24,
    "position": 1,
    "text": "بمان تا ببینی کنون رزم شیر"
  },
  {
    "poem_id": 87967,
    "vorder": 25,
    "position": 0,
    "text": "ندانی که بی‌اسپ مردان جنگ"
  },
  {
    "poem_id": 87967,
    "vorder": 26,
    "position": 1,
    "text": "بیایند با تیغ هندی بچنگ"
  },
  {
    "poem_id": 87967,
    "vorder": 27,
    "position": 0,
    "text": "ببینی مرا گر بمانی بجای"
  },
  {
    "poem_id": 87967,
    "vorder": 28,
    "position": 1,
    "text": "به پیکار ازین پس نیایدت رای"
  },
  {
    "poem_id": 87967,
    "vorder": 29,
    "position": 0,
    "text": "چو بیژن همی برنگشت از فرود"
  },
  {
    "poem_id": 87967,
    "vorder": 30,
    "position": 1,
    "text": "فرود اندر آن کار تندی نمود"
  },
  {
    "poem_id": 87967,
    "vorder": 31,
    "position": 0,
    "text": "یکی تیر دیگر بیانداخت شیر"
  },
  {
    "poem_id": 87967,
    "vorder": 32,
    "position": 1,
    "text": "سپر بر سر آورد مرد دلیر"
  },
  {
    "poem_id": 87967,
    "vorder": 33,
    "position": 0,
    "text": "سپر بر درید و زره را نیافت"
  },
  {
    "poem_id": 87967,
    "vorder": 34,
    "position": 1,
    "text": "ازو روی بیژن بپستی نتافت"
  },
  {
    "poem_id": 87967,
    "vorder": 35,
    "position": 0,
    "text": "ازان تند بالا چو بر سر کشید"
  },
  {
    "poem_id": 87967,
    "vorder": 36,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 87967,
    "vorder": 37,
    "position": 0,
    "text": "فرود گرانمایه زو بازگشت"
  },
  {
    "poem_id": 87967,
    "vorder": 38,
    "position": 1,
    "text": "همه بارهٔ دژ پرآواز گشت"
  },
  {
    "poem_id": 87967,
    "vorder": 39,
    "position": 0,
    "text": "دوان بیژن آمد پس پشت اوی"
  },
  {
    "poem_id": 87967,
    "vorder": 40,
    "position": 1,
    "text": "یکی تیغ بد تیز در مشت اوی"
  },
  {
    "poem_id": 87967,
    "vorder": 41,
    "position": 0,
    "text": "به برگستوان بر زد و کرد چاک"
  },
  {
    "poem_id": 87967,
    "vorder": 42,
    "position": 1,
    "text": "گرانمایه اسپ اندر آمد بخاک"
  },
  {
    "poem_id": 87967,
    "vorder": 43,
    "position": 0,
    "text": "به دربند حصن اندر آمد فرود"
  },
  {
    "poem_id": 87967,
    "vorder": 44,
    "position": 1,
    "text": "دلیران در دژ ببستند زود"
  },
  {
    "poem_id": 87967,
    "vorder": 45,
    "position": 0,
    "text": "ز باره فراوان ببارید سنگ"
  },
  {
    "poem_id": 87967,
    "vorder": 46,
    "position": 1,
    "text": "بدانست کان نیست جای درنگ"
  },
  {
    "poem_id": 87967,
    "vorder": 47,
    "position": 0,
    "text": "خروشید بیژن که ای نامدار"
  },
  {
    "poem_id": 87967,
    "vorder": 48,
    "position": 1,
    "text": "ز مردی پیاده دلیر و سوار"
  },
  {
    "poem_id": 87967,
    "vorder": 49,
    "position": 0,
    "text": "چنین بازگشتی و شرمت نبود"
  },
  {
    "poem_id": 87967,
    "vorder": 50,
    "position": 1,
    "text": "دریغ آن دل و نام جنگی فرود"
  },
  {
    "poem_id": 87967,
    "vorder": 51,
    "position": 0,
    "text": "بیامد بر طوس زان رزمگاه"
  },
  {
    "poem_id": 87967,
    "vorder": 52,
    "position": 1,
    "text": "چنین گفت کای پهلوان سپاه"
  },
  {
    "poem_id": 87967,
    "vorder": 53,
    "position": 0,
    "text": "سزد گر برزم چنین یک دلیر"
  },
  {
    "poem_id": 87967,
    "vorder": 54,
    "position": 1,
    "text": "شود نامبردار یک دشت شیر"
  },
  {
    "poem_id": 87967,
    "vorder": 55,
    "position": 0,
    "text": "اگر کوه خارا ز پیکان اوی"
  },
  {
    "poem_id": 87967,
    "vorder": 56,
    "position": 1,
    "text": "شود آب و دریا بود کان اوی"
  },
  {
    "poem_id": 87967,
    "vorder": 57,
    "position": 0,
    "text": "سپهبد نباید که دارد شگفت"
  },
  {
    "poem_id": 87967,
    "vorder": 58,
    "position": 1,
    "text": "ازین برتر اندازه نتوان گرفت"
  },
  {
    "poem_id": 87967,
    "vorder": 59,
    "position": 0,
    "text": "سپهبد بدارنده سوگند خورد"
  },
  {
    "poem_id": 87967,
    "vorder": 60,
    "position": 1,
    "text": "کزین دژ برآرم بخورشید گرد"
  },
  {
    "poem_id": 87967,
    "vorder": 61,
    "position": 0,
    "text": "بکین زرسپ گرامی سپاه"
  },
  {
    "poem_id": 87967,
    "vorder": 62,
    "position": 1,
    "text": "برآرم بسازم یکی رزمگاه"
  },
  {
    "poem_id": 87967,
    "vorder": 63,
    "position": 0,
    "text": "تن ترک بدخواه بیجان کنم"
  },
  {
    "poem_id": 87967,
    "vorder": 64,
    "position": 1,
    "text": "ز خونش دل سنگ مرجان کنم"
  }
]