[
  {
    "poem_id": 1517,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید قیصر بر آن برنهاد"
  },
  {
    "poem_id": 1517,
    "vorder": 2,
    "position": 1,
    "text": "که دخت گرامی به گشتاسپ داد"
  },
  {
    "poem_id": 1517,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت با او برو همچنین"
  },
  {
    "poem_id": 1517,
    "vorder": 4,
    "position": 1,
    "text": "نیابی ز من گنج و تاج و نگین"
  },
  {
    "poem_id": 1517,
    "vorder": 5,
    "position": 0,
    "text": "چو گشتاسپ آن دید خیره بماند"
  },
  {
    "poem_id": 1517,
    "vorder": 6,
    "position": 1,
    "text": "جهان‌آفرین را فراوان بخواند"
  },
  {
    "poem_id": 1517,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت با دختر سرفراز"
  },
  {
    "poem_id": 1517,
    "vorder": 8,
    "position": 1,
    "text": "که ای پروریده بنام و بناز"
  },
  {
    "poem_id": 1517,
    "vorder": 9,
    "position": 0,
    "text": "ز چندین سر و افسر نامدار"
  },
  {
    "poem_id": 1517,
    "vorder": 10,
    "position": 1,
    "text": "چرا کرد رایت مرا خواستار"
  },
  {
    "poem_id": 1517,
    "vorder": 11,
    "position": 0,
    "text": "غریبی همی برگزینی که گنج"
  },
  {
    "poem_id": 1517,
    "vorder": 12,
    "position": 1,
    "text": "نیابی و با او بمانی به رنج"
  },
  {
    "poem_id": 1517,
    "vorder": 13,
    "position": 0,
    "text": "ازین سرفرازان همالی بجوی"
  },
  {
    "poem_id": 1517,
    "vorder": 14,
    "position": 1,
    "text": "که باشد به نزد پدرت آبروی"
  },
  {
    "poem_id": 1517,
    "vorder": 15,
    "position": 0,
    "text": "کتایون بدو گفت کای بدگمان"
  },
  {
    "poem_id": 1517,
    "vorder": 16,
    "position": 1,
    "text": "مشو تیز با گردش آسمان"
  },
  {
    "poem_id": 1517,
    "vorder": 17,
    "position": 0,
    "text": "چو من با تو خرسند باشم به بخت"
  },
  {
    "poem_id": 1517,
    "vorder": 18,
    "position": 1,
    "text": "تو افسر چرا جویی و تاج و تخت"
  },
  {
    "poem_id": 1517,
    "vorder": 19,
    "position": 0,
    "text": "برفتند ز ایوان قیصر به درد"
  },
  {
    "poem_id": 1517,
    "vorder": 20,
    "position": 1,
    "text": "کتایون و گشتاسپ با باد سرد"
  },
  {
    "poem_id": 1517,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت با شوی و زن کدخدای"
  },
  {
    "poem_id": 1517,
    "vorder": 22,
    "position": 1,
    "text": "که خرسند باشید و فرخنده‌رای"
  },
  {
    "poem_id": 1517,
    "vorder": 23,
    "position": 0,
    "text": "سرایی به پردخت مهتر بده"
  },
  {
    "poem_id": 1517,
    "vorder": 24,
    "position": 1,
    "text": "خورشها و گستردنی هرچ به"
  },
  {
    "poem_id": 1517,
    "vorder": 25,
    "position": 0,
    "text": "چو آن دید گشتاسپ کرد آفرین"
  },
  {
    "poem_id": 1517,
    "vorder": 26,
    "position": 1,
    "text": "بران نامور مهتر پاک‌دین"
  },
  {
    "poem_id": 1517,
    "vorder": 27,
    "position": 0,
    "text": "کتایون بی‌اندازه پیرایه داشت"
  },
  {
    "poem_id": 1517,
    "vorder": 28,
    "position": 1,
    "text": "ز یاقوت و هر گوهری مایه داشت"
  },
  {
    "poem_id": 1517,
    "vorder": 29,
    "position": 0,
    "text": "یکی گوهری از میان برگزید"
  },
  {
    "poem_id": 1517,
    "vorder": 30,
    "position": 1,
    "text": "که چشم خردمند زان سان ندید"
  },
  {
    "poem_id": 1517,
    "vorder": 31,
    "position": 0,
    "text": "ببردند نزدیک گوهرشناس"
  },
  {
    "poem_id": 1517,
    "vorder": 32,
    "position": 1,
    "text": "پذیرفت ز اندازه بیرون سپاس"
  },
  {
    "poem_id": 1517,
    "vorder": 33,
    "position": 0,
    "text": "بها داد یاقوت را شش‌هزار"
  },
  {
    "poem_id": 1517,
    "vorder": 34,
    "position": 1,
    "text": "ز دینار و گنج از در شهریار"
  },
  {
    "poem_id": 1517,
    "vorder": 35,
    "position": 0,
    "text": "خریدند چیزی که بایسته بود"
  },
  {
    "poem_id": 1517,
    "vorder": 36,
    "position": 1,
    "text": "بدان روز بد نیز شایسته بود"
  },
  {
    "poem_id": 1517,
    "vorder": 37,
    "position": 0,
    "text": "ازان سان که آمد همی زیستند"
  },
  {
    "poem_id": 1517,
    "vorder": 38,
    "position": 1,
    "text": "گهی شادمان گاه بگریستند"
  },
  {
    "poem_id": 1517,
    "vorder": 39,
    "position": 0,
    "text": "همه کار گشتاسپ نخچیر بود"
  },
  {
    "poem_id": 1517,
    "vorder": 40,
    "position": 1,
    "text": "همه ساله با ترکش و تیر بود"
  },
  {
    "poem_id": 1517,
    "vorder": 41,
    "position": 0,
    "text": "چنان بد که روزی ز نخچیرگاه"
  },
  {
    "poem_id": 1517,
    "vorder": 42,
    "position": 1,
    "text": "مر او را به هیشوی بر بود راه"
  },
  {
    "poem_id": 1517,
    "vorder": 43,
    "position": 0,
    "text": "ز هرگونه‌ای چند نخچیر داشت"
  },
  {
    "poem_id": 1517,
    "vorder": 44,
    "position": 1,
    "text": "همی رفت و ترکش پر از تیر داشت"
  },
  {
    "poem_id": 1517,
    "vorder": 45,
    "position": 0,
    "text": "همه هرچ بود از بزرگان و خرد"
  },
  {
    "poem_id": 1517,
    "vorder": 46,
    "position": 1,
    "text": "هم از راه نزدیک هیشوی برد"
  },
  {
    "poem_id": 1517,
    "vorder": 47,
    "position": 0,
    "text": "چو هیشو بدیدش بیامد دوان"
  },
  {
    "poem_id": 1517,
    "vorder": 48,
    "position": 1,
    "text": "پذیره شدش شاد و روشن‌روان"
  },
  {
    "poem_id": 1517,
    "vorder": 49,
    "position": 0,
    "text": "به زیرش بگسترد گستردنی"
  },
  {
    "poem_id": 1517,
    "vorder": 50,
    "position": 1,
    "text": "بیاورد چیزی که بد خوردنی"
  },
  {
    "poem_id": 1517,
    "vorder": 51,
    "position": 0,
    "text": "برآسود گشتاسپ و چیزی بخورد"
  },
  {
    "poem_id": 1517,
    "vorder": 52,
    "position": 1,
    "text": "بیامد به نزد کتایون چو گرد"
  },
  {
    "poem_id": 1517,
    "vorder": 53,
    "position": 0,
    "text": "چو گشتاسپ هیشوی را دوست کرد"
  },
  {
    "poem_id": 1517,
    "vorder": 54,
    "position": 1,
    "text": "به دانش ورا چون تن و پوست کرد"
  },
  {
    "poem_id": 1517,
    "vorder": 55,
    "position": 0,
    "text": "چو رفتی به نخچیر آهو ز شهر"
  },
  {
    "poem_id": 1517,
    "vorder": 56,
    "position": 1,
    "text": "به ره بر به هیشوی دادی دو بهر"
  },
  {
    "poem_id": 1517,
    "vorder": 57,
    "position": 0,
    "text": "دگر بهرهٔ مهتر ده بدی"
  },
  {
    "poem_id": 1517,
    "vorder": 58,
    "position": 1,
    "text": "هرانکس کزان روستا مه بدی"
  },
  {
    "poem_id": 1517,
    "vorder": 59,
    "position": 0,
    "text": "چنان شد که گشتاسپ با کدخدای"
  },
  {
    "poem_id": 1517,
    "vorder": 60,
    "position": 1,
    "text": "یکی شد به خورد و به آرام و رای"
  }
]