[
  {
    "poem_id": 1510,
    "vorder": 1,
    "position": 0,
    "text": "چو لهراسپ بنشست بر تخت داد"
  },
  {
    "poem_id": 1510,
    "vorder": 2,
    "position": 1,
    "text": "به شاهنشهی تاج بر سر نهاد"
  },
  {
    "poem_id": 1510,
    "vorder": 3,
    "position": 0,
    "text": "جهان آفرین را ستایش گرفت"
  },
  {
    "poem_id": 1510,
    "vorder": 4,
    "position": 1,
    "text": "نیایش ورا در فزایش گرفت"
  },
  {
    "poem_id": 1510,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کز داور داد و پاک"
  },
  {
    "poem_id": 1510,
    "vorder": 6,
    "position": 1,
    "text": "پر امید باشید و با ترس و باک"
  },
  {
    "poem_id": 1510,
    "vorder": 7,
    "position": 0,
    "text": "نگارندهٔ چرخ گردنده اوست"
  },
  {
    "poem_id": 1510,
    "vorder": 8,
    "position": 1,
    "text": "فرایندهٔ فره بنده اوست"
  },
  {
    "poem_id": 1510,
    "vorder": 9,
    "position": 0,
    "text": "چو دریا و کوه و زمین آفرید"
  },
  {
    "poem_id": 1510,
    "vorder": 10,
    "position": 1,
    "text": "بلند آسمان از برش برکشید"
  },
  {
    "poem_id": 1510,
    "vorder": 11,
    "position": 0,
    "text": "یکی تیز گردان و دیگر بجای"
  },
  {
    "poem_id": 1510,
    "vorder": 12,
    "position": 1,
    "text": "به جنبش ندادش نگارنده پای"
  },
  {
    "poem_id": 1510,
    "vorder": 13,
    "position": 0,
    "text": "چو موی از بر گوی و ما در میان"
  },
  {
    "poem_id": 1510,
    "vorder": 14,
    "position": 1,
    "text": "به رنج تن و آز و سود و زیان"
  },
  {
    "poem_id": 1510,
    "vorder": 15,
    "position": 0,
    "text": "تو شادان دل و مرگ چنگال تیز"
  },
  {
    "poem_id": 1510,
    "vorder": 16,
    "position": 1,
    "text": "نشسته چو شیر ژیان پرستیز"
  },
  {
    "poem_id": 1510,
    "vorder": 17,
    "position": 0,
    "text": "ز آز و فزونی به یکسو شویم"
  },
  {
    "poem_id": 1510,
    "vorder": 18,
    "position": 1,
    "text": "به نادانی خویش خستو شویم"
  },
  {
    "poem_id": 1510,
    "vorder": 19,
    "position": 0,
    "text": "ازین تاج شاهی و تخت بلند"
  },
  {
    "poem_id": 1510,
    "vorder": 20,
    "position": 1,
    "text": "نجوییم جز داد و آرام و پند"
  },
  {
    "poem_id": 1510,
    "vorder": 21,
    "position": 0,
    "text": "مگر بهره‌مان زین سرای سپنج"
  },
  {
    "poem_id": 1510,
    "vorder": 22,
    "position": 1,
    "text": "نیاید همی کین و نفرین و رنج"
  },
  {
    "poem_id": 1510,
    "vorder": 23,
    "position": 0,
    "text": "من از پند کیخسرو افزون کنم"
  },
  {
    "poem_id": 1510,
    "vorder": 24,
    "position": 1,
    "text": "ز دل کینه و آز بیرون کنم"
  },
  {
    "poem_id": 1510,
    "vorder": 25,
    "position": 0,
    "text": "بسازید و از داد باشید شاد"
  },
  {
    "poem_id": 1510,
    "vorder": 26,
    "position": 1,
    "text": "تن آسان و از کین مگیرید یاد"
  },
  {
    "poem_id": 1510,
    "vorder": 27,
    "position": 0,
    "text": "مهان جهان آفرین خواندند"
  },
  {
    "poem_id": 1510,
    "vorder": 28,
    "position": 1,
    "text": "ورا شهریار زمین خواندند"
  },
  {
    "poem_id": 1510,
    "vorder": 29,
    "position": 0,
    "text": "گرانمایه لهراسپ آرام یافت"
  },
  {
    "poem_id": 1510,
    "vorder": 30,
    "position": 1,
    "text": "خرد مایه و کام پدرام یافت"
  },
  {
    "poem_id": 1510,
    "vorder": 31,
    "position": 0,
    "text": "از آن پس فرستاد کسها به روم"
  },
  {
    "poem_id": 1510,
    "vorder": 32,
    "position": 1,
    "text": "به هند و به چین و به آباد بوم"
  },
  {
    "poem_id": 1510,
    "vorder": 33,
    "position": 0,
    "text": "ز هر مرز هرکس که دانا بدند"
  },
  {
    "poem_id": 1510,
    "vorder": 34,
    "position": 1,
    "text": "به پیمانش اندر توانا بدند"
  },
  {
    "poem_id": 1510,
    "vorder": 35,
    "position": 0,
    "text": "ز هر کشوری بر گرفتند راه"
  },
  {
    "poem_id": 1510,
    "vorder": 36,
    "position": 1,
    "text": "برفتند پویان به نزدیک شاه"
  },
  {
    "poem_id": 1510,
    "vorder": 37,
    "position": 0,
    "text": "ز دانش چشیدند هر شور و تلخ"
  },
  {
    "poem_id": 1510,
    "vorder": 38,
    "position": 1,
    "text": "ببودند با کام چندی به بلخ"
  },
  {
    "poem_id": 1510,
    "vorder": 39,
    "position": 0,
    "text": "یکی شارسانی برآورد شاه"
  },
  {
    "poem_id": 1510,
    "vorder": 40,
    "position": 1,
    "text": "پر از برزن و کوی و بازارگاه"
  },
  {
    "poem_id": 1510,
    "vorder": 41,
    "position": 0,
    "text": "به هر برزنی جشنگاهی سده"
  },
  {
    "poem_id": 1510,
    "vorder": 42,
    "position": 1,
    "text": "همه‌گرد بر گردش آتشکده"
  },
  {
    "poem_id": 1510,
    "vorder": 43,
    "position": 0,
    "text": "یکی آذری ساخت برزین به نام"
  },
  {
    "poem_id": 1510,
    "vorder": 44,
    "position": 1,
    "text": "که با فرخی بود و با برز و کام"
  }
]