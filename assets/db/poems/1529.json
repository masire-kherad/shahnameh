[
  {
    "poem_id": 1529,
    "vorder": 1,
    "position": 0,
    "text": "چو یک چند سالان برآمد برین"
  },
  {
    "poem_id": 1529,
    "vorder": 2,
    "position": 1,
    "text": "درختی پدید آمد اندر زمین"
  },
  {
    "poem_id": 1529,
    "vorder": 3,
    "position": 0,
    "text": "در ایوان گشتاسپ بر سوی کاخ"
  },
  {
    "poem_id": 1529,
    "vorder": 4,
    "position": 1,
    "text": "درختی گشن بود بسیار شاخ"
  },
  {
    "poem_id": 1529,
    "vorder": 5,
    "position": 0,
    "text": "همه برگ وی پند و بارش خرد"
  },
  {
    "poem_id": 1529,
    "vorder": 6,
    "position": 1,
    "text": "کسی کو خرد پرورد کی مرد"
  },
  {
    "poem_id": 1529,
    "vorder": 7,
    "position": 0,
    "text": "خجسته پی و نام او زردهشت"
  },
  {
    "poem_id": 1529,
    "vorder": 8,
    "position": 1,
    "text": "که آهرمن بدکنش را بکشت"
  },
  {
    "poem_id": 1529,
    "vorder": 9,
    "position": 0,
    "text": "به شاه کیان گفت پیغمبرم"
  },
  {
    "poem_id": 1529,
    "vorder": 10,
    "position": 1,
    "text": "سوی تو خرد رهنمون آورم"
  },
  {
    "poem_id": 1529,
    "vorder": 11,
    "position": 0,
    "text": "جهان آفرین گفت بپذیر دین"
  },
  {
    "poem_id": 1529,
    "vorder": 12,
    "position": 1,
    "text": "نگه کن برین آسمان و زمین"
  },
  {
    "poem_id": 1529,
    "vorder": 13,
    "position": 0,
    "text": "که بی‌خاک و آبش برآورده‌ام"
  },
  {
    "poem_id": 1529,
    "vorder": 14,
    "position": 1,
    "text": "نگه کن بدو تاش چون کرده‌ام"
  },
  {
    "poem_id": 1529,
    "vorder": 15,
    "position": 0,
    "text": "نگر تا تواند چنین کرد کس"
  },
  {
    "poem_id": 1529,
    "vorder": 16,
    "position": 1,
    "text": "مگر من که هستم جهاندار و بس"
  },
  {
    "poem_id": 1529,
    "vorder": 17,
    "position": 0,
    "text": "گر ایدونک دانی که من کردم این"
  },
  {
    "poem_id": 1529,
    "vorder": 18,
    "position": 1,
    "text": "مرا خواند باید جهان‌آفرین"
  },
  {
    "poem_id": 1529,
    "vorder": 19,
    "position": 0,
    "text": "ز گوینده بپذیر به دین اوی"
  },
  {
    "poem_id": 1529,
    "vorder": 20,
    "position": 1,
    "text": "بیاموز ازو راه و آیین اوی"
  },
  {
    "poem_id": 1529,
    "vorder": 21,
    "position": 0,
    "text": "نگر تا چه گوید بران کار کن"
  },
  {
    "poem_id": 1529,
    "vorder": 22,
    "position": 1,
    "text": "خرد برگزین این جهان خوار کن"
  },
  {
    "poem_id": 1529,
    "vorder": 23,
    "position": 0,
    "text": "بیاموز آیین و دین بهی"
  },
  {
    "poem_id": 1529,
    "vorder": 24,
    "position": 1,
    "text": "که بی‌دین ناخوب باشد مهی"
  },
  {
    "poem_id": 1529,
    "vorder": 25,
    "position": 0,
    "text": "چو بشنید ازو شاه به دین به"
  },
  {
    "poem_id": 1529,
    "vorder": 26,
    "position": 1,
    "text": "پذیرفت ازو راه و آیین به"
  },
  {
    "poem_id": 1529,
    "vorder": 27,
    "position": 0,
    "text": "نبرده برادرش فرخ زریر"
  },
  {
    "poem_id": 1529,
    "vorder": 28,
    "position": 1,
    "text": "کجا ژنده پیل آوریدی به زیر"
  },
  {
    "poem_id": 1529,
    "vorder": 29,
    "position": 0,
    "text": "ز شاهان شه پیر گشته به بلخ"
  },
  {
    "poem_id": 1529,
    "vorder": 30,
    "position": 1,
    "text": "جهان بر دل ریش او گشته تلخ"
  },
  {
    "poem_id": 1529,
    "vorder": 31,
    "position": 0,
    "text": "شده زار و بیمار و بی‌هوش و توش"
  },
  {
    "poem_id": 1529,
    "vorder": 32,
    "position": 1,
    "text": "به نزدیک او زهر مانند نوش"
  },
  {
    "poem_id": 1529,
    "vorder": 33,
    "position": 0,
    "text": "سران و بزرگان و هر مهتران"
  },
  {
    "poem_id": 1529,
    "vorder": 34,
    "position": 1,
    "text": "پزشکان دانا و ناموران"
  },
  {
    "poem_id": 1529,
    "vorder": 35,
    "position": 0,
    "text": "بر آن جادوی چارها ساختند"
  },
  {
    "poem_id": 1529,
    "vorder": 36,
    "position": 1,
    "text": "نه سود آمد از هرچ انداختند"
  },
  {
    "poem_id": 1529,
    "vorder": 37,
    "position": 0,
    "text": "پس این زردهشت پیمبرش گفت"
  },
  {
    "poem_id": 1529,
    "vorder": 38,
    "position": 1,
    "text": "کزو دین ایزد نشاید نهفت"
  },
  {
    "poem_id": 1529,
    "vorder": 39,
    "position": 0,
    "text": "که چون دین پذیرد ز روز نخست"
  },
  {
    "poem_id": 1529,
    "vorder": 40,
    "position": 1,
    "text": "شود رسته از درد و گردد درست"
  },
  {
    "poem_id": 1529,
    "vorder": 41,
    "position": 0,
    "text": "شهنشاه و زین پس زریر سوار"
  },
  {
    "poem_id": 1529,
    "vorder": 42,
    "position": 1,
    "text": "همه دین پذیرنده از شهریار"
  },
  {
    "poem_id": 1529,
    "vorder": 43,
    "position": 0,
    "text": "همه سوی شاه زمین آمدند"
  },
  {
    "poem_id": 1529,
    "vorder": 44,
    "position": 1,
    "text": "ببستند کشتی به دین آمدند"
  },
  {
    "poem_id": 1529,
    "vorder": 45,
    "position": 0,
    "text": "پدید آمد آن فره ایزدی"
  },
  {
    "poem_id": 1529,
    "vorder": 46,
    "position": 1,
    "text": "برفت از دل بد سگالان بدی"
  },
  {
    "poem_id": 1529,
    "vorder": 47,
    "position": 0,
    "text": "پر از نور مینو ببد دخمه‌ها"
  },
  {
    "poem_id": 1529,
    "vorder": 48,
    "position": 1,
    "text": "وز آلودگی پاک شد تخمه‌ها"
  },
  {
    "poem_id": 1529,
    "vorder": 49,
    "position": 0,
    "text": "پس آزاده گشتاسپ برشد به گاه"
  },
  {
    "poem_id": 1529,
    "vorder": 50,
    "position": 1,
    "text": "فرستاد هرسو به کشور سپاه"
  },
  {
    "poem_id": 1529,
    "vorder": 51,
    "position": 0,
    "text": "پراگنده اندر جهان موبدان"
  },
  {
    "poem_id": 1529,
    "vorder": 52,
    "position": 1,
    "text": "نهاد از بر آذران گنبدان"
  },
  {
    "poem_id": 1529,
    "vorder": 53,
    "position": 0,
    "text": "نخست آذر مهربرزین نهاد"
  },
  {
    "poem_id": 1529,
    "vorder": 54,
    "position": 1,
    "text": "به کشمر نگر تا چه آیین نهاد"
  },
  {
    "poem_id": 1529,
    "vorder": 55,
    "position": 0,
    "text": "یکی سرو آزاده بود از بهشت"
  },
  {
    "poem_id": 1529,
    "vorder": 56,
    "position": 1,
    "text": "به پیش در آذر آن را بکشت"
  },
  {
    "poem_id": 1529,
    "vorder": 57,
    "position": 0,
    "text": "نبشتی بر زاد سرو سهی"
  },
  {
    "poem_id": 1529,
    "vorder": 58,
    "position": 1,
    "text": "که پذرفت گشتاسپ دین بهی"
  },
  {
    "poem_id": 1529,
    "vorder": 59,
    "position": 0,
    "text": "گوا کرد مر سرو آزاد را"
  },
  {
    "poem_id": 1529,
    "vorder": 60,
    "position": 1,
    "text": "چنین گستراند خرد داد را"
  },
  {
    "poem_id": 1529,
    "vorder": 61,
    "position": 0,
    "text": "چو چندی برآمد برین سالیان"
  },
  {
    "poem_id": 1529,
    "vorder": 62,
    "position": 1,
    "text": "مران سرو استبر گشتش میان"
  },
  {
    "poem_id": 1529,
    "vorder": 63,
    "position": 0,
    "text": "چنان گشت آزاد سرو بلند"
  },
  {
    "poem_id": 1529,
    "vorder": 64,
    "position": 1,
    "text": "که برگرد او برنگشتی کمند"
  },
  {
    "poem_id": 1529,
    "vorder": 65,
    "position": 0,
    "text": "چو بسیار برگشت و بسیار شاخ"
  },
  {
    "poem_id": 1529,
    "vorder": 66,
    "position": 1,
    "text": "بکرد از بر او یکی خوب کاخ"
  },
  {
    "poem_id": 1529,
    "vorder": 67,
    "position": 0,
    "text": "چهل رش به بالا و پهنا چهل"
  },
  {
    "poem_id": 1529,
    "vorder": 68,
    "position": 1,
    "text": "نکرد از بنه اندرو آب و گل"
  },
  {
    "poem_id": 1529,
    "vorder": 69,
    "position": 0,
    "text": "دو ایوان برآورد از زر پاک"
  },
  {
    "poem_id": 1529,
    "vorder": 70,
    "position": 1,
    "text": "زمینش ز سیم و ز عنبرش خاک"
  },
  {
    "poem_id": 1529,
    "vorder": 71,
    "position": 0,
    "text": "برو بر نگارید جمشید را"
  },
  {
    "poem_id": 1529,
    "vorder": 72,
    "position": 1,
    "text": "پرستنده مر ماه و خورشید را"
  },
  {
    "poem_id": 1529,
    "vorder": 73,
    "position": 0,
    "text": "فریدونش را نیز با گاوسار"
  },
  {
    "poem_id": 1529,
    "vorder": 74,
    "position": 1,
    "text": "بفرمود کردن برانجا نگار"
  },
  {
    "poem_id": 1529,
    "vorder": 75,
    "position": 0,
    "text": "همه مهتران را بر آن‌جا نگاشت"
  },
  {
    "poem_id": 1529,
    "vorder": 76,
    "position": 1,
    "text": "نگر تا چنان کامگاری که داشت"
  },
  {
    "poem_id": 1529,
    "vorder": 77,
    "position": 0,
    "text": "چو نیکو شد آن نامور کاخ زر"
  },
  {
    "poem_id": 1529,
    "vorder": 78,
    "position": 1,
    "text": "به دیوارها بر نشانده گهر"
  },
  {
    "poem_id": 1529,
    "vorder": 79,
    "position": 0,
    "text": "به گردش یکی باره کرد آهنین"
  },
  {
    "poem_id": 1529,
    "vorder": 80,
    "position": 1,
    "text": "نشست اندرو کرد شاه زمین"
  },
  {
    "poem_id": 1529,
    "vorder": 81,
    "position": 0,
    "text": "فرستاد هرسو به کشور پیام"
  },
  {
    "poem_id": 1529,
    "vorder": 82,
    "position": 1,
    "text": "که چون سرو کشمر به گیتی کدام"
  },
  {
    "poem_id": 1529,
    "vorder": 83,
    "position": 0,
    "text": "ز مینو فرستاد زی من خدای"
  },
  {
    "poem_id": 1529,
    "vorder": 84,
    "position": 1,
    "text": "مرا گفت زینجا به مینو گرای"
  },
  {
    "poem_id": 1529,
    "vorder": 85,
    "position": 0,
    "text": "کنون هرک این پند من بشنوید"
  },
  {
    "poem_id": 1529,
    "vorder": 86,
    "position": 1,
    "text": "پیاده سوی سرو کشمر روید"
  },
  {
    "poem_id": 1529,
    "vorder": 87,
    "position": 0,
    "text": "بگیرید پند ار دهد زردهشت"
  },
  {
    "poem_id": 1529,
    "vorder": 88,
    "position": 1,
    "text": "به سوی بت چین بدارید پشت"
  },
  {
    "poem_id": 1529,
    "vorder": 89,
    "position": 0,
    "text": "به برز و فر شاه ایرانیان"
  },
  {
    "poem_id": 1529,
    "vorder": 90,
    "position": 1,
    "text": "ببندید کشتی همه بر میان"
  },
  {
    "poem_id": 1529,
    "vorder": 91,
    "position": 0,
    "text": "در آیین پیشینیان منگرید"
  },
  {
    "poem_id": 1529,
    "vorder": 92,
    "position": 1,
    "text": "برین سایهٔ سروبن بگذرید"
  },
  {
    "poem_id": 1529,
    "vorder": 93,
    "position": 0,
    "text": "سوی گنبد آذر آرید روی"
  },
  {
    "poem_id": 1529,
    "vorder": 94,
    "position": 1,
    "text": "به فرمان پیغمبر راست‌گوی"
  },
  {
    "poem_id": 1529,
    "vorder": 95,
    "position": 0,
    "text": "پراگنده فرمانش اندر جهان"
  },
  {
    "poem_id": 1529,
    "vorder": 96,
    "position": 1,
    "text": "سوی نامداران و سوی مهان"
  },
  {
    "poem_id": 1529,
    "vorder": 97,
    "position": 0,
    "text": "همه نامداران به فرمان اوی"
  },
  {
    "poem_id": 1529,
    "vorder": 98,
    "position": 1,
    "text": "سوی سرو کشمر نهادند روی"
  },
  {
    "poem_id": 1529,
    "vorder": 99,
    "position": 0,
    "text": "پرستشکده گشت زان سان که پشت"
  },
  {
    "poem_id": 1529,
    "vorder": 100,
    "position": 1,
    "text": "ببست اندرو دیو را زردهشت"
  },
  {
    "poem_id": 1529,
    "vorder": 101,
    "position": 0,
    "text": "بهشتیش خوان ار ندانی همی"
  },
  {
    "poem_id": 1529,
    "vorder": 102,
    "position": 1,
    "text": "چرا سرو کشمرش خوانی همی"
  },
  {
    "poem_id": 1529,
    "vorder": 103,
    "position": 0,
    "text": "چراکش نخوانی نهال بهشت"
  },
  {
    "poem_id": 1529,
    "vorder": 104,
    "position": 1,
    "text": "که شاه کیانش به کشمر بکشت"
  }
]