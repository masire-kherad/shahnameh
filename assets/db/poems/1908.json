[
  {
    "poem_id": 1908,
    "vorder": 1,
    "position": 0,
    "text": "بدان نامور تخت و جای مهی"
  },
  {
    "poem_id": 1908,
    "vorder": 2,
    "position": 1,
    "text": "بزرگی و دیهیم شاهنشهی"
  },
  {
    "poem_id": 1908,
    "vorder": 3,
    "position": 0,
    "text": "جهاندار هم داستانی نکرد"
  },
  {
    "poem_id": 1908,
    "vorder": 4,
    "position": 1,
    "text": "از ایران و توران برآورد گرد"
  },
  {
    "poem_id": 1908,
    "vorder": 5,
    "position": 0,
    "text": "چو آن دادگر شاه بیداد گشت"
  },
  {
    "poem_id": 1908,
    "vorder": 6,
    "position": 1,
    "text": "ز بیدادی کهتران شادگشت"
  },
  {
    "poem_id": 1908,
    "vorder": 7,
    "position": 0,
    "text": "بیامد فرخ زاد آزرمگان"
  },
  {
    "poem_id": 1908,
    "vorder": 8,
    "position": 1,
    "text": "دژم روی با زیردستان ژکان"
  },
  {
    "poem_id": 1908,
    "vorder": 9,
    "position": 0,
    "text": "ز هرکس همی خواسته بستدی"
  },
  {
    "poem_id": 1908,
    "vorder": 10,
    "position": 1,
    "text": "همی این بران آن برین بر زدی"
  },
  {
    "poem_id": 1908,
    "vorder": 11,
    "position": 0,
    "text": "به نفرین شد آن آفرینهای پیش"
  },
  {
    "poem_id": 1908,
    "vorder": 12,
    "position": 1,
    "text": "که چون گرگ بیدادگر گشت میش"
  },
  {
    "poem_id": 1908,
    "vorder": 13,
    "position": 0,
    "text": "بیاراست بر خویشتن رنج نو"
  },
  {
    "poem_id": 1908,
    "vorder": 14,
    "position": 1,
    "text": "نکرد آرزو جز همه گنج نو"
  },
  {
    "poem_id": 1908,
    "vorder": 15,
    "position": 0,
    "text": "چو بی‌آب و بی‌نان و بی تن شدند"
  },
  {
    "poem_id": 1908,
    "vorder": 16,
    "position": 1,
    "text": "ز ایران سوی شهر دشمن شدند"
  },
  {
    "poem_id": 1908,
    "vorder": 17,
    "position": 0,
    "text": "هر آنکس کزان بتری یافت بهر"
  },
  {
    "poem_id": 1908,
    "vorder": 18,
    "position": 1,
    "text": "همی دود نفرین برآمد ز شهر"
  },
  {
    "poem_id": 1908,
    "vorder": 19,
    "position": 0,
    "text": "یکی بی‌هنر بود نامش گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 20,
    "position": 1,
    "text": "کزو یافتی خواب و آرام و ناز"
  },
  {
    "poem_id": 1908,
    "vorder": 21,
    "position": 0,
    "text": "که بودی همیشه نگهبان روم"
  },
  {
    "poem_id": 1908,
    "vorder": 22,
    "position": 1,
    "text": "یکی دیو سر بود بیداد و شوم"
  },
  {
    "poem_id": 1908,
    "vorder": 23,
    "position": 0,
    "text": "چو شد شاه با داد بیدادگر"
  },
  {
    "poem_id": 1908,
    "vorder": 24,
    "position": 1,
    "text": "از ایران نخست او بپیچید سر"
  },
  {
    "poem_id": 1908,
    "vorder": 25,
    "position": 0,
    "text": "دگر زاد فرخ که نامی بدی"
  },
  {
    "poem_id": 1908,
    "vorder": 26,
    "position": 1,
    "text": "به نزدیک خسرو گرامی بدی"
  },
  {
    "poem_id": 1908,
    "vorder": 27,
    "position": 0,
    "text": "نیارست کس رفت نزدیک شاه"
  },
  {
    "poem_id": 1908,
    "vorder": 28,
    "position": 1,
    "text": "همه زاد فرخ بدی بار خواه"
  },
  {
    "poem_id": 1908,
    "vorder": 29,
    "position": 0,
    "text": "شهنشاه را چون پرآمد قفیز"
  },
  {
    "poem_id": 1908,
    "vorder": 30,
    "position": 1,
    "text": "دل زاد فرخ تبه گشت نیز"
  },
  {
    "poem_id": 1908,
    "vorder": 31,
    "position": 0,
    "text": "یکی گشت با سالخورده گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 32,
    "position": 1,
    "text": "ز کشور به کشور به پیوست راز"
  },
  {
    "poem_id": 1908,
    "vorder": 33,
    "position": 0,
    "text": "گراز سپهبد یکی نامه کرد"
  },
  {
    "poem_id": 1908,
    "vorder": 34,
    "position": 1,
    "text": "به قیصر و را نیز بدکامه کرد"
  },
  {
    "poem_id": 1908,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت برخیز و ایران بگیر"
  },
  {
    "poem_id": 1908,
    "vorder": 36,
    "position": 1,
    "text": "نخستین من آیم تو را دستگیر"
  },
  {
    "poem_id": 1908,
    "vorder": 37,
    "position": 0,
    "text": "چو آن نامه برخواند قیصر سپاه"
  },
  {
    "poem_id": 1908,
    "vorder": 38,
    "position": 1,
    "text": "فراز آورید از در رزمگاه"
  },
  {
    "poem_id": 1908,
    "vorder": 39,
    "position": 0,
    "text": "بیاورد لشکر هم آنگه ز روم"
  },
  {
    "poem_id": 1908,
    "vorder": 40,
    "position": 1,
    "text": "بیامد سوی مرز آباد بوم"
  },
  {
    "poem_id": 1908,
    "vorder": 41,
    "position": 0,
    "text": "چو آگاه شد زان سخن شهریار"
  },
  {
    "poem_id": 1908,
    "vorder": 42,
    "position": 1,
    "text": "همی‌داشت آن کار دشوار خوار"
  },
  {
    "poem_id": 1908,
    "vorder": 43,
    "position": 0,
    "text": "بدانست کان هست کار گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 44,
    "position": 1,
    "text": "که گفته ست با قیصر رزمساز"
  },
  {
    "poem_id": 1908,
    "vorder": 45,
    "position": 0,
    "text": "بدان کش همی‌خواند و او چاره‌جست"
  },
  {
    "poem_id": 1908,
    "vorder": 46,
    "position": 1,
    "text": "همی‌داشت آن نامور شاه سست"
  },
  {
    "poem_id": 1908,
    "vorder": 47,
    "position": 0,
    "text": "ز پرویز ترسان بد آن بدنشان"
  },
  {
    "poem_id": 1908,
    "vorder": 48,
    "position": 1,
    "text": "ز درگاه او هم ز گردنکشان"
  },
  {
    "poem_id": 1908,
    "vorder": 49,
    "position": 0,
    "text": "شهنشاه بنشست با مهتران"
  },
  {
    "poem_id": 1908,
    "vorder": 50,
    "position": 1,
    "text": "هر آنکس که بودند ز ایران سران"
  },
  {
    "poem_id": 1908,
    "vorder": 51,
    "position": 0,
    "text": "ز اندیشه پاک دل رابشست"
  },
  {
    "poem_id": 1908,
    "vorder": 52,
    "position": 1,
    "text": "فراوان زهر گونه‌ای چاره جست"
  },
  {
    "poem_id": 1908,
    "vorder": 53,
    "position": 0,
    "text": "چو اندیشه روشن آمد فراز"
  },
  {
    "poem_id": 1908,
    "vorder": 54,
    "position": 1,
    "text": "یکی نامه بنوشت نزد گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 55,
    "position": 0,
    "text": "که از تو پسندیدم این کارکرد"
  },
  {
    "poem_id": 1908,
    "vorder": 56,
    "position": 1,
    "text": "ستودم تو را نزد مردان مرد"
  },
  {
    "poem_id": 1908,
    "vorder": 57,
    "position": 0,
    "text": "ز کردارها برفزودی فریب"
  },
  {
    "poem_id": 1908,
    "vorder": 58,
    "position": 1,
    "text": "سر قیصر آوردی اندر نشیب"
  },
  {
    "poem_id": 1908,
    "vorder": 59,
    "position": 0,
    "text": "چواین نامه آرند نزدیک تو"
  },
  {
    "poem_id": 1908,
    "vorder": 60,
    "position": 1,
    "text": "پراندیشه کن رای تاریک تو"
  },
  {
    "poem_id": 1908,
    "vorder": 61,
    "position": 0,
    "text": "همی‌باش تا من بجنبم زجای"
  },
  {
    "poem_id": 1908,
    "vorder": 62,
    "position": 1,
    "text": "تو با لشکر خویش بگذار پای"
  },
  {
    "poem_id": 1908,
    "vorder": 63,
    "position": 0,
    "text": "چو زین روی و زان روی باشد سپاه"
  },
  {
    "poem_id": 1908,
    "vorder": 64,
    "position": 1,
    "text": "شود در سخن رای قیصر تباه"
  },
  {
    "poem_id": 1908,
    "vorder": 65,
    "position": 0,
    "text": "به ایران و را دستگیر آوریم"
  },
  {
    "poem_id": 1908,
    "vorder": 66,
    "position": 1,
    "text": "همه رومیان را اسیر آوریم"
  },
  {
    "poem_id": 1908,
    "vorder": 67,
    "position": 0,
    "text": "ز درگه یکی چاره گر برگزید"
  },
  {
    "poem_id": 1908,
    "vorder": 68,
    "position": 1,
    "text": "سخن دان و گویا چناچون سزید"
  },
  {
    "poem_id": 1908,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت کاین نامه اندر نهان"
  },
  {
    "poem_id": 1908,
    "vorder": 70,
    "position": 1,
    "text": "همی بر بکردار کارآگهان"
  },
  {
    "poem_id": 1908,
    "vorder": 71,
    "position": 0,
    "text": "چنان کن که رومیت بیند کسی"
  },
  {
    "poem_id": 1908,
    "vorder": 72,
    "position": 1,
    "text": "بره بر سخن پرسد از تو بسی"
  },
  {
    "poem_id": 1908,
    "vorder": 73,
    "position": 0,
    "text": "بگیرد تو را نزد قیصر برد"
  },
  {
    "poem_id": 1908,
    "vorder": 74,
    "position": 1,
    "text": "گرت نزد سالار لشکر برد"
  },
  {
    "poem_id": 1908,
    "vorder": 75,
    "position": 0,
    "text": "بپرسد تو را کز کجایی مگوی"
  },
  {
    "poem_id": 1908,
    "vorder": 76,
    "position": 1,
    "text": "بگویش که من کهتری چاره‌جوی"
  },
  {
    "poem_id": 1908,
    "vorder": 77,
    "position": 0,
    "text": "به پیمودم این رنج راه دراز"
  },
  {
    "poem_id": 1908,
    "vorder": 78,
    "position": 1,
    "text": "یکی نامه دارم بسوی گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 79,
    "position": 0,
    "text": "تواین نامه بربند بردست راست"
  },
  {
    "poem_id": 1908,
    "vorder": 80,
    "position": 1,
    "text": "گر ایدون که بستاند از تو رواست"
  },
  {
    "poem_id": 1908,
    "vorder": 81,
    "position": 0,
    "text": "برون آمد از پیش خسرو نوند"
  },
  {
    "poem_id": 1908,
    "vorder": 82,
    "position": 1,
    "text": "به بازو مر آن نامه را کرد بند"
  },
  {
    "poem_id": 1908,
    "vorder": 83,
    "position": 0,
    "text": "بیامد چو نزدیک قیصر رسید"
  },
  {
    "poem_id": 1908,
    "vorder": 84,
    "position": 1,
    "text": "یکی مرد بطریق او را بدید"
  },
  {
    "poem_id": 1908,
    "vorder": 85,
    "position": 0,
    "text": "سوی قیصرش برد سر پر ز گرد"
  },
  {
    "poem_id": 1908,
    "vorder": 86,
    "position": 1,
    "text": "دو رخ زرد و لبها شده لاژورد"
  },
  {
    "poem_id": 1908,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت قیصر که خسرو کجاست"
  },
  {
    "poem_id": 1908,
    "vorder": 88,
    "position": 1,
    "text": "ببایدت گفتن بما راه راست"
  },
  {
    "poem_id": 1908,
    "vorder": 89,
    "position": 0,
    "text": "ازو خیره شد کهتر چاره جوی"
  },
  {
    "poem_id": 1908,
    "vorder": 90,
    "position": 1,
    "text": "ز بیمش بپاسخ دژم کرد روی"
  },
  {
    "poem_id": 1908,
    "vorder": 91,
    "position": 0,
    "text": "بجویید گفت این بلاجوی را"
  },
  {
    "poem_id": 1908,
    "vorder": 92,
    "position": 1,
    "text": "بداندیش و بدکام و بدگوی را"
  },
  {
    "poem_id": 1908,
    "vorder": 93,
    "position": 0,
    "text": "بجستند و آن نامه از دست اوی"
  },
  {
    "poem_id": 1908,
    "vorder": 94,
    "position": 1,
    "text": "گشاد آنک دانا بد و راه جوی"
  },
  {
    "poem_id": 1908,
    "vorder": 95,
    "position": 0,
    "text": "ازان مرز دانا سری را بجست"
  },
  {
    "poem_id": 1908,
    "vorder": 96,
    "position": 1,
    "text": "که آن پهلوانی بخواند درست"
  },
  {
    "poem_id": 1908,
    "vorder": 97,
    "position": 0,
    "text": "چو آن نامه برخواند مرد دبیر"
  },
  {
    "poem_id": 1908,
    "vorder": 98,
    "position": 1,
    "text": "رخ نامور شد به کردار قیر"
  },
  {
    "poem_id": 1908,
    "vorder": 99,
    "position": 0,
    "text": "به دل گفت کاین بد کمین گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 100,
    "position": 1,
    "text": "دلیر آمدستم به دامش فراز"
  },
  {
    "poem_id": 1908,
    "vorder": 101,
    "position": 0,
    "text": "شهنشاه و لشکر چو سیصد هزار"
  },
  {
    "poem_id": 1908,
    "vorder": 102,
    "position": 1,
    "text": "کس از پیل جنگش نداند شمار"
  },
  {
    "poem_id": 1908,
    "vorder": 103,
    "position": 0,
    "text": "مرا خواست افگند در دام اوی"
  },
  {
    "poem_id": 1908,
    "vorder": 104,
    "position": 1,
    "text": "که تاریک بادا سرانجام اوی"
  },
  {
    "poem_id": 1908,
    "vorder": 105,
    "position": 0,
    "text": "و زان جایگه لشکر اندر کشید"
  },
  {
    "poem_id": 1908,
    "vorder": 106,
    "position": 1,
    "text": "شد آن آرزو بر دلش ناپدید"
  },
  {
    "poem_id": 1908,
    "vorder": 107,
    "position": 0,
    "text": "چو آگاهی آمد به سوی گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 108,
    "position": 1,
    "text": "که آن نامور شد سوی روم باز"
  },
  {
    "poem_id": 1908,
    "vorder": 109,
    "position": 0,
    "text": "دلش گشت پر درد و رخساره زرد"
  },
  {
    "poem_id": 1908,
    "vorder": 110,
    "position": 1,
    "text": "سواری گزید ازدلیران مرد"
  },
  {
    "poem_id": 1908,
    "vorder": 111,
    "position": 0,
    "text": "یکی نامه بنوشت با باد و دم"
  },
  {
    "poem_id": 1908,
    "vorder": 112,
    "position": 1,
    "text": "که بر من چرا گشت قیصر دژم"
  },
  {
    "poem_id": 1908,
    "vorder": 113,
    "position": 0,
    "text": "از ایران چرا بازگشتی بگوی"
  },
  {
    "poem_id": 1908,
    "vorder": 114,
    "position": 1,
    "text": "مرا کردی اندر جهان چاره‌جوی"
  },
  {
    "poem_id": 1908,
    "vorder": 115,
    "position": 0,
    "text": "شهنشاه داند که من کردم این"
  },
  {
    "poem_id": 1908,
    "vorder": 116,
    "position": 1,
    "text": "دلش گردد از من پر از درد وکین"
  },
  {
    "poem_id": 1908,
    "vorder": 117,
    "position": 0,
    "text": "چو قیصر نگه کرد و آن نامه دید"
  },
  {
    "poem_id": 1908,
    "vorder": 118,
    "position": 1,
    "text": "ز لشکر گرانمایه‌ای برگزید"
  },
  {
    "poem_id": 1908,
    "vorder": 119,
    "position": 0,
    "text": "فرستاد تازان به نزد گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 120,
    "position": 1,
    "text": "کزان ایزدت کرده‌بد بی نیاز"
  },
  {
    "poem_id": 1908,
    "vorder": 121,
    "position": 0,
    "text": "که ویران کنی تاج و گاه مرا"
  },
  {
    "poem_id": 1908,
    "vorder": 122,
    "position": 1,
    "text": "به آتش بسوزی سپاه مرا"
  },
  {
    "poem_id": 1908,
    "vorder": 123,
    "position": 0,
    "text": "کز آن نامه جز گنج دادن بباد"
  },
  {
    "poem_id": 1908,
    "vorder": 124,
    "position": 1,
    "text": "نیامد مرا از تو ای بد نژاد"
  },
  {
    "poem_id": 1908,
    "vorder": 125,
    "position": 0,
    "text": "مرا خواستی تا به خسرو دهی"
  },
  {
    "poem_id": 1908,
    "vorder": 126,
    "position": 1,
    "text": "که هرگز مبادت بهی و مهی"
  },
  {
    "poem_id": 1908,
    "vorder": 127,
    "position": 0,
    "text": "به ایران نخواهند بیگانه‌ای"
  },
  {
    "poem_id": 1908,
    "vorder": 128,
    "position": 1,
    "text": "نه قیصر نژادی نه فرزانه‌ای"
  },
  {
    "poem_id": 1908,
    "vorder": 129,
    "position": 0,
    "text": "به قیصر بسی کرد پوزش گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 130,
    "position": 1,
    "text": "به کوشش نیامد بدامش فراز"
  },
  {
    "poem_id": 1908,
    "vorder": 131,
    "position": 0,
    "text": "گزین کرد خسرو پس آزاده‌ای"
  },
  {
    "poem_id": 1908,
    "vorder": 132,
    "position": 1,
    "text": "سخن گوی و دانا فرستاده‌ای"
  },
  {
    "poem_id": 1908,
    "vorder": 133,
    "position": 0,
    "text": "یکی نامه بنوشت سوی گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 134,
    "position": 1,
    "text": "که‌ای بی بها ریمن دیو ساز"
  },
  {
    "poem_id": 1908,
    "vorder": 135,
    "position": 0,
    "text": "تو را چند خوانم برین بارگاه"
  },
  {
    "poem_id": 1908,
    "vorder": 136,
    "position": 1,
    "text": "همی دورمانی ز فرمان و راه"
  },
  {
    "poem_id": 1908,
    "vorder": 137,
    "position": 0,
    "text": "کنون آن سپاهی که نزد تواند"
  },
  {
    "poem_id": 1908,
    "vorder": 138,
    "position": 1,
    "text": "بسال و به ماه اورمزد تواند"
  },
  {
    "poem_id": 1908,
    "vorder": 139,
    "position": 0,
    "text": "به رای و به دل ویژه با قیصرند"
  },
  {
    "poem_id": 1908,
    "vorder": 140,
    "position": 1,
    "text": "نهانی به اندیشه دیگرند"
  },
  {
    "poem_id": 1908,
    "vorder": 141,
    "position": 0,
    "text": "برما فرست آنک پیچیده‌اند"
  },
  {
    "poem_id": 1908,
    "vorder": 142,
    "position": 1,
    "text": "همه سرکشی رابسیچیده‌اند"
  },
  {
    "poem_id": 1908,
    "vorder": 143,
    "position": 0,
    "text": "چواین نامه آمد بنزد گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 144,
    "position": 1,
    "text": "پر اندیشه شد کهتر دیوساز"
  },
  {
    "poem_id": 1908,
    "vorder": 145,
    "position": 0,
    "text": "گزین کرد زان نامداران سوار"
  },
  {
    "poem_id": 1908,
    "vorder": 146,
    "position": 1,
    "text": "از ایران و نیران ده و دو هزار"
  },
  {
    "poem_id": 1908,
    "vorder": 147,
    "position": 0,
    "text": "بدان مهتران گفت یک دل شوید"
  },
  {
    "poem_id": 1908,
    "vorder": 148,
    "position": 1,
    "text": "سخن گفتن هرکسی مشنوید"
  },
  {
    "poem_id": 1908,
    "vorder": 149,
    "position": 0,
    "text": "بباشید یک چند زین روی آب"
  },
  {
    "poem_id": 1908,
    "vorder": 150,
    "position": 1,
    "text": "مگیرید یک سر به رفتن شتاب"
  },
  {
    "poem_id": 1908,
    "vorder": 151,
    "position": 0,
    "text": "چو هم پشت باشید با همرهان"
  },
  {
    "poem_id": 1908,
    "vorder": 152,
    "position": 1,
    "text": "یکی کوه کندن ز بن بر توان"
  },
  {
    "poem_id": 1908,
    "vorder": 153,
    "position": 0,
    "text": "سپه رفت تا خرهٔ اردشیر"
  },
  {
    "poem_id": 1908,
    "vorder": 154,
    "position": 1,
    "text": "هر آنکس که بودند برنا و پیر"
  },
  {
    "poem_id": 1908,
    "vorder": 155,
    "position": 0,
    "text": "کشیدند لشکر بران رودبار"
  },
  {
    "poem_id": 1908,
    "vorder": 156,
    "position": 1,
    "text": "بدان تا چه فرمان دهد شهریار"
  },
  {
    "poem_id": 1908,
    "vorder": 157,
    "position": 0,
    "text": "چو آگاه شد خسرو از کارشان"
  },
  {
    "poem_id": 1908,
    "vorder": 158,
    "position": 1,
    "text": "نبود آرزومند دیدارشان"
  },
  {
    "poem_id": 1908,
    "vorder": 159,
    "position": 0,
    "text": "بفرمود تا زاد فرخ برفت"
  },
  {
    "poem_id": 1908,
    "vorder": 160,
    "position": 1,
    "text": "به نزدیک آن لشکر شاه تفت"
  },
  {
    "poem_id": 1908,
    "vorder": 161,
    "position": 0,
    "text": "چنین بود پیغام نزد سپاه"
  },
  {
    "poem_id": 1908,
    "vorder": 162,
    "position": 1,
    "text": "که از پیش بودی مرا نیک خواه"
  },
  {
    "poem_id": 1908,
    "vorder": 163,
    "position": 0,
    "text": "چرا راه دادی که قیصر ز روم"
  },
  {
    "poem_id": 1908,
    "vorder": 164,
    "position": 1,
    "text": "بیاورد لشکر بدین مرز و بوم"
  },
  {
    "poem_id": 1908,
    "vorder": 165,
    "position": 0,
    "text": "که بود آنک از راه یزدان بگشت"
  },
  {
    "poem_id": 1908,
    "vorder": 166,
    "position": 1,
    "text": "ز راه و ز پیمان ما برگذشت"
  },
  {
    "poem_id": 1908,
    "vorder": 167,
    "position": 0,
    "text": "چو پیغام خسرو شنید آن سپاه"
  },
  {
    "poem_id": 1908,
    "vorder": 168,
    "position": 1,
    "text": "شد از بیم رخسار ایشان سیاه"
  },
  {
    "poem_id": 1908,
    "vorder": 169,
    "position": 0,
    "text": "کس آن راز پیدا نیارست کرد"
  },
  {
    "poem_id": 1908,
    "vorder": 170,
    "position": 1,
    "text": "بماندند با درد و رخساره زرد"
  },
  {
    "poem_id": 1908,
    "vorder": 171,
    "position": 0,
    "text": "پیمبر یکی بد به دل با گراز"
  },
  {
    "poem_id": 1908,
    "vorder": 172,
    "position": 1,
    "text": "همی‌داشت از آب وز باد راز"
  },
  {
    "poem_id": 1908,
    "vorder": 173,
    "position": 0,
    "text": "بیامد نهانی به نزدیکشان"
  },
  {
    "poem_id": 1908,
    "vorder": 174,
    "position": 1,
    "text": "برافروخت جانهای تاریکشان"
  },
  {
    "poem_id": 1908,
    "vorder": 175,
    "position": 0,
    "text": "مترسید گفت ای بزرگان که شاه"
  },
  {
    "poem_id": 1908,
    "vorder": 176,
    "position": 1,
    "text": "ندید از شما آشکارا گناه"
  },
  {
    "poem_id": 1908,
    "vorder": 177,
    "position": 0,
    "text": "مباشید جز یک دل و یک زبان"
  },
  {
    "poem_id": 1908,
    "vorder": 178,
    "position": 1,
    "text": "مگویید کز ما که شد بدگمان"
  },
  {
    "poem_id": 1908,
    "vorder": 179,
    "position": 0,
    "text": "وگر شد همه زیر یک چادریم"
  },
  {
    "poem_id": 1908,
    "vorder": 180,
    "position": 1,
    "text": "به مردی همه یاد هم دیگریم"
  },
  {
    "poem_id": 1908,
    "vorder": 181,
    "position": 0,
    "text": "همان چون شنیدند آواز اوی"
  },
  {
    "poem_id": 1908,
    "vorder": 182,
    "position": 1,
    "text": "بدانست هر مهتری راز اوی"
  },
  {
    "poem_id": 1908,
    "vorder": 183,
    "position": 0,
    "text": "مهان یکسر از جای برخاستند"
  },
  {
    "poem_id": 1908,
    "vorder": 184,
    "position": 1,
    "text": "بران هم نشان پاسخ آراستند"
  },
  {
    "poem_id": 1908,
    "vorder": 185,
    "position": 0,
    "text": "بر شاه شد زاد فرخ چو گرد"
  },
  {
    "poem_id": 1908,
    "vorder": 186,
    "position": 1,
    "text": "سخنهای ایشان همه یاد کرد"
  },
  {
    "poem_id": 1908,
    "vorder": 187,
    "position": 0,
    "text": "بدو گفت رو پیش ایشان بگوی"
  },
  {
    "poem_id": 1908,
    "vorder": 188,
    "position": 1,
    "text": "که اندر شما کیست آزار جوی"
  },
  {
    "poem_id": 1908,
    "vorder": 189,
    "position": 0,
    "text": "که بفریفتش قیصر شوم بخت"
  },
  {
    "poem_id": 1908,
    "vorder": 190,
    "position": 1,
    "text": "به گنج و سلیح و به تاج و به تخت"
  },
  {
    "poem_id": 1908,
    "vorder": 191,
    "position": 0,
    "text": "که نزدیک ما او گنهکار شد"
  },
  {
    "poem_id": 1908,
    "vorder": 192,
    "position": 1,
    "text": "هم از تاج و اورنگ بیزار شد"
  },
  {
    "poem_id": 1908,
    "vorder": 193,
    "position": 0,
    "text": "فرستید یک سر بدین بارگاه"
  },
  {
    "poem_id": 1908,
    "vorder": 194,
    "position": 1,
    "text": "کسی راکه بودست زین سرگناه"
  },
  {
    "poem_id": 1908,
    "vorder": 195,
    "position": 0,
    "text": "بشد زاد فرخ بگفت این سخن"
  },
  {
    "poem_id": 1908,
    "vorder": 196,
    "position": 1,
    "text": "رخ لشکر نو ز غم شد کهن"
  },
  {
    "poem_id": 1908,
    "vorder": 197,
    "position": 0,
    "text": "نیارست لب را گشود ایچ کس"
  },
  {
    "poem_id": 1908,
    "vorder": 198,
    "position": 1,
    "text": "پر از درد و خامش بماندند و بس"
  },
  {
    "poem_id": 1908,
    "vorder": 199,
    "position": 0,
    "text": "سبک زاد فرخ زبان برگشاد"
  },
  {
    "poem_id": 1908,
    "vorder": 200,
    "position": 1,
    "text": "همی‌کرد گفتار ناخوب یاد"
  },
  {
    "poem_id": 1908,
    "vorder": 201,
    "position": 0,
    "text": "کزین سان سپاهی دلیر و جوان"
  },
  {
    "poem_id": 1908,
    "vorder": 202,
    "position": 1,
    "text": "نبینم کس اندر میان ناتوان"
  },
  {
    "poem_id": 1908,
    "vorder": 203,
    "position": 0,
    "text": "شما را چرا بیم باشد ز شاه"
  },
  {
    "poem_id": 1908,
    "vorder": 204,
    "position": 1,
    "text": "به گیتی پراگنده دارد سپاه"
  },
  {
    "poem_id": 1908,
    "vorder": 205,
    "position": 0,
    "text": "بزرگی نبینم به درگاه اوی"
  },
  {
    "poem_id": 1908,
    "vorder": 206,
    "position": 1,
    "text": "که روشن کند اختر و ماه اوی"
  },
  {
    "poem_id": 1908,
    "vorder": 207,
    "position": 0,
    "text": "شما خوار دارید گفتار من"
  },
  {
    "poem_id": 1908,
    "vorder": 208,
    "position": 1,
    "text": "مترسید یک سر ز آزار من"
  },
  {
    "poem_id": 1908,
    "vorder": 209,
    "position": 0,
    "text": "به دشنام لب را گشایید باز"
  },
  {
    "poem_id": 1908,
    "vorder": 210,
    "position": 1,
    "text": "چه بر من چه بر شاه گردن فراز"
  },
  {
    "poem_id": 1908,
    "vorder": 211,
    "position": 0,
    "text": "هر آنکس که بشنید زو این سخن"
  },
  {
    "poem_id": 1908,
    "vorder": 212,
    "position": 1,
    "text": "بدانست کان تخت نوشد کهن"
  },
  {
    "poem_id": 1908,
    "vorder": 213,
    "position": 0,
    "text": "همه یکسر از جای برخاستند"
  },
  {
    "poem_id": 1908,
    "vorder": 214,
    "position": 1,
    "text": "به دشنام لبها بیاراستند"
  },
  {
    "poem_id": 1908,
    "vorder": 215,
    "position": 0,
    "text": "بشد زاد فرخ به خسرو بگفت"
  },
  {
    "poem_id": 1908,
    "vorder": 216,
    "position": 1,
    "text": "که لشکر همه یار گشتند و جفت"
  },
  {
    "poem_id": 1908,
    "vorder": 217,
    "position": 0,
    "text": "مرا بیم جانست اگر نیز شاه"
  },
  {
    "poem_id": 1908,
    "vorder": 218,
    "position": 1,
    "text": "فرستد به پیغام نزد سپاه"
  },
  {
    "poem_id": 1908,
    "vorder": 219,
    "position": 0,
    "text": "بدانست خسرو که آن کژگوی"
  },
  {
    "poem_id": 1908,
    "vorder": 220,
    "position": 1,
    "text": "همی آب و خون اندر آرد به جوی"
  },
  {
    "poem_id": 1908,
    "vorder": 221,
    "position": 0,
    "text": "ز بیم برادرش چیزی نگفت"
  },
  {
    "poem_id": 1908,
    "vorder": 222,
    "position": 1,
    "text": "همی‌داشت آن راستی در نهفت"
  },
  {
    "poem_id": 1908,
    "vorder": 223,
    "position": 0,
    "text": "که پیچیده بد رستم از شهریار"
  },
  {
    "poem_id": 1908,
    "vorder": 224,
    "position": 1,
    "text": "بجایی خود و تیغ زن ده هزار"
  },
  {
    "poem_id": 1908,
    "vorder": 225,
    "position": 0,
    "text": "دل زاده فرخ نگه داشت نیز"
  },
  {
    "poem_id": 1908,
    "vorder": 226,
    "position": 1,
    "text": "سپه را همه روی برگاشت نیز"
  }
]