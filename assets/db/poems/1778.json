[
  {
    "poem_id": 1778,
    "vorder": 1,
    "position": 0,
    "text": "بیامد سوم روز شبگیر شاه"
  },
  {
    "poem_id": 1778,
    "vorder": 2,
    "position": 1,
    "text": "سوی دشت نخچیرگه با سپاه"
  },
  {
    "poem_id": 1778,
    "vorder": 3,
    "position": 0,
    "text": "به دست چپش هرمز کدخدای"
  },
  {
    "poem_id": 1778,
    "vorder": 4,
    "position": 1,
    "text": "سوی راستش موبد پاک‌رای"
  },
  {
    "poem_id": 1778,
    "vorder": 5,
    "position": 0,
    "text": "برو داستانها همی خواندند"
  },
  {
    "poem_id": 1778,
    "vorder": 6,
    "position": 1,
    "text": "ز جم و فریدون سخن راندند"
  },
  {
    "poem_id": 1778,
    "vorder": 7,
    "position": 0,
    "text": "سگ و یوز در پیش و شاهین و باز"
  },
  {
    "poem_id": 1778,
    "vorder": 8,
    "position": 1,
    "text": "همی تا به سر برد روز دراز"
  },
  {
    "poem_id": 1778,
    "vorder": 9,
    "position": 0,
    "text": "چو خورشید تابان به گنبد رسید"
  },
  {
    "poem_id": 1778,
    "vorder": 10,
    "position": 1,
    "text": "به جایی پی گور و آهو ندید"
  },
  {
    "poem_id": 1778,
    "vorder": 11,
    "position": 0,
    "text": "چو خورشید تابان درم ساز گشت"
  },
  {
    "poem_id": 1778,
    "vorder": 12,
    "position": 1,
    "text": "ز نخچیرگه تنگدل بازگشت"
  },
  {
    "poem_id": 1778,
    "vorder": 13,
    "position": 0,
    "text": "به پیش اندر آمد یکی سبز جای"
  },
  {
    "poem_id": 1778,
    "vorder": 14,
    "position": 1,
    "text": "بسی اندرو مردم و چارپای"
  },
  {
    "poem_id": 1778,
    "vorder": 15,
    "position": 0,
    "text": "ازان ده فراوان به راه آمدند"
  },
  {
    "poem_id": 1778,
    "vorder": 16,
    "position": 1,
    "text": "نظاره به پیش سپاه آمدند"
  },
  {
    "poem_id": 1778,
    "vorder": 17,
    "position": 0,
    "text": "جهاندار پرخشم و پرتاب بود"
  },
  {
    "poem_id": 1778,
    "vorder": 18,
    "position": 1,
    "text": "همی خواست کاید بدان ده فرود"
  },
  {
    "poem_id": 1778,
    "vorder": 19,
    "position": 0,
    "text": "نکردند زیشان کسی آفرین"
  },
  {
    "poem_id": 1778,
    "vorder": 20,
    "position": 1,
    "text": "تو گفتی ببست آن خران را زمین"
  },
  {
    "poem_id": 1778,
    "vorder": 21,
    "position": 0,
    "text": "ازان مردمان تنگدل گشت شاه"
  },
  {
    "poem_id": 1778,
    "vorder": 22,
    "position": 1,
    "text": "به خوبی نکرد اندر ایشان نگاه"
  },
  {
    "poem_id": 1778,
    "vorder": 23,
    "position": 0,
    "text": "به موبد چنین گفت کاین سبز جای"
  },
  {
    "poem_id": 1778,
    "vorder": 24,
    "position": 1,
    "text": "پر از خانه و مردم و چارپای"
  },
  {
    "poem_id": 1778,
    "vorder": 25,
    "position": 0,
    "text": "کنام دد و دام و نخچیر باد"
  },
  {
    "poem_id": 1778,
    "vorder": 26,
    "position": 1,
    "text": "به جوی اندرون آب چون قیر باد"
  },
  {
    "poem_id": 1778,
    "vorder": 27,
    "position": 0,
    "text": "بدانست موبد که فرمان شاه"
  },
  {
    "poem_id": 1778,
    "vorder": 28,
    "position": 1,
    "text": "چه بود اندران سوی ده شد ز راه"
  },
  {
    "poem_id": 1778,
    "vorder": 29,
    "position": 0,
    "text": "بدیشان چنین گفت کاین سبزجای"
  },
  {
    "poem_id": 1778,
    "vorder": 30,
    "position": 1,
    "text": "پر از خانه و مردم و چارپای"
  },
  {
    "poem_id": 1778,
    "vorder": 31,
    "position": 0,
    "text": "خوش آمد شهنشاه بهرام را"
  },
  {
    "poem_id": 1778,
    "vorder": 32,
    "position": 1,
    "text": "یکی تازه کرد اندرین کام را"
  },
  {
    "poem_id": 1778,
    "vorder": 33,
    "position": 0,
    "text": "دگر گفت موبد بدان مردمان"
  },
  {
    "poem_id": 1778,
    "vorder": 34,
    "position": 1,
    "text": "که جاوید دارید دل شادمان"
  },
  {
    "poem_id": 1778,
    "vorder": 35,
    "position": 0,
    "text": "شما را همه یکسره کرد مه"
  },
  {
    "poem_id": 1778,
    "vorder": 36,
    "position": 1,
    "text": "بدان تا کند شهره این خوب ده"
  },
  {
    "poem_id": 1778,
    "vorder": 37,
    "position": 0,
    "text": "بدین ده زن و کودکان مهترند"
  },
  {
    "poem_id": 1778,
    "vorder": 38,
    "position": 1,
    "text": "کسی را نباید که فرمان برند"
  },
  {
    "poem_id": 1778,
    "vorder": 39,
    "position": 0,
    "text": "بدین ده چه مزدور و چه کدخدای"
  },
  {
    "poem_id": 1778,
    "vorder": 40,
    "position": 1,
    "text": "به یک راه باید که دارند جای"
  },
  {
    "poem_id": 1778,
    "vorder": 41,
    "position": 0,
    "text": "زن و کودک و مرد جمله مهید"
  },
  {
    "poem_id": 1778,
    "vorder": 42,
    "position": 1,
    "text": "یکایک همه کدخدای دهید"
  },
  {
    "poem_id": 1778,
    "vorder": 43,
    "position": 0,
    "text": "خروشی برآمد ز پرمایه ده"
  },
  {
    "poem_id": 1778,
    "vorder": 44,
    "position": 1,
    "text": "ز شادی که گشتند همواره مه"
  },
  {
    "poem_id": 1778,
    "vorder": 45,
    "position": 0,
    "text": "زن و مرد ازان پس یکی شد به رای"
  },
  {
    "poem_id": 1778,
    "vorder": 46,
    "position": 1,
    "text": "پرستار و مزدور با کدخدای"
  },
  {
    "poem_id": 1778,
    "vorder": 47,
    "position": 0,
    "text": "چو ناباک شد مرد برنا به ده"
  },
  {
    "poem_id": 1778,
    "vorder": 48,
    "position": 1,
    "text": "بریدند ناگه سر مرد مه"
  },
  {
    "poem_id": 1778,
    "vorder": 49,
    "position": 0,
    "text": "همه یک به دیگر برآمیختند"
  },
  {
    "poem_id": 1778,
    "vorder": 50,
    "position": 1,
    "text": "به هرجای بی‌راه خون ریختند"
  },
  {
    "poem_id": 1778,
    "vorder": 51,
    "position": 0,
    "text": "چو برخاست زان روستا رستخیز"
  },
  {
    "poem_id": 1778,
    "vorder": 52,
    "position": 1,
    "text": "گرفتند ناگاه ازان ده گریز"
  },
  {
    "poem_id": 1778,
    "vorder": 53,
    "position": 0,
    "text": "بماندند پیران ابی پای و پر"
  },
  {
    "poem_id": 1778,
    "vorder": 54,
    "position": 1,
    "text": "بشد آلت ورزش و ساز و بر"
  },
  {
    "poem_id": 1778,
    "vorder": 55,
    "position": 0,
    "text": "همه ده به ویرانی آورد روی"
  },
  {
    "poem_id": 1778,
    "vorder": 56,
    "position": 1,
    "text": "درختان شده خشک و بی‌آب جوی"
  },
  {
    "poem_id": 1778,
    "vorder": 57,
    "position": 0,
    "text": "شده دشت ویران و ویران سرای"
  },
  {
    "poem_id": 1778,
    "vorder": 58,
    "position": 1,
    "text": "رمیده ازو مردم و چارپای"
  },
  {
    "poem_id": 1778,
    "vorder": 59,
    "position": 0,
    "text": "چو یک سال بگذشت و آمد بهار"
  },
  {
    "poem_id": 1778,
    "vorder": 60,
    "position": 1,
    "text": "بران ره به نخچیر شد شهریار"
  },
  {
    "poem_id": 1778,
    "vorder": 61,
    "position": 0,
    "text": "بران جای آباد خرم رسید"
  },
  {
    "poem_id": 1778,
    "vorder": 62,
    "position": 1,
    "text": "نگه کرد و بر جای بر ده ندید"
  },
  {
    "poem_id": 1778,
    "vorder": 63,
    "position": 0,
    "text": "درختان همه خشک و ویران‌سرای"
  },
  {
    "poem_id": 1778,
    "vorder": 64,
    "position": 1,
    "text": "همه مرز بی‌مردم و چارپای"
  },
  {
    "poem_id": 1778,
    "vorder": 65,
    "position": 0,
    "text": "دل شاه بهرام ناشاد گشت"
  },
  {
    "poem_id": 1778,
    "vorder": 66,
    "position": 1,
    "text": "ز یزدان بترسید و پر داد گشت"
  },
  {
    "poem_id": 1778,
    "vorder": 67,
    "position": 0,
    "text": "به موبد چنین گفت کای روزبه"
  },
  {
    "poem_id": 1778,
    "vorder": 68,
    "position": 1,
    "text": "دریغست ویران چنین خوب ده"
  },
  {
    "poem_id": 1778,
    "vorder": 69,
    "position": 0,
    "text": "برو تیز و آباد گردان به گنج"
  },
  {
    "poem_id": 1778,
    "vorder": 70,
    "position": 1,
    "text": "چنان کن کزین پس نبینند رنج"
  },
  {
    "poem_id": 1778,
    "vorder": 71,
    "position": 0,
    "text": "ز پیش شهنشاه موبد برفت"
  },
  {
    "poem_id": 1778,
    "vorder": 72,
    "position": 1,
    "text": "از آنجا به ویران خرامید تفت"
  },
  {
    "poem_id": 1778,
    "vorder": 73,
    "position": 0,
    "text": "ز برزن همی سوی برزن شتافت"
  },
  {
    "poem_id": 1778,
    "vorder": 74,
    "position": 1,
    "text": "به فرجام بیکار پیری بیافت"
  },
  {
    "poem_id": 1778,
    "vorder": 75,
    "position": 0,
    "text": "فرود آمد از باره بنواختش"
  },
  {
    "poem_id": 1778,
    "vorder": 76,
    "position": 1,
    "text": "بر خویش نزدیک بنشاختش"
  },
  {
    "poem_id": 1778,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت کای خواجهٔ سالخَورد"
  },
  {
    "poem_id": 1778,
    "vorder": 78,
    "position": 1,
    "text": "چنین جای آباد ویران که کرد"
  },
  {
    "poem_id": 1778,
    "vorder": 79,
    "position": 0,
    "text": "چنین داد پاسخ که یک روزگار"
  },
  {
    "poem_id": 1778,
    "vorder": 80,
    "position": 1,
    "text": "گذر کرد بر بوم ما شهریار"
  },
  {
    "poem_id": 1778,
    "vorder": 81,
    "position": 0,
    "text": "بیامد یکی بی‌خرد موبدی"
  },
  {
    "poem_id": 1778,
    "vorder": 82,
    "position": 1,
    "text": "ازان نامداران بی‌بر بدی"
  },
  {
    "poem_id": 1778,
    "vorder": 83,
    "position": 0,
    "text": "به ما گفت یکسر همه مهترید"
  },
  {
    "poem_id": 1778,
    "vorder": 84,
    "position": 1,
    "text": "نگر تا کسی را به کس نشمرید"
  },
  {
    "poem_id": 1778,
    "vorder": 85,
    "position": 0,
    "text": "بگفت این و این ده پرآشوب گشت"
  },
  {
    "poem_id": 1778,
    "vorder": 86,
    "position": 1,
    "text": "پر از غارت و کشتن و چوب گشت"
  },
  {
    "poem_id": 1778,
    "vorder": 87,
    "position": 0,
    "text": "که یزدان ورا یار به اندازه باد"
  },
  {
    "poem_id": 1778,
    "vorder": 88,
    "position": 1,
    "text": "غم و مرگ و سختی برو تازه باد"
  },
  {
    "poem_id": 1778,
    "vorder": 89,
    "position": 0,
    "text": "همه کار اینجا پر از تیرگیست"
  },
  {
    "poem_id": 1778,
    "vorder": 90,
    "position": 1,
    "text": "چنان شد که بر ما بباید گریست"
  },
  {
    "poem_id": 1778,
    "vorder": 91,
    "position": 0,
    "text": "ازین گفته پردرد شد روزبه"
  },
  {
    "poem_id": 1778,
    "vorder": 92,
    "position": 1,
    "text": "بپرسید و گفت از شما کیست مه"
  },
  {
    "poem_id": 1778,
    "vorder": 93,
    "position": 0,
    "text": "چنین داد پاسخ که مهتر بود"
  },
  {
    "poem_id": 1778,
    "vorder": 94,
    "position": 1,
    "text": "به جایی که تخم گیا بر بود"
  },
  {
    "poem_id": 1778,
    "vorder": 95,
    "position": 0,
    "text": "بدو روزبه گفت مهتر تو باش"
  },
  {
    "poem_id": 1778,
    "vorder": 96,
    "position": 1,
    "text": "بدین جای ویران به سر بر تو باش"
  },
  {
    "poem_id": 1778,
    "vorder": 97,
    "position": 0,
    "text": "ز گنج جهاندار دینار خواه"
  },
  {
    "poem_id": 1778,
    "vorder": 98,
    "position": 1,
    "text": "هم از تخم و گاو و خر و بار خواه"
  },
  {
    "poem_id": 1778,
    "vorder": 99,
    "position": 0,
    "text": "بکش هرک بیکار بینی به ده"
  },
  {
    "poem_id": 1778,
    "vorder": 100,
    "position": 1,
    "text": "همه کهترانند یکسر تو مه"
  },
  {
    "poem_id": 1778,
    "vorder": 101,
    "position": 0,
    "text": "بدان موبد پیش نفرین مکن"
  },
  {
    "poem_id": 1778,
    "vorder": 102,
    "position": 1,
    "text": "نه بر آرزو راند او این سُخُن"
  },
  {
    "poem_id": 1778,
    "vorder": 103,
    "position": 0,
    "text": "اگر یار خواهی ز درگاه شاه"
  },
  {
    "poem_id": 1778,
    "vorder": 104,
    "position": 1,
    "text": "فرستمت چندانک خواهی بخواه"
  },
  {
    "poem_id": 1778,
    "vorder": 105,
    "position": 0,
    "text": "چو بشنید پیر این سخن شاد شد"
  },
  {
    "poem_id": 1778,
    "vorder": 106,
    "position": 1,
    "text": "از اندوه دیرینه آزاد شد"
  },
  {
    "poem_id": 1778,
    "vorder": 107,
    "position": 0,
    "text": "هم‌انگه سوی خانه شد مرد پیر"
  },
  {
    "poem_id": 1778,
    "vorder": 108,
    "position": 1,
    "text": "بیاورد مردم سوی آبگیر"
  },
  {
    "poem_id": 1778,
    "vorder": 109,
    "position": 0,
    "text": "زمین را به آباد کردن گرفت"
  },
  {
    "poem_id": 1778,
    "vorder": 110,
    "position": 1,
    "text": "همه مرزها را سپردن گرفت"
  },
  {
    "poem_id": 1778,
    "vorder": 111,
    "position": 0,
    "text": "ز همسایگان گاو و خر خواستند"
  },
  {
    "poem_id": 1778,
    "vorder": 112,
    "position": 1,
    "text": "همه دشت یکسر بیاراستند"
  },
  {
    "poem_id": 1778,
    "vorder": 113,
    "position": 0,
    "text": "خود و مرزداران بکوشید سخت"
  },
  {
    "poem_id": 1778,
    "vorder": 114,
    "position": 1,
    "text": "بکِشتند هرجای چندی درخت"
  },
  {
    "poem_id": 1778,
    "vorder": 115,
    "position": 0,
    "text": "چو یک برزن نیک آباد شد"
  },
  {
    "poem_id": 1778,
    "vorder": 116,
    "position": 1,
    "text": "دل هرک دید اندران شاد شد"
  },
  {
    "poem_id": 1778,
    "vorder": 117,
    "position": 0,
    "text": "ازان جای هرکس که بگریختی"
  },
  {
    "poem_id": 1778,
    "vorder": 118,
    "position": 1,
    "text": "به مژگان همی خون فرو ریختی"
  },
  {
    "poem_id": 1778,
    "vorder": 119,
    "position": 0,
    "text": "چو آگاهی آمد ز آباد جای"
  },
  {
    "poem_id": 1778,
    "vorder": 120,
    "position": 1,
    "text": "هم از رنج این پیر سر کدخدای"
  },
  {
    "poem_id": 1778,
    "vorder": 121,
    "position": 0,
    "text": "یکایک سوی ده نهادند روی"
  },
  {
    "poem_id": 1778,
    "vorder": 122,
    "position": 1,
    "text": "به هر برزن آباد کردند جوی"
  },
  {
    "poem_id": 1778,
    "vorder": 123,
    "position": 0,
    "text": "همان مرغ و گاو و خر و گوسفند"
  },
  {
    "poem_id": 1778,
    "vorder": 124,
    "position": 1,
    "text": "یکایک برافزود بر کشتمند"
  },
  {
    "poem_id": 1778,
    "vorder": 125,
    "position": 0,
    "text": "درختی به هر جای هرکس بکشت"
  },
  {
    "poem_id": 1778,
    "vorder": 126,
    "position": 1,
    "text": "شد آن جای ویران چو خرم بهشت"
  },
  {
    "poem_id": 1778,
    "vorder": 127,
    "position": 0,
    "text": "به سالی سه دیگر بیاراست ده"
  },
  {
    "poem_id": 1778,
    "vorder": 128,
    "position": 1,
    "text": "برآمد ز ورزش همه کام مه"
  },
  {
    "poem_id": 1778,
    "vorder": 129,
    "position": 0,
    "text": "چو آمد به هنگام خرم بهار"
  },
  {
    "poem_id": 1778,
    "vorder": 130,
    "position": 1,
    "text": "سوی دشت نخچیر شد شهریار"
  },
  {
    "poem_id": 1778,
    "vorder": 131,
    "position": 0,
    "text": "ابا موبدش نام او روزبه"
  },
  {
    "poem_id": 1778,
    "vorder": 132,
    "position": 1,
    "text": "چو هر دو رسیدند نزدیک ده"
  },
  {
    "poem_id": 1778,
    "vorder": 133,
    "position": 0,
    "text": "نگه کرد فرخنده بهرام گور"
  },
  {
    "poem_id": 1778,
    "vorder": 134,
    "position": 1,
    "text": "جهان دید پر کشتمند و ستور"
  },
  {
    "poem_id": 1778,
    "vorder": 135,
    "position": 0,
    "text": "برآورده زو کاخهای بلند"
  },
  {
    "poem_id": 1778,
    "vorder": 136,
    "position": 1,
    "text": "همه راغ و هامون پر از گوسفند"
  },
  {
    "poem_id": 1778,
    "vorder": 137,
    "position": 0,
    "text": "همه راغ آب و همه دشت جوی"
  },
  {
    "poem_id": 1778,
    "vorder": 138,
    "position": 1,
    "text": "همه ده پر از مردم خوب‌روی"
  },
  {
    "poem_id": 1778,
    "vorder": 139,
    "position": 0,
    "text": "پراگنده بر کوه و دشتش بره"
  },
  {
    "poem_id": 1778,
    "vorder": 140,
    "position": 1,
    "text": "بهشتی شده بوم او یکسره"
  },
  {
    "poem_id": 1778,
    "vorder": 141,
    "position": 0,
    "text": "به موبد چنین گفت کای روزبه"
  },
  {
    "poem_id": 1778,
    "vorder": 142,
    "position": 1,
    "text": "چه کردی که ویران بد این خوب ده"
  },
  {
    "poem_id": 1778,
    "vorder": 143,
    "position": 0,
    "text": "پراگنده زو مردم و چارپای"
  },
  {
    "poem_id": 1778,
    "vorder": 144,
    "position": 1,
    "text": "چه دادی که آباد کردند جای"
  },
  {
    "poem_id": 1778,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت موبد که از یک سخن"
  },
  {
    "poem_id": 1778,
    "vorder": 146,
    "position": 1,
    "text": "به پای آمد این شارستان کهن"
  },
  {
    "poem_id": 1778,
    "vorder": 147,
    "position": 0,
    "text": "همان از یک اندیشه آباد شد"
  },
  {
    "poem_id": 1778,
    "vorder": 148,
    "position": 1,
    "text": "دل شاه ایران ازین شاد شد"
  },
  {
    "poem_id": 1778,
    "vorder": 149,
    "position": 0,
    "text": "مرا شاه فرمود کاین سبز جای"
  },
  {
    "poem_id": 1778,
    "vorder": 150,
    "position": 1,
    "text": "به دینار گنج اندر آور به پای"
  },
  {
    "poem_id": 1778,
    "vorder": 151,
    "position": 0,
    "text": "بترسیدم از کردگار جهان"
  },
  {
    "poem_id": 1778,
    "vorder": 152,
    "position": 1,
    "text": "نکوهیدن از کهتران و مهان"
  },
  {
    "poem_id": 1778,
    "vorder": 153,
    "position": 0,
    "text": "بدیدم چو یک دل دو اندیشه کرد"
  },
  {
    "poem_id": 1778,
    "vorder": 154,
    "position": 1,
    "text": "ز هر دو برآورد ناگاه گرد"
  },
  {
    "poem_id": 1778,
    "vorder": 155,
    "position": 0,
    "text": "همان چون به یک شهر دو کدخدای"
  },
  {
    "poem_id": 1778,
    "vorder": 156,
    "position": 1,
    "text": "بود بوم ایشان نماند به جای"
  },
  {
    "poem_id": 1778,
    "vorder": 157,
    "position": 0,
    "text": "برفتم بگفتم به پیران ده"
  },
  {
    "poem_id": 1778,
    "vorder": 158,
    "position": 1,
    "text": "که ای مهتران بر شما نیست مه"
  },
  {
    "poem_id": 1778,
    "vorder": 159,
    "position": 0,
    "text": "زنان کدخدایند و کودک همان"
  },
  {
    "poem_id": 1778,
    "vorder": 160,
    "position": 1,
    "text": "پرستار و مزدورتان این زمان"
  },
  {
    "poem_id": 1778,
    "vorder": 161,
    "position": 0,
    "text": "چو مهتر شدند آنک بودند که"
  },
  {
    "poem_id": 1778,
    "vorder": 162,
    "position": 1,
    "text": "به خاک اندر آمد سر مرد مه"
  },
  {
    "poem_id": 1778,
    "vorder": 163,
    "position": 0,
    "text": "به گفتار ویران شد این پاک جای"
  },
  {
    "poem_id": 1778,
    "vorder": 164,
    "position": 1,
    "text": "نکوهش ز من دور و ترس از خدای"
  },
  {
    "poem_id": 1778,
    "vorder": 165,
    "position": 0,
    "text": "ازان پس بریشان ببخشود شاه"
  },
  {
    "poem_id": 1778,
    "vorder": 166,
    "position": 1,
    "text": "برفتم نمودم دگرگونه راه"
  },
  {
    "poem_id": 1778,
    "vorder": 167,
    "position": 0,
    "text": "یکی با خرد پیر کردم به پای"
  },
  {
    "poem_id": 1778,
    "vorder": 168,
    "position": 1,
    "text": "سخن‌گوی و بادانش و رهنمای"
  },
  {
    "poem_id": 1778,
    "vorder": 169,
    "position": 0,
    "text": "بکوشید و ویرانی آباد کرد"
  },
  {
    "poem_id": 1778,
    "vorder": 170,
    "position": 1,
    "text": "دل زیردستان بدان شاد کرد"
  },
  {
    "poem_id": 1778,
    "vorder": 171,
    "position": 0,
    "text": "چو مهتر یکی گشت شد رای راست"
  },
  {
    "poem_id": 1778,
    "vorder": 172,
    "position": 1,
    "text": "بیفزود خوبی و کژی بکاست"
  },
  {
    "poem_id": 1778,
    "vorder": 173,
    "position": 0,
    "text": "نهانی بدیشان نمودم بدی"
  },
  {
    "poem_id": 1778,
    "vorder": 174,
    "position": 1,
    "text": "وزان پس گشادم در ایزدی"
  },
  {
    "poem_id": 1778,
    "vorder": 175,
    "position": 0,
    "text": "سخن بهتر از گوهر نامدار"
  },
  {
    "poem_id": 1778,
    "vorder": 176,
    "position": 1,
    "text": "چو بر جایگه بر برندش به کار"
  },
  {
    "poem_id": 1778,
    "vorder": 177,
    "position": 0,
    "text": "خرد شاه باید زبان پهلوان"
  },
  {
    "poem_id": 1778,
    "vorder": 178,
    "position": 1,
    "text": "چو خواهی که بی‌رنج ماند روان"
  },
  {
    "poem_id": 1778,
    "vorder": 179,
    "position": 0,
    "text": "دل شاه تا جاودان شاد باد"
  },
  {
    "poem_id": 1778,
    "vorder": 180,
    "position": 1,
    "text": "ز کژی و ویرانی آباد باد"
  },
  {
    "poem_id": 1778,
    "vorder": 181,
    "position": 0,
    "text": "چو بشنید شاه این سخن گفت زه"
  },
  {
    "poem_id": 1778,
    "vorder": 182,
    "position": 1,
    "text": "سزاوار تاجی تو ای روزبه"
  },
  {
    "poem_id": 1778,
    "vorder": 183,
    "position": 0,
    "text": "ببخشید یک بدره دینار زرد"
  },
  {
    "poem_id": 1778,
    "vorder": 184,
    "position": 1,
    "text": "بران پرهنر مرد بیننده مرد"
  },
  {
    "poem_id": 1778,
    "vorder": 185,
    "position": 0,
    "text": "ورا خلعت خسروی ساختند"
  },
  {
    "poem_id": 1778,
    "vorder": 186,
    "position": 1,
    "text": "سرش را به ابر اندر افراختند"
  }
]