[
  {
    "poem_id": 1585,
    "vorder": 1,
    "position": 0,
    "text": "ز رستم چو بشنید بهمن سخن"
  },
  {
    "poem_id": 1585,
    "vorder": 2,
    "position": 1,
    "text": "روان گشت با موبد پاک‌تن"
  },
  {
    "poem_id": 1585,
    "vorder": 3,
    "position": 0,
    "text": "تهمتن زمانی به ره در بماند"
  },
  {
    "poem_id": 1585,
    "vorder": 4,
    "position": 1,
    "text": "زواره فرامرز را پیش خواند"
  },
  {
    "poem_id": 1585,
    "vorder": 5,
    "position": 0,
    "text": "کز ایدر به نزدیک دستان شوید"
  },
  {
    "poem_id": 1585,
    "vorder": 6,
    "position": 1,
    "text": "به نزد مه کابلستان شوید"
  },
  {
    "poem_id": 1585,
    "vorder": 7,
    "position": 0,
    "text": "بگویید کاسفندیار آمدست"
  },
  {
    "poem_id": 1585,
    "vorder": 8,
    "position": 1,
    "text": "جهان را یکی خواستار آمدست"
  },
  {
    "poem_id": 1585,
    "vorder": 9,
    "position": 0,
    "text": "به ایوانها تخت زرین نهید"
  },
  {
    "poem_id": 1585,
    "vorder": 10,
    "position": 1,
    "text": "برو جامهٔ خسرو آیین نهید"
  },
  {
    "poem_id": 1585,
    "vorder": 11,
    "position": 0,
    "text": "چنان هم که هنگام کاوس شاه"
  },
  {
    "poem_id": 1585,
    "vorder": 12,
    "position": 1,
    "text": "ازان نیز پرمایه‌تر پایگاه"
  },
  {
    "poem_id": 1585,
    "vorder": 13,
    "position": 0,
    "text": "بسازید چیزی که باید خورش"
  },
  {
    "poem_id": 1585,
    "vorder": 14,
    "position": 1,
    "text": "خورشهای خوب از پی پرورش"
  },
  {
    "poem_id": 1585,
    "vorder": 15,
    "position": 0,
    "text": "که نزدیک ما پور شاه آمدست"
  },
  {
    "poem_id": 1585,
    "vorder": 16,
    "position": 1,
    "text": "پر از کینه و رزمخواه آمدست"
  },
  {
    "poem_id": 1585,
    "vorder": 17,
    "position": 0,
    "text": "گوی نامدارست و شاهی دلیر"
  },
  {
    "poem_id": 1585,
    "vorder": 18,
    "position": 1,
    "text": "نیندیشد از جنگ یک دشت شیر"
  },
  {
    "poem_id": 1585,
    "vorder": 19,
    "position": 0,
    "text": "شوم پیش او گر پذیرد نوید"
  },
  {
    "poem_id": 1585,
    "vorder": 20,
    "position": 1,
    "text": "به نیکی بود هرکسی را امید"
  },
  {
    "poem_id": 1585,
    "vorder": 21,
    "position": 0,
    "text": "اگر نیکویی بینم اندر سرش"
  },
  {
    "poem_id": 1585,
    "vorder": 22,
    "position": 1,
    "text": "ز یاقوت و زر آورم افسرش"
  },
  {
    "poem_id": 1585,
    "vorder": 23,
    "position": 0,
    "text": "ندارم ازو گنج و گوهر دریغ"
  },
  {
    "poem_id": 1585,
    "vorder": 24,
    "position": 1,
    "text": "نه برگستوان و نه گوپال و تیغ"
  },
  {
    "poem_id": 1585,
    "vorder": 25,
    "position": 0,
    "text": "وگر بازگرداندم ناامید"
  },
  {
    "poem_id": 1585,
    "vorder": 26,
    "position": 1,
    "text": "نباشد مرا روز با او سپید"
  },
  {
    "poem_id": 1585,
    "vorder": 27,
    "position": 0,
    "text": "تو دانی که آن تابداده کمند"
  },
  {
    "poem_id": 1585,
    "vorder": 28,
    "position": 1,
    "text": "سر ژنده پیل اندر آرد به بند"
  },
  {
    "poem_id": 1585,
    "vorder": 29,
    "position": 0,
    "text": "زواره بدو گفت مندیش ازین"
  },
  {
    "poem_id": 1585,
    "vorder": 30,
    "position": 1,
    "text": "نجوید کسی رزم کش نیست کین"
  },
  {
    "poem_id": 1585,
    "vorder": 31,
    "position": 0,
    "text": "ندانم به گیتی چو اسفندیار"
  },
  {
    "poem_id": 1585,
    "vorder": 32,
    "position": 1,
    "text": "برای و به مردی یکی نامدار"
  },
  {
    "poem_id": 1585,
    "vorder": 33,
    "position": 0,
    "text": "نیاید ز مرد خرد کار بد"
  },
  {
    "poem_id": 1585,
    "vorder": 34,
    "position": 1,
    "text": "ندید او ز ما هیچ کردار بد"
  },
  {
    "poem_id": 1585,
    "vorder": 35,
    "position": 0,
    "text": "زواره بیامد به نزدیک زال"
  },
  {
    "poem_id": 1585,
    "vorder": 36,
    "position": 1,
    "text": "وزان روی رستم برافراخت یال"
  },
  {
    "poem_id": 1585,
    "vorder": 37,
    "position": 0,
    "text": "بیامد دمان تا لب هیرمند"
  },
  {
    "poem_id": 1585,
    "vorder": 38,
    "position": 1,
    "text": "سرش تیز گشته ز بیم گزند"
  },
  {
    "poem_id": 1585,
    "vorder": 39,
    "position": 0,
    "text": "عنان را گران کرد بر پیش رود"
  },
  {
    "poem_id": 1585,
    "vorder": 40,
    "position": 1,
    "text": "همی بود تا بهمن آرد درود"
  },
  {
    "poem_id": 1585,
    "vorder": 41,
    "position": 0,
    "text": "چو بهمن بیامد به پرده‌سرای"
  },
  {
    "poem_id": 1585,
    "vorder": 42,
    "position": 1,
    "text": "همی بود پیش پدر بر به پای"
  },
  {
    "poem_id": 1585,
    "vorder": 43,
    "position": 0,
    "text": "بپرسید ازو فرخ اسفندیار"
  },
  {
    "poem_id": 1585,
    "vorder": 44,
    "position": 1,
    "text": "که پاسخ چه کرد آن یل نامدار"
  },
  {
    "poem_id": 1585,
    "vorder": 45,
    "position": 0,
    "text": "چو بشنید بنشست پیش پدر"
  },
  {
    "poem_id": 1585,
    "vorder": 46,
    "position": 1,
    "text": "بگفت آنچ بشنیده بد در بدر"
  },
  {
    "poem_id": 1585,
    "vorder": 47,
    "position": 0,
    "text": "نخستین درودش ز رستم بداد"
  },
  {
    "poem_id": 1585,
    "vorder": 48,
    "position": 1,
    "text": "پس‌انگاه گفتار او کرد یاد"
  },
  {
    "poem_id": 1585,
    "vorder": 49,
    "position": 0,
    "text": "همه دیده پیش پدر بازگفت"
  },
  {
    "poem_id": 1585,
    "vorder": 50,
    "position": 1,
    "text": "همان نیز نادیده اندر نهفت"
  },
  {
    "poem_id": 1585,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت چون رستم پیلتن"
  },
  {
    "poem_id": 1585,
    "vorder": 52,
    "position": 1,
    "text": "ندیده بود کس بهر انجمن"
  },
  {
    "poem_id": 1585,
    "vorder": 53,
    "position": 0,
    "text": "دل شیر دارد تن ژنده پیل"
  },
  {
    "poem_id": 1585,
    "vorder": 54,
    "position": 1,
    "text": "نهنگان برآرد ز دریای نیل"
  },
  {
    "poem_id": 1585,
    "vorder": 55,
    "position": 0,
    "text": "بیامد کنون تا لب هیرمند"
  },
  {
    "poem_id": 1585,
    "vorder": 56,
    "position": 1,
    "text": "ابی جوشن و خود و گرز و کمند"
  },
  {
    "poem_id": 1585,
    "vorder": 57,
    "position": 0,
    "text": "به دیدار شاه آمدستش نیاز"
  },
  {
    "poem_id": 1585,
    "vorder": 58,
    "position": 1,
    "text": "ندانم چه دارد همی با تو راز"
  },
  {
    "poem_id": 1585,
    "vorder": 59,
    "position": 0,
    "text": "ز بهمن برآشفت اسفندیار"
  },
  {
    "poem_id": 1585,
    "vorder": 60,
    "position": 1,
    "text": "ورا بر سر انجمن کرد خوار"
  },
  {
    "poem_id": 1585,
    "vorder": 61,
    "position": 0,
    "text": "بدو گفت کز مردم سرفراز"
  },
  {
    "poem_id": 1585,
    "vorder": 62,
    "position": 1,
    "text": "نزیبد که با زن نشیند به راز"
  },
  {
    "poem_id": 1585,
    "vorder": 63,
    "position": 0,
    "text": "وگر کودکان را بکاری بزرگ"
  },
  {
    "poem_id": 1585,
    "vorder": 64,
    "position": 1,
    "text": "فرستی نباشد دلیر و سترگ"
  },
  {
    "poem_id": 1585,
    "vorder": 65,
    "position": 0,
    "text": "تو گردنکشان را کجا دیده‌ای"
  },
  {
    "poem_id": 1585,
    "vorder": 66,
    "position": 1,
    "text": "که آواز روباه بشنیده‌ای"
  },
  {
    "poem_id": 1585,
    "vorder": 67,
    "position": 0,
    "text": "که رستم همی پیل جنگی کنی"
  },
  {
    "poem_id": 1585,
    "vorder": 68,
    "position": 1,
    "text": "دل نامور انجمن بشکنی"
  },
  {
    "poem_id": 1585,
    "vorder": 69,
    "position": 0,
    "text": "چنین گفت پس با پشوتن به راز"
  },
  {
    "poem_id": 1585,
    "vorder": 70,
    "position": 1,
    "text": "که این شیر رزم‌آور جنگ ساز"
  },
  {
    "poem_id": 1585,
    "vorder": 71,
    "position": 0,
    "text": "جوانی همی سازد از خویشتن"
  },
  {
    "poem_id": 1585,
    "vorder": 72,
    "position": 1,
    "text": "ز سالش همانا نیامد شکن"
  }
]