[
  {
    "poem_id": 87994,
    "vorder": 1,
    "position": 0,
    "text": "بپوشید رستم سلیح نبرد"
  },
  {
    "poem_id": 87994,
    "vorder": 2,
    "position": 1,
    "text": "به آوردگه رفت با داروبرد"
  },
  {
    "poem_id": 87994,
    "vorder": 3,
    "position": 0,
    "text": "زره زیر بد جوشن اندر میان"
  },
  {
    "poem_id": 87994,
    "vorder": 4,
    "position": 1,
    "text": "ازان پس بپوشید ببربیان"
  },
  {
    "poem_id": 87994,
    "vorder": 5,
    "position": 0,
    "text": "گرانمایه مغفر بسر بر نهاد"
  },
  {
    "poem_id": 87994,
    "vorder": 6,
    "position": 1,
    "text": "همی کرد بدخواهش از مرگ یاد"
  },
  {
    "poem_id": 87994,
    "vorder": 7,
    "position": 0,
    "text": "بنیروی یزدان میان را ببست"
  },
  {
    "poem_id": 87994,
    "vorder": 8,
    "position": 1,
    "text": "نشست از بر رخش چون پیل مست"
  },
  {
    "poem_id": 87994,
    "vorder": 9,
    "position": 0,
    "text": "ز بالای او آسمان خیره گشت"
  },
  {
    "poem_id": 87994,
    "vorder": 10,
    "position": 1,
    "text": "زمین از پی رخش او تیره گشت"
  },
  {
    "poem_id": 87994,
    "vorder": 11,
    "position": 0,
    "text": "برآمد ز هر دو سپه بوق و کوس"
  },
  {
    "poem_id": 87994,
    "vorder": 12,
    "position": 1,
    "text": "زمین آهنین شد سپهر آبنوس"
  },
  {
    "poem_id": 87994,
    "vorder": 13,
    "position": 0,
    "text": "جهان لرز لرزان شد و دشت و کوه"
  },
  {
    "poem_id": 87994,
    "vorder": 14,
    "position": 1,
    "text": "زمین شد ز نعل ستوران ستوه"
  },
  {
    "poem_id": 87994,
    "vorder": 15,
    "position": 0,
    "text": "وزین روی کاموس بر میمنه"
  },
  {
    "poem_id": 87994,
    "vorder": 16,
    "position": 1,
    "text": "پس پشت او ژنده پیل و بنه"
  },
  {
    "poem_id": 87994,
    "vorder": 17,
    "position": 0,
    "text": "ابر میسره لشکر آرای هند"
  },
  {
    "poem_id": 87994,
    "vorder": 18,
    "position": 1,
    "text": "زره‌دار با تیغ و هندی پرند"
  },
  {
    "poem_id": 87994,
    "vorder": 19,
    "position": 0,
    "text": "بقلب اندرون جای خاقان چین"
  },
  {
    "poem_id": 87994,
    "vorder": 20,
    "position": 1,
    "text": "شده آسمان تار و جنبان زمین"
  },
  {
    "poem_id": 87994,
    "vorder": 21,
    "position": 0,
    "text": "وزین رو فریبرز بر میسره"
  },
  {
    "poem_id": 87994,
    "vorder": 22,
    "position": 1,
    "text": "چو خورشید تابان ز برج بره"
  },
  {
    "poem_id": 87994,
    "vorder": 23,
    "position": 0,
    "text": "سوی میمنه پور کشواد بود"
  },
  {
    "poem_id": 87994,
    "vorder": 24,
    "position": 1,
    "text": "که کتفش همه زیر پولاد بود"
  },
  {
    "poem_id": 87994,
    "vorder": 25,
    "position": 0,
    "text": "بقلب اندرون طوس نوذر بپای"
  },
  {
    "poem_id": 87994,
    "vorder": 26,
    "position": 1,
    "text": "به پیش سپه کوس با کرنای"
  },
  {
    "poem_id": 87994,
    "vorder": 27,
    "position": 0,
    "text": "همی دود آتش برآمد ز آب"
  },
  {
    "poem_id": 87994,
    "vorder": 28,
    "position": 1,
    "text": "نبیند چنین رزم جنگی بخواب"
  },
  {
    "poem_id": 87994,
    "vorder": 29,
    "position": 0,
    "text": "برآمد ز هر سوی لشکر خروش"
  },
  {
    "poem_id": 87994,
    "vorder": 30,
    "position": 1,
    "text": "همی پیل را زان بدرید گوش"
  },
  {
    "poem_id": 87994,
    "vorder": 31,
    "position": 0,
    "text": "نخستین که آمد میان دو صف"
  },
  {
    "poem_id": 87994,
    "vorder": 32,
    "position": 1,
    "text": "ز خون جگر بر لب آورده کف"
  },
  {
    "poem_id": 87994,
    "vorder": 33,
    "position": 0,
    "text": "سپهبد سرافراز کاموس بود"
  },
  {
    "poem_id": 87994,
    "vorder": 34,
    "position": 1,
    "text": "که با لشکر و پیل و با کوس بود"
  },
  {
    "poem_id": 87994,
    "vorder": 35,
    "position": 0,
    "text": "همی برخروشید چون پیل مست"
  },
  {
    "poem_id": 87994,
    "vorder": 36,
    "position": 1,
    "text": "یکی گُرزهٔ گاو پیکر بدست"
  },
  {
    "poem_id": 87994,
    "vorder": 37,
    "position": 0,
    "text": "که آن جنگجوی پیاده کجاست"
  },
  {
    "poem_id": 87994,
    "vorder": 38,
    "position": 1,
    "text": "که از نامداران چنین رزم خواست"
  },
  {
    "poem_id": 87994,
    "vorder": 39,
    "position": 0,
    "text": "کنون گر بیاید به آوردگاه"
  },
  {
    "poem_id": 87994,
    "vorder": 40,
    "position": 1,
    "text": "تهی ماند از تیر او جایگاه"
  },
  {
    "poem_id": 87994,
    "vorder": 41,
    "position": 0,
    "text": "ورا دیده بودند گردان نیو"
  },
  {
    "poem_id": 87994,
    "vorder": 42,
    "position": 1,
    "text": "چو طوس سرافراز و رهام و گیو"
  },
  {
    "poem_id": 87994,
    "vorder": 43,
    "position": 0,
    "text": "کسی را نیامد همی رزم رای"
  },
  {
    "poem_id": 87994,
    "vorder": 44,
    "position": 1,
    "text": "ز گردان ایران تهی ماند جای"
  },
  {
    "poem_id": 87994,
    "vorder": 45,
    "position": 0,
    "text": "که با او کسی را نبد تاو جنگ"
  },
  {
    "poem_id": 87994,
    "vorder": 46,
    "position": 1,
    "text": "دلیران چو آهو و او چون پلنگ"
  },
  {
    "poem_id": 87994,
    "vorder": 47,
    "position": 0,
    "text": "یکی زابلی بود الوای نام"
  },
  {
    "poem_id": 87994,
    "vorder": 48,
    "position": 1,
    "text": "سبک تیغ کین برکشید از نیام"
  },
  {
    "poem_id": 87994,
    "vorder": 49,
    "position": 0,
    "text": "کجا نیزهٔ رستم او داشتی"
  },
  {
    "poem_id": 87994,
    "vorder": 50,
    "position": 1,
    "text": "پس پشت او هیچ نگذاشتی"
  },
  {
    "poem_id": 87994,
    "vorder": 51,
    "position": 0,
    "text": "بسی رنج برده بکار عنان"
  },
  {
    "poem_id": 87994,
    "vorder": 52,
    "position": 1,
    "text": "بیاموخته گُرز و تیر و سنان"
  },
  {
    "poem_id": 87994,
    "vorder": 53,
    "position": 0,
    "text": "برنج و بسختی جگر سوخته"
  },
  {
    "poem_id": 87994,
    "vorder": 54,
    "position": 1,
    "text": "ز رستم هنرها بیاموخته"
  },
  {
    "poem_id": 87994,
    "vorder": 55,
    "position": 0,
    "text": "بدو گفت رستم که بیدار باش"
  },
  {
    "poem_id": 87994,
    "vorder": 56,
    "position": 1,
    "text": "بآورد این ترک هشیار باش"
  },
  {
    "poem_id": 87994,
    "vorder": 57,
    "position": 0,
    "text": "مشو غرق ز آب هنرهای خویش"
  },
  {
    "poem_id": 87994,
    "vorder": 58,
    "position": 1,
    "text": "نگه‌دار بر جایگه پای خویش"
  },
  {
    "poem_id": 87994,
    "vorder": 59,
    "position": 0,
    "text": "چو قطره بر ژرف دریا بری"
  },
  {
    "poem_id": 87994,
    "vorder": 60,
    "position": 1,
    "text": "بدیوانگی ماند این داوری"
  },
  {
    "poem_id": 87994,
    "vorder": 61,
    "position": 0,
    "text": "شد الوای آهنگ کاموس کرد"
  },
  {
    "poem_id": 87994,
    "vorder": 62,
    "position": 1,
    "text": "که جوید بآورد با او نبرد"
  },
  {
    "poem_id": 87994,
    "vorder": 63,
    "position": 0,
    "text": "نهادند آوردگاهی بزرگ"
  },
  {
    "poem_id": 87994,
    "vorder": 64,
    "position": 1,
    "text": "کشانی بیامد بکردار گرگ"
  },
  {
    "poem_id": 87994,
    "vorder": 65,
    "position": 0,
    "text": "بزد نیزه و برگرفتش ز زین"
  },
  {
    "poem_id": 87994,
    "vorder": 66,
    "position": 1,
    "text": "بینداخت آسان بروی زمین"
  },
  {
    "poem_id": 87994,
    "vorder": 67,
    "position": 0,
    "text": "عنان را گران کرد و او را بنعل"
  },
  {
    "poem_id": 87994,
    "vorder": 68,
    "position": 1,
    "text": "همی کوفت تا خاک او کرد لعل"
  },
  {
    "poem_id": 87994,
    "vorder": 69,
    "position": 0,
    "text": "تهمتن ز الوای شد دردمند"
  },
  {
    "poem_id": 87994,
    "vorder": 70,
    "position": 1,
    "text": "ز فتراک بگشاد پیچان کمند"
  },
  {
    "poem_id": 87994,
    "vorder": 71,
    "position": 0,
    "text": "چو آهنگ جنگ سران داشتی"
  },
  {
    "poem_id": 87994,
    "vorder": 72,
    "position": 1,
    "text": "کمندی و گُرزی گران داشتی"
  },
  {
    "poem_id": 87994,
    "vorder": 73,
    "position": 0,
    "text": "بیامد بغرید چون پیل مست"
  },
  {
    "poem_id": 87994,
    "vorder": 74,
    "position": 1,
    "text": "کمندی به بازو و گُرزی به دست"
  },
  {
    "poem_id": 87994,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت کاموس چندین مدم"
  },
  {
    "poem_id": 87994,
    "vorder": 76,
    "position": 1,
    "text": "بنیروی این رشتهٔ شصت خم"
  },
  {
    "poem_id": 87994,
    "vorder": 77,
    "position": 0,
    "text": "چنین پاسخ آورد رستم که شیر"
  },
  {
    "poem_id": 87994,
    "vorder": 78,
    "position": 1,
    "text": "چو نخچیر بیند بغرد دلیر"
  },
  {
    "poem_id": 87994,
    "vorder": 79,
    "position": 0,
    "text": "نخستین برین کینه بستی کمر"
  },
  {
    "poem_id": 87994,
    "vorder": 80,
    "position": 1,
    "text": "ز ایران بکشتی یکی نامور"
  },
  {
    "poem_id": 87994,
    "vorder": 81,
    "position": 0,
    "text": "کنون رشته خوانی کمند مرا"
  },
  {
    "poem_id": 87994,
    "vorder": 82,
    "position": 1,
    "text": "ببینی همی تنگ و بند مرا"
  },
  {
    "poem_id": 87994,
    "vorder": 83,
    "position": 0,
    "text": "زمانه ترا از کشانی براند"
  },
  {
    "poem_id": 87994,
    "vorder": 84,
    "position": 1,
    "text": "چو ایدر بدت خاک جایت نماند"
  },
  {
    "poem_id": 87994,
    "vorder": 85,
    "position": 0,
    "text": "برانگیخت کاموس اسپ نبرد"
  },
  {
    "poem_id": 87994,
    "vorder": 86,
    "position": 1,
    "text": "هم آورد را دید با دارو برد"
  },
  {
    "poem_id": 87994,
    "vorder": 87,
    "position": 0,
    "text": "بینداخت تیغ پرند آورش"
  },
  {
    "poem_id": 87994,
    "vorder": 88,
    "position": 1,
    "text": "همی خواست از تن بریدن سرش"
  },
  {
    "poem_id": 87994,
    "vorder": 89,
    "position": 0,
    "text": "سر تیغ بر گردن رخش خورد"
  },
  {
    "poem_id": 87994,
    "vorder": 90,
    "position": 1,
    "text": "ببرید برگستوان نبرد"
  },
  {
    "poem_id": 87994,
    "vorder": 91,
    "position": 0,
    "text": "تن رخش را زان نیامد گزند"
  },
  {
    "poem_id": 87994,
    "vorder": 92,
    "position": 1,
    "text": "گو پیلتن حلقه کرد آن کمند"
  },
  {
    "poem_id": 87994,
    "vorder": 93,
    "position": 0,
    "text": "بینداخت و افگندش اندر میان"
  },
  {
    "poem_id": 87994,
    "vorder": 94,
    "position": 1,
    "text": "برانگیخت از جای پیل ژیان"
  },
  {
    "poem_id": 87994,
    "vorder": 95,
    "position": 0,
    "text": "بزین اندر آورد و کردش دوال"
  },
  {
    "poem_id": 87994,
    "vorder": 96,
    "position": 1,
    "text": "عقابی شده رخش با پر و بال"
  },
  {
    "poem_id": 87994,
    "vorder": 97,
    "position": 0,
    "text": "سوار از دلیری بیفشارد ران"
  },
  {
    "poem_id": 87994,
    "vorder": 98,
    "position": 1,
    "text": "گران شد رکیب و سبک شد عنان"
  },
  {
    "poem_id": 87994,
    "vorder": 99,
    "position": 0,
    "text": "همی خواست کان خم خام کمند"
  },
  {
    "poem_id": 87994,
    "vorder": 100,
    "position": 1,
    "text": "بنیرو ز هم بگسلاند ز بند"
  },
  {
    "poem_id": 87994,
    "vorder": 101,
    "position": 0,
    "text": "شد از هوش کاموس و نگسست خام"
  },
  {
    "poem_id": 87994,
    "vorder": 102,
    "position": 1,
    "text": "گو پیلتن رخش را کرد رام"
  },
  {
    "poem_id": 87994,
    "vorder": 103,
    "position": 0,
    "text": "عنان را بیچید و او را ز زین"
  },
  {
    "poem_id": 87994,
    "vorder": 104,
    "position": 1,
    "text": "نگون اندر آورد و زد بر زمین"
  },
  {
    "poem_id": 87994,
    "vorder": 105,
    "position": 0,
    "text": "بیامد ببستش بخم کمند"
  },
  {
    "poem_id": 87994,
    "vorder": 106,
    "position": 1,
    "text": "بدو گفت کاکنون شدی بی‌گزند"
  },
  {
    "poem_id": 87994,
    "vorder": 107,
    "position": 0,
    "text": "ز تو تنبل و جادوی دور گشت"
  },
  {
    "poem_id": 87994,
    "vorder": 108,
    "position": 1,
    "text": "روانت بر دیو مزدور گشت"
  },
  {
    "poem_id": 87994,
    "vorder": 109,
    "position": 0,
    "text": "سرآمد بتو بر همه روز کین"
  },
  {
    "poem_id": 87994,
    "vorder": 110,
    "position": 1,
    "text": "نبینی زمین کشانی و چین"
  },
  {
    "poem_id": 87994,
    "vorder": 111,
    "position": 0,
    "text": "گمان تو آن بد که هنگام جنگ"
  },
  {
    "poem_id": 87994,
    "vorder": 112,
    "position": 1,
    "text": "کسی چون تو نگرفت خنجر بچنگ"
  },
  {
    "poem_id": 87994,
    "vorder": 113,
    "position": 0,
    "text": "مبادا که کین آورد سرفراز"
  },
  {
    "poem_id": 87994,
    "vorder": 114,
    "position": 1,
    "text": "که بس زود بیند نشیب و فراز"
  },
  {
    "poem_id": 87994,
    "vorder": 115,
    "position": 0,
    "text": "دو دست از پس پشت بستش چو سنگ"
  },
  {
    "poem_id": 87994,
    "vorder": 116,
    "position": 1,
    "text": "بخم کمند اندر آورد چنگ"
  },
  {
    "poem_id": 87994,
    "vorder": 117,
    "position": 0,
    "text": "بیامد خرامان بایران سپاه"
  },
  {
    "poem_id": 87994,
    "vorder": 118,
    "position": 1,
    "text": "بزیر کش اندر تن کینه‌خواه"
  },
  {
    "poem_id": 87994,
    "vorder": 119,
    "position": 0,
    "text": "بگردان چنین گفت کین رزمجوی"
  },
  {
    "poem_id": 87994,
    "vorder": 120,
    "position": 1,
    "text": "ز بس زور و کین اندر آمد بروی"
  },
  {
    "poem_id": 87994,
    "vorder": 121,
    "position": 0,
    "text": "چنین است رسم سرای فریب"
  },
  {
    "poem_id": 87994,
    "vorder": 122,
    "position": 1,
    "text": "گهی در فراز و گهی در نشیب"
  },
  {
    "poem_id": 87994,
    "vorder": 123,
    "position": 0,
    "text": "بایران همی شد که ویران کند"
  },
  {
    "poem_id": 87994,
    "vorder": 124,
    "position": 1,
    "text": "کنام پلنگان و شیران کند"
  },
  {
    "poem_id": 87994,
    "vorder": 125,
    "position": 0,
    "text": "به زابلستان و به کابلستان"
  },
  {
    "poem_id": 87994,
    "vorder": 126,
    "position": 1,
    "text": "نه ایوان بود نیز و نه گلستان"
  },
  {
    "poem_id": 87994,
    "vorder": 127,
    "position": 0,
    "text": "نیندازد از دست گوپال را"
  },
  {
    "poem_id": 87994,
    "vorder": 128,
    "position": 1,
    "text": "مگر گم کند رستم زال را"
  },
  {
    "poem_id": 87994,
    "vorder": 129,
    "position": 0,
    "text": "کفن شد کنون مغفر و جوشنش"
  },
  {
    "poem_id": 87994,
    "vorder": 130,
    "position": 1,
    "text": "ز خاک افسر و گرد پیراهنش"
  },
  {
    "poem_id": 87994,
    "vorder": 131,
    "position": 0,
    "text": "شما را بکشتن چگونست رای"
  },
  {
    "poem_id": 87994,
    "vorder": 132,
    "position": 1,
    "text": "که شد کار کاموس جنگی ز پای"
  },
  {
    "poem_id": 87994,
    "vorder": 133,
    "position": 0,
    "text": "بیفگند بر خاک پیش سران"
  },
  {
    "poem_id": 87994,
    "vorder": 134,
    "position": 1,
    "text": "ز لشکر برفتند کنداوران"
  },
  {
    "poem_id": 87994,
    "vorder": 135,
    "position": 0,
    "text": "تنش را بشمشیر کردند چاک"
  },
  {
    "poem_id": 87994,
    "vorder": 136,
    "position": 1,
    "text": "بخون غرقه شد زیر او سنگ و خاک"
  },
  {
    "poem_id": 87994,
    "vorder": 137,
    "position": 0,
    "text": "بمردی نباید شد اندر گمان"
  },
  {
    "poem_id": 87994,
    "vorder": 138,
    "position": 1,
    "text": "که بر تو درازست دست زمان"
  },
  {
    "poem_id": 87994,
    "vorder": 139,
    "position": 0,
    "text": "بپایان شد این رزم کاموس گرد"
  },
  {
    "poem_id": 87994,
    "vorder": 140,
    "position": 1,
    "text": "همی شد که جان آورد جان ببرد"
  }
]