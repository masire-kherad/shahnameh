[
  {
    "poem_id": 1896,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس چو گسترده شد دست شاه"
  },
  {
    "poem_id": 1896,
    "vorder": 2,
    "position": 1,
    "text": "سراسر جهان شد ورا نیک خواه"
  },
  {
    "poem_id": 1896,
    "vorder": 3,
    "position": 0,
    "text": "همه تاجدارانش کهتر شدند"
  },
  {
    "poem_id": 1896,
    "vorder": 4,
    "position": 1,
    "text": "همه کهتران زو توانگر شدند"
  },
  {
    "poem_id": 1896,
    "vorder": 5,
    "position": 0,
    "text": "گزین کرد از ایران چل و هشت هزار"
  },
  {
    "poem_id": 1896,
    "vorder": 6,
    "position": 1,
    "text": "جهاندیده گردان و جنگی سوار"
  },
  {
    "poem_id": 1896,
    "vorder": 7,
    "position": 0,
    "text": "در گنج های کهن برگشاد"
  },
  {
    "poem_id": 1896,
    "vorder": 8,
    "position": 1,
    "text": "که بنهاد پیروز و فرخ قباد"
  },
  {
    "poem_id": 1896,
    "vorder": 9,
    "position": 0,
    "text": "جهان را ببخشید بر چار بهر"
  },
  {
    "poem_id": 1896,
    "vorder": 10,
    "position": 1,
    "text": "یکایک همه نامزد کرد شهر"
  },
  {
    "poem_id": 1896,
    "vorder": 11,
    "position": 0,
    "text": "از آن نامداران ده و دو هزار"
  },
  {
    "poem_id": 1896,
    "vorder": 12,
    "position": 1,
    "text": "گزین کرد ز ایران و نیران سوار"
  },
  {
    "poem_id": 1896,
    "vorder": 13,
    "position": 0,
    "text": "فرستاد خسرو سوی مرز روم"
  },
  {
    "poem_id": 1896,
    "vorder": 14,
    "position": 1,
    "text": "نگهبان آن فرخ آزاد بوم"
  },
  {
    "poem_id": 1896,
    "vorder": 15,
    "position": 0,
    "text": "بدان تا ز روم اندر ایران سپاه"
  },
  {
    "poem_id": 1896,
    "vorder": 16,
    "position": 1,
    "text": "نیاید که کشور شود زو تباه"
  },
  {
    "poem_id": 1896,
    "vorder": 17,
    "position": 0,
    "text": "مگر هرکسی برکند مرز خویش"
  },
  {
    "poem_id": 1896,
    "vorder": 18,
    "position": 1,
    "text": "بداند سر مایه و ارز خویش"
  },
  {
    "poem_id": 1896,
    "vorder": 19,
    "position": 0,
    "text": "هم از نامداران ده و دو هزار"
  },
  {
    "poem_id": 1896,
    "vorder": 20,
    "position": 1,
    "text": "سواران هشیار خنجرگزار"
  },
  {
    "poem_id": 1896,
    "vorder": 21,
    "position": 0,
    "text": "بدان تا سوی زابلستان شوند"
  },
  {
    "poem_id": 1896,
    "vorder": 22,
    "position": 1,
    "text": "ز بوم سیه در گلستان شوند"
  },
  {
    "poem_id": 1896,
    "vorder": 23,
    "position": 0,
    "text": "بدیشان چنین گفت هرکو ز راه"
  },
  {
    "poem_id": 1896,
    "vorder": 24,
    "position": 1,
    "text": "بگردد ندارد زبان را نگاه"
  },
  {
    "poem_id": 1896,
    "vorder": 25,
    "position": 0,
    "text": "به خوبی مر او را به راه آورید"
  },
  {
    "poem_id": 1896,
    "vorder": 26,
    "position": 1,
    "text": "کزین بگذرد بند و چاه آورید"
  },
  {
    "poem_id": 1896,
    "vorder": 27,
    "position": 0,
    "text": "به هرسو فرستید کارآگهان"
  },
  {
    "poem_id": 1896,
    "vorder": 28,
    "position": 1,
    "text": "بدان تا نماند سخن در نهان"
  },
  {
    "poem_id": 1896,
    "vorder": 29,
    "position": 0,
    "text": "طلایه بباید به روز و شبان"
  },
  {
    "poem_id": 1896,
    "vorder": 30,
    "position": 1,
    "text": "مخسپید در خیمه بی‌پاسبان"
  },
  {
    "poem_id": 1896,
    "vorder": 31,
    "position": 0,
    "text": "ز لشکر ده و دو هزار دگر"
  },
  {
    "poem_id": 1896,
    "vorder": 32,
    "position": 1,
    "text": "دلاور سواران پرخاشخر"
  },
  {
    "poem_id": 1896,
    "vorder": 33,
    "position": 0,
    "text": "بخواند و بسی هدیه‌ها دادشان"
  },
  {
    "poem_id": 1896,
    "vorder": 34,
    "position": 1,
    "text": "به راه الانان فرستادشان"
  },
  {
    "poem_id": 1896,
    "vorder": 35,
    "position": 0,
    "text": "بدیشان سپرد آن در باختر"
  },
  {
    "poem_id": 1896,
    "vorder": 36,
    "position": 1,
    "text": "بدان تا نیاید ز دشمن گذر"
  },
  {
    "poem_id": 1896,
    "vorder": 37,
    "position": 0,
    "text": "بدان سرکشان گفت بیدار بید"
  },
  {
    "poem_id": 1896,
    "vorder": 38,
    "position": 1,
    "text": "همه در پناه جهاندار بید"
  },
  {
    "poem_id": 1896,
    "vorder": 39,
    "position": 0,
    "text": "ده ودو هزار دگر برگزید"
  },
  {
    "poem_id": 1896,
    "vorder": 40,
    "position": 1,
    "text": "ز مردان جنگی چنان چون سزید"
  },
  {
    "poem_id": 1896,
    "vorder": 41,
    "position": 0,
    "text": "به سوی خراسان فرستادشان"
  },
  {
    "poem_id": 1896,
    "vorder": 42,
    "position": 1,
    "text": "بسی پند و اندرزها دادشان"
  },
  {
    "poem_id": 1896,
    "vorder": 43,
    "position": 0,
    "text": "که از مرز هیتال تا مرزچین"
  },
  {
    "poem_id": 1896,
    "vorder": 44,
    "position": 1,
    "text": "نباید که کس پی نهد بر زمین"
  },
  {
    "poem_id": 1896,
    "vorder": 45,
    "position": 0,
    "text": "مگر به آگهی و بفرمان ما"
  },
  {
    "poem_id": 1896,
    "vorder": 46,
    "position": 1,
    "text": "روان بسته دارد به پیمان ما"
  },
  {
    "poem_id": 1896,
    "vorder": 47,
    "position": 0,
    "text": "بهر کشوری گنج آگنده هست"
  },
  {
    "poem_id": 1896,
    "vorder": 48,
    "position": 1,
    "text": "که کس را نباید شدن دوردست"
  },
  {
    "poem_id": 1896,
    "vorder": 49,
    "position": 0,
    "text": "چو باید بخواهید و خرم بوید"
  },
  {
    "poem_id": 1896,
    "vorder": 50,
    "position": 1,
    "text": "خردمند باشید و بی غم بوید"
  },
  {
    "poem_id": 1896,
    "vorder": 51,
    "position": 0,
    "text": "در گنج بگشاد و چندی درم"
  },
  {
    "poem_id": 1896,
    "vorder": 52,
    "position": 1,
    "text": "که بودی ز هرمز برو بر رقم"
  },
  {
    "poem_id": 1896,
    "vorder": 53,
    "position": 0,
    "text": "بیاورد و گریان به درویش داد"
  },
  {
    "poem_id": 1896,
    "vorder": 54,
    "position": 1,
    "text": "چو درویش پیوسته بد بیش داد"
  },
  {
    "poem_id": 1896,
    "vorder": 55,
    "position": 0,
    "text": "از آنکس که او یار بندوی بود"
  },
  {
    "poem_id": 1896,
    "vorder": 56,
    "position": 1,
    "text": "به نزدیک گستهم و زنگوی بود"
  },
  {
    "poem_id": 1896,
    "vorder": 57,
    "position": 0,
    "text": "که بودند یازان به خون پدر"
  },
  {
    "poem_id": 1896,
    "vorder": 58,
    "position": 1,
    "text": "ز تنهای ایشان جدا کرد سر"
  },
  {
    "poem_id": 1896,
    "vorder": 59,
    "position": 0,
    "text": "چو از کین و نفرین به پردخت شاه"
  },
  {
    "poem_id": 1896,
    "vorder": 60,
    "position": 1,
    "text": "بدانش یکی دیگر آورد راه"
  },
  {
    "poem_id": 1896,
    "vorder": 61,
    "position": 0,
    "text": "از آن پس شب و روز گردنده دهر"
  },
  {
    "poem_id": 1896,
    "vorder": 62,
    "position": 1,
    "text": "نشست و ببخشید بر چار بهر"
  },
  {
    "poem_id": 1896,
    "vorder": 63,
    "position": 0,
    "text": "از آن چار یک بهر موبد نهاد"
  },
  {
    "poem_id": 1896,
    "vorder": 64,
    "position": 1,
    "text": "که دارد سخنهای نیکو بیاد"
  },
  {
    "poem_id": 1896,
    "vorder": 65,
    "position": 0,
    "text": "ز کار سپاه و ز کار جهان"
  },
  {
    "poem_id": 1896,
    "vorder": 66,
    "position": 1,
    "text": "به گفتی به شاه آشکار و نهان"
  },
  {
    "poem_id": 1896,
    "vorder": 67,
    "position": 0,
    "text": "چو در پادشاهی به دیدی شکست"
  },
  {
    "poem_id": 1896,
    "vorder": 68,
    "position": 1,
    "text": "ز لشکر گر از مردم زیر دست"
  },
  {
    "poem_id": 1896,
    "vorder": 69,
    "position": 0,
    "text": "سبک دامن داد بر تافتی"
  },
  {
    "poem_id": 1896,
    "vorder": 70,
    "position": 1,
    "text": "گذشته بجستی و دریافتی"
  },
  {
    "poem_id": 1896,
    "vorder": 71,
    "position": 0,
    "text": "دگر بهر شادی و رامشگران"
  },
  {
    "poem_id": 1896,
    "vorder": 72,
    "position": 1,
    "text": "نشسته به آرام با مهتران"
  },
  {
    "poem_id": 1896,
    "vorder": 73,
    "position": 0,
    "text": "نبودی نه اندیشه کردی ز بد"
  },
  {
    "poem_id": 1896,
    "vorder": 74,
    "position": 1,
    "text": "چنان کز ره نامداران سزد"
  },
  {
    "poem_id": 1896,
    "vorder": 75,
    "position": 0,
    "text": "سیم بهره گاه نیایش بدی"
  },
  {
    "poem_id": 1896,
    "vorder": 76,
    "position": 1,
    "text": "جهان آفرین را ستایش بدی"
  },
  {
    "poem_id": 1896,
    "vorder": 77,
    "position": 0,
    "text": "چهارم شمار سپهر بلند"
  },
  {
    "poem_id": 1896,
    "vorder": 78,
    "position": 1,
    "text": "همی بر گرفتی چه و چون و چند"
  },
  {
    "poem_id": 1896,
    "vorder": 79,
    "position": 0,
    "text": "ستاره شمر پیش او بر بپای"
  },
  {
    "poem_id": 1896,
    "vorder": 80,
    "position": 1,
    "text": "که بودی به دانش ورا رهنمای"
  },
  {
    "poem_id": 1896,
    "vorder": 81,
    "position": 0,
    "text": "وزین بهره نیمی شب دیر یاز"
  },
  {
    "poem_id": 1896,
    "vorder": 82,
    "position": 1,
    "text": "نشستی همی با بتان طراز"
  },
  {
    "poem_id": 1896,
    "vorder": 83,
    "position": 0,
    "text": "همان نیز یک ماه بر چار بهر"
  },
  {
    "poem_id": 1896,
    "vorder": 84,
    "position": 1,
    "text": "ببخشید تا شاد باشد ز دهر"
  },
  {
    "poem_id": 1896,
    "vorder": 85,
    "position": 0,
    "text": "یکی بهره میدان چوگان و تیر"
  },
  {
    "poem_id": 1896,
    "vorder": 86,
    "position": 1,
    "text": "یکی نامور پیش او یادگیر"
  },
  {
    "poem_id": 1896,
    "vorder": 87,
    "position": 0,
    "text": "دگر بهره زو کوه و دشت شکار"
  },
  {
    "poem_id": 1896,
    "vorder": 88,
    "position": 1,
    "text": "ازان تازه گشتی ورا روزگار"
  },
  {
    "poem_id": 1896,
    "vorder": 89,
    "position": 0,
    "text": "هر آنگه که گشتی ز نخچیر باز"
  },
  {
    "poem_id": 1896,
    "vorder": 90,
    "position": 1,
    "text": "به رخشنده روز و شب دیر یاز"
  },
  {
    "poem_id": 1896,
    "vorder": 91,
    "position": 0,
    "text": "هر آنکس که بودی و را پیش گاه"
  },
  {
    "poem_id": 1896,
    "vorder": 92,
    "position": 1,
    "text": "ببستی به شهر اندر آیین و راه"
  },
  {
    "poem_id": 1896,
    "vorder": 93,
    "position": 0,
    "text": "دگر بهره شطرنج بودی و نرد"
  },
  {
    "poem_id": 1896,
    "vorder": 94,
    "position": 1,
    "text": "سخن گفت از روزگار نبرد"
  },
  {
    "poem_id": 1896,
    "vorder": 95,
    "position": 0,
    "text": "سه دیگر هر آنکس که داننده بود"
  },
  {
    "poem_id": 1896,
    "vorder": 96,
    "position": 1,
    "text": "فزایندهٔ چیز و خواننده بود"
  },
  {
    "poem_id": 1896,
    "vorder": 97,
    "position": 0,
    "text": "به نوبت و را پیش بنشاندی"
  },
  {
    "poem_id": 1896,
    "vorder": 98,
    "position": 1,
    "text": "سخنهای دیرینه برخواندی"
  },
  {
    "poem_id": 1896,
    "vorder": 99,
    "position": 0,
    "text": "چهارم فرستادگان را ز راه"
  },
  {
    "poem_id": 1896,
    "vorder": 100,
    "position": 1,
    "text": "همی‌خواندندی به نزدیک شاه"
  },
  {
    "poem_id": 1896,
    "vorder": 101,
    "position": 0,
    "text": "نوشتی همه پاسخ نامه باز"
  },
  {
    "poem_id": 1896,
    "vorder": 102,
    "position": 1,
    "text": "بدادی بدان مرد گردن فراز"
  },
  {
    "poem_id": 1896,
    "vorder": 103,
    "position": 0,
    "text": "فرستاده با خلعت و کام خویش"
  },
  {
    "poem_id": 1896,
    "vorder": 104,
    "position": 1,
    "text": "ز در بازگشتی به آرام خویش"
  },
  {
    "poem_id": 1896,
    "vorder": 105,
    "position": 0,
    "text": "همه روز منشور هر کشوری"
  },
  {
    "poem_id": 1896,
    "vorder": 106,
    "position": 1,
    "text": "نوشتی سپردی بهر مهتری"
  },
  {
    "poem_id": 1896,
    "vorder": 107,
    "position": 0,
    "text": "چو بودی سر سال نو فرودین"
  },
  {
    "poem_id": 1896,
    "vorder": 108,
    "position": 1,
    "text": "که رخشان شدی در دل از هور دین"
  },
  {
    "poem_id": 1896,
    "vorder": 109,
    "position": 0,
    "text": "نهادی یکی گنج خسرو نهان"
  },
  {
    "poem_id": 1896,
    "vorder": 110,
    "position": 1,
    "text": "که نشناختی کهتری در جهان"
  }
]