[
  {
    "poem_id": 87969,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تابنده بنمود چهر"
  },
  {
    "poem_id": 87969,
    "vorder": 2,
    "position": 1,
    "text": "خرامان برآمد بخم سپهر"
  },
  {
    "poem_id": 87969,
    "vorder": 3,
    "position": 0,
    "text": "ز هر سو برآمد خروش سران"
  },
  {
    "poem_id": 87969,
    "vorder": 4,
    "position": 1,
    "text": "گراییدن گرزهای گران"
  },
  {
    "poem_id": 87969,
    "vorder": 5,
    "position": 0,
    "text": "غو کوس با نالهٔ کرنای"
  },
  {
    "poem_id": 87969,
    "vorder": 6,
    "position": 1,
    "text": "دم نای سرغین و هندی درای"
  },
  {
    "poem_id": 87969,
    "vorder": 7,
    "position": 0,
    "text": "برون آمد از بارهٔ دژ فرود"
  },
  {
    "poem_id": 87969,
    "vorder": 8,
    "position": 1,
    "text": "دلیران ترکان هرآنکس که بود"
  },
  {
    "poem_id": 87969,
    "vorder": 9,
    "position": 0,
    "text": "ز گرد سواران و ز گرز و تیر"
  },
  {
    "poem_id": 87969,
    "vorder": 10,
    "position": 1,
    "text": "سر کوه شد همچو دریای قیر"
  },
  {
    "poem_id": 87969,
    "vorder": 11,
    "position": 0,
    "text": "نبد هیچ هامون و جای نبرد"
  },
  {
    "poem_id": 87969,
    "vorder": 12,
    "position": 1,
    "text": "همی کوه و سنگ اسپ را خیره کرد"
  },
  {
    "poem_id": 87969,
    "vorder": 13,
    "position": 0,
    "text": "ازین گونه تا گشت خورشید راست"
  },
  {
    "poem_id": 87969,
    "vorder": 14,
    "position": 1,
    "text": "سپاه فرود دلاور بکاست"
  },
  {
    "poem_id": 87969,
    "vorder": 15,
    "position": 0,
    "text": "فراز و نشیبش همه کشته شد"
  },
  {
    "poem_id": 87969,
    "vorder": 16,
    "position": 1,
    "text": "سربخت مرد جوان گشته شد"
  },
  {
    "poem_id": 87969,
    "vorder": 17,
    "position": 0,
    "text": "بدو خیره ماندند ایرانیان"
  },
  {
    "poem_id": 87969,
    "vorder": 18,
    "position": 1,
    "text": "که چون او ندیدند شیر ژیان"
  },
  {
    "poem_id": 87969,
    "vorder": 19,
    "position": 0,
    "text": "ز ترکان نماند ایچ با او سوار"
  },
  {
    "poem_id": 87969,
    "vorder": 20,
    "position": 1,
    "text": "ندید ایچ تنها رخ کارزار"
  },
  {
    "poem_id": 87969,
    "vorder": 21,
    "position": 0,
    "text": "عنان را بپیچید و تنها برفت"
  },
  {
    "poem_id": 87969,
    "vorder": 22,
    "position": 1,
    "text": "ز بالا سوی دژ خرامید تفت"
  },
  {
    "poem_id": 87969,
    "vorder": 23,
    "position": 0,
    "text": "چو رهام و بیژن کمین ساختند"
  },
  {
    "poem_id": 87969,
    "vorder": 24,
    "position": 1,
    "text": "فراز و نشیبش همی تاختند"
  },
  {
    "poem_id": 87969,
    "vorder": 25,
    "position": 0,
    "text": "چو بیژن پدید آمد اندر نشیب"
  },
  {
    "poem_id": 87969,
    "vorder": 26,
    "position": 1,
    "text": "سبک شد عنان و گران شد رکیب"
  },
  {
    "poem_id": 87969,
    "vorder": 27,
    "position": 0,
    "text": "فرود جوان ترگ بیژن بدید"
  },
  {
    "poem_id": 87969,
    "vorder": 28,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 87969,
    "vorder": 29,
    "position": 0,
    "text": "چو رهام گرد اندر آمد به پشت"
  },
  {
    "poem_id": 87969,
    "vorder": 30,
    "position": 1,
    "text": "خروشان یکی تیغ هندی به مشت"
  },
  {
    "poem_id": 87969,
    "vorder": 31,
    "position": 0,
    "text": "بزد بر سر کتف مرد دلیر"
  },
  {
    "poem_id": 87969,
    "vorder": 32,
    "position": 1,
    "text": "فرود آمد از دوش دستش به زیر"
  },
  {
    "poem_id": 87969,
    "vorder": 33,
    "position": 0,
    "text": "چو از وی جدا گشت بازوی و دوش"
  },
  {
    "poem_id": 87969,
    "vorder": 34,
    "position": 1,
    "text": "همی تاخت اسپ و همی زد خروش"
  },
  {
    "poem_id": 87969,
    "vorder": 35,
    "position": 0,
    "text": "بنزدیک دژ بیژن اندر رسید"
  },
  {
    "poem_id": 87969,
    "vorder": 36,
    "position": 1,
    "text": "بزخمی پی بارهٔ او برید"
  },
  {
    "poem_id": 87969,
    "vorder": 37,
    "position": 0,
    "text": "پیاده خود و چند زان چاکران"
  },
  {
    "poem_id": 87969,
    "vorder": 38,
    "position": 1,
    "text": "تبه گشته از چنگ کنداوران"
  },
  {
    "poem_id": 87969,
    "vorder": 39,
    "position": 0,
    "text": "بدژ در شد و در ببستند زود"
  },
  {
    "poem_id": 87969,
    "vorder": 40,
    "position": 1,
    "text": "شد آن نامور شیر جنگی فرود"
  },
  {
    "poem_id": 87969,
    "vorder": 41,
    "position": 0,
    "text": "بشد با پرستندگان مادرش"
  },
  {
    "poem_id": 87969,
    "vorder": 42,
    "position": 1,
    "text": "گرفتند پوشیدگان در برش"
  },
  {
    "poem_id": 87969,
    "vorder": 43,
    "position": 0,
    "text": "بزاری فگندند بر تخت عاج"
  },
  {
    "poem_id": 87969,
    "vorder": 44,
    "position": 1,
    "text": "نبد شاه را روز هنگام تاج"
  },
  {
    "poem_id": 87969,
    "vorder": 45,
    "position": 0,
    "text": "همه غالیه موی و مشکین کمند"
  },
  {
    "poem_id": 87969,
    "vorder": 46,
    "position": 1,
    "text": "پرستنده و مادر از بن بکند"
  },
  {
    "poem_id": 87969,
    "vorder": 47,
    "position": 0,
    "text": "همی کند جان آن گرامی فرود"
  },
  {
    "poem_id": 87969,
    "vorder": 48,
    "position": 1,
    "text": "همه تخت مویه همه حصن رود"
  },
  {
    "poem_id": 87969,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت چون لب ز هم برگرفت"
  },
  {
    "poem_id": 87969,
    "vorder": 50,
    "position": 1,
    "text": "که این موی کندن نباشد شگفت"
  },
  {
    "poem_id": 87969,
    "vorder": 51,
    "position": 0,
    "text": "کنون اندر آیند ایرانیان"
  },
  {
    "poem_id": 87969,
    "vorder": 52,
    "position": 1,
    "text": "به تاراج دژ پاک بسته میان"
  },
  {
    "poem_id": 87969,
    "vorder": 53,
    "position": 0,
    "text": "پرستندگان را اسیران کنند"
  },
  {
    "poem_id": 87969,
    "vorder": 54,
    "position": 1,
    "text": "دژ وباره کوه ویران کنند"
  },
  {
    "poem_id": 87969,
    "vorder": 55,
    "position": 0,
    "text": "دل هرک بر من بسوزد همی"
  },
  {
    "poem_id": 87969,
    "vorder": 56,
    "position": 1,
    "text": "ز جانم رخش برفروزد همی"
  },
  {
    "poem_id": 87969,
    "vorder": 57,
    "position": 0,
    "text": "همه پاک بر باره باید شدن"
  },
  {
    "poem_id": 87969,
    "vorder": 58,
    "position": 1,
    "text": "تن خویش را بر زمین بر زدن"
  },
  {
    "poem_id": 87969,
    "vorder": 59,
    "position": 0,
    "text": "کجا بهر بیژن نماند یکی"
  },
  {
    "poem_id": 87969,
    "vorder": 60,
    "position": 1,
    "text": "نمانم من ایدر مگر اندکی"
  },
  {
    "poem_id": 87969,
    "vorder": 61,
    "position": 0,
    "text": "کشنده تن و جان من درد اوست"
  },
  {
    "poem_id": 87969,
    "vorder": 62,
    "position": 1,
    "text": "پرستار و گنجم چه در خورد اوست"
  },
  {
    "poem_id": 87969,
    "vorder": 63,
    "position": 0,
    "text": "بگفت این و رخسارگان کرد زرد"
  },
  {
    "poem_id": 87969,
    "vorder": 64,
    "position": 1,
    "text": "برآمد روانش بتیمار و درد"
  },
  {
    "poem_id": 87969,
    "vorder": 65,
    "position": 0,
    "text": "ببازیگری ماند این چرخ مست"
  },
  {
    "poem_id": 87969,
    "vorder": 66,
    "position": 1,
    "text": "که بازی برآرد به هفتاد دست"
  },
  {
    "poem_id": 87969,
    "vorder": 67,
    "position": 0,
    "text": "زمانی بخنجر زمانی بتیغ"
  },
  {
    "poem_id": 87969,
    "vorder": 68,
    "position": 1,
    "text": "زمانی بباد و زمانی بمیغ"
  },
  {
    "poem_id": 87969,
    "vorder": 69,
    "position": 0,
    "text": "زمانی بدست یکی ناسزا"
  },
  {
    "poem_id": 87969,
    "vorder": 70,
    "position": 1,
    "text": "زمانی خود از درد و سختی رها"
  },
  {
    "poem_id": 87969,
    "vorder": 71,
    "position": 0,
    "text": "زمانی دهد تخت و گنج و کلاه"
  },
  {
    "poem_id": 87969,
    "vorder": 72,
    "position": 1,
    "text": "زمانی غم و رنج و خواری و چاه"
  },
  {
    "poem_id": 87969,
    "vorder": 73,
    "position": 0,
    "text": "همی خورد باید کسی را که هست"
  },
  {
    "poem_id": 87969,
    "vorder": 74,
    "position": 1,
    "text": "منم تنگدل تا شدم تنگدست"
  },
  {
    "poem_id": 87969,
    "vorder": 75,
    "position": 0,
    "text": "اگر خود نزادی خردمند مرد"
  },
  {
    "poem_id": 87969,
    "vorder": 76,
    "position": 1,
    "text": "ندیدی ز گیتی چنین گرم و سرد"
  },
  {
    "poem_id": 87969,
    "vorder": 77,
    "position": 0,
    "text": "بباید به کوری و ناکام زیست"
  },
  {
    "poem_id": 87969,
    "vorder": 78,
    "position": 1,
    "text": "برین زندگانی بباید گریست"
  },
  {
    "poem_id": 87969,
    "vorder": 79,
    "position": 0,
    "text": "سرانجام خاکست بالین اوی"
  },
  {
    "poem_id": 87969,
    "vorder": 80,
    "position": 1,
    "text": "دریغ آن دل و رای و آیین اوی"
  },
  {
    "poem_id": 87969,
    "vorder": 81,
    "position": 0,
    "text": "پرستندگان بر سر دژ شدند"
  },
  {
    "poem_id": 87969,
    "vorder": 82,
    "position": 1,
    "text": "همه خویشتن بر زمین برزدند"
  },
  {
    "poem_id": 87969,
    "vorder": 83,
    "position": 0,
    "text": "یکی آتشی خود جریره فروخت"
  },
  {
    "poem_id": 87969,
    "vorder": 84,
    "position": 1,
    "text": "همه گنجها را به آتش بسوخت"
  },
  {
    "poem_id": 87969,
    "vorder": 85,
    "position": 0,
    "text": "یکی تیغ بگرفت زان پس بدست"
  },
  {
    "poem_id": 87969,
    "vorder": 86,
    "position": 1,
    "text": "در خانهٔ تازی اسپان ببست"
  },
  {
    "poem_id": 87969,
    "vorder": 87,
    "position": 0,
    "text": "شکمشان بدرید و ببرید پی"
  },
  {
    "poem_id": 87969,
    "vorder": 88,
    "position": 1,
    "text": "همی ریخت از دیده خوناب و خوی"
  },
  {
    "poem_id": 87969,
    "vorder": 89,
    "position": 0,
    "text": "بیامد ببالین فرخ فرود"
  },
  {
    "poem_id": 87969,
    "vorder": 90,
    "position": 1,
    "text": "یکی دشنه با او چو آب کبود"
  },
  {
    "poem_id": 87969,
    "vorder": 91,
    "position": 0,
    "text": "دو رخ را بروی پسر بر نهاد"
  },
  {
    "poem_id": 87969,
    "vorder": 92,
    "position": 1,
    "text": "شکم بردرید و برش جان بداد"
  },
  {
    "poem_id": 87969,
    "vorder": 93,
    "position": 0,
    "text": "در دژ بکندند ایرانیان"
  },
  {
    "poem_id": 87969,
    "vorder": 94,
    "position": 1,
    "text": "بغارت ببستند یکسر میان"
  },
  {
    "poem_id": 87969,
    "vorder": 95,
    "position": 0,
    "text": "چو بهرام نزدیک آن باره شد"
  },
  {
    "poem_id": 87969,
    "vorder": 96,
    "position": 1,
    "text": "از اندوه یکسر دلش پاره شد"
  },
  {
    "poem_id": 87969,
    "vorder": 97,
    "position": 0,
    "text": "بایرانیان گفت کین از پدر"
  },
  {
    "poem_id": 87969,
    "vorder": 98,
    "position": 1,
    "text": "بسی خوارتر مرد و هم زارتر"
  },
  {
    "poem_id": 87969,
    "vorder": 99,
    "position": 0,
    "text": "کشنده سیاوش چاکر نبود"
  },
  {
    "poem_id": 87969,
    "vorder": 100,
    "position": 1,
    "text": "ببالینش بر کشته مادر نبود"
  },
  {
    "poem_id": 87969,
    "vorder": 101,
    "position": 0,
    "text": "همه دژ سراسر برافروخته"
  },
  {
    "poem_id": 87969,
    "vorder": 102,
    "position": 1,
    "text": "همه خان و مان کنده و سوخته"
  },
  {
    "poem_id": 87969,
    "vorder": 103,
    "position": 0,
    "text": "بایرانیان گفت کز کردگار"
  },
  {
    "poem_id": 87969,
    "vorder": 104,
    "position": 1,
    "text": "بترسید وز گردش روزگار"
  },
  {
    "poem_id": 87969,
    "vorder": 105,
    "position": 0,
    "text": "ببد بس درازست چنگ سپهر"
  },
  {
    "poem_id": 87969,
    "vorder": 106,
    "position": 1,
    "text": "به بیدادگر برنگردد بمهر"
  },
  {
    "poem_id": 87969,
    "vorder": 107,
    "position": 0,
    "text": "زکیخسرو اکنون ندارید شرم"
  },
  {
    "poem_id": 87969,
    "vorder": 108,
    "position": 1,
    "text": "که چندان سخن گفت با طوس نرم"
  },
  {
    "poem_id": 87969,
    "vorder": 109,
    "position": 0,
    "text": "بکین سیاوش فرستادتان"
  },
  {
    "poem_id": 87969,
    "vorder": 110,
    "position": 1,
    "text": "بسی پند و اندرزها دادتان"
  },
  {
    "poem_id": 87969,
    "vorder": 111,
    "position": 0,
    "text": "ز خون برادر چو آگه شود"
  },
  {
    "poem_id": 87969,
    "vorder": 112,
    "position": 1,
    "text": "همه شرم و آزرم کوته شود"
  },
  {
    "poem_id": 87969,
    "vorder": 113,
    "position": 0,
    "text": "ز رهام وز بیژن تیز مغز"
  },
  {
    "poem_id": 87969,
    "vorder": 114,
    "position": 1,
    "text": "نیاید بگیتی یکی کار نغز"
  },
  {
    "poem_id": 87969,
    "vorder": 115,
    "position": 0,
    "text": "هماننگه بیامد سپهدار طوس"
  },
  {
    "poem_id": 87969,
    "vorder": 116,
    "position": 1,
    "text": "براه کلات اندر آورد کوس"
  },
  {
    "poem_id": 87969,
    "vorder": 117,
    "position": 0,
    "text": "چو گودرز و چون گیو کنداوران"
  },
  {
    "poem_id": 87969,
    "vorder": 118,
    "position": 1,
    "text": "ز گردان ایران سپاهی گران"
  },
  {
    "poem_id": 87969,
    "vorder": 119,
    "position": 0,
    "text": "سپهبد بسوی سپدکوه شد"
  },
  {
    "poem_id": 87969,
    "vorder": 120,
    "position": 1,
    "text": "وزانجا بنزدیکی انبوه شد"
  },
  {
    "poem_id": 87969,
    "vorder": 121,
    "position": 0,
    "text": "چو آمد ببالین آن کشته زار"
  },
  {
    "poem_id": 87969,
    "vorder": 122,
    "position": 1,
    "text": "بران تخت با مادر افگنده خوار"
  },
  {
    "poem_id": 87969,
    "vorder": 123,
    "position": 0,
    "text": "بیک دست بهرام پر آب چشم"
  },
  {
    "poem_id": 87969,
    "vorder": 124,
    "position": 1,
    "text": "نشسته ببالین او پر ز خشم"
  },
  {
    "poem_id": 87969,
    "vorder": 125,
    "position": 0,
    "text": "بدست دگر زنگهٔ شاوران"
  },
  {
    "poem_id": 87969,
    "vorder": 126,
    "position": 1,
    "text": "برو انجمن گشته کنداوران"
  },
  {
    "poem_id": 87969,
    "vorder": 127,
    "position": 0,
    "text": "گوی چون درختی بران تخت عاج"
  },
  {
    "poem_id": 87969,
    "vorder": 128,
    "position": 1,
    "text": "بدیدار ماه و ببالای ساج"
  },
  {
    "poem_id": 87969,
    "vorder": 129,
    "position": 0,
    "text": "سیاوش بد خفته بر تخت زر"
  },
  {
    "poem_id": 87969,
    "vorder": 130,
    "position": 1,
    "text": "ابا جوشن و تیغ و گرز و کمر"
  },
  {
    "poem_id": 87969,
    "vorder": 131,
    "position": 0,
    "text": "برو زار بگریست گودرز و گیو"
  },
  {
    "poem_id": 87969,
    "vorder": 132,
    "position": 1,
    "text": "بزرگان چو گرگین و بهرام نیو"
  },
  {
    "poem_id": 87969,
    "vorder": 133,
    "position": 0,
    "text": "رخ طوس شد پر ز خون جگر"
  },
  {
    "poem_id": 87969,
    "vorder": 134,
    "position": 1,
    "text": "ز درد فرود و ز درد پسر"
  },
  {
    "poem_id": 87969,
    "vorder": 135,
    "position": 0,
    "text": "که تندی پشیمانی آردت بار"
  },
  {
    "poem_id": 87969,
    "vorder": 136,
    "position": 1,
    "text": "تو در بوستان تخم تندی مکار"
  },
  {
    "poem_id": 87969,
    "vorder": 137,
    "position": 0,
    "text": "چنین گفت گودرز با طوس و گیو"
  },
  {
    "poem_id": 87969,
    "vorder": 138,
    "position": 1,
    "text": "همان نامداران و گردان نیو"
  },
  {
    "poem_id": 87969,
    "vorder": 139,
    "position": 0,
    "text": "که تندی نه کار سپهبد بود"
  },
  {
    "poem_id": 87969,
    "vorder": 140,
    "position": 1,
    "text": "سپهبد که تندی کند بد بود"
  },
  {
    "poem_id": 87969,
    "vorder": 141,
    "position": 0,
    "text": "جوانی بدین سان ز تخم کیان"
  },
  {
    "poem_id": 87969,
    "vorder": 142,
    "position": 1,
    "text": "بدین فر و این برز و یال و میان"
  },
  {
    "poem_id": 87969,
    "vorder": 143,
    "position": 0,
    "text": "بدادی بتیزی و تندی بباد"
  },
  {
    "poem_id": 87969,
    "vorder": 144,
    "position": 1,
    "text": "زرسپ آن سپهدار نوذرنژاد"
  },
  {
    "poem_id": 87969,
    "vorder": 145,
    "position": 0,
    "text": "ز تیزی گرفتار شد ریونیز"
  },
  {
    "poem_id": 87969,
    "vorder": 146,
    "position": 1,
    "text": "نبود از بد بخت ما مانده چیز"
  },
  {
    "poem_id": 87969,
    "vorder": 147,
    "position": 0,
    "text": "هنر بی‌خرد در دل مرد تند"
  },
  {
    "poem_id": 87969,
    "vorder": 148,
    "position": 1,
    "text": "چو تیغی که گردد ز زنگار کند"
  },
  {
    "poem_id": 87969,
    "vorder": 149,
    "position": 0,
    "text": "چو چندین بگفتند آب از دو چشم"
  },
  {
    "poem_id": 87969,
    "vorder": 150,
    "position": 1,
    "text": "ببارید و آمد ز تندی بخشم"
  },
  {
    "poem_id": 87969,
    "vorder": 151,
    "position": 0,
    "text": "چنین پاسخ آورد کز بخت بد"
  },
  {
    "poem_id": 87969,
    "vorder": 152,
    "position": 1,
    "text": "بسی رنج وسختی بمردم رسد"
  },
  {
    "poem_id": 87969,
    "vorder": 153,
    "position": 0,
    "text": "بفرمود تا دخمهٔ شاهوار"
  },
  {
    "poem_id": 87969,
    "vorder": 154,
    "position": 1,
    "text": "بکردند بر تیغ آن کوهسار"
  },
  {
    "poem_id": 87969,
    "vorder": 155,
    "position": 0,
    "text": "نهادند زیراندرش تخت زر"
  },
  {
    "poem_id": 87969,
    "vorder": 156,
    "position": 1,
    "text": "بدیبای زربفت و زرین کمر"
  },
  {
    "poem_id": 87969,
    "vorder": 157,
    "position": 0,
    "text": "تن شاهوارش بیاراستند"
  },
  {
    "poem_id": 87969,
    "vorder": 158,
    "position": 1,
    "text": "گل و مشک و کافور و می خواستند"
  },
  {
    "poem_id": 87969,
    "vorder": 159,
    "position": 0,
    "text": "سرش را بکافور کردند خشک"
  },
  {
    "poem_id": 87969,
    "vorder": 160,
    "position": 1,
    "text": "رخش را بعطر و گلاب و بمشک"
  },
  {
    "poem_id": 87969,
    "vorder": 161,
    "position": 0,
    "text": "نهادند بر تخت و گشتند باز"
  },
  {
    "poem_id": 87969,
    "vorder": 162,
    "position": 1,
    "text": "شد آن شیردل شاه گردن‌فراز"
  },
  {
    "poem_id": 87969,
    "vorder": 163,
    "position": 0,
    "text": "زراسپ سرافراز با ریونیز"
  },
  {
    "poem_id": 87969,
    "vorder": 164,
    "position": 1,
    "text": "نهادند در پهلوی شاه نیز"
  },
  {
    "poem_id": 87969,
    "vorder": 165,
    "position": 0,
    "text": "سپهبد بران ریش کافورگون"
  },
  {
    "poem_id": 87969,
    "vorder": 166,
    "position": 1,
    "text": "ببارید از دیدگان جوی خون"
  },
  {
    "poem_id": 87969,
    "vorder": 167,
    "position": 0,
    "text": "چنینست هرچند مانیم دیر"
  },
  {
    "poem_id": 87969,
    "vorder": 168,
    "position": 1,
    "text": "نه پیل سرافراز ماند نه شیر"
  },
  {
    "poem_id": 87969,
    "vorder": 169,
    "position": 0,
    "text": "دل سنگ و سندان بترسد ز مرگ"
  },
  {
    "poem_id": 87969,
    "vorder": 170,
    "position": 1,
    "text": "رهایی نیابد ازو بار و برگ"
  }
]