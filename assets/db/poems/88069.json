[
  {
    "poem_id": 88069,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 88069,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد قرطاس و مشک و عبیر"
  },
  {
    "poem_id": 88069,
    "vorder": 3,
    "position": 0,
    "text": "نبشتند نامه به کاووس شاه"
  },
  {
    "poem_id": 88069,
    "vorder": 4,
    "position": 1,
    "text": "چنانچون سزا بود زان رزمگاه"
  },
  {
    "poem_id": 88069,
    "vorder": 5,
    "position": 0,
    "text": "سر نامه کرد از نخست آفرین"
  },
  {
    "poem_id": 88069,
    "vorder": 6,
    "position": 1,
    "text": "ستایش سزای جهان آفرین"
  },
  {
    "poem_id": 88069,
    "vorder": 7,
    "position": 0,
    "text": "دگر گفت شاه جهانبان من"
  },
  {
    "poem_id": 88069,
    "vorder": 8,
    "position": 1,
    "text": "پدروار لرزیده بر جان من"
  },
  {
    "poem_id": 88069,
    "vorder": 9,
    "position": 0,
    "text": "بزرگیش با کوه پیوسته باد"
  },
  {
    "poem_id": 88069,
    "vorder": 10,
    "position": 1,
    "text": "دل بدسگالان او خسته باد"
  },
  {
    "poem_id": 88069,
    "vorder": 11,
    "position": 0,
    "text": "رسیدم ز ایران به ریگ فرب"
  },
  {
    "poem_id": 88069,
    "vorder": 12,
    "position": 1,
    "text": "سه جنگ گران کرده شد در سه شب"
  },
  {
    "poem_id": 88069,
    "vorder": 13,
    "position": 0,
    "text": "شمار سواران افراسیاب"
  },
  {
    "poem_id": 88069,
    "vorder": 14,
    "position": 1,
    "text": "نبیند خردمند هرگز به خواب"
  },
  {
    "poem_id": 88069,
    "vorder": 15,
    "position": 0,
    "text": "بریده چو سیصد سر نامدار"
  },
  {
    "poem_id": 88069,
    "vorder": 16,
    "position": 1,
    "text": "فرستادم اینک بر شهریار"
  },
  {
    "poem_id": 88069,
    "vorder": 17,
    "position": 0,
    "text": "برادر بد و خویش و پیوند اوی"
  },
  {
    "poem_id": 88069,
    "vorder": 18,
    "position": 1,
    "text": "گرامی بزرگان و فرزند اوی"
  },
  {
    "poem_id": 88069,
    "vorder": 19,
    "position": 0,
    "text": "وز آن نامداران بسته دویست"
  },
  {
    "poem_id": 88069,
    "vorder": 20,
    "position": 1,
    "text": "که صد شیر با جنگ هر یک یکیست"
  },
  {
    "poem_id": 88069,
    "vorder": 21,
    "position": 0,
    "text": "همه رزم بر دشت خوارزم بود"
  },
  {
    "poem_id": 88069,
    "vorder": 22,
    "position": 1,
    "text": "ز چرخ آفرین بر چنان رزم بود"
  },
  {
    "poem_id": 88069,
    "vorder": 23,
    "position": 0,
    "text": "برفت او و ما از پس اندر دمان"
  },
  {
    "poem_id": 88069,
    "vorder": 24,
    "position": 1,
    "text": "کشیدیم تا بر چه گردد زمان"
  },
  {
    "poem_id": 88069,
    "vorder": 25,
    "position": 0,
    "text": "بر این رزمگاه آفرین باد گفت"
  },
  {
    "poem_id": 88069,
    "vorder": 26,
    "position": 1,
    "text": "همه ساله با اختر نیک جفت"
  },
  {
    "poem_id": 88069,
    "vorder": 27,
    "position": 0,
    "text": "نهادند بر نامه مهری ز مشک"
  },
  {
    "poem_id": 88069,
    "vorder": 28,
    "position": 1,
    "text": "از آن پس گذر کرد بر ریگ خشک"
  },
  {
    "poem_id": 88069,
    "vorder": 29,
    "position": 0,
    "text": "چو ز آن رود جیحون شد افراسیاب"
  },
  {
    "poem_id": 88069,
    "vorder": 30,
    "position": 1,
    "text": "چو باد دمان تیز بگذشت آب"
  },
  {
    "poem_id": 88069,
    "vorder": 31,
    "position": 0,
    "text": "به پیش سپاه قراخان رسید"
  },
  {
    "poem_id": 88069,
    "vorder": 32,
    "position": 1,
    "text": "همی گفت هر کس ز جنگ آنچه دید"
  },
  {
    "poem_id": 88069,
    "vorder": 33,
    "position": 0,
    "text": "سپهدار ترکان چه مایه گریست"
  },
  {
    "poem_id": 88069,
    "vorder": 34,
    "position": 1,
    "text": "بر آن کس که از تخمهٔ او بزیست"
  },
  {
    "poem_id": 88069,
    "vorder": 35,
    "position": 0,
    "text": "ز بهر گرانمایه فرزند خویش"
  },
  {
    "poem_id": 88069,
    "vorder": 36,
    "position": 1,
    "text": "بزرگان و خویشان و پیوند خویش"
  },
  {
    "poem_id": 88069,
    "vorder": 37,
    "position": 0,
    "text": "خروشی یر آمد تو گفتی که ابر"
  },
  {
    "poem_id": 88069,
    "vorder": 38,
    "position": 1,
    "text": "همی خون چکاند ز چشم هژبر"
  },
  {
    "poem_id": 88069,
    "vorder": 39,
    "position": 0,
    "text": "همی بودش اندر بخارا درنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 40,
    "position": 1,
    "text": "همی خواست کایند شیران به جنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 41,
    "position": 0,
    "text": "از آن پس چو گشت انجمن آنچه ماند"
  },
  {
    "poem_id": 88069,
    "vorder": 42,
    "position": 1,
    "text": "بزرگان برتر منش را بخواند"
  },
  {
    "poem_id": 88069,
    "vorder": 43,
    "position": 0,
    "text": "چو گشتند پر مایگان انجمن"
  },
  {
    "poem_id": 88069,
    "vorder": 44,
    "position": 1,
    "text": "ز لشکر هر آن کس که بد رای زن"
  },
  {
    "poem_id": 88069,
    "vorder": 45,
    "position": 0,
    "text": "زبان بر گشادند بر شهریار"
  },
  {
    "poem_id": 88069,
    "vorder": 46,
    "position": 1,
    "text": "چو بیچاره شدشان دل از کارزار"
  },
  {
    "poem_id": 88069,
    "vorder": 47,
    "position": 0,
    "text": "که از لشکر ما بزرگان که بود"
  },
  {
    "poem_id": 88069,
    "vorder": 48,
    "position": 1,
    "text": "گذشتند و ز ایشان دل ما شخود"
  },
  {
    "poem_id": 88069,
    "vorder": 49,
    "position": 0,
    "text": "همانا که از صد نماندست بیست"
  },
  {
    "poem_id": 88069,
    "vorder": 50,
    "position": 1,
    "text": "بر آن رفتگان بر بباید گریست"
  },
  {
    "poem_id": 88069,
    "vorder": 51,
    "position": 0,
    "text": "کنون ما دل از گنج و فرزند خویش"
  },
  {
    "poem_id": 88069,
    "vorder": 52,
    "position": 1,
    "text": "گسستیم چندی ز پیوند خویش"
  },
  {
    "poem_id": 88069,
    "vorder": 53,
    "position": 0,
    "text": "بدان روی جیحون یکی رزمگاه"
  },
  {
    "poem_id": 88069,
    "vorder": 54,
    "position": 1,
    "text": "بکردیم زان پس که فرمود شاه"
  },
  {
    "poem_id": 88069,
    "vorder": 55,
    "position": 0,
    "text": "ز بی دانشی آنچه آمد به روی"
  },
  {
    "poem_id": 88069,
    "vorder": 56,
    "position": 1,
    "text": "تو دانی که شاهی و ما چاره‌جوی"
  },
  {
    "poem_id": 88069,
    "vorder": 57,
    "position": 0,
    "text": "گر ایدون که روشن بود رای شاه"
  },
  {
    "poem_id": 88069,
    "vorder": 58,
    "position": 1,
    "text": "از ایدر به چاچ اندر آرد سپاه"
  },
  {
    "poem_id": 88069,
    "vorder": 59,
    "position": 0,
    "text": "چو کیخسرو آید به کین خواستن"
  },
  {
    "poem_id": 88069,
    "vorder": 60,
    "position": 1,
    "text": "بباید تو را لشکر آراستن"
  },
  {
    "poem_id": 88069,
    "vorder": 61,
    "position": 0,
    "text": "چو شاه اندر این کار فرمان برد"
  },
  {
    "poem_id": 88069,
    "vorder": 62,
    "position": 1,
    "text": "ز گلزریون نیز هم بگذرد"
  },
  {
    "poem_id": 88069,
    "vorder": 63,
    "position": 0,
    "text": "بباشد به آرام به بهشت گنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 64,
    "position": 1,
    "text": "که هم جای جنگست و جای درنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 65,
    "position": 0,
    "text": "بر این بر نهادند یکسر سخن"
  },
  {
    "poem_id": 88069,
    "vorder": 66,
    "position": 1,
    "text": "کسی رای دیگر نیفگند بن"
  },
  {
    "poem_id": 88069,
    "vorder": 67,
    "position": 0,
    "text": "برفتند یکسر به گلزریون"
  },
  {
    "poem_id": 88069,
    "vorder": 68,
    "position": 1,
    "text": "همه دیده پر آب و دل پر ز خون"
  },
  {
    "poem_id": 88069,
    "vorder": 69,
    "position": 0,
    "text": "به گلزریون شاه توران سه روز"
  },
  {
    "poem_id": 88069,
    "vorder": 70,
    "position": 1,
    "text": "ببود و برآسود با باز و یوز"
  },
  {
    "poem_id": 88069,
    "vorder": 71,
    "position": 0,
    "text": "برفتند زان جایگه سوی گنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 72,
    "position": 1,
    "text": "به جایی نبودش فراوان درنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 73,
    "position": 0,
    "text": "یکی جای بود آن به سان بهشت"
  },
  {
    "poem_id": 88069,
    "vorder": 74,
    "position": 1,
    "text": "گلش مشک سارا بد و زر خشت"
  },
  {
    "poem_id": 88069,
    "vorder": 75,
    "position": 0,
    "text": "بدان جایگه شاد و خندان بخفت"
  },
  {
    "poem_id": 88069,
    "vorder": 76,
    "position": 1,
    "text": "تو گفتی که با ایمنی گشت جفت"
  },
  {
    "poem_id": 88069,
    "vorder": 77,
    "position": 0,
    "text": "سپه خواند از هر سوی بی‌کران"
  },
  {
    "poem_id": 88069,
    "vorder": 78,
    "position": 1,
    "text": "بزرگان گردنکش و مهتران"
  },
  {
    "poem_id": 88069,
    "vorder": 79,
    "position": 0,
    "text": "می و گلشن و بانگ چنگ و رباب"
  },
  {
    "poem_id": 88069,
    "vorder": 80,
    "position": 1,
    "text": "گل و سنبل و رطل و افراسیاب"
  },
  {
    "poem_id": 88069,
    "vorder": 81,
    "position": 0,
    "text": "همی بود تا بر چه گردد جهان"
  },
  {
    "poem_id": 88069,
    "vorder": 82,
    "position": 1,
    "text": "بدین آشکارا چه دارد نهان"
  },
  {
    "poem_id": 88069,
    "vorder": 83,
    "position": 0,
    "text": "چو کیخسرو آمد بر این روی آب"
  },
  {
    "poem_id": 88069,
    "vorder": 84,
    "position": 1,
    "text": "از او دور شد خورد و آرام و خواب"
  },
  {
    "poem_id": 88069,
    "vorder": 85,
    "position": 0,
    "text": "سپه چون گذر کرد زان سوی رود"
  },
  {
    "poem_id": 88069,
    "vorder": 86,
    "position": 1,
    "text": "فرستاد زان پس به هر کس درود"
  },
  {
    "poem_id": 88069,
    "vorder": 87,
    "position": 0,
    "text": "کز این آمدن کس مدارید باک"
  },
  {
    "poem_id": 88069,
    "vorder": 88,
    "position": 1,
    "text": "بخواهید ما را ز یزدان پاک"
  },
  {
    "poem_id": 88069,
    "vorder": 89,
    "position": 0,
    "text": "گرانمایه گنجی به درویش داد"
  },
  {
    "poem_id": 88069,
    "vorder": 90,
    "position": 1,
    "text": "کسی را کز او شاد بد بیش داد"
  },
  {
    "poem_id": 88069,
    "vorder": 91,
    "position": 0,
    "text": "وز آنجا بیامد سوی شهر سغد"
  },
  {
    "poem_id": 88069,
    "vorder": 92,
    "position": 1,
    "text": "یکی نو جهان دید رسته ز چغد"
  },
  {
    "poem_id": 88069,
    "vorder": 93,
    "position": 0,
    "text": "ببخشید گنجی بر آن شهر نیز"
  },
  {
    "poem_id": 88069,
    "vorder": 94,
    "position": 1,
    "text": "همی خواست کآباد گردد به چیز"
  },
  {
    "poem_id": 88069,
    "vorder": 95,
    "position": 0,
    "text": "به هر منزلی زینهاری سوار"
  },
  {
    "poem_id": 88069,
    "vorder": 96,
    "position": 1,
    "text": "همی آمدندی بر شهریار"
  },
  {
    "poem_id": 88069,
    "vorder": 97,
    "position": 0,
    "text": "از آن پس چو آگاهی آمد به شاه"
  },
  {
    "poem_id": 88069,
    "vorder": 98,
    "position": 1,
    "text": "ز گنگ و ز افراسیاب و سپاه"
  },
  {
    "poem_id": 88069,
    "vorder": 99,
    "position": 0,
    "text": "که آمد به نزدیک او گلگله"
  },
  {
    "poem_id": 88069,
    "vorder": 100,
    "position": 1,
    "text": "ابا لشکری چون هژبر یله"
  },
  {
    "poem_id": 88069,
    "vorder": 101,
    "position": 0,
    "text": "که از تخم تورست پرکین و درد"
  },
  {
    "poem_id": 88069,
    "vorder": 102,
    "position": 1,
    "text": "بجوید همی روزگار نبرد"
  },
  {
    "poem_id": 88069,
    "vorder": 103,
    "position": 0,
    "text": "فرستاد بهری ز گردان به چاج"
  },
  {
    "poem_id": 88069,
    "vorder": 104,
    "position": 1,
    "text": "که جوید همی تخت ترکان و تاج"
  },
  {
    "poem_id": 88069,
    "vorder": 105,
    "position": 0,
    "text": "سپاهی به سوی بیابان سترگ"
  },
  {
    "poem_id": 88069,
    "vorder": 106,
    "position": 1,
    "text": "فرستاد سالار ایشان طورگ"
  },
  {
    "poem_id": 88069,
    "vorder": 107,
    "position": 0,
    "text": "پذیرفت ز این هر یکی جنگ شاه"
  },
  {
    "poem_id": 88069,
    "vorder": 108,
    "position": 1,
    "text": "که بر نامداران ببندند راه"
  },
  {
    "poem_id": 88069,
    "vorder": 109,
    "position": 0,
    "text": "جهاندار کیخسرو آن خوار داشت"
  },
  {
    "poem_id": 88069,
    "vorder": 110,
    "position": 1,
    "text": "خرد را به اندیشه سالار داشت"
  },
  {
    "poem_id": 88069,
    "vorder": 111,
    "position": 0,
    "text": "سپاهی که از بردع و اردبیل"
  },
  {
    "poem_id": 88069,
    "vorder": 112,
    "position": 1,
    "text": "بیامد بفرمود تا خیل خیل"
  },
  {
    "poem_id": 88069,
    "vorder": 113,
    "position": 0,
    "text": "بیایند و بر پیش او بگذرند"
  },
  {
    "poem_id": 88069,
    "vorder": 114,
    "position": 1,
    "text": "رد و موبد و مرزبان بشمرند"
  },
  {
    "poem_id": 88069,
    "vorder": 115,
    "position": 0,
    "text": "برفتند و سالارشان گستهم"
  },
  {
    "poem_id": 88069,
    "vorder": 116,
    "position": 1,
    "text": "که در جنگ شیران نبودی دژم"
  },
  {
    "poem_id": 88069,
    "vorder": 117,
    "position": 0,
    "text": "همان گفت تا لشکر نیمروز"
  },
  {
    "poem_id": 88069,
    "vorder": 118,
    "position": 1,
    "text": "برفتند با رستم نیوسوز"
  },
  {
    "poem_id": 88069,
    "vorder": 119,
    "position": 0,
    "text": "بفرمود تا بر هیونان مست"
  },
  {
    "poem_id": 88069,
    "vorder": 120,
    "position": 1,
    "text": "نشینند و گیرند اسبان به دست"
  },
  {
    "poem_id": 88069,
    "vorder": 121,
    "position": 0,
    "text": "به سغد اندرون بود یک ماه شاه"
  },
  {
    "poem_id": 88069,
    "vorder": 122,
    "position": 1,
    "text": "همه سغد شد شاه را نیک‌خواه"
  },
  {
    "poem_id": 88069,
    "vorder": 123,
    "position": 0,
    "text": "سپه را درم داد و آسوده کرد"
  },
  {
    "poem_id": 88069,
    "vorder": 124,
    "position": 1,
    "text": "همی جست هنگام روز نبرد"
  },
  {
    "poem_id": 88069,
    "vorder": 125,
    "position": 0,
    "text": "هر آن کس که بود از در کارزار"
  },
  {
    "poem_id": 88069,
    "vorder": 126,
    "position": 1,
    "text": "بدانست نیرنگ و بند حصار"
  },
  {
    "poem_id": 88069,
    "vorder": 127,
    "position": 0,
    "text": "بیاورد و با خویشتن یار کرد"
  },
  {
    "poem_id": 88069,
    "vorder": 128,
    "position": 1,
    "text": "سر بدکنش پر ز تیمار کرد"
  },
  {
    "poem_id": 88069,
    "vorder": 129,
    "position": 0,
    "text": "وز آن جایگه گردن افراخته"
  },
  {
    "poem_id": 88069,
    "vorder": 130,
    "position": 1,
    "text": "کمر بسته و جنگ را ساخته"
  },
  {
    "poem_id": 88069,
    "vorder": 131,
    "position": 0,
    "text": "ز سغد کشانی سپه بر گرفت"
  },
  {
    "poem_id": 88069,
    "vorder": 132,
    "position": 1,
    "text": "جهانی در او مانده اندر شگفت"
  },
  {
    "poem_id": 88069,
    "vorder": 133,
    "position": 0,
    "text": "خبر شد به ترکان که آمد سپاه"
  },
  {
    "poem_id": 88069,
    "vorder": 134,
    "position": 1,
    "text": "جهانجوی کیخسرو کینه‌خواه"
  },
  {
    "poem_id": 88069,
    "vorder": 135,
    "position": 0,
    "text": "همه سوی دژها نهادند روی"
  },
  {
    "poem_id": 88069,
    "vorder": 136,
    "position": 1,
    "text": "جهان شد پر از جنبش و گفت و گوی"
  },
  {
    "poem_id": 88069,
    "vorder": 137,
    "position": 0,
    "text": "به لشکر چنین گفت پس شهریار"
  },
  {
    "poem_id": 88069,
    "vorder": 138,
    "position": 1,
    "text": "که امروز به گونه شد کارزار"
  },
  {
    "poem_id": 88069,
    "vorder": 139,
    "position": 0,
    "text": "ز ترکان هر آن کس که فرمان کند"
  },
  {
    "poem_id": 88069,
    "vorder": 140,
    "position": 1,
    "text": "دل از جنگ جستن پشیمان کند"
  },
  {
    "poem_id": 88069,
    "vorder": 141,
    "position": 0,
    "text": "مسازید جنگ و مریزید خون"
  },
  {
    "poem_id": 88069,
    "vorder": 142,
    "position": 1,
    "text": "مباشید کس را به بد رهنمون"
  },
  {
    "poem_id": 88069,
    "vorder": 143,
    "position": 0,
    "text": "وگر جنگ جوید کسی با سپاه"
  },
  {
    "poem_id": 88069,
    "vorder": 144,
    "position": 1,
    "text": "دل کینه دارش نیاید به راه"
  },
  {
    "poem_id": 88069,
    "vorder": 145,
    "position": 0,
    "text": "شما را حلال است خون ریختن"
  },
  {
    "poem_id": 88069,
    "vorder": 146,
    "position": 1,
    "text": "به هر جای تاراج و آویختن"
  },
  {
    "poem_id": 88069,
    "vorder": 147,
    "position": 0,
    "text": "به ره بر خورشها مدارید تنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 148,
    "position": 1,
    "text": "مدارید کین و مسازید جنگ"
  },
  {
    "poem_id": 88069,
    "vorder": 149,
    "position": 0,
    "text": "خروشی بر آمد ز پیش سپاه"
  },
  {
    "poem_id": 88069,
    "vorder": 150,
    "position": 1,
    "text": "که گفتی بدرد همی چرخ و ماه"
  },
  {
    "poem_id": 88069,
    "vorder": 151,
    "position": 0,
    "text": "سواران به دژها نهادند روی"
  },
  {
    "poem_id": 88069,
    "vorder": 152,
    "position": 1,
    "text": "جهان شد پر از غلغل و گفتگوی"
  },
  {
    "poem_id": 88069,
    "vorder": 153,
    "position": 0,
    "text": "هر آن کس که فرمان به جا آورید"
  },
  {
    "poem_id": 88069,
    "vorder": 154,
    "position": 1,
    "text": "سپاه شهنشه بدو ننگرید"
  },
  {
    "poem_id": 88069,
    "vorder": 155,
    "position": 0,
    "text": "هر آن کو برون شد ز فرمان شاه"
  },
  {
    "poem_id": 88069,
    "vorder": 156,
    "position": 1,
    "text": "سرانشان بریدند یکسر سپاه"
  },
  {
    "poem_id": 88069,
    "vorder": 157,
    "position": 0,
    "text": "ز ترکان کس از بیم افراسیاب"
  },
  {
    "poem_id": 88069,
    "vorder": 158,
    "position": 1,
    "text": "لب تشنه نگذاشتندی بر آب"
  },
  {
    "poem_id": 88069,
    "vorder": 159,
    "position": 0,
    "text": "وگر باز ماندی کسی ز این سپاه"
  },
  {
    "poem_id": 88069,
    "vorder": 160,
    "position": 1,
    "text": "تن بی سرش یافتندی به راه"
  },
  {
    "poem_id": 88069,
    "vorder": 161,
    "position": 0,
    "text": "دلیران به دژها نهادند روی"
  },
  {
    "poem_id": 88069,
    "vorder": 162,
    "position": 1,
    "text": "به هر دژ که بودی یکی جنگجوی"
  },
  {
    "poem_id": 88069,
    "vorder": 163,
    "position": 0,
    "text": "شدی بارهٔ دژ هم آنگاه پست"
  },
  {
    "poem_id": 88069,
    "vorder": 164,
    "position": 1,
    "text": "نماندی در و بام وجای نشست"
  },
  {
    "poem_id": 88069,
    "vorder": 165,
    "position": 0,
    "text": "غلام و پرستنده و چارپای"
  },
  {
    "poem_id": 88069,
    "vorder": 166,
    "position": 1,
    "text": "نماندی بد و نیک چیزی به جای"
  },
  {
    "poem_id": 88069,
    "vorder": 167,
    "position": 0,
    "text": "بر این گونه فرسنگ بر صد گذشت"
  },
  {
    "poem_id": 88069,
    "vorder": 168,
    "position": 1,
    "text": "نه دژ ماند آباد جایی نه دشت"
  },
  {
    "poem_id": 88069,
    "vorder": 169,
    "position": 0,
    "text": "چو آورد لشکر به گلزریون"
  },
  {
    "poem_id": 88069,
    "vorder": 170,
    "position": 1,
    "text": "به هر سو بگردید با رهنمون"
  },
  {
    "poem_id": 88069,
    "vorder": 171,
    "position": 0,
    "text": "جهان دید بر سان باغ بهار"
  },
  {
    "poem_id": 88069,
    "vorder": 172,
    "position": 1,
    "text": "در و دشت و کوه و زمین پرنگار"
  },
  {
    "poem_id": 88069,
    "vorder": 173,
    "position": 0,
    "text": "همه کوه نخچیر و هامون درخت"
  },
  {
    "poem_id": 88069,
    "vorder": 174,
    "position": 1,
    "text": "جهان از در مردم نیک بخت"
  },
  {
    "poem_id": 88069,
    "vorder": 175,
    "position": 0,
    "text": "طلایه فرستاد و کارآگهان"
  },
  {
    "poem_id": 88069,
    "vorder": 176,
    "position": 1,
    "text": "بدان تا نماند بدی در نهان"
  },
  {
    "poem_id": 88069,
    "vorder": 177,
    "position": 0,
    "text": "سراپردهٔ شهریار جهان"
  },
  {
    "poem_id": 88069,
    "vorder": 178,
    "position": 1,
    "text": "کشیدند بر پیش آب روان"
  },
  {
    "poem_id": 88069,
    "vorder": 179,
    "position": 0,
    "text": "جهاندار بر تخت زرین نشست"
  },
  {
    "poem_id": 88069,
    "vorder": 180,
    "position": 1,
    "text": "خود و نامداران خسروپرست"
  },
  {
    "poem_id": 88069,
    "vorder": 181,
    "position": 0,
    "text": "شبی کرد جشنی که تا روز پاک"
  },
  {
    "poem_id": 88069,
    "vorder": 182,
    "position": 1,
    "text": "همی مرده برخاست از تیره خاک"
  }
]