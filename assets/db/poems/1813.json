[
  {
    "poem_id": 1813,
    "vorder": 1,
    "position": 0,
    "text": "چو باز آمد از راه بهرامشاه"
  },
  {
    "poem_id": 1813,
    "vorder": 2,
    "position": 1,
    "text": "به آرام بنشست بر پیش‌گاه"
  },
  {
    "poem_id": 1813,
    "vorder": 3,
    "position": 0,
    "text": "ز مرگ و ز روز بد اندیشه کرد"
  },
  {
    "poem_id": 1813,
    "vorder": 4,
    "position": 1,
    "text": "دلش گشت پر درد و رخساره زرد"
  },
  {
    "poem_id": 1813,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1813,
    "vorder": 6,
    "position": 1,
    "text": "سرافراز موبد که بودش وزیر"
  },
  {
    "poem_id": 1813,
    "vorder": 7,
    "position": 0,
    "text": "همی خواست تا گنجها بنگرد"
  },
  {
    "poem_id": 1813,
    "vorder": 8,
    "position": 1,
    "text": "زر و گوهر و جامه‌ها بشمرد"
  },
  {
    "poem_id": 1813,
    "vorder": 9,
    "position": 0,
    "text": "که بااو ستاره‌شمر گفته بود"
  },
  {
    "poem_id": 1813,
    "vorder": 10,
    "position": 1,
    "text": "ز گفتار ایشان برآشفته بود"
  },
  {
    "poem_id": 1813,
    "vorder": 11,
    "position": 0,
    "text": "که باشد ترا زندگانی سه بیست"
  },
  {
    "poem_id": 1813,
    "vorder": 12,
    "position": 1,
    "text": "چهارم به مرگت بباید گریست"
  },
  {
    "poem_id": 1813,
    "vorder": 13,
    "position": 0,
    "text": "همی گفت شادی کنم بیست سال"
  },
  {
    "poem_id": 1813,
    "vorder": 14,
    "position": 1,
    "text": "که دارم به رفتن به گیتی همال"
  },
  {
    "poem_id": 1813,
    "vorder": 15,
    "position": 0,
    "text": "دگر بیست از داد و بخشش جهان"
  },
  {
    "poem_id": 1813,
    "vorder": 16,
    "position": 1,
    "text": "کنم راست با آشکار و نهان"
  },
  {
    "poem_id": 1813,
    "vorder": 17,
    "position": 0,
    "text": "نمانم که ویران شود گوشه‌ای"
  },
  {
    "poem_id": 1813,
    "vorder": 18,
    "position": 1,
    "text": "بیابد ز من هرکسی توشه‌ای"
  },
  {
    "poem_id": 1813,
    "vorder": 19,
    "position": 0,
    "text": "سوم بیست بر پیش یزدان به پای"
  },
  {
    "poem_id": 1813,
    "vorder": 20,
    "position": 1,
    "text": "بباشم مگر باشدم رهنمای"
  },
  {
    "poem_id": 1813,
    "vorder": 21,
    "position": 0,
    "text": "ستاره‌شمر شست و سه سال گفت"
  },
  {
    "poem_id": 1813,
    "vorder": 22,
    "position": 1,
    "text": "شمار سه سالش بد اندر نهفت"
  },
  {
    "poem_id": 1813,
    "vorder": 23,
    "position": 0,
    "text": "ز گفت ستاره‌شمر جست گنج"
  },
  {
    "poem_id": 1813,
    "vorder": 24,
    "position": 1,
    "text": "وگرنه نبودش خود از گنج رنج"
  },
  {
    "poem_id": 1813,
    "vorder": 25,
    "position": 0,
    "text": "خنک مرد بی‌رنج و پرهیزگار"
  },
  {
    "poem_id": 1813,
    "vorder": 26,
    "position": 1,
    "text": "به ویژه کسی کو بود شهریار"
  },
  {
    "poem_id": 1813,
    "vorder": 27,
    "position": 0,
    "text": "چو گنجور بشنید شد پیش گنج"
  },
  {
    "poem_id": 1813,
    "vorder": 28,
    "position": 1,
    "text": "به کار شمردن همی برد رنج"
  },
  {
    "poem_id": 1813,
    "vorder": 29,
    "position": 0,
    "text": "به سختی چنان روزگاری ببرد"
  },
  {
    "poem_id": 1813,
    "vorder": 30,
    "position": 1,
    "text": "همه پیش دستور او برشمرد"
  },
  {
    "poem_id": 1813,
    "vorder": 31,
    "position": 0,
    "text": "چو دستور او برگرفت آن شمار"
  },
  {
    "poem_id": 1813,
    "vorder": 32,
    "position": 1,
    "text": "پراندیشه آمد بر شهریار"
  },
  {
    "poem_id": 1813,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت تا بیست و سه سال نیز"
  },
  {
    "poem_id": 1813,
    "vorder": 34,
    "position": 1,
    "text": "همانا نیازت نیاید به چیز"
  },
  {
    "poem_id": 1813,
    "vorder": 35,
    "position": 0,
    "text": "ز خورد و ز بخشش گرفتم شمار"
  },
  {
    "poem_id": 1813,
    "vorder": 36,
    "position": 1,
    "text": "درمهای این لشکر نامدار"
  },
  {
    "poem_id": 1813,
    "vorder": 37,
    "position": 0,
    "text": "فرستاده‌ای نیز کاید برت"
  },
  {
    "poem_id": 1813,
    "vorder": 38,
    "position": 1,
    "text": "ز شاهان وز نامور کشورت"
  },
  {
    "poem_id": 1813,
    "vorder": 39,
    "position": 0,
    "text": "بدین سال گنج تو آراستست"
  },
  {
    "poem_id": 1813,
    "vorder": 40,
    "position": 1,
    "text": "که پر زر و سیمست و پر خواستست"
  },
  {
    "poem_id": 1813,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید بهرام و اندیشه کرد"
  },
  {
    "poem_id": 1813,
    "vorder": 42,
    "position": 1,
    "text": "ز دانش غم نارسیده نخورد"
  },
  {
    "poem_id": 1813,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت کوتاه شد داوری"
  },
  {
    "poem_id": 1813,
    "vorder": 44,
    "position": 1,
    "text": "که گیتی سه روزست چون بنگری"
  },
  {
    "poem_id": 1813,
    "vorder": 45,
    "position": 0,
    "text": "چو دی رفت و فردا نیامد هنوز"
  },
  {
    "poem_id": 1813,
    "vorder": 46,
    "position": 1,
    "text": "نباشم ز اندیشه امروز کوز"
  },
  {
    "poem_id": 1813,
    "vorder": 47,
    "position": 0,
    "text": "چو بخشیدنی باشد و تاج و تخت"
  },
  {
    "poem_id": 1813,
    "vorder": 48,
    "position": 1,
    "text": "نخواهم ز گیتی ازین بیش رخت"
  },
  {
    "poem_id": 1813,
    "vorder": 49,
    "position": 0,
    "text": "بفرمود پس تا خراج جهان"
  },
  {
    "poem_id": 1813,
    "vorder": 50,
    "position": 1,
    "text": "نخواهند نیز از کهان و مهان"
  },
  {
    "poem_id": 1813,
    "vorder": 51,
    "position": 0,
    "text": "به هر شهر مردی پدیدار کرد"
  },
  {
    "poem_id": 1813,
    "vorder": 52,
    "position": 1,
    "text": "سر خفته از خواب بیدار کرد"
  },
  {
    "poem_id": 1813,
    "vorder": 53,
    "position": 0,
    "text": "بدان تا نجویند پیکار نیز"
  },
  {
    "poem_id": 1813,
    "vorder": 54,
    "position": 1,
    "text": "نیاید ز پیکار افگار نیز"
  },
  {
    "poem_id": 1813,
    "vorder": 55,
    "position": 0,
    "text": "ز گنج آنچ بایستشان خوردنی"
  },
  {
    "poem_id": 1813,
    "vorder": 56,
    "position": 1,
    "text": "ز پوشیدنی گر ز گستردنی"
  },
  {
    "poem_id": 1813,
    "vorder": 57,
    "position": 0,
    "text": "بدین پرخرد موبدان داد و گفت"
  },
  {
    "poem_id": 1813,
    "vorder": 58,
    "position": 1,
    "text": "که نیک و بد از من نباید نهفت"
  },
  {
    "poem_id": 1813,
    "vorder": 59,
    "position": 0,
    "text": "میان سخنها میانجی بوید"
  },
  {
    "poem_id": 1813,
    "vorder": 60,
    "position": 1,
    "text": "نخواهند چیزی کرانجی بوید"
  },
  {
    "poem_id": 1813,
    "vorder": 61,
    "position": 0,
    "text": "مرا از به و بتر آگه کنید"
  },
  {
    "poem_id": 1813,
    "vorder": 62,
    "position": 1,
    "text": "ز بدها گمانیم کوته کنید"
  },
  {
    "poem_id": 1813,
    "vorder": 63,
    "position": 0,
    "text": "پراگنده شد موبد اندر جهان"
  },
  {
    "poem_id": 1813,
    "vorder": 64,
    "position": 1,
    "text": "نماند ایچ نیک و بد اندر نهان"
  },
  {
    "poem_id": 1813,
    "vorder": 65,
    "position": 0,
    "text": "بران پر خرد کارها بسته شد"
  },
  {
    "poem_id": 1813,
    "vorder": 66,
    "position": 1,
    "text": "ز هر کشوری نامه پیوسته شد"
  },
  {
    "poem_id": 1813,
    "vorder": 67,
    "position": 0,
    "text": "که از داد و پیکاری و خواسته"
  },
  {
    "poem_id": 1813,
    "vorder": 68,
    "position": 1,
    "text": "خرد شد به مغز اندرون کاسته"
  },
  {
    "poem_id": 1813,
    "vorder": 69,
    "position": 0,
    "text": "ز بس جنگ و خون ریختن در جهان"
  },
  {
    "poem_id": 1813,
    "vorder": 70,
    "position": 1,
    "text": "جوانان ندانند ارج مهان"
  },
  {
    "poem_id": 1813,
    "vorder": 71,
    "position": 0,
    "text": "دل آگنده گردد جوان را به چیز"
  },
  {
    "poem_id": 1813,
    "vorder": 72,
    "position": 1,
    "text": "نبیند هم از شاه و موبد به نیز"
  },
  {
    "poem_id": 1813,
    "vorder": 73,
    "position": 0,
    "text": "برین‌گونه چون نامه پیوسته شد"
  },
  {
    "poem_id": 1813,
    "vorder": 74,
    "position": 1,
    "text": "ز خون ریختن شاه دل خسته شد"
  },
  {
    "poem_id": 1813,
    "vorder": 75,
    "position": 0,
    "text": "به هر کشوری کارداری گزید"
  },
  {
    "poem_id": 1813,
    "vorder": 76,
    "position": 1,
    "text": "پر از داد و دانش چنانچون سزید"
  },
  {
    "poem_id": 1813,
    "vorder": 77,
    "position": 0,
    "text": "هم از گنج بد پوشش و خوردشان"
  },
  {
    "poem_id": 1813,
    "vorder": 78,
    "position": 1,
    "text": "ز پوشیدن و باز گستردشان"
  },
  {
    "poem_id": 1813,
    "vorder": 79,
    "position": 0,
    "text": "که شش ماه دیوان بیاراستی"
  },
  {
    "poem_id": 1813,
    "vorder": 80,
    "position": 1,
    "text": "وزان زیردستان درم خواستی"
  },
  {
    "poem_id": 1813,
    "vorder": 81,
    "position": 0,
    "text": "نهادی بران سیم نام خراج"
  },
  {
    "poem_id": 1813,
    "vorder": 82,
    "position": 1,
    "text": "به دیوان ستاننده با فر و تاج"
  },
  {
    "poem_id": 1813,
    "vorder": 83,
    "position": 0,
    "text": "به شش ماه بستد به شش باز داد"
  },
  {
    "poem_id": 1813,
    "vorder": 84,
    "position": 1,
    "text": "نبودی ستاننده زان سیم شاد"
  },
  {
    "poem_id": 1813,
    "vorder": 85,
    "position": 0,
    "text": "بدان چاره تا مرد پیکار خون"
  },
  {
    "poem_id": 1813,
    "vorder": 86,
    "position": 1,
    "text": "نریزد نباشد به بد رهنمون"
  },
  {
    "poem_id": 1813,
    "vorder": 87,
    "position": 0,
    "text": "وزان پس نوشتند کارآگهان"
  },
  {
    "poem_id": 1813,
    "vorder": 88,
    "position": 1,
    "text": "که از داد وز ایمنی در جهان"
  },
  {
    "poem_id": 1813,
    "vorder": 89,
    "position": 0,
    "text": "که هر کش درم بد خراجش نبود"
  },
  {
    "poem_id": 1813,
    "vorder": 90,
    "position": 1,
    "text": "به سرش اندرون داوریها فزود"
  },
  {
    "poem_id": 1813,
    "vorder": 91,
    "position": 0,
    "text": "ز پری به کژی نهادند روی"
  },
  {
    "poem_id": 1813,
    "vorder": 92,
    "position": 1,
    "text": "پر از رنج گشتند و پرخاشجوی"
  },
  {
    "poem_id": 1813,
    "vorder": 93,
    "position": 0,
    "text": "چو آن نامه بر خواند بهرام گور"
  },
  {
    "poem_id": 1813,
    "vorder": 94,
    "position": 1,
    "text": "به دلش اندر افتاد زان کار شور"
  },
  {
    "poem_id": 1813,
    "vorder": 95,
    "position": 0,
    "text": "ز هر کشوری مرزبانی گزید"
  },
  {
    "poem_id": 1813,
    "vorder": 96,
    "position": 1,
    "text": "پر از داد دلشان چنانچون سزید"
  },
  {
    "poem_id": 1813,
    "vorder": 97,
    "position": 0,
    "text": "به درگاه یکساله روزی بداد"
  },
  {
    "poem_id": 1813,
    "vorder": 98,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1813,
    "vorder": 99,
    "position": 0,
    "text": "بفرمود کان را که ریزند خون"
  },
  {
    "poem_id": 1813,
    "vorder": 100,
    "position": 1,
    "text": "گر آرند کژی به کار اندرون"
  },
  {
    "poem_id": 1813,
    "vorder": 101,
    "position": 0,
    "text": "برانند فرمان یزدان بروی"
  },
  {
    "poem_id": 1813,
    "vorder": 102,
    "position": 1,
    "text": "بدان تا شود هرکسی چاره‌جوی"
  },
  {
    "poem_id": 1813,
    "vorder": 103,
    "position": 0,
    "text": "برآمد برین بر بسی روزگار"
  },
  {
    "poem_id": 1813,
    "vorder": 104,
    "position": 1,
    "text": "یکی نامه فرمود پس شهریار"
  },
  {
    "poem_id": 1813,
    "vorder": 105,
    "position": 0,
    "text": "سوی راستگویان و کارآگهان"
  },
  {
    "poem_id": 1813,
    "vorder": 106,
    "position": 1,
    "text": "کجا او پراگنده بد در جهان"
  },
  {
    "poem_id": 1813,
    "vorder": 107,
    "position": 0,
    "text": "که اندر جهان چیست ناسودمند"
  },
  {
    "poem_id": 1813,
    "vorder": 108,
    "position": 1,
    "text": "که آرد برین پادشاهی گزند"
  },
  {
    "poem_id": 1813,
    "vorder": 109,
    "position": 0,
    "text": "نوشتند پاسخ که از داد شاه"
  },
  {
    "poem_id": 1813,
    "vorder": 110,
    "position": 1,
    "text": "نگردد کسی گرد آیین و راه"
  },
  {
    "poem_id": 1813,
    "vorder": 111,
    "position": 0,
    "text": "بشد رای و اندیشهٔ کشت و ورز"
  },
  {
    "poem_id": 1813,
    "vorder": 112,
    "position": 1,
    "text": "به هر کشوری راست بیکار مرز"
  },
  {
    "poem_id": 1813,
    "vorder": 113,
    "position": 0,
    "text": "پراگنده بینیم گاوان کار"
  },
  {
    "poem_id": 1813,
    "vorder": 114,
    "position": 1,
    "text": "گیا رست از دشت وز کشت‌زار"
  },
  {
    "poem_id": 1813,
    "vorder": 115,
    "position": 0,
    "text": "چنین داد پاسخ که تا نیم‌روز"
  },
  {
    "poem_id": 1813,
    "vorder": 116,
    "position": 1,
    "text": "که بالا کند تاج گیتی فروز"
  },
  {
    "poem_id": 1813,
    "vorder": 117,
    "position": 0,
    "text": "نباید کس آسود از کشت و ورز"
  },
  {
    "poem_id": 1813,
    "vorder": 118,
    "position": 1,
    "text": "ز بی‌ارز مردم مجویید ارز"
  },
  {
    "poem_id": 1813,
    "vorder": 119,
    "position": 0,
    "text": "که بی‌کار مردم ز بی‌دانشیست"
  },
  {
    "poem_id": 1813,
    "vorder": 120,
    "position": 1,
    "text": "به بی دانشان بر بباید گریست"
  },
  {
    "poem_id": 1813,
    "vorder": 121,
    "position": 0,
    "text": "ورا داد باید دو و چار دانگ"
  },
  {
    "poem_id": 1813,
    "vorder": 122,
    "position": 1,
    "text": "چو شد گرسنه تا نیاید به بانگ"
  },
  {
    "poem_id": 1813,
    "vorder": 123,
    "position": 0,
    "text": "کسی کو ندارد بر و تخم و گاو"
  },
  {
    "poem_id": 1813,
    "vorder": 124,
    "position": 1,
    "text": "تو با او به تندی و زفتی مکاو"
  },
  {
    "poem_id": 1813,
    "vorder": 125,
    "position": 0,
    "text": "به خوبی نوا کن مر او را به گنج"
  },
  {
    "poem_id": 1813,
    "vorder": 126,
    "position": 1,
    "text": "کس از نیستی تا نیاید به رنج"
  },
  {
    "poem_id": 1813,
    "vorder": 127,
    "position": 0,
    "text": "گر ایدونک باشد زیان از هوا"
  },
  {
    "poem_id": 1813,
    "vorder": 128,
    "position": 1,
    "text": "نباشد کسی بر هوا پادشا"
  },
  {
    "poem_id": 1813,
    "vorder": 129,
    "position": 0,
    "text": "چو جایی بپوشد زمین را ملخ"
  },
  {
    "poem_id": 1813,
    "vorder": 130,
    "position": 1,
    "text": "برد سبزی کشتمندان به شخ"
  },
  {
    "poem_id": 1813,
    "vorder": 131,
    "position": 0,
    "text": "تو از گنج تاوان او بازده"
  },
  {
    "poem_id": 1813,
    "vorder": 132,
    "position": 1,
    "text": "به کشور ز فرموده آواز ده"
  },
  {
    "poem_id": 1813,
    "vorder": 133,
    "position": 0,
    "text": "وگر بر زمین گورگاهی بود"
  },
  {
    "poem_id": 1813,
    "vorder": 134,
    "position": 1,
    "text": "وگر نابرومند راهی بود"
  },
  {
    "poem_id": 1813,
    "vorder": 135,
    "position": 0,
    "text": "که ناکشته باشد به گرد جهان"
  },
  {
    "poem_id": 1813,
    "vorder": 136,
    "position": 1,
    "text": "زمین فرومایگان و مهان"
  },
  {
    "poem_id": 1813,
    "vorder": 137,
    "position": 0,
    "text": "کسی کو بدین پایکار منست"
  },
  {
    "poem_id": 1813,
    "vorder": 138,
    "position": 1,
    "text": "وگر ویژه پروردگار منست"
  },
  {
    "poem_id": 1813,
    "vorder": 139,
    "position": 0,
    "text": "کنم زنده در گور جایی که هست"
  },
  {
    "poem_id": 1813,
    "vorder": 140,
    "position": 1,
    "text": "مبادش نشیمن مبادش نشست"
  },
  {
    "poem_id": 1813,
    "vorder": 141,
    "position": 0,
    "text": "نهادند بر نامه بر مهر شاه"
  },
  {
    "poem_id": 1813,
    "vorder": 142,
    "position": 1,
    "text": "هیونی برافگند هر سو به راه"
  }
]