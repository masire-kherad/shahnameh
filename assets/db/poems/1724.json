[
  {
    "poem_id": 1724,
    "vorder": 1,
    "position": 0,
    "text": "همی بود شاپور با داد و رای"
  },
  {
    "poem_id": 1724,
    "vorder": 2,
    "position": 1,
    "text": "بلنداختر و تخت شاهی به جای"
  },
  {
    "poem_id": 1724,
    "vorder": 3,
    "position": 0,
    "text": "چو سی سال بگذشت بر سر دو ماه"
  },
  {
    "poem_id": 1724,
    "vorder": 4,
    "position": 1,
    "text": "پراگنده شد فر و اورنگ شاه"
  },
  {
    "poem_id": 1724,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا رفت پیش اورمزد"
  },
  {
    "poem_id": 1724,
    "vorder": 6,
    "position": 1,
    "text": "بدو گفت کای چون گل اندر فرزد"
  },
  {
    "poem_id": 1724,
    "vorder": 7,
    "position": 0,
    "text": "تو بیدار باش و جهاندار باش"
  },
  {
    "poem_id": 1724,
    "vorder": 8,
    "position": 1,
    "text": "جهاندیدگان را خریدار باش"
  },
  {
    "poem_id": 1724,
    "vorder": 9,
    "position": 0,
    "text": "نگر تا به شاهی ندارد امید"
  },
  {
    "poem_id": 1724,
    "vorder": 10,
    "position": 1,
    "text": "بخوان روز و شب دفتر جمشید"
  },
  {
    "poem_id": 1724,
    "vorder": 11,
    "position": 0,
    "text": "بجز داد و خوبی مکن در جهان"
  },
  {
    "poem_id": 1724,
    "vorder": 12,
    "position": 1,
    "text": "پناه کهان باش و فر مهان"
  },
  {
    "poem_id": 1724,
    "vorder": 13,
    "position": 0,
    "text": "به دینار کم ناز و بخشنده باش"
  },
  {
    "poem_id": 1724,
    "vorder": 14,
    "position": 1,
    "text": "همان دادده باش و فرخنده باش"
  },
  {
    "poem_id": 1724,
    "vorder": 15,
    "position": 0,
    "text": "مزن بر کم‌آزار بانگ بلند"
  },
  {
    "poem_id": 1724,
    "vorder": 16,
    "position": 1,
    "text": "چو خواهی که بختت بود یارمند"
  },
  {
    "poem_id": 1724,
    "vorder": 17,
    "position": 0,
    "text": "همه پند من سربسر یادگیر"
  },
  {
    "poem_id": 1724,
    "vorder": 18,
    "position": 1,
    "text": "چنان هم که من دارم از اردشیر"
  },
  {
    "poem_id": 1724,
    "vorder": 19,
    "position": 0,
    "text": "بگفت این و رنگ رخش زرد گشت"
  },
  {
    "poem_id": 1724,
    "vorder": 20,
    "position": 1,
    "text": "دل مرد برنا پر از درد گشت"
  },
  {
    "poem_id": 1724,
    "vorder": 21,
    "position": 0,
    "text": "چه سازی همی زین سرای سپنج"
  },
  {
    "poem_id": 1724,
    "vorder": 22,
    "position": 1,
    "text": "چه نازی به نام و چه نازی به گنج"
  },
  {
    "poem_id": 1724,
    "vorder": 23,
    "position": 0,
    "text": "ترا تنگ تابوت بهرست و بس"
  },
  {
    "poem_id": 1724,
    "vorder": 24,
    "position": 1,
    "text": "خورد گنج تو ناسزاوار کس"
  },
  {
    "poem_id": 1724,
    "vorder": 25,
    "position": 0,
    "text": "نگیرد ز تو یاد فرزند تو"
  },
  {
    "poem_id": 1724,
    "vorder": 26,
    "position": 1,
    "text": "نه نزدیک خویشان و پیوند تو"
  },
  {
    "poem_id": 1724,
    "vorder": 27,
    "position": 0,
    "text": "ز میراث دشنام باشدت بهر"
  },
  {
    "poem_id": 1724,
    "vorder": 28,
    "position": 1,
    "text": "همه زهر شد پاسخ پای‌زهر"
  },
  {
    "poem_id": 1724,
    "vorder": 29,
    "position": 0,
    "text": "به یزدان گرای و سخن زو فزای"
  },
  {
    "poem_id": 1724,
    "vorder": 30,
    "position": 1,
    "text": "که اویست روزی ده و رهنمای"
  },
  {
    "poem_id": 1724,
    "vorder": 31,
    "position": 0,
    "text": "درود تو بر گور پیغمبرش"
  },
  {
    "poem_id": 1724,
    "vorder": 32,
    "position": 1,
    "text": "که صلوات تاجست بر منبرش"
  }
]