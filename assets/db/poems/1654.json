[
  {
    "poem_id": 1654,
    "vorder": 1,
    "position": 0,
    "text": "ز میلاد چون باد لشکر براند"
  },
  {
    "poem_id": 1654,
    "vorder": 2,
    "position": 1,
    "text": "به قنوج شد گنجش آنجا بماند"
  },
  {
    "poem_id": 1654,
    "vorder": 3,
    "position": 0,
    "text": "چو آورد لشکر به نزدیک فور"
  },
  {
    "poem_id": 1654,
    "vorder": 4,
    "position": 1,
    "text": "یکی نامه فرمود پر جنگ و شور"
  },
  {
    "poem_id": 1654,
    "vorder": 5,
    "position": 0,
    "text": "ز شاهنشه اسکندر فیلقوس"
  },
  {
    "poem_id": 1654,
    "vorder": 6,
    "position": 1,
    "text": "فروزندهٔ آتش و نعم و بوس"
  },
  {
    "poem_id": 1654,
    "vorder": 7,
    "position": 0,
    "text": "سوی فور هندی سپهدار هند"
  },
  {
    "poem_id": 1654,
    "vorder": 8,
    "position": 1,
    "text": "بلند اختر و لشکر آرای سند"
  },
  {
    "poem_id": 1654,
    "vorder": 9,
    "position": 0,
    "text": "سر نامه کرد آفرین خدای"
  },
  {
    "poem_id": 1654,
    "vorder": 10,
    "position": 1,
    "text": "کجا بود و باشد همیشه به جای"
  },
  {
    "poem_id": 1654,
    "vorder": 11,
    "position": 0,
    "text": "کسی را که او کرد پیروزبخت"
  },
  {
    "poem_id": 1654,
    "vorder": 12,
    "position": 1,
    "text": "بماند بدو کشور و تاج و تخت"
  },
  {
    "poem_id": 1654,
    "vorder": 13,
    "position": 0,
    "text": "گرش خوار گیرد بماند نژد"
  },
  {
    "poem_id": 1654,
    "vorder": 14,
    "position": 1,
    "text": "نتابد برو آفتاب بلند"
  },
  {
    "poem_id": 1654,
    "vorder": 15,
    "position": 0,
    "text": "شنیدی همانا که یزدان پاک"
  },
  {
    "poem_id": 1654,
    "vorder": 16,
    "position": 1,
    "text": "چه دادست ما را بدین تیره خاک"
  },
  {
    "poem_id": 1654,
    "vorder": 17,
    "position": 0,
    "text": "ز پیروزی و بخت وز فرهی"
  },
  {
    "poem_id": 1654,
    "vorder": 18,
    "position": 1,
    "text": "ز دیهیم وز تخت شاهنشهی"
  },
  {
    "poem_id": 1654,
    "vorder": 19,
    "position": 0,
    "text": "نماند همی روز ما بگذرد"
  },
  {
    "poem_id": 1654,
    "vorder": 20,
    "position": 1,
    "text": "کسی دیگر آید کزو بر خورد"
  },
  {
    "poem_id": 1654,
    "vorder": 21,
    "position": 0,
    "text": "همی نام کوشم که ماند نه ننگ"
  },
  {
    "poem_id": 1654,
    "vorder": 22,
    "position": 1,
    "text": "بدین مرکز ماه و پرگار تنگ"
  },
  {
    "poem_id": 1654,
    "vorder": 23,
    "position": 0,
    "text": "چو این نامه آرند نزدیک تو"
  },
  {
    "poem_id": 1654,
    "vorder": 24,
    "position": 1,
    "text": "بی‌آزار کن رای تاریک تو"
  },
  {
    "poem_id": 1654,
    "vorder": 25,
    "position": 0,
    "text": "ز تخت بلندی به اسپ اندر آی"
  },
  {
    "poem_id": 1654,
    "vorder": 26,
    "position": 1,
    "text": "مزن رای با موبد و رهنمای"
  },
  {
    "poem_id": 1654,
    "vorder": 27,
    "position": 0,
    "text": "ز ما ایمنی خواه و چاره مساز"
  },
  {
    "poem_id": 1654,
    "vorder": 28,
    "position": 1,
    "text": "که بر چاره‌گر کار گردد دراز"
  },
  {
    "poem_id": 1654,
    "vorder": 29,
    "position": 0,
    "text": "ز فرمان اگر یک زمان بگذری"
  },
  {
    "poem_id": 1654,
    "vorder": 30,
    "position": 1,
    "text": "بلندی گزینی و کنداوری"
  },
  {
    "poem_id": 1654,
    "vorder": 31,
    "position": 0,
    "text": "بیارم چو آتش سپاهی گران"
  },
  {
    "poem_id": 1654,
    "vorder": 32,
    "position": 1,
    "text": "گزیده دلیران کنداوران"
  },
  {
    "poem_id": 1654,
    "vorder": 33,
    "position": 0,
    "text": "چو من باسواران بیایم به جنگ"
  },
  {
    "poem_id": 1654,
    "vorder": 34,
    "position": 1,
    "text": "پشیمانی آید ترا زین درنگ"
  },
  {
    "poem_id": 1654,
    "vorder": 35,
    "position": 0,
    "text": "چو زین باره گفتارها سخته شد"
  },
  {
    "poem_id": 1654,
    "vorder": 36,
    "position": 1,
    "text": "نویسنده از نامه پردخته شد"
  },
  {
    "poem_id": 1654,
    "vorder": 37,
    "position": 0,
    "text": "نهادند مهر سکندر به روی"
  },
  {
    "poem_id": 1654,
    "vorder": 38,
    "position": 1,
    "text": "بجستند پیدا یکی نامجوی"
  },
  {
    "poem_id": 1654,
    "vorder": 39,
    "position": 0,
    "text": "فرستاده شاهش به نزدیک فور"
  },
  {
    "poem_id": 1654,
    "vorder": 40,
    "position": 1,
    "text": "گهی رزم گفتی گهی بزم و سور"
  },
  {
    "poem_id": 1654,
    "vorder": 41,
    "position": 0,
    "text": "فرستاده آمد به درگه فراز"
  },
  {
    "poem_id": 1654,
    "vorder": 42,
    "position": 1,
    "text": "بگفتند با فور گردن فراز"
  },
  {
    "poem_id": 1654,
    "vorder": 43,
    "position": 0,
    "text": "جهاندیده را پیش او خواندند"
  },
  {
    "poem_id": 1654,
    "vorder": 44,
    "position": 1,
    "text": "بر تخت نزدیک بنشاندند"
  }
]