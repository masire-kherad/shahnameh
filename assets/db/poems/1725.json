[
  {
    "poem_id": 1725,
    "vorder": 1,
    "position": 0,
    "text": "سر گاه و دیهیم شاه اورمزد"
  },
  {
    "poem_id": 1725,
    "vorder": 2,
    "position": 1,
    "text": "بیارایم اکنون چو ماه اورمزد"
  },
  {
    "poem_id": 1725,
    "vorder": 3,
    "position": 0,
    "text": "ز شاهی برو هیچ تاوان نبود"
  },
  {
    "poem_id": 1725,
    "vorder": 4,
    "position": 1,
    "text": "ازان بد که عهدش فراوان نبود"
  },
  {
    "poem_id": 1725,
    "vorder": 5,
    "position": 0,
    "text": "چو بنشست شاه اورمزد بزرگ"
  },
  {
    "poem_id": 1725,
    "vorder": 6,
    "position": 1,
    "text": "به آبشخور آمد همی میش و گرگ"
  },
  {
    "poem_id": 1725,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت کای نامور بخردان"
  },
  {
    "poem_id": 1725,
    "vorder": 8,
    "position": 1,
    "text": "جهان گشته و کار دیده ردان"
  },
  {
    "poem_id": 1725,
    "vorder": 9,
    "position": 0,
    "text": "بکوشیم تا نیکی آریم و داد"
  },
  {
    "poem_id": 1725,
    "vorder": 10,
    "position": 1,
    "text": "خنک آنک پند پدر کرد یاد"
  },
  {
    "poem_id": 1725,
    "vorder": 11,
    "position": 0,
    "text": "چو یزدان نیکی‌دهش نیکوی"
  },
  {
    "poem_id": 1725,
    "vorder": 12,
    "position": 1,
    "text": "بما داد و تاج سر خسروی"
  },
  {
    "poem_id": 1725,
    "vorder": 13,
    "position": 0,
    "text": "به نیکی کنم ویژه انبازتان"
  },
  {
    "poem_id": 1725,
    "vorder": 14,
    "position": 1,
    "text": "نخواهم که بی من بود رازتان"
  },
  {
    "poem_id": 1725,
    "vorder": 15,
    "position": 0,
    "text": "بدانید کان کو منی فش بود"
  },
  {
    "poem_id": 1725,
    "vorder": 16,
    "position": 1,
    "text": "بر مهتران سخت ناخوش بود"
  },
  {
    "poem_id": 1725,
    "vorder": 17,
    "position": 0,
    "text": "ستیره بود مرد را پیش رو"
  },
  {
    "poem_id": 1725,
    "vorder": 18,
    "position": 1,
    "text": "بماند نیازش همه ساله نو"
  },
  {
    "poem_id": 1725,
    "vorder": 19,
    "position": 0,
    "text": "همان رشک شمشیر نادان بود"
  },
  {
    "poem_id": 1725,
    "vorder": 20,
    "position": 1,
    "text": "همیشه برو بخت خندان بود"
  },
  {
    "poem_id": 1725,
    "vorder": 21,
    "position": 0,
    "text": "دگر هرک دارد ز هر کار ننگ"
  },
  {
    "poem_id": 1725,
    "vorder": 22,
    "position": 1,
    "text": "بود زندگانی و روزیش تنگ"
  },
  {
    "poem_id": 1725,
    "vorder": 23,
    "position": 0,
    "text": "در آز باشد دل سفله مرد"
  },
  {
    "poem_id": 1725,
    "vorder": 24,
    "position": 1,
    "text": "بر سفلگان تا توانی مگرد"
  },
  {
    "poem_id": 1725,
    "vorder": 25,
    "position": 0,
    "text": "هرانکس که دانش نیابی برش"
  },
  {
    "poem_id": 1725,
    "vorder": 26,
    "position": 1,
    "text": "مکن ره‌گذر تازید بر درش"
  },
  {
    "poem_id": 1725,
    "vorder": 27,
    "position": 0,
    "text": "به مرد خردمند و فرهنگ و رای"
  },
  {
    "poem_id": 1725,
    "vorder": 28,
    "position": 1,
    "text": "بود جاودان تخت شاهی به پای"
  },
  {
    "poem_id": 1725,
    "vorder": 29,
    "position": 0,
    "text": "دلت زنده باشد به فرهنگ و هوش"
  },
  {
    "poem_id": 1725,
    "vorder": 30,
    "position": 1,
    "text": "به بد در جهان تا توانی مکوش"
  },
  {
    "poem_id": 1725,
    "vorder": 31,
    "position": 0,
    "text": "خرد همچو آبست و دانش زمین"
  },
  {
    "poem_id": 1725,
    "vorder": 32,
    "position": 1,
    "text": "بدان کاین جدا و آن جدا نیست زین"
  },
  {
    "poem_id": 1725,
    "vorder": 33,
    "position": 0,
    "text": "دل شاه کز مهر دوری گرفت"
  },
  {
    "poem_id": 1725,
    "vorder": 34,
    "position": 1,
    "text": "اگر بازگردد نباشد شگفت"
  },
  {
    "poem_id": 1725,
    "vorder": 35,
    "position": 0,
    "text": "هرانکس که باشد مرا زیردست"
  },
  {
    "poem_id": 1725,
    "vorder": 36,
    "position": 1,
    "text": "همه شادمان باد و یزدان‌پرست"
  },
  {
    "poem_id": 1725,
    "vorder": 37,
    "position": 0,
    "text": "به خشنودی کردگار جهان"
  },
  {
    "poem_id": 1725,
    "vorder": 38,
    "position": 1,
    "text": "خرد یار باد آشکار و نهان"
  },
  {
    "poem_id": 1725,
    "vorder": 39,
    "position": 0,
    "text": "خردمند گر مردم پارسا"
  },
  {
    "poem_id": 1725,
    "vorder": 40,
    "position": 1,
    "text": "چو جایی سخن راند از پادشا"
  },
  {
    "poem_id": 1725,
    "vorder": 41,
    "position": 0,
    "text": "همه سخته باید که راند سخن"
  },
  {
    "poem_id": 1725,
    "vorder": 42,
    "position": 1,
    "text": "که گفتار نیکو نگردد کهن"
  },
  {
    "poem_id": 1725,
    "vorder": 43,
    "position": 0,
    "text": "نباید که گویی به جز نیکوی"
  },
  {
    "poem_id": 1725,
    "vorder": 44,
    "position": 1,
    "text": "وگر بد سراید نگر نشنوی"
  },
  {
    "poem_id": 1725,
    "vorder": 45,
    "position": 0,
    "text": "ببیند دل پادشا راز تو"
  },
  {
    "poem_id": 1725,
    "vorder": 46,
    "position": 1,
    "text": "همان بشنود گوش آواز تو"
  },
  {
    "poem_id": 1725,
    "vorder": 47,
    "position": 0,
    "text": "چه گفت آن سخن‌گوی پاسخ نیوش"
  },
  {
    "poem_id": 1725,
    "vorder": 48,
    "position": 1,
    "text": "که دیوار دارد به گفتار گوش"
  },
  {
    "poem_id": 1725,
    "vorder": 49,
    "position": 0,
    "text": "همه انجمن خواندند آفرین"
  },
  {
    "poem_id": 1725,
    "vorder": 50,
    "position": 1,
    "text": "بران شاه بینادل و پاک‌دین"
  },
  {
    "poem_id": 1725,
    "vorder": 51,
    "position": 0,
    "text": "پراگنده گشت آن بزرگ انجمن"
  },
  {
    "poem_id": 1725,
    "vorder": 52,
    "position": 1,
    "text": "همه شاد زان سرو سایه فگن"
  },
  {
    "poem_id": 1725,
    "vorder": 53,
    "position": 0,
    "text": "همان رسم شاپور شاه اردشیر"
  },
  {
    "poem_id": 1725,
    "vorder": 54,
    "position": 1,
    "text": "همی داشت آن شاه دانش‌پذیر"
  },
  {
    "poem_id": 1725,
    "vorder": 55,
    "position": 0,
    "text": "جهانی سراسر بدو گشت شاد"
  },
  {
    "poem_id": 1725,
    "vorder": 56,
    "position": 1,
    "text": "چه نیکو بود شاه با بخش و داد"
  },
  {
    "poem_id": 1725,
    "vorder": 57,
    "position": 0,
    "text": "همی راند با شرم و با داد کار"
  },
  {
    "poem_id": 1725,
    "vorder": 58,
    "position": 1,
    "text": "چنین تا برآمد برین روزگار"
  },
  {
    "poem_id": 1725,
    "vorder": 59,
    "position": 0,
    "text": "بگسترد کافور بر جای مشک"
  },
  {
    "poem_id": 1725,
    "vorder": 60,
    "position": 1,
    "text": "گل و ارغوان شد به پالیز خشک"
  },
  {
    "poem_id": 1725,
    "vorder": 61,
    "position": 0,
    "text": "سهی سرو او گشت همچون کمان"
  },
  {
    "poem_id": 1725,
    "vorder": 62,
    "position": 1,
    "text": "نه آن بود کان شاه را بدگمان"
  },
  {
    "poem_id": 1725,
    "vorder": 63,
    "position": 0,
    "text": "نبود از جهان شاد بس روزگار"
  },
  {
    "poem_id": 1725,
    "vorder": 64,
    "position": 1,
    "text": "سرآمد بران دادگر شهریار"
  }
]