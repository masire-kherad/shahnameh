[
  {
    "poem_id": 1385,
    "vorder": 1,
    "position": 0,
    "text": "رسیدند خوبان به درگاه کاخ"
  },
  {
    "poem_id": 1385,
    "vorder": 2,
    "position": 1,
    "text": "به دست اندرون هر یک از گل دو شاخ"
  },
  {
    "poem_id": 1385,
    "vorder": 3,
    "position": 0,
    "text": "نگه کرد دربان برآراست جنگ"
  },
  {
    "poem_id": 1385,
    "vorder": 4,
    "position": 1,
    "text": "زبان کرد گستاخ و دل کرد تنگ"
  },
  {
    "poem_id": 1385,
    "vorder": 5,
    "position": 0,
    "text": "که بی‌گه ز درگاه بیرون شوید"
  },
  {
    "poem_id": 1385,
    "vorder": 6,
    "position": 1,
    "text": "شگفت آیدم تا شما چون شوید"
  },
  {
    "poem_id": 1385,
    "vorder": 7,
    "position": 0,
    "text": "بتان پاسخش را بیاراستند"
  },
  {
    "poem_id": 1385,
    "vorder": 8,
    "position": 1,
    "text": "به تنگی دل از جای برخاستند"
  },
  {
    "poem_id": 1385,
    "vorder": 9,
    "position": 0,
    "text": "که امروز روزی دگر گونه نیست"
  },
  {
    "poem_id": 1385,
    "vorder": 10,
    "position": 1,
    "text": "به راه گلان دیو واژونه نیست"
  },
  {
    "poem_id": 1385,
    "vorder": 11,
    "position": 0,
    "text": "بهار آمد ازگلستان گل چنیم"
  },
  {
    "poem_id": 1385,
    "vorder": 12,
    "position": 1,
    "text": "ز روی زمین شاخ سنبل چنیم"
  },
  {
    "poem_id": 1385,
    "vorder": 13,
    "position": 0,
    "text": "نگهبان در گفت کامروز کار"
  },
  {
    "poem_id": 1385,
    "vorder": 14,
    "position": 1,
    "text": "نباید گرفتن بدان هم شمار"
  },
  {
    "poem_id": 1385,
    "vorder": 15,
    "position": 0,
    "text": "که زال سپهبد بکابل نبود"
  },
  {
    "poem_id": 1385,
    "vorder": 16,
    "position": 1,
    "text": "سراپردهٔ شاه زابل نبود"
  },
  {
    "poem_id": 1385,
    "vorder": 17,
    "position": 0,
    "text": "نبینید کز کاخ کابل خدای"
  },
  {
    "poem_id": 1385,
    "vorder": 18,
    "position": 1,
    "text": "به زین اندر آرد بشبگیر پای"
  },
  {
    "poem_id": 1385,
    "vorder": 19,
    "position": 0,
    "text": "اگرتان ببیند چنین گل بدست"
  },
  {
    "poem_id": 1385,
    "vorder": 20,
    "position": 1,
    "text": "کند بر زمین‌تان هم آنگاه پست"
  },
  {
    "poem_id": 1385,
    "vorder": 21,
    "position": 0,
    "text": "شدند اندر ایوان بتان طراز"
  },
  {
    "poem_id": 1385,
    "vorder": 22,
    "position": 1,
    "text": "نشستند و با ماه گفتند راز"
  },
  {
    "poem_id": 1385,
    "vorder": 23,
    "position": 0,
    "text": "نهادند دینار و گوهر به پیش"
  },
  {
    "poem_id": 1385,
    "vorder": 24,
    "position": 1,
    "text": "بپرسید رودابه از کم و بیش"
  },
  {
    "poem_id": 1385,
    "vorder": 25,
    "position": 0,
    "text": "که چون بودتان کار با پور سام"
  },
  {
    "poem_id": 1385,
    "vorder": 26,
    "position": 1,
    "text": "بدیدن بهست ار به آواز و نام"
  },
  {
    "poem_id": 1385,
    "vorder": 27,
    "position": 0,
    "text": "پری چهره هر پنج بشتافتند"
  },
  {
    "poem_id": 1385,
    "vorder": 28,
    "position": 1,
    "text": "چو با ماه جای سخن یافتند"
  },
  {
    "poem_id": 1385,
    "vorder": 29,
    "position": 0,
    "text": "که مردیست برسان سرو سهی"
  },
  {
    "poem_id": 1385,
    "vorder": 30,
    "position": 1,
    "text": "همش زیب و هم فر شاهنشهی"
  },
  {
    "poem_id": 1385,
    "vorder": 31,
    "position": 0,
    "text": "همش رنگ و بوی و همش قد و شاخ"
  },
  {
    "poem_id": 1385,
    "vorder": 32,
    "position": 1,
    "text": "سواری میان لاغر و بر فراخ"
  },
  {
    "poem_id": 1385,
    "vorder": 33,
    "position": 0,
    "text": "دو چشمش چو دو نرگس قیرگون"
  },
  {
    "poem_id": 1385,
    "vorder": 34,
    "position": 1,
    "text": "لبانش چو بسد رخانش چو خون"
  },
  {
    "poem_id": 1385,
    "vorder": 35,
    "position": 0,
    "text": "کف و ساعدش چو کف شیر نر"
  },
  {
    "poem_id": 1385,
    "vorder": 36,
    "position": 1,
    "text": "هیون ران و موبد دل و شاه فر"
  },
  {
    "poem_id": 1385,
    "vorder": 37,
    "position": 0,
    "text": "سراسر سپیدست مویش برنگ"
  },
  {
    "poem_id": 1385,
    "vorder": 38,
    "position": 1,
    "text": "از آهو همین است و این نیست ننگ"
  },
  {
    "poem_id": 1385,
    "vorder": 39,
    "position": 0,
    "text": "سر جعد آن پهلوان جهان"
  },
  {
    "poem_id": 1385,
    "vorder": 40,
    "position": 1,
    "text": "چو سیمین زره بر گل ارغوان"
  },
  {
    "poem_id": 1385,
    "vorder": 41,
    "position": 0,
    "text": "که گویی همی خود چنان بایدی"
  },
  {
    "poem_id": 1385,
    "vorder": 42,
    "position": 1,
    "text": "وگر نیستی مهر نفزایدی"
  },
  {
    "poem_id": 1385,
    "vorder": 43,
    "position": 0,
    "text": "به دیار تو داده‌ایمش نوید"
  },
  {
    "poem_id": 1385,
    "vorder": 44,
    "position": 1,
    "text": "ز ما بازگشتست دل پرامید"
  },
  {
    "poem_id": 1385,
    "vorder": 45,
    "position": 0,
    "text": "کنون چارهٔ کار مهمان بساز"
  },
  {
    "poem_id": 1385,
    "vorder": 46,
    "position": 1,
    "text": "بفرمای تا بر چه گردیم باز"
  },
  {
    "poem_id": 1385,
    "vorder": 47,
    "position": 0,
    "text": "چنین گفت با بندگان سرو بن"
  },
  {
    "poem_id": 1385,
    "vorder": 48,
    "position": 1,
    "text": "که دیگر شدستی به رای و سخن"
  },
  {
    "poem_id": 1385,
    "vorder": 49,
    "position": 0,
    "text": "همان زال کو مرغ پرورده بود"
  },
  {
    "poem_id": 1385,
    "vorder": 50,
    "position": 1,
    "text": "چنان پیر سر بود و پژمرده بود"
  },
  {
    "poem_id": 1385,
    "vorder": 51,
    "position": 0,
    "text": "به دیدار شد چون گل ارغوان"
  },
  {
    "poem_id": 1385,
    "vorder": 52,
    "position": 1,
    "text": "سهی قد و زیبا رخ و پهلوان"
  },
  {
    "poem_id": 1385,
    "vorder": 53,
    "position": 0,
    "text": "رخ من به پیشش بیاراستی"
  },
  {
    "poem_id": 1385,
    "vorder": 54,
    "position": 1,
    "text": "به گفتار و زان پس بهاخواستی"
  },
  {
    "poem_id": 1385,
    "vorder": 55,
    "position": 0,
    "text": "همی گفت و لب را پر از خنده داشت"
  },
  {
    "poem_id": 1385,
    "vorder": 56,
    "position": 1,
    "text": "رخان هم چو گلنار آگنده داشت"
  },
  {
    "poem_id": 1385,
    "vorder": 57,
    "position": 0,
    "text": "پرستنده با بانوی ماه‌روی"
  },
  {
    "poem_id": 1385,
    "vorder": 58,
    "position": 1,
    "text": "چنین گفت کاکنون ره چاره جوی"
  },
  {
    "poem_id": 1385,
    "vorder": 59,
    "position": 0,
    "text": "که یزدان هر آنچت هوا بود داد"
  },
  {
    "poem_id": 1385,
    "vorder": 60,
    "position": 1,
    "text": "سرانجام این کار فرخنده باد"
  },
  {
    "poem_id": 1385,
    "vorder": 61,
    "position": 0,
    "text": "یکی خانه بودش چو خرم بهار"
  },
  {
    "poem_id": 1385,
    "vorder": 62,
    "position": 1,
    "text": "ز چهر بزرگان برو بر نگار"
  },
  {
    "poem_id": 1385,
    "vorder": 63,
    "position": 0,
    "text": "به دیبای چینی بیاراستند"
  },
  {
    "poem_id": 1385,
    "vorder": 64,
    "position": 1,
    "text": "طبق‌های زرین بپیراستند"
  },
  {
    "poem_id": 1385,
    "vorder": 65,
    "position": 0,
    "text": "عقیق و زبرجد برو ریختند"
  },
  {
    "poem_id": 1385,
    "vorder": 66,
    "position": 1,
    "text": "می و مشک و عنبر برآمیختند"
  },
  {
    "poem_id": 1385,
    "vorder": 67,
    "position": 0,
    "text": "همه زر و پیروزه بد جامشان"
  },
  {
    "poem_id": 1385,
    "vorder": 68,
    "position": 1,
    "text": "به روشن گلاب اندر آشامشان"
  },
  {
    "poem_id": 1385,
    "vorder": 69,
    "position": 0,
    "text": "بنفشه گل و نرگس و ارغوان"
  },
  {
    "poem_id": 1385,
    "vorder": 70,
    "position": 1,
    "text": "سمن شاخ و سنبل به دیگر کران"
  },
  {
    "poem_id": 1385,
    "vorder": 71,
    "position": 0,
    "text": "از آن خانهٔ دخت خورشید روی"
  },
  {
    "poem_id": 1385,
    "vorder": 72,
    "position": 1,
    "text": "برآمد همی تا به خورشید بوی"
  }
]