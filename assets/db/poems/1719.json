[
  {
    "poem_id": 1719,
    "vorder": 1,
    "position": 0,
    "text": "چو بر تخت بنشست شاه اردشیر"
  },
  {
    "poem_id": 1719,
    "vorder": 2,
    "position": 1,
    "text": "بشد پیش گاهش یکی مرد پیر"
  },
  {
    "poem_id": 1719,
    "vorder": 3,
    "position": 0,
    "text": "کجا نام آن پیر خراد بود"
  },
  {
    "poem_id": 1719,
    "vorder": 4,
    "position": 1,
    "text": "زبان و روانش پر از داد بود"
  },
  {
    "poem_id": 1719,
    "vorder": 5,
    "position": 0,
    "text": "چنین داد پاسخ که ای شهریار"
  },
  {
    "poem_id": 1719,
    "vorder": 6,
    "position": 1,
    "text": "انوشه بدی تا بود روزگار"
  },
  {
    "poem_id": 1719,
    "vorder": 7,
    "position": 0,
    "text": "همیشه بوی شاد و پیروزبخت"
  },
  {
    "poem_id": 1719,
    "vorder": 8,
    "position": 1,
    "text": "به تو شادمان کشور و تاج و تخت"
  },
  {
    "poem_id": 1719,
    "vorder": 9,
    "position": 0,
    "text": "به جایی رسیدی که مرغ و دده"
  },
  {
    "poem_id": 1719,
    "vorder": 10,
    "position": 1,
    "text": "زنند از پس و پیش تختت رده"
  },
  {
    "poem_id": 1719,
    "vorder": 11,
    "position": 0,
    "text": "بزرگ جهان از کران تا کران"
  },
  {
    "poem_id": 1719,
    "vorder": 12,
    "position": 1,
    "text": "سرافراز بر تاجور مهتران"
  },
  {
    "poem_id": 1719,
    "vorder": 13,
    "position": 0,
    "text": "که داند صفت کردن از داد تو"
  },
  {
    "poem_id": 1719,
    "vorder": 14,
    "position": 1,
    "text": "که داد و بزرگیست بنیاد تو"
  },
  {
    "poem_id": 1719,
    "vorder": 15,
    "position": 0,
    "text": "همان آفرین در فزایش کنیم"
  },
  {
    "poem_id": 1719,
    "vorder": 16,
    "position": 1,
    "text": "خدای جهان را نیایش کنیم"
  },
  {
    "poem_id": 1719,
    "vorder": 17,
    "position": 0,
    "text": "که ما زنده اندر زمان توایم"
  },
  {
    "poem_id": 1719,
    "vorder": 18,
    "position": 1,
    "text": "به هر کار نیکی گمان توایم"
  },
  {
    "poem_id": 1719,
    "vorder": 19,
    "position": 0,
    "text": "خریدار دیدار چهر ترا"
  },
  {
    "poem_id": 1719,
    "vorder": 20,
    "position": 1,
    "text": "همان خوب گفتار و مهر ترا"
  },
  {
    "poem_id": 1719,
    "vorder": 21,
    "position": 0,
    "text": "تو ایمن بوی کز تو ما ایمنیم"
  },
  {
    "poem_id": 1719,
    "vorder": 22,
    "position": 1,
    "text": "مبادا که پیمان تو بشکنیم"
  },
  {
    "poem_id": 1719,
    "vorder": 23,
    "position": 0,
    "text": "تو بستی ره بدسگالان ما"
  },
  {
    "poem_id": 1719,
    "vorder": 24,
    "position": 1,
    "text": "ز هند و ز چین و همالان ما"
  },
  {
    "poem_id": 1719,
    "vorder": 25,
    "position": 0,
    "text": "پراگنده شد غارت و جنگ و موش"
  },
  {
    "poem_id": 1719,
    "vorder": 26,
    "position": 1,
    "text": "نیاید همی جوش دشمن به گوش"
  },
  {
    "poem_id": 1719,
    "vorder": 27,
    "position": 0,
    "text": "بماناد این شاه تا جاودان"
  },
  {
    "poem_id": 1719,
    "vorder": 28,
    "position": 1,
    "text": "همیشه سر و کار با موبدان"
  },
  {
    "poem_id": 1719,
    "vorder": 29,
    "position": 0,
    "text": "نه کس چون تو دارد ز شاهان خرد"
  },
  {
    "poem_id": 1719,
    "vorder": 30,
    "position": 1,
    "text": "نه اندیشه از رای تو بگذرد"
  },
  {
    "poem_id": 1719,
    "vorder": 31,
    "position": 0,
    "text": "پیی برفگندی به ایران ز داد"
  },
  {
    "poem_id": 1719,
    "vorder": 32,
    "position": 1,
    "text": "که فرزند ما باشد از داد شاد"
  },
  {
    "poem_id": 1719,
    "vorder": 33,
    "position": 0,
    "text": "به جایی رسیدی هم‌اندر سخن"
  },
  {
    "poem_id": 1719,
    "vorder": 34,
    "position": 1,
    "text": "که نو شد ز رای تو مرد کهن"
  },
  {
    "poem_id": 1719,
    "vorder": 35,
    "position": 0,
    "text": "خردها فزون شد ز گفتار تو"
  },
  {
    "poem_id": 1719,
    "vorder": 36,
    "position": 1,
    "text": "جهان گشت روشن به دیدار تو"
  },
  {
    "poem_id": 1719,
    "vorder": 37,
    "position": 0,
    "text": "بدین انجمن هرک دارد نژاد"
  },
  {
    "poem_id": 1719,
    "vorder": 38,
    "position": 1,
    "text": "به تو شادمانند وز داد شاد"
  },
  {
    "poem_id": 1719,
    "vorder": 39,
    "position": 0,
    "text": "توی خلعت ایزدی بخت را"
  },
  {
    "poem_id": 1719,
    "vorder": 40,
    "position": 1,
    "text": "کلاه و کمر بستن و تخت را"
  },
  {
    "poem_id": 1719,
    "vorder": 41,
    "position": 0,
    "text": "بماناد این شاه با مهر و داد"
  },
  {
    "poem_id": 1719,
    "vorder": 42,
    "position": 1,
    "text": "ندارد جهان چون تو خسرو به یاد"
  },
  {
    "poem_id": 1719,
    "vorder": 43,
    "position": 0,
    "text": "جهان یکسر از رای وز فر تست"
  },
  {
    "poem_id": 1719,
    "vorder": 44,
    "position": 1,
    "text": "خنک آنک در سایهٔ پر تست"
  },
  {
    "poem_id": 1719,
    "vorder": 45,
    "position": 0,
    "text": "همیشه سر تخت جای تو باد"
  },
  {
    "poem_id": 1719,
    "vorder": 46,
    "position": 1,
    "text": "جهان زیر فرمان و رای تو باد"
  }
]