[
  {
    "poem_id": 1414,
    "vorder": 1,
    "position": 0,
    "text": "و دیگر که از شهر ارمان شدند"
  },
  {
    "poem_id": 1414,
    "vorder": 2,
    "position": 1,
    "text": "به کینه سوی زابلستان شدند"
  },
  {
    "poem_id": 1414,
    "vorder": 3,
    "position": 0,
    "text": "شماساس کز پیش جیحون برفت"
  },
  {
    "poem_id": 1414,
    "vorder": 4,
    "position": 1,
    "text": "سوی سیستان روی بنهاد و تفت"
  },
  {
    "poem_id": 1414,
    "vorder": 5,
    "position": 0,
    "text": "خزروان ابا تیغ‌زن سی هزار"
  },
  {
    "poem_id": 1414,
    "vorder": 6,
    "position": 1,
    "text": "ز ترکان بزرگان خنجرگزار"
  },
  {
    "poem_id": 1414,
    "vorder": 7,
    "position": 0,
    "text": "برفتند بیدار تا هیرمند"
  },
  {
    "poem_id": 1414,
    "vorder": 8,
    "position": 1,
    "text": "ابا تیغ و با گرز و بخت بلند"
  },
  {
    "poem_id": 1414,
    "vorder": 9,
    "position": 0,
    "text": "ز بهر پدر زال با سوگ و درد"
  },
  {
    "poem_id": 1414,
    "vorder": 10,
    "position": 1,
    "text": "به گوراب اندر همی دخمه کرد"
  },
  {
    "poem_id": 1414,
    "vorder": 11,
    "position": 0,
    "text": "به شهر اندرون گرد مهراب بود"
  },
  {
    "poem_id": 1414,
    "vorder": 12,
    "position": 1,
    "text": "که روشن روان بود و بی‌خواب بود"
  },
  {
    "poem_id": 1414,
    "vorder": 13,
    "position": 0,
    "text": "فرستاده‌ای آمد از نزد اوی"
  },
  {
    "poem_id": 1414,
    "vorder": 14,
    "position": 1,
    "text": "به سوی شماساس بنهاد روی"
  },
  {
    "poem_id": 1414,
    "vorder": 15,
    "position": 0,
    "text": "به پیش سراپرده آمد فرود"
  },
  {
    "poem_id": 1414,
    "vorder": 16,
    "position": 1,
    "text": "ز مهراب دادش فراوان درود"
  },
  {
    "poem_id": 1414,
    "vorder": 17,
    "position": 0,
    "text": "که بیداردل شاه توران سپاه"
  },
  {
    "poem_id": 1414,
    "vorder": 18,
    "position": 1,
    "text": "بماناد تا جاودان با کلاه"
  },
  {
    "poem_id": 1414,
    "vorder": 19,
    "position": 0,
    "text": "ز ضحاک تازیست ما را نژاد"
  },
  {
    "poem_id": 1414,
    "vorder": 20,
    "position": 1,
    "text": "بدین پادشاهی نیم سخت شاد"
  },
  {
    "poem_id": 1414,
    "vorder": 21,
    "position": 0,
    "text": "به پیوستگی جان خریدم همی"
  },
  {
    "poem_id": 1414,
    "vorder": 22,
    "position": 1,
    "text": "جز این نیز چاره ندیدم همی"
  },
  {
    "poem_id": 1414,
    "vorder": 23,
    "position": 0,
    "text": "کنون این سرای و نشست منست"
  },
  {
    "poem_id": 1414,
    "vorder": 24,
    "position": 1,
    "text": "همان زاولستان به دست منست"
  },
  {
    "poem_id": 1414,
    "vorder": 25,
    "position": 0,
    "text": "ازایدر چو دستان بشد سوگوار"
  },
  {
    "poem_id": 1414,
    "vorder": 26,
    "position": 1,
    "text": "ز بهر ستودان سام سوار"
  },
  {
    "poem_id": 1414,
    "vorder": 27,
    "position": 0,
    "text": "دلم شادمان شد به تیمار اوی"
  },
  {
    "poem_id": 1414,
    "vorder": 28,
    "position": 1,
    "text": "برآنم که هرگز نبینمش روی"
  },
  {
    "poem_id": 1414,
    "vorder": 29,
    "position": 0,
    "text": "زمان خواهم از نامور پهلوان"
  },
  {
    "poem_id": 1414,
    "vorder": 30,
    "position": 1,
    "text": "بدان تا فرستم هیونی دوان"
  },
  {
    "poem_id": 1414,
    "vorder": 31,
    "position": 0,
    "text": "یکی مرد بینادل و پرشتاب"
  },
  {
    "poem_id": 1414,
    "vorder": 32,
    "position": 1,
    "text": "فرستم به نزدیک افراسیاب"
  },
  {
    "poem_id": 1414,
    "vorder": 33,
    "position": 0,
    "text": "مگر کز نهان من آگه شود"
  },
  {
    "poem_id": 1414,
    "vorder": 34,
    "position": 1,
    "text": "سخنهای گوینده کوته شود"
  },
  {
    "poem_id": 1414,
    "vorder": 35,
    "position": 0,
    "text": "نثاری فرستم چنان چون سزاست"
  },
  {
    "poem_id": 1414,
    "vorder": 36,
    "position": 1,
    "text": "جز این نیز هرچ از در پادشاست"
  },
  {
    "poem_id": 1414,
    "vorder": 37,
    "position": 0,
    "text": "گر ایدونک گوید به نزد من آی"
  },
  {
    "poem_id": 1414,
    "vorder": 38,
    "position": 1,
    "text": "جز از پیش تختش نباشم به پای"
  },
  {
    "poem_id": 1414,
    "vorder": 39,
    "position": 0,
    "text": "همه پادشاهی سپارم بدوی"
  },
  {
    "poem_id": 1414,
    "vorder": 40,
    "position": 1,
    "text": "همیشه دلی شاد دارم بدوی"
  },
  {
    "poem_id": 1414,
    "vorder": 41,
    "position": 0,
    "text": "تن پهلوان را نیارم به رنج"
  },
  {
    "poem_id": 1414,
    "vorder": 42,
    "position": 1,
    "text": "فرستمش هرگونه آگنده گنج"
  },
  {
    "poem_id": 1414,
    "vorder": 43,
    "position": 0,
    "text": "ازین سو دل پهلوان را ببست"
  },
  {
    "poem_id": 1414,
    "vorder": 44,
    "position": 1,
    "text": "وزان در سوی چاره یازید دست"
  },
  {
    "poem_id": 1414,
    "vorder": 45,
    "position": 0,
    "text": "نوندی برافگند نزدیک زال"
  },
  {
    "poem_id": 1414,
    "vorder": 46,
    "position": 1,
    "text": "که پرنده شو باز کن پر و بال"
  },
  {
    "poem_id": 1414,
    "vorder": 47,
    "position": 0,
    "text": "به دستان بگو آنچ دیدی ز کار"
  },
  {
    "poem_id": 1414,
    "vorder": 48,
    "position": 1,
    "text": "بگویش که از آمدن سر مخار"
  },
  {
    "poem_id": 1414,
    "vorder": 49,
    "position": 0,
    "text": "که دو پهلوان آمد ایدر بجنگ"
  },
  {
    "poem_id": 1414,
    "vorder": 50,
    "position": 1,
    "text": "ز ترکان سپاهی چو دشتی پلنگ"
  },
  {
    "poem_id": 1414,
    "vorder": 51,
    "position": 0,
    "text": "دو لشکر کشیدند بر هیرمند"
  },
  {
    "poem_id": 1414,
    "vorder": 52,
    "position": 1,
    "text": "به دینارشان پای کردم به بند"
  },
  {
    "poem_id": 1414,
    "vorder": 53,
    "position": 0,
    "text": "گر از آمدن دم زنی یک زمان"
  },
  {
    "poem_id": 1414,
    "vorder": 54,
    "position": 1,
    "text": "برآید همی کامهٔ بدگمان"
  }
]