[
  {
    "poem_id": 1882,
    "vorder": 1,
    "position": 0,
    "text": "قلون بستد آن مهر و تازان چو غرو"
  },
  {
    "poem_id": 1882,
    "vorder": 2,
    "position": 1,
    "text": "بیامد ز شهر کشان تا به مرو"
  },
  {
    "poem_id": 1882,
    "vorder": 3,
    "position": 0,
    "text": "همی‌بود تا روز بهرام شد"
  },
  {
    "poem_id": 1882,
    "vorder": 4,
    "position": 1,
    "text": "که بهرام را آن نه پدرام شد"
  },
  {
    "poem_id": 1882,
    "vorder": 5,
    "position": 0,
    "text": "به خانه درون بود با یک رهی"
  },
  {
    "poem_id": 1882,
    "vorder": 6,
    "position": 1,
    "text": "نهاده برش نار و سیب و بهی"
  },
  {
    "poem_id": 1882,
    "vorder": 7,
    "position": 0,
    "text": "قلون رفت تنها بدرگاه اوی"
  },
  {
    "poem_id": 1882,
    "vorder": 8,
    "position": 1,
    "text": "به دربان چنین گفت کای نامجوی"
  },
  {
    "poem_id": 1882,
    "vorder": 9,
    "position": 0,
    "text": "من از دخت خاقان فرستاده‌ام"
  },
  {
    "poem_id": 1882,
    "vorder": 10,
    "position": 1,
    "text": "نه جنگی کسی‌ام نه آزاده‌ام"
  },
  {
    "poem_id": 1882,
    "vorder": 11,
    "position": 0,
    "text": "یکی راز گفت آن زن پارسا"
  },
  {
    "poem_id": 1882,
    "vorder": 12,
    "position": 1,
    "text": "بدان تا بگویم بدین پادشا"
  },
  {
    "poem_id": 1882,
    "vorder": 13,
    "position": 0,
    "text": "ز مهر ورا از در بستن است"
  },
  {
    "poem_id": 1882,
    "vorder": 14,
    "position": 1,
    "text": "همان نیز بیمار و آبستن است"
  },
  {
    "poem_id": 1882,
    "vorder": 15,
    "position": 0,
    "text": "گر آگه کنی تا رسانم پیام"
  },
  {
    "poem_id": 1882,
    "vorder": 16,
    "position": 1,
    "text": "بدین تاجور مهتر نیک نام"
  },
  {
    "poem_id": 1882,
    "vorder": 17,
    "position": 0,
    "text": "بشد پرده دار گرامی دوان"
  },
  {
    "poem_id": 1882,
    "vorder": 18,
    "position": 1,
    "text": "چنین تا در خانه پهلوان"
  },
  {
    "poem_id": 1882,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت کامد یکی بدنشان"
  },
  {
    "poem_id": 1882,
    "vorder": 20,
    "position": 1,
    "text": "فرستاده و پوستینی کشان"
  },
  {
    "poem_id": 1882,
    "vorder": 21,
    "position": 0,
    "text": "همی‌گوید از دخت خاقان پیام"
  },
  {
    "poem_id": 1882,
    "vorder": 22,
    "position": 1,
    "text": "رسانم بدین مهتر شادکام"
  },
  {
    "poem_id": 1882,
    "vorder": 23,
    "position": 0,
    "text": "چنین گفت بهرام کورا بگوی"
  },
  {
    "poem_id": 1882,
    "vorder": 24,
    "position": 1,
    "text": "که هم زان در خانه بنمای روی"
  },
  {
    "poem_id": 1882,
    "vorder": 25,
    "position": 0,
    "text": "بیامد قلون تا به نزدیک در"
  },
  {
    "poem_id": 1882,
    "vorder": 26,
    "position": 1,
    "text": "بکاف در خانه بنهاد سر"
  },
  {
    "poem_id": 1882,
    "vorder": 27,
    "position": 0,
    "text": "چو دیدش یکی پیر بد سست و زار"
  },
  {
    "poem_id": 1882,
    "vorder": 28,
    "position": 1,
    "text": "بدو گفت گرنامه داری بیار"
  },
  {
    "poem_id": 1882,
    "vorder": 29,
    "position": 0,
    "text": "قلون گفت شاها پیامست و بس"
  },
  {
    "poem_id": 1882,
    "vorder": 30,
    "position": 1,
    "text": "نخواهم که گویم سخن پیش کس"
  },
  {
    "poem_id": 1882,
    "vorder": 31,
    "position": 0,
    "text": "ورا گفت زود اندر آی و بگوی"
  },
  {
    "poem_id": 1882,
    "vorder": 32,
    "position": 1,
    "text": "بگوشم نهانی بهانه مجوی"
  },
  {
    "poem_id": 1882,
    "vorder": 33,
    "position": 0,
    "text": "قلون رفت با کارد در آستی"
  },
  {
    "poem_id": 1882,
    "vorder": 34,
    "position": 1,
    "text": "پدیدار شد کژی و کاستی"
  },
  {
    "poem_id": 1882,
    "vorder": 35,
    "position": 0,
    "text": "همی‌رفت تا راز گوید بگوش"
  },
  {
    "poem_id": 1882,
    "vorder": 36,
    "position": 1,
    "text": "بزد دشنه وز خانه برشد خروش"
  },
  {
    "poem_id": 1882,
    "vorder": 37,
    "position": 0,
    "text": "چو بهرام گفت آه مردم ز راه"
  },
  {
    "poem_id": 1882,
    "vorder": 38,
    "position": 1,
    "text": "برفتند پویان به نزدیک شاه"
  },
  {
    "poem_id": 1882,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت کاین را بگیرید زود"
  },
  {
    "poem_id": 1882,
    "vorder": 40,
    "position": 1,
    "text": "بپرسید زو تا که راهش نمود"
  },
  {
    "poem_id": 1882,
    "vorder": 41,
    "position": 0,
    "text": "برفتند هرکس که بد در سرای"
  },
  {
    "poem_id": 1882,
    "vorder": 42,
    "position": 1,
    "text": "مران پیر سر را شکستند پای"
  },
  {
    "poem_id": 1882,
    "vorder": 43,
    "position": 0,
    "text": "همه کهتران زو بر آشوفتند"
  },
  {
    "poem_id": 1882,
    "vorder": 44,
    "position": 1,
    "text": "به سیلی و مشتش بسی کوفتند"
  },
  {
    "poem_id": 1882,
    "vorder": 45,
    "position": 0,
    "text": "همی‌خورد سیلی و نگشاد لب"
  },
  {
    "poem_id": 1882,
    "vorder": 46,
    "position": 1,
    "text": "هم از نیمهٔ روز تا نیم شب"
  },
  {
    "poem_id": 1882,
    "vorder": 47,
    "position": 0,
    "text": "چنین تا شکسته شدش دست و پای"
  },
  {
    "poem_id": 1882,
    "vorder": 48,
    "position": 1,
    "text": "فکندندش اندر میان سرای"
  },
  {
    "poem_id": 1882,
    "vorder": 49,
    "position": 0,
    "text": "به نزدیک بهرام بازآمدند"
  },
  {
    "poem_id": 1882,
    "vorder": 50,
    "position": 1,
    "text": "جگر خسته و پرگداز آمدند"
  },
  {
    "poem_id": 1882,
    "vorder": 51,
    "position": 0,
    "text": "همی‌رفت خون ازتن خسته مرد"
  },
  {
    "poem_id": 1882,
    "vorder": 52,
    "position": 1,
    "text": "لبان پر ز باد و رخان لاژورد"
  },
  {
    "poem_id": 1882,
    "vorder": 53,
    "position": 0,
    "text": "بیامد هم اندر زمان خواهرش"
  },
  {
    "poem_id": 1882,
    "vorder": 54,
    "position": 1,
    "text": "همه موی برکند پاک از سرش"
  },
  {
    "poem_id": 1882,
    "vorder": 55,
    "position": 0,
    "text": "نهاد آن سر خسته را بر کنار"
  },
  {
    "poem_id": 1882,
    "vorder": 56,
    "position": 1,
    "text": "همی‌کرد با خویشتن کار زار"
  },
  {
    "poem_id": 1882,
    "vorder": 57,
    "position": 0,
    "text": "همی‌گفت زار ای سوار دلیر"
  },
  {
    "poem_id": 1882,
    "vorder": 58,
    "position": 1,
    "text": "کزو بیشه بگذاشتی نره شیر"
  },
  {
    "poem_id": 1882,
    "vorder": 59,
    "position": 0,
    "text": "که برد این ستون جهان را ز جا"
  },
  {
    "poem_id": 1882,
    "vorder": 60,
    "position": 1,
    "text": "براندیشهٔ بد که بد رهنما"
  },
  {
    "poem_id": 1882,
    "vorder": 61,
    "position": 0,
    "text": "الا ای سوار سپهبد تنا"
  },
  {
    "poem_id": 1882,
    "vorder": 62,
    "position": 1,
    "text": "جهانگیر و ناباک و شیر اوژنا"
  },
  {
    "poem_id": 1882,
    "vorder": 63,
    "position": 0,
    "text": "نه خسرو پرست و نه ایزدپرست"
  },
  {
    "poem_id": 1882,
    "vorder": 64,
    "position": 1,
    "text": "تن پیل‌وار سپهبد که خست"
  },
  {
    "poem_id": 1882,
    "vorder": 65,
    "position": 0,
    "text": "الا ای برآورده کوه بلند"
  },
  {
    "poem_id": 1882,
    "vorder": 66,
    "position": 1,
    "text": "ز دریای خوشاب بیخت که کند"
  },
  {
    "poem_id": 1882,
    "vorder": 67,
    "position": 0,
    "text": "که کند این چنین سبز سرو سهی"
  },
  {
    "poem_id": 1882,
    "vorder": 68,
    "position": 1,
    "text": "که افگند خوار این کلاه مهی"
  },
  {
    "poem_id": 1882,
    "vorder": 69,
    "position": 0,
    "text": "که آگند ناگاه دریا به خاک"
  },
  {
    "poem_id": 1882,
    "vorder": 70,
    "position": 1,
    "text": "که افگند کوه روان در مغاک"
  },
  {
    "poem_id": 1882,
    "vorder": 71,
    "position": 0,
    "text": "غریبیم و تنها و بی دوستدار"
  },
  {
    "poem_id": 1882,
    "vorder": 72,
    "position": 1,
    "text": "بشهر کسان در بماندیم خوار"
  },
  {
    "poem_id": 1882,
    "vorder": 73,
    "position": 0,
    "text": "همی‌گفتم ای خسرو انجمن"
  },
  {
    "poem_id": 1882,
    "vorder": 74,
    "position": 1,
    "text": "که شاخ وفا را تو از بن مکن"
  },
  {
    "poem_id": 1882,
    "vorder": 75,
    "position": 0,
    "text": "که از تخم ساسان اگر دختری"
  },
  {
    "poem_id": 1882,
    "vorder": 76,
    "position": 1,
    "text": "بماند به سر برنهد افسری"
  },
  {
    "poem_id": 1882,
    "vorder": 77,
    "position": 0,
    "text": "همه شهر ایرانش فرمان برند"
  },
  {
    "poem_id": 1882,
    "vorder": 78,
    "position": 1,
    "text": "ازان تخمهٔ هرگز به دل نگذرند"
  },
  {
    "poem_id": 1882,
    "vorder": 79,
    "position": 0,
    "text": "سپهدار نشنید پند مرا"
  },
  {
    "poem_id": 1882,
    "vorder": 80,
    "position": 1,
    "text": "سخن گفتن سودمند مرا"
  },
  {
    "poem_id": 1882,
    "vorder": 81,
    "position": 0,
    "text": "برین کرده‌ها بر پشیمان بری"
  },
  {
    "poem_id": 1882,
    "vorder": 82,
    "position": 1,
    "text": "گنهکار جان پیش یزدان بری"
  },
  {
    "poem_id": 1882,
    "vorder": 83,
    "position": 0,
    "text": "بد آمد بدین خاندان بزرگ"
  },
  {
    "poem_id": 1882,
    "vorder": 84,
    "position": 1,
    "text": "همه میش گشتیم و دشمن چو گرک"
  },
  {
    "poem_id": 1882,
    "vorder": 85,
    "position": 0,
    "text": "چو آن خسته بشنید گفتار او"
  },
  {
    "poem_id": 1882,
    "vorder": 86,
    "position": 1,
    "text": "بدید آن دل و رای هشیار او"
  },
  {
    "poem_id": 1882,
    "vorder": 87,
    "position": 0,
    "text": "به ناخن رخان خسته و کنده موی"
  },
  {
    "poem_id": 1882,
    "vorder": 88,
    "position": 1,
    "text": "پر از خون دل و دیده پر آب روی"
  },
  {
    "poem_id": 1882,
    "vorder": 89,
    "position": 0,
    "text": "به زاری و سستی زبان برگشاد"
  },
  {
    "poem_id": 1882,
    "vorder": 90,
    "position": 1,
    "text": "چنین گفت کای خواهر پاک وراد"
  },
  {
    "poem_id": 1882,
    "vorder": 91,
    "position": 0,
    "text": "ز پند تو کمی نبد هیچ چیز"
  },
  {
    "poem_id": 1882,
    "vorder": 92,
    "position": 1,
    "text": "ولیکن مرا خود پر آمد قفیز"
  },
  {
    "poem_id": 1882,
    "vorder": 93,
    "position": 0,
    "text": "همی پند بر من نبد کارگر"
  },
  {
    "poem_id": 1882,
    "vorder": 94,
    "position": 1,
    "text": "ز هر گونه چون دیو بد راه بر"
  },
  {
    "poem_id": 1882,
    "vorder": 95,
    "position": 0,
    "text": "نبد خسروی برتر از جمشید"
  },
  {
    "poem_id": 1882,
    "vorder": 96,
    "position": 1,
    "text": "کزو بود گیتی به بیم وامید"
  },
  {
    "poem_id": 1882,
    "vorder": 97,
    "position": 0,
    "text": "کجا شد به گفتار دیوان ز شاه"
  },
  {
    "poem_id": 1882,
    "vorder": 98,
    "position": 1,
    "text": "جهان کرد بر خویشتن بر سیاه"
  },
  {
    "poem_id": 1882,
    "vorder": 99,
    "position": 0,
    "text": "همان نیز بیدار کاوس کی"
  },
  {
    "poem_id": 1882,
    "vorder": 100,
    "position": 1,
    "text": "جهاندار نیک اختر و نیک پی"
  },
  {
    "poem_id": 1882,
    "vorder": 101,
    "position": 0,
    "text": "تبه شد به گفتار دیو پلید"
  },
  {
    "poem_id": 1882,
    "vorder": 102,
    "position": 1,
    "text": "شنیدی بدیها که او را رسید"
  },
  {
    "poem_id": 1882,
    "vorder": 103,
    "position": 0,
    "text": "همان به آسمان شد که گردان سپهر"
  },
  {
    "poem_id": 1882,
    "vorder": 104,
    "position": 1,
    "text": "ببیند پراگندن ماه و مهر"
  },
  {
    "poem_id": 1882,
    "vorder": 105,
    "position": 0,
    "text": "مرا نیز هم دیو بی‌راه کرد"
  },
  {
    "poem_id": 1882,
    "vorder": 106,
    "position": 1,
    "text": "ز خوبی همان دست کوتاه کرد"
  },
  {
    "poem_id": 1882,
    "vorder": 107,
    "position": 0,
    "text": "پشیمانم از هرچ کردم ز بد"
  },
  {
    "poem_id": 1882,
    "vorder": 108,
    "position": 1,
    "text": "کنون گر ببخشد ز یزدان سزد"
  },
  {
    "poem_id": 1882,
    "vorder": 109,
    "position": 0,
    "text": "نوشته برین گونه بد بر سرم"
  },
  {
    "poem_id": 1882,
    "vorder": 110,
    "position": 1,
    "text": "غم کرده های کهن چون خورم"
  },
  {
    "poem_id": 1882,
    "vorder": 111,
    "position": 0,
    "text": "ز تارک کنون آب برتر گذشت"
  },
  {
    "poem_id": 1882,
    "vorder": 112,
    "position": 1,
    "text": "غم و شادمانی همه باد گشت"
  },
  {
    "poem_id": 1882,
    "vorder": 113,
    "position": 0,
    "text": "نوشته چنین بود وبود آنچ بود"
  },
  {
    "poem_id": 1882,
    "vorder": 114,
    "position": 1,
    "text": "نوشته نکاهد نه هرگز فزود"
  },
  {
    "poem_id": 1882,
    "vorder": 115,
    "position": 0,
    "text": "همان پند تویادگارمنست"
  },
  {
    "poem_id": 1882,
    "vorder": 116,
    "position": 1,
    "text": "سخنهای توگوشوارمنست"
  },
  {
    "poem_id": 1882,
    "vorder": 117,
    "position": 0,
    "text": "سرآمد کنون کار بیداد و داد"
  },
  {
    "poem_id": 1882,
    "vorder": 118,
    "position": 1,
    "text": "سخنهات برمن مکن نیزیاد"
  },
  {
    "poem_id": 1882,
    "vorder": 119,
    "position": 0,
    "text": "شماروی راسوی یزدان کنید"
  },
  {
    "poem_id": 1882,
    "vorder": 120,
    "position": 1,
    "text": "همه پشت بربخت خندان کنید"
  },
  {
    "poem_id": 1882,
    "vorder": 121,
    "position": 0,
    "text": "زبدها جهاندارتان یاربس"
  },
  {
    "poem_id": 1882,
    "vorder": 122,
    "position": 1,
    "text": "مگویید زاندوه وشادی بکس"
  },
  {
    "poem_id": 1882,
    "vorder": 123,
    "position": 0,
    "text": "نبودم بگیتی جزین نیز بهر"
  },
  {
    "poem_id": 1882,
    "vorder": 124,
    "position": 1,
    "text": "سرآمد کنون رفتنی‌ام ز دهر"
  },
  {
    "poem_id": 1882,
    "vorder": 125,
    "position": 0,
    "text": "یلان سینه راگفت یکسر سپاه"
  },
  {
    "poem_id": 1882,
    "vorder": 126,
    "position": 1,
    "text": "سپردم تو رابخت بیدارخواه"
  },
  {
    "poem_id": 1882,
    "vorder": 127,
    "position": 0,
    "text": "نگه کن بدین خواهرپاک تن"
  },
  {
    "poem_id": 1882,
    "vorder": 128,
    "position": 1,
    "text": "زگیتی بس اومرتو رارای زن"
  },
  {
    "poem_id": 1882,
    "vorder": 129,
    "position": 0,
    "text": "مباشید یک تن زدیگر جدا"
  },
  {
    "poem_id": 1882,
    "vorder": 130,
    "position": 1,
    "text": "جدایی مبادا میان شما"
  },
  {
    "poem_id": 1882,
    "vorder": 131,
    "position": 0,
    "text": "برین بوم دشمن ممانید دیر"
  },
  {
    "poem_id": 1882,
    "vorder": 132,
    "position": 1,
    "text": "که رفتیم وگشتیم ازگاه سیر"
  },
  {
    "poem_id": 1882,
    "vorder": 133,
    "position": 0,
    "text": "همه یکسره پیش خسرو شوید"
  },
  {
    "poem_id": 1882,
    "vorder": 134,
    "position": 1,
    "text": "بگویید و گفتار او بشنوید"
  },
  {
    "poem_id": 1882,
    "vorder": 135,
    "position": 0,
    "text": "گر آمرزش آید شما راز شاه"
  },
  {
    "poem_id": 1882,
    "vorder": 136,
    "position": 1,
    "text": "جز او رامخوانید خورشید و ماه"
  },
  {
    "poem_id": 1882,
    "vorder": 137,
    "position": 0,
    "text": "مرا دخمه در شهرایران کنید"
  },
  {
    "poem_id": 1882,
    "vorder": 138,
    "position": 1,
    "text": "بری کاخ بهرام ویران کنید"
  },
  {
    "poem_id": 1882,
    "vorder": 139,
    "position": 0,
    "text": "بسی رنج دیدم ز خاقان چین"
  },
  {
    "poem_id": 1882,
    "vorder": 140,
    "position": 1,
    "text": "ندیدم که یک روز کرد آفرین"
  },
  {
    "poem_id": 1882,
    "vorder": 141,
    "position": 0,
    "text": "نه این بود زان رنج پاداش من"
  },
  {
    "poem_id": 1882,
    "vorder": 142,
    "position": 1,
    "text": "که دیوی فرستد بپرخاش من"
  },
  {
    "poem_id": 1882,
    "vorder": 143,
    "position": 0,
    "text": "ولیکن همانا که او این سخن"
  },
  {
    "poem_id": 1882,
    "vorder": 144,
    "position": 1,
    "text": "اگر بشنود سر نداند ز بن"
  },
  {
    "poem_id": 1882,
    "vorder": 145,
    "position": 0,
    "text": "نبود این جز از کار ایرانیان"
  },
  {
    "poem_id": 1882,
    "vorder": 146,
    "position": 1,
    "text": "همی دیو بد رهنمون درمیان"
  },
  {
    "poem_id": 1882,
    "vorder": 147,
    "position": 0,
    "text": "بفرمود پس تا بیامد دبیر"
  },
  {
    "poem_id": 1882,
    "vorder": 148,
    "position": 1,
    "text": "نویسد یکی نامه‌ای بر حریر"
  },
  {
    "poem_id": 1882,
    "vorder": 149,
    "position": 0,
    "text": "بگوید بخاقان که بهرام رفت"
  },
  {
    "poem_id": 1882,
    "vorder": 150,
    "position": 1,
    "text": "به زاری و خواری و بی‌کام رفت"
  },
  {
    "poem_id": 1882,
    "vorder": 151,
    "position": 0,
    "text": "تو این ماندگان راز من یاددار"
  },
  {
    "poem_id": 1882,
    "vorder": 152,
    "position": 1,
    "text": "ز رنج و بد دشمن آزاد دار"
  },
  {
    "poem_id": 1882,
    "vorder": 153,
    "position": 0,
    "text": "که من با تو هرگز نکردم بدی"
  },
  {
    "poem_id": 1882,
    "vorder": 154,
    "position": 1,
    "text": "همی راستی جستم و بخردی"
  },
  {
    "poem_id": 1882,
    "vorder": 155,
    "position": 0,
    "text": "بسی پندها خواند بر خواهرش"
  },
  {
    "poem_id": 1882,
    "vorder": 156,
    "position": 1,
    "text": "ببر در گرفت آن گرامی سرش"
  },
  {
    "poem_id": 1882,
    "vorder": 157,
    "position": 0,
    "text": "دهن بر بنا گوش خواهر نهاد"
  },
  {
    "poem_id": 1882,
    "vorder": 158,
    "position": 1,
    "text": "دو چشمش پر از خون شد و جان بداد"
  },
  {
    "poem_id": 1882,
    "vorder": 159,
    "position": 0,
    "text": "برو هر کسی زار بگریستند"
  },
  {
    "poem_id": 1882,
    "vorder": 160,
    "position": 1,
    "text": "به درد دل اندر همی‌زیستند"
  },
  {
    "poem_id": 1882,
    "vorder": 161,
    "position": 0,
    "text": "همی خون خروشید خواهر ز درد"
  },
  {
    "poem_id": 1882,
    "vorder": 162,
    "position": 1,
    "text": "سخنهای او یک به یک یاد کرد"
  },
  {
    "poem_id": 1882,
    "vorder": 163,
    "position": 0,
    "text": "ز تیمار او شد دلش به دونیم"
  },
  {
    "poem_id": 1882,
    "vorder": 164,
    "position": 1,
    "text": "یکی تنگ تابوت کردش ز سیم"
  },
  {
    "poem_id": 1882,
    "vorder": 165,
    "position": 0,
    "text": "به دیبا بیاراست جنگی تنش"
  },
  {
    "poem_id": 1882,
    "vorder": 166,
    "position": 1,
    "text": "قصب کرد در زیر پیراهنش"
  },
  {
    "poem_id": 1882,
    "vorder": 167,
    "position": 0,
    "text": "همی‌ریخت کافور گرد اندرش"
  },
  {
    "poem_id": 1882,
    "vorder": 168,
    "position": 1,
    "text": "بدین گونه برتا نهان شد سرش"
  },
  {
    "poem_id": 1882,
    "vorder": 169,
    "position": 0,
    "text": "چنین است کار سرای سپنج"
  },
  {
    "poem_id": 1882,
    "vorder": 170,
    "position": 1,
    "text": "چودانی که ایدر نمانی مرنج"
  }
]