[
  {
    "poem_id": 87999,
    "vorder": 1,
    "position": 0,
    "text": "بغرید شنگل ز پیش سپاه"
  },
  {
    "poem_id": 87999,
    "vorder": 2,
    "position": 1,
    "text": "منم گفت گرداوژن رزم‌خواه"
  },
  {
    "poem_id": 87999,
    "vorder": 3,
    "position": 0,
    "text": "بگویید کان مرد سگزی کجاست"
  },
  {
    "poem_id": 87999,
    "vorder": 4,
    "position": 1,
    "text": "یکی کرد خواهم برو نیزه راست"
  },
  {
    "poem_id": 87999,
    "vorder": 5,
    "position": 0,
    "text": "چو آواز شنگل برستم رسید"
  },
  {
    "poem_id": 87999,
    "vorder": 6,
    "position": 1,
    "text": "ز لشکر نگه کرد و او را بدید"
  },
  {
    "poem_id": 87999,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت هان آمدم رزمخواه"
  },
  {
    "poem_id": 87999,
    "vorder": 8,
    "position": 1,
    "text": "نگر تا نگیری بلشکر پناه"
  },
  {
    "poem_id": 87999,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت رستم که از کردگار"
  },
  {
    "poem_id": 87999,
    "vorder": 10,
    "position": 1,
    "text": "نجستم جزین آرزوی آشکار"
  },
  {
    "poem_id": 87999,
    "vorder": 11,
    "position": 0,
    "text": "که بیگانه‌ای زان بزرگ انجمن"
  },
  {
    "poem_id": 87999,
    "vorder": 12,
    "position": 1,
    "text": "دلیری کند رزم جوید ز من"
  },
  {
    "poem_id": 87999,
    "vorder": 13,
    "position": 0,
    "text": "نه سقلاب ماند ازیشان نه هند"
  },
  {
    "poem_id": 87999,
    "vorder": 14,
    "position": 1,
    "text": "نه شمشیر هندی نه چینی پرند"
  },
  {
    "poem_id": 87999,
    "vorder": 15,
    "position": 0,
    "text": "پی و بیخ ایشان نمانم بجای"
  },
  {
    "poem_id": 87999,
    "vorder": 16,
    "position": 1,
    "text": "نمانم بترکان سر و دست و پای"
  },
  {
    "poem_id": 87999,
    "vorder": 17,
    "position": 0,
    "text": "بر شنگل آمد به آواز گفت"
  },
  {
    "poem_id": 87999,
    "vorder": 18,
    "position": 1,
    "text": "که ای بدنژاد فرومایه جفت"
  },
  {
    "poem_id": 87999,
    "vorder": 19,
    "position": 0,
    "text": "مرا نام رستم کند زال زر"
  },
  {
    "poem_id": 87999,
    "vorder": 20,
    "position": 1,
    "text": "تو سگزی چرا خوانی ای بدگهر"
  },
  {
    "poem_id": 87999,
    "vorder": 21,
    "position": 0,
    "text": "نگه کن که سگزی کنون مرگ تست"
  },
  {
    "poem_id": 87999,
    "vorder": 22,
    "position": 1,
    "text": "کفن بی‌گمان جوشن و ترگ تست"
  },
  {
    "poem_id": 87999,
    "vorder": 23,
    "position": 0,
    "text": "همی گشت با او به آوردگاه"
  },
  {
    "poem_id": 87999,
    "vorder": 24,
    "position": 1,
    "text": "میان دو صف برکشیده سپاه"
  },
  {
    "poem_id": 87999,
    "vorder": 25,
    "position": 0,
    "text": "یکی نیزه زد برگرفتش ز زین"
  },
  {
    "poem_id": 87999,
    "vorder": 26,
    "position": 1,
    "text": "نگونسار کرد و بزد بر زمین"
  },
  {
    "poem_id": 87999,
    "vorder": 27,
    "position": 0,
    "text": "برو بر گذر کرد و او را نخست"
  },
  {
    "poem_id": 87999,
    "vorder": 28,
    "position": 1,
    "text": "بشمشیر برد آنگهی شیر دست"
  },
  {
    "poem_id": 87999,
    "vorder": 29,
    "position": 0,
    "text": "برفتند زان روی کنداوران"
  },
  {
    "poem_id": 87999,
    "vorder": 30,
    "position": 1,
    "text": "بزهر آب داده پرندآوران"
  },
  {
    "poem_id": 87999,
    "vorder": 31,
    "position": 0,
    "text": "چو شنگل گریزان شد از پیلتن"
  },
  {
    "poem_id": 87999,
    "vorder": 32,
    "position": 1,
    "text": "پراگنده گشتند زان انجمن"
  },
  {
    "poem_id": 87999,
    "vorder": 33,
    "position": 0,
    "text": "دو بهره ازیشان بشمشیر کشت"
  },
  {
    "poem_id": 87999,
    "vorder": 34,
    "position": 1,
    "text": "دلیران توران نمودند پشت"
  },
  {
    "poem_id": 87999,
    "vorder": 35,
    "position": 0,
    "text": "بجان شنگل از دست رستم بجست"
  },
  {
    "poem_id": 87999,
    "vorder": 36,
    "position": 1,
    "text": "زره بود و جوشن تنش را نخست"
  },
  {
    "poem_id": 87999,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت شنگل که این مرد نیست"
  },
  {
    "poem_id": 87999,
    "vorder": 38,
    "position": 1,
    "text": "کس او را بگیتی هم آورد نیست"
  },
  {
    "poem_id": 87999,
    "vorder": 39,
    "position": 0,
    "text": "یکی ژنده پیلست بر پشت کوه"
  },
  {
    "poem_id": 87999,
    "vorder": 40,
    "position": 1,
    "text": "مگر رزم سازند یکسر گروه"
  },
  {
    "poem_id": 87999,
    "vorder": 41,
    "position": 0,
    "text": "بتنها کسی رزم با اژدها"
  },
  {
    "poem_id": 87999,
    "vorder": 42,
    "position": 1,
    "text": "نجوید چو جوید نیابد رها"
  },
  {
    "poem_id": 87999,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت خاقان ترا بامداد"
  },
  {
    "poem_id": 87999,
    "vorder": 44,
    "position": 1,
    "text": "دگر بود رای و دگر بود یاد"
  },
  {
    "poem_id": 87999,
    "vorder": 45,
    "position": 0,
    "text": "سپه را بفرمود تا همگروه"
  },
  {
    "poem_id": 87999,
    "vorder": 46,
    "position": 1,
    "text": "برانند یکسر بکردار کوه"
  },
  {
    "poem_id": 87999,
    "vorder": 47,
    "position": 0,
    "text": "سرافراز را در میان آورند"
  },
  {
    "poem_id": 87999,
    "vorder": 48,
    "position": 1,
    "text": "تنومند را جان زیان آورند"
  },
  {
    "poem_id": 87999,
    "vorder": 49,
    "position": 0,
    "text": "بشمشیر برد آن زمان شیر دست"
  },
  {
    "poem_id": 87999,
    "vorder": 50,
    "position": 1,
    "text": "چپ لشکر چینیان برشکست"
  },
  {
    "poem_id": 87999,
    "vorder": 51,
    "position": 0,
    "text": "هر آنگه که خنجر برانداختی"
  },
  {
    "poem_id": 87999,
    "vorder": 52,
    "position": 1,
    "text": "همه ره تن بی سر انداختی"
  },
  {
    "poem_id": 87999,
    "vorder": 53,
    "position": 0,
    "text": "نه با جنگ او کوه را پای بود"
  },
  {
    "poem_id": 87999,
    "vorder": 54,
    "position": 1,
    "text": "نه با خشم او پیل را جای بود"
  },
  {
    "poem_id": 87999,
    "vorder": 55,
    "position": 0,
    "text": "بدان سان گرفتند گرد اندرش"
  },
  {
    "poem_id": 87999,
    "vorder": 56,
    "position": 1,
    "text": "که خورشید تاریک شد از برش"
  },
  {
    "poem_id": 87999,
    "vorder": 57,
    "position": 0,
    "text": "چنان نیزه و خنجر و گُرز و تیر"
  },
  {
    "poem_id": 87999,
    "vorder": 58,
    "position": 1,
    "text": "که شد ساخته بر یل شیرگیر"
  },
  {
    "poem_id": 87999,
    "vorder": 59,
    "position": 0,
    "text": "گمان برد کاندر نیستان شدست"
  },
  {
    "poem_id": 87999,
    "vorder": 60,
    "position": 1,
    "text": "ز خون روی کشور میستان شدست"
  },
  {
    "poem_id": 87999,
    "vorder": 61,
    "position": 0,
    "text": "بیک زخم ده نیزه کردی قلم"
  },
  {
    "poem_id": 87999,
    "vorder": 62,
    "position": 1,
    "text": "خروشان و جوشان و دشمن دژم"
  },
  {
    "poem_id": 87999,
    "vorder": 63,
    "position": 0,
    "text": "دلیران ایران پس پشت اوی"
  },
  {
    "poem_id": 87999,
    "vorder": 64,
    "position": 1,
    "text": "بکینه دل آگنده و جنگ جوی"
  },
  {
    "poem_id": 87999,
    "vorder": 65,
    "position": 0,
    "text": "ز بس نیزه و گُرز و گوپال و تیغ"
  },
  {
    "poem_id": 87999,
    "vorder": 66,
    "position": 1,
    "text": "تو گفتی همی ژاله بارد ز میغ"
  },
  {
    "poem_id": 87999,
    "vorder": 67,
    "position": 0,
    "text": "ز کشته همه دشت آوردگاه"
  },
  {
    "poem_id": 87999,
    "vorder": 68,
    "position": 1,
    "text": "تن و پشت و سر بود و ترگ و کلاه"
  },
  {
    "poem_id": 87999,
    "vorder": 69,
    "position": 0,
    "text": "ز چینی و شگنی و از هندوی"
  },
  {
    "poem_id": 87999,
    "vorder": 70,
    "position": 1,
    "text": "ز سقلاب و هری و از پهلوی"
  },
  {
    "poem_id": 87999,
    "vorder": 71,
    "position": 0,
    "text": "سپه بود چون خاک در پای کوه"
  },
  {
    "poem_id": 87999,
    "vorder": 72,
    "position": 1,
    "text": "ز یک مرد سگزی شده همگروه"
  },
  {
    "poem_id": 87999,
    "vorder": 73,
    "position": 0,
    "text": "که با او بجنگ اندرون پای نیست"
  },
  {
    "poem_id": 87999,
    "vorder": 74,
    "position": 1,
    "text": "چنو در جهان لشکر آرای نیست"
  },
  {
    "poem_id": 87999,
    "vorder": 75,
    "position": 0,
    "text": "کسی کو کند زین سخن داستان"
  },
  {
    "poem_id": 87999,
    "vorder": 76,
    "position": 1,
    "text": "نباشد خردمند همداستان"
  },
  {
    "poem_id": 87999,
    "vorder": 77,
    "position": 0,
    "text": "که پرخاشخر نامور صد هزار"
  },
  {
    "poem_id": 87999,
    "vorder": 78,
    "position": 1,
    "text": "بسنده نبودند با یک سوار"
  },
  {
    "poem_id": 87999,
    "vorder": 79,
    "position": 0,
    "text": "ازین کین بد آمد بافراسیاب"
  },
  {
    "poem_id": 87999,
    "vorder": 80,
    "position": 1,
    "text": "ز رستم کجا یابد آرام و خواب"
  },
  {
    "poem_id": 87999,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت رستم بایرانیان"
  },
  {
    "poem_id": 87999,
    "vorder": 82,
    "position": 1,
    "text": "کزین جنگ دشمن کند جان زیان"
  },
  {
    "poem_id": 87999,
    "vorder": 83,
    "position": 0,
    "text": "هم‌اکنون ز پیلان و از خواسته"
  },
  {
    "poem_id": 87999,
    "vorder": 84,
    "position": 1,
    "text": "همان تخت و آن تاج آراسته"
  },
  {
    "poem_id": 87999,
    "vorder": 85,
    "position": 0,
    "text": "ستانم ز چینی بایران دهم"
  },
  {
    "poem_id": 87999,
    "vorder": 86,
    "position": 1,
    "text": "بدان شادمان روز فرخ نهم"
  },
  {
    "poem_id": 87999,
    "vorder": 87,
    "position": 0,
    "text": "نباشد جز ایرانیان شاد کس"
  },
  {
    "poem_id": 87999,
    "vorder": 88,
    "position": 1,
    "text": "پی رخش و ایزد مرا یار بس"
  },
  {
    "poem_id": 87999,
    "vorder": 89,
    "position": 0,
    "text": "یکی را ز شگنان و سقلاب و چین"
  },
  {
    "poem_id": 87999,
    "vorder": 90,
    "position": 1,
    "text": "نمانم که پی برنهد بر زمین"
  },
  {
    "poem_id": 87999,
    "vorder": 91,
    "position": 0,
    "text": "که امروز پیروزی روز ماست"
  },
  {
    "poem_id": 87999,
    "vorder": 92,
    "position": 1,
    "text": "بلند آسمان لشکر افروز ماست"
  },
  {
    "poem_id": 87999,
    "vorder": 93,
    "position": 0,
    "text": "گر ایدونک نیرو دهد دادگر"
  },
  {
    "poem_id": 87999,
    "vorder": 94,
    "position": 1,
    "text": "پدید آورد رخش رخشان هنر"
  },
  {
    "poem_id": 87999,
    "vorder": 95,
    "position": 0,
    "text": "برین دشت من گورستانی کنم"
  },
  {
    "poem_id": 87999,
    "vorder": 96,
    "position": 1,
    "text": "برومند را شارستانی کنم"
  },
  {
    "poem_id": 87999,
    "vorder": 97,
    "position": 0,
    "text": "یکی از شما سوی لشکر شوید"
  },
  {
    "poem_id": 87999,
    "vorder": 98,
    "position": 1,
    "text": "بکوشید و با باد همبر شوید"
  },
  {
    "poem_id": 87999,
    "vorder": 99,
    "position": 0,
    "text": "بکوبید چون من بجنبم ز جای"
  },
  {
    "poem_id": 87999,
    "vorder": 100,
    "position": 1,
    "text": "شما برفرازید سنج و درای"
  },
  {
    "poem_id": 87999,
    "vorder": 101,
    "position": 0,
    "text": "زمین را سراسر کنید آبنوس"
  },
  {
    "poem_id": 87999,
    "vorder": 102,
    "position": 1,
    "text": "بگرد سواران و آوای کوس"
  },
  {
    "poem_id": 87999,
    "vorder": 103,
    "position": 0,
    "text": "بکوبید گوپال و گُرز گران"
  },
  {
    "poem_id": 87999,
    "vorder": 104,
    "position": 1,
    "text": "چو پولاد را پتک آهنگران"
  },
  {
    "poem_id": 87999,
    "vorder": 105,
    "position": 0,
    "text": "از انبوه ایشان مدارید باک"
  },
  {
    "poem_id": 87999,
    "vorder": 106,
    "position": 1,
    "text": "ز دریا بابر اندر آرید خاک"
  },
  {
    "poem_id": 87999,
    "vorder": 107,
    "position": 0,
    "text": "همه دیده بر مغفر من نهید"
  },
  {
    "poem_id": 87999,
    "vorder": 108,
    "position": 1,
    "text": "چو من بر خروشم دمید و دهید"
  },
  {
    "poem_id": 87999,
    "vorder": 109,
    "position": 0,
    "text": "بدرید صفهای سقلاب و چین"
  },
  {
    "poem_id": 87999,
    "vorder": 110,
    "position": 1,
    "text": "نباید که بیند هوا را زمین"
  },
  {
    "poem_id": 87999,
    "vorder": 111,
    "position": 0,
    "text": "وزان جایگه رفت چون پیل مست"
  },
  {
    "poem_id": 87999,
    "vorder": 112,
    "position": 1,
    "text": "یکی گُرزهٔ گاوپیکر به دست"
  },
  {
    "poem_id": 87999,
    "vorder": 113,
    "position": 0,
    "text": "خروشان سوی میمنه راه جست"
  },
  {
    "poem_id": 87999,
    "vorder": 114,
    "position": 1,
    "text": "ز لشکر سوی کندر آمد نخست"
  },
  {
    "poem_id": 87999,
    "vorder": 115,
    "position": 0,
    "text": "همه میمنه پاک بر هم درید"
  },
  {
    "poem_id": 87999,
    "vorder": 116,
    "position": 1,
    "text": "بسی ترگ و سر بد که تن را ندید"
  }
]