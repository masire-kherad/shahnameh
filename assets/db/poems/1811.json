[
  {
    "poem_id": 1811,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاه شد شنگل از کار شاه"
  },
  {
    "poem_id": 1811,
    "vorder": 2,
    "position": 1,
    "text": "ز دختر که شد شاه را پیش‌گاه"
  },
  {
    "poem_id": 1811,
    "vorder": 3,
    "position": 0,
    "text": "به دیدار ایران بدش آرزوی"
  },
  {
    "poem_id": 1811,
    "vorder": 4,
    "position": 1,
    "text": "بر دختر شاه آزاده‌خوی"
  },
  {
    "poem_id": 1811,
    "vorder": 5,
    "position": 0,
    "text": "فرستاد هندی فرستاده‌ای"
  },
  {
    "poem_id": 1811,
    "vorder": 6,
    "position": 1,
    "text": "سخن‌گوی مردی و آزاده‌ای"
  },
  {
    "poem_id": 1811,
    "vorder": 7,
    "position": 0,
    "text": "یکی عهد نو خواست از شهریار"
  },
  {
    "poem_id": 1811,
    "vorder": 8,
    "position": 1,
    "text": "که دارد به خان اندرون یادگار"
  },
  {
    "poem_id": 1811,
    "vorder": 9,
    "position": 0,
    "text": "به نوی جهاندار عهدی نوشت"
  },
  {
    "poem_id": 1811,
    "vorder": 10,
    "position": 1,
    "text": "چو خورشید تابان به باغ بهشت"
  },
  {
    "poem_id": 1811,
    "vorder": 11,
    "position": 0,
    "text": "یکی پهلوی نامه از خط شاه"
  },
  {
    "poem_id": 1811,
    "vorder": 12,
    "position": 1,
    "text": "فرستاده آورد و بنمود راه"
  },
  {
    "poem_id": 1811,
    "vorder": 13,
    "position": 0,
    "text": "فرستاده چون نزد شنگل رسید"
  },
  {
    "poem_id": 1811,
    "vorder": 14,
    "position": 1,
    "text": "سپهدار قنوج خطش بدید"
  },
  {
    "poem_id": 1811,
    "vorder": 15,
    "position": 0,
    "text": "ز هندوستان ساز رفتن گرفت"
  },
  {
    "poem_id": 1811,
    "vorder": 16,
    "position": 1,
    "text": "ز خویشان چینی نهفتن گرفت"
  },
  {
    "poem_id": 1811,
    "vorder": 17,
    "position": 0,
    "text": "بیامد به درگاه او هفت شاه"
  },
  {
    "poem_id": 1811,
    "vorder": 18,
    "position": 1,
    "text": "که آیند با رای شنگل به راه"
  },
  {
    "poem_id": 1811,
    "vorder": 19,
    "position": 0,
    "text": "یکی شاه کابل دگر هند شاه"
  },
  {
    "poem_id": 1811,
    "vorder": 20,
    "position": 1,
    "text": "دگر شاه سندل بشد با سپاه"
  },
  {
    "poem_id": 1811,
    "vorder": 21,
    "position": 0,
    "text": "دگر شاه مندل که بد نامدار"
  },
  {
    "poem_id": 1811,
    "vorder": 22,
    "position": 1,
    "text": "همان نیز جندل که بد کامگار"
  },
  {
    "poem_id": 1811,
    "vorder": 23,
    "position": 0,
    "text": "ابا ژنده پیلان و زنگ و درای"
  },
  {
    "poem_id": 1811,
    "vorder": 24,
    "position": 1,
    "text": "یکی چتر هندی به سر بر به پای"
  },
  {
    "poem_id": 1811,
    "vorder": 25,
    "position": 0,
    "text": "همه نامجوی و همه نامدار"
  },
  {
    "poem_id": 1811,
    "vorder": 26,
    "position": 1,
    "text": "همه پاک با طوق و با گوشوار"
  },
  {
    "poem_id": 1811,
    "vorder": 27,
    "position": 0,
    "text": "همه ویژه با گوهر و سیم و زر"
  },
  {
    "poem_id": 1811,
    "vorder": 28,
    "position": 1,
    "text": "یکی چتر هندی ز طاوس نر"
  },
  {
    "poem_id": 1811,
    "vorder": 29,
    "position": 0,
    "text": "به دیبا بیاراسته پشت پیل"
  },
  {
    "poem_id": 1811,
    "vorder": 30,
    "position": 1,
    "text": "همی تافت آن لشکر از چند میل"
  },
  {
    "poem_id": 1811,
    "vorder": 31,
    "position": 0,
    "text": "ابا هدیهٔ شاه و چندان نثار"
  },
  {
    "poem_id": 1811,
    "vorder": 32,
    "position": 1,
    "text": "که دینار شد خوار بر شهریار"
  },
  {
    "poem_id": 1811,
    "vorder": 33,
    "position": 0,
    "text": "همی راند منزل به منزل سپاه"
  },
  {
    "poem_id": 1811,
    "vorder": 34,
    "position": 1,
    "text": "چو زان آگهی یافت بهرامشاه"
  },
  {
    "poem_id": 1811,
    "vorder": 35,
    "position": 0,
    "text": "بزرگان ز هر شهر برخاستند"
  },
  {
    "poem_id": 1811,
    "vorder": 36,
    "position": 1,
    "text": "پذیره شدن را بیاراستند"
  },
  {
    "poem_id": 1811,
    "vorder": 37,
    "position": 0,
    "text": "بیامد شهنشاه تا نهروان"
  },
  {
    "poem_id": 1811,
    "vorder": 38,
    "position": 1,
    "text": "خردمند و بیدار و روشن‌روان"
  },
  {
    "poem_id": 1811,
    "vorder": 39,
    "position": 0,
    "text": "دو شاه گرانمایه و نیک‌ساز"
  },
  {
    "poem_id": 1811,
    "vorder": 40,
    "position": 1,
    "text": "رسیدند پس یک به دیگر فراز"
  },
  {
    "poem_id": 1811,
    "vorder": 41,
    "position": 0,
    "text": "به نزدیک اندر فرود آمدند"
  },
  {
    "poem_id": 1811,
    "vorder": 42,
    "position": 1,
    "text": "که با پوزش و با درود آمدند"
  },
  {
    "poem_id": 1811,
    "vorder": 43,
    "position": 0,
    "text": "گرفتند مر یکدگر را به بر"
  },
  {
    "poem_id": 1811,
    "vorder": 44,
    "position": 1,
    "text": "دو شاه سرافراز با تاج و فر"
  },
  {
    "poem_id": 1811,
    "vorder": 45,
    "position": 0,
    "text": "پیاده شده لشکر از هر دو روی"
  },
  {
    "poem_id": 1811,
    "vorder": 46,
    "position": 1,
    "text": "جهانی سراسر پر از گفت‌وگوی"
  },
  {
    "poem_id": 1811,
    "vorder": 47,
    "position": 0,
    "text": "دو شاه و دو لشکر رسیده بهم"
  },
  {
    "poem_id": 1811,
    "vorder": 48,
    "position": 1,
    "text": "همی رفت هرگونه از بیش و کم"
  },
  {
    "poem_id": 1811,
    "vorder": 49,
    "position": 0,
    "text": "به زین بر نشستند هر دو سوار"
  },
  {
    "poem_id": 1811,
    "vorder": 50,
    "position": 1,
    "text": "همان پرهنر لشکر نامدار"
  },
  {
    "poem_id": 1811,
    "vorder": 51,
    "position": 0,
    "text": "به ایوانها تخت زرین نهاد"
  },
  {
    "poem_id": 1811,
    "vorder": 52,
    "position": 1,
    "text": "برو جامهٔ خسرو آیین نهاد"
  },
  {
    "poem_id": 1811,
    "vorder": 53,
    "position": 0,
    "text": "به ره بر بره مرغ بریان نهاد"
  },
  {
    "poem_id": 1811,
    "vorder": 54,
    "position": 1,
    "text": "به یک تیر پرتاب بر خوان نهاد"
  },
  {
    "poem_id": 1811,
    "vorder": 55,
    "position": 0,
    "text": "می آورد و برخواند رامشگران"
  },
  {
    "poem_id": 1811,
    "vorder": 56,
    "position": 1,
    "text": "همه جام پر از کران تا کران"
  },
  {
    "poem_id": 1811,
    "vorder": 57,
    "position": 0,
    "text": "چو نان خورده شد مجلس شاهوار"
  },
  {
    "poem_id": 1811,
    "vorder": 58,
    "position": 1,
    "text": "بیاراست پر بوی و رنگ و نگار"
  },
  {
    "poem_id": 1811,
    "vorder": 59,
    "position": 0,
    "text": "پرستندگان ایستاده به پای"
  },
  {
    "poem_id": 1811,
    "vorder": 60,
    "position": 1,
    "text": "بهشتی شده کاخ و گاه و سرای"
  },
  {
    "poem_id": 1811,
    "vorder": 61,
    "position": 0,
    "text": "همه آلت می سراسر بلور"
  },
  {
    "poem_id": 1811,
    "vorder": 62,
    "position": 1,
    "text": "طبقهای زرین ز مشک و بخور"
  },
  {
    "poem_id": 1811,
    "vorder": 63,
    "position": 0,
    "text": "ز زر افسری بر سر میگسار"
  },
  {
    "poem_id": 1811,
    "vorder": 64,
    "position": 1,
    "text": "به پای اندرون کفش گوهرنگار"
  },
  {
    "poem_id": 1811,
    "vorder": 65,
    "position": 0,
    "text": "فروماند زان کاخ شنگل شگفت"
  },
  {
    "poem_id": 1811,
    "vorder": 66,
    "position": 1,
    "text": "به می خوردن اندیشه اندر گرفت"
  },
  {
    "poem_id": 1811,
    "vorder": 67,
    "position": 0,
    "text": "که تا این بهشتست یا بوستان"
  },
  {
    "poem_id": 1811,
    "vorder": 68,
    "position": 1,
    "text": "همی بوی مشک آید از دوستان"
  },
  {
    "poem_id": 1811,
    "vorder": 69,
    "position": 0,
    "text": "چنین گفت با شاه ایران به راز"
  },
  {
    "poem_id": 1811,
    "vorder": 70,
    "position": 1,
    "text": "که با دخترم راه دیدار ساز"
  },
  {
    "poem_id": 1811,
    "vorder": 71,
    "position": 0,
    "text": "بفرمود تا خادمان سپاه"
  },
  {
    "poem_id": 1811,
    "vorder": 72,
    "position": 1,
    "text": "پدر را گذراند نزدیک ماه"
  },
  {
    "poem_id": 1811,
    "vorder": 73,
    "position": 0,
    "text": "همی رفت با خادمان نامدار"
  },
  {
    "poem_id": 1811,
    "vorder": 74,
    "position": 1,
    "text": "سرای دگر دید چون نوبهار"
  },
  {
    "poem_id": 1811,
    "vorder": 75,
    "position": 0,
    "text": "چو دخترش را دید بر تخت عاج"
  },
  {
    "poem_id": 1811,
    "vorder": 76,
    "position": 1,
    "text": "نشسته به آرام با فر و تاج"
  },
  {
    "poem_id": 1811,
    "vorder": 77,
    "position": 0,
    "text": "بیامد پدر بر سرش بوسه داد"
  },
  {
    "poem_id": 1811,
    "vorder": 78,
    "position": 1,
    "text": "رخان را به رخسار او برنهاد"
  },
  {
    "poem_id": 1811,
    "vorder": 79,
    "position": 0,
    "text": "پدر زار بگریست از مهر اوی"
  },
  {
    "poem_id": 1811,
    "vorder": 80,
    "position": 1,
    "text": "همان بر پدر دختر ماه‌روی"
  },
  {
    "poem_id": 1811,
    "vorder": 81,
    "position": 0,
    "text": "همی دست بر سود شنگل به دست"
  },
  {
    "poem_id": 1811,
    "vorder": 82,
    "position": 1,
    "text": "ازان کاخ و ایوان و جای نشست"
  },
  {
    "poem_id": 1811,
    "vorder": 83,
    "position": 0,
    "text": "سپینود را گفت اینت بهشت"
  },
  {
    "poem_id": 1811,
    "vorder": 84,
    "position": 1,
    "text": "برستی ز کاخ بت‌آرای زشت"
  },
  {
    "poem_id": 1811,
    "vorder": 85,
    "position": 0,
    "text": "همان هدیه‌ها را که آورده بود"
  },
  {
    "poem_id": 1811,
    "vorder": 86,
    "position": 1,
    "text": "اگر بدره و تاج و گر برده بود"
  },
  {
    "poem_id": 1811,
    "vorder": 87,
    "position": 0,
    "text": "بدو داد با هدیهٔ شهریار"
  },
  {
    "poem_id": 1811,
    "vorder": 88,
    "position": 1,
    "text": "شد آن خرم ایوان چو باغ بهار"
  },
  {
    "poem_id": 1811,
    "vorder": 89,
    "position": 0,
    "text": "وزان جایگه شد به نزدیک شاه"
  },
  {
    "poem_id": 1811,
    "vorder": 90,
    "position": 1,
    "text": "همی کرد مرد اندر ایوان نگاه"
  },
  {
    "poem_id": 1811,
    "vorder": 91,
    "position": 0,
    "text": "بزرگان چو خرم شدند از نبید"
  },
  {
    "poem_id": 1811,
    "vorder": 92,
    "position": 1,
    "text": "پرستار او خوابگاهی گزید"
  },
  {
    "poem_id": 1811,
    "vorder": 93,
    "position": 0,
    "text": "سوی خوابگه رفتن آراستند"
  },
  {
    "poem_id": 1811,
    "vorder": 94,
    "position": 1,
    "text": "ز هرگونه‌ای جامه‌ها خواستند"
  },
  {
    "poem_id": 1811,
    "vorder": 95,
    "position": 0,
    "text": "چو پیدا شد این چادر مشک‌رنگ"
  },
  {
    "poem_id": 1811,
    "vorder": 96,
    "position": 1,
    "text": "ستاره بروبر چو پشت پلنگ"
  },
  {
    "poem_id": 1811,
    "vorder": 97,
    "position": 0,
    "text": "بکردند میخوارگان خواب خوش"
  },
  {
    "poem_id": 1811,
    "vorder": 98,
    "position": 1,
    "text": "همه ناز را دست کرده بکش"
  },
  {
    "poem_id": 1811,
    "vorder": 99,
    "position": 0,
    "text": "چنین تا پدید آمد آن زرد جام"
  },
  {
    "poem_id": 1811,
    "vorder": 100,
    "position": 1,
    "text": "که خورشید خوانی مر او را به نام"
  },
  {
    "poem_id": 1811,
    "vorder": 101,
    "position": 0,
    "text": "بینداخت آن چادر لاژورد"
  },
  {
    "poem_id": 1811,
    "vorder": 102,
    "position": 1,
    "text": "بگسترد بر دشت یاقوت زرد"
  },
  {
    "poem_id": 1811,
    "vorder": 103,
    "position": 0,
    "text": "به نخچیر شد شاه بهرام گرد"
  },
  {
    "poem_id": 1811,
    "vorder": 104,
    "position": 1,
    "text": "شهنشاه هندوستان را ببرد"
  },
  {
    "poem_id": 1811,
    "vorder": 105,
    "position": 0,
    "text": "چو از دشت نخچیر باز آمدند"
  },
  {
    "poem_id": 1811,
    "vorder": 106,
    "position": 1,
    "text": "خجسته پی و بزمساز آمدند"
  },
  {
    "poem_id": 1811,
    "vorder": 107,
    "position": 0,
    "text": "چنین هم بگوی و به نخچیر و سور"
  },
  {
    "poem_id": 1811,
    "vorder": 108,
    "position": 1,
    "text": "زمانی نبودی ز بهرام دور"
  }
]