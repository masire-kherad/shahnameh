[
  {
    "poem_id": 1367,
    "vorder": 1,
    "position": 0,
    "text": "چو برداشت پرده ز پیش آفتاب"
  },
  {
    "poem_id": 1367,
    "vorder": 2,
    "position": 1,
    "text": "سپیده برآمد بپالود خواب"
  },
  {
    "poem_id": 1367,
    "vorder": 3,
    "position": 0,
    "text": "دو بیهوده را دل بدان کار گرم"
  },
  {
    "poem_id": 1367,
    "vorder": 4,
    "position": 1,
    "text": "که دیده بشویند هر دو ز شرم"
  },
  {
    "poem_id": 1367,
    "vorder": 5,
    "position": 0,
    "text": "برفتند هر دو گرازان ز جای"
  },
  {
    "poem_id": 1367,
    "vorder": 6,
    "position": 1,
    "text": "نهادند سر سوی پرده‌سرای"
  },
  {
    "poem_id": 1367,
    "vorder": 7,
    "position": 0,
    "text": "چو از خیمه ایرج به ره بنگرید"
  },
  {
    "poem_id": 1367,
    "vorder": 8,
    "position": 1,
    "text": "پر از مهر دل پیش ایشان دوید"
  },
  {
    "poem_id": 1367,
    "vorder": 9,
    "position": 0,
    "text": "برفتند با او به خیمه درون"
  },
  {
    "poem_id": 1367,
    "vorder": 10,
    "position": 1,
    "text": "سخن بیشتر بر چرا رفت و چون"
  },
  {
    "poem_id": 1367,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت تور ار تو از ما کهی"
  },
  {
    "poem_id": 1367,
    "vorder": 12,
    "position": 1,
    "text": "چرا برنهادی کلاه مهی؟"
  },
  {
    "poem_id": 1367,
    "vorder": 13,
    "position": 0,
    "text": "ترا باید ایران و تخت کیان"
  },
  {
    "poem_id": 1367,
    "vorder": 14,
    "position": 1,
    "text": "مرا بر در ترک بسته میان؟"
  },
  {
    "poem_id": 1367,
    "vorder": 15,
    "position": 0,
    "text": "برادر که مهتر به خاور به رنج"
  },
  {
    "poem_id": 1367,
    "vorder": 16,
    "position": 1,
    "text": "به سر بر ترا افسر و زیر گنج؟"
  },
  {
    "poem_id": 1367,
    "vorder": 17,
    "position": 0,
    "text": "چنین بخششی کان جهان‌جوی کرد"
  },
  {
    "poem_id": 1367,
    "vorder": 18,
    "position": 1,
    "text": "همه سوی کهتر پسر روی‌کرد"
  },
  {
    "poem_id": 1367,
    "vorder": 19,
    "position": 0,
    "text": "نه تاج کیان مانم اکنون نه گاه"
  },
  {
    "poem_id": 1367,
    "vorder": 20,
    "position": 1,
    "text": "نه نام بزرگی نه ایران سپاه"
  },
  {
    "poem_id": 1367,
    "vorder": 21,
    "position": 0,
    "text": "چو از تور بشنید ایرج سخن"
  },
  {
    "poem_id": 1367,
    "vorder": 22,
    "position": 1,
    "text": "یکی پاک‌تر پاسخ افگند بن"
  },
  {
    "poem_id": 1367,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت کای مهتر کام‌جو‌ی"
  },
  {
    "poem_id": 1367,
    "vorder": 24,
    "position": 1,
    "text": "اگر کام دل خواهی‌، آرام جوی"
  },
  {
    "poem_id": 1367,
    "vorder": 25,
    "position": 0,
    "text": "من ایران نخواهم نه خاور نه چین"
  },
  {
    "poem_id": 1367,
    "vorder": 26,
    "position": 1,
    "text": "نه شاهی نه گسترده روی زمین"
  },
  {
    "poem_id": 1367,
    "vorder": 27,
    "position": 0,
    "text": "بزرگی که فرجام او تیرگی‌ست"
  },
  {
    "poem_id": 1367,
    "vorder": 28,
    "position": 1,
    "text": "بر آن مهتری بر بباید گریست"
  },
  {
    "poem_id": 1367,
    "vorder": 29,
    "position": 0,
    "text": "سپهر بلند ار کشد زین تو"
  },
  {
    "poem_id": 1367,
    "vorder": 30,
    "position": 1,
    "text": "سرانجام‌، خشت است بالین تو"
  },
  {
    "poem_id": 1367,
    "vorder": 31,
    "position": 0,
    "text": "مرا تخت ایران اگر بود زیر"
  },
  {
    "poem_id": 1367,
    "vorder": 32,
    "position": 1,
    "text": "کنون گشتم از تاج و از تخت سیر"
  },
  {
    "poem_id": 1367,
    "vorder": 33,
    "position": 0,
    "text": "سپردم شما را کلاه و نگین"
  },
  {
    "poem_id": 1367,
    "vorder": 34,
    "position": 1,
    "text": "بدین روی با من مدارید کین"
  },
  {
    "poem_id": 1367,
    "vorder": 35,
    "position": 0,
    "text": "مرا با شما نیست ننگ و نبرد"
  },
  {
    "poem_id": 1367,
    "vorder": 36,
    "position": 1,
    "text": "روان را نباید برین رنجه کرد"
  },
  {
    "poem_id": 1367,
    "vorder": 37,
    "position": 0,
    "text": "زمانه نخواهم به آزار‌تان"
  },
  {
    "poem_id": 1367,
    "vorder": 38,
    "position": 1,
    "text": "اگر دور مانم ز دیدار‌تان"
  },
  {
    "poem_id": 1367,
    "vorder": 39,
    "position": 0,
    "text": "جز از کهتری نیست آیین من"
  },
  {
    "poem_id": 1367,
    "vorder": 40,
    "position": 1,
    "text": "مباد آز و گردن‌کشی دین من"
  },
  {
    "poem_id": 1367,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید تور از برادر چنین"
  },
  {
    "poem_id": 1367,
    "vorder": 42,
    "position": 1,
    "text": "به ابرو ز خشم اندر آورد چین"
  },
  {
    "poem_id": 1367,
    "vorder": 43,
    "position": 0,
    "text": "نیامدش گفتار ایرج پسند"
  },
  {
    "poem_id": 1367,
    "vorder": 44,
    "position": 1,
    "text": "نبد راستی نزد او ارجمند"
  },
  {
    "poem_id": 1367,
    "vorder": 45,
    "position": 0,
    "text": "به کرسی به خشم اندر آورد پای"
  },
  {
    "poem_id": 1367,
    "vorder": 46,
    "position": 1,
    "text": "همی‌گفت و برجست هزمان ز جای"
  },
  {
    "poem_id": 1367,
    "vorder": 47,
    "position": 0,
    "text": "یکایک برآمد ز جای نشست"
  },
  {
    "poem_id": 1367,
    "vorder": 48,
    "position": 1,
    "text": "گرفت آن گران کرسی زر به‌دست"
  },
  {
    "poem_id": 1367,
    "vorder": 49,
    "position": 0,
    "text": "بزد بر سر خسرو تاجدار"
  },
  {
    "poem_id": 1367,
    "vorder": 50,
    "position": 1,
    "text": "از او خواست ایرج به جان زینهار"
  },
  {
    "poem_id": 1367,
    "vorder": 51,
    "position": 0,
    "text": "نیایدت گفت ایچ بیم از خدای؟"
  },
  {
    "poem_id": 1367,
    "vorder": 52,
    "position": 1,
    "text": "نه شرم از پدر خود همین است رای"
  },
  {
    "poem_id": 1367,
    "vorder": 53,
    "position": 0,
    "text": "مکش مر مرا که‌ت سرانجام کار"
  },
  {
    "poem_id": 1367,
    "vorder": 54,
    "position": 1,
    "text": "بپیچاند از خون من کردگار"
  },
  {
    "poem_id": 1367,
    "vorder": 55,
    "position": 0,
    "text": "مکن خویشتن را ز مردم‌کشان"
  },
  {
    "poem_id": 1367,
    "vorder": 56,
    "position": 1,
    "text": "کزین پس نیابی ز من خود نشان"
  },
  {
    "poem_id": 1367,
    "vorder": 57,
    "position": 0,
    "text": "بسنده کنم زین جهان گوشه‌ای"
  },
  {
    "poem_id": 1367,
    "vorder": 58,
    "position": 1,
    "text": "به کوشش فراز آورم توشه‌ای"
  },
  {
    "poem_id": 1367,
    "vorder": 59,
    "position": 0,
    "text": "به خون برادر چه بندی کمر؟"
  },
  {
    "poem_id": 1367,
    "vorder": 60,
    "position": 1,
    "text": "چه سوزی دل پیر گشته پدر؟"
  },
  {
    "poem_id": 1367,
    "vorder": 61,
    "position": 0,
    "text": "جهان خواستی یافتی خون مریز"
  },
  {
    "poem_id": 1367,
    "vorder": 62,
    "position": 1,
    "text": "مکن با جهاندار یزدان ستیز"
  },
  {
    "poem_id": 1367,
    "vorder": 63,
    "position": 0,
    "text": "سخن را چو بشنید پاسخ نداد"
  },
  {
    "poem_id": 1367,
    "vorder": 64,
    "position": 1,
    "text": "همان گفتن آمد همان سرد باد"
  },
  {
    "poem_id": 1367,
    "vorder": 65,
    "position": 0,
    "text": "یکی خنجر آبگون برکشید"
  },
  {
    "poem_id": 1367,
    "vorder": 66,
    "position": 1,
    "text": "سراپای او چادر خون کشید"
  },
  {
    "poem_id": 1367,
    "vorder": 67,
    "position": 0,
    "text": "بدان تیز زهر‌آبگون خنجر‌ش"
  },
  {
    "poem_id": 1367,
    "vorder": 68,
    "position": 1,
    "text": "همی‌کرد چاک آن کیانی برش"
  },
  {
    "poem_id": 1367,
    "vorder": 69,
    "position": 0,
    "text": "فرود آمد از پای سرو سهی"
  },
  {
    "poem_id": 1367,
    "vorder": 70,
    "position": 1,
    "text": "گسست آن کمرگاه شاهنشهی"
  },
  {
    "poem_id": 1367,
    "vorder": 71,
    "position": 0,
    "text": "روان خون از آن چهرهٔ ارغوان"
  },
  {
    "poem_id": 1367,
    "vorder": 72,
    "position": 1,
    "text": "شد آن نامور شهریار جوان"
  },
  {
    "poem_id": 1367,
    "vorder": 73,
    "position": 0,
    "text": "جهانا بپروردیش در کنار"
  },
  {
    "poem_id": 1367,
    "vorder": 74,
    "position": 1,
    "text": "وز آن پس ندادی به جان زینهار"
  },
  {
    "poem_id": 1367,
    "vorder": 75,
    "position": 0,
    "text": "نهانی ندانم ترا دوست کیست"
  },
  {
    "poem_id": 1367,
    "vorder": 76,
    "position": 1,
    "text": "بدین آشکارت بباید گریست"
  },
  {
    "poem_id": 1367,
    "vorder": 77,
    "position": 0,
    "text": "سر تاجور ز آن تن پیلوار"
  },
  {
    "poem_id": 1367,
    "vorder": 78,
    "position": 1,
    "text": "به خنجر جدا کرد و برگشت کار"
  },
  {
    "poem_id": 1367,
    "vorder": 79,
    "position": 0,
    "text": "بیاگند مغز‌ش به مشک و عبیر"
  },
  {
    "poem_id": 1367,
    "vorder": 80,
    "position": 1,
    "text": "فرستاد نزد جهان‌بخش پیر"
  },
  {
    "poem_id": 1367,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت کاینت سر آن نیاز"
  },
  {
    "poem_id": 1367,
    "vorder": 82,
    "position": 1,
    "text": "که تاج نیاگان بدو گشت باز"
  },
  {
    "poem_id": 1367,
    "vorder": 83,
    "position": 0,
    "text": "کنون خواه تاجش ده و خواه تخت"
  },
  {
    "poem_id": 1367,
    "vorder": 84,
    "position": 1,
    "text": "شد آن سایه‌گستر نیازی درخت"
  },
  {
    "poem_id": 1367,
    "vorder": 85,
    "position": 0,
    "text": "برفتند باز آن دو بیداد شوم"
  },
  {
    "poem_id": 1367,
    "vorder": 86,
    "position": 1,
    "text": "یکی سوی ترک و یکی سوی روم"
  }
]