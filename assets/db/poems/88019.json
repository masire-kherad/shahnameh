[
  {
    "poem_id": 88019,
    "vorder": 1,
    "position": 0,
    "text": "منیژه خبر یافت از کاروان"
  },
  {
    "poem_id": 88019,
    "vorder": 2,
    "position": 1,
    "text": "یکایک بشهر اندر آمد دوان"
  },
  {
    "poem_id": 88019,
    "vorder": 3,
    "position": 0,
    "text": "برهنه نوان دخت افراسیاب"
  },
  {
    "poem_id": 88019,
    "vorder": 4,
    "position": 1,
    "text": "بر رستم آمد دو دیده پر آب"
  },
  {
    "poem_id": 88019,
    "vorder": 5,
    "position": 0,
    "text": "برو آفرین کرد و پرسید و گفت"
  },
  {
    "poem_id": 88019,
    "vorder": 6,
    "position": 1,
    "text": "همی به آستین خون مژگان برفت"
  },
  {
    "poem_id": 88019,
    "vorder": 7,
    "position": 0,
    "text": "که برخوردی از جان وز گنج خویش"
  },
  {
    "poem_id": 88019,
    "vorder": 8,
    "position": 1,
    "text": "مبادت پشیمانی از رنج خویش"
  },
  {
    "poem_id": 88019,
    "vorder": 9,
    "position": 0,
    "text": "بکام تو بادا سپهر بلند"
  },
  {
    "poem_id": 88019,
    "vorder": 10,
    "position": 1,
    "text": "ز چشم بدانت مبادا گزند"
  },
  {
    "poem_id": 88019,
    "vorder": 11,
    "position": 0,
    "text": "هر امید دل را که بستی میان"
  },
  {
    "poem_id": 88019,
    "vorder": 12,
    "position": 1,
    "text": "ز رنجی که بردی مبادت زیان"
  },
  {
    "poem_id": 88019,
    "vorder": 13,
    "position": 0,
    "text": "همیشه خرد بادت آموزگار"
  },
  {
    "poem_id": 88019,
    "vorder": 14,
    "position": 1,
    "text": "خنک بوم ایران و خوش روزگار"
  },
  {
    "poem_id": 88019,
    "vorder": 15,
    "position": 0,
    "text": "چه آگاهی استت ز گردان شاه"
  },
  {
    "poem_id": 88019,
    "vorder": 16,
    "position": 1,
    "text": "ز گیو و ز گودرز و ایران سپاه"
  },
  {
    "poem_id": 88019,
    "vorder": 17,
    "position": 0,
    "text": "نیامد به ایران ز بیژن خبر"
  },
  {
    "poem_id": 88019,
    "vorder": 18,
    "position": 1,
    "text": "نیایش نخواهد بدن چاره‌گر"
  },
  {
    "poem_id": 88019,
    "vorder": 19,
    "position": 0,
    "text": "که چون او جوانی ز گودرزیان"
  },
  {
    "poem_id": 88019,
    "vorder": 20,
    "position": 1,
    "text": "همی بگسلاند بسختی میان"
  },
  {
    "poem_id": 88019,
    "vorder": 21,
    "position": 0,
    "text": "بسودست پایش ز بند گران"
  },
  {
    "poem_id": 88019,
    "vorder": 22,
    "position": 1,
    "text": "دو دستش ز مسمار آهنگران"
  },
  {
    "poem_id": 88019,
    "vorder": 23,
    "position": 0,
    "text": "کشیده بزنجیر و بسته ببند"
  },
  {
    "poem_id": 88019,
    "vorder": 24,
    "position": 1,
    "text": "همه چاه پرخون آن مستمند"
  },
  {
    "poem_id": 88019,
    "vorder": 25,
    "position": 0,
    "text": "نیابم ز درویشی خویش خواب"
  },
  {
    "poem_id": 88019,
    "vorder": 26,
    "position": 1,
    "text": "ز نالیدن او دو چشمم پر آب"
  },
  {
    "poem_id": 88019,
    "vorder": 27,
    "position": 0,
    "text": "بترسید رستم ز گفتار اوی"
  },
  {
    "poem_id": 88019,
    "vorder": 28,
    "position": 1,
    "text": "یکی بانگ برزد براندش ز روی"
  },
  {
    "poem_id": 88019,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت کز پیش من دور شو"
  },
  {
    "poem_id": 88019,
    "vorder": 30,
    "position": 1,
    "text": "نه خسرو شناسم نه سالارنو"
  },
  {
    "poem_id": 88019,
    "vorder": 31,
    "position": 0,
    "text": "ندارم ز گودرز و گیو آگهی"
  },
  {
    "poem_id": 88019,
    "vorder": 32,
    "position": 1,
    "text": "که مغزم ز گفتار کردی تهی"
  },
  {
    "poem_id": 88019,
    "vorder": 33,
    "position": 0,
    "text": "به رستم نگه کرد و بگریست زار"
  },
  {
    "poem_id": 88019,
    "vorder": 34,
    "position": 1,
    "text": "ز خواری ببارید خون بر کنار"
  },
  {
    "poem_id": 88019,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت کای مهتر پرخرد"
  },
  {
    "poem_id": 88019,
    "vorder": 36,
    "position": 1,
    "text": "ز تو سرد گفتن نه اندر خورد"
  },
  {
    "poem_id": 88019,
    "vorder": 37,
    "position": 0,
    "text": "سخن گر نگویی مرانم ز پیش"
  },
  {
    "poem_id": 88019,
    "vorder": 38,
    "position": 1,
    "text": "که من خود دلی دارم از درد ریش"
  },
  {
    "poem_id": 88019,
    "vorder": 39,
    "position": 0,
    "text": "چنین باشد آیین ایران مگر"
  },
  {
    "poem_id": 88019,
    "vorder": 40,
    "position": 1,
    "text": "که درویش را کس نگوید خبر"
  },
  {
    "poem_id": 88019,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت رستم که ای زن چبود"
  },
  {
    "poem_id": 88019,
    "vorder": 42,
    "position": 1,
    "text": "مگر اهرمن رستخیزت نمود"
  },
  {
    "poem_id": 88019,
    "vorder": 43,
    "position": 0,
    "text": "همی بر نوشتی تو بازار من"
  },
  {
    "poem_id": 88019,
    "vorder": 44,
    "position": 1,
    "text": "بدان روی بد با تو پیکار من"
  },
  {
    "poem_id": 88019,
    "vorder": 45,
    "position": 0,
    "text": "بدین تندی از من میازار بیش"
  },
  {
    "poem_id": 88019,
    "vorder": 46,
    "position": 1,
    "text": "که دل بسته بودم ببازار خویش"
  },
  {
    "poem_id": 88019,
    "vorder": 47,
    "position": 0,
    "text": "و دیگر بجایی که کیخسروست"
  },
  {
    "poem_id": 88019,
    "vorder": 48,
    "position": 1,
    "text": "بدان شهر من خود ندارم نشست"
  },
  {
    "poem_id": 88019,
    "vorder": 49,
    "position": 0,
    "text": "ندانم همی گیو و گودرز را"
  },
  {
    "poem_id": 88019,
    "vorder": 50,
    "position": 1,
    "text": "نه پیموده‌ام هرگز آن مرز را"
  },
  {
    "poem_id": 88019,
    "vorder": 51,
    "position": 0,
    "text": "بفرمود تا خوردنی هرچ بود"
  },
  {
    "poem_id": 88019,
    "vorder": 52,
    "position": 1,
    "text": "نهادند در پیش درویش زود"
  },
  {
    "poem_id": 88019,
    "vorder": 53,
    "position": 0,
    "text": "یکایک سخن کرد ازو خواستار"
  },
  {
    "poem_id": 88019,
    "vorder": 54,
    "position": 1,
    "text": "که با تو چرا شد دژم روزگار"
  },
  {
    "poem_id": 88019,
    "vorder": 55,
    "position": 0,
    "text": "چه پرسی ز گردان و شاه و سپاه"
  },
  {
    "poem_id": 88019,
    "vorder": 56,
    "position": 1,
    "text": "چه داری همی راه ایران نگاه"
  },
  {
    "poem_id": 88019,
    "vorder": 57,
    "position": 0,
    "text": "منیژه بدو گفت کز کار من"
  },
  {
    "poem_id": 88019,
    "vorder": 58,
    "position": 1,
    "text": "چه پرسی ز بدبخت و تیمار من"
  },
  {
    "poem_id": 88019,
    "vorder": 59,
    "position": 0,
    "text": "کزان چاه سر با دلی پر ز درد"
  },
  {
    "poem_id": 88019,
    "vorder": 60,
    "position": 1,
    "text": "دویدم بنزد تو ای رادمرد"
  },
  {
    "poem_id": 88019,
    "vorder": 61,
    "position": 0,
    "text": "زدی بانگ بر من چو جنگاوران"
  },
  {
    "poem_id": 88019,
    "vorder": 62,
    "position": 1,
    "text": "نترسیدی از داور داوران"
  },
  {
    "poem_id": 88019,
    "vorder": 63,
    "position": 0,
    "text": "منیژه منم دخت افراسیاب"
  },
  {
    "poem_id": 88019,
    "vorder": 64,
    "position": 1,
    "text": "برهنه ندیدی رخم آفتاب"
  },
  {
    "poem_id": 88019,
    "vorder": 65,
    "position": 0,
    "text": "کنون دیده پرخون و دل پر ز درد"
  },
  {
    "poem_id": 88019,
    "vorder": 66,
    "position": 1,
    "text": "ازین در بدان در دوان گردگرد"
  },
  {
    "poem_id": 88019,
    "vorder": 67,
    "position": 0,
    "text": "همی نان کشکین فرازآورم"
  },
  {
    "poem_id": 88019,
    "vorder": 68,
    "position": 1,
    "text": "چنین راند یزدان قضا بر سرم"
  },
  {
    "poem_id": 88019,
    "vorder": 69,
    "position": 0,
    "text": "ازین زارتر چون بود روزگار"
  },
  {
    "poem_id": 88019,
    "vorder": 70,
    "position": 1,
    "text": "سر آرد مگر بر من این کردگار"
  },
  {
    "poem_id": 88019,
    "vorder": 71,
    "position": 0,
    "text": "چو بیچاره بیژن بدان ژرف چاه"
  },
  {
    "poem_id": 88019,
    "vorder": 72,
    "position": 1,
    "text": "نبیند شب و روز خورشید و ماه"
  },
  {
    "poem_id": 88019,
    "vorder": 73,
    "position": 0,
    "text": "بغل و بمسمار و بند گران"
  },
  {
    "poem_id": 88019,
    "vorder": 74,
    "position": 1,
    "text": "همی مرگ خواهد ز یزدان بران"
  },
  {
    "poem_id": 88019,
    "vorder": 75,
    "position": 0,
    "text": "مرا درد بر درد بفزود زین"
  },
  {
    "poem_id": 88019,
    "vorder": 76,
    "position": 1,
    "text": "نم دیدگانم بپالود زین"
  },
  {
    "poem_id": 88019,
    "vorder": 77,
    "position": 0,
    "text": "کنون گرت باشد بایران گذر"
  },
  {
    "poem_id": 88019,
    "vorder": 78,
    "position": 1,
    "text": "ز گودرز کشواد یابی خبر"
  },
  {
    "poem_id": 88019,
    "vorder": 79,
    "position": 0,
    "text": "بدرگاه خسرو مگر گیو را"
  },
  {
    "poem_id": 88019,
    "vorder": 80,
    "position": 1,
    "text": "ببینی و گر رستم نیو را"
  },
  {
    "poem_id": 88019,
    "vorder": 81,
    "position": 0,
    "text": "بگویی که بیژن بسختی درست"
  },
  {
    "poem_id": 88019,
    "vorder": 82,
    "position": 1,
    "text": "اگر دیر گیری شود کار پست"
  },
  {
    "poem_id": 88019,
    "vorder": 83,
    "position": 0,
    "text": "گرش دید خواهی میاسای دیر"
  },
  {
    "poem_id": 88019,
    "vorder": 84,
    "position": 1,
    "text": "که بر سرش سنگست و آهن بزیر"
  },
  {
    "poem_id": 88019,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت رستم که ای خوب چهر"
  },
  {
    "poem_id": 88019,
    "vorder": 86,
    "position": 1,
    "text": "که مهرت مبراد از وی سپهر"
  },
  {
    "poem_id": 88019,
    "vorder": 87,
    "position": 0,
    "text": "چرا نزد باب تو خواهشگران"
  },
  {
    "poem_id": 88019,
    "vorder": 88,
    "position": 1,
    "text": "نینگیزی از هر سوی مهتران"
  },
  {
    "poem_id": 88019,
    "vorder": 89,
    "position": 0,
    "text": "مگر بر تو بخشایش آرد پدر"
  },
  {
    "poem_id": 88019,
    "vorder": 90,
    "position": 1,
    "text": "بجوشدش خون و بسوزد جگر"
  },
  {
    "poem_id": 88019,
    "vorder": 91,
    "position": 0,
    "text": "گر آزار بابت نبودی ز پیش"
  },
  {
    "poem_id": 88019,
    "vorder": 92,
    "position": 1,
    "text": "ترا دادمی چیز ز اندازه بیش"
  },
  {
    "poem_id": 88019,
    "vorder": 93,
    "position": 0,
    "text": "بخوالیگرش گفت کز هر خورش"
  },
  {
    "poem_id": 88019,
    "vorder": 94,
    "position": 1,
    "text": "که او را بباید بیاور برش"
  },
  {
    "poem_id": 88019,
    "vorder": 95,
    "position": 0,
    "text": "یکی مرغ بریان بفرمود گرم"
  },
  {
    "poem_id": 88019,
    "vorder": 96,
    "position": 1,
    "text": "نوشته بدو اندرون نان نرم"
  },
  {
    "poem_id": 88019,
    "vorder": 97,
    "position": 0,
    "text": "سبک دست رستم بسان پری"
  },
  {
    "poem_id": 88019,
    "vorder": 98,
    "position": 1,
    "text": "بدو درنهان کرد انگشتری"
  },
  {
    "poem_id": 88019,
    "vorder": 99,
    "position": 0,
    "text": "بدو داد و گفتش بدان چاه بر"
  },
  {
    "poem_id": 88019,
    "vorder": 100,
    "position": 1,
    "text": "که بیچارگان را توی راهبر"
  },
  {
    "poem_id": 88019,
    "vorder": 101,
    "position": 0,
    "text": "منیژه بیامد بدان چاه سر"
  },
  {
    "poem_id": 88019,
    "vorder": 102,
    "position": 1,
    "text": "دوان و خورشها گرفته ببر"
  },
  {
    "poem_id": 88019,
    "vorder": 103,
    "position": 0,
    "text": "نوشته بدستار چیزی که برد"
  },
  {
    "poem_id": 88019,
    "vorder": 104,
    "position": 1,
    "text": "چنان هم که بستد ببیژن سپرد"
  },
  {
    "poem_id": 88019,
    "vorder": 105,
    "position": 0,
    "text": "نگه کرد بیژن بخیره بماند"
  },
  {
    "poem_id": 88019,
    "vorder": 106,
    "position": 1,
    "text": "ازان چاه خورشید رخ را بخواند"
  },
  {
    "poem_id": 88019,
    "vorder": 107,
    "position": 0,
    "text": "که ای مهربان از کجا یافتی"
  },
  {
    "poem_id": 88019,
    "vorder": 108,
    "position": 1,
    "text": "خورشها کزین گونه بشتافتی"
  },
  {
    "poem_id": 88019,
    "vorder": 109,
    "position": 0,
    "text": "بسا رنج و سختی کت آمد بروی"
  },
  {
    "poem_id": 88019,
    "vorder": 110,
    "position": 1,
    "text": "ز بهر منی در جهان پوی پوی"
  },
  {
    "poem_id": 88019,
    "vorder": 111,
    "position": 0,
    "text": "منیژه بدو گفت کز کاروان"
  },
  {
    "poem_id": 88019,
    "vorder": 112,
    "position": 1,
    "text": "یکی مایه ور مرد بازارگان"
  },
  {
    "poem_id": 88019,
    "vorder": 113,
    "position": 0,
    "text": "از ایران بتوران ز بهر درم"
  },
  {
    "poem_id": 88019,
    "vorder": 114,
    "position": 1,
    "text": "کشیده ز هر گونه بسیار غم"
  },
  {
    "poem_id": 88019,
    "vorder": 115,
    "position": 0,
    "text": "یکی مرد پاکیزه با هوش و فر"
  },
  {
    "poem_id": 88019,
    "vorder": 116,
    "position": 1,
    "text": "ز هر گونه با او فراوان گهر"
  },
  {
    "poem_id": 88019,
    "vorder": 117,
    "position": 0,
    "text": "گشن دستگاهی نهاده فراخ"
  },
  {
    "poem_id": 88019,
    "vorder": 118,
    "position": 1,
    "text": "یکی کلبه سازیده بر پیش کاخ"
  },
  {
    "poem_id": 88019,
    "vorder": 119,
    "position": 0,
    "text": "بمن داد زین گونه دستارخوان"
  },
  {
    "poem_id": 88019,
    "vorder": 120,
    "position": 1,
    "text": "که بر من جهان آفرین را بخوان"
  },
  {
    "poem_id": 88019,
    "vorder": 121,
    "position": 0,
    "text": "بدان چاه نزدیک آن بسته بر"
  },
  {
    "poem_id": 88019,
    "vorder": 122,
    "position": 1,
    "text": "دگر هرچ باید ببر سربسر"
  },
  {
    "poem_id": 88019,
    "vorder": 123,
    "position": 0,
    "text": "بگسترد بیژن پس آن نان پاک"
  },
  {
    "poem_id": 88019,
    "vorder": 124,
    "position": 1,
    "text": "پراومید یزدان دل از بیم و باک"
  },
  {
    "poem_id": 88019,
    "vorder": 125,
    "position": 0,
    "text": "چو دست خورش برد زان داوری"
  },
  {
    "poem_id": 88019,
    "vorder": 126,
    "position": 1,
    "text": "بدید آن نهان کرده انگشتری"
  },
  {
    "poem_id": 88019,
    "vorder": 127,
    "position": 0,
    "text": "نگینش نگه کرد و نامش بخواند"
  },
  {
    "poem_id": 88019,
    "vorder": 128,
    "position": 1,
    "text": "ز شادی بخندید و خیره بماند"
  },
  {
    "poem_id": 88019,
    "vorder": 129,
    "position": 0,
    "text": "یکی مهر پیروزه رستم بروی"
  },
  {
    "poem_id": 88019,
    "vorder": 130,
    "position": 1,
    "text": "نبشته به آهن بکردار موی"
  },
  {
    "poem_id": 88019,
    "vorder": 131,
    "position": 0,
    "text": "چو بار درخت وفا را بدید"
  },
  {
    "poem_id": 88019,
    "vorder": 132,
    "position": 1,
    "text": "بدانست کآمد غمش را کلید"
  },
  {
    "poem_id": 88019,
    "vorder": 133,
    "position": 0,
    "text": "بخندید خندیدنی شاهوار"
  },
  {
    "poem_id": 88019,
    "vorder": 134,
    "position": 1,
    "text": "چنان کآمد آواز بر چاهسار"
  },
  {
    "poem_id": 88019,
    "vorder": 135,
    "position": 0,
    "text": "منیژه چو بشنید خندیدنش"
  },
  {
    "poem_id": 88019,
    "vorder": 136,
    "position": 1,
    "text": "ازان چاه تاریک بسته تنش"
  },
  {
    "poem_id": 88019,
    "vorder": 137,
    "position": 0,
    "text": "زمانی فرو ماند زان کار سخت"
  },
  {
    "poem_id": 88019,
    "vorder": 138,
    "position": 1,
    "text": "بگفت این چه خندست ای نیکبخت"
  },
  {
    "poem_id": 88019,
    "vorder": 139,
    "position": 0,
    "text": "شگفت آمدش داستانی بزد"
  },
  {
    "poem_id": 88019,
    "vorder": 140,
    "position": 1,
    "text": "که دیوانه خندد ز کردار خود"
  },
  {
    "poem_id": 88019,
    "vorder": 141,
    "position": 0,
    "text": "چه گونه گشادی بخنده دو لب"
  },
  {
    "poem_id": 88019,
    "vorder": 142,
    "position": 1,
    "text": "که شب روز بینی همی روز شب"
  },
  {
    "poem_id": 88019,
    "vorder": 143,
    "position": 0,
    "text": "چه رازست پیش آر و با من بگوی"
  },
  {
    "poem_id": 88019,
    "vorder": 144,
    "position": 1,
    "text": "مگر بخت نیکت نمودست روی"
  },
  {
    "poem_id": 88019,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت بیژن کزین کارسخت"
  },
  {
    "poem_id": 88019,
    "vorder": 146,
    "position": 1,
    "text": "بر اومید آنم که بگشاد بخت"
  },
  {
    "poem_id": 88019,
    "vorder": 147,
    "position": 0,
    "text": "چو با من بسوگند پیمان کنی"
  },
  {
    "poem_id": 88019,
    "vorder": 148,
    "position": 1,
    "text": "همانا وفای مرا نشکنی"
  },
  {
    "poem_id": 88019,
    "vorder": 149,
    "position": 0,
    "text": "بگویم سراسر تورا داستان"
  },
  {
    "poem_id": 88019,
    "vorder": 150,
    "position": 1,
    "text": "چو باشی بسوگند همداستان"
  },
  {
    "poem_id": 88019,
    "vorder": 151,
    "position": 0,
    "text": "که گر لب بدوزی ز بهر گزند"
  },
  {
    "poem_id": 88019,
    "vorder": 152,
    "position": 1,
    "text": "زنان را زبان کم بماند ببند"
  },
  {
    "poem_id": 88019,
    "vorder": 153,
    "position": 0,
    "text": "منیژه خروشید و نالید زار"
  },
  {
    "poem_id": 88019,
    "vorder": 154,
    "position": 1,
    "text": "که بر من چه آمد بد روزگار"
  },
  {
    "poem_id": 88019,
    "vorder": 155,
    "position": 0,
    "text": "دریغ آن شده روزگاران من"
  },
  {
    "poem_id": 88019,
    "vorder": 156,
    "position": 1,
    "text": "دل خسته و چشم باران من"
  },
  {
    "poem_id": 88019,
    "vorder": 157,
    "position": 0,
    "text": "بدادم ببیژن تن و خان و مان"
  },
  {
    "poem_id": 88019,
    "vorder": 158,
    "position": 1,
    "text": "کنون گشت بر من چنین بدگمان"
  },
  {
    "poem_id": 88019,
    "vorder": 159,
    "position": 0,
    "text": "همان گنج دینار و تاج گهر"
  },
  {
    "poem_id": 88019,
    "vorder": 160,
    "position": 1,
    "text": "بتاراج دادم همه سربسر"
  },
  {
    "poem_id": 88019,
    "vorder": 161,
    "position": 0,
    "text": "پدر گشته بیزار و خویشان ز من"
  },
  {
    "poem_id": 88019,
    "vorder": 162,
    "position": 1,
    "text": "برهنه دوان بر سر انجمن"
  },
  {
    "poem_id": 88019,
    "vorder": 163,
    "position": 0,
    "text": "ز امید بیژن شدم ناامید"
  },
  {
    "poem_id": 88019,
    "vorder": 164,
    "position": 1,
    "text": "جهانم سیاه و دو دیده سپید"
  },
  {
    "poem_id": 88019,
    "vorder": 165,
    "position": 0,
    "text": "بپوشد همی راز بر من چنین"
  },
  {
    "poem_id": 88019,
    "vorder": 166,
    "position": 1,
    "text": "تو داناتری ای جهان آفرین"
  },
  {
    "poem_id": 88019,
    "vorder": 167,
    "position": 0,
    "text": "بدو گفت بیژن همه راستست"
  },
  {
    "poem_id": 88019,
    "vorder": 168,
    "position": 1,
    "text": "ز من کار تو جمله برکاستست"
  },
  {
    "poem_id": 88019,
    "vorder": 169,
    "position": 0,
    "text": "چنین گفتم اکنون نبایست گفت"
  },
  {
    "poem_id": 88019,
    "vorder": 170,
    "position": 1,
    "text": "ایا مهربان یار و هشیار جفت"
  },
  {
    "poem_id": 88019,
    "vorder": 171,
    "position": 0,
    "text": "سزد گر بهر کار پندم دهی"
  },
  {
    "poem_id": 88019,
    "vorder": 172,
    "position": 1,
    "text": "که مغزم برنج اندرون شد تهی"
  },
  {
    "poem_id": 88019,
    "vorder": 173,
    "position": 0,
    "text": "تو بشناس کاین مرد گوهر فروش"
  },
  {
    "poem_id": 88019,
    "vorder": 174,
    "position": 1,
    "text": "که خوالیگرش مر ترا داد توش"
  },
  {
    "poem_id": 88019,
    "vorder": 175,
    "position": 0,
    "text": "ز بهر من آمد بتوران فراز"
  },
  {
    "poem_id": 88019,
    "vorder": 176,
    "position": 1,
    "text": "وگرنه نبودش بگوهر نیاز"
  },
  {
    "poem_id": 88019,
    "vorder": 177,
    "position": 0,
    "text": "ببخشود بر من جهان آفرین"
  },
  {
    "poem_id": 88019,
    "vorder": 178,
    "position": 1,
    "text": "ببینم مگر پهن روی زمین"
  },
  {
    "poem_id": 88019,
    "vorder": 179,
    "position": 0,
    "text": "رهاند مرا زین غمان دراز"
  },
  {
    "poem_id": 88019,
    "vorder": 180,
    "position": 1,
    "text": "ترا زین تکاپوی و گرم و گداز"
  },
  {
    "poem_id": 88019,
    "vorder": 181,
    "position": 0,
    "text": "بنزدیک او شو بگویش نهان"
  },
  {
    "poem_id": 88019,
    "vorder": 182,
    "position": 1,
    "text": "که ای پهلوان کیان جهان"
  },
  {
    "poem_id": 88019,
    "vorder": 183,
    "position": 0,
    "text": "بدل مهربان و بتن چاره جوی"
  },
  {
    "poem_id": 88019,
    "vorder": 184,
    "position": 1,
    "text": "اگر تو خداوند رخشی بگوی"
  },
  {
    "poem_id": 88019,
    "vorder": 185,
    "position": 0,
    "text": "منیژه بیامد بکردار باد"
  },
  {
    "poem_id": 88019,
    "vorder": 186,
    "position": 1,
    "text": "ز بیژن برستم پیامش بداد"
  },
  {
    "poem_id": 88019,
    "vorder": 187,
    "position": 0,
    "text": "چو بشنید گفتار آن خوب روی"
  },
  {
    "poem_id": 88019,
    "vorder": 188,
    "position": 1,
    "text": "کزان راه دور آمده پوی پوی"
  },
  {
    "poem_id": 88019,
    "vorder": 189,
    "position": 0,
    "text": "بدانست رستم که بیژن سخن"
  },
  {
    "poem_id": 88019,
    "vorder": 190,
    "position": 1,
    "text": "گشادست بر لالهٔ سروبن"
  },
  {
    "poem_id": 88019,
    "vorder": 191,
    "position": 0,
    "text": "ببخشود و گفتش که ای خوب چهر"
  },
  {
    "poem_id": 88019,
    "vorder": 192,
    "position": 1,
    "text": "که یزدان ترا زو مبراد مهر"
  },
  {
    "poem_id": 88019,
    "vorder": 193,
    "position": 0,
    "text": "بگویش که آری خداوند رخش"
  },
  {
    "poem_id": 88019,
    "vorder": 194,
    "position": 1,
    "text": "ترا داد یزدان فریاد بخش"
  },
  {
    "poem_id": 88019,
    "vorder": 195,
    "position": 0,
    "text": "ز زاول بایران ز ایران بتور"
  },
  {
    "poem_id": 88019,
    "vorder": 196,
    "position": 1,
    "text": "ز بهر تو پیمودم این راه دور"
  },
  {
    "poem_id": 88019,
    "vorder": 197,
    "position": 0,
    "text": "بگویش که ما را بسان پلنگ"
  },
  {
    "poem_id": 88019,
    "vorder": 198,
    "position": 1,
    "text": "بسود از پی تو کمرگاه و چنگ"
  },
  {
    "poem_id": 88019,
    "vorder": 199,
    "position": 0,
    "text": "چو با او بگویی سخن راز دار"
  },
  {
    "poem_id": 88019,
    "vorder": 200,
    "position": 1,
    "text": "شب تیره گوشت به آواز دار"
  },
  {
    "poem_id": 88019,
    "vorder": 201,
    "position": 0,
    "text": "ز بیشه فرازآر هیزم بروز"
  },
  {
    "poem_id": 88019,
    "vorder": 202,
    "position": 1,
    "text": "شب آید یکی آتشی برفروز"
  },
  {
    "poem_id": 88019,
    "vorder": 203,
    "position": 0,
    "text": "منیژه ز گفتار او شاد شد"
  },
  {
    "poem_id": 88019,
    "vorder": 204,
    "position": 1,
    "text": "دلش ز اندهان یکسر آزاد شد"
  },
  {
    "poem_id": 88019,
    "vorder": 205,
    "position": 0,
    "text": "بیامد دوان تا بدان چاهسار"
  },
  {
    "poem_id": 88019,
    "vorder": 206,
    "position": 1,
    "text": "که بودش بچاه اندرون غمگسار"
  },
  {
    "poem_id": 88019,
    "vorder": 207,
    "position": 0,
    "text": "بگفتش که دادم سراسر پیام"
  },
  {
    "poem_id": 88019,
    "vorder": 208,
    "position": 1,
    "text": "بدان مرد فرخ پی نیک نام"
  },
  {
    "poem_id": 88019,
    "vorder": 209,
    "position": 0,
    "text": "چنین داد پاسخ که آنم درست"
  },
  {
    "poem_id": 88019,
    "vorder": 210,
    "position": 1,
    "text": "که بیژن بنام و نشانم بجست"
  },
  {
    "poem_id": 88019,
    "vorder": 211,
    "position": 0,
    "text": "تو با داغ دل چند پویی همی"
  },
  {
    "poem_id": 88019,
    "vorder": 212,
    "position": 1,
    "text": "که رخ را بخوناب شویی همی"
  },
  {
    "poem_id": 88019,
    "vorder": 213,
    "position": 0,
    "text": "کنون چون درست آمد از تو نشان"
  },
  {
    "poem_id": 88019,
    "vorder": 214,
    "position": 1,
    "text": "ببینی سر تیغ مردم کشان"
  },
  {
    "poem_id": 88019,
    "vorder": 215,
    "position": 0,
    "text": "زمین را بدرانم اکنون بچنگ"
  },
  {
    "poem_id": 88019,
    "vorder": 216,
    "position": 1,
    "text": "بپروین براندازم آسوده سنگ"
  },
  {
    "poem_id": 88019,
    "vorder": 217,
    "position": 0,
    "text": "مرا گفت چون تیره گردد هوا"
  },
  {
    "poem_id": 88019,
    "vorder": 218,
    "position": 1,
    "text": "شب از چنگ خورشید یابد رها"
  },
  {
    "poem_id": 88019,
    "vorder": 219,
    "position": 0,
    "text": "بکردار کوه آتشی برفروز"
  },
  {
    "poem_id": 88019,
    "vorder": 220,
    "position": 1,
    "text": "که سنگ و سر چاه گردد چو روز"
  },
  {
    "poem_id": 88019,
    "vorder": 221,
    "position": 0,
    "text": "بدان تا ببینم سر چاه را"
  },
  {
    "poem_id": 88019,
    "vorder": 222,
    "position": 1,
    "text": "بدان روشنی بسپرم راه را"
  },
  {
    "poem_id": 88019,
    "vorder": 223,
    "position": 0,
    "text": "بفرمود بیژن که آتش فروز"
  },
  {
    "poem_id": 88019,
    "vorder": 224,
    "position": 1,
    "text": "که رستیم هر دو ز تاریک روز"
  },
  {
    "poem_id": 88019,
    "vorder": 225,
    "position": 0,
    "text": "سوی کردگار جهان کرد سر"
  },
  {
    "poem_id": 88019,
    "vorder": 226,
    "position": 1,
    "text": "که ای پاک و بخشنده و دادگر"
  },
  {
    "poem_id": 88019,
    "vorder": 227,
    "position": 0,
    "text": "ز هر بد تو باشی مرا دستگیر"
  },
  {
    "poem_id": 88019,
    "vorder": 228,
    "position": 1,
    "text": "تو زن بر دل و جان بدخواه تیر"
  },
  {
    "poem_id": 88019,
    "vorder": 229,
    "position": 0,
    "text": "بده داد من زآنک بیداد کرد"
  },
  {
    "poem_id": 88019,
    "vorder": 230,
    "position": 1,
    "text": "تو دانی غمان من و داغ و درد"
  },
  {
    "poem_id": 88019,
    "vorder": 231,
    "position": 0,
    "text": "مگر بازیابم بر و بوم را"
  },
  {
    "poem_id": 88019,
    "vorder": 232,
    "position": 1,
    "text": "نمانم بننگ اختر شوم را"
  },
  {
    "poem_id": 88019,
    "vorder": 233,
    "position": 0,
    "text": "تو ای دخت رنج آزموده ز من"
  },
  {
    "poem_id": 88019,
    "vorder": 234,
    "position": 1,
    "text": "فدا کرده جان و دل و چیز و تن"
  },
  {
    "poem_id": 88019,
    "vorder": 235,
    "position": 0,
    "text": "بدین رنج کز من تو برداشتی"
  },
  {
    "poem_id": 88019,
    "vorder": 236,
    "position": 1,
    "text": "زیان مرا سود پنداشتی"
  },
  {
    "poem_id": 88019,
    "vorder": 237,
    "position": 0,
    "text": "بدادی بمن گنج و تاج و گهر"
  },
  {
    "poem_id": 88019,
    "vorder": 238,
    "position": 1,
    "text": "جهاندار خویشان و مام و پدر"
  },
  {
    "poem_id": 88019,
    "vorder": 239,
    "position": 0,
    "text": "اگر یابم از چنگ این اژدها"
  },
  {
    "poem_id": 88019,
    "vorder": 240,
    "position": 1,
    "text": "بدین روزگار جوانی رها"
  },
  {
    "poem_id": 88019,
    "vorder": 241,
    "position": 0,
    "text": "بکردار نیکان یزدان پرست"
  },
  {
    "poem_id": 88019,
    "vorder": 242,
    "position": 1,
    "text": "بپویم بپای و بیازم بدست"
  },
  {
    "poem_id": 88019,
    "vorder": 243,
    "position": 0,
    "text": "بسان پرستار پیش کیان"
  },
  {
    "poem_id": 88019,
    "vorder": 244,
    "position": 1,
    "text": "بپاداش نیکیت بندم میان"
  },
  {
    "poem_id": 88019,
    "vorder": 245,
    "position": 0,
    "text": "منیژه به هیزم شتابید سخت"
  },
  {
    "poem_id": 88019,
    "vorder": 246,
    "position": 1,
    "text": "چو مرغان برآمد بشاخ درخت"
  },
  {
    "poem_id": 88019,
    "vorder": 247,
    "position": 0,
    "text": "بخورشید بر چشم و هیزم ببر"
  },
  {
    "poem_id": 88019,
    "vorder": 248,
    "position": 1,
    "text": "که تا کی برآرد شب از کوه سر"
  },
  {
    "poem_id": 88019,
    "vorder": 249,
    "position": 0,
    "text": "چو از چشم خورشید شد ناپدید"
  },
  {
    "poem_id": 88019,
    "vorder": 250,
    "position": 1,
    "text": "شب تیره بر کوه دامن کشید"
  },
  {
    "poem_id": 88019,
    "vorder": 251,
    "position": 0,
    "text": "بدانگه که آرام گیرد جهان"
  },
  {
    "poem_id": 88019,
    "vorder": 252,
    "position": 1,
    "text": "شود آشکارای گیتی نهان"
  },
  {
    "poem_id": 88019,
    "vorder": 253,
    "position": 0,
    "text": "که لشکر کشد تیره شب پیش روز"
  },
  {
    "poem_id": 88019,
    "vorder": 254,
    "position": 1,
    "text": "بگردد سر هور گیتی فروز"
  },
  {
    "poem_id": 88019,
    "vorder": 255,
    "position": 0,
