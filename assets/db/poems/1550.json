[
  {
    "poem_id": 1550,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاه شد شاه کامد پسر"
  },
  {
    "poem_id": 1550,
    "vorder": 2,
    "position": 1,
    "text": "کلاه کیان بر نهاده بسر"
  },
  {
    "poem_id": 1550,
    "vorder": 3,
    "position": 0,
    "text": "مهان و کهانرا همه خواند پیش"
  },
  {
    "poem_id": 1550,
    "vorder": 4,
    "position": 1,
    "text": "همه زند و استا به نزدیک خویش"
  },
  {
    "poem_id": 1550,
    "vorder": 5,
    "position": 0,
    "text": "همه موبدان را به کرسی نشاند"
  },
  {
    "poem_id": 1550,
    "vorder": 6,
    "position": 1,
    "text": "پس آن خسرو تیغ‌زن را بخواند"
  },
  {
    "poem_id": 1550,
    "vorder": 7,
    "position": 0,
    "text": "بیامد گو و دست کرده بکش"
  },
  {
    "poem_id": 1550,
    "vorder": 8,
    "position": 1,
    "text": "به پیش پدر شد پرستار فش"
  },
  {
    "poem_id": 1550,
    "vorder": 9,
    "position": 0,
    "text": "شه خسروان گفت با موبدان"
  },
  {
    "poem_id": 1550,
    "vorder": 10,
    "position": 1,
    "text": "بدان رادمردان و اسپهبدان"
  },
  {
    "poem_id": 1550,
    "vorder": 11,
    "position": 0,
    "text": "چه گویید گفتا که آزاده‌اید"
  },
  {
    "poem_id": 1550,
    "vorder": 12,
    "position": 1,
    "text": "به سختی همه پرورش داده‌اید"
  },
  {
    "poem_id": 1550,
    "vorder": 13,
    "position": 0,
    "text": "به گیتی کسی را که باشد پسر"
  },
  {
    "poem_id": 1550,
    "vorder": 14,
    "position": 1,
    "text": "بدو شاد باشد دل تاجور"
  },
  {
    "poem_id": 1550,
    "vorder": 15,
    "position": 0,
    "text": "به هنگام شیرین به دایه دهد"
  },
  {
    "poem_id": 1550,
    "vorder": 16,
    "position": 1,
    "text": "یکی تاج زرینش بر سر نهد"
  },
  {
    "poem_id": 1550,
    "vorder": 17,
    "position": 0,
    "text": "همی داردش تا شود چیره دست"
  },
  {
    "poem_id": 1550,
    "vorder": 18,
    "position": 1,
    "text": "بیاموزدش خوردن و بر نشست"
  },
  {
    "poem_id": 1550,
    "vorder": 19,
    "position": 0,
    "text": "بسی رنج بیند گرانمایه مرد"
  },
  {
    "poem_id": 1550,
    "vorder": 20,
    "position": 1,
    "text": "سورای کندش آزموده نبرد"
  },
  {
    "poem_id": 1550,
    "vorder": 21,
    "position": 0,
    "text": "چو آزاده را ره به مردی رسد"
  },
  {
    "poem_id": 1550,
    "vorder": 22,
    "position": 1,
    "text": "چنان زر که از کان به زردی رسد"
  },
  {
    "poem_id": 1550,
    "vorder": 23,
    "position": 0,
    "text": "مراورا بجوید چو جویندگان"
  },
  {
    "poem_id": 1550,
    "vorder": 24,
    "position": 1,
    "text": "ورا بیش گویند گویندگان"
  },
  {
    "poem_id": 1550,
    "vorder": 25,
    "position": 0,
    "text": "سواری شود نیک و پیروز رزم"
  },
  {
    "poem_id": 1550,
    "vorder": 26,
    "position": 1,
    "text": "سرانجمنها به رزم و به بزم"
  },
  {
    "poem_id": 1550,
    "vorder": 27,
    "position": 0,
    "text": "چو نیرو کند با سرو یال و شاخ"
  },
  {
    "poem_id": 1550,
    "vorder": 28,
    "position": 1,
    "text": "پدر پیر گشته نشسته به کاخ"
  },
  {
    "poem_id": 1550,
    "vorder": 29,
    "position": 0,
    "text": "جهان را کند یکسره زو تهی"
  },
  {
    "poem_id": 1550,
    "vorder": 30,
    "position": 1,
    "text": "نباشد سزاوار تخت مهی"
  },
  {
    "poem_id": 1550,
    "vorder": 31,
    "position": 0,
    "text": "ندارد پدر جز یکی نام تخت"
  },
  {
    "poem_id": 1550,
    "vorder": 32,
    "position": 1,
    "text": "نشسته در ایوان نگهبان رخت"
  },
  {
    "poem_id": 1550,
    "vorder": 33,
    "position": 0,
    "text": "پسر را جهان و درفش و سپاه"
  },
  {
    "poem_id": 1550,
    "vorder": 34,
    "position": 1,
    "text": "پدر را یکی تاج و زرین کلاه"
  },
  {
    "poem_id": 1550,
    "vorder": 35,
    "position": 0,
    "text": "نباشد بران پور همداستان"
  },
  {
    "poem_id": 1550,
    "vorder": 36,
    "position": 1,
    "text": "پسندند گردان چنین داستان"
  },
  {
    "poem_id": 1550,
    "vorder": 37,
    "position": 0,
    "text": "ز بهر یکی تاج و افسر پسر"
  },
  {
    "poem_id": 1550,
    "vorder": 38,
    "position": 1,
    "text": "تن باب را دور خواهد ز سر"
  },
  {
    "poem_id": 1550,
    "vorder": 39,
    "position": 0,
    "text": "کند با سپاهش پس آهنگ اوی"
  },
  {
    "poem_id": 1550,
    "vorder": 40,
    "position": 1,
    "text": "نهاده دلش نیز بر جنگ اوی"
  },
  {
    "poem_id": 1550,
    "vorder": 41,
    "position": 0,
    "text": "چه گویید پیران که با این پسر"
  },
  {
    "poem_id": 1550,
    "vorder": 42,
    "position": 1,
    "text": "چه نیکو بود کار کردن پدر"
  },
  {
    "poem_id": 1550,
    "vorder": 43,
    "position": 0,
    "text": "گزینانش گفتند کای شهریار"
  },
  {
    "poem_id": 1550,
    "vorder": 44,
    "position": 1,
    "text": "نیاید خود این هرگز اندر شمار"
  },
  {
    "poem_id": 1550,
    "vorder": 45,
    "position": 0,
    "text": "پدر زنده و پور جویای گاه"
  },
  {
    "poem_id": 1550,
    "vorder": 46,
    "position": 1,
    "text": "ازین خام‌تر نیز کاری مخواه"
  },
  {
    "poem_id": 1550,
    "vorder": 47,
    "position": 0,
    "text": "جهاندار گفتا که اینک پسر"
  },
  {
    "poem_id": 1550,
    "vorder": 48,
    "position": 1,
    "text": "که آهنگ دارد به جای پدر"
  },
  {
    "poem_id": 1550,
    "vorder": 49,
    "position": 0,
    "text": "ولیکن من او را به چوبی زنم"
  },
  {
    "poem_id": 1550,
    "vorder": 50,
    "position": 1,
    "text": "که گیرند عبرت همه برزنم"
  },
  {
    "poem_id": 1550,
    "vorder": 51,
    "position": 0,
    "text": "ببندم چنانش سزاوار پس"
  },
  {
    "poem_id": 1550,
    "vorder": 52,
    "position": 1,
    "text": "ببندی که کس را نبستست کس"
  },
  {
    "poem_id": 1550,
    "vorder": 53,
    "position": 0,
    "text": "پسر گفت کای شاه آزاده‌خوی"
  },
  {
    "poem_id": 1550,
    "vorder": 54,
    "position": 1,
    "text": "مرا مرگ تو کی کند آرزوی"
  },
  {
    "poem_id": 1550,
    "vorder": 55,
    "position": 0,
    "text": "ندانم گناهی من ای شهریار"
  },
  {
    "poem_id": 1550,
    "vorder": 56,
    "position": 1,
    "text": "که کردستم اندر همه روزگار"
  },
  {
    "poem_id": 1550,
    "vorder": 57,
    "position": 0,
    "text": "به جان تو ای شاه گر بد به دل"
  },
  {
    "poem_id": 1550,
    "vorder": 58,
    "position": 1,
    "text": "گمان برده‌ام پس سرم بر گسل"
  },
  {
    "poem_id": 1550,
    "vorder": 59,
    "position": 0,
    "text": "ولیکن تو شاهی و فرمان تراست"
  },
  {
    "poem_id": 1550,
    "vorder": 60,
    "position": 1,
    "text": "تراام من و بند و زندان تراست"
  },
  {
    "poem_id": 1550,
    "vorder": 61,
    "position": 0,
    "text": "کنون بند فرما و گر خواه کش"
  },
  {
    "poem_id": 1550,
    "vorder": 62,
    "position": 1,
    "text": "مرا دل درستست و آهسته هش"
  },
  {
    "poem_id": 1550,
    "vorder": 63,
    "position": 0,
    "text": "سر خسروان گفت بند آورید"
  },
  {
    "poem_id": 1550,
    "vorder": 64,
    "position": 1,
    "text": "مر او را ببندید و زین مگذرید"
  },
  {
    "poem_id": 1550,
    "vorder": 65,
    "position": 0,
    "text": "به پیش آوریدند آهنگران"
  },
  {
    "poem_id": 1550,
    "vorder": 66,
    "position": 1,
    "text": "غل و بند و زنجیرهای گران"
  },
  {
    "poem_id": 1550,
    "vorder": 67,
    "position": 0,
    "text": "دران انجمن کس به خواهش زبان"
  },
  {
    "poem_id": 1550,
    "vorder": 68,
    "position": 1,
    "text": "نجنبید بر شهریار جهان"
  },
  {
    "poem_id": 1550,
    "vorder": 69,
    "position": 0,
    "text": "ببستند او را سر و دست و پای"
  },
  {
    "poem_id": 1550,
    "vorder": 70,
    "position": 1,
    "text": "به پیش جهاندار گیهان خدای"
  },
  {
    "poem_id": 1550,
    "vorder": 71,
    "position": 0,
    "text": "چنانش ببستند پای استوار"
  },
  {
    "poem_id": 1550,
    "vorder": 72,
    "position": 1,
    "text": "که هرکش همی دید بگریست زار"
  },
  {
    "poem_id": 1550,
    "vorder": 73,
    "position": 0,
    "text": "چو کردند زنجیر در گردنش"
  },
  {
    "poem_id": 1550,
    "vorder": 74,
    "position": 1,
    "text": "بفرمود بسته به در بردنش"
  },
  {
    "poem_id": 1550,
    "vorder": 75,
    "position": 0,
    "text": "بیارید گفتا یکی پیل نر"
  },
  {
    "poem_id": 1550,
    "vorder": 76,
    "position": 1,
    "text": "دونده پرنده چو مرغی به پر"
  },
  {
    "poem_id": 1550,
    "vorder": 77,
    "position": 0,
    "text": "فراز آوریدند پیلی چو نیل"
  },
  {
    "poem_id": 1550,
    "vorder": 78,
    "position": 1,
    "text": "مر او را ببستند بر پشت پیل"
  },
  {
    "poem_id": 1550,
    "vorder": 79,
    "position": 0,
    "text": "چو بردندش از پیش فرخ پدر"
  },
  {
    "poem_id": 1550,
    "vorder": 80,
    "position": 1,
    "text": "دو دیده پر از آب و رخساره‌تر"
  },
  {
    "poem_id": 1550,
    "vorder": 81,
    "position": 0,
    "text": "فرستاده سوی دژ گنبدان"
  },
  {
    "poem_id": 1550,
    "vorder": 82,
    "position": 1,
    "text": "گرفته پس و پیش اسپهبدان"
  },
  {
    "poem_id": 1550,
    "vorder": 83,
    "position": 0,
    "text": "پر از درد بردند بر کوهسار"
  },
  {
    "poem_id": 1550,
    "vorder": 84,
    "position": 1,
    "text": "ستون آوریدند ز آهن چهار"
  },
  {
    "poem_id": 1550,
    "vorder": 85,
    "position": 0,
    "text": "به کرده ستونها بزرگ آهنین"
  },
  {
    "poem_id": 1550,
    "vorder": 86,
    "position": 1,
    "text": "سر اندر هوا و بن اندر زمین"
  },
  {
    "poem_id": 1550,
    "vorder": 87,
    "position": 0,
    "text": "مر او را برانجا ببستند سخت"
  },
  {
    "poem_id": 1550,
    "vorder": 88,
    "position": 1,
    "text": "ز تختش بیفگند و برگشت بخت"
  },
  {
    "poem_id": 1550,
    "vorder": 89,
    "position": 0,
    "text": "نگهبان او کرد پس‌اند مرد"
  },
  {
    "poem_id": 1550,
    "vorder": 90,
    "position": 1,
    "text": "گو پهلوان زاده با داغ و درد"
  },
  {
    "poem_id": 1550,
    "vorder": 91,
    "position": 0,
    "text": "بدان تنگی اندر همی زیستی"
  },
  {
    "poem_id": 1550,
    "vorder": 92,
    "position": 1,
    "text": "زمان تا زمان زار بگریستی"
  }
]