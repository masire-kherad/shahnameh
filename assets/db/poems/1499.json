[
  {
    "poem_id": 1499,
    "vorder": 1,
    "position": 0,
    "text": "چو از لشگر آگه شد افراسیاب"
  },
  {
    "poem_id": 1499,
    "vorder": 2,
    "position": 1,
    "text": "برو تیره شد تابش آفتاب"
  },
  {
    "poem_id": 1499,
    "vorder": 3,
    "position": 0,
    "text": "بزد کوس و نای و سپه برنشاند"
  },
  {
    "poem_id": 1499,
    "vorder": 4,
    "position": 1,
    "text": "ز ایوان به کردار آتش براند"
  },
  {
    "poem_id": 1499,
    "vorder": 5,
    "position": 0,
    "text": "دو منزل یکی کرد و آمد دوان"
  },
  {
    "poem_id": 1499,
    "vorder": 6,
    "position": 1,
    "text": "همی تاخت برسان تیر از کمان"
  },
  {
    "poem_id": 1499,
    "vorder": 7,
    "position": 0,
    "text": "بیاورد لشکر بران رزمگاه"
  },
  {
    "poem_id": 1499,
    "vorder": 8,
    "position": 1,
    "text": "که آورد کلباد بد با سپاه"
  },
  {
    "poem_id": 1499,
    "vorder": 9,
    "position": 0,
    "text": "همه مرز لشکر پراگنده دید"
  },
  {
    "poem_id": 1499,
    "vorder": 10,
    "position": 1,
    "text": "به هر جای بر مردم افگنده دید"
  },
  {
    "poem_id": 1499,
    "vorder": 11,
    "position": 0,
    "text": "بپرسید کاین پهلوان با سپاه"
  },
  {
    "poem_id": 1499,
    "vorder": 12,
    "position": 1,
    "text": "کی آمد ز ایران بدین رزمگاه"
  },
  {
    "poem_id": 1499,
    "vorder": 13,
    "position": 0,
    "text": "نبرد آگهی کس ز جنگ‌آوران"
  },
  {
    "poem_id": 1499,
    "vorder": 14,
    "position": 1,
    "text": "که بگذشت زین سان سپاهی گران"
  },
  {
    "poem_id": 1499,
    "vorder": 15,
    "position": 0,
    "text": "که برد آگهی نزد آن دیوزاد"
  },
  {
    "poem_id": 1499,
    "vorder": 16,
    "position": 1,
    "text": "که کس را دل و مغز پیران مباد"
  },
  {
    "poem_id": 1499,
    "vorder": 17,
    "position": 0,
    "text": "اگر خاک بودیش پروردگار"
  },
  {
    "poem_id": 1499,
    "vorder": 18,
    "position": 1,
    "text": "ندیدی دو چشم من این روزگار"
  },
  {
    "poem_id": 1499,
    "vorder": 19,
    "position": 0,
    "text": "سپهرم بدو گفت کاسان بدی"
  },
  {
    "poem_id": 1499,
    "vorder": 20,
    "position": 1,
    "text": "اگر دل ز لشکر هراسان بدی"
  },
  {
    "poem_id": 1499,
    "vorder": 21,
    "position": 0,
    "text": "یکی گیو گودرز بودست و بس"
  },
  {
    "poem_id": 1499,
    "vorder": 22,
    "position": 1,
    "text": "سوار ایچ با او ندیدند کس"
  },
  {
    "poem_id": 1499,
    "vorder": 23,
    "position": 0,
    "text": "ستوه آمد از چنگ یک تن سپاه"
  },
  {
    "poem_id": 1499,
    "vorder": 24,
    "position": 1,
    "text": "همی رفت گیو و فرنگیس و شاه"
  },
  {
    "poem_id": 1499,
    "vorder": 25,
    "position": 0,
    "text": "سپهبد چو گفت سپهرم شنید"
  },
  {
    "poem_id": 1499,
    "vorder": 26,
    "position": 1,
    "text": "سپاهی ز پیش اندر آمد پدید"
  },
  {
    "poem_id": 1499,
    "vorder": 27,
    "position": 0,
    "text": "سپهدار پیران به پیش اندرون"
  },
  {
    "poem_id": 1499,
    "vorder": 28,
    "position": 1,
    "text": "سرو روی و یالش همه پر ز خون"
  },
  {
    "poem_id": 1499,
    "vorder": 29,
    "position": 0,
    "text": "گمان برد کاو گیو رایافتست"
  },
  {
    "poem_id": 1499,
    "vorder": 30,
    "position": 1,
    "text": "به پیروزی از پیش بشتافتست"
  },
  {
    "poem_id": 1499,
    "vorder": 31,
    "position": 0,
    "text": "چو نزدیکتر شد نگه کرد شاه"
  },
  {
    "poem_id": 1499,
    "vorder": 32,
    "position": 1,
    "text": "چنان خسته بد پهلوان سپاه"
  },
  {
    "poem_id": 1499,
    "vorder": 33,
    "position": 0,
    "text": "ورا دید بر زین ببسته چو سنگ"
  },
  {
    "poem_id": 1499,
    "vorder": 34,
    "position": 1,
    "text": "دو دست از پس پشت با پالهنگ"
  },
  {
    "poem_id": 1499,
    "vorder": 35,
    "position": 0,
    "text": "بپرسید و زو ماند اندر شگفت"
  },
  {
    "poem_id": 1499,
    "vorder": 36,
    "position": 1,
    "text": "غمی گشت و اندیشه اندر گرفت"
  },
  {
    "poem_id": 1499,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت پیران که شیر ژیان"
  },
  {
    "poem_id": 1499,
    "vorder": 38,
    "position": 1,
    "text": "نه درنده گرگ و نه ببر بیان"
  },
  {
    "poem_id": 1499,
    "vorder": 39,
    "position": 0,
    "text": "نباشد چنان در صف کارزار"
  },
  {
    "poem_id": 1499,
    "vorder": 40,
    "position": 1,
    "text": "کجا گیو تنها بد ای شهریار"
  },
  {
    "poem_id": 1499,
    "vorder": 41,
    "position": 0,
    "text": "من آن دیدم از گیو کز پیل و شیر"
  },
  {
    "poem_id": 1499,
    "vorder": 42,
    "position": 1,
    "text": "نبیند جهاندیده مرد دلیر"
  },
  {
    "poem_id": 1499,
    "vorder": 43,
    "position": 0,
    "text": "بر آن سان کجا بردمد روز جنگ"
  },
  {
    "poem_id": 1499,
    "vorder": 44,
    "position": 1,
    "text": "ز نفسش به دریا بسوزد نهنگ"
  },
  {
    "poem_id": 1499,
    "vorder": 45,
    "position": 0,
    "text": "نخست اندر آمد به گرز گران"
  },
  {
    "poem_id": 1499,
    "vorder": 46,
    "position": 1,
    "text": "همی کوفت چون پتک آهنگران"
  },
  {
    "poem_id": 1499,
    "vorder": 47,
    "position": 0,
    "text": "به اسپ و به گرز و به پای و رکیب"
  },
  {
    "poem_id": 1499,
    "vorder": 48,
    "position": 1,
    "text": "سوار از فراز اندر آمد به شیب"
  },
  {
    "poem_id": 1499,
    "vorder": 49,
    "position": 0,
    "text": "همانا که باران نبارد ز میغ"
  },
  {
    "poem_id": 1499,
    "vorder": 50,
    "position": 1,
    "text": "فزون زانک بارید بر سرش تیغ"
  },
  {
    "poem_id": 1499,
    "vorder": 51,
    "position": 0,
    "text": "چو اندر گلستان به زین بر بخفت"
  },
  {
    "poem_id": 1499,
    "vorder": 52,
    "position": 1,
    "text": "تو گفتی که گشتست با کوه جفت"
  },
  {
    "poem_id": 1499,
    "vorder": 53,
    "position": 0,
    "text": "سرانجام برگشت یکسر سپاه"
  },
  {
    "poem_id": 1499,
    "vorder": 54,
    "position": 1,
    "text": "بجز من نشد پیش او کینه خواه"
  },
  {
    "poem_id": 1499,
    "vorder": 55,
    "position": 0,
    "text": "گریزان ز من تاب داده کمند"
  },
  {
    "poem_id": 1499,
    "vorder": 56,
    "position": 1,
    "text": "بیفگند و آمد میانم به بند"
  },
  {
    "poem_id": 1499,
    "vorder": 57,
    "position": 0,
    "text": "پراگنده شد دانش و هوش من"
  },
  {
    "poem_id": 1499,
    "vorder": 58,
    "position": 1,
    "text": "به خاک اندر آمد سر و دوش من"
  },
  {
    "poem_id": 1499,
    "vorder": 59,
    "position": 0,
    "text": "از اسپ اندر آمد دو دستم ببست"
  },
  {
    "poem_id": 1499,
    "vorder": 60,
    "position": 1,
    "text": "برافگند بر زین و خود بر نشست"
  },
  {
    "poem_id": 1499,
    "vorder": 61,
    "position": 0,
    "text": "زمانی سر وپایم اندر کمند"
  },
  {
    "poem_id": 1499,
    "vorder": 62,
    "position": 1,
    "text": "به دیگر زمان زیر سوگند و بند"
  },
  {
    "poem_id": 1499,
    "vorder": 63,
    "position": 0,
    "text": "به جان و سر شاه و خورشید وماه"
  },
  {
    "poem_id": 1499,
    "vorder": 64,
    "position": 1,
    "text": "به دادار هرمزد و تخت و کلاه"
  },
  {
    "poem_id": 1499,
    "vorder": 65,
    "position": 0,
    "text": "مرا داد زین‌گونه سوگند سخت"
  },
  {
    "poem_id": 1499,
    "vorder": 66,
    "position": 1,
    "text": "بخوردم چو دیدم که برگشت بخت"
  },
  {
    "poem_id": 1499,
    "vorder": 67,
    "position": 0,
    "text": "که کس را نگویی که بگشای دست"
  },
  {
    "poem_id": 1499,
    "vorder": 68,
    "position": 1,
    "text": "چنین رو دمان تا بجای نشست"
  },
  {
    "poem_id": 1499,
    "vorder": 69,
    "position": 0,
    "text": "ندانم چه رازست نزد سپهر"
  },
  {
    "poem_id": 1499,
    "vorder": 70,
    "position": 1,
    "text": "بخواهد بریدن ز ما پاک مهر"
  },
  {
    "poem_id": 1499,
    "vorder": 71,
    "position": 0,
    "text": "چو بشنید گفتارش افراسیاب"
  },
  {
    "poem_id": 1499,
    "vorder": 72,
    "position": 1,
    "text": "بدیده ز خشم اندرآورد آب"
  },
  {
    "poem_id": 1499,
    "vorder": 73,
    "position": 0,
    "text": "یکی بانگ برزد ز پیشش براند"
  },
  {
    "poem_id": 1499,
    "vorder": 74,
    "position": 1,
    "text": "بپیچید پیران و خامش بماند"
  },
  {
    "poem_id": 1499,
    "vorder": 75,
    "position": 0,
    "text": "ازان پس به مغز اندر افگند باد"
  },
  {
    "poem_id": 1499,
    "vorder": 76,
    "position": 1,
    "text": "به دشنام و سوگند لب برگشاد"
  },
  {
    "poem_id": 1499,
    "vorder": 77,
    "position": 0,
    "text": "که گر گیو و کیخسرو دیوزاد"
  },
  {
    "poem_id": 1499,
    "vorder": 78,
    "position": 1,
    "text": "شوند ابر غرنده گر تیز باد"
  },
  {
    "poem_id": 1499,
    "vorder": 79,
    "position": 0,
    "text": "فرود آورمشان ز ابر بلند"
  },
  {
    "poem_id": 1499,
    "vorder": 80,
    "position": 1,
    "text": "بزد دست و ز گرز بگشاد بند"
  },
  {
    "poem_id": 1499,
    "vorder": 81,
    "position": 0,
    "text": "میانشان ببرم به شمشیر تیز"
  },
  {
    "poem_id": 1499,
    "vorder": 82,
    "position": 1,
    "text": "به ماهی دهم تا کند ریز ریز"
  },
  {
    "poem_id": 1499,
    "vorder": 83,
    "position": 0,
    "text": "چو کیخسرو ایران بجوید همی"
  },
  {
    "poem_id": 1499,
    "vorder": 84,
    "position": 1,
    "text": "فرنگیس باری چه پوید همی"
  },
  {
    "poem_id": 1499,
    "vorder": 85,
    "position": 0,
    "text": "خود و سرکشان سوی جیحون کشید"
  },
  {
    "poem_id": 1499,
    "vorder": 86,
    "position": 1,
    "text": "همی دامن از چشم در خون کشید"
  },
  {
    "poem_id": 1499,
    "vorder": 87,
    "position": 0,
    "text": "به هومان بفرمود کاندر شتاب"
  },
  {
    "poem_id": 1499,
    "vorder": 88,
    "position": 1,
    "text": "عنان را بکش تا لب رود آب"
  },
  {
    "poem_id": 1499,
    "vorder": 89,
    "position": 0,
    "text": "که چون گیو و خسرو ز جیحون گذشت"
  },
  {
    "poem_id": 1499,
    "vorder": 90,
    "position": 1,
    "text": "غم و رنج ما باد گردد بدشت"
  },
  {
    "poem_id": 1499,
    "vorder": 91,
    "position": 0,
    "text": "نشان آمد از گفتهٔ راستان"
  },
  {
    "poem_id": 1499,
    "vorder": 92,
    "position": 1,
    "text": "که دانا بگفت از گه باستان"
  },
  {
    "poem_id": 1499,
    "vorder": 93,
    "position": 0,
    "text": "که از تخمهٔ تور وز کیقباد"
  },
  {
    "poem_id": 1499,
    "vorder": 94,
    "position": 1,
    "text": "یکی شاه خیزد ز هر دو نژاد"
  },
  {
    "poem_id": 1499,
    "vorder": 95,
    "position": 0,
    "text": "که توران زمین را کند خارستان"
  },
  {
    "poem_id": 1499,
    "vorder": 96,
    "position": 1,
    "text": "نماند برین بوم و بر شارستان"
  },
  {
    "poem_id": 1499,
    "vorder": 97,
    "position": 0,
    "text": "رسیدند پس گیو و خسرو بر آب"
  },
  {
    "poem_id": 1499,
    "vorder": 98,
    "position": 1,
    "text": "همی بودشان بر گذشتن شتاب"
  },
  {
    "poem_id": 1499,
    "vorder": 99,
    "position": 0,
    "text": "گرفتند پیگار با باژخواه"
  },
  {
    "poem_id": 1499,
    "vorder": 100,
    "position": 1,
    "text": "که کشتی کدامست بر باژگاه"
  },
  {
    "poem_id": 1499,
    "vorder": 101,
    "position": 0,
    "text": "نوندی کجا بادبانش نکوست"
  },
  {
    "poem_id": 1499,
    "vorder": 102,
    "position": 1,
    "text": "به خوبی سزاوار کیخسرو اوست"
  },
  {
    "poem_id": 1499,
    "vorder": 103,
    "position": 0,
    "text": "چنین گفت با گیو پس باج خواه"
  },
  {
    "poem_id": 1499,
    "vorder": 104,
    "position": 1,
    "text": "که آب روان را چه چاکر چه شاه"
  },
  {
    "poem_id": 1499,
    "vorder": 105,
    "position": 0,
    "text": "همی گر گذر بایدت ز آب رود"
  },
  {
    "poem_id": 1499,
    "vorder": 106,
    "position": 1,
    "text": "فرستاد باید به کشتی درود"
  },
  {
    "poem_id": 1499,
    "vorder": 107,
    "position": 0,
    "text": "بدو گفت گیو آنچ خواهی بخواه"
  },
  {
    "poem_id": 1499,
    "vorder": 108,
    "position": 1,
    "text": "گذر ده که تنگ اندر آمد سپاه"
  },
  {
    "poem_id": 1499,
    "vorder": 109,
    "position": 0,
    "text": "بخواهم ز تو باج گفت اندکی"
  },
  {
    "poem_id": 1499,
    "vorder": 110,
    "position": 1,
    "text": "ازین چار چیزت بخواهم یکی"
  },
  {
    "poem_id": 1499,
    "vorder": 111,
    "position": 0,
    "text": "زره خواهم از تو گر اسپ سیاه"
  },
  {
    "poem_id": 1499,
    "vorder": 112,
    "position": 1,
    "text": "پرستار و گر پور فرخنده ماه"
  },
  {
    "poem_id": 1499,
    "vorder": 113,
    "position": 0,
    "text": "بدو گفت گیو ای گسسته خرد"
  },
  {
    "poem_id": 1499,
    "vorder": 114,
    "position": 1,
    "text": "سخن زان نشان گوی کاندر خورد"
  },
  {
    "poem_id": 1499,
    "vorder": 115,
    "position": 0,
    "text": "به هر باژ گر شاه شهری بدی"
  },
  {
    "poem_id": 1499,
    "vorder": 116,
    "position": 1,
    "text": "ترا زین جهان نیز بهری بدی"
  },
  {
    "poem_id": 1499,
    "vorder": 117,
    "position": 0,
    "text": "که باشی که شه را کنی خواستار"
  },
  {
    "poem_id": 1499,
    "vorder": 118,
    "position": 1,
    "text": "چنین باد پیمایی ای بادسار"
  },
  {
    "poem_id": 1499,
    "vorder": 119,
    "position": 0,
    "text": "وگر مادر شاه خواهی همی"
  },
  {
    "poem_id": 1499,
    "vorder": 120,
    "position": 1,
    "text": "به باژ افسر ماه خواهی همی"
  },
  {
    "poem_id": 1499,
    "vorder": 121,
    "position": 0,
    "text": "سه دیگر چو شبرنگ بهزاد را"
  },
  {
    "poem_id": 1499,
    "vorder": 122,
    "position": 1,
    "text": "که کوتاه دارد به تگ باد را"
  },
  {
    "poem_id": 1499,
    "vorder": 123,
    "position": 0,
    "text": "چهارم چو جستی به خیره زره"
  },
  {
    "poem_id": 1499,
    "vorder": 124,
    "position": 1,
    "text": "که آن را ندانی گره تا گره"
  },
  {
    "poem_id": 1499,
    "vorder": 125,
    "position": 0,
    "text": "نگردد چنین آهن از آب تر"
  },
  {
    "poem_id": 1499,
    "vorder": 126,
    "position": 1,
    "text": "نه آتش برو بر بود کارگر"
  },
  {
    "poem_id": 1499,
    "vorder": 127,
    "position": 0,
    "text": "نه نیزه نه شمشیر هندی نه تیر"
  },
  {
    "poem_id": 1499,
    "vorder": 128,
    "position": 1,
    "text": "چنین باژ خواهی بدین آب‌گیر"
  },
  {
    "poem_id": 1499,
    "vorder": 129,
    "position": 0,
    "text": "کنون آب ما را و کشتی ترا"
  },
  {
    "poem_id": 1499,
    "vorder": 130,
    "position": 1,
    "text": "بدین گونه شاهی درشتی ترا"
  },
  {
    "poem_id": 1499,
    "vorder": 131,
    "position": 0,
    "text": "بدو گفت گیو ار تو کیخسروی"
  },
  {
    "poem_id": 1499,
    "vorder": 132,
    "position": 1,
    "text": "نبینی ازین آب جز نیکوی"
  },
  {
    "poem_id": 1499,
    "vorder": 133,
    "position": 0,
    "text": "فریدون که بگذاشت اروند رود"
  },
  {
    "poem_id": 1499,
    "vorder": 134,
    "position": 1,
    "text": "فرستاد تخت مهی را درود"
  },
  {
    "poem_id": 1499,
    "vorder": 135,
    "position": 0,
    "text": "جهانی شد او را سراسر رهی"
  },
  {
    "poem_id": 1499,
    "vorder": 136,
    "position": 1,
    "text": "که با روشنی بود و با فرهی"
  },
  {
    "poem_id": 1499,
    "vorder": 137,
    "position": 0,
    "text": "چه اندیشی ار شاه ایران توی"
  },
  {
    "poem_id": 1499,
    "vorder": 138,
    "position": 1,
    "text": "سرنامداران و شیران توی"
  },
  {
    "poem_id": 1499,
    "vorder": 139,
    "position": 0,
    "text": "به بد آب را کی بود بر تو راه"
  },
  {
    "poem_id": 1499,
    "vorder": 140,
    "position": 1,
    "text": "که با فر و برزی و زیبای گاه"
  },
  {
    "poem_id": 1499,
    "vorder": 141,
    "position": 0,
    "text": "اگر من شوم غرقه گر مادرت"
  },
  {
    "poem_id": 1499,
    "vorder": 142,
    "position": 1,
    "text": "گزندی نباید که گیرد سرت"
  },
  {
    "poem_id": 1499,
    "vorder": 143,
    "position": 0,
    "text": "ز مادر تو بودی مراد جهان"
  },
  {
    "poem_id": 1499,
    "vorder": 144,
    "position": 1,
    "text": "که بیکار بد تخت شاهنشهان"
  },
  {
    "poem_id": 1499,
    "vorder": 145,
    "position": 0,
    "text": "مرا نیز مادر ز بهر تو زاد"
  },
  {
    "poem_id": 1499,
    "vorder": 146,
    "position": 1,
    "text": "ازین کار بر دل مکن هیچ یاد"
  },
  {
    "poem_id": 1499,
    "vorder": 147,
    "position": 0,
    "text": "که من بیگمانم که افراسیاب"
  },
  {
    "poem_id": 1499,
    "vorder": 148,
    "position": 1,
    "text": "بیاید دمان تا لب رود آب"
  },
  {
    "poem_id": 1499,
    "vorder": 149,
    "position": 0,
    "text": "مرا برکشد زنده بر دار خوار"
  },
  {
    "poem_id": 1499,
    "vorder": 150,
    "position": 1,
    "text": "فرنگیس را با تو ای شهریار"
  },
  {
    "poem_id": 1499,
    "vorder": 151,
    "position": 0,
    "text": "به آب افگند ماهیان‌تان خورند"
  },
  {
    "poem_id": 1499,
    "vorder": 152,
    "position": 1,
    "text": "وگر زیر نعل اندرون بسپرند"
  },
  {
    "poem_id": 1499,
    "vorder": 153,
    "position": 0,
    "text": "بدو گفت کیخسرو اینست و بس"
  },
  {
    "poem_id": 1499,
    "vorder": 154,
    "position": 1,
    "text": "پناهم به یزدان فریادرس"
  },
  {
    "poem_id": 1499,
    "vorder": 155,
    "position": 0,
    "text": "فرود آمد از بارهٔ راه‌جوی"
  },
  {
    "poem_id": 1499,
    "vorder": 156,
    "position": 1,
    "text": "بمالید و بنهاد بر خاک روی"
  },
  {
    "poem_id": 1499,
    "vorder": 157,
    "position": 0,
    "text": "همی گفت پشت و پناهم توی"
  },
  {
    "poem_id": 1499,
    "vorder": 158,
    "position": 1,
    "text": "نمایندهٔ رای و راهم توی"
  },
  {
    "poem_id": 1499,
    "vorder": 159,
    "position": 0,
    "text": "درستی و پستی مرا فرّ تست"
  },
  {
    "poem_id": 1499,
    "vorder": 160,
    "position": 1,
    "text": "روان و خرد سایهٔ پرّ تست"
  },
  {
    "poem_id": 1499,
    "vorder": 161,
    "position": 0,
    "text": "به آب اندرون دلفزایم توی"
  },
  {
    "poem_id": 1499,
    "vorder": 162,
    "position": 1,
    "text": "به خشکی همان رهنمایم توی"
  },
  {
    "poem_id": 1499,
    "vorder": 163,
    "position": 0,
    "text": "به آب اندر افگند خسرو سیاه"
  },
  {
    "poem_id": 1499,
    "vorder": 164,
    "position": 1,
    "text": "چو کشتی همی راند تا باژگاه"
  },
  {
    "poem_id": 1499,
    "vorder": 165,
    "position": 0,
    "text": "پس او فرنگیس و گیو دلیر"
  },
  {
    "poem_id": 1499,
    "vorder": 166,
    "position": 1,
    "text": "نترسد ز جیحون و زان آب شیر"
  },
  {
    "poem_id": 1499,
    "vorder": 167,
    "position": 0,
    "text": "بدان سو گذشتند هر سه درست"
  },
  {
    "poem_id": 1499,
    "vorder": 168,
    "position": 1,
    "text": "جهانجوی خسرو سر و تن بشست"
  },
  {
    "poem_id": 1499,
    "vorder": 169,
    "position": 0,
    "text": "بدان نیستان در نیایش گرفت"
  },
  {
    "poem_id": 1499,
    "vorder": 170,
    "position": 1,
    "text": "جهان آفرین را ستایش گرفت"
  },
  {
    "poem_id": 1499,
    "vorder": 171,
    "position": 0,
    "text": "چو از رود کردند هر سه گذر"
  },
  {
    "poem_id": 1499,
    "vorder": 172,
    "position": 1,
    "text": "نگهبان کشتی شد آسیمه سر"
  },
  {
    "poem_id": 1499,
    "vorder": 173,
    "position": 0,
    "text": "به یاران چنین گفت کاینت شگفت"
  },
  {
    "poem_id": 1499,
    "vorder": 174,
    "position": 1,
    "text": "کزین برتر اندیشه نتوان گرفت"
  },
  {
    "poem_id": 1499,
    "vorder": 175,
    "position": 0,
    "text": "بهاران و جیحون و آب روان"
  },
  {
    "poem_id": 1499,
    "vorder": 176,
    "position": 1,
    "text": "سه جوشنور و اسپ و برگستوان"
  },
  {
    "poem_id": 1499,
    "vorder": 177,
    "position": 0,
    "text": "بدین ژرف دریا چنین بگذرد"
  },
  {
    "poem_id": 1499,
    "vorder": 178,
    "position": 1,
    "text": "خردمندش از مردمان نشمرد"
  },
  {
    "poem_id": 1499,
    "vorder": 179,
    "position": 0,
    "text": "پشیمان شد از کار و گفتار خویش"
  },
  {
    "poem_id": 1499,
    "vorder": 180,
    "position": 1,
    "text": "تبه دید ازان کار بازار خویش"
  },
  {
    "poem_id": 1499,
    "vorder": 181,
    "position": 0,
    "text": "بیاراست کشتی به چیزی که داشت"
  },
  {
    "poem_id": 1499,
    "vorder": 182,
    "position": 1,
    "text": "ز باد هوا بادبان برگذاشت"
  },
  {
    "poem_id": 1499,
    "vorder": 183,
    "position": 0,
    "text": "به پوزش برفت از پس شهریار"
  },
  {
    "poem_id": 1499,
    "vorder": 184,
    "position": 1,
    "text": "چو آمد به نزدیکی رودبار"
  },
  {
    "poem_id": 1499,
    "vorder": 185,
    "position": 0,
    "text": "همه هدیه ها نزد شاه آورید"
  },
  {
    "poem_id": 1499,
    "vorder": 186,
    "position": 1,
    "text": "کمان و کمند و کلاه آورید"
  },
  {
    "poem_id": 1499,
    "vorder": 187,
    "position": 0,
    "text": "بدو گفت گیو ای سگ بی‌خرد"
  },
  {
    "poem_id": 1499,
    "vorder": 188,
    "position": 1,
    "text": "توگفتی که این آب مردم خورد"
  },
  {
    "poem_id": 1499,
    "vorder": 189,
    "position": 0,
    "text": "چنین مایه ور پرهنر شهریار"
  },
  {
    "poem_id": 1499,
    "vorder": 190,
    "position": 1,
    "text": "همی از تو کشتی کند خواستار"
  },
  {
    "poem_id": 1499,
    "vorder": 191,
    "position": 0,
    "text": "ندادی کنون هدیهٔ تو مباد"
  },
  {
    "poem_id": 1499,
    "vorder": 192,
    "position": 1,
    "text": "بود روز کاین روزت آید به یاد"
  },
  {
    "poem_id": 1499,
    "vorder": 193,
    "position": 0,
    "text": "چنان خوار برگشت زو رودبان"
  },
  {
    "poem_id": 1499,
    "vorder": 194,
    "position": 1,
    "text": "که جان را همی گفت پدرودمان"
  },
  {
    "poem_id": 1499,
    "vorder": 195,
    "position": 0,
    "text": "چو آمد به نزدیکی باژگاه"
  },
  {
    "poem_id": 1499,
    "vorder": 196,
    "position": 1,
    "text": "هم آنگه ز توران بیامد سپاه"
  },
  {
    "poem_id": 1499,
    "vorder": 197,
    "position": 0,
    "text": "چو نزدیک رود آمد افراسیاب"
  },
  {
    "poem_id": 1499,
    "vorder": 198,
    "position": 1,
    "text": "ندید ایچ مردم نه کشتی برآب"
  },
  {
    "poem_id": 1499,
    "vorder": 199,
    "position": 0,
    "text": "یکی بانگ زد تند بر باژخواه"
  },
  {
    "poem_id": 1499,
    "vorder": 200,
    "position": 1,
    "text": "که چون یافت این دیو بر آب راه"
  },
  {
    "poem_id": 1499,
    "vorder": 201,
    "position": 0,
    "text": "چنین داد پاسخ که‌ای شهریار"
  },
  {
    "poem_id": 1499,
    "vorder": 202,
    "position": 1,
    "text": "پدر باژبان بود و من باژدار"
  },
  {
    "poem_id": 1499,
    "vorder": 203,
    "position": 0,
    "text": "ندیدم نه هرگز شنیدم چنین"
  },
  {
    "poem_id": 1499,
    "vorder": 204,
    "position": 1,
    "text": "که کردی کسی ز آب جیحون زمین"
  },
  {
    "poem_id": 1499,
    "vorder": 205,
    "position": 0,
    "text": "بهاران و این آب با موج تیز"
  },
  {
    "poem_id": 1499,
    "vorder": 206,
    "position": 1,
    "text": "چو اندر شوی نیست راه گریز"
  },
  {
    "poem_id": 1499,
    "vorder": 207,
    "position": 0,
    "text": "چنان برگذشتند هر سه سوار"
  },
  {
    "poem_id": 1499,
    "vorder": 208,
    "position": 1,
    "text": "تو گفتی هوا داشت شان برکنار"
  },
  {
    "poem_id": 1499,
    "vorder": 209,
    "position": 0,
    "text": "ازان پس بفرمود افراسیاب"
  },
  {
    "poem_id": 1499,
    "vorder": 210,
    "position": 1,
    "text": "که بشتاب و کشتی برافگن به آب"
  },
  {
    "poem_id": 1499,
    "vorder": 211,
    "position": 0,
    "text": "بدو گفت هومان که ای شهریار"
  },
  {
    "poem_id": 1499,
    "vorder": 212,
    "position": 1,
    "text": "براندیش و آتش مکن در کنار"
  },
  {
    "poem_id": 1499,
    "vorder": 213,
    "position": 0,
    "text": "تو با این سواران به ایران شوی"
  },
  {
    "poem_id": 1499,
    "vorder": 214,
    "position": 1,
    "text": "همی در دم گاوشیدان شوی"
  },
  {
    "poem_id": 1499,
    "vorder": 215,
    "position": 0,
    "text": "چو گودرز و چون رستم پیلتن"
  },
  {
    "poem_id": 1499,
    "vorder": 216,
    "position": 1,
    "text": "چو طوس و چو گرگین و آن انجمن"
  },
  {
    "poem_id": 1499,
    "vorder": 217,
    "position": 0,
    "text": "همانا که از گاه سیر آمدی"
  },
  {
    "poem_id": 1499,
    "vorder": 218,
    "position": 1,
    "text": "که ایدر به چنگال شیر آمدی"
  },
  {
    "poem_id": 1499,
    "vorder": 219,
    "position": 0,
    "text": "ازین روی تا چین و ماچین تراست"
  },
  {
    "poem_id": 1499,
    "vorder": 220,
    "position": 1,
    "text": "خور و ماه و کیوان و پروین تراست"
  },
  {
    "poem_id": 1499,
    "vorder": 221,
    "position": 0,
    "text": "تو توران نگه‌دار و تخت بلند"
  },
  {
    "poem_id": 1499,
    "vorder": 222,
    "position": 1,
    "text": "ز ایران کنون نیست بیم گزند"
  },
  {
    "poem_id": 1499,
    "vorder": 223,
    "position": 0,
    "text": "پر از خون دل از رود گشتند باز"
  },
  {
    "poem_id": 1499,
    "vorder": 224,
    "position": 1,
    "text": "برآمد برین روزگار دراز"
  }
]