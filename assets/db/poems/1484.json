[
  {
    "poem_id": 1484,
    "vorder": 1,
    "position": 0,
    "text": "به مهر اندرون بود شاه جهان"
  },
  {
    "poem_id": 1484,
    "vorder": 2,
    "position": 1,
    "text": "که بشنید گفتار کارآگهان"
  },
  {
    "poem_id": 1484,
    "vorder": 3,
    "position": 0,
    "text": "که افراسیاب آمد و صدهزار"
  },
  {
    "poem_id": 1484,
    "vorder": 4,
    "position": 1,
    "text": "گزیده ز ترکان شمرده سوار"
  },
  {
    "poem_id": 1484,
    "vorder": 5,
    "position": 0,
    "text": "سوی شهر ایران نهادست روی"
  },
  {
    "poem_id": 1484,
    "vorder": 6,
    "position": 1,
    "text": "وزو گشت کشور پر از گفت و گوی"
  },
  {
    "poem_id": 1484,
    "vorder": 7,
    "position": 0,
    "text": "دل شاه کاووس ازان تنگ شد"
  },
  {
    "poem_id": 1484,
    "vorder": 8,
    "position": 1,
    "text": "که از بزم رایش سوی جنگ شد"
  },
  {
    "poem_id": 1484,
    "vorder": 9,
    "position": 0,
    "text": "یکی انجمن کرد از ایرانیان"
  },
  {
    "poem_id": 1484,
    "vorder": 10,
    "position": 1,
    "text": "کسی را که بد نیکخواه کیان"
  },
  {
    "poem_id": 1484,
    "vorder": 11,
    "position": 0,
    "text": "بدیشان چنین گفت کافراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 12,
    "position": 1,
    "text": "ز باد و ز آتش ز خاک و ز آب"
  },
  {
    "poem_id": 1484,
    "vorder": 13,
    "position": 0,
    "text": "همانا که ایزد نکردش سرشت"
  },
  {
    "poem_id": 1484,
    "vorder": 14,
    "position": 1,
    "text": "مگر خود سپهرش دگرگونه کشت"
  },
  {
    "poem_id": 1484,
    "vorder": 15,
    "position": 0,
    "text": "که چندین به سوگند پیمان کند"
  },
  {
    "poem_id": 1484,
    "vorder": 16,
    "position": 1,
    "text": "زبان را به خوبی گروگان کند"
  },
  {
    "poem_id": 1484,
    "vorder": 17,
    "position": 0,
    "text": "چو گردآورد مردم کینه جوی"
  },
  {
    "poem_id": 1484,
    "vorder": 18,
    "position": 1,
    "text": "بتابد ز پیمان و سوگند روی"
  },
  {
    "poem_id": 1484,
    "vorder": 19,
    "position": 0,
    "text": "جز از من نشاید ورا کینه خواه"
  },
  {
    "poem_id": 1484,
    "vorder": 20,
    "position": 1,
    "text": "کنم روز روشن بدو بر سیاه"
  },
  {
    "poem_id": 1484,
    "vorder": 21,
    "position": 0,
    "text": "مگر گم کنم نام او در جهان"
  },
  {
    "poem_id": 1484,
    "vorder": 22,
    "position": 1,
    "text": "وگر نه چو تیر از کمان ناگهان"
  },
  {
    "poem_id": 1484,
    "vorder": 23,
    "position": 0,
    "text": "سپه سازد و رزم ایران کند"
  },
  {
    "poem_id": 1484,
    "vorder": 24,
    "position": 1,
    "text": "بسی زین بر و بوم ویران کند"
  },
  {
    "poem_id": 1484,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت موبد چه باید سپاه"
  },
  {
    "poem_id": 1484,
    "vorder": 26,
    "position": 1,
    "text": "چو خود رفت باید به آوردگاه"
  },
  {
    "poem_id": 1484,
    "vorder": 27,
    "position": 0,
    "text": "چرا خواسته داد باید بباد"
  },
  {
    "poem_id": 1484,
    "vorder": 28,
    "position": 1,
    "text": "در گنج چندین چه باید گشاد"
  },
  {
    "poem_id": 1484,
    "vorder": 29,
    "position": 0,
    "text": "دو بار این سر نامور گاه خویش"
  },
  {
    "poem_id": 1484,
    "vorder": 30,
    "position": 1,
    "text": "سپردی به تیزی به بدخواه خویش"
  },
  {
    "poem_id": 1484,
    "vorder": 31,
    "position": 0,
    "text": "کنون پهلوانی نگه کن گزین"
  },
  {
    "poem_id": 1484,
    "vorder": 32,
    "position": 1,
    "text": "سزاوار جنگ و سزاوار کین"
  },
  {
    "poem_id": 1484,
    "vorder": 33,
    "position": 0,
    "text": "چنین داد پاسخ بدیشان که من"
  },
  {
    "poem_id": 1484,
    "vorder": 34,
    "position": 1,
    "text": "نبینم کسی را بدین انجمن"
  },
  {
    "poem_id": 1484,
    "vorder": 35,
    "position": 0,
    "text": "که دارد پی و تاب افراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 36,
    "position": 1,
    "text": "مرا رفت باید چو کشتی بر آب"
  },
  {
    "poem_id": 1484,
    "vorder": 37,
    "position": 0,
    "text": "شما بازگردید تا من کنون"
  },
  {
    "poem_id": 1484,
    "vorder": 38,
    "position": 1,
    "text": "بپیچم یکی دل برین رهنمون"
  },
  {
    "poem_id": 1484,
    "vorder": 39,
    "position": 0,
    "text": "سیاوش ازان دل پراندیشه کرد"
  },
  {
    "poem_id": 1484,
    "vorder": 40,
    "position": 1,
    "text": "روان را از اندیشه چون بیشه کرد"
  },
  {
    "poem_id": 1484,
    "vorder": 41,
    "position": 0,
    "text": "به دل گفت من سازم این رزمگاه"
  },
  {
    "poem_id": 1484,
    "vorder": 42,
    "position": 1,
    "text": "به خوبی بگویم بخواهم ز شاه"
  },
  {
    "poem_id": 1484,
    "vorder": 43,
    "position": 0,
    "text": "مگر کم رهایی دهد دادگر"
  },
  {
    "poem_id": 1484,
    "vorder": 44,
    "position": 1,
    "text": "ز سودابه و گفت و گوی پدر"
  },
  {
    "poem_id": 1484,
    "vorder": 45,
    "position": 0,
    "text": "دگر گر ازین کار نام آورم"
  },
  {
    "poem_id": 1484,
    "vorder": 46,
    "position": 1,
    "text": "چنین لشکری را به دام آورم"
  },
  {
    "poem_id": 1484,
    "vorder": 47,
    "position": 0,
    "text": "بشد با کمر پیش کاووس شاه"
  },
  {
    "poem_id": 1484,
    "vorder": 48,
    "position": 1,
    "text": "بدو گفت من دارم این پایگاه"
  },
  {
    "poem_id": 1484,
    "vorder": 49,
    "position": 0,
    "text": "که با شاه توران بجویم نبرد"
  },
  {
    "poem_id": 1484,
    "vorder": 50,
    "position": 1,
    "text": "سر سروران اندر آرم به گرد"
  },
  {
    "poem_id": 1484,
    "vorder": 51,
    "position": 0,
    "text": "چنین بود رای جهان آفرین"
  },
  {
    "poem_id": 1484,
    "vorder": 52,
    "position": 1,
    "text": "که او جان سپارد به توران زمین"
  },
  {
    "poem_id": 1484,
    "vorder": 53,
    "position": 0,
    "text": "به رای و به اندیشهٔ نابکار"
  },
  {
    "poem_id": 1484,
    "vorder": 54,
    "position": 1,
    "text": "کجا بازگردد بد روزگار"
  },
  {
    "poem_id": 1484,
    "vorder": 55,
    "position": 0,
    "text": "بدین کار همداستان شد پدر"
  },
  {
    "poem_id": 1484,
    "vorder": 56,
    "position": 1,
    "text": "که بندد برین کین سیاوش کمر"
  },
  {
    "poem_id": 1484,
    "vorder": 57,
    "position": 0,
    "text": "ازو شادمان گشت و بنواختش"
  },
  {
    "poem_id": 1484,
    "vorder": 58,
    "position": 1,
    "text": "به نوی یکی پایگه ساختش"
  },
  {
    "poem_id": 1484,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت گنج و گهر پیش تست"
  },
  {
    "poem_id": 1484,
    "vorder": 60,
    "position": 1,
    "text": "تو گویی سپه سر به سر خویش تست"
  },
  {
    "poem_id": 1484,
    "vorder": 61,
    "position": 0,
    "text": "ز گفتار و کردار و از آفرین"
  },
  {
    "poem_id": 1484,
    "vorder": 62,
    "position": 1,
    "text": "که خوانند بر تو به ایران زمین"
  },
  {
    "poem_id": 1484,
    "vorder": 63,
    "position": 0,
    "text": "گو پیلتن را بر خویش خواند"
  },
  {
    "poem_id": 1484,
    "vorder": 64,
    "position": 1,
    "text": "بسی داستانهای نیکو براند"
  },
  {
    "poem_id": 1484,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت همزور تو پیل نیست"
  },
  {
    "poem_id": 1484,
    "vorder": 66,
    "position": 1,
    "text": "چو گرد پی رخش تو نیل نیست"
  },
  {
    "poem_id": 1484,
    "vorder": 67,
    "position": 0,
    "text": "ز گیتی هنرمند و خامش توی"
  },
  {
    "poem_id": 1484,
    "vorder": 68,
    "position": 1,
    "text": "که پروردگار سیاوش توی"
  },
  {
    "poem_id": 1484,
    "vorder": 69,
    "position": 0,
    "text": "چو آهن ببندد به کان در گهر"
  },
  {
    "poem_id": 1484,
    "vorder": 70,
    "position": 1,
    "text": "گشاده شود چون تو بستی کمر"
  },
  {
    "poem_id": 1484,
    "vorder": 71,
    "position": 0,
    "text": "سیاوش بیامد کمر بر میان"
  },
  {
    "poem_id": 1484,
    "vorder": 72,
    "position": 1,
    "text": "سخن گفت با من چو شیر ژیان"
  },
  {
    "poem_id": 1484,
    "vorder": 73,
    "position": 0,
    "text": "همی خواهد او جنگ افراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 74,
    "position": 1,
    "text": "تو با او برو روی ازو برمتاب"
  },
  {
    "poem_id": 1484,
    "vorder": 75,
    "position": 0,
    "text": "چو بیدار باشی تو خواب آیدم"
  },
  {
    "poem_id": 1484,
    "vorder": 76,
    "position": 1,
    "text": "چو آرام یابی شتاب آیدم"
  },
  {
    "poem_id": 1484,
    "vorder": 77,
    "position": 0,
    "text": "جهان ایمن از تیر و شمشیر تست"
  },
  {
    "poem_id": 1484,
    "vorder": 78,
    "position": 1,
    "text": "سر ماه با چرخ در زیر تست"
  },
  {
    "poem_id": 1484,
    "vorder": 79,
    "position": 0,
    "text": "تهمتن بدو گفت من بنده‌ام"
  },
  {
    "poem_id": 1484,
    "vorder": 80,
    "position": 1,
    "text": "سخن هرچ گویی نیوشنده‌ام"
  },
  {
    "poem_id": 1484,
    "vorder": 81,
    "position": 0,
    "text": "سیاوش پناه و روان منست"
  },
  {
    "poem_id": 1484,
    "vorder": 82,
    "position": 1,
    "text": "سر تاج او آسمان منست"
  },
  {
    "poem_id": 1484,
    "vorder": 83,
    "position": 0,
    "text": "چو بشنید ازو آفرین کرد و گفت"
  },
  {
    "poem_id": 1484,
    "vorder": 84,
    "position": 1,
    "text": "که با جان پاکت خرد باد جفت"
  },
  {
    "poem_id": 1484,
    "vorder": 85,
    "position": 0,
    "text": "وزان پس خروشیدن نای و کوس"
  },
  {
    "poem_id": 1484,
    "vorder": 86,
    "position": 1,
    "text": "برآمد بیامد سپهدار طوس"
  },
  {
    "poem_id": 1484,
    "vorder": 87,
    "position": 0,
    "text": "به درگاه بر انجمن شد سپاه"
  },
  {
    "poem_id": 1484,
    "vorder": 88,
    "position": 1,
    "text": "در گنج دینار بگشاد شاه"
  },
  {
    "poem_id": 1484,
    "vorder": 89,
    "position": 0,
    "text": "ز شمشیر و گُرز و کلاه و کمر"
  },
  {
    "poem_id": 1484,
    "vorder": 90,
    "position": 1,
    "text": "همان خود و درع و سنان و سپر"
  },
  {
    "poem_id": 1484,
    "vorder": 91,
    "position": 0,
    "text": "به گنجی که بد جامهٔ نابرید"
  },
  {
    "poem_id": 1484,
    "vorder": 92,
    "position": 1,
    "text": "فرستاد نزد سیاوش کلید"
  },
  {
    "poem_id": 1484,
    "vorder": 93,
    "position": 0,
    "text": "که بر جان و بر خواسته کدخدای"
  },
  {
    "poem_id": 1484,
    "vorder": 94,
    "position": 1,
    "text": "توی ساز کن تا چه آیدت رای"
  },
  {
    "poem_id": 1484,
    "vorder": 95,
    "position": 0,
    "text": "گزین کرد ازان نامداران سوار"
  },
  {
    "poem_id": 1484,
    "vorder": 96,
    "position": 1,
    "text": "دلیران جنگی ده و دو هزار"
  },
  {
    "poem_id": 1484,
    "vorder": 97,
    "position": 0,
    "text": "هم از پهلو و پارس و کوچ و بلوچ"
  },
  {
    "poem_id": 1484,
    "vorder": 98,
    "position": 1,
    "text": "ز گیلان جنگی و دشت سروچ"
  },
  {
    "poem_id": 1484,
    "vorder": 99,
    "position": 0,
    "text": "سپرور پیاده ده و دو هزار"
  },
  {
    "poem_id": 1484,
    "vorder": 100,
    "position": 1,
    "text": "گزین کرد شاه از در کارزار"
  },
  {
    "poem_id": 1484,
    "vorder": 101,
    "position": 0,
    "text": "از ایران هرآنکس که گوزاده بود"
  },
  {
    "poem_id": 1484,
    "vorder": 102,
    "position": 1,
    "text": "دلیر و خردمند و آزاده بود"
  },
  {
    "poem_id": 1484,
    "vorder": 103,
    "position": 0,
    "text": "به بالا و سال سیاوش بدند"
  },
  {
    "poem_id": 1484,
    "vorder": 104,
    "position": 1,
    "text": "خردمند و بیدار و خامش بدند"
  },
  {
    "poem_id": 1484,
    "vorder": 105,
    "position": 0,
    "text": "ز گردان جنگی و نام‌آوران"
  },
  {
    "poem_id": 1484,
    "vorder": 106,
    "position": 1,
    "text": "چو بهرام و چون زنگهٔ شاوران"
  },
  {
    "poem_id": 1484,
    "vorder": 107,
    "position": 0,
    "text": "همان پنج موبد از ایرانیان"
  },
  {
    "poem_id": 1484,
    "vorder": 108,
    "position": 1,
    "text": "برافراختند اختر کاویان"
  },
  {
    "poem_id": 1484,
    "vorder": 109,
    "position": 0,
    "text": "بفرمود تا جمله بیرون شدند"
  },
  {
    "poem_id": 1484,
    "vorder": 110,
    "position": 1,
    "text": "ز پهلو سوی دشت و هامون شدند"
  },
  {
    "poem_id": 1484,
    "vorder": 111,
    "position": 0,
    "text": "تو گفتی که اندر زمین جای نیست"
  },
  {
    "poem_id": 1484,
    "vorder": 112,
    "position": 1,
    "text": "که بر خاک او نعل را پای نیست"
  },
  {
    "poem_id": 1484,
    "vorder": 113,
    "position": 0,
    "text": "سراندر سپهر اختر کاویان"
  },
  {
    "poem_id": 1484,
    "vorder": 114,
    "position": 1,
    "text": "چو ماه درخشنده اندر میان"
  },
  {
    "poem_id": 1484,
    "vorder": 115,
    "position": 0,
    "text": "ز پهلو برون رفت کاووس شاه"
  },
  {
    "poem_id": 1484,
    "vorder": 116,
    "position": 1,
    "text": "یکی تیز برگشت گرد سپاه"
  },
  {
    "poem_id": 1484,
    "vorder": 117,
    "position": 0,
    "text": "یکی آفرین کرد پرمایه کی"
  },
  {
    "poem_id": 1484,
    "vorder": 118,
    "position": 1,
    "text": "که ای نامداران فرخنده پی"
  },
  {
    "poem_id": 1484,
    "vorder": 119,
    "position": 0,
    "text": "مبادا جز از بخت همراهتان"
  },
  {
    "poem_id": 1484,
    "vorder": 120,
    "position": 1,
    "text": "شده تیره دیدار بدخواهتان"
  },
  {
    "poem_id": 1484,
    "vorder": 121,
    "position": 0,
    "text": "به نیک اختر و تندرستی شدن"
  },
  {
    "poem_id": 1484,
    "vorder": 122,
    "position": 1,
    "text": "به پیروزی و شاد باز آمدن"
  },
  {
    "poem_id": 1484,
    "vorder": 123,
    "position": 0,
    "text": "وزان جایگه کوس بر پیل بست"
  },
  {
    "poem_id": 1484,
    "vorder": 124,
    "position": 1,
    "text": "به گردان بفرمود و خود برنشست"
  },
  {
    "poem_id": 1484,
    "vorder": 125,
    "position": 0,
    "text": "دو دیده پر از آب کاووس شاه"
  },
  {
    "poem_id": 1484,
    "vorder": 126,
    "position": 1,
    "text": "همی بود یک روز با او به راه"
  },
  {
    "poem_id": 1484,
    "vorder": 127,
    "position": 0,
    "text": "سرانجام مر یکدگر را کنار"
  },
  {
    "poem_id": 1484,
    "vorder": 128,
    "position": 1,
    "text": "گرفتند هر دو چو ابر بهار"
  },
  {
    "poem_id": 1484,
    "vorder": 129,
    "position": 0,
    "text": "ز دیده همی خون فرو ریختند"
  },
  {
    "poem_id": 1484,
    "vorder": 130,
    "position": 1,
    "text": "به زاری خروشی برانگیختند"
  },
  {
    "poem_id": 1484,
    "vorder": 131,
    "position": 0,
    "text": "گواهی همی داد دل در شدن"
  },
  {
    "poem_id": 1484,
    "vorder": 132,
    "position": 1,
    "text": "که دیدار ازان پس نخواهد بدن"
  },
  {
    "poem_id": 1484,
    "vorder": 133,
    "position": 0,
    "text": "چنین است کردار گردنده دهر"
  },
  {
    "poem_id": 1484,
    "vorder": 134,
    "position": 1,
    "text": "گهی نوش بار آورد گاه زهر"
  },
  {
    "poem_id": 1484,
    "vorder": 135,
    "position": 0,
    "text": "سوی گاه بنهاد کاووس روی"
  },
  {
    "poem_id": 1484,
    "vorder": 136,
    "position": 1,
    "text": "سیاوش ابا لشکر جنگ‌جوی"
  },
  {
    "poem_id": 1484,
    "vorder": 137,
    "position": 0,
    "text": "سپه را سوی زابلستان کشید"
  },
  {
    "poem_id": 1484,
    "vorder": 138,
    "position": 1,
    "text": "ابا پیلتن سوی دستان کشید"
  },
  {
    "poem_id": 1484,
    "vorder": 139,
    "position": 0,
    "text": "همی بود یکچند با رود و می"
  },
  {
    "poem_id": 1484,
    "vorder": 140,
    "position": 1,
    "text": "به نزدیک دستان فرخنده پی"
  },
  {
    "poem_id": 1484,
    "vorder": 141,
    "position": 0,
    "text": "گهی با تهمتن بدی می بدست"
  },
  {
    "poem_id": 1484,
    "vorder": 142,
    "position": 1,
    "text": "گهی با زواره گزیدی نشست"
  },
  {
    "poem_id": 1484,
    "vorder": 143,
    "position": 0,
    "text": "گهی شاد بر تخت دستان بدی"
  },
  {
    "poem_id": 1484,
    "vorder": 144,
    "position": 1,
    "text": "گهی در شکار و شبستان بدی"
  },
  {
    "poem_id": 1484,
    "vorder": 145,
    "position": 0,
    "text": "چو یک ماه بگذشت لشکر براند"
  },
  {
    "poem_id": 1484,
    "vorder": 146,
    "position": 1,
    "text": "گوپیلتن رفت و دستان بماند"
  },
  {
    "poem_id": 1484,
    "vorder": 147,
    "position": 0,
    "text": "سپاهی برفتند با پهلوان"
  },
  {
    "poem_id": 1484,
    "vorder": 148,
    "position": 1,
    "text": "ز زابل هم از کابل و هندوان"
  },
  {
    "poem_id": 1484,
    "vorder": 149,
    "position": 0,
    "text": "ز هر سو که بد نامور لشکری"
  },
  {
    "poem_id": 1484,
    "vorder": 150,
    "position": 1,
    "text": "بخواند و بیامد به شهر هری"
  },
  {
    "poem_id": 1484,
    "vorder": 151,
    "position": 0,
    "text": "ازیشان فراوان پیاده ببرد"
  },
  {
    "poem_id": 1484,
    "vorder": 152,
    "position": 1,
    "text": "بنه زنگهٔ شاوران را سپرد"
  },
  {
    "poem_id": 1484,
    "vorder": 153,
    "position": 0,
    "text": "سوی طالقان آمد و مرورود"
  },
  {
    "poem_id": 1484,
    "vorder": 154,
    "position": 1,
    "text": "سپهرش همی داد گفتی درود"
  },
  {
    "poem_id": 1484,
    "vorder": 155,
    "position": 0,
    "text": "ازانپس بیامد به نزدیک بلخ"
  },
  {
    "poem_id": 1484,
    "vorder": 156,
    "position": 1,
    "text": "نیازرد کس را به گفتار تلخ"
  },
  {
    "poem_id": 1484,
    "vorder": 157,
    "position": 0,
    "text": "وزان روی گرسیوز و بارمان"
  },
  {
    "poem_id": 1484,
    "vorder": 158,
    "position": 1,
    "text": "کشیدند لشکر چو باد دمان"
  },
  {
    "poem_id": 1484,
    "vorder": 159,
    "position": 0,
    "text": "سپهرم بد و بارمان پیش رو"
  },
  {
    "poem_id": 1484,
    "vorder": 160,
    "position": 1,
    "text": "خبر شد بدیشان ز سالار نو"
  },
  {
    "poem_id": 1484,
    "vorder": 161,
    "position": 0,
    "text": "که آمد سپاهی و شاهی جوان"
  },
  {
    "poem_id": 1484,
    "vorder": 162,
    "position": 1,
    "text": "از ایران گو پیلتن پهلوان"
  },
  {
    "poem_id": 1484,
    "vorder": 163,
    "position": 0,
    "text": "هیونی به نزدیک افراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 164,
    "position": 1,
    "text": "برافگند برسان کشتی برآب"
  },
  {
    "poem_id": 1484,
    "vorder": 165,
    "position": 0,
    "text": "که آمد ز ایران سپاهی گران"
  },
  {
    "poem_id": 1484,
    "vorder": 166,
    "position": 1,
    "text": "سپهبد سیاووش و با او سران"
  },
  {
    "poem_id": 1484,
    "vorder": 167,
    "position": 0,
    "text": "سپه کش چو رستم گو پیلتن"
  },
  {
    "poem_id": 1484,
    "vorder": 168,
    "position": 1,
    "text": "به یک دست خنجر به دیگر کفن"
  },
  {
    "poem_id": 1484,
    "vorder": 169,
    "position": 0,
    "text": "تو لشکر بیاری و چندین مپای"
  },
  {
    "poem_id": 1484,
    "vorder": 170,
    "position": 1,
    "text": "که از باد کشتی بجنبد ز جای"
  },
  {
    "poem_id": 1484,
    "vorder": 171,
    "position": 0,
    "text": "برانگیخت برسان آتش هیون"
  },
  {
    "poem_id": 1484,
    "vorder": 172,
    "position": 1,
    "text": "کزین سان سخن راند با رهنمون"
  },
  {
    "poem_id": 1484,
    "vorder": 173,
    "position": 0,
    "text": "سیاووش زین سو به پاسخ نماند"
  },
  {
    "poem_id": 1484,
    "vorder": 174,
    "position": 1,
    "text": "سوی بلخ چون باد لشکر براند"
  },
  {
    "poem_id": 1484,
    "vorder": 175,
    "position": 0,
    "text": "چو تنگ اندر آمد ز ایران سپاه"
  },
  {
    "poem_id": 1484,
    "vorder": 176,
    "position": 1,
    "text": "نشایست کردن به پاسخ نگاه"
  },
  {
    "poem_id": 1484,
    "vorder": 177,
    "position": 0,
    "text": "نگه کرد گرسیوز جنگ‌جوی"
  },
  {
    "poem_id": 1484,
    "vorder": 178,
    "position": 1,
    "text": "جز از جنگ جستن ندید ایچ روی"
  },
  {
    "poem_id": 1484,
    "vorder": 179,
    "position": 0,
    "text": "چو ز ایران سپاه اندر آمد به تنگ"
  },
  {
    "poem_id": 1484,
    "vorder": 180,
    "position": 1,
    "text": "به دروازهٔ بلخ برخاست جنگ"
  },
  {
    "poem_id": 1484,
    "vorder": 181,
    "position": 0,
    "text": "دو جنگ گران کرده شد در سه روز"
  },
  {
    "poem_id": 1484,
    "vorder": 182,
    "position": 1,
    "text": "بیامد سیاووش لشکر فروز"
  },
  {
    "poem_id": 1484,
    "vorder": 183,
    "position": 0,
    "text": "پیاده فرستاد بر هر دری"
  },
  {
    "poem_id": 1484,
    "vorder": 184,
    "position": 1,
    "text": "به بلخ اندر آمد گران لشکری"
  },
  {
    "poem_id": 1484,
    "vorder": 185,
    "position": 0,
    "text": "گریزان سپهرم بدان روی آب"
  },
  {
    "poem_id": 1484,
    "vorder": 186,
    "position": 1,
    "text": "بشدبا سپه نزد افراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 187,
    "position": 0,
    "text": "سیاووش در بلخ شد با سپاه"
  },
  {
    "poem_id": 1484,
    "vorder": 188,
    "position": 1,
    "text": "یکی نامه فرمود نزدیک شاه"
  },
  {
    "poem_id": 1484,
    "vorder": 189,
    "position": 0,
    "text": "نوشتن به مشک و گلاب و عبیر"
  },
  {
    "poem_id": 1484,
    "vorder": 190,
    "position": 1,
    "text": "چنان‌چون سزاوار بُد بر حریر"
  },
  {
    "poem_id": 1484,
    "vorder": 191,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1484,
    "vorder": 192,
    "position": 1,
    "text": "کزو گشت پیروز و به روزگار"
  },
  {
    "poem_id": 1484,
    "vorder": 193,
    "position": 0,
    "text": "خداوند خورشید و گردنده ماه"
  },
  {
    "poem_id": 1484,
    "vorder": 194,
    "position": 1,
    "text": "فرازندهٔ تاج و تخت و کلاه"
  },
  {
    "poem_id": 1484,
    "vorder": 195,
    "position": 0,
    "text": "کسی را که خواهد برآرد بلند"
  },
  {
    "poem_id": 1484,
    "vorder": 196,
    "position": 1,
    "text": "یکی را کند سوگوار و نژند"
  },
  {
    "poem_id": 1484,
    "vorder": 197,
    "position": 0,
    "text": "چرا نه به فرمانش اندر نه چون"
  },
  {
    "poem_id": 1484,
    "vorder": 198,
    "position": 1,
    "text": "خرد کرد باید بدین رهنمون"
  },
  {
    "poem_id": 1484,
    "vorder": 199,
    "position": 0,
    "text": "ازان دادگر کاو جهان آفرید"
  },
  {
    "poem_id": 1484,
    "vorder": 200,
    "position": 1,
    "text": "ابا آشکارا نهان آفرید"
  },
  {
    "poem_id": 1484,
    "vorder": 201,
    "position": 0,
    "text": "همی آفرین باد بر شهریار"
  },
  {
    "poem_id": 1484,
    "vorder": 202,
    "position": 1,
    "text": "همه نیکوی باد فرجام کار"
  },
  {
    "poem_id": 1484,
    "vorder": 203,
    "position": 0,
    "text": "به بلخ آمدم شاد و پیروز بخت"
  },
  {
    "poem_id": 1484,
    "vorder": 204,
    "position": 1,
    "text": "به فر جهاندار باتاج و تخت"
  },
  {
    "poem_id": 1484,
    "vorder": 205,
    "position": 0,
    "text": "سه روز اندرین جنگ شد روزگار"
  },
  {
    "poem_id": 1484,
    "vorder": 206,
    "position": 1,
    "text": "چهارم ببخشود پروردگار"
  },
  {
    "poem_id": 1484,
    "vorder": 207,
    "position": 0,
    "text": "سپهرم به ترمذ شد و بارمان"
  },
  {
    "poem_id": 1484,
    "vorder": 208,
    "position": 1,
    "text": "به کردار ناوک بجست از کمان"
  },
  {
    "poem_id": 1484,
    "vorder": 209,
    "position": 0,
    "text": "کنون تا به جیحون سپاه منست"
  },
  {
    "poem_id": 1484,
    "vorder": 210,
    "position": 1,
    "text": "جهان زیر فر کلاه منست"
  },
  {
    "poem_id": 1484,
    "vorder": 211,
    "position": 0,
    "text": "به سغد است با لشکر افراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 212,
    "position": 1,
    "text": "سپاه و سپهبد بدان روی آب"
  },
  {
    "poem_id": 1484,
    "vorder": 213,
    "position": 0,
    "text": "گر ایدونک فرمان دهد شهریار"
  },
  {
    "poem_id": 1484,
    "vorder": 214,
    "position": 1,
    "text": "سپه بگذرانم کنم کارزار"
  },
  {
    "poem_id": 1484,
    "vorder": 215,
    "position": 0,
    "text": "چو نامه بر شاه ایران رسید"
  },
  {
    "poem_id": 1484,
    "vorder": 216,
    "position": 1,
    "text": "سر تاج و تختش به کیوان رسید"
  },
  {
    "poem_id": 1484,
    "vorder": 217,
    "position": 0,
    "text": "به یزدان پناهید و زو جست بخت"
  },
  {
    "poem_id": 1484,
    "vorder": 218,
    "position": 1,
    "text": "بدان تا ببار آید آن نو درخت"
  },
  {
    "poem_id": 1484,
    "vorder": 219,
    "position": 0,
    "text": "به شادی یکی نامه پاسخ نوشت"
  },
  {
    "poem_id": 1484,
    "vorder": 220,
    "position": 1,
    "text": "چو تازه بهاری در اردیبهشت"
  },
  {
    "poem_id": 1484,
    "vorder": 221,
    "position": 0,
    "text": "که از آفرینندهٔ هور و ماه"
  },
  {
    "poem_id": 1484,
    "vorder": 222,
    "position": 1,
    "text": "جهاندار و بخشندهٔ تاج و گاه"
  },
  {
    "poem_id": 1484,
    "vorder": 223,
    "position": 0,
    "text": "ترا جاودان شادمان باد دل"
  },
  {
    "poem_id": 1484,
    "vorder": 224,
    "position": 1,
    "text": "ز درد و بلا گشته آزاد دل"
  },
  {
    "poem_id": 1484,
    "vorder": 225,
    "position": 0,
    "text": "همیشه به پیروزی و فرهی"
  },
  {
    "poem_id": 1484,
    "vorder": 226,
    "position": 1,
    "text": "کلاه بزرگی و تاج مهی"
  },
  {
    "poem_id": 1484,
    "vorder": 227,
    "position": 0,
    "text": "سپه بردی و جنگ را خواستی"
  },
  {
    "poem_id": 1484,
    "vorder": 228,
    "position": 1,
    "text": "که بخت و هنر داری و راستی"
  },
  {
    "poem_id": 1484,
    "vorder": 229,
    "position": 0,
    "text": "همی از لبت شیر بوید هنوز"
  },
  {
    "poem_id": 1484,
    "vorder": 230,
    "position": 1,
    "text": "که زد بر کمان تو از جنگ توز"
  },
  {
    "poem_id": 1484,
    "vorder": 231,
    "position": 0,
    "text": "همیشه هنرمند بادا تنت"
  },
  {
    "poem_id": 1484,
    "vorder": 232,
    "position": 1,
    "text": "رسیده به کام دل روشنت"
  },
  {
    "poem_id": 1484,
    "vorder": 233,
    "position": 0,
    "text": "ازان پس که پیروز گشتی به جنگ"
  },
  {
    "poem_id": 1484,
    "vorder": 234,
    "position": 1,
    "text": "به کار اندرون کرد باید درنگ"
  },
  {
    "poem_id": 1484,
    "vorder": 235,
    "position": 0,
    "text": "نباید پراگنده کردن سپاه"
  },
  {
    "poem_id": 1484,
    "vorder": 236,
    "position": 1,
    "text": "بپیمای روز و برآرای گاه"
  },
  {
    "poem_id": 1484,
    "vorder": 237,
    "position": 0,
    "text": "که آن ترک بدپیشه و ریمنست"
  },
  {
    "poem_id": 1484,
    "vorder": 238,
    "position": 1,
    "text": "که هم بدنژادست و هم بدتنست"
  },
  {
    "poem_id": 1484,
    "vorder": 239,
    "position": 0,
    "text": "همان با کلاهست و با دستگاه"
  },
  {
    "poem_id": 1484,
    "vorder": 240,
    "position": 1,
    "text": "همی سر برآرد ز تابنده ماه"
  },
  {
    "poem_id": 1484,
    "vorder": 241,
    "position": 0,
    "text": "مکن هیچ بر جنگ جستن شتاب"
  },
  {
    "poem_id": 1484,
    "vorder": 242,
    "position": 1,
    "text": "به جنگ تو آید خود افراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 243,
    "position": 0,
    "text": "گر ایدونک زین روی جیحون کشد"
  },
  {
    "poem_id": 1484,
    "vorder": 244,
    "position": 1,
    "text": "همی دامن خویش در خون کشد"
  },
  {
    "poem_id": 1484,
    "vorder": 245,
    "position": 0,
    "text": "نهاد از بر نامه بر مهر خویش"
  },
  {
    "poem_id": 1484,
    "vorder": 246,
    "position": 1,
    "text": "همانگه فرستاده را خواند پیش"
  },
  {
    "poem_id": 1484,
    "vorder": 247,
    "position": 0,
    "text": "بدو داد و فرمود تا گشت باز"
  },
  {
    "poem_id": 1484,
    "vorder": 248,
    "position": 1,
    "text": "همی تاخت اندر نشیب و فراز"
  },
  {
    "poem_id": 1484,
    "vorder": 249,
    "position": 0,
    "text": "فرستاده نزد سیاوش رسید"
  },
  {
    "poem_id": 1484,
    "vorder": 250,
    "position": 1,
    "text": "چو آن نامهٔ شاه ایران بدید"
  },
  {
    "poem_id": 1484,
    "vorder": 251,
    "position": 0,
    "text": "زمین را ببوسید و دل شاد کرد"
  },
  {
    "poem_id": 1484,
    "vorder": 252,
    "position": 1,
    "text": "ز هر غم دل پاک آزاد کرد"
  },
  {
    "poem_id": 1484,
    "vorder": 253,
    "position": 0,
    "text": "ازان نامهٔ شاه چون گشت شاد"
  },
  {
    "poem_id": 1484,
    "vorder": 254,
    "position": 1,
    "text": "بخندید و نامه بسر بر نهاد"
  },
  {
    "poem_id": 1484,
    "vorder": 255,
    "position": 0,
    "text": "نگه داشت بیدار فرمان اوی"
  },
  {
    "poem_id": 1484,
    "vorder": 256,
    "position": 1,
    "text": "نپیچید دل را ز پیمان اوی"
  },
  {
    "poem_id": 1484,
    "vorder": 257,
    "position": 0,
    "text": "وزان سو چو گرسیوز شوخ مرد"
  },
  {
    "poem_id": 1484,
    "vorder": 258,
    "position": 1,
    "text": "بیامد بر شاه ترکان چو گرد"
  },
  {
    "poem_id": 1484,
    "vorder": 259,
    "position": 0,
    "text": "بگفت آن سخنهای ناپاک و تلخ"
  },
  {
    "poem_id": 1484,
    "vorder": 260,
    "position": 1,
    "text": "که آمد سپهبد سیاوش به بلخ"
  },
  {
    "poem_id": 1484,
    "vorder": 261,
    "position": 0,
    "text": "سپه کش چو رستم سپاهی گران"
  },
  {
    "poem_id": 1484,
    "vorder": 262,
    "position": 1,
    "text": "بسی نامداران و جنگ آوران"
  },
  {
    "poem_id": 1484,
    "vorder": 263,
    "position": 0,
    "text": "ز هر یک ز ما بود پنجاه بیش"
  },
  {
    "poem_id": 1484,
    "vorder": 264,
    "position": 1,
    "text": "سرافراز با گُرزهٔ گاومیش"
  },
  {
    "poem_id": 1484,
    "vorder": 265,
    "position": 0,
    "text": "پیاده به کردار آتش بدند"
  },
  {
    "poem_id": 1484,
    "vorder": 266,
    "position": 1,
    "text": "سپردار با تیر و ترکش بدند"
  },
  {
    "poem_id": 1484,
    "vorder": 267,
    "position": 0,
    "text": "نپرد به کردار ایشان عقاب"
  },
  {
    "poem_id": 1484,
    "vorder": 268,
    "position": 1,
    "text": "یکی را سر اندر نیاید بخواب"
  },
  {
    "poem_id": 1484,
    "vorder": 269,
    "position": 0,
    "text": "سه روز و سه شب بود هم زین نشان"
  },
  {
    "poem_id": 1484,
    "vorder": 270,
    "position": 1,
    "text": "غمی شد سر و اسپ گردنکشان"
  },
  {
    "poem_id": 1484,
    "vorder": 271,
    "position": 0,
    "text": "ازیشان کسی را که خواب آمدی"
  },
  {
    "poem_id": 1484,
    "vorder": 272,
    "position": 1,
    "text": "ز جنگش بدانگه شتاب آمدی"
  },
  {
    "poem_id": 1484,
    "vorder": 273,
    "position": 0,
    "text": "بخفتی و آسوده برخاستی"
  },
  {
    "poem_id": 1484,
    "vorder": 274,
    "position": 1,
    "text": "به نوی یکی جنگ آراستی"
  },
  {
    "poem_id": 1484,
    "vorder": 275,
    "position": 0,
    "text": "برآشفت چون آتش افراسیاب"
  },
  {
    "poem_id": 1484,
    "vorder": 276,
    "position": 1,
    "text": "که چندش چه گویی ز آرام و خواب"
  },
  {
    "poem_id": 1484,
    "vorder": 277,
    "position": 0,
    "text": "به گرسیوز اندر چنان بنگرید"
  },
  {
    "poem_id": 1484,
    "vorder": 278,
    "position": 1,
    "text": "که گفتی میانش بخواهد برید"
  },
  {
    "poem_id": 1484,
    "vorder": 279,
    "position": 0,
    "text": "یکی بانگ برزد براندش ز پیش"
  },
  {
    "poem_id": 1484,
    "vorder": 280,
    "position": 1,
    "text": "کجا خواست راندن برو خشم خویش"
  },
  {
    "poem_id": 1484,
    "vorder": 281,
    "position": 0,
    "text": "بفرمود کز نامداران هزار"
  },
  {
    "poem_id": 1484,
    "vorder": 282,
    "position": 1,
    "text": "بخوانید وز بزم سازید کار"
  },
  {
    "poem_id": 1484,
    "vorder": 283,
    "position": 0,
    "text": "سراسر همه دشت پرچین نهید"
  },
  {
    "poem_id": 1484,
    "vorder": 284,
    "position": 1,
    "text": "به سغد اندر آرایش چین نهید"
  },
  {
    "poem_id": 1484,
    "vorder": 285,
    "position": 0,
    "text": "بدین سان به شادی گذر کرد روز"
  },
  {
    "poem_id": 1484,
    "vorder": 286,
    "position": 1,
    "text": "چو از چشم شد دور گیتی فروز"
  },
  {
    "poem_id": 1484,
    "vorder": 287,
    "position": 0,
    "text": "به خواب و به آرامش آمد شتاب"
  },
  {
    "poem_id": 1484,
    "vorder": 288,
    "position": 1,
    "text": "بغلتید بر جامه افراسیاب"
  }
]