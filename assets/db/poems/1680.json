[
  {
    "poem_id": 1680,
    "vorder": 1,
    "position": 0,
    "text": "سکندر سپه را به بابل کشید"
  },
  {
    "poem_id": 1680,
    "vorder": 2,
    "position": 1,
    "text": "ز گرد سپه شد هوا ناپدید"
  },
  {
    "poem_id": 1680,
    "vorder": 3,
    "position": 0,
    "text": "همی راند یک ماه خود با سپاه"
  },
  {
    "poem_id": 1680,
    "vorder": 4,
    "position": 1,
    "text": "ندیدند زیشان کس آرامگاه"
  },
  {
    "poem_id": 1680,
    "vorder": 5,
    "position": 0,
    "text": "بدین‌گونه تا سوی کوهی رسید"
  },
  {
    "poem_id": 1680,
    "vorder": 6,
    "position": 1,
    "text": "ز دیدار دیده سرش ناپدید"
  },
  {
    "poem_id": 1680,
    "vorder": 7,
    "position": 0,
    "text": "به سر بر یکی ابر تاریک بود"
  },
  {
    "poem_id": 1680,
    "vorder": 8,
    "position": 1,
    "text": "به کیوان تو گفتی که نزدیک بود"
  },
  {
    "poem_id": 1680,
    "vorder": 9,
    "position": 0,
    "text": "به جایی بروبر ندیدند راه"
  },
  {
    "poem_id": 1680,
    "vorder": 10,
    "position": 1,
    "text": "فروماند از راه شاه و سپاه"
  },
  {
    "poem_id": 1680,
    "vorder": 11,
    "position": 0,
    "text": "گذشتند بر کوه خارا به رنج"
  },
  {
    "poem_id": 1680,
    "vorder": 12,
    "position": 1,
    "text": "وزو خیره شد مرد باریک سنج"
  },
  {
    "poem_id": 1680,
    "vorder": 13,
    "position": 0,
    "text": "ز رفتن چو گشتند یکسر ستوه"
  },
  {
    "poem_id": 1680,
    "vorder": 14,
    "position": 1,
    "text": "یکی ژرف دریا بد آن روی کوه"
  },
  {
    "poem_id": 1680,
    "vorder": 15,
    "position": 0,
    "text": "پدید آمد و شاد شد زان سپاه"
  },
  {
    "poem_id": 1680,
    "vorder": 16,
    "position": 1,
    "text": "که دریا و هامون بدیدند راه"
  },
  {
    "poem_id": 1680,
    "vorder": 17,
    "position": 0,
    "text": "سوی ژرف دریا همی راندند"
  },
  {
    "poem_id": 1680,
    "vorder": 18,
    "position": 1,
    "text": "جهان‌آفرین را همی خواندند"
  },
  {
    "poem_id": 1680,
    "vorder": 19,
    "position": 0,
    "text": "دد و دام بد هر سوی بی‌شمار"
  },
  {
    "poem_id": 1680,
    "vorder": 20,
    "position": 1,
    "text": "سپه را نبد خوردنی جز شکار"
  },
  {
    "poem_id": 1680,
    "vorder": 21,
    "position": 0,
    "text": "پدید آمد از دور مردی سترگ"
  },
  {
    "poem_id": 1680,
    "vorder": 22,
    "position": 1,
    "text": "پر از موی با گوشهای بزرگ"
  },
  {
    "poem_id": 1680,
    "vorder": 23,
    "position": 0,
    "text": "تنش زیر موی اندرون همچو نیل"
  },
  {
    "poem_id": 1680,
    "vorder": 24,
    "position": 1,
    "text": "دو گوشش به کردار دو گوش پیل"
  },
  {
    "poem_id": 1680,
    "vorder": 25,
    "position": 0,
    "text": "چو دیدند گردنکشان زان نشان"
  },
  {
    "poem_id": 1680,
    "vorder": 26,
    "position": 1,
    "text": "ببردند پیش سکندر کشان"
  },
  {
    "poem_id": 1680,
    "vorder": 27,
    "position": 0,
    "text": "سکندر نگه کرد زو خیره ماند"
  },
  {
    "poem_id": 1680,
    "vorder": 28,
    "position": 1,
    "text": "بروبر همی نام یزدان بخواند"
  },
  {
    "poem_id": 1680,
    "vorder": 29,
    "position": 0,
    "text": "چه مردی بدو گفت نام تو چیست"
  },
  {
    "poem_id": 1680,
    "vorder": 30,
    "position": 1,
    "text": "ز دریا چه یابی و کام تو چیست"
  },
  {
    "poem_id": 1680,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت شاها مرا باب و مام"
  },
  {
    "poem_id": 1680,
    "vorder": 32,
    "position": 1,
    "text": "همان گوش بستر نهادند نام"
  },
  {
    "poem_id": 1680,
    "vorder": 33,
    "position": 0,
    "text": "بپرسید کان چیست بمیان آب"
  },
  {
    "poem_id": 1680,
    "vorder": 34,
    "position": 1,
    "text": "کزان سوی می برزند آفتاب"
  },
  {
    "poem_id": 1680,
    "vorder": 35,
    "position": 0,
    "text": "ازان پس چنین گفت کای شهریار"
  },
  {
    "poem_id": 1680,
    "vorder": 36,
    "position": 1,
    "text": "همیشه بدی در جهان نامدار"
  },
  {
    "poem_id": 1680,
    "vorder": 37,
    "position": 0,
    "text": "یکی شارستانست این چون بهشت"
  },
  {
    "poem_id": 1680,
    "vorder": 38,
    "position": 1,
    "text": "که گویی نه از خاک دارد سرشت"
  },
  {
    "poem_id": 1680,
    "vorder": 39,
    "position": 0,
    "text": "نبینی بدواندر ایوان و خان"
  },
  {
    "poem_id": 1680,
    "vorder": 40,
    "position": 1,
    "text": "مگر پوشش از ماهی و استخوان"
  },
  {
    "poem_id": 1680,
    "vorder": 41,
    "position": 0,
    "text": "بر ایوانها چهر افراسیاب"
  },
  {
    "poem_id": 1680,
    "vorder": 42,
    "position": 1,
    "text": "نگاریده روشن‌تر از آفتاب"
  },
  {
    "poem_id": 1680,
    "vorder": 43,
    "position": 0,
    "text": "همان چهر کیخسرو جنگ‌جوی"
  },
  {
    "poem_id": 1680,
    "vorder": 44,
    "position": 1,
    "text": "بزرگی و مردی و فرهنگ اوی"
  },
  {
    "poem_id": 1680,
    "vorder": 45,
    "position": 0,
    "text": "بران استخوان بر نگاریده پاک"
  },
  {
    "poem_id": 1680,
    "vorder": 46,
    "position": 1,
    "text": "نبینی به شهر اندرون گرد و خاک"
  },
  {
    "poem_id": 1680,
    "vorder": 47,
    "position": 0,
    "text": "ز ماهی بود مردمان را خورش"
  },
  {
    "poem_id": 1680,
    "vorder": 48,
    "position": 1,
    "text": "ندارند چیزی جزین پرورش"
  },
  {
    "poem_id": 1680,
    "vorder": 49,
    "position": 0,
    "text": "چو فرمان دهد نامبردار شاه"
  },
  {
    "poem_id": 1680,
    "vorder": 50,
    "position": 1,
    "text": "روم من بران شارستان بی‌سپاه"
  },
  {
    "poem_id": 1680,
    "vorder": 51,
    "position": 0,
    "text": "سکندر بدان گوش ور گفت رو"
  },
  {
    "poem_id": 1680,
    "vorder": 52,
    "position": 1,
    "text": "بیاور کسی تا چه بینیم نو"
  },
  {
    "poem_id": 1680,
    "vorder": 53,
    "position": 0,
    "text": "بشد گوش بستر هم اندر زمان"
  },
  {
    "poem_id": 1680,
    "vorder": 54,
    "position": 1,
    "text": "ازان شارستان برد مردم دمان"
  },
  {
    "poem_id": 1680,
    "vorder": 55,
    "position": 0,
    "text": "گذشتند بر آب هفتاد مرد"
  },
  {
    "poem_id": 1680,
    "vorder": 56,
    "position": 1,
    "text": "خرد یافته مردم سالخورد"
  },
  {
    "poem_id": 1680,
    "vorder": 57,
    "position": 0,
    "text": "همه جامه‌هاشان ز خز و حریر"
  },
  {
    "poem_id": 1680,
    "vorder": 58,
    "position": 1,
    "text": "ازو چند برنا بد و چند پیر"
  },
  {
    "poem_id": 1680,
    "vorder": 59,
    "position": 0,
    "text": "ازو هرک پیری بد و نام داشت"
  },
  {
    "poem_id": 1680,
    "vorder": 60,
    "position": 1,
    "text": "پر از در زرین یکی جام داشت"
  },
  {
    "poem_id": 1680,
    "vorder": 61,
    "position": 0,
    "text": "کسی کو جوان بود تاجی به دست"
  },
  {
    "poem_id": 1680,
    "vorder": 62,
    "position": 1,
    "text": "بر قیصر آمد سرافگنده پست"
  },
  {
    "poem_id": 1680,
    "vorder": 63,
    "position": 0,
    "text": "برفتند و بردند پیشش نماز"
  },
  {
    "poem_id": 1680,
    "vorder": 64,
    "position": 1,
    "text": "بگفتند با او زمانی دراز"
  },
  {
    "poem_id": 1680,
    "vorder": 65,
    "position": 0,
    "text": "ببود آن شب و گاه بانگ خروس"
  },
  {
    "poem_id": 1680,
    "vorder": 66,
    "position": 1,
    "text": "ز درگاه برخاست آوای کوس"
  },
  {
    "poem_id": 1680,
    "vorder": 67,
    "position": 0,
    "text": "وزان جایگه سوی بابل کشید"
  },
  {
    "poem_id": 1680,
    "vorder": 68,
    "position": 1,
    "text": "زمین گشت از لشکرش ناپدید"
  }
]