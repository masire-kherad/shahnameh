[
  {
    "poem_id": 87972,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید بر زد ز گردون درفش"
  },
  {
    "poem_id": 87972,
    "vorder": 2,
    "position": 1,
    "text": "دم شب شد از خنجر او بنفش"
  },
  {
    "poem_id": 87972,
    "vorder": 3,
    "position": 0,
    "text": "غمی شد دل مرد پرخاشجوی"
  },
  {
    "poem_id": 87972,
    "vorder": 4,
    "position": 1,
    "text": "بدانست کو را بد آمد بروی"
  },
  {
    "poem_id": 87972,
    "vorder": 5,
    "position": 0,
    "text": "برآمد خروش خروس و چکاو"
  },
  {
    "poem_id": 87972,
    "vorder": 6,
    "position": 1,
    "text": "کبوده نیامد بنزد تژاو"
  },
  {
    "poem_id": 87972,
    "vorder": 7,
    "position": 0,
    "text": "سپاهی که بودند با او بخواند"
  },
  {
    "poem_id": 87972,
    "vorder": 8,
    "position": 1,
    "text": "وزان جایگه تیز لشکر براند"
  },
  {
    "poem_id": 87972,
    "vorder": 9,
    "position": 0,
    "text": "تژاو سپهبد بشد با سپاه"
  },
  {
    "poem_id": 87972,
    "vorder": 10,
    "position": 1,
    "text": "بایران خروش آمد از دیده‌گاه"
  },
  {
    "poem_id": 87972,
    "vorder": 11,
    "position": 0,
    "text": "که آمد سپاهی ز ترکان بجنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 12,
    "position": 1,
    "text": "سپهبد نهنگی درفشی پلنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 13,
    "position": 0,
    "text": "ز گردنکشان پیش او رفت گیو"
  },
  {
    "poem_id": 87972,
    "vorder": 14,
    "position": 1,
    "text": "تنی چند با او ز گردان نیو"
  },
  {
    "poem_id": 87972,
    "vorder": 15,
    "position": 0,
    "text": "برآشفت و نامش بپرسید زوی"
  },
  {
    "poem_id": 87972,
    "vorder": 16,
    "position": 1,
    "text": "چنین گفت کای مرد پرخاشجوی"
  },
  {
    "poem_id": 87972,
    "vorder": 17,
    "position": 0,
    "text": "بدین مایه مردم بجنگ آمدی"
  },
  {
    "poem_id": 87972,
    "vorder": 18,
    "position": 1,
    "text": "ز هامون بکام نهنگ آمدی"
  },
  {
    "poem_id": 87972,
    "vorder": 19,
    "position": 0,
    "text": "بپاسخ چنین گفت کای نامدار"
  },
  {
    "poem_id": 87972,
    "vorder": 20,
    "position": 1,
    "text": "ببینی کنون رزم شیر سوار"
  },
  {
    "poem_id": 87972,
    "vorder": 21,
    "position": 0,
    "text": "بگیتی تژاوست نام مرا"
  },
  {
    "poem_id": 87972,
    "vorder": 22,
    "position": 1,
    "text": "بهر دم برآرند کام مرا"
  },
  {
    "poem_id": 87972,
    "vorder": 23,
    "position": 0,
    "text": "نژادم بگوهر از ایران بدست"
  },
  {
    "poem_id": 87972,
    "vorder": 24,
    "position": 1,
    "text": "ز گردان وز پشت شیران بدست"
  },
  {
    "poem_id": 87972,
    "vorder": 25,
    "position": 0,
    "text": "کنون مرزبانم بدین تخت و گاه"
  },
  {
    "poem_id": 87972,
    "vorder": 26,
    "position": 1,
    "text": "نگین بزرگان و داماد شاه"
  },
  {
    "poem_id": 87972,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت گیو اینکه گفتی مگوی"
  },
  {
    "poem_id": 87972,
    "vorder": 28,
    "position": 1,
    "text": "که تیره شود زین سخن آبروی"
  },
  {
    "poem_id": 87972,
    "vorder": 29,
    "position": 0,
    "text": "از ایران بتوران که دارد نشست"
  },
  {
    "poem_id": 87972,
    "vorder": 30,
    "position": 1,
    "text": "مگر خوردنش خون بود گر کبست"
  },
  {
    "poem_id": 87972,
    "vorder": 31,
    "position": 0,
    "text": "اگر مرزبانی و داماد شاه"
  },
  {
    "poem_id": 87972,
    "vorder": 32,
    "position": 1,
    "text": "چرا بیشتر زین نداری سپاه"
  },
  {
    "poem_id": 87972,
    "vorder": 33,
    "position": 0,
    "text": "بدین مایه لشکر تو تندی مجوی"
  },
  {
    "poem_id": 87972,
    "vorder": 34,
    "position": 1,
    "text": "بتندی بپیش دلیران مپوی"
  },
  {
    "poem_id": 87972,
    "vorder": 35,
    "position": 0,
    "text": "که این پرهنر نامدار دلیر"
  },
  {
    "poem_id": 87972,
    "vorder": 36,
    "position": 1,
    "text": "سر مرزبان اندر آرد بزیر"
  },
  {
    "poem_id": 87972,
    "vorder": 37,
    "position": 0,
    "text": "گر اایدونک فرمان کنی با سپاه"
  },
  {
    "poem_id": 87972,
    "vorder": 38,
    "position": 1,
    "text": "بایران خرامی بنزدیک شاه"
  },
  {
    "poem_id": 87972,
    "vorder": 39,
    "position": 0,
    "text": "کنون پیش طوس سپهبد شوی"
  },
  {
    "poem_id": 87972,
    "vorder": 40,
    "position": 1,
    "text": "بگویی و گفتار او بشنوی"
  },
  {
    "poem_id": 87972,
    "vorder": 41,
    "position": 0,
    "text": "ستانمت زو خلعت و خواسته"
  },
  {
    "poem_id": 87972,
    "vorder": 42,
    "position": 1,
    "text": "پرستنده و اسپ آراسته"
  },
  {
    "poem_id": 87972,
    "vorder": 43,
    "position": 0,
    "text": "تژاو فریبنده گفت ای دلیر"
  },
  {
    "poem_id": 87972,
    "vorder": 44,
    "position": 1,
    "text": "درفش مرا کس نیارد بزیر"
  },
  {
    "poem_id": 87972,
    "vorder": 45,
    "position": 0,
    "text": "مرا ایدر اکنون نگینست و گاه"
  },
  {
    "poem_id": 87972,
    "vorder": 46,
    "position": 1,
    "text": "پرستنده و گنج و تاج و سپاه"
  },
  {
    "poem_id": 87972,
    "vorder": 47,
    "position": 0,
    "text": "همان مرز و شاهی چو افراسیاب"
  },
  {
    "poem_id": 87972,
    "vorder": 48,
    "position": 1,
    "text": "کس این را ز ایران نبیند بخواب"
  },
  {
    "poem_id": 87972,
    "vorder": 49,
    "position": 0,
    "text": "پرستار وز مادیانان گله"
  },
  {
    "poem_id": 87972,
    "vorder": 50,
    "position": 1,
    "text": "بدشت گروگرد کرده یله"
  },
  {
    "poem_id": 87972,
    "vorder": 51,
    "position": 0,
    "text": "تو این اندکی لشکر من مبین"
  },
  {
    "poem_id": 87972,
    "vorder": 52,
    "position": 1,
    "text": "مراجوی با گرز بر پشت زین"
  },
  {
    "poem_id": 87972,
    "vorder": 53,
    "position": 0,
    "text": "من امروز با این سپاه آن کنم"
  },
  {
    "poem_id": 87972,
    "vorder": 54,
    "position": 1,
    "text": "کزین آمدن تان پشیمان کنم"
  },
  {
    "poem_id": 87972,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت بیژن بفرخ پدر"
  },
  {
    "poem_id": 87972,
    "vorder": 56,
    "position": 1,
    "text": "که ای نامور گرد پرخاشخر"
  },
  {
    "poem_id": 87972,
    "vorder": 57,
    "position": 0,
    "text": "سرافراز و بیداردل پهلوان"
  },
  {
    "poem_id": 87972,
    "vorder": 58,
    "position": 1,
    "text": "به پیری نه آنی که بودی جوان"
  },
  {
    "poem_id": 87972,
    "vorder": 59,
    "position": 0,
    "text": "ترا با تژاو این همه پند چیست"
  },
  {
    "poem_id": 87972,
    "vorder": 60,
    "position": 1,
    "text": "بترکی چنین مهر و پیوند چیست"
  },
  {
    "poem_id": 87972,
    "vorder": 61,
    "position": 0,
    "text": "همی گرز و خنجر بباید کشید"
  },
  {
    "poem_id": 87972,
    "vorder": 62,
    "position": 1,
    "text": "دل و مغز ایشان بباید درید"
  },
  {
    "poem_id": 87972,
    "vorder": 63,
    "position": 0,
    "text": "برانگیخت اسپ و برآمد خروش"
  },
  {
    "poem_id": 87972,
    "vorder": 64,
    "position": 1,
    "text": "نهادند گوپال و خنجر بدوش"
  },
  {
    "poem_id": 87972,
    "vorder": 65,
    "position": 0,
    "text": "یکی تیره گرد از میان بردمید"
  },
  {
    "poem_id": 87972,
    "vorder": 66,
    "position": 1,
    "text": "بدان سان که خورشید شد ناپدید"
  },
  {
    "poem_id": 87972,
    "vorder": 67,
    "position": 0,
    "text": "جهان شد چو آبار بهمن سیاه"
  },
  {
    "poem_id": 87972,
    "vorder": 68,
    "position": 1,
    "text": "ستاره ندیدند روشن نه ماه"
  },
  {
    "poem_id": 87972,
    "vorder": 69,
    "position": 0,
    "text": "بقلب سپاه اندرون گیو گرد"
  },
  {
    "poem_id": 87972,
    "vorder": 70,
    "position": 1,
    "text": "همی از جهان روشنایی ببرد"
  },
  {
    "poem_id": 87972,
    "vorder": 71,
    "position": 0,
    "text": "بپیش اندرون بیژن تیزچنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 72,
    "position": 1,
    "text": "همی بزمگاه آمدش جای جنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 73,
    "position": 0,
    "text": "وزان سوی با تاج بر سر تژاو"
  },
  {
    "poem_id": 87972,
    "vorder": 74,
    "position": 1,
    "text": "که بودیش با شیر درنده تاو"
  },
  {
    "poem_id": 87972,
    "vorder": 75,
    "position": 0,
    "text": "یلانش همه نیک‌مردان و شیر"
  },
  {
    "poem_id": 87972,
    "vorder": 76,
    "position": 1,
    "text": "که هرگز نشدشان دل از رزم سیر"
  },
  {
    "poem_id": 87972,
    "vorder": 77,
    "position": 0,
    "text": "بسی برنیامد برین روزگار"
  },
  {
    "poem_id": 87972,
    "vorder": 78,
    "position": 1,
    "text": "که آن ترک سیر آمد از کارزار"
  },
  {
    "poem_id": 87972,
    "vorder": 79,
    "position": 0,
    "text": "سه بهره ز توران سپه کشته شد"
  },
  {
    "poem_id": 87972,
    "vorder": 80,
    "position": 1,
    "text": "سربخت آن ترک برگشته شد"
  },
  {
    "poem_id": 87972,
    "vorder": 81,
    "position": 0,
    "text": "همی شد گریزان تژاو دلیر"
  },
  {
    "poem_id": 87972,
    "vorder": 82,
    "position": 1,
    "text": "پسش بیژن گیو برسان شیر"
  },
  {
    "poem_id": 87972,
    "vorder": 83,
    "position": 0,
    "text": "خروشان و جوشان و نیزه بدست"
  },
  {
    "poem_id": 87972,
    "vorder": 84,
    "position": 1,
    "text": "تو گفتی که غرنده شیرست مست"
  },
  {
    "poem_id": 87972,
    "vorder": 85,
    "position": 0,
    "text": "یکی نیزه زد بر میان تژاو"
  },
  {
    "poem_id": 87972,
    "vorder": 86,
    "position": 1,
    "text": "نماند آن زمان با تژاو ایچ تاو"
  },
  {
    "poem_id": 87972,
    "vorder": 87,
    "position": 0,
    "text": "گراینده بدبند رومی زره"
  },
  {
    "poem_id": 87972,
    "vorder": 88,
    "position": 1,
    "text": "بپیچید و بگشاد بند گره"
  },
  {
    "poem_id": 87972,
    "vorder": 89,
    "position": 0,
    "text": "بیفگند نیزه بیازید چنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 90,
    "position": 1,
    "text": "چو بر کوه بر غرم تازد پلنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 91,
    "position": 0,
    "text": "بدان سان که شاهین رباید چکاو"
  },
  {
    "poem_id": 87972,
    "vorder": 92,
    "position": 1,
    "text": "ربود آن گرانمایه تاج تژاو"
  },
  {
    "poem_id": 87972,
    "vorder": 93,
    "position": 0,
    "text": "که افراسیابش بسر برنهاد"
  },
  {
    "poem_id": 87972,
    "vorder": 94,
    "position": 1,
    "text": "نبودی جدا زو بخواب و بیاد"
  },
  {
    "poem_id": 87972,
    "vorder": 95,
    "position": 0,
    "text": "چنین تا در دژ همی تاخت اسپ"
  },
  {
    "poem_id": 87972,
    "vorder": 96,
    "position": 1,
    "text": "پس‌اندرش بیژن چو آذرگشسپ"
  },
  {
    "poem_id": 87972,
    "vorder": 97,
    "position": 0,
    "text": "چو نزدیکی دژ رسید اسپنوی"
  },
  {
    "poem_id": 87972,
    "vorder": 98,
    "position": 1,
    "text": "بیامد خروشان پر از آب روی"
  },
  {
    "poem_id": 87972,
    "vorder": 99,
    "position": 0,
    "text": "که از کین چنین پشت برگاشتی"
  },
  {
    "poem_id": 87972,
    "vorder": 100,
    "position": 1,
    "text": "بدین دژ مرا خوار بگذاشتی"
  },
  {
    "poem_id": 87972,
    "vorder": 101,
    "position": 0,
    "text": "سزد گر ز پس برنشانی مرا"
  },
  {
    "poem_id": 87972,
    "vorder": 102,
    "position": 1,
    "text": "بدین ره بدشمن نمانی مرا"
  },
  {
    "poem_id": 87972,
    "vorder": 103,
    "position": 0,
    "text": "تژاو سرافراز را دل بسوخت"
  },
  {
    "poem_id": 87972,
    "vorder": 104,
    "position": 1,
    "text": "بکردار آتش رخش برفروخت"
  },
  {
    "poem_id": 87972,
    "vorder": 105,
    "position": 0,
    "text": "فراز اسپنوی و تژاو از نشیب"
  },
  {
    "poem_id": 87972,
    "vorder": 106,
    "position": 1,
    "text": "بدو داد در تاختن یک رکیب"
  },
  {
    "poem_id": 87972,
    "vorder": 107,
    "position": 0,
    "text": "پس اندر نشاندش چو ماه دمان"
  },
  {
    "poem_id": 87972,
    "vorder": 108,
    "position": 1,
    "text": "برآمد ز جا باره زیرش دنان"
  },
  {
    "poem_id": 87972,
    "vorder": 109,
    "position": 0,
    "text": "همی تاخت چون گرد با اسپنوی"
  },
  {
    "poem_id": 87972,
    "vorder": 110,
    "position": 1,
    "text": "سوی راه توران نهادند روی"
  },
  {
    "poem_id": 87972,
    "vorder": 111,
    "position": 0,
    "text": "زمانی دوید اسپ جنگی تژاو"
  },
  {
    "poem_id": 87972,
    "vorder": 112,
    "position": 1,
    "text": "نماند ایچ با اسپ و با مرد تاو"
  },
  {
    "poem_id": 87972,
    "vorder": 113,
    "position": 0,
    "text": "تژاو آن زمان با پرستنده گفت"
  },
  {
    "poem_id": 87972,
    "vorder": 114,
    "position": 1,
    "text": "که دشوار کار آمد ای خوب جفت"
  },
  {
    "poem_id": 87972,
    "vorder": 115,
    "position": 0,
    "text": "فروماند این اسپ جنگی ز کار"
  },
  {
    "poem_id": 87972,
    "vorder": 116,
    "position": 1,
    "text": "ز پس بدسگال آمد و پیش غار"
  },
  {
    "poem_id": 87972,
    "vorder": 117,
    "position": 0,
    "text": "اگر دور از ایدر به بیژن رسم"
  },
  {
    "poem_id": 87972,
    "vorder": 118,
    "position": 1,
    "text": "بکام بداندیش دشمن رسم"
  },
  {
    "poem_id": 87972,
    "vorder": 119,
    "position": 0,
    "text": "ترا نیست دشمن بیکبارگی"
  },
  {
    "poem_id": 87972,
    "vorder": 120,
    "position": 1,
    "text": "بمان تا برانم من این بارگی"
  },
  {
    "poem_id": 87972,
    "vorder": 121,
    "position": 0,
    "text": "فرود آمد از اسپ او اسپنوی"
  },
  {
    "poem_id": 87972,
    "vorder": 122,
    "position": 1,
    "text": "تژاو از غم او پر از آب روی"
  },
  {
    "poem_id": 87972,
    "vorder": 123,
    "position": 0,
    "text": "سبکبار شد اسپ و تندی گرفت"
  },
  {
    "poem_id": 87972,
    "vorder": 124,
    "position": 1,
    "text": "پسش بیژن گیو کندی گرفت"
  },
  {
    "poem_id": 87972,
    "vorder": 125,
    "position": 0,
    "text": "چو دید آن رخ ماه‌روی اسپنوی"
  },
  {
    "poem_id": 87972,
    "vorder": 126,
    "position": 1,
    "text": "ز گلبرگ روی و پر از مشک موی"
  },
  {
    "poem_id": 87972,
    "vorder": 127,
    "position": 0,
    "text": "پس پشت خویش اندرش جای کرد"
  },
  {
    "poem_id": 87972,
    "vorder": 128,
    "position": 1,
    "text": "سوی لشکر پهلوان رای کرد"
  },
  {
    "poem_id": 87972,
    "vorder": 129,
    "position": 0,
    "text": "بشادی بیامد بدرگاه طوس"
  },
  {
    "poem_id": 87972,
    "vorder": 130,
    "position": 1,
    "text": "ز درگاه برخاست آوای کوس"
  },
  {
    "poem_id": 87972,
    "vorder": 131,
    "position": 0,
    "text": "که بیدار دل شیر جنگی سوار"
  },
  {
    "poem_id": 87972,
    "vorder": 132,
    "position": 1,
    "text": "دمان با شکار آمد از مرغزار"
  },
  {
    "poem_id": 87972,
    "vorder": 133,
    "position": 0,
    "text": "سپهدار و گردان پرخاشجوی"
  },
  {
    "poem_id": 87972,
    "vorder": 134,
    "position": 1,
    "text": "بویرانی دژ نهادند روی"
  },
  {
    "poem_id": 87972,
    "vorder": 135,
    "position": 0,
    "text": "ازان پس برفتند سوی گله"
  },
  {
    "poem_id": 87972,
    "vorder": 136,
    "position": 1,
    "text": "که بودند بر دشت ترکان یله"
  },
  {
    "poem_id": 87972,
    "vorder": 137,
    "position": 0,
    "text": "گرفتند هر یک کمندی بچنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 138,
    "position": 1,
    "text": "چنانچون بود ساز مردان جنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 139,
    "position": 0,
    "text": "بخم اندر آمد سر بارگی"
  },
  {
    "poem_id": 87972,
    "vorder": 140,
    "position": 1,
    "text": "بیاراست لشکر بیکبارگی"
  },
  {
    "poem_id": 87972,
    "vorder": 141,
    "position": 0,
    "text": "نشستند بر جایگاه تژاو"
  },
  {
    "poem_id": 87972,
    "vorder": 142,
    "position": 1,
    "text": "سواران ایران پر از خشم و تاو"
  },
  {
    "poem_id": 87972,
    "vorder": 143,
    "position": 0,
    "text": "تژاو غمی با دو دیده پرآب"
  },
  {
    "poem_id": 87972,
    "vorder": 144,
    "position": 1,
    "text": "بیامد بنزدیک افراسیاب"
  },
  {
    "poem_id": 87972,
    "vorder": 145,
    "position": 0,
    "text": "چنین گفت کامد سپهدار طوس"
  },
  {
    "poem_id": 87972,
    "vorder": 146,
    "position": 1,
    "text": "ابا لشکری گشن و پیلان کوس"
  },
  {
    "poem_id": 87972,
    "vorder": 147,
    "position": 0,
    "text": "پلاشان و آن نامداران مرد"
  },
  {
    "poem_id": 87972,
    "vorder": 148,
    "position": 1,
    "text": "بخاک اندر آمد سرانشان ز گرد"
  },
  {
    "poem_id": 87972,
    "vorder": 149,
    "position": 0,
    "text": "همه مرز و بوم آتش اندر زدند"
  },
  {
    "poem_id": 87972,
    "vorder": 150,
    "position": 1,
    "text": "فسیله سراسر بهم برزدند"
  },
  {
    "poem_id": 87972,
    "vorder": 151,
    "position": 0,
    "text": "چو بشنید افراسیاب این سخن"
  },
  {
    "poem_id": 87972,
    "vorder": 152,
    "position": 1,
    "text": "غمی گشت و بر چاره افگند بن"
  },
  {
    "poem_id": 87972,
    "vorder": 153,
    "position": 0,
    "text": "بپیران ویسه چنین گفت شاه"
  },
  {
    "poem_id": 87972,
    "vorder": 154,
    "position": 1,
    "text": "که گفتم بیاور ز هر سو سپاه"
  },
  {
    "poem_id": 87972,
    "vorder": 155,
    "position": 0,
    "text": "درنگ آمدت رای از کاهلی"
  },
  {
    "poem_id": 87972,
    "vorder": 156,
    "position": 1,
    "text": "ز پیری گران گشته و بددلی"
  },
  {
    "poem_id": 87972,
    "vorder": 157,
    "position": 0,
    "text": "نه دژ ماند اکنون نه اسپ و نه مرد"
  },
  {
    "poem_id": 87972,
    "vorder": 158,
    "position": 1,
    "text": "نشستن نشاید بدین مرز کرد"
  },
  {
    "poem_id": 87972,
    "vorder": 159,
    "position": 0,
    "text": "بسی خویش و پیوند ما برده گشت"
  },
  {
    "poem_id": 87972,
    "vorder": 160,
    "position": 1,
    "text": "بسی مرد نیک‌اختر آزرده گشت"
  },
  {
    "poem_id": 87972,
    "vorder": 161,
    "position": 0,
    "text": "کنون نیست امروز روز درنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 162,
    "position": 1,
    "text": "جهان گشت بر مرد بیدار تنگ"
  },
  {
    "poem_id": 87972,
    "vorder": 163,
    "position": 0,
    "text": "جهاندار پیران هم اندر شتاب"
  },
  {
    "poem_id": 87972,
    "vorder": 164,
    "position": 1,
    "text": "برون آمد از پیش افراسیاب"
  },
  {
    "poem_id": 87972,
    "vorder": 165,
    "position": 0,
    "text": "ز هر مرز مردان جنگی بخواند"
  },
  {
    "poem_id": 87972,
    "vorder": 166,
    "position": 1,
    "text": "سلیح و درم داد و لشکر براند"
  },
  {
    "poem_id": 87972,
    "vorder": 167,
    "position": 0,
    "text": "چو آمد ز پهلو برون پهلوان"
  },
  {
    "poem_id": 87972,
    "vorder": 168,
    "position": 1,
    "text": "همی نامزد کرد جای گوان"
  },
  {
    "poem_id": 87972,
    "vorder": 169,
    "position": 0,
    "text": "سوی میمنه بارمان و تژاو"
  },
  {
    "poem_id": 87972,
    "vorder": 170,
    "position": 1,
    "text": "سواران که دارند با شیر تاو"
  },
  {
    "poem_id": 87972,
    "vorder": 171,
    "position": 0,
    "text": "چو نستهین گرد بر میسره"
  },
  {
    "poem_id": 87972,
    "vorder": 172,
    "position": 1,
    "text": "کجا شیر بودی بچنگش بره"
  },
  {
    "poem_id": 87972,
    "vorder": 173,
    "position": 0,
    "text": "جهان پر شد از نالهٔ کرنای"
  },
  {
    "poem_id": 87972,
    "vorder": 174,
    "position": 1,
    "text": "ز غریدن کوس و هندی درای"
  },
  {
    "poem_id": 87972,
    "vorder": 175,
    "position": 0,
    "text": "هوا سربسر سرخ و زرد و بنفش"
  },
  {
    "poem_id": 87972,
    "vorder": 176,
    "position": 1,
    "text": "ز بس نیزه و گونه‌گونه درفش"
  },
  {
    "poem_id": 87972,
    "vorder": 177,
    "position": 0,
    "text": "سپاهی ز جنگ‌آوران صدهزار"
  },
  {
    "poem_id": 87972,
    "vorder": 178,
    "position": 1,
    "text": "نهاده همه سر سوی کارزار"
  },
  {
    "poem_id": 87972,
    "vorder": 179,
    "position": 0,
    "text": "ز دریا بدریا نبود ایچ راه"
  },
  {
    "poem_id": 87972,
    "vorder": 180,
    "position": 1,
    "text": "ز اسپ و ز پیل و هیون و سپاه"
  },
  {
    "poem_id": 87972,
    "vorder": 181,
    "position": 0,
    "text": "همی رفت لشکر گروها گروه"
  },
  {
    "poem_id": 87972,
    "vorder": 182,
    "position": 1,
    "text": "نبد دشت پیدا نه دریا نه کوه"
  },
  {
    "poem_id": 87972,
    "vorder": 183,
    "position": 0,
    "text": "بفرمود پیران که بیره روید"
  },
  {
    "poem_id": 87972,
    "vorder": 184,
    "position": 1,
    "text": "از ایدر سوی راه کوته روید"
  },
  {
    "poem_id": 87972,
    "vorder": 185,
    "position": 0,
    "text": "نباید که یابند خود آگهی"
  },
  {
    "poem_id": 87972,
    "vorder": 186,
    "position": 1,
    "text": "ازین نامداران با فرهی"
  },
  {
    "poem_id": 87972,
    "vorder": 187,
    "position": 0,
    "text": "مگر ناگهان بر سر آن گروه"
  },
  {
    "poem_id": 87972,
    "vorder": 188,
    "position": 1,
    "text": "فرود آرم این گشن لشکر چو کوه"
  },
  {
    "poem_id": 87972,
    "vorder": 189,
    "position": 0,
    "text": "برون کرد کارآگهان ناگهان"
  },
  {
    "poem_id": 87972,
    "vorder": 190,
    "position": 1,
    "text": "همی جست بیدار کار جهان"
  },
  {
    "poem_id": 87972,
    "vorder": 191,
    "position": 0,
    "text": "بتندی براه اندر آورد روی"
  },
  {
    "poem_id": 87972,
    "vorder": 192,
    "position": 1,
    "text": "بسوی گروگرد شد جنگجوی"
  },
  {
    "poem_id": 87972,
    "vorder": 193,
    "position": 0,
    "text": "میان سرخس است نزدیک طوس"
  },
  {
    "poem_id": 87972,
    "vorder": 194,
    "position": 1,
    "text": "ز باورد برخاست آوای کوس"
  },
  {
    "poem_id": 87972,
    "vorder": 195,
    "position": 0,
    "text": "بپیوست گفتار کارآگهان"
  },
  {
    "poem_id": 87972,
    "vorder": 196,
    "position": 1,
    "text": "بپیران بگفتند یک یک نهان"
  },
  {
    "poem_id": 87972,
    "vorder": 197,
    "position": 0,
    "text": "که ایشان همه میگسارند و مست"
  },
  {
    "poem_id": 87972,
    "vorder": 198,
    "position": 1,
    "text": "شب و روز با جام پر می بدست"
  },
  {
    "poem_id": 87972,
    "vorder": 199,
    "position": 0,
    "text": "سواری طلایه ندیدم براه"
  },
  {
    "poem_id": 87972,
    "vorder": 200,
    "position": 1,
    "text": "نه اندیشهٔ رزم توران سپاه"
  },
  {
    "poem_id": 87972,
    "vorder": 201,
    "position": 0,
    "text": "چو بشنید پیران یلان را بخواند"
  },
  {
    "poem_id": 87972,
    "vorder": 202,
    "position": 1,
    "text": "ز لشکر فراوان سخنها براند"
  },
  {
    "poem_id": 87972,
    "vorder": 203,
    "position": 0,
    "text": "که در رزم ما را چنین دستگاه"
  },
  {
    "poem_id": 87972,
    "vorder": 204,
    "position": 1,
    "text": "نبودست هرگز بایران سپاه"
  }
]