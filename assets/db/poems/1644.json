[
  {
    "poem_id": 1644,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت گویندهٔ پهلوی"
  },
  {
    "poem_id": 1644,
    "vorder": 2,
    "position": 1,
    "text": "شگفت آیدت کاین سخن بشنوی"
  },
  {
    "poem_id": 1644,
    "vorder": 3,
    "position": 0,
    "text": "یکی شاه بد هند را نام کید"
  },
  {
    "poem_id": 1644,
    "vorder": 4,
    "position": 1,
    "text": "نکردی جز از دانش و رای صید"
  },
  {
    "poem_id": 1644,
    "vorder": 5,
    "position": 0,
    "text": "دل بخردان داشت و مغز ردان"
  },
  {
    "poem_id": 1644,
    "vorder": 6,
    "position": 1,
    "text": "نشست کیان افسر موبدان"
  },
  {
    "poem_id": 1644,
    "vorder": 7,
    "position": 0,
    "text": "دمادم به ده شب پس یکدگر"
  },
  {
    "poem_id": 1644,
    "vorder": 8,
    "position": 1,
    "text": "همی خواب دید این شگفتی نگر"
  },
  {
    "poem_id": 1644,
    "vorder": 9,
    "position": 0,
    "text": "به هندوستان هرک دانا بدند"
  },
  {
    "poem_id": 1644,
    "vorder": 10,
    "position": 1,
    "text": "به گفتار و دانش توانا بدند"
  },
  {
    "poem_id": 1644,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود تا ساختند انجمن"
  },
  {
    "poem_id": 1644,
    "vorder": 12,
    "position": 1,
    "text": "هرانکس که دانا بد و رای‌زن"
  },
  {
    "poem_id": 1644,
    "vorder": 13,
    "position": 0,
    "text": "همه خوابها پیش ایشان بگفت"
  },
  {
    "poem_id": 1644,
    "vorder": 14,
    "position": 1,
    "text": "نهفته پدید آورید از نهفت"
  },
  {
    "poem_id": 1644,
    "vorder": 15,
    "position": 0,
    "text": "کس آن را گزارش ندانست کرد"
  },
  {
    "poem_id": 1644,
    "vorder": 16,
    "position": 1,
    "text": "پراندیشه شدشان دل و روی زرد"
  },
  {
    "poem_id": 1644,
    "vorder": 17,
    "position": 0,
    "text": "یکی گفت با کید کای شهریار"
  },
  {
    "poem_id": 1644,
    "vorder": 18,
    "position": 1,
    "text": "خردمند وز مهتران یادگار"
  },
  {
    "poem_id": 1644,
    "vorder": 19,
    "position": 0,
    "text": "یکی نامدارست مهران به نام"
  },
  {
    "poem_id": 1644,
    "vorder": 20,
    "position": 1,
    "text": "ز گیتی به دانش رسیده به کام"
  },
  {
    "poem_id": 1644,
    "vorder": 21,
    "position": 0,
    "text": "به شهر اندرش خواب و آرام نیست"
  },
  {
    "poem_id": 1644,
    "vorder": 22,
    "position": 1,
    "text": "نشستش به جز با دد و دام نیست"
  },
  {
    "poem_id": 1644,
    "vorder": 23,
    "position": 0,
    "text": "ز تخم گیاهای کوهی خورد"
  },
  {
    "poem_id": 1644,
    "vorder": 24,
    "position": 1,
    "text": "چو ما را به مردم همی نشمرد"
  },
  {
    "poem_id": 1644,
    "vorder": 25,
    "position": 0,
    "text": "نشستنش با غرم و آهو بود"
  },
  {
    "poem_id": 1644,
    "vorder": 26,
    "position": 1,
    "text": "ز آزار مردم به یکسو بود"
  },
  {
    "poem_id": 1644,
    "vorder": 27,
    "position": 0,
    "text": "ز چیزی به گیتی نیابد گزند"
  },
  {
    "poem_id": 1644,
    "vorder": 28,
    "position": 1,
    "text": "پرستنده مردی و بختی بلند"
  },
  {
    "poem_id": 1644,
    "vorder": 29,
    "position": 0,
    "text": "مرین خوابها را به جز پیش اوی"
  },
  {
    "poem_id": 1644,
    "vorder": 30,
    "position": 1,
    "text": "مگو و ز نادان گزارش مجوی"
  },
  {
    "poem_id": 1644,
    "vorder": 31,
    "position": 0,
    "text": "چنین گفت با دانشی کید شاه"
  },
  {
    "poem_id": 1644,
    "vorder": 32,
    "position": 1,
    "text": "کزین پرهنر بگذری نیست راه"
  },
  {
    "poem_id": 1644,
    "vorder": 33,
    "position": 0,
    "text": "هم‌انگه باسپ اندر آورد پای"
  },
  {
    "poem_id": 1644,
    "vorder": 34,
    "position": 1,
    "text": "به آواز مهران بیامد ز جای"
  },
  {
    "poem_id": 1644,
    "vorder": 35,
    "position": 0,
    "text": "حکیمان برفتند با او به هم"
  },
  {
    "poem_id": 1644,
    "vorder": 36,
    "position": 1,
    "text": "بدان تا سپهبد نباشد دژم"
  },
  {
    "poem_id": 1644,
    "vorder": 37,
    "position": 0,
    "text": "جهاندار چون نزد مهران رسید"
  },
  {
    "poem_id": 1644,
    "vorder": 38,
    "position": 1,
    "text": "بپرسید داننده را چون سزید"
  },
  {
    "poem_id": 1644,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت کای مرد یزدان‌پرست"
  },
  {
    "poem_id": 1644,
    "vorder": 40,
    "position": 1,
    "text": "که در کوه با غرم داری نشست"
  },
  {
    "poem_id": 1644,
    "vorder": 41,
    "position": 0,
    "text": "به ژرفی بدین خواب من گوش دار"
  },
  {
    "poem_id": 1644,
    "vorder": 42,
    "position": 1,
    "text": "گزارش کن و یک به یک هوش دار"
  },
  {
    "poem_id": 1644,
    "vorder": 43,
    "position": 0,
    "text": "چنان دان که یک شب خردمند و پاک"
  },
  {
    "poem_id": 1644,
    "vorder": 44,
    "position": 1,
    "text": "بخفتم بارام بی‌ترس و باک"
  },
  {
    "poem_id": 1644,
    "vorder": 45,
    "position": 0,
    "text": "یکی خانه دیدم چو کاخی بزرگ"
  },
  {
    "poem_id": 1644,
    "vorder": 46,
    "position": 1,
    "text": "بدو اندرون ژنده پیلی سترگ"
  },
  {
    "poem_id": 1644,
    "vorder": 47,
    "position": 0,
    "text": "در خانه پیداتر از کاخ بود"
  },
  {
    "poem_id": 1644,
    "vorder": 48,
    "position": 1,
    "text": "به پیش اندرون تنگ سوراخ بود"
  },
  {
    "poem_id": 1644,
    "vorder": 49,
    "position": 0,
    "text": "گذشتی ز سوراخ پیل ژیان"
  },
  {
    "poem_id": 1644,
    "vorder": 50,
    "position": 1,
    "text": "تنش را ز تنگی نکردی زیان"
  },
  {
    "poem_id": 1644,
    "vorder": 51,
    "position": 0,
    "text": "ز روزن گذشتی تن و بوم اوی"
  },
  {
    "poem_id": 1644,
    "vorder": 52,
    "position": 1,
    "text": "بماندی بدان خانه خرطوم اوی"
  },
  {
    "poem_id": 1644,
    "vorder": 53,
    "position": 0,
    "text": "دگر شب بدان گونه دیدم که تخت"
  },
  {
    "poem_id": 1644,
    "vorder": 54,
    "position": 1,
    "text": "تهی ماندی از من ای نیک‌بخت"
  },
  {
    "poem_id": 1644,
    "vorder": 55,
    "position": 0,
    "text": "کیی برنشستی بران تخت عاج"
  },
  {
    "poem_id": 1644,
    "vorder": 56,
    "position": 1,
    "text": "به سر بر نهادی دل‌افروز تاج"
  },
  {
    "poem_id": 1644,
    "vorder": 57,
    "position": 0,
    "text": "سه دیگر شب از خوابم آمد شتاب"
  },
  {
    "poem_id": 1644,
    "vorder": 58,
    "position": 1,
    "text": "یکی نغز کرپاس دیدم به خواب"
  },
  {
    "poem_id": 1644,
    "vorder": 59,
    "position": 0,
    "text": "بدو اندر آویخته چار مرد"
  },
  {
    "poem_id": 1644,
    "vorder": 60,
    "position": 1,
    "text": "رخان از کشیدن شده لاژورد"
  },
  {
    "poem_id": 1644,
    "vorder": 61,
    "position": 0,
    "text": "نه کرپاس جایی درید آن گروه"
  },
  {
    "poem_id": 1644,
    "vorder": 62,
    "position": 1,
    "text": "نه مردم شدی از کشیدن ستوه"
  },
  {
    "poem_id": 1644,
    "vorder": 63,
    "position": 0,
    "text": "چهارم چنان دیدم ای نامدار"
  },
  {
    "poem_id": 1644,
    "vorder": 64,
    "position": 1,
    "text": "که مردی شدی تشنه بر جویبار"
  },
  {
    "poem_id": 1644,
    "vorder": 65,
    "position": 0,
    "text": "همی آب ماهی برو ریختی"
  },
  {
    "poem_id": 1644,
    "vorder": 66,
    "position": 1,
    "text": "سر تشنه از آب بگریختی"
  },
  {
    "poem_id": 1644,
    "vorder": 67,
    "position": 0,
    "text": "جهان مرد و آب از پس او دوان"
  },
  {
    "poem_id": 1644,
    "vorder": 68,
    "position": 1,
    "text": "چه گوید بدین خواب نیکی گمان"
  },
  {
    "poem_id": 1644,
    "vorder": 69,
    "position": 0,
    "text": "به پنجم چنان دید جانم به خواب"
  },
  {
    "poem_id": 1644,
    "vorder": 70,
    "position": 1,
    "text": "که شهری بدی هم به نزدیک آب"
  },
  {
    "poem_id": 1644,
    "vorder": 71,
    "position": 0,
    "text": "همه مردمش کور بودی به چشم"
  },
  {
    "poem_id": 1644,
    "vorder": 72,
    "position": 1,
    "text": "یکی را ز کوری ندیدم به خشم"
  },
  {
    "poem_id": 1644,
    "vorder": 73,
    "position": 0,
    "text": "ز داد و دهش وز خرید و فروخت"
  },
  {
    "poem_id": 1644,
    "vorder": 74,
    "position": 1,
    "text": "تو گفتی همی شارستان برفروخت"
  },
  {
    "poem_id": 1644,
    "vorder": 75,
    "position": 0,
    "text": "ششم دیدم ای مهتر ارجمند"
  },
  {
    "poem_id": 1644,
    "vorder": 76,
    "position": 1,
    "text": "که شهری بدندی همه دردمند"
  },
  {
    "poem_id": 1644,
    "vorder": 77,
    "position": 0,
    "text": "شدندی بپرسیدن تن درست"
  },
  {
    "poem_id": 1644,
    "vorder": 78,
    "position": 1,
    "text": "همی دردمند آب ایشان بجست"
  },
  {
    "poem_id": 1644,
    "vorder": 79,
    "position": 0,
    "text": "همی گفت چونی به درد اندرون"
  },
  {
    "poem_id": 1644,
    "vorder": 80,
    "position": 1,
    "text": "تنی دردمند و دلی پر ز خون"
  },
  {
    "poem_id": 1644,
    "vorder": 81,
    "position": 0,
    "text": "رسیده به لب جان ناتن‌درست"
  },
  {
    "poem_id": 1644,
    "vorder": 82,
    "position": 1,
    "text": "همه چارهٔ تن‌درستان بجست"
  },
  {
    "poem_id": 1644,
    "vorder": 83,
    "position": 0,
    "text": "چو نیمی ز هفتم شب اندر گذشت"
  },
  {
    "poem_id": 1644,
    "vorder": 84,
    "position": 1,
    "text": "جهنده یکی باره دیدم به دشت"
  },
  {
    "poem_id": 1644,
    "vorder": 85,
    "position": 0,
    "text": "دو پا و دو دست و دو سر داشتی"
  },
  {
    "poem_id": 1644,
    "vorder": 86,
    "position": 1,
    "text": "به دندان گیا نیز بگذاشتی"
  },
  {
    "poem_id": 1644,
    "vorder": 87,
    "position": 0,
    "text": "چران داشتی از دو رویه دهن"
  },
  {
    "poem_id": 1644,
    "vorder": 88,
    "position": 1,
    "text": "نبد بر تنش جای بیرون شدن"
  },
  {
    "poem_id": 1644,
    "vorder": 89,
    "position": 0,
    "text": "بهشتم سه خم دیدم ای پاکدین"
  },
  {
    "poem_id": 1644,
    "vorder": 90,
    "position": 1,
    "text": "برابر نهاده بروی زمین"
  },
  {
    "poem_id": 1644,
    "vorder": 91,
    "position": 0,
    "text": "دو پرآب و خمی تهی در میان"
  },
  {
    "poem_id": 1644,
    "vorder": 92,
    "position": 1,
    "text": "گذشته به خشکی برو سالیان"
  },
  {
    "poem_id": 1644,
    "vorder": 93,
    "position": 0,
    "text": "ز دو خم پر آب دو نیک مرد"
  },
  {
    "poem_id": 1644,
    "vorder": 94,
    "position": 1,
    "text": "همی ریختند اندرو آب سرد"
  },
  {
    "poem_id": 1644,
    "vorder": 95,
    "position": 0,
    "text": "نه از ریختن زین کران کم شدی"
  },
  {
    "poem_id": 1644,
    "vorder": 96,
    "position": 1,
    "text": "نه آن خشک را دل پر از نم شدی"
  },
  {
    "poem_id": 1644,
    "vorder": 97,
    "position": 0,
    "text": "نهم شب یکی گاو دیدم به خواب"
  },
  {
    "poem_id": 1644,
    "vorder": 98,
    "position": 1,
    "text": "بر آب و گیا خفته بر آفتاب"
  },
  {
    "poem_id": 1644,
    "vorder": 99,
    "position": 0,
    "text": "یکی خوب گوساله در پیش اوی"
  },
  {
    "poem_id": 1644,
    "vorder": 100,
    "position": 1,
    "text": "تنش لاغر و خشک و بی‌آب روی"
  },
  {
    "poem_id": 1644,
    "vorder": 101,
    "position": 0,
    "text": "همی شیر خوردی ازو ماده گاو"
  },
  {
    "poem_id": 1644,
    "vorder": 102,
    "position": 1,
    "text": "کلان گاو گوساله بی زور و تاو"
  },
  {
    "poem_id": 1644,
    "vorder": 103,
    "position": 0,
    "text": "اگر گوش داری به خواب دهم"
  },
  {
    "poem_id": 1644,
    "vorder": 104,
    "position": 1,
    "text": "نرنجی همی تا بدین سر دهم"
  },
  {
    "poem_id": 1644,
    "vorder": 105,
    "position": 0,
    "text": "یکی چشمه دیدم به دشتی فراخ"
  },
  {
    "poem_id": 1644,
    "vorder": 106,
    "position": 1,
    "text": "وزو بر زبر برده ایوان و کاخ"
  },
  {
    "poem_id": 1644,
    "vorder": 107,
    "position": 0,
    "text": "همه دشت یکسر پر از آب و نم"
  },
  {
    "poem_id": 1644,
    "vorder": 108,
    "position": 1,
    "text": "ز خشکی لب چشمه گشته دژم"
  },
  {
    "poem_id": 1644,
    "vorder": 109,
    "position": 0,
    "text": "سزد گر تو پاسخ بگویی نهان"
  },
  {
    "poem_id": 1644,
    "vorder": 110,
    "position": 1,
    "text": "کزین پس چه خواهد بدن در جهان"
  }
]