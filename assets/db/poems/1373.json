[
  {
    "poem_id": 1373,
    "vorder": 1,
    "position": 0,
    "text": "سپیده چو از تیره شب بردمید"
  },
  {
    "poem_id": 1373,
    "vorder": 2,
    "position": 1,
    "text": "میان شب تیره اندر خمید"
  },
  {
    "poem_id": 1373,
    "vorder": 3,
    "position": 0,
    "text": "منوچهر برخاست از قلب‌گاه"
  },
  {
    "poem_id": 1373,
    "vorder": 4,
    "position": 1,
    "text": "ابا جوشن و تیغ و رومی کلاه"
  },
  {
    "poem_id": 1373,
    "vorder": 5,
    "position": 0,
    "text": "سپه یکسره نعره برداشتند"
  },
  {
    "poem_id": 1373,
    "vorder": 6,
    "position": 1,
    "text": "سنان‌ها به ابر اندر افراشتند"
  },
  {
    "poem_id": 1373,
    "vorder": 7,
    "position": 0,
    "text": "پر از خشم سر ابروان پر ز چین"
  },
  {
    "poem_id": 1373,
    "vorder": 8,
    "position": 1,
    "text": "همی بر نوشتند روی زمین"
  },
  {
    "poem_id": 1373,
    "vorder": 9,
    "position": 0,
    "text": "چپ و راست و قلب و جناح سپاه"
  },
  {
    "poem_id": 1373,
    "vorder": 10,
    "position": 1,
    "text": "بیاراست لشکر چو بایست شاه"
  },
  {
    "poem_id": 1373,
    "vorder": 11,
    "position": 0,
    "text": "زمین شد به کردار کشتی بر آب"
  },
  {
    "poem_id": 1373,
    "vorder": 12,
    "position": 1,
    "text": "تو گفتی سوی غرق دارد شتاب"
  },
  {
    "poem_id": 1373,
    "vorder": 13,
    "position": 0,
    "text": "بزد مهره بر کوههٔ ژنده پیل"
  },
  {
    "poem_id": 1373,
    "vorder": 14,
    "position": 1,
    "text": "زمین جنب‌جنبان چو دریای نیل"
  },
  {
    "poem_id": 1373,
    "vorder": 15,
    "position": 0,
    "text": "همان پیش پیلان تبیره زنان"
  },
  {
    "poem_id": 1373,
    "vorder": 16,
    "position": 1,
    "text": "خروشان و جوشان و پیلان دمان"
  },
  {
    "poem_id": 1373,
    "vorder": 17,
    "position": 0,
    "text": "یکی بزمگاه‌ست گفتی به‌جای"
  },
  {
    "poem_id": 1373,
    "vorder": 18,
    "position": 1,
    "text": "ز شیپور و نالیدن کره نای"
  },
  {
    "poem_id": 1373,
    "vorder": 19,
    "position": 0,
    "text": "برفتند از جای یکسر چو کوه"
  },
  {
    "poem_id": 1373,
    "vorder": 20,
    "position": 1,
    "text": "دهاده برآمد ز هر دو گروه"
  },
  {
    "poem_id": 1373,
    "vorder": 21,
    "position": 0,
    "text": "بیابان چو دریای خون شد درست"
  },
  {
    "poem_id": 1373,
    "vorder": 22,
    "position": 1,
    "text": "تو گفتی که روی زمین لاله رست"
  },
  {
    "poem_id": 1373,
    "vorder": 23,
    "position": 0,
    "text": "پی ژنده پیلان به خون اندرون"
  },
  {
    "poem_id": 1373,
    "vorder": 24,
    "position": 1,
    "text": "چنان چون ز بیجاده باشد ستون"
  },
  {
    "poem_id": 1373,
    "vorder": 25,
    "position": 0,
    "text": "همه چیرگی با منوچهر بود"
  },
  {
    "poem_id": 1373,
    "vorder": 26,
    "position": 1,
    "text": "کزو مغز گیتی پر از مهر بود"
  },
  {
    "poem_id": 1373,
    "vorder": 27,
    "position": 0,
    "text": "چنین تا شب تیره سر بر کشید"
  },
  {
    "poem_id": 1373,
    "vorder": 28,
    "position": 1,
    "text": "درخشنده خورشید شد ناپدید"
  },
  {
    "poem_id": 1373,
    "vorder": 29,
    "position": 0,
    "text": "زمانه به یک سان ندارد درنگ"
  },
  {
    "poem_id": 1373,
    "vorder": 30,
    "position": 1,
    "text": "گهی شهد و نوش است و گاهی شرنگ"
  },
  {
    "poem_id": 1373,
    "vorder": 31,
    "position": 0,
    "text": "دل تور و سلم اندر آمد به‌جوش"
  },
  {
    "poem_id": 1373,
    "vorder": 32,
    "position": 1,
    "text": "به راه شبیخون نهادند گوش"
  },
  {
    "poem_id": 1373,
    "vorder": 33,
    "position": 0,
    "text": "چو شب روز شد کس نیامد به جنگ"
  },
  {
    "poem_id": 1373,
    "vorder": 34,
    "position": 1,
    "text": "دو جنگی گرفتند ساز درنگ"
  }
]