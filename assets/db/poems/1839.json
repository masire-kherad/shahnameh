[
  {
    "poem_id": 1839,
    "vorder": 1,
    "position": 0,
    "text": "چوبشنید بهرام کز روزگار"
  },
  {
    "poem_id": 1839,
    "vorder": 2,
    "position": 1,
    "text": "چه آمد بران نامور شهریار"
  },
  {
    "poem_id": 1839,
    "vorder": 3,
    "position": 0,
    "text": "نهادند بر چشم روشنش داغ"
  },
  {
    "poem_id": 1839,
    "vorder": 4,
    "position": 1,
    "text": "بمرد آن چراغ دو نرگس بباغ"
  },
  {
    "poem_id": 1839,
    "vorder": 5,
    "position": 0,
    "text": "پسر برنشست از بر تخت اوی"
  },
  {
    "poem_id": 1839,
    "vorder": 6,
    "position": 1,
    "text": "بپا اندر آمد سر وبخت اوی"
  },
  {
    "poem_id": 1839,
    "vorder": 7,
    "position": 0,
    "text": "ازان ماند بهرام اندر شگفت"
  },
  {
    "poem_id": 1839,
    "vorder": 8,
    "position": 1,
    "text": "بپژمرد واندیشه اندر گرفت"
  },
  {
    "poem_id": 1839,
    "vorder": 9,
    "position": 0,
    "text": "بفرمود تا کوس بیرون برند"
  },
  {
    "poem_id": 1839,
    "vorder": 10,
    "position": 1,
    "text": "درفش بزرگی به هامون برند"
  },
  {
    "poem_id": 1839,
    "vorder": 11,
    "position": 0,
    "text": "بنه برنهاد وسپه برنشست"
  },
  {
    "poem_id": 1839,
    "vorder": 12,
    "position": 1,
    "text": "بپیکار خسرو میان را ببست"
  },
  {
    "poem_id": 1839,
    "vorder": 13,
    "position": 0,
    "text": "سپاهی بکردار کوه روان"
  },
  {
    "poem_id": 1839,
    "vorder": 14,
    "position": 1,
    "text": "همی‌راند گستاخ تا نهروان"
  },
  {
    "poem_id": 1839,
    "vorder": 15,
    "position": 0,
    "text": "چوآگاه شد خسرو از کاراوی"
  },
  {
    "poem_id": 1839,
    "vorder": 16,
    "position": 1,
    "text": "غمی گشت زان تیز بازار اوی"
  },
  {
    "poem_id": 1839,
    "vorder": 17,
    "position": 0,
    "text": "فرستاد بیدار کارآگهان"
  },
  {
    "poem_id": 1839,
    "vorder": 18,
    "position": 1,
    "text": "که تا بازجویند کارجهان"
  },
  {
    "poem_id": 1839,
    "vorder": 19,
    "position": 0,
    "text": "به کارآگهان گفت راز ازنخست"
  },
  {
    "poem_id": 1839,
    "vorder": 20,
    "position": 1,
    "text": "زلشکر همی‌کرد باید درست"
  },
  {
    "poem_id": 1839,
    "vorder": 21,
    "position": 0,
    "text": "که بااو یکی اند لشکر به جنگ"
  },
  {
    "poem_id": 1839,
    "vorder": 22,
    "position": 1,
    "text": "وگر گردد این کار ما با درنگ"
  },
  {
    "poem_id": 1839,
    "vorder": 23,
    "position": 0,
    "text": "دگر آنک بهرام در قلبگاه"
  },
  {
    "poem_id": 1839,
    "vorder": 24,
    "position": 1,
    "text": "بود بیشتر گر میان سپاه"
  },
  {
    "poem_id": 1839,
    "vorder": 25,
    "position": 0,
    "text": "چگونه نشیند بهنگام بار"
  },
  {
    "poem_id": 1839,
    "vorder": 26,
    "position": 1,
    "text": "برفتن کند هیچ رای شکار"
  },
  {
    "poem_id": 1839,
    "vorder": 27,
    "position": 0,
    "text": "برفتند کارآگهان از درش"
  },
  {
    "poem_id": 1839,
    "vorder": 28,
    "position": 1,
    "text": "نبود آگه از کار وز لشکرش"
  },
  {
    "poem_id": 1839,
    "vorder": 29,
    "position": 0,
    "text": "چو رفتند و دیدند و بازآمدند"
  },
  {
    "poem_id": 1839,
    "vorder": 30,
    "position": 1,
    "text": "نهانی بر او فراز آمدند"
  },
  {
    "poem_id": 1839,
    "vorder": 31,
    "position": 0,
    "text": "که لشکر بهرکار با اویکیست"
  },
  {
    "poem_id": 1839,
    "vorder": 32,
    "position": 1,
    "text": "اگر نامدارست وگر کودکیست"
  },
  {
    "poem_id": 1839,
    "vorder": 33,
    "position": 0,
    "text": "هرانگه که لشکر براند به راه"
  },
  {
    "poem_id": 1839,
    "vorder": 34,
    "position": 1,
    "text": "بود یک زمان در میان سپاه"
  },
  {
    "poem_id": 1839,
    "vorder": 35,
    "position": 0,
    "text": "زمانی شود بر سوی میمنه"
  },
  {
    "poem_id": 1839,
    "vorder": 36,
    "position": 1,
    "text": "گهی بر چپ و گاه سوی بنه"
  },
  {
    "poem_id": 1839,
    "vorder": 37,
    "position": 0,
    "text": "همه مردم خویش دارد براز"
  },
  {
    "poem_id": 1839,
    "vorder": 38,
    "position": 1,
    "text": "ببیگانگانشان نیاید نیاز"
  },
  {
    "poem_id": 1839,
    "vorder": 39,
    "position": 0,
    "text": "بکردار شاهان نشیند ببار"
  },
  {
    "poem_id": 1839,
    "vorder": 40,
    "position": 1,
    "text": "همان در در و دشت جوید شکار"
  },
  {
    "poem_id": 1839,
    "vorder": 41,
    "position": 0,
    "text": "چو از رزم شاهان نراند همی"
  },
  {
    "poem_id": 1839,
    "vorder": 42,
    "position": 1,
    "text": "همه دفتر دمنه خواند همی"
  },
  {
    "poem_id": 1839,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت خسرو بدستور خویش"
  },
  {
    "poem_id": 1839,
    "vorder": 44,
    "position": 1,
    "text": "که کاری درازست ما را به پیش"
  },
  {
    "poem_id": 1839,
    "vorder": 45,
    "position": 0,
    "text": "چو بهرام بر دشمن اسپ افکند"
  },
  {
    "poem_id": 1839,
    "vorder": 46,
    "position": 1,
    "text": "بدریا دل اژدها بشکند"
  },
  {
    "poem_id": 1839,
    "vorder": 47,
    "position": 0,
    "text": "دگر آنک آیین شاهنشهان"
  },
  {
    "poem_id": 1839,
    "vorder": 48,
    "position": 1,
    "text": "بیاموخت از شهریار جهان"
  },
  {
    "poem_id": 1839,
    "vorder": 49,
    "position": 0,
    "text": "سیم کش کلیله است ودمنه وزیر"
  },
  {
    "poem_id": 1839,
    "vorder": 50,
    "position": 1,
    "text": "چون او رای زن کس ندارد دبیر"
  },
  {
    "poem_id": 1839,
    "vorder": 51,
    "position": 0,
    "text": "ازان پس ببندوی و گستهم گفت"
  },
  {
    "poem_id": 1839,
    "vorder": 52,
    "position": 1,
    "text": "که ما با غم و رنج گشتیم جفت"
  },
  {
    "poem_id": 1839,
    "vorder": 53,
    "position": 0,
    "text": "چوگردوی و شاپور و چون اندیان"
  },
  {
    "poem_id": 1839,
    "vorder": 54,
    "position": 1,
    "text": "سپهدار ارمینیه رادمان"
  },
  {
    "poem_id": 1839,
    "vorder": 55,
    "position": 0,
    "text": "نشستند با شاه ایران براز"
  },
  {
    "poem_id": 1839,
    "vorder": 56,
    "position": 1,
    "text": "بزرگان فرزانه رزمساز"
  },
  {
    "poem_id": 1839,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت خسرو بدان مهتران"
  },
  {
    "poem_id": 1839,
    "vorder": 58,
    "position": 1,
    "text": "که ای سرفرازان و جنگ آوران"
  },
  {
    "poem_id": 1839,
    "vorder": 59,
    "position": 0,
    "text": "هرآن مغز کو را خرد روشنست"
  },
  {
    "poem_id": 1839,
    "vorder": 60,
    "position": 1,
    "text": "زدانش یکی بر تنش جوشنست"
  },
  {
    "poem_id": 1839,
    "vorder": 61,
    "position": 0,
    "text": "کس آنرا نبرد مگر تیغ مرگ"
  },
  {
    "poem_id": 1839,
    "vorder": 62,
    "position": 1,
    "text": "شود موم ازان زخم پولاد ترگ"
  },
  {
    "poem_id": 1839,
    "vorder": 63,
    "position": 0,
    "text": "کنون من بسال ازشما کهترم"
  },
  {
    "poem_id": 1839,
    "vorder": 64,
    "position": 1,
    "text": "برای جوانی جهان نسپرم"
  },
  {
    "poem_id": 1839,
    "vorder": 65,
    "position": 0,
    "text": "بگویید تا چارهٔ کارچیست"
  },
  {
    "poem_id": 1839,
    "vorder": 66,
    "position": 1,
    "text": "بران خستگیها پرآزار کیست"
  },
  {
    "poem_id": 1839,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت موبد انوشه بدی"
  },
  {
    "poem_id": 1839,
    "vorder": 68,
    "position": 1,
    "text": "همه مغز را فر وتوشه بدی"
  },
  {
    "poem_id": 1839,
    "vorder": 69,
    "position": 0,
    "text": "چوپیدا شد این راز گردنده دهر"
  },
  {
    "poem_id": 1839,
    "vorder": 70,
    "position": 1,
    "text": "خرد را ببخشید بر چاربهر"
  },
  {
    "poem_id": 1839,
    "vorder": 71,
    "position": 0,
    "text": "چونیمی ازو بهرهٔ پادشاست"
  },
  {
    "poem_id": 1839,
    "vorder": 72,
    "position": 1,
    "text": "که فر و خرد پادشا را سزاست"
  },
  {
    "poem_id": 1839,
    "vorder": 73,
    "position": 0,
    "text": "دگر بهرهٔ مردم پارسا"
  },
  {
    "poem_id": 1839,
    "vorder": 74,
    "position": 1,
    "text": "سدیگر پرستنده پادشا"
  },
  {
    "poem_id": 1839,
    "vorder": 75,
    "position": 0,
    "text": "چو نزدیک باشد بشاه جهان"
  },
  {
    "poem_id": 1839,
    "vorder": 76,
    "position": 1,
    "text": "خرد خویشتن زو ندارد نهان"
  },
  {
    "poem_id": 1839,
    "vorder": 77,
    "position": 0,
    "text": "کنون از خرد پاره‌ای ماند خرد"
  },
  {
    "poem_id": 1839,
    "vorder": 78,
    "position": 1,
    "text": "که دانا ورا بهر دهقان شمرد"
  },
  {
    "poem_id": 1839,
    "vorder": 79,
    "position": 0,
    "text": "خرد نیست با مردم ناسپاس"
  },
  {
    "poem_id": 1839,
    "vorder": 80,
    "position": 1,
    "text": "نه آنرا که او نیست یزدان شناس"
  },
  {
    "poem_id": 1839,
    "vorder": 81,
    "position": 0,
    "text": "اگر بشنود شهریار این سخن"
  },
  {
    "poem_id": 1839,
    "vorder": 82,
    "position": 1,
    "text": "که گفتست بیدار مرد کهن"
  },
  {
    "poem_id": 1839,
    "vorder": 83,
    "position": 0,
    "text": "بدو گفت شاه این سخن گر بزر"
  },
  {
    "poem_id": 1839,
    "vorder": 84,
    "position": 1,
    "text": "نویسم جز این نیست آیین و فر"
  },
  {
    "poem_id": 1839,
    "vorder": 85,
    "position": 0,
    "text": "سخن گفتن موبدان گوهرست"
  },
  {
    "poem_id": 1839,
    "vorder": 86,
    "position": 1,
    "text": "مرا در دل اندیشه دیگرست"
  },
  {
    "poem_id": 1839,
    "vorder": 87,
    "position": 0,
    "text": "که چون این دو لشکر برابر شود"
  },
  {
    "poem_id": 1839,
    "vorder": 88,
    "position": 1,
    "text": "سر نیزه‌ها بر دو پیکر شود"
  },
  {
    "poem_id": 1839,
    "vorder": 89,
    "position": 0,
    "text": "نباشد مرا ننگ کز قلبگاه"
  },
  {
    "poem_id": 1839,
    "vorder": 90,
    "position": 1,
    "text": "برانم شوم پیش او بی‌سپاه"
  },
  {
    "poem_id": 1839,
    "vorder": 91,
    "position": 0,
    "text": "بخوانم به آواز بهرام را"
  },
  {
    "poem_id": 1839,
    "vorder": 92,
    "position": 1,
    "text": "سپهدار بدنام خودکام را"
  },
  {
    "poem_id": 1839,
    "vorder": 93,
    "position": 0,
    "text": "یکی ز آشتی روی بنمایمش"
  },
  {
    "poem_id": 1839,
    "vorder": 94,
    "position": 1,
    "text": "نوازمش بسیار و بستایمش"
  },
  {
    "poem_id": 1839,
    "vorder": 95,
    "position": 0,
    "text": "اگر خود پذیرد سخن به بود"
  },
  {
    "poem_id": 1839,
    "vorder": 96,
    "position": 1,
    "text": "که چون او بدرگاه بر که بود"
  },
  {
    "poem_id": 1839,
    "vorder": 97,
    "position": 0,
    "text": "وگر جنگ جوید منم جنگ جوی"
  },
  {
    "poem_id": 1839,
    "vorder": 98,
    "position": 1,
    "text": "سپه را بروی اندر آریم روی"
  },
  {
    "poem_id": 1839,
    "vorder": 99,
    "position": 0,
    "text": "همه کاردانان بدین داستان"
  },
  {
    "poem_id": 1839,
    "vorder": 100,
    "position": 1,
    "text": "کجا گفت گشتند همداستان"
  },
  {
    "poem_id": 1839,
    "vorder": 101,
    "position": 0,
    "text": "بزرگان برو آفرین خواندند"
  },
  {
    "poem_id": 1839,
    "vorder": 102,
    "position": 1,
    "text": "ورا شهریار زمین خواندند"
  },
  {
    "poem_id": 1839,
    "vorder": 103,
    "position": 0,
    "text": "همی‌گفت هرکس که ای شهریار"
  },
  {
    "poem_id": 1839,
    "vorder": 104,
    "position": 1,
    "text": "زتو دور بادا بد روزگار"
  },
  {
    "poem_id": 1839,
    "vorder": 105,
    "position": 0,
    "text": "تو را باد پیروزی و فرهی"
  },
  {
    "poem_id": 1839,
    "vorder": 106,
    "position": 1,
    "text": "بزرگی و دیهیم شاهنشهی"
  },
  {
    "poem_id": 1839,
    "vorder": 107,
    "position": 0,
    "text": "چنین گفت خسرو که این باد و بس"
  },
  {
    "poem_id": 1839,
    "vorder": 108,
    "position": 1,
    "text": "شکست و جدایی مبیناد کس"
  },
  {
    "poem_id": 1839,
    "vorder": 109,
    "position": 0,
    "text": "سپه را ز بغداد بیرون کشید"
  },
  {
    "poem_id": 1839,
    "vorder": 110,
    "position": 1,
    "text": "سراپردهٔ نو به هامون کشید"
  },
  {
    "poem_id": 1839,
    "vorder": 111,
    "position": 0,
    "text": "دو لشکر چو تنگ اندر آمد به راه"
  },
  {
    "poem_id": 1839,
    "vorder": 112,
    "position": 1,
    "text": "ازان رو سپهبد وزین روی شاه"
  },
  {
    "poem_id": 1839,
    "vorder": 113,
    "position": 0,
    "text": "چو شمع جهان شد بخم اندرون"
  },
  {
    "poem_id": 1839,
    "vorder": 114,
    "position": 1,
    "text": "بیفشاند زلف شب تیره گون"
  },
  {
    "poem_id": 1839,
    "vorder": 115,
    "position": 0,
    "text": "طلایه بیامد ز هر دو سپاه"
  },
  {
    "poem_id": 1839,
    "vorder": 116,
    "position": 1,
    "text": "که دارد ز بدخواه خود را نگاه"
  },
  {
    "poem_id": 1839,
    "vorder": 117,
    "position": 0,
    "text": "چو از خنجر روز بگریخت شب"
  },
  {
    "poem_id": 1839,
    "vorder": 118,
    "position": 1,
    "text": "همی‌ تاخت سوزان دل و خشک لب"
  },
  {
    "poem_id": 1839,
    "vorder": 119,
    "position": 0,
    "text": "تبیره برآمد ز هر دو سرای"
  },
  {
    "poem_id": 1839,
    "vorder": 120,
    "position": 1,
    "text": "بدان رزم خورشید بد رهنمای"
  },
  {
    "poem_id": 1839,
    "vorder": 121,
    "position": 0,
    "text": "بگستهم و بندوی فرمود شاه"
  },
  {
    "poem_id": 1839,
    "vorder": 122,
    "position": 1,
    "text": "که تا بر نهادند ز آهن کلاه"
  },
  {
    "poem_id": 1839,
    "vorder": 123,
    "position": 0,
    "text": "چنین با بزرگان روشن روان"
  },
  {
    "poem_id": 1839,
    "vorder": 124,
    "position": 1,
    "text": "همی‌راند تا چشمهٔ نهروان"
  },
  {
    "poem_id": 1839,
    "vorder": 125,
    "position": 0,
    "text": "طلایه ببهرام شد ناگزیر"
  },
  {
    "poem_id": 1839,
    "vorder": 126,
    "position": 1,
    "text": "که آمد سپه بر دو پرتاب تیر"
  },
  {
    "poem_id": 1839,
    "vorder": 127,
    "position": 0,
    "text": "چوبشنید بهرام لشکر براند"
  },
  {
    "poem_id": 1839,
    "vorder": 128,
    "position": 1,
    "text": "جهاندیدگان را برخویش خواند"
  },
  {
    "poem_id": 1839,
    "vorder": 129,
    "position": 0,
    "text": "نشست از برابلق مشک دم"
  },
  {
    "poem_id": 1839,
    "vorder": 130,
    "position": 1,
    "text": "خنیده سرافراز رویینه سم"
  },
  {
    "poem_id": 1839,
    "vorder": 131,
    "position": 0,
    "text": "سلیحش یکی هندوی تیغ بود"
  },
  {
    "poem_id": 1839,
    "vorder": 132,
    "position": 1,
    "text": "که درزخم چون آتش میغ بود"
  },
  {
    "poem_id": 1839,
    "vorder": 133,
    "position": 0,
    "text": "چوبرق درفشان همی‌راند اسپ"
  },
  {
    "poem_id": 1839,
    "vorder": 134,
    "position": 1,
    "text": "بدست چپش ریمن آذرگشسپ"
  },
  {
    "poem_id": 1839,
    "vorder": 135,
    "position": 0,
    "text": "چو آیین گشسپ و یلان سینه نیز"
  },
  {
    "poem_id": 1839,
    "vorder": 136,
    "position": 1,
    "text": "برفتند پرکینه و پرستیز"
  },
  {
    "poem_id": 1839,
    "vorder": 137,
    "position": 0,
    "text": "سه ترک دلاور ز خاقانیان"
  },
  {
    "poem_id": 1839,
    "vorder": 138,
    "position": 1,
    "text": "بران کین بهرام بسته میان"
  },
  {
    "poem_id": 1839,
    "vorder": 139,
    "position": 0,
    "text": "پذیرفته هر سه که چون روی شاه"
  },
  {
    "poem_id": 1839,
    "vorder": 140,
    "position": 1,
    "text": "ببینیم دور ازمیان سپاه"
  },
  {
    "poem_id": 1839,
    "vorder": 141,
    "position": 0,
    "text": "اگر بسته گر کشته او را برت"
  },
  {
    "poem_id": 1839,
    "vorder": 142,
    "position": 1,
    "text": "بیاریم و آسوده شد لشکرت"
  },
  {
    "poem_id": 1839,
    "vorder": 143,
    "position": 0,
    "text": "ز یک روی خسرو دگر پهلوان"
  },
  {
    "poem_id": 1839,
    "vorder": 144,
    "position": 1,
    "text": "میان اندرون نهروان روان"
  },
  {
    "poem_id": 1839,
    "vorder": 145,
    "position": 0,
    "text": "نظاره بران از دو رویه سپاه"
  },
  {
    "poem_id": 1839,
    "vorder": 146,
    "position": 1,
    "text": "که تا پهلوان چون رود نزد شاه"
  }
]