[
  {
    "poem_id": 1693,
    "vorder": 1,
    "position": 0,
    "text": "چو شد روی کشور به کردار قیر"
  },
  {
    "poem_id": 1693,
    "vorder": 2,
    "position": 1,
    "text": "کنیزک بیامد بر اردشیر"
  },
  {
    "poem_id": 1693,
    "vorder": 3,
    "position": 0,
    "text": "چو دریا برآشفت مرد جوان"
  },
  {
    "poem_id": 1693,
    "vorder": 4,
    "position": 1,
    "text": "که یک روز نشکیبی از اردوان"
  },
  {
    "poem_id": 1693,
    "vorder": 5,
    "position": 0,
    "text": "کنیزک بگفت آنچ روشن‌روان"
  },
  {
    "poem_id": 1693,
    "vorder": 6,
    "position": 1,
    "text": "همی گفت با نامدار اردوان"
  },
  {
    "poem_id": 1693,
    "vorder": 7,
    "position": 0,
    "text": "سخن چون ز گلنار زان سان شنید"
  },
  {
    "poem_id": 1693,
    "vorder": 8,
    "position": 1,
    "text": "شکیبایی و خامشی برگزید"
  },
  {
    "poem_id": 1693,
    "vorder": 9,
    "position": 0,
    "text": "دل مرد برنا شد از ماه تیز"
  },
  {
    "poem_id": 1693,
    "vorder": 10,
    "position": 1,
    "text": "ازان پس همی جست راه گریز"
  },
  {
    "poem_id": 1693,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت گر من به ایران شوم"
  },
  {
    "poem_id": 1693,
    "vorder": 12,
    "position": 1,
    "text": "ز ری سوی شهر دلیران شوم"
  },
  {
    "poem_id": 1693,
    "vorder": 13,
    "position": 0,
    "text": "تو با من سگالی که آیی به راه"
  },
  {
    "poem_id": 1693,
    "vorder": 14,
    "position": 1,
    "text": "گر ایدر بباشی به نزدیک شاه"
  },
  {
    "poem_id": 1693,
    "vorder": 15,
    "position": 0,
    "text": "اگر با من آیی توانگر شوی"
  },
  {
    "poem_id": 1693,
    "vorder": 16,
    "position": 1,
    "text": "همان بر سر کشور افسر شوی"
  },
  {
    "poem_id": 1693,
    "vorder": 17,
    "position": 0,
    "text": "چنین داد پاسخ که من بنده‌ام"
  },
  {
    "poem_id": 1693,
    "vorder": 18,
    "position": 1,
    "text": "نباشم جدا از تو تا زنده‌ام"
  },
  {
    "poem_id": 1693,
    "vorder": 19,
    "position": 0,
    "text": "همی گفت با لب پر از باد سرد"
  },
  {
    "poem_id": 1693,
    "vorder": 20,
    "position": 1,
    "text": "فرو ریخت از دیدگان آب زرد"
  },
  {
    "poem_id": 1693,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت با ماه‌روی اردشیر"
  },
  {
    "poem_id": 1693,
    "vorder": 22,
    "position": 1,
    "text": "که فردا بباید شدن ناگزیر"
  },
  {
    "poem_id": 1693,
    "vorder": 23,
    "position": 0,
    "text": "کنیزک بیامد به ایوان خویش"
  },
  {
    "poem_id": 1693,
    "vorder": 24,
    "position": 1,
    "text": "به کف برنهاده تن و جان خویش"
  },
  {
    "poem_id": 1693,
    "vorder": 25,
    "position": 0,
    "text": "چو شد روی گیتی ز خورشید زرد"
  },
  {
    "poem_id": 1693,
    "vorder": 26,
    "position": 1,
    "text": "به خم اندر آمد شب لاژورد"
  },
  {
    "poem_id": 1693,
    "vorder": 27,
    "position": 0,
    "text": "کنیزک در گنجها باز کرد"
  },
  {
    "poem_id": 1693,
    "vorder": 28,
    "position": 1,
    "text": "ز هر گوهری جستن آغاز کرد"
  },
  {
    "poem_id": 1693,
    "vorder": 29,
    "position": 0,
    "text": "ز یاقوت وز گوهر شاهوار"
  },
  {
    "poem_id": 1693,
    "vorder": 30,
    "position": 1,
    "text": "ز دینار چندانک بودش به کار"
  },
  {
    "poem_id": 1693,
    "vorder": 31,
    "position": 0,
    "text": "بیامد به جایی که بودش نشست"
  },
  {
    "poem_id": 1693,
    "vorder": 32,
    "position": 1,
    "text": "بدان خانه بنهاد گوهر ز دست"
  },
  {
    "poem_id": 1693,
    "vorder": 33,
    "position": 0,
    "text": "همی بود تا شب برآمد ز کوه"
  },
  {
    "poem_id": 1693,
    "vorder": 34,
    "position": 1,
    "text": "بخفت اردوان جای شد بی‌گروه"
  },
  {
    "poem_id": 1693,
    "vorder": 35,
    "position": 0,
    "text": "از ایوان بیامد به کردار تیر"
  },
  {
    "poem_id": 1693,
    "vorder": 36,
    "position": 1,
    "text": "بیاورد گوهر بر اردشیر"
  },
  {
    "poem_id": 1693,
    "vorder": 37,
    "position": 0,
    "text": "جهانجوی را دید جامی به دست"
  },
  {
    "poem_id": 1693,
    "vorder": 38,
    "position": 1,
    "text": "نگهبان اسپان همه خفته مست"
  },
  {
    "poem_id": 1693,
    "vorder": 39,
    "position": 0,
    "text": "کجا مستشان کرده بود اردشیر"
  },
  {
    "poem_id": 1693,
    "vorder": 40,
    "position": 1,
    "text": "که وی خواست رفتن همی ناگزیر"
  },
  {
    "poem_id": 1693,
    "vorder": 41,
    "position": 0,
    "text": "دو اسپ گرانمایه کرده گزین"
  },
  {
    "poem_id": 1693,
    "vorder": 42,
    "position": 1,
    "text": "بر آخور چنان بود در زیر زین"
  },
  {
    "poem_id": 1693,
    "vorder": 43,
    "position": 0,
    "text": "جهانجوی چون روی گلنار دید"
  },
  {
    "poem_id": 1693,
    "vorder": 44,
    "position": 1,
    "text": "همان گوهر و سرخ دینار دید"
  },
  {
    "poem_id": 1693,
    "vorder": 45,
    "position": 0,
    "text": "هم‌اندر زمان پیش بنهاد جام"
  },
  {
    "poem_id": 1693,
    "vorder": 46,
    "position": 1,
    "text": "بزد بر سر تازی اسپان لگام"
  },
  {
    "poem_id": 1693,
    "vorder": 47,
    "position": 0,
    "text": "بپوشید خفتان و خود بر نشست"
  },
  {
    "poem_id": 1693,
    "vorder": 48,
    "position": 1,
    "text": "یکی تیغ زهر آب داده به دست"
  },
  {
    "poem_id": 1693,
    "vorder": 49,
    "position": 0,
    "text": "همان ماه‌رخ بر دگر بارگی"
  },
  {
    "poem_id": 1693,
    "vorder": 50,
    "position": 1,
    "text": "نشستند و رفتند یکبارگی"
  },
  {
    "poem_id": 1693,
    "vorder": 51,
    "position": 0,
    "text": "از ایوان سوی پارس بنهاد روی"
  },
  {
    "poem_id": 1693,
    "vorder": 52,
    "position": 1,
    "text": "همی رفت شادان دل و راه‌جوی"
  }
]