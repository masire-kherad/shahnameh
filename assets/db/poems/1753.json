[
  {
    "poem_id": 1753,
    "vorder": 1,
    "position": 0,
    "text": "چو شد پادشا بر جهان یزدگرد"
  },
  {
    "poem_id": 1753,
    "vorder": 2,
    "position": 1,
    "text": "سپه را ز دشت اندرآورد گرد"
  },
  {
    "poem_id": 1753,
    "vorder": 3,
    "position": 0,
    "text": "کلاه برادر به سر بر نهاد"
  },
  {
    "poem_id": 1753,
    "vorder": 4,
    "position": 1,
    "text": "همی بود ازان مرگ ناشاد شاد"
  },
  {
    "poem_id": 1753,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت با نامداران شهر"
  },
  {
    "poem_id": 1753,
    "vorder": 6,
    "position": 1,
    "text": "که هرکس که از داد یابند بهر"
  },
  {
    "poem_id": 1753,
    "vorder": 7,
    "position": 0,
    "text": "نخست از نیایش به یزدان کنید"
  },
  {
    "poem_id": 1753,
    "vorder": 8,
    "position": 1,
    "text": "دل از داد ما شاد و خندان کنید"
  },
  {
    "poem_id": 1753,
    "vorder": 9,
    "position": 0,
    "text": "بدان را نمانم که دارند هوش"
  },
  {
    "poem_id": 1753,
    "vorder": 10,
    "position": 1,
    "text": "وگر دست یازند بد را بکوش"
  },
  {
    "poem_id": 1753,
    "vorder": 11,
    "position": 0,
    "text": "کسی کو بجوید ز ما راستی"
  },
  {
    "poem_id": 1753,
    "vorder": 12,
    "position": 1,
    "text": "بیارامد از کژی و کاستی"
  },
  {
    "poem_id": 1753,
    "vorder": 13,
    "position": 0,
    "text": "به هرجای جاه وی افزون کنیم"
  },
  {
    "poem_id": 1753,
    "vorder": 14,
    "position": 1,
    "text": "ز دل کینه و آز بیرون کنیم"
  },
  {
    "poem_id": 1753,
    "vorder": 15,
    "position": 0,
    "text": "سگالش نگوییم جز با ردان"
  },
  {
    "poem_id": 1753,
    "vorder": 16,
    "position": 1,
    "text": "خردمند و بیداردل موبدان"
  },
  {
    "poem_id": 1753,
    "vorder": 17,
    "position": 0,
    "text": "کسی را کجا پر ز آهو بود"
  },
  {
    "poem_id": 1753,
    "vorder": 18,
    "position": 1,
    "text": "روانش ز بیشی به نیرو بود"
  },
  {
    "poem_id": 1753,
    "vorder": 19,
    "position": 0,
    "text": "به بیچارگان بر ستم سازد اوی"
  },
  {
    "poem_id": 1753,
    "vorder": 20,
    "position": 1,
    "text": "گر از چیز درویش بفرازد اوی"
  },
  {
    "poem_id": 1753,
    "vorder": 21,
    "position": 0,
    "text": "بکوشیم و نیروش بیرون کنیم"
  },
  {
    "poem_id": 1753,
    "vorder": 22,
    "position": 1,
    "text": "به درویش ما نازش افزون کنیم"
  },
  {
    "poem_id": 1753,
    "vorder": 23,
    "position": 0,
    "text": "کسی کو بپرهیزد از خشم ما"
  },
  {
    "poem_id": 1753,
    "vorder": 24,
    "position": 1,
    "text": "همی بگذرد تیز بر چشم ما"
  },
  {
    "poem_id": 1753,
    "vorder": 25,
    "position": 0,
    "text": "همی بستر از خاک جوید تنش"
  },
  {
    "poem_id": 1753,
    "vorder": 26,
    "position": 1,
    "text": "همان خنجر هندوی گردنش"
  },
  {
    "poem_id": 1753,
    "vorder": 27,
    "position": 0,
    "text": "به فرمان ما چشم روشن کنید"
  },
  {
    "poem_id": 1753,
    "vorder": 28,
    "position": 1,
    "text": "خرد را به تن بر چو جوشن کنید"
  },
  {
    "poem_id": 1753,
    "vorder": 29,
    "position": 0,
    "text": "تن هرکسی گشت لرزان چو بید"
  },
  {
    "poem_id": 1753,
    "vorder": 30,
    "position": 1,
    "text": "که گوپال و شمشیرشان بد امید"
  },
  {
    "poem_id": 1753,
    "vorder": 31,
    "position": 0,
    "text": "چو شد بر جهان پادشاهیش راست"
  },
  {
    "poem_id": 1753,
    "vorder": 32,
    "position": 1,
    "text": "بزرگی فزون کرد و مهرش بکاست"
  },
  {
    "poem_id": 1753,
    "vorder": 33,
    "position": 0,
    "text": "خردمند نزدیک او خوار گشت"
  },
  {
    "poem_id": 1753,
    "vorder": 34,
    "position": 1,
    "text": "همه رسم شاهیش بیکار گشت"
  },
  {
    "poem_id": 1753,
    "vorder": 35,
    "position": 0,
    "text": "کنارنگ با پهلوان و ردان"
  },
  {
    "poem_id": 1753,
    "vorder": 36,
    "position": 1,
    "text": "همان دانشی پرخرد موبدان"
  },
  {
    "poem_id": 1753,
    "vorder": 37,
    "position": 0,
    "text": "یکی گشت با باد نزدیک اوی"
  },
  {
    "poem_id": 1753,
    "vorder": 38,
    "position": 1,
    "text": "جفا پیشه شد جان تاریک اوی"
  },
  {
    "poem_id": 1753,
    "vorder": 39,
    "position": 0,
    "text": "سترده شد از جان او مهر و داد"
  },
  {
    "poem_id": 1753,
    "vorder": 40,
    "position": 1,
    "text": "به هیچ آرزو نیز پاسخ نداد"
  },
  {
    "poem_id": 1753,
    "vorder": 41,
    "position": 0,
    "text": "کسی را نبد نزد او پایگاه"
  },
  {
    "poem_id": 1753,
    "vorder": 42,
    "position": 1,
    "text": "به ژرفی مکافات کردی گناه"
  },
  {
    "poem_id": 1753,
    "vorder": 43,
    "position": 0,
    "text": "هرانکس که دستور بد بر درش"
  },
  {
    "poem_id": 1753,
    "vorder": 44,
    "position": 1,
    "text": "فزایندهٔ اختر و افسرش"
  },
  {
    "poem_id": 1753,
    "vorder": 45,
    "position": 0,
    "text": "همه عهد کردند با یکدگر"
  },
  {
    "poem_id": 1753,
    "vorder": 46,
    "position": 1,
    "text": "که هرگز نگویند زان بوم و بر"
  },
  {
    "poem_id": 1753,
    "vorder": 47,
    "position": 0,
    "text": "همه یکسر از بیم پیچان شدند"
  },
  {
    "poem_id": 1753,
    "vorder": 48,
    "position": 1,
    "text": "ز هول شهنشاه بیجان شدند"
  },
  {
    "poem_id": 1753,
    "vorder": 49,
    "position": 0,
    "text": "فرستادگان آمدندی ز راه"
  },
  {
    "poem_id": 1753,
    "vorder": 50,
    "position": 1,
    "text": "همان زیردستان فریادخواه"
  },
  {
    "poem_id": 1753,
    "vorder": 51,
    "position": 0,
    "text": "چو دستور زان آگهی یافتی"
  },
  {
    "poem_id": 1753,
    "vorder": 52,
    "position": 1,
    "text": "بدان کارها تیز بشتافتی"
  },
  {
    "poem_id": 1753,
    "vorder": 53,
    "position": 0,
    "text": "به گفتار گرم و به آواز نرم"
  },
  {
    "poem_id": 1753,
    "vorder": 54,
    "position": 1,
    "text": "فرستاده را راه دادی به شرم"
  },
  {
    "poem_id": 1753,
    "vorder": 55,
    "position": 0,
    "text": "بگفتی که شاه از در کار نیست"
  },
  {
    "poem_id": 1753,
    "vorder": 56,
    "position": 1,
    "text": "شما را بدو راه دیدار نیست"
  },
  {
    "poem_id": 1753,
    "vorder": 57,
    "position": 0,
    "text": "نمودم بدو هرچ درخواستی"
  },
  {
    "poem_id": 1753,
    "vorder": 58,
    "position": 1,
    "text": "به فرمانش پیدا شد آن راستی"
  }
]