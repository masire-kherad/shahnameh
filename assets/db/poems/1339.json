[
  {
    "poem_id": 1339,
    "vorder": 1,
    "position": 0,
    "text": "چو بشناخت آهنگری پیشه کرد"
  },
  {
    "poem_id": 1339,
    "vorder": 2,
    "position": 1,
    "text": "از آهنگری ارّه و تیشه کرد"
  },
  {
    "poem_id": 1339,
    "vorder": 3,
    "position": 0,
    "text": "چو این کرده شد چارهٔ آب ساخت"
  },
  {
    "poem_id": 1339,
    "vorder": 4,
    "position": 1,
    "text": "ز دریای‌ها رودها را بتاخت"
  },
  {
    "poem_id": 1339,
    "vorder": 5,
    "position": 0,
    "text": "به جوی و به رود آب‌ها راه کرد"
  },
  {
    "poem_id": 1339,
    "vorder": 6,
    "position": 1,
    "text": "به فرخندگی رنج کوتاه کرد"
  },
  {
    "poem_id": 1339,
    "vorder": 7,
    "position": 0,
    "text": "چراگاه مردم بدان برفزود"
  },
  {
    "poem_id": 1339,
    "vorder": 8,
    "position": 1,
    "text": "پراگند پس تخم و کشت و درود"
  },
  {
    "poem_id": 1339,
    "vorder": 9,
    "position": 0,
    "text": "برنجید پس هر کسی نان خویش"
  },
  {
    "poem_id": 1339,
    "vorder": 10,
    "position": 1,
    "text": "بورزید و بشناخت سامان خویش"
  },
  {
    "poem_id": 1339,
    "vorder": 11,
    "position": 0,
    "text": "بدان ایزدی جاه و فرّ کیان"
  },
  {
    "poem_id": 1339,
    "vorder": 12,
    "position": 1,
    "text": "ز نخچیر گور و گوزن ژیان"
  },
  {
    "poem_id": 1339,
    "vorder": 13,
    "position": 0,
    "text": "جدا کرد گاو و خر و گوسفند"
  },
  {
    "poem_id": 1339,
    "vorder": 14,
    "position": 1,
    "text": "به ورز آورید آن‌چه بُد سودمند"
  },
  {
    "poem_id": 1339,
    "vorder": 15,
    "position": 0,
    "text": "ز پویندگان هر چه مویش نکوست"
  },
  {
    "poem_id": 1339,
    "vorder": 16,
    "position": 1,
    "text": "بکشت و به سرشان برآهیخت پوست"
  },
  {
    "poem_id": 1339,
    "vorder": 17,
    "position": 0,
    "text": "چو روباه و قاقم چو سنجاب نرم"
  },
  {
    "poem_id": 1339,
    "vorder": 18,
    "position": 1,
    "text": "چهارم سمور است کش موی گرم"
  },
  {
    "poem_id": 1339,
    "vorder": 19,
    "position": 0,
    "text": "بر این گونه از چرم پویندگان"
  },
  {
    "poem_id": 1339,
    "vorder": 20,
    "position": 1,
    "text": "بپوشید بالای گویندگان"
  },
  {
    "poem_id": 1339,
    "vorder": 21,
    "position": 0,
    "text": "برنجید و گسترد و خورد و سپرد"
  },
  {
    "poem_id": 1339,
    "vorder": 22,
    "position": 1,
    "text": "برفت و به جز نام نیکی نبرد"
  },
  {
    "poem_id": 1339,
    "vorder": 23,
    "position": 0,
    "text": "بسی رنج برد اندر آن روزگار"
  },
  {
    "poem_id": 1339,
    "vorder": 24,
    "position": 1,
    "text": "به افسون و اندیشهٔ بی‌شمار"
  },
  {
    "poem_id": 1339,
    "vorder": 25,
    "position": 0,
    "text": "چو پیش آمدش روزگار بهی"
  },
  {
    "poem_id": 1339,
    "vorder": 26,
    "position": 1,
    "text": "از او مردری ماند تخت مهی"
  },
  {
    "poem_id": 1339,
    "vorder": 27,
    "position": 0,
    "text": "زمانه ندادش زمانی درنگ"
  },
  {
    "poem_id": 1339,
    "vorder": 28,
    "position": 1,
    "text": "شد آن هوش هوشنگ با فرّ و سنگ"
  },
  {
    "poem_id": 1339,
    "vorder": 29,
    "position": 0,
    "text": "نه پیوست خواهد جهان با تو مهر"
  },
  {
    "poem_id": 1339,
    "vorder": 30,
    "position": 1,
    "text": "نه نیز آشکارا نمایدت چهر"
  }
]