[
  {
    "poem_id": 1563,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا پیش او گرگسار"
  },
  {
    "poem_id": 1563,
    "vorder": 2,
    "position": 1,
    "text": "بیامد بداندیش و بد روزگار"
  },
  {
    "poem_id": 1563,
    "vorder": 3,
    "position": 0,
    "text": "سه جام می لعل فامش بداد"
  },
  {
    "poem_id": 1563,
    "vorder": 4,
    "position": 1,
    "text": "چو آهرمن از جام می گشت شاد"
  },
  {
    "poem_id": 1563,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کای مرد بدبخت خوار"
  },
  {
    "poem_id": 1563,
    "vorder": 6,
    "position": 1,
    "text": "که فردا چه پیش آورد روزگار"
  },
  {
    "poem_id": 1563,
    "vorder": 7,
    "position": 0,
    "text": "بدو گفت کای شاه برتر منش"
  },
  {
    "poem_id": 1563,
    "vorder": 8,
    "position": 1,
    "text": "ز تو دور بادا بد بدکنش"
  },
  {
    "poem_id": 1563,
    "vorder": 9,
    "position": 0,
    "text": "چو آتش به پیکار بشتافتی"
  },
  {
    "poem_id": 1563,
    "vorder": 10,
    "position": 1,
    "text": "چنین بر بلاها گذر یافتی"
  },
  {
    "poem_id": 1563,
    "vorder": 11,
    "position": 0,
    "text": "ندانی که فردا چه آیدت پیش"
  },
  {
    "poem_id": 1563,
    "vorder": 12,
    "position": 1,
    "text": "ببخشای بر بخت بیدار خویش"
  },
  {
    "poem_id": 1563,
    "vorder": 13,
    "position": 0,
    "text": "از ایدر چو فردا به منزل رسی"
  },
  {
    "poem_id": 1563,
    "vorder": 14,
    "position": 1,
    "text": "یکی کار پیش است از این یک بسی"
  },
  {
    "poem_id": 1563,
    "vorder": 15,
    "position": 0,
    "text": "یکی اژدها پیشت آید دژم"
  },
  {
    "poem_id": 1563,
    "vorder": 16,
    "position": 1,
    "text": "که ماهی برآرد ز دریا به دم"
  },
  {
    "poem_id": 1563,
    "vorder": 17,
    "position": 0,
    "text": "همی آتش افروزد از کام اوی"
  },
  {
    "poem_id": 1563,
    "vorder": 18,
    "position": 1,
    "text": "یکی کوه خاراست اندام اوی"
  },
  {
    "poem_id": 1563,
    "vorder": 19,
    "position": 0,
    "text": "از این راه گر بازگردی رواست"
  },
  {
    "poem_id": 1563,
    "vorder": 20,
    "position": 1,
    "text": "روانت بر این پند من بر گواست"
  },
  {
    "poem_id": 1563,
    "vorder": 21,
    "position": 0,
    "text": "دریغت نیاید همی خویشتن"
  },
  {
    "poem_id": 1563,
    "vorder": 22,
    "position": 1,
    "text": "سپاهی شده ز این نشان انجمن"
  },
  {
    "poem_id": 1563,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد پاسخ که ای بدنشان"
  },
  {
    "poem_id": 1563,
    "vorder": 24,
    "position": 1,
    "text": "به بندت همی برد خواهم کشان"
  },
  {
    "poem_id": 1563,
    "vorder": 25,
    "position": 0,
    "text": "ببینی که از چنگ من اژدها"
  },
  {
    "poem_id": 1563,
    "vorder": 26,
    "position": 1,
    "text": "ز شمشیر تیزم نیابد رها"
  },
  {
    "poem_id": 1563,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود تا درگران آورند"
  },
  {
    "poem_id": 1563,
    "vorder": 28,
    "position": 1,
    "text": "سزاوار چوب گران آورند"
  },
  {
    "poem_id": 1563,
    "vorder": 29,
    "position": 0,
    "text": "یکی نغز گردون چوبین بساخت"
  },
  {
    "poem_id": 1563,
    "vorder": 30,
    "position": 1,
    "text": "به گرد اندرش تیغها در نشاخت"
  },
  {
    "poem_id": 1563,
    "vorder": 31,
    "position": 0,
    "text": "به سر بر یکی گرد صندوق نغز"
  },
  {
    "poem_id": 1563,
    "vorder": 32,
    "position": 1,
    "text": "بیاراست آن درگر پاک مغز"
  },
  {
    "poem_id": 1563,
    "vorder": 33,
    "position": 0,
    "text": "به صندوق در مرد دیهیم جوی"
  },
  {
    "poem_id": 1563,
    "vorder": 34,
    "position": 1,
    "text": "دو اسپ گرانمایه بست اندر اوی"
  },
  {
    "poem_id": 1563,
    "vorder": 35,
    "position": 0,
    "text": "نشست آزمون را به صندوق شاه"
  },
  {
    "poem_id": 1563,
    "vorder": 36,
    "position": 1,
    "text": "زمانی همی راند اسپان به راه"
  },
  {
    "poem_id": 1563,
    "vorder": 37,
    "position": 0,
    "text": "زره‌دار با خنجر کابلی"
  },
  {
    "poem_id": 1563,
    "vorder": 38,
    "position": 1,
    "text": "به سر بر نهاده کلاه یلی"
  },
  {
    "poem_id": 1563,
    "vorder": 39,
    "position": 0,
    "text": "چو شد جنگ آن اژدها ساخته"
  },
  {
    "poem_id": 1563,
    "vorder": 40,
    "position": 1,
    "text": "جهانجوی ز این رنج پرداخته"
  },
  {
    "poem_id": 1563,
    "vorder": 41,
    "position": 0,
    "text": "جهان گشت چون روی زنگی سیاه"
  },
  {
    "poem_id": 1563,
    "vorder": 42,
    "position": 1,
    "text": "ز برج حمل تاج بنمود ماه"
  },
  {
    "poem_id": 1563,
    "vorder": 43,
    "position": 0,
    "text": "نشست از بر شولک اسفندیار"
  },
  {
    "poem_id": 1563,
    "vorder": 44,
    "position": 1,
    "text": "برفت از پسش لشکر نامدار"
  },
  {
    "poem_id": 1563,
    "vorder": 45,
    "position": 0,
    "text": "دگر روز چون گشت روشن جهان"
  },
  {
    "poem_id": 1563,
    "vorder": 46,
    "position": 1,
    "text": "درفش شب تیره شد در نهان"
  },
  {
    "poem_id": 1563,
    "vorder": 47,
    "position": 0,
    "text": "پشوتن بیامد سوی نامجوی"
  },
  {
    "poem_id": 1563,
    "vorder": 48,
    "position": 1,
    "text": "پسر با برادر همی پیش اوی"
  },
  {
    "poem_id": 1563,
    "vorder": 49,
    "position": 0,
    "text": "بپوشید خفتان جهاندار گرد"
  },
  {
    "poem_id": 1563,
    "vorder": 50,
    "position": 1,
    "text": "سپه را به فرخ پشوتن سپرد"
  },
  {
    "poem_id": 1563,
    "vorder": 51,
    "position": 0,
    "text": "بیاورد گردون و صندوق شیر"
  },
  {
    "poem_id": 1563,
    "vorder": 52,
    "position": 1,
    "text": "نشست اندر او شهریار دلیر"
  },
  {
    "poem_id": 1563,
    "vorder": 53,
    "position": 0,
    "text": "دو اسپ گرانمایه بسته بر اوی"
  },
  {
    "poem_id": 1563,
    "vorder": 54,
    "position": 1,
    "text": "سوی اژدها تیز بنهاد روی"
  },
  {
    "poem_id": 1563,
    "vorder": 55,
    "position": 0,
    "text": "ز دور اژدها بانگ گردون شنید"
  },
  {
    "poem_id": 1563,
    "vorder": 56,
    "position": 1,
    "text": "خرامیدن اسپ جنگی بدید"
  },
  {
    "poem_id": 1563,
    "vorder": 57,
    "position": 0,
    "text": "ز جای اندر آمد چو کوه سیاه"
  },
  {
    "poem_id": 1563,
    "vorder": 58,
    "position": 1,
    "text": "تو گفتی که تاریک شد چرخ و ماه"
  },
  {
    "poem_id": 1563,
    "vorder": 59,
    "position": 0,
    "text": "دو چشمش چو دو چشمه تابان ز خون"
  },
  {
    "poem_id": 1563,
    "vorder": 60,
    "position": 1,
    "text": "همی آتش آمد ز کامش برون"
  },
  {
    "poem_id": 1563,
    "vorder": 61,
    "position": 0,
    "text": "چو اسفندیار آن شگفتی بدید"
  },
  {
    "poem_id": 1563,
    "vorder": 62,
    "position": 1,
    "text": "به یزدان پناهید و دم درکشید"
  },
  {
    "poem_id": 1563,
    "vorder": 63,
    "position": 0,
    "text": "همی جست اسپ از گزندش رها"
  },
  {
    "poem_id": 1563,
    "vorder": 64,
    "position": 1,
    "text": "به دم درکشید اسپ را اژدها"
  },
  {
    "poem_id": 1563,
    "vorder": 65,
    "position": 0,
    "text": "دهن باز کرده چو کوهی سیاه"
  },
  {
    "poem_id": 1563,
    "vorder": 66,
    "position": 1,
    "text": "همی کرد غران بدو در نگاه"
  },
  {
    "poem_id": 1563,
    "vorder": 67,
    "position": 0,
    "text": "فرو برد اسپان و گردون به دم"
  },
  {
    "poem_id": 1563,
    "vorder": 68,
    "position": 1,
    "text": "به صندوق در گشت جنگی دژم"
  },
  {
    "poem_id": 1563,
    "vorder": 69,
    "position": 0,
    "text": "به کامش چو تیغ اندر آمد بماند"
  },
  {
    "poem_id": 1563,
    "vorder": 70,
    "position": 1,
    "text": "چو دریای خون از دهان برفشاند"
  },
  {
    "poem_id": 1563,
    "vorder": 71,
    "position": 0,
    "text": "نه بیرون توانست کردن ز کام"
  },
  {
    "poem_id": 1563,
    "vorder": 72,
    "position": 1,
    "text": "چو شمشیر بد تیغ و کامش نیام"
  },
  {
    "poem_id": 1563,
    "vorder": 73,
    "position": 0,
    "text": "ز گردون و آن تیغها شد غمی"
  },
  {
    "poem_id": 1563,
    "vorder": 74,
    "position": 1,
    "text": "به زور اندر آورد لختی کمی"
  },
  {
    "poem_id": 1563,
    "vorder": 75,
    "position": 0,
    "text": "برآمد ز صندوق مرد دلیر"
  },
  {
    "poem_id": 1563,
    "vorder": 76,
    "position": 1,
    "text": "یکی تیز شمشیر در چنگ شیر"
  },
  {
    "poem_id": 1563,
    "vorder": 77,
    "position": 0,
    "text": "به شمشیر مغزش همی کرد چاک"
  },
  {
    "poem_id": 1563,
    "vorder": 78,
    "position": 1,
    "text": "همی دود زهرش برآمد ز خاک"
  },
  {
    "poem_id": 1563,
    "vorder": 79,
    "position": 0,
    "text": "از آن دود برنده بیهوش گشت"
  },
  {
    "poem_id": 1563,
    "vorder": 80,
    "position": 1,
    "text": "بیفتاد و بی‌مغز و بی‌توش گشت"
  },
  {
    "poem_id": 1563,
    "vorder": 81,
    "position": 0,
    "text": "پشوتن بیامد هم اندر زمان"
  },
  {
    "poem_id": 1563,
    "vorder": 82,
    "position": 1,
    "text": "به نزدیک آن نامدار جهان"
  },
  {
    "poem_id": 1563,
    "vorder": 83,
    "position": 0,
    "text": "جهانجوی چون چشمها باز کرد"
  },
  {
    "poem_id": 1563,
    "vorder": 84,
    "position": 1,
    "text": "به گردان گردنکش آواز کرد"
  },
  {
    "poem_id": 1563,
    "vorder": 85,
    "position": 0,
    "text": "که بیهوش گشتم من از دود زهر"
  },
  {
    "poem_id": 1563,
    "vorder": 86,
    "position": 1,
    "text": "ز زخمش نیامد مرا هیچ بهر"
  },
  {
    "poem_id": 1563,
    "vorder": 87,
    "position": 0,
    "text": "از آن خاک برخاست و شد سوی آب"
  },
  {
    "poem_id": 1563,
    "vorder": 88,
    "position": 1,
    "text": "چو مردی که بیهوش گردد به خواب"
  },
  {
    "poem_id": 1563,
    "vorder": 89,
    "position": 0,
    "text": "ز گنجور خود جامهٔ نو بجست"
  },
  {
    "poem_id": 1563,
    "vorder": 90,
    "position": 1,
    "text": "به آب اندر آمد سر و تن بشست"
  },
  {
    "poem_id": 1563,
    "vorder": 91,
    "position": 0,
    "text": "بیامد به پیش خداوند پاک"
  },
  {
    "poem_id": 1563,
    "vorder": 92,
    "position": 1,
    "text": "همی گشت پیچان و گریان به خاک"
  },
  {
    "poem_id": 1563,
    "vorder": 93,
    "position": 0,
    "text": "همی گفت کاین اژدها را که کشت"
  },
  {
    "poem_id": 1563,
    "vorder": 94,
    "position": 1,
    "text": "مگر آن که بودش جهاندار پشت"
  },
  {
    "poem_id": 1563,
    "vorder": 95,
    "position": 0,
    "text": "سپاهش همه خواندند آفرین"
  },
  {
    "poem_id": 1563,
    "vorder": 96,
    "position": 1,
    "text": "همه پیش دادار سر بر زمین"
  },
  {
    "poem_id": 1563,
    "vorder": 97,
    "position": 0,
    "text": "نهادند و گفتند با کردگار"
  },
  {
    "poem_id": 1563,
    "vorder": 98,
    "position": 1,
    "text": "توی پاک و بی‌عیب و پروردگار"
  }
]