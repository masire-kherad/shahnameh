[
  {
    "poem_id": 1697,
    "vorder": 1,
    "position": 0,
    "text": "یکی نامور بود نامش سباک"
  },
  {
    "poem_id": 1697,
    "vorder": 2,
    "position": 1,
    "text": "ابا آلت و لشکر و رای پاک"
  },
  {
    "poem_id": 1697,
    "vorder": 3,
    "position": 0,
    "text": "که در شهر جهرم بد او پادشا"
  },
  {
    "poem_id": 1697,
    "vorder": 4,
    "position": 1,
    "text": "جهاندیده با داد و فرمانروا"
  },
  {
    "poem_id": 1697,
    "vorder": 5,
    "position": 0,
    "text": "مر او را خجسته پسر بود هفت"
  },
  {
    "poem_id": 1697,
    "vorder": 6,
    "position": 1,
    "text": "چو آگه شد از پیش بهمن برفت"
  },
  {
    "poem_id": 1697,
    "vorder": 7,
    "position": 0,
    "text": "ز جهرم بیامد سوی اردشیر"
  },
  {
    "poem_id": 1697,
    "vorder": 8,
    "position": 1,
    "text": "ابا لشکر و کوس و با دار و گیر"
  },
  {
    "poem_id": 1697,
    "vorder": 9,
    "position": 0,
    "text": "چو چشمش به روی سپهبد رسید"
  },
  {
    "poem_id": 1697,
    "vorder": 10,
    "position": 1,
    "text": "ز باره درآمد چنانچون سزید"
  },
  {
    "poem_id": 1697,
    "vorder": 11,
    "position": 0,
    "text": "بیامد دمان پای او بوس داد"
  },
  {
    "poem_id": 1697,
    "vorder": 12,
    "position": 1,
    "text": "ز ساسانیان بیشتر کرد یاد"
  },
  {
    "poem_id": 1697,
    "vorder": 13,
    "position": 0,
    "text": "فراوان جهانجوی بنواختش"
  },
  {
    "poem_id": 1697,
    "vorder": 14,
    "position": 1,
    "text": "به زود آمدن ارج بشناختش"
  },
  {
    "poem_id": 1697,
    "vorder": 15,
    "position": 0,
    "text": "پراندیشه شد نامجوی از سباک"
  },
  {
    "poem_id": 1697,
    "vorder": 16,
    "position": 1,
    "text": "دلش گشت زان پیر پر بیم و باک"
  },
  {
    "poem_id": 1697,
    "vorder": 17,
    "position": 0,
    "text": "به راه اندرون نیز آژیر بود"
  },
  {
    "poem_id": 1697,
    "vorder": 18,
    "position": 1,
    "text": "که با او سپاه جهانگیر بود"
  },
  {
    "poem_id": 1697,
    "vorder": 19,
    "position": 0,
    "text": "جهاندیده بیدار دل بود پیر"
  },
  {
    "poem_id": 1697,
    "vorder": 20,
    "position": 1,
    "text": "بدانست اندیشهٔ اردشیر"
  },
  {
    "poem_id": 1697,
    "vorder": 21,
    "position": 0,
    "text": "بیامد بیاورد استا و زند"
  },
  {
    "poem_id": 1697,
    "vorder": 22,
    "position": 1,
    "text": "چنین گفت کز کردگار بلند"
  },
  {
    "poem_id": 1697,
    "vorder": 23,
    "position": 0,
    "text": "نژندست پرمایه جان سباک"
  },
  {
    "poem_id": 1697,
    "vorder": 24,
    "position": 1,
    "text": "اگر دل ندارد سوی شاه پاک"
  },
  {
    "poem_id": 1697,
    "vorder": 25,
    "position": 0,
    "text": "چو آگاهی آمد ز شاه اردشیر"
  },
  {
    "poem_id": 1697,
    "vorder": 26,
    "position": 1,
    "text": "که آورد لشکر بدین آبگیر"
  },
  {
    "poem_id": 1697,
    "vorder": 27,
    "position": 0,
    "text": "چنان سیر سر گشتم از اردوان"
  },
  {
    "poem_id": 1697,
    "vorder": 28,
    "position": 1,
    "text": "که از پیرزن گشت مرد جوان"
  },
  {
    "poem_id": 1697,
    "vorder": 29,
    "position": 0,
    "text": "مرا نیک‌پی مهربان بنده‌دان"
  },
  {
    "poem_id": 1697,
    "vorder": 30,
    "position": 1,
    "text": "شکیبادل و راز داننده دان"
  },
  {
    "poem_id": 1697,
    "vorder": 31,
    "position": 0,
    "text": "چو بشنید زو اردشیر این سخن"
  },
  {
    "poem_id": 1697,
    "vorder": 32,
    "position": 1,
    "text": "یکی دیگر اندیشه افگند بن"
  },
  {
    "poem_id": 1697,
    "vorder": 33,
    "position": 0,
    "text": "مر او را به جای پدر داشتی"
  },
  {
    "poem_id": 1697,
    "vorder": 34,
    "position": 1,
    "text": "بران نامدارانش سر داشتی"
  },
  {
    "poem_id": 1697,
    "vorder": 35,
    "position": 0,
    "text": "دل شاه ز اندیشه آزاد شد"
  },
  {
    "poem_id": 1697,
    "vorder": 36,
    "position": 1,
    "text": "سوی آذر رام خراد شد"
  },
  {
    "poem_id": 1697,
    "vorder": 37,
    "position": 0,
    "text": "نیایش بسی کرد پیش خدای"
  },
  {
    "poem_id": 1697,
    "vorder": 38,
    "position": 1,
    "text": "که باشدش بر نیکوی رهنمای"
  },
  {
    "poem_id": 1697,
    "vorder": 39,
    "position": 0,
    "text": "به هر کار پیروزگر داردش"
  },
  {
    "poem_id": 1697,
    "vorder": 40,
    "position": 1,
    "text": "درخت بزرگی به بر داردش"
  },
  {
    "poem_id": 1697,
    "vorder": 41,
    "position": 0,
    "text": "وزان جایگه شد به پرده‌سرای"
  },
  {
    "poem_id": 1697,
    "vorder": 42,
    "position": 1,
    "text": "عرض پیش او رفت با کدخدای"
  },
  {
    "poem_id": 1697,
    "vorder": 43,
    "position": 0,
    "text": "سپه را درم داد و آباد کرد"
  },
  {
    "poem_id": 1697,
    "vorder": 44,
    "position": 1,
    "text": "ز دادار نیکی دهش یاد کرد"
  },
  {
    "poem_id": 1697,
    "vorder": 45,
    "position": 0,
    "text": "چو شد لشکرش چون دلاور پلنگ"
  },
  {
    "poem_id": 1697,
    "vorder": 46,
    "position": 1,
    "text": "سوی بهمن اردوان شد به جنگ"
  },
  {
    "poem_id": 1697,
    "vorder": 47,
    "position": 0,
    "text": "چو گشتند نزدیک با یکدگر"
  },
  {
    "poem_id": 1697,
    "vorder": 48,
    "position": 1,
    "text": "برفتند گردان پرخاشخر"
  },
  {
    "poem_id": 1697,
    "vorder": 49,
    "position": 0,
    "text": "سپاه از دو رویه کشیدند صف"
  },
  {
    "poem_id": 1697,
    "vorder": 50,
    "position": 1,
    "text": "همه نیزه و تیغ هندی به کف"
  },
  {
    "poem_id": 1697,
    "vorder": 51,
    "position": 0,
    "text": "چو شیران جنگی برآویختند"
  },
  {
    "poem_id": 1697,
    "vorder": 52,
    "position": 1,
    "text": "چو جوی روان خون همی ریختند"
  },
  {
    "poem_id": 1697,
    "vorder": 53,
    "position": 0,
    "text": "بدین گونه تا گشت خورشید زرد"
  },
  {
    "poem_id": 1697,
    "vorder": 54,
    "position": 1,
    "text": "هوا پر ز گرد و زمین پر ز مرد"
  },
  {
    "poem_id": 1697,
    "vorder": 55,
    "position": 0,
    "text": "چو شد چادر چرخ پیروزه‌رنگ"
  },
  {
    "poem_id": 1697,
    "vorder": 56,
    "position": 1,
    "text": "سپاه سباک اندر آمد به جنگ"
  },
  {
    "poem_id": 1697,
    "vorder": 57,
    "position": 0,
    "text": "برآمد یکی باد و گردی چو قیر"
  },
  {
    "poem_id": 1697,
    "vorder": 58,
    "position": 1,
    "text": "بیامد ز قلب سپاه اردشیر"
  },
  {
    "poem_id": 1697,
    "vorder": 59,
    "position": 0,
    "text": "بیفگند زیشان فراوان به گرز"
  },
  {
    "poem_id": 1697,
    "vorder": 60,
    "position": 1,
    "text": "که با زور و دل بود و با فر و برز"
  },
  {
    "poem_id": 1697,
    "vorder": 61,
    "position": 0,
    "text": "گریزان بشد بهمن اردوان"
  },
  {
    "poem_id": 1697,
    "vorder": 62,
    "position": 1,
    "text": "تنش خستهٔ تیر و تیره‌روان"
  },
  {
    "poem_id": 1697,
    "vorder": 63,
    "position": 0,
    "text": "پس‌اندر همی تاخت شاه اردشیر"
  },
  {
    "poem_id": 1697,
    "vorder": 64,
    "position": 1,
    "text": "ابا نالهٔ بوق و باران تیر"
  },
  {
    "poem_id": 1697,
    "vorder": 65,
    "position": 0,
    "text": "برین هم نشان تا به شهر صطخر"
  },
  {
    "poem_id": 1697,
    "vorder": 66,
    "position": 1,
    "text": "که بهمن بدو داشت آواز و فخر"
  },
  {
    "poem_id": 1697,
    "vorder": 67,
    "position": 0,
    "text": "ز گیتی چو برخاست آواز شاه"
  },
  {
    "poem_id": 1697,
    "vorder": 68,
    "position": 1,
    "text": "ز هر سو بپیوست بی‌مر سپاه"
  },
  {
    "poem_id": 1697,
    "vorder": 69,
    "position": 0,
    "text": "مر او را فراوان نمودند گنج"
  },
  {
    "poem_id": 1697,
    "vorder": 70,
    "position": 1,
    "text": "کجا بهمن آگنده بود آن به رنج"
  },
  {
    "poem_id": 1697,
    "vorder": 71,
    "position": 0,
    "text": "درمهای آگنده را برفشاند"
  },
  {
    "poem_id": 1697,
    "vorder": 72,
    "position": 1,
    "text": "به نیرو شد از پارس لشکر براند"
  }
]