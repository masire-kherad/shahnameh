[
  {
    "poem_id": 88081,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد به افراسیاب"
  },
  {
    "poem_id": 88081,
    "vorder": 2,
    "position": 1,
    "text": "که شاه جهاندار بگذاشت آب"
  },
  {
    "poem_id": 88081,
    "vorder": 3,
    "position": 0,
    "text": "شنیده همی داشت اندر نهفت"
  },
  {
    "poem_id": 88081,
    "vorder": 4,
    "position": 1,
    "text": "بیامد شب تیره با کس نگفت"
  },
  {
    "poem_id": 88081,
    "vorder": 5,
    "position": 0,
    "text": "جهاندیدگان را هم آنجا بماند"
  },
  {
    "poem_id": 88081,
    "vorder": 6,
    "position": 1,
    "text": "دلی پر ز تیمار تنها براند"
  },
  {
    "poem_id": 88081,
    "vorder": 7,
    "position": 0,
    "text": "چو کیخسرو آمد به گنگ اندرون"
  },
  {
    "poem_id": 88081,
    "vorder": 8,
    "position": 1,
    "text": "سری پر ز تیمار دل پر ز خون"
  },
  {
    "poem_id": 88081,
    "vorder": 9,
    "position": 0,
    "text": "بدید آن دل افروز باغ بهشت"
  },
  {
    "poem_id": 88081,
    "vorder": 10,
    "position": 1,
    "text": "شمرهای او چون چراغ بهشت"
  },
  {
    "poem_id": 88081,
    "vorder": 11,
    "position": 0,
    "text": "به هر گوشه‌ای چشمه و گلستان"
  },
  {
    "poem_id": 88081,
    "vorder": 12,
    "position": 1,
    "text": "زمین سنبل و شاخ بلبلستان"
  },
  {
    "poem_id": 88081,
    "vorder": 13,
    "position": 0,
    "text": "همی گفت هر کس که اینت نهاد"
  },
  {
    "poem_id": 88081,
    "vorder": 14,
    "position": 1,
    "text": "هم ایدر بباشیم تا مرگ شاد"
  },
  {
    "poem_id": 88081,
    "vorder": 15,
    "position": 0,
    "text": "وز آن پس بفرمود بیدار شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 16,
    "position": 1,
    "text": "طلب کردن شاه توران سپاه"
  },
  {
    "poem_id": 88081,
    "vorder": 17,
    "position": 0,
    "text": "بجستند بر دشت و باغ و سرای"
  },
  {
    "poem_id": 88081,
    "vorder": 18,
    "position": 1,
    "text": "گرفتند بر هر سوی رهنمای"
  },
  {
    "poem_id": 88081,
    "vorder": 19,
    "position": 0,
    "text": "همی رفت جوینده چون بیهشان"
  },
  {
    "poem_id": 88081,
    "vorder": 20,
    "position": 1,
    "text": "مگر زو بیابند جایی نشان"
  },
  {
    "poem_id": 88081,
    "vorder": 21,
    "position": 0,
    "text": "چو بر جستنش تیز بشتافتند"
  },
  {
    "poem_id": 88081,
    "vorder": 22,
    "position": 1,
    "text": "فراوان ز کسهای او یافتند"
  },
  {
    "poem_id": 88081,
    "vorder": 23,
    "position": 0,
    "text": "بکشتند بسیار کس بی‌گناه"
  },
  {
    "poem_id": 88081,
    "vorder": 24,
    "position": 1,
    "text": "نشانی نیامد ز بیداد شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 25,
    "position": 0,
    "text": "همی بود در گنگ دژ شهریار"
  },
  {
    "poem_id": 88081,
    "vorder": 26,
    "position": 1,
    "text": "یکی سال با رامش و میگسار"
  },
  {
    "poem_id": 88081,
    "vorder": 27,
    "position": 0,
    "text": "جهان چون بهشتی دلاویز بود"
  },
  {
    "poem_id": 88081,
    "vorder": 28,
    "position": 1,
    "text": "پر از گلشن و باغ و پالیز بود"
  },
  {
    "poem_id": 88081,
    "vorder": 29,
    "position": 0,
    "text": "برفتن همی شاه را دل نداد"
  },
  {
    "poem_id": 88081,
    "vorder": 30,
    "position": 1,
    "text": "همی بود در گنگ پیروز و شاد"
  },
  {
    "poem_id": 88081,
    "vorder": 31,
    "position": 0,
    "text": "همه پهلوانان ایران سپاه"
  },
  {
    "poem_id": 88081,
    "vorder": 32,
    "position": 1,
    "text": "برفتند یکسر به نزدیک شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 33,
    "position": 0,
    "text": "که گر شاه را دل نجنبد ز جای"
  },
  {
    "poem_id": 88081,
    "vorder": 34,
    "position": 1,
    "text": "سوی شهر ایران نیایدش رای"
  },
  {
    "poem_id": 88081,
    "vorder": 35,
    "position": 0,
    "text": "همانا بداندیش افراسیاب"
  },
  {
    "poem_id": 88081,
    "vorder": 36,
    "position": 1,
    "text": "گذشته‌ست زان سو به دریای آب"
  },
  {
    "poem_id": 88081,
    "vorder": 37,
    "position": 0,
    "text": "چنان پیر بر گاه کاووس شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 38,
    "position": 1,
    "text": "نه اورنگ و فر و نه گنج و سپاه"
  },
  {
    "poem_id": 88081,
    "vorder": 39,
    "position": 0,
    "text": "گر او سوی ایران شود پر ز کین"
  },
  {
    "poem_id": 88081,
    "vorder": 40,
    "position": 1,
    "text": "که باشد نگهبان ایران زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 41,
    "position": 0,
    "text": "گر او باز با تخت و افسر شود"
  },
  {
    "poem_id": 88081,
    "vorder": 42,
    "position": 1,
    "text": "همه رنج ما پاک بی‌بر شود"
  },
  {
    "poem_id": 88081,
    "vorder": 43,
    "position": 0,
    "text": "از آن پس به ایرانیان شاه گفت"
  },
  {
    "poem_id": 88081,
    "vorder": 44,
    "position": 1,
    "text": "که این پند با سودمندیست جفت"
  },
  {
    "poem_id": 88081,
    "vorder": 45,
    "position": 0,
    "text": "از آن شارستان پس مهان را بخواند"
  },
  {
    "poem_id": 88081,
    "vorder": 46,
    "position": 1,
    "text": "وز آن رنج بردن فراوان براند"
  },
  {
    "poem_id": 88081,
    "vorder": 47,
    "position": 0,
    "text": "از ایشان کسی را که شایسته‌تر"
  },
  {
    "poem_id": 88081,
    "vorder": 48,
    "position": 1,
    "text": "گرامی‌تر از شهر و بایسته‌تر"
  },
  {
    "poem_id": 88081,
    "vorder": 49,
    "position": 0,
    "text": "تنش را به خلعت بیاراستند"
  },
  {
    "poem_id": 88081,
    "vorder": 50,
    "position": 1,
    "text": "ز دژ بارهٔ مرزبان خواستند"
  },
  {
    "poem_id": 88081,
    "vorder": 51,
    "position": 0,
    "text": "چنین گفت کایدر به شادی بمان"
  },
  {
    "poem_id": 88081,
    "vorder": 52,
    "position": 1,
    "text": "ز دل بر کن اندیشهٔ بدگمان"
  },
  {
    "poem_id": 88081,
    "vorder": 53,
    "position": 0,
    "text": "ببخشید چندان که بد خواسته"
  },
  {
    "poem_id": 88081,
    "vorder": 54,
    "position": 1,
    "text": "ز اسبان وز گنج آراسته"
  },
  {
    "poem_id": 88081,
    "vorder": 55,
    "position": 0,
    "text": "همه شهر ز ایشان توانگر شدند"
  },
  {
    "poem_id": 88081,
    "vorder": 56,
    "position": 1,
    "text": "چه با یاره و تخت و افسر شدند"
  },
  {
    "poem_id": 88081,
    "vorder": 57,
    "position": 0,
    "text": "بدانگه که بیدار گردد خروس"
  },
  {
    "poem_id": 88081,
    "vorder": 58,
    "position": 1,
    "text": "ز درگاه برخاست آوای کوس"
  },
  {
    "poem_id": 88081,
    "vorder": 59,
    "position": 0,
    "text": "سپاهی شتابنده و راه‌جوی"
  },
  {
    "poem_id": 88081,
    "vorder": 60,
    "position": 1,
    "text": "به سوی بیابان نهادند روی"
  },
  {
    "poem_id": 88081,
    "vorder": 61,
    "position": 0,
    "text": "همه نامداران هر کشوری"
  },
  {
    "poem_id": 88081,
    "vorder": 62,
    "position": 1,
    "text": "برفتند هر جا که بد مهتری"
  },
  {
    "poem_id": 88081,
    "vorder": 63,
    "position": 0,
    "text": "خورشها ببردند نزدیک شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 64,
    "position": 1,
    "text": "که بود از در شهریار و سپاه"
  },
  {
    "poem_id": 88081,
    "vorder": 65,
    "position": 0,
    "text": "به راهی که لشکر همی برگذشت"
  },
  {
    "poem_id": 88081,
    "vorder": 66,
    "position": 1,
    "text": "در و دشت یکسر چو بازار گشت"
  },
  {
    "poem_id": 88081,
    "vorder": 67,
    "position": 0,
    "text": "به کوه و بیابان و جای نشست"
  },
  {
    "poem_id": 88081,
    "vorder": 68,
    "position": 1,
    "text": "کسی را نبد کس که بگشاد دست"
  },
  {
    "poem_id": 88081,
    "vorder": 69,
    "position": 0,
    "text": "بزرگان ابا هدیه و با نثار"
  },
  {
    "poem_id": 88081,
    "vorder": 70,
    "position": 1,
    "text": "پذیره شدندی بر شهریار"
  },
  {
    "poem_id": 88081,
    "vorder": 71,
    "position": 0,
    "text": "چو خلعت فراز آمدیشان ز گنج"
  },
  {
    "poem_id": 88081,
    "vorder": 72,
    "position": 1,
    "text": "نهشتی که با او برفتی به رنج"
  },
  {
    "poem_id": 88081,
    "vorder": 73,
    "position": 0,
    "text": "پذیره شدش گیو با لشکری"
  },
  {
    "poem_id": 88081,
    "vorder": 74,
    "position": 1,
    "text": "و زآن شهر هر کس که بد مهتری"
  },
  {
    "poem_id": 88081,
    "vorder": 75,
    "position": 0,
    "text": "چو دید آن سر و فرهٔ سرفراز"
  },
  {
    "poem_id": 88081,
    "vorder": 76,
    "position": 1,
    "text": "پیاده شد و برد پیشش نماز"
  },
  {
    "poem_id": 88081,
    "vorder": 77,
    "position": 0,
    "text": "جهاندار بسیار بنواختشان"
  },
  {
    "poem_id": 88081,
    "vorder": 78,
    "position": 1,
    "text": "به رسم کیان جایگه ساختشان"
  },
  {
    "poem_id": 88081,
    "vorder": 79,
    "position": 0,
    "text": "چو خسرو به نزدیک کشتی رسید"
  },
  {
    "poem_id": 88081,
    "vorder": 80,
    "position": 1,
    "text": "فرود آمد و بادبان برکشید"
  },
  {
    "poem_id": 88081,
    "vorder": 81,
    "position": 0,
    "text": "دو هفته بر آن روی دریا بماند"
  },
  {
    "poem_id": 88081,
    "vorder": 82,
    "position": 1,
    "text": "ز گفتار با گیو چندی براند"
  },
  {
    "poem_id": 88081,
    "vorder": 83,
    "position": 0,
    "text": "چنین گفت هر کو ندیده‌ست گنگ"
  },
  {
    "poem_id": 88081,
    "vorder": 84,
    "position": 1,
    "text": "نباید که خواهد به گیتی درنگ"
  },
  {
    "poem_id": 88081,
    "vorder": 85,
    "position": 0,
    "text": "بفرمود تا کار برساختند"
  },
  {
    "poem_id": 88081,
    "vorder": 86,
    "position": 1,
    "text": "دو زورق به آب اندر انداختند"
  },
  {
    "poem_id": 88081,
    "vorder": 87,
    "position": 0,
    "text": "شناسای کشتی هر آنکس که بود"
  },
  {
    "poem_id": 88081,
    "vorder": 88,
    "position": 1,
    "text": "که بر ژرف دریا دلیری نمود"
  },
  {
    "poem_id": 88081,
    "vorder": 89,
    "position": 0,
    "text": "بفرمود تا بادبان برکشید"
  },
  {
    "poem_id": 88081,
    "vorder": 90,
    "position": 1,
    "text": "به دریای بی‌مایه اندر کشید"
  },
  {
    "poem_id": 88081,
    "vorder": 91,
    "position": 0,
    "text": "همان راه دریا به یک ساله راه"
  },
  {
    "poem_id": 88081,
    "vorder": 92,
    "position": 1,
    "text": "چنان تیز شد باد در هفت ماه"
  },
  {
    "poem_id": 88081,
    "vorder": 93,
    "position": 0,
    "text": "که آن شاه و لشکر بدین سو گذشت"
  },
  {
    "poem_id": 88081,
    "vorder": 94,
    "position": 1,
    "text": "که از باد کژ آستی تر نگشت"
  },
  {
    "poem_id": 88081,
    "vorder": 95,
    "position": 0,
    "text": "سپهدار لشکر به خشکی کشید"
  },
  {
    "poem_id": 88081,
    "vorder": 96,
    "position": 1,
    "text": "ببستند کشتی و هامون بدید"
  },
  {
    "poem_id": 88081,
    "vorder": 97,
    "position": 0,
    "text": "خورش کرد و پوشش هم آنجا یله"
  },
  {
    "poem_id": 88081,
    "vorder": 98,
    "position": 1,
    "text": "به ملاح و آن کس که کردی خله"
  },
  {
    "poem_id": 88081,
    "vorder": 99,
    "position": 0,
    "text": "بفرمود دینار و خلعت ز گنج"
  },
  {
    "poem_id": 88081,
    "vorder": 100,
    "position": 1,
    "text": "ز گیتی کسی را که بردند رنج"
  },
  {
    "poem_id": 88081,
    "vorder": 101,
    "position": 0,
    "text": "وز آن آب راه بیابان گرفت"
  },
  {
    "poem_id": 88081,
    "vorder": 102,
    "position": 1,
    "text": "جهانی از او مانده اندر شگفت"
  },
  {
    "poem_id": 88081,
    "vorder": 103,
    "position": 0,
    "text": "چو آگاه شد اشکش آمد به راه"
  },
  {
    "poem_id": 88081,
    "vorder": 104,
    "position": 1,
    "text": "ابا لشکری ساخته پیش شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 105,
    "position": 0,
    "text": "پیاده شد از اسب و روی زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 106,
    "position": 1,
    "text": "ببوسید و بر شاه کرد آفرین"
  },
  {
    "poem_id": 88081,
    "vorder": 107,
    "position": 0,
    "text": "همه تیز و مکران بیاراستند"
  },
  {
    "poem_id": 88081,
    "vorder": 108,
    "position": 1,
    "text": "ز هر جای رامشگران خواستند"
  },
  {
    "poem_id": 88081,
    "vorder": 109,
    "position": 0,
    "text": "همه راه و بی‌راه آوای رود"
  },
  {
    "poem_id": 88081,
    "vorder": 110,
    "position": 1,
    "text": "تو گفتی هوا تار شد رود پود"
  },
  {
    "poem_id": 88081,
    "vorder": 111,
    "position": 0,
    "text": "به دیوار دیبا برآویختند"
  },
  {
    "poem_id": 88081,
    "vorder": 112,
    "position": 1,
    "text": "درم با شکر زیر پی ریختند"
  },
  {
    "poem_id": 88081,
    "vorder": 113,
    "position": 0,
    "text": "به مکران هر آن کس که بد مهتری"
  },
  {
    "poem_id": 88081,
    "vorder": 114,
    "position": 1,
    "text": "وگر نامداری و کنداوری"
  },
  {
    "poem_id": 88081,
    "vorder": 115,
    "position": 0,
    "text": "برفتند با هدیه و با نثار"
  },
  {
    "poem_id": 88081,
    "vorder": 116,
    "position": 1,
    "text": "به نزدیک پیروزگر شهریار"
  },
  {
    "poem_id": 88081,
    "vorder": 117,
    "position": 0,
    "text": "و زآن مرز چندان که بد خواسته"
  },
  {
    "poem_id": 88081,
    "vorder": 118,
    "position": 1,
    "text": "فراز آورید اشکش آراسته"
  },
  {
    "poem_id": 88081,
    "vorder": 119,
    "position": 0,
    "text": "ز اشکش پذیرفت شاه آنچه دید"
  },
  {
    "poem_id": 88081,
    "vorder": 120,
    "position": 1,
    "text": "و زآن نامداران یکی برگزید"
  },
  {
    "poem_id": 88081,
    "vorder": 121,
    "position": 0,
    "text": "ورا کرد مهتر به مکران زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 122,
    "position": 1,
    "text": "بسی خلعتش داد و کرد آفرین"
  },
  {
    "poem_id": 88081,
    "vorder": 123,
    "position": 0,
    "text": "چو آمد ز مکران و توران به چین"
  },
  {
    "poem_id": 88081,
    "vorder": 124,
    "position": 1,
    "text": "خود و سرفرازان ایران زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 125,
    "position": 0,
    "text": "پذیره شدش رستم زال سام"
  },
  {
    "poem_id": 88081,
    "vorder": 126,
    "position": 1,
    "text": "سپاهی گشاده دل و شاد کام"
  },
  {
    "poem_id": 88081,
    "vorder": 127,
    "position": 0,
    "text": "چو از دور کیخسرو آمد پدید"
  },
  {
    "poem_id": 88081,
    "vorder": 128,
    "position": 1,
    "text": "سوار سرفراز چترش کشید"
  },
  {
    "poem_id": 88081,
    "vorder": 129,
    "position": 0,
    "text": "پیاده شد از باره بردش نماز"
  },
  {
    "poem_id": 88081,
    "vorder": 130,
    "position": 1,
    "text": "گرفتش به بر شاه گردن‌فراز"
  },
  {
    "poem_id": 88081,
    "vorder": 131,
    "position": 0,
    "text": "بگفت آن شگفتی که دید اندر آب"
  },
  {
    "poem_id": 88081,
    "vorder": 132,
    "position": 1,
    "text": "ز گم بودن جادو افراسیاب"
  },
  {
    "poem_id": 88081,
    "vorder": 133,
    "position": 0,
    "text": "به چین نیز مهمان رستم بماند"
  },
  {
    "poem_id": 88081,
    "vorder": 134,
    "position": 1,
    "text": "به یک هفته از چین به ماچین براند"
  },
  {
    "poem_id": 88081,
    "vorder": 135,
    "position": 0,
    "text": "همی رفت سوی سیاووش گرد"
  },
  {
    "poem_id": 88081,
    "vorder": 136,
    "position": 1,
    "text": "به ماه سفندار مذ روز ارد"
  },
  {
    "poem_id": 88081,
    "vorder": 137,
    "position": 0,
    "text": "چو آمد بدان شارستان پدر"
  },
  {
    "poem_id": 88081,
    "vorder": 138,
    "position": 1,
    "text": "دو رخساره پر آب و خسته جگر"
  },
  {
    "poem_id": 88081,
    "vorder": 139,
    "position": 0,
    "text": "به جایی که گرسیوز بدنشان"
  },
  {
    "poem_id": 88081,
    "vorder": 140,
    "position": 1,
    "text": "گروی به نفرین مردم کشان"
  },
  {
    "poem_id": 88081,
    "vorder": 141,
    "position": 0,
    "text": "سر شاه ایران بریدند خوار"
  },
  {
    "poem_id": 88081,
    "vorder": 142,
    "position": 1,
    "text": "بیامد بدان جایگه شهریار"
  },
  {
    "poem_id": 88081,
    "vorder": 143,
    "position": 0,
    "text": "همی ریخت بر سر از آن تیره خاک"
  },
  {
    "poem_id": 88081,
    "vorder": 144,
    "position": 1,
    "text": "همی کرد روی و بر خویش چاک"
  },
  {
    "poem_id": 88081,
    "vorder": 145,
    "position": 0,
    "text": "بمالید رستم بر آن خاک روی"
  },
  {
    "poem_id": 88081,
    "vorder": 146,
    "position": 1,
    "text": "بنفرید بر جان ناکس گروی"
  },
  {
    "poem_id": 88081,
    "vorder": 147,
    "position": 0,
    "text": "همی گفت کیخسرو ای شهریار"
  },
  {
    "poem_id": 88081,
    "vorder": 148,
    "position": 1,
    "text": "مرا ماندی در جهان یادگار"
  },
  {
    "poem_id": 88081,
    "vorder": 149,
    "position": 0,
    "text": "نماندم ز کین تو مانند چیز"
  },
  {
    "poem_id": 88081,
    "vorder": 150,
    "position": 1,
    "text": "به رنج اندرم تا جهانست نیز"
  },
  {
    "poem_id": 88081,
    "vorder": 151,
    "position": 0,
    "text": "بپرداختم تخت افراسیاب"
  },
  {
    "poem_id": 88081,
    "vorder": 152,
    "position": 1,
    "text": "از این پس نه آرام جویم نه خواب"
  },
  {
    "poem_id": 88081,
    "vorder": 153,
    "position": 0,
    "text": "بر امید آن کش به چنگ آورم"
  },
  {
    "poem_id": 88081,
    "vorder": 154,
    "position": 1,
    "text": "جهان پیش او تار و تنگ آورم"
  },
  {
    "poem_id": 88081,
    "vorder": 155,
    "position": 0,
    "text": "از آن پس بدان گنج بنهاد سر"
  },
  {
    "poem_id": 88081,
    "vorder": 156,
    "position": 1,
    "text": "که مادر بدو یاد کرد از پدر"
  },
  {
    "poem_id": 88081,
    "vorder": 157,
    "position": 0,
    "text": "در گنج بگشاد و روزی بداد"
  },
  {
    "poem_id": 88081,
    "vorder": 158,
    "position": 1,
    "text": "دو هفته در آن شارستان بود شاد"
  },
  {
    "poem_id": 88081,
    "vorder": 159,
    "position": 0,
    "text": "به رستم دو صد بدره دینار داد"
  },
  {
    "poem_id": 88081,
    "vorder": 160,
    "position": 1,
    "text": "همان گیو را چیز بسیار داد"
  },
  {
    "poem_id": 88081,
    "vorder": 161,
    "position": 0,
    "text": "چو بشنید گستهم نوذر که شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 162,
    "position": 1,
    "text": "بدان شارستان پدر کرد راه"
  },
  {
    "poem_id": 88081,
    "vorder": 163,
    "position": 0,
    "text": "پذیره شدش با سپاهی گران"
  },
  {
    "poem_id": 88081,
    "vorder": 164,
    "position": 1,
    "text": "ز ایران بزرگان و کنداوران"
  },
  {
    "poem_id": 88081,
    "vorder": 165,
    "position": 0,
    "text": "چو از دور دید افسر و تاج شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 166,
    "position": 1,
    "text": "پیاده فراوان بپیمود راه"
  },
  {
    "poem_id": 88081,
    "vorder": 167,
    "position": 0,
    "text": "همه یکسره خواندند آفرین"
  },
  {
    "poem_id": 88081,
    "vorder": 168,
    "position": 1,
    "text": "بر آن دادگر شهریار زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 169,
    "position": 0,
    "text": "به گستهم فرمود تا برنشست"
  },
  {
    "poem_id": 88081,
    "vorder": 170,
    "position": 1,
    "text": "همه راه شادان و دستش به دست"
  },
  {
    "poem_id": 88081,
    "vorder": 171,
    "position": 0,
    "text": "کشیدند زان روی به بهشت گنگ"
  },
  {
    "poem_id": 88081,
    "vorder": 172,
    "position": 1,
    "text": "سپه را به نزدیک شاه آب و رنگ"
  },
  {
    "poem_id": 88081,
    "vorder": 173,
    "position": 0,
    "text": "وفا چون درختی بود میوه‌دار"
  },
  {
    "poem_id": 88081,
    "vorder": 174,
    "position": 1,
    "text": "همی هر زمانی نو آید به بار"
  },
  {
    "poem_id": 88081,
    "vorder": 175,
    "position": 0,
    "text": "نیاسود یک تن ز خورد و شکار"
  },
  {
    "poem_id": 88081,
    "vorder": 176,
    "position": 1,
    "text": "همان یک سواره همان شهریار"
  },
  {
    "poem_id": 88081,
    "vorder": 177,
    "position": 0,
    "text": "ز ترکان هر آن کس که بد سرفراز"
  },
  {
    "poem_id": 88081,
    "vorder": 178,
    "position": 1,
    "text": "شدند از نوازش همه بی‌نیاز"
  },
  {
    "poem_id": 88081,
    "vorder": 179,
    "position": 0,
    "text": "به رخشنده روز و به هنگام خواب"
  },
  {
    "poem_id": 88081,
    "vorder": 180,
    "position": 1,
    "text": "همی آگهی جست ز افراسیاب"
  },
  {
    "poem_id": 88081,
    "vorder": 181,
    "position": 0,
    "text": "از ایشان کسی زو نشانی نداد"
  },
  {
    "poem_id": 88081,
    "vorder": 182,
    "position": 1,
    "text": "نکردند از او در جهان نیز یاد"
  },
  {
    "poem_id": 88081,
    "vorder": 183,
    "position": 0,
    "text": "جهاندار یک شب سر و تن بشست"
  },
  {
    "poem_id": 88081,
    "vorder": 184,
    "position": 1,
    "text": "بشد دور با دفتر زند و است"
  },
  {
    "poem_id": 88081,
    "vorder": 185,
    "position": 0,
    "text": "همه شب به پیش جهان آفرین"
  },
  {
    "poem_id": 88081,
    "vorder": 186,
    "position": 1,
    "text": "همی بود گریان و سر بر زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 187,
    "position": 0,
    "text": "همی گفت کاین بنده ناتوان"
  },
  {
    "poem_id": 88081,
    "vorder": 188,
    "position": 1,
    "text": "همیشه پر از درد دارد روان"
  },
  {
    "poem_id": 88081,
    "vorder": 189,
    "position": 0,
    "text": "همه کوه و رود و بیابان و آب"
  },
  {
    "poem_id": 88081,
    "vorder": 190,
    "position": 1,
    "text": "نبیند نشانی ز افراسیاب"
  },
  {
    "poem_id": 88081,
    "vorder": 191,
    "position": 0,
    "text": "همی گفت کای داور دادگر"
  },
  {
    "poem_id": 88081,
    "vorder": 192,
    "position": 1,
    "text": "تو دادی مرا نازش و زور و فر"
  },
  {
    "poem_id": 88081,
    "vorder": 193,
    "position": 0,
    "text": "که او راه تو دادگر نسپرد"
  },
  {
    "poem_id": 88081,
    "vorder": 194,
    "position": 1,
    "text": "کسی را ز گیتی به کس نشمرد"
  },
  {
    "poem_id": 88081,
    "vorder": 195,
    "position": 0,
    "text": "تو دانی که او نیست بر داد و راه"
  },
  {
    "poem_id": 88081,
    "vorder": 196,
    "position": 1,
    "text": "بسی ریخت خون سر بیگناه"
  },
  {
    "poem_id": 88081,
    "vorder": 197,
    "position": 0,
    "text": "مگر باشدم دادگر یک خدای"
  },
  {
    "poem_id": 88081,
    "vorder": 198,
    "position": 1,
    "text": "به نزدیک آن بدکنش رهنمای"
  },
  {
    "poem_id": 88081,
    "vorder": 199,
    "position": 0,
    "text": "تو دانی که من خود سراینده‌ام"
  },
  {
    "poem_id": 88081,
    "vorder": 200,
    "position": 1,
    "text": "پرستنده آفریننده‌ام"
  },
  {
    "poem_id": 88081,
    "vorder": 201,
    "position": 0,
    "text": "به گیتی از او نام و آواز نیست"
  },
  {
    "poem_id": 88081,
    "vorder": 202,
    "position": 1,
    "text": "ز من راز باشد ز تو راز نیست"
  },
  {
    "poem_id": 88081,
    "vorder": 203,
    "position": 0,
    "text": "اگر زو تو خشنودی ای دادگر"
  },
  {
    "poem_id": 88081,
    "vorder": 204,
    "position": 1,
    "text": "مرا بازگردان ز پیکار سر"
  },
  {
    "poem_id": 88081,
    "vorder": 205,
    "position": 0,
    "text": "بکش در دل این آتش کین من"
  },
  {
    "poem_id": 88081,
    "vorder": 206,
    "position": 1,
    "text": "به آیین خویش آور آیین من"
  },
  {
    "poem_id": 88081,
    "vorder": 207,
    "position": 0,
    "text": "ز جای نیایش بیامد به تخت"
  },
  {
    "poem_id": 88081,
    "vorder": 208,
    "position": 1,
    "text": "جوان سرافراز و پیروز بخت"
  },
  {
    "poem_id": 88081,
    "vorder": 209,
    "position": 0,
    "text": "همی بود یک سال در حصن گنگ"
  },
  {
    "poem_id": 88081,
    "vorder": 210,
    "position": 1,
    "text": "برآسود از جنبش و ساز جنگ"
  },
  {
    "poem_id": 88081,
    "vorder": 211,
    "position": 0,
    "text": "چو بودن به گنگ اندرون شد دراز"
  },
  {
    "poem_id": 88081,
    "vorder": 212,
    "position": 1,
    "text": "به دیدار کاووسش آمد نیاز"
  },
  {
    "poem_id": 88081,
    "vorder": 213,
    "position": 0,
    "text": "به گستهم نوذر سپرد آن زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 214,
    "position": 1,
    "text": "ز قچغار تا پیش دریای چین"
  },
  {
    "poem_id": 88081,
    "vorder": 215,
    "position": 0,
    "text": "بی‌اندازه لشکر به گستهم داد"
  },
  {
    "poem_id": 88081,
    "vorder": 216,
    "position": 1,
    "text": "بدو گفت بیدار دل باش و شاد"
  },
  {
    "poem_id": 88081,
    "vorder": 217,
    "position": 0,
    "text": "به چین و به مکران زمین دست یاز"
  },
  {
    "poem_id": 88081,
    "vorder": 218,
    "position": 1,
    "text": "به هر سو فرستاده و نامه ساز"
  },
  {
    "poem_id": 88081,
    "vorder": 219,
    "position": 0,
    "text": "همی جوی ز افراسیاب آگهی"
  },
  {
    "poem_id": 88081,
    "vorder": 220,
    "position": 1,
    "text": "مگر زو شود روی گیتی تهی"
  },
  {
    "poem_id": 88081,
    "vorder": 221,
    "position": 0,
    "text": "و زآن جایگه خواسته هرچه بود"
  },
  {
    "poem_id": 88081,
    "vorder": 222,
    "position": 1,
    "text": "ز دینار وز گوهر نابسود"
  },
  {
    "poem_id": 88081,
    "vorder": 223,
    "position": 0,
    "text": "ز مشک و پرستار و زرین ستام"
  },
  {
    "poem_id": 88081,
    "vorder": 224,
    "position": 1,
    "text": "همان جامه و اسب و تخت و غلام"
  },
  {
    "poem_id": 88081,
    "vorder": 225,
    "position": 0,
    "text": "ز گستردنیها و آلات چین"
  },
  {
    "poem_id": 88081,
    "vorder": 226,
    "position": 1,
    "text": "ز چیزی که خیزد ز مکران زمین"
  },
  {
    "poem_id": 88081,
    "vorder": 227,
    "position": 0,
    "text": "ز گاوان گردونکشان چل هزار"
  },
  {
    "poem_id": 88081,
    "vorder": 228,
    "position": 1,
    "text": "همی راند پیش اندرون شهریار"
  },
  {
    "poem_id": 88081,
    "vorder": 229,
    "position": 0,
    "text": "همی گفت هرگز کسی پیش از این"
  },
  {
    "poem_id": 88081,
    "vorder": 230,
    "position": 1,
    "text": "ندید و نبد خواسته بیش از این"
  },
  {
    "poem_id": 88081,
    "vorder": 231,
    "position": 0,
    "text": "سپه بود چندان که بر کوه و دشت"
  },
  {
    "poem_id": 88081,
    "vorder": 232,
    "position": 1,
    "text": "همی ده شب و روز لشکر گذشت"
  },
  {
    "poem_id": 88081,
    "vorder": 233,
    "position": 0,
    "text": "چو دمدار برداشتی پیشرو"
  },
  {
    "poem_id": 88081,
    "vorder": 234,
    "position": 1,
    "text": "به منزل رسیدی همی نو به نو"
  },
  {
    "poem_id": 88081,
    "vorder": 235,
    "position": 0,
    "text": "بیامد بر آن هم نشان تا به چاج"
  },
  {
    "poem_id": 88081,
    "vorder": 236,
    "position": 1,
    "text": "بیاویخت تاج از بر تخت عاج"
  },
  {
    "poem_id": 88081,
    "vorder": 237,
    "position": 0,
    "text": "به سغد اندرون بود یک هفته شاه"
  },
  {
    "poem_id": 88081,
    "vorder": 238,
    "position": 1,
    "text": "همه سغد شد شاه را نیک خواه"
  },
  {
    "poem_id": 88081,
    "vorder": 239,
    "position": 0,
    "text": "وز آنجا به شهر بخارا رسید"
  },
  {
    "poem_id": 88081,
    "vorder": 240,
    "position": 1,
    "text": "ز لشکر هوا را همی کس ندید"
  },
  {
    "poem_id": 88081,
    "vorder": 241,
    "position": 0,
    "text": "بخورد و بیاسود و یک هفته بود"
  },
  {
    "poem_id": 88081,
    "vorder": 242,
    "position": 1,
    "text": "دوم هفته با جامه نابسود"
  },
  {
    "poem_id": 88081,
    "vorder": 243,
    "position": 0,
    "text": "بیامد خروشان به آتشکده"
  },
  {
    "poem_id": 88081,
    "vorder": 244,
    "position": 1,
    "text": "غمی بود زآن اژدهای شده"
  },
  {
    "poem_id": 88081,
    "vorder": 245,
    "position": 0,
    "text": "که تور فریدون برآورده بود"
  },
  {
    "poem_id": 88081,
    "vorder": 246,
    "position": 1,
    "text": "بدو اندرون کاخها کرده بود"
  },
  {
    "poem_id": 88081,
    "vorder": 247,
    "position": 0,
    "text": "بگسترد بر موبدان سیم و زر"
  },
  {
    "poem_id": 88081,
    "vorder": 248,
    "position": 1,
    "text": "بر آتش پراگند چندی گهر"
  },
  {
    "poem_id": 88081,
    "vorder": 249,
    "position": 0,
    "text": "و زآن جایگه سر به رفتن نهاد"
  },
  {
