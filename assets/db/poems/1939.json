[
  {
    "poem_id": 1939,
    "vorder": 1,
    "position": 0,
    "text": "چو بیژن سپه را همه راست کرد"
  },
  {
    "poem_id": 1939,
    "vorder": 2,
    "position": 1,
    "text": "به ایرانیان بر کمین خواست کرد"
  },
  {
    "poem_id": 1939,
    "vorder": 3,
    "position": 0,
    "text": "بدانست ماهوی و از قلبگاه"
  },
  {
    "poem_id": 1939,
    "vorder": 4,
    "position": 1,
    "text": "خروشان برفت از میان سپاه"
  },
  {
    "poem_id": 1939,
    "vorder": 5,
    "position": 0,
    "text": "نگه کرد بیژن درفشش بدید"
  },
  {
    "poem_id": 1939,
    "vorder": 6,
    "position": 1,
    "text": "بدانست کو جست خواهد گزید"
  },
  {
    "poem_id": 1939,
    "vorder": 7,
    "position": 0,
    "text": "به برسام فرمود کز قلبگاه"
  },
  {
    "poem_id": 1939,
    "vorder": 8,
    "position": 1,
    "text": "به یکسو گذار آنک داری سپاه"
  },
  {
    "poem_id": 1939,
    "vorder": 9,
    "position": 0,
    "text": "نباید که ماهوی سوری ز جنگ"
  },
  {
    "poem_id": 1939,
    "vorder": 10,
    "position": 1,
    "text": "بترسد به جیحون کشد بی‌درنگ"
  },
  {
    "poem_id": 1939,
    "vorder": 11,
    "position": 0,
    "text": "به تیزی ازو چشم خود برمدار"
  },
  {
    "poem_id": 1939,
    "vorder": 12,
    "position": 1,
    "text": "که با او دگرگونه سازیم کار"
  },
  {
    "poem_id": 1939,
    "vorder": 13,
    "position": 0,
    "text": "چو برسام چینی درفشش بدید"
  },
  {
    "poem_id": 1939,
    "vorder": 14,
    "position": 1,
    "text": "سپه را ز لشکر به یکسو کشید"
  },
  {
    "poem_id": 1939,
    "vorder": 15,
    "position": 0,
    "text": "همی‌تاخت تا پیش ریگ فرب"
  },
  {
    "poem_id": 1939,
    "vorder": 16,
    "position": 1,
    "text": "پرآژنگ رخ پر ز دشنام لب"
  },
  {
    "poem_id": 1939,
    "vorder": 17,
    "position": 0,
    "text": "مر او را بریگ فرب دربیافت"
  },
  {
    "poem_id": 1939,
    "vorder": 18,
    "position": 1,
    "text": "رکابش گران کرد و اندر شتافت"
  },
  {
    "poem_id": 1939,
    "vorder": 19,
    "position": 0,
    "text": "چو نزدیک ماهو برابر ببود"
  },
  {
    "poem_id": 1939,
    "vorder": 20,
    "position": 1,
    "text": "نزد خنجر او را دلیری نمود"
  },
  {
    "poem_id": 1939,
    "vorder": 21,
    "position": 0,
    "text": "کمربند بگرفت و او را ز زین"
  },
  {
    "poem_id": 1939,
    "vorder": 22,
    "position": 1,
    "text": "برآورد و آسان بزد بر زمین"
  },
  {
    "poem_id": 1939,
    "vorder": 23,
    "position": 0,
    "text": "فرود آمد و دست او را ببست"
  },
  {
    "poem_id": 1939,
    "vorder": 24,
    "position": 1,
    "text": "به پیش اندر افگند و خود برنشست"
  },
  {
    "poem_id": 1939,
    "vorder": 25,
    "position": 0,
    "text": "همانگه رسیدند یاران اوی"
  },
  {
    "poem_id": 1939,
    "vorder": 26,
    "position": 1,
    "text": "همه دشت ازو شد پر از گفت‌وگوی"
  },
  {
    "poem_id": 1939,
    "vorder": 27,
    "position": 0,
    "text": "ببرسام گفتند کاین را مبر"
  },
  {
    "poem_id": 1939,
    "vorder": 28,
    "position": 1,
    "text": "بباید زدن گردنش را تبر"
  },
  {
    "poem_id": 1939,
    "vorder": 29,
    "position": 0,
    "text": "چنین داد پاسخ که این راه نیست"
  },
  {
    "poem_id": 1939,
    "vorder": 30,
    "position": 1,
    "text": "نه زین تاختن بیژن آگاه نیست"
  },
  {
    "poem_id": 1939,
    "vorder": 31,
    "position": 0,
    "text": "همانگه به بیژن رسید آگهی"
  },
  {
    "poem_id": 1939,
    "vorder": 32,
    "position": 1,
    "text": "که آمد بدست آن نهانی رهی"
  },
  {
    "poem_id": 1939,
    "vorder": 33,
    "position": 0,
    "text": "جهانجوی ماهوی شوریده‌هُش"
  },
  {
    "poem_id": 1939,
    "vorder": 34,
    "position": 1,
    "text": "پرآزار و بی‌دین خداوندکش"
  },
  {
    "poem_id": 1939,
    "vorder": 35,
    "position": 0,
    "text": "چو بشنید بیژن از آن شاد شد"
  },
  {
    "poem_id": 1939,
    "vorder": 36,
    "position": 1,
    "text": "ببالید و ز اندیشه آزاد شد"
  },
  {
    "poem_id": 1939,
    "vorder": 37,
    "position": 0,
    "text": "شِراعی زدند از بر ریگ نرم"
  },
  {
    "poem_id": 1939,
    "vorder": 38,
    "position": 1,
    "text": "همی‌رفت ماهوی چون باد گرم"
  },
  {
    "poem_id": 1939,
    "vorder": 39,
    "position": 0,
    "text": "گنهکار چون روی بیژن بدید"
  },
  {
    "poem_id": 1939,
    "vorder": 40,
    "position": 1,
    "text": "خرد شد ز مغز سرش ناپدید"
  },
  {
    "poem_id": 1939,
    "vorder": 41,
    "position": 0,
    "text": "شد از بیم همچون تن بی‌روان"
  },
  {
    "poem_id": 1939,
    "vorder": 42,
    "position": 1,
    "text": "به سر بر پراگند ریگ روان"
  },
  {
    "poem_id": 1939,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت بیژن که ای بدنژاد"
  },
  {
    "poem_id": 1939,
    "vorder": 44,
    "position": 1,
    "text": "که چون تو پرستار کس را مباد"
  },
  {
    "poem_id": 1939,
    "vorder": 45,
    "position": 0,
    "text": "چرا کشتی آن دادگر شاه را"
  },
  {
    "poem_id": 1939,
    "vorder": 46,
    "position": 1,
    "text": "خداوند پیروزی و گاه را"
  },
  {
    "poem_id": 1939,
    "vorder": 47,
    "position": 0,
    "text": "پدر بر پدر شاه و خود شهریار"
  },
  {
    "poem_id": 1939,
    "vorder": 48,
    "position": 1,
    "text": "ز نوشین‌روان در جهان یادگار"
  },
  {
    "poem_id": 1939,
    "vorder": 49,
    "position": 0,
    "text": "چنین داد پاسخ که از بدکنش"
  },
  {
    "poem_id": 1939,
    "vorder": 50,
    "position": 1,
    "text": "نیاید مگر کشتن و سرزنش"
  },
  {
    "poem_id": 1939,
    "vorder": 51,
    "position": 0,
    "text": "بدین بد کنون گردن من بزن"
  },
  {
    "poem_id": 1939,
    "vorder": 52,
    "position": 1,
    "text": "بینداز در پیش این انجمن"
  },
  {
    "poem_id": 1939,
    "vorder": 53,
    "position": 0,
    "text": "بترسید کش پوست بیرون کشد"
  },
  {
    "poem_id": 1939,
    "vorder": 54,
    "position": 1,
    "text": "تنش را بدان کینه در خون کشد"
  },
  {
    "poem_id": 1939,
    "vorder": 55,
    "position": 0,
    "text": "نهانش بدانست مرد دلیر"
  },
  {
    "poem_id": 1939,
    "vorder": 56,
    "position": 1,
    "text": "به پاسخ زمانی همی‌بود دیر"
  },
  {
    "poem_id": 1939,
    "vorder": 57,
    "position": 0,
    "text": "چنین داد پاسخ که ایدون کنم"
  },
  {
    "poem_id": 1939,
    "vorder": 58,
    "position": 1,
    "text": "که کین از دل خویش بیرون کنم"
  },
  {
    "poem_id": 1939,
    "vorder": 59,
    "position": 0,
    "text": "بدین مردی و دانش و رای و خوی"
  },
  {
    "poem_id": 1939,
    "vorder": 60,
    "position": 1,
    "text": "همی تاج و تخت آمدت آرزوی"
  },
  {
    "poem_id": 1939,
    "vorder": 61,
    "position": 0,
    "text": "به شمشیر دستش ببرید و گفت"
  },
  {
    "poem_id": 1939,
    "vorder": 62,
    "position": 1,
    "text": "که این دست را در بدی نیست جفت"
  },
  {
    "poem_id": 1939,
    "vorder": 63,
    "position": 0,
    "text": "چو دستش ببرید گفتا دو پا"
  },
  {
    "poem_id": 1939,
    "vorder": 64,
    "position": 1,
    "text": "ببرید تا ماند ایدر بجا"
  },
  {
    "poem_id": 1939,
    "vorder": 65,
    "position": 0,
    "text": "بفرمود تا گوش و بینیش پست"
  },
  {
    "poem_id": 1939,
    "vorder": 66,
    "position": 1,
    "text": "بریدند و خود بارگی برنشست"
  },
  {
    "poem_id": 1939,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود کاین را برین ریگ گرم"
  },
  {
    "poem_id": 1939,
    "vorder": 68,
    "position": 1,
    "text": "بدارید تا خوابش آید ز شرم"
  },
  {
    "poem_id": 1939,
    "vorder": 69,
    "position": 0,
    "text": "منادیگری گرد لشکر بگشت"
  },
  {
    "poem_id": 1939,
    "vorder": 70,
    "position": 1,
    "text": "به درگاه هر خیمه‌ای برگذشت"
  },
  {
    "poem_id": 1939,
    "vorder": 71,
    "position": 0,
    "text": "که ای بندگان خداوندکش"
  },
  {
    "poem_id": 1939,
    "vorder": 72,
    "position": 1,
    "text": "مشورید بیهوده هر جای هش"
  },
  {
    "poem_id": 1939,
    "vorder": 73,
    "position": 0,
    "text": "چو ماهوی باد آنکه بر جان شاه"
  },
  {
    "poem_id": 1939,
    "vorder": 74,
    "position": 1,
    "text": "نبخشود هرگز مبیناد گاه"
  },
  {
    "poem_id": 1939,
    "vorder": 75,
    "position": 0,
    "text": "سه پور جوانش به لشکر بدند"
  },
  {
    "poem_id": 1939,
    "vorder": 76,
    "position": 1,
    "text": "همان هر سه با تخت و افسر بدند"
  },
  {
    "poem_id": 1939,
    "vorder": 77,
    "position": 0,
    "text": "همان جایگه آتشی بر فروخت"
  },
  {
    "poem_id": 1939,
    "vorder": 78,
    "position": 1,
    "text": "پدر را و هر سه پسر را بسوخت"
  },
  {
    "poem_id": 1939,
    "vorder": 79,
    "position": 0,
    "text": "از آن تخمه کس در زمانه نماند"
  },
  {
    "poem_id": 1939,
    "vorder": 80,
    "position": 1,
    "text": "و گر ماند هرکو بدیدش براند"
  },
  {
    "poem_id": 1939,
    "vorder": 81,
    "position": 0,
    "text": "بزرگان بر آن دوده نفرین کنند"
  },
  {
    "poem_id": 1939,
    "vorder": 82,
    "position": 1,
    "text": "سر از کشتن شاه پرکین کنند"
  },
  {
    "poem_id": 1939,
    "vorder": 83,
    "position": 0,
    "text": "که نفرین برو باد و هرگز مباد"
  },
  {
    "poem_id": 1939,
    "vorder": 84,
    "position": 1,
    "text": "که او را نه نفرین فرستد بداد"
  },
  {
    "poem_id": 1939,
    "vorder": 85,
    "position": 0,
    "text": "کنون زین سپس دور عمّر بود"
  },
  {
    "poem_id": 1939,
    "vorder": 86,
    "position": 1,
    "text": "چو دین آورد تخت منبر بود"
  }
]