[
  {
    "poem_id": 1658,
    "vorder": 1,
    "position": 0,
    "text": "چو لشکر شد از خواسته بی‌نیاز"
  },
  {
    "poem_id": 1658,
    "vorder": 2,
    "position": 1,
    "text": "برو ناگذشته زمانی دراز"
  },
  {
    "poem_id": 1658,
    "vorder": 3,
    "position": 0,
    "text": "به شبگیر برخاست آوای کوس"
  },
  {
    "poem_id": 1658,
    "vorder": 4,
    "position": 1,
    "text": "هوا شد به کردار چشم خروس"
  },
  {
    "poem_id": 1658,
    "vorder": 5,
    "position": 0,
    "text": "ز بس نیزه و پرنیانی درفش"
  },
  {
    "poem_id": 1658,
    "vorder": 6,
    "position": 1,
    "text": "ستاره شده سرخ و زرد و بنفش"
  },
  {
    "poem_id": 1658,
    "vorder": 7,
    "position": 0,
    "text": "سکندر بیامد به سوی حرم"
  },
  {
    "poem_id": 1658,
    "vorder": 8,
    "position": 1,
    "text": "گروهی ازو شاد و بهری دژم"
  },
  {
    "poem_id": 1658,
    "vorder": 9,
    "position": 0,
    "text": "ابا نالهٔ بوق و با کوس تفت"
  },
  {
    "poem_id": 1658,
    "vorder": 10,
    "position": 1,
    "text": "به خان براهیم آزر برفت"
  },
  {
    "poem_id": 1658,
    "vorder": 11,
    "position": 0,
    "text": "که خان حرم را برآورده بود"
  },
  {
    "poem_id": 1658,
    "vorder": 12,
    "position": 1,
    "text": "بدو اندرون رنجها برده بود"
  },
  {
    "poem_id": 1658,
    "vorder": 13,
    "position": 0,
    "text": "خداوند خواندش بیت‌الحرام"
  },
  {
    "poem_id": 1658,
    "vorder": 14,
    "position": 1,
    "text": "بدو شد همه راه یزدان تمام"
  },
  {
    "poem_id": 1658,
    "vorder": 15,
    "position": 0,
    "text": "ز پاکی ورا خانهٔ خویش خواند"
  },
  {
    "poem_id": 1658,
    "vorder": 16,
    "position": 1,
    "text": "نیایش بران کو ترا پیش خواند"
  },
  {
    "poem_id": 1658,
    "vorder": 17,
    "position": 0,
    "text": "خدای جهان را نباشد نیاز"
  },
  {
    "poem_id": 1658,
    "vorder": 18,
    "position": 1,
    "text": "نه جای خور و کام و آرام و ناز"
  },
  {
    "poem_id": 1658,
    "vorder": 19,
    "position": 0,
    "text": "پرستشگهی بود تا بود جای"
  },
  {
    "poem_id": 1658,
    "vorder": 20,
    "position": 1,
    "text": "بدو اندرون یاد کرد خدای"
  },
  {
    "poem_id": 1658,
    "vorder": 21,
    "position": 0,
    "text": "پس آمد سکندر سوی قادسی"
  },
  {
    "poem_id": 1658,
    "vorder": 22,
    "position": 1,
    "text": "جهانگیر تا جهرم پارسی"
  },
  {
    "poem_id": 1658,
    "vorder": 23,
    "position": 0,
    "text": "چو آگاهی آمد به نصر قتیب"
  },
  {
    "poem_id": 1658,
    "vorder": 24,
    "position": 1,
    "text": "کزو بود مر مکه را فر و زیب"
  },
  {
    "poem_id": 1658,
    "vorder": 25,
    "position": 0,
    "text": "پذیره شدش با نبرده سران"
  },
  {
    "poem_id": 1658,
    "vorder": 26,
    "position": 1,
    "text": "دلاور سواران نیزه‌وران"
  },
  {
    "poem_id": 1658,
    "vorder": 27,
    "position": 0,
    "text": "سواری بیامد هم اندر زمان"
  },
  {
    "poem_id": 1658,
    "vorder": 28,
    "position": 1,
    "text": "ز مکه به نزد سکندر دمان"
  },
  {
    "poem_id": 1658,
    "vorder": 29,
    "position": 0,
    "text": "که این نامداری که آمد ز راه"
  },
  {
    "poem_id": 1658,
    "vorder": 30,
    "position": 1,
    "text": "نجوید همی تاج و گنج و سپاه"
  },
  {
    "poem_id": 1658,
    "vorder": 31,
    "position": 0,
    "text": "نبیرهٔ سماعیل نیک اخترست"
  },
  {
    "poem_id": 1658,
    "vorder": 32,
    "position": 1,
    "text": "که پور براهیم پیغمبرست"
  },
  {
    "poem_id": 1658,
    "vorder": 33,
    "position": 0,
    "text": "چو پیش آمدش نصر بنواختش"
  },
  {
    "poem_id": 1658,
    "vorder": 34,
    "position": 1,
    "text": "یکی مایه‌ور جایگه ساختش"
  },
  {
    "poem_id": 1658,
    "vorder": 35,
    "position": 0,
    "text": "بدو شاد شد نصر و گوهر بگفت"
  },
  {
    "poem_id": 1658,
    "vorder": 36,
    "position": 1,
    "text": "همه رازها برگشاد از نهفت"
  },
  {
    "poem_id": 1658,
    "vorder": 37,
    "position": 0,
    "text": "سکندر چنین داد پاسخ بدوی"
  },
  {
    "poem_id": 1658,
    "vorder": 38,
    "position": 1,
    "text": "که ای پاک‌دل مهتر راست‌گوی"
  },
  {
    "poem_id": 1658,
    "vorder": 39,
    "position": 0,
    "text": "بدین دوده اکنون کدامست مه"
  },
  {
    "poem_id": 1658,
    "vorder": 40,
    "position": 1,
    "text": "جز از تو پسندیده و روزبه"
  },
  {
    "poem_id": 1658,
    "vorder": 41,
    "position": 0,
    "text": "بدو گفت نصر ای جهاندار شاه"
  },
  {
    "poem_id": 1658,
    "vorder": 42,
    "position": 1,
    "text": "خزاعست مهتر بدین جایگاه"
  },
  {
    "poem_id": 1658,
    "vorder": 43,
    "position": 0,
    "text": "سماعیل چون زین جهان درگذشت"
  },
  {
    "poem_id": 1658,
    "vorder": 44,
    "position": 1,
    "text": "جهانگیر قحطان بیامد ز دشت"
  },
  {
    "poem_id": 1658,
    "vorder": 45,
    "position": 0,
    "text": "ابا لشکر گشن شمشیرزن"
  },
  {
    "poem_id": 1658,
    "vorder": 46,
    "position": 1,
    "text": "به بیداد بگرفت شهر یمن"
  },
  {
    "poem_id": 1658,
    "vorder": 47,
    "position": 0,
    "text": "بسی مردم بیگنه کشته شد"
  },
  {
    "poem_id": 1658,
    "vorder": 48,
    "position": 1,
    "text": "بدین دودمان روز برگشته شد"
  },
  {
    "poem_id": 1658,
    "vorder": 49,
    "position": 0,
    "text": "نیامد جهان‌آفرین را پسند"
  },
  {
    "poem_id": 1658,
    "vorder": 50,
    "position": 1,
    "text": "برو تیره شد رای چرخ بلند"
  },
  {
    "poem_id": 1658,
    "vorder": 51,
    "position": 0,
    "text": "خزاعه بیامد چو او گشت خاک"
  },
  {
    "poem_id": 1658,
    "vorder": 52,
    "position": 1,
    "text": "بر رنج و بیداد بدرود پاک"
  },
  {
    "poem_id": 1658,
    "vorder": 53,
    "position": 0,
    "text": "حرم تا یمن پاک بر دست اوست"
  },
  {
    "poem_id": 1658,
    "vorder": 54,
    "position": 1,
    "text": "به دریای مصر اندرون شست اوست"
  },
  {
    "poem_id": 1658,
    "vorder": 55,
    "position": 0,
    "text": "سر از راه پیچیده و داد نه"
  },
  {
    "poem_id": 1658,
    "vorder": 56,
    "position": 1,
    "text": "ز یزدان یکی را به دل یاد نه"
  },
  {
    "poem_id": 1658,
    "vorder": 57,
    "position": 0,
    "text": "جهانی گرفته به مشت اندرون"
  },
  {
    "poem_id": 1658,
    "vorder": 58,
    "position": 1,
    "text": "نژاد سماعیل ازو پر ز خون"
  },
  {
    "poem_id": 1658,
    "vorder": 59,
    "position": 0,
    "text": "سکندر ز نصر این سخنها شنید"
  },
  {
    "poem_id": 1658,
    "vorder": 60,
    "position": 1,
    "text": "ز تخم خزاعه هرانکس که دید"
  },
  {
    "poem_id": 1658,
    "vorder": 61,
    "position": 0,
    "text": "به تن کودکان را نماندش روان"
  },
  {
    "poem_id": 1658,
    "vorder": 62,
    "position": 1,
    "text": "نماندند زان تخمه کس در جهان"
  },
  {
    "poem_id": 1658,
    "vorder": 63,
    "position": 0,
    "text": "ز بیداد بستد حجاز و یمن"
  },
  {
    "poem_id": 1658,
    "vorder": 64,
    "position": 1,
    "text": "به رای و به مردان شمشیرزن"
  },
  {
    "poem_id": 1658,
    "vorder": 65,
    "position": 0,
    "text": "نژاد سماعیل را برکشید"
  },
  {
    "poem_id": 1658,
    "vorder": 66,
    "position": 1,
    "text": "هرانکس که او مهتری را سزید"
  },
  {
    "poem_id": 1658,
    "vorder": 67,
    "position": 0,
    "text": "پیاده درآمد به بیت‌الحرام"
  },
  {
    "poem_id": 1658,
    "vorder": 68,
    "position": 1,
    "text": "سماعیلیان زو شده شادکام"
  },
  {
    "poem_id": 1658,
    "vorder": 69,
    "position": 0,
    "text": "بهر پی که برداشت قیصر ز راه"
  },
  {
    "poem_id": 1658,
    "vorder": 70,
    "position": 1,
    "text": "همی ریخت دینار گنجور شاه"
  }
]