[
  {
    "poem_id": 1438,
    "vorder": 1,
    "position": 0,
    "text": "وزانجا سوی راه بنهاد روی"
  },
  {
    "poem_id": 1438,
    "vorder": 2,
    "position": 1,
    "text": "چنان چون بود مردم راه‌جوی"
  },
  {
    "poem_id": 1438,
    "vorder": 3,
    "position": 0,
    "text": "همی رفت پویان به جایی رسید"
  },
  {
    "poem_id": 1438,
    "vorder": 4,
    "position": 1,
    "text": "که اندر جهان روشنایی ندید"
  },
  {
    "poem_id": 1438,
    "vorder": 5,
    "position": 0,
    "text": "شب تیره چون روی زنگی سیاه"
  },
  {
    "poem_id": 1438,
    "vorder": 6,
    "position": 1,
    "text": "ستاره نه پیدا نه خورشید و ماه"
  },
  {
    "poem_id": 1438,
    "vorder": 7,
    "position": 0,
    "text": "تو خورشید گفتی به بند اندرست"
  },
  {
    "poem_id": 1438,
    "vorder": 8,
    "position": 1,
    "text": "ستاره به خم کمند اندرست"
  },
  {
    "poem_id": 1438,
    "vorder": 9,
    "position": 0,
    "text": "عنان رخش را داد و بنهاد روی"
  },
  {
    "poem_id": 1438,
    "vorder": 10,
    "position": 1,
    "text": "نه افراز دید از سیاهی نه جوی"
  },
  {
    "poem_id": 1438,
    "vorder": 11,
    "position": 0,
    "text": "وزانجا سوی روشنایی رسید"
  },
  {
    "poem_id": 1438,
    "vorder": 12,
    "position": 1,
    "text": "زمین پرنیان دید و یکسر خوید"
  },
  {
    "poem_id": 1438,
    "vorder": 13,
    "position": 0,
    "text": "جهانی ز پیری شده نوجوان"
  },
  {
    "poem_id": 1438,
    "vorder": 14,
    "position": 1,
    "text": "همه سبزه و آبهای روان"
  },
  {
    "poem_id": 1438,
    "vorder": 15,
    "position": 0,
    "text": "همه جامه بر برش چون آب بود"
  },
  {
    "poem_id": 1438,
    "vorder": 16,
    "position": 1,
    "text": "نیازش به آسایش و خواب بود"
  },
  {
    "poem_id": 1438,
    "vorder": 17,
    "position": 0,
    "text": "برون کرد ببر بیان از برش"
  },
  {
    "poem_id": 1438,
    "vorder": 18,
    "position": 1,
    "text": "به خوی اندرون غرقه بد مغفرش"
  },
  {
    "poem_id": 1438,
    "vorder": 19,
    "position": 0,
    "text": "بگسترد هر دو برِ آفتاب"
  },
  {
    "poem_id": 1438,
    "vorder": 20,
    "position": 1,
    "text": "به خواب و به آسایش آمد شتاب"
  },
  {
    "poem_id": 1438,
    "vorder": 21,
    "position": 0,
    "text": "لگام از سر رخش برداشت خوار"
  },
  {
    "poem_id": 1438,
    "vorder": 22,
    "position": 1,
    "text": "رها کرد بر خوید در کشتزار"
  },
  {
    "poem_id": 1438,
    "vorder": 23,
    "position": 0,
    "text": "بپوشید چون خشک شد خود و ببر"
  },
  {
    "poem_id": 1438,
    "vorder": 24,
    "position": 1,
    "text": "گیاکرد بستر بسان هژبر"
  },
  {
    "poem_id": 1438,
    "vorder": 25,
    "position": 0,
    "text": "بخفت و بیاسود از رنج تن"
  },
  {
    "poem_id": 1438,
    "vorder": 26,
    "position": 1,
    "text": "هم از رخش غم بد هم از خویشتن"
  },
  {
    "poem_id": 1438,
    "vorder": 27,
    "position": 0,
    "text": "چو در سبزه دید اسپ را دشتوان"
  },
  {
    "poem_id": 1438,
    "vorder": 28,
    "position": 1,
    "text": "گشاده زبان سوی او شد دوان"
  },
  {
    "poem_id": 1438,
    "vorder": 29,
    "position": 0,
    "text": "سوی رستم و رخش بنهاد روی"
  },
  {
    "poem_id": 1438,
    "vorder": 30,
    "position": 1,
    "text": "یکی چوب زد گرم بر پای اوی"
  },
  {
    "poem_id": 1438,
    "vorder": 31,
    "position": 0,
    "text": "چو از خواب بیدار شد پیلتن"
  },
  {
    "poem_id": 1438,
    "vorder": 32,
    "position": 1,
    "text": "بدو دشتوان گفت کای اهرمن"
  },
  {
    "poem_id": 1438,
    "vorder": 33,
    "position": 0,
    "text": "چرا اسپ بر خوید بگذاشتی"
  },
  {
    "poem_id": 1438,
    "vorder": 34,
    "position": 1,
    "text": "بر رنج نابرده برداشتی"
  },
  {
    "poem_id": 1438,
    "vorder": 35,
    "position": 0,
    "text": "ز گفتار او تیز شد مرد هوش"
  },
  {
    "poem_id": 1438,
    "vorder": 36,
    "position": 1,
    "text": "بجست و گرفتش یکایک دو گوش"
  },
  {
    "poem_id": 1438,
    "vorder": 37,
    "position": 0,
    "text": "بیفشرد و برکند هر دو ز بن"
  },
  {
    "poem_id": 1438,
    "vorder": 38,
    "position": 1,
    "text": "نگفت از بد و نیک با او سخن"
  },
  {
    "poem_id": 1438,
    "vorder": 39,
    "position": 0,
    "text": "سبک دشتبان گوش را برگرفت"
  },
  {
    "poem_id": 1438,
    "vorder": 40,
    "position": 1,
    "text": "غریوان و مانده ز رستم شگفت"
  },
  {
    "poem_id": 1438,
    "vorder": 41,
    "position": 0,
    "text": "بدان مرز اولاد بد پهلوان"
  },
  {
    "poem_id": 1438,
    "vorder": 42,
    "position": 1,
    "text": "یکی نامجوی دلیر و جوان"
  },
  {
    "poem_id": 1438,
    "vorder": 43,
    "position": 0,
    "text": "بشد دشتبان پیش او با خروش"
  },
  {
    "poem_id": 1438,
    "vorder": 44,
    "position": 1,
    "text": "پر از خون به دستش گرفته دو گوش"
  },
  {
    "poem_id": 1438,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت: «مردی چو دیو سیاه"
  },
  {
    "poem_id": 1438,
    "vorder": 46,
    "position": 1,
    "text": "پلنگینه جوشن از آهن کلاه؛"
  },
  {
    "poem_id": 1438,
    "vorder": 47,
    "position": 0,
    "text": "-همه دشت سرتاسر آهرمنست"
  },
  {
    "poem_id": 1438,
    "vorder": 48,
    "position": 1,
    "text": "وگر اژدها خفته بر جوشنست-"
  },
  {
    "poem_id": 1438,
    "vorder": 49,
    "position": 0,
    "text": "برفتم که اسپش برانم ز کشت"
  },
  {
    "poem_id": 1438,
    "vorder": 50,
    "position": 1,
    "text": "مرا خود به اسپ و به کشته نهشت:"
  },
  {
    "poem_id": 1438,
    "vorder": 51,
    "position": 0,
    "text": "مرا دید برجست و یافه نگفت"
  },
  {
    "poem_id": 1438,
    "vorder": 52,
    "position": 1,
    "text": "دو گوشم بکند و همانجا بخفت»"
  },
  {
    "poem_id": 1438,
    "vorder": 53,
    "position": 0,
    "text": "چو بشنید اولاد برگشت زود"
  },
  {
    "poem_id": 1438,
    "vorder": 54,
    "position": 1,
    "text": "برون آمد از درد دل همچو دود"
  },
  {
    "poem_id": 1438,
    "vorder": 55,
    "position": 0,
    "text": "که تا بنگرد کاو چه مردست خود"
  },
  {
    "poem_id": 1438,
    "vorder": 56,
    "position": 1,
    "text": "ابا او ز بهر چه کردست بد"
  },
  {
    "poem_id": 1438,
    "vorder": 57,
    "position": 0,
    "text": "همی گشت اولاد در مرغزار"
  },
  {
    "poem_id": 1438,
    "vorder": 58,
    "position": 1,
    "text": "ابا نامداران ز بهر شکار"
  },
  {
    "poem_id": 1438,
    "vorder": 59,
    "position": 0,
    "text": "چو از دشتبان این شگفتی شنید"
  },
  {
    "poem_id": 1438,
    "vorder": 60,
    "position": 1,
    "text": "به نخچیر گه بر پی شیر دید"
  },
  {
    "poem_id": 1438,
    "vorder": 61,
    "position": 0,
    "text": "عنان را بتابید با سرکشان"
  },
  {
    "poem_id": 1438,
    "vorder": 62,
    "position": 1,
    "text": "بدان سو که بود از تهمتن نشان"
  },
  {
    "poem_id": 1438,
    "vorder": 63,
    "position": 0,
    "text": "چو آمد به تنگ اندرون جنگجوی"
  },
  {
    "poem_id": 1438,
    "vorder": 64,
    "position": 1,
    "text": "تهمتن سوی رخش بنهاد روی"
  },
  {
    "poem_id": 1438,
    "vorder": 65,
    "position": 0,
    "text": "نشست از بر رخش و رخشنده تیغ"
  },
  {
    "poem_id": 1438,
    "vorder": 66,
    "position": 1,
    "text": "کشید و بیامد چو غُرّنده میغ"
  },
  {
    "poem_id": 1438,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت اولاد نام تو چیست"
  },
  {
    "poem_id": 1438,
    "vorder": 68,
    "position": 1,
    "text": "چه مردی و شاه و پناه تو کیست"
  },
  {
    "poem_id": 1438,
    "vorder": 69,
    "position": 0,
    "text": "نبایست کردن برین ره گذر"
  },
  {
    "poem_id": 1438,
    "vorder": 70,
    "position": 1,
    "text": "ره نره دیوان پرخاشخر"
  },
  {
    "poem_id": 1438,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت رستم که نام من: «ابر!»"
  },
  {
    "poem_id": 1438,
    "vorder": 72,
    "position": 1,
    "text": "(اگر ابر باشد به زور هژبر؛"
  },
  {
    "poem_id": 1438,
    "vorder": 73,
    "position": 0,
    "text": "همه نیزه و تیغ بار آورد"
  },
  {
    "poem_id": 1438,
    "vorder": 74,
    "position": 1,
    "text": "سران را سر اندر کنار آورد)"
  },
  {
    "poem_id": 1438,
    "vorder": 75,
    "position": 0,
    "text": "به گوش تو گر نام من بگذرد"
  },
  {
    "poem_id": 1438,
    "vorder": 76,
    "position": 1,
    "text": "دم و جان و خون و دلت بفسرد"
  },
  {
    "poem_id": 1438,
    "vorder": 77,
    "position": 0,
    "text": "نیامد به گوشت به هر انجمن"
  },
  {
    "poem_id": 1438,
    "vorder": 78,
    "position": 1,
    "text": "کمند و کمان گو پیلتن"
  },
  {
    "poem_id": 1438,
    "vorder": 79,
    "position": 0,
    "text": "هران مام کاو چون تو زاید پسر"
  },
  {
    "poem_id": 1438,
    "vorder": 80,
    "position": 1,
    "text": "کفن دوز خوانیمش ار مویه‌گر"
  },
  {
    "poem_id": 1438,
    "vorder": 81,
    "position": 0,
    "text": "تو با این سپه پیش من رانده‌ای"
  },
  {
    "poem_id": 1438,
    "vorder": 82,
    "position": 1,
    "text": "همی گو ز برگنبد افشانده‌ای"
  },
  {
    "poem_id": 1438,
    "vorder": 83,
    "position": 0,
    "text": "نهنگ بلا برکشید از نیام"
  },
  {
    "poem_id": 1438,
    "vorder": 84,
    "position": 1,
    "text": "بیاویخت از پیش زین خم خام"
  },
  {
    "poem_id": 1438,
    "vorder": 85,
    "position": 0,
    "text": "چو شیر اندر آمد میان بره"
  },
  {
    "poem_id": 1438,
    "vorder": 86,
    "position": 1,
    "text": "همه رزمگه شد ز کشته خره"
  },
  {
    "poem_id": 1438,
    "vorder": 87,
    "position": 0,
    "text": "به یک زخم دو دو سرافگند خوار"
  },
  {
    "poem_id": 1438,
    "vorder": 88,
    "position": 1,
    "text": "همی یافت از تن به یک تن چهار"
  },
  {
    "poem_id": 1438,
    "vorder": 89,
    "position": 0,
    "text": "سران را ز زخمش به خاک آورید"
  },
  {
    "poem_id": 1438,
    "vorder": 90,
    "position": 1,
    "text": "سر سرکشان زیر پی گسترید"
  },
  {
    "poem_id": 1438,
    "vorder": 91,
    "position": 0,
    "text": "در و دشت شد پر ز گرد سوار"
  },
  {
    "poem_id": 1438,
    "vorder": 92,
    "position": 1,
    "text": "پراگنده گشتند بر کوه و غار"
  },
  {
    "poem_id": 1438,
    "vorder": 93,
    "position": 0,
    "text": "همی گشت رستم چو پیل دژم"
  },
  {
    "poem_id": 1438,
    "vorder": 94,
    "position": 1,
    "text": "کمندی به بازو درون شصت خم"
  },
  {
    "poem_id": 1438,
    "vorder": 95,
    "position": 0,
    "text": "به اولاد چون رخش نزدیک شد"
  },
  {
    "poem_id": 1438,
    "vorder": 96,
    "position": 1,
    "text": "به کردار شب روز تاریک شد"
  },
  {
    "poem_id": 1438,
    "vorder": 97,
    "position": 0,
    "text": "بیفگند رستم کمند دراز"
  },
  {
    "poem_id": 1438,
    "vorder": 98,
    "position": 1,
    "text": "به خم اندر آمد سر سرفراز"
  },
  {
    "poem_id": 1438,
    "vorder": 99,
    "position": 0,
    "text": "از اسپ اندر آمد دو دستش ببست"
  },
  {
    "poem_id": 1438,
    "vorder": 100,
    "position": 1,
    "text": "بپیش اندر افگند و خود برنشست"
  },
  {
    "poem_id": 1438,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت اگر راست گویی سخن"
  },
  {
    "poem_id": 1438,
    "vorder": 102,
    "position": 1,
    "text": "ز کژی نه سر یابم از تو نه بن"
  },
  {
    "poem_id": 1438,
    "vorder": 103,
    "position": 0,
    "text": "نمایی مرا جای دیو سپید"
  },
  {
    "poem_id": 1438,
    "vorder": 104,
    "position": 1,
    "text": "همان جای پولاد غندی و بید"
  },
  {
    "poem_id": 1438,
    "vorder": 105,
    "position": 0,
    "text": "به جایی که بستست کاووس کی"
  },
  {
    "poem_id": 1438,
    "vorder": 106,
    "position": 1,
    "text": "کسی کاین بدیها فگندست پی"
  },
  {
    "poem_id": 1438,
    "vorder": 107,
    "position": 0,
    "text": "نمایی و پیدا کنی راستی"
  },
  {
    "poem_id": 1438,
    "vorder": 108,
    "position": 1,
    "text": "نیاری به کار اندرون کاستی"
  },
  {
    "poem_id": 1438,
    "vorder": 109,
    "position": 0,
    "text": "من این تخت و این تاج و گرز گران"
  },
  {
    "poem_id": 1438,
    "vorder": 110,
    "position": 1,
    "text": "بگردانم از شاه مازندران"
  },
  {
    "poem_id": 1438,
    "vorder": 111,
    "position": 0,
    "text": "تو باشی برین بوم و بر شهریار"
  },
  {
    "poem_id": 1438,
    "vorder": 112,
    "position": 1,
    "text": "ار ایدونک کژی نیاری بکار"
  },
  {
    "poem_id": 1438,
    "vorder": 113,
    "position": 0,
    "text": "بدو گفت اولاد دل را ز خشم"
  },
  {
    "poem_id": 1438,
    "vorder": 114,
    "position": 1,
    "text": "بپرداز و بگشای یکباره چشم"
  },
  {
    "poem_id": 1438,
    "vorder": 115,
    "position": 0,
    "text": "تن من مپرداز خیره ز جان"
  },
  {
    "poem_id": 1438,
    "vorder": 116,
    "position": 1,
    "text": "بیابی ز من هرچ خواهی همان"
  },
  {
    "poem_id": 1438,
    "vorder": 117,
    "position": 0,
    "text": "ترا خانهٔ بید و دیو سپید"
  },
  {
    "poem_id": 1438,
    "vorder": 118,
    "position": 1,
    "text": "نمایم من این را که دادی نوید"
  },
  {
    "poem_id": 1438,
    "vorder": 119,
    "position": 0,
    "text": "به جایی که بستست کاووس شاه"
  },
  {
    "poem_id": 1438,
    "vorder": 120,
    "position": 1,
    "text": "بگویم ترا یک به یک شهر و راه"
  },
  {
    "poem_id": 1438,
    "vorder": 121,
    "position": 0,
    "text": "از ایدر به نزدیک کاووس کی"
  },
  {
    "poem_id": 1438,
    "vorder": 122,
    "position": 1,
    "text": "صد افگنده بخشیده فرسنگ پی"
  },
  {
    "poem_id": 1438,
    "vorder": 123,
    "position": 0,
    "text": "وزانجا سوی دیو فرسنگ صد"
  },
  {
    "poem_id": 1438,
    "vorder": 124,
    "position": 1,
    "text": "بیاید یکی راه دشوار و بد"
  },
  {
    "poem_id": 1438,
    "vorder": 125,
    "position": 0,
    "text": "میان دو صد چاهساری شگفت"
  },
  {
    "poem_id": 1438,
    "vorder": 126,
    "position": 1,
    "text": "به پیمایش اندازه نتوان گرفت"
  },
  {
    "poem_id": 1438,
    "vorder": 127,
    "position": 0,
    "text": "میان دو کوهست این هول جای"
  },
  {
    "poem_id": 1438,
    "vorder": 128,
    "position": 1,
    "text": "نپرید بر آسمان بر همای"
  },
  {
    "poem_id": 1438,
    "vorder": 129,
    "position": 0,
    "text": "ز دیوان جنگی ده و دو هزار"
  },
  {
    "poem_id": 1438,
    "vorder": 130,
    "position": 1,
    "text": "به شب پاسبانند بر چاهسار"
  },
  {
    "poem_id": 1438,
    "vorder": 131,
    "position": 0,
    "text": "چو پولاد غندی سپهدار اوی"
  },
  {
    "poem_id": 1438,
    "vorder": 132,
    "position": 1,
    "text": "چو بیدست و سنجه نگهدار اوی"
  },
  {
    "poem_id": 1438,
    "vorder": 133,
    "position": 0,
    "text": "یکی کوه یابی مر او را به تن"
  },
  {
    "poem_id": 1438,
    "vorder": 134,
    "position": 1,
    "text": "بر و کتف و یالش بود ده رسن"
  },
  {
    "poem_id": 1438,
    "vorder": 135,
    "position": 0,
    "text": "ترا با چنین یال و دست و عنان"
  },
  {
    "poem_id": 1438,
    "vorder": 136,
    "position": 1,
    "text": "گذارندهٔ گرز و تیغ و سنان"
  },
  {
    "poem_id": 1438,
    "vorder": 137,
    "position": 0,
    "text": "چنین برز و بالا و این کار کرد"
  },
  {
    "poem_id": 1438,
    "vorder": 138,
    "position": 1,
    "text": "نه خوب است با دیو جستن نبرد"
  },
  {
    "poem_id": 1438,
    "vorder": 139,
    "position": 0,
    "text": "کزو بگذری سنگلاخست و دشت"
  },
  {
    "poem_id": 1438,
    "vorder": 140,
    "position": 1,
    "text": "که آهو بران ره نیارد گذشت"
  },
  {
    "poem_id": 1438,
    "vorder": 141,
    "position": 0,
    "text": "چو زو بگذری رود آبست پیش"
  },
  {
    "poem_id": 1438,
    "vorder": 142,
    "position": 1,
    "text": "که پهنای او بر دو فرسنگ بیش"
  },
  {
    "poem_id": 1438,
    "vorder": 143,
    "position": 0,
    "text": "کنارنگ دیوی نگهدار اوی"
  },
  {
    "poem_id": 1438,
    "vorder": 144,
    "position": 1,
    "text": "همه نره دیوان به فرمان اوی"
  },
  {
    "poem_id": 1438,
    "vorder": 145,
    "position": 0,
    "text": "وزان روی بزگوش تا نرم پای"
  },
  {
    "poem_id": 1438,
    "vorder": 146,
    "position": 1,
    "text": "چو فرسنگ سیصد کشیده سرای"
  },
  {
    "poem_id": 1438,
    "vorder": 147,
    "position": 0,
    "text": "ز بزگوش تا شاه مازندران"
  },
  {
    "poem_id": 1438,
    "vorder": 148,
    "position": 1,
    "text": "رهی زشت و فرسنگهای گران"
  },
  {
    "poem_id": 1438,
    "vorder": 149,
    "position": 0,
    "text": "پراگنده در پادشاهی سوار"
  },
  {
    "poem_id": 1438,
    "vorder": 150,
    "position": 1,
    "text": "همانا که هستند سیصدهزار"
  },
  {
    "poem_id": 1438,
    "vorder": 151,
    "position": 0,
    "text": "ز پیلان جنگی هزار و دویست"
  },
  {
    "poem_id": 1438,
    "vorder": 152,
    "position": 1,
    "text": "کزیشان به شهر اندرون جای نیست"
  },
  {
    "poem_id": 1438,
    "vorder": 153,
    "position": 0,
    "text": "نتابی تو تنها و گر ز آهنی"
  },
  {
    "poem_id": 1438,
    "vorder": 154,
    "position": 1,
    "text": "بسایدت سوهان آهرمنی"
  },
  {
    "poem_id": 1438,
    "vorder": 155,
    "position": 0,
    "text": "چنان لشکری با سلیح و درم"
  },
  {
    "poem_id": 1438,
    "vorder": 156,
    "position": 1,
    "text": "نبینی ازیشان یکی را دژم"
  },
  {
    "poem_id": 1438,
    "vorder": 157,
    "position": 0,
    "text": "بخندید رستم ز گفتار اوی"
  },
  {
    "poem_id": 1438,
    "vorder": 158,
    "position": 1,
    "text": "بدو گفت اگر با منی راه جوی"
  },
  {
    "poem_id": 1438,
    "vorder": 159,
    "position": 0,
    "text": "ببینی کزین یک تن پیلتن"
  },
  {
    "poem_id": 1438,
    "vorder": 160,
    "position": 1,
    "text": "چه آید بران نامدار انجمن"
  },
  {
    "poem_id": 1438,
    "vorder": 161,
    "position": 0,
    "text": "به نیروی یزدان پیروزگر"
  },
  {
    "poem_id": 1438,
    "vorder": 162,
    "position": 1,
    "text": "به بخت و به شمشیر تیز و هنر"
  },
  {
    "poem_id": 1438,
    "vorder": 163,
    "position": 0,
    "text": "چو بینند تاو بر و یال من"
  },
  {
    "poem_id": 1438,
    "vorder": 164,
    "position": 1,
    "text": "به جنگ اندرون زخم گوپال من"
  },
  {
    "poem_id": 1438,
    "vorder": 165,
    "position": 0,
    "text": "به درد پی و پوستشان از نهیب"
  },
  {
    "poem_id": 1438,
    "vorder": 166,
    "position": 1,
    "text": "عنان را ندانند باز از رکیب"
  },
  {
    "poem_id": 1438,
    "vorder": 167,
    "position": 0,
    "text": "ازان سو کجا هست کاووس کی"
  },
  {
    "poem_id": 1438,
    "vorder": 168,
    "position": 1,
    "text": "مرا راه بنمای و بردار پی"
  },
  {
    "poem_id": 1438,
    "vorder": 169,
    "position": 0,
    "text": "نیاسود تیره شب و پاک روز"
  },
  {
    "poem_id": 1438,
    "vorder": 170,
    "position": 1,
    "text": "همی راند تا پیش کوه اسپروز"
  },
  {
    "poem_id": 1438,
    "vorder": 171,
    "position": 0,
    "text": "بدانجا که کاووس لشکر کشید"
  },
  {
    "poem_id": 1438,
    "vorder": 172,
    "position": 1,
    "text": "ز دیوان جادو بدو بد رسید"
  },
  {
    "poem_id": 1438,
    "vorder": 173,
    "position": 0,
    "text": "چو یک نیمه بگذشت از تیره شب"
  },
  {
    "poem_id": 1438,
    "vorder": 174,
    "position": 1,
    "text": "خروش آمد از دشت و بانگ جلب"
  },
  {
    "poem_id": 1438,
    "vorder": 175,
    "position": 0,
    "text": "به مازندران آتش افروختند"
  },
  {
    "poem_id": 1438,
    "vorder": 176,
    "position": 1,
    "text": "به هر جای شمعی همی سوختند"
  },
  {
    "poem_id": 1438,
    "vorder": 177,
    "position": 0,
    "text": "تهمتن به اولاد گفت آن کجاست"
  },
  {
    "poem_id": 1438,
    "vorder": 178,
    "position": 1,
    "text": "که آتش برآمد همی چپ و راست"
  },
  {
    "poem_id": 1438,
    "vorder": 179,
    "position": 0,
    "text": "در شهر مازندران است گفت"
  },
  {
    "poem_id": 1438,
    "vorder": 180,
    "position": 1,
    "text": "که از شب دو بهره نیارند خفت"
  },
  {
    "poem_id": 1438,
    "vorder": 181,
    "position": 0,
    "text": "بدان جایگه باشد ارژنگ دیو"
  },
  {
    "poem_id": 1438,
    "vorder": 182,
    "position": 1,
    "text": "که هزمان برآید خروش و غریو"
  },
  {
    "poem_id": 1438,
    "vorder": 183,
    "position": 0,
    "text": "بخفت آن زمان رستم جنگجوی"
  },
  {
    "poem_id": 1438,
    "vorder": 184,
    "position": 1,
    "text": "چو خورشید تابنده بنمود روی"
  },
  {
    "poem_id": 1438,
    "vorder": 185,
    "position": 0,
    "text": "بپیچید اولاد را بر درخت"
  },
  {
    "poem_id": 1438,
    "vorder": 186,
    "position": 1,
    "text": "به خم کمندش درآویخت سخت"
  },
  {
    "poem_id": 1438,
    "vorder": 187,
    "position": 0,
    "text": "به زین اندر افگند گرز نیا"
  },
  {
    "poem_id": 1438,
    "vorder": 188,
    "position": 1,
    "text": "همی رفت یکدل پر از کیمیا"
  }
]