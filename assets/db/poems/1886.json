[
  {
    "poem_id": 1886,
    "vorder": 1,
    "position": 0,
    "text": "وزان پس جوان و خردمند زن"
  },
  {
    "poem_id": 1886,
    "vorder": 2,
    "position": 1,
    "text": "به آرام بنشست با رای زن"
  },
  {
    "poem_id": 1886,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت کامد یکی نو سخن"
  },
  {
    "poem_id": 1886,
    "vorder": 4,
    "position": 1,
    "text": "که جاوید بر دل نگردد کهن"
  },
  {
    "poem_id": 1886,
    "vorder": 5,
    "position": 0,
    "text": "جهاندار خاقان بیاراستست"
  },
  {
    "poem_id": 1886,
    "vorder": 6,
    "position": 1,
    "text": "سخنها ز هر گونه پیراستست"
  },
  {
    "poem_id": 1886,
    "vorder": 7,
    "position": 0,
    "text": "ازو نیست آهو بزرگست شاه"
  },
  {
    "poem_id": 1886,
    "vorder": 8,
    "position": 1,
    "text": "دلیر و خداوند توران سپاه"
  },
  {
    "poem_id": 1886,
    "vorder": 9,
    "position": 0,
    "text": "ولیکن چو با ترک ایرانیان"
  },
  {
    "poem_id": 1886,
    "vorder": 10,
    "position": 1,
    "text": "بکوشد که خویشی بود در میان"
  },
  {
    "poem_id": 1886,
    "vorder": 11,
    "position": 0,
    "text": "ز پیوند وز بند آن روزگار"
  },
  {
    "poem_id": 1886,
    "vorder": 12,
    "position": 1,
    "text": "غم و رنج بیند به فرجام کار"
  },
  {
    "poem_id": 1886,
    "vorder": 13,
    "position": 0,
    "text": "نگر تا سیاوش از افراسیاب"
  },
  {
    "poem_id": 1886,
    "vorder": 14,
    "position": 1,
    "text": "چه برخورد جز تابش آفتاب"
  },
  {
    "poem_id": 1886,
    "vorder": 15,
    "position": 0,
    "text": "سر خویش داد از نخستین بباد"
  },
  {
    "poem_id": 1886,
    "vorder": 16,
    "position": 1,
    "text": "جوانی که چون او ز مادر نزاد"
  },
  {
    "poem_id": 1886,
    "vorder": 17,
    "position": 0,
    "text": "همان نیز پور سیاوش چه کرد"
  },
  {
    "poem_id": 1886,
    "vorder": 18,
    "position": 1,
    "text": "ز توران و ایران برآورد گرد"
  },
  {
    "poem_id": 1886,
    "vorder": 19,
    "position": 0,
    "text": "بسازید تا ما ز ترکان نهان"
  },
  {
    "poem_id": 1886,
    "vorder": 20,
    "position": 1,
    "text": "به ایران بریم این سخن ناگهان"
  },
  {
    "poem_id": 1886,
    "vorder": 21,
    "position": 0,
    "text": "به گردوی من نامه‌ای کرده‌ام"
  },
  {
    "poem_id": 1886,
    "vorder": 22,
    "position": 1,
    "text": "هم از پیش تیمار این خورده‌ام"
  },
  {
    "poem_id": 1886,
    "vorder": 23,
    "position": 0,
    "text": "که بر شاه پیدا کند کار ما"
  },
  {
    "poem_id": 1886,
    "vorder": 24,
    "position": 1,
    "text": "بگوید ز رنج و ز تیمار ما"
  },
  {
    "poem_id": 1886,
    "vorder": 25,
    "position": 0,
    "text": "به نیروی یزدان چنو بشنود"
  },
  {
    "poem_id": 1886,
    "vorder": 26,
    "position": 1,
    "text": "بدین چرب گفتار من بگرود"
  },
  {
    "poem_id": 1886,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت هرکس که بانو توی"
  },
  {
    "poem_id": 1886,
    "vorder": 28,
    "position": 1,
    "text": "به ایران و چین پشت و بازو توی"
  },
  {
    "poem_id": 1886,
    "vorder": 29,
    "position": 0,
    "text": "نجنباندت کوه آهن ز جای"
  },
  {
    "poem_id": 1886,
    "vorder": 30,
    "position": 1,
    "text": "یلان را به مردی تویی رهنمای"
  },
  {
    "poem_id": 1886,
    "vorder": 31,
    "position": 0,
    "text": "ز مرد خردمند بیدارتر"
  },
  {
    "poem_id": 1886,
    "vorder": 32,
    "position": 1,
    "text": "ز دستور داننده هشیارتر"
  },
  {
    "poem_id": 1886,
    "vorder": 33,
    "position": 0,
    "text": "همه کهترانیم و فرمان تو راست"
  },
  {
    "poem_id": 1886,
    "vorder": 34,
    "position": 1,
    "text": "برین آرزو رای و پیمان تو راست"
  },
  {
    "poem_id": 1886,
    "vorder": 35,
    "position": 0,
    "text": "چو بشنید زیشان عرض رابخواند"
  },
  {
    "poem_id": 1886,
    "vorder": 36,
    "position": 1,
    "text": "درم داد و او را به دیوان نشاند"
  },
  {
    "poem_id": 1886,
    "vorder": 37,
    "position": 0,
    "text": "بیامد سپه سر به سر بنگرید"
  },
  {
    "poem_id": 1886,
    "vorder": 38,
    "position": 1,
    "text": "هزار و صد و شست یل برگزید"
  },
  {
    "poem_id": 1886,
    "vorder": 39,
    "position": 0,
    "text": "کزان هر سواری بهنگام کار"
  },
  {
    "poem_id": 1886,
    "vorder": 40,
    "position": 1,
    "text": "نبر گاشتندی سر از ده سوار"
  },
  {
    "poem_id": 1886,
    "vorder": 41,
    "position": 0,
    "text": "درم داد و آمد سوی خانه باز"
  },
  {
    "poem_id": 1886,
    "vorder": 42,
    "position": 1,
    "text": "چنین گفت با لشکر رزمساز"
  },
  {
    "poem_id": 1886,
    "vorder": 43,
    "position": 0,
    "text": "که هرکس که دید او دوال رکیب"
  },
  {
    "poem_id": 1886,
    "vorder": 44,
    "position": 1,
    "text": "نپیچد دل اندر فراز ونشیب"
  },
  {
    "poem_id": 1886,
    "vorder": 45,
    "position": 0,
    "text": "نترسد ز انبوه مردم کشان"
  },
  {
    "poem_id": 1886,
    "vorder": 46,
    "position": 1,
    "text": "گر از ابر باشد برو سرفشان"
  },
  {
    "poem_id": 1886,
    "vorder": 47,
    "position": 0,
    "text": "به توران غریبیم و بی پشت و یار"
  },
  {
    "poem_id": 1886,
    "vorder": 48,
    "position": 1,
    "text": "میان بزرگان چنین سست و خوار"
  },
  {
    "poem_id": 1886,
    "vorder": 49,
    "position": 0,
    "text": "همی‌رفت خواهم چو تیره شود"
  },
  {
    "poem_id": 1886,
    "vorder": 50,
    "position": 1,
    "text": "سر دشمن از خواب خیره شود"
  },
  {
    "poem_id": 1886,
    "vorder": 51,
    "position": 0,
    "text": "شما دل به رفتن مدارید تنگ"
  },
  {
    "poem_id": 1886,
    "vorder": 52,
    "position": 1,
    "text": "که از چینیان لشکر آید به جنگ"
  },
  {
    "poem_id": 1886,
    "vorder": 53,
    "position": 0,
    "text": "که خود بی‌گمان از پس من سران"
  },
  {
    "poem_id": 1886,
    "vorder": 54,
    "position": 1,
    "text": "بیایند با گرزهای گران"
  },
  {
    "poem_id": 1886,
    "vorder": 55,
    "position": 0,
    "text": "همه جان یکایک به کف برنهید"
  },
  {
    "poem_id": 1886,
    "vorder": 56,
    "position": 1,
    "text": "اگر لشکر آید دمید و دهید"
  },
  {
    "poem_id": 1886,
    "vorder": 57,
    "position": 0,
    "text": "وگر بر چنین رویتان نیست رای"
  },
  {
    "poem_id": 1886,
    "vorder": 58,
    "position": 1,
    "text": "از ایدر مجنبید یک تن زجای"
  },
  {
    "poem_id": 1886,
    "vorder": 59,
    "position": 0,
    "text": "به آواز گفتند ما کهتریم"
  },
  {
    "poem_id": 1886,
    "vorder": 60,
    "position": 1,
    "text": "ز رای و ز فرمان تو نگذریم"
  },
  {
    "poem_id": 1886,
    "vorder": 61,
    "position": 0,
    "text": "برین برنهادند و برخاستند"
  },
  {
    "poem_id": 1886,
    "vorder": 62,
    "position": 1,
    "text": "همه جنگ چین را بیاراستند"
  },
  {
    "poem_id": 1886,
    "vorder": 63,
    "position": 0,
    "text": "یلان سینه و مهر و ایزد گشسپ"
  },
  {
    "poem_id": 1886,
    "vorder": 64,
    "position": 1,
    "text": "نشستند با نامداران بر اسپ"
  },
  {
    "poem_id": 1886,
    "vorder": 65,
    "position": 0,
    "text": "همی‌گفت هرکس که مردن به نام"
  },
  {
    "poem_id": 1886,
    "vorder": 66,
    "position": 1,
    "text": "به از زنده و چینیان شادکام"
  },
  {
    "poem_id": 1886,
    "vorder": 67,
    "position": 0,
    "text": "هم آنگه سوی کاروان برگذشت"
  },
  {
    "poem_id": 1886,
    "vorder": 68,
    "position": 1,
    "text": "شترخواست تاپیش او شد ز دشت"
  },
  {
    "poem_id": 1886,
    "vorder": 69,
    "position": 0,
    "text": "گزین کرد زان اشتران سه هزار"
  },
  {
    "poem_id": 1886,
    "vorder": 70,
    "position": 1,
    "text": "بدان تا بنه برنهادند و بار"
  },
  {
    "poem_id": 1886,
    "vorder": 71,
    "position": 0,
    "text": "چو شب تیره شد گردیه برنشست"
  },
  {
    "poem_id": 1886,
    "vorder": 72,
    "position": 1,
    "text": "چو گردی سرافراز و گرزی بدست"
  },
  {
    "poem_id": 1886,
    "vorder": 73,
    "position": 0,
    "text": "برافگند پر مایه برگستوان"
  },
  {
    "poem_id": 1886,
    "vorder": 74,
    "position": 1,
    "text": "ابا جوشن و تیغ و ترگ گوان"
  },
  {
    "poem_id": 1886,
    "vorder": 75,
    "position": 0,
    "text": "همی‌راند چون باد لشکر به راه"
  },
  {
    "poem_id": 1886,
    "vorder": 76,
    "position": 1,
    "text": "به رخشنده روز و شبان سیاه"
  }
]