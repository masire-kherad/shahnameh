[
  {
    "poem_id": 1431,
    "vorder": 1,
    "position": 0,
    "text": "همی رفت پیش اندرون زال زر"
  },
  {
    "poem_id": 1431,
    "vorder": 2,
    "position": 1,
    "text": "پس او بزرگان زرین کمر"
  },
  {
    "poem_id": 1431,
    "vorder": 3,
    "position": 0,
    "text": "چو کاووس را دید دستان سام"
  },
  {
    "poem_id": 1431,
    "vorder": 4,
    "position": 1,
    "text": "نشسته بر اورنگ بر شادکام"
  },
  {
    "poem_id": 1431,
    "vorder": 5,
    "position": 0,
    "text": "به کش کرده دست و سرافگنده پست"
  },
  {
    "poem_id": 1431,
    "vorder": 6,
    "position": 1,
    "text": "همی رفت تا جایگاه نشست"
  },
  {
    "poem_id": 1431,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت کای کدخدای جهان"
  },
  {
    "poem_id": 1431,
    "vorder": 8,
    "position": 1,
    "text": "سرافراز بر مهتران و مهان"
  },
  {
    "poem_id": 1431,
    "vorder": 9,
    "position": 0,
    "text": "چو تخت تو نشنید و افسر ندید"
  },
  {
    "poem_id": 1431,
    "vorder": 10,
    "position": 1,
    "text": "نه چون بخت تو چرخ گردان شنید"
  },
  {
    "poem_id": 1431,
    "vorder": 11,
    "position": 0,
    "text": "همه ساله پیروز بادی و شاد"
  },
  {
    "poem_id": 1431,
    "vorder": 12,
    "position": 1,
    "text": "سرت پر ز دانش دلت پر ز داد"
  },
  {
    "poem_id": 1431,
    "vorder": 13,
    "position": 0,
    "text": "شه نامبردار بنواختش"
  },
  {
    "poem_id": 1431,
    "vorder": 14,
    "position": 1,
    "text": "بر خویش بر تخت بنشاختش"
  },
  {
    "poem_id": 1431,
    "vorder": 15,
    "position": 0,
    "text": "بپرسیدش از رنج راه دراز"
  },
  {
    "poem_id": 1431,
    "vorder": 16,
    "position": 1,
    "text": "ز گردان و از رستم سرفراز"
  },
  {
    "poem_id": 1431,
    "vorder": 17,
    "position": 0,
    "text": "چنین گفت مر شاه را زال زر"
  },
  {
    "poem_id": 1431,
    "vorder": 18,
    "position": 1,
    "text": "که نوشه بدی شاه و پیروزگر"
  },
  {
    "poem_id": 1431,
    "vorder": 19,
    "position": 0,
    "text": "همه شاد و روشن به بخت تواند"
  },
  {
    "poem_id": 1431,
    "vorder": 20,
    "position": 1,
    "text": "برافراخته سر به تخت تواند"
  },
  {
    "poem_id": 1431,
    "vorder": 21,
    "position": 0,
    "text": "ازان پس یکی داستان کرد یاد"
  },
  {
    "poem_id": 1431,
    "vorder": 22,
    "position": 1,
    "text": "سخنهای شایسته را در گشاد"
  },
  {
    "poem_id": 1431,
    "vorder": 23,
    "position": 0,
    "text": "چنین گفت کای پادشاه جهان"
  },
  {
    "poem_id": 1431,
    "vorder": 24,
    "position": 1,
    "text": "سزاوار تختی و تاج مهان"
  },
  {
    "poem_id": 1431,
    "vorder": 25,
    "position": 0,
    "text": "ز تو پیشتر پادشه بوده‌اند"
  },
  {
    "poem_id": 1431,
    "vorder": 26,
    "position": 1,
    "text": "که این راه هرگز نپیموده‌اند"
  },
  {
    "poem_id": 1431,
    "vorder": 27,
    "position": 0,
    "text": "که بر سر مرا روز چندی گذشت"
  },
  {
    "poem_id": 1431,
    "vorder": 28,
    "position": 1,
    "text": "سپهر از بر خاک چندی بگشت"
  },
  {
    "poem_id": 1431,
    "vorder": 29,
    "position": 0,
    "text": "منوچهر شد زین جهان فراخ"
  },
  {
    "poem_id": 1431,
    "vorder": 30,
    "position": 1,
    "text": "ازو ماند ایدر بسی گنج و کاخ"
  },
  {
    "poem_id": 1431,
    "vorder": 31,
    "position": 0,
    "text": "همان زو و با نوذر و کیقباد"
  },
  {
    "poem_id": 1431,
    "vorder": 32,
    "position": 1,
    "text": "چه مایه بزرگان که داریم یاد"
  },
  {
    "poem_id": 1431,
    "vorder": 33,
    "position": 0,
    "text": "ابا لشکر گشن و گرز گران"
  },
  {
    "poem_id": 1431,
    "vorder": 34,
    "position": 1,
    "text": "نکردند آهنگ مازندران"
  },
  {
    "poem_id": 1431,
    "vorder": 35,
    "position": 0,
    "text": "که آن خانهٔ دیو افسونگرست"
  },
  {
    "poem_id": 1431,
    "vorder": 36,
    "position": 1,
    "text": "طلسمست و ز بند جادو درست"
  },
  {
    "poem_id": 1431,
    "vorder": 37,
    "position": 0,
    "text": "مران را به شمشیر نتوان شکست"
  },
  {
    "poem_id": 1431,
    "vorder": 38,
    "position": 1,
    "text": "به گنج و به دانش نیاید به دست"
  },
  {
    "poem_id": 1431,
    "vorder": 39,
    "position": 0,
    "text": "هم آن را به نیرنگ نتوان گشاد"
  },
  {
    "poem_id": 1431,
    "vorder": 40,
    "position": 1,
    "text": "مده رنج و گنج و درم را به باد"
  },
  {
    "poem_id": 1431,
    "vorder": 41,
    "position": 0,
    "text": "همایون ندارد کس آنجا شدن"
  },
  {
    "poem_id": 1431,
    "vorder": 42,
    "position": 1,
    "text": "وزایدر کنون رای رفتن زدن"
  },
  {
    "poem_id": 1431,
    "vorder": 43,
    "position": 0,
    "text": "سپه را بران سو نباید کشید"
  },
  {
    "poem_id": 1431,
    "vorder": 44,
    "position": 1,
    "text": "ز شاهان کس این رای هرگز ندید"
  },
  {
    "poem_id": 1431,
    "vorder": 45,
    "position": 0,
    "text": "گرین نامداران ترا کهترند"
  },
  {
    "poem_id": 1431,
    "vorder": 46,
    "position": 1,
    "text": "چنین بندهٔ دادگر داورند"
  },
  {
    "poem_id": 1431,
    "vorder": 47,
    "position": 0,
    "text": "تو از خون چندین سرنامدار"
  },
  {
    "poem_id": 1431,
    "vorder": 48,
    "position": 1,
    "text": "ز بهر فزونی درختی مکار"
  },
  {
    "poem_id": 1431,
    "vorder": 49,
    "position": 0,
    "text": "که بار و بلندیش نفرین بود"
  },
  {
    "poem_id": 1431,
    "vorder": 50,
    "position": 1,
    "text": "نه آیین شاهان پیشین بود"
  },
  {
    "poem_id": 1431,
    "vorder": 51,
    "position": 0,
    "text": "چنین پاسخ آورد کاووس باز"
  },
  {
    "poem_id": 1431,
    "vorder": 52,
    "position": 1,
    "text": "کز اندیشهٔ تو نیم بی‌نیاز"
  },
  {
    "poem_id": 1431,
    "vorder": 53,
    "position": 0,
    "text": "ولیکن من از آفریدون و جم"
  },
  {
    "poem_id": 1431,
    "vorder": 54,
    "position": 1,
    "text": "فزونم به مردی و فر و درم"
  },
  {
    "poem_id": 1431,
    "vorder": 55,
    "position": 0,
    "text": "همان از منوچهر و از کیقباد"
  },
  {
    "poem_id": 1431,
    "vorder": 56,
    "position": 1,
    "text": "که مازندران را نکردند یاد"
  },
  {
    "poem_id": 1431,
    "vorder": 57,
    "position": 0,
    "text": "سپاه و دل و گنجم افزونترست"
  },
  {
    "poem_id": 1431,
    "vorder": 58,
    "position": 1,
    "text": "جهان زیر شمشیر تیز اندرست"
  },
  {
    "poem_id": 1431,
    "vorder": 59,
    "position": 0,
    "text": "چو بردانشی شد گشاده جهان"
  },
  {
    "poem_id": 1431,
    "vorder": 60,
    "position": 1,
    "text": "به آهن چه داریم گیتی نهان"
  },
  {
    "poem_id": 1431,
    "vorder": 61,
    "position": 0,
    "text": "شوم‌شان یکایک به راه آورم"
  },
  {
    "poem_id": 1431,
    "vorder": 62,
    "position": 1,
    "text": "گر آیین شمشیر و گاه آورم"
  },
  {
    "poem_id": 1431,
    "vorder": 63,
    "position": 0,
    "text": "اگر کس نمانم به مازندران"
  },
  {
    "poem_id": 1431,
    "vorder": 64,
    "position": 1,
    "text": "وگر بر نهم باژ و ساو گران"
  },
  {
    "poem_id": 1431,
    "vorder": 65,
    "position": 0,
    "text": "چنان زار و خوارند بر چشم من"
  },
  {
    "poem_id": 1431,
    "vorder": 66,
    "position": 1,
    "text": "چه جادو چه دیوان آن انجمن"
  },
  {
    "poem_id": 1431,
    "vorder": 67,
    "position": 0,
    "text": "به گوش تو آید خود این آگهی"
  },
  {
    "poem_id": 1431,
    "vorder": 68,
    "position": 1,
    "text": "کزیشان شود روی گیتی تهی"
  },
  {
    "poem_id": 1431,
    "vorder": 69,
    "position": 0,
    "text": "تو با رستم ایدر جهاندار باش"
  },
  {
    "poem_id": 1431,
    "vorder": 70,
    "position": 1,
    "text": "نگهبان ایران و بیدار باش"
  },
  {
    "poem_id": 1431,
    "vorder": 71,
    "position": 0,
    "text": "جهان آفریننده یار منست"
  },
  {
    "poem_id": 1431,
    "vorder": 72,
    "position": 1,
    "text": "سر نره دیوان شکار منست"
  },
  {
    "poem_id": 1431,
    "vorder": 73,
    "position": 0,
    "text": "گرایدونک یارم نباشی به جنگ"
  },
  {
    "poem_id": 1431,
    "vorder": 74,
    "position": 1,
    "text": "مفرمای ما را بدین در درنگ"
  },
  {
    "poem_id": 1431,
    "vorder": 75,
    "position": 0,
    "text": "چو از شاه بنشنید زال این سخن"
  },
  {
    "poem_id": 1431,
    "vorder": 76,
    "position": 1,
    "text": "ندید ایچ پیدا سرش را ز بن"
  },
  {
    "poem_id": 1431,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت شاهی و ما بنده‌ایم"
  },
  {
    "poem_id": 1431,
    "vorder": 78,
    "position": 1,
    "text": "به دلسوزگی با تو گوینده‌ایم"
  },
  {
    "poem_id": 1431,
    "vorder": 79,
    "position": 0,
    "text": "اگر داد فرمان دهی گر ستم"
  },
  {
    "poem_id": 1431,
    "vorder": 80,
    "position": 1,
    "text": "برای تو باید زدن گام و دم"
  },
  {
    "poem_id": 1431,
    "vorder": 81,
    "position": 0,
    "text": "از اندیشه دل را بپرداختم"
  },
  {
    "poem_id": 1431,
    "vorder": 82,
    "position": 1,
    "text": "سخن آنچ دانستم انداختم"
  },
  {
    "poem_id": 1431,
    "vorder": 83,
    "position": 0,
    "text": "نه مرگ از تن خویش بتوان سپوخت"
  },
  {
    "poem_id": 1431,
    "vorder": 84,
    "position": 1,
    "text": "نه چشم جهان کس به سوزن بدوخت"
  },
  {
    "poem_id": 1431,
    "vorder": 85,
    "position": 0,
    "text": "به پرهیز هم کس نجست از نیاز"
  },
  {
    "poem_id": 1431,
    "vorder": 86,
    "position": 1,
    "text": "جهانجوی ازین سه نیابد جواز"
  },
  {
    "poem_id": 1431,
    "vorder": 87,
    "position": 0,
    "text": "همیشه جهان بر تو فرخنده باد"
  },
  {
    "poem_id": 1431,
    "vorder": 88,
    "position": 1,
    "text": "مبادا که پند من آیدت یاد"
  },
  {
    "poem_id": 1431,
    "vorder": 89,
    "position": 0,
    "text": "پشیمان مبادی ز کردار خویش"
  },
  {
    "poem_id": 1431,
    "vorder": 90,
    "position": 1,
    "text": "به تو باد روشن دل و دین و کیش"
  },
  {
    "poem_id": 1431,
    "vorder": 91,
    "position": 0,
    "text": "سبک شاه را زال پدرود کرد"
  },
  {
    "poem_id": 1431,
    "vorder": 92,
    "position": 1,
    "text": "دل از رفتن او پر از دود کرد"
  },
  {
    "poem_id": 1431,
    "vorder": 93,
    "position": 0,
    "text": "برون آمد از پیش کاووس شاه"
  },
  {
    "poem_id": 1431,
    "vorder": 94,
    "position": 1,
    "text": "شده تیره بر چشم او هور و ماه"
  },
  {
    "poem_id": 1431,
    "vorder": 95,
    "position": 0,
    "text": "برفتند با او بزرگان نیو"
  },
  {
    "poem_id": 1431,
    "vorder": 96,
    "position": 1,
    "text": "چو طوس و چو گودرز و رهام و گیو"
  },
  {
    "poem_id": 1431,
    "vorder": 97,
    "position": 0,
    "text": "به زال آنگهی گفت گیو از خدای"
  },
  {
    "poem_id": 1431,
    "vorder": 98,
    "position": 1,
    "text": "همی خواهم آنک او بود رهنمای"
  },
  {
    "poem_id": 1431,
    "vorder": 99,
    "position": 0,
    "text": "به جایی که کاووس را دسترس"
  },
  {
    "poem_id": 1431,
    "vorder": 100,
    "position": 1,
    "text": "نباشد ندارم مر او را به کس"
  },
  {
    "poem_id": 1431,
    "vorder": 101,
    "position": 0,
    "text": "ز تو دور باد آز و چشم نیاز"
  },
  {
    "poem_id": 1431,
    "vorder": 102,
    "position": 1,
    "text": "مبادا به تو دست دشمن دراز"
  },
  {
    "poem_id": 1431,
    "vorder": 103,
    "position": 0,
    "text": "به هر سو که آییم و اندر شویم"
  },
  {
    "poem_id": 1431,
    "vorder": 104,
    "position": 1,
    "text": "جز او آفرینت سخن نشنویم"
  },
  {
    "poem_id": 1431,
    "vorder": 105,
    "position": 0,
    "text": "پس از کردگار جهان‌آفرین"
  },
  {
    "poem_id": 1431,
    "vorder": 106,
    "position": 1,
    "text": "به تو دارد امید ایران زمین"
  },
  {
    "poem_id": 1431,
    "vorder": 107,
    "position": 0,
    "text": "ز بهر گوان رنج برداشتی"
  },
  {
    "poem_id": 1431,
    "vorder": 108,
    "position": 1,
    "text": "چنین راه دشوار بگذاشتی"
  },
  {
    "poem_id": 1431,
    "vorder": 109,
    "position": 0,
    "text": "پس آنگه گرفتندش اندر کنار"
  },
  {
    "poem_id": 1431,
    "vorder": 110,
    "position": 1,
    "text": "ره سیستان را برآراست کار"
  }
]