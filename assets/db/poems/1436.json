[
  {
    "poem_id": 1436,
    "vorder": 1,
    "position": 0,
    "text": "ز دشت اندر آمد یکی اژدها"
  },
  {
    "poem_id": 1436,
    "vorder": 2,
    "position": 1,
    "text": "کزو پیل گفتی نیابد رها"
  },
  {
    "poem_id": 1436,
    "vorder": 3,
    "position": 0,
    "text": "بدان جایگه بودش آرامگاه"
  },
  {
    "poem_id": 1436,
    "vorder": 4,
    "position": 1,
    "text": "نکردی ز بیمش برو دیو راه"
  },
  {
    "poem_id": 1436,
    "vorder": 5,
    "position": 0,
    "text": "بیامد جهانجوی را خفته دید"
  },
  {
    "poem_id": 1436,
    "vorder": 6,
    "position": 1,
    "text": "بر او یکی اسپ آشفته دید"
  },
  {
    "poem_id": 1436,
    "vorder": 7,
    "position": 0,
    "text": "پر اندیشه شد تا چه آمد پدید"
  },
  {
    "poem_id": 1436,
    "vorder": 8,
    "position": 1,
    "text": "که یارد بدین جایگاه آرمید"
  },
  {
    "poem_id": 1436,
    "vorder": 9,
    "position": 0,
    "text": "نیارست کردن کس آنجا گذر"
  },
  {
    "poem_id": 1436,
    "vorder": 10,
    "position": 1,
    "text": "ز دیوان و پیلان و شیران نر"
  },
  {
    "poem_id": 1436,
    "vorder": 11,
    "position": 0,
    "text": "همان نیز کامد نیابد رها"
  },
  {
    "poem_id": 1436,
    "vorder": 12,
    "position": 1,
    "text": "ز چنگ بداندیش نر اژدها"
  },
  {
    "poem_id": 1436,
    "vorder": 13,
    "position": 0,
    "text": "سوی رخش رخشنده بنهاد روی"
  },
  {
    "poem_id": 1436,
    "vorder": 14,
    "position": 1,
    "text": "دوان اسپ شد سوی دیهیم جوی"
  },
  {
    "poem_id": 1436,
    "vorder": 15,
    "position": 0,
    "text": "همی کوفت بر خاک رویینه سم"
  },
  {
    "poem_id": 1436,
    "vorder": 16,
    "position": 1,
    "text": "چو تندر خروشید و افشاند دم"
  },
  {
    "poem_id": 1436,
    "vorder": 17,
    "position": 0,
    "text": "تهمتن چو از خواب بیدار شد"
  },
  {
    "poem_id": 1436,
    "vorder": 18,
    "position": 1,
    "text": "سر پر خرد پر ز پیکار شد"
  },
  {
    "poem_id": 1436,
    "vorder": 19,
    "position": 0,
    "text": "به گرد بیابان یکی بنگرید"
  },
  {
    "poem_id": 1436,
    "vorder": 20,
    "position": 1,
    "text": "شد آن اژدهای دژم ناپدید"
  },
  {
    "poem_id": 1436,
    "vorder": 21,
    "position": 0,
    "text": "ابا رخش بر خیره پیکار کرد"
  },
  {
    "poem_id": 1436,
    "vorder": 22,
    "position": 1,
    "text": "ازان کاو سرخفته بیدار کرد"
  },
  {
    "poem_id": 1436,
    "vorder": 23,
    "position": 0,
    "text": "دگر باره چون شد به خواب اندرون"
  },
  {
    "poem_id": 1436,
    "vorder": 24,
    "position": 1,
    "text": "ز تاریکی آن اژدها شد برون"
  },
  {
    "poem_id": 1436,
    "vorder": 25,
    "position": 0,
    "text": "به بالین رستم تگ آورد رخش"
  },
  {
    "poem_id": 1436,
    "vorder": 26,
    "position": 1,
    "text": "همی کند خاک و همی کرد پخش"
  },
  {
    "poem_id": 1436,
    "vorder": 27,
    "position": 0,
    "text": "دگرباره بیدار شد خفته مرد"
  },
  {
    "poem_id": 1436,
    "vorder": 28,
    "position": 1,
    "text": "برآشفت و رخسارگان کرد زرد"
  },
  {
    "poem_id": 1436,
    "vorder": 29,
    "position": 0,
    "text": "بیابان همه سر به سر بنگرید"
  },
  {
    "poem_id": 1436,
    "vorder": 30,
    "position": 1,
    "text": "بجز تیرگی شب به دیده ندید"
  },
  {
    "poem_id": 1436,
    "vorder": 31,
    "position": 0,
    "text": "بدان مهربان رخش بیدار گفت"
  },
  {
    "poem_id": 1436,
    "vorder": 32,
    "position": 1,
    "text": "که تاریکی شب بخواهی نهفت"
  },
  {
    "poem_id": 1436,
    "vorder": 33,
    "position": 0,
    "text": "سرم را همی باز داری ز خواب"
  },
  {
    "poem_id": 1436,
    "vorder": 34,
    "position": 1,
    "text": "به بیداری من گرفتت شتاب"
  },
  {
    "poem_id": 1436,
    "vorder": 35,
    "position": 0,
    "text": "گر این‌بار سازی چنین رستخیز"
  },
  {
    "poem_id": 1436,
    "vorder": 36,
    "position": 1,
    "text": "سرت را ببرم به شمشیر تیز"
  },
  {
    "poem_id": 1436,
    "vorder": 37,
    "position": 0,
    "text": "پیاده شوم سوی مازندران"
  },
  {
    "poem_id": 1436,
    "vorder": 38,
    "position": 1,
    "text": "کشم ببر و شمشمیر و گرز گران"
  },
  {
    "poem_id": 1436,
    "vorder": 39,
    "position": 0,
    "text": "سیم ره به خواب اندر آمد سرش"
  },
  {
    "poem_id": 1436,
    "vorder": 40,
    "position": 1,
    "text": "ز ببر بیان داشت پوشش برش"
  },
  {
    "poem_id": 1436,
    "vorder": 41,
    "position": 0,
    "text": "بغرید باز اژدهای دژم"
  },
  {
    "poem_id": 1436,
    "vorder": 42,
    "position": 1,
    "text": "همی آتش افروخت گفتی بدم"
  },
  {
    "poem_id": 1436,
    "vorder": 43,
    "position": 0,
    "text": "چراگاه بگذاشت رخش آنزمان"
  },
  {
    "poem_id": 1436,
    "vorder": 44,
    "position": 1,
    "text": "نیارست رفتن بر پهلوان"
  },
  {
    "poem_id": 1436,
    "vorder": 45,
    "position": 0,
    "text": "دلش زان شگفتی به دو نیم بود"
  },
  {
    "poem_id": 1436,
    "vorder": 46,
    "position": 1,
    "text": "کش از رستم و اژدها بیم بود"
  },
  {
    "poem_id": 1436,
    "vorder": 47,
    "position": 0,
    "text": "هم از بهر رستم دلش نارمید"
  },
  {
    "poem_id": 1436,
    "vorder": 48,
    "position": 1,
    "text": "چو باد دمان نزد رستم دوید"
  },
  {
    "poem_id": 1436,
    "vorder": 49,
    "position": 0,
    "text": "خروشید و جوشید و برکند خاک"
  },
  {
    "poem_id": 1436,
    "vorder": 50,
    "position": 1,
    "text": "ز نعلش زمین شد همه چاک چاک"
  },
  {
    "poem_id": 1436,
    "vorder": 51,
    "position": 0,
    "text": "چو بیدار شد رستم از خواب خوش"
  },
  {
    "poem_id": 1436,
    "vorder": 52,
    "position": 1,
    "text": "برآشفت با بارهٔ دستکش"
  },
  {
    "poem_id": 1436,
    "vorder": 53,
    "position": 0,
    "text": "چنان ساخت روشن جهان‌آفرین"
  },
  {
    "poem_id": 1436,
    "vorder": 54,
    "position": 1,
    "text": "که پنهان نکرد اژدها را زمین"
  },
  {
    "poem_id": 1436,
    "vorder": 55,
    "position": 0,
    "text": "برآن تیرگی رستم او را بدید"
  },
  {
    "poem_id": 1436,
    "vorder": 56,
    "position": 1,
    "text": "سبک تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 1436,
    "vorder": 57,
    "position": 0,
    "text": "بغرید برسان ابر بهار"
  },
  {
    "poem_id": 1436,
    "vorder": 58,
    "position": 1,
    "text": "زمین کرد پر آتش از کارزار"
  },
  {
    "poem_id": 1436,
    "vorder": 59,
    "position": 0,
    "text": "بدان اژدها گفت بر گوی نام"
  },
  {
    "poem_id": 1436,
    "vorder": 60,
    "position": 1,
    "text": "کزین پس تو گیتی نبینی به کام"
  },
  {
    "poem_id": 1436,
    "vorder": 61,
    "position": 0,
    "text": "نباید که بی‌نام بر دست من"
  },
  {
    "poem_id": 1436,
    "vorder": 62,
    "position": 1,
    "text": "روانت برآید ز تاریک تن"
  },
  {
    "poem_id": 1436,
    "vorder": 63,
    "position": 0,
    "text": "چنین گفت دژخیم نر اژدها"
  },
  {
    "poem_id": 1436,
    "vorder": 64,
    "position": 1,
    "text": "که از چنگ من کس نیابد رها"
  },
  {
    "poem_id": 1436,
    "vorder": 65,
    "position": 0,
    "text": "صداندرصد از دشت جای منست"
  },
  {
    "poem_id": 1436,
    "vorder": 66,
    "position": 1,
    "text": "بلند آسمانش هوای منست"
  },
  {
    "poem_id": 1436,
    "vorder": 67,
    "position": 0,
    "text": "نیارد گذشتن به سر بر عقاب"
  },
  {
    "poem_id": 1436,
    "vorder": 68,
    "position": 1,
    "text": "ستاره نبیند زمینش به خواب"
  },
  {
    "poem_id": 1436,
    "vorder": 69,
    "position": 0,
    "text": "بدو اژدها گفت نام تو چیست"
  },
  {
    "poem_id": 1436,
    "vorder": 70,
    "position": 1,
    "text": "که زاینده را بر تو باید گریست"
  },
  {
    "poem_id": 1436,
    "vorder": 71,
    "position": 0,
    "text": "چنین داد پاسخ که من رستمم"
  },
  {
    "poem_id": 1436,
    "vorder": 72,
    "position": 1,
    "text": "ز دستان و از سام و از نیرمم"
  },
  {
    "poem_id": 1436,
    "vorder": 73,
    "position": 0,
    "text": "به تنها یکی کینه‌ور لشکرم"
  },
  {
    "poem_id": 1436,
    "vorder": 74,
    "position": 1,
    "text": "به رخش دلاور زمین بسپرم"
  },
  {
    "poem_id": 1436,
    "vorder": 75,
    "position": 0,
    "text": "برآویخت با او به جنگ اژدها"
  },
  {
    "poem_id": 1436,
    "vorder": 76,
    "position": 1,
    "text": "نیامد به فرجام هم زو رها"
  },
  {
    "poem_id": 1436,
    "vorder": 77,
    "position": 0,
    "text": "چو زور تن اژدها دید رخش"
  },
  {
    "poem_id": 1436,
    "vorder": 78,
    "position": 1,
    "text": "کزان سان برآویخت با تاجبخش"
  },
  {
    "poem_id": 1436,
    "vorder": 79,
    "position": 0,
    "text": "بمالید گوش اندر آمد شگفت"
  },
  {
    "poem_id": 1436,
    "vorder": 80,
    "position": 1,
    "text": "بلند اژدها را به دندان گرفت"
  },
  {
    "poem_id": 1436,
    "vorder": 81,
    "position": 0,
    "text": "بدرید کتفش بدندان چو شیر"
  },
  {
    "poem_id": 1436,
    "vorder": 82,
    "position": 1,
    "text": "برو خیره شد پهلوان دلیر"
  },
  {
    "poem_id": 1436,
    "vorder": 83,
    "position": 0,
    "text": "بزد تیغ و بنداخت از بر سرش"
  },
  {
    "poem_id": 1436,
    "vorder": 84,
    "position": 1,
    "text": "فرو ریخت چون رود خون از برش"
  },
  {
    "poem_id": 1436,
    "vorder": 85,
    "position": 0,
    "text": "زمین شد به زیر تنش ناپدید"
  },
  {
    "poem_id": 1436,
    "vorder": 86,
    "position": 1,
    "text": "یکی چشمه خون از برش بردمید"
  },
  {
    "poem_id": 1436,
    "vorder": 87,
    "position": 0,
    "text": "چو رستم برآن اژدهای دژم"
  },
  {
    "poem_id": 1436,
    "vorder": 88,
    "position": 1,
    "text": "نگه کرد برزد یکی تیز دم"
  },
  {
    "poem_id": 1436,
    "vorder": 89,
    "position": 0,
    "text": "بیابان همه زیر او بود پاک"
  },
  {
    "poem_id": 1436,
    "vorder": 90,
    "position": 1,
    "text": "روان خون گرم از بر تیره خاک"
  },
  {
    "poem_id": 1436,
    "vorder": 91,
    "position": 0,
    "text": "تهمتن ازو در شگفتی بماند"
  },
  {
    "poem_id": 1436,
    "vorder": 92,
    "position": 1,
    "text": "همی پهلوی نام یزدان بخواند"
  },
  {
    "poem_id": 1436,
    "vorder": 93,
    "position": 0,
    "text": "به آب اندر آمد سر و تن بشست"
  },
  {
    "poem_id": 1436,
    "vorder": 94,
    "position": 1,
    "text": "جهان جز به زور جهانبان نجست"
  },
  {
    "poem_id": 1436,
    "vorder": 95,
    "position": 0,
    "text": "به یزدان چنین گفت کای دادگر"
  },
  {
    "poem_id": 1436,
    "vorder": 96,
    "position": 1,
    "text": "تو دادی مرا دانش و زور و فر"
  },
  {
    "poem_id": 1436,
    "vorder": 97,
    "position": 0,
    "text": "که پیشم چه شیر و چه دیو و چه پیل"
  },
  {
    "poem_id": 1436,
    "vorder": 98,
    "position": 1,
    "text": "بیابان بی‌آب و دریای نیل"
  },
  {
    "poem_id": 1436,
    "vorder": 99,
    "position": 0,
    "text": "بداندیش بسیار و گر اندکیست"
  },
  {
    "poem_id": 1436,
    "vorder": 100,
    "position": 1,
    "text": "چو خشم آورم پیش چشمم یکیست"
  }
]