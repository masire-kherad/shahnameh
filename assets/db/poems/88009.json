[
  {
    "poem_id": 88009,
    "vorder": 1,
    "position": 0,
    "text": "سپهبد چنان کرد کو راه دید"
  },
  {
    "poem_id": 88009,
    "vorder": 2,
    "position": 1,
    "text": "همی دست ازان رزم کوتاه دید"
  },
  {
    "poem_id": 88009,
    "vorder": 3,
    "position": 0,
    "text": "چو رستم بیامد مرا پای نیست"
  },
  {
    "poem_id": 88009,
    "vorder": 4,
    "position": 1,
    "text": "جز از رفتن از پیش او رای نیست"
  },
  {
    "poem_id": 88009,
    "vorder": 5,
    "position": 0,
    "text": "بباید شدن تا بدان روی چین"
  },
  {
    "poem_id": 88009,
    "vorder": 6,
    "position": 1,
    "text": "گر ایدونک گنجد کسی در زمین"
  },
  {
    "poem_id": 88009,
    "vorder": 7,
    "position": 0,
    "text": "درفشش بماندند و او خود برفت"
  },
  {
    "poem_id": 88009,
    "vorder": 8,
    "position": 1,
    "text": "سوی چین و ماچین خرامید تفت"
  },
  {
    "poem_id": 88009,
    "vorder": 9,
    "position": 0,
    "text": "سپاه اندر آمد بپیش سپاه"
  },
  {
    "poem_id": 88009,
    "vorder": 10,
    "position": 1,
    "text": "زمین گشت برسان ابر سیاه"
  },
  {
    "poem_id": 88009,
    "vorder": 11,
    "position": 0,
    "text": "تهمتن به آواز گفت آن زمان"
  },
  {
    "poem_id": 88009,
    "vorder": 12,
    "position": 1,
    "text": "که نیزه مدارید و تیر و کمان"
  },
  {
    "poem_id": 88009,
    "vorder": 13,
    "position": 0,
    "text": "بکوشید و شمشیر و گرز آورید"
  },
  {
    "poem_id": 88009,
    "vorder": 14,
    "position": 1,
    "text": "هنرها ز بالای برز آورید"
  },
  {
    "poem_id": 88009,
    "vorder": 15,
    "position": 0,
    "text": "پلنگ آن زمان پیچد از کین خویش"
  },
  {
    "poem_id": 88009,
    "vorder": 16,
    "position": 1,
    "text": "که نخچیر بیند ببالین خویش"
  },
  {
    "poem_id": 88009,
    "vorder": 17,
    "position": 0,
    "text": "سپه سربسر نعره برداشتند"
  },
  {
    "poem_id": 88009,
    "vorder": 18,
    "position": 1,
    "text": "همه نیزه بر کوه بگذاشتند"
  },
  {
    "poem_id": 88009,
    "vorder": 19,
    "position": 0,
    "text": "چنان شد در و دشت آوردگاه"
  },
  {
    "poem_id": 88009,
    "vorder": 20,
    "position": 1,
    "text": "که از کشته جایی ندیدند راه"
  },
  {
    "poem_id": 88009,
    "vorder": 21,
    "position": 0,
    "text": "برفتند یک بهره زنهار خواه"
  },
  {
    "poem_id": 88009,
    "vorder": 22,
    "position": 1,
    "text": "گریزان برفتند بهری براه"
  },
  {
    "poem_id": 88009,
    "vorder": 23,
    "position": 0,
    "text": "شد از بی‌شبانی رمه تال و مال"
  },
  {
    "poem_id": 88009,
    "vorder": 24,
    "position": 1,
    "text": "همه دشت تن بود بی‌دست و یال"
  },
  {
    "poem_id": 88009,
    "vorder": 25,
    "position": 0,
    "text": "چنین گفت رستم که کشتن بسست"
  },
  {
    "poem_id": 88009,
    "vorder": 26,
    "position": 1,
    "text": "که زهر زمان بهر دیگر کسست"
  },
  {
    "poem_id": 88009,
    "vorder": 27,
    "position": 0,
    "text": "زمانی همی بار زهر آورد"
  },
  {
    "poem_id": 88009,
    "vorder": 28,
    "position": 1,
    "text": "زمانی ز تریاک بهر آورد"
  },
  {
    "poem_id": 88009,
    "vorder": 29,
    "position": 0,
    "text": "همه جامهٔ رزم بیرون کنید"
  },
  {
    "poem_id": 88009,
    "vorder": 30,
    "position": 1,
    "text": "همه خوبکاری بافزون کنید"
  },
  {
    "poem_id": 88009,
    "vorder": 31,
    "position": 0,
    "text": "چه بندی دل اندر سرای سپنج"
  },
  {
    "poem_id": 88009,
    "vorder": 32,
    "position": 1,
    "text": "که دانا نداند یکی را ز پنج"
  },
  {
    "poem_id": 88009,
    "vorder": 33,
    "position": 0,
    "text": "زمانی چو آهرمن آید بجنگ"
  },
  {
    "poem_id": 88009,
    "vorder": 34,
    "position": 1,
    "text": "زمانی عروسی پر از بوی و رنگ"
  },
  {
    "poem_id": 88009,
    "vorder": 35,
    "position": 0,
    "text": "بی‌آزاری و جام می‌برگزین"
  },
  {
    "poem_id": 88009,
    "vorder": 36,
    "position": 1,
    "text": "که گوید که نفرین به از آفرین"
  },
  {
    "poem_id": 88009,
    "vorder": 37,
    "position": 0,
    "text": "بخور آنچ داری و انده مخور"
  },
  {
    "poem_id": 88009,
    "vorder": 38,
    "position": 1,
    "text": "که گیتی سپنج است و ما بر گذر"
  },
  {
    "poem_id": 88009,
    "vorder": 39,
    "position": 0,
    "text": "میازار کس را ز بهر درم"
  },
  {
    "poem_id": 88009,
    "vorder": 40,
    "position": 1,
    "text": "مکن تا توانی بکس بر ستم"
  },
  {
    "poem_id": 88009,
    "vorder": 41,
    "position": 0,
    "text": "بجست اندران دشت چیزی که بود"
  },
  {
    "poem_id": 88009,
    "vorder": 42,
    "position": 1,
    "text": "ز زرین وز گوهر نابسود"
  },
  {
    "poem_id": 88009,
    "vorder": 43,
    "position": 0,
    "text": "سراسر فرستاد نزدیک شاه"
  },
  {
    "poem_id": 88009,
    "vorder": 44,
    "position": 1,
    "text": "غلامان و اسپان و تیغ و کلاه"
  },
  {
    "poem_id": 88009,
    "vorder": 45,
    "position": 0,
    "text": "وزان بهرهٔ خویشتن برگرفت"
  },
  {
    "poem_id": 88009,
    "vorder": 46,
    "position": 1,
    "text": "همه افسر و مشک و عنبر گرفت"
  },
  {
    "poem_id": 88009,
    "vorder": 47,
    "position": 0,
    "text": "ببخشید دیگر همه بر سپاه"
  },
  {
    "poem_id": 88009,
    "vorder": 48,
    "position": 1,
    "text": "ز چیزی که بود اندران رزمگاه"
  },
  {
    "poem_id": 88009,
    "vorder": 49,
    "position": 0,
    "text": "نشان خواست از شاه توران سپاه"
  },
  {
    "poem_id": 88009,
    "vorder": 50,
    "position": 1,
    "text": "ز هر سو بجستند بی راه و راه"
  },
  {
    "poem_id": 88009,
    "vorder": 51,
    "position": 0,
    "text": "نشانی نیامد ز افراسیاب"
  },
  {
    "poem_id": 88009,
    "vorder": 52,
    "position": 1,
    "text": "نه بر کوه و دریا نه بر خشک و آب"
  }
]