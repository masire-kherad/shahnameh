[
  {
    "poem_id": 1428,
    "vorder": 1,
    "position": 0,
    "text": "سپهدار ترکان دو دیده پرآب"
  },
  {
    "poem_id": 1428,
    "vorder": 2,
    "position": 1,
    "text": "شگفتی فرو ماند ز افراسیاب"
  },
  {
    "poem_id": 1428,
    "vorder": 3,
    "position": 0,
    "text": "یکی مرد با هوش را برگزید"
  },
  {
    "poem_id": 1428,
    "vorder": 4,
    "position": 1,
    "text": "فرسته به ایران چنان چون سزید"
  },
  {
    "poem_id": 1428,
    "vorder": 5,
    "position": 0,
    "text": "یکی نامه بنوشت ارتنگ‌وار"
  },
  {
    "poem_id": 1428,
    "vorder": 6,
    "position": 1,
    "text": "برو کرده صد گونه رنگ و نگار"
  },
  {
    "poem_id": 1428,
    "vorder": 7,
    "position": 0,
    "text": "به نام خداوند خورشید و ماه"
  },
  {
    "poem_id": 1428,
    "vorder": 8,
    "position": 1,
    "text": "که او داد بر آفرین دستگاه"
  },
  {
    "poem_id": 1428,
    "vorder": 9,
    "position": 0,
    "text": "وزو بر روان فریدون درود"
  },
  {
    "poem_id": 1428,
    "vorder": 10,
    "position": 1,
    "text": "کزو دارد این تخم ما تار و پود"
  },
  {
    "poem_id": 1428,
    "vorder": 11,
    "position": 0,
    "text": "گر از تور بر ایرج نیک‌بخت"
  },
  {
    "poem_id": 1428,
    "vorder": 12,
    "position": 1,
    "text": "بد آمد پدید از پی تاج و تخت"
  },
  {
    "poem_id": 1428,
    "vorder": 13,
    "position": 0,
    "text": "بران بر همی راند باید سخن"
  },
  {
    "poem_id": 1428,
    "vorder": 14,
    "position": 1,
    "text": "بباید که پیوند ماند به بن"
  },
  {
    "poem_id": 1428,
    "vorder": 15,
    "position": 0,
    "text": "گر این کینه از ایرج آمد پدید"
  },
  {
    "poem_id": 1428,
    "vorder": 16,
    "position": 1,
    "text": "منوچهر سرتاسر آن کین کشید"
  },
  {
    "poem_id": 1428,
    "vorder": 17,
    "position": 0,
    "text": "بران هم که کرد آفریدون نخست"
  },
  {
    "poem_id": 1428,
    "vorder": 18,
    "position": 1,
    "text": "کجا راستی را به بخشش بجست"
  },
  {
    "poem_id": 1428,
    "vorder": 19,
    "position": 0,
    "text": "سزد گر برانیم دل هم بران"
  },
  {
    "poem_id": 1428,
    "vorder": 20,
    "position": 1,
    "text": "نگردیم از آیین و راه سران"
  },
  {
    "poem_id": 1428,
    "vorder": 21,
    "position": 0,
    "text": "ز جیحون و تا ماورالنهر بر"
  },
  {
    "poem_id": 1428,
    "vorder": 22,
    "position": 1,
    "text": "که جیحون میانچیست اندر گذر"
  },
  {
    "poem_id": 1428,
    "vorder": 23,
    "position": 0,
    "text": "بر و بوم ما بود هنگام شاه"
  },
  {
    "poem_id": 1428,
    "vorder": 24,
    "position": 1,
    "text": "نکردی بران مرز ایرج نگاه"
  },
  {
    "poem_id": 1428,
    "vorder": 25,
    "position": 0,
    "text": "همان بخش ایرج ز ایران زمین"
  },
  {
    "poem_id": 1428,
    "vorder": 26,
    "position": 1,
    "text": "بداد آفریدون و کرد آفرین"
  },
  {
    "poem_id": 1428,
    "vorder": 27,
    "position": 0,
    "text": "ازان گر بگردیم و جنگ آوریم"
  },
  {
    "poem_id": 1428,
    "vorder": 28,
    "position": 1,
    "text": "جهان بر دل خویش تنگ آوریم"
  },
  {
    "poem_id": 1428,
    "vorder": 29,
    "position": 0,
    "text": "بود زخم شمشیر و خشم خدای"
  },
  {
    "poem_id": 1428,
    "vorder": 30,
    "position": 1,
    "text": "نیابیم بهره به هر دو سرای"
  },
  {
    "poem_id": 1428,
    "vorder": 31,
    "position": 0,
    "text": "و گر همچنان چون فریدون گرد"
  },
  {
    "poem_id": 1428,
    "vorder": 32,
    "position": 1,
    "text": "به تور و به سلم و به ایرج سپرد"
  },
  {
    "poem_id": 1428,
    "vorder": 33,
    "position": 0,
    "text": "ببخشیم و زان پس نجوییم کین"
  },
  {
    "poem_id": 1428,
    "vorder": 34,
    "position": 1,
    "text": "که چندین بلا خود نیرزد زمین"
  },
  {
    "poem_id": 1428,
    "vorder": 35,
    "position": 0,
    "text": "سراینده از سال چون برف گشت"
  },
  {
    "poem_id": 1428,
    "vorder": 36,
    "position": 1,
    "text": "ز خون کیان خاک شنگرف گشت"
  },
  {
    "poem_id": 1428,
    "vorder": 37,
    "position": 0,
    "text": "سرانجام هم جز به بالای خویش"
  },
  {
    "poem_id": 1428,
    "vorder": 38,
    "position": 1,
    "text": "نیابد کسی بهره از جای خویش"
  },
  {
    "poem_id": 1428,
    "vorder": 39,
    "position": 0,
    "text": "بمانیم روز پسین زیر خاک"
  },
  {
    "poem_id": 1428,
    "vorder": 40,
    "position": 1,
    "text": "سراپای کرباس و جای مغاک"
  },
  {
    "poem_id": 1428,
    "vorder": 41,
    "position": 0,
    "text": "و گر آزمندیست و اندوه و رنج"
  },
  {
    "poem_id": 1428,
    "vorder": 42,
    "position": 1,
    "text": "شدن تنگ‌دل در سرای سپنج"
  },
  {
    "poem_id": 1428,
    "vorder": 43,
    "position": 0,
    "text": "مگر رام گردد برین کیقباد"
  },
  {
    "poem_id": 1428,
    "vorder": 44,
    "position": 1,
    "text": "سر مرد بخرد نگردد ز داد"
  },
  {
    "poem_id": 1428,
    "vorder": 45,
    "position": 0,
    "text": "کس از ما نبینند جیحون بخواب"
  },
  {
    "poem_id": 1428,
    "vorder": 46,
    "position": 1,
    "text": "وز ایران نیایند ازین روی آب"
  },
  {
    "poem_id": 1428,
    "vorder": 47,
    "position": 0,
    "text": "مگر با درود و سلام و پیام"
  },
  {
    "poem_id": 1428,
    "vorder": 48,
    "position": 1,
    "text": "دو کشور شود زین سخن شادکام"
  },
  {
    "poem_id": 1428,
    "vorder": 49,
    "position": 0,
    "text": "چو نامه به مهر اندر آورد شاه"
  },
  {
    "poem_id": 1428,
    "vorder": 50,
    "position": 1,
    "text": "فرستاد نزدیک ایران سپاه"
  },
  {
    "poem_id": 1428,
    "vorder": 51,
    "position": 0,
    "text": "ببردند نامه بر کیقباد"
  },
  {
    "poem_id": 1428,
    "vorder": 52,
    "position": 1,
    "text": "سخن نیز ازین گونه کردند یاد"
  },
  {
    "poem_id": 1428,
    "vorder": 53,
    "position": 0,
    "text": "چنین داد پاسخ که دانی درست"
  },
  {
    "poem_id": 1428,
    "vorder": 54,
    "position": 1,
    "text": "که از ما نبد پیشدستی نخست"
  },
  {
    "poem_id": 1428,
    "vorder": 55,
    "position": 0,
    "text": "ز تور اندر آمد نخستین ستم"
  },
  {
    "poem_id": 1428,
    "vorder": 56,
    "position": 1,
    "text": "که شاهی چو ایرج شد از تخت کم"
  },
  {
    "poem_id": 1428,
    "vorder": 57,
    "position": 0,
    "text": "بدین روزگار اندر افراسیاب"
  },
  {
    "poem_id": 1428,
    "vorder": 58,
    "position": 1,
    "text": "بیامد به تیزی و بگذاشت آب"
  },
  {
    "poem_id": 1428,
    "vorder": 59,
    "position": 0,
    "text": "شنیدی که با شاه نوذر چه کرد"
  },
  {
    "poem_id": 1428,
    "vorder": 60,
    "position": 1,
    "text": "دل دام و دد شد پر از داغ و درد"
  },
  {
    "poem_id": 1428,
    "vorder": 61,
    "position": 0,
    "text": "ز کینه به اغریرث پرخرد"
  },
  {
    "poem_id": 1428,
    "vorder": 62,
    "position": 1,
    "text": "نه آن کرد کز مردمی در خورد"
  },
  {
    "poem_id": 1428,
    "vorder": 63,
    "position": 0,
    "text": "ز کردار بد گر پشیمان شوید"
  },
  {
    "poem_id": 1428,
    "vorder": 64,
    "position": 1,
    "text": "بنوی ز سر باز پیمان شوید"
  },
  {
    "poem_id": 1428,
    "vorder": 65,
    "position": 0,
    "text": "مرا نیست از کینه و آز رنج"
  },
  {
    "poem_id": 1428,
    "vorder": 66,
    "position": 1,
    "text": "بسیچیده‌ام در سرای سپنج"
  },
  {
    "poem_id": 1428,
    "vorder": 67,
    "position": 0,
    "text": "شما را سپردم ازان روی آب"
  },
  {
    "poem_id": 1428,
    "vorder": 68,
    "position": 1,
    "text": "مگر یابد آرامش افراسیاب"
  },
  {
    "poem_id": 1428,
    "vorder": 69,
    "position": 0,
    "text": "بنوی یکی باز پیمان نوشت"
  },
  {
    "poem_id": 1428,
    "vorder": 70,
    "position": 1,
    "text": "به باغ بزرگی درختی بکشت"
  },
  {
    "poem_id": 1428,
    "vorder": 71,
    "position": 0,
    "text": "فرستاده آمد بسان پلنگ"
  },
  {
    "poem_id": 1428,
    "vorder": 72,
    "position": 1,
    "text": "رسانید نامه به نزد پشنگ"
  },
  {
    "poem_id": 1428,
    "vorder": 73,
    "position": 0,
    "text": "بنه برنهاد و سپه را براند"
  },
  {
    "poem_id": 1428,
    "vorder": 74,
    "position": 1,
    "text": "همی گرد بر آسمان برفشاند"
  },
  {
    "poem_id": 1428,
    "vorder": 75,
    "position": 0,
    "text": "ز جیحون گذر کرد مانند باد"
  },
  {
    "poem_id": 1428,
    "vorder": 76,
    "position": 1,
    "text": "وزان آگهی شد بر کیقباد"
  },
  {
    "poem_id": 1428,
    "vorder": 77,
    "position": 0,
    "text": "که دشمن شد از پیش بی‌کارزار"
  },
  {
    "poem_id": 1428,
    "vorder": 78,
    "position": 1,
    "text": "بدان گشت شادان دل شهریار"
  },
  {
    "poem_id": 1428,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت رستم که ای شهریار"
  },
  {
    "poem_id": 1428,
    "vorder": 80,
    "position": 1,
    "text": "مجو آشتی درگه کارزار"
  },
  {
    "poem_id": 1428,
    "vorder": 81,
    "position": 0,
    "text": "نبد پیشتر آشتی را نشان"
  },
  {
    "poem_id": 1428,
    "vorder": 82,
    "position": 1,
    "text": "بدین روز گرز من آوردشان"
  },
  {
    "poem_id": 1428,
    "vorder": 83,
    "position": 0,
    "text": "چنین گفت با نامور کیقباد"
  },
  {
    "poem_id": 1428,
    "vorder": 84,
    "position": 1,
    "text": "که چیزی ندیدم نکوتر ز داد"
  },
  {
    "poem_id": 1428,
    "vorder": 85,
    "position": 0,
    "text": "نبیره فریدون فرخ پشنگ"
  },
  {
    "poem_id": 1428,
    "vorder": 86,
    "position": 1,
    "text": "به سیری همی سر بپیچد ز جنگ"
  },
  {
    "poem_id": 1428,
    "vorder": 87,
    "position": 0,
    "text": "سزد گر هر آنکس که دارد خرد"
  },
  {
    "poem_id": 1428,
    "vorder": 88,
    "position": 1,
    "text": "بکژی و ناراستی ننگرد"
  },
  {
    "poem_id": 1428,
    "vorder": 89,
    "position": 0,
    "text": "ز زاولستان تا بدریای سند"
  },
  {
    "poem_id": 1428,
    "vorder": 90,
    "position": 1,
    "text": "نوشتیم عهدی ترا بر پرند"
  },
  {
    "poem_id": 1428,
    "vorder": 91,
    "position": 0,
    "text": "سر تخت با افسر نیمروز"
  },
  {
    "poem_id": 1428,
    "vorder": 92,
    "position": 1,
    "text": "بدار و همی باش گیتی فروز"
  },
  {
    "poem_id": 1428,
    "vorder": 93,
    "position": 0,
    "text": "وزین روی کابل به مهراب ده"
  },
  {
    "poem_id": 1428,
    "vorder": 94,
    "position": 1,
    "text": "سراسر سنانت به زهراب ده"
  },
  {
    "poem_id": 1428,
    "vorder": 95,
    "position": 0,
    "text": "کجا پادشاهیست بی‌جنگ نیست"
  },
  {
    "poem_id": 1428,
    "vorder": 96,
    "position": 1,
    "text": "وگر چند روی زمین تنگ نیست"
  },
  {
    "poem_id": 1428,
    "vorder": 97,
    "position": 0,
    "text": "سرش را بیاراست با تاج زر"
  },
  {
    "poem_id": 1428,
    "vorder": 98,
    "position": 1,
    "text": "همان گردگاهش به زرین کمر"
  },
  {
    "poem_id": 1428,
    "vorder": 99,
    "position": 0,
    "text": "ز یک روی گیتی مرو را سپرد"
  },
  {
    "poem_id": 1428,
    "vorder": 100,
    "position": 1,
    "text": "ببوسید روی زمین مرد گرد"
  },
  {
    "poem_id": 1428,
    "vorder": 101,
    "position": 0,
    "text": "ازان پس چنین گفت فرخ قباد"
  },
  {
    "poem_id": 1428,
    "vorder": 102,
    "position": 1,
    "text": "که بی‌زال تخت بزرگی مباد"
  },
  {
    "poem_id": 1428,
    "vorder": 103,
    "position": 0,
    "text": "به یک موی دستان نیرزد جهان"
  },
  {
    "poem_id": 1428,
    "vorder": 104,
    "position": 1,
    "text": "که او ماندمان یادگار از مهان"
  },
  {
    "poem_id": 1428,
    "vorder": 105,
    "position": 0,
    "text": "یکی جامهٔ شهریاری به زر"
  },
  {
    "poem_id": 1428,
    "vorder": 106,
    "position": 1,
    "text": "ز یاقوت و پیروزه تاج و کمر"
  },
  {
    "poem_id": 1428,
    "vorder": 107,
    "position": 0,
    "text": "نهادند مهد از بر پنج پیل"
  },
  {
    "poem_id": 1428,
    "vorder": 108,
    "position": 1,
    "text": "ز پیروزه رخشان بکردار نیل"
  },
  {
    "poem_id": 1428,
    "vorder": 109,
    "position": 0,
    "text": "بگسترد زر بفت بر مهد بر"
  },
  {
    "poem_id": 1428,
    "vorder": 110,
    "position": 1,
    "text": "یکی گنج کش کس ندانست مر"
  },
  {
    "poem_id": 1428,
    "vorder": 111,
    "position": 0,
    "text": "فرستاد نزدیک دستان سام"
  },
  {
    "poem_id": 1428,
    "vorder": 112,
    "position": 1,
    "text": "که خلعت مرا زین فزون بود کام"
  },
  {
    "poem_id": 1428,
    "vorder": 113,
    "position": 0,
    "text": "اگر باشدم زندگانی دراز"
  },
  {
    "poem_id": 1428,
    "vorder": 114,
    "position": 1,
    "text": "ترا دارم اندر جهان بی‌نیاز"
  },
  {
    "poem_id": 1428,
    "vorder": 115,
    "position": 0,
    "text": "همان قارن نیو و کشواد را"
  },
  {
    "poem_id": 1428,
    "vorder": 116,
    "position": 1,
    "text": "چو برزین و خراد پولاد را"
  },
  {
    "poem_id": 1428,
    "vorder": 117,
    "position": 0,
    "text": "برافگند خلعت چنان چون سزید"
  },
  {
    "poem_id": 1428,
    "vorder": 118,
    "position": 1,
    "text": "کسی را که خلعت سزاوار دید"
  },
  {
    "poem_id": 1428,
    "vorder": 119,
    "position": 0,
    "text": "درم داد و دینار و تیغ و سپر"
  },
  {
    "poem_id": 1428,
    "vorder": 120,
    "position": 1,
    "text": "کرا در خور آمد کلاه و کمر"
  }
]