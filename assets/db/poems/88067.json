[
  {
    "poem_id": 88067,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید برزد سر از برج گاو"
  },
  {
    "poem_id": 88067,
    "vorder": 2,
    "position": 1,
    "text": "ز هامون برآمد خروش چکاو"
  },
  {
    "poem_id": 88067,
    "vorder": 3,
    "position": 0,
    "text": "تبیره برآمد ز هر دو سرای"
  },
  {
    "poem_id": 88067,
    "vorder": 4,
    "position": 1,
    "text": "همان ناله بوق با کرنای"
  },
  {
    "poem_id": 88067,
    "vorder": 5,
    "position": 0,
    "text": "ز گردان شمشیرزن سی هزار"
  },
  {
    "poem_id": 88067,
    "vorder": 6,
    "position": 1,
    "text": "بیاورد جهن از در کارزار"
  },
  {
    "poem_id": 88067,
    "vorder": 7,
    "position": 0,
    "text": "چو خسرو بر آن گونه بر دیدشان"
  },
  {
    "poem_id": 88067,
    "vorder": 8,
    "position": 1,
    "text": "بفرمود تا قارن کاویان"
  },
  {
    "poem_id": 88067,
    "vorder": 9,
    "position": 0,
    "text": "ز قلب سپاه اندر آمد چو کوه"
  },
  {
    "poem_id": 88067,
    "vorder": 10,
    "position": 1,
    "text": "از او گشت جهن دلاور ستوه"
  },
  {
    "poem_id": 88067,
    "vorder": 11,
    "position": 0,
    "text": "سوی راست گستهم نوذر چو گرد"
  },
  {
    "poem_id": 88067,
    "vorder": 12,
    "position": 1,
    "text": "بیامد دمان با درفش نبرد"
  },
  {
    "poem_id": 88067,
    "vorder": 13,
    "position": 0,
    "text": "جهان شد ز گرد سواران بنفش"
  },
  {
    "poem_id": 88067,
    "vorder": 14,
    "position": 1,
    "text": "زمین پر سپاه و هوا پر درفش"
  },
  {
    "poem_id": 88067,
    "vorder": 15,
    "position": 0,
    "text": "بجنبید خسرو ز قلب سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 16,
    "position": 1,
    "text": "هم افراسیاب اندر آن رزمگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 17,
    "position": 0,
    "text": "بپیوست جنگی کزان سان نشان"
  },
  {
    "poem_id": 88067,
    "vorder": 18,
    "position": 1,
    "text": "ندادند گردان گردنکشان"
  },
  {
    "poem_id": 88067,
    "vorder": 19,
    "position": 0,
    "text": "بکشتند چندان ز توران سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 20,
    "position": 1,
    "text": "که دریای خون گشت آوردگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 21,
    "position": 0,
    "text": "چنین بود تا آسمان تیره گشت"
  },
  {
    "poem_id": 88067,
    "vorder": 22,
    "position": 1,
    "text": "همان چشم جنگاوران خیره گشت"
  },
  {
    "poem_id": 88067,
    "vorder": 23,
    "position": 0,
    "text": "چو پیروز شد قارن رزم زن"
  },
  {
    "poem_id": 88067,
    "vorder": 24,
    "position": 1,
    "text": "به جهن دلیر اندر آمد شکن"
  },
  {
    "poem_id": 88067,
    "vorder": 25,
    "position": 0,
    "text": "چو بر دامن کوه بنشست ماه"
  },
  {
    "poem_id": 88067,
    "vorder": 26,
    "position": 1,
    "text": "یلان بازگشتند ز آوردگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 27,
    "position": 0,
    "text": "از ایرانیان شاد شد شهریار"
  },
  {
    "poem_id": 88067,
    "vorder": 28,
    "position": 1,
    "text": "که چیره شدند اندر آن کارزار"
  },
  {
    "poem_id": 88067,
    "vorder": 29,
    "position": 0,
    "text": "همه شب همی جنگ را ساختند"
  },
  {
    "poem_id": 88067,
    "vorder": 30,
    "position": 1,
    "text": "به خواب و به خوردن نپرداختند"
  },
  {
    "poem_id": 88067,
    "vorder": 31,
    "position": 0,
    "text": "چو برزد سر از چنگ خرچنگ هور"
  },
  {
    "poem_id": 88067,
    "vorder": 32,
    "position": 1,
    "text": "جهان شد پر از جنگ و آهنگ و شور"
  },
  {
    "poem_id": 88067,
    "vorder": 33,
    "position": 0,
    "text": "سپاه دو لشکر کشیدند صف"
  },
  {
    "poem_id": 88067,
    "vorder": 34,
    "position": 1,
    "text": "همه جنگ را بر لب آورده کف"
  },
  {
    "poem_id": 88067,
    "vorder": 35,
    "position": 0,
    "text": "سپهدار ایران ز پشت سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 36,
    "position": 1,
    "text": "بشد دور با کهتری نیک‌خواه"
  },
  {
    "poem_id": 88067,
    "vorder": 37,
    "position": 0,
    "text": "چو لختی بیامد پیاده ببود"
  },
  {
    "poem_id": 88067,
    "vorder": 38,
    "position": 1,
    "text": "جهان آفرین را فراوان ستود"
  },
  {
    "poem_id": 88067,
    "vorder": 39,
    "position": 0,
    "text": "بمالید رخ را بر آن تیره خاک"
  },
  {
    "poem_id": 88067,
    "vorder": 40,
    "position": 1,
    "text": "چنین گفت کای داور داد و پاک"
  },
  {
    "poem_id": 88067,
    "vorder": 41,
    "position": 0,
    "text": "تو دانی کز او من ستم دیده‌ام"
  },
  {
    "poem_id": 88067,
    "vorder": 42,
    "position": 1,
    "text": "بسی روز بد را پسندیده‌ام"
  },
  {
    "poem_id": 88067,
    "vorder": 43,
    "position": 0,
    "text": "مکافات کن بدکنش را به خون"
  },
  {
    "poem_id": 88067,
    "vorder": 44,
    "position": 1,
    "text": "تو باشی ستم دیده را رهنمون"
  },
  {
    "poem_id": 88067,
    "vorder": 45,
    "position": 0,
    "text": "وز آن جایگه با دلی پر ز غم"
  },
  {
    "poem_id": 88067,
    "vorder": 46,
    "position": 1,
    "text": "پر از کین سر از تخمه زادشم"
  },
  {
    "poem_id": 88067,
    "vorder": 47,
    "position": 0,
    "text": "بیامد خروشان به قلب سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 48,
    "position": 1,
    "text": "به سر بر نهاد آن خجسته کلاه"
  },
  {
    "poem_id": 88067,
    "vorder": 49,
    "position": 0,
    "text": "خروش آمد و نالهٔ گاودم"
  },
  {
    "poem_id": 88067,
    "vorder": 50,
    "position": 1,
    "text": "دم نای رویین و رویینه خم"
  },
  {
    "poem_id": 88067,
    "vorder": 51,
    "position": 0,
    "text": "وز آن روی لشکر به کردار کوه"
  },
  {
    "poem_id": 88067,
    "vorder": 52,
    "position": 1,
    "text": "برفتند جوشان گروها گروه"
  },
  {
    "poem_id": 88067,
    "vorder": 53,
    "position": 0,
    "text": "سپاهی به کردار دریای آب"
  },
  {
    "poem_id": 88067,
    "vorder": 54,
    "position": 1,
    "text": "به قلب اندرون جهن و افراسیاب"
  },
  {
    "poem_id": 88067,
    "vorder": 55,
    "position": 0,
    "text": "چو هر دو سپاه اندر آمد ز جای"
  },
  {
    "poem_id": 88067,
    "vorder": 56,
    "position": 1,
    "text": "تو گفتی که دارد در و دشت پای"
  },
  {
    "poem_id": 88067,
    "vorder": 57,
    "position": 0,
    "text": "سیه شد ز گرد سپاه آفتاب"
  },
  {
    "poem_id": 88067,
    "vorder": 58,
    "position": 1,
    "text": "ز پیکان الماس و پر عقاب"
  },
  {
    "poem_id": 88067,
    "vorder": 59,
    "position": 0,
    "text": "ز بس نالهٔ بوق و گرد سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 60,
    "position": 1,
    "text": "ز بانگ سواران در آن رزمگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 61,
    "position": 0,
    "text": "همی آب گشت آهن و کوه و سنگ"
  },
  {
    "poem_id": 88067,
    "vorder": 62,
    "position": 1,
    "text": "به دریا نهنگ و به هامون پلنگ"
  },
  {
    "poem_id": 88067,
    "vorder": 63,
    "position": 0,
    "text": "زمین پر ز جوش و هوا پر خروش"
  },
  {
    "poem_id": 88067,
    "vorder": 64,
    "position": 1,
    "text": "هژبر ژیان را بدرید گوش"
  },
  {
    "poem_id": 88067,
    "vorder": 65,
    "position": 0,
    "text": "جهان سر به سر گفتی از آهن است"
  },
  {
    "poem_id": 88067,
    "vorder": 66,
    "position": 1,
    "text": "وگر آسمان بر زمین دشمن است"
  },
  {
    "poem_id": 88067,
    "vorder": 67,
    "position": 0,
    "text": "به هر جای بر توده چون کوه کوه"
  },
  {
    "poem_id": 88067,
    "vorder": 68,
    "position": 1,
    "text": "ز گردان ایران و توران گروه"
  },
  {
    "poem_id": 88067,
    "vorder": 69,
    "position": 0,
    "text": "همه ریگ ارمان سر و دست و پای"
  },
  {
    "poem_id": 88067,
    "vorder": 70,
    "position": 1,
    "text": "زمین را همی دل برآمد ز جای"
  },
  {
    "poem_id": 88067,
    "vorder": 71,
    "position": 0,
    "text": "همه بوم شد زیر نعل اندرون"
  },
  {
    "poem_id": 88067,
    "vorder": 72,
    "position": 1,
    "text": "چو کرباس آهار داده به خون"
  },
  {
    "poem_id": 88067,
    "vorder": 73,
    "position": 0,
    "text": "وز آن پس دلیران افراسیاب"
  },
  {
    "poem_id": 88067,
    "vorder": 74,
    "position": 1,
    "text": "برفتند بر سان کشتی بر آب"
  },
  {
    "poem_id": 88067,
    "vorder": 75,
    "position": 0,
    "text": "به صندوق پیلان نهادند روی"
  },
  {
    "poem_id": 88067,
    "vorder": 76,
    "position": 1,
    "text": "کجا ناوک‌انداز بود اندر اوی"
  },
  {
    "poem_id": 88067,
    "vorder": 77,
    "position": 0,
    "text": "حصاری بد از پیل پیش سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 78,
    "position": 1,
    "text": "برآورده بر قلب و بر بسته راه"
  },
  {
    "poem_id": 88067,
    "vorder": 79,
    "position": 0,
    "text": "ز صندوق پیلان ببارید تیر"
  },
  {
    "poem_id": 88067,
    "vorder": 80,
    "position": 1,
    "text": "برآمد خروشیدن دار و گیر"
  },
  {
    "poem_id": 88067,
    "vorder": 81,
    "position": 0,
    "text": "برفتند گردان نیزه‌وران"
  },
  {
    "poem_id": 88067,
    "vorder": 82,
    "position": 1,
    "text": "هم از قلب لشکر سپاهی گران"
  },
  {
    "poem_id": 88067,
    "vorder": 83,
    "position": 0,
    "text": "نگه کرد افراسیاب از دو میل"
  },
  {
    "poem_id": 88067,
    "vorder": 84,
    "position": 1,
    "text": "بدان لشکر و جنگ صندوق و پیل"
  },
  {
    "poem_id": 88067,
    "vorder": 85,
    "position": 0,
    "text": "همه ژنده پیلان و لشکر براند"
  },
  {
    "poem_id": 88067,
    "vorder": 86,
    "position": 1,
    "text": "جهان تیره شد روشنایی نماند"
  },
  {
    "poem_id": 88067,
    "vorder": 87,
    "position": 0,
    "text": "خروشید کای نامداران جنگ"
  },
  {
    "poem_id": 88067,
    "vorder": 88,
    "position": 1,
    "text": "چه دارید بر خویش تن جای تنگ"
  },
  {
    "poem_id": 88067,
    "vorder": 89,
    "position": 0,
    "text": "ممانید بر پیش صندوق و پیل"
  },
  {
    "poem_id": 88067,
    "vorder": 90,
    "position": 1,
    "text": "سپاهست بیکار بر چند میل"
  },
  {
    "poem_id": 88067,
    "vorder": 91,
    "position": 0,
    "text": "سوی میمنه میسره برکشید"
  },
  {
    "poem_id": 88067,
    "vorder": 92,
    "position": 1,
    "text": "ز قلب و ز صندوق برتر کشید"
  },
  {
    "poem_id": 88067,
    "vorder": 93,
    "position": 0,
    "text": "بفرمود تا جهن رزم آزمای"
  },
  {
    "poem_id": 88067,
    "vorder": 94,
    "position": 1,
    "text": "رود با تگینان لشکر ز جای"
  },
  {
    "poem_id": 88067,
    "vorder": 95,
    "position": 0,
    "text": "برد دو هزار آزموده سوار"
  },
  {
    "poem_id": 88067,
    "vorder": 96,
    "position": 1,
    "text": "همه نیزه‌دار از در کارزار"
  },
  {
    "poem_id": 88067,
    "vorder": 97,
    "position": 0,
    "text": "بر مسیره شیر جنگی طبرد"
  },
  {
    "poem_id": 88067,
    "vorder": 98,
    "position": 1,
    "text": "بشد تیز با نامداران گرد"
  },
  {
    "poem_id": 88067,
    "vorder": 99,
    "position": 0,
    "text": "چو کیخسرو آن رزم ترکان بدید"
  },
  {
    "poem_id": 88067,
    "vorder": 100,
    "position": 1,
    "text": "که خورشید گشت از جهان ناپدید"
  },
  {
    "poem_id": 88067,
    "vorder": 101,
    "position": 0,
    "text": "سوی آوه و سمکنان کرد روی"
  },
  {
    "poem_id": 88067,
    "vorder": 102,
    "position": 1,
    "text": "که بودند شیران پرخاشجوی"
  },
  {
    "poem_id": 88067,
    "vorder": 103,
    "position": 0,
    "text": "بفرمود تا بر سوی میسره"
  },
  {
    "poem_id": 88067,
    "vorder": 104,
    "position": 1,
    "text": "بتابند چون آفتاب از بره"
  },
  {
    "poem_id": 88067,
    "vorder": 105,
    "position": 0,
    "text": "برفتند با نامور ده هزار"
  },
  {
    "poem_id": 88067,
    "vorder": 106,
    "position": 1,
    "text": "زره‌دار با گُرزهٔ گاوسار"
  },
  {
    "poem_id": 88067,
    "vorder": 107,
    "position": 0,
    "text": "به شماخ سوری بفرمود شاه"
  },
  {
    "poem_id": 88067,
    "vorder": 108,
    "position": 1,
    "text": "که از نامداران ایران سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 109,
    "position": 0,
    "text": "گزین کن ز جنگ آوران ده‌هزار"
  },
  {
    "poem_id": 88067,
    "vorder": 110,
    "position": 1,
    "text": "سواران گرد از در کارزار"
  },
  {
    "poem_id": 88067,
    "vorder": 111,
    "position": 0,
    "text": "میان دو صف تیغها بر کشید"
  },
  {
    "poem_id": 88067,
    "vorder": 112,
    "position": 1,
    "text": "مبینید کس را سر اندر کشید"
  },
  {
    "poem_id": 88067,
    "vorder": 113,
    "position": 0,
    "text": "دو لشکر بر این سان بر آویختند"
  },
  {
    "poem_id": 88067,
    "vorder": 114,
    "position": 1,
    "text": "چنان شد که گفتی برآمیختند"
  },
  {
    "poem_id": 88067,
    "vorder": 115,
    "position": 0,
    "text": "چکاچاک برخاست از هر دو روی"
  },
  {
    "poem_id": 88067,
    "vorder": 116,
    "position": 1,
    "text": "ز پرخاش خون اندر آمد به جوی"
  },
  {
    "poem_id": 88067,
    "vorder": 117,
    "position": 0,
    "text": "چو برخاست گرد از چپ و دست راست"
  },
  {
    "poem_id": 88067,
    "vorder": 118,
    "position": 1,
    "text": "جهاندار خفتان رومی بخواست"
  },
  {
    "poem_id": 88067,
    "vorder": 119,
    "position": 0,
    "text": "به یک سو کشیدند صندوق پیل"
  },
  {
    "poem_id": 88067,
    "vorder": 120,
    "position": 1,
    "text": "جهان شد به کردار دریای نیل"
  },
  {
    "poem_id": 88067,
    "vorder": 121,
    "position": 0,
    "text": "بجنبید با رستم از قلبگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 122,
    "position": 1,
    "text": "منوشان خوزان لشکر پناه"
  },
  {
    "poem_id": 88067,
    "vorder": 123,
    "position": 0,
    "text": "برآمد خروشیدن بوق و کوس"
  },
  {
    "poem_id": 88067,
    "vorder": 124,
    "position": 1,
    "text": "به یک دست خسرو سپهدار طوس"
  },
  {
    "poem_id": 88067,
    "vorder": 125,
    "position": 0,
    "text": "بیاراسته کاویانی درفش"
  },
  {
    "poem_id": 88067,
    "vorder": 126,
    "position": 1,
    "text": "همه پهلوانان زرینه کفش"
  },
  {
    "poem_id": 88067,
    "vorder": 127,
    "position": 0,
    "text": "به درد دل از جای برخاستند"
  },
  {
    "poem_id": 88067,
    "vorder": 128,
    "position": 1,
    "text": "چپ شاه لشکر بیاراستند"
  },
  {
    "poem_id": 88067,
    "vorder": 129,
    "position": 0,
    "text": "سوی راستش رستم کینه جوی"
  },
  {
    "poem_id": 88067,
    "vorder": 130,
    "position": 1,
    "text": "زواره برادرش بنهاد روی"
  },
  {
    "poem_id": 88067,
    "vorder": 131,
    "position": 0,
    "text": "جهاندیده گودرز کشوادگان"
  },
  {
    "poem_id": 88067,
    "vorder": 132,
    "position": 1,
    "text": "بزرگان بسیار و آزادگان"
  },
  {
    "poem_id": 88067,
    "vorder": 133,
    "position": 0,
    "text": "ببودند بر دست رستم به پای"
  },
  {
    "poem_id": 88067,
    "vorder": 134,
    "position": 1,
    "text": "زرسب و منوشان فرخنده رای"
  },
  {
    "poem_id": 88067,
    "vorder": 135,
    "position": 0,
    "text": "برآمد ز آوردگاه گیر و دار"
  },
  {
    "poem_id": 88067,
    "vorder": 136,
    "position": 1,
    "text": "ندیدند ز آنگونه کس کارزار"
  },
  {
    "poem_id": 88067,
    "vorder": 137,
    "position": 0,
    "text": "همه ریگ پر خسته و کشته بود"
  },
  {
    "poem_id": 88067,
    "vorder": 138,
    "position": 1,
    "text": "کسی را کجا روز برگشته بود"
  },
  {
    "poem_id": 88067,
    "vorder": 139,
    "position": 0,
    "text": "ز بس کشته بر دشت آوردگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 140,
    "position": 1,
    "text": "همی راندند اسب بر کشته گاه"
  },
  {
    "poem_id": 88067,
    "vorder": 141,
    "position": 0,
    "text": "بیابان به کردار جیحون ز خون"
  },
  {
    "poem_id": 88067,
    "vorder": 142,
    "position": 1,
    "text": "یکی بی سر و دیگری سرنگون"
  },
  {
    "poem_id": 88067,
    "vorder": 143,
    "position": 0,
    "text": "خروش سواران و اسبان ز دشت"
  },
  {
    "poem_id": 88067,
    "vorder": 144,
    "position": 1,
    "text": "ز بانگ تبیره همی برگذشت"
  },
  {
    "poem_id": 88067,
    "vorder": 145,
    "position": 0,
    "text": "دل کوه گفتی بدرد همی"
  },
  {
    "poem_id": 88067,
    "vorder": 146,
    "position": 1,
    "text": "زمین با سواران بپرد همی"
  },
  {
    "poem_id": 88067,
    "vorder": 147,
    "position": 0,
    "text": "سر بی تنان و تن بی سران"
  },
  {
    "poem_id": 88067,
    "vorder": 148,
    "position": 1,
    "text": "چرنگیدن گُرزهای گران"
  },
  {
    "poem_id": 88067,
    "vorder": 149,
    "position": 0,
    "text": "درخشیدن خنجر و تیغ تیز"
  },
  {
    "poem_id": 88067,
    "vorder": 150,
    "position": 1,
    "text": "همی جست خورشید راه گریز"
  },
  {
    "poem_id": 88067,
    "vorder": 151,
    "position": 0,
    "text": "به دست منوچهر بر میمنه"
  },
  {
    "poem_id": 88067,
    "vorder": 152,
    "position": 1,
    "text": "کهیلا که صد شیر بد یک تنه"
  },
  {
    "poem_id": 88067,
    "vorder": 153,
    "position": 0,
    "text": "جرنجاش بر میسره شد تباه"
  },
  {
    "poem_id": 88067,
    "vorder": 154,
    "position": 1,
    "text": "به دست فریبرز کاووس شاه"
  },
  {
    "poem_id": 88067,
    "vorder": 155,
    "position": 0,
    "text": "یکی باد و ابری سوی نیمروز"
  },
  {
    "poem_id": 88067,
    "vorder": 156,
    "position": 1,
    "text": "برآمد رخ هور گیتی فروز"
  },
  {
    "poem_id": 88067,
    "vorder": 157,
    "position": 0,
    "text": "تو گفتی که ابری برآمد سیاه"
  },
  {
    "poem_id": 88067,
    "vorder": 158,
    "position": 1,
    "text": "ببارید خون اندر آوردگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 159,
    "position": 0,
    "text": "بپوشید و روی زمین تیره گشت"
  },
  {
    "poem_id": 88067,
    "vorder": 160,
    "position": 1,
    "text": "همی دیده از تیرگی خیره گشت"
  },
  {
    "poem_id": 88067,
    "vorder": 161,
    "position": 0,
    "text": "بدآنگه که شد چشمه سوی نشیب"
  },
  {
    "poem_id": 88067,
    "vorder": 162,
    "position": 1,
    "text": "دل شاه ترکان بجست از نهیب"
  },
  {
    "poem_id": 88067,
    "vorder": 163,
    "position": 0,
    "text": "ز جوش سواران هر کشوری"
  },
  {
    "poem_id": 88067,
    "vorder": 164,
    "position": 1,
    "text": "ز هر مرز و هر بوم و هر مهتری"
  },
  {
    "poem_id": 88067,
    "vorder": 165,
    "position": 0,
    "text": "سواران شمشیر زن سی هزار"
  },
  {
    "poem_id": 88067,
    "vorder": 166,
    "position": 1,
    "text": "گزیده سوارن خنجر گزار"
  },
  {
    "poem_id": 88067,
    "vorder": 167,
    "position": 0,
    "text": "دگرگونه جوشن دگرگون درفش"
  },
  {
    "poem_id": 88067,
    "vorder": 168,
    "position": 1,
    "text": "جهانی شده سرخ و زرد و بنفش"
  },
  {
    "poem_id": 88067,
    "vorder": 169,
    "position": 0,
    "text": "نگه کرد گرسیوز از پشت شاه"
  },
  {
    "poem_id": 88067,
    "vorder": 170,
    "position": 1,
    "text": "به جنگ اندر آورد یکسر سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 171,
    "position": 0,
    "text": "سپاهی فرستاد بر میمنه"
  },
  {
    "poem_id": 88067,
    "vorder": 172,
    "position": 1,
    "text": "گرانمایگان یک‌دل و یک تنه"
  },
  {
    "poem_id": 88067,
    "vorder": 173,
    "position": 0,
    "text": "سوی میسره همچنین لشکری"
  },
  {
    "poem_id": 88067,
    "vorder": 174,
    "position": 1,
    "text": "پراگنده بر هر سویی مهتری"
  },
  {
    "poem_id": 88067,
    "vorder": 175,
    "position": 0,
    "text": "سواران جنگاوران سی هزار"
  },
  {
    "poem_id": 88067,
    "vorder": 176,
    "position": 1,
    "text": "گزیده همه از در کارزار"
  },
  {
    "poem_id": 88067,
    "vorder": 177,
    "position": 0,
    "text": "چو گرسیوز از پشت لشکر برفت"
  },
  {
    "poem_id": 88067,
    "vorder": 178,
    "position": 1,
    "text": "به پیش برادر خرامید تفت"
  },
  {
    "poem_id": 88067,
    "vorder": 179,
    "position": 0,
    "text": "برادر چو روی برادر بدید"
  },
  {
    "poem_id": 88067,
    "vorder": 180,
    "position": 1,
    "text": "به نیرو شد و لشکر اندر کشید"
  },
  {
    "poem_id": 88067,
    "vorder": 181,
    "position": 0,
    "text": "برآمد ز لشکر ده و دار و گیر"
  },
  {
    "poem_id": 88067,
    "vorder": 182,
    "position": 1,
    "text": "بپوشید روی هوا را به تیر"
  },
  {
    "poem_id": 88067,
    "vorder": 183,
    "position": 0,
    "text": "چو خورشید را پشت باریک شد"
  },
  {
    "poem_id": 88067,
    "vorder": 184,
    "position": 1,
    "text": "ز دیدار شب روز تاریک شد"
  },
  {
    "poem_id": 88067,
    "vorder": 185,
    "position": 0,
    "text": "فریبنده گرسیوز پهلوان"
  },
  {
    "poem_id": 88067,
    "vorder": 186,
    "position": 1,
    "text": "بیامد به پیش برادر نوان"
  },
  {
    "poem_id": 88067,
    "vorder": 187,
    "position": 0,
    "text": "که اکنون ز گردان که جوید نبرد"
  },
  {
    "poem_id": 88067,
    "vorder": 188,
    "position": 1,
    "text": "زمین پر ز خون آسمان پر ز گرد"
  },
  {
    "poem_id": 88067,
    "vorder": 189,
    "position": 0,
    "text": "سپه بازکش چون شب آمد مکوش"
  },
  {
    "poem_id": 88067,
    "vorder": 190,
    "position": 1,
    "text": "که اکنون برآید ز ترکان خروش"
  },
  {
    "poem_id": 88067,
    "vorder": 191,
    "position": 0,
    "text": "تو در جنگ باشی سپه در گریز"
  },
  {
    "poem_id": 88067,
    "vorder": 192,
    "position": 1,
    "text": "مکن با تن خویش چندین ستیز"
  },
  {
    "poem_id": 88067,
    "vorder": 193,
    "position": 0,
    "text": "دل شاه ترکان پر از خشم و جوش"
  },
  {
    "poem_id": 88067,
    "vorder": 194,
    "position": 1,
    "text": "ز تندی نبودش به گفتار گوش"
  },
  {
    "poem_id": 88067,
    "vorder": 195,
    "position": 0,
    "text": "برانگیخت اسب از میان سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 196,
    "position": 1,
    "text": "بیامد دمان با درفش سیاه"
  },
  {
    "poem_id": 88067,
    "vorder": 197,
    "position": 0,
    "text": "از ایرانیان چند نامی بکشت"
  },
  {
    "poem_id": 88067,
    "vorder": 198,
    "position": 1,
    "text": "چو خسرو بدید اندر آمد به پشت"
  },
  {
    "poem_id": 88067,
    "vorder": 199,
    "position": 0,
    "text": "دو شاه دو کشور چنین کینه دار"
  },
  {
    "poem_id": 88067,
    "vorder": 200,
    "position": 1,
    "text": "برفتند با خوار مایه سوار"
  },
  {
    "poem_id": 88067,
    "vorder": 201,
    "position": 0,
    "text": "ندیدند گرسیوز و جهن روی"
  },
  {
    "poem_id": 88067,
    "vorder": 202,
    "position": 1,
    "text": "که او پیش خسرو شود رزمجوی"
  },
  {
    "poem_id": 88067,
    "vorder": 203,
    "position": 0,
    "text": "عنانش گرفتند و بر تافتند"
  },
  {
    "poem_id": 88067,
    "vorder": 204,
    "position": 1,
    "text": "سوی ریگ آموی بشتافتند"
  },
  {
    "poem_id": 88067,
    "vorder": 205,
    "position": 0,
    "text": "چون او بازگشت استقیلا چو گرد"
  },
  {
    "poem_id": 88067,
    "vorder": 206,
    "position": 1,
    "text": "بیامد که با شاه جوید نبرد"
  },
  {
    "poem_id": 88067,
    "vorder": 207,
    "position": 0,
    "text": "دمان شاه ایلا به پیش سپاه"
  },
  {
    "poem_id": 88067,
    "vorder": 208,
    "position": 1,
    "text": "یکی نیزه زد بر کمرگاه شاه"
  },
  {
    "poem_id": 88067,
    "vorder": 209,
    "position": 0,
    "text": "نبد کارگر نیزه بر جوشنش"
  },
  {
    "poem_id": 88067,
    "vorder": 210,
    "position": 1,
    "text": "نه ترس آمد اندر دل روشنش"
  },
  {
    "poem_id": 88067,
    "vorder": 211,
    "position": 0,
    "text": "چو خسرو دل و زور او را بدید"
  },
  {
    "poem_id": 88067,
    "vorder": 212,
    "position": 1,
    "text": "سبک تیغ تیز از میان برکشید"
  },
  {
    "poem_id": 88067,
    "vorder": 213,
    "position": 0,
    "text": "بزد بر میانش بدو نیم کرد"
  },
  {
    "poem_id": 88067,
    "vorder": 214,
    "position": 1,
    "text": "دل برز ایلا پر از بیم کرد"
  },
  {
    "poem_id": 88067,
    "vorder": 215,
    "position": 0,
    "text": "سبک برز ایلا چو آن زخم شاه"
  },
  {
    "poem_id": 88067,
    "vorder": 216,
    "position": 1,
    "text": "بدید آن دل و زور و آن دستگاه"
  },
  {
    "poem_id": 88067,
    "vorder": 217,
    "position": 0,
    "text": "به تاریکی اندر گریزان برفت"
  },
  {
    "poem_id": 88067,
    "vorder": 218,
    "position": 1,
    "text": "همی پوست بر تنش گفتی بکفت"
  },
  {
    "poem_id": 88067,
    "vorder": 219,
    "position": 0,
    "text": "سپه چون بدیدند ز او دستبرد"
  },
  {
    "poem_id": 88067,
    "vorder": 220,
    "position": 1,
    "text": "به آوردگه بر نماند ایچ گرد"
  },
  {
    "poem_id": 88067,
    "vorder": 221,
    "position": 0,
    "text": "بر افراسیاب آن سخن مرگ بود"
  },
  {
    "poem_id": 88067,
    "vorder": 222,
    "position": 1,
    "text": "کجا پشت خود را بدیشان نمود"
  },
  {
    "poem_id": 88067,
    "vorder": 223,
    "position": 0,
    "text": "ز تورانیان او چو آگاه شد"
  },
  {
    "poem_id": 88067,
    "vorder": 224,
    "position": 1,
    "text": "تو گفتی بر او روز کوتاه شد"
  },
  {
    "poem_id": 88067,
    "vorder": 225,
    "position": 0,
    "text": "چو آوردگه خوار بگذاشتند"
  },
  {
    "poem_id": 88067,
    "vorder": 226,
    "position": 1,
    "text": "بفرمود تا بانگ برداشتند"
  },
  {
    "poem_id": 88067,
    "vorder": 227,
    "position": 0,
    "text": "که این شیر مردی ز زنگ شب است"
  },
  {
    "poem_id": 88067,
    "vorder": 228,
    "position": 1,
    "text": "مرا باز گشتن ز تنگ شب است"
  },
  {
    "poem_id": 88067,
    "vorder": 229,
    "position": 0,
    "text": "گر ایدون که امروز یکبار باد"
  },
  {
    "poem_id": 88067,
    "vorder": 230,
    "position": 1,
    "text": "ترا جست و شادی ترا در گشاد"
  },
  {
    "poem_id": 88067,
    "vorder": 231,
    "position": 0,
    "text": "چو روشن کند روز روی زمین"
  },
  {
    "poem_id": 88067,
    "vorder": 232,
    "position": 1,
    "text": "درفش دل افروز ما را ببین"
  },
  {
    "poem_id": 88067,
    "vorder": 233,
    "position": 0,
    "text": "همه روی ایران چو دریا کنیم"
  },
  {
    "poem_id": 88067,
    "vorder": 234,
    "position": 1,
    "text": "ز خورشید تابان ثریا کنیم"
  },
  {
    "poem_id": 88067,
    "vorder": 235,
    "position": 0,
    "text": "دو شاه و دو کشور چنان رزمساز"
  },
  {
    "poem_id": 88067,
    "vorder": 236,
    "position": 1,
    "text": "به لشکرگه خویش رفتند باز"
  }
]