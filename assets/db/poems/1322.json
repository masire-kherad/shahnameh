[
  {
    "poem_id": 1322,
    "vorder": 1,
    "position": 0,
    "text": "کُنون اِی خِرَدمَند وَصفِ خِرَد"
  },
  {
    "poem_id": 1322,
    "vorder": 2,
    "position": 1,
    "text": "بِدین جایگَه گفتن اَندر خُورَد"
  },
  {
    "poem_id": 1322,
    "vorder": 3,
    "position": 0,
    "text": "کُنون تا چه داری بیار از خِرَد"
  },
  {
    "poem_id": 1322,
    "vorder": 4,
    "position": 1,
    "text": "که گوشِ نیُوشَنده زو بَر خُورَد"
  },
  {
    "poem_id": 1322,
    "vorder": 5,
    "position": 0,
    "text": "خِرَد بِهتر از هَر چه ایزَد بِداد"
  },
  {
    "poem_id": 1322,
    "vorder": 6,
    "position": 1,
    "text": "ستایش خِرَد را بِه از راهِ داد"
  },
  {
    "poem_id": 1322,
    "vorder": 7,
    "position": 0,
    "text": "خِرَد رَهنمای وُ خِرَد دِلگشای"
  },
  {
    "poem_id": 1322,
    "vorder": 8,
    "position": 1,
    "text": "خِرَد دَست گیرد به هَر دو سَرای"
  },
  {
    "poem_id": 1322,
    "vorder": 9,
    "position": 0,
    "text": "از او شادمانی وزویَت غَمی است"
  },
  {
    "poem_id": 1322,
    "vorder": 10,
    "position": 1,
    "text": "وزویَت فُزونی وزویَت کَمی است"
  },
  {
    "poem_id": 1322,
    "vorder": 11,
    "position": 0,
    "text": "خِرَد تیره وُ مَرد روشن رَوان"
  },
  {
    "poem_id": 1322,
    "vorder": 12,
    "position": 1,
    "text": "نَباشَد هَمی شادمان یِک زَمان"
  },
  {
    "poem_id": 1322,
    "vorder": 13,
    "position": 0,
    "text": "چه گُفت آن خِرَدمَند مَردِ خِرَد"
  },
  {
    "poem_id": 1322,
    "vorder": 14,
    "position": 1,
    "text": "که دانا زِ گفتار او بَر خُورَد"
  },
  {
    "poem_id": 1322,
    "vorder": 15,
    "position": 0,
    "text": "کسی کو خِرَد را نَدارَد زِ پیش"
  },
  {
    "poem_id": 1322,
    "vorder": 16,
    "position": 1,
    "text": "دِلش گَردَد از کَردهٔ خویش ریش"
  },
  {
    "poem_id": 1322,
    "vorder": 17,
    "position": 0,
    "text": "هُشیوار دیوانه خوانَد وُرا"
  },
  {
    "poem_id": 1322,
    "vorder": 18,
    "position": 1,
    "text": "همان خویش بیگانه دانَد وُرا"
  },
  {
    "poem_id": 1322,
    "vorder": 19,
    "position": 0,
    "text": "از اویی به هَر دو سَرای اَرجمَند"
  },
  {
    "poem_id": 1322,
    "vorder": 20,
    "position": 1,
    "text": "گسسته خِرَد پای دارَد به بَند"
  },
  {
    "poem_id": 1322,
    "vorder": 21,
    "position": 0,
    "text": "خِرَد چَشمِ جان اَست چون بِنگری"
  },
  {
    "poem_id": 1322,
    "vorder": 22,
    "position": 1,
    "text": "تو بی‌چَشمِ شادان جَهان نَسپَری"
  },
  {
    "poem_id": 1322,
    "vorder": 23,
    "position": 0,
    "text": "نخُست‌آفرینش خِرَد را شِناس"
  },
  {
    "poem_id": 1322,
    "vorder": 24,
    "position": 1,
    "text": "نگهبانِ جان است و آنِ سه پاس"
  },
  {
    "poem_id": 1322,
    "vorder": 25,
    "position": 0,
    "text": "سه پاسِ تو چَشم اَست و گوش وُ زَبان"
  },
  {
    "poem_id": 1322,
    "vorder": 26,
    "position": 1,
    "text": "کَز این سه رَسَد نیک و بَد بی‌گُمان"
  },
  {
    "poem_id": 1322,
    "vorder": 27,
    "position": 0,
    "text": "خِرَد را وُ جان را که یارَد سُتود"
  },
  {
    "poem_id": 1322,
    "vorder": 28,
    "position": 1,
    "text": "وَ گَر مَن سِتایم که یارَد شُنود"
  },
  {
    "poem_id": 1322,
    "vorder": 29,
    "position": 0,
    "text": "حَکیما چو کَس نیست گُفتن چه سود"
  },
  {
    "poem_id": 1322,
    "vorder": 30,
    "position": 1,
    "text": "از این پَس بگو کآفرینش چه بود"
  },
  {
    "poem_id": 1322,
    "vorder": 31,
    "position": 0,
    "text": "تویی کردهٔ کِردگارِ جهان"
  },
  {
    "poem_id": 1322,
    "vorder": 32,
    "position": 1,
    "text": "ببینی هَمی آشکار وُ نَهان"
  },
  {
    "poem_id": 1322,
    "vorder": 33,
    "position": 0,
    "text": "به گفتارِ دانندگان راه جُوی"
  },
  {
    "poem_id": 1322,
    "vorder": 34,
    "position": 1,
    "text": "به گیتی بِپوی وُ به هَر کَس بِگوی"
  },
  {
    "poem_id": 1322,
    "vorder": 35,
    "position": 0,
    "text": "زِ هَر دانشی چون سخن بِشنَوی"
  },
  {
    "poem_id": 1322,
    "vorder": 36,
    "position": 1,
    "text": "از آموختن یِک زَمان نَغنَوی"
  },
  {
    "poem_id": 1322,
    "vorder": 37,
    "position": 0,
    "text": "چو دیدار یابی به شاخِ سَخُن"
  },
  {
    "poem_id": 1322,
    "vorder": 38,
    "position": 1,
    "text": "بدانی که دانش نیاید به بُن"
  }
]