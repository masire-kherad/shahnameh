[
  {
    "poem_id": 1660,
    "vorder": 1,
    "position": 0,
    "text": "سکندر چو بشنید از یادگیر"
  },
  {
    "poem_id": 1660,
    "vorder": 2,
    "position": 1,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1660,
    "vorder": 3,
    "position": 0,
    "text": "نوشتند پس نامه‌ای بر حریر"
  },
  {
    "poem_id": 1660,
    "vorder": 4,
    "position": 1,
    "text": "ز شیراوژن اسکندر شهرگیر"
  },
  {
    "poem_id": 1660,
    "vorder": 5,
    "position": 0,
    "text": "به نزدیک قیدافهٔ هوشمند"
  },
  {
    "poem_id": 1660,
    "vorder": 6,
    "position": 1,
    "text": "شده نام او در بزرگی بلند"
  },
  {
    "poem_id": 1660,
    "vorder": 7,
    "position": 0,
    "text": "نخست آفرین خداوند مهر"
  },
  {
    "poem_id": 1660,
    "vorder": 8,
    "position": 1,
    "text": "فروزندهٔ ماه و گردان سپهر"
  },
  {
    "poem_id": 1660,
    "vorder": 9,
    "position": 0,
    "text": "خداوند بخشنده داد و راست"
  },
  {
    "poem_id": 1660,
    "vorder": 10,
    "position": 1,
    "text": "فزونی کسی را دهد کش سزاست"
  },
  {
    "poem_id": 1660,
    "vorder": 11,
    "position": 0,
    "text": "به تندی نجستیم رزم ترا"
  },
  {
    "poem_id": 1660,
    "vorder": 12,
    "position": 1,
    "text": "گراینده گشتیم بزم ترا"
  },
  {
    "poem_id": 1660,
    "vorder": 13,
    "position": 0,
    "text": "چو این نامه آرند نزدیک تو"
  },
  {
    "poem_id": 1660,
    "vorder": 14,
    "position": 1,
    "text": "درخشان شود رای تاریک تو"
  },
  {
    "poem_id": 1660,
    "vorder": 15,
    "position": 0,
    "text": "فرستی به فرمان ما باژ و ساو"
  },
  {
    "poem_id": 1660,
    "vorder": 16,
    "position": 1,
    "text": "بدانی که با ما ترا نیست تاو"
  },
  {
    "poem_id": 1660,
    "vorder": 17,
    "position": 0,
    "text": "خردمندی و پیش‌بینی کنی"
  },
  {
    "poem_id": 1660,
    "vorder": 18,
    "position": 1,
    "text": "توانایی و پاک دینی کنی"
  },
  {
    "poem_id": 1660,
    "vorder": 19,
    "position": 0,
    "text": "وگر هیچ تاب اندر آری به کار"
  },
  {
    "poem_id": 1660,
    "vorder": 20,
    "position": 1,
    "text": "نبینی جز از گردش روزگار"
  },
  {
    "poem_id": 1660,
    "vorder": 21,
    "position": 0,
    "text": "چو اندازه گیری ز دارا و فور"
  },
  {
    "poem_id": 1660,
    "vorder": 22,
    "position": 1,
    "text": "خود آموزگارت نباید ز دور"
  },
  {
    "poem_id": 1660,
    "vorder": 23,
    "position": 0,
    "text": "چو از باد عنوان او گشت خشک"
  },
  {
    "poem_id": 1660,
    "vorder": 24,
    "position": 1,
    "text": "نهادند مهری بروبر ز مشک"
  },
  {
    "poem_id": 1660,
    "vorder": 25,
    "position": 0,
    "text": "بیامد هیون تگاور به راه"
  },
  {
    "poem_id": 1660,
    "vorder": 26,
    "position": 1,
    "text": "به فرمان آن نامبردار شاه"
  },
  {
    "poem_id": 1660,
    "vorder": 27,
    "position": 0,
    "text": "چو قیدافه آن نامهٔ او بخواند"
  },
  {
    "poem_id": 1660,
    "vorder": 28,
    "position": 1,
    "text": "ز گفتار او در شگفتی بماند"
  },
  {
    "poem_id": 1660,
    "vorder": 29,
    "position": 0,
    "text": "به پاسخ نخست آفرین گسترید"
  },
  {
    "poem_id": 1660,
    "vorder": 30,
    "position": 1,
    "text": "بدان دادگر کو زمین گسترید"
  },
  {
    "poem_id": 1660,
    "vorder": 31,
    "position": 0,
    "text": "ترا کرد پیروز بر فور هند"
  },
  {
    "poem_id": 1660,
    "vorder": 32,
    "position": 1,
    "text": "به دارا و بر نامداران سند"
  },
  {
    "poem_id": 1660,
    "vorder": 33,
    "position": 0,
    "text": "مرا با چو ایشان برابر نهی"
  },
  {
    "poem_id": 1660,
    "vorder": 34,
    "position": 1,
    "text": "به سر بر ز پیروزه افسر نهی"
  },
  {
    "poem_id": 1660,
    "vorder": 35,
    "position": 0,
    "text": "مرا زان فزونست فر و مهی"
  },
  {
    "poem_id": 1660,
    "vorder": 36,
    "position": 1,
    "text": "همان لشکر و گنج شاهنشهی"
  },
  {
    "poem_id": 1660,
    "vorder": 37,
    "position": 0,
    "text": "که من قیصران را به فرمان شوم"
  },
  {
    "poem_id": 1660,
    "vorder": 38,
    "position": 1,
    "text": "بترسم ز تهدید و پیچان شوم"
  },
  {
    "poem_id": 1660,
    "vorder": 39,
    "position": 0,
    "text": "هزاران هزارم فزون لشکرست"
  },
  {
    "poem_id": 1660,
    "vorder": 40,
    "position": 1,
    "text": "که بر هر سری شهریاری سرست"
  },
  {
    "poem_id": 1660,
    "vorder": 41,
    "position": 0,
    "text": "وگر خوانم از هر سوی زیردست"
  },
  {
    "poem_id": 1660,
    "vorder": 42,
    "position": 1,
    "text": "نماند برین بوم جای نشست"
  },
  {
    "poem_id": 1660,
    "vorder": 43,
    "position": 0,
    "text": "یکی گنج در پیش هر مهتری"
  },
  {
    "poem_id": 1660,
    "vorder": 44,
    "position": 1,
    "text": "چو آید ازین مرز با لشکری"
  },
  {
    "poem_id": 1660,
    "vorder": 45,
    "position": 0,
    "text": "تو چندین چه رانی زبان بر گزاف"
  },
  {
    "poem_id": 1660,
    "vorder": 46,
    "position": 1,
    "text": "ز دارا شدستی خداوند لاف"
  },
  {
    "poem_id": 1660,
    "vorder": 47,
    "position": 0,
    "text": "بران نامه بر مهر زرین نهاد"
  },
  {
    "poem_id": 1660,
    "vorder": 48,
    "position": 1,
    "text": "هیونی برافگند بر سان باد"
  }
]