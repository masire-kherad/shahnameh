[
  {
    "poem_id": 1586,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود کاسپ سیه زین کنید"
  },
  {
    "poem_id": 1586,
    "vorder": 2,
    "position": 1,
    "text": "به بالای او زین زرین کنید"
  },
  {
    "poem_id": 1586,
    "vorder": 3,
    "position": 0,
    "text": "پس از لشکر نامور صدسوار"
  },
  {
    "poem_id": 1586,
    "vorder": 4,
    "position": 1,
    "text": "برفتند با فرخ اسفندیار"
  },
  {
    "poem_id": 1586,
    "vorder": 5,
    "position": 0,
    "text": "بیامد دمان تا لب هیرمند"
  },
  {
    "poem_id": 1586,
    "vorder": 6,
    "position": 1,
    "text": "به فتراک بر گرد کرده کمند"
  },
  {
    "poem_id": 1586,
    "vorder": 7,
    "position": 0,
    "text": "ازین سو خروشی برآورد رخش"
  },
  {
    "poem_id": 1586,
    "vorder": 8,
    "position": 1,
    "text": "وزان روی اسپ یل تاج‌بخش"
  },
  {
    "poem_id": 1586,
    "vorder": 9,
    "position": 0,
    "text": "چنین تا رسیدند نزدیک آب"
  },
  {
    "poem_id": 1586,
    "vorder": 10,
    "position": 1,
    "text": "به دیدار هر دو گرفته شتاب"
  },
  {
    "poem_id": 1586,
    "vorder": 11,
    "position": 0,
    "text": "تهمتن ز خشک اندر آمد به رود"
  },
  {
    "poem_id": 1586,
    "vorder": 12,
    "position": 1,
    "text": "پیاده شد و داد یل را درود"
  },
  {
    "poem_id": 1586,
    "vorder": 13,
    "position": 0,
    "text": "پس از آفرین گفت کز یک خدای"
  },
  {
    "poem_id": 1586,
    "vorder": 14,
    "position": 1,
    "text": "همی خواستم تا بود رهنمای"
  },
  {
    "poem_id": 1586,
    "vorder": 15,
    "position": 0,
    "text": "که با نامداران بدین جایگاه"
  },
  {
    "poem_id": 1586,
    "vorder": 16,
    "position": 1,
    "text": "چنین تندرست آید و با سپاه"
  },
  {
    "poem_id": 1586,
    "vorder": 17,
    "position": 0,
    "text": "نشینیم یکجای و پاسخ دهیم"
  },
  {
    "poem_id": 1586,
    "vorder": 18,
    "position": 1,
    "text": "همی در سخن رای فرخ نهیم"
  },
  {
    "poem_id": 1586,
    "vorder": 19,
    "position": 0,
    "text": "چنان دان که یزدان گوای منست"
  },
  {
    "poem_id": 1586,
    "vorder": 20,
    "position": 1,
    "text": "خرد زین سخن رهنمای منست"
  },
  {
    "poem_id": 1586,
    "vorder": 21,
    "position": 0,
    "text": "که من زین سخنها نجویم فروغ"
  },
  {
    "poem_id": 1586,
    "vorder": 22,
    "position": 1,
    "text": "نگردم به هر کار گرد دروغ"
  },
  {
    "poem_id": 1586,
    "vorder": 23,
    "position": 0,
    "text": "که روی سیاوش گر دیدمی"
  },
  {
    "poem_id": 1586,
    "vorder": 24,
    "position": 1,
    "text": "بدین تازه‌رویی نگردیدمی"
  },
  {
    "poem_id": 1586,
    "vorder": 25,
    "position": 0,
    "text": "نمانی همی چز سیاوخش را"
  },
  {
    "poem_id": 1586,
    "vorder": 26,
    "position": 1,
    "text": "مر آن تاج‌دار جهان بخش را"
  },
  {
    "poem_id": 1586,
    "vorder": 27,
    "position": 0,
    "text": "خنک شاه کو چون تو دارد پسر"
  },
  {
    "poem_id": 1586,
    "vorder": 28,
    "position": 1,
    "text": "به بالا و فرت بنازد پدر"
  },
  {
    "poem_id": 1586,
    "vorder": 29,
    "position": 0,
    "text": "خنک شهر ایران که تخت ترا"
  },
  {
    "poem_id": 1586,
    "vorder": 30,
    "position": 1,
    "text": "پرستند بیدار بخت ترا"
  },
  {
    "poem_id": 1586,
    "vorder": 31,
    "position": 0,
    "text": "دژم بخت آنکس که با تو نبرد"
  },
  {
    "poem_id": 1586,
    "vorder": 32,
    "position": 1,
    "text": "بجوید ز تخت اندر آید به گرد"
  },
  {
    "poem_id": 1586,
    "vorder": 33,
    "position": 0,
    "text": "همه دشمنان از تو پر بیم باد"
  },
  {
    "poem_id": 1586,
    "vorder": 34,
    "position": 1,
    "text": "دل بدسگالان به دو نیم باد"
  },
  {
    "poem_id": 1586,
    "vorder": 35,
    "position": 0,
    "text": "همه ساله بخت تو پیروز باد"
  },
  {
    "poem_id": 1586,
    "vorder": 36,
    "position": 1,
    "text": "شبان سیه بر تو نوروز باد"
  },
  {
    "poem_id": 1586,
    "vorder": 37,
    "position": 0,
    "text": "چو بشنید گفتارش اسفندیار"
  },
  {
    "poem_id": 1586,
    "vorder": 38,
    "position": 1,
    "text": "فرود آمد از بارهٔ نامدار"
  },
  {
    "poem_id": 1586,
    "vorder": 39,
    "position": 0,
    "text": "گو پیلتن را به بر در گرفت"
  },
  {
    "poem_id": 1586,
    "vorder": 40,
    "position": 1,
    "text": "چو خشنود شد آفرین برگرفت"
  },
  {
    "poem_id": 1586,
    "vorder": 41,
    "position": 0,
    "text": "که یزدان سپاس ای جهان پهلوان"
  },
  {
    "poem_id": 1586,
    "vorder": 42,
    "position": 1,
    "text": "که دیدم ترا شاد و روشن‌روان"
  },
  {
    "poem_id": 1586,
    "vorder": 43,
    "position": 0,
    "text": "سزاوار باشد ستودن ترا"
  },
  {
    "poem_id": 1586,
    "vorder": 44,
    "position": 1,
    "text": "یلان جهان خاک بودن ترا"
  },
  {
    "poem_id": 1586,
    "vorder": 45,
    "position": 0,
    "text": "خنک آنک چون تو پسر باشدش"
  },
  {
    "poem_id": 1586,
    "vorder": 46,
    "position": 1,
    "text": "یکی شاخ بیند که بر باشدش"
  },
  {
    "poem_id": 1586,
    "vorder": 47,
    "position": 0,
    "text": "خنک آنک او را بود چون تو پشت"
  },
  {
    "poem_id": 1586,
    "vorder": 48,
    "position": 1,
    "text": "بود ایمن از روزگار درشت"
  },
  {
    "poem_id": 1586,
    "vorder": 49,
    "position": 0,
    "text": "خنک زال کش بگذرد روزگار"
  },
  {
    "poem_id": 1586,
    "vorder": 50,
    "position": 1,
    "text": "به گیتی بماند ترا یادگار"
  },
  {
    "poem_id": 1586,
    "vorder": 51,
    "position": 0,
    "text": "بدیدم ترا یادم آمد زریر"
  },
  {
    "poem_id": 1586,
    "vorder": 52,
    "position": 1,
    "text": "سپهدار اسپ‌افگن و نره شیر"
  },
  {
    "poem_id": 1586,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت رستم که ای پهلوان"
  },
  {
    "poem_id": 1586,
    "vorder": 54,
    "position": 1,
    "text": "جهاندار و بیدار و روشن‌روان"
  },
  {
    "poem_id": 1586,
    "vorder": 55,
    "position": 0,
    "text": "یکی آرزو دارم از شهریار"
  },
  {
    "poem_id": 1586,
    "vorder": 56,
    "position": 1,
    "text": "که باشم بران آرزو کامگار"
  },
  {
    "poem_id": 1586,
    "vorder": 57,
    "position": 0,
    "text": "خرامان بیایی سوی خان من"
  },
  {
    "poem_id": 1586,
    "vorder": 58,
    "position": 1,
    "text": "به دیدار روشن کنی جان من"
  },
  {
    "poem_id": 1586,
    "vorder": 59,
    "position": 0,
    "text": "سزای تو گر نیست چیزی که هست"
  },
  {
    "poem_id": 1586,
    "vorder": 60,
    "position": 1,
    "text": "بکوشیم و با آن بساییم دست"
  },
  {
    "poem_id": 1586,
    "vorder": 61,
    "position": 0,
    "text": "چنین پاسخ آوردش اسفندیار"
  },
  {
    "poem_id": 1586,
    "vorder": 62,
    "position": 1,
    "text": "که ای از یلان جهان یادگار"
  },
  {
    "poem_id": 1586,
    "vorder": 63,
    "position": 0,
    "text": "هرانکس کجا چون تو باشد به نام"
  },
  {
    "poem_id": 1586,
    "vorder": 64,
    "position": 1,
    "text": "همه شهر ایران بدو شادکام"
  },
  {
    "poem_id": 1586,
    "vorder": 65,
    "position": 0,
    "text": "نشاید گذر کردن از رای تو"
  },
  {
    "poem_id": 1586,
    "vorder": 66,
    "position": 1,
    "text": "گذشت از بر و بوم وز جای تو"
  },
  {
    "poem_id": 1586,
    "vorder": 67,
    "position": 0,
    "text": "ولیکن ز فرمان شاه جهان"
  },
  {
    "poem_id": 1586,
    "vorder": 68,
    "position": 1,
    "text": "نپیچم روان آشکار و نهان"
  },
  {
    "poem_id": 1586,
    "vorder": 69,
    "position": 0,
    "text": "به زابل نفرمود ما را درنگ"
  },
  {
    "poem_id": 1586,
    "vorder": 70,
    "position": 1,
    "text": "نه با نامداران این بوم جنگ"
  },
  {
    "poem_id": 1586,
    "vorder": 71,
    "position": 0,
    "text": "تو آن کن که بر یابی از روزگار"
  },
  {
    "poem_id": 1586,
    "vorder": 72,
    "position": 1,
    "text": "بران رو که فرمان دهد شهریار"
  },
  {
    "poem_id": 1586,
    "vorder": 73,
    "position": 0,
    "text": "تو خود بند بر پای نه بی‌درنگ"
  },
  {
    "poem_id": 1586,
    "vorder": 74,
    "position": 1,
    "text": "نباشد ز بند شهنشاه ننگ"
  },
  {
    "poem_id": 1586,
    "vorder": 75,
    "position": 0,
    "text": "ترا چون برم بسته نزدیک شاه"
  },
  {
    "poem_id": 1586,
    "vorder": 76,
    "position": 1,
    "text": "سراسر بدو بازگردد گناه"
  },
  {
    "poem_id": 1586,
    "vorder": 77,
    "position": 0,
    "text": "وزین بستگی من جگر خسته‌ام"
  },
  {
    "poem_id": 1586,
    "vorder": 78,
    "position": 1,
    "text": "به پیش تو اندر کمر بسته‌ام"
  },
  {
    "poem_id": 1586,
    "vorder": 79,
    "position": 0,
    "text": "نمانم که تا شب بمانی به بند"
  },
  {
    "poem_id": 1586,
    "vorder": 80,
    "position": 1,
    "text": "وگر بر تو آید ز چیزی گزند"
  },
  {
    "poem_id": 1586,
    "vorder": 81,
    "position": 0,
    "text": "همه از من انگار ای پهلوان"
  },
  {
    "poem_id": 1586,
    "vorder": 82,
    "position": 1,
    "text": "بدی ناید از شاه خود بیگمان"
  },
  {
    "poem_id": 1586,
    "vorder": 83,
    "position": 0,
    "text": "ازان پس که من تاج بر سر نهم"
  },
  {
    "poem_id": 1586,
    "vorder": 84,
    "position": 1,
    "text": "جهان را به دست تو اندر نهم"
  },
  {
    "poem_id": 1586,
    "vorder": 85,
    "position": 0,
    "text": "نه نزدیک دادار باشد گناه"
  },
  {
    "poem_id": 1586,
    "vorder": 86,
    "position": 1,
    "text": "نه شرم آیدم از تاجور روی شاه"
  },
  {
    "poem_id": 1586,
    "vorder": 87,
    "position": 0,
    "text": "چو تو بازگردی به زابلستان"
  },
  {
    "poem_id": 1586,
    "vorder": 88,
    "position": 1,
    "text": "به هنگام بشکوفهٔ گلستان"
  },
  {
    "poem_id": 1586,
    "vorder": 89,
    "position": 0,
    "text": "ز من نیز یابی بسی خواسته"
  },
  {
    "poem_id": 1586,
    "vorder": 90,
    "position": 1,
    "text": "که گردد بر و بومت آراسته"
  },
  {
    "poem_id": 1586,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت رستم که ای نامدار"
  },
  {
    "poem_id": 1586,
    "vorder": 92,
    "position": 1,
    "text": "همی جستم از داور کردگار"
  },
  {
    "poem_id": 1586,
    "vorder": 93,
    "position": 0,
    "text": "که خرم کنم دل به دیدار تو"
  },
  {
    "poem_id": 1586,
    "vorder": 94,
    "position": 1,
    "text": "کنون چون پسندم من آزار تو"
  },
  {
    "poem_id": 1586,
    "vorder": 95,
    "position": 0,
    "text": "دو گردن فرازیم پیر و جوان"
  },
  {
    "poem_id": 1586,
    "vorder": 96,
    "position": 1,
    "text": "خردمند و بیدار دو پهلوان"
  },
  {
    "poem_id": 1586,
    "vorder": 97,
    "position": 0,
    "text": "بترسم که چشم بد آید همی"
  },
  {
    "poem_id": 1586,
    "vorder": 98,
    "position": 1,
    "text": "سر از خواب خوش برگراید همی"
  },
  {
    "poem_id": 1586,
    "vorder": 99,
    "position": 0,
    "text": "همی یابد اندر میان دیو راه"
  },
  {
    "poem_id": 1586,
    "vorder": 100,
    "position": 1,
    "text": "دلت کژ کند از پی تاج و گاه"
  },
  {
    "poem_id": 1586,
    "vorder": 101,
    "position": 0,
    "text": "یکی ننگ باشد مرا زین سخن"
  },
  {
    "poem_id": 1586,
    "vorder": 102,
    "position": 1,
    "text": "که تا جاودان آن نگردد کهن"
  },
  {
    "poem_id": 1586,
    "vorder": 103,
    "position": 0,
    "text": "که چون تو سپهبد گزیده سری"
  },
  {
    "poem_id": 1586,
    "vorder": 104,
    "position": 1,
    "text": "سرافراز شیری و گندآوری"
  },
  {
    "poem_id": 1586,
    "vorder": 105,
    "position": 0,
    "text": "نیایی زمانی تو در خان من"
  },
  {
    "poem_id": 1586,
    "vorder": 106,
    "position": 1,
    "text": "نباشی بدین مرز مهمان من"
  },
  {
    "poem_id": 1586,
    "vorder": 107,
    "position": 0,
    "text": "گر این تیزی از مغز بیرون کنی"
  },
  {
    "poem_id": 1586,
    "vorder": 108,
    "position": 1,
    "text": "بکوشی و بر خسته افسون کنی"
  },
  {
    "poem_id": 1586,
    "vorder": 109,
    "position": 0,
    "text": "ز من هرچ خواهیت فرمان کنم"
  },
  {
    "poem_id": 1586,
    "vorder": 110,
    "position": 1,
    "text": "ز دیدار تو رامش جان کنم"
  },
  {
    "poem_id": 1586,
    "vorder": 111,
    "position": 0,
    "text": "مگر بند کز بند عاری بود"
  },
  {
    "poem_id": 1586,
    "vorder": 112,
    "position": 1,
    "text": "شکستی بود زشت کاری بود"
  },
  {
    "poem_id": 1586,
    "vorder": 113,
    "position": 0,
    "text": "نبیند مرا زنده با بند کس"
  },
  {
    "poem_id": 1586,
    "vorder": 114,
    "position": 1,
    "text": "که روشن روانم برینست و بس"
  },
  {
    "poem_id": 1586,
    "vorder": 115,
    "position": 0,
    "text": "ز تو پیش بودند کنداوران"
  },
  {
    "poem_id": 1586,
    "vorder": 116,
    "position": 1,
    "text": "نکردند پایم به بند گران"
  },
  {
    "poem_id": 1586,
    "vorder": 117,
    "position": 0,
    "text": "به پاسخ چنین گفتش اسفندیار"
  },
  {
    "poem_id": 1586,
    "vorder": 118,
    "position": 1,
    "text": "که ای در جهان از گوان یادگار"
  },
  {
    "poem_id": 1586,
    "vorder": 119,
    "position": 0,
    "text": "همه راست گفتی نگفتی دروغ"
  },
  {
    "poem_id": 1586,
    "vorder": 120,
    "position": 1,
    "text": "به کژی نگیرند مردان فروغ"
  },
  {
    "poem_id": 1586,
    "vorder": 121,
    "position": 0,
    "text": "ولیکن پشوتن شناسد که شاه"
  },
  {
    "poem_id": 1586,
    "vorder": 122,
    "position": 1,
    "text": "چه فرمود تا من برفتم به راه"
  },
  {
    "poem_id": 1586,
    "vorder": 123,
    "position": 0,
    "text": "گر اکنون بیایم سوی خان تو"
  },
  {
    "poem_id": 1586,
    "vorder": 124,
    "position": 1,
    "text": "بوم شاد و پیروز مهمان تو"
  },
  {
    "poem_id": 1586,
    "vorder": 125,
    "position": 0,
    "text": "تو گردن بپیچی ز فرمان شاه"
  },
  {
    "poem_id": 1586,
    "vorder": 126,
    "position": 1,
    "text": "مرا تابش روز گردد سیاه"
  },
  {
    "poem_id": 1586,
    "vorder": 127,
    "position": 0,
    "text": "دگر آنک گر با تو جنگ آورم"
  },
  {
    "poem_id": 1586,
    "vorder": 128,
    "position": 1,
    "text": "به پرخاش خوی پلنگ آورم"
  },
  {
    "poem_id": 1586,
    "vorder": 129,
    "position": 0,
    "text": "فرامش کنم مهر نان و نمک"
  },
  {
    "poem_id": 1586,
    "vorder": 130,
    "position": 1,
    "text": "به من بر دگرگونه گردد فلک"
  },
  {
    "poem_id": 1586,
    "vorder": 131,
    "position": 0,
    "text": "وگر سربپیچم ز فرمان شاه"
  },
  {
    "poem_id": 1586,
    "vorder": 132,
    "position": 1,
    "text": "بدان گیتی آتش بود جایگاه"
  },
  {
    "poem_id": 1586,
    "vorder": 133,
    "position": 0,
    "text": "ترا آرزو گر چنین آمدست"
  },
  {
    "poem_id": 1586,
    "vorder": 134,
    "position": 1,
    "text": "یک امروز با می بساییم دست"
  },
  {
    "poem_id": 1586,
    "vorder": 135,
    "position": 0,
    "text": "که داند که فردا چه شاید بدن"
  },
  {
    "poem_id": 1586,
    "vorder": 136,
    "position": 1,
    "text": "بدین داستانی نباید زدن"
  },
  {
    "poem_id": 1586,
    "vorder": 137,
    "position": 0,
    "text": "بدو گفت رستم که ایدون کنم"
  },
  {
    "poem_id": 1586,
    "vorder": 138,
    "position": 1,
    "text": "شوم جامهٔ راه بیرون کنم"
  },
  {
    "poem_id": 1586,
    "vorder": 139,
    "position": 0,
    "text": "به یک هفته نخچیر کردم همی"
  },
  {
    "poem_id": 1586,
    "vorder": 140,
    "position": 1,
    "text": "به جای بره گور خوردم همی"
  },
  {
    "poem_id": 1586,
    "vorder": 141,
    "position": 0,
    "text": "به هنگام خوردن مرا باز خوان"
  },
  {
    "poem_id": 1586,
    "vorder": 142,
    "position": 1,
    "text": "چو با دوده بنشینی از پیش خوان"
  },
  {
    "poem_id": 1586,
    "vorder": 143,
    "position": 0,
    "text": "ازان جایگه رخش را برنشست"
  },
  {
    "poem_id": 1586,
    "vorder": 144,
    "position": 1,
    "text": "دل خسته را اندر اندیشه بست"
  },
  {
    "poem_id": 1586,
    "vorder": 145,
    "position": 0,
    "text": "بیامد دمان تا به ایوان رسید"
  },
  {
    "poem_id": 1586,
    "vorder": 146,
    "position": 1,
    "text": "رخ زال سام نریمان بدید"
  },
  {
    "poem_id": 1586,
    "vorder": 147,
    "position": 0,
    "text": "بدو گفت کای مهتر نامدار"
  },
  {
    "poem_id": 1586,
    "vorder": 148,
    "position": 1,
    "text": "رسیدم به نزدیک اسفندیار"
  },
  {
    "poem_id": 1586,
    "vorder": 149,
    "position": 0,
    "text": "سواریش دیدم چو سرو سهی"
  },
  {
    "poem_id": 1586,
    "vorder": 150,
    "position": 1,
    "text": "خردمند و با زیب و با فرهی"
  },
  {
    "poem_id": 1586,
    "vorder": 151,
    "position": 0,
    "text": "تو گفتی که شاه فریدون گرد"
  },
  {
    "poem_id": 1586,
    "vorder": 152,
    "position": 1,
    "text": "بزرگی دانایی او را سپرد"
  },
  {
    "poem_id": 1586,
    "vorder": 153,
    "position": 0,
    "text": "به دیدن فزون آمد از آگهی"
  },
  {
    "poem_id": 1586,
    "vorder": 154,
    "position": 1,
    "text": "همی تافت زو فر شاهنشهی"
  }
]