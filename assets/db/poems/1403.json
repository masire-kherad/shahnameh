[
  {
    "poem_id": 1403,
    "vorder": 1,
    "position": 0,
    "text": "بیامد یکی موبدی چرب دست"
  },
  {
    "poem_id": 1403,
    "vorder": 2,
    "position": 1,
    "text": "مر آن ماه رخ را به می کرد مست"
  },
  {
    "poem_id": 1403,
    "vorder": 3,
    "position": 0,
    "text": "بکافید بی‌رنج پهلوی ماه"
  },
  {
    "poem_id": 1403,
    "vorder": 4,
    "position": 1,
    "text": "بتابید مر بچه را سر ز راه"
  },
  {
    "poem_id": 1403,
    "vorder": 5,
    "position": 0,
    "text": "چنان بی‌گزندش برون آورید"
  },
  {
    "poem_id": 1403,
    "vorder": 6,
    "position": 1,
    "text": "که کس در جهان این شگفتی ندید"
  },
  {
    "poem_id": 1403,
    "vorder": 7,
    "position": 0,
    "text": "یکی بچه بد چون گوی شیرفش"
  },
  {
    "poem_id": 1403,
    "vorder": 8,
    "position": 1,
    "text": "به بالا بلند و به دیدار کش"
  },
  {
    "poem_id": 1403,
    "vorder": 9,
    "position": 0,
    "text": "شگفت اندرو مانده بد مرد و زن"
  },
  {
    "poem_id": 1403,
    "vorder": 10,
    "position": 1,
    "text": "که نشنید کس بچهٔ پیل تن"
  },
  {
    "poem_id": 1403,
    "vorder": 11,
    "position": 0,
    "text": "همان دردگاهش فرو دوختند"
  },
  {
    "poem_id": 1403,
    "vorder": 12,
    "position": 1,
    "text": "به دارو همه درد بسپوختند"
  },
  {
    "poem_id": 1403,
    "vorder": 13,
    "position": 0,
    "text": "شبانروز مادر ز می خفته بود"
  },
  {
    "poem_id": 1403,
    "vorder": 14,
    "position": 1,
    "text": "ز می خفته و هش ازو رفته بود"
  },
  {
    "poem_id": 1403,
    "vorder": 15,
    "position": 0,
    "text": "چو از خواب بیدار شد سرو بن"
  },
  {
    "poem_id": 1403,
    "vorder": 16,
    "position": 1,
    "text": "به سیندخت بگشاد لب بر سخن"
  },
  {
    "poem_id": 1403,
    "vorder": 17,
    "position": 0,
    "text": "بر او زر و گوهر برافشاندند"
  },
  {
    "poem_id": 1403,
    "vorder": 18,
    "position": 1,
    "text": "ابر کردگار آفرین خواندند"
  },
  {
    "poem_id": 1403,
    "vorder": 19,
    "position": 0,
    "text": "مر آن بچه را پیش او تاختند"
  },
  {
    "poem_id": 1403,
    "vorder": 20,
    "position": 1,
    "text": "به سان سپهری برافراختند"
  },
  {
    "poem_id": 1403,
    "vorder": 21,
    "position": 0,
    "text": "بخندید از آن بچه سرو سُهی"
  },
  {
    "poem_id": 1403,
    "vorder": 22,
    "position": 1,
    "text": "بدید اندرو فر شاهنشهی"
  },
  {
    "poem_id": 1403,
    "vorder": 23,
    "position": 0,
    "text": "برستم بگفتا غم آمد به سر"
  },
  {
    "poem_id": 1403,
    "vorder": 24,
    "position": 1,
    "text": "نهادند رستمش نام پسر"
  },
  {
    "poem_id": 1403,
    "vorder": 25,
    "position": 0,
    "text": "یکی کودکی دوختند از حریر"
  },
  {
    "poem_id": 1403,
    "vorder": 26,
    "position": 1,
    "text": "به بالای آن شیر ناخورده شیر"
  },
  {
    "poem_id": 1403,
    "vorder": 27,
    "position": 0,
    "text": "درون وی آگنده موی سمور"
  },
  {
    "poem_id": 1403,
    "vorder": 28,
    "position": 1,
    "text": "به رخ بر نگاریده ناهید و هور"
  },
  {
    "poem_id": 1403,
    "vorder": 29,
    "position": 0,
    "text": "به بازوش بر اژدهای دلیر"
  },
  {
    "poem_id": 1403,
    "vorder": 30,
    "position": 1,
    "text": "به چنگ اندرش داده چنگال شیر"
  },
  {
    "poem_id": 1403,
    "vorder": 31,
    "position": 0,
    "text": "به زیر کش اندر گرفته سنان"
  },
  {
    "poem_id": 1403,
    "vorder": 32,
    "position": 1,
    "text": "به یک دست کوپال و دیگر عنان"
  },
  {
    "poem_id": 1403,
    "vorder": 33,
    "position": 0,
    "text": "نشاندندش آنگه بر اسپ سمند"
  },
  {
    "poem_id": 1403,
    "vorder": 34,
    "position": 1,
    "text": "به گرد اندرش چاکران نیز چند"
  },
  {
    "poem_id": 1403,
    "vorder": 35,
    "position": 0,
    "text": "چو شد کار یکسر همه ساخته"
  },
  {
    "poem_id": 1403,
    "vorder": 36,
    "position": 1,
    "text": "چنان چون ببایست پرداخته"
  },
  {
    "poem_id": 1403,
    "vorder": 37,
    "position": 0,
    "text": "هیون تکاور برانگیختند"
  },
  {
    "poem_id": 1403,
    "vorder": 38,
    "position": 1,
    "text": "به فرمان بران بر درم ریختند"
  },
  {
    "poem_id": 1403,
    "vorder": 39,
    "position": 0,
    "text": "پس آن صورت رستم گرزدار"
  },
  {
    "poem_id": 1403,
    "vorder": 40,
    "position": 1,
    "text": "ببردند نزدیک سام سوار"
  },
  {
    "poem_id": 1403,
    "vorder": 41,
    "position": 0,
    "text": "یکی جشن کردند در گلستان"
  },
  {
    "poem_id": 1403,
    "vorder": 42,
    "position": 1,
    "text": "ز زاولستان تا به کابلستان"
  },
  {
    "poem_id": 1403,
    "vorder": 43,
    "position": 0,
    "text": "همه دشت پر باده و نای بود"
  },
  {
    "poem_id": 1403,
    "vorder": 44,
    "position": 1,
    "text": "به هر کنج صد مجلس آرای بود"
  },
  {
    "poem_id": 1403,
    "vorder": 45,
    "position": 0,
    "text": "به زاولستان از کران تا کران"
  },
  {
    "poem_id": 1403,
    "vorder": 46,
    "position": 1,
    "text": "نشسته به هر جای رامشگران"
  },
  {
    "poem_id": 1403,
    "vorder": 47,
    "position": 0,
    "text": "نبد کهتر از مهتران بر فرود"
  },
  {
    "poem_id": 1403,
    "vorder": 48,
    "position": 1,
    "text": "نشسته چنان چون بود تار و پود"
  },
  {
    "poem_id": 1403,
    "vorder": 49,
    "position": 0,
    "text": "پس آن پیکر رستم شیرخوار"
  },
  {
    "poem_id": 1403,
    "vorder": 50,
    "position": 1,
    "text": "ببردند نزدیک سام سوار"
  },
  {
    "poem_id": 1403,
    "vorder": 51,
    "position": 0,
    "text": "ابر سام یل موی بر پای خاست"
  },
  {
    "poem_id": 1403,
    "vorder": 52,
    "position": 1,
    "text": "مرا ماند این پرنیان گفت راست"
  },
  {
    "poem_id": 1403,
    "vorder": 53,
    "position": 0,
    "text": "اگر نیم ازین پیکر آید تنش"
  },
  {
    "poem_id": 1403,
    "vorder": 54,
    "position": 1,
    "text": "سرش ابر ساید زمین دامنش"
  },
  {
    "poem_id": 1403,
    "vorder": 55,
    "position": 0,
    "text": "وزان پس فرستاده را پیش خواست"
  },
  {
    "poem_id": 1403,
    "vorder": 56,
    "position": 1,
    "text": "درم ریخت تا بر سرش گشت راست"
  },
  {
    "poem_id": 1403,
    "vorder": 57,
    "position": 0,
    "text": "به شادی برآمد ز درگاه کوس"
  },
  {
    "poem_id": 1403,
    "vorder": 58,
    "position": 1,
    "text": "بیاراست میدان چو چشم خروس"
  },
  {
    "poem_id": 1403,
    "vorder": 59,
    "position": 0,
    "text": "می‌آورد و رامشگران را بخواند"
  },
  {
    "poem_id": 1403,
    "vorder": 60,
    "position": 1,
    "text": "به خواهندگان بر درم برفشاند"
  },
  {
    "poem_id": 1403,
    "vorder": 61,
    "position": 0,
    "text": "بیاراست جشنی که خورشید و ماه"
  },
  {
    "poem_id": 1403,
    "vorder": 62,
    "position": 1,
    "text": "نظاره شدند اندران بزمگاه"
  },
  {
    "poem_id": 1403,
    "vorder": 63,
    "position": 0,
    "text": "پس آن نامهٔ زال پاسخ نوشت"
  },
  {
    "poem_id": 1403,
    "vorder": 64,
    "position": 1,
    "text": "بیاراست چون مرغزار بهشت"
  },
  {
    "poem_id": 1403,
    "vorder": 65,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1403,
    "vorder": 66,
    "position": 1,
    "text": "بران شادمان گردش روزگار"
  },
  {
    "poem_id": 1403,
    "vorder": 67,
    "position": 0,
    "text": "ستودن گرفت آنگهی زال را"
  },
  {
    "poem_id": 1403,
    "vorder": 68,
    "position": 1,
    "text": "خداوند شمشیر و کوپال را"
  },
  {
    "poem_id": 1403,
    "vorder": 69,
    "position": 0,
    "text": "پس آمد بدان پیکر پرنیان"
  },
  {
    "poem_id": 1403,
    "vorder": 70,
    "position": 1,
    "text": "که یال یلان داشت و فر کیان"
  },
  {
    "poem_id": 1403,
    "vorder": 71,
    "position": 0,
    "text": "بفرمود کین را چنین ارجمند"
  },
  {
    "poem_id": 1403,
    "vorder": 72,
    "position": 1,
    "text": "بدارید کز دم نیابد گزند"
  },
  {
    "poem_id": 1403,
    "vorder": 73,
    "position": 0,
    "text": "نیایش همی کردم اندر نهان"
  },
  {
    "poem_id": 1403,
    "vorder": 74,
    "position": 1,
    "text": "شب و روز با کردگار جهان"
  },
  {
    "poem_id": 1403,
    "vorder": 75,
    "position": 0,
    "text": "که زنده ببیند جهانبین من"
  },
  {
    "poem_id": 1403,
    "vorder": 76,
    "position": 1,
    "text": "ز تخم تو گردی به آیین من"
  },
  {
    "poem_id": 1403,
    "vorder": 77,
    "position": 0,
    "text": "کنون شد مرا و ترا پشت راست"
  },
  {
    "poem_id": 1403,
    "vorder": 78,
    "position": 1,
    "text": "نباید جز از زندگانیش خواست"
  },
  {
    "poem_id": 1403,
    "vorder": 79,
    "position": 0,
    "text": "فرستاده آمد چو باد دمان"
  },
  {
    "poem_id": 1403,
    "vorder": 80,
    "position": 1,
    "text": "بر زال روشن دل و شادمان"
  },
  {
    "poem_id": 1403,
    "vorder": 81,
    "position": 0,
    "text": "چو بشنید زال این سخنهای نغز"
  },
  {
    "poem_id": 1403,
    "vorder": 82,
    "position": 1,
    "text": "که روشن روان اندر آید به مغز"
  },
  {
    "poem_id": 1403,
    "vorder": 83,
    "position": 0,
    "text": "به شادیش بر شادمانی فزود"
  },
  {
    "poem_id": 1403,
    "vorder": 84,
    "position": 1,
    "text": "برافراخت گردن به چرخ کبود"
  },
  {
    "poem_id": 1403,
    "vorder": 85,
    "position": 0,
    "text": "همی گشت چندی بروبر جهان"
  },
  {
    "poem_id": 1403,
    "vorder": 86,
    "position": 1,
    "text": "برهنه شد آن روزگار نهان"
  },
  {
    "poem_id": 1403,
    "vorder": 87,
    "position": 0,
    "text": "به رستم همی داد ده دایه شیر"
  },
  {
    "poem_id": 1403,
    "vorder": 88,
    "position": 1,
    "text": "که نیروی مردست و سرمایه شیر"
  },
  {
    "poem_id": 1403,
    "vorder": 89,
    "position": 0,
    "text": "چو از شیر آمد سوی خوردنی"
  },
  {
    "poem_id": 1403,
    "vorder": 90,
    "position": 1,
    "text": "شد از نان و از گوشت افزودنی"
  },
  {
    "poem_id": 1403,
    "vorder": 91,
    "position": 0,
    "text": "بدی پنج مرده مراو را خورش"
  },
  {
    "poem_id": 1403,
    "vorder": 92,
    "position": 1,
    "text": "بماندند مردم ازان پرورش"
  },
  {
    "poem_id": 1403,
    "vorder": 93,
    "position": 0,
    "text": "چو رستم بپیمود بالای هشت"
  },
  {
    "poem_id": 1403,
    "vorder": 94,
    "position": 1,
    "text": "بسان یکی سرو آزاد گشت"
  },
  {
    "poem_id": 1403,
    "vorder": 95,
    "position": 0,
    "text": "چنان شد که رخشان ستاره شود"
  },
  {
    "poem_id": 1403,
    "vorder": 96,
    "position": 1,
    "text": "جهان بر ستاره نظاره شود"
  },
  {
    "poem_id": 1403,
    "vorder": 97,
    "position": 0,
    "text": "تو گفتی که سام یلستی به جای"
  },
  {
    "poem_id": 1403,
    "vorder": 98,
    "position": 1,
    "text": "به بالا و دیدار و فرهنگ و رای"
  }
]