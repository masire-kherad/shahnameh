[
  {
    "poem_id": 1362,
    "vorder": 1,
    "position": 0,
    "text": "نهفته چو بیرون کشید از نهان"
  },
  {
    "poem_id": 1362,
    "vorder": 2,
    "position": 1,
    "text": "به سه بخش کرد آفریدون جهان"
  },
  {
    "poem_id": 1362,
    "vorder": 3,
    "position": 0,
    "text": "یکی روم و خاور دگر ترک و چین"
  },
  {
    "poem_id": 1362,
    "vorder": 4,
    "position": 1,
    "text": "سیم دشت گردان و ایران‌زمین"
  },
  {
    "poem_id": 1362,
    "vorder": 5,
    "position": 0,
    "text": "نخستین به سلم اندرون بنگرید"
  },
  {
    "poem_id": 1362,
    "vorder": 6,
    "position": 1,
    "text": "همه روم و خاور مراو را سزید"
  },
  {
    "poem_id": 1362,
    "vorder": 7,
    "position": 0,
    "text": "بفرمود تا لشکری برگزید"
  },
  {
    "poem_id": 1362,
    "vorder": 8,
    "position": 1,
    "text": "گرازان سوی خاور اندرکشید"
  },
  {
    "poem_id": 1362,
    "vorder": 9,
    "position": 0,
    "text": "به تخت کیان اندر آورد پای"
  },
  {
    "poem_id": 1362,
    "vorder": 10,
    "position": 1,
    "text": "همی خواندندیش خاور خدای"
  },
  {
    "poem_id": 1362,
    "vorder": 11,
    "position": 0,
    "text": "دگر تور را داد توران زمین"
  },
  {
    "poem_id": 1362,
    "vorder": 12,
    "position": 1,
    "text": "ورا کرد سالار ترکان و چین"
  },
  {
    "poem_id": 1362,
    "vorder": 13,
    "position": 0,
    "text": "یکی لشکری نامزد کرد شاه"
  },
  {
    "poem_id": 1362,
    "vorder": 14,
    "position": 1,
    "text": "کشید آنگهی تور لشکر به راه"
  },
  {
    "poem_id": 1362,
    "vorder": 15,
    "position": 0,
    "text": "بیامد به تخت کئی برنشست"
  },
  {
    "poem_id": 1362,
    "vorder": 16,
    "position": 1,
    "text": "کمر بر میان بست و بگشاد دست"
  },
  {
    "poem_id": 1362,
    "vorder": 17,
    "position": 0,
    "text": "بزرگان برو گوهر افشاندند"
  },
  {
    "poem_id": 1362,
    "vorder": 18,
    "position": 1,
    "text": "همی پاک توران شهش خواندند"
  },
  {
    "poem_id": 1362,
    "vorder": 19,
    "position": 0,
    "text": "از ایشان چو نوبت به ایرج رسید"
  },
  {
    "poem_id": 1362,
    "vorder": 20,
    "position": 1,
    "text": "مر او را پدر شاه ایران گزید"
  },
  {
    "poem_id": 1362,
    "vorder": 21,
    "position": 0,
    "text": "هم ایران و هم دشت نیزه‌وران"
  },
  {
    "poem_id": 1362,
    "vorder": 22,
    "position": 1,
    "text": "هم آن تخت شاهی و تاج سران"
  },
  {
    "poem_id": 1362,
    "vorder": 23,
    "position": 0,
    "text": "بدو داد کورا سزا بود تاج"
  },
  {
    "poem_id": 1362,
    "vorder": 24,
    "position": 1,
    "text": "همان کرسی و مهر و آن تخت عاج"
  },
  {
    "poem_id": 1362,
    "vorder": 25,
    "position": 0,
    "text": "نشستند هر سه به آرام و شاد"
  },
  {
    "poem_id": 1362,
    "vorder": 26,
    "position": 1,
    "text": "چنان مرزبانان فرخ نژاد"
  }
]