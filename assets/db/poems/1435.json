[
  {
    "poem_id": 1435,
    "vorder": 1,
    "position": 0,
    "text": "یکی راه پیش آمدش ناگزیر"
  },
  {
    "poem_id": 1435,
    "vorder": 2,
    "position": 1,
    "text": "همی‌رفت بایست بر خیره خیر"
  },
  {
    "poem_id": 1435,
    "vorder": 3,
    "position": 0,
    "text": "پی اسپ و گویا زبان سوار"
  },
  {
    "poem_id": 1435,
    "vorder": 4,
    "position": 1,
    "text": "ز گرما و از تشنگی شد ز کار"
  },
  {
    "poem_id": 1435,
    "vorder": 5,
    "position": 0,
    "text": "پیاده شد از اسپ و ژوپین به دست"
  },
  {
    "poem_id": 1435,
    "vorder": 6,
    "position": 1,
    "text": "همی‌رفت پویان به کردار مست"
  },
  {
    "poem_id": 1435,
    "vorder": 7,
    "position": 0,
    "text": "همی‌جست بر چاره جستن رهی"
  },
  {
    "poem_id": 1435,
    "vorder": 8,
    "position": 1,
    "text": "سوی آسمان کرد روی آنگهی"
  },
  {
    "poem_id": 1435,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت کای داور دادگر"
  },
  {
    "poem_id": 1435,
    "vorder": 10,
    "position": 1,
    "text": "همه رنج و سختی تو آری به سر"
  },
  {
    "poem_id": 1435,
    "vorder": 11,
    "position": 0,
    "text": "گرایدونک خشنودی از رنج من"
  },
  {
    "poem_id": 1435,
    "vorder": 12,
    "position": 1,
    "text": "بدان گیتی آگنده کن گنج من"
  },
  {
    "poem_id": 1435,
    "vorder": 13,
    "position": 0,
    "text": "بپویم همی تا مگر کردگار"
  },
  {
    "poem_id": 1435,
    "vorder": 14,
    "position": 1,
    "text": "دهد شاه کاووس را زینهار"
  },
  {
    "poem_id": 1435,
    "vorder": 15,
    "position": 0,
    "text": "هم ایرانیان را ز چنگال دیو"
  },
  {
    "poem_id": 1435,
    "vorder": 16,
    "position": 1,
    "text": "گشاید بی‌آزار گیهان خدیو"
  },
  {
    "poem_id": 1435,
    "vorder": 17,
    "position": 0,
    "text": "گنه‌کار و افگندگان تواند"
  },
  {
    "poem_id": 1435,
    "vorder": 18,
    "position": 1,
    "text": "پرستنده و بندگان تواند"
  },
  {
    "poem_id": 1435,
    "vorder": 19,
    "position": 0,
    "text": "تن پیلوارش چنان تفته شد"
  },
  {
    "poem_id": 1435,
    "vorder": 20,
    "position": 1,
    "text": "که از تشنگی سست و آشفته شد"
  },
  {
    "poem_id": 1435,
    "vorder": 21,
    "position": 0,
    "text": "بیفتاد رستم بر آن گرم خاک"
  },
  {
    "poem_id": 1435,
    "vorder": 22,
    "position": 1,
    "text": "زبان گشته از تشنگی چاک چاک"
  },
  {
    "poem_id": 1435,
    "vorder": 23,
    "position": 0,
    "text": "همانگه یکی میش نیکوسرین"
  },
  {
    "poem_id": 1435,
    "vorder": 24,
    "position": 1,
    "text": "بپیمود پیش تهمتن زمین"
  },
  {
    "poem_id": 1435,
    "vorder": 25,
    "position": 0,
    "text": "ازان رفتن میش اندیشه خاست"
  },
  {
    "poem_id": 1435,
    "vorder": 26,
    "position": 1,
    "text": "به‌دل گفت که‌آبشخور این کجاست"
  },
  {
    "poem_id": 1435,
    "vorder": 27,
    "position": 0,
    "text": "همانا که بخشایش کردگار"
  },
  {
    "poem_id": 1435,
    "vorder": 28,
    "position": 1,
    "text": "فراز آمده‌ست اندرین روزگار"
  },
  {
    "poem_id": 1435,
    "vorder": 29,
    "position": 0,
    "text": "بیفشارد شمشیر بر دست راست"
  },
  {
    "poem_id": 1435,
    "vorder": 30,
    "position": 1,
    "text": "به زور جهان‌دار بر پای خاست"
  },
  {
    "poem_id": 1435,
    "vorder": 31,
    "position": 0,
    "text": "بشد بر پی میش و تیغش به چنگ"
  },
  {
    "poem_id": 1435,
    "vorder": 32,
    "position": 1,
    "text": "گرفته به دست دگر پالهنگ"
  },
  {
    "poem_id": 1435,
    "vorder": 33,
    "position": 0,
    "text": "به ره بر یکی چشمه آمد پدید"
  },
  {
    "poem_id": 1435,
    "vorder": 34,
    "position": 1,
    "text": "چو میش سراور بدانجا رسید"
  },
  {
    "poem_id": 1435,
    "vorder": 35,
    "position": 0,
    "text": "تهمتن سوی آسمان کرد روی"
  },
  {
    "poem_id": 1435,
    "vorder": 36,
    "position": 1,
    "text": "چنین گفت کای داور راستگوی"
  },
  {
    "poem_id": 1435,
    "vorder": 37,
    "position": 0,
    "text": "هرانکس که از دادگر یک خدای"
  },
  {
    "poem_id": 1435,
    "vorder": 38,
    "position": 1,
    "text": "بپیچد نیارد خرد را به جای"
  },
  {
    "poem_id": 1435,
    "vorder": 39,
    "position": 0,
    "text": "برین چشمه آبشخور میش نیست"
  },
  {
    "poem_id": 1435,
    "vorder": 40,
    "position": 1,
    "text": "همان غُرم دشتی مرا خویش نیست"
  },
  {
    "poem_id": 1435,
    "vorder": 41,
    "position": 0,
    "text": "به جایی که تنگ اندر آید سخن"
  },
  {
    "poem_id": 1435,
    "vorder": 42,
    "position": 1,
    "text": "پناهت به جز پاک یزدان مکن"
  },
  {
    "poem_id": 1435,
    "vorder": 43,
    "position": 0,
    "text": "بران غرم بر آفرین کرد چند"
  },
  {
    "poem_id": 1435,
    "vorder": 44,
    "position": 1,
    "text": "که از چرخ گردان مبادت گزند"
  },
  {
    "poem_id": 1435,
    "vorder": 45,
    "position": 0,
    "text": "گیا بر در و دشت تو سبز باد"
  },
  {
    "poem_id": 1435,
    "vorder": 46,
    "position": 1,
    "text": "مباد از تو هرگز دل یوز شاد"
  },
  {
    "poem_id": 1435,
    "vorder": 47,
    "position": 0,
    "text": "ترا هرک یازد به تیر و کمان"
  },
  {
    "poem_id": 1435,
    "vorder": 48,
    "position": 1,
    "text": "شکسته کمان باد و تیره گمان"
  },
  {
    "poem_id": 1435,
    "vorder": 49,
    "position": 0,
    "text": "که زنده شد از تو گو پیلتن"
  },
  {
    "poem_id": 1435,
    "vorder": 50,
    "position": 1,
    "text": "وگرنه پراندیشه بود از کفن"
  },
  {
    "poem_id": 1435,
    "vorder": 51,
    "position": 0,
    "text": "که در سینهٔ اژدهای بزرگ"
  },
  {
    "poem_id": 1435,
    "vorder": 52,
    "position": 1,
    "text": "نگنجد بماند به چنگال گرگ"
  },
  {
    "poem_id": 1435,
    "vorder": 53,
    "position": 0,
    "text": "شده پاره پاره کنان و کشان"
  },
  {
    "poem_id": 1435,
    "vorder": 54,
    "position": 1,
    "text": "ز رستم به دشمن رسیده نشان"
  },
  {
    "poem_id": 1435,
    "vorder": 55,
    "position": 0,
    "text": "روانش چو پردخته شد ز آفرین"
  },
  {
    "poem_id": 1435,
    "vorder": 56,
    "position": 1,
    "text": "ز رخش تگاور جدا کرد زین"
  },
  {
    "poem_id": 1435,
    "vorder": 57,
    "position": 0,
    "text": "همه تن بشستش بران آب پاک"
  },
  {
    "poem_id": 1435,
    "vorder": 58,
    "position": 1,
    "text": "به کردار خورشید شد تابناک"
  },
  {
    "poem_id": 1435,
    "vorder": 59,
    "position": 0,
    "text": "چو سیراب شد ساز نخچیر کرد"
  },
  {
    "poem_id": 1435,
    "vorder": 60,
    "position": 1,
    "text": "کمر بست و ترکش پر از تیر کرد"
  },
  {
    "poem_id": 1435,
    "vorder": 61,
    "position": 0,
    "text": "بیفگند گوری چو پیل ژیان"
  },
  {
    "poem_id": 1435,
    "vorder": 62,
    "position": 1,
    "text": "جدا کرد ازو چرم پای و میان"
  },
  {
    "poem_id": 1435,
    "vorder": 63,
    "position": 0,
    "text": "چو خورشید تیز آتشی برفروخت"
  },
  {
    "poem_id": 1435,
    "vorder": 64,
    "position": 1,
    "text": "برآورد ز آب اندر آتش بسوخت"
  },
  {
    "poem_id": 1435,
    "vorder": 65,
    "position": 0,
    "text": "بپردخت ز آتش به خوردن گرفت"
  },
  {
    "poem_id": 1435,
    "vorder": 66,
    "position": 1,
    "text": "به خاک استخوانش سپردن گرفت"
  },
  {
    "poem_id": 1435,
    "vorder": 67,
    "position": 0,
    "text": "سوی چشمهٔ روشن آمد بر آب"
  },
  {
    "poem_id": 1435,
    "vorder": 68,
    "position": 1,
    "text": "چو سیراب شد کرد آهنگ خواب"
  },
  {
    "poem_id": 1435,
    "vorder": 69,
    "position": 0,
    "text": "تهمتن به رخش سراینده گفت"
  },
  {
    "poem_id": 1435,
    "vorder": 70,
    "position": 1,
    "text": "که با کس مکوش و مشو نیز جفت"
  },
  {
    "poem_id": 1435,
    "vorder": 71,
    "position": 0,
    "text": "اگر دشمن آید‌، سوی من بپوی"
  },
  {
    "poem_id": 1435,
    "vorder": 72,
    "position": 1,
    "text": "تو با دیو و شیران مشو جنگجوی"
  },
  {
    "poem_id": 1435,
    "vorder": 73,
    "position": 0,
    "text": "بخفت و بر آسود و نگشاد لب"
  },
  {
    "poem_id": 1435,
    "vorder": 74,
    "position": 1,
    "text": "چمان و چران رخش تا نیم‌شب"
  }
]