[
  {
    "poem_id": 1666,
    "vorder": 1,
    "position": 0,
    "text": "همی چاره جست آن شب دیریاز"
  },
  {
    "poem_id": 1666,
    "vorder": 2,
    "position": 1,
    "text": "چو خورشید بنمود چینی طراز"
  },
  {
    "poem_id": 1666,
    "vorder": 3,
    "position": 0,
    "text": "برافراخت از کوه زرین درفش"
  },
  {
    "poem_id": 1666,
    "vorder": 4,
    "position": 1,
    "text": "نگونسار شد پرنیانی بنفش"
  },
  {
    "poem_id": 1666,
    "vorder": 5,
    "position": 0,
    "text": "سکندر بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1666,
    "vorder": 6,
    "position": 1,
    "text": "پرستنده برخاست از بارگاه"
  },
  {
    "poem_id": 1666,
    "vorder": 7,
    "position": 0,
    "text": "به رسمی که بودش فرود آورید"
  },
  {
    "poem_id": 1666,
    "vorder": 8,
    "position": 1,
    "text": "جهانجوی پیش سپهبد چمید"
  },
  {
    "poem_id": 1666,
    "vorder": 9,
    "position": 0,
    "text": "ز بیگانه ایوان بپرداختند"
  },
  {
    "poem_id": 1666,
    "vorder": 10,
    "position": 1,
    "text": "فرستاده را پیش او تاختند"
  },
  {
    "poem_id": 1666,
    "vorder": 11,
    "position": 0,
    "text": "چو قیدافه را دید بر تخت گفت"
  },
  {
    "poem_id": 1666,
    "vorder": 12,
    "position": 1,
    "text": "که با رای تو مشتری باد جفت"
  },
  {
    "poem_id": 1666,
    "vorder": 13,
    "position": 0,
    "text": "بدین مسیحا به فرمان راست"
  },
  {
    "poem_id": 1666,
    "vorder": 14,
    "position": 1,
    "text": "بد ارنده کو بر زبانم گواست"
  },
  {
    "poem_id": 1666,
    "vorder": 15,
    "position": 0,
    "text": "با برای و دین و صلیب بزرگ"
  },
  {
    "poem_id": 1666,
    "vorder": 16,
    "position": 1,
    "text": "به جان و سر شهریار سترگ"
  },
  {
    "poem_id": 1666,
    "vorder": 17,
    "position": 0,
    "text": "به زنار و شماس و روح‌القدس"
  },
  {
    "poem_id": 1666,
    "vorder": 18,
    "position": 1,
    "text": "کزین پس مرا خاک در اندلس"
  },
  {
    "poem_id": 1666,
    "vorder": 19,
    "position": 0,
    "text": "نبیند نه لشکر فرستم به جنگ"
  },
  {
    "poem_id": 1666,
    "vorder": 20,
    "position": 1,
    "text": "نیامیزم از هر دری نیز رنگ"
  },
  {
    "poem_id": 1666,
    "vorder": 21,
    "position": 0,
    "text": "نه با پاک فرزند تو بد کنم"
  },
  {
    "poem_id": 1666,
    "vorder": 22,
    "position": 1,
    "text": "نه فرمان دهم نیز و نه خود کنم"
  },
  {
    "poem_id": 1666,
    "vorder": 23,
    "position": 0,
    "text": "به جان یاد دارم وفای ترا"
  },
  {
    "poem_id": 1666,
    "vorder": 24,
    "position": 1,
    "text": "نجویم به چیزی جفای ترا"
  },
  {
    "poem_id": 1666,
    "vorder": 25,
    "position": 0,
    "text": "برادر بود نیک‌خواهت مرا"
  },
  {
    "poem_id": 1666,
    "vorder": 26,
    "position": 1,
    "text": "به جای صلیب است گاهت مرا"
  },
  {
    "poem_id": 1666,
    "vorder": 27,
    "position": 0,
    "text": "نگه کرد قیدافه سوگند اوی"
  },
  {
    "poem_id": 1666,
    "vorder": 28,
    "position": 1,
    "text": "یگانه دل و راست پیوند اوی"
  },
  {
    "poem_id": 1666,
    "vorder": 29,
    "position": 0,
    "text": "همه کاخ کرسی زرین نهاد"
  },
  {
    "poem_id": 1666,
    "vorder": 30,
    "position": 1,
    "text": "به پیش اندر آرایش چین نهاد"
  },
  {
    "poem_id": 1666,
    "vorder": 31,
    "position": 0,
    "text": "بزرگان و نیک‌اختران را بخواند"
  },
  {
    "poem_id": 1666,
    "vorder": 32,
    "position": 1,
    "text": "یکایک بر آن کرسی زر نشاند"
  },
  {
    "poem_id": 1666,
    "vorder": 33,
    "position": 0,
    "text": "ازان پس گرامی دو فرزند را"
  },
  {
    "poem_id": 1666,
    "vorder": 34,
    "position": 1,
    "text": "بیاورد خویشان و پیوند را"
  },
  {
    "poem_id": 1666,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت کاندر سرای سپنج"
  },
  {
    "poem_id": 1666,
    "vorder": 36,
    "position": 1,
    "text": "سزد گر نباشیم چندین به رنج"
  },
  {
    "poem_id": 1666,
    "vorder": 37,
    "position": 0,
    "text": "نباید کزین گردش روزگار"
  },
  {
    "poem_id": 1666,
    "vorder": 38,
    "position": 1,
    "text": "مرا بهره کین آید و کارزار"
  },
  {
    "poem_id": 1666,
    "vorder": 39,
    "position": 0,
    "text": "سکندر نخواهد شد از گنج سیر"
  },
  {
    "poem_id": 1666,
    "vorder": 40,
    "position": 1,
    "text": "وگر آسمان اندر آرد به زیر"
  },
  {
    "poem_id": 1666,
    "vorder": 41,
    "position": 0,
    "text": "همی رنج ما جوید از بهر گنج"
  },
  {
    "poem_id": 1666,
    "vorder": 42,
    "position": 1,
    "text": "همه گنج گیتی نیرزد به رنج"
  },
  {
    "poem_id": 1666,
    "vorder": 43,
    "position": 0,
    "text": "برآنم که با او نسازیم جنگ"
  },
  {
    "poem_id": 1666,
    "vorder": 44,
    "position": 1,
    "text": "نه بر پادشاهی کنم کار تنگ"
  },
  {
    "poem_id": 1666,
    "vorder": 45,
    "position": 0,
    "text": "یکی پاسخ پندمندش دهیم"
  },
  {
    "poem_id": 1666,
    "vorder": 46,
    "position": 1,
    "text": "سرش برفرازیم و پندش دهیم"
  },
  {
    "poem_id": 1666,
    "vorder": 47,
    "position": 0,
    "text": "اگر جنگ جوید پس از پند من"
  },
  {
    "poem_id": 1666,
    "vorder": 48,
    "position": 1,
    "text": "به بیند پس از پند من بند من"
  },
  {
    "poem_id": 1666,
    "vorder": 49,
    "position": 0,
    "text": "ازان سان شوم پیش او با سپاه"
  },
  {
    "poem_id": 1666,
    "vorder": 50,
    "position": 1,
    "text": "که بخشایش آرد برو چرخ و ماه"
  },
  {
    "poem_id": 1666,
    "vorder": 51,
    "position": 0,
    "text": "ازین ازمایش ندارد زیان"
  },
  {
    "poem_id": 1666,
    "vorder": 52,
    "position": 1,
    "text": "بماند مگر دوستی در میان"
  },
  {
    "poem_id": 1666,
    "vorder": 53,
    "position": 0,
    "text": "چه گویید و این را چه پاسخ دهید"
  },
  {
    "poem_id": 1666,
    "vorder": 54,
    "position": 1,
    "text": "مرا اندرین رای فرخ نهید"
  },
  {
    "poem_id": 1666,
    "vorder": 55,
    "position": 0,
    "text": "همه مهتران سر برافراختند"
  },
  {
    "poem_id": 1666,
    "vorder": 56,
    "position": 1,
    "text": "همی پاسخ پادشا ساختند"
  },
  {
    "poem_id": 1666,
    "vorder": 57,
    "position": 0,
    "text": "بگفتند کای سرور داد و راد"
  },
  {
    "poem_id": 1666,
    "vorder": 58,
    "position": 1,
    "text": "ندارد کسی چون تو مهتر به یاد"
  },
  {
    "poem_id": 1666,
    "vorder": 59,
    "position": 0,
    "text": "نگویی مگر آنک بهتر بود"
  },
  {
    "poem_id": 1666,
    "vorder": 60,
    "position": 1,
    "text": "خنک شهرکش چون تو مهتر بود"
  },
  {
    "poem_id": 1666,
    "vorder": 61,
    "position": 0,
    "text": "اگر دوست گردد ترا پادشا"
  },
  {
    "poem_id": 1666,
    "vorder": 62,
    "position": 1,
    "text": "چه خواهد جزین مردم پارسا"
  },
  {
    "poem_id": 1666,
    "vorder": 63,
    "position": 0,
    "text": "نه آسیب آید بدین گنج تو"
  },
  {
    "poem_id": 1666,
    "vorder": 64,
    "position": 1,
    "text": "نیرزد همه گنجها رنج تو"
  },
  {
    "poem_id": 1666,
    "vorder": 65,
    "position": 0,
    "text": "چو اسکندری کو بیاید ز روم"
  },
  {
    "poem_id": 1666,
    "vorder": 66,
    "position": 1,
    "text": "به شمشیر دریا کند روی بوم"
  },
  {
    "poem_id": 1666,
    "vorder": 67,
    "position": 0,
    "text": "همی از درت بازگردد به چیز"
  },
  {
    "poem_id": 1666,
    "vorder": 68,
    "position": 1,
    "text": "همه چیز دنیی نیرزد پشیز"
  },
  {
    "poem_id": 1666,
    "vorder": 69,
    "position": 0,
    "text": "جز از آشتی ما نبینیم روی"
  },
  {
    "poem_id": 1666,
    "vorder": 70,
    "position": 1,
    "text": "نه والا بود مردم کینه‌جوی"
  },
  {
    "poem_id": 1666,
    "vorder": 71,
    "position": 0,
    "text": "چو بشنید گفتار آن بخردان"
  },
  {
    "poem_id": 1666,
    "vorder": 72,
    "position": 1,
    "text": "پسندیده و پاک‌دل موبدان"
  },
  {
    "poem_id": 1666,
    "vorder": 73,
    "position": 0,
    "text": "در گنج بگشاد و تاج پدر"
  },
  {
    "poem_id": 1666,
    "vorder": 74,
    "position": 1,
    "text": "بیاورد با یاره و طوق زر"
  },
  {
    "poem_id": 1666,
    "vorder": 75,
    "position": 0,
    "text": "یکی تاج بد کاندران شهر و مرز"
  },
  {
    "poem_id": 1666,
    "vorder": 76,
    "position": 1,
    "text": "کسی گوهرش را ندانست ارز"
  },
  {
    "poem_id": 1666,
    "vorder": 77,
    "position": 0,
    "text": "فرستاده را گفت کین بی‌بهاست"
  },
  {
    "poem_id": 1666,
    "vorder": 78,
    "position": 1,
    "text": "هرانکس که دارد جزو نارواست"
  },
  {
    "poem_id": 1666,
    "vorder": 79,
    "position": 0,
    "text": "به تاج مهان چون سزا دیدمش"
  },
  {
    "poem_id": 1666,
    "vorder": 80,
    "position": 1,
    "text": "ز فرزند پرمایه بگزیدمش"
  },
  {
    "poem_id": 1666,
    "vorder": 81,
    "position": 0,
    "text": "یکی تخت بودش به هفتاد لخت"
  },
  {
    "poem_id": 1666,
    "vorder": 82,
    "position": 1,
    "text": "ببستی گشایندهٔ نیک‌بخت"
  },
  {
    "poem_id": 1666,
    "vorder": 83,
    "position": 0,
    "text": "به پیکر یک اندر دگر بافته"
  },
  {
    "poem_id": 1666,
    "vorder": 84,
    "position": 1,
    "text": "به چاره سر شوشها تافته"
  },
  {
    "poem_id": 1666,
    "vorder": 85,
    "position": 0,
    "text": "سر پایها چون سر اژدها"
  },
  {
    "poem_id": 1666,
    "vorder": 86,
    "position": 1,
    "text": "ندانست کس گوهرش را بها"
  },
  {
    "poem_id": 1666,
    "vorder": 87,
    "position": 0,
    "text": "ازو چارصد گوهر شاهوار"
  },
  {
    "poem_id": 1666,
    "vorder": 88,
    "position": 1,
    "text": "همان سرخ یاقوت بد زین شمار"
  },
  {
    "poem_id": 1666,
    "vorder": 89,
    "position": 0,
    "text": "دو بودی به مثقال هر یک به سنگ"
  },
  {
    "poem_id": 1666,
    "vorder": 90,
    "position": 1,
    "text": "چو یک دانهٔ نار بودی به رنگ"
  },
  {
    "poem_id": 1666,
    "vorder": 91,
    "position": 0,
    "text": "زمرد برو چار صد پاره بود"
  },
  {
    "poem_id": 1666,
    "vorder": 92,
    "position": 1,
    "text": "به سبزی چو قوس قزح نابسود"
  },
  {
    "poem_id": 1666,
    "vorder": 93,
    "position": 0,
    "text": "گشاده شتر بار بودی چهل"
  },
  {
    "poem_id": 1666,
    "vorder": 94,
    "position": 1,
    "text": "زنی بود چون موج دریا به دل"
  },
  {
    "poem_id": 1666,
    "vorder": 95,
    "position": 0,
    "text": "دگر چار صد تای دندان پیل"
  },
  {
    "poem_id": 1666,
    "vorder": 96,
    "position": 1,
    "text": "چه دندان درازیش بد میل میل"
  },
  {
    "poem_id": 1666,
    "vorder": 97,
    "position": 0,
    "text": "پلنگی که خوانی همی بربری"
  },
  {
    "poem_id": 1666,
    "vorder": 98,
    "position": 1,
    "text": "ازان چار صد پوست بد بر سری"
  },
  {
    "poem_id": 1666,
    "vorder": 99,
    "position": 0,
    "text": "ز چرم گوزن ملمع هزار"
  },
  {
    "poem_id": 1666,
    "vorder": 100,
    "position": 1,
    "text": "همه رنگ و بیرنگ او پر نگار"
  },
  {
    "poem_id": 1666,
    "vorder": 101,
    "position": 0,
    "text": "دگر صد سگ و یوز نخچیر گیر"
  },
  {
    "poem_id": 1666,
    "vorder": 102,
    "position": 1,
    "text": "که آهو ورا پیش دیدی ز تیر"
  },
  {
    "poem_id": 1666,
    "vorder": 103,
    "position": 0,
    "text": "بیاورد زان پس دوصد گاومیش"
  },
  {
    "poem_id": 1666,
    "vorder": 104,
    "position": 1,
    "text": "پرستندهٔ او همی راند پیش"
  },
  {
    "poem_id": 1666,
    "vorder": 105,
    "position": 0,
    "text": "ز دیبای خز چارصد تخته نیز"
  },
  {
    "poem_id": 1666,
    "vorder": 106,
    "position": 1,
    "text": "همان تختها کرده از چوب شیز"
  },
  {
    "poem_id": 1666,
    "vorder": 107,
    "position": 0,
    "text": "دگر چار صد تخته از عود تر"
  },
  {
    "poem_id": 1666,
    "vorder": 108,
    "position": 1,
    "text": "که مهر اندرو گیرد و رنگ زر"
  },
  {
    "poem_id": 1666,
    "vorder": 109,
    "position": 0,
    "text": "صد اسپ گرانمایه آراسته"
  },
  {
    "poem_id": 1666,
    "vorder": 110,
    "position": 1,
    "text": "ز میدان ببردند با خواسته"
  },
  {
    "poem_id": 1666,
    "vorder": 111,
    "position": 0,
    "text": "همان تیغ هندی و رومی هزار"
  },
  {
    "poem_id": 1666,
    "vorder": 112,
    "position": 1,
    "text": "بفرمود با جوشن کارزار"
  },
  {
    "poem_id": 1666,
    "vorder": 113,
    "position": 0,
    "text": "همان خود و مغفر هزار و دویست"
  },
  {
    "poem_id": 1666,
    "vorder": 114,
    "position": 1,
    "text": "به گنجور فرمود کاکنون مه‌ایست"
  },
  {
    "poem_id": 1666,
    "vorder": 115,
    "position": 0,
    "text": "همه پاک بر بیطقون برشمار"
  },
  {
    "poem_id": 1666,
    "vorder": 116,
    "position": 1,
    "text": "بگویش که شبگیر برساز کار"
  },
  {
    "poem_id": 1666,
    "vorder": 117,
    "position": 0,
    "text": "سپیده چو برزد ز بالا درفش"
  },
  {
    "poem_id": 1666,
    "vorder": 118,
    "position": 1,
    "text": "چو کافور شد روی چرخ بنفش"
  },
  {
    "poem_id": 1666,
    "vorder": 119,
    "position": 0,
    "text": "زمین تازه شد کوه چون سندروس"
  },
  {
    "poem_id": 1666,
    "vorder": 120,
    "position": 1,
    "text": "ز درگاه برخاست آوای کوس"
  },
  {
    "poem_id": 1666,
    "vorder": 121,
    "position": 0,
    "text": "سکندر به اسپ اندر آورد پای"
  },
  {
    "poem_id": 1666,
    "vorder": 122,
    "position": 1,
    "text": "به دستوری بازگشتن به جای"
  },
  {
    "poem_id": 1666,
    "vorder": 123,
    "position": 0,
    "text": "چو طینوش جنگی سپه برنشاند"
  },
  {
    "poem_id": 1666,
    "vorder": 124,
    "position": 1,
    "text": "از ایوان به درگاه قیدافه راند"
  },
  {
    "poem_id": 1666,
    "vorder": 125,
    "position": 0,
    "text": "به قیدافه گفتند پدرود باش"
  },
  {
    "poem_id": 1666,
    "vorder": 126,
    "position": 1,
    "text": "به جان تازهٔ چرخ را پود باش"
  },
  {
    "poem_id": 1666,
    "vorder": 127,
    "position": 0,
    "text": "برین گونه منزل به منزل سپاه"
  },
  {
    "poem_id": 1666,
    "vorder": 128,
    "position": 1,
    "text": "همی راند تا پیش آن رزمگاه"
  },
  {
    "poem_id": 1666,
    "vorder": 129,
    "position": 0,
    "text": "که لشکرگه نامور شاه بود"
  },
  {
    "poem_id": 1666,
    "vorder": 130,
    "position": 1,
    "text": "سکندر که با بخت همراه بود"
  },
  {
    "poem_id": 1666,
    "vorder": 131,
    "position": 0,
    "text": "سکندر بران بیشه بنهاد رخت"
  },
  {
    "poem_id": 1666,
    "vorder": 132,
    "position": 1,
    "text": "که آب روان بود و جای درخت"
  },
  {
    "poem_id": 1666,
    "vorder": 133,
    "position": 0,
    "text": "به طینوش گفت ایدر آرام گیر"
  },
  {
    "poem_id": 1666,
    "vorder": 134,
    "position": 1,
    "text": "چو آسوده گردی می و جام گیر"
  },
  {
    "poem_id": 1666,
    "vorder": 135,
    "position": 0,
    "text": "شوم هرچ گفتم به جای آورم"
  },
  {
    "poem_id": 1666,
    "vorder": 136,
    "position": 1,
    "text": "ز هر گونه پاکیزه رای آورم"
  },
  {
    "poem_id": 1666,
    "vorder": 137,
    "position": 0,
    "text": "سکندر بیامد به پرده سرای"
  },
  {
    "poem_id": 1666,
    "vorder": 138,
    "position": 1,
    "text": "سپاهش برفتند یک سر ز جای"
  },
  {
    "poem_id": 1666,
    "vorder": 139,
    "position": 0,
    "text": "ز شادی خروشیدن آراستند"
  },
  {
    "poem_id": 1666,
    "vorder": 140,
    "position": 1,
    "text": "کلاه کیانی بپیراستند"
  },
  {
    "poem_id": 1666,
    "vorder": 141,
    "position": 0,
    "text": "که نومید بد لشکر نامجوی"
  },
  {
    "poem_id": 1666,
    "vorder": 142,
    "position": 1,
    "text": "که دانست کش باز بینند روی"
  },
  {
    "poem_id": 1666,
    "vorder": 143,
    "position": 0,
    "text": "سپه با زبانها پر از آفرین"
  },
  {
    "poem_id": 1666,
    "vorder": 144,
    "position": 1,
    "text": "یکایک نهادند سر بر زمین"
  },
  {
    "poem_id": 1666,
    "vorder": 145,
    "position": 0,
    "text": "ز لشکر گزین کرد پس شهریار"
  },
  {
    "poem_id": 1666,
    "vorder": 146,
    "position": 1,
    "text": "ازان نامداران رومی هزار"
  },
  {
    "poem_id": 1666,
    "vorder": 147,
    "position": 0,
    "text": "زره‌دار با گُرزهٔ گاوروی"
  },
  {
    "poem_id": 1666,
    "vorder": 148,
    "position": 1,
    "text": "برفتند گردان پرخاشجوی"
  },
  {
    "poem_id": 1666,
    "vorder": 149,
    "position": 0,
    "text": "همه گرد بر گرد آن بیشه مرد"
  },
  {
    "poem_id": 1666,
    "vorder": 150,
    "position": 1,
    "text": "کشیدند صف با سلیح نبرد"
  },
  {
    "poem_id": 1666,
    "vorder": 151,
    "position": 0,
    "text": "سکندر خروشید کای مرد تیز"
  },
  {
    "poem_id": 1666,
    "vorder": 152,
    "position": 1,
    "text": "همی جنگ رای آیدت گر گریز"
  },
  {
    "poem_id": 1666,
    "vorder": 153,
    "position": 0,
    "text": "بلرزید طینوش بر جای خویش"
  },
  {
    "poem_id": 1666,
    "vorder": 154,
    "position": 1,
    "text": "پشیمان شد از دانش و رای خویش"
  },
  {
    "poem_id": 1666,
    "vorder": 155,
    "position": 0,
    "text": "بدو گفت کای شاه برترمنش"
  },
  {
    "poem_id": 1666,
    "vorder": 156,
    "position": 1,
    "text": "ستایش گزینی به از سرزنش"
  },
  {
    "poem_id": 1666,
    "vorder": 157,
    "position": 0,
    "text": "چنان هم که با خویش من قیدروش"
  },
  {
    "poem_id": 1666,
    "vorder": 158,
    "position": 1,
    "text": "بزرگی کن و راستی را بکوش"
  },
  {
    "poem_id": 1666,
    "vorder": 159,
    "position": 0,
    "text": "نه این بود پیمانت با مادرم"
  },
  {
    "poem_id": 1666,
    "vorder": 160,
    "position": 1,
    "text": "نگفتی که از راستی نگذرم؟"
  },
  {
    "poem_id": 1666,
    "vorder": 161,
    "position": 0,
    "text": "سکندر بدو گفت کای شهریار"
  },
  {
    "poem_id": 1666,
    "vorder": 162,
    "position": 1,
    "text": "چرا سست گشتی بدین مایه کار"
  },
  {
    "poem_id": 1666,
    "vorder": 163,
    "position": 0,
    "text": "ز من ایمنی بیم در دل مدار"
  },
  {
    "poem_id": 1666,
    "vorder": 164,
    "position": 1,
    "text": "نیازارد از من کسی زان تبار"
  },
  {
    "poem_id": 1666,
    "vorder": 165,
    "position": 0,
    "text": "نگردم ز پیمان قیدافه من"
  },
  {
    "poem_id": 1666,
    "vorder": 166,
    "position": 1,
    "text": "نه نیکو بود شاه پیمان‌شکن"
  },
  {
    "poem_id": 1666,
    "vorder": 167,
    "position": 0,
    "text": "پیاده شد از باره طینوش زود"
  },
  {
    "poem_id": 1666,
    "vorder": 168,
    "position": 1,
    "text": "زمین را ببوسید و زاری نمود"
  },
  {
    "poem_id": 1666,
    "vorder": 169,
    "position": 0,
    "text": "جهاندار بگرفت دستش به دست"
  },
  {
    "poem_id": 1666,
    "vorder": 170,
    "position": 1,
    "text": "بدان گونه کو گفت پیمان ببست"
  },
  {
    "poem_id": 1666,
    "vorder": 171,
    "position": 0,
    "text": "بدو گفت مندیش و رامش گزین"
  },
  {
    "poem_id": 1666,
    "vorder": 172,
    "position": 1,
    "text": "من از تو ندارم به دل هیچ کین"
  },
  {
    "poem_id": 1666,
    "vorder": 173,
    "position": 0,
    "text": "چو مادرت بر تخت زرین نشست"
  },
  {
    "poem_id": 1666,
    "vorder": 174,
    "position": 1,
    "text": "من اندر نهادم به دست تو دست"
  },
  {
    "poem_id": 1666,
    "vorder": 175,
    "position": 0,
    "text": "بگفتم که من دست شاه زمین"
  },
  {
    "poem_id": 1666,
    "vorder": 176,
    "position": 1,
    "text": "به دست تو اندر نهم هم‌چنین"
  },
  {
    "poem_id": 1666,
    "vorder": 177,
    "position": 0,
    "text": "همان روز پیمان من شد تمام"
  },
  {
    "poem_id": 1666,
    "vorder": 178,
    "position": 1,
    "text": "نه خوب آید از شاه گفتار خام"
  },
  {
    "poem_id": 1666,
    "vorder": 179,
    "position": 0,
    "text": "سکندر منم وان زمان من بدم"
  },
  {
    "poem_id": 1666,
    "vorder": 180,
    "position": 1,
    "text": "به خوبی بسی داستانها زدم"
  },
  {
    "poem_id": 1666,
    "vorder": 181,
    "position": 0,
    "text": "همان روز قیدافه آگاه بود"
  },
  {
    "poem_id": 1666,
    "vorder": 182,
    "position": 1,
    "text": "که اندر کفت پنجهٔ شاه بود"
  },
  {
    "poem_id": 1666,
    "vorder": 183,
    "position": 0,
    "text": "پرستنده را گفت قیصر که تخت"
  },
  {
    "poem_id": 1666,
    "vorder": 184,
    "position": 1,
    "text": "بیارای زیر گلفشان درخت"
  },
  {
    "poem_id": 1666,
    "vorder": 185,
    "position": 0,
    "text": "بفرمود تا خوان بیاراستند"
  },
  {
    "poem_id": 1666,
    "vorder": 186,
    "position": 1,
    "text": "نوازندهٔ رود و می خواستند"
  },
  {
    "poem_id": 1666,
    "vorder": 187,
    "position": 0,
    "text": "بفرمود تا خلعت خسروی"
  },
  {
    "poem_id": 1666,
    "vorder": 188,
    "position": 1,
    "text": "ز رومی و چینی و از پهلوی"
  },
  {
    "poem_id": 1666,
    "vorder": 189,
    "position": 0,
    "text": "ببخشید یارانش را سیم و زر"
  },
  {
    "poem_id": 1666,
    "vorder": 190,
    "position": 1,
    "text": "کرا در خور آمد کلاه و کمر"
  },
  {
    "poem_id": 1666,
    "vorder": 191,
    "position": 0,
    "text": "به طینوش فرمود کایدر مه‌ایست"
  },
  {
    "poem_id": 1666,
    "vorder": 192,
    "position": 1,
    "text": "که این بیشه دورست راه تو نیست"
  },
  {
    "poem_id": 1666,
    "vorder": 193,
    "position": 0,
    "text": "به قیدافه گوی ای هشیوار زن"
  },
  {
    "poem_id": 1666,
    "vorder": 194,
    "position": 1,
    "text": "جهاندار و بینادل و رای‌زن"
  },
  {
    "poem_id": 1666,
    "vorder": 195,
    "position": 0,
    "text": "بدارم وفای تو تا زنده‌ام"
  },
  {
    "poem_id": 1666,
    "vorder": 196,
    "position": 1,
    "text": "روان را به مهر تو آگنده‌ام"
  }
]