[
  {
    "poem_id": 1528,
    "vorder": 1,
    "position": 0,
    "text": "چو گشتاسپ را داد لهراسپ تخت"
  },
  {
    "poem_id": 1528,
    "vorder": 2,
    "position": 1,
    "text": "فرود آمد از تخت و بربست رخت"
  },
  {
    "poem_id": 1528,
    "vorder": 3,
    "position": 0,
    "text": "به بلخ گزین شد بران نوبهار"
  },
  {
    "poem_id": 1528,
    "vorder": 4,
    "position": 1,
    "text": "که یزدان پرستان بدان روزگار"
  },
  {
    "poem_id": 1528,
    "vorder": 5,
    "position": 0,
    "text": "مران جای را داشتندی چنان"
  },
  {
    "poem_id": 1528,
    "vorder": 6,
    "position": 1,
    "text": "که مر مکه را تازیان این زمان"
  },
  {
    "poem_id": 1528,
    "vorder": 7,
    "position": 0,
    "text": "بدان خانه شد شاه یزدان پرست"
  },
  {
    "poem_id": 1528,
    "vorder": 8,
    "position": 1,
    "text": "فرود آمد از جایگاه نشست"
  },
  {
    "poem_id": 1528,
    "vorder": 9,
    "position": 0,
    "text": "ببست آن در آفرین خانه را"
  },
  {
    "poem_id": 1528,
    "vorder": 10,
    "position": 1,
    "text": "نماند اندرو خویش و بیگانه را"
  },
  {
    "poem_id": 1528,
    "vorder": 11,
    "position": 0,
    "text": "بپوشید جامهٔ پرستش پلاس"
  },
  {
    "poem_id": 1528,
    "vorder": 12,
    "position": 1,
    "text": "خرد را چنان کرد باید سپاس"
  },
  {
    "poem_id": 1528,
    "vorder": 13,
    "position": 0,
    "text": "بیفگند یاره فرو هشت موی"
  },
  {
    "poem_id": 1528,
    "vorder": 14,
    "position": 1,
    "text": "سوی روشن دادگر کرد روی"
  },
  {
    "poem_id": 1528,
    "vorder": 15,
    "position": 0,
    "text": "همی بود سی سال پیشش به پای "
  },
  {
    "poem_id": 1528,
    "vorder": 16,
    "position": 1,
    "text": "برینسان پرستید باید خدای"
  },
  {
    "poem_id": 1528,
    "vorder": 17,
    "position": 0,
    "text": "نیایش همی کرد خورشید را"
  },
  {
    "poem_id": 1528,
    "vorder": 18,
    "position": 1,
    "text": "چنان بوده بد راه جمشید را"
  },
  {
    "poem_id": 1528,
    "vorder": 19,
    "position": 0,
    "text": "چو گشتاسپ بر شد به تخت پدر"
  },
  {
    "poem_id": 1528,
    "vorder": 20,
    "position": 1,
    "text": "که هم فر او داشت و بخت پدر"
  },
  {
    "poem_id": 1528,
    "vorder": 21,
    "position": 0,
    "text": "به سر بر نهاد آن پدر داده تاج"
  },
  {
    "poem_id": 1528,
    "vorder": 22,
    "position": 1,
    "text": "که زیبنده باشد بر آزاده تاج"
  },
  {
    "poem_id": 1528,
    "vorder": 23,
    "position": 0,
    "text": "منم گفت یزدان پرستنده شاه"
  },
  {
    "poem_id": 1528,
    "vorder": 24,
    "position": 1,
    "text": "مرا ایزد پاک داد این کلاه"
  },
  {
    "poem_id": 1528,
    "vorder": 25,
    "position": 0,
    "text": "بدان داد ما را کلاه بزرگ"
  },
  {
    "poem_id": 1528,
    "vorder": 26,
    "position": 1,
    "text": "که بیرون کنیم از رم میش گرگ"
  },
  {
    "poem_id": 1528,
    "vorder": 27,
    "position": 0,
    "text": "سوی راه یزدان بیازیم چنگ"
  },
  {
    "poem_id": 1528,
    "vorder": 28,
    "position": 1,
    "text": "بر آزاده گیتی نداریم تنگ"
  },
  {
    "poem_id": 1528,
    "vorder": 29,
    "position": 0,
    "text": "چو آیین شاهان بجای آوریم"
  },
  {
    "poem_id": 1528,
    "vorder": 30,
    "position": 1,
    "text": "بدان را به دین خدای آوریم"
  },
  {
    "poem_id": 1528,
    "vorder": 31,
    "position": 0,
    "text": "یکی داد گسترد کز داد اوی"
  },
  {
    "poem_id": 1528,
    "vorder": 32,
    "position": 1,
    "text": "ابا گرگ میش آب خوردی به جوی"
  },
  {
    "poem_id": 1528,
    "vorder": 33,
    "position": 0,
    "text": "پس آن دختر نامور قیصرا"
  },
  {
    "poem_id": 1528,
    "vorder": 34,
    "position": 1,
    "text": "که ناهید بد نام آن دخترا"
  },
  {
    "poem_id": 1528,
    "vorder": 35,
    "position": 0,
    "text": "کتایونش خواندی گرانمایه شاه"
  },
  {
    "poem_id": 1528,
    "vorder": 36,
    "position": 1,
    "text": "دو فرزندش آمد چو تابنده ماه"
  },
  {
    "poem_id": 1528,
    "vorder": 37,
    "position": 0,
    "text": "یکی نامور فرخ اسفندیار"
  },
  {
    "poem_id": 1528,
    "vorder": 38,
    "position": 1,
    "text": "شه کارزاری نبرده سوار"
  },
  {
    "poem_id": 1528,
    "vorder": 39,
    "position": 0,
    "text": "پشوتن دگر گرد شمشیر زن"
  },
  {
    "poem_id": 1528,
    "vorder": 40,
    "position": 1,
    "text": "شه نامبردار لشکرشکن"
  },
  {
    "poem_id": 1528,
    "vorder": 41,
    "position": 0,
    "text": "چو گیتی بران شاه نو راست شد"
  },
  {
    "poem_id": 1528,
    "vorder": 42,
    "position": 1,
    "text": "فریدون دیگر همی خواست شد"
  },
  {
    "poem_id": 1528,
    "vorder": 43,
    "position": 0,
    "text": "گزیدش بدادند شاهان همه"
  },
  {
    "poem_id": 1528,
    "vorder": 44,
    "position": 1,
    "text": "نشستن دل نیک‌خواهان همه"
  },
  {
    "poem_id": 1528,
    "vorder": 45,
    "position": 0,
    "text": "مگر شاه ارجاسپ توران خدای"
  },
  {
    "poem_id": 1528,
    "vorder": 46,
    "position": 1,
    "text": "که دیوان بدندی به پیشش به پای"
  },
  {
    "poem_id": 1528,
    "vorder": 47,
    "position": 0,
    "text": "گزیتش نپذرفت و نشنید پند"
  },
  {
    "poem_id": 1528,
    "vorder": 48,
    "position": 1,
    "text": "اگر پند نشنید زو دید بند"
  },
  {
    "poem_id": 1528,
    "vorder": 49,
    "position": 0,
    "text": "وزو بستدی نیز هر سال باژ"
  },
  {
    "poem_id": 1528,
    "vorder": 50,
    "position": 1,
    "text": "چرا داد باید به هامال باژ"
  }
]