[
  {
    "poem_id": 1649,
    "vorder": 1,
    "position": 0,
    "text": "گزین کرد زان رومیان مرد چند"
  },
  {
    "poem_id": 1649,
    "vorder": 2,
    "position": 1,
    "text": "خردمند و بادانش و بی‌گزند"
  },
  {
    "poem_id": 1649,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامه بنوشت پس شهریار"
  },
  {
    "poem_id": 1649,
    "vorder": 4,
    "position": 1,
    "text": "پر از پوزش و رنگ و بوی و نگار"
  },
  {
    "poem_id": 1649,
    "vorder": 5,
    "position": 0,
    "text": "که نه نامور ز استواران خویش"
  },
  {
    "poem_id": 1649,
    "vorder": 6,
    "position": 1,
    "text": "ازین پرهنر نامداران خویش"
  },
  {
    "poem_id": 1649,
    "vorder": 7,
    "position": 0,
    "text": "خردمند و بادانش و شرم و رای"
  },
  {
    "poem_id": 1649,
    "vorder": 8,
    "position": 1,
    "text": "جهانجوی و پردانش و رهنمای"
  },
  {
    "poem_id": 1649,
    "vorder": 9,
    "position": 0,
    "text": "فرستادم اینک به نزدیک تو"
  },
  {
    "poem_id": 1649,
    "vorder": 10,
    "position": 1,
    "text": "نه پیچند با رای باریک تو"
  },
  {
    "poem_id": 1649,
    "vorder": 11,
    "position": 0,
    "text": "تو این چیزها را بدیشان نمای"
  },
  {
    "poem_id": 1649,
    "vorder": 12,
    "position": 1,
    "text": "همانا بباشد هم‌انجا به جای"
  },
  {
    "poem_id": 1649,
    "vorder": 13,
    "position": 0,
    "text": "چو من نامه یابم ز پیران خویش"
  },
  {
    "poem_id": 1649,
    "vorder": 14,
    "position": 1,
    "text": "جهاندیده و رازداران خویش"
  },
  {
    "poem_id": 1649,
    "vorder": 15,
    "position": 0,
    "text": "که بگذشت بر چشم ما چار چیز"
  },
  {
    "poem_id": 1649,
    "vorder": 16,
    "position": 1,
    "text": "که کس را به گیتی نبودست نیز"
  },
  {
    "poem_id": 1649,
    "vorder": 17,
    "position": 0,
    "text": "نویسم یکی نامهٔ دلپسند"
  },
  {
    "poem_id": 1649,
    "vorder": 18,
    "position": 1,
    "text": "که کیدست تا باشد او شاه هند"
  },
  {
    "poem_id": 1649,
    "vorder": 19,
    "position": 0,
    "text": "خردمند نه مرد رومی برفت"
  },
  {
    "poem_id": 1649,
    "vorder": 20,
    "position": 1,
    "text": "ز پیش سکندر سوی کید تفت"
  },
  {
    "poem_id": 1649,
    "vorder": 21,
    "position": 0,
    "text": "چو سالار هند آن سران را بدید"
  },
  {
    "poem_id": 1649,
    "vorder": 22,
    "position": 1,
    "text": "فراوان بپرسید و پاسخ شنید"
  },
  {
    "poem_id": 1649,
    "vorder": 23,
    "position": 0,
    "text": "چنانچون ببایست بنواختشان"
  },
  {
    "poem_id": 1649,
    "vorder": 24,
    "position": 1,
    "text": "یکی جای شایسته بنشاختشان"
  },
  {
    "poem_id": 1649,
    "vorder": 25,
    "position": 0,
    "text": "دگر روز چون آسمان گشت زرد"
  },
  {
    "poem_id": 1649,
    "vorder": 26,
    "position": 1,
    "text": "برآهیخت خورشید تیغ نبرد"
  },
  {
    "poem_id": 1649,
    "vorder": 27,
    "position": 0,
    "text": "بیاراست آن دختر شاه را"
  },
  {
    "poem_id": 1649,
    "vorder": 28,
    "position": 1,
    "text": "نباید خود آراستن ماه را"
  },
  {
    "poem_id": 1649,
    "vorder": 29,
    "position": 0,
    "text": "به خانه درون تخت زرین نهاد"
  },
  {
    "poem_id": 1649,
    "vorder": 30,
    "position": 1,
    "text": "به گرد اندر آرایش چین نهاد"
  },
  {
    "poem_id": 1649,
    "vorder": 31,
    "position": 0,
    "text": "نشست از بر تخت خورشید چهر"
  },
  {
    "poem_id": 1649,
    "vorder": 32,
    "position": 1,
    "text": "ز ناهید تابنده‌تر بر سپهر"
  },
  {
    "poem_id": 1649,
    "vorder": 33,
    "position": 0,
    "text": "برفتند بیدار نه مرد پیر"
  },
  {
    "poem_id": 1649,
    "vorder": 34,
    "position": 1,
    "text": "زبان چرب و گوینده و یادگیر"
  },
  {
    "poem_id": 1649,
    "vorder": 35,
    "position": 0,
    "text": "فرستادشان شاه سوی عروس"
  },
  {
    "poem_id": 1649,
    "vorder": 36,
    "position": 1,
    "text": "بر آواز اسکندر فیلقوس"
  },
  {
    "poem_id": 1649,
    "vorder": 37,
    "position": 0,
    "text": "بدیدند پیران رخ دخت شاه"
  },
  {
    "poem_id": 1649,
    "vorder": 38,
    "position": 1,
    "text": "درفشان ازو یاره و تخت و گاه"
  },
  {
    "poem_id": 1649,
    "vorder": 39,
    "position": 0,
    "text": "فرو ماندند اندرو خیره خیر"
  },
  {
    "poem_id": 1649,
    "vorder": 40,
    "position": 1,
    "text": "ز دیدار او سست شد پای پیر"
  },
  {
    "poem_id": 1649,
    "vorder": 41,
    "position": 0,
    "text": "خردمند نه پیر مانده به جای"
  },
  {
    "poem_id": 1649,
    "vorder": 42,
    "position": 1,
    "text": "زبانها پر از آفرین خدای"
  },
  {
    "poem_id": 1649,
    "vorder": 43,
    "position": 0,
    "text": "نه جای گذر دید ازیشان یکی"
  },
  {
    "poem_id": 1649,
    "vorder": 44,
    "position": 1,
    "text": "نه زو چشم برداشتند اندکی"
  },
  {
    "poem_id": 1649,
    "vorder": 45,
    "position": 0,
    "text": "چو فرزانگان دیرتر ماندند"
  },
  {
    "poem_id": 1649,
    "vorder": 46,
    "position": 1,
    "text": "کس آمد بر شاهشان خواندند"
  },
  {
    "poem_id": 1649,
    "vorder": 47,
    "position": 0,
    "text": "چنین گفت با رومیان شهریار"
  },
  {
    "poem_id": 1649,
    "vorder": 48,
    "position": 1,
    "text": "که چندین چرا بودتان روزگار"
  },
  {
    "poem_id": 1649,
    "vorder": 49,
    "position": 0,
    "text": "همو آدمی بودکان چهره داشت"
  },
  {
    "poem_id": 1649,
    "vorder": 50,
    "position": 1,
    "text": "به خوبی ز هر اختری بهره داشت"
  },
  {
    "poem_id": 1649,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت رومی که ای شهریار"
  },
  {
    "poem_id": 1649,
    "vorder": 52,
    "position": 1,
    "text": "در ایوان چنو کس نبیند نگار"
  },
  {
    "poem_id": 1649,
    "vorder": 53,
    "position": 0,
    "text": "کنون هر یکی از یک اندام ماه"
  },
  {
    "poem_id": 1649,
    "vorder": 54,
    "position": 1,
    "text": "فرستیم یک نامه نزدیک شاه"
  },
  {
    "poem_id": 1649,
    "vorder": 55,
    "position": 0,
    "text": "نشستند پس فیلسوفان بهم"
  },
  {
    "poem_id": 1649,
    "vorder": 56,
    "position": 1,
    "text": "گرفتند قرطاس و قیر و قلم"
  },
  {
    "poem_id": 1649,
    "vorder": 57,
    "position": 0,
    "text": "نوشتند هر موبدی ز آنک دید"
  },
  {
    "poem_id": 1649,
    "vorder": 58,
    "position": 1,
    "text": "که قرطاس ز انقاس شد ناپدید"
  },
  {
    "poem_id": 1649,
    "vorder": 59,
    "position": 0,
    "text": "ز نزدیک ایشان سواری برفت"
  },
  {
    "poem_id": 1649,
    "vorder": 60,
    "position": 1,
    "text": "به نزد سکندر به میلاد تفت"
  },
  {
    "poem_id": 1649,
    "vorder": 61,
    "position": 0,
    "text": "چو شاه جهان نامه‌هاشان بخواند"
  },
  {
    "poem_id": 1649,
    "vorder": 62,
    "position": 1,
    "text": "ز گفتارشان در شگفتی بماند"
  },
  {
    "poem_id": 1649,
    "vorder": 63,
    "position": 0,
    "text": "به نامه هر اندام را زو یکی"
  },
  {
    "poem_id": 1649,
    "vorder": 64,
    "position": 1,
    "text": "صفت کرده بودند لیک اندکی"
  },
  {
    "poem_id": 1649,
    "vorder": 65,
    "position": 0,
    "text": "بدیشان جهاندار پاسخ نوشت"
  },
  {
    "poem_id": 1649,
    "vorder": 66,
    "position": 1,
    "text": "که بخ‌بخ که دیدم خرم بهشت"
  },
  {
    "poem_id": 1649,
    "vorder": 67,
    "position": 0,
    "text": "کنون بازگردید با چار چیز"
  },
  {
    "poem_id": 1649,
    "vorder": 68,
    "position": 1,
    "text": "برین بر فزونی مجویید نیز"
  },
  {
    "poem_id": 1649,
    "vorder": 69,
    "position": 0,
    "text": "چو منشور و عهد من او را دهید"
  },
  {
    "poem_id": 1649,
    "vorder": 70,
    "position": 1,
    "text": "شما با فغستان بنه برنهید"
  },
  {
    "poem_id": 1649,
    "vorder": 71,
    "position": 0,
    "text": "نیازارد او را کسی زین سپس"
  },
  {
    "poem_id": 1649,
    "vorder": 72,
    "position": 1,
    "text": "ازو در جهان یافتم داد و بس"
  }
]