[
  {
    "poem_id": 88095,
    "vorder": 1,
    "position": 0,
    "text": "چو دستان شنید این سخن خیره شد"
  },
  {
    "poem_id": 88095,
    "vorder": 2,
    "position": 1,
    "text": "همی چشمش از روی او تیره شد"
  },
  {
    "poem_id": 88095,
    "vorder": 3,
    "position": 0,
    "text": "خروشان شد از شاه و بر پای خاست"
  },
  {
    "poem_id": 88095,
    "vorder": 4,
    "position": 1,
    "text": "چنین گفت کای داور داد و راست"
  },
  {
    "poem_id": 88095,
    "vorder": 5,
    "position": 0,
    "text": "ز من بود تیزی و نابخردی"
  },
  {
    "poem_id": 88095,
    "vorder": 6,
    "position": 1,
    "text": "توی پاک فرزانهٔ ایزدی"
  },
  {
    "poem_id": 88095,
    "vorder": 7,
    "position": 0,
    "text": "سزد گر ببخشی گناه مرا"
  },
  {
    "poem_id": 88095,
    "vorder": 8,
    "position": 1,
    "text": "اگر دیو گم کرد راه مرا"
  },
  {
    "poem_id": 88095,
    "vorder": 9,
    "position": 0,
    "text": "مرا سالیان شد فزون از شمار"
  },
  {
    "poem_id": 88095,
    "vorder": 10,
    "position": 1,
    "text": "کمر بسته‌ام پیش هر شهریار"
  },
  {
    "poem_id": 88095,
    "vorder": 11,
    "position": 0,
    "text": "ز شاهان ندیدم کز این گونه راه"
  },
  {
    "poem_id": 88095,
    "vorder": 12,
    "position": 1,
    "text": "بجستی ز دادار خورشید و ماه"
  },
  {
    "poem_id": 88095,
    "vorder": 13,
    "position": 0,
    "text": "که ما را جدایی نبود آرزوی"
  },
  {
    "poem_id": 88095,
    "vorder": 14,
    "position": 1,
    "text": "از این دادگر خسرو نیک‌خوی"
  },
  {
    "poem_id": 88095,
    "vorder": 15,
    "position": 0,
    "text": "سخنهای دستان چو بشنید شاه"
  },
  {
    "poem_id": 88095,
    "vorder": 16,
    "position": 1,
    "text": "پسند آمدش پوزش نیک‌خواه"
  },
  {
    "poem_id": 88095,
    "vorder": 17,
    "position": 0,
    "text": "بیازید و بگرفت دستش به دست"
  },
  {
    "poem_id": 88095,
    "vorder": 18,
    "position": 1,
    "text": "بر خویش بردش به جای نشست"
  },
  {
    "poem_id": 88095,
    "vorder": 19,
    "position": 0,
    "text": "بدانست کاو این سخن جز به مهر"
  },
  {
    "poem_id": 88095,
    "vorder": 20,
    "position": 1,
    "text": "نپیمود با شاه خورشید چهر"
  },
  {
    "poem_id": 88095,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت پس شاه با زال زر"
  },
  {
    "poem_id": 88095,
    "vorder": 22,
    "position": 1,
    "text": "که اکنون ببندید یکسر کمر"
  },
  {
    "poem_id": 88095,
    "vorder": 23,
    "position": 0,
    "text": "تو و رستم و طوس و گودرز و گیو"
  },
  {
    "poem_id": 88095,
    "vorder": 24,
    "position": 1,
    "text": "دگر هر که او نامدارست نیو"
  },
  {
    "poem_id": 88095,
    "vorder": 25,
    "position": 0,
    "text": "سراپرده از شهر بیرون برید"
  },
  {
    "poem_id": 88095,
    "vorder": 26,
    "position": 1,
    "text": "درفش همایون به هامون برید"
  },
  {
    "poem_id": 88095,
    "vorder": 27,
    "position": 0,
    "text": "ز خرگاه وز خیمه چندان که هست"
  },
  {
    "poem_id": 88095,
    "vorder": 28,
    "position": 1,
    "text": "بسازید بر دشت جای نشست"
  },
  {
    "poem_id": 88095,
    "vorder": 29,
    "position": 0,
    "text": "درفش بزرگان و پیل و سپاه"
  },
  {
    "poem_id": 88095,
    "vorder": 30,
    "position": 1,
    "text": "بسازید روشن یکی رزمگاه"
  },
  {
    "poem_id": 88095,
    "vorder": 31,
    "position": 0,
    "text": "چنان کرد رستم که خسرو بگفت"
  },
  {
    "poem_id": 88095,
    "vorder": 32,
    "position": 1,
    "text": "ببردند پرده‌سرای از نهفت"
  },
  {
    "poem_id": 88095,
    "vorder": 33,
    "position": 0,
    "text": "به هامون کشیدند ایرانیان"
  },
  {
    "poem_id": 88095,
    "vorder": 34,
    "position": 1,
    "text": "به فرمان ببستند یکسر میان"
  },
  {
    "poem_id": 88095,
    "vorder": 35,
    "position": 0,
    "text": "سپید و سیاه و بنفش و کبود"
  },
  {
    "poem_id": 88095,
    "vorder": 36,
    "position": 1,
    "text": "زمین کوه تا کوه پر خیمه بود"
  },
  {
    "poem_id": 88095,
    "vorder": 37,
    "position": 0,
    "text": "میان اندرون کاویانی درفش"
  },
  {
    "poem_id": 88095,
    "vorder": 38,
    "position": 1,
    "text": "جهان زو شده سرخ و زرد و بنفش"
  },
  {
    "poem_id": 88095,
    "vorder": 39,
    "position": 0,
    "text": "سراپردهٔ زال نزدیک شاه"
  },
  {
    "poem_id": 88095,
    "vorder": 40,
    "position": 1,
    "text": "برافراخته زو درفش سیاه"
  },
  {
    "poem_id": 88095,
    "vorder": 41,
    "position": 0,
    "text": "به دست چپش رستم پهلوان"
  },
  {
    "poem_id": 88095,
    "vorder": 42,
    "position": 1,
    "text": "ز کابل بزرگان روشن‌روان"
  },
  {
    "poem_id": 88095,
    "vorder": 43,
    "position": 0,
    "text": "به پیش اندرون طوس و گودرز و گیو"
  },
  {
    "poem_id": 88095,
    "vorder": 44,
    "position": 1,
    "text": "چو رهام و شاپور و گرگین نیو"
  },
  {
    "poem_id": 88095,
    "vorder": 45,
    "position": 0,
    "text": "پس پشت او بیژن و گستهم"
  },
  {
    "poem_id": 88095,
    "vorder": 46,
    "position": 1,
    "text": "بزرگان که بودند با او به هم"
  }
]