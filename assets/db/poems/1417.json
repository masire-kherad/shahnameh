[
  {
    "poem_id": 1417,
    "vorder": 1,
    "position": 0,
    "text": "به گستهم و طوس آمد این آگهی"
  },
  {
    "poem_id": 1417,
    "vorder": 2,
    "position": 1,
    "text": "که تیره شد آن فر شاهنشهی"
  },
  {
    "poem_id": 1417,
    "vorder": 3,
    "position": 0,
    "text": "به شمشیر تیز آن سر تاجدار"
  },
  {
    "poem_id": 1417,
    "vorder": 4,
    "position": 1,
    "text": "به زاری بریدند و برگشت کار"
  },
  {
    "poem_id": 1417,
    "vorder": 5,
    "position": 0,
    "text": "بکندند موی و شخودند روی"
  },
  {
    "poem_id": 1417,
    "vorder": 6,
    "position": 1,
    "text": "از ایران برآمد یکی های‌وهوی"
  },
  {
    "poem_id": 1417,
    "vorder": 7,
    "position": 0,
    "text": "سر سرکشان گشت پرگرد و خاک"
  },
  {
    "poem_id": 1417,
    "vorder": 8,
    "position": 1,
    "text": "همه دیده پر خون همه جامه چاک"
  },
  {
    "poem_id": 1417,
    "vorder": 9,
    "position": 0,
    "text": "سوی زابلستان نهادند روی"
  },
  {
    "poem_id": 1417,
    "vorder": 10,
    "position": 1,
    "text": "زبان شاه‌گوی و روان شاه‌جوی"
  },
  {
    "poem_id": 1417,
    "vorder": 11,
    "position": 0,
    "text": "بر زال رفتند با سوگ و درد"
  },
  {
    "poem_id": 1417,
    "vorder": 12,
    "position": 1,
    "text": "رخان پر ز خون و سران پر ز گرد"
  },
  {
    "poem_id": 1417,
    "vorder": 13,
    "position": 0,
    "text": "که زارا دلیرا شها نوذرا"
  },
  {
    "poem_id": 1417,
    "vorder": 14,
    "position": 1,
    "text": "گوا تاجدارا مها مهترا"
  },
  {
    "poem_id": 1417,
    "vorder": 15,
    "position": 0,
    "text": "نگهبان ایران و شاه جهان"
  },
  {
    "poem_id": 1417,
    "vorder": 16,
    "position": 1,
    "text": "سر تاجداران و پشت مهان"
  },
  {
    "poem_id": 1417,
    "vorder": 17,
    "position": 0,
    "text": "سرت افسر از خاک جوید همی"
  },
  {
    "poem_id": 1417,
    "vorder": 18,
    "position": 1,
    "text": "زمین خون شاهان ببوید همی"
  },
  {
    "poem_id": 1417,
    "vorder": 19,
    "position": 0,
    "text": "گیایی که روید بران بوم و بر"
  },
  {
    "poem_id": 1417,
    "vorder": 20,
    "position": 1,
    "text": "نگون دارد از شرم خورشید سر"
  },
  {
    "poem_id": 1417,
    "vorder": 21,
    "position": 0,
    "text": "همی داد خواهیم و زاری کنیم"
  },
  {
    "poem_id": 1417,
    "vorder": 22,
    "position": 1,
    "text": "به خون پدر سوگواری کنیم"
  },
  {
    "poem_id": 1417,
    "vorder": 23,
    "position": 0,
    "text": "نشان فریدون بدو زنده بود"
  },
  {
    "poem_id": 1417,
    "vorder": 24,
    "position": 1,
    "text": "زمین نعل اسپ ورا بنده بود"
  },
  {
    "poem_id": 1417,
    "vorder": 25,
    "position": 0,
    "text": "به زاری و خواری سرش را ز تن"
  },
  {
    "poem_id": 1417,
    "vorder": 26,
    "position": 1,
    "text": "بریدند با نامدار انجمن"
  },
  {
    "poem_id": 1417,
    "vorder": 27,
    "position": 0,
    "text": "همه تیغ زهرآبگون برکشید"
  },
  {
    "poem_id": 1417,
    "vorder": 28,
    "position": 1,
    "text": "به کین جستن آیید و دشمن کشید"
  },
  {
    "poem_id": 1417,
    "vorder": 29,
    "position": 0,
    "text": "همانا برین سوگ با ما سپهر"
  },
  {
    "poem_id": 1417,
    "vorder": 30,
    "position": 1,
    "text": "ز دیده فرو باردی خون به مهر"
  },
  {
    "poem_id": 1417,
    "vorder": 31,
    "position": 0,
    "text": "شما نیز دیده پر از خون کنید"
  },
  {
    "poem_id": 1417,
    "vorder": 32,
    "position": 1,
    "text": "همه جامهٔ ناز بیرون کنید"
  },
  {
    "poem_id": 1417,
    "vorder": 33,
    "position": 0,
    "text": "که با کین شاهان نشاید که چشم"
  },
  {
    "poem_id": 1417,
    "vorder": 34,
    "position": 1,
    "text": "نباشد پر از آب و دل پر ز خشم"
  },
  {
    "poem_id": 1417,
    "vorder": 35,
    "position": 0,
    "text": "همه انجمن زار و گریان شدند"
  },
  {
    "poem_id": 1417,
    "vorder": 36,
    "position": 1,
    "text": "چو بر آتش تیز بریان شدند"
  },
  {
    "poem_id": 1417,
    "vorder": 37,
    "position": 0,
    "text": "زبان داد دستان که تا رستخیز"
  },
  {
    "poem_id": 1417,
    "vorder": 38,
    "position": 1,
    "text": "نبیند نیام مرا تیغ تیز"
  },
  {
    "poem_id": 1417,
    "vorder": 39,
    "position": 0,
    "text": "چمان چرمه در زیر تخت منست"
  },
  {
    "poem_id": 1417,
    "vorder": 40,
    "position": 1,
    "text": "سنان‌دار نیزه درخت منست"
  },
  {
    "poem_id": 1417,
    "vorder": 41,
    "position": 0,
    "text": "رکابست پای مرا جایگاه"
  },
  {
    "poem_id": 1417,
    "vorder": 42,
    "position": 1,
    "text": "یکی ترگ تیره سرم را کلاه"
  },
  {
    "poem_id": 1417,
    "vorder": 43,
    "position": 0,
    "text": "برین کینه آرامش و خواب نیست"
  },
  {
    "poem_id": 1417,
    "vorder": 44,
    "position": 1,
    "text": "همی چون دو چشمم به جوی آب نیست"
  },
  {
    "poem_id": 1417,
    "vorder": 45,
    "position": 0,
    "text": "روان چنان شهریار جهان"
  },
  {
    "poem_id": 1417,
    "vorder": 46,
    "position": 1,
    "text": "درخشنده بادا میان مهان"
  },
  {
    "poem_id": 1417,
    "vorder": 47,
    "position": 0,
    "text": "شما را به داد جهان آفرین"
  },
  {
    "poem_id": 1417,
    "vorder": 48,
    "position": 1,
    "text": "دل ارمیده بادا به آیین و دین"
  },
  {
    "poem_id": 1417,
    "vorder": 49,
    "position": 0,
    "text": "ز مادر همه مرگ را زاده‌ایم"
  },
  {
    "poem_id": 1417,
    "vorder": 50,
    "position": 1,
    "text": "برینیم و گردن ورا داده‌ایم"
  },
  {
    "poem_id": 1417,
    "vorder": 51,
    "position": 0,
    "text": "چو گردان سوی کینه بشتافتند"
  },
  {
    "poem_id": 1417,
    "vorder": 52,
    "position": 1,
    "text": "به ساری سران آگهی یافتند"
  },
  {
    "poem_id": 1417,
    "vorder": 53,
    "position": 0,
    "text": "ازیشان بشد خورد و آرام و خواب"
  },
  {
    "poem_id": 1417,
    "vorder": 54,
    "position": 1,
    "text": "پر از بیم گشتند از افراسیاب"
  },
  {
    "poem_id": 1417,
    "vorder": 55,
    "position": 0,
    "text": "ازان پس به اغریرث آمد پیام"
  },
  {
    "poem_id": 1417,
    "vorder": 56,
    "position": 1,
    "text": "که ای پرمنش مهتر نیک‌نام"
  },
  {
    "poem_id": 1417,
    "vorder": 57,
    "position": 0,
    "text": "به گیتی به گفتار تو زنده‌ایم"
  },
  {
    "poem_id": 1417,
    "vorder": 58,
    "position": 1,
    "text": "همه یک به یک مر ترا بنده‌ایم"
  },
  {
    "poem_id": 1417,
    "vorder": 59,
    "position": 0,
    "text": "تو دانی که دستان به زابلستان"
  },
  {
    "poem_id": 1417,
    "vorder": 60,
    "position": 1,
    "text": "به جایست با شاه کابلستان"
  },
  {
    "poem_id": 1417,
    "vorder": 61,
    "position": 0,
    "text": "چو برزین و چون قارن رزم‌زن"
  },
  {
    "poem_id": 1417,
    "vorder": 62,
    "position": 1,
    "text": "چو خراد و کشواد لشکرشکن"
  },
  {
    "poem_id": 1417,
    "vorder": 63,
    "position": 0,
    "text": "یلانند با چنگهای دراز"
  },
  {
    "poem_id": 1417,
    "vorder": 64,
    "position": 1,
    "text": "ندارند از ایران چنین دست باز"
  },
  {
    "poem_id": 1417,
    "vorder": 65,
    "position": 0,
    "text": "چو تابند گردان ازین سو عنان"
  },
  {
    "poem_id": 1417,
    "vorder": 66,
    "position": 1,
    "text": "به چشم اندر آرند نوک سنان"
  },
  {
    "poem_id": 1417,
    "vorder": 67,
    "position": 0,
    "text": "ازان تیز گردد رد افراسیاب"
  },
  {
    "poem_id": 1417,
    "vorder": 68,
    "position": 1,
    "text": "دلش گردد از بستگان پرشتاب"
  },
  {
    "poem_id": 1417,
    "vorder": 69,
    "position": 0,
    "text": "پس آنگه سر یک رمه بی‌گناه"
  },
  {
    "poem_id": 1417,
    "vorder": 70,
    "position": 1,
    "text": "به خاک اندر آرد ز بهر کلاه"
  },
  {
    "poem_id": 1417,
    "vorder": 71,
    "position": 0,
    "text": "اگر بیند اغریرث هوشمند"
  },
  {
    "poem_id": 1417,
    "vorder": 72,
    "position": 1,
    "text": "مر این بستگان را گشاید ز بند"
  },
  {
    "poem_id": 1417,
    "vorder": 73,
    "position": 0,
    "text": "پراگنده گردیم گرد جهان"
  },
  {
    "poem_id": 1417,
    "vorder": 74,
    "position": 1,
    "text": "زبان برگشاییم پیش مهان"
  },
  {
    "poem_id": 1417,
    "vorder": 75,
    "position": 0,
    "text": "به پیش بزرگان ستایش کنیم"
  },
  {
    "poem_id": 1417,
    "vorder": 76,
    "position": 1,
    "text": "همان پیش یزدان نیایش کنیم"
  },
  {
    "poem_id": 1417,
    "vorder": 77,
    "position": 0,
    "text": "چنین گفت اغریرث پرخرد"
  },
  {
    "poem_id": 1417,
    "vorder": 78,
    "position": 1,
    "text": "کزین گونه گفتار کی درخورد"
  },
  {
    "poem_id": 1417,
    "vorder": 79,
    "position": 0,
    "text": "ز من آشکارا شود دشمنی"
  },
  {
    "poem_id": 1417,
    "vorder": 80,
    "position": 1,
    "text": "بجوشد سر مرد آهرمنی"
  },
  {
    "poem_id": 1417,
    "vorder": 81,
    "position": 0,
    "text": "یکی چاره سازم دگرگونه زین"
  },
  {
    "poem_id": 1417,
    "vorder": 82,
    "position": 1,
    "text": "که با من نگردد برادر به کین"
  },
  {
    "poem_id": 1417,
    "vorder": 83,
    "position": 0,
    "text": "گر ایدون که دستان شود تیزچنگ"
  },
  {
    "poem_id": 1417,
    "vorder": 84,
    "position": 1,
    "text": "یکی لشکر آرد بر ما به جنگ"
  },
  {
    "poem_id": 1417,
    "vorder": 85,
    "position": 0,
    "text": "چو آرد به نزدیک ساری رمه"
  },
  {
    "poem_id": 1417,
    "vorder": 86,
    "position": 1,
    "text": "به دستان سپارم شما را همه"
  },
  {
    "poem_id": 1417,
    "vorder": 87,
    "position": 0,
    "text": "بپردازم آمل نیایم به جنگ"
  },
  {
    "poem_id": 1417,
    "vorder": 88,
    "position": 1,
    "text": "سرم را ز نام اندرآرم به ننگ"
  },
  {
    "poem_id": 1417,
    "vorder": 89,
    "position": 0,
    "text": "بزرگان ایران ز گفتار اوی"
  },
  {
    "poem_id": 1417,
    "vorder": 90,
    "position": 1,
    "text": "بروی زمین برنهادند روی"
  },
  {
    "poem_id": 1417,
    "vorder": 91,
    "position": 0,
    "text": "چو از آفرینش بپرداختند"
  },
  {
    "poem_id": 1417,
    "vorder": 92,
    "position": 1,
    "text": "نوندی ز ساری برون تاختند"
  },
  {
    "poem_id": 1417,
    "vorder": 93,
    "position": 0,
    "text": "بپویید نزدیک دستان سام"
  },
  {
    "poem_id": 1417,
    "vorder": 94,
    "position": 1,
    "text": "بیاورد ازان نامداران پیام"
  },
  {
    "poem_id": 1417,
    "vorder": 95,
    "position": 0,
    "text": "که بخشود بر ما جهاندار ما"
  },
  {
    "poem_id": 1417,
    "vorder": 96,
    "position": 1,
    "text": "شد اغریرث پر خرد یار ما"
  },
  {
    "poem_id": 1417,
    "vorder": 97,
    "position": 0,
    "text": "یکی سخت پیمان فگندیم بن"
  },
  {
    "poem_id": 1417,
    "vorder": 98,
    "position": 1,
    "text": "بران برنهادیم یکسر سخن"
  },
  {
    "poem_id": 1417,
    "vorder": 99,
    "position": 0,
    "text": "کز ایران چو دستان آزادمرد"
  },
  {
    "poem_id": 1417,
    "vorder": 100,
    "position": 1,
    "text": "بیایند و جویند با وی نبرد"
  },
  {
    "poem_id": 1417,
    "vorder": 101,
    "position": 0,
    "text": "گرانمایه اغریرث نیک پی"
  },
  {
    "poem_id": 1417,
    "vorder": 102,
    "position": 1,
    "text": "ز آمل گذارد سپه را به ری"
  },
  {
    "poem_id": 1417,
    "vorder": 103,
    "position": 0,
    "text": "مگر زنده از چنگ این اژدها"
  },
  {
    "poem_id": 1417,
    "vorder": 104,
    "position": 1,
    "text": "تن یک جهان مردم آید رها"
  },
  {
    "poem_id": 1417,
    "vorder": 105,
    "position": 0,
    "text": "چو پوینده در زابلستان رسید"
  },
  {
    "poem_id": 1417,
    "vorder": 106,
    "position": 1,
    "text": "سراینده در پیش دستان رسید"
  },
  {
    "poem_id": 1417,
    "vorder": 107,
    "position": 0,
    "text": "بزرگان و جنگ‌آوران را بخواند"
  },
  {
    "poem_id": 1417,
    "vorder": 108,
    "position": 1,
    "text": "پیام یلان پیش ایشان براند"
  },
  {
    "poem_id": 1417,
    "vorder": 109,
    "position": 0,
    "text": "ازان پس چنین گفت کای سروران"
  },
  {
    "poem_id": 1417,
    "vorder": 110,
    "position": 1,
    "text": "پلنگان جنگی و نام‌آوران"
  },
  {
    "poem_id": 1417,
    "vorder": 111,
    "position": 0,
    "text": "کدامست مردی کنارنگ دل"
  },
  {
    "poem_id": 1417,
    "vorder": 112,
    "position": 1,
    "text": "به مردی سیه کرده در جنگ دل"
  },
  {
    "poem_id": 1417,
    "vorder": 113,
    "position": 0,
    "text": "خریدار این جنگ و این تاختن"
  },
  {
    "poem_id": 1417,
    "vorder": 114,
    "position": 1,
    "text": "به خورشید گردن برافراختن"
  },
  {
    "poem_id": 1417,
    "vorder": 115,
    "position": 0,
    "text": "ببر زد بران کار کشواد دست"
  },
  {
    "poem_id": 1417,
    "vorder": 116,
    "position": 1,
    "text": "منم گفت یازان بدین داد دست"
  },
  {
    "poem_id": 1417,
    "vorder": 117,
    "position": 0,
    "text": "برو آفرین کرد فرخنده زال"
  },
  {
    "poem_id": 1417,
    "vorder": 118,
    "position": 1,
    "text": "که خرم بدی تا بود ماه و سال"
  },
  {
    "poem_id": 1417,
    "vorder": 119,
    "position": 0,
    "text": "سپاهی ز گردان پرخاشجوی"
  },
  {
    "poem_id": 1417,
    "vorder": 120,
    "position": 1,
    "text": "ز زابل به آمل نهادند روی"
  },
  {
    "poem_id": 1417,
    "vorder": 121,
    "position": 0,
    "text": "چو از پیش دستان برون شد سپاه"
  },
  {
    "poem_id": 1417,
    "vorder": 122,
    "position": 1,
    "text": "خبر شد به اغریرث نیک خواه"
  },
  {
    "poem_id": 1417,
    "vorder": 123,
    "position": 0,
    "text": "همه بستگان را به ساری بماند"
  },
  {
    "poem_id": 1417,
    "vorder": 124,
    "position": 1,
    "text": "بزد نای رویین و لشکر براند"
  },
  {
    "poem_id": 1417,
    "vorder": 125,
    "position": 0,
    "text": "چو گشواد فرخ به ساری رسید"
  },
  {
    "poem_id": 1417,
    "vorder": 126,
    "position": 1,
    "text": "پدید آمد آن بندها را کلید"
  },
  {
    "poem_id": 1417,
    "vorder": 127,
    "position": 0,
    "text": "یکی اسپ مر هر یکی را بساخت"
  },
  {
    "poem_id": 1417,
    "vorder": 128,
    "position": 1,
    "text": "ز ساری سوی زابلستان بتاخت"
  },
  {
    "poem_id": 1417,
    "vorder": 129,
    "position": 0,
    "text": "چو آمد به دستان سام آگهی"
  },
  {
    "poem_id": 1417,
    "vorder": 130,
    "position": 1,
    "text": "که برگشت گشواد با فرهی"
  },
  {
    "poem_id": 1417,
    "vorder": 131,
    "position": 0,
    "text": "یکی گنج ویژه به درویش داد"
  },
  {
    "poem_id": 1417,
    "vorder": 132,
    "position": 1,
    "text": "سراینده را جامهٔ خویش داد"
  },
  {
    "poem_id": 1417,
    "vorder": 133,
    "position": 0,
    "text": "چو گشواد نزدیک زابل رسید"
  },
  {
    "poem_id": 1417,
    "vorder": 134,
    "position": 1,
    "text": "پذیره شدش زال زر چون سزید"
  },
  {
    "poem_id": 1417,
    "vorder": 135,
    "position": 0,
    "text": "بران بستگان زار بگریست دیر"
  },
  {
    "poem_id": 1417,
    "vorder": 136,
    "position": 1,
    "text": "کجا مانده بودند در چنگ شیر"
  },
  {
    "poem_id": 1417,
    "vorder": 137,
    "position": 0,
    "text": "پس از نامور نوذر شهریار"
  },
  {
    "poem_id": 1417,
    "vorder": 138,
    "position": 1,
    "text": "به سر خاک بر کرد و بگریست زار"
  },
  {
    "poem_id": 1417,
    "vorder": 139,
    "position": 0,
    "text": "به شهر اندر آوردشان ارجمند"
  },
  {
    "poem_id": 1417,
    "vorder": 140,
    "position": 1,
    "text": "بیاراست ایوانهای بلند"
  },
  {
    "poem_id": 1417,
    "vorder": 141,
    "position": 0,
    "text": "چنان هم که هنگام نوذر بدند"
  },
  {
    "poem_id": 1417,
    "vorder": 142,
    "position": 1,
    "text": "که با تاج و با تخت و افسر بدند"
  },
  {
    "poem_id": 1417,
    "vorder": 143,
    "position": 0,
    "text": "بیاراست دستان همه دستگاه"
  },
  {
    "poem_id": 1417,
    "vorder": 144,
    "position": 1,
    "text": "شد از خواسته بی‌نیاز آن سپاه"
  }
]