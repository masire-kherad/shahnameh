[
  {
    "poem_id": 1445,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد به کاووس شاه"
  },
  {
    "poem_id": 1445,
    "vorder": 2,
    "position": 1,
    "text": "که تنگ اندر آمد ز دیوان سپاه"
  },
  {
    "poem_id": 1445,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود تا رستم زال زر"
  },
  {
    "poem_id": 1445,
    "vorder": 4,
    "position": 1,
    "text": "نخستین بران کینه بندد کمر"
  },
  {
    "poem_id": 1445,
    "vorder": 5,
    "position": 0,
    "text": "به طوس و به گودرز کشوادگان"
  },
  {
    "poem_id": 1445,
    "vorder": 6,
    "position": 1,
    "text": "به گیو و به گرگین آزادگان"
  },
  {
    "poem_id": 1445,
    "vorder": 7,
    "position": 0,
    "text": "بفرمود تا لشکر آراستند"
  },
  {
    "poem_id": 1445,
    "vorder": 8,
    "position": 1,
    "text": "سنان و سپرها بپیراستند"
  },
  {
    "poem_id": 1445,
    "vorder": 9,
    "position": 0,
    "text": "سراپردهٔ شهریار و سران"
  },
  {
    "poem_id": 1445,
    "vorder": 10,
    "position": 1,
    "text": "کشیدند بر دشت مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 11,
    "position": 0,
    "text": "ابر میمنه طوس نوذر به پای"
  },
  {
    "poem_id": 1445,
    "vorder": 12,
    "position": 1,
    "text": "دل کوه پر نالهٔ کر نای"
  },
  {
    "poem_id": 1445,
    "vorder": 13,
    "position": 0,
    "text": "چو گودرز کشواد بر میسره"
  },
  {
    "poem_id": 1445,
    "vorder": 14,
    "position": 1,
    "text": "شده کوه آهن زمین یکسره"
  },
  {
    "poem_id": 1445,
    "vorder": 15,
    "position": 0,
    "text": "سپهدار کاووس در قلبگاه"
  },
  {
    "poem_id": 1445,
    "vorder": 16,
    "position": 1,
    "text": "ز هر سو رده برکشیده سپاه"
  },
  {
    "poem_id": 1445,
    "vorder": 17,
    "position": 0,
    "text": "به پیش سپاه اندرون پیلتن"
  },
  {
    "poem_id": 1445,
    "vorder": 18,
    "position": 1,
    "text": "که در جنگ هرگز ندیدی شکن"
  },
  {
    "poem_id": 1445,
    "vorder": 19,
    "position": 0,
    "text": "یکی نامداری ز مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 20,
    "position": 1,
    "text": "به گردن برآورده گرز گران"
  },
  {
    "poem_id": 1445,
    "vorder": 21,
    "position": 0,
    "text": "که جویان بدش نام و جوینده بود"
  },
  {
    "poem_id": 1445,
    "vorder": 22,
    "position": 1,
    "text": "گرایندهٔ گرز و گوینده بود"
  },
  {
    "poem_id": 1445,
    "vorder": 23,
    "position": 0,
    "text": "به دستوری شاه دیوان برفت"
  },
  {
    "poem_id": 1445,
    "vorder": 24,
    "position": 1,
    "text": "به پیش سپهدار کاووس تفت"
  },
  {
    "poem_id": 1445,
    "vorder": 25,
    "position": 0,
    "text": "همی جوشن اندر تنش برفروخت"
  },
  {
    "poem_id": 1445,
    "vorder": 26,
    "position": 1,
    "text": "همی تف تیغش زمین را بسوخت"
  },
  {
    "poem_id": 1445,
    "vorder": 27,
    "position": 0,
    "text": "بیامد به ایران سپه برگذشت"
  },
  {
    "poem_id": 1445,
    "vorder": 28,
    "position": 1,
    "text": "بتوفید از آواز او کوه و دشت"
  },
  {
    "poem_id": 1445,
    "vorder": 29,
    "position": 0,
    "text": "همی گفت با من که جوید نبرد"
  },
  {
    "poem_id": 1445,
    "vorder": 30,
    "position": 1,
    "text": "کسی کاو برانگیزد از آب گرد"
  },
  {
    "poem_id": 1445,
    "vorder": 31,
    "position": 0,
    "text": "نشد هیچکس پیش جویان برون"
  },
  {
    "poem_id": 1445,
    "vorder": 32,
    "position": 1,
    "text": "نه رگشان بجنبید در تن نه خون"
  },
  {
    "poem_id": 1445,
    "vorder": 33,
    "position": 0,
    "text": "به آواز گفت آن زمان شهریار"
  },
  {
    "poem_id": 1445,
    "vorder": 34,
    "position": 1,
    "text": "به گردان هشیار و مردان کار"
  },
  {
    "poem_id": 1445,
    "vorder": 35,
    "position": 0,
    "text": "که زین دیوتان سر چرا خیره شد"
  },
  {
    "poem_id": 1445,
    "vorder": 36,
    "position": 1,
    "text": "از آواز او رویتان تیره شد"
  },
  {
    "poem_id": 1445,
    "vorder": 37,
    "position": 0,
    "text": "ندادند پاسخ دلیران به شاه"
  },
  {
    "poem_id": 1445,
    "vorder": 38,
    "position": 1,
    "text": "ز جویان بپژمرد گفتی سپاه"
  },
  {
    "poem_id": 1445,
    "vorder": 39,
    "position": 0,
    "text": "یکی برگرایید رستم عنان"
  },
  {
    "poem_id": 1445,
    "vorder": 40,
    "position": 1,
    "text": "بر شاه شد تاب داده سنان"
  },
  {
    "poem_id": 1445,
    "vorder": 41,
    "position": 0,
    "text": "که دستور باشد مرا شهریار"
  },
  {
    "poem_id": 1445,
    "vorder": 42,
    "position": 1,
    "text": "شدن پیش این دیو ناسازگار"
  },
  {
    "poem_id": 1445,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت کاووس کاین کار تست"
  },
  {
    "poem_id": 1445,
    "vorder": 44,
    "position": 1,
    "text": "از ایران نخواهد کس این جنگ جست"
  },
  {
    "poem_id": 1445,
    "vorder": 45,
    "position": 0,
    "text": "چو بشنید ازو این سخن پهلوان"
  },
  {
    "poem_id": 1445,
    "vorder": 46,
    "position": 1,
    "text": "بیامد به کردار شیر ژیان"
  },
  {
    "poem_id": 1445,
    "vorder": 47,
    "position": 0,
    "text": "برانگیخت رخش دلاور ز جای"
  },
  {
    "poem_id": 1445,
    "vorder": 48,
    "position": 1,
    "text": "به چنگ اندرون نیزهٔ سر گرای"
  },
  {
    "poem_id": 1445,
    "vorder": 49,
    "position": 0,
    "text": "به آورد گه رفت چون پیل مست"
  },
  {
    "poem_id": 1445,
    "vorder": 50,
    "position": 1,
    "text": "یکی پیل زیر اژدهایی به دست"
  },
  {
    "poem_id": 1445,
    "vorder": 51,
    "position": 0,
    "text": "عنان را بپیچید و برخاست گرد"
  },
  {
    "poem_id": 1445,
    "vorder": 52,
    "position": 1,
    "text": "ز بانگش بلرزید دشت نبرد"
  },
  {
    "poem_id": 1445,
    "vorder": 53,
    "position": 0,
    "text": "به جویان چنین گفت کای بد نشان"
  },
  {
    "poem_id": 1445,
    "vorder": 54,
    "position": 1,
    "text": "بیفگنده نامت ز گردنکشان"
  },
  {
    "poem_id": 1445,
    "vorder": 55,
    "position": 0,
    "text": "کنون بر تو بر جای بخشایش است"
  },
  {
    "poem_id": 1445,
    "vorder": 56,
    "position": 1,
    "text": "نه هنگام آورد و آرامش است"
  },
  {
    "poem_id": 1445,
    "vorder": 57,
    "position": 0,
    "text": "بگرید ترا آنک زاینده بود"
  },
  {
    "poem_id": 1445,
    "vorder": 58,
    "position": 1,
    "text": "فزاینده بود ار گزاینده بود"
  },
  {
    "poem_id": 1445,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت جویان که ایمن مشو"
  },
  {
    "poem_id": 1445,
    "vorder": 60,
    "position": 1,
    "text": "ز جویان و از خنجر سرد رو"
  },
  {
    "poem_id": 1445,
    "vorder": 61,
    "position": 0,
    "text": "که اکنون به درد جگر مادرت"
  },
  {
    "poem_id": 1445,
    "vorder": 62,
    "position": 1,
    "text": "بگرید بدین جوشن و مغفرت"
  },
  {
    "poem_id": 1445,
    "vorder": 63,
    "position": 0,
    "text": "چو آواز جویان به رستم رسید"
  },
  {
    "poem_id": 1445,
    "vorder": 64,
    "position": 1,
    "text": "خروشی چو شیر ژیان برکشید"
  },
  {
    "poem_id": 1445,
    "vorder": 65,
    "position": 0,
    "text": "پس پشت او اندر آمد چو گرد"
  },
  {
    "poem_id": 1445,
    "vorder": 66,
    "position": 1,
    "text": "سنان بر کمربند او راست کرد"
  },
  {
    "poem_id": 1445,
    "vorder": 67,
    "position": 0,
    "text": "بزد نیزه بر بند درع و زره"
  },
  {
    "poem_id": 1445,
    "vorder": 68,
    "position": 1,
    "text": "زره را نماند ایچ بند و گره"
  },
  {
    "poem_id": 1445,
    "vorder": 69,
    "position": 0,
    "text": "ز زینش جدا کرد و برداشتش"
  },
  {
    "poem_id": 1445,
    "vorder": 70,
    "position": 1,
    "text": "چو بر بابزن مرغ برگاشتش"
  },
  {
    "poem_id": 1445,
    "vorder": 71,
    "position": 0,
    "text": "بینداخت از پشت اسپش به خاک"
  },
  {
    "poem_id": 1445,
    "vorder": 72,
    "position": 1,
    "text": "دهان پر ز خون و زره چاک چاک"
  },
  {
    "poem_id": 1445,
    "vorder": 73,
    "position": 0,
    "text": "دلیران و گردان مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 74,
    "position": 1,
    "text": "به خیره فرو ماندند اندران"
  },
  {
    "poem_id": 1445,
    "vorder": 75,
    "position": 0,
    "text": "سپه شد شکسته دل و زرد روی"
  },
  {
    "poem_id": 1445,
    "vorder": 76,
    "position": 1,
    "text": "برآمد ز آورد گه گفت و گوی"
  },
  {
    "poem_id": 1445,
    "vorder": 77,
    "position": 0,
    "text": "بفرمود سالار مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 78,
    "position": 1,
    "text": "به یکسر سپاه از کران تا کران"
  },
  {
    "poem_id": 1445,
    "vorder": 79,
    "position": 0,
    "text": "که یکسر بتازید و جنگ آورید"
  },
  {
    "poem_id": 1445,
    "vorder": 80,
    "position": 1,
    "text": "همه رسم و راه پلنگ آورید"
  },
  {
    "poem_id": 1445,
    "vorder": 81,
    "position": 0,
    "text": "برآمد ز هر دو سپه بوق و کوس"
  },
  {
    "poem_id": 1445,
    "vorder": 82,
    "position": 1,
    "text": "هوا نیلگون شد زمین آبنوس"
  },
  {
    "poem_id": 1445,
    "vorder": 83,
    "position": 0,
    "text": "چو برق درخشنده از تیره میغ"
  },
  {
    "poem_id": 1445,
    "vorder": 84,
    "position": 1,
    "text": "همی آتش افروخت از گرز و تیغ"
  },
  {
    "poem_id": 1445,
    "vorder": 85,
    "position": 0,
    "text": "هوا گشت سرخ و سیاه و بنفش"
  },
  {
    "poem_id": 1445,
    "vorder": 86,
    "position": 1,
    "text": "ز بس نیزه و گونه‌گونه درفش"
  },
  {
    "poem_id": 1445,
    "vorder": 87,
    "position": 0,
    "text": "زمین شد به کردار دریای قیر"
  },
  {
    "poem_id": 1445,
    "vorder": 88,
    "position": 1,
    "text": "همه موجش از خنجر و گرز و تیر"
  },
  {
    "poem_id": 1445,
    "vorder": 89,
    "position": 0,
    "text": "دوان باد پایان چو کشتی بر آب"
  },
  {
    "poem_id": 1445,
    "vorder": 90,
    "position": 1,
    "text": "سوی غرق دارند گویی شتاب"
  },
  {
    "poem_id": 1445,
    "vorder": 91,
    "position": 0,
    "text": "همی گرز بارید بر خود و ترگ"
  },
  {
    "poem_id": 1445,
    "vorder": 92,
    "position": 1,
    "text": "چو باد خزان بارد از بید برگ"
  },
  {
    "poem_id": 1445,
    "vorder": 93,
    "position": 0,
    "text": "به یک هفته دو لشکر نامجوی"
  },
  {
    "poem_id": 1445,
    "vorder": 94,
    "position": 1,
    "text": "به روی اندر آورده بودند روی"
  },
  {
    "poem_id": 1445,
    "vorder": 95,
    "position": 0,
    "text": "به هشتم جهاندار کاووس شاه"
  },
  {
    "poem_id": 1445,
    "vorder": 96,
    "position": 1,
    "text": "ز سر برگرفت آن کیانی کلاه"
  },
  {
    "poem_id": 1445,
    "vorder": 97,
    "position": 0,
    "text": "به پیش جهاندار گیهان خدای"
  },
  {
    "poem_id": 1445,
    "vorder": 98,
    "position": 1,
    "text": "بیامد همی بود گریان به پای"
  },
  {
    "poem_id": 1445,
    "vorder": 99,
    "position": 0,
    "text": "از آن پس بمالید بر خاک روی"
  },
  {
    "poem_id": 1445,
    "vorder": 100,
    "position": 1,
    "text": "چنین گفت کای داور راستگوی"
  },
  {
    "poem_id": 1445,
    "vorder": 101,
    "position": 0,
    "text": "برین نره دیوان بی‌بیم و باک"
  },
  {
    "poem_id": 1445,
    "vorder": 102,
    "position": 1,
    "text": "تویی آفرینندهٔ آب و خاک"
  },
  {
    "poem_id": 1445,
    "vorder": 103,
    "position": 0,
    "text": "مرا ده تو پیروزی و فرهی"
  },
  {
    "poem_id": 1445,
    "vorder": 104,
    "position": 1,
    "text": "به من تازه کن تخت شاهنشهی"
  },
  {
    "poem_id": 1445,
    "vorder": 105,
    "position": 0,
    "text": "بپوشید ازان پس به مغفر سرش"
  },
  {
    "poem_id": 1445,
    "vorder": 106,
    "position": 1,
    "text": "بیامد بر نامور لشکرش"
  },
  {
    "poem_id": 1445,
    "vorder": 107,
    "position": 0,
    "text": "خروش آمد و نالهٔ کرنای"
  },
  {
    "poem_id": 1445,
    "vorder": 108,
    "position": 1,
    "text": "بجنبید چون کوه لشکر ز جای"
  },
  {
    "poem_id": 1445,
    "vorder": 109,
    "position": 0,
    "text": "سپهبد بفرمود تا گیو و طوس"
  },
  {
    "poem_id": 1445,
    "vorder": 110,
    "position": 1,
    "text": "به پشت سپاه اندر آرند کوس"
  },
  {
    "poem_id": 1445,
    "vorder": 111,
    "position": 0,
    "text": "چو گودرز با زنگهٔ شاوران"
  },
  {
    "poem_id": 1445,
    "vorder": 112,
    "position": 1,
    "text": "چو رهام و گرگین جنگ‌آوران"
  },
  {
    "poem_id": 1445,
    "vorder": 113,
    "position": 0,
    "text": "گرازه همی شد بسان گراز"
  },
  {
    "poem_id": 1445,
    "vorder": 114,
    "position": 1,
    "text": "درفشی برافراخته هفت یاز"
  },
  {
    "poem_id": 1445,
    "vorder": 115,
    "position": 0,
    "text": "چو فرهاد و خراد و برزین و گیو"
  },
  {
    "poem_id": 1445,
    "vorder": 116,
    "position": 1,
    "text": "برفتند با نامداران نیو"
  },
  {
    "poem_id": 1445,
    "vorder": 117,
    "position": 0,
    "text": "تهمتن به قلب اندر آمد نخست"
  },
  {
    "poem_id": 1445,
    "vorder": 118,
    "position": 1,
    "text": "زمین را به خون دلیران بشست"
  },
  {
    "poem_id": 1445,
    "vorder": 119,
    "position": 0,
    "text": "چو گودرز کشواد بر میمنه"
  },
  {
    "poem_id": 1445,
    "vorder": 120,
    "position": 1,
    "text": "سلیح و سپه برد و کوس و بنه"
  },
  {
    "poem_id": 1445,
    "vorder": 121,
    "position": 0,
    "text": "ازان میمنه تا بدان میسره"
  },
  {
    "poem_id": 1445,
    "vorder": 122,
    "position": 1,
    "text": "بشد گیو چون گرگ پیش بره"
  },
  {
    "poem_id": 1445,
    "vorder": 123,
    "position": 0,
    "text": "ز شبگیر تا تیره شد آفتاب"
  },
  {
    "poem_id": 1445,
    "vorder": 124,
    "position": 1,
    "text": "همی خون به جوی اندر آمد چو آب"
  },
  {
    "poem_id": 1445,
    "vorder": 125,
    "position": 0,
    "text": "ز چهره بشد شرم و آیین مهر"
  },
  {
    "poem_id": 1445,
    "vorder": 126,
    "position": 1,
    "text": "همی گرز بارید گفتی سپهر"
  },
  {
    "poem_id": 1445,
    "vorder": 127,
    "position": 0,
    "text": "ز کشته به هر جای بر توده گشت"
  },
  {
    "poem_id": 1445,
    "vorder": 128,
    "position": 1,
    "text": "گیاها به مغز سر آلوده گشت"
  },
  {
    "poem_id": 1445,
    "vorder": 129,
    "position": 0,
    "text": "چو رعد خروشنده شد بوق و کوس"
  },
  {
    "poem_id": 1445,
    "vorder": 130,
    "position": 1,
    "text": "خور اندر پس پردهٔ آبنوس"
  },
  {
    "poem_id": 1445,
    "vorder": 131,
    "position": 0,
    "text": "ازان سو که بد شاه مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 132,
    "position": 1,
    "text": "بشد پیلتن با سپاهی گران"
  },
  {
    "poem_id": 1445,
    "vorder": 133,
    "position": 0,
    "text": "زمانی نکرد او یله جای خویش"
  },
  {
    "poem_id": 1445,
    "vorder": 134,
    "position": 1,
    "text": "بیفشارد بر کینه گه پای خویش"
  },
  {
    "poem_id": 1445,
    "vorder": 135,
    "position": 0,
    "text": "چو دیوان و پیلان پرخاشجوی"
  },
  {
    "poem_id": 1445,
    "vorder": 136,
    "position": 1,
    "text": "بروی اندر آورده بودند روی"
  },
  {
    "poem_id": 1445,
    "vorder": 137,
    "position": 0,
    "text": "جهانجوی کرد از جهاندار یاد"
  },
  {
    "poem_id": 1445,
    "vorder": 138,
    "position": 1,
    "text": "سنان‌دار نیزه به دارنده داد"
  },
  {
    "poem_id": 1445,
    "vorder": 139,
    "position": 0,
    "text": "برآهیخت گرز و برآورد جوش"
  },
  {
    "poem_id": 1445,
    "vorder": 140,
    "position": 1,
    "text": "هوا گشت از آواز او پرخروش"
  },
  {
    "poem_id": 1445,
    "vorder": 141,
    "position": 0,
    "text": "برآورد آن گرد سالار کش"
  },
  {
    "poem_id": 1445,
    "vorder": 142,
    "position": 1,
    "text": "نه با دیو جان و نه با پیل هش"
  },
  {
    "poem_id": 1445,
    "vorder": 143,
    "position": 0,
    "text": "فگنده همه دشت خرطوم پیل"
  },
  {
    "poem_id": 1445,
    "vorder": 144,
    "position": 1,
    "text": "همه کشته دیدند بر چند میل"
  },
  {
    "poem_id": 1445,
    "vorder": 145,
    "position": 0,
    "text": "ازان پس تهمتن یکی نیزه خواست"
  },
  {
    "poem_id": 1445,
    "vorder": 146,
    "position": 1,
    "text": "سوی شاه مازندران تاخت راست"
  },
  {
    "poem_id": 1445,
    "vorder": 147,
    "position": 0,
    "text": "چو بر نیزهٔ رستم افگند چشم"
  },
  {
    "poem_id": 1445,
    "vorder": 148,
    "position": 1,
    "text": "نماند ایچ با او دلیری و خشم"
  },
  {
    "poem_id": 1445,
    "vorder": 149,
    "position": 0,
    "text": "یکی نیزه زد بر کمربند اوی"
  },
  {
    "poem_id": 1445,
    "vorder": 150,
    "position": 1,
    "text": "ز گبر اندر آمد به پیوند اوی"
  },
  {
    "poem_id": 1445,
    "vorder": 151,
    "position": 0,
    "text": "شد از جادویی تنش یک لخت کوه"
  },
  {
    "poem_id": 1445,
    "vorder": 152,
    "position": 1,
    "text": "از ایران بروبر نظاره گروه"
  },
  {
    "poem_id": 1445,
    "vorder": 153,
    "position": 0,
    "text": "تهمتن فرو ماند اندر شگفت"
  },
  {
    "poem_id": 1445,
    "vorder": 154,
    "position": 1,
    "text": "سناندار نیزه به گردن گرفت"
  },
  {
    "poem_id": 1445,
    "vorder": 155,
    "position": 0,
    "text": "رسید اندر آن جای کاووس شاه"
  },
  {
    "poem_id": 1445,
    "vorder": 156,
    "position": 1,
    "text": "ابا پیل و کوس و درفش و سپاه"
  },
  {
    "poem_id": 1445,
    "vorder": 157,
    "position": 0,
    "text": "به رستم چنین گفت کای سرفراز"
  },
  {
    "poem_id": 1445,
    "vorder": 158,
    "position": 1,
    "text": "چه بودت که ایدر بماندی دراز"
  },
  {
    "poem_id": 1445,
    "vorder": 159,
    "position": 0,
    "text": "بدو گفت رستم که چون رزم سخت"
  },
  {
    "poem_id": 1445,
    "vorder": 160,
    "position": 1,
    "text": "ببود و بیفروخت پیروز بخت"
  },
  {
    "poem_id": 1445,
    "vorder": 161,
    "position": 0,
    "text": "مرا دید چون شاه مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 162,
    "position": 1,
    "text": "به گردن برآورده گرز گران"
  },
  {
    "poem_id": 1445,
    "vorder": 163,
    "position": 0,
    "text": "به رخش دلاور سپردم عنان"
  },
  {
    "poem_id": 1445,
    "vorder": 164,
    "position": 1,
    "text": "زدم بر کمربند گبرش سنان"
  },
  {
    "poem_id": 1445,
    "vorder": 165,
    "position": 0,
    "text": "گمانم چنان بد که او شد نگون"
  },
  {
    "poem_id": 1445,
    "vorder": 166,
    "position": 1,
    "text": "کنون آید از کوههٔ زین برون"
  },
  {
    "poem_id": 1445,
    "vorder": 167,
    "position": 0,
    "text": "بر این گونه شد سنگ در پیش من"
  },
  {
    "poem_id": 1445,
    "vorder": 168,
    "position": 1,
    "text": "نبود آگه از رای کم بیش من"
  },
  {
    "poem_id": 1445,
    "vorder": 169,
    "position": 0,
    "text": "برین گونه خارا یکی کوه گشت"
  },
  {
    "poem_id": 1445,
    "vorder": 170,
    "position": 1,
    "text": "ز جنگ و ز مردی بی‌اندوه گشت"
  },
  {
    "poem_id": 1445,
    "vorder": 171,
    "position": 0,
    "text": "به لشکر گهش برد باید کنون"
  },
  {
    "poem_id": 1445,
    "vorder": 172,
    "position": 1,
    "text": "مگر کاید از سنگ خارا برون"
  },
  {
    "poem_id": 1445,
    "vorder": 173,
    "position": 0,
    "text": "ز لشکر هر آن کس که بد زورمند"
  },
  {
    "poem_id": 1445,
    "vorder": 174,
    "position": 1,
    "text": "بسودند چنگ آزمودند بند"
  },
  {
    "poem_id": 1445,
    "vorder": 175,
    "position": 0,
    "text": "نه برخاست از جای سنگ گران"
  },
  {
    "poem_id": 1445,
    "vorder": 176,
    "position": 1,
    "text": "میان اندرون شاه مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 177,
    "position": 0,
    "text": "گو پیلتن کرد چنگال باز"
  },
  {
    "poem_id": 1445,
    "vorder": 178,
    "position": 1,
    "text": "بران آزمایش نبودش نیاز"
  },
  {
    "poem_id": 1445,
    "vorder": 179,
    "position": 0,
    "text": "بران گونه آن سنگ را برگرفت"
  },
  {
    "poem_id": 1445,
    "vorder": 180,
    "position": 1,
    "text": "کزو ماند لشکر سراسر شگفت"
  },
  {
    "poem_id": 1445,
    "vorder": 181,
    "position": 0,
    "text": "ابر کردگار آفرین خواندند"
  },
  {
    "poem_id": 1445,
    "vorder": 182,
    "position": 1,
    "text": "برو زر و گوهر برافشاندند"
  },
  {
    "poem_id": 1445,
    "vorder": 183,
    "position": 0,
    "text": "به پیش سراپردهٔ شاه برد"
  },
  {
    "poem_id": 1445,
    "vorder": 184,
    "position": 1,
    "text": "بیفگند و ایرانیان را سپرد"
  },
  {
    "poem_id": 1445,
    "vorder": 185,
    "position": 0,
    "text": "بدو گفت ار ایدونک پیدا شوی"
  },
  {
    "poem_id": 1445,
    "vorder": 186,
    "position": 1,
    "text": "به گردی ازین تنبل و جادوی"
  },
  {
    "poem_id": 1445,
    "vorder": 187,
    "position": 0,
    "text": "وگرنه به گرز و به تیغ و تبر"
  },
  {
    "poem_id": 1445,
    "vorder": 188,
    "position": 1,
    "text": "ببرم همه سنگ را سر به سر"
  },
  {
    "poem_id": 1445,
    "vorder": 189,
    "position": 0,
    "text": "چو بشنید شد چون یکی پاره ابر"
  },
  {
    "poem_id": 1445,
    "vorder": 190,
    "position": 1,
    "text": "به سر برش پولاد و بر تنش گبر"
  },
  {
    "poem_id": 1445,
    "vorder": 191,
    "position": 0,
    "text": "تهمتن گرفت آن زمان دست اوی"
  },
  {
    "poem_id": 1445,
    "vorder": 192,
    "position": 1,
    "text": "بخندید و زی شاه بنهاد روی"
  },
  {
    "poem_id": 1445,
    "vorder": 193,
    "position": 0,
    "text": "چنین گفت کاوردم ان لخت کوه"
  },
  {
    "poem_id": 1445,
    "vorder": 194,
    "position": 1,
    "text": "ز بیم تبر شد به چنگم ستوه"
  },
  {
    "poem_id": 1445,
    "vorder": 195,
    "position": 0,
    "text": "برویش نگه کرد کاووس شاه"
  },
  {
    "poem_id": 1445,
    "vorder": 196,
    "position": 1,
    "text": "ندیدش سزاوار تخت و کلاه"
  },
  {
    "poem_id": 1445,
    "vorder": 197,
    "position": 0,
    "text": "وزان رنجهای کهن یاد کرد"
  },
  {
    "poem_id": 1445,
    "vorder": 198,
    "position": 1,
    "text": "دلش خسته شد سر پر از باد کرد"
  },
  {
    "poem_id": 1445,
    "vorder": 199,
    "position": 0,
    "text": "به دژخیم فرمود تا تیغ تیز"
  },
  {
    "poem_id": 1445,
    "vorder": 200,
    "position": 1,
    "text": "بگیرد کند تنش را ریز ریز"
  },
  {
    "poem_id": 1445,
    "vorder": 201,
    "position": 0,
    "text": "به لشکر گهش کس فرستاد زود"
  },
  {
    "poem_id": 1445,
    "vorder": 202,
    "position": 1,
    "text": "بفرمود تا خواسته هرچ بود"
  },
  {
    "poem_id": 1445,
    "vorder": 203,
    "position": 0,
    "text": "ز گنج و ز تخت و ز در و گهر"
  },
  {
    "poem_id": 1445,
    "vorder": 204,
    "position": 1,
    "text": "ز اسپ و سلیح و کلاه و کمر"
  },
  {
    "poem_id": 1445,
    "vorder": 205,
    "position": 0,
    "text": "نهادند هرجای چون کوه کوه"
  },
  {
    "poem_id": 1445,
    "vorder": 206,
    "position": 1,
    "text": "برفتند لشکر همه هم گروه"
  },
  {
    "poem_id": 1445,
    "vorder": 207,
    "position": 0,
    "text": "سزاوار هرکس ببخشید گنج"
  },
  {
    "poem_id": 1445,
    "vorder": 208,
    "position": 1,
    "text": "به ویژه کسی کش فزون بود رنج"
  },
  {
    "poem_id": 1445,
    "vorder": 209,
    "position": 0,
    "text": "ز دیوان هرآنکس که بد ناسپاس"
  },
  {
    "poem_id": 1445,
    "vorder": 210,
    "position": 1,
    "text": "وز ایشان دل انجمن پرهراس"
  },
  {
    "poem_id": 1445,
    "vorder": 211,
    "position": 0,
    "text": "بفرمودشان تا بریدند سر"
  },
  {
    "poem_id": 1445,
    "vorder": 212,
    "position": 1,
    "text": "فگندند جایی که بد رهگذر"
  },
  {
    "poem_id": 1445,
    "vorder": 213,
    "position": 0,
    "text": "وز آن پس بیامد به جای نماز"
  },
  {
    "poem_id": 1445,
    "vorder": 214,
    "position": 1,
    "text": "همی گفت با داور پاک راز"
  },
  {
    "poem_id": 1445,
    "vorder": 215,
    "position": 0,
    "text": "به یک هفته بر پیش یزدان پاک"
  },
  {
    "poem_id": 1445,
    "vorder": 216,
    "position": 1,
    "text": "همی با نیایش بپیمود خاک"
  },
  {
    "poem_id": 1445,
    "vorder": 217,
    "position": 0,
    "text": "بهشتم در گنجها کرد باز"
  },
  {
    "poem_id": 1445,
    "vorder": 218,
    "position": 1,
    "text": "ببخشید بر هرکه بودش نیاز"
  },
  {
    "poem_id": 1445,
    "vorder": 219,
    "position": 0,
    "text": "همی گشت یک هفته زین گونه نیز"
  },
  {
    "poem_id": 1445,
    "vorder": 220,
    "position": 1,
    "text": "ببخشید آن را که بایست چیز"
  },
  {
    "poem_id": 1445,
    "vorder": 221,
    "position": 0,
    "text": "سیم هفته چون کارها گشت راست"
  },
  {
    "poem_id": 1445,
    "vorder": 222,
    "position": 1,
    "text": "می و جام یاقوت و میخواره خواست"
  },
  {
    "poem_id": 1445,
    "vorder": 223,
    "position": 0,
    "text": "به یک هفته با ویژگان می به چنگ"
  },
  {
    "poem_id": 1445,
    "vorder": 224,
    "position": 1,
    "text": "به مازندران کرد زان پس درنگ"
  },
  {
    "poem_id": 1445,
    "vorder": 225,
    "position": 0,
    "text": "تهمتن چنین گفت با شهریار"
  },
  {
    "poem_id": 1445,
    "vorder": 226,
    "position": 1,
    "text": "که هرگونه‌ای مردم آید به کار"
  },
  {
    "poem_id": 1445,
    "vorder": 227,
    "position": 0,
    "text": "مرا این هنرها ز اولاد خاست"
  },
  {
    "poem_id": 1445,
    "vorder": 228,
    "position": 1,
    "text": "که بر هر سویی راه بنمود راست"
  },
  {
    "poem_id": 1445,
    "vorder": 229,
    "position": 0,
    "text": "به مازندران دارد اکنون امید"
  },
  {
    "poem_id": 1445,
    "vorder": 230,
    "position": 1,
    "text": "چنین دادمش راستی را نوید"
  },
  {
    "poem_id": 1445,
    "vorder": 231,
    "position": 0,
    "text": "کنون خلعت شاه باید نخست"
  },
  {
    "poem_id": 1445,
    "vorder": 232,
    "position": 1,
    "text": "یکی عهد و مهری بروبر درست"
  },
  {
    "poem_id": 1445,
    "vorder": 233,
    "position": 0,
    "text": "که تا زنده باشد به مازندران"
  },
  {
    "poem_id": 1445,
    "vorder": 234,
    "position": 1,
    "text": "پرستش کنندش همه مهتران"
  },
  {
    "poem_id": 1445,
    "vorder": 235,
    "position": 0,
    "text": "چو بشنید گفتار خسرو پرست"
  },
  {
    "poem_id": 1445,
    "vorder": 236,
    "position": 1,
    "text": "به بر زد جهاندار بیدار دست"
  },
  {
    "poem_id": 1445,
    "vorder": 237,
    "position": 0,
    "text": "سپرد آن زمان تخت شاهی بدوی"
  },
  {
    "poem_id": 1445,
    "vorder": 238,
    "position": 1,
    "text": "وزانجا سوی پارس بنهاد روی"
  }
]