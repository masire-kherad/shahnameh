[
  {
    "poem_id": 1468,
    "vorder": 1,
    "position": 0,
    "text": "گرازان به درگاه شاه آمدند"
  },
  {
    "poem_id": 1468,
    "vorder": 2,
    "position": 1,
    "text": "گشاده دل و نیک خواه آمدند"
  },
  {
    "poem_id": 1468,
    "vorder": 3,
    "position": 0,
    "text": "چو رفتند و بردند پیشش نماز"
  },
  {
    "poem_id": 1468,
    "vorder": 4,
    "position": 1,
    "text": "برآشفت و پاسخ نداد ایچ باز"
  },
  {
    "poem_id": 1468,
    "vorder": 5,
    "position": 0,
    "text": "یکی بانگ برزد به گیو از نخست"
  },
  {
    "poem_id": 1468,
    "vorder": 6,
    "position": 1,
    "text": "پس آنگاه شرم از دو دیده بشست"
  },
  {
    "poem_id": 1468,
    "vorder": 7,
    "position": 0,
    "text": "که رستم که باشد که فرمان من"
  },
  {
    "poem_id": 1468,
    "vorder": 8,
    "position": 1,
    "text": "کند پست و پیچد ز پیمان من"
  },
  {
    "poem_id": 1468,
    "vorder": 9,
    "position": 0,
    "text": "بگیر و ببر زنده بر دار کن"
  },
  {
    "poem_id": 1468,
    "vorder": 10,
    "position": 1,
    "text": "وزو نیز با من مگردان سخن"
  },
  {
    "poem_id": 1468,
    "vorder": 11,
    "position": 0,
    "text": "ز گفتار او گیو را دل بخست"
  },
  {
    "poem_id": 1468,
    "vorder": 12,
    "position": 1,
    "text": "که بردی به رستم بر آن‌گونه دست"
  },
  {
    "poem_id": 1468,
    "vorder": 13,
    "position": 0,
    "text": "برآشفت با گیو و با پیلتن"
  },
  {
    "poem_id": 1468,
    "vorder": 14,
    "position": 1,
    "text": "فرو ماند خیره همه انجمن"
  },
  {
    "poem_id": 1468,
    "vorder": 15,
    "position": 0,
    "text": "بفرمود پس طوس را شهریار"
  },
  {
    "poem_id": 1468,
    "vorder": 16,
    "position": 1,
    "text": "که رو هردو را زنده برکن به دار"
  },
  {
    "poem_id": 1468,
    "vorder": 17,
    "position": 0,
    "text": "خود از جای برخاست کاووس کی"
  },
  {
    "poem_id": 1468,
    "vorder": 18,
    "position": 1,
    "text": "برافروخت برسان آتش ز نی"
  },
  {
    "poem_id": 1468,
    "vorder": 19,
    "position": 0,
    "text": "بشد طوس و دست تهمتن گرفت"
  },
  {
    "poem_id": 1468,
    "vorder": 20,
    "position": 1,
    "text": "بدو مانده پرخاش جویان شگفت"
  },
  {
    "poem_id": 1468,
    "vorder": 21,
    "position": 0,
    "text": "که از پیش کاووس بیرون برد"
  },
  {
    "poem_id": 1468,
    "vorder": 22,
    "position": 1,
    "text": "مگر کاندر آن تیزی افسون برد"
  },
  {
    "poem_id": 1468,
    "vorder": 23,
    "position": 0,
    "text": "تهمتن برآشفت با شهریار"
  },
  {
    "poem_id": 1468,
    "vorder": 24,
    "position": 1,
    "text": "که چندین مدار آتش اندر کنار"
  },
  {
    "poem_id": 1468,
    "vorder": 25,
    "position": 0,
    "text": "همه کارت از یکدگر بدترست"
  },
  {
    "poem_id": 1468,
    "vorder": 26,
    "position": 1,
    "text": "ترا شهریاری نه اندرخَورست"
  },
  {
    "poem_id": 1468,
    "vorder": 27,
    "position": 0,
    "text": "تو سهراب را زنده بر دار کن"
  },
  {
    "poem_id": 1468,
    "vorder": 28,
    "position": 1,
    "text": "پرآشوب و بدخواه را خوار کن"
  },
  {
    "poem_id": 1468,
    "vorder": 29,
    "position": 0,
    "text": "بزد تند یک دست بر دست طوس"
  },
  {
    "poem_id": 1468,
    "vorder": 30,
    "position": 1,
    "text": "تو گفتی ز پیل ژیان یافت کوس"
  },
  {
    "poem_id": 1468,
    "vorder": 31,
    "position": 0,
    "text": "ز بالا نگون اندرآمد به سر"
  },
  {
    "poem_id": 1468,
    "vorder": 32,
    "position": 1,
    "text": "برو کرد رستم به تندی گذر"
  },
  {
    "poem_id": 1468,
    "vorder": 33,
    "position": 0,
    "text": "به در شد به خشم اندرآمد به رخش"
  },
  {
    "poem_id": 1468,
    "vorder": 34,
    "position": 1,
    "text": "منم گفت شیراوژن و تاج‌بخش"
  },
  {
    "poem_id": 1468,
    "vorder": 35,
    "position": 0,
    "text": "چو خشم آورم شاه کاووس کیست"
  },
  {
    "poem_id": 1468,
    "vorder": 36,
    "position": 1,
    "text": "چرا دست یازد به من طوس کیست"
  },
  {
    "poem_id": 1468,
    "vorder": 37,
    "position": 0,
    "text": "زمین بنده و رخش گاه من‌ست"
  },
  {
    "poem_id": 1468,
    "vorder": 38,
    "position": 1,
    "text": "نگین گرز و مغفر کلاه من‌ست"
  },
  {
    "poem_id": 1468,
    "vorder": 39,
    "position": 0,
    "text": "شب تیره از تیغ رخشان کنم"
  },
  {
    "poem_id": 1468,
    "vorder": 40,
    "position": 1,
    "text": "به آورد گه بر سر افشان کنم"
  },
  {
    "poem_id": 1468,
    "vorder": 41,
    "position": 0,
    "text": "سر نیزه و تیغ یار من‌اند"
  },
  {
    "poem_id": 1468,
    "vorder": 42,
    "position": 1,
    "text": "دو بازو و دل شهریار من‌اند"
  },
  {
    "poem_id": 1468,
    "vorder": 43,
    "position": 0,
    "text": "چه آزاردم او نه من بنده‌ام"
  },
  {
    "poem_id": 1468,
    "vorder": 44,
    "position": 1,
    "text": "یکی بندهٔ آفریننده‌ام"
  },
  {
    "poem_id": 1468,
    "vorder": 45,
    "position": 0,
    "text": "به ایران ار ایدون که سهراب گرد"
  },
  {
    "poem_id": 1468,
    "vorder": 46,
    "position": 1,
    "text": "بیاید نماند بزرگ و نه خرد"
  },
  {
    "poem_id": 1468,
    "vorder": 47,
    "position": 0,
    "text": "شما هر کسی چارهٔ جان کنید"
  },
  {
    "poem_id": 1468,
    "vorder": 48,
    "position": 1,
    "text": "خرد را بدین کار پیچان کنید"
  },
  {
    "poem_id": 1468,
    "vorder": 49,
    "position": 0,
    "text": "به ایران نبینید ازین پس مرا"
  },
  {
    "poem_id": 1468,
    "vorder": 50,
    "position": 1,
    "text": "شما را زمین، پَرّ کرگس مرا"
  },
  {
    "poem_id": 1468,
    "vorder": 51,
    "position": 0,
    "text": "غمی شد دل نامداران همه"
  },
  {
    "poem_id": 1468,
    "vorder": 52,
    "position": 1,
    "text": "که رستم شبان بود و ایشان رمه"
  },
  {
    "poem_id": 1468,
    "vorder": 53,
    "position": 0,
    "text": "به گودرز گفتند کاین کار تست"
  },
  {
    "poem_id": 1468,
    "vorder": 54,
    "position": 1,
    "text": "شکسته به دست تو گردد درست"
  },
  {
    "poem_id": 1468,
    "vorder": 55,
    "position": 0,
    "text": "سپهبد جز از تو سخن نشنود"
  },
  {
    "poem_id": 1468,
    "vorder": 56,
    "position": 1,
    "text": "همی بخت تو زین سخن نغنود"
  },
  {
    "poem_id": 1468,
    "vorder": 57,
    "position": 0,
    "text": "به نزدیک این شاه دیوانه رو"
  },
  {
    "poem_id": 1468,
    "vorder": 58,
    "position": 1,
    "text": "وزین در سخن یاد کن نو به نو"
  },
  {
    "poem_id": 1468,
    "vorder": 59,
    "position": 0,
    "text": "سخنهای چرب و دراز آوری"
  },
  {
    "poem_id": 1468,
    "vorder": 60,
    "position": 1,
    "text": "مگر بخت گم بوده بازآوری"
  },
  {
    "poem_id": 1468,
    "vorder": 61,
    "position": 0,
    "text": "سپهدار گودرز کشواد رفت"
  },
  {
    "poem_id": 1468,
    "vorder": 62,
    "position": 1,
    "text": "به نزدیک خسرو خرامید تفت"
  },
  {
    "poem_id": 1468,
    "vorder": 63,
    "position": 0,
    "text": "به کاووس کی گفت رستم چه کرد"
  },
  {
    "poem_id": 1468,
    "vorder": 64,
    "position": 1,
    "text": "کز ایران برآوردی امروز گرد"
  },
  {
    "poem_id": 1468,
    "vorder": 65,
    "position": 0,
    "text": "فراموش کردی ز هاماوران"
  },
  {
    "poem_id": 1468,
    "vorder": 66,
    "position": 1,
    "text": "وزان کار دیوان مازندران"
  },
  {
    "poem_id": 1468,
    "vorder": 67,
    "position": 0,
    "text": "که گویی ورا زنده بر دار کن"
  },
  {
    "poem_id": 1468,
    "vorder": 68,
    "position": 1,
    "text": "ز شاهان نباید گزافه سخن"
  },
  {
    "poem_id": 1468,
    "vorder": 69,
    "position": 0,
    "text": "چو او رفت و آمد سپاهی بزرگ"
  },
  {
    "poem_id": 1468,
    "vorder": 70,
    "position": 1,
    "text": "یکی پهلوانی به کردار گرگ"
  },
  {
    "poem_id": 1468,
    "vorder": 71,
    "position": 0,
    "text": "که داری که با او به دشت نبرد"
  },
  {
    "poem_id": 1468,
    "vorder": 72,
    "position": 1,
    "text": "شود برفشاند برو تیره گرد"
  },
  {
    "poem_id": 1468,
    "vorder": 73,
    "position": 0,
    "text": "یلان ترا سر به سر گژدهم"
  },
  {
    "poem_id": 1468,
    "vorder": 74,
    "position": 1,
    "text": "شنیده‌ست و دیده‌ست از بیش و کم"
  },
  {
    "poem_id": 1468,
    "vorder": 75,
    "position": 0,
    "text": "همی گوید آن روز هرگز مباد"
  },
  {
    "poem_id": 1468,
    "vorder": 76,
    "position": 1,
    "text": "که با او سواری کند رزم یاد"
  },
  {
    "poem_id": 1468,
    "vorder": 77,
    "position": 0,
    "text": "کسی را که جنگی چو رستم بود"
  },
  {
    "poem_id": 1468,
    "vorder": 78,
    "position": 1,
    "text": "بیازارد او را خرد کم بود"
  },
  {
    "poem_id": 1468,
    "vorder": 79,
    "position": 0,
    "text": "چو بشنید گفتار گودرز شاه"
  },
  {
    "poem_id": 1468,
    "vorder": 80,
    "position": 1,
    "text": "بدانست کاو دارد آیین و راه"
  },
  {
    "poem_id": 1468,
    "vorder": 81,
    "position": 0,
    "text": "پشیمان بشد زان کجا گفته بود"
  },
  {
    "poem_id": 1468,
    "vorder": 82,
    "position": 1,
    "text": "به بیهودگی مغزش آشفته بود"
  },
  {
    "poem_id": 1468,
    "vorder": 83,
    "position": 0,
    "text": "به گودرز گفت این سخن درخورست"
  },
  {
    "poem_id": 1468,
    "vorder": 84,
    "position": 1,
    "text": "لب پیر با پند نیکوترست"
  },
  {
    "poem_id": 1468,
    "vorder": 85,
    "position": 0,
    "text": "خردمند باید دل پادشا"
  },
  {
    "poem_id": 1468,
    "vorder": 86,
    "position": 1,
    "text": "که تیزی و تندی نیارد بها"
  },
  {
    "poem_id": 1468,
    "vorder": 87,
    "position": 0,
    "text": "شما را بباید برِ او شدن"
  },
  {
    "poem_id": 1468,
    "vorder": 88,
    "position": 1,
    "text": "به خوبی بسی داستانها زدن"
  },
  {
    "poem_id": 1468,
    "vorder": 89,
    "position": 0,
    "text": "سرش کردن از تیزی من تهی"
  },
  {
    "poem_id": 1468,
    "vorder": 90,
    "position": 1,
    "text": "نمودن بدو روزگار بهی"
  },
  {
    "poem_id": 1468,
    "vorder": 91,
    "position": 0,
    "text": "چو گودرز برخاست از پیش اوی"
  },
  {
    "poem_id": 1468,
    "vorder": 92,
    "position": 1,
    "text": "پس پهلوان تیز بنهاد روی"
  },
  {
    "poem_id": 1468,
    "vorder": 93,
    "position": 0,
    "text": "برفتند با او سران سپاه"
  },
  {
    "poem_id": 1468,
    "vorder": 94,
    "position": 1,
    "text": "پس رستم اندر گرفتند راه"
  },
  {
    "poem_id": 1468,
    "vorder": 95,
    "position": 0,
    "text": "چو دیدند گرد گو پیلتن"
  },
  {
    "poem_id": 1468,
    "vorder": 96,
    "position": 1,
    "text": "همه نامداران شدند انجمن"
  },
  {
    "poem_id": 1468,
    "vorder": 97,
    "position": 0,
    "text": "ستایش گرفتند بر پهلوان"
  },
  {
    "poem_id": 1468,
    "vorder": 98,
    "position": 1,
    "text": "که جاوید بادی و روشن‌روان"
  },
  {
    "poem_id": 1468,
    "vorder": 99,
    "position": 0,
    "text": "جهان سر به سر زیر پای تو باد"
  },
  {
    "poem_id": 1468,
    "vorder": 100,
    "position": 1,
    "text": "همیشه سر تخت جای تو باد"
  },
  {
    "poem_id": 1468,
    "vorder": 101,
    "position": 0,
    "text": "تو دانی که کاووس را مغز نیست"
  },
  {
    "poem_id": 1468,
    "vorder": 102,
    "position": 1,
    "text": "به تیزی سخن گفتنش نغز نیست"
  },
  {
    "poem_id": 1468,
    "vorder": 103,
    "position": 0,
    "text": "بجوشد همانگه پشیمان شود"
  },
  {
    "poem_id": 1468,
    "vorder": 104,
    "position": 1,
    "text": "به خوبی ز سر باز پیمان شود"
  },
  {
    "poem_id": 1468,
    "vorder": 105,
    "position": 0,
    "text": "تهمتن گر آزرده گردد ز شاه"
  },
  {
    "poem_id": 1468,
    "vorder": 106,
    "position": 1,
    "text": "هم ایرانیان را نباشد گناه"
  },
  {
    "poem_id": 1468,
    "vorder": 107,
    "position": 0,
    "text": "هم او زان سخنها پشیمان شده‌ست"
  },
  {
    "poem_id": 1468,
    "vorder": 108,
    "position": 1,
    "text": "ز تندی بخاید همی پشت دست"
  },
  {
    "poem_id": 1468,
    "vorder": 109,
    "position": 0,
    "text": "تهمتن چنین پاسخ آورد باز"
  },
  {
    "poem_id": 1468,
    "vorder": 110,
    "position": 1,
    "text": "که هستم ز کاووس کی بی‌نیاز"
  },
  {
    "poem_id": 1468,
    "vorder": 111,
    "position": 0,
    "text": "مرا تخت زین باشد و تاج ترگ"
  },
  {
    "poem_id": 1468,
    "vorder": 112,
    "position": 1,
    "text": "قبا جوشن و دل نهاده به مرگ"
  },
  {
    "poem_id": 1468,
    "vorder": 113,
    "position": 0,
    "text": "چرا دارم از خشم کاووس باک"
  },
  {
    "poem_id": 1468,
    "vorder": 114,
    "position": 1,
    "text": "چه کاووس پیشم چه یک مشت خاک"
  },
  {
    "poem_id": 1468,
    "vorder": 115,
    "position": 0,
    "text": "سرم گشت سیر و دلم کرد بس"
  },
  {
    "poem_id": 1468,
    "vorder": 116,
    "position": 1,
    "text": "جز از پاک یزدان نترسم ز کس"
  },
  {
    "poem_id": 1468,
    "vorder": 117,
    "position": 0,
    "text": "ز گفتار چون سیر گشت انجمن"
  },
  {
    "poem_id": 1468,
    "vorder": 118,
    "position": 1,
    "text": "چنین گفت گودرز با پیلتن"
  },
  {
    "poem_id": 1468,
    "vorder": 119,
    "position": 0,
    "text": "که شهر و دلیران و لشکر گمان"
  },
  {
    "poem_id": 1468,
    "vorder": 120,
    "position": 1,
    "text": "به دیگر سخنها برند این زمان"
  },
  {
    "poem_id": 1468,
    "vorder": 121,
    "position": 0,
    "text": "کزین ترک ترسنده شد سرفراز"
  },
  {
    "poem_id": 1468,
    "vorder": 122,
    "position": 1,
    "text": "همی رفت زین گونه چندی به راز"
  },
  {
    "poem_id": 1468,
    "vorder": 123,
    "position": 0,
    "text": "که چونان که گژدهم داد آگهی"
  },
  {
    "poem_id": 1468,
    "vorder": 124,
    "position": 1,
    "text": "همه بوم و بر کرد باید تهی"
  },
  {
    "poem_id": 1468,
    "vorder": 125,
    "position": 0,
    "text": "چو رستم همی زو بترسد به جنگ"
  },
  {
    "poem_id": 1468,
    "vorder": 126,
    "position": 1,
    "text": "مرا و ترا نیست جای درنگ"
  },
  {
    "poem_id": 1468,
    "vorder": 127,
    "position": 0,
    "text": "از آشفتن شاه و پیگار اوی"
  },
  {
    "poem_id": 1468,
    "vorder": 128,
    "position": 1,
    "text": "بدیدم به درگاه بر گفت‌وگوی"
  },
  {
    "poem_id": 1468,
    "vorder": 129,
    "position": 0,
    "text": "ز سهراب یل رفت یکسر سخن"
  },
  {
    "poem_id": 1468,
    "vorder": 130,
    "position": 1,
    "text": "چنین پشت بر شاه ایران مکن"
  },
  {
    "poem_id": 1468,
    "vorder": 131,
    "position": 0,
    "text": "چنین بر شده نامت اندر جهان"
  },
  {
    "poem_id": 1468,
    "vorder": 132,
    "position": 1,
    "text": "بدین بازگشتن مگردان نهان"
  },
  {
    "poem_id": 1468,
    "vorder": 133,
    "position": 0,
    "text": "و دیگر که تنگ اندرآمد سپاه"
  },
  {
    "poem_id": 1468,
    "vorder": 134,
    "position": 1,
    "text": "مکن تیره بر خیره این تاج و گاه"
  },
  {
    "poem_id": 1468,
    "vorder": 135,
    "position": 0,
    "text": "به رستم بر این داستانها بخواند"
  },
  {
    "poem_id": 1468,
    "vorder": 136,
    "position": 1,
    "text": "تهمتن چو بشنید خیره بماند"
  },
  {
    "poem_id": 1468,
    "vorder": 137,
    "position": 0,
    "text": "بدو گفت اگر بیم دارد دلم"
  },
  {
    "poem_id": 1468,
    "vorder": 138,
    "position": 1,
    "text": "نخواهم که باشد ز تن بگسلم"
  },
  {
    "poem_id": 1468,
    "vorder": 139,
    "position": 0,
    "text": "ازین ننگ برگشت و آمد به راه"
  },
  {
    "poem_id": 1468,
    "vorder": 140,
    "position": 1,
    "text": "گرازان و پویان به نزدیک شاه"
  },
  {
    "poem_id": 1468,
    "vorder": 141,
    "position": 0,
    "text": "چو در شد ز در شاه بر پای خاست"
  },
  {
    "poem_id": 1468,
    "vorder": 142,
    "position": 1,
    "text": "بسی پوزش اندر گذشته بخواست"
  },
  {
    "poem_id": 1468,
    "vorder": 143,
    "position": 0,
    "text": "که تندی مرا گوهرست و سرشت"
  },
  {
    "poem_id": 1468,
    "vorder": 144,
    "position": 1,
    "text": "چنان زیست باید که یزدان بکشت"
  },
  {
    "poem_id": 1468,
    "vorder": 145,
    "position": 0,
    "text": "وزین ناسگالیده بدخواه نو"
  },
  {
    "poem_id": 1468,
    "vorder": 146,
    "position": 1,
    "text": "دلم گشت باریک چون ماه نو"
  },
  {
    "poem_id": 1468,
    "vorder": 147,
    "position": 0,
    "text": "بدین چاره جستن ترا خواستم"
  },
  {
    "poem_id": 1468,
    "vorder": 148,
    "position": 1,
    "text": "چو دیر آمدی تندی آراستم"
  },
  {
    "poem_id": 1468,
    "vorder": 149,
    "position": 0,
    "text": "چو آزرده گشتی تو ای پیلتن"
  },
  {
    "poem_id": 1468,
    "vorder": 150,
    "position": 1,
    "text": "پشیمان شدم خاکم اندر دهن"
  },
  {
    "poem_id": 1468,
    "vorder": 151,
    "position": 0,
    "text": "بدو گفت رستم که گیهان تراست"
  },
  {
    "poem_id": 1468,
    "vorder": 152,
    "position": 1,
    "text": "همه کهترانیم و فرمان تراست"
  },
  {
    "poem_id": 1468,
    "vorder": 153,
    "position": 0,
    "text": "کنون آمدم تا چه فرمان دهی"
  },
  {
    "poem_id": 1468,
    "vorder": 154,
    "position": 1,
    "text": "روانت ز دانش مبادا تهی"
  },
  {
    "poem_id": 1468,
    "vorder": 155,
    "position": 0,
    "text": "بدو گفت کاووس کامروز بزم"
  },
  {
    "poem_id": 1468,
    "vorder": 156,
    "position": 1,
    "text": "گزینیم و فردا بسازیم رزم"
  },
  {
    "poem_id": 1468,
    "vorder": 157,
    "position": 0,
    "text": "بیاراست رامشگهی شاهوار"
  },
  {
    "poem_id": 1468,
    "vorder": 158,
    "position": 1,
    "text": "شد ایوان به کردار باغ بهار"
  },
  {
    "poem_id": 1468,
    "vorder": 159,
    "position": 0,
    "text": "ز آواز ابریشم و بانگ نای"
  },
  {
    "poem_id": 1468,
    "vorder": 160,
    "position": 1,
    "text": "سمن عارضان پیش خسرو به پای"
  },
  {
    "poem_id": 1468,
    "vorder": 161,
    "position": 0,
    "text": "همی باده خوردند تا نیم شب"
  },
  {
    "poem_id": 1468,
    "vorder": 162,
    "position": 1,
    "text": "ز خنیاگران برگشاده دو لب"
  }
]