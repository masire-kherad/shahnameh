[
  {
    "poem_id": 1938,
    "vorder": 1,
    "position": 0,
    "text": "چنین تا به بیژن رسید آگهی"
  },
  {
    "poem_id": 1938,
    "vorder": 2,
    "position": 1,
    "text": "که ماهوی بگرفت تخت مهی"
  },
  {
    "poem_id": 1938,
    "vorder": 3,
    "position": 0,
    "text": "بهر سو فرستاد مهر و نگین"
  },
  {
    "poem_id": 1938,
    "vorder": 4,
    "position": 1,
    "text": "همی رام گردد برو بر زمین"
  },
  {
    "poem_id": 1938,
    "vorder": 5,
    "position": 0,
    "text": "کنون سوی جیحون نهادست روی"
  },
  {
    "poem_id": 1938,
    "vorder": 6,
    "position": 1,
    "text": "به پرخاش با لشکری جنگجوی"
  },
  {
    "poem_id": 1938,
    "vorder": 7,
    "position": 0,
    "text": "بپرسید بیژن که تاجش که داد"
  },
  {
    "poem_id": 1938,
    "vorder": 8,
    "position": 1,
    "text": "برو کرد گوینده آن کار یاد"
  },
  {
    "poem_id": 1938,
    "vorder": 9,
    "position": 0,
    "text": "بدو گفت برسام کای شهریار"
  },
  {
    "poem_id": 1938,
    "vorder": 10,
    "position": 1,
    "text": "چو من بردم از چاچ چندان سوار"
  },
  {
    "poem_id": 1938,
    "vorder": 11,
    "position": 0,
    "text": "بیاوردم از مرو چندان بنه"
  },
  {
    "poem_id": 1938,
    "vorder": 12,
    "position": 1,
    "text": "بشد یزدگرد از میان یک تنه"
  },
  {
    "poem_id": 1938,
    "vorder": 13,
    "position": 0,
    "text": "تو را گفته بُد تخت زرین اوی"
  },
  {
    "poem_id": 1938,
    "vorder": 14,
    "position": 1,
    "text": "همان یارهٔ گوهرآگین اوی"
  },
  {
    "poem_id": 1938,
    "vorder": 15,
    "position": 0,
    "text": "همان گنج و تاجش فرستم به چاج"
  },
  {
    "poem_id": 1938,
    "vorder": 16,
    "position": 1,
    "text": "تو را باید اندر جهان تخت عاج"
  },
  {
    "poem_id": 1938,
    "vorder": 17,
    "position": 0,
    "text": "به مرو اندرون رزم کردم سه روز"
  },
  {
    "poem_id": 1938,
    "vorder": 18,
    "position": 1,
    "text": "چهارم چو بفروخت گیتی‌فروز"
  },
  {
    "poem_id": 1938,
    "vorder": 19,
    "position": 0,
    "text": "شدم تنگدل رزم کردم درشت"
  },
  {
    "poem_id": 1938,
    "vorder": 20,
    "position": 1,
    "text": "جفاپیشه ماهوی بنمود پشت"
  },
  {
    "poem_id": 1938,
    "vorder": 21,
    "position": 0,
    "text": "چو ماهوی گنج خداوند خویش"
  },
  {
    "poem_id": 1938,
    "vorder": 22,
    "position": 1,
    "text": "بیاورد بی‌رنج و بنهاد پیش"
  },
  {
    "poem_id": 1938,
    "vorder": 23,
    "position": 0,
    "text": "چو آگنده شد مرد بی‌تن به چیز"
  },
  {
    "poem_id": 1938,
    "vorder": 24,
    "position": 1,
    "text": "مرا خود تو گفتی ندیدست نیز"
  },
  {
    "poem_id": 1938,
    "vorder": 25,
    "position": 0,
    "text": "به مرو اندرون بود لشکر دو ماه"
  },
  {
    "poem_id": 1938,
    "vorder": 26,
    "position": 1,
    "text": "به خوبی نکرد ایچ بر ما نگاه"
  },
  {
    "poem_id": 1938,
    "vorder": 27,
    "position": 0,
    "text": "بکشت او خداوند را در نهان"
  },
  {
    "poem_id": 1938,
    "vorder": 28,
    "position": 1,
    "text": "چنان پادشاهی بزرگ جهان"
  },
  {
    "poem_id": 1938,
    "vorder": 29,
    "position": 0,
    "text": "سواری که گفتی میان سپاه"
  },
  {
    "poem_id": 1938,
    "vorder": 30,
    "position": 1,
    "text": "همی‌برگذارد سر از چرخ ماه"
  },
  {
    "poem_id": 1938,
    "vorder": 31,
    "position": 0,
    "text": "ز ترکان کسی پیش گرزش نرفت"
  },
  {
    "poem_id": 1938,
    "vorder": 32,
    "position": 1,
    "text": "همی زو دل نامداران بکفت"
  },
  {
    "poem_id": 1938,
    "vorder": 33,
    "position": 0,
    "text": "چو او کشته شد پادشاهی گرفت"
  },
  {
    "poem_id": 1938,
    "vorder": 34,
    "position": 1,
    "text": "بدین گونه ناپارسایی گرفت"
  },
  {
    "poem_id": 1938,
    "vorder": 35,
    "position": 0,
    "text": "طلایه همی‌گوید آمد سپاه"
  },
  {
    "poem_id": 1938,
    "vorder": 36,
    "position": 1,
    "text": "نباید که بر ما بگیرند راه"
  },
  {
    "poem_id": 1938,
    "vorder": 37,
    "position": 0,
    "text": "چو بدخواه جنگی به بالین رسید"
  },
  {
    "poem_id": 1938,
    "vorder": 38,
    "position": 1,
    "text": "نباید تو را با سپاه آرمید"
  },
  {
    "poem_id": 1938,
    "vorder": 39,
    "position": 0,
    "text": "چنین گل به پالیز شاهان مباد"
  },
  {
    "poem_id": 1938,
    "vorder": 40,
    "position": 1,
    "text": "چو باشد نیاید ز پالیز یاد"
  },
  {
    "poem_id": 1938,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید بیژن سپه گرد کرد"
  },
  {
    "poem_id": 1938,
    "vorder": 42,
    "position": 1,
    "text": "ز ترکان سواران روز نبرد"
  },
  {
    "poem_id": 1938,
    "vorder": 43,
    "position": 0,
    "text": "ز قجقار باشی بیامد دمان"
  },
  {
    "poem_id": 1938,
    "vorder": 44,
    "position": 1,
    "text": "نجست ایچ‌گونه بره بر زمان"
  },
  {
    "poem_id": 1938,
    "vorder": 45,
    "position": 0,
    "text": "چو نزدیک شهر بخارا رسید"
  },
  {
    "poem_id": 1938,
    "vorder": 46,
    "position": 1,
    "text": "همه دشت نخشب سپه گسترید"
  },
  {
    "poem_id": 1938,
    "vorder": 47,
    "position": 0,
    "text": "به یاران چنین گفت که اکنون شتاب"
  },
  {
    "poem_id": 1938,
    "vorder": 48,
    "position": 1,
    "text": "مدارید تا او بدین روی آب"
  },
  {
    "poem_id": 1938,
    "vorder": 49,
    "position": 0,
    "text": "به پیکار ما پیش آرد سپاه"
  },
  {
    "poem_id": 1938,
    "vorder": 50,
    "position": 1,
    "text": "مگر باز خواهیم زو کین شاه"
  },
  {
    "poem_id": 1938,
    "vorder": 51,
    "position": 0,
    "text": "ازان پس بپرسید کز نامدار"
  },
  {
    "poem_id": 1938,
    "vorder": 52,
    "position": 1,
    "text": "که ماند ایچ فرزند کاید به کار"
  },
  {
    "poem_id": 1938,
    "vorder": 53,
    "position": 0,
    "text": "جهاندارشه را برادر بُدَست"
  },
  {
    "poem_id": 1938,
    "vorder": 54,
    "position": 1,
    "text": "پسر گر نبود ایچ دختر بُدَست"
  },
  {
    "poem_id": 1938,
    "vorder": 55,
    "position": 0,
    "text": "که او را بیاریم و یاری دهیم"
  },
  {
    "poem_id": 1938,
    "vorder": 56,
    "position": 1,
    "text": "به ماهوی بر کامگاری دهیم"
  },
  {
    "poem_id": 1938,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت برسام کای شهریار"
  },
  {
    "poem_id": 1938,
    "vorder": 58,
    "position": 1,
    "text": "سرآمد برین تخمه بر روزگار"
  },
  {
    "poem_id": 1938,
    "vorder": 59,
    "position": 0,
    "text": "بران شهرها تازیان راست دست"
  },
  {
    "poem_id": 1938,
    "vorder": 60,
    "position": 1,
    "text": "که نه شاه ماند نه یزدان‌پرست"
  },
  {
    "poem_id": 1938,
    "vorder": 61,
    "position": 0,
    "text": "چو بشنید بیژن سپه برگرفت"
  },
  {
    "poem_id": 1938,
    "vorder": 62,
    "position": 1,
    "text": "ز کار جهان دست بر سر گرفت"
  },
  {
    "poem_id": 1938,
    "vorder": 63,
    "position": 0,
    "text": "طلایه بیامد که آمد سپاه"
  },
  {
    "poem_id": 1938,
    "vorder": 64,
    "position": 1,
    "text": "به پیکند سازد همی رزمگاه"
  },
  {
    "poem_id": 1938,
    "vorder": 65,
    "position": 0,
    "text": "سپاهی بکشتی برآمد ز آب"
  },
  {
    "poem_id": 1938,
    "vorder": 66,
    "position": 1,
    "text": "که از گرد پیدا نبود آفتاب"
  },
  {
    "poem_id": 1938,
    "vorder": 67,
    "position": 0,
    "text": "سپهدار بیژن به پیش سپاه"
  },
  {
    "poem_id": 1938,
    "vorder": 68,
    "position": 1,
    "text": "بیامد که سازد همی رزمگاه"
  },
  {
    "poem_id": 1938,
    "vorder": 69,
    "position": 0,
    "text": "چو ماهوی سوری سپه را بدید"
  },
  {
    "poem_id": 1938,
    "vorder": 70,
    "position": 1,
    "text": "تو گفتی که جانش ز تن برپرید"
  },
  {
    "poem_id": 1938,
    "vorder": 71,
    "position": 0,
    "text": "ز بس جوشن و خود و زرین سپر"
  },
  {
    "poem_id": 1938,
    "vorder": 72,
    "position": 1,
    "text": "ز بس نیزه و گرز و چاچی‌تبر"
  },
  {
    "poem_id": 1938,
    "vorder": 73,
    "position": 0,
    "text": "غمی شد برابر صفی برکشید"
  },
  {
    "poem_id": 1938,
    "vorder": 74,
    "position": 1,
    "text": "هوا نیلگون شد زمین ناپدید"
  }
]