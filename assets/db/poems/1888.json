[
  {
    "poem_id": 1888,
    "vorder": 1,
    "position": 0,
    "text": "چو پیروز شد سوی ایران کشید"
  },
  {
    "poem_id": 1888,
    "vorder": 2,
    "position": 1,
    "text": "بر شهریار دلیران کشید"
  },
  {
    "poem_id": 1888,
    "vorder": 3,
    "position": 0,
    "text": "به روز چهارم به آموی شد"
  },
  {
    "poem_id": 1888,
    "vorder": 4,
    "position": 1,
    "text": "ندیدی زنی کو جهانجوی شد"
  },
  {
    "poem_id": 1888,
    "vorder": 5,
    "position": 0,
    "text": "به آموی یک چند بنشست و بود"
  },
  {
    "poem_id": 1888,
    "vorder": 6,
    "position": 1,
    "text": "به دلش اندرون داوریها فزود"
  },
  {
    "poem_id": 1888,
    "vorder": 7,
    "position": 0,
    "text": "یکی نامه سوی برادر بدرد"
  },
  {
    "poem_id": 1888,
    "vorder": 8,
    "position": 1,
    "text": "نوشت و ز هر کارش آگاه کرد"
  },
  {
    "poem_id": 1888,
    "vorder": 9,
    "position": 0,
    "text": "نخستین سخن گفت بهرام گرد"
  },
  {
    "poem_id": 1888,
    "vorder": 10,
    "position": 1,
    "text": "به تیمار و درد برادر بمرد"
  },
  {
    "poem_id": 1888,
    "vorder": 11,
    "position": 0,
    "text": "تو را و مرا مزد بسیار باد"
  },
  {
    "poem_id": 1888,
    "vorder": 12,
    "position": 1,
    "text": "روان وی از ما بی‌آزار باد"
  },
  {
    "poem_id": 1888,
    "vorder": 13,
    "position": 0,
    "text": "دگر گفت با شهریار بلند"
  },
  {
    "poem_id": 1888,
    "vorder": 14,
    "position": 1,
    "text": "بگوی آنچ از من شنیدی ز پند"
  },
  {
    "poem_id": 1888,
    "vorder": 15,
    "position": 0,
    "text": "پس ما بیامد سپاهی گران"
  },
  {
    "poem_id": 1888,
    "vorder": 16,
    "position": 1,
    "text": "همه نامداران جنگاوران"
  },
  {
    "poem_id": 1888,
    "vorder": 17,
    "position": 0,
    "text": "برآن گونه برگاشتمشان ز رزم"
  },
  {
    "poem_id": 1888,
    "vorder": 18,
    "position": 1,
    "text": "که نه رزم بینند زان پس نه بزم"
  },
  {
    "poem_id": 1888,
    "vorder": 19,
    "position": 0,
    "text": "بسی نامور مهتران با منند"
  },
  {
    "poem_id": 1888,
    "vorder": 20,
    "position": 1,
    "text": "نبادی که آید بریشان گزند"
  },
  {
    "poem_id": 1888,
    "vorder": 21,
    "position": 0,
    "text": "نشستم به آموی تا پاسخم"
  },
  {
    "poem_id": 1888,
    "vorder": 22,
    "position": 1,
    "text": "بیارد مگر اختر فرخم"
  }
]