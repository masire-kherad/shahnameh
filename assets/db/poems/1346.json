[
  {
    "poem_id": 1346,
    "vorder": 1,
    "position": 0,
    "text": "چو ضحاک شد بر جهان شهریار"
  },
  {
    "poem_id": 1346,
    "vorder": 2,
    "position": 1,
    "text": "بر او سالیان انجمن شد هزار"
  },
  {
    "poem_id": 1346,
    "vorder": 3,
    "position": 0,
    "text": "سراسر زمانه بدو گشت باز"
  },
  {
    "poem_id": 1346,
    "vorder": 4,
    "position": 1,
    "text": "برآمد بر این روزگار دراز"
  },
  {
    "poem_id": 1346,
    "vorder": 5,
    "position": 0,
    "text": "نهان گشت کردار فرزانگان"
  },
  {
    "poem_id": 1346,
    "vorder": 6,
    "position": 1,
    "text": "پراگنده شد کام دیوانگان"
  },
  {
    "poem_id": 1346,
    "vorder": 7,
    "position": 0,
    "text": "هنر خوار شد جادویی ارجمند"
  },
  {
    "poem_id": 1346,
    "vorder": 8,
    "position": 1,
    "text": "نهان راستی آشکارا گزند"
  },
  {
    "poem_id": 1346,
    "vorder": 9,
    "position": 0,
    "text": "شده بر بدی دست دیوان دراز"
  },
  {
    "poem_id": 1346,
    "vorder": 10,
    "position": 1,
    "text": "به نیکی نرفتی سخن جز به راز"
  },
  {
    "poem_id": 1346,
    "vorder": 11,
    "position": 0,
    "text": "دو پاکیزه از خانهٔ جمّشید"
  },
  {
    "poem_id": 1346,
    "vorder": 12,
    "position": 1,
    "text": "برون آوریدند لرزان چو بید"
  },
  {
    "poem_id": 1346,
    "vorder": 13,
    "position": 0,
    "text": "که جمشید را هر دو دختر بدند"
  },
  {
    "poem_id": 1346,
    "vorder": 14,
    "position": 1,
    "text": "سر بانوان را چو افسر بدند"
  },
  {
    "poem_id": 1346,
    "vorder": 15,
    "position": 0,
    "text": "ز پوشیده‌رویان یکی شهرناز"
  },
  {
    "poem_id": 1346,
    "vorder": 16,
    "position": 1,
    "text": "دگر پاکدامن به نام ارنواز"
  },
  {
    "poem_id": 1346,
    "vorder": 17,
    "position": 0,
    "text": "به ایوان ضحاک بردندشان"
  },
  {
    "poem_id": 1346,
    "vorder": 18,
    "position": 1,
    "text": "بر آن اژدهافش سپردندشان"
  },
  {
    "poem_id": 1346,
    "vorder": 19,
    "position": 0,
    "text": "بپروردشان از ره جادویی"
  },
  {
    "poem_id": 1346,
    "vorder": 20,
    "position": 1,
    "text": "بیاموختشان کژی و بدخویی"
  },
  {
    "poem_id": 1346,
    "vorder": 21,
    "position": 0,
    "text": "ندانست جز کژی آموختن"
  },
  {
    "poem_id": 1346,
    "vorder": 22,
    "position": 1,
    "text": "جز از کشتن و غارت و سوختن"
  }
]