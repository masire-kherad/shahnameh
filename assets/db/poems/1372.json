[
  {
    "poem_id": 1372,
    "vorder": 1,
    "position": 0,
    "text": "بدان گه که روشن جهان تیره گشت"
  },
  {
    "poem_id": 1372,
    "vorder": 2,
    "position": 1,
    "text": "طلایه پراگنده بر گرد دشت"
  },
  {
    "poem_id": 1372,
    "vorder": 3,
    "position": 0,
    "text": "به پیش سپه قارن رزم زن"
  },
  {
    "poem_id": 1372,
    "vorder": 4,
    "position": 1,
    "text": "ابا رای زن سرو شاه یمن"
  },
  {
    "poem_id": 1372,
    "vorder": 5,
    "position": 0,
    "text": "خروشی برآمد ز پیش سپاه"
  },
  {
    "poem_id": 1372,
    "vorder": 6,
    "position": 1,
    "text": "که ای نامداران و مردان شاه"
  },
  {
    "poem_id": 1372,
    "vorder": 7,
    "position": 0,
    "text": "بکوشید کاین جنگ آهرمنست"
  },
  {
    "poem_id": 1372,
    "vorder": 8,
    "position": 1,
    "text": "همان درد و کین است و خون خستنست"
  },
  {
    "poem_id": 1372,
    "vorder": 9,
    "position": 0,
    "text": "میان بسته دارید و بیدار بید"
  },
  {
    "poem_id": 1372,
    "vorder": 10,
    "position": 1,
    "text": "همه در پناه جهاندار بید"
  },
  {
    "poem_id": 1372,
    "vorder": 11,
    "position": 0,
    "text": "کسی کو شود کشته زین رزمگاه"
  },
  {
    "poem_id": 1372,
    "vorder": 12,
    "position": 1,
    "text": "بهشتی بود شسته پاک از گناه"
  },
  {
    "poem_id": 1372,
    "vorder": 13,
    "position": 0,
    "text": "هر آن کس که از لشکر چین و روم"
  },
  {
    "poem_id": 1372,
    "vorder": 14,
    "position": 1,
    "text": "بریزند خون و بگیرند بوم"
  },
  {
    "poem_id": 1372,
    "vorder": 15,
    "position": 0,
    "text": "همه نیکنامند تا جاودان"
  },
  {
    "poem_id": 1372,
    "vorder": 16,
    "position": 1,
    "text": "بمانند با فرهٔ موبدان"
  },
  {
    "poem_id": 1372,
    "vorder": 17,
    "position": 0,
    "text": "هم از شاه یابند دیهیم و تخت"
  },
  {
    "poem_id": 1372,
    "vorder": 18,
    "position": 1,
    "text": "ز سالار زر و ز دادار بخت"
  },
  {
    "poem_id": 1372,
    "vorder": 19,
    "position": 0,
    "text": "چو پیدا شود پاک روز سپید"
  },
  {
    "poem_id": 1372,
    "vorder": 20,
    "position": 1,
    "text": "دو بهره بپیماید از چرخ شید"
  },
  {
    "poem_id": 1372,
    "vorder": 21,
    "position": 0,
    "text": "ببندید یکسر میان یلی"
  },
  {
    "poem_id": 1372,
    "vorder": 22,
    "position": 1,
    "text": "ابا گرز و با خنجر کابلی"
  },
  {
    "poem_id": 1372,
    "vorder": 23,
    "position": 0,
    "text": "بدارید یکسر همه جای خویش"
  },
  {
    "poem_id": 1372,
    "vorder": 24,
    "position": 1,
    "text": "یکی از دگر پای منهید پیش"
  },
  {
    "poem_id": 1372,
    "vorder": 25,
    "position": 0,
    "text": "سران سپه مهتران دلیر"
  },
  {
    "poem_id": 1372,
    "vorder": 26,
    "position": 1,
    "text": "کشیدند صف پیش سالار شیر"
  },
  {
    "poem_id": 1372,
    "vorder": 27,
    "position": 0,
    "text": "به سالار گفتند ما بنده‌ایم"
  },
  {
    "poem_id": 1372,
    "vorder": 28,
    "position": 1,
    "text": "خود اندر جهان شاه را زنده‌ایم"
  },
  {
    "poem_id": 1372,
    "vorder": 29,
    "position": 0,
    "text": "چو فرمان دهد ما همیدون کنیم"
  },
  {
    "poem_id": 1372,
    "vorder": 30,
    "position": 1,
    "text": "زمین را ز خون رود جیحون کنیم"
  },
  {
    "poem_id": 1372,
    "vorder": 31,
    "position": 0,
    "text": "سوی خیمهٔ خویش باز آمدند"
  },
  {
    "poem_id": 1372,
    "vorder": 32,
    "position": 1,
    "text": "همه با سری کینه ساز آمدند"
  }
]