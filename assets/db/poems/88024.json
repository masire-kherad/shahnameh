[
  {
    "poem_id": 88024,
    "vorder": 1,
    "position": 0,
    "text": "دل شاه ترکان چنان کم شنود"
  },
  {
    "poem_id": 88024,
    "vorder": 2,
    "position": 1,
    "text": "همیشه به رنج از پی آز بود"
  },
  {
    "poem_id": 88024,
    "vorder": 3,
    "position": 0,
    "text": "از آن پس که برگشت زان رزمگاه"
  },
  {
    "poem_id": 88024,
    "vorder": 4,
    "position": 1,
    "text": "که رستم بر او کرد گیتی سیاه"
  },
  {
    "poem_id": 88024,
    "vorder": 5,
    "position": 0,
    "text": "بشد تازیان تا به خلخ رسید"
  },
  {
    "poem_id": 88024,
    "vorder": 6,
    "position": 1,
    "text": "به ننگ از کیان شد سرش ناپدید"
  },
  {
    "poem_id": 88024,
    "vorder": 7,
    "position": 0,
    "text": "به کاخ اندر آمد پر آزار دل"
  },
  {
    "poem_id": 88024,
    "vorder": 8,
    "position": 1,
    "text": "ابا کاردانان هشیاردل"
  },
  {
    "poem_id": 88024,
    "vorder": 9,
    "position": 0,
    "text": "چو پیران و گرسیوز رهنمون"
  },
  {
    "poem_id": 88024,
    "vorder": 10,
    "position": 1,
    "text": "قراخان و چون شیده و گرسیون"
  },
  {
    "poem_id": 88024,
    "vorder": 11,
    "position": 0,
    "text": "بر ایشان همه داستان برگشاد"
  },
  {
    "poem_id": 88024,
    "vorder": 12,
    "position": 1,
    "text": "گذشته سخنها همه کرد یاد"
  },
  {
    "poem_id": 88024,
    "vorder": 13,
    "position": 0,
    "text": "که تا برنهادم به شاهی کلاه"
  },
  {
    "poem_id": 88024,
    "vorder": 14,
    "position": 1,
    "text": "مرا گشت خورشید و تابنده ماه"
  },
  {
    "poem_id": 88024,
    "vorder": 15,
    "position": 0,
    "text": "مرا بود بر مهتران دسترس"
  },
  {
    "poem_id": 88024,
    "vorder": 16,
    "position": 1,
    "text": "عنان مرا برنتابید کس"
  },
  {
    "poem_id": 88024,
    "vorder": 17,
    "position": 0,
    "text": "ز هنگام رزم منوچهر باز"
  },
  {
    "poem_id": 88024,
    "vorder": 18,
    "position": 1,
    "text": "نبد دست ایران به توران دراز"
  },
  {
    "poem_id": 88024,
    "vorder": 19,
    "position": 0,
    "text": "شبیخون کند تا در خان من"
  },
  {
    "poem_id": 88024,
    "vorder": 20,
    "position": 1,
    "text": "از ایران بیازند بر جان من"
  },
  {
    "poem_id": 88024,
    "vorder": 21,
    "position": 0,
    "text": "دلاور شد آن مردم نادلیر"
  },
  {
    "poem_id": 88024,
    "vorder": 22,
    "position": 1,
    "text": "گوزن اندر آمد به بالین شیر"
  },
  {
    "poem_id": 88024,
    "vorder": 23,
    "position": 0,
    "text": "بر این کینه گر کار سازیم زود"
  },
  {
    "poem_id": 88024,
    "vorder": 24,
    "position": 1,
    "text": "وگرنه برآرند زین مرز دود"
  },
  {
    "poem_id": 88024,
    "vorder": 25,
    "position": 0,
    "text": "سزد گر کنون گرد این کشورم"
  },
  {
    "poem_id": 88024,
    "vorder": 26,
    "position": 1,
    "text": "سراسر فرستادگان گسترم"
  },
  {
    "poem_id": 88024,
    "vorder": 27,
    "position": 0,
    "text": "ز ترکان واز چین هزاران هزار"
  },
  {
    "poem_id": 88024,
    "vorder": 28,
    "position": 1,
    "text": "کمربستگان از در کارزار"
  },
  {
    "poem_id": 88024,
    "vorder": 29,
    "position": 0,
    "text": "بیاریم بر گرد ایران سپاه"
  },
  {
    "poem_id": 88024,
    "vorder": 30,
    "position": 1,
    "text": "بسازیم هر سو یکی رزمگاه"
  },
  {
    "poem_id": 88024,
    "vorder": 31,
    "position": 0,
    "text": "همه موبدان رای هشیار خویش"
  },
  {
    "poem_id": 88024,
    "vorder": 32,
    "position": 1,
    "text": "نهادند با گفت سالار خویش"
  },
  {
    "poem_id": 88024,
    "vorder": 33,
    "position": 0,
    "text": "که ما را ز جیحون بباید گذشت"
  },
  {
    "poem_id": 88024,
    "vorder": 34,
    "position": 1,
    "text": "زدن کوس شاهی بر آن پهن دشت"
  },
  {
    "poem_id": 88024,
    "vorder": 35,
    "position": 0,
    "text": "به آموی لشکرگهی ساختن"
  },
  {
    "poem_id": 88024,
    "vorder": 36,
    "position": 1,
    "text": "شب و روز ناسودن از تاختن"
  },
  {
    "poem_id": 88024,
    "vorder": 37,
    "position": 0,
    "text": "که آن جای جنگست و خون ریختن"
  },
  {
    "poem_id": 88024,
    "vorder": 38,
    "position": 1,
    "text": "چه با گیو و با رستم آویختن"
  },
  {
    "poem_id": 88024,
    "vorder": 39,
    "position": 0,
    "text": "سرافراز گردان گیرنده شهر"
  },
  {
    "poem_id": 88024,
    "vorder": 40,
    "position": 1,
    "text": "همه تیغ کین آب داده به زهر"
  },
  {
    "poem_id": 88024,
    "vorder": 41,
    "position": 0,
    "text": "چو افراسیاب آن سخنها شنود"
  },
  {
    "poem_id": 88024,
    "vorder": 42,
    "position": 1,
    "text": "برافروخت از بخت و شادی نمود"
  },
  {
    "poem_id": 88024,
    "vorder": 43,
    "position": 0,
    "text": "ابر پهلوانان و بر موبدان"
  },
  {
    "poem_id": 88024,
    "vorder": 44,
    "position": 1,
    "text": "بکرد آفرینی به رسم ردان"
  },
  {
    "poem_id": 88024,
    "vorder": 45,
    "position": 0,
    "text": "نویسندهٔ نامه را پیش خواند"
  },
  {
    "poem_id": 88024,
    "vorder": 46,
    "position": 1,
    "text": "سخنهای بایسته چندی براند"
  },
  {
    "poem_id": 88024,
    "vorder": 47,
    "position": 0,
    "text": "فرستادگان خواست از انجمن"
  },
  {
    "poem_id": 88024,
    "vorder": 48,
    "position": 1,
    "text": "به نزدیک فغفور و شاه ختن"
  },
  {
    "poem_id": 88024,
    "vorder": 49,
    "position": 0,
    "text": "فرستاد نامه به هر کشوری"
  },
  {
    "poem_id": 88024,
    "vorder": 50,
    "position": 1,
    "text": "به هر نامداری و هر مهتری"
  },
  {
    "poem_id": 88024,
    "vorder": 51,
    "position": 0,
    "text": "سپه خواست کاندیشهٔ جنگ داشت"
  },
  {
    "poem_id": 88024,
    "vorder": 52,
    "position": 1,
    "text": "ز بیژن بدان گونه دل تنگ داشت"
  },
  {
    "poem_id": 88024,
    "vorder": 53,
    "position": 0,
    "text": "دو هفته برآمد ز چین و ختن"
  },
  {
    "poem_id": 88024,
    "vorder": 54,
    "position": 1,
    "text": "ز هر کشوری شد سپاه انجمن"
  },
  {
    "poem_id": 88024,
    "vorder": 55,
    "position": 0,
    "text": "چو دریای جوشان زمین بردمید"
  },
  {
    "poem_id": 88024,
    "vorder": 56,
    "position": 1,
    "text": "چنان شد که کس روز روشن ندید"
  },
  {
    "poem_id": 88024,
    "vorder": 57,
    "position": 0,
    "text": "گله هرچ بودش ز اسبان یله"
  },
  {
    "poem_id": 88024,
    "vorder": 58,
    "position": 1,
    "text": "به شهر اندر آورد یکسر گله"
  },
  {
    "poem_id": 88024,
    "vorder": 59,
    "position": 0,
    "text": "همان گنجها کز گه تور باز"
  },
  {
    "poem_id": 88024,
    "vorder": 60,
    "position": 1,
    "text": "پدر بر پسربر همی داشت راز"
  },
  {
    "poem_id": 88024,
    "vorder": 61,
    "position": 0,
    "text": "سر بدره‌ها را گشادن گرفت"
  },
  {
    "poem_id": 88024,
    "vorder": 62,
    "position": 1,
    "text": "شب و روز دینار دادن گرفت"
  },
  {
    "poem_id": 88024,
    "vorder": 63,
    "position": 0,
    "text": "چو لشکر سراسر شد آراسته"
  },
  {
    "poem_id": 88024,
    "vorder": 64,
    "position": 1,
    "text": "بدان بی‌نیازی شد از خواسته"
  },
  {
    "poem_id": 88024,
    "vorder": 65,
    "position": 0,
    "text": "ز گردان گزین کرد پنجه هزار"
  },
  {
    "poem_id": 88024,
    "vorder": 66,
    "position": 1,
    "text": "همه رزم‌جویان سازنده کار"
  },
  {
    "poem_id": 88024,
    "vorder": 67,
    "position": 0,
    "text": "به شیده که بودش نبرده پسر"
  },
  {
    "poem_id": 88024,
    "vorder": 68,
    "position": 1,
    "text": "ز گردان جنگی برآورده سر"
  },
  {
    "poem_id": 88024,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت کین لشکر سرفراز"
  },
  {
    "poem_id": 88024,
    "vorder": 70,
    "position": 1,
    "text": "سپردم ترا راه خوارزم ساز"
  },
  {
    "poem_id": 88024,
    "vorder": 71,
    "position": 0,
    "text": "نگهبان آن مرز خوارزم باش"
  },
  {
    "poem_id": 88024,
    "vorder": 72,
    "position": 1,
    "text": "همیشه کمربستهٔ رزم باش"
  },
  {
    "poem_id": 88024,
    "vorder": 73,
    "position": 0,
    "text": "دگر پنجه از نامداران چین"
  },
  {
    "poem_id": 88024,
    "vorder": 74,
    "position": 1,
    "text": "بفرمود تا کرد پیران گزین"
  },
  {
    "poem_id": 88024,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت تا شهر ایران برو"
  },
  {
    "poem_id": 88024,
    "vorder": 76,
    "position": 1,
    "text": "ممان رخت و مه تخت سالار نو"
  },
  {
    "poem_id": 88024,
    "vorder": 77,
    "position": 0,
    "text": "در آشتی هیچ گونه مجوی"
  },
  {
    "poem_id": 88024,
    "vorder": 78,
    "position": 1,
    "text": "سخن جز به جنگ و به کینه مگوی"
  },
  {
    "poem_id": 88024,
    "vorder": 79,
    "position": 0,
    "text": "کسی کو برد آب و آتش بهم"
  },
  {
    "poem_id": 88024,
    "vorder": 80,
    "position": 1,
    "text": "ابر هر دوان کرده باشد ستم"
  },
  {
    "poem_id": 88024,
    "vorder": 81,
    "position": 0,
    "text": "دو پر مایه بیدار و دو پهلوان"
  },
  {
    "poem_id": 88024,
    "vorder": 82,
    "position": 1,
    "text": "یکی پیر و باهوش و دیگر جوان"
  },
  {
    "poem_id": 88024,
    "vorder": 83,
    "position": 0,
    "text": "برفتند با پند افراسیاب"
  },
  {
    "poem_id": 88024,
    "vorder": 84,
    "position": 1,
    "text": "به آرام پیر و جوان بر شتاب"
  },
  {
    "poem_id": 88024,
    "vorder": 85,
    "position": 0,
    "text": "ابا ترگ زرین و کوپال و تیغ"
  },
  {
    "poem_id": 88024,
    "vorder": 86,
    "position": 1,
    "text": "خروشان به کردار غرنده میغ"
  }
]