[
  {
    "poem_id": 1382,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که مهراب روزی پگاه"
  },
  {
    "poem_id": 1382,
    "vorder": 2,
    "position": 1,
    "text": "برفت و بیامد از آن بارگاه"
  },
  {
    "poem_id": 1382,
    "vorder": 3,
    "position": 0,
    "text": "گذر کرد سوی شبستان خویش"
  },
  {
    "poem_id": 1382,
    "vorder": 4,
    "position": 1,
    "text": "همی گشت بر گرد بستان خویش"
  },
  {
    "poem_id": 1382,
    "vorder": 5,
    "position": 0,
    "text": "دو خورشید بود اندر ایوان او"
  },
  {
    "poem_id": 1382,
    "vorder": 6,
    "position": 1,
    "text": "چو سیندخت و رودابهٔ ماه روی"
  },
  {
    "poem_id": 1382,
    "vorder": 7,
    "position": 0,
    "text": "بیاراسته همچو باغ بهار"
  },
  {
    "poem_id": 1382,
    "vorder": 8,
    "position": 1,
    "text": "سراپای پر بوی و رنگ و نگار"
  },
  {
    "poem_id": 1382,
    "vorder": 9,
    "position": 0,
    "text": "شگفتی به رودابه اندر بماند"
  },
  {
    "poem_id": 1382,
    "vorder": 10,
    "position": 1,
    "text": "همی نام یزدان بر او بر بخواند"
  },
  {
    "poem_id": 1382,
    "vorder": 11,
    "position": 0,
    "text": "یکی سرو دید از برش گرد ماه"
  },
  {
    "poem_id": 1382,
    "vorder": 12,
    "position": 1,
    "text": "نهاده ز عنبر به سر بر کلاه"
  },
  {
    "poem_id": 1382,
    "vorder": 13,
    "position": 0,
    "text": "به دیبا و گوهر بیاراسته"
  },
  {
    "poem_id": 1382,
    "vorder": 14,
    "position": 1,
    "text": "به سان بهشتی پر از خواسته"
  },
  {
    "poem_id": 1382,
    "vorder": 15,
    "position": 0,
    "text": "بپرسید سیندخت مهراب را"
  },
  {
    "poem_id": 1382,
    "vorder": 16,
    "position": 1,
    "text": "ز خوشاب بگشاد عناب را"
  },
  {
    "poem_id": 1382,
    "vorder": 17,
    "position": 0,
    "text": "که چون رفتی امروز و چون آمدی"
  },
  {
    "poem_id": 1382,
    "vorder": 18,
    "position": 1,
    "text": "که کوتاه باد از تو دست بدی"
  },
  {
    "poem_id": 1382,
    "vorder": 19,
    "position": 0,
    "text": "چه مردست این پیر سر پور سام"
  },
  {
    "poem_id": 1382,
    "vorder": 20,
    "position": 1,
    "text": "همی تخت یاد آیدش گر کنام"
  },
  {
    "poem_id": 1382,
    "vorder": 21,
    "position": 0,
    "text": "خوی مردمی هیچ دارد همی"
  },
  {
    "poem_id": 1382,
    "vorder": 22,
    "position": 1,
    "text": "پی نامداران سپارد همی"
  },
  {
    "poem_id": 1382,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد مهراب پاسخ بدوی"
  },
  {
    "poem_id": 1382,
    "vorder": 24,
    "position": 1,
    "text": "که ای سرو سیمین بر ماه روی"
  },
  {
    "poem_id": 1382,
    "vorder": 25,
    "position": 0,
    "text": "به گیتی در از پهلوانان گرد"
  },
  {
    "poem_id": 1382,
    "vorder": 26,
    "position": 1,
    "text": "پی زال زر کس نیارد سپرد"
  },
  {
    "poem_id": 1382,
    "vorder": 27,
    "position": 0,
    "text": "چو دست و عنانش بر ایوان نگار"
  },
  {
    "poem_id": 1382,
    "vorder": 28,
    "position": 1,
    "text": "نبینی نه بر زین چون او یک سوار"
  },
  {
    "poem_id": 1382,
    "vorder": 29,
    "position": 0,
    "text": "دل شیر نر دارد و زور پیل"
  },
  {
    "poem_id": 1382,
    "vorder": 30,
    "position": 1,
    "text": "دو دستش به کردار دریای نیل"
  },
  {
    "poem_id": 1382,
    "vorder": 31,
    "position": 0,
    "text": "چو بر گاه باشد در افشان بود"
  },
  {
    "poem_id": 1382,
    "vorder": 32,
    "position": 1,
    "text": "چو در جنگ باشد سر افشان بود"
  },
  {
    "poem_id": 1382,
    "vorder": 33,
    "position": 0,
    "text": "رخش پژمرانندهٔ ارغوان"
  },
  {
    "poem_id": 1382,
    "vorder": 34,
    "position": 1,
    "text": "جوان سال و بیدار و بختش جوان"
  },
  {
    "poem_id": 1382,
    "vorder": 35,
    "position": 0,
    "text": "به کین اندرون چون نهنگ بلاست"
  },
  {
    "poem_id": 1382,
    "vorder": 36,
    "position": 1,
    "text": "به زین اندرون تیز چنگ اژدهاست"
  },
  {
    "poem_id": 1382,
    "vorder": 37,
    "position": 0,
    "text": "نشانندهٔ خاک در کین به خون"
  },
  {
    "poem_id": 1382,
    "vorder": 38,
    "position": 1,
    "text": "فشانندهٔ خنجر آبگون"
  },
  {
    "poem_id": 1382,
    "vorder": 39,
    "position": 0,
    "text": "از آهو همان کش سپیدست موی"
  },
  {
    "poem_id": 1382,
    "vorder": 40,
    "position": 1,
    "text": "بگوید سخن مردم عیب جوی"
  },
  {
    "poem_id": 1382,
    "vorder": 41,
    "position": 0,
    "text": "سپیدی مویش بزیبد همی"
  },
  {
    "poem_id": 1382,
    "vorder": 42,
    "position": 1,
    "text": "تو گویی که دلها فریبد همی"
  },
  {
    "poem_id": 1382,
    "vorder": 43,
    "position": 0,
    "text": "چو بشنید رودابه آن گفت‌گوی"
  },
  {
    "poem_id": 1382,
    "vorder": 44,
    "position": 1,
    "text": "برافروخت و گلنارگون کرد روی"
  },
  {
    "poem_id": 1382,
    "vorder": 45,
    "position": 0,
    "text": "دلش گشت پرآتش از مهر زال"
  },
  {
    "poem_id": 1382,
    "vorder": 46,
    "position": 1,
    "text": "از او دور شد خورد و آرام و هال"
  },
  {
    "poem_id": 1382,
    "vorder": 47,
    "position": 0,
    "text": "چو بگرفت جای خرد آرزوی"
  },
  {
    "poem_id": 1382,
    "vorder": 48,
    "position": 1,
    "text": "دگر شد به رای و به آیین و خوی"
  }
]