[
  {
    "poem_id": 88093,
    "vorder": 1,
    "position": 0,
    "text": "غمی شد دل ایرانیان را ز شاه"
  },
  {
    "poem_id": 88093,
    "vorder": 2,
    "position": 1,
    "text": "همه خیره گشتند و گم کرده راه"
  },
  {
    "poem_id": 88093,
    "vorder": 3,
    "position": 0,
    "text": "چو بشنید زال این سخن بردمید"
  },
  {
    "poem_id": 88093,
    "vorder": 4,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 88093,
    "vorder": 5,
    "position": 0,
    "text": "به ایرانیان گفت کاین رای نیست"
  },
  {
    "poem_id": 88093,
    "vorder": 6,
    "position": 1,
    "text": "خرد را به مغز اندرش جای نیست"
  },
  {
    "poem_id": 88093,
    "vorder": 7,
    "position": 0,
    "text": "که تا من ببستم کمر بر میان"
  },
  {
    "poem_id": 88093,
    "vorder": 8,
    "position": 1,
    "text": "پرستنده‌ام پیش تخت کیان"
  },
  {
    "poem_id": 88093,
    "vorder": 9,
    "position": 0,
    "text": "ز شاهان ندیدم کسی کاین بگفت"
  },
  {
    "poem_id": 88093,
    "vorder": 10,
    "position": 1,
    "text": "چو او گفت ما را نباید نهفت"
  },
  {
    "poem_id": 88093,
    "vorder": 11,
    "position": 0,
    "text": "نباید بدین بود همداستان"
  },
  {
    "poem_id": 88093,
    "vorder": 12,
    "position": 1,
    "text": "که او هیچ راند چنین داستان"
  },
  {
    "poem_id": 88093,
    "vorder": 13,
    "position": 0,
    "text": "مگر دیو با او هم‌آواز گشت"
  },
  {
    "poem_id": 88093,
    "vorder": 14,
    "position": 1,
    "text": "که از راه یزدان سرش بازگشت"
  },
  {
    "poem_id": 88093,
    "vorder": 15,
    "position": 0,
    "text": "فریدون و هوشنگ یزدان پرست"
  },
  {
    "poem_id": 88093,
    "vorder": 16,
    "position": 1,
    "text": "نبردند هرگز بدین کار دست"
  },
  {
    "poem_id": 88093,
    "vorder": 17,
    "position": 0,
    "text": "بگویم بدو من همه راستی"
  },
  {
    "poem_id": 88093,
    "vorder": 18,
    "position": 1,
    "text": "گر آید به جان اندرون کاستی"
  },
  {
    "poem_id": 88093,
    "vorder": 19,
    "position": 0,
    "text": "چنین یافت پاسخ ز ایرانیان"
  },
  {
    "poem_id": 88093,
    "vorder": 20,
    "position": 1,
    "text": "کز این سان سخن کس نگفت از میان"
  },
  {
    "poem_id": 88093,
    "vorder": 21,
    "position": 0,
    "text": "همه با توایم آنچه گویی به شاه"
  },
  {
    "poem_id": 88093,
    "vorder": 22,
    "position": 1,
    "text": "مبادا که او گم کند رسم و راه"
  },
  {
    "poem_id": 88093,
    "vorder": 23,
    "position": 0,
    "text": "شنید این سخن زال برپای خاست"
  },
  {
    "poem_id": 88093,
    "vorder": 24,
    "position": 1,
    "text": "چنین گفت کای خسرو داد و راست"
  },
  {
    "poem_id": 88093,
    "vorder": 25,
    "position": 0,
    "text": "ز پیر جهاندیده بشنو سخن"
  },
  {
    "poem_id": 88093,
    "vorder": 26,
    "position": 1,
    "text": "چو کژ آورد رای پاسخ مکن"
  },
  {
    "poem_id": 88093,
    "vorder": 27,
    "position": 0,
    "text": "که گفتار تلخست با راستی"
  },
  {
    "poem_id": 88093,
    "vorder": 28,
    "position": 1,
    "text": "ببندد به تلخی در کاستی"
  },
  {
    "poem_id": 88093,
    "vorder": 29,
    "position": 0,
    "text": "نشاید که آزار گیری ز من"
  },
  {
    "poem_id": 88093,
    "vorder": 30,
    "position": 1,
    "text": "بر این راستی پیش این انجمن"
  },
  {
    "poem_id": 88093,
    "vorder": 31,
    "position": 0,
    "text": "به توران زمین زادی از مادرت"
  },
  {
    "poem_id": 88093,
    "vorder": 32,
    "position": 1,
    "text": "همانجا بد آرام و آبشخورت"
  },
  {
    "poem_id": 88093,
    "vorder": 33,
    "position": 0,
    "text": "ز یک سو نبیرهٔ رد افراسیاب"
  },
  {
    "poem_id": 88093,
    "vorder": 34,
    "position": 1,
    "text": "که جز جادوی را ندیدی به خواب"
  },
  {
    "poem_id": 88093,
    "vorder": 35,
    "position": 0,
    "text": "چو کاووس دژخیم دیگر نیا"
  },
  {
    "poem_id": 88093,
    "vorder": 36,
    "position": 1,
    "text": "پر از رنگ رخ دل پر از کیمیا"
  },
  {
    "poem_id": 88093,
    "vorder": 37,
    "position": 0,
    "text": "ز خاور ورا بود تا باختر"
  },
  {
    "poem_id": 88093,
    "vorder": 38,
    "position": 1,
    "text": "بزرگی و شاهی و تاج و کمر"
  },
  {
    "poem_id": 88093,
    "vorder": 39,
    "position": 0,
    "text": "همی خواست کز آسمان بگذرد"
  },
  {
    "poem_id": 88093,
    "vorder": 40,
    "position": 1,
    "text": "همه گردش اختران بشمرد"
  },
  {
    "poem_id": 88093,
    "vorder": 41,
    "position": 0,
    "text": "بدان بر بسی پندها دادمش"
  },
  {
    "poem_id": 88093,
    "vorder": 42,
    "position": 1,
    "text": "همین تلخ گفتار بگشادمش"
  },
  {
    "poem_id": 88093,
    "vorder": 43,
    "position": 0,
    "text": "بسی پند بشنید و سودی نکرد"
  },
  {
    "poem_id": 88093,
    "vorder": 44,
    "position": 1,
    "text": "از او بازگشتم پر از داغ و درد"
  },
  {
    "poem_id": 88093,
    "vorder": 45,
    "position": 0,
    "text": "چو بر شد نگون اندر آمد به خاک"
  },
  {
    "poem_id": 88093,
    "vorder": 46,
    "position": 1,
    "text": "ببخشود بر جانش یزدان پاک"
  },
  {
    "poem_id": 88093,
    "vorder": 47,
    "position": 0,
    "text": "بیامد به یزدان شده ناسپاس"
  },
  {
    "poem_id": 88093,
    "vorder": 48,
    "position": 1,
    "text": "سری پر ز گرد و دلی پرهراس"
  },
  {
    "poem_id": 88093,
    "vorder": 49,
    "position": 0,
    "text": "تو رفتی و شمشیرزن صد هزار"
  },
  {
    "poem_id": 88093,
    "vorder": 50,
    "position": 1,
    "text": "زره‌دار با گُرزهٔ گاوسار"
  },
  {
    "poem_id": 88093,
    "vorder": 51,
    "position": 0,
    "text": "چو شیر ژیان ساختی رزم را"
  },
  {
    "poem_id": 88093,
    "vorder": 52,
    "position": 1,
    "text": "بیاراستی دشت خوارزم را"
  },
  {
    "poem_id": 88093,
    "vorder": 53,
    "position": 0,
    "text": "ز پیش سپه تیز رفتی به جنگ"
  },
  {
    "poem_id": 88093,
    "vorder": 54,
    "position": 1,
    "text": "پیاده شدی پس به جنگ پشنگ"
  },
  {
    "poem_id": 88093,
    "vorder": 55,
    "position": 0,
    "text": "گر او را بدی بر تو بر دست‌یاب"
  },
  {
    "poem_id": 88093,
    "vorder": 56,
    "position": 1,
    "text": "به ایران کشیدی رد افراسیاب"
  },
  {
    "poem_id": 88093,
    "vorder": 57,
    "position": 0,
    "text": "زن و کودک خرد ایرانیان"
  },
  {
    "poem_id": 88093,
    "vorder": 58,
    "position": 1,
    "text": "ببردی به کین کس نبستی میان"
  },
  {
    "poem_id": 88093,
    "vorder": 59,
    "position": 0,
    "text": "ترا ایزد از دست او رسته کرد"
  },
  {
    "poem_id": 88093,
    "vorder": 60,
    "position": 1,
    "text": "ببخشود و رای تو پیوسته کرد"
  },
  {
    "poem_id": 88093,
    "vorder": 61,
    "position": 0,
    "text": "بکشتی کسی را که ز او بد هراس"
  },
  {
    "poem_id": 88093,
    "vorder": 62,
    "position": 1,
    "text": "به دادار دارنده بد ناسپاس"
  },
  {
    "poem_id": 88093,
    "vorder": 63,
    "position": 0,
    "text": "چو گفتم که هنگام آرام بود"
  },
  {
    "poem_id": 88093,
    "vorder": 64,
    "position": 1,
    "text": "گه بخشش و پوشش و جام بود"
  },
  {
    "poem_id": 88093,
    "vorder": 65,
    "position": 0,
    "text": "به ایران کنون کار دشوارتر"
  },
  {
    "poem_id": 88093,
    "vorder": 66,
    "position": 1,
    "text": "فزونتر بدی دل پرآزارتر"
  },
  {
    "poem_id": 88093,
    "vorder": 67,
    "position": 0,
    "text": "که تو برنوشتی ره ایزدی"
  },
  {
    "poem_id": 88093,
    "vorder": 68,
    "position": 1,
    "text": "به کژی گذشتی و راه بدی"
  },
  {
    "poem_id": 88093,
    "vorder": 69,
    "position": 0,
    "text": "از این بد نباشد تنت سودمند"
  },
  {
    "poem_id": 88093,
    "vorder": 70,
    "position": 1,
    "text": "نیاید جهان‌آفرین را پسند"
  },
  {
    "poem_id": 88093,
    "vorder": 71,
    "position": 0,
    "text": "گر این باشد ای شاه سامان تو"
  },
  {
    "poem_id": 88093,
    "vorder": 72,
    "position": 1,
    "text": "نگردد کسی گرد پیمان تو"
  },
  {
    "poem_id": 88093,
    "vorder": 73,
    "position": 0,
    "text": "پشیمانی آید ترا ز این سخن"
  },
  {
    "poem_id": 88093,
    "vorder": 74,
    "position": 1,
    "text": "براندیش و فرمان دیوان مکن"
  },
  {
    "poem_id": 88093,
    "vorder": 75,
    "position": 0,
    "text": "وگر نیز جویی چنین کار دیو"
  },
  {
    "poem_id": 88093,
    "vorder": 76,
    "position": 1,
    "text": "ببرد ز تو فر کیهان خدیو"
  },
  {
    "poem_id": 88093,
    "vorder": 77,
    "position": 0,
    "text": "بمانی پر از درد و دل پر گناه"
  },
  {
    "poem_id": 88093,
    "vorder": 78,
    "position": 1,
    "text": "نخوانند از این پس ترا نیز شاه"
  },
  {
    "poem_id": 88093,
    "vorder": 79,
    "position": 0,
    "text": "به یزدان پناه و به یزدان گرای"
  },
  {
    "poem_id": 88093,
    "vorder": 80,
    "position": 1,
    "text": "که اویست بر نیک و بد رهنمای"
  },
  {
    "poem_id": 88093,
    "vorder": 81,
    "position": 0,
    "text": "گر این پند من یک به یک نشنوی"
  },
  {
    "poem_id": 88093,
    "vorder": 82,
    "position": 1,
    "text": "به آهرمن بدکنش بگروی"
  },
  {
    "poem_id": 88093,
    "vorder": 83,
    "position": 0,
    "text": "بماندت درد و نماندت بخت"
  },
  {
    "poem_id": 88093,
    "vorder": 84,
    "position": 1,
    "text": "نه اورنگ شاهی نه تاج و نه تخت"
  },
  {
    "poem_id": 88093,
    "vorder": 85,
    "position": 0,
    "text": "خرد باد جان ترا رهنمای"
  },
  {
    "poem_id": 88093,
    "vorder": 86,
    "position": 1,
    "text": "به پاکی بماناد مغزت به جای"
  },
  {
    "poem_id": 88093,
    "vorder": 87,
    "position": 0,
    "text": "سخنهای دستان چو آمد به بن"
  },
  {
    "poem_id": 88093,
    "vorder": 88,
    "position": 1,
    "text": "یلان برگشادند یکسر سخن"
  },
  {
    "poem_id": 88093,
    "vorder": 89,
    "position": 0,
    "text": "که ما هم برآنیم کاین پیر گفت"
  },
  {
    "poem_id": 88093,
    "vorder": 90,
    "position": 1,
    "text": "نباید در راستی را نهفت"
  }
]