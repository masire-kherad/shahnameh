[
  {
    "poem_id": 1885,
    "vorder": 1,
    "position": 0,
    "text": "ازآن پس چو خاقان به پردخت دل"
  },
  {
    "poem_id": 1885,
    "vorder": 2,
    "position": 1,
    "text": "ز خون شد همه کشور چین چوگل"
  },
  {
    "poem_id": 1885,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت یک روز کز مرد سست"
  },
  {
    "poem_id": 1885,
    "vorder": 4,
    "position": 1,
    "text": "نیاید مگر کار نا تندرست"
  },
  {
    "poem_id": 1885,
    "vorder": 5,
    "position": 0,
    "text": "بدان نامداری که بهرام بود"
  },
  {
    "poem_id": 1885,
    "vorder": 6,
    "position": 1,
    "text": "مرا زو همه رامش و کام بود"
  },
  {
    "poem_id": 1885,
    "vorder": 7,
    "position": 0,
    "text": "کنون من ز کسهای آن نامدار"
  },
  {
    "poem_id": 1885,
    "vorder": 8,
    "position": 1,
    "text": "چرا بازماندم چنین سست و خوار"
  },
  {
    "poem_id": 1885,
    "vorder": 9,
    "position": 0,
    "text": "نکوهش کند هرک این بشنود"
  },
  {
    "poem_id": 1885,
    "vorder": 10,
    "position": 1,
    "text": "ازین پس به سوگند من نگرود"
  },
  {
    "poem_id": 1885,
    "vorder": 11,
    "position": 0,
    "text": "نخوردم غم خرد فرزند اوی"
  },
  {
    "poem_id": 1885,
    "vorder": 12,
    "position": 1,
    "text": "نه اندیشهٔ خویش و پیوند اوی"
  },
  {
    "poem_id": 1885,
    "vorder": 13,
    "position": 0,
    "text": "چو با ما به فرزند پیوسته شد"
  },
  {
    "poem_id": 1885,
    "vorder": 14,
    "position": 1,
    "text": "به مهر و خرد جان او شسته شد"
  },
  {
    "poem_id": 1885,
    "vorder": 15,
    "position": 0,
    "text": "بفرمود تا شد برادرش پیش"
  },
  {
    "poem_id": 1885,
    "vorder": 16,
    "position": 1,
    "text": "سخن گفت با او ز اندازه بیش"
  },
  {
    "poem_id": 1885,
    "vorder": 17,
    "position": 0,
    "text": "که کسهای بهرام یل را ببین"
  },
  {
    "poem_id": 1885,
    "vorder": 18,
    "position": 1,
    "text": "فراوان برایشان بخواند آفرین"
  },
  {
    "poem_id": 1885,
    "vorder": 19,
    "position": 0,
    "text": "بگو آنک من خود جگر خسته‌ام"
  },
  {
    "poem_id": 1885,
    "vorder": 20,
    "position": 1,
    "text": "بدین سوک تا زنده‌ام بسته‌ام"
  },
  {
    "poem_id": 1885,
    "vorder": 21,
    "position": 0,
    "text": "به خون روی کشور بشستم ز کین"
  },
  {
    "poem_id": 1885,
    "vorder": 22,
    "position": 1,
    "text": "همه شهر نفرین بدو آفرین"
  },
  {
    "poem_id": 1885,
    "vorder": 23,
    "position": 0,
    "text": "بدین درد هر چند کین آورم"
  },
  {
    "poem_id": 1885,
    "vorder": 24,
    "position": 1,
    "text": "وگر آسمان بر زمین آورم"
  },
  {
    "poem_id": 1885,
    "vorder": 25,
    "position": 0,
    "text": "ز فرمان یزدان کسی نگذرد"
  },
  {
    "poem_id": 1885,
    "vorder": 26,
    "position": 1,
    "text": "چنین داند آنکس که دارد خرد"
  },
  {
    "poem_id": 1885,
    "vorder": 27,
    "position": 0,
    "text": "که او را زمانه بران گونه بود"
  },
  {
    "poem_id": 1885,
    "vorder": 28,
    "position": 1,
    "text": "همه تنبل دیو وارونه بود"
  },
  {
    "poem_id": 1885,
    "vorder": 29,
    "position": 0,
    "text": "بران زینهارم که گفتم سخن"
  },
  {
    "poem_id": 1885,
    "vorder": 30,
    "position": 1,
    "text": "بران عهد و پیمان نهادیم بن"
  },
  {
    "poem_id": 1885,
    "vorder": 31,
    "position": 0,
    "text": "سوی گردیه نامه‌ای بد جدا"
  },
  {
    "poem_id": 1885,
    "vorder": 32,
    "position": 1,
    "text": "که ای پاکدامن زن پارسا"
  },
  {
    "poem_id": 1885,
    "vorder": 33,
    "position": 0,
    "text": "همه راستی و همه مردمی"
  },
  {
    "poem_id": 1885,
    "vorder": 34,
    "position": 1,
    "text": "سرشتت فزونی و دور از کمی"
  },
  {
    "poem_id": 1885,
    "vorder": 35,
    "position": 0,
    "text": "ز کار تو اندیشه کردم دراز"
  },
  {
    "poem_id": 1885,
    "vorder": 36,
    "position": 1,
    "text": "نشسته خرد با دل من براز"
  },
  {
    "poem_id": 1885,
    "vorder": 37,
    "position": 0,
    "text": "به از تو ندیدم کسی کدخدای"
  },
  {
    "poem_id": 1885,
    "vorder": 38,
    "position": 1,
    "text": "بیارای ایوان ما را به رای"
  },
  {
    "poem_id": 1885,
    "vorder": 39,
    "position": 0,
    "text": "بدارم تو را همچوجان و تنم"
  },
  {
    "poem_id": 1885,
    "vorder": 40,
    "position": 1,
    "text": "بکوشم که پیمان تو نشکنم"
  },
  {
    "poem_id": 1885,
    "vorder": 41,
    "position": 0,
    "text": "وزان پس بدین شهر فرمان تراست"
  },
  {
    "poem_id": 1885,
    "vorder": 42,
    "position": 1,
    "text": "گروگان کنم دل بدانچت هواست"
  },
  {
    "poem_id": 1885,
    "vorder": 43,
    "position": 0,
    "text": "کنون هرکه داری همه گرد کن"
  },
  {
    "poem_id": 1885,
    "vorder": 44,
    "position": 1,
    "text": "به پیش خردمند گوی این سخن"
  },
  {
    "poem_id": 1885,
    "vorder": 45,
    "position": 0,
    "text": "ازین پس ببین تاچه آیدت رای"
  },
  {
    "poem_id": 1885,
    "vorder": 46,
    "position": 1,
    "text": "به روشن روانت خرد رهنمای"
  },
  {
    "poem_id": 1885,
    "vorder": 47,
    "position": 0,
    "text": "خرد را بران مردمان شاه کن"
  },
  {
    "poem_id": 1885,
    "vorder": 48,
    "position": 1,
    "text": "مرا زآن سگالیده آگاه کن"
  },
  {
    "poem_id": 1885,
    "vorder": 49,
    "position": 0,
    "text": "همی‌رفت برسان قمری ز سرو"
  },
  {
    "poem_id": 1885,
    "vorder": 50,
    "position": 1,
    "text": "بیامد برادرش تازان به مرو"
  },
  {
    "poem_id": 1885,
    "vorder": 51,
    "position": 0,
    "text": "جهانجوی با نامور رام شد"
  },
  {
    "poem_id": 1885,
    "vorder": 52,
    "position": 1,
    "text": "به نزدیک کسهای بهرام شد"
  },
  {
    "poem_id": 1885,
    "vorder": 53,
    "position": 0,
    "text": "بگفت آنچ خاقان بدو گفته بود"
  },
  {
    "poem_id": 1885,
    "vorder": 54,
    "position": 1,
    "text": "که از کین آن کشته آشفته بود"
  },
  {
    "poem_id": 1885,
    "vorder": 55,
    "position": 0,
    "text": "ازان پس چنین گفت کای بخردان"
  },
  {
    "poem_id": 1885,
    "vorder": 56,
    "position": 1,
    "text": "پسندیده و کار دیده ردان"
  },
  {
    "poem_id": 1885,
    "vorder": 57,
    "position": 0,
    "text": "شما را بدین مزد بسیار باد"
  },
  {
    "poem_id": 1885,
    "vorder": 58,
    "position": 1,
    "text": "ورا داور دادگر یار باد"
  },
  {
    "poem_id": 1885,
    "vorder": 59,
    "position": 0,
    "text": "یکی ناگهان مرگ بود آن نه خرد"
  },
  {
    "poem_id": 1885,
    "vorder": 60,
    "position": 1,
    "text": "که کس در جهان ز آن گمانی نبرد"
  },
  {
    "poem_id": 1885,
    "vorder": 61,
    "position": 0,
    "text": "پس آن نامه پنهان به خواهرش داد"
  },
  {
    "poem_id": 1885,
    "vorder": 62,
    "position": 1,
    "text": "سخنهای خاقان همه کرد یاد"
  },
  {
    "poem_id": 1885,
    "vorder": 63,
    "position": 0,
    "text": "ز پیوند وز پند و نیکوسخن"
  },
  {
    "poem_id": 1885,
    "vorder": 64,
    "position": 1,
    "text": "چه از نو چه از روزگار کهن"
  },
  {
    "poem_id": 1885,
    "vorder": 65,
    "position": 0,
    "text": "ز پاکی و از پارسایی زن"
  },
  {
    "poem_id": 1885,
    "vorder": 66,
    "position": 1,
    "text": "که هم غمگسارست و هم رای زن"
  },
  {
    "poem_id": 1885,
    "vorder": 67,
    "position": 0,
    "text": "جوان گفت و آن پاکدامن شنید"
  },
  {
    "poem_id": 1885,
    "vorder": 68,
    "position": 1,
    "text": "ز گفتار او خامشی برگزید"
  },
  {
    "poem_id": 1885,
    "vorder": 69,
    "position": 0,
    "text": "وزان پس چو برخواند آن نامه را"
  },
  {
    "poem_id": 1885,
    "vorder": 70,
    "position": 1,
    "text": "سخنهای خاقان خود کامه را"
  },
  {
    "poem_id": 1885,
    "vorder": 71,
    "position": 0,
    "text": "خرد را چو با دانش انباز کرد"
  },
  {
    "poem_id": 1885,
    "vorder": 72,
    "position": 1,
    "text": "به دل پاسخ نامه را ساز کرد"
  },
  {
    "poem_id": 1885,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت کاین نامه برخواندم"
  },
  {
    "poem_id": 1885,
    "vorder": 74,
    "position": 1,
    "text": "خرد رابر خویش بنشاندم"
  },
  {
    "poem_id": 1885,
    "vorder": 75,
    "position": 0,
    "text": "چنان کرد خاقان که شاهان کنند"
  },
  {
    "poem_id": 1885,
    "vorder": 76,
    "position": 1,
    "text": "جهاندیده و پیشگاهان کنند"
  },
  {
    "poem_id": 1885,
    "vorder": 77,
    "position": 0,
    "text": "بدو باد روشن جهان بین من"
  },
  {
    "poem_id": 1885,
    "vorder": 78,
    "position": 1,
    "text": "که چونین بجوید همی کین من"
  },
  {
    "poem_id": 1885,
    "vorder": 79,
    "position": 0,
    "text": "دل او ز تیمار خسته مباد"
  },
  {
    "poem_id": 1885,
    "vorder": 80,
    "position": 1,
    "text": "امید جهان زو گسسته مباد"
  },
  {
    "poem_id": 1885,
    "vorder": 81,
    "position": 0,
    "text": "مباد ایچ گیتی ز خاقان تهی"
  },
  {
    "poem_id": 1885,
    "vorder": 82,
    "position": 1,
    "text": "بدو شاد بادا کلاه مهی"
  },
  {
    "poem_id": 1885,
    "vorder": 83,
    "position": 0,
    "text": "کنون چون نشستیم با یکدگر"
  },
  {
    "poem_id": 1885,
    "vorder": 84,
    "position": 1,
    "text": "بخوانیم نامه همه سر به سر"
  },
  {
    "poem_id": 1885,
    "vorder": 85,
    "position": 0,
    "text": "بدان کو بزرگست و دارد خرد"
  },
  {
    "poem_id": 1885,
    "vorder": 86,
    "position": 1,
    "text": "یکایک بدین آرزو بنگرد"
  },
  {
    "poem_id": 1885,
    "vorder": 87,
    "position": 0,
    "text": "کنون دوده را سر به سر شیونست"
  },
  {
    "poem_id": 1885,
    "vorder": 88,
    "position": 1,
    "text": "نه هنگامهٔ این سخن گفتنست"
  },
  {
    "poem_id": 1885,
    "vorder": 89,
    "position": 0,
    "text": "چو سوک چنان مهتر آید به سر"
  },
  {
    "poem_id": 1885,
    "vorder": 90,
    "position": 1,
    "text": "ز فرمان خاقان نباشد گذر"
  },
  {
    "poem_id": 1885,
    "vorder": 91,
    "position": 0,
    "text": "مرا خود به ایران شدن روی نیست"
  },
  {
    "poem_id": 1885,
    "vorder": 92,
    "position": 1,
    "text": "زن پاک را به ز تو شوی نیست"
  },
  {
    "poem_id": 1885,
    "vorder": 93,
    "position": 0,
    "text": "اگر من بدین زودی آیم به راه"
  },
  {
    "poem_id": 1885,
    "vorder": 94,
    "position": 1,
    "text": "چه گوید مرا آن خردمند شاه"
  },
  {
    "poem_id": 1885,
    "vorder": 95,
    "position": 0,
    "text": "خردمند بی‌شرم خواند مرا"
  },
  {
    "poem_id": 1885,
    "vorder": 96,
    "position": 1,
    "text": "چو خاقان بی آزرم داند مرا"
  },
  {
    "poem_id": 1885,
    "vorder": 97,
    "position": 0,
    "text": "بدین سوک چون بگذرد چار ماه"
  },
  {
    "poem_id": 1885,
    "vorder": 98,
    "position": 1,
    "text": "سواری فرستم به نزدیک شاه"
  },
  {
    "poem_id": 1885,
    "vorder": 99,
    "position": 0,
    "text": "همه بشنوم هرچ باید شنید"
  },
  {
    "poem_id": 1885,
    "vorder": 100,
    "position": 1,
    "text": "بگویندگان تا چه آید پدید"
  },
  {
    "poem_id": 1885,
    "vorder": 101,
    "position": 0,
    "text": "بگویم یکایک به نامه درون"
  },
  {
    "poem_id": 1885,
    "vorder": 102,
    "position": 1,
    "text": "چو آید به نزدیک او رهنمون"
  },
  {
    "poem_id": 1885,
    "vorder": 103,
    "position": 0,
    "text": "تو اکنون از ایدر به شادی خرام"
  },
  {
    "poem_id": 1885,
    "vorder": 104,
    "position": 1,
    "text": "به خاقان بگو آنچ دادم پیام"
  },
  {
    "poem_id": 1885,
    "vorder": 105,
    "position": 0,
    "text": "فراوان فرستاده را هدیه داد"
  },
  {
    "poem_id": 1885,
    "vorder": 106,
    "position": 1,
    "text": "جهاندیده از مرو برگشت شاد"
  }
]