[
  {
    "poem_id": 1870,
    "vorder": 1,
    "position": 0,
    "text": "ازین سوی خسرو بران رزمگاه"
  },
  {
    "poem_id": 1870,
    "vorder": 2,
    "position": 1,
    "text": "بیامد که بهرام بد با سپاه"
  },
  {
    "poem_id": 1870,
    "vorder": 3,
    "position": 0,
    "text": "همه رزمگاهش به تاراج داد"
  },
  {
    "poem_id": 1870,
    "vorder": 4,
    "position": 1,
    "text": "سپه را همه بدره و تاج داد"
  },
  {
    "poem_id": 1870,
    "vorder": 5,
    "position": 0,
    "text": "یکی بارهٔ تیز رو برنشست"
  },
  {
    "poem_id": 1870,
    "vorder": 6,
    "position": 1,
    "text": "میان را ز بهر پرستش ببست"
  },
  {
    "poem_id": 1870,
    "vorder": 7,
    "position": 0,
    "text": "به پیش اندر آمد یکی خارستان"
  },
  {
    "poem_id": 1870,
    "vorder": 8,
    "position": 1,
    "text": "پیاده ببود اندران کارستان"
  },
  {
    "poem_id": 1870,
    "vorder": 9,
    "position": 0,
    "text": "به غلتید در پیش یزدان به خاک"
  },
  {
    "poem_id": 1870,
    "vorder": 10,
    "position": 1,
    "text": "همی‌گفت کای داور داد و پاک"
  },
  {
    "poem_id": 1870,
    "vorder": 11,
    "position": 0,
    "text": "پی دشمن از بوم برداشتی"
  },
  {
    "poem_id": 1870,
    "vorder": 12,
    "position": 1,
    "text": "همه کار ز اندیشه بگذاشتی"
  },
  {
    "poem_id": 1870,
    "vorder": 13,
    "position": 0,
    "text": "پرستنده و ناسزا بنده‌ام"
  },
  {
    "poem_id": 1870,
    "vorder": 14,
    "position": 1,
    "text": "به فرمان و رایت سرافگنده‌ام"
  },
  {
    "poem_id": 1870,
    "vorder": 15,
    "position": 0,
    "text": "وزان جایگه شد به پرده سرای"
  },
  {
    "poem_id": 1870,
    "vorder": 16,
    "position": 1,
    "text": "بیامد به نزدیک او رهنمای"
  },
  {
    "poem_id": 1870,
    "vorder": 17,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 1870,
    "vorder": 18,
    "position": 1,
    "text": "نوشتند زو نامه‌ای برحریر"
  },
  {
    "poem_id": 1870,
    "vorder": 19,
    "position": 0,
    "text": "ز چیزی که رفت اندران رزمگاه"
  },
  {
    "poem_id": 1870,
    "vorder": 20,
    "position": 1,
    "text": "به قیصر نوشت اندران نامه شاه"
  },
  {
    "poem_id": 1870,
    "vorder": 21,
    "position": 0,
    "text": "نخست آفرین کرد بر دادگر"
  },
  {
    "poem_id": 1870,
    "vorder": 22,
    "position": 1,
    "text": "کزو دید مردی و بخت و هنر"
  },
  {
    "poem_id": 1870,
    "vorder": 23,
    "position": 0,
    "text": "دگر گفت کز کردگار جهان"
  },
  {
    "poem_id": 1870,
    "vorder": 24,
    "position": 1,
    "text": "همه نیکوی دیدم اندر نهان"
  },
  {
    "poem_id": 1870,
    "vorder": 25,
    "position": 0,
    "text": "به آذرگشسپ آمدم با سپاه"
  },
  {
    "poem_id": 1870,
    "vorder": 26,
    "position": 1,
    "text": "دوان پیش بازآمدم کینه خواه"
  },
  {
    "poem_id": 1870,
    "vorder": 27,
    "position": 0,
    "text": "بدان گونه تنگ اندر آمد به جنگ"
  },
  {
    "poem_id": 1870,
    "vorder": 28,
    "position": 1,
    "text": "که بر من ببد کار پیکار تنگ"
  },
  {
    "poem_id": 1870,
    "vorder": 29,
    "position": 0,
    "text": "چو یزدان پاکش نبد دستگیر"
  },
  {
    "poem_id": 1870,
    "vorder": 30,
    "position": 1,
    "text": "بمرد آن دم آتش و دار و گیر"
  },
  {
    "poem_id": 1870,
    "vorder": 31,
    "position": 0,
    "text": "چوبیچاره‌تر گشت و لشکر نماند"
  },
  {
    "poem_id": 1870,
    "vorder": 32,
    "position": 1,
    "text": "گریزان به شبگیر ز آنجا براند"
  },
  {
    "poem_id": 1870,
    "vorder": 33,
    "position": 0,
    "text": "همه لشکرش را بهم بر زدیم"
  },
  {
    "poem_id": 1870,
    "vorder": 34,
    "position": 1,
    "text": "به لشکر گهش آتش اندرزدیم"
  },
  {
    "poem_id": 1870,
    "vorder": 35,
    "position": 0,
    "text": "به فرمان یزدان پیروزگر"
  },
  {
    "poem_id": 1870,
    "vorder": 36,
    "position": 1,
    "text": "ببندم برو نیز راه گذر"
  },
  {
    "poem_id": 1870,
    "vorder": 37,
    "position": 0,
    "text": "نهادند برنامه بر مهرشاه"
  },
  {
    "poem_id": 1870,
    "vorder": 38,
    "position": 1,
    "text": "فرستادگان بر گرفتند راه"
  },
  {
    "poem_id": 1870,
    "vorder": 39,
    "position": 0,
    "text": "فرستاده با نامه شهریار"
  },
  {
    "poem_id": 1870,
    "vorder": 40,
    "position": 1,
    "text": "بشد تا بر قیصر نامدار"
  },
  {
    "poem_id": 1870,
    "vorder": 41,
    "position": 0,
    "text": "چو آن نامه برخواند قیصر ز تخت"
  },
  {
    "poem_id": 1870,
    "vorder": 42,
    "position": 1,
    "text": "فرود آمد آن مرد بیداربخت"
  },
  {
    "poem_id": 1870,
    "vorder": 43,
    "position": 0,
    "text": "به یزدان چنین گفت کای رهنمای"
  },
  {
    "poem_id": 1870,
    "vorder": 44,
    "position": 1,
    "text": "همیشه توی جاودانه بجای"
  },
  {
    "poem_id": 1870,
    "vorder": 45,
    "position": 0,
    "text": "تو پیروز کردی مر آن بنده را"
  },
  {
    "poem_id": 1870,
    "vorder": 46,
    "position": 1,
    "text": "کشنده توی مرد افگنده را"
  },
  {
    "poem_id": 1870,
    "vorder": 47,
    "position": 0,
    "text": "فراوان به درویش دینار داد"
  },
  {
    "poem_id": 1870,
    "vorder": 48,
    "position": 1,
    "text": "همان خوردنیهای بسیار داد"
  },
  {
    "poem_id": 1870,
    "vorder": 49,
    "position": 0,
    "text": "مر آن نامه را نیز پاسخ نوشت"
  },
  {
    "poem_id": 1870,
    "vorder": 50,
    "position": 1,
    "text": "بسان درختی به باغ بهشت"
  },
  {
    "poem_id": 1870,
    "vorder": 51,
    "position": 0,
    "text": "سرنامه کرد از جهاندار یاد"
  },
  {
    "poem_id": 1870,
    "vorder": 52,
    "position": 1,
    "text": "خداوند پیروزی و فرو داد"
  },
  {
    "poem_id": 1870,
    "vorder": 53,
    "position": 0,
    "text": "خداوند ماه و خداوند هور"
  },
  {
    "poem_id": 1870,
    "vorder": 54,
    "position": 1,
    "text": "خداونت پیل و خداوند مور"
  },
  {
    "poem_id": 1870,
    "vorder": 55,
    "position": 0,
    "text": "بزرگی و نیک اختری زو شناس"
  },
  {
    "poem_id": 1870,
    "vorder": 56,
    "position": 1,
    "text": "وزو دار تا زنده باشی سپاس"
  },
  {
    "poem_id": 1870,
    "vorder": 57,
    "position": 0,
    "text": "جز از داد و خوبی مکن در جهان"
  },
  {
    "poem_id": 1870,
    "vorder": 58,
    "position": 1,
    "text": "چه در آشکار و چه اندر نهان"
  },
  {
    "poem_id": 1870,
    "vorder": 59,
    "position": 0,
    "text": "یکی تاج کز قیصران یادگار"
  },
  {
    "poem_id": 1870,
    "vorder": 60,
    "position": 1,
    "text": "همی‌داشتی تا کی آید به کار"
  },
  {
    "poem_id": 1870,
    "vorder": 61,
    "position": 0,
    "text": "همان خسروی طوق با گوشوار"
  },
  {
    "poem_id": 1870,
    "vorder": 62,
    "position": 1,
    "text": "صدوشست تا جامهٔ زرنگار"
  },
  {
    "poem_id": 1870,
    "vorder": 63,
    "position": 0,
    "text": "دگر سی شتر بار دینار بود"
  },
  {
    "poem_id": 1870,
    "vorder": 64,
    "position": 1,
    "text": "همان در و یاقوت بسیار بود"
  },
  {
    "poem_id": 1870,
    "vorder": 65,
    "position": 0,
    "text": "صلیبی فرستاد گوهر نگار"
  },
  {
    "poem_id": 1870,
    "vorder": 66,
    "position": 1,
    "text": "یکی تخت پرگوهر شاهوار"
  },
  {
    "poem_id": 1870,
    "vorder": 67,
    "position": 0,
    "text": "یکی سبز خفتان به زر بافته"
  },
  {
    "poem_id": 1870,
    "vorder": 68,
    "position": 1,
    "text": "بسی شوشه زر برو تافته"
  },
  {
    "poem_id": 1870,
    "vorder": 69,
    "position": 0,
    "text": "ازان فیلسوفان رومی چهار"
  },
  {
    "poem_id": 1870,
    "vorder": 70,
    "position": 1,
    "text": "برفتند با هدیه وبا نثار"
  },
  {
    "poem_id": 1870,
    "vorder": 71,
    "position": 0,
    "text": "چو زان کارها شد به شاه آگهی"
  },
  {
    "poem_id": 1870,
    "vorder": 72,
    "position": 1,
    "text": "ز قیصر شدش کاربا فرهی"
  },
  {
    "poem_id": 1870,
    "vorder": 73,
    "position": 0,
    "text": "پذیره فرستاد خسرو سوار"
  },
  {
    "poem_id": 1870,
    "vorder": 74,
    "position": 1,
    "text": "گرانمایگان گرامی هزار"
  },
  {
    "poem_id": 1870,
    "vorder": 75,
    "position": 0,
    "text": "بزرگان به نزدیک خسرو شدند"
  },
  {
    "poem_id": 1870,
    "vorder": 76,
    "position": 1,
    "text": "همه پاک با هدیه نو شدند"
  },
  {
    "poem_id": 1870,
    "vorder": 77,
    "position": 0,
    "text": "چو خسرو نگه کرد و نامه بخواند"
  },
  {
    "poem_id": 1870,
    "vorder": 78,
    "position": 1,
    "text": "ازان خواسته در شگفتی بماند"
  },
  {
    "poem_id": 1870,
    "vorder": 79,
    "position": 0,
    "text": "به دستور فرمود پس شهریار"
  },
  {
    "poem_id": 1870,
    "vorder": 80,
    "position": 1,
    "text": "که آن جامهٔ روم گوهر نگار"
  },
  {
    "poem_id": 1870,
    "vorder": 81,
    "position": 0,
    "text": "نه آیین پرمایه دهقان بود"
  },
  {
    "poem_id": 1870,
    "vorder": 82,
    "position": 1,
    "text": "کجا جامهٔ جاثلیقان بود"
  },
  {
    "poem_id": 1870,
    "vorder": 83,
    "position": 0,
    "text": "چو بر جامهٔ ما چلیپا بود"
  },
  {
    "poem_id": 1870,
    "vorder": 84,
    "position": 1,
    "text": "نشست اندر آیین ترسا بود"
  },
  {
    "poem_id": 1870,
    "vorder": 85,
    "position": 0,
    "text": "وگر خود نپوشم بیازارد اوی"
  },
  {
    "poem_id": 1870,
    "vorder": 86,
    "position": 1,
    "text": "همانا دگرگونه پندارد اوی"
  },
  {
    "poem_id": 1870,
    "vorder": 87,
    "position": 0,
    "text": "وگر پوشم این نامداران همه"
  },
  {
    "poem_id": 1870,
    "vorder": 88,
    "position": 1,
    "text": "بگویند کاین شهریار رمه"
  },
  {
    "poem_id": 1870,
    "vorder": 89,
    "position": 0,
    "text": "مگر کز پی چیز ترسا شدست"
  },
  {
    "poem_id": 1870,
    "vorder": 90,
    "position": 1,
    "text": "که اندر میان چلیپا شدست"
  },
  {
    "poem_id": 1870,
    "vorder": 91,
    "position": 0,
    "text": "به خسرو چنین گفت پس رهنمای"
  },
  {
    "poem_id": 1870,
    "vorder": 92,
    "position": 1,
    "text": "که دین نیست شاها به پوشش بپای"
  },
  {
    "poem_id": 1870,
    "vorder": 93,
    "position": 0,
    "text": "تو بردین زر دشت پیغمبری"
  },
  {
    "poem_id": 1870,
    "vorder": 94,
    "position": 1,
    "text": "اگر چند پیوسته قیصری"
  },
  {
    "poem_id": 1870,
    "vorder": 95,
    "position": 0,
    "text": "بپوشید پس جامهٔ شهریار"
  },
  {
    "poem_id": 1870,
    "vorder": 96,
    "position": 1,
    "text": "بیاویخت آن تاج گوهرنگار"
  },
  {
    "poem_id": 1870,
    "vorder": 97,
    "position": 0,
    "text": "برفتند رومی و ایرانیان"
  },
  {
    "poem_id": 1870,
    "vorder": 98,
    "position": 1,
    "text": "ز هر گونه مردم اندر میان"
  },
  {
    "poem_id": 1870,
    "vorder": 99,
    "position": 0,
    "text": "کسی کش خرد بود چون جامه دید"
  },
  {
    "poem_id": 1870,
    "vorder": 100,
    "position": 1,
    "text": "بدانست کو رای قیصر گزید"
  },
  {
    "poem_id": 1870,
    "vorder": 101,
    "position": 0,
    "text": "دگر گفت کاین شهریار جهان"
  },
  {
    "poem_id": 1870,
    "vorder": 102,
    "position": 1,
    "text": "همانا که ترسا شد اندر نهان"
  }
]