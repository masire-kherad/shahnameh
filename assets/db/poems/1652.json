[
  {
    "poem_id": 1652,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا رفت پیشش پزشک"
  },
  {
    "poem_id": 1652,
    "vorder": 2,
    "position": 1,
    "text": "که علت بگفتی چو دیدی سرشک"
  },
  {
    "poem_id": 1652,
    "vorder": 3,
    "position": 0,
    "text": "سر دردمندی بدو گفت چیست"
  },
  {
    "poem_id": 1652,
    "vorder": 4,
    "position": 1,
    "text": "که بر درد زان پس بباید گریست"
  },
  {
    "poem_id": 1652,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت هر کس که افزون خورد"
  },
  {
    "poem_id": 1652,
    "vorder": 6,
    "position": 1,
    "text": "چو بر خوان نشیند خورش ننگرد"
  },
  {
    "poem_id": 1652,
    "vorder": 7,
    "position": 0,
    "text": "نباشد فراوان خورش تن درست"
  },
  {
    "poem_id": 1652,
    "vorder": 8,
    "position": 1,
    "text": "بزرگ آنک او تن درستی بجست"
  },
  {
    "poem_id": 1652,
    "vorder": 9,
    "position": 0,
    "text": "بیامیزم اکنون ترا دارویی"
  },
  {
    "poem_id": 1652,
    "vorder": 10,
    "position": 1,
    "text": "گیاها فراز آرم از هر سویی"
  },
  {
    "poem_id": 1652,
    "vorder": 11,
    "position": 0,
    "text": "که همواره باشی تو زان تن درست"
  },
  {
    "poem_id": 1652,
    "vorder": 12,
    "position": 1,
    "text": "نباید به دارو ترا دست شست"
  },
  {
    "poem_id": 1652,
    "vorder": 13,
    "position": 0,
    "text": "همان آرزوها بیفزایدت"
  },
  {
    "poem_id": 1652,
    "vorder": 14,
    "position": 1,
    "text": "چو افزون خوری چیز نگزایدت"
  },
  {
    "poem_id": 1652,
    "vorder": 15,
    "position": 0,
    "text": "همان یاد داری سخنهای نغز"
  },
  {
    "poem_id": 1652,
    "vorder": 16,
    "position": 1,
    "text": "بیفزاید اندر تنت خون و مغز"
  },
  {
    "poem_id": 1652,
    "vorder": 17,
    "position": 0,
    "text": "شوی بر تن خویشتن کامگار"
  },
  {
    "poem_id": 1652,
    "vorder": 18,
    "position": 1,
    "text": "دلت شاد گردد چو خرم بهار"
  },
  {
    "poem_id": 1652,
    "vorder": 19,
    "position": 0,
    "text": "همان رنگ چهرت به جای آورد"
  },
  {
    "poem_id": 1652,
    "vorder": 20,
    "position": 1,
    "text": "به هر کار پاکیزه رای آورد"
  },
  {
    "poem_id": 1652,
    "vorder": 21,
    "position": 0,
    "text": "نگردد پراگنده مویت سپید"
  },
  {
    "poem_id": 1652,
    "vorder": 22,
    "position": 1,
    "text": "ز گیتی سپیدی کند ناامید"
  },
  {
    "poem_id": 1652,
    "vorder": 23,
    "position": 0,
    "text": "سکندر بدو گفت نشنیده‌ام"
  },
  {
    "poem_id": 1652,
    "vorder": 24,
    "position": 1,
    "text": "نه کس را ز شاهان چنین دیده‌ام"
  },
  {
    "poem_id": 1652,
    "vorder": 25,
    "position": 0,
    "text": "گر آری تو این نغز دارو به جای"
  },
  {
    "poem_id": 1652,
    "vorder": 26,
    "position": 1,
    "text": "تو باشی به گیتی مرا رهنمای"
  },
  {
    "poem_id": 1652,
    "vorder": 27,
    "position": 0,
    "text": "خریدار گردم ترا من به جان"
  },
  {
    "poem_id": 1652,
    "vorder": 28,
    "position": 1,
    "text": "شوی بی‌گزند از بد بدگمان"
  },
  {
    "poem_id": 1652,
    "vorder": 29,
    "position": 0,
    "text": "ورا خلعت و نیکویها بساخت"
  },
  {
    "poem_id": 1652,
    "vorder": 30,
    "position": 1,
    "text": "ز دانا پزشکان سرش برفراخت"
  },
  {
    "poem_id": 1652,
    "vorder": 31,
    "position": 0,
    "text": "پزشک سراینده آمد به کوه"
  },
  {
    "poem_id": 1652,
    "vorder": 32,
    "position": 1,
    "text": "بیاورد با خویشتن زان گروه"
  },
  {
    "poem_id": 1652,
    "vorder": 33,
    "position": 0,
    "text": "ز دانایی او را فزون بود بهر"
  },
  {
    "poem_id": 1652,
    "vorder": 34,
    "position": 1,
    "text": "همی زهر بشناخت از پای زهر"
  },
  {
    "poem_id": 1652,
    "vorder": 35,
    "position": 0,
    "text": "گیاهان کوهی فراوان درود"
  },
  {
    "poem_id": 1652,
    "vorder": 36,
    "position": 1,
    "text": "بیفگند زو هرچ بیکار بود"
  },
  {
    "poem_id": 1652,
    "vorder": 37,
    "position": 0,
    "text": "ازو پاک تریاکها برگزید"
  },
  {
    "poem_id": 1652,
    "vorder": 38,
    "position": 1,
    "text": "بیامیخت دارو چنانچون سزید"
  },
  {
    "poem_id": 1652,
    "vorder": 39,
    "position": 0,
    "text": "تنش را به داروی کوهی بشست"
  },
  {
    "poem_id": 1652,
    "vorder": 40,
    "position": 1,
    "text": "همی داشتش سالیان تن درست"
  },
  {
    "poem_id": 1652,
    "vorder": 41,
    "position": 0,
    "text": "چنان شد که او شب نخفتی بسی"
  },
  {
    "poem_id": 1652,
    "vorder": 42,
    "position": 1,
    "text": "بیامیختی شاد با هر کسی"
  },
  {
    "poem_id": 1652,
    "vorder": 43,
    "position": 0,
    "text": "به کار زنان تیز بودی سرش"
  },
  {
    "poem_id": 1652,
    "vorder": 44,
    "position": 1,
    "text": "همی نرم جایی بجستی برش"
  },
  {
    "poem_id": 1652,
    "vorder": 45,
    "position": 0,
    "text": "ازان سوی کاهش گرایید شاه"
  },
  {
    "poem_id": 1652,
    "vorder": 46,
    "position": 1,
    "text": "نکرد اندر آن هیچ تن را نگاه"
  },
  {
    "poem_id": 1652,
    "vorder": 47,
    "position": 0,
    "text": "چنان بد که روزی بیامد پزشک"
  },
  {
    "poem_id": 1652,
    "vorder": 48,
    "position": 1,
    "text": "ز کاهش نشان یافت اندر سرشک"
  },
  {
    "poem_id": 1652,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت کز خفت و خیز زنان"
  },
  {
    "poem_id": 1652,
    "vorder": 50,
    "position": 1,
    "text": "جوان پیر گردد به تن بی‌گمان"
  },
  {
    "poem_id": 1652,
    "vorder": 51,
    "position": 0,
    "text": "برآنم که بی‌خواب بودی سه شب"
  },
  {
    "poem_id": 1652,
    "vorder": 52,
    "position": 1,
    "text": "به من بازگوی این و بگشای لب"
  },
  {
    "poem_id": 1652,
    "vorder": 53,
    "position": 0,
    "text": "سکندر بدو گفت من روشنم"
  },
  {
    "poem_id": 1652,
    "vorder": 54,
    "position": 1,
    "text": "از آزار سستی ندارد تنم"
  },
  {
    "poem_id": 1652,
    "vorder": 55,
    "position": 0,
    "text": "پسندیده دانای هندوستان"
  },
  {
    "poem_id": 1652,
    "vorder": 56,
    "position": 1,
    "text": "نبود اندر آن کار همداستان"
  },
  {
    "poem_id": 1652,
    "vorder": 57,
    "position": 0,
    "text": "چو شب تیره شد آن نبشته بجست"
  },
  {
    "poem_id": 1652,
    "vorder": 58,
    "position": 1,
    "text": "بیاورد داروی کاهش درست"
  },
  {
    "poem_id": 1652,
    "vorder": 59,
    "position": 0,
    "text": "همان نیز تنها سکندر بخفت"
  },
  {
    "poem_id": 1652,
    "vorder": 60,
    "position": 1,
    "text": "نیامیخت با ماه دیدار جفت"
  },
  {
    "poem_id": 1652,
    "vorder": 61,
    "position": 0,
    "text": "به شبگیر هور اندر آمد پزشک"
  },
  {
    "poem_id": 1652,
    "vorder": 62,
    "position": 1,
    "text": "نگه کرد و بی‌بار دیدش سرشک"
  },
  {
    "poem_id": 1652,
    "vorder": 63,
    "position": 0,
    "text": "بینداخت دارو به رامش نشست"
  },
  {
    "poem_id": 1652,
    "vorder": 64,
    "position": 1,
    "text": "یکی جام بگرفت شادان به دست"
  },
  {
    "poem_id": 1652,
    "vorder": 65,
    "position": 0,
    "text": "بفرمود تا خوان بیاراستند"
  },
  {
    "poem_id": 1652,
    "vorder": 66,
    "position": 1,
    "text": "نوازندهٔ رود و می‌خواستند"
  },
  {
    "poem_id": 1652,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت شاه آن چرا ریختی"
  },
  {
    "poem_id": 1652,
    "vorder": 68,
    "position": 1,
    "text": "چو با رنج دارو برآمیختی"
  },
  {
    "poem_id": 1652,
    "vorder": 69,
    "position": 0,
    "text": "ورا گفت شاه جهان دوش جفت"
  },
  {
    "poem_id": 1652,
    "vorder": 70,
    "position": 1,
    "text": "نجست و شب تیره تنها بخفت"
  },
  {
    "poem_id": 1652,
    "vorder": 71,
    "position": 0,
    "text": "چو تنها بخسپی تو ای شهریار"
  },
  {
    "poem_id": 1652,
    "vorder": 72,
    "position": 1,
    "text": "نیاید ترا هیچ دارو به کار"
  },
  {
    "poem_id": 1652,
    "vorder": 73,
    "position": 0,
    "text": "سکندر بخندید و زو شاد شد"
  },
  {
    "poem_id": 1652,
    "vorder": 74,
    "position": 1,
    "text": "ز تیمار وز درد آزاد شد"
  },
  {
    "poem_id": 1652,
    "vorder": 75,
    "position": 0,
    "text": "وزان پس ز داننده دل کرد شاد"
  },
  {
    "poem_id": 1652,
    "vorder": 76,
    "position": 1,
    "text": "ورا گفت بی‌هند گیتی مباد"
  },
  {
    "poem_id": 1652,
    "vorder": 77,
    "position": 0,
    "text": "بزرگان و اخترشناسان همه"
  },
  {
    "poem_id": 1652,
    "vorder": 78,
    "position": 1,
    "text": "تو گویی به هندوستان شد رمه"
  },
  {
    "poem_id": 1652,
    "vorder": 79,
    "position": 0,
    "text": "وزانجا بیامد سوی خان خویش"
  },
  {
    "poem_id": 1652,
    "vorder": 80,
    "position": 1,
    "text": "همه شب همی ساخت درمان خویش"
  },
  {
    "poem_id": 1652,
    "vorder": 81,
    "position": 0,
    "text": "چو برزد سر از کوه روشن چراغ"
  },
  {
    "poem_id": 1652,
    "vorder": 82,
    "position": 1,
    "text": "چو دریا فروزنده شد دشت و راغ"
  },
  {
    "poem_id": 1652,
    "vorder": 83,
    "position": 0,
    "text": "سکندر بیامد بران بارگاه"
  },
  {
    "poem_id": 1652,
    "vorder": 84,
    "position": 1,
    "text": "دو لب پر ز خنده دل از غم تباه"
  },
  {
    "poem_id": 1652,
    "vorder": 85,
    "position": 0,
    "text": "فرستاده را دید سالار بار"
  },
  {
    "poem_id": 1652,
    "vorder": 86,
    "position": 1,
    "text": "بپرسید و بردش بر شهریار"
  },
  {
    "poem_id": 1652,
    "vorder": 87,
    "position": 0,
    "text": "یکی بدره دینار و اسپی سیاه"
  },
  {
    "poem_id": 1652,
    "vorder": 88,
    "position": 1,
    "text": "بهرای زرین بفرمود شاه"
  },
  {
    "poem_id": 1652,
    "vorder": 89,
    "position": 0,
    "text": "پزشک خردمند را داد و گفت"
  },
  {
    "poem_id": 1652,
    "vorder": 90,
    "position": 1,
    "text": "که با پاک رایت خرد باد جفت"
  }
]