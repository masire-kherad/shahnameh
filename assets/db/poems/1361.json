[
  {
    "poem_id": 1361,
    "vorder": 1,
    "position": 0,
    "text": "سوی خانه رفتند هر سه چوباد"
  },
  {
    "poem_id": 1361,
    "vorder": 2,
    "position": 1,
    "text": "شب آمد بخفتند پیروز و شاد"
  },
  {
    "poem_id": 1361,
    "vorder": 3,
    "position": 0,
    "text": "چو خورشید زد عکس برآسمان"
  },
  {
    "poem_id": 1361,
    "vorder": 4,
    "position": 1,
    "text": "پراگند بر لاژورد ارغوان"
  },
  {
    "poem_id": 1361,
    "vorder": 5,
    "position": 0,
    "text": "برفتند و هر سه بیاراستند"
  },
  {
    "poem_id": 1361,
    "vorder": 6,
    "position": 1,
    "text": "ابا خویشتن موبدان خواستند"
  },
  {
    "poem_id": 1361,
    "vorder": 7,
    "position": 0,
    "text": "کشیدند با لشکری چون سپهر"
  },
  {
    "poem_id": 1361,
    "vorder": 8,
    "position": 1,
    "text": "همه نامداران خورشیدچهر"
  },
  {
    "poem_id": 1361,
    "vorder": 9,
    "position": 0,
    "text": "چو از آمدنشان شد آگاه سرو"
  },
  {
    "poem_id": 1361,
    "vorder": 10,
    "position": 1,
    "text": "بیاراست لشکر چو پر تذرو"
  },
  {
    "poem_id": 1361,
    "vorder": 11,
    "position": 0,
    "text": "فرستادشان لشکری گشن پیش"
  },
  {
    "poem_id": 1361,
    "vorder": 12,
    "position": 1,
    "text": "چه بیگانه فرزانگان و چه خویش"
  },
  {
    "poem_id": 1361,
    "vorder": 13,
    "position": 0,
    "text": "شدند این سه پرمایه اندر یمن"
  },
  {
    "poem_id": 1361,
    "vorder": 14,
    "position": 1,
    "text": "برون آمدند از یمن مرد و زن"
  },
  {
    "poem_id": 1361,
    "vorder": 15,
    "position": 0,
    "text": "همی گوهر و زعفران ریختند"
  },
  {
    "poem_id": 1361,
    "vorder": 16,
    "position": 1,
    "text": "همی مشک با می برآمیختند"
  },
  {
    "poem_id": 1361,
    "vorder": 17,
    "position": 0,
    "text": "همه یال اسپان پر از مشک و می"
  },
  {
    "poem_id": 1361,
    "vorder": 18,
    "position": 1,
    "text": "پراگنده دینار در زیر پی"
  },
  {
    "poem_id": 1361,
    "vorder": 19,
    "position": 0,
    "text": "نشستن گهی ساخت شاه یمن"
  },
  {
    "poem_id": 1361,
    "vorder": 20,
    "position": 1,
    "text": "همه نامداران شدند انجمن"
  },
  {
    "poem_id": 1361,
    "vorder": 21,
    "position": 0,
    "text": "در گنجهای کهن کرد باز"
  },
  {
    "poem_id": 1361,
    "vorder": 22,
    "position": 1,
    "text": "گشاد آنچه یک چند گه بود راز"
  },
  {
    "poem_id": 1361,
    "vorder": 23,
    "position": 0,
    "text": "سه خورشید رخ را چو باغ بهشت"
  },
  {
    "poem_id": 1361,
    "vorder": 24,
    "position": 1,
    "text": "که موبد چو ایشان صنوبر نکشت"
  },
  {
    "poem_id": 1361,
    "vorder": 25,
    "position": 0,
    "text": "ابا تاج و با گنج نادیده رنج"
  },
  {
    "poem_id": 1361,
    "vorder": 26,
    "position": 1,
    "text": "مگر زلفشان دیده رنج شکنج"
  },
  {
    "poem_id": 1361,
    "vorder": 27,
    "position": 0,
    "text": "بیاورد هر سه بدیشان سپرد"
  },
  {
    "poem_id": 1361,
    "vorder": 28,
    "position": 1,
    "text": "که سه ماه نو بود و سه شاه گرد"
  },
  {
    "poem_id": 1361,
    "vorder": 29,
    "position": 0,
    "text": "ز کینه به دل گفت شاه یمن"
  },
  {
    "poem_id": 1361,
    "vorder": 30,
    "position": 1,
    "text": "که از آفریدون بد آمد به من"
  },
  {
    "poem_id": 1361,
    "vorder": 31,
    "position": 0,
    "text": "بد از من که هرگز مبادم میان"
  },
  {
    "poem_id": 1361,
    "vorder": 32,
    "position": 1,
    "text": "که ماده شد از تخم نره کیان"
  },
  {
    "poem_id": 1361,
    "vorder": 33,
    "position": 0,
    "text": "به اختر کس آن‌دان که دخترش نیست"
  },
  {
    "poem_id": 1361,
    "vorder": 34,
    "position": 1,
    "text": "چو دختر بود روشن اخترش نیست"
  },
  {
    "poem_id": 1361,
    "vorder": 35,
    "position": 0,
    "text": "به پیش همه موبدان سرو گفت"
  },
  {
    "poem_id": 1361,
    "vorder": 36,
    "position": 1,
    "text": "که زیبا بود ماه را شاه جفت"
  },
  {
    "poem_id": 1361,
    "vorder": 37,
    "position": 0,
    "text": "بدانید کین سه جهان بین خویش"
  },
  {
    "poem_id": 1361,
    "vorder": 38,
    "position": 1,
    "text": "سپردم بدیشان بر آیین خویش"
  },
  {
    "poem_id": 1361,
    "vorder": 39,
    "position": 0,
    "text": "بدان تا چو دیده بدارندشان"
  },
  {
    "poem_id": 1361,
    "vorder": 40,
    "position": 1,
    "text": "چو جان پیش دل بر نگارندشان"
  },
  {
    "poem_id": 1361,
    "vorder": 41,
    "position": 0,
    "text": "خروشید و بار غریبان ببست"
  },
  {
    "poem_id": 1361,
    "vorder": 42,
    "position": 1,
    "text": "ابر پشت شرزه هیونان مست"
  },
  {
    "poem_id": 1361,
    "vorder": 43,
    "position": 0,
    "text": "ز گوهر یمن گشت افروخته"
  },
  {
    "poem_id": 1361,
    "vorder": 44,
    "position": 1,
    "text": "عماری یک اندردگر دوخته"
  },
  {
    "poem_id": 1361,
    "vorder": 45,
    "position": 0,
    "text": "چو فرزند را باشد آئین و فر"
  },
  {
    "poem_id": 1361,
    "vorder": 46,
    "position": 1,
    "text": "گرامی به دل بر چه ماده چه نر"
  },
  {
    "poem_id": 1361,
    "vorder": 47,
    "position": 0,
    "text": "به سوی فریدون نهادند روی"
  },
  {
    "poem_id": 1361,
    "vorder": 48,
    "position": 1,
    "text": "جوانان بینادل راه جوی"
  }
]