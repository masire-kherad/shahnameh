[
  {
    "poem_id": 88043,
    "vorder": 1,
    "position": 0,
    "text": "نخستین فریبرز نیو دلیر"
  },
  {
    "poem_id": 88043,
    "vorder": 2,
    "position": 1,
    "text": "ز لشکر برون تاخت بر سان شیر"
  },
  {
    "poem_id": 88043,
    "vorder": 3,
    "position": 0,
    "text": "به نزدیک کلباد ویسه دمان"
  },
  {
    "poem_id": 88043,
    "vorder": 4,
    "position": 1,
    "text": "بیامد به زه برنهاده کمان"
  },
  {
    "poem_id": 88043,
    "vorder": 5,
    "position": 0,
    "text": "همی گشت و تیرش نیامد چو خواست"
  },
  {
    "poem_id": 88043,
    "vorder": 6,
    "position": 1,
    "text": "کشید آن پرنداور از دست راست"
  },
  {
    "poem_id": 88043,
    "vorder": 7,
    "position": 0,
    "text": "برآورد و زد تیغ بر گردنش"
  },
  {
    "poem_id": 88043,
    "vorder": 8,
    "position": 1,
    "text": "به دو نیم شد تا کمرگه تنش"
  },
  {
    "poem_id": 88043,
    "vorder": 9,
    "position": 0,
    "text": "فرود آمد از اسب و بگشاد بند"
  },
  {
    "poem_id": 88043,
    "vorder": 10,
    "position": 1,
    "text": "ز فتراک خویش آن کیانی کمند"
  },
  {
    "poem_id": 88043,
    "vorder": 11,
    "position": 0,
    "text": "ببست از بر باره کلباد را"
  },
  {
    "poem_id": 88043,
    "vorder": 12,
    "position": 1,
    "text": "گشاد از برش بند پولاد را"
  },
  {
    "poem_id": 88043,
    "vorder": 13,
    "position": 0,
    "text": "به بالا برآمد به پیروز نام"
  },
  {
    "poem_id": 88043,
    "vorder": 14,
    "position": 1,
    "text": "خروشی برآورد و بگذارد گام"
  },
  {
    "poem_id": 88043,
    "vorder": 15,
    "position": 0,
    "text": "که سالار ما باد پیروزگر"
  },
  {
    "poem_id": 88043,
    "vorder": 16,
    "position": 1,
    "text": "همه دشمن شاه خسته‌جگر"
  }
]