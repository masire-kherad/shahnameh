[
  {
    "poem_id": 87958,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد بنزد فرود"
  },
  {
    "poem_id": 87958,
    "vorder": 2,
    "position": 1,
    "text": "که شد روی خورشید تابان کبود"
  },
  {
    "poem_id": 87958,
    "vorder": 3,
    "position": 0,
    "text": "ز نعل ستوران وز پای پیل"
  },
  {
    "poem_id": 87958,
    "vorder": 4,
    "position": 1,
    "text": "جهان شد بکردار دریای نیل"
  },
  {
    "poem_id": 87958,
    "vorder": 5,
    "position": 0,
    "text": "چو بشنید ناکار دیده جوان"
  },
  {
    "poem_id": 87958,
    "vorder": 6,
    "position": 1,
    "text": "دلش گشت پر درد و تیره روان"
  },
  {
    "poem_id": 87958,
    "vorder": 7,
    "position": 0,
    "text": "بفرمود تا هرچ بودش یله"
  },
  {
    "poem_id": 87958,
    "vorder": 8,
    "position": 1,
    "text": "هیونان وز گوسفندان گله"
  },
  {
    "poem_id": 87958,
    "vorder": 9,
    "position": 0,
    "text": "فسیله ببند اندر آرند نیز"
  },
  {
    "poem_id": 87958,
    "vorder": 10,
    "position": 1,
    "text": "نماند ایچ بر کوه و بر دشت چیز"
  },
  {
    "poem_id": 87958,
    "vorder": 11,
    "position": 0,
    "text": "همه پاک سوی سپد کوه برد"
  },
  {
    "poem_id": 87958,
    "vorder": 12,
    "position": 1,
    "text": "ببند اندرون سوی انبوه برد"
  },
  {
    "poem_id": 87958,
    "vorder": 13,
    "position": 0,
    "text": "جریره زنی بود مام فرود"
  },
  {
    "poem_id": 87958,
    "vorder": 14,
    "position": 1,
    "text": "ز بهر سیاوش دلش پر ز دود"
  },
  {
    "poem_id": 87958,
    "vorder": 15,
    "position": 0,
    "text": "بر مادر آمد فرود جوان"
  },
  {
    "poem_id": 87958,
    "vorder": 16,
    "position": 1,
    "text": "بدو گفت کای مام روشن‌روان"
  },
  {
    "poem_id": 87958,
    "vorder": 17,
    "position": 0,
    "text": "از ایران سپاه آمد و پیل و کوس"
  },
  {
    "poem_id": 87958,
    "vorder": 18,
    "position": 1,
    "text": "بپیش سپه در سرافراز طوس"
  },
  {
    "poem_id": 87958,
    "vorder": 19,
    "position": 0,
    "text": "چه گویی چه باید کنون ساختن"
  },
  {
    "poem_id": 87958,
    "vorder": 20,
    "position": 1,
    "text": "نباید که آرد یکی تاختن"
  },
  {
    "poem_id": 87958,
    "vorder": 21,
    "position": 0,
    "text": "جریره بدو گفت کای رزمساز"
  },
  {
    "poem_id": 87958,
    "vorder": 22,
    "position": 1,
    "text": "بدین روز هرگز مبادت نیاز"
  },
  {
    "poem_id": 87958,
    "vorder": 23,
    "position": 0,
    "text": "بایران برادرت شاه نوست"
  },
  {
    "poem_id": 87958,
    "vorder": 24,
    "position": 1,
    "text": "جهاندار و بیدار کیخسروست"
  },
  {
    "poem_id": 87958,
    "vorder": 25,
    "position": 0,
    "text": "ترا نیک داند به نام و گهر"
  },
  {
    "poem_id": 87958,
    "vorder": 26,
    "position": 1,
    "text": "ز هم خون وز مهرهٔ یک پدر"
  },
  {
    "poem_id": 87958,
    "vorder": 27,
    "position": 0,
    "text": "برادرت گر کینه جوید همی"
  },
  {
    "poem_id": 87958,
    "vorder": 28,
    "position": 1,
    "text": "روان سیاوش بشوید همی"
  },
  {
    "poem_id": 87958,
    "vorder": 29,
    "position": 0,
    "text": "گر او کینه جوید همی از نیا"
  },
  {
    "poem_id": 87958,
    "vorder": 30,
    "position": 1,
    "text": "ترا کینه زیباتر و کیمیا"
  },
  {
    "poem_id": 87958,
    "vorder": 31,
    "position": 0,
    "text": "برت را بخفتان رومی بپوش"
  },
  {
    "poem_id": 87958,
    "vorder": 32,
    "position": 1,
    "text": "برو دل پر از جوش و سر پر خروش"
  },
  {
    "poem_id": 87958,
    "vorder": 33,
    "position": 0,
    "text": "به پیش سپاه برادر برو"
  },
  {
    "poem_id": 87958,
    "vorder": 34,
    "position": 1,
    "text": "تو کینخواه نو باش و او شاه نو"
  },
  {
    "poem_id": 87958,
    "vorder": 35,
    "position": 0,
    "text": "که زیبد کز این غم بنالد پلنگ"
  },
  {
    "poem_id": 87958,
    "vorder": 36,
    "position": 1,
    "text": "ز دریا خروشان برآید نهنگ"
  },
  {
    "poem_id": 87958,
    "vorder": 37,
    "position": 0,
    "text": "وگر مرغ با ماهیان اندر آب"
  },
  {
    "poem_id": 87958,
    "vorder": 38,
    "position": 1,
    "text": "بخوانند نفرین به افراسیاب"
  },
  {
    "poem_id": 87958,
    "vorder": 39,
    "position": 0,
    "text": "که اندر جهان چون سیاوش سوار"
  },
  {
    "poem_id": 87958,
    "vorder": 40,
    "position": 1,
    "text": "نبندد کمر نیز یک نامدار"
  },
  {
    "poem_id": 87958,
    "vorder": 41,
    "position": 0,
    "text": "به گردی و مردی و جنگ و نژاد"
  },
  {
    "poem_id": 87958,
    "vorder": 42,
    "position": 1,
    "text": "باورنگ و فرهنگ و سنگ و بداد"
  },
  {
    "poem_id": 87958,
    "vorder": 43,
    "position": 0,
    "text": "بدو داد پیران مرا از نخست"
  },
  {
    "poem_id": 87958,
    "vorder": 44,
    "position": 1,
    "text": "وگر نه ز ترکان همی زن نجست"
  },
  {
    "poem_id": 87958,
    "vorder": 45,
    "position": 0,
    "text": "نژاد تو از مادر و از پدر"
  },
  {
    "poem_id": 87958,
    "vorder": 46,
    "position": 1,
    "text": "همه تاجدار و همه نامور"
  },
  {
    "poem_id": 87958,
    "vorder": 47,
    "position": 0,
    "text": "تو پور چنان نامور مهتری"
  },
  {
    "poem_id": 87958,
    "vorder": 48,
    "position": 1,
    "text": "ز تخم کیانی و کی‌منظری"
  },
  {
    "poem_id": 87958,
    "vorder": 49,
    "position": 0,
    "text": "کمربست باید بکین پدر"
  },
  {
    "poem_id": 87958,
    "vorder": 50,
    "position": 1,
    "text": "بجای آوریدن نژاد و گهر"
  },
  {
    "poem_id": 87958,
    "vorder": 51,
    "position": 0,
    "text": "چنین گفت ازان پس بمادر فرود"
  },
  {
    "poem_id": 87958,
    "vorder": 52,
    "position": 1,
    "text": "کز ایران سخن با که باید سرود"
  },
  {
    "poem_id": 87958,
    "vorder": 53,
    "position": 0,
    "text": "که باید که باشد مرا پایمرد"
  },
  {
    "poem_id": 87958,
    "vorder": 54,
    "position": 1,
    "text": "ازین سرفرازان روز نبرد"
  },
  {
    "poem_id": 87958,
    "vorder": 55,
    "position": 0,
    "text": "کز ایشان ندانم کسی را بنام"
  },
  {
    "poem_id": 87958,
    "vorder": 56,
    "position": 1,
    "text": "نیامد بر من درود و پیام"
  },
  {
    "poem_id": 87958,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت ز ایدر برو با تخوار"
  },
  {
    "poem_id": 87958,
    "vorder": 58,
    "position": 1,
    "text": "مدار این سخن بر دل خویش خوار"
  },
  {
    "poem_id": 87958,
    "vorder": 59,
    "position": 0,
    "text": "کز ایران که و مه شناسد همه"
  },
  {
    "poem_id": 87958,
    "vorder": 60,
    "position": 1,
    "text": "بگوید نشان شبان و رمه"
  },
  {
    "poem_id": 87958,
    "vorder": 61,
    "position": 0,
    "text": "ز بهرام وز زنگهٔ شاوران"
  },
  {
    "poem_id": 87958,
    "vorder": 62,
    "position": 1,
    "text": "نشان جو ز گردان و جنگ‌آوران"
  },
  {
    "poem_id": 87958,
    "vorder": 63,
    "position": 0,
    "text": "همیشه سر و نام تو زنده باد"
  },
  {
    "poem_id": 87958,
    "vorder": 64,
    "position": 1,
    "text": "روان سیاوش فروزنده باد"
  },
  {
    "poem_id": 87958,
    "vorder": 65,
    "position": 0,
    "text": "ازین هر دو هرگز نگشتی جدای"
  },
  {
    "poem_id": 87958,
    "vorder": 66,
    "position": 1,
    "text": "کنارنگ بودند و او پادشای"
  },
  {
    "poem_id": 87958,
    "vorder": 67,
    "position": 0,
    "text": "نشان خواه ازین دو گو سرفراز"
  },
  {
    "poem_id": 87958,
    "vorder": 68,
    "position": 1,
    "text": "کز ایشان مرا و ترا نیست راز"
  },
  {
    "poem_id": 87958,
    "vorder": 69,
    "position": 0,
    "text": "سران را و گردنکشان را بخوان"
  },
  {
    "poem_id": 87958,
    "vorder": 70,
    "position": 1,
    "text": "می و خلعت آرای و بالا و خوان"
  },
  {
    "poem_id": 87958,
    "vorder": 71,
    "position": 0,
    "text": "ز گیتی برادر ترا گنج بس"
  },
  {
    "poem_id": 87958,
    "vorder": 72,
    "position": 1,
    "text": "همان کین و آیین به بیگانه کس"
  },
  {
    "poem_id": 87958,
    "vorder": 73,
    "position": 0,
    "text": "سپه را تو باش این زمان پیش رو"
  },
  {
    "poem_id": 87958,
    "vorder": 74,
    "position": 1,
    "text": "تویی کینه‌خواه جهاندار نو"
  },
  {
    "poem_id": 87958,
    "vorder": 75,
    "position": 0,
    "text": "ترا پیش باید بکین ساختن"
  },
  {
    "poem_id": 87958,
    "vorder": 76,
    "position": 1,
    "text": "کمر بر میان بستن و تاختن"
  },
  {
    "poem_id": 87958,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت رای تو ای شیر زن"
  },
  {
    "poem_id": 87958,
    "vorder": 78,
    "position": 1,
    "text": "درفشان کند دوده و انجمن"
  },
  {
    "poem_id": 87958,
    "vorder": 79,
    "position": 0,
    "text": "چو برخاست آوای کوس از چرم"
  },
  {
    "poem_id": 87958,
    "vorder": 80,
    "position": 1,
    "text": "جهان کرد چون آبنوس از میم"
  },
  {
    "poem_id": 87958,
    "vorder": 81,
    "position": 0,
    "text": "یکی دیده‌بان آمد از دیده‌گاه"
  },
  {
    "poem_id": 87958,
    "vorder": 82,
    "position": 1,
    "text": "سخن گفت با او ز ایران سپاه"
  },
  {
    "poem_id": 87958,
    "vorder": 83,
    "position": 0,
    "text": "که دشت و در و کوه پر لشکرست"
  },
  {
    "poem_id": 87958,
    "vorder": 84,
    "position": 1,
    "text": "تو خورشید گویی ببند اندرست"
  },
  {
    "poem_id": 87958,
    "vorder": 85,
    "position": 0,
    "text": "ز دربند دژ تا بیابان گنگ"
  },
  {
    "poem_id": 87958,
    "vorder": 86,
    "position": 1,
    "text": "سپاهست و پیلان و مردان جنگ"
  },
  {
    "poem_id": 87958,
    "vorder": 87,
    "position": 0,
    "text": "فرود از در دژ فرو هشت بند"
  },
  {
    "poem_id": 87958,
    "vorder": 88,
    "position": 1,
    "text": "نگه کرد لشکر ز کوه بلند"
  },
  {
    "poem_id": 87958,
    "vorder": 89,
    "position": 0,
    "text": "وزان پس بیامد در دژ ببست"
  },
  {
    "poem_id": 87958,
    "vorder": 90,
    "position": 1,
    "text": "یکی بارهٔ تیز رو بر نشست"
  },
  {
    "poem_id": 87958,
    "vorder": 91,
    "position": 0,
    "text": "برفتند پویان تخوار و فرود"
  },
  {
    "poem_id": 87958,
    "vorder": 92,
    "position": 1,
    "text": "جوان را سر بخت بر گرد بود"
  },
  {
    "poem_id": 87958,
    "vorder": 93,
    "position": 0,
    "text": "از افراز چون کژ گردد سپهر"
  },
  {
    "poem_id": 87958,
    "vorder": 94,
    "position": 1,
    "text": "نه تندی بکار آید از بن نه مهر"
  },
  {
    "poem_id": 87958,
    "vorder": 95,
    "position": 0,
    "text": "گزیدند تیغ یکی برز کوه"
  },
  {
    "poem_id": 87958,
    "vorder": 96,
    "position": 1,
    "text": "که دیدار بد یکسر ایران گروه"
  },
  {
    "poem_id": 87958,
    "vorder": 97,
    "position": 0,
    "text": "جوان با تخوار سرایند گفت"
  },
  {
    "poem_id": 87958,
    "vorder": 98,
    "position": 1,
    "text": "که هر چت بپرسم نباید نهفت"
  },
  {
    "poem_id": 87958,
    "vorder": 99,
    "position": 0,
    "text": "کنارنگ وز هرک دارد درفش"
  },
  {
    "poem_id": 87958,
    "vorder": 100,
    "position": 1,
    "text": "خداوند گوپال و زرینه کفش"
  },
  {
    "poem_id": 87958,
    "vorder": 101,
    "position": 0,
    "text": "چو بینی به من نام ایشان بگوی"
  },
  {
    "poem_id": 87958,
    "vorder": 102,
    "position": 1,
    "text": "کسی را که دانی از ایران بروی"
  }
]