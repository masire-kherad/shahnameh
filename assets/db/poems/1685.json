[
  {
    "poem_id": 1685,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس بیامد دوان مادرش"
  },
  {
    "poem_id": 1685,
    "vorder": 2,
    "position": 1,
    "text": "فراوان بمالید رخ بر برش"
  },
  {
    "poem_id": 1685,
    "vorder": 3,
    "position": 0,
    "text": "همی گفت کای نامور پادشا"
  },
  {
    "poem_id": 1685,
    "vorder": 4,
    "position": 1,
    "text": "جهاندار و نیک‌اختر و پارسا"
  },
  {
    "poem_id": 1685,
    "vorder": 5,
    "position": 0,
    "text": "به نزدیکی اندر تو دوری ز من"
  },
  {
    "poem_id": 1685,
    "vorder": 6,
    "position": 1,
    "text": "هم از دوده و لشکر و انجمن"
  },
  {
    "poem_id": 1685,
    "vorder": 7,
    "position": 0,
    "text": "روانم روان ترا بنده باد"
  },
  {
    "poem_id": 1685,
    "vorder": 8,
    "position": 1,
    "text": "دل هرک زین شاد شد کنده باد"
  },
  {
    "poem_id": 1685,
    "vorder": 9,
    "position": 0,
    "text": "ازان پس بشد روشنک پر ز درد"
  },
  {
    "poem_id": 1685,
    "vorder": 10,
    "position": 1,
    "text": "چنین گفت کای شاه آزادمرد"
  },
  {
    "poem_id": 1685,
    "vorder": 11,
    "position": 0,
    "text": "جهاندار دارای دارا کجاست"
  },
  {
    "poem_id": 1685,
    "vorder": 12,
    "position": 1,
    "text": "کزو داشت گیتی همی پشت راست"
  },
  {
    "poem_id": 1685,
    "vorder": 13,
    "position": 0,
    "text": "همان خسرو و اشک و فریان و فور"
  },
  {
    "poem_id": 1685,
    "vorder": 14,
    "position": 1,
    "text": "همان نامور خسرو شهرزور"
  },
  {
    "poem_id": 1685,
    "vorder": 15,
    "position": 0,
    "text": "دگر شهریاران که روز نبرد"
  },
  {
    "poem_id": 1685,
    "vorder": 16,
    "position": 1,
    "text": "سرانشان ز باد اندر آمد به گرد"
  },
  {
    "poem_id": 1685,
    "vorder": 17,
    "position": 0,
    "text": "چو ابری بدی تند و بارش تگرگ"
  },
  {
    "poem_id": 1685,
    "vorder": 18,
    "position": 1,
    "text": "ترا گفتم ایمن شدستی ز مرگ"
  },
  {
    "poem_id": 1685,
    "vorder": 19,
    "position": 0,
    "text": "ز بس رزم و پیکار و خون ریختن"
  },
  {
    "poem_id": 1685,
    "vorder": 20,
    "position": 1,
    "text": "چه تنها چه با لشکر آویختن"
  },
  {
    "poem_id": 1685,
    "vorder": 21,
    "position": 0,
    "text": "زمانه ترا داد گفتم جواز"
  },
  {
    "poem_id": 1685,
    "vorder": 22,
    "position": 1,
    "text": "همی داری از مردم خویش راز"
  },
  {
    "poem_id": 1685,
    "vorder": 23,
    "position": 0,
    "text": "چو کردی جهان از بزرگان تهی"
  },
  {
    "poem_id": 1685,
    "vorder": 24,
    "position": 1,
    "text": "بینداختی تاج شاهنشهی"
  },
  {
    "poem_id": 1685,
    "vorder": 25,
    "position": 0,
    "text": "درختی که کشتی چو آمد به بار"
  },
  {
    "poem_id": 1685,
    "vorder": 26,
    "position": 1,
    "text": "دل خاک بینم ترا غمگسار"
  },
  {
    "poem_id": 1685,
    "vorder": 27,
    "position": 0,
    "text": "چو تاج سپهر اندر آمد به زیر"
  },
  {
    "poem_id": 1685,
    "vorder": 28,
    "position": 1,
    "text": "بزرگان ز گفتار گشتند سیر"
  },
  {
    "poem_id": 1685,
    "vorder": 29,
    "position": 0,
    "text": "نهفتند صندوق او را به خاک"
  },
  {
    "poem_id": 1685,
    "vorder": 30,
    "position": 1,
    "text": "ندارد جهان از چنین ترس و باک"
  },
  {
    "poem_id": 1685,
    "vorder": 31,
    "position": 0,
    "text": "ز باد اندر آرد برد سوی دم"
  },
  {
    "poem_id": 1685,
    "vorder": 32,
    "position": 1,
    "text": "نه دادست پیدا نه پیدا ستم"
  },
  {
    "poem_id": 1685,
    "vorder": 33,
    "position": 0,
    "text": "نیابی به چون و چرا نیز راه"
  },
  {
    "poem_id": 1685,
    "vorder": 34,
    "position": 1,
    "text": "نه کهتر برین دست یابد نه شاه"
  },
  {
    "poem_id": 1685,
    "vorder": 35,
    "position": 0,
    "text": "همه نیکوی باید و مردمی"
  },
  {
    "poem_id": 1685,
    "vorder": 36,
    "position": 1,
    "text": "جوانمردی و خوردن و خرمی"
  },
  {
    "poem_id": 1685,
    "vorder": 37,
    "position": 0,
    "text": "جز اینت نبینم همی بهره‌ای"
  },
  {
    "poem_id": 1685,
    "vorder": 38,
    "position": 1,
    "text": "اگر کهتر آیی وگر شهره‌ای"
  },
  {
    "poem_id": 1685,
    "vorder": 39,
    "position": 0,
    "text": "اگر ماند ایدر ز تو نام زشت"
  },
  {
    "poem_id": 1685,
    "vorder": 40,
    "position": 1,
    "text": "بدانجا نیایی تو خرم بهشت"
  },
  {
    "poem_id": 1685,
    "vorder": 41,
    "position": 0,
    "text": "چنین است رسم سرای کهن"
  },
  {
    "poem_id": 1685,
    "vorder": 42,
    "position": 1,
    "text": "سکندر شد و ماند ایدر سخن"
  },
  {
    "poem_id": 1685,
    "vorder": 43,
    "position": 0,
    "text": "چو او سی و شش پادشا را بکشت"
  },
  {
    "poem_id": 1685,
    "vorder": 44,
    "position": 1,
    "text": "نگر تا چه دارد ز گیتی به مشت"
  },
  {
    "poem_id": 1685,
    "vorder": 45,
    "position": 0,
    "text": "برآورد پرمایه ده شارستان"
  },
  {
    "poem_id": 1685,
    "vorder": 46,
    "position": 1,
    "text": "شد آن شارستانها کنون خارستان"
  },
  {
    "poem_id": 1685,
    "vorder": 47,
    "position": 0,
    "text": "بجست آنچ هرگز نجستست کس"
  },
  {
    "poem_id": 1685,
    "vorder": 48,
    "position": 1,
    "text": "سخن ماند ازو اندر آفاق و بس"
  },
  {
    "poem_id": 1685,
    "vorder": 49,
    "position": 0,
    "text": "سخن به که ویران نگردد سخن"
  },
  {
    "poem_id": 1685,
    "vorder": 50,
    "position": 1,
    "text": "چو از برف و باران سرای کهن"
  },
  {
    "poem_id": 1685,
    "vorder": 51,
    "position": 0,
    "text": "گذشتم ازین سد اسکندری"
  },
  {
    "poem_id": 1685,
    "vorder": 52,
    "position": 1,
    "text": "همه بهتری باد و نیک‌اختری"
  },
  {
    "poem_id": 1685,
    "vorder": 53,
    "position": 0,
    "text": "اگر چند هم بگذرد روزگار"
  },
  {
    "poem_id": 1685,
    "vorder": 54,
    "position": 1,
    "text": "نوشته بماند ز ما یادگار"
  },
  {
    "poem_id": 1685,
    "vorder": 55,
    "position": 0,
    "text": "اگر صد بمانی و گر صدهزار"
  },
  {
    "poem_id": 1685,
    "vorder": 56,
    "position": 1,
    "text": "به خاک اندر آید سرانجام کار"
  },
  {
    "poem_id": 1685,
    "vorder": 57,
    "position": 0,
    "text": "دل شهریار جهان شاد باد"
  },
  {
    "poem_id": 1685,
    "vorder": 58,
    "position": 1,
    "text": "ز هر بد تن پاکش آزاد باد"
  }
]