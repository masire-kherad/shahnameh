[
  {
    "poem_id": 88090,
    "vorder": 1,
    "position": 0,
    "text": "جهاندار شد پیش برتر خدای"
  },
  {
    "poem_id": 88090,
    "vorder": 2,
    "position": 1,
    "text": "همی خواست تا باشدش رهنمای"
  },
  {
    "poem_id": 88090,
    "vorder": 3,
    "position": 0,
    "text": "همی گفت کای کردگار سپهر"
  },
  {
    "poem_id": 88090,
    "vorder": 4,
    "position": 1,
    "text": "فروزندهٔ نیکی و داد و مهر"
  },
  {
    "poem_id": 88090,
    "vorder": 5,
    "position": 0,
    "text": "از این شهریاری مرا سود نیست"
  },
  {
    "poem_id": 88090,
    "vorder": 6,
    "position": 1,
    "text": "گر از من خداوند خشنود نیست"
  },
  {
    "poem_id": 88090,
    "vorder": 7,
    "position": 0,
    "text": "ز من نیکوی گر پذیرفت و زشت"
  },
  {
    "poem_id": 88090,
    "vorder": 8,
    "position": 1,
    "text": "نشستن مرا جای ده در بهشت"
  },
  {
    "poem_id": 88090,
    "vorder": 9,
    "position": 0,
    "text": "چنین پنج هفته خروشان به پای"
  },
  {
    "poem_id": 88090,
    "vorder": 10,
    "position": 1,
    "text": "همی بود بر پیش گیهان خدای"
  },
  {
    "poem_id": 88090,
    "vorder": 11,
    "position": 0,
    "text": "شب تیره از رنج نغنود شاه"
  },
  {
    "poem_id": 88090,
    "vorder": 12,
    "position": 1,
    "text": "بدانگه که برزد سر از برج ماه"
  },
  {
    "poem_id": 88090,
    "vorder": 13,
    "position": 0,
    "text": "بخفت او و روشن روانش نخفت"
  },
  {
    "poem_id": 88090,
    "vorder": 14,
    "position": 1,
    "text": "که اندر جهان با خرد بود جفت"
  },
  {
    "poem_id": 88090,
    "vorder": 15,
    "position": 0,
    "text": "چنان دید در خواب کاو را به گوش"
  },
  {
    "poem_id": 88090,
    "vorder": 16,
    "position": 1,
    "text": "نهفته بگفتی خجسته سروش"
  },
  {
    "poem_id": 88090,
    "vorder": 17,
    "position": 0,
    "text": "که ای شاه نیک‌اختر و نیک‌بخت"
  },
  {
    "poem_id": 88090,
    "vorder": 18,
    "position": 1,
    "text": "بسودی بسی یاره و تاج و تخت"
  },
  {
    "poem_id": 88090,
    "vorder": 19,
    "position": 0,
    "text": "اگر ز این جهان تیز بشتافتی"
  },
  {
    "poem_id": 88090,
    "vorder": 20,
    "position": 1,
    "text": "کنون آنچه جستی همه یافتی"
  },
  {
    "poem_id": 88090,
    "vorder": 21,
    "position": 0,
    "text": "به همسیایگی داور پاک جای"
  },
  {
    "poem_id": 88090,
    "vorder": 22,
    "position": 1,
    "text": "بیابی بدین تیرگی در مپای"
  },
  {
    "poem_id": 88090,
    "vorder": 23,
    "position": 0,
    "text": "چو بخشی به ارزانیان بخش گنج"
  },
  {
    "poem_id": 88090,
    "vorder": 24,
    "position": 1,
    "text": "کسی را سپار این سرای سپنج"
  },
  {
    "poem_id": 88090,
    "vorder": 25,
    "position": 0,
    "text": "توانگر شوی گر تو درویش را"
  },
  {
    "poem_id": 88090,
    "vorder": 26,
    "position": 1,
    "text": "کنی شادمان مردم خویش را"
  },
  {
    "poem_id": 88090,
    "vorder": 27,
    "position": 0,
    "text": "کسی گردد ایمن ز چنگ بلا"
  },
  {
    "poem_id": 88090,
    "vorder": 28,
    "position": 1,
    "text": "که یابد رها ز این دم اژدها"
  },
  {
    "poem_id": 88090,
    "vorder": 29,
    "position": 0,
    "text": "هرآنکس که از بهر تو رنج برد"
  },
  {
    "poem_id": 88090,
    "vorder": 30,
    "position": 1,
    "text": "چنان دان که آن از پی گنج برد"
  },
  {
    "poem_id": 88090,
    "vorder": 31,
    "position": 0,
    "text": "چو بخشی به ارزانیان بخش چیز"
  },
  {
    "poem_id": 88090,
    "vorder": 32,
    "position": 1,
    "text": "که ایدر نمانی تو بسیار نیز"
  },
  {
    "poem_id": 88090,
    "vorder": 33,
    "position": 0,
    "text": "سر تخت را پادشاهی گزین"
  },
  {
    "poem_id": 88090,
    "vorder": 34,
    "position": 1,
    "text": "که ایمن بود مور از او بر زمین"
  },
  {
    "poem_id": 88090,
    "vorder": 35,
    "position": 0,
    "text": "چو گیتی ببخشی میاسای هیچ"
  },
  {
    "poem_id": 88090,
    "vorder": 36,
    "position": 1,
    "text": "که آمد ترا روزگار بسیچ"
  },
  {
    "poem_id": 88090,
    "vorder": 37,
    "position": 0,
    "text": "چو بیدار شد رنج دیده ز خواب"
  },
  {
    "poem_id": 88090,
    "vorder": 38,
    "position": 1,
    "text": "ز خوی دید جای پرستش پر آب"
  },
  {
    "poem_id": 88090,
    "vorder": 39,
    "position": 0,
    "text": "همی بود گریان و رخ بر زمین"
  },
  {
    "poem_id": 88090,
    "vorder": 40,
    "position": 1,
    "text": "همی خواند بر کردگار آفرین"
  },
  {
    "poem_id": 88090,
    "vorder": 41,
    "position": 0,
    "text": "همی گفت گر تیز بشتافتم"
  },
  {
    "poem_id": 88090,
    "vorder": 42,
    "position": 1,
    "text": "ز یزدان همه کام دل یافتم"
  },
  {
    "poem_id": 88090,
    "vorder": 43,
    "position": 0,
    "text": "بیامد بر تخت شاهی نشست"
  },
  {
    "poem_id": 88090,
    "vorder": 44,
    "position": 1,
    "text": "یکی جامهٔ نابسوده به دست"
  },
  {
    "poem_id": 88090,
    "vorder": 45,
    "position": 0,
    "text": "بپوشید و بنشست بر تخت عاج"
  },
  {
    "poem_id": 88090,
    "vorder": 46,
    "position": 1,
    "text": "جهاندار بی‌یاره و گرز و تاج"
  }
]