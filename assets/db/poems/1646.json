[
  {
    "poem_id": 1646,
    "vorder": 1,
    "position": 0,
    "text": "سکندر چو کرد اندر ایران نگاه"
  },
  {
    "poem_id": 1646,
    "vorder": 2,
    "position": 1,
    "text": "بدانست کو را شد آن تاج و گاه"
  },
  {
    "poem_id": 1646,
    "vorder": 3,
    "position": 0,
    "text": "همی راه و بی‌راه لشکر کشید"
  },
  {
    "poem_id": 1646,
    "vorder": 4,
    "position": 1,
    "text": "سوی کید هندی سپه برکشید"
  },
  {
    "poem_id": 1646,
    "vorder": 5,
    "position": 0,
    "text": "به جایی که آمد سکندر فراز"
  },
  {
    "poem_id": 1646,
    "vorder": 6,
    "position": 1,
    "text": "در شارستانها گشادند باز"
  },
  {
    "poem_id": 1646,
    "vorder": 7,
    "position": 0,
    "text": "ازان مرز کس را به مردم نداشت"
  },
  {
    "poem_id": 1646,
    "vorder": 8,
    "position": 1,
    "text": "ز ناهید مغفر همی برگذاشت"
  },
  {
    "poem_id": 1646,
    "vorder": 9,
    "position": 0,
    "text": "چو آمد بران شارستان بزرگ"
  },
  {
    "poem_id": 1646,
    "vorder": 10,
    "position": 1,
    "text": "که میلاد خواندیش کید سترگ"
  },
  {
    "poem_id": 1646,
    "vorder": 11,
    "position": 0,
    "text": "بران مرز لشکر فرود آورید"
  },
  {
    "poem_id": 1646,
    "vorder": 12,
    "position": 1,
    "text": "همه بوم ایشان سپه گسترید"
  },
  {
    "poem_id": 1646,
    "vorder": 13,
    "position": 0,
    "text": "نویسندهٔ نامه را خواندند"
  },
  {
    "poem_id": 1646,
    "vorder": 14,
    "position": 1,
    "text": "به پیش سکندرش بنشاندند"
  },
  {
    "poem_id": 1646,
    "vorder": 15,
    "position": 0,
    "text": "یکی نامه بنوشت نزدیک کید"
  },
  {
    "poem_id": 1646,
    "vorder": 16,
    "position": 1,
    "text": "چو شیری که ارغنده گردد به صید"
  },
  {
    "poem_id": 1646,
    "vorder": 17,
    "position": 0,
    "text": "ز اسکندر راد پیروزگر"
  },
  {
    "poem_id": 1646,
    "vorder": 18,
    "position": 1,
    "text": "خداوند شمشیر و تاج و کمر"
  },
  {
    "poem_id": 1646,
    "vorder": 19,
    "position": 0,
    "text": "سر نامه بود آفرین از نخست"
  },
  {
    "poem_id": 1646,
    "vorder": 20,
    "position": 1,
    "text": "بدانکس که دل را به دانش بشست"
  },
  {
    "poem_id": 1646,
    "vorder": 21,
    "position": 0,
    "text": "ز کار آن گزیند که بی‌رنج‌تر"
  },
  {
    "poem_id": 1646,
    "vorder": 22,
    "position": 1,
    "text": "چو خواهد که بردارد از گنج بر"
  },
  {
    "poem_id": 1646,
    "vorder": 23,
    "position": 0,
    "text": "گراینده باشد به یزدان پاک"
  },
  {
    "poem_id": 1646,
    "vorder": 24,
    "position": 1,
    "text": "بدو دارد امید و زو ترس و باک"
  },
  {
    "poem_id": 1646,
    "vorder": 25,
    "position": 0,
    "text": "بداند که ما تخت را مایه‌ایم"
  },
  {
    "poem_id": 1646,
    "vorder": 26,
    "position": 1,
    "text": "جهاندار پیروز را سایه‌ایم"
  },
  {
    "poem_id": 1646,
    "vorder": 27,
    "position": 0,
    "text": "نوشتم یکی نامه نزدیک تو"
  },
  {
    "poem_id": 1646,
    "vorder": 28,
    "position": 1,
    "text": "که روشن کند جان تاریک تو"
  },
  {
    "poem_id": 1646,
    "vorder": 29,
    "position": 0,
    "text": "هم‌آنگه که بر تو بخواند دبیر"
  },
  {
    "poem_id": 1646,
    "vorder": 30,
    "position": 1,
    "text": "منه پیش و این را سگالش مگیر"
  },
  {
    "poem_id": 1646,
    "vorder": 31,
    "position": 0,
    "text": "اگر شب رسد روشنی را مپای"
  },
  {
    "poem_id": 1646,
    "vorder": 32,
    "position": 1,
    "text": "هم‌اندر زمان سوی فرمان گرای"
  },
  {
    "poem_id": 1646,
    "vorder": 33,
    "position": 0,
    "text": "وگر بگذری زین سخن نگذرم"
  },
  {
    "poem_id": 1646,
    "vorder": 34,
    "position": 1,
    "text": "سر و تاج و تختت به پی بسپرم"
  }
]