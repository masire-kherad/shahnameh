[
  {
    "poem_id": 1852,
    "vorder": 1,
    "position": 0,
    "text": "چو بگذشت لشکر بران تازه بوم"
  },
  {
    "poem_id": 1852,
    "vorder": 2,
    "position": 1,
    "text": "بتندی همی‌راند تا مرز روم"
  },
  {
    "poem_id": 1852,
    "vorder": 3,
    "position": 0,
    "text": "چنین تا بیامد بران شارستان"
  },
  {
    "poem_id": 1852,
    "vorder": 4,
    "position": 1,
    "text": "که قیصر ورا خواندی کارستان"
  },
  {
    "poem_id": 1852,
    "vorder": 5,
    "position": 0,
    "text": "چواز دور ترسا بدید آن سپاه"
  },
  {
    "poem_id": 1852,
    "vorder": 6,
    "position": 1,
    "text": "برفتند پویان به آبی راه و راه"
  },
  {
    "poem_id": 1852,
    "vorder": 7,
    "position": 0,
    "text": "بدان باره اندر کشیدند رخت"
  },
  {
    "poem_id": 1852,
    "vorder": 8,
    "position": 1,
    "text": "در شارستان را ببستند سخت"
  },
  {
    "poem_id": 1852,
    "vorder": 9,
    "position": 0,
    "text": "فروماند زان شاه گیتی فروز"
  },
  {
    "poem_id": 1852,
    "vorder": 10,
    "position": 1,
    "text": "به بیرون بماندند لشکر سه روز"
  },
  {
    "poem_id": 1852,
    "vorder": 11,
    "position": 0,
    "text": "فرستاد روز چهارم کسی"
  },
  {
    "poem_id": 1852,
    "vorder": 12,
    "position": 1,
    "text": "که نزدیک ما نیست لشکر بسی"
  },
  {
    "poem_id": 1852,
    "vorder": 13,
    "position": 0,
    "text": "خورشها فرستید و یاری کنید"
  },
  {
    "poem_id": 1852,
    "vorder": 14,
    "position": 1,
    "text": "چه برما همی کامگاری کنید"
  },
  {
    "poem_id": 1852,
    "vorder": 15,
    "position": 0,
    "text": "به نزدیک ایشان سخن خوار بود"
  },
  {
    "poem_id": 1852,
    "vorder": 16,
    "position": 1,
    "text": "سپاهش همه سست و ناهار بود"
  },
  {
    "poem_id": 1852,
    "vorder": 17,
    "position": 0,
    "text": "هم آنگه برآمد یکی تیره ابر"
  },
  {
    "poem_id": 1852,
    "vorder": 18,
    "position": 1,
    "text": "بغرید برسان جنگی هژبر"
  },
  {
    "poem_id": 1852,
    "vorder": 19,
    "position": 0,
    "text": "وز ابر اندران شارستان باد خاست"
  },
  {
    "poem_id": 1852,
    "vorder": 20,
    "position": 1,
    "text": "بهر بر زنی بانگ و فریاد خاست"
  },
  {
    "poem_id": 1852,
    "vorder": 21,
    "position": 0,
    "text": "چونیمی ز تیره شب اندر کشید"
  },
  {
    "poem_id": 1852,
    "vorder": 22,
    "position": 1,
    "text": "ز باره یکی بهره شد ناپدید"
  },
  {
    "poem_id": 1852,
    "vorder": 23,
    "position": 0,
    "text": "همه شارستان ماند اندر شگفت"
  },
  {
    "poem_id": 1852,
    "vorder": 24,
    "position": 1,
    "text": "به یزدان سقف پوزش اندر گرفت"
  },
  {
    "poem_id": 1852,
    "vorder": 25,
    "position": 0,
    "text": "بهر بر زنی بر علف ساختند"
  },
  {
    "poem_id": 1852,
    "vorder": 26,
    "position": 1,
    "text": "سه پیر سکوبا برون تاختند"
  },
  {
    "poem_id": 1852,
    "vorder": 27,
    "position": 0,
    "text": "ز چیزی که بود اندران تازه بوم"
  },
  {
    "poem_id": 1852,
    "vorder": 28,
    "position": 1,
    "text": "همان جامه هایی که خیزد ز روم"
  },
  {
    "poem_id": 1852,
    "vorder": 29,
    "position": 0,
    "text": "ببردند بالا به نزدیک شاه"
  },
  {
    "poem_id": 1852,
    "vorder": 30,
    "position": 1,
    "text": "که پیدا شد ای شاه برما گناه"
  },
  {
    "poem_id": 1852,
    "vorder": 31,
    "position": 0,
    "text": "چو خسرو جوان بود و برتر منش"
  },
  {
    "poem_id": 1852,
    "vorder": 32,
    "position": 1,
    "text": "بدیشان نکرد از بدی سرزنش"
  },
  {
    "poem_id": 1852,
    "vorder": 33,
    "position": 0,
    "text": "بدان شارستان دریکی کاخ بود"
  },
  {
    "poem_id": 1852,
    "vorder": 34,
    "position": 1,
    "text": "که بالاش با ابر گستاخ بود"
  },
  {
    "poem_id": 1852,
    "vorder": 35,
    "position": 0,
    "text": "فراوان بدو اندرون برده بود"
  },
  {
    "poem_id": 1852,
    "vorder": 36,
    "position": 1,
    "text": "همان جای قیصر برآورده بود"
  },
  {
    "poem_id": 1852,
    "vorder": 37,
    "position": 0,
    "text": "ز دشت اندرآمد بدانجا گذشت"
  },
  {
    "poem_id": 1852,
    "vorder": 38,
    "position": 1,
    "text": "فراوان بدان شارستان دربگشت"
  },
  {
    "poem_id": 1852,
    "vorder": 39,
    "position": 0,
    "text": "همه رومیان آفرین خواندند"
  },
  {
    "poem_id": 1852,
    "vorder": 40,
    "position": 1,
    "text": "بپا اندرش گوهر افشاندند"
  },
  {
    "poem_id": 1852,
    "vorder": 41,
    "position": 0,
    "text": "چو آباد جایی به چنگ آمدش"
  },
  {
    "poem_id": 1852,
    "vorder": 42,
    "position": 1,
    "text": "برآسود و چندی درنگ آمدش"
  },
  {
    "poem_id": 1852,
    "vorder": 43,
    "position": 0,
    "text": "به قیصر یکی نامه بنوشت شاه"
  },
  {
    "poem_id": 1852,
    "vorder": 44,
    "position": 1,
    "text": "ازان باد وباران وابر سیاه"
  },
  {
    "poem_id": 1852,
    "vorder": 45,
    "position": 0,
    "text": "وزان شارستان سوی مانوی راند"
  },
  {
    "poem_id": 1852,
    "vorder": 46,
    "position": 1,
    "text": "که آن را جهاندار مانوی خواند"
  },
  {
    "poem_id": 1852,
    "vorder": 47,
    "position": 0,
    "text": "زما نوییان هرک بیدار بود"
  },
  {
    "poem_id": 1852,
    "vorder": 48,
    "position": 1,
    "text": "خردمند و راد و جهاندار بود"
  },
  {
    "poem_id": 1852,
    "vorder": 49,
    "position": 0,
    "text": "سکوبا و رهبان سوی شهریار"
  },
  {
    "poem_id": 1852,
    "vorder": 50,
    "position": 1,
    "text": "برفتند با هدیه و با نثار"
  },
  {
    "poem_id": 1852,
    "vorder": 51,
    "position": 0,
    "text": "همی‌رفت با شاه چندی سخن"
  },
  {
    "poem_id": 1852,
    "vorder": 52,
    "position": 1,
    "text": "ز باران و آن شارستان کهن"
  },
  {
    "poem_id": 1852,
    "vorder": 53,
    "position": 0,
    "text": "همی‌گفت هرکس که ما بنده‌ایم"
  },
  {
    "poem_id": 1852,
    "vorder": 54,
    "position": 1,
    "text": "به گفتار خسرو سر افگنده‌ایم"
  }
]