[
  {
    "poem_id": 1511,
    "vorder": 1,
    "position": 0,
    "text": "دو فرزند بودش به کردار ماه"
  },
  {
    "poem_id": 1511,
    "vorder": 2,
    "position": 1,
    "text": "سزاوار شاهی و تخت و کلاه"
  },
  {
    "poem_id": 1511,
    "vorder": 3,
    "position": 0,
    "text": "یکی نام گشتاسپ و دیگر زریر"
  },
  {
    "poem_id": 1511,
    "vorder": 4,
    "position": 1,
    "text": "که زیر آوریدی سر نره شیر"
  },
  {
    "poem_id": 1511,
    "vorder": 5,
    "position": 0,
    "text": "گذشته به هر دانشی از پدر"
  },
  {
    "poem_id": 1511,
    "vorder": 6,
    "position": 1,
    "text": "ز لشکر به مردی برآورده سر"
  },
  {
    "poem_id": 1511,
    "vorder": 7,
    "position": 0,
    "text": "دو شاه سرافراز و دو نیک‌پی"
  },
  {
    "poem_id": 1511,
    "vorder": 8,
    "position": 1,
    "text": "نبیرهٔ جهاندار کاوس کی"
  },
  {
    "poem_id": 1511,
    "vorder": 9,
    "position": 0,
    "text": "بدیشان بدی جان لهراسپ شاد"
  },
  {
    "poem_id": 1511,
    "vorder": 10,
    "position": 1,
    "text": "وزیشان نکردی ز گشتاسپ یاد"
  },
  {
    "poem_id": 1511,
    "vorder": 11,
    "position": 0,
    "text": "که گشتاسپ را سر پر از باد بود"
  },
  {
    "poem_id": 1511,
    "vorder": 12,
    "position": 1,
    "text": "وزان کار لهراسپ ناشاد بود"
  },
  {
    "poem_id": 1511,
    "vorder": 13,
    "position": 0,
    "text": "چنین تا برآمد برین روزگار"
  },
  {
    "poem_id": 1511,
    "vorder": 14,
    "position": 1,
    "text": "پر از درد گشتاسپ از شهریار"
  },
  {
    "poem_id": 1511,
    "vorder": 15,
    "position": 0,
    "text": "چنان بد که در پارس یک روز تخت"
  },
  {
    "poem_id": 1511,
    "vorder": 16,
    "position": 1,
    "text": "نهادند زیر گل‌افشان درخت"
  },
  {
    "poem_id": 1511,
    "vorder": 17,
    "position": 0,
    "text": "بفرمود لهراسپ تا مهتران"
  },
  {
    "poem_id": 1511,
    "vorder": 18,
    "position": 1,
    "text": "برفتند چندی ز لشکر سران"
  },
  {
    "poem_id": 1511,
    "vorder": 19,
    "position": 0,
    "text": "به خوان بر یکی جام می‌خواستند"
  },
  {
    "poem_id": 1511,
    "vorder": 20,
    "position": 1,
    "text": "دل شاه گیتی بیاراستند"
  },
  {
    "poem_id": 1511,
    "vorder": 21,
    "position": 0,
    "text": "چو گشتاسپ می‌خورد برپای خاست"
  },
  {
    "poem_id": 1511,
    "vorder": 22,
    "position": 1,
    "text": "چنین گفت کای شاه با داد و راست"
  },
  {
    "poem_id": 1511,
    "vorder": 23,
    "position": 0,
    "text": "به شاهی نشست تو فرخنده باد"
  },
  {
    "poem_id": 1511,
    "vorder": 24,
    "position": 1,
    "text": "همان جاودان نام تو زنده باد"
  },
  {
    "poem_id": 1511,
    "vorder": 25,
    "position": 0,
    "text": "ترا داد یزدان کلاه و کمر"
  },
  {
    "poem_id": 1511,
    "vorder": 26,
    "position": 1,
    "text": "دگر شاه کیخسرو دادگر"
  },
  {
    "poem_id": 1511,
    "vorder": 27,
    "position": 0,
    "text": "کنون من یکی بنده‌ام بر درت"
  },
  {
    "poem_id": 1511,
    "vorder": 28,
    "position": 1,
    "text": "پرستندهٔ اختر و افسرت"
  },
  {
    "poem_id": 1511,
    "vorder": 29,
    "position": 0,
    "text": "ندارم کسی را ز مردان به مرد"
  },
  {
    "poem_id": 1511,
    "vorder": 30,
    "position": 1,
    "text": "گر آیند پیشم به روز نبرد"
  },
  {
    "poem_id": 1511,
    "vorder": 31,
    "position": 0,
    "text": "مگر رستم زال سام سوار"
  },
  {
    "poem_id": 1511,
    "vorder": 32,
    "position": 1,
    "text": "که با او نسازد کسی کارزار"
  },
  {
    "poem_id": 1511,
    "vorder": 33,
    "position": 0,
    "text": "چو کیخسرو از تو پر اندیشه گشت"
  },
  {
    "poem_id": 1511,
    "vorder": 34,
    "position": 1,
    "text": "ترا داد تخت و خود اندر گذشت"
  },
  {
    "poem_id": 1511,
    "vorder": 35,
    "position": 0,
    "text": "گر ایدونک هستم ز ارزانیان"
  },
  {
    "poem_id": 1511,
    "vorder": 36,
    "position": 1,
    "text": "مرا نام بر تاج و تخت و کیان"
  },
  {
    "poem_id": 1511,
    "vorder": 37,
    "position": 0,
    "text": "چنین هم که‌ام پیش تو بنده‌وار"
  },
  {
    "poem_id": 1511,
    "vorder": 38,
    "position": 1,
    "text": "همی باشم و خوانمت شهریار"
  },
  {
    "poem_id": 1511,
    "vorder": 39,
    "position": 0,
    "text": "به گشتاسپ گفت ای پسر گوش دار"
  },
  {
    "poem_id": 1511,
    "vorder": 40,
    "position": 1,
    "text": "که تندی نه خوب آید از شهریار"
  },
  {
    "poem_id": 1511,
    "vorder": 41,
    "position": 0,
    "text": "چو اندرز کیخسرو آرم به یاد"
  },
  {
    "poem_id": 1511,
    "vorder": 42,
    "position": 1,
    "text": "تو بشنو نگر سر نپیچی ز داد"
  },
  {
    "poem_id": 1511,
    "vorder": 43,
    "position": 0,
    "text": "مرا گفت بیدادگر شهریار"
  },
  {
    "poem_id": 1511,
    "vorder": 44,
    "position": 1,
    "text": "یکی خو بود پیش باغ بهار"
  },
  {
    "poem_id": 1511,
    "vorder": 45,
    "position": 0,
    "text": "که چون آب یابد به نیرو شود"
  },
  {
    "poem_id": 1511,
    "vorder": 46,
    "position": 1,
    "text": "همه باغ ازو پر ز آهو شود"
  },
  {
    "poem_id": 1511,
    "vorder": 47,
    "position": 0,
    "text": "جوانی هنوز این بلندی مجوی"
  },
  {
    "poem_id": 1511,
    "vorder": 48,
    "position": 1,
    "text": "سخن را بسنج و به اندازه گوی"
  },
  {
    "poem_id": 1511,
    "vorder": 49,
    "position": 0,
    "text": "چو گشتاسب بشنید شد پر ز درد"
  },
  {
    "poem_id": 1511,
    "vorder": 50,
    "position": 1,
    "text": "بیامد ز پیش پدر گونه زرد"
  },
  {
    "poem_id": 1511,
    "vorder": 51,
    "position": 0,
    "text": "همی گفت بیگانگان را نواز"
  },
  {
    "poem_id": 1511,
    "vorder": 52,
    "position": 1,
    "text": "چنین باش و با زاده هرگز مساز"
  },
  {
    "poem_id": 1511,
    "vorder": 53,
    "position": 0,
    "text": "ز لشکر ورا بود سیصد سوار"
  },
  {
    "poem_id": 1511,
    "vorder": 54,
    "position": 1,
    "text": "همه گرد و شایستهٔ کارزار"
  },
  {
    "poem_id": 1511,
    "vorder": 55,
    "position": 0,
    "text": "فرود آمد و کهتران را بخواند"
  },
  {
    "poem_id": 1511,
    "vorder": 56,
    "position": 1,
    "text": "همه رازها پیش ایشان براند"
  },
  {
    "poem_id": 1511,
    "vorder": 57,
    "position": 0,
    "text": "که امشب همه ساز رفتن کنید"
  },
  {
    "poem_id": 1511,
    "vorder": 58,
    "position": 1,
    "text": "دل و دیده زین بارگه برکنید"
  },
  {
    "poem_id": 1511,
    "vorder": 59,
    "position": 0,
    "text": "یکی گفت ازیشان که راهت کجاست"
  },
  {
    "poem_id": 1511,
    "vorder": 60,
    "position": 1,
    "text": "چو برداری آرامگاهت کجاست"
  },
  {
    "poem_id": 1511,
    "vorder": 61,
    "position": 0,
    "text": "چنین داد پاسخ که در هندوان"
  },
  {
    "poem_id": 1511,
    "vorder": 62,
    "position": 1,
    "text": "مرا شاد دارند و روشن روان"
  },
  {
    "poem_id": 1511,
    "vorder": 63,
    "position": 0,
    "text": "یکی نامه دارم من از شاه هند"
  },
  {
    "poem_id": 1511,
    "vorder": 64,
    "position": 1,
    "text": "نوشته ز مشک سیه بر پرند"
  },
  {
    "poem_id": 1511,
    "vorder": 65,
    "position": 0,
    "text": "که گر زی من آیی ترا کهترم"
  },
  {
    "poem_id": 1511,
    "vorder": 66,
    "position": 1,
    "text": "ز فرمان و رای تو برنگذرم"
  },
  {
    "poem_id": 1511,
    "vorder": 67,
    "position": 0,
    "text": "چو شب تیره شد با سپه برنشست"
  },
  {
    "poem_id": 1511,
    "vorder": 68,
    "position": 1,
    "text": "همی رفت جوشان و گرزی به دست"
  },
  {
    "poem_id": 1511,
    "vorder": 69,
    "position": 0,
    "text": "به شبگیر لهراسپ آگاه شد"
  },
  {
    "poem_id": 1511,
    "vorder": 70,
    "position": 1,
    "text": "غمی گشت و شادیش کوتاه شد"
  },
  {
    "poem_id": 1511,
    "vorder": 71,
    "position": 0,
    "text": "ز لشکر جهاندیدگان را بخواند"
  },
  {
    "poem_id": 1511,
    "vorder": 72,
    "position": 1,
    "text": "همه بودنی پیش ایشان براند"
  },
  {
    "poem_id": 1511,
    "vorder": 73,
    "position": 0,
    "text": "ببینید گفت این که گشتاسپ کرد"
  },
  {
    "poem_id": 1511,
    "vorder": 74,
    "position": 1,
    "text": "دلم کرد پر درد و سر پر ز گرد"
  },
  {
    "poem_id": 1511,
    "vorder": 75,
    "position": 0,
    "text": "بپروردمش تا برآورد یال"
  },
  {
    "poem_id": 1511,
    "vorder": 76,
    "position": 1,
    "text": "شد اندر جهان نامور بی‌همال"
  },
  {
    "poem_id": 1511,
    "vorder": 77,
    "position": 0,
    "text": "بدانگه که گفتم که آمد به بار"
  },
  {
    "poem_id": 1511,
    "vorder": 78,
    "position": 1,
    "text": "ز باغ من آواره شد نامدار"
  },
  {
    "poem_id": 1511,
    "vorder": 79,
    "position": 0,
    "text": "برفت و بر اندیشه بر بود دیر"
  },
  {
    "poem_id": 1511,
    "vorder": 80,
    "position": 1,
    "text": "بفرمود تا پیش او شد زریر"
  },
  {
    "poem_id": 1511,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت بگزین ز لشکر هزار"
  },
  {
    "poem_id": 1511,
    "vorder": 82,
    "position": 1,
    "text": "سواران گرد از در کارزار"
  },
  {
    "poem_id": 1511,
    "vorder": 83,
    "position": 0,
    "text": "برو تیز بر سوی هندوستان"
  },
  {
    "poem_id": 1511,
    "vorder": 84,
    "position": 1,
    "text": "مبادا بر و بوم جادوستان"
  },
  {
    "poem_id": 1511,
    "vorder": 85,
    "position": 0,
    "text": "سوی روم گستهم نوذر برفت"
  },
  {
    "poem_id": 1511,
    "vorder": 86,
    "position": 1,
    "text": "سوی چین گرازه گرازید تفت"
  }
]