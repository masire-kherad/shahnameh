[
  {
    "poem_id": 1928,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تابرکشیدند نای"
  },
  {
    "poem_id": 1928,
    "vorder": 2,
    "position": 1,
    "text": "سپاه اندر آمد چو دریا ز جای"
  },
  {
    "poem_id": 1928,
    "vorder": 3,
    "position": 0,
    "text": "برآمد یکی ابر و برشد خروش"
  },
  {
    "poem_id": 1928,
    "vorder": 4,
    "position": 1,
    "text": "همی کر شد مردم تیزگوش"
  },
  {
    "poem_id": 1928,
    "vorder": 5,
    "position": 0,
    "text": "سنانهای الماس در تیره گرد"
  },
  {
    "poem_id": 1928,
    "vorder": 6,
    "position": 1,
    "text": "چو آتش پس پردهٔ لاژورد"
  },
  {
    "poem_id": 1928,
    "vorder": 7,
    "position": 0,
    "text": "همی نیزه بر مغفر آبدار"
  },
  {
    "poem_id": 1928,
    "vorder": 8,
    "position": 1,
    "text": "نیامد به زخم اندرون پایدار"
  },
  {
    "poem_id": 1928,
    "vorder": 9,
    "position": 0,
    "text": "سه روز اندر آن جایگه جنگ بود"
  },
  {
    "poem_id": 1928,
    "vorder": 10,
    "position": 1,
    "text": "سر آدمی سم اسپان به سود"
  },
  {
    "poem_id": 1928,
    "vorder": 11,
    "position": 0,
    "text": "شد ازتشنگی دست گردان ز کار"
  },
  {
    "poem_id": 1928,
    "vorder": 12,
    "position": 1,
    "text": "هم اسپ گرانمایه از کارزار"
  },
  {
    "poem_id": 1928,
    "vorder": 13,
    "position": 0,
    "text": "لب رستم از تشنگی شد چو خاک"
  },
  {
    "poem_id": 1928,
    "vorder": 14,
    "position": 1,
    "text": "دهن خشک و گویا زبان چاک چاک"
  },
  {
    "poem_id": 1928,
    "vorder": 15,
    "position": 0,
    "text": "چو بریان و گریان شدند از نبرد"
  },
  {
    "poem_id": 1928,
    "vorder": 16,
    "position": 1,
    "text": "گل تر به خوردن گرفت اسپ و مرد"
  },
  {
    "poem_id": 1928,
    "vorder": 17,
    "position": 0,
    "text": "خروشی بر آمد به کردار رعد"
  },
  {
    "poem_id": 1928,
    "vorder": 18,
    "position": 1,
    "text": "ازین روی رستم وزان روی سعد"
  },
  {
    "poem_id": 1928,
    "vorder": 19,
    "position": 0,
    "text": "برفتند هر دو ز قلب سپاه"
  },
  {
    "poem_id": 1928,
    "vorder": 20,
    "position": 1,
    "text": "بیکسو کشیدند ز آوردگاه"
  },
  {
    "poem_id": 1928,
    "vorder": 21,
    "position": 0,
    "text": "چو از لشکر آن هر دو تنها شدند"
  },
  {
    "poem_id": 1928,
    "vorder": 22,
    "position": 1,
    "text": "به زیر یکی سرو بالا شدند"
  },
  {
    "poem_id": 1928,
    "vorder": 23,
    "position": 0,
    "text": "همی‌تاختند اندر آوردگاه"
  },
  {
    "poem_id": 1928,
    "vorder": 24,
    "position": 1,
    "text": "دو سالار هر دو به دل کینه خواه"
  },
  {
    "poem_id": 1928,
    "vorder": 25,
    "position": 0,
    "text": "خروشی برآمد ز رستم چو رعد"
  },
  {
    "poem_id": 1928,
    "vorder": 26,
    "position": 1,
    "text": "یکی تیغ زد بر سر اسپ سعد"
  },
  {
    "poem_id": 1928,
    "vorder": 27,
    "position": 0,
    "text": "چواسپ نبرد اندرآمد به سر"
  },
  {
    "poem_id": 1928,
    "vorder": 28,
    "position": 1,
    "text": "جدا شد ازو سعد پرخاشخر"
  },
  {
    "poem_id": 1928,
    "vorder": 29,
    "position": 0,
    "text": "بر آهیخت رستم یکی تیغ تیز"
  },
  {
    "poem_id": 1928,
    "vorder": 30,
    "position": 1,
    "text": "بدان تا نماید به دو رستخیز"
  },
  {
    "poem_id": 1928,
    "vorder": 31,
    "position": 0,
    "text": "همی‌خواست از تن سرش رابرید"
  },
  {
    "poem_id": 1928,
    "vorder": 32,
    "position": 1,
    "text": "ز گرد سپه این مران را ندید"
  },
  {
    "poem_id": 1928,
    "vorder": 33,
    "position": 0,
    "text": "فرود آمد از پشت زین پلنگ"
  },
  {
    "poem_id": 1928,
    "vorder": 34,
    "position": 1,
    "text": "به زد بر کمر بر سر پالهنگ"
  },
  {
    "poem_id": 1928,
    "vorder": 35,
    "position": 0,
    "text": "بپوشید دیدار رستم ز گرد"
  },
  {
    "poem_id": 1928,
    "vorder": 36,
    "position": 1,
    "text": "بشد سعد پویان به جای نبرد"
  },
  {
    "poem_id": 1928,
    "vorder": 37,
    "position": 0,
    "text": "یکی تیغ زد بر سر ترگ اوی"
  },
  {
    "poem_id": 1928,
    "vorder": 38,
    "position": 1,
    "text": "که خون اندر آمد ز تارک بروی"
  },
  {
    "poem_id": 1928,
    "vorder": 39,
    "position": 0,
    "text": "چو دیدار رستم ز خون تیره شد"
  },
  {
    "poem_id": 1928,
    "vorder": 40,
    "position": 1,
    "text": "جهانجوی تازی بدو چیره شد"
  },
  {
    "poem_id": 1928,
    "vorder": 41,
    "position": 0,
    "text": "دگر تیغ زد بربر و گردنش"
  },
  {
    "poem_id": 1928,
    "vorder": 42,
    "position": 1,
    "text": "به خاک اندر افگند جنگی تنش"
  },
  {
    "poem_id": 1928,
    "vorder": 43,
    "position": 0,
    "text": "سپاه از دو رویه خودآگاه نه"
  },
  {
    "poem_id": 1928,
    "vorder": 44,
    "position": 1,
    "text": "کسی را سوی پهلوان راه نه"
  },
  {
    "poem_id": 1928,
    "vorder": 45,
    "position": 0,
    "text": "همی‌جست مر پهلوان را سپاه"
  },
  {
    "poem_id": 1928,
    "vorder": 46,
    "position": 1,
    "text": "برفتند تا پیش آوردگاه"
  },
  {
    "poem_id": 1928,
    "vorder": 47,
    "position": 0,
    "text": "بدیدندش از دور پر خون و خاک"
  },
  {
    "poem_id": 1928,
    "vorder": 48,
    "position": 1,
    "text": "سرا پای کردن به شمشیر چاک"
  },
  {
    "poem_id": 1928,
    "vorder": 49,
    "position": 0,
    "text": "هزیمت گرفتند ایرانیان"
  },
  {
    "poem_id": 1928,
    "vorder": 50,
    "position": 1,
    "text": "بسی نامور کشته شد در میان"
  },
  {
    "poem_id": 1928,
    "vorder": 51,
    "position": 0,
    "text": "بسی تشنه بر زین بمردند نیز"
  },
  {
    "poem_id": 1928,
    "vorder": 52,
    "position": 1,
    "text": "پر آمد ز شاهان جهان را قفیز"
  },
  {
    "poem_id": 1928,
    "vorder": 53,
    "position": 0,
    "text": "سوی شاه ایران بیامد سپاه"
  },
  {
    "poem_id": 1928,
    "vorder": 54,
    "position": 1,
    "text": "شب تیره و روز تازان به راه"
  },
  {
    "poem_id": 1928,
    "vorder": 55,
    "position": 0,
    "text": "به بغداد بود آن زمان یزدگرد"
  },
  {
    "poem_id": 1928,
    "vorder": 56,
    "position": 1,
    "text": "که او را سپاه اندآورد گرد"
  }
]