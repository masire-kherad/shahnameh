[
  {
    "poem_id": 1805,
    "vorder": 1,
    "position": 0,
    "text": "یکی اژدها بود بر خشک و آب"
  },
  {
    "poem_id": 1805,
    "vorder": 2,
    "position": 1,
    "text": "به دریا بدی گاه بر آفتاب"
  },
  {
    "poem_id": 1805,
    "vorder": 3,
    "position": 0,
    "text": "همی درکشیدی به دم ژنده پیل"
  },
  {
    "poem_id": 1805,
    "vorder": 4,
    "position": 1,
    "text": "وزو خاستی موج دریای نیل"
  },
  {
    "poem_id": 1805,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت شنگل به یاران خویش"
  },
  {
    "poem_id": 1805,
    "vorder": 6,
    "position": 1,
    "text": "بدان تیزهش رازداران خویش"
  },
  {
    "poem_id": 1805,
    "vorder": 7,
    "position": 0,
    "text": "که من زین فرستادهٔ شیرمرد"
  },
  {
    "poem_id": 1805,
    "vorder": 8,
    "position": 1,
    "text": "گهی شادمانم گهی پر ز درد"
  },
  {
    "poem_id": 1805,
    "vorder": 9,
    "position": 0,
    "text": "مرا پشت بودی گر ایدر بدی"
  },
  {
    "poem_id": 1805,
    "vorder": 10,
    "position": 1,
    "text": "به قنوج بر کشوری سر بدی"
  },
  {
    "poem_id": 1805,
    "vorder": 11,
    "position": 0,
    "text": "گر از نزد ما سوی ایران شود"
  },
  {
    "poem_id": 1805,
    "vorder": 12,
    "position": 1,
    "text": "ز بهرام قنوج ویران شود"
  },
  {
    "poem_id": 1805,
    "vorder": 13,
    "position": 0,
    "text": "چو کهتر چنین باشد و مهتر اوی"
  },
  {
    "poem_id": 1805,
    "vorder": 14,
    "position": 1,
    "text": "نماند برین بوم ما رنگ و بوی"
  },
  {
    "poem_id": 1805,
    "vorder": 15,
    "position": 0,
    "text": "همه شب همی کار او ساختم"
  },
  {
    "poem_id": 1805,
    "vorder": 16,
    "position": 1,
    "text": "یکی چارهٔ دیگر انداختم"
  },
  {
    "poem_id": 1805,
    "vorder": 17,
    "position": 0,
    "text": "فرستمش فردا بر اژدها"
  },
  {
    "poem_id": 1805,
    "vorder": 18,
    "position": 1,
    "text": "کزو بی‌گمانی نیابد رها"
  },
  {
    "poem_id": 1805,
    "vorder": 19,
    "position": 0,
    "text": "نباشم نکوهیدهٔ کار اوی"
  },
  {
    "poem_id": 1805,
    "vorder": 20,
    "position": 1,
    "text": "چو با اژدها خود شود جنگجوی"
  },
  {
    "poem_id": 1805,
    "vorder": 21,
    "position": 0,
    "text": "بگفت این و بهرام را پیش خواند"
  },
  {
    "poem_id": 1805,
    "vorder": 22,
    "position": 1,
    "text": "بسی داستان دلیران براند"
  },
  {
    "poem_id": 1805,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت یزدان پاک‌آفرین"
  },
  {
    "poem_id": 1805,
    "vorder": 24,
    "position": 1,
    "text": "ترا ایدر آورد ز ایران زمین"
  },
  {
    "poem_id": 1805,
    "vorder": 25,
    "position": 0,
    "text": "که هندوستان را بشویی ز بد"
  },
  {
    "poem_id": 1805,
    "vorder": 26,
    "position": 1,
    "text": "چنان کز ره نامداران سزد"
  },
  {
    "poem_id": 1805,
    "vorder": 27,
    "position": 0,
    "text": "یکی کار پیش است با درد و رنج"
  },
  {
    "poem_id": 1805,
    "vorder": 28,
    "position": 1,
    "text": "به آغاز رنج و به فرجام گنج"
  },
  {
    "poem_id": 1805,
    "vorder": 29,
    "position": 0,
    "text": "چو این کرده باشی زمانی مپای"
  },
  {
    "poem_id": 1805,
    "vorder": 30,
    "position": 1,
    "text": "به خشنودی من برو باز جای"
  },
  {
    "poem_id": 1805,
    "vorder": 31,
    "position": 0,
    "text": "به شنگل چنین پاسخ آورد شاه"
  },
  {
    "poem_id": 1805,
    "vorder": 32,
    "position": 1,
    "text": "ک از رای تو بگذرم نیست راه"
  },
  {
    "poem_id": 1805,
    "vorder": 33,
    "position": 0,
    "text": "ز فرمان تو نگذرم یک زمان"
  },
  {
    "poem_id": 1805,
    "vorder": 34,
    "position": 1,
    "text": "مگر بد بود گردش آسمان"
  },
  {
    "poem_id": 1805,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت شنگل که چندین بلاست"
  },
  {
    "poem_id": 1805,
    "vorder": 36,
    "position": 1,
    "text": "بدین بوم ما در یکی اژدهاست"
  },
  {
    "poem_id": 1805,
    "vorder": 37,
    "position": 0,
    "text": "به خشکی و دریا همی بگذرد"
  },
  {
    "poem_id": 1805,
    "vorder": 38,
    "position": 1,
    "text": "نهنگ دم آهنگ را بشمرد"
  },
  {
    "poem_id": 1805,
    "vorder": 39,
    "position": 0,
    "text": "توانی مگر چاره‌ای ساختن"
  },
  {
    "poem_id": 1805,
    "vorder": 40,
    "position": 1,
    "text": "ازو کشور هند پرداختن"
  },
  {
    "poem_id": 1805,
    "vorder": 41,
    "position": 0,
    "text": "به ایران بری باژ هندوستان"
  },
  {
    "poem_id": 1805,
    "vorder": 42,
    "position": 1,
    "text": "همه مرز باشند همداستان"
  },
  {
    "poem_id": 1805,
    "vorder": 43,
    "position": 0,
    "text": "همان هدیهٔ هند با باژ نیز"
  },
  {
    "poem_id": 1805,
    "vorder": 44,
    "position": 1,
    "text": "ز عود و ز عنبر ز هرگونه چیز"
  },
  {
    "poem_id": 1805,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت بهرام کای پادشا"
  },
  {
    "poem_id": 1805,
    "vorder": 46,
    "position": 1,
    "text": "بهند اندرون شاه و فرمانروا"
  },
  {
    "poem_id": 1805,
    "vorder": 47,
    "position": 0,
    "text": "به فرمان دارنده یزدان پاک"
  },
  {
    "poem_id": 1805,
    "vorder": 48,
    "position": 1,
    "text": "پی اژدها را ببرم ز خاک"
  },
  {
    "poem_id": 1805,
    "vorder": 49,
    "position": 0,
    "text": "ندانم که او را نشیمن کجاست"
  },
  {
    "poem_id": 1805,
    "vorder": 50,
    "position": 1,
    "text": "بباید نمودن به من راه راست"
  },
  {
    "poem_id": 1805,
    "vorder": 51,
    "position": 0,
    "text": "فرستاد شنگل یکی راه‌جوی"
  },
  {
    "poem_id": 1805,
    "vorder": 52,
    "position": 1,
    "text": "که آن اژدها را نماید بدوی"
  },
  {
    "poem_id": 1805,
    "vorder": 53,
    "position": 0,
    "text": "همی رفت با نامور سی سوار"
  },
  {
    "poem_id": 1805,
    "vorder": 54,
    "position": 1,
    "text": "از ایران سواران خنجرگزار"
  },
  {
    "poem_id": 1805,
    "vorder": 55,
    "position": 0,
    "text": "همی تاخت تا پیش دریا رسید"
  },
  {
    "poem_id": 1805,
    "vorder": 56,
    "position": 1,
    "text": "به تاریکی آن اژدها را بدید"
  },
  {
    "poem_id": 1805,
    "vorder": 57,
    "position": 0,
    "text": "بزرگان ایران خروشان شدند"
  },
  {
    "poem_id": 1805,
    "vorder": 58,
    "position": 1,
    "text": "وزان اژدها نیز جوشان شدند"
  },
  {
    "poem_id": 1805,
    "vorder": 59,
    "position": 0,
    "text": "به بهرام گفتند کای شهریار"
  },
  {
    "poem_id": 1805,
    "vorder": 60,
    "position": 1,
    "text": "تو این را چو آن کرگ پیشین مدار"
  },
  {
    "poem_id": 1805,
    "vorder": 61,
    "position": 0,
    "text": "به ایرانیان گفت بهرام گرد"
  },
  {
    "poem_id": 1805,
    "vorder": 62,
    "position": 1,
    "text": "که این را به دادار باید سپرد"
  },
  {
    "poem_id": 1805,
    "vorder": 63,
    "position": 0,
    "text": "مرا گر زمانه بدین اژدهاست"
  },
  {
    "poem_id": 1805,
    "vorder": 64,
    "position": 1,
    "text": "به مردی فزونی نگیرد نه کاست"
  },
  {
    "poem_id": 1805,
    "vorder": 65,
    "position": 0,
    "text": "کمان را به زه کرد و بگزید تیر"
  },
  {
    "poem_id": 1805,
    "vorder": 66,
    "position": 1,
    "text": "که پیکانش را داده بد زهر و شیر"
  },
  {
    "poem_id": 1805,
    "vorder": 67,
    "position": 0,
    "text": "بران اژدها تیرباران گرفت"
  },
  {
    "poem_id": 1805,
    "vorder": 68,
    "position": 1,
    "text": "چپ و راست جنگ سواران گرفت"
  },
  {
    "poem_id": 1805,
    "vorder": 69,
    "position": 0,
    "text": "به پولاد پیکان دهانش بدوخت"
  },
  {
    "poem_id": 1805,
    "vorder": 70,
    "position": 1,
    "text": "همی خار زان زهر او برفروخت"
  },
  {
    "poem_id": 1805,
    "vorder": 71,
    "position": 0,
    "text": "دگر چار چوبه بزد بر سرش"
  },
  {
    "poem_id": 1805,
    "vorder": 72,
    "position": 1,
    "text": "فرو ریخت با زهر خون از برش"
  },
  {
    "poem_id": 1805,
    "vorder": 73,
    "position": 0,
    "text": "تن اژدها گشت زان تیر سست"
  },
  {
    "poem_id": 1805,
    "vorder": 74,
    "position": 1,
    "text": "همی خاک را خون زهرش بشست"
  },
  {
    "poem_id": 1805,
    "vorder": 75,
    "position": 0,
    "text": "یکی تیغ زهرآبگون برکشید"
  },
  {
    "poem_id": 1805,
    "vorder": 76,
    "position": 1,
    "text": "به تندی دل اژدها بردرید"
  },
  {
    "poem_id": 1805,
    "vorder": 77,
    "position": 0,
    "text": "به تیغ و تبرزین بزد گردنش"
  },
  {
    "poem_id": 1805,
    "vorder": 78,
    "position": 1,
    "text": "به خاک اندر افگند بیجان تنش"
  },
  {
    "poem_id": 1805,
    "vorder": 79,
    "position": 0,
    "text": "به گردون سرش سوی شنگل کشید"
  },
  {
    "poem_id": 1805,
    "vorder": 80,
    "position": 1,
    "text": "چو شاه آن سر اژدها را بدید"
  },
  {
    "poem_id": 1805,
    "vorder": 81,
    "position": 0,
    "text": "برآمد ز هندوستان آفرین"
  },
  {
    "poem_id": 1805,
    "vorder": 82,
    "position": 1,
    "text": "ز دادار بر بوم ایران‌زمین"
  },
  {
    "poem_id": 1805,
    "vorder": 83,
    "position": 0,
    "text": "که زاید برآن خاک چونین سوار"
  },
  {
    "poem_id": 1805,
    "vorder": 84,
    "position": 1,
    "text": "که با اژدها سازد او کارزار"
  },
  {
    "poem_id": 1805,
    "vorder": 85,
    "position": 0,
    "text": "برین برز بالا و این شاخ و یال"
  },
  {
    "poem_id": 1805,
    "vorder": 86,
    "position": 1,
    "text": "نباشد جز از شهریارش همال"
  }
]