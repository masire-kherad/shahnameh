[
  {
    "poem_id": 1667,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه لشکر اندر کشید"
  },
  {
    "poem_id": 1667,
    "vorder": 2,
    "position": 1,
    "text": "دمان تا به شهر برهمن رسید"
  },
  {
    "poem_id": 1667,
    "vorder": 3,
    "position": 0,
    "text": "بدان تا ز کردارهای کهن"
  },
  {
    "poem_id": 1667,
    "vorder": 4,
    "position": 1,
    "text": "بپرسد ز پرهیزگاران سخن"
  },
  {
    "poem_id": 1667,
    "vorder": 5,
    "position": 0,
    "text": "برهمن چو آگه شد از کار شاه"
  },
  {
    "poem_id": 1667,
    "vorder": 6,
    "position": 1,
    "text": "که آورد زان روی لشگر به راه"
  },
  {
    "poem_id": 1667,
    "vorder": 7,
    "position": 0,
    "text": "پرستنده مرد اندر آمد ز کوه"
  },
  {
    "poem_id": 1667,
    "vorder": 8,
    "position": 1,
    "text": "شدند اندران آگهی همگروه"
  },
  {
    "poem_id": 1667,
    "vorder": 9,
    "position": 0,
    "text": "نوشتند پس نامه‌ای بخردان"
  },
  {
    "poem_id": 1667,
    "vorder": 10,
    "position": 1,
    "text": "به نزد سکندر سر موبدان"
  },
  {
    "poem_id": 1667,
    "vorder": 11,
    "position": 0,
    "text": "سر نامه بود آفرین نهان"
  },
  {
    "poem_id": 1667,
    "vorder": 12,
    "position": 1,
    "text": "ز داننده بر شهریار جهان"
  },
  {
    "poem_id": 1667,
    "vorder": 13,
    "position": 0,
    "text": "که پیروزگر باد همواره شاه"
  },
  {
    "poem_id": 1667,
    "vorder": 14,
    "position": 1,
    "text": "به افزایش و دانش و دستگاه"
  },
  {
    "poem_id": 1667,
    "vorder": 15,
    "position": 0,
    "text": "دگر گفت کای شهریار سترگ"
  },
  {
    "poem_id": 1667,
    "vorder": 16,
    "position": 1,
    "text": "ترا داد یزدان جهان بزرگ"
  },
  {
    "poem_id": 1667,
    "vorder": 17,
    "position": 0,
    "text": "چه داری بدین مرز بی‌ارز رای"
  },
  {
    "poem_id": 1667,
    "vorder": 18,
    "position": 1,
    "text": "نشست پرستندگان خدای"
  },
  {
    "poem_id": 1667,
    "vorder": 19,
    "position": 0,
    "text": "گرین آمدنت از پی خواسته‌ست"
  },
  {
    "poem_id": 1667,
    "vorder": 20,
    "position": 1,
    "text": "خرد بی‌گمان نزد تو کاسته‌ست"
  },
  {
    "poem_id": 1667,
    "vorder": 21,
    "position": 0,
    "text": "بر ما شکیبایی و دانش است"
  },
  {
    "poem_id": 1667,
    "vorder": 22,
    "position": 1,
    "text": "ز دانش روانها پر از رامش است"
  },
  {
    "poem_id": 1667,
    "vorder": 23,
    "position": 0,
    "text": "شکیبایی از ما نشاید ستد"
  },
  {
    "poem_id": 1667,
    "vorder": 24,
    "position": 1,
    "text": "نه کس را ز دانش رسد نیز بد"
  },
  {
    "poem_id": 1667,
    "vorder": 25,
    "position": 0,
    "text": "نبینی جز از برهنه یک رمه"
  },
  {
    "poem_id": 1667,
    "vorder": 26,
    "position": 1,
    "text": "پراگنده از روزگار دمه"
  },
  {
    "poem_id": 1667,
    "vorder": 27,
    "position": 0,
    "text": "اگر بودن ایدر دراز آیدت"
  },
  {
    "poem_id": 1667,
    "vorder": 28,
    "position": 1,
    "text": "به تخم گیاها نیاز آیدت"
  },
  {
    "poem_id": 1667,
    "vorder": 29,
    "position": 0,
    "text": "فرستاده آمد بر شهریار"
  },
  {
    "poem_id": 1667,
    "vorder": 30,
    "position": 1,
    "text": "ز بیخ گیا بر میانش ازار"
  },
  {
    "poem_id": 1667,
    "vorder": 31,
    "position": 0,
    "text": "سکندر فرستاده و نامه دید"
  },
  {
    "poem_id": 1667,
    "vorder": 32,
    "position": 1,
    "text": "بی‌آزاری و رامشی برگزید"
  },
  {
    "poem_id": 1667,
    "vorder": 33,
    "position": 0,
    "text": "سپه را سراسر هم آنجا بماند"
  },
  {
    "poem_id": 1667,
    "vorder": 34,
    "position": 1,
    "text": "خود و فیلسوفان رومی براند"
  },
  {
    "poem_id": 1667,
    "vorder": 35,
    "position": 0,
    "text": "پرستنده آگه شد از کار شاه"
  },
  {
    "poem_id": 1667,
    "vorder": 36,
    "position": 1,
    "text": "پذیره شدندش یکایک به راه"
  },
  {
    "poem_id": 1667,
    "vorder": 37,
    "position": 0,
    "text": "ببردند بی‌مایه چیزی که بود"
  },
  {
    "poem_id": 1667,
    "vorder": 38,
    "position": 1,
    "text": "که نه گنج بدشان نه کشت و درود"
  },
  {
    "poem_id": 1667,
    "vorder": 39,
    "position": 0,
    "text": "یکایک برو خواندند آفرین"
  },
  {
    "poem_id": 1667,
    "vorder": 40,
    "position": 1,
    "text": "بران برمنش شهریار زمین"
  },
  {
    "poem_id": 1667,
    "vorder": 41,
    "position": 0,
    "text": "سکندر چو روی برهمن بدید"
  },
  {
    "poem_id": 1667,
    "vorder": 42,
    "position": 1,
    "text": "بران گونه آواز ایشان شنید"
  },
  {
    "poem_id": 1667,
    "vorder": 43,
    "position": 0,
    "text": "دوان و برهنه تن و پای و سر"
  },
  {
    "poem_id": 1667,
    "vorder": 44,
    "position": 1,
    "text": "تنان بی‌بر و جان ز دانش به بر"
  },
  {
    "poem_id": 1667,
    "vorder": 45,
    "position": 0,
    "text": "ز برگ گیا پوشش از تخم خورد"
  },
  {
    "poem_id": 1667,
    "vorder": 46,
    "position": 1,
    "text": "برآسوده از رزم و روز نبرد"
  },
  {
    "poem_id": 1667,
    "vorder": 47,
    "position": 0,
    "text": "خور و خواب و آرام بر دشت و کوه"
  },
  {
    "poem_id": 1667,
    "vorder": 48,
    "position": 1,
    "text": "برهنه به هر جای گشته گروه"
  },
  {
    "poem_id": 1667,
    "vorder": 49,
    "position": 0,
    "text": "همه خوردنیشان بر میوه‌دار"
  },
  {
    "poem_id": 1667,
    "vorder": 50,
    "position": 1,
    "text": "ز تخم گیا رسته بر کوهسار"
  },
  {
    "poem_id": 1667,
    "vorder": 51,
    "position": 0,
    "text": "ازار یکی چرم نخچیر بود"
  },
  {
    "poem_id": 1667,
    "vorder": 52,
    "position": 1,
    "text": "گیا پوشش و خوردن آژیر بود"
  },
  {
    "poem_id": 1667,
    "vorder": 53,
    "position": 0,
    "text": "سکندر بپرسیدش از خواب و خورد"
  },
  {
    "poem_id": 1667,
    "vorder": 54,
    "position": 1,
    "text": "از آسایش روز ننگ و نبرد"
  },
  {
    "poem_id": 1667,
    "vorder": 55,
    "position": 0,
    "text": "ز پوشیدنی و ز گستردنی"
  },
  {
    "poem_id": 1667,
    "vorder": 56,
    "position": 1,
    "text": "همه بی‌نیازیم از خوردنی"
  },
  {
    "poem_id": 1667,
    "vorder": 57,
    "position": 0,
    "text": "برهنه چو زاید ز مادر کسی"
  },
  {
    "poem_id": 1667,
    "vorder": 58,
    "position": 1,
    "text": "نباید که نازد بپوشش بسی"
  },
  {
    "poem_id": 1667,
    "vorder": 59,
    "position": 0,
    "text": "وز ایدر برهنه شود باز خاک"
  },
  {
    "poem_id": 1667,
    "vorder": 60,
    "position": 1,
    "text": "همه جای ترس است و تیمار و باک"
  },
  {
    "poem_id": 1667,
    "vorder": 61,
    "position": 0,
    "text": "زمین بستر و پوشش از آسمان"
  },
  {
    "poem_id": 1667,
    "vorder": 62,
    "position": 1,
    "text": "به ره دیده‌بان تا کی آید زمان"
  },
  {
    "poem_id": 1667,
    "vorder": 63,
    "position": 0,
    "text": "جهانجوی چندین بکوشد به چیز"
  },
  {
    "poem_id": 1667,
    "vorder": 64,
    "position": 1,
    "text": "که آن چیز کوشش نیرزد به نیز"
  },
  {
    "poem_id": 1667,
    "vorder": 65,
    "position": 0,
    "text": "چنو بگذرد زین سرای سپنج"
  },
  {
    "poem_id": 1667,
    "vorder": 66,
    "position": 1,
    "text": "ازو بازماند زر و تاج و گنج"
  },
  {
    "poem_id": 1667,
    "vorder": 67,
    "position": 0,
    "text": "چنان دان که نیکیست همراه اوی"
  },
  {
    "poem_id": 1667,
    "vorder": 68,
    "position": 1,
    "text": "به خاک اندر آید سر و گاه اوی"
  },
  {
    "poem_id": 1667,
    "vorder": 69,
    "position": 0,
    "text": "سکندر بپرسید که کاندر جهان"
  },
  {
    "poem_id": 1667,
    "vorder": 70,
    "position": 1,
    "text": "فزون آشکارا بود گر نهان"
  },
  {
    "poem_id": 1667,
    "vorder": 71,
    "position": 0,
    "text": "همان زنده بیش است گر مرده نیز"
  },
  {
    "poem_id": 1667,
    "vorder": 72,
    "position": 1,
    "text": "کزان پس نیازش نیاید به چیز"
  },
  {
    "poem_id": 1667,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد پاسخ که ای شهریار"
  },
  {
    "poem_id": 1667,
    "vorder": 74,
    "position": 1,
    "text": "تو گر مرده را بشمری صدهزار"
  },
  {
    "poem_id": 1667,
    "vorder": 75,
    "position": 0,
    "text": "ازان صد هزاران یکی زنده نیست"
  },
  {
    "poem_id": 1667,
    "vorder": 76,
    "position": 1,
    "text": "خنک آنک در دوزخ افگنده نیست"
  },
  {
    "poem_id": 1667,
    "vorder": 77,
    "position": 0,
    "text": "بباید همین زنده را نیز مرد"
  },
  {
    "poem_id": 1667,
    "vorder": 78,
    "position": 1,
    "text": "یکی رفت و نوبت به دیگر سپرد"
  },
  {
    "poem_id": 1667,
    "vorder": 79,
    "position": 0,
    "text": "بپرسید خشکی فزون‌تر گر آب"
  },
  {
    "poem_id": 1667,
    "vorder": 80,
    "position": 1,
    "text": "بتابد بروبر همی آفتاب"
  },
  {
    "poem_id": 1667,
    "vorder": 81,
    "position": 0,
    "text": "برهمن چنین داد پاسخ به شاه"
  },
  {
    "poem_id": 1667,
    "vorder": 82,
    "position": 1,
    "text": "که هم آب را خاک دارد نگاه"
  },
  {
    "poem_id": 1667,
    "vorder": 83,
    "position": 0,
    "text": "بپرسید کز خواب بیدار کیست"
  },
  {
    "poem_id": 1667,
    "vorder": 84,
    "position": 1,
    "text": "به روی زمین بر گنهکار کیست"
  },
  {
    "poem_id": 1667,
    "vorder": 85,
    "position": 0,
    "text": "که جنبندگانند و چندی زیند"
  },
  {
    "poem_id": 1667,
    "vorder": 86,
    "position": 1,
    "text": "ندانند کاندر جهان برچیند"
  },
  {
    "poem_id": 1667,
    "vorder": 87,
    "position": 0,
    "text": "برهمن چنین داد پاسخ بدوی"
  },
  {
    "poem_id": 1667,
    "vorder": 88,
    "position": 1,
    "text": "که ای پاکدل مهتر راست گوی"
  },
  {
    "poem_id": 1667,
    "vorder": 89,
    "position": 0,
    "text": "گنهکارتر چیز مردم بود"
  },
  {
    "poem_id": 1667,
    "vorder": 90,
    "position": 1,
    "text": "که از کین و آزش خرد گم بود"
  },
  {
    "poem_id": 1667,
    "vorder": 91,
    "position": 0,
    "text": "چو خواهی که این را بدانی درست"
  },
  {
    "poem_id": 1667,
    "vorder": 92,
    "position": 1,
    "text": "تن خویشتن را نگه کن نخست"
  },
  {
    "poem_id": 1667,
    "vorder": 93,
    "position": 0,
    "text": "که روی زمین سربسر پیش تست"
  },
  {
    "poem_id": 1667,
    "vorder": 94,
    "position": 1,
    "text": "تو گویی سپهر روان خویش تست"
  },
  {
    "poem_id": 1667,
    "vorder": 95,
    "position": 0,
    "text": "همی رای داری که افزون کنی"
  },
  {
    "poem_id": 1667,
    "vorder": 96,
    "position": 1,
    "text": "ز خاک سیه مغز بیرون کنی"
  },
  {
    "poem_id": 1667,
    "vorder": 97,
    "position": 0,
    "text": "روان ترا دوزخ است آرزوی"
  },
  {
    "poem_id": 1667,
    "vorder": 98,
    "position": 1,
    "text": "مگر زین سخن بازگردی به خوی"
  },
  {
    "poem_id": 1667,
    "vorder": 99,
    "position": 0,
    "text": "دگر گفت بر جان ما شاه کیست"
  },
  {
    "poem_id": 1667,
    "vorder": 100,
    "position": 1,
    "text": "به کژی بهر جای همراه کیست"
  },
  {
    "poem_id": 1667,
    "vorder": 101,
    "position": 0,
    "text": "چنین داد پاسخ که آز است شاه"
  },
  {
    "poem_id": 1667,
    "vorder": 102,
    "position": 1,
    "text": "سر مایهٔ کین و جای گناه"
  },
  {
    "poem_id": 1667,
    "vorder": 103,
    "position": 0,
    "text": "بپرسید خود گوهر از بهر چیست"
  },
  {
    "poem_id": 1667,
    "vorder": 104,
    "position": 1,
    "text": "کش از بهر بیشی بباید گریست"
  },
  {
    "poem_id": 1667,
    "vorder": 105,
    "position": 0,
    "text": "چنین داد پاسخ که آز و نیاز"
  },
  {
    "poem_id": 1667,
    "vorder": 106,
    "position": 1,
    "text": "دو دیوند بیچاره و دیوساز"
  },
  {
    "poem_id": 1667,
    "vorder": 107,
    "position": 0,
    "text": "یکی را ز کمی شده خشک لب"
  },
  {
    "poem_id": 1667,
    "vorder": 108,
    "position": 1,
    "text": "یکی از فزونیست بی‌خواب شب"
  },
  {
    "poem_id": 1667,
    "vorder": 109,
    "position": 0,
    "text": "همان هر دو را روز می بشکرد"
  },
  {
    "poem_id": 1667,
    "vorder": 110,
    "position": 1,
    "text": "خنک آنک جانش پذیرد خرد"
  },
  {
    "poem_id": 1667,
    "vorder": 111,
    "position": 0,
    "text": "سکندر چو گفتار ایشان شنید"
  },
  {
    "poem_id": 1667,
    "vorder": 112,
    "position": 1,
    "text": "به رخساره شد چون گل شنبلید"
  },
  {
    "poem_id": 1667,
    "vorder": 113,
    "position": 0,
    "text": "دو رخ زرد و دیده پر از آب کرد"
  },
  {
    "poem_id": 1667,
    "vorder": 114,
    "position": 1,
    "text": "همان چهر خندان پر از تاب کرد"
  },
  {
    "poem_id": 1667,
    "vorder": 115,
    "position": 0,
    "text": "بپرسید پس شاه فرمانروا"
  },
  {
    "poem_id": 1667,
    "vorder": 116,
    "position": 1,
    "text": "که حاجت چه باشد شما را به ما"
  },
  {
    "poem_id": 1667,
    "vorder": 117,
    "position": 0,
    "text": "ندارم دریغ از شما گنج خویش"
  },
  {
    "poem_id": 1667,
    "vorder": 118,
    "position": 1,
    "text": "نه هرگز براندیشم از رنج خویش"
  },
  {
    "poem_id": 1667,
    "vorder": 119,
    "position": 0,
    "text": "بگفتند کای شهریار بلند"
  },
  {
    "poem_id": 1667,
    "vorder": 120,
    "position": 1,
    "text": "در مرگ و پیری تو بر ما ببند"
  },
  {
    "poem_id": 1667,
    "vorder": 121,
    "position": 0,
    "text": "چنین داد پاسخ ورا شهریار"
  },
  {
    "poem_id": 1667,
    "vorder": 122,
    "position": 1,
    "text": "که بامرگ خواهش نیاید به کار"
  },
  {
    "poem_id": 1667,
    "vorder": 123,
    "position": 0,
    "text": "چه پرهیزی از تیز چنگ اژدها"
  },
  {
    "poem_id": 1667,
    "vorder": 124,
    "position": 1,
    "text": "که گرزآهنی زو نیابی رها"
  },
  {
    "poem_id": 1667,
    "vorder": 125,
    "position": 0,
    "text": "جوانی که آید بمابر دراز"
  },
  {
    "poem_id": 1667,
    "vorder": 126,
    "position": 1,
    "text": "هم از روز پیری نیابد جواز"
  },
  {
    "poem_id": 1667,
    "vorder": 127,
    "position": 0,
    "text": "برهمن بدو گفت کای پادشا"
  },
  {
    "poem_id": 1667,
    "vorder": 128,
    "position": 1,
    "text": "جهاندار و دانا و فرمانروا"
  },
  {
    "poem_id": 1667,
    "vorder": 129,
    "position": 0,
    "text": "چو دانی که از مرگ خود چاره نیست"
  },
  {
    "poem_id": 1667,
    "vorder": 130,
    "position": 1,
    "text": "ز پیری بتر نیز پتیاره نیست"
  },
  {
    "poem_id": 1667,
    "vorder": 131,
    "position": 0,
    "text": "جهان را به کوشش چه جویی همی"
  },
  {
    "poem_id": 1667,
    "vorder": 132,
    "position": 1,
    "text": "گل زهر خیره چه بویی همی"
  },
  {
    "poem_id": 1667,
    "vorder": 133,
    "position": 0,
    "text": "ز تو بازماند همین رنج تو"
  },
  {
    "poem_id": 1667,
    "vorder": 134,
    "position": 1,
    "text": "به دشمن رسد کوشش و گنج تو"
  },
  {
    "poem_id": 1667,
    "vorder": 135,
    "position": 0,
    "text": "ز بهر کسان رنج بر تن نهی"
  },
  {
    "poem_id": 1667,
    "vorder": 136,
    "position": 1,
    "text": "ز کم دانشی باشد و ابلهی"
  },
  {
    "poem_id": 1667,
    "vorder": 137,
    "position": 0,
    "text": "پیامست از مرگ موی سپید"
  },
  {
    "poem_id": 1667,
    "vorder": 138,
    "position": 1,
    "text": "به بودن چه داری تو چندین امید"
  },
  {
    "poem_id": 1667,
    "vorder": 139,
    "position": 0,
    "text": "چنین گفت بیداردل شهریار"
  },
  {
    "poem_id": 1667,
    "vorder": 140,
    "position": 1,
    "text": "که گر بنده از بخشش کردگار"
  },
  {
    "poem_id": 1667,
    "vorder": 141,
    "position": 0,
    "text": "گذر یافتی بودمی من همان"
  },
  {
    "poem_id": 1667,
    "vorder": 142,
    "position": 1,
    "text": "به تدبیر بر گشتن آسمان"
  },
  {
    "poem_id": 1667,
    "vorder": 143,
    "position": 0,
    "text": "که فرزانه و مرد پرخاشخر"
  },
  {
    "poem_id": 1667,
    "vorder": 144,
    "position": 1,
    "text": "ز بخشش به کوشش نیابد گذر"
  },
  {
    "poem_id": 1667,
    "vorder": 145,
    "position": 0,
    "text": "دگر هرک در جنگ من کشته شد"
  },
  {
    "poem_id": 1667,
    "vorder": 146,
    "position": 1,
    "text": "کرا ز اخترش روز برگشته شد"
  },
  {
    "poem_id": 1667,
    "vorder": 147,
    "position": 0,
    "text": "به درد و به خون ریختن بد سزا"
  },
  {
    "poem_id": 1667,
    "vorder": 148,
    "position": 1,
    "text": "که بیدادگر کس نیابد رها"
  },
  {
    "poem_id": 1667,
    "vorder": 149,
    "position": 0,
    "text": "بدیدند بادافره ایزدی"
  },
  {
    "poem_id": 1667,
    "vorder": 150,
    "position": 1,
    "text": "چو گشتند باز از ره بخردی"
  },
  {
    "poem_id": 1667,
    "vorder": 151,
    "position": 0,
    "text": "کس از خواست یزدان کرانه نیافت"
  },
  {
    "poem_id": 1667,
    "vorder": 152,
    "position": 1,
    "text": "ز کار زمانه بهانه نیافت"
  },
  {
    "poem_id": 1667,
    "vorder": 153,
    "position": 0,
    "text": "بسی چیز بخشید و نستد کسی"
  },
  {
    "poem_id": 1667,
    "vorder": 154,
    "position": 1,
    "text": "نبد آز نزدیک ایشان بسی"
  },
  {
    "poem_id": 1667,
    "vorder": 155,
    "position": 0,
    "text": "بی‌آزار ازان جایگه برگرفت"
  },
  {
    "poem_id": 1667,
    "vorder": 156,
    "position": 1,
    "text": "بران هم نشان راه خاور گرفت"
  }
]