[
  {
    "poem_id": 1546,
    "vorder": 1,
    "position": 0,
    "text": "کی نامبردار فرخنده شاه"
  },
  {
    "poem_id": 1546,
    "vorder": 2,
    "position": 1,
    "text": "سوی گاه باز آمد از رزمگاه"
  },
  {
    "poem_id": 1546,
    "vorder": 3,
    "position": 0,
    "text": "به بستور گفتا که فردا پکاه"
  },
  {
    "poem_id": 1546,
    "vorder": 4,
    "position": 1,
    "text": "سوی کشور نامور کش سپاه"
  },
  {
    "poem_id": 1546,
    "vorder": 5,
    "position": 0,
    "text": "بیامد سپهبد هم از بامداد"
  },
  {
    "poem_id": 1546,
    "vorder": 6,
    "position": 1,
    "text": "بزد کوس و لشکر بنه برنهاد"
  },
  {
    "poem_id": 1546,
    "vorder": 7,
    "position": 0,
    "text": "به ایران زمین باز کردند روی"
  },
  {
    "poem_id": 1546,
    "vorder": 8,
    "position": 1,
    "text": "همه خیره دل گشته و جنگجوی"
  },
  {
    "poem_id": 1546,
    "vorder": 9,
    "position": 0,
    "text": "همه خستگان را ببردند نیز"
  },
  {
    "poem_id": 1546,
    "vorder": 10,
    "position": 1,
    "text": "نماندند از خواسته نیز چیز"
  },
  {
    "poem_id": 1546,
    "vorder": 11,
    "position": 0,
    "text": "به ایران زمین باز بردندشان"
  },
  {
    "poem_id": 1546,
    "vorder": 12,
    "position": 1,
    "text": "به دانا پزشکان سپردندشان"
  },
  {
    "poem_id": 1546,
    "vorder": 13,
    "position": 0,
    "text": "چو شاه جهان باز شد بازجای"
  },
  {
    "poem_id": 1546,
    "vorder": 14,
    "position": 1,
    "text": "به پور مهین داد فرخ همای"
  },
  {
    "poem_id": 1546,
    "vorder": 15,
    "position": 0,
    "text": "سپه را به بستور فرخنده داد"
  },
  {
    "poem_id": 1546,
    "vorder": 16,
    "position": 1,
    "text": "عجم را چنین بود آیین و داد"
  },
  {
    "poem_id": 1546,
    "vorder": 17,
    "position": 0,
    "text": "بدادش از آزادگان ده هزار"
  },
  {
    "poem_id": 1546,
    "vorder": 18,
    "position": 1,
    "text": "سواران جنگی و نیزه گزار"
  },
  {
    "poem_id": 1546,
    "vorder": 19,
    "position": 0,
    "text": "بفرمود و گفت ای گو رزمسار"
  },
  {
    "poem_id": 1546,
    "vorder": 20,
    "position": 1,
    "text": "یکی بر پی شاه توران بتاز"
  },
  {
    "poem_id": 1546,
    "vorder": 21,
    "position": 0,
    "text": "به ایتاش و خَلُّخ ستان برگذر"
  },
  {
    "poem_id": 1546,
    "vorder": 22,
    "position": 1,
    "text": "بکش هرک یابی به کین پدر"
  },
  {
    "poem_id": 1546,
    "vorder": 23,
    "position": 0,
    "text": "ز هرچیز بایست بردش به کار"
  },
  {
    "poem_id": 1546,
    "vorder": 24,
    "position": 1,
    "text": "بدادش همه بی‌مر و بی‌شمار"
  },
  {
    "poem_id": 1546,
    "vorder": 25,
    "position": 0,
    "text": "هم‌آنگاه بستور برد آن سپاه"
  },
  {
    "poem_id": 1546,
    "vorder": 26,
    "position": 1,
    "text": "و شاه جهان از بر تخت و گاه"
  },
  {
    "poem_id": 1546,
    "vorder": 27,
    "position": 0,
    "text": "نشست و کیی تاج بر سر نهاد"
  },
  {
    "poem_id": 1546,
    "vorder": 28,
    "position": 1,
    "text": "سپه را همه یکسره بار داد"
  },
  {
    "poem_id": 1546,
    "vorder": 29,
    "position": 0,
    "text": "در گنج بگشاد وز خواسته"
  },
  {
    "poem_id": 1546,
    "vorder": 30,
    "position": 1,
    "text": "سپه را همه کرد آراسته"
  },
  {
    "poem_id": 1546,
    "vorder": 31,
    "position": 0,
    "text": "سران را همه شهرها داد نیز"
  },
  {
    "poem_id": 1546,
    "vorder": 32,
    "position": 1,
    "text": "سکی را نماند ایچ ناداده چیز"
  },
  {
    "poem_id": 1546,
    "vorder": 33,
    "position": 0,
    "text": "کرا پادشاهی سزا بد بداد"
  },
  {
    "poem_id": 1546,
    "vorder": 34,
    "position": 1,
    "text": "کرا پایه بایست پایه نهاد"
  },
  {
    "poem_id": 1546,
    "vorder": 35,
    "position": 0,
    "text": "چو اندر خور کارشان داد ساز"
  },
  {
    "poem_id": 1546,
    "vorder": 36,
    "position": 1,
    "text": "سوی خانهاشان فرستاد باز"
  },
  {
    "poem_id": 1546,
    "vorder": 37,
    "position": 0,
    "text": "خرامید بر گاه و باره ببست"
  },
  {
    "poem_id": 1546,
    "vorder": 38,
    "position": 1,
    "text": "به کاخ شهنشاهی اندر نشست"
  },
  {
    "poem_id": 1546,
    "vorder": 39,
    "position": 0,
    "text": "بفرمود تا آذر افروختند"
  },
  {
    "poem_id": 1546,
    "vorder": 40,
    "position": 1,
    "text": "برو عود و عنبر همی سوختند"
  },
  {
    "poem_id": 1546,
    "vorder": 41,
    "position": 0,
    "text": "زمینش بکردند از زر پاک"
  },
  {
    "poem_id": 1546,
    "vorder": 42,
    "position": 1,
    "text": "همه هیزمش عود و عنبرش خاک"
  },
  {
    "poem_id": 1546,
    "vorder": 43,
    "position": 0,
    "text": "همه کاخ را کار اندام کرد"
  },
  {
    "poem_id": 1546,
    "vorder": 44,
    "position": 1,
    "text": "پسش خان گشتاسپیان نام کرد"
  },
  {
    "poem_id": 1546,
    "vorder": 45,
    "position": 0,
    "text": "بفرمود تا بر در گنبدش"
  },
  {
    "poem_id": 1546,
    "vorder": 46,
    "position": 1,
    "text": "بدادند جاماسپ را موبدش"
  },
  {
    "poem_id": 1546,
    "vorder": 47,
    "position": 0,
    "text": "سوی مرزدارانش نامه نوشت"
  },
  {
    "poem_id": 1546,
    "vorder": 48,
    "position": 1,
    "text": "که ما را خداوند یافه نهشت"
  },
  {
    "poem_id": 1546,
    "vorder": 49,
    "position": 0,
    "text": "شبان شده تیره‌مان روز کرد"
  },
  {
    "poem_id": 1546,
    "vorder": 50,
    "position": 1,
    "text": "کیان را به هر جای پیروز کرد"
  },
  {
    "poem_id": 1546,
    "vorder": 51,
    "position": 0,
    "text": "به نفرین شد ارجاسپ ناآفرین"
  },
  {
    "poem_id": 1546,
    "vorder": 52,
    "position": 1,
    "text": "چنین است کار جهان آفرین"
  },
  {
    "poem_id": 1546,
    "vorder": 53,
    "position": 0,
    "text": "چو پیروزی شاهتان بشنوید"
  },
  {
    "poem_id": 1546,
    "vorder": 54,
    "position": 1,
    "text": "گزیتی به آذر پرستان دهید"
  },
  {
    "poem_id": 1546,
    "vorder": 55,
    "position": 0,
    "text": "چو آگاه شد قیصر آن شاه روم"
  },
  {
    "poem_id": 1546,
    "vorder": 56,
    "position": 1,
    "text": "که فرخ شد آن شاه و ارجاسپ شوم"
  },
  {
    "poem_id": 1546,
    "vorder": 57,
    "position": 0,
    "text": "فرسته فرستاد با خواسته"
  },
  {
    "poem_id": 1546,
    "vorder": 58,
    "position": 1,
    "text": "غلامان و اسپان آراسته"
  },
  {
    "poem_id": 1546,
    "vorder": 59,
    "position": 0,
    "text": "شه بت‌پرستان و رایان هند"
  },
  {
    "poem_id": 1546,
    "vorder": 60,
    "position": 1,
    "text": "گزیتش بدادند شاهان سند"
  }
]