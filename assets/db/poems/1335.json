[
  {
    "poem_id": 1335,
    "vorder": 1,
    "position": 0,
    "text": "سخن‌گوی دهقان چه گوید نخست"
  },
  {
    "poem_id": 1335,
    "vorder": 2,
    "position": 1,
    "text": "که نام بزرگی به گیتی که جست"
  },
  {
    "poem_id": 1335,
    "vorder": 3,
    "position": 0,
    "text": "که بود آن که دیهیم بر سر نهاد"
  },
  {
    "poem_id": 1335,
    "vorder": 4,
    "position": 1,
    "text": "ندارد کس آن روزگاران به یاد"
  },
  {
    "poem_id": 1335,
    "vorder": 5,
    "position": 0,
    "text": "مگر کز پدر یاد دارد پسر"
  },
  {
    "poem_id": 1335,
    "vorder": 6,
    "position": 1,
    "text": "بگوید تو را یک به یک در به در"
  },
  {
    "poem_id": 1335,
    "vorder": 7,
    "position": 0,
    "text": "که نام بزرگی که آورد پیش"
  },
  {
    "poem_id": 1335,
    "vorder": 8,
    "position": 1,
    "text": "که را بود از آن برتران پایه بیش"
  },
  {
    "poem_id": 1335,
    "vorder": 9,
    "position": 0,
    "text": "پژوهندهٔ نامهٔ باستان"
  },
  {
    "poem_id": 1335,
    "vorder": 10,
    "position": 1,
    "text": "که از پهلوانان زند داستان"
  },
  {
    "poem_id": 1335,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت کآیین تخت و کلاه"
  },
  {
    "poem_id": 1335,
    "vorder": 12,
    "position": 1,
    "text": "کیومرث آورد و او بود شاه"
  },
  {
    "poem_id": 1335,
    "vorder": 13,
    "position": 0,
    "text": "چو آمد به برج حَمَل آفتاب"
  },
  {
    "poem_id": 1335,
    "vorder": 14,
    "position": 1,
    "text": "جهان گشت با فرَ و آیین و آب"
  },
  {
    "poem_id": 1335,
    "vorder": 15,
    "position": 0,
    "text": "بتابید از آن سان ز برج بره"
  },
  {
    "poem_id": 1335,
    "vorder": 16,
    "position": 1,
    "text": "که گیتی جوان گشت از آن یک‌سره"
  },
  {
    "poem_id": 1335,
    "vorder": 17,
    "position": 0,
    "text": "کیومرث شد بر جهان کدخدای"
  },
  {
    "poem_id": 1335,
    "vorder": 18,
    "position": 1,
    "text": "نخستین به کوه اندرون ساخت جای"
  },
  {
    "poem_id": 1335,
    "vorder": 19,
    "position": 0,
    "text": "سر بخت و تختش بر آمد به کوه"
  },
  {
    "poem_id": 1335,
    "vorder": 20,
    "position": 1,
    "text": "پلنگینه پوشید خود با گروه"
  },
  {
    "poem_id": 1335,
    "vorder": 21,
    "position": 0,
    "text": "از او اندر آمد همی پرورش"
  },
  {
    "poem_id": 1335,
    "vorder": 22,
    "position": 1,
    "text": "که پوشیدنی نو بُد و نو خورش"
  },
  {
    "poem_id": 1335,
    "vorder": 23,
    "position": 0,
    "text": "به گیتی درون سال سی شاه بود"
  },
  {
    "poem_id": 1335,
    "vorder": 24,
    "position": 1,
    "text": "به خوبی چو خورشید بر گاه بود"
  },
  {
    "poem_id": 1335,
    "vorder": 25,
    "position": 0,
    "text": "همی تافت زو فرّ شاهنشهی"
  },
  {
    "poem_id": 1335,
    "vorder": 26,
    "position": 1,
    "text": "چو ماه دو هفته ز سرو سهی"
  },
  {
    "poem_id": 1335,
    "vorder": 27,
    "position": 0,
    "text": "دد و دام و هر جانور کش بدید"
  },
  {
    "poem_id": 1335,
    "vorder": 28,
    "position": 1,
    "text": "ز گیتی به نزدیک او آرمید"
  },
  {
    "poem_id": 1335,
    "vorder": 29,
    "position": 0,
    "text": "دوتا می‌شدندی بر تخت او"
  },
  {
    "poem_id": 1335,
    "vorder": 30,
    "position": 1,
    "text": "از آن بر شده فرّه و بخت او"
  },
  {
    "poem_id": 1335,
    "vorder": 31,
    "position": 0,
    "text": "به رسم نماز آمدندیش پیش"
  },
  {
    "poem_id": 1335,
    "vorder": 32,
    "position": 1,
    "text": "و ز او برگرفتند آیین خویش"
  },
  {
    "poem_id": 1335,
    "vorder": 33,
    "position": 0,
    "text": "پسر بد مر او را یکی خوب‌روی"
  },
  {
    "poem_id": 1335,
    "vorder": 34,
    "position": 1,
    "text": "هنرمند و همچون پدر نامجوی"
  },
  {
    "poem_id": 1335,
    "vorder": 35,
    "position": 0,
    "text": "سیامک بُدش نام و فرخنده بود"
  },
  {
    "poem_id": 1335,
    "vorder": 36,
    "position": 1,
    "text": "کیومرث را دل بدو زنده بود"
  },
  {
    "poem_id": 1335,
    "vorder": 37,
    "position": 0,
    "text": "به جانش بر از مهر گریان بدی"
  },
  {
    "poem_id": 1335,
    "vorder": 38,
    "position": 1,
    "text": "ز بیم جداییش بریان بدی"
  },
  {
    "poem_id": 1335,
    "vorder": 39,
    "position": 0,
    "text": "بر آمد بر این کار یک روزگار"
  },
  {
    "poem_id": 1335,
    "vorder": 40,
    "position": 1,
    "text": "فروزنده شد دولت شهریار"
  },
  {
    "poem_id": 1335,
    "vorder": 41,
    "position": 0,
    "text": "به گیتی نبودش کسی دشمنا"
  },
  {
    "poem_id": 1335,
    "vorder": 42,
    "position": 1,
    "text": "مگر بدکنش ریمن آهرمنا"
  },
  {
    "poem_id": 1335,
    "vorder": 43,
    "position": 0,
    "text": "به رشک اندر آهرمن بدسگال"
  },
  {
    "poem_id": 1335,
    "vorder": 44,
    "position": 1,
    "text": "همی رای زد تا ببالید بال"
  },
  {
    "poem_id": 1335,
    "vorder": 45,
    "position": 0,
    "text": "یکی بچه بودش چو گرگ سترگ"
  },
  {
    "poem_id": 1335,
    "vorder": 46,
    "position": 1,
    "text": "دلاور شده با سپاه بزرگ"
  },
  {
    "poem_id": 1335,
    "vorder": 47,
    "position": 0,
    "text": "جهان شد بر آن دیو بچّه سیاه"
  },
  {
    "poem_id": 1335,
    "vorder": 48,
    "position": 1,
    "text": "ز بخت سیامک و زان پایگاه"
  },
  {
    "poem_id": 1335,
    "vorder": 49,
    "position": 0,
    "text": "سپه کرد و نزدیک او راه جست"
  },
  {
    "poem_id": 1335,
    "vorder": 50,
    "position": 1,
    "text": "همی تخت و دیهیم کی شاه جست"
  },
  {
    "poem_id": 1335,
    "vorder": 51,
    "position": 0,
    "text": "همی گفت با هر کسی رای خویش"
  },
  {
    "poem_id": 1335,
    "vorder": 52,
    "position": 1,
    "text": "جهان کرد یک‌سر پر آوای خویش"
  },
  {
    "poem_id": 1335,
    "vorder": 53,
    "position": 0,
    "text": "کیومرث زین خود کی آگاه بود"
  },
  {
    "poem_id": 1335,
    "vorder": 54,
    "position": 1,
    "text": "که تخت مهی را جز او شاه بود"
  },
  {
    "poem_id": 1335,
    "vorder": 55,
    "position": 0,
    "text": "یکایک بیامد خجسته سروش"
  },
  {
    "poem_id": 1335,
    "vorder": 56,
    "position": 1,
    "text": "به سان پری پلنگینه پوش"
  },
  {
    "poem_id": 1335,
    "vorder": 57,
    "position": 0,
    "text": "بگفتش ورا زین سخن در به در"
  },
  {
    "poem_id": 1335,
    "vorder": 58,
    "position": 1,
    "text": "که دشمن چه سازد همی با پدر"
  },
  {
    "poem_id": 1335,
    "vorder": 59,
    "position": 0,
    "text": "سخن چون به گوش سیامک رسید"
  },
  {
    "poem_id": 1335,
    "vorder": 60,
    "position": 1,
    "text": "ز کردار بدخواه دیو پلید"
  },
  {
    "poem_id": 1335,
    "vorder": 61,
    "position": 0,
    "text": "دل شاه بچّه بر آمد به جوش"
  },
  {
    "poem_id": 1335,
    "vorder": 62,
    "position": 1,
    "text": "سپاه انجمن کرد و بگشاد گوش"
  },
  {
    "poem_id": 1335,
    "vorder": 63,
    "position": 0,
    "text": "بپوشید تن را به چرم پلنگ"
  },
  {
    "poem_id": 1335,
    "vorder": 64,
    "position": 1,
    "text": "که جوشن نبود و نه آیین جنگ"
  },
  {
    "poem_id": 1335,
    "vorder": 65,
    "position": 0,
    "text": "پذیره شدش دیو را جنگجوی"
  },
  {
    "poem_id": 1335,
    "vorder": 66,
    "position": 1,
    "text": "سپه را چو روی اندر آمد به روی"
  },
  {
    "poem_id": 1335,
    "vorder": 67,
    "position": 0,
    "text": "سیامک بیامد برهنه تنا"
  },
  {
    "poem_id": 1335,
    "vorder": 68,
    "position": 1,
    "text": "بر آویخت با پور آهرمنا"
  },
  {
    "poem_id": 1335,
    "vorder": 69,
    "position": 0,
    "text": "بزد چنگ وارونه دیو سیاه"
  },
  {
    "poem_id": 1335,
    "vorder": 70,
    "position": 1,
    "text": "دوتا اندر آورد بالای شاه"
  },
  {
    "poem_id": 1335,
    "vorder": 71,
    "position": 0,
    "text": "فکند آن تن شاهزاده به خاک"
  },
  {
    "poem_id": 1335,
    "vorder": 72,
    "position": 1,
    "text": "به چنگال کردش کمرگاه چاک"
  },
  {
    "poem_id": 1335,
    "vorder": 73,
    "position": 0,
    "text": "سیامک به دست خروزان دیو"
  },
  {
    "poem_id": 1335,
    "vorder": 74,
    "position": 1,
    "text": "تبه گشت و ماند انجمن بی‌خدیو"
  },
  {
    "poem_id": 1335,
    "vorder": 75,
    "position": 0,
    "text": "چو آگه شد از مرگ فرزند شاه"
  },
  {
    "poem_id": 1335,
    "vorder": 76,
    "position": 1,
    "text": "ز تیمار گیتی بر او شد سیاه"
  },
  {
    "poem_id": 1335,
    "vorder": 77,
    "position": 0,
    "text": "فرود آمد از تخت ویله کنان"
  },
  {
    "poem_id": 1335,
    "vorder": 78,
    "position": 1,
    "text": "زنان بر سر و موی و رخ را کَنان"
  },
  {
    "poem_id": 1335,
    "vorder": 79,
    "position": 0,
    "text": "دو رخساره پر خون و دل سوگوار"
  },
  {
    "poem_id": 1335,
    "vorder": 80,
    "position": 1,
    "text": "دو دیده پر از نم چو ابر بهار"
  },
  {
    "poem_id": 1335,
    "vorder": 81,
    "position": 0,
    "text": "خروشی بر آمد ز لشکر به زار"
  },
  {
    "poem_id": 1335,
    "vorder": 82,
    "position": 1,
    "text": "کشیدند صف بر در شهریار"
  },
  {
    "poem_id": 1335,
    "vorder": 83,
    "position": 0,
    "text": "همه جامه‌ها کرده پیروزه رنگ"
  },
  {
    "poem_id": 1335,
    "vorder": 84,
    "position": 1,
    "text": "دو چشم ابر خونین و رخ بادرنگ"
  },
  {
    "poem_id": 1335,
    "vorder": 85,
    "position": 0,
    "text": "دد و مرغ و نخچیر گشته گروه"
  },
  {
    "poem_id": 1335,
    "vorder": 86,
    "position": 1,
    "text": "برفتند ویله کنان سوی کوه"
  },
  {
    "poem_id": 1335,
    "vorder": 87,
    "position": 0,
    "text": "برفتند با سوگواری و درد"
  },
  {
    "poem_id": 1335,
    "vorder": 88,
    "position": 1,
    "text": "ز درگاه کی شاه برخاست گرد"
  },
  {
    "poem_id": 1335,
    "vorder": 89,
    "position": 0,
    "text": "نشستند سالی چنین سوگوار"
  },
  {
    "poem_id": 1335,
    "vorder": 90,
    "position": 1,
    "text": "پیام آمد از داور کردگار"
  },
  {
    "poem_id": 1335,
    "vorder": 91,
    "position": 0,
    "text": "درود آوریدش خجسته سروش"
  },
  {
    "poem_id": 1335,
    "vorder": 92,
    "position": 1,
    "text": "کز این بیش مخروش و باز آر هوش"
  },
  {
    "poem_id": 1335,
    "vorder": 93,
    "position": 0,
    "text": "سپه ساز و برکش به فرمان من"
  },
  {
    "poem_id": 1335,
    "vorder": 94,
    "position": 1,
    "text": "بر آور یکی گرد از آن انجمن"
  },
  {
    "poem_id": 1335,
    "vorder": 95,
    "position": 0,
    "text": "از آن بد کنش دیو روی زمین"
  },
  {
    "poem_id": 1335,
    "vorder": 96,
    "position": 1,
    "text": "بپرداز و پردخته کن دل ز کین"
  },
  {
    "poem_id": 1335,
    "vorder": 97,
    "position": 0,
    "text": "کی نامور سر سوی آسمان"
  },
  {
    "poem_id": 1335,
    "vorder": 98,
    "position": 1,
    "text": "بر آورد و بدخواست بر بدگمان"
  },
  {
    "poem_id": 1335,
    "vorder": 99,
    "position": 0,
    "text": "بر آن برترین نام یزدانش را"
  },
  {
    "poem_id": 1335,
    "vorder": 100,
    "position": 1,
    "text": "بخواند و بپالود مژگانش را"
  },
  {
    "poem_id": 1335,
    "vorder": 101,
    "position": 0,
    "text": "و زان پس به کین سیامک شتافت"
  },
  {
    "poem_id": 1335,
    "vorder": 102,
    "position": 1,
    "text": "شب و روز آرام و خفتن نیافت"
  }
]