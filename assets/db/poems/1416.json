[
  {
    "poem_id": 1416,
    "vorder": 1,
    "position": 0,
    "text": "سوی شاه ترکان رسید آگهی"
  },
  {
    "poem_id": 1416,
    "vorder": 2,
    "position": 1,
    "text": "کزان نامداران جهان شد تهی"
  },
  {
    "poem_id": 1416,
    "vorder": 3,
    "position": 0,
    "text": "دلش گشت پر آتش از درد و غم"
  },
  {
    "poem_id": 1416,
    "vorder": 4,
    "position": 1,
    "text": "دو رخ را به خون جگر داد نم"
  },
  {
    "poem_id": 1416,
    "vorder": 5,
    "position": 0,
    "text": "برآشفت و گفتا که نوذر کجاست"
  },
  {
    "poem_id": 1416,
    "vorder": 6,
    "position": 1,
    "text": "کزو ویسه خواهد همی کینه خواست"
  },
  {
    "poem_id": 1416,
    "vorder": 7,
    "position": 0,
    "text": "چه چاره است جز خون او ریختن"
  },
  {
    "poem_id": 1416,
    "vorder": 8,
    "position": 1,
    "text": "یکی کینهٔ نو برانگیختن"
  },
  {
    "poem_id": 1416,
    "vorder": 9,
    "position": 0,
    "text": "به دژخیم فرمود کو را کشان"
  },
  {
    "poem_id": 1416,
    "vorder": 10,
    "position": 1,
    "text": "ببر تا بیاموزد او سرفشان"
  },
  {
    "poem_id": 1416,
    "vorder": 11,
    "position": 0,
    "text": "سپهدار نوذر چو آگاه شد"
  },
  {
    "poem_id": 1416,
    "vorder": 12,
    "position": 1,
    "text": "بدانست کش روز کوتاه شد"
  },
  {
    "poem_id": 1416,
    "vorder": 13,
    "position": 0,
    "text": "سپاهی پر از غلغل و گفت و گوی"
  },
  {
    "poem_id": 1416,
    "vorder": 14,
    "position": 1,
    "text": "سوی شاه نوذر نهادند روی"
  },
  {
    "poem_id": 1416,
    "vorder": 15,
    "position": 0,
    "text": "ببستند بازوش با بند تنگ"
  },
  {
    "poem_id": 1416,
    "vorder": 16,
    "position": 1,
    "text": "کشیدندش از جای پیش نهنگ"
  },
  {
    "poem_id": 1416,
    "vorder": 17,
    "position": 0,
    "text": "به دشت آوریدندش از خیمه خوار"
  },
  {
    "poem_id": 1416,
    "vorder": 18,
    "position": 1,
    "text": "برهنه سر و پای و برگشته کار"
  },
  {
    "poem_id": 1416,
    "vorder": 19,
    "position": 0,
    "text": "چو از دور دیدش زبان برگشاد"
  },
  {
    "poem_id": 1416,
    "vorder": 20,
    "position": 1,
    "text": "ز کین نیاگان همی کرد یاد"
  },
  {
    "poem_id": 1416,
    "vorder": 21,
    "position": 0,
    "text": "ز تور و ز سلم اندر آمد نخست"
  },
  {
    "poem_id": 1416,
    "vorder": 22,
    "position": 1,
    "text": "دل و دیده از شرم شاهان بشست"
  },
  {
    "poem_id": 1416,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت هر بد که آید سزاست"
  },
  {
    "poem_id": 1416,
    "vorder": 24,
    "position": 1,
    "text": "بگفت و برآشفت و شمشیر خواست"
  },
  {
    "poem_id": 1416,
    "vorder": 25,
    "position": 0,
    "text": "بزد گردن خسرو تاجدار"
  },
  {
    "poem_id": 1416,
    "vorder": 26,
    "position": 1,
    "text": "تنش را بخاک اندر افگند خوار"
  },
  {
    "poem_id": 1416,
    "vorder": 27,
    "position": 0,
    "text": "شد آن یادگار منوچهر شاه"
  },
  {
    "poem_id": 1416,
    "vorder": 28,
    "position": 1,
    "text": "تهی ماند ایران ز تخت و کلاه"
  },
  {
    "poem_id": 1416,
    "vorder": 29,
    "position": 0,
    "text": "ایا دانشی مرد بسیار هوش"
  },
  {
    "poem_id": 1416,
    "vorder": 30,
    "position": 1,
    "text": "همه چادر آزمندی مپوش"
  },
  {
    "poem_id": 1416,
    "vorder": 31,
    "position": 0,
    "text": "که تخت و کله چون تو بسیار دید"
  },
  {
    "poem_id": 1416,
    "vorder": 32,
    "position": 1,
    "text": "چنین داستان چند خواهی شنید"
  },
  {
    "poem_id": 1416,
    "vorder": 33,
    "position": 0,
    "text": "رسیدی به جایی که بشتافتی"
  },
  {
    "poem_id": 1416,
    "vorder": 34,
    "position": 1,
    "text": "سرآمد کزو آرزو یافتی"
  },
  {
    "poem_id": 1416,
    "vorder": 35,
    "position": 0,
    "text": "چه جویی از این تیره خاک نژند"
  },
  {
    "poem_id": 1416,
    "vorder": 36,
    "position": 1,
    "text": "که هم بازگرداندت مستمند"
  },
  {
    "poem_id": 1416,
    "vorder": 37,
    "position": 0,
    "text": "که گر چرخ گردان کشد زین تو"
  },
  {
    "poem_id": 1416,
    "vorder": 38,
    "position": 1,
    "text": "سرانجام خاکست بالین تو"
  },
  {
    "poem_id": 1416,
    "vorder": 39,
    "position": 0,
    "text": "پس آن بستگان را کشیدند خوار"
  },
  {
    "poem_id": 1416,
    "vorder": 40,
    "position": 1,
    "text": "به جان خواستند آنگهی زینهار"
  },
  {
    "poem_id": 1416,
    "vorder": 41,
    "position": 0,
    "text": "چو اغریرث پرهنر آن بدید"
  },
  {
    "poem_id": 1416,
    "vorder": 42,
    "position": 1,
    "text": "دل او ببر در چو آتش دمید"
  },
  {
    "poem_id": 1416,
    "vorder": 43,
    "position": 0,
    "text": "همی گفت چندین سر بی‌گناه"
  },
  {
    "poem_id": 1416,
    "vorder": 44,
    "position": 1,
    "text": "ز تن دور ماند به فرمان شاه"
  },
  {
    "poem_id": 1416,
    "vorder": 45,
    "position": 0,
    "text": "بیامد خروشان به خواهشگری"
  },
  {
    "poem_id": 1416,
    "vorder": 46,
    "position": 1,
    "text": "بیاراست با نامور داوری"
  },
  {
    "poem_id": 1416,
    "vorder": 47,
    "position": 0,
    "text": "که چندین سرافراز گرد و سوار"
  },
  {
    "poem_id": 1416,
    "vorder": 48,
    "position": 1,
    "text": "نه با ترگ و جوشن نه در کارزار"
  },
  {
    "poem_id": 1416,
    "vorder": 49,
    "position": 0,
    "text": "گرفتار کشتن نه والا بود"
  },
  {
    "poem_id": 1416,
    "vorder": 50,
    "position": 1,
    "text": "نشیبست جایی که بالا بود"
  },
  {
    "poem_id": 1416,
    "vorder": 51,
    "position": 0,
    "text": "سزد گر نیاید به جانشان گزند"
  },
  {
    "poem_id": 1416,
    "vorder": 52,
    "position": 1,
    "text": "سپاری همیدون به من شان ببند"
  },
  {
    "poem_id": 1416,
    "vorder": 53,
    "position": 0,
    "text": "بریشان یکی غار زندان کنم"
  },
  {
    "poem_id": 1416,
    "vorder": 54,
    "position": 1,
    "text": "نگهدارشان هوشمندان کنم"
  },
  {
    "poem_id": 1416,
    "vorder": 55,
    "position": 0,
    "text": "به ساری به زاری برآرند هوش"
  },
  {
    "poem_id": 1416,
    "vorder": 56,
    "position": 1,
    "text": "تو از خون به کش دست و چندین مکوش"
  },
  {
    "poem_id": 1416,
    "vorder": 57,
    "position": 0,
    "text": "ببخشید جان‌شان به گفتار اوی"
  },
  {
    "poem_id": 1416,
    "vorder": 58,
    "position": 1,
    "text": "چو بشنید با درد پیکار اوی"
  },
  {
    "poem_id": 1416,
    "vorder": 59,
    "position": 0,
    "text": "بفرمودشان تا به ساری برند"
  },
  {
    "poem_id": 1416,
    "vorder": 60,
    "position": 1,
    "text": "به غل و به مسمار و خواری برند"
  },
  {
    "poem_id": 1416,
    "vorder": 61,
    "position": 0,
    "text": "چو این کرده شد ساز رفتن گرفت"
  },
  {
    "poem_id": 1416,
    "vorder": 62,
    "position": 1,
    "text": "زمین زیر اسپان نهفتن گرفت"
  },
  {
    "poem_id": 1416,
    "vorder": 63,
    "position": 0,
    "text": "ز پیش دهستان سوی ری کشید"
  },
  {
    "poem_id": 1416,
    "vorder": 64,
    "position": 1,
    "text": "از اسپان به رنج و به تک خوی کشید"
  },
  {
    "poem_id": 1416,
    "vorder": 65,
    "position": 0,
    "text": "کلاه کیانی به سر بر نهاد"
  },
  {
    "poem_id": 1416,
    "vorder": 66,
    "position": 1,
    "text": "به دینار دادن در اندرگشاد"
  }
]