[
  {
    "poem_id": 1900,
    "vorder": 1,
    "position": 0,
    "text": "کهن گشته این نامهٔ باستان"
  },
  {
    "poem_id": 1900,
    "vorder": 2,
    "position": 1,
    "text": "ز گفتار و کردار آن راستان"
  },
  {
    "poem_id": 1900,
    "vorder": 3,
    "position": 0,
    "text": "همی نوکنم گفته‌ها زین سخن"
  },
  {
    "poem_id": 1900,
    "vorder": 4,
    "position": 1,
    "text": "ز گفتار بیدار مرد کهن"
  },
  {
    "poem_id": 1900,
    "vorder": 5,
    "position": 0,
    "text": "بود بیست شش بار بیور هزار"
  },
  {
    "poem_id": 1900,
    "vorder": 6,
    "position": 1,
    "text": "سخنهای شایسته و غمگسار"
  },
  {
    "poem_id": 1900,
    "vorder": 7,
    "position": 0,
    "text": "نبیند کسی نامهٔ پارسی"
  },
  {
    "poem_id": 1900,
    "vorder": 8,
    "position": 1,
    "text": "نوشته به ابیات صدبار سی"
  },
  {
    "poem_id": 1900,
    "vorder": 9,
    "position": 0,
    "text": "اگر بازجویی درو بیت بد"
  },
  {
    "poem_id": 1900,
    "vorder": 10,
    "position": 1,
    "text": "همانا که کم باشد از پانصد"
  },
  {
    "poem_id": 1900,
    "vorder": 11,
    "position": 0,
    "text": "چنین شهریاری و بخشنده‌ای"
  },
  {
    "poem_id": 1900,
    "vorder": 12,
    "position": 1,
    "text": "به گیتی ز شاهان درخشنده‌ای"
  },
  {
    "poem_id": 1900,
    "vorder": 13,
    "position": 0,
    "text": "نکرد اندرین داستانها نگاه"
  },
  {
    "poem_id": 1900,
    "vorder": 14,
    "position": 1,
    "text": "ز بدگوی و بخت بد آمد گناه"
  },
  {
    "poem_id": 1900,
    "vorder": 15,
    "position": 0,
    "text": "حسد کرد بدگوی در کار من"
  },
  {
    "poem_id": 1900,
    "vorder": 16,
    "position": 1,
    "text": "تبه شد بر شاه بازار من"
  },
  {
    "poem_id": 1900,
    "vorder": 17,
    "position": 0,
    "text": "چو سالار شاه این سخنهای نغز"
  },
  {
    "poem_id": 1900,
    "vorder": 18,
    "position": 1,
    "text": "بخواند ببیند به پاکیزه نغز"
  },
  {
    "poem_id": 1900,
    "vorder": 19,
    "position": 0,
    "text": "ز گنجش من ایدر شوم شادمان"
  },
  {
    "poem_id": 1900,
    "vorder": 20,
    "position": 1,
    "text": "کزو دور بادا بد بدگمان"
  },
  {
    "poem_id": 1900,
    "vorder": 21,
    "position": 0,
    "text": "وزان پس کند یاد بر شهریار"
  },
  {
    "poem_id": 1900,
    "vorder": 22,
    "position": 1,
    "text": "مگر تخم رنج من آید ببار"
  },
  {
    "poem_id": 1900,
    "vorder": 23,
    "position": 0,
    "text": "که جاوید باد افسر و تخت اوی"
  },
  {
    "poem_id": 1900,
    "vorder": 24,
    "position": 1,
    "text": "ز خورشید تابنده‌تر بخت اوی"
  },
  {
    "poem_id": 1900,
    "vorder": 25,
    "position": 0,
    "text": "چنین گفت داننده دهقان پیر"
  },
  {
    "poem_id": 1900,
    "vorder": 26,
    "position": 1,
    "text": "که دانش بود مرد را دستگیر"
  },
  {
    "poem_id": 1900,
    "vorder": 27,
    "position": 0,
    "text": "غم و شادمانی بباید کشید"
  },
  {
    "poem_id": 1900,
    "vorder": 28,
    "position": 1,
    "text": "ز هر شور و تلخی بباید چشید"
  },
  {
    "poem_id": 1900,
    "vorder": 29,
    "position": 0,
    "text": "جوانان داننده و باگهر"
  },
  {
    "poem_id": 1900,
    "vorder": 30,
    "position": 1,
    "text": "نگیرند بی آزمایش هنر"
  },
  {
    "poem_id": 1900,
    "vorder": 31,
    "position": 0,
    "text": "چو پرویز ناباک بود و جوان"
  },
  {
    "poem_id": 1900,
    "vorder": 32,
    "position": 1,
    "text": "پدر زنده و پور چون پهلوان"
  },
  {
    "poem_id": 1900,
    "vorder": 33,
    "position": 0,
    "text": "ورا در زمین دوست شیرین بدی"
  },
  {
    "poem_id": 1900,
    "vorder": 34,
    "position": 1,
    "text": "برو بر چو روشن جهان بین بدی"
  },
  {
    "poem_id": 1900,
    "vorder": 35,
    "position": 0,
    "text": "پسندش نبودی جزو در جهان"
  },
  {
    "poem_id": 1900,
    "vorder": 36,
    "position": 1,
    "text": "ز خوبان وز دختران مهان"
  },
  {
    "poem_id": 1900,
    "vorder": 37,
    "position": 0,
    "text": "ز شیرین جدا بود یک روزگار"
  },
  {
    "poem_id": 1900,
    "vorder": 38,
    "position": 1,
    "text": "بدان گه که بد در جهان شهریار"
  },
  {
    "poem_id": 1900,
    "vorder": 39,
    "position": 0,
    "text": "بگرد جهان در بی‌آرام بود"
  },
  {
    "poem_id": 1900,
    "vorder": 40,
    "position": 1,
    "text": "که کارش همه رزم بهرام بود"
  },
  {
    "poem_id": 1900,
    "vorder": 41,
    "position": 0,
    "text": "چو خسرو به پردخت چندی به مهر"
  },
  {
    "poem_id": 1900,
    "vorder": 42,
    "position": 1,
    "text": "شب و روز گریان بدی خوب‌چهر"
  }
]