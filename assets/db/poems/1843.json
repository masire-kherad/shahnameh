[
  {
    "poem_id": 1843,
    "vorder": 1,
    "position": 0,
    "text": "وزین روی بنشست بهرام گرد"
  },
  {
    "poem_id": 1843,
    "vorder": 2,
    "position": 1,
    "text": "بزرگان برفتند با او وخرد"
  },
  {
    "poem_id": 1843,
    "vorder": 3,
    "position": 0,
    "text": "سپهبد بپرسید زان سرکشان"
  },
  {
    "poem_id": 1843,
    "vorder": 4,
    "position": 1,
    "text": "که آمد زخویشان شما را نشان"
  },
  {
    "poem_id": 1843,
    "vorder": 5,
    "position": 0,
    "text": "فرستید هرکس که دارید خویش"
  },
  {
    "poem_id": 1843,
    "vorder": 6,
    "position": 1,
    "text": "که باشند یکدل به گفتار وکیش"
  },
  {
    "poem_id": 1843,
    "vorder": 7,
    "position": 0,
    "text": "گریشان بیایند وفرمان کنند"
  },
  {
    "poem_id": 1843,
    "vorder": 8,
    "position": 1,
    "text": "به پیمان روان را گروگان کنند"
  },
  {
    "poem_id": 1843,
    "vorder": 9,
    "position": 0,
    "text": "سپه ماند از بردع واردبیل"
  },
  {
    "poem_id": 1843,
    "vorder": 10,
    "position": 1,
    "text": "از ارمنیه نیز بی‌مرد وخیل"
  },
  {
    "poem_id": 1843,
    "vorder": 11,
    "position": 0,
    "text": "ازیشان برزم اندرون نیست باک"
  },
  {
    "poem_id": 1843,
    "vorder": 12,
    "position": 1,
    "text": "چه مردان بردع چه یک مشت خاک"
  },
  {
    "poem_id": 1843,
    "vorder": 13,
    "position": 0,
    "text": "شنیدند گردنکشان این سخن"
  },
  {
    "poem_id": 1843,
    "vorder": 14,
    "position": 1,
    "text": "که بهرام جنگ آور افگند بن"
  },
  {
    "poem_id": 1843,
    "vorder": 15,
    "position": 0,
    "text": "زلشکر گزیدند مردی دبیر"
  },
  {
    "poem_id": 1843,
    "vorder": 16,
    "position": 1,
    "text": "سخن گوی و داننده ویادگیر"
  },
  {
    "poem_id": 1843,
    "vorder": 17,
    "position": 0,
    "text": "بیامد گوی با دلی پر ز راز"
  },
  {
    "poem_id": 1843,
    "vorder": 18,
    "position": 1,
    "text": "همی‌بود پویان شب دیریاز"
  },
  {
    "poem_id": 1843,
    "vorder": 19,
    "position": 0,
    "text": "بگفت آنچ بشنید زان مهتران"
  },
  {
    "poem_id": 1843,
    "vorder": 20,
    "position": 1,
    "text": "ازان نامداران وکنداوران"
  },
  {
    "poem_id": 1843,
    "vorder": 21,
    "position": 0,
    "text": "از ایرانیان پاسخ ایدون شنید"
  },
  {
    "poem_id": 1843,
    "vorder": 22,
    "position": 1,
    "text": "که تا رزم لشکر نیاید پدید"
  },
  {
    "poem_id": 1843,
    "vorder": 23,
    "position": 0,
    "text": "یکی مازخسرو نگردیم باز"
  },
  {
    "poem_id": 1843,
    "vorder": 24,
    "position": 1,
    "text": "بترسیم کین کارگردد دراز"
  },
  {
    "poem_id": 1843,
    "vorder": 25,
    "position": 0,
    "text": "مباشید ایمن بران رزمگاه"
  },
  {
    "poem_id": 1843,
    "vorder": 26,
    "position": 1,
    "text": "که خسرو شبیخون کند با سپاه"
  },
  {
    "poem_id": 1843,
    "vorder": 27,
    "position": 0,
    "text": "چو پاسخ شنید آن فرستاده مرد"
  },
  {
    "poem_id": 1843,
    "vorder": 28,
    "position": 1,
    "text": "سوی لشکر پهلوان شد چو گرد"
  },
  {
    "poem_id": 1843,
    "vorder": 29,
    "position": 0,
    "text": "همه لشکرآتش برافروختند"
  },
  {
    "poem_id": 1843,
    "vorder": 30,
    "position": 1,
    "text": "بهر جای شمعی همی‌سوختند"
  }
]