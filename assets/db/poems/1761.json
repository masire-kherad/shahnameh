[
  {
    "poem_id": 1761,
    "vorder": 1,
    "position": 0,
    "text": "بدو گفت موبد که ای شهریار"
  },
  {
    "poem_id": 1761,
    "vorder": 2,
    "position": 1,
    "text": "بگشتی تو از راه پروردگار"
  },
  {
    "poem_id": 1761,
    "vorder": 3,
    "position": 0,
    "text": "تو گفتی که بگریزم از چنگ مرگ"
  },
  {
    "poem_id": 1761,
    "vorder": 4,
    "position": 1,
    "text": "چو باد خزان آمد از شاخ برگ"
  },
  {
    "poem_id": 1761,
    "vorder": 5,
    "position": 0,
    "text": "ترا چاره اینست کز راه شهد"
  },
  {
    "poem_id": 1761,
    "vorder": 6,
    "position": 1,
    "text": "سوی چشمهٔ سو گرایی به مهد"
  },
  {
    "poem_id": 1761,
    "vorder": 7,
    "position": 0,
    "text": "نیایش کنی پیش یزدان پاک"
  },
  {
    "poem_id": 1761,
    "vorder": 8,
    "position": 1,
    "text": "بگردی به زاری بران گرم خاک"
  },
  {
    "poem_id": 1761,
    "vorder": 9,
    "position": 0,
    "text": "بگویی که من بندهٔ ناتوان"
  },
  {
    "poem_id": 1761,
    "vorder": 10,
    "position": 1,
    "text": "زده دام سوگند پیش روان"
  },
  {
    "poem_id": 1761,
    "vorder": 11,
    "position": 0,
    "text": "کنون آمدم تا زمانم کجاست"
  },
  {
    "poem_id": 1761,
    "vorder": 12,
    "position": 1,
    "text": "به پیش تو این داور داد و راست"
  },
  {
    "poem_id": 1761,
    "vorder": 13,
    "position": 0,
    "text": "چو بشنید شاه آن پسند آمدش"
  },
  {
    "poem_id": 1761,
    "vorder": 14,
    "position": 1,
    "text": "همان درد را سودمند آمدش"
  },
  {
    "poem_id": 1761,
    "vorder": 15,
    "position": 0,
    "text": "بیاورد سیصد عماری و مهد"
  },
  {
    "poem_id": 1761,
    "vorder": 16,
    "position": 1,
    "text": "گذر کرد بر سوی دریای شهر"
  },
  {
    "poem_id": 1761,
    "vorder": 17,
    "position": 0,
    "text": "شب و روز بودی به مهد اندرون"
  },
  {
    "poem_id": 1761,
    "vorder": 18,
    "position": 1,
    "text": "ز بینیش گه‌گه همی رفت خون"
  },
  {
    "poem_id": 1761,
    "vorder": 19,
    "position": 0,
    "text": "چو نزدیکی چشمهٔ سو رسید"
  },
  {
    "poem_id": 1761,
    "vorder": 20,
    "position": 1,
    "text": "برون آمد از مهد و دریا بدید"
  },
  {
    "poem_id": 1761,
    "vorder": 21,
    "position": 0,
    "text": "ازان آب لختی به سر بر نهاد"
  },
  {
    "poem_id": 1761,
    "vorder": 22,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1761,
    "vorder": 23,
    "position": 0,
    "text": "زمانی نیامد ز بینیش خون"
  },
  {
    "poem_id": 1761,
    "vorder": 24,
    "position": 1,
    "text": "بخورد و بیاسود با رهنمون"
  },
  {
    "poem_id": 1761,
    "vorder": 25,
    "position": 0,
    "text": "منی کرد و گفت اینت آیین و رای"
  },
  {
    "poem_id": 1761,
    "vorder": 26,
    "position": 1,
    "text": "نشستن چه بایست چندین به جای"
  },
  {
    "poem_id": 1761,
    "vorder": 27,
    "position": 0,
    "text": "چو گردنکشی کرد شاه رمه"
  },
  {
    "poem_id": 1761,
    "vorder": 28,
    "position": 1,
    "text": "که از خویشتن دید نیکی همه"
  },
  {
    "poem_id": 1761,
    "vorder": 29,
    "position": 0,
    "text": "ز دریا برآمد یکی اسپ خنگ"
  },
  {
    "poem_id": 1761,
    "vorder": 30,
    "position": 1,
    "text": "سرین گرد چون گور و کوتاه لنگ"
  },
  {
    "poem_id": 1761,
    "vorder": 31,
    "position": 0,
    "text": "دوان و چو شیر ژیان پر ز خشم"
  },
  {
    "poem_id": 1761,
    "vorder": 32,
    "position": 1,
    "text": "بلند و سیه‌خایه و زاغ چشم"
  },
  {
    "poem_id": 1761,
    "vorder": 33,
    "position": 0,
    "text": "کشان دم در پای با یال و بش"
  },
  {
    "poem_id": 1761,
    "vorder": 34,
    "position": 1,
    "text": "سیه سم و کفک‌افگن و شیرکش"
  },
  {
    "poem_id": 1761,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت با مهتران یزدگرد"
  },
  {
    "poem_id": 1761,
    "vorder": 36,
    "position": 1,
    "text": "که این را سپاه اندر آرید گرد"
  },
  {
    "poem_id": 1761,
    "vorder": 37,
    "position": 0,
    "text": "بشد گرد چوپان و ده کره‌تاز"
  },
  {
    "poem_id": 1761,
    "vorder": 38,
    "position": 1,
    "text": "یکی زین و پیچان کمند دراز"
  },
  {
    "poem_id": 1761,
    "vorder": 39,
    "position": 0,
    "text": "چه دانست راز جهاندار شاه"
  },
  {
    "poem_id": 1761,
    "vorder": 40,
    "position": 1,
    "text": "که آوردی این اژدها را به راه"
  },
  {
    "poem_id": 1761,
    "vorder": 41,
    "position": 0,
    "text": "فروماند چوپان و لشکر همه"
  },
  {
    "poem_id": 1761,
    "vorder": 42,
    "position": 1,
    "text": "برآشفت ازان شهریار رمه"
  },
  {
    "poem_id": 1761,
    "vorder": 43,
    "position": 0,
    "text": "هم‌انگاه برداشت زین و لگام"
  },
  {
    "poem_id": 1761,
    "vorder": 44,
    "position": 1,
    "text": "به نزدیک آن اسپ شد شادکام"
  },
  {
    "poem_id": 1761,
    "vorder": 45,
    "position": 0,
    "text": "چنان رام شد خنگ بر جای خویش"
  },
  {
    "poem_id": 1761,
    "vorder": 46,
    "position": 1,
    "text": "که ننهاد دست از پس و پای پیش"
  },
  {
    "poem_id": 1761,
    "vorder": 47,
    "position": 0,
    "text": "ز شاه جهاندار بستد لگام"
  },
  {
    "poem_id": 1761,
    "vorder": 48,
    "position": 1,
    "text": "به زین بر نهادن همان گشت رام"
  },
  {
    "poem_id": 1761,
    "vorder": 49,
    "position": 0,
    "text": "چو زین بر نهادش برآهخت تنگ"
  },
  {
    "poem_id": 1761,
    "vorder": 50,
    "position": 1,
    "text": "نجنبید بر جای تازان نهنگ"
  },
  {
    "poem_id": 1761,
    "vorder": 51,
    "position": 0,
    "text": "پس پای او شد که بنددش دم"
  },
  {
    "poem_id": 1761,
    "vorder": 52,
    "position": 1,
    "text": "خروشان شد آن بارهٔ سنگ سم"
  },
  {
    "poem_id": 1761,
    "vorder": 53,
    "position": 0,
    "text": "بغرید و یک جفته زد بر برش"
  },
  {
    "poem_id": 1761,
    "vorder": 54,
    "position": 1,
    "text": "به خاک اندر آمد سر و افسرش"
  },
  {
    "poem_id": 1761,
    "vorder": 55,
    "position": 0,
    "text": "ز خاک آمد و خاک شد یزدگرد"
  },
  {
    "poem_id": 1761,
    "vorder": 56,
    "position": 1,
    "text": "چه جویی تو زین بر شده هفت‌گرد"
  },
  {
    "poem_id": 1761,
    "vorder": 57,
    "position": 0,
    "text": "چو از گردش او نیابی رها"
  },
  {
    "poem_id": 1761,
    "vorder": 58,
    "position": 1,
    "text": "پرستیدن او نیارد بها"
  },
  {
    "poem_id": 1761,
    "vorder": 59,
    "position": 0,
    "text": "به یزدان گرای و بدو کن پناه"
  },
  {
    "poem_id": 1761,
    "vorder": 60,
    "position": 1,
    "text": "خداوند گردنده خورشید ماه"
  },
  {
    "poem_id": 1761,
    "vorder": 61,
    "position": 0,
    "text": "چو او کشته شد اسپ آبی چوگرد"
  },
  {
    "poem_id": 1761,
    "vorder": 62,
    "position": 1,
    "text": "بیامد بران چشمهٔ لاژورد"
  },
  {
    "poem_id": 1761,
    "vorder": 63,
    "position": 0,
    "text": "به آب اندرون شد تنش ناپدید"
  },
  {
    "poem_id": 1761,
    "vorder": 64,
    "position": 1,
    "text": "کس اندر جهان این شگفتی ندید"
  },
  {
    "poem_id": 1761,
    "vorder": 65,
    "position": 0,
    "text": "ز لشکر خروشی برآمد چو کوس"
  },
  {
    "poem_id": 1761,
    "vorder": 66,
    "position": 1,
    "text": "که شاها زمان آوریدت به طوس"
  },
  {
    "poem_id": 1761,
    "vorder": 67,
    "position": 0,
    "text": "همه جامه‌ها را بکردند چاک"
  },
  {
    "poem_id": 1761,
    "vorder": 68,
    "position": 1,
    "text": "همی ریختند از بر یال و خاک"
  },
  {
    "poem_id": 1761,
    "vorder": 69,
    "position": 0,
    "text": "ازان پس بکافید موبد برش"
  },
  {
    "poem_id": 1761,
    "vorder": 70,
    "position": 1,
    "text": "میان تهیگاه و مغز سرش"
  },
  {
    "poem_id": 1761,
    "vorder": 71,
    "position": 0,
    "text": "بیاگند یکسر به کافور و مشک"
  },
  {
    "poem_id": 1761,
    "vorder": 72,
    "position": 1,
    "text": "به دیبا تنش را بکردند خشک"
  },
  {
    "poem_id": 1761,
    "vorder": 73,
    "position": 0,
    "text": "به تابوت زرین و در مهد ساج"
  },
  {
    "poem_id": 1761,
    "vorder": 74,
    "position": 1,
    "text": "سوی پارس شد آن خداوند تاج"
  },
  {
    "poem_id": 1761,
    "vorder": 75,
    "position": 0,
    "text": "چنین است رسم سرای بلند"
  },
  {
    "poem_id": 1761,
    "vorder": 76,
    "position": 1,
    "text": "چو آرام یابی بترس از گزند"
  },
  {
    "poem_id": 1761,
    "vorder": 77,
    "position": 0,
    "text": "تو رامی و با تو جهان رام نیست"
  },
  {
    "poem_id": 1761,
    "vorder": 78,
    "position": 1,
    "text": "چو نام خورده آید به از جام نیست"
  },
  {
    "poem_id": 1761,
    "vorder": 79,
    "position": 0,
    "text": "پرستیدن دین بهست از گناه"
  },
  {
    "poem_id": 1761,
    "vorder": 80,
    "position": 1,
    "text": "چو باشد کسی را بدین پایگاه"
  }
]