[
  {
    "poem_id": 1363,
    "vorder": 1,
    "position": 0,
    "text": "برآمد برین روزگار دراز"
  },
  {
    "poem_id": 1363,
    "vorder": 2,
    "position": 1,
    "text": "زمانه به دل در همی داشت راز"
  },
  {
    "poem_id": 1363,
    "vorder": 3,
    "position": 0,
    "text": "فریدون فرزانه شد سالخورد"
  },
  {
    "poem_id": 1363,
    "vorder": 4,
    "position": 1,
    "text": "به باغ بهار اندر آورد گرد"
  },
  {
    "poem_id": 1363,
    "vorder": 5,
    "position": 0,
    "text": "برین گونه گردد سراسر سخن"
  },
  {
    "poem_id": 1363,
    "vorder": 6,
    "position": 1,
    "text": "شود سست نیرو چو گردد کهن"
  },
  {
    "poem_id": 1363,
    "vorder": 7,
    "position": 0,
    "text": "چو آمد به کاراندرون تیرگی"
  },
  {
    "poem_id": 1363,
    "vorder": 8,
    "position": 1,
    "text": "گرفتند پرمایگان خیرگی"
  },
  {
    "poem_id": 1363,
    "vorder": 9,
    "position": 0,
    "text": "بجنبید مر سلم را دل ز جای"
  },
  {
    "poem_id": 1363,
    "vorder": 10,
    "position": 1,
    "text": "دگرگونه‌تر شد به آیین و رای"
  },
  {
    "poem_id": 1363,
    "vorder": 11,
    "position": 0,
    "text": "دلش گشت غرقه به آزاندرون"
  },
  {
    "poem_id": 1363,
    "vorder": 12,
    "position": 1,
    "text": "به اندیشه بنشست با رهنمون"
  },
  {
    "poem_id": 1363,
    "vorder": 13,
    "position": 0,
    "text": "نبودش پسندیده بخش پدر"
  },
  {
    "poem_id": 1363,
    "vorder": 14,
    "position": 1,
    "text": "که داد او به کهتر پسر تخت زر"
  },
  {
    "poem_id": 1363,
    "vorder": 15,
    "position": 0,
    "text": "به دل پر ز کین شد به رخ پر ز چین"
  },
  {
    "poem_id": 1363,
    "vorder": 16,
    "position": 1,
    "text": "فرسته فرستاد زی شاه چین"
  },
  {
    "poem_id": 1363,
    "vorder": 17,
    "position": 0,
    "text": "فرستاد نزد برادر پیام"
  },
  {
    "poem_id": 1363,
    "vorder": 18,
    "position": 1,
    "text": "که جاوید زی خرم و شادکام"
  },
  {
    "poem_id": 1363,
    "vorder": 19,
    "position": 0,
    "text": "بدان ای شهنشاه ترکان و چین"
  },
  {
    "poem_id": 1363,
    "vorder": 20,
    "position": 1,
    "text": "گسسته دل روشن از به گزین"
  },
  {
    "poem_id": 1363,
    "vorder": 21,
    "position": 0,
    "text": "ز نیکی زیان کرده گویی پسند"
  },
  {
    "poem_id": 1363,
    "vorder": 22,
    "position": 1,
    "text": "منش پست و بالا چو سرو بلند"
  },
  {
    "poem_id": 1363,
    "vorder": 23,
    "position": 0,
    "text": "کنون بشنو ازمن یکی داستان"
  },
  {
    "poem_id": 1363,
    "vorder": 24,
    "position": 1,
    "text": "کزین گونه نشنیدی از باستان"
  },
  {
    "poem_id": 1363,
    "vorder": 25,
    "position": 0,
    "text": "سه فرزند بودیم زیبای تخت"
  },
  {
    "poem_id": 1363,
    "vorder": 26,
    "position": 1,
    "text": "یکی کهتر از ما برآمد به بخت"
  },
  {
    "poem_id": 1363,
    "vorder": 27,
    "position": 0,
    "text": "اگر مهترم من به سال و خرد"
  },
  {
    "poem_id": 1363,
    "vorder": 28,
    "position": 1,
    "text": "زمانه به مهر من اندر خورد"
  },
  {
    "poem_id": 1363,
    "vorder": 29,
    "position": 0,
    "text": "گذشته ز من تاج و تخت و کلاه"
  },
  {
    "poem_id": 1363,
    "vorder": 30,
    "position": 1,
    "text": "نزیبد مگر بر تو ای پادشاه"
  },
  {
    "poem_id": 1363,
    "vorder": 31,
    "position": 0,
    "text": "سزد گر بمانیم هر دو دژم"
  },
  {
    "poem_id": 1363,
    "vorder": 32,
    "position": 1,
    "text": "کزین سان پدر کرد بر ما ستم"
  },
  {
    "poem_id": 1363,
    "vorder": 33,
    "position": 0,
    "text": "چو ایران و دشت یلان و یمن"
  },
  {
    "poem_id": 1363,
    "vorder": 34,
    "position": 1,
    "text": "به ایرج دهد روم و خاور به من"
  },
  {
    "poem_id": 1363,
    "vorder": 35,
    "position": 0,
    "text": "سپارد ترا مرز ترکان و چین"
  },
  {
    "poem_id": 1363,
    "vorder": 36,
    "position": 1,
    "text": "که از تو سپهدار ایران زمین"
  },
  {
    "poem_id": 1363,
    "vorder": 37,
    "position": 0,
    "text": "بدین بخشش اندر مرا پای نیست"
  },
  {
    "poem_id": 1363,
    "vorder": 38,
    "position": 1,
    "text": "به مغز پدر اندرون رای نیست"
  },
  {
    "poem_id": 1363,
    "vorder": 39,
    "position": 0,
    "text": "هیون فرستاده بگزارد پای"
  },
  {
    "poem_id": 1363,
    "vorder": 40,
    "position": 1,
    "text": "بیامد به نزدیک توران خدای"
  },
  {
    "poem_id": 1363,
    "vorder": 41,
    "position": 0,
    "text": "به خوبی شنیده همه یاد کرد"
  },
  {
    "poem_id": 1363,
    "vorder": 42,
    "position": 1,
    "text": "سر تور بی‌مغز پرباد کرد"
  },
  {
    "poem_id": 1363,
    "vorder": 43,
    "position": 0,
    "text": "چو این راز بشنید تور دلیر"
  },
  {
    "poem_id": 1363,
    "vorder": 44,
    "position": 1,
    "text": "برآشفت ناگاه برسان شیر"
  },
  {
    "poem_id": 1363,
    "vorder": 45,
    "position": 0,
    "text": "چنین داد پاسخ که با شهریار"
  },
  {
    "poem_id": 1363,
    "vorder": 46,
    "position": 1,
    "text": "بگو این سخن هم چنین یاد دار"
  },
  {
    "poem_id": 1363,
    "vorder": 47,
    "position": 0,
    "text": "که ما را به گاه جوانی پدر"
  },
  {
    "poem_id": 1363,
    "vorder": 48,
    "position": 1,
    "text": "بدین گونه بفریفت ای دادگر"
  },
  {
    "poem_id": 1363,
    "vorder": 49,
    "position": 0,
    "text": "درختیست این خود نشانده بدست"
  },
  {
    "poem_id": 1363,
    "vorder": 50,
    "position": 1,
    "text": "کجا آب او خون و برگش کبست"
  },
  {
    "poem_id": 1363,
    "vorder": 51,
    "position": 0,
    "text": "ترا با من اکنون بدین گفت‌گوی"
  },
  {
    "poem_id": 1363,
    "vorder": 52,
    "position": 1,
    "text": "بباید بروی اندر آورد روی"
  },
  {
    "poem_id": 1363,
    "vorder": 53,
    "position": 0,
    "text": "زدن رای هشیار و کردن نگاه"
  },
  {
    "poem_id": 1363,
    "vorder": 54,
    "position": 1,
    "text": "هیونی فگندن به نزدیک شاه"
  },
  {
    "poem_id": 1363,
    "vorder": 55,
    "position": 0,
    "text": "زبان‌آوری چرب گوی از میان"
  },
  {
    "poem_id": 1363,
    "vorder": 56,
    "position": 1,
    "text": "فرستاد باید به شاه جهان"
  },
  {
    "poem_id": 1363,
    "vorder": 57,
    "position": 0,
    "text": "به جای زبونی و جای فریب"
  },
  {
    "poem_id": 1363,
    "vorder": 58,
    "position": 1,
    "text": "نباید که یابد دلاور شکیب"
  },
  {
    "poem_id": 1363,
    "vorder": 59,
    "position": 0,
    "text": "نشاید درنگ اندرین کار هیچ"
  },
  {
    "poem_id": 1363,
    "vorder": 60,
    "position": 1,
    "text": "کجا آید آسایش اندر بسیچ"
  },
  {
    "poem_id": 1363,
    "vorder": 61,
    "position": 0,
    "text": "فرستاده چون پاسخ آورد باز"
  },
  {
    "poem_id": 1363,
    "vorder": 62,
    "position": 1,
    "text": "برهنه شد آن روی پوشیده‌راز"
  },
  {
    "poem_id": 1363,
    "vorder": 63,
    "position": 0,
    "text": "برفت این برادر ز روم آن ز چین"
  },
  {
    "poem_id": 1363,
    "vorder": 64,
    "position": 1,
    "text": "به زهر اندر آمیخته انگبین"
  },
  {
    "poem_id": 1363,
    "vorder": 65,
    "position": 0,
    "text": "رسیدند پس یک به دیگر فراز"
  },
  {
    "poem_id": 1363,
    "vorder": 66,
    "position": 1,
    "text": "سخن راندند آشکارا و راز"
  },
  {
    "poem_id": 1363,
    "vorder": 67,
    "position": 0,
    "text": "گزیدند پس موبدی تیزویر"
  },
  {
    "poem_id": 1363,
    "vorder": 68,
    "position": 1,
    "text": "سخن گوی و بینادل و یادگیر"
  },
  {
    "poem_id": 1363,
    "vorder": 69,
    "position": 0,
    "text": "ز بیگانه پردخته کردند جای"
  },
  {
    "poem_id": 1363,
    "vorder": 70,
    "position": 1,
    "text": "سگالش گرفتند هر گونه رای"
  },
  {
    "poem_id": 1363,
    "vorder": 71,
    "position": 0,
    "text": "سخن سلم پیوند کرد از نخست"
  },
  {
    "poem_id": 1363,
    "vorder": 72,
    "position": 1,
    "text": "ز شرم پدر دیدگان را بشست"
  },
  {
    "poem_id": 1363,
    "vorder": 73,
    "position": 0,
    "text": "فرستاده را گفت ره برنورد"
  },
  {
    "poem_id": 1363,
    "vorder": 74,
    "position": 1,
    "text": "نباید که یابد ترا باد و گرد"
  },
  {
    "poem_id": 1363,
    "vorder": 75,
    "position": 0,
    "text": "چو آیی به کاخ فریدون فرود"
  },
  {
    "poem_id": 1363,
    "vorder": 76,
    "position": 1,
    "text": "نخستین ز هر دو پسر ده درود"
  },
  {
    "poem_id": 1363,
    "vorder": 77,
    "position": 0,
    "text": "پس آنگه بگویش که ترس خدای"
  },
  {
    "poem_id": 1363,
    "vorder": 78,
    "position": 1,
    "text": "بباید که باشد به هر دو سرای"
  },
  {
    "poem_id": 1363,
    "vorder": 79,
    "position": 0,
    "text": "جوان را بود روز پیری امید"
  },
  {
    "poem_id": 1363,
    "vorder": 80,
    "position": 1,
    "text": "نگردد سیه‌ ، مویِ گشته سپید"
  },
  {
    "poem_id": 1363,
    "vorder": 81,
    "position": 0,
    "text": "چه سازی درنگ اندرین جای تنگ"
  },
  {
    "poem_id": 1363,
    "vorder": 82,
    "position": 1,
    "text": "که شد تنگ بر تو سرای درنگ"
  },
  {
    "poem_id": 1363,
    "vorder": 83,
    "position": 0,
    "text": "جهان مرترا داد یزدان پاک"
  },
  {
    "poem_id": 1363,
    "vorder": 84,
    "position": 1,
    "text": "ز تابنده خورشید تا تیره خاک"
  },
  {
    "poem_id": 1363,
    "vorder": 85,
    "position": 0,
    "text": "همه بآرزو ساختی رسم و راه"
  },
  {
    "poem_id": 1363,
    "vorder": 86,
    "position": 1,
    "text": "نکردی به فرمان یزدان نگاه"
  },
  {
    "poem_id": 1363,
    "vorder": 87,
    "position": 0,
    "text": "نجستی به جز کژی و کاستی"
  },
  {
    "poem_id": 1363,
    "vorder": 88,
    "position": 1,
    "text": "نکردی به بخشش درون راستی"
  },
  {
    "poem_id": 1363,
    "vorder": 89,
    "position": 0,
    "text": "سه فرزند بودت خردمند و گرد"
  },
  {
    "poem_id": 1363,
    "vorder": 90,
    "position": 1,
    "text": "بزرگ آمدت تیره بیدار خرد"
  },
  {
    "poem_id": 1363,
    "vorder": 91,
    "position": 0,
    "text": "ندیدی هنر با یکی بیشتر"
  },
  {
    "poem_id": 1363,
    "vorder": 92,
    "position": 1,
    "text": "کجا دیگری زو فرو برد سر"
  },
  {
    "poem_id": 1363,
    "vorder": 93,
    "position": 0,
    "text": "یکی را دم اژدها ساختی"
  },
  {
    "poem_id": 1363,
    "vorder": 94,
    "position": 1,
    "text": "یکی را به ابر اندر افراختی"
  },
  {
    "poem_id": 1363,
    "vorder": 95,
    "position": 0,
    "text": "یکی تاج بر سر ببالین تو"
  },
  {
    "poem_id": 1363,
    "vorder": 96,
    "position": 1,
    "text": "برو شاد گشته جهان‌بین تو"
  },
  {
    "poem_id": 1363,
    "vorder": 97,
    "position": 0,
    "text": "نه ما زو به مام و پدر کمتریم"
  },
  {
    "poem_id": 1363,
    "vorder": 98,
    "position": 1,
    "text": "نه بر تخت شاهی نه اندر خوریم"
  },
  {
    "poem_id": 1363,
    "vorder": 99,
    "position": 0,
    "text": "ایا دادگر شهریار زمین"
  },
  {
    "poem_id": 1363,
    "vorder": 100,
    "position": 1,
    "text": "برین داد هرگز مباد آفرین"
  },
  {
    "poem_id": 1363,
    "vorder": 101,
    "position": 0,
    "text": "اگر تاج از آن تارک بی‌بها"
  },
  {
    "poem_id": 1363,
    "vorder": 102,
    "position": 1,
    "text": "شود دور و یابد جهان زو رها"
  },
  {
    "poem_id": 1363,
    "vorder": 103,
    "position": 0,
    "text": "سپاری بدو گوشه‌ای از جهان"
  },
  {
    "poem_id": 1363,
    "vorder": 104,
    "position": 1,
    "text": "نشیند چو ما از تو خسته نهان"
  },
  {
    "poem_id": 1363,
    "vorder": 105,
    "position": 0,
    "text": "و گرنه سواران ترکان و چین"
  },
  {
    "poem_id": 1363,
    "vorder": 106,
    "position": 1,
    "text": "هم از روم گردان جوینده کین"
  },
  {
    "poem_id": 1363,
    "vorder": 107,
    "position": 0,
    "text": "فراز آورم لشگر گرزدار"
  },
  {
    "poem_id": 1363,
    "vorder": 108,
    "position": 1,
    "text": "از ایران و ایرج برآرم دمار"
  },
  {
    "poem_id": 1363,
    "vorder": 109,
    "position": 0,
    "text": "چو بشنید موبد پیام درشت"
  },
  {
    "poem_id": 1363,
    "vorder": 110,
    "position": 1,
    "text": "زمین را ببوسید و بنمود پشت"
  },
  {
    "poem_id": 1363,
    "vorder": 111,
    "position": 0,
    "text": "بر آنسان به زین اندر آورد پای"
  },
  {
    "poem_id": 1363,
    "vorder": 112,
    "position": 1,
    "text": "که از باد آتش بجنبد ز جای"
  },
  {
    "poem_id": 1363,
    "vorder": 113,
    "position": 0,
    "text": "به درگاه شاه آفریدون رسید"
  },
  {
    "poem_id": 1363,
    "vorder": 114,
    "position": 1,
    "text": "برآورده‌ای دید سر ناپدید"
  },
  {
    "poem_id": 1363,
    "vorder": 115,
    "position": 0,
    "text": "به ابر اندر آورده بالای او"
  },
  {
    "poem_id": 1363,
    "vorder": 116,
    "position": 1,
    "text": "زمین کوه تا کوه پهنای او"
  },
  {
    "poem_id": 1363,
    "vorder": 117,
    "position": 0,
    "text": "نشسته به در بر گرانمایگان"
  },
  {
    "poem_id": 1363,
    "vorder": 118,
    "position": 1,
    "text": "به پرده درون جای پرمایگان"
  },
  {
    "poem_id": 1363,
    "vorder": 119,
    "position": 0,
    "text": "به یک دست بربسته شیر و پلنگ"
  },
  {
    "poem_id": 1363,
    "vorder": 120,
    "position": 1,
    "text": "به دست دگر ژنده پیلان جنگ"
  },
  {
    "poem_id": 1363,
    "vorder": 121,
    "position": 0,
    "text": "ز چندان گرانمایه گرد دلیر"
  },
  {
    "poem_id": 1363,
    "vorder": 122,
    "position": 1,
    "text": "خروشی برآمد چو آوای شیر"
  },
  {
    "poem_id": 1363,
    "vorder": 123,
    "position": 0,
    "text": "سپهریست پنداشت ایوان به جای"
  },
  {
    "poem_id": 1363,
    "vorder": 124,
    "position": 1,
    "text": "گران لشگری گرد او بر به پای"
  },
  {
    "poem_id": 1363,
    "vorder": 125,
    "position": 0,
    "text": "برفتند بیدار کارآگهان"
  },
  {
    "poem_id": 1363,
    "vorder": 126,
    "position": 1,
    "text": "بگفتند با شهریار جهان"
  },
  {
    "poem_id": 1363,
    "vorder": 127,
    "position": 0,
    "text": "که آمد فرستاده‌ای نزد شاه"
  },
  {
    "poem_id": 1363,
    "vorder": 128,
    "position": 1,
    "text": "یکی پرمنش مرد با دستگاه"
  },
  {
    "poem_id": 1363,
    "vorder": 129,
    "position": 0,
    "text": "بفرمود تا پرده برداشتند"
  },
  {
    "poem_id": 1363,
    "vorder": 130,
    "position": 1,
    "text": "بر اسپش ز درگاه بگذاشتند"
  },
  {
    "poem_id": 1363,
    "vorder": 131,
    "position": 0,
    "text": "چو چشمش به روی فریدون رسید"
  },
  {
    "poem_id": 1363,
    "vorder": 132,
    "position": 1,
    "text": "همه دیده و دل پر از شاه دید"
  },
  {
    "poem_id": 1363,
    "vorder": 133,
    "position": 0,
    "text": "به بالای سرو و چو خورشید روی"
  },
  {
    "poem_id": 1363,
    "vorder": 134,
    "position": 1,
    "text": "چو کافور گرد گل سرخ موی"
  },
  {
    "poem_id": 1363,
    "vorder": 135,
    "position": 0,
    "text": "دولب پر ز خنده دو رخ پر ز شرم"
  },
  {
    "poem_id": 1363,
    "vorder": 136,
    "position": 1,
    "text": "کیانی زبان پر ز گفتار نرم"
  },
  {
    "poem_id": 1363,
    "vorder": 137,
    "position": 0,
    "text": "نشاندش هم آنگه فریدون ز پای"
  },
  {
    "poem_id": 1363,
    "vorder": 138,
    "position": 1,
    "text": "سزاوار کردش بر خویش جای"
  },
  {
    "poem_id": 1363,
    "vorder": 139,
    "position": 0,
    "text": "بپرسیدش از دو گرامی نخست"
  },
  {
    "poem_id": 1363,
    "vorder": 140,
    "position": 1,
    "text": "که هستند شادان دل و تن‌درست"
  },
  {
    "poem_id": 1363,
    "vorder": 141,
    "position": 0,
    "text": "دگر گفت کز راه دور و دراز"
  },
  {
    "poem_id": 1363,
    "vorder": 142,
    "position": 1,
    "text": "شدی رنجه اندر نشیب و فراز"
  },
  {
    "poem_id": 1363,
    "vorder": 143,
    "position": 0,
    "text": "فرستاده گفت ای گرانمایه شاه"
  },
  {
    "poem_id": 1363,
    "vorder": 144,
    "position": 1,
    "text": "ابی تو مبیناد کس پیش‌گاه"
  },
  {
    "poem_id": 1363,
    "vorder": 145,
    "position": 0,
    "text": "ز هر کس که پرسی به کام تواند"
  },
  {
    "poem_id": 1363,
    "vorder": 146,
    "position": 1,
    "text": "همه پاک زنده به نام تواند"
  },
  {
    "poem_id": 1363,
    "vorder": 147,
    "position": 0,
    "text": "منم بنده‌ای شاه را ناسزا"
  },
  {
    "poem_id": 1363,
    "vorder": 148,
    "position": 1,
    "text": "چنین بر تن خویش ناپارسا"
  },
  {
    "poem_id": 1363,
    "vorder": 149,
    "position": 0,
    "text": "پیامی درشت آوریده به شاه"
  },
  {
    "poem_id": 1363,
    "vorder": 150,
    "position": 1,
    "text": "فرستنده پر خشم و من بیگناه"
  },
  {
    "poem_id": 1363,
    "vorder": 151,
    "position": 0,
    "text": "بگویم چو فرمایدم شهریار"
  },
  {
    "poem_id": 1363,
    "vorder": 152,
    "position": 1,
    "text": "پیام جوانان ناهوشیار"
  },
  {
    "poem_id": 1363,
    "vorder": 153,
    "position": 0,
    "text": "بفرمود پس تا زبان برگشاد"
  },
  {
    "poem_id": 1363,
    "vorder": 154,
    "position": 1,
    "text": "شنیده سخن سر به سر کرد یاد"
  },
  {
    "poem_id": 1363,
    "vorder": 155,
    "position": 0,
    "text": "فریدون بدو پهن بگشاد گوش"
  },
  {
    "poem_id": 1363,
    "vorder": 156,
    "position": 1,
    "text": "چو بشنید مغزش برآمد به جوش"
  },
  {
    "poem_id": 1363,
    "vorder": 157,
    "position": 0,
    "text": "فرستاده را گفت کای هوشیار"
  },
  {
    "poem_id": 1363,
    "vorder": 158,
    "position": 1,
    "text": "بباید ترا پوزش اکنون به کار"
  },
  {
    "poem_id": 1363,
    "vorder": 159,
    "position": 0,
    "text": "که من چشم از ایشان چنین داشتم"
  },
  {
    "poem_id": 1363,
    "vorder": 160,
    "position": 1,
    "text": "همی بر دل خویش بگذاشتم"
  },
  {
    "poem_id": 1363,
    "vorder": 161,
    "position": 0,
    "text": "که از گوهر بد نیاید مهی"
  },
  {
    "poem_id": 1363,
    "vorder": 162,
    "position": 1,
    "text": "مرا دل همی داد این آگهی"
  },
  {
    "poem_id": 1363,
    "vorder": 163,
    "position": 0,
    "text": "بگوی آن دو ناپاک بیهوده را"
  },
  {
    "poem_id": 1363,
    "vorder": 164,
    "position": 1,
    "text": "دو اهریمن مغز پالوده را"
  },
  {
    "poem_id": 1363,
    "vorder": 165,
    "position": 0,
    "text": "انوشه که کردید گوهر پدید"
  },
  {
    "poem_id": 1363,
    "vorder": 166,
    "position": 1,
    "text": "درود از شما خود بدین سان سزید"
  },
  {
    "poem_id": 1363,
    "vorder": 167,
    "position": 0,
    "text": "ز پند من ار مغزتان شد تهی"
  },
  {
    "poem_id": 1363,
    "vorder": 168,
    "position": 1,
    "text": "همی از خردتان نبود آگهی"
  },
  {
    "poem_id": 1363,
    "vorder": 169,
    "position": 0,
    "text": "ندارید شرم و نه بیم از خدای"
  },
  {
    "poem_id": 1363,
    "vorder": 170,
    "position": 1,
    "text": "شما را همانا همین‌ست رای"
  },
  {
    "poem_id": 1363,
    "vorder": 171,
    "position": 0,
    "text": "مرا پیشتر قیرگون بود موی"
  },
  {
    "poem_id": 1363,
    "vorder": 172,
    "position": 1,
    "text": "چو سرو سهی قد و چون ماه روی"
  },
  {
    "poem_id": 1363,
    "vorder": 173,
    "position": 0,
    "text": "سپهری که پشت مرا کرد کوز"
  },
  {
    "poem_id": 1363,
    "vorder": 174,
    "position": 1,
    "text": "نشد پست و گردان بجایست نوز"
  },
  {
    "poem_id": 1363,
    "vorder": 175,
    "position": 0,
    "text": "خماند شما را هم این روزگار"
  },
  {
    "poem_id": 1363,
    "vorder": 176,
    "position": 1,
    "text": "نماند برین گونه بس پایدار"
  },
  {
    "poem_id": 1363,
    "vorder": 177,
    "position": 0,
    "text": "بدان برترین نام یزدان پاک"
  },
  {
    "poem_id": 1363,
    "vorder": 178,
    "position": 1,
    "text": "به رخشنده خورشید و بر تیره خاک"
  },
  {
    "poem_id": 1363,
    "vorder": 179,
    "position": 0,
    "text": "به تخت و کلاه و به ناهید و ماه"
  },
  {
    "poem_id": 1363,
    "vorder": 180,
    "position": 1,
    "text": "که من بد نکردم شما را نگاه"
  },
  {
    "poem_id": 1363,
    "vorder": 181,
    "position": 0,
    "text": "یکی انجمن کردم از بخردان"
  },
  {
    "poem_id": 1363,
    "vorder": 182,
    "position": 1,
    "text": "ستاره شناسان و هم موبدان"
  },
  {
    "poem_id": 1363,
    "vorder": 183,
    "position": 0,
    "text": "بسی روزگاران شدست اندرین"
  },
  {
    "poem_id": 1363,
    "vorder": 184,
    "position": 1,
    "text": "نکردیم بر باد بخشش زمین"
  },
  {
    "poem_id": 1363,
    "vorder": 185,
    "position": 0,
    "text": "همه راستی خواستم زین سخن"
  },
  {
    "poem_id": 1363,
    "vorder": 186,
    "position": 1,
    "text": "به کژی نه سر بود پیدا نه بن"
  },
  {
    "poem_id": 1363,
    "vorder": 187,
    "position": 0,
    "text": "همه ترس یزدان بد اندر میان"
  },
  {
    "poem_id": 1363,
    "vorder": 188,
    "position": 1,
    "text": "همه راستی خواستم در جهان"
  },
  {
    "poem_id": 1363,
    "vorder": 189,
    "position": 0,
    "text": "چو آباد دادند گیتی به من"
  },
  {
    "poem_id": 1363,
    "vorder": 190,
    "position": 1,
    "text": "نجستم پراگندن انجمن"
  },
  {
    "poem_id": 1363,
    "vorder": 191,
    "position": 0,
    "text": "مگر همچنان گفتم آباد تخت"
  },
  {
    "poem_id": 1363,
    "vorder": 192,
    "position": 1,
    "text": "سپارم به سه دیدهٔ نیک بخت"
  },
  {
    "poem_id": 1363,
    "vorder": 193,
    "position": 0,
    "text": "شما را کنون گر دل از راه من"
  },
  {
    "poem_id": 1363,
    "vorder": 194,
    "position": 1,
    "text": "به کژی و تاری کشید اهرمن"
  },
  {
    "poem_id": 1363,
    "vorder": 195,
    "position": 0,
    "text": "ببینید تا کردگار بلند"
  },
  {
    "poem_id": 1363,
    "vorder": 196,
    "position": 1,
    "text": "چنین از شما کرد خواهد پسند"
  },
  {
    "poem_id": 1363,
    "vorder": 197,
    "position": 0,
    "text": "یکی داستان گویم ار بشنوید"
  },
  {
    "poem_id": 1363,
    "vorder": 198,
    "position": 1,
    "text": "همان بر که کارید خود بدروید"
  },
  {
    "poem_id": 1363,
    "vorder": 199,
    "position": 0,
    "text": "چنین گفت باما سخن رهنمای"
  },
  {
    "poem_id": 1363,
    "vorder": 200,
    "position": 1,
    "text": "جزین است جاوید ما را سرای"
  },
  {
    "poem_id": 1363,
    "vorder": 201,
    "position": 0,
    "text": "به تخت خرد بر نشست آزتان"
  },
  {
    "poem_id": 1363,
    "vorder": 202,
    "position": 1,
    "text": "چرا شد چنین دیو انبازتان"
  },
  {
    "poem_id": 1363,
    "vorder": 203,
    "position": 0,
    "text": "بترسم که در چنگ این اژدها"
  },
  {
    "poem_id": 1363,
    "vorder": 204,
    "position": 1,
    "text": "روان یابد از کالبدتان رها"
  },
  {
    "poem_id": 1363,
    "vorder": 205,
    "position": 0,
    "text": "مرا خود ز گیتی گه رفتن است"
  },
  {
    "poem_id": 1363,
    "vorder": 206,
    "position": 1,
    "text": "نه هنگام تندی و آشفتن است"
  },
  {
    "poem_id": 1363,
    "vorder": 207,
    "position": 0,
    "text": "ولیکن چنین گوید آن سالخورد"
  },
  {
    "poem_id": 1363,
    "vorder": 208,
    "position": 1,
    "text": "که بودش سه فرزند آزاد مرد"
  },
  {
    "poem_id": 1363,
    "vorder": 209,
    "position": 0,
    "text": "که چون آز گردد ز دلها تهی"
  },
  {
    "poem_id": 1363,
    "vorder": 210,
    "position": 1,
    "text": "چه آن خاک و آن تاج شاهنشهی"
  },
  {
    "poem_id": 1363,
    "vorder": 211,
    "position": 0,
    "text": "کسی کو برادر فروشد به خاک"
  },
  {
    "poem_id": 1363,
    "vorder": 212,
    "position": 1,
    "text": "سزد گر نخوانندش از آب پاک"
  },
  {
    "poem_id": 1363,
    "vorder": 213,
    "position": 0,
    "text": "جهان چون شما دید و بیند بسی"
  },
  {
    "poem_id": 1363,
    "vorder": 214,
    "position": 1,
    "text": "نخواهد شدن رام با هر کسی"
  },
  {
    "poem_id": 1363,
    "vorder": 215,
    "position": 0,
    "text": "کزین هر چه دانید از کردگار"
  },
  {
    "poem_id": 1363,
    "vorder": 216,
    "position": 1,
    "text": "بود رستگاری به روز شمار"
  },
  {
    "poem_id": 1363,
    "vorder": 217,
    "position": 0,
    "text": "بجویید و آن توشهٔ ره کنید"
  },
  {
    "poem_id": 1363,
    "vorder": 218,
    "position": 1,
    "text": "بکوشید تا رنج کوته کنید"
  },
  {
    "poem_id": 1363,
    "vorder": 219,
    "position": 0,
    "text": "فرستاده بشنید گفتار اوی"
  },
  {
    "poem_id": 1363,
    "vorder": 220,
    "position": 1,
    "text": "زمین را ببوسید و برگاشت روی"
  },
  {
    "poem_id": 1363,
    "vorder": 221,
    "position": 0,
    "text": "ز پیش فریدون چنان بازگشت"
  },
  {
    "poem_id": 1363,
    "vorder": 222,
    "position": 1,
    "text": "که گفتی که با باد انباز گشت"
  }
]