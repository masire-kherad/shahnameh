[
  {
    "poem_id": 1602,
    "vorder": 1,
    "position": 0,
    "text": "بدانست رستم که لابه به کار"
  },
  {
    "poem_id": 1602,
    "vorder": 2,
    "position": 1,
    "text": "نیاید همی پیش اسفندیار"
  },
  {
    "poem_id": 1602,
    "vorder": 3,
    "position": 0,
    "text": "کمان را به زه کرد و آن تیر گز"
  },
  {
    "poem_id": 1602,
    "vorder": 4,
    "position": 1,
    "text": "که پیکانش را داده بد آب رز"
  },
  {
    "poem_id": 1602,
    "vorder": 5,
    "position": 0,
    "text": "همی راند تیر گز اندر کمان"
  },
  {
    "poem_id": 1602,
    "vorder": 6,
    "position": 1,
    "text": "سر خویش کرده سوی آسمان"
  },
  {
    "poem_id": 1602,
    "vorder": 7,
    "position": 0,
    "text": "همی گفت کای پاک دادار هور"
  },
  {
    "poem_id": 1602,
    "vorder": 8,
    "position": 1,
    "text": "فزایندهٔ دانش و فر و زور"
  },
  {
    "poem_id": 1602,
    "vorder": 9,
    "position": 0,
    "text": "همی بینی این پاک جان مرا"
  },
  {
    "poem_id": 1602,
    "vorder": 10,
    "position": 1,
    "text": "توان مرا هم روان مرا"
  },
  {
    "poem_id": 1602,
    "vorder": 11,
    "position": 0,
    "text": "که چندین بپیچم که اسفندیار"
  },
  {
    "poem_id": 1602,
    "vorder": 12,
    "position": 1,
    "text": "مگر سر بپیچاند از کارزار"
  },
  {
    "poem_id": 1602,
    "vorder": 13,
    "position": 0,
    "text": "تو دانی که بیداد کوشد همی"
  },
  {
    "poem_id": 1602,
    "vorder": 14,
    "position": 1,
    "text": "همی جنگ و مردی فروشد همی"
  },
  {
    "poem_id": 1602,
    "vorder": 15,
    "position": 0,
    "text": "به بادافره این گناهم مگیر"
  },
  {
    "poem_id": 1602,
    "vorder": 16,
    "position": 1,
    "text": "توی آفرینندهٔ ماه و تیر"
  },
  {
    "poem_id": 1602,
    "vorder": 17,
    "position": 0,
    "text": "چو خودکامه جنگی بدید آن درنگ"
  },
  {
    "poem_id": 1602,
    "vorder": 18,
    "position": 1,
    "text": "که رستم همی دیر شد سوی جنگ"
  },
  {
    "poem_id": 1602,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت کای سگزی بدگمان"
  },
  {
    "poem_id": 1602,
    "vorder": 20,
    "position": 1,
    "text": "نشد سیر جانت ز تیر و کمان"
  },
  {
    "poem_id": 1602,
    "vorder": 21,
    "position": 0,
    "text": "ببینی کنون تیر گشتاسپی"
  },
  {
    "poem_id": 1602,
    "vorder": 22,
    "position": 1,
    "text": "دل شیر و پیکان لهراسپی"
  },
  {
    "poem_id": 1602,
    "vorder": 23,
    "position": 0,
    "text": "یکی تیر بر ترگ رستم بزد"
  },
  {
    "poem_id": 1602,
    "vorder": 24,
    "position": 1,
    "text": "چنان کز کمان سواران سزد"
  },
  {
    "poem_id": 1602,
    "vorder": 25,
    "position": 0,
    "text": "تهمتن گز اندر کمان راند زود"
  },
  {
    "poem_id": 1602,
    "vorder": 26,
    "position": 1,
    "text": "بران سان که سیمرغ فرموده بود"
  },
  {
    "poem_id": 1602,
    "vorder": 27,
    "position": 0,
    "text": "بزد تیر بر چشم اسفندیار"
  },
  {
    "poem_id": 1602,
    "vorder": 28,
    "position": 1,
    "text": "سیه شد جهان پیش آن نامدار"
  },
  {
    "poem_id": 1602,
    "vorder": 29,
    "position": 0,
    "text": "خم آورد بالای سرو سهی"
  },
  {
    "poem_id": 1602,
    "vorder": 30,
    "position": 1,
    "text": "ازو دور شد دانش و فرهی"
  },
  {
    "poem_id": 1602,
    "vorder": 31,
    "position": 0,
    "text": "نگون شد سر شاه یزدان‌پرست"
  },
  {
    "poem_id": 1602,
    "vorder": 32,
    "position": 1,
    "text": "بیفتاد چاچی کمانش ز دست"
  },
  {
    "poem_id": 1602,
    "vorder": 33,
    "position": 0,
    "text": "گرفته بش و یال اسپ سیاه"
  },
  {
    "poem_id": 1602,
    "vorder": 34,
    "position": 1,
    "text": "ز خون لعل شد خاک آوردگاه"
  },
  {
    "poem_id": 1602,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت رستم به اسفندیار"
  },
  {
    "poem_id": 1602,
    "vorder": 36,
    "position": 1,
    "text": "که آوردی آن تخم زفتی به بار"
  },
  {
    "poem_id": 1602,
    "vorder": 37,
    "position": 0,
    "text": "تو آنی که گفتی که رویین تنم"
  },
  {
    "poem_id": 1602,
    "vorder": 38,
    "position": 1,
    "text": "بلند آسمان بر زمین بر زنم"
  },
  {
    "poem_id": 1602,
    "vorder": 39,
    "position": 0,
    "text": "من از شست تو هشت تیر خدنگ"
  },
  {
    "poem_id": 1602,
    "vorder": 40,
    "position": 1,
    "text": "بخوردم ننالیدم از نام و ننگ"
  },
  {
    "poem_id": 1602,
    "vorder": 41,
    "position": 0,
    "text": "به یک تیر برگشتی از کارزار"
  },
  {
    "poem_id": 1602,
    "vorder": 42,
    "position": 1,
    "text": "بخفتی بران بارهٔ نامدار"
  },
  {
    "poem_id": 1602,
    "vorder": 43,
    "position": 0,
    "text": "هم‌اکنون به خاک اندر آید سرت"
  },
  {
    "poem_id": 1602,
    "vorder": 44,
    "position": 1,
    "text": "بسوزد دل مهربان مادرت"
  },
  {
    "poem_id": 1602,
    "vorder": 45,
    "position": 0,
    "text": "هم‌انگه سر نامبردار شاه"
  },
  {
    "poem_id": 1602,
    "vorder": 46,
    "position": 1,
    "text": "نگون اندر آمد ز پشت سیاه"
  },
  {
    "poem_id": 1602,
    "vorder": 47,
    "position": 0,
    "text": "زمانی همی بود تا یافت هوش"
  },
  {
    "poem_id": 1602,
    "vorder": 48,
    "position": 1,
    "text": "بر خاک بنشست و بگشاد گوش"
  },
  {
    "poem_id": 1602,
    "vorder": 49,
    "position": 0,
    "text": "سر تیر بگرفت و بیرون کشید"
  },
  {
    "poem_id": 1602,
    "vorder": 50,
    "position": 1,
    "text": "همی پر و پیکانش در خون کشید"
  },
  {
    "poem_id": 1602,
    "vorder": 51,
    "position": 0,
    "text": "همانگه به بهمن رسید آگهی"
  },
  {
    "poem_id": 1602,
    "vorder": 52,
    "position": 1,
    "text": "که تیره شد آن فر شاهنشهی"
  },
  {
    "poem_id": 1602,
    "vorder": 53,
    "position": 0,
    "text": "بیامد به پیش پشوتن بگفت"
  },
  {
    "poem_id": 1602,
    "vorder": 54,
    "position": 1,
    "text": "که پیکار ما گشت با درد جفت"
  },
  {
    "poem_id": 1602,
    "vorder": 55,
    "position": 0,
    "text": "تن ژنده پیل اندر آمد به خاک"
  },
  {
    "poem_id": 1602,
    "vorder": 56,
    "position": 1,
    "text": "دل ما ازین درد کردند چاک"
  },
  {
    "poem_id": 1602,
    "vorder": 57,
    "position": 0,
    "text": "برفتد هر دو پیاده دوان"
  },
  {
    "poem_id": 1602,
    "vorder": 58,
    "position": 1,
    "text": "ز پیش سپه تا بر پهلوان"
  },
  {
    "poem_id": 1602,
    "vorder": 59,
    "position": 0,
    "text": "بدیدند جنگی برش پر ز خون"
  },
  {
    "poem_id": 1602,
    "vorder": 60,
    "position": 1,
    "text": "یکی تیر پرخون به دست اندرون"
  },
  {
    "poem_id": 1602,
    "vorder": 61,
    "position": 0,
    "text": "پشوتن بر و جامه را کرد چاک"
  },
  {
    "poem_id": 1602,
    "vorder": 62,
    "position": 1,
    "text": "خروشان به سر بر همی کرد خاک"
  },
  {
    "poem_id": 1602,
    "vorder": 63,
    "position": 0,
    "text": "همی گشت بهمن به خاک اندرون"
  },
  {
    "poem_id": 1602,
    "vorder": 64,
    "position": 1,
    "text": "بمالید رخ را بدان گرم خون"
  },
  {
    "poem_id": 1602,
    "vorder": 65,
    "position": 0,
    "text": "پشوتن همی گفت راز جهان"
  },
  {
    "poem_id": 1602,
    "vorder": 66,
    "position": 1,
    "text": "که داند ز دین‌آوران و مهان"
  },
  {
    "poem_id": 1602,
    "vorder": 67,
    "position": 0,
    "text": "چو اسفندیاری که از بهر دین"
  },
  {
    "poem_id": 1602,
    "vorder": 68,
    "position": 1,
    "text": "به مردی برآهیخت شمشیر کین"
  },
  {
    "poem_id": 1602,
    "vorder": 69,
    "position": 0,
    "text": "جهان کرد پاک از بد بت‌پرست"
  },
  {
    "poem_id": 1602,
    "vorder": 70,
    "position": 1,
    "text": "به بد کار هرگز نیازید دست"
  },
  {
    "poem_id": 1602,
    "vorder": 71,
    "position": 0,
    "text": "به روز جوانی هلاک آمدش"
  },
  {
    "poem_id": 1602,
    "vorder": 72,
    "position": 1,
    "text": "سر تاجور سوی خاک آمدش"
  },
  {
    "poem_id": 1602,
    "vorder": 73,
    "position": 0,
    "text": "بدی را کزو هست گیتی به درد"
  },
  {
    "poem_id": 1602,
    "vorder": 74,
    "position": 1,
    "text": "پرآزار ازو جان آزاد مرد"
  },
  {
    "poem_id": 1602,
    "vorder": 75,
    "position": 0,
    "text": "فراوان برو بگذرد روزگار"
  },
  {
    "poem_id": 1602,
    "vorder": 76,
    "position": 1,
    "text": "که هرگز نبیند بد کارزار"
  },
  {
    "poem_id": 1602,
    "vorder": 77,
    "position": 0,
    "text": "جوانان گرفتندش اندر کنار"
  },
  {
    "poem_id": 1602,
    "vorder": 78,
    "position": 1,
    "text": "همی خون ستردند زان شهریار"
  },
  {
    "poem_id": 1602,
    "vorder": 79,
    "position": 0,
    "text": "پشوتن بروبر همی مویه کرد"
  },
  {
    "poem_id": 1602,
    "vorder": 80,
    "position": 1,
    "text": "رخی پر ز خون و دلی پر ز درد"
  },
  {
    "poem_id": 1602,
    "vorder": 81,
    "position": 0,
    "text": "همی گفت زار ای یل اسفندیار"
  },
  {
    "poem_id": 1602,
    "vorder": 82,
    "position": 1,
    "text": "جهانجوی و از تخمهٔ شهریار"
  },
  {
    "poem_id": 1602,
    "vorder": 83,
    "position": 0,
    "text": "که کند این چنین کوه جنگی ز جای"
  },
  {
    "poem_id": 1602,
    "vorder": 84,
    "position": 1,
    "text": "که افگند شیر ژیان را ز پای"
  },
  {
    "poem_id": 1602,
    "vorder": 85,
    "position": 0,
    "text": "که کند این پسندیده دندان پیل"
  },
  {
    "poem_id": 1602,
    "vorder": 86,
    "position": 1,
    "text": "که آگند با موج دریای نیل"
  },
  {
    "poem_id": 1602,
    "vorder": 87,
    "position": 0,
    "text": "چه آمد برین تخمه از چشم بد"
  },
  {
    "poem_id": 1602,
    "vorder": 88,
    "position": 1,
    "text": "که بر بدکنش بی‌گمان بد رسد"
  },
  {
    "poem_id": 1602,
    "vorder": 89,
    "position": 0,
    "text": "کجا شد به رزم اندرون ساز تو"
  },
  {
    "poem_id": 1602,
    "vorder": 90,
    "position": 1,
    "text": "کجا شد به بزم آن خوش آواز تو"
  },
  {
    "poem_id": 1602,
    "vorder": 91,
    "position": 0,
    "text": "کجا شد دل و هوش و آیین تو"
  },
  {
    "poem_id": 1602,
    "vorder": 92,
    "position": 1,
    "text": "توانایی و اختر و دین تو"
  },
  {
    "poem_id": 1602,
    "vorder": 93,
    "position": 0,
    "text": "چو کردی جهان را ز بدخواه پاک"
  },
  {
    "poem_id": 1602,
    "vorder": 94,
    "position": 1,
    "text": "نیامدت از پیل وز شیر باک"
  },
  {
    "poem_id": 1602,
    "vorder": 95,
    "position": 0,
    "text": "کنون آمدت سودمندی به کار"
  },
  {
    "poem_id": 1602,
    "vorder": 96,
    "position": 1,
    "text": "که در خاک بیند ترا روزگار"
  },
  {
    "poem_id": 1602,
    "vorder": 97,
    "position": 0,
    "text": "که نفرین برین تاج و این تخت باد"
  },
  {
    "poem_id": 1602,
    "vorder": 98,
    "position": 1,
    "text": "بدین کوشش بیش و این بخت باد"
  },
  {
    "poem_id": 1602,
    "vorder": 99,
    "position": 0,
    "text": "که چو تو سواری دلیر و جوان"
  },
  {
    "poem_id": 1602,
    "vorder": 100,
    "position": 1,
    "text": "سرافراز و دانا و روشن‌روان"
  },
  {
    "poem_id": 1602,
    "vorder": 101,
    "position": 0,
    "text": "بدین سان شود کشته در کارزار"
  },
  {
    "poem_id": 1602,
    "vorder": 102,
    "position": 1,
    "text": "به زاری سرآید برو روزگار"
  },
  {
    "poem_id": 1602,
    "vorder": 103,
    "position": 0,
    "text": "که مه تاج بادا و مه تخت شاه"
  },
  {
    "poem_id": 1602,
    "vorder": 104,
    "position": 1,
    "text": "مه گشتاسپ و جاماسپ و آن بارگاه"
  },
  {
    "poem_id": 1602,
    "vorder": 105,
    "position": 0,
    "text": "چنین گفت پر دانش اسفندیار"
  },
  {
    "poem_id": 1602,
    "vorder": 106,
    "position": 1,
    "text": "که ای مرد دانای به روزگار"
  },
  {
    "poem_id": 1602,
    "vorder": 107,
    "position": 0,
    "text": "مکن خویشتن پیش من بر تباه"
  },
  {
    "poem_id": 1602,
    "vorder": 108,
    "position": 1,
    "text": "چنین بود بهر من از تاج و گاه"
  },
  {
    "poem_id": 1602,
    "vorder": 109,
    "position": 0,
    "text": "تن کشته را خاک باشد نهال"
  },
  {
    "poem_id": 1602,
    "vorder": 110,
    "position": 1,
    "text": "تو از کشتن من بدین سان منال"
  },
  {
    "poem_id": 1602,
    "vorder": 111,
    "position": 0,
    "text": "کجا شد فریدون و هوشنگ و جم"
  },
  {
    "poem_id": 1602,
    "vorder": 112,
    "position": 1,
    "text": "ز باد آمده باز گردد به دم"
  },
  {
    "poem_id": 1602,
    "vorder": 113,
    "position": 0,
    "text": "همان پاک‌زاده نیاکان ما"
  },
  {
    "poem_id": 1602,
    "vorder": 114,
    "position": 1,
    "text": "گزیده سرافراز و پاکان ما"
  },
  {
    "poem_id": 1602,
    "vorder": 115,
    "position": 0,
    "text": "برفتند و ما را سپردند جای"
  },
  {
    "poem_id": 1602,
    "vorder": 116,
    "position": 1,
    "text": "نماند کس اندر سپنجی سرای"
  },
  {
    "poem_id": 1602,
    "vorder": 117,
    "position": 0,
    "text": "فراوان بکوشیدم اندر جهان"
  },
  {
    "poem_id": 1602,
    "vorder": 118,
    "position": 1,
    "text": "چه در آشکار و چه اندر نهان"
  },
  {
    "poem_id": 1602,
    "vorder": 119,
    "position": 0,
    "text": "که تا رای یزدان به جای آورم"
  },
  {
    "poem_id": 1602,
    "vorder": 120,
    "position": 1,
    "text": "خرد را بدین رهنمای آورم"
  },
  {
    "poem_id": 1602,
    "vorder": 121,
    "position": 0,
    "text": "چو از من گرفت ای سخن روشنی"
  },
  {
    "poem_id": 1602,
    "vorder": 122,
    "position": 1,
    "text": "ز بد بسته شد راه آهرمنی"
  },
  {
    "poem_id": 1602,
    "vorder": 123,
    "position": 0,
    "text": "زمانه بیازید چنگال تیز"
  },
  {
    "poem_id": 1602,
    "vorder": 124,
    "position": 1,
    "text": "نبد زو مرا روزگار گریز"
  },
  {
    "poem_id": 1602,
    "vorder": 125,
    "position": 0,
    "text": "امید من آنست کاندر بهشت"
  },
  {
    "poem_id": 1602,
    "vorder": 126,
    "position": 1,
    "text": "دل‌افروز من بدرود هرچ کشت"
  },
  {
    "poem_id": 1602,
    "vorder": 127,
    "position": 0,
    "text": "به مردی مرا پور دستان نکشت"
  },
  {
    "poem_id": 1602,
    "vorder": 128,
    "position": 1,
    "text": "نگه کن بدین گز که دارم به مشت"
  },
  {
    "poem_id": 1602,
    "vorder": 129,
    "position": 0,
    "text": "بدین چوب شد روزگارم به سر"
  },
  {
    "poem_id": 1602,
    "vorder": 130,
    "position": 1,
    "text": "ز سیمرغ وز رستم چاره‌گر"
  },
  {
    "poem_id": 1602,
    "vorder": 131,
    "position": 0,
    "text": "فسونها و نیرنگها زال ساخت"
  },
  {
    "poem_id": 1602,
    "vorder": 132,
    "position": 1,
    "text": "که اروند و بند جهان او شناخت"
  },
  {
    "poem_id": 1602,
    "vorder": 133,
    "position": 0,
    "text": "چو اسفندیار این سخن یاد کرد"
  },
  {
    "poem_id": 1602,
    "vorder": 134,
    "position": 1,
    "text": "بپیچید و بگریست رستم به درد"
  },
  {
    "poem_id": 1602,
    "vorder": 135,
    "position": 0,
    "text": "چنین گفت کز دیو ناسازگار"
  },
  {
    "poem_id": 1602,
    "vorder": 136,
    "position": 1,
    "text": "ترا بهره رنج من آمد به کار"
  },
  {
    "poem_id": 1602,
    "vorder": 137,
    "position": 0,
    "text": "چنانست کو گفت یکسر سخن"
  },
  {
    "poem_id": 1602,
    "vorder": 138,
    "position": 1,
    "text": "ز مردی به کژی نیفگند بن"
  },
  {
    "poem_id": 1602,
    "vorder": 139,
    "position": 0,
    "text": "که تا من به گیتی کمر بسته‌ام"
  },
  {
    "poem_id": 1602,
    "vorder": 140,
    "position": 1,
    "text": "بسی رزم گردنکشان جسته‌ام"
  },
  {
    "poem_id": 1602,
    "vorder": 141,
    "position": 0,
    "text": "سواری ندیدم چو اسفندیار"
  },
  {
    "poem_id": 1602,
    "vorder": 142,
    "position": 1,
    "text": "زره‌دار با جوشن کارزار"
  },
  {
    "poem_id": 1602,
    "vorder": 143,
    "position": 0,
    "text": "چو بیچاره برگشتم از دست اوی"
  },
  {
    "poem_id": 1602,
    "vorder": 144,
    "position": 1,
    "text": "بدیدم کمان و بر و شست اوی"
  },
  {
    "poem_id": 1602,
    "vorder": 145,
    "position": 0,
    "text": "سوی چاره گشتم ز بیچارگی"
  },
  {
    "poem_id": 1602,
    "vorder": 146,
    "position": 1,
    "text": "بدادم بدو سر به یکبارگی"
  },
  {
    "poem_id": 1602,
    "vorder": 147,
    "position": 0,
    "text": "زمان ورا در کمان ساختم"
  },
  {
    "poem_id": 1602,
    "vorder": 148,
    "position": 1,
    "text": "چو روزش سرآمد بینداختم"
  },
  {
    "poem_id": 1602,
    "vorder": 149,
    "position": 0,
    "text": "گر او را همی روز باز آمدی"
  },
  {
    "poem_id": 1602,
    "vorder": 150,
    "position": 1,
    "text": "مرا کار گز کی فراز آمدی"
  },
  {
    "poem_id": 1602,
    "vorder": 151,
    "position": 0,
    "text": "ازین خاک تیره بباید شدن"
  },
  {
    "poem_id": 1602,
    "vorder": 152,
    "position": 1,
    "text": "به پرهیز یک دم نشاید زدن"
  },
  {
    "poem_id": 1602,
    "vorder": 153,
    "position": 0,
    "text": "همانست کز گز بهانه منم"
  },
  {
    "poem_id": 1602,
    "vorder": 154,
    "position": 1,
    "text": "وزین تیرگی در فسانه منم"
  }
]