[
  {
    "poem_id": 87987,
    "vorder": 1,
    "position": 0,
    "text": "خود و گیو و گودرز و چندی سران"
  },
  {
    "poem_id": 87987,
    "vorder": 2,
    "position": 1,
    "text": "نهادند بر یال گرزگران"
  },
  {
    "poem_id": 87987,
    "vorder": 3,
    "position": 0,
    "text": "بسوی سپهدار پیران شدند"
  },
  {
    "poem_id": 87987,
    "vorder": 4,
    "position": 1,
    "text": "چو آتش بقلب سپه بر زدند"
  },
  {
    "poem_id": 87987,
    "vorder": 5,
    "position": 0,
    "text": "چو دریای خون شد همه رزمگاه"
  },
  {
    "poem_id": 87987,
    "vorder": 6,
    "position": 1,
    "text": "خروشی برآمد بلند از سپاه"
  },
  {
    "poem_id": 87987,
    "vorder": 7,
    "position": 0,
    "text": "درفش سپهبد بدو نیم شد"
  },
  {
    "poem_id": 87987,
    "vorder": 8,
    "position": 1,
    "text": "دل رزمجویان پر از بیم شد"
  },
  {
    "poem_id": 87987,
    "vorder": 9,
    "position": 0,
    "text": "چو بشنید هومان خروش سپاه"
  },
  {
    "poem_id": 87987,
    "vorder": 10,
    "position": 1,
    "text": "نشست از بر تازی اسپی سیاه"
  },
  {
    "poem_id": 87987,
    "vorder": 11,
    "position": 0,
    "text": "بیامد ز لشکر بسی کشته دید"
  },
  {
    "poem_id": 87987,
    "vorder": 12,
    "position": 1,
    "text": "بسی بیهش از رزم برگشته دید"
  },
  {
    "poem_id": 87987,
    "vorder": 13,
    "position": 0,
    "text": "فرو ریخت از دیده خون بر برش"
  },
  {
    "poem_id": 87987,
    "vorder": 14,
    "position": 1,
    "text": "یکی بانگ زد تند بر لشکرش"
  },
  {
    "poem_id": 87987,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت کایدر طلایه نبود"
  },
  {
    "poem_id": 87987,
    "vorder": 16,
    "position": 1,
    "text": "شما را ز کین ایچ مایه نبود"
  },
  {
    "poem_id": 87987,
    "vorder": 17,
    "position": 0,
    "text": "بهر یک ازیشان ز ما سیصدست"
  },
  {
    "poem_id": 87987,
    "vorder": 18,
    "position": 1,
    "text": "به آوردگه خواب و خفتن بدست"
  },
  {
    "poem_id": 87987,
    "vorder": 19,
    "position": 0,
    "text": "هلا تیغ و گوپالها برکشید"
  },
  {
    "poem_id": 87987,
    "vorder": 20,
    "position": 1,
    "text": "سپرهای چینی بسر در کشید"
  },
  {
    "poem_id": 87987,
    "vorder": 21,
    "position": 0,
    "text": "ز هر سو بریشان بگیرید راه"
  },
  {
    "poem_id": 87987,
    "vorder": 22,
    "position": 1,
    "text": "کنون کز بره بر کشد تیغ ماه"
  },
  {
    "poem_id": 87987,
    "vorder": 23,
    "position": 0,
    "text": "رهایی نباید که یابند هیچ"
  },
  {
    "poem_id": 87987,
    "vorder": 24,
    "position": 1,
    "text": "بدین سان چه باید درنگ و بسیچ"
  },
  {
    "poem_id": 87987,
    "vorder": 25,
    "position": 0,
    "text": "برآمد خروشیدن کرنای"
  },
  {
    "poem_id": 87987,
    "vorder": 26,
    "position": 1,
    "text": "بهر سو برفتند گردان ز جای"
  },
  {
    "poem_id": 87987,
    "vorder": 27,
    "position": 0,
    "text": "گرفتندشان یکسر اندر میان"
  },
  {
    "poem_id": 87987,
    "vorder": 28,
    "position": 1,
    "text": "سواران ایران چو شیر ژیان"
  },
  {
    "poem_id": 87987,
    "vorder": 29,
    "position": 0,
    "text": "چنان آتش افروخت از ترگ و تیغ"
  },
  {
    "poem_id": 87987,
    "vorder": 30,
    "position": 1,
    "text": "که گفتی همی گرز بارد ز میغ"
  },
  {
    "poem_id": 87987,
    "vorder": 31,
    "position": 0,
    "text": "شب تار و شمشیر و گرد سپاه"
  },
  {
    "poem_id": 87987,
    "vorder": 32,
    "position": 1,
    "text": "ستاره نه پیدا نه تابنده ماه"
  },
  {
    "poem_id": 87987,
    "vorder": 33,
    "position": 0,
    "text": "ز جوشن تو گفتی ببار اندرند"
  },
  {
    "poem_id": 87987,
    "vorder": 34,
    "position": 1,
    "text": "ز تاری بدریای قار اندرند"
  },
  {
    "poem_id": 87987,
    "vorder": 35,
    "position": 0,
    "text": "بلشکر چنین گفت هومان که بس"
  },
  {
    "poem_id": 87987,
    "vorder": 36,
    "position": 1,
    "text": "ازین مهتران مفگنید ایچ کس"
  },
  {
    "poem_id": 87987,
    "vorder": 37,
    "position": 0,
    "text": "همه پیش من دستگیر آورید"
  },
  {
    "poem_id": 87987,
    "vorder": 38,
    "position": 1,
    "text": "نباید که خسته بتیر آورید"
  },
  {
    "poem_id": 87987,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت لشکر ببانگ بلند"
  },
  {
    "poem_id": 87987,
    "vorder": 40,
    "position": 1,
    "text": "که اکنون به بیچارگی دست بند"
  },
  {
    "poem_id": 87987,
    "vorder": 41,
    "position": 0,
    "text": "دهید ار بگرز و بژوپین دهید"
  },
  {
    "poem_id": 87987,
    "vorder": 42,
    "position": 1,
    "text": "سران را ز خون تاج بر سر نهید"
  },
  {
    "poem_id": 87987,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت با گیو و رهام طوس"
  },
  {
    "poem_id": 87987,
    "vorder": 44,
    "position": 1,
    "text": "که شد جان ما بی‌گمان بر فسوس"
  },
  {
    "poem_id": 87987,
    "vorder": 45,
    "position": 0,
    "text": "مگر کردگار سپهر بلند"
  },
  {
    "poem_id": 87987,
    "vorder": 46,
    "position": 1,
    "text": "رهاند تن و جان ما زین گزند"
  },
  {
    "poem_id": 87987,
    "vorder": 47,
    "position": 0,
    "text": "اگر نه بچنگ عقاب اندریم"
  },
  {
    "poem_id": 87987,
    "vorder": 48,
    "position": 1,
    "text": "وگر زیر دریای آب اندریم"
  },
  {
    "poem_id": 87987,
    "vorder": 49,
    "position": 0,
    "text": "یکی حمله بردند هر سه به هم"
  },
  {
    "poem_id": 87987,
    "vorder": 50,
    "position": 1,
    "text": "چو برخیزد از جای شیر دژم"
  },
  {
    "poem_id": 87987,
    "vorder": 51,
    "position": 0,
    "text": "ندیدند کس یال اسپ و عنان"
  },
  {
    "poem_id": 87987,
    "vorder": 52,
    "position": 1,
    "text": "ز تنگی بچشم اندر آمد سنان"
  },
  {
    "poem_id": 87987,
    "vorder": 53,
    "position": 0,
    "text": "چنین گفت هومان به آواز تیز"
  },
  {
    "poem_id": 87987,
    "vorder": 54,
    "position": 1,
    "text": "که نه جای جنگست و راه گریز"
  },
  {
    "poem_id": 87987,
    "vorder": 55,
    "position": 0,
    "text": "برانگیخت از جایتان بخت بد"
  },
  {
    "poem_id": 87987,
    "vorder": 56,
    "position": 1,
    "text": "که تا بر تن بدکنش بد رسد"
  },
  {
    "poem_id": 87987,
    "vorder": 57,
    "position": 0,
    "text": "سه جنگ آور و خوار مایه سپاه"
  },
  {
    "poem_id": 87987,
    "vorder": 58,
    "position": 1,
    "text": "بماندند یکسر بدین رزمگاه"
  },
  {
    "poem_id": 87987,
    "vorder": 59,
    "position": 0,
    "text": "فراوان ز رستم گرفتند یاد"
  },
  {
    "poem_id": 87987,
    "vorder": 60,
    "position": 1,
    "text": "کجا داد در جنگ هر جای داد"
  },
  {
    "poem_id": 87987,
    "vorder": 61,
    "position": 0,
    "text": "ز شیدوش، وز بیژن گستهم"
  },
  {
    "poem_id": 87987,
    "vorder": 62,
    "position": 1,
    "text": "بسی یاد کردند بر بیش و کم"
  },
  {
    "poem_id": 87987,
    "vorder": 63,
    "position": 0,
    "text": "که باری کسی را ز ایران سپاه"
  },
  {
    "poem_id": 87987,
    "vorder": 64,
    "position": 1,
    "text": "بدی یارمان اندرین رزمگاه"
  },
  {
    "poem_id": 87987,
    "vorder": 65,
    "position": 0,
    "text": "نه ایدر به پیکار و جنگ آمدیم"
  },
  {
    "poem_id": 87987,
    "vorder": 66,
    "position": 1,
    "text": "که خیره بکام نهنگ آمدیم"
  },
  {
    "poem_id": 87987,
    "vorder": 67,
    "position": 0,
    "text": "دریغ آن در و گاه شاه جهان"
  },
  {
    "poem_id": 87987,
    "vorder": 68,
    "position": 1,
    "text": "که گیرند ما را کنون ناگهان"
  },
  {
    "poem_id": 87987,
    "vorder": 69,
    "position": 0,
    "text": "تهمتن به زاولستانست و زال"
  },
  {
    "poem_id": 87987,
    "vorder": 70,
    "position": 1,
    "text": "شود کار ایران کنون تال و مال"
  },
  {
    "poem_id": 87987,
    "vorder": 71,
    "position": 0,
    "text": "همی آمد آوای گوپال و کوس"
  },
  {
    "poem_id": 87987,
    "vorder": 72,
    "position": 1,
    "text": "بلشکر همی دیر شد گیو و طوس"
  },
  {
    "poem_id": 87987,
    "vorder": 73,
    "position": 0,
    "text": "چنین گفت شیدوش و گستهم شیر"
  },
  {
    "poem_id": 87987,
    "vorder": 74,
    "position": 1,
    "text": "که شد کار پیکار سالار دیر"
  },
  {
    "poem_id": 87987,
    "vorder": 75,
    "position": 0,
    "text": "به بیژن گرازه همی گفت باز"
  },
  {
    "poem_id": 87987,
    "vorder": 76,
    "position": 1,
    "text": "که شد کار سالار لشکر دراز"
  },
  {
    "poem_id": 87987,
    "vorder": 77,
    "position": 0,
    "text": "هوا قیر گون و زمین آبنوس"
  },
  {
    "poem_id": 87987,
    "vorder": 78,
    "position": 1,
    "text": "همی آمد از دشت آوای کوس"
  },
  {
    "poem_id": 87987,
    "vorder": 79,
    "position": 0,
    "text": "برفتند گردان بر آوای اوی"
  },
  {
    "poem_id": 87987,
    "vorder": 80,
    "position": 1,
    "text": "ز خون بود بر دشت هر جای جوی"
  },
  {
    "poem_id": 87987,
    "vorder": 81,
    "position": 0,
    "text": "ز گردان نیو و ز نیروی چنگ"
  },
  {
    "poem_id": 87987,
    "vorder": 82,
    "position": 1,
    "text": "تو گفتی برآمد ز دریا نهنگ"
  },
  {
    "poem_id": 87987,
    "vorder": 83,
    "position": 0,
    "text": "بدانست هومان که آمد سوار"
  },
  {
    "poem_id": 87987,
    "vorder": 84,
    "position": 1,
    "text": "همه گرزور بود و شمشیردار"
  },
  {
    "poem_id": 87987,
    "vorder": 85,
    "position": 0,
    "text": "چو دانست کامد ورا یار طوس"
  },
  {
    "poem_id": 87987,
    "vorder": 86,
    "position": 1,
    "text": "همی برخروشید برسان کوس"
  },
  {
    "poem_id": 87987,
    "vorder": 87,
    "position": 0,
    "text": "سبک شد عنان و گران شد رکیب"
  },
  {
    "poem_id": 87987,
    "vorder": 88,
    "position": 1,
    "text": "بلندی که دانست باز از نشیب"
  },
  {
    "poem_id": 87987,
    "vorder": 89,
    "position": 0,
    "text": "یکی رزم کردند تا چاک روز"
  },
  {
    "poem_id": 87987,
    "vorder": 90,
    "position": 1,
    "text": "چو پیدا شد از چرخ گیتی فروز"
  },
  {
    "poem_id": 87987,
    "vorder": 91,
    "position": 0,
    "text": "سپه بازگشتند یکسر ز جنگ"
  },
  {
    "poem_id": 87987,
    "vorder": 92,
    "position": 1,
    "text": "کشیدند لشکر سوی کوه تنگ"
  },
  {
    "poem_id": 87987,
    "vorder": 93,
    "position": 0,
    "text": "بگردان چنین گفت سالار طوس"
  },
  {
    "poem_id": 87987,
    "vorder": 94,
    "position": 1,
    "text": "که از گردش مهر تا زخم کوس"
  },
  {
    "poem_id": 87987,
    "vorder": 95,
    "position": 0,
    "text": "سواری چنین کز شما دیده‌ام"
  },
  {
    "poem_id": 87987,
    "vorder": 96,
    "position": 1,
    "text": "ز کنداوران هیچ نشنیده‌ام"
  },
  {
    "poem_id": 87987,
    "vorder": 97,
    "position": 0,
    "text": "یکی نامه باید که زی شه کنیم"
  },
  {
    "poem_id": 87987,
    "vorder": 98,
    "position": 1,
    "text": "ز کارش همه جمله آگه کنیم"
  },
  {
    "poem_id": 87987,
    "vorder": 99,
    "position": 0,
    "text": "چو نامه بنزدیک خسرو رسد"
  },
  {
    "poem_id": 87987,
    "vorder": 100,
    "position": 1,
    "text": "بدلش اندرون آتشی نو رسد"
  },
  {
    "poem_id": 87987,
    "vorder": 101,
    "position": 0,
    "text": "بیاری بیاید گو پیلتن"
  },
  {
    "poem_id": 87987,
    "vorder": 102,
    "position": 1,
    "text": "ز شیران یکی نامدار انجمن"
  },
  {
    "poem_id": 87987,
    "vorder": 103,
    "position": 0,
    "text": "بپیروزی از رزم گردیم باز"
  },
  {
    "poem_id": 87987,
    "vorder": 104,
    "position": 1,
    "text": "بدیدار کیخسرو آید نیاز"
  },
  {
    "poem_id": 87987,
    "vorder": 105,
    "position": 0,
    "text": "سخن هرچ رفت آشکار و نهان"
  },
  {
    "poem_id": 87987,
    "vorder": 106,
    "position": 1,
    "text": "بگویم بپیروز شاه جهان"
  },
  {
    "poem_id": 87987,
    "vorder": 107,
    "position": 0,
    "text": "بخوبی و خشنودی شهریار"
  },
  {
    "poem_id": 87987,
    "vorder": 108,
    "position": 1,
    "text": "بباشد بکام شما روزگار"
  },
  {
    "poem_id": 87987,
    "vorder": 109,
    "position": 0,
    "text": "چنانچون که گفتند برساختند"
  },
  {
    "poem_id": 87987,
    "vorder": 110,
    "position": 1,
    "text": "نوندی بنزدیک شه تاختند"
  },
  {
    "poem_id": 87987,
    "vorder": 111,
    "position": 0,
    "text": "دو لشکر بخیمه فرود آمدند"
  },
  {
    "poem_id": 87987,
    "vorder": 112,
    "position": 1,
    "text": "ز پیکار یکباره دم برزدند"
  },
  {
    "poem_id": 87987,
    "vorder": 113,
    "position": 0,
    "text": "طلایه برون آمد از هر دو روی"
  },
  {
    "poem_id": 87987,
    "vorder": 114,
    "position": 1,
    "text": "بدشت از دلیران پرخاشجوی"
  },
  {
    "poem_id": 87987,
    "vorder": 115,
    "position": 0,
    "text": "چو هومان رسید اندران رزمگاه"
  },
  {
    "poem_id": 87987,
    "vorder": 116,
    "position": 1,
    "text": "ز کشته ندید ایچ بر دشت راه"
  },
  {
    "poem_id": 87987,
    "vorder": 117,
    "position": 0,
    "text": "به پیران چنین گفت کامروز گرد"
  },
  {
    "poem_id": 87987,
    "vorder": 118,
    "position": 1,
    "text": "نه بر آرزو گشت گاه نبرد"
  },
  {
    "poem_id": 87987,
    "vorder": 119,
    "position": 0,
    "text": "چو آسوده گردند گردان ما"
  },
  {
    "poem_id": 87987,
    "vorder": 120,
    "position": 1,
    "text": "ستوده سواران و مردان ما"
  },
  {
    "poem_id": 87987,
    "vorder": 121,
    "position": 0,
    "text": "یکی رزم سازم که خورشید و ماه"
  },
  {
    "poem_id": 87987,
    "vorder": 122,
    "position": 1,
    "text": "ندیدست هرگز چنان رزمگاه"
  }
]