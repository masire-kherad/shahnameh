[
  {
    "poem_id": 88078,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا پیش او شد دبیر"
  },
  {
    "poem_id": 88078,
    "vorder": 2,
    "position": 1,
    "text": "بیاورد قرطاس و چینی حریر"
  },
  {
    "poem_id": 88078,
    "vorder": 3,
    "position": 0,
    "text": "یکی نامه از قیر و مشک و گلاب"
  },
  {
    "poem_id": 88078,
    "vorder": 4,
    "position": 1,
    "text": "بفرمود در کار افراسیاب"
  },
  {
    "poem_id": 88078,
    "vorder": 5,
    "position": 0,
    "text": "چو شد خامه از مشک وز قیر تر"
  },
  {
    "poem_id": 88078,
    "vorder": 6,
    "position": 1,
    "text": "نخست آفرین کرد بر دادگر"
  },
  {
    "poem_id": 88078,
    "vorder": 7,
    "position": 0,
    "text": "که دارنده و بر سر آرنده اوست"
  },
  {
    "poem_id": 88078,
    "vorder": 8,
    "position": 1,
    "text": "زمین و زمان را نگارنده اوست"
  },
  {
    "poem_id": 88078,
    "vorder": 9,
    "position": 0,
    "text": "همو آفرینندهٔ پیل و مور"
  },
  {
    "poem_id": 88078,
    "vorder": 10,
    "position": 1,
    "text": "ز خاشاک تا آب دریای شور"
  },
  {
    "poem_id": 88078,
    "vorder": 11,
    "position": 0,
    "text": "همه با توانایی او یکیست"
  },
  {
    "poem_id": 88078,
    "vorder": 12,
    "position": 1,
    "text": "خداوند هست و خداوند نیست"
  },
  {
    "poem_id": 88078,
    "vorder": 13,
    "position": 0,
    "text": "کسی را که او پروراند به مهر"
  },
  {
    "poem_id": 88078,
    "vorder": 14,
    "position": 1,
    "text": "بر آن کس نگردد به تندی سپهر"
  },
  {
    "poem_id": 88078,
    "vorder": 15,
    "position": 0,
    "text": "از او باد بر شاه گیتی درود"
  },
  {
    "poem_id": 88078,
    "vorder": 16,
    "position": 1,
    "text": "کز او خیزد آرام را تار و پود"
  },
  {
    "poem_id": 88078,
    "vorder": 17,
    "position": 0,
    "text": "رسیدم بدین دژ که افراسیاب"
  },
  {
    "poem_id": 88078,
    "vorder": 18,
    "position": 1,
    "text": "همی داشت از بهر آرام و خواب"
  },
  {
    "poem_id": 88078,
    "vorder": 19,
    "position": 0,
    "text": "بدو اندرون بود تخت و کلاه"
  },
  {
    "poem_id": 88078,
    "vorder": 20,
    "position": 1,
    "text": "بزرگی و دیهیم و گنج و سپاه"
  },
  {
    "poem_id": 88078,
    "vorder": 21,
    "position": 0,
    "text": "چهل پیل ز ایشان همه بسته گشت"
  },
  {
    "poem_id": 88078,
    "vorder": 22,
    "position": 1,
    "text": "هر آن کس که برگشت تن خسته گشت"
  },
  {
    "poem_id": 88078,
    "vorder": 23,
    "position": 0,
    "text": "بگوید کنون گیو یک یک به شاه"
  },
  {
    "poem_id": 88078,
    "vorder": 24,
    "position": 1,
    "text": "سخن هرچه رفت اندر این رزمگاه"
  },
  {
    "poem_id": 88078,
    "vorder": 25,
    "position": 0,
    "text": "چو بر پیش یزدان گشایی دو لب"
  },
  {
    "poem_id": 88078,
    "vorder": 26,
    "position": 1,
    "text": "نیایش کن از بهر من روز و شب"
  },
  {
    "poem_id": 88078,
    "vorder": 27,
    "position": 0,
    "text": "کشیدیم لشکر به ماچین و چین"
  },
  {
    "poem_id": 88078,
    "vorder": 28,
    "position": 1,
    "text": "وز آن روی رانم به مکران زمین"
  },
  {
    "poem_id": 88078,
    "vorder": 29,
    "position": 0,
    "text": "وز آن پس بر آب زره بگذرم"
  },
  {
    "poem_id": 88078,
    "vorder": 30,
    "position": 1,
    "text": "اگر پای یزدان بود یاورم"
  },
  {
    "poem_id": 88078,
    "vorder": 31,
    "position": 0,
    "text": "ز پیش شهنشاه برگشت گیو"
  },
  {
    "poem_id": 88078,
    "vorder": 32,
    "position": 1,
    "text": "ابا لشکری گشن و مردان نیو"
  },
  {
    "poem_id": 88078,
    "vorder": 33,
    "position": 0,
    "text": "چو باد هوا گشت و ببرید راه"
  },
  {
    "poem_id": 88078,
    "vorder": 34,
    "position": 1,
    "text": "بیامد به نزدیک کاووس شاه"
  },
  {
    "poem_id": 88078,
    "vorder": 35,
    "position": 0,
    "text": "پس آگاهی آمد به کاووس کی"
  },
  {
    "poem_id": 88078,
    "vorder": 36,
    "position": 1,
    "text": "از آن پهلوان زادهٔ نیک پی"
  },
  {
    "poem_id": 88078,
    "vorder": 37,
    "position": 0,
    "text": "پذیره فرستاد چندی سپاه"
  },
  {
    "poem_id": 88078,
    "vorder": 38,
    "position": 1,
    "text": "گرانمایگان بر گرفتند راه"
  },
  {
    "poem_id": 88078,
    "vorder": 39,
    "position": 0,
    "text": "چو آمد بر شهر گیو دلیر"
  },
  {
    "poem_id": 88078,
    "vorder": 40,
    "position": 1,
    "text": "سپاهی ز گردان چو یک دشت شیر"
  },
  {
    "poem_id": 88078,
    "vorder": 41,
    "position": 0,
    "text": "چو گیو اندر آمد به نزدیک شاه"
  },
  {
    "poem_id": 88078,
    "vorder": 42,
    "position": 1,
    "text": "زمین را ببوسید بر پیش گاه"
  },
  {
    "poem_id": 88078,
    "vorder": 43,
    "position": 0,
    "text": "ورا دید کاووس بر پای جست"
  },
  {
    "poem_id": 88078,
    "vorder": 44,
    "position": 1,
    "text": "بخندید و بسترد رویش به دست"
  },
  {
    "poem_id": 88078,
    "vorder": 45,
    "position": 0,
    "text": "بپرسیدش از شهریار و سپاه"
  },
  {
    "poem_id": 88078,
    "vorder": 46,
    "position": 1,
    "text": "ز گردنده خورشید و تابنده ماه"
  },
  {
    "poem_id": 88078,
    "vorder": 47,
    "position": 0,
    "text": "بگفت آن کجا دید گیو سترگ"
  },
  {
    "poem_id": 88078,
    "vorder": 48,
    "position": 1,
    "text": "ز گردان وز شهریار بزرگ"
  },
  {
    "poem_id": 88078,
    "vorder": 49,
    "position": 0,
    "text": "جوان شد ز گفتار او مرد پیر"
  },
  {
    "poem_id": 88078,
    "vorder": 50,
    "position": 1,
    "text": "پس آن نامه بنهاد پیش دبیر"
  },
  {
    "poem_id": 88078,
    "vorder": 51,
    "position": 0,
    "text": "چو آن نامه بر شاه ایران بخواند"
  },
  {
    "poem_id": 88078,
    "vorder": 52,
    "position": 1,
    "text": "همه انجمن در شگفتی بماند"
  },
  {
    "poem_id": 88078,
    "vorder": 53,
    "position": 0,
    "text": "همه شاد گشتند و خرم شدند"
  },
  {
    "poem_id": 88078,
    "vorder": 54,
    "position": 1,
    "text": "ز شادی دو دیده پر از نم شدند"
  },
  {
    "poem_id": 88078,
    "vorder": 55,
    "position": 0,
    "text": "همه چیز دادند درویش را"
  },
  {
    "poem_id": 88078,
    "vorder": 56,
    "position": 1,
    "text": "بنفریده کردند بدکیش را"
  },
  {
    "poem_id": 88078,
    "vorder": 57,
    "position": 0,
    "text": "فرود آمد از تخت کاووس شاه"
  },
  {
    "poem_id": 88078,
    "vorder": 58,
    "position": 1,
    "text": "ز سر برگرفت آن کیانی کلاه"
  },
  {
    "poem_id": 88078,
    "vorder": 59,
    "position": 0,
    "text": "بیامد بغلتید بر تیره خاک"
  },
  {
    "poem_id": 88078,
    "vorder": 60,
    "position": 1,
    "text": "نیایش کنان پیش یزدان پاک"
  },
  {
    "poem_id": 88078,
    "vorder": 61,
    "position": 0,
    "text": "وز آن جایگه شد به جای نشست"
  },
  {
    "poem_id": 88078,
    "vorder": 62,
    "position": 1,
    "text": "به گرد دژ آیین شادی ببست"
  },
  {
    "poem_id": 88078,
    "vorder": 63,
    "position": 0,
    "text": "همی گفت با شاه گیو آنچه دید"
  },
  {
    "poem_id": 88078,
    "vorder": 64,
    "position": 1,
    "text": "سخن کز لب شاه ایران شنید"
  },
  {
    "poem_id": 88078,
    "vorder": 65,
    "position": 0,
    "text": "می آورد و رامشگران را بخواند"
  },
  {
    "poem_id": 88078,
    "vorder": 66,
    "position": 1,
    "text": "وز ایران نبرده سران را بخواند"
  },
  {
    "poem_id": 88078,
    "vorder": 67,
    "position": 0,
    "text": "ز هر گونه‌ای گفت و پاسخ شنید"
  },
  {
    "poem_id": 88078,
    "vorder": 68,
    "position": 1,
    "text": "چنین تا شب تیره اندر چمید"
  },
  {
    "poem_id": 88078,
    "vorder": 69,
    "position": 0,
    "text": "برفتند با شمع یاران ز پیش"
  },
  {
    "poem_id": 88078,
    "vorder": 70,
    "position": 1,
    "text": "دلش شاد و خرم به ایوان خویش"
  },
  {
    "poem_id": 88078,
    "vorder": 71,
    "position": 0,
    "text": "چو برزد خور از چرخ رخشان سنان"
  },
  {
    "poem_id": 88078,
    "vorder": 72,
    "position": 1,
    "text": "بپیچید شب گرد کرده عنان"
  },
  {
    "poem_id": 88078,
    "vorder": 73,
    "position": 0,
    "text": "تبیره بر آمد ز درگاه شاه"
  },
  {
    "poem_id": 88078,
    "vorder": 74,
    "position": 1,
    "text": "برفتند گردان بدان بارگاه"
  },
  {
    "poem_id": 88078,
    "vorder": 75,
    "position": 0,
    "text": "جهاندار پس گیو را پیش خواند"
  },
  {
    "poem_id": 88078,
    "vorder": 76,
    "position": 1,
    "text": "بر آن نامور تخت شاهی نشاند"
  },
  {
    "poem_id": 88078,
    "vorder": 77,
    "position": 0,
    "text": "بفرمود تا خواسته پیش برد"
  },
  {
    "poem_id": 88078,
    "vorder": 78,
    "position": 1,
    "text": "همان نامور سرفرازان گرد"
  },
  {
    "poem_id": 88078,
    "vorder": 79,
    "position": 0,
    "text": "همان بیگنه روی پوشیدگان"
  },
  {
    "poem_id": 88078,
    "vorder": 80,
    "position": 1,
    "text": "پس پرده اندر ستم دیدگان"
  },
  {
    "poem_id": 88078,
    "vorder": 81,
    "position": 0,
    "text": "همان جهن و گرسیوز بندسای"
  },
  {
    "poem_id": 88078,
    "vorder": 82,
    "position": 1,
    "text": "که او برد پای سیاوش ز جای"
  },
  {
    "poem_id": 88078,
    "vorder": 83,
    "position": 0,
    "text": "چو گرسیوز بدکنش را بدید"
  },
  {
    "poem_id": 88078,
    "vorder": 84,
    "position": 1,
    "text": "بر او کرد نفرین که نفرین سزید"
  },
  {
    "poem_id": 88078,
    "vorder": 85,
    "position": 0,
    "text": "همان جهن را پای کرده به بند"
  },
  {
    "poem_id": 88078,
    "vorder": 86,
    "position": 1,
    "text": "ببردند نزدیک تخت بلند"
  },
  {
    "poem_id": 88078,
    "vorder": 87,
    "position": 0,
    "text": "بدان دختران رد افراسیاب"
  },
  {
    "poem_id": 88078,
    "vorder": 88,
    "position": 1,
    "text": "نگه کرد کاووس مژگان پر آب"
  },
  {
    "poem_id": 88078,
    "vorder": 89,
    "position": 0,
    "text": "پس پردهٔ شاهشان جای کرد"
  },
  {
    "poem_id": 88078,
    "vorder": 90,
    "position": 1,
    "text": "همانگه پرستنده بر پای کرد"
  },
  {
    "poem_id": 88078,
    "vorder": 91,
    "position": 0,
    "text": "اسیران و آن کس که بود از نوا"
  },
  {
    "poem_id": 88078,
    "vorder": 92,
    "position": 1,
    "text": "بیاراست مر هر یکی را جدا"
  },
  {
    "poem_id": 88078,
    "vorder": 93,
    "position": 0,
    "text": "یکی را نگهبان یکی را به بند"
  },
  {
    "poem_id": 88078,
    "vorder": 94,
    "position": 1,
    "text": "ببردند از پیش شاه بلند"
  },
  {
    "poem_id": 88078,
    "vorder": 95,
    "position": 0,
    "text": "از آن پس همه خواسته هرچه بود"
  },
  {
    "poem_id": 88078,
    "vorder": 96,
    "position": 1,
    "text": "ز دینار وز گوهر نابسود"
  },
  {
    "poem_id": 88078,
    "vorder": 97,
    "position": 0,
    "text": "به ارزانیان داد تا آفرین"
  },
  {
    "poem_id": 88078,
    "vorder": 98,
    "position": 1,
    "text": "بخوانند بر شاه ایران زمین"
  },
  {
    "poem_id": 88078,
    "vorder": 99,
    "position": 0,
    "text": "دگر بردگان مهتران را سپرد"
  },
  {
    "poem_id": 88078,
    "vorder": 100,
    "position": 1,
    "text": "به ایوان ببرد از بزرگان و خرد"
  },
  {
    "poem_id": 88078,
    "vorder": 101,
    "position": 0,
    "text": "بیاراستند از در جهن جای"
  },
  {
    "poem_id": 88078,
    "vorder": 102,
    "position": 1,
    "text": "خورش با پرستنده و رهنمای"
  },
  {
    "poem_id": 88078,
    "vorder": 103,
    "position": 0,
    "text": "به دژ بر یکی جای تاریک بود"
  },
  {
    "poem_id": 88078,
    "vorder": 104,
    "position": 1,
    "text": "ز دل دور با دخمه نزدیک بود"
  },
  {
    "poem_id": 88078,
    "vorder": 105,
    "position": 0,
    "text": "به گرسیوز آمد چنان جای بهر"
  },
  {
    "poem_id": 88078,
    "vorder": 106,
    "position": 1,
    "text": "چنینست کردار گردنده دهر"
  },
  {
    "poem_id": 88078,
    "vorder": 107,
    "position": 0,
    "text": "خنک آن کسی کو بود پادشا"
  },
  {
    "poem_id": 88078,
    "vorder": 108,
    "position": 1,
    "text": "کفی راد دارد دلی پارسا"
  },
  {
    "poem_id": 88078,
    "vorder": 109,
    "position": 0,
    "text": "بداند که گیتی بر او بگذرد"
  },
  {
    "poem_id": 88078,
    "vorder": 110,
    "position": 1,
    "text": "نگردد به گرد در بی خرد"
  },
  {
    "poem_id": 88078,
    "vorder": 111,
    "position": 0,
    "text": "خرد چون شود از دو دیده سرشک"
  },
  {
    "poem_id": 88078,
    "vorder": 112,
    "position": 1,
    "text": "چنان هم که دیوانه خواهد پزشک"
  },
  {
    "poem_id": 88078,
    "vorder": 113,
    "position": 0,
    "text": "از آن پس کز ایشان بپردخت شاه"
  },
  {
    "poem_id": 88078,
    "vorder": 114,
    "position": 1,
    "text": "ز بیگانه مردم تهی کرد گاه"
  },
  {
    "poem_id": 88078,
    "vorder": 115,
    "position": 0,
    "text": "نویسنده آهنگ قرطاس کرد"
  },
  {
    "poem_id": 88078,
    "vorder": 116,
    "position": 1,
    "text": "سر خامه بر سان الماس کرد"
  },
  {
    "poem_id": 88078,
    "vorder": 117,
    "position": 0,
    "text": "نبشتند نامه به هر کشوری"
  },
  {
    "poem_id": 88078,
    "vorder": 118,
    "position": 1,
    "text": "به هر نامداری و هر مهتری"
  },
  {
    "poem_id": 88078,
    "vorder": 119,
    "position": 0,
    "text": "که شد ترک و چین شاه را یکسره"
  },
  {
    "poem_id": 88078,
    "vorder": 120,
    "position": 1,
    "text": "به آبشخور آمد پلنگ و بره"
  },
  {
    "poem_id": 88078,
    "vorder": 121,
    "position": 0,
    "text": "درم داد و دینار درویش را"
  },
  {
    "poem_id": 88078,
    "vorder": 122,
    "position": 1,
    "text": "پراگنده و مردم خویش را"
  },
  {
    "poem_id": 88078,
    "vorder": 123,
    "position": 0,
    "text": "به دو هفته در پیش درگاه شاه"
  },
  {
    "poem_id": 88078,
    "vorder": 124,
    "position": 1,
    "text": "از انبوه بخشش ندیدند راه"
  },
  {
    "poem_id": 88078,
    "vorder": 125,
    "position": 0,
    "text": "سیم هفته بر جایگاه مهی"
  },
  {
    "poem_id": 88078,
    "vorder": 126,
    "position": 1,
    "text": "نشست اندر آرام با فرهی"
  },
  {
    "poem_id": 88078,
    "vorder": 127,
    "position": 0,
    "text": "ز بس نالهٔ نای و بانگ سرود"
  },
  {
    "poem_id": 88078,
    "vorder": 128,
    "position": 1,
    "text": "همی داد گل جام می را درود"
  },
  {
    "poem_id": 88078,
    "vorder": 129,
    "position": 0,
    "text": "به یک هفته از کاخ کاووس کی"
  },
  {
    "poem_id": 88078,
    "vorder": 130,
    "position": 1,
    "text": "همی موج برخاست از جام می"
  },
  {
    "poem_id": 88078,
    "vorder": 131,
    "position": 0,
    "text": "سر ماه نو خلعت گیو ساخت"
  },
  {
    "poem_id": 88078,
    "vorder": 132,
    "position": 1,
    "text": "همی زر و پیروزه اندر نشاخت"
  },
  {
    "poem_id": 88078,
    "vorder": 133,
    "position": 0,
    "text": "طبق‌های زرین و پیروزه جام"
  },
  {
    "poem_id": 88078,
    "vorder": 134,
    "position": 1,
    "text": "کمرهای زرین و زرین ستام"
  },
  {
    "poem_id": 88078,
    "vorder": 135,
    "position": 0,
    "text": "پرستار با طوق و با گوشوار"
  },
  {
    "poem_id": 88078,
    "vorder": 136,
    "position": 1,
    "text": "همان یاره و تاج گوهر نگار"
  },
  {
    "poem_id": 88078,
    "vorder": 137,
    "position": 0,
    "text": "همان جامهٔ تخت و افگندنی"
  },
  {
    "poem_id": 88078,
    "vorder": 138,
    "position": 1,
    "text": "ز رنگ و ز بو وز پراگندنی"
  },
  {
    "poem_id": 88078,
    "vorder": 139,
    "position": 0,
    "text": "فرستاد تا گیو را خواندند"
  },
  {
    "poem_id": 88078,
    "vorder": 140,
    "position": 1,
    "text": "بر اورنگ زرینش بنشاندند"
  },
  {
    "poem_id": 88078,
    "vorder": 141,
    "position": 0,
    "text": "ببردند خلعت به نزدیک اوی"
  },
  {
    "poem_id": 88078,
    "vorder": 142,
    "position": 1,
    "text": "بمالید گیو اندر آن تخت روی"
  }
