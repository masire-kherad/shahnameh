[
  {
    "poem_id": 1328,
    "vorder": 1,
    "position": 0,
    "text": "سخن هر چه گویم همه گفته‌اند"
  },
  {
    "poem_id": 1328,
    "vorder": 2,
    "position": 1,
    "text": "بَرِ باغِ دانش همه رُفته‌اند"
  },
  {
    "poem_id": 1328,
    "vorder": 3,
    "position": 0,
    "text": "اگر بر درختِ برومند جای"
  },
  {
    "poem_id": 1328,
    "vorder": 4,
    "position": 1,
    "text": "نیابم که از بَر شدن نیست رای"
  },
  {
    "poem_id": 1328,
    "vorder": 5,
    "position": 0,
    "text": "کسی کو شَوَد زیرِ نخلِ بلند"
  },
  {
    "poem_id": 1328,
    "vorder": 6,
    "position": 1,
    "text": "همان سایه ز او بازدارَد گَزَند"
  },
  {
    "poem_id": 1328,
    "vorder": 7,
    "position": 0,
    "text": "توانم مگر پایه‌ای ساختن"
  },
  {
    "poem_id": 1328,
    "vorder": 8,
    "position": 1,
    "text": "بَرِ شاخِ آن سروِ سایه فکن"
  },
  {
    "poem_id": 1328,
    "vorder": 9,
    "position": 0,
    "text": "کز این ناموَر نامهٔ شهریار"
  },
  {
    "poem_id": 1328,
    "vorder": 10,
    "position": 1,
    "text": "به گیتی بمانم یکی یادگار"
  },
  {
    "poem_id": 1328,
    "vorder": 11,
    "position": 0,
    "text": "تو این را دروغ و فَسانه مَدان"
  },
  {
    "poem_id": 1328,
    "vorder": 12,
    "position": 1,
    "text": "به رنگِ فُسون و بهانه مَدان"
  },
  {
    "poem_id": 1328,
    "vorder": 13,
    "position": 0,
    "text": "از او هر چه اندر خورَد با خِرَد"
  },
  {
    "poem_id": 1328,
    "vorder": 14,
    "position": 1,
    "text": "دگر بَر رَهِ رمز و معنی بَرَد"
  },
  {
    "poem_id": 1328,
    "vorder": 15,
    "position": 0,
    "text": "یکی نامه بود از گَهِ باستان"
  },
  {
    "poem_id": 1328,
    "vorder": 16,
    "position": 1,
    "text": "فراوان بِدو اندرون داستان"
  },
  {
    "poem_id": 1328,
    "vorder": 17,
    "position": 0,
    "text": "پراگَنده دَر دستِ هَر موبَدی"
  },
  {
    "poem_id": 1328,
    "vorder": 18,
    "position": 1,
    "text": "از او بَهره‌ای نزدِ هَر بِخرَدی"
  },
  {
    "poem_id": 1328,
    "vorder": 19,
    "position": 0,
    "text": "یکی پهلوان بود دهقان‌نژاد"
  },
  {
    "poem_id": 1328,
    "vorder": 20,
    "position": 1,
    "text": "دلیر و بزرگ و خردمند و راد"
  },
  {
    "poem_id": 1328,
    "vorder": 21,
    "position": 0,
    "text": "پژوهندهٔ روزگارِ نَخُست"
  },
  {
    "poem_id": 1328,
    "vorder": 22,
    "position": 1,
    "text": "گذشته سخن‌ها همه باز جُست"
  },
  {
    "poem_id": 1328,
    "vorder": 23,
    "position": 0,
    "text": "زِ هر کشوری موبَدی سال‌خَرد"
  },
  {
    "poem_id": 1328,
    "vorder": 24,
    "position": 1,
    "text": "بیاورد کاین نامه را یاد کرد"
  },
  {
    "poem_id": 1328,
    "vorder": 25,
    "position": 0,
    "text": "بپرسیدشان از کیانِ جهان"
  },
  {
    "poem_id": 1328,
    "vorder": 26,
    "position": 1,
    "text": "وزان نامدارانِ فرخ مَهان"
  },
  {
    "poem_id": 1328,
    "vorder": 27,
    "position": 0,
    "text": "که گیتی به آغاز چون داشتند"
  },
  {
    "poem_id": 1328,
    "vorder": 28,
    "position": 1,
    "text": "که ایدون به ما خوار بگذاشتند"
  },
  {
    "poem_id": 1328,
    "vorder": 29,
    "position": 0,
    "text": "چگونه سَر آمد به نیک اختری"
  },
  {
    "poem_id": 1328,
    "vorder": 30,
    "position": 1,
    "text": "بر ایشان همه روزِ کُندآوری"
  },
  {
    "poem_id": 1328,
    "vorder": 31,
    "position": 0,
    "text": "بگفتند پیشَش یکایک مَهان"
  },
  {
    "poem_id": 1328,
    "vorder": 32,
    "position": 1,
    "text": "سخن‌های شاهان و گشتِ جهان"
  },
  {
    "poem_id": 1328,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید از ایشان سِپَهبَد سَخُن"
  },
  {
    "poem_id": 1328,
    "vorder": 34,
    "position": 1,
    "text": "یکی ناموَر نامه اَفکند بُن"
  },
  {
    "poem_id": 1328,
    "vorder": 35,
    "position": 0,
    "text": "چنین یادگاری شد اندر جهان"
  },
  {
    "poem_id": 1328,
    "vorder": 36,
    "position": 1,
    "text": "بر او آفرین از کهان و مهان"
  }
]