[
  {
    "poem_id": 1769,
    "vorder": 1,
    "position": 0,
    "text": "چو بهرام و خسرو به هامون شدند"
  },
  {
    "poem_id": 1769,
    "vorder": 2,
    "position": 1,
    "text": "بر شیر با دل پر از خون شدند"
  },
  {
    "poem_id": 1769,
    "vorder": 3,
    "position": 0,
    "text": "چو خسرو بدید آن دو شیر ژیان"
  },
  {
    "poem_id": 1769,
    "vorder": 4,
    "position": 1,
    "text": "نهاده یکی افسر اندر میان"
  },
  {
    "poem_id": 1769,
    "vorder": 5,
    "position": 0,
    "text": "بدان موبدان گفت تاج از نخست"
  },
  {
    "poem_id": 1769,
    "vorder": 6,
    "position": 1,
    "text": "مر آن را سزاتر که شاهی بجست"
  },
  {
    "poem_id": 1769,
    "vorder": 7,
    "position": 0,
    "text": "و دیگر که من پیرم و او جوان"
  },
  {
    "poem_id": 1769,
    "vorder": 8,
    "position": 1,
    "text": "به چنگال شیر ژیان ناتوان"
  },
  {
    "poem_id": 1769,
    "vorder": 9,
    "position": 0,
    "text": "بران بد که او پیش‌دستی کند"
  },
  {
    "poem_id": 1769,
    "vorder": 10,
    "position": 1,
    "text": "به برنایی و تن‌درستی کند"
  },
  {
    "poem_id": 1769,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت بهرام کری رواست"
  },
  {
    "poem_id": 1769,
    "vorder": 12,
    "position": 1,
    "text": "نهانی نداریم گفتار راست"
  },
  {
    "poem_id": 1769,
    "vorder": 13,
    "position": 0,
    "text": "یکی گُرزه گاوسر برگرفت"
  },
  {
    "poem_id": 1769,
    "vorder": 14,
    "position": 1,
    "text": "جهانی بدو مانده اندر شگفت"
  },
  {
    "poem_id": 1769,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت موبد که ای پادشا"
  },
  {
    "poem_id": 1769,
    "vorder": 16,
    "position": 1,
    "text": "خردمند و بادانش و پارسا"
  },
  {
    "poem_id": 1769,
    "vorder": 17,
    "position": 0,
    "text": "همی جنگ شیران که فرمایدت"
  },
  {
    "poem_id": 1769,
    "vorder": 18,
    "position": 1,
    "text": "جز از تاج شاهی چه افزایدت"
  },
  {
    "poem_id": 1769,
    "vorder": 19,
    "position": 0,
    "text": "تو جان از پی پادشاهی مده"
  },
  {
    "poem_id": 1769,
    "vorder": 20,
    "position": 1,
    "text": "خورش بی‌بهانه به ماهی مده"
  },
  {
    "poem_id": 1769,
    "vorder": 21,
    "position": 0,
    "text": "همه بی‌گناهیم و این کار تست"
  },
  {
    "poem_id": 1769,
    "vorder": 22,
    "position": 1,
    "text": "جهان را همه دل به بازار تست"
  },
  {
    "poem_id": 1769,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت بهرام کای دین‌پژوه"
  },
  {
    "poem_id": 1769,
    "vorder": 24,
    "position": 1,
    "text": "تو زین بی‌گناهی و دیگر گروه"
  },
  {
    "poem_id": 1769,
    "vorder": 25,
    "position": 0,
    "text": "هم‌آورد این نره شیران منم"
  },
  {
    "poem_id": 1769,
    "vorder": 26,
    "position": 1,
    "text": "خریدار جنگ دلیران منم"
  },
  {
    "poem_id": 1769,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت موبد به یزدان پناه"
  },
  {
    "poem_id": 1769,
    "vorder": 28,
    "position": 1,
    "text": "چو رفتی دلت را بشوی از گناه"
  },
  {
    "poem_id": 1769,
    "vorder": 29,
    "position": 0,
    "text": "چنان کرد کو گفت بهرامشاه"
  },
  {
    "poem_id": 1769,
    "vorder": 30,
    "position": 1,
    "text": "دلش پاک شد توبه کرد از گناه"
  },
  {
    "poem_id": 1769,
    "vorder": 31,
    "position": 0,
    "text": "همی رفت با گُرزهٔ گاوروی"
  },
  {
    "poem_id": 1769,
    "vorder": 32,
    "position": 1,
    "text": "چو دیدند شیران پرخاشجوی"
  },
  {
    "poem_id": 1769,
    "vorder": 33,
    "position": 0,
    "text": "یکی زود زنجیر بگسست و بند"
  },
  {
    "poem_id": 1769,
    "vorder": 34,
    "position": 1,
    "text": "بیامد بر شهریار بلند"
  },
  {
    "poem_id": 1769,
    "vorder": 35,
    "position": 0,
    "text": "بزد بر سرش گُرز بهرام گُرد"
  },
  {
    "poem_id": 1769,
    "vorder": 36,
    "position": 1,
    "text": "ز چشمش همی روشنایی ببرد"
  },
  {
    "poem_id": 1769,
    "vorder": 37,
    "position": 0,
    "text": "بر دیگر آمد بزد بر سرش"
  },
  {
    "poem_id": 1769,
    "vorder": 38,
    "position": 1,
    "text": "فرو ریخت از دیده خون از برش"
  },
  {
    "poem_id": 1769,
    "vorder": 39,
    "position": 0,
    "text": "جهاندار بنشست بر تخت عاج"
  },
  {
    "poem_id": 1769,
    "vorder": 40,
    "position": 1,
    "text": "به سر بر نهاد آن دلفروز تاج"
  },
  {
    "poem_id": 1769,
    "vorder": 41,
    "position": 0,
    "text": "به یزدان پناهید کو بد پناه"
  },
  {
    "poem_id": 1769,
    "vorder": 42,
    "position": 1,
    "text": "نمایندهٔ راه گم کرده راه"
  },
  {
    "poem_id": 1769,
    "vorder": 43,
    "position": 0,
    "text": "بشد خسرو و برد پیشش نماز"
  },
  {
    "poem_id": 1769,
    "vorder": 44,
    "position": 1,
    "text": "چنین گفت کای شاه گردن‌فراز"
  },
  {
    "poem_id": 1769,
    "vorder": 45,
    "position": 0,
    "text": "نشست تو بر گاه فرخنده باد"
  },
  {
    "poem_id": 1769,
    "vorder": 46,
    "position": 1,
    "text": "یلان جهان پیش تو بنده باد"
  },
  {
    "poem_id": 1769,
    "vorder": 47,
    "position": 0,
    "text": "تو شاهی و ما بندگان توایم"
  },
  {
    "poem_id": 1769,
    "vorder": 48,
    "position": 1,
    "text": "به خوبی فزایندگان توایم"
  },
  {
    "poem_id": 1769,
    "vorder": 49,
    "position": 0,
    "text": "بزرگان برو گوهر افشاندند"
  },
  {
    "poem_id": 1769,
    "vorder": 50,
    "position": 1,
    "text": "بران تاج نو آفرین خواندند"
  },
  {
    "poem_id": 1769,
    "vorder": 51,
    "position": 0,
    "text": "ز گیتی برآمد سراسر خروش"
  },
  {
    "poem_id": 1769,
    "vorder": 52,
    "position": 1,
    "text": "در آذر بد این جشن روز سروش"
  },
  {
    "poem_id": 1769,
    "vorder": 53,
    "position": 0,
    "text": "برآمد یکی ابر و شد تیره‌ماه"
  },
  {
    "poem_id": 1769,
    "vorder": 54,
    "position": 1,
    "text": "همی تیر بارید ز ابر سیاه"
  },
  {
    "poem_id": 1769,
    "vorder": 55,
    "position": 0,
    "text": "نه دریا پدید و نه دشت و نه راغ"
  },
  {
    "poem_id": 1769,
    "vorder": 56,
    "position": 1,
    "text": "نبینم همی در هوا پر زاغ"
  },
  {
    "poem_id": 1769,
    "vorder": 57,
    "position": 0,
    "text": "حواصل فشاند هوا هر زمان"
  },
  {
    "poem_id": 1769,
    "vorder": 58,
    "position": 1,
    "text": "چه سازد همی زین بلند آسمان"
  },
  {
    "poem_id": 1769,
    "vorder": 59,
    "position": 0,
    "text": "نماندم نمکسود و هیزم نه جو"
  },
  {
    "poem_id": 1769,
    "vorder": 60,
    "position": 1,
    "text": "نه چیزی پدیدست تا جودرو"
  },
  {
    "poem_id": 1769,
    "vorder": 61,
    "position": 0,
    "text": "بدین تیرگی روز و بیم خراج"
  },
  {
    "poem_id": 1769,
    "vorder": 62,
    "position": 1,
    "text": "زمین گشته از برف چون کوه عاج"
  },
  {
    "poem_id": 1769,
    "vorder": 63,
    "position": 0,
    "text": "همه کارها را سراندر نشیب"
  },
  {
    "poem_id": 1769,
    "vorder": 64,
    "position": 1,
    "text": "مگر دست گیرد حسین قتیب"
  },
  {
    "poem_id": 1769,
    "vorder": 65,
    "position": 0,
    "text": "کنون داستانی بگویم شگفت"
  },
  {
    "poem_id": 1769,
    "vorder": 66,
    "position": 1,
    "text": "کزان برتر اندازه نتوان گرفت"
  }
]