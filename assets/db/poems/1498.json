[
  {
    "poem_id": 1498,
    "vorder": 1,
    "position": 0,
    "text": "سواران گزین کرد پیران هزار"
  },
  {
    "poem_id": 1498,
    "vorder": 2,
    "position": 1,
    "text": "همه جنگجوی و همه نامدار"
  },
  {
    "poem_id": 1498,
    "vorder": 3,
    "position": 0,
    "text": "بدیشان چنین گفت پیران که زود"
  },
  {
    "poem_id": 1498,
    "vorder": 4,
    "position": 1,
    "text": "عنان تگاور بباید بسود"
  },
  {
    "poem_id": 1498,
    "vorder": 5,
    "position": 0,
    "text": "شب و روز رفتن چو شیر ژیان"
  },
  {
    "poem_id": 1498,
    "vorder": 6,
    "position": 1,
    "text": "نباید گشادن به ره بر میان"
  },
  {
    "poem_id": 1498,
    "vorder": 7,
    "position": 0,
    "text": "که گر گیو و خسرو به ایران شوند"
  },
  {
    "poem_id": 1498,
    "vorder": 8,
    "position": 1,
    "text": "زنان اندر ایران چه شیران شوند"
  },
  {
    "poem_id": 1498,
    "vorder": 9,
    "position": 0,
    "text": "نماند برین بوم و بر خاک و آب"
  },
  {
    "poem_id": 1498,
    "vorder": 10,
    "position": 1,
    "text": "وزین داغ دل گردد افراسیاب"
  },
  {
    "poem_id": 1498,
    "vorder": 11,
    "position": 0,
    "text": "به گفتار او سر برافراختند"
  },
  {
    "poem_id": 1498,
    "vorder": 12,
    "position": 1,
    "text": "شب و روز یکسر همی تاختند"
  },
  {
    "poem_id": 1498,
    "vorder": 13,
    "position": 0,
    "text": "نجستند روز و شب آرام و خواب"
  },
  {
    "poem_id": 1498,
    "vorder": 14,
    "position": 1,
    "text": "وزین آگهی شد به افراسیاب"
  },
  {
    "poem_id": 1498,
    "vorder": 15,
    "position": 0,
    "text": "چنین تا بیامد یکی ژرف رود"
  },
  {
    "poem_id": 1498,
    "vorder": 16,
    "position": 1,
    "text": "سپه شد پراگنده چون تار و پود"
  },
  {
    "poem_id": 1498,
    "vorder": 17,
    "position": 0,
    "text": "بنش ژرف و پهناش کوتاه بود"
  },
  {
    "poem_id": 1498,
    "vorder": 18,
    "position": 1,
    "text": "بدو بر به رفتن دژآگاه بود"
  },
  {
    "poem_id": 1498,
    "vorder": 19,
    "position": 0,
    "text": "نشسته فرنگیس بر پاس گاه"
  },
  {
    "poem_id": 1498,
    "vorder": 20,
    "position": 1,
    "text": "به دیگر کران خفته بد گیو و شاه"
  },
  {
    "poem_id": 1498,
    "vorder": 21,
    "position": 0,
    "text": "فرنگیس زان جایگه بنگرید"
  },
  {
    "poem_id": 1498,
    "vorder": 22,
    "position": 1,
    "text": "درفش سپهدار توران بدید"
  },
  {
    "poem_id": 1498,
    "vorder": 23,
    "position": 0,
    "text": "دوان شد بر گیو و آگاه کرد"
  },
  {
    "poem_id": 1498,
    "vorder": 24,
    "position": 1,
    "text": "بران خفتگان خواب کوتاه کرد"
  },
  {
    "poem_id": 1498,
    "vorder": 25,
    "position": 0,
    "text": "بدو گفت کای مرد با رنج خیز"
  },
  {
    "poem_id": 1498,
    "vorder": 26,
    "position": 1,
    "text": "که آمد ترا روزگار گریز"
  },
  {
    "poem_id": 1498,
    "vorder": 27,
    "position": 0,
    "text": "ترا گر بیابند بیجان کنند"
  },
  {
    "poem_id": 1498,
    "vorder": 28,
    "position": 1,
    "text": "دل ما ز درد تو پیچان کنند"
  },
  {
    "poem_id": 1498,
    "vorder": 29,
    "position": 0,
    "text": "مرا با پسر دیده گردد پرآب"
  },
  {
    "poem_id": 1498,
    "vorder": 30,
    "position": 1,
    "text": "برد بسته تا پیش افراسیاب"
  },
  {
    "poem_id": 1498,
    "vorder": 31,
    "position": 0,
    "text": "وزان پس ندانم چه آید گزند"
  },
  {
    "poem_id": 1498,
    "vorder": 32,
    "position": 1,
    "text": "نداند کسی راز چرخ بلند"
  },
  {
    "poem_id": 1498,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت گیو ای مه بانوان"
  },
  {
    "poem_id": 1498,
    "vorder": 34,
    "position": 1,
    "text": "چرا رنجه کردی بدینسان روان"
  },
  {
    "poem_id": 1498,
    "vorder": 35,
    "position": 0,
    "text": "تو با شاه برشو به بالای تند"
  },
  {
    "poem_id": 1498,
    "vorder": 36,
    "position": 1,
    "text": "ز پیران و لشکر مشو هیچ کند"
  },
  {
    "poem_id": 1498,
    "vorder": 37,
    "position": 0,
    "text": "جهاندار پیروز یار منست"
  },
  {
    "poem_id": 1498,
    "vorder": 38,
    "position": 1,
    "text": "سر اختر اندر کنار منست"
  },
  {
    "poem_id": 1498,
    "vorder": 39,
    "position": 0,
    "text": "بدوگفت کیخسرو ای رزمساز"
  },
  {
    "poem_id": 1498,
    "vorder": 40,
    "position": 1,
    "text": "کنون بر تو بر کار من شد دراز"
  },
  {
    "poem_id": 1498,
    "vorder": 41,
    "position": 0,
    "text": "ز دام بلا یافتم من رها"
  },
  {
    "poem_id": 1498,
    "vorder": 42,
    "position": 1,
    "text": "تو چندین مشو در دم اژدها"
  },
  {
    "poem_id": 1498,
    "vorder": 43,
    "position": 0,
    "text": "به هامون مرارفت باید کنون"
  },
  {
    "poem_id": 1498,
    "vorder": 44,
    "position": 1,
    "text": "فشاندن به شمشیر بر شید خون"
  },
  {
    "poem_id": 1498,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت گیو ای شه سرفراز"
  },
  {
    "poem_id": 1498,
    "vorder": 46,
    "position": 1,
    "text": "جهان را به نام تو آمد نیاز"
  },
  {
    "poem_id": 1498,
    "vorder": 47,
    "position": 0,
    "text": "پدر پهلوانست و من پهلوان"
  },
  {
    "poem_id": 1498,
    "vorder": 48,
    "position": 1,
    "text": "به شاهی نپیچیم جان و روان"
  },
  {
    "poem_id": 1498,
    "vorder": 49,
    "position": 0,
    "text": "برادر مرا هست هفتاد و هشت"
  },
  {
    "poem_id": 1498,
    "vorder": 50,
    "position": 1,
    "text": "جهان شد چو نام تو اندر گذشت"
  },
  {
    "poem_id": 1498,
    "vorder": 51,
    "position": 0,
    "text": "بسی پهلوانست شاه اندکی"
  },
  {
    "poem_id": 1498,
    "vorder": 52,
    "position": 1,
    "text": "چه باشد چو پیدا نباشد یکی"
  },
  {
    "poem_id": 1498,
    "vorder": 53,
    "position": 0,
    "text": "اگر من شوم کشته دیگر بود"
  },
  {
    "poem_id": 1498,
    "vorder": 54,
    "position": 1,
    "text": "سر تاجور باشد افسر بود"
  },
  {
    "poem_id": 1498,
    "vorder": 55,
    "position": 0,
    "text": "اگر تو شوی دور از ایدر تباه"
  },
  {
    "poem_id": 1498,
    "vorder": 56,
    "position": 1,
    "text": "نبینم کسی از در تاج و گاه"
  },
  {
    "poem_id": 1498,
    "vorder": 57,
    "position": 0,
    "text": "شود رنج من هفت ساله به باد"
  },
  {
    "poem_id": 1498,
    "vorder": 58,
    "position": 1,
    "text": "دگر آنک ننگ آورم بر نژاد"
  },
  {
    "poem_id": 1498,
    "vorder": 59,
    "position": 0,
    "text": "تو بالا گزین و سپه را ببین"
  },
  {
    "poem_id": 1498,
    "vorder": 60,
    "position": 1,
    "text": "مرا یاد باشد جهان آفرین"
  },
  {
    "poem_id": 1498,
    "vorder": 61,
    "position": 0,
    "text": "بپوشید درع و بیامد چو شیر"
  },
  {
    "poem_id": 1498,
    "vorder": 62,
    "position": 1,
    "text": "همان باره دستکش را به زیر"
  },
  {
    "poem_id": 1498,
    "vorder": 63,
    "position": 0,
    "text": "ازین سوی شه بود ز آنسو سپاه"
  },
  {
    "poem_id": 1498,
    "vorder": 64,
    "position": 1,
    "text": "میانچی شده رود و بر بسته راه"
  },
  {
    "poem_id": 1498,
    "vorder": 65,
    "position": 0,
    "text": "چو رعد بهاران بغرید گیو"
  },
  {
    "poem_id": 1498,
    "vorder": 66,
    "position": 1,
    "text": "ز سالار لشکر همی جست نیو"
  },
  {
    "poem_id": 1498,
    "vorder": 67,
    "position": 0,
    "text": "چو بشنید پیرانش دشنام داد"
  },
  {
    "poem_id": 1498,
    "vorder": 68,
    "position": 1,
    "text": "بدو گفت کای بد رگ دیوزاد"
  },
  {
    "poem_id": 1498,
    "vorder": 69,
    "position": 0,
    "text": "چو تنها بدین رزمگاه آمدی"
  },
  {
    "poem_id": 1498,
    "vorder": 70,
    "position": 1,
    "text": "دلاور به پیش سپاه آمدی"
  },
  {
    "poem_id": 1498,
    "vorder": 71,
    "position": 0,
    "text": "کنون خوردنت نوک ژوپین بود"
  },
  {
    "poem_id": 1498,
    "vorder": 72,
    "position": 1,
    "text": "برت را کفن چنگ شاهین بود"
  },
  {
    "poem_id": 1498,
    "vorder": 73,
    "position": 0,
    "text": "اگر کوه آهن بود یک سوار"
  },
  {
    "poem_id": 1498,
    "vorder": 74,
    "position": 1,
    "text": "چو مور اندر آید به گردش هزار"
  },
  {
    "poem_id": 1498,
    "vorder": 75,
    "position": 0,
    "text": "شود خیره سر گرچه خردست مور"
  },
  {
    "poem_id": 1498,
    "vorder": 76,
    "position": 1,
    "text": "نه مورست پوشیده مرد و ستور"
  },
  {
    "poem_id": 1498,
    "vorder": 77,
    "position": 0,
    "text": "کنند این زره بر تنش چاک چاک"
  },
  {
    "poem_id": 1498,
    "vorder": 78,
    "position": 1,
    "text": "چو مردار گردد کشندش به خاک"
  },
  {
    "poem_id": 1498,
    "vorder": 79,
    "position": 0,
    "text": "یکی داستان زد هژبر دمان"
  },
  {
    "poem_id": 1498,
    "vorder": 80,
    "position": 1,
    "text": "که چون بر گوزنی سرآید زمان"
  },
  {
    "poem_id": 1498,
    "vorder": 81,
    "position": 0,
    "text": "زمانه برو دم همی بشمرد"
  },
  {
    "poem_id": 1498,
    "vorder": 82,
    "position": 1,
    "text": "بیاید دمان پیش من بگذرد"
  },
  {
    "poem_id": 1498,
    "vorder": 83,
    "position": 0,
    "text": "زمان آوریدت کنون پیش من"
  },
  {
    "poem_id": 1498,
    "vorder": 84,
    "position": 1,
    "text": "همان پیش این نامدار انجمن"
  },
  {
    "poem_id": 1498,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت گیو ای سپهدار شیر"
  },
  {
    "poem_id": 1498,
    "vorder": 86,
    "position": 1,
    "text": "سزد گر به آب اندر آیی دلیر"
  },
  {
    "poem_id": 1498,
    "vorder": 87,
    "position": 0,
    "text": "ببینی کزین پرهنر یک سوار"
  },
  {
    "poem_id": 1498,
    "vorder": 88,
    "position": 1,
    "text": "چه آید ترا بر سر ای نامدار"
  },
  {
    "poem_id": 1498,
    "vorder": 89,
    "position": 0,
    "text": "هزارید و من نامور یک دلیر"
  },
  {
    "poem_id": 1498,
    "vorder": 90,
    "position": 1,
    "text": "سر سرکشان اندر آرم به زیر"
  },
  {
    "poem_id": 1498,
    "vorder": 91,
    "position": 0,
    "text": "چو من گُرزهٔ سرگرای آورم"
  },
  {
    "poem_id": 1498,
    "vorder": 92,
    "position": 1,
    "text": "سران را همه زیر پای آورم"
  },
  {
    "poem_id": 1498,
    "vorder": 93,
    "position": 0,
    "text": "چو بشنید پیران برآورد خشم"
  },
  {
    "poem_id": 1498,
    "vorder": 94,
    "position": 1,
    "text": "دلش گشت پرخون و پرآب چشم"
  },
  {
    "poem_id": 1498,
    "vorder": 95,
    "position": 0,
    "text": "برانگیخت اسپ و بیفشارد ران"
  },
  {
    "poem_id": 1498,
    "vorder": 96,
    "position": 1,
    "text": "به گردن برآورد گُرز گران"
  },
  {
    "poem_id": 1498,
    "vorder": 97,
    "position": 0,
    "text": "چو کشتی ز دشت اندر آمد به رود"
  },
  {
    "poem_id": 1498,
    "vorder": 98,
    "position": 1,
    "text": "همی داد نیکی دهش را درود"
  },
  {
    "poem_id": 1498,
    "vorder": 99,
    "position": 0,
    "text": "نکرد ایچ گیو آزمون را شتاب"
  },
  {
    "poem_id": 1498,
    "vorder": 100,
    "position": 1,
    "text": "بدان تا برآمد سپهبد ز آب"
  },
  {
    "poem_id": 1498,
    "vorder": 101,
    "position": 0,
    "text": "ز بالا به پستی بپیچید گیو"
  },
  {
    "poem_id": 1498,
    "vorder": 102,
    "position": 1,
    "text": "گریزان همی شد ز سالار نیو"
  },
  {
    "poem_id": 1498,
    "vorder": 103,
    "position": 0,
    "text": "چو از آب وز لشکرش دور کرد"
  },
  {
    "poem_id": 1498,
    "vorder": 104,
    "position": 1,
    "text": "به زین اندر افگند گُرز نبرد"
  },
  {
    "poem_id": 1498,
    "vorder": 105,
    "position": 0,
    "text": "گریزان ازو پهلوان بلند"
  },
  {
    "poem_id": 1498,
    "vorder": 106,
    "position": 1,
    "text": "ز فتراک بگشاد پیچان کمند"
  },
  {
    "poem_id": 1498,
    "vorder": 107,
    "position": 0,
    "text": "هم‌آورد با گیو نزدیک شد"
  },
  {
    "poem_id": 1498,
    "vorder": 108,
    "position": 1,
    "text": "جهان چون شب تیره تاریک شد"
  },
  {
    "poem_id": 1498,
    "vorder": 109,
    "position": 0,
    "text": "بپیچید گیو سرافراز یال"
  },
  {
    "poem_id": 1498,
    "vorder": 110,
    "position": 1,
    "text": "کمند اندرافگند و کردش دوال"
  },
  {
    "poem_id": 1498,
    "vorder": 111,
    "position": 0,
    "text": "سر پهلوان اندر آمد به بند"
  },
  {
    "poem_id": 1498,
    "vorder": 112,
    "position": 1,
    "text": "ز زین برگرفتش به خم کمند"
  },
  {
    "poem_id": 1498,
    "vorder": 113,
    "position": 0,
    "text": "پیاده به پیش اندر افگند خوار"
  },
  {
    "poem_id": 1498,
    "vorder": 114,
    "position": 1,
    "text": "ببردش دمان تا لب رودبار"
  },
  {
    "poem_id": 1498,
    "vorder": 115,
    "position": 0,
    "text": "بیفگند بر خاک و دستش ببست"
  },
  {
    "poem_id": 1498,
    "vorder": 116,
    "position": 1,
    "text": "سلیحش بپوشید و خود بر نشست"
  },
  {
    "poem_id": 1498,
    "vorder": 117,
    "position": 0,
    "text": "درفشش گرفته به چنگ اندرون"
  },
  {
    "poem_id": 1498,
    "vorder": 118,
    "position": 1,
    "text": "بشد تا لب آب گلزریون"
  },
  {
    "poem_id": 1498,
    "vorder": 119,
    "position": 0,
    "text": "چو ترکان درفش سپهدار خویش"
  },
  {
    "poem_id": 1498,
    "vorder": 120,
    "position": 1,
    "text": "بدیدند رفتند ناچار پیش"
  },
  {
    "poem_id": 1498,
    "vorder": 121,
    "position": 0,
    "text": "خروش آمد و نالهٔ کرنای"
  },
  {
    "poem_id": 1498,
    "vorder": 122,
    "position": 1,
    "text": "دم نای رویین و هندی درای"
  },
  {
    "poem_id": 1498,
    "vorder": 123,
    "position": 0,
    "text": "جهاندیده گیو اندر آمد به آب"
  },
  {
    "poem_id": 1498,
    "vorder": 124,
    "position": 1,
    "text": "چو کشتی که از باد گیرد شتاب"
  },
  {
    "poem_id": 1498,
    "vorder": 125,
    "position": 0,
    "text": "برآورد گُرز گران را به کفت"
  },
  {
    "poem_id": 1498,
    "vorder": 126,
    "position": 1,
    "text": "سپه ماند از کار او در شگفت"
  },
  {
    "poem_id": 1498,
    "vorder": 127,
    "position": 0,
    "text": "سبک شد عنان وگران شد رکیب"
  },
  {
    "poem_id": 1498,
    "vorder": 128,
    "position": 1,
    "text": "سر سرکشان خیره گشت از نهیب"
  },
  {
    "poem_id": 1498,
    "vorder": 129,
    "position": 0,
    "text": "به شمشیر و با نیزهٔ سرگرای"
  },
  {
    "poem_id": 1498,
    "vorder": 130,
    "position": 1,
    "text": "همی کشت ازیشان یل رهنمای"
  },
  {
    "poem_id": 1498,
    "vorder": 131,
    "position": 0,
    "text": "از افگنده شد روی هامون چون کوه"
  },
  {
    "poem_id": 1498,
    "vorder": 132,
    "position": 1,
    "text": "ز یک تن شدند آن دلیران ستوه"
  },
  {
    "poem_id": 1498,
    "vorder": 133,
    "position": 0,
    "text": "قفای یلان سوی او شد همه"
  },
  {
    "poem_id": 1498,
    "vorder": 134,
    "position": 1,
    "text": "چو شیر اندر آمد به پیش رمه"
  },
  {
    "poem_id": 1498,
    "vorder": 135,
    "position": 0,
    "text": "چو لشکر هزیمت شد از پیش گیو"
  },
  {
    "poem_id": 1498,
    "vorder": 136,
    "position": 1,
    "text": "چنان لشکری گشن و مردان نیو"
  },
  {
    "poem_id": 1498,
    "vorder": 137,
    "position": 0,
    "text": "چنان خیره برگشت و بگذاشت آب"
  },
  {
    "poem_id": 1498,
    "vorder": 138,
    "position": 1,
    "text": "که گفتی ندیدست لشکر به خواب"
  },
  {
    "poem_id": 1498,
    "vorder": 139,
    "position": 0,
    "text": "دمان تا به نزدیک پیران رسید"
  },
  {
    "poem_id": 1498,
    "vorder": 140,
    "position": 1,
    "text": "همی خواست از تن سرش را برید"
  },
  {
    "poem_id": 1498,
    "vorder": 141,
    "position": 0,
    "text": "به خواری پیاده ببردش کشان"
  },
  {
    "poem_id": 1498,
    "vorder": 142,
    "position": 1,
    "text": "دمان و پر از درد چون بیهشان"
  },
  {
    "poem_id": 1498,
    "vorder": 143,
    "position": 0,
    "text": "چنین گفت کاین بددل و بی‌وفا"
  },
  {
    "poem_id": 1498,
    "vorder": 144,
    "position": 1,
    "text": "گرفتار شد در دم اژدها"
  },
  {
    "poem_id": 1498,
    "vorder": 145,
    "position": 0,
    "text": "سیاوش به گفتار او سر بداد"
  },
  {
    "poem_id": 1498,
    "vorder": 146,
    "position": 1,
    "text": "گر او باد شد این شود نیز باد"
  },
  {
    "poem_id": 1498,
    "vorder": 147,
    "position": 0,
    "text": "ابر شاه پیران گرفت آفرین"
  },
  {
    "poem_id": 1498,
    "vorder": 148,
    "position": 1,
    "text": "خروشان ببوسید روی زمین"
  },
  {
    "poem_id": 1498,
    "vorder": 149,
    "position": 0,
    "text": "همی گفت کای شاه دانش پژوه"
  },
  {
    "poem_id": 1498,
    "vorder": 150,
    "position": 1,
    "text": "چو خورشید تابان میان گروه"
  },
  {
    "poem_id": 1498,
    "vorder": 151,
    "position": 0,
    "text": "تو دانسته‌ای درد و تیمار من"
  },
  {
    "poem_id": 1498,
    "vorder": 152,
    "position": 1,
    "text": "ز بهر تو با شاه پیگار من"
  },
  {
    "poem_id": 1498,
    "vorder": 153,
    "position": 0,
    "text": "سزد گر من از چنگ این اژدها"
  },
  {
    "poem_id": 1498,
    "vorder": 154,
    "position": 1,
    "text": "به بخت و به فر تو یابم رها"
  },
  {
    "poem_id": 1498,
    "vorder": 155,
    "position": 0,
    "text": "به کیخسرو اندر نگه کرد گیو"
  },
  {
    "poem_id": 1498,
    "vorder": 156,
    "position": 1,
    "text": "بدان تا چه فرمان دهد شاه نیو"
  },
  {
    "poem_id": 1498,
    "vorder": 157,
    "position": 0,
    "text": "فرنگیس را دید دیده پرآب"
  },
  {
    "poem_id": 1498,
    "vorder": 158,
    "position": 1,
    "text": "زبان پر ز نفرین افراسیاب"
  },
  {
    "poem_id": 1498,
    "vorder": 159,
    "position": 0,
    "text": "به گیو آن زمان گفت کای سرافراز"
  },
  {
    "poem_id": 1498,
    "vorder": 160,
    "position": 1,
    "text": "کشیدی بسی رنج راه دراز"
  },
  {
    "poem_id": 1498,
    "vorder": 161,
    "position": 0,
    "text": "چنان دان که این پیرسر پهلوان"
  },
  {
    "poem_id": 1498,
    "vorder": 162,
    "position": 1,
    "text": "خردمند و رادست و روشن روان"
  },
  {
    "poem_id": 1498,
    "vorder": 163,
    "position": 0,
    "text": "پس از داور دادگر رهنمون"
  },
  {
    "poem_id": 1498,
    "vorder": 164,
    "position": 1,
    "text": "بدان کاو رهانید ما را ز خون"
  },
  {
    "poem_id": 1498,
    "vorder": 165,
    "position": 0,
    "text": "ز بد مهر او پردهٔ جان ماست"
  },
  {
    "poem_id": 1498,
    "vorder": 166,
    "position": 1,
    "text": "وزین کردهٔ خویش زنهار خواست"
  },
  {
    "poem_id": 1498,
    "vorder": 167,
    "position": 0,
    "text": "بدو گفت گیو ای سر بانوان"
  },
  {
    "poem_id": 1498,
    "vorder": 168,
    "position": 1,
    "text": "انوشه روان باش تا جاودان"
  },
  {
    "poem_id": 1498,
    "vorder": 169,
    "position": 0,
    "text": "یکی سخت سوگند خوردم به ماه"
  },
  {
    "poem_id": 1498,
    "vorder": 170,
    "position": 1,
    "text": "به تاج و به تخت شه نیک‌خواه"
  },
  {
    "poem_id": 1498,
    "vorder": 171,
    "position": 0,
    "text": "که گر دست یابم برو روز کین"
  },
  {
    "poem_id": 1498,
    "vorder": 172,
    "position": 1,
    "text": "کنم ارغوانی ز خونش زمین"
  },
  {
    "poem_id": 1498,
    "vorder": 173,
    "position": 0,
    "text": "بدو گفت کیخسرو ای شیرفش"
  },
  {
    "poem_id": 1498,
    "vorder": 174,
    "position": 1,
    "text": "زبان را ز سوگند یزدان مکش"
  },
  {
    "poem_id": 1498,
    "vorder": 175,
    "position": 0,
    "text": "کنونش به سوگند گستاخ کن"
  },
  {
    "poem_id": 1498,
    "vorder": 176,
    "position": 1,
    "text": "به خنجر وراگوش سوراخ کن"
  },
  {
    "poem_id": 1498,
    "vorder": 177,
    "position": 0,
    "text": "چو از خنجرت خون چکد بر زمین"
  },
  {
    "poem_id": 1498,
    "vorder": 178,
    "position": 1,
    "text": "هم از مهر یاد آیدت هم ز کین"
  },
  {
    "poem_id": 1498,
    "vorder": 179,
    "position": 0,
    "text": "بشد گیو و گوشش به خنجر بسفت"
  },
  {
    "poem_id": 1498,
    "vorder": 180,
    "position": 1,
    "text": "ز سوگند برتر درشتی نگفت"
  },
  {
    "poem_id": 1498,
    "vorder": 181,
    "position": 0,
    "text": "چنین گفت پیران ازان پس به شاه"
  },
  {
    "poem_id": 1498,
    "vorder": 182,
    "position": 1,
    "text": "که کلباد شد بی‌گمان با سپاه"
  },
  {
    "poem_id": 1498,
    "vorder": 183,
    "position": 0,
    "text": "بفرمای کاسپم دهد باز نیز"
  },
  {
    "poem_id": 1498,
    "vorder": 184,
    "position": 1,
    "text": "چنان دان که بخشیده‌ای جان و چیز"
  },
  {
    "poem_id": 1498,
    "vorder": 185,
    "position": 0,
    "text": "بدو گفت گیو ای دلیر سپاه"
  },
  {
    "poem_id": 1498,
    "vorder": 186,
    "position": 1,
    "text": "چرا سست گشتی به آوردگاه"
  },
  {
    "poem_id": 1498,
    "vorder": 187,
    "position": 0,
    "text": "به سوگند یابی مگر باره باز"
  },
  {
    "poem_id": 1498,
    "vorder": 188,
    "position": 1,
    "text": "دو دستت ببندم به بند دراز"
  },
  {
    "poem_id": 1498,
    "vorder": 189,
    "position": 0,
    "text": "که نگشاید این بند تو هیچکس"
  },
  {
    "poem_id": 1498,
    "vorder": 190,
    "position": 1,
    "text": "گشاینده گلشهر خواهیم و بس"
  },
  {
    "poem_id": 1498,
    "vorder": 191,
    "position": 0,
    "text": "کجا مهتر بانوان تو اوست"
  },
  {
    "poem_id": 1498,
    "vorder": 192,
    "position": 1,
    "text": "وزو نیست پیدا ترا مغز و پوست"
  },
  {
    "poem_id": 1498,
    "vorder": 193,
    "position": 0,
    "text": "بدان گشت همداستان پهلوان"
  },
  {
    "poem_id": 1498,
    "vorder": 194,
    "position": 1,
    "text": "به سوگند بخرید اسپ و روان"
  },
  {
    "poem_id": 1498,
    "vorder": 195,
    "position": 0,
    "text": "که نگشاید آن بند را کس به راه"
  },
  {
    "poem_id": 1498,
    "vorder": 196,
    "position": 1,
    "text": "ز گلشهر سازد وی آن دستگاه"
  },
  {
    "poem_id": 1498,
    "vorder": 197,
    "position": 0,
    "text": "بدو داد اسپ و دو دستش ببست"
  },
  {
    "poem_id": 1498,
    "vorder": 198,
    "position": 1,
    "text": "ازان پس بفرمود تا برنشست"
  }
]