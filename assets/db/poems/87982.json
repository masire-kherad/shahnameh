[
  {
    "poem_id": 87982,
    "vorder": 1,
    "position": 0,
    "text": "به‌اسپ عقاب اندر آورد پای"
  },
  {
    "poem_id": 87982,
    "vorder": 2,
    "position": 1,
    "text": "برانگیخت آن بارگی را ز جای"
  },
  {
    "poem_id": 87982,
    "vorder": 3,
    "position": 0,
    "text": "تو گفتی یکی بارهٔ آهنست"
  },
  {
    "poem_id": 87982,
    "vorder": 4,
    "position": 1,
    "text": "وگر کوه البرز در جوشنست"
  },
  {
    "poem_id": 87982,
    "vorder": 5,
    "position": 0,
    "text": "به پیش سپاه اندر آمد بجنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 6,
    "position": 1,
    "text": "یکی خشت رخشان گرفته بچنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 7,
    "position": 0,
    "text": "بجنبید طوس سپهبد ز جای"
  },
  {
    "poem_id": 87982,
    "vorder": 8,
    "position": 1,
    "text": "جهان پر شد از نالهٔ کر نای"
  },
  {
    "poem_id": 87982,
    "vorder": 9,
    "position": 0,
    "text": "بهومان چنین گفت کای شوربخت"
  },
  {
    "poem_id": 87982,
    "vorder": 10,
    "position": 1,
    "text": "ز پالیز کین برنیامد درخت"
  },
  {
    "poem_id": 87982,
    "vorder": 11,
    "position": 0,
    "text": "نمودم بارژنگ یک دست برد"
  },
  {
    "poem_id": 87982,
    "vorder": 12,
    "position": 1,
    "text": "که بود از شما نامبردار و گرد"
  },
  {
    "poem_id": 87982,
    "vorder": 13,
    "position": 0,
    "text": "تو اکنون همانا بکین آمدی"
  },
  {
    "poem_id": 87982,
    "vorder": 14,
    "position": 1,
    "text": "که با خشت بر پشت زین آمدی"
  },
  {
    "poem_id": 87982,
    "vorder": 15,
    "position": 0,
    "text": "بجان و سر شاه ایران سپاه"
  },
  {
    "poem_id": 87982,
    "vorder": 16,
    "position": 1,
    "text": "که بی‌جوشن و گرز و رومی کلاه"
  },
  {
    "poem_id": 87982,
    "vorder": 17,
    "position": 0,
    "text": "بجنگ تو آیم بسان پلنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 18,
    "position": 1,
    "text": "که از کوه یازد بنخچیر چنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 19,
    "position": 0,
    "text": "ببینی تو پیکار مردان مرد"
  },
  {
    "poem_id": 87982,
    "vorder": 20,
    "position": 1,
    "text": "چو آورد گیرم بدشت نبرد"
  },
  {
    "poem_id": 87982,
    "vorder": 21,
    "position": 0,
    "text": "چنین پاسخ آورد هومان بدوی"
  },
  {
    "poem_id": 87982,
    "vorder": 22,
    "position": 1,
    "text": "که بیشی نه خوبست بیشی مجوی"
  },
  {
    "poem_id": 87982,
    "vorder": 23,
    "position": 0,
    "text": "گر ایدونک بیچاره‌ای را زمان"
  },
  {
    "poem_id": 87982,
    "vorder": 24,
    "position": 1,
    "text": "بدست تو آمد مشو در گمان"
  },
  {
    "poem_id": 87982,
    "vorder": 25,
    "position": 0,
    "text": "بجنگ من ارژنگ روز نبرد"
  },
  {
    "poem_id": 87982,
    "vorder": 26,
    "position": 1,
    "text": "کجا داشتی خویشتن را بمرد"
  },
  {
    "poem_id": 87982,
    "vorder": 27,
    "position": 0,
    "text": "دلیران لشکر ندارند شرم"
  },
  {
    "poem_id": 87982,
    "vorder": 28,
    "position": 1,
    "text": "نجوشد یکی را برگ خون گرم"
  },
  {
    "poem_id": 87982,
    "vorder": 29,
    "position": 0,
    "text": "که پیکار ایشان سپهبد کند"
  },
  {
    "poem_id": 87982,
    "vorder": 30,
    "position": 1,
    "text": "برزم اندرون دستشان بد کند"
  },
  {
    "poem_id": 87982,
    "vorder": 31,
    "position": 0,
    "text": "کجا بیژن و گیو آزادگان"
  },
  {
    "poem_id": 87982,
    "vorder": 32,
    "position": 1,
    "text": "جهانگیر گودرز کشوادگان"
  },
  {
    "poem_id": 87982,
    "vorder": 33,
    "position": 0,
    "text": "تو گر پهلوانی ز قلب سپاه"
  },
  {
    "poem_id": 87982,
    "vorder": 34,
    "position": 1,
    "text": "چرا آمدستی بدین رزمگاه"
  },
  {
    "poem_id": 87982,
    "vorder": 35,
    "position": 0,
    "text": "خردمند بیگانه خواند ترا"
  },
  {
    "poem_id": 87982,
    "vorder": 36,
    "position": 1,
    "text": "هشیوار دیوانه خواند ترا"
  },
  {
    "poem_id": 87982,
    "vorder": 37,
    "position": 0,
    "text": "تو شو اختر کاویانی بدار"
  },
  {
    "poem_id": 87982,
    "vorder": 38,
    "position": 1,
    "text": "سپهبد نیاید سوی کارزار"
  },
  {
    "poem_id": 87982,
    "vorder": 39,
    "position": 0,
    "text": "نگه کن که خلعت کرا داد شاه"
  },
  {
    "poem_id": 87982,
    "vorder": 40,
    "position": 1,
    "text": "ز گردان که جوید نگین و کلاه"
  },
  {
    "poem_id": 87982,
    "vorder": 41,
    "position": 0,
    "text": "بفرمای تا جنگ شیر آورند"
  },
  {
    "poem_id": 87982,
    "vorder": 42,
    "position": 1,
    "text": "زبردست را دست زیر آورند"
  },
  {
    "poem_id": 87982,
    "vorder": 43,
    "position": 0,
    "text": "اگر تو شوی کشته بر دست من"
  },
  {
    "poem_id": 87982,
    "vorder": 44,
    "position": 1,
    "text": "بد آید بدان نامدار انجمن"
  },
  {
    "poem_id": 87982,
    "vorder": 45,
    "position": 0,
    "text": "سپاه تو بی‌یار و بیجان شوند"
  },
  {
    "poem_id": 87982,
    "vorder": 46,
    "position": 1,
    "text": "اگر زنده مانند پیچان شوند"
  },
  {
    "poem_id": 87982,
    "vorder": 47,
    "position": 0,
    "text": "و دیگر که گر بشنوی گفت راست"
  },
  {
    "poem_id": 87982,
    "vorder": 48,
    "position": 1,
    "text": "روان و دلم بر زبانم گواست"
  },
  {
    "poem_id": 87982,
    "vorder": 49,
    "position": 0,
    "text": "که پر درد باشم ز مردان مرد"
  },
  {
    "poem_id": 87982,
    "vorder": 50,
    "position": 1,
    "text": "که پیش من آیند روز نبرد"
  },
  {
    "poem_id": 87982,
    "vorder": 51,
    "position": 0,
    "text": "پس از رستم زال سام سوار"
  },
  {
    "poem_id": 87982,
    "vorder": 52,
    "position": 1,
    "text": "ندیدم چو تو نیز یک نامدار"
  },
  {
    "poem_id": 87982,
    "vorder": 53,
    "position": 0,
    "text": "پدر بر پدر نامبردار و شاه"
  },
  {
    "poem_id": 87982,
    "vorder": 54,
    "position": 1,
    "text": "چو تو جنگجویی نیاید سپاه"
  },
  {
    "poem_id": 87982,
    "vorder": 55,
    "position": 0,
    "text": "تو شو تا ز لشکر یکی نامجوی"
  },
  {
    "poem_id": 87982,
    "vorder": 56,
    "position": 1,
    "text": "بیاید بروی اندر آریم روی"
  },
  {
    "poem_id": 87982,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت طوس ای سرافراز مرد"
  },
  {
    "poem_id": 87982,
    "vorder": 58,
    "position": 1,
    "text": "سپهبد منم هم سوار نبرد"
  },
  {
    "poem_id": 87982,
    "vorder": 59,
    "position": 0,
    "text": "تو هم نامداری ز توران سپاه"
  },
  {
    "poem_id": 87982,
    "vorder": 60,
    "position": 1,
    "text": "چرا رای کردی به آوردگاه"
  },
  {
    "poem_id": 87982,
    "vorder": 61,
    "position": 0,
    "text": "دلت گر پذیرد یکی پند من"
  },
  {
    "poem_id": 87982,
    "vorder": 62,
    "position": 1,
    "text": "بجویی بدین کار پیوند من"
  },
  {
    "poem_id": 87982,
    "vorder": 63,
    "position": 0,
    "text": "کزین کینه تا زنده ماند یکی"
  },
  {
    "poem_id": 87982,
    "vorder": 64,
    "position": 1,
    "text": "نیاسود خواهد سپاه اندکی"
  },
  {
    "poem_id": 87982,
    "vorder": 65,
    "position": 0,
    "text": "تو با خویش وپیوند و چندین سوار"
  },
  {
    "poem_id": 87982,
    "vorder": 66,
    "position": 1,
    "text": "همه پهلوان و همه نامدار"
  },
  {
    "poem_id": 87982,
    "vorder": 67,
    "position": 0,
    "text": "بخیره مده خویشتن را بباد"
  },
  {
    "poem_id": 87982,
    "vorder": 68,
    "position": 1,
    "text": "بباید که پند من آیدت یاد"
  },
  {
    "poem_id": 87982,
    "vorder": 69,
    "position": 0,
    "text": "سزاوار کشتن هرآنکس که هست"
  },
  {
    "poem_id": 87982,
    "vorder": 70,
    "position": 1,
    "text": "بمان تا بیازند بر کینه دست"
  },
  {
    "poem_id": 87982,
    "vorder": 71,
    "position": 0,
    "text": "کزین کینه مرد گنهکار هیچ"
  },
  {
    "poem_id": 87982,
    "vorder": 72,
    "position": 1,
    "text": "رهایی نیابد خرد را مپیچ"
  },
  {
    "poem_id": 87982,
    "vorder": 73,
    "position": 0,
    "text": "مرا شاه ایران چنین داد پند"
  },
  {
    "poem_id": 87982,
    "vorder": 74,
    "position": 1,
    "text": "که پیران نباید که یابد گزند"
  },
  {
    "poem_id": 87982,
    "vorder": 75,
    "position": 0,
    "text": "که او ویژه پروردگار منست"
  },
  {
    "poem_id": 87982,
    "vorder": 76,
    "position": 1,
    "text": "جهاندیده و دوستدار منست"
  },
  {
    "poem_id": 87982,
    "vorder": 77,
    "position": 0,
    "text": "به بیداد بر خیره با او مکوش"
  },
  {
    "poem_id": 87982,
    "vorder": 78,
    "position": 1,
    "text": "نگه کن که دارد بپند تو گوش"
  },
  {
    "poem_id": 87982,
    "vorder": 79,
    "position": 0,
    "text": "چنین گفت هومان به بیداد و داد"
  },
  {
    "poem_id": 87982,
    "vorder": 80,
    "position": 1,
    "text": "چو فرمان دهد شاه فرخ نژاد"
  },
  {
    "poem_id": 87982,
    "vorder": 81,
    "position": 0,
    "text": "بران رفت باید ببیچارگی"
  },
  {
    "poem_id": 87982,
    "vorder": 82,
    "position": 1,
    "text": "سپردن بدو دل بیکبارگی"
  },
  {
    "poem_id": 87982,
    "vorder": 83,
    "position": 0,
    "text": "همان رزم پیران نه بر آرزوست"
  },
  {
    "poem_id": 87982,
    "vorder": 84,
    "position": 1,
    "text": "که او راد و آزاده و نیک خوست"
  },
  {
    "poem_id": 87982,
    "vorder": 85,
    "position": 0,
    "text": "بدین گفت و گوی اندرون بود طوس"
  },
  {
    "poem_id": 87982,
    "vorder": 86,
    "position": 1,
    "text": "که شد گیو را روی چون سندروس"
  },
  {
    "poem_id": 87982,
    "vorder": 87,
    "position": 0,
    "text": "ز لشکر بیامد بکردار باد"
  },
  {
    "poem_id": 87982,
    "vorder": 88,
    "position": 1,
    "text": "چنین گفت کای طوس فرخ نژاد"
  },
  {
    "poem_id": 87982,
    "vorder": 89,
    "position": 0,
    "text": "فریبنده هومان میان دو صف"
  },
  {
    "poem_id": 87982,
    "vorder": 90,
    "position": 1,
    "text": "بیامد دمان بر لب آورده کف"
  },
  {
    "poem_id": 87982,
    "vorder": 91,
    "position": 0,
    "text": "کنون با تو چندین چه گوید براز"
  },
  {
    "poem_id": 87982,
    "vorder": 92,
    "position": 1,
    "text": "میان دو صف گفت و گوی دراز"
  },
  {
    "poem_id": 87982,
    "vorder": 93,
    "position": 0,
    "text": "سخن جز بشمشیر با او مگوی"
  },
  {
    "poem_id": 87982,
    "vorder": 94,
    "position": 1,
    "text": "مجوی از در آشتی هیچ روی"
  },
  {
    "poem_id": 87982,
    "vorder": 95,
    "position": 0,
    "text": "چو بشنید هومان برآشفت سخت"
  },
  {
    "poem_id": 87982,
    "vorder": 96,
    "position": 1,
    "text": "چنین گفت با گیو بیدار بخت"
  },
  {
    "poem_id": 87982,
    "vorder": 97,
    "position": 0,
    "text": "ایا گم شده بخت آزادگان"
  },
  {
    "poem_id": 87982,
    "vorder": 98,
    "position": 1,
    "text": "که گم باد گودرز کشوادگان"
  },
  {
    "poem_id": 87982,
    "vorder": 99,
    "position": 0,
    "text": "فراوان مرا دیده‌ای روز جنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 100,
    "position": 1,
    "text": "به آوردگه تیغ هندی بچنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 101,
    "position": 0,
    "text": "کس از تخم کشواد جنگی نماند"
  },
  {
    "poem_id": 87982,
    "vorder": 102,
    "position": 1,
    "text": "که منشور تیغ مرا برنخواند"
  },
  {
    "poem_id": 87982,
    "vorder": 103,
    "position": 0,
    "text": "ترا بخت چون روی آهرمنست"
  },
  {
    "poem_id": 87982,
    "vorder": 104,
    "position": 1,
    "text": "بخان تو تا جاودان شیونست"
  },
  {
    "poem_id": 87982,
    "vorder": 105,
    "position": 0,
    "text": "اگر من شوم کشته بر دست طوس"
  },
  {
    "poem_id": 87982,
    "vorder": 106,
    "position": 1,
    "text": "نه برخیزد آیین گوپال و کوس"
  },
  {
    "poem_id": 87982,
    "vorder": 107,
    "position": 0,
    "text": "بجایست پیران و افراسیاب"
  },
  {
    "poem_id": 87982,
    "vorder": 108,
    "position": 1,
    "text": "بخواهد شدن خون من رود آب"
  },
  {
    "poem_id": 87982,
    "vorder": 109,
    "position": 0,
    "text": "نه گیتی شود پاک ویران ز من"
  },
  {
    "poem_id": 87982,
    "vorder": 110,
    "position": 1,
    "text": "سخن راند باید بدین انجمن"
  },
  {
    "poem_id": 87982,
    "vorder": 111,
    "position": 0,
    "text": "وگر طوس گردد بدستم تباه"
  },
  {
    "poem_id": 87982,
    "vorder": 112,
    "position": 1,
    "text": "یکی ره نیابند ز ایران سپاه"
  },
  {
    "poem_id": 87982,
    "vorder": 113,
    "position": 0,
    "text": "تو اکنون بمرگ برادر گری"
  },
  {
    "poem_id": 87982,
    "vorder": 114,
    "position": 1,
    "text": "چه با طوس نوذر کنی داوری"
  },
  {
    "poem_id": 87982,
    "vorder": 115,
    "position": 0,
    "text": "بدو گفت طوس این چه آشفتنست"
  },
  {
    "poem_id": 87982,
    "vorder": 116,
    "position": 1,
    "text": "بدین دشت پیکار تو با منست"
  },
  {
    "poem_id": 87982,
    "vorder": 117,
    "position": 0,
    "text": "بیا تا بگردیم و کین آوریم"
  },
  {
    "poem_id": 87982,
    "vorder": 118,
    "position": 1,
    "text": "بجنگ ابروان پر ز چین آوریم"
  },
  {
    "poem_id": 87982,
    "vorder": 119,
    "position": 0,
    "text": "بدو گفت هومان که دادست مرگ"
  },
  {
    "poem_id": 87982,
    "vorder": 120,
    "position": 1,
    "text": "سری زیر تاج و سری زیر ترگ"
  },
  {
    "poem_id": 87982,
    "vorder": 121,
    "position": 0,
    "text": "اگر مرگ باشد مرا بی‌گمان"
  },
  {
    "poem_id": 87982,
    "vorder": 122,
    "position": 1,
    "text": "به آوردگه به که آید زمان"
  },
  {
    "poem_id": 87982,
    "vorder": 123,
    "position": 0,
    "text": "بدست سواری که دارد هنر"
  },
  {
    "poem_id": 87982,
    "vorder": 124,
    "position": 1,
    "text": "سپهبدسر و گرد و پرخاشخر"
  },
  {
    "poem_id": 87982,
    "vorder": 125,
    "position": 0,
    "text": "گرفتند هر دو عمود گران"
  },
  {
    "poem_id": 87982,
    "vorder": 126,
    "position": 1,
    "text": "همی حمله برد آن برین این بران"
  },
  {
    "poem_id": 87982,
    "vorder": 127,
    "position": 0,
    "text": "ز می گشت گردان و شد روز تار"
  },
  {
    "poem_id": 87982,
    "vorder": 128,
    "position": 1,
    "text": "یکی ابر بست از بر کارزار"
  },
  {
    "poem_id": 87982,
    "vorder": 129,
    "position": 0,
    "text": "تو گفتی شب آمد بریشان بروز"
  },
  {
    "poem_id": 87982,
    "vorder": 130,
    "position": 1,
    "text": "نهان گشت خورشید گیتی فروز"
  },
  {
    "poem_id": 87982,
    "vorder": 131,
    "position": 0,
    "text": "ازان چاک چاک عمود گران"
  },
  {
    "poem_id": 87982,
    "vorder": 132,
    "position": 1,
    "text": "سرانشان چو سندان آهنگران"
  },
  {
    "poem_id": 87982,
    "vorder": 133,
    "position": 0,
    "text": "بابر اندرون بانگ پولاد خاست"
  },
  {
    "poem_id": 87982,
    "vorder": 134,
    "position": 1,
    "text": "بدریای شهد اندرون باد خاست"
  },
  {
    "poem_id": 87982,
    "vorder": 135,
    "position": 0,
    "text": "ز خون بر کف شیر کفشیر بود"
  },
  {
    "poem_id": 87982,
    "vorder": 136,
    "position": 1,
    "text": "همه دشت پر بانگ شمشیر بود"
  },
  {
    "poem_id": 87982,
    "vorder": 137,
    "position": 0,
    "text": "خم آورد رویین عمود گران"
  },
  {
    "poem_id": 87982,
    "vorder": 138,
    "position": 1,
    "text": "شد آهن به کردار چاچی کمان"
  },
  {
    "poem_id": 87982,
    "vorder": 139,
    "position": 0,
    "text": "تو گفتی که سنگ است سر زیر ترگ"
  },
  {
    "poem_id": 87982,
    "vorder": 140,
    "position": 1,
    "text": "سیه شد ز زخم یلان روی مرگ"
  },
  {
    "poem_id": 87982,
    "vorder": 141,
    "position": 0,
    "text": "گرفتند شمشیر هندی بچنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 142,
    "position": 1,
    "text": "فرو ریخت آتش ز پولاد و سنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 143,
    "position": 0,
    "text": "ز نیروی گردنکشان تیغ تیز"
  },
  {
    "poem_id": 87982,
    "vorder": 144,
    "position": 1,
    "text": "خم آورد و در زخم شد ریز ریز"
  },
  {
    "poem_id": 87982,
    "vorder": 145,
    "position": 0,
    "text": "همه کام پرخاک و پر خاک سر"
  },
  {
    "poem_id": 87982,
    "vorder": 146,
    "position": 1,
    "text": "گرفتند هر دو دوال کمر"
  },
  {
    "poem_id": 87982,
    "vorder": 147,
    "position": 0,
    "text": "ز نیروی گردان گران شد رکیب"
  },
  {
    "poem_id": 87982,
    "vorder": 148,
    "position": 1,
    "text": "یکی را نیامد سر اندر نشیب"
  },
  {
    "poem_id": 87982,
    "vorder": 149,
    "position": 0,
    "text": "کمربند بگسست و هومان بجست"
  },
  {
    "poem_id": 87982,
    "vorder": 150,
    "position": 1,
    "text": "یکی اسپ آسوده را برنشست"
  },
  {
    "poem_id": 87982,
    "vorder": 151,
    "position": 0,
    "text": "سپهبد سوی ترکش آورد چنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 152,
    "position": 1,
    "text": "کمان را بزه کرد و تیر خدنگ"
  },
  {
    "poem_id": 87982,
    "vorder": 153,
    "position": 0,
    "text": "بران نامور تیرباران گرفت"
  },
  {
    "poem_id": 87982,
    "vorder": 154,
    "position": 1,
    "text": "چپ و راست جنگ سواران گرفت"
  },
  {
    "poem_id": 87982,
    "vorder": 155,
    "position": 0,
    "text": "ز پولاد پیکان و پر عقاب"
  },
  {
    "poem_id": 87982,
    "vorder": 156,
    "position": 1,
    "text": "سپر کرد بر پیش روی آفتاب"
  },
  {
    "poem_id": 87982,
    "vorder": 157,
    "position": 0,
    "text": "جهان چون ز شب رفته دو پاس گشت"
  },
  {
    "poem_id": 87982,
    "vorder": 158,
    "position": 1,
    "text": "همه روی کشور پر الماس گشت"
  },
  {
    "poem_id": 87982,
    "vorder": 159,
    "position": 0,
    "text": "ز تیر خدنگ اسپ هومان بخست"
  },
  {
    "poem_id": 87982,
    "vorder": 160,
    "position": 1,
    "text": "تن بارگی گشت با خاک پست"
  },
  {
    "poem_id": 87982,
    "vorder": 161,
    "position": 0,
    "text": "سپر بر سر آورد و ننمود روی"
  },
  {
    "poem_id": 87982,
    "vorder": 162,
    "position": 1,
    "text": "نگه داشت هومان سر از تیر اوی"
  },
  {
    "poem_id": 87982,
    "vorder": 163,
    "position": 0,
    "text": "چو او را پیاده بران رزمگاه"
  },
  {
    "poem_id": 87982,
    "vorder": 164,
    "position": 1,
    "text": "بدیدند گفتند توران سپاه"
  },
  {
    "poem_id": 87982,
    "vorder": 165,
    "position": 0,
    "text": "که پردخت ماند کنون جای اوی"
  },
  {
    "poem_id": 87982,
    "vorder": 166,
    "position": 1,
    "text": "ببردند پرمایه بالای اوی"
  },
  {
    "poem_id": 87982,
    "vorder": 167,
    "position": 0,
    "text": "چو هومان بران زین توزی نشست"
  },
  {
    "poem_id": 87982,
    "vorder": 168,
    "position": 1,
    "text": "یکی تیغ بگرفت هندی بدست"
  },
  {
    "poem_id": 87982,
    "vorder": 169,
    "position": 0,
    "text": "که آید دگر باره بر جنگ طوس"
  },
  {
    "poem_id": 87982,
    "vorder": 170,
    "position": 1,
    "text": "شد از شب جهان تیره چون آبنوس"
  },
  {
    "poem_id": 87982,
    "vorder": 171,
    "position": 0,
    "text": "همه نامداران پرخاشجوی"
  },
  {
    "poem_id": 87982,
    "vorder": 172,
    "position": 1,
    "text": "یکایک بدو در نهادند روی"
  },
  {
    "poem_id": 87982,
    "vorder": 173,
    "position": 0,
    "text": "چو شد روز تاریک و بیگاه گشت"
  },
  {
    "poem_id": 87982,
    "vorder": 174,
    "position": 1,
    "text": "ز جنگ یلان دست کوتاه گشت"
  },
  {
    "poem_id": 87982,
    "vorder": 175,
    "position": 0,
    "text": "بپیچید هومان جنگی عنان"
  },
  {
    "poem_id": 87982,
    "vorder": 176,
    "position": 1,
    "text": "سپهبد بدو راست کرده سنان"
  },
  {
    "poem_id": 87982,
    "vorder": 177,
    "position": 0,
    "text": "بنزدیک پیران شد از رزمگاه"
  },
  {
    "poem_id": 87982,
    "vorder": 178,
    "position": 1,
    "text": "خروشی برآمد ز توران سپاه"
  },
  {
    "poem_id": 87982,
    "vorder": 179,
    "position": 0,
    "text": "ز تو خشم گردنکشان دور باد"
  },
  {
    "poem_id": 87982,
    "vorder": 180,
    "position": 1,
    "text": "درین جنگ فرجام ما سور باد"
  },
  {
    "poem_id": 87982,
    "vorder": 181,
    "position": 0,
    "text": "که چون بود رزم تو ای نامجوی"
  },
  {
    "poem_id": 87982,
    "vorder": 182,
    "position": 1,
    "text": "چو با طوس روی اندر آمد بروی"
  },
  {
    "poem_id": 87982,
    "vorder": 183,
    "position": 0,
    "text": "همه پاک ما دل پر از خون بدیم"
  },
  {
    "poem_id": 87982,
    "vorder": 184,
    "position": 1,
    "text": "جز ایزد نداند که ما چون بدیم"
  },
  {
    "poem_id": 87982,
    "vorder": 185,
    "position": 0,
    "text": "بلشکر چنین گفت هومان شیر"
  },
  {
    "poem_id": 87982,
    "vorder": 186,
    "position": 1,
    "text": "که ای رزم دیده سران دلیر"
  },
  {
    "poem_id": 87982,
    "vorder": 187,
    "position": 0,
    "text": "چو روشن شود تیره شب روز ماست"
  },
  {
    "poem_id": 87982,
    "vorder": 188,
    "position": 1,
    "text": "که این اختر گیتی افروز ماست"
  },
  {
    "poem_id": 87982,
    "vorder": 189,
    "position": 0,
    "text": "شما را همه شادکامی بود"
  },
  {
    "poem_id": 87982,
    "vorder": 190,
    "position": 1,
    "text": "مرا خوبی و نیکنامی بود"
  },
  {
    "poem_id": 87982,
    "vorder": 191,
    "position": 0,
    "text": "ز لشکر همی برخروشید طوس"
  },
  {
    "poem_id": 87982,
    "vorder": 192,
    "position": 1,
    "text": "شب تیره تا گاه بانگ خروس"
  },
  {
    "poem_id": 87982,
    "vorder": 193,
    "position": 0,
    "text": "همی گفت هومان چه مرد منست"
  },
  {
    "poem_id": 87982,
    "vorder": 194,
    "position": 1,
    "text": "که پیل ژیان هم نبرد منست"
  },
  {
    "poem_id": 87982,
    "vorder": 195,
    "position": 0,
    "text": "چو چرخ بلند از شبه تاج کرد"
  },
  {
    "poem_id": 87982,
    "vorder": 196,
    "position": 1,
    "text": "شمامه پراگند بر لاژورد"
  },
  {
    "poem_id": 87982,
    "vorder": 197,
    "position": 0,
    "text": "طلایه ز هر سو برون تاختند"
  },
  {
    "poem_id": 87982,
    "vorder": 198,
    "position": 1,
    "text": "بهر پرده‌ای پاسبان ساختند"
  },
  {
    "poem_id": 87982,
    "vorder": 199,
    "position": 0,
    "text": "چو برزد سر از برج خرچنگ شید"
  },
  {
    "poem_id": 87982,
    "vorder": 200,
    "position": 1,
    "text": "جهان گشت چون روی رومی سپید"
  },
  {
    "poem_id": 87982,
    "vorder": 201,
    "position": 0,
    "text": "تبیره برآمد ز هر دو سرای"
  },
  {
    "poem_id": 87982,
    "vorder": 202,
    "position": 1,
    "text": "جهان شد پر از نالهٔ کر نای"
  },
  {
    "poem_id": 87982,
    "vorder": 203,
    "position": 0,
    "text": "هوا تیره گشت از فروغ درفش"
  },
  {
    "poem_id": 87982,
    "vorder": 204,
    "position": 1,
    "text": "طبر خون و شبگون و زرد و بنفش"
  },
  {
    "poem_id": 87982,
    "vorder": 205,
    "position": 0,
    "text": "کشیده همه تیغ و گرز و سنان"
  },
  {
    "poem_id": 87982,
    "vorder": 206,
    "position": 1,
    "text": "همه جنگ را گرد کرده عنان"
  },
  {
    "poem_id": 87982,
    "vorder": 207,
    "position": 0,
    "text": "تو گفتی سپهر و زمان و زمین"
  },
  {
    "poem_id": 87982,
    "vorder": 208,
    "position": 1,
    "text": "بپوشد همی چادر آهنین"
  },
  {
    "poem_id": 87982,
    "vorder": 209,
    "position": 0,
    "text": "بپرده درون شد خور تابناک"
  },
  {
    "poem_id": 87982,
    "vorder": 210,
    "position": 1,
    "text": "ز جوش سواران و از گرد و خاک"
  },
  {
    "poem_id": 87982,
    "vorder": 211,
    "position": 0,
    "text": "ز هرای اسپان و آوای کوس"
  },
  {
    "poem_id": 87982,
    "vorder": 212,
    "position": 1,
    "text": "همی آسمان بر زمین داد بوس"
  },
  {
    "poem_id": 87982,
    "vorder": 213,
    "position": 0,
    "text": "سپهدار هومان دمان پیش صف"
  },
  {
    "poem_id": 87982,
    "vorder": 214,
    "position": 1,
    "text": "یکی خشت رخشان گرفته بکف"
  },
  {
    "poem_id": 87982,
    "vorder": 215,
    "position": 0,
    "text": "همی گفت چون من برایم بجوش"
  },
  {
    "poem_id": 87982,
    "vorder": 216,
    "position": 1,
    "text": "برانگیزم اسپ و برارم خروش"
  },
  {
    "poem_id": 87982,
    "vorder": 217,
    "position": 0,
    "text": "شما یک بیک تیغها برکشید"
  },
  {
    "poem_id": 87982,
    "vorder": 218,
    "position": 1,
    "text": "سپرهای چینی بسر در کشید"
  },
  {
    "poem_id": 87982,
    "vorder": 219,
    "position": 0,
    "text": "مبینید جز یال اسپ و عنان"
  },
  {
    "poem_id": 87982,
    "vorder": 220,
    "position": 1,
    "text": "نشاید کمان و نباید سنان"
  },
  {
    "poem_id": 87982,
    "vorder": 221,
    "position": 0,
    "text": "عنان پاک بر یال اسپان نهید"
  },
  {
    "poem_id": 87982,
    "vorder": 222,
    "position": 1,
    "text": "بدانسان که آید خورید و دهید"
  },
  {
    "poem_id": 87982,
    "vorder": 223,
    "position": 0,
    "text": "بپیران چنین گفت کای پهلوان"
  },
  {
    "poem_id": 87982,
    "vorder": 224,
    "position": 1,
    "text": "تو بگشای بند سلیح گوان"
  },
  {
    "poem_id": 87982,
    "vorder": 225,
    "position": 0,
    "text": "ابا گنج دینار جفتی مکن"
  },
  {
    "poem_id": 87982,
    "vorder": 226,
    "position": 1,
    "text": "ز بهر سلیح ایچ زفتی مکن"
  },
  {
    "poem_id": 87982,
    "vorder": 227,
    "position": 0,
    "text": "که امروز گردیم پیروزگر"
  },
  {
    "poem_id": 87982,
    "vorder": 228,
    "position": 1,
    "text": "بیابد دل از اختر نیک بر"
  },
  {
    "poem_id": 87982,
    "vorder": 229,
    "position": 0,
    "text": "وزین روی لشکر سپهدار طوس"
  },
  {
    "poem_id": 87982,
    "vorder": 230,
    "position": 1,
    "text": "بیاراست برسان چشم خروش"
  },
  {
    "poem_id": 87982,
    "vorder": 231,
    "position": 0,
    "text": "بروبر یلان آفرین خواندند"
  },
  {
    "poem_id": 87982,
    "vorder": 232,
    "position": 1,
    "text": "ورا پهلوان زمین خواندند"
  },
  {
    "poem_id": 87982,
    "vorder": 233,
    "position": 0,
    "text": "که پیروزگر بود روز نبرد"
  },
  {
    "poem_id": 87982,
    "vorder": 234,
    "position": 1,
    "text": "ز هومان ویسه برآورد گرد"
  },
  {
    "poem_id": 87982,
    "vorder": 235,
    "position": 0,
    "text": "سپهبد بگودرز کشواد گفت"
  },
  {
    "poem_id": 87982,
    "vorder": 236,
    "position": 1,
    "text": "که این راز بر کس نباید نهفت"
  },
  {
    "poem_id": 87982,
    "vorder": 237,
    "position": 0,
    "text": "اگر لشکر ما پذیره شوند"
  },
  {
    "poem_id": 87982,
    "vorder": 238,
    "position": 1,
    "text": "سواران بدخواه چیره شوند"
  },
  {
    "poem_id": 87982,
    "vorder": 239,
    "position": 0,
    "text": "همه دست یکسر بیزدان زنیم"
  },
  {
    "poem_id": 87982,
    "vorder": 240,
    "position": 1,
    "text": "منی از تن خویش بفگنیم"
  },
  {
    "poem_id": 87982,
    "vorder": 241,
    "position": 0,
    "text": "مگر دست گیرد جهاندار ما"
  },
  {
    "poem_id": 87982,
    "vorder": 242,
    "position": 1,
    "text": "وگر نه بد است اختر کار ما"
  },
  {
    "poem_id": 87982,
    "vorder": 243,
    "position": 0,
    "text": "کنون نامداران زرینه کفش"
  },
  {
    "poem_id": 87982,
    "vorder": 244,
    "position": 1,
    "text": "بباشید با کاویانی درفش"
  },
  {
    "poem_id": 87982,
    "vorder": 245,
    "position": 0,
    "text": "ازین کوه پایه مجنبید هیچ"
  },
  {
    "poem_id": 87982,
    "vorder": 246,
    "position": 1,
    "text": "نه روز نبرد است و گاه بسیچ"
  },
  {
    "poem_id": 87982,
    "vorder": 247,
    "position": 0,
    "text": "همانا که از ما بهر یک دویست"
  },
  {
    "poem_id": 87982,
    "vorder": 248,
    "position": 1,
    "text": "فزونست بدخواه اگر بیش نیست"
  },
  {
    "poem_id": 87982,
    "vorder": 249,
    "position": 0,
    "text": "بدو گفت گودرز اگر کردگار"
  },
  {
    "poem_id": 87982,
    "vorder": 250,
    "position": 1,
    "text": "بگرداند از ما بد روزگار"
  },
  {
    "poem_id": 87982,
    "vorder": 251,
    "position": 0,
    "text": "به بیشی و کمی نباشد سخن"
  },
  {
    "poem_id": 87982,
    "vorder": 252,
    "position": 1,
    "text": "دل و مغز ایرانیان بد مکن"
  },
  {
    "poem_id": 87982,
    "vorder": 253,
    "position": 0,
    "text": "اگر بد بود بخشش آسمان"
  },
  {
    "poem_id": 87982,
    "vorder": 254,
    "position": 1,
    "text": "بپرهیز و بیشی نگردد زمان"
  },
  {
    "poem_id": 87982,
    "vorder": 255,
    "position": 0,
    "text": "تو لشکر بیارای و از بودنی"
  },
  {
    "poem_id": 87982,
    "vorder": 256,
    "position": 1,
    "text": "روان را مکن هیچ بشخودنی"
  }
]