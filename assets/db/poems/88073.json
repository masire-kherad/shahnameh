[
  {
    "poem_id": 88073,
    "vorder": 1,
    "position": 0,
    "text": "چو از جهن پیغام بشنید شاه"
  },
  {
    "poem_id": 88073,
    "vorder": 2,
    "position": 1,
    "text": "همی کرد خندان بدو بر نگاه"
  },
  {
    "poem_id": 88073,
    "vorder": 3,
    "position": 0,
    "text": "به پاسخ چنین گفت کای رزمجوی"
  },
  {
    "poem_id": 88073,
    "vorder": 4,
    "position": 1,
    "text": "شنیدیم سر تا سر این گفت و گوی"
  },
  {
    "poem_id": 88073,
    "vorder": 5,
    "position": 0,
    "text": "نخست آن که کردی مرا آفرین"
  },
  {
    "poem_id": 88073,
    "vorder": 6,
    "position": 1,
    "text": "همان باد بر تخت و تاج و نگین"
  },
  {
    "poem_id": 88073,
    "vorder": 7,
    "position": 0,
    "text": "درودی که دادی ز افراسیاب"
  },
  {
    "poem_id": 88073,
    "vorder": 8,
    "position": 1,
    "text": "بگفتی که او کرد مژگان پر آب"
  },
  {
    "poem_id": 88073,
    "vorder": 9,
    "position": 0,
    "text": "شنیدم همین باد بر تاج و تخت"
  },
  {
    "poem_id": 88073,
    "vorder": 10,
    "position": 1,
    "text": "مبادم مگر شاد و پیروزبخت"
  },
  {
    "poem_id": 88073,
    "vorder": 11,
    "position": 0,
    "text": "دوم آن که گفتی ز یزدان سپاس"
  },
  {
    "poem_id": 88073,
    "vorder": 12,
    "position": 1,
    "text": "که بینم همی پور یزدان شناس"
  },
  {
    "poem_id": 88073,
    "vorder": 13,
    "position": 0,
    "text": "ز شاهان گیتی دل افروزتر"
  },
  {
    "poem_id": 88073,
    "vorder": 14,
    "position": 1,
    "text": "پسندیده‌تر شاه و پیروزتر"
  },
  {
    "poem_id": 88073,
    "vorder": 15,
    "position": 0,
    "text": "مرا داد یزدان همه هرچه گفت"
  },
  {
    "poem_id": 88073,
    "vorder": 16,
    "position": 1,
    "text": "که با این هنرها خرد باد جفت"
  },
  {
    "poem_id": 88073,
    "vorder": 17,
    "position": 0,
    "text": "ترا چند خواهی سخن چرب هست"
  },
  {
    "poem_id": 88073,
    "vorder": 18,
    "position": 1,
    "text": "به دل نیستی پاک و یزدان پرست"
  },
  {
    "poem_id": 88073,
    "vorder": 19,
    "position": 0,
    "text": "کسی کو به دانش توانگر بود"
  },
  {
    "poem_id": 88073,
    "vorder": 20,
    "position": 1,
    "text": "ز گفتار کردار بهتر بود"
  },
  {
    "poem_id": 88073,
    "vorder": 21,
    "position": 0,
    "text": "فریدون فرخ ستاره نگشت"
  },
  {
    "poem_id": 88073,
    "vorder": 22,
    "position": 1,
    "text": "نه از خاک تیره همی برگذشت"
  },
  {
    "poem_id": 88073,
    "vorder": 23,
    "position": 0,
    "text": "تو گویی که من بر شوم بر سپهر"
  },
  {
    "poem_id": 88073,
    "vorder": 24,
    "position": 1,
    "text": "بشستی بر این گونه از شرم چهر"
  },
  {
    "poem_id": 88073,
    "vorder": 25,
    "position": 0,
    "text": "دلت جادوی را چو سرمایه گشت"
  },
  {
    "poem_id": 88073,
    "vorder": 26,
    "position": 1,
    "text": "سخن بر زبانت چو پیرایه گشت"
  },
  {
    "poem_id": 88073,
    "vorder": 27,
    "position": 0,
    "text": "زبان پر ز گفتار و دل پر دروغ"
  },
  {
    "poem_id": 88073,
    "vorder": 28,
    "position": 1,
    "text": "بر مرد دانا نگیرد فروغ"
  },
  {
    "poem_id": 88073,
    "vorder": 29,
    "position": 0,
    "text": "پدر کشته را شاه گیتی مخوان"
  },
  {
    "poem_id": 88073,
    "vorder": 30,
    "position": 1,
    "text": "کنون کز سیاوش نماند استخوان"
  },
  {
    "poem_id": 88073,
    "vorder": 31,
    "position": 0,
    "text": "همان مادرم را ز پرده به راه"
  },
  {
    "poem_id": 88073,
    "vorder": 32,
    "position": 1,
    "text": "کشیدی و گشتی چنین کینه خواه"
  },
  {
    "poem_id": 88073,
    "vorder": 33,
    "position": 0,
    "text": "مرا نوز نازاده از مادرم"
  },
  {
    "poem_id": 88073,
    "vorder": 34,
    "position": 1,
    "text": "همی آتش افروختی بر سرم"
  },
  {
    "poem_id": 88073,
    "vorder": 35,
    "position": 0,
    "text": "هر آن کس که او بد بدرگاه تو"
  },
  {
    "poem_id": 88073,
    "vorder": 36,
    "position": 1,
    "text": "بنفرید بر جان بی راه تو"
  },
  {
    "poem_id": 88073,
    "vorder": 37,
    "position": 0,
    "text": "که هرگز به گیتی کس آن بد نکرد"
  },
  {
    "poem_id": 88073,
    "vorder": 38,
    "position": 1,
    "text": "ز شاهان و گردان و مردان مرد"
  },
  {
    "poem_id": 88073,
    "vorder": 39,
    "position": 0,
    "text": "که بر انجمن مر زنی را کشان"
  },
  {
    "poem_id": 88073,
    "vorder": 40,
    "position": 1,
    "text": "سپارد بزرگی به مردم کشان"
  },
  {
    "poem_id": 88073,
    "vorder": 41,
    "position": 0,
    "text": "زننده همی تازیانه زند"
  },
  {
    "poem_id": 88073,
    "vorder": 42,
    "position": 1,
    "text": "که تا دخترش بچه را بفگند"
  },
  {
    "poem_id": 88073,
    "vorder": 43,
    "position": 0,
    "text": "خردمند پیران بدانجا رسید"
  },
  {
    "poem_id": 88073,
    "vorder": 44,
    "position": 1,
    "text": "بدید آن که هرگز ندید و شنید"
  },
  {
    "poem_id": 88073,
    "vorder": 45,
    "position": 0,
    "text": "چنین بود فرمان یزدان که من"
  },
  {
    "poem_id": 88073,
    "vorder": 46,
    "position": 1,
    "text": "سرافراز گردم به هر انجمن"
  },
  {
    "poem_id": 88073,
    "vorder": 47,
    "position": 0,
    "text": "گزند و بلای تو از من بگاشت"
  },
  {
    "poem_id": 88073,
    "vorder": 48,
    "position": 1,
    "text": "که با من زمانه یکی راز داشت"
  },
  {
    "poem_id": 88073,
    "vorder": 49,
    "position": 0,
    "text": "از آن پس که گشتم ز مادر جدا"
  },
  {
    "poem_id": 88073,
    "vorder": 50,
    "position": 1,
    "text": "چنانچون بود بچهٔ بینوا"
  },
  {
    "poem_id": 88073,
    "vorder": 51,
    "position": 0,
    "text": "به پیش شبانان فرستادیم"
  },
  {
    "poem_id": 88073,
    "vorder": 52,
    "position": 1,
    "text": "به پروار شیران نر دادیم"
  },
  {
    "poem_id": 88073,
    "vorder": 53,
    "position": 0,
    "text": "مرا دایه و پیشکاره شبان"
  },
  {
    "poem_id": 88073,
    "vorder": 54,
    "position": 1,
    "text": "نه آرام روز و نه خواب شبان"
  },
  {
    "poem_id": 88073,
    "vorder": 55,
    "position": 0,
    "text": "چنین بود تا روز من برگذشت"
  },
  {
    "poem_id": 88073,
    "vorder": 56,
    "position": 1,
    "text": "مرا اندر آورد پیران ز دشت"
  },
  {
    "poem_id": 88073,
    "vorder": 57,
    "position": 0,
    "text": "به پیش تو آورد و کردی نگاه"
  },
  {
    "poem_id": 88073,
    "vorder": 58,
    "position": 1,
    "text": "که هستم سزاوار تخت و کلاه"
  },
  {
    "poem_id": 88073,
    "vorder": 59,
    "position": 0,
    "text": "به سان سیاوش سرم را ز تن"
  },
  {
    "poem_id": 88073,
    "vorder": 60,
    "position": 1,
    "text": "ببری و تن هم نیابد کفن"
  },
  {
    "poem_id": 88073,
    "vorder": 61,
    "position": 0,
    "text": "زبان مرا پاک یزدان ببست"
  },
  {
    "poem_id": 88073,
    "vorder": 62,
    "position": 1,
    "text": "همان خیره ماندم به جای نشست"
  },
  {
    "poem_id": 88073,
    "vorder": 63,
    "position": 0,
    "text": "مرا بی دل و بی خرد یافتی"
  },
  {
    "poem_id": 88073,
    "vorder": 64,
    "position": 1,
    "text": "به کردار بد تیز نشتافتی"
  },
  {
    "poem_id": 88073,
    "vorder": 65,
    "position": 0,
    "text": "سیاوش نگه کن که از راستی"
  },
  {
    "poem_id": 88073,
    "vorder": 66,
    "position": 1,
    "text": "چه کرد و چه دید از بد و کاستی"
  },
  {
    "poem_id": 88073,
    "vorder": 67,
    "position": 0,
    "text": "ز گیتی بیامد ترا برگزید"
  },
  {
    "poem_id": 88073,
    "vorder": 68,
    "position": 1,
    "text": "چنان کز ره نامداران سزید"
  },
  {
    "poem_id": 88073,
    "vorder": 69,
    "position": 0,
    "text": "ز بهر تو پرداخت آیین و گاه"
  },
  {
    "poem_id": 88073,
    "vorder": 70,
    "position": 1,
    "text": "بیامد ز گیتی ترا خواند شاه"
  },
  {
    "poem_id": 88073,
    "vorder": 71,
    "position": 0,
    "text": "وفا جست و بگذاشت آن انجمن"
  },
  {
    "poem_id": 88073,
    "vorder": 72,
    "position": 1,
    "text": "بدان تا نخوانیش پیمان‌شکن"
  },
  {
    "poem_id": 88073,
    "vorder": 73,
    "position": 0,
    "text": "چو دیدی بر و گردگاه ورا"
  },
  {
    "poem_id": 88073,
    "vorder": 74,
    "position": 1,
    "text": "بزرگی و گردی و راه ورا"
  },
  {
    "poem_id": 88073,
    "vorder": 75,
    "position": 0,
    "text": "بجنبیدت آن گوهر بد ز جای"
  },
  {
    "poem_id": 88073,
    "vorder": 76,
    "position": 1,
    "text": "بیفگندی آن پاک دل را ز پای"
  },
  {
    "poem_id": 88073,
    "vorder": 77,
    "position": 0,
    "text": "سر تاجداری چنان ارجمند"
  },
  {
    "poem_id": 88073,
    "vorder": 78,
    "position": 1,
    "text": "بریدی به سان سر گوسفند"
  },
  {
    "poem_id": 88073,
    "vorder": 79,
    "position": 0,
    "text": "ز گاه منوچهر تا این زمان"
  },
  {
    "poem_id": 88073,
    "vorder": 80,
    "position": 1,
    "text": "نبودی مگر بدتن و بدگمان"
  },
  {
    "poem_id": 88073,
    "vorder": 81,
    "position": 0,
    "text": "ز تور اندر آمد زیان از نخست"
  },
  {
    "poem_id": 88073,
    "vorder": 82,
    "position": 1,
    "text": "کجا با پدر دست بد را بشست"
  },
  {
    "poem_id": 88073,
    "vorder": 83,
    "position": 0,
    "text": "پسر بر پسر بگذرد همچنین"
  },
  {
    "poem_id": 88073,
    "vorder": 84,
    "position": 1,
    "text": "نه راه بزرگی نه آیین دین"
  },
  {
    "poem_id": 88073,
    "vorder": 85,
    "position": 0,
    "text": "زدی گردن نوذر نامدار"
  },
  {
    "poem_id": 88073,
    "vorder": 86,
    "position": 1,
    "text": "پدر شاه وز تخمهٔ شهریار"
  },
  {
    "poem_id": 88073,
    "vorder": 87,
    "position": 0,
    "text": "برادرت اغریرث نیکخوی"
  },
  {
    "poem_id": 88073,
    "vorder": 88,
    "position": 1,
    "text": "کجا نیکنامی بدش آرزوی"
  },
  {
    "poem_id": 88073,
    "vorder": 89,
    "position": 0,
    "text": "بکشتی و تا بوده‌ای بدتنی"
  },
  {
    "poem_id": 88073,
    "vorder": 90,
    "position": 1,
    "text": "نه از آدم از تخم آهرمنی"
  },
  {
    "poem_id": 88073,
    "vorder": 91,
    "position": 0,
    "text": "کسی گر بدیهات گیرد شمار"
  },
  {
    "poem_id": 88073,
    "vorder": 92,
    "position": 1,
    "text": "فزون آید از گردش روزگار"
  },
  {
    "poem_id": 88073,
    "vorder": 93,
    "position": 0,
    "text": "نهالی به دوزخ فرستاده‌ای"
  },
  {
    "poem_id": 88073,
    "vorder": 94,
    "position": 1,
    "text": "نگویی که از مردمان زاده‌ای"
  },
  {
    "poem_id": 88073,
    "vorder": 95,
    "position": 0,
    "text": "دگر آن که گفتی که دیو پلید"
  },
  {
    "poem_id": 88073,
    "vorder": 96,
    "position": 1,
    "text": "دل و رای من سوی زشتی کشید"
  },
  {
    "poem_id": 88073,
    "vorder": 97,
    "position": 0,
    "text": "همین گفت ضحاک و هم جمشید"
  },
  {
    "poem_id": 88073,
    "vorder": 98,
    "position": 1,
    "text": "چو شدشان دل از نیکویی ناامید"
  },
  {
    "poem_id": 88073,
    "vorder": 99,
    "position": 0,
    "text": "که ما را دل ابلیس بی راه کرد"
  },
  {
    "poem_id": 88073,
    "vorder": 100,
    "position": 1,
    "text": "ز هر نیکویی دست کوتاه کرد"
  },
  {
    "poem_id": 88073,
    "vorder": 101,
    "position": 0,
    "text": "نه برگشت از ایشان بد روزگار"
  },
  {
    "poem_id": 88073,
    "vorder": 102,
    "position": 1,
    "text": "ز بد گوهر و گفت آموزگار"
  },
  {
    "poem_id": 88073,
    "vorder": 103,
    "position": 0,
    "text": "کسی کو بتابد سر از راستی"
  },
  {
    "poem_id": 88073,
    "vorder": 104,
    "position": 1,
    "text": "گزیند همی کژی و کاستی"
  },
  {
    "poem_id": 88073,
    "vorder": 105,
    "position": 0,
    "text": "به جنگ پشن نیز چندان سپاه"
  },
  {
    "poem_id": 88073,
    "vorder": 106,
    "position": 1,
    "text": "که پیران بکشت اندر آوردگاه"
  },
  {
    "poem_id": 88073,
    "vorder": 107,
    "position": 0,
    "text": "زمین گل شد از خون گودرزیان"
  },
  {
    "poem_id": 88073,
    "vorder": 108,
    "position": 1,
    "text": "نجویی جز از رنج و راه زیان"
  },
  {
    "poem_id": 88073,
    "vorder": 109,
    "position": 0,
    "text": "کنون آمدی با هزاران هزار"
  },
  {
    "poem_id": 88073,
    "vorder": 110,
    "position": 1,
    "text": "ز ترکان سوار از در کارزار"
  },
  {
    "poem_id": 88073,
    "vorder": 111,
    "position": 0,
    "text": "به آموی لشکر کشیدی به جنگ"
  },
  {
    "poem_id": 88073,
    "vorder": 112,
    "position": 1,
    "text": "وز ایشان به پیش من آمد پشنگ"
  },
  {
    "poem_id": 88073,
    "vorder": 113,
    "position": 0,
    "text": "فرستادیش تا ببرد سرم"
  },
  {
    "poem_id": 88073,
    "vorder": 114,
    "position": 1,
    "text": "از آن پس تو ویران کنی کشورم"
  },
  {
    "poem_id": 88073,
    "vorder": 115,
    "position": 0,
    "text": "جهاندار یزدان مرا یار گشت"
  },
  {
    "poem_id": 88073,
    "vorder": 116,
    "position": 1,
    "text": "سر بخت دشمن نگونسار گشت"
  },
  {
    "poem_id": 88073,
    "vorder": 117,
    "position": 0,
    "text": "مرا گویی اکنون که از تخت تو"
  },
  {
    "poem_id": 88073,
    "vorder": 118,
    "position": 1,
    "text": "دل‌افروز و شادانم از بخت تو"
  },
  {
    "poem_id": 88073,
    "vorder": 119,
    "position": 0,
    "text": "نگه کن که تا چون بود باورم"
  },
  {
    "poem_id": 88073,
    "vorder": 120,
    "position": 1,
    "text": "چو کردارهای تو یاد آورم"
  },
  {
    "poem_id": 88073,
    "vorder": 121,
    "position": 0,
    "text": "از این پس مرا جز به شمشیر تیز"
  },
  {
    "poem_id": 88073,
    "vorder": 122,
    "position": 1,
    "text": "نباشد سخن با تو تا رستخیز"
  },
  {
    "poem_id": 88073,
    "vorder": 123,
    "position": 0,
    "text": "بکوشم به نیروی گنج و سپاه"
  },
  {
    "poem_id": 88073,
    "vorder": 124,
    "position": 1,
    "text": "به نیک اختر و گردش هور و ماه"
  },
  {
    "poem_id": 88073,
    "vorder": 125,
    "position": 0,
