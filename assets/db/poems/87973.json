[
  {
    "poem_id": 87973,
    "vorder": 1,
    "position": 0,
    "text": "گزین کرد زان لشکر نامدار"
  },
  {
    "poem_id": 87973,
    "vorder": 2,
    "position": 1,
    "text": "سواران شمشیرزن سی‌هزار"
  },
  {
    "poem_id": 87973,
    "vorder": 3,
    "position": 0,
    "text": "برفتند نیمی گذشته ز شب"
  },
  {
    "poem_id": 87973,
    "vorder": 4,
    "position": 1,
    "text": "نه بانگ تبیره نه بوق و جلب"
  },
  {
    "poem_id": 87973,
    "vorder": 5,
    "position": 0,
    "text": "چو پیران سالار لشکر براند"
  },
  {
    "poem_id": 87973,
    "vorder": 6,
    "position": 1,
    "text": "میان یلان هفت فرسنگ ماند"
  },
  {
    "poem_id": 87973,
    "vorder": 7,
    "position": 0,
    "text": "نخستین رسیدند پیش گله"
  },
  {
    "poem_id": 87973,
    "vorder": 8,
    "position": 1,
    "text": "کجا بود بر دشت توران یله"
  },
  {
    "poem_id": 87973,
    "vorder": 9,
    "position": 0,
    "text": "گرفتند بسیار و کشتند نیز"
  },
  {
    "poem_id": 87973,
    "vorder": 10,
    "position": 1,
    "text": "نبود از بد بخت مانند چیز"
  },
  {
    "poem_id": 87973,
    "vorder": 11,
    "position": 0,
    "text": "گله‌دار و چوپان بسی کشته شد"
  },
  {
    "poem_id": 87973,
    "vorder": 12,
    "position": 1,
    "text": "سر بخت ایرانیان گشته شد"
  },
  {
    "poem_id": 87973,
    "vorder": 13,
    "position": 0,
    "text": "وزان جایگه سوی ایران سپاه"
  },
  {
    "poem_id": 87973,
    "vorder": 14,
    "position": 1,
    "text": "برفتند برسان گرد سیاه"
  },
  {
    "poem_id": 87973,
    "vorder": 15,
    "position": 0,
    "text": "همه مست بودند ایرانیان"
  },
  {
    "poem_id": 87973,
    "vorder": 16,
    "position": 1,
    "text": "گروهی نشسته گشاده میان"
  },
  {
    "poem_id": 87973,
    "vorder": 17,
    "position": 0,
    "text": "بخیمه درون گیو بیدار بود"
  },
  {
    "poem_id": 87973,
    "vorder": 18,
    "position": 1,
    "text": "سپهدار گودرز هشیار بود"
  },
  {
    "poem_id": 87973,
    "vorder": 19,
    "position": 0,
    "text": "خروش آمد و بانگ زخم تبر"
  },
  {
    "poem_id": 87973,
    "vorder": 20,
    "position": 1,
    "text": "سراسیمه شد گیو پرخاشخر"
  },
  {
    "poem_id": 87973,
    "vorder": 21,
    "position": 0,
    "text": "ستاده ابر پیش پرده‌سرای"
  },
  {
    "poem_id": 87973,
    "vorder": 22,
    "position": 1,
    "text": "یکی اسپ برگستوان‌ور به پای"
  },
  {
    "poem_id": 87973,
    "vorder": 23,
    "position": 0,
    "text": "برآشفت با خویشتن چون پلنگ"
  },
  {
    "poem_id": 87973,
    "vorder": 24,
    "position": 1,
    "text": "ز بافیدن پای آمدش ننگ"
  },
  {
    "poem_id": 87973,
    "vorder": 25,
    "position": 0,
    "text": "بیامد باسپ اندر آورد پای"
  },
  {
    "poem_id": 87973,
    "vorder": 26,
    "position": 1,
    "text": "بکردار باد اندر آمد ز جای"
  },
  {
    "poem_id": 87973,
    "vorder": 27,
    "position": 0,
    "text": "بپرده‌سرای سپهبد رسید"
  },
  {
    "poem_id": 87973,
    "vorder": 28,
    "position": 1,
    "text": "ز گرد سپه آسمان تیره دید"
  },
  {
    "poem_id": 87973,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت برخیز کامد سپاه"
  },
  {
    "poem_id": 87973,
    "vorder": 30,
    "position": 1,
    "text": "یکی گرد برخاست ز اوردگاه"
  },
  {
    "poem_id": 87973,
    "vorder": 31,
    "position": 0,
    "text": "وزان جایگه رفت نزد پدر"
  },
  {
    "poem_id": 87973,
    "vorder": 32,
    "position": 1,
    "text": "به چنگ اندرون گُرزهٔ گاو سر"
  },
  {
    "poem_id": 87973,
    "vorder": 33,
    "position": 0,
    "text": "همی گشت بر گرد لشکر چو دود"
  },
  {
    "poem_id": 87973,
    "vorder": 34,
    "position": 1,
    "text": "برانگیخت آن را که هشیار بود"
  },
  {
    "poem_id": 87973,
    "vorder": 35,
    "position": 0,
    "text": "یکی جنگ با بیژن افگند پی"
  },
  {
    "poem_id": 87973,
    "vorder": 36,
    "position": 1,
    "text": "که این دشت رزم است گر باغ می"
  },
  {
    "poem_id": 87973,
    "vorder": 37,
    "position": 0,
    "text": "وزان پس بیامد سوی کارزار"
  },
  {
    "poem_id": 87973,
    "vorder": 38,
    "position": 1,
    "text": "بره برشتابید چندی سوار"
  },
  {
    "poem_id": 87973,
    "vorder": 39,
    "position": 0,
    "text": "بدان اندکی برکشیدند نخ"
  },
  {
    "poem_id": 87973,
    "vorder": 40,
    "position": 1,
    "text": "سپاهی ز ترکان چو مور و ملخ"
  },
  {
    "poem_id": 87973,
    "vorder": 41,
    "position": 0,
    "text": "همی کرد گودرز هر سو نگاه"
  },
  {
    "poem_id": 87973,
    "vorder": 42,
    "position": 1,
    "text": "سپاه اندر آمد بگرد سپاه"
  },
  {
    "poem_id": 87973,
    "vorder": 43,
    "position": 0,
    "text": "سراسیمه شد خفته از داروگیر"
  },
  {
    "poem_id": 87973,
    "vorder": 44,
    "position": 1,
    "text": "برآمد یکی ابر بارانش تیر"
  },
  {
    "poem_id": 87973,
    "vorder": 45,
    "position": 0,
    "text": "بزیر سر مست بالین نرم"
  },
  {
    "poem_id": 87973,
    "vorder": 46,
    "position": 1,
    "text": "ز بر گُرز و گوپال و شمشیر گرم"
  },
  {
    "poem_id": 87973,
    "vorder": 47,
    "position": 0,
    "text": "سپیده چو برزد سر از برج شیر"
  },
  {
    "poem_id": 87973,
    "vorder": 48,
    "position": 1,
    "text": "به لشکر نگه کرد گیو دلیر"
  },
  {
    "poem_id": 87973,
    "vorder": 49,
    "position": 0,
    "text": "همه دشت از ایرانیان کشته دید"
  },
  {
    "poem_id": 87973,
    "vorder": 50,
    "position": 1,
    "text": "سر بخت بیدار برگشته دید"
  },
  {
    "poem_id": 87973,
    "vorder": 51,
    "position": 0,
    "text": "دریده درفش و نگونسار کوس"
  },
  {
    "poem_id": 87973,
    "vorder": 52,
    "position": 1,
    "text": "رخ زندگان تیره چون آبنوس"
  },
  {
    "poem_id": 87973,
    "vorder": 53,
    "position": 0,
    "text": "سپهبد نگه کرد و گردان ندید"
  },
  {
    "poem_id": 87973,
    "vorder": 54,
    "position": 1,
    "text": "ز لشکر دلیران و مردان ندید"
  },
  {
    "poem_id": 87973,
    "vorder": 55,
    "position": 0,
    "text": "همه رزمگه سربسر کشته بود"
  },
  {
    "poem_id": 87973,
    "vorder": 56,
    "position": 1,
    "text": "تنانشان بخون اندر آغشته بود"
  },
  {
    "poem_id": 87973,
    "vorder": 57,
    "position": 0,
    "text": "پسر بی‌پدر شد پدر بی‌پسر"
  },
  {
    "poem_id": 87973,
    "vorder": 58,
    "position": 1,
    "text": "همه لشگر گشن زیر و زبر"
  },
  {
    "poem_id": 87973,
    "vorder": 59,
    "position": 0,
    "text": "به بیچارگی روی برگاشتند"
  },
  {
    "poem_id": 87973,
    "vorder": 60,
    "position": 1,
    "text": "سراپرده و خیمه بگذاشتند"
  },
  {
    "poem_id": 87973,
    "vorder": 61,
    "position": 0,
    "text": "نه کوس و نه لشکر نه بار و بنه"
  },
  {
    "poem_id": 87973,
    "vorder": 62,
    "position": 1,
    "text": "همه میسره خسته و میمنه"
  },
  {
    "poem_id": 87973,
    "vorder": 63,
    "position": 0,
    "text": "ازین گونه لشکر سوی کاسه‌رود"
  },
  {
    "poem_id": 87973,
    "vorder": 64,
    "position": 1,
    "text": "برفتند بی‌مایه و تار و پود"
  },
  {
    "poem_id": 87973,
    "vorder": 65,
    "position": 0,
    "text": "چنین آمد این گنبد تیزگرد"
  },
  {
    "poem_id": 87973,
    "vorder": 66,
    "position": 1,
    "text": "گهی شادمانی دهد گاه درد"
  },
  {
    "poem_id": 87973,
    "vorder": 67,
    "position": 0,
    "text": "سواران توران پس پشت طوس"
  },
  {
    "poem_id": 87973,
    "vorder": 68,
    "position": 1,
    "text": "دلان پر ز کین و سران پر فسوس"
  },
  {
    "poem_id": 87973,
    "vorder": 69,
    "position": 0,
    "text": "همی گُرز بارید گویی ز ابر"
  },
  {
    "poem_id": 87973,
    "vorder": 70,
    "position": 1,
    "text": "پس پشت بر جوشن و خود و گبر"
  },
  {
    "poem_id": 87973,
    "vorder": 71,
    "position": 0,
    "text": "نبد کس برزم اندرون پایدار"
  },
  {
    "poem_id": 87973,
    "vorder": 72,
    "position": 1,
    "text": "همه کوه کردند گردان حصار"
  },
  {
    "poem_id": 87973,
    "vorder": 73,
    "position": 0,
    "text": "فرومانده اسپان و مردان جنگ"
  },
  {
    "poem_id": 87973,
    "vorder": 74,
    "position": 1,
    "text": "یکی را نبد هوش و توش و نه هنگ"
  },
  {
    "poem_id": 87973,
    "vorder": 75,
    "position": 0,
    "text": "سپاهی ازین گونه گشتند باز"
  },
  {
    "poem_id": 87973,
    "vorder": 76,
    "position": 1,
    "text": "شده مانده از رزم و راه دراز"
  },
  {
    "poem_id": 87973,
    "vorder": 77,
    "position": 0,
    "text": "ز هامون سپهبد سوی کوه شد"
  },
  {
    "poem_id": 87973,
    "vorder": 78,
    "position": 1,
    "text": "ز پیکار ترکان بی‌اندوه شد"
  },
  {
    "poem_id": 87973,
    "vorder": 79,
    "position": 0,
    "text": "فراوان کم آمد ز ایرانیان"
  },
  {
    "poem_id": 87973,
    "vorder": 80,
    "position": 1,
    "text": "برآمد خروشی بدرد از میان"
  },
  {
    "poem_id": 87973,
    "vorder": 81,
    "position": 0,
    "text": "همه خسته و بسته بد هرک زیست"
  },
  {
    "poem_id": 87973,
    "vorder": 82,
    "position": 1,
    "text": "شد آن کشته بر خسته باید گریست"
  },
  {
    "poem_id": 87973,
    "vorder": 83,
    "position": 0,
    "text": "نه تاج و نه تخت و نه پرده‌سرای"
  },
  {
    "poem_id": 87973,
    "vorder": 84,
    "position": 1,
    "text": "نه اسپ و نه مردان جنگی بپای"
  },
  {
    "poem_id": 87973,
    "vorder": 85,
    "position": 0,
    "text": "نه آباد بوم نه مردان کار"
  },
  {
    "poem_id": 87973,
    "vorder": 86,
    "position": 1,
    "text": "نه آن خستگانرا کسی خواستار"
  },
  {
    "poem_id": 87973,
    "vorder": 87,
    "position": 0,
    "text": "پدر بر پسر چند گریان شده"
  },
  {
    "poem_id": 87973,
    "vorder": 88,
    "position": 1,
    "text": "وزان خستگان چند بریان شده"
  },
  {
    "poem_id": 87973,
    "vorder": 89,
    "position": 0,
    "text": "چنین است رسم جهان جهان"
  },
  {
    "poem_id": 87973,
    "vorder": 90,
    "position": 1,
    "text": "که کردار خویش از تو دارد نهان"
  },
  {
    "poem_id": 87973,
    "vorder": 91,
    "position": 0,
    "text": "همی با تو در پرده بازی کند"
  },
  {
    "poem_id": 87973,
    "vorder": 92,
    "position": 1,
    "text": "ز بیرون ترا بی‌نیازی کند"
  },
  {
    "poem_id": 87973,
    "vorder": 93,
    "position": 0,
    "text": "ز باد آمدی رفت خواهی به گرد"
  },
  {
    "poem_id": 87973,
    "vorder": 94,
    "position": 1,
    "text": "چه دانی که با تو چه خواهند کرد"
  },
  {
    "poem_id": 87973,
    "vorder": 95,
    "position": 0,
    "text": "ببند درازیم و در چنگ آز"
  },
  {
    "poem_id": 87973,
    "vorder": 96,
    "position": 1,
    "text": "ندانیم باز آشکارا ز راز"
  },
  {
    "poem_id": 87973,
    "vorder": 97,
    "position": 0,
    "text": "دو بهره ز ایرانیان کشته بود"
  },
  {
    "poem_id": 87973,
    "vorder": 98,
    "position": 1,
    "text": "دگر خسته از رزم برگشته بود"
  },
  {
    "poem_id": 87973,
    "vorder": 99,
    "position": 0,
    "text": "سپهبد ز پیکار دیوانه گشت"
  },
  {
    "poem_id": 87973,
    "vorder": 100,
    "position": 1,
    "text": "دلش با خرد همچو بیگانه گشت"
  },
  {
    "poem_id": 87973,
    "vorder": 101,
    "position": 0,
    "text": "بلشکرگه اندر می و خوان و بزم"
  },
  {
    "poem_id": 87973,
    "vorder": 102,
    "position": 1,
    "text": "سپاه آرزو کرد بر جای رزم"
  },
  {
    "poem_id": 87973,
    "vorder": 103,
    "position": 0,
    "text": "جهاندیده گودرز با پیر سر"
  },
  {
    "poem_id": 87973,
    "vorder": 104,
    "position": 1,
    "text": "نه پور و نبیره نه بوم و نه بر"
  },
  {
    "poem_id": 87973,
    "vorder": 105,
    "position": 0,
    "text": "نه آن خستگان را خورش نه پزشک"
  },
  {
    "poem_id": 87973,
    "vorder": 106,
    "position": 1,
    "text": "همه جای غم بود و خونین سرشک"
  },
  {
    "poem_id": 87973,
    "vorder": 107,
    "position": 0,
    "text": "جهاندیدگان پیش اوی آمدند"
  },
  {
    "poem_id": 87973,
    "vorder": 108,
    "position": 1,
    "text": "شکسته دل و راه‌جوی آمدند"
  },
  {
    "poem_id": 87973,
    "vorder": 109,
    "position": 0,
    "text": "یکی دیدبان بر سر کوه کرد"
  },
  {
    "poem_id": 87973,
    "vorder": 110,
    "position": 1,
    "text": "کجا دیدگان سوی انبوه کرد"
  },
  {
    "poem_id": 87973,
    "vorder": 111,
    "position": 0,
    "text": "طلایه فرستاد بر هر سویی"
  },
  {
    "poem_id": 87973,
    "vorder": 112,
    "position": 1,
    "text": "مگر یابد آن درد را دارویی"
  },
  {
    "poem_id": 87973,
    "vorder": 113,
    "position": 0,
    "text": "یکی نامداری ز ایرانیان"
  },
  {
    "poem_id": 87973,
    "vorder": 114,
    "position": 1,
    "text": "بفرمود تا تنگ بندد میان"
  },
  {
    "poem_id": 87973,
    "vorder": 115,
    "position": 0,
    "text": "دهد شاه را آگهی زین سخن"
  },
  {
    "poem_id": 87973,
    "vorder": 116,
    "position": 1,
    "text": "که سالار لشکر چه افگند بن"
  },
  {
    "poem_id": 87973,
    "vorder": 117,
    "position": 0,
    "text": "چه روز بد آمد بایرانیان"
  },
  {
    "poem_id": 87973,
    "vorder": 118,
    "position": 1,
    "text": "سران را ز بخشش سرآمد زیان"
  },
  {
    "poem_id": 87973,
    "vorder": 119,
    "position": 0,
    "text": "رونده بر شاه برد آگهی"
  },
  {
    "poem_id": 87973,
    "vorder": 120,
    "position": 1,
    "text": "که تیره شد آن روزگار مهی"
  },
  {
    "poem_id": 87973,
    "vorder": 121,
    "position": 0,
    "text": "چو شاه دلیر این سخنها شنید"
  },
  {
    "poem_id": 87973,
    "vorder": 122,
    "position": 1,
    "text": "بجوشید وز غم دلش بردمید"
  },
  {
    "poem_id": 87973,
    "vorder": 123,
    "position": 0,
    "text": "ز کار برادر پر از درد بود"
  },
  {
    "poem_id": 87973,
    "vorder": 124,
    "position": 1,
    "text": "بران درد بر درد لشکر فزود"
  },
  {
    "poem_id": 87973,
    "vorder": 125,
    "position": 0,
    "text": "زبان کرد گویا بنفرین طوس"
  },
  {
