[
  {
    "poem_id": 1640,
    "vorder": 1,
    "position": 0,
    "text": "سکندر چو بر تخت بنشست گفت"
  },
  {
    "poem_id": 1640,
    "vorder": 2,
    "position": 1,
    "text": "که با جان شاهان خرد باد جفت"
  },
  {
    "poem_id": 1640,
    "vorder": 3,
    "position": 0,
    "text": "که پیروزگر در جهان ایزدست"
  },
  {
    "poem_id": 1640,
    "vorder": 4,
    "position": 1,
    "text": "جهاندار کز وی نترسد بدست"
  },
  {
    "poem_id": 1640,
    "vorder": 5,
    "position": 0,
    "text": "بد و نیک هم بگذرد بی‌گمان"
  },
  {
    "poem_id": 1640,
    "vorder": 6,
    "position": 1,
    "text": "رهایی نباشد ز چنگ زمان"
  },
  {
    "poem_id": 1640,
    "vorder": 7,
    "position": 0,
    "text": "هرانکس که آید بدین بارگاه"
  },
  {
    "poem_id": 1640,
    "vorder": 8,
    "position": 1,
    "text": "که باشد ز ما سوی ما دادخواه"
  },
  {
    "poem_id": 1640,
    "vorder": 9,
    "position": 0,
    "text": "اگر گاه بار آید ار نیم‌شب"
  },
  {
    "poem_id": 1640,
    "vorder": 10,
    "position": 1,
    "text": "به پاسخ رسد چون گشاید دو لب"
  },
  {
    "poem_id": 1640,
    "vorder": 11,
    "position": 0,
    "text": "چو پیروزگر فرهی دادمان"
  },
  {
    "poem_id": 1640,
    "vorder": 12,
    "position": 1,
    "text": "در بخت پیروز بگشادمان"
  },
  {
    "poem_id": 1640,
    "vorder": 13,
    "position": 0,
    "text": "همه زیردستان بیابند بهر"
  },
  {
    "poem_id": 1640,
    "vorder": 14,
    "position": 1,
    "text": "به کوه و بیابان و دریا و شهر"
  },
  {
    "poem_id": 1640,
    "vorder": 15,
    "position": 0,
    "text": "نخواهیم باژ از جهان پنج سال"
  },
  {
    "poem_id": 1640,
    "vorder": 16,
    "position": 1,
    "text": "جز آنکس که گوید که هستم همال"
  },
  {
    "poem_id": 1640,
    "vorder": 17,
    "position": 0,
    "text": "به درویش بخشیم بسیار چیز"
  },
  {
    "poem_id": 1640,
    "vorder": 18,
    "position": 1,
    "text": "ز دارنده چیزی نخواهیم نیز"
  },
  {
    "poem_id": 1640,
    "vorder": 19,
    "position": 0,
    "text": "چو اسکندر این نیکویها بگفت"
  },
  {
    "poem_id": 1640,
    "vorder": 20,
    "position": 1,
    "text": "دل پادشا گشت با داد جفت"
  },
  {
    "poem_id": 1640,
    "vorder": 21,
    "position": 0,
    "text": "ز ایوان برآمد یکی آفرین"
  },
  {
    "poem_id": 1640,
    "vorder": 22,
    "position": 1,
    "text": "بران دادگر شهریار زمین"
  },
  {
    "poem_id": 1640,
    "vorder": 23,
    "position": 0,
    "text": "ازان پس پراگنده شد انجمن"
  },
  {
    "poem_id": 1640,
    "vorder": 24,
    "position": 1,
    "text": "جهاندار بنشست با رای‌زن"
  }
]