[
  {
    "poem_id": 88104,
    "vorder": 1,
    "position": 0,
    "text": "چو بهری ز تیره شب اندر چمید"
  },
  {
    "poem_id": 88104,
    "vorder": 2,
    "position": 1,
    "text": "کی نامور پیش چشمه رسید"
  },
  {
    "poem_id": 88104,
    "vorder": 3,
    "position": 0,
    "text": "بر آن آب روشن سر و تن بشست"
  },
  {
    "poem_id": 88104,
    "vorder": 4,
    "position": 1,
    "text": "همی خواند اندر نهان زند و است"
  },
  {
    "poem_id": 88104,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت با نامور بخردان"
  },
  {
    "poem_id": 88104,
    "vorder": 6,
    "position": 1,
    "text": "که باشید پدرود تا جاودان"
  },
  {
    "poem_id": 88104,
    "vorder": 7,
    "position": 0,
    "text": "کنون چون برآرد سنان آفتاب"
  },
  {
    "poem_id": 88104,
    "vorder": 8,
    "position": 1,
    "text": "مبینید دیگر مرا جز به خواب"
  },
  {
    "poem_id": 88104,
    "vorder": 9,
    "position": 0,
    "text": "شما بازگردید ز این ریگ خشک"
  },
  {
    "poem_id": 88104,
    "vorder": 10,
    "position": 1,
    "text": "مباشید اگر بارد از ابر مشک"
  },
  {
    "poem_id": 88104,
    "vorder": 11,
    "position": 0,
    "text": "ز کوه اندر آید یکی باد سخت"
  },
  {
    "poem_id": 88104,
    "vorder": 12,
    "position": 1,
    "text": "کجا بشکند شاخ و برگ درخت"
  },
  {
    "poem_id": 88104,
    "vorder": 13,
    "position": 0,
    "text": "ببارد بسی برف ز ابر سیاه"
  },
  {
    "poem_id": 88104,
    "vorder": 14,
    "position": 1,
    "text": "شما سوی ایران نیابید راه"
  },
  {
    "poem_id": 88104,
    "vorder": 15,
    "position": 0,
    "text": "سر مهتران زآن سخن شد گران"
  },
  {
    "poem_id": 88104,
    "vorder": 16,
    "position": 1,
    "text": "بخفتند با درد کنداواران"
  },
  {
    "poem_id": 88104,
    "vorder": 17,
    "position": 0,
    "text": "چو از کوه خورشید سر برکشید"
  },
  {
    "poem_id": 88104,
    "vorder": 18,
    "position": 1,
    "text": "ز چشم مهان شاه شد ناپدید"
  },
  {
    "poem_id": 88104,
    "vorder": 19,
    "position": 0,
    "text": "ببودند ز آن جایگه شاه‌جوی"
  },
  {
    "poem_id": 88104,
    "vorder": 20,
    "position": 1,
    "text": "به ریگ بیابان نهادند روی"
  },
  {
    "poem_id": 88104,
    "vorder": 21,
    "position": 0,
    "text": "ز خسرو ندیدند جایی نشان"
  },
  {
    "poem_id": 88104,
    "vorder": 22,
    "position": 1,
    "text": "ز ره بازگشتند چون بیهشان"
  },
  {
    "poem_id": 88104,
    "vorder": 23,
    "position": 0,
    "text": "همه تنگ‌دل گشته و تافته"
  },
  {
    "poem_id": 88104,
    "vorder": 24,
    "position": 1,
    "text": "سپرده زمین شاه نایافته"
  },
  {
    "poem_id": 88104,
    "vorder": 25,
    "position": 0,
    "text": "خروشان بدان چشمه بازآمدند"
  },
  {
    "poem_id": 88104,
    "vorder": 26,
    "position": 1,
    "text": "پر از غم دل و با گداز آمدند"
  },
  {
    "poem_id": 88104,
    "vorder": 27,
    "position": 0,
    "text": "بر آن آب هر کس که آمد فرود"
  },
  {
    "poem_id": 88104,
    "vorder": 28,
    "position": 1,
    "text": "همی داد شاه جهان را درود"
  },
  {
    "poem_id": 88104,
    "vorder": 29,
    "position": 0,
    "text": "فریبرز گفت آنچه خسرو بگفت"
  },
  {
    "poem_id": 88104,
    "vorder": 30,
    "position": 1,
    "text": "که با جان پاکش خرد باد جفت"
  },
  {
    "poem_id": 88104,
    "vorder": 31,
    "position": 0,
    "text": "چو آسوده باشیم و چیزی خوریم"
  },
  {
    "poem_id": 88104,
    "vorder": 32,
    "position": 1,
    "text": "یک امشب از این چشمه برنگذریم"
  },
  {
    "poem_id": 88104,
    "vorder": 33,
    "position": 0,
    "text": "زمین گرم و نرم است و روشن هوا"
  },
  {
    "poem_id": 88104,
    "vorder": 34,
    "position": 1,
    "text": "بدین رنجگی نیست رفتن روا"
  },
  {
    "poem_id": 88104,
    "vorder": 35,
    "position": 0,
    "text": "بر آن چشمه یکسر فرود آمدند"
  },
  {
    "poem_id": 88104,
    "vorder": 36,
    "position": 1,
    "text": "ز خسرو بسی داستانها زدند"
  },
  {
    "poem_id": 88104,
    "vorder": 37,
    "position": 0,
    "text": "که چونین شگفتی نبیند کسی"
  },
  {
    "poem_id": 88104,
    "vorder": 38,
    "position": 1,
    "text": "وگر در زمانه بماند بسی"
  },
  {
    "poem_id": 88104,
    "vorder": 39,
    "position": 0,
    "text": "کز این رفتن شاه نادیده‌ایم"
  },
  {
    "poem_id": 88104,
    "vorder": 40,
    "position": 1,
    "text": "ز گردنکشان نیز نشنیده‌ایم"
  },
  {
    "poem_id": 88104,
    "vorder": 41,
    "position": 0,
    "text": "دریغ آن بلند اختر و رای او"
  },
  {
    "poem_id": 88104,
    "vorder": 42,
    "position": 1,
    "text": "بزرگی و دیدار و بالای او"
  },
  {
    "poem_id": 88104,
    "vorder": 43,
    "position": 0,
    "text": "خردمند از این کار خندان شود"
  },
  {
    "poem_id": 88104,
    "vorder": 44,
    "position": 1,
    "text": "که زنده کسی پیش یزدان شود"
  },
  {
    "poem_id": 88104,
    "vorder": 45,
    "position": 0,
    "text": "که داند به گیتی که او را چه بود"
  },
  {
    "poem_id": 88104,
    "vorder": 46,
    "position": 1,
    "text": "چه گوییم و گوش که یارد شنود"
  },
  {
    "poem_id": 88104,
    "vorder": 47,
    "position": 0,
    "text": "بدان نامداران چنین گفت گیو"
  },
  {
    "poem_id": 88104,
    "vorder": 48,
    "position": 1,
    "text": "که هرگز چنین نشنود گوش نیو"
  },
  {
    "poem_id": 88104,
    "vorder": 49,
    "position": 0,
    "text": "به مردی و بخشش به داد و هنر"
  },
  {
    "poem_id": 88104,
    "vorder": 50,
    "position": 1,
    "text": "به دیدار و بالا و فر و گهر"
  },
  {
    "poem_id": 88104,
    "vorder": 51,
    "position": 0,
    "text": "به رزم اندرون پیل بد با سپاه"
  },
  {
    "poem_id": 88104,
    "vorder": 52,
    "position": 1,
    "text": "به بزم اندرون ماه بد با کلاه"
  }
]