[
  {
    "poem_id": 87954,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تیغ از میان برکشید"
  },
  {
    "poem_id": 87954,
    "vorder": 2,
    "position": 1,
    "text": "شب تیره گشت از جهان ناپدید"
  },
  {
    "poem_id": 87954,
    "vorder": 3,
    "position": 0,
    "text": "تبیره برآمد ز درگاه شاه"
  },
  {
    "poem_id": 87954,
    "vorder": 4,
    "position": 1,
    "text": "به سر برنهادند گردان کلاه"
  },
  {
    "poem_id": 87954,
    "vorder": 5,
    "position": 0,
    "text": "چو طوس و چو گودرز و گیو دلیر"
  },
  {
    "poem_id": 87954,
    "vorder": 6,
    "position": 1,
    "text": "چو گرگین و گستهم و بهرام شیر"
  },
  {
    "poem_id": 87954,
    "vorder": 7,
    "position": 0,
    "text": "گرانمایگان نزد شاه آمدند"
  },
  {
    "poem_id": 87954,
    "vorder": 8,
    "position": 1,
    "text": "بران نامور بارگاه آمدند"
  },
  {
    "poem_id": 87954,
    "vorder": 9,
    "position": 0,
    "text": "به نخچیر شد شهریار جهان"
  },
  {
    "poem_id": 87954,
    "vorder": 10,
    "position": 1,
    "text": "ابا رستم نامور پهلوان"
  },
  {
    "poem_id": 87954,
    "vorder": 11,
    "position": 0,
    "text": "ز لشکر برفتند آزادگان"
  },
  {
    "poem_id": 87954,
    "vorder": 12,
    "position": 1,
    "text": "چو گیو و چو گودرز کشوادگان"
  },
  {
    "poem_id": 87954,
    "vorder": 13,
    "position": 0,
    "text": "سپاهی که شد تیره خورشید و ماه"
  },
  {
    "poem_id": 87954,
    "vorder": 14,
    "position": 1,
    "text": "همی رفت با یوز و با باز شاه"
  },
  {
    "poem_id": 87954,
    "vorder": 15,
    "position": 0,
    "text": "همه بوم ایران سراسر بگشت"
  },
  {
    "poem_id": 87954,
    "vorder": 16,
    "position": 1,
    "text": "به آباد و ویرانی اندر گذشت"
  },
  {
    "poem_id": 87954,
    "vorder": 17,
    "position": 0,
    "text": "هران بوم و برکان نه آباد بود"
  },
  {
    "poem_id": 87954,
    "vorder": 18,
    "position": 1,
    "text": "تبه بود و ویران ز بیداد بود"
  },
  {
    "poem_id": 87954,
    "vorder": 19,
    "position": 0,
    "text": "درم داد و آباد کردش ز گنج"
  },
  {
    "poem_id": 87954,
    "vorder": 20,
    "position": 1,
    "text": "ز داد و ز بخشش نیامدش رنج"
  },
  {
    "poem_id": 87954,
    "vorder": 21,
    "position": 0,
    "text": "به هر شهر بنشست و بنهاد تخت"
  },
  {
    "poem_id": 87954,
    "vorder": 22,
    "position": 1,
    "text": "چنانچون بود خسرو نیک بخت"
  },
  {
    "poem_id": 87954,
    "vorder": 23,
    "position": 0,
    "text": "همه بدره و جام و می خواستی"
  },
  {
    "poem_id": 87954,
    "vorder": 24,
    "position": 1,
    "text": "به دینار گیتی بیاراستی"
  },
  {
    "poem_id": 87954,
    "vorder": 25,
    "position": 0,
    "text": "وز آنجا سوی شهر دیگر شدی"
  },
  {
    "poem_id": 87954,
    "vorder": 26,
    "position": 1,
    "text": "همی با می و تخت و افسر شدی"
  },
  {
    "poem_id": 87954,
    "vorder": 27,
    "position": 0,
    "text": "همی رفت تا آذرابادگان"
  },
  {
    "poem_id": 87954,
    "vorder": 28,
    "position": 1,
    "text": "ابا او بزرگان و آزادگان"
  },
  {
    "poem_id": 87954,
    "vorder": 29,
    "position": 0,
    "text": "گهی باده خورد و گهی تاخت اسپ"
  },
  {
    "poem_id": 87954,
    "vorder": 30,
    "position": 1,
    "text": "بیامد سوی خان آذرگشسپ"
  },
  {
    "poem_id": 87954,
    "vorder": 31,
    "position": 0,
    "text": "جهان‌آفرین را ستایش گرفت"
  },
  {
    "poem_id": 87954,
    "vorder": 32,
    "position": 1,
    "text": "به آتشکده در نیایش گرفت"
  },
  {
    "poem_id": 87954,
    "vorder": 33,
    "position": 0,
    "text": "بیامد خرامان ازان جایگاه"
  },
  {
    "poem_id": 87954,
    "vorder": 34,
    "position": 1,
    "text": "نهادند سر سوی کاوس شاه"
  },
  {
    "poem_id": 87954,
    "vorder": 35,
    "position": 0,
    "text": "نشستند هر دو به هم شادمان"
  },
  {
    "poem_id": 87954,
    "vorder": 36,
    "position": 1,
    "text": "نبودند جز شادمان یک زمان"
  },
  {
    "poem_id": 87954,
    "vorder": 37,
    "position": 0,
    "text": "چو پر شد سر از جام روشن‌گلاب"
  },
  {
    "poem_id": 87954,
    "vorder": 38,
    "position": 1,
    "text": "به خواب و به آسایش آمد شتاب"
  },
  {
    "poem_id": 87954,
    "vorder": 39,
    "position": 0,
    "text": "چو روز درخشان برآورد چاک"
  },
  {
    "poem_id": 87954,
    "vorder": 40,
    "position": 1,
    "text": "بگسترد یاقوت بر تیره خاک"
  },
  {
    "poem_id": 87954,
    "vorder": 41,
    "position": 0,
    "text": "جهاندار بنشست و کاوس کی"
  },
  {
    "poem_id": 87954,
    "vorder": 42,
    "position": 1,
    "text": "دو شاه سرافراز و دو نیک‌پی"
  },
  {
    "poem_id": 87954,
    "vorder": 43,
    "position": 0,
    "text": "ابا رستم گرد و دستان به هم"
  },
  {
    "poem_id": 87954,
    "vorder": 44,
    "position": 1,
    "text": "همی گفت کاوس هر بیش و کم"
  },
  {
    "poem_id": 87954,
    "vorder": 45,
    "position": 0,
    "text": "از افراسیاب اندر آمد نخست"
  },
  {
    "poem_id": 87954,
    "vorder": 46,
    "position": 1,
    "text": "دو رخ را به خون دو دیده بشست"
  },
  {
    "poem_id": 87954,
    "vorder": 47,
    "position": 0,
    "text": "بگفت آنکه او با سیاوش چه کرد"
  },
  {
    "poem_id": 87954,
    "vorder": 48,
    "position": 1,
    "text": "از ایران سراسر برآورد گرد"
  },
  {
    "poem_id": 87954,
    "vorder": 49,
    "position": 0,
    "text": "بسی پهلوانان که بیجان شدند"
  },
  {
    "poem_id": 87954,
    "vorder": 50,
    "position": 1,
    "text": "زن و کودک خرد پیچان شدند"
  },
  {
    "poem_id": 87954,
    "vorder": 51,
    "position": 0,
    "text": "بسی شهر بینی ز ایران خراب"
  },
  {
    "poem_id": 87954,
    "vorder": 52,
    "position": 1,
    "text": "تبه گشته از رنج افراسیاب"
  },
  {
    "poem_id": 87954,
    "vorder": 53,
    "position": 0,
    "text": "ترا ایزدی هرچ بایدت هست"
  },
  {
    "poem_id": 87954,
    "vorder": 54,
    "position": 1,
    "text": "ز بالا و از دانش و زور دست"
  },
  {
    "poem_id": 87954,
    "vorder": 55,
    "position": 0,
    "text": "ز فر تمامی و نیک‌اختری"
  },
  {
    "poem_id": 87954,
    "vorder": 56,
    "position": 1,
    "text": "ز شاهان به هر گونه‌ای برتری"
  },
  {
    "poem_id": 87954,
    "vorder": 57,
    "position": 0,
    "text": "کنون از تو سوگند خواهم یکی"
  },
  {
    "poem_id": 87954,
    "vorder": 58,
    "position": 1,
    "text": "نباید که پیچی ز داد اندکی"
  },
  {
    "poem_id": 87954,
    "vorder": 59,
    "position": 0,
    "text": "که پرکین کنی دل ز افراسیاب"
  },
  {
    "poem_id": 87954,
    "vorder": 60,
    "position": 1,
    "text": "دمی آتش اندر نیاری به آب"
  },
  {
    "poem_id": 87954,
    "vorder": 61,
    "position": 0,
    "text": "ز خویشی مادر بدو نگروی"
  },
  {
    "poem_id": 87954,
    "vorder": 62,
    "position": 1,
    "text": "نپیچی و گفت کسی نشمری"
  },
  {
    "poem_id": 87954,
    "vorder": 63,
    "position": 0,
    "text": "به گنج و فزونی نگیری فریب"
  },
  {
    "poem_id": 87954,
    "vorder": 64,
    "position": 1,
    "text": "همان گر فراز آیدت گر نشیب"
  },
  {
    "poem_id": 87954,
    "vorder": 65,
    "position": 0,
    "text": "به تاج و به تخت و نگین و کلاه"
  },
  {
    "poem_id": 87954,
    "vorder": 66,
    "position": 1,
    "text": "به گفتار با او نگردی ز راه"
  },
  {
    "poem_id": 87954,
    "vorder": 67,
    "position": 0,
    "text": "بگویم که بنیاد سوگند چیست"
  },
  {
    "poem_id": 87954,
    "vorder": 68,
    "position": 1,
    "text": "خرد را و جان ترا پند چیست"
  },
  {
    "poem_id": 87954,
    "vorder": 69,
    "position": 0,
    "text": "بگویی به دادار خورشید و ماه"
  },
  {
    "poem_id": 87954,
    "vorder": 70,
    "position": 1,
    "text": "به تیغ و به مهر و به تخت و کلاه"
  },
  {
    "poem_id": 87954,
    "vorder": 71,
    "position": 0,
    "text": "به فر و به نیک‌اختر ایزدی"
  },
  {
    "poem_id": 87954,
    "vorder": 72,
    "position": 1,
    "text": "که هرگز نپیچی به سوی بدی"
  },
  {
    "poem_id": 87954,
    "vorder": 73,
    "position": 0,
    "text": "میانجی نخواهی جز از تیغ و گرز"
  },
  {
    "poem_id": 87954,
    "vorder": 74,
    "position": 1,
    "text": "منش برز داری و بالای برز"
  },
  {
    "poem_id": 87954,
    "vorder": 75,
    "position": 0,
    "text": "چو بشنید زو شهریار جوان"
  },
  {
    "poem_id": 87954,
    "vorder": 76,
    "position": 1,
    "text": "سوی آتش آورد روی و روان"
  },
  {
    "poem_id": 87954,
    "vorder": 77,
    "position": 0,
    "text": "به دادار دارنده سوگند خورد"
  },
  {
    "poem_id": 87954,
    "vorder": 78,
    "position": 1,
    "text": "به روز سپید و شب لاژورد"
  },
  {
    "poem_id": 87954,
    "vorder": 79,
    "position": 0,
    "text": "به خورشید و ماه و به تخت و کلاه"
  },
  {
    "poem_id": 87954,
    "vorder": 80,
    "position": 1,
    "text": "به مهر و به تیغ و به دیهیم شاه"
  },
  {
    "poem_id": 87954,
    "vorder": 81,
    "position": 0,
    "text": "که هرگز نپیچم سوی مهر اوی"
  },
  {
    "poem_id": 87954,
    "vorder": 82,
    "position": 1,
    "text": "نبینم بخواب اندرون چهر اوی"
  },
  {
    "poem_id": 87954,
    "vorder": 83,
    "position": 0,
    "text": "یکی خط بنوشت بر پهلوی"
  },
  {
    "poem_id": 87954,
    "vorder": 84,
    "position": 1,
    "text": "به مشکاب بر دفتر خسروی"
  },
  {
    "poem_id": 87954,
    "vorder": 85,
    "position": 0,
    "text": "گوا بود دستان و رستم برین"
  },
  {
    "poem_id": 87954,
    "vorder": 86,
    "position": 1,
    "text": "بزرگان لشکر همه همچنین"
  },
  {
    "poem_id": 87954,
    "vorder": 87,
    "position": 0,
    "text": "به زنهار بر دست رستم نهاد"
  },
  {
    "poem_id": 87954,
    "vorder": 88,
    "position": 1,
    "text": "چنان خط و سوگند و آن رسم و داد"
  },
  {
    "poem_id": 87954,
    "vorder": 89,
    "position": 0,
    "text": "ازان پس همی خوان و می خواستند"
  },
  {
    "poem_id": 87954,
    "vorder": 90,
    "position": 1,
    "text": "ز هر گونه مجلس بیاراستند"
  },
  {
    "poem_id": 87954,
    "vorder": 91,
    "position": 0,
    "text": "ببودند یک هفته با رود و می"
  },
  {
    "poem_id": 87954,
    "vorder": 92,
    "position": 1,
    "text": "بزرگان به ایوان کاوس کی"
  },
  {
    "poem_id": 87954,
    "vorder": 93,
    "position": 0,
    "text": "جهاندار هشتم سر و تن بشست"
  },
  {
    "poem_id": 87954,
    "vorder": 94,
    "position": 1,
    "text": "بیاسود و جای نیایش بجست"
  },
  {
    "poem_id": 87954,
    "vorder": 95,
    "position": 0,
    "text": "به پیش خداوند گردان سپهر"
  },
  {
    "poem_id": 87954,
    "vorder": 96,
    "position": 1,
    "text": "برفت آفرین را بگسترد چهر"
  },
  {
    "poem_id": 87954,
    "vorder": 97,
    "position": 0,
    "text": "شب تیره تا برکشید آفتاب"
  },
  {
    "poem_id": 87954,
    "vorder": 98,
    "position": 1,
    "text": "خروشان همی بود دیده پرآب"
  },
  {
    "poem_id": 87954,
    "vorder": 99,
    "position": 0,
    "text": "چنین گفت کای دادگر یک خدای"
  },
  {
    "poem_id": 87954,
    "vorder": 100,
    "position": 1,
    "text": "جهاندار و روزی ده و رهنمای"
  },
  {
    "poem_id": 87954,
    "vorder": 101,
    "position": 0,
    "text": "به روز جوانی تو کردی رها"
  },
  {
    "poem_id": 87954,
    "vorder": 102,
    "position": 1,
    "text": "مرا بی‌سپاه از دم اژدها"
  },
  {
    "poem_id": 87954,
    "vorder": 103,
    "position": 0,
    "text": "تو دانی که سالار توران سپاه"
  },
  {
    "poem_id": 87954,
    "vorder": 104,
    "position": 1,
    "text": "نه پرهیز داند نه شرم گناه"
  },
  {
    "poem_id": 87954,
    "vorder": 105,
    "position": 0,
    "text": "به ویران و آباد نفرین اوست"
  },
  {
    "poem_id": 87954,
    "vorder": 106,
    "position": 1,
    "text": "دل بیگناهان پر از کین اوست"
  },
  {
    "poem_id": 87954,
    "vorder": 107,
    "position": 0,
    "text": "به بیداد خون سیاوش بریخت"
  },
  {
    "poem_id": 87954,
    "vorder": 108,
    "position": 1,
    "text": "بدین مرز باران آتش ببیخت"
  },
  {
    "poem_id": 87954,
    "vorder": 109,
    "position": 0,
    "text": "دل شهریاران پر از بیم اوست"
  },
  {
    "poem_id": 87954,
    "vorder": 110,
    "position": 1,
    "text": "بلا بر زمین تخت و دیهیم اوست"
  },
  {
    "poem_id": 87954,
    "vorder": 111,
    "position": 0,
    "text": "به کین پدر بنده را دست گیر"
  },
  {
    "poem_id": 87954,
    "vorder": 112,
    "position": 1,
    "text": "ببخشای بر جان کاوس پیر"
  },
  {
    "poem_id": 87954,
    "vorder": 113,
    "position": 0,
    "text": "تو دانی که او را بدی گوهرست"
  },
  {
    "poem_id": 87954,
    "vorder": 114,
    "position": 1,
    "text": "همان بدنژادست و افسونگرست"
  },
  {
    "poem_id": 87954,
    "vorder": 115,
    "position": 0,
    "text": "فراوان بمالید رخ بر زمین"
  },
  {
    "poem_id": 87954,
    "vorder": 116,
    "position": 1,
    "text": "همی خواند بر کردگار آفرین"
  },
  {
    "poem_id": 87954,
    "vorder": 117,
    "position": 0,
    "text": "وزان جایگه شد سوی تخت باز"
  },
  {
    "poem_id": 87954,
    "vorder": 118,
    "position": 1,
    "text": "بر پهلوانان گردن‌فراز"
  },
  {
    "poem_id": 87954,
    "vorder": 119,
    "position": 0,
    "text": "چنین گفت کای نامداران من"
  },
  {
    "poem_id": 87954,
    "vorder": 120,
    "position": 1,
    "text": "جهانگیر و خنجر گزاران من"
  },
  {
    "poem_id": 87954,
    "vorder": 121,
    "position": 0,
    "text": "بپیمودم این بوم ایران بر اسپ"
  },
  {
    "poem_id": 87954,
    "vorder": 122,
    "position": 1,
    "text": "ازین مرز تا خان آذرگشسپ"
  },
  {
    "poem_id": 87954,
    "vorder": 123,
    "position": 0,
    "text": "ندیدم کسی را که دلشاد بود"
  },
  {
    "poem_id": 87954,
    "vorder": 124,
    "position": 1,
    "text": "توانگر بد و بومش آباد بود"
  },
  {
    "poem_id": 87954,
    "vorder": 125,
    "position": 0,
    "text": "همه خستگانند از افراسیاب"
  },
  {
    "poem_id": 87954,
    "vorder": 126,
    "position": 1,
    "text": "همه دل پر از خون و دیده پرآب"
  },
  {
    "poem_id": 87954,
    "vorder": 127,
    "position": 0,
    "text": "نخستین جگرخسته از وی منم"
  },
  {
    "poem_id": 87954,
    "vorder": 128,
    "position": 1,
    "text": "که پر درد ازویست جان و تنم"
  },
  {
    "poem_id": 87954,
    "vorder": 129,
    "position": 0,
    "text": "دگر چون نیا شاه آزادمرد"
  },
  {
    "poem_id": 87954,
    "vorder": 130,
    "position": 1,
    "text": "که از دل همی برکشد باد سرد"
  },
  {
    "poem_id": 87954,
    "vorder": 131,
    "position": 0,
    "text": "به ایران زن و مرد ازو با خروش"
  },
  {
    "poem_id": 87954,
    "vorder": 132,
    "position": 1,
    "text": "ز بس کشتن و غارت و جنگ و جوش"
  },
  {
    "poem_id": 87954,
    "vorder": 133,
    "position": 0,
    "text": "کنون گر همه ویژه یار منید"
  },
  {
    "poem_id": 87954,
    "vorder": 134,
    "position": 1,
    "text": "بِدل سربسر دوستدار منید"
  },
  {
    "poem_id": 87954,
    "vorder": 135,
    "position": 0,
    "text": "به کین پدر بست خواهم میان"
  },
  {
    "poem_id": 87954,
    "vorder": 136,
    "position": 1,
    "text": "بگردانم این بد ز ایرانیان"
  },
  {
    "poem_id": 87954,
    "vorder": 137,
    "position": 0,
    "text": "اگر همگنان رای جنگ آورید"
  },
  {
    "poem_id": 87954,
    "vorder": 138,
    "position": 1,
    "text": "بکوشید و رسم پلنگ آورید"
  },
  {
    "poem_id": 87954,
    "vorder": 139,
    "position": 0,
    "text": "مرا این سخن پیش بیرون شود"
  },
  {
    "poem_id": 87954,
    "vorder": 140,
    "position": 1,
    "text": "ز جنگ یلان کوه هامون شود"
  },
  {
    "poem_id": 87954,
    "vorder": 141,
    "position": 0,
    "text": "هران خون که آید به کین ریخته"
  },
  {
    "poem_id": 87954,
    "vorder": 142,
    "position": 1,
    "text": "گنهکار او باشد آویخته"
  },
  {
    "poem_id": 87954,
    "vorder": 143,
    "position": 0,
    "text": "وگر کشته گردد کسی زین سپاه"
  },
  {
    "poem_id": 87954,
    "vorder": 144,
    "position": 1,
    "text": "بهشت بلندش بود جایگاه"
  },
  {
    "poem_id": 87954,
    "vorder": 145,
    "position": 0,
    "text": "چه گویید و این را چه پاسخ دهید"
  },
  {
    "poem_id": 87954,
    "vorder": 146,
    "position": 1,
    "text": "همه یکسره رای فرخ نهید"
  },
  {
    "poem_id": 87954,
    "vorder": 147,
    "position": 0,
    "text": "بدانید کو شد به بد پیشدست"
  },
  {
    "poem_id": 87954,
    "vorder": 148,
    "position": 1,
    "text": "مکافات بد را نشاید نشست"
  },
  {
    "poem_id": 87954,
    "vorder": 149,
    "position": 0,
    "text": "بزرگان به پاسخ بیاراستند"
  },
  {
    "poem_id": 87954,
    "vorder": 150,
    "position": 1,
    "text": "به درد دل از جای برخاستند"
  },
  {
    "poem_id": 87954,
    "vorder": 151,
    "position": 0,
    "text": "که ای نامدار جهان شادباش"
  },
  {
    "poem_id": 87954,
    "vorder": 152,
    "position": 1,
    "text": "همیشه ز رنج و غم آزاد باش"
  },
  {
    "poem_id": 87954,
    "vorder": 153,
    "position": 0,
    "text": "تن و جان ما سربه‌سر پیش تست"
  },
  {
    "poem_id": 87954,
    "vorder": 154,
    "position": 1,
    "text": "غم و شادمانی کم و بیش تست"
  },
  {
    "poem_id": 87954,
    "vorder": 155,
    "position": 0,
    "text": "ز مادر همه مرگ را زاده‌ایم"
  },
  {
    "poem_id": 87954,
    "vorder": 156,
    "position": 1,
    "text": "همه بنده‌ایم ارچه آزاده‌ایم"
  },
  {
    "poem_id": 87954,
    "vorder": 157,
    "position": 0,
    "text": "چو پاسخ چنین یافت از پیلتن"
  },
  {
    "poem_id": 87954,
    "vorder": 158,
    "position": 1,
    "text": "ز طوس و ز گودرز و از انجمن"
  },
  {
    "poem_id": 87954,
    "vorder": 159,
    "position": 0,
    "text": "رخ شاه شد چون گل ارغوان"
  },
  {
    "poem_id": 87954,
    "vorder": 160,
    "position": 1,
    "text": "که دولت جوان بود و خسرو جوان"
  },
  {
    "poem_id": 87954,
    "vorder": 161,
    "position": 0,
    "text": "بدیشان فراوان بکرد آفرین"
  },
  {
    "poem_id": 87954,
    "vorder": 162,
    "position": 1,
    "text": "که آباد بادا به گردان زمین"
  }
]