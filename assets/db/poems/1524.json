[
  {
    "poem_id": 1524,
    "vorder": 1,
    "position": 0,
    "text": "برین نیز بگذشت چندی سپهر"
  },
  {
    "poem_id": 1524,
    "vorder": 2,
    "position": 1,
    "text": "به دل در همی داشت و ننمود چهر"
  },
  {
    "poem_id": 1524,
    "vorder": 3,
    "position": 0,
    "text": "بگشتاسپ گفت آن زمان جنگجوی"
  },
  {
    "poem_id": 1524,
    "vorder": 4,
    "position": 1,
    "text": "که تا زنده‌ای زین جهان بهر جوی"
  },
  {
    "poem_id": 1524,
    "vorder": 5,
    "position": 0,
    "text": "براندیش با این سخن با خرد"
  },
  {
    "poem_id": 1524,
    "vorder": 6,
    "position": 1,
    "text": "که اندیشه اندر سخن به خورد"
  },
  {
    "poem_id": 1524,
    "vorder": 7,
    "position": 0,
    "text": "به ایران فرستم فرستاده‌ای"
  },
  {
    "poem_id": 1524,
    "vorder": 8,
    "position": 1,
    "text": "جهاندیده و پاک و آزاده‌ای"
  },
  {
    "poem_id": 1524,
    "vorder": 9,
    "position": 0,
    "text": "به لهراسپ گویم که نیم جهان"
  },
  {
    "poem_id": 1524,
    "vorder": 10,
    "position": 1,
    "text": "تو داری به آرام و گنج مهان"
  },
  {
    "poem_id": 1524,
    "vorder": 11,
    "position": 0,
    "text": "اگر باژ بفرستی از مرز خویش"
  },
  {
    "poem_id": 1524,
    "vorder": 12,
    "position": 1,
    "text": "ببینی سرمایهٔ ارز خویش"
  },
  {
    "poem_id": 1524,
    "vorder": 13,
    "position": 0,
    "text": "بریشان سپاهی فرستم ز روم"
  },
  {
    "poem_id": 1524,
    "vorder": 14,
    "position": 1,
    "text": "که از نعل پیدا نبینند بوم"
  },
  {
    "poem_id": 1524,
    "vorder": 15,
    "position": 0,
    "text": "چنین داد پاسخ که این رای تست"
  },
  {
    "poem_id": 1524,
    "vorder": 16,
    "position": 1,
    "text": "زمانه بزیر کف پای تست"
  },
  {
    "poem_id": 1524,
    "vorder": 17,
    "position": 0,
    "text": "یکی نامور بود قالوس نام"
  },
  {
    "poem_id": 1524,
    "vorder": 18,
    "position": 1,
    "text": "خردمند و با دانش و رای و کام"
  },
  {
    "poem_id": 1524,
    "vorder": 19,
    "position": 0,
    "text": "بخواند آن خردمند را نامدار"
  },
  {
    "poem_id": 1524,
    "vorder": 20,
    "position": 1,
    "text": "کز ایدر برو تا در شهریار"
  },
  {
    "poem_id": 1524,
    "vorder": 21,
    "position": 0,
    "text": "بگویش که گر باژ ایران دهی"
  },
  {
    "poem_id": 1524,
    "vorder": 22,
    "position": 1,
    "text": "به فرمان گرایی و گردن نهی"
  },
  {
    "poem_id": 1524,
    "vorder": 23,
    "position": 0,
    "text": "به ایران بماند بتو تاج و تخت"
  },
  {
    "poem_id": 1524,
    "vorder": 24,
    "position": 1,
    "text": "جهاندار باشی و پیروزبخت"
  },
  {
    "poem_id": 1524,
    "vorder": 25,
    "position": 0,
    "text": "وگرنه مرا با سپاهی گران"
  },
  {
    "poem_id": 1524,
    "vorder": 26,
    "position": 1,
    "text": "هم از روم وز دشت نیزه‌وران"
  },
  {
    "poem_id": 1524,
    "vorder": 27,
    "position": 0,
    "text": "نگه کن که برخیزد از دشت غو"
  },
  {
    "poem_id": 1524,
    "vorder": 28,
    "position": 1,
    "text": "فرخ‌زاد پیروزشان پیش رو"
  },
  {
    "poem_id": 1524,
    "vorder": 29,
    "position": 0,
    "text": "همه بومتان پاک ویران کنم"
  },
  {
    "poem_id": 1524,
    "vorder": 30,
    "position": 1,
    "text": "ز ایران به شمشیر بیران کنم"
  },
  {
    "poem_id": 1524,
    "vorder": 31,
    "position": 0,
    "text": "فرستاده آمد به کردار باد"
  },
  {
    "poem_id": 1524,
    "vorder": 32,
    "position": 1,
    "text": "سرش پر خرد بد دلش پر ز داد"
  },
  {
    "poem_id": 1524,
    "vorder": 33,
    "position": 0,
    "text": "چو آمد به نزدیک شاه بزرگ"
  },
  {
    "poem_id": 1524,
    "vorder": 34,
    "position": 1,
    "text": "بدید آن در و بارگاه بزرگ"
  },
  {
    "poem_id": 1524,
    "vorder": 35,
    "position": 0,
    "text": "چو آگاهی آمد به سالار بار"
  },
  {
    "poem_id": 1524,
    "vorder": 36,
    "position": 1,
    "text": "خرامان بیامد بر شهریار"
  },
  {
    "poem_id": 1524,
    "vorder": 37,
    "position": 0,
    "text": "که پیر جهاندیده‌ای بر درست"
  },
  {
    "poem_id": 1524,
    "vorder": 38,
    "position": 1,
    "text": "همانا فرستادهٔ قیصرست"
  },
  {
    "poem_id": 1524,
    "vorder": 39,
    "position": 0,
    "text": "سوارست با او بسی نامدار"
  },
  {
    "poem_id": 1524,
    "vorder": 40,
    "position": 1,
    "text": "همی راه جوید بر شهریار"
  },
  {
    "poem_id": 1524,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید بنشست بر تخت عاج"
  },
  {
    "poem_id": 1524,
    "vorder": 42,
    "position": 1,
    "text": "بسر بر نهاد آن دل افروز تاج"
  },
  {
    "poem_id": 1524,
    "vorder": 43,
    "position": 0,
    "text": "بزرگان ایران همه پیش تخت"
  },
  {
    "poem_id": 1524,
    "vorder": 44,
    "position": 1,
    "text": "نشستند شادان دل و نیکبخت"
  },
  {
    "poem_id": 1524,
    "vorder": 45,
    "position": 0,
    "text": "بفرمود تا پرده برداشتند"
  },
  {
    "poem_id": 1524,
    "vorder": 46,
    "position": 1,
    "text": "فرستاده را شاد بگذاشتند"
  },
  {
    "poem_id": 1524,
    "vorder": 47,
    "position": 0,
    "text": "چو آمد به نزدیک تختش فراز"
  },
  {
    "poem_id": 1524,
    "vorder": 48,
    "position": 1,
    "text": "بر او آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1524,
    "vorder": 49,
    "position": 0,
    "text": "پیام گرانمایه قیصر بداد"
  },
  {
    "poem_id": 1524,
    "vorder": 50,
    "position": 1,
    "text": "چنان چون بباید به آیین و داد"
  },
  {
    "poem_id": 1524,
    "vorder": 51,
    "position": 0,
    "text": "غمی شد ز گفتار او شهریار"
  },
  {
    "poem_id": 1524,
    "vorder": 52,
    "position": 1,
    "text": "برآشفت با گردش روزگار"
  },
  {
    "poem_id": 1524,
    "vorder": 53,
    "position": 0,
    "text": "گرانمایه جایی بیاراستند"
  },
  {
    "poem_id": 1524,
    "vorder": 54,
    "position": 1,
    "text": "فرستاده را شاد بنشاستند"
  },
  {
    "poem_id": 1524,
    "vorder": 55,
    "position": 0,
    "text": "فرستاد زربفت گستردنی"
  },
  {
    "poem_id": 1524,
    "vorder": 56,
    "position": 1,
    "text": "ز پوشیدنی و هم از خوردنی"
  },
  {
    "poem_id": 1524,
    "vorder": 57,
    "position": 0,
    "text": "بران گونه بنواخت او را به بزم"
  },
  {
    "poem_id": 1524,
    "vorder": 58,
    "position": 1,
    "text": "تو گفتی که نشنید پیغام رزم"
  },
  {
    "poem_id": 1524,
    "vorder": 59,
    "position": 0,
    "text": "شب آمد پر اندیشه پیچان بخفت"
  },
  {
    "poem_id": 1524,
    "vorder": 60,
    "position": 1,
    "text": "تو گفتی که با درد و غم بود جفت"
  },
  {
    "poem_id": 1524,
    "vorder": 61,
    "position": 0,
    "text": "چو خورشید بر تخت زرین نشست"
  },
  {
    "poem_id": 1524,
    "vorder": 62,
    "position": 1,
    "text": "شب تیره رخسار خود را ببست"
  },
  {
    "poem_id": 1524,
    "vorder": 63,
    "position": 0,
    "text": "بفرمود تا رفت پیشش زریر"
  },
  {
    "poem_id": 1524,
    "vorder": 64,
    "position": 1,
    "text": "سخن گفت هرگونه با شاه دیر"
  },
  {
    "poem_id": 1524,
    "vorder": 65,
    "position": 0,
    "text": "به شگبیر قالوس شد بار خواه"
  },
  {
    "poem_id": 1524,
    "vorder": 66,
    "position": 1,
    "text": "ورا راه دادند نزدیک شاه"
  },
  {
    "poem_id": 1524,
    "vorder": 67,
    "position": 0,
    "text": "ز بیگانه ایوان بپرداختند"
  },
  {
    "poem_id": 1524,
    "vorder": 68,
    "position": 1,
    "text": "فرستاده را پیش بنشاختند"
  },
  {
    "poem_id": 1524,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت لهراسپ کای پر خرد"
  },
  {
    "poem_id": 1524,
    "vorder": 70,
    "position": 1,
    "text": "مبادا که جان جز خرد پرورد"
  },
  {
    "poem_id": 1524,
    "vorder": 71,
    "position": 0,
    "text": "بپرسم ترا راست پاسخ‌گزار"
  },
  {
    "poem_id": 1524,
    "vorder": 72,
    "position": 1,
    "text": "اگر بخردی کام کژی مخار"
  },
  {
    "poem_id": 1524,
    "vorder": 73,
    "position": 0,
    "text": "نبود این هنرها به روم اندرون"
  },
  {
    "poem_id": 1524,
    "vorder": 74,
    "position": 1,
    "text": "بدی قیصر از پیش شاهان زبون"
  },
  {
    "poem_id": 1524,
    "vorder": 75,
    "position": 0,
    "text": "کنون او بهر کشوری باژخواه"
  },
  {
    "poem_id": 1524,
    "vorder": 76,
    "position": 1,
    "text": "فرستاد و بر ماه بنهاد گاه"
  },
  {
    "poem_id": 1524,
    "vorder": 77,
    "position": 0,
    "text": "چو الیاس را کو به مرز خزر"
  },
  {
    "poem_id": 1524,
    "vorder": 78,
    "position": 1,
    "text": "گوی بود با فر و پرخاشخر"
  },
  {
    "poem_id": 1524,
    "vorder": 79,
    "position": 0,
    "text": "بگیرد ببندد همی با سپاه"
  },
  {
    "poem_id": 1524,
    "vorder": 80,
    "position": 1,
    "text": "بدین باژخواهش که بنمود راه"
  },
  {
    "poem_id": 1524,
    "vorder": 81,
    "position": 0,
    "text": "فرستاده گفت ای سخنگوی شاه"
  },
  {
    "poem_id": 1524,
    "vorder": 82,
    "position": 1,
    "text": "به مرز خزر من شدم باژخواه"
  },
  {
    "poem_id": 1524,
    "vorder": 83,
    "position": 0,
    "text": "به پیغمبری رنج بردم بسی"
  },
  {
    "poem_id": 1524,
    "vorder": 84,
    "position": 1,
    "text": "نپرسید زین باره هرگز کسی"
  },
  {
    "poem_id": 1524,
    "vorder": 85,
    "position": 0,
    "text": "ولیکن مرا شاه زان‌سان نواخت"
  },
  {
    "poem_id": 1524,
    "vorder": 86,
    "position": 1,
    "text": "که گردن به کژی نباید فراخت"
  },
  {
    "poem_id": 1524,
    "vorder": 87,
    "position": 0,
    "text": "سواری به نزدیک او آمدست"
  },
  {
    "poem_id": 1524,
    "vorder": 88,
    "position": 1,
    "text": "که از بیشه‌ها شیر گیرد به دست"
  },
  {
    "poem_id": 1524,
    "vorder": 89,
    "position": 0,
    "text": "به مردان بخندد همی روز رزم"
  },
  {
    "poem_id": 1524,
    "vorder": 90,
    "position": 1,
    "text": "هم از جامهٔ می به هنگام بزم"
  },
  {
    "poem_id": 1524,
    "vorder": 91,
    "position": 0,
    "text": "به بزم و به رزم و به روز شکار"
  },
  {
    "poem_id": 1524,
    "vorder": 92,
    "position": 1,
    "text": "جهان‌بین ندیدست چون او سوار"
  },
  {
    "poem_id": 1524,
    "vorder": 93,
    "position": 0,
    "text": "بدو داد پرمایه‌تر دخترش"
  },
  {
    "poem_id": 1524,
    "vorder": 94,
    "position": 1,
    "text": "که بودی گرامی‌تر از افسرش"
  },
  {
    "poem_id": 1524,
    "vorder": 95,
    "position": 0,
    "text": "نشانی شدست او به روم اندرون"
  },
  {
    "poem_id": 1524,
    "vorder": 96,
    "position": 1,
    "text": "چو نر اژدها شد به چنگش زبون"
  },
  {
    "poem_id": 1524,
    "vorder": 97,
    "position": 0,
    "text": "یکی گرگ بد همچو پیلی به دشت"
  },
  {
    "poem_id": 1524,
    "vorder": 98,
    "position": 1,
    "text": "که قیصر نیارست زان سو گذشت"
  },
  {
    "poem_id": 1524,
    "vorder": 99,
    "position": 0,
    "text": "بیفگند و دندان او را بکند"
  },
  {
    "poem_id": 1524,
    "vorder": 100,
    "position": 1,
    "text": "وزو کشور روم شد بی‌گزند"
  },
  {
    "poem_id": 1524,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت لهراسپ کای راست‌گوی"
  },
  {
    "poem_id": 1524,
    "vorder": 102,
    "position": 1,
    "text": "کرا ماند این مرد پرخاشجوی"
  },
  {
    "poem_id": 1524,
    "vorder": 103,
    "position": 0,
    "text": "چنین داد پاسخ که باری نخست"
  },
  {
    "poem_id": 1524,
    "vorder": 104,
    "position": 1,
    "text": "به چهره زریرست گویی درست"
  },
  {
    "poem_id": 1524,
    "vorder": 105,
    "position": 0,
    "text": "به بالا و دیدار و فرهنگ و رای"
  },
  {
    "poem_id": 1524,
    "vorder": 106,
    "position": 1,
    "text": "زریر دلیرست گویی بجای"
  },
  {
    "poem_id": 1524,
    "vorder": 107,
    "position": 0,
    "text": "چو بشنید لهراسپ بگشاد چهر"
  },
  {
    "poem_id": 1524,
    "vorder": 108,
    "position": 1,
    "text": "بران مرد رومی بگسترد مهر"
  },
  {
    "poem_id": 1524,
    "vorder": 109,
    "position": 0,
    "text": "فراوان ورا برده و بدره داد"
  },
  {
    "poem_id": 1524,
    "vorder": 110,
    "position": 1,
    "text": "ز درگاه برگشت پیروز و شاد"
  },
  {
    "poem_id": 1524,
    "vorder": 111,
    "position": 0,
    "text": "بدو گفت کاکنون به قیصر بگوی"
  },
  {
    "poem_id": 1524,
    "vorder": 112,
    "position": 1,
    "text": "که من با سپاه آمدم جنگجوی"
  }
]