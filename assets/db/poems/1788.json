[
  {
    "poem_id": 1788,
    "vorder": 1,
    "position": 0,
    "text": "همی بود یک چند با مهتران"
  },
  {
    "poem_id": 1788,
    "vorder": 2,
    "position": 1,
    "text": "می روشن و جام و رامشگران"
  },
  {
    "poem_id": 1788,
    "vorder": 3,
    "position": 0,
    "text": "بهار آمد و شد جهان چون بهشت"
  },
  {
    "poem_id": 1788,
    "vorder": 4,
    "position": 1,
    "text": "به خاک سیه بر فلک لاله کشت"
  },
  {
    "poem_id": 1788,
    "vorder": 5,
    "position": 0,
    "text": "همه بومها پر ز نخجیر گشت"
  },
  {
    "poem_id": 1788,
    "vorder": 6,
    "position": 1,
    "text": "بجوی آبها چون می و شیر گشت"
  },
  {
    "poem_id": 1788,
    "vorder": 7,
    "position": 0,
    "text": "گرازیدن گور و آهو به شخ"
  },
  {
    "poem_id": 1788,
    "vorder": 8,
    "position": 1,
    "text": "کشیدند بر سبزه هر جای نخ"
  },
  {
    "poem_id": 1788,
    "vorder": 9,
    "position": 0,
    "text": "همه جویباران پر از مشک دم"
  },
  {
    "poem_id": 1788,
    "vorder": 10,
    "position": 1,
    "text": "بسان گل نارون می به خم"
  },
  {
    "poem_id": 1788,
    "vorder": 11,
    "position": 0,
    "text": "بگفتند با شاه بهرام گور"
  },
  {
    "poem_id": 1788,
    "vorder": 12,
    "position": 1,
    "text": "که شد دیر هنگام نخچیر گور"
  },
  {
    "poem_id": 1788,
    "vorder": 13,
    "position": 0,
    "text": "چنین داد پاسخ که مردی هزار"
  },
  {
    "poem_id": 1788,
    "vorder": 14,
    "position": 1,
    "text": "گزین کرد باید ز لشکر سوار"
  },
  {
    "poem_id": 1788,
    "vorder": 15,
    "position": 0,
    "text": "سوی تور شد شاه نخچیرجوی"
  },
  {
    "poem_id": 1788,
    "vorder": 16,
    "position": 1,
    "text": "جهان گشت یکسر پر از گفت‌وگوی"
  },
  {
    "poem_id": 1788,
    "vorder": 17,
    "position": 0,
    "text": "ز گور و ز غرم و ز آهو جهان"
  },
  {
    "poem_id": 1788,
    "vorder": 18,
    "position": 1,
    "text": "بپرداختند آن دلاور مهان"
  },
  {
    "poem_id": 1788,
    "vorder": 19,
    "position": 0,
    "text": "سه دیگر چو بفروخت خورشید تاج"
  },
  {
    "poem_id": 1788,
    "vorder": 20,
    "position": 1,
    "text": "زمین زرد شد کوه و دریا چو عاج"
  },
  {
    "poem_id": 1788,
    "vorder": 21,
    "position": 0,
    "text": "به نخچیر شد شهریار دلیر"
  },
  {
    "poem_id": 1788,
    "vorder": 22,
    "position": 1,
    "text": "یکی اژدها دید چون نره شیر"
  },
  {
    "poem_id": 1788,
    "vorder": 23,
    "position": 0,
    "text": "به بالای او موی زیر سرش"
  },
  {
    "poem_id": 1788,
    "vorder": 24,
    "position": 1,
    "text": "دو پستان بسان زنان از برش"
  },
  {
    "poem_id": 1788,
    "vorder": 25,
    "position": 0,
    "text": "کمان را به زه کرد و تیر خدنگ"
  },
  {
    "poem_id": 1788,
    "vorder": 26,
    "position": 1,
    "text": "بزد بر بر اژدها بی‌درنگ"
  },
  {
    "poem_id": 1788,
    "vorder": 27,
    "position": 0,
    "text": "دگر تیز زد بر میان سرش"
  },
  {
    "poem_id": 1788,
    "vorder": 28,
    "position": 1,
    "text": "فروریخت چون آب خون از برش"
  },
  {
    "poem_id": 1788,
    "vorder": 29,
    "position": 0,
    "text": "فرود آمد و خنجری برکشید"
  },
  {
    "poem_id": 1788,
    "vorder": 30,
    "position": 1,
    "text": "سراسر بر اژدها بردرید"
  },
  {
    "poem_id": 1788,
    "vorder": 31,
    "position": 0,
    "text": "یکی مرد برنا فروبرده بود"
  },
  {
    "poem_id": 1788,
    "vorder": 32,
    "position": 1,
    "text": "به خون و به زهر اندر افسرده بود"
  },
  {
    "poem_id": 1788,
    "vorder": 33,
    "position": 0,
    "text": "بران مرد بسیار بگریست زار"
  },
  {
    "poem_id": 1788,
    "vorder": 34,
    "position": 1,
    "text": "وزان زهر شد چشم بهرام تار"
  },
  {
    "poem_id": 1788,
    "vorder": 35,
    "position": 0,
    "text": "وزانجا بیامد به پرده‌سرای"
  },
  {
    "poem_id": 1788,
    "vorder": 36,
    "position": 1,
    "text": "می آورد و خوبان بربط سرای"
  },
  {
    "poem_id": 1788,
    "vorder": 37,
    "position": 0,
    "text": "چو سی روز بگذشت ز اردیبهشت"
  },
  {
    "poem_id": 1788,
    "vorder": 38,
    "position": 1,
    "text": "شد از میوه پالیزها چون بهشت"
  },
  {
    "poem_id": 1788,
    "vorder": 39,
    "position": 0,
    "text": "چنان ساخت کاید به تور اندرون"
  },
  {
    "poem_id": 1788,
    "vorder": 40,
    "position": 1,
    "text": "پرستنده با او یکی رهنمون"
  },
  {
    "poem_id": 1788,
    "vorder": 41,
    "position": 0,
    "text": "به شبگیر هرمزد خرداد ماه"
  },
  {
    "poem_id": 1788,
    "vorder": 42,
    "position": 1,
    "text": "ازان دشت سوی دهی رفت‌شاه"
  },
  {
    "poem_id": 1788,
    "vorder": 43,
    "position": 0,
    "text": "ببیند که اندر جهان داد هست"
  },
  {
    "poem_id": 1788,
    "vorder": 44,
    "position": 1,
    "text": "بجوید دل مرد یزدان‌پرست"
  },
  {
    "poem_id": 1788,
    "vorder": 45,
    "position": 0,
    "text": "همی راند شبدیز را نرم‌نرم"
  },
  {
    "poem_id": 1788,
    "vorder": 46,
    "position": 1,
    "text": "برین‌گونه تا روز برگشت گرم"
  },
  {
    "poem_id": 1788,
    "vorder": 47,
    "position": 0,
    "text": "همی‌راند حیران و پیچان به راه"
  },
  {
    "poem_id": 1788,
    "vorder": 48,
    "position": 1,
    "text": "به خواب و به آب آرزومند شاه"
  },
  {
    "poem_id": 1788,
    "vorder": 49,
    "position": 0,
    "text": "چنین تا به آباد جایی رسید"
  },
  {
    "poem_id": 1788,
    "vorder": 50,
    "position": 1,
    "text": "به هامون به نزد سرایی رسید"
  },
  {
    "poem_id": 1788,
    "vorder": 51,
    "position": 0,
    "text": "زنی دید بر کتف او بر سبوی"
  },
  {
    "poem_id": 1788,
    "vorder": 52,
    "position": 1,
    "text": "ز بهرام خسرو بپوشید روی"
  },
  {
    "poem_id": 1788,
    "vorder": 53,
    "position": 0,
    "text": "بدو گفت بهرام کایدر سپنج"
  },
  {
    "poem_id": 1788,
    "vorder": 54,
    "position": 1,
    "text": "دهید ار نه باید گذشتن به رنج"
  },
  {
    "poem_id": 1788,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت زن کای نبرده سوار"
  },
  {
    "poem_id": 1788,
    "vorder": 56,
    "position": 1,
    "text": "تو این خانه چون خانهٔ خویش دار"
  },
  {
    "poem_id": 1788,
    "vorder": 57,
    "position": 0,
    "text": "چو پاسخ شنید اسپ در خانه راند"
  },
  {
    "poem_id": 1788,
    "vorder": 58,
    "position": 1,
    "text": "زن میزبان شوی را پیش خواند"
  },
  {
    "poem_id": 1788,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت کاه آر و اسپش بمال"
  },
  {
    "poem_id": 1788,
    "vorder": 60,
    "position": 1,
    "text": "چو گاه جو آید بکن در جوال"
  },
  {
    "poem_id": 1788,
    "vorder": 61,
    "position": 0,
    "text": "خود آمد به جایی که بودش نهفت"
  },
  {
    "poem_id": 1788,
    "vorder": 62,
    "position": 1,
    "text": "ز پیش اندرون رفت و خانه برفت"
  },
  {
    "poem_id": 1788,
    "vorder": 63,
    "position": 0,
    "text": "حصیری بگسترد و بالش نهاد"
  },
  {
    "poem_id": 1788,
    "vorder": 64,
    "position": 1,
    "text": "به بهرام بر آفرین کرد یاد"
  },
  {
    "poem_id": 1788,
    "vorder": 65,
    "position": 0,
    "text": "سوی خانهٔ آب شد آب برد"
  },
  {
    "poem_id": 1788,
    "vorder": 66,
    "position": 1,
    "text": "همی در نهان شوی را برشمرد"
  },
  {
    "poem_id": 1788,
    "vorder": 67,
    "position": 0,
    "text": "که این پیر و ابله بماند به جای"
  },
  {
    "poem_id": 1788,
    "vorder": 68,
    "position": 1,
    "text": "هرانگه که بیند کس اندر سرای"
  },
  {
    "poem_id": 1788,
    "vorder": 69,
    "position": 0,
    "text": "نباشد چنین کار کار زنان"
  },
  {
    "poem_id": 1788,
    "vorder": 70,
    "position": 1,
    "text": "منم لشکری‌دار دندان کنان"
  },
  {
    "poem_id": 1788,
    "vorder": 71,
    "position": 0,
    "text": "بشد شاه بهرام و رخ را بشست"
  },
  {
    "poem_id": 1788,
    "vorder": 72,
    "position": 1,
    "text": "کزان اژدها بود ناتن درست"
  },
  {
    "poem_id": 1788,
    "vorder": 73,
    "position": 0,
    "text": "بیامد نشست از بر آن حصیر"
  },
  {
    "poem_id": 1788,
    "vorder": 74,
    "position": 1,
    "text": "بدر خانه بر پای بد مرد پیر"
  },
  {
    "poem_id": 1788,
    "vorder": 75,
    "position": 0,
    "text": "بیاورد خوانی و بنهاد راست"
  },
  {
    "poem_id": 1788,
    "vorder": 76,
    "position": 1,
    "text": "برو تره و سرکه و نان و ماست"
  },
  {
    "poem_id": 1788,
    "vorder": 77,
    "position": 0,
    "text": "بخورد اندکی نان و نالان بخفت"
  },
  {
    "poem_id": 1788,
    "vorder": 78,
    "position": 1,
    "text": "به دستار چینی رخ اندر نهفت"
  },
  {
    "poem_id": 1788,
    "vorder": 79,
    "position": 0,
    "text": "چو از خواب بیدار شد زن بشوی"
  },
  {
    "poem_id": 1788,
    "vorder": 80,
    "position": 1,
    "text": "همی گفت کای زشت ناشسته روی"
  },
  {
    "poem_id": 1788,
    "vorder": 81,
    "position": 0,
    "text": "بره کشت باید ترا کاین سوار"
  },
  {
    "poem_id": 1788,
    "vorder": 82,
    "position": 1,
    "text": "بزرگست و از تخمهٔ شهریار"
  },
  {
    "poem_id": 1788,
    "vorder": 83,
    "position": 0,
    "text": "که فر کیان دارد و نور ماه"
  },
  {
    "poem_id": 1788,
    "vorder": 84,
    "position": 1,
    "text": "نماند همی جز به بهرامشاه"
  },
  {
    "poem_id": 1788,
    "vorder": 85,
    "position": 0,
    "text": "چنین گفت با زن گرانمایه شوی"
  },
  {
    "poem_id": 1788,
    "vorder": 86,
    "position": 1,
    "text": "که چندین چرا بایدت گفت‌وگوی"
  },
  {
    "poem_id": 1788,
    "vorder": 87,
    "position": 0,
    "text": "نداری نمکسود و هیزم نه نان"
  },
  {
    "poem_id": 1788,
    "vorder": 88,
    "position": 1,
    "text": "چه سازی تو برگ چنین میهمان"
  },
  {
    "poem_id": 1788,
    "vorder": 89,
    "position": 0,
    "text": "بره‌ کشتی و خورد و رفت این سوار"
  },
  {
    "poem_id": 1788,
    "vorder": 90,
    "position": 1,
    "text": "تو شو خر به انبوهی اندر گذار"
  },
  {
    "poem_id": 1788,
    "vorder": 91,
    "position": 0,
    "text": "زمستان و سرما و باد دمان"
  },
  {
    "poem_id": 1788,
    "vorder": 92,
    "position": 1,
    "text": "به پیش آیدت یک زمان بی‌گمان"
  },
  {
    "poem_id": 1788,
    "vorder": 93,
    "position": 0,
    "text": "همی گفت انباز و نشنید زن"
  },
  {
    "poem_id": 1788,
    "vorder": 94,
    "position": 1,
    "text": "که هم نیک‌پی بود و هم رای‌زن"
  },
  {
    "poem_id": 1788,
    "vorder": 95,
    "position": 0,
    "text": "بره کشته شد هم به فرجام کار"
  },
  {
    "poem_id": 1788,
    "vorder": 96,
    "position": 1,
    "text": "به گفتار آن زن ز بهر سوار"
  },
  {
    "poem_id": 1788,
    "vorder": 97,
    "position": 0,
    "text": "چو شد کشته دیگی هریسه بپخت"
  },
  {
    "poem_id": 1788,
    "vorder": 98,
    "position": 1,
    "text": "برند آتش از هیزم نیم‌سخت"
  },
  {
    "poem_id": 1788,
    "vorder": 99,
    "position": 0,
    "text": "بیاورد چیزی بر شهریار"
  },
  {
    "poem_id": 1788,
    "vorder": 100,
    "position": 1,
    "text": "برو خایه و تره جویبار"
  },
  {
    "poem_id": 1788,
    "vorder": 101,
    "position": 0,
    "text": "یکی پاره بریان ببرد از بره"
  },
  {
    "poem_id": 1788,
    "vorder": 102,
    "position": 1,
    "text": "همان پخته چیزی که بد یکسره"
  },
  {
    "poem_id": 1788,
    "vorder": 103,
    "position": 0,
    "text": "چو بهرام دست از خورشها بشست"
  },
  {
    "poem_id": 1788,
    "vorder": 104,
    "position": 1,
    "text": "همی بود بی‌خواب و ناتن‌درست"
  },
  {
    "poem_id": 1788,
    "vorder": 105,
    "position": 0,
    "text": "چو شب کرد با آفتاب انجمن"
  },
  {
    "poem_id": 1788,
    "vorder": 106,
    "position": 1,
    "text": "کدوی می و سنجد آورد زن"
  },
  {
    "poem_id": 1788,
    "vorder": 107,
    "position": 0,
    "text": "بدو گفت شاه ای زن کم‌سخن"
  },
  {
    "poem_id": 1788,
    "vorder": 108,
    "position": 1,
    "text": "یکی داستان گوی با من کهن"
  },
  {
    "poem_id": 1788,
    "vorder": 109,
    "position": 0,
    "text": "بدان تا به گفتار تو می خوریم"
  },
  {
    "poem_id": 1788,
    "vorder": 110,
    "position": 1,
    "text": "به می درد و اندوه را بشکریم"
  },
  {
    "poem_id": 1788,
    "vorder": 111,
    "position": 0,
    "text": "بتو داستان نیز کردم یله"
  },
  {
    "poem_id": 1788,
    "vorder": 112,
    "position": 1,
    "text": "ز بهرامت آزادیست ار گله"
  },
  {
    "poem_id": 1788,
    "vorder": 113,
    "position": 0,
    "text": "زن کم‌سخن گفت آری نکوست"
  },
  {
    "poem_id": 1788,
    "vorder": 114,
    "position": 1,
    "text": "هم آغاز هر کار و فرجام ازوست"
  },
  {
    "poem_id": 1788,
    "vorder": 115,
    "position": 0,
    "text": "بدو گفت بهرام کاین است و بس"
  },
  {
    "poem_id": 1788,
    "vorder": 116,
    "position": 1,
    "text": "ازو دادجویی نبینند کس"
  },
  {
    "poem_id": 1788,
    "vorder": 117,
    "position": 0,
    "text": "زن برمنش گفت کای پاک‌رای"
  },
  {
    "poem_id": 1788,
    "vorder": 118,
    "position": 1,
    "text": "برین ده فراوان کس است و سرای"
  },
  {
    "poem_id": 1788,
    "vorder": 119,
    "position": 0,
    "text": "همیشه گذار سواران بود"
  },
  {
    "poem_id": 1788,
    "vorder": 120,
    "position": 1,
    "text": "ز دیوان و از کارداران بود"
  },
  {
    "poem_id": 1788,
    "vorder": 121,
    "position": 0,
    "text": "یکی نام دزدی نهد بر کسی"
  },
  {
    "poem_id": 1788,
    "vorder": 122,
    "position": 1,
    "text": "که فرجام زان رنج یابد بسی"
  },
  {
    "poem_id": 1788,
    "vorder": 123,
    "position": 0,
    "text": "ز بهر درم گرددش کینه‌کش"
  },
  {
    "poem_id": 1788,
    "vorder": 124,
    "position": 1,
    "text": "که ناخوش کند بر دلش روز خوش"
  },
  {
    "poem_id": 1788,
    "vorder": 125,
    "position": 0,
    "text": "زن پاک‌تن را به آلودگی"
  },
  {
    "poem_id": 1788,
    "vorder": 126,
    "position": 1,
    "text": "برد نام و آرد به بیهودگی"
  },
  {
    "poem_id": 1788,
    "vorder": 127,
    "position": 0,
    "text": "زیانی بود کان نیابد به گنج"
  },
  {
    "poem_id": 1788,
    "vorder": 128,
    "position": 1,
    "text": "ز شاه جهاندار اینست رنج"
  },
  {
    "poem_id": 1788,
    "vorder": 129,
    "position": 0,
    "text": "پراندیشه شد زان سخن شهریار"
  },
  {
    "poem_id": 1788,
    "vorder": 130,
    "position": 1,
    "text": "که بد شد ورا نام زان مایه‌کار"
  },
  {
    "poem_id": 1788,
    "vorder": 131,
    "position": 0,
    "text": "چنین گفت پس شاه یزدان‌شناس"
  },
  {
    "poem_id": 1788,
    "vorder": 132,
    "position": 1,
    "text": "که از دادگر کس ندارد سپاس"
  },
  {
    "poem_id": 1788,
    "vorder": 133,
    "position": 0,
    "text": "درشتی کنم زین سخن ماه چند"
  },
  {
    "poem_id": 1788,
    "vorder": 134,
    "position": 1,
    "text": "که پیدا شود داد و مهر از گزند"
  },
  {
    "poem_id": 1788,
    "vorder": 135,
    "position": 0,
    "text": "شب تیره ز اندیشه پیچان بخفت"
  },
  {
    "poem_id": 1788,
    "vorder": 136,
    "position": 1,
    "text": "همه شب دلش با ستم بود جفت"
  },
  {
    "poem_id": 1788,
    "vorder": 137,
    "position": 0,
    "text": "بدانگه که شب چادر مشک‌بوی"
  },
  {
    "poem_id": 1788,
    "vorder": 138,
    "position": 1,
    "text": "بدرید و بر چرخ بنمود روی"
  },
  {
    "poem_id": 1788,
    "vorder": 139,
    "position": 0,
    "text": "بیامد زن از خانه با شوی گفت"
  },
  {
    "poem_id": 1788,
    "vorder": 140,
    "position": 1,
    "text": "که هرکاره و آتش آر از نهفت"
  },
  {
    "poem_id": 1788,
    "vorder": 141,
    "position": 0,
    "text": "ز هرگونه تخم اندرافگن به آب"
  },
  {
    "poem_id": 1788,
    "vorder": 142,
    "position": 1,
    "text": "نباید که بیند ورا آفتاب"
  },
  {
    "poem_id": 1788,
    "vorder": 143,
    "position": 0,
    "text": "کنون تا بدوشم ازین گاو شیر"
  },
  {
    "poem_id": 1788,
    "vorder": 144,
    "position": 1,
    "text": "تو این کار هرکاره، آسان مگیر"
  },
  {
    "poem_id": 1788,
    "vorder": 145,
    "position": 0,
    "text": "بیاورد گاو از چراگاه خویش"
  },
  {
    "poem_id": 1788,
    "vorder": 146,
    "position": 1,
    "text": "فراوان گیا برد و بنهاد پیش"
  },
  {
    "poem_id": 1788,
    "vorder": 147,
    "position": 0,
    "text": "به پستانش بر دست مالید و گفت"
  },
  {
    "poem_id": 1788,
    "vorder": 148,
    "position": 1,
    "text": "به نام خداوند بی‌یار و جفت"
  },
  {
    "poem_id": 1788,
    "vorder": 149,
    "position": 0,
    "text": "تهی بود پستان گاوش ز شیر"
  },
  {
    "poem_id": 1788,
    "vorder": 150,
    "position": 1,
    "text": "دل میزبان جوان گشت پیر"
  },
  {
    "poem_id": 1788,
    "vorder": 151,
    "position": 0,
    "text": "چنین گفت با شوی کای کدخدای"
  },
  {
    "poem_id": 1788,
    "vorder": 152,
    "position": 1,
    "text": "دل شاه گیتی دگر شد بران"
  },
  {
    "poem_id": 1788,
    "vorder": 153,
    "position": 0,
    "text": "ستمکاره شد شهریار جهان"
  },
  {
    "poem_id": 1788,
    "vorder": 154,
    "position": 1,
    "text": "دلش دوش پیچان شد اندر نهان"
  },
  {
    "poem_id": 1788,
    "vorder": 155,
    "position": 0,
    "text": "بدو گفت شوی از چه گویی همی"
  },
  {
    "poem_id": 1788,
    "vorder": 156,
    "position": 1,
    "text": "به فال بد اندر چه جویی همی"
  },
  {
    "poem_id": 1788,
    "vorder": 157,
    "position": 0,
    "text": "چنین گفت زن کای گرانمایه شوی"
  },
  {
    "poem_id": 1788,
    "vorder": 158,
    "position": 1,
    "text": "مرا بیهده نیست این گفت‌وگوی"
  },
  {
    "poem_id": 1788,
    "vorder": 159,
    "position": 0,
    "text": "چو بیدادگر شد جهاندار شاه"
  },
  {
    "poem_id": 1788,
    "vorder": 160,
    "position": 1,
    "text": "ز گردون نتابد ببایست ماه"
  },
  {
    "poem_id": 1788,
    "vorder": 161,
    "position": 0,
    "text": "به پستانها در شود شیرخشک"
  },
  {
    "poem_id": 1788,
    "vorder": 162,
    "position": 1,
    "text": "نبودی به نافه درون نیز مشک"
  },
  {
    "poem_id": 1788,
    "vorder": 163,
    "position": 0,
    "text": "زنا و ربا آشکارا شود"
  },
  {
    "poem_id": 1788,
    "vorder": 164,
    "position": 1,
    "text": "دل نرم چون سنگ خارا شود"
  },
  {
    "poem_id": 1788,
    "vorder": 165,
    "position": 0,
    "text": "به دشت اندرون گرگ مردم خورد"
  },
  {
    "poem_id": 1788,
    "vorder": 166,
    "position": 1,
    "text": "خردمند بگریزد از بی‌خرد"
  },
  {
    "poem_id": 1788,
    "vorder": 167,
    "position": 0,
    "text": "شود خایه در زیر مرغان تباه"
  },
  {
    "poem_id": 1788,
    "vorder": 168,
    "position": 1,
    "text": "هرانگه که بیدادگر گشت شاه"
  },
  {
    "poem_id": 1788,
    "vorder": 169,
    "position": 0,
    "text": "چراگاه این گاو کمتر نبود"
  },
  {
    "poem_id": 1788,
    "vorder": 170,
    "position": 1,
    "text": "هم آبشخورش نیز بتر نبود"
  },
  {
    "poem_id": 1788,
    "vorder": 171,
    "position": 0,
    "text": "به پستان چنین خشک شد شیراوی"
  },
  {
    "poem_id": 1788,
    "vorder": 172,
    "position": 1,
    "text": "دگرگونه شد رنگ و آژیر اوی"
  },
  {
    "poem_id": 1788,
    "vorder": 173,
    "position": 0,
    "text": "چو بهرامشاه این سخنها شنود"
  },
  {
    "poem_id": 1788,
    "vorder": 174,
    "position": 1,
    "text": "پشیمانی آمدش ز اندیشه زود"
  },
  {
    "poem_id": 1788,
    "vorder": 175,
    "position": 0,
    "text": "به یزدان چنین گفت کای کردگار"
  },
  {
    "poem_id": 1788,
    "vorder": 176,
    "position": 1,
    "text": "توانا و دانندهٔ روزگار"
  },
  {
    "poem_id": 1788,
    "vorder": 177,
    "position": 0,
    "text": "اگر تاب گیرد دل من ز داد"
  },
  {
    "poem_id": 1788,
    "vorder": 178,
    "position": 1,
    "text": "ازین پس مرا تخت شاهی مباد"
  },
  {
    "poem_id": 1788,
    "vorder": 179,
    "position": 0,
    "text": "زن فرخ پاک یزدان‌پرست"
  },
  {
    "poem_id": 1788,
    "vorder": 180,
    "position": 1,
    "text": "دگر باره بر گاو مالید دست"
  },
  {
    "poem_id": 1788,
    "vorder": 181,
    "position": 0,
    "text": "به نام خداوند زردشت گفت"
  },
  {
    "poem_id": 1788,
    "vorder": 182,
    "position": 1,
    "text": "که بیرون گذاری نهان از نهفت"
  },
  {
    "poem_id": 1788,
    "vorder": 183,
    "position": 0,
    "text": "ز پستان گاوش ببارید شیر"
  },
  {
    "poem_id": 1788,
    "vorder": 184,
    "position": 1,
    "text": "زن میزبان گفت کای دستگیر"
  },
  {
    "poem_id": 1788,
    "vorder": 185,
    "position": 0,
    "text": "تو بیداد را کرده‌ای دادگر"
  },
  {
    "poem_id": 1788,
    "vorder": 186,
    "position": 1,
    "text": "وگرنه نبودی ورا این هنر"
  },
  {
    "poem_id": 1788,
    "vorder": 187,
    "position": 0,
    "text": "ازان پس چنین گفت با کدخدای"
  },
  {
    "poem_id": 1788,
    "vorder": 188,
    "position": 1,
    "text": "که بیداد را داد شد باز جای"
  },
  {
    "poem_id": 1788,
    "vorder": 189,
    "position": 0,
    "text": "تو با خنده و رامشی باش زین"
  },
  {
    "poem_id": 1788,
    "vorder": 190,
    "position": 1,
    "text": "که بخشود بر ما جهان‌آفرین"
  },
  {
    "poem_id": 1788,
    "vorder": 191,
    "position": 0,
    "text": "به هرکاره چون شیربا پخته شد"
  },
  {
    "poem_id": 1788,
    "vorder": 192,
    "position": 1,
    "text": "زن و مرد زان کار پردخته شد"
  },
  {
    "poem_id": 1788,
    "vorder": 193,
    "position": 0,
    "text": "به نزدیک مهمان شد آن پاک‌رای"
  },
  {
    "poem_id": 1788,
    "vorder": 194,
    "position": 1,
    "text": "همی برد خوان از پسش کدخدای"
  },
  {
    "poem_id": 1788,
    "vorder": 195,
    "position": 0,
    "text": "نهاده بدو کاسهٔ شیربا"
  },
  {
    "poem_id": 1788,
    "vorder": 196,
    "position": 1,
    "text": "چه نیکو بدی گر بدی زیربا"
  },
  {
    "poem_id": 1788,
    "vorder": 197,
    "position": 0,
    "text": "ازان شیربا شاه لختی بخورد"
  },
  {
    "poem_id": 1788,
    "vorder": 198,
    "position": 1,
    "text": "چنین گفت پس با زن رادمرد"
  },
  {
    "poem_id": 1788,
    "vorder": 199,
    "position": 0,
    "text": "که این تازیانه به درگاه بر"
  },
  {
    "poem_id": 1788,
    "vorder": 200,
    "position": 1,
    "text": "بیاویز جایی که باشد گذر"
  },
  {
    "poem_id": 1788,
    "vorder": 201,
    "position": 0,
    "text": "نگه کن یکی شاخ بر در بلند"
  },
  {
    "poem_id": 1788,
    "vorder": 202,
    "position": 1,
    "text": "نباید که از باد یابد گزند"
  },
  {
    "poem_id": 1788,
    "vorder": 203,
    "position": 0,
    "text": "ازان پس ببین تا که آید ز راه"
  },
  {
    "poem_id": 1788,
    "vorder": 204,
    "position": 1,
    "text": "همی کن بدین تازیانه نگاه"
  },
  {
    "poem_id": 1788,
    "vorder": 205,
    "position": 0,
    "text": "خداوند خانه بپویید سخت"
  },
  {
    "poem_id": 1788,
    "vorder": 206,
    "position": 1,
    "text": "بیاویخت آن شیب شاه از درخت"
  },
  {
    "poem_id": 1788,
    "vorder": 207,
    "position": 0,
    "text": "همی داشت آن را زمانی نگاه"
  },
  {
    "poem_id": 1788,
    "vorder": 208,
    "position": 1,
    "text": "پدید آمد از راه بی‌مر سپاه"
  },
  {
    "poem_id": 1788,
    "vorder": 209,
    "position": 0,
    "text": "هرانکس که این تازیانه بدید"
  },
  {
    "poem_id": 1788,
    "vorder": 210,
    "position": 1,
    "text": "به بهرامشاه آفرین گسترید"
  },
  {
    "poem_id": 1788,
    "vorder": 211,
    "position": 0,
    "text": "پیاده همه پیش شیب دراز"
  },
  {
    "poem_id": 1788,
    "vorder": 212,
    "position": 1,
    "text": "برفتند و بردند یک یک نماز"
  },
  {
    "poem_id": 1788,
    "vorder": 213,
    "position": 0,
    "text": "زن و شوی گفت این به جز شاه نیست"
  },
  {
    "poem_id": 1788,
    "vorder": 214,
    "position": 1,
    "text": "چنین چهره جز درخور گاه نیست"
  },
  {
    "poem_id": 1788,
    "vorder": 215,
    "position": 0,
    "text": "پر از شرم رفتند هر دو ز راه"
  },
  {
    "poem_id": 1788,
    "vorder": 216,
    "position": 1,
    "text": "پیاده دوان تا به نزدیک شاه"
  },
  {
    "poem_id": 1788,
    "vorder": 217,
    "position": 0,
    "text": "که شاها بزرگا ردا بخردا"
  },
  {
    "poem_id": 1788,
    "vorder": 218,
    "position": 1,
    "text": "جهاندار و بر موبدان موبدا"
  },
  {
    "poem_id": 1788,
    "vorder": 219,
    "position": 0,
    "text": "بدین خانه درویش بد میزبان"
  },
  {
    "poem_id": 1788,
    "vorder": 220,
    "position": 1,
    "text": "زنی بی‌نوا شوی پالیزبان"
  },
  {
    "poem_id": 1788,
    "vorder": 221,
    "position": 0,
    "text": "بران بندگی نیز پوزش نمود"
  },
  {
    "poem_id": 1788,
    "vorder": 222,
    "position": 1,
    "text": "همان شاه ما را پژوهش نمود"
  },
  {
    "poem_id": 1788,
    "vorder": 223,
    "position": 0,
    "text": "که چون تو بدین جای مهمان رسید"
  },
  {
    "poem_id": 1788,
    "vorder": 224,
    "position": 1,
    "text": "بدین بی‌نوا خانه و مان رسید"
  },
  {
    "poem_id": 1788,
    "vorder": 225,
    "position": 0,
    "text": "بدو گفت بهرام کای روزبه"
  },
  {
    "poem_id": 1788,
    "vorder": 226,
    "position": 1,
    "text": "ترا دادم این مرز و این خوب ده"
  },
  {
    "poem_id": 1788,
    "vorder": 227,
    "position": 0,
    "text": "همیشه جز از میزبانی مکن"
  },
  {
    "poem_id": 1788,
    "vorder": 228,
    "position": 1,
    "text": "برین باش و پالیزبانی مکن"
  },
  {
    "poem_id": 1788,
    "vorder": 229,
    "position": 0,
    "text": "بگفت این و خندان بشد زان سرای"
  },
  {
    "poem_id": 1788,
    "vorder": 230,
    "position": 1,
    "text": "نشست از بر بارهٔ بادپای"
  },
  {
    "poem_id": 1788,
    "vorder": 231,
    "position": 0,
    "text": "بشد زان ده بی‌نوا شهریار"
  },
  {
    "poem_id": 1788,
    "vorder": 232,
    "position": 1,
    "text": "بیامد به ایوان گوهرنگار"
  }
]