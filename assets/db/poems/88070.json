  {
    "poem_id": 88070,
    "vorder": 264,
    "position": 1,
    "text": "و گرنه ز دژ زود بگریختی"
  },
  {
    "poem_id": 88070,
    "vorder": 265,
    "position": 0,
    "text": "سپه را درم داد و آباد کرد"
  },
  {
    "poem_id": 88070,
    "vorder": 266,
    "position": 1,
    "text": "به هر کار با هر کسی داد کرد"
  },
  {
    "poem_id": 88070,
    "vorder": 267,
    "position": 0,
    "text": "همان خود و شمشیر و برگستوان"
  },
  {
    "poem_id": 88070,
    "vorder": 268,
    "position": 1,
    "text": "سپرهای چینی و تیر و کمان"
  },
  {
    "poem_id": 88070,
    "vorder": 269,
    "position": 0,
    "text": "ببخشید بر لشکرش بی‌شمار"
  },
  {
    "poem_id": 88070,
    "vorder": 270,
    "position": 1,
    "text": "به ویژه کسی کو کند کارزار"
  },
  {
    "poem_id": 88070,
    "vorder": 271,
    "position": 0,
    "text": "چو آسوده شد ز این به شادی نشست"
  },
  {
    "poem_id": 88070,
    "vorder": 272,
    "position": 1,
    "text": "خود و جنگسازان خسرو پرست"
  },
  {
    "poem_id": 88070,
    "vorder": 273,
    "position": 0,
    "text": "پری چهره هر روز صد چنگ‌زن"
