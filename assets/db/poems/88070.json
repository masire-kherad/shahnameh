[
  {
    "poem_id": 88070,
    "vorder": 1,
    "position": 0,
    "text": "وز آن سوی گنگ اندر افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 2,
    "position": 1,
    "text": "به رخشنده روز و به هنگام خواب"
  },
  {
    "poem_id": 88070,
    "vorder": 3,
    "position": 0,
    "text": "همی گفت با هرکه بد کاردان"
  },
  {
    "poem_id": 88070,
    "vorder": 4,
    "position": 1,
    "text": "بزرگان بیدار و بسیاردان"
  },
  {
    "poem_id": 88070,
    "vorder": 5,
    "position": 0,
    "text": "که اکنون که دشمن به بالین رسید"
  },
  {
    "poem_id": 88070,
    "vorder": 6,
    "position": 1,
    "text": "به گنگ اندرون چون توان آرمید"
  },
  {
    "poem_id": 88070,
    "vorder": 7,
    "position": 0,
    "text": "همه برگشادند گویا زبان"
  },
  {
    "poem_id": 88070,
    "vorder": 8,
    "position": 1,
    "text": "که اکنون که نزدیک شد بد گمان"
  },
  {
    "poem_id": 88070,
    "vorder": 9,
    "position": 0,
    "text": "جز از جنگ چیزی نبینیم راه"
  },
  {
    "poem_id": 88070,
    "vorder": 10,
    "position": 1,
    "text": "زبونی نه خوبست چندین سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 11,
    "position": 0,
    "text": "بگفتند وز پیش برخاستند"
  },
  {
    "poem_id": 88070,
    "vorder": 12,
    "position": 1,
    "text": "همه شب همی لشکر آراستند"
  },
  {
    "poem_id": 88070,
    "vorder": 13,
    "position": 0,
    "text": "سپیده دمان گاه بانگ خروس"
  },
  {
    "poem_id": 88070,
    "vorder": 14,
    "position": 1,
    "text": "ز درگاه برخاست آوای کوس"
  },
  {
    "poem_id": 88070,
    "vorder": 15,
    "position": 0,
    "text": "سپاهی به هامون بیامد ز گنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 16,
    "position": 1,
    "text": "که بر مور و بر پشه شد راه تنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 17,
    "position": 0,
    "text": "چو آمد به نزدیک گلزریون"
  },
  {
    "poem_id": 88070,
    "vorder": 18,
    "position": 1,
    "text": "زمین شد به سان که بیستون"
  },
  {
    "poem_id": 88070,
    "vorder": 19,
    "position": 0,
    "text": "همی لشکر آمد سه روز و سه شب"
  },
  {
    "poem_id": 88070,
    "vorder": 20,
    "position": 1,
    "text": "جهان شد پرآشوب جنگ و جلب"
  },
  {
    "poem_id": 88070,
    "vorder": 21,
    "position": 0,
    "text": "کشیدند بر هفت فرسنگ نخ"
  },
  {
    "poem_id": 88070,
    "vorder": 22,
    "position": 1,
    "text": "فزون گشت مردم ز مور و ملخ"
  },
  {
    "poem_id": 88070,
    "vorder": 23,
    "position": 0,
    "text": "چهارم سپه برکشیدند صف"
  },
  {
    "poem_id": 88070,
    "vorder": 24,
    "position": 1,
    "text": "ز دریا برآمد به خورشید تف"
  },
  {
    "poem_id": 88070,
    "vorder": 25,
    "position": 0,
    "text": "به قلب اندر افراسیاب و ردان"
  },
  {
    "poem_id": 88070,
    "vorder": 26,
    "position": 1,
    "text": "سواران گردنکش و بخردان"
  },
  {
    "poem_id": 88070,
    "vorder": 27,
    "position": 0,
    "text": "سوی میمنه جهن افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 28,
    "position": 1,
    "text": "همی نیزه بگذاشت از آفتاب"
  },
  {
    "poem_id": 88070,
    "vorder": 29,
    "position": 0,
    "text": "وز این روی کیخسرو از قلبگاه"
  },
  {
    "poem_id": 88070,
    "vorder": 30,
    "position": 1,
    "text": "همی داشت چون کوه پشت سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 31,
    "position": 0,
    "text": "چو گودرز و چون طوس نوذر نژاد"
  },
  {
    "poem_id": 88070,
    "vorder": 32,
    "position": 1,
    "text": "منوشان خوزان پیروز و داد"
  },
  {
    "poem_id": 88070,
    "vorder": 33,
    "position": 0,
    "text": "چو گرگین میلاد و رهام شیر"
  },
  {
    "poem_id": 88070,
    "vorder": 34,
    "position": 1,
    "text": "هجیر و چو شیدوش گرد دلیر"
  },
  {
    "poem_id": 88070,
    "vorder": 35,
    "position": 0,
    "text": "فریبرز کاووس بر میمنه"
  },
  {
    "poem_id": 88070,
    "vorder": 36,
    "position": 1,
    "text": "سپاهی همه یک‌دل و یک تنه"
  },
  {
    "poem_id": 88070,
    "vorder": 37,
    "position": 0,
    "text": "منوچهر بر میسره جای داشت"
  },
  {
    "poem_id": 88070,
    "vorder": 38,
    "position": 1,
    "text": "که با جنگ هر جنگیی پای داشت"
  },
  {
    "poem_id": 88070,
    "vorder": 39,
    "position": 0,
    "text": "به پشت سپه گیو گودرز بود"
  },
  {
    "poem_id": 88070,
    "vorder": 40,
    "position": 1,
    "text": "که پشت و نگهبان هر مرز بود"
  },
  {
    "poem_id": 88070,
    "vorder": 41,
    "position": 0,
    "text": "زمین کان آهن شد از میخ نعل"
  },
  {
    "poem_id": 88070,
    "vorder": 42,
    "position": 1,
    "text": "همه آب دریا شد از خون لعل"
  },
  {
    "poem_id": 88070,
    "vorder": 43,
    "position": 0,
    "text": "به سر بر ز گرد سیاه ابر بست"
  },
  {
    "poem_id": 88070,
    "vorder": 44,
    "position": 1,
    "text": "تبیره دل سنگ خارا بخست"
  },
  {
    "poem_id": 88070,
    "vorder": 45,
    "position": 0,
    "text": "زمین گشت چون چادر آبنوس"
  },
  {
    "poem_id": 88070,
    "vorder": 46,
    "position": 1,
    "text": "ستاره غمی شد ز آوای کوس"
  },
  {
    "poem_id": 88070,
    "vorder": 47,
    "position": 0,
    "text": "زمین گشت جنبان چو ابر سیاه"
  },
  {
    "poem_id": 88070,
    "vorder": 48,
    "position": 1,
    "text": "تو گفتی همی بر نتابد سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 49,
    "position": 0,
    "text": "همه دشت مغز و سر و پای بود"
  },
  {
    "poem_id": 88070,
    "vorder": 50,
    "position": 1,
    "text": "همانا مگر بر زمین جای بود"
  },
  {
    "poem_id": 88070,
    "vorder": 51,
    "position": 0,
    "text": "همی نعل اسبان سر کشته خست"
  },
  {
    "poem_id": 88070,
    "vorder": 52,
    "position": 1,
    "text": "همه دشت بی‌تن سر و پای و دست"
  },
  {
    "poem_id": 88070,
    "vorder": 53,
    "position": 0,
    "text": "خردمند مردم به یکسو شدند"
  },
  {
    "poem_id": 88070,
    "vorder": 54,
    "position": 1,
    "text": "دو لشکر بر این کار خستو شدند"
  },
  {
    "poem_id": 88070,
    "vorder": 55,
    "position": 0,
    "text": "که گر یک زمان نیز لشکر چنین"
  },
  {
    "poem_id": 88070,
    "vorder": 56,
    "position": 1,
    "text": "بماند بر این دشت با درد و کین"
  },
  {
    "poem_id": 88070,
    "vorder": 57,
    "position": 0,
    "text": "نماند یکی ز این سواران به جای"
  },
  {
    "poem_id": 88070,
    "vorder": 58,
    "position": 1,
    "text": "همانا سپهر اندر آید ز پای"
  },
  {
    "poem_id": 88070,
    "vorder": 59,
    "position": 0,
    "text": "ز بس چاک چاک تبرزین و خود"
  },
  {
    "poem_id": 88070,
    "vorder": 60,
    "position": 1,
    "text": "روانها همی داد تن را درود"
  },
  {
    "poem_id": 88070,
    "vorder": 61,
    "position": 0,
    "text": "چو کیخسرو آن پیچش جنگ دید"
  },
  {
    "poem_id": 88070,
    "vorder": 62,
    "position": 1,
    "text": "جهان بر دل خویشتن تنگ دید"
  },
  {
    "poem_id": 88070,
    "vorder": 63,
    "position": 0,
    "text": "بیامد به یکسو ز پشت سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 64,
    "position": 1,
    "text": "به پیش خداوند شد دادخواه"
  },
  {
    "poem_id": 88070,
    "vorder": 65,
    "position": 0,
    "text": "که ای برتر از دانش پارسا"
  },
  {
    "poem_id": 88070,
    "vorder": 66,
    "position": 1,
    "text": "جهاندار و بر هر کسی پادشا"
  },
  {
    "poem_id": 88070,
    "vorder": 67,
    "position": 0,
    "text": "اگر نیستم من ستم یافته"
  },
  {
    "poem_id": 88070,
    "vorder": 68,
    "position": 1,
    "text": "چو آهن به کوره درون تافته"
  },
  {
    "poem_id": 88070,
    "vorder": 69,
    "position": 0,
    "text": "نخواهم که پیروز باشم به جنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 70,
    "position": 1,
    "text": "نه بر دادگر بر کنم جای تنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 71,
    "position": 0,
    "text": "بگفت این و بر خاک مالید روی"
  },
  {
    "poem_id": 88070,
    "vorder": 72,
    "position": 1,
    "text": "جهان پر شد از نالهٔ زار اوی"
  },
  {
    "poem_id": 88070,
    "vorder": 73,
    "position": 0,
    "text": "همانگه برآمد یکی باد سخت"
  },
  {
    "poem_id": 88070,
    "vorder": 74,
    "position": 1,
    "text": "که بشکست شاداب شاخ درخت"
  },
  {
    "poem_id": 88070,
    "vorder": 75,
    "position": 0,
    "text": "همی خاک بر داشت از رزمگاه"
  },
  {
    "poem_id": 88070,
    "vorder": 76,
    "position": 1,
    "text": "بزد بر رخ شاه توران سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 77,
    "position": 0,
    "text": "کسی کو سر از جنگ برتافتی"
  },
  {
    "poem_id": 88070,
    "vorder": 78,
    "position": 1,
    "text": "چو افراسیاب آگهی یافتی"
  },
  {
    "poem_id": 88070,
    "vorder": 79,
    "position": 0,
    "text": "بریدی به خنجر سرش را ز تن"
  },
  {
    "poem_id": 88070,
    "vorder": 80,
    "position": 1,
    "text": "جز از خاک و ریگش نبودی کفن"
  },
  {
    "poem_id": 88070,
    "vorder": 81,
    "position": 0,
    "text": "چنین تا سپهر و زمین تار شد"
  },
  {
    "poem_id": 88070,
    "vorder": 82,
    "position": 1,
    "text": "فراوان ز ترکان گرفتار شد"
  },
  {
    "poem_id": 88070,
    "vorder": 83,
    "position": 0,
    "text": "بر آمد شب و چادر مشک رنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 84,
    "position": 1,
    "text": "بپوشید تا کس نیاید به جنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 85,
    "position": 0,
    "text": "سپه باز چیدند شاهان ز دشت"
  },
  {
    "poem_id": 88070,
    "vorder": 86,
    "position": 1,
    "text": "چو روی زمین ز آسمان تیره گشت"
  },
  {
    "poem_id": 88070,
    "vorder": 87,
    "position": 0,
    "text": "همه دامن کوه تا پیش رود"
  },
  {
    "poem_id": 88070,
    "vorder": 88,
    "position": 1,
    "text": "سپه بود با جوشن و درع و خود"
  },
  {
    "poem_id": 88070,
    "vorder": 89,
    "position": 0,
    "text": "برافروختند آتش از هر سوی"
  },
  {
    "poem_id": 88070,
    "vorder": 90,
    "position": 1,
    "text": "طلایه بیامد ز هر پهلوی"
  },
  {
    "poem_id": 88070,
    "vorder": 91,
    "position": 0,
    "text": "همی جنگ را ساخت افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 92,
    "position": 1,
    "text": "همی بود تا چشمهٔ آفتاب"
  },
  {
    "poem_id": 88070,
    "vorder": 93,
    "position": 0,
    "text": "بر آید رخ کوه رخشان کند"
  },
  {
    "poem_id": 88070,
    "vorder": 94,
    "position": 1,
    "text": "زمین چون نگین بدخشان کند"
  },
  {
    "poem_id": 88070,
    "vorder": 95,
    "position": 0,
    "text": "جهان آفرین را دگر بود رای"
  },
  {
    "poem_id": 88070,
    "vorder": 96,
    "position": 1,
    "text": "به هر کار با رای او نیست پای"
  },
  {
    "poem_id": 88070,
    "vorder": 97,
    "position": 0,
    "text": "شب تیره چون روی زنگی سیاه"
  },
  {
    "poem_id": 88070,
    "vorder": 98,
    "position": 1,
    "text": "کس آمد ز گستهم نوذر به شاه"
  },
  {
    "poem_id": 88070,
    "vorder": 99,
    "position": 0,
    "text": "که شاه جهان جاودان زنده باد"
  },
  {
    "poem_id": 88070,
    "vorder": 100,
    "position": 1,
    "text": "که ما بازگشتیم پیروز و شاد"
  },
  {
    "poem_id": 88070,
    "vorder": 101,
    "position": 0,
    "text": "بدان نامداران افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 102,
    "position": 1,
    "text": "رسیدیم ناگه به هنگام خواب"
  },
  {
    "poem_id": 88070,
    "vorder": 103,
    "position": 0,
    "text": "از ایشان سواری طلایه نبود"
  },
  {
    "poem_id": 88070,
    "vorder": 104,
    "position": 1,
    "text": "کسی را ز اندیشه مایه نبود"
  },
  {
    "poem_id": 88070,
    "vorder": 105,
    "position": 0,
    "text": "چو بیدار گشتند ز ایشان سران"
  },
  {
    "poem_id": 88070,
    "vorder": 106,
    "position": 1,
    "text": "کشیدیم شمشیر و گرز گران"
  },
  {
    "poem_id": 88070,
    "vorder": 107,
    "position": 0,
    "text": "چو شب روز شد جز قراخان نماند"
  },
  {
    "poem_id": 88070,
    "vorder": 108,
    "position": 1,
    "text": "ز مردان ایشان فراوان نماند"
  },
  {
    "poem_id": 88070,
    "vorder": 109,
    "position": 0,
    "text": "همه دشت ز ایشان سرون و سر است"
  },
  {
    "poem_id": 88070,
    "vorder": 110,
    "position": 1,
    "text": "زمین بستر و خاکشان چادر است"
  },
  {
    "poem_id": 88070,
    "vorder": 111,
    "position": 0,
    "text": "به مژده ز رستم هم اندر زمان"
  },
  {
    "poem_id": 88070,
    "vorder": 112,
    "position": 1,
    "text": "هیونی بیامد سپیده‌دمان"
  },
  {
    "poem_id": 88070,
    "vorder": 113,
    "position": 0,
    "text": "که ما در بیابان خبر یافتیم"
  },
  {
    "poem_id": 88070,
    "vorder": 114,
    "position": 1,
    "text": "بدان آگهی تیز بشتافتیم"
  },
  {
    "poem_id": 88070,
    "vorder": 115,
    "position": 0,
    "text": "شب و روز رستم یکی داشتی"
  },
  {
    "poem_id": 88070,
    "vorder": 116,
    "position": 1,
    "text": "چو تنها شدی راه بگذاشتی"
  },
  {
    "poem_id": 88070,
    "vorder": 117,
    "position": 0,
    "text": "بدیشان رسیدیم هنگام روز"
  },
  {
    "poem_id": 88070,
    "vorder": 118,
    "position": 1,
    "text": "چو بر زد سر از چرخ گیتی فروز"
  },
  {
    "poem_id": 88070,
    "vorder": 119,
    "position": 0,
    "text": "تهمتن کمان را به زه برنهاد"
  },
  {
    "poem_id": 88070,
    "vorder": 120,
    "position": 1,
    "text": "چو نزدیک شد ترگ بر سر نهاد"
  },
  {
    "poem_id": 88070,
    "vorder": 121,
    "position": 0,
    "text": "نخستین که از کلک بگشاد شست"
  },
  {
    "poem_id": 88070,
    "vorder": 122,
    "position": 1,
    "text": "قراخان ز پیکان رستم بخست"
  },
  {
    "poem_id": 88070,
    "vorder": 123,
    "position": 0,
    "text": "به توران زمین شد کنون کینه‌خواه"
  },
  {
    "poem_id": 88070,
    "vorder": 124,
    "position": 1,
    "text": "همانا که آگاهی آمد به شاه"
  },
  {
    "poem_id": 88070,
    "vorder": 125,
    "position": 0,
    "text": "به شادی به لشکر بر آمد خروش"
  },
  {
    "poem_id": 88070,
    "vorder": 126,
    "position": 1,
    "text": "سپهدار ترکان همی داشت گوش"
  },
  {
    "poem_id": 88070,
    "vorder": 127,
    "position": 0,
    "text": "هر آن کس که بودند خسروپرست"
  },
  {
    "poem_id": 88070,
    "vorder": 128,
    "position": 1,
    "text": "به شادی و رامش گشادند دست"
  },
  {
    "poem_id": 88070,
    "vorder": 129,
    "position": 0,
    "text": "سواری بیامد هم اندر شتاب"
  },
  {
    "poem_id": 88070,
    "vorder": 130,
    "position": 1,
    "text": "خروشان به نزدیک افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 131,
    "position": 0,
    "text": "که از لشکر ما قراخان برست"
  },
  {
    "poem_id": 88070,
    "vorder": 132,
    "position": 1,
    "text": "رسیدست نزدیک ما مرد شست"
  },
  {
    "poem_id": 88070,
    "vorder": 133,
    "position": 0,
    "text": "سپاهی به توران نهادند روی"
  },
  {
    "poem_id": 88070,
    "vorder": 134,
    "position": 1,
    "text": "کز ایشان شود ناپدید آب جوی"
  },
  {
    "poem_id": 88070,
    "vorder": 135,
    "position": 0,
    "text": "چنین گفت با رایزن شهریار"
  },
  {
    "poem_id": 88070,
    "vorder": 136,
    "position": 1,
    "text": "که پیکار سخت اندر آمد به کار"
  },
  {
    "poem_id": 88070,
    "vorder": 137,
    "position": 0,
    "text": "چو رستم بگیرد سر گاه ما"
  },
  {
    "poem_id": 88070,
    "vorder": 138,
    "position": 1,
    "text": "به یکبارگی گم شود راه ما"
  },
  {
    "poem_id": 88070,
    "vorder": 139,
    "position": 0,
    "text": "کنونش گمان آن که ما نشنویم"
  },
  {
    "poem_id": 88070,
    "vorder": 140,
    "position": 1,
    "text": "چنین کار در جنگ کیخسرویم"
  },
  {
    "poem_id": 88070,
    "vorder": 141,
    "position": 0,
    "text": "چو آتش بر ایشان شبیخون کنیم"
  },
  {
    "poem_id": 88070,
    "vorder": 142,
    "position": 1,
    "text": "ز خون روی کشور چو جیحون کنیم"
  },
  {
    "poem_id": 88070,
    "vorder": 143,
    "position": 0,
    "text": "چو کیخسرو آید ز لشکر دو بهر"
  },
  {
    "poem_id": 88070,
    "vorder": 144,
    "position": 1,
    "text": "نبیند مگر بام و دیوار و شهر"
  },
  {
    "poem_id": 88070,
    "vorder": 145,
    "position": 0,
    "text": "سراسر همه لشکر این دید رای"
  },
  {
    "poem_id": 88070,
    "vorder": 146,
    "position": 1,
    "text": "همان مرد فرزانه و رهنمای"
  },
  {
    "poem_id": 88070,
    "vorder": 147,
    "position": 0,
    "text": "بنه هرچه بودش هم آنجا بماند"
  },
  {
    "poem_id": 88070,
    "vorder": 148,
    "position": 1,
    "text": "چو آتش از آن دشت لشکر براند"
  },
  {
    "poem_id": 88070,
    "vorder": 149,
    "position": 0,
    "text": "همانگه طلایه بیامد ز دشت"
  },
  {
    "poem_id": 88070,
    "vorder": 150,
    "position": 1,
    "text": "که گرد سپاه از هوا برگذشت"
  },
  {
    "poem_id": 88070,
    "vorder": 151,
    "position": 0,
    "text": "همه دشت خرگاه و خیمه است و بس"
  },
  {
    "poem_id": 88070,
    "vorder": 152,
    "position": 1,
    "text": "از ایشان به خیمه درون نیست کس"
  },
  {
    "poem_id": 88070,
    "vorder": 153,
    "position": 0,
    "text": "بدانست خسرو که سالار چین"
  },
  {
    "poem_id": 88070,
    "vorder": 154,
    "position": 1,
    "text": "چرا رفت بیگاه زان دشت کین"
  },
  {
    "poem_id": 88070,
    "vorder": 155,
    "position": 0,
    "text": "ز گستهم و رستم خبر یافتست"
  },
  {
    "poem_id": 88070,
    "vorder": 156,
    "position": 1,
    "text": "بدان آگهی تیز بشتافتست"
  },
  {
    "poem_id": 88070,
    "vorder": 157,
    "position": 0,
    "text": "نوندی برافگند هم در زمان"
  },
  {
    "poem_id": 88070,
    "vorder": 158,
    "position": 1,
    "text": "فرستاد نزدیک رستم دمان"
  },
  {
    "poem_id": 88070,
    "vorder": 159,
    "position": 0,
    "text": "که برگشت ز این کینه افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 160,
    "position": 1,
    "text": "همانا به جنگ تو دارد شتاب"
  },
  {
    "poem_id": 88070,
    "vorder": 161,
    "position": 0,
    "text": "سپه را بیارای و بیدار باش"
  },
  {
    "poem_id": 88070,
    "vorder": 162,
    "position": 1,
    "text": "برو خویشتن زو نگهدار باش"
  },
  {
    "poem_id": 88070,
    "vorder": 163,
    "position": 0,
    "text": "نوند جهاندیده شایسته بود"
  },
  {
    "poem_id": 88070,
    "vorder": 164,
    "position": 1,
    "text": "بدان راه بی‌راه بایسته بود"
  },
  {
    "poem_id": 88070,
    "vorder": 165,
    "position": 0,
    "text": "همی رفت چون پیش رستم رسید"
  },
  {
    "poem_id": 88070,
    "vorder": 166,
    "position": 1,
    "text": "گو شیردل را میان بسته دید"
  },
  {
    "poem_id": 88070,
    "vorder": 167,
    "position": 0,
    "text": "سپه گرزها بر نهاده به دوش"
  },
  {
    "poem_id": 88070,
    "vorder": 168,
    "position": 1,
    "text": "یکایک نهاده به آواز گوش"
  },
  {
    "poem_id": 88070,
    "vorder": 169,
    "position": 0,
    "text": "به رستم بگفت آنچه پیغام بود"
  },
  {
    "poem_id": 88070,
    "vorder": 170,
    "position": 1,
    "text": "که فرجام پیغامش آرام بود"
  },
  {
    "poem_id": 88070,
    "vorder": 171,
    "position": 0,
    "text": "وز این روی کیخسرو کینه‌جوی"
  },
  {
    "poem_id": 88070,
    "vorder": 172,
    "position": 1,
    "text": "نشسته به آرام بی‌گفت و گوی"
  },
  {
    "poem_id": 88070,
    "vorder": 173,
    "position": 0,
    "text": "همی کرد بخشش همه بر سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 174,
    "position": 1,
    "text": "سراپرده و خیمه و تاج و گاه"
  },
  {
    "poem_id": 88070,
    "vorder": 175,
    "position": 0,
    "text": "از ایرانیان کشتگان را بجست"
  },
  {
    "poem_id": 88070,
    "vorder": 176,
    "position": 1,
    "text": "کفن کرد وز خون و گلشان بشست"
  },
  {
    "poem_id": 88070,
    "vorder": 177,
    "position": 0,
    "text": "به رسم مهان کشته را دخمه کرد"
  },
  {
    "poem_id": 88070,
    "vorder": 178,
    "position": 1,
    "text": "چو برداشت زان خاک و خون نبرد"
  },
  {
    "poem_id": 88070,
    "vorder": 179,
    "position": 0,
    "text": "بنه بر نهاد و سپه بر نشاند"
  },
  {
    "poem_id": 88070,
    "vorder": 180,
    "position": 1,
    "text": "دمان از پس شاه ترکان براند"
  },
  {
    "poem_id": 88070,
    "vorder": 181,
    "position": 0,
    "text": "چو نزدیک شهر آمد افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 182,
    "position": 1,
    "text": "بر آن بد که رستم شود سیرخواب"
  },
  {
    "poem_id": 88070,
    "vorder": 183,
    "position": 0,
    "text": "کنون من شبیخون کنم بر سرش"
  },
  {
    "poem_id": 88070,
    "vorder": 184,
    "position": 1,
    "text": "برآریم گرد از سر لشکرش"
  },
  {
    "poem_id": 88070,
    "vorder": 185,
    "position": 0,
    "text": "به تاریکی اندر طلایه بدید"
  },
  {
    "poem_id": 88070,
    "vorder": 186,
    "position": 1,
    "text": "به شهر اندر آواز ایشان شنید"
  },
  {
    "poem_id": 88070,
    "vorder": 187,
    "position": 0,
    "text": "فروماند ز آن کار رستم شگفت"
  },
  {
    "poem_id": 88070,
    "vorder": 188,
    "position": 1,
    "text": "همی راند و اندیشه اندر گرفت"
  },
  {
    "poem_id": 88070,
    "vorder": 189,
    "position": 0,
    "text": "همه کوفته لشکر و ریخته"
  },
  {
    "poem_id": 88070,
    "vorder": 190,
    "position": 1,
    "text": "به شیرین روان اندر آویخته"
  },
  {
    "poem_id": 88070,
    "vorder": 191,
    "position": 0,
    "text": "به پیش اندرون رستم تیزچنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 192,
    "position": 1,
    "text": "پس پشت شاه و سواران جنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 193,
    "position": 0,
    "text": "کسی را که نزدیک بد پیش خواند"
  },
  {
    "poem_id": 88070,
    "vorder": 194,
    "position": 1,
    "text": "وز ایشان فراوان سخنها براند"
  },
  {
    "poem_id": 88070,
    "vorder": 195,
    "position": 0,
    "text": "بپرسید کاین را چه بینید روی"
  },
  {
    "poem_id": 88070,
    "vorder": 196,
    "position": 1,
    "text": "چنین گفت با نامور چاره‌جوی"
  },
  {
    "poem_id": 88070,
    "vorder": 197,
    "position": 0,
    "text": "که در گنگ دژ آن همه گنج شاه"
  },
  {
    "poem_id": 88070,
    "vorder": 198,
    "position": 1,
    "text": "چه بایست اکنون همه رنج راه"
  },
  {
    "poem_id": 88070,
    "vorder": 199,
    "position": 0,
    "text": "زمین هشت فرسنگ بالای اوی"
  },
  {
    "poem_id": 88070,
    "vorder": 200,
    "position": 1,
    "text": "همانا که چارست پهنای اوی"
  },
  {
    "poem_id": 88070,
    "vorder": 201,
    "position": 0,
    "text": "زن و کودک و گنج و چندان سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 202,
    "position": 1,
    "text": "بزرگی و فرمان و تخت و کلاه"
  },
  {
    "poem_id": 88070,
    "vorder": 203,
    "position": 0,
    "text": "بر آن بارهٔ دژ نپرد عقاب"
  },
  {
    "poem_id": 88070,
    "vorder": 204,
    "position": 1,
    "text": "نبیند کسی آن بلندی به خواب"
  },
  {
    "poem_id": 88070,
    "vorder": 205,
    "position": 0,
    "text": "خورش هست و ایوان و گنج و سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 206,
    "position": 1,
    "text": "ترا رنج بدخواه را تاج و گاه"
  },
  {
    "poem_id": 88070,
    "vorder": 207,
    "position": 0,
    "text": "همان بوم کو را بهشت است نام"
  },
  {
    "poem_id": 88070,
    "vorder": 208,
    "position": 1,
    "text": "همه جای شادی و آرام و کام"
  },
  {
    "poem_id": 88070,
    "vorder": 209,
    "position": 0,
    "text": "به هر گوشه‌ای چشمهٔ آبگیر"
  },
  {
    "poem_id": 88070,
    "vorder": 210,
    "position": 1,
    "text": "به بالا و پهنای پرتاب تیر"
  },
  {
    "poem_id": 88070,
    "vorder": 211,
    "position": 0,
    "text": "همی موبد آورد از هند و روم"
  },
  {
    "poem_id": 88070,
    "vorder": 212,
    "position": 1,
    "text": "بهشتی بر آورده آباد بوم"
  },
  {
    "poem_id": 88070,
    "vorder": 213,
    "position": 0,
    "text": "همانا کزان باره فرسنگ بیست"
  },
  {
    "poem_id": 88070,
    "vorder": 214,
    "position": 1,
    "text": "ببینند آسان که بر دشت کیست"
  },
  {
    "poem_id": 88070,
    "vorder": 215,
    "position": 0,
    "text": "ترا ز این جهان بهره جنگست و بس"
  },
  {
    "poem_id": 88070,
    "vorder": 216,
    "position": 1,
    "text": "به فرجام گیتی نماند به کس"
  },
  {
    "poem_id": 88070,
    "vorder": 217,
    "position": 0,
    "text": "چو بشنید گفتارها شهریار"
  },
  {
    "poem_id": 88070,
    "vorder": 218,
    "position": 1,
    "text": "خوش آمدش و ایمن شد از روزگار"
  },
  {
    "poem_id": 88070,
    "vorder": 219,
    "position": 0,
    "text": "بیامد به دلشاد به بهشت گنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 220,
    "position": 1,
    "text": "ابا آلت لشکر و ساز جنگ"
  },
  {
    "poem_id": 88070,
    "vorder": 221,
    "position": 0,
    "text": "همی گشت بر گرد آن شارستان"
  },
  {
    "poem_id": 88070,
    "vorder": 222,
    "position": 1,
    "text": "به دستی ندید اندر او خارستان"
  },
  {
    "poem_id": 88070,
    "vorder": 223,
    "position": 0,
    "text": "یکی کاخ بودش سر اندر هوا"
  },
  {
    "poem_id": 88070,
    "vorder": 224,
    "position": 1,
    "text": "برآوردهٔ شاه فرمان روا"
  },
  {
    "poem_id": 88070,
    "vorder": 225,
    "position": 0,
    "text": "به ایوان فرود آمد و بار داد"
  },
  {
    "poem_id": 88070,
    "vorder": 226,
    "position": 1,
    "text": "سپه را درم داد و دینار داد"
  },
  {
    "poem_id": 88070,
    "vorder": 227,
    "position": 0,
    "text": "فرستاد بر هر سوی لشکری"
  },
  {
    "poem_id": 88070,
    "vorder": 228,
    "position": 1,
    "text": "نگهبان هر لشکری مهتری"
  },
  {
    "poem_id": 88070,
    "vorder": 229,
    "position": 0,
    "text": "پیاده بر آن باره بر دیده‌بان"
  },
  {
    "poem_id": 88070,
    "vorder": 230,
    "position": 1,
    "text": "نگهبان به روز و به شب پاسبان"
  },
  {
    "poem_id": 88070,
    "vorder": 231,
    "position": 0,
    "text": "رد و موبدش بود بر دست راست"
  },
  {
    "poem_id": 88070,
    "vorder": 232,
    "position": 1,
    "text": "نویسندهٔ نامه را پیش خواست"
  },
  {
    "poem_id": 88070,
    "vorder": 233,
    "position": 0,
    "text": "یکی نامه نزدیک فغفور چین"
  },
  {
    "poem_id": 88070,
    "vorder": 234,
    "position": 1,
    "text": "نبشتند با صد هزار آفرین"
  },
  {
    "poem_id": 88070,
    "vorder": 235,
    "position": 0,
    "text": "چنین گفت کز گردش روزگار"
  },
  {
    "poem_id": 88070,
    "vorder": 236,
    "position": 1,
    "text": "نیامد مرا بهره جز کارزار"
  },
  {
    "poem_id": 88070,
    "vorder": 237,
    "position": 0,
    "text": "بپروردم آن را که بایست کشت"
  },
  {
    "poem_id": 88070,
    "vorder": 238,
    "position": 1,
    "text": "کنون شد از او روزگارم درشت"
  },
  {
    "poem_id": 88070,
    "vorder": 239,
    "position": 0,
    "text": "چو فغفور چین گر بیاید رواست"
  },
  {
    "poem_id": 88070,
    "vorder": 240,
    "position": 1,
    "text": "که بر مهر او بر روانم گواست"
  },
  {
    "poem_id": 88070,
    "vorder": 241,
    "position": 0,
    "text": "وگر خود نیاید فرستد سپاه"
  },
  {
    "poem_id": 88070,
    "vorder": 242,
    "position": 1,
    "text": "کز این سو خرامد همی کینه خواه"
  },
  {
    "poem_id": 88070,
    "vorder": 243,
    "position": 0,
    "text": "فرستاده از نزد افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 244,
    "position": 1,
    "text": "به چین اندر آمد به هنگام خواب"
  },
  {
    "poem_id": 88070,
    "vorder": 245,
    "position": 0,
    "text": "سرافراز فغفور بنواختش"
  },
  {
    "poem_id": 88070,
    "vorder": 246,
    "position": 1,
    "text": "یکی خرم ایوان بپرداختش"
  },
  {
    "poem_id": 88070,
    "vorder": 247,
    "position": 0,
    "text": "وز آن سو به گنگ اندر افراسیاب"
  },
  {
    "poem_id": 88070,
    "vorder": 248,
    "position": 1,
    "text": "نه آرام بودش نه خورد و نه خواب"
  },
  {
    "poem_id": 88070,
    "vorder": 249,
    "position": 0,
    "text": "به دیوار عراده بر پای کرد"
  },
  {
    "poem_id": 88070,
    "vorder": 250,
    "position": 1,
    "text": "به برج اندرون رزم را جای کرد"
  },
  {
    "poem_id": 88070,
    "vorder": 251,
    "position": 0,
    "text": "بفرمود تا سنگهای گران"
  },
  {
    "poem_id": 88070,
    "vorder": 252,
    "position": 1,
    "text": "کشیدند بر باره افسونگران"
  },
  {
    "poem_id": 88070,
    "vorder": 253,
    "position": 0,
    "text": "بسی کاردانان رومی بخواند"
  },
  {
    "poem_id": 88070,
    "vorder": 254,
    "position": 1,
    "text": "سپاهی به دیوار دژ برنشاند"
  },
  {
    "poem_id": 88070,
    "vorder": 255,
    "position": 0,
    "text": "برآورد بیدار دل جاثلیق"
  },
  {
    "poem_id": 88070,
    "vorder": 256,
    "position": 1,
    "text": "بر آن باره عراده و منجنیق"
  },
  {
    "poem_id": 88070,
    "vorder": 257,
    "position": 0,
    "text": "کمانهای چرخ و سپرهای کرگ"
  },
  {
    "poem_id": 88070,
    "vorder": 258,
    "position": 1,
    "text": "همه برجها پر ز خفتان و ترگ"
  },
  {
    "poem_id": 88070,
    "vorder": 259,
    "position": 0,
    "text": "گروهی ز آهنگران رنجه کرد"
  },
  {
    "poem_id": 88070,
    "vorder": 260,
    "position": 1,
    "text": "ز پولاد بر هر سوی پنجه کرد"
  },
  {
    "poem_id": 88070,
    "vorder": 261,
    "position": 0,
    "text": "ببستند بر نیزه‌های دراز"
  },
  {
    "poem_id": 88070,
    "vorder": 262,
    "position": 1,
    "text": "که هر کس که رفتی بر دژ فراز"
  },
  {
    "poem_id": 88070,
    "vorder": 263,
    "position": 0,
    "text": "بدان چنگ تیز اندر آویختی"
