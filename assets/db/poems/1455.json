[
  {
    "poem_id": 1455,
    "vorder": 1,
    "position": 0,
    "text": "همی کرد پوزش ز بهر گناه"
  },
  {
    "poem_id": 1455,
    "vorder": 2,
    "position": 1,
    "text": "مر او را همی جست هر سو سپاه"
  },
  {
    "poem_id": 1455,
    "vorder": 3,
    "position": 0,
    "text": "خبر یافت زو رستم و گیو و طوس"
  },
  {
    "poem_id": 1455,
    "vorder": 4,
    "position": 1,
    "text": "برفتند با لشکری گشن و کوس"
  },
  {
    "poem_id": 1455,
    "vorder": 5,
    "position": 0,
    "text": "به رستم چنین گفت گودرز پیر"
  },
  {
    "poem_id": 1455,
    "vorder": 6,
    "position": 1,
    "text": "که تا کرد مادر مرا سیر شیر"
  },
  {
    "poem_id": 1455,
    "vorder": 7,
    "position": 0,
    "text": "همی بینم اندر جهان تاج و تخت"
  },
  {
    "poem_id": 1455,
    "vorder": 8,
    "position": 1,
    "text": "کیان و بزرگان بیدار بخت"
  },
  {
    "poem_id": 1455,
    "vorder": 9,
    "position": 0,
    "text": "چو کاووس نشنیدم اندر جهان"
  },
  {
    "poem_id": 1455,
    "vorder": 10,
    "position": 1,
    "text": "ندیدم کس از کهتران و مهان"
  },
  {
    "poem_id": 1455,
    "vorder": 11,
    "position": 0,
    "text": "خرد نیست او را نه دانش نه رای"
  },
  {
    "poem_id": 1455,
    "vorder": 12,
    "position": 1,
    "text": "نه هوشش بجایست و نه دل بجای"
  },
  {
    "poem_id": 1455,
    "vorder": 13,
    "position": 0,
    "text": "رسیدند پس پهلوانان بدوی"
  },
  {
    "poem_id": 1455,
    "vorder": 14,
    "position": 1,
    "text": "نکوهش گر و تیز و پرخاشجوی"
  },
  {
    "poem_id": 1455,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت گودرز بیمارستان"
  },
  {
    "poem_id": 1455,
    "vorder": 16,
    "position": 1,
    "text": "ترا جای زیباتر از شارستان"
  },
  {
    "poem_id": 1455,
    "vorder": 17,
    "position": 0,
    "text": "به دشمن دهی هر زمان جای خویش"
  },
  {
    "poem_id": 1455,
    "vorder": 18,
    "position": 1,
    "text": "نگویی به کس بیهده رای خویش"
  },
  {
    "poem_id": 1455,
    "vorder": 19,
    "position": 0,
    "text": "سه بارت چنین رنج و سختی فتاد"
  },
  {
    "poem_id": 1455,
    "vorder": 20,
    "position": 1,
    "text": "سرت ز آزمایش نگشت اوستاد"
  },
  {
    "poem_id": 1455,
    "vorder": 21,
    "position": 0,
    "text": "کشیدی سپه را به مازندران"
  },
  {
    "poem_id": 1455,
    "vorder": 22,
    "position": 1,
    "text": "نگر تا چه سختی رسید اندران"
  },
  {
    "poem_id": 1455,
    "vorder": 23,
    "position": 0,
    "text": "دگرباره مهمان دشمن شدی"
  },
  {
    "poem_id": 1455,
    "vorder": 24,
    "position": 1,
    "text": "صنم بودی اکنون برهمن شدی"
  },
  {
    "poem_id": 1455,
    "vorder": 25,
    "position": 0,
    "text": "به گیتی جز از پاک یزدان نماند"
  },
  {
    "poem_id": 1455,
    "vorder": 26,
    "position": 1,
    "text": "که منشور تیغ ترا برنخواند"
  },
  {
    "poem_id": 1455,
    "vorder": 27,
    "position": 0,
    "text": "به جنگ زمین سر به سر تاختی"
  },
  {
    "poem_id": 1455,
    "vorder": 28,
    "position": 1,
    "text": "کنون باسمان نیز پرداختی"
  },
  {
    "poem_id": 1455,
    "vorder": 29,
    "position": 0,
    "text": "پس از تو بدین داستانی کنند"
  },
  {
    "poem_id": 1455,
    "vorder": 30,
    "position": 1,
    "text": "که شاهی برآمد به چرخ بلند"
  },
  {
    "poem_id": 1455,
    "vorder": 31,
    "position": 0,
    "text": "که تا ماه و خورشید را بنگرد"
  },
  {
    "poem_id": 1455,
    "vorder": 32,
    "position": 1,
    "text": "ستاره یکایک همی بشمرد"
  },
  {
    "poem_id": 1455,
    "vorder": 33,
    "position": 0,
    "text": "همان کن که بیدار شاهان کنند"
  },
  {
    "poem_id": 1455,
    "vorder": 34,
    "position": 1,
    "text": "ستاینده و نیک‌خواهان کنند"
  },
  {
    "poem_id": 1455,
    "vorder": 35,
    "position": 0,
    "text": "جز از بندگی پیش یزدان مجوی"
  },
  {
    "poem_id": 1455,
    "vorder": 36,
    "position": 1,
    "text": "مزن دست در نیک و بد جز بدوی"
  },
  {
    "poem_id": 1455,
    "vorder": 37,
    "position": 0,
    "text": "چنین داد پاسخ که از راستی"
  },
  {
    "poem_id": 1455,
    "vorder": 38,
    "position": 1,
    "text": "نیاید به کار اندرون کاستی"
  },
  {
    "poem_id": 1455,
    "vorder": 39,
    "position": 0,
    "text": "همی داد گفتی و بیداد نیست"
  },
  {
    "poem_id": 1455,
    "vorder": 40,
    "position": 1,
    "text": "ز نام تو جان من آزاد نیست"
  },
  {
    "poem_id": 1455,
    "vorder": 41,
    "position": 0,
    "text": "فروماند کاووس و تشویر خورد"
  },
  {
    "poem_id": 1455,
    "vorder": 42,
    "position": 1,
    "text": "ازان نامداران روز نبرد"
  },
  {
    "poem_id": 1455,
    "vorder": 43,
    "position": 0,
    "text": "بسیچید و اندر عماری نشست"
  },
  {
    "poem_id": 1455,
    "vorder": 44,
    "position": 1,
    "text": "پشیمانی و درد بودش بدست"
  },
  {
    "poem_id": 1455,
    "vorder": 45,
    "position": 0,
    "text": "چو آمد بر تخت و گاه بلند"
  },
  {
    "poem_id": 1455,
    "vorder": 46,
    "position": 1,
    "text": "دلش بود زان کار مانده نژند"
  },
  {
    "poem_id": 1455,
    "vorder": 47,
    "position": 0,
    "text": "چهل روز بر پیش یزدان به پای"
  },
  {
    "poem_id": 1455,
    "vorder": 48,
    "position": 1,
    "text": "بپیمود خاک و بپرداخت جای"
  },
  {
    "poem_id": 1455,
    "vorder": 49,
    "position": 0,
    "text": "همی ریخت از دیدگان آب زرد"
  },
  {
    "poem_id": 1455,
    "vorder": 50,
    "position": 1,
    "text": "همی از جهان‌آفرین یاد کرد"
  },
  {
    "poem_id": 1455,
    "vorder": 51,
    "position": 0,
    "text": "ز شرم از در کاخ بیرون نرفت"
  },
  {
    "poem_id": 1455,
    "vorder": 52,
    "position": 1,
    "text": "همی پوست گفتی برو بر به کفت"
  },
  {
    "poem_id": 1455,
    "vorder": 53,
    "position": 0,
    "text": "همی ریخت از دیده پالوده خون"
  },
  {
    "poem_id": 1455,
    "vorder": 54,
    "position": 1,
    "text": "همی خواست آمرزش رهنمون"
  },
  {
    "poem_id": 1455,
    "vorder": 55,
    "position": 0,
    "text": "ز شرم دلیران منش کرد پست"
  },
  {
    "poem_id": 1455,
    "vorder": 56,
    "position": 1,
    "text": "خرام و در بار دادن ببست"
  },
  {
    "poem_id": 1455,
    "vorder": 57,
    "position": 0,
    "text": "پشیمان شد و درد بگزید و رنج"
  },
  {
    "poem_id": 1455,
    "vorder": 58,
    "position": 1,
    "text": "نهاده ببخشید بسیار گنج"
  },
  {
    "poem_id": 1455,
    "vorder": 59,
    "position": 0,
    "text": "همی رخ بمالید بر تیره خاک"
  },
  {
    "poem_id": 1455,
    "vorder": 60,
    "position": 1,
    "text": "نیایش کنان پیش یزدان پاک"
  },
  {
    "poem_id": 1455,
    "vorder": 61,
    "position": 0,
    "text": "چو بگذشت یک چند گریان چنین"
  },
  {
    "poem_id": 1455,
    "vorder": 62,
    "position": 1,
    "text": "ببخشود بر وی جهان‌آفرین"
  },
  {
    "poem_id": 1455,
    "vorder": 63,
    "position": 0,
    "text": "یکی داد نو ساخت اندر جهان"
  },
  {
    "poem_id": 1455,
    "vorder": 64,
    "position": 1,
    "text": "که تابنده شد بر کهان و مهان"
  },
  {
    "poem_id": 1455,
    "vorder": 65,
    "position": 0,
    "text": "جهان گفتی از داد دیبا شدست"
  },
  {
    "poem_id": 1455,
    "vorder": 66,
    "position": 1,
    "text": "همان شاه بر گاه زیبا شدست"
  },
  {
    "poem_id": 1455,
    "vorder": 67,
    "position": 0,
    "text": "ز هر کشوری نامور مهتری"
  },
  {
    "poem_id": 1455,
    "vorder": 68,
    "position": 1,
    "text": "که بر سر نهادی بلند افسری"
  },
  {
    "poem_id": 1455,
    "vorder": 69,
    "position": 0,
    "text": "به درگاه کاووس شاه آمدند"
  },
  {
    "poem_id": 1455,
    "vorder": 70,
    "position": 1,
    "text": "وزان سرکشیدن به راه آمدند"
  },
  {
    "poem_id": 1455,
    "vorder": 71,
    "position": 0,
    "text": "زمانه چنان شد که بود از نخست"
  },
  {
    "poem_id": 1455,
    "vorder": 72,
    "position": 1,
    "text": "به آب وفا روی خسرو بشست"
  },
  {
    "poem_id": 1455,
    "vorder": 73,
    "position": 0,
    "text": "همه مهتران کهتر او شدند"
  },
  {
    "poem_id": 1455,
    "vorder": 74,
    "position": 1,
    "text": "پرستنده و چاکر او شدند"
  },
  {
    "poem_id": 1455,
    "vorder": 75,
    "position": 0,
    "text": "کجا پادشا دادگر بود و بس"
  },
  {
    "poem_id": 1455,
    "vorder": 76,
    "position": 1,
    "text": "نیازش نیاید بفریادرس"
  },
  {
    "poem_id": 1455,
    "vorder": 77,
    "position": 0,
    "text": "بدین داستان گفتم آن کم شنود"
  },
  {
    "poem_id": 1455,
    "vorder": 78,
    "position": 1,
    "text": "کنون رزم رستم بباید سرود"
  }
]