[
  {
    "poem_id": 1405,
    "vorder": 1,
    "position": 0,
    "text": "منوچهر را سال شد بر دو شست"
  },
  {
    "poem_id": 1405,
    "vorder": 2,
    "position": 1,
    "text": "ز گیتی همی بار رفتن ببست"
  },
  {
    "poem_id": 1405,
    "vorder": 3,
    "position": 0,
    "text": "ستاره‌شناسان برِ او شدند"
  },
  {
    "poem_id": 1405,
    "vorder": 4,
    "position": 1,
    "text": "همی ز آسمان داستانها زدند"
  },
  {
    "poem_id": 1405,
    "vorder": 5,
    "position": 0,
    "text": "ندیدند روزش کشیدن دراز"
  },
  {
    "poem_id": 1405,
    "vorder": 6,
    "position": 1,
    "text": "ز گیتی همی گشت بایست باز"
  },
  {
    "poem_id": 1405,
    "vorder": 7,
    "position": 0,
    "text": "بدادند زان روزِ تلخ آگهی"
  },
  {
    "poem_id": 1405,
    "vorder": 8,
    "position": 1,
    "text": "که شد تیره آن تخت شاهنشهی"
  },
  {
    "poem_id": 1405,
    "vorder": 9,
    "position": 0,
    "text": "گَهِ رفتن آمد به دیگر سرای"
  },
  {
    "poem_id": 1405,
    "vorder": 10,
    "position": 1,
    "text": "مگر نزد یزدان بِهْ آیدت جای"
  },
  {
    "poem_id": 1405,
    "vorder": 11,
    "position": 0,
    "text": "نگر تا چه باید کنون ساختن"
  },
  {
    "poem_id": 1405,
    "vorder": 12,
    "position": 1,
    "text": "نباید که مرگ آورد تاختن"
  },
  {
    "poem_id": 1405,
    "vorder": 13,
    "position": 0,
    "text": "سخن چون ز داننده بشنید شاه"
  },
  {
    "poem_id": 1405,
    "vorder": 14,
    "position": 1,
    "text": "به رسم دگرگون بیاراست گاه"
  },
  {
    "poem_id": 1405,
    "vorder": 15,
    "position": 0,
    "text": "همه موبدان و ردان را بخواند"
  },
  {
    "poem_id": 1405,
    "vorder": 16,
    "position": 1,
    "text": "همه راز دل پیش ایشان براند"
  },
  {
    "poem_id": 1405,
    "vorder": 17,
    "position": 0,
    "text": "بفرمود تا نوذر آمدش پیش"
  },
  {
    "poem_id": 1405,
    "vorder": 18,
    "position": 1,
    "text": "ورا پندها داد ز اندازه بیش"
  },
  {
    "poem_id": 1405,
    "vorder": 19,
    "position": 0,
    "text": "که این تخت شاهی فسونست و باد"
  },
  {
    "poem_id": 1405,
    "vorder": 20,
    "position": 1,
    "text": "برو جاودان دل نباید نهاد"
  },
  {
    "poem_id": 1405,
    "vorder": 21,
    "position": 0,
    "text": "مرا بر صد و بیست شد سالیان"
  },
  {
    "poem_id": 1405,
    "vorder": 22,
    "position": 1,
    "text": "به رنج و به سختی ببستم میان"
  },
  {
    "poem_id": 1405,
    "vorder": 23,
    "position": 0,
    "text": "بسی شادی و کام دل راندم"
  },
  {
    "poem_id": 1405,
    "vorder": 24,
    "position": 1,
    "text": "به رزم اندرون دشمنان ماندم"
  },
  {
    "poem_id": 1405,
    "vorder": 25,
    "position": 0,
    "text": "به فر فریدون ببستم میان"
  },
  {
    "poem_id": 1405,
    "vorder": 26,
    "position": 1,
    "text": "به پندش مرا سود شد هر زیان"
  },
  {
    "poem_id": 1405,
    "vorder": 27,
    "position": 0,
    "text": "بجستم ز سلم و ز تور سترگ"
  },
  {
    "poem_id": 1405,
    "vorder": 28,
    "position": 1,
    "text": "همان کین ایرج نیای بزرگ"
  },
  {
    "poem_id": 1405,
    "vorder": 29,
    "position": 0,
    "text": "جهان ویژه کردم ز پتیاره‌ها"
  },
  {
    "poem_id": 1405,
    "vorder": 30,
    "position": 1,
    "text": "بسی شهر کردم بسی باره‌ها"
  },
  {
    "poem_id": 1405,
    "vorder": 31,
    "position": 0,
    "text": "چنانم که گویی ندیدم جهان"
  },
  {
    "poem_id": 1405,
    "vorder": 32,
    "position": 1,
    "text": "شمار گذشته شد اندر نهان"
  },
  {
    "poem_id": 1405,
    "vorder": 33,
    "position": 0,
    "text": "نیرزد همی زندگانیش مرگ"
  },
  {
    "poem_id": 1405,
    "vorder": 34,
    "position": 1,
    "text": "درختی که زهر آورد بار و برگ"
  },
  {
    "poem_id": 1405,
    "vorder": 35,
    "position": 0,
    "text": "ازان پس که بردم بسی درد و رنج"
  },
  {
    "poem_id": 1405,
    "vorder": 36,
    "position": 1,
    "text": "سپردم ترا تخت شاهی و گنج"
  },
  {
    "poem_id": 1405,
    "vorder": 37,
    "position": 0,
    "text": "چنان چون فریدون مرا داده بود"
  },
  {
    "poem_id": 1405,
    "vorder": 38,
    "position": 1,
    "text": "ترا دادم این تاج شاه آزمود"
  },
  {
    "poem_id": 1405,
    "vorder": 39,
    "position": 0,
    "text": "چنان دان که خوردی و بر تو گذشت"
  },
  {
    "poem_id": 1405,
    "vorder": 40,
    "position": 1,
    "text": "به خوشتر زمان بازم بایدت گشت"
  },
  {
    "poem_id": 1405,
    "vorder": 41,
    "position": 0,
    "text": "نشانی که مانَد همی از تو باز"
  },
  {
    "poem_id": 1405,
    "vorder": 42,
    "position": 1,
    "text": "برآید برو روزگار دراز"
  },
  {
    "poem_id": 1405,
    "vorder": 43,
    "position": 0,
    "text": "نباید که باشد جز از آفرین"
  },
  {
    "poem_id": 1405,
    "vorder": 44,
    "position": 1,
    "text": "که پاکی نژاد آورد پاک دین"
  },
  {
    "poem_id": 1405,
    "vorder": 45,
    "position": 0,
    "text": "نگر تا نتابی ز دین خدای"
  },
  {
    "poem_id": 1405,
    "vorder": 46,
    "position": 1,
    "text": "که دین خدای آورد پاک رای"
  },
  {
    "poem_id": 1405,
    "vorder": 47,
    "position": 0,
    "text": "کنون نو شود در جهان داوری"
  },
  {
    "poem_id": 1405,
    "vorder": 48,
    "position": 1,
    "text": "چو موسی بیاید به پیغمبری"
  },
  {
    "poem_id": 1405,
    "vorder": 49,
    "position": 0,
    "text": "پدید آید آنگه به خاور زمین"
  },
  {
    "poem_id": 1405,
    "vorder": 50,
    "position": 1,
    "text": "نگر تا نتابی بر او بر به کین"
  },
  {
    "poem_id": 1405,
    "vorder": 51,
    "position": 0,
    "text": "بدو بگرو آن دین یزدان بود"
  },
  {
    "poem_id": 1405,
    "vorder": 52,
    "position": 1,
    "text": "نگه کن ز سر تا چه پیمان بود"
  },
  {
    "poem_id": 1405,
    "vorder": 53,
    "position": 0,
    "text": "تو مگذار هرگز ره ایزدی"
  },
  {
    "poem_id": 1405,
    "vorder": 54,
    "position": 1,
    "text": "که نیکی ازویست و هم زو بدی"
  },
  {
    "poem_id": 1405,
    "vorder": 55,
    "position": 0,
    "text": "ازان پس بیاید ز ترکان سپاه"
  },
  {
    "poem_id": 1405,
    "vorder": 56,
    "position": 1,
    "text": "نهند از بر تخت ایران کلاه"
  },
  {
    "poem_id": 1405,
    "vorder": 57,
    "position": 0,
    "text": "ترا کارهای درشتست پیش"
  },
  {
    "poem_id": 1405,
    "vorder": 58,
    "position": 1,
    "text": "گهی گرگ باید بدن گاه میش"
  },
  {
    "poem_id": 1405,
    "vorder": 59,
    "position": 0,
    "text": "گزند تو آید ز پور پشنگ"
  },
  {
    "poem_id": 1405,
    "vorder": 60,
    "position": 1,
    "text": "ز توران شود کارها بر تو ننگ"
  },
  {
    "poem_id": 1405,
    "vorder": 61,
    "position": 0,
    "text": "بجوی ای پسر چون رسد داوری"
  },
  {
    "poem_id": 1405,
    "vorder": 62,
    "position": 1,
    "text": "ز سام و ز زال آنگهی یاوری"
  },
  {
    "poem_id": 1405,
    "vorder": 63,
    "position": 0,
    "text": "وزین نو درختی که از پشت زال"
  },
  {
    "poem_id": 1405,
    "vorder": 64,
    "position": 1,
    "text": "برآمد کنون برکشد شاخ و یال"
  },
  {
    "poem_id": 1405,
    "vorder": 65,
    "position": 0,
    "text": "ازو شهر توران شود بی‌هنر"
  },
  {
    "poem_id": 1405,
    "vorder": 66,
    "position": 1,
    "text": "به کین تو آید همان کینه‌ور"
  },
  {
    "poem_id": 1405,
    "vorder": 67,
    "position": 0,
    "text": "بگفت و فرود آمد آبش بروی"
  },
  {
    "poem_id": 1405,
    "vorder": 68,
    "position": 1,
    "text": "همی زار بگریست نوذر بروی"
  },
  {
    "poem_id": 1405,
    "vorder": 69,
    "position": 0,
    "text": "«بی‌آنکش بُدی هیچ بیماریی،"
  },
  {
    "poem_id": 1405,
    "vorder": 70,
    "position": 1,
    "text": "نه از دردها هیچ آزاریی؛"
  },
  {
    "poem_id": 1405,
    "vorder": 71,
    "position": 0,
    "text": "دو چشم کیانی به هم بر نهاد،"
  },
  {
    "poem_id": 1405,
    "vorder": 72,
    "position": 1,
    "text": "بپژمرد و برزد یکی سرد باد»"
  },
  {
    "poem_id": 1405,
    "vorder": 73,
    "position": 0,
    "text": "شد آن نامور پرهنر شهریار"
  },
  {
    "poem_id": 1405,
    "vorder": 74,
    "position": 1,
    "text": "به گیتی سخن ماند زو یادگار"
  }
]