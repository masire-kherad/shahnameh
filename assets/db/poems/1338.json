[
  {
    "poem_id": 1338,
    "vorder": 1,
    "position": 0,
    "text": "یکی روز شاه جهان سوی کوه"
  },
  {
    "poem_id": 1338,
    "vorder": 2,
    "position": 1,
    "text": "گذر کرد با چند کس هم‌گروه"
  },
  {
    "poem_id": 1338,
    "vorder": 3,
    "position": 0,
    "text": "پدید آمد از دور چیزی دراز"
  },
  {
    "poem_id": 1338,
    "vorder": 4,
    "position": 1,
    "text": "سیه رنگ و تیره تن و تیز تاز"
  },
  {
    "poem_id": 1338,
    "vorder": 5,
    "position": 0,
    "text": "دو چشم از بر سر چو دو چشمه خون"
  },
  {
    "poem_id": 1338,
    "vorder": 6,
    "position": 1,
    "text": "ز دود دهانش جهان تیره‌گون"
  },
  {
    "poem_id": 1338,
    "vorder": 7,
    "position": 0,
    "text": "نگه کرد هوشنگ باهوش و سنگ"
  },
  {
    "poem_id": 1338,
    "vorder": 8,
    "position": 1,
    "text": "گرفتش یکی سنگ و شد تیز چنگ"
  },
  {
    "poem_id": 1338,
    "vorder": 9,
    "position": 0,
    "text": "به زور کیانی رهانید دست"
  },
  {
    "poem_id": 1338,
    "vorder": 10,
    "position": 1,
    "text": "جهان‌سوز مار از جهان‌جوی جست"
  },
  {
    "poem_id": 1338,
    "vorder": 11,
    "position": 0,
    "text": "بر آمد به سنگ گران سنگ خرد"
  },
  {
    "poem_id": 1338,
    "vorder": 12,
    "position": 1,
    "text": "همان و همین سنگ بشکست گرد"
  },
  {
    "poem_id": 1338,
    "vorder": 13,
    "position": 0,
    "text": "فروغی پدید آمد از هر دو سنگ"
  },
  {
    "poem_id": 1338,
    "vorder": 14,
    "position": 1,
    "text": "دل سنگ گشت از فروغ آذرنگ"
  },
  {
    "poem_id": 1338,
    "vorder": 15,
    "position": 0,
    "text": "نشد مار کشته ولیکن ز راز"
  },
  {
    "poem_id": 1338,
    "vorder": 16,
    "position": 1,
    "text": "از این طبع سنگ آتش آمد فراز"
  },
  {
    "poem_id": 1338,
    "vorder": 17,
    "position": 0,
    "text": "جهاندار پیش جهان آفرین"
  },
  {
    "poem_id": 1338,
    "vorder": 18,
    "position": 1,
    "text": "نیایش همی کرد و خواند آفرین"
  },
  {
    "poem_id": 1338,
    "vorder": 19,
    "position": 0,
    "text": "که او را فروغی چنین هدیه داد"
  },
  {
    "poem_id": 1338,
    "vorder": 20,
    "position": 1,
    "text": "همین آتش آنگاه قبله نهاد"
  },
  {
    "poem_id": 1338,
    "vorder": 21,
    "position": 0,
    "text": "بگفتا فروغی است این ایزدی"
  },
  {
    "poem_id": 1338,
    "vorder": 22,
    "position": 1,
    "text": "پرستید باید اگر بخردی"
  },
  {
    "poem_id": 1338,
    "vorder": 23,
    "position": 0,
    "text": "شب آمد بر افروخت آتش چو کوه"
  },
  {
    "poem_id": 1338,
    "vorder": 24,
    "position": 1,
    "text": "همان شاه در گرد او با گروه"
  },
  {
    "poem_id": 1338,
    "vorder": 25,
    "position": 0,
    "text": "یکی جشن کرد آن شب و باده خْوَرد"
  },
  {
    "poem_id": 1338,
    "vorder": 26,
    "position": 1,
    "text": "سده نام آن جشن فرخنده کرد"
  },
  {
    "poem_id": 1338,
    "vorder": 27,
    "position": 0,
    "text": "ز هوشنگ ماند این سده یادگار"
  },
  {
    "poem_id": 1338,
    "vorder": 28,
    "position": 1,
    "text": "بسی باد چون او دگر شهریار"
  },
  {
    "poem_id": 1338,
    "vorder": 29,
    "position": 0,
    "text": "کز آباد کردن جهان شاد کرد"
  },
  {
    "poem_id": 1338,
    "vorder": 30,
    "position": 1,
    "text": "جهانی به نیکی از او یاد کرد"
  }
]