[
  {
    "poem_id": 88063,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاه شد شهریار جهان"
  },
  {
    "poem_id": 88063,
    "vorder": 2,
    "position": 1,
    "text": "ز گفتار بیدار کارآگهان"
  },
  {
    "poem_id": 88063,
    "vorder": 3,
    "position": 0,
    "text": "ز ترکان وز کار افراسیاب"
  },
  {
    "poem_id": 88063,
    "vorder": 4,
    "position": 1,
    "text": "که لشکرگه آورد ز این روی آب"
  },
  {
    "poem_id": 88063,
    "vorder": 5,
    "position": 0,
    "text": "سپاهی ز جیحون بدین سو کشید"
  },
  {
    "poem_id": 88063,
    "vorder": 6,
    "position": 1,
    "text": "که شد ریگ و سنگ از جهان ناپدید"
  },
  {
    "poem_id": 88063,
    "vorder": 7,
    "position": 0,
    "text": "چو بشنید خسرو یلان را بخواند"
  },
  {
    "poem_id": 88063,
    "vorder": 8,
    "position": 1,
    "text": "همه گفتنی پیش ایشان براند"
  },
  {
    "poem_id": 88063,
    "vorder": 9,
    "position": 0,
    "text": "سپاهی ز جنگ آوران برگزید"
  },
  {
    "poem_id": 88063,
    "vorder": 10,
    "position": 1,
    "text": "بزرگان ایران چنانچون سزید"
  },
  {
    "poem_id": 88063,
    "vorder": 11,
    "position": 0,
    "text": "چشیده بسی از جهان شور و تلخ"
  },
  {
    "poem_id": 88063,
    "vorder": 12,
    "position": 1,
    "text": "به یاری گستهم نوذر به بلخ"
  },
  {
    "poem_id": 88063,
    "vorder": 13,
    "position": 0,
    "text": "به اشکش بفرمود تا سوی زم"
  },
  {
    "poem_id": 88063,
    "vorder": 14,
    "position": 1,
    "text": "برد لشکر و پیل و گنج درم"
  },
  {
    "poem_id": 88063,
    "vorder": 15,
    "position": 0,
    "text": "بدان تا پس اندر نیاید سپاه"
  },
  {
    "poem_id": 88063,
    "vorder": 16,
    "position": 1,
    "text": "کند رای شیران ایران تباه"
  },
  {
    "poem_id": 88063,
    "vorder": 17,
    "position": 0,
    "text": "از آن پس یلان را همه برنشاند"
  },
  {
    "poem_id": 88063,
    "vorder": 18,
    "position": 1,
    "text": "بزد کوس رویین و لشکر براند"
  },
  {
    "poem_id": 88063,
    "vorder": 19,
    "position": 0,
    "text": "همی رفت با رای و هوش و درنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 20,
    "position": 1,
    "text": "که تیزی پشیمانی آرد به جنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 21,
    "position": 0,
    "text": "سپهدار چون در بیابان رسید"
  },
  {
    "poem_id": 88063,
    "vorder": 22,
    "position": 1,
    "text": "گرازیدن و ساز و لشکر بدید"
  },
  {
    "poem_id": 88063,
    "vorder": 23,
    "position": 0,
    "text": "سپه را گذر سوی خورازم بود"
  },
  {
    "poem_id": 88063,
    "vorder": 24,
    "position": 1,
    "text": "همه رنگ و دشت از در رزم بود"
  },
  {
    "poem_id": 88063,
    "vorder": 25,
    "position": 0,
    "text": "به چپ بر دهستان و بر راست آب"
  },
  {
    "poem_id": 88063,
    "vorder": 26,
    "position": 1,
    "text": "میان ریگ و پیش اندر افراسیاب"
  },
  {
    "poem_id": 88063,
    "vorder": 27,
    "position": 0,
    "text": "چو خورشید سر زد ز برج بره"
  },
  {
    "poem_id": 88063,
    "vorder": 28,
    "position": 1,
    "text": "بیاراست روی زمین یکسره"
  },
  {
    "poem_id": 88063,
    "vorder": 29,
    "position": 0,
    "text": "سپهدار ترکان سپه را بدید"
  },
  {
    "poem_id": 88063,
    "vorder": 30,
    "position": 1,
    "text": "بزد نای رویین و صف برکشید"
  },
  {
    "poem_id": 88063,
    "vorder": 31,
    "position": 0,
    "text": "جهان شد پر آوای بوق و سپاه"
  },
  {
    "poem_id": 88063,
    "vorder": 32,
    "position": 1,
    "text": "همه برنهادند ز آهن کلاه"
  },
  {
    "poem_id": 88063,
    "vorder": 33,
    "position": 0,
    "text": "چو خسرو بدید آن سپاه نیا"
  },
  {
    "poem_id": 88063,
    "vorder": 34,
    "position": 1,
    "text": "دل پادشا شد پر از کیمیا"
  },
  {
    "poem_id": 88063,
    "vorder": 35,
    "position": 0,
    "text": "خود و رستم و طوس و گودرز و گیو"
  },
  {
    "poem_id": 88063,
    "vorder": 36,
    "position": 1,
    "text": "ز لشکر بسی نامبردار نیو"
  },
  {
    "poem_id": 88063,
    "vorder": 37,
    "position": 0,
    "text": "همی گشت بر گرد آن رزمگاه"
  },
  {
    "poem_id": 88063,
    "vorder": 38,
    "position": 1,
    "text": "بیابان نگه گرد و بی‌راه و راه"
  },
  {
    "poem_id": 88063,
    "vorder": 39,
    "position": 0,
    "text": "که لشکر فزون بود زان کو شمرد"
  },
  {
    "poem_id": 88063,
    "vorder": 40,
    "position": 1,
    "text": "همان ژنده پیلان و مردان گرد"
  },
  {
    "poem_id": 88063,
    "vorder": 41,
    "position": 0,
    "text": "به گرد سپه بر یکی کنده کرد"
  },
  {
    "poem_id": 88063,
    "vorder": 42,
    "position": 1,
    "text": "طلایه به هر سو پراگنده کرد"
  },
  {
    "poem_id": 88063,
    "vorder": 43,
    "position": 0,
    "text": "شب آمد به کنده در افگند آب"
  },
  {
    "poem_id": 88063,
    "vorder": 44,
    "position": 1,
    "text": "بدان سو که بد روی افراسیاب"
  },
  {
    "poem_id": 88063,
    "vorder": 45,
    "position": 0,
    "text": "دو لشکر چنین هم دو روز و دو شب"
  },
  {
    "poem_id": 88063,
    "vorder": 46,
    "position": 1,
    "text": "از ایشان یکی را نجنبید لب"
  },
  {
    "poem_id": 88063,
    "vorder": 47,
    "position": 0,
    "text": "تو گفتی که روی زمین آهن است"
  },
  {
    "poem_id": 88063,
    "vorder": 48,
    "position": 1,
    "text": "ز نیزه هوا نیز در جوشن است"
  },
  {
    "poem_id": 88063,
    "vorder": 49,
    "position": 0,
    "text": "از این روی و زان روی بر پشت زین"
  },
  {
    "poem_id": 88063,
    "vorder": 50,
    "position": 1,
    "text": "پیاده به پیش اندرون همچنین"
  },
  {
    "poem_id": 88063,
    "vorder": 51,
    "position": 0,
    "text": "تو گفتی جهان کوه آهن شدست"
  },
  {
    "poem_id": 88063,
    "vorder": 52,
    "position": 1,
    "text": "همان پوشش چرخ جوشن شدست"
  },
  {
    "poem_id": 88063,
    "vorder": 53,
    "position": 0,
    "text": "ستاره شمر پیش دو شهریار"
  },
  {
    "poem_id": 88063,
    "vorder": 54,
    "position": 1,
    "text": "پر اندیشه و زیجها بر کنار"
  },
  {
    "poem_id": 88063,
    "vorder": 55,
    "position": 0,
    "text": "همی باز جستند راز سپهر"
  },
  {
    "poem_id": 88063,
    "vorder": 56,
    "position": 1,
    "text": "به صلاب تا بر که گردد به مهر"
  },
  {
    "poem_id": 88063,
    "vorder": 57,
    "position": 0,
    "text": "سپهر اندر آن جنگ نظاره بود"
  },
  {
    "poem_id": 88063,
    "vorder": 58,
    "position": 1,
    "text": "ستاره شمر سخت بیچاره بود"
  },
  {
    "poem_id": 88063,
    "vorder": 59,
    "position": 0,
    "text": "به روز چهارم چو شد کار تنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 60,
    "position": 1,
    "text": "به پیش پدر شد دلاور پشنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 61,
    "position": 0,
    "text": "بدو گفت کای کدخدای جهان"
  },
  {
    "poem_id": 88063,
    "vorder": 62,
    "position": 1,
    "text": "سرافراز بر کهتران و مهان"
  },
  {
    "poem_id": 88063,
    "vorder": 63,
    "position": 0,
    "text": "به فر تو زیر فلک شاه نیست"
  },
  {
    "poem_id": 88063,
    "vorder": 64,
    "position": 1,
    "text": "ترا ماه و خورشید بد خواه نیست"
  },
  {
    "poem_id": 88063,
    "vorder": 65,
    "position": 0,
    "text": "شود کوه آهن چو دریای آب"
  },
  {
    "poem_id": 88063,
    "vorder": 66,
    "position": 1,
    "text": "اگر بشنود نام افرسیاب"
  },
  {
    "poem_id": 88063,
    "vorder": 67,
    "position": 0,
    "text": "زمین بر نتابد سپاه ترا"
  },
  {
    "poem_id": 88063,
    "vorder": 68,
    "position": 1,
    "text": "نه خورشید تابان کلاه ترا"
  },
  {
    "poem_id": 88063,
    "vorder": 69,
    "position": 0,
    "text": "نیاید ز شاهان کسی پیش تو"
  },
  {
    "poem_id": 88063,
    "vorder": 70,
    "position": 1,
    "text": "جز این بی‌پدر بد گوهر خویش تو"
  },
  {
    "poem_id": 88063,
    "vorder": 71,
    "position": 0,
    "text": "سیاووش را چون پسر داشتی"
  },
  {
    "poem_id": 88063,
    "vorder": 72,
    "position": 1,
    "text": "بر او رنج و مهر پدر داشتی"
  },
  {
    "poem_id": 88063,
    "vorder": 73,
    "position": 0,
    "text": "یکی باد ناخوش ز روی هوا"
  },
  {
    "poem_id": 88063,
    "vorder": 74,
    "position": 1,
    "text": "بر او برگذشتی نبودی روا"
  },
  {
    "poem_id": 88063,
    "vorder": 75,
    "position": 0,
    "text": "از او سیر گشتی چو کردی درست"
  },
  {
    "poem_id": 88063,
    "vorder": 76,
    "position": 1,
    "text": "که او تاج و تخت و سپاه تو جست"
  },
  {
    "poem_id": 88063,
    "vorder": 77,
    "position": 0,
    "text": "گر او را نکشتی جهاندار شاه"
  },
  {
    "poem_id": 88063,
    "vorder": 78,
    "position": 1,
    "text": "بدو باز گشتی نگین و کلاه"
  },
  {
    "poem_id": 88063,
    "vorder": 79,
    "position": 0,
    "text": "کنون اینک آمد به پیشت به جنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 80,
    "position": 1,
    "text": "نباید به گیتی فراوان درنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 81,
    "position": 0,
    "text": "هر آن کس که نیکی فرامش کند"
  },
  {
    "poem_id": 88063,
    "vorder": 82,
    "position": 1,
    "text": "همی رای جان سیاوش کند"
  },
  {
    "poem_id": 88063,
    "vorder": 83,
    "position": 0,
    "text": "بپروردی این شوم ناپاک را"
  },
  {
    "poem_id": 88063,
    "vorder": 84,
    "position": 1,
    "text": "پدروار نسپردیش خاک را"
  },
  {
    "poem_id": 88063,
    "vorder": 85,
    "position": 0,
    "text": "همی داشتی تا بر آورد پر"
  },
  {
    "poem_id": 88063,
    "vorder": 86,
    "position": 1,
    "text": "شد از مهر شاه از در تاج زر"
  },
  {
    "poem_id": 88063,
    "vorder": 87,
    "position": 0,
    "text": "ز توران چو مرغی به ایران پرید"
  },
  {
    "poem_id": 88063,
    "vorder": 88,
    "position": 1,
    "text": "تو گفتی که هرگز نیا را ندید"
  },
  {
    "poem_id": 88063,
    "vorder": 89,
    "position": 0,
    "text": "ز خوبی نگه کن که پیران چه کرد"
  },
  {
    "poem_id": 88063,
    "vorder": 90,
    "position": 1,
    "text": "بدان بی‌وفا ناسزاوار مرد"
  },
  {
    "poem_id": 88063,
    "vorder": 91,
    "position": 0,
    "text": "همه مهر پیران فراموش کرد"
  },
  {
    "poem_id": 88063,
    "vorder": 92,
    "position": 1,
    "text": "پر از کینه سر دل پر از جوش کرد"
  },
  {
    "poem_id": 88063,
    "vorder": 93,
    "position": 0,
    "text": "همی بود خامش چو آمد به مشت"
  },
  {
    "poem_id": 88063,
    "vorder": 94,
    "position": 1,
    "text": "چنان مهربان پهلوان را بکشت"
  },
  {
    "poem_id": 88063,
    "vorder": 95,
    "position": 0,
    "text": "از ایران کنون با سپاهی به جنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 96,
    "position": 1,
    "text": "بیامد به پیش نیا تیزچنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 97,
    "position": 0,
    "text": "نه دینار خواهد نه تخت و کلاه"
  },
  {
    "poem_id": 88063,
    "vorder": 98,
    "position": 1,
    "text": "نه اسب و نه شمشیر و گنج و سپاه"
  },
  {
    "poem_id": 88063,
    "vorder": 99,
    "position": 0,
    "text": "ز خویشان جز از جان نخواهد همی"
  },
  {
    "poem_id": 88063,
    "vorder": 100,
    "position": 1,
    "text": "سخن را از این در نکاهد همی"
  },
  {
    "poem_id": 88063,
    "vorder": 101,
    "position": 0,
    "text": "پدر شاه و فرزانه‌تر پادشاست"
  },
  {
    "poem_id": 88063,
    "vorder": 102,
    "position": 1,
    "text": "بدین راست گفتار من بر گواست"
  },
  {
    "poem_id": 88063,
    "vorder": 103,
    "position": 0,
    "text": "از ایرانیان نیست چندین سخن"
  },
  {
    "poem_id": 88063,
    "vorder": 104,
    "position": 1,
    "text": "سپه را چنین دل شکسته مکن"
  },
  {
    "poem_id": 88063,
    "vorder": 105,
    "position": 0,
    "text": "بدیشان چه باید ستاره شمر"
  },
  {
    "poem_id": 88063,
    "vorder": 106,
    "position": 1,
    "text": "به شمشیر جویند مردان هنر"
  },
  {
    "poem_id": 88063,
    "vorder": 107,
    "position": 0,
    "text": "سواران که در میمنه با منند"
  },
  {
    "poem_id": 88063,
    "vorder": 108,
    "position": 1,
    "text": "همه جنگ را یکدل و یکتنند"
  },
  {
    "poem_id": 88063,
    "vorder": 109,
    "position": 0,
    "text": "چو دستور باشد مرا پادشا"
  },
  {
    "poem_id": 88063,
    "vorder": 110,
    "position": 1,
    "text": "از ایشان نمانم یکی پارسا"
  },
  {
    "poem_id": 88063,
    "vorder": 111,
    "position": 0,
    "text": "بدوزم سر و ترگ ایشان به تیر"
  },
  {
    "poem_id": 88063,
    "vorder": 112,
    "position": 1,
    "text": "نه اندیشم از کنده و آبگیر"
  },
  {
    "poem_id": 88063,
    "vorder": 113,
    "position": 0,
    "text": "چو بشنید افراسیاب این سخن"
  },
  {
    "poem_id": 88063,
    "vorder": 114,
    "position": 1,
    "text": "بدو گفت مشتاب و تندی مکن"
  },
  {
    "poem_id": 88063,
    "vorder": 115,
    "position": 0,
    "text": "سخن هرچه گفتی همه راست بود"
  },
  {
    "poem_id": 88063,
    "vorder": 116,
    "position": 1,
    "text": "جز از راستی را نباید شنود"
  },
  {
    "poem_id": 88063,
    "vorder": 117,
    "position": 0,
    "text": "ولیکن تو دانی که پیران گرد"
  },
  {
    "poem_id": 88063,
    "vorder": 118,
    "position": 1,
    "text": "به گیتی همه راه نیکی سپرد"
  },
  {
    "poem_id": 88063,
    "vorder": 119,
    "position": 0,
    "text": "نبد در دلش کژی و کاستی"
  },
  {
    "poem_id": 88063,
    "vorder": 120,
    "position": 1,
    "text": "نجستی به جز خوبی و راستی"
  },
  {
    "poem_id": 88063,
    "vorder": 121,
    "position": 0,
    "text": "همان پیل بد روز جنگ او به زور"
  },
  {
    "poem_id": 88063,
    "vorder": 122,
    "position": 1,
    "text": "چو دریا دل و رخ چو تابنده هور"
  },
  {
    "poem_id": 88063,
    "vorder": 123,
    "position": 0,
    "text": "برادرش هومان پلنگ نبرد"
  },
  {
    "poem_id": 88063,
    "vorder": 124,
    "position": 1,
    "text": "چو لهاک جنگی و فرشیدورد"
  },
  {
    "poem_id": 88063,
    "vorder": 125,
    "position": 0,
    "text": "ز ترکان سواران کین صدهزار"
  },
  {
    "poem_id": 88063,
    "vorder": 126,
    "position": 1,
    "text": "همه نامجوی از در کارزار"
  },
  {
    "poem_id": 88063,
    "vorder": 127,
    "position": 0,
    "text": "برفتند از ایدر پر از جنگ و جوش"
  },
  {
    "poem_id": 88063,
    "vorder": 128,
    "position": 1,
    "text": "من ایدر نوان با غم و با خروش"
  },
  {
    "poem_id": 88063,
    "vorder": 129,
    "position": 0,
    "text": "از آن کو بر این دشت کین کشته شد"
  },
  {
    "poem_id": 88063,
    "vorder": 130,
    "position": 1,
    "text": "زمین زیر او چون گل آغشته شد"
  },
  {
    "poem_id": 88063,
    "vorder": 131,
    "position": 0,
    "text": "همه مرز توران شکسته دلند"
  },
  {
    "poem_id": 88063,
    "vorder": 132,
    "position": 1,
    "text": "ز تیمار دل را همی بگسلند"
  },
  {
    "poem_id": 88063,
    "vorder": 133,
    "position": 0,
    "text": "نبینند جز مرگ پیران به خواب"
  },
  {
    "poem_id": 88063,
    "vorder": 134,
    "position": 1,
    "text": "نخواند کسی نام افراسیاب"
  },
  {
    "poem_id": 88063,
    "vorder": 135,
    "position": 0,
    "text": "بباشیم تا نامداران ما"
  },
  {
    "poem_id": 88063,
    "vorder": 136,
    "position": 1,
    "text": "مهان و ز لشکر سواران ما"
  },
  {
    "poem_id": 88063,
    "vorder": 137,
    "position": 0,
    "text": "ببینند ایرانیان را به چشم"
  },
  {
    "poem_id": 88063,
    "vorder": 138,
    "position": 1,
    "text": "ز دل کم شود سوگ با درد و خشم"
  },
  {
    "poem_id": 88063,
    "vorder": 139,
    "position": 0,
    "text": "هم ایرانیان نیز چندین سپاه"
  },
  {
    "poem_id": 88063,
    "vorder": 140,
    "position": 1,
    "text": "ببینند آیین تخت و کلاه"
  },
  {
    "poem_id": 88063,
    "vorder": 141,
    "position": 0,
    "text": "دو لشکر بر این گونه پر درد و خشم"
  },
  {
    "poem_id": 88063,
    "vorder": 142,
    "position": 1,
    "text": "ستاره به ما دارد از چرخ چشم"
  },
  {
    "poem_id": 88063,
    "vorder": 143,
    "position": 0,
    "text": "به انبوه جستن نه نیکوست جنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 144,
    "position": 1,
    "text": "شکستی بود باد ماند به چنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 145,
    "position": 0,
    "text": "مبارز پراگنده بیرون کنیم"
  },
  {
    "poem_id": 88063,
    "vorder": 146,
    "position": 1,
    "text": "از ایشان بیابان پر از خون کنیم"
  },
  {
    "poem_id": 88063,
    "vorder": 147,
    "position": 0,
    "text": "چنین داد پاسخ که ای شهریار"
  },
  {
    "poem_id": 88063,
    "vorder": 148,
    "position": 1,
    "text": "چو ز این گونه جویی همی کارزار"
  },
  {
    "poem_id": 88063,
    "vorder": 149,
    "position": 0,
    "text": "نخستین ز لشکر مبارز منم"
  },
  {
    "poem_id": 88063,
    "vorder": 150,
    "position": 1,
    "text": "که بر شیر و بر پیل اسب افگنم"
  },
  {
    "poem_id": 88063,
    "vorder": 151,
    "position": 0,
    "text": "کسی را ندانم که روز نبرد"
  },
  {
    "poem_id": 88063,
    "vorder": 152,
    "position": 1,
    "text": "فشاند بر اسب من از دور گرد"
  },
  {
    "poem_id": 88063,
    "vorder": 153,
    "position": 0,
    "text": "مرا آرزو جنگ کیخسروست"
  },
  {
    "poem_id": 88063,
    "vorder": 154,
    "position": 1,
    "text": "که او در جهان شهریار نوست"
  },
  {
    "poem_id": 88063,
    "vorder": 155,
    "position": 0,
    "text": "اگر جوید او بی گمان جنگ من"
  },
  {
    "poem_id": 88063,
    "vorder": 156,
    "position": 1,
    "text": "رهایی نیابد ز چنگال من"
  },
  {
    "poem_id": 88063,
    "vorder": 157,
    "position": 0,
    "text": "دل و پشت ایشان شکسته شود"
  },
  {
    "poem_id": 88063,
    "vorder": 158,
    "position": 1,
    "text": "بر آن انجمن کار بسته شود"
  },
  {
    "poem_id": 88063,
    "vorder": 159,
    "position": 0,
    "text": "و گر دیگری پیشم آید به جنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 160,
    "position": 1,
    "text": "به خاک اندر آرم سرش بی‌درنگ"
  },
  {
    "poem_id": 88063,
    "vorder": 161,
    "position": 0,
    "text": "بدو گفت کای کار نادیده مرد"
  },
  {
    "poem_id": 88063,
    "vorder": 162,
    "position": 1,
    "text": "شهنشاه کی جوید از تو نبرد"
  },
  {
    "poem_id": 88063,
    "vorder": 163,
    "position": 0,
    "text": "اگر جویدی هم نبردش منم"
  },
  {
    "poem_id": 88063,
    "vorder": 164,
    "position": 1,
    "text": "تن و نام او زیر پای افگنم"
  },
  {
    "poem_id": 88063,
    "vorder": 165,
    "position": 0,
    "text": "گر او با من آید به آوردگاه"
  },
  {
    "poem_id": 88063,
    "vorder": 166,
    "position": 1,
    "text": "برآساید از جنگ هر دو سپاه"
  },
  {
    "poem_id": 88063,
    "vorder": 167,
    "position": 0,
    "text": "بدو شیده گفت ای جهاندیده مرد"
  },
  {
    "poem_id": 88063,
    "vorder": 168,
    "position": 1,
    "text": "چشیده ز گیتی بسی گرم و سرد"
  },
  {
    "poem_id": 88063,
    "vorder": 169,
    "position": 0,
    "text": "پسر پنج زنده‌ست پیشت به پای"
  },
  {
    "poem_id": 88063,
    "vorder": 170,
    "position": 1,
    "text": "نمانیم تا تو کنی رزم رای"
  },
  {
    "poem_id": 88063,
    "vorder": 171,
    "position": 0,
    "text": "نه لشکر پسندد نه ایزد پرست"
  },
  {
    "poem_id": 88063,
    "vorder": 172,
    "position": 1,
    "text": "که تو جنگ او را کنی پیشدست"
  }
]