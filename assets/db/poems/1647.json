[
  {
    "poem_id": 1647,
    "vorder": 1,
    "position": 0,
    "text": "چو نامه بر کید هندی رسید"
  },
  {
    "poem_id": 1647,
    "vorder": 2,
    "position": 1,
    "text": "فرستادهٔ پادشا را بدید"
  },
  {
    "poem_id": 1647,
    "vorder": 3,
    "position": 0,
    "text": "فراوانش بستود و بنواختش"
  },
  {
    "poem_id": 1647,
    "vorder": 4,
    "position": 1,
    "text": "به نیکی بر خویش بنشاختش"
  },
  {
    "poem_id": 1647,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت شادم ز فرمان اوی"
  },
  {
    "poem_id": 1647,
    "vorder": 6,
    "position": 1,
    "text": "زمانی نگردم ز پیمان اوی"
  },
  {
    "poem_id": 1647,
    "vorder": 7,
    "position": 0,
    "text": "ولیکن برین گونه ناساخته"
  },
  {
    "poem_id": 1647,
    "vorder": 8,
    "position": 1,
    "text": "بیایم دمان گردن افراخته"
  },
  {
    "poem_id": 1647,
    "vorder": 9,
    "position": 0,
    "text": "نباشد پسند جهان‌آفرین"
  },
  {
    "poem_id": 1647,
    "vorder": 10,
    "position": 1,
    "text": "نه نزدیک آن پادشاه زمین"
  },
  {
    "poem_id": 1647,
    "vorder": 11,
    "position": 0,
    "text": "هم‌انگه بفرمود تا شد دبیر"
  },
  {
    "poem_id": 1647,
    "vorder": 12,
    "position": 1,
    "text": "قلم خواست هندی و چینی حریر"
  },
  {
    "poem_id": 1647,
    "vorder": 13,
    "position": 0,
    "text": "مران نامه را زود پاسخ نوشت"
  },
  {
    "poem_id": 1647,
    "vorder": 14,
    "position": 1,
    "text": "بیاراست بر سان باغ بهشت"
  },
  {
    "poem_id": 1647,
    "vorder": 15,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1647,
    "vorder": 16,
    "position": 1,
    "text": "خداوند پیروز و به روزگار"
  },
  {
    "poem_id": 1647,
    "vorder": 17,
    "position": 0,
    "text": "خداوند بخشنده و دادگر"
  },
  {
    "poem_id": 1647,
    "vorder": 18,
    "position": 1,
    "text": "خداوند مردی و هوش و هنر"
  },
  {
    "poem_id": 1647,
    "vorder": 19,
    "position": 0,
    "text": "دگر گفت کز نامور پادشا"
  },
  {
    "poem_id": 1647,
    "vorder": 20,
    "position": 1,
    "text": "نپیچد سر مردم پارسا"
  },
  {
    "poem_id": 1647,
    "vorder": 21,
    "position": 0,
    "text": "نشاید که داریم چیزی دریغ"
  },
  {
    "poem_id": 1647,
    "vorder": 22,
    "position": 1,
    "text": "ز دارندهٔ لشکر و تاج و تیغ"
  },
  {
    "poem_id": 1647,
    "vorder": 23,
    "position": 0,
    "text": "مرا چار چیزست کاندر جهان"
  },
  {
    "poem_id": 1647,
    "vorder": 24,
    "position": 1,
    "text": "کسی را نبود آشکار و نهان"
  },
  {
    "poem_id": 1647,
    "vorder": 25,
    "position": 0,
    "text": "نباشد کسی را پس از من به نیز"
  },
  {
    "poem_id": 1647,
    "vorder": 26,
    "position": 1,
    "text": "بدین گونه اندر جهان چار چیز"
  },
  {
    "poem_id": 1647,
    "vorder": 27,
    "position": 0,
    "text": "فرستم چو فرمان دهد پیش اوی"
  },
  {
    "poem_id": 1647,
    "vorder": 28,
    "position": 1,
    "text": "ازان تازه گردد دل و کیش اوی"
  },
  {
    "poem_id": 1647,
    "vorder": 29,
    "position": 0,
    "text": "ازان پس چو فرمایدم شهریار"
  },
  {
    "poem_id": 1647,
    "vorder": 30,
    "position": 1,
    "text": "بیایم پرستش کنم بنده‌وار"
  }
]