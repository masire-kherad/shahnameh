[
  {
    "poem_id": 1825,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت موبد که بر تخت عاج"
  },
  {
    "poem_id": 1825,
    "vorder": 2,
    "position": 1,
    "text": "چو کسری کسی نیز ننهاد تاج"
  },
  {
    "poem_id": 1825,
    "vorder": 3,
    "position": 0,
    "text": "به بزم و برزم و به پرهیز وداد"
  },
  {
    "poem_id": 1825,
    "vorder": 4,
    "position": 1,
    "text": "چنو کس ندارد ز شاهان به یاد"
  },
  {
    "poem_id": 1825,
    "vorder": 5,
    "position": 0,
    "text": "ز دانندگان دانش آموختی"
  },
  {
    "poem_id": 1825,
    "vorder": 6,
    "position": 1,
    "text": "دلش را بدانش برافروختی"
  },
  {
    "poem_id": 1825,
    "vorder": 7,
    "position": 0,
    "text": "خور وخواب با موبدان داشتی"
  },
  {
    "poem_id": 1825,
    "vorder": 8,
    "position": 1,
    "text": "همی سر به دانش برافراشتی"
  },
  {
    "poem_id": 1825,
    "vorder": 9,
    "position": 0,
    "text": "برو چون روا شد به چیزی سخن"
  },
  {
    "poem_id": 1825,
    "vorder": 10,
    "position": 1,
    "text": "تو ز آموختن هیچ سستی مکن"
  },
  {
    "poem_id": 1825,
    "vorder": 11,
    "position": 0,
    "text": "نباید که گویی که دانا شدم"
  },
  {
    "poem_id": 1825,
    "vorder": 12,
    "position": 1,
    "text": "به هر آرزو بر توانا شدم"
  },
  {
    "poem_id": 1825,
    "vorder": 13,
    "position": 0,
    "text": "چو این داستان بشنوی یادگیر"
  },
  {
    "poem_id": 1825,
    "vorder": 14,
    "position": 1,
    "text": "ز گفتار گوینده دهقان پیر"
  },
  {
    "poem_id": 1825,
    "vorder": 15,
    "position": 0,
    "text": "بپرسیدم از روزگار کهن"
  },
  {
    "poem_id": 1825,
    "vorder": 16,
    "position": 1,
    "text": "ز نوشین روان یاد کرد این سخن"
  },
  {
    "poem_id": 1825,
    "vorder": 17,
    "position": 0,
    "text": "که او را یکی پاک دستور بود"
  },
  {
    "poem_id": 1825,
    "vorder": 18,
    "position": 1,
    "text": "که بیدار دل بود و گنجور بود"
  },
  {
    "poem_id": 1825,
    "vorder": 19,
    "position": 0,
    "text": "دلی پرخرد داشت و رای درست"
  },
  {
    "poem_id": 1825,
    "vorder": 20,
    "position": 1,
    "text": "ز گیتی به جز نیکنامی نجست"
  },
  {
    "poem_id": 1825,
    "vorder": 21,
    "position": 0,
    "text": "که مهبود بدنام آن پاک مغز"
  },
  {
    "poem_id": 1825,
    "vorder": 22,
    "position": 1,
    "text": "روان و دلش پر ز گفتار نغز"
  },
  {
    "poem_id": 1825,
    "vorder": 23,
    "position": 0,
    "text": "دو فرزند بودش چو خرم بهار"
  },
  {
    "poem_id": 1825,
    "vorder": 24,
    "position": 1,
    "text": "همیشه پرستندهٔ شهریار"
  },
  {
    "poem_id": 1825,
    "vorder": 25,
    "position": 0,
    "text": "شهنشاه چون بزم آراستی"
  },
  {
    "poem_id": 1825,
    "vorder": 26,
    "position": 1,
    "text": "و گر برسم موبدی خواستی"
  },
  {
    "poem_id": 1825,
    "vorder": 27,
    "position": 0,
    "text": "نخوردی جز ازدست مهبود چیز"
  },
  {
    "poem_id": 1825,
    "vorder": 28,
    "position": 1,
    "text": "هم ایمن بدی زان دو فرزند نیز"
  },
  {
    "poem_id": 1825,
    "vorder": 29,
    "position": 0,
    "text": "خورش خانه در خان او داشتی"
  },
  {
    "poem_id": 1825,
    "vorder": 30,
    "position": 1,
    "text": "تن خویش مهمان او داشتی"
  },
  {
    "poem_id": 1825,
    "vorder": 31,
    "position": 0,
    "text": "دو فرزند آن نامور پارسا"
  },
  {
    "poem_id": 1825,
    "vorder": 32,
    "position": 1,
    "text": "خورش ساختندی بر پادشا"
  },
  {
    "poem_id": 1825,
    "vorder": 33,
    "position": 0,
    "text": "بزرگان ز مهبود بردند رشک"
  },
  {
    "poem_id": 1825,
    "vorder": 34,
    "position": 1,
    "text": "همی‌ریختندی به رخ بر سرشک"
  },
  {
    "poem_id": 1825,
    "vorder": 35,
    "position": 0,
    "text": "یکی نامور بود زروان به نام"
  },
  {
    "poem_id": 1825,
    "vorder": 36,
    "position": 1,
    "text": "که او را بدی بر در شاه کام"
  },
  {
    "poem_id": 1825,
    "vorder": 37,
    "position": 0,
    "text": "کهن بود و هم حاجب شاه بود"
  },
  {
    "poem_id": 1825,
    "vorder": 38,
    "position": 1,
    "text": "فروزندهٔ رسم درگاه بود"
  },
  {
    "poem_id": 1825,
    "vorder": 39,
    "position": 0,
    "text": "ز مهبود وفرخ دو فرزند اوی"
  },
  {
    "poem_id": 1825,
    "vorder": 40,
    "position": 1,
    "text": "همه ساله بودی پر از آبروی"
  },
  {
    "poem_id": 1825,
    "vorder": 41,
    "position": 0,
    "text": "همی‌ساختی تا سر پادشا"
  },
  {
    "poem_id": 1825,
    "vorder": 42,
    "position": 1,
    "text": "کند تیز برکار آن پارسا"
  },
  {
    "poem_id": 1825,
    "vorder": 43,
    "position": 0,
    "text": "ببد گفت از ایشان ندید ایچ راه"
  },
  {
    "poem_id": 1825,
    "vorder": 44,
    "position": 1,
    "text": "که کردی پرآزار زان جان شاه"
  },
  {
    "poem_id": 1825,
    "vorder": 45,
    "position": 0,
    "text": "خردمند زان بد نه آگاه بود"
  },
  {
    "poem_id": 1825,
    "vorder": 46,
    "position": 1,
    "text": "که او را به درگاه بدخواه بود"
  },
  {
    "poem_id": 1825,
    "vorder": 47,
    "position": 0,
    "text": "ز گفتار و کردار آن شوخ مرد"
  },
  {
    "poem_id": 1825,
    "vorder": 48,
    "position": 1,
    "text": "نشد هیچ مهبود را روی زرد"
  },
  {
    "poem_id": 1825,
    "vorder": 49,
    "position": 0,
    "text": "چنان بد که یک روز مردی جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 50,
    "position": 1,
    "text": "ز زروان درم خواست از بهر سود"
  },
  {
    "poem_id": 1825,
    "vorder": 51,
    "position": 0,
    "text": "شد آمد بیفزود در پیش اوی"
  },
  {
    "poem_id": 1825,
    "vorder": 52,
    "position": 1,
    "text": "برآمیخت با جان بدکیش اوی"
  },
  {
    "poem_id": 1825,
    "vorder": 53,
    "position": 0,
    "text": "چو با حاجب شاه گستاخ شد"
  },
  {
    "poem_id": 1825,
    "vorder": 54,
    "position": 1,
    "text": "پرستندهٔ خسروی کاخ شد"
  },
  {
    "poem_id": 1825,
    "vorder": 55,
    "position": 0,
    "text": "ز افسون سخن رفت روزی نهان"
  },
  {
    "poem_id": 1825,
    "vorder": 56,
    "position": 1,
    "text": "ز درگاه وز شهریار جهان"
  },
  {
    "poem_id": 1825,
    "vorder": 57,
    "position": 0,
    "text": "ز نیرنگ وز تنبل و جادویی"
  },
  {
    "poem_id": 1825,
    "vorder": 58,
    "position": 1,
    "text": "ز کردار کژی وز بدخویی"
  },
  {
    "poem_id": 1825,
    "vorder": 59,
    "position": 0,
    "text": "چو زروان به گفتار مرد جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 60,
    "position": 1,
    "text": "نگه کرد وزان سان سخنها شنود"
  },
  {
    "poem_id": 1825,
    "vorder": 61,
    "position": 0,
    "text": "برو راز بگشاد و گفت این سخن"
  },
  {
    "poem_id": 1825,
    "vorder": 62,
    "position": 1,
    "text": "به جز پیش جان آشکارا مکن"
  },
  {
    "poem_id": 1825,
    "vorder": 63,
    "position": 0,
    "text": "یکی چاره باید تو را ساختن"
  },
  {
    "poem_id": 1825,
    "vorder": 64,
    "position": 1,
    "text": "زمانه ز مهبود پرداختن"
  },
  {
    "poem_id": 1825,
    "vorder": 65,
    "position": 0,
    "text": "که او را بزرگی به جایی رسید"
  },
  {
    "poem_id": 1825,
    "vorder": 66,
    "position": 1,
    "text": "که پای زمانه نخواهد کشید"
  },
  {
    "poem_id": 1825,
    "vorder": 67,
    "position": 0,
    "text": "ز گیتی ندارد کسی رابکس"
  },
  {
    "poem_id": 1825,
    "vorder": 68,
    "position": 1,
    "text": "تو گویی که نوشین روانست و بس"
  },
  {
    "poem_id": 1825,
    "vorder": 69,
    "position": 0,
    "text": "جز از دست فرزند مهبود چیز"
  },
  {
    "poem_id": 1825,
    "vorder": 70,
    "position": 1,
    "text": "خورشها نخواهد جهاندار نیز"
  },
  {
    "poem_id": 1825,
    "vorder": 71,
    "position": 0,
    "text": "شدست از نوازش چنان پرمنش"
  },
  {
    "poem_id": 1825,
    "vorder": 72,
    "position": 1,
    "text": "که هزمان ببوسد فلک دامنش"
  },
  {
    "poem_id": 1825,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد پاسخ به زروان جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 74,
    "position": 1,
    "text": "کزین داوری غم نباید فزود"
  },
  {
    "poem_id": 1825,
    "vorder": 75,
    "position": 0,
    "text": "چو برسم بخواهد جهاندار شاه"
  },
  {
    "poem_id": 1825,
    "vorder": 76,
    "position": 1,
    "text": "خورشها ببین تا چه آید به راه"
  },
  {
    "poem_id": 1825,
    "vorder": 77,
    "position": 0,
    "text": "نگر تابود هیچ شیر اندروی"
  },
  {
    "poem_id": 1825,
    "vorder": 78,
    "position": 1,
    "text": "پذیره شو وخوردنیها ببوی"
  },
  {
    "poem_id": 1825,
    "vorder": 79,
    "position": 0,
    "text": "همان بس که من شیر بینم ز دور"
  },
  {
    "poem_id": 1825,
    "vorder": 80,
    "position": 1,
    "text": "نه مهبود بینی تو زنده نه پور"
  },
  {
    "poem_id": 1825,
    "vorder": 81,
    "position": 0,
    "text": "که گر زو خورد بی‌گمان روی و سنگ"
  },
  {
    "poem_id": 1825,
    "vorder": 82,
    "position": 1,
    "text": "بریزد هم اندر زمان بی‌درنگ"
  },
  {
    "poem_id": 1825,
    "vorder": 83,
    "position": 0,
    "text": "نگه کرد زروان به گفتار اوی"
  },
  {
    "poem_id": 1825,
    "vorder": 84,
    "position": 1,
    "text": "دلش تازه‌تر شد به دیدار اوی"
  },
  {
    "poem_id": 1825,
    "vorder": 85,
    "position": 0,
    "text": "نرفتی به درگاه بی‌آن جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 86,
    "position": 1,
    "text": "خور و شادی و کام بی او نبود"
  },
  {
    "poem_id": 1825,
    "vorder": 87,
    "position": 0,
    "text": "چنین تا برآمد برین چندگاه"
  },
  {
    "poem_id": 1825,
    "vorder": 88,
    "position": 1,
    "text": "بد آموز پویان به درگاه شاه"
  },
  {
    "poem_id": 1825,
    "vorder": 89,
    "position": 0,
    "text": "دو فرزند مهبود هر بامداد"
  },
  {
    "poem_id": 1825,
    "vorder": 90,
    "position": 1,
    "text": "خرامان شدندی برشاه راد"
  },
  {
    "poem_id": 1825,
    "vorder": 91,
    "position": 0,
    "text": "پس پردهٔ نامور کدخدای"
  },
  {
    "poem_id": 1825,
    "vorder": 92,
    "position": 1,
    "text": "زنی بود پاکیزه و پاک رای"
  },
  {
    "poem_id": 1825,
    "vorder": 93,
    "position": 0,
    "text": "که چون شاه کسری خورش خواستی"
  },
  {
    "poem_id": 1825,
    "vorder": 94,
    "position": 1,
    "text": "یکی خوان زرین بیاراستی"
  },
  {
    "poem_id": 1825,
    "vorder": 95,
    "position": 0,
    "text": "سه کاسه نهادی برو از گهر"
  },
  {
    "poem_id": 1825,
    "vorder": 96,
    "position": 1,
    "text": "به دستار زربفت پوشیده سر"
  },
  {
    "poem_id": 1825,
    "vorder": 97,
    "position": 0,
    "text": "زدست دو فرزند آن ارجمند"
  },
  {
    "poem_id": 1825,
    "vorder": 98,
    "position": 1,
    "text": "رسیدی به نزدیک شاه بلند"
  },
  {
    "poem_id": 1825,
    "vorder": 99,
    "position": 0,
    "text": "خورشها زشهد وز شیر و گلاب"
  },
  {
    "poem_id": 1825,
    "vorder": 100,
    "position": 1,
    "text": "بخوردی وآراستی جای خواب"
  },
  {
    "poem_id": 1825,
    "vorder": 101,
    "position": 0,
    "text": "چنان بد که یک روز هر دو جوان"
  },
  {
    "poem_id": 1825,
    "vorder": 102,
    "position": 1,
    "text": "ببردند خوان نزدنوشین‌روان"
  },
  {
    "poem_id": 1825,
    "vorder": 103,
    "position": 0,
    "text": "به سر برنهاده یکی پیشکار"
  },
  {
    "poem_id": 1825,
    "vorder": 104,
    "position": 1,
    "text": "که بودی خورش نزد او استوار"
  },
  {
    "poem_id": 1825,
    "vorder": 105,
    "position": 0,
    "text": "چو خوان اندرآمد به ایوان شاه"
  },
  {
    "poem_id": 1825,
    "vorder": 106,
    "position": 1,
    "text": "بدو کرد زروان حاجب نگاه"
  },
  {
    "poem_id": 1825,
    "vorder": 107,
    "position": 0,
    "text": "چنین گفت خندان به هر دو جوان"
  },
  {
    "poem_id": 1825,
    "vorder": 108,
    "position": 1,
    "text": "که ای ایمن از شاه نوشین‌روان"
  },
  {
    "poem_id": 1825,
    "vorder": 109,
    "position": 0,
    "text": "یکی روی بنمای تا زین خورش"
  },
  {
    "poem_id": 1825,
    "vorder": 110,
    "position": 1,
    "text": "که باشد همی شاه را پرورش"
  },
  {
    "poem_id": 1825,
    "vorder": 111,
    "position": 0,
    "text": "چه رنگست کاید همی بوی خوش"
  },
  {
    "poem_id": 1825,
    "vorder": 112,
    "position": 1,
    "text": "یکی پرنیان چادر از وی بکش"
  },
  {
    "poem_id": 1825,
    "vorder": 113,
    "position": 0,
    "text": "جوان زان خورش زود بگشاد روی"
  },
  {
    "poem_id": 1825,
    "vorder": 114,
    "position": 1,
    "text": "نگه کرد زروان ز دور اند روی"
  },
  {
    "poem_id": 1825,
    "vorder": 115,
    "position": 0,
    "text": "همیدون جهود اندرو بنگرید"
  },
  {
    "poem_id": 1825,
    "vorder": 116,
    "position": 1,
    "text": "پس آمد چو رنگ خورشها بدید"
  },
  {
    "poem_id": 1825,
    "vorder": 117,
    "position": 0,
    "text": "چنین گفت زان پس به سالار بار"
  },
  {
    "poem_id": 1825,
    "vorder": 118,
    "position": 1,
    "text": "که آمد درختی که کشتی به بار"
  },
  {
    "poem_id": 1825,
    "vorder": 119,
    "position": 0,
    "text": "ببردند خوان نزد نوشین‌روان"
  },
  {
    "poem_id": 1825,
    "vorder": 120,
    "position": 1,
    "text": "خردمند و بیدار هر دو جوان"
  },
  {
    "poem_id": 1825,
    "vorder": 121,
    "position": 0,
    "text": "پس خوان همی‌رفت زروان چو گرد"
  },
  {
    "poem_id": 1825,
    "vorder": 122,
    "position": 1,
    "text": "چنین گفت با شاه آزادمرد"
  },
  {
    "poem_id": 1825,
    "vorder": 123,
    "position": 0,
    "text": "که ای شاه نیک اختر و دادگر"
  },
  {
    "poem_id": 1825,
    "vorder": 124,
    "position": 1,
    "text": "تو بی‌چاشنی دست خوردن مبر"
  },
  {
    "poem_id": 1825,
    "vorder": 125,
    "position": 0,
    "text": "که روی فلک بخت خندان تست"
  },
  {
    "poem_id": 1825,
    "vorder": 126,
    "position": 1,
    "text": "جهان روشن از تخت و میدان تست"
  },
  {
    "poem_id": 1825,
    "vorder": 127,
    "position": 0,
    "text": "خورشگر بیامیخت با شیر زهر"
  },
  {
    "poem_id": 1825,
    "vorder": 128,
    "position": 1,
    "text": "بداندیش را باد زین زهر بهر"
  },
  {
    "poem_id": 1825,
    "vorder": 129,
    "position": 0,
    "text": "چو بشنید زو شاه نوشین‌روان"
  },
  {
    "poem_id": 1825,
    "vorder": 130,
    "position": 1,
    "text": "نگه کرد روشن به هر دوجوان"
  },
  {
    "poem_id": 1825,
    "vorder": 131,
    "position": 0,
    "text": "که خوالیگرش مام ایشان بدی"
  },
  {
    "poem_id": 1825,
    "vorder": 132,
    "position": 1,
    "text": "خردمند و با کام ایشان بدی"
  },
  {
    "poem_id": 1825,
    "vorder": 133,
    "position": 0,
    "text": "جوانان ز پاکی وز راستی"
  },
  {
    "poem_id": 1825,
    "vorder": 134,
    "position": 1,
    "text": "نوشتند بر پشت دست آستی"
  },
  {
    "poem_id": 1825,
    "vorder": 135,
    "position": 0,
    "text": "همان چون بخوردند از کاسه شیر"
  },
  {
    "poem_id": 1825,
    "vorder": 136,
    "position": 1,
    "text": "توگویی بخستند هر دو به تیر"
  },
  {
    "poem_id": 1825,
    "vorder": 137,
    "position": 0,
    "text": "بخفتند برجای هر دو جوان"
  },
  {
    "poem_id": 1825,
    "vorder": 138,
    "position": 1,
    "text": "بدادند جان پیش نوشین‌روان"
  },
  {
    "poem_id": 1825,
    "vorder": 139,
    "position": 0,
    "text": "چوشاه جهان اندران بنگرید"
  },
  {
    "poem_id": 1825,
    "vorder": 140,
    "position": 1,
    "text": "برآشفت و شد چون گل شنبلید"
  },
  {
    "poem_id": 1825,
    "vorder": 141,
    "position": 0,
    "text": "بفرمود کز خان مهبود خاک"
  },
  {
    "poem_id": 1825,
    "vorder": 142,
    "position": 1,
    "text": "برآرید وز کس مدارید باک"
  },
  {
    "poem_id": 1825,
    "vorder": 143,
    "position": 0,
    "text": "بر آن خاک باید بریدن سرش"
  },
  {
    "poem_id": 1825,
    "vorder": 144,
    "position": 1,
    "text": "مه مهبود مانا مه خوالیگرش"
  },
  {
    "poem_id": 1825,
    "vorder": 145,
    "position": 0,
    "text": "به ایوان مهبود در کس نماند"
  },
  {
    "poem_id": 1825,
    "vorder": 146,
    "position": 1,
    "text": "ز خویشان او درجهان بس نماند"
  },
  {
    "poem_id": 1825,
    "vorder": 147,
    "position": 0,
    "text": "به تاراج داد آن همه خواسته"
  },
  {
    "poem_id": 1825,
    "vorder": 148,
    "position": 1,
    "text": "زن و کودک و گنج آراسته"
  },
  {
    "poem_id": 1825,
    "vorder": 149,
    "position": 0,
    "text": "رسیده از آن کار زروان به کام"
  },
  {
    "poem_id": 1825,
    "vorder": 150,
    "position": 1,
    "text": "گهی کام دید اندر آن گاه نام"
  },
  {
    "poem_id": 1825,
    "vorder": 151,
    "position": 0,
    "text": "به نزدیک او شد جهود ارجمند"
  },
  {
    "poem_id": 1825,
    "vorder": 152,
    "position": 1,
    "text": "برافراخت سر تا بابر بلند"
  },
  {
    "poem_id": 1825,
    "vorder": 153,
    "position": 0,
    "text": "بگشت اندرین نیز چندی سپهر"
  },
  {
    "poem_id": 1825,
    "vorder": 154,
    "position": 1,
    "text": "درستی نهان کرده از شاه چهر"
  },
  {
    "poem_id": 1825,
    "vorder": 155,
    "position": 0,
    "text": "چنان بد که شاه جهان کدخدای"
  },
  {
    "poem_id": 1825,
    "vorder": 156,
    "position": 1,
    "text": "به نخچیر گوران همی‌کرد رای"
  },
  {
    "poem_id": 1825,
    "vorder": 157,
    "position": 0,
    "text": "بفرمود تا اسب نخچیرگاه"
  },
  {
    "poem_id": 1825,
    "vorder": 158,
    "position": 1,
    "text": "بسی بگذرانند در پیش شاه"
  },
  {
    "poem_id": 1825,
    "vorder": 159,
    "position": 0,
    "text": "ز اسبان که کسری همی‌بنگرید"
  },
  {
    "poem_id": 1825,
    "vorder": 160,
    "position": 1,
    "text": "یکی را بران داغ مهبود دید"
  },
  {
    "poem_id": 1825,
    "vorder": 161,
    "position": 0,
    "text": "ازان تازی اسبان دلش برفروخت"
  },
  {
    "poem_id": 1825,
    "vorder": 162,
    "position": 1,
    "text": "به مهبود بر جای مهرش بسوخت"
  },
  {
    "poem_id": 1825,
    "vorder": 163,
    "position": 0,
    "text": "فروریخت آب از دو دیده بدرد"
  },
  {
    "poem_id": 1825,
    "vorder": 164,
    "position": 1,
    "text": "بسی داغ دل یاد مهبود کرد"
  },
  {
    "poem_id": 1825,
    "vorder": 165,
    "position": 0,
    "text": "چنین گفت کان مرد با جاه و رای"
  },
  {
    "poem_id": 1825,
    "vorder": 166,
    "position": 1,
    "text": "ببردش چنان دیو ریمن ز جای"
  },
  {
    "poem_id": 1825,
    "vorder": 167,
    "position": 0,
    "text": "بدان دوستداری و آن راستی"
  },
  {
    "poem_id": 1825,
    "vorder": 168,
    "position": 1,
    "text": "چرا زد روانش درکاستی"
  },
  {
    "poem_id": 1825,
    "vorder": 169,
    "position": 0,
    "text": "نداند جز از کردگار جهان"
  },
  {
    "poem_id": 1825,
    "vorder": 170,
    "position": 1,
    "text": "ازان آشکارا درستی نهان"
  },
  {
    "poem_id": 1825,
    "vorder": 171,
    "position": 0,
    "text": "وزان جایگه سوی نخچیرگاه"
  },
  {
    "poem_id": 1825,
    "vorder": 172,
    "position": 1,
    "text": "بیامد چنان داغ دل کینه خواه"
  },
  {
    "poem_id": 1825,
    "vorder": 173,
    "position": 0,
    "text": "ز هر کس بره برسخن خواستی"
  },
  {
    "poem_id": 1825,
    "vorder": 174,
    "position": 1,
    "text": "ز گفتارها دل بیاراستی"
  },
  {
    "poem_id": 1825,
    "vorder": 175,
    "position": 0,
    "text": "سراینده بسیار همراه کرد"
  },
  {
    "poem_id": 1825,
    "vorder": 176,
    "position": 1,
    "text": "به افسانه‌ها راه کوتاه کرد"
  },
  {
    "poem_id": 1825,
    "vorder": 177,
    "position": 0,
    "text": "دبیران و زروان و دستور شاه"
  },
  {
    "poem_id": 1825,
    "vorder": 178,
    "position": 1,
    "text": "برفتند یک روز پویان به راه"
  },
  {
    "poem_id": 1825,
    "vorder": 179,
    "position": 0,
    "text": "سخن رفت چندی ز افسون و بند"
  },
  {
    "poem_id": 1825,
    "vorder": 180,
    "position": 1,
    "text": "ز جادوی و آهرمن پرگزند"
  },
  {
    "poem_id": 1825,
    "vorder": 181,
    "position": 0,
    "text": "به موبد چنین گفت پس شهریار"
  },
  {
    "poem_id": 1825,
    "vorder": 182,
    "position": 1,
    "text": "که دل رابه نیرنگ رنجه مدار"
  },
  {
    "poem_id": 1825,
    "vorder": 183,
    "position": 0,
    "text": "سخن جز به یزدان و از دین مگوی"
  },
  {
    "poem_id": 1825,
    "vorder": 184,
    "position": 1,
    "text": "ز نیرنگ جادو شگفتی مجوی"
  },
  {
    "poem_id": 1825,
    "vorder": 185,
    "position": 0,
    "text": "بدو گفت زروان انوشه بدی"
  },
  {
    "poem_id": 1825,
    "vorder": 186,
    "position": 1,
    "text": "خرد را به گفتار توشه بدی"
  },
  {
    "poem_id": 1825,
    "vorder": 187,
    "position": 0,
    "text": "ز جادو سخن هرچ گویند هست"
  },
  {
    "poem_id": 1825,
    "vorder": 188,
    "position": 1,
    "text": "نداند جز از مرد جادوپرست"
  },
  {
    "poem_id": 1825,
    "vorder": 189,
    "position": 0,
    "text": "اگر خوردنی دارد از شیر بهر"
  },
  {
    "poem_id": 1825,
    "vorder": 190,
    "position": 1,
    "text": "پدیدار گرداند از دور زهر"
  },
  {
    "poem_id": 1825,
    "vorder": 191,
    "position": 0,
    "text": "چو بشنید نوشین‌روان این سخن"
  },
  {
    "poem_id": 1825,
    "vorder": 192,
    "position": 1,
    "text": "برو تازه شد روزگار کهن"
  },
  {
    "poem_id": 1825,
    "vorder": 193,
    "position": 0,
    "text": "ز مهبود و هر دو پسر یاد کرد"
  },
  {
    "poem_id": 1825,
    "vorder": 194,
    "position": 1,
    "text": "برآورد بر لب یکی باد سرد"
  },
  {
    "poem_id": 1825,
    "vorder": 195,
    "position": 0,
    "text": "به زروان نگه کرد و خامش بماند"
  },
  {
    "poem_id": 1825,
    "vorder": 196,
    "position": 1,
    "text": "سبک باره گامزن را براند"
  },
  {
    "poem_id": 1825,
    "vorder": 197,
    "position": 0,
    "text": "روانش ز اندیشه پر دود بود"
  },
  {
    "poem_id": 1825,
    "vorder": 198,
    "position": 1,
    "text": "که زروان بداندیش مهبود بود"
  },
  {
    "poem_id": 1825,
    "vorder": 199,
    "position": 0,
    "text": "همی‌گفت کین مرد ناسازگار"
  },
  {
    "poem_id": 1825,
    "vorder": 200,
    "position": 1,
    "text": "ندانم چه کرد اندران روزگار"
  },
  {
    "poem_id": 1825,
    "vorder": 201,
    "position": 0,
    "text": "که مهبود بردست ماکشته شد"
  },
  {
    "poem_id": 1825,
    "vorder": 202,
    "position": 1,
    "text": "چنان دوده را روز برگشته شد"
  },
  {
    "poem_id": 1825,
    "vorder": 203,
    "position": 0,
    "text": "مگر کردگار آشکارا کند"
  },
  {
    "poem_id": 1825,
    "vorder": 204,
    "position": 1,
    "text": "دل و مغز ما را مدارا کند"
  },
  {
    "poem_id": 1825,
    "vorder": 205,
    "position": 0,
    "text": "که آلوده بینم همی زو سخن"
  },
  {
    "poem_id": 1825,
    "vorder": 206,
    "position": 1,
    "text": "پر از دردم از روزگار کهن"
  },
  {
    "poem_id": 1825,
    "vorder": 207,
    "position": 0,
    "text": "همی‌رفت با دل پر از درد وغم"
  },
  {
    "poem_id": 1825,
    "vorder": 208,
    "position": 1,
    "text": "پرآژنگ رخ دیدگان پر ز نم"
  },
  {
    "poem_id": 1825,
    "vorder": 209,
    "position": 0,
    "text": "به منزل رسید آن زمان شهریار"
  },
  {
    "poem_id": 1825,
    "vorder": 210,
    "position": 1,
    "text": "سراپرده زد بر لب جویبار"
  },
  {
    "poem_id": 1825,
    "vorder": 211,
    "position": 0,
    "text": "چو زروان بیامد به پرده سرای"
  },
  {
    "poem_id": 1825,
    "vorder": 212,
    "position": 1,
    "text": "ز بیگانه پردخت کردند جای"
  },
  {
    "poem_id": 1825,
    "vorder": 213,
    "position": 0,
    "text": "ز جادو سخن رفت وز شهد و شیر"
  },
  {
    "poem_id": 1825,
    "vorder": 214,
    "position": 1,
    "text": "بدو گفت شد این سخن دلپذیر"
  },
  {
    "poem_id": 1825,
    "vorder": 215,
    "position": 0,
    "text": "ز مهبود زان پس بپرسید شاه"
  },
  {
    "poem_id": 1825,
    "vorder": 216,
    "position": 1,
    "text": "ز فرزند او تا چرا شد تباه"
  },
  {
    "poem_id": 1825,
    "vorder": 217,
    "position": 0,
    "text": "چو پاسخ ازو لرز لرزان شنید"
  },
  {
    "poem_id": 1825,
    "vorder": 218,
    "position": 1,
    "text": "ز زروان گنهکاری آمد پدید"
  },
  {
    "poem_id": 1825,
    "vorder": 219,
    "position": 0,
    "text": "بدو گفت کسری سخن راست گوی"
  },
  {
    "poem_id": 1825,
    "vorder": 220,
    "position": 1,
    "text": "مکن کژی و هیچ چاره مجوی"
  },
  {
    "poem_id": 1825,
    "vorder": 221,
    "position": 0,
    "text": "که کژی نیارد مگر کار بد"
  },
  {
    "poem_id": 1825,
    "vorder": 222,
    "position": 1,
    "text": "دل نیک بد گردد از یار بد"
  },
  {
    "poem_id": 1825,
    "vorder": 223,
    "position": 0,
    "text": "سراسر سخن راست زروان بگفت"
  },
  {
    "poem_id": 1825,
    "vorder": 224,
    "position": 1,
    "text": "نهفته پدید آورید از نهفت"
  },
  {
    "poem_id": 1825,
    "vorder": 225,
    "position": 0,
    "text": "گنه یک سر افگند سوی جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 226,
    "position": 1,
    "text": "تن خویش راکرد پر درد و دود"
  },
  {
    "poem_id": 1825,
    "vorder": 227,
    "position": 0,
    "text": "چو بشنید زو شهریار بلند"
  },
  {
    "poem_id": 1825,
    "vorder": 228,
    "position": 1,
    "text": "هم اندر زمان پای کردش ببند"
  },
  {
    "poem_id": 1825,
    "vorder": 229,
    "position": 0,
    "text": "فرستاد نزد مشعبد جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 230,
    "position": 1,
    "text": "دواسبه سواری به کردار دود"
  },
  {
    "poem_id": 1825,
    "vorder": 231,
    "position": 0,
    "text": "چوآمد بدان بارگاه بلند"
  },
  {
    "poem_id": 1825,
    "vorder": 232,
    "position": 1,
    "text": "بپرسید زو نرم شاه بلند"
  },
  {
    "poem_id": 1825,
    "vorder": 233,
    "position": 0,
    "text": "که این کار چون بود با من بگوی"
  },
  {
    "poem_id": 1825,
    "vorder": 234,
    "position": 1,
    "text": "بدست دروغ ایچ منمای روی"
  },
  {
    "poem_id": 1825,
    "vorder": 235,
    "position": 0,
    "text": "جهود از جهاندار زنهار خواست"
  },
  {
    "poem_id": 1825,
    "vorder": 236,
    "position": 1,
    "text": "که پیداکند راز نیرنگ راست"
  },
  {
    "poem_id": 1825,
    "vorder": 237,
    "position": 0,
    "text": "بگفت آنچ زروان بدو گفته بود"
  },
  {
    "poem_id": 1825,
    "vorder": 238,
    "position": 1,
    "text": "سخن هرچ اندر نهان رفته بود"
  },
  {
    "poem_id": 1825,
    "vorder": 239,
    "position": 0,
    "text": "جهاندار بشنید خیره بماند"
  },
  {
    "poem_id": 1825,
    "vorder": 240,
    "position": 1,
    "text": "رد و موبد و مرزبان را بخواند"
  },
  {
    "poem_id": 1825,
    "vorder": 241,
    "position": 0,
    "text": "دگر باره کرد آن سخن خواستار"
  },
  {
    "poem_id": 1825,
    "vorder": 242,
    "position": 1,
    "text": "به پیش ردان دادگر شهریار"
  },
  {
    "poem_id": 1825,
    "vorder": 243,
    "position": 0,
    "text": "بفرمود پس تا دو دار بلند"
  },
  {
    "poem_id": 1825,
    "vorder": 244,
    "position": 1,
    "text": "فروهشته از دار پیچان کمند"
  },
  {
    "poem_id": 1825,
    "vorder": 245,
    "position": 0,
    "text": "بزد مرد دژخیم پیش درش"
  },
  {
    "poem_id": 1825,
    "vorder": 246,
    "position": 1,
    "text": "نظاره بروبر همه کشورش"
  },
  {
    "poem_id": 1825,
    "vorder": 247,
    "position": 0,
    "text": "به یک دار زروان و دیگر جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 248,
    "position": 1,
    "text": "کشنده برآهخت و تندی نمود"
  },
  {
    "poem_id": 1825,
    "vorder": 249,
    "position": 0,
    "text": "بباران سنگ و بباران تیر"
  },
  {
    "poem_id": 1825,
    "vorder": 250,
    "position": 1,
    "text": "بدادند سرها به نیرنگ شیر"
  },
  {
    "poem_id": 1825,
    "vorder": 251,
    "position": 0,
    "text": "جهان را نباید سپردن ببد"
  },
  {
    "poem_id": 1825,
    "vorder": 252,
    "position": 1,
    "text": "که بر بد گمان بی‌گمان بد رسد"
  },
  {
    "poem_id": 1825,
    "vorder": 253,
    "position": 0,
    "text": "ز خویشان مهبود چندی بجست"
  },
  {
    "poem_id": 1825,
    "vorder": 254,
    "position": 1,
    "text": "کزیشان بیابد کسی تندرست"
  },
  {
    "poem_id": 1825,
    "vorder": 255,
    "position": 0,
    "text": "یکی دختری یافت پوشیده‌روی"
  },
  {
    "poem_id": 1825,
    "vorder": 256,
    "position": 1,
    "text": "سه مرد گرانمایه و نیک‌خوی"
  },
  {
    "poem_id": 1825,
    "vorder": 257,
    "position": 0,
    "text": "همه گنج زروان بدیشان نمود"
  },
  {
    "poem_id": 1825,
    "vorder": 258,
    "position": 1,
    "text": "دگر هرچ آن داشت مرد جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 259,
    "position": 0,
    "text": "روانش ز مهبود بریان شدی"
  },
  {
    "poem_id": 1825,
    "vorder": 260,
    "position": 1,
    "text": "شب تیره تا روز گریان بدی"
  },
  {
    "poem_id": 1825,
    "vorder": 261,
    "position": 0,
    "text": "ز یزدان همی‌خواستی زینهار"
  },
  {
    "poem_id": 1825,
    "vorder": 262,
    "position": 1,
    "text": "همی‌ریختی خون دل برکنار"
  },
  {
    "poem_id": 1825,
    "vorder": 263,
    "position": 0,
    "text": "به درویش بخشید بسیار چیز"
  },
  {
    "poem_id": 1825,
    "vorder": 264,
    "position": 1,
    "text": "زبانی پر از آفرین داشت نیز"
  },
  {
    "poem_id": 1825,
    "vorder": 265,
    "position": 0,
    "text": "که یزدان گناهش ببخشد مگر"
  },
  {
    "poem_id": 1825,
    "vorder": 266,
    "position": 1,
    "text": "ستمگر نخواند ورا دادگر"
  },
  {
    "poem_id": 1825,
    "vorder": 267,
    "position": 0,
    "text": "کسی کو بود پاک و یزدان پرست"
  },
  {
    "poem_id": 1825,
    "vorder": 268,
    "position": 1,
    "text": "نیازد به کردار بد هیچ دست"
  },
  {
    "poem_id": 1825,
    "vorder": 269,
    "position": 0,
    "text": "که گرچند بد کردن آسان بود"
  },
  {
    "poem_id": 1825,
    "vorder": 270,
    "position": 1,
    "text": "به فرجام زو جان هراسان بود"
  },
  {
    "poem_id": 1825,
    "vorder": 271,
    "position": 0,
    "text": "اگر بد دل سنگ خارا شود"
  },
  {
    "poem_id": 1825,
    "vorder": 272,
    "position": 1,
    "text": "نماند نهان آشکارا شود"
  },
  {
    "poem_id": 1825,
    "vorder": 273,
    "position": 0,
    "text": "وگر چند نرمست آواز تو"
  },
  {
    "poem_id": 1825,
    "vorder": 274,
    "position": 1,
    "text": "گشاده شود زو همه راز تو"
  },
  {
    "poem_id": 1825,
    "vorder": 275,
    "position": 0,
    "text": "ندارد نگه راز مردم زبان"
  },
  {
    "poem_id": 1825,
    "vorder": 276,
    "position": 1,
    "text": "همان به که نیکی کنی درجهان"
  },
  {
    "poem_id": 1825,
    "vorder": 277,
    "position": 0,
    "text": "چو بیرنج باشی و پاکیزه‌رای"
  },
  {
    "poem_id": 1825,
    "vorder": 278,
    "position": 1,
    "text": "ازو بهره یابی به هر دو سرای"
  },
  {
    "poem_id": 1825,
    "vorder": 279,
    "position": 0,
    "text": "کنون کار زروان و مرد جهود"
  },
  {
    "poem_id": 1825,
    "vorder": 280,
    "position": 1,
    "text": "سرآمد خرد را بباید ستود"
  },
  {
    "poem_id": 1825,
    "vorder": 281,
    "position": 0,
    "text": "اگر دادگر باشی و سرفراز"
  },
  {
    "poem_id": 1825,
    "vorder": 282,
    "position": 1,
    "text": "نمانی و نامت بماند دراز"
  },
  {
    "poem_id": 1825,
    "vorder": 283,
    "position": 0,
    "text": "تن خویش را شاه بیدادگر"
  },
  {
    "poem_id": 1825,
    "vorder": 284,
    "position": 1,
    "text": "جز از گور و نفرین نیارد به سر"
  },
  {
    "poem_id": 1825,
    "vorder": 285,
    "position": 0,
    "text": "اگر پیشه دارد دلت راستی"
  },
  {
    "poem_id": 1825,
    "vorder": 286,
    "position": 1,
    "text": "چنان دان که گیتی بیاراستی"
  },
  {
    "poem_id": 1825,
    "vorder": 287,
    "position": 0,
    "text": "چو خواهی ستایش پس ازمرگ تو"
  },
  {
    "poem_id": 1825,
    "vorder": 288,
    "position": 1,
    "text": "خرد باید این تاج و این ترگ تو"
  },
  {
    "poem_id": 1825,
    "vorder": 289,
    "position": 0,
    "text": "چنان کز پس مرگ نوشین‌روان"
  },
  {
    "poem_id": 1825,
    "vorder": 290,
    "position": 1,
    "text": "ز گفتار من داد او شد جوان"
  },
  {
    "poem_id": 1825,
    "vorder": 291,
    "position": 0,
    "text": "ازان پس که گیتی بدوگشت راست"
  },
  {
    "poem_id": 1825,
    "vorder": 292,
    "position": 1,
    "text": "جز از آفرین در بزرگی نخواست"
  },
  {
    "poem_id": 1825,
    "vorder": 293,
    "position": 0,
    "text": "بخفتند در دشت خرد و بزرگ"
  },
  {
    "poem_id": 1825,
    "vorder": 294,
    "position": 1,
    "text": "به آبشخور آمد همی میش وگرگ"
  },
  {
    "poem_id": 1825,
    "vorder": 295,
    "position": 0,
    "text": "مهان کهتری را بیاراستند"
  },
  {
    "poem_id": 1825,
    "vorder": 296,
    "position": 1,
    "text": "به دیهیم بر نام او خواستند"
  },
  {
    "poem_id": 1825,
    "vorder": 297,
    "position": 0,
    "text": "بیاسود گردن ز بند زره"
  },
  {
    "poem_id": 1825,
    "vorder": 298,
    "position": 1,
    "text": "ز جوشن گشادند گردان گره"
  },
  {
    "poem_id": 1825,
    "vorder": 299,
    "position": 0,
    "text": "ز کوپال وخنجر بیاسود دوش"
  },
  {
    "poem_id": 1825,
    "vorder": 300,
    "position": 1,
    "text": "جز آواز رامش نیامد به گوش"
  },
  {
    "poem_id": 1825,
    "vorder": 301,
    "position": 0,
    "text": "کسی را نبد با جهاندار تاو"
  },
  {
    "poem_id": 1825,
    "vorder": 302,
    "position": 1,
    "text": "بپیوست با هرکسی باژ و ساو"
  },
  {
    "poem_id": 1825,
    "vorder": 303,
    "position": 0,
    "text": "جهاندار دشواری آسان گرفت"
  },
  {
    "poem_id": 1825,
    "vorder": 304,
    "position": 1,
    "text": "همه ساز نخچیر و میدان گرفت"
  },
  {
    "poem_id": 1825,
    "vorder": 305,
    "position": 0,
    "text": "نشست اندر ایوان گوهرنگار"
  },
  {
    "poem_id": 1825,
    "vorder": 306,
    "position": 1,
    "text": "همی رای زد با می ومیگسار"
  },
  {
    "poem_id": 1825,
    "vorder": 307,
    "position": 0,
    "text": "یکی شارستان کرد به آیین روم"
  },
  {
    "poem_id": 1825,
    "vorder": 308,
    "position": 1,
    "text": "فزون از دو فرسنگ بالای بوم"
  },
  {
    "poem_id": 1825,
    "vorder": 309,
    "position": 0,
    "text": "بدو اندرون کاخ و ایوان و باغ"
  },
  {
    "poem_id": 1825,
    "vorder": 310,
    "position": 1,
    "text": "به یک دست رود و به یک دست راغ"
  },
  {
    "poem_id": 1825,
    "vorder": 311,
    "position": 0,
    "text": "چنان بد بروم اندرون پادشهر"
  },
  {
    "poem_id": 1825,
    "vorder": 312,
    "position": 1,
    "text": "که کسری بپیمود و برداشت بهر"
  },
  {
    "poem_id": 1825,
    "vorder": 313,
    "position": 0,
    "text": "برآورد زو کاخهای بلند"
  },
  {
    "poem_id": 1825,
    "vorder": 314,
    "position": 1,
    "text": "نبد نزد کس درجهان ناپسند"
  },
  {
    "poem_id": 1825,
    "vorder": 315,
    "position": 0,
    "text": "یکی کاخ کرد اندران شهریار"
  },
  {
    "poem_id": 1825,
    "vorder": 316,
    "position": 1,
    "text": "بدو اندر ایوان گوهرنگار"
  },
  {
    "poem_id": 1825,
    "vorder": 317,
    "position": 0,
    "text": "همه شوشهٔ طاقها سیم و زر"
  },
  {
    "poem_id": 1825,
    "vorder": 318,
    "position": 1,
    "text": "بزر اندرون چند گونه گهر"
  },
  {
    "poem_id": 1825,
    "vorder": 319,
    "position": 0,
    "text": "یکی گنبد از آبنوس وز عاج"
  },
  {
    "poem_id": 1825,
    "vorder": 320,
    "position": 1,
    "text": "به پیکر ز پیلسته و شیز و ساج"
  },
  {
    "poem_id": 1825,
    "vorder": 321,
    "position": 0,
    "text": "ز روم وز هند آنک استاد بود"
  },
  {
    "poem_id": 1825,
    "vorder": 322,
    "position": 1,
    "text": "وز استاد خویشش هنر یاد بود"
  },
  {
    "poem_id": 1825,
    "vorder": 323,
    "position": 0,
    "text": "ز ایران وز کشور نیمروز"
  },
  {
    "poem_id": 1825,
    "vorder": 324,
    "position": 1,
    "text": "همه کارداران گیتی‌فروز"
  },
  {
    "poem_id": 1825,
    "vorder": 325,
    "position": 0,
    "text": "همه گرد کرد اندران شارستان"
  },
  {
    "poem_id": 1825,
    "vorder": 326,
    "position": 1,
    "text": "که هم شارستان بود و هم کارستان"
  },
  {
    "poem_id": 1825,
    "vorder": 327,
    "position": 0,
    "text": "اسیران که از بربر آورده بود"
  },
  {
    "poem_id": 1825,
    "vorder": 328,
    "position": 1,
    "text": "ز روم وز هر جای کازرده بود"
  },
  {
    "poem_id": 1825,
    "vorder": 329,
    "position": 0,
    "text": "وزین هر یکی را یکی خانه کرد"
  },
  {
    "poem_id": 1825,
    "vorder": 330,
    "position": 1,
    "text": "همه شارستان جای بیگانه کرد"
  },
  {
    "poem_id": 1825,
    "vorder": 331,
    "position": 0,
    "text": "چو از شهر یک سر بپرداختند"
  },
  {
    "poem_id": 1825,
    "vorder": 332,
    "position": 1,
    "text": "بگرد اندرش روستا ساختند"
  },
  {
    "poem_id": 1825,
    "vorder": 333,
    "position": 0,
    "text": "بیاراست بر هر سویی کشتزار"
  },
  {
    "poem_id": 1825,
    "vorder": 334,
    "position": 1,
    "text": "زمین برومند و هم میوه دار"
  },
  {
    "poem_id": 1825,
    "vorder": 335,
    "position": 0,
    "text": "ازین هریکی را یکی کار داد"
  },
  {
    "poem_id": 1825,
    "vorder": 336,
    "position": 1,
    "text": "چوتنها بد از کارگر یار داد"
  },
  {
    "poem_id": 1825,
    "vorder": 337,
    "position": 0,
    "text": "یکی پیشه کار و دگر کشت ورز"
  },
  {
    "poem_id": 1825,
    "vorder": 338,
    "position": 1,
    "text": "یکی آنک پیمود فرسنگ و مرز"
  },
  {
    "poem_id": 1825,
    "vorder": 339,
    "position": 0,
    "text": "چه بازارگان و چه یزدان‌پرست"
  },
  {
    "poem_id": 1825,
    "vorder": 340,
    "position": 1,
    "text": "یکی سرفراز و دگر زیردست"
  },
  {
    "poem_id": 1825,
    "vorder": 341,
    "position": 0,
    "text": "بیاراست آن شارستان چون بهشت"
  },
  {
    "poem_id": 1825,
    "vorder": 342,
    "position": 1,
    "text": "ندید اندرو چشم یک جای زشت"
  },
  {
    "poem_id": 1825,
    "vorder": 343,
    "position": 0,
    "text": "ورا سورستان کرد کسری به نام"
  },
  {
    "poem_id": 1825,
    "vorder": 344,
    "position": 1,
    "text": "که درسور یابد جهاندار کام"
  },
  {
    "poem_id": 1825,
    "vorder": 345,
    "position": 0,
    "text": "جز از داد و آباد کردن جهان"
  },
  {
    "poem_id": 1825,
    "vorder": 346,
    "position": 1,
    "text": "نبودش به دل آشکار و نهان"
  },
  {
    "poem_id": 1825,
    "vorder": 347,
    "position": 0,
    "text": "زمانه چو او را ز شاهی ببرد"
  },
  {
    "poem_id": 1825,
    "vorder": 348,
    "position": 1,
    "text": "همه تاج دیگر کسی را سپرد"
  },
  {
    "poem_id": 1825,
    "vorder": 349,
    "position": 0,
    "text": "چنان دان که یک سر فریبست و بس"
  },
  {
    "poem_id": 1825,
    "vorder": 350,
    "position": 1,
    "text": "بلندی وپستی نماند بکس"
  },
  {
    "poem_id": 1825,
    "vorder": 351,
    "position": 0,
    "text": "کنون جنگ خاقان و هیتال گیر"
  },
  {
    "poem_id": 1825,
    "vorder": 352,
    "position": 1,
    "text": "چو رزم آیدت پیش کوپال گیر"
  },
  {
    "poem_id": 1825,
    "vorder": 353,
    "position": 0,
    "text": "چه گوید سخنگوی باآفرین"
  },
  {
    "poem_id": 1825,
    "vorder": 354,
    "position": 1,
    "text": "ز شاه وز هیتال وخاقان چین"
  }
]