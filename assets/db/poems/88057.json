[
  {
    "poem_id": 88057,
    "vorder": 1,
    "position": 0,
    "text": "همه شب بنالید تا روز پاک"
  },
  {
    "poem_id": 88057,
    "vorder": 2,
    "position": 1,
    "text": "پر از درد چون مار پیچان به خاک"
  },
  {
    "poem_id": 88057,
    "vorder": 3,
    "position": 0,
    "text": "چو گیتی ز خورشید شد روشنا"
  },
  {
    "poem_id": 88057,
    "vorder": 4,
    "position": 1,
    "text": "بیامد بدان جایگه بیژنا"
  },
  {
    "poem_id": 88057,
    "vorder": 5,
    "position": 0,
    "text": "همی گشت بر گرد آن مرغزار"
  },
  {
    "poem_id": 88057,
    "vorder": 6,
    "position": 1,
    "text": "که یابد نشانی ز گم بوده یار"
  },
  {
    "poem_id": 88057,
    "vorder": 7,
    "position": 0,
    "text": "پدید آمد از دور اسب سمند"
  },
  {
    "poem_id": 88057,
    "vorder": 8,
    "position": 1,
    "text": "بدان مرغزار اندرون چون نوند"
  },
  {
    "poem_id": 88057,
    "vorder": 9,
    "position": 0,
    "text": "چمان و چران چون پلنگان به کام"
  },
  {
    "poem_id": 88057,
    "vorder": 10,
    "position": 1,
    "text": "نگون گشته زین و گسسته لگام"
  },
  {
    "poem_id": 88057,
    "vorder": 11,
    "position": 0,
    "text": "همه آلت زین بر او بر نگون"
  },
  {
    "poem_id": 88057,
    "vorder": 12,
    "position": 1,
    "text": "رکیب و کمند و جنا پر ز خون"
  },
  {
    "poem_id": 88057,
    "vorder": 13,
    "position": 0,
    "text": "چو بیژن بدید آن از او رفت هوش"
  },
  {
    "poem_id": 88057,
    "vorder": 14,
    "position": 1,
    "text": "برآورد چو شیر شرزه خروش"
  },
  {
    "poem_id": 88057,
    "vorder": 15,
    "position": 0,
    "text": "همی گفت کای مهربان نیک‌یار"
  },
  {
    "poem_id": 88057,
    "vorder": 16,
    "position": 1,
    "text": "کجایی فگنده در این مرغزار"
  },
  {
    "poem_id": 88057,
    "vorder": 17,
    "position": 0,
    "text": "که پشتم شکستی و خستی دلم"
  },
  {
    "poem_id": 88057,
    "vorder": 18,
    "position": 1,
    "text": "کنون جان شیرین ز تن بگسلم"
  },
  {
    "poem_id": 88057,
    "vorder": 19,
    "position": 0,
    "text": "بشد بر پی اسب بر چشمه‌سار"
  },
  {
    "poem_id": 88057,
    "vorder": 20,
    "position": 1,
    "text": "مر او را بدید اندر آن مزغزار"
  },
  {
    "poem_id": 88057,
    "vorder": 21,
    "position": 0,
    "text": "همه جوشن و ترگ پر خاک و خون"
  },
  {
    "poem_id": 88057,
    "vorder": 22,
    "position": 1,
    "text": "فتاده بدان خستگی سرنگون"
  },
  {
    "poem_id": 88057,
    "vorder": 23,
    "position": 0,
    "text": "فروجست بیژن ز شبرنگ زود"
  },
  {
    "poem_id": 88057,
    "vorder": 24,
    "position": 1,
    "text": "گرفتش به آغوش در تنگ زود"
  },
  {
    "poem_id": 88057,
    "vorder": 25,
    "position": 0,
    "text": "برون کرد رومی قبا از برش"
  },
  {
    "poem_id": 88057,
    "vorder": 26,
    "position": 1,
    "text": "برهنه شد از ترگ خسته سرش"
  },
  {
    "poem_id": 88057,
    "vorder": 27,
    "position": 0,
    "text": "ز بس خون دویدن تنش بود زرد"
  },
  {
    "poem_id": 88057,
    "vorder": 28,
    "position": 1,
    "text": "دلش پر ز تیمار و جان پر ز درد"
  },
  {
    "poem_id": 88057,
    "vorder": 29,
    "position": 0,
    "text": "بر آن خستگیهاش بنهاد روی"
  },
  {
    "poem_id": 88057,
    "vorder": 30,
    "position": 1,
    "text": "همی بود زاری کنان پیش اوی"
  },
  {
    "poem_id": 88057,
    "vorder": 31,
    "position": 0,
    "text": "همی گفت کای نیک دل یار من"
  },
  {
    "poem_id": 88057,
    "vorder": 32,
    "position": 1,
    "text": "تو رفتی و این بود پیکار من"
  },
  {
    "poem_id": 88057,
    "vorder": 33,
    "position": 0,
    "text": "شتابم کنون بیش بایست کرد"
  },
  {
    "poem_id": 88057,
    "vorder": 34,
    "position": 1,
    "text": "رسیدن بر تو به جای نبرد"
  },
  {
    "poem_id": 88057,
    "vorder": 35,
    "position": 0,
    "text": "مگر بودمی گاه سختیت یار"
  },
  {
    "poem_id": 88057,
    "vorder": 36,
    "position": 1,
    "text": "چو با اهرمن ساختی کارزار"
  },
  {
    "poem_id": 88057,
    "vorder": 37,
    "position": 0,
    "text": "کنون کام دشمن همه راست کرد"
  },
  {
    "poem_id": 88057,
    "vorder": 38,
    "position": 1,
    "text": "برآورد سر هرچ می‌خواست کرد"
  },
  {
    "poem_id": 88057,
    "vorder": 39,
    "position": 0,
    "text": "بگفت این سخن بیژن و گستهم"
  },
  {
    "poem_id": 88057,
    "vorder": 40,
    "position": 1,
    "text": "بجنبید و بر زد یکی تیز دم"
  },
  {
    "poem_id": 88057,
    "vorder": 41,
    "position": 0,
    "text": "به بیژن چنین گفت کای نیک خواه"
  },
  {
    "poem_id": 88057,
    "vorder": 42,
    "position": 1,
    "text": "مکن خویشتن پیش من در تباه"
  },
  {
    "poem_id": 88057,
    "vorder": 43,
    "position": 0,
    "text": "مرا درد تو بتر از مرگ خویش"
  },
  {
    "poem_id": 88057,
    "vorder": 44,
    "position": 1,
    "text": "بنه بر سر خسته بر ترگ خویش"
  },
  {
    "poem_id": 88057,
    "vorder": 45,
    "position": 0,
    "text": "یکی چاره کن تا از این جایگاه"
  },
  {
    "poem_id": 88057,
    "vorder": 46,
    "position": 1,
    "text": "توانی رسانیدنم نزد شاه"
  },
  {
    "poem_id": 88057,
    "vorder": 47,
    "position": 0,
    "text": "مرا باد چندان همی روزگار"
  },
  {
    "poem_id": 88057,
    "vorder": 48,
    "position": 1,
    "text": "که بینم یکی چهرهٔ شهریار"
  },
  {
    "poem_id": 88057,
    "vorder": 49,
    "position": 0,
    "text": "از آن پس چو مرگ آیدم باک نیست"
  },
  {
    "poem_id": 88057,
    "vorder": 50,
    "position": 1,
    "text": "مرا خود نهالی به جز خاک نیست"
  },
  {
    "poem_id": 88057,
    "vorder": 51,
    "position": 0,
    "text": "نمرده است هرکس که با کام خویش"
  },
  {
    "poem_id": 88057,
    "vorder": 52,
    "position": 1,
    "text": "بمیرد بیابد سرانجام خویش"
  },
  {
    "poem_id": 88057,
    "vorder": 53,
    "position": 0,
    "text": "و دیگر دو بد خواه با ترس و باک"
  },
  {
    "poem_id": 88057,
    "vorder": 54,
    "position": 1,
    "text": "که بر دست من کرد یزدان هلاک"
  },
  {
    "poem_id": 88057,
    "vorder": 55,
    "position": 0,
    "text": "مگرشان به زین بر توانی کشید"
  },
  {
    "poem_id": 88057,
    "vorder": 56,
    "position": 1,
    "text": "وگرنه سرانشان ز تن ها برید"
  },
  {
    "poem_id": 88057,
    "vorder": 57,
    "position": 0,
    "text": "سلیح و سر نامبردارشان"
  },
  {
    "poem_id": 88057,
    "vorder": 58,
    "position": 1,
    "text": "ببر تا بدانند پیکارشان"
  },
  {
    "poem_id": 88057,
    "vorder": 59,
    "position": 0,
    "text": "کنی نزد شاه جهاندار یاد"
  },
  {
    "poem_id": 88057,
    "vorder": 60,
    "position": 1,
    "text": "که من سر به خیره ندادم به باد"
  },
  {
    "poem_id": 88057,
    "vorder": 61,
    "position": 0,
    "text": "بسودم به هر جای با بخت جنگ"
  },
  {
    "poem_id": 88057,
    "vorder": 62,
    "position": 1,
    "text": "گهٔ نام جستن نمردم به ننگ"
  },
  {
    "poem_id": 88057,
    "vorder": 63,
    "position": 0,
    "text": "به بیژن نمود آنگهی هر دو تور"
  },
  {
    "poem_id": 88057,
    "vorder": 64,
    "position": 1,
    "text": "که بودند کشته فگنده به دور"
  },
  {
    "poem_id": 88057,
    "vorder": 65,
    "position": 0,
    "text": "بگفت این و سستی گرفتش روان"
  },
  {
    "poem_id": 88057,
    "vorder": 66,
    "position": 1,
    "text": "همی بود بیژن به سر بر نوان"
  },
  {
    "poem_id": 88057,
    "vorder": 67,
    "position": 0,
    "text": "وز آن جایگه اسب او بیدرنگ"
  },
  {
    "poem_id": 88057,
    "vorder": 68,
    "position": 1,
    "text": "بیاورد و بگشاد از باره تنگ"
  },
  {
    "poem_id": 88057,
    "vorder": 69,
    "position": 0,
    "text": "نمد زین به زیر تن خفته مرد"
  },
  {
    "poem_id": 88057,
    "vorder": 70,
    "position": 1,
    "text": "بیفگند و نالید چندی به درد"
  },
  {
    "poem_id": 88057,
    "vorder": 71,
    "position": 0,
    "text": "همه دامن قرطه را کرد چاک"
  },
  {
    "poem_id": 88057,
    "vorder": 72,
    "position": 1,
    "text": "ابر خستگیهاش بر بست پاک"
  },
  {
    "poem_id": 88057,
    "vorder": 73,
    "position": 0,
    "text": "وز آن جایگه سوی بالا دوان"
  },
  {
    "poem_id": 88057,
    "vorder": 74,
    "position": 1,
    "text": "بیامد ز غم تیره کرده روان"
  },
  {
    "poem_id": 88057,
    "vorder": 75,
    "position": 0,
    "text": "سواران ترکان پراگنده دید"
  },
  {
    "poem_id": 88057,
    "vorder": 76,
    "position": 1,
    "text": "که آمد ز راه بیابان پدید"
  },
  {
    "poem_id": 88057,
    "vorder": 77,
    "position": 0,
    "text": "ز بالا چو برق اندر آمد به شیب"
  },
  {
    "poem_id": 88057,
    "vorder": 78,
    "position": 1,
    "text": "دل از مردن گستهم با نهیب"
  },
  {
    "poem_id": 88057,
    "vorder": 79,
    "position": 0,
    "text": "از آن بیم دیده سواران دو تن"
  },
  {
    "poem_id": 88057,
    "vorder": 80,
    "position": 1,
    "text": "به شمشیر کم کرد زان انجمن"
  },
  {
    "poem_id": 88057,
    "vorder": 81,
    "position": 0,
    "text": "ز فتراک بگشاد زان پس کمند"
  },
  {
    "poem_id": 88057,
    "vorder": 82,
    "position": 1,
    "text": "ز ترکان یکی را به گردن فگند"
  },
  {
    "poem_id": 88057,
    "vorder": 83,
    "position": 0,
    "text": "ز اسب اندر آورد و زنهار داد"
  },
  {
    "poem_id": 88057,
    "vorder": 84,
    "position": 1,
    "text": "بدان کار با خویشتن یار داد"
  },
  {
    "poem_id": 88057,
    "vorder": 85,
    "position": 0,
    "text": "وز آنجا بیامد به کردار گرد"
  },
  {
    "poem_id": 88057,
    "vorder": 86,
    "position": 1,
    "text": "دمان سوی لهاک و فرشیدورد"
  },
  {
    "poem_id": 88057,
    "vorder": 87,
    "position": 0,
    "text": "بدید آن سران سپه را نگون"
  },
  {
    "poem_id": 88057,
    "vorder": 88,
    "position": 1,
    "text": "فگنده بر آن خاک غرقه به خون"
  },
  {
    "poem_id": 88057,
    "vorder": 89,
    "position": 0,
    "text": "به سرشان بر اسبان جنگی به پای"
  },
  {
    "poem_id": 88057,
    "vorder": 90,
    "position": 1,
    "text": "چراگاه سازید و جای چرای"
  },
  {
    "poem_id": 88057,
    "vorder": 91,
    "position": 0,
    "text": "چو بیژن چنان دید کرد آفرین"
  },
  {
    "poem_id": 88057,
    "vorder": 92,
    "position": 1,
    "text": "ابر گستهم کو سرآورد کین"
  },
  {
    "poem_id": 88057,
    "vorder": 93,
    "position": 0,
    "text": "بفرمود تا ترک زنهار خواه"
  },
  {
    "poem_id": 88057,
    "vorder": 94,
    "position": 1,
    "text": "به زین برکشید آن سران را ز راه"
  },
  {
    "poem_id": 88057,
    "vorder": 95,
    "position": 0,
    "text": "ببستندشان دست و پای و میان"
  },
  {
    "poem_id": 88057,
    "vorder": 96,
    "position": 1,
    "text": "کشیدند بر پشت زین کیان"
  },
  {
    "poem_id": 88057,
    "vorder": 97,
    "position": 0,
    "text": "وز آنجا سوی گستهم تازیان"
  },
  {
    "poem_id": 88057,
    "vorder": 98,
    "position": 1,
    "text": "بیامد به سان پلنگ ژیان"
  },
  {
    "poem_id": 88057,
    "vorder": 99,
    "position": 0,
    "text": "فرود آمد از اسب و او را چو باد"
  },
  {
    "poem_id": 88057,
    "vorder": 100,
    "position": 1,
    "text": "بی آزار نرم از بر زین نهاد"
  },
  {
    "poem_id": 88057,
    "vorder": 101,
    "position": 0,
    "text": "بدان ترک فرمود تا برنشست"
  },
  {
    "poem_id": 88057,
    "vorder": 102,
    "position": 1,
    "text": "به آغوش او اندر آورد دست"
  },
  {
    "poem_id": 88057,
    "vorder": 103,
    "position": 0,
    "text": "سمند نوندش همی راند نرم"
  },
  {
    "poem_id": 88057,
    "vorder": 104,
    "position": 1,
    "text": "بر او بر همی آفرین خواند گرم"
  },
  {
    "poem_id": 88057,
    "vorder": 105,
    "position": 0,
    "text": "مگر زنده او را بر شهریار"
  },
  {
    "poem_id": 88057,
    "vorder": 106,
    "position": 1,
    "text": "تواند رسانیدن از کارزار"
  },
  {
    "poem_id": 88057,
    "vorder": 107,
    "position": 0,
    "text": "همی راند بیژن پر از درد و غم"
  },
  {
    "poem_id": 88057,
    "vorder": 108,
    "position": 1,
    "text": "روانش پر از انده گستهم"
  }
]