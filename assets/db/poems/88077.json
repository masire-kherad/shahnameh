[
  {
    "poem_id": 88077,
    "vorder": 1,
    "position": 0,
    "text": "به ره کنده پیش و پس اندر سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 2,
    "position": 1,
    "text": "پس کنده با لشکر و پیل شاه"
  },
  {
    "poem_id": 88077,
    "vorder": 3,
    "position": 0,
    "text": "سپهدار ترکان چو شب در شکست"
  },
  {
    "poem_id": 88077,
    "vorder": 4,
    "position": 1,
    "text": "میان با سپه تاختن را ببست"
  },
  {
    "poem_id": 88077,
    "vorder": 5,
    "position": 0,
    "text": "ز لشکر جهاندیدگان را بخواند"
  },
  {
    "poem_id": 88077,
    "vorder": 6,
    "position": 1,
    "text": "ز کار گذشته فراوان براند"
  },
  {
    "poem_id": 88077,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت کاین شوم پر کیمیا"
  },
  {
    "poem_id": 88077,
    "vorder": 8,
    "position": 1,
    "text": "چنین خیره شد بر سپاه نیا"
  },
  {
    "poem_id": 88077,
    "vorder": 9,
    "position": 0,
    "text": "کنون جمله ایرانیان خفته‌اند"
  },
  {
    "poem_id": 88077,
    "vorder": 10,
    "position": 1,
    "text": "همه لشکر ما برآشفته‌اند"
  },
  {
    "poem_id": 88077,
    "vorder": 11,
    "position": 0,
    "text": "کنون ما ز دل بیم بیرون کنیم"
  },
  {
    "poem_id": 88077,
    "vorder": 12,
    "position": 1,
    "text": "سحرگه بر ایشان شبیخون کنیم"
  },
  {
    "poem_id": 88077,
    "vorder": 13,
    "position": 0,
    "text": "گر امشب بر ایشان بیابیم دست"
  },
  {
    "poem_id": 88077,
    "vorder": 14,
    "position": 1,
    "text": "به بیشی ابر تخت باید نشست"
  },
  {
    "poem_id": 88077,
    "vorder": 15,
    "position": 0,
    "text": "وگر بختمان بر نگیرد فروغ"
  },
  {
    "poem_id": 88077,
    "vorder": 16,
    "position": 1,
    "text": "همه چاره بادست و مردی دروغ"
  },
  {
    "poem_id": 88077,
    "vorder": 17,
    "position": 0,
    "text": "بر این برنهادند و برخاستند"
  },
  {
    "poem_id": 88077,
    "vorder": 18,
    "position": 1,
    "text": "ز بهر شبیخون بیاراستند"
  },
  {
    "poem_id": 88077,
    "vorder": 19,
    "position": 0,
    "text": "ز لشکر گزین کرد پنجه هزار"
  },
  {
    "poem_id": 88077,
    "vorder": 20,
    "position": 1,
    "text": "جهاندیده مردان خنجرگزار"
  },
  {
    "poem_id": 88077,
    "vorder": 21,
    "position": 0,
    "text": "برفتند کارآگهان پیش شاه"
  },
  {
    "poem_id": 88077,
    "vorder": 22,
    "position": 1,
    "text": "جهاندیده مردان با فر و جاه"
  },
  {
    "poem_id": 88077,
    "vorder": 23,
    "position": 0,
    "text": "ز کارآگهان آن که بد رهنمای"
  },
  {
    "poem_id": 88077,
    "vorder": 24,
    "position": 1,
    "text": "بیامد به نزدیک پرده سرای"
  },
  {
    "poem_id": 88077,
    "vorder": 25,
    "position": 0,
    "text": "به جایی غو پاسبانان ندید"
  },
  {
    "poem_id": 88077,
    "vorder": 26,
    "position": 1,
    "text": "تو گفتی جهان سر به سر آرمید"
  },
  {
    "poem_id": 88077,
    "vorder": 27,
    "position": 0,
    "text": "طلایه نه و آتش و باد نه"
  },
  {
    "poem_id": 88077,
    "vorder": 28,
    "position": 1,
    "text": "ز توران کسی را به دل یاد نه"
  },
  {
    "poem_id": 88077,
    "vorder": 29,
    "position": 0,
    "text": "چو آن دید برگشت و آمد دوان"
  },
  {
    "poem_id": 88077,
    "vorder": 30,
    "position": 1,
    "text": "کز ایشان کسی نیست روشن‌روان"
  },
  {
    "poem_id": 88077,
    "vorder": 31,
    "position": 0,
    "text": "همه خفتگان سر به سر مرده‌اند"
  },
  {
    "poem_id": 88077,
    "vorder": 32,
    "position": 1,
    "text": "وگر نه همه روز می خورده‌اند"
  },
  {
    "poem_id": 88077,
    "vorder": 33,
    "position": 0,
    "text": "به جایی طلایه پدیدار نیست"
  },
  {
    "poem_id": 88077,
    "vorder": 34,
    "position": 1,
    "text": "کس آن خفتگان را نگهدار نیست"
  },
  {
    "poem_id": 88077,
    "vorder": 35,
    "position": 0,
    "text": "چو افراسیاب این سخنها شنود"
  },
  {
    "poem_id": 88077,
    "vorder": 36,
    "position": 1,
    "text": "به دلش اندرون روشنایی فزود"
  },
  {
    "poem_id": 88077,
    "vorder": 37,
    "position": 0,
    "text": "سپه را فرستاد و خود برنشست"
  },
  {
    "poem_id": 88077,
    "vorder": 38,
    "position": 1,
    "text": "میان یلی تاختن را ببست"
  },
  {
    "poem_id": 88077,
    "vorder": 39,
    "position": 0,
    "text": "برفتند گردان چو دریای آب"
  },
  {
    "poem_id": 88077,
    "vorder": 40,
    "position": 1,
    "text": "گرفتند بر تاختن بر شتاب"
  },
  {
    "poem_id": 88077,
    "vorder": 41,
    "position": 0,
    "text": "بر آن تاختن جنبش و ساز نه"
  },
  {
    "poem_id": 88077,
    "vorder": 42,
    "position": 1,
    "text": "همان نالهٔ بوق و آواز نه"
  },
  {
    "poem_id": 88077,
    "vorder": 43,
    "position": 0,
    "text": "چو رفتند نزدیک پرده سرای"
  },
  {
    "poem_id": 88077,
    "vorder": 44,
    "position": 1,
    "text": "برآمد خروشیدن کرنای"
  },
  {
    "poem_id": 88077,
    "vorder": 45,
    "position": 0,
    "text": "غو طبل بر کوهه زین بخاست"
  },
  {
    "poem_id": 88077,
    "vorder": 46,
    "position": 1,
    "text": "درفش سیه را برآورد راست"
  },
  {
    "poem_id": 88077,
    "vorder": 47,
    "position": 0,
    "text": "ز لشکر هر آن کس که بد پیشرو"
  },
  {
    "poem_id": 88077,
    "vorder": 48,
    "position": 1,
    "text": "برانگیختند اسب و برخاست غو"
  },
  {
    "poem_id": 88077,
    "vorder": 49,
    "position": 0,
    "text": "به کنده در افتاد چندی سوار"
  },
  {
    "poem_id": 88077,
    "vorder": 50,
    "position": 1,
    "text": "بپیچید دیگر سر از کارزار"
  },
  {
    "poem_id": 88077,
    "vorder": 51,
    "position": 0,
    "text": "ز یک دست رستم برآمد ز دشت"
  },
  {
    "poem_id": 88077,
    "vorder": 52,
    "position": 1,
    "text": "ز گرد سواران هوا تیره گشت"
  },
  {
    "poem_id": 88077,
    "vorder": 53,
    "position": 0,
    "text": "ز دست دگر گیو گودرز و طوس"
  },
  {
    "poem_id": 88077,
    "vorder": 54,
    "position": 1,
    "text": "به پیش اندرون نالهٔ بوق و کوس"
  },
  {
    "poem_id": 88077,
    "vorder": 55,
    "position": 0,
    "text": "شهنشاه با کاویانی درفش"
  },
  {
    "poem_id": 88077,
    "vorder": 56,
    "position": 1,
    "text": "هوا شد ز تیغ سواران بنفش"
  },
  {
    "poem_id": 88077,
    "vorder": 57,
    "position": 0,
    "text": "برآمد ده و گیر و بر بند و کش"
  },
  {
    "poem_id": 88077,
    "vorder": 58,
    "position": 1,
    "text": "نه با اسب تاب و نه با مرد هش"
  },
  {
    "poem_id": 88077,
    "vorder": 59,
    "position": 0,
    "text": "از ایشان ز صد نامور ده بماند"
  },
  {
    "poem_id": 88077,
    "vorder": 60,
    "position": 1,
    "text": "کسی را که بد اختر بد براند"
  },
  {
    "poem_id": 88077,
    "vorder": 61,
    "position": 0,
    "text": "چو آگاهی آمد بر این رزمگاه"
  },
  {
    "poem_id": 88077,
    "vorder": 62,
    "position": 1,
    "text": "چنان خسته بد شاه توران سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 63,
    "position": 0,
    "text": "که از خستگی جمله گریان شدند"
  },
  {
    "poem_id": 88077,
    "vorder": 64,
    "position": 1,
    "text": "ز درد دل شاه بریان شدند"
  },
  {
    "poem_id": 88077,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت کز گردش آسمان"
  },
  {
    "poem_id": 88077,
    "vorder": 66,
    "position": 1,
    "text": "نیابد گذر دانشی بی‌گمان"
  },
  {
    "poem_id": 88077,
    "vorder": 67,
    "position": 0,
    "text": "چو دشمن همی جان بسیچد نه چیز"
  },
  {
    "poem_id": 88077,
    "vorder": 68,
    "position": 1,
    "text": "بکوشیم ناچار یک دست نیز"
  },
  {
    "poem_id": 88077,
    "vorder": 69,
    "position": 0,
    "text": "اگر سر به سر تن به کشتن دهیم"
  },
  {
    "poem_id": 88077,
    "vorder": 70,
    "position": 1,
    "text": "وگر ایرجی تاج بر سر نهیم"
  },
  {
    "poem_id": 88077,
    "vorder": 71,
    "position": 0,
    "text": "برآمد خروش از دو پرده‌سرای"
  },
  {
    "poem_id": 88077,
    "vorder": 72,
    "position": 1,
    "text": "جهان پر شد از نالهٔ کرنای"
  },
  {
    "poem_id": 88077,
    "vorder": 73,
    "position": 0,
    "text": "گرفتند ژوپین و خنجر به کف"
  },
  {
    "poem_id": 88077,
    "vorder": 74,
    "position": 1,
    "text": "کشیدند لشکر سه فرسنگ صف"
  },
  {
    "poem_id": 88077,
    "vorder": 75,
    "position": 0,
    "text": "به کردار دریا شد آن رزمگاه"
  },
  {
    "poem_id": 88077,
    "vorder": 76,
    "position": 1,
    "text": "نه خورشید تابنده روشن نه ماه"
  },
  {
    "poem_id": 88077,
    "vorder": 77,
    "position": 0,
    "text": "سپاه اندر آمد همی فوج فوج"
  },
  {
    "poem_id": 88077,
    "vorder": 78,
    "position": 1,
    "text": "بر آن سان که برخیزد از باد موج"
  },
  {
    "poem_id": 88077,
    "vorder": 79,
    "position": 0,
    "text": "در و دشت گفتی همه خون شدست"
  },
  {
    "poem_id": 88077,
    "vorder": 80,
    "position": 1,
    "text": "خور از چرخ گردنده بیرون شدست"
  },
  {
    "poem_id": 88077,
    "vorder": 81,
    "position": 0,
    "text": "کسی را نبد بر تن خویش مهر"
  },
  {
    "poem_id": 88077,
    "vorder": 82,
    "position": 1,
    "text": "به قیر اندر اندود گفتی سپهر"
  },
  {
    "poem_id": 88077,
    "vorder": 83,
    "position": 0,
    "text": "همانگه برآمد یکی تیره باد"
  },
  {
    "poem_id": 88077,
    "vorder": 84,
    "position": 1,
    "text": "که هرگز ندارد کسی آن به یاد"
  },
  {
    "poem_id": 88077,
    "vorder": 85,
    "position": 0,
    "text": "همی خاک برداشت از رزمگاه"
  },
  {
    "poem_id": 88077,
    "vorder": 86,
    "position": 1,
    "text": "بزد بر سر و چشم توران سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 87,
    "position": 0,
    "text": "ز سرها همی ترگها برگرفت"
  },
  {
    "poem_id": 88077,
    "vorder": 88,
    "position": 1,
    "text": "بماند اندر آن شاه ترکان شگفت"
  },
  {
    "poem_id": 88077,
    "vorder": 89,
    "position": 0,
    "text": "همه دشت مغز سر و خون گرفت"
  },
  {
    "poem_id": 88077,
    "vorder": 90,
    "position": 1,
    "text": "دل سنگ رنگ طبر خون گرفت"
  },
  {
    "poem_id": 88077,
    "vorder": 91,
    "position": 0,
    "text": "سواران توران که روز درنگ"
  },
  {
    "poem_id": 88077,
    "vorder": 92,
    "position": 1,
    "text": "زبون داشتندی شکار پلنگ"
  },
  {
    "poem_id": 88077,
    "vorder": 93,
    "position": 0,
    "text": "ندیدند با چرخ گردان نبرد"
  },
  {
    "poem_id": 88077,
    "vorder": 94,
    "position": 1,
    "text": "همی خاک برداشت از دشت مرد"
  },
  {
    "poem_id": 88077,
    "vorder": 95,
    "position": 0,
    "text": "چو کیخسرو آن خاک و آن باد دید"
  },
  {
    "poem_id": 88077,
    "vorder": 96,
    "position": 1,
    "text": "دل و بخت ایرانیان شاد دید"
  },
  {
    "poem_id": 88077,
    "vorder": 97,
    "position": 0,
    "text": "ابا رستم و گیو گودرز و طوس"
  },
  {
    "poem_id": 88077,
    "vorder": 98,
    "position": 1,
    "text": "ز پشت سپاه اندر آورد کوس"
  },
  {
    "poem_id": 88077,
    "vorder": 99,
    "position": 0,
    "text": "دهاده برآمد ز قلب سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 100,
    "position": 1,
    "text": "ز یک دست رستم ز یک دست شاه"
  },
  {
    "poem_id": 88077,
    "vorder": 101,
    "position": 0,
    "text": "شد اندر هوا گرد بر سان میغ"
  },
  {
    "poem_id": 88077,
    "vorder": 102,
    "position": 1,
    "text": "چه میغی که باران او تیر و تیغ"
  },
  {
    "poem_id": 88077,
    "vorder": 103,
    "position": 0,
    "text": "تلی کشته هر جای چون کوه کوه"
  },
  {
    "poem_id": 88077,
    "vorder": 104,
    "position": 1,
    "text": "زمین گشته از خون ایشان ستوه"
  },
  {
    "poem_id": 88077,
    "vorder": 105,
    "position": 0,
    "text": "هوا گشت چون چادر نیلگون"
  },
  {
    "poem_id": 88077,
    "vorder": 106,
    "position": 1,
    "text": "زمین شد به کردار دریای خون"
  },
  {
    "poem_id": 88077,
    "vorder": 107,
    "position": 0,
    "text": "ز تیر آسمان شد چو پر عقاب"
  },
  {
    "poem_id": 88077,
    "vorder": 108,
    "position": 1,
    "text": "نگه کرد خیره سر افراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 109,
    "position": 0,
    "text": "بدید آن درفشان درفش بنفش"
  },
  {
    "poem_id": 88077,
    "vorder": 110,
    "position": 1,
    "text": "نهان کرد بر قلبگه بر درفش"
  },
  {
    "poem_id": 88077,
    "vorder": 111,
    "position": 0,
    "text": "سپه را رده بر کشیده بماند"
  },
  {
    "poem_id": 88077,
    "vorder": 112,
    "position": 1,
    "text": "خود و نامداران توران براند"
  },
  {
    "poem_id": 88077,
    "vorder": 113,
    "position": 0,
    "text": "ز خویشان شایسته مردی هزار"
  },
  {
    "poem_id": 88077,
    "vorder": 114,
    "position": 1,
    "text": "به نزدیک او بود در کارزار"
  },
  {
    "poem_id": 88077,
    "vorder": 115,
    "position": 0,
    "text": "به بیراه راه بیابان گرفت"
  },
  {
    "poem_id": 88077,
    "vorder": 116,
    "position": 1,
    "text": "به رنج تن از دشمنان جان گرفت"
  },
  {
    "poem_id": 88077,
    "vorder": 117,
    "position": 0,
    "text": "ز لشکر نیا را همی جست شاه"
  },
  {
    "poem_id": 88077,
    "vorder": 118,
    "position": 1,
    "text": "بیامد دمان تا به  قلب سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 119,
    "position": 0,
    "text": "ز هر سوی پویید و چندی شتافت"
  },
  {
    "poem_id": 88077,
    "vorder": 120,
    "position": 1,
    "text": "نشان پی شاه توران نیافت"
  },
  {
    "poem_id": 88077,
    "vorder": 121,
    "position": 0,
    "text": "سپه چون نگه کرد در قلبگاه"
  },
  {
    "poem_id": 88077,
    "vorder": 122,
    "position": 1,
    "text": "ندیدند جایی درفش سیاه"
  },
  {
    "poem_id": 88077,
    "vorder": 123,
    "position": 0,
    "text": "ز شه خواستند آن زمان زینهار"
  },
  {
    "poem_id": 88077,
    "vorder": 124,
    "position": 1,
    "text": "فروریختند آلت کارزار"
  },
  {
    "poem_id": 88077,
    "vorder": 125,
    "position": 0,
    "text": "چو خسرو چنان دید بنواختشان"
  },
  {
    "poem_id": 88077,
    "vorder": 126,
    "position": 1,
    "text": "ز لشکر جدا جایگه ساختشان"
  },
  {
    "poem_id": 88077,
    "vorder": 127,
    "position": 0,
    "text": "بفرمود تا تخت زرین نهند"
  },
  {
    "poem_id": 88077,
    "vorder": 128,
    "position": 1,
    "text": "به خیمه در آرایش چین نهند"
  },
  {
    "poem_id": 88077,
    "vorder": 129,
    "position": 0,
    "text": "می‌آورد و رامشگران را بخواند"
  },
  {
    "poem_id": 88077,
    "vorder": 130,
    "position": 1,
    "text": "ز لشکر فراوان سران را بخواند"
  },
  {
    "poem_id": 88077,
    "vorder": 131,
    "position": 0,
    "text": "شبی کرد جشنی که تا روز پاک"
  },
  {
    "poem_id": 88077,
    "vorder": 132,
    "position": 1,
    "text": "همی مرده برخاست از تیره خاک"
  },
  {
    "poem_id": 88077,
    "vorder": 133,
    "position": 0,
    "text": "چو خورشید بر چرخ بنمود پشت"
  },
  {
    "poem_id": 88077,
    "vorder": 134,
    "position": 1,
    "text": "شب تیره شد از نمودن درشت"
  },
  {
    "poem_id": 88077,
    "vorder": 135,
    "position": 0,
    "text": "شهنشاه ایران سر و تن بشست"
  },
  {
    "poem_id": 88077,
    "vorder": 136,
    "position": 1,
    "text": "یکی جایگاه پرستش بجست"
  },
  {
    "poem_id": 88077,
    "vorder": 137,
    "position": 0,
    "text": "کز ایرانیان کس مر او را ندید"
  },
  {
    "poem_id": 88077,
    "vorder": 138,
    "position": 1,
    "text": "نه دام و دد آوای ایشان شنید"
  },
  {
    "poem_id": 88077,
    "vorder": 139,
    "position": 0,
    "text": "ز شبگرد تا ماه بر چرخ ساج"
  },
  {
    "poem_id": 88077,
    "vorder": 140,
    "position": 1,
    "text": "به سر بر نهاد آن دل‌افروز تاج"
  },
  {
    "poem_id": 88077,
    "vorder": 141,
    "position": 0,
    "text": "ستایش همی کرد بر کردگار"
  },
  {
    "poem_id": 88077,
    "vorder": 142,
    "position": 1,
    "text": "از آن شادمان گردش روزگار"
  },
  {
    "poem_id": 88077,
    "vorder": 143,
    "position": 0,
    "text": "فراوان بمالید بر خاک روی"
  },
  {
    "poem_id": 88077,
    "vorder": 144,
    "position": 1,
    "text": "به رخ بر نهاد از دو دیده دو جوی"
  },
  {
    "poem_id": 88077,
    "vorder": 145,
    "position": 0,
    "text": "وز آنجا بیامد سوی تاج و تخت"
  },
  {
    "poem_id": 88077,
    "vorder": 146,
    "position": 1,
    "text": "خرامان و شادان دل و نیکبخت"
  },
  {
    "poem_id": 88077,
    "vorder": 147,
    "position": 0,
    "text": "از ایرانیان هرکه افگنده بود"
  },
  {
    "poem_id": 88077,
    "vorder": 148,
    "position": 1,
    "text": "اگر کشته بودند گر زنده بود"
  },
  {
    "poem_id": 88077,
    "vorder": 149,
    "position": 0,
    "text": "از آن خاک آورد برداشتند"
  },
  {
    "poem_id": 88077,
    "vorder": 150,
    "position": 1,
    "text": "تن دشمنان خوار بگذاشتند"
  },
  {
    "poem_id": 88077,
    "vorder": 151,
    "position": 0,
    "text": "همه رزمگه دخمه‌ها ساختند"
  },
  {
    "poem_id": 88077,
    "vorder": 152,
    "position": 1,
    "text": "از آن کشتگان چون بپرداختند"
  },
  {
    "poem_id": 88077,
    "vorder": 153,
    "position": 0,
    "text": "ز چیزی که بود اندر آن رزمگاه"
  },
  {
    "poem_id": 88077,
    "vorder": 154,
    "position": 1,
    "text": "ببخشید شاه جهان بر سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 155,
    "position": 0,
    "text": "وز آنجا بشد شاه به بهشت گنگ"
  },
  {
    "poem_id": 88077,
    "vorder": 156,
    "position": 1,
    "text": "همه لشکر آباد با ساز جنگ"
  },
  {
    "poem_id": 88077,
    "vorder": 157,
    "position": 0,
    "text": "چو آگاهی آمد به ماچین و چین"
  },
  {
    "poem_id": 88077,
    "vorder": 158,
    "position": 1,
    "text": "ز ترکان وز شاه ایران زمین"
  },
  {
    "poem_id": 88077,
    "vorder": 159,
    "position": 0,
    "text": "بپیچید فغفور و خاقان به درد"
  },
  {
    "poem_id": 88077,
    "vorder": 160,
    "position": 1,
    "text": "ز تخت مهی هر کسی یاد کرد"
  },
  {
    "poem_id": 88077,
    "vorder": 161,
    "position": 0,
    "text": "وز آن یاوریها پشیمان شدند"
  },
  {
    "poem_id": 88077,
    "vorder": 162,
    "position": 1,
    "text": "پراندیشه دل سوی درمان شدند"
  },
  {
    "poem_id": 88077,
    "vorder": 163,
    "position": 0,
    "text": "همی گفت فغفور کافراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 164,
    "position": 1,
    "text": "از این پس نبیند بزرگی به خواب"
  },
  {
    "poem_id": 88077,
    "vorder": 165,
    "position": 0,
    "text": "ز لشکر فرستادن و خواسته"
  },
  {
    "poem_id": 88077,
    "vorder": 166,
    "position": 1,
    "text": "شود کار ما بی‌گمان کاسته"
  },
  {
    "poem_id": 88077,
    "vorder": 167,
    "position": 0,
    "text": "پشیمانی آمد همه بهر ما"
  },
  {
    "poem_id": 88077,
    "vorder": 168,
    "position": 1,
    "text": "کز این کار ویران شود شهر ما"
  },
  {
    "poem_id": 88077,
    "vorder": 169,
    "position": 0,
    "text": "ز چین و ختن هدیه‌ها ساختند"
  },
  {
    "poem_id": 88077,
    "vorder": 170,
    "position": 1,
    "text": "بدان کار گنجی بپرداختند"
  },
  {
    "poem_id": 88077,
    "vorder": 171,
    "position": 0,
    "text": "فرستاده‌ای نیک‌دل را بخواند"
  },
  {
    "poem_id": 88077,
    "vorder": 172,
    "position": 1,
    "text": "سخنهای شایسته چندی براند"
  },
  {
    "poem_id": 88077,
    "vorder": 173,
    "position": 0,
    "text": "یکی مرد بد نیک‌دل نیک خواه"
  },
  {
    "poem_id": 88077,
    "vorder": 174,
    "position": 1,
    "text": "فرستاد فغفور نزدیک شاه"
  },
  {
    "poem_id": 88077,
    "vorder": 175,
    "position": 0,
    "text": "طرایف به چین اندرون آنچه بود"
  },
  {
    "poem_id": 88077,
    "vorder": 176,
    "position": 1,
    "text": "ز دینار وز گوهر نابسود"
  },
  {
    "poem_id": 88077,
    "vorder": 177,
    "position": 0,
    "text": "به پوزش فرستاد نزدیک شاه"
  },
  {
    "poem_id": 88077,
    "vorder": 178,
    "position": 1,
    "text": "فرستادگان برگرفتند راه"
  },
  {
    "poem_id": 88077,
    "vorder": 179,
    "position": 0,
    "text": "بزرگان چین بی‌درنگ آمدند"
  },
  {
    "poem_id": 88077,
    "vorder": 180,
    "position": 1,
    "text": "به یک هفته از چین به گنگ آمدند"
  },
  {
    "poem_id": 88077,
    "vorder": 181,
    "position": 0,
    "text": "جهاندار پیروز بنواختشان"
  },
  {
    "poem_id": 88077,
    "vorder": 182,
    "position": 1,
    "text": "چنانچون ببایست بنشاختشان"
  },
  {
    "poem_id": 88077,
    "vorder": 183,
    "position": 0,
    "text": "بپذرفت چیزی که آورده بود"
  },
  {
    "poem_id": 88077,
    "vorder": 184,
    "position": 1,
    "text": "طرایف بد و بدره و پرده بود"
  },
  {
    "poem_id": 88077,
    "vorder": 185,
    "position": 0,
    "text": "فرستاده را گفت کو را بگوی"
  },
  {
    "poem_id": 88077,
    "vorder": 186,
    "position": 1,
    "text": "که خیره بر ما مبر آبروی"
  },
  {
    "poem_id": 88077,
    "vorder": 187,
    "position": 0,
    "text": "نباید که نزد تو افراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 188,
    "position": 1,
    "text": "بیاید شب تیره هنگام خواب"
  },
  {
    "poem_id": 88077,
    "vorder": 189,
    "position": 0,
    "text": "فرستاده برگشت و آمد چو باد"
  },
  {
    "poem_id": 88077,
    "vorder": 190,
    "position": 1,
    "text": "به فغفور یکسر پیامش بداد"
  },
  {
    "poem_id": 88077,
    "vorder": 191,
    "position": 0,
    "text": "چو بشنید فغفور هنگام خواب"
  },
  {
    "poem_id": 88077,
    "vorder": 192,
    "position": 1,
    "text": "فرستاد کس نزد افراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 193,
    "position": 0,
    "text": "که از من ز چین و ختن دور باش"
  },
  {
    "poem_id": 88077,
    "vorder": 194,
    "position": 1,
    "text": "ز بد کردن خویش رنجور باش"
  },
  {
    "poem_id": 88077,
    "vorder": 195,
    "position": 0,
    "text": "هر آن کس که او گم کند راه خویش"
  },
  {
    "poem_id": 88077,
    "vorder": 196,
    "position": 1,
    "text": "بد آید بداندیش را کار پیش"
  },
  {
    "poem_id": 88077,
    "vorder": 197,
    "position": 0,
    "text": "چو بشنید افراسیاب این سخن"
  },
  {
    "poem_id": 88077,
    "vorder": 198,
    "position": 1,
    "text": "پشیمان شد از کرده‌های کهن"
  },
  {
    "poem_id": 88077,
    "vorder": 199,
    "position": 0,
    "text": "بیفگند نام مهی جان گرفت"
  },
  {
    "poem_id": 88077,
    "vorder": 200,
    "position": 1,
    "text": "به بیراه، راه بیابان گرفت"
  },
  {
    "poem_id": 88077,
    "vorder": 201,
    "position": 0,
    "text": "چو با درد و با رنج و غم دید روز"
  },
  {
    "poem_id": 88077,
    "vorder": 202,
    "position": 1,
    "text": "بیامد دمان تا به کوه اسپروز"
  },
  {
    "poem_id": 88077,
    "vorder": 203,
    "position": 0,
    "text": "ز بدخواه روز و شب اندیشه کرد"
  },
  {
    "poem_id": 88077,
    "vorder": 204,
    "position": 1,
    "text": "شب و روز را دل یکی پیشه کرد"
  },
  {
    "poem_id": 88077,
    "vorder": 205,
    "position": 0,
    "text": "بیامد ز چین تا به آب زره"
  },
  {
    "poem_id": 88077,
    "vorder": 206,
    "position": 1,
    "text": "میان سوده از رنج و بند گره"
  },
  {
    "poem_id": 88077,
    "vorder": 207,
    "position": 0,
    "text": "چو نزدیک آن ژرف دریا رسید"
  },
  {
    "poem_id": 88077,
    "vorder": 208,
    "position": 1,
    "text": "مر آن را میان و کرانه ندید"
  },
  {
    "poem_id": 88077,
    "vorder": 209,
    "position": 0,
    "text": "بدو گفت ملاح کای شهریار"
  },
  {
    "poem_id": 88077,
    "vorder": 210,
    "position": 1,
    "text": "بدین ژرف دریا نیابی گذار"
  },
  {
    "poem_id": 88077,
    "vorder": 211,
    "position": 0,
    "text": "مرا سالیان هست هفتاد و هشت"
  },
  {
    "poem_id": 88077,
    "vorder": 212,
    "position": 1,
    "text": "ندیدم که کشتی بر او بر گذشت"
  },
  {
    "poem_id": 88077,
    "vorder": 213,
    "position": 0,
    "text": "بدو گفت پر مایه افراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 214,
    "position": 1,
    "text": "که فرخ کسی کو بمیرد در آب"
  },
  {
    "poem_id": 88077,
    "vorder": 215,
    "position": 0,
    "text": "مرا چون به شمشیر دشمن نکشت"
  },
  {
    "poem_id": 88077,
    "vorder": 216,
    "position": 1,
    "text": "چنانچون نکشتش نگیرد به مشت"
  },
  {
    "poem_id": 88077,
    "vorder": 217,
    "position": 0,
    "text": "بفرمود تا مهتران هر کسی"
  },
  {
    "poem_id": 88077,
    "vorder": 218,
    "position": 1,
    "text": "به آب اندر آرند کشتی بسی"
  },
  {
    "poem_id": 88077,
    "vorder": 219,
    "position": 0,
    "text": "سوی گنگ دژ بادبان برکشید"
  },
  {
    "poem_id": 88077,
    "vorder": 220,
    "position": 1,
    "text": "به نیک و بدیها سر اندر کشید"
  },
  {
    "poem_id": 88077,
    "vorder": 221,
    "position": 0,
    "text": "چو آن جایگه شد بخفت و بخورد"
  },
  {
    "poem_id": 88077,
    "vorder": 222,
    "position": 1,
    "text": "برآسود از روزگار نبرد"
  },
  {
    "poem_id": 88077,
    "vorder": 223,
    "position": 0,
    "text": "چنین گفت کایدر بباشیم شاد"
  },
  {
    "poem_id": 88077,
    "vorder": 224,
    "position": 1,
    "text": "ز کار گذشته نگیریم یاد"
  },
  {
    "poem_id": 88077,
    "vorder": 225,
    "position": 0,
    "text": "چو روشن شود تیره گون اخترم"
  },
  {
    "poem_id": 88077,
    "vorder": 226,
    "position": 1,
    "text": "به کشتی بر آب زره بگذرم"
  },
  {
    "poem_id": 88077,
    "vorder": 227,
    "position": 0,
    "text": "ز دشمن بخواهم همان کین خویش"
  },
  {
    "poem_id": 88077,
    "vorder": 228,
    "position": 1,
    "text": "درفشان کنم راه و آیین خویش"
  },
  {
    "poem_id": 88077,
    "vorder": 229,
    "position": 0,
    "text": "چو کیخسرو آگاه شد ز این سخن"
  },
  {
    "poem_id": 88077,
    "vorder": 230,
    "position": 1,
    "text": "که کار نو آورد مرد کهن"
  },
  {
    "poem_id": 88077,
    "vorder": 231,
    "position": 0,
    "text": "به رستم چنین گفت کافراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 232,
    "position": 1,
    "text": "سوی گنگ دژ شد ز دریای آب"
  },
  {
    "poem_id": 88077,
    "vorder": 233,
    "position": 0,
    "text": "به کردار کرد آنچه با ما بگفت"
  },
  {
    "poem_id": 88077,
    "vorder": 234,
    "position": 1,
    "text": "که ما را سپهر بلندست جفت"
  },
  {
    "poem_id": 88077,
    "vorder": 235,
    "position": 0,
    "text": "به کشتی به آب زره برگذشت"
  },
  {
    "poem_id": 88077,
    "vorder": 236,
    "position": 1,
    "text": "همه رنج ما سر به سر باد گشت"
  },
  {
    "poem_id": 88077,
    "vorder": 237,
    "position": 0,
    "text": "مرا با نیا جز به خنجر سخن"
  },
  {
    "poem_id": 88077,
    "vorder": 238,
    "position": 1,
    "text": "نباشد نگردانم این کین کهن"
  },
  {
    "poem_id": 88077,
    "vorder": 239,
    "position": 0,
    "text": "به نیروی یزدان پیروزگر"
  },
  {
    "poem_id": 88077,
    "vorder": 240,
    "position": 1,
    "text": "ببندم به کین سیاوش کمر"
  },
  {
    "poem_id": 88077,
    "vorder": 241,
    "position": 0,
    "text": "همه چین و ماچین سپه گسترم"
  },
  {
    "poem_id": 88077,
    "vorder": 242,
    "position": 1,
    "text": "به دریای کیماک بر بگذرم"
  },
  {
    "poem_id": 88077,
    "vorder": 243,
    "position": 0,
    "text": "چو گردد مرا راست ماچین و چین"
  },
  {
    "poem_id": 88077,
    "vorder": 244,
    "position": 1,
    "text": "بخواهیم باژی ز مکران زمین"
  },
  {
    "poem_id": 88077,
    "vorder": 245,
    "position": 0,
    "text": "به آب زره بگذرانم سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 246,
    "position": 1,
    "text": "اگر چرخ گردان بود نیک‌خواه"
  },
  {
    "poem_id": 88077,
    "vorder": 247,
    "position": 0,
    "text": "اگر چند جایی درنگ آیدم"
  },
  {
    "poem_id": 88077,
    "vorder": 248,
    "position": 1,
    "text": "مگر مرد خونی به چنگ آیدم"
  },
  {
    "poem_id": 88077,
    "vorder": 249,
    "position": 0,
    "text": "شما رنج بسیار برداشتید"
  },
  {
    "poem_id": 88077,
    "vorder": 250,
    "position": 1,
    "text": "بر و بوم آباد بگذاشتید"
  },
  {
    "poem_id": 88077,
    "vorder": 251,
    "position": 0,
    "text": "همین رنج بر خویشتن برنهید"
  },
  {
    "poem_id": 88077,
    "vorder": 252,
    "position": 1,
    "text": "از آن به که گیتی به دشمن دهید"
  },
  {
    "poem_id": 88077,
    "vorder": 253,
    "position": 0,
    "text": "بماند ز ما نام تا رستخیز"
  },
  {
    "poem_id": 88077,
    "vorder": 254,
    "position": 1,
    "text": "به پیروزی و دشمن اندر گریز"
  },
  {
    "poem_id": 88077,
    "vorder": 255,
    "position": 0,
    "text": "شدند اندر آن پهلوانان دژم"
  },
  {
    "poem_id": 88077,
    "vorder": 256,
    "position": 1,
    "text": "دهان پر ز باد ابروان پر زخم"
  },
  {
    "poem_id": 88077,
    "vorder": 257,
    "position": 0,
    "text": "که دریای با موج و چندین سپاه"
  },
  {
    "poem_id": 88077,
    "vorder": 258,
    "position": 1,
    "text": "سر و کار با باد و شش ماه راه"
  },
  {
    "poem_id": 88077,
    "vorder": 259,
    "position": 0,
    "text": "که داند که بیرون که آید ز آب"
  },
  {
    "poem_id": 88077,
    "vorder": 260,
    "position": 1,
    "text": "بد آمد سپه را ز افراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 261,
    "position": 0,
    "text": "چو خشکی بود ما به جنگ اندریم"
  },
  {
    "poem_id": 88077,
    "vorder": 262,
    "position": 1,
    "text": "به دریا به کام نهنگ اندریم"
  },
  {
    "poem_id": 88077,
    "vorder": 263,
    "position": 0,
    "text": "همی گفت هر گونه‌ای هر کسی"
  },
  {
    "poem_id": 88077,
    "vorder": 264,
    "position": 1,
    "text": "بدانگه که گفتارها شد بسی"
  },
  {
    "poem_id": 88077,
    "vorder": 265,
    "position": 0,
    "text": "همی گفت رستم که ای مهتران"
  },
  {
    "poem_id": 88077,
    "vorder": 266,
    "position": 1,
    "text": "جهان دیده و رنجبرده سران"
  },
  {
    "poem_id": 88077,
    "vorder": 267,
    "position": 0,
    "text": "نباید که این رنج بی بر شود"
  },
  {
    "poem_id": 88077,
    "vorder": 268,
    "position": 1,
    "text": "به ناز و تن آسانی اندر شود"
  },
  {
    "poem_id": 88077,
    "vorder": 269,
    "position": 0,
    "text": "و دیگر که این شاه پیروزگر"
  },
  {
    "poem_id": 88077,
    "vorder": 270,
    "position": 1,
    "text": "بیابد همی ز اختر نیک بر"
  },
  {
    "poem_id": 88077,
    "vorder": 271,
    "position": 0,
    "text": "از ایران برفتیم تا پیش گنگ"
  },
  {
    "poem_id": 88077,
    "vorder": 272,
    "position": 1,
    "text": "ندیدیم جز چنگ یازان به جنگ"
  },
  {
    "poem_id": 88077,
    "vorder": 273,
    "position": 0,
    "text": "ز کاری که سازد همی برخورد"
  },
  {
    "poem_id": 88077,
    "vorder": 274,
    "position": 1,
    "text": "بدین آمد و هم بدین بگذرد"
  },
  {
    "poem_id": 88077,
    "vorder": 275,
    "position": 0,
    "text": "چو بشنید لشکر ز رستم سخن"
  },
  {
    "poem_id": 88077,
    "vorder": 276,
    "position": 1,
    "text": "یکی پاسخ نو فگندند بن"
  },
  {
    "poem_id": 88077,
    "vorder": 277,
    "position": 0,
    "text": "که ما سر به سر شاه را بنده‌ایم"
  },
  {
    "poem_id": 88077,
    "vorder": 278,
    "position": 1,
    "text": "ابا بندگی دوست دارنده‌ایم"
  },
  {
    "poem_id": 88077,
    "vorder": 279,
    "position": 0,
    "text": "به خشکی و بر آب فرمان وراست"
  },
  {
    "poem_id": 88077,
    "vorder": 280,
    "position": 1,
    "text": "همه کهترانیم و پیمان وراست"
  },
  {
    "poem_id": 88077,
    "vorder": 281,
    "position": 0,
    "text": "از آن شاد شد شاه و بنواختشان"
  },
  {
    "poem_id": 88077,
    "vorder": 282,
    "position": 1,
    "text": "یکایک به اندازه بنشاختشان"
  },
  {
    "poem_id": 88077,
    "vorder": 283,
    "position": 0,
    "text": "در گنجهای نیا برگشاد"
  },
  {
    "poem_id": 88077,
    "vorder": 284,
    "position": 1,
    "text": "ز پیوند و مهرش نکرد ایچ یاد"
  },
  {
    "poem_id": 88077,
    "vorder": 285,
    "position": 0,
    "text": "ز دینار و دیبای گوهرنگار"
  },
  {
    "poem_id": 88077,
    "vorder": 286,
    "position": 1,
    "text": "هیونان شایسته کردند بار"
  },
  {
    "poem_id": 88077,
    "vorder": 287,
    "position": 0,
    "text": "همیدون ز گنج درم صد هزار"
  },
  {
    "poem_id": 88077,
    "vorder": 288,
    "position": 1,
    "text": "ببردند با آلت کارزار"
  },
  {
    "poem_id": 88077,
    "vorder": 289,
    "position": 0,
    "text": "ز گاوان گردون کشان ده هزار"
  },
  {
    "poem_id": 88077,
    "vorder": 290,
    "position": 1,
    "text": "ببردند تا خود کی آید به کار"
  },
  {
    "poem_id": 88077,
    "vorder": 291,
    "position": 0,
    "text": "هیونان ز گنج درم ده هزار"
  },
  {
    "poem_id": 88077,
    "vorder": 292,
    "position": 1,
    "text": "بسی بار کردند با شهریار"
  },
  {
    "poem_id": 88077,
    "vorder": 293,
    "position": 0,
    "text": "بفرمود زان پس به هنگام خواب"
  },
  {
    "poem_id": 88077,
    "vorder": 294,
    "position": 1,
    "text": "که پوشیده رویان افراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 295,
    "position": 0,
    "text": "ز خویشان و پیوند چندان که هست"
  },
  {
    "poem_id": 88077,
    "vorder": 296,
    "position": 1,
    "text": "اگر دخترانند اگر زیردست"
  },
  {
    "poem_id": 88077,
    "vorder": 297,
    "position": 0,
    "text": "همه در عماری به راه آوردند"
  },
  {
    "poem_id": 88077,
    "vorder": 298,
    "position": 1,
    "text": "ز ایوان به میدان شاه آوردند"
  },
  {
    "poem_id": 88077,
    "vorder": 299,
    "position": 0,
    "text": "دو از نامداران گردنکشان"
  },
  {
    "poem_id": 88077,
    "vorder": 300,
    "position": 1,
    "text": "که بودند هر یک به مردی نشان"
  },
  {
    "poem_id": 88077,
    "vorder": 301,
    "position": 0,
    "text": "چو جهن و چو گرسیوز ارجمند"
  },
  {
    "poem_id": 88077,
    "vorder": 302,
    "position": 1,
    "text": "به مهد اندرون پای کرده به بند"
  },
  {
    "poem_id": 88077,
    "vorder": 303,
    "position": 0,
    "text": "همه خویش و پیوند افراسیاب"
  },
  {
    "poem_id": 88077,
    "vorder": 304,
    "position": 1,
    "text": "ز تیمارشان دیده کرده پر آب"
  },
  {
    "poem_id": 88077,
    "vorder": 305,
    "position": 0,
    "text": "نواها که از شهرها یادگار"
  },
  {
    "poem_id": 88077,
    "vorder": 306,
    "position": 1,
    "text": "گروگان ستد ترک چینی هزار"
  },
  {
    "poem_id": 88077,
    "vorder": 307,
    "position": 0,
    "text": "سپرد آن زمان گیو را شهریار"
  },
  {
    "poem_id": 88077,
    "vorder": 308,
    "position": 1,
    "text": "گزین کرد ز ایرانیان ده هزار"
  },
  {
    "poem_id": 88077,
    "vorder": 309,
    "position": 0,
    "text": "بدو گفت کای مرد فرخنده پی"
  },
  {
    "poem_id": 88077,
    "vorder": 310,
    "position": 1,
    "text": "برو با سپه پیش کاووس کی"
  }
]