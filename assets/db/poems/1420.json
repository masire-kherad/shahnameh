[
  {
    "poem_id": 1420,
    "vorder": 1,
    "position": 0,
    "text": "پسر بود زو را یکی خویش کام"
  },
  {
    "poem_id": 1420,
    "vorder": 2,
    "position": 1,
    "text": "پدر کرده بودیش گرشاسپ نام"
  },
  {
    "poem_id": 1420,
    "vorder": 3,
    "position": 0,
    "text": "بیامد نشست از بر تخت و گاه"
  },
  {
    "poem_id": 1420,
    "vorder": 4,
    "position": 1,
    "text": "به سر بر نهاد آن کیانی کلاه"
  },
  {
    "poem_id": 1420,
    "vorder": 5,
    "position": 0,
    "text": "چو بنشست بر تخت و گاه پدر"
  },
  {
    "poem_id": 1420,
    "vorder": 6,
    "position": 1,
    "text": "جهان را همی داشت با زیب و فر"
  },
  {
    "poem_id": 1420,
    "vorder": 7,
    "position": 0,
    "text": "چنین تا برآمد برین روزگار"
  },
  {
    "poem_id": 1420,
    "vorder": 8,
    "position": 1,
    "text": "درخت بلا کینه آورد بار"
  },
  {
    "poem_id": 1420,
    "vorder": 9,
    "position": 0,
    "text": "به ترکان خبر شد که زو درگذشت"
  },
  {
    "poem_id": 1420,
    "vorder": 10,
    "position": 1,
    "text": "بران سان که بد تخت بی‌کار گشت"
  },
  {
    "poem_id": 1420,
    "vorder": 11,
    "position": 0,
    "text": "بیامد به خوار ری افراسیاب"
  },
  {
    "poem_id": 1420,
    "vorder": 12,
    "position": 1,
    "text": "ببخشید گیتی و بگذاشت آب"
  },
  {
    "poem_id": 1420,
    "vorder": 13,
    "position": 0,
    "text": "نیاورد یک تن درود پشنگ"
  },
  {
    "poem_id": 1420,
    "vorder": 14,
    "position": 1,
    "text": "سرش پر ز کین بود و دل پر ز جنگ"
  },
  {
    "poem_id": 1420,
    "vorder": 15,
    "position": 0,
    "text": "دلش خود ز تخت و کله گشته بود"
  },
  {
    "poem_id": 1420,
    "vorder": 16,
    "position": 1,
    "text": "به تیمار اغریرث آغشته بود"
  },
  {
    "poem_id": 1420,
    "vorder": 17,
    "position": 0,
    "text": "بدو روی ننمود هرگز پشنگ"
  },
  {
    "poem_id": 1420,
    "vorder": 18,
    "position": 1,
    "text": "شد آن تیغ روشن پر از تیره زنگ"
  },
  {
    "poem_id": 1420,
    "vorder": 19,
    "position": 0,
    "text": "فرستاده رفتی به نزدیک اوی"
  },
  {
    "poem_id": 1420,
    "vorder": 20,
    "position": 1,
    "text": "بدو سال و مه هیچ ننمود روی"
  },
  {
    "poem_id": 1420,
    "vorder": 21,
    "position": 0,
    "text": "همی گفت اگر تخت را سر بدی"
  },
  {
    "poem_id": 1420,
    "vorder": 22,
    "position": 1,
    "text": "چو اغریرثش یار درخور بدی"
  },
  {
    "poem_id": 1420,
    "vorder": 23,
    "position": 0,
    "text": "تو خون برادر بریزی همی"
  },
  {
    "poem_id": 1420,
    "vorder": 24,
    "position": 1,
    "text": "ز پرورده مرغی گریزی همی"
  },
  {
    "poem_id": 1420,
    "vorder": 25,
    "position": 0,
    "text": "مرا با تو تا جاودان کار نیست"
  },
  {
    "poem_id": 1420,
    "vorder": 26,
    "position": 1,
    "text": "به نزد منت راه دیدار نیست"
  },
  {
    "poem_id": 1420,
    "vorder": 27,
    "position": 0,
    "text": "پرآواز شد گوش ازین آگهی"
  },
  {
    "poem_id": 1420,
    "vorder": 28,
    "position": 1,
    "text": "که بی‌کار شد تخت شاهنشهی"
  },
  {
    "poem_id": 1420,
    "vorder": 29,
    "position": 0,
    "text": "پیامی بیامد به کردار سنگ"
  },
  {
    "poem_id": 1420,
    "vorder": 30,
    "position": 1,
    "text": "به افراسیاب از دلاور پشنگ"
  },
  {
    "poem_id": 1420,
    "vorder": 31,
    "position": 0,
    "text": "که بگذار جیحون و برکش سپاه"
  },
  {
    "poem_id": 1420,
    "vorder": 32,
    "position": 1,
    "text": "ممان تا کسی برنشیند به گاه"
  },
  {
    "poem_id": 1420,
    "vorder": 33,
    "position": 0,
    "text": "یکی لشکری ساخت افراسیاب"
  },
  {
    "poem_id": 1420,
    "vorder": 34,
    "position": 1,
    "text": "ز دشت سپیجاب تا رود آب"
  },
  {
    "poem_id": 1420,
    "vorder": 35,
    "position": 0,
    "text": "که گفتی زمین شد سپهر روان"
  },
  {
    "poem_id": 1420,
    "vorder": 36,
    "position": 1,
    "text": "همی بارد از تیغ هندی روان"
  },
  {
    "poem_id": 1420,
    "vorder": 37,
    "position": 0,
    "text": "یکایک به ایران رسید آگهی"
  },
  {
    "poem_id": 1420,
    "vorder": 38,
    "position": 1,
    "text": "که آمد خریدار تخت مهی"
  },
  {
    "poem_id": 1420,
    "vorder": 39,
    "position": 0,
    "text": "سوی زابلستان نهادند روی"
  },
  {
    "poem_id": 1420,
    "vorder": 40,
    "position": 1,
    "text": "جهان شد سراسر پر از گفت‌وگوی"
  },
  {
    "poem_id": 1420,
    "vorder": 41,
    "position": 0,
    "text": "بگفتند با زال چندی درشت"
  },
  {
    "poem_id": 1420,
    "vorder": 42,
    "position": 1,
    "text": "که گیتی بس آسان گرفتی به مشت"
  },
  {
    "poem_id": 1420,
    "vorder": 43,
    "position": 0,
    "text": "پس از سام تا تو شدی پهلوان"
  },
  {
    "poem_id": 1420,
    "vorder": 44,
    "position": 1,
    "text": "نبودیم یک روز روشن روان"
  },
  {
    "poem_id": 1420,
    "vorder": 45,
    "position": 0,
    "text": "سپاهی ز جیحون بدین سو کشید"
  },
  {
    "poem_id": 1420,
    "vorder": 46,
    "position": 1,
    "text": "که شد آفتاب از جهان ناپدید"
  },
  {
    "poem_id": 1420,
    "vorder": 47,
    "position": 0,
    "text": "اگر چاره دانی مراین را بساز"
  },
  {
    "poem_id": 1420,
    "vorder": 48,
    "position": 1,
    "text": "که آمد سپهبد به تنگی فراز"
  },
  {
    "poem_id": 1420,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت پس نامور زال زر"
  },
  {
    "poem_id": 1420,
    "vorder": 50,
    "position": 1,
    "text": "که تا من ببستم به مردی کمر"
  },
  {
    "poem_id": 1420,
    "vorder": 51,
    "position": 0,
    "text": "سواری چو من پای بر زین نگاشت"
  },
  {
    "poem_id": 1420,
    "vorder": 52,
    "position": 1,
    "text": "کسی تیغ و گرز مرا برنداشت"
  },
  {
    "poem_id": 1420,
    "vorder": 53,
    "position": 0,
    "text": "به جایی که من پای بفشاردم"
  },
  {
    "poem_id": 1420,
    "vorder": 54,
    "position": 1,
    "text": "عنان سواران شدی پاردم"
  },
  {
    "poem_id": 1420,
    "vorder": 55,
    "position": 0,
    "text": "شب و روز در جنگ یکسان بدم"
  },
  {
    "poem_id": 1420,
    "vorder": 56,
    "position": 1,
    "text": "ز پیری همه ساله ترسان بدم"
  },
  {
    "poem_id": 1420,
    "vorder": 57,
    "position": 0,
    "text": "کنون چنبری گشت یال یلی"
  },
  {
    "poem_id": 1420,
    "vorder": 58,
    "position": 1,
    "text": "نتابد همی خنجر کابلی"
  },
  {
    "poem_id": 1420,
    "vorder": 59,
    "position": 0,
    "text": "کنون گشت رستم چو سرو سهی"
  },
  {
    "poem_id": 1420,
    "vorder": 60,
    "position": 1,
    "text": "بزیبد برو بر کلاه مهی"
  },
  {
    "poem_id": 1420,
    "vorder": 61,
    "position": 0,
    "text": "یکی اسپ جنگیش باید همی"
  },
  {
    "poem_id": 1420,
    "vorder": 62,
    "position": 1,
    "text": "کزین تازی اسپان نشاید همی"
  },
  {
    "poem_id": 1420,
    "vorder": 63,
    "position": 0,
    "text": "بجویم یکی بارهٔ پیلتن"
  },
  {
    "poem_id": 1420,
    "vorder": 64,
    "position": 1,
    "text": "بخواهم ز هر سو که هست انجمن"
  },
  {
    "poem_id": 1420,
    "vorder": 65,
    "position": 0,
    "text": "بخوانم به رستم بر این داستان"
  },
  {
    "poem_id": 1420,
    "vorder": 66,
    "position": 1,
    "text": "که هستی برین کار همداستان"
  },
  {
    "poem_id": 1420,
    "vorder": 67,
    "position": 0,
    "text": "که بر کینهٔ تخمهٔ زادشم"
  },
  {
    "poem_id": 1420,
    "vorder": 68,
    "position": 1,
    "text": "ببندی میان و نباشی دژم"
  },
  {
    "poem_id": 1420,
    "vorder": 69,
    "position": 0,
    "text": "همه شهر ایران ز گفتار اوی"
  },
  {
    "poem_id": 1420,
    "vorder": 70,
    "position": 1,
    "text": "ببودند شادان دل و تازه روی"
  },
  {
    "poem_id": 1420,
    "vorder": 71,
    "position": 0,
    "text": "ز هر سو هیونی تکاور بتاخت"
  },
  {
    "poem_id": 1420,
    "vorder": 72,
    "position": 1,
    "text": "سلیح سواران جنگی بساخت"
  },
  {
    "poem_id": 1420,
    "vorder": 73,
    "position": 0,
    "text": "به رستم چنین گفت کای پیلتن"
  },
  {
    "poem_id": 1420,
    "vorder": 74,
    "position": 1,
    "text": "به بالا سرت برتر از انجمن"
  },
  {
    "poem_id": 1420,
    "vorder": 75,
    "position": 0,
    "text": "یکی کار پیشست و رنجی دراز"
  },
  {
    "poem_id": 1420,
    "vorder": 76,
    "position": 1,
    "text": "کزو بگسلد خواب و آرام و ناز"
  },
  {
    "poem_id": 1420,
    "vorder": 77,
    "position": 0,
    "text": "ترا نوز پورا گه رزم نیست"
  },
  {
    "poem_id": 1420,
    "vorder": 78,
    "position": 1,
    "text": "چه سازم که هنگامهٔ بزم نیست"
  },
  {
    "poem_id": 1420,
    "vorder": 79,
    "position": 0,
    "text": "هنوز از لبت شیر بوید همی"
  },
  {
    "poem_id": 1420,
    "vorder": 80,
    "position": 1,
    "text": "دلت ناز و شادی بجوید همی"
  },
  {
    "poem_id": 1420,
    "vorder": 81,
    "position": 0,
    "text": "چگونه فرستم به دشت نبرد"
  },
  {
    "poem_id": 1420,
    "vorder": 82,
    "position": 1,
    "text": "ترا پیش ترکان پر کین و درد"
  },
  {
    "poem_id": 1420,
    "vorder": 83,
    "position": 0,
    "text": "چه گویی چه سازی چه پاسخ دهی"
  },
  {
    "poem_id": 1420,
    "vorder": 84,
    "position": 1,
    "text": "که جفت تو بادا مهی و بهی"
  },
  {
    "poem_id": 1420,
    "vorder": 85,
    "position": 0,
    "text": "چنین گفت رستم به دستان سام"
  },
  {
    "poem_id": 1420,
    "vorder": 86,
    "position": 1,
    "text": "که من نیستم مرد آرام و جام"
  },
  {
    "poem_id": 1420,
    "vorder": 87,
    "position": 0,
    "text": "چنین یال و این چنگهای دراز"
  },
  {
    "poem_id": 1420,
    "vorder": 88,
    "position": 1,
    "text": "نه والا بود پروریدن به ناز"
  },
  {
    "poem_id": 1420,
    "vorder": 89,
    "position": 0,
    "text": "اگر دشت کین آید و رزم سخت"
  },
  {
    "poem_id": 1420,
    "vorder": 90,
    "position": 1,
    "text": "بود یار یزدان پیروزبخت"
  },
  {
    "poem_id": 1420,
    "vorder": 91,
    "position": 0,
    "text": "ببینی که در جنگ من چون شوم"
  },
  {
    "poem_id": 1420,
    "vorder": 92,
    "position": 1,
    "text": "چو اندر پی ریزش خون شوم"
  },
  {
    "poem_id": 1420,
    "vorder": 93,
    "position": 0,
    "text": "یکی ابر دارم به چنگ اندرون"
  },
  {
    "poem_id": 1420,
    "vorder": 94,
    "position": 1,
    "text": "که همرنگ آبست و بارانش خون"
  },
  {
    "poem_id": 1420,
    "vorder": 95,
    "position": 0,
    "text": "همی آتش افروزد از گوهرش"
  },
  {
    "poem_id": 1420,
    "vorder": 96,
    "position": 1,
    "text": "همی مغز پیلان بساید سرش"
  },
  {
    "poem_id": 1420,
    "vorder": 97,
    "position": 0,
    "text": "یکی باره باید چو کوه بلند"
  },
  {
    "poem_id": 1420,
    "vorder": 98,
    "position": 1,
    "text": "چنان چون من آرم به خم کمند"
  },
  {
    "poem_id": 1420,
    "vorder": 99,
    "position": 0,
    "text": "یکی گرز خواهم چو یک لخت کوه"
  },
  {
    "poem_id": 1420,
    "vorder": 100,
    "position": 1,
    "text": "گرآیند پیشم ز توران گروه"
  },
  {
    "poem_id": 1420,
    "vorder": 101,
    "position": 0,
    "text": "سرانشان بکوبم بدان گرز بر"
  },
  {
    "poem_id": 1420,
    "vorder": 102,
    "position": 1,
    "text": "نیاید برم هیچ پرخاشخر"
  },
  {
    "poem_id": 1420,
    "vorder": 103,
    "position": 0,
    "text": "که روی زمین را کنم بی‌سپاه"
  },
  {
    "poem_id": 1420,
    "vorder": 104,
    "position": 1,
    "text": "که خون بارد ابر اندر آوردگاه"
  }
]