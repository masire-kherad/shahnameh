[
  {
    "poem_id": 1856,
    "vorder": 1,
    "position": 0,
    "text": "ز بیگانه قیصر به پرداخت جای"
  },
  {
    "poem_id": 1856,
    "vorder": 2,
    "position": 1,
    "text": "پر اندیشه بنشست با رهنمای"
  },
  {
    "poem_id": 1856,
    "vorder": 3,
    "position": 0,
    "text": "به موبد چنین گفت کای دادخواه"
  },
  {
    "poem_id": 1856,
    "vorder": 4,
    "position": 1,
    "text": "ز گیتی گرفتست ما را پناه"
  },
  {
    "poem_id": 1856,
    "vorder": 5,
    "position": 0,
    "text": "بسازیم تا او بنیرو شود"
  },
  {
    "poem_id": 1856,
    "vorder": 6,
    "position": 1,
    "text": "وزان کهتر بد بی‌آهوشود"
  },
  {
    "poem_id": 1856,
    "vorder": 7,
    "position": 0,
    "text": "به قیصر چنین گفت پس رهنمای"
  },
  {
    "poem_id": 1856,
    "vorder": 8,
    "position": 1,
    "text": "که از فیلسوفان پاکیزه رای"
  },
  {
    "poem_id": 1856,
    "vorder": 9,
    "position": 0,
    "text": "بباید تنی چند بیداردل"
  },
  {
    "poem_id": 1856,
    "vorder": 10,
    "position": 1,
    "text": "که بندند با ما بدین کار دل"
  },
  {
    "poem_id": 1856,
    "vorder": 11,
    "position": 0,
    "text": "فرستاد کس قیصر نامدار"
  },
  {
    "poem_id": 1856,
    "vorder": 12,
    "position": 1,
    "text": "برفتند زان فیلسوفان چهار"
  },
  {
    "poem_id": 1856,
    "vorder": 13,
    "position": 0,
    "text": "جوانان و پیران رومی نژاد"
  },
  {
    "poem_id": 1856,
    "vorder": 14,
    "position": 1,
    "text": "سخنهای دیرینه کردند یاد"
  },
  {
    "poem_id": 1856,
    "vorder": 15,
    "position": 0,
    "text": "که ما تا سکندر بشد زین جهان"
  },
  {
    "poem_id": 1856,
    "vorder": 16,
    "position": 1,
    "text": "ز ایرانیانیم خسته نهان"
  },
  {
    "poem_id": 1856,
    "vorder": 17,
    "position": 0,
    "text": "ز بس غارت و جنگ و آویختن"
  },
  {
    "poem_id": 1856,
    "vorder": 18,
    "position": 1,
    "text": "همان بی‌گنه خیره خون ریختن"
  },
  {
    "poem_id": 1856,
    "vorder": 19,
    "position": 0,
    "text": "کنون پاک یزدان ز کردار بد"
  },
  {
    "poem_id": 1856,
    "vorder": 20,
    "position": 1,
    "text": "به پیش اندر آوردشان کار بد"
  },
  {
    "poem_id": 1856,
    "vorder": 21,
    "position": 0,
    "text": "یکی خامشی برگزین از میان"
  },
  {
    "poem_id": 1856,
    "vorder": 22,
    "position": 1,
    "text": "چوشد کندرو بخت ساسانیان"
  },
  {
    "poem_id": 1856,
    "vorder": 23,
    "position": 0,
    "text": "اگر خسرو آن خسروانی کلاه"
  },
  {
    "poem_id": 1856,
    "vorder": 24,
    "position": 1,
    "text": "بدست آورد سر بر آرد بماه"
  },
  {
    "poem_id": 1856,
    "vorder": 25,
    "position": 0,
    "text": "هم اندر زمان باژ خواهد ز روم"
  },
  {
    "poem_id": 1856,
    "vorder": 26,
    "position": 1,
    "text": "بپا اندر آرد همه مرز وبوم"
  },
  {
    "poem_id": 1856,
    "vorder": 27,
    "position": 0,
    "text": "گرین درخورد با خرد یاد دار"
  },
  {
    "poem_id": 1856,
    "vorder": 28,
    "position": 1,
    "text": "سخنهای ایرانیان باد دار"
  },
  {
    "poem_id": 1856,
    "vorder": 29,
    "position": 0,
    "text": "ازیشان چوبشنید قیصر سخن"
  },
  {
    "poem_id": 1856,
    "vorder": 30,
    "position": 1,
    "text": "یکی دیگر اندیشه افگند بن"
  },
  {
    "poem_id": 1856,
    "vorder": 31,
    "position": 0,
    "text": "سواری فرستاد نزدیک شاه"
  },
  {
    "poem_id": 1856,
    "vorder": 32,
    "position": 1,
    "text": "یکی نامه بنوشت و بنمود راه"
  },
  {
    "poem_id": 1856,
    "vorder": 33,
    "position": 0,
    "text": "ز گفتار بیدار دانندگان"
  },
  {
    "poem_id": 1856,
    "vorder": 34,
    "position": 1,
    "text": "سخنهای دیرینه خوانندگان"
  },
  {
    "poem_id": 1856,
    "vorder": 35,
    "position": 0,
    "text": "چو آمد به نزدیک خسرو سوار"
  },
  {
    "poem_id": 1856,
    "vorder": 36,
    "position": 1,
    "text": "بگفت آنچ بشنید با نامدار"
  },
  {
    "poem_id": 1856,
    "vorder": 37,
    "position": 0,
    "text": "همان نامهٔ قیصر او را سپرد"
  },
  {
    "poem_id": 1856,
    "vorder": 38,
    "position": 1,
    "text": "سخنهای قیصر برو برشمرد"
  },
  {
    "poem_id": 1856,
    "vorder": 39,
    "position": 0,
    "text": "چو خسرو بدید آن دلش تنگ شد"
  },
  {
    "poem_id": 1856,
    "vorder": 40,
    "position": 1,
    "text": "رخانش ز اندیشه بی‌رنگ شد"
  },
  {
    "poem_id": 1856,
    "vorder": 41,
    "position": 0,
    "text": "چنین داد پاسخ که گر زین سخن"
  },
  {
    "poem_id": 1856,
    "vorder": 42,
    "position": 1,
    "text": "که پیش آمد از روزگار کهن"
  },
  {
    "poem_id": 1856,
    "vorder": 43,
    "position": 0,
    "text": "همی بر دل این یاد باید گرفت"
  },
  {
    "poem_id": 1856,
    "vorder": 44,
    "position": 1,
    "text": "همه رنجها باد باید گرفت"
  },
  {
    "poem_id": 1856,
    "vorder": 45,
    "position": 0,
    "text": "گرفتیم و گشتیم زین مرز باز"
  },
  {
    "poem_id": 1856,
    "vorder": 46,
    "position": 1,
    "text": "شما را مبادا به ایران نیاز"
  },
  {
    "poem_id": 1856,
    "vorder": 47,
    "position": 0,
    "text": "نگه کن کنون نا نیاکان ما"
  },
  {
    "poem_id": 1856,
    "vorder": 48,
    "position": 1,
    "text": "گزیده جهاندار و پاکان ما"
  },
  {
    "poem_id": 1856,
    "vorder": 49,
    "position": 0,
    "text": "به بیداد کردند جنگ ار بداد"
  },
  {
    "poem_id": 1856,
    "vorder": 50,
    "position": 1,
    "text": "نگر تا ز پیران که دارد بیاد"
  },
  {
    "poem_id": 1856,
    "vorder": 51,
    "position": 0,
    "text": "سزد گر بپرسد ز دانای روم"
  },
  {
    "poem_id": 1856,
    "vorder": 52,
    "position": 1,
    "text": "که این بد ز زاغ آمدست ار زبوم"
  },
  {
    "poem_id": 1856,
    "vorder": 53,
    "position": 0,
    "text": "که هرکس که در رزم شد سرفراز"
  },
  {
    "poem_id": 1856,
    "vorder": 54,
    "position": 1,
    "text": "همی ز آفریننده شد بی‌نیاز"
  },
  {
    "poem_id": 1856,
    "vorder": 55,
    "position": 0,
    "text": "نیاکان ما نامداران بدند"
  },
  {
    "poem_id": 1856,
    "vorder": 56,
    "position": 1,
    "text": "به گیتی درون کامگاران بدند"
  },
  {
    "poem_id": 1856,
    "vorder": 57,
    "position": 0,
    "text": "نبرداشتند از کسی سرکشی"
  },
  {
    "poem_id": 1856,
    "vorder": 58,
    "position": 1,
    "text": "بلندی و تندی و بی‌دانشی"
  },
  {
    "poem_id": 1856,
    "vorder": 59,
    "position": 0,
    "text": "کنون این سخنها نیارد بها"
  },
  {
    "poem_id": 1856,
    "vorder": 60,
    "position": 1,
    "text": "که باشد سراندر دم اژدها"
  },
  {
    "poem_id": 1856,
    "vorder": 61,
    "position": 0,
    "text": "یکی سوی قیصر بر از من درود"
  },
  {
    "poem_id": 1856,
    "vorder": 62,
    "position": 1,
    "text": "بگویش که گفتار بی‌تار و پود"
  },
  {
    "poem_id": 1856,
    "vorder": 63,
    "position": 0,
    "text": "بزرگان نیارند پیش خرد"
  },
  {
    "poem_id": 1856,
    "vorder": 64,
    "position": 1,
    "text": "به فرجام هم نیک و بد بگذرد"
  },
  {
    "poem_id": 1856,
    "vorder": 65,
    "position": 0,
    "text": "ازین پس نه آرام جویم نه خواب"
  },
  {
    "poem_id": 1856,
    "vorder": 66,
    "position": 1,
    "text": "مگر برکشم دامن از تیره آب"
  },
  {
    "poem_id": 1856,
    "vorder": 67,
    "position": 0,
    "text": "چو رومی نیابیم فریادرس"
  },
  {
    "poem_id": 1856,
    "vorder": 68,
    "position": 1,
    "text": "به نزدیک خاقان فرستیم کس"
  },
  {
    "poem_id": 1856,
    "vorder": 69,
    "position": 0,
    "text": "سخن هرچ گفتم همه خیره شد"
  },
  {
    "poem_id": 1856,
    "vorder": 70,
    "position": 1,
    "text": "که آب روان از بنه تیره شد"
  },
  {
    "poem_id": 1856,
    "vorder": 71,
    "position": 0,
    "text": "فرستادگانم چوآیند باز"
  },
  {
    "poem_id": 1856,
    "vorder": 72,
    "position": 1,
    "text": "بدین شارستان در نمانم دراز"
  },
  {
    "poem_id": 1856,
    "vorder": 73,
    "position": 0,
    "text": "به ایرانیان گفت فرمان کنید"
  },
  {
    "poem_id": 1856,
    "vorder": 74,
    "position": 1,
    "text": "دل خویش را زین سخن مشکنید"
  },
  {
    "poem_id": 1856,
    "vorder": 75,
    "position": 0,
    "text": "که یزدان پیروزگر یار ماست"
  },
  {
    "poem_id": 1856,
    "vorder": 76,
    "position": 1,
    "text": "جوانمردی و مردمی کارماست"
  },
  {
    "poem_id": 1856,
    "vorder": 77,
    "position": 0,
    "text": "گرفت این سخن بردل خویش خوار"
  },
  {
    "poem_id": 1856,
    "vorder": 78,
    "position": 1,
    "text": "فرستاد نامه بدست تخوار"
  },
  {
    "poem_id": 1856,
    "vorder": 79,
    "position": 0,
    "text": "برین گونه برنامه‌ای برنوشت"
  },
  {
    "poem_id": 1856,
    "vorder": 80,
    "position": 1,
    "text": "ز هرگونه‌ای اندر و خوب و زشت"
  },
  {
    "poem_id": 1856,
    "vorder": 81,
    "position": 0,
    "text": "بیامد ز نزدیک خسرو سوار"
  },
  {
    "poem_id": 1856,
    "vorder": 82,
    "position": 1,
    "text": "چنین تا در قیصر نامدار"
  }
]