[
  {
    "poem_id": 1605,
    "vorder": 1,
    "position": 0,
    "text": "همی بود بهمن به زابلستان"
  },
  {
    "poem_id": 1605,
    "vorder": 2,
    "position": 1,
    "text": "به نخچیر گر با می و گلستان"
  },
  {
    "poem_id": 1605,
    "vorder": 3,
    "position": 0,
    "text": "سواری و می خوردن و بارگاه"
  },
  {
    "poem_id": 1605,
    "vorder": 4,
    "position": 1,
    "text": "بیاموخت رستم بدان پور شاه"
  },
  {
    "poem_id": 1605,
    "vorder": 5,
    "position": 0,
    "text": "به هر چیز پیش از پسر داشتش"
  },
  {
    "poem_id": 1605,
    "vorder": 6,
    "position": 1,
    "text": "شب و روز خندان به بر داشتش"
  },
  {
    "poem_id": 1605,
    "vorder": 7,
    "position": 0,
    "text": "چو گفتار و کردار پیوسته شد"
  },
  {
    "poem_id": 1605,
    "vorder": 8,
    "position": 1,
    "text": "در کین به گشتاسپ بر بسته شد"
  },
  {
    "poem_id": 1605,
    "vorder": 9,
    "position": 0,
    "text": "یکی نامه بنوشت رستم به درد"
  },
  {
    "poem_id": 1605,
    "vorder": 10,
    "position": 1,
    "text": "همه کار فرزند او یاد کرد"
  },
  {
    "poem_id": 1605,
    "vorder": 11,
    "position": 0,
    "text": "سر نامه کرد آفرین از نخست"
  },
  {
    "poem_id": 1605,
    "vorder": 12,
    "position": 1,
    "text": "بدانکس که کینه نبودش نجست"
  },
  {
    "poem_id": 1605,
    "vorder": 13,
    "position": 0,
    "text": "دگر گفت یزدان گوای منست"
  },
  {
    "poem_id": 1605,
    "vorder": 14,
    "position": 1,
    "text": "پشوتن بدین رهنمای منست"
  },
  {
    "poem_id": 1605,
    "vorder": 15,
    "position": 0,
    "text": "که من چند گفتم به اسفندیار"
  },
  {
    "poem_id": 1605,
    "vorder": 16,
    "position": 1,
    "text": "مگر کم کند کینه و کارزار"
  },
  {
    "poem_id": 1605,
    "vorder": 17,
    "position": 0,
    "text": "سپردم بدو کشور و گنج خویش"
  },
  {
    "poem_id": 1605,
    "vorder": 18,
    "position": 1,
    "text": "گزیدم ز هرگونه‌ای رنج خویش"
  },
  {
    "poem_id": 1605,
    "vorder": 19,
    "position": 0,
    "text": "زمانش چنین بود نگشاد چهر"
  },
  {
    "poem_id": 1605,
    "vorder": 20,
    "position": 1,
    "text": "مرا دل پر از درد و سر پر ز مهر"
  },
  {
    "poem_id": 1605,
    "vorder": 21,
    "position": 0,
    "text": "بدین گونه بد گردش آسمان"
  },
  {
    "poem_id": 1605,
    "vorder": 22,
    "position": 1,
    "text": "بسنده نباشد کسی با زمان"
  },
  {
    "poem_id": 1605,
    "vorder": 23,
    "position": 0,
    "text": "کنون این جهانجوی نزد منست"
  },
  {
    "poem_id": 1605,
    "vorder": 24,
    "position": 1,
    "text": "که فرخ نژاد اورمزد منست"
  },
  {
    "poem_id": 1605,
    "vorder": 25,
    "position": 0,
    "text": "هنرهای شاهانش آموختم"
  },
  {
    "poem_id": 1605,
    "vorder": 26,
    "position": 1,
    "text": "از اندرز فام خرد توختم"
  },
  {
    "poem_id": 1605,
    "vorder": 27,
    "position": 0,
    "text": "چو پیمان کند شاه پوزش پذیر"
  },
  {
    "poem_id": 1605,
    "vorder": 28,
    "position": 1,
    "text": "کزین پس نیندیشد از کار تیر"
  },
  {
    "poem_id": 1605,
    "vorder": 29,
    "position": 0,
    "text": "نهان من و جان من پیش اوست"
  },
  {
    "poem_id": 1605,
    "vorder": 30,
    "position": 1,
    "text": "اگر گنج و تاجست و گر مغز و پوست"
  },
  {
    "poem_id": 1605,
    "vorder": 31,
    "position": 0,
    "text": "چو آن نامه شد نزد شاه جهان"
  },
  {
    "poem_id": 1605,
    "vorder": 32,
    "position": 1,
    "text": "پراگنده شد آن میان مهان"
  },
  {
    "poem_id": 1605,
    "vorder": 33,
    "position": 0,
    "text": "پشوتن بیامد گوایی بداد"
  },
  {
    "poem_id": 1605,
    "vorder": 34,
    "position": 1,
    "text": "سخنهای رستم همه کرد یاد"
  },
  {
    "poem_id": 1605,
    "vorder": 35,
    "position": 0,
    "text": "همان زاری و پند و اروند او"
  },
  {
    "poem_id": 1605,
    "vorder": 36,
    "position": 1,
    "text": "سخن گفتن از مرز و پیوند او"
  },
  {
    "poem_id": 1605,
    "vorder": 37,
    "position": 0,
    "text": "ازان نامور شاه خشنود گشت"
  },
  {
    "poem_id": 1605,
    "vorder": 38,
    "position": 1,
    "text": "گراینده را آمدن سود گشت"
  },
  {
    "poem_id": 1605,
    "vorder": 39,
    "position": 0,
    "text": "ز رستم دل نامور گشت خوش"
  },
  {
    "poem_id": 1605,
    "vorder": 40,
    "position": 1,
    "text": "نزد نیز بر دل ز تیمار تش"
  },
  {
    "poem_id": 1605,
    "vorder": 41,
    "position": 0,
    "text": "هم‌اندر زمان نامه پاسخ نوشت"
  },
  {
    "poem_id": 1605,
    "vorder": 42,
    "position": 1,
    "text": "به باغ بزرگی درختی بکشت"
  },
  {
    "poem_id": 1605,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت کز جور چرخ بلند"
  },
  {
    "poem_id": 1605,
    "vorder": 44,
    "position": 1,
    "text": "چو خواهد رسیدن کسی را گزند"
  },
  {
    "poem_id": 1605,
    "vorder": 45,
    "position": 0,
    "text": "به پرهیز چون بازدارد کسی"
  },
  {
    "poem_id": 1605,
    "vorder": 46,
    "position": 1,
    "text": "وگر سوی دانش گراید بسی"
  },
  {
    "poem_id": 1605,
    "vorder": 47,
    "position": 0,
    "text": "پشوتن بگفت آنچ درخواستی"
  },
  {
    "poem_id": 1605,
    "vorder": 48,
    "position": 1,
    "text": "دل من به خوبی بیاراستی"
  },
  {
    "poem_id": 1605,
    "vorder": 49,
    "position": 0,
    "text": "ز گردون گردان که یارد گذشت"
  },
  {
    "poem_id": 1605,
    "vorder": 50,
    "position": 1,
    "text": "خردمند گرد گذشته نگشت"
  },
  {
    "poem_id": 1605,
    "vorder": 51,
    "position": 0,
    "text": "تو آنی که بودی وزان بهتری"
  },
  {
    "poem_id": 1605,
    "vorder": 52,
    "position": 1,
    "text": "به هند و به قنوج بر مهتری"
  },
  {
    "poem_id": 1605,
    "vorder": 53,
    "position": 0,
    "text": "ز بیشی هرآنچت بباید بخواه"
  },
  {
    "poem_id": 1605,
    "vorder": 54,
    "position": 1,
    "text": "ز تخت و ز مهر و ز تیغ و کلاه"
  },
  {
    "poem_id": 1605,
    "vorder": 55,
    "position": 0,
    "text": "فرستاده پاسخ بیاورد زود"
  },
  {
    "poem_id": 1605,
    "vorder": 56,
    "position": 1,
    "text": "بدان سان که رستمش فرموده بود"
  },
  {
    "poem_id": 1605,
    "vorder": 57,
    "position": 0,
    "text": "چنین تا برآمد برین گاه چند"
  },
  {
    "poem_id": 1605,
    "vorder": 58,
    "position": 1,
    "text": "ببد شاهزاده به بالا بلند"
  },
  {
    "poem_id": 1605,
    "vorder": 59,
    "position": 0,
    "text": "خردمند و بادانش و دستگاه"
  },
  {
    "poem_id": 1605,
    "vorder": 60,
    "position": 1,
    "text": "به شاهی برافراخت فرخ کلاه"
  },
  {
    "poem_id": 1605,
    "vorder": 61,
    "position": 0,
    "text": "بدانست جاماسپ آن نیک و بد"
  },
  {
    "poem_id": 1605,
    "vorder": 62,
    "position": 1,
    "text": "که آن پادشاهی به بهمن رسد"
  },
  {
    "poem_id": 1605,
    "vorder": 63,
    "position": 0,
    "text": "به گشتاسپ گفت ای پسندیده شاه"
  },
  {
    "poem_id": 1605,
    "vorder": 64,
    "position": 1,
    "text": "ترا کرد باید به بهمن نگاه"
  },
  {
    "poem_id": 1605,
    "vorder": 65,
    "position": 0,
    "text": "ز دانش پدر هرچ جست اندر اوی"
  },
  {
    "poem_id": 1605,
    "vorder": 66,
    "position": 1,
    "text": "به جای آمد و گشت با آب‌روی"
  },
  {
    "poem_id": 1605,
    "vorder": 67,
    "position": 0,
    "text": "به بیگانه شهری فراوان بماند"
  },
  {
    "poem_id": 1605,
    "vorder": 68,
    "position": 1,
    "text": "کسی نامهٔ تو بروبر نخواند"
  },
  {
    "poem_id": 1605,
    "vorder": 69,
    "position": 0,
    "text": "به بهمن یکی نامه باید نوشت"
  },
  {
    "poem_id": 1605,
    "vorder": 70,
    "position": 1,
    "text": "بسان درختی به باغ بهشت"
  },
  {
    "poem_id": 1605,
    "vorder": 71,
    "position": 0,
    "text": "که داری به گیتی جز او یادگار"
  },
  {
    "poem_id": 1605,
    "vorder": 72,
    "position": 1,
    "text": "گسارندهٔ درد اسفندیار"
  },
  {
    "poem_id": 1605,
    "vorder": 73,
    "position": 0,
    "text": "خوش آمد سخن شاه گشتاسپ را"
  },
  {
    "poem_id": 1605,
    "vorder": 74,
    "position": 1,
    "text": "بفرمود فرخنده جاماسپ را"
  },
  {
    "poem_id": 1605,
    "vorder": 75,
    "position": 0,
    "text": "که بنویس یک نامه نزدیک اوی"
  },
  {
    "poem_id": 1605,
    "vorder": 76,
    "position": 1,
    "text": "یکی سوی گردنکش کینه‌جوی"
  },
  {
    "poem_id": 1605,
    "vorder": 77,
    "position": 0,
    "text": "که یزدان سپاس ای جهان پهلوان"
  },
  {
    "poem_id": 1605,
    "vorder": 78,
    "position": 1,
    "text": "که ما از تو شادیم و روشن‌روان"
  },
  {
    "poem_id": 1605,
    "vorder": 79,
    "position": 0,
    "text": "نبیره که از جان گرامی‌تر است"
  },
  {
    "poem_id": 1605,
    "vorder": 80,
    "position": 1,
    "text": "به دانش ز جاماسپ نامی‌تر است"
  },
  {
    "poem_id": 1605,
    "vorder": 81,
    "position": 0,
    "text": "به بخت تو آموخت فرهنگ و رای"
  },
  {
    "poem_id": 1605,
    "vorder": 82,
    "position": 1,
    "text": "سزد گر فرستی کنون باز جای"
  },
  {
    "poem_id": 1605,
    "vorder": 83,
    "position": 0,
    "text": "یکی سوی بهمن که اندر زمان"
  },
  {
    "poem_id": 1605,
    "vorder": 84,
    "position": 1,
    "text": "چو نامه بخوانی به زابل ممان"
  },
  {
    "poem_id": 1605,
    "vorder": 85,
    "position": 0,
    "text": "که ما را به دیدارت آمد نیاز"
  },
  {
    "poem_id": 1605,
    "vorder": 86,
    "position": 1,
    "text": "برآرای کار و درنگی مساز"
  },
  {
    "poem_id": 1605,
    "vorder": 87,
    "position": 0,
    "text": "به رستم چو برخواند نامه دبیر"
  },
  {
    "poem_id": 1605,
    "vorder": 88,
    "position": 1,
    "text": "بدان شاد شد مرد دانش‌پذیر"
  },
  {
    "poem_id": 1605,
    "vorder": 89,
    "position": 0,
    "text": "ز چیزی که بودش به گنج اندرون"
  },
  {
    "poem_id": 1605,
    "vorder": 90,
    "position": 1,
    "text": "ز خفتان وز خنجر آبگون"
  },
  {
    "poem_id": 1605,
    "vorder": 91,
    "position": 0,
    "text": "ز برگستوان و ز تیر و کمان"
  },
  {
    "poem_id": 1605,
    "vorder": 92,
    "position": 1,
    "text": "ز گوپال و ز خنجر هندوان"
  },
  {
    "poem_id": 1605,
    "vorder": 93,
    "position": 0,
    "text": "ز کافور وز مشک وز عود تر"
  },
  {
    "poem_id": 1605,
    "vorder": 94,
    "position": 1,
    "text": "هم از عنبر و گوهر و سیم و زر"
  },
  {
    "poem_id": 1605,
    "vorder": 95,
    "position": 0,
    "text": "ز بالا و از جامهٔ نابرید"
  },
  {
    "poem_id": 1605,
    "vorder": 96,
    "position": 1,
    "text": "پرستار وز کودکان نارسید"
  },
  {
    "poem_id": 1605,
    "vorder": 97,
    "position": 0,
    "text": "کمرهای زرین و زرین ستام"
  },
  {
    "poem_id": 1605,
    "vorder": 98,
    "position": 1,
    "text": "ز یاقوت با زنگ زرین دو جام"
  },
  {
    "poem_id": 1605,
    "vorder": 99,
    "position": 0,
    "text": "همه پاک رستم به بهمن سپرد"
  },
  {
    "poem_id": 1605,
    "vorder": 100,
    "position": 1,
    "text": "برنده به گنجور او بر شمرد"
  },
  {
    "poem_id": 1605,
    "vorder": 101,
    "position": 0,
    "text": "تهمتن بیامد دو منزل به راه"
  },
  {
    "poem_id": 1605,
    "vorder": 102,
    "position": 1,
    "text": "پس او را فرستاد نزدیک شاه"
  },
  {
    "poem_id": 1605,
    "vorder": 103,
    "position": 0,
    "text": "چو گشتاسپ روی نبیره بدید"
  },
  {
    "poem_id": 1605,
    "vorder": 104,
    "position": 1,
    "text": "شد از آب دیده رخش ناپدید"
  },
  {
    "poem_id": 1605,
    "vorder": 105,
    "position": 0,
    "text": "بدو گفت اسفندیاری تو بس"
  },
  {
    "poem_id": 1605,
    "vorder": 106,
    "position": 1,
    "text": "نمانی به گیتی جز او را به کس"
  },
  {
    "poem_id": 1605,
    "vorder": 107,
    "position": 0,
    "text": "ورا یافت روشن‌دل و یادگیر"
  },
  {
    "poem_id": 1605,
    "vorder": 108,
    "position": 1,
    "text": "ازان پس همی خواندش اردشیر"
  },
  {
    "poem_id": 1605,
    "vorder": 109,
    "position": 0,
    "text": "گوی بود با زور و گیرنده دست"
  },
  {
    "poem_id": 1605,
    "vorder": 110,
    "position": 1,
    "text": "خردمند و دانا و یزدان پرست"
  },
  {
    "poem_id": 1605,
    "vorder": 111,
    "position": 0,
    "text": "چو بر پای بودی سرانگشت اوی"
  },
  {
    "poem_id": 1605,
    "vorder": 112,
    "position": 1,
    "text": "ز زانو فزونتر بدی مشت اوی"
  },
  {
    "poem_id": 1605,
    "vorder": 113,
    "position": 0,
    "text": "همی آزمودش به یک چندگاه"
  },
  {
    "poem_id": 1605,
    "vorder": 114,
    "position": 1,
    "text": "به بزم و به رزم و به نخجیرگاه"
  },
  {
    "poem_id": 1605,
    "vorder": 115,
    "position": 0,
    "text": "به میدان چوگان و بزم و شکار"
  },
  {
    "poem_id": 1605,
    "vorder": 116,
    "position": 1,
    "text": "گوی بود مانند اسفندیار"
  },
  {
    "poem_id": 1605,
    "vorder": 117,
    "position": 0,
    "text": "ازو هیچ گشتاسپ نشکیفتی"
  },
  {
    "poem_id": 1605,
    "vorder": 118,
    "position": 1,
    "text": "به می خوردن اندرش بفریفتی"
  },
  {
    "poem_id": 1605,
    "vorder": 119,
    "position": 0,
    "text": "همی گفت کاینم جهاندار داد"
  },
  {
    "poem_id": 1605,
    "vorder": 120,
    "position": 1,
    "text": "غمی بودم از بهر تیمار داد"
  },
  {
    "poem_id": 1605,
    "vorder": 121,
    "position": 0,
    "text": "بماناد تا جاودان بهمنم"
  },
  {
    "poem_id": 1605,
    "vorder": 122,
    "position": 1,
    "text": "چو گم شد سرافراز رویین تنم"
  },
  {
    "poem_id": 1605,
    "vorder": 123,
    "position": 0,
    "text": "سرآمد همه کار اسفندیار"
  },
  {
    "poem_id": 1605,
    "vorder": 124,
    "position": 1,
    "text": "که جاوید بادا سر شهریار"
  },
  {
    "poem_id": 1605,
    "vorder": 125,
    "position": 0,
    "text": "همیشه دل از رنج پرداخته"
  },
  {
    "poem_id": 1605,
    "vorder": 126,
    "position": 1,
    "text": "زمانه به فرمان او ساخته"
  },
  {
    "poem_id": 1605,
    "vorder": 127,
    "position": 0,
    "text": "دلش باد شادان و تاجش بلند"
  },
  {
    "poem_id": 1605,
