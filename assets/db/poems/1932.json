[
  {
    "poem_id": 1932,
    "vorder": 1,
    "position": 0,
    "text": "وزان جایگه برکشیدند کوس"
  },
  {
    "poem_id": 1932,
    "vorder": 2,
    "position": 1,
    "text": "ز بُست و نشاپور شد تا به طوس"
  },
  {
    "poem_id": 1932,
    "vorder": 3,
    "position": 0,
    "text": "خبر یافت ماهوی سوری ز شاه"
  },
  {
    "poem_id": 1932,
    "vorder": 4,
    "position": 1,
    "text": "که تا مرز طوس اندر آمد سپاه"
  },
  {
    "poem_id": 1932,
    "vorder": 5,
    "position": 0,
    "text": "پذیره شدش با سپاه گران"
  },
  {
    "poem_id": 1932,
    "vorder": 6,
    "position": 1,
    "text": "همه نیزه‌داران جوشن‌وران"
  },
  {
    "poem_id": 1932,
    "vorder": 7,
    "position": 0,
    "text": "چو پیدا شد آن فر و اورند شاه"
  },
  {
    "poem_id": 1932,
    "vorder": 8,
    "position": 1,
    "text": "درفش بزرگی و چندان سپاه"
  },
  {
    "poem_id": 1932,
    "vorder": 9,
    "position": 0,
    "text": "پیاده شد از باره ماهوی زود"
  },
  {
    "poem_id": 1932,
    "vorder": 10,
    "position": 1,
    "text": "بران کهتری بندگیها فزود"
  },
  {
    "poem_id": 1932,
    "vorder": 11,
    "position": 0,
    "text": "همی‌رفت نرم از بر خاک گرم"
  },
  {
    "poem_id": 1932,
    "vorder": 12,
    "position": 1,
    "text": "دو دیده پر از آب کرده ز شرم"
  },
  {
    "poem_id": 1932,
    "vorder": 13,
    "position": 0,
    "text": "زمین را ببوسید و بردش نماز"
  },
  {
    "poem_id": 1932,
    "vorder": 14,
    "position": 1,
    "text": "همی‌بود پیشش زمانی دراز"
  },
  {
    "poem_id": 1932,
    "vorder": 15,
    "position": 0,
    "text": "فرخ‌زاد چون روی ماهوی دید"
  },
  {
    "poem_id": 1932,
    "vorder": 16,
    "position": 1,
    "text": "سپاهی بران سان رده برکشید"
  },
  {
    "poem_id": 1932,
    "vorder": 17,
    "position": 0,
    "text": "ز ماهوی سوری دلش گشت شاد"
  },
  {
    "poem_id": 1932,
    "vorder": 18,
    "position": 1,
    "text": "برو بر بسی پندها کرد یاد"
  },
  {
    "poem_id": 1932,
    "vorder": 19,
    "position": 0,
    "text": "که این شاه را از نژاد کیان"
  },
  {
    "poem_id": 1932,
    "vorder": 20,
    "position": 1,
    "text": "سپردم تو را تا ببندی میان"
  },
  {
    "poem_id": 1932,
    "vorder": 21,
    "position": 0,
    "text": "نباید که بادی برو بر جهد"
  },
  {
    "poem_id": 1932,
    "vorder": 22,
    "position": 1,
    "text": "وگر خود سپاسی برو برنهد"
  },
  {
    "poem_id": 1932,
    "vorder": 23,
    "position": 0,
    "text": "مرا رفت باید همی سوی ری"
  },
  {
    "poem_id": 1932,
    "vorder": 24,
    "position": 1,
    "text": "ندانم که کی بینم این تاج کی"
  },
  {
    "poem_id": 1932,
    "vorder": 25,
    "position": 0,
    "text": "که چون من فراوان به آوردگاه"
  },
  {
    "poem_id": 1932,
    "vorder": 26,
    "position": 1,
    "text": "شد از جنگ آن نیزه‌داران تباه"
  },
  {
    "poem_id": 1932,
    "vorder": 27,
    "position": 0,
    "text": "چو رستم سواری به گیتی نبود"
  },
  {
    "poem_id": 1932,
    "vorder": 28,
    "position": 1,
    "text": "نه گوش خردمند هرگز شنود"
  },
  {
    "poem_id": 1932,
    "vorder": 29,
    "position": 0,
    "text": "بدست یکی زاغ‌سر کشته شد"
  },
  {
    "poem_id": 1932,
    "vorder": 30,
    "position": 1,
    "text": "به من بر چنین روز برگشته شد"
  },
  {
    "poem_id": 1932,
    "vorder": 31,
    "position": 0,
    "text": "که یزدان ورا جای نیکان دهاد"
  },
  {
    "poem_id": 1932,
    "vorder": 32,
    "position": 1,
    "text": "سیه‌زاغ را درد پیکان دهاد"
  },
  {
    "poem_id": 1932,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت ماهوی کای پهلوان"
  },
  {
    "poem_id": 1932,
    "vorder": 34,
    "position": 1,
    "text": "مرا شاه چشمست و روشن روان"
  },
  {
    "poem_id": 1932,
    "vorder": 35,
    "position": 0,
    "text": "پذیرفتم این زینهار تو را"
  },
  {
    "poem_id": 1932,
    "vorder": 36,
    "position": 1,
    "text": "سپهر تو را شهریار تو را"
  },
  {
    "poem_id": 1932,
    "vorder": 37,
    "position": 0,
    "text": "فرخ‌زاد هرمزد زان جایگاه"
  },
  {
    "poem_id": 1932,
    "vorder": 38,
    "position": 1,
    "text": "سوی ری بیامد به فرمان شاه"
  },
  {
    "poem_id": 1932,
    "vorder": 39,
    "position": 0,
    "text": "برین نیز بگذشت چندی سپهر"
  },
  {
    "poem_id": 1932,
    "vorder": 40,
    "position": 1,
    "text": "جدا شد ز مغز بداَندیش مهر"
  },
  {
    "poem_id": 1932,
    "vorder": 41,
    "position": 0,
    "text": "شبان را همی تخت کرد آرزوی"
  },
  {
    "poem_id": 1932,
    "vorder": 42,
    "position": 1,
    "text": "دگرگونه‌تر شد به آیین و خوی"
  },
  {
    "poem_id": 1932,
    "vorder": 43,
    "position": 0,
    "text": "تن خویش یک چند بیمار کرد"
  },
  {
    "poem_id": 1932,
    "vorder": 44,
    "position": 1,
    "text": "پرستیدن شاه دشوار کرد"
  }
]