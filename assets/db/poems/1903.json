[
  {
    "poem_id": 1903,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس فزون شد بزرگی شاه"
  },
  {
    "poem_id": 1903,
    "vorder": 2,
    "position": 1,
    "text": "که خورشید شد آن کجا بود ماه"
  },
  {
    "poem_id": 1903,
    "vorder": 3,
    "position": 0,
    "text": "همه روز با دخت قیصر بدی"
  },
  {
    "poem_id": 1903,
    "vorder": 4,
    "position": 1,
    "text": "همو بر شبستانش مهتر بدی"
  },
  {
    "poem_id": 1903,
    "vorder": 5,
    "position": 0,
    "text": "ز مریم همی‌بود شیرین بدرد"
  },
  {
    "poem_id": 1903,
    "vorder": 6,
    "position": 1,
    "text": "همیشه ز رشکش دو رخساره زرد"
  },
  {
    "poem_id": 1903,
    "vorder": 7,
    "position": 0,
    "text": "به فرجام شیرین ورا زهر داد"
  },
  {
    "poem_id": 1903,
    "vorder": 8,
    "position": 1,
    "text": "شد آن نامور دخت قیصرنژاد"
  },
  {
    "poem_id": 1903,
    "vorder": 9,
    "position": 0,
    "text": "ازان چاره آگه نبد هیچ‌کس"
  },
  {
    "poem_id": 1903,
    "vorder": 10,
    "position": 1,
    "text": "که او داشت آن راز تنها و بس"
  },
  {
    "poem_id": 1903,
    "vorder": 11,
    "position": 0,
    "text": "چو سالی برآمد که مریم بمرد"
  },
  {
    "poem_id": 1903,
    "vorder": 12,
    "position": 1,
    "text": "شبستان زرین به شیرین سپرد"
  },
  {
    "poem_id": 1903,
    "vorder": 13,
    "position": 0,
    "text": "چو شیرویه را سال شد بر دو هشت"
  },
  {
    "poem_id": 1903,
    "vorder": 14,
    "position": 1,
    "text": "به بالا زسی سالگان برگذشت"
  },
  {
    "poem_id": 1903,
    "vorder": 15,
    "position": 0,
    "text": "بیاورد فرزانگان را پدر"
  },
  {
    "poem_id": 1903,
    "vorder": 16,
    "position": 1,
    "text": "بدان تا شود نامور پر هنر"
  },
  {
    "poem_id": 1903,
    "vorder": 17,
    "position": 0,
    "text": "همی‌داشت موبد مر او را نگاه"
  },
  {
    "poem_id": 1903,
    "vorder": 18,
    "position": 1,
    "text": "شب و روز شادان به فرمان شاه"
  },
  {
    "poem_id": 1903,
    "vorder": 19,
    "position": 0,
    "text": "چنان بد که یک روز موبد ز تخت"
  },
  {
    "poem_id": 1903,
    "vorder": 20,
    "position": 1,
    "text": "بیامد به نزدیک آن نیک بخت"
  },
  {
    "poem_id": 1903,
    "vorder": 21,
    "position": 0,
    "text": "چو آمد به نزدیک شیرویه باز"
  },
  {
    "poem_id": 1903,
    "vorder": 22,
    "position": 1,
    "text": "همیشه به بازیش بودی نیاز"
  },
  {
    "poem_id": 1903,
    "vorder": 23,
    "position": 0,
    "text": "یکی دفتری دید پیش اندرش"
  },
  {
    "poem_id": 1903,
    "vorder": 24,
    "position": 1,
    "text": "نوشته کلیله بران دفترش"
  },
  {
    "poem_id": 1903,
    "vorder": 25,
    "position": 0,
    "text": "بدست چپ آن جوان سترگ"
  },
  {
    "poem_id": 1903,
    "vorder": 26,
    "position": 1,
    "text": "بریده یکی خشک چنگال گرگ"
  },
  {
    "poem_id": 1903,
    "vorder": 27,
    "position": 0,
    "text": "سروی سر گاومیشی براست"
  },
  {
    "poem_id": 1903,
    "vorder": 28,
    "position": 1,
    "text": "همی این بران بر زدی چونک خواست"
  },
  {
    "poem_id": 1903,
    "vorder": 29,
    "position": 0,
    "text": "غمی شد دل موبد از کاراوی"
  },
  {
    "poem_id": 1903,
    "vorder": 30,
    "position": 1,
    "text": "ز بازی و بیهوده کردار اوی"
  },
  {
    "poem_id": 1903,
    "vorder": 31,
    "position": 0,
    "text": "به فالش بد آمد هم آن چنگ گرگ"
  },
  {
    "poem_id": 1903,
    "vorder": 32,
    "position": 1,
    "text": "شخ گاو و رای جوان سترگ"
  },
  {
    "poem_id": 1903,
    "vorder": 33,
    "position": 0,
    "text": "ز کار زمانه غمی گشت سخت"
  },
  {
    "poem_id": 1903,
    "vorder": 34,
    "position": 1,
    "text": "ازان برمنش کودک شور بخت"
  },
  {
    "poem_id": 1903,
    "vorder": 35,
    "position": 0,
    "text": "کجا طالع زادنش دیده بود"
  },
  {
    "poem_id": 1903,
    "vorder": 36,
    "position": 1,
    "text": "ز دستور وگنجور بشنیده بود"
  },
  {
    "poem_id": 1903,
    "vorder": 37,
    "position": 0,
    "text": "سوی موبد موبد آمد بگفت"
  },
  {
    "poem_id": 1903,
    "vorder": 38,
    "position": 1,
    "text": "که بازیست باآن گرانمایه جفت"
  },
  {
    "poem_id": 1903,
    "vorder": 39,
    "position": 0,
    "text": "بشد زود موبد بگفت آن به شاه"
  },
  {
    "poem_id": 1903,
    "vorder": 40,
    "position": 1,
    "text": "همی‌داشت خسرو مر او را نگاه"
  },
  {
    "poem_id": 1903,
    "vorder": 41,
    "position": 0,
    "text": "ز فرزند رنگ رخش زرد شد"
  },
  {
    "poem_id": 1903,
    "vorder": 42,
    "position": 1,
    "text": "ز کار زمانه پراز درد شد"
  },
  {
    "poem_id": 1903,
    "vorder": 43,
    "position": 0,
    "text": "ز گفتار مرد ستاره شمر"
  },
  {
    "poem_id": 1903,
    "vorder": 44,
    "position": 1,
    "text": "دلش بود پر درد و پیچان جگر"
  },
  {
    "poem_id": 1903,
    "vorder": 45,
    "position": 0,
    "text": "همی‌گفت تا کردگار سپهر"
  },
  {
    "poem_id": 1903,
    "vorder": 46,
    "position": 1,
    "text": "چگونه نماید بدین کرده چهر"
  },
  {
    "poem_id": 1903,
    "vorder": 47,
    "position": 0,
    "text": "چو بر پادشاهیش بیست وسه سال"
  },
  {
    "poem_id": 1903,
    "vorder": 48,
    "position": 1,
    "text": "گذر کرد شیرویه بفراخت یال"
  },
  {
    "poem_id": 1903,
    "vorder": 49,
    "position": 0,
    "text": "بیازرد زو شهریار بزرگ"
  },
  {
    "poem_id": 1903,
    "vorder": 50,
    "position": 1,
    "text": "که کودک جوان بود و گشته سترگ"
  },
  {
    "poem_id": 1903,
    "vorder": 51,
    "position": 0,
    "text": "پر از درد شد جان خندان اوی"
  },
  {
    "poem_id": 1903,
    "vorder": 52,
    "position": 1,
    "text": "وز ایوان او کرد زندان اوی"
  },
  {
    "poem_id": 1903,
    "vorder": 53,
    "position": 0,
    "text": "هم آن را که پیوستهٔ اوبدند"
  },
  {
    "poem_id": 1903,
    "vorder": 54,
    "position": 1,
    "text": "گه رای جستن براو شدند"
  },
  {
    "poem_id": 1903,
    "vorder": 55,
    "position": 0,
    "text": "بسی دیگر از مهتر و کهتران"
  },
  {
    "poem_id": 1903,
    "vorder": 56,
    "position": 1,
    "text": "که بودند با او ببندگران"
  },
  {
    "poem_id": 1903,
    "vorder": 57,
    "position": 0,
    "text": "همی‌برگرفتند زیشان شمار"
  },
  {
    "poem_id": 1903,
    "vorder": 58,
    "position": 1,
    "text": "که پرسه فزون آمد از سه هزار"
  },
  {
    "poem_id": 1903,
    "vorder": 59,
    "position": 0,
    "text": "همه کاخها رایک اندر دگر"
  },
  {
    "poem_id": 1903,
    "vorder": 60,
    "position": 1,
    "text": "برید آنک بد شاه را کارگر"
  },
  {
    "poem_id": 1903,
    "vorder": 61,
    "position": 0,
    "text": "ز پوشیدنیها و از خوردنی"
  },
  {
    "poem_id": 1903,
    "vorder": 62,
    "position": 1,
    "text": "ز بخشیدنی هم ز گستردنی"
  },
  {
    "poem_id": 1903,
    "vorder": 63,
    "position": 0,
    "text": "به ایوانهاشان بیاراستند"
  },
  {
    "poem_id": 1903,
    "vorder": 64,
    "position": 1,
    "text": "پرستنده و بندگان خواستند"
  },
  {
    "poem_id": 1903,
    "vorder": 65,
    "position": 0,
    "text": "همان می‌فرستاد و رامشگران"
  },
  {
    "poem_id": 1903,
    "vorder": 66,
    "position": 1,
    "text": "همه کاخ دینار بد بی‌کران"
  },
  {
    "poem_id": 1903,
    "vorder": 67,
    "position": 0,
    "text": "به هنگامشان رامش و خورد بود"
  },
  {
    "poem_id": 1903,
    "vorder": 68,
    "position": 1,
    "text": "نگهبان ایشان چهل مرد بود"
  }
]