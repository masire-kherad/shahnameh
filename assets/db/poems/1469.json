[
  {
    "poem_id": 1469,
    "vorder": 1,
    "position": 0,
    "text": "دگر روز فرمود تا گیو و طوس"
  },
  {
    "poem_id": 1469,
    "vorder": 2,
    "position": 1,
    "text": "ببستند شبگیر بر پیل کوس"
  },
  {
    "poem_id": 1469,
    "vorder": 3,
    "position": 0,
    "text": "در گنج بگشاد و روزی بداد"
  },
  {
    "poem_id": 1469,
    "vorder": 4,
    "position": 1,
    "text": "سپه برنشاند و بنه برنهاد"
  },
  {
    "poem_id": 1469,
    "vorder": 5,
    "position": 0,
    "text": "سپردار و جوشنوران صد هزار"
  },
  {
    "poem_id": 1469,
    "vorder": 6,
    "position": 1,
    "text": "شمرده به لشکر گه آمد سوار"
  },
  {
    "poem_id": 1469,
    "vorder": 7,
    "position": 0,
    "text": "یکی لشکر آمد ز پهلو به دشت"
  },
  {
    "poem_id": 1469,
    "vorder": 8,
    "position": 1,
    "text": "که از گرد ایشان هوا تیره گشت"
  },
  {
    "poem_id": 1469,
    "vorder": 9,
    "position": 0,
    "text": "سراپرده و خیمه زد بر دو میل"
  },
  {
    "poem_id": 1469,
    "vorder": 10,
    "position": 1,
    "text": "بپوشید گیتی به نعل و به پیل"
  },
  {
    "poem_id": 1469,
    "vorder": 11,
    "position": 0,
    "text": "هوا نیلگون گشت و کوه آبنوس"
  },
  {
    "poem_id": 1469,
    "vorder": 12,
    "position": 1,
    "text": "بجوشید دریا ز آواز کوس"
  },
  {
    "poem_id": 1469,
    "vorder": 13,
    "position": 0,
    "text": "همی رفت منزل به منزل جهان"
  },
  {
    "poem_id": 1469,
    "vorder": 14,
    "position": 1,
    "text": "شده چون شب و روز گشته نهان"
  },
  {
    "poem_id": 1469,
    "vorder": 15,
    "position": 0,
    "text": "درخشیدن خشت و ژوپین ز گرد"
  },
  {
    "poem_id": 1469,
    "vorder": 16,
    "position": 1,
    "text": "چو آتش پس پردهٔ لاجورد"
  },
  {
    "poem_id": 1469,
    "vorder": 17,
    "position": 0,
    "text": "ز بس گونه‌گونه سنان و درفش"
  },
  {
    "poem_id": 1469,
    "vorder": 18,
    "position": 1,
    "text": "سپرهای زرین و زرینه کفش"
  },
  {
    "poem_id": 1469,
    "vorder": 19,
    "position": 0,
    "text": "تو گفتی که ابری به رنگ آبنوس"
  },
  {
    "poem_id": 1469,
    "vorder": 20,
    "position": 1,
    "text": "برآمد ببارید زو سندروس"
  },
  {
    "poem_id": 1469,
    "vorder": 21,
    "position": 0,
    "text": "جهان را شب و روز پیدا نبود"
  },
  {
    "poem_id": 1469,
    "vorder": 22,
    "position": 1,
    "text": "تو گفتی سپهر و ثریا نبود"
  },
  {
    "poem_id": 1469,
    "vorder": 23,
    "position": 0,
    "text": "ازینسان بشد تا در دژ رسید"
  },
  {
    "poem_id": 1469,
    "vorder": 24,
    "position": 1,
    "text": "بشد خاک و سنگ از جهان ناپدید"
  },
  {
    "poem_id": 1469,
    "vorder": 25,
    "position": 0,
    "text": "خروشی بلند آمد از دیدگاه"
  },
  {
    "poem_id": 1469,
    "vorder": 26,
    "position": 1,
    "text": "به سهراب گفتند کامد سپاه"
  },
  {
    "poem_id": 1469,
    "vorder": 27,
    "position": 0,
    "text": "چو سهراب زان دیده آوا شنید"
  },
  {
    "poem_id": 1469,
    "vorder": 28,
    "position": 1,
    "text": "به باره بیامد سپه بنگرید"
  },
  {
    "poem_id": 1469,
    "vorder": 29,
    "position": 0,
    "text": "به انگشت لشکر به هومان نمود"
  },
  {
    "poem_id": 1469,
    "vorder": 30,
    "position": 1,
    "text": "سپاهی که آن را کرانه نبود"
  },
  {
    "poem_id": 1469,
    "vorder": 31,
    "position": 0,
    "text": "چو هومان ز دور آن سپه را بدید"
  },
  {
    "poem_id": 1469,
    "vorder": 32,
    "position": 1,
    "text": "دلش گشت پربیم و دم درکشید"
  },
  {
    "poem_id": 1469,
    "vorder": 33,
    "position": 0,
    "text": "به هومان چنین گفت سهراب گرد"
  },
  {
    "poem_id": 1469,
    "vorder": 34,
    "position": 1,
    "text": "که اندیشه از دل بباید سترد"
  },
  {
    "poem_id": 1469,
    "vorder": 35,
    "position": 0,
    "text": "نبینی تو زین لشکر بیکران"
  },
  {
    "poem_id": 1469,
    "vorder": 36,
    "position": 1,
    "text": "یکی مرد جنگی و گرزی گران"
  },
  {
    "poem_id": 1469,
    "vorder": 37,
    "position": 0,
    "text": "که پیش من آید به آوردگاه"
  },
  {
    "poem_id": 1469,
    "vorder": 38,
    "position": 1,
    "text": "گر ایدون که یاری دهد هور و ماه"
  },
  {
    "poem_id": 1469,
    "vorder": 39,
    "position": 0,
    "text": "سلیح‌ست بسیار و مردم بسی"
  },
  {
    "poem_id": 1469,
    "vorder": 40,
    "position": 1,
    "text": "سرافراز نامی ندانم کسی"
  },
  {
    "poem_id": 1469,
    "vorder": 41,
    "position": 0,
    "text": "کنون من به بخت رد افراسیاب"
  },
  {
    "poem_id": 1469,
    "vorder": 42,
    "position": 1,
    "text": "کنم دشت را همچو دریای آب"
  },
  {
    "poem_id": 1469,
    "vorder": 43,
    "position": 0,
    "text": "به تنگی نداد ایچ سهراب دل"
  },
  {
    "poem_id": 1469,
    "vorder": 44,
    "position": 1,
    "text": "فرود آمد از باره شاداب دل"
  },
  {
    "poem_id": 1469,
    "vorder": 45,
    "position": 0,
    "text": "یکی جام می‌خواست از می‌گسار"
  },
  {
    "poem_id": 1469,
    "vorder": 46,
    "position": 1,
    "text": "نکرد ایچ رنجه دل از کارزار"
  },
  {
    "poem_id": 1469,
    "vorder": 47,
    "position": 0,
    "text": "وزانسو سراپردهٔ شهریار"
  },
  {
    "poem_id": 1469,
    "vorder": 48,
    "position": 1,
    "text": "کشیدند بر دشت پیش حصار"
  },
  {
    "poem_id": 1469,
    "vorder": 49,
    "position": 0,
    "text": "ز بس خیمه و مرد و پرده‌سرای"
  },
  {
    "poem_id": 1469,
    "vorder": 50,
    "position": 1,
    "text": "نماند ایچ بر دشت و بر کوه جای"
  }
]