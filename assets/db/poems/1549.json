[
  {
    "poem_id": 1549,
    "vorder": 1,
    "position": 0,
    "text": "بدان روزگار اندر اسفندیار"
  },
  {
    "poem_id": 1549,
    "vorder": 2,
    "position": 1,
    "text": "به دشت اندرون بد ز بهر شکار"
  },
  {
    "poem_id": 1549,
    "vorder": 3,
    "position": 0,
    "text": "ازان دشت آواز کردش کسی"
  },
  {
    "poem_id": 1549,
    "vorder": 4,
    "position": 1,
    "text": "که جاماسپ را کرد خسرو گسی"
  },
  {
    "poem_id": 1549,
    "vorder": 5,
    "position": 0,
    "text": "چو آن بانگ بشنید آمد شگفت"
  },
  {
    "poem_id": 1549,
    "vorder": 6,
    "position": 1,
    "text": "بپیچید و خندیدن اندر گرفت"
  },
  {
    "poem_id": 1549,
    "vorder": 7,
    "position": 0,
    "text": "پسر بود او را گزیده چهار"
  },
  {
    "poem_id": 1549,
    "vorder": 8,
    "position": 1,
    "text": "همه رزم‌جوی و همه نیزه‌دار"
  },
  {
    "poem_id": 1549,
    "vorder": 9,
    "position": 0,
    "text": "یکی نام بهمن دوم مهرنوش"
  },
  {
    "poem_id": 1549,
    "vorder": 10,
    "position": 1,
    "text": "سیم نام او بد دلافروز طوش"
  },
  {
    "poem_id": 1549,
    "vorder": 11,
    "position": 0,
    "text": "چهارم بدش نام نوشاذرا"
  },
  {
    "poem_id": 1549,
    "vorder": 12,
    "position": 1,
    "text": "نهادی کجا گنبد آذرا"
  },
  {
    "poem_id": 1549,
    "vorder": 13,
    "position": 0,
    "text": "به شاه جهان گفت بهمن پسر"
  },
  {
    "poem_id": 1549,
    "vorder": 14,
    "position": 1,
    "text": "که تا جاودان سبز بادات سر"
  },
  {
    "poem_id": 1549,
    "vorder": 15,
    "position": 0,
    "text": "یکی ژرف خنده بخندید شاه"
  },
  {
    "poem_id": 1549,
    "vorder": 16,
    "position": 1,
    "text": "نیابم همی اندرین هیچ راه"
  },
  {
    "poem_id": 1549,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت پورا بدین روزگار"
  },
  {
    "poem_id": 1549,
    "vorder": 18,
    "position": 1,
    "text": "کس آید مرا از در شهریار"
  },
  {
    "poem_id": 1549,
    "vorder": 19,
    "position": 0,
    "text": "که آواز بشنیدم از ناگهان"
  },
  {
    "poem_id": 1549,
    "vorder": 20,
    "position": 1,
    "text": "بترسم که از گفتهٔ بی‌رهان"
  },
  {
    "poem_id": 1549,
    "vorder": 21,
    "position": 0,
    "text": "ز من خسرو آزار دارد همی"
  },
  {
    "poem_id": 1549,
    "vorder": 22,
    "position": 1,
    "text": "دلش از رهی بار دارد همی"
  },
  {
    "poem_id": 1549,
    "vorder": 23,
    "position": 0,
    "text": "گرانمایه فرزند گفتا چرا"
  },
  {
    "poem_id": 1549,
    "vorder": 24,
    "position": 1,
    "text": "چه کردی تو با خسرو کشورا"
  },
  {
    "poem_id": 1549,
    "vorder": 25,
    "position": 0,
    "text": "سر شهریارانش گفت ای پسر"
  },
  {
    "poem_id": 1549,
    "vorder": 26,
    "position": 1,
    "text": "ندانم گناهی به جای پدر"
  },
  {
    "poem_id": 1549,
    "vorder": 27,
    "position": 0,
    "text": "مگر آنک تا دین بیاموختم"
  },
  {
    "poem_id": 1549,
    "vorder": 28,
    "position": 1,
    "text": "همی در جهان آتش افروختم"
  },
  {
    "poem_id": 1549,
    "vorder": 29,
    "position": 0,
    "text": "جهان ویژه کردم به برنده تیغ"
  },
  {
    "poem_id": 1549,
    "vorder": 30,
    "position": 1,
    "text": "چرا دارد از من دل شاه میغ"
  },
  {
    "poem_id": 1549,
    "vorder": 31,
    "position": 0,
    "text": "همانا دلش دیو بفریفتست"
  },
  {
    "poem_id": 1549,
    "vorder": 32,
    "position": 1,
    "text": "که بر کشتن من بیاشیفتست"
  },
  {
    "poem_id": 1549,
    "vorder": 33,
    "position": 0,
    "text": "همی تا بدین اندرون بود شاه"
  },
  {
    "poem_id": 1549,
    "vorder": 34,
    "position": 1,
    "text": "پدید آمد از دور گرد سیاه"
  },
  {
    "poem_id": 1549,
    "vorder": 35,
    "position": 0,
    "text": "چراغ جهان بود دستور شاه"
  },
  {
    "poem_id": 1549,
    "vorder": 36,
    "position": 1,
    "text": "فرستادهٔ شاه زی پور شاه"
  },
  {
    "poem_id": 1549,
    "vorder": 37,
    "position": 0,
    "text": "چو از دور دیدش ز کهسار گرد"
  },
  {
    "poem_id": 1549,
    "vorder": 38,
    "position": 1,
    "text": "بدانست کامد فرستاده مرد"
  },
  {
    "poem_id": 1549,
    "vorder": 39,
    "position": 0,
    "text": "پذیره شدش گرد فرزند شاه"
  },
  {
    "poem_id": 1549,
    "vorder": 40,
    "position": 1,
    "text": "همی بود تا او بیامد ز راه"
  },
  {
    "poem_id": 1549,
    "vorder": 41,
    "position": 0,
    "text": "ز بارهٔ چمنده فرود آمدند"
  },
  {
    "poem_id": 1549,
    "vorder": 42,
    "position": 1,
    "text": "گو پیر هر دو پیاده شدند"
  },
  {
    "poem_id": 1549,
    "vorder": 43,
    "position": 0,
    "text": "بپرسید ازو فرخ اسفندیار"
  },
  {
    "poem_id": 1549,
    "vorder": 44,
    "position": 1,
    "text": "که چونست شاه آن گو نامدار"
  },
  {
    "poem_id": 1549,
    "vorder": 45,
    "position": 0,
    "text": "خردمند گفتا درستست و شاد"
  },
  {
    "poem_id": 1549,
    "vorder": 46,
    "position": 1,
    "text": "برش را ببوسید و نامه بداد"
  },
  {
    "poem_id": 1549,
    "vorder": 47,
    "position": 0,
    "text": "درست از همه کارش آگاه کرد"
  },
  {
    "poem_id": 1549,
    "vorder": 48,
    "position": 1,
    "text": "که مر شاه را دیو بی‌راه کرد"
  },
  {
    "poem_id": 1549,
    "vorder": 49,
    "position": 0,
    "text": "خردمند را گفتش اسفندیار"
  },
  {
    "poem_id": 1549,
    "vorder": 50,
    "position": 1,
    "text": "چه بینی مرا اندرین روی کار"
  },
  {
    "poem_id": 1549,
    "vorder": 51,
    "position": 0,
    "text": "گر ایدونک با تو بیایم به در"
  },
  {
    "poem_id": 1549,
    "vorder": 52,
    "position": 1,
    "text": "نه نیکو کند کار با من پدر"
  },
  {
    "poem_id": 1549,
    "vorder": 53,
    "position": 0,
    "text": "ور ایدونک نایم به فرمانبری"
  },
  {
    "poem_id": 1549,
    "vorder": 54,
    "position": 1,
    "text": "برون کرده باشم سر از کهتری"
  },
  {
    "poem_id": 1549,
    "vorder": 55,
    "position": 0,
    "text": "یکی چاره‌ساز ای خردمند پیر"
  },
  {
    "poem_id": 1549,
    "vorder": 56,
    "position": 1,
    "text": "نیابد چنین ماند بر خیره خیر"
  },
  {
    "poem_id": 1549,
    "vorder": 57,
    "position": 0,
    "text": "خردمند گفت ای شه پهلوان"
  },
  {
    "poem_id": 1549,
    "vorder": 58,
    "position": 1,
    "text": "به دانندگی پیر و بختت جوان"
  },
  {
    "poem_id": 1549,
    "vorder": 59,
    "position": 0,
    "text": "تو دانی که خشم پدر بر پسر"
  },
  {
    "poem_id": 1549,
    "vorder": 60,
    "position": 1,
    "text": "به از جور مهتر پسر بر پدر"
  },
  {
    "poem_id": 1549,
    "vorder": 61,
    "position": 0,
    "text": "ببایدت رفتن چنینست روی"
  },
  {
    "poem_id": 1549,
    "vorder": 62,
    "position": 1,
    "text": "که هرچ او کند پادشاهست اوی"
  },
  {
    "poem_id": 1549,
    "vorder": 63,
    "position": 0,
    "text": "برین بر نهادند و گشتند باز"
  },
  {
    "poem_id": 1549,
    "vorder": 64,
    "position": 1,
    "text": "فرستاده و پور خسرو نیاز"
  },
  {
    "poem_id": 1549,
    "vorder": 65,
    "position": 0,
    "text": "یکی جای خوبش فرود آورید"
  },
  {
    "poem_id": 1549,
    "vorder": 66,
    "position": 1,
    "text": "به کف بر گرفتند هر دو نبید"
  },
  {
    "poem_id": 1549,
    "vorder": 67,
    "position": 0,
    "text": "به پیشش همی عود می‌سوختند"
  },
  {
    "poem_id": 1549,
    "vorder": 68,
    "position": 1,
    "text": "تو گفتی همی آتش افروختند"
  },
  {
    "poem_id": 1549,
    "vorder": 69,
    "position": 0,
    "text": "دگر روز بنشست بر تخت خویش"
  },
  {
    "poem_id": 1549,
    "vorder": 70,
    "position": 1,
    "text": "ز لشکر بیامد فراوان به پیش"
  },
  {
    "poem_id": 1549,
    "vorder": 71,
    "position": 0,
    "text": "همه لشکرش را به بهمن سپرد"
  },
  {
    "poem_id": 1549,
    "vorder": 72,
    "position": 1,
    "text": "وزانجا خرامید با چند گرد"
  },
  {
    "poem_id": 1549,
    "vorder": 73,
    "position": 0,
    "text": "بیامد به درگاه آزاد شاه"
  },
  {
    "poem_id": 1549,
    "vorder": 74,
    "position": 1,
    "text": "کمر بسته و بر نهاده کلاه"
  }
]