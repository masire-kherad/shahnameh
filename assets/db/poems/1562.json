[
  {
    "poem_id": 1562,
    "vorder": 1,
    "position": 0,
    "text": "غم آمد همه بهرهٔ گرگسار"
  },
  {
    "poem_id": 1562,
    "vorder": 2,
    "position": 1,
    "text": "ز گرگان جنگی و اسفندیار"
  },
  {
    "poem_id": 1562,
    "vorder": 3,
    "position": 0,
    "text": "یکی خوان زرین بیاراستند"
  },
  {
    "poem_id": 1562,
    "vorder": 4,
    "position": 1,
    "text": "خورشها بخوردند و می خواستند"
  },
  {
    "poem_id": 1562,
    "vorder": 5,
    "position": 0,
    "text": "بفرمود تا بسته را پیش اوی"
  },
  {
    "poem_id": 1562,
    "vorder": 6,
    "position": 1,
    "text": "ببردند لرزان و پرآب روی"
  },
  {
    "poem_id": 1562,
    "vorder": 7,
    "position": 0,
    "text": "سه جام میش داد و پرسش گرفت"
  },
  {
    "poem_id": 1562,
    "vorder": 8,
    "position": 1,
    "text": "که اکنون چه گویی چه بینم شگفت"
  },
  {
    "poem_id": 1562,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت با نامور گرگسار"
  },
  {
    "poem_id": 1562,
    "vorder": 10,
    "position": 1,
    "text": "که ای نامور شیردل شهریار"
  },
  {
    "poem_id": 1562,
    "vorder": 11,
    "position": 0,
    "text": "دگر منزلت شیری آید به جنگ"
  },
  {
    "poem_id": 1562,
    "vorder": 12,
    "position": 1,
    "text": "که با جنگ او برنتابد نهنگ"
  },
  {
    "poem_id": 1562,
    "vorder": 13,
    "position": 0,
    "text": "عقاب دلاور بر آن راه شیر"
  },
  {
    "poem_id": 1562,
    "vorder": 14,
    "position": 1,
    "text": "نپرد وگر چند باشد دلیر"
  },
  {
    "poem_id": 1562,
    "vorder": 15,
    "position": 0,
    "text": "بخندید روشن‌دل اسفندیار"
  },
  {
    "poem_id": 1562,
    "vorder": 16,
    "position": 1,
    "text": "بدو گفت کای ترک ناسازگار"
  },
  {
    "poem_id": 1562,
    "vorder": 17,
    "position": 0,
    "text": "ببینی تو فردا که با نره‌شیر"
  },
  {
    "poem_id": 1562,
    "vorder": 18,
    "position": 1,
    "text": "چگونه شوم من به جنگش دلیر"
  },
  {
    "poem_id": 1562,
    "vorder": 19,
    "position": 0,
    "text": "چو تاریک شد شب بفرمود شاه"
  },
  {
    "poem_id": 1562,
    "vorder": 20,
    "position": 1,
    "text": "از آن جایگاه اندر آمد سپاه"
  },
  {
    "poem_id": 1562,
    "vorder": 21,
    "position": 0,
    "text": "شب تیره لشکر همی راندند"
  },
  {
    "poem_id": 1562,
    "vorder": 22,
    "position": 1,
    "text": "بر او بر همی آفرین خواندند"
  },
  {
    "poem_id": 1562,
    "vorder": 23,
    "position": 0,
    "text": "چو خورشید ز آن چادر لاژورد"
  },
  {
    "poem_id": 1562,
    "vorder": 24,
    "position": 1,
    "text": "یکی مطرفی کرد دیبای زرد"
  },
  {
    "poem_id": 1562,
    "vorder": 25,
    "position": 0,
    "text": "سپهبد به جای دلیران رسید"
  },
  {
    "poem_id": 1562,
    "vorder": 26,
    "position": 1,
    "text": "به هامون و پرخاش شیران رسید"
  },
  {
    "poem_id": 1562,
    "vorder": 27,
    "position": 0,
    "text": "پشوتن بفرمود تا رفت پیش"
  },
  {
    "poem_id": 1562,
    "vorder": 28,
    "position": 1,
    "text": "ورا پندها داد ز اندازه بیش"
  },
  {
    "poem_id": 1562,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت کاین لشکر سرفراز"
  },
  {
    "poem_id": 1562,
    "vorder": 30,
    "position": 1,
    "text": "سپردم ترا من شدم رزمساز"
  },
  {
    "poem_id": 1562,
    "vorder": 31,
    "position": 0,
    "text": "بیامد چو با شیر نزدیک شد"
  },
  {
    "poem_id": 1562,
    "vorder": 32,
    "position": 1,
    "text": "جهان بر دل شیر تاریک شد"
  },
  {
    "poem_id": 1562,
    "vorder": 33,
    "position": 0,
    "text": "یکی بود نر و دگر ماده شیر"
  },
  {
    "poem_id": 1562,
    "vorder": 34,
    "position": 1,
    "text": "برفتند پرخاشجوی و دلیر"
  },
  {
    "poem_id": 1562,
    "vorder": 35,
    "position": 0,
    "text": "چو نر اندر آمد یکی تیغ زد"
  },
  {
    "poem_id": 1562,
    "vorder": 36,
    "position": 1,
    "text": "ببد ریگ زیرش به سان بسد"
  },
  {
    "poem_id": 1562,
    "vorder": 37,
    "position": 0,
    "text": "ز سر تا میانش به دو نیم گشت"
  },
  {
    "poem_id": 1562,
    "vorder": 38,
    "position": 1,
    "text": "دل شیر ماده پر از بیم گشت"
  },
  {
    "poem_id": 1562,
    "vorder": 39,
    "position": 0,
    "text": "چو جفتش برآشفت و آمد فراز"
  },
  {
    "poem_id": 1562,
    "vorder": 40,
    "position": 1,
    "text": "یکی تیغ زد بر سرش رزمساز"
  },
  {
    "poem_id": 1562,
    "vorder": 41,
    "position": 0,
    "text": "به ریگ اندر افگند غلتان سرش"
  },
  {
    "poem_id": 1562,
    "vorder": 42,
    "position": 1,
    "text": "ز خون لعل شد دست و جنگی برش"
  },
  {
    "poem_id": 1562,
    "vorder": 43,
    "position": 0,
    "text": "به آب اندر آمد سر و تن بشست"
  },
  {
    "poem_id": 1562,
    "vorder": 44,
    "position": 1,
    "text": "نگهدار جز پاک یزدان نجست"
  },
  {
    "poem_id": 1562,
    "vorder": 45,
    "position": 0,
    "text": "چنین گفت کای داور داد و پاک"
  },
  {
    "poem_id": 1562,
    "vorder": 46,
    "position": 1,
    "text": "به دستم ددان را تو کردی هلاک"
  },
  {
    "poem_id": 1562,
    "vorder": 47,
    "position": 0,
    "text": "هم اندر زمان لشکر آنجا رسید"
  },
  {
    "poem_id": 1562,
    "vorder": 48,
    "position": 1,
    "text": "پشوتن سر و یال شیران بدید"
  },
  {
    "poem_id": 1562,
    "vorder": 49,
    "position": 0,
    "text": "بر اسفندیار آفرین خواندند"
  },
  {
    "poem_id": 1562,
    "vorder": 50,
    "position": 1,
    "text": "ورا نامدار زمین خواندند"
  },
  {
    "poem_id": 1562,
    "vorder": 51,
    "position": 0,
    "text": "وز آنجا بیامد کی رهنمای"
  },
  {
    "poem_id": 1562,
    "vorder": 52,
    "position": 1,
    "text": "به نزدیک خرگاه و پرده‌سرای"
  },
  {
    "poem_id": 1562,
    "vorder": 53,
    "position": 0,
    "text": "نهادند خوان و خورشهای نغز"
  },
  {
    "poem_id": 1562,
    "vorder": 54,
    "position": 1,
    "text": "بیاورد سالار پاکیزه مغز"
  }
]