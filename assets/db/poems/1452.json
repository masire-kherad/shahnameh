[
  {
    "poem_id": 1452,
    "vorder": 1,
    "position": 0,
    "text": "فرستاده شد نزد قیصر ز شاه"
  },
  {
    "poem_id": 1452,
    "vorder": 2,
    "position": 1,
    "text": "سواری که اندر نوردید راه"
  },
  {
    "poem_id": 1452,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود کز نامداران روم"
  },
  {
    "poem_id": 1452,
    "vorder": 4,
    "position": 1,
    "text": "کسی کاو بنازد بران مرز و بوم"
  },
  {
    "poem_id": 1452,
    "vorder": 5,
    "position": 0,
    "text": "جهان دیده باید عنان‌دار کس"
  },
  {
    "poem_id": 1452,
    "vorder": 6,
    "position": 1,
    "text": "سنان و سپر بایدش یار بس"
  },
  {
    "poem_id": 1452,
    "vorder": 7,
    "position": 0,
    "text": "چنین لشکری باید از مرز روم"
  },
  {
    "poem_id": 1452,
    "vorder": 8,
    "position": 1,
    "text": "که آیند با من به آباد بوم"
  },
  {
    "poem_id": 1452,
    "vorder": 9,
    "position": 0,
    "text": "پس آگاهی آمد ز هاماوران"
  },
  {
    "poem_id": 1452,
    "vorder": 10,
    "position": 1,
    "text": "بدشت سواران نیزه‌وران"
  },
  {
    "poem_id": 1452,
    "vorder": 11,
    "position": 0,
    "text": "که رستم به مصر و به بربر چه کرد"
  },
  {
    "poem_id": 1452,
    "vorder": 12,
    "position": 1,
    "text": "بران شهریاران به روز نبرد"
  },
  {
    "poem_id": 1452,
    "vorder": 13,
    "position": 0,
    "text": "دلیری بجستند گرد و سوار"
  },
  {
    "poem_id": 1452,
    "vorder": 14,
    "position": 1,
    "text": "عنان پیچ و مردافگن و نیزه‌دار"
  },
  {
    "poem_id": 1452,
    "vorder": 15,
    "position": 0,
    "text": "نوشتند نامه یکی مردوار"
  },
  {
    "poem_id": 1452,
    "vorder": 16,
    "position": 1,
    "text": "سخنهای شایسته و آبدار"
  },
  {
    "poem_id": 1452,
    "vorder": 17,
    "position": 0,
    "text": "چو از گرگساران بیامد سپاه"
  },
  {
    "poem_id": 1452,
    "vorder": 18,
    "position": 1,
    "text": "که جویند گاه سرافراز شاه"
  },
  {
    "poem_id": 1452,
    "vorder": 19,
    "position": 0,
    "text": "دل ما شد از کار ایشان بدرد"
  },
  {
    "poem_id": 1452,
    "vorder": 20,
    "position": 1,
    "text": "که دلشان چنین برتری یاد کرد"
  },
  {
    "poem_id": 1452,
    "vorder": 21,
    "position": 0,
    "text": "همی تاج او خواست افراسیاب"
  },
  {
    "poem_id": 1452,
    "vorder": 22,
    "position": 1,
    "text": "ز راه خرد سرش گشته شتاب"
  },
  {
    "poem_id": 1452,
    "vorder": 23,
    "position": 0,
    "text": "برفتیم با نیزه‌های دراز"
  },
  {
    "poem_id": 1452,
    "vorder": 24,
    "position": 1,
    "text": "برو تلخ کردیم آرام و ناز"
  },
  {
    "poem_id": 1452,
    "vorder": 25,
    "position": 0,
    "text": "ازیشان و از ما بسی کشته شد"
  },
  {
    "poem_id": 1452,
    "vorder": 26,
    "position": 1,
    "text": "زمانه به هر نیک و بد گشته شد"
  },
  {
    "poem_id": 1452,
    "vorder": 27,
    "position": 0,
    "text": "کنون کآمد از کار او آگهی"
  },
  {
    "poem_id": 1452,
    "vorder": 28,
    "position": 1,
    "text": "که تازه شد آن تخت شاهنشهی"
  },
  {
    "poem_id": 1452,
    "vorder": 29,
    "position": 0,
    "text": "همه نامداران شمشیرزن"
  },
  {
    "poem_id": 1452,
    "vorder": 30,
    "position": 1,
    "text": "برین کینه گه بر شدند انجمن"
  },
  {
    "poem_id": 1452,
    "vorder": 31,
    "position": 0,
    "text": "چو شه برگراید ز بربر عنان"
  },
  {
    "poem_id": 1452,
    "vorder": 32,
    "position": 1,
    "text": "به گردن برآریم یکسر سنان"
  },
  {
    "poem_id": 1452,
    "vorder": 33,
    "position": 0,
    "text": "زمین کوه تا کوه پرخون کنیم"
  },
  {
    "poem_id": 1452,
    "vorder": 34,
    "position": 1,
    "text": "ز دشمن بیابان چو جیحون کنیم"
  },
  {
    "poem_id": 1452,
    "vorder": 35,
    "position": 0,
    "text": "فرستاده تازی برافگند و رفت"
  },
  {
    "poem_id": 1452,
    "vorder": 36,
    "position": 1,
    "text": "به بربرستان روی بنهاد و تفت"
  },
  {
    "poem_id": 1452,
    "vorder": 37,
    "position": 0,
    "text": "چو نامه بر شاه ایران رسید"
  },
  {
    "poem_id": 1452,
    "vorder": 38,
    "position": 1,
    "text": "بران گونه گفتار بایسته دید"
  },
  {
    "poem_id": 1452,
    "vorder": 39,
    "position": 0,
    "text": "ازیشان پسند آمدش کارکرد"
  },
  {
    "poem_id": 1452,
    "vorder": 40,
    "position": 1,
    "text": "به افراسیاب آن زمان نامه کرد"
  },
  {
    "poem_id": 1452,
    "vorder": 41,
    "position": 0,
    "text": "که ایران بپرداز و بیشی مجوی"
  },
  {
    "poem_id": 1452,
    "vorder": 42,
    "position": 1,
    "text": "سر ما شد از تو پر از گفت‌وگوی"
  },
  {
    "poem_id": 1452,
    "vorder": 43,
    "position": 0,
    "text": "ترا شهر توران بسندست خود"
  },
  {
    "poem_id": 1452,
    "vorder": 44,
    "position": 1,
    "text": "به خیره همی دست یازی ببد"
  },
  {
    "poem_id": 1452,
    "vorder": 45,
    "position": 0,
    "text": "فزونی مجوی ار شدی بی‌نیاز"
  },
  {
    "poem_id": 1452,
    "vorder": 46,
    "position": 1,
    "text": "که درد آردت پیش رنج دراز"
  },
  {
    "poem_id": 1452,
    "vorder": 47,
    "position": 0,
    "text": "ترا کهتری کار بستن نکوست"
  },
  {
    "poem_id": 1452,
    "vorder": 48,
    "position": 1,
    "text": "نگه داشتن بر تن خویش پوست"
  },
  {
    "poem_id": 1452,
    "vorder": 49,
    "position": 0,
    "text": "ندانی که ایران نشست من‌ست"
  },
  {
    "poem_id": 1452,
    "vorder": 50,
    "position": 1,
    "text": "جهان سر به سر زیر دست من‌ست"
  },
  {
    "poem_id": 1452,
    "vorder": 51,
    "position": 0,
    "text": "پلنگ ژیان گرچه باشد دلیر"
  },
  {
    "poem_id": 1452,
    "vorder": 52,
    "position": 1,
    "text": "نیارد شدن پیش چنگال شیر"
  },
  {
    "poem_id": 1452,
    "vorder": 53,
    "position": 0,
    "text": "چو آگاهی آمد به افراسیاب"
  },
  {
    "poem_id": 1452,
    "vorder": 54,
    "position": 1,
    "text": "سرش پر ز کین گشت و دل پرشتاب"
  },
  {
    "poem_id": 1452,
    "vorder": 55,
    "position": 0,
    "text": "فرستاد پاسخش کاین گفت‌وگوی"
  },
  {
    "poem_id": 1452,
    "vorder": 56,
    "position": 1,
    "text": "نزیبد جز از مردم زشت خوی"
  },
  {
    "poem_id": 1452,
    "vorder": 57,
    "position": 0,
    "text": "ترا گر سزا بودی ایران بدان"
  },
  {
    "poem_id": 1452,
    "vorder": 58,
    "position": 1,
    "text": "نیازت نبودی به مازندران"
  },
  {
    "poem_id": 1452,
    "vorder": 59,
    "position": 0,
    "text": "چنین گفت کایران دو رویه مراست"
  },
  {
    "poem_id": 1452,
    "vorder": 60,
    "position": 1,
    "text": "بباید شنیدن سخنهای راست"
  },
  {
    "poem_id": 1452,
    "vorder": 61,
    "position": 0,
    "text": "که پور فریدون نیای من‌ست"
  },
  {
    "poem_id": 1452,
    "vorder": 62,
    "position": 1,
    "text": "همه شهر ایران سرای من‌ست"
  },
  {
    "poem_id": 1452,
    "vorder": 63,
    "position": 0,
    "text": "و دیگر به بازوی شمشیرزن"
  },
  {
    "poem_id": 1452,
    "vorder": 64,
    "position": 1,
    "text": "تهی کردم از تازیان انجمن"
  },
  {
    "poem_id": 1452,
    "vorder": 65,
    "position": 0,
    "text": "به شمشیر بستانم از کوه تیغ"
  },
  {
    "poem_id": 1452,
    "vorder": 66,
    "position": 1,
    "text": "عقاب اندر آرم ز تاریک میغ"
  },
  {
    "poem_id": 1452,
    "vorder": 67,
    "position": 0,
    "text": "کنون آمدم جنگ را ساخته"
  },
  {
    "poem_id": 1452,
    "vorder": 68,
    "position": 1,
    "text": "درفش درفشان برافراخته"
  },
  {
    "poem_id": 1452,
    "vorder": 69,
    "position": 0,
    "text": "فرستاده برگشت مانند باد"
  },
  {
    "poem_id": 1452,
    "vorder": 70,
    "position": 1,
    "text": "سخنها به کاووس کی کرد یاد"
  },
  {
    "poem_id": 1452,
    "vorder": 71,
    "position": 0,
    "text": "چو بشنید کاووس گفتار اوی"
  },
  {
    "poem_id": 1452,
    "vorder": 72,
    "position": 1,
    "text": "بیاراست لشکر به پیکار اوی"
  },
  {
    "poem_id": 1452,
    "vorder": 73,
    "position": 0,
    "text": "ز بربر بیامد سوی سوریان"
  },
  {
    "poem_id": 1452,
    "vorder": 74,
    "position": 1,
    "text": "یکی لشکری بی‌کران و میان"
  },
  {
    "poem_id": 1452,
    "vorder": 75,
    "position": 0,
    "text": "به جنگش بیاراست افراسیاب"
  },
  {
    "poem_id": 1452,
    "vorder": 76,
    "position": 1,
    "text": "به گردون همی خاک برزد ز آب"
  },
  {
    "poem_id": 1452,
    "vorder": 77,
    "position": 0,
    "text": "جهان کر شد از نالهٔ بوق و کوس"
  },
  {
    "poem_id": 1452,
    "vorder": 78,
    "position": 1,
    "text": "زمین آهنین شد هوا آبنوس"
  },
  {
    "poem_id": 1452,
    "vorder": 79,
    "position": 0,
    "text": "ز زخم تبرزین و از بس ترنگ"
  },
  {
    "poem_id": 1452,
    "vorder": 80,
    "position": 1,
    "text": "همی موج خون خاست از دشت جنگ"
  },
  {
    "poem_id": 1452,
    "vorder": 81,
    "position": 0,
    "text": "سر بخت گردان افراسیاب"
  },
  {
    "poem_id": 1452,
    "vorder": 82,
    "position": 1,
    "text": "بران رزم‌گاه اندر آمد بخواب"
  },
  {
    "poem_id": 1452,
    "vorder": 83,
    "position": 0,
    "text": "دو بهره ز توران سپه کشته شد"
  },
  {
    "poem_id": 1452,
    "vorder": 84,
    "position": 1,
    "text": "سرسرکشان پاک برگشته شد"
  },
  {
    "poem_id": 1452,
    "vorder": 85,
    "position": 0,
    "text": "سپهدار چون کار زان‌گونه دید"
  },
  {
    "poem_id": 1452,
    "vorder": 86,
    "position": 1,
    "text": "بی‌آتش بجوشید همچون نبید"
  },
  {
    "poem_id": 1452,
    "vorder": 87,
    "position": 0,
    "text": "به آواز گفت ای دلیران من"
  },
  {
    "poem_id": 1452,
    "vorder": 88,
    "position": 1,
    "text": "گزیده یلان نره شیران من"
  },
  {
    "poem_id": 1452,
    "vorder": 89,
    "position": 0,
    "text": "شما را ز بهر چنین روزگار"
  },
  {
    "poem_id": 1452,
    "vorder": 90,
    "position": 1,
    "text": "همی پرورانیدم اندر کنار"
  },
  {
    "poem_id": 1452,
    "vorder": 91,
    "position": 0,
    "text": "بکوشید و هم پشت جنگ آورید"
  },
  {
    "poem_id": 1452,
    "vorder": 92,
    "position": 1,
    "text": "جهان را به کاووس تنگ آورید"
  },
  {
    "poem_id": 1452,
    "vorder": 93,
    "position": 0,
    "text": "یلان را به ژوپین و خنجر زنید"
  },
  {
    "poem_id": 1452,
    "vorder": 94,
    "position": 1,
    "text": "دلیرانشان سر به سر بفگنید"
  },
  {
    "poem_id": 1452,
    "vorder": 95,
    "position": 0,
    "text": "همان سگزی رستم شیردل"
  },
  {
    "poem_id": 1452,
    "vorder": 96,
    "position": 1,
    "text": "که از شیر بستد به شمشیر دل"
  },
  {
    "poem_id": 1452,
    "vorder": 97,
    "position": 0,
    "text": "بود کز دلیری ببند آورید"
  },
  {
    "poem_id": 1452,
    "vorder": 98,
    "position": 1,
    "text": "سرش را به دام گزند آورید"
  },
  {
    "poem_id": 1452,
    "vorder": 99,
    "position": 0,
    "text": "هرآنکس که او را به روز نبرد"
  },
  {
    "poem_id": 1452,
    "vorder": 100,
    "position": 1,
    "text": "ز زین پلنگ اندر آرد به گرد"
  },
  {
    "poem_id": 1452,
    "vorder": 101,
    "position": 0,
    "text": "دهم دختر خویش و شاهی ورا"
  },
  {
    "poem_id": 1452,
    "vorder": 102,
    "position": 1,
    "text": "برآرم سر از برج ماهی ورا"
  },
  {
    "poem_id": 1452,
    "vorder": 103,
    "position": 0,
    "text": "چو ترکان شنیدند گفتار اوی"
  },
  {
    "poem_id": 1452,
    "vorder": 104,
    "position": 1,
    "text": "سراسر سوی رزم کردند روی"
  },
  {
    "poem_id": 1452,
    "vorder": 105,
    "position": 0,
    "text": "بشد تیز با لشکر سوریان"
  },
  {
    "poem_id": 1452,
    "vorder": 106,
    "position": 1,
    "text": "بدان سود جستن سرآمد زیان"
  },
  {
    "poem_id": 1452,
    "vorder": 107,
    "position": 0,
    "text": "چو روشن زمانه بران گونه دید"
  },
  {
    "poem_id": 1452,
    "vorder": 108,
    "position": 1,
    "text": "ازانجا سوی شهر توران کشید"
  },
  {
    "poem_id": 1452,
    "vorder": 109,
    "position": 0,
    "text": "دلش خسته و کشته لشکر دو بهر"
  },
  {
    "poem_id": 1452,
    "vorder": 110,
    "position": 1,
    "text": "همی نوش جست از جهان یافت زهر"
  }
]