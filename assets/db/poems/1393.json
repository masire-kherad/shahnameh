[
  {
    "poem_id": 1393,
    "vorder": 1,
    "position": 0,
    "text": "چو در کابل این داستان فاش گشت"
  },
  {
    "poem_id": 1393,
    "vorder": 2,
    "position": 1,
    "text": "سر مرزبان پر ز پرخاش گشت"
  },
  {
    "poem_id": 1393,
    "vorder": 3,
    "position": 0,
    "text": "برآشفت و سیندخت را پیش خواند"
  },
  {
    "poem_id": 1393,
    "vorder": 4,
    "position": 1,
    "text": "همه خشم رودابه بر وی براند"
  },
  {
    "poem_id": 1393,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کاکنون جزین رای نیست"
  },
  {
    "poem_id": 1393,
    "vorder": 6,
    "position": 1,
    "text": "که با شاه گیتی مرا پای نیست"
  },
  {
    "poem_id": 1393,
    "vorder": 7,
    "position": 0,
    "text": "که آرمت با دخت ناپاک تن"
  },
  {
    "poem_id": 1393,
    "vorder": 8,
    "position": 1,
    "text": "کشم زارتان بر سر انجمن"
  },
  {
    "poem_id": 1393,
    "vorder": 9,
    "position": 0,
    "text": "مگر شاه ایران ازین خشم و کین"
  },
  {
    "poem_id": 1393,
    "vorder": 10,
    "position": 1,
    "text": "برآساید و رام گردد زمین"
  },
  {
    "poem_id": 1393,
    "vorder": 11,
    "position": 0,
    "text": "به کابل که با سام یارد چخید"
  },
  {
    "poem_id": 1393,
    "vorder": 12,
    "position": 1,
    "text": "ازان زخم گرزش که یارد چشید"
  },
  {
    "poem_id": 1393,
    "vorder": 13,
    "position": 0,
    "text": "چو بشنید سیندخت بنشست پست"
  },
  {
    "poem_id": 1393,
    "vorder": 14,
    "position": 1,
    "text": "دل چاره‌جوی اندر اندیشه بست"
  },
  {
    "poem_id": 1393,
    "vorder": 15,
    "position": 0,
    "text": "یکی چاره آورد از دل به جای"
  },
  {
    "poem_id": 1393,
    "vorder": 16,
    "position": 1,
    "text": "که بد ژرف بین و فزاینده رای"
  },
  {
    "poem_id": 1393,
    "vorder": 17,
    "position": 0,
    "text": "وزان پس دوان دست کرده به کش"
  },
  {
    "poem_id": 1393,
    "vorder": 18,
    "position": 1,
    "text": "بیامد بر شاه خورشید فش"
  },
  {
    "poem_id": 1393,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت بشنو ز من یک سخن"
  },
  {
    "poem_id": 1393,
    "vorder": 20,
    "position": 1,
    "text": "چو دیگر یکی کامت آید بکن"
  },
  {
    "poem_id": 1393,
    "vorder": 21,
    "position": 0,
    "text": "ترا خواسته گر ز بهر تنست"
  },
  {
    "poem_id": 1393,
    "vorder": 22,
    "position": 1,
    "text": "ببخش و بدان کین شب آبستنست"
  },
  {
    "poem_id": 1393,
    "vorder": 23,
    "position": 0,
    "text": "اگر چند باشد شب دیریاز"
  },
  {
    "poem_id": 1393,
    "vorder": 24,
    "position": 1,
    "text": "برو تیرگی هم نماند دراز"
  },
  {
    "poem_id": 1393,
    "vorder": 25,
    "position": 0,
    "text": "شود روز چون چشمه روشن شود"
  },
  {
    "poem_id": 1393,
    "vorder": 26,
    "position": 1,
    "text": "جهان چون نگین بدخشان شود"
  },
  {
    "poem_id": 1393,
    "vorder": 27,
    "position": 0,
    "text": "بدو گفت مهراب کز باستان"
  },
  {
    "poem_id": 1393,
    "vorder": 28,
    "position": 1,
    "text": "مزن در میان یلان داستان"
  },
  {
    "poem_id": 1393,
    "vorder": 29,
    "position": 0,
    "text": "بگو آنچه دانی و جان را بکوش"
  },
  {
    "poem_id": 1393,
    "vorder": 30,
    "position": 1,
    "text": "وگر چادر خون به تن بر بپوش"
  },
  {
    "poem_id": 1393,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت سیندخت کای سرفراز"
  },
  {
    "poem_id": 1393,
    "vorder": 32,
    "position": 1,
    "text": "بود کت به خونم نیاید نیاز"
  },
  {
    "poem_id": 1393,
    "vorder": 33,
    "position": 0,
    "text": "مرا رفت باید به نزدیک سام"
  },
  {
    "poem_id": 1393,
    "vorder": 34,
    "position": 1,
    "text": "زبان برگشایم چو تیغ از نیام"
  },
  {
    "poem_id": 1393,
    "vorder": 35,
    "position": 0,
    "text": "بگویم بدو آنچه گفتن سزد"
  },
  {
    "poem_id": 1393,
    "vorder": 36,
    "position": 1,
    "text": "خرد خام گفتارها را پزد"
  },
  {
    "poem_id": 1393,
    "vorder": 37,
    "position": 0,
    "text": "ز من رنج جان و ز تو خواسته"
  },
  {
    "poem_id": 1393,
    "vorder": 38,
    "position": 1,
    "text": "سپردن به من گنج آراسته"
  },
  {
    "poem_id": 1393,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت مهراب بستان کلید"
  },
  {
    "poem_id": 1393,
    "vorder": 40,
    "position": 1,
    "text": "غم گنج هرگز نباید کشید"
  },
  {
    "poem_id": 1393,
    "vorder": 41,
    "position": 0,
    "text": "پرستنده و اسپ و تخت و کلاه"
  },
  {
    "poem_id": 1393,
    "vorder": 42,
    "position": 1,
    "text": "بیارای و با خویشتن بر به راه"
  },
  {
    "poem_id": 1393,
    "vorder": 43,
    "position": 0,
    "text": "مگر شهر کابل نسوزد به ما"
  },
  {
    "poem_id": 1393,
    "vorder": 44,
    "position": 1,
    "text": "چو پژمرده شد برفروزد به ما"
  },
  {
    "poem_id": 1393,
    "vorder": 45,
    "position": 0,
    "text": "چنین گفت سیندخت کای نامدار"
  },
  {
    "poem_id": 1393,
    "vorder": 46,
    "position": 1,
    "text": "به جای روان خواسته خواردار"
  },
  {
    "poem_id": 1393,
    "vorder": 47,
    "position": 0,
    "text": "نباید که چون من شوم چاره‌جوی"
  },
  {
    "poem_id": 1393,
    "vorder": 48,
    "position": 1,
    "text": "تو رودابه را سختی آری به روی"
  },
  {
    "poem_id": 1393,
    "vorder": 49,
    "position": 0,
    "text": "مرا در جهان انده جان اوست"
  },
  {
    "poem_id": 1393,
    "vorder": 50,
    "position": 1,
    "text": "کنون با توم روز پیمان اوست"
  },
  {
    "poem_id": 1393,
    "vorder": 51,
    "position": 0,
    "text": "ندارم همی انده خویشتن"
  },
  {
    "poem_id": 1393,
    "vorder": 52,
    "position": 1,
    "text": "ازویست این درد و اندوه من"
  },
  {
    "poem_id": 1393,
    "vorder": 53,
    "position": 0,
    "text": "یکی سخت پیمان ستد زو نخست"
  },
  {
    "poem_id": 1393,
    "vorder": 54,
    "position": 1,
    "text": "پس آنگه به مردی ره چاره جست"
  },
  {
    "poem_id": 1393,
    "vorder": 55,
    "position": 0,
    "text": "بیاراست تن را به دیبا و زر"
  },
  {
    "poem_id": 1393,
    "vorder": 56,
    "position": 1,
    "text": "به در و به یاقوت پرمایه سر"
  },
  {
    "poem_id": 1393,
    "vorder": 57,
    "position": 0,
    "text": "پس از گنج زرش ز بهر نثار"
  },
  {
    "poem_id": 1393,
    "vorder": 58,
    "position": 1,
    "text": "برون کرد دینار چون سی‌هزار"
  },
  {
    "poem_id": 1393,
    "vorder": 59,
    "position": 0,
    "text": "به زرین ستام آوریدند سی"
  },
  {
    "poem_id": 1393,
    "vorder": 60,
    "position": 1,
    "text": "از اسپان تازی و از پارسی"
  },
  {
    "poem_id": 1393,
    "vorder": 61,
    "position": 0,
    "text": "ابا طوق زرین پرستنده شست"
  },
  {
    "poem_id": 1393,
    "vorder": 62,
    "position": 1,
    "text": "یکی جام زر هر یکی را به دست"
  },
  {
    "poem_id": 1393,
    "vorder": 63,
    "position": 0,
    "text": "پر از مشک و کافور و یاقوت و زر"
  },
  {
    "poem_id": 1393,
    "vorder": 64,
    "position": 1,
    "text": "ز پیروزهٔ چند چندی گهر"
  },
  {
    "poem_id": 1393,
    "vorder": 65,
    "position": 0,
    "text": "چهل جامه دیبای پیکر به زر"
  },
  {
    "poem_id": 1393,
    "vorder": 66,
    "position": 1,
    "text": "طرازش همه گونه گونه گهر"
  },
  {
    "poem_id": 1393,
    "vorder": 67,
    "position": 0,
    "text": "به زرین و سیمین دوصد تیغ هند"
  },
  {
    "poem_id": 1393,
    "vorder": 68,
    "position": 1,
    "text": "جزان سی به زهراب داده پرند"
  },
  {
    "poem_id": 1393,
    "vorder": 69,
    "position": 0,
    "text": "صد اشتر همه مادهٔ سرخ موی"
  },
  {
    "poem_id": 1393,
    "vorder": 70,
    "position": 1,
    "text": "صد استر همه بارکش راه جوی"
  },
  {
    "poem_id": 1393,
    "vorder": 71,
    "position": 0,
    "text": "یکی تاج پرگوهر شاهوار"
  },
  {
    "poem_id": 1393,
    "vorder": 72,
    "position": 1,
    "text": "ابا طوق و با یاره و گوشوار"
  },
  {
    "poem_id": 1393,
    "vorder": 73,
    "position": 0,
    "text": "بسان سپهری یکی تخت زر"
  },
  {
    "poem_id": 1393,
    "vorder": 74,
    "position": 1,
    "text": "برو ساخته چند گونه گهر"
  },
  {
    "poem_id": 1393,
    "vorder": 75,
    "position": 0,
    "text": "برش خسروی بیست پهنای او"
  },
  {
    "poem_id": 1393,
    "vorder": 76,
    "position": 1,
    "text": "چو سیصد فزون بود بالای او"
  },
  {
    "poem_id": 1393,
    "vorder": 77,
    "position": 0,
    "text": "وزان ژنده‌پیلان هندی چهار"
  },
  {
    "poem_id": 1393,
    "vorder": 78,
    "position": 1,
    "text": "همه جامه و فرش کردند بار"
  }
]