[
  {
    "poem_id": 1812,
    "vorder": 1,
    "position": 0,
    "text": "بیامد ز میدان چو تیر از کمان"
  },
  {
    "poem_id": 1812,
    "vorder": 2,
    "position": 1,
    "text": "بر دختر خویش رفت آن زمان"
  },
  {
    "poem_id": 1812,
    "vorder": 3,
    "position": 0,
    "text": "قلم خواست از ترک و قرطاس خواست"
  },
  {
    "poem_id": 1812,
    "vorder": 4,
    "position": 1,
    "text": "ز مشک سیه سوده انقاس خواست"
  },
  {
    "poem_id": 1812,
    "vorder": 5,
    "position": 0,
    "text": "سر عهد کرد آفرین از نخست"
  },
  {
    "poem_id": 1812,
    "vorder": 6,
    "position": 1,
    "text": "بران کو جهان از نژندی بشست"
  },
  {
    "poem_id": 1812,
    "vorder": 7,
    "position": 0,
    "text": "بگسترد هم پاکی و راستی"
  },
  {
    "poem_id": 1812,
    "vorder": 8,
    "position": 1,
    "text": "سوی دیو شد کژی و کاستی"
  },
  {
    "poem_id": 1812,
    "vorder": 9,
    "position": 0,
    "text": "سپینود را جفت بهرامشاه"
  },
  {
    "poem_id": 1812,
    "vorder": 10,
    "position": 1,
    "text": "سپردم بدین نامور پیشگاه"
  },
  {
    "poem_id": 1812,
    "vorder": 11,
    "position": 0,
    "text": "شهنشاه تا جاودان زنده باد"
  },
  {
    "poem_id": 1812,
    "vorder": 12,
    "position": 1,
    "text": "بزرگان همه پیش او بنده باد"
  },
  {
    "poem_id": 1812,
    "vorder": 13,
    "position": 0,
    "text": "چو من بگذرم زین سپنجی سرای"
  },
  {
    "poem_id": 1812,
    "vorder": 14,
    "position": 1,
    "text": "به قنوج بهرامشاهست رای"
  },
  {
    "poem_id": 1812,
    "vorder": 15,
    "position": 0,
    "text": "ز فرمان این تاجور مگذرید"
  },
  {
    "poem_id": 1812,
    "vorder": 16,
    "position": 1,
    "text": "تن مرده را سوی آتش برید"
  },
  {
    "poem_id": 1812,
    "vorder": 17,
    "position": 0,
    "text": "سپارید گنجم به بهرامشاه"
  },
  {
    "poem_id": 1812,
    "vorder": 18,
    "position": 1,
    "text": "همان کشور و تاج و گاه و سپاه"
  },
  {
    "poem_id": 1812,
    "vorder": 19,
    "position": 0,
    "text": "سپینود را داد منشور هند"
  },
  {
    "poem_id": 1812,
    "vorder": 20,
    "position": 1,
    "text": "نوشته خطی هندوی بر پرند"
  },
  {
    "poem_id": 1812,
    "vorder": 21,
    "position": 0,
    "text": "به ایران همی بود شنگل دو ماه"
  },
  {
    "poem_id": 1812,
    "vorder": 22,
    "position": 1,
    "text": "فرستاد پس مهتری نزد شاه"
  },
  {
    "poem_id": 1812,
    "vorder": 23,
    "position": 0,
    "text": "به دستوری بازگشتن به جای"
  },
  {
    "poem_id": 1812,
    "vorder": 24,
    "position": 1,
    "text": "خود و نامداران فرخنده‌رای"
  },
  {
    "poem_id": 1812,
    "vorder": 25,
    "position": 0,
    "text": "بدان شد شهنشاه همداستان"
  },
  {
    "poem_id": 1812,
    "vorder": 26,
    "position": 1,
    "text": "که او بازگردد به هندوستان"
  },
  {
    "poem_id": 1812,
    "vorder": 27,
    "position": 0,
    "text": "ز چیزی که باشد به ایران زمین"
  },
  {
    "poem_id": 1812,
    "vorder": 28,
    "position": 1,
    "text": "بفرمود تا کرد موبد گزین"
  },
  {
    "poem_id": 1812,
    "vorder": 29,
    "position": 0,
    "text": "ز دینار و ز گوهر شاهوار"
  },
  {
    "poem_id": 1812,
    "vorder": 30,
    "position": 1,
    "text": "ز تیغ و ز خود و کمر بی‌شمار"
  },
  {
    "poem_id": 1812,
    "vorder": 31,
    "position": 0,
    "text": "ز دیبا و از جامهٔ نابسود"
  },
  {
    "poem_id": 1812,
    "vorder": 32,
    "position": 1,
    "text": "که آن را شمار و کرانه نبود"
  },
  {
    "poem_id": 1812,
    "vorder": 33,
    "position": 0,
    "text": "به اندازه یارانش را هم چنین"
  },
  {
    "poem_id": 1812,
    "vorder": 34,
    "position": 1,
    "text": "بیاراست اسپان به دیبای چین"
  },
  {
    "poem_id": 1812,
    "vorder": 35,
    "position": 0,
    "text": "گسی کردشان شاد و خشنود شاه"
  },
  {
    "poem_id": 1812,
    "vorder": 36,
    "position": 1,
    "text": "سه منزل همی راند با او به راه"
  },
  {
    "poem_id": 1812,
    "vorder": 37,
    "position": 0,
    "text": "نبد هم بدین هدیه همداستان"
  },
  {
    "poem_id": 1812,
    "vorder": 38,
    "position": 1,
    "text": "علف داد تا مرز هندوستان"
  }
]