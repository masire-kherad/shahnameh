[
  {
    "poem_id": 52173,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت پس با سپه ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 2,
    "position": 1,
    "text": "که از جادوی اندر آرید راه"
  },
  {
    "poem_id": 52173,
    "vorder": 3,
    "position": 0,
    "text": "بدان تا دل و چشم ایرانیان"
  },
  {
    "poem_id": 52173,
    "vorder": 4,
    "position": 1,
    "text": "بپیچد نیاید شما را زیان"
  },
  {
    "poem_id": 52173,
    "vorder": 5,
    "position": 0,
    "text": "همه جاودان جادوی ساختند"
  },
  {
    "poem_id": 52173,
    "vorder": 6,
    "position": 1,
    "text": "همی در هوا آتش انداختند"
  },
  {
    "poem_id": 52173,
    "vorder": 7,
    "position": 0,
    "text": "برآمد یکی باد و ابری سیاه"
  },
  {
    "poem_id": 52173,
    "vorder": 8,
    "position": 1,
    "text": "همی تیر بارید ازو بر سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 9,
    "position": 0,
    "text": "خروشید بهرام کای مهتران"
  },
  {
    "poem_id": 52173,
    "vorder": 10,
    "position": 1,
    "text": "بزرگان ایران و کنداوران"
  },
  {
    "poem_id": 52173,
    "vorder": 11,
    "position": 0,
    "text": "بدین جادویها مدارید چشم"
  },
  {
    "poem_id": 52173,
    "vorder": 12,
    "position": 1,
    "text": "به جنگ اندر آیید یکسر بخشم"
  },
  {
    "poem_id": 52173,
    "vorder": 13,
    "position": 0,
    "text": "که آن سر به سر تنبل وجادویست"
  },
  {
    "poem_id": 52173,
    "vorder": 14,
    "position": 1,
    "text": "ز چاره برایشان بباید گریست"
  },
  {
    "poem_id": 52173,
    "vorder": 15,
    "position": 0,
    "text": "خروشی برآمد ز ایرانیان"
  },
  {
    "poem_id": 52173,
    "vorder": 16,
    "position": 1,
    "text": "ببستند خون ریختن را میان"
  },
  {
    "poem_id": 52173,
    "vorder": 17,
    "position": 0,
    "text": "نگه کرد زان رزمگه ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 18,
    "position": 1,
    "text": "که آن جادویی را ندادند راه"
  },
  {
    "poem_id": 52173,
    "vorder": 19,
    "position": 0,
    "text": "بیاورد لشکر سوی میسره"
  },
  {
    "poem_id": 52173,
    "vorder": 20,
    "position": 1,
    "text": "چو گرگ اندر آمد به‌پیش بره"
  },
  {
    "poem_id": 52173,
    "vorder": 21,
    "position": 0,
    "text": "چویک روی لشکر به‌هم برشکست"
  },
  {
    "poem_id": 52173,
    "vorder": 22,
    "position": 1,
    "text": "سوی قلب بهرام یازید دست"
  },
  {
    "poem_id": 52173,
    "vorder": 23,
    "position": 0,
    "text": "نگه کرد بهرام زان قلب‌گاه"
  },
  {
    "poem_id": 52173,
    "vorder": 24,
    "position": 1,
    "text": "گریزان سپه دید پیش سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 25,
    "position": 0,
    "text": "بیامد به‌نیزه سه تن را ز زین"
  },
  {
    "poem_id": 52173,
    "vorder": 26,
    "position": 1,
    "text": "نگون‌سار کرد و بزد بر زمین"
  },
  {
    "poem_id": 52173,
    "vorder": 27,
    "position": 0,
    "text": "همی‌گفت زین سان بود کارزار"
  },
  {
    "poem_id": 52173,
    "vorder": 28,
    "position": 1,
    "text": "همین بود رسم و همین بود کار"
  },
  {
    "poem_id": 52173,
    "vorder": 29,
    "position": 0,
    "text": "ندارید شرم از خدای جهان"
  },
  {
    "poem_id": 52173,
    "vorder": 30,
    "position": 1,
    "text": "نه از نامداران فرخ مهان"
  },
  {
    "poem_id": 52173,
    "vorder": 31,
    "position": 0,
    "text": "و زان پس بیامد سوی میمنه"
  },
  {
    "poem_id": 52173,
    "vorder": 32,
    "position": 1,
    "text": "چو شیر ژیان کو شود گرسنه"
  },
  {
    "poem_id": 52173,
    "vorder": 33,
    "position": 0,
    "text": "چنان لشکری رابه‌هم بردرید"
  },
  {
    "poem_id": 52173,
    "vorder": 34,
    "position": 1,
    "text": "درفش سپه‌دار شد ناپدید"
  },
  {
    "poem_id": 52173,
    "vorder": 35,
    "position": 0,
    "text": "و زان جایگه شد سوی قلب‌گاه"
  },
  {
    "poem_id": 52173,
    "vorder": 36,
    "position": 1,
    "text": "بران سو که سالار بد با سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت برگشت باد این سخن"
  },
  {
    "poem_id": 52173,
    "vorder": 38,
    "position": 1,
    "text": "گر ای دون که این رزم گردد کهن"
  },
  {
    "poem_id": 52173,
    "vorder": 39,
    "position": 0,
    "text": "پراکنده گردد به جنگ این سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 40,
    "position": 1,
    "text": "نگه کن کنون تا کدامست راه"
  },
  {
    "poem_id": 52173,
    "vorder": 41,
    "position": 0,
    "text": "برفتند وجستند راهی نبود"
  },
  {
    "poem_id": 52173,
    "vorder": 42,
    "position": 1,
    "text": "کزان راه شایست بالا نمود"
  },
  {
    "poem_id": 52173,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت با لشکر آرای خویش"
  },
  {
    "poem_id": 52173,
    "vorder": 44,
    "position": 1,
    "text": "که دیوار ما آهنینست پیش"
  },
  {
    "poem_id": 52173,
    "vorder": 45,
    "position": 0,
    "text": "هر آنکس که او رخنه داند زدن"
  },
  {
    "poem_id": 52173,
    "vorder": 46,
    "position": 1,
    "text": "ز دیوار بیرون تواند شدن"
  },
  {
    "poem_id": 52173,
    "vorder": 47,
    "position": 0,
    "text": "شود ایمن و جان به ایران برد"
  },
  {
    "poem_id": 52173,
    "vorder": 48,
    "position": 1,
    "text": "به نزدیک شاه دلیران برد"
  },
  {
    "poem_id": 52173,
    "vorder": 49,
    "position": 0,
    "text": "همه دل به خون ریختن برنهید"
  },
  {
    "poem_id": 52173,
    "vorder": 50,
    "position": 1,
    "text": "سپر بر سر آرید و خنجر دهید"
  },
  {
    "poem_id": 52173,
    "vorder": 51,
    "position": 0,
    "text": "ز یزدان نباشد کسی ناامید"
  },
  {
    "poem_id": 52173,
    "vorder": 52,
    "position": 1,
    "text": "و گر تیره بینند روز سپید"
  },
  {
    "poem_id": 52173,
    "vorder": 53,
    "position": 0,
    "text": "چنین گفت با مهتران ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 54,
    "position": 1,
    "text": "که پیلان بیارید پیش سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 55,
    "position": 0,
    "text": "به انبوه لشکر به جنگ آورید"
  },
  {
    "poem_id": 52173,
    "vorder": 56,
    "position": 1,
    "text": "بدیشان جهان تار و تنگ آورید"
  },
  {
    "poem_id": 52173,
    "vorder": 57,
    "position": 0,
    "text": "چو از دور بهرام پیلان بدید"
  },
  {
    "poem_id": 52173,
    "vorder": 58,
    "position": 1,
    "text": "غمی گشت و تیغ از میان برکشید"
  },
  {
    "poem_id": 52173,
    "vorder": 59,
    "position": 0,
    "text": "از آن پس چنین گفت با مهتران"
  },
  {
    "poem_id": 52173,
    "vorder": 60,
    "position": 1,
    "text": "که ای نام‌داران و جنگ آوران"
  },
  {
    "poem_id": 52173,
    "vorder": 61,
    "position": 0,
    "text": "کمانهای چاچی بزه برنهید"
  },
  {
    "poem_id": 52173,
    "vorder": 62,
    "position": 1,
    "text": "همه یکسره ترگ برسرنهید"
  },
  {
    "poem_id": 52173,
    "vorder": 63,
    "position": 0,
    "text": "به‌جان و سر شهریار جهان"
  },
  {
    "poem_id": 52173,
    "vorder": 64,
    "position": 1,
    "text": "گزین بزرگان و تاج مهان"
  },
  {
    "poem_id": 52173,
    "vorder": 65,
    "position": 0,
    "text": "که هرکس که بااو کمانست و تیر"
  },
  {
    "poem_id": 52173,
    "vorder": 66,
    "position": 1,
    "text": "کمان را بزه برنهد ناگزیر"
  },
  {
    "poem_id": 52173,
    "vorder": 67,
    "position": 0,
    "text": "خدنگی که پیکانش یازد به‌خون"
  },
  {
    "poem_id": 52173,
    "vorder": 68,
    "position": 1,
    "text": "سه چوبه به‌خرطوم پیل اندرون"
  },
  {
    "poem_id": 52173,
    "vorder": 69,
    "position": 0,
    "text": "نشانید و پس گرزها برکشید"
  },
  {
    "poem_id": 52173,
    "vorder": 70,
    "position": 1,
    "text": "به جنگ اندر آیید و دشمن کشید"
  },
  {
    "poem_id": 52173,
    "vorder": 71,
    "position": 0,
    "text": "سپهبد کمان را بزه برنهاد"
  },
  {
    "poem_id": 52173,
    "vorder": 72,
    "position": 1,
    "text": "یکی خود پولاد بر سر نهاد"
  },
  {
    "poem_id": 52173,
    "vorder": 73,
    "position": 0,
    "text": "به‌پیل اندرون تیر باران گرفت"
  },
  {
    "poem_id": 52173,
    "vorder": 74,
    "position": 1,
    "text": "کمان را چو ابر بهاران گرفت"
  },
  {
    "poem_id": 52173,
    "vorder": 75,
    "position": 0,
    "text": "پس پشت او اندر آمد سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 76,
    "position": 1,
    "text": "ستاره شد از پر و پیکان سیاه"
  },
  {
    "poem_id": 52173,
    "vorder": 77,
    "position": 0,
    "text": "بخستند خرطوم پیلان به‌تیر"
  },
  {
    "poem_id": 52173,
    "vorder": 78,
    "position": 1,
    "text": "ز خون شد در و دشت چون آب‌گیر"
  },
  {
    "poem_id": 52173,
    "vorder": 79,
    "position": 0,
    "text": "از آن خستگی پشت برگاشتند"
  },
  {
    "poem_id": 52173,
    "vorder": 80,
    "position": 1,
    "text": "بدو دشت پیکار بگذاشتند"
  },
  {
    "poem_id": 52173,
    "vorder": 81,
    "position": 0,
    "text": "چو پیل آن‌چنان زخم پیکان بدید"
  },
  {
    "poem_id": 52173,
    "vorder": 82,
    "position": 1,
    "text": "همه لشکر خویش را بسپرید"
  },
  {
    "poem_id": 52173,
    "vorder": 83,
    "position": 0,
    "text": "سپه بر هم افتاد و چندی بمرد"
  },
  {
    "poem_id": 52173,
    "vorder": 84,
    "position": 1,
    "text": "همان بخت بد کام‌کاری ببرد"
  },
  {
    "poem_id": 52173,
    "vorder": 85,
    "position": 0,
    "text": "سپاه اندر آمد پس پشت پیل"
  },
  {
    "poem_id": 52173,
    "vorder": 86,
    "position": 1,
    "text": "زمین شد بکردار دریای نیل"
  },
  {
    "poem_id": 52173,
    "vorder": 87,
    "position": 0,
    "text": "تلی بود خرم بدان جایگاه"
  },
  {
    "poem_id": 52173,
    "vorder": 88,
    "position": 1,
    "text": "پس پشت آن رنج دیده سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 89,
    "position": 0,
    "text": "یکی تخت زرین نهاده بروی"
  },
  {
    "poem_id": 52173,
    "vorder": 90,
    "position": 1,
    "text": "نشسته برو ساوهٔ رزم‌جوی"
  },
  {
    "poem_id": 52173,
    "vorder": 91,
    "position": 0,
    "text": "سپه دید چون کوه آهن روان"
  },
  {
    "poem_id": 52173,
    "vorder": 92,
    "position": 1,
    "text": "همه سر پر از گرد و تیره روان"
  },
  {
    "poem_id": 52173,
    "vorder": 93,
    "position": 0,
    "text": "پس پشت آن زنده پیلان مست"
  },
  {
    "poem_id": 52173,
    "vorder": 94,
    "position": 1,
    "text": "همی‌کوفتند آن سپه را بدست"
  },
  {
    "poem_id": 52173,
    "vorder": 95,
    "position": 0,
    "text": "پر از آب شد دیدهٔ ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 96,
    "position": 1,
    "text": "بدان تا چرا شد هزیمت سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 97,
    "position": 0,
    "text": "نشست از بر تازی اسب سمند"
  },
  {
    "poem_id": 52173,
    "vorder": 98,
    "position": 1,
    "text": "همی‌تاخت ترسان ز بیم گزند"
  },
  {
    "poem_id": 52173,
    "vorder": 99,
    "position": 0,
    "text": "بر ساوه بهرام چون پیل مست"
  },
  {
    "poem_id": 52173,
    "vorder": 100,
    "position": 1,
    "text": "کمندی به بازو کمانی بدست"
  },
  {
    "poem_id": 52173,
    "vorder": 101,
    "position": 0,
    "text": "به لشکر چنین گفت کای سرکشان"
  },
  {
    "poem_id": 52173,
    "vorder": 102,
    "position": 1,
    "text": "زبخت بد آمد بر ایشان نشان"
  },
  {
    "poem_id": 52173,
    "vorder": 103,
    "position": 0,
    "text": "نه هنگام رازست و روز سخن"
  },
  {
    "poem_id": 52173,
    "vorder": 104,
    "position": 1,
    "text": "بتازید با تیغ‌های کهن"
  },
  {
    "poem_id": 52173,
    "vorder": 105,
    "position": 0,
    "text": "بر ایشان یکی تیر باران کنید"
  },
  {
    "poem_id": 52173,
    "vorder": 106,
    "position": 1,
    "text": "بکوشید وکار سواران کنید"
  },
  {
    "poem_id": 52173,
    "vorder": 107,
    "position": 0,
    "text": "بران تل بر آمد کجا ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 108,
    "position": 1,
    "text": "همی‌بود بر تخت زر با کلاه"
  },
  {
    "poem_id": 52173,
    "vorder": 109,
    "position": 0,
    "text": "و را دید برتازیی چون هزبر"
  },
  {
    "poem_id": 52173,
    "vorder": 110,
    "position": 1,
    "text": "همی‌تاخت در دشت برسان ابر"
  },
  {
    "poem_id": 52173,
    "vorder": 111,
    "position": 0,
    "text": "خدنگی گزین کرد پیکان چو آب"
  },
  {
    "poem_id": 52173,
    "vorder": 112,
    "position": 1,
    "text": "نهاده برو چار پر عقاب"
  },
  {
    "poem_id": 52173,
    "vorder": 113,
    "position": 0,
    "text": "بمالید چاچی کمان را بدست"
  },
  {
    "poem_id": 52173,
    "vorder": 114,
    "position": 1,
    "text": "به چرم گوزن اندر آورد شست"
  },
  {
    "poem_id": 52173,
    "vorder": 115,
    "position": 0,
    "text": "چو چپ راست کرد و خم آورد راست"
  },
  {
    "poem_id": 52173,
    "vorder": 116,
    "position": 1,
    "text": "خروش از خم چرخ چاچی بخاست"
  },
  {
    "poem_id": 52173,
    "vorder": 117,
    "position": 0,
    "text": "چو آورد یال یلی رابه‌گوش"
  },
  {
    "poem_id": 52173,
    "vorder": 118,
    "position": 1,
    "text": "ز شاخ گوزنان برآمد خروش"
  },
  {
    "poem_id": 52173,
    "vorder": 119,
    "position": 0,
    "text": "چو بگذشت پیکان از انگشت اوی"
  },
  {
    "poem_id": 52173,
    "vorder": 120,
    "position": 1,
    "text": "گذر کرد از مهرهٔ پشت اوی"
  },
  {
    "poem_id": 52173,
    "vorder": 121,
    "position": 0,
    "text": "سر ساوه آمد بخاک اندرون"
  },
  {
    "poem_id": 52173,
    "vorder": 122,
    "position": 1,
    "text": "بزیر اندرش خاک شد جوی خون"
  },
  {
    "poem_id": 52173,
    "vorder": 123,
    "position": 0,
    "text": "شد آن نامور شاه و چندان سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 124,
    "position": 1,
    "text": "همان تخت زرین و زرین کلاه"
  },
  {
    "poem_id": 52173,
    "vorder": 125,
    "position": 0,
    "text": "چنینست کردار گردان سپهر"
  },
  {
    "poem_id": 52173,
    "vorder": 126,
    "position": 1,
    "text": "نه نامهربانیش پیدا نه مهر"
  },
  {
    "poem_id": 52173,
    "vorder": 127,
    "position": 0,
    "text": "نگر تا ننازی به‌تخت بلند"
  },
  {
    "poem_id": 52173,
    "vorder": 128,
    "position": 1,
    "text": "چو ایمن شوی دورباش از گزند"
  },
  {
    "poem_id": 52173,
    "vorder": 129,
    "position": 0,
    "text": "چو بهرام جنگی رسید اندروی"
  },
  {
    "poem_id": 52173,
    "vorder": 130,
    "position": 1,
    "text": "کشیدش بر آن خاک تفته بروی"
  },
  {
    "poem_id": 52173,
    "vorder": 131,
    "position": 0,
    "text": "برید آن سر شاه‌وارش ز تن"
  },
  {
    "poem_id": 52173,
    "vorder": 132,
    "position": 1,
    "text": "نیامد کسی پیشش از انجمن"
  },
  {
    "poem_id": 52173,
    "vorder": 133,
    "position": 0,
    "text": "چوترکان رسیدند نزدیک شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 134,
    "position": 1,
    "text": "فگنده تنی بود بی‌سر به راه"
  },
  {
    "poem_id": 52173,
    "vorder": 135,
    "position": 0,
    "text": "همه برگرفتند یکسر خروش"
  },
  {
    "poem_id": 52173,
    "vorder": 136,
    "position": 1,
    "text": "زمین پر خروش و هوا پر ز جوش"
  },
  {
    "poem_id": 52173,
    "vorder": 137,
    "position": 0,
    "text": "پسر گفت کاین ایزدی کار بود"
  },
  {
    "poem_id": 52173,
    "vorder": 138,
    "position": 1,
    "text": "که بهرام را بخت بیدار بود"
  },
  {
    "poem_id": 52173,
    "vorder": 139,
    "position": 0,
    "text": "ز تنگی کجا راه بد بر سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 140,
    "position": 1,
    "text": "فراوان بمردند زان تنگ راه"
  },
  {
    "poem_id": 52173,
    "vorder": 141,
    "position": 0,
    "text": "بسی پیل بسپرد مردم به‌پای"
  },
  {
    "poem_id": 52173,
    "vorder": 142,
    "position": 1,
    "text": "نشد زان سپه ده یکی باز جای"
  },
  {
    "poem_id": 52173,
    "vorder": 143,
    "position": 0,
    "text": "چه زیر پی پیل گشته تباه"
  },
  {
    "poem_id": 52173,
    "vorder": 144,
    "position": 1,
    "text": "چه سرها بریده به‌آوردگاه"
  },
  {
    "poem_id": 52173,
    "vorder": 145,
    "position": 0,
    "text": "چو بگذشت زان روز بد به زمان"
  },
  {
    "poem_id": 52173,
    "vorder": 146,
    "position": 1,
    "text": "ندیدند زنده یکی بد گمان"
  },
  {
    "poem_id": 52173,
    "vorder": 147,
    "position": 0,
    "text": "مگرآنک بودند گشته اسیر"
  },
  {
    "poem_id": 52173,
    "vorder": 148,
    "position": 1,
    "text": "روان‌ها به غم خسته و تن به تیر"
  },
  {
    "poem_id": 52173,
    "vorder": 149,
    "position": 0,
    "text": "همه راه برگستوان بود و ترگ"
  },
  {
    "poem_id": 52173,
    "vorder": 150,
    "position": 1,
    "text": "سران را ز ترگ آمده روز مرگ"
  },
  {
    "poem_id": 52173,
    "vorder": 151,
    "position": 0,
    "text": "همان تیغ هندی و تیر و کمان"
  },
  {
    "poem_id": 52173,
    "vorder": 152,
    "position": 1,
    "text": "به هرسوی افگنده بد بدگمان"
  },
  {
    "poem_id": 52173,
    "vorder": 153,
    "position": 0,
    "text": "ز کشته چو دریای خون شد زمین"
  },
  {
    "poem_id": 52173,
    "vorder": 154,
    "position": 1,
    "text": "به هرگوشه‌ای مانده اسبی به زین"
  },
  {
    "poem_id": 52173,
    "vorder": 155,
    "position": 0,
    "text": "همی‌گشت بهرام گرد سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 156,
    "position": 1,
    "text": "که تا کشته ز ایران که یابد به راه"
  },
  {
    "poem_id": 52173,
    "vorder": 157,
    "position": 0,
    "text": "از آن پس بخراد برزین بگفت"
  },
  {
    "poem_id": 52173,
    "vorder": 158,
    "position": 1,
    "text": "که یک روز با رنج ما باش جفت"
  },
  {
    "poem_id": 52173,
    "vorder": 159,
    "position": 0,
    "text": "نگه کن کز ایرانیان کشته کیست"
  },
  {
    "poem_id": 52173,
    "vorder": 160,
    "position": 1,
    "text": "کزان درد ما را بباید گریست"
  },
  {
    "poem_id": 52173,
    "vorder": 161,
    "position": 0,
    "text": "به هرجای خراد برزین بگشت"
  },
  {
    "poem_id": 52173,
    "vorder": 162,
    "position": 1,
    "text": "به هر پرده و خیمه‌ای برگذشت"
  },
  {
    "poem_id": 52173,
    "vorder": 163,
    "position": 0,
    "text": "کم آمد زلشکر یکی نامور"
  },
  {
    "poem_id": 52173,
    "vorder": 164,
    "position": 1,
    "text": "که بهرام بدنام آن پرهنر"
  },
  {
    "poem_id": 52173,
    "vorder": 165,
    "position": 0,
    "text": "ز تخم سیاوش گوی مهتری"
  },
  {
    "poem_id": 52173,
    "vorder": 166,
    "position": 1,
    "text": "سپهبد سواری دلاور سری"
  },
  {
    "poem_id": 52173,
    "vorder": 167,
    "position": 0,
    "text": "همی‌رفت جوینده چون بیهشان"
  },
  {
    "poem_id": 52173,
    "vorder": 168,
    "position": 1,
    "text": "مگر زو بیابد بجایی نشان"
  },
  {
    "poem_id": 52173,
    "vorder": 169,
    "position": 0,
    "text": "تن خسته و کشته چندی کشید"
  },
  {
    "poem_id": 52173,
    "vorder": 170,
    "position": 1,
    "text": "ز بهرام جایی نشانی ندید"
  },
  {
    "poem_id": 52173,
    "vorder": 171,
    "position": 0,
    "text": "سپهدار زان کار شد دردمند"
  },
  {
    "poem_id": 52173,
    "vorder": 172,
    "position": 1,
    "text": "همی‌گفت زار ای گو مستمند"
  },
  {
    "poem_id": 52173,
    "vorder": 173,
    "position": 0,
    "text": "زمانی برآمد پدید آمد اوی"
  },
  {
    "poem_id": 52173,
    "vorder": 174,
    "position": 1,
    "text": "در بسته را چون کلید آمد اوی"
  },
  {
    "poem_id": 52173,
    "vorder": 175,
    "position": 0,
    "text": "ابا سرخ ترکی بد او گربه چشم"
  },
  {
    "poem_id": 52173,
    "vorder": 176,
    "position": 1,
    "text": "تو گفتی دل آزرده دارد بخشم"
  },
  {
    "poem_id": 52173,
    "vorder": 177,
    "position": 0,
    "text": "چو بهرام بهرام را دید گفت"
  },
  {
    "poem_id": 52173,
    "vorder": 178,
    "position": 1,
    "text": "که هرگز مبادی تو با خاک جفت"
  },
  {
    "poem_id": 52173,
    "vorder": 179,
    "position": 0,
    "text": "از آن پس بپرسیدش از ترک زشت"
  },
  {
    "poem_id": 52173,
    "vorder": 180,
    "position": 1,
    "text": "که ای دوزخی روی دور از بهشت"
  },
  {
    "poem_id": 52173,
    "vorder": 181,
    "position": 0,
    "text": "چه مردی و نام نژاد تو چیست"
  },
  {
    "poem_id": 52173,
    "vorder": 182,
    "position": 1,
    "text": "که زاینده را برتو باید گریست"
  },
  {
    "poem_id": 52173,
    "vorder": 183,
    "position": 0,
    "text": "چنین داد پاسخ که من جادوام"
  },
  {
    "poem_id": 52173,
    "vorder": 184,
    "position": 1,
    "text": "ز مردی و از مردمی یک‌سوام"
  },
  {
    "poem_id": 52173,
    "vorder": 185,
    "position": 0,
    "text": "هران کس که سالار باشد به جنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 186,
    "position": 1,
    "text": "به کارآیمش چون بود کارتنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 187,
    "position": 0,
    "text": "به شب چیزهایی نمایم بخواب"
  },
  {
    "poem_id": 52173,
    "vorder": 188,
    "position": 1,
    "text": "که آهستگان را کنم پرشتاب"
  },
  {
    "poem_id": 52173,
    "vorder": 189,
    "position": 0,
    "text": "تو را من نمودم شب آن خواب بد"
  },
  {
    "poem_id": 52173,
    "vorder": 190,
    "position": 1,
    "text": "بدان گونه تا بر سرت بد رسد"
  },
  {
    "poem_id": 52173,
    "vorder": 191,
    "position": 0,
    "text": "مرا چاره زان بیش بایست جست"
  },
  {
    "poem_id": 52173,
    "vorder": 192,
    "position": 1,
    "text": "چو نیرنگ‌ها را نکردم درست"
  },
  {
    "poem_id": 52173,
    "vorder": 193,
    "position": 0,
    "text": "به‌ما اختر بد چنین بازگشت"
  },
  {
    "poem_id": 52173,
    "vorder": 194,
    "position": 1,
    "text": "همان رنج با باد انباز گشت"
  },
  {
    "poem_id": 52173,
    "vorder": 195,
    "position": 0,
    "text": "اگر یابم از تو به جان زینهار"
  },
  {
    "poem_id": 52173,
    "vorder": 196,
    "position": 1,
    "text": "یکی پر هنر یافتی دست‌وار"
  },
  {
    "poem_id": 52173,
    "vorder": 197,
    "position": 0,
    "text": "چو بشنید بهرام و اندیشه کرد"
  },
  {
    "poem_id": 52173,
    "vorder": 198,
    "position": 1,
    "text": "دلش گشت پر درد و رخساره زرد"
  },
  {
    "poem_id": 52173,
    "vorder": 199,
    "position": 0,
    "text": "زمانی همی‌گفت کین روز جنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 200,
    "position": 1,
    "text": "به کار آیدم چو شود کار تنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 201,
    "position": 0,
    "text": "زمانی همی‌گفت برساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 202,
    "position": 1,
    "text": "چه سود آمد ازجادویی برسپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 203,
    "position": 0,
    "text": "همه نیکویها ز یزدان بود"
  },
  {
    "poem_id": 52173,
    "vorder": 204,
    "position": 1,
    "text": "کسی را کجا بخت خندان بود"
  },
  {
    "poem_id": 52173,
    "vorder": 205,
    "position": 0,
    "text": "بفرمود از تن بریدن سرش"
  },
  {
    "poem_id": 52173,
    "vorder": 206,
    "position": 1,
    "text": "جدا کرد جان از تن بی‌برش"
  },
  {
    "poem_id": 52173,
    "vorder": 207,
    "position": 0,
    "text": "چو او رابکشتند بر پای خاست"
  },
  {
    "poem_id": 52173,
    "vorder": 208,
    "position": 1,
    "text": "چنین گفت کای داور داد وراست"
  },
  {
    "poem_id": 52173,
    "vorder": 209,
    "position": 0,
    "text": "بزرگی و پیروزی و فرهی"
  },
  {
    "poem_id": 52173,
    "vorder": 210,
    "position": 1,
    "text": "بلندی و نیروی شاهنشهی"
  },
  {
    "poem_id": 52173,
    "vorder": 211,
    "position": 0,
    "text": "نژندی و هم شادمانی ز تست"
  },
  {
    "poem_id": 52173,
    "vorder": 212,
    "position": 1,
    "text": "انوشه دلیری که راه توجست"
  },
  {
    "poem_id": 52173,
    "vorder": 213,
    "position": 0,
    "text": "و زان پس بیامد دبیر بزرگ"
  },
  {
    "poem_id": 52173,
    "vorder": 214,
    "position": 1,
    "text": "چنین گفت کای پهلوان سترگ"
  },
  {
    "poem_id": 52173,
    "vorder": 215,
    "position": 0,
    "text": "فریدون یل چون تویک پهلوان"
  },
  {
    "poem_id": 52173,
    "vorder": 216,
    "position": 1,
    "text": "ندید و نه کسری نوشین روان"
  },
  {
    "poem_id": 52173,
    "vorder": 217,
    "position": 0,
    "text": "همت شیرمردی هم اورند و بند"
  },
  {
    "poem_id": 52173,
    "vorder": 218,
    "position": 1,
    "text": "که هرگز به جان‌ت مبادا گزند"
  },
  {
    "poem_id": 52173,
    "vorder": 219,
    "position": 0,
    "text": "همه شهر ایران به تو زنده‌اند"
  },
  {
    "poem_id": 52173,
    "vorder": 220,
    "position": 1,
    "text": "همه پهلوانان تو را بنده‌اند"
  },
  {
    "poem_id": 52173,
    "vorder": 221,
    "position": 0,
    "text": "بتو گشت بخت بزرگی بلند"
  },
  {
    "poem_id": 52173,
    "vorder": 222,
    "position": 1,
    "text": "به‌تو زیردستان شوند ارجمند"
  },
  {
    "poem_id": 52173,
    "vorder": 223,
    "position": 0,
    "text": "سپهبد تویی هم سپهبدنژاد"
  },
  {
    "poem_id": 52173,
    "vorder": 224,
    "position": 1,
    "text": "خنک مام کو چون تو فرزند زاد"
  },
  {
    "poem_id": 52173,
    "vorder": 225,
    "position": 0,
    "text": "که فرخ نژادی و فرخ سری"
  },
  {
    "poem_id": 52173,
    "vorder": 226,
    "position": 1,
    "text": "ستون همه شهر و بوم و بری"
  },
  {
    "poem_id": 52173,
    "vorder": 227,
    "position": 0,
    "text": "پراگنده گشتند ز آوردگاه"
  },
  {
    "poem_id": 52173,
    "vorder": 228,
    "position": 1,
    "text": "بزرگان و هم پهلوان سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 229,
    "position": 0,
    "text": "شب تیره چون زلف را تاب داد"
  },
  {
    "poem_id": 52173,
    "vorder": 230,
    "position": 1,
    "text": "همان تاب او چشم را خواب داد"
  },
  {
    "poem_id": 52173,
    "vorder": 231,
    "position": 0,
    "text": "پدید آمد آن پردهٔ آبنوس"
  },
  {
    "poem_id": 52173,
    "vorder": 232,
    "position": 1,
    "text": "بر آسود گیتی ز آواز کوس"
  },
  {
    "poem_id": 52173,
    "vorder": 233,
    "position": 0,
    "text": "همی‌گشت گردون شتاب آمدش"
  },
  {
    "poem_id": 52173,
    "vorder": 234,
    "position": 1,
    "text": "شب تیره را دیریاب آمدش"
  },
  {
    "poem_id": 52173,
    "vorder": 235,
    "position": 0,
    "text": "بر آمد یکی زرد کشتی ز آب"
  },
  {
    "poem_id": 52173,
    "vorder": 236,
    "position": 1,
    "text": "بپالود رنج و بپالود خواب"
  },
  {
    "poem_id": 52173,
    "vorder": 237,
    "position": 0,
    "text": "سپهبد بیامد فرستاد کس"
  },
  {
    "poem_id": 52173,
    "vorder": 238,
    "position": 1,
    "text": "به‌نزدیک یاران فریادرس"
  },
  {
    "poem_id": 52173,
    "vorder": 239,
    "position": 0,
    "text": "که تا هرک شد کشته از مهتران"
  },
  {
    "poem_id": 52173,
    "vorder": 240,
    "position": 1,
    "text": "بزرگان ترکان و جنگ آوران"
  },
  {
    "poem_id": 52173,
    "vorder": 241,
    "position": 0,
    "text": "سران‌شان ببرید یکسر ز تن"
  },
  {
    "poem_id": 52173,
    "vorder": 242,
    "position": 1,
    "text": "کسی راکه بد مهتر انجمن"
  },
  {
    "poem_id": 52173,
    "vorder": 243,
    "position": 0,
    "text": "درفشی درفشان پس هر سری"
  },
  {
    "poem_id": 52173,
    "vorder": 244,
    "position": 1,
    "text": "که بودند از آن جنگیان افسری"
  },
  {
    "poem_id": 52173,
    "vorder": 245,
    "position": 0,
    "text": "اسیران و سرها همه گرد کرد"
  },
  {
    "poem_id": 52173,
    "vorder": 246,
    "position": 1,
    "text": "ببردند ز آوردگاه نبرد"
  },
  {
    "poem_id": 52173,
    "vorder": 247,
    "position": 0,
    "text": "دبیر نویسنده را پیش خواند"
  },
  {
    "poem_id": 52173,
    "vorder": 248,
    "position": 1,
    "text": "ز هر در فراوان سخن‌ها براند"
  },
  {
    "poem_id": 52173,
    "vorder": 249,
    "position": 0,
    "text": "از آن لشکر نامور بی‌شمار"
  },
  {
    "poem_id": 52173,
    "vorder": 250,
    "position": 1,
    "text": "از آن جنبش و گردش روزگار"
  },
  {
    "poem_id": 52173,
    "vorder": 251,
    "position": 0,
    "text": "از آن چاره و جنگ واز هر دری"
  },
  {
    "poem_id": 52173,
    "vorder": 252,
    "position": 1,
    "text": "کجا رفته بد با چنان لشکری"
  },
  {
    "poem_id": 52173,
    "vorder": 253,
    "position": 0,
    "text": "و زان کوشش و جنگ ایرانیان"
  },
  {
    "poem_id": 52173,
    "vorder": 254,
    "position": 1,
    "text": "که نگشاد روزی سواری میان"
  },
  {
    "poem_id": 52173,
    "vorder": 255,
    "position": 0,
    "text": "چو آن نامه بنوشت نزدیک شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 256,
    "position": 1,
    "text": "گزین کرد گوینده‌ای زان سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 257,
    "position": 0,
    "text": "نخستین سر ساوه برنیزه کرد"
  },
  {
    "poem_id": 52173,
    "vorder": 258,
    "position": 1,
    "text": "درفشی کجا داشتی در نبرد"
  },
  {
    "poem_id": 52173,
    "vorder": 259,
    "position": 0,
    "text": "سران بزرگان توران زمین"
  },
  {
    "poem_id": 52173,
    "vorder": 260,
    "position": 1,
    "text": "چنان هم درفش سواران چین"
  },
  {
    "poem_id": 52173,
    "vorder": 261,
    "position": 0,
    "text": "بفرمود تا برستور نوند"
  },
  {
    "poem_id": 52173,
    "vorder": 262,
    "position": 1,
    "text": "به‌زودی برشاه ایران برند"
  },
  {
    "poem_id": 52173,
    "vorder": 263,
    "position": 0,
    "text": "اسیران و آن خواسته هرچ بود"
  },
  {
    "poem_id": 52173,
    "vorder": 264,
    "position": 1,
    "text": "همی‌داشت اندر هری نابسود"
  },
  {
    "poem_id": 52173,
    "vorder": 265,
    "position": 0,
    "text": "بدان تا چه فرمان دهد شهریار"
  },
  {
    "poem_id": 52173,
    "vorder": 266,
    "position": 1,
    "text": "فرستاد با سر فراوان سوار"
  },
  {
    "poem_id": 52173,
    "vorder": 267,
    "position": 0,
    "text": "همان تا بود نیز دستور شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 268,
    "position": 1,
    "text": "سوی جنگ پرموده بردن سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 269,
    "position": 0,
    "text": "ستور نوند اندر آمد ز جای"
  },
  {
    "poem_id": 52173,
    "vorder": 270,
    "position": 1,
    "text": "به‌پیش سواران یکی رهنمای"
  },
  {
    "poem_id": 52173,
    "vorder": 271,
    "position": 0,
    "text": "وزان روی ترکان همه برهنه"
  },
  {
    "poem_id": 52173,
    "vorder": 272,
    "position": 1,
    "text": "برفتند بی‌ساز واسب و بنه"
  },
  {
    "poem_id": 52173,
    "vorder": 273,
    "position": 0,
    "text": "رسیدند یکسر به‌توران زمین"
  },
  {
    "poem_id": 52173,
    "vorder": 274,
    "position": 1,
    "text": "سواران ترک و دلیران چین"
  },
  {
    "poem_id": 52173,
    "vorder": 275,
    "position": 0,
    "text": "چو آمد بپرموده زان آگهی"
  },
  {
    "poem_id": 52173,
    "vorder": 276,
    "position": 1,
    "text": "بینداخت از سر کلاه مهی"
  },
  {
    "poem_id": 52173,
    "vorder": 277,
    "position": 0,
    "text": "خروشی بر آمد ز ترکان به‌زار"
  },
  {
    "poem_id": 52173,
    "vorder": 278,
    "position": 1,
    "text": "برآن مهتران تلخ شد روزگار"
  },
  {
    "poem_id": 52173,
    "vorder": 279,
    "position": 0,
    "text": "همه سر پر از گرد و دیده پر آب"
  },
  {
    "poem_id": 52173,
    "vorder": 280,
    "position": 1,
    "text": "کسی رانبد خورد و آرام و خواب"
  },
  {
    "poem_id": 52173,
    "vorder": 281,
    "position": 0,
    "text": "ازآن پس گوان‌را بر خویش خواند"
  },
  {
    "poem_id": 52173,
    "vorder": 282,
    "position": 1,
    "text": "به‌مژگان همی خون دل برفشاند"
  },
  {
    "poem_id": 52173,
    "vorder": 283,
    "position": 0,
    "text": "بپرسید کز لشکر بی‌شمار"
  },
  {
    "poem_id": 52173,
    "vorder": 284,
    "position": 1,
    "text": "که در رزم جستن نکردند کار"
  },
  {
    "poem_id": 52173,
    "vorder": 285,
    "position": 0,
    "text": "چنین داد پاسخ ورا رهنمون"
  },
  {
    "poem_id": 52173,
    "vorder": 286,
    "position": 1,
    "text": "که ما داشتیم آن سپه را زبون"
  },
  {
    "poem_id": 52173,
    "vorder": 287,
    "position": 0,
    "text": "چو بهرام جنگی بهنگام کار"
  },
  {
    "poem_id": 52173,
    "vorder": 288,
    "position": 1,
    "text": "نبیند کس اندر جهان یک سوار"
  },
  {
    "poem_id": 52173,
    "vorder": 289,
    "position": 0,
    "text": "ز رستم فزونست هنگام جنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 290,
    "position": 1,
    "text": "دلیران نگیرند پیشش درنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 291,
    "position": 0,
    "text": "نبد لشکرش را ز ما صد یکی"
  },
  {
    "poem_id": 52173,
    "vorder": 292,
    "position": 1,
    "text": "نخست از دلیران ما کودکی"
  },
  {
    "poem_id": 52173,
    "vorder": 293,
    "position": 0,
    "text": "جهان‌دار یزدان ورا برکشید"
  },
  {
    "poem_id": 52173,
    "vorder": 294,
    "position": 1,
    "text": "ازین بیش گویم نباید شنید"
  },
  {
    "poem_id": 52173,
    "vorder": 295,
    "position": 0,
    "text": "چو پرموده بشنید گفتار اوی"
  },
  {
    "poem_id": 52173,
    "vorder": 296,
    "position": 1,
    "text": "پر اندیشه گشتش دل از کار اوی"
  },
  {
    "poem_id": 52173,
    "vorder": 297,
    "position": 0,
    "text": "بجوشید و رخسارگان کرد زرد"
  },
  {
    "poem_id": 52173,
    "vorder": 298,
    "position": 1,
    "text": "به‌درد دل آهنگ آورد کرد"
  },
  {
    "poem_id": 52173,
    "vorder": 299,
    "position": 0,
    "text": "سپه بودش از جنگیان صدهزار"
  },
  {
    "poem_id": 52173,
    "vorder": 300,
    "position": 1,
    "text": "همه نامدار از در کارزار"
  },
  {
    "poem_id": 52173,
    "vorder": 301,
    "position": 0,
    "text": "ز خرگاه لشکر به‌هامون کشید"
  },
  {
    "poem_id": 52173,
    "vorder": 302,
    "position": 1,
    "text": "به نزدیکی رود جیحون کشید"
  },
  {
    "poem_id": 52173,
    "vorder": 303,
    "position": 0,
    "text": "وزان پس کجا نامه پهلوان"
  },
  {
    "poem_id": 52173,
    "vorder": 304,
    "position": 1,
    "text": "بیامد بر شاه روشن روان"
  },
  {
    "poem_id": 52173,
    "vorder": 305,
    "position": 0,
    "text": "نشسته جهان‌دار با موبدان"
  },
  {
    "poem_id": 52173,
    "vorder": 306,
    "position": 1,
    "text": "همی‌گفت کای نامور بخردان"
  },
  {
    "poem_id": 52173,
    "vorder": 307,
    "position": 0,
    "text": "دو هفته بدین بارگاه مهی"
  },
  {
    "poem_id": 52173,
    "vorder": 308,
    "position": 1,
    "text": "نیامد ز بهرام هیچ آگهی"
  },
  {
    "poem_id": 52173,
    "vorder": 309,
    "position": 0,
    "text": "چه گویید ازین پس چه شاید بدن"
  },
  {
    "poem_id": 52173,
    "vorder": 310,
    "position": 1,
    "text": "بباید بدین داستان‌ها زدن"
  },
  {
    "poem_id": 52173,
    "vorder": 311,
    "position": 0,
    "text": "همانگه که گفت این سخن شهریار"
  },
  {
    "poem_id": 52173,
    "vorder": 312,
    "position": 1,
    "text": "بیامد ز درگاه سالار بار"
  },
  {
    "poem_id": 52173,
    "vorder": 313,
    "position": 0,
    "text": "شهنشاه را زان سخن مژده داد"
  },
  {
    "poem_id": 52173,
    "vorder": 314,
    "position": 1,
    "text": "که جاوید بادا جهان‌دار شاد"
  },
  {
    "poem_id": 52173,
    "vorder": 315,
    "position": 0,
    "text": "که بهرام بر ساوه پیروز گشت"
  },
  {
    "poem_id": 52173,
    "vorder": 316,
    "position": 1,
    "text": "به رزم اندرون گیتی افروز گشت"
  },
  {
    "poem_id": 52173,
    "vorder": 317,
    "position": 0,
    "text": "سبک مرد بهرام را پیش خواند"
  },
  {
    "poem_id": 52173,
    "vorder": 318,
    "position": 1,
    "text": "وزان نامدارانش برتر نشاند"
  },
  {
    "poem_id": 52173,
    "vorder": 319,
    "position": 0,
    "text": "فرستاده گفت ای سر افراز شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 320,
    "position": 1,
    "text": "به کام تو شد کام آن رزم‌گاه"
  },
  {
    "poem_id": 52173,
    "vorder": 321,
    "position": 0,
    "text": "انوشه بدی شاد و رامش‌پذیر"
  },
  {
    "poem_id": 52173,
    "vorder": 322,
    "position": 1,
    "text": "که بخت بد اندیش توگشت پیر"
  },
  {
    "poem_id": 52173,
    "vorder": 323,
    "position": 0,
    "text": "سر ساوه شاهست و کهتر پسر"
  },
  {
    "poem_id": 52173,
    "vorder": 324,
    "position": 1,
    "text": "که فغفور خواندیش وی‌را پدر"
  },
  {
    "poem_id": 52173,
    "vorder": 325,
    "position": 0,
    "text": "زده بر سرنیزه‌ها بر درست"
  },
  {
    "poem_id": 52173,
    "vorder": 326,
    "position": 1,
    "text": "همه شهر نظاره آن سرست"
  },
  {
    "poem_id": 52173,
    "vorder": 327,
    "position": 0,
    "text": "شهنشاه بشنید بر پای خاست"
  },
  {
    "poem_id": 52173,
    "vorder": 328,
    "position": 1,
    "text": "بزودی خم آورد بالای راست"
  },
  {
    "poem_id": 52173,
    "vorder": 329,
    "position": 0,
    "text": "همی‌بود بر پیش یزدان به‌پای"
  },
  {
    "poem_id": 52173,
    "vorder": 330,
    "position": 1,
    "text": "همی‌گفت کای داور رهنمای"
  },
  {
    "poem_id": 52173,
    "vorder": 331,
    "position": 0,
    "text": "بد اندیش ما را تو کردی تباه"
  },
  {
    "poem_id": 52173,
    "vorder": 332,
    "position": 1,
    "text": "تویی آفریننده هور و ماه"
  },
  {
    "poem_id": 52173,
    "vorder": 333,
    "position": 0,
    "text": "چنان زار و نومید بودم ز بخت"
  },
  {
    "poem_id": 52173,
    "vorder": 334,
    "position": 1,
    "text": "که دشمن نگون اندر آمد ز تخت"
  },
  {
    "poem_id": 52173,
    "vorder": 335,
    "position": 0,
    "text": "سپهبد نکرد این نه جنگی سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 336,
    "position": 1,
    "text": "که یزدان بد این جنگ را نیک خواه"
  },
  {
    "poem_id": 52173,
    "vorder": 337,
    "position": 0,
    "text": "بیاورد زان پس صد و سی هزار"
  },
  {
    "poem_id": 52173,
    "vorder": 338,
    "position": 1,
    "text": "ز گنجی که بود از پدر یادگار"
  },
  {
    "poem_id": 52173,
    "vorder": 339,
    "position": 0,
    "text": "سه یک زان نخستین بدرویش داد"
  },
  {
    "poem_id": 52173,
    "vorder": 340,
    "position": 1,
    "text": "پرستندگان را درم بیش داد"
  },
  {
    "poem_id": 52173,
    "vorder": 341,
    "position": 0,
    "text": "سه یک دیگر از بهر آتشکده"
  },
  {
    "poem_id": 52173,
    "vorder": 342,
    "position": 1,
    "text": "همان بهر نوروز و جشن سده"
  },
  {
    "poem_id": 52173,
    "vorder": 343,
    "position": 0,
    "text": "فرستاد تا هیربد را دهند"
  },
  {
    "poem_id": 52173,
    "vorder": 344,
    "position": 1,
    "text": "که در پیش آتشکده برنهند"
  },
  {
    "poem_id": 52173,
    "vorder": 345,
    "position": 0,
    "text": "سیم بهره جایی که ویران بود"
  },
  {
    "poem_id": 52173,
    "vorder": 346,
    "position": 1,
    "text": "رباطی که اندر بیابان بود"
  },
  {
    "poem_id": 52173,
    "vorder": 347,
    "position": 0,
    "text": "کند یکسر آباد جوینده مرد"
  },
  {
    "poem_id": 52173,
    "vorder": 348,
    "position": 1,
    "text": "نباشد به راه اندرون بیم و درد"
  },
  {
    "poem_id": 52173,
    "vorder": 349,
    "position": 0,
    "text": "ببخشید پس چار ساله خراج"
  },
  {
    "poem_id": 52173,
    "vorder": 350,
    "position": 1,
    "text": "به درویش و آن را که بد تخت عاج"
  },
  {
    "poem_id": 52173,
    "vorder": 351,
    "position": 0,
    "text": "نبشتند پس نامه از شهریار"
  },
  {
    "poem_id": 52173,
    "vorder": 352,
    "position": 1,
    "text": "به هرکشوری سوی هرنامدار"
  },
  {
    "poem_id": 52173,
    "vorder": 353,
    "position": 0,
    "text": "که بهرام پیروز شد بر سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 354,
    "position": 1,
    "text": "بریدند بی‌بر سر ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 355,
    "position": 0,
    "text": "پرستنده بد شاه در هفت روز"
  },
  {
    "poem_id": 52173,
    "vorder": 356,
    "position": 1,
    "text": "به هشتم چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 52173,
    "vorder": 357,
    "position": 0,
    "text": "فرستادهٔ پهلوان رابخواند"
  },
  {
    "poem_id": 52173,
    "vorder": 358,
    "position": 1,
    "text": "به مهر از بر نامداران نشاند"
  },
  {
    "poem_id": 52173,
    "vorder": 359,
    "position": 0,
    "text": "مر آن نامه را خوب پاسخ نبشت"
  },
  {
    "poem_id": 52173,
    "vorder": 360,
    "position": 1,
    "text": "درختی به باغ بزرگی بکشت"
  },
  {
    "poem_id": 52173,
    "vorder": 361,
    "position": 0,
    "text": "یکی تخت سیمین فرستاد نیز"
  },
  {
    "poem_id": 52173,
    "vorder": 362,
    "position": 1,
    "text": "دو نعلین زرین و هر گونه چیز"
  },
  {
    "poem_id": 52173,
    "vorder": 363,
    "position": 0,
    "text": "ز هیتال تا پیش رود برک"
  },
  {
    "poem_id": 52173,
    "vorder": 364,
    "position": 1,
    "text": "به بهرام بخشید و بنوشت چک"
  },
  {
    "poem_id": 52173,
    "vorder": 365,
    "position": 0,
    "text": "بفرمود کان خواسته بر سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 366,
    "position": 1,
    "text": "ببخش آنچ آوردی از رزم‌گاه"
  },
  {
    "poem_id": 52173,
    "vorder": 367,
    "position": 0,
    "text": "مگرگنج ویژه تن ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 368,
    "position": 1,
    "text": "که آورد باید بدین بارگاه"
  },
  {
    "poem_id": 52173,
    "vorder": 369,
    "position": 0,
    "text": "وزان پس تو خود جنگ پرموده ساز"
  },
  {
    "poem_id": 52173,
    "vorder": 370,
    "position": 1,
    "text": "ممان تا شود خصم گردن فراز"
  },
  {
    "poem_id": 52173,
    "vorder": 371,
    "position": 0,
    "text": "هم ایرانیان را فرستاد چیز"
  },
  {
    "poem_id": 52173,
    "vorder": 372,
    "position": 1,
    "text": "نبشته به هر شهر منشور نیز"
  },
  {
    "poem_id": 52173,
    "vorder": 373,
    "position": 0,
    "text": "فرستاده را خلعت آراستند"
  },
  {
    "poem_id": 52173,
    "vorder": 374,
    "position": 1,
    "text": "پس اسب جهان پهلوان خواستند"
  },
  {
    "poem_id": 52173,
    "vorder": 375,
    "position": 0,
    "text": "فرستاده چون پیش بهرام شد"
  },
  {
    "poem_id": 52173,
    "vorder": 376,
    "position": 1,
    "text": "سپهدار از و شاد و پدرام شد"
  },
  {
    "poem_id": 52173,
    "vorder": 377,
    "position": 0,
    "text": "غنیمت ببخشید پس بر سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 378,
    "position": 1,
    "text": "جز از گنج ناپاک دل ساوه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 379,
    "position": 0,
    "text": "فرستاد تا استواران خویش"
  },
  {
    "poem_id": 52173,
    "vorder": 380,
    "position": 1,
    "text": "جهان‌دیده ونام‌داران خویش"
  },
  {
    "poem_id": 52173,
    "vorder": 381,
    "position": 0,
    "text": "ببردند یک‌سر به درگاه شاه"
  },
  {
    "poem_id": 52173,
    "vorder": 382,
    "position": 1,
    "text": "سپهبد سوی جنگ شد با سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 383,
    "position": 0,
    "text": "ازو چون بپرموده شد آگهی"
  },
  {
    "poem_id": 52173,
    "vorder": 384,
    "position": 1,
    "text": "که جوید همی تخت شاهنشهی"
  },
  {
    "poem_id": 52173,
    "vorder": 385,
    "position": 0,
    "text": "دزی داشت پرموده افراز نام"
  },
  {
    "poem_id": 52173,
    "vorder": 386,
    "position": 1,
    "text": "کزان دز بدی ایمن و شادکام"
  },
  {
    "poem_id": 52173,
    "vorder": 387,
    "position": 0,
    "text": "نهاد آنچ بودش بدز در درم"
  },
  {
    "poem_id": 52173,
    "vorder": 388,
    "position": 1,
    "text": "ز دینار وز گوهر و بیش و کم"
  },
  {
    "poem_id": 52173,
    "vorder": 389,
    "position": 0,
    "text": "ز جیحون گذر کرد خود با سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 390,
    "position": 1,
    "text": "بیامد گرازان سوی زرم‌گاه"
  },
  {
    "poem_id": 52173,
    "vorder": 391,
    "position": 0,
    "text": "دو لشکر به تنگ اندر آمد به جنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 392,
    "position": 1,
    "text": "به‌ره بر نکردند جایی درنگ"
  },
  {
    "poem_id": 52173,
    "vorder": 393,
    "position": 0,
    "text": "بدو منزل بلخ هر دو سپاه"
  },
  {
    "poem_id": 52173,
    "vorder": 394,
    "position": 1,
    "text": "گزیدند شایسته دو رزم‌گاه"
  },
  {
    "poem_id": 52173,
    "vorder": 395,
    "position": 0,
    "text": "میان دو لشکر دو فرسنگ بود"
  },
  {
    "poem_id": 52173,
    "vorder": 396,
    "position": 1,
    "text": "که پهنای دشت از در جنگ بود"
  },
  {
    "poem_id": 52173,
    "vorder": 397,
    "position": 0,
    "text": "دگر روز بهرام جنگی برفت"
  },
  {
    "poem_id": 52173,
    "vorder": 398,
    "position": 1,
    "text": "به دیدار گردان پرموده تفت"
  },
  {
    "poem_id": 52173,
    "vorder": 399,
    "position": 0,
    "text": "نگه کرد پرموده را بدید"
  },
  {
    "poem_id": 52173,
    "vorder": 400,
    "position": 1,
    "text": "ز هامون یکی تند بالا گزید"
  },
  {
    "poem_id": 52173,
    "vorder": 401,
    "position": 0,
    "text": "سپه را سراسر همه برنشاند"
  },
  {
    "poem_id": 52173,
    "vorder": 402,
    "position": 1,
    "text": "چنان شد که در دشت جایی نماند"
  },
  {
    "poem_id": 52173,
    "vorder": 403,
    "position": 0,
    "text": "سپه دید پرموده چندانک دشت"
  },
  {
    "poem_id": 52173,
    "vorder": 404,
    "position": 1,
    "text": "ز دیدار ایشان همی خیره گشت"
  },
  {
    "poem_id": 52173,
    "vorder": 405,
    "position": 0,
    "text": "و را دید در پیش آن لشکرش"
  },
  {
    "poem_id": 52173,
    "vorder": 406,
    "position": 1,
    "text": "به گردون برآورده جنگی سرش"
  },
  {
    "poem_id": 52173,
    "vorder": 407,
    "position": 0,
    "text": "غمی گشت و با لشکر خویش گفت"
  },
  {
    "poem_id": 52173,
    "vorder": 408,
    "position": 1,
    "text": "که این پیش‌رو را هزبرست جفت"
  },
  {
    "poem_id": 52173,
    "vorder": 409,
    "position": 0,
    "text": "شمار سپاهش پدیدار نیست"
  },
  {
    "poem_id": 52173,
    "vorder": 410,
    "position": 1,
    "text": "هم این رزم را کس خریدار نیست"
  },
  {
    "poem_id": 52173,
    "vorder": 411,
    "position": 0,
    "text": "سپهدار گردن‌کش و خشمناک"
  },
  {
    "poem_id": 52173,
    "vorder": 412,
    "position": 1,
    "text": "همی خون شود زیر او تیره خاک"
  },
  {
    "poem_id": 52173,
    "vorder": 413,
    "position": 0,
    "text": "چو شب تیره گردد شبیخون کنیم"
  },
  {
    "poem_id": 52173,
    "vorder": 414,
    "position": 1,
    "text": "ز دل بیم و اندیشه بیرون کنیم"
  },
  {
    "poem_id": 52173,
    "vorder": 415,
    "position": 0,
    "text": "چو پرموده آمد به پرده سرای"
  },
  {
    "poem_id": 52173,
    "vorder": 416,
    "position": 1,
    "text": "همی‌زد ز هر گونه از جنگ رای"
  },
  {
    "poem_id": 52173,
    "vorder": 417,
    "position": 0,
    "text": "همی‌گفت کین از هنرها یکیست"
  },
  {
    "poem_id": 52173,
    "vorder": 418,
    "position": 1,
    "text": "اگر چه سپه‌شان کنون اندکیست"
  },
  {
    "poem_id": 52173,
    "vorder": 419,
    "position": 0,
    "text": "سواران و گردان پر مایه‌اند"
  },
  {
    "poem_id": 52173,
    "vorder": 420,
    "position": 1,
    "text": "ز گردن‌کشان برترین پایه‌اند"
  },
  {
    "poem_id": 52173,
    "vorder": 421,
    "position": 0,
    "text": "سلیحست وبهرام‌شان پیش‌رو"
  },
  {
    "poem_id": 52173,
    "vorder": 422,
    "position": 1,
    "text": "که گردد سنان پیش او خار و خو"
  },
  {
    "poem_id": 52173,
    "vorder": 423,
    "position": 0,
    "text": "به پیروزی ساوه شاه اندرون"
  },
  {
    "poem_id": 52173,
    "vorder": 424,
    "position": 1,
    "text": "گرفته دل و مست گشته به خون"
  },
  {
    "poem_id": 52173,
    "vorder": 425,
    "position": 0,
    "text": "اگر یار باشد جهان آفرین"
  },
  {
    "poem_id": 52173,
    "vorder": 426,
    "position": 1,
    "text": "به خون پدر خواهم از کوه کین"
  },
  {
    "poem_id": 52173,
    "vorder": 427,
    "position": 0,
    "text": "بدان‌گه که بهرام شد جنگ‌جوی"
  },
  {
    "poem_id": 52173,
    "vorder": 428,
    "position": 1,
    "text": "از ایران سوی ترک بنهاد روی"
  }
]