[
  {
    "poem_id": 1940,
    "vorder": 1,
    "position": 0,
    "text": "چو بگذشت سال از برم شست و پنج"
  },
  {
    "poem_id": 1940,
    "vorder": 2,
    "position": 1,
    "text": "فزون کردم اندیشه و درد و رنج"
  },
  {
    "poem_id": 1940,
    "vorder": 3,
    "position": 0,
    "text": "به تاریخ شاهان نیاز آمدم"
  },
  {
    "poem_id": 1940,
    "vorder": 4,
    "position": 1,
    "text": "به پیش اختر دیرساز آمدم"
  },
  {
    "poem_id": 1940,
    "vorder": 5,
    "position": 0,
    "text": "بزرگان و بادانش آزادگان"
  },
  {
    "poem_id": 1940,
    "vorder": 6,
    "position": 1,
    "text": "نبشتند یکسر همه رایگان"
  },
  {
    "poem_id": 1940,
    "vorder": 7,
    "position": 0,
    "text": "نشسته نظاره من از دورشان"
  },
  {
    "poem_id": 1940,
    "vorder": 8,
    "position": 1,
    "text": "تو گفتی بدم پیش مزدورشان"
  },
  {
    "poem_id": 1940,
    "vorder": 9,
    "position": 0,
    "text": "جز احسنت از ایشان نبُد بهره‌ام"
  },
  {
    "poem_id": 1940,
    "vorder": 10,
    "position": 1,
    "text": "بِکَفت اندر احسنتشان زهره‌ام"
  },
  {
    "poem_id": 1940,
    "vorder": 11,
    "position": 0,
    "text": "سر بدره‌های کهن بسته شد"
  },
  {
    "poem_id": 1940,
    "vorder": 12,
    "position": 1,
    "text": "وزان بند روشن دلم خسته شد"
  },
  {
    "poem_id": 1940,
    "vorder": 13,
    "position": 0,
    "text": "ازین نامور نامداران شهر"
  },
  {
    "poem_id": 1940,
    "vorder": 14,
    "position": 1,
    "text": "علی دیلمی بود کو راست بهر"
  },
  {
    "poem_id": 1940,
    "vorder": 15,
    "position": 0,
    "text": "که همواره کارش بخوبی روان"
  },
  {
    "poem_id": 1940,
    "vorder": 16,
    "position": 1,
    "text": "به نزد بزرگان روشن‌روان"
  },
  {
    "poem_id": 1940,
    "vorder": 17,
    "position": 0,
    "text": "حسین قتیب است از آزادگان"
  },
  {
    "poem_id": 1940,
    "vorder": 18,
    "position": 1,
    "text": "که از من نخواهد سخن رایگان"
  },
  {
    "poem_id": 1940,
    "vorder": 19,
    "position": 0,
    "text": "ازویم خور و پوشش و سیم و زر"
  },
  {
    "poem_id": 1940,
    "vorder": 20,
    "position": 1,
    "text": "وزو یافتم جنبش و پای و پر"
  },
  {
    "poem_id": 1940,
    "vorder": 21,
    "position": 0,
    "text": "نیَم آگه از اصل و فرع خراج"
  },
  {
    "poem_id": 1940,
    "vorder": 22,
    "position": 1,
    "text": "همی‌غلتم اندر میان دواج"
  },
  {
    "poem_id": 1940,
    "vorder": 23,
    "position": 0,
    "text": "جهاندار اگر نیستی تنگ‌دست"
  },
  {
    "poem_id": 1940,
    "vorder": 24,
    "position": 1,
    "text": "مرا بر سر گاه بودی نشست"
  },
  {
    "poem_id": 1940,
    "vorder": 25,
    "position": 0,
    "text": "چو سال اندر آمد به هفتاد و یک"
  },
  {
    "poem_id": 1940,
    "vorder": 26,
    "position": 1,
    "text": "همی زیر بیت اندر آرم فلک"
  },
  {
    "poem_id": 1940,
    "vorder": 27,
    "position": 0,
    "text": "همی گاه محمود آباد باد"
  },
  {
    "poem_id": 1940,
    "vorder": 28,
    "position": 1,
    "text": "سرش سبز باد و دلش شاد باد"
  },
  {
    "poem_id": 1940,
    "vorder": 29,
    "position": 0,
    "text": "چنانش ستایم که اندر جهان"
  },
  {
    "poem_id": 1940,
    "vorder": 30,
    "position": 1,
    "text": "سخن باشد از آشکار و نهان"
  },
  {
    "poem_id": 1940,
    "vorder": 31,
    "position": 0,
    "text": "مرا از بزرگان ستایش بود"
  },
  {
    "poem_id": 1940,
    "vorder": 32,
    "position": 1,
    "text": "ستایش ورا در فزایش بود"
  },
  {
    "poem_id": 1940,
    "vorder": 33,
    "position": 0,
    "text": "که جاوید باد آن خردمند مرد"
  },
  {
    "poem_id": 1940,
    "vorder": 34,
    "position": 1,
    "text": "همیشه به کام دلش کار کرد"
  },
  {
    "poem_id": 1940,
    "vorder": 35,
    "position": 0,
    "text": "همش رای و هم دانش و هم نسب"
  },
  {
    "poem_id": 1940,
    "vorder": 36,
    "position": 1,
    "text": "چراغ عجم آفتاب عرب"
  },
  {
    "poem_id": 1940,
    "vorder": 37,
    "position": 0,
    "text": "سرآمد کنون قصهٔ یزدگرد"
  },
  {
    "poem_id": 1940,
    "vorder": 38,
    "position": 1,
    "text": "به ماه سفندارمذ، روزِ اَرد"
  },
  {
    "poem_id": 1940,
    "vorder": 39,
    "position": 0,
    "text": "ز هجرت شده پنج هشتاد بار"
  },
  {
    "poem_id": 1940,
    "vorder": 40,
    "position": 1,
    "text": "به نام جهانداور کردگار"
  },
  {
    "poem_id": 1940,
    "vorder": 41,
    "position": 0,
    "text": "چو این نامور‌نامه آمد به بُن"
  },
  {
    "poem_id": 1940,
    "vorder": 42,
    "position": 1,
    "text": "ز من روی کشور شود پر سخُن"
  },
  {
    "poem_id": 1940,
    "vorder": 43,
    "position": 0,
    "text": "از آن پس نمیرم که من زنده‌ام"
  },
  {
    "poem_id": 1940,
    "vorder": 44,
    "position": 1,
    "text": "که تخم سخن من پراگنده‌ام"
  },
  {
    "poem_id": 1940,
    "vorder": 45,
    "position": 0,
    "text": "هر آنکس که دارد هُش و رای و دین"
  },
  {
    "poem_id": 1940,
    "vorder": 46,
    "position": 1,
    "text": "پس از مرگ بر من کند آفرین"
  }
]