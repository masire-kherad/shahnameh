[
  {
    "poem_id": 1732,
    "vorder": 1,
    "position": 0,
    "text": "چو بر گاه رفت اورمزد بزرگ"
  },
  {
    "poem_id": 1732,
    "vorder": 2,
    "position": 1,
    "text": "ز نخچیر کوتاه شد چنگ گرگ"
  },
  {
    "poem_id": 1732,
    "vorder": 3,
    "position": 0,
    "text": "جهان را همی داشت با ایمنی"
  },
  {
    "poem_id": 1732,
    "vorder": 4,
    "position": 1,
    "text": "نهان گشت کردار آهرمنی"
  },
  {
    "poem_id": 1732,
    "vorder": 5,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1732,
    "vorder": 6,
    "position": 1,
    "text": "توانا و دانا و پروردگار"
  },
  {
    "poem_id": 1732,
    "vorder": 7,
    "position": 0,
    "text": "شب و روز و گردان سپهر آفرید"
  },
  {
    "poem_id": 1732,
    "vorder": 8,
    "position": 1,
    "text": "چو بهرام و کیوان و مهر آفرید"
  },
  {
    "poem_id": 1732,
    "vorder": 9,
    "position": 0,
    "text": "ازویست پیروزی و فرهی"
  },
  {
    "poem_id": 1732,
    "vorder": 10,
    "position": 1,
    "text": "دل و داد و دیهیم شاهنشهی"
  },
  {
    "poem_id": 1732,
    "vorder": 11,
    "position": 0,
    "text": "همیشه دل ما پر از داد باد"
  },
  {
    "poem_id": 1732,
    "vorder": 12,
    "position": 1,
    "text": "دل زیردستان به ما شاد باد"
  },
  {
    "poem_id": 1732,
    "vorder": 13,
    "position": 0,
    "text": "ستایش نیابد سر سفله مرد"
  },
  {
    "poem_id": 1732,
    "vorder": 14,
    "position": 1,
    "text": "بر سفلگان تا توانی مگرد"
  },
  {
    "poem_id": 1732,
    "vorder": 15,
    "position": 0,
    "text": "همان نیز با مرد بدخواه رای"
  },
  {
    "poem_id": 1732,
    "vorder": 16,
    "position": 1,
    "text": "اگر پندگیری به نیکی گرای"
  },
  {
    "poem_id": 1732,
    "vorder": 17,
    "position": 0,
    "text": "ز بخشش هرانکس که جوید سپاس"
  },
  {
    "poem_id": 1732,
    "vorder": 18,
    "position": 1,
    "text": "نخواندش بخشنده یزدان‌شناس"
  },
  {
    "poem_id": 1732,
    "vorder": 19,
    "position": 0,
    "text": "ستاننده گر ناسپاست نیز"
  },
  {
    "poem_id": 1732,
    "vorder": 20,
    "position": 1,
    "text": "سزد گر ندارد کس او را به چیز"
  },
  {
    "poem_id": 1732,
    "vorder": 21,
    "position": 0,
    "text": "هراسان بود مردم سخت‌کار"
  },
  {
    "poem_id": 1732,
    "vorder": 22,
    "position": 1,
    "text": "که او را نباشد کسی دوستدار"
  },
  {
    "poem_id": 1732,
    "vorder": 23,
    "position": 0,
    "text": "وگر سستی آرد به کار اندرون"
  },
  {
    "poem_id": 1732,
    "vorder": 24,
    "position": 1,
    "text": "نخواند ورا رای‌زن رهنمون"
  },
  {
    "poem_id": 1732,
    "vorder": 25,
    "position": 0,
    "text": "گر از کاهلان یار خواهی به کار"
  },
  {
    "poem_id": 1732,
    "vorder": 26,
    "position": 1,
    "text": "نباشی جهانجوی و مردم‌شمار"
  },
  {
    "poem_id": 1732,
    "vorder": 27,
    "position": 0,
    "text": "نگر خویشتن را نداری بزرگ"
  },
  {
    "poem_id": 1732,
    "vorder": 28,
    "position": 1,
    "text": "وگر گاه یابی نگردی سترگ"
  },
  {
    "poem_id": 1732,
    "vorder": 29,
    "position": 0,
    "text": "چو بدخو شود مرد درویش خوار"
  },
  {
    "poem_id": 1732,
    "vorder": 30,
    "position": 1,
    "text": "همی بیند آن از بد روزگار"
  },
  {
    "poem_id": 1732,
    "vorder": 31,
    "position": 0,
    "text": "همه‌ساله بیکار و نالان ز بخت"
  },
  {
    "poem_id": 1732,
    "vorder": 32,
    "position": 1,
    "text": "نه رای و نه دانش نه زیبای تخت"
  },
  {
    "poem_id": 1732,
    "vorder": 33,
    "position": 0,
    "text": "وگر بازگیرند ازو خواسته"
  },
  {
    "poem_id": 1732,
    "vorder": 34,
    "position": 1,
    "text": "شود جان و مغز و دلش کاسته"
  },
  {
    "poem_id": 1732,
    "vorder": 35,
    "position": 0,
    "text": "به بی چیزی و بدخویی یازد اوی"
  },
  {
    "poem_id": 1732,
    "vorder": 36,
    "position": 1,
    "text": "ندارد خرد گردن افرازد اوی"
  },
  {
    "poem_id": 1732,
    "vorder": 37,
    "position": 0,
    "text": "نه چیز و نه دانش نه رای و هنر"
  },
  {
    "poem_id": 1732,
    "vorder": 38,
    "position": 1,
    "text": "نه دین و نه خشنودی دادگر"
  },
  {
    "poem_id": 1732,
    "vorder": 39,
    "position": 0,
    "text": "شما را شب و روز فرخنده باد"
  },
  {
    "poem_id": 1732,
    "vorder": 40,
    "position": 1,
    "text": "بداندیش را جان پراگنده باد"
  },
  {
    "poem_id": 1732,
    "vorder": 41,
    "position": 0,
    "text": "برو مهتران آفرین ساختند"
  },
  {
    "poem_id": 1732,
    "vorder": 42,
    "position": 1,
    "text": "خود از سوک شاهان بپرداختند"
  },
  {
    "poem_id": 1732,
    "vorder": 43,
    "position": 0,
    "text": "چو نه سال بگذشت بر سر سپهر"
  },
  {
    "poem_id": 1732,
    "vorder": 44,
    "position": 1,
    "text": "گل زرد شد آن چو گلنار چهر"
  },
  {
    "poem_id": 1732,
    "vorder": 45,
    "position": 0,
    "text": "غمی شد ز مرگ آن سر تاجور"
  },
  {
    "poem_id": 1732,
    "vorder": 46,
    "position": 1,
    "text": "بمرد و به شاهی نبودش پسر"
  },
  {
    "poem_id": 1732,
    "vorder": 47,
    "position": 0,
    "text": "چنان نامور مرد شیرین‌سخن"
  },
  {
    "poem_id": 1732,
    "vorder": 48,
    "position": 1,
    "text": "به نوی بشد زین سرای کهن"
  },
  {
    "poem_id": 1732,
    "vorder": 49,
    "position": 0,
    "text": "چنین بود تا بود چرخ روان"
  },
  {
    "poem_id": 1732,
    "vorder": 50,
    "position": 1,
    "text": "توانا به هر کار و ما ناتوان"
  },
  {
    "poem_id": 1732,
    "vorder": 51,
    "position": 0,
    "text": "چهل روز سوکش همی داشتند"
  },
  {
    "poem_id": 1732,
    "vorder": 52,
    "position": 1,
    "text": "سر گاه او خوار بگذاشتند"
  },
  {
    "poem_id": 1732,
    "vorder": 53,
    "position": 0,
    "text": "به چندین زمان تخت بیکار بود"
  },
  {
    "poem_id": 1732,
    "vorder": 54,
    "position": 1,
    "text": "سر مهتران پر ز تیمار بود"
  },
  {
    "poem_id": 1732,
    "vorder": 55,
    "position": 0,
    "text": "نگه کرد موبد شبستان شاه"
  },
  {
    "poem_id": 1732,
    "vorder": 56,
    "position": 1,
    "text": "یکی لاله رخ دید تابان چو ماه"
  },
  {
    "poem_id": 1732,
    "vorder": 57,
    "position": 0,
    "text": "سر مژه چون خنجر کابلی"
  },
  {
    "poem_id": 1732,
    "vorder": 58,
    "position": 1,
    "text": "دو زلفش چو پیچان خط مغولی (؟)"
  },
  {
    "poem_id": 1732,
    "vorder": 59,
    "position": 0,
    "text": "مسلسل یک اندر دگر بافته"
  },
  {
    "poem_id": 1732,
    "vorder": 60,
    "position": 1,
    "text": "گره بر زده سرش برتافته"
  },
  {
    "poem_id": 1732,
    "vorder": 61,
    "position": 0,
    "text": "پری چهره را بچه اندر نهان"
  },
  {
    "poem_id": 1732,
    "vorder": 62,
    "position": 1,
    "text": "ازان خوب‌رخ شادمان شد جهان"
  },
  {
    "poem_id": 1732,
    "vorder": 63,
    "position": 0,
    "text": "چهل روزه شد رود و می خواستند"
  },
  {
    "poem_id": 1732,
    "vorder": 64,
    "position": 1,
    "text": "یکی تخت شاهی بیاراستند"
  },
  {
    "poem_id": 1732,
    "vorder": 65,
    "position": 0,
    "text": "به سر برش تاجی برآویختند"
  },
  {
    "poem_id": 1732,
    "vorder": 66,
    "position": 1,
    "text": "بران تاج زر و درم ریختند"
  },
  {
    "poem_id": 1732,
    "vorder": 67,
    "position": 0,
    "text": "چهل روز بگذشت بر خوب‌چهر"
  },
  {
    "poem_id": 1732,
    "vorder": 68,
    "position": 1,
    "text": "یکی کودک آمد چو تابنده مهر"
  },
  {
    "poem_id": 1732,
    "vorder": 69,
    "position": 0,
    "text": "ورا موبدش نام شاپور کرد"
  },
  {
    "poem_id": 1732,
    "vorder": 70,
    "position": 1,
    "text": "بران شادمانی یکی سور کرد"
  },
  {
    "poem_id": 1732,
    "vorder": 71,
    "position": 0,
    "text": "تو گفتی همی فره ایزدیست"
  },
  {
    "poem_id": 1732,
    "vorder": 72,
    "position": 1,
    "text": "برو سایهٔ رایت بخردیست"
  },
  {
    "poem_id": 1732,
    "vorder": 73,
    "position": 0,
    "text": "برفتند گردان زرین کمر"
  },
  {
    "poem_id": 1732,
    "vorder": 74,
    "position": 1,
    "text": "بیاویختند از برش تاج زر"
  },
  {
    "poem_id": 1732,
    "vorder": 75,
    "position": 0,
    "text": "چو آن خرد را سیر دادند شیر"
  },
  {
    "poem_id": 1732,
    "vorder": 76,
    "position": 1,
    "text": "نوشتند پس در میان حریر"
  },
  {
    "poem_id": 1732,
    "vorder": 77,
    "position": 0,
    "text": "چهل روزه را زیر آن تاج زر"
  },
  {
    "poem_id": 1732,
    "vorder": 78,
    "position": 1,
    "text": "نهادند بر تخت فرخ پدر"
  }
]