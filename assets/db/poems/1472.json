[
  {
    "poem_id": 1472,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید این گفتهای درشت"
  },
  {
    "poem_id": 1472,
    "vorder": 2,
    "position": 1,
    "text": "نهان کرد ازو روی و بنمود پشت"
  },
  {
    "poem_id": 1472,
    "vorder": 3,
    "position": 0,
    "text": "ز بالا زدش تند یک پشت دست"
  },
  {
    "poem_id": 1472,
    "vorder": 4,
    "position": 1,
    "text": "بیفگند و آمد به جای نشست"
  },
  {
    "poem_id": 1472,
    "vorder": 5,
    "position": 0,
    "text": "بپوشید خفتان و بر سر نهاد"
  },
  {
    "poem_id": 1472,
    "vorder": 6,
    "position": 1,
    "text": "یکی خود چینی به کردار باد"
  },
  {
    "poem_id": 1472,
    "vorder": 7,
    "position": 0,
    "text": "ز تندی به جوش آمدش خون برگ"
  },
  {
    "poem_id": 1472,
    "vorder": 8,
    "position": 1,
    "text": "نشست از بر بارهٔ تیزتگ"
  },
  {
    "poem_id": 1472,
    "vorder": 9,
    "position": 0,
    "text": "خروشید و بگرفت نیزه به دست"
  },
  {
    "poem_id": 1472,
    "vorder": 10,
    "position": 1,
    "text": "به آوردگه رفت چون پیل مست"
  },
  {
    "poem_id": 1472,
    "vorder": 11,
    "position": 0,
    "text": "کس از نامداران ایران سپاه"
  },
  {
    "poem_id": 1472,
    "vorder": 12,
    "position": 1,
    "text": "نیارست کردن بدو در نگاه"
  },
  {
    "poem_id": 1472,
    "vorder": 13,
    "position": 0,
    "text": "ز پای و رکیب و ز دست و عنان"
  },
  {
    "poem_id": 1472,
    "vorder": 14,
    "position": 1,
    "text": "ز بازوی وز آب داده سنان"
  },
  {
    "poem_id": 1472,
    "vorder": 15,
    "position": 0,
    "text": "ازان پس دلیران شدند انجمن"
  },
  {
    "poem_id": 1472,
    "vorder": 16,
    "position": 1,
    "text": "بگفتند کاینت گو پیلتن"
  },
  {
    "poem_id": 1472,
    "vorder": 17,
    "position": 0,
    "text": "نشاید نگه کردن اسان بدوی"
  },
  {
    "poem_id": 1472,
    "vorder": 18,
    "position": 1,
    "text": "که یارد شدن پیش او جنگجوی"
  },
  {
    "poem_id": 1472,
    "vorder": 19,
    "position": 0,
    "text": "ازان پس خروشید سهراب گرد"
  },
  {
    "poem_id": 1472,
    "vorder": 20,
    "position": 1,
    "text": "همی شاه کاووس را بر شمرد"
  },
  {
    "poem_id": 1472,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت با شاه آزاد مرد"
  },
  {
    "poem_id": 1472,
    "vorder": 22,
    "position": 1,
    "text": "که چون است کارت به دشت نبرد"
  },
  {
    "poem_id": 1472,
    "vorder": 23,
    "position": 0,
    "text": "چرا کرده‌ای نام کاووس کی"
  },
  {
    "poem_id": 1472,
    "vorder": 24,
    "position": 1,
    "text": "که در جنگ نه تاو داری نه پی"
  },
  {
    "poem_id": 1472,
    "vorder": 25,
    "position": 0,
    "text": "تنت را برین نیزه بریان کنم"
  },
  {
    "poem_id": 1472,
    "vorder": 26,
    "position": 1,
    "text": "ستاره بدین کار گریان کنم"
  },
  {
    "poem_id": 1472,
    "vorder": 27,
    "position": 0,
    "text": "یکی سخت سوگند خوردم به بزم"
  },
  {
    "poem_id": 1472,
    "vorder": 28,
    "position": 1,
    "text": "بدان شب کجا کشته شد ژنده‌رزم"
  },
  {
    "poem_id": 1472,
    "vorder": 29,
    "position": 0,
    "text": "کز ایران نمانم یکی نیزه‌دار"
  },
  {
    "poem_id": 1472,
    "vorder": 30,
    "position": 1,
    "text": "کنم زنده کاووس کی را به دار"
  },
  {
    "poem_id": 1472,
    "vorder": 31,
    "position": 0,
    "text": "که داری از ایرانیان تیز چنگ"
  },
  {
    "poem_id": 1472,
    "vorder": 32,
    "position": 1,
    "text": "که پیش من آید به هنگام جنگ"
  },
  {
    "poem_id": 1472,
    "vorder": 33,
    "position": 0,
    "text": "همی گفت و می بود جوشان بسی"
  },
  {
    "poem_id": 1472,
    "vorder": 34,
    "position": 1,
    "text": "از ایران ندادند پاسخ کسی"
  },
  {
    "poem_id": 1472,
    "vorder": 35,
    "position": 0,
    "text": "خروشان بیامد به پرده‌سرای"
  },
  {
    "poem_id": 1472,
    "vorder": 36,
    "position": 1,
    "text": "به نیزه درآورد بالا ز جای"
  },
  {
    "poem_id": 1472,
    "vorder": 37,
    "position": 0,
    "text": "خم آورد زان پس سنان کرد سیخ"
  },
  {
    "poem_id": 1472,
    "vorder": 38,
    "position": 1,
    "text": "بزد نیزه برکند هفتاد میخ"
  },
  {
    "poem_id": 1472,
    "vorder": 39,
    "position": 0,
    "text": "سراپرده یک بهره آمد ز پای"
  },
  {
    "poem_id": 1472,
    "vorder": 40,
    "position": 1,
    "text": "ز هر سو برآمد دم کرنای"
  },
  {
    "poem_id": 1472,
    "vorder": 41,
    "position": 0,
    "text": "رمید آن دلاور سپاه دلیر"
  },
  {
    "poem_id": 1472,
    "vorder": 42,
    "position": 1,
    "text": "به کردار گوران ز چنگال شیر"
  },
  {
    "poem_id": 1472,
    "vorder": 43,
    "position": 0,
    "text": "غمی گشت کاووس و آواز داد"
  },
  {
    "poem_id": 1472,
    "vorder": 44,
    "position": 1,
    "text": "کزین نامداران فرخ نژاد"
  },
  {
    "poem_id": 1472,
    "vorder": 45,
    "position": 0,
    "text": "یکی نزد رستم برید آگهی"
  },
  {
    "poem_id": 1472,
    "vorder": 46,
    "position": 1,
    "text": "کزین ترک شد مغز گردان تهی"
  },
  {
    "poem_id": 1472,
    "vorder": 47,
    "position": 0,
    "text": "ندارم سواری ورا هم نبرد"
  },
  {
    "poem_id": 1472,
    "vorder": 48,
    "position": 1,
    "text": "از ایران نیارد کس این کار کرد"
  },
  {
    "poem_id": 1472,
    "vorder": 49,
    "position": 0,
    "text": "بشد طوس و پیغام کاووس برد"
  },
  {
    "poem_id": 1472,
    "vorder": 50,
    "position": 1,
    "text": "شنیده سخن پیش او برشمرد"
  },
  {
    "poem_id": 1472,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت رستم که هر شهریار"
  },
  {
    "poem_id": 1472,
    "vorder": 52,
    "position": 1,
    "text": "که کردی مرا ناگهان خواستار"
  },
  {
    "poem_id": 1472,
    "vorder": 53,
    "position": 0,
    "text": "گهی گنج بودی گهی ساز بزم"
  },
  {
    "poem_id": 1472,
    "vorder": 54,
    "position": 1,
    "text": "ندیدم ز کاووس جز رنج رزم"
  },
  {
    "poem_id": 1472,
    "vorder": 55,
    "position": 0,
    "text": "بفرمود تا رخش را زین کنند"
  },
  {
    "poem_id": 1472,
    "vorder": 56,
    "position": 1,
    "text": "سواران بروها پر از چین کنند"
  },
  {
    "poem_id": 1472,
    "vorder": 57,
    "position": 0,
    "text": "ز خیمه نگه کرد رستم بدشت"
  },
  {
    "poem_id": 1472,
    "vorder": 58,
    "position": 1,
    "text": "ز ره گیو را دید کاندر گذشت"
  },
  {
    "poem_id": 1472,
    "vorder": 59,
    "position": 0,
    "text": "نهاد از بر رخش رخشنده زین"
  },
  {
    "poem_id": 1472,
    "vorder": 60,
    "position": 1,
    "text": "همی گفت گرگین که بشتاب هین"
  },
  {
    "poem_id": 1472,
    "vorder": 61,
    "position": 0,
    "text": "همی بست بر باره رهام تنگ"
  },
  {
    "poem_id": 1472,
    "vorder": 62,
    "position": 1,
    "text": "به برگستوان بر زده طوس چنگ"
  },
  {
    "poem_id": 1472,
    "vorder": 63,
    "position": 0,
    "text": "همی این بدان آن بدین گفت زود"
  },
  {
    "poem_id": 1472,
    "vorder": 64,
    "position": 1,
    "text": "تهمتن چو از خیمه آوا شنود"
  },
  {
    "poem_id": 1472,
    "vorder": 65,
    "position": 0,
    "text": "به دل گفت کین کار آهرمنست"
  },
  {
    "poem_id": 1472,
    "vorder": 66,
    "position": 1,
    "text": "نه این رستخیز از پی یک تنست"
  },
  {
    "poem_id": 1472,
    "vorder": 67,
    "position": 0,
    "text": "بزد دست و پوشید ببر بیان"
  },
  {
    "poem_id": 1472,
    "vorder": 68,
    "position": 1,
    "text": "ببست آن کیانی کمر بر میان"
  },
  {
    "poem_id": 1472,
    "vorder": 69,
    "position": 0,
    "text": "نشست از بر رخش و بگرفت راه"
  },
  {
    "poem_id": 1472,
    "vorder": 70,
    "position": 1,
    "text": "زواره نگهبان گاه و سپاه"
  },
  {
    "poem_id": 1472,
    "vorder": 71,
    "position": 0,
    "text": "درفشش ببردند با او بهم"
  },
  {
    "poem_id": 1472,
    "vorder": 72,
    "position": 1,
    "text": "همی رفت پرخاشجوی و دژم"
  },
  {
    "poem_id": 1472,
    "vorder": 73,
    "position": 0,
    "text": "چو سهراب را دید با یال و شاخ"
  },
  {
    "poem_id": 1472,
    "vorder": 74,
    "position": 1,
    "text": "برش چون بر سام جنگی فراخ"
  },
  {
    "poem_id": 1472,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت از ایدر به یکسو شویم"
  },
  {
    "poem_id": 1472,
    "vorder": 76,
    "position": 1,
    "text": "به آوردگه هر دو همرو شویم"
  },
  {
    "poem_id": 1472,
    "vorder": 77,
    "position": 0,
    "text": "بمالید سهراب کف را به کف"
  },
  {
    "poem_id": 1472,
    "vorder": 78,
    "position": 1,
    "text": "به آوردگه رفت از پیش صف"
  },
  {
    "poem_id": 1472,
    "vorder": 79,
    "position": 0,
    "text": "به رستم چنین گفت کاندر گذشت"
  },
  {
    "poem_id": 1472,
    "vorder": 80,
    "position": 1,
    "text": "ز من جنگ و پیکار سوی تو گشت"
  },
  {
    "poem_id": 1472,
    "vorder": 81,
    "position": 0,
    "text": "از ایران نخواهی دگر یار کس"
  },
  {
    "poem_id": 1472,
    "vorder": 82,
    "position": 1,
    "text": "چو من با تو باشم بآورد بس"
  },
  {
    "poem_id": 1472,
    "vorder": 83,
    "position": 0,
    "text": "به آوردگه بر ترا جای نیست"
  },
  {
    "poem_id": 1472,
    "vorder": 84,
    "position": 1,
    "text": "ترا خود به یک مشت من پای نیست"
  },
  {
    "poem_id": 1472,
    "vorder": 85,
    "position": 0,
    "text": "به بالا بلندی و با کتف و یال"
  },
  {
    "poem_id": 1472,
    "vorder": 86,
    "position": 1,
    "text": "ستم یافت بالت ز بسیار سال"
  },
  {
    "poem_id": 1472,
    "vorder": 87,
    "position": 0,
    "text": "نگه کرد رستم بدان سرافراز"
  },
  {
    "poem_id": 1472,
    "vorder": 88,
    "position": 1,
    "text": "بدان چنگ و یال و رکیب دراز"
  },
  {
    "poem_id": 1472,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت نرم ای جوان‌مرد گرم"
  },
  {
    "poem_id": 1472,
    "vorder": 90,
    "position": 1,
    "text": "زمین سرد و خشک و سخن گرم و نرم"
  },
  {
    "poem_id": 1472,
    "vorder": 91,
    "position": 0,
    "text": "به پیری بسی دیدم آوردگاه"
  },
  {
    "poem_id": 1472,
    "vorder": 92,
    "position": 1,
    "text": "بسی بر زمین پست کردم سپاه"
  },
  {
    "poem_id": 1472,
    "vorder": 93,
    "position": 0,
    "text": "تپه شد بسی دیو در جنگ من"
  },
  {
    "poem_id": 1472,
    "vorder": 94,
    "position": 1,
    "text": "ندیدم بدان سو که بودم شکن"
  },
  {
    "poem_id": 1472,
    "vorder": 95,
    "position": 0,
    "text": "نگه کن مرا گر ببینی به جنگ"
  },
  {
    "poem_id": 1472,
    "vorder": 96,
    "position": 1,
    "text": "اگر زنده مانی مترس از نهنگ"
  },
  {
    "poem_id": 1472,
    "vorder": 97,
    "position": 0,
    "text": "مرا دید در جنگ دریا و کوه"
  },
  {
    "poem_id": 1472,
    "vorder": 98,
    "position": 1,
    "text": "که با نامداران توران گروه"
  },
  {
    "poem_id": 1472,
    "vorder": 99,
    "position": 0,
    "text": "چه کردم ستاره گوای منست"
  },
  {
    "poem_id": 1472,
    "vorder": 100,
    "position": 1,
    "text": "به مردی جهان زیر پای منست"
  },
  {
    "poem_id": 1472,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت کز تو بپرسم سخن"
  },
  {
    "poem_id": 1472,
    "vorder": 102,
    "position": 1,
    "text": "همه راستی باید افگند بن"
  },
  {
    "poem_id": 1472,
    "vorder": 103,
    "position": 0,
    "text": "من ایدون گمانم که تو رستمی"
  },
  {
    "poem_id": 1472,
    "vorder": 104,
    "position": 1,
    "text": "گر از تخمهٔ نامور نیرمی"
  },
  {
    "poem_id": 1472,
    "vorder": 105,
    "position": 0,
    "text": "چنین داد پاسخ که رستم نیم"
  },
  {
    "poem_id": 1472,
    "vorder": 106,
    "position": 1,
    "text": "هم از تخمهٔ سام نیرم نیم"
  },
  {
    "poem_id": 1472,
    "vorder": 107,
    "position": 0,
    "text": "که او پهلوانست و من کهترم"
  },
  {
    "poem_id": 1472,
    "vorder": 108,
    "position": 1,
    "text": "نه با تخت و گاهم نه با افسرم"
  },
  {
    "poem_id": 1472,
    "vorder": 109,
    "position": 0,
    "text": "از امید سهراب شد ناامید"
  },
  {
    "poem_id": 1472,
    "vorder": 110,
    "position": 1,
    "text": "برو تیره شد روی روز سپید"
  }
]