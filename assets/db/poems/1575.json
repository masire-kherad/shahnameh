[
  {
    "poem_id": 1575,
    "vorder": 1,
    "position": 0,
    "text": "کنون خورد باید می خوش‌گُوار"
  },
  {
    "poem_id": 1575,
    "vorder": 2,
    "position": 1,
    "text": "که می‌ بویِ مشک آید از جویبار"
  },
  {
    "poem_id": 1575,
    "vorder": 3,
    "position": 0,
    "text": "هوا پر خروش و زمین پر ز جوش"
  },
  {
    "poem_id": 1575,
    "vorder": 4,
    "position": 1,
    "text": "خنُک آنک دل، شاد دارد به نوش"
  },
  {
    "poem_id": 1575,
    "vorder": 5,
    "position": 0,
    "text": "دِرَم دارد و نُقل و جامِ نبید"
  },
  {
    "poem_id": 1575,
    "vorder": 6,
    "position": 1,
    "text": "سر گوسفندی تواند برید"
  },
  {
    "poem_id": 1575,
    "vorder": 7,
    "position": 0,
    "text": "مرا نیست، فرخ مر آن را که هست"
  },
  {
    "poem_id": 1575,
    "vorder": 8,
    "position": 1,
    "text": "ببخشایْ بر مردم تنگدست"
  },
  {
    "poem_id": 1575,
    "vorder": 9,
    "position": 0,
    "text": "همه بوستان زیر برگ گلست"
  },
  {
    "poem_id": 1575,
    "vorder": 10,
    "position": 1,
    "text": "همه کوه پرلاله و سنبلست"
  },
  {
    "poem_id": 1575,
    "vorder": 11,
    "position": 0,
    "text": "به پالیز بلبل بنالد همی"
  },
  {
    "poem_id": 1575,
    "vorder": 12,
    "position": 1,
    "text": "گل از نالهٔ او ببالد همی"
  },
  {
    "poem_id": 1575,
    "vorder": 13,
    "position": 0,
    "text": "چو از ابر بینم همی باد و نم"
  },
  {
    "poem_id": 1575,
    "vorder": 14,
    "position": 1,
    "text": "ندانم که نرگس چرا شد دُژَم؟"
  },
  {
    "poem_id": 1575,
    "vorder": 15,
    "position": 0,
    "text": "شب تیره بلبل نخسپد همی"
  },
  {
    "poem_id": 1575,
    "vorder": 16,
    "position": 1,
    "text": "گل از باد و باران بجنبد همی"
  },
  {
    "poem_id": 1575,
    "vorder": 17,
    "position": 0,
    "text": "بخندد همی بلبل از هر دوان"
  },
  {
    "poem_id": 1575,
    "vorder": 18,
    "position": 1,
    "text": "چو بر گل نشیند گشاید زبان"
  },
  {
    "poem_id": 1575,
    "vorder": 19,
    "position": 0,
    "text": "ندانم که عاشق گل آمد گر ابر"
  },
  {
    "poem_id": 1575,
    "vorder": 20,
    "position": 1,
    "text": "چو از ابر بینم خروش هژبر"
  },
  {
    "poem_id": 1575,
    "vorder": 21,
    "position": 0,
    "text": "بَدَرَّد همی باد، پیراهنش"
  },
  {
    "poem_id": 1575,
    "vorder": 22,
    "position": 1,
    "text": "دُرفشان شود آتش اندر تنش"
  },
  {
    "poem_id": 1575,
    "vorder": 23,
    "position": 0,
    "text": "به عشق هوا بر زمین شد گوا"
  },
  {
    "poem_id": 1575,
    "vorder": 24,
    "position": 1,
    "text": "به نزدیک خورشید فرمانروا"
  },
  {
    "poem_id": 1575,
    "vorder": 25,
    "position": 0,
    "text": "که داند که بلبل چه گوید همی؟"
  },
  {
    "poem_id": 1575,
    "vorder": 26,
    "position": 1,
    "text": "به زیر گل‌اندر، چه موید همی؟"
  },
  {
    "poem_id": 1575,
    "vorder": 27,
    "position": 0,
    "text": "نگه کن سحرگاه تا بشنوی"
  },
  {
    "poem_id": 1575,
    "vorder": 28,
    "position": 1,
    "text": "ز بلبل سخن گفتنی پهلوی"
  },
  {
    "poem_id": 1575,
    "vorder": 29,
    "position": 0,
    "text": "همی نالد از مرگِ اسفندیار"
  },
  {
    "poem_id": 1575,
    "vorder": 30,
    "position": 1,
    "text": "ندارد به جز ناله زو یادگار"
  },
  {
    "poem_id": 1575,
    "vorder": 31,
    "position": 0,
    "text": "چو آوازِ رستم، شبِ تیره، ابر"
  },
  {
    "poem_id": 1575,
    "vorder": 32,
    "position": 1,
    "text": "بِدَرَّد دل و گوشِ غران‌هژبر"
  }
]