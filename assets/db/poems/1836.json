[
  {
    "poem_id": 1836,
    "vorder": 1,
    "position": 0,
    "text": "چوگستهم وبندوی به آذرگشسپ"
  },
  {
    "poem_id": 1836,
    "vorder": 2,
    "position": 1,
    "text": "فگندند مردی سبک بر دو اسپ"
  },
  {
    "poem_id": 1836,
    "vorder": 3,
    "position": 0,
    "text": "که در شب به نزدیک خسرو شود"
  },
  {
    "poem_id": 1836,
    "vorder": 4,
    "position": 1,
    "text": "از ایران به آگاهی نو شود"
  },
  {
    "poem_id": 1836,
    "vorder": 5,
    "position": 0,
    "text": "فرستاده آمد بر شاه نو"
  },
  {
    "poem_id": 1836,
    "vorder": 6,
    "position": 1,
    "text": "گذشته شبی تیره از ماه نو"
  },
  {
    "poem_id": 1836,
    "vorder": 7,
    "position": 0,
    "text": "ز آشوب بغداد گفت آنچ دید"
  },
  {
    "poem_id": 1836,
    "vorder": 8,
    "position": 1,
    "text": "جوان شد چو برگ گل شنبلید"
  },
  {
    "poem_id": 1836,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت هرکو زراه خرد"
  },
  {
    "poem_id": 1836,
    "vorder": 10,
    "position": 1,
    "text": "بتیزی ز بی‌دانشی بگذرد"
  },
  {
    "poem_id": 1836,
    "vorder": 11,
    "position": 0,
    "text": "نترسد ز کردار چرخ بلند"
  },
  {
    "poem_id": 1836,
    "vorder": 12,
    "position": 1,
    "text": "شود زندگانیش ناسودمند"
  },
  {
    "poem_id": 1836,
    "vorder": 13,
    "position": 0,
    "text": "گراین بد که گفتی خوش آمد مرا"
  },
  {
    "poem_id": 1836,
    "vorder": 14,
    "position": 1,
    "text": "خور و خواب در آتش آمد مرا"
  },
  {
    "poem_id": 1836,
    "vorder": 15,
    "position": 0,
    "text": "ولیکن پدر چون به خون آخت دست"
  },
  {
    "poem_id": 1836,
    "vorder": 16,
    "position": 1,
    "text": "از ایران نکردم سران نشست"
  },
  {
    "poem_id": 1836,
    "vorder": 17,
    "position": 0,
    "text": "هم او را کنون چون یکی بنده‌ام"
  },
  {
    "poem_id": 1836,
    "vorder": 18,
    "position": 1,
    "text": "سخن هرچ گوید نیوشنده‌ام"
  },
  {
    "poem_id": 1836,
    "vorder": 19,
    "position": 0,
    "text": "هم اندر زمان داغ دل با سپاه"
  },
  {
    "poem_id": 1836,
    "vorder": 20,
    "position": 1,
    "text": "بکردار آتش بیامد ز راه"
  },
  {
    "poem_id": 1836,
    "vorder": 21,
    "position": 0,
    "text": "سپاهی بد از بردع و اردبیل"
  },
  {
    "poem_id": 1836,
    "vorder": 22,
    "position": 1,
    "text": "همی‌رفت با نامور خیل خیل"
  },
  {
    "poem_id": 1836,
    "vorder": 23,
    "position": 0,
    "text": "از ارمینیه نیز چندی سپاه"
  },
  {
    "poem_id": 1836,
    "vorder": 24,
    "position": 1,
    "text": "همی‌تاخت چون باد با پور شاه"
  },
  {
    "poem_id": 1836,
    "vorder": 25,
    "position": 0,
    "text": "چوآمد ببغداد زو آگهی"
  },
  {
    "poem_id": 1836,
    "vorder": 26,
    "position": 1,
    "text": "که آمد خریدار تخت مهی"
  },
  {
    "poem_id": 1836,
    "vorder": 27,
    "position": 0,
    "text": "همه شهر ز آگاهی آرام یافت"
  },
  {
    "poem_id": 1836,
    "vorder": 28,
    "position": 1,
    "text": "جهانجوی از آرامشان کام یافت"
  },
  {
    "poem_id": 1836,
    "vorder": 29,
    "position": 0,
    "text": "پذیره شدندش بزرگان شهر"
  },
  {
    "poem_id": 1836,
    "vorder": 30,
    "position": 1,
    "text": "کسی را که از مهتری بود بهر"
  },
  {
    "poem_id": 1836,
    "vorder": 31,
    "position": 0,
    "text": "نهادند بر پیشگه تخت عاج"
  },
  {
    "poem_id": 1836,
    "vorder": 32,
    "position": 1,
    "text": "همان طوق زرین وپرمایه تاج"
  },
  {
    "poem_id": 1836,
    "vorder": 33,
    "position": 0,
    "text": "بشهر اندرون رفت خسرو بدرد"
  },
  {
    "poem_id": 1836,
    "vorder": 34,
    "position": 1,
    "text": "بنزد پدر رفت با بادسرد"
  },
  {
    "poem_id": 1836,
    "vorder": 35,
    "position": 0,
    "text": "چه جوییم زین گنبد تیزگرد"
  },
  {
    "poem_id": 1836,
    "vorder": 36,
    "position": 1,
    "text": "که هرگز نیاساید از کارکرد"
  },
  {
    "poem_id": 1836,
    "vorder": 37,
    "position": 0,
    "text": "یکی راهمی تاج شاهی دهد"
  },
  {
    "poem_id": 1836,
    "vorder": 38,
    "position": 1,
    "text": "یکی را بدریا بماهی دهد"
  },
  {
    "poem_id": 1836,
    "vorder": 39,
    "position": 0,
    "text": "یکی را برهنه سروپای و سفت"
  },
  {
    "poem_id": 1836,
    "vorder": 40,
    "position": 1,
    "text": "نه آرام و خواب و نه جای نهفت"
  },
  {
    "poem_id": 1836,
    "vorder": 41,
    "position": 0,
    "text": "یکی را دهد توشهٔ شهد و شیر"
  },
  {
    "poem_id": 1836,
    "vorder": 42,
    "position": 1,
    "text": "بپوشد بدیبا و خز و حریر"
  },
  {
    "poem_id": 1836,
    "vorder": 43,
    "position": 0,
    "text": "سرانجام هردو بخاک اندرند"
  },
  {
    "poem_id": 1836,
    "vorder": 44,
    "position": 1,
    "text": "بتارک بدام هلاک اندرند"
  },
  {
    "poem_id": 1836,
    "vorder": 45,
    "position": 0,
    "text": "اگر خود نزادی خردمند مرد"
  },
  {
    "poem_id": 1836,
    "vorder": 46,
    "position": 1,
    "text": "ندیدی ز گیتی چنین گرم و سرد"
  },
  {
    "poem_id": 1836,
    "vorder": 47,
    "position": 0,
    "text": "ندیدی جهان ازبنه به بدی"
  },
  {
    "poem_id": 1836,
    "vorder": 48,
    "position": 1,
    "text": "اگر که بدی مرد اگر مه بدی"
  },
  {
    "poem_id": 1836,
    "vorder": 49,
    "position": 0,
    "text": "کنون رنج در کارخسرو بریم"
  },
  {
    "poem_id": 1836,
    "vorder": 50,
    "position": 1,
    "text": "بخواننده آگاهی نو بریم"
  }
]