[
  {
    "poem_id": 87988,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس چو آمد به‌خسرو خبر"
  },
  {
    "poem_id": 87988,
    "vorder": 2,
    "position": 1,
    "text": "که پیران شد از رزم پیروزگر"
  },
  {
    "poem_id": 87988,
    "vorder": 3,
    "position": 0,
    "text": "سپهبد به‌کوه هماون کشید"
  },
  {
    "poem_id": 87988,
    "vorder": 4,
    "position": 1,
    "text": "ز لشکر بسی گرد شد ناپدید"
  },
  {
    "poem_id": 87988,
    "vorder": 5,
    "position": 0,
    "text": "در کاخ گودرز کشوادگان"
  },
  {
    "poem_id": 87988,
    "vorder": 6,
    "position": 1,
    "text": "تهی شد ز گردان و آزادگان"
  },
  {
    "poem_id": 87988,
    "vorder": 7,
    "position": 0,
    "text": "ستاره بر ایشان بنالد همی"
  },
  {
    "poem_id": 87988,
    "vorder": 8,
    "position": 1,
    "text": "به‌بالینشان خون بپالد همی"
  },
  {
    "poem_id": 87988,
    "vorder": 9,
    "position": 0,
    "text": "ازیشان جهان پر ز خاک است و خون"
  },
  {
    "poem_id": 87988,
    "vorder": 10,
    "position": 1,
    "text": "بلند اختر طوس گشته نگون"
  },
  {
    "poem_id": 87988,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود تا رستم پیلتن"
  },
  {
    "poem_id": 87988,
    "vorder": 12,
    "position": 1,
    "text": "خرامد به‌درگاه با انجمن"
  },
  {
    "poem_id": 87988,
    "vorder": 13,
    "position": 0,
    "text": "برفتند ز ایران همه بخردان"
  },
  {
    "poem_id": 87988,
    "vorder": 14,
    "position": 1,
    "text": "جهاندیده و نامور موبدان"
  },
  {
    "poem_id": 87988,
    "vorder": 15,
    "position": 0,
    "text": "سر نامداران زبان برگشاد"
  },
  {
    "poem_id": 87988,
    "vorder": 16,
    "position": 1,
    "text": "ز پیکار لشکر بسی کرد یاد"
  },
  {
    "poem_id": 87988,
    "vorder": 17,
    "position": 0,
    "text": "به رستم چنین گفت کای سرفراز"
  },
  {
    "poem_id": 87988,
    "vorder": 18,
    "position": 1,
    "text": "بترسم که این دولت دیریاز"
  },
  {
    "poem_id": 87988,
    "vorder": 19,
    "position": 0,
    "text": "همی برگراید به‌سوی نشیب"
  },
  {
    "poem_id": 87988,
    "vorder": 20,
    "position": 1,
    "text": "دلم شد ز کردار او پرنهیب"
  },
  {
    "poem_id": 87988,
    "vorder": 21,
    "position": 0,
    "text": "توی پروارنندهٔ تاج و تخت"
  },
  {
    "poem_id": 87988,
    "vorder": 22,
    "position": 1,
    "text": "فروغ از تو گیرد جهاندار بخت"
  },
  {
    "poem_id": 87988,
    "vorder": 23,
    "position": 0,
    "text": "دل چرخ در نوک شمشیر تست"
  },
  {
    "poem_id": 87988,
    "vorder": 24,
    "position": 1,
    "text": "سپهر و زمان و زمین زیر تست"
  },
  {
    "poem_id": 87988,
    "vorder": 25,
    "position": 0,
    "text": "تو کندی دل و مغز دیو سپید"
  },
  {
    "poem_id": 87988,
    "vorder": 26,
    "position": 1,
    "text": "زمانه به مهر تو دارد امید"
  },
  {
    "poem_id": 87988,
    "vorder": 27,
    "position": 0,
    "text": "زمین گرد رخش ترا چاکر‌ست"
  },
  {
    "poem_id": 87988,
    "vorder": 28,
    "position": 1,
    "text": "زمان بر تو چون مهربان مادر‌ست"
  },
  {
    "poem_id": 87988,
    "vorder": 29,
    "position": 0,
    "text": "ز تیغ تو خورشید بریان شود"
  },
  {
    "poem_id": 87988,
    "vorder": 30,
    "position": 1,
    "text": "ز گرز تو ناهید گریان شود"
  },
  {
    "poem_id": 87988,
    "vorder": 31,
    "position": 0,
    "text": "ز نیروی پیکان کلک تو شیر"
  },
  {
    "poem_id": 87988,
    "vorder": 32,
    "position": 1,
    "text": "به‌روز بلا گردد از جنگ سیر"
  },
  {
    "poem_id": 87988,
    "vorder": 33,
    "position": 0,
    "text": "تو تا برنهادی به‌مردی کلاه"
  },
  {
    "poem_id": 87988,
    "vorder": 34,
    "position": 1,
    "text": "نکرد ایچ دشمن به ایران نگاه"
  },
  {
    "poem_id": 87988,
    "vorder": 35,
    "position": 0,
    "text": "کنون گیو و گودرز و طوس و سران"
  },
  {
    "poem_id": 87988,
    "vorder": 36,
    "position": 1,
    "text": "فراوان ازین مرز کنداوران"
  },
  {
    "poem_id": 87988,
    "vorder": 37,
    "position": 0,
    "text": "همه دل پر از خون و دیده پرآب"
  },
  {
    "poem_id": 87988,
    "vorder": 38,
    "position": 1,
    "text": "گریزان ز ترکان افراسیاب"
  },
  {
    "poem_id": 87988,
    "vorder": 39,
    "position": 0,
    "text": "فراوان ز گودرزیان کشته مرد"
  },
  {
    "poem_id": 87988,
    "vorder": 40,
    "position": 1,
    "text": "شده خاک بستر به دشت نبرد"
  },
  {
    "poem_id": 87988,
    "vorder": 41,
    "position": 0,
    "text": "هرانکس کزیشان به جان رسته‌اند"
  },
  {
    "poem_id": 87988,
    "vorder": 42,
    "position": 1,
    "text": "به کوه هماون همه خسته‌اند"
  },
  {
    "poem_id": 87988,
    "vorder": 43,
    "position": 0,
    "text": "همه سر نهاده سوی آسمان"
  },
  {
    "poem_id": 87988,
    "vorder": 44,
    "position": 1,
    "text": "سوی کردگار مکان و زمان"
  },
  {
    "poem_id": 87988,
    "vorder": 45,
    "position": 0,
    "text": "که ایدر بیاید گو پیلتن"
  },
  {
    "poem_id": 87988,
    "vorder": 46,
    "position": 1,
    "text": "به نیروی یزدان و فرمان من"
  },
  {
    "poem_id": 87988,
    "vorder": 47,
    "position": 0,
    "text": "شب تیره کاین نامه بر خواندم"
  },
  {
    "poem_id": 87988,
    "vorder": 48,
    "position": 1,
    "text": "بسی از جگر خون برافشاندم"
  },
  {
    "poem_id": 87988,
    "vorder": 49,
    "position": 0,
    "text": "نگفتم سه روز این سخن را به کس"
  },
  {
    "poem_id": 87988,
    "vorder": 50,
    "position": 1,
    "text": "مگر پیش دادار فریاد‌رس"
  },
  {
    "poem_id": 87988,
    "vorder": 51,
    "position": 0,
    "text": "کنون کار ز اندازه اندر گذشت"
  },
  {
    "poem_id": 87988,
    "vorder": 52,
    "position": 1,
    "text": "دلم زین سخن پر ز تیمار گشت"
  },
  {
    "poem_id": 87988,
    "vorder": 53,
    "position": 0,
    "text": "امید سپاه و سپهبد به تست"
  },
  {
    "poem_id": 87988,
    "vorder": 54,
    "position": 1,
    "text": "که روشن‌روان بادی و تن درست"
  },
  {
    "poem_id": 87988,
    "vorder": 55,
    "position": 0,
    "text": "سرت سبز باد و دلت شادمان"
  },
  {
    "poem_id": 87988,
    "vorder": 56,
    "position": 1,
    "text": "تن زال دور از بد‌ِ بدگمان"
  },
  {
    "poem_id": 87988,
    "vorder": 57,
    "position": 0,
    "text": "ز من هرچ باید فزونی بخواه"
  },
  {
    "poem_id": 87988,
    "vorder": 58,
    "position": 1,
    "text": "ز اسپ و سلیح و ز گنج و سپاه"
  },
  {
    "poem_id": 87988,
    "vorder": 59,
    "position": 0,
    "text": "برو با دلی شاد و رایی درست"
  },
  {
    "poem_id": 87988,
    "vorder": 60,
    "position": 1,
    "text": "نشاید گرفت این چنین کار سست"
  },
  {
    "poem_id": 87988,
    "vorder": 61,
    "position": 0,
    "text": "به پاسخ چنین گفت رستم به شاه"
  },
  {
    "poem_id": 87988,
    "vorder": 62,
    "position": 1,
    "text": "که بی تو مبادا نگین و کلاه"
  },
  {
    "poem_id": 87988,
    "vorder": 63,
    "position": 0,
    "text": "که با فر و برزی و با‌رای و داد"
  },
  {
    "poem_id": 87988,
    "vorder": 64,
    "position": 1,
    "text": "ندارد چو تو شاه گردون به‌یاد"
  },
  {
    "poem_id": 87988,
    "vorder": 65,
    "position": 0,
    "text": "شنیده‌ست خسرو که تا کیقباد"
  },
  {
    "poem_id": 87988,
    "vorder": 66,
    "position": 1,
    "text": "کلاه بزرگی بسر بر نهاد"
  },
  {
    "poem_id": 87988,
    "vorder": 67,
    "position": 0,
    "text": "به‌ایران به‌کین من کمر بسته‌ام"
  },
  {
    "poem_id": 87988,
    "vorder": 68,
    "position": 1,
    "text": "به آرام یک روز ننشسته‌ام"
  },
  {
    "poem_id": 87988,
    "vorder": 69,
    "position": 0,
    "text": "بیابان و تاریکی و دیو و شیر"
  },
  {
    "poem_id": 87988,
    "vorder": 70,
    "position": 1,
    "text": "چه جادو چه از اژدهای دلیر"
  },
  {
    "poem_id": 87988,
    "vorder": 71,
    "position": 0,
    "text": "همان رزم توران و مازندران"
  },
  {
    "poem_id": 87988,
    "vorder": 72,
    "position": 1,
    "text": "شب تیره و گرزهای گران"
  },
  {
    "poem_id": 87988,
    "vorder": 73,
    "position": 0,
    "text": "هم از تشنگی هم ز راه دراز"
  },
  {
    "poem_id": 87988,
    "vorder": 74,
    "position": 1,
    "text": "گزیدن در رنج بر جای ناز"
  },
  {
    "poem_id": 87988,
    "vorder": 75,
    "position": 0,
    "text": "چنین درد و سختی بسی دیده‌ام"
  },
  {
    "poem_id": 87988,
    "vorder": 76,
    "position": 1,
    "text": "که روزی ز شادی نپرسیده‌ام"
  },
  {
    "poem_id": 87988,
    "vorder": 77,
    "position": 0,
    "text": "تو شاه نو آیین و من چون رهی"
  },
  {
    "poem_id": 87988,
    "vorder": 78,
    "position": 1,
    "text": "میان بسته‌ام چون تو فرمان دهی"
  },
  {
    "poem_id": 87988,
    "vorder": 79,
    "position": 0,
    "text": "شوم با سپاهی کمر بر میان"
  },
  {
    "poem_id": 87988,
    "vorder": 80,
    "position": 1,
    "text": "بگردانم این بد ز ایرانیان"
  },
  {
    "poem_id": 87988,
    "vorder": 81,
    "position": 0,
    "text": "ازان کشتگان شاه بی‌درد باد"
  },
  {
    "poem_id": 87988,
    "vorder": 82,
    "position": 1,
    "text": "رخ بدسگالان او زرد باد"
  },
  {
    "poem_id": 87988,
    "vorder": 83,
    "position": 0,
    "text": "ز گودرزیان خود جگر خسته‌ام"
  },
  {
    "poem_id": 87988,
    "vorder": 84,
    "position": 1,
    "text": "کمر بر میان سوگ را بسته‌ام"
  },
  {
    "poem_id": 87988,
    "vorder": 85,
    "position": 0,
    "text": "چو بشنید کیخسرو آواز اوی"
  },
  {
    "poem_id": 87988,
    "vorder": 86,
    "position": 1,
    "text": "به رخ برنهاد از دو دیده دو جوی"
  },
  {
    "poem_id": 87988,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت بی‌تو نخواهم زمان"
  },
  {
    "poem_id": 87988,
    "vorder": 88,
    "position": 1,
    "text": "نه اورنگ و تاج و نه گرز و کمان"
  },
  {
    "poem_id": 87988,
    "vorder": 89,
    "position": 0,
    "text": "فلک زیر خم کمند تو باد"
  },
  {
    "poem_id": 87988,
    "vorder": 90,
    "position": 1,
    "text": "سر تاجداران به بند تو باد"
  },
  {
    "poem_id": 87988,
    "vorder": 91,
    "position": 0,
    "text": "ز دینار و گنج و ز تاج و گهر"
  },
  {
    "poem_id": 87988,
    "vorder": 92,
    "position": 1,
    "text": "کلاه و کمان و کمند و کمر"
  },
  {
    "poem_id": 87988,
    "vorder": 93,
    "position": 0,
    "text": "بیاورد گنجور خسرو کلید"
  },
  {
    "poem_id": 87988,
    "vorder": 94,
    "position": 1,
    "text": "سر بدره‌های درم بردرید"
  },
  {
    "poem_id": 87988,
    "vorder": 95,
    "position": 0,
    "text": "همه شاه ایران به رستم سپرد"
  },
  {
    "poem_id": 87988,
    "vorder": 96,
    "position": 1,
    "text": "چنین گفت کای نامبردار گرد"
  },
  {
    "poem_id": 87988,
    "vorder": 97,
    "position": 0,
    "text": "جهان گنج و گنجور شمشیر تست"
  },
  {
    "poem_id": 87988,
    "vorder": 98,
    "position": 1,
    "text": "سر سروران جهان زیر تست"
  },
  {
    "poem_id": 87988,
    "vorder": 99,
    "position": 0,
    "text": "تو با گرزداران زاولستان"
  },
  {
    "poem_id": 87988,
    "vorder": 100,
    "position": 1,
    "text": "دلیران و شیران کابلستان"
  },
  {
    "poem_id": 87988,
    "vorder": 101,
    "position": 0,
    "text": "همی‌رو به کردار باد دمان"
  },
  {
    "poem_id": 87988,
    "vorder": 102,
    "position": 1,
    "text": "مجوی و مفرمای جستن زمان"
  },
  {
    "poem_id": 87988,
    "vorder": 103,
    "position": 0,
    "text": "ز گردان شمشیر‌زن سی‌هزار"
  },
  {
    "poem_id": 87988,
    "vorder": 104,
    "position": 1,
    "text": "ز لشکر گزین از در کارزار"
  },
  {
    "poem_id": 87988,
    "vorder": 105,
    "position": 0,
    "text": "فریبرز کاوس را ده سپاه"
  },
  {
    "poem_id": 87988,
    "vorder": 106,
    "position": 1,
    "text": "که او پیش‌رو باشد و کینه‌خواه"
  },
  {
    "poem_id": 87988,
    "vorder": 107,
    "position": 0,
    "text": "تهمتن زمین را ببوسید و گفت"
  },
  {
    "poem_id": 87988,
    "vorder": 108,
    "position": 1,
    "text": "که با من عنان و رکیب‌ست جفت"
  },
  {
    "poem_id": 87988,
    "vorder": 109,
    "position": 0,
    "text": "سران را سر اندر شتاب آوریم"
  },
  {
    "poem_id": 87988,
    "vorder": 110,
    "position": 1,
    "text": "مبادا که آرام و خواب آوریم"
  },
  {
    "poem_id": 87988,
    "vorder": 111,
    "position": 0,
    "text": "سپه را درم دادن آغاز کرد"
  },
  {
    "poem_id": 87988,
    "vorder": 112,
    "position": 1,
    "text": "به دشت آمد و رزم را ساز کرد"
  },
  {
    "poem_id": 87988,
    "vorder": 113,
    "position": 0,
    "text": "فریبرز را گفت برکش پگاه"
  },
  {
    "poem_id": 87988,
    "vorder": 114,
    "position": 1,
    "text": "سپاه اندر آور به پیش سپاه"
  },
  {
    "poem_id": 87988,
    "vorder": 115,
    "position": 0,
    "text": "نباید که روز و شبان بغنوی"
  },
  {
    "poem_id": 87988,
    "vorder": 116,
    "position": 1,
    "text": "مگر نزد طوس سپهبد شوی"
  },
  {
    "poem_id": 87988,
    "vorder": 117,
    "position": 0,
    "text": "بگویی که در جنگ تندی مکن"
  },
  {
    "poem_id": 87988,
    "vorder": 118,
    "position": 1,
    "text": "فریب زمان جوی و کندی مکن"
  },
  {
    "poem_id": 87988,
    "vorder": 119,
    "position": 0,
    "text": "من اینک به کردار باد دمان"
  },
  {
    "poem_id": 87988,
    "vorder": 120,
    "position": 1,
    "text": "بیایم نجویم بره بر زمان"
  },
  {
    "poem_id": 87988,
    "vorder": 121,
    "position": 0,
    "text": "چو گرگین میلاد کار آزمای"
  },
  {
    "poem_id": 87988,
    "vorder": 122,
    "position": 1,
    "text": "سپه را زند بر بد و نیک رای"
  },
  {
    "poem_id": 87988,
    "vorder": 123,
    "position": 0,
    "text": "چو خورشید تابنده بنمود چهر"
  },
  {
    "poem_id": 87988,
    "vorder": 124,
    "position": 1,
    "text": "بسان بتی با دلی پر ز مهر"
  },
  {
    "poem_id": 87988,
    "vorder": 125,
    "position": 0,
    "text": "بر آمد خروشیدن کرنای"
  },
  {
    "poem_id": 87988,
    "vorder": 126,
