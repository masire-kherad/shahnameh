[
  {
    "poem_id": 1325,
    "vorder": 1,
    "position": 0,
    "text": "زِ یاقوتِ سُرخ اَست چَرخِ کَبود"
  },
  {
    "poem_id": 1325,
    "vorder": 2,
    "position": 1,
    "text": "نه از آب و گَرد و نَه از باد و دود"
  },
  {
    "poem_id": 1325,
    "vorder": 3,
    "position": 0,
    "text": "به چَندین فُروغ و به چَندین چِراغ"
  },
  {
    "poem_id": 1325,
    "vorder": 4,
    "position": 1,
    "text": "بیاراسته چون به نوروز باغ"
  },
  {
    "poem_id": 1325,
    "vorder": 5,
    "position": 0,
    "text": "رَوان اَندر او گوهَرِ دل‌فُروز"
  },
  {
    "poem_id": 1325,
    "vorder": 6,
    "position": 1,
    "text": "کَز او روشنایی گرفته است روز"
  },
  {
    "poem_id": 1325,
    "vorder": 7,
    "position": 0,
    "text": "زِ خاوَر بَر آیَد سویِ باختَر"
  },
  {
    "poem_id": 1325,
    "vorder": 8,
    "position": 1,
    "text": "نباشَد اَز این یِک رَوِش راست‌تَر"
  },
  {
    "poem_id": 1325,
    "vorder": 9,
    "position": 0,
    "text": "اَیا آن که تو آفتابی هَمی"
  },
  {
    "poem_id": 1325,
    "vorder": 10,
    "position": 1,
    "text": "چه بودَت که بَر مَن نَتابی هَمی"
  }
]