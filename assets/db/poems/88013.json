[
  {
    "poem_id": 88013,
    "vorder": 1,
    "position": 0,
    "text": "ببخشود یزدان جوانیش را"
  },
  {
    "poem_id": 88013,
    "vorder": 2,
    "position": 1,
    "text": "بهم برشکست آن گمانیش را"
  },
  {
    "poem_id": 88013,
    "vorder": 3,
    "position": 0,
    "text": "کننده همی کند جای درخت"
  },
  {
    "poem_id": 88013,
    "vorder": 4,
    "position": 1,
    "text": "پدید آمد از دور پیران ز بخت"
  },
  {
    "poem_id": 88013,
    "vorder": 5,
    "position": 0,
    "text": "چو پیران ویسه بدانجا رسید"
  },
  {
    "poem_id": 88013,
    "vorder": 6,
    "position": 1,
    "text": "همه راه ترک کمربسته دید"
  },
  {
    "poem_id": 88013,
    "vorder": 7,
    "position": 0,
    "text": "یکی دار برپای کرده بلند"
  },
  {
    "poem_id": 88013,
    "vorder": 8,
    "position": 1,
    "text": "کمندی برو بسته چون پای بند"
  },
  {
    "poem_id": 88013,
    "vorder": 9,
    "position": 0,
    "text": "ز ترکان بپرسید کین دار چیست"
  },
  {
    "poem_id": 88013,
    "vorder": 10,
    "position": 1,
    "text": "در شاه را از در دار کیست"
  },
  {
    "poem_id": 88013,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت گرسیوز این بیژنست"
  },
  {
    "poem_id": 88013,
    "vorder": 12,
    "position": 1,
    "text": "از ایران کجا شاه را دشمنست"
  },
  {
    "poem_id": 88013,
    "vorder": 13,
    "position": 0,
    "text": "بزد اسب و آمد بر بیژنا"
  },
  {
    "poem_id": 88013,
    "vorder": 14,
    "position": 1,
    "text": "جگر خسته دیدش برهنه تنا"
  },
  {
    "poem_id": 88013,
    "vorder": 15,
    "position": 0,
    "text": "دو دست از پس پشت بسته چو سنگ"
  },
  {
    "poem_id": 88013,
    "vorder": 16,
    "position": 1,
    "text": "دهن خشک و رفته ز رخساره رنگ"
  },
  {
    "poem_id": 88013,
    "vorder": 17,
    "position": 0,
    "text": "بپرسید و گفتش که چون آمدی"
  },
  {
    "poem_id": 88013,
    "vorder": 18,
    "position": 1,
    "text": "از ایران همانا بخون آمدی"
  },
  {
    "poem_id": 88013,
    "vorder": 19,
    "position": 0,
    "text": "همه داستان بیژن او را بگفت"
  },
  {
    "poem_id": 88013,
    "vorder": 20,
    "position": 1,
    "text": "چنانچون رسیدش ز بدخواه جفت"
  },
  {
    "poem_id": 88013,
    "vorder": 21,
    "position": 0,
    "text": "ببخشود پیران ویسه بروی"
  },
  {
    "poem_id": 88013,
    "vorder": 22,
    "position": 1,
    "text": "ز مژگان سرشکش فرو شد بروی"
  },
  {
    "poem_id": 88013,
    "vorder": 23,
    "position": 0,
    "text": "بفرمود تا یک زمانش بدار"
  },
  {
    "poem_id": 88013,
    "vorder": 24,
    "position": 1,
    "text": "نکردند و گفتا هم ایدر بدار"
  },
  {
    "poem_id": 88013,
    "vorder": 25,
    "position": 0,
    "text": "بدان تا ببینم یکی روی شاه"
  },
  {
    "poem_id": 88013,
    "vorder": 26,
    "position": 1,
    "text": "نمایم بدو اختر نیک راه"
  },
  {
    "poem_id": 88013,
    "vorder": 27,
    "position": 0,
    "text": "بکاخ اندر آمد پرستارفش"
  },
  {
    "poem_id": 88013,
    "vorder": 28,
    "position": 1,
    "text": "بر شاه با دست کرده بکش"
  },
  {
    "poem_id": 88013,
    "vorder": 29,
    "position": 0,
    "text": "بیامد دمان تا بنزدیک تخت"
  },
  {
    "poem_id": 88013,
    "vorder": 30,
    "position": 1,
    "text": "بر افراسیاب آفرین کرد سخت"
  },
  {
    "poem_id": 88013,
    "vorder": 31,
    "position": 0,
    "text": "همی بود در پیش تختش بپای"
  },
  {
    "poem_id": 88013,
    "vorder": 32,
    "position": 1,
    "text": "چو دستور پاکیزه و رهنمای"
  },
  {
    "poem_id": 88013,
    "vorder": 33,
    "position": 0,
    "text": "سپهبد بدانست کز آرزوی"
  },
  {
    "poem_id": 88013,
    "vorder": 34,
    "position": 1,
    "text": "بپایست پیران آزاده خوی"
  },
  {
    "poem_id": 88013,
    "vorder": 35,
    "position": 0,
    "text": "بخندید و گفتش چه خواهی بگوی"
  },
  {
    "poem_id": 88013,
    "vorder": 36,
    "position": 1,
    "text": "ترا بیشتر نزد من آبروی"
  },
  {
    "poem_id": 88013,
    "vorder": 37,
    "position": 0,
    "text": "اگر زر خواهی و گر گوهرا"
  },
  {
    "poem_id": 88013,
    "vorder": 38,
    "position": 1,
    "text": "و گر پادشاهی هر کشورا"
  },
  {
    "poem_id": 88013,
    "vorder": 39,
    "position": 0,
    "text": "ندارم دریغ از تو من گنج خویش"
  },
  {
    "poem_id": 88013,
    "vorder": 40,
    "position": 1,
    "text": "چرا برگزینی همی رنج خویش"
  },
  {
    "poem_id": 88013,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید پیران خسرو پرست"
  },
  {
    "poem_id": 88013,
    "vorder": 42,
    "position": 1,
    "text": "زمین را ببوسید و بر پای جست"
  },
  {
    "poem_id": 88013,
    "vorder": 43,
    "position": 0,
    "text": "که جاوید بادا ترا بخت و جای"
  },
  {
    "poem_id": 88013,
    "vorder": 44,
    "position": 1,
    "text": "مبادا ز تخت تو پردخته جای"
  },
  {
    "poem_id": 88013,
    "vorder": 45,
    "position": 0,
    "text": "ز شاهان گیتی ستایش تراست"
  },
  {
    "poem_id": 88013,
    "vorder": 46,
    "position": 1,
    "text": "ز خورشید برتر نمایش تراست"
  },
  {
    "poem_id": 88013,
    "vorder": 47,
    "position": 0,
    "text": "مرا هرچ باید ببخت تو هست"
  },
  {
    "poem_id": 88013,
    "vorder": 48,
    "position": 1,
    "text": "ز مردان وز گنج و نیروی دست"
  },
  {
    "poem_id": 88013,
    "vorder": 49,
    "position": 0,
    "text": "مرا این نیاز از در خویش نیست"
  },
  {
    "poem_id": 88013,
    "vorder": 50,
    "position": 1,
    "text": "کس از کهتران تو درویش نیست"
  },
  {
    "poem_id": 88013,
    "vorder": 51,
    "position": 0,
    "text": "بداند شهنشاه برترمنش"
  },
  {
    "poem_id": 88013,
    "vorder": 52,
    "position": 1,
    "text": "ستوده بهر کار بی‌سرزنش"
  },
  {
    "poem_id": 88013,
    "vorder": 53,
    "position": 0,
    "text": "که من شاه را پیش ازین چند بار"
  },
  {
    "poem_id": 88013,
    "vorder": 54,
    "position": 1,
    "text": "همی دادمی پند بر چند کار"
  },
  {
    "poem_id": 88013,
    "vorder": 55,
    "position": 0,
    "text": "بفرمان من هیچ نامد فراز"
  },
  {
    "poem_id": 88013,
    "vorder": 56,
    "position": 1,
    "text": "ازو داشتم کارها دست باز"
  },
  {
    "poem_id": 88013,
    "vorder": 57,
    "position": 0,
    "text": "مکش گفتمت پور کاوس را"
  },
  {
    "poem_id": 88013,
    "vorder": 58,
    "position": 1,
    "text": "که دشمن کنی رستم و طوس را"
  },
  {
    "poem_id": 88013,
    "vorder": 59,
    "position": 0,
    "text": "کز ایران بپیلان بکوبندمان"
  },
  {
    "poem_id": 88013,
    "vorder": 60,
    "position": 1,
    "text": "ز هم بگسلانند پیوندمان"
  },
  {
    "poem_id": 88013,
    "vorder": 61,
    "position": 0,
    "text": "سیاوش که بود از نژاد کیان"
  },
  {
    "poem_id": 88013,
    "vorder": 62,
    "position": 1,
    "text": "ز بهر تو بسته کمر بر میان"
  },
  {
    "poem_id": 88013,
    "vorder": 63,
    "position": 0,
    "text": "بکشتی بخیره سیاوش را"
  },
  {
    "poem_id": 88013,
    "vorder": 64,
    "position": 1,
    "text": "بزهر اندر آمیختی نوش را"
  },
  {
    "poem_id": 88013,
    "vorder": 65,
    "position": 0,
    "text": "بدیدی بدیهای ایرانیان"
  },
  {
    "poem_id": 88013,
    "vorder": 66,
    "position": 1,
    "text": "که کردند با شهر تورانیان"
  },
  {
    "poem_id": 88013,
    "vorder": 67,
    "position": 0,
    "text": "ز ترکان دو بهره بپای ستور"
  },
  {
    "poem_id": 88013,
    "vorder": 68,
    "position": 1,
    "text": "سپردند و شد بخت را آب شور"
  },
  {
    "poem_id": 88013,
    "vorder": 69,
    "position": 0,
    "text": "هنوز آن سر تیغ دستان سام"
  },
  {
    "poem_id": 88013,
    "vorder": 70,
    "position": 1,
    "text": "همانا نیاسود اندر نیام"
  },
  {
    "poem_id": 88013,
    "vorder": 71,
    "position": 0,
    "text": "که رستم همی سرفشاند ازوی"
  },
  {
    "poem_id": 88013,
    "vorder": 72,
    "position": 1,
    "text": "بخورشید بر خون چکاند ازوی"
  },
  {
    "poem_id": 88013,
    "vorder": 73,
    "position": 0,
    "text": "بآرام بر کینه جویی همی"
  },
  {
    "poem_id": 88013,
    "vorder": 74,
    "position": 1,
    "text": "گل زهر خیره ببویی همی"
  },
  {
    "poem_id": 88013,
    "vorder": 75,
    "position": 0,
    "text": "اگر خون بیژن بریزی برین"
  },
  {
    "poem_id": 88013,
    "vorder": 76,
    "position": 1,
    "text": "ز توران برآید همان گرد کین"
  },
  {
    "poem_id": 88013,
    "vorder": 77,
    "position": 0,
    "text": "خردمند شاهی و ما کهترا"
  },
  {
    "poem_id": 88013,
    "vorder": 78,
    "position": 1,
    "text": "تو چشم خرد باز کن بنگرا"
  },
  {
    "poem_id": 88013,
    "vorder": 79,
    "position": 0,
    "text": "نگه کن ازان کین که گستردیا"
  },
  {
    "poem_id": 88013,
    "vorder": 80,
    "position": 1,
    "text": "ابا شاه ایران چه بر خوردیا"
  },
  {
    "poem_id": 88013,
    "vorder": 81,
    "position": 0,
    "text": "هم آنرا همی خواستار آوری"
  },
  {
    "poem_id": 88013,
    "vorder": 82,
    "position": 1,
    "text": "درخت بلا را ببار آوری"
  },
  {
    "poem_id": 88013,
    "vorder": 83,
    "position": 0,
    "text": "چو کینه دو گردد نداریم پای"
  },
  {
    "poem_id": 88013,
    "vorder": 84,
    "position": 1,
    "text": "ایا پهلوان جهان کدخدای"
  },
  {
    "poem_id": 88013,
    "vorder": 85,
    "position": 0,
    "text": "به از تو نداند کسی گیو را"
  },
  {
    "poem_id": 88013,
    "vorder": 86,
    "position": 1,
    "text": "نهنگ بلا رستم نیو را"
  },
  {
    "poem_id": 88013,
    "vorder": 87,
    "position": 0,
    "text": "چو گودرز کشواد پولادچنگ"
  },
  {
    "poem_id": 88013,
    "vorder": 88,
    "position": 1,
    "text": "که آید ز بهر نبیره بجنگ"
  },
  {
    "poem_id": 88013,
    "vorder": 89,
    "position": 0,
    "text": "چو برزد بران آتش تیز آب"
  },
  {
    "poem_id": 88013,
    "vorder": 90,
    "position": 1,
    "text": "چنین داد پاسخ پس افراسیاب"
  },
  {
    "poem_id": 88013,
    "vorder": 91,
    "position": 0,
    "text": "که بیژن نبینی که با من چه کرد"
  },
  {
    "poem_id": 88013,
    "vorder": 92,
    "position": 1,
    "text": "بایران و توران شدم روی زرد"
  },
  {
    "poem_id": 88013,
    "vorder": 93,
    "position": 0,
    "text": "نبینی کزین بدهنر دخترم"
  },
  {
    "poem_id": 88013,
    "vorder": 94,
    "position": 1,
    "text": "چه رسوایی آمد بپیران سرم"
  },
  {
    "poem_id": 88013,
    "vorder": 95,
    "position": 0,
    "text": "همان نام پوشیده رویان من"
  },
  {
    "poem_id": 88013,
    "vorder": 96,
    "position": 1,
    "text": "ز پرده بگسترد بر انجمن"
  },
  {
    "poem_id": 88013,
    "vorder": 97,
    "position": 0,
    "text": "کزین ننگ تا جاودان بر سرم"
  },
  {
    "poem_id": 88013,
    "vorder": 98,
    "position": 1,
    "text": "بخندد همی کشور و لشکرم"
  },
  {
    "poem_id": 88013,
    "vorder": 99,
    "position": 0,
    "text": "چنو یابد از من رهایی بجان"
  },
  {
    "poem_id": 88013,
    "vorder": 100,
    "position": 1,
    "text": "گشایند بر من ز هر سو زبان"
  },
  {
    "poem_id": 88013,
    "vorder": 101,
    "position": 0,
    "text": "برسوایی اندر بمانم بدرد"
  },
  {
    "poem_id": 88013,
    "vorder": 102,
    "position": 1,
    "text": "بپالایم از دیدگان آب زرد"
  },
  {
    "poem_id": 88013,
    "vorder": 103,
    "position": 0,
    "text": "دگر آفرین کرد پیران بدوی"
  },
  {
    "poem_id": 88013,
    "vorder": 104,
    "position": 1,
    "text": "که ای شاه نیک اختر راست‌گوی"
  },
  {
    "poem_id": 88013,
    "vorder": 105,
    "position": 0,
    "text": "چنینست کین شاه گوید همی"
  },
  {
    "poem_id": 88013,
    "vorder": 106,
    "position": 1,
    "text": "جز از نیک نامی نجوید همی"
  },
  {
    "poem_id": 88013,
    "vorder": 107,
    "position": 0,
    "text": "ولیکن بدین رای هشیار من"
  },
  {
    "poem_id": 88013,
    "vorder": 108,
    "position": 1,
    "text": "یکی بنگرد ژرف سالار من"
  },
  {
    "poem_id": 88013,
    "vorder": 109,
    "position": 0,
    "text": "ببندد مر او را ببند گران"
  },
  {
    "poem_id": 88013,
    "vorder": 110,
    "position": 1,
    "text": "کجا دار و کشتن گزیند بران"
  },
  {
    "poem_id": 88013,
    "vorder": 111,
    "position": 0,
    "text": "هر آنکو بزندان تو بسته ماند"
  },
  {
    "poem_id": 88013,
    "vorder": 112,
    "position": 1,
    "text": "ز دیوانها نام او کس نخواند"
  },
  {
    "poem_id": 88013,
    "vorder": 113,
    "position": 0,
    "text": "ازو پند گیرند ایرانیان"
  },
  {
    "poem_id": 88013,
    "vorder": 114,
    "position": 1,
    "text": "نبندند ازین پس بدی را میان"
  },
  {
    "poem_id": 88013,
    "vorder": 115,
    "position": 0,
    "text": "چنان کرد سالار کو رای دید"
  },
  {
    "poem_id": 88013,
    "vorder": 116,
    "position": 1,
    "text": "دلش با زبان شاه بر جای دید"
  },
  {
    "poem_id": 88013,
    "vorder": 117,
    "position": 0,
    "text": "ز دستور پاکیزهٔ راهبر"
  },
  {
    "poem_id": 88013,
    "vorder": 118,
    "position": 1,
    "text": "درفشان شود شاه بر گاه بر"
  },
  {
    "poem_id": 88013,
    "vorder": 119,
    "position": 0,
    "text": "بگرسیوز آنگه بفرمود شاه"
  },
  {
    "poem_id": 88013,
    "vorder": 120,
    "position": 1,
    "text": "که بند گران ساز و تاریک چاه"
  },
  {
    "poem_id": 88013,
    "vorder": 121,
    "position": 0,
    "text": "دو دستش بزنجیر و گردن بغل"
  },
  {
    "poem_id": 88013,
    "vorder": 122,
    "position": 1,
    "text": "یکی بند رومی بکردار مل"
  },
  {
    "poem_id": 88013,
    "vorder": 123,
    "position": 0,
    "text": "ببندش به مسمار آهنگران"
  },
  {
    "poem_id": 88013,
    "vorder": 124,
    "position": 1,
    "text": "ز سر تا بپایش ببند اندران"
  },
  {
    "poem_id": 88013,
    "vorder": 125,
    "position": 0,
    "text": "چو بستی نگون اندر افگن بچاه"
  },
  {
    "poem_id": 88013,
    "vorder": 126,
    "position": 1,
    "text": "چو بی‌بهره گردد ز خورشید و ماه"
  },
  {
    "poem_id": 88013,
    "vorder": 127,
    "position": 0,
    "text": "ببر پیل و آن سنگ اکوان دیو"
  },
  {
    "poem_id": 88013,
    "vorder": 128,
    "position": 1,
    "text": "که از ژرف دریای گیهان خدیو"
  },
  {
    "poem_id": 88013,
    "vorder": 129,
    "position": 0,
    "text": "فگندست در بیشهٔ چین ستان"
  },
  {
    "poem_id": 88013,
    "vorder": 130,
    "position": 1,
    "text": "بیاور ز بیژن بدان کین ستان"
  },
  {
    "poem_id": 88013,
    "vorder": 131,
    "position": 0,
    "text": "بپیلان گردون کش آن سنگ را"
  },
  {
    "poem_id": 88013,
    "vorder": 132,
    "position": 1,
    "text": "که پوشد سر چاه ارژنگ را"
  },
  {
    "poem_id": 88013,
    "vorder": 133,
    "position": 0,
    "text": "بیاور سر چاه او را بپوش"
  },
  {
    "poem_id": 88013,
    "vorder": 134,
    "position": 1,
    "text": "بدان تا بزاری برآیدش هوش"
  },
  {
    "poem_id": 88013,
    "vorder": 135,
    "position": 0,
    "text": "وز آنجا بایوان آن بی‌هنر"
  },
  {
    "poem_id": 88013,
    "vorder": 136,
    "position": 1,
    "text": "منیژه کزو ننگ یابد گهر"
  },
  {
    "poem_id": 88013,
    "vorder": 137,
    "position": 0,
    "text": "برو با سواران و تاراج کن"
  },
  {
    "poem_id": 88013,
    "vorder": 138,
    "position": 1,
    "text": "نگون‌بخت را بی سر و تاج کن"
  },
  {
    "poem_id": 88013,
    "vorder": 139,
    "position": 0,
    "text": "بگو ای بنفرین شوریده بخت"
  },
  {
    "poem_id": 88013,
    "vorder": 140,
    "position": 1,
    "text": "که بر تو نزیبد همی تاج و تخت"
  },
  {
    "poem_id": 88013,
    "vorder": 141,
    "position": 0,
    "text": "به ننگ از کیان پست کردی سرم"
  },
  {
    "poem_id": 88013,
    "vorder": 142,
    "position": 1,
    "text": "بخاک اندر انداختی افسرم"
  },
  {
    "poem_id": 88013,
    "vorder": 143,
    "position": 0,
    "text": "برهنه کشانش ببر تا بچاه"
  },
  {
    "poem_id": 88013,
    "vorder": 144,
    "position": 1,
    "text": "که در چاه بین آنک دیدی بگاه"
  },
  {
    "poem_id": 88013,
    "vorder": 145,
    "position": 0,
    "text": "بهارش توی غمگسارش توی"
  },
  {
    "poem_id": 88013,
    "vorder": 146,
    "position": 1,
    "text": "درین تنگ زندان زوارش توی"
  },
  {
    "poem_id": 88013,
    "vorder": 147,
    "position": 0,
    "text": "خرامید گرسیوز از پیش اوی"
  },
  {
    "poem_id": 88013,
    "vorder": 148,
    "position": 1,
    "text": "بکردند کام بداندیش اوی"
  },
  {
    "poem_id": 88013,
    "vorder": 149,
    "position": 0,
    "text": "کشان بیژن گیو از پیش دار"
  },
  {
    "poem_id": 88013,
    "vorder": 150,
    "position": 1,
    "text": "ببردند بسته بران چاهسار"
  },
  {
    "poem_id": 88013,
    "vorder": 151,
    "position": 0,
    "text": "ز سر تا به پایش به آهن ببست"
  },
  {
    "poem_id": 88013,
    "vorder": 152,
    "position": 1,
    "text": "بر و بازوی و گردن و پای و دست"
  },
  {
    "poem_id": 88013,
    "vorder": 153,
    "position": 0,
    "text": "بپولاد خایسک آهنگران"
  },
  {
    "poem_id": 88013,
    "vorder": 154,
    "position": 1,
    "text": "فروبرد مسمارهای گران"
  },
  {
    "poem_id": 88013,
    "vorder": 155,
    "position": 0,
    "text": "نگونش بچاه اندر انداختند"
  },
  {
    "poem_id": 88013,
    "vorder": 156,
    "position": 1,
    "text": "سر چاه را بند بر ساختند"
  },
  {
    "poem_id": 88013,
    "vorder": 157,
    "position": 0,
    "text": "وز آنجا بایوان آن دخترش"
  },
  {
    "poem_id": 88013,
    "vorder": 158,
    "position": 1,
    "text": "بیاورد گرسیوز آن لشکرش"
  },
  {
    "poem_id": 88013,
    "vorder": 159,
    "position": 0,
    "text": "همه گنج و گوهر بتاراج داد"
  },
  {
    "poem_id": 88013,
    "vorder": 160,
    "position": 1,
    "text": "ازین بدره بستد بدان تاج داد"
  },
  {
    "poem_id": 88013,
    "vorder": 161,
    "position": 0,
    "text": "منیژه برهنه بیک چادرا"
  },
  {
    "poem_id": 88013,
    "vorder": 162,
    "position": 1,
    "text": "برهنه دو پای و گشاده سرا"
  },
  {
    "poem_id": 88013,
    "vorder": 163,
    "position": 0,
    "text": "کشیدش دوان تا بدان چاهسار"
  },
  {
    "poem_id": 88013,
    "vorder": 164,
    "position": 1,
    "text": "دو دیده پر از خون و رخ جویبار"
  },
  {
    "poem_id": 88013,
    "vorder": 165,
    "position": 0,
    "text": "بدو گفت اینک ترا خان و مان"
  },
  {
    "poem_id": 88013,
    "vorder": 166,
    "position": 1,
    "text": "زواری برین بسته تا جاودان"
  },
  {
    "poem_id": 88013,
    "vorder": 167,
    "position": 0,
    "text": "غریوان همی گشت بر گرد دشت"
  },
  {
    "poem_id": 88013,
    "vorder": 168,
    "position": 1,
    "text": "چو یک روز و یک شب برو بر گذشت"
  },
  {
    "poem_id": 88013,
    "vorder": 169,
    "position": 0,
    "text": "خروشان بیامد بنزدیک چاه"
  },
  {
    "poem_id": 88013,
    "vorder": 170,
    "position": 1,
    "text": "یکی دست را اندرو کرد راه"
  },
  {
    "poem_id": 88013,
    "vorder": 171,
    "position": 0,
    "text": "چو از کوه خورشید سر برزدی"
  },
  {
    "poem_id": 88013,
    "vorder": 172,
    "position": 1,
    "text": "منیژه ز هر در همی نان چدی"
  },
  {
    "poem_id": 88013,
    "vorder": 173,
    "position": 0,
    "text": "همی گرد کردی بروز دراز"
  },
  {
    "poem_id": 88013,
    "vorder": 174,
    "position": 1,
    "text": "بسوراخ چاه آوریدی فراز"
  },
  {
    "poem_id": 88013,
    "vorder": 175,
    "position": 0,
    "text": "ببیژن سپردی و بگریستی"
  },
  {
    "poem_id": 88013,
    "vorder": 176,
    "position": 1,
    "text": "بران شوربختی همی زیستی"
  }
]