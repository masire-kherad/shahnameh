[
  {
    "poem_id": 88051,
    "vorder": 1,
    "position": 0,
    "text": "برون رفت گرگین نهم کینه‌خواه"
  },
  {
    "poem_id": 88051,
    "vorder": 2,
    "position": 1,
    "text": "ابا اندریمان ز توران سپاه"
  },
  {
    "poem_id": 88051,
    "vorder": 3,
    "position": 0,
    "text": "جهاندیده و کارکرده دو مرد"
  },
  {
    "poem_id": 88051,
    "vorder": 4,
    "position": 1,
    "text": "برفتند و جستند جای نبرد"
  },
  {
    "poem_id": 88051,
    "vorder": 5,
    "position": 0,
    "text": "به نیزه بگشتند و بشکست پست"
  },
  {
    "poem_id": 88051,
    "vorder": 6,
    "position": 1,
    "text": "کمان برگرفتند هر دو به دست"
  },
  {
    "poem_id": 88051,
    "vorder": 7,
    "position": 0,
    "text": "ببارید تیر از کمان سران"
  },
  {
    "poem_id": 88051,
    "vorder": 8,
    "position": 1,
    "text": "به روی اندر آورده کرگ اسپران"
  },
  {
    "poem_id": 88051,
    "vorder": 9,
    "position": 0,
    "text": "همی تیر بارید همچون تگرگ"
  },
  {
    "poem_id": 88051,
    "vorder": 10,
    "position": 1,
    "text": "بر آن اسپر کرگ و بر ترک و ترگ"
  },
  {
    "poem_id": 88051,
    "vorder": 11,
    "position": 0,
    "text": "یکی تیر گرگین بزد بر سرش"
  },
  {
    "poem_id": 88051,
    "vorder": 12,
    "position": 1,
    "text": "که بردوخت با ترگ رومی برش"
  },
  {
    "poem_id": 88051,
    "vorder": 13,
    "position": 0,
    "text": "بلرزید بر زین ز سختی سوار"
  },
  {
    "poem_id": 88051,
    "vorder": 14,
    "position": 1,
    "text": "یکی تیر دیگر بزد نامدار"
  },
  {
    "poem_id": 88051,
    "vorder": 15,
    "position": 0,
    "text": "هم آنگاه ترک اندر آمد نگون"
  },
  {
    "poem_id": 88051,
    "vorder": 16,
    "position": 1,
    "text": "ز چشمش برون آمد از درد خون"
  },
  {
    "poem_id": 88051,
    "vorder": 17,
    "position": 0,
    "text": "فرود آمد از باره گرگین چو گرد"
  },
  {
    "poem_id": 88051,
    "vorder": 18,
    "position": 1,
    "text": "سر اندریمان ز تن دور کرد"
  },
  {
    "poem_id": 88051,
    "vorder": 19,
    "position": 0,
    "text": "به فتراک بربست و خود برنشست"
  },
  {
    "poem_id": 88051,
    "vorder": 20,
    "position": 1,
    "text": "نوند سوار نبرده به دست"
  },
  {
    "poem_id": 88051,
    "vorder": 21,
    "position": 0,
    "text": "بر آن تند بالا برآمد دمان"
  },
  {
    "poem_id": 88051,
    "vorder": 22,
    "position": 1,
    "text": "همیدون به بازو به زه بر کمان"
  },
  {
    "poem_id": 88051,
    "vorder": 23,
    "position": 0,
    "text": "به نیروی یزدان که او بد پناه"
  },
  {
    "poem_id": 88051,
    "vorder": 24,
    "position": 1,
    "text": "به پیروز بخت جهاندار شاه"
  },
  {
    "poem_id": 88051,
    "vorder": 25,
    "position": 0,
    "text": "چو پیروز برگشت مرد از نبرد"
  },
  {
    "poem_id": 88051,
    "vorder": 26,
    "position": 1,
    "text": "درفش دلفروز بر پای کرد"
  }
]