[
  {
    "poem_id": 88086,
    "vorder": 1,
    "position": 0,
    "text": "چو با ایمنی گشت کاووس جفت"
  },
  {
    "poem_id": 88086,
    "vorder": 2,
    "position": 1,
    "text": "همه راز دل پیش یزدان بگفت"
  },
  {
    "poem_id": 88086,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت کای برتر از روزگار"
  },
  {
    "poem_id": 88086,
    "vorder": 4,
    "position": 1,
    "text": "تو باشی به هر نیکی آموزگار"
  },
  {
    "poem_id": 88086,
    "vorder": 5,
    "position": 0,
    "text": "ز تو یافتم فر و اورنگ و بخت"
  },
  {
    "poem_id": 88086,
    "vorder": 6,
    "position": 1,
    "text": "بزرگی و دیهیم و هم تاج و تخت"
  },
  {
    "poem_id": 88086,
    "vorder": 7,
    "position": 0,
    "text": "تو کردی کسی را چو من بهرمند"
  },
  {
    "poem_id": 88086,
    "vorder": 8,
    "position": 1,
    "text": "ز گنج و ز تخت و ز نام بلند"
  },
  {
    "poem_id": 88086,
    "vorder": 9,
    "position": 0,
    "text": "ز تو خواستم تا یکی کینه‌ور"
  },
  {
    "poem_id": 88086,
    "vorder": 10,
    "position": 1,
    "text": "به کین سیاوش ببندد کمر"
  },
  {
    "poem_id": 88086,
    "vorder": 11,
    "position": 0,
    "text": "نبیره بدیدم جهانبین خویش"
  },
  {
    "poem_id": 88086,
    "vorder": 12,
    "position": 1,
    "text": "به فرهنگ و تدبیر و آیین خویش"
  },
  {
    "poem_id": 88086,
    "vorder": 13,
    "position": 0,
    "text": "جهانجوی با فر و برز و خرد"
  },
  {
    "poem_id": 88086,
    "vorder": 14,
    "position": 1,
    "text": "ز شاهان پیشینگان بگذرد"
  },
  {
    "poem_id": 88086,
    "vorder": 15,
    "position": 0,
    "text": "چو سالم سه پنجاه بر سر گذشت"
  },
  {
    "poem_id": 88086,
    "vorder": 16,
    "position": 1,
    "text": "سر موی مشکین چو کافور گشت"
  },
  {
    "poem_id": 88086,
    "vorder": 17,
    "position": 0,
    "text": "همان سرو یازنده شد چون کمان"
  },
  {
    "poem_id": 88086,
    "vorder": 18,
    "position": 1,
    "text": "ندارم گران گر سرآید زمان"
  },
  {
    "poem_id": 88086,
    "vorder": 19,
    "position": 0,
    "text": "بسی برنیامد بر این روزگار"
  },
  {
    "poem_id": 88086,
    "vorder": 20,
    "position": 1,
    "text": "کزو ماند نام از جهان یادگار"
  },
  {
    "poem_id": 88086,
    "vorder": 21,
    "position": 0,
    "text": "جهاندار کیخسرو آمد به گاه"
  },
  {
    "poem_id": 88086,
    "vorder": 22,
    "position": 1,
    "text": "نشست از بر زیرگه با سپاه"
  },
  {
    "poem_id": 88086,
    "vorder": 23,
    "position": 0,
    "text": "از ایرانیان هرکه بد نامجوی"
  },
  {
    "poem_id": 88086,
    "vorder": 24,
    "position": 1,
    "text": "پیاده برفتند بی‌رنگ و بوی"
  },
  {
    "poem_id": 88086,
    "vorder": 25,
    "position": 0,
    "text": "همه جامه‌هاشان کبود و سیاه"
  },
  {
    "poem_id": 88086,
    "vorder": 26,
    "position": 1,
    "text": "دو هفته ببودند با سوگ شاه"
  },
  {
    "poem_id": 88086,
    "vorder": 27,
    "position": 0,
    "text": "ز بهر ستودانش کاخی بلند"
  },
  {
    "poem_id": 88086,
    "vorder": 28,
    "position": 1,
    "text": "بکردند بالای او ده کمند"
  },
  {
    "poem_id": 88086,
    "vorder": 29,
    "position": 0,
    "text": "ببردند پس نامداران شاه"
  },
  {
    "poem_id": 88086,
    "vorder": 30,
    "position": 1,
    "text": "دبیقی و دیبای رومی سیاه"
  },
  {
    "poem_id": 88086,
    "vorder": 31,
    "position": 0,
    "text": "بر او تافته عود و کافور و مشک"
  },
  {
    "poem_id": 88086,
    "vorder": 32,
    "position": 1,
    "text": "تنش را بدو در بکردند خشک"
  },
  {
    "poem_id": 88086,
    "vorder": 33,
    "position": 0,
    "text": "نهادند زیر اندرش تخت عاج"
  },
  {
    "poem_id": 88086,
    "vorder": 34,
    "position": 1,
    "text": "به سر بر ز کافور وز مشک تاج"
  },
  {
    "poem_id": 88086,
    "vorder": 35,
    "position": 0,
    "text": "چو برگشت کیخسرو از پیش تخت"
  },
  {
    "poem_id": 88086,
    "vorder": 36,
    "position": 1,
    "text": "در خوابگه را ببستند سخت"
  },
  {
    "poem_id": 88086,
    "vorder": 37,
    "position": 0,
    "text": "کسی نیز کاووس کی را ندید"
  },
  {
    "poem_id": 88086,
    "vorder": 38,
    "position": 1,
    "text": "ز کین و ز آوردگاه آرمید"
  },
  {
    "poem_id": 88086,
    "vorder": 39,
    "position": 0,
    "text": "چنینست رسم سرای سپنج"
  },
  {
    "poem_id": 88086,
    "vorder": 40,
    "position": 1,
    "text": "نمانی در او جاودانه مرنج"
  },
  {
    "poem_id": 88086,
    "vorder": 41,
    "position": 0,
    "text": "نه دانا گذر یابد از چنگ مرگ"
  },
  {
    "poem_id": 88086,
    "vorder": 42,
    "position": 1,
    "text": "نه جنگ‌آوران زیر خفتان و ترگ"
  },
  {
    "poem_id": 88086,
    "vorder": 43,
    "position": 0,
    "text": "اگر شاه باشی وگر زردهشت"
  },
  {
    "poem_id": 88086,
    "vorder": 44,
    "position": 1,
    "text": "نهالی ز خاکست و بالین ز خشت"
  },
  {
    "poem_id": 88086,
    "vorder": 45,
    "position": 0,
    "text": "چنان دان که گیتی ترا دشمنست"
  },
  {
    "poem_id": 88086,
    "vorder": 46,
    "position": 1,
    "text": "زمین بستر و گور پیراهنست"
  },
  {
    "poem_id": 88086,
    "vorder": 47,
    "position": 0,
    "text": "چهل روز سوگ نیا داشت شاه"
  },
  {
    "poem_id": 88086,
    "vorder": 48,
    "position": 1,
    "text": "ز شادی شده دور وز تاج و گاه"
  },
  {
    "poem_id": 88086,
    "vorder": 49,
    "position": 0,
    "text": "پس آنگه نشست از بر تخت عاج"
  },
  {
    "poem_id": 88086,
    "vorder": 50,
    "position": 1,
    "text": "به سر برنهاد آن دل‌افروز تاج"
  },
  {
    "poem_id": 88086,
    "vorder": 51,
    "position": 0,
    "text": "سپاه انجمن شد به درگاه شاه"
  },
  {
    "poem_id": 88086,
    "vorder": 52,
    "position": 1,
    "text": "ردان و بزرگان زرین کلاه"
  },
  {
    "poem_id": 88086,
    "vorder": 53,
    "position": 0,
    "text": "به شاهی بر او آفرین خواندند"
  },
  {
    "poem_id": 88086,
    "vorder": 54,
    "position": 1,
    "text": "بر آن تاج بر گوهر افشاندند"
  },
  {
    "poem_id": 88086,
    "vorder": 55,
    "position": 0,
    "text": "یکی سور بد در جهان سر به سر"
  },
  {
    "poem_id": 88086,
    "vorder": 56,
    "position": 1,
    "text": "چو بر تخت بنشست پیروزگر"
  }
]