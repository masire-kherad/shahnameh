[
  {
    "poem_id": 1508,
    "vorder": 1,
    "position": 0,
    "text": "جهان چون به زاری برآید همی"
  },
  {
    "poem_id": 1508,
    "vorder": 2,
    "position": 1,
    "text": "بد و نیک روزی سرآید همی"
  },
  {
    "poem_id": 1508,
    "vorder": 3,
    "position": 0,
    "text": "چو بستی کمر بر در راه آز"
  },
  {
    "poem_id": 1508,
    "vorder": 4,
    "position": 1,
    "text": "شود کار گیتیت یکسر دراز"
  },
  {
    "poem_id": 1508,
    "vorder": 5,
    "position": 0,
    "text": "به یک روی جستن بلندی سزاست"
  },
  {
    "poem_id": 1508,
    "vorder": 6,
    "position": 1,
    "text": "اگر در میان دم اژدهاست"
  },
  {
    "poem_id": 1508,
    "vorder": 7,
    "position": 0,
    "text": "و دیگر که گیتی ندارد درنگ"
  },
  {
    "poem_id": 1508,
    "vorder": 8,
    "position": 1,
    "text": "سرای سپنجی چه پهن و چه تنگ"
  },
  {
    "poem_id": 1508,
    "vorder": 9,
    "position": 0,
    "text": "پرستنده ی آز و جویای کین"
  },
  {
    "poem_id": 1508,
    "vorder": 10,
    "position": 1,
    "text": "به گیتی ز کس نشنود آفرین"
  },
  {
    "poem_id": 1508,
    "vorder": 11,
    "position": 0,
    "text": "چو سرو سهی گوژ گردد به باغ"
  },
  {
    "poem_id": 1508,
    "vorder": 12,
    "position": 1,
    "text": "بدو بر شود تیره روشن چراغ"
  },
  {
    "poem_id": 1508,
    "vorder": 13,
    "position": 0,
    "text": "کند برگ پژمرده و بیخ سست"
  },
  {
    "poem_id": 1508,
    "vorder": 14,
    "position": 1,
    "text": "سرش سوی پستی گراید نخست"
  },
  {
    "poem_id": 1508,
    "vorder": 15,
    "position": 0,
    "text": "بروید ز خاک و شود باز خاک"
  },
  {
    "poem_id": 1508,
    "vorder": 16,
    "position": 1,
    "text": "همه جای ترسست و تیمار و باک"
  },
  {
    "poem_id": 1508,
    "vorder": 17,
    "position": 0,
    "text": "سر مایهٔ مرد سنگ و خرد"
  },
  {
    "poem_id": 1508,
    "vorder": 18,
    "position": 1,
    "text": "ز گیتی بی‌آزاری اندر خورد"
  },
  {
    "poem_id": 1508,
    "vorder": 19,
    "position": 0,
    "text": "در دانش و آنگهی راستی"
  },
  {
    "poem_id": 1508,
    "vorder": 20,
    "position": 1,
    "text": "گرین دو نیابی روان کاستی"
  },
  {
    "poem_id": 1508,
    "vorder": 21,
    "position": 0,
    "text": "اگر خود بمانی به گیتی دراز"
  },
  {
    "poem_id": 1508,
    "vorder": 22,
    "position": 1,
    "text": "ز رنج تن آید به رفتن نیاز"
  },
  {
    "poem_id": 1508,
    "vorder": 23,
    "position": 0,
    "text": "یکی ژرف دریاست بن ناپدید"
  },
  {
    "poem_id": 1508,
    "vorder": 24,
    "position": 1,
    "text": "در گنج رازش ندارد کلید"
  },
  {
    "poem_id": 1508,
    "vorder": 25,
    "position": 0,
    "text": "اگر چند یابی فزون بایدت"
  },
  {
    "poem_id": 1508,
    "vorder": 26,
    "position": 1,
    "text": "همان خورده یک روز بگزایدت"
  },
  {
    "poem_id": 1508,
    "vorder": 27,
    "position": 0,
    "text": "سه چیزت بباید کز آن چاره نیست"
  },
  {
    "poem_id": 1508,
    "vorder": 28,
    "position": 1,
    "text": "وزو بر سرت نیز پیغاره نیست"
  },
  {
    "poem_id": 1508,
    "vorder": 29,
    "position": 0,
    "text": "خوری گر بپوشی و گر گستری"
  },
  {
    "poem_id": 1508,
    "vorder": 30,
    "position": 1,
    "text": "سزد گر به دیگر سخن ننگری"
  },
  {
    "poem_id": 1508,
    "vorder": 31,
    "position": 0,
    "text": "چو زین سه گذشتی همه رنج و آز"
  },
  {
    "poem_id": 1508,
    "vorder": 32,
    "position": 1,
    "text": "چه در آز پیچی چه اندر نیاز"
  },
  {
    "poem_id": 1508,
    "vorder": 33,
    "position": 0,
    "text": "چو دانی که بر تو نماند جهان"
  },
  {
    "poem_id": 1508,
    "vorder": 34,
    "position": 1,
    "text": "چه پیچی تو زان جای نوشین روان"
  },
  {
    "poem_id": 1508,
    "vorder": 35,
    "position": 0,
    "text": "بخور آنچه داری و بیشی مجوی"
  },
  {
    "poem_id": 1508,
    "vorder": 36,
    "position": 1,
    "text": "که از آز کاهد همی آبروی"
  }
]