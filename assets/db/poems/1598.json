[
  {
    "poem_id": 1598,
    "vorder": 1,
    "position": 0,
    "text": "کمان برگرفتند و تیر خدنگ"
  },
  {
    "poem_id": 1598,
    "vorder": 2,
    "position": 1,
    "text": "ببردند از روی خورشید رنگ"
  },
  {
    "poem_id": 1598,
    "vorder": 3,
    "position": 0,
    "text": "ز پیکان همی آتش افروختند"
  },
  {
    "poem_id": 1598,
    "vorder": 4,
    "position": 1,
    "text": "به بر بر زره را همی دوختند"
  },
  {
    "poem_id": 1598,
    "vorder": 5,
    "position": 0,
    "text": "دل شاه ایران بدان تنگ شد"
  },
  {
    "poem_id": 1598,
    "vorder": 6,
    "position": 1,
    "text": "بروها و چهرش پر آژنگ شد"
  },
  {
    "poem_id": 1598,
    "vorder": 7,
    "position": 0,
    "text": "چو او دست بردی به سوی کمان"
  },
  {
    "poem_id": 1598,
    "vorder": 8,
    "position": 1,
    "text": "نرستی کس از تیر او بی‌گمان"
  },
  {
    "poem_id": 1598,
    "vorder": 9,
    "position": 0,
    "text": "به رنگ طبرخون شدی این جهان"
  },
  {
    "poem_id": 1598,
    "vorder": 10,
    "position": 1,
    "text": "شدی آفتاب از نهیبش نهان"
  },
  {
    "poem_id": 1598,
    "vorder": 11,
    "position": 0,
    "text": "یکی چرخ را برکشید از شگاع"
  },
  {
    "poem_id": 1598,
    "vorder": 12,
    "position": 1,
    "text": "تو گفتی که خورشید شد در شراع"
  },
  {
    "poem_id": 1598,
    "vorder": 13,
    "position": 0,
    "text": "به تیری که پیکانش الماس بود"
  },
  {
    "poem_id": 1598,
    "vorder": 14,
    "position": 1,
    "text": "زره پیش او همچو قرطاس بود"
  },
  {
    "poem_id": 1598,
    "vorder": 15,
    "position": 0,
    "text": "چو او از کمان تیر بگشاد شست"
  },
  {
    "poem_id": 1598,
    "vorder": 16,
    "position": 1,
    "text": "تن رستم و رخش جنگی بخست"
  },
  {
    "poem_id": 1598,
    "vorder": 17,
    "position": 0,
    "text": "بر رخش ازان تیرها گشت سست"
  },
  {
    "poem_id": 1598,
    "vorder": 18,
    "position": 1,
    "text": "نبد باره و مرد جنگی درست"
  },
  {
    "poem_id": 1598,
    "vorder": 19,
    "position": 0,
    "text": "همی تاخت بر گردش اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 20,
    "position": 1,
    "text": "نیامد برو تیر رستم به کار"
  },
  {
    "poem_id": 1598,
    "vorder": 21,
    "position": 0,
    "text": "فرود آمد از رخش رستم چو باد"
  },
  {
    "poem_id": 1598,
    "vorder": 22,
    "position": 1,
    "text": "سر نامور سوی بالا نهاد"
  },
  {
    "poem_id": 1598,
    "vorder": 23,
    "position": 0,
    "text": "همان رخش رخشان سوی خانه شد"
  },
  {
    "poem_id": 1598,
    "vorder": 24,
    "position": 1,
    "text": "چنین با خداوند بیگانه شد"
  },
  {
    "poem_id": 1598,
    "vorder": 25,
    "position": 0,
    "text": "به بالا ز رستم همی رفت خون"
  },
  {
    "poem_id": 1598,
    "vorder": 26,
    "position": 1,
    "text": "بشد سست و لرزان که بیستون"
  },
  {
    "poem_id": 1598,
    "vorder": 27,
    "position": 0,
    "text": "بخندید چون دیدش اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 28,
    "position": 1,
    "text": "بدو گفت کای رستم نامدار"
  },
  {
    "poem_id": 1598,
    "vorder": 29,
    "position": 0,
    "text": "چرا گم شد آن نیروی پیل مست"
  },
  {
    "poem_id": 1598,
    "vorder": 30,
    "position": 1,
    "text": "ز پیکان چرا پیل جنگی بخست"
  },
  {
    "poem_id": 1598,
    "vorder": 31,
    "position": 0,
    "text": "کجا رفت آن مردی و گرز تو"
  },
  {
    "poem_id": 1598,
    "vorder": 32,
    "position": 1,
    "text": "به رزم اندرون فره و برز تو"
  },
  {
    "poem_id": 1598,
    "vorder": 33,
    "position": 0,
    "text": "گریزان به بالا چرا برشدی"
  },
  {
    "poem_id": 1598,
    "vorder": 34,
    "position": 1,
    "text": "چو آواز شیر ژیان بشندی"
  },
  {
    "poem_id": 1598,
    "vorder": 35,
    "position": 0,
    "text": "چرا پیل جنگی چو روباه گشت"
  },
  {
    "poem_id": 1598,
    "vorder": 36,
    "position": 1,
    "text": "ز رزمت چنین دست کوتاه گشت"
  },
  {
    "poem_id": 1598,
    "vorder": 37,
    "position": 0,
    "text": "تو آنی که دیو از تو گریان شدی"
  },
  {
    "poem_id": 1598,
    "vorder": 38,
    "position": 1,
    "text": "دد از تف تیغ تو بریان شدی"
  },
  {
    "poem_id": 1598,
    "vorder": 39,
    "position": 0,
    "text": "زواره پی رخش ناگه بدید"
  },
  {
    "poem_id": 1598,
    "vorder": 40,
    "position": 1,
    "text": "کزان رود با خستگی در کشید"
  },
  {
    "poem_id": 1598,
    "vorder": 41,
    "position": 0,
    "text": "سیه شد جهان پیش چشمش به رنگ"
  },
  {
    "poem_id": 1598,
    "vorder": 42,
    "position": 1,
    "text": "خروشان همی تاخت تا جای جنگ"
  },
  {
    "poem_id": 1598,
    "vorder": 43,
    "position": 0,
    "text": "تن مرد جنگی چنان خسته دید"
  },
  {
    "poem_id": 1598,
    "vorder": 44,
    "position": 1,
    "text": "همه خستگیهاش نابسته دید"
  },
  {
    "poem_id": 1598,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت خیز اسپ من برنشین"
  },
  {
    "poem_id": 1598,
    "vorder": 46,
    "position": 1,
    "text": "که پوشد ز بهر تو خفتان کین"
  },
  {
    "poem_id": 1598,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت رو پیش دستان بگوی"
  },
  {
    "poem_id": 1598,
    "vorder": 48,
    "position": 1,
    "text": "کزین دودهٔ سام شد رنگ و بوی"
  },
  {
    "poem_id": 1598,
    "vorder": 49,
    "position": 0,
    "text": "نگه کن که تا چارهٔ کار چیست"
  },
  {
    "poem_id": 1598,
    "vorder": 50,
    "position": 1,
    "text": "برین خستگیها بر آزار کیست"
  },
  {
    "poem_id": 1598,
    "vorder": 51,
    "position": 0,
    "text": "که گر من ز پیکان اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 52,
    "position": 1,
    "text": "شبی را سرآرم بدین روزگار"
  },
  {
    "poem_id": 1598,
    "vorder": 53,
    "position": 0,
    "text": "چنان دانم ای زال کامروز من"
  },
  {
    "poem_id": 1598,
    "vorder": 54,
    "position": 1,
    "text": "ز مادر بزادم بدین انجمن"
  },
  {
    "poem_id": 1598,
    "vorder": 55,
    "position": 0,
    "text": "چو رفتی همی چارهٔ رخش ساز"
  },
  {
    "poem_id": 1598,
    "vorder": 56,
    "position": 1,
    "text": "من آیم کنون گر بمانم دراز"
  },
  {
    "poem_id": 1598,
    "vorder": 57,
    "position": 0,
    "text": "زواره ز پیش برادر برفت"
  },
  {
    "poem_id": 1598,
    "vorder": 58,
    "position": 1,
    "text": "دو دیده سوی رخش بنهاد تفت"
  },
  {
    "poem_id": 1598,
    "vorder": 59,
    "position": 0,
    "text": "به پستی همی بود اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 60,
    "position": 1,
    "text": "خروشید کای رستم نامدار"
  },
  {
    "poem_id": 1598,
    "vorder": 61,
    "position": 0,
    "text": "به بالا چنین چند باشی به پای"
  },
  {
    "poem_id": 1598,
    "vorder": 62,
    "position": 1,
    "text": "که خواهد بدن مر ترا رهنمای"
  },
  {
    "poem_id": 1598,
    "vorder": 63,
    "position": 0,
    "text": "کمان بفگن از دست و ببر بیان"
  },
  {
    "poem_id": 1598,
    "vorder": 64,
    "position": 1,
    "text": "برآهنج و بگشای تیغ از میان"
  },
  {
    "poem_id": 1598,
    "vorder": 65,
    "position": 0,
    "text": "پشیمان شو و دست را ده به بند"
  },
  {
    "poem_id": 1598,
    "vorder": 66,
    "position": 1,
    "text": "کزین پس تو از من نیابی گزند"
  },
  {
    "poem_id": 1598,
    "vorder": 67,
    "position": 0,
    "text": "بدین خستگی نزد شاهت برم"
  },
  {
    "poem_id": 1598,
    "vorder": 68,
    "position": 1,
    "text": "ز کردارها بی‌گناهت برم"
  },
  {
    "poem_id": 1598,
    "vorder": 69,
    "position": 0,
    "text": "وگر جنگ جویی تو اندرز کن"
  },
  {
    "poem_id": 1598,
    "vorder": 70,
    "position": 1,
    "text": "یکی را نگهبان این مرز کن"
  },
  {
    "poem_id": 1598,
    "vorder": 71,
    "position": 0,
    "text": "گناهی که کردی ز یزدان بخواه"
  },
  {
    "poem_id": 1598,
    "vorder": 72,
    "position": 1,
    "text": "سزد گر به پوزش ببخشد گناه"
  },
  {
    "poem_id": 1598,
    "vorder": 73,
    "position": 0,
    "text": "مگر دادگر باشدت رهنمای"
  },
  {
    "poem_id": 1598,
    "vorder": 74,
    "position": 1,
    "text": "چو بیرون شوی زین سپنجی سرای"
  },
  {
    "poem_id": 1598,
    "vorder": 75,
    "position": 0,
    "text": "چنین گفت رستم که بیگاه شد"
  },
  {
    "poem_id": 1598,
    "vorder": 76,
    "position": 1,
    "text": "ز رزم و ز بد دست کوتاه شد"
  },
  {
    "poem_id": 1598,
    "vorder": 77,
    "position": 0,
    "text": "شب تیره هرگز که جوید نبرد"
  },
  {
    "poem_id": 1598,
    "vorder": 78,
    "position": 1,
    "text": "تو اکنون بدین رامشی بازگرد"
  },
  {
    "poem_id": 1598,
    "vorder": 79,
    "position": 0,
    "text": "من اکنون چنین سوی ایوان شوم"
  },
  {
    "poem_id": 1598,
    "vorder": 80,
    "position": 1,
    "text": "بیاسایم و یک زمان بغنوم"
  },
  {
    "poem_id": 1598,
    "vorder": 81,
    "position": 0,
    "text": "ببندم همه خستگیهای خویش"
  },
  {
    "poem_id": 1598,
    "vorder": 82,
    "position": 1,
    "text": "بخوانم کسی را که دارم به پیش"
  },
  {
    "poem_id": 1598,
    "vorder": 83,
    "position": 0,
    "text": "زواره فرامرز و دستان سام"
  },
  {
    "poem_id": 1598,
    "vorder": 84,
    "position": 1,
    "text": "کسی را ز خویشان که دارند نام"
  },
  {
    "poem_id": 1598,
    "vorder": 85,
    "position": 0,
    "text": "بسازم کنون هرچ فرمان تست"
  },
  {
    "poem_id": 1598,
    "vorder": 86,
    "position": 1,
    "text": "همه راستی زیر پیمان تست"
  },
  {
    "poem_id": 1598,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت رویین تن اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 88,
    "position": 1,
    "text": "که ای برمنش پیر ناسازگار"
  },
  {
    "poem_id": 1598,
    "vorder": 89,
    "position": 0,
    "text": "تو مردی بزرگی و زور آزمای"
  },
  {
    "poem_id": 1598,
    "vorder": 90,
    "position": 1,
    "text": "بسی چاره دانی و نیرنگ و رای"
  },
  {
    "poem_id": 1598,
    "vorder": 91,
    "position": 0,
    "text": "بدیدم همه فر و زیب ترا"
  },
  {
    "poem_id": 1598,
    "vorder": 92,
    "position": 1,
    "text": "نخواهم که بینم نشیب ترا"
  },
  {
    "poem_id": 1598,
    "vorder": 93,
    "position": 0,
    "text": "به جان امشبی دادمت زینهار"
  },
  {
    "poem_id": 1598,
    "vorder": 94,
    "position": 1,
    "text": "به ایوان رسی کام کژی مخار"
  },
  {
    "poem_id": 1598,
    "vorder": 95,
    "position": 0,
    "text": "سخن هرچ پذرفتی آن را بکن"
  },
  {
    "poem_id": 1598,
    "vorder": 96,
    "position": 1,
    "text": "ازین پس مپیمای با من سخن"
  },
  {
    "poem_id": 1598,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت رستم که ایدون کنم"
  },
  {
    "poem_id": 1598,
    "vorder": 98,
    "position": 1,
    "text": "چو بر خستگیها بر افسون کنم"
  },
  {
    "poem_id": 1598,
    "vorder": 99,
    "position": 0,
    "text": "چو برگشت از رستم اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 100,
    "position": 1,
    "text": "نگه کرد تا چون رود نامدار"
  },
  {
    "poem_id": 1598,
    "vorder": 101,
    "position": 0,
    "text": "چو بگذشت مانند کشتی به رود"
  },
  {
    "poem_id": 1598,
    "vorder": 102,
    "position": 1,
    "text": "همی داد تن را ز یزدان درود"
  },
  {
    "poem_id": 1598,
    "vorder": 103,
    "position": 0,
    "text": "همی گفت کای داور داد و پاک"
  },
  {
    "poem_id": 1598,
    "vorder": 104,
    "position": 1,
    "text": "گر از خستگیها شوم من هلاک"
  },
  {
    "poem_id": 1598,
    "vorder": 105,
    "position": 0,
    "text": "که خواهد ز گردنکشان کین من"
  },
  {
    "poem_id": 1598,
    "vorder": 106,
    "position": 1,
    "text": "که گیرد دل و راه و آیین من"
  },
  {
    "poem_id": 1598,
    "vorder": 107,
    "position": 0,
    "text": "چو اسفندیار از پسش بنگرید"
  },
  {
    "poem_id": 1598,
    "vorder": 108,
    "position": 1,
    "text": "بران روی رودش به خشکی بدید"
  },
  {
    "poem_id": 1598,
    "vorder": 109,
    "position": 0,
    "text": "همی گفت کین را مخوانید مرد"
  },
  {
    "poem_id": 1598,
    "vorder": 110,
    "position": 1,
    "text": "یکی ژنده پیلست با دار و برد"
  },
  {
    "poem_id": 1598,
    "vorder": 111,
    "position": 0,
    "text": "گذر کرد پر خستگیها بر آب"
  },
  {
    "poem_id": 1598,
    "vorder": 112,
    "position": 1,
    "text": "ازان زخم پیکان شده پرشتاب"
  },
  {
    "poem_id": 1598,
    "vorder": 113,
    "position": 0,
    "text": "شگفتی بمانده بد اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 114,
    "position": 1,
    "text": "همی گفت کای داور کامگار"
  },
  {
    "poem_id": 1598,
    "vorder": 115,
    "position": 0,
    "text": "چنان آفریدی که خود خواستی"
  },
  {
    "poem_id": 1598,
    "vorder": 116,
    "position": 1,
    "text": "زمان و زمین را بیاراستی"
  },
  {
    "poem_id": 1598,
    "vorder": 117,
    "position": 0,
    "text": "بدانگه که شد نامور باز جای"
  },
  {
    "poem_id": 1598,
    "vorder": 118,
    "position": 1,
    "text": "پشوتن بیامد ز پرده‌سرای"
  },
  {
    "poem_id": 1598,
    "vorder": 119,
    "position": 0,
    "text": "ز نوش‌آذر گرد وز مهر نوش"
  },
  {
    "poem_id": 1598,
    "vorder": 120,
    "position": 1,
    "text": "خروشیدنی بود با درد و جوش"
  },
  {
    "poem_id": 1598,
    "vorder": 121,
    "position": 0,
    "text": "سراپردهٔ شاه پر خاک بود"
  },
  {
    "poem_id": 1598,
    "vorder": 122,
    "position": 1,
    "text": "همه جامهٔ مهتران چاک بود"
  },
  {
    "poem_id": 1598,
    "vorder": 123,
    "position": 0,
    "text": "فرود آمد از باره اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 124,
    "position": 1,
    "text": "نهاد آن سر سرکشان برکنار"
  },
  {
    "poem_id": 1598,
    "vorder": 125,
    "position": 0,
    "text": "همی گفت زارا دو گرد جوان"
  },
  {
    "poem_id": 1598,
    "vorder": 126,
    "position": 1,
    "text": "که جانتان شد از کالبد با توان"
  },
  {
    "poem_id": 1598,
    "vorder": 127,
    "position": 0,
    "text": "چنین گفت پس با پشوتن که خیز"
  },
  {
    "poem_id": 1598,
    "vorder": 128,
    "position": 1,
    "text": "برین کشتگان آب چندین مریز"
  },
  {
    "poem_id": 1598,
    "vorder": 129,
    "position": 0,
    "text": "که سودی نبینم ز خون ریختن"
  },
  {
    "poem_id": 1598,
    "vorder": 130,
    "position": 1,
    "text": "نشاید به مرگ اندر آویختن"
  },
  {
    "poem_id": 1598,
    "vorder": 131,
    "position": 0,
    "text": "همه مرگ راایم برنا و پیر"
  },
  {
    "poem_id": 1598,
    "vorder": 132,
    "position": 1,
    "text": "به رفتن خرد بادمان دستگیر"
  },
  {
    "poem_id": 1598,
    "vorder": 133,
    "position": 0,
    "text": "به تابوت زرین و در مهد ساج"
  },
  {
    "poem_id": 1598,
    "vorder": 134,
    "position": 1,
    "text": "فرستادشان زی خداوند تاج"
  },
  {
    "poem_id": 1598,
    "vorder": 135,
    "position": 0,
    "text": "پیامی فرستاد نزد پدر"
  },
  {
    "poem_id": 1598,
    "vorder": 136,
    "position": 1,
    "text": "که آن شاخ رای تو آمد به بر"
  },
  {
    "poem_id": 1598,
    "vorder": 137,
    "position": 0,
    "text": "تو کشتی به آب اندر انداختی"
  },
  {
    "poem_id": 1598,
    "vorder": 138,
    "position": 1,
    "text": "ز رستم همی چاکری ساختی"
  },
  {
    "poem_id": 1598,
    "vorder": 139,
    "position": 0,
    "text": "چو تابوت نوش‌آذر و مهرنوش"
  },
  {
    "poem_id": 1598,
    "vorder": 140,
    "position": 1,
    "text": "ببینی تو در آز چندین مکوش"
  },
  {
    "poem_id": 1598,
    "vorder": 141,
    "position": 0,
    "text": "به چرم اندر است گاو اسفندیار"
  },
  {
    "poem_id": 1598,
    "vorder": 142,
    "position": 1,
    "text": "ندانم چه راند بدو روزگار"
  },
  {
    "poem_id": 1598,
    "vorder": 143,
    "position": 0,
    "text": "نشست از بر تخت با سوک و درد"
  },
  {
    "poem_id": 1598,
    "vorder": 144,
    "position": 1,
    "text": "سخنهای رستم همه یادکرد"
  },
  {
    "poem_id": 1598,
    "vorder": 145,
    "position": 0,
    "text": "چنین گفت پس با پشوتن که شیر"
  },
  {
    "poem_id": 1598,
    "vorder": 146,
    "position": 1,
    "text": "بپیچد ز چنگال مرد دلیر"
  },
  {
    "poem_id": 1598,
    "vorder": 147,
    "position": 0,
    "text": "به رستم نگه کردم امروز من"
  },
  {
    "poem_id": 1598,
    "vorder": 148,
    "position": 1,
    "text": "بران برز بالای آن پیلتن"
  },
  {
    "poem_id": 1598,
    "vorder": 149,
    "position": 0,
    "text": "ستایش گرفتم به یزدان پاک"
  },
  {
    "poem_id": 1598,
    "vorder": 150,
    "position": 1,
    "text": "کزویست امید و زو بیم و باک"
  },
  {
    "poem_id": 1598,
    "vorder": 151,
    "position": 0,
    "text": "که پروردگار آن چنان آفرید"
  },
  {
    "poem_id": 1598,
    "vorder": 152,
    "position": 1,
    "text": "بران آفرین کو جهان آفرید"
  },
  {
    "poem_id": 1598,
    "vorder": 153,
    "position": 0,
    "text": "چنین کارها رفت بر دست او"
  },
  {
    "poem_id": 1598,
    "vorder": 154,
    "position": 1,
    "text": "که دریای چین بود تا شست او"
  },
  {
    "poem_id": 1598,
    "vorder": 155,
    "position": 0,
    "text": "همی برکشیدی ز دریا نهنگ"
  },
  {
    "poem_id": 1598,
    "vorder": 156,
    "position": 1,
    "text": "به دم در کشیدی ز هامون پلنگ"
  },
  {
    "poem_id": 1598,
    "vorder": 157,
    "position": 0,
    "text": "بران سان بخستم تنش را به تیر"
  },
  {
    "poem_id": 1598,
    "vorder": 158,
    "position": 1,
    "text": "که از خون او خاک شد آبگیر"
  },
  {
    "poem_id": 1598,
    "vorder": 159,
    "position": 0,
    "text": "ز بالا پیاده به پیمان برفت"
  },
  {
    "poem_id": 1598,
    "vorder": 160,
    "position": 1,
    "text": "سوی رود با گبر و شمشیر تفت"
  },
  {
    "poem_id": 1598,
    "vorder": 161,
    "position": 0,
    "text": "برآمد چنان خسته زان آبگیر"
  },
  {
    "poem_id": 1598,
    "vorder": 162,
    "position": 1,
    "text": "سراسر تنش پر ز پیکان تیر"
  },
  {
    "poem_id": 1598,
    "vorder": 163,
    "position": 0,
    "text": "برآنم که چون او به ایوان رسد"
  },
  {
    "poem_id": 1598,
    "vorder": 164,
    "position": 1,
    "text": "روانش ز ایوان به کیوان رسد"
  }
]