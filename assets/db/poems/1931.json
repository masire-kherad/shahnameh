[
  {
    "poem_id": 1931,
    "vorder": 1,
    "position": 0,
    "text": "یکی نامه بنوشت دیگر بطوس"
  },
  {
    "poem_id": 1931,
    "vorder": 2,
    "position": 1,
    "text": "پر از خون دل و روی چون سندروس"
  },
  {
    "poem_id": 1931,
    "vorder": 3,
    "position": 0,
    "text": "نخست آفرین کرد بر دادگر"
  },
  {
    "poem_id": 1931,
    "vorder": 4,
    "position": 1,
    "text": "کزو دید نیرو و بخت و هنر"
  },
  {
    "poem_id": 1931,
    "vorder": 5,
    "position": 0,
    "text": "خداوند پیروزی و فرهی"
  },
  {
    "poem_id": 1931,
    "vorder": 6,
    "position": 1,
    "text": "خداوند دیهیم شاهنشهی"
  },
  {
    "poem_id": 1931,
    "vorder": 7,
    "position": 0,
    "text": "پی پشه تا پر و چنگ عقاب"
  },
  {
    "poem_id": 1931,
    "vorder": 8,
    "position": 1,
    "text": "به خشکی چو پیل و نهنگ اندر آب"
  },
  {
    "poem_id": 1931,
    "vorder": 9,
    "position": 0,
    "text": "ز پیمان و فرمان او نگذرد"
  },
  {
    "poem_id": 1931,
    "vorder": 10,
    "position": 1,
    "text": "دم خویش بی رای او نشمرد"
  },
  {
    "poem_id": 1931,
    "vorder": 11,
    "position": 0,
    "text": "ز شاه جهان یزدگرد بزرگ"
  },
  {
    "poem_id": 1931,
    "vorder": 12,
    "position": 1,
    "text": "پدر نامور شهریار سترگ"
  },
  {
    "poem_id": 1931,
    "vorder": 13,
    "position": 0,
    "text": "سپهدار یزدان پیروزگر"
  },
  {
    "poem_id": 1931,
    "vorder": 14,
    "position": 1,
    "text": "نگهبان جنبده و بوم و بر"
  },
  {
    "poem_id": 1931,
    "vorder": 15,
    "position": 0,
    "text": "ز تخم بزرگان یزدان‌شناس"
  },
  {
    "poem_id": 1931,
    "vorder": 16,
    "position": 1,
    "text": "که از تاج دارند از اختر سپاس"
  },
  {
    "poem_id": 1931,
    "vorder": 17,
    "position": 0,
    "text": "کزیشان شد آباد روی زمین"
  },
  {
    "poem_id": 1931,
    "vorder": 18,
    "position": 1,
    "text": "فروزندهٔ تاج و تخت و نگین"
  },
  {
    "poem_id": 1931,
    "vorder": 19,
    "position": 0,
    "text": "سوی مرزبانان با گنج و گاه"
  },
  {
    "poem_id": 1931,
    "vorder": 20,
    "position": 1,
    "text": "که با فر و برزند و با داد و راه"
  },
  {
    "poem_id": 1931,
    "vorder": 21,
    "position": 0,
    "text": "شمیران و رویین‌دژ و رابه‌کوه"
  },
  {
    "poem_id": 1931,
    "vorder": 22,
    "position": 1,
    "text": "کلات از دگر دست و دیگر گروه"
  },
  {
    "poem_id": 1931,
    "vorder": 23,
    "position": 0,
    "text": "نگهبان ما باد پروردگار"
  },
  {
    "poem_id": 1931,
    "vorder": 24,
    "position": 1,
    "text": "شما بی‌گزند از بد روزگار"
  },
  {
    "poem_id": 1931,
    "vorder": 25,
    "position": 0,
    "text": "مبادا گزند سپهر بلند"
  },
  {
    "poem_id": 1931,
    "vorder": 26,
    "position": 1,
    "text": "مه پیکار آهرمن پرگزند"
  },
  {
    "poem_id": 1931,
    "vorder": 27,
    "position": 0,
    "text": "همانا شنیدند گردنکشان"
  },
  {
    "poem_id": 1931,
    "vorder": 28,
    "position": 1,
    "text": "خنیده شد اندر جهان این نشان"
  },
  {
    "poem_id": 1931,
    "vorder": 29,
    "position": 0,
    "text": "که بر کارزاری و مرد نژاد"
  },
  {
    "poem_id": 1931,
    "vorder": 30,
    "position": 1,
    "text": "دل ما پر‌آزرم و مهرست و داد"
  },
  {
    "poem_id": 1931,
    "vorder": 31,
    "position": 0,
    "text": "به ویژه نژاد شما را که رنج"
  },
  {
    "poem_id": 1931,
    "vorder": 32,
    "position": 1,
    "text": "فزونست نزدیک شاهان ز گنج"
  },
  {
    "poem_id": 1931,
    "vorder": 33,
    "position": 0,
    "text": "چو بهرام چوبینه آمد پدید"
  },
  {
    "poem_id": 1931,
    "vorder": 34,
    "position": 1,
    "text": "ز فرمان دیهیم ما سرکشید"
  },
  {
    "poem_id": 1931,
    "vorder": 35,
    "position": 0,
    "text": "شما را دل از شهرهای فراخ"
  },
  {
    "poem_id": 1931,
    "vorder": 36,
    "position": 1,
    "text": "بپیچید وز باغ و میدان و کاخ"
  },
  {
    "poem_id": 1931,
    "vorder": 37,
    "position": 0,
    "text": "برین باستان راع و کوه بلند"
  },
  {
    "poem_id": 1931,
    "vorder": 38,
    "position": 1,
    "text": "کده ساختید از نهیب گزند"
  },
  {
    "poem_id": 1931,
    "vorder": 39,
    "position": 0,
    "text": "گر ای دون که نیرو دهد کردگار"
  },
  {
    "poem_id": 1931,
    "vorder": 40,
    "position": 1,
    "text": "به کام دل ما شود روزگار"
  },
  {
    "poem_id": 1931,
    "vorder": 41,
    "position": 0,
    "text": "ز پاداش نیکی فزایش کنیم"
  },
  {
    "poem_id": 1931,
    "vorder": 42,
    "position": 1,
    "text": "برین پیش‌دستی نیایش کنیم"
  },
  {
    "poem_id": 1931,
    "vorder": 43,
    "position": 0,
    "text": "همانا که آمد شما را خبر"
  },
  {
    "poem_id": 1931,
    "vorder": 44,
    "position": 1,
    "text": "که ما را چه آمد ز اختر به سر"
  },
  {
    "poem_id": 1931,
    "vorder": 45,
    "position": 0,
    "text": "ازین مارخوار اهرمن چهرگان"
  },
  {
    "poem_id": 1931,
    "vorder": 46,
    "position": 1,
    "text": "ز دانایی و شرم بی‌بهرگان"
  },
  {
    "poem_id": 1931,
    "vorder": 47,
    "position": 0,
    "text": "نه گنج و نه نام و نه تخت و نژاد"
  },
  {
    "poem_id": 1931,
    "vorder": 48,
    "position": 1,
    "text": "همی‌داد خواهند گیتی بباد"
  },
  {
    "poem_id": 1931,
    "vorder": 49,
    "position": 0,
    "text": "بسی گنج و گوهر پراگنده شد"
  },
  {
    "poem_id": 1931,
    "vorder": 50,
    "position": 1,
    "text": "بسی سر به خاک اندر آگنده شد"
  },
  {
    "poem_id": 1931,
    "vorder": 51,
    "position": 0,
    "text": "چنین گشت پرگار چرخ بلند"
  },
  {
    "poem_id": 1931,
    "vorder": 52,
    "position": 1,
    "text": "که آید بدین پادشاهی گزند"
  },
  {
    "poem_id": 1931,
    "vorder": 53,
    "position": 0,
    "text": "ازین زاغ‌ساران بی‌آب و رنگ"
  },
  {
    "poem_id": 1931,
    "vorder": 54,
    "position": 1,
    "text": "نه هوش و نه دانش نه نام و نه ننگ"
  },
  {
    "poem_id": 1931,
    "vorder": 55,
    "position": 0,
    "text": "که نوشین‌روان دیده بود این به خواب"
  },
  {
    "poem_id": 1931,
    "vorder": 56,
    "position": 1,
    "text": "کزین تخت بپراگند رنگ و آب"
  },
  {
    "poem_id": 1931,
    "vorder": 57,
    "position": 0,
    "text": "چنان دید کز تازیان صدهزار"
  },
  {
    "poem_id": 1931,
    "vorder": 58,
    "position": 1,
    "text": "هیونان مست و گسسته مهار"
  },
  {
    "poem_id": 1931,
    "vorder": 59,
    "position": 0,
    "text": "گذر یافتندی به اروند‌رود"
  },
  {
    "poem_id": 1931,
    "vorder": 60,
    "position": 1,
    "text": "نماندی برین بوم بر تار و پود"
  },
  {
    "poem_id": 1931,
    "vorder": 61,
    "position": 0,
    "text": "به ایران و بابل نه کشت و درود"
  },
  {
    "poem_id": 1931,
    "vorder": 62,
    "position": 1,
    "text": "به چرخ زحل برشدی تیره‌دود"
  },
  {
    "poem_id": 1931,
    "vorder": 63,
    "position": 0,
    "text": "هم آتش بمُردی به آتشکده"
  },
  {
    "poem_id": 1931,
    "vorder": 64,
    "position": 1,
    "text": "شدی تیره نوروز و جشن سده"
  },
  {
    "poem_id": 1931,
    "vorder": 65,
    "position": 0,
    "text": "از ایوان شاه جهان کنگره"
  },
  {
    "poem_id": 1931,
    "vorder": 66,
    "position": 1,
    "text": "فتادی به میدان او یکسره"
  },
  {
    "poem_id": 1931,
    "vorder": 67,
    "position": 0,
    "text": "کنون خواب را پاسخ آمد پدید"
  },
  {
    "poem_id": 1931,
    "vorder": 68,
    "position": 1,
    "text": "ز ما بخت گردن بخواهد کشید"
  },
  {
    "poem_id": 1931,
    "vorder": 69,
    "position": 0,
    "text": "شود خوار هر کس که هست ارجمند"
  },
  {
    "poem_id": 1931,
    "vorder": 70,
    "position": 1,
    "text": "فرومایه را بخت گردد بلند"
  },
  {
    "poem_id": 1931,
    "vorder": 71,
    "position": 0,
    "text": "پراگنده گردد بدی در جهان"
  },
  {
    "poem_id": 1931,
    "vorder": 72,
    "position": 1,
    "text": "گزند آشکارا و خوبی نهان"
  },
  {
    "poem_id": 1931,
    "vorder": 73,
    "position": 0,
    "text": "بهَر کشوری در ستمگاره‌ای"
  },
  {
    "poem_id": 1931,
    "vorder": 74,
    "position": 1,
    "text": "پدید آید و زشت پتیاره‌ای"
  },
  {
    "poem_id": 1931,
    "vorder": 75,
    "position": 0,
    "text": "نشان شب تیره آمد پدید"
  },
  {
    "poem_id": 1931,
    "vorder": 76,
    "position": 1,
    "text": "همی روشنایی بخواهد پرید"
  },
  {
    "poem_id": 1931,
    "vorder": 77,
    "position": 0,
    "text": "کنون ما به دستوری رهنمای"
  },
  {
    "poem_id": 1931,
    "vorder": 78,
    "position": 1,
    "text": "همه پهلوانان پاکیزه‌رای"
  },
  {
    "poem_id": 1931,
    "vorder": 79,
    "position": 0,
    "text": "به سوی خراسان نهادیم روی"
  },
  {
    "poem_id": 1931,
    "vorder": 80,
    "position": 1,
    "text": "برِ مرزبانان دیهیم‌جوی"
  },
  {
    "poem_id": 1931,
    "vorder": 81,
    "position": 0,
    "text": "ببینیم تا گردش روزگار"
  },
  {
    "poem_id": 1931,
    "vorder": 82,
    "position": 1,
    "text": "چه گوید بدین رای نا‌استوار"
  },
  {
    "poem_id": 1931,
    "vorder": 83,
    "position": 0,
    "text": "پس اکنون ز بهر کنارنگ طوس"
  },
  {
    "poem_id": 1931,
    "vorder": 84,
    "position": 1,
    "text": "بدین سو کشیدیم پیلان و کوس"
  },
  {
    "poem_id": 1931,
    "vorder": 85,
    "position": 0,
    "text": "فرخ‌زاد با ما ز یک پوستست"
  },
  {
    "poem_id": 1931,
    "vorder": 86,
    "position": 1,
    "text": "به پیوستگی نیز هم دوستست"
  },
  {
    "poem_id": 1931,
    "vorder": 87,
    "position": 0,
    "text": "بالتونیه‌ست او کنون رزمجوی"
  },
  {
    "poem_id": 1931,
    "vorder": 88,
    "position": 1,
    "text": "سوی جنگ دشمن نهادست روی"
  },
  {
    "poem_id": 1931,
    "vorder": 89,
    "position": 0,
    "text": "کنون کشمگان پور آن رزمخواه"
  },
  {
    "poem_id": 1931,
    "vorder": 90,
    "position": 1,
    "text": "بر ما بیامد بدین بارگاه"
  },
  {
    "poem_id": 1931,
    "vorder": 91,
    "position": 0,
    "text": "بگفت آنچ آمد ز شایستگی"
  },
  {
    "poem_id": 1931,
    "vorder": 92,
    "position": 1,
    "text": "هم از بندگی هم ز بایستگی"
  },
  {
    "poem_id": 1931,
    "vorder": 93,
    "position": 0,
    "text": "شیندیم زین مرزها هرچ گفت"
  },
  {
    "poem_id": 1931,
    "vorder": 94,
    "position": 1,
    "text": "بلندی و پستی و غار و نهفت"
  },
  {
    "poem_id": 1931,
    "vorder": 95,
    "position": 0,
    "text": "دژ گنبدین کوه تا خرمنه"
  },
  {
    "poem_id": 1931,
    "vorder": 96,
    "position": 1,
    "text": "دگر لاژوردین ز بهر بنه"
  },
  {
    "poem_id": 1931,
    "vorder": 97,
    "position": 0,
    "text": "ز هر گونه بنمود آن دل گسل"
  },
  {
    "poem_id": 1931,
    "vorder": 98,
    "position": 1,
    "text": "ز خوبی نمود آنچ بودش به دل"
  },
  {
    "poem_id": 1931,
    "vorder": 99,
    "position": 0,
    "text": "وزین جایگه شد بهَر جای کس"
  },
  {
    "poem_id": 1931,
    "vorder": 100,
    "position": 1,
    "text": "پژوهنده شد کارها پیش و پس"
  },
  {
    "poem_id": 1931,
    "vorder": 101,
    "position": 0,
    "text": "چنین لشکری گشن ما را که هست"
  },
  {
    "poem_id": 1931,
    "vorder": 102,
    "position": 1,
    "text": "برین تنگ‌دژها نشاید نشست"
  },
  {
    "poem_id": 1931,
    "vorder": 103,
    "position": 0,
    "text": "نشستیم و گفتنیم با رای‌زن"
  },
  {
    "poem_id": 1931,
    "vorder": 104,
    "position": 1,
    "text": "همه پهلوانان شدند انجمن"
  },
  {
    "poem_id": 1931,
    "vorder": 105,
    "position": 0,
    "text": "ز هر گونه گفتیم و انداختیم"
  },
  {
    "poem_id": 1931,
    "vorder": 106,
    "position": 1,
    "text": "سرانجام یکسر برین ساختیم"
  },
  {
    "poem_id": 1931,
    "vorder": 107,
    "position": 0,
    "text": "که از تاج و ز تخت و مهر و نگین"
  },
  {
    "poem_id": 1931,
    "vorder": 108,
    "position": 1,
    "text": "همان جامهٔ روم و کشمیر و چین"
  },
  {
    "poem_id": 1931,
    "vorder": 109,
    "position": 0,
    "text": "ز پرمایه چیزی که آمد بدست"
  },
  {
    "poem_id": 1931,
    "vorder": 110,
    "position": 1,
    "text": "ز روم و ز طایف همه هرچ هست"
  },
  {
    "poem_id": 1931,
    "vorder": 111,
    "position": 0,
    "text": "همان هرچه از ما پراگند نیست"
  },
  {
    "poem_id": 1931,
    "vorder": 112,
    "position": 1,
    "text": "گر از پوشش است ار ز افگندنیست"
  },
  {
    "poem_id": 1931,
    "vorder": 113,
    "position": 0,
    "text": "ز زرینه و جامهٔ نابرید"
  },
  {
    "poem_id": 1931,
    "vorder": 114,
    "position": 1,
    "text": "ز چیزی که آن را نشاید کشید"
  },
  {
    "poem_id": 1931,
    "vorder": 115,
    "position": 0,
    "text": "هم از خوردنیها ز هر گونه ساز"
  },
  {
    "poem_id": 1931,
    "vorder": 116,
    "position": 1,
    "text": "که ما را بیاید برو بر نیاز"
  },
  {
    "poem_id": 1931,
    "vorder": 117,
    "position": 0,
    "text": "ز گاوان گردون‌کشان چل‌هزار"
  },
  {
    "poem_id": 1931,
    "vorder": 118,
    "position": 1,
    "text": "که رنج آورد تا که آید به کار"
  },
  {
    "poem_id": 1931,
    "vorder": 119,
    "position": 0,
    "text": "به خروار زان پس ده و دو هزار"
  },
  {
    "poem_id": 1931,
    "vorder": 120,
    "position": 1,
    "text": "به خوشه درون گندم آرد ببار"
  },
  {
    "poem_id": 1931,
    "vorder": 121,
    "position": 0,
    "text": "همان ارزن و پسته و ناردان"
  },
  {
    "poem_id": 1931,
    "vorder": 122,
    "position": 1,
    "text": "بیارد یکی موبدی کاردان"
  },
  {
    "poem_id": 1931,
    "vorder": 123,
    "position": 0,
    "text": "شتروار زین هر یکی ده‌هزار"
  },
  {
    "poem_id": 1931,
    "vorder": 124,
    "position": 1,
    "text": "هیونان بختی بیارند بار"
  },
  {
    "poem_id": 1931,
    "vorder": 125,
    "position": 0,
    "text": "همان گاو گردون هزار از نمک"
  },
  {
    "poem_id": 1931,
    "vorder": 126,
    "position": 1,
    "text": "بیارند تا بر چه گردد فلک"
  },
  {
    "poem_id": 1931,
    "vorder": 127,
    "position": 0,
    "text": "ز خرما هزار و ز شکر هزار"
  },
  {
    "poem_id": 1931,
    "vorder": 128,
    "position": 1,
    "text": "بود سخته و راست‌کرده شمار"
  },
  {
    "poem_id": 1931,
    "vorder": 129,
    "position": 0,
    "text": "ده و دو هزار انگبین کندره"
  },
  {
    "poem_id": 1931,
    "vorder": 130,
    "position": 1,
    "text": "بدژها کشند آن همه یکسره"
  },
  {
    "poem_id": 1931,
    "vorder": 131,
    "position": 0,
    "text": "نمک خورده سر پوست چون چل‌هزار"
  },
  {
    "poem_id": 1931,
    "vorder": 132,
    "position": 1,
    "text": "بیارند آن را که آید به کار"
  },
  {
    "poem_id": 1931,
    "vorder": 133,
    "position": 0,
    "text": "شتروار سیصد ز زربفت شاه"
  },
  {
    "poem_id": 1931,
    "vorder": 134,
    "position": 1,
    "text": "بیارند بر بارها تا دو ماه"
  },
  {
    "poem_id": 1931,
    "vorder": 135,
    "position": 0,
    "text": "بیاید یکی موبدی با گروه"
  },
  {
    "poem_id": 1931,
    "vorder": 136,
    "position": 1,
    "text": "ز گاه شمیران و از رابه‌کوه"
  },
  {
    "poem_id": 1931,
    "vorder": 137,
    "position": 0,
    "text": "به دیدار پیران و فرهنگیان"
  },
  {
    "poem_id": 1931,
    "vorder": 138,
    "position": 1,
    "text": "بزرگان که‌اَند از کنارنگیان"
  },
  {
    "poem_id": 1931,
    "vorder": 139,
    "position": 0,
    "text": "به دو روز نامه به دژها نهند"
  },
  {
    "poem_id": 1931,
    "vorder": 140,
    "position": 1,
    "text": "یکی نامه گنجور ما را دهند"
  },
  {
    "poem_id": 1931,
    "vorder": 141,
    "position": 0,
    "text": "دگر خود بدارند با خویشتن"
  },
  {
    "poem_id": 1931,
    "vorder": 142,
    "position": 1,
    "text": "بزرگان که باشند زان انجمن"
  },
  {
    "poem_id": 1931,
    "vorder": 143,
    "position": 0,
    "text": "همانا بران راغ و کوه بلند"
  },
  {
    "poem_id": 1931,
    "vorder": 144,
    "position": 1,
    "text": "ز ترک و ز تازی نیاید گزند"
  },
  {
    "poem_id": 1931,
    "vorder": 145,
    "position": 0,
    "text": "شما را بدین روزگار سترگ"
  },
  {
    "poem_id": 1931,
    "vorder": 146,
    "position": 1,
    "text": "یکی دست باشد بر ما بزرگ"
  },
  {
    "poem_id": 1931,
    "vorder": 147,
    "position": 0,
    "text": "هنرمند گوینده دستور ما"
  },
  {
    "poem_id": 1931,
    "vorder": 148,
    "position": 1,
    "text": "بفرماید اکنون به گنجور ما"
  },
  {
    "poem_id": 1931,
    "vorder": 149,
    "position": 0,
    "text": "که هر کس این را ندارد به رنج"
  },
  {
    "poem_id": 1931,
    "vorder": 150,
    "position": 1,
    "text": "فرستد ورا پارسی جامه پنج"
  },
  {
    "poem_id": 1931,
    "vorder": 151,
    "position": 0,
    "text": "یکی خوب سربند پیکر به زر"
  },
  {
    "poem_id": 1931,
    "vorder": 152,
    "position": 1,
    "text": "بیابند فرجام زین کار بر"
  },
  {
    "poem_id": 1931,
    "vorder": 153,
    "position": 0,
    "text": "بدین روزگار تباه و دژم"
  },
  {
    "poem_id": 1931,
    "vorder": 154,
    "position": 1,
    "text": "بیابد ز گنجور ما چل درم"
  },
  {
    "poem_id": 1931,
    "vorder": 155,
    "position": 0,
    "text": "به سنگ کسی کو بود زیردست"
  },
  {
    "poem_id": 1931,
    "vorder": 156,
    "position": 1,
    "text": "یکی زین درمها گر آید بدست"
  },
  {
    "poem_id": 1931,
    "vorder": 157,
    "position": 0,
    "text": "از آن شست بر سر شش و چاردانگ"
  },
  {
    "poem_id": 1931,
    "vorder": 158,
    "position": 1,
    "text": "بیارد نبشته بخواند به بانگ"
  },
  {
    "poem_id": 1931,
    "vorder": 159,
    "position": 0,
    "text": "بیک روی بر نام یزدان پاک"
  },
  {
    "poem_id": 1931,
    "vorder": 160,
    "position": 1,
    "text": "کزویَست امید و زو ترس و باک"
  },
  {
    "poem_id": 1931,
    "vorder": 161,
    "position": 0,
    "text": "دگر پیکرش افسر و چهر ما"
  },
  {
    "poem_id": 1931,
    "vorder": 162,
    "position": 1,
    "text": "زمین بارور گشته از مهر ما"
  },
  {
    "poem_id": 1931,
    "vorder": 163,
    "position": 0,
    "text": "به نوروز و مهر آن هم آراستست"
  },
  {
    "poem_id": 1931,
    "vorder": 164,
    "position": 1,
    "text": "دو جشن بزرگست و با خواستست"
  },
  {
    "poem_id": 1931,
    "vorder": 165,
    "position": 0,
    "text": "درود جهان بر کم‌آزار‌مرد"
  },
  {
    "poem_id": 1931,
    "vorder": 166,
    "position": 1,
    "text": "کسی کو ز دیهیم ما یاد کرد"
  },
  {
    "poem_id": 1931,
    "vorder": 167,
    "position": 0,
    "text": "بلند اختری نامجویی سوار"
  },
  {
    "poem_id": 1931,
    "vorder": 168,
    "position": 1,
    "text": "بیامد به کف نامهٔ شهریار"
  }
]