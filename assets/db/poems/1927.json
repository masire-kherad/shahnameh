[
  {
    "poem_id": 1927,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید سعد آن گرانمایه مرد"
  },
  {
    "poem_id": 1927,
    "vorder": 2,
    "position": 1,
    "text": "پذیره شدش با سپاهی چو گرد"
  },
  {
    "poem_id": 1927,
    "vorder": 3,
    "position": 0,
    "text": "فرود آوریدندش اندر زمان"
  },
  {
    "poem_id": 1927,
    "vorder": 4,
    "position": 1,
    "text": "بپرسید سعد از تن پهلوان"
  },
  {
    "poem_id": 1927,
    "vorder": 5,
    "position": 0,
    "text": "هم از شاه و دستور و ز لشکرش"
  },
  {
    "poem_id": 1927,
    "vorder": 6,
    "position": 1,
    "text": "ز سالار بیدار و ز کشورش"
  },
  {
    "poem_id": 1927,
    "vorder": 7,
    "position": 0,
    "text": "ردا زیر پیروز بفگند و گفت"
  },
  {
    "poem_id": 1927,
    "vorder": 8,
    "position": 1,
    "text": "که ما نیزه و تیغ داریم جفت"
  },
  {
    "poem_id": 1927,
    "vorder": 9,
    "position": 0,
    "text": "ز دیبا نگویند مردان مرد"
  },
  {
    "poem_id": 1927,
    "vorder": 10,
    "position": 1,
    "text": "ز رز و ز سیم و ز خواب و ز خورد"
  },
  {
    "poem_id": 1927,
    "vorder": 11,
    "position": 0,
    "text": "گرانمایه پیروز نامه بداد"
  },
  {
    "poem_id": 1927,
    "vorder": 12,
    "position": 1,
    "text": "سخنهای رستم همی‌کرد یاد"
  },
  {
    "poem_id": 1927,
    "vorder": 13,
    "position": 0,
    "text": "سخنهاش بشنید و نامه بخواند"
  },
  {
    "poem_id": 1927,
    "vorder": 14,
    "position": 1,
    "text": "دران گفتن نامه خیره بماند"
  },
  {
    "poem_id": 1927,
    "vorder": 15,
    "position": 0,
    "text": "بتازی یکی نامه پاسخ نوشت"
  },
  {
    "poem_id": 1927,
    "vorder": 16,
    "position": 1,
    "text": "پدیدار کرد اندرو خوب و زشت"
  },
  {
    "poem_id": 1927,
    "vorder": 17,
    "position": 0,
    "text": "ز جنی سخن گفت وز آدمی"
  },
  {
    "poem_id": 1927,
    "vorder": 18,
    "position": 1,
    "text": "ز گفتار پیغمبر هاشمی"
  },
  {
    "poem_id": 1927,
    "vorder": 19,
    "position": 0,
    "text": "ز توحید و قرآن و وعد و وعید"
  },
  {
    "poem_id": 1927,
    "vorder": 20,
    "position": 1,
    "text": "ز تأیید و ز رسمهای جدید"
  },
  {
    "poem_id": 1927,
    "vorder": 21,
    "position": 0,
    "text": "ز قطران و ز آتش و زمهریر"
  },
  {
    "poem_id": 1927,
    "vorder": 22,
    "position": 1,
    "text": "ز فردوس وز حور وز جوی شیر"
  },
  {
    "poem_id": 1927,
    "vorder": 23,
    "position": 0,
    "text": "ز کافور منشور و ماء معین"
  },
  {
    "poem_id": 1927,
    "vorder": 24,
    "position": 1,
    "text": "درخت بهشت و می و انگبین"
  },
  {
    "poem_id": 1927,
    "vorder": 25,
    "position": 0,
    "text": "اگر شاه بپذیرد این دین راست"
  },
  {
    "poem_id": 1927,
    "vorder": 26,
    "position": 1,
    "text": "دو عالم به شاهی و شادی وراست"
  },
  {
    "poem_id": 1927,
    "vorder": 27,
    "position": 0,
    "text": "همان تاج دارد همان گوشوار"
  },
  {
    "poem_id": 1927,
    "vorder": 28,
    "position": 1,
    "text": "همه ساله با بوی و رنگ و نگار"
  },
  {
    "poem_id": 1927,
    "vorder": 29,
    "position": 0,
    "text": "شفیع از گناهش محمد بود"
  },
  {
    "poem_id": 1927,
    "vorder": 30,
    "position": 1,
    "text": "تنش چون گلاب مصعد بود"
  },
  {
    "poem_id": 1927,
    "vorder": 31,
    "position": 0,
    "text": "بکاری که پاداش یابی بهشت"
  },
  {
    "poem_id": 1927,
    "vorder": 32,
    "position": 1,
    "text": "نباید به باغ بلا کینه کشت"
  },
  {
    "poem_id": 1927,
    "vorder": 33,
    "position": 0,
    "text": "تن یزدگرد و جهان فراخ"
  },
  {
    "poem_id": 1927,
    "vorder": 34,
    "position": 1,
    "text": "چنین باغ و میدان و ایوان وکاخ"
  },
  {
    "poem_id": 1927,
    "vorder": 35,
    "position": 0,
    "text": "همه تخت گاه و همه جشن و سور"
  },
  {
    "poem_id": 1927,
    "vorder": 36,
    "position": 1,
    "text": "نخَرَّم به دیدار یک موی حور"
  },
  {
    "poem_id": 1927,
    "vorder": 37,
    "position": 0,
    "text": "دو چشم تو اندر سرای سپنج"
  },
  {
    "poem_id": 1927,
    "vorder": 38,
    "position": 1,
    "text": "چنین خیره شد از پی تاج و گنج"
  },
  {
    "poem_id": 1927,
    "vorder": 39,
    "position": 0,
    "text": "بس ایمن شدستی برین تخت عاج"
  },
  {
    "poem_id": 1927,
    "vorder": 40,
    "position": 1,
    "text": "بدین یوز و باز و بدین مهر و تاج"
  },
  {
    "poem_id": 1927,
    "vorder": 41,
    "position": 0,
    "text": "جهانی کجا شربتی آب سرد"
  },
  {
    "poem_id": 1927,
    "vorder": 42,
    "position": 1,
    "text": "نیرزد دلت را چه داری به درد"
  },
  {
    "poem_id": 1927,
    "vorder": 43,
    "position": 0,
    "text": "هرآنکس که پیش من آید به جنگ"
  },
  {
    "poem_id": 1927,
    "vorder": 44,
    "position": 1,
    "text": "نبیند به جز دوزخ و گور تنگ"
  },
  {
    "poem_id": 1927,
    "vorder": 45,
    "position": 0,
    "text": "بهشتست اگر بگروی جای تو"
  },
  {
    "poem_id": 1927,
    "vorder": 46,
    "position": 1,
    "text": "نگر تا چه باشد کنون رای تو"
  },
  {
    "poem_id": 1927,
    "vorder": 47,
    "position": 0,
    "text": "به قرطاس مهر عرب برنهاد"
  },
  {
    "poem_id": 1927,
    "vorder": 48,
    "position": 1,
    "text": "درود محمد همی‌کرد یاد"
  },
  {
    "poem_id": 1927,
    "vorder": 49,
    "position": 0,
    "text": "چو شعبه مغیره بگفت آن زمان"
  },
  {
    "poem_id": 1927,
    "vorder": 50,
    "position": 1,
    "text": "که آید بر رستم پهلوان"
  },
  {
    "poem_id": 1927,
    "vorder": 51,
    "position": 0,
    "text": "ز ایران یکی نامداری ز راه"
  },
  {
    "poem_id": 1927,
    "vorder": 52,
    "position": 1,
    "text": "بیامد بر پهلوان سپاه"
  },
  {
    "poem_id": 1927,
    "vorder": 53,
    "position": 0,
    "text": "که آمد فرستاده‌ای پیر و سست"
  },
  {
    "poem_id": 1927,
    "vorder": 54,
    "position": 1,
    "text": "نه اسپ و سلیح و نه چشمی درست"
  },
  {
    "poem_id": 1927,
    "vorder": 55,
    "position": 0,
    "text": "یکی تیغ باریک بر گردنش"
  },
  {
    "poem_id": 1927,
    "vorder": 56,
    "position": 1,
    "text": "پدید آمده چاک پیراهنش"
  },
  {
    "poem_id": 1927,
    "vorder": 57,
    "position": 0,
    "text": "چورستم به گفتار او بنگرید"
  },
  {
    "poem_id": 1927,
    "vorder": 58,
    "position": 1,
    "text": "ز دیبا سراپردهٔ برکشید"
  },
  {
    "poem_id": 1927,
    "vorder": 59,
    "position": 0,
    "text": "ز زربفت چینی کشیدند نخ"
  },
  {
    "poem_id": 1927,
    "vorder": 60,
    "position": 1,
    "text": "سپاه اندر آمد چو مور و ملخ"
  },
  {
    "poem_id": 1927,
    "vorder": 61,
    "position": 0,
    "text": "نهادند زرین یکی زیرگاه"
  },
  {
    "poem_id": 1927,
    "vorder": 62,
    "position": 1,
    "text": "نشست از برش پهلوان سپاه"
  },
  {
    "poem_id": 1927,
    "vorder": 63,
    "position": 0,
    "text": "بر او از ایرانیان شست مرد"
  },
  {
    "poem_id": 1927,
    "vorder": 64,
    "position": 1,
    "text": "سواران و مردان روز نبرد"
  },
  {
    "poem_id": 1927,
    "vorder": 65,
    "position": 0,
    "text": "به زر بافته جامه‌های بنفش"
  },
  {
    "poem_id": 1927,
    "vorder": 66,
    "position": 1,
    "text": "بپا اندرون کرده زرینه کفش"
  },
  {
    "poem_id": 1927,
    "vorder": 67,
    "position": 0,
    "text": "همه طوق داران با گوشوار"
  },
  {
    "poem_id": 1927,
    "vorder": 68,
    "position": 1,
    "text": "سرا پرده آراسته شاهوار"
  },
  {
    "poem_id": 1927,
    "vorder": 69,
    "position": 0,
    "text": "چو شعبه به بالای پرده سرای"
  },
  {
    "poem_id": 1927,
    "vorder": 70,
    "position": 1,
    "text": "بیامد بران جامه ننهاد پای"
  },
  {
    "poem_id": 1927,
    "vorder": 71,
    "position": 0,
    "text": "همی‌رفت برخاک برخوار خوار"
  },
  {
    "poem_id": 1927,
    "vorder": 72,
    "position": 1,
    "text": "ز شمشیر کرده یکی دستوار"
  },
  {
    "poem_id": 1927,
    "vorder": 73,
    "position": 0,
    "text": "نشست از بر خاک و کس را ندید"
  },
  {
    "poem_id": 1927,
    "vorder": 74,
    "position": 1,
    "text": "سوی پهلوان سپه ننگرید"
  },
  {
    "poem_id": 1927,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت رستم که جان شاددار"
  },
  {
    "poem_id": 1927,
    "vorder": 76,
    "position": 1,
    "text": "بدانش روان و تن آباد دار"
  },
  {
    "poem_id": 1927,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت شعبه که ای نیک نام"
  },
  {
    "poem_id": 1927,
    "vorder": 78,
    "position": 1,
    "text": "اگر دین پذیری شوم شادکام"
  },
  {
    "poem_id": 1927,
    "vorder": 79,
    "position": 0,
    "text": "بپیچید رستم ز گفتار اوی"
  },
  {
    "poem_id": 1927,
    "vorder": 80,
    "position": 1,
    "text": "بروهاش پرچین شد و زرد روی"
  },
  {
    "poem_id": 1927,
    "vorder": 81,
    "position": 0,
    "text": "ازو نامه بستد بخواننده داد"
  },
  {
    "poem_id": 1927,
    "vorder": 82,
    "position": 1,
    "text": "سخنها برو کرد خواننده یاد"
  },
  {
    "poem_id": 1927,
    "vorder": 83,
    "position": 0,
    "text": "چنین داد پاسخ که او رابگوی"
  },
  {
    "poem_id": 1927,
    "vorder": 84,
    "position": 1,
    "text": "که نه شهریاری نه دیهیم جوی"
  },
  {
    "poem_id": 1927,
    "vorder": 85,
    "position": 0,
    "text": "ندیده سرنیزه‌ات بخت را"
  },
  {
    "poem_id": 1927,
    "vorder": 86,
    "position": 1,
    "text": "دلت آرزو کرد مر تخت را"
  },
  {
    "poem_id": 1927,
    "vorder": 87,
    "position": 0,
    "text": "سخن نزد دانندگان خوارنیست"
  },
  {
    "poem_id": 1927,
    "vorder": 88,
    "position": 1,
    "text": "تو را اندرین کار دیدار نیست"
  },
  {
    "poem_id": 1927,
    "vorder": 89,
    "position": 0,
    "text": "اگر سعد با تاج ساسان بدی"
  },
  {
    "poem_id": 1927,
    "vorder": 90,
    "position": 1,
    "text": "مرا رزم او کردن آسان بدی"
  },
  {
    "poem_id": 1927,
    "vorder": 91,
    "position": 0,
    "text": "ولیکن بدان کاخترت بی‌وفاست"
  },
  {
    "poem_id": 1927,
    "vorder": 92,
    "position": 1,
    "text": "چه گوییم کامروز روز بلاست"
  },
  {
    "poem_id": 1927,
    "vorder": 93,
    "position": 0,
    "text": "تو را گر محمد بود پیش رو"
  },
  {
    "poem_id": 1927,
    "vorder": 94,
    "position": 1,
    "text": "بدین کهن گویم از دین نو"
  },
  {
    "poem_id": 1927,
    "vorder": 95,
    "position": 0,
    "text": "همان کژ پرگار این گوژپشت"
  },
  {
    "poem_id": 1927,
    "vorder": 96,
    "position": 1,
    "text": "بخواهد همی‌بود با ما درشت"
  },
  {
    "poem_id": 1927,
    "vorder": 97,
    "position": 0,
    "text": "تو اکنون بدین خرمی بازگرد"
  },
  {
    "poem_id": 1927,
    "vorder": 98,
    "position": 1,
    "text": "که جای سخن نیست روز نبرد"
  },
  {
    "poem_id": 1927,
    "vorder": 99,
    "position": 0,
    "text": "بگویش که در جنگ مردن به نام"
  },
  {
    "poem_id": 1927,
    "vorder": 100,
    "position": 1,
    "text": "به از زنده دشمن بدو شادکام"
  }
]