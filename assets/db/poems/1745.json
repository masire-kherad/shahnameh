[
  {
    "poem_id": 1745,
    "vorder": 1,
    "position": 0,
    "text": "یکی مرد بود از نژاد سران"
  },
  {
    "poem_id": 1745,
    "vorder": 2,
    "position": 1,
    "text": "هم از تخمهٔ نامور قیصران"
  },
  {
    "poem_id": 1745,
    "vorder": 3,
    "position": 0,
    "text": "برانوش نام و خردمند بود"
  },
  {
    "poem_id": 1745,
    "vorder": 4,
    "position": 1,
    "text": "زبان و روانش پر از بند بود"
  },
  {
    "poem_id": 1745,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت لشکر که قیصر تو باش"
  },
  {
    "poem_id": 1745,
    "vorder": 6,
    "position": 1,
    "text": "برین لشکر و بوم مهتر تو باش"
  },
  {
    "poem_id": 1745,
    "vorder": 7,
    "position": 0,
    "text": "به گفتار تو گوش دارد سپاه"
  },
  {
    "poem_id": 1745,
    "vorder": 8,
    "position": 1,
    "text": "بیفروز تاج و بیارای گاه"
  },
  {
    "poem_id": 1745,
    "vorder": 9,
    "position": 0,
    "text": "بیاراستند از برش تخت عاج"
  },
  {
    "poem_id": 1745,
    "vorder": 10,
    "position": 1,
    "text": "برانوش بنشست بر سرش تاج"
  },
  {
    "poem_id": 1745,
    "vorder": 11,
    "position": 0,
    "text": "به جای بزرگیش بنشاندند"
  },
  {
    "poem_id": 1745,
    "vorder": 12,
    "position": 1,
    "text": "همه رومیان آفرین خواندند"
  },
  {
    "poem_id": 1745,
    "vorder": 13,
    "position": 0,
    "text": "برانوش بنشست و اندیشه کرد"
  },
  {
    "poem_id": 1745,
    "vorder": 14,
    "position": 1,
    "text": "ز روم و ز آوردگاه نبرد"
  },
  {
    "poem_id": 1745,
    "vorder": 15,
    "position": 0,
    "text": "بدانست کو را ز شاه بلند"
  },
  {
    "poem_id": 1745,
    "vorder": 16,
    "position": 1,
    "text": "ز روم و ز آویزش آید گزند"
  },
  {
    "poem_id": 1745,
    "vorder": 17,
    "position": 0,
    "text": "فرستاده‌ای جست بارای و شرم"
  },
  {
    "poem_id": 1745,
    "vorder": 18,
    "position": 1,
    "text": "که دانش سراید به آواز نرم"
  },
  {
    "poem_id": 1745,
    "vorder": 19,
    "position": 0,
    "text": "دبیری بزرگ و جهاندیده‌ای"
  },
  {
    "poem_id": 1745,
    "vorder": 20,
    "position": 1,
    "text": "خردمند و دانا پسندیده‌ای"
  },
  {
    "poem_id": 1745,
    "vorder": 21,
    "position": 0,
    "text": "بیاورد و بنشاند نزدیک خویش"
  },
  {
    "poem_id": 1745,
    "vorder": 22,
    "position": 1,
    "text": "بگفت آن سخنهای باریک خویش"
  },
  {
    "poem_id": 1745,
    "vorder": 23,
    "position": 0,
    "text": "یکی نامه بنوشت پرآفرین"
  },
  {
    "poem_id": 1745,
    "vorder": 24,
    "position": 1,
    "text": "ز دادار بر شهریار زمین"
  },
  {
    "poem_id": 1745,
    "vorder": 25,
    "position": 0,
    "text": "که جاوید تاج تو پاینده باد"
  },
  {
    "poem_id": 1745,
    "vorder": 26,
    "position": 1,
    "text": "همه مهتران پیش تو بنده باد"
  },
  {
    "poem_id": 1745,
    "vorder": 27,
    "position": 0,
    "text": "تو دانی که تاراج و خون ریختن"
  },
  {
    "poem_id": 1745,
    "vorder": 28,
    "position": 1,
    "text": "چه با بیگنه مردم آویختن"
  },
  {
    "poem_id": 1745,
    "vorder": 29,
    "position": 0,
    "text": "مهان سرافراز دارند شوم"
  },
  {
    "poem_id": 1745,
    "vorder": 30,
    "position": 1,
    "text": "چه با شهر ایران چه با مرز روم"
  },
  {
    "poem_id": 1745,
    "vorder": 31,
    "position": 0,
    "text": "گر این کین ایرج به دست از نخست"
  },
  {
    "poem_id": 1745,
    "vorder": 32,
    "position": 1,
    "text": "منوچهر کرد آن به مردی درست"
  },
  {
    "poem_id": 1745,
    "vorder": 33,
    "position": 0,
    "text": "تن سلم زان کین کنون خاک شد"
  },
  {
    "poem_id": 1745,
    "vorder": 34,
    "position": 1,
    "text": "هم از تور روی زمین پاک شد"
  },
  {
    "poem_id": 1745,
    "vorder": 35,
    "position": 0,
    "text": "وگر کین داراست و اسکندری"
  },
  {
    "poem_id": 1745,
    "vorder": 36,
    "position": 1,
    "text": "که نو شد بر وی زمین داوری"
  },
  {
    "poem_id": 1745,
    "vorder": 37,
    "position": 0,
    "text": "مر او را دو دستور بد کشته بود"
  },
  {
    "poem_id": 1745,
    "vorder": 38,
    "position": 1,
    "text": "و دیگر کزو بخت برگشته بود"
  },
  {
    "poem_id": 1745,
    "vorder": 39,
    "position": 0,
    "text": "گرت کین قیصر فزاید همی"
  },
  {
    "poem_id": 1745,
    "vorder": 40,
    "position": 1,
    "text": "به زندان تو بند ساید همی"
  },
  {
    "poem_id": 1745,
    "vorder": 41,
    "position": 0,
    "text": "نباید که ویران شود بوم روم"
  },
  {
    "poem_id": 1745,
    "vorder": 42,
    "position": 1,
    "text": "که چون روم دیگر نبودست بوم"
  },
  {
    "poem_id": 1745,
    "vorder": 43,
    "position": 0,
    "text": "وگر غارت و کشتنت بود رای"
  },
  {
    "poem_id": 1745,
    "vorder": 44,
    "position": 1,
    "text": "همه روم گشتند بی‌دست و پای"
  },
  {
    "poem_id": 1745,
    "vorder": 45,
    "position": 0,
    "text": "زن و کودکانش اسیر تواند"
  },
  {
    "poem_id": 1745,
    "vorder": 46,
    "position": 1,
    "text": "جگر خسته از تیغ و تیر تواند"
  },
  {
    "poem_id": 1745,
    "vorder": 47,
    "position": 0,
    "text": "گه آمد که کمتر کنی کین و خشم"
  },
  {
    "poem_id": 1745,
    "vorder": 48,
    "position": 1,
    "text": "فرو خوابنی از گذشته دو چشم"
  },
  {
    "poem_id": 1745,
    "vorder": 49,
    "position": 0,
    "text": "فدای تو بادا همه خواسته"
  },
  {
    "poem_id": 1745,
    "vorder": 50,
    "position": 1,
    "text": "کزین کین همی جان شود کاسته"
  },
  {
    "poem_id": 1745,
    "vorder": 51,
    "position": 0,
    "text": "تو دل خوش کن و شهر چندین مسوز"
  },
  {
    "poem_id": 1745,
    "vorder": 52,
    "position": 1,
    "text": "نباید که روز اندر آید به روز"
  },
  {
    "poem_id": 1745,
    "vorder": 53,
    "position": 0,
    "text": "نباشد پسند جهان‌آفرین"
  },
  {
    "poem_id": 1745,
    "vorder": 54,
    "position": 1,
    "text": "که بیداد جوید جهاندار کین"
  },
  {
    "poem_id": 1745,
    "vorder": 55,
    "position": 0,
    "text": "درود جهاندار بر شاه باد"
  },
  {
    "poem_id": 1745,
    "vorder": 56,
    "position": 1,
    "text": "بلند اخترش افسر ماه باد"
  },
  {
    "poem_id": 1745,
    "vorder": 57,
    "position": 0,
    "text": "نویسنده بنهاد پس خامه را"
  },
  {
    "poem_id": 1745,
    "vorder": 58,
    "position": 1,
    "text": "چو اندر نوشت آن کیی نامه را"
  },
  {
    "poem_id": 1745,
    "vorder": 59,
    "position": 0,
    "text": "نهادند پس مهر قیصر بروی"
  },
  {
    "poem_id": 1745,
    "vorder": 60,
    "position": 1,
    "text": "فرستاده بنهاد زی شاه روی"
  },
  {
    "poem_id": 1745,
    "vorder": 61,
    "position": 0,
    "text": "بیامد خردمند و نامه بداد"
  },
  {
    "poem_id": 1745,
    "vorder": 62,
    "position": 1,
    "text": "ز قیصر به شاپور فرخ نژاد"
  },
  {
    "poem_id": 1745,
    "vorder": 63,
    "position": 0,
    "text": "چو آن نامور نامه برخواندند"
  },
  {
    "poem_id": 1745,
    "vorder": 64,
    "position": 1,
    "text": "سخنهای نغزش برافشاندند"
  },
  {
    "poem_id": 1745,
    "vorder": 65,
    "position": 0,
    "text": "ببخشود و دیده پر از آب کرد"
  },
  {
    "poem_id": 1745,
    "vorder": 66,
    "position": 1,
    "text": "بروهای جنگی پر از تاب کرد"
  },
  {
    "poem_id": 1745,
    "vorder": 67,
    "position": 0,
    "text": "هم‌اندر زمان نامه پاسخ نوشت"
  },
  {
    "poem_id": 1745,
    "vorder": 68,
    "position": 1,
    "text": "بگفت آنکجا رفته بد خوب و زشت"
  },
  {
    "poem_id": 1745,
    "vorder": 69,
    "position": 0,
    "text": "که مهمان به چرم خر اندر که دوخت"
  },
  {
    "poem_id": 1745,
    "vorder": 70,
    "position": 1,
    "text": "که بازار کین کهن برفروخت"
  },
  {
    "poem_id": 1745,
    "vorder": 71,
    "position": 0,
    "text": "تو گرد بخردی خیز پیش من آی"
  },
  {
    "poem_id": 1745,
    "vorder": 72,
    "position": 1,
    "text": "خود و فیلسوفان پاکیزه رای"
  },
  {
    "poem_id": 1745,
    "vorder": 73,
    "position": 0,
    "text": "چو زنهار دادم نسازمت جنگ"
  },
  {
    "poem_id": 1745,
    "vorder": 74,
    "position": 1,
    "text": "گشاده کنم بر تو این راه تنگ"
  },
  {
    "poem_id": 1745,
    "vorder": 75,
    "position": 0,
    "text": "فرستاده برگشت و پاسخ ببرد"
  },
  {
    "poem_id": 1745,
    "vorder": 76,
    "position": 1,
    "text": "سخنها یکایک همه برشمرد"
  }
]