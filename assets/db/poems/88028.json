[
  {
    "poem_id": 88028,
    "vorder": 1,
    "position": 0,
    "text": "به روز چهارم ز پیش سپاه"
  },
  {
    "poem_id": 88028,
    "vorder": 2,
    "position": 1,
    "text": "بشد بیژن گیو تا قلبگاه"
  },
  {
    "poem_id": 88028,
    "vorder": 3,
    "position": 0,
    "text": "به پیش پدر شد همه جامه چاک"
  },
  {
    "poem_id": 88028,
    "vorder": 4,
    "position": 1,
    "text": "همی بآسمان بر پراگند خاک"
  },
  {
    "poem_id": 88028,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت کای باب کارآزمای"
  },
  {
    "poem_id": 88028,
    "vorder": 6,
    "position": 1,
    "text": "چه داری چنین خیره ما را بپای"
  },
  {
    "poem_id": 88028,
    "vorder": 7,
    "position": 0,
    "text": "به پنجم فراز آمد این روزگار"
  },
  {
    "poem_id": 88028,
    "vorder": 8,
    "position": 1,
    "text": "شب و روز آسایش آموزگار"
  },
  {
    "poem_id": 88028,
    "vorder": 9,
    "position": 0,
    "text": "نه خورشید شمشیر گردان بدید"
  },
  {
    "poem_id": 88028,
    "vorder": 10,
    "position": 1,
    "text": "نه گردی به روی هوا بردمید"
  },
  {
    "poem_id": 88028,
    "vorder": 11,
    "position": 0,
    "text": "سواران به خفتان و خود اندرون"
  },
  {
    "poem_id": 88028,
    "vorder": 12,
    "position": 1,
    "text": "یکی را به رگ بر نجنبید خون"
  },
  {
    "poem_id": 88028,
    "vorder": 13,
    "position": 0,
    "text": "به ایران پس از رستم نامدار"
  },
  {
    "poem_id": 88028,
    "vorder": 14,
    "position": 1,
    "text": "نبودی چو گودرز دیگر سوار"
  },
  {
    "poem_id": 88028,
    "vorder": 15,
    "position": 0,
    "text": "چینن تا بیامد ز جنگ پشن"
  },
  {
    "poem_id": 88028,
    "vorder": 16,
    "position": 1,
    "text": "از آن کشتن و رزمگاه گشن"
  },
  {
    "poem_id": 88028,
    "vorder": 17,
    "position": 0,
    "text": "به لاون که چندان پسر کشته دید"
  },
  {
    "poem_id": 88028,
    "vorder": 18,
    "position": 1,
    "text": "سر بخت ایرانیان گشته دید"
  },
  {
    "poem_id": 88028,
    "vorder": 19,
    "position": 0,
    "text": "جگر خسته گشته است و گم کرده‌ راه"
  },
  {
    "poem_id": 88028,
    "vorder": 20,
    "position": 1,
    "text": "نخواهد که بیند همی رزمگاه"
  },
  {
    "poem_id": 88028,
    "vorder": 21,
    "position": 0,
    "text": "به پیرانش بر چشم باید فگند"
  },
  {
    "poem_id": 88028,
    "vorder": 22,
    "position": 1,
    "text": "نهادست سر سوی کوه بلند"
  },
  {
    "poem_id": 88028,
    "vorder": 23,
    "position": 0,
    "text": "سپهدار کو ناشمرده سپاه"
  },
  {
    "poem_id": 88028,
    "vorder": 24,
    "position": 1,
    "text": "ستاره شمارد همی گرد ماه"
  },
  {
    "poem_id": 88028,
    "vorder": 25,
    "position": 0,
    "text": "تو بشناس کاندر تنش نیست خون"
  },
  {
    "poem_id": 88028,
    "vorder": 26,
    "position": 1,
    "text": "شد از جنگ جنگاوران او زبون"
  },
  {
    "poem_id": 88028,
    "vorder": 27,
    "position": 0,
    "text": "شگفت از جهاندیده گودرز نیست"
  },
  {
    "poem_id": 88028,
    "vorder": 28,
    "position": 1,
    "text": "که او را روان خود بر این مرز نیست"
  },
  {
    "poem_id": 88028,
    "vorder": 29,
    "position": 0,
    "text": "شگفت از تو آید مرا ای پدر"
  },
  {
    "poem_id": 88028,
    "vorder": 30,
    "position": 1,
    "text": "که شیر ژیان از تو جوید هنر"
  },
  {
    "poem_id": 88028,
    "vorder": 31,
    "position": 0,
    "text": "دو لشکر همی بر تو دارند چشم"
  },
  {
    "poem_id": 88028,
    "vorder": 32,
    "position": 1,
    "text": "یکی تیز کن مغز و بفروز خشم"
  },
  {
    "poem_id": 88028,
    "vorder": 33,
    "position": 0,
    "text": "کنون چون جهان گرم و روشن هوا"
  },
  {
    "poem_id": 88028,
    "vorder": 34,
    "position": 1,
    "text": "بگیرد همی رزم لشکر نوا"
  },
  {
    "poem_id": 88028,
    "vorder": 35,
    "position": 0,
    "text": "چو این روزگار خوشی بگذرد"
  },
  {
    "poem_id": 88028,
    "vorder": 36,
    "position": 1,
    "text": "چو پولاد روی زمین بفسرد"
  },
  {
    "poem_id": 88028,
    "vorder": 37,
    "position": 0,
    "text": "چو بر نیزه‌ها گردد افسرده چنگ"
  },
  {
    "poem_id": 88028,
    "vorder": 38,
    "position": 1,
    "text": "پس پشت تیغ آید و پیش سنگ"
  },
  {
    "poem_id": 88028,
    "vorder": 39,
    "position": 0,
    "text": "که آید ز گردان به پیش سپاه"
  },
  {
    "poem_id": 88028,
    "vorder": 40,
    "position": 1,
    "text": "که آورد گیرد بدین رزمگاه"
  },
  {
    "poem_id": 88028,
    "vorder": 41,
    "position": 0,
    "text": "ور ایدون که ترسد همی از کمین"
  },
  {
    "poem_id": 88028,
    "vorder": 42,
    "position": 1,
    "text": "ز جنگ سواران و مردان کین"
  },
  {
    "poem_id": 88028,
    "vorder": 43,
    "position": 0,
    "text": "به من داد باید سواری هزار"
  },
  {
    "poem_id": 88028,
    "vorder": 44,
    "position": 1,
    "text": "گزین من اندرخور کارزار"
  },
  {
    "poem_id": 88028,
    "vorder": 45,
    "position": 0,
    "text": "برآریم گرد از کمینگاهشان"
  },
  {
    "poem_id": 88028,
    "vorder": 46,
    "position": 1,
    "text": "سرافشان کنیم از بر ماهشان"
  },
  {
    "poem_id": 88028,
    "vorder": 47,
    "position": 0,
    "text": "ز گفتار بیژن بخندید گیو"
  },
  {
    "poem_id": 88028,
    "vorder": 48,
    "position": 1,
    "text": "بسی آفرین کرد بر پور نیو"
  },
  {
    "poem_id": 88028,
    "vorder": 49,
    "position": 0,
    "text": "به دادار گفت از تو دارم سپاس"
  },
  {
    "poem_id": 88028,
    "vorder": 50,
    "position": 1,
    "text": "تو دادی مرا پور نیکی‌شناس"
  },
  {
    "poem_id": 88028,
    "vorder": 51,
    "position": 0,
    "text": "همش هوش دادی و هم زور کین"
  },
  {
    "poem_id": 88028,
    "vorder": 52,
    "position": 1,
    "text": "شناسای هر کار و جویای دین"
  },
  {
    "poem_id": 88028,
    "vorder": 53,
    "position": 0,
    "text": "به من بازگشت این دلاور جوان"
  },
  {
    "poem_id": 88028,
    "vorder": 54,
    "position": 1,
    "text": "چنان چون بود بچهٔ پهلوان"
  },
  {
    "poem_id": 88028,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت مر جفت را نره شیر"
  },
  {
    "poem_id": 88028,
    "vorder": 56,
    "position": 1,
    "text": "که فرزند ما گر نباشد دلیر"
  },
  {
    "poem_id": 88028,
    "vorder": 57,
    "position": 0,
    "text": "ببریم از او مهر و پیوند پاک"
  },
  {
    "poem_id": 88028,
    "vorder": 58,
    "position": 1,
    "text": "پدرش آب دریا بود مام خاک"
  },
  {
    "poem_id": 88028,
    "vorder": 59,
    "position": 0,
    "text": "ولیکن تو ای پور چیره سخن"
  },
  {
    "poem_id": 88028,
    "vorder": 60,
    "position": 1,
    "text": "زبان بر نیا بر گشاده مکن"
  },
  {
    "poem_id": 88028,
    "vorder": 61,
    "position": 0,
    "text": "که او کاردیدست و داناترست"
  },
  {
    "poem_id": 88028,
    "vorder": 62,
    "position": 1,
    "text": "بر این لشکر نامور مهترست"
  },
  {
    "poem_id": 88028,
    "vorder": 63,
    "position": 0,
    "text": "کسی کو بود سودهٔ کارزار"
  },
  {
    "poem_id": 88028,
    "vorder": 64,
    "position": 1,
    "text": "نباید به هر کارش آموزگار"
  },
  {
    "poem_id": 88028,
    "vorder": 65,
    "position": 0,
    "text": "سواران ما گر به بار اندرند"
  },
  {
    "poem_id": 88028,
    "vorder": 66,
    "position": 1,
    "text": "نه ترکان به رنگ و نگار اندرند"
  },
  {
    "poem_id": 88028,
    "vorder": 67,
    "position": 0,
    "text": "همه شوربختند و برگشته سر"
  },
  {
    "poem_id": 88028,
    "vorder": 68,
    "position": 1,
    "text": "همه دیده پرخون و خسته جگر"
  },
  {
    "poem_id": 88028,
    "vorder": 69,
    "position": 0,
    "text": "همی خواهد این باب کارآزمای"
  },
  {
    "poem_id": 88028,
    "vorder": 70,
    "position": 1,
    "text": "که ترکان به جنگ اندر آرند پای"
  },
  {
    "poem_id": 88028,
    "vorder": 71,
    "position": 0,
    "text": "پس پشتشان دور ماند ز کوه"
  },
  {
    "poem_id": 88028,
    "vorder": 72,
    "position": 1,
    "text": "برد لشکر کینه‌ور همگروه"
  },
  {
    "poem_id": 88028,
    "vorder": 73,
    "position": 0,
    "text": "ببینی تو گوپال گودرز را"
  },
  {
    "poem_id": 88028,
    "vorder": 74,
    "position": 1,
    "text": "که چون برنوردد همی مرز را"
  },
  {
    "poem_id": 88028,
    "vorder": 75,
    "position": 0,
    "text": "و دیگر کجا ز اختر نیک و بد"
  },
  {
    "poem_id": 88028,
    "vorder": 76,
    "position": 1,
    "text": "همی گردش چرخ را بشمرد"
  },
  {
    "poem_id": 88028,
    "vorder": 77,
    "position": 0,
    "text": "چو پیش آید آن روزگار بهی"
  },
  {
    "poem_id": 88028,
    "vorder": 78,
    "position": 1,
    "text": "کند روی گیتی ز ترکان تهی"
  },
  {
    "poem_id": 88028,
    "vorder": 79,
    "position": 0,
    "text": "چنین گفت بیژن به پیش پدر"
  },
  {
    "poem_id": 88028,
    "vorder": 80,
    "position": 1,
    "text": "که ای پهلوان جهان سر به سر"
  },
  {
    "poem_id": 88028,
    "vorder": 81,
    "position": 0,
    "text": "خجسته نیا را گر اینست رای"
  },
  {
    "poem_id": 88028,
    "vorder": 82,
    "position": 1,
    "text": "سزد گر نداریم رومی قبای"
  },
  {
    "poem_id": 88028,
    "vorder": 83,
    "position": 0,
    "text": "شوم جوشن و خود بیرون کنم"
  },
  {
    "poem_id": 88028,
    "vorder": 84,
    "position": 1,
    "text": "به می روی پژمرده گلگلون کنم"
  },
  {
    "poem_id": 88028,
    "vorder": 85,
    "position": 0,
    "text": "چو آیم جهان پهلوان را به کار"
  },
  {
    "poem_id": 88028,
    "vorder": 86,
    "position": 1,
    "text": "بیایم کمربستهٔ کارزار"
  }
]