[
  {
    "poem_id": 52171,
    "vorder": 1,
    "position": 0,
    "text": "شب تیره چون چادر مشک‌بوی"
  },
  {
    "poem_id": 52171,
    "vorder": 2,
    "position": 1,
    "text": "بیفگند وخورشید بنمود روی"
  },
  {
    "poem_id": 52171,
    "vorder": 3,
    "position": 0,
    "text": "به درگاه شد مرزبان نزد شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 4,
    "position": 1,
    "text": "گرانمایگان برگشادند راه"
  },
  {
    "poem_id": 52171,
    "vorder": 5,
    "position": 0,
    "text": "جهاندار بهرام را پیش خواند"
  },
  {
    "poem_id": 52171,
    "vorder": 6,
    "position": 1,
    "text": "به تخت از بر نامداران نشاند"
  },
  {
    "poem_id": 52171,
    "vorder": 7,
    "position": 0,
    "text": "بپرسید زان پس که با ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 8,
    "position": 1,
    "text": "کنم آشتی گر فرستم سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 9,
    "position": 0,
    "text": "چنین داد پاسخ بدو جنگجوی"
  },
  {
    "poem_id": 52171,
    "vorder": 10,
    "position": 1,
    "text": "که با ساوه شاه آشتی نیست روی"
  },
  {
    "poem_id": 52171,
    "vorder": 11,
    "position": 0,
    "text": "گر او جنگ را خواهد آراستن"
  },
  {
    "poem_id": 52171,
    "vorder": 12,
    "position": 1,
    "text": "هزیمت بود آشتی خواستن"
  },
  {
    "poem_id": 52171,
    "vorder": 13,
    "position": 0,
    "text": "و دیگر که بدخواه گردد دلیر"
  },
  {
    "poem_id": 52171,
    "vorder": 14,
    "position": 1,
    "text": "چوبیند که کام توآمد بزیر"
  },
  {
    "poem_id": 52171,
    "vorder": 15,
    "position": 0,
    "text": "گه رزم چون بزم پیش آوری"
  },
  {
    "poem_id": 52171,
    "vorder": 16,
    "position": 1,
    "text": "به فرمانبری ماند این داوری"
  },
  {
    "poem_id": 52171,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت هرمز که پس چیست رای"
  },
  {
    "poem_id": 52171,
    "vorder": 18,
    "position": 1,
    "text": "درنگ آورم گر بجنبم ز جای"
  },
  {
    "poem_id": 52171,
    "vorder": 19,
    "position": 0,
    "text": "چنین داد پاسخ که گر بدسگال"
  },
  {
    "poem_id": 52171,
    "vorder": 20,
    "position": 1,
    "text": "بپیچد سر از داد بهتر به فال"
  },
  {
    "poem_id": 52171,
    "vorder": 21,
    "position": 0,
    "text": "چه گفت آن گرانمایهٔ نیک رای"
  },
  {
    "poem_id": 52171,
    "vorder": 22,
    "position": 1,
    "text": "که بیداد را نیست با داد جای"
  },
  {
    "poem_id": 52171,
    "vorder": 23,
    "position": 0,
    "text": "تو با دشمن بدکنش رزم جوی"
  },
  {
    "poem_id": 52171,
    "vorder": 24,
    "position": 1,
    "text": "که با آتش آب اندر آری به جوی"
  },
  {
    "poem_id": 52171,
    "vorder": 25,
    "position": 0,
    "text": "وگر خود دگرگونه باشد سخن"
  },
  {
    "poem_id": 52171,
    "vorder": 26,
    "position": 1,
    "text": "شهی نو گزیند سپهر کهن"
  },
  {
    "poem_id": 52171,
    "vorder": 27,
    "position": 0,
    "text": "چونیرو ببازوی خویش آوریم"
  },
  {
    "poem_id": 52171,
    "vorder": 28,
    "position": 1,
    "text": "هنر هرچ داریم پیش آوریم"
  },
  {
    "poem_id": 52171,
    "vorder": 29,
    "position": 0,
    "text": "نه از پاک یزدان نکوهش بود"
  },
  {
    "poem_id": 52171,
    "vorder": 30,
    "position": 1,
    "text": "نه شرم از یلان چون پژوهش بود"
  },
  {
    "poem_id": 52171,
    "vorder": 31,
    "position": 0,
    "text": "چو کشته ز ایرانیان ده هزار"
  },
  {
    "poem_id": 52171,
    "vorder": 32,
    "position": 1,
    "text": "بتابیم خیره سر از کارزار"
  },
  {
    "poem_id": 52171,
    "vorder": 33,
    "position": 0,
    "text": "چه گوید تو را دشمن عیبجوی"
  },
  {
    "poem_id": 52171,
    "vorder": 34,
    "position": 1,
    "text": "که بی‌جنگ پیچی ز بدخواه روی"
  },
  {
    "poem_id": 52171,
    "vorder": 35,
    "position": 0,
    "text": "چو بر دشمنان تیرباران کنیم"
  },
  {
    "poem_id": 52171,
    "vorder": 36,
    "position": 1,
    "text": "کمان را چو ابر بهاران کنیم"
  },
  {
    "poem_id": 52171,
    "vorder": 37,
    "position": 0,
    "text": "همان تیغ و گوپال چون صدهزار"
  },
  {
    "poem_id": 52171,
    "vorder": 38,
    "position": 1,
    "text": "شکسته شود درصف کارزار"
  },
  {
    "poem_id": 52171,
    "vorder": 39,
    "position": 0,
    "text": "چون پیروزی ما نیاید پدید"
  },
  {
    "poem_id": 52171,
    "vorder": 40,
    "position": 1,
    "text": "دل از نیک بختی نباید کشید"
  },
  {
    "poem_id": 52171,
    "vorder": 41,
    "position": 0,
    "text": "وزان پس بفرمان دشمن شویم"
  },
  {
    "poem_id": 52171,
    "vorder": 42,
    "position": 1,
    "text": "که بیهوش و بیجان و بیتن شویم"
  },
  {
    "poem_id": 52171,
    "vorder": 43,
    "position": 0,
    "text": "بکوشیم با گردش آسمان"
  },
  {
    "poem_id": 52171,
    "vorder": 44,
    "position": 1,
    "text": "اگر درمیانه سر آرد زمان"
  },
  {
    "poem_id": 52171,
    "vorder": 45,
    "position": 0,
    "text": "چو گفتار بهرام بشنید شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 46,
    "position": 1,
    "text": "بخندید و رخشنده شد پیشگاه"
  },
  {
    "poem_id": 52171,
    "vorder": 47,
    "position": 0,
    "text": "ز پیش جهاندار بیرون شدند"
  },
  {
    "poem_id": 52171,
    "vorder": 48,
    "position": 1,
    "text": "جهاندیدگان دل پر از خون شدند"
  },
  {
    "poem_id": 52171,
    "vorder": 49,
    "position": 0,
    "text": "ببهرام گفتند کاندر سخن"
  },
  {
    "poem_id": 52171,
    "vorder": 50,
    "position": 1,
    "text": "چو پرسد تو را بس دلیری مکن"
  },
  {
    "poem_id": 52171,
    "vorder": 51,
    "position": 0,
    "text": "سپاهست چندان ابا ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 52,
    "position": 1,
    "text": "که بر مور و بر پیشه بستند راه"
  },
  {
    "poem_id": 52171,
    "vorder": 53,
    "position": 0,
    "text": "چنان چون تو گویی همی پیش شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 54,
    "position": 1,
    "text": "که یارد بُدن پهلوان سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 55,
    "position": 0,
    "text": "چنین گفت بهرام با مهتران"
  },
  {
    "poem_id": 52171,
    "vorder": 56,
    "position": 1,
    "text": "که ای نامداران و کندآوران"
  },
  {
    "poem_id": 52171,
    "vorder": 57,
    "position": 0,
    "text": "چو فرمان دهد نامبردار شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 58,
    "position": 1,
    "text": "منم ساخته پهلوان سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 59,
    "position": 0,
    "text": "برفتند بیدار کارآگهان"
  },
  {
    "poem_id": 52171,
    "vorder": 60,
    "position": 1,
    "text": "هم آنگه بر شهریار جهان"
  },
  {
    "poem_id": 52171,
    "vorder": 61,
    "position": 0,
    "text": "سخنهای بهرام چندانک بود"
  },
  {
    "poem_id": 52171,
    "vorder": 62,
    "position": 1,
    "text": "بهر یک سراینده ده برفزود"
  },
  {
    "poem_id": 52171,
    "vorder": 63,
    "position": 0,
    "text": "شهنشاه ایران ازان شاد شد"
  },
  {
    "poem_id": 52171,
    "vorder": 64,
    "position": 1,
    "text": "ز تیمار آن لشکر آزاد شد"
  },
  {
    "poem_id": 52171,
    "vorder": 65,
    "position": 0,
    "text": "ورا کرد سالار بر لشکرش"
  },
  {
    "poem_id": 52171,
    "vorder": 66,
    "position": 1,
    "text": "بابر اندر آورد جنگی سرش"
  },
  {
    "poem_id": 52171,
    "vorder": 67,
    "position": 0,
    "text": "هرآنکس که جست از یلان نام را"
  },
  {
    "poem_id": 52171,
    "vorder": 68,
    "position": 1,
    "text": "سپهبد همی‌خواند بهرام را"
  },
  {
    "poem_id": 52171,
    "vorder": 69,
    "position": 0,
    "text": "سپهبد بیامد بر شهریار"
  },
  {
    "poem_id": 52171,
    "vorder": 70,
    "position": 1,
    "text": "که خوانم عرض را ز بهر شمار"
  },
  {
    "poem_id": 52171,
    "vorder": 71,
    "position": 0,
    "text": "ببینم ز لشکر که جنگی که‌اند"
  },
  {
    "poem_id": 52171,
    "vorder": 72,
    "position": 1,
    "text": "گه نام جستن درنگی که‌اند"
  },
  {
    "poem_id": 52171,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت سالار لشکر تویی"
  },
  {
    "poem_id": 52171,
    "vorder": 74,
    "position": 1,
    "text": "بتو باز گردد بد و نیکویی"
  },
  {
    "poem_id": 52171,
    "vorder": 75,
    "position": 0,
    "text": "سپهبد بشد تا عرض گاه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 76,
    "position": 1,
    "text": "بفرمود تا پی او شد سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 77,
    "position": 0,
    "text": "گزین کرد ز ایرانیان لشکری"
  },
  {
    "poem_id": 52171,
    "vorder": 78,
    "position": 1,
    "text": "هرآنکس که بود از سران افسری"
  },
  {
    "poem_id": 52171,
    "vorder": 79,
    "position": 0,
    "text": "نبشتند نام ده و دو هزار"
  },
  {
    "poem_id": 52171,
    "vorder": 80,
    "position": 1,
    "text": "زره دار وبر گستوانور سوار"
  },
  {
    "poem_id": 52171,
    "vorder": 81,
    "position": 0,
    "text": "چهل سالگان را نبشتند نام"
  },
  {
    "poem_id": 52171,
    "vorder": 82,
    "position": 1,
    "text": "درم  برکم و بیش از این شد حرام"
  },
  {
    "poem_id": 52171,
    "vorder": 83,
    "position": 0,
    "text": "سپهبد چو بهرام بهرام بود"
  },
  {
    "poem_id": 52171,
    "vorder": 84,
    "position": 1,
    "text": "که در جنگ جستن ورا نام بود"
  },
  {
    "poem_id": 52171,
    "vorder": 85,
    "position": 0,
    "text": "یکی را کجا نام یل سینه بود"
  },
  {
    "poem_id": 52171,
    "vorder": 86,
    "position": 1,
    "text": "کجا سینه و دل پر از کینه بود"
  },
  {
    "poem_id": 52171,
    "vorder": 87,
    "position": 0,
    "text": "سرنامداران جنگیش کرد"
  },
  {
    "poem_id": 52171,
    "vorder": 88,
    "position": 1,
    "text": "که پیش صف آید به روز نبرد"
  },
  {
    "poem_id": 52171,
    "vorder": 89,
    "position": 0,
    "text": "بگرداند اسب و بگوید نژاد"
  },
  {
    "poem_id": 52171,
    "vorder": 90,
    "position": 1,
    "text": "کند بر دل جنگیان جنگ یاد"
  },
  {
    "poem_id": 52171,
    "vorder": 91,
    "position": 0,
    "text": "دگر آنک بد نام ایزدگشسب"
  },
  {
    "poem_id": 52171,
    "vorder": 92,
    "position": 1,
    "text": "کز آتش نه برگاشتی روی اسب"
  },
  {
    "poem_id": 52171,
    "vorder": 93,
    "position": 0,
    "text": "بفرمود تا گوش دارد بنه"
  },
  {
    "poem_id": 52171,
    "vorder": 94,
    "position": 1,
    "text": "کند میسره راست با میمنه"
  },
  {
    "poem_id": 52171,
    "vorder": 95,
    "position": 0,
    "text": "به پشت سپه بود همدان گشسب"
  },
  {
    "poem_id": 52171,
    "vorder": 96,
    "position": 1,
    "text": "کجا دم شیران گرفتی به اسب"
  },
  {
    "poem_id": 52171,
    "vorder": 97,
    "position": 0,
    "text": "به لشکر چنین گفت پس پهلوان"
  },
  {
    "poem_id": 52171,
    "vorder": 98,
    "position": 1,
    "text": "که ای نامداران روشن روان"
  },
  {
    "poem_id": 52171,
    "vorder": 99,
    "position": 0,
    "text": "کم آزار باشید و هم کم زیان"
  },
  {
    "poem_id": 52171,
    "vorder": 100,
    "position": 1,
    "text": "بدی را مبندید هرگز میان"
  },
  {
    "poem_id": 52171,
    "vorder": 101,
    "position": 0,
    "text": "چوخواهید کایزد بود یارتان"
  },
  {
    "poem_id": 52171,
    "vorder": 102,
    "position": 1,
    "text": "کند روشن این تیره بازارتان"
  },
  {
    "poem_id": 52171,
    "vorder": 103,
    "position": 0,
    "text": "شب تیره چون ناله کرنای"
  },
  {
    "poem_id": 52171,
    "vorder": 104,
    "position": 1,
    "text": "برآمد بجنبید یکسر ز جای"
  },
  {
    "poem_id": 52171,
    "vorder": 105,
    "position": 0,
    "text": "بران گونه رانید یکسر ستور"
  },
  {
    "poem_id": 52171,
    "vorder": 106,
    "position": 1,
    "text": "که گر خیزد اندر شب تیره هور"
  },
  {
    "poem_id": 52171,
    "vorder": 107,
    "position": 0,
    "text": "ز نیروی و آسودگی اسب و مرد"
  },
  {
    "poem_id": 52171,
    "vorder": 108,
    "position": 1,
    "text": "نیندیشد از روزگار نبرد"
  },
  {
    "poem_id": 52171,
    "vorder": 109,
    "position": 0,
    "text": "چوآگاهی آمد بر شهریار"
  },
  {
    "poem_id": 52171,
    "vorder": 110,
    "position": 1,
    "text": "که داننده بهرام چون ساخت کار"
  },
  {
    "poem_id": 52171,
    "vorder": 111,
    "position": 0,
    "text": "ز گفتار و کردار او گشت شاد"
  },
  {
    "poem_id": 52171,
    "vorder": 112,
    "position": 1,
    "text": "در گنج بگشاد و روزی بداد"
  },
  {
    "poem_id": 52171,
    "vorder": 113,
    "position": 0,
    "text": "همه گنجهای سلیح نبرد"
  },
  {
    "poem_id": 52171,
    "vorder": 114,
    "position": 1,
    "text": "به پارس و به اهواز در باز کرد"
  },
  {
    "poem_id": 52171,
    "vorder": 115,
    "position": 0,
    "text": "ز اسبان جنگ آنچ بودش یله"
  },
  {
    "poem_id": 52171,
    "vorder": 116,
    "position": 1,
    "text": "بشهر اندر آورد چندی گله"
  },
  {
    "poem_id": 52171,
    "vorder": 117,
    "position": 0,
    "text": "بفرمود تا پهلوان سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 118,
    "position": 1,
    "text": "بخواهد هرآنچش بباید ز شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 119,
    "position": 0,
    "text": "چنین گفت بهرام را شهریار"
  },
  {
    "poem_id": 52171,
    "vorder": 120,
    "position": 1,
    "text": "که از هر دری دیده کارزار"
  },
  {
    "poem_id": 52171,
    "vorder": 121,
    "position": 0,
    "text": "شنیدی که با نامور ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 122,
    "position": 1,
    "text": "چه مایه سلیحست و گنج و سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 123,
    "position": 0,
    "text": "هم از جنگ ترکان او روز کین"
  },
  {
    "poem_id": 52171,
    "vorder": 124,
    "position": 1,
    "text": "به آوردگه بر بلرزد زمین"
  },
  {
    "poem_id": 52171,
    "vorder": 125,
    "position": 0,
    "text": "گزیدی ز لشکر ده و دو هزار"
  },
  {
    "poem_id": 52171,
    "vorder": 126,
    "position": 1,
    "text": "زره دار و بر گستوانور سوار"
  },
  {
    "poem_id": 52171,
    "vorder": 127,
    "position": 0,
    "text": "بدین مایه مردم به روز نبرد"
  },
  {
    "poem_id": 52171,
    "vorder": 128,
    "position": 1,
    "text": "ندانم که چون خیزد این کار کرد"
  },
  {
    "poem_id": 52171,
    "vorder": 129,
    "position": 0,
    "text": "به جای جوانان شمشیرزن"
  },
  {
    "poem_id": 52171,
    "vorder": 130,
    "position": 1,
    "text": "چهل سالگان خواستی ز انجمن"
  },
  {
    "poem_id": 52171,
    "vorder": 131,
    "position": 0,
    "text": "سپهبد چنین داد پاسخ بدوی"
  },
  {
    "poem_id": 52171,
    "vorder": 132,
    "position": 1,
    "text": "که ای شاه نیک اختر و راست گوی"
  },
  {
    "poem_id": 52171,
    "vorder": 133,
    "position": 0,
    "text": "شنیدستی آن داستان مهان"
  },
  {
    "poem_id": 52171,
    "vorder": 134,
    "position": 1,
    "text": "که در پیش بودند شاه جهان"
  },
  {
    "poem_id": 52171,
    "vorder": 135,
    "position": 0,
    "text": "که چون بخت پیروز یاور بود"
  },
  {
    "poem_id": 52171,
    "vorder": 136,
    "position": 1,
    "text": "روا باشد ار یار کمتر بود"
  },
  {
    "poem_id": 52171,
    "vorder": 137,
    "position": 0,
    "text": "برین داستان نیز دارم گوا"
  },
  {
    "poem_id": 52171,
    "vorder": 138,
    "position": 1,
    "text": "اگر بشنود شاه فرمانروا"
  },
  {
    "poem_id": 52171,
    "vorder": 139,
    "position": 0,
    "text": "که کاوس کی را بهاماوران"
  },
  {
    "poem_id": 52171,
    "vorder": 140,
    "position": 1,
    "text": "ببستند با لشکری بی‌کران"
  },
  {
    "poem_id": 52171,
    "vorder": 141,
    "position": 0,
    "text": "گزین کرد رستم ده و دو هزار"
  },
  {
    "poem_id": 52171,
    "vorder": 142,
    "position": 1,
    "text": "ز شایسته مردان گرد وسوا ر"
  },
  {
    "poem_id": 52171,
    "vorder": 143,
    "position": 0,
    "text": "بیاورد کاوس کی را ز بند"
  },
  {
    "poem_id": 52171,
    "vorder": 144,
    "position": 1,
    "text": "بران نامداران نیامد گزند"
  },
  {
    "poem_id": 52171,
    "vorder": 145,
    "position": 0,
    "text": "همان نیز گودرز کشوادگان"
  },
  {
    "poem_id": 52171,
    "vorder": 146,
    "position": 1,
    "text": "سرنامداران آزادگان"
  },
  {
    "poem_id": 52171,
    "vorder": 147,
    "position": 0,
    "text": "به کین سیاوش ده و دو هزار"
  },
  {
    "poem_id": 52171,
    "vorder": 148,
    "position": 1,
    "text": "بیاورد برگستوانور سوار"
  },
  {
    "poem_id": 52171,
    "vorder": 149,
    "position": 0,
    "text": "همان نیز پر مایه اسفندیار"
  },
  {
    "poem_id": 52171,
    "vorder": 150,
    "position": 1,
    "text": "بیاورد جنگی ده و دو هزا ر"
  },
  {
    "poem_id": 52171,
    "vorder": 151,
    "position": 0,
    "text": "به ارجاسب بر چاره کرد آنچه کرد"
  },
  {
    "poem_id": 52171,
    "vorder": 152,
    "position": 1,
    "text": "از آن لشکر و دژ برآورد گرد"
  },
  {
    "poem_id": 52171,
    "vorder": 153,
    "position": 0,
    "text": "از این مایه گر لشکر افزون بود"
  },
  {
    "poem_id": 52171,
    "vorder": 154,
    "position": 1,
    "text": "ز مردی و از رای بیرون بود"
  },
  {
    "poem_id": 52171,
    "vorder": 155,
    "position": 0,
    "text": "سپهبد که لشکر فزون ازسه چار"
  },
  {
    "poem_id": 52171,
    "vorder": 156,
    "position": 1,
    "text": "به جنگ آورد پیچد از کار زار"
  },
  {
    "poem_id": 52171,
    "vorder": 157,
    "position": 0,
    "text": "دگر آنک گفتی چهل ساله مرد"
  },
  {
    "poem_id": 52171,
    "vorder": 158,
    "position": 1,
    "text": "ز برنا فزونتر نجوید نبرد"
  },
  {
    "poem_id": 52171,
    "vorder": 159,
    "position": 0,
    "text": "چهل ساله با آزمایش بود"
  },
  {
    "poem_id": 52171,
    "vorder": 160,
    "position": 1,
    "text": "به مردانگی در فزایش بود"
  },
  {
    "poem_id": 52171,
    "vorder": 161,
    "position": 0,
    "text": "بیاد آیدش مهر نان و نمک"
  },
  {
    "poem_id": 52171,
    "vorder": 162,
    "position": 1,
    "text": "برو گشته باشد فراوان فلک"
  },
  {
    "poem_id": 52171,
    "vorder": 163,
    "position": 0,
    "text": "ز گفتار بدگوی وز نام و ننگ"
  },
  {
    "poem_id": 52171,
    "vorder": 164,
    "position": 1,
    "text": "هراسان بود سر نپیچد ز جنگ"
  },
  {
    "poem_id": 52171,
    "vorder": 165,
    "position": 0,
    "text": "زبهر زن و زاده و دوده را"
  },
  {
    "poem_id": 52171,
    "vorder": 166,
    "position": 1,
    "text": "بپیچد روان مرد فرسوده را"
  },
  {
    "poem_id": 52171,
    "vorder": 167,
    "position": 0,
    "text": "جوان چیز بیند پذیرد فریب"
  },
  {
    "poem_id": 52171,
    "vorder": 168,
    "position": 1,
    "text": "بگاه درنگش نباشد شکیب"
  },
  {
    "poem_id": 52171,
    "vorder": 169,
    "position": 0,
    "text": "ندارد زن و کودک و کشت و ورز"
  },
  {
    "poem_id": 52171,
    "vorder": 170,
    "position": 1,
    "text": "بچیزی ندارد ز نا ارز ارز"
  },
  {
    "poem_id": 52171,
    "vorder": 171,
    "position": 0,
    "text": "چو بی آزمایش نیابد خرد"
  },
  {
    "poem_id": 52171,
    "vorder": 172,
    "position": 1,
    "text": "سرمایه کارها ننگرد"
  },
  {
    "poem_id": 52171,
    "vorder": 173,
    "position": 0,
    "text": "گر ای دون که‌ پیروز گردد به جنگ"
  },
  {
    "poem_id": 52171,
    "vorder": 174,
    "position": 1,
    "text": "شود شاد وخندان وسازد درنگ"
  },
  {
    "poem_id": 52171,
    "vorder": 175,
    "position": 0,
    "text": "وگر هیچ پیروز شد بر تنش"
  },
  {
    "poem_id": 52171,
    "vorder": 176,
    "position": 1,
    "text": "نبیند جز از پشت او دشمنش"
  },
  {
    "poem_id": 52171,
    "vorder": 177,
    "position": 0,
    "text": "چو بشنید گفتار او شهریار"
  },
  {
    "poem_id": 52171,
    "vorder": 178,
    "position": 1,
    "text": "چنان تازه شد چون گل اندر بهار"
  },
  {
    "poem_id": 52171,
    "vorder": 179,
    "position": 0,
    "text": "بدو گفت رو جوشن کارزار"
  },
  {
    "poem_id": 52171,
    "vorder": 180,
    "position": 1,
    "text": "بپوش و ز ایوان به میدان گذار"
  },
  {
    "poem_id": 52171,
    "vorder": 181,
    "position": 0,
    "text": "سپهبد بیامد زنزدیک شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 182,
    "position": 1,
    "text": "کمر خواست و خفتان و درع و کلاه"
  },
  {
    "poem_id": 52171,
    "vorder": 183,
    "position": 0,
    "text": "برافگند برگستوان بر سمند"
  },
  {
    "poem_id": 52171,
    "vorder": 184,
    "position": 1,
    "text": "بفتراک بر بست پیچان کمند"
  },
  {
    "poem_id": 52171,
    "vorder": 185,
    "position": 0,
    "text": "جهان جوی با گوی و چوگان و تیر"
  },
  {
    "poem_id": 52171,
    "vorder": 186,
    "position": 1,
    "text": "به میدان خرامید خود با وزیر"
  },
  {
    "poem_id": 52171,
    "vorder": 187,
    "position": 0,
    "text": "سپهبد بیامد به میدان شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 188,
    "position": 1,
    "text": "بغلتید در خاک پیش سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 189,
    "position": 0,
    "text": "چو دیدش جهاندار کرد آفرین"
  },
  {
    "poem_id": 52171,
    "vorder": 190,
    "position": 1,
    "text": "سپهبد ببوسید روی زمین"
  },
  {
    "poem_id": 52171,
    "vorder": 191,
    "position": 0,
    "text": "بیاورد پس شهریار آن درفش"
  },
  {
    "poem_id": 52171,
    "vorder": 192,
    "position": 1,
    "text": "که بُد پیکرش اژدهافش بنفش"
  },
  {
    "poem_id": 52171,
    "vorder": 193,
    "position": 0,
    "text": "که در پیش رستم بدی روز جنگ"
  },
  {
    "poem_id": 52171,
    "vorder": 194,
    "position": 1,
    "text": "سبک شاه ایران گرفت آن به چنگ"
  },
  {
    "poem_id": 52171,
    "vorder": 195,
    "position": 0,
    "text": "چو ببسود خندان به بهرام داد"
  },
  {
    "poem_id": 52171,
    "vorder": 196,
    "position": 1,
    "text": "فراوان بر او آفرین کرد یاد"
  },
  {
    "poem_id": 52171,
    "vorder": 197,
    "position": 0,
    "text": "به بهرام گفت آنک جدان من"
  },
  {
    "poem_id": 52171,
    "vorder": 198,
    "position": 1,
    "text": "همی‌خواندندش سر انجمن"
  },
  {
    "poem_id": 52171,
    "vorder": 199,
    "position": 0,
    "text": "کجا نام او رستم پهلوان"
  },
  {
    "poem_id": 52171,
    "vorder": 200,
    "position": 1,
    "text": "جهانگیر و پیروز و روشن روان"
  },
  {
    "poem_id": 52171,
    "vorder": 201,
    "position": 0,
    "text": "درفش ویست این که داری بدست"
  },
  {
    "poem_id": 52171,
    "vorder": 202,
    "position": 1,
    "text": "که پیروز بادی وخسروپرست"
  },
  {
    "poem_id": 52171,
    "vorder": 203,
    "position": 0,
    "text": "گمانم که تو رستم دیگری"
  },
  {
    "poem_id": 52171,
    "vorder": 204,
    "position": 1,
    "text": "به مردی و گردی و فرمانبری"
  },
  {
    "poem_id": 52171,
    "vorder": 205,
    "position": 0,
    "text": "برو آفرین کرد پس پهلوان"
  },
  {
    "poem_id": 52171,
    "vorder": 206,
    "position": 1,
    "text": "که پیروزگر باش و روشن روان"
  },
  {
    "poem_id": 52171,
    "vorder": 207,
    "position": 0,
    "text": "ز میدان بیامد بجای نشست"
  },
  {
    "poem_id": 52171,
    "vorder": 208,
    "position": 1,
    "text": "سپهبد درفش تهمتن بدست"
  },
  {
    "poem_id": 52171,
    "vorder": 209,
    "position": 0,
    "text": "پراگنده گشتند گردان شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 210,
    "position": 1,
    "text": "همان شادمان پهلوان سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 211,
    "position": 0,
    "text": "سپیده چو برزد سر از کوه بر"
  },
  {
    "poem_id": 52171,
    "vorder": 212,
    "position": 1,
    "text": "پدید آمد آن زرد رخشان سپر"
  },
  {
    "poem_id": 52171,
    "vorder": 213,
    "position": 0,
    "text": "سپهبد بیامد بایوان شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 214,
    "position": 1,
    "text": "بکش کرده دست اندر آن بارگاه"
  },
  {
    "poem_id": 52171,
    "vorder": 215,
    "position": 0,
    "text": "بدو گفت من بی‌بهانه شدم"
  },
  {
    "poem_id": 52171,
    "vorder": 216,
    "position": 1,
    "text": "بفر تو تاج زمانه شدم"
  },
  {
    "poem_id": 52171,
    "vorder": 217,
    "position": 0,
    "text": "یکی آرزو خواهم از شهریار"
  },
  {
    "poem_id": 52171,
    "vorder": 218,
    "position": 1,
    "text": "که با من فرستد یکی استوار"
  },
  {
    "poem_id": 52171,
    "vorder": 219,
    "position": 0,
    "text": "که تا هر کسی کو نبرد آورد"
  },
  {
    "poem_id": 52171,
    "vorder": 220,
    "position": 1,
    "text": "سر دشمنی زیر گرد آورد"
  },
  {
    "poem_id": 52171,
    "vorder": 221,
    "position": 0,
    "text": "نویسد بنامه درون نام اوی"
  },
  {
    "poem_id": 52171,
    "vorder": 222,
    "position": 1,
    "text": "رونده شود در جهان کام اوی"
  },
  {
    "poem_id": 52171,
    "vorder": 223,
    "position": 0,
    "text": "چنین گفت هرمزد که مهران دبیر"
  },
  {
    "poem_id": 52171,
    "vorder": 224,
    "position": 1,
    "text": "جوانست و گوینده و یادگیر"
  },
  {
    "poem_id": 52171,
    "vorder": 225,
    "position": 0,
    "text": "بفرمود تا با سپهبد برفت"
  },
  {
    "poem_id": 52171,
    "vorder": 226,
    "position": 1,
    "text": "سپهبد سوی جنگ تازید تفت"
  },
  {
    "poem_id": 52171,
    "vorder": 227,
    "position": 0,
    "text": "بشد لشکر از کشور طیسفون"
  },
  {
    "poem_id": 52171,
    "vorder": 228,
    "position": 1,
    "text": "سپهدار بهرام پیش اندرون"
  },
  {
    "poem_id": 52171,
    "vorder": 229,
    "position": 0,
    "text": "سپاهی خردمند و گرد و دلیر"
  },
  {
    "poem_id": 52171,
    "vorder": 230,
    "position": 1,
    "text": "سپهدار بیدار چون نره شیر"
  },
  {
    "poem_id": 52171,
    "vorder": 231,
    "position": 0,
    "text": "به موبد چنین گفت هرمز که مرد"
  },
  {
    "poem_id": 52171,
    "vorder": 232,
    "position": 1,
    "text": "دلیرست و شادان به دشت نبرد"
  },
  {
    "poem_id": 52171,
    "vorder": 233,
    "position": 0,
    "text": "ازان پس چه گویی چه شاید بدن"
  },
  {
    "poem_id": 52171,
    "vorder": 234,
    "position": 1,
    "text": "همه داستانها بباید زدن"
  },
  {
    "poem_id": 52171,
    "vorder": 235,
    "position": 0,
    "text": "بدو گفت موبد که جاوید زی"
  },
  {
    "poem_id": 52171,
    "vorder": 236,
    "position": 1,
    "text": "که خود جاودان زندگی را سزی"
  },
  {
    "poem_id": 52171,
    "vorder": 237,
    "position": 0,
    "text": "بدین برز و بالای این پهلوان"
  },
  {
    "poem_id": 52171,
    "vorder": 238,
    "position": 1,
    "text": "بدین تیزگفتار روشن روان"
  },
  {
    "poem_id": 52171,
    "vorder": 239,
    "position": 0,
    "text": "نباشد مگر شاد و پیروزگر"
  },
  {
    "poem_id": 52171,
    "vorder": 240,
    "position": 1,
    "text": "وزو دشمن شاه زیر و زبر"
  },
  {
    "poem_id": 52171,
    "vorder": 241,
    "position": 0,
    "text": "بترسم که او هم به فرجام کار"
  },
  {
    "poem_id": 52171,
    "vorder": 242,
    "position": 1,
    "text": "بپیچد سر از شاه پرودگار"
  },
  {
    "poem_id": 52171,
    "vorder": 243,
    "position": 0,
    "text": "همی درسخن بس دلیری نمود"
  },
  {
    "poem_id": 52171,
    "vorder": 244,
    "position": 1,
    "text": "به گفتار با شاه شیری نمود"
  },
  {
    "poem_id": 52171,
    "vorder": 245,
    "position": 0,
    "text": "بدو گفت هرمز که در پای زهر"
  },
  {
    "poem_id": 52171,
    "vorder": 246,
    "position": 1,
    "text": "میالای زهرای بداندیش دهر"
  },
  {
    "poem_id": 52171,
    "vorder": 247,
    "position": 0,
    "text": "چون اوگشت پیروز بر ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 248,
    "position": 1,
    "text": "سزد گر سپارم بدو تاج وگاه"
  },
  {
    "poem_id": 52171,
    "vorder": 249,
    "position": 0,
    "text": "چنین باد و هرگز مبادا جز این"
  },
  {
    "poem_id": 52171,
    "vorder": 250,
    "position": 1,
    "text": "که او شهریاری شود بافرین"
  },
  {
    "poem_id": 52171,
    "vorder": 251,
    "position": 0,
    "text": "چوموبد ز شاه این سخنها شنید"
  },
  {
    "poem_id": 52171,
    "vorder": 252,
    "position": 1,
    "text": "بپژمرد و لب را بدندان گزید"
  },
  {
    "poem_id": 52171,
    "vorder": 253,
    "position": 0,
    "text": "همی‌داشت اندر دل این شهریار"
  },
  {
    "poem_id": 52171,
    "vorder": 254,
    "position": 1,
    "text": "چنین تا بر آمد برین روزگار"
  },
  {
    "poem_id": 52171,
    "vorder": 255,
    "position": 0,
    "text": "ز درگه یکی راز داری بجست"
  },
  {
    "poem_id": 52171,
    "vorder": 256,
    "position": 1,
    "text": "که تا این سخن بازجوید درست"
  },
  {
    "poem_id": 52171,
    "vorder": 257,
    "position": 0,
    "text": "بدو گفت تیز از پس پهلوان"
  },
  {
    "poem_id": 52171,
    "vorder": 258,
    "position": 1,
    "text": "برو تا چه بینی به من بر بخوان"
  },
  {
    "poem_id": 52171,
    "vorder": 259,
    "position": 0,
    "text": "بیامد سخنگوی پویان ز پس"
  },
  {
    "poem_id": 52171,
    "vorder": 260,
    "position": 1,
    "text": "نبود آگه از کار او هیچکس"
  },
  {
    "poem_id": 52171,
    "vorder": 261,
    "position": 0,
    "text": "که هم راهبر بود و هم فال گوی"
  },
  {
    "poem_id": 52171,
    "vorder": 262,
    "position": 1,
    "text": "سرانجام هر کار گفتی بدوی"
  },
  {
    "poem_id": 52171,
    "vorder": 263,
    "position": 0,
    "text": "چو بهرام بیرون شد از طیسفون"
  },
  {
    "poem_id": 52171,
    "vorder": 264,
    "position": 1,
    "text": "همی‌راند با نیزه پیش اندرون"
  },
  {
    "poem_id": 52171,
    "vorder": 265,
    "position": 0,
    "text": "به پیش آمدش سر فروشی به راه"
  },
  {
    "poem_id": 52171,
    "vorder": 266,
    "position": 1,
    "text": "ازو دور بد پهلوان سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 267,
    "position": 0,
    "text": "یکی خوانچه بر سر به پیوسته داشت"
  },
  {
    "poem_id": 52171,
    "vorder": 268,
    "position": 1,
    "text": "بروبر فراوان سرشسته داشت"
  },
  {
    "poem_id": 52171,
    "vorder": 269,
    "position": 0,
    "text": "سپهبد برانگیخت اسب از شگفت"
  },
  {
    "poem_id": 52171,
    "vorder": 270,
    "position": 1,
    "text": "بنوک سنان زان سری برگرفت"
  },
  {
    "poem_id": 52171,
    "vorder": 271,
    "position": 0,
    "text": "همی‌راند تا نیزه برداشت راست"
  },
  {
    "poem_id": 52171,
    "vorder": 272,
    "position": 1,
    "text": "بینداخت آنرا بران سو که خواست"
  },
  {
    "poem_id": 52171,
    "vorder": 273,
    "position": 0,
    "text": "یکی اختری کرد زان سر به راه"
  },
  {
    "poem_id": 52171,
    "vorder": 274,
    "position": 1,
    "text": "کزین سان ببرم سر ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 275,
    "position": 0,
    "text": "به پیش سپاهش به راه افگنم"
  },
  {
    "poem_id": 52171,
    "vorder": 276,
    "position": 1,
    "text": "همه لشکرش را بهم بر زنم"
  },
  {
    "poem_id": 52171,
    "vorder": 277,
    "position": 0,
    "text": "فرستادهٔ شاه چون آن بدید"
  },
  {
    "poem_id": 52171,
    "vorder": 278,
    "position": 1,
    "text": "پی افگند فالی چنان چون سزید"
  },
  {
    "poem_id": 52171,
    "vorder": 279,
    "position": 0,
    "text": "چنین گفت کین مرد پیروزبخت"
  },
  {
    "poem_id": 52171,
    "vorder": 280,
    "position": 1,
    "text": "بیابد به فرجام زین رنج تخت"
  },
  {
    "poem_id": 52171,
    "vorder": 281,
    "position": 0,
    "text": "ازان پس چو کام دل آرد بمشت"
  },
  {
    "poem_id": 52171,
    "vorder": 282,
    "position": 1,
    "text": "بپیچد سر از شاه و گردد درشت"
  },
  {
    "poem_id": 52171,
    "vorder": 283,
    "position": 0,
    "text": "بیامد برشاه و این را بگفت"
  },
  {
    "poem_id": 52171,
    "vorder": 284,
    "position": 1,
    "text": "جهاندار با درد وغم گشت جفت"
  },
  {
    "poem_id": 52171,
    "vorder": 285,
    "position": 0,
    "text": "ورا آن سخن بتر آمد ز مرگ"
  },
  {
    "poem_id": 52171,
    "vorder": 286,
    "position": 1,
    "text": "بپژمرد و شد تیره آن سبز برگ"
  },
  {
    "poem_id": 52171,
    "vorder": 287,
    "position": 0,
    "text": "فرستاده‌ای خواست از در جوان"
  },
  {
    "poem_id": 52171,
    "vorder": 288,
    "position": 1,
    "text": "فرستاد تازان پس پهلوان"
  },
  {
    "poem_id": 52171,
    "vorder": 289,
    "position": 0,
    "text": "بدو گفت رو با سپهبد بگوی"
  },
  {
    "poem_id": 52171,
    "vorder": 290,
    "position": 1,
    "text": "که امشب ز جایی که هستی مپوی"
  },
  {
    "poem_id": 52171,
    "vorder": 291,
    "position": 0,
    "text": "به شبگیر برگرد و پیش من آی"
  },
  {
    "poem_id": 52171,
    "vorder": 292,
    "position": 1,
    "text": "تهی کرد خواهم ز بیگانه جای"
  },
  {
    "poem_id": 52171,
    "vorder": 293,
    "position": 0,
    "text": "بگویم بتو هرچ آید ز پند"
  },
  {
    "poem_id": 52171,
    "vorder": 294,
    "position": 1,
    "text": "سخن چند یاد آمدم سودمند"
  },
  {
    "poem_id": 52171,
    "vorder": 295,
    "position": 0,
    "text": "فرستاده آمد بر پهلوان"
  },
  {
    "poem_id": 52171,
    "vorder": 296,
    "position": 1,
    "text": "بگفت آنچ بشنید مرد جوان"
  },
  {
    "poem_id": 52171,
    "vorder": 297,
    "position": 0,
    "text": "چنین داد پاسخ که لشکر ز راه"
  },
  {
    "poem_id": 52171,
    "vorder": 298,
    "position": 1,
    "text": "نخوانند باز ای خردمند شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 299,
    "position": 0,
    "text": "زره بازگشتن بد آید بفال"
  },
  {
    "poem_id": 52171,
    "vorder": 300,
    "position": 1,
    "text": "به نیرو شود زین سخن بدسگال"
  },
  {
    "poem_id": 52171,
    "vorder": 301,
    "position": 0,
    "text": "چو پیروز گردم بیایم برت"
  },
  {
    "poem_id": 52171,
    "vorder": 302,
    "position": 1,
    "text": "درفشان کنم لشکر و کشورت"
  },
  {
    "poem_id": 52171,
    "vorder": 303,
    "position": 0,
    "text": "فرستاده آمد به نزدیک شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 304,
    "position": 1,
    "text": "بگفت آنچه بشنید زان رزمخواه"
  },
  {
    "poem_id": 52171,
    "vorder": 305,
    "position": 0,
    "text": "ز گفتار اوشاه خشنود گشت"
  },
  {
    "poem_id": 52171,
    "vorder": 306,
    "position": 1,
    "text": "همه رنج پوینده بی‌سودگشت"
  },
  {
    "poem_id": 52171,
    "vorder": 307,
    "position": 0,
    "text": "سپهدار شبگیر لشکر براند"
  },
  {
    "poem_id": 52171,
    "vorder": 308,
    "position": 1,
    "text": "بر ایشان همی نام یزدان بخواند"
  },
  {
    "poem_id": 52171,
    "vorder": 309,
    "position": 0,
    "text": "همی‌رفت تا کشور خوزیان"
  },
  {
    "poem_id": 52171,
    "vorder": 310,
    "position": 1,
    "text": "ز لشکر کسی را نیامد زیان"
  },
  {
    "poem_id": 52171,
    "vorder": 311,
    "position": 0,
    "text": "زنی با جوالی میان پر ز کاه"
  },
  {
    "poem_id": 52171,
    "vorder": 312,
    "position": 1,
    "text": "همی‌رفت پویان میان سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 313,
    "position": 0,
    "text": "سواری بیامد خرید آن جوال"
  },
  {
    "poem_id": 52171,
    "vorder": 314,
    "position": 1,
    "text": "ندادش بها و بپیچید یال"
  },
  {
    "poem_id": 52171,
    "vorder": 315,
    "position": 0,
    "text": "خروشان بیامد ببهرام گفت"
  },
  {
    "poem_id": 52171,
    "vorder": 316,
    "position": 1,
    "text": "که کاهست لختی مرا در نهفت"
  },
  {
    "poem_id": 52171,
    "vorder": 317,
    "position": 0,
    "text": "بهای جوالی همی‌داشتم"
  },
  {
    "poem_id": 52171,
    "vorder": 318,
    "position": 1,
    "text": "به پیش سپاه تو بگذاشتم"
  },
  {
    "poem_id": 52171,
    "vorder": 319,
    "position": 0,
    "text": "کنون بستد ازمن سواری به راه"
  },
  {
    "poem_id": 52171,
    "vorder": 320,
    "position": 1,
    "text": "که دارد به سر بر ز آهن کلاه"
  },
  {
    "poem_id": 52171,
    "vorder": 321,
    "position": 0,
    "text": "بجستند آن مرد را در زمان"
  },
  {
    "poem_id": 52171,
    "vorder": 322,
    "position": 1,
    "text": "کشیدند نزد سپهبد دمان"
  },
  {
    "poem_id": 52171,
    "vorder": 323,
    "position": 0,
    "text": "ستاننده را گفت بهرام گرد"
  },
  {
    "poem_id": 52171,
    "vorder": 324,
    "position": 1,
    "text": "گناهی که کردی سرت را ببرد"
  },
  {
    "poem_id": 52171,
    "vorder": 325,
    "position": 0,
    "text": "دوانش به پیش سراپرده برد"
  },
  {
    "poem_id": 52171,
    "vorder": 326,
    "position": 1,
    "text": "سرو دست و پایش شکستند خرد"
  },
  {
    "poem_id": 52171,
    "vorder": 327,
    "position": 0,
    "text": "میانش به خنجر به دو نیم کرد"
  },
  {
    "poem_id": 52171,
    "vorder": 328,
    "position": 1,
    "text": "بدو مرد بیداد را بیم کرد"
  },
  {
    "poem_id": 52171,
    "vorder": 329,
    "position": 0,
    "text": "خروشی برآمد ز پرده سرای"
  },
  {
    "poem_id": 52171,
    "vorder": 330,
    "position": 1,
    "text": "که‌ای نامداران پاکیزه‌رای"
  },
  {
    "poem_id": 52171,
    "vorder": 331,
    "position": 0,
    "text": "هرآنکس که او برگ کاهی ز کس"
  },
  {
    "poem_id": 52171,
    "vorder": 332,
    "position": 1,
    "text": "ستاند نباشدش فریادرس"
  },
  {
    "poem_id": 52171,
    "vorder": 333,
    "position": 0,
    "text": "میانش به خنجر کنم به دونیم"
  },
  {
    "poem_id": 52171,
    "vorder": 334,
    "position": 1,
    "text": "بخرید چیزی که باید بسیم"
  },
  {
    "poem_id": 52171,
    "vorder": 335,
    "position": 0,
    "text": "همی‌بود ز اندیشه هرمز به رنج"
  },
  {
    "poem_id": 52171,
    "vorder": 336,
    "position": 1,
    "text": "ازان لشکرساوه و پیل و گنج"
  },
  {
    "poem_id": 52171,
    "vorder": 337,
    "position": 0,
    "text": "به دل بر چو اندیشه بسیارگشت"
  },
  {
    "poem_id": 52171,
    "vorder": 338,
    "position": 1,
    "text": "ز بهرام پر درد و تیمار گشت"
  },
  {
    "poem_id": 52171,
    "vorder": 339,
    "position": 0,
    "text": "روانش پر از غم دلش به دو نیم"
  },
  {
    "poem_id": 52171,
    "vorder": 340,
    "position": 1,
    "text": "همی‌داشتی زان به دل ترس و بیم"
  },
  {
    "poem_id": 52171,
    "vorder": 341,
    "position": 0,
    "text": "شب تیره بر زد سر از برج ماه"
  },
  {
    "poem_id": 52171,
    "vorder": 342,
    "position": 1,
    "text": "بخراد برزین چنین گفت شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 343,
    "position": 0,
    "text": "که بر ساز تا سوی دشمن شوی"
  },
  {
    "poem_id": 52171,
    "vorder": 344,
    "position": 1,
    "text": "بکوشی و ز تاختن نغنوی"
  },
  {
    "poem_id": 52171,
    "vorder": 345,
    "position": 0,
    "text": "سپاهش نگه کن که چند و چیند"
  },
  {
    "poem_id": 52171,
    "vorder": 346,
    "position": 1,
    "text": "سپهبد کدامند و گردان کیند"
  },
  {
    "poem_id": 52171,
    "vorder": 347,
    "position": 0,
    "text": "بفرمود تا نامهٔ پندمند"
  },
  {
    "poem_id": 52171,
    "vorder": 348,
    "position": 1,
    "text": "نبشتند نزدیک آن پر گزند"
  },
  {
    "poem_id": 52171,
    "vorder": 349,
    "position": 0,
    "text": "یکی نامه با هدیه شاهوار"
  },
  {
    "poem_id": 52171,
    "vorder": 350,
    "position": 1,
    "text": "که آن را نشاید گرفتن شمار"
  },
  {
    "poem_id": 52171,
    "vorder": 351,
    "position": 0,
    "text": "فرستاده را گفت سوی هری"
  },
  {
    "poem_id": 52171,
    "vorder": 352,
    "position": 1,
    "text": "همی رو چو پیدا شود لشکری"
  },
  {
    "poem_id": 52171,
    "vorder": 353,
    "position": 0,
    "text": "چنان دان که بهرام کنداورست"
  },
  {
    "poem_id": 52171,
    "vorder": 354,
    "position": 1,
    "text": "مپندار کان لشکری دیگرست"
  },
  {
    "poem_id": 52171,
    "vorder": 355,
    "position": 0,
    "text": "ازان راه نزدیک بهرام پوی"
  },
  {
    "poem_id": 52171,
    "vorder": 356,
    "position": 1,
    "text": "سخن هرچ بشنیدی آن را بگوی"
  },
  {
    "poem_id": 52171,
    "vorder": 357,
    "position": 0,
    "text": "بگویش که من با نوید و خرام"
  },
  {
    "poem_id": 52171,
    "vorder": 358,
    "position": 1,
    "text": "بگسترد خواهم یکی خوب دام"
  },
  {
    "poem_id": 52171,
    "vorder": 359,
    "position": 0,
    "text": "نباید که پیدا شود راز تو"
  },
  {
    "poem_id": 52171,
    "vorder": 360,
    "position": 1,
    "text": "گر او بشنود نام و آواز تو"
  },
  {
    "poem_id": 52171,
    "vorder": 361,
    "position": 0,
    "text": "من او را بدامت فراز آورم"
  },
  {
    "poem_id": 52171,
    "vorder": 362,
    "position": 1,
    "text": "سخنهای چرب و دراز آورم"
  },
  {
    "poem_id": 52171,
    "vorder": 363,
    "position": 0,
    "text": "برآراست خراد برزین به راه"
  },
  {
    "poem_id": 52171,
    "vorder": 364,
    "position": 1,
    "text": "بیامد بران سو که فرمود شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 365,
    "position": 0,
    "text": "چو بهرام را دید با او بگفت"
  },
  {
    "poem_id": 52171,
    "vorder": 366,
    "position": 1,
    "text": "سخنها کجا داشت اندر نهفت"
  },
  {
    "poem_id": 52171,
    "vorder": 367,
    "position": 0,
    "text": "وزان جایگه شد سوی ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 368,
    "position": 1,
    "text": "بجایی که بد گنج و پیل و سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 369,
    "position": 0,
    "text": "ورا دید بستود و بردش نماز"
  },
  {
    "poem_id": 52171,
    "vorder": 370,
    "position": 1,
    "text": "شنیده همی‌گفت با او به راز"
  },
  {
    "poem_id": 52171,
    "vorder": 371,
    "position": 0,
    "text": "بیفزود پیغامش از هر دری"
  },
  {
    "poem_id": 52171,
    "vorder": 372,
    "position": 1,
    "text": "بدان تا شود لشکر اندر هری"
  },
  {
    "poem_id": 52171,
    "vorder": 373,
    "position": 0,
    "text": "چوآمد به دشت هری نامدار"
  },
  {
    "poem_id": 52171,
    "vorder": 374,
    "position": 1,
    "text": "سراپرده زد بر لب جویبار"
  },
  {
    "poem_id": 52171,
    "vorder": 375,
    "position": 0,
    "text": "طلایه بیامد ز لشکر به راه"
  },
  {
    "poem_id": 52171,
    "vorder": 376,
    "position": 1,
    "text": "بدیدند بهرام را با سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 377,
    "position": 0,
    "text": "طلایه بدید آن دلاور سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 378,
    "position": 1,
    "text": "بیامد دوان تا بر ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 379,
    "position": 0,
    "text": "بگفت آنک با نامور مهتری"
  },
  {
    "poem_id": 52171,
    "vorder": 380,
    "position": 1,
    "text": "یکی لشکر آمد به دشت هری"
  },
  {
    "poem_id": 52171,
    "vorder": 381,
    "position": 0,
    "text": "سخنها چو بشنید زو ساوه شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 382,
    "position": 1,
    "text": "پر اندیشه شد مرد جوینده راه"
  },
  {
    "poem_id": 52171,
    "vorder": 383,
    "position": 0,
    "text": "ز خیمه فرستاده را باز خواند"
  },
  {
    "poem_id": 52171,
    "vorder": 384,
    "position": 1,
    "text": "به تندی فراوان سخنها براند"
  },
  {
    "poem_id": 52171,
    "vorder": 385,
    "position": 0,
    "text": "بدو گفت کای ریمن پر فریب"
  },
  {
    "poem_id": 52171,
    "vorder": 386,
    "position": 1,
    "text": "مگر کز فرازی ندیدی نشیب"
  },
  {
    "poem_id": 52171,
    "vorder": 387,
    "position": 0,
    "text": "برفتی ز درگاه آن خوارشاه"
  },
  {
    "poem_id": 52171,
    "vorder": 388,
    "position": 1,
    "text": "بدان تا مرا دام سازی به راه"
  },
  {
    "poem_id": 52171,
    "vorder": 389,
    "position": 0,
    "text": "به جنگ آوری پارسی لشکری"
  },
  {
    "poem_id": 52171,
    "vorder": 390,
    "position": 1,
    "text": "زنی خیمه در مرغزار هری"
  },
  {
    "poem_id": 52171,
    "vorder": 391,
    "position": 0,
    "text": "چنین گفت خراد برزین به شاه"
  },
  {
    "poem_id": 52171,
    "vorder": 392,
    "position": 1,
    "text": "که پیش سپاه تو اندک سپاه"
  },
  {
    "poem_id": 52171,
    "vorder": 393,
    "position": 0,
    "text": "گر آید بزشتی گمانی مبر"
  },
  {
    "poem_id": 52171,
    "vorder": 394,
    "position": 1,
    "text": "که این مرزبانی بود بر گذر"
  },
  {
    "poem_id": 52171,
    "vorder": 395,
    "position": 0,
    "text": "وگر زینهاری یکی نامجوی"
  },
  {
    "poem_id": 52171,
    "vorder": 396,
    "position": 1,
    "text": "ز کشور سوی شاه بنهاد روی"
  },
  {
    "poem_id": 52171,
    "vorder": 397,
    "position": 0,
