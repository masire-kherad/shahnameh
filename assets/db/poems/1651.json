[
  {
    "poem_id": 1651,
    "vorder": 1,
    "position": 0,
    "text": "چو شد کار آن سروبن ساخته"
  },
  {
    "poem_id": 1651,
    "vorder": 2,
    "position": 1,
    "text": "به آیین او جای پرداخته"
  },
  {
    "poem_id": 1651,
    "vorder": 3,
    "position": 0,
    "text": "بپردخت ازان پس به داننده مرد"
  },
  {
    "poem_id": 1651,
    "vorder": 4,
    "position": 1,
    "text": "که چون خیزد از دانش اندر نبرد"
  },
  {
    "poem_id": 1651,
    "vorder": 5,
    "position": 0,
    "text": "پر از روغن گاو جامی بزرگ"
  },
  {
    "poem_id": 1651,
    "vorder": 6,
    "position": 1,
    "text": "فرستاد زی فیلسوف سترگ"
  },
  {
    "poem_id": 1651,
    "vorder": 7,
    "position": 0,
    "text": "که این را به اندام‌ها در بمال"
  },
  {
    "poem_id": 1651,
    "vorder": 8,
    "position": 1,
    "text": "سرون و میان و بر و پشت و یال"
  },
  {
    "poem_id": 1651,
    "vorder": 9,
    "position": 0,
    "text": "بیاسای تا ماندگی بفگنی"
  },
  {
    "poem_id": 1651,
    "vorder": 10,
    "position": 1,
    "text": "به دانش مرا جان و مغز آگنی"
  },
  {
    "poem_id": 1651,
    "vorder": 11,
    "position": 0,
    "text": "چو دانا به روغن نگه کرد گفت"
  },
  {
    "poem_id": 1651,
    "vorder": 12,
    "position": 1,
    "text": "که این بند بر من نشاید نهفت"
  },
  {
    "poem_id": 1651,
    "vorder": 13,
    "position": 0,
    "text": "به جام اندر افگند سوزن هزار"
  },
  {
    "poem_id": 1651,
    "vorder": 14,
    "position": 1,
    "text": "فرستاد بازش سوی شهریار"
  },
  {
    "poem_id": 1651,
    "vorder": 15,
    "position": 0,
    "text": "به سوزن نگه کرد شاه جهان"
  },
  {
    "poem_id": 1651,
    "vorder": 16,
    "position": 1,
    "text": "بیاورد آهنگران را نهان"
  },
  {
    "poem_id": 1651,
    "vorder": 17,
    "position": 0,
    "text": "بفرمود تا گرد بگداختند"
  },
  {
    "poem_id": 1651,
    "vorder": 18,
    "position": 1,
    "text": "از آهن یکی مهره‌ای ساختند"
  },
  {
    "poem_id": 1651,
    "vorder": 19,
    "position": 0,
    "text": "سوی مرد دانا فرستاد زود"
  },
  {
    "poem_id": 1651,
    "vorder": 20,
    "position": 1,
    "text": "چو دانا نگه کرد و آهن بسود"
  },
  {
    "poem_id": 1651,
    "vorder": 21,
    "position": 0,
    "text": "به ساعت ازان آهن تیره‌رنگ"
  },
  {
    "poem_id": 1651,
    "vorder": 22,
    "position": 1,
    "text": "یکی آینه ساخت روشن چو زنگ"
  },
  {
    "poem_id": 1651,
    "vorder": 23,
    "position": 0,
    "text": "ببردند نزد سکندر به شب"
  },
  {
    "poem_id": 1651,
    "vorder": 24,
    "position": 1,
    "text": "وزان راز نگشاد بر باد لب"
  },
  {
    "poem_id": 1651,
    "vorder": 25,
    "position": 0,
    "text": "سکندر نهاد آینه زیر نم"
  },
  {
    "poem_id": 1651,
    "vorder": 26,
    "position": 1,
    "text": "همی داشت تا شد سیاه و دژم"
  },
  {
    "poem_id": 1651,
    "vorder": 27,
    "position": 0,
    "text": "بر فیلسوفش فرستاد باز"
  },
  {
    "poem_id": 1651,
    "vorder": 28,
    "position": 1,
    "text": "بران کار شد رمز آهن دراز"
  },
  {
    "poem_id": 1651,
    "vorder": 29,
    "position": 0,
    "text": "خردمند بزدود آهن چو آب"
  },
  {
    "poem_id": 1651,
    "vorder": 30,
    "position": 1,
    "text": "فرستاد بازش هم اندر شتاب"
  },
  {
    "poem_id": 1651,
    "vorder": 31,
    "position": 0,
    "text": "ز دودش ز دارو کزان پس ز نم"
  },
  {
    "poem_id": 1651,
    "vorder": 32,
    "position": 1,
    "text": "نگردد به زودی سیاه و دژم"
  },
  {
    "poem_id": 1651,
    "vorder": 33,
    "position": 0,
    "text": "سکندر نگه کرد و او را بخواند"
  },
  {
    "poem_id": 1651,
    "vorder": 34,
    "position": 1,
    "text": "بپرسید و بر زیرگاهش نشاند"
  },
  {
    "poem_id": 1651,
    "vorder": 35,
    "position": 0,
    "text": "سخن گفتش از جام روغن نخست"
  },
  {
    "poem_id": 1651,
    "vorder": 36,
    "position": 1,
    "text": "همی دانش نامور بازجست"
  },
  {
    "poem_id": 1651,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت با شاه‌، مرد خرد"
  },
  {
    "poem_id": 1651,
    "vorder": 38,
    "position": 1,
    "text": "که روغن بر اندام‌ها بگذرد"
  },
  {
    "poem_id": 1651,
    "vorder": 39,
    "position": 0,
    "text": "تو گفتی که از فیلسوفان شهر"
  },
  {
    "poem_id": 1651,
    "vorder": 40,
    "position": 1,
    "text": "ز دانش مرا خود فزونست بهر"
  },
  {
    "poem_id": 1651,
    "vorder": 41,
    "position": 0,
    "text": "به پاسخ چنین گفتم ای پادشا"
  },
  {
    "poem_id": 1651,
    "vorder": 42,
    "position": 1,
    "text": "که دانا دل مردم پارسا"
  },
  {
    "poem_id": 1651,
    "vorder": 43,
    "position": 0,
    "text": "چو سوزن پی و استخوان بشمرد"
  },
  {
    "poem_id": 1651,
    "vorder": 44,
    "position": 1,
    "text": "اگر سنگ پیش آیدش بشکرد"
  },
  {
    "poem_id": 1651,
    "vorder": 45,
    "position": 0,
    "text": "به پاسخ به دانا چنین گفت شاه"
  },
  {
    "poem_id": 1651,
    "vorder": 46,
    "position": 1,
    "text": "که هر دل که آن گشته باشد سیاه"
  },
  {
    "poem_id": 1651,
    "vorder": 47,
    "position": 0,
    "text": "به بزم و به رزم و به خون ریختن"
  },
  {
    "poem_id": 1651,
    "vorder": 48,
    "position": 1,
    "text": "به هر جای با دشمن آویختن"
  },
  {
    "poem_id": 1651,
    "vorder": 49,
    "position": 0,
    "text": "سخن‌های باریک مرد خرد"
  },
  {
    "poem_id": 1651,
    "vorder": 50,
    "position": 1,
    "text": "چو دل تیره باشد کجا بگذرد"
  },
  {
    "poem_id": 1651,
    "vorder": 51,
    "position": 0,
    "text": "ترا گفتم این خوب گفتار خویش"
  },
  {
    "poem_id": 1651,
    "vorder": 52,
    "position": 1,
    "text": "روان و دل و رای هشیار خویش"
  },
  {
    "poem_id": 1651,
    "vorder": 53,
    "position": 0,
    "text": "سخن داند از موی باریک‌تر"
  },
  {
    "poem_id": 1651,
    "vorder": 54,
    "position": 1,
    "text": "ترا دل ز آهن نه تاریک‌تر"
  },
  {
    "poem_id": 1651,
    "vorder": 55,
    "position": 0,
    "text": "تو گفتی برین سالیان برگذشت"
  },
  {
    "poem_id": 1651,
    "vorder": 56,
    "position": 1,
    "text": "ز خون‌ها دلم پر ز زنگار گشت"
  },
  {
    "poem_id": 1651,
    "vorder": 57,
    "position": 0,
    "text": "چگونه به راه آید این تیرگی"
  },
  {
    "poem_id": 1651,
    "vorder": 58,
    "position": 1,
    "text": "چه پیچم سخن را بدین خیرگی"
  },
  {
    "poem_id": 1651,
    "vorder": 59,
    "position": 0,
    "text": "ترا گفتم از دانش آسمان"
  },
  {
    "poem_id": 1651,
    "vorder": 60,
    "position": 1,
    "text": "زدایم دلت تا شوی بی‌گمان"
  },
  {
    "poem_id": 1651,
    "vorder": 61,
    "position": 0,
    "text": "ازان پس که چون آب گردد به رنگ"
  },
  {
    "poem_id": 1651,
    "vorder": 62,
    "position": 1,
    "text": "کجا کرد باید بدو کار تنگ"
  },
  {
    "poem_id": 1651,
    "vorder": 63,
    "position": 0,
    "text": "پسند آمدش تازه گفتار اوی"
  },
  {
    "poem_id": 1651,
    "vorder": 64,
    "position": 1,
    "text": "دلش تیزتر گشت بر کار اوی"
  },
  {
    "poem_id": 1651,
    "vorder": 65,
    "position": 0,
    "text": "بفرمود تا جامه و سیم و زر"
  },
  {
    "poem_id": 1651,
    "vorder": 66,
    "position": 1,
    "text": "بیاورد گنجور جامی گهر"
  },
  {
    "poem_id": 1651,
    "vorder": 67,
    "position": 0,
    "text": "به دانا سپردند و داننده گفت"
  },
  {
    "poem_id": 1651,
    "vorder": 68,
    "position": 1,
    "text": "که من گوهری دارم اندر نهفت"
  },
  {
    "poem_id": 1651,
    "vorder": 69,
    "position": 0,
    "text": "که یابم بدو چیز و بی دشمن است"
  },
  {
    "poem_id": 1651,
    "vorder": 70,
    "position": 1,
    "text": "نه چون خواسته جفت آهرمن است"
  },
  {
    "poem_id": 1651,
    "vorder": 71,
    "position": 0,
    "text": "به شب پاسبانان نخواهند مزد"
  },
  {
    "poem_id": 1651,
    "vorder": 72,
    "position": 1,
    "text": "به راهی که باشم نترسم ز دزد"
  },
  {
    "poem_id": 1651,
    "vorder": 73,
    "position": 0,
    "text": "خرد باید و دانش و راستی"
  },
  {
    "poem_id": 1651,
    "vorder": 74,
    "position": 1,
    "text": "که کژی بکوبد در کاستی"
  },
  {
    "poem_id": 1651,
    "vorder": 75,
    "position": 0,
    "text": "مرا خورد و پوشیدنی زین جهان"
  },
  {
    "poem_id": 1651,
    "vorder": 76,
    "position": 1,
    "text": "بس از شهریار آشکار و نهان"
  },
  {
    "poem_id": 1651,
    "vorder": 77,
    "position": 0,
    "text": "که دانش به شب پاسبان منست"
  },
  {
    "poem_id": 1651,
    "vorder": 78,
    "position": 1,
    "text": "خرد تاج بیدار جان منست"
  },
  {
    "poem_id": 1651,
    "vorder": 79,
    "position": 0,
    "text": "به بیشی چرا شادمانی کنم"
  },
  {
    "poem_id": 1651,
    "vorder": 80,
    "position": 1,
    "text": "برین خواسته پاسبانی کنم"
  },
  {
    "poem_id": 1651,
    "vorder": 81,
    "position": 0,
    "text": "بفرمای تا این برد باز جای"
  },
  {
    "poem_id": 1651,
    "vorder": 82,
    "position": 1,
    "text": "خرد باد جان مرا رهنمای"
  },
  {
    "poem_id": 1651,
    "vorder": 83,
    "position": 0,
    "text": "سکندر بدو ماند اندر شگفت"
  },
  {
    "poem_id": 1651,
    "vorder": 84,
    "position": 1,
    "text": "ز هر گونه اندیشه‌ها برگرفت"
  },
  {
    "poem_id": 1651,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت زین پس مرا بر گناه"
  },
  {
    "poem_id": 1651,
    "vorder": 86,
    "position": 1,
    "text": "نگیرد خداوند خورشید و ماه"
  },
  {
    "poem_id": 1651,
    "vorder": 87,
    "position": 0,
    "text": "خریدارم این رای و پند ترا"
  },
  {
    "poem_id": 1651,
    "vorder": 88,
    "position": 1,
    "text": "سخن گفتن سودمند ترا"
  }
]