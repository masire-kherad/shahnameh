[
  {
    "poem_id": 1392,
    "vorder": 1,
    "position": 0,
    "text": "به مهراب و دستان رسید این سخن"
  },
  {
    "poem_id": 1392,
    "vorder": 2,
    "position": 1,
    "text": "که شاه و سپهبد فگندند بن"
  },
  {
    "poem_id": 1392,
    "vorder": 3,
    "position": 0,
    "text": "خروشان ز کابل همی رفت زال"
  },
  {
    "poem_id": 1392,
    "vorder": 4,
    "position": 1,
    "text": "فروهشته لفج و برآورده یال"
  },
  {
    "poem_id": 1392,
    "vorder": 5,
    "position": 0,
    "text": "همی گفت اگر اژدهای دژم"
  },
  {
    "poem_id": 1392,
    "vorder": 6,
    "position": 1,
    "text": "بیاید که گیتی بسوزد به دم"
  },
  {
    "poem_id": 1392,
    "vorder": 7,
    "position": 0,
    "text": "چو کابلستان را بخواهد بسود"
  },
  {
    "poem_id": 1392,
    "vorder": 8,
    "position": 1,
    "text": "نخستین سر من بباید درود"
  },
  {
    "poem_id": 1392,
    "vorder": 9,
    "position": 0,
    "text": "به پیش پدر شد پر از خون جگر"
  },
  {
    "poem_id": 1392,
    "vorder": 10,
    "position": 1,
    "text": "پر اندیشه دل پر ز گفتار سر"
  },
  {
    "poem_id": 1392,
    "vorder": 11,
    "position": 0,
    "text": "چو آگاهی آمد به سام دلیر"
  },
  {
    "poem_id": 1392,
    "vorder": 12,
    "position": 1,
    "text": "که آمد ز ره بچهٔ نره شیر"
  },
  {
    "poem_id": 1392,
    "vorder": 13,
    "position": 0,
    "text": "همه لشکر از جای برخاستند"
  },
  {
    "poem_id": 1392,
    "vorder": 14,
    "position": 1,
    "text": "درفش فریدون بیاراستند"
  },
  {
    "poem_id": 1392,
    "vorder": 15,
    "position": 0,
    "text": "پذیره شدن را تبیره زدند"
  },
  {
    "poem_id": 1392,
    "vorder": 16,
    "position": 1,
    "text": "سپاه و سپهبد پذیره شدند"
  },
  {
    "poem_id": 1392,
    "vorder": 17,
    "position": 0,
    "text": "همه پشت پیلان به رنگین درفش"
  },
  {
    "poem_id": 1392,
    "vorder": 18,
    "position": 1,
    "text": "بیاراسته سرخ و زرد و بنفش"
  },
  {
    "poem_id": 1392,
    "vorder": 19,
    "position": 0,
    "text": "چو روی پدر دید دستان سام"
  },
  {
    "poem_id": 1392,
    "vorder": 20,
    "position": 1,
    "text": "پیاده شد از اسپ و بگذارد گام"
  },
  {
    "poem_id": 1392,
    "vorder": 21,
    "position": 0,
    "text": "بزرگان پیاده شدند از دو روی"
  },
  {
    "poem_id": 1392,
    "vorder": 22,
    "position": 1,
    "text": "چه سالارخواه و چه سالارجوی"
  },
  {
    "poem_id": 1392,
    "vorder": 23,
    "position": 0,
    "text": "زمین را ببوسید زال دلیر"
  },
  {
    "poem_id": 1392,
    "vorder": 24,
    "position": 1,
    "text": "سخن گفت با او پدر نیز دیر"
  },
  {
    "poem_id": 1392,
    "vorder": 25,
    "position": 0,
    "text": "نشست از بر تازی اسپ سمند"
  },
  {
    "poem_id": 1392,
    "vorder": 26,
    "position": 1,
    "text": "چو زرین درخشنده کوهی بلند"
  },
  {
    "poem_id": 1392,
    "vorder": 27,
    "position": 0,
    "text": "بزرگان همه پیش او آمدند"
  },
  {
    "poem_id": 1392,
    "vorder": 28,
    "position": 1,
    "text": "به تیمار و با گفت و گو آمدند"
  },
  {
    "poem_id": 1392,
    "vorder": 29,
    "position": 0,
    "text": "که آزرده گشتست بر تو پدر"
  },
  {
    "poem_id": 1392,
    "vorder": 30,
    "position": 1,
    "text": "یکی پوزش آور مکش هیچ سر"
  },
  {
    "poem_id": 1392,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد پاسخ کزین باک نیست"
  },
  {
    "poem_id": 1392,
    "vorder": 32,
    "position": 1,
    "text": "سرانجام آخر به جز خاک نیست"
  },
  {
    "poem_id": 1392,
    "vorder": 33,
    "position": 0,
    "text": "پدر گر به مغز اندر آرد خرد"
  },
  {
    "poem_id": 1392,
    "vorder": 34,
    "position": 1,
    "text": "همانا سخن بر سخن نگذرد"
  },
  {
    "poem_id": 1392,
    "vorder": 35,
    "position": 0,
    "text": "و گر برگشاید زبان را به خشم"
  },
  {
    "poem_id": 1392,
    "vorder": 36,
    "position": 1,
    "text": "پس از شرمش آب اندر آرم به چشم"
  },
  {
    "poem_id": 1392,
    "vorder": 37,
    "position": 0,
    "text": "چنین تا به درگاه سام آمدند"
  },
  {
    "poem_id": 1392,
    "vorder": 38,
    "position": 1,
    "text": "گشاده‌دل و شادکام آمدند"
  },
  {
    "poem_id": 1392,
    "vorder": 39,
    "position": 0,
    "text": "فرود آمد از باره سام سوار"
  },
  {
    "poem_id": 1392,
    "vorder": 40,
    "position": 1,
    "text": "هم اندر زمان زال را داد بار"
  },
  {
    "poem_id": 1392,
    "vorder": 41,
    "position": 0,
    "text": "چو زال اندر آمد به پیش پدر"
  },
  {
    "poem_id": 1392,
    "vorder": 42,
    "position": 1,
    "text": "زمین را ببوسید و گسترد بر"
  },
  {
    "poem_id": 1392,
    "vorder": 43,
    "position": 0,
    "text": "یکی آفرین کرد بر سام گرد"
  },
  {
    "poem_id": 1392,
    "vorder": 44,
    "position": 1,
    "text": "وزاب دو نرگس همی گل سترد"
  },
  {
    "poem_id": 1392,
    "vorder": 45,
    "position": 0,
    "text": "که بیدار دل پهلوان شاد باد"
  },
  {
    "poem_id": 1392,
    "vorder": 46,
    "position": 1,
    "text": "روانش گرایندهٔ داد باد"
  },
  {
    "poem_id": 1392,
    "vorder": 47,
    "position": 0,
    "text": "ز تیغ تو الماس بریان شود"
  },
  {
    "poem_id": 1392,
    "vorder": 48,
    "position": 1,
    "text": "زمین روز جنگ از تو گریان شود"
  },
  {
    "poem_id": 1392,
    "vorder": 49,
    "position": 0,
    "text": "کجا دیزهٔ تو چمد روز جنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 50,
    "position": 1,
    "text": "شتاب آید اندر سپاه درنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 51,
    "position": 0,
    "text": "سپهری کجا باد گُرز تو دید"
  },
  {
    "poem_id": 1392,
    "vorder": 52,
    "position": 1,
    "text": "همانا ستاره نیارد کشید"
  },
  {
    "poem_id": 1392,
    "vorder": 53,
    "position": 0,
    "text": "زمین نَسپَرد شیر با داد تو"
  },
  {
    "poem_id": 1392,
    "vorder": 54,
    "position": 1,
    "text": "روان و خرد کشته بنیاد تو"
  },
  {
    "poem_id": 1392,
    "vorder": 55,
    "position": 0,
    "text": "همه مردم از داد تو شادمان"
  },
  {
    "poem_id": 1392,
    "vorder": 56,
    "position": 1,
    "text": "ز تو داد یابد زمین و زمان"
  },
  {
    "poem_id": 1392,
    "vorder": 57,
    "position": 0,
    "text": "مگر من که از داد بی‌بهره‌ام"
  },
  {
    "poem_id": 1392,
    "vorder": 58,
    "position": 1,
    "text": "و گرچه به پیوند تو شهره‌ام"
  },
  {
    "poem_id": 1392,
    "vorder": 59,
    "position": 0,
    "text": "یکی مرغ پرورده‌ام خاک خورد"
  },
  {
    "poem_id": 1392,
    "vorder": 60,
    "position": 1,
    "text": "به گیتی مرا نیست با کس نبرد"
  },
  {
    "poem_id": 1392,
    "vorder": 61,
    "position": 0,
    "text": "ندانم همی خویشتن را گناه"
  },
  {
    "poem_id": 1392,
    "vorder": 62,
    "position": 1,
    "text": "که بر من کسی را بران هست راه"
  },
  {
    "poem_id": 1392,
    "vorder": 63,
    "position": 0,
    "text": "مگر آنکه سام یلستم پدر"
  },
  {
    "poem_id": 1392,
    "vorder": 64,
    "position": 1,
    "text": "و گر هست با این نژادم هنر"
  },
  {
    "poem_id": 1392,
    "vorder": 65,
    "position": 0,
    "text": "ز مادر بزادم بینداختی"
  },
  {
    "poem_id": 1392,
    "vorder": 66,
    "position": 1,
    "text": "به کوه اندرم جایگه ساختی"
  },
  {
    "poem_id": 1392,
    "vorder": 67,
    "position": 0,
    "text": "فگندی به تیمار زاینده را"
  },
  {
    "poem_id": 1392,
    "vorder": 68,
    "position": 1,
    "text": "به آتش سپردی فزاینده را"
  },
  {
    "poem_id": 1392,
    "vorder": 69,
    "position": 0,
    "text": "ترا با جهان آفرین نیست جنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 70,
    "position": 1,
    "text": "که از چه سیاه و سپیدست رنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 71,
    "position": 0,
    "text": "کنون کم جهان آفرین پرورید"
  },
  {
    "poem_id": 1392,
    "vorder": 72,
    "position": 1,
    "text": "به چشم خدایی به من بنگرید"
  },
  {
    "poem_id": 1392,
    "vorder": 73,
    "position": 0,
    "text": "ابا گنج و با تخت و گُرز گران"
  },
  {
    "poem_id": 1392,
    "vorder": 74,
    "position": 1,
    "text": "ابا رای و با تاج و تخت و سران"
  },
  {
    "poem_id": 1392,
    "vorder": 75,
    "position": 0,
    "text": "نشستم به کابل به فرمان تو"
  },
  {
    "poem_id": 1392,
    "vorder": 76,
    "position": 1,
    "text": "نگه داشتم رای و پیمان تو"
  },
  {
    "poem_id": 1392,
    "vorder": 77,
    "position": 0,
    "text": "که گر کینه جویی نیازارمت"
  },
  {
    "poem_id": 1392,
    "vorder": 78,
    "position": 1,
    "text": "درختی که کشتی به بار آرمت"
  },
  {
    "poem_id": 1392,
    "vorder": 79,
    "position": 0,
    "text": "ز مازندران هدیه این ساختی"
  },
  {
    "poem_id": 1392,
    "vorder": 80,
    "position": 1,
    "text": "هم از گرگساران بدین تاختی"
  },
  {
    "poem_id": 1392,
    "vorder": 81,
    "position": 0,
    "text": "که ویران کنی خان آباد من"
  },
  {
    "poem_id": 1392,
    "vorder": 82,
    "position": 1,
    "text": "چنین داد خواهی همی داد من"
  },
  {
    "poem_id": 1392,
    "vorder": 83,
    "position": 0,
    "text": "من اینک به پیش تو استاده‌ام"
  },
  {
    "poem_id": 1392,
    "vorder": 84,
    "position": 1,
    "text": "تن بنده خشم ترا داده‌ام"
  },
  {
    "poem_id": 1392,
    "vorder": 85,
    "position": 0,
    "text": "به اره میانم بدو نیم کن"
  },
  {
    "poem_id": 1392,
    "vorder": 86,
    "position": 1,
    "text": "ز کابل مپیمای با من سخن"
  },
  {
    "poem_id": 1392,
    "vorder": 87,
    "position": 0,
    "text": "سپهبد چو بشنید گفتار زال"
  },
  {
    "poem_id": 1392,
    "vorder": 88,
    "position": 1,
    "text": "برافراخت گوش و فرو برد یال"
  },
  {
    "poem_id": 1392,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت آری همینست راست"
  },
  {
    "poem_id": 1392,
    "vorder": 90,
    "position": 1,
    "text": "زبان تو بر راستی بر گواست"
  },
  {
    "poem_id": 1392,
    "vorder": 91,
    "position": 0,
    "text": "همه کار من با تو بیداد بود"
  },
  {
    "poem_id": 1392,
    "vorder": 92,
    "position": 1,
    "text": "دل دشمنان بر تو بر شاد بود"
  },
  {
    "poem_id": 1392,
    "vorder": 93,
    "position": 0,
    "text": "ز من آرزو خود همین خواستی"
  },
  {
    "poem_id": 1392,
    "vorder": 94,
    "position": 1,
    "text": "به تنگی دل از جای برخاستی"
  },
  {
    "poem_id": 1392,
    "vorder": 95,
    "position": 0,
    "text": "مشو تیز تا چارهٔ کار تو"
  },
  {
    "poem_id": 1392,
    "vorder": 96,
    "position": 1,
    "text": "بسازم کنون نیز بازار تو"
  },
  {
    "poem_id": 1392,
    "vorder": 97,
    "position": 0,
    "text": "یکی نامه فرمایم اکنون به شاه"
  },
  {
    "poem_id": 1392,
    "vorder": 98,
    "position": 1,
    "text": "فرستم به دست تو ای نیک‌خواه"
  },
  {
    "poem_id": 1392,
    "vorder": 99,
    "position": 0,
    "text": "سخن هر چه باید به یاد آورم"
  },
  {
    "poem_id": 1392,
    "vorder": 100,
    "position": 1,
    "text": "روان و دلش سوی داد آورم"
  },
  {
    "poem_id": 1392,
    "vorder": 101,
    "position": 0,
    "text": "اگر یار باشد جهاندار ما"
  },
  {
    "poem_id": 1392,
    "vorder": 102,
    "position": 1,
    "text": "به کام تو گردد همه کار ما"
  },
  {
    "poem_id": 1392,
    "vorder": 103,
    "position": 0,
    "text": "نویسنده را پیش بنشاندند"
  },
  {
    "poem_id": 1392,
    "vorder": 104,
    "position": 1,
    "text": "ز هر در سخنها همی راندند"
  },
  {
    "poem_id": 1392,
    "vorder": 105,
    "position": 0,
    "text": "سرنامه کرد آفرین خدای"
  },
  {
    "poem_id": 1392,
    "vorder": 106,
    "position": 1,
    "text": "کجا هست و باشد همیشه به جای"
  },
  {
    "poem_id": 1392,
    "vorder": 107,
    "position": 0,
    "text": "ازویست نیک و بد و هست و نیست"
  },
  {
    "poem_id": 1392,
    "vorder": 108,
    "position": 1,
    "text": "همه بندگانیم و ایزد یکیست"
  },
  {
    "poem_id": 1392,
    "vorder": 109,
    "position": 0,
    "text": "هر آن چیز کو ساخت اندر بوش"
  },
  {
    "poem_id": 1392,
    "vorder": 110,
    "position": 1,
    "text": "بران است چرخ روان را روش"
  },
  {
    "poem_id": 1392,
    "vorder": 111,
    "position": 0,
    "text": "خداوند کیوان و خورشید و ماه"
  },
  {
    "poem_id": 1392,
    "vorder": 112,
    "position": 1,
    "text": "وزو آفرین بر منوچهر شاه"
  },
  {
    "poem_id": 1392,
    "vorder": 113,
    "position": 0,
    "text": "به رزم اندرون زهر تریاک سوز"
  },
  {
    "poem_id": 1392,
    "vorder": 114,
    "position": 1,
    "text": "به بزم اندرون ماه گیتی فروز"
  },
  {
    "poem_id": 1392,
    "vorder": 115,
    "position": 0,
    "text": "گراینده گُرز و گشاینده شهر"
  },
  {
    "poem_id": 1392,
    "vorder": 116,
    "position": 1,
    "text": "ز شادی به هر کس رساننده بهر"
  },
  {
    "poem_id": 1392,
    "vorder": 117,
    "position": 0,
    "text": "کشنده درفش فریدون به جنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 118,
    "position": 1,
    "text": "کشنده سرافراز جنگی پلنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 119,
    "position": 0,
    "text": "ز باد عمود تو کوه بلند"
  },
  {
    "poem_id": 1392,
    "vorder": 120,
    "position": 1,
    "text": "شود خاک نعل سرافشان سمند"
  },
  {
    "poem_id": 1392,
    "vorder": 121,
    "position": 0,
    "text": "همان از دل پاک و پاکیزه کیش"
  },
  {
    "poem_id": 1392,
    "vorder": 122,
    "position": 1,
    "text": "به آبشخور آری همی گرگ و میش"
  },
  {
    "poem_id": 1392,
    "vorder": 123,
    "position": 0,
    "text": "یکی بنده‌ام من رسیده به جای"
  },
  {
    "poem_id": 1392,
    "vorder": 124,
    "position": 1,
    "text": "به مردی به شَست اندر آورده پای"
  },
  {
    "poem_id": 1392,
    "vorder": 125,
    "position": 0,
    "text": "همی گرد کافور گیرد سرم"
  },
  {
    "poem_id": 1392,
    "vorder": 126,
    "position": 1,
    "text": "چنین کرد خورشید و ماه افسرم"
  },
  {
    "poem_id": 1392,
    "vorder": 127,
    "position": 0,
    "text": "ببستم میان را یکی بنده‌وار"
  },
  {
    "poem_id": 1392,
    "vorder": 128,
    "position": 1,
    "text": "ابا جاودان ساختم کارزار"
  },
  {
    "poem_id": 1392,
    "vorder": 129,
    "position": 0,
    "text": "عنان پیچ و اسپ افگن و گُرزدار"
  },
  {
    "poem_id": 1392,
    "vorder": 130,
    "position": 1,
    "text": "چو من کس ندیدی به گیتی سوار"
  },
  {
    "poem_id": 1392,
    "vorder": 131,
    "position": 0,
    "text": "بشد آب گردان مازندران"
  },
  {
    "poem_id": 1392,
    "vorder": 132,
    "position": 1,
    "text": "چو من دست بردم به گُرز گران"
  },
  {
    "poem_id": 1392,
    "vorder": 133,
    "position": 0,
    "text": "ز من گر نبودی به گیتی نشان"
  },
  {
    "poem_id": 1392,
    "vorder": 134,
    "position": 1,
    "text": "برآورده گردن ز گردن کشان"
  },
  {
    "poem_id": 1392,
    "vorder": 135,
    "position": 0,
    "text": "چنان اژدها کو ز رود کشف"
  },
  {
    "poem_id": 1392,
    "vorder": 136,
    "position": 1,
    "text": "برون آمد و کرد گیتی چو کف"
  },
  {
    "poem_id": 1392,
    "vorder": 137,
    "position": 0,
    "text": "زمین شهر تا شهر پهنای او"
  },
  {
    "poem_id": 1392,
    "vorder": 138,
    "position": 1,
    "text": "همان کوه تا کوه بالای او"
  },
  {
    "poem_id": 1392,
    "vorder": 139,
    "position": 0,
    "text": "جهان را ازو بود دل پر هراس"
  },
  {
    "poem_id": 1392,
    "vorder": 140,
    "position": 1,
    "text": "همی داشتندی شب و روز پاس"
  },
  {
    "poem_id": 1392,
    "vorder": 141,
    "position": 0,
    "text": "هوا پاک دیدم ز پرندگان"
  },
  {
    "poem_id": 1392,
    "vorder": 142,
    "position": 1,
    "text": "همان روی گیتی ز درندگان"
  },
  {
    "poem_id": 1392,
    "vorder": 143,
    "position": 0,
    "text": "ز تفش همی پر کرگس بسوخت"
  },
  {
    "poem_id": 1392,
    "vorder": 144,
    "position": 1,
    "text": "زمین زیر زهرش همی برفروخت"
  },
  {
    "poem_id": 1392,
    "vorder": 145,
    "position": 0,
    "text": "نهنگ دژم بر کشیدی ز آب"
  },
  {
    "poem_id": 1392,
    "vorder": 146,
    "position": 1,
    "text": "به دم درکشیدی ز گردون عقاب"
  },
  {
    "poem_id": 1392,
    "vorder": 147,
    "position": 0,
    "text": "زمین گشت بی‌مردم و چارپای"
  },
  {
    "poem_id": 1392,
    "vorder": 148,
    "position": 1,
    "text": "همه یکسر او را سپردند جای"
  },
  {
    "poem_id": 1392,
    "vorder": 149,
    "position": 0,
    "text": "چو دیدم که اندر جهان کس نبود"
  },
  {
    "poem_id": 1392,
    "vorder": 150,
    "position": 1,
    "text": "که با او همی دست یارست سود"
  },
  {
    "poem_id": 1392,
    "vorder": 151,
    "position": 0,
    "text": "به زور جهاندار یزدان پاک"
  },
  {
    "poem_id": 1392,
    "vorder": 152,
    "position": 1,
    "text": "بیفگندم از دل همه ترس و باک"
  },
  {
    "poem_id": 1392,
    "vorder": 153,
    "position": 0,
    "text": "میان را ببستم به نام بلند"
  },
  {
    "poem_id": 1392,
    "vorder": 154,
    "position": 1,
    "text": "نشستم بران پیل پیکر سمند"
  },
  {
    "poem_id": 1392,
    "vorder": 155,
    "position": 0,
    "text": "به زین اندرون گُرزهٔ گاوسر"
  },
  {
    "poem_id": 1392,
    "vorder": 156,
    "position": 1,
    "text": "به بازو کمان و به گردن سپر"
  },
  {
    "poem_id": 1392,
    "vorder": 157,
    "position": 0,
    "text": "برفتم بسان نهنگ دژم"
  },
  {
    "poem_id": 1392,
    "vorder": 158,
    "position": 1,
    "text": "مرا تیز چنگ و ورا تیز دم"
  },
  {
    "poem_id": 1392,
    "vorder": 159,
    "position": 0,
    "text": "مرا کرد پدرود هرکو شنید"
  },
  {
    "poem_id": 1392,
    "vorder": 160,
    "position": 1,
    "text": "که بر اژدها گُرز خواهم کشید"
  },
  {
    "poem_id": 1392,
    "vorder": 161,
    "position": 0,
    "text": "ز سر تا به دمش چو کوه بلند"
  },
  {
    "poem_id": 1392,
    "vorder": 162,
    "position": 1,
    "text": "کشان موی سر بر زمین چون کمند"
  },
  {
    "poem_id": 1392,
    "vorder": 163,
    "position": 0,
    "text": "زبانش بسان درختی سیاه"
  },
  {
    "poem_id": 1392,
    "vorder": 164,
    "position": 1,
    "text": "ز فر باز کرده فگنده به راه"
  },
  {
    "poem_id": 1392,
    "vorder": 165,
    "position": 0,
    "text": "چو دو آبگیرش پر از خون دو چشم"
  },
  {
    "poem_id": 1392,
    "vorder": 166,
    "position": 1,
    "text": "مرا دید غرید و آمد به خشم"
  },
  {
    "poem_id": 1392,
    "vorder": 167,
    "position": 0,
    "text": "گمانی چنان بردم ای شهریار"
  },
  {
    "poem_id": 1392,
    "vorder": 168,
    "position": 1,
    "text": "که دارم مگر آتش اندر کنار"
  },
  {
    "poem_id": 1392,
    "vorder": 169,
    "position": 0,
    "text": "جهان پیش چشمم چو دریا نمود"
  },
  {
    "poem_id": 1392,
    "vorder": 170,
    "position": 1,
    "text": "به ابر سیه بر شده تیره دود"
  },
  {
    "poem_id": 1392,
    "vorder": 171,
    "position": 0,
    "text": "ز بانگش بلرزید روی زمین"
  },
  {
    "poem_id": 1392,
    "vorder": 172,
    "position": 1,
    "text": "ز زهرش زمین شد چو دریای چین"
  },
  {
    "poem_id": 1392,
    "vorder": 173,
    "position": 0,
    "text": "برو بر زدم بانگ برسان شیر"
  },
  {
    "poem_id": 1392,
    "vorder": 174,
    "position": 1,
    "text": "چنان چون بود کار مرد دلیر"
  },
  {
    "poem_id": 1392,
    "vorder": 175,
    "position": 0,
    "text": "یکی تیر الماس پیکان خدنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 176,
    "position": 1,
    "text": "به چرخ اندرون راندم بی‌درنگ"
  },
  {
    "poem_id": 1392,
    "vorder": 177,
    "position": 0,
    "text": "چو شد دوخته یک کران از دهانش"
  },
  {
    "poem_id": 1392,
    "vorder": 178,
    "position": 1,
    "text": "بماند از شگفتی به بیرون زبانش"
  },
  {
    "poem_id": 1392,
    "vorder": 179,
    "position": 0,
    "text": "هم اندر زمان دیگری همچنان"
  },
  {
    "poem_id": 1392,
    "vorder": 180,
    "position": 1,
    "text": "زدم بر دهانش بپیچید ازان"
  },
  {
    "poem_id": 1392,
    "vorder": 181,
    "position": 0,
    "text": "سدیگر زدم بر میان زفرش"
  },
  {
    "poem_id": 1392,
    "vorder": 182,
    "position": 1,
    "text": "برآمد همی جوی خون از جگرش"
  },
  {
    "poem_id": 1392,
    "vorder": 183,
    "position": 0,
    "text": "چو تنگ اندر آورد با من زمین"
  },
  {
    "poem_id": 1392,
    "vorder": 184,
    "position": 1,
    "text": "برآهختم این گاوسر گُرز کین"
  },
  {
    "poem_id": 1392,
    "vorder": 185,
    "position": 0,
    "text": "به نیروی یزدان گیهان خدای"
  },
  {
    "poem_id": 1392,
    "vorder": 186,
    "position": 1,
    "text": "برانگیختم پیلتن را ز جای"
  },
  {
    "poem_id": 1392,
    "vorder": 187,
    "position": 0,
    "text": "زدم بر سرش گُرزهٔ گاو چهر"
  },
  {
    "poem_id": 1392,
    "vorder": 188,
    "position": 1,
    "text": "برو کوه بارید گفتی سپهر"
  },
  {
    "poem_id": 1392,
    "vorder": 189,
    "position": 0,
    "text": "شکستم سرش چون تن ژنده پیل"
  },
  {
    "poem_id": 1392,
    "vorder": 190,
    "position": 1,
    "text": "فرو ریخت زو زهر چون رود نیل"
  },
  {
    "poem_id": 1392,
    "vorder": 191,
    "position": 0,
    "text": "به زخمی چنان شد که دیگر نخاست"
  },
  {
    "poem_id": 1392,
    "vorder": 192,
    "position": 1,
    "text": "ز مغزش زمین گشت باکوه راست"
  },
  {
    "poem_id": 1392,
    "vorder": 193,
    "position": 0,
    "text": "کشف رود پر خون و زرداب شد"
  },
  {
    "poem_id": 1392,
    "vorder": 194,
    "position": 1,
    "text": "زمین جای آرامش و خواب شد"
  },
  {
    "poem_id": 1392,
    "vorder": 195,
    "position": 0,
    "text": "همه کوهساران پر از مرد و زن"
  },
  {
    "poem_id": 1392,
    "vorder": 196,
    "position": 1,
    "text": "همی آفرین خواندندی بمن"
  },
  {
    "poem_id": 1392,
    "vorder": 197,
    "position": 0,
    "text": "جهانی بران جنگ نظاره بود"
  },
  {
    "poem_id": 1392,
    "vorder": 198,
    "position": 1,
    "text": "که آن اژدها زشت پتیاره بود"
  },
  {
    "poem_id": 1392,
    "vorder": 199,
    "position": 0,
    "text": "مرا سام یک زخم ازان خواندند"
  },
  {
    "poem_id": 1392,
    "vorder": 200,
    "position": 1,
    "text": "جهان زر و گوهر برافشاندند"
  },
  {
    "poem_id": 1392,
    "vorder": 201,
    "position": 0,
    "text": "چو زو بازگشتم تن روشنم"
  },
  {
    "poem_id": 1392,
    "vorder": 202,
    "position": 1,
    "text": "برهنه شد از نامور جوشنم"
  },
  {
    "poem_id": 1392,
    "vorder": 203,
    "position": 0,
    "text": "فرو ریخت از باره برگستوان"
  },
  {
    "poem_id": 1392,
    "vorder": 204,
    "position": 1,
    "text": "وزین هست هر چند رانم زیان"
  },
  {
    "poem_id": 1392,
    "vorder": 205,
    "position": 0,
    "text": "بران بوم تا سالیان بر نبود"
  },
  {
    "poem_id": 1392,
    "vorder": 206,
    "position": 1,
    "text": "جز از سوخته خار خاور نبود"
  },
  {
    "poem_id": 1392,
    "vorder": 207,
    "position": 0,
    "text": "چنین و جزین هر چه بودیم رای"
  },
  {
    "poem_id": 1392,
    "vorder": 208,
    "position": 1,
    "text": "سران را سرآوردمی زیر پای"
  },
  {
    "poem_id": 1392,
    "vorder": 209,
    "position": 0,
    "text": "کجا من چمانیدمی بادپای"
  },
  {
    "poem_id": 1392,
    "vorder": 210,
    "position": 1,
    "text": "بپرداختی شیر درنده جای"
  },
  {
    "poem_id": 1392,
    "vorder": 211,
    "position": 0,
    "text": "کنون چند سالست تا پشت زین"
  },
  {
    "poem_id": 1392,
    "vorder": 212,
    "position": 1,
    "text": "مرا تختگاه است و اسپم زمین"
  },
  {
    "poem_id": 1392,
    "vorder": 213,
    "position": 0,
    "text": "همه گرگساران و مازنداران"
  },
  {
    "poem_id": 1392,
    "vorder": 214,
    "position": 1,
    "text": "به تو راست کردم به گُرز گران"
  },
  {
    "poem_id": 1392,
    "vorder": 215,
    "position": 0,
    "text": "نکردم زمانی برو بوم یاد"
  },
  {
    "poem_id": 1392,
    "vorder": 216,
    "position": 1,
    "text": "ترا خواستم راد و پیروز و شاد"
  },
  {
    "poem_id": 1392,
    "vorder": 217,
    "position": 0,
    "text": "کنون این برافراخته یال من"
  },
  {
    "poem_id": 1392,
    "vorder": 218,
    "position": 1,
    "text": "همان زخم کوبنده کوپال من"
  },
  {
    "poem_id": 1392,
    "vorder": 219,
    "position": 0,
    "text": "بدان هم که بودی نماند همی"
  },
  {
    "poem_id": 1392,
    "vorder": 220,
    "position": 1,
    "text": "بر و گردگاهم خماند همی"
  },
  {
    "poem_id": 1392,
    "vorder": 221,
    "position": 0,
    "text": "کمندی بینداخت از دست شست"
  },
  {
    "poem_id": 1392,
    "vorder": 222,
    "position": 1,
    "text": "زمانه مرا باژگونه ببست"
  },
  {
    "poem_id": 1392,
    "vorder": 223,
    "position": 0,
    "text": "سپردیم نوبت کنون زال را"
  },
  {
    "poem_id": 1392,
    "vorder": 224,
    "position": 1,
    "text": "که شاید کمربند و کوپال را"
  },
  {
    "poem_id": 1392,
    "vorder": 225,
    "position": 0,
    "text": "یکی آرزو دارد اندر نهان"
  },
  {
    "poem_id": 1392,
    "vorder": 226,
    "position": 1,
    "text": "بیاید بخواهد ز شاه جهان"
  },
  {
    "poem_id": 1392,
    "vorder": 227,
    "position": 0,
    "text": "یکی آرزو کان به یزدان نکوست"
  },
  {
    "poem_id": 1392,
    "vorder": 228,
    "position": 1,
    "text": "کجا نیکویی زیر فرمان اوست"
  },
  {
    "poem_id": 1392,
    "vorder": 229,
    "position": 0,
    "text": "نکردیم بی‌رای شاه بزرگ"
  },
  {
    "poem_id": 1392,
    "vorder": 230,
    "position": 1,
    "text": "که بنده نباید که باشد سترگ"
  },
  {
    "poem_id": 1392,
    "vorder": 231,
    "position": 0,
    "text": "همانا که با زال پیمان من"
  },
  {
    "poem_id": 1392,
    "vorder": 232,
    "position": 1,
    "text": "شنیدست شاه جهان‌بان من"
  },
  {
    "poem_id": 1392,
    "vorder": 233,
    "position": 0,
    "text": "که از رای او سر نپیچم به هیچ"
  },
  {
    "poem_id": 1392,
    "vorder": 234,
    "position": 1,
    "text": "درین روزها کرد زی من بسیچ"
  },
  {
    "poem_id": 1392,
    "vorder": 235,
    "position": 0,
    "text": "به پیش من آمد پر از خون رخان"
  },
  {
    "poem_id": 1392,
    "vorder": 236,
    "position": 1,
    "text": "همی چاک چاک آمدش ز استخوان"
  },
  {
    "poem_id": 1392,
    "vorder": 237,
    "position": 0,
    "text": "مرا گفت بردار آمل کنی"
  },
  {
    "poem_id": 1392,
    "vorder": 238,
    "position": 1,
    "text": "سزاتر که آهنگ کابل کنی"
  },
  {
    "poem_id": 1392,
    "vorder": 239,
    "position": 0,
    "text": "چو پروردهٔ مرغ باشد به کوه"
  },
  {
    "poem_id": 1392,
    "vorder": 240,
    "position": 1,
    "text": "نشانی شده در میان گروه"
  },
  {
    "poem_id": 1392,
    "vorder": 241,
    "position": 0,
    "text": "چنان ماه بیند به کابلستان"
  },
  {
    "poem_id": 1392,
    "vorder": 242,
    "position": 1,
    "text": "چو سرو سهی بر سرش گلستان"
  },
  {
    "poem_id": 1392,
    "vorder": 243,
    "position": 0,
    "text": "چو دیوانه گردد نباشد شگفت"
  },
  {
    "poem_id": 1392,
    "vorder": 244,
    "position": 1,
    "text": "ازو شاه را کین نباید گرفت"
  },
  {
    "poem_id": 1392,
    "vorder": 245,
    "position": 0,
    "text": "کنون رنج مهرش به جایی رسید"
  },
  {
    "poem_id": 1392,
    "vorder": 246,
    "position": 1,
    "text": "که بخشایش آرد هر آن کش بدید"
  },
  {
    "poem_id": 1392,
    "vorder": 247,
    "position": 0,
    "text": "ز بس درد کو دید بر بی‌گناه"
  },
  {
    "poem_id": 1392,
    "vorder": 248,
    "position": 1,
    "text": "چنان رفت پیمان که بشنید شاه"
  },
  {
    "poem_id": 1392,
    "vorder": 249,
    "position": 0,
    "text": "گسی کردمش با دلی مستمند"
  },
  {
    "poem_id": 1392,
    "vorder": 250,
    "position": 1,
    "text": "چو آید به نزدیک تخت بلند"
  },
  {
    "poem_id": 1392,
    "vorder": 251,
    "position": 0,
    "text": "همان کن که با مهتری در خورد"
  },
  {
    "poem_id": 1392,
    "vorder": 252,
    "position": 1,
    "text": "ترا خود نیاموخت باید خرد"
  },
  {
    "poem_id": 1392,
    "vorder": 253,
    "position": 0,
    "text": "چو نامه نوشتند و شد رای راست"
  },
  {
    "poem_id": 1392,
    "vorder": 254,
    "position": 1,
    "text": "ستد زود دستان و بر پای خاست"
  },
  {
    "poem_id": 1392,
    "vorder": 255,
    "position": 0,
    "text": "چو خورشید سر سوی خاور نهاد"
  },
  {
    "poem_id": 1392,
    "vorder": 256,
    "position": 1,
    "text": "نخفت و نیاسود تا بامداد"
  },
  {
    "poem_id": 1392,
    "vorder": 257,
    "position": 0,
    "text": "چو آن جامه‌ها سوده بفگند شب"
  },
  {
    "poem_id": 1392,
    "vorder": 258,
    "position": 1,
    "text": "سپیده بخندید و بگشاد لب"
  },
  {
    "poem_id": 1392,
    "vorder": 259,
    "position": 0,
    "text": "بیامد به زین اندر آورد پای"
  },
  {
    "poem_id": 1392,
    "vorder": 260,
    "position": 1,
    "text": "برآمد خروشیدن کره نای"
  },
  {
    "poem_id": 1392,
    "vorder": 261,
    "position": 0,
    "text": "به سوی شهنشاه بنهاد روی"
  },
  {
    "poem_id": 1392,
    "vorder": 262,
    "position": 1,
    "text": "ابا نامهٔ سام آزاده خوی"
  }
