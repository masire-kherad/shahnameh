[
  {
    "poem_id": 88003,
    "vorder": 1,
    "position": 0,
    "text": "بینداخت آن تابداده کمند"
  },
  {
    "poem_id": 88003,
    "vorder": 2,
    "position": 1,
    "text": "سران سواران همی کرد بند"
  },
  {
    "poem_id": 88003,
    "vorder": 3,
    "position": 0,
    "text": "چو آمد بنزدیک پیل سپید"
  },
  {
    "poem_id": 88003,
    "vorder": 4,
    "position": 1,
    "text": "شد آن شاه چین از روان ناامید"
  },
  {
    "poem_id": 88003,
    "vorder": 5,
    "position": 0,
    "text": "چو از دست رستم رها شد کمند"
  },
  {
    "poem_id": 88003,
    "vorder": 6,
    "position": 1,
    "text": "سر شاه چین اندر آمد ببند"
  },
  {
    "poem_id": 88003,
    "vorder": 7,
    "position": 0,
    "text": "ز پیل اندر آورد و زد بر زمین"
  },
  {
    "poem_id": 88003,
    "vorder": 8,
    "position": 1,
    "text": "ببستند بازوی خاقان چین"
  },
  {
    "poem_id": 88003,
    "vorder": 9,
    "position": 0,
    "text": "پیاده همی راند تا رود شهد"
  },
  {
    "poem_id": 88003,
    "vorder": 10,
    "position": 1,
    "text": "نه پیل و نه تاج و نه تخت و نه مهد"
  },
  {
    "poem_id": 88003,
    "vorder": 11,
    "position": 0,
    "text": "چنینست رسم سرای فریب"
  },
  {
    "poem_id": 88003,
    "vorder": 12,
    "position": 1,
    "text": "گهی بر فراز و گهی بر نشیب"
  },
  {
    "poem_id": 88003,
    "vorder": 13,
    "position": 0,
    "text": "چنین بود تا بود گردان سپهر"
  },
  {
    "poem_id": 88003,
    "vorder": 14,
    "position": 1,
    "text": "گهی جنگ و زهرست و گه نوش و مهر"
  },
  {
    "poem_id": 88003,
    "vorder": 15,
    "position": 0,
    "text": "ازان پس بگرز گران دست برد"
  },
  {
    "poem_id": 88003,
    "vorder": 16,
    "position": 1,
    "text": "بزرگش همان و همان بود خرد"
  },
  {
    "poem_id": 88003,
    "vorder": 17,
    "position": 0,
    "text": "چنان شد در و دشت آوردگاه"
  },
  {
    "poem_id": 88003,
    "vorder": 18,
    "position": 1,
    "text": "که شد تنگ بر مور و بر پشه راه"
  },
  {
    "poem_id": 88003,
    "vorder": 19,
    "position": 0,
    "text": "ز بس کشته و خسته شد جوی خون"
  },
  {
    "poem_id": 88003,
    "vorder": 20,
    "position": 1,
    "text": "یکی بی‌سر و دیگری سرنگون"
  },
  {
    "poem_id": 88003,
    "vorder": 21,
    "position": 0,
    "text": "چنان بخت تابنده تاریک شد"
  },
  {
    "poem_id": 88003,
    "vorder": 22,
    "position": 1,
    "text": "همانا بشب روز نزدیک شد"
  },
  {
    "poem_id": 88003,
    "vorder": 23,
    "position": 0,
    "text": "برآمد یکی ابر و بادی سیاه"
  },
  {
    "poem_id": 88003,
    "vorder": 24,
    "position": 1,
    "text": "بشد روشنایی ز خورشید و ماه"
  },
  {
    "poem_id": 88003,
    "vorder": 25,
    "position": 0,
    "text": "سر از پای دشمن ندانست باز"
  },
  {
    "poem_id": 88003,
    "vorder": 26,
    "position": 1,
    "text": "بیابان گرفتند و راه دراز"
  },
  {
    "poem_id": 88003,
    "vorder": 27,
    "position": 0,
    "text": "نگه کرد پیران بدان کارزار"
  },
  {
    "poem_id": 88003,
    "vorder": 28,
    "position": 1,
    "text": "چنان تیز برگشتن روزگار"
  },
  {
    "poem_id": 88003,
    "vorder": 29,
    "position": 0,
    "text": "نه منشور و فرطوس و خاقان چین"
  },
  {
    "poem_id": 88003,
    "vorder": 30,
    "position": 1,
    "text": "نه آن نامداران و مردان کین"
  },
  {
    "poem_id": 88003,
    "vorder": 31,
    "position": 0,
    "text": "درفش بزرگان نگونسار دید"
  },
  {
    "poem_id": 88003,
    "vorder": 32,
    "position": 1,
    "text": "بخاک اندرون خستگان خوار دید"
  },
  {
    "poem_id": 88003,
    "vorder": 33,
    "position": 0,
    "text": "بنستیهن گرد و کلباد گفت"
  },
  {
    "poem_id": 88003,
    "vorder": 34,
    "position": 1,
    "text": "که شمشیر و نیزه بباید نهفت"
  },
  {
    "poem_id": 88003,
    "vorder": 35,
    "position": 0,
    "text": "نگونسار کرد آن درفش سیاه"
  },
  {
    "poem_id": 88003,
    "vorder": 36,
    "position": 1,
    "text": "برفتند پویان به بیراه و راه"
  },
  {
    "poem_id": 88003,
    "vorder": 37,
    "position": 0,
    "text": "همه میمنه گیو تاراج کرد"
  },
  {
    "poem_id": 88003,
    "vorder": 38,
    "position": 1,
    "text": "در و دشت چون پر دراج کرد"
  },
  {
    "poem_id": 88003,
    "vorder": 39,
    "position": 0,
    "text": "بجست از چپ لشکر و دست راست"
  },
  {
    "poem_id": 88003,
    "vorder": 40,
    "position": 1,
    "text": "بدان تا بداند که پیران کجاست"
  },
  {
    "poem_id": 88003,
    "vorder": 41,
    "position": 0,
    "text": "چو او را ندیدند گشتند باز"
  },
  {
    "poem_id": 88003,
    "vorder": 42,
    "position": 1,
    "text": "دلیران سوی رستم سرفراز"
  },
  {
    "poem_id": 88003,
    "vorder": 43,
    "position": 0,
    "text": "تبه گشته اسپان جنگی ز کار"
  },
  {
    "poem_id": 88003,
    "vorder": 44,
    "position": 1,
    "text": "همه رنجه و خستهٔ کارزار"
  },
  {
    "poem_id": 88003,
    "vorder": 45,
    "position": 0,
    "text": "برفتند با کام دل سوی کوه"
  },
  {
    "poem_id": 88003,
    "vorder": 46,
    "position": 1,
    "text": "تهمتن بپیش اندرون با گروه"
  },
  {
    "poem_id": 88003,
    "vorder": 47,
    "position": 0,
    "text": "همه ترگ و جوشن به خون و به خاک"
  },
  {
    "poem_id": 88003,
    "vorder": 48,
    "position": 1,
    "text": "شده غرق و برگستوان چاک چاک"
  },
  {
    "poem_id": 88003,
    "vorder": 49,
    "position": 0,
    "text": "تن از جنگ خسته دل از رزم شاد"
  },
  {
    "poem_id": 88003,
    "vorder": 50,
    "position": 1,
    "text": "جهان را چنینست ساز و نهاد"
  },
  {
    "poem_id": 88003,
    "vorder": 51,
    "position": 0,
    "text": "پر از خون بر و تیغ و پای و رکیب"
  },
  {
    "poem_id": 88003,
    "vorder": 52,
    "position": 1,
    "text": "ز کشته نه پیدا فراز از نشیب"
  },
  {
    "poem_id": 88003,
    "vorder": 53,
    "position": 0,
    "text": "چنین تا بشستن نپرداختند"
  },
  {
    "poem_id": 88003,
    "vorder": 54,
    "position": 1,
    "text": "یک از دیگری باز نشناختند"
  },
  {
    "poem_id": 88003,
    "vorder": 55,
    "position": 0,
    "text": "سر و تن بشستند و دل شسته بود"
  },
  {
    "poem_id": 88003,
    "vorder": 56,
    "position": 1,
    "text": "که دشمن ببند گران بسته بود"
  },
  {
    "poem_id": 88003,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت رستم بایرانیان"
  },
  {
    "poem_id": 88003,
    "vorder": 58,
    "position": 1,
    "text": "که اکنون بباید گشادن میان"
  },
  {
    "poem_id": 88003,
    "vorder": 59,
    "position": 0,
    "text": "بپیش جهاندار پیروزگر"
  },
  {
    "poem_id": 88003,
    "vorder": 60,
    "position": 1,
    "text": "نه گوپال باید نه بند کمر"
  },
  {
    "poem_id": 88003,
    "vorder": 61,
    "position": 0,
    "text": "همه سر بخاک سیه بر نهید"
  },
  {
    "poem_id": 88003,
    "vorder": 62,
    "position": 1,
    "text": "کزین پس همه تاج بر سر نهید"
  },
  {
    "poem_id": 88003,
    "vorder": 63,
    "position": 0,
    "text": "کزین نامدارن یکی نیست کم"
  },
  {
    "poem_id": 88003,
    "vorder": 64,
    "position": 1,
    "text": "که اکنون شدستی دل ما دژم"
  },
  {
    "poem_id": 88003,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت رستم بگودرز و گیو"
  },
  {
    "poem_id": 88003,
    "vorder": 66,
    "position": 1,
    "text": "بدان نامداران و گردان نیو"
  },
  {
    "poem_id": 88003,
    "vorder": 67,
    "position": 0,
    "text": "چو آگاهی آمد بشاه جهان"
  },
  {
    "poem_id": 88003,
    "vorder": 68,
    "position": 1,
    "text": "بمن باز گفت این سخن در نهان"
  },
  {
    "poem_id": 88003,
    "vorder": 69,
    "position": 0,
    "text": "که طوس سپهبد بکوه آمدست"
  },
  {
    "poem_id": 88003,
    "vorder": 70,
    "position": 1,
    "text": "ز پیران و هومان ستوه آمدست"
  },
  {
    "poem_id": 88003,
    "vorder": 71,
    "position": 0,
    "text": "از ایران برفتیم با رای و هوش"
  },
  {
    "poem_id": 88003,
    "vorder": 72,
    "position": 1,
    "text": "برآمد ز پیکار مغزم بجوش"
  },
  {
    "poem_id": 88003,
    "vorder": 73,
    "position": 0,
    "text": "ز بهرام گودرز وز ریونیز"
  },
  {
    "poem_id": 88003,
    "vorder": 74,
    "position": 1,
    "text": "دلم تیر تر گشت برسان شیز"
  },
  {
    "poem_id": 88003,
    "vorder": 75,
    "position": 0,
    "text": "از ایران همی تاختم تیزچنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 76,
    "position": 1,
    "text": "زمانی بجایی نکردم درنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 77,
    "position": 0,
    "text": "چو چشمم برآمد بخاقان چین"
  },
  {
    "poem_id": 88003,
    "vorder": 78,
    "position": 1,
    "text": "بران نامداران و مردان کین"
  },
  {
    "poem_id": 88003,
    "vorder": 79,
    "position": 0,
    "text": "بویژه بکاموس و آن فر و برز"
  },
  {
    "poem_id": 88003,
    "vorder": 80,
    "position": 1,
    "text": "بران یال و آن شاخ و آن دست و گرز"
  },
  {
    "poem_id": 88003,
    "vorder": 81,
    "position": 0,
    "text": "که بودند هر یک چو کوهی بلند"
  },
  {
    "poem_id": 88003,
    "vorder": 82,
    "position": 1,
    "text": "بزیر اندرون ژنده پیلی نژند"
  },
  {
    "poem_id": 88003,
    "vorder": 83,
    "position": 0,
    "text": "بدل گفتم آمد زمانم بسر"
  },
  {
    "poem_id": 88003,
    "vorder": 84,
    "position": 1,
    "text": "که تا من ببستم بمردی کمر"
  },
  {
    "poem_id": 88003,
    "vorder": 85,
    "position": 0,
    "text": "ازین بیش مردان و زین بیش ساز"
  },
  {
    "poem_id": 88003,
    "vorder": 86,
    "position": 1,
    "text": "ندیدم بجایی بسال دراز"
  },
  {
    "poem_id": 88003,
    "vorder": 87,
    "position": 0,
    "text": "رسیدم بدیوان مازندران"
  },
  {
    "poem_id": 88003,
    "vorder": 88,
    "position": 1,
    "text": "شب تیره و گرزهای گران"
  },
  {
    "poem_id": 88003,
    "vorder": 89,
    "position": 0,
    "text": "ز مردی نپیچید هرگز دلم"
  },
  {
    "poem_id": 88003,
    "vorder": 90,
    "position": 1,
    "text": "نگفتم که از آرزو بگسلم"
  },
  {
    "poem_id": 88003,
    "vorder": 91,
    "position": 0,
    "text": "جز آن دم که دیدم ز کاموس جنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 92,
    "position": 1,
    "text": "دلم گشت یکباره زین کینه تنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 93,
    "position": 0,
    "text": "کنون گر همه پیش یزدان پاک"
  },
  {
    "poem_id": 88003,
    "vorder": 94,
    "position": 1,
    "text": "بغلتیم با درد یک یک بخاک"
  },
  {
    "poem_id": 88003,
    "vorder": 95,
    "position": 0,
    "text": "سزاوار باشد که او داد زور"
  },
  {
    "poem_id": 88003,
    "vorder": 96,
    "position": 1,
    "text": "بلند اختر و بخش کیوان و هور"
  },
  {
    "poem_id": 88003,
    "vorder": 97,
    "position": 0,
    "text": "مبادا که این کار گیرد نشیب"
  },
  {
    "poem_id": 88003,
    "vorder": 98,
    "position": 1,
    "text": "مبادا که آید بما بر نهیب"
  },
  {
    "poem_id": 88003,
    "vorder": 99,
    "position": 0,
    "text": "نگه کن که کارآگهان ناگهان"
  },
  {
    "poem_id": 88003,
    "vorder": 100,
    "position": 1,
    "text": "برند آگهی نزد شاه جهان"
  },
  {
    "poem_id": 88003,
    "vorder": 101,
    "position": 0,
    "text": "بیاراید آن نامور بارگاه"
  },
  {
    "poem_id": 88003,
    "vorder": 102,
    "position": 1,
    "text": "بسر بر نهد خسروانی کلاه"
  },
  {
    "poem_id": 88003,
    "vorder": 103,
    "position": 0,
    "text": "ببخشد فراوان بدرویش چیز"
  },
  {
    "poem_id": 88003,
    "vorder": 104,
    "position": 1,
    "text": "که بر جان او آفرین باد نیز"
  },
  {
    "poem_id": 88003,
    "vorder": 105,
    "position": 0,
    "text": "کنون جامهٔ رزم بیرون کنید"
  },
  {
    "poem_id": 88003,
    "vorder": 106,
    "position": 1,
    "text": "بآسایش آرایش افزون کنید"
  },
  {
    "poem_id": 88003,
    "vorder": 107,
    "position": 0,
    "text": "غم و کام دل بی‌گمان بگذرد"
  },
  {
    "poem_id": 88003,
    "vorder": 108,
    "position": 1,
    "text": "زمانه دم ما همی بشمرد"
  },
  {
    "poem_id": 88003,
    "vorder": 109,
    "position": 0,
    "text": "همان به که ما جام می بشمریم"
  },
  {
    "poem_id": 88003,
    "vorder": 110,
    "position": 1,
    "text": "بدین چرخ نامهربان ننگریم"
  },
  {
    "poem_id": 88003,
    "vorder": 111,
    "position": 0,
    "text": "سپاس از جهاندار پیروزگر"
  },
  {
    "poem_id": 88003,
    "vorder": 112,
    "position": 1,
    "text": "کزویست مردی و بخت و هنر"
  },
  {
    "poem_id": 88003,
    "vorder": 113,
    "position": 0,
    "text": "کنون می گساریم تا نیم‌شب"
  },
  {
    "poem_id": 88003,
    "vorder": 114,
    "position": 1,
    "text": "بیاد بزرگان گشاییم لب"
  },
  {
    "poem_id": 88003,
    "vorder": 115,
    "position": 0,
    "text": "سزد گر دل اندر سرای سپنج"
  },
  {
    "poem_id": 88003,
    "vorder": 116,
    "position": 1,
    "text": "نداریم چندین بدرد و برنج"
  },
  {
    "poem_id": 88003,
    "vorder": 117,
    "position": 0,
    "text": "بزرگان برو خواندند آفرین"
  },
  {
    "poem_id": 88003,
    "vorder": 118,
    "position": 1,
    "text": "که بی‌تو مبادا کلاه و نگین"
  },
  {
    "poem_id": 88003,
    "vorder": 119,
    "position": 0,
    "text": "کسی را که چون پیلتن کهترست"
  },
  {
    "poem_id": 88003,
    "vorder": 120,
    "position": 1,
    "text": "ز گرودن گردان سرش برترست"
  },
  {
    "poem_id": 88003,
    "vorder": 121,
    "position": 0,
    "text": "پسندیده باد این نژاد و گهر"
  },
  {
    "poem_id": 88003,
    "vorder": 122,
    "position": 1,
    "text": "هم آن بوم کو چون تو آرد ببر"
  },
  {
    "poem_id": 88003,
    "vorder": 123,
    "position": 0,
    "text": "تو دانی که با ما چه کردی بمهر"
  },
  {
    "poem_id": 88003,
    "vorder": 124,
    "position": 1,
    "text": "که از جان تو شاد بادا سپهر"
  },
  {
    "poem_id": 88003,
    "vorder": 125,
    "position": 0,
    "text": "همه مرده بودیم و برگشته روز"
  },
  {
    "poem_id": 88003,
    "vorder": 126,
    "position": 1,
    "text": "بتو زنده گشتیم و گیتی‌فروز"
  },
  {
    "poem_id": 88003,
    "vorder": 127,
    "position": 0,
    "text": "بفرمود تا پیل با تخت عاج"
  },
  {
    "poem_id": 88003,
    "vorder": 128,
    "position": 1,
    "text": "بیارند با طوق زرین و تاج"
  },
  {
    "poem_id": 88003,
    "vorder": 129,
    "position": 0,
    "text": "می خسروانی بیاورد و جام"
  },
  {
    "poem_id": 88003,
    "vorder": 130,
    "position": 1,
    "text": "نخستین ز شاه جهان برد نام"
  },
  {
    "poem_id": 88003,
    "vorder": 131,
    "position": 0,
    "text": "بزد کرنای از بر ژنده پیل"
  },
  {
    "poem_id": 88003,
    "vorder": 132,
    "position": 1,
    "text": "همی رفت آوازشان بر دو میل"
  },
  {
    "poem_id": 88003,
    "vorder": 133,
    "position": 0,
    "text": "چو خرم شد از می رخ پهلوان"
  },
  {
    "poem_id": 88003,
    "vorder": 134,
    "position": 1,
    "text": "برفتند شادان و روشن‌روان"
  },
  {
    "poem_id": 88003,
    "vorder": 135,
    "position": 0,
    "text": "چو پیراهن شب بدرید ماه"
  },
  {
    "poem_id": 88003,
    "vorder": 136,
    "position": 1,
    "text": "نهاد از بر چرخ پیروزه‌گاه"
  },
  {
    "poem_id": 88003,
    "vorder": 137,
    "position": 0,
    "text": "طلایه پراگند بر گرد دشت"
  },
  {
    "poem_id": 88003,
    "vorder": 138,
    "position": 1,
    "text": "چو زنگی درنگی شب اندر گذشت"
  },
  {
    "poem_id": 88003,
    "vorder": 139,
    "position": 0,
    "text": "پدید آمد آن خنجر تابناک"
  },
  {
    "poem_id": 88003,
    "vorder": 140,
    "position": 1,
    "text": "بکردار یاقوت شد روی خاک"
  },
  {
    "poem_id": 88003,
    "vorder": 141,
    "position": 0,
    "text": "تبیره برآمد ز پرده‌سرای"
  },
  {
    "poem_id": 88003,
    "vorder": 142,
    "position": 1,
    "text": "برفتند گردان لشکر ز جای"
  },
  {
    "poem_id": 88003,
    "vorder": 143,
    "position": 0,
    "text": "چنین گفت رستم بگردنکشان"
  },
  {
    "poem_id": 88003,
    "vorder": 144,
    "position": 1,
    "text": "که جایی نیامد ز پیران نشان"
  },
  {
    "poem_id": 88003,
    "vorder": 145,
    "position": 0,
    "text": "بباید شدن سوی آن رزمگاه"
  },
  {
    "poem_id": 88003,
    "vorder": 146,
    "position": 1,
    "text": "بهر سو فرستاد باید سپاه"
  },
  {
    "poem_id": 88003,
    "vorder": 147,
    "position": 0,
    "text": "شد از پیش او بیژن شیر مرد"
  },
  {
    "poem_id": 88003,
    "vorder": 148,
    "position": 1,
    "text": "بجایی کجا بود دشت نبرد"
  },
  {
    "poem_id": 88003,
    "vorder": 149,
    "position": 0,
    "text": "جهان دید پر کشته و خواسته"
  },
  {
    "poem_id": 88003,
    "vorder": 150,
    "position": 1,
    "text": "بهر سو نشستی بیاراسته"
  },
  {
    "poem_id": 88003,
    "vorder": 151,
    "position": 0,
    "text": "پراگنده کشور پر از خسته دید"
  },
  {
    "poem_id": 88003,
    "vorder": 152,
    "position": 1,
    "text": "بخاک اندر افگنده پا بسته دید"
  },
  {
    "poem_id": 88003,
    "vorder": 153,
    "position": 0,
    "text": "ندیدند زنده کسی را بجای"
  },
  {
    "poem_id": 88003,
    "vorder": 154,
    "position": 1,
    "text": "زمین بود و خرگاه و پرده‌سرای"
  },
  {
    "poem_id": 88003,
    "vorder": 155,
    "position": 0,
    "text": "بنزدیک رستم رسید آگهی"
  },
  {
    "poem_id": 88003,
    "vorder": 156,
    "position": 1,
    "text": "که شد روی کشور ز ترکان تهی"
  },
  {
    "poem_id": 88003,
    "vorder": 157,
    "position": 0,
    "text": "ز ناباکی و خواب ایرانیان"
  },
  {
    "poem_id": 88003,
    "vorder": 158,
    "position": 1,
    "text": "برآشفت رستم چو شیر ژیان"
  },
  {
    "poem_id": 88003,
    "vorder": 159,
    "position": 0,
    "text": "زبان را بدشنام بگشاد و گفت"
  },
  {
    "poem_id": 88003,
    "vorder": 160,
    "position": 1,
    "text": "که کس را خرد نیست با مغز جفت"
  },
  {
    "poem_id": 88003,
    "vorder": 161,
    "position": 0,
    "text": "بدین گونه دشمن میان دو کوه"
  },
  {
    "poem_id": 88003,
    "vorder": 162,
    "position": 1,
    "text": "سپه چون گریزد ز ما همگروه"
  },
  {
    "poem_id": 88003,
    "vorder": 163,
    "position": 0,
    "text": "طلایه نگفتم که بیرون کنید"
  },
  {
    "poem_id": 88003,
    "vorder": 164,
    "position": 1,
    "text": "در و راغ چون دشت و هامون کنید"
  },
  {
    "poem_id": 88003,
    "vorder": 165,
    "position": 0,
    "text": "شما سر بآسایش و خوابگاه"
  },
  {
    "poem_id": 88003,
    "vorder": 166,
    "position": 1,
    "text": "سپردید و دشمن بسیچید راه"
  },
  {
    "poem_id": 88003,
    "vorder": 167,
    "position": 0,
    "text": "تن‌آسان غم و رنج ‌بار آورد"
  },
  {
    "poem_id": 88003,
    "vorder": 168,
    "position": 1,
    "text": "چو رنج آوری گنج بار آورد"
  },
  {
    "poem_id": 88003,
    "vorder": 169,
    "position": 0,
    "text": "چو گویی که روزی تن‌آسان شوند"
  },
  {
    "poem_id": 88003,
    "vorder": 170,
    "position": 1,
    "text": "ز تیمار ایران هراسان شوند"
  },
  {
    "poem_id": 88003,
    "vorder": 171,
    "position": 0,
    "text": "ازین پس تو پیران و کلباد را"
  },
  {
    "poem_id": 88003,
    "vorder": 172,
    "position": 1,
    "text": "چو هومان و رویین و پولاد را"
  },
  {
    "poem_id": 88003,
    "vorder": 173,
    "position": 0,
    "text": "نگه کن بدین دشت با لشکری"
  },
  {
    "poem_id": 88003,
    "vorder": 174,
    "position": 1,
    "text": "تو در کشوری رستم از کشوری"
  },
  {
    "poem_id": 88003,
    "vorder": 175,
    "position": 0,
    "text": "اگر تاو دارید جنگ آورید"
  },
  {
    "poem_id": 88003,
    "vorder": 176,
    "position": 1,
    "text": "مرا زین سپس کی بچنگ آورید"
  },
  {
    "poem_id": 88003,
    "vorder": 177,
    "position": 0,
    "text": "که پیروز برگشتم از کارزار"
  },
  {
    "poem_id": 88003,
    "vorder": 178,
    "position": 1,
    "text": "تبه شد نکو گشته فرجام کار"
  },
  {
    "poem_id": 88003,
    "vorder": 179,
    "position": 0,
    "text": "برآشفت با طوس و شد چون پلنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 180,
    "position": 1,
    "text": "که این جای خوابست گر دشت جنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 181,
    "position": 0,
    "text": "طلایه نگه کن که از خیل کیست"
  },
  {
    "poem_id": 88003,
    "vorder": 182,
    "position": 1,
    "text": "سرآهنگ آن دوده را نام چیست"
  },
  {
    "poem_id": 88003,
    "vorder": 183,
    "position": 0,
    "text": "چو مرد طلایه بیابی بچوب"
  },
  {
    "poem_id": 88003,
    "vorder": 184,
    "position": 1,
    "text": "هم اندر زمان دست و پایش بکوب"
  },
  {
    "poem_id": 88003,
    "vorder": 185,
    "position": 0,
    "text": "ازو چیز بستان و پایش ببند"
  },
  {
    "poem_id": 88003,
    "vorder": 186,
    "position": 1,
    "text": "نگه کن یکی پشت پیلی بلند"
  },
  {
    "poem_id": 88003,
    "vorder": 187,
    "position": 0,
    "text": "بدین سان فرستش بنزدیک شاه"
  },
  {
    "poem_id": 88003,
    "vorder": 188,
    "position": 1,
    "text": "مگر پخته گردد بدان بارگاه"
  },
  {
    "poem_id": 88003,
    "vorder": 189,
    "position": 0,
    "text": "ز یاقوت وز گوهر و تخت عاج"
  },
  {
    "poem_id": 88003,
    "vorder": 190,
    "position": 1,
    "text": "ز دینار وز افسر و گنج و تاج"
  },
  {
    "poem_id": 88003,
    "vorder": 191,
    "position": 0,
    "text": "نگر تا که دارد ز ایران سپاه"
  },
  {
    "poem_id": 88003,
    "vorder": 192,
    "position": 1,
    "text": "همه یکسره خواسته پیش خواه"
  },
  {
    "poem_id": 88003,
    "vorder": 193,
    "position": 0,
    "text": "ازین هدیهٔ شاه باید نخست"
  },
  {
    "poem_id": 88003,
    "vorder": 194,
    "position": 1,
    "text": "پس آنگه مرا و ترا بهر جست"
  },
  {
    "poem_id": 88003,
    "vorder": 195,
    "position": 0,
    "text": "بدان دشت بسیار شاهان بدند"
  },
  {
    "poem_id": 88003,
    "vorder": 196,
    "position": 1,
    "text": "همه نامداران گیهان بدند"
  },
  {
    "poem_id": 88003,
    "vorder": 197,
    "position": 0,
    "text": "ز چین و ز سقلاب وز هند و وهر"
  },
  {
    "poem_id": 88003,
    "vorder": 198,
    "position": 1,
    "text": "همه گنج داران گیرنده شهر"
  },
  {
    "poem_id": 88003,
    "vorder": 199,
    "position": 0,
    "text": "سپهبد بیامد همه گرد کرد"
  },
  {
    "poem_id": 88003,
    "vorder": 200,
    "position": 1,
    "text": "برفتند گردان بدشت نبرد"
  },
  {
    "poem_id": 88003,
    "vorder": 201,
    "position": 0,
    "text": "کمرهای زرین و بیجاده تاج"
  },
  {
    "poem_id": 88003,
    "vorder": 202,
    "position": 1,
    "text": "ز دیبای رومی و از تخت عاج"
  },
  {
    "poem_id": 88003,
    "vorder": 203,
    "position": 0,
    "text": "ز تیر و کمان و ز برگستوان"
  },
  {
    "poem_id": 88003,
    "vorder": 204,
    "position": 1,
    "text": "ز گوپال وز خنجر هندوان"
  },
  {
    "poem_id": 88003,
    "vorder": 205,
    "position": 0,
    "text": "یکی کوه بد در میان دو کوه"
  },
  {
    "poem_id": 88003,
    "vorder": 206,
    "position": 1,
    "text": "نظاره شده گردش اندر گروه"
  },
  {
    "poem_id": 88003,
    "vorder": 207,
    "position": 0,
    "text": "کمان‌کش سواری گشاده‌بری"
  },
  {
    "poem_id": 88003,
    "vorder": 208,
    "position": 1,
    "text": "بتن زورمندی و کنداوری"
  },
  {
    "poem_id": 88003,
    "vorder": 209,
    "position": 0,
    "text": "خدنگی بینداختی چارپر"
  },
  {
    "poem_id": 88003,
    "vorder": 210,
    "position": 1,
    "text": "ازین سو بدان سو نکردی گذر"
  },
  {
    "poem_id": 88003,
    "vorder": 211,
    "position": 0,
    "text": "چو رستم نگه کرد خیره بماند"
  },
  {
    "poem_id": 88003,
    "vorder": 212,
    "position": 1,
    "text": "جهان آفرین را فراوان بخواند"
  },
  {
    "poem_id": 88003,
    "vorder": 213,
    "position": 0,
    "text": "چنین گفت کین روز ناپایدار"
  },
  {
    "poem_id": 88003,
    "vorder": 214,
    "position": 1,
    "text": "گهی بزم سازد گهی کارزار"
  },
  {
    "poem_id": 88003,
    "vorder": 215,
    "position": 0,
    "text": "همی گردد این خواسته زان برین"
  },
  {
    "poem_id": 88003,
    "vorder": 216,
    "position": 1,
    "text": "بنفرین بود گه گهی بفرین"
  },
  {
    "poem_id": 88003,
    "vorder": 217,
    "position": 0,
    "text": "زمانه نماند بآرام خویش"
  },
  {
    "poem_id": 88003,
    "vorder": 218,
    "position": 1,
    "text": "چنینست تا بود آیین و کیش"
  },
  {
    "poem_id": 88003,
    "vorder": 219,
    "position": 0,
    "text": "یکی گنج ازین سان همی پرورد"
  },
  {
    "poem_id": 88003,
    "vorder": 220,
    "position": 1,
    "text": "یکی دیگر آید کزو برخورد"
  },
  {
    "poem_id": 88003,
    "vorder": 221,
    "position": 0,
    "text": "بران بود کاموس و خاقان چین"
  },
  {
    "poem_id": 88003,
    "vorder": 222,
    "position": 1,
    "text": "که آتش برآرد ز ایران زمین"
  },
  {
    "poem_id": 88003,
    "vorder": 223,
    "position": 0,
    "text": "بدین ژنده پیلان و این خواسته"
  },
  {
    "poem_id": 88003,
    "vorder": 224,
    "position": 1,
    "text": "بدین لشکر و گنج آراسته"
  },
  {
    "poem_id": 88003,
    "vorder": 225,
    "position": 0,
    "text": "به گنج و بانبوه بودند شاد"
  },
  {
    "poem_id": 88003,
    "vorder": 226,
    "position": 1,
    "text": "زمانی ز یزدان نکردند یاد"
  },
  {
    "poem_id": 88003,
    "vorder": 227,
    "position": 0,
    "text": "که چرخ سپهر و زمان آفرید"
  },
  {
    "poem_id": 88003,
    "vorder": 228,
    "position": 1,
    "text": "بسی آشکار و نهان آفرید"
  },
  {
    "poem_id": 88003,
    "vorder": 229,
    "position": 0,
    "text": "ز یزدان شناس و بیزدان سپاس"
  },
  {
    "poem_id": 88003,
    "vorder": 230,
    "position": 1,
    "text": "بدو بگرود مرد نیکی‌شناس"
  },
  {
    "poem_id": 88003,
    "vorder": 231,
    "position": 0,
    "text": "کزو بودمان زور و فر و هنر"
  },
  {
    "poem_id": 88003,
    "vorder": 232,
    "position": 1,
    "text": "ازو دردمندی و هم زو گهر"
  },
  {
    "poem_id": 88003,
    "vorder": 233,
    "position": 0,
    "text": "سپه بود و هم گنج آباد بود"
  },
  {
    "poem_id": 88003,
    "vorder": 234,
    "position": 1,
    "text": "سگالش همه کار بیداد بود"
  },
  {
    "poem_id": 88003,
    "vorder": 235,
    "position": 0,
    "text": "کنون از بزرگان هر کشوری"
  },
  {
    "poem_id": 88003,
    "vorder": 236,
    "position": 1,
    "text": "گزیده ز هر کشوری مهتری"
  },
  {
    "poem_id": 88003,
    "vorder": 237,
    "position": 0,
    "text": "بدین ژنده پیلان فرستم بشاه"
  },
  {
    "poem_id": 88003,
    "vorder": 238,
    "position": 1,
    "text": "همان تخت زرین و زرین کلاه"
  },
  {
    "poem_id": 88003,
    "vorder": 239,
    "position": 0,
    "text": "همان خواسته بر هیونان مست"
  },
  {
    "poem_id": 88003,
    "vorder": 240,
    "position": 1,
    "text": "فرستم سزاوار چیزی که هست"
  },
  {
    "poem_id": 88003,
    "vorder": 241,
    "position": 0,
    "text": "وز ایدر شوم تازیان چون پلنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 242,
    "position": 1,
    "text": "درنگی نه والا بود مرد سنگ"
  },
  {
    "poem_id": 88003,
    "vorder": 243,
    "position": 0,
    "text": "کسی کو گنهکار و خونی بود"
  },
  {
    "poem_id": 88003,
    "vorder": 244,
    "position": 1,
    "text": "بکشور بمانی زبونی بود"
  },
  {
    "poem_id": 88003,
    "vorder": 245,
    "position": 0,
    "text": "زمین را بخنجر بشویم ز کین"
  },
  {
    "poem_id": 88003,
    "vorder": 246,
    "position": 1,
    "text": "بدان را نمانم همی بر زمین"
  },
  {
    "poem_id": 88003,
    "vorder": 247,
    "position": 0,
    "text": "بدو گفت گودرز کای نیک رای"
  },
  {
    "poem_id": 88003,
    "vorder": 248,
    "position": 1,
    "text": "تو تا جای ماند بمانی بجای"
  },
  {
    "poem_id": 88003,
    "vorder": 249,
    "position": 0,
    "text": "بکام دل شاد بادی و راد"
  },
  {
    "poem_id": 88003,
    "vorder": 250,
    "position": 1,
    "text": "بدین رزم دادی چو بایست داد"
  },
  {
    "poem_id": 88003,
    "vorder": 251,
    "position": 0,
    "text": "تهمتن فرستاده‌ای را بجست"
  },
  {
    "poem_id": 88003,
    "vorder": 252,
    "position": 1,
    "text": "که با شاه گستاخ باشد نخست"
  },
  {
    "poem_id": 88003,
    "vorder": 253,
    "position": 0,
    "text": "فریبرز کاوس را برگزید"
  },
  {
    "poem_id": 88003,
    "vorder": 254,
    "position": 1,
    "text": "که با شاه نزدیکی او را سزید"
  },
  {
    "poem_id": 88003,
    "vorder": 255,
    "position": 0,
    "text": "چنین گفت کای نیک پی نامدار"
  },
  {
    "poem_id": 88003,
    "vorder": 256,
    "position": 1,
    "text": "هم از تخم شاهی و هم شهریار"
  },
  {
    "poem_id": 88003,
    "vorder": 257,
    "position": 0,
    "text": "هنرمند و با دانش و بانژاد"
  },
  {
    "poem_id": 88003,
    "vorder": 258,
    "position": 1,
    "text": "تو شادان و کاوس شاه از تو شاد"
  },
  {
    "poem_id": 88003,
    "vorder": 259,
    "position": 0,
    "text": "یکی رنج برگیر و ز ایدر برو"
  },
  {
    "poem_id": 88003,
    "vorder": 260,
    "position": 1,
    "text": "ببر نامهٔ من بر شاه نو"
  },
  {
    "poem_id": 88003,
    "vorder": 261,
    "position": 0,
    "text": "ابا خویشتن بستگان را ببر"
  },
  {
    "poem_id": 88003,
    "vorder": 262,
    "position": 1,
    "text": "هیونان و این خواسته سربسر"
  },
  {
    "poem_id": 88003,
    "vorder": 263,
    "position": 0,
    "text": "همان افسر و یاره و گرز و تاج"
  },
  {
    "poem_id": 88003,
    "vorder": 264,
    "position": 1,
    "text": "همان ژنده پیلان و هم تخت عاج"
  },
  {
    "poem_id": 88003,
    "vorder": 265,
    "position": 0,
    "text": "فریبرز گفت ای هژبر ژیان"
  },
  {
    "poem_id": 88003,
    "vorder": 266,
    "position": 1,
    "text": "منم راه را تنگ بسته میان"
  }
]