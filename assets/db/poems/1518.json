[
  {
    "poem_id": 1518,
    "vorder": 1,
    "position": 0,
    "text": "یکی رومئی بود میرین به نام"
  },
  {
    "poem_id": 1518,
    "vorder": 2,
    "position": 1,
    "text": "سرافراز و بارای و با گنج و کام"
  },
  {
    "poem_id": 1518,
    "vorder": 3,
    "position": 0,
    "text": "فرستاد نزدیک قیصر پیام"
  },
  {
    "poem_id": 1518,
    "vorder": 4,
    "position": 1,
    "text": "که من سرفرازم به گنج و به نام"
  },
  {
    "poem_id": 1518,
    "vorder": 5,
    "position": 0,
    "text": "به من ده دل‌آرام دخترت را"
  },
  {
    "poem_id": 1518,
    "vorder": 6,
    "position": 1,
    "text": "به من تازه کن نام و افسرت را"
  },
  {
    "poem_id": 1518,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت قیصر که من زین سپس"
  },
  {
    "poem_id": 1518,
    "vorder": 8,
    "position": 1,
    "text": "نجویم بدین روی پیوند کس"
  },
  {
    "poem_id": 1518,
    "vorder": 9,
    "position": 0,
    "text": "کتایون و آن مرد ناسرفراز"
  },
  {
    "poem_id": 1518,
    "vorder": 10,
    "position": 1,
    "text": "مرا داشتند از چنان کار باز"
  },
  {
    "poem_id": 1518,
    "vorder": 11,
    "position": 0,
    "text": "کنون هرک جویند خویشی من"
  },
  {
    "poem_id": 1518,
    "vorder": 12,
    "position": 1,
    "text": "وگر سر فرازد به پیشی من"
  },
  {
    "poem_id": 1518,
    "vorder": 13,
    "position": 0,
    "text": "یکی کار بایدش کردن بزرگ"
  },
  {
    "poem_id": 1518,
    "vorder": 14,
    "position": 1,
    "text": "که خوانندش ایدر بزرگان سترگ"
  },
  {
    "poem_id": 1518,
    "vorder": 15,
    "position": 0,
    "text": "چنو در جهان نامداری بود"
  },
  {
    "poem_id": 1518,
    "vorder": 16,
    "position": 1,
    "text": "مرا بر زمین نیز یاری بود"
  },
  {
    "poem_id": 1518,
    "vorder": 17,
    "position": 0,
    "text": "شود تا سر بیشهٔ فاسقون"
  },
  {
    "poem_id": 1518,
    "vorder": 18,
    "position": 1,
    "text": "بشوید دل و دست و مغزش به خون"
  },
  {
    "poem_id": 1518,
    "vorder": 19,
    "position": 0,
    "text": "یکی گرگ بیند به کردار نیل"
  },
  {
    "poem_id": 1518,
    "vorder": 20,
    "position": 1,
    "text": "تن اژدها دارد و زور پیل"
  },
  {
    "poem_id": 1518,
    "vorder": 21,
    "position": 0,
    "text": "سرو دارد و نیشتر چون گراز"
  },
  {
    "poem_id": 1518,
    "vorder": 22,
    "position": 1,
    "text": "نیارد شدن پیل پیشش فراز"
  },
  {
    "poem_id": 1518,
    "vorder": 23,
    "position": 0,
    "text": "بران بیشه بر نگذرد نره شیر"
  },
  {
    "poem_id": 1518,
    "vorder": 24,
    "position": 1,
    "text": "نه پیل و نه خونریز مرد دلیر"
  },
  {
    "poem_id": 1518,
    "vorder": 25,
    "position": 0,
    "text": "هر آنکس که بر وی بدرید پوست"
  },
  {
    "poem_id": 1518,
    "vorder": 26,
    "position": 1,
    "text": "مرا باشد او یار و داماد و دوست"
  },
  {
    "poem_id": 1518,
    "vorder": 27,
    "position": 0,
    "text": "چنین گفت میرین برین زادبوم"
  },
  {
    "poem_id": 1518,
    "vorder": 28,
    "position": 1,
    "text": "جهان آفرین تا پی افگند روم"
  },
  {
    "poem_id": 1518,
    "vorder": 29,
    "position": 0,
    "text": "نیاکان ما جز به گرز گران"
  },
  {
    "poem_id": 1518,
    "vorder": 30,
    "position": 1,
    "text": "نکردند پیکار با مهتران"
  },
  {
    "poem_id": 1518,
    "vorder": 31,
    "position": 0,
    "text": "کنون قیصر از من بجوید همی"
  },
  {
    "poem_id": 1518,
    "vorder": 32,
    "position": 1,
    "text": "سخن با من از کینه گوید همی"
  },
  {
    "poem_id": 1518,
    "vorder": 33,
    "position": 0,
    "text": "من این چاره اکنون بجای آورم"
  },
  {
    "poem_id": 1518,
    "vorder": 34,
    "position": 1,
    "text": "ز هرگونه پاکیزه رای آورم"
  },
  {
    "poem_id": 1518,
    "vorder": 35,
    "position": 0,
    "text": "چو آمد به ایوان پسندیده مرد"
  },
  {
    "poem_id": 1518,
    "vorder": 36,
    "position": 1,
    "text": "ز هرگونه اندیشه‌ها یاد کرد"
  },
  {
    "poem_id": 1518,
    "vorder": 37,
    "position": 0,
    "text": "نوشته بیاورد و بنهاد پیش"
  },
  {
    "poem_id": 1518,
    "vorder": 38,
    "position": 1,
    "text": "همان اختر و طالع و فال خویش"
  },
  {
    "poem_id": 1518,
    "vorder": 39,
    "position": 0,
    "text": "چنان دید کاندر فلان روزگار"
  },
  {
    "poem_id": 1518,
    "vorder": 40,
    "position": 1,
    "text": "از ایران بیاید یکی نامدار"
  },
  {
    "poem_id": 1518,
    "vorder": 41,
    "position": 0,
    "text": "به دستش برآید سه کار گران"
  },
  {
    "poem_id": 1518,
    "vorder": 42,
    "position": 1,
    "text": "کزان باز گویند رومی سران"
  },
  {
    "poem_id": 1518,
    "vorder": 43,
    "position": 0,
    "text": "یکی انک داماد قیصر شود"
  },
  {
    "poem_id": 1518,
    "vorder": 44,
    "position": 1,
    "text": "همان بر سر قیصر افسر شود"
  },
  {
    "poem_id": 1518,
    "vorder": 45,
    "position": 0,
    "text": "پدید آید از روی کشور دو دد"
  },
  {
    "poem_id": 1518,
    "vorder": 46,
    "position": 1,
    "text": "که هرکس رسد از بد دد به بد"
  },
  {
    "poem_id": 1518,
    "vorder": 47,
    "position": 0,
    "text": "شود هردو بر دست او بر هلاک"
  },
  {
    "poem_id": 1518,
    "vorder": 48,
    "position": 1,
    "text": "ز هر زورمندی نیایدش باک"
  },
  {
    "poem_id": 1518,
    "vorder": 49,
    "position": 0,
    "text": "ز کار کتایون خود آگاه بود"
  },
  {
    "poem_id": 1518,
    "vorder": 50,
    "position": 1,
    "text": "که با نیو گشتاسپ همراه بود"
  },
  {
    "poem_id": 1518,
    "vorder": 51,
    "position": 0,
    "text": "ز هیشوی و آن مهتر نامجوی"
  },
  {
    "poem_id": 1518,
    "vorder": 52,
    "position": 1,
    "text": "که هر سه به روی اندر آرند روی"
  },
  {
    "poem_id": 1518,
    "vorder": 53,
    "position": 0,
    "text": "بیامد به نزدیک هیشوی تفت"
  },
  {
    "poem_id": 1518,
    "vorder": 54,
    "position": 1,
    "text": "سراسر بگفت آن سخنها که رفت"
  },
  {
    "poem_id": 1518,
    "vorder": 55,
    "position": 0,
    "text": "وزان اختر فیلسوفان روم"
  },
  {
    "poem_id": 1518,
    "vorder": 56,
    "position": 1,
    "text": "شگفتی که آید بدان مرز و بوم"
  },
  {
    "poem_id": 1518,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت هیشوی کامروز شاد"
  },
  {
    "poem_id": 1518,
    "vorder": 58,
    "position": 1,
    "text": "بر ما همی باش با مهر و داد"
  },
  {
    "poem_id": 1518,
    "vorder": 59,
    "position": 0,
    "text": "که این مرد کز وی تو دادی نشان"
  },
  {
    "poem_id": 1518,
    "vorder": 60,
    "position": 1,
    "text": "یکی نامداریست از سرکشان"
  },
  {
    "poem_id": 1518,
    "vorder": 61,
    "position": 0,
    "text": "به نخچیر دارد همی روی و رای"
  },
  {
    "poem_id": 1518,
    "vorder": 62,
    "position": 1,
    "text": "نیندیشد از تخت خاور خدای"
  },
  {
    "poem_id": 1518,
    "vorder": 63,
    "position": 0,
    "text": "یکی دی نیامد به نزدیک من"
  },
  {
    "poem_id": 1518,
    "vorder": 64,
    "position": 1,
    "text": "که خرم شدی جان تاریک من"
  },
  {
    "poem_id": 1518,
    "vorder": 65,
    "position": 0,
    "text": "بیاید هم‌اکنون ز نخچیرگاه"
  },
  {
    "poem_id": 1518,
    "vorder": 66,
    "position": 1,
    "text": "بما بر بود بی‌گمانیش راه"
  },
  {
    "poem_id": 1518,
    "vorder": 67,
    "position": 0,
    "text": "می و رود آورد با بوی و رنگ"
  },
  {
    "poem_id": 1518,
    "vorder": 68,
    "position": 1,
    "text": "نشستند با جام زرین به چنگ"
  },
  {
    "poem_id": 1518,
    "vorder": 69,
    "position": 0,
    "text": "هم انگه که شد جام می بر چهار"
  },
  {
    "poem_id": 1518,
    "vorder": 70,
    "position": 1,
    "text": "پدید آمد از دشت گرد سوار"
  },
  {
    "poem_id": 1518,
    "vorder": 71,
    "position": 0,
    "text": "چو هیشوی و میرین بدیدند گرد"
  },
  {
    "poem_id": 1518,
    "vorder": 72,
    "position": 1,
    "text": "پذیره شدندش به دشت نبرد"
  },
  {
    "poem_id": 1518,
    "vorder": 73,
    "position": 0,
    "text": "چو میرین بدیدش به هیشوی گفت"
  },
  {
    "poem_id": 1518,
    "vorder": 74,
    "position": 1,
    "text": "که این را به گیتی کسی نیست جفت"
  },
  {
    "poem_id": 1518,
    "vorder": 75,
    "position": 0,
    "text": "بدین شاخ و این یال و این دستبرد"
  },
  {
    "poem_id": 1518,
    "vorder": 76,
    "position": 1,
    "text": "ز تخمی بود نامبردار و گرد"
  },
  {
    "poem_id": 1518,
    "vorder": 77,
    "position": 0,
    "text": "هنرها ز دیدار او بگذرد"
  },
  {
    "poem_id": 1518,
    "vorder": 78,
    "position": 1,
    "text": "همان شرم و آزردگی و خرد"
  },
  {
    "poem_id": 1518,
    "vorder": 79,
    "position": 0,
    "text": "چو گشتاسپ تنگ آمد این هر دو مرد"
  },
  {
    "poem_id": 1518,
    "vorder": 80,
    "position": 1,
    "text": "پیاده ببودند ز اسپ نبرد"
  },
  {
    "poem_id": 1518,
    "vorder": 81,
    "position": 0,
    "text": "نشستی نو آراست بر پیش آب"
  },
  {
    "poem_id": 1518,
    "vorder": 82,
    "position": 1,
    "text": "یکی خوان نو ساخت اندر شتاب"
  },
  {
    "poem_id": 1518,
    "vorder": 83,
    "position": 0,
    "text": "می آورد با میگساران نو"
  },
  {
    "poem_id": 1518,
    "vorder": 84,
    "position": 1,
    "text": "نشستی نو آیین و یاران نو"
  },
  {
    "poem_id": 1518,
    "vorder": 85,
    "position": 0,
    "text": "چو رخ لعل گشت از می لعل فام"
  },
  {
    "poem_id": 1518,
    "vorder": 86,
    "position": 1,
    "text": "به گشتاسپ هیشوی گفت ای همام"
  },
  {
    "poem_id": 1518,
    "vorder": 87,
    "position": 0,
    "text": "مرا بر زمین دوست خوانی همی"
  },
  {
    "poem_id": 1518,
    "vorder": 88,
    "position": 1,
    "text": "جز از من کسی را ندانی همی"
  },
  {
    "poem_id": 1518,
    "vorder": 89,
    "position": 0,
    "text": "کنون سوی من کرد میرین پناه"
  },
  {
    "poem_id": 1518,
    "vorder": 90,
    "position": 1,
    "text": "یکی نامدارست با دستگاه"
  },
  {
    "poem_id": 1518,
    "vorder": 91,
    "position": 0,
    "text": "دبیرست با دانش و ارجمند"
  },
  {
    "poem_id": 1518,
    "vorder": 92,
    "position": 1,
    "text": "بگیرد شمار سپهر بلند"
  },
  {
    "poem_id": 1518,
    "vorder": 93,
    "position": 0,
    "text": "سخن گوید از فیلسوفان روم"
  },
  {
    "poem_id": 1518,
    "vorder": 94,
    "position": 1,
    "text": "ز آباد و ویران هر مرز و بوم"
  },
  {
    "poem_id": 1518,
    "vorder": 95,
    "position": 0,
    "text": "هم از گوهر سلم دارد نژاد"
  },
  {
    "poem_id": 1518,
    "vorder": 96,
    "position": 1,
    "text": "پدر بر پدر نام دارد به یاد"
  },
  {
    "poem_id": 1518,
    "vorder": 97,
    "position": 0,
    "text": "به نزدیک اویست شمشیر سلم"
  },
  {
    "poem_id": 1518,
    "vorder": 98,
    "position": 1,
    "text": "که بودی همه ساله در زیر سلم"
  },
  {
    "poem_id": 1518,
    "vorder": 99,
    "position": 0,
    "text": "سواریست گردافکن و شیر گیر"
  },
  {
    "poem_id": 1518,
    "vorder": 100,
    "position": 1,
    "text": "عقاب اندر آرد ز گردون به تیر"
  },
  {
    "poem_id": 1518,
    "vorder": 101,
    "position": 0,
    "text": "برین نیز خواهد که بیشی کند"
  },
  {
    "poem_id": 1518,
    "vorder": 102,
    "position": 1,
    "text": "چو با قیصر روم خویشی کند"
  },
  {
    "poem_id": 1518,
    "vorder": 103,
    "position": 0,
    "text": "به قیصر سخن گفت و پاسخ شنید"
  },
  {
    "poem_id": 1518,
    "vorder": 104,
    "position": 1,
    "text": "ز پاسخ همانا دلش بردمید"
  },
  {
    "poem_id": 1518,
    "vorder": 105,
    "position": 0,
    "text": "که او گفت در بیشهٔ فاسقون"
  },
  {
    "poem_id": 1518,
    "vorder": 106,
    "position": 1,
    "text": "یکی گرگ باشد بسان هیون"
  },
  {
    "poem_id": 1518,
    "vorder": 107,
    "position": 0,
    "text": "اگر کشته آید به دست تو گرگ"
  },
  {
    "poem_id": 1518,
    "vorder": 108,
    "position": 1,
    "text": "تو باشی به روم ایرمانی بزرگ"
  },
  {
    "poem_id": 1518,
    "vorder": 109,
    "position": 0,
    "text": "جهاندار باشی و داماد من"
  },
  {
    "poem_id": 1518,
    "vorder": 110,
    "position": 1,
    "text": "زمانه به خوبی دهد داد من"
  },
  {
    "poem_id": 1518,
    "vorder": 111,
    "position": 0,
    "text": "کنون گر تو این را کنی دست پیش"
  },
  {
    "poem_id": 1518,
    "vorder": 112,
    "position": 1,
    "text": "منت بنده‌ام وین سرافراز خویش"
  },
  {
    "poem_id": 1518,
    "vorder": 113,
    "position": 0,
    "text": "بدو گفت گشتاسپ کری رواست"
  },
  {
    "poem_id": 1518,
    "vorder": 114,
    "position": 1,
    "text": "چه گویند و این بیشه اکنون کجاست"
  },
  {
    "poem_id": 1518,
    "vorder": 115,
    "position": 0,
    "text": "چگونه ددی باشد اندر جهان"
  },
  {
    "poem_id": 1518,
    "vorder": 116,
    "position": 1,
    "text": "که ترسند ازو کهتران و مهان"
  },
  {
    "poem_id": 1518,
    "vorder": 117,
    "position": 0,
    "text": "چنین گفت هیشوی کاین پیر گرگ"
  },
  {
    "poem_id": 1518,
    "vorder": 118,
    "position": 1,
    "text": "همی برتر است از هیونی سترگ"
  },
  {
    "poem_id": 1518,
    "vorder": 119,
    "position": 0,
    "text": "دو دندان او چون دو دندان پیل"
  },
  {
    "poem_id": 1518,
    "vorder": 120,
    "position": 1,
    "text": "دو چشمش طبر خون و چرمش چو نیل"
  },
  {
    "poem_id": 1518,
    "vorder": 121,
    "position": 0,
    "text": "سروهاش چو آبنوسی فرسپ"
  },
  {
    "poem_id": 1518,
    "vorder": 122,
    "position": 1,
    "text": "چو خشم آورد بگذرد بر دو اسپ"
  },
  {
    "poem_id": 1518,
    "vorder": 123,
    "position": 0,
    "text": "از ایدر بسی نامور قیصران"
  },
  {
    "poem_id": 1518,
    "vorder": 124,
    "position": 1,
    "text": "برفتند با گرزهای گران"
  },
  {
    "poem_id": 1518,
    "vorder": 125,
    "position": 0,
    "text": "ازان بیشه ناکام باز آمدند"
  },
  {
    "poem_id": 1518,
    "vorder": 126,
    "position": 1,
    "text": "پر از ننگ و تن پر گداز آمدند"
  },
  {
    "poem_id": 1518,
    "vorder": 127,
    "position": 0,
    "text": "بدو گفت گشتاسپ کان تیغ سلم"
  },
  {
    "poem_id": 1518,
    "vorder": 128,
    "position": 1,
    "text": "بیارید و اسپس سرافراز گرم"
  },
  {
    "poem_id": 1518,
    "vorder": 129,
    "position": 0,
    "text": "همی اژدها خوانم این را نه گرگ"
  },
  {
    "poem_id": 1518,
    "vorder": 130,
    "position": 1,
    "text": "تو گرگی مدان از هیونی بزرگ"
  },
  {
    "poem_id": 1518,
    "vorder": 131,
    "position": 0,
    "text": "چو بشنید میرین زانجا برفت"
  },
  {
    "poem_id": 1518,
    "vorder": 132,
    "position": 1,
    "text": "سوی خانهٔ خویش تازید تفت"
  },
  {
    "poem_id": 1518,
    "vorder": 133,
    "position": 0,
    "text": "ز آخر گزین کرد اسپی سیاه"
  },
  {
    "poem_id": 1518,
    "vorder": 134,
    "position": 1,
    "text": "گرانمایه خفتان و رومی کلاه"
  },
  {
    "poem_id": 1518,
    "vorder": 135,
    "position": 0,
    "text": "همان مایه‌ور تیغ الماس گون"
  },
  {
    "poem_id": 1518,
    "vorder": 136,
    "position": 1,
    "text": "که سلم آب دادش به زهر و به خون"
  },
  {
    "poem_id": 1518,
    "vorder": 137,
    "position": 0,
    "text": "بسی هدیه بگزید با آن ز گنج"
  },
  {
    "poem_id": 1518,
    "vorder": 138,
    "position": 1,
    "text": "ز یاقوت و گوهر همه پنج‌پنج"
  },
  {
    "poem_id": 1518,
    "vorder": 139,
    "position": 0,
    "text": "چو خورشید پیراهن قیرگون"
  },
  {
    "poem_id": 1518,
    "vorder": 140,
    "position": 1,
    "text": "بدرید و آمد ز پرده برون"
  },
  {
    "poem_id": 1518,
    "vorder": 141,
    "position": 0,
    "text": "جهانجوی میرین ز ایوان برفت"
  },
  {
    "poem_id": 1518,
    "vorder": 142,
    "position": 1,
    "text": "بیامد به نزدیک هیشوی تفت"
  },
  {
    "poem_id": 1518,
    "vorder": 143,
    "position": 0,
    "text": "ز نخچیر گشتاسپ زانسو کشید"
  },
  {
    "poem_id": 1518,
    "vorder": 144,
    "position": 1,
    "text": "نگه کرد هیشوی و اورا بدید"
  },
  {
    "poem_id": 1518,
    "vorder": 145,
    "position": 0,
    "text": "ازان اسپ و شمشیر خیره شدند"
  },
  {
    "poem_id": 1518,
    "vorder": 146,
    "position": 1,
    "text": "چو نزدیک‌تر شد پذیره شدند"
  },
  {
    "poem_id": 1518,
    "vorder": 147,
    "position": 0,
    "text": "چو گشتاسپ آن هدیه‌ها بنگرید"
  },
  {
    "poem_id": 1518,
    "vorder": 148,
    "position": 1,
    "text": "همان اسپ و تیغ از میان برگزید"
  },
  {
    "poem_id": 1518,
    "vorder": 149,
    "position": 0,
    "text": "دگر چیز بخشید هیشوی را"
  },
  {
    "poem_id": 1518,
    "vorder": 150,
    "position": 1,
    "text": "بیاراست جان جهانجوی را"
  },
  {
    "poem_id": 1518,
    "vorder": 151,
    "position": 0,
    "text": "بپوشید گشتاسپ خفتان چو گرد"
  },
  {
    "poem_id": 1518,
    "vorder": 152,
    "position": 1,
    "text": "به زیر اندر آورد اسپ نبرد"
  },
  {
    "poem_id": 1518,
    "vorder": 153,
    "position": 0,
    "text": "به زه بر کمان و به بازو کمند"
  },
  {
    "poem_id": 1518,
    "vorder": 154,
    "position": 1,
    "text": "سواری سرافراز و اسپی بلند"
  },
  {
    "poem_id": 1518,
    "vorder": 155,
    "position": 0,
    "text": "همی رفت هیشوی با او به راه"
  },
  {
    "poem_id": 1518,
    "vorder": 156,
    "position": 1,
    "text": "جهانجوی میرین فریاد خواه"
  },
  {
    "poem_id": 1518,
    "vorder": 157,
    "position": 0,
    "text": "چنین تا لب بیشهٔ فاسقون"
  },
  {
    "poem_id": 1518,
    "vorder": 158,
    "position": 1,
    "text": "برفتند پیچان و دل پر ز خون"
  }
]