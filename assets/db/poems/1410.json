[
  {
    "poem_id": 1410,
    "vorder": 1,
    "position": 0,
    "text": "برآسود پس لشکر از هر دو روی"
  },
  {
    "poem_id": 1410,
    "vorder": 2,
    "position": 1,
    "text": "برفتند روز دوم جنگجوی"
  },
  {
    "poem_id": 1410,
    "vorder": 3,
    "position": 0,
    "text": "رده برکشیدند ایرانیان"
  },
  {
    "poem_id": 1410,
    "vorder": 4,
    "position": 1,
    "text": "چنان چون بود ساز جنگ کیان"
  },
  {
    "poem_id": 1410,
    "vorder": 5,
    "position": 0,
    "text": "چو افراسیاب آن سپه را بدید"
  },
  {
    "poem_id": 1410,
    "vorder": 6,
    "position": 1,
    "text": "بزد کوس رویین و صف برکشید"
  },
  {
    "poem_id": 1410,
    "vorder": 7,
    "position": 0,
    "text": "چنان شد ز گرد سواران جهان"
  },
  {
    "poem_id": 1410,
    "vorder": 8,
    "position": 1,
    "text": "که خورشید گفتی شد اندر نهان"
  },
  {
    "poem_id": 1410,
    "vorder": 9,
    "position": 0,
    "text": "دهاده برآمد ز هر دو گروه"
  },
  {
    "poem_id": 1410,
    "vorder": 10,
    "position": 1,
    "text": "بیابان نبود ایچ پیدا ز کوه"
  },
  {
    "poem_id": 1410,
    "vorder": 11,
    "position": 0,
    "text": "برانسان سپه بر هم آویختند"
  },
  {
    "poem_id": 1410,
    "vorder": 12,
    "position": 1,
    "text": "چو رود روان خون همی ریختند"
  },
  {
    "poem_id": 1410,
    "vorder": 13,
    "position": 0,
    "text": "به هر سو که قارن شدی رزمخواه"
  },
  {
    "poem_id": 1410,
    "vorder": 14,
    "position": 1,
    "text": "فرو ریختی خون ز گرد سیاه"
  },
  {
    "poem_id": 1410,
    "vorder": 15,
    "position": 0,
    "text": "کجا خاستی گُردْ افراسیاب"
  },
  {
    "poem_id": 1410,
    "vorder": 16,
    "position": 1,
    "text": "همه خون شدی دشت چون رود آب"
  },
  {
    "poem_id": 1410,
    "vorder": 17,
    "position": 0,
    "text": "سرانجام نوذر ز قلب سپاه"
  },
  {
    "poem_id": 1410,
    "vorder": 18,
    "position": 1,
    "text": "بیامد به نزدیک او رزمخواه"
  },
  {
    "poem_id": 1410,
    "vorder": 19,
    "position": 0,
    "text": "چنان نیزه بر نیزه انداختند"
  },
  {
    "poem_id": 1410,
    "vorder": 20,
    "position": 1,
    "text": "سنان یک به دیگر برافراختند"
  },
  {
    "poem_id": 1410,
    "vorder": 21,
    "position": 0,
    "text": "که بر هم نپیچد بران گونه مار"
  },
  {
    "poem_id": 1410,
    "vorder": 22,
    "position": 1,
    "text": "شهان را چنین کی بود کارزار"
  },
  {
    "poem_id": 1410,
    "vorder": 23,
    "position": 0,
    "text": "چنین تا شب تیره آمد به تنگ"
  },
  {
    "poem_id": 1410,
    "vorder": 24,
    "position": 1,
    "text": "برو خیره شد دست پور پشنگ"
  },
  {
    "poem_id": 1410,
    "vorder": 25,
    "position": 0,
    "text": "از ایران سپه بیشتر خسته شد"
  },
  {
    "poem_id": 1410,
    "vorder": 26,
    "position": 1,
    "text": "وزان روی پیکار پیوسته شد"
  },
  {
    "poem_id": 1410,
    "vorder": 27,
    "position": 0,
    "text": "به بیچارگی روی برگاشتند"
  },
  {
    "poem_id": 1410,
    "vorder": 28,
    "position": 1,
    "text": "به هامون برافگنده بگذاشتند"
  },
  {
    "poem_id": 1410,
    "vorder": 29,
    "position": 0,
    "text": "دل نوذر از غم پر از درد بود"
  },
  {
    "poem_id": 1410,
    "vorder": 30,
    "position": 1,
    "text": "که تاجش ز اختر پر از گرد بود"
  },
  {
    "poem_id": 1410,
    "vorder": 31,
    "position": 0,
    "text": "چو از دشت بنشست آوای کوس"
  },
  {
    "poem_id": 1410,
    "vorder": 32,
    "position": 1,
    "text": "بفرمود تا پیش او رفت طوس"
  },
  {
    "poem_id": 1410,
    "vorder": 33,
    "position": 0,
    "text": "بشد طوس و گستهم با او به هم"
  },
  {
    "poem_id": 1410,
    "vorder": 34,
    "position": 1,
    "text": "لبان پر ز باد و روان پر ز غم"
  },
  {
    "poem_id": 1410,
    "vorder": 35,
    "position": 0,
    "text": "بگفت آنک در دل مرا درد چیست"
  },
  {
    "poem_id": 1410,
    "vorder": 36,
    "position": 1,
    "text": "همی گفت چندی و چندی گریست"
  },
  {
    "poem_id": 1410,
    "vorder": 37,
    "position": 0,
    "text": "از اندرز فرخ پدر یاد کرد"
  },
  {
    "poem_id": 1410,
    "vorder": 38,
    "position": 1,
    "text": "پر از خون جگر لب پر از باد سرد"
  },
  {
    "poem_id": 1410,
    "vorder": 39,
    "position": 0,
    "text": "کجا گفته بودش که از ترک و چین"
  },
  {
    "poem_id": 1410,
    "vorder": 40,
    "position": 1,
    "text": "سپاهی بیاید به ایران زمین"
  },
  {
    "poem_id": 1410,
    "vorder": 41,
    "position": 0,
    "text": "ازیشان ترا دل شود دردمند"
  },
  {
    "poem_id": 1410,
    "vorder": 42,
    "position": 1,
    "text": "بسی بر سپاه تو آید گزند"
  },
  {
    "poem_id": 1410,
    "vorder": 43,
    "position": 0,
    "text": "ز گفتار شاه آمد اکنون نشان"
  },
  {
    "poem_id": 1410,
    "vorder": 44,
    "position": 1,
    "text": "فراز آمد آن روز گردنکشان"
  },
  {
    "poem_id": 1410,
    "vorder": 45,
    "position": 0,
    "text": "کس از نامهٔ نامداران نخواند"
  },
  {
    "poem_id": 1410,
    "vorder": 46,
    "position": 1,
    "text": "که چندین سپه کس ز ترکان براند"
  },
  {
    "poem_id": 1410,
    "vorder": 47,
    "position": 0,
    "text": "شما را سوی پارس باید شدن"
  },
  {
    "poem_id": 1410,
    "vorder": 48,
    "position": 1,
    "text": "شبستان بیاوردن و آمدن"
  },
  {
    "poem_id": 1410,
    "vorder": 49,
    "position": 0,
    "text": "وزان جا کشیدن سوی زاوه کوه"
  },
  {
    "poem_id": 1410,
    "vorder": 50,
    "position": 1,
    "text": "بران کوه البرز بردن گروه"
  },
  {
    "poem_id": 1410,
    "vorder": 51,
    "position": 0,
    "text": "ازیدر کنون زی سپاهان روید"
  },
  {
    "poem_id": 1410,
    "vorder": 52,
    "position": 1,
    "text": "وزین لشکر خویش پنهان روید"
  },
  {
    "poem_id": 1410,
    "vorder": 53,
    "position": 0,
    "text": "ز کار شما دل شکسته شوند"
  },
  {
    "poem_id": 1410,
    "vorder": 54,
    "position": 1,
    "text": "برین خستگی نیز خسته شوند"
  },
  {
    "poem_id": 1410,
    "vorder": 55,
    "position": 0,
    "text": "ز تخم فریدون مگر یک دو تن"
  },
  {
    "poem_id": 1410,
    "vorder": 56,
    "position": 1,
    "text": "برد جان ازین بی‌شمار انجمن"
  },
  {
    "poem_id": 1410,
    "vorder": 57,
    "position": 0,
    "text": "ندانم که دیدار باشد جزین"
  },
  {
    "poem_id": 1410,
    "vorder": 58,
    "position": 1,
    "text": "یک امشب بکوشیم دست پسین"
  },
  {
    "poem_id": 1410,
    "vorder": 59,
    "position": 0,
    "text": "شب و روز دارید کارآگهان"
  },
  {
    "poem_id": 1410,
    "vorder": 60,
    "position": 1,
    "text": "بجویید هشیار کار جهان"
  },
  {
    "poem_id": 1410,
    "vorder": 61,
    "position": 0,
    "text": "ازین لشکر ار بد دهند آگهی"
  },
  {
    "poem_id": 1410,
    "vorder": 62,
    "position": 1,
    "text": "شود تیره این فر شاهنشهی"
  },
  {
    "poem_id": 1410,
    "vorder": 63,
    "position": 0,
    "text": "شما دل مدارید بس مستمند"
  },
  {
    "poem_id": 1410,
    "vorder": 64,
    "position": 1,
    "text": "که باید چنین بد ز چرخ بلند"
  },
  {
    "poem_id": 1410,
    "vorder": 65,
    "position": 0,
    "text": "یکی را به جنگ اندر آید زمان"
  },
  {
    "poem_id": 1410,
    "vorder": 66,
    "position": 1,
    "text": "یکی با کلاه مهی شادمان"
  },
  {
    "poem_id": 1410,
    "vorder": 67,
    "position": 0,
    "text": "تن کشته با مرده یکسان شود"
  },
  {
    "poem_id": 1410,
    "vorder": 68,
    "position": 1,
    "text": "تپد یک زمان بازش آسان شود"
  },
  {
    "poem_id": 1410,
    "vorder": 69,
    "position": 0,
    "text": "بدادش مران پندها چون سزید"
  },
  {
    "poem_id": 1410,
    "vorder": 70,
    "position": 1,
    "text": "پس آن دست شاهانه بیرون کشید"
  },
  {
    "poem_id": 1410,
    "vorder": 71,
    "position": 0,
    "text": "گرفت آن دو فرزند را در کنار"
  },
  {
    "poem_id": 1410,
    "vorder": 72,
    "position": 1,
    "text": "فرو ریخت آب از مژه شهریار"
  }
]