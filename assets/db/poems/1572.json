[
  {
    "poem_id": 1572,
    "vorder": 1,
    "position": 0,
    "text": "چو ماه از بر تخت سیمین نشست"
  },
  {
    "poem_id": 1572,
    "vorder": 2,
    "position": 1,
    "text": "سه پاس از شب تیره اندر گذشت"
  },
  {
    "poem_id": 1572,
    "vorder": 3,
    "position": 0,
    "text": "همی پاسبان برخروشید سخت"
  },
  {
    "poem_id": 1572,
    "vorder": 4,
    "position": 1,
    "text": "که گشتاسپ شاهست و پیروز بخت"
  },
  {
    "poem_id": 1572,
    "vorder": 5,
    "position": 0,
    "text": "چو ترکان شنیدند زان سان خروش"
  },
  {
    "poem_id": 1572,
    "vorder": 6,
    "position": 1,
    "text": "نهادند یکسر به آواز گوش"
  },
  {
    "poem_id": 1572,
    "vorder": 7,
    "position": 0,
    "text": "دل کهرم از پاسبان خیره شد"
  },
  {
    "poem_id": 1572,
    "vorder": 8,
    "position": 1,
    "text": "روانش ز آواز او تیره شد"
  },
  {
    "poem_id": 1572,
    "vorder": 9,
    "position": 0,
    "text": "چو بشنید با اندریمان بگفت"
  },
  {
    "poem_id": 1572,
    "vorder": 10,
    "position": 1,
    "text": "که تیره شب آواز نتوان نهفت"
  },
  {
    "poem_id": 1572,
    "vorder": 11,
    "position": 0,
    "text": "چه گویی که امشب چه شاید بدن"
  },
  {
    "poem_id": 1572,
    "vorder": 12,
    "position": 1,
    "text": "بباید همی داستانها زدن"
  },
  {
    "poem_id": 1572,
    "vorder": 13,
    "position": 0,
    "text": "که یارد گشادن بدین سان دو لب"
  },
  {
    "poem_id": 1572,
    "vorder": 14,
    "position": 1,
    "text": "به بالین شاهی درین تیره‌شب"
  },
  {
    "poem_id": 1572,
    "vorder": 15,
    "position": 0,
    "text": "بباید فرستاد تا هرک هست"
  },
  {
    "poem_id": 1572,
    "vorder": 16,
    "position": 1,
    "text": "سرانشان به خنجر ببرند پست"
  },
  {
    "poem_id": 1572,
    "vorder": 17,
    "position": 0,
    "text": "چه بازی کند پاسبان روز جنگ"
  },
  {
    "poem_id": 1572,
    "vorder": 18,
    "position": 1,
    "text": "برین نامداران شود کار تنگ"
  },
  {
    "poem_id": 1572,
    "vorder": 19,
    "position": 0,
    "text": "وگر دشمن ما بود خانگی"
  },
  {
    "poem_id": 1572,
    "vorder": 20,
    "position": 1,
    "text": "بجوی همی روز بیگانگی"
  },
  {
    "poem_id": 1572,
    "vorder": 21,
    "position": 0,
    "text": "به آواز بد گفتن و فال بد"
  },
  {
    "poem_id": 1572,
    "vorder": 22,
    "position": 1,
    "text": "بکوبیم مغزش به گوپال بد"
  },
  {
    "poem_id": 1572,
    "vorder": 23,
    "position": 0,
    "text": "بدین گونه آواز پیوسته شد"
  },
  {
    "poem_id": 1572,
    "vorder": 24,
    "position": 1,
    "text": "دل کهرم از پاسبان خسته شد"
  },
  {
    "poem_id": 1572,
    "vorder": 25,
    "position": 0,
    "text": "ز بس نعره از هر سوی زین نشان"
  },
  {
    "poem_id": 1572,
    "vorder": 26,
    "position": 1,
    "text": "پر آواز شد گوش گردنکشان"
  },
  {
    "poem_id": 1572,
    "vorder": 27,
    "position": 0,
    "text": "سپه گفت کآواز بسیار گشت"
  },
  {
    "poem_id": 1572,
    "vorder": 28,
    "position": 1,
    "text": "از اندازهٔ پاسبان برگذشت"
  },
  {
    "poem_id": 1572,
    "vorder": 29,
    "position": 0,
    "text": "کنون دشمن از خانه بیرون کنیم"
  },
  {
    "poem_id": 1572,
    "vorder": 30,
    "position": 1,
    "text": "ازان پس برین چاره افسون کنیم"
  },
  {
    "poem_id": 1572,
    "vorder": 31,
    "position": 0,
    "text": "دل کهرم از پاسبان تنگ شد"
  },
  {
    "poem_id": 1572,
    "vorder": 32,
    "position": 1,
    "text": "بپیچید و رویش پر آژنگ شد"
  },
  {
    "poem_id": 1572,
    "vorder": 33,
    "position": 0,
    "text": "به لشکر چنین گفت کز خواب شاه"
  },
  {
    "poem_id": 1572,
    "vorder": 34,
    "position": 1,
    "text": "دل من پر از رنج شد جان تباه"
  },
  {
    "poem_id": 1572,
    "vorder": 35,
    "position": 0,
    "text": "کنون بی‌گمان باز باید شدن"
  },
  {
    "poem_id": 1572,
    "vorder": 36,
    "position": 1,
    "text": "ندانم کزین پس چه شاید بدن"
  },
  {
    "poem_id": 1572,
    "vorder": 37,
    "position": 0,
    "text": "بزرگان چنین روی برگاشتند"
  },
  {
    "poem_id": 1572,
    "vorder": 38,
    "position": 1,
    "text": "به شب دشت پیکار بگذاشتند"
  },
  {
    "poem_id": 1572,
    "vorder": 39,
    "position": 0,
    "text": "پس اندر همی آمد اسفندیار"
  },
  {
    "poem_id": 1572,
    "vorder": 40,
    "position": 1,
    "text": "زره‌دار با گُرزهٔ گاوسار"
  },
  {
    "poem_id": 1572,
    "vorder": 41,
    "position": 0,
    "text": "چو کهرم بر بارهٔ دژ رسید"
  },
  {
    "poem_id": 1572,
    "vorder": 42,
    "position": 1,
    "text": "پس لشکر ایرانیان را بدید"
  },
  {
    "poem_id": 1572,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت کاکنون به جز رزم کار"
  },
  {
    "poem_id": 1572,
    "vorder": 44,
    "position": 1,
    "text": "چه ماندست با گرد اسفندیار"
  },
  {
    "poem_id": 1572,
    "vorder": 45,
    "position": 0,
    "text": "همه تیغها برکشیم از نیام"
  },
  {
    "poem_id": 1572,
    "vorder": 46,
    "position": 1,
    "text": "به خنجر فرستاد باید پیام"
  },
  {
    "poem_id": 1572,
    "vorder": 47,
    "position": 0,
    "text": "به چهره چو تاب اندر آورد بخت"
  },
  {
    "poem_id": 1572,
    "vorder": 48,
    "position": 1,
    "text": "بران نامداران ببد کار سخت"
  },
  {
    "poem_id": 1572,
    "vorder": 49,
    "position": 0,
    "text": "دو لشکر بران سان برآشوفتند"
  },
  {
    "poem_id": 1572,
    "vorder": 50,
    "position": 1,
    "text": "همی بر سر یکدگر کوفتند"
  },
  {
    "poem_id": 1572,
    "vorder": 51,
    "position": 0,
    "text": "چنین تا برآمد سپیده‌دمان"
  },
  {
    "poem_id": 1572,
    "vorder": 52,
    "position": 1,
    "text": "بزرگان چین را سرآمد زمان"
  },
  {
    "poem_id": 1572,
    "vorder": 53,
    "position": 0,
    "text": "برفتند مردان اسفندیار"
  },
  {
    "poem_id": 1572,
    "vorder": 54,
    "position": 1,
    "text": "بران نامور بارهٔ شهریار"
  },
  {
    "poem_id": 1572,
    "vorder": 55,
    "position": 0,
    "text": "بریده سر شاه ارجاسپ را"
  },
  {
    "poem_id": 1572,
    "vorder": 56,
    "position": 1,
    "text": "جهاندار و خونیز لهراسپ را"
  },
  {
    "poem_id": 1572,
    "vorder": 57,
    "position": 0,
    "text": "به پیش سپاه اندر انداختند"
  },
  {
    "poem_id": 1572,
    "vorder": 58,
    "position": 1,
    "text": "ز پیکار ترکان بپرداختند"
  },
  {
    "poem_id": 1572,
    "vorder": 59,
    "position": 0,
    "text": "خروشی برآمد ز توران سپاه"
  },
  {
    "poem_id": 1572,
    "vorder": 60,
    "position": 1,
    "text": "ز سر برگرفتند گردان کلاه"
  },
  {
    "poem_id": 1572,
    "vorder": 61,
    "position": 0,
    "text": "دو فرزند ارجاسپ گریان شدند"
  },
  {
    "poem_id": 1572,
    "vorder": 62,
    "position": 1,
    "text": "چو بر آتش تیز بریان شدند"
  },
  {
    "poem_id": 1572,
    "vorder": 63,
    "position": 0,
    "text": "بدانست لشکر که آن جنگ چیست"
  },
  {
    "poem_id": 1572,
    "vorder": 64,
    "position": 1,
    "text": "وزان رزم بد بر که باید گریست"
  },
  {
    "poem_id": 1572,
    "vorder": 65,
    "position": 0,
    "text": "بگفتند رادا دلیرا سرا"
  },
  {
    "poem_id": 1572,
    "vorder": 66,
    "position": 1,
    "text": "سپهدار شیراوژنا مهترا"
  },
  {
    "poem_id": 1572,
    "vorder": 67,
    "position": 0,
    "text": "که کشتت که بر دشت کین کشته باد"
  },
  {
    "poem_id": 1572,
    "vorder": 68,
    "position": 1,
    "text": "برو جاودان روز برگشته باد"
  },
  {
    "poem_id": 1572,
    "vorder": 69,
    "position": 0,
    "text": "سپردن کرا باید اکنون بنه"
  },
  {
    "poem_id": 1572,
    "vorder": 70,
    "position": 1,
    "text": "درفش که داریم بر میمنه"
  },
  {
    "poem_id": 1572,
    "vorder": 71,
    "position": 0,
    "text": "چو ارجاسپ پردخته شد قلبگاه"
  },
  {
    "poem_id": 1572,
    "vorder": 72,
    "position": 1,
    "text": "مبادا کلاه و مبادا سپاه"
  },
  {
    "poem_id": 1572,
    "vorder": 73,
    "position": 0,
    "text": "سپه را به مرگ آمد اکنون نیاز"
  },
  {
    "poem_id": 1572,
    "vorder": 74,
    "position": 1,
    "text": "ز خَلُّخ پر از درد شد تا طراز"
  },
  {
    "poem_id": 1572,
    "vorder": 75,
    "position": 0,
    "text": "ازان پس همه پیش مرگ آمدند"
  },
  {
    "poem_id": 1572,
    "vorder": 76,
    "position": 1,
    "text": "زره‌دار با گُرز و ترگ آمدند"
  },
  {
    "poem_id": 1572,
    "vorder": 77,
    "position": 0,
    "text": "ده و دار برخاست از رزمگاه"
  },
  {
    "poem_id": 1572,
    "vorder": 78,
    "position": 1,
    "text": "هوا شد به کردار ابر سیاه"
  },
  {
    "poem_id": 1572,
    "vorder": 79,
    "position": 0,
    "text": "به هر جای بر تودهٔ کشته بود"
  },
  {
    "poem_id": 1572,
    "vorder": 80,
    "position": 1,
    "text": "کسی را کجا روز برگشته بود"
  },
  {
    "poem_id": 1572,
    "vorder": 81,
    "position": 0,
    "text": "همه دشت بی‌تن سر و یال بود"
  },
  {
    "poem_id": 1572,
    "vorder": 82,
    "position": 1,
    "text": "به جای دگر گُرز و گوپال بود"
  },
  {
    "poem_id": 1572,
    "vorder": 83,
    "position": 0,
    "text": "ز خون بر در دژ همی موج خاست"
  },
  {
    "poem_id": 1572,
    "vorder": 84,
    "position": 1,
    "text": "که دانست دست چپ از دست راست"
  },
  {
    "poem_id": 1572,
    "vorder": 85,
    "position": 0,
    "text": "چو اسفندیار اندر آمد ز جای"
  },
  {
    "poem_id": 1572,
    "vorder": 86,
    "position": 1,
    "text": "سپهدار کهرم بیفشارد پای"
  },
  {
    "poem_id": 1572,
    "vorder": 87,
    "position": 0,
    "text": "دو جنگی بران سان برآویختند"
  },
  {
    "poem_id": 1572,
    "vorder": 88,
    "position": 1,
    "text": "که گفتی بهمشان برآمیختند"
  },
  {
    "poem_id": 1572,
    "vorder": 89,
    "position": 0,
    "text": "تهمتن کمربند کهرم گرفت"
  },
  {
    "poem_id": 1572,
    "vorder": 90,
    "position": 1,
    "text": "مر او را ازان پشت زین برگرفت"
  },
  {
    "poem_id": 1572,
    "vorder": 91,
    "position": 0,
    "text": "برآوردش از جای و زد بر زمین"
  },
  {
    "poem_id": 1572,
    "vorder": 92,
    "position": 1,
    "text": "همه لشکرش خواندند آفرین"
  },
  {
    "poem_id": 1572,
    "vorder": 93,
    "position": 0,
    "text": "دو دستش ببستند و بردند خوار"
  },
  {
    "poem_id": 1572,
    "vorder": 94,
    "position": 1,
    "text": "پراگنده شد لشکر نامدار"
  },
  {
    "poem_id": 1572,
    "vorder": 95,
    "position": 0,
    "text": "همی گُرز بارید همچون تگرگ"
  },
  {
    "poem_id": 1572,
    "vorder": 96,
    "position": 1,
    "text": "زمین پر ز ترگ و هوا پر ز مرگ"
  },
  {
    "poem_id": 1572,
    "vorder": 97,
    "position": 0,
    "text": "سر از تیغ پران چو برگ از درخت"
  },
  {
    "poem_id": 1572,
    "vorder": 98,
    "position": 1,
    "text": "یکی ریخت خون و یکی یافت تخت"
  },
  {
    "poem_id": 1572,
    "vorder": 99,
    "position": 0,
    "text": "همی موج زد خون بران رزمگاه"
  },
  {
    "poem_id": 1572,
    "vorder": 100,
    "position": 1,
    "text": "سری زیر نعل و سری با کلاه"
  },
  {
    "poem_id": 1572,
    "vorder": 101,
    "position": 0,
    "text": "نداند کسی آرزوی جهان"
  },
  {
    "poem_id": 1572,
    "vorder": 102,
    "position": 1,
    "text": "نخواهد گشادن بمابر نهان"
  },
  {
    "poem_id": 1572,
    "vorder": 103,
    "position": 0,
    "text": "کسی کش سزاوار بد بارگی"
  },
  {
    "poem_id": 1572,
    "vorder": 104,
    "position": 1,
    "text": "گریزان همی راند یکبارگی"
  },
  {
    "poem_id": 1572,
    "vorder": 105,
    "position": 0,
    "text": "هرانکس که شد در دم اژدها"
  },
  {
    "poem_id": 1572,
    "vorder": 106,
    "position": 1,
    "text": "بکوشید و هم زو نیامد رها"
  },
  {
    "poem_id": 1572,
    "vorder": 107,
    "position": 0,
    "text": "ز ترکان چینی فراوان نماند"
  },
  {
    "poem_id": 1572,
    "vorder": 108,
    "position": 1,
    "text": "وگر ماند کس نام ایشان نخواند"
  },
  {
    "poem_id": 1572,
    "vorder": 109,
    "position": 0,
    "text": "همه ترگ و جوشن فرو ریختند"
  },
  {
    "poem_id": 1572,
    "vorder": 110,
    "position": 1,
    "text": "هم از دیده‌ها خون برآمیختند"
  },
  {
    "poem_id": 1572,
    "vorder": 111,
    "position": 0,
    "text": "دوان پیش اسفندیار آمدند"
  },
  {
    "poem_id": 1572,
    "vorder": 112,
    "position": 1,
    "text": "همه دیده چون جویبار آمدند"
  },
  {
    "poem_id": 1572,
    "vorder": 113,
    "position": 0,
    "text": "سپهدار خونریز و بیداد بود"
  },
  {
    "poem_id": 1572,
    "vorder": 114,
    "position": 1,
    "text": "سپاهش به بیدادگر شاد بود"
  },
  {
    "poem_id": 1572,
    "vorder": 115,
    "position": 0,
    "text": "کسی را نداد از یلان زینهار"
  },
  {
    "poem_id": 1572,
    "vorder": 116,
    "position": 1,
    "text": "بکشتند زان خستگان بی‌شمار"
  },
  {
    "poem_id": 1572,
    "vorder": 117,
    "position": 0,
    "text": "به توران زمین شهریاری نماند"
  },
  {
    "poem_id": 1572,
    "vorder": 118,
    "position": 1,
    "text": "ز ترکان چین نامداری نماند"
  },
  {
    "poem_id": 1572,
    "vorder": 119,
    "position": 0,
    "text": "سراپرده و خیمه برداشتند"
  },
  {
    "poem_id": 1572,
    "vorder": 120,
    "position": 1,
    "text": "بدان خستگان جای بگذاشتند"
  },
  {
    "poem_id": 1572,
    "vorder": 121,
    "position": 0,
    "text": "بران روی دژ بر ستاره بزد"
  },
  {
    "poem_id": 1572,
    "vorder": 122,
    "position": 1,
    "text": "چو پیدا شد از هر دری نیک و بد"
  },
  {
    "poem_id": 1572,
    "vorder": 123,
    "position": 0,
    "text": "بزد بر در دژ دو دار بلند"
  },
  {
    "poem_id": 1572,
    "vorder": 124,
    "position": 1,
    "text": "فرو هشت از دار پیچان کمند"
  },
  {
    "poem_id": 1572,
    "vorder": 125,
    "position": 0,
    "text": "سر اندریمان نگونسار کرد"
  },
  {
    "poem_id": 1572,
    "vorder": 126,
    "position": 1,
    "text": "برادرش را نیز بر دار کرد"
  },
  {
    "poem_id": 1572,
    "vorder": 127,
    "position": 0,
    "text": "سپاهی برون کرد بر هر سوی"
  },
  {
