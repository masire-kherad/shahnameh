[
  {
    "poem_id": 1620,
    "vorder": 1,
    "position": 0,
    "text": "چو بیگاه گازر بیامد ز رود"
  },
  {
    "poem_id": 1620,
    "vorder": 2,
    "position": 1,
    "text": "بدو جفت او گفت هست این درود"
  },
  {
    "poem_id": 1620,
    "vorder": 3,
    "position": 0,
    "text": "که باز آمدی جامه‌ها نیم‌نم"
  },
  {
    "poem_id": 1620,
    "vorder": 4,
    "position": 1,
    "text": "بدین کارکرد از که یابی درم"
  },
  {
    "poem_id": 1620,
    "vorder": 5,
    "position": 0,
    "text": "دل گازر از درد پژمرده بود"
  },
  {
    "poem_id": 1620,
    "vorder": 6,
    "position": 1,
    "text": "یکی کودک زیرکش مرده بود"
  },
  {
    "poem_id": 1620,
    "vorder": 7,
    "position": 0,
    "text": "زن گازر از درد کودک نوان"
  },
  {
    "poem_id": 1620,
    "vorder": 8,
    "position": 1,
    "text": "خلیده رخان تیره گشته روان"
  },
  {
    "poem_id": 1620,
    "vorder": 9,
    "position": 0,
    "text": "بدو گفت گازر که بازآر هوش"
  },
  {
    "poem_id": 1620,
    "vorder": 10,
    "position": 1,
    "text": "ترا زشت باشد ازین پس خروش"
  },
  {
    "poem_id": 1620,
    "vorder": 11,
    "position": 0,
    "text": "کنون گر بماند سخن در نهفت"
  },
  {
    "poem_id": 1620,
    "vorder": 12,
    "position": 1,
    "text": "بگویم به پیش سزاوار جفت"
  },
  {
    "poem_id": 1620,
    "vorder": 13,
    "position": 0,
    "text": "به سنگی که من جامه را برزنم"
  },
  {
    "poem_id": 1620,
    "vorder": 14,
    "position": 1,
    "text": "چو پاکیزه گردد به آب افگنم"
  },
  {
    "poem_id": 1620,
    "vorder": 15,
    "position": 0,
    "text": "دران جوی صندوق دیدم یکی"
  },
  {
    "poem_id": 1620,
    "vorder": 16,
    "position": 1,
    "text": "نهفته بدو اندرون کودکی"
  },
  {
    "poem_id": 1620,
    "vorder": 17,
    "position": 0,
    "text": "چو من برگشادم در بسته باز"
  },
  {
    "poem_id": 1620,
    "vorder": 18,
    "position": 1,
    "text": "به دیدار آن خردم آمد نیاز"
  },
  {
    "poem_id": 1620,
    "vorder": 19,
    "position": 0,
    "text": "اگر بود ما را یکی پور خرد"
  },
  {
    "poem_id": 1620,
    "vorder": 20,
    "position": 1,
    "text": "نبودش بسی زندگانی بمرد"
  },
  {
    "poem_id": 1620,
    "vorder": 21,
    "position": 0,
    "text": "کنون یافتی پور با خواسته"
  },
  {
    "poem_id": 1620,
    "vorder": 22,
    "position": 1,
    "text": "به دینار و دیبا بیاراسته"
  },
  {
    "poem_id": 1620,
    "vorder": 23,
    "position": 0,
    "text": "چو آن جامه‌ها بر زمین بر نهاد"
  },
  {
    "poem_id": 1620,
    "vorder": 24,
    "position": 1,
    "text": "سر تنگ صندوق را برگشاد"
  },
  {
    "poem_id": 1620,
    "vorder": 25,
    "position": 0,
    "text": "زن گازر آن دید خیره بماند"
  },
  {
    "poem_id": 1620,
    "vorder": 26,
    "position": 1,
    "text": "بروبر جهان‌آفرین را بخواند"
  },
  {
    "poem_id": 1620,
    "vorder": 27,
    "position": 0,
    "text": "رخی دید تابان میان حریر"
  },
  {
    "poem_id": 1620,
    "vorder": 28,
    "position": 1,
    "text": "به دیدار مانندهٔ اردشیر"
  },
  {
    "poem_id": 1620,
    "vorder": 29,
    "position": 0,
    "text": "پر از در خوشاب بالین او"
  },
  {
    "poem_id": 1620,
    "vorder": 30,
    "position": 1,
    "text": "عقیق و زبرجد به پایین او"
  },
  {
    "poem_id": 1620,
    "vorder": 31,
    "position": 0,
    "text": "به دست چپش سرخ دینار بود"
  },
  {
    "poem_id": 1620,
    "vorder": 32,
    "position": 1,
    "text": "سوی راست یاقوت شهوار بود"
  },
  {
    "poem_id": 1620,
    "vorder": 33,
    "position": 0,
    "text": "بدو داد زن زود پستان شیر"
  },
  {
    "poem_id": 1620,
    "vorder": 34,
    "position": 1,
    "text": "ببد شاد زان کودک دلپذیر"
  },
  {
    "poem_id": 1620,
    "vorder": 35,
    "position": 0,
    "text": "ز خوبی آن کودک و خواسته"
  },
  {
    "poem_id": 1620,
    "vorder": 36,
    "position": 1,
    "text": "دل او ز غم گشت پیراسته"
  },
  {
    "poem_id": 1620,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت گازر که این را به جان"
  },
  {
    "poem_id": 1620,
    "vorder": 38,
    "position": 1,
    "text": "خریدار باشیم تا جاودان"
  },
  {
    "poem_id": 1620,
    "vorder": 39,
    "position": 0,
    "text": "که این کودک نامداری بود"
  },
  {
    "poem_id": 1620,
    "vorder": 40,
    "position": 1,
    "text": "گر او در جهان شهریاری بود"
  },
  {
    "poem_id": 1620,
    "vorder": 41,
    "position": 0,
    "text": "زن گازر او را چو پیوند خویش"
  },
  {
    "poem_id": 1620,
    "vorder": 42,
    "position": 1,
    "text": "بپرورد چونانک فرزند خویش"
  },
  {
    "poem_id": 1620,
    "vorder": 43,
    "position": 0,
    "text": "سیم روز داراب کردند نام"
  },
  {
    "poem_id": 1620,
    "vorder": 44,
    "position": 1,
    "text": "کز آب روان یافتندش کنام"
  },
  {
    "poem_id": 1620,
    "vorder": 45,
    "position": 0,
    "text": "چنان بد که روزی زن پاک‌رای"
  },
  {
    "poem_id": 1620,
    "vorder": 46,
    "position": 1,
    "text": "سخن گفت هرگونه با کدخدای"
  },
  {
    "poem_id": 1620,
    "vorder": 47,
    "position": 0,
    "text": "که این گوهران را چه سازی کنون"
  },
  {
    "poem_id": 1620,
    "vorder": 48,
    "position": 1,
    "text": "که باشد بدین دانشت رهنمون"
  },
  {
    "poem_id": 1620,
    "vorder": 49,
    "position": 0,
    "text": "به زن گفت گازر که ای نیک جفت"
  },
  {
    "poem_id": 1620,
    "vorder": 50,
    "position": 1,
    "text": "چه خاک و چه گوهرمرا در نهفت"
  },
  {
    "poem_id": 1620,
    "vorder": 51,
    "position": 0,
    "text": "همان به کزین شهر بیرون شویم"
  },
  {
    "poem_id": 1620,
    "vorder": 52,
    "position": 1,
    "text": "ز تنگی و سختی به هامون شویم"
  },
  {
    "poem_id": 1620,
    "vorder": 53,
    "position": 0,
    "text": "به شهری که ما را ندانند کس"
  },
  {
    "poem_id": 1620,
    "vorder": 54,
    "position": 1,
    "text": "که خواریم و ناشادگر دست رس"
  },
  {
    "poem_id": 1620,
    "vorder": 55,
    "position": 0,
    "text": "به شبگیر گازر بنه برنهاد"
  },
  {
    "poem_id": 1620,
    "vorder": 56,
    "position": 1,
    "text": "برفت و نکرد از بر و بوم یاد"
  },
  {
    "poem_id": 1620,
    "vorder": 57,
    "position": 0,
    "text": "ببردند داراب را در کنار"
  },
  {
    "poem_id": 1620,
    "vorder": 58,
    "position": 1,
    "text": "نکردند جز گوهر و زر به بار"
  },
  {
    "poem_id": 1620,
    "vorder": 59,
    "position": 0,
    "text": "بپیمود زان مرز فرسنگ شست"
  },
  {
    "poem_id": 1620,
    "vorder": 60,
    "position": 1,
    "text": "به شهری دگر ساخت جای نشست"
  },
  {
    "poem_id": 1620,
    "vorder": 61,
    "position": 0,
    "text": "به بیگانه شهر اندرون ساخت جای"
  },
  {
    "poem_id": 1620,
    "vorder": 62,
    "position": 1,
    "text": "بران سان که پرمایه‌تر کدخدای"
  },
  {
    "poem_id": 1620,
    "vorder": 63,
    "position": 0,
    "text": "به شهری که بد نامور مهتری"
  },
  {
    "poem_id": 1620,
    "vorder": 64,
    "position": 1,
    "text": "فرستاد نزدیک او گوهری"
  },
  {
    "poem_id": 1620,
    "vorder": 65,
    "position": 0,
    "text": "ازو بستدی جامه و سیم و زر"
  },
  {
    "poem_id": 1620,
    "vorder": 66,
    "position": 1,
    "text": "چنین تا فراوان نماند از گهر"
  },
  {
    "poem_id": 1620,
    "vorder": 67,
    "position": 0,
    "text": "به خانه جز از سرخ گوگرد نیز"
  },
  {
    "poem_id": 1620,
    "vorder": 68,
    "position": 1,
    "text": "نماند از بد و نیک صندوق چیز"
  },
  {
    "poem_id": 1620,
    "vorder": 69,
    "position": 0,
    "text": "زن گازر از چیز شد رهنمای"
  },
  {
    "poem_id": 1620,
    "vorder": 70,
    "position": 1,
    "text": "چنین گفت یک روز با کدخدای"
  },
  {
    "poem_id": 1620,
    "vorder": 71,
    "position": 0,
    "text": "که ما بی‌نیازیم زین کارکرد"
  },
  {
    "poem_id": 1620,
    "vorder": 72,
    "position": 1,
    "text": "توانگر شدی گرد پیشه مگرد"
  },
  {
    "poem_id": 1620,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد پاسخ بدو کدخدای"
  },
  {
    "poem_id": 1620,
    "vorder": 74,
    "position": 1,
    "text": "که ای جفت پاکیزه و رهنمای"
  },
  {
    "poem_id": 1620,
    "vorder": 75,
    "position": 0,
    "text": "همی پیشه خوانی ز پیشه چه بیش"
  },
  {
    "poem_id": 1620,
    "vorder": 76,
    "position": 1,
    "text": "همیشه ز هر کار پیشه است پیش"
  },
  {
    "poem_id": 1620,
    "vorder": 77,
    "position": 0,
    "text": "تو داراب را پاک و نیکو بدار"
  },
  {
    "poem_id": 1620,
    "vorder": 78,
    "position": 1,
    "text": "بدان تا چه بار آورد روزگار"
  },
  {
    "poem_id": 1620,
    "vorder": 79,
    "position": 0,
    "text": "همی داشتندش چنان ارجمند"
  },
  {
    "poem_id": 1620,
    "vorder": 80,
    "position": 1,
    "text": "که از تند بادی ندیدی گزند"
  },
  {
    "poem_id": 1620,
    "vorder": 81,
    "position": 0,
    "text": "چو برگشت چرخ از برش چند سال"
  },
  {
    "poem_id": 1620,
    "vorder": 82,
    "position": 1,
    "text": "یکی کودکی گشت با فر و یال"
  },
  {
    "poem_id": 1620,
    "vorder": 83,
    "position": 0,
    "text": "به کشتی شدی با بزرگان به کوی"
  },
  {
    "poem_id": 1620,
    "vorder": 84,
    "position": 1,
    "text": "کسی را نبودی تن و زور اوی"
  },
  {
    "poem_id": 1620,
    "vorder": 85,
    "position": 0,
    "text": "همه کودکان همگروه آمدند"
  },
  {
    "poem_id": 1620,
    "vorder": 86,
    "position": 1,
    "text": "به یکبارگی زو ستوه آمدند"
  },
  {
    "poem_id": 1620,
    "vorder": 87,
    "position": 0,
    "text": "به فریاد شد گازر از کار او"
  },
  {
    "poem_id": 1620,
    "vorder": 88,
    "position": 1,
    "text": "همی تیره شد تیز بازار او"
  },
  {
    "poem_id": 1620,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت کاین جامه برزن به سنگ"
  },
  {
    "poem_id": 1620,
    "vorder": 90,
    "position": 1,
    "text": "که از پیشه جستن ترا نیست ننگ"
  },
  {
    "poem_id": 1620,
    "vorder": 91,
    "position": 0,
    "text": "چو داراب زان پیشه بگریختی"
  },
  {
    "poem_id": 1620,
    "vorder": 92,
    "position": 1,
    "text": "همی گازر از دیده خون ریختی"
  },
  {
    "poem_id": 1620,
    "vorder": 93,
    "position": 0,
    "text": "شدی روزگارش به جستن دو بهر"
  },
  {
    "poem_id": 1620,
    "vorder": 94,
    "position": 1,
    "text": "نشان خواستی زو به دشت و به شهر"
  },
  {
    "poem_id": 1620,
    "vorder": 95,
    "position": 0,
    "text": "به جاییش دیدی کمانی به دست"
  },
  {
    "poem_id": 1620,
    "vorder": 96,
    "position": 1,
    "text": "به آیین گشاده بر و بسته شست"
  },
  {
    "poem_id": 1620,
    "vorder": 97,
    "position": 0,
    "text": "کمان بستدی سرد گفتی بدوی"
  },
  {
    "poem_id": 1620,
    "vorder": 98,
    "position": 1,
    "text": "که ای پرزیان گرگ پرخاشجوی"
  },
  {
    "poem_id": 1620,
    "vorder": 99,
    "position": 0,
    "text": "چه گردی همی گرد تیر و کمان"
  },
  {
    "poem_id": 1620,
    "vorder": 100,
    "position": 1,
    "text": "به خردی چرا گشته‌ای بدگمان"
  },
  {
    "poem_id": 1620,
    "vorder": 101,
    "position": 0,
    "text": "به گازر چنین گفت کای باب من"
  },
  {
    "poem_id": 1620,
    "vorder": 102,
    "position": 1,
    "text": "چرا تیره گردانی این آب من"
  },
  {
    "poem_id": 1620,
    "vorder": 103,
    "position": 0,
    "text": "به فرهنگیان ده مرا از نخست"
  },
  {
    "poem_id": 1620,
    "vorder": 104,
    "position": 1,
    "text": "چو آموختم زند و استا درست"
  },
  {
    "poem_id": 1620,
    "vorder": 105,
    "position": 0,
    "text": "ازان پس مرا پیشه فرمان و جوی"
  },
  {
    "poem_id": 1620,
    "vorder": 106,
    "position": 1,
    "text": "کنون از من این کدخدایی مجوی"
  },
  {
    "poem_id": 1620,
    "vorder": 107,
    "position": 0,
    "text": "بدو مرد گازر بسی برشمرد"
  },
  {
    "poem_id": 1620,
    "vorder": 108,
    "position": 1,
    "text": "ازان پس به فرهنگیانش سپرد"
  },
  {
    "poem_id": 1620,
    "vorder": 109,
    "position": 0,
    "text": "بیاموخت فرهنگ و شد برمنش"
  },
  {
    "poem_id": 1620,
    "vorder": 110,
    "position": 1,
    "text": "برآمد ز پیغاره و سرزنش"
  },
  {
    "poem_id": 1620,
    "vorder": 111,
    "position": 0,
    "text": "بدان پروراننده گفت ای پدر"
  },
  {
    "poem_id": 1620,
    "vorder": 112,
    "position": 1,
    "text": "نیاید ز من گازری کارگر"
  },
  {
    "poem_id": 1620,
    "vorder": 113,
    "position": 0,
    "text": "ز من جای مهرت بی‌اندیشه کن"
  },
  {
    "poem_id": 1620,
    "vorder": 114,
    "position": 1,
    "text": "ز گیتی سواری مرا پیشه کن"
  },
  {
    "poem_id": 1620,
    "vorder": 115,
    "position": 0,
    "text": "نگه کرد گازر سواری تمام"
  },
  {
    "poem_id": 1620,
    "vorder": 116,
    "position": 1,
    "text": "عنان پیچ و اسپ افگن و نیک‌نام"
  },
  {
    "poem_id": 1620,
    "vorder": 117,
    "position": 0,
    "text": "سپردش بدو روزگاری دراز"
  },
  {
    "poem_id": 1620,
    "vorder": 118,
    "position": 1,
    "text": "بیاموخت هرچش بدان بد نیاز"
  },
  {
    "poem_id": 1620,
    "vorder": 119,
    "position": 0,
    "text": "عنان و سنان و سپر داشتن"
  },
  {
    "poem_id": 1620,
    "vorder": 120,
    "position": 1,
    "text": "به آوردگه باره برگاشتن"
  },
  {
    "poem_id": 1620,
    "vorder": 121,
    "position": 0,
    "text": "همان زخم چوگان و تیر و کمان"
  },
  {
    "poem_id": 1620,
    "vorder": 122,
    "position": 1,
    "text": "هنرجوی دور از بد بدگمان"
  },
  {
    "poem_id": 1620,
    "vorder": 123,
    "position": 0,
    "text": "بران گونه شد زین هنرها که چنگ"
  },
  {
    "poem_id": 1620,
    "vorder": 124,
    "position": 1,
    "text": "نسودی به آورد با او پلنگ"
  }
]