[
  {
    "poem_id": 1347,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که هر شب دو مرد جوان"
  },
  {
    "poem_id": 1347,
    "vorder": 2,
    "position": 1,
    "text": "چه کهتر چه از تخمهٔ پهلوان"
  },
  {
    "poem_id": 1347,
    "vorder": 3,
    "position": 0,
    "text": "خورشگر ببردی به ایوان شاه"
  },
  {
    "poem_id": 1347,
    "vorder": 4,
    "position": 1,
    "text": "همی ساختی راه درمان شاه"
  },
  {
    "poem_id": 1347,
    "vorder": 5,
    "position": 0,
    "text": "بکشتی و مغزش بپرداختی"
  },
  {
    "poem_id": 1347,
    "vorder": 6,
    "position": 1,
    "text": "مر آن اژدها را خورش ساختی"
  },
  {
    "poem_id": 1347,
    "vorder": 7,
    "position": 0,
    "text": "دو پاکیزه از گوهر پادشا"
  },
  {
    "poem_id": 1347,
    "vorder": 8,
    "position": 1,
    "text": "دو مرد گرانمایه و پارسا"
  },
  {
    "poem_id": 1347,
    "vorder": 9,
    "position": 0,
    "text": "یکی نام ارمایل پاک‌دین"
  },
  {
    "poem_id": 1347,
    "vorder": 10,
    "position": 1,
    "text": "دگر نام گرمایل پیشبین"
  },
  {
    "poem_id": 1347,
    "vorder": 11,
    "position": 0,
    "text": "چنان بد که بودند روزی به هم"
  },
  {
    "poem_id": 1347,
    "vorder": 12,
    "position": 1,
    "text": "سخن رفت هر گونه از بیش و کم"
  },
  {
    "poem_id": 1347,
    "vorder": 13,
    "position": 0,
    "text": "ز بیدادگر شاه وز لشکرش"
  },
  {
    "poem_id": 1347,
    "vorder": 14,
    "position": 1,
    "text": "و زان رسم‌های بد اندر خورش"
  },
  {
    "poem_id": 1347,
    "vorder": 15,
    "position": 0,
    "text": "یکی گفت ما را به خوالیگری"
  },
  {
    "poem_id": 1347,
    "vorder": 16,
    "position": 1,
    "text": "بباید بر شاه رفت آوری"
  },
  {
    "poem_id": 1347,
    "vorder": 17,
    "position": 0,
    "text": "و زان پس یکی چاره‌ای ساختن"
  },
  {
    "poem_id": 1347,
    "vorder": 18,
    "position": 1,
    "text": "ز هر گونه اندیشه انداختن"
  },
  {
    "poem_id": 1347,
    "vorder": 19,
    "position": 0,
    "text": "مگر زین دو تن را که ریزند خون"
  },
  {
    "poem_id": 1347,
    "vorder": 20,
    "position": 1,
    "text": "یکی را توان آوریدن برون"
  },
  {
    "poem_id": 1347,
    "vorder": 21,
    "position": 0,
    "text": "برفتند و خوالیگری ساختند"
  },
  {
    "poem_id": 1347,
    "vorder": 22,
    "position": 1,
    "text": "خورش‌ها و اندازه بشناختند"
  },
  {
    "poem_id": 1347,
    "vorder": 23,
    "position": 0,
    "text": "خورش خانهٔ پادشاه جهان"
  },
  {
    "poem_id": 1347,
    "vorder": 24,
    "position": 1,
    "text": "گرفت آن دو بیدار دل در نهان"
  },
  {
    "poem_id": 1347,
    "vorder": 25,
    "position": 0,
    "text": "چو آمد به هنگام خون ریختن"
  },
  {
    "poem_id": 1347,
    "vorder": 26,
    "position": 1,
    "text": "به شیرین روان اندر آویختن"
  },
  {
    "poem_id": 1347,
    "vorder": 27,
    "position": 0,
    "text": "از آن روزبانان مردم‌کُشان"
  },
  {
    "poem_id": 1347,
    "vorder": 28,
    "position": 1,
    "text": "گرفته دو مرد جوان را کشان"
  },
  {
    "poem_id": 1347,
    "vorder": 29,
    "position": 0,
    "text": "زنان پیش خوالیگران تاختند"
  },
  {
    "poem_id": 1347,
    "vorder": 30,
    "position": 1,
    "text": "ز بالا به روی اندر انداختند"
  },
  {
    "poem_id": 1347,
    "vorder": 31,
    "position": 0,
    "text": "پر از درد خوالیگران را جگر"
  },
  {
    "poem_id": 1347,
    "vorder": 32,
    "position": 1,
    "text": "پر از خون دو دیده پر از کینه سر"
  },
  {
    "poem_id": 1347,
    "vorder": 33,
    "position": 0,
    "text": "همی بنگرید این بدان آن بدین"
  },
  {
    "poem_id": 1347,
    "vorder": 34,
    "position": 1,
    "text": "ز کردار بیداد شاه زمین"
  },
  {
    "poem_id": 1347,
    "vorder": 35,
    "position": 0,
    "text": "از آن دو یکی را بپرداختند"
  },
  {
    "poem_id": 1347,
    "vorder": 36,
    "position": 1,
    "text": "جز این چاره‌ای نیز نشناختند"
  },
  {
    "poem_id": 1347,
    "vorder": 37,
    "position": 0,
    "text": "برون کرد مغز سر گوسفند"
  },
  {
    "poem_id": 1347,
    "vorder": 38,
    "position": 1,
    "text": "بیامیخت با مغز آن ارجمند"
  },
  {
    "poem_id": 1347,
    "vorder": 39,
    "position": 0,
    "text": "یکی را به جان داد زنهار و گفت"
  },
  {
    "poem_id": 1347,
    "vorder": 40,
    "position": 1,
    "text": "نگر تا بیاری سر اندر نهفت"
  },
  {
    "poem_id": 1347,
    "vorder": 41,
    "position": 0,
    "text": "نگر تا نباشی به آباد شهر"
  },
  {
    "poem_id": 1347,
    "vorder": 42,
    "position": 1,
    "text": "تو را از جهان دشت و کوه است بهر"
  },
  {
    "poem_id": 1347,
    "vorder": 43,
    "position": 0,
    "text": "به جای سرش زان سری بی‌بها"
  },
  {
    "poem_id": 1347,
    "vorder": 44,
    "position": 1,
    "text": "خورش ساختند از پی اژدها"
  },
  {
    "poem_id": 1347,
    "vorder": 45,
    "position": 0,
    "text": "از این گونه هر ماهیان سی جوان"
  },
  {
    "poem_id": 1347,
    "vorder": 46,
    "position": 1,
    "text": "از ایشان همی یافتندی روان"
  },
  {
    "poem_id": 1347,
    "vorder": 47,
    "position": 0,
    "text": "چو گرد آمدی مرد از ایشان دویست"
  },
  {
    "poem_id": 1347,
    "vorder": 48,
    "position": 1,
    "text": "بر آن سان که نشناختندی که کیست"
  },
  {
    "poem_id": 1347,
    "vorder": 49,
    "position": 0,
    "text": "خورشگر بدیشان بزی چند و میش"
  },
  {
    "poem_id": 1347,
    "vorder": 50,
    "position": 1,
    "text": "سپردی و صحرا نهادند پیش"
  },
  {
    "poem_id": 1347,
    "vorder": 51,
    "position": 0,
    "text": "کنون کُرد از آن تخمه دارد نژاد"
  },
  {
    "poem_id": 1347,
    "vorder": 52,
    "position": 1,
    "text": "که ز آباد ناید به دل برش یاد"
  },
  {
    "poem_id": 1347,
    "vorder": 53,
    "position": 0,
    "text": "پس آیین ضحاک وارونه‌خوی"
  },
  {
    "poem_id": 1347,
    "vorder": 54,
    "position": 1,
    "text": "چنان بد که چون می‌بدش آرزوی"
  },
  {
    "poem_id": 1347,
    "vorder": 55,
    "position": 0,
    "text": "ز مردان جنگی یکی خواستی"
  },
  {
    "poem_id": 1347,
    "vorder": 56,
    "position": 1,
    "text": "بکشتی چو با دیو برخاستی"
  },
  {
    "poem_id": 1347,
    "vorder": 57,
    "position": 0,
    "text": "کجا نامور دختری خوبروی"
  },
  {
    "poem_id": 1347,
    "vorder": 58,
    "position": 1,
    "text": "به پرده درون بود بی‌گفت‌گوی"
  },
  {
    "poem_id": 1347,
    "vorder": 59,
    "position": 0,
    "text": "پرستنده کردیش بر پیش خویش"
  },
  {
    "poem_id": 1347,
    "vorder": 60,
    "position": 1,
    "text": "نه بر رسم دین و نه بر رسم کیش"
  }
]