[
  {
    "poem_id": 1686,
    "vorder": 1,
    "position": 0,
    "text": "الا ای برآورده چرخ بلند"
  },
  {
    "poem_id": 1686,
    "vorder": 2,
    "position": 1,
    "text": "چه داری به پیری مرا مستمند"
  },
  {
    "poem_id": 1686,
    "vorder": 3,
    "position": 0,
    "text": "چو بودم جوان در برم داشتی"
  },
  {
    "poem_id": 1686,
    "vorder": 4,
    "position": 1,
    "text": "به پیری چرا خوار بگذاشتی"
  },
  {
    "poem_id": 1686,
    "vorder": 5,
    "position": 0,
    "text": "همی زرد گردد گل کامگار"
  },
  {
    "poem_id": 1686,
    "vorder": 6,
    "position": 1,
    "text": "همی پرنیان گردد از رنج خار"
  },
  {
    "poem_id": 1686,
    "vorder": 7,
    "position": 0,
    "text": "دو تا گشت آن سرو نازان به باغ"
  },
  {
    "poem_id": 1686,
    "vorder": 8,
    "position": 1,
    "text": "همان تیره گشت آن گرامی چراغ"
  },
  {
    "poem_id": 1686,
    "vorder": 9,
    "position": 0,
    "text": "پر از برف شد کوهسار سیاه"
  },
  {
    "poem_id": 1686,
    "vorder": 10,
    "position": 1,
    "text": "همی لشکر از شاه بیند گناه"
  },
  {
    "poem_id": 1686,
    "vorder": 11,
    "position": 0,
    "text": "به کردار مادر بدی تاکنون"
  },
  {
    "poem_id": 1686,
    "vorder": 12,
    "position": 1,
    "text": "همی ریخت باید ز رنج تو خون"
  },
  {
    "poem_id": 1686,
    "vorder": 13,
    "position": 0,
    "text": "وفا و خرد نیست نزدیک تو"
  },
  {
    "poem_id": 1686,
    "vorder": 14,
    "position": 1,
    "text": "پر از رنجم از رای تاریک تو"
  },
  {
    "poem_id": 1686,
    "vorder": 15,
    "position": 0,
    "text": "مرا کاچ هرگز نپروردییی"
  },
  {
    "poem_id": 1686,
    "vorder": 16,
    "position": 1,
    "text": "چو پرورده بودی نیازردییی"
  },
  {
    "poem_id": 1686,
    "vorder": 17,
    "position": 0,
    "text": "هرانگه که زین تیرگی بگذرم"
  },
  {
    "poem_id": 1686,
    "vorder": 18,
    "position": 1,
    "text": "بگویم جفای تو با داورم"
  },
  {
    "poem_id": 1686,
    "vorder": 19,
    "position": 0,
    "text": "بنالم ز تو پیش یزدان پاک"
  },
  {
    "poem_id": 1686,
    "vorder": 20,
    "position": 1,
    "text": "خروشان به سربر پراگنده خاک"
  },
  {
    "poem_id": 1686,
    "vorder": 21,
    "position": 0,
    "text": "چنین داد پاسخ سپهر بلند"
  },
  {
    "poem_id": 1686,
    "vorder": 22,
    "position": 1,
    "text": "که ای مرد گویندهٔ بی‌گزند"
  },
  {
    "poem_id": 1686,
    "vorder": 23,
    "position": 0,
    "text": "چرا بینی از من همی نیک و بد"
  },
  {
    "poem_id": 1686,
    "vorder": 24,
    "position": 1,
    "text": "چنین ناله از دانشی کی سزد"
  },
  {
    "poem_id": 1686,
    "vorder": 25,
    "position": 0,
    "text": "تو از من به هر باره‌ای برتری"
  },
  {
    "poem_id": 1686,
    "vorder": 26,
    "position": 1,
    "text": "روان را به دانش همی پروری"
  },
  {
    "poem_id": 1686,
    "vorder": 27,
    "position": 0,
    "text": "بدین هرچ گفتی مرا راه نیست"
  },
  {
    "poem_id": 1686,
    "vorder": 28,
    "position": 1,
    "text": "خور و ماه زین دانش آگاه نیست"
  },
  {
    "poem_id": 1686,
    "vorder": 29,
    "position": 0,
    "text": "خور و خواب و رای و نشست ترا"
  },
  {
    "poem_id": 1686,
    "vorder": 30,
    "position": 1,
    "text": "به نیک و به بد راه و دست ترا"
  },
  {
    "poem_id": 1686,
    "vorder": 31,
    "position": 0,
    "text": "ازان خواه راهت که راه آفرید"
  },
  {
    "poem_id": 1686,
    "vorder": 32,
    "position": 1,
    "text": "شب و روز و خورشید و ماه آفرید"
  },
  {
    "poem_id": 1686,
    "vorder": 33,
    "position": 0,
    "text": "یکی آنک هستیش را راز نیست"
  },
  {
    "poem_id": 1686,
    "vorder": 34,
    "position": 1,
    "text": "به کاریش فرجام و آغاز نیست"
  },
  {
    "poem_id": 1686,
    "vorder": 35,
    "position": 0,
    "text": "چو گوید بباش آنچ خواهد بُدست"
  },
  {
    "poem_id": 1686,
    "vorder": 36,
    "position": 1,
    "text": "کسی کو جزین داند آن بیهده‌ست"
  },
  {
    "poem_id": 1686,
    "vorder": 37,
    "position": 0,
    "text": "من از داد چون تو یکی بنده‌ام"
  },
  {
    "poem_id": 1686,
    "vorder": 38,
    "position": 1,
    "text": "پرستندهٔ آفریننده‌ام"
  },
  {
    "poem_id": 1686,
    "vorder": 39,
    "position": 0,
    "text": "نگردم همی جز به فرمان اوی"
  },
  {
    "poem_id": 1686,
    "vorder": 40,
    "position": 1,
    "text": "نیارم گذشتن ز پیمان اوی"
  },
  {
    "poem_id": 1686,
    "vorder": 41,
    "position": 0,
    "text": "به یزدان گرای و به یزدان پناه"
  },
  {
    "poem_id": 1686,
    "vorder": 42,
    "position": 1,
    "text": "براندازه زو هرچ باید بخواه"
  },
  {
    "poem_id": 1686,
    "vorder": 43,
    "position": 0,
    "text": "جز او را مخوان کردگار سپهر"
  },
  {
    "poem_id": 1686,
    "vorder": 44,
    "position": 1,
    "text": "فروزندهٔ ماه و ناهید و مهر"
  },
  {
    "poem_id": 1686,
    "vorder": 45,
    "position": 0,
    "text": "وزو بر روان محمد درود"
  },
  {
    "poem_id": 1686,
    "vorder": 46,
    "position": 1,
    "text": "بیارانش بر هر یکی برفزود"
  }
]