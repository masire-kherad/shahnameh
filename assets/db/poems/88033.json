[
  {
    "poem_id": 88033,
    "vorder": 1,
    "position": 0,
    "text": "دو بهره چو از تیره شب درگذشت"
  },
  {
    "poem_id": 88033,
    "vorder": 2,
    "position": 1,
    "text": "ز جوش سواران بجوشید دشت"
  },
  {
    "poem_id": 88033,
    "vorder": 3,
    "position": 0,
    "text": "گرفتند ترکان همه تاختن"
  },
  {
    "poem_id": 88033,
    "vorder": 4,
    "position": 1,
    "text": "بدان تاختن گردن افراختن"
  },
  {
    "poem_id": 88033,
    "vorder": 5,
    "position": 0,
    "text": "چو نستیهن آن لشکر کینه‌خواه"
  },
  {
    "poem_id": 88033,
    "vorder": 6,
    "position": 1,
    "text": "بیاورد نزدیک ایران سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 7,
    "position": 0,
    "text": "سپیده‌دمان تا بدانجا رسید"
  },
  {
    "poem_id": 88033,
    "vorder": 8,
    "position": 1,
    "text": "چو از دیده گه دیده‌بانش بدید"
  },
  {
    "poem_id": 88033,
    "vorder": 9,
    "position": 0,
    "text": "چو کارآگهان آگهی یافتند"
  },
  {
    "poem_id": 88033,
    "vorder": 10,
    "position": 1,
    "text": "سبک سوی گودرز بشتافتند"
  },
  {
    "poem_id": 88033,
    "vorder": 11,
    "position": 0,
    "text": "که آمد سپاهی چو کوه روان"
  },
  {
    "poem_id": 88033,
    "vorder": 12,
    "position": 1,
    "text": "که گویی ندارند گویا زبان"
  },
  {
    "poem_id": 88033,
    "vorder": 13,
    "position": 0,
    "text": "بر آن سان که رسم شبیخون بود"
  },
  {
    "poem_id": 88033,
    "vorder": 14,
    "position": 1,
    "text": "سپهدار داند که آن چون بود"
  },
  {
    "poem_id": 88033,
    "vorder": 15,
    "position": 0,
    "text": "به لشکر بفرمود پس پهلوان"
  },
  {
    "poem_id": 88033,
    "vorder": 16,
    "position": 1,
    "text": "که بیدار باشید و روشن‌روان"
  },
  {
    "poem_id": 88033,
    "vorder": 17,
    "position": 0,
    "text": "بخواند آن زمان بیژن گیو را"
  },
  {
    "poem_id": 88033,
    "vorder": 18,
    "position": 1,
    "text": "ابا تیغ‌زن لشکر نیو را"
  },
  {
    "poem_id": 88033,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت نیک اختر و کام تو"
  },
  {
    "poem_id": 88033,
    "vorder": 20,
    "position": 1,
    "text": "شکسته دل دشمن از نام تو"
  },
  {
    "poem_id": 88033,
    "vorder": 21,
    "position": 0,
    "text": "ببر هرک باید ز گردان من"
  },
  {
    "poem_id": 88033,
    "vorder": 22,
    "position": 1,
    "text": "از این نامداران و مردان من"
  },
  {
    "poem_id": 88033,
    "vorder": 23,
    "position": 0,
    "text": "پذیره شو این تاختن را چو شیر"
  },
  {
    "poem_id": 88033,
    "vorder": 24,
    "position": 1,
    "text": "سپاه اندر آورد به مردی به زیر"
  },
  {
    "poem_id": 88033,
    "vorder": 25,
    "position": 0,
    "text": "گزین کرد بیژن ز لشکر سوار"
  },
  {
    "poem_id": 88033,
    "vorder": 26,
    "position": 1,
    "text": "دلیران و پرخاشجویان هزار"
  },
  {
    "poem_id": 88033,
    "vorder": 27,
    "position": 0,
    "text": "رسیدند پس یک به دیگر فراز"
  },
  {
    "poem_id": 88033,
    "vorder": 28,
    "position": 1,
    "text": "دو لشکر پر از کینه و رزمساز"
  },
  {
    "poem_id": 88033,
    "vorder": 29,
    "position": 0,
    "text": "همه گُرزها برکشیدند پاک"
  },
  {
    "poem_id": 88033,
    "vorder": 30,
    "position": 1,
    "text": "یکی ابر بست از بر تیره خاک"
  },
  {
    "poem_id": 88033,
    "vorder": 31,
    "position": 0,
    "text": "فرود آمد از کوه ابر سیاه"
  },
  {
    "poem_id": 88033,
    "vorder": 32,
    "position": 1,
    "text": "بپوشید دیدار توران سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 33,
    "position": 0,
    "text": "سپهدار چون گرد تیره بدید"
  },
  {
    "poem_id": 88033,
    "vorder": 34,
    "position": 1,
    "text": "کزو لشکر ترک شد ناپدید"
  },
  {
    "poem_id": 88033,
    "vorder": 35,
    "position": 0,
    "text": "کمانها بفرمود کردن به زه"
  },
  {
    "poem_id": 88033,
    "vorder": 36,
    "position": 1,
    "text": "برآمد خروش از مهان و ز که"
  },
  {
    "poem_id": 88033,
    "vorder": 37,
    "position": 0,
    "text": "چو بیژن به نستیهن اندر رسید"
  },
  {
    "poem_id": 88033,
    "vorder": 38,
    "position": 1,
    "text": "درفش سر ویسگان را بدید"
  },
  {
    "poem_id": 88033,
    "vorder": 39,
    "position": 0,
    "text": "هوا سر به سر گشته زنگارگون"
  },
  {
    "poem_id": 88033,
    "vorder": 40,
    "position": 1,
    "text": "زمین شد به کردار دریای خون"
  },
  {
    "poem_id": 88033,
    "vorder": 41,
    "position": 0,
    "text": "ز ترکان دو بهره فتاده نگون"
  },
  {
    "poem_id": 88033,
    "vorder": 42,
    "position": 1,
    "text": "به زیر پی اسب غرقه به خون"
  },
  {
    "poem_id": 88033,
    "vorder": 43,
    "position": 0,
    "text": "یکی تیر بر اسب نستیهنا"
  },
  {
    "poem_id": 88033,
    "vorder": 44,
    "position": 1,
    "text": "رسید از گشاد و بر بیژنا"
  },
  {
    "poem_id": 88033,
    "vorder": 45,
    "position": 0,
    "text": "ز درد اندر آمد تگاور به روی"
  },
  {
    "poem_id": 88033,
    "vorder": 46,
    "position": 1,
    "text": "رسید اندر او بیژن جنگجوی"
  },
  {
    "poem_id": 88033,
    "vorder": 47,
    "position": 0,
    "text": "عمودی بزد بر سر ترگ‌دار"
  },
  {
    "poem_id": 88033,
    "vorder": 48,
    "position": 1,
    "text": "تهی ماند از او مغز و برگشت کار"
  },
  {
    "poem_id": 88033,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت بیژن به ایرانیان"
  },
  {
    "poem_id": 88033,
    "vorder": 50,
    "position": 1,
    "text": "که هر کو ببندد کمر بر میان"
  },
  {
    "poem_id": 88033,
    "vorder": 51,
    "position": 0,
    "text": "بجز گُرز و شمشیر گیرد به دست"
  },
  {
    "poem_id": 88033,
    "vorder": 52,
    "position": 1,
    "text": "کمان بر سرش بر کنم پاک پست"
  },
  {
    "poem_id": 88033,
    "vorder": 53,
    "position": 0,
    "text": "که ترکان به دیدن پری چهره‌اند"
  },
  {
    "poem_id": 88033,
    "vorder": 54,
    "position": 1,
    "text": "به جنگ از هنر پاک بی‌بهره‌اند"
  },
  {
    "poem_id": 88033,
    "vorder": 55,
    "position": 0,
    "text": "دلیری گرفتند کنداوران"
  },
  {
    "poem_id": 88033,
    "vorder": 56,
    "position": 1,
    "text": "کشیدند لشکر پرندآوران"
  },
  {
    "poem_id": 88033,
    "vorder": 57,
    "position": 0,
    "text": "چو پیلان همه دشت بر یکدگر"
  },
  {
    "poem_id": 88033,
    "vorder": 58,
    "position": 1,
    "text": "فگنده ز تنها جدا مانده سر"
  },
  {
    "poem_id": 88033,
    "vorder": 59,
    "position": 0,
    "text": "از آن رزمگه تا به توران سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 60,
    "position": 1,
    "text": "دمان از پس اندر گرفتند راه"
  },
  {
    "poem_id": 88033,
    "vorder": 61,
    "position": 0,
    "text": "چو پیران ندید آن زمان با سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 62,
    "position": 1,
    "text": "برادر بدو گشت گیتی سیاه"
  },
  {
    "poem_id": 88033,
    "vorder": 63,
    "position": 0,
    "text": "به کارآگهان گفت ز این رزمگاه"
  },
  {
    "poem_id": 88033,
    "vorder": 64,
    "position": 1,
    "text": "هیونی بتازد به آوردگاه"
  },
  {
    "poem_id": 88033,
    "vorder": 65,
    "position": 0,
    "text": "که آرد نشانی ز نستیهنم"
  },
  {
    "poem_id": 88033,
    "vorder": 66,
    "position": 1,
    "text": "وگرنه دو دیده ز سر برکنم"
  },
  {
    "poem_id": 88033,
    "vorder": 67,
    "position": 0,
    "text": "هیونی برون تاختند آن زمان"
  },
  {
    "poem_id": 88033,
    "vorder": 68,
    "position": 1,
    "text": "برفت و بدید و بیامد دمان"
  },
  {
    "poem_id": 88033,
    "vorder": 69,
    "position": 0,
    "text": "که نستیهن آنک بدان رزمگاه"
  },
  {
    "poem_id": 88033,
    "vorder": 70,
    "position": 1,
    "text": "ابا نامداران توران سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 71,
    "position": 0,
    "text": "بریده سرافگنده بر سان پیل"
  },
  {
    "poem_id": 88033,
    "vorder": 72,
    "position": 1,
    "text": "تن از گُرز خسته به کردار نیل"
  },
  {
    "poem_id": 88033,
    "vorder": 73,
    "position": 0,
    "text": "چو بشنید پیران برآمد به جوش"
  },
  {
    "poem_id": 88033,
    "vorder": 74,
    "position": 1,
    "text": "نماند آن زمان با سپهدار هوش"
  },
  {
    "poem_id": 88033,
    "vorder": 75,
    "position": 0,
    "text": "همی کند موی و همی ریخت آب"
  },
  {
    "poem_id": 88033,
    "vorder": 76,
    "position": 1,
    "text": "از او دور شد خورد و آرام و خواب"
  },
  {
    "poem_id": 88033,
    "vorder": 77,
    "position": 0,
    "text": "بزد دست و بدرید رومی قبای"
  },
  {
    "poem_id": 88033,
    "vorder": 78,
    "position": 1,
    "text": "برآمد خروشیدن های های"
  },
  {
    "poem_id": 88033,
    "vorder": 79,
    "position": 0,
    "text": "همی گفت کای کردگار جهان"
  },
  {
    "poem_id": 88033,
    "vorder": 80,
    "position": 1,
    "text": "همانا که با تو بدستم نهان"
  },
  {
    "poem_id": 88033,
    "vorder": 81,
    "position": 0,
    "text": "که بگسست از بازوان زور من"
  },
  {
    "poem_id": 88033,
    "vorder": 82,
    "position": 1,
    "text": "چنین تیره شد اختر و هور من"
  },
  {
    "poem_id": 88033,
    "vorder": 83,
    "position": 0,
    "text": "دریغ آن هژبر افگن گردگیر"
  },
  {
    "poem_id": 88033,
    "vorder": 84,
    "position": 1,
    "text": "جوان دلاور سوار هژیر"
  },
  {
    "poem_id": 88033,
    "vorder": 85,
    "position": 0,
    "text": "گرامی برادر جهانبان من"
  },
  {
    "poem_id": 88033,
    "vorder": 86,
    "position": 1,
    "text": "سر ویسگان گرد هومان من"
  },
  {
    "poem_id": 88033,
    "vorder": 87,
    "position": 0,
    "text": "چو نستیهن آن شیر شرزه به جنگ"
  },
  {
    "poem_id": 88033,
    "vorder": 88,
    "position": 1,
    "text": "که روباه بودی به جنگش پلنگ"
  },
  {
    "poem_id": 88033,
    "vorder": 89,
    "position": 0,
    "text": "کرا یابم اکنون بدین رزمگاه"
  },
  {
    "poem_id": 88033,
    "vorder": 90,
    "position": 1,
    "text": "به جنگ اندر آورد باید سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 91,
    "position": 0,
    "text": "بزد نای رویین و بربست کوس"
  },
  {
    "poem_id": 88033,
    "vorder": 92,
    "position": 1,
    "text": "هوا نیلگون شد زمین آبنوس"
  },
  {
    "poem_id": 88033,
    "vorder": 93,
    "position": 0,
    "text": "ز کوه کنابد برون شد سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 94,
    "position": 1,
    "text": "بشد روشنایی ز خورشید و ماه"
  },
  {
    "poem_id": 88033,
    "vorder": 95,
    "position": 0,
    "text": "سپهدار ایران بزد کرنای"
  },
  {
    "poem_id": 88033,
    "vorder": 96,
    "position": 1,
    "text": "سپاه اندر آورد و بگرفت جای"
  },
  {
    "poem_id": 88033,
    "vorder": 97,
    "position": 0,
    "text": "میان سپه کاویانی درفش"
  },
  {
    "poem_id": 88033,
    "vorder": 98,
    "position": 1,
    "text": "به پیش اندرون تیغهای بنفش"
  },
  {
    "poem_id": 88033,
    "vorder": 99,
    "position": 0,
    "text": "همه نامداران پرخاشخر"
  },
  {
    "poem_id": 88033,
    "vorder": 100,
    "position": 1,
    "text": "ابا نیزه و گُرزهٔ گاوسر"
  },
  {
    "poem_id": 88033,
    "vorder": 101,
    "position": 0,
    "text": "سپیده‌دمان اندر آمد سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 102,
    "position": 1,
    "text": "به پیکار تا گشت گیتی سیاه"
  },
  {
    "poem_id": 88033,
    "vorder": 103,
    "position": 0,
    "text": "برفتند زان پس به بنگاه خویش"
  },
  {
    "poem_id": 88033,
    "vorder": 104,
    "position": 1,
    "text": "به خیمه شد این، آن به خرگاه خویش"
  },
  {
    "poem_id": 88033,
    "vorder": 105,
    "position": 0,
    "text": "سپهدار ایران به زیبد رسید"
  },
  {
    "poem_id": 88033,
    "vorder": 106,
    "position": 1,
    "text": "از اندیشه کردن دلش بردمید"
  },
  {
    "poem_id": 88033,
    "vorder": 107,
    "position": 0,
    "text": "همی گفت کامروز رزمی گران"
  },
  {
    "poem_id": 88033,
    "vorder": 108,
    "position": 1,
    "text": "بکردیم و کشتیم از ایشان سران"
  },
  {
    "poem_id": 88033,
    "vorder": 109,
    "position": 0,
    "text": "گمانی برم زانک پیران کنون"
  },
  {
    "poem_id": 88033,
    "vorder": 110,
    "position": 1,
    "text": "دواند سوی شاه ترکان هیون"
  },
  {
    "poem_id": 88033,
    "vorder": 111,
    "position": 0,
    "text": "وز او یار خواهد به جنگ سپاه"
  },
  {
    "poem_id": 88033,
    "vorder": 112,
    "position": 1,
    "text": "رسانم کنون آگهی من به شاه"
  }
]