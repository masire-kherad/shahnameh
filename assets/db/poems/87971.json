[
  {
    "poem_id": 87971,
    "vorder": 1,
    "position": 0,
    "text": "ازان پس خبر شد بافراسیاب"
  },
  {
    "poem_id": 87971,
    "vorder": 2,
    "position": 1,
    "text": "که شد مرز توران چو دریای آب"
  },
  {
    "poem_id": 87971,
    "vorder": 3,
    "position": 0,
    "text": "سوی کاسه‌رود اندر آمد سپاه"
  },
  {
    "poem_id": 87971,
    "vorder": 4,
    "position": 1,
    "text": "زمین شد ز کین سیاوش سیاه"
  },
  {
    "poem_id": 87971,
    "vorder": 5,
    "position": 0,
    "text": "سپهبد به پیران سالار گفت"
  },
  {
    "poem_id": 87971,
    "vorder": 6,
    "position": 1,
    "text": "که خسرو سخن برگشاد از نهفت"
  },
  {
    "poem_id": 87971,
    "vorder": 7,
    "position": 0,
    "text": "مگر کین سخن را پذیره شویم"
  },
  {
    "poem_id": 87971,
    "vorder": 8,
    "position": 1,
    "text": "همه با درفش و تبیره شویم"
  },
  {
    "poem_id": 87971,
    "vorder": 9,
    "position": 0,
    "text": "وگرنه ز ایران بیاید سپاه"
  },
  {
    "poem_id": 87971,
    "vorder": 10,
    "position": 1,
    "text": "نه خورشید بینیم روشن نه ماه"
  },
  {
    "poem_id": 87971,
    "vorder": 11,
    "position": 0,
    "text": "برو لشکر آور ز هر سو فراز"
  },
  {
    "poem_id": 87971,
    "vorder": 12,
    "position": 1,
    "text": "سخنها نباید که گردد دراز"
  },
  {
    "poem_id": 87971,
    "vorder": 13,
    "position": 0,
    "text": "وزین رو برآمد یکی تندباد"
  },
  {
    "poem_id": 87971,
    "vorder": 14,
    "position": 1,
    "text": "که کس را ز ایران نبد رزم یاد"
  },
  {
    "poem_id": 87971,
    "vorder": 15,
    "position": 0,
    "text": "یکی ابر تند اندر آمد چو گرد"
  },
  {
    "poem_id": 87971,
    "vorder": 16,
    "position": 1,
    "text": "ز سرما همی لب بدندان فسرد"
  },
  {
    "poem_id": 87971,
    "vorder": 17,
    "position": 0,
    "text": "سراپرده و خیمه‌ها گشت یخ"
  },
  {
    "poem_id": 87971,
    "vorder": 18,
    "position": 1,
    "text": "کشید از بر کوه بر برف نخ"
  },
  {
    "poem_id": 87971,
    "vorder": 19,
    "position": 0,
    "text": "بیک هفته کس روی هامون ندید"
  },
  {
    "poem_id": 87971,
    "vorder": 20,
    "position": 1,
    "text": "همه کشور از برف شد ناپدید"
  },
  {
    "poem_id": 87971,
    "vorder": 21,
    "position": 0,
    "text": "خور و خواب و آرامگه تنگ شد"
  },
  {
    "poem_id": 87971,
    "vorder": 22,
    "position": 1,
    "text": "تو گفتی که روی زمین سنگ شد"
  },
  {
    "poem_id": 87971,
    "vorder": 23,
    "position": 0,
    "text": "کسی را نبد یاد روز نبرد"
  },
  {
    "poem_id": 87971,
    "vorder": 24,
    "position": 1,
    "text": "همی اسپ جنگی بکشت و بخورد"
  },
  {
    "poem_id": 87971,
    "vorder": 25,
    "position": 0,
    "text": "تبه شد بسی مردم و چارپای"
  },
  {
    "poem_id": 87971,
    "vorder": 26,
    "position": 1,
    "text": "یکی را نبد چنگ و بازو بجای"
  },
  {
    "poem_id": 87971,
    "vorder": 27,
    "position": 0,
    "text": "بهشتم برآمد بلند آفتاب"
  },
  {
    "poem_id": 87971,
    "vorder": 28,
    "position": 1,
    "text": "جهان شد سراسر چو دریای آب"
  },
  {
    "poem_id": 87971,
    "vorder": 29,
    "position": 0,
    "text": "سپهبد سپه را همی گرد کرد"
  },
  {
    "poem_id": 87971,
    "vorder": 30,
    "position": 1,
    "text": "سخن رفت چندی ز روز نبرد"
  },
  {
    "poem_id": 87971,
    "vorder": 31,
    "position": 0,
    "text": "که ایدر سپه شد ز تنگی تباه"
  },
  {
    "poem_id": 87971,
    "vorder": 32,
    "position": 1,
    "text": "سزد گر برانیم ازین رزمگاه"
  },
  {
    "poem_id": 87971,
    "vorder": 33,
    "position": 0,
    "text": "مبادا برین بوم و برها درود"
  },
  {
    "poem_id": 87971,
    "vorder": 34,
    "position": 1,
    "text": "کلات و سپدکوه گر کاسه رود"
  },
  {
    "poem_id": 87971,
    "vorder": 35,
    "position": 0,
    "text": "ز گردان سرافراز بهرام گفت"
  },
  {
    "poem_id": 87971,
    "vorder": 36,
    "position": 1,
    "text": "که این از سپهبد نشاید نهفت"
  },
  {
    "poem_id": 87971,
    "vorder": 37,
    "position": 0,
    "text": "تو ما را بگفتار خامش کنی"
  },
  {
    "poem_id": 87971,
    "vorder": 38,
    "position": 1,
    "text": "همی رزم پور سیاوش کنی"
  },
  {
    "poem_id": 87971,
    "vorder": 39,
    "position": 0,
    "text": "مکن کژ ابر خیره بر کار راست"
  },
  {
    "poem_id": 87971,
    "vorder": 40,
    "position": 1,
    "text": "بیک جان نگه کن که چندین بکاست"
  },
  {
    "poem_id": 87971,
    "vorder": 41,
    "position": 0,
    "text": "هنوز از بدی تا چه آیدت پیش"
  },
  {
    "poem_id": 87971,
    "vorder": 42,
    "position": 1,
    "text": "به چرم اندر است این زمان گاومیش"
  },
  {
    "poem_id": 87971,
    "vorder": 43,
    "position": 0,
    "text": "سپهبد چنین گفت کاذرگشسپ"
  },
  {
    "poem_id": 87971,
    "vorder": 44,
    "position": 1,
    "text": "نبد نامورتر ز جنگی زرسپ"
  },
  {
    "poem_id": 87971,
    "vorder": 45,
    "position": 0,
    "text": "بلشکر نگه کن که چون ریونیز"
  },
  {
    "poem_id": 87971,
    "vorder": 46,
    "position": 1,
    "text": "که بینی بمردی و دیدار نیز"
  },
  {
    "poem_id": 87971,
    "vorder": 47,
    "position": 0,
    "text": "نه بر بی‌گنه کشته آمد فرود"
  },
  {
    "poem_id": 87971,
    "vorder": 48,
    "position": 1,
    "text": "نوشته چنین بود بود آنچ بود"
  },
  {
    "poem_id": 87971,
    "vorder": 49,
    "position": 0,
    "text": "مرا جام ازو پر می و شیر بود"
  },
  {
    "poem_id": 87971,
    "vorder": 50,
    "position": 1,
    "text": "جوان را ز بالا سخن تیر بود"
  },
  {
    "poem_id": 87971,
    "vorder": 51,
    "position": 0,
    "text": "کنون از گذشته نیاریم یاد"
  },
  {
    "poem_id": 87971,
    "vorder": 52,
    "position": 1,
    "text": "به بیداد شد کشته او گر بداد"
  },
  {
    "poem_id": 87971,
    "vorder": 53,
    "position": 0,
    "text": "چو خلعت ستد گیو گودرز ز شاه"
  },
  {
    "poem_id": 87971,
    "vorder": 54,
    "position": 1,
    "text": "که آن کوه هیزم بسوزد براه"
  },
  {
    "poem_id": 87971,
    "vorder": 55,
    "position": 0,
    "text": "کنونست هنگام آن سوختن"
  },
  {
    "poem_id": 87971,
    "vorder": 56,
    "position": 1,
    "text": "به آتش سپهری برافروختن"
  },
  {
    "poem_id": 87971,
    "vorder": 57,
    "position": 0,
    "text": "گشاده شود راه لشکر مگر"
  },
  {
    "poem_id": 87971,
    "vorder": 58,
    "position": 1,
    "text": "بباشد سپه را بروبر گذر"
  },
  {
    "poem_id": 87971,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت گیو این سخن رنج نیست"
  },
  {
    "poem_id": 87971,
    "vorder": 60,
    "position": 1,
    "text": "وگر هست هم رنج بی‌گنج نیست"
  },
  {
    "poem_id": 87971,
    "vorder": 61,
    "position": 0,
    "text": "غمی گشت بیژن بدین داستان"
  },
  {
    "poem_id": 87971,
    "vorder": 62,
    "position": 1,
    "text": "نباشم بدین گفت همداستان"
  },
  {
    "poem_id": 87971,
    "vorder": 63,
    "position": 0,
    "text": "مرا با جوانی نباید نشست"
  },
  {
    "poem_id": 87971,
    "vorder": 64,
    "position": 1,
    "text": "بپیری کمر بر میان تو بست"
  },
  {
    "poem_id": 87971,
    "vorder": 65,
    "position": 0,
    "text": "برنج و بسختی بپروردیم"
  },
  {
    "poem_id": 87971,
    "vorder": 66,
    "position": 1,
    "text": "بگفتار هرگز نیازردیم"
  },
  {
    "poem_id": 87971,
    "vorder": 67,
    "position": 0,
    "text": "مرا برد باید بدین کار دست"
  },
  {
    "poem_id": 87971,
    "vorder": 68,
    "position": 1,
    "text": "نشاید تو با رنج و من با نشست"
  },
  {
    "poem_id": 87971,
    "vorder": 69,
    "position": 0,
    "text": "بدو گفت گیو آنک من ساختم"
  },
  {
    "poem_id": 87971,
    "vorder": 70,
    "position": 1,
    "text": "بدین کار گردن برافراختم"
  },
  {
    "poem_id": 87971,
    "vorder": 71,
    "position": 0,
    "text": "کنون ای پسر گاه آرایشست"
  },
  {
    "poem_id": 87971,
    "vorder": 72,
    "position": 1,
    "text": "نه هنگام پیری و بخشایشست"
  },
  {
    "poem_id": 87971,
    "vorder": 73,
    "position": 0,
    "text": "ازین رفتن من ندار ایچ غم"
  },
  {
    "poem_id": 87971,
    "vorder": 74,
    "position": 1,
    "text": "که من کوه خارا بسوزم به دم"
  },
  {
    "poem_id": 87971,
    "vorder": 75,
    "position": 0,
    "text": "بسختی گذشت از در کاسه‌رود"
  },
  {
    "poem_id": 87971,
    "vorder": 76,
    "position": 1,
    "text": "جهان را همه رنج برف آب بود"
  },
  {
    "poem_id": 87971,
    "vorder": 77,
    "position": 0,
    "text": "چو آمد بران کوه هیزم فراز"
  },
  {
    "poem_id": 87971,
    "vorder": 78,
    "position": 1,
    "text": "ندانست بالا و پهناش باز"
  },
  {
    "poem_id": 87971,
    "vorder": 79,
    "position": 0,
    "text": "ز پیکان تیر آتشی برفروخت"
  },
  {
    "poem_id": 87971,
    "vorder": 80,
    "position": 1,
    "text": "بکوه اندر افگند و هیزم بسوخت"
  },
  {
    "poem_id": 87971,
    "vorder": 81,
    "position": 0,
    "text": "ز آتش سه هفته گذرشان نبود"
  },
  {
    "poem_id": 87971,
    "vorder": 82,
    "position": 1,
    "text": "ز تف زبانه ز باد و ز دود"
  },
  {
    "poem_id": 87971,
    "vorder": 83,
    "position": 0,
    "text": "چهارم سپه برگذشتن گرفت"
  },
  {
    "poem_id": 87971,
    "vorder": 84,
    "position": 1,
    "text": "همان آب و آتش نشستن گرفت"
  },
  {
    "poem_id": 87971,
    "vorder": 85,
    "position": 0,
    "text": "سپهبد چو لشکر برو گرد شد"
  },
  {
    "poem_id": 87971,
    "vorder": 86,
    "position": 1,
    "text": "ز آتش براه گروگرد شد"
  },
  {
    "poem_id": 87971,
    "vorder": 87,
    "position": 0,
    "text": "سپاه اندر آمد چنانچون سزد"
  },
  {
    "poem_id": 87971,
    "vorder": 88,
    "position": 1,
    "text": "همه کوه و هامون سراپرده زد"
  },
  {
    "poem_id": 87971,
    "vorder": 89,
    "position": 0,
    "text": "چنانچون ببایست برساختند"
  },
  {
    "poem_id": 87971,
    "vorder": 90,
    "position": 1,
    "text": "ز هر سو طلایه برون تاختند"
  },
  {
    "poem_id": 87971,
    "vorder": 91,
    "position": 0,
    "text": "گروگرد بودی نشست تژاو"
  },
  {
    "poem_id": 87971,
    "vorder": 92,
    "position": 1,
    "text": "سواری که بودیش با شیر تاو"
  },
  {
    "poem_id": 87971,
    "vorder": 93,
    "position": 0,
    "text": "فسیله بدان جایگه داشتی"
  },
  {
    "poem_id": 87971,
    "vorder": 94,
    "position": 1,
    "text": "چنان کوه تا کوه بگذاشتی"
  },
  {
    "poem_id": 87971,
    "vorder": 95,
    "position": 0,
    "text": "خبر شد که آمد ز ایران سپاه"
  },
  {
    "poem_id": 87971,
    "vorder": 96,
    "position": 1,
    "text": "گله برد باید به یکسو ز راه"
  },
  {
    "poem_id": 87971,
    "vorder": 97,
    "position": 0,
    "text": "فرستاد گردی هم اندر شتاب"
  },
  {
    "poem_id": 87971,
    "vorder": 98,
    "position": 1,
    "text": "بنزدیک چوپان افراسیاب"
  },
  {
    "poem_id": 87971,
    "vorder": 99,
    "position": 0,
    "text": "کبوده بدش نام و شایسته بود"
  },
  {
    "poem_id": 87971,
    "vorder": 100,
    "position": 1,
    "text": "بشایستگی نیز بایسته بود"
  },
  {
    "poem_id": 87971,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت چون تیره گردد سپهر"
  },
  {
    "poem_id": 87971,
    "vorder": 102,
    "position": 1,
    "text": "تو ز ایدر برو هیچ منمای چهر"
  },
  {
    "poem_id": 87971,
    "vorder": 103,
    "position": 0,
    "text": "نگه کن که چندست ز ایران سپاه"
  },
  {
    "poem_id": 87971,
    "vorder": 104,
    "position": 1,
    "text": "ز گردان که دارد درفش و کلاه"
  },
  {
    "poem_id": 87971,
    "vorder": 105,
    "position": 0,
    "text": "ازیدر بر ایشان شبیخون کنیم"
  },
  {
    "poem_id": 87971,
    "vorder": 106,
    "position": 1,
    "text": "همه کوه در جنگ هامون کنیم"
  },
  {
    "poem_id": 87971,
    "vorder": 107,
    "position": 0,
    "text": "کبوده بیامد چو گرد سیاه"
  },
  {
    "poem_id": 87971,
    "vorder": 108,
    "position": 1,
    "text": "شب تیره نزدیک ایران سپاه"
  },
  {
    "poem_id": 87971,
    "vorder": 109,
    "position": 0,
    "text": "طلایه شب تیره بهرام بود"
  },
  {
    "poem_id": 87971,
    "vorder": 110,
    "position": 1,
    "text": "کمندش سر پیل را دام بود"
  },
  {
    "poem_id": 87971,
    "vorder": 111,
    "position": 0,
    "text": "برآورد اسپ کبوده خروش"
  },
  {
    "poem_id": 87971,
    "vorder": 112,
    "position": 1,
    "text": "ز لشکر برافراخت بهرام گوش"
  },
  {
    "poem_id": 87971,
    "vorder": 113,
    "position": 0,
    "text": "کمان را بزه کرد و بفشارد ران"
  },
  {
    "poem_id": 87971,
    "vorder": 114,
    "position": 1,
    "text": "درآمد ز جای آن هیون گران"
  },
  {
    "poem_id": 87971,
    "vorder": 115,
    "position": 0,
    "text": "یکی تیر بگشاد و نگشاد لب"
  },
  {
    "poem_id": 87971,
    "vorder": 116,
    "position": 1,
    "text": "کبوده نبود ایچ پیدا ز شب"
  },
  {
    "poem_id": 87971,
    "vorder": 117,
    "position": 0,
    "text": "بزد بر کمربند چوپان شاه"
  },
  {
    "poem_id": 87971,
    "vorder": 118,
    "position": 1,
    "text": "همی گشت رنگ کبوده سیاه"
  },
  {
    "poem_id": 87971,
    "vorder": 119,
    "position": 0,
    "text": "ز اسپ اندر افتاد و زنهار خواست"
  },
  {
    "poem_id": 87971,
    "vorder": 120,
    "position": 1,
    "text": "بدو گفت بهرام برگوی راست"
  },
  {
    "poem_id": 87971,
    "vorder": 121,
    "position": 0,
    "text": "که ایدر فرستندهٔ تو که بود"
  },
  {
    "poem_id": 87971,
    "vorder": 122,
    "position": 1,
    "text": "کرا خواستی زین بزرگان بسود"
  },
  {
    "poem_id": 87971,
    "vorder": 123,
    "position": 0,
    "text": "ببهرام گفت ار دهی زینهار"
  },
  {
    "poem_id": 87971,
    "vorder": 124,
    "position": 1,
    "text": "بگویم ترا هرچ پرسی ز کار"
  },
  {
    "poem_id": 87971,
    "vorder": 125,
    "position": 0,
    "text": "تژاوست شاها فرستنده‌ام"
