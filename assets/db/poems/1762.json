[
  {
    "poem_id": 1762,
    "vorder": 1,
    "position": 0,
    "text": "چو در دخمه شد شهریار جهان"
  },
  {
    "poem_id": 1762,
    "vorder": 2,
    "position": 1,
    "text": "ز ایران برفتند گریان مهان"
  },
  {
    "poem_id": 1762,
    "vorder": 3,
    "position": 0,
    "text": "کنارنگ با موبد و پهلوان"
  },
  {
    "poem_id": 1762,
    "vorder": 4,
    "position": 1,
    "text": "هشیوار دستور روشن‌روان"
  },
  {
    "poem_id": 1762,
    "vorder": 5,
    "position": 0,
    "text": "همه پاک در پارس گرد آمدند"
  },
  {
    "poem_id": 1762,
    "vorder": 6,
    "position": 1,
    "text": "بر دخمه یزدگرد آمدند"
  },
  {
    "poem_id": 1762,
    "vorder": 7,
    "position": 0,
    "text": "چو گستهم کو پیل کشتی بر اسپ"
  },
  {
    "poem_id": 1762,
    "vorder": 8,
    "position": 1,
    "text": "دگر قارن گرد پور گشسپ"
  },
  {
    "poem_id": 1762,
    "vorder": 9,
    "position": 0,
    "text": "چو میلاد و چون پارس مرزبان"
  },
  {
    "poem_id": 1762,
    "vorder": 10,
    "position": 1,
    "text": "چو پیروز اسپ‌افگن از گرزبان"
  },
  {
    "poem_id": 1762,
    "vorder": 11,
    "position": 0,
    "text": "دگر هرک بودند ز ایران مهان"
  },
  {
    "poem_id": 1762,
    "vorder": 12,
    "position": 1,
    "text": "بزرگان و کنداوران جهان"
  },
  {
    "poem_id": 1762,
    "vorder": 13,
    "position": 0,
    "text": "کجا خوارشان داشتی یزدگرد"
  },
  {
    "poem_id": 1762,
    "vorder": 14,
    "position": 1,
    "text": "همه آمدند اندران شهرگرد"
  },
  {
    "poem_id": 1762,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت گویا گشسپ دبیر"
  },
  {
    "poem_id": 1762,
    "vorder": 16,
    "position": 1,
    "text": "که ای نامداران برنا و پیر"
  },
  {
    "poem_id": 1762,
    "vorder": 17,
    "position": 0,
    "text": "جهاندارمان تا جهان آفرید"
  },
  {
    "poem_id": 1762,
    "vorder": 18,
    "position": 1,
    "text": "کسی زین نشان شهریاری ندید"
  },
  {
    "poem_id": 1762,
    "vorder": 19,
    "position": 0,
    "text": "که جز کشتن و خواری و درد و رنج"
  },
  {
    "poem_id": 1762,
    "vorder": 20,
    "position": 1,
    "text": "بیاگندن از چیز درویش گنج"
  },
  {
    "poem_id": 1762,
    "vorder": 21,
    "position": 0,
    "text": "ازین شاه ناپاک‌تر کس ندید"
  },
  {
    "poem_id": 1762,
    "vorder": 22,
    "position": 1,
    "text": "نه از نامداران پیشین شنید"
  },
  {
    "poem_id": 1762,
    "vorder": 23,
    "position": 0,
    "text": "نخواهیم بر تخت زین تخمه‌کس"
  },
  {
    "poem_id": 1762,
    "vorder": 24,
    "position": 1,
    "text": "ز خاکش به یزدان پناهیم و بس"
  },
  {
    "poem_id": 1762,
    "vorder": 25,
    "position": 0,
    "text": "سرافراز بهرام فرزند اوست"
  },
  {
    "poem_id": 1762,
    "vorder": 26,
    "position": 1,
    "text": "ز مغز و دل و رای پیوند اوست"
  },
  {
    "poem_id": 1762,
    "vorder": 27,
    "position": 0,
    "text": "ز منذر گشاید سخن سربسر"
  },
  {
    "poem_id": 1762,
    "vorder": 28,
    "position": 1,
    "text": "نخواهیم بر تخت بیدادگر"
  },
  {
    "poem_id": 1762,
    "vorder": 29,
    "position": 0,
    "text": "بخوردند سوگندهای گران"
  },
  {
    "poem_id": 1762,
    "vorder": 30,
    "position": 1,
    "text": "هرانکس که بودند ایرانیان"
  },
  {
    "poem_id": 1762,
    "vorder": 31,
    "position": 0,
    "text": "کزین تخمه کس را به شاهنشهی"
  },
  {
    "poem_id": 1762,
    "vorder": 32,
    "position": 1,
    "text": "نخواهیم با تاج و تخت مهی"
  },
  {
    "poem_id": 1762,
    "vorder": 33,
    "position": 0,
    "text": "برین برنهادند و برخاستند"
  },
  {
    "poem_id": 1762,
    "vorder": 34,
    "position": 1,
    "text": "همی شهریاری دگر خواستند"
  },
  {
    "poem_id": 1762,
    "vorder": 35,
    "position": 0,
    "text": "چو آگاهی مرگ شاه جهان"
  },
  {
    "poem_id": 1762,
    "vorder": 36,
    "position": 1,
    "text": "پراگنده شد در میان مهان"
  },
  {
    "poem_id": 1762,
    "vorder": 37,
    "position": 0,
    "text": "الان شاه و چون پارس پهلوسپاه"
  },
  {
    "poem_id": 1762,
    "vorder": 38,
    "position": 1,
    "text": "چو بیورد و شگنان زرین کلاه"
  },
  {
    "poem_id": 1762,
    "vorder": 39,
    "position": 0,
    "text": "همی هریکی گفت شاهی مراست"
  },
  {
    "poem_id": 1762,
    "vorder": 40,
    "position": 1,
    "text": "هم از خاک تا برج ماهی مراست"
  },
  {
    "poem_id": 1762,
    "vorder": 41,
    "position": 0,
    "text": "جهانی پرآشوب شد سر به سر"
  },
  {
    "poem_id": 1762,
    "vorder": 42,
    "position": 1,
    "text": "چو از تخت گم شد سر تاجور"
  },
  {
    "poem_id": 1762,
    "vorder": 43,
    "position": 0,
    "text": "به ایران رد و موبد و پهلوان"
  },
  {
    "poem_id": 1762,
    "vorder": 44,
    "position": 1,
    "text": "هرانکس که بودند روشن‌روان"
  },
  {
    "poem_id": 1762,
    "vorder": 45,
    "position": 0,
    "text": "بدین کار در پارس گرد آمدند"
  },
  {
    "poem_id": 1762,
    "vorder": 46,
    "position": 1,
    "text": "بسی زین نشان داستانها زدند"
  },
  {
    "poem_id": 1762,
    "vorder": 47,
    "position": 0,
    "text": "که این تاج شاهی سزاوار کیست"
  },
  {
    "poem_id": 1762,
    "vorder": 48,
    "position": 1,
    "text": "ببینید تا از در کار کیست"
  },
  {
    "poem_id": 1762,
    "vorder": 49,
    "position": 0,
    "text": "بجویید بخشنده‌ای دادگر"
  },
  {
    "poem_id": 1762,
    "vorder": 50,
    "position": 1,
    "text": "که بندد برین تخت زرین کمر"
  },
  {
    "poem_id": 1762,
    "vorder": 51,
    "position": 0,
    "text": "که آشوب بنشاند از روزگار"
  },
  {
    "poem_id": 1762,
    "vorder": 52,
    "position": 1,
    "text": "جهان مرغزاریست بی‌شهریار"
  },
  {
    "poem_id": 1762,
    "vorder": 53,
    "position": 0,
    "text": "یکی مرد بد پیر خسرو به نام"
  },
  {
    "poem_id": 1762,
    "vorder": 54,
    "position": 1,
    "text": "جوانمرد و روشن‌دل و شادکام"
  },
  {
    "poem_id": 1762,
    "vorder": 55,
    "position": 0,
    "text": "هم از تخمه سرفرازان بد اوی"
  },
  {
    "poem_id": 1762,
    "vorder": 56,
    "position": 1,
    "text": "به مرز اندر از بی‌نیازان بد اوی"
  },
  {
    "poem_id": 1762,
    "vorder": 57,
    "position": 0,
    "text": "سپردند گردان بدو تاج و گاه"
  },
  {
    "poem_id": 1762,
    "vorder": 58,
    "position": 1,
    "text": "برو انجمن شد ز هر سو سپاه"
  }
]