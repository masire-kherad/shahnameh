[
  {
    "poem_id": 88074,
    "vorder": 1,
    "position": 0,
    "text": "یکی تاج دادش زبرجد نگار"
  },
  {
    "poem_id": 88074,
    "vorder": 2,
    "position": 1,
    "text": "یکی طوق زرین و دو گوشوار"
  },
  {
    "poem_id": 88074,
    "vorder": 3,
    "position": 0,
    "text": "همانگه بشد جهن پیش پدر"
  },
  {
    "poem_id": 88074,
    "vorder": 4,
    "position": 1,
    "text": "بگفت آن سخنها همه در به در"
  },
  {
    "poem_id": 88074,
    "vorder": 5,
    "position": 0,
    "text": "ز پاسخ برآشفت افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 6,
    "position": 1,
    "text": "سواری ز ترکان کجا یافت خواب"
  },
  {
    "poem_id": 88074,
    "vorder": 7,
    "position": 0,
    "text": "ببخشید گنج درم بر سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 8,
    "position": 1,
    "text": "همان ترگ و شمشیر و تخت و کلاه"
  },
  {
    "poem_id": 88074,
    "vorder": 9,
    "position": 0,
    "text": "شب تیره تا برزد از چرخ شید"
  },
  {
    "poem_id": 88074,
    "vorder": 10,
    "position": 1,
    "text": "بشد کوه چون پشت پیل سپید"
  },
  {
    "poem_id": 88074,
    "vorder": 11,
    "position": 0,
    "text": "همی لشکر آراست افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 12,
    "position": 1,
    "text": "دلش بود پردرد و سر پر شتاب"
  },
  {
    "poem_id": 88074,
    "vorder": 13,
    "position": 0,
    "text": "چو از گنگ برخاست آوای کوس"
  },
  {
    "poem_id": 88074,
    "vorder": 14,
    "position": 1,
    "text": "زمین آهنین شد هوا آبنوس"
  },
  {
    "poem_id": 88074,
    "vorder": 15,
    "position": 0,
    "text": "سر موبدان شاه نیکی گمان"
  },
  {
    "poem_id": 88074,
    "vorder": 16,
    "position": 1,
    "text": "نشست از بر زین سپیده‌دمان"
  },
  {
    "poem_id": 88074,
    "vorder": 17,
    "position": 0,
    "text": "بیامد بگردید گرد حصار"
  },
  {
    "poem_id": 88074,
    "vorder": 18,
    "position": 1,
    "text": "نگه کرد تا چون کند کارزار"
  },
  {
    "poem_id": 88074,
    "vorder": 19,
    "position": 0,
    "text": "به رستم بفرمود تا همچو کوه"
  },
  {
    "poem_id": 88074,
    "vorder": 20,
    "position": 1,
    "text": "بیارد به یک سو ز دریا گروه"
  },
  {
    "poem_id": 88074,
    "vorder": 21,
    "position": 0,
    "text": "دگر سوش گستهم نوذر به پای"
  },
  {
    "poem_id": 88074,
    "vorder": 22,
    "position": 1,
    "text": "سه دیگر چو گودرز فرخنده رای"
  },
  {
    "poem_id": 88074,
    "vorder": 23,
    "position": 0,
    "text": "به سوی چهارم شه نامدار"
  },
  {
    "poem_id": 88074,
    "vorder": 24,
    "position": 1,
    "text": "ابا کوس و پیلان و چندی سوار"
  },
  {
    "poem_id": 88074,
    "vorder": 25,
    "position": 0,
    "text": "سپه را همه هرچه بایست ساز"
  },
  {
    "poem_id": 88074,
    "vorder": 26,
    "position": 1,
    "text": "بکرد و بیامد بر دژ فراز"
  },
  {
    "poem_id": 88074,
    "vorder": 27,
    "position": 0,
    "text": "به لشکر بفرمود پس شهریار"
  },
  {
    "poem_id": 88074,
    "vorder": 28,
    "position": 1,
    "text": "یکی کنده کردن به گرد حصار"
  },
  {
    "poem_id": 88074,
    "vorder": 29,
    "position": 0,
    "text": "بدان کار هر کس که دانا بدند"
  },
  {
    "poem_id": 88074,
    "vorder": 30,
    "position": 1,
    "text": "به جنگ دژ اندر توانا بدند"
  },
  {
    "poem_id": 88074,
    "vorder": 31,
    "position": 0,
    "text": "چه از چین وز روم وز هندوان"
  },
  {
    "poem_id": 88074,
    "vorder": 32,
    "position": 1,
    "text": "چه رزم آزموده ز هر سو گوان"
  },
  {
    "poem_id": 88074,
    "vorder": 33,
    "position": 0,
    "text": "همه گرد آن شارستان چون نوند"
  },
  {
    "poem_id": 88074,
    "vorder": 34,
    "position": 1,
    "text": "بگشتند و جستند هر گونه بند"
  },
  {
    "poem_id": 88074,
    "vorder": 35,
    "position": 0,
    "text": "دو نیزه به بالا یکی کنده کرد"
  },
  {
    "poem_id": 88074,
    "vorder": 36,
    "position": 1,
    "text": "سپه را به گردش پراگنده کرد"
  },
  {
    "poem_id": 88074,
    "vorder": 37,
    "position": 0,
    "text": "بدان تا شب تیره بی ساختن"
  },
  {
    "poem_id": 88074,
    "vorder": 38,
    "position": 1,
    "text": "نیارند ترکان یکی تاختن"
  },
  {
    "poem_id": 88074,
    "vorder": 39,
    "position": 0,
    "text": "دو صد ساخت عراده بر هر دری"
  },
  {
    "poem_id": 88074,
    "vorder": 40,
    "position": 1,
    "text": "دو صد منجنیق از پس لشکری"
  },
  {
    "poem_id": 88074,
    "vorder": 41,
    "position": 0,
    "text": "دو صد چرخ بر هر دری با کمان"
  },
  {
    "poem_id": 88074,
    "vorder": 42,
    "position": 1,
    "text": "ز دیوار دژ چون سر بدگمان"
  },
  {
    "poem_id": 88074,
    "vorder": 43,
    "position": 0,
    "text": "پدید آمدی منجینق از برش"
  },
  {
    "poem_id": 88074,
    "vorder": 44,
    "position": 1,
    "text": "چو ژاله همی کوفتی بر سرش"
  },
  {
    "poem_id": 88074,
    "vorder": 45,
    "position": 0,
    "text": "پس منجنیق اندرون رومیان"
  },
  {
    "poem_id": 88074,
    "vorder": 46,
    "position": 1,
    "text": "ابا چرخها تنگ بسته میان"
  },
  {
    "poem_id": 88074,
    "vorder": 47,
    "position": 0,
    "text": "دو صد پیل فرمود پس شهریار"
  },
  {
    "poem_id": 88074,
    "vorder": 48,
    "position": 1,
    "text": "کشیدن ز هر سو به گرد حصار"
  },
  {
    "poem_id": 88074,
    "vorder": 49,
    "position": 0,
    "text": "یکی کنده‌ای زیر باره درون"
  },
  {
    "poem_id": 88074,
    "vorder": 50,
    "position": 1,
    "text": "بکند و نهادند زیرش ستون"
  },
  {
    "poem_id": 88074,
    "vorder": 51,
    "position": 0,
    "text": "بد آن منکری باره مانده به پای"
  },
  {
    "poem_id": 88074,
    "vorder": 52,
    "position": 1,
    "text": "بدان نیزه‌ها برگرفته ز جای"
  },
  {
    "poem_id": 88074,
    "vorder": 53,
    "position": 0,
    "text": "پس آلود بر چوب نفط سیاه"
  },
  {
    "poem_id": 88074,
    "vorder": 54,
    "position": 1,
    "text": "بدین گونه فرمود بیدار شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 55,
    "position": 0,
    "text": "به یک سو بر از منجنیق و ز تیر"
  },
  {
    "poem_id": 88074,
    "vorder": 56,
    "position": 1,
    "text": "رخ سرکشان گشته همچون زریر"
  },
  {
    "poem_id": 88074,
    "vorder": 57,
    "position": 0,
    "text": "به‌ زیر اندرون آتش و نفط و چوب"
  },
  {
    "poem_id": 88074,
    "vorder": 58,
    "position": 1,
    "text": "ز بر گرزهای گران کوب کوب"
  },
  {
    "poem_id": 88074,
    "vorder": 59,
    "position": 0,
    "text": "به هر چارسو ساخت آن کارزار"
  },
  {
    "poem_id": 88074,
    "vorder": 60,
    "position": 1,
    "text": "چنانچون بود ساز جنگ حصار"
  },
  {
    "poem_id": 88074,
    "vorder": 61,
    "position": 0,
    "text": "وزآن جایگه شهریار زمین"
  },
  {
    "poem_id": 88074,
    "vorder": 62,
    "position": 1,
    "text": "بیامد به پیش جهان‌آفرین"
  },
  {
    "poem_id": 88074,
    "vorder": 63,
    "position": 0,
    "text": "ز لشکر بشد تا به جای نماز"
  },
  {
    "poem_id": 88074,
    "vorder": 64,
    "position": 1,
    "text": "ابا کردگار جهان گفت راز"
  },
  {
    "poem_id": 88074,
    "vorder": 65,
    "position": 0,
    "text": "ابر خاک چون مار پیچان ز کین"
  },
  {
    "poem_id": 88074,
    "vorder": 66,
    "position": 1,
    "text": "همی خواند بر کردگار آفرین"
  },
  {
    "poem_id": 88074,
    "vorder": 67,
    "position": 0,
    "text": "همی گفت کام و بلندی ز تست"
  },
  {
    "poem_id": 88074,
    "vorder": 68,
    "position": 1,
    "text": "به هر سختیی یارمندی ز تست"
  },
  {
    "poem_id": 88074,
    "vorder": 69,
    "position": 0,
    "text": "اگر داد بینی همی رای من"
  },
  {
    "poem_id": 88074,
    "vorder": 70,
    "position": 1,
    "text": "مگردان از این جایگه پای من"
  },
  {
    "poem_id": 88074,
    "vorder": 71,
    "position": 0,
    "text": "نگون کن سر جادوان را ز تخت"
  },
  {
    "poem_id": 88074,
    "vorder": 72,
    "position": 1,
    "text": "مرا دار شادان‌دل و نیک‌بخت"
  },
  {
    "poem_id": 88074,
    "vorder": 73,
    "position": 0,
    "text": "چو برداشت از پیش یزدان سرش"
  },
  {
    "poem_id": 88074,
    "vorder": 74,
    "position": 1,
    "text": "به جوشن بپوشید روشن برش"
  },
  {
    "poem_id": 88074,
    "vorder": 75,
    "position": 0,
    "text": "کمر بر میان بست و برجست زود"
  },
  {
    "poem_id": 88074,
    "vorder": 76,
    "position": 1,
    "text": "به جنگ اندر آمد به کردار دود"
  },
  {
    "poem_id": 88074,
    "vorder": 77,
    "position": 0,
    "text": "بفرمود تا سخت بر هر دری"
  },
  {
    "poem_id": 88074,
    "vorder": 78,
    "position": 1,
    "text": "به جنگ اندر آید یکی لشکری"
  },
  {
    "poem_id": 88074,
    "vorder": 79,
    "position": 0,
    "text": "بدان چوب و نفط آتش اندر زدند"
  },
  {
    "poem_id": 88074,
    "vorder": 80,
    "position": 1,
    "text": "ز برشان همی سنگ بر سر زدند"
  },
  {
    "poem_id": 88074,
    "vorder": 81,
    "position": 0,
    "text": "ز بانگ کمانهای چرخ و ز دود"
  },
  {
    "poem_id": 88074,
    "vorder": 82,
    "position": 1,
    "text": "شده روی خورشید تابان کبود"
  },
  {
    "poem_id": 88074,
    "vorder": 83,
    "position": 0,
    "text": "ز عراده و منجنیق و ز گرد"
  },
  {
    "poem_id": 88074,
    "vorder": 84,
    "position": 1,
    "text": "زمین نیلگون شد هوا لاژورد"
  },
  {
    "poem_id": 88074,
    "vorder": 85,
    "position": 0,
    "text": "خروشیدن پیل و بانگ سران"
  },
  {
    "poem_id": 88074,
    "vorder": 86,
    "position": 1,
    "text": "درخشیدن تیغ و گرز گران"
  },
  {
    "poem_id": 88074,
    "vorder": 87,
    "position": 0,
    "text": "تو گفتی برآویخت با شید ماه"
  },
  {
    "poem_id": 88074,
    "vorder": 88,
    "position": 1,
    "text": "ز باریدن تیر و گرد سیاه"
  },
  {
    "poem_id": 88074,
    "vorder": 89,
    "position": 0,
    "text": "ز نفط سیه چوبها برفروخت"
  },
  {
    "poem_id": 88074,
    "vorder": 90,
    "position": 1,
    "text": "به فرمان یزدان چو هیزم بسوخت"
  },
  {
    "poem_id": 88074,
    "vorder": 91,
    "position": 0,
    "text": "نگون باره گفتی که برداشت پای"
  },
  {
    "poem_id": 88074,
    "vorder": 92,
    "position": 1,
    "text": "به کردار کوه اندر آمد ز جای"
  },
  {
    "poem_id": 88074,
    "vorder": 93,
    "position": 0,
    "text": "وز آن باره چندی ز ترکان دلیر"
  },
  {
    "poem_id": 88074,
    "vorder": 94,
    "position": 1,
    "text": "نگون اندر آمد چو باران به زیر"
  },
  {
    "poem_id": 88074,
    "vorder": 95,
    "position": 0,
    "text": "که آید به دام اندرون ناگهان"
  },
  {
    "poem_id": 88074,
    "vorder": 96,
    "position": 1,
    "text": "سر آرد بر آن شوربختی جهان"
  },
  {
    "poem_id": 88074,
    "vorder": 97,
    "position": 0,
    "text": "به پیروزی از لشکر شهریار"
  },
  {
    "poem_id": 88074,
    "vorder": 98,
    "position": 1,
    "text": "برآمد خروشیدن کارزار"
  },
  {
    "poem_id": 88074,
    "vorder": 99,
    "position": 0,
    "text": "سوی رخنهٔ دژ نهادند روی"
  },
  {
    "poem_id": 88074,
    "vorder": 100,
    "position": 1,
    "text": "بیامد دمان رستم کینه‌جوی"
  },
  {
    "poem_id": 88074,
    "vorder": 101,
    "position": 0,
    "text": "خبر شد به نزدیک افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 102,
    "position": 1,
    "text": "کجا بارهٔ شارستان شد خراب"
  },
  {
    "poem_id": 88074,
    "vorder": 103,
    "position": 0,
    "text": "پس افراسیاب اندر آمد چو گرد"
  },
  {
    "poem_id": 88074,
    "vorder": 104,
    "position": 1,
    "text": "به جهن و به گرسیوز آواز کرد"
  },
  {
    "poem_id": 88074,
    "vorder": 105,
    "position": 0,
    "text": "که با بارهٔ دژ شما را چه کار"
  },
  {
    "poem_id": 88074,
    "vorder": 106,
    "position": 1,
    "text": "سپه را ز شمشیر باید حصار"
  },
  {
    "poem_id": 88074,
    "vorder": 107,
    "position": 0,
    "text": "ز بهر بر و بوم و پیوند خویش"
  },
  {
    "poem_id": 88074,
    "vorder": 108,
    "position": 1,
    "text": "همان از پی گنج و فرزند خویش"
  },
  {
    "poem_id": 88074,
    "vorder": 109,
    "position": 0,
    "text": "ببندیم دامن یک اندر دگر"
  },
  {
    "poem_id": 88074,
    "vorder": 110,
    "position": 1,
    "text": "نمانیم بر دشمنان بوم و بر"
  },
  {
    "poem_id": 88074,
    "vorder": 111,
    "position": 0,
    "text": "سپاهی ز ترکان گروها گروه"
  },
  {
    "poem_id": 88074,
    "vorder": 112,
    "position": 1,
    "text": "بدان رخنه رفتند بر سان کوه"
  },
  {
    "poem_id": 88074,
    "vorder": 113,
    "position": 0,
    "text": "به کردار شیران برآویختند"
  },
  {
    "poem_id": 88074,
    "vorder": 114,
    "position": 1,
    "text": "خروش از دو رویه برانگیختند"
  },
  {
    "poem_id": 88074,
    "vorder": 115,
    "position": 0,
    "text": "سواران ترکان به کردار بید"
  },
  {
    "poem_id": 88074,
    "vorder": 116,
    "position": 1,
    "text": "شده لرزلرزان و دل ناامید"
  },
  {
    "poem_id": 88074,
    "vorder": 117,
    "position": 0,
    "text": "به رستم بفرمود پس شهریار"
  },
  {
    "poem_id": 88074,
    "vorder": 118,
    "position": 1,
    "text": "پیاده هر آن کس که بد نامدار"
  },
  {
    "poem_id": 88074,
    "vorder": 119,
    "position": 0,
    "text": "که پیش اندر آید بدان رخنه گاه"
  },
  {
    "poem_id": 88074,
    "vorder": 120,
    "position": 1,
    "text": "همیدون بسی نیزه‌ور کینه‌خواه"
  },
  {
    "poem_id": 88074,
    "vorder": 121,
    "position": 0,
    "text": "ابا ترکش و تیغ و تیر و تبر"
  },
  {
    "poem_id": 88074,
    "vorder": 122,
    "position": 1,
    "text": "سوار ایستاده پس نیزه‌ور"
  },
  {
    "poem_id": 88074,
    "vorder": 123,
    "position": 0,
    "text": "سواران جنگی نگهدارشان"
  },
  {
    "poem_id": 88074,
    "vorder": 124,
    "position": 1,
    "text": "بدانگه که شد سخت پیکارشان"
  },
  {
    "poem_id": 88074,
    "vorder": 125,
    "position": 0,
    "text": "سوار و پیاده به هر سو گروه"
  },
  {
    "poem_id": 88074,
    "vorder": 126,
    "position": 1,
    "text": "به جنگ اندر آمد به کردار کوه"
  },
  {
    "poem_id": 88074,
    "vorder": 127,
    "position": 0,
    "text": "به رخنه در آورد یکسر سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 128,
    "position": 1,
    "text": "چو شیر ژیان رستم کینه‌خواه"
  },
  {
    "poem_id": 88074,
    "vorder": 129,
    "position": 0,
    "text": "پیاده بیامد به کردار گرد"
  },
  {
    "poem_id": 88074,
    "vorder": 130,
    "position": 1,
    "text": "درفش سیه را نگون‌سار کرد"
  },
  {
    "poem_id": 88074,
    "vorder": 131,
    "position": 0,
    "text": "نشان سپهدار ایران بنفش"
  },
  {
    "poem_id": 88074,
    "vorder": 132,
    "position": 1,
    "text": "بر آن باره زد شیر پیکر درفش"
  },
  {
    "poem_id": 88074,
    "vorder": 133,
    "position": 0,
    "text": "به پیروزی شاه ایران سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 134,
    "position": 1,
    "text": "برآمد خروشیدن از رزمگاه"
  },
  {
    "poem_id": 88074,
    "vorder": 135,
    "position": 0,
    "text": "فراوان ز توران سپه کشته شد"
  },
  {
    "poem_id": 88074,
    "vorder": 136,
    "position": 1,
    "text": "سر بخت تورانیان گشته شد"
  },
  {
    "poem_id": 88074,
    "vorder": 137,
    "position": 0,
    "text": "بدانگه کجا رزمشان شد درشت"
  },
  {
    "poem_id": 88074,
    "vorder": 138,
    "position": 1,
    "text": "دو تن رستم آورد از ایشان به مشت"
  },
  {
    "poem_id": 88074,
    "vorder": 139,
    "position": 0,
    "text": "چو گرسیوز و جهن رزم آزمای"
  },
  {
    "poem_id": 88074,
    "vorder": 140,
    "position": 1,
    "text": "که بد تخت توران بدیشان به پای"
  },
  {
    "poem_id": 88074,
    "vorder": 141,
    "position": 0,
    "text": "برادر یکی بود و فرخ پسر"
  },
  {
    "poem_id": 88074,
    "vorder": 142,
    "position": 1,
    "text": "چنین آمد از شوربختی به سر"
  },
  {
    "poem_id": 88074,
    "vorder": 143,
    "position": 0,
    "text": "بدان شارستان اندر آمد سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 144,
    "position": 1,
    "text": "چنان داغ‌دل لشکری کینه‌خواه"
  },
  {
    "poem_id": 88074,
    "vorder": 145,
    "position": 0,
    "text": "به تاراج و کشتن نهادند روی"
  },
  {
    "poem_id": 88074,
    "vorder": 146,
    "position": 1,
    "text": "برآمد خروشیدن های هوی"
  },
  {
    "poem_id": 88074,
    "vorder": 147,
    "position": 0,
    "text": "زن و کودکان بانگ برداشتند"
  },
  {
    "poem_id": 88074,
    "vorder": 148,
    "position": 1,
    "text": "به ایرانیان جای بگذاشتند"
  },
  {
    "poem_id": 88074,
    "vorder": 149,
    "position": 0,
    "text": "چه مایه زن و کودک نارسید"
  },
  {
    "poem_id": 88074,
    "vorder": 150,
    "position": 1,
    "text": "که زیر پی پیل شد ناپدید"
  },
  {
    "poem_id": 88074,
    "vorder": 151,
    "position": 0,
    "text": "همه شهر توران گریزان چو باد"
  },
  {
    "poem_id": 88074,
    "vorder": 152,
    "position": 1,
    "text": "نیامد کسی را بر و بوم یاد"
  },
  {
    "poem_id": 88074,
    "vorder": 153,
    "position": 0,
    "text": "بشد بخت گردان ترکان نگون"
  },
  {
    "poem_id": 88074,
    "vorder": 154,
    "position": 1,
    "text": "به زاری همه دیدگان پر ز خون"
  },
  {
    "poem_id": 88074,
    "vorder": 155,
    "position": 0,
    "text": "زن و گنج و فرزند گشته اسیر"
  },
  {
    "poem_id": 88074,
    "vorder": 156,
    "position": 1,
    "text": "ز گردون روان خسته و تن به تیر"
  },
  {
    "poem_id": 88074,
    "vorder": 157,
    "position": 0,
    "text": "به ایوان برآمد پس افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 158,
    "position": 1,
    "text": "پر از خون دل از درد و دیده پرآب"
  },
  {
    "poem_id": 88074,
    "vorder": 159,
    "position": 0,
    "text": "بر آن باره بر شد که بد کاخ اوی"
  },
  {
    "poem_id": 88074,
    "vorder": 160,
    "position": 1,
    "text": "بیامد سوی شارستان کرد روی"
  },
  {
    "poem_id": 88074,
    "vorder": 161,
    "position": 0,
    "text": "دو بهره ز جنگاوران کشته دید"
  },
  {
    "poem_id": 88074,
    "vorder": 162,
    "position": 1,
    "text": "دگر یکسر از جنگ برگشته دید"
  },
  {
    "poem_id": 88074,
    "vorder": 163,
    "position": 0,
    "text": "خروش سواران و بانگ زنان"
  },
  {
    "poem_id": 88074,
    "vorder": 164,
    "position": 1,
    "text": "هم از پشت پیلان تبیره زنان"
  },
  {
    "poem_id": 88074,
    "vorder": 165,
    "position": 0,
    "text": "همی پیل بر زندگان راندند"
  },
  {
    "poem_id": 88074,
    "vorder": 166,
    "position": 1,
    "text": "همی پشتشان بر زمین ماندند"
  },
  {
    "poem_id": 88074,
    "vorder": 167,
    "position": 0,
    "text": "همه شارستان دود و فریاد دید"
  },
  {
    "poem_id": 88074,
    "vorder": 168,
    "position": 1,
    "text": "همان کشتن و غارت و باد دید"
  },
  {
    "poem_id": 88074,
    "vorder": 169,
    "position": 0,
    "text": "یکی شاد و دیگر پر از درد و رنج"
  },
  {
    "poem_id": 88074,
    "vorder": 170,
    "position": 1,
    "text": "چنانچون بود رسم و رای سپنج"
  },
  {
    "poem_id": 88074,
    "vorder": 171,
    "position": 0,
    "text": "چو افراسیاب آنچنان دید کار"
  },
  {
    "poem_id": 88074,
    "vorder": 172,
    "position": 1,
    "text": "چنان هول و برگشتن کارزار"
  },
  {
    "poem_id": 88074,
    "vorder": 173,
    "position": 0,
    "text": "نه پور و برادر نه بوم و نه بر"
  },
  {
    "poem_id": 88074,
    "vorder": 174,
    "position": 1,
    "text": "نه تاج و نه گنج و نه تخت و کمر"
  },
  {
    "poem_id": 88074,
    "vorder": 175,
    "position": 0,
    "text": "همی گفت با دل پر از داغ و درد"
  },
  {
    "poem_id": 88074,
    "vorder": 176,
    "position": 1,
    "text": "که چرخ فلک خیره با من چه کرد"
  },
  {
    "poem_id": 88074,
    "vorder": 177,
    "position": 0,
    "text": "به دیده بدیدم همان روزگار"
  },
  {
    "poem_id": 88074,
    "vorder": 178,
    "position": 1,
    "text": "که آمد مرا کشتن و مرگ خوار"
  },
  {
    "poem_id": 88074,
    "vorder": 179,
    "position": 0,
    "text": "پر از درد از آن باره آمد فرود"
  },
  {
    "poem_id": 88074,
    "vorder": 180,
    "position": 1,
    "text": "همی داد تخت مهی را درود"
  },
  {
    "poem_id": 88074,
    "vorder": 181,
    "position": 0,
    "text": "همی گفت کی بینمت نیز باز"
  },
  {
    "poem_id": 88074,
    "vorder": 182,
    "position": 1,
    "text": "ایا روز شادی و آرام و ناز"
  },
  {
    "poem_id": 88074,
    "vorder": 183,
    "position": 0,
    "text": "وز آن جایگه خیره شد ناپدید"
  },
  {
    "poem_id": 88074,
    "vorder": 184,
    "position": 1,
    "text": "تو گفتی چو مرغان همی بر پرید"
  },
  {
    "poem_id": 88074,
    "vorder": 185,
    "position": 0,
    "text": "در ایوان که در دژ برآورده بود"
  },
  {
    "poem_id": 88074,
    "vorder": 186,
    "position": 1,
    "text": "یکی راه زیر زمین کرده بود"
  },
  {
    "poem_id": 88074,
    "vorder": 187,
    "position": 0,
    "text": "از آن نامداران دو صد برگزید"
  },
  {
    "poem_id": 88074,
    "vorder": 188,
    "position": 1,
    "text": "بر آن راه بی‌راه شد ناپدید"
  },
  {
    "poem_id": 88074,
    "vorder": 189,
    "position": 0,
    "text": "وزآنجای راه بیابان گرفت"
  },
  {
    "poem_id": 88074,
    "vorder": 190,
    "position": 1,
    "text": "همه کشورش ماند اندر شگفت"
  },
  {
    "poem_id": 88074,
    "vorder": 191,
    "position": 0,
    "text": "نشانی ندادش کس اندر جهان"
  },
  {
    "poem_id": 88074,
    "vorder": 192,
    "position": 1,
    "text": "بدان گونه آواره شد در نهان"
  },
  {
    "poem_id": 88074,
    "vorder": 193,
    "position": 0,
    "text": "چو کیخسرو آمد در ایوان اوی"
  },
  {
    "poem_id": 88074,
    "vorder": 194,
    "position": 1,
    "text": "به پای اندر آورد کیوان اوی"
  },
  {
    "poem_id": 88074,
    "vorder": 195,
    "position": 0,
    "text": "ابر تخت زرینش بنشست شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 196,
    "position": 1,
    "text": "بجستنش بر کرد هر سو سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 197,
    "position": 0,
    "text": "فراوان بجستند جایی نشان"
  },
  {
    "poem_id": 88074,
    "vorder": 198,
    "position": 1,
    "text": "نیامد ز سالار گردنکشان"
  },
  {
    "poem_id": 88074,
    "vorder": 199,
    "position": 0,
    "text": "ز گرسیوز و جهن پرسید شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 200,
    "position": 1,
    "text": "ز کار سپهدار توران سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 201,
    "position": 0,
    "text": "که چون رفت و آرامگاهش کجاست"
  },
  {
    "poem_id": 88074,
    "vorder": 202,
    "position": 1,
    "text": "نهان گشته ز ایدر پناهش کجاست"
  },
  {
    "poem_id": 88074,
    "vorder": 203,
    "position": 0,
    "text": "ز هر گونه گفتند و خسرو شنید"
  },
  {
    "poem_id": 88074,
    "vorder": 204,
    "position": 1,
    "text": "نیامد همی روشنایی پدید"
  },
  {
    "poem_id": 88074,
    "vorder": 205,
    "position": 0,
    "text": "به ایرانیان گفت پیروز شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 206,
    "position": 1,
    "text": "که دشمن چو آواره گردد ز گاه"
  },
  {
    "poem_id": 88074,
    "vorder": 207,
    "position": 0,
    "text": "ز گیتی بر او نام و کام اندکیست"
  },
  {
    "poem_id": 88074,
    "vorder": 208,
    "position": 1,
    "text": "ورا مرگ با زندگانی یکیست"
  },
  {
    "poem_id": 88074,
    "vorder": 209,
    "position": 0,
    "text": "ز لشکر گزین کرد پس بخردان"
  },
  {
    "poem_id": 88074,
    "vorder": 210,
    "position": 1,
    "text": "جهاندیده و کاربین موبدان"
  },
  {
    "poem_id": 88074,
    "vorder": 211,
    "position": 0,
    "text": "بدیشان چنین گفت کآباد بید"
  },
  {
    "poem_id": 88074,
    "vorder": 212,
    "position": 1,
    "text": "همیشه به هر کار با داد بید"
  },
  {
    "poem_id": 88074,
    "vorder": 213,
    "position": 0,
    "text": "در گنج این ترک شوریده بخت"
  },
  {
    "poem_id": 88074,
    "vorder": 214,
    "position": 1,
    "text": "شما را سپردم بکوشید سخت"
  },
  {
    "poem_id": 88074,
    "vorder": 215,
    "position": 0,
    "text": "نباید که بر کاخ افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 216,
    "position": 1,
    "text": "بتابد ز چرخ بلند آفتاب"
  },
  {
    "poem_id": 88074,
    "vorder": 217,
    "position": 0,
    "text": "هم آواز پوشیده‌رویان اوی"
  },
  {
    "poem_id": 88074,
    "vorder": 218,
    "position": 1,
    "text": "نخواهم که آید ز ایوان به کوی"
  },
  {
    "poem_id": 88074,
    "vorder": 219,
    "position": 0,
    "text": "نگهبان فرستاد سوی گله"
  },
  {
    "poem_id": 88074,
    "vorder": 220,
    "position": 1,
    "text": "که بودند گرد دژ اندر یله"
  },
  {
    "poem_id": 88074,
    "vorder": 221,
    "position": 0,
    "text": "ز خویشان او کس نیازرد شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 222,
    "position": 1,
    "text": "چنانچون بود در خور پیشگاه"
  },
  {
    "poem_id": 88074,
    "vorder": 223,
    "position": 0,
    "text": "چو زان گونه دیدند کردار اوی"
  },
  {
    "poem_id": 88074,
    "vorder": 224,
    "position": 1,
    "text": "سپه شد سراسر پر از گفت و گوی"
  },
  {
    "poem_id": 88074,
    "vorder": 225,
    "position": 0,
    "text": "که کیخسرو ایدر بدان سان شدست"
  },
  {
    "poem_id": 88074,
    "vorder": 226,
    "position": 1,
    "text": "که گویی سوی باب مهمان شدست"
  },
  {
    "poem_id": 88074,
    "vorder": 227,
    "position": 0,
    "text": "همی یاد نایدش خون پدر"
  },
  {
    "poem_id": 88074,
    "vorder": 228,
    "position": 1,
    "text": "به خیره بریده به بیداد سر"
  },
  {
    "poem_id": 88074,
    "vorder": 229,
    "position": 0,
    "text": "همان مادرش را که از تخت و گاه"
  },
  {
    "poem_id": 88074,
    "vorder": 230,
    "position": 1,
    "text": "ز پرده کشیدند یکسو به راه"
  },
  {
    "poem_id": 88074,
    "vorder": 231,
    "position": 0,
    "text": "شبان پروریدست وز گوسفند"
  },
  {
    "poem_id": 88074,
    "vorder": 232,
    "position": 1,
    "text": "مزیدست شیر این شه هوشمند"
  },
  {
    "poem_id": 88074,
    "vorder": 233,
    "position": 0,
    "text": "چرا چون پلنگان به چنگال تیز"
  },
  {
    "poem_id": 88074,
    "vorder": 234,
    "position": 1,
    "text": "نه انگیزد از خان او رستخیز"
  },
  {
    "poem_id": 88074,
    "vorder": 235,
    "position": 0,
    "text": "فرود آورد کاخ و ایوان اوی"
  },
  {
    "poem_id": 88074,
    "vorder": 236,
    "position": 1,
    "text": "برانگیزد آتش ز کیوان اوی"
  },
  {
    "poem_id": 88074,
    "vorder": 237,
    "position": 0,
    "text": "ز گفتار ایرانیان پس خبر"
  },
  {
    "poem_id": 88074,
    "vorder": 238,
    "position": 1,
    "text": "به کیخسرو آمد همه در به در"
  },
  {
    "poem_id": 88074,
    "vorder": 239,
    "position": 0,
    "text": "فرستاد کس بخردان را بخواند"
  },
  {
    "poem_id": 88074,
    "vorder": 240,
    "position": 1,
    "text": "بسی داستان پیش ایشان براند"
  },
  {
    "poem_id": 88074,
    "vorder": 241,
    "position": 0,
    "text": "که هر جای تندی نباید نمود"
  },
  {
    "poem_id": 88074,
    "vorder": 242,
    "position": 1,
    "text": "سر بی‌خرد را نشاید ستود"
  },
  {
    "poem_id": 88074,
    "vorder": 243,
    "position": 0,
    "text": "همان به که با کینه داد آوریم"
  },
  {
    "poem_id": 88074,
    "vorder": 244,
    "position": 1,
    "text": "به کام اندرون نام یاد آوریم"
  },
  {
    "poem_id": 88074,
    "vorder": 245,
    "position": 0,
    "text": "که نیکیست اندر جهان یادگار"
  },
  {
    "poem_id": 88074,
    "vorder": 246,
    "position": 1,
    "text": "نماند به کس جاودان روزگار"
  },
  {
    "poem_id": 88074,
    "vorder": 247,
    "position": 0,
    "text": "همین چرخ گردنده با هر کسی"
  },
  {
    "poem_id": 88074,
    "vorder": 248,
    "position": 1,
    "text": "تواند جفا گستریدن بسی"
  },
  {
    "poem_id": 88074,
    "vorder": 249,
    "position": 0,
    "text": "از آن پس بفرمود شاه جهان"
  },
  {
    "poem_id": 88074,
    "vorder": 250,
    "position": 1,
    "text": "که آرند پوشیدگان را نهان"
  },
  {
    "poem_id": 88074,
    "vorder": 251,
    "position": 0,
    "text": "چو ایرانیان آگهی یافتند"
  },
  {
    "poem_id": 88074,
    "vorder": 252,
    "position": 1,
    "text": "پر از کین سوی کاخ بشتافتند"
  },
  {
    "poem_id": 88074,
    "vorder": 253,
    "position": 0,
    "text": "بر آن گونه بردند گردان گمان"
  },
  {
    "poem_id": 88074,
    "vorder": 254,
    "position": 1,
    "text": "که خسرو سرآرد بر ایشان زمان"
  },
  {
    "poem_id": 88074,
    "vorder": 255,
    "position": 0,
    "text": "به خواری همی نزدشان خواستند"
  },
  {
    "poem_id": 88074,
    "vorder": 256,
    "position": 1,
    "text": "به تاراج و کشتن بیاراستند"
  },
  {
    "poem_id": 88074,
    "vorder": 257,
    "position": 0,
    "text": "ز ایوان به زاری برآمد خروش"
  },
  {
    "poem_id": 88074,
    "vorder": 258,
    "position": 1,
    "text": "که ای دادگر شاه بسیار هوش"
  },
  {
    "poem_id": 88074,
    "vorder": 259,
    "position": 0,
    "text": "تو دانی که ما سخت بیچاره‌ایم"
  },
  {
    "poem_id": 88074,
    "vorder": 260,
    "position": 1,
    "text": "نه بر جای خواری و پیغاره‌ایم"
  },
  {
    "poem_id": 88074,
    "vorder": 261,
    "position": 0,
    "text": "بر شاه شد مهتر بانوان"
  },
  {
    "poem_id": 88074,
    "vorder": 262,
    "position": 1,
    "text": "ابا دختران اندر آمد نوان"
  },
  {
    "poem_id": 88074,
    "vorder": 263,
    "position": 0,
    "text": "پرستنده صد پیش هر دختری"
  },
  {
    "poem_id": 88074,
    "vorder": 264,
    "position": 1,
    "text": "ز یاقوت بر هر سری افسری"
  },
  {
    "poem_id": 88074,
    "vorder": 265,
    "position": 0,
    "text": "چو خورشید تابان از ایشان گهر"
  },
  {
    "poem_id": 88074,
    "vorder": 266,
    "position": 1,
    "text": "به پیش اندر افگنده از شرم سر"
  },
  {
    "poem_id": 88074,
    "vorder": 267,
    "position": 0,
    "text": "به یک دست مجمر به یک دست جام"
  },
  {
    "poem_id": 88074,
    "vorder": 268,
    "position": 1,
    "text": "برافروخته عنبر و عود خام"
  },
  {
    "poem_id": 88074,
    "vorder": 269,
    "position": 0,
    "text": "تو گفتی که کیوان ز چرخ برین"
  },
  {
    "poem_id": 88074,
    "vorder": 270,
    "position": 1,
    "text": "ستاره فشاند همی بر زمین"
  },
  {
    "poem_id": 88074,
    "vorder": 271,
    "position": 0,
    "text": "مه بانوان شد به نزدیک تخت"
  },
  {
    "poem_id": 88074,
    "vorder": 272,
    "position": 1,
    "text": "ابر شهریار آفرین کرد سخت"
  },
  {
    "poem_id": 88074,
    "vorder": 273,
    "position": 0,
    "text": "همان پروریده بتان طراز"
  },
  {
    "poem_id": 88074,
    "vorder": 274,
    "position": 1,
    "text": "بر این گونه بردند پیشش نماز"
  },
  {
    "poem_id": 88074,
    "vorder": 275,
    "position": 0,
    "text": "همه یکسره زار بگریستند"
  },
  {
    "poem_id": 88074,
    "vorder": 276,
    "position": 1,
    "text": "بدان شوربختی همی زیستند"
  },
  {
    "poem_id": 88074,
    "vorder": 277,
    "position": 0,
    "text": "کسی کو ندیدست جز کام و ناز"
  },
  {
    "poem_id": 88074,
    "vorder": 278,
    "position": 1,
    "text": "بر او بر ببخشای روز نیاز"
  },
  {
    "poem_id": 88074,
    "vorder": 279,
    "position": 0,
    "text": "همی خواندند آفرینی به درد"
  },
  {
    "poem_id": 88074,
    "vorder": 280,
    "position": 1,
    "text": "که ای نیک‌دل خسرو رادمرد"
  },
  {
    "poem_id": 88074,
    "vorder": 281,
    "position": 0,
    "text": "چه نیکو بدی گر ز توران زمین"
  },
  {
    "poem_id": 88074,
    "vorder": 282,
    "position": 1,
    "text": "نبودی به دلت اندرون ایچ کین"
  },
  {
    "poem_id": 88074,
    "vorder": 283,
    "position": 0,
    "text": "تو ایدر به جشن و خرام آمدی"
  },
  {
    "poem_id": 88074,
    "vorder": 284,
    "position": 1,
    "text": "ز شاهان درود و پیام آمدی"
  },
  {
    "poem_id": 88074,
    "vorder": 285,
    "position": 0,
    "text": "بر این بوم و بر نیست خود کدخدای"
  },
  {
    "poem_id": 88074,
    "vorder": 286,
    "position": 1,
    "text": "به تخت نیا بر نهادی تو پای"
  },
  {
    "poem_id": 88074,
    "vorder": 287,
    "position": 0,
    "text": "سیاوش نگشتی به خیره تباه"
  },
  {
    "poem_id": 88074,
    "vorder": 288,
    "position": 1,
    "text": "ولیکن چنین گشت خورشید و ماه"
  },
  {
    "poem_id": 88074,
    "vorder": 289,
    "position": 0,
    "text": "چنان کرد بدگوهر افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 290,
    "position": 1,
    "text": "که پیش تو پوزش نبیند به خواب"
  },
  {
    "poem_id": 88074,
    "vorder": 291,
    "position": 0,
    "text": "بسی دادمش پند و سودی نداشت"
  },
  {
    "poem_id": 88074,
    "vorder": 292,
    "position": 1,
    "text": "به خیره همی سر ز پندم بگاشت"
  },
  {
    "poem_id": 88074,
    "vorder": 293,
    "position": 0,
    "text": "گوای منست آفریننده‌ام"
  },
  {
    "poem_id": 88074,
    "vorder": 294,
    "position": 1,
    "text": "که بارید خون از دو بیننده‌ام"
  },
  {
    "poem_id": 88074,
    "vorder": 295,
    "position": 0,
    "text": "چو گرسیوز و جهن پیوند تو"
  },
  {
    "poem_id": 88074,
    "vorder": 296,
    "position": 1,
    "text": "که ساید به زاری کنون بند تو"
  },
  {
    "poem_id": 88074,
    "vorder": 297,
    "position": 0,
    "text": "ز بهر سیاوش که در خان من"
  },
  {
    "poem_id": 88074,
    "vorder": 298,
    "position": 1,
    "text": "چه تیمار بد بر دل و جان من"
  },
  {
    "poem_id": 88074,
    "vorder": 299,
    "position": 0,
    "text": "که افراسیاب آن بداندیش مرد"
  },
  {
    "poem_id": 88074,
    "vorder": 300,
    "position": 1,
    "text": "بسی پند بشنید و سودش نکرد"
  },
  {
    "poem_id": 88074,
    "vorder": 301,
    "position": 0,
    "text": "بدان تا چنین روزش آید به سر"
  },
  {
    "poem_id": 88074,
    "vorder": 302,
    "position": 1,
    "text": "شود پادشاهیش زیر و زبر"
  },
  {
    "poem_id": 88074,
    "vorder": 303,
    "position": 0,
    "text": "به تاراج داده کلاه و کمر"
  },
  {
    "poem_id": 88074,
    "vorder": 304,
    "position": 1,
    "text": "شده روز او تار و برگشته سر"
  },
  {
    "poem_id": 88074,
    "vorder": 305,
    "position": 0,
    "text": "چنین زندگانی همی مرگ اوست"
  },
  {
    "poem_id": 88074,
    "vorder": 306,
    "position": 1,
    "text": "شگفت آن که بر تن ندردش پوست"
  },
  {
    "poem_id": 88074,
    "vorder": 307,
    "position": 0,
    "text": "کنون از پی بیگناهان به ما"
  },
  {
    "poem_id": 88074,
    "vorder": 308,
    "position": 1,
    "text": "نگه کن بر آیین شاهان به ما"
  },
  {
    "poem_id": 88074,
    "vorder": 309,
    "position": 0,
    "text": "همه پاک پیوستهٔ خسرویم"
  },
  {
    "poem_id": 88074,
    "vorder": 310,
    "position": 1,
    "text": "جز از نام او در جهان نشنویم"
  },
  {
    "poem_id": 88074,
    "vorder": 311,
    "position": 0,
    "text": "به بد کردن جادو افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 312,
    "position": 1,
    "text": "نگیرد بر این بیگناهان شتاب"
  },
  {
    "poem_id": 88074,
    "vorder": 313,
    "position": 0,
    "text": "به خواری و زخم و به خون ریختن"
  },
  {
    "poem_id": 88074,
    "vorder": 314,
    "position": 1,
    "text": "چه بر بی‌گنه خیره آویختن"
  },
  {
    "poem_id": 88074,
    "vorder": 315,
    "position": 0,
    "text": "که از شهریاران سزاوار نیست"
  },
  {
    "poem_id": 88074,
    "vorder": 316,
    "position": 1,
    "text": "بریدن سری کان گنهکار نیست"
  },
  {
    "poem_id": 88074,
    "vorder": 317,
    "position": 0,
    "text": "ترا شهریارا جز اینست جای"
  },
  {
    "poem_id": 88074,
    "vorder": 318,
    "position": 1,
    "text": "نماند کسی در سپنجی سرای"
  },
  {
    "poem_id": 88074,
    "vorder": 319,
    "position": 0,
    "text": "هم آن کن که پرسد ز تو کردگار"
  },
  {
    "poem_id": 88074,
    "vorder": 320,
    "position": 1,
    "text": "نپیچی از آن شرم روز شمار"
  },
  {
    "poem_id": 88074,
    "vorder": 321,
    "position": 0,
    "text": "چو بشنید خسرو ببخشود سخت"
  },
  {
    "poem_id": 88074,
    "vorder": 322,
    "position": 1,
    "text": "بر آن خوبرویان برگشته بخت"
  },
  {
    "poem_id": 88074,
    "vorder": 323,
    "position": 0,
    "text": "که پوشیده‌رویان از آن درد و داغ"
  },
  {
    "poem_id": 88074,
    "vorder": 324,
    "position": 1,
    "text": "شده لعل رخسارشان چون چراغ"
  },
  {
    "poem_id": 88074,
    "vorder": 325,
    "position": 0,
    "text": "بپیچید دل بخردان را ز درد"
  },
  {
    "poem_id": 88074,
    "vorder": 326,
    "position": 1,
    "text": "ز فرزند و زن هر کسی یاد کرد"
  },
  {
    "poem_id": 88074,
    "vorder": 327,
    "position": 0,
    "text": "همی خواندند آفرینی بزرگ"
  },
  {
    "poem_id": 88074,
    "vorder": 328,
    "position": 1,
    "text": "سران سپه مهتران سترگ"
  },
  {
    "poem_id": 88074,
    "vorder": 329,
    "position": 0,
    "text": "کز ایشان شه نامبردار کین"
  },
  {
    "poem_id": 88074,
    "vorder": 330,
    "position": 1,
    "text": "نخواهد ز بهر جهان آفرین"
  },
  {
    "poem_id": 88074,
    "vorder": 331,
    "position": 0,
    "text": "چنین گفت کیخسرو هوشمند"
  },
  {
    "poem_id": 88074,
    "vorder": 332,
    "position": 1,
    "text": "که هر چیز کان نیست ما را پسند"
  },
  {
    "poem_id": 88074,
    "vorder": 333,
    "position": 0,
    "text": "نیاریم کس را همان بد به روی"
  },
  {
    "poem_id": 88074,
    "vorder": 334,
    "position": 1,
    "text": "وگر چند باشد جگر کینه‌جوی"
  },
  {
    "poem_id": 88074,
    "vorder": 335,
    "position": 0,
    "text": "چو از کار آن نامدار بلند"
  },
  {
    "poem_id": 88074,
    "vorder": 336,
    "position": 1,
    "text": "براندیشم اینم نیاید پسند"
  },
  {
    "poem_id": 88074,
    "vorder": 337,
    "position": 0,
    "text": "که بد کرد با پرهنر مادرم"
  },
  {
    "poem_id": 88074,
    "vorder": 338,
    "position": 1,
    "text": "کسی را همان بد به سر ناورم"
  },
  {
    "poem_id": 88074,
    "vorder": 339,
    "position": 0,
    "text": "بفرمودشان بازگشتن به جای"
  },
  {
    "poem_id": 88074,
    "vorder": 340,
    "position": 1,
    "text": "چنان پاک‌زاده جهان کدخدای"
  },
  {
    "poem_id": 88074,
    "vorder": 341,
    "position": 0,
    "text": "بدیشان چنین گفت کایمن شوید"
  },
  {
    "poem_id": 88074,
    "vorder": 342,
    "position": 1,
    "text": "ز گوینده گفتار بد مشنوید"
  },
  {
    "poem_id": 88074,
    "vorder": 343,
    "position": 0,
    "text": "کز این پس شما را ز من بیم نیست"
  },
  {
    "poem_id": 88074,
    "vorder": 344,
    "position": 1,
    "text": "مرا بی‌وفایی و دژخیم نیست"
  },
  {
    "poem_id": 88074,
    "vorder": 345,
    "position": 0,
    "text": "تن خویش را بد نخواهد کسی"
  },
  {
    "poem_id": 88074,
    "vorder": 346,
    "position": 1,
    "text": "چو خواهد زمانش نباشد بسی"
  },
  {
    "poem_id": 88074,
    "vorder": 347,
    "position": 0,
    "text": "بباشید ایمن به ایوان خویش"
  },
  {
    "poem_id": 88074,
    "vorder": 348,
    "position": 1,
    "text": "به یزدان سپرده تن و جان خویش"
  },
  {
    "poem_id": 88074,
    "vorder": 349,
    "position": 0,
    "text": "به ایرانیان گفت پیروزبخت"
  },
  {
    "poem_id": 88074,
    "vorder": 350,
    "position": 1,
    "text": "بماناد تا جاودان تاج و تخت"
  },
  {
    "poem_id": 88074,
    "vorder": 351,
    "position": 0,
    "text": "همه شهر توران گرفته به دست"
  },
  {
    "poem_id": 88074,
    "vorder": 352,
    "position": 1,
    "text": "به ایران شما را سرای و نشست"
  },
  {
    "poem_id": 88074,
    "vorder": 353,
    "position": 0,
    "text": "ز دلها همه کینه بیرون کنید"
  },
  {
    "poem_id": 88074,
    "vorder": 354,
    "position": 1,
    "text": "به مهر اندر این کشور افسون کنید"
  },
  {
    "poem_id": 88074,
    "vorder": 355,
    "position": 0,
    "text": "که از ما چنین دردشان در دلست"
  },
  {
    "poem_id": 88074,
    "vorder": 356,
    "position": 1,
    "text": "ز خون ریختن گرد کشور گلست"
  },
  {
    "poem_id": 88074,
    "vorder": 357,
    "position": 0,
    "text": "همه گنج توران شما را دهم"
  },
  {
    "poem_id": 88074,
    "vorder": 358,
    "position": 1,
    "text": "بر آن گنج دادن سپاهی نهم"
  },
  {
    "poem_id": 88074,
    "vorder": 359,
    "position": 0,
    "text": "بکوشید و خوبی به کار آورید"
  },
  {
    "poem_id": 88074,
    "vorder": 360,
    "position": 1,
    "text": "چو دیدند سرما بهار آورید"
  },
  {
    "poem_id": 88074,
    "vorder": 361,
    "position": 0,
    "text": "من ایرانیان را یکایک نه دیر"
  },
  {
    "poem_id": 88074,
    "vorder": 362,
    "position": 1,
    "text": "کنم یکسر از گنج دینار سیر"
  },
  {
    "poem_id": 88074,
    "vorder": 363,
    "position": 0,
    "text": "ز خون ریختن دل بباید کشید"
  },
  {
    "poem_id": 88074,
    "vorder": 364,
    "position": 1,
    "text": "سر بیگناهان نباید برید"
  },
  {
    "poem_id": 88074,
    "vorder": 365,
    "position": 0,
    "text": "نه مردی بود خیره آشوفتن"
  },
  {
    "poem_id": 88074,
    "vorder": 366,
    "position": 1,
    "text": "به زیر اندر آورده را کوفتن"
  },
  {
    "poem_id": 88074,
    "vorder": 367,
    "position": 0,
    "text": "ز پوشیده‌رویان بپیچید روی"
  },
  {
    "poem_id": 88074,
    "vorder": 368,
    "position": 1,
    "text": "هر آن کس که پوشیده دارد به کوی"
  },
  {
    "poem_id": 88074,
    "vorder": 369,
    "position": 0,
    "text": "ز چیز کسان سر بتابید نیز"
  },
  {
    "poem_id": 88074,
    "vorder": 370,
    "position": 1,
    "text": "که دشمن شود دوست از بهر چیز"
  },
  {
    "poem_id": 88074,
    "vorder": 371,
    "position": 0,
    "text": "نیاید جهان‌آفرین را پسند"
  },
  {
    "poem_id": 88074,
    "vorder": 372,
    "position": 1,
    "text": "که جوینده بر بیگناهان گزند"
  },
  {
    "poem_id": 88074,
    "vorder": 373,
    "position": 0,
    "text": "هر آن کس که جوید همی رای من"
  },
  {
    "poem_id": 88074,
    "vorder": 374,
    "position": 1,
    "text": "نباید که ویران کند جای من"
  },
  {
    "poem_id": 88074,
    "vorder": 375,
    "position": 0,
    "text": "و دیگر که خوانند بیداد و شوم"
  },
  {
    "poem_id": 88074,
    "vorder": 376,
    "position": 1,
    "text": "که ویران کند مهتر آباد بوم"
  },
  {
    "poem_id": 88074,
    "vorder": 377,
    "position": 0,
    "text": "از آن پس به لشکر بفرمود شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 378,
    "position": 1,
    "text": "گشادن در گنج توران سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 379,
    "position": 0,
    "text": "جز از گنج ویژه رد افراسیاب"
  },
  {
    "poem_id": 88074,
    "vorder": 380,
    "position": 1,
    "text": "که کس را نبود اندر آن دست یاب"
  },
  {
    "poem_id": 88074,
    "vorder": 381,
    "position": 0,
    "text": "ببخشید دیگر همه بر سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 382,
    "position": 1,
    "text": "چه گنج سلیح و چه تخت و کلاه"
  },
  {
    "poem_id": 88074,
    "vorder": 383,
    "position": 0,
    "text": "ز هر سو پراگنده بی مر سپاه"
  },
  {
    "poem_id": 88074,
    "vorder": 384,
    "position": 1,
    "text": "ز ترکان بیامد به نزدیک شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 385,
    "position": 0,
    "text": "همی داد زنهار و بنواختشان"
  },
  {
    "poem_id": 88074,
    "vorder": 386,
    "position": 1,
    "text": "به زودی همی کار بر ساختشان"
  },
  {
    "poem_id": 88074,
    "vorder": 387,
    "position": 0,
    "text": "سران را ز توران زمین بهر داد"
  },
  {
    "poem_id": 88074,
    "vorder": 388,
    "position": 1,
    "text": "به هر نامداری یکی شهر داد"
  },
  {
    "poem_id": 88074,
    "vorder": 389,
    "position": 0,
    "text": "به هر کشوری هر که فرمان نبرد"
  },
  {
    "poem_id": 88074,
    "vorder": 390,
    "position": 1,
    "text": "ز دست دلیران او جان نبرد"
  },
  {
    "poem_id": 88074,
    "vorder": 391,
    "position": 0,
    "text": "شدند آن زمان شاه را چاکران"
  },
  {
    "poem_id": 88074,
    "vorder": 392,
    "position": 1,
    "text": "چو پیوسته شد نامهٔ مهتران"
  },
  {
    "poem_id": 88074,
    "vorder": 393,
    "position": 0,
    "text": "ز هر سو فرستادگان نزد شاه"
  },
  {
    "poem_id": 88074,
    "vorder": 394,
    "position": 1,
    "text": "یکایک سر اندر نهاده به راه"
  },
  {
    "poem_id": 88074,
    "vorder": 395,
    "position": 0,
    "text": "ابا هدیه و نامهٔ مهتران"
  },
  {
    "poem_id": 88074,
    "vorder": 396,
    "position": 1,
    "text": "شده یک به یک شاه را چاکران"
  }
]