[
  {
    "poem_id": 1343,
    "vorder": 1,
    "position": 0,
    "text": "یکی مرد بود اندر آن روزگار"
  },
  {
    "poem_id": 1343,
    "vorder": 2,
    "position": 1,
    "text": "ز دشت سواران نیزه گذار"
  },
  {
    "poem_id": 1343,
    "vorder": 3,
    "position": 0,
    "text": "گرانمایه هم شاه و هم نیک مرد"
  },
  {
    "poem_id": 1343,
    "vorder": 4,
    "position": 1,
    "text": "ز ترس جهاندار با باد سرد"
  },
  {
    "poem_id": 1343,
    "vorder": 5,
    "position": 0,
    "text": "که مرداس نام گرانمایه بود"
  },
  {
    "poem_id": 1343,
    "vorder": 6,
    "position": 1,
    "text": "به داد و دهش برترین پایه بود"
  },
  {
    "poem_id": 1343,
    "vorder": 7,
    "position": 0,
    "text": "مر او را ز دوشیدنی چارپای"
  },
  {
    "poem_id": 1343,
    "vorder": 8,
    "position": 1,
    "text": "ز هر یک هزار آمدندی به جای"
  },
  {
    "poem_id": 1343,
    "vorder": 9,
    "position": 0,
    "text": "همان گاو دوشا به فرمانبری"
  },
  {
    "poem_id": 1343,
    "vorder": 10,
    "position": 1,
    "text": "همان تازی اسب گزیده مری"
  },
  {
    "poem_id": 1343,
    "vorder": 11,
    "position": 0,
    "text": "بز و میش بد شیرور همچنین"
  },
  {
    "poem_id": 1343,
    "vorder": 12,
    "position": 1,
    "text": "به دوشیزگان داده بد پاکدین"
  },
  {
    "poem_id": 1343,
    "vorder": 13,
    "position": 0,
    "text": "به شیر آن کسی را که بودی نیاز"
  },
  {
    "poem_id": 1343,
    "vorder": 14,
    "position": 1,
    "text": "بدان خواسته دست بردی فراز"
  },
  {
    "poem_id": 1343,
    "vorder": 15,
    "position": 0,
    "text": "پسر بد مر این پاکدل را یکی"
  },
  {
    "poem_id": 1343,
    "vorder": 16,
    "position": 1,
    "text": "کش از مهر بهره نبود اندکی"
  },
  {
    "poem_id": 1343,
    "vorder": 17,
    "position": 0,
    "text": "جهانجوی را نام ضحّاک بود"
  },
  {
    "poem_id": 1343,
    "vorder": 18,
    "position": 1,
    "text": "دلیر و سبکسار و ناپاک بود"
  },
  {
    "poem_id": 1343,
    "vorder": 19,
    "position": 0,
    "text": "کجا بیور اسپش همی خواندند"
  },
  {
    "poem_id": 1343,
    "vorder": 20,
    "position": 1,
    "text": "چنین نام بر پهلوی راندند"
  },
  {
    "poem_id": 1343,
    "vorder": 21,
    "position": 0,
    "text": "کجا بیور از پهلوانی شمار"
  },
  {
    "poem_id": 1343,
    "vorder": 22,
    "position": 1,
    "text": "بود بر زبان دری ده هزار"
  },
  {
    "poem_id": 1343,
    "vorder": 23,
    "position": 0,
    "text": "ز اسپان تازی به زرین ستام"
  },
  {
    "poem_id": 1343,
    "vorder": 24,
    "position": 1,
    "text": "ورا بود بیور که بردند نام"
  },
  {
    "poem_id": 1343,
    "vorder": 25,
    "position": 0,
    "text": "شب و روز بودی دو بهره به زین"
  },
  {
    "poem_id": 1343,
    "vorder": 26,
    "position": 1,
    "text": "ز روی بزرگی نه از روی کین"
  },
  {
    "poem_id": 1343,
    "vorder": 27,
    "position": 0,
    "text": "چنان بد که ابلیس روزی پگاه"
  },
  {
    "poem_id": 1343,
    "vorder": 28,
    "position": 1,
    "text": "بیامد به سان یکی نیک‌خواه"
  },
  {
    "poem_id": 1343,
    "vorder": 29,
    "position": 0,
    "text": "دل مهتر از راه نیکی ببرد"
  },
  {
    "poem_id": 1343,
    "vorder": 30,
    "position": 1,
    "text": "جوان گوش گفتار او را سپرد"
  },
  {
    "poem_id": 1343,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت پیمانت خواهم نخست"
  },
  {
    "poem_id": 1343,
    "vorder": 32,
    "position": 1,
    "text": "پس آنگه سخن برگشایم درست"
  },
  {
    "poem_id": 1343,
    "vorder": 33,
    "position": 0,
    "text": "جوان نیک‌دل گشت فرمانش کرد"
  },
  {
    "poem_id": 1343,
    "vorder": 34,
    "position": 1,
    "text": "چنان چون بفرمود سوگند خورد"
  },
  {
    "poem_id": 1343,
    "vorder": 35,
    "position": 0,
    "text": "که راز تو با کس نگویم ز بن"
  },
  {
    "poem_id": 1343,
    "vorder": 36,
    "position": 1,
    "text": "ز تو بشنوم هر چه گویی سخن"
  },
  {
    "poem_id": 1343,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت جز تو کسی کدخدای"
  },
  {
    "poem_id": 1343,
    "vorder": 38,
    "position": 1,
    "text": "چه باید همی با تو اندر سرای"
  },
  {
    "poem_id": 1343,
    "vorder": 39,
    "position": 0,
    "text": "چه باید پدر کش پسر چون تو بود"
  },
  {
    "poem_id": 1343,
    "vorder": 40,
    "position": 1,
    "text": "یکی پندت از من بباید شنود"
  },
  {
    "poem_id": 1343,
    "vorder": 41,
    "position": 0,
    "text": "زمانه برین خواجهٔ سالخورد"
  },
  {
    "poem_id": 1343,
    "vorder": 42,
    "position": 1,
    "text": "همی دیر ماند تو اندر نورد"
  },
  {
    "poem_id": 1343,
    "vorder": 43,
    "position": 0,
    "text": "بگیر این سر مایه‌ور جاه او"
  },
  {
    "poem_id": 1343,
    "vorder": 44,
    "position": 1,
    "text": "تو را زیبد اندر جهان گاه او"
  },
  {
    "poem_id": 1343,
    "vorder": 45,
    "position": 0,
    "text": "بر این گفتهٔ من چو داری وفا"
  },
  {
    "poem_id": 1343,
    "vorder": 46,
    "position": 1,
    "text": "جهاندار باشی یکی پادشا"
  },
  {
    "poem_id": 1343,
    "vorder": 47,
    "position": 0,
    "text": "چو ضحاک بشنید اندیشه کرد"
  },
  {
    "poem_id": 1343,
    "vorder": 48,
    "position": 1,
    "text": "ز خون پدر شد دلش پر ز درد"
  },
  {
    "poem_id": 1343,
    "vorder": 49,
    "position": 0,
    "text": "به ابلیس گفت این سزاوار نیست"
  },
  {
    "poem_id": 1343,
    "vorder": 50,
    "position": 1,
    "text": "دگر گوی کاین از در کار نیست"
  },
  {
    "poem_id": 1343,
    "vorder": 51,
    "position": 0,
    "text": "بدو گفت گر بگذری زین سخن"
  },
  {
    "poem_id": 1343,
    "vorder": 52,
    "position": 1,
    "text": "بتابی ز سوگند و پیمان من"
  },
  {
    "poem_id": 1343,
    "vorder": 53,
    "position": 0,
    "text": "بماند به گردنت سوگند و بند"
  },
  {
    "poem_id": 1343,
    "vorder": 54,
    "position": 1,
    "text": "شوی خوار و ماند پدرت ارجمند"
  },
  {
    "poem_id": 1343,
    "vorder": 55,
    "position": 0,
    "text": "سر مرد تازی به دام آورید"
  },
  {
    "poem_id": 1343,
    "vorder": 56,
    "position": 1,
    "text": "چنان شد که فرمان او برگزید"
  },
  {
    "poem_id": 1343,
    "vorder": 57,
    "position": 0,
    "text": "بپرسید کاین چاره با من بگوی"
  },
  {
    "poem_id": 1343,
    "vorder": 58,
    "position": 1,
    "text": "نتابم ز رای تو من هیچ روی"
  },
  {
    "poem_id": 1343,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت من چاره سازم ترا"
  },
  {
    "poem_id": 1343,
    "vorder": 60,
    "position": 1,
    "text": "به خورشید سر برفرازم ترا"
  },
  {
    "poem_id": 1343,
    "vorder": 61,
    "position": 0,
    "text": "مر آن پادشا را در اندر سرای"
  },
  {
    "poem_id": 1343,
    "vorder": 62,
    "position": 1,
    "text": "یکی بوستان بود بس دلگشای"
  },
  {
    "poem_id": 1343,
    "vorder": 63,
    "position": 0,
    "text": "گرانمایه شبگیر برخاستی"
  },
  {
    "poem_id": 1343,
    "vorder": 64,
    "position": 1,
    "text": "ز بهر پرستش بیاراستی"
  },
  {
    "poem_id": 1343,
    "vorder": 65,
    "position": 0,
    "text": "سر و تن بشستی نهفته به باغ"
  },
  {
    "poem_id": 1343,
    "vorder": 66,
    "position": 1,
    "text": "پرستنده با او ببردی چراغ"
  },
  {
    "poem_id": 1343,
    "vorder": 67,
    "position": 0,
    "text": "بیاورد وارونه ابلیس بند"
  },
  {
    "poem_id": 1343,
    "vorder": 68,
    "position": 1,
    "text": "یکی ژرف چاهی به ره بر بکند"
  },
  {
    "poem_id": 1343,
    "vorder": 69,
    "position": 0,
    "text": "پس ابلیس وارونه آن ژرف چاه"
  },
  {
    "poem_id": 1343,
    "vorder": 70,
    "position": 1,
    "text": "به خاشاک پوشید و بسترد راه"
  },
  {
    "poem_id": 1343,
    "vorder": 71,
    "position": 0,
    "text": "سر تازیان مهتر نامجوی"
  },
  {
    "poem_id": 1343,
    "vorder": 72,
    "position": 1,
    "text": "شب آمد سوی باغ بنهاد روی"
  },
  {
    "poem_id": 1343,
    "vorder": 73,
    "position": 0,
    "text": "به چاه اندر افتاد و بشکست پست"
  },
  {
    "poem_id": 1343,
    "vorder": 74,
    "position": 1,
    "text": "شد آن نیک‌دل مرد یزدان‌پرست"
  },
  {
    "poem_id": 1343,
    "vorder": 75,
    "position": 0,
    "text": "به هر نیک و بد شاه آزاد مرد"
  },
  {
    "poem_id": 1343,
    "vorder": 76,
    "position": 1,
    "text": "به فرزند بر نازده باد سرد"
  },
  {
    "poem_id": 1343,
    "vorder": 77,
    "position": 0,
    "text": "همی پروریدش به ناز و به رنج"
  },
  {
    "poem_id": 1343,
    "vorder": 78,
    "position": 1,
    "text": "بدو بود شاد و بدو داد گنج"
  },
  {
    "poem_id": 1343,
    "vorder": 79,
    "position": 0,
    "text": "چنان بدگهر شوخ فرزند او"
  },
  {
    "poem_id": 1343,
    "vorder": 80,
    "position": 1,
    "text": "بگشت از ره داد و پیوند او"
  },
  {
    "poem_id": 1343,
    "vorder": 81,
    "position": 0,
    "text": "به خون پدر گشت همداستان"
  },
  {
    "poem_id": 1343,
    "vorder": 82,
    "position": 1,
    "text": "ز دانا شنیدم من این داستان"
  },
  {
    "poem_id": 1343,
    "vorder": 83,
    "position": 0,
    "text": "که فرزند بد گر شود نرّه شیر"
  },
  {
    "poem_id": 1343,
    "vorder": 84,
    "position": 1,
    "text": "به خون پدر هم نباشد دلیر"
  },
  {
    "poem_id": 1343,
    "vorder": 85,
    "position": 0,
    "text": "مگر در نهانش سخن دیگرست"
  },
  {
    "poem_id": 1343,
    "vorder": 86,
    "position": 1,
    "text": "پژوهنده را راز با مادرست"
  },
  {
    "poem_id": 1343,
    "vorder": 87,
    "position": 0,
    "text": "فرومایه ضحاک بیدادگر"
  },
  {
    "poem_id": 1343,
    "vorder": 88,
    "position": 1,
    "text": "بدین چاره بگرفت جای پدر"
  },
  {
    "poem_id": 1343,
    "vorder": 89,
    "position": 0,
    "text": "به سر بر نهاد افسر تازیان"
  },
  {
    "poem_id": 1343,
    "vorder": 90,
    "position": 1,
    "text": "بر ایشان ببخشید سود و زیان"
  }
]