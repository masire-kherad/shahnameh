[
  {
    "poem_id": 1718,
    "vorder": 1,
    "position": 0,
    "text": "به گفتار این نامدار اردشیر"
  },
  {
    "poem_id": 1718,
    "vorder": 2,
    "position": 1,
    "text": "همه گوش دارید برنا و پیر"
  },
  {
    "poem_id": 1718,
    "vorder": 3,
    "position": 0,
    "text": "هرانکس که داند که دادار هست"
  },
  {
    "poem_id": 1718,
    "vorder": 4,
    "position": 1,
    "text": "نباشد مگر پاک و یزدان پرست"
  },
  {
    "poem_id": 1718,
    "vorder": 5,
    "position": 0,
    "text": "دگر آنک دانش مگیرید خوار"
  },
  {
    "poem_id": 1718,
    "vorder": 6,
    "position": 1,
    "text": "اگر زیردستست و گر شهریار"
  },
  {
    "poem_id": 1718,
    "vorder": 7,
    "position": 0,
    "text": "سه دیگر بدانی که هرگز سخن"
  },
  {
    "poem_id": 1718,
    "vorder": 8,
    "position": 1,
    "text": "نگردد بر مرد دانا کهن"
  },
  {
    "poem_id": 1718,
    "vorder": 9,
    "position": 0,
    "text": "چهارم چنان دان که بیم گناه"
  },
  {
    "poem_id": 1718,
    "vorder": 10,
    "position": 1,
    "text": "فزون باشد از بند و زندان شاه"
  },
  {
    "poem_id": 1718,
    "vorder": 11,
    "position": 0,
    "text": "به پنجم سخن مردم زشت‌گوی"
  },
  {
    "poem_id": 1718,
    "vorder": 12,
    "position": 1,
    "text": "نگیرد به نزد کسان آب‌روی"
  },
  {
    "poem_id": 1718,
    "vorder": 13,
    "position": 0,
    "text": "بگویم یکی تازه اندرز نیز"
  },
  {
    "poem_id": 1718,
    "vorder": 14,
    "position": 1,
    "text": "کجا برتر از دیده و جان و چیز"
  },
  {
    "poem_id": 1718,
    "vorder": 15,
    "position": 0,
    "text": "خنک آنک آباد دارد جهان"
  },
  {
    "poem_id": 1718,
    "vorder": 16,
    "position": 1,
    "text": "بود آشکارای او چون نهان"
  },
  {
    "poem_id": 1718,
    "vorder": 17,
    "position": 0,
    "text": "دگر آنک دارند آواز نرم"
  },
  {
    "poem_id": 1718,
    "vorder": 18,
    "position": 1,
    "text": "خرد دارد و شرم و گفتار گرم"
  },
  {
    "poem_id": 1718,
    "vorder": 19,
    "position": 0,
    "text": "به پیش کسان سیم از بهر لاف"
  },
  {
    "poem_id": 1718,
    "vorder": 20,
    "position": 1,
    "text": "به بیهوده بپراگند بر گزاف"
  },
  {
    "poem_id": 1718,
    "vorder": 21,
    "position": 0,
    "text": "ز مردم ندارد کسی زان سپاس"
  },
  {
    "poem_id": 1718,
    "vorder": 22,
    "position": 1,
    "text": "نبپسندد آن مرد یزدان شناس"
  },
  {
    "poem_id": 1718,
    "vorder": 23,
    "position": 0,
    "text": "میانه گزینی بمانی به جای"
  },
  {
    "poem_id": 1718,
    "vorder": 24,
    "position": 1,
    "text": "خردمند خوانند و پاکیزه‌رای"
  },
  {
    "poem_id": 1718,
    "vorder": 25,
    "position": 0,
    "text": "کزین بگذری پنج رایست پیش"
  },
  {
    "poem_id": 1718,
    "vorder": 26,
    "position": 1,
    "text": "کجا تازه گردد ترا دین وکیش"
  },
  {
    "poem_id": 1718,
    "vorder": 27,
    "position": 0,
    "text": "تن آسانی و شادی افزایدت"
  },
  {
    "poem_id": 1718,
    "vorder": 28,
    "position": 1,
    "text": "که با شهد او زهر نگزایدت"
  },
  {
    "poem_id": 1718,
    "vorder": 29,
    "position": 0,
    "text": "یکی آنک از بخشش دادگر"
  },
  {
    "poem_id": 1718,
    "vorder": 30,
    "position": 1,
    "text": "به آز و به کوشش نیابی گذر"
  },
  {
    "poem_id": 1718,
    "vorder": 31,
    "position": 0,
    "text": "توانگر شود هرک خرسند گشت"
  },
  {
    "poem_id": 1718,
    "vorder": 32,
    "position": 1,
    "text": "گل نوبهارش برومند گشت"
  },
  {
    "poem_id": 1718,
    "vorder": 33,
    "position": 0,
    "text": "دگر بشکنی گردن آز را"
  },
  {
    "poem_id": 1718,
    "vorder": 34,
    "position": 1,
    "text": "نگویی به پیش زنان راز را"
  },
  {
    "poem_id": 1718,
    "vorder": 35,
    "position": 0,
    "text": "سه دیگر ننازی به ننگ و نبرد"
  },
  {
    "poem_id": 1718,
    "vorder": 36,
    "position": 1,
    "text": "که ننگ ونبرد آورد رنج و درد"
  },
  {
    "poem_id": 1718,
    "vorder": 37,
    "position": 0,
    "text": "چهارم که دل دور داری ز غم"
  },
  {
    "poem_id": 1718,
    "vorder": 38,
    "position": 1,
    "text": "ز نا آمده دل نداری دژم"
  },
  {
    "poem_id": 1718,
    "vorder": 39,
    "position": 0,
    "text": "نه پیچی به کاری که کار تو نیست"
  },
  {
    "poem_id": 1718,
    "vorder": 40,
    "position": 1,
    "text": "نتازی بدان کو شکار تو نیست"
  },
  {
    "poem_id": 1718,
    "vorder": 41,
    "position": 0,
    "text": "همه گوش دارید پند مرا"
  },
  {
    "poem_id": 1718,
    "vorder": 42,
    "position": 1,
    "text": "سخن گفتن سودمند مرا"
  },
  {
    "poem_id": 1718,
    "vorder": 43,
    "position": 0,
    "text": "بود بر دل هرکسی ارجمند"
  },
  {
    "poem_id": 1718,
    "vorder": 44,
    "position": 1,
    "text": "که یابند ازو ایمنی از گزند"
  },
  {
    "poem_id": 1718,
    "vorder": 45,
    "position": 0,
    "text": "زمانی میاسای ز آموختن"
  },
  {
    "poem_id": 1718,
    "vorder": 46,
    "position": 1,
    "text": "اگر جان همی خواهی افروختن"
  },
  {
    "poem_id": 1718,
    "vorder": 47,
    "position": 0,
    "text": "چو فرزند باشد به فرهنگ دار"
  },
  {
    "poem_id": 1718,
    "vorder": 48,
    "position": 1,
    "text": "زمانه ز بازی برو تنگ دار"
  },
  {
    "poem_id": 1718,
    "vorder": 49,
    "position": 0,
    "text": "همه یاد دارید گفتار ما"
  },
  {
    "poem_id": 1718,
    "vorder": 50,
    "position": 1,
    "text": "کشیدن بدین کار تیمار ما"
  },
  {
    "poem_id": 1718,
    "vorder": 51,
    "position": 0,
    "text": "هرآن کس که با داد و روشن دلید"
  },
  {
    "poem_id": 1718,
    "vorder": 52,
    "position": 1,
    "text": "از آمیزش یکدگر مگسلید"
  },
  {
    "poem_id": 1718,
    "vorder": 53,
    "position": 0,
    "text": "دل آرام دارید بر چار چیز"
  },
  {
    "poem_id": 1718,
    "vorder": 54,
    "position": 1,
    "text": "کزو خوبی و سودمندیست نیز"
  },
  {
    "poem_id": 1718,
    "vorder": 55,
    "position": 0,
    "text": "یکی بیم و آزرم و شرم خدای"
  },
  {
    "poem_id": 1718,
    "vorder": 56,
    "position": 1,
    "text": "که باشد ترا یاور و رهنمای"
  },
  {
    "poem_id": 1718,
    "vorder": 57,
    "position": 0,
    "text": "دگر داد دادن تن خویش را"
  },
  {
    "poem_id": 1718,
    "vorder": 58,
    "position": 1,
    "text": "نگه داشتن دامن خویش را"
  },
  {
    "poem_id": 1718,
    "vorder": 59,
    "position": 0,
    "text": "به فرمان یزدان دل آراستن"
  },
  {
    "poem_id": 1718,
    "vorder": 60,
    "position": 1,
    "text": "مرا چون تن خویشتن خواستن"
  },
  {
    "poem_id": 1718,
    "vorder": 61,
    "position": 0,
    "text": "سه دیگر که پیدا کنی راستی"
  },
  {
    "poem_id": 1718,
    "vorder": 62,
    "position": 1,
    "text": "بدور افگنی کژی و کاستی"
  },
  {
    "poem_id": 1718,
    "vorder": 63,
    "position": 0,
    "text": "چهارم که از رای شاه جهان"
  },
  {
    "poem_id": 1718,
    "vorder": 64,
    "position": 1,
    "text": "نپیچی دلت آشکار و نهان"
  },
  {
    "poem_id": 1718,
    "vorder": 65,
    "position": 0,
    "text": "ورا چون تن خویش خواهی به مهر"
  },
  {
    "poem_id": 1718,
    "vorder": 66,
    "position": 1,
    "text": "به فرمان او تازه گردد سپهر"
  },
  {
    "poem_id": 1718,
    "vorder": 67,
    "position": 0,
    "text": "دلت بسته داری به پیمان اوی"
  },
  {
    "poem_id": 1718,
    "vorder": 68,
    "position": 1,
    "text": "روان را نپیچی ز فرمان اوی"
  },
  {
    "poem_id": 1718,
    "vorder": 69,
    "position": 0,
    "text": "برو مهر داری چو بر جان خویش"
  },
  {
    "poem_id": 1718,
    "vorder": 70,
    "position": 1,
    "text": "چو با داد بینی نگهبان خویش"
  },
  {
    "poem_id": 1718,
    "vorder": 71,
    "position": 0,
    "text": "غم پادشاهی جهانجوی راست"
  },
  {
    "poem_id": 1718,
    "vorder": 72,
    "position": 1,
    "text": "ز گیتی فزونی سگالد نه کاست"
  },
  {
    "poem_id": 1718,
    "vorder": 73,
    "position": 0,
    "text": "گر از کارداران وز لشکرش"
  },
  {
    "poem_id": 1718,
    "vorder": 74,
    "position": 1,
    "text": "بداند که رنجست بر کشورش"
  },
  {
    "poem_id": 1718,
    "vorder": 75,
    "position": 0,
    "text": "نیازد به داد او جهاندار نیست"
  },
  {
    "poem_id": 1718,
    "vorder": 76,
    "position": 1,
    "text": "برو تاج شاهی سزاوار نیست"
  },
  {
    "poem_id": 1718,
    "vorder": 77,
    "position": 0,
    "text": "سیه کرد منشور شاهنشهی"
  },
  {
    "poem_id": 1718,
    "vorder": 78,
    "position": 1,
    "text": "ازان پس نباشد ورا فرهی"
  },
  {
    "poem_id": 1718,
    "vorder": 79,
    "position": 0,
    "text": "چنان دان که بیدادگر شهریار"
  },
  {
    "poem_id": 1718,
    "vorder": 80,
    "position": 1,
    "text": "بود شیر درنده در مرغزار"
  },
  {
    "poem_id": 1718,
    "vorder": 81,
    "position": 0,
    "text": "همان زیردستی که فرمان شاه"
  },
  {
    "poem_id": 1718,
    "vorder": 82,
    "position": 1,
    "text": "به رنج و به کوشش ندارد نگاه"
  },
  {
    "poem_id": 1718,
    "vorder": 83,
    "position": 0,
    "text": "بود زندگانیش با درد و رنج"
  },
  {
    "poem_id": 1718,
    "vorder": 84,
    "position": 1,
    "text": "نگردد کهن در سرای سپنج"
  },
  {
    "poem_id": 1718,
    "vorder": 85,
    "position": 0,
    "text": "اگر مهتری یابد و بهتری"
  },
  {
    "poem_id": 1718,
    "vorder": 86,
    "position": 1,
    "text": "نیابد به زفتی و کنداوری"
  },
  {
    "poem_id": 1718,
    "vorder": 87,
    "position": 0,
    "text": "دل زیردستان ما شاد باد"
  },
  {
    "poem_id": 1718,
    "vorder": 88,
    "position": 1,
    "text": "هم از داد ماگیتی آباد باد"
  }
]