[
  {
    "poem_id": 1520,
    "vorder": 1,
    "position": 0,
    "text": "ز میرین یکی بود کهتر به سال"
  },
  {
    "poem_id": 1520,
    "vorder": 2,
    "position": 1,
    "text": "ز گردان رومی برآورده یال"
  },
  {
    "poem_id": 1520,
    "vorder": 3,
    "position": 0,
    "text": "گوی بر منش نام او اهرنا"
  },
  {
    "poem_id": 1520,
    "vorder": 4,
    "position": 1,
    "text": "ز تخم بزرگان رویین تنا"
  },
  {
    "poem_id": 1520,
    "vorder": 5,
    "position": 0,
    "text": "فرستاد نزدیک قیصر پیام"
  },
  {
    "poem_id": 1520,
    "vorder": 6,
    "position": 1,
    "text": "که دانی که ما را نژادست و نام"
  },
  {
    "poem_id": 1520,
    "vorder": 7,
    "position": 0,
    "text": "ز میرین به هر گوهری بگذرم"
  },
  {
    "poem_id": 1520,
    "vorder": 8,
    "position": 1,
    "text": "به تیغ و به گنج درم برترم"
  },
  {
    "poem_id": 1520,
    "vorder": 9,
    "position": 0,
    "text": "به من ده کنون دختر کهترت"
  },
  {
    "poem_id": 1520,
    "vorder": 10,
    "position": 1,
    "text": "به من تازه کن لشکر و افسرت"
  },
  {
    "poem_id": 1520,
    "vorder": 11,
    "position": 0,
    "text": "چنین داد پاسخ که پیمان من"
  },
  {
    "poem_id": 1520,
    "vorder": 12,
    "position": 1,
    "text": "شنیدی مگر با جهانبان من"
  },
  {
    "poem_id": 1520,
    "vorder": 13,
    "position": 0,
    "text": "که داماد نگزیند این دخترم"
  },
  {
    "poem_id": 1520,
    "vorder": 14,
    "position": 1,
    "text": "ز راه نیاکان خود نگذرم"
  },
  {
    "poem_id": 1520,
    "vorder": 15,
    "position": 0,
    "text": "چو میرین یکی کار بایدت کرد"
  },
  {
    "poem_id": 1520,
    "vorder": 16,
    "position": 1,
    "text": "ازان پس تو باشی ورا هم نبرد"
  },
  {
    "poem_id": 1520,
    "vorder": 17,
    "position": 0,
    "text": "به کوه سقیلا یکی اژدهاست"
  },
  {
    "poem_id": 1520,
    "vorder": 18,
    "position": 1,
    "text": "که کشور همه پاک ازو در بلاست"
  },
  {
    "poem_id": 1520,
    "vorder": 19,
    "position": 0,
    "text": "اگر کم کنی اژدها را ز روم"
  },
  {
    "poem_id": 1520,
    "vorder": 20,
    "position": 1,
    "text": "سپارم ترا دختر و گنج و بوم"
  },
  {
    "poem_id": 1520,
    "vorder": 21,
    "position": 0,
    "text": "که همتای آن گرگ شیراوژنست"
  },
  {
    "poem_id": 1520,
    "vorder": 22,
    "position": 1,
    "text": "دمش زهر و او دام آهرمنست"
  },
  {
    "poem_id": 1520,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد پاسخ که فرمان کنم"
  },
  {
    "poem_id": 1520,
    "vorder": 24,
    "position": 1,
    "text": "بدین آرزو جان گروگان کنم"
  },
  {
    "poem_id": 1520,
    "vorder": 25,
    "position": 0,
    "text": "ز نزدیک قیصر بیامد برون"
  },
  {
    "poem_id": 1520,
    "vorder": 26,
    "position": 1,
    "text": "دلش زان سخن کفته جان پر زخون"
  },
  {
    "poem_id": 1520,
    "vorder": 27,
    "position": 0,
    "text": "به یاران چنین گفت کان زخم گرگ"
  },
  {
    "poem_id": 1520,
    "vorder": 28,
    "position": 1,
    "text": "نبد جز به شمشیر مردی سترگ"
  },
  {
    "poem_id": 1520,
    "vorder": 29,
    "position": 0,
    "text": "ز میرین کی آید چنین کارکرد"
  },
  {
    "poem_id": 1520,
    "vorder": 30,
    "position": 1,
    "text": "نداند همی قیصر از مرد مرد"
  },
  {
    "poem_id": 1520,
    "vorder": 31,
    "position": 0,
    "text": "شوم زو بپرسم بگوید مگر"
  },
  {
    "poem_id": 1520,
    "vorder": 32,
    "position": 1,
    "text": "سخن با من از بی‌پی چاره‌گر"
  },
  {
    "poem_id": 1520,
    "vorder": 33,
    "position": 0,
    "text": "بشد تا به ایوان میرین چوگرد"
  },
  {
    "poem_id": 1520,
    "vorder": 34,
    "position": 1,
    "text": "پرستنده‌ای رفت و آواز کرد"
  },
  {
    "poem_id": 1520,
    "vorder": 35,
    "position": 0,
    "text": "نشستنگهی داشت میرین که ماه"
  },
  {
    "poem_id": 1520,
    "vorder": 36,
    "position": 1,
    "text": "به گردون ندارد چنان جایگاه"
  },
  {
    "poem_id": 1520,
    "vorder": 37,
    "position": 0,
    "text": "جهانجوی با گبر کنداوری"
  },
  {
    "poem_id": 1520,
    "vorder": 38,
    "position": 1,
    "text": "یکی افسری بر سرش قیصری"
  },
  {
    "poem_id": 1520,
    "vorder": 39,
    "position": 0,
    "text": "پرستنده گفت اهرن پیلتن"
  },
  {
    "poem_id": 1520,
    "vorder": 40,
    "position": 1,
    "text": "بیامد به در با یکی انجمن"
  },
  {
    "poem_id": 1520,
    "vorder": 41,
    "position": 0,
    "text": "نشستنگهی ساخت شایسته‌تر"
  },
  {
    "poem_id": 1520,
    "vorder": 42,
    "position": 1,
    "text": "برفت آنک بودند بایسته‌تر"
  },
  {
    "poem_id": 1520,
    "vorder": 43,
    "position": 0,
    "text": "به ایوان میرین نماندند کس"
  },
  {
    "poem_id": 1520,
    "vorder": 44,
    "position": 1,
    "text": "دو مهتر نشستند بر تخت بس"
  },
  {
    "poem_id": 1520,
    "vorder": 45,
    "position": 0,
    "text": "چو میرین بدیدش به بر درگرفت"
  },
  {
    "poem_id": 1520,
    "vorder": 46,
    "position": 1,
    "text": "بپرسیدن مهتر اندر گرفت"
  },
  {
    "poem_id": 1520,
    "vorder": 47,
    "position": 0,
    "text": "بدو گفت اهرن که با من بگوی"
  },
  {
    "poem_id": 1520,
    "vorder": 48,
    "position": 1,
    "text": "ز هرچت بپرسم بهانه مجوی"
  },
  {
    "poem_id": 1520,
    "vorder": 49,
    "position": 0,
    "text": "مرا آرزو دختر قیصرست"
  },
  {
    "poem_id": 1520,
    "vorder": 50,
    "position": 1,
    "text": "کجا روم را سربسر افسرست"
  },
  {
    "poem_id": 1520,
    "vorder": 51,
    "position": 0,
    "text": "بگفتیم و پاسخ چنین داد باز"
  },
  {
    "poem_id": 1520,
    "vorder": 52,
    "position": 1,
    "text": "که در کوه با اژدها رزم ساز"
  },
  {
    "poem_id": 1520,
    "vorder": 53,
    "position": 0,
    "text": "اگر بازگویی تو آن کار گرگ"
  },
  {
    "poem_id": 1520,
    "vorder": 54,
    "position": 1,
    "text": "بوی مر مرا رهنمای بزرگ"
  },
  {
    "poem_id": 1520,
    "vorder": 55,
    "position": 0,
    "text": "چو بشنید میرین ز اهرن سخن"
  },
  {
    "poem_id": 1520,
    "vorder": 56,
    "position": 1,
    "text": "بپژمرد و اندیشه افگند بن"
  },
  {
    "poem_id": 1520,
    "vorder": 57,
    "position": 0,
    "text": "که گر کار آن نامدار جهان"
  },
  {
    "poem_id": 1520,
    "vorder": 58,
    "position": 1,
    "text": "به اهرن بگویم نماند نهان"
  },
  {
    "poem_id": 1520,
    "vorder": 59,
    "position": 0,
    "text": "سرمایهٔ مردمی راستیست"
  },
  {
    "poem_id": 1520,
    "vorder": 60,
    "position": 1,
    "text": "ز تاری و کژی بباید گریست"
  },
  {
    "poem_id": 1520,
    "vorder": 61,
    "position": 0,
    "text": "بگویم مگر کان نبرده سوار"
  },
  {
    "poem_id": 1520,
    "vorder": 62,
    "position": 1,
    "text": "نهد اژدهار را سر اندر کنار"
  },
  {
    "poem_id": 1520,
    "vorder": 63,
    "position": 0,
    "text": "چو اهرن بود مر مرا یار و پشت"
  },
  {
    "poem_id": 1520,
    "vorder": 64,
    "position": 1,
    "text": "ندارد مگر باد دشمن به مشت"
  },
  {
    "poem_id": 1520,
    "vorder": 65,
    "position": 0,
    "text": "برآریم گرد از سر آن سوار"
  },
  {
    "poem_id": 1520,
    "vorder": 66,
    "position": 1,
    "text": "نهان ماند این کار یک روزگار"
  },
  {
    "poem_id": 1520,
    "vorder": 67,
    "position": 0,
    "text": "به اهرن چنین گفت کز کار گرگ"
  },
  {
    "poem_id": 1520,
    "vorder": 68,
    "position": 1,
    "text": "بگویم چو سوگند یابم بزرگ"
  },
  {
    "poem_id": 1520,
    "vorder": 69,
    "position": 0,
    "text": "که این کار هرگز به روز و به شب"
  },
  {
    "poem_id": 1520,
    "vorder": 70,
    "position": 1,
    "text": "نگویی نداری گشاده دو لب"
  },
  {
    "poem_id": 1520,
    "vorder": 71,
    "position": 0,
    "text": "بخورد اهرن آن سخت سوگند اوی"
  },
  {
    "poem_id": 1520,
    "vorder": 72,
    "position": 1,
    "text": "بپذرفت سرتاسر آن بند اوی"
  },
  {
    "poem_id": 1520,
    "vorder": 73,
    "position": 0,
    "text": "چو قرطاس را جامهٔ خامه کرد"
  },
  {
    "poem_id": 1520,
    "vorder": 74,
    "position": 1,
    "text": "به هیشوی میرین یکی نامه کرد"
  },
  {
    "poem_id": 1520,
    "vorder": 75,
    "position": 0,
    "text": "که اهرن که دارد ز قیصر نژاد"
  },
  {
    "poem_id": 1520,
    "vorder": 76,
    "position": 1,
    "text": "جهانجوی با گنج و با تخت و داد"
  },
  {
    "poem_id": 1520,
    "vorder": 77,
    "position": 0,
    "text": "بخواهد ز قیصر همی دختری"
  },
  {
    "poem_id": 1520,
    "vorder": 78,
    "position": 1,
    "text": "که ماندست از دختران کهتری"
  },
  {
    "poem_id": 1520,
    "vorder": 79,
    "position": 0,
    "text": "همی اژدها دام اهرن کند"
  },
  {
    "poem_id": 1520,
    "vorder": 80,
    "position": 1,
    "text": "بکوشد کزان بدنشان تن کند"
  },
  {
    "poem_id": 1520,
    "vorder": 81,
    "position": 0,
    "text": "بیامد به نزدیک من چاره‌جوی"
  },
  {
    "poem_id": 1520,
    "vorder": 82,
    "position": 1,
    "text": "گذشته سخنها گشادم بدوی"
  },
  {
    "poem_id": 1520,
    "vorder": 83,
    "position": 0,
    "text": "ازان گرگ و آن رزم دیده‌سوار"
  },
  {
    "poem_id": 1520,
    "vorder": 84,
    "position": 1,
    "text": "بگفتم همه هرچ آمد به کار"
  },
  {
    "poem_id": 1520,
    "vorder": 85,
    "position": 0,
    "text": "چنان هم که کار مرا کرد خوب"
  },
  {
    "poem_id": 1520,
    "vorder": 86,
    "position": 1,
    "text": "کند بی‌گمان کار این مرد خوب"
  },
  {
    "poem_id": 1520,
    "vorder": 87,
    "position": 0,
    "text": "دو تن را بدین مرز مهتر کند"
  },
  {
    "poem_id": 1520,
    "vorder": 88,
    "position": 1,
    "text": "چو خورشید را بر سر افسر کند"
  },
  {
    "poem_id": 1520,
    "vorder": 89,
    "position": 0,
    "text": "بیامد دوان اهرن چاره‌جوی"
  },
  {
    "poem_id": 1520,
    "vorder": 90,
    "position": 1,
    "text": "به نزدیک هیشوی بنهاد روی"
  },
  {
    "poem_id": 1520,
    "vorder": 91,
    "position": 0,
    "text": "چو اهرن به نزدیک دریا رسید"
  },
  {
    "poem_id": 1520,
    "vorder": 92,
    "position": 1,
    "text": "جهانجوی هیشوی پیشین دوید"
  },
  {
    "poem_id": 1520,
    "vorder": 93,
    "position": 0,
    "text": "ازو بستد آن نامهٔ دلپسند"
  },
  {
    "poem_id": 1520,
    "vorder": 94,
    "position": 1,
    "text": "برو آفرین کرد و بگشاد بند"
  },
  {
    "poem_id": 1520,
    "vorder": 95,
    "position": 0,
    "text": "بدو گفت هیشوی کای راد مرد"
  },
  {
    "poem_id": 1520,
    "vorder": 96,
    "position": 1,
    "text": "بیاید کنون او به کردار گرد"
  },
  {
    "poem_id": 1520,
    "vorder": 97,
    "position": 0,
    "text": "یکی نامداری غریب و جوان"
  },
  {
    "poem_id": 1520,
    "vorder": 98,
    "position": 1,
    "text": "فدی کرد بر پیش میرین روان"
  },
  {
    "poem_id": 1520,
    "vorder": 99,
    "position": 0,
    "text": "کنون چون کند رزم نر اژدها"
  },
  {
    "poem_id": 1520,
    "vorder": 100,
    "position": 1,
    "text": "به چاره نیابد مگر زو رها"
  },
  {
    "poem_id": 1520,
    "vorder": 101,
    "position": 0,
    "text": "مرا گفتن و کار بر دست اوست"
  },
  {
    "poem_id": 1520,
    "vorder": 102,
    "position": 1,
    "text": "سخن گفتن نیک هرجا نکوست"
  },
  {
    "poem_id": 1520,
    "vorder": 103,
    "position": 0,
    "text": "تو امشب بدین میزبان رای کن"
  },
  {
    "poem_id": 1520,
    "vorder": 104,
    "position": 1,
    "text": "بنه شمع و دریا دل‌آرای کن"
  },
  {
    "poem_id": 1520,
    "vorder": 105,
    "position": 0,
    "text": "که فردا بیاید گو نامجوی"
  },
  {
    "poem_id": 1520,
    "vorder": 106,
    "position": 1,
    "text": "بگویم بدو هرچ گویی بگوی"
  },
  {
    "poem_id": 1520,
    "vorder": 107,
    "position": 0,
    "text": "به شمع آب دریا بیاراستند"
  },
  {
    "poem_id": 1520,
    "vorder": 108,
    "position": 1,
    "text": "خورشها بخوردند و می خواستند"
  },
  {
    "poem_id": 1520,
    "vorder": 109,
    "position": 0,
    "text": "چنین تا سپیده ز یاقوت زرد"
  },
  {
    "poem_id": 1520,
    "vorder": 110,
    "position": 1,
    "text": "بزد شید بر شیشهٔ لاژورد"
  },
  {
    "poem_id": 1520,
    "vorder": 111,
    "position": 0,
    "text": "پدید آمد از دشت گرد سوار"
  },
  {
    "poem_id": 1520,
    "vorder": 112,
    "position": 1,
    "text": "ز دورش بدید اهرن نامدار"
  },
  {
    "poem_id": 1520,
    "vorder": 113,
    "position": 0,
    "text": "چو تنگ اندر آمد پیاده دوان"
  },
  {
    "poem_id": 1520,
    "vorder": 114,
    "position": 1,
    "text": "پذیره شدش مرد روشن روان"
  },
  {
    "poem_id": 1520,
    "vorder": 115,
    "position": 0,
    "text": "فرود آمد از باره جنگی سوار"
  },
  {
    "poem_id": 1520,
    "vorder": 116,
    "position": 1,
    "text": "می و خوردنی خواست از نامدار"
  },
  {
    "poem_id": 1520,
    "vorder": 117,
    "position": 0,
    "text": "یکی تیز بگشاد هیشوی لب"
  },
  {
    "poem_id": 1520,
    "vorder": 118,
    "position": 1,
    "text": "که شادان بدی نامور روز و شب"
  },
  {
    "poem_id": 1520,
    "vorder": 119,
    "position": 0,
    "text": "نگه کن بدین مرد قیصر نژاد"
  },
  {
    "poem_id": 1520,
    "vorder": 120,
    "position": 1,
    "text": "که گردون گردان بدو گشت شاد"
  },
  {
    "poem_id": 1520,
    "vorder": 121,
    "position": 0,
    "text": "هم از تخمهٔ قیصرانست نیز"
  },
  {
    "poem_id": 1520,
    "vorder": 122,
    "position": 1,
    "text": "همش فر و نام و همش گنج و چیز"
  },
  {
    "poem_id": 1520,
    "vorder": 123,
    "position": 0,
    "text": "به دامادی قیصر آمدش رای"
  },
  {
    "poem_id": 1520,
    "vorder": 124,
    "position": 1,
    "text": "همی خواهد اندر سخن رهنمای"
  },
  {
    "poem_id": 1520,
    "vorder": 125,
    "position": 0,
    "text": "چنو نیست مر قیصران را همال"
  },
  {
    "poem_id": 1520,
    "vorder": 126,
    "position": 1,
    "text": "جوانیست با فر و با برز و یال"
  },
  {
    "poem_id": 1520,
    "vorder": 127,
    "position": 0,
    "text": "ازو خواست یک‌بار و پاسخ شنید"
  },
  {
    "poem_id": 1520,
    "vorder": 128,
    "position": 1,
    "text": "کنون چارهٔ دیگر آمد پدید"
  },
  {
    "poem_id": 1520,
    "vorder": 129,
    "position": 0,
    "text": "همی گویدش اژدهاگیر باش"
  },
  {
    "poem_id": 1520,
    "vorder": 130,
    "position": 1,
    "text": "گر از خویشی قیصر آژیر باش"
  },
  {
    "poem_id": 1520,
    "vorder": 131,
    "position": 0,
    "text": "به پیش گرانمایگان روز و شب"
  },
  {
    "poem_id": 1520,
    "vorder": 132,
    "position": 1,
    "text": "بجز نام میرین نراند به لب"
  },
  {
    "poem_id": 1520,
    "vorder": 133,
    "position": 0,
    "text": "هرانکس که باشند زیبای بخت"
  },
  {
    "poem_id": 1520,
    "vorder": 134,
    "position": 1,
    "text": "بخواهد که ماند بدو تاج و تخت"
  },
  {
    "poem_id": 1520,
    "vorder": 135,
    "position": 0,
    "text": "یکی برز کوهست از ایدر نه دور"
  },
  {
    "poem_id": 1520,
    "vorder": 136,
    "position": 1,
    "text": "همه جای خوردن گه کام و سور"
  },
  {
    "poem_id": 1520,
    "vorder": 137,
    "position": 0,
    "text": "یکی اژدها بر سر تیغ کوه"
  },
  {
    "poem_id": 1520,
    "vorder": 138,
    "position": 1,
    "text": "شده مردم روم زو در ستوه"
  },
  {
    "poem_id": 1520,
    "vorder": 139,
    "position": 0,
    "text": "همی ز آسمان کرگس اندر کشد"
  },
  {
    "poem_id": 1520,
    "vorder": 140,
    "position": 1,
    "text": "ز دریا نهنگ دژم برکشد"
  },
  {
    "poem_id": 1520,
    "vorder": 141,
    "position": 0,
    "text": "همی دود زهرش بسوزد زمین"
  },
  {
    "poem_id": 1520,
    "vorder": 142,
    "position": 1,
    "text": "نخواند برین مرز و بوم آفرین"
  },
  {
    "poem_id": 1520,
    "vorder": 143,
    "position": 0,
    "text": "گر آن کشته آید به دست تو بر"
  },
  {
    "poem_id": 1520,
    "vorder": 144,
    "position": 1,
    "text": "شگفتی شوی در جهان سربسر"
  },
  {
    "poem_id": 1520,
    "vorder": 145,
    "position": 0,
    "text": "ازو یاورت پاک یزدان بود"
  },
  {
    "poem_id": 1520,
    "vorder": 146,
    "position": 1,
    "text": "به کام تو خورشید گردان بود"
  },
  {
    "poem_id": 1520,
    "vorder": 147,
    "position": 0,
    "text": "بدین زور و بالا و این دستبرد"
  },
  {
    "poem_id": 1520,
    "vorder": 148,
    "position": 1,
    "text": "ندانیم همتای تو هیچ گرد"
  },
  {
    "poem_id": 1520,
    "vorder": 149,
    "position": 0,
    "text": "بدو گفت رو خنجری کن دراز"
  },
  {
    "poem_id": 1520,
    "vorder": 150,
    "position": 1,
    "text": "ازو دسته بالاش چون پنج باز"
  },
  {
    "poem_id": 1520,
    "vorder": 151,
    "position": 0,
    "text": "ز هر سوش برسان دندان مار"
  },
  {
    "poem_id": 1520,
    "vorder": 152,
    "position": 1,
    "text": "سنانی برو بسته برسان خار"
  },
  {
    "poem_id": 1520,
    "vorder": 153,
    "position": 0,
    "text": "همی آب داده به زهر و به خون"
  },
  {
    "poem_id": 1520,
    "vorder": 154,
    "position": 1,
    "text": "به تیزی چو الماس و رنگ آب‌گون"
  },
  {
    "poem_id": 1520,
    "vorder": 155,
    "position": 0,
    "text": "به فرمان یزدان پیروزبخت"
  },
  {
    "poem_id": 1520,
    "vorder": 156,
    "position": 1,
    "text": "نگون اندر آویزمش بر درخت"
  }
]