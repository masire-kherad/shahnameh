[
  {
    "poem_id": 87965,
    "vorder": 1,
    "position": 0,
    "text": "فرود جوان را دژ آباد بود"
  },
  {
    "poem_id": 87965,
    "vorder": 2,
    "position": 1,
    "text": "بدژ درپرستنده هفتاد بود"
  },
  {
    "poem_id": 87965,
    "vorder": 3,
    "position": 0,
    "text": "همه ماهرویان بباره بدند"
  },
  {
    "poem_id": 87965,
    "vorder": 4,
    "position": 1,
    "text": "چو دیبای چینی نظاره بدند"
  },
  {
    "poem_id": 87965,
    "vorder": 5,
    "position": 0,
    "text": "ازان بازگشتن فرود جوان"
  },
  {
    "poem_id": 87965,
    "vorder": 6,
    "position": 1,
    "text": "ازیشان همی بود تیره‌روان"
  },
  {
    "poem_id": 87965,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت با شاهزاده تخوار"
  },
  {
    "poem_id": 87965,
    "vorder": 8,
    "position": 1,
    "text": "که گر جست خواهی همی کارزار"
  },
  {
    "poem_id": 87965,
    "vorder": 9,
    "position": 0,
    "text": "نگر نامور طوس را نشکنی"
  },
  {
    "poem_id": 87965,
    "vorder": 10,
    "position": 1,
    "text": "ترا آن به آید که اسپ افگنی"
  },
  {
    "poem_id": 87965,
    "vorder": 11,
    "position": 0,
    "text": "و دیگر که باشد مر او را زمان"
  },
  {
    "poem_id": 87965,
    "vorder": 12,
    "position": 1,
    "text": "نیاید به یک چوبه تیر از کمان"
  },
  {
    "poem_id": 87965,
    "vorder": 13,
    "position": 0,
    "text": "چو آمد سپهبد بر این تیغ کوه"
  },
  {
    "poem_id": 87965,
    "vorder": 14,
    "position": 1,
    "text": "بیاید کنون لشکرش همگروه"
  },
  {
    "poem_id": 87965,
    "vorder": 15,
    "position": 0,
    "text": "ترا نیست در جنگ پایاب اوی"
  },
  {
    "poem_id": 87965,
    "vorder": 16,
    "position": 1,
    "text": "ندیدی بروهای پرتاب اوی"
  },
  {
    "poem_id": 87965,
    "vorder": 17,
    "position": 0,
    "text": "فرود از تخوار این سخنها شنید"
  },
  {
    "poem_id": 87965,
    "vorder": 18,
    "position": 1,
    "text": "کمان را بزه کرد و اندر کشید"
  },
  {
    "poem_id": 87965,
    "vorder": 19,
    "position": 0,
    "text": "خدنگی بر اسپ سپهبد بزد"
  },
  {
    "poem_id": 87965,
    "vorder": 20,
    "position": 1,
    "text": "چنان کز کمان سواران سزد"
  },
  {
    "poem_id": 87965,
    "vorder": 21,
    "position": 0,
    "text": "نگون شد سر تازی و جان بداد"
  },
  {
    "poem_id": 87965,
    "vorder": 22,
    "position": 1,
    "text": "دل طوس پرکین و سر پر ز باد"
  },
  {
    "poem_id": 87965,
    "vorder": 23,
    "position": 0,
    "text": "بلشکر گه آمد بگردن سپر"
  },
  {
    "poem_id": 87965,
    "vorder": 24,
    "position": 1,
    "text": "پیاده پر از گرد و آسیمه سر"
  },
  {
    "poem_id": 87965,
    "vorder": 25,
    "position": 0,
    "text": "گواژه همی زد پس او فرود"
  },
  {
    "poem_id": 87965,
    "vorder": 26,
    "position": 1,
    "text": "که این نامور پهلوان را چه بود"
  },
  {
    "poem_id": 87965,
    "vorder": 27,
    "position": 0,
    "text": "که ایدون ستوه آمد از یک سوار"
  },
  {
    "poem_id": 87965,
    "vorder": 28,
    "position": 1,
    "text": "چگونه چمد در صف کارزار"
  },
  {
    "poem_id": 87965,
    "vorder": 29,
    "position": 0,
    "text": "پرستندگان خنده برداشتند"
  },
  {
    "poem_id": 87965,
    "vorder": 30,
    "position": 1,
    "text": "همی از چرم نعره برداشتند"
  },
  {
    "poem_id": 87965,
    "vorder": 31,
    "position": 0,
    "text": "که پیش جوانی یکی مرد پیر"
  },
  {
    "poem_id": 87965,
    "vorder": 32,
    "position": 1,
    "text": "ز افراز غلتان شد از بیم تیر"
  },
  {
    "poem_id": 87965,
    "vorder": 33,
    "position": 0,
    "text": "سپهبد فرود آمد از کوه سر"
  },
  {
    "poem_id": 87965,
    "vorder": 34,
    "position": 1,
    "text": "برفتند گردان پر اندوه سر"
  },
  {
    "poem_id": 87965,
    "vorder": 35,
    "position": 0,
    "text": "که اکنون تو بازآمدی تندرست"
  },
  {
    "poem_id": 87965,
    "vorder": 36,
    "position": 1,
    "text": "بآب مژه رخ نبایست شست"
  },
  {
    "poem_id": 87965,
    "vorder": 37,
    "position": 0,
    "text": "بپیچید زان کار پرمایه گیو"
  },
  {
    "poem_id": 87965,
    "vorder": 38,
    "position": 1,
    "text": "که آمد پیاده سپهدار نیو"
  },
  {
    "poem_id": 87965,
    "vorder": 39,
    "position": 0,
    "text": "چنین گفت کین را خود اندازه نیست"
  },
  {
    "poem_id": 87965,
    "vorder": 40,
    "position": 1,
    "text": "رخ نامداران برین تازه نیست"
  },
  {
    "poem_id": 87965,
    "vorder": 41,
    "position": 0,
    "text": "اگر شهریارست با گوشوار"
  },
  {
    "poem_id": 87965,
    "vorder": 42,
    "position": 1,
    "text": "چه گیرد چنین لشکر گشن خوار"
  },
  {
    "poem_id": 87965,
    "vorder": 43,
    "position": 0,
    "text": "نباید که باشیم همداستان"
  },
  {
    "poem_id": 87965,
    "vorder": 44,
    "position": 1,
    "text": "به هر گونه‌ای کو زند داستان"
  },
  {
    "poem_id": 87965,
    "vorder": 45,
    "position": 0,
    "text": "اگر طوس یک بار تندی نمود"
  },
  {
    "poem_id": 87965,
    "vorder": 46,
    "position": 1,
    "text": "زمانه پرآزار گشت از فرود"
  },
  {
    "poem_id": 87965,
    "vorder": 47,
    "position": 0,
    "text": "همه جان فدای سیاوش کنیم"
  },
  {
    "poem_id": 87965,
    "vorder": 48,
    "position": 1,
    "text": "نباید که این بد فرامش کنیم"
  },
  {
    "poem_id": 87965,
    "vorder": 49,
    "position": 0,
    "text": "زرسپ گرانمایه زو شد بباد"
  },
  {
    "poem_id": 87965,
    "vorder": 50,
    "position": 1,
    "text": "سواری سرافراز نوذرنژاد"
  },
  {
    "poem_id": 87965,
    "vorder": 51,
    "position": 0,
    "text": "بخونست غرقه تن ریونیز"
  },
  {
    "poem_id": 87965,
    "vorder": 52,
    "position": 1,
    "text": "ازین بیش خواری چه بینیم نیز"
  },
  {
    "poem_id": 87965,
    "vorder": 53,
    "position": 0,
    "text": "گرو پور جمست و مغز قباد"
  },
  {
    "poem_id": 87965,
    "vorder": 54,
    "position": 1,
    "text": "بنادانی این جنگ را برگشاد"
  }
]