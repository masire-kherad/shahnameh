[
  {
    "poem_id": 1923,
    "vorder": 1,
    "position": 0,
    "text": "ز جهرم فرخ زاد راخواندند"
  },
  {
    "poem_id": 1923,
    "vorder": 2,
    "position": 1,
    "text": "بران تخت شاهیش بنشاندند"
  },
  {
    "poem_id": 1923,
    "vorder": 3,
    "position": 0,
    "text": "چو برتخت بنشست و کرد آفرین"
  },
  {
    "poem_id": 1923,
    "vorder": 4,
    "position": 1,
    "text": "ز نیکی دهش بر جهان آفرین"
  },
  {
    "poem_id": 1923,
    "vorder": 5,
    "position": 0,
    "text": "منم گفت فرزند شاهنشهان"
  },
  {
    "poem_id": 1923,
    "vorder": 6,
    "position": 1,
    "text": "نخواهم جز از ایمنی در جهان"
  },
  {
    "poem_id": 1923,
    "vorder": 7,
    "position": 0,
    "text": "ز گیتی هرآنکس که جوید گزند"
  },
  {
    "poem_id": 1923,
    "vorder": 8,
    "position": 1,
    "text": "چو من شاه باشم نگردد بلند"
  },
  {
    "poem_id": 1923,
    "vorder": 9,
    "position": 0,
    "text": "هر آنکس که جوید به دل راستی"
  },
  {
    "poem_id": 1923,
    "vorder": 10,
    "position": 1,
    "text": "نیارد به کار اندرون کاستی"
  },
  {
    "poem_id": 1923,
    "vorder": 11,
    "position": 0,
    "text": "بدارمش چون جان پاک ارجمند"
  },
  {
    "poem_id": 1923,
    "vorder": 12,
    "position": 1,
    "text": "نجویم ابر بی‌گزندان گزند"
  },
  {
    "poem_id": 1923,
    "vorder": 13,
    "position": 0,
    "text": "چو یک ماه بگذشت بر تخت اوی"
  },
  {
    "poem_id": 1923,
    "vorder": 14,
    "position": 1,
    "text": "بخاک اندر آمد سر و بخت اوی"
  },
  {
    "poem_id": 1923,
    "vorder": 15,
    "position": 0,
    "text": "همین بودش از روز و آرام بهر"
  },
  {
    "poem_id": 1923,
    "vorder": 16,
    "position": 1,
    "text": "یکی بنده در می برآمیخت زهر"
  },
  {
    "poem_id": 1923,
    "vorder": 17,
    "position": 0,
    "text": "بخورد و یکی هفته زان پس بزیست"
  },
  {
    "poem_id": 1923,
    "vorder": 18,
    "position": 1,
    "text": "هرآنکس که بشنید بروی گریست"
  },
  {
    "poem_id": 1923,
    "vorder": 19,
    "position": 0,
    "text": "همی پادشاهی به پایان رسید"
  },
  {
    "poem_id": 1923,
    "vorder": 20,
    "position": 1,
    "text": "ز هر سو همی دشمن آمد پدید"
  },
  {
    "poem_id": 1923,
    "vorder": 21,
    "position": 0,
    "text": "چنین است کردار گردنده دهر"
  },
  {
    "poem_id": 1923,
    "vorder": 22,
    "position": 1,
    "text": "نگه کن کزو چند یابی تو بهر"
  },
  {
    "poem_id": 1923,
    "vorder": 23,
    "position": 0,
    "text": "بخور هرچ داری به فردا مپای"
  },
  {
    "poem_id": 1923,
    "vorder": 24,
    "position": 1,
    "text": "که فردا مگر دیگر آیدش رای"
  },
  {
    "poem_id": 1923,
    "vorder": 25,
    "position": 0,
    "text": "ستاند ز تو دیگری را دهد"
  },
  {
    "poem_id": 1923,
    "vorder": 26,
    "position": 1,
    "text": "جهان خوانیش بی‌گمان بر جهد"
  },
  {
    "poem_id": 1923,
    "vorder": 27,
    "position": 0,
    "text": "بخور هرچ داری فزونی بده"
  },
  {
    "poem_id": 1923,
    "vorder": 28,
    "position": 1,
    "text": "تو رنجیده‌ای بهر دشمن منه"
  },
  {
    "poem_id": 1923,
    "vorder": 29,
    "position": 0,
    "text": "هرآنگه که روز تو اندر گذشت"
  },
  {
    "poem_id": 1923,
    "vorder": 30,
    "position": 1,
    "text": "نهاده همه باد گردد به دشت"
  }
]