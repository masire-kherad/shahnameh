[
  {
    "poem_id": 1874,
    "vorder": 1,
    "position": 0,
    "text": "کنون داستانهای دیرینه گوی"
  },
  {
    "poem_id": 1874,
    "vorder": 2,
    "position": 1,
    "text": "سخنهای بهرام چوبینه گوی"
  },
  {
    "poem_id": 1874,
    "vorder": 3,
    "position": 0,
    "text": "که چون او سوی شهر ترکان رسید"
  },
  {
    "poem_id": 1874,
    "vorder": 4,
    "position": 1,
    "text": "به نزد دلیر و بزرگان رسید"
  },
  {
    "poem_id": 1874,
    "vorder": 5,
    "position": 0,
    "text": "ز گردان بیدار دل ده هزار"
  },
  {
    "poem_id": 1874,
    "vorder": 6,
    "position": 1,
    "text": "پذیره شدندش گزیده سوار"
  },
  {
    "poem_id": 1874,
    "vorder": 7,
    "position": 0,
    "text": "پسر با برادرش پیش اندرون"
  },
  {
    "poem_id": 1874,
    "vorder": 8,
    "position": 1,
    "text": "ابا هر یکی موبدی رهنمون"
  },
  {
    "poem_id": 1874,
    "vorder": 9,
    "position": 0,
    "text": "چو آمد بر تخت خاقان فراز"
  },
  {
    "poem_id": 1874,
    "vorder": 10,
    "position": 1,
    "text": "برو آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1874,
    "vorder": 11,
    "position": 0,
    "text": "چو خاقان ورا دید برپای جست"
  },
  {
    "poem_id": 1874,
    "vorder": 12,
    "position": 1,
    "text": "ببوسید و بسترد رویش بدست"
  },
  {
    "poem_id": 1874,
    "vorder": 13,
    "position": 0,
    "text": "بپرسید بسیارش از رنج راه"
  },
  {
    "poem_id": 1874,
    "vorder": 14,
    "position": 1,
    "text": "ز کار و ز پیکار شاه و سپاه"
  },
  {
    "poem_id": 1874,
    "vorder": 15,
    "position": 0,
    "text": "هم ایزد گشسپ و یلان سینه را"
  },
  {
    "poem_id": 1874,
    "vorder": 16,
    "position": 1,
    "text": "بپرسید و خراد برزینه را"
  },
  {
    "poem_id": 1874,
    "vorder": 17,
    "position": 0,
    "text": "چو بهرام برتخت سیمین نشست"
  },
  {
    "poem_id": 1874,
    "vorder": 18,
    "position": 1,
    "text": "گرفت آن زمان دست خاقان بدست"
  },
  {
    "poem_id": 1874,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت کای مهتر بافرین"
  },
  {
    "poem_id": 1874,
    "vorder": 20,
    "position": 1,
    "text": "سپهدار ترکان و سالار چین"
  },
  {
    "poem_id": 1874,
    "vorder": 21,
    "position": 0,
    "text": "تو دانی که از شهریار جهان"
  },
  {
    "poem_id": 1874,
    "vorder": 22,
    "position": 1,
    "text": "نباشد کسی ایمن اندر نهان"
  },
  {
    "poem_id": 1874,
    "vorder": 23,
    "position": 0,
    "text": "بر آساید از گنج و بگزایدش"
  },
  {
    "poem_id": 1874,
    "vorder": 24,
    "position": 1,
    "text": "تن آسان کند رنج بفزایدش"
  },
  {
    "poem_id": 1874,
    "vorder": 25,
    "position": 0,
    "text": "گر ایدون که اندر پذیری مرا"
  },
  {
    "poem_id": 1874,
    "vorder": 26,
    "position": 1,
    "text": "بهرنیک و بد دست‌گیری مرا"
  },
  {
    "poem_id": 1874,
    "vorder": 27,
    "position": 0,
    "text": "بدین مرز بی‌یار یار توام"
  },
  {
    "poem_id": 1874,
    "vorder": 28,
    "position": 1,
    "text": "بهر نیک و بد غمگسار توام"
  },
  {
    "poem_id": 1874,
    "vorder": 29,
    "position": 0,
    "text": "وگر هیچ رنج آیدت بگذرم"
  },
  {
    "poem_id": 1874,
    "vorder": 30,
    "position": 1,
    "text": "زمین را سراسر بپی بسپرم"
  },
  {
    "poem_id": 1874,
    "vorder": 31,
    "position": 0,
    "text": "گر ایدون که باشی تو همداستان"
  },
  {
    "poem_id": 1874,
    "vorder": 32,
    "position": 1,
    "text": "از ایدر شوم تا به هندوستان"
  },
  {
    "poem_id": 1874,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت خاقان که ای سرفراز"
  },
  {
    "poem_id": 1874,
    "vorder": 34,
    "position": 1,
    "text": "بدین روز هرگز مبادت نیاز"
  },
  {
    "poem_id": 1874,
    "vorder": 35,
    "position": 0,
    "text": "بدارم تو را همچو پیوند خویش"
  },
  {
    "poem_id": 1874,
    "vorder": 36,
    "position": 1,
    "text": "چه پیوند برتر ز فرزند خویش"
  },
  {
    "poem_id": 1874,
    "vorder": 37,
    "position": 0,
    "text": "همه بوم با من بدین یاورند"
  },
  {
    "poem_id": 1874,
    "vorder": 38,
    "position": 1,
    "text": "اگر کهترانند اگر مهترند"
  },
  {
    "poem_id": 1874,
    "vorder": 39,
    "position": 0,
    "text": "تو را بر سران سرفرازی دهم"
  },
  {
    "poem_id": 1874,
    "vorder": 40,
    "position": 1,
    "text": "هم از مهتران بی‌نیازی دهم"
  },
  {
    "poem_id": 1874,
    "vorder": 41,
    "position": 0,
    "text": "بدین نیز بهرام سوگند خواست"
  },
  {
    "poem_id": 1874,
    "vorder": 42,
    "position": 1,
    "text": "زیان بود بر جان او بند خواست"
  },
  {
    "poem_id": 1874,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت خاقان به برتر خدای"
  },
  {
    "poem_id": 1874,
    "vorder": 44,
    "position": 1,
    "text": "که هست او مرا و تو را رهنمای"
  },
  {
    "poem_id": 1874,
    "vorder": 45,
    "position": 0,
    "text": "که تا زنده‌ام ویژه یار توام"
  },
  {
    "poem_id": 1874,
    "vorder": 46,
    "position": 1,
    "text": "بهر نیک و بد غمگسار توام"
  },
  {
    "poem_id": 1874,
    "vorder": 47,
    "position": 0,
    "text": "ازان پس دو ایوان بیاراستند"
  },
  {
    "poem_id": 1874,
    "vorder": 48,
    "position": 1,
    "text": "زهر گونه‌ای جامه‌ها خواستند"
  },
  {
    "poem_id": 1874,
    "vorder": 49,
    "position": 0,
    "text": "پرستنده و پوشش و خوردنی"
  },
  {
    "poem_id": 1874,
    "vorder": 50,
    "position": 1,
    "text": "ز چیزی که بایست گستردنی"
  },
  {
    "poem_id": 1874,
    "vorder": 51,
    "position": 0,
    "text": "ز سیمین و زرین که آید به کار"
  },
  {
    "poem_id": 1874,
    "vorder": 52,
    "position": 1,
    "text": "ز دینار وز گوهر شاهوار"
  },
  {
    "poem_id": 1874,
    "vorder": 53,
    "position": 0,
    "text": "فرستاد خاقان به نزدیک اوی"
  },
  {
    "poem_id": 1874,
    "vorder": 54,
    "position": 1,
    "text": "درخشنده شد جان تاریک اوی"
  },
  {
    "poem_id": 1874,
    "vorder": 55,
    "position": 0,
    "text": "به چوگان و مجلس به دشت شکار"
  },
  {
    "poem_id": 1874,
    "vorder": 56,
    "position": 1,
    "text": "نرفتی مگر کو بدی غمگسار"
  },
  {
    "poem_id": 1874,
    "vorder": 57,
    "position": 0,
    "text": "برین گونه بر بود خاقان چین"
  },
  {
    "poem_id": 1874,
    "vorder": 58,
    "position": 1,
    "text": "همی‌خواند بهرام را آفرین"
  },
  {
    "poem_id": 1874,
    "vorder": 59,
    "position": 0,
    "text": "یکی نامبردار بد یار اوی"
  },
  {
    "poem_id": 1874,
    "vorder": 60,
    "position": 1,
    "text": "برزم اندرون دست بردار اوی"
  },
  {
    "poem_id": 1874,
    "vorder": 61,
    "position": 0,
    "text": "ازو مه به گوهر مقاتوره نام"
  },
  {
    "poem_id": 1874,
    "vorder": 62,
    "position": 1,
    "text": "که خاقان ازو یافتی نام و کام"
  },
  {
    "poem_id": 1874,
    "vorder": 63,
    "position": 0,
    "text": "به شبگیر نزدیک خاقان شدی"
  },
  {
    "poem_id": 1874,
    "vorder": 64,
    "position": 1,
    "text": "دولب را به انگشت خود بر زدی"
  },
  {
    "poem_id": 1874,
    "vorder": 65,
    "position": 0,
    "text": "بران سان که کهتر کند آفرین"
  },
  {
    "poem_id": 1874,
    "vorder": 66,
    "position": 1,
    "text": "بران نامبردار سالار چین"
  },
  {
    "poem_id": 1874,
    "vorder": 67,
    "position": 0,
    "text": "هم آنگه زدینار بردی هزار"
  },
  {
    "poem_id": 1874,
    "vorder": 68,
    "position": 1,
    "text": "ز گنج جهاندیده نامدار"
  },
  {
    "poem_id": 1874,
    "vorder": 69,
    "position": 0,
    "text": "همی‌دید بهرام یک چندگاه"
  },
  {
    "poem_id": 1874,
    "vorder": 70,
    "position": 1,
    "text": "به خاقان همی‌کرد خیره نگاه"
  },
  {
    "poem_id": 1874,
    "vorder": 71,
    "position": 0,
    "text": "بخندید یک روز گفت ای بلند"
  },
  {
    "poem_id": 1874,
    "vorder": 72,
    "position": 1,
    "text": "توی بر مهان جهان ارجمند"
  },
  {
    "poem_id": 1874,
    "vorder": 73,
    "position": 0,
    "text": "بهر بامدادی بهنگام بار"
  },
  {
    "poem_id": 1874,
    "vorder": 74,
    "position": 1,
    "text": "چنین مرد دینار خواهد هزار"
  },
  {
    "poem_id": 1874,
    "vorder": 75,
    "position": 0,
    "text": "ببخشش گرین بیستگانی بود"
  },
  {
    "poem_id": 1874,
    "vorder": 76,
    "position": 1,
    "text": "همه بهر او زرکانی بود"
  },
  {
    "poem_id": 1874,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت خاقان که آیین ما"
  },
  {
    "poem_id": 1874,
    "vorder": 78,
    "position": 1,
    "text": "چنین است و افروزش دین ما"
  },
  {
    "poem_id": 1874,
    "vorder": 79,
    "position": 0,
    "text": "که از ما هر آنکس که جنگی ترست"
  },
  {
    "poem_id": 1874,
    "vorder": 80,
    "position": 1,
    "text": "به هنگام سختی درنگی ترست"
  },
  {
    "poem_id": 1874,
    "vorder": 81,
    "position": 0,
    "text": "چو خواهد فزونی نداریم باز"
  },
  {
    "poem_id": 1874,
    "vorder": 82,
    "position": 1,
    "text": "ز مردان رزم آور جنگ ساز"
  },
  {
    "poem_id": 1874,
    "vorder": 83,
    "position": 0,
    "text": "فزونی مر او راست برما کنون"
  },
  {
    "poem_id": 1874,
    "vorder": 84,
    "position": 1,
    "text": "بدینار خوانیم بر وی فسون"
  },
  {
    "poem_id": 1874,
    "vorder": 85,
    "position": 0,
    "text": "چو زو بازگیرم بجوشد سپاه"
  },
  {
    "poem_id": 1874,
    "vorder": 86,
    "position": 1,
    "text": "ز لشکر شود روز روشن سیاه"
  },
  {
    "poem_id": 1874,
    "vorder": 87,
    "position": 0,
    "text": "جهانجوی گفت ای سر انجمن"
  },
  {
    "poem_id": 1874,
    "vorder": 88,
    "position": 1,
    "text": "تو کردی و را خیره بر خویشتن"
  },
  {
    "poem_id": 1874,
    "vorder": 89,
    "position": 0,
    "text": "چو باشد جهاندار بیدار و گرد"
  },
  {
    "poem_id": 1874,
    "vorder": 90,
    "position": 1,
    "text": "عنان را به کهتر نباید سپرد"
  },
  {
    "poem_id": 1874,
    "vorder": 91,
    "position": 0,
    "text": "اگر زو رهانم تو را شایدت"
  },
  {
    "poem_id": 1874,
    "vorder": 92,
    "position": 1,
    "text": "وگر ویژه آزرم او بایدت"
  },
  {
    "poem_id": 1874,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت خاقان که فرمان تو راست"
  },
  {
    "poem_id": 1874,
    "vorder": 94,
    "position": 1,
    "text": "بدین آرزو رای و پیمان تو راست"
  },
  {
    "poem_id": 1874,
    "vorder": 95,
    "position": 0,
    "text": "مرا گر توانی رهانید ازوی"
  },
  {
    "poem_id": 1874,
    "vorder": 96,
    "position": 1,
    "text": "سرآورده باشی همه گفت و گوی"
  },
  {
    "poem_id": 1874,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت بهرام که اکنون پگاه"
  },
  {
    "poem_id": 1874,
    "vorder": 98,
    "position": 1,
    "text": "چو آید مقاتوره دینار خواه"
  },
  {
    "poem_id": 1874,
    "vorder": 99,
    "position": 0,
    "text": "مخند و بر و هیچ مگشای چشم"
  },
  {
    "poem_id": 1874,
    "vorder": 100,
    "position": 1,
    "text": "مده پاسخ و گر دهی جز به خشم"
  },
  {
    "poem_id": 1874,
    "vorder": 101,
    "position": 0,
    "text": "گذشت آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1874,
    "vorder": 102,
    "position": 1,
    "text": "بیامد مقاتوره نزدیک شاه"
  },
  {
    "poem_id": 1874,
    "vorder": 103,
    "position": 0,
    "text": "جهاندار خاقان بدو ننگرید"
  },
  {
    "poem_id": 1874,
    "vorder": 104,
    "position": 1,
    "text": "نه گفتار آن ترک جنگی شنید"
  },
  {
    "poem_id": 1874,
    "vorder": 105,
    "position": 0,
    "text": "ز خاقان مقاتوره آمد بخشم"
  },
  {
    "poem_id": 1874,
    "vorder": 106,
    "position": 1,
    "text": "یکایک برآشفت و بگشاد چشم"
  },
  {
    "poem_id": 1874,
    "vorder": 107,
    "position": 0,
    "text": "بخاقان چین گفت کای نامدار"
  },
  {
    "poem_id": 1874,
    "vorder": 108,
    "position": 1,
    "text": "چرا گشتم امروز پیش تو خوار"
  },
  {
    "poem_id": 1874,
    "vorder": 109,
    "position": 0,
    "text": "همانا که این مهتر پارسی"
  },
  {
    "poem_id": 1874,
    "vorder": 110,
    "position": 1,
    "text": "که آمد بدین مرز با یار سی"
  },
  {
    "poem_id": 1874,
    "vorder": 111,
    "position": 0,
    "text": "بکوشد همی تا بپیچی ز داد"
  },
  {
    "poem_id": 1874,
    "vorder": 112,
    "position": 1,
    "text": "سپاه تو را داد خواهد بباد"
  },
  {
    "poem_id": 1874,
    "vorder": 113,
    "position": 0,
    "text": "بدو گفت بهرام که ای جنگوی"
  },
  {
    "poem_id": 1874,
    "vorder": 114,
    "position": 1,
    "text": "چرا تیزگشتی بدین گفت وگوی"
  },
  {
    "poem_id": 1874,
    "vorder": 115,
    "position": 0,
    "text": "چو خاقان برد راه و فرمان من"
  },
  {
    "poem_id": 1874,
    "vorder": 116,
    "position": 1,
    "text": "خرد را نپیچد ز پیمان من"
  },
  {
    "poem_id": 1874,
    "vorder": 117,
    "position": 0,
    "text": "نمانم که آیی تو هر بامداد"
  },
  {
    "poem_id": 1874,
    "vorder": 118,
    "position": 1,
    "text": "تن آسان دهی گنج او را به باد"
  },
  {
    "poem_id": 1874,
    "vorder": 119,
    "position": 0,
    "text": "بران نه که هستی تو سیصد سوار"
  },
  {
    "poem_id": 1874,
    "vorder": 120,
    "position": 1,
    "text": "به رزم اندرون شیرجویی شکار"
  },
  {
    "poem_id": 1874,
    "vorder": 121,
    "position": 0,
    "text": "نیرزد که هر بامداد پگاه"
  },
  {
    "poem_id": 1874,
    "vorder": 122,
    "position": 1,
    "text": "به خروار دینار خواهی ز شاه"
  },
  {
    "poem_id": 1874,
    "vorder": 123,
    "position": 0,
    "text": "مقاتوره بشنید گفتار اوی"
  },
  {
    "poem_id": 1874,
    "vorder": 124,
    "position": 1,
    "text": "سرش گشت پرکین ز آزار اوی"
  },
  {
    "poem_id": 1874,
    "vorder": 125,
    "position": 0,
    "text": "بخشم و به تندی بیازید چنگ"
  },
  {
    "poem_id": 1874,
    "vorder": 126,
    "position": 1,
    "text": "ز ترکش برآورد تیر خدنگ"
  },
  {
    "poem_id": 1874,
    "vorder": 127,
    "position": 0,
    "text": "به بهرام گفت این نشان منست"
  },
  {
