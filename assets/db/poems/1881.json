[
  {
    "poem_id": 1881,
    "vorder": 1,
    "position": 0,
    "text": "وزان روی بهرام شد تا به مرو"
  },
  {
    "poem_id": 1881,
    "vorder": 2,
    "position": 1,
    "text": "بیاراست لشکر چو پر تذرو"
  },
  {
    "poem_id": 1881,
    "vorder": 3,
    "position": 0,
    "text": "کس آمد به خاقان که از ترک و چین"
  },
  {
    "poem_id": 1881,
    "vorder": 4,
    "position": 1,
    "text": "ممان‌تا کس آید به ایران زمین"
  },
  {
    "poem_id": 1881,
    "vorder": 5,
    "position": 0,
    "text": "که آگاهی ما به خسرو برند"
  },
  {
    "poem_id": 1881,
    "vorder": 6,
    "position": 1,
    "text": "ورا زان سخن هدیهٔ نو برند"
  },
  {
    "poem_id": 1881,
    "vorder": 7,
    "position": 0,
    "text": "منادیگری کرد خاقان چین"
  },
  {
    "poem_id": 1881,
    "vorder": 8,
    "position": 1,
    "text": "که بی‌مهر ماکس به ایران زمین"
  },
  {
    "poem_id": 1881,
    "vorder": 9,
    "position": 0,
    "text": "شود تامیانش کنم بدو نیم"
  },
  {
    "poem_id": 1881,
    "vorder": 10,
    "position": 1,
    "text": "به یزدان که نفروشم او را به سیم"
  },
  {
    "poem_id": 1881,
    "vorder": 11,
    "position": 0,
    "text": "همی‌بود خراد برزین سه ماه"
  },
  {
    "poem_id": 1881,
    "vorder": 12,
    "position": 1,
    "text": "همی‌داشت این رازها را نگاه"
  },
  {
    "poem_id": 1881,
    "vorder": 13,
    "position": 0,
    "text": "به تنگی دل اندر قلون را بخواند"
  },
  {
    "poem_id": 1881,
    "vorder": 14,
    "position": 1,
    "text": "بران نامور جایگاهش نشاند"
  },
  {
    "poem_id": 1881,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت روزی که کس در جهان"
  },
  {
    "poem_id": 1881,
    "vorder": 16,
    "position": 1,
    "text": "ندارد دلی کش نباشد نهان"
  },
  {
    "poem_id": 1881,
    "vorder": 17,
    "position": 0,
    "text": "تو نان جو و ارزن و پوستین"
  },
  {
    "poem_id": 1881,
    "vorder": 18,
    "position": 1,
    "text": "فراوان به جستی ز هردر به چین"
  },
  {
    "poem_id": 1881,
    "vorder": 19,
    "position": 0,
    "text": "کنون خوردنیهات نان و بره"
  },
  {
    "poem_id": 1881,
    "vorder": 20,
    "position": 1,
    "text": "همان پوششت جامه‌های سره"
  },
  {
    "poem_id": 1881,
    "vorder": 21,
    "position": 0,
    "text": "چنان بود یک چند و اکنون چنین"
  },
  {
    "poem_id": 1881,
    "vorder": 22,
    "position": 1,
    "text": "چه نفرین شنیدی و چه آفرین"
  },
  {
    "poem_id": 1881,
    "vorder": 23,
    "position": 0,
    "text": "کنون روزگار تو بر سرگذشت"
  },
  {
    "poem_id": 1881,
    "vorder": 24,
    "position": 1,
    "text": "بسی روز و شب دیدی و کوه و دشت"
  },
  {
    "poem_id": 1881,
    "vorder": 25,
    "position": 0,
    "text": "یکی کار دارم تو را بیمناک"
  },
  {
    "poem_id": 1881,
    "vorder": 26,
    "position": 1,
    "text": "اگرتخت یابی اگر تیره خاک"
  },
  {
    "poem_id": 1881,
    "vorder": 27,
    "position": 0,
    "text": "ستانم یکی مهر خاقان چین"
  },
  {
    "poem_id": 1881,
    "vorder": 28,
    "position": 1,
    "text": "چنان رو که اندر نوردی زمین"
  },
  {
    "poem_id": 1881,
    "vorder": 29,
    "position": 0,
    "text": "به نزدیک بهرام باید شدن"
  },
  {
    "poem_id": 1881,
    "vorder": 30,
    "position": 1,
    "text": "به مروت فراوان بباید بدن"
  },
  {
    "poem_id": 1881,
    "vorder": 31,
    "position": 0,
    "text": "بپوشی همان پوستین سیاه"
  },
  {
    "poem_id": 1881,
    "vorder": 32,
    "position": 1,
    "text": "یکی کارد بستان و بنورد راه"
  },
  {
    "poem_id": 1881,
    "vorder": 33,
    "position": 0,
    "text": "نگه دار از آن ماه بهرام روز"
  },
  {
    "poem_id": 1881,
    "vorder": 34,
    "position": 1,
    "text": "برو تا در مرو گیتی فروز"
  },
  {
    "poem_id": 1881,
    "vorder": 35,
    "position": 0,
    "text": "وی آن روز را شوم دارد به فال"
  },
  {
    "poem_id": 1881,
    "vorder": 36,
    "position": 1,
    "text": "نگه داشتیم بسیار سال"
  },
  {
    "poem_id": 1881,
    "vorder": 37,
    "position": 0,
    "text": "نخواهد که انبوه باشد برش"
  },
  {
    "poem_id": 1881,
    "vorder": 38,
    "position": 1,
    "text": "به دیبای چینی بپوشد سرش"
  },
  {
    "poem_id": 1881,
    "vorder": 39,
    "position": 0,
    "text": "چنین گوی کز دخت خاقان پیام"
  },
  {
    "poem_id": 1881,
    "vorder": 40,
    "position": 1,
    "text": "رسانم برین مهتر شادکام"
  },
  {
    "poem_id": 1881,
    "vorder": 41,
    "position": 0,
    "text": "همان کارد در آستین برهنه"
  },
  {
    "poem_id": 1881,
    "vorder": 42,
    "position": 1,
    "text": "همی‌دار تا خواندت یک تنه"
  },
  {
    "poem_id": 1881,
    "vorder": 43,
    "position": 0,
    "text": "چو نزدیک چوبینه آیی فراز"
  },
  {
    "poem_id": 1881,
    "vorder": 44,
    "position": 1,
    "text": "چنین گوی کان دختر سرفراز"
  },
  {
    "poem_id": 1881,
    "vorder": 45,
    "position": 0,
    "text": "مرا گفت چون راز گویی بگوش"
  },
  {
    "poem_id": 1881,
    "vorder": 46,
    "position": 1,
    "text": "سخنها ز بیگانه مردم بپوش"
  },
  {
    "poem_id": 1881,
    "vorder": 47,
    "position": 0,
    "text": "چو گوید چه رازست با من بگوی"
  },
  {
    "poem_id": 1881,
    "vorder": 48,
    "position": 1,
    "text": "تو بشتاب و نزدیک بهرام پوی"
  },
  {
    "poem_id": 1881,
    "vorder": 49,
    "position": 0,
    "text": "بزن کارد و نافش سراسر بدر"
  },
  {
    "poem_id": 1881,
    "vorder": 50,
    "position": 1,
    "text": "وزان پس بجه گر بیابی گذر"
  },
  {
    "poem_id": 1881,
    "vorder": 51,
    "position": 0,
    "text": "هر آنکس که آواز او بشنود"
  },
  {
    "poem_id": 1881,
    "vorder": 52,
    "position": 1,
    "text": "ز پیش سهبد به آخر دود"
  },
  {
    "poem_id": 1881,
    "vorder": 53,
    "position": 0,
    "text": "یکی سوی فرش و یکی سوی گنج"
  },
  {
    "poem_id": 1881,
    "vorder": 54,
    "position": 1,
    "text": "نیاید ز کشتن بروی تو رنج"
  },
  {
    "poem_id": 1881,
    "vorder": 55,
    "position": 0,
    "text": "وگر خود کشندت جهاندیده‌ای"
  },
  {
    "poem_id": 1881,
    "vorder": 56,
    "position": 1,
    "text": "همه نیک و بدها پسندیده‌ای"
  },
  {
    "poem_id": 1881,
    "vorder": 57,
    "position": 0,
    "text": "همانا بتو کس نپردازدی"
  },
  {
    "poem_id": 1881,
    "vorder": 58,
    "position": 1,
    "text": "که با تو بدانگه بدی سازدی"
  },
  {
    "poem_id": 1881,
    "vorder": 59,
    "position": 0,
    "text": "گر ایدون که یابی زکشتن رها"
  },
  {
    "poem_id": 1881,
    "vorder": 60,
    "position": 1,
    "text": "جهان را خریدی و دادی بها"
  },
  {
    "poem_id": 1881,
    "vorder": 61,
    "position": 0,
    "text": "تو را شاه پرویز شهری دهد"
  },
  {
    "poem_id": 1881,
    "vorder": 62,
    "position": 1,
    "text": "همان از جهان نیز بهری دهد"
  },
  {
    "poem_id": 1881,
    "vorder": 63,
    "position": 0,
    "text": "چنین گفت با مرد دانا قلون"
  },
  {
    "poem_id": 1881,
    "vorder": 64,
    "position": 1,
    "text": "که اکنون بباید یکی رهنمون"
  },
  {
    "poem_id": 1881,
    "vorder": 65,
    "position": 0,
    "text": "همانا مرا سال بر صد رسید"
  },
  {
    "poem_id": 1881,
    "vorder": 66,
    "position": 1,
    "text": "به بیچارگی چند خواهم کشید"
  },
  {
    "poem_id": 1881,
    "vorder": 67,
    "position": 0,
    "text": "فدای تو بادا تن و جان من"
  },
  {
    "poem_id": 1881,
    "vorder": 68,
    "position": 1,
    "text": "به بیچارگی بر جهانبان من"
  },
  {
    "poem_id": 1881,
    "vorder": 69,
    "position": 0,
    "text": "چو بشنید خراد برزین دوید"
  },
  {
    "poem_id": 1881,
    "vorder": 70,
    "position": 1,
    "text": "ازان خانه تا پیش خاتون رسید"
  },
  {
    "poem_id": 1881,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت کامد گه آرزوی"
  },
  {
    "poem_id": 1881,
    "vorder": 72,
    "position": 1,
    "text": "بگویم تو را ای زن نیک خوی"
  },
  {
    "poem_id": 1881,
    "vorder": 73,
    "position": 0,
    "text": "ببند اندرند این دو کسهای من"
  },
  {
    "poem_id": 1881,
    "vorder": 74,
    "position": 1,
    "text": "سزد گرگشاده کنی پای من"
  },
  {
    "poem_id": 1881,
    "vorder": 75,
    "position": 0,
    "text": "یکی مهر بستان ز خاقان مرا"
  },
  {
    "poem_id": 1881,
    "vorder": 76,
    "position": 1,
    "text": "چنان دان که بخشیده‌ای جان مرا"
  },
  {
    "poem_id": 1881,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت خاتون که خفتست مست"
  },
  {
    "poem_id": 1881,
    "vorder": 78,
    "position": 1,
    "text": "مگر گل نهم از نگینش بدست"
  },
  {
    "poem_id": 1881,
    "vorder": 79,
    "position": 0,
    "text": "ز خراد برزین گل مهر خواست"
  },
  {
    "poem_id": 1881,
    "vorder": 80,
    "position": 1,
    "text": "به بالین مست آمد از حجره راست"
  },
  {
    "poem_id": 1881,
    "vorder": 81,
    "position": 0,
    "text": "گل اندر زمان برنگینش نهاد"
  },
  {
    "poem_id": 1881,
    "vorder": 82,
    "position": 1,
    "text": "بیامد بران مرد جوینده داد"
  },
  {
    "poem_id": 1881,
    "vorder": 83,
    "position": 0,
    "text": "بدو آفرین کرد مرد دبیر"
  },
  {
    "poem_id": 1881,
    "vorder": 84,
    "position": 1,
    "text": "بیامد سپرد آن بدین مرد پیر"
  }
]