[
  {
    "poem_id": 1397,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت پس شاه گردن فراز"
  },
  {
    "poem_id": 1397,
    "vorder": 2,
    "position": 1,
    "text": "کزین هرچه گفتید دارید راز"
  },
  {
    "poem_id": 1397,
    "vorder": 3,
    "position": 0,
    "text": "بخواند آن زمان زال را شهریار"
  },
  {
    "poem_id": 1397,
    "vorder": 4,
    "position": 1,
    "text": "کزو خواست کردن سخن خواستار"
  },
  {
    "poem_id": 1397,
    "vorder": 5,
    "position": 0,
    "text": "بدان تا بپرسند ازو چند چیز"
  },
  {
    "poem_id": 1397,
    "vorder": 6,
    "position": 1,
    "text": "نهفته سخنهای دیرینه نیز"
  },
  {
    "poem_id": 1397,
    "vorder": 7,
    "position": 0,
    "text": "نشستند بیدار دل بخردان"
  },
  {
    "poem_id": 1397,
    "vorder": 8,
    "position": 1,
    "text": "همان زال با نامور موبدان"
  },
  {
    "poem_id": 1397,
    "vorder": 9,
    "position": 0,
    "text": "بپرسید مر زال را موبدی"
  },
  {
    "poem_id": 1397,
    "vorder": 10,
    "position": 1,
    "text": "ازین تیزهش راه‌بین بخردی"
  },
  {
    "poem_id": 1397,
    "vorder": 11,
    "position": 0,
    "text": "که از ده و دو تای سرو سهی"
  },
  {
    "poem_id": 1397,
    "vorder": 12,
    "position": 1,
    "text": "که رُسته‌ست شاداب با فرهی"
  },
  {
    "poem_id": 1397,
    "vorder": 13,
    "position": 0,
    "text": "ازآن برزده هر یکی شاخ سی"
  },
  {
    "poem_id": 1397,
    "vorder": 14,
    "position": 1,
    "text": "نگردد کم و بیش در پارسی"
  },
  {
    "poem_id": 1397,
    "vorder": 15,
    "position": 0,
    "text": "دگر موبدی گفت کای سرفراز"
  },
  {
    "poem_id": 1397,
    "vorder": 16,
    "position": 1,
    "text": "دو اسپ گرانمایه و تیزتاز"
  },
  {
    "poem_id": 1397,
    "vorder": 17,
    "position": 0,
    "text": "یکی زان به کردار دریای قار"
  },
  {
    "poem_id": 1397,
    "vorder": 18,
    "position": 1,
    "text": "یکی چون بلور سپید آبدار"
  },
  {
    "poem_id": 1397,
    "vorder": 19,
    "position": 0,
    "text": "بجنبید و هر دو شتابنده‌اند"
  },
  {
    "poem_id": 1397,
    "vorder": 20,
    "position": 1,
    "text": "همان یکدیگر را نیابنده‌اند"
  },
  {
    "poem_id": 1397,
    "vorder": 21,
    "position": 0,
    "text": "سه‌دیگر چنین گفت کان سی سوار"
  },
  {
    "poem_id": 1397,
    "vorder": 22,
    "position": 1,
    "text": "کجا بگذرانند بر شهریار"
  },
  {
    "poem_id": 1397,
    "vorder": 23,
    "position": 0,
    "text": "یکی کم شود باز چون بشمری"
  },
  {
    "poem_id": 1397,
    "vorder": 24,
    "position": 1,
    "text": "همان سی بود باز چون بنگری"
  },
  {
    "poem_id": 1397,
    "vorder": 25,
    "position": 0,
    "text": "چهارم چنین گفت کان مرغزار"
  },
  {
    "poem_id": 1397,
    "vorder": 26,
    "position": 1,
    "text": "که بینی پر از سبزه و جویبار"
  },
  {
    "poem_id": 1397,
    "vorder": 27,
    "position": 0,
    "text": "یکی مرد با تیز داسی بزرگ"
  },
  {
    "poem_id": 1397,
    "vorder": 28,
    "position": 1,
    "text": "سوی مرغزار اندر آید سترگ"
  },
  {
    "poem_id": 1397,
    "vorder": 29,
    "position": 0,
    "text": "همی بدرود آن گیا خشک و تر"
  },
  {
    "poem_id": 1397,
    "vorder": 30,
    "position": 1,
    "text": "نه بردارد او هیچ ازآن کار سر"
  },
  {
    "poem_id": 1397,
    "vorder": 31,
    "position": 0,
    "text": "دگر گفت کان برکشیده دو سرو"
  },
  {
    "poem_id": 1397,
    "vorder": 32,
    "position": 1,
    "text": "ز دریای با موج برسان غرو"
  },
  {
    "poem_id": 1397,
    "vorder": 33,
    "position": 0,
    "text": "یکی مرغ دارد بریشان کنام"
  },
  {
    "poem_id": 1397,
    "vorder": 34,
    "position": 1,
    "text": "نشیمش به شام آن بود این به بام"
  },
  {
    "poem_id": 1397,
    "vorder": 35,
    "position": 0,
    "text": "ازین چون بپرد شود برگ خشک"
  },
  {
    "poem_id": 1397,
    "vorder": 36,
    "position": 1,
    "text": "برآن بر نشیند دهد بوی مشک"
  },
  {
    "poem_id": 1397,
    "vorder": 37,
    "position": 0,
    "text": "ازآن دو همیشه یکی آبدار"
  },
  {
    "poem_id": 1397,
    "vorder": 38,
    "position": 1,
    "text": "یکی پژمریده شده سوگوار"
  },
  {
    "poem_id": 1397,
    "vorder": 39,
    "position": 0,
    "text": "بپرسید دیگر که بر کوهسار"
  },
  {
    "poem_id": 1397,
    "vorder": 40,
    "position": 1,
    "text": "یکی شارستان یافتم استوار"
  },
  {
    "poem_id": 1397,
    "vorder": 41,
    "position": 0,
    "text": "خرامند مردم ازان شارستان"
  },
  {
    "poem_id": 1397,
    "vorder": 42,
    "position": 1,
    "text": "گرفته به هامون یکی خارستان"
  },
  {
    "poem_id": 1397,
    "vorder": 43,
    "position": 0,
    "text": "بناها کشیدند سر تا به ماه"
  },
  {
    "poem_id": 1397,
    "vorder": 44,
    "position": 1,
    "text": "پرستنده گشتند و هم پیشگاه"
  },
  {
    "poem_id": 1397,
    "vorder": 45,
    "position": 0,
    "text": "وزآن شارستان‌شان به دل نگذرد"
  },
  {
    "poem_id": 1397,
    "vorder": 46,
    "position": 1,
    "text": "کس از یاد کردن سخن نشمرد"
  },
  {
    "poem_id": 1397,
    "vorder": 47,
    "position": 0,
    "text": "یکی بومهین خیزد از ناگهان"
  },
  {
    "poem_id": 1397,
    "vorder": 48,
    "position": 1,
    "text": "بر و بومشان پاک گردد نهان"
  },
  {
    "poem_id": 1397,
    "vorder": 49,
    "position": 0,
    "text": "بدان شارستان‌شان نیاز آورد"
  },
  {
    "poem_id": 1397,
    "vorder": 50,
    "position": 1,
    "text": "هم اندیشگان دراز آورد"
  },
  {
    "poem_id": 1397,
    "vorder": 51,
    "position": 0,
    "text": "به پرده درست این سخنها بجوی"
  },
  {
    "poem_id": 1397,
    "vorder": 52,
    "position": 1,
    "text": "به پیش ردان آشکارا بگوی"
  },
  {
    "poem_id": 1397,
    "vorder": 53,
    "position": 0,
    "text": "گر این رازها آشکارا کنی"
  },
  {
    "poem_id": 1397,
    "vorder": 54,
    "position": 1,
    "text": "ز خاک سیه مشک سارا کنی"
  }
]