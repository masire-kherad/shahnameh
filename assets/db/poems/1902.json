[
  {
    "poem_id": 1902,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد ز خسرو به راه"
  },
  {
    "poem_id": 1902,
    "vorder": 2,
    "position": 1,
    "text": "به نزد بزرگان و نزد سپاه"
  },
  {
    "poem_id": 1902,
    "vorder": 3,
    "position": 0,
    "text": "که شیرین به مشکوی خسرو شدست"
  },
  {
    "poem_id": 1902,
    "vorder": 4,
    "position": 1,
    "text": "کهن بود کار جهان نوشدست"
  },
  {
    "poem_id": 1902,
    "vorder": 5,
    "position": 0,
    "text": "همه شهر زان کار غمگین شدند"
  },
  {
    "poem_id": 1902,
    "vorder": 6,
    "position": 1,
    "text": "پر اندیشه و درد و نفرین شدند"
  },
  {
    "poem_id": 1902,
    "vorder": 7,
    "position": 0,
    "text": "نرفتند نزدیک خسرو سه روز"
  },
  {
    "poem_id": 1902,
    "vorder": 8,
    "position": 1,
    "text": "چهارم چو بفروخت گیتی فروز"
  },
  {
    "poem_id": 1902,
    "vorder": 9,
    "position": 0,
    "text": "فرستاد خسرو مهان را بخواند"
  },
  {
    "poem_id": 1902,
    "vorder": 10,
    "position": 1,
    "text": "بگاه گران مایگان برنشاند"
  },
  {
    "poem_id": 1902,
    "vorder": 11,
    "position": 0,
    "text": "بدیشان چنین گفت کاین روز چند"
  },
  {
    "poem_id": 1902,
    "vorder": 12,
    "position": 1,
    "text": "ندیدم شما را شدم مستمند"
  },
  {
    "poem_id": 1902,
    "vorder": 13,
    "position": 0,
    "text": "بیازردم از بهر آزارتان"
  },
  {
    "poem_id": 1902,
    "vorder": 14,
    "position": 1,
    "text": "پراندیشه گشتم ز تیمارتان"
  },
  {
    "poem_id": 1902,
    "vorder": 15,
    "position": 0,
    "text": "همی‌گفت و پاسخ نداد ایچ‌کس"
  },
  {
    "poem_id": 1902,
    "vorder": 16,
    "position": 1,
    "text": "ز گفتن زبانها ببستند بس"
  },
  {
    "poem_id": 1902,
    "vorder": 17,
    "position": 0,
    "text": "هرآنکس که او داشت آزار و خشم"
  },
  {
    "poem_id": 1902,
    "vorder": 18,
    "position": 1,
    "text": "یکایک به موبد نمودند چشم"
  },
  {
    "poem_id": 1902,
    "vorder": 19,
    "position": 0,
    "text": "چو موبد چنان دید برپای خاست"
  },
  {
    "poem_id": 1902,
    "vorder": 20,
    "position": 1,
    "text": "به خسرو چنین گفت کای راد وراست"
  },
  {
    "poem_id": 1902,
    "vorder": 21,
    "position": 0,
    "text": "به روز جوانی شدی شهریار"
  },
  {
    "poem_id": 1902,
    "vorder": 22,
    "position": 1,
    "text": "بسی نیک و بد دیدی از روزگار"
  },
  {
    "poem_id": 1902,
    "vorder": 23,
    "position": 0,
    "text": "شنیدی بسی نیک و بد در جهان"
  },
  {
    "poem_id": 1902,
    "vorder": 24,
    "position": 1,
    "text": "ز کار بزرگان و کار مهان"
  },
  {
    "poem_id": 1902,
    "vorder": 25,
    "position": 0,
    "text": "کنون تخمهٔ مهتر آلوده شد"
  },
  {
    "poem_id": 1902,
    "vorder": 26,
    "position": 1,
    "text": "بزرگی ازین تخمهٔ پالوده شد"
  },
  {
    "poem_id": 1902,
    "vorder": 27,
    "position": 0,
    "text": "پدر پاک و مادر بود بی‌هنر"
  },
  {
    "poem_id": 1902,
    "vorder": 28,
    "position": 1,
    "text": "چنان دان که پاکی نیاید ببر"
  },
  {
    "poem_id": 1902,
    "vorder": 29,
    "position": 0,
    "text": "ز کژی نجوید کسی راستی"
  },
  {
    "poem_id": 1902,
    "vorder": 30,
    "position": 1,
    "text": "که از راستی برکنی کاستی"
  },
  {
    "poem_id": 1902,
    "vorder": 31,
    "position": 0,
    "text": "دل ما غمی شد ز دیو سترگ"
  },
  {
    "poem_id": 1902,
    "vorder": 32,
    "position": 1,
    "text": "که شد یار با شهریار بزرگ"
  },
  {
    "poem_id": 1902,
    "vorder": 33,
    "position": 0,
    "text": "به ایران اگر زن نبودی جزین"
  },
  {
    "poem_id": 1902,
    "vorder": 34,
    "position": 1,
    "text": "که خسرو بدو خواندی آفرین"
  },
  {
    "poem_id": 1902,
    "vorder": 35,
    "position": 0,
    "text": "نبودی چو شیرین به مشکوی او"
  },
  {
    "poem_id": 1902,
    "vorder": 36,
    "position": 1,
    "text": "بهر جای روشن بدی روی او"
  },
  {
    "poem_id": 1902,
    "vorder": 37,
    "position": 0,
    "text": "نیاکانت آن دانشی راستان"
  },
  {
    "poem_id": 1902,
    "vorder": 38,
    "position": 1,
    "text": "نکردند یاد از چنین داستان"
  },
  {
    "poem_id": 1902,
    "vorder": 39,
    "position": 0,
    "text": "چوگشت آن سخنهای موبد دراز"
  },
  {
    "poem_id": 1902,
    "vorder": 40,
    "position": 1,
    "text": "شهنشاه پاسخ نداد ایچ‌باز"
  },
  {
    "poem_id": 1902,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت موبد که فردا پگاه"
  },
  {
    "poem_id": 1902,
    "vorder": 42,
    "position": 1,
    "text": "بیاییم یکسر بدین بارگاه"
  },
  {
    "poem_id": 1902,
    "vorder": 43,
    "position": 0,
    "text": "مگر پاسخ شاه یابیم باز"
  },
  {
    "poem_id": 1902,
    "vorder": 44,
    "position": 1,
    "text": "که امروزمان شد سخنها دراز"
  },
  {
    "poem_id": 1902,
    "vorder": 45,
    "position": 0,
    "text": "دگر روز شبگیر برخاستند"
  },
  {
    "poem_id": 1902,
    "vorder": 46,
    "position": 1,
    "text": "همه بندگی را بیاراستند"
  },
  {
    "poem_id": 1902,
    "vorder": 47,
    "position": 0,
    "text": "یکی گفت موبد ندانست گفت"
  },
  {
    "poem_id": 1902,
    "vorder": 48,
    "position": 1,
    "text": "دگر گفت کان با خرد بود جفت"
  },
  {
    "poem_id": 1902,
    "vorder": 49,
    "position": 0,
    "text": "سیوم گفت که امروز پاسخ دهد"
  },
  {
    "poem_id": 1902,
    "vorder": 50,
    "position": 1,
    "text": "سزد زو که آواز فرخ نهد"
  },
  {
    "poem_id": 1902,
    "vorder": 51,
    "position": 0,
    "text": "همه موبدان برگرفتند راه"
  },
  {
    "poem_id": 1902,
    "vorder": 52,
    "position": 1,
    "text": "خرامان برفتند نزدیک شاه"
  },
  {
    "poem_id": 1902,
    "vorder": 53,
    "position": 0,
    "text": "بزرگان گزیدند جای نشست"
  },
  {
    "poem_id": 1902,
    "vorder": 54,
    "position": 1,
    "text": "بیامد یکی مرد تشتی بدست"
  },
  {
    "poem_id": 1902,
    "vorder": 55,
    "position": 0,
    "text": "چو خورشید رخشنده پالوده گشت"
  },
  {
    "poem_id": 1902,
    "vorder": 56,
    "position": 1,
    "text": "یکایک بران مهتران برگذشت"
  },
  {
    "poem_id": 1902,
    "vorder": 57,
    "position": 0,
    "text": "بتشت اندرون ریختش خون گرم"
  },
  {
    "poem_id": 1902,
    "vorder": 58,
    "position": 1,
    "text": "چو نزدیک شد تشت بنهاد نرم"
  },
  {
    "poem_id": 1902,
    "vorder": 59,
    "position": 0,
    "text": "از آن تشت هرکس بپیچید روی"
  },
  {
    "poem_id": 1902,
    "vorder": 60,
    "position": 1,
    "text": "همه انجمن گشت پر گفت و گوی"
  },
  {
    "poem_id": 1902,
    "vorder": 61,
    "position": 0,
    "text": "همی‌کرد هر کس به خسرو نگاه"
  },
  {
    "poem_id": 1902,
    "vorder": 62,
    "position": 1,
    "text": "همه انجمن خیره از بیم شاه"
  },
  {
    "poem_id": 1902,
    "vorder": 63,
    "position": 0,
    "text": "به ایرانیان گفت کاین خون کیست"
  },
  {
    "poem_id": 1902,
    "vorder": 64,
    "position": 1,
    "text": "نهاده بتشت اندر از بهر چیست"
  },
  {
    "poem_id": 1902,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت موبد که خون پلید"
  },
  {
    "poem_id": 1902,
    "vorder": 66,
    "position": 1,
    "text": "کزو دشمنش گشت هرکش بدید"
  },
  {
    "poem_id": 1902,
    "vorder": 67,
    "position": 0,
    "text": "چوموبد چنین گفت برداشتش"
  },
  {
    "poem_id": 1902,
    "vorder": 68,
    "position": 1,
    "text": "همه دست بردست بگذاشتش"
  },
  {
    "poem_id": 1902,
    "vorder": 69,
    "position": 0,
    "text": "ز خون تشت پر مایه کردند پاک"
  },
  {
    "poem_id": 1902,
    "vorder": 70,
    "position": 1,
    "text": "ببستند روشن به آب و به خاک"
  },
  {
    "poem_id": 1902,
    "vorder": 71,
    "position": 0,
    "text": "چو روشن شد و پاک تشت پلید"
  },
  {
    "poem_id": 1902,
    "vorder": 72,
    "position": 1,
    "text": "بکرد آنک او شسته بد پرنبید"
  },
  {
    "poem_id": 1902,
    "vorder": 73,
    "position": 0,
    "text": "بمی بر پراگند مشک وگلاب"
  },
  {
    "poem_id": 1902,
    "vorder": 74,
    "position": 1,
    "text": "شد آن تشت بی‌رنگ چون آفتاب"
  },
  {
    "poem_id": 1902,
    "vorder": 75,
    "position": 0,
    "text": "ز شیرین بران تشت بد رهنمون"
  },
  {
    "poem_id": 1902,
    "vorder": 76,
    "position": 1,
    "text": "که آغاز چون بود و فرجام چون"
  },
  {
    "poem_id": 1902,
    "vorder": 77,
    "position": 0,
    "text": "به موبد چنین گفت خسرو که تشت"
  },
  {
    "poem_id": 1902,
    "vorder": 78,
    "position": 1,
    "text": "همانا بد این گر دگرگونه گشت"
  },
  {
    "poem_id": 1902,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت موبد که نوشه بدی"
  },
  {
    "poem_id": 1902,
    "vorder": 80,
    "position": 1,
    "text": "پدیدار شد نیکوی از بدی"
  },
  {
    "poem_id": 1902,
    "vorder": 81,
    "position": 0,
    "text": "بفرمان ز دوزخ توکردی بهشت"
  },
  {
    "poem_id": 1902,
    "vorder": 82,
    "position": 1,
    "text": "همان خوب کردی تو کردار زشت"
  },
  {
    "poem_id": 1902,
    "vorder": 83,
    "position": 0,
    "text": "چنین گفت خسرو که شیرین بشهر"
  },
  {
    "poem_id": 1902,
    "vorder": 84,
    "position": 1,
    "text": "چنان بد که آن بی‌منش تشت زهر"
  },
  {
    "poem_id": 1902,
    "vorder": 85,
    "position": 0,
    "text": "کنون تشت می شد به مشکوی ما"
  },
  {
    "poem_id": 1902,
    "vorder": 86,
    "position": 1,
    "text": "برین گونه پربو شد ازبوی ما"
  },
  {
    "poem_id": 1902,
    "vorder": 87,
    "position": 0,
    "text": "ز من گشت بدنام شیرین نخست"
  },
  {
    "poem_id": 1902,
    "vorder": 88,
    "position": 1,
    "text": "ز پرمایگان نامداری نجست"
  },
  {
    "poem_id": 1902,
    "vorder": 89,
    "position": 0,
    "text": "همه مهتران خواندند آفرین"
  },
  {
    "poem_id": 1902,
    "vorder": 90,
    "position": 1,
    "text": "که بی‌تاج وتختت مبادا زمین"
  },
  {
    "poem_id": 1902,
    "vorder": 91,
    "position": 0,
    "text": "بهی آن فزاید که تو به کنی"
  },
  {
    "poem_id": 1902,
    "vorder": 92,
    "position": 1,
    "text": "مه آن شد بگیتی که تومه کنی"
  },
  {
    "poem_id": 1902,
    "vorder": 93,
    "position": 0,
    "text": "که هم شاه وهم موبد وهم ردی"
  },
  {
    "poem_id": 1902,
    "vorder": 94,
    "position": 1,
    "text": "مگر بر زمین سایهٔ ایزدی"
  }
]