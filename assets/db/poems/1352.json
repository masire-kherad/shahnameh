[
  {
    "poem_id": 1352,
    "vorder": 1,
    "position": 0,
    "text": "چنان بد که ضحاک را روز و شب"
  },
  {
    "poem_id": 1352,
    "vorder": 2,
    "position": 1,
    "text": "به نام فریدون گشادی دو لب"
  },
  {
    "poem_id": 1352,
    "vorder": 3,
    "position": 0,
    "text": "بران برز بالا ز بیم نشیب"
  },
  {
    "poem_id": 1352,
    "vorder": 4,
    "position": 1,
    "text": "شده ز آفریدون دلش پر نهیب"
  },
  {
    "poem_id": 1352,
    "vorder": 5,
    "position": 0,
    "text": "چنان بد که یک روز بر تخت عاج"
  },
  {
    "poem_id": 1352,
    "vorder": 6,
    "position": 1,
    "text": "نهاده به سر بر ز پیروزه تاج"
  },
  {
    "poem_id": 1352,
    "vorder": 7,
    "position": 0,
    "text": "ز هر کشوری مهتران را بخواست"
  },
  {
    "poem_id": 1352,
    "vorder": 8,
    "position": 1,
    "text": "که در پادشاهی کند پشت راست"
  },
  {
    "poem_id": 1352,
    "vorder": 9,
    "position": 0,
    "text": "از آن پس چنین گفت با موبدان"
  },
  {
    "poem_id": 1352,
    "vorder": 10,
    "position": 1,
    "text": "که ای پرهنر باگهر بخردان"
  },
  {
    "poem_id": 1352,
    "vorder": 11,
    "position": 0,
    "text": "مرا در نهانی یکی دشمن‌ست"
  },
  {
    "poem_id": 1352,
    "vorder": 12,
    "position": 1,
    "text": "که بر بخردان این سخن روشن است"
  },
  {
    "poem_id": 1352,
    "vorder": 13,
    "position": 0,
    "text": "به سال اندکی و به دانش بزرگ"
  },
  {
    "poem_id": 1352,
    "vorder": 14,
    "position": 1,
    "text": "گوی بدنژادی دلیر و سترگ"
  },
  {
    "poem_id": 1352,
    "vorder": 15,
    "position": 0,
    "text": "اگر چه به سال اندک ای راستان"
  },
  {
    "poem_id": 1352,
    "vorder": 16,
    "position": 1,
    "text": "درین کار موبد زدش داستان"
  },
  {
    "poem_id": 1352,
    "vorder": 17,
    "position": 0,
    "text": "که دشمن اگر چه بود خوار و خرد"
  },
  {
    "poem_id": 1352,
    "vorder": 18,
    "position": 1,
    "text": "نبایدت او را به پی بر سپرد"
  },
  {
    "poem_id": 1352,
    "vorder": 19,
    "position": 0,
    "text": "ندارم همی دشمن خرد خوار"
  },
  {
    "poem_id": 1352,
    "vorder": 20,
    "position": 1,
    "text": "بترسم همی از بد روزگار"
  },
  {
    "poem_id": 1352,
    "vorder": 21,
    "position": 0,
    "text": "همی زین فزون بایدم لشکری"
  },
  {
    "poem_id": 1352,
    "vorder": 22,
    "position": 1,
    "text": "هم از مردم و هم ز دیو و پری"
  },
  {
    "poem_id": 1352,
    "vorder": 23,
    "position": 0,
    "text": "یکی لشگری خواهم انگیختن"
  },
  {
    "poem_id": 1352,
    "vorder": 24,
    "position": 1,
    "text": "ابا دیو مردم برآمیختن"
  },
  {
    "poem_id": 1352,
    "vorder": 25,
    "position": 0,
    "text": "بباید بدین بود همداستان"
  },
  {
    "poem_id": 1352,
    "vorder": 26,
    "position": 1,
    "text": "که من ناشکیبم بدین داستان"
  },
  {
    "poem_id": 1352,
    "vorder": 27,
    "position": 0,
    "text": "یکی محضر اکنون بباید نوشت"
  },
  {
    "poem_id": 1352,
    "vorder": 28,
    "position": 1,
    "text": "که جز تخم نیکی سپهبد نکشت"
  },
  {
    "poem_id": 1352,
    "vorder": 29,
    "position": 0,
    "text": "نگوید سخن جز همه راستی"
  },
  {
    "poem_id": 1352,
    "vorder": 30,
    "position": 1,
    "text": "نخواهد به داد اندرون کاستی"
  },
  {
    "poem_id": 1352,
    "vorder": 31,
    "position": 0,
    "text": "ز بیم سپهبد همه راستان"
  },
  {
    "poem_id": 1352,
    "vorder": 32,
    "position": 1,
    "text": "بر آن کار گشتند همداستان"
  },
  {
    "poem_id": 1352,
    "vorder": 33,
    "position": 0,
    "text": "بر آن محضر اژدها ناگزیر"
  },
  {
    "poem_id": 1352,
    "vorder": 34,
    "position": 1,
    "text": "گواهی نوشتند برنا و پیر"
  },
  {
    "poem_id": 1352,
    "vorder": 35,
    "position": 0,
    "text": "هم آنگه یکایک ز درگاه شاه"
  },
  {
    "poem_id": 1352,
    "vorder": 36,
    "position": 1,
    "text": "برآمد خروشیدن دادخواه"
  },
  {
    "poem_id": 1352,
    "vorder": 37,
    "position": 0,
    "text": "ستم دیده را پیش او خواندند"
  },
  {
    "poem_id": 1352,
    "vorder": 38,
    "position": 1,
    "text": "بر نامدارانش بنشاندند"
  },
  {
    "poem_id": 1352,
    "vorder": 39,
    "position": 0,
    "text": "بدو گفت مهتر به روی دژم"
  },
  {
    "poem_id": 1352,
    "vorder": 40,
    "position": 1,
    "text": "که بر گوی تا از که دیدی ستم"
  },
  {
    "poem_id": 1352,
    "vorder": 41,
    "position": 0,
    "text": "خروشید و زد دست بر سر ز شاه"
  },
  {
    "poem_id": 1352,
    "vorder": 42,
    "position": 1,
    "text": "که شاها منم کاوهٔ دادخواه"
  },
  {
    "poem_id": 1352,
    "vorder": 43,
    "position": 0,
    "text": "یکی بی‌زیان مرد آهنگرم"
  },
  {
    "poem_id": 1352,
    "vorder": 44,
    "position": 1,
    "text": "ز شاه آتش آید همی بر سرم"
  },
  {
    "poem_id": 1352,
    "vorder": 45,
    "position": 0,
    "text": "تو شاهی و گر اژدها پیکری"
  },
  {
    "poem_id": 1352,
    "vorder": 46,
    "position": 1,
    "text": "بباید بدین داستان داوری"
  },
  {
    "poem_id": 1352,
    "vorder": 47,
    "position": 0,
    "text": "که گر هفت کشور به شاهی تراست"
  },
  {
    "poem_id": 1352,
    "vorder": 48,
    "position": 1,
    "text": "چرا رنج و سختی همه بهر ماست؟"
  },
  {
    "poem_id": 1352,
    "vorder": 49,
    "position": 0,
    "text": "شماریت با من بباید گرفت"
  },
  {
    "poem_id": 1352,
    "vorder": 50,
    "position": 1,
    "text": "بدان تا جهان ماند اندر شگفت"
  },
  {
    "poem_id": 1352,
    "vorder": 51,
    "position": 0,
    "text": "مگر کز شمار تو آید پدید"
  },
  {
    "poem_id": 1352,
    "vorder": 52,
    "position": 1,
    "text": "که نوبت ز گیتی به من چون رسید"
  },
  {
    "poem_id": 1352,
    "vorder": 53,
    "position": 0,
    "text": "که مارانت را مغز فرزند من"
  },
  {
    "poem_id": 1352,
    "vorder": 54,
    "position": 1,
    "text": "همی‌داد باید ز هر انجمن"
  },
  {
    "poem_id": 1352,
    "vorder": 55,
    "position": 0,
    "text": "سپهبد به گفتار او بنگرید"
  },
  {
    "poem_id": 1352,
    "vorder": 56,
    "position": 1,
    "text": "شگفت آمدش کان سخن‌ها شنید"
  },
  {
    "poem_id": 1352,
    "vorder": 57,
    "position": 0,
    "text": "بدو باز دادند فرزند او"
  },
  {
    "poem_id": 1352,
    "vorder": 58,
    "position": 1,
    "text": "به خوبی بجستند پیوند او"
  },
  {
    "poem_id": 1352,
    "vorder": 59,
    "position": 0,
    "text": "بفرمود پس کاوه را پادشا"
  },
  {
    "poem_id": 1352,
    "vorder": 60,
    "position": 1,
    "text": "که باشد بران محضر اندر گوا"
  },
  {
    "poem_id": 1352,
    "vorder": 61,
    "position": 0,
    "text": "چو بر خواند کاوه همه محضرش"
  },
  {
    "poem_id": 1352,
    "vorder": 62,
    "position": 1,
    "text": "سبک سوی پیران آن کشورش"
  },
  {
    "poem_id": 1352,
    "vorder": 63,
    "position": 0,
    "text": "خروشید کای پای مردان دیو"
  },
  {
    "poem_id": 1352,
    "vorder": 64,
    "position": 1,
    "text": "بریده دل از ترس گیهان خدیو"
  },
  {
    "poem_id": 1352,
    "vorder": 65,
    "position": 0,
    "text": "همه سوی دوزخ نهادید روی"
  },
  {
    "poem_id": 1352,
    "vorder": 66,
    "position": 1,
    "text": "سپردید دلها به گفتار اوی"
  },
  {
    "poem_id": 1352,
    "vorder": 67,
    "position": 0,
    "text": "نباشم بدین محضر اندر گوا"
  },
  {
    "poem_id": 1352,
    "vorder": 68,
    "position": 1,
    "text": "نه هرگز براندیشم از پادشا"
  },
  {
    "poem_id": 1352,
    "vorder": 69,
    "position": 0,
    "text": "خروشید و برجست لرزان ز جای"
  },
  {
    "poem_id": 1352,
    "vorder": 70,
    "position": 1,
    "text": "بدرید و بسپرد محضر به پای"
  },
  {
    "poem_id": 1352,
    "vorder": 71,
    "position": 0,
    "text": "گرانمایه فرزند او پیش اوی"
  },
  {
    "poem_id": 1352,
    "vorder": 72,
    "position": 1,
    "text": "ز ایوان برون شد خروشان به کوی"
  },
  {
    "poem_id": 1352,
    "vorder": 73,
    "position": 0,
    "text": "مهان شاه را خواندند آفرین"
  },
  {
    "poem_id": 1352,
    "vorder": 74,
    "position": 1,
    "text": "که ای نامور شهریار زمین"
  },
  {
    "poem_id": 1352,
    "vorder": 75,
    "position": 0,
    "text": "ز چرخ فلک بر سرت باد سرد"
  },
  {
    "poem_id": 1352,
    "vorder": 76,
    "position": 1,
    "text": "نیارد گذشتن به روز نبرد"
  },
  {
    "poem_id": 1352,
    "vorder": 77,
    "position": 0,
    "text": "چرا پیش تو کاوهٔ خام‌گوی"
  },
  {
    "poem_id": 1352,
    "vorder": 78,
    "position": 1,
    "text": "بسان همالان کند سرخ روی"
  },
  {
    "poem_id": 1352,
    "vorder": 79,
    "position": 0,
    "text": "همه محضر ما و پیمان تو"
  },
  {
    "poem_id": 1352,
    "vorder": 80,
    "position": 1,
    "text": "بدرد بپیچد ز فرمان تو"
  },
  {
    "poem_id": 1352,
    "vorder": 81,
    "position": 0,
    "text": "کی نامور پاسخ آورد زود"
  },
  {
    "poem_id": 1352,
    "vorder": 82,
    "position": 1,
    "text": "که از من شگفتی بباید شنود"
  },
  {
    "poem_id": 1352,
    "vorder": 83,
    "position": 0,
    "text": "که چون کاوه آمد ز درگه پدید"
  },
  {
    "poem_id": 1352,
    "vorder": 84,
    "position": 1,
    "text": "دو گوش من آواز او را شنید"
  },
  {
    "poem_id": 1352,
    "vorder": 85,
    "position": 0,
    "text": "میان من و او ز ایوان درست"
  },
  {
    "poem_id": 1352,
    "vorder": 86,
    "position": 1,
    "text": "تو گفتی یکی کوه آهن برست"
  },
  {
    "poem_id": 1352,
    "vorder": 87,
    "position": 0,
    "text": "ندانم چه شاید بدن زین سپس"
  },
  {
    "poem_id": 1352,
    "vorder": 88,
    "position": 1,
    "text": "که راز سپهری ندانست کس"
  },
  {
    "poem_id": 1352,
    "vorder": 89,
    "position": 0,
    "text": "چو کاوه برون شد ز درگاه شاه"
  },
  {
    "poem_id": 1352,
    "vorder": 90,
    "position": 1,
    "text": "برو انجمن گشت بازارگاه"
  },
  {
    "poem_id": 1352,
    "vorder": 91,
    "position": 0,
    "text": "همی بر خروشید و فریاد خواند"
  },
  {
    "poem_id": 1352,
    "vorder": 92,
    "position": 1,
    "text": "جهان را سراسر سوی داد خواند"
  },
  {
    "poem_id": 1352,
    "vorder": 93,
    "position": 0,
    "text": "ازان چرم کاهنگران پشت پای"
  },
  {
    "poem_id": 1352,
    "vorder": 94,
    "position": 1,
    "text": "بپوشند هنگام زخم درای"
  },
  {
    "poem_id": 1352,
    "vorder": 95,
    "position": 0,
    "text": "همان کاوه آن بر سر نیزه کرد"
  },
  {
    "poem_id": 1352,
    "vorder": 96,
    "position": 1,
    "text": "همانگه ز بازار برخاست گرد"
  },
  {
    "poem_id": 1352,
    "vorder": 97,
    "position": 0,
    "text": "خروشان همی‌رفت نیزه بدست"
  },
  {
    "poem_id": 1352,
    "vorder": 98,
    "position": 1,
    "text": "که ای نامداران یزدان پرست"
  },
  {
    "poem_id": 1352,
    "vorder": 99,
    "position": 0,
    "text": "کسی کاو هوای فریدون کند"
  },
  {
    "poem_id": 1352,
    "vorder": 100,
    "position": 1,
    "text": "دل از بند ضحاک بیرون کند"
  },
  {
    "poem_id": 1352,
    "vorder": 101,
    "position": 0,
    "text": "بپویید کاین مهتر آهرمن است"
  },
  {
    "poem_id": 1352,
    "vorder": 102,
    "position": 1,
    "text": "جهان آفرین را به دل دشمن است"
  },
  {
    "poem_id": 1352,
    "vorder": 103,
    "position": 0,
    "text": "بدان بی‌بها ناسزاوار پوست"
  },
  {
    "poem_id": 1352,
    "vorder": 104,
    "position": 1,
    "text": "پدید آمد آوای دشمن ز دوست"
  },
  {
    "poem_id": 1352,
    "vorder": 105,
    "position": 0,
    "text": "همی‌رفت پیش اندرون مرد گرد"
  },
  {
    "poem_id": 1352,
    "vorder": 106,
    "position": 1,
    "text": "جهانی برو انجمن شد نه خرد"
  },
  {
    "poem_id": 1352,
    "vorder": 107,
    "position": 0,
    "text": "بدانست خود کافریدون کجاست"
  },
  {
    "poem_id": 1352,
    "vorder": 108,
    "position": 1,
    "text": "سراندر کشید و همی‌رفت راست"
  },
  {
    "poem_id": 1352,
    "vorder": 109,
    "position": 0,
    "text": "بیامد به درگاه سالار نو"
  },
  {
    "poem_id": 1352,
    "vorder": 110,
    "position": 1,
    "text": "بدیدندش آنجا و برخاست غو"
  },
  {
    "poem_id": 1352,
    "vorder": 111,
    "position": 0,
    "text": "چو آن پوست بر نیزه بر دید کی"
  },
  {
    "poem_id": 1352,
    "vorder": 112,
    "position": 1,
    "text": "به نیکی یکی اختر افگند پی"
  },
  {
    "poem_id": 1352,
    "vorder": 113,
    "position": 0,
    "text": "بیاراست آن را به دیبای روم"
  },
  {
    "poem_id": 1352,
    "vorder": 114,
    "position": 1,
    "text": "ز گوهر بر و پیکر از زر بوم"
  },
  {
    "poem_id": 1352,
    "vorder": 115,
    "position": 0,
    "text": "بزد بر سر خویش چون گرد ماه"
  },
  {
    "poem_id": 1352,
    "vorder": 116,
    "position": 1,
    "text": "یکی فال فرخ پی افکند شاه"
  },
  {
    "poem_id": 1352,
    "vorder": 117,
    "position": 0,
    "text": "فرو هشت ازو سرخ و زرد و بنفش"
  },
  {
    "poem_id": 1352,
    "vorder": 118,
    "position": 1,
    "text": "همی‌خواندش کاویانی درفش"
  },
  {
    "poem_id": 1352,
    "vorder": 119,
    "position": 0,
    "text": "از آن پس هر آنکس که بگرفت گاه"
  },
  {
    "poem_id": 1352,
    "vorder": 120,
    "position": 1,
    "text": "به شاهی بسر برنهادی کلاه"
  },
  {
    "poem_id": 1352,
    "vorder": 121,
    "position": 0,
    "text": "بران بی‌بها چرم آهنگران"
  },
  {
    "poem_id": 1352,
    "vorder": 122,
    "position": 1,
    "text": "برآویختی نو به نو گوهران"
  },
  {
    "poem_id": 1352,
    "vorder": 123,
    "position": 0,
    "text": "ز دیبای پرمایه و پرنیان"
  },
  {
    "poem_id": 1352,
    "vorder": 124,
    "position": 1,
    "text": "برآن گونه شد اختر کاویان"
  },
  {
    "poem_id": 1352,
    "vorder": 125,
    "position": 0,
    "text": "که اندر شب تیره خورشید بود"
  },
  {
    "poem_id": 1352,
    "vorder": 126,
    "position": 1,
    "text": "جهان را ازو دل پرامید بود"
  },
  {
    "poem_id": 1352,
    "vorder": 127,
    "position": 0,
    "text": "بگشت اندرین نیز چندی جهان"
  },
  {
    "poem_id": 1352,
    "vorder": 128,
    "position": 1,
    "text": "همی بودنی داشت اندر نهان"
  },
  {
    "poem_id": 1352,
    "vorder": 129,
    "position": 0,
    "text": "فریدون چو گیتی برآن گونه دید"
  },
  {
    "poem_id": 1352,
    "vorder": 130,
    "position": 1,
    "text": "جهان پیش ضحاک وارونه دید"
  },
  {
    "poem_id": 1352,
    "vorder": 131,
    "position": 0,
    "text": "سوی مادر آمد کمر بر میان"
  },
  {
    "poem_id": 1352,
    "vorder": 132,
    "position": 1,
    "text": "به سر برنهاده کلاه کیان"
  },
  {
    "poem_id": 1352,
    "vorder": 133,
    "position": 0,
    "text": "که من رفتنی‌ام سوی کارزار"
  },
  {
    "poem_id": 1352,
    "vorder": 134,
    "position": 1,
    "text": "ترا جز نیایش مباد ایچ کار"
  },
  {
    "poem_id": 1352,
    "vorder": 135,
    "position": 0,
    "text": "ز گیتی جهان‌آفرین را پرست"
  },
  {
    "poem_id": 1352,
    "vorder": 136,
    "position": 1,
    "text": "ازو دان بهر نیکی زور دست"
  },
  {
    "poem_id": 1352,
    "vorder": 137,
    "position": 0,
    "text": "فرو ریخت آب از مژه مادرش"
  },
  {
    "poem_id": 1352,
    "vorder": 138,
    "position": 1,
    "text": "همی‌خواند با خون دل داورش"
  },
  {
    "poem_id": 1352,
    "vorder": 139,
    "position": 0,
    "text": "به یزدان همی‌گفت زنهار من"
  },
  {
    "poem_id": 1352,
    "vorder": 140,
    "position": 1,
    "text": "سپردم ترا ای جهاندار من"
  },
  {
    "poem_id": 1352,
    "vorder": 141,
    "position": 0,
    "text": "بگردان ز جانش بد جاودان"
  },
  {
    "poem_id": 1352,
    "vorder": 142,
    "position": 1,
    "text": "بپرداز گیتی ز نابخردان"
  },
  {
    "poem_id": 1352,
    "vorder": 143,
    "position": 0,
    "text": "فریدون سبک ساز رفتن گرفت"
  },
  {
    "poem_id": 1352,
    "vorder": 144,
    "position": 1,
    "text": "سخن را ز هر کس نهفتن گرفت"
  },
  {
    "poem_id": 1352,
    "vorder": 145,
    "position": 0,
    "text": "برادر دو بودش دو فرخ همال"
  },
  {
    "poem_id": 1352,
    "vorder": 146,
    "position": 1,
    "text": "ازو هر دو آزاده مهتر به سال"
  },
  {
    "poem_id": 1352,
    "vorder": 147,
    "position": 0,
    "text": "یکی بود ازیشان کیانوش نام"
  },
  {
    "poem_id": 1352,
    "vorder": 148,
    "position": 1,
    "text": "دگر نام پرمایهٔ شادکام"
  },
  {
    "poem_id": 1352,
    "vorder": 149,
    "position": 0,
    "text": "فریدون بریشان زبان برگشاد"
  },
  {
    "poem_id": 1352,
    "vorder": 150,
    "position": 1,
    "text": "که خرم زئید ای دلیران و شاد"
  },
  {
    "poem_id": 1352,
    "vorder": 151,
    "position": 0,
    "text": "که گردون نگردد به جز بر بهی"
  },
  {
    "poem_id": 1352,
    "vorder": 152,
    "position": 1,
    "text": "به ما بازگردد کلاه مهی"
  },
  {
    "poem_id": 1352,
    "vorder": 153,
    "position": 0,
    "text": "بیارید داننده آهنگران"
  },
  {
    "poem_id": 1352,
    "vorder": 154,
    "position": 1,
    "text": "یکی گرز فرمود باید گران"
  },
  {
    "poem_id": 1352,
    "vorder": 155,
    "position": 0,
    "text": "چو بگشاد لب هر دو بشتافتند"
  },
  {
    "poem_id": 1352,
    "vorder": 156,
    "position": 1,
    "text": "به بازار آهنگران تاختند"
  },
  {
    "poem_id": 1352,
    "vorder": 157,
    "position": 0,
    "text": "هر آنکس کزان پیشه بد نام‌جوی"
  },
  {
    "poem_id": 1352,
    "vorder": 158,
    "position": 1,
    "text": "به سوی فریدون نهادند روی"
  },
  {
    "poem_id": 1352,
    "vorder": 159,
    "position": 0,
    "text": "جهانجوی پرگار بگرفت زود"
  },
  {
    "poem_id": 1352,
    "vorder": 160,
    "position": 1,
    "text": "وزان گرز پیکر بدیشان نمود"
  },
  {
    "poem_id": 1352,
    "vorder": 161,
    "position": 0,
    "text": "نگاری نگارید بر خاک پیش"
  },
  {
    "poem_id": 1352,
    "vorder": 162,
    "position": 1,
    "text": "همیدون بسان سر گاومیش"
  },
  {
    "poem_id": 1352,
    "vorder": 163,
    "position": 0,
    "text": "بر آن دست بردند آهنگران"
  },
  {
    "poem_id": 1352,
    "vorder": 164,
    "position": 1,
    "text": "چو شد ساخته کار گرز گران"
  },
  {
    "poem_id": 1352,
    "vorder": 165,
    "position": 0,
    "text": "به پیش جهانجوی بردند گرز"
  },
  {
    "poem_id": 1352,
    "vorder": 166,
    "position": 1,
    "text": "فروزان به کردار خورشید برز"
  },
  {
    "poem_id": 1352,
    "vorder": 167,
    "position": 0,
    "text": "پسند آمدش کار پولادگر"
  },
  {
    "poem_id": 1352,
    "vorder": 168,
    "position": 1,
    "text": "ببخشیدشان جامه و سیم و زر"
  },
  {
    "poem_id": 1352,
    "vorder": 169,
    "position": 0,
    "text": "بسی کردشان نیز فرخ امید"
  },
  {
    "poem_id": 1352,
    "vorder": 170,
    "position": 1,
    "text": "بسی دادشان مهتری را نوید"
  },
  {
    "poem_id": 1352,
    "vorder": 171,
    "position": 0,
    "text": "که گر اژدها را کنم زیر خاک"
  },
  {
    "poem_id": 1352,
    "vorder": 172,
    "position": 1,
    "text": "بشویم شما را سر از گرد پاک"
  }
]