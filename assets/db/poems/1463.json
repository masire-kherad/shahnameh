[
  {
    "poem_id": 1463,
    "vorder": 1,
    "position": 0,
    "text": "چو نه ماه بگذشت بر دخت شاه"
  },
  {
    "poem_id": 1463,
    "vorder": 2,
    "position": 1,
    "text": "یکی پورش آمد چو تابنده ماه"
  },
  {
    "poem_id": 1463,
    "vorder": 3,
    "position": 0,
    "text": "تو گفتی گو پیلتن رستم ا‌ست"
  },
  {
    "poem_id": 1463,
    "vorder": 4,
    "position": 1,
    "text": "وگر سام شیرست و گر نیرم‌ است"
  },
  {
    "poem_id": 1463,
    "vorder": 5,
    "position": 0,
    "text": "چو خندان شد و چهره شاداب کرد"
  },
  {
    "poem_id": 1463,
    "vorder": 6,
    "position": 1,
    "text": "ورا نام تهمینه ، سهراب کرد"
  },
  {
    "poem_id": 1463,
    "vorder": 7,
    "position": 0,
    "text": "چو یک ماه شد ، همچو یک سال بود"
  },
  {
    "poem_id": 1463,
    "vorder": 8,
    "position": 1,
    "text": "برش چون بر رستم زال بود"
  },
  {
    "poem_id": 1463,
    "vorder": 9,
    "position": 0,
    "text": "چو سه ساله شد زخم چوگان گرفت"
  },
  {
    "poem_id": 1463,
    "vorder": 10,
    "position": 1,
    "text": "به پنجم دل تیر و پیکان گرفت"
  },
  {
    "poem_id": 1463,
    "vorder": 11,
    "position": 0,
    "text": "چو ده ساله شد زان زمین کس نبود"
  },
  {
    "poem_id": 1463,
    "vorder": 12,
    "position": 1,
    "text": "که یارست با او نبرد آزمود"
  },
  {
    "poem_id": 1463,
    "vorder": 13,
    "position": 0,
    "text": "بر مادر آمد بپرسید زوی"
  },
  {
    "poem_id": 1463,
    "vorder": 14,
    "position": 1,
    "text": "بدو گفت گستاخ بامن بگوی"
  },
  {
    "poem_id": 1463,
    "vorder": 15,
    "position": 0,
    "text": "که من چون ز همشیرگان برترم"
  },
  {
    "poem_id": 1463,
    "vorder": 16,
    "position": 1,
    "text": "همی بآسمان اندر آید سرم"
  },
  {
    "poem_id": 1463,
    "vorder": 17,
    "position": 0,
    "text": "ز تخم کیم وز کدامین گهر"
  },
  {
    "poem_id": 1463,
    "vorder": 18,
    "position": 1,
    "text": "چه گویم چو پرسد کسی از پدر"
  },
  {
    "poem_id": 1463,
    "vorder": 19,
    "position": 0,
    "text": "گر این پرسش از من بماند نهان"
  },
  {
    "poem_id": 1463,
    "vorder": 20,
    "position": 1,
    "text": "نمانم ترا زنده اندر جهان"
  },
  {
    "poem_id": 1463,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت مادر که بشنو سخن"
  },
  {
    "poem_id": 1463,
    "vorder": 22,
    "position": 1,
    "text": "بدین شادمان باش و تندی مکن"
  },
  {
    "poem_id": 1463,
    "vorder": 23,
    "position": 0,
    "text": "تو پور گو پیلتن رستمی"
  },
  {
    "poem_id": 1463,
    "vorder": 24,
    "position": 1,
    "text": "ز دستان سامی و از نیرمی"
  },
  {
    "poem_id": 1463,
    "vorder": 25,
    "position": 0,
    "text": "ازیرا سرت ز آسمان برترست"
  },
  {
    "poem_id": 1463,
    "vorder": 26,
    "position": 1,
    "text": "که تخم تو زان نامور گوهرست"
  },
  {
    "poem_id": 1463,
    "vorder": 27,
    "position": 0,
    "text": "جهان‌آفرین تا جهان آفرید"
  },
  {
    "poem_id": 1463,
    "vorder": 28,
    "position": 1,
    "text": "سواری چو رستم نیامد پدید"
  },
  {
    "poem_id": 1463,
    "vorder": 29,
    "position": 0,
    "text": "چو سام نریمان به گیتی نبود"
  },
  {
    "poem_id": 1463,
    "vorder": 30,
    "position": 1,
    "text": "سرش را نیارست گردون بسود"
  },
  {
    "poem_id": 1463,
    "vorder": 31,
    "position": 0,
    "text": "یکی نامه از رستم جنگ جوی"
  },
  {
    "poem_id": 1463,
    "vorder": 32,
    "position": 1,
    "text": "بیاورد و بنمود پنهان بدوی"
  },
  {
    "poem_id": 1463,
    "vorder": 33,
    "position": 0,
    "text": "سه یاقوت رخشان به سه مهره زر"
  },
  {
    "poem_id": 1463,
    "vorder": 34,
    "position": 1,
    "text": "از ایران فرستاده بودش پدر"
  },
  {
    "poem_id": 1463,
    "vorder": 35,
    "position": 0,
    "text": "بدو گفت افراسیاب این سخن"
  },
  {
    "poem_id": 1463,
    "vorder": 36,
    "position": 1,
    "text": "نبایدکه داند ز سر تا به بن"
  },
  {
    "poem_id": 1463,
    "vorder": 37,
    "position": 0,
    "text": "پدر گر شناسد که تو زین نشان"
  },
  {
    "poem_id": 1463,
    "vorder": 38,
    "position": 1,
    "text": "شدستی سرافراز گردنگشان"
  },
  {
    "poem_id": 1463,
    "vorder": 39,
    "position": 0,
    "text": "چو داند بخواندت نزدیک خویش"
  },
  {
    "poem_id": 1463,
    "vorder": 40,
    "position": 1,
    "text": "دل مادرت گردد از درد ریش"
  },
  {
    "poem_id": 1463,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت سهراب کاندر جهان"
  },
  {
    "poem_id": 1463,
    "vorder": 42,
    "position": 1,
    "text": "کسی این سخن را ندارد نهان"
  },
  {
    "poem_id": 1463,
    "vorder": 43,
    "position": 0,
    "text": "بزرگان جنگ‌آور از باستان"
  },
  {
    "poem_id": 1463,
    "vorder": 44,
    "position": 1,
    "text": "ز رستم زنند این زمان داستان"
  },
  {
    "poem_id": 1463,
    "vorder": 45,
    "position": 0,
    "text": "نبرده نژادی که چونین بود"
  },
  {
    "poem_id": 1463,
    "vorder": 46,
    "position": 1,
    "text": "نهان کردن از من چه آیین بود"
  },
  {
    "poem_id": 1463,
    "vorder": 47,
    "position": 0,
    "text": "کنون من ز ترکان جنگ‌آوران"
  },
  {
    "poem_id": 1463,
    "vorder": 48,
    "position": 1,
    "text": "فراز آورم لشکری بی کران"
  },
  {
    "poem_id": 1463,
    "vorder": 49,
    "position": 0,
    "text": "برانگیزم از گاه کاووس را"
  },
  {
    "poem_id": 1463,
    "vorder": 50,
    "position": 1,
    "text": "از ایران ببرم پی طوس را"
  },
  {
    "poem_id": 1463,
    "vorder": 51,
    "position": 0,
    "text": "به رستم دهم تخت و گرز و کلاه"
  },
  {
    "poem_id": 1463,
    "vorder": 52,
    "position": 1,
    "text": "نشانمش بر گاه کاووس شاه"
  },
  {
    "poem_id": 1463,
    "vorder": 53,
    "position": 0,
    "text": "از ایران به توران شوم جنگ‌جوی"
  },
  {
    "poem_id": 1463,
    "vorder": 54,
    "position": 1,
    "text": "ابا شاه روی اندر آرم بروی"
  },
  {
    "poem_id": 1463,
    "vorder": 55,
    "position": 0,
    "text": "بگیرم سر تخت افراسیاب"
  },
  {
    "poem_id": 1463,
    "vorder": 56,
    "position": 1,
    "text": "سر نیزه بگذارم از آفتاب"
  },
  {
    "poem_id": 1463,
    "vorder": 57,
    "position": 0,
    "text": "چو رستم پدر باشد و من پسر"
  },
  {
    "poem_id": 1463,
    "vorder": 58,
    "position": 1,
    "text": "نباید به گیتی کسی تاجور"
  },
  {
    "poem_id": 1463,
    "vorder": 59,
    "position": 0,
    "text": "چو روشن بود روی خورشید و ماه"
  },
  {
    "poem_id": 1463,
    "vorder": 60,
    "position": 1,
    "text": "ستاره چرا برفرازد کلاه"
  },
  {
    "poem_id": 1463,
    "vorder": 61,
    "position": 0,
    "text": "ز هر سو سپه شد براو انجمن"
  },
  {
    "poem_id": 1463,
    "vorder": 62,
    "position": 1,
    "text": "که هم باگهر بود هم تیغ زن"
  }
]