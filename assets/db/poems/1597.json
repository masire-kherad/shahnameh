[
  {
    "poem_id": 1597,
    "vorder": 1,
    "position": 0,
    "text": "بدانگه که رزم یلان شد دراز"
  },
  {
    "poem_id": 1597,
    "vorder": 2,
    "position": 1,
    "text": "همی دیر شد رستم سرفراز"
  },
  {
    "poem_id": 1597,
    "vorder": 3,
    "position": 0,
    "text": "زواره بیاورد زان سو سپاه"
  },
  {
    "poem_id": 1597,
    "vorder": 4,
    "position": 1,
    "text": "یکی لشکری داغ‌دل کینه‌خواه"
  },
  {
    "poem_id": 1597,
    "vorder": 5,
    "position": 0,
    "text": "به ایرانیان گفت رستم کجاست"
  },
  {
    "poem_id": 1597,
    "vorder": 6,
    "position": 1,
    "text": "برین روز بیهوده خامش چراست"
  },
  {
    "poem_id": 1597,
    "vorder": 7,
    "position": 0,
    "text": "شما سوی رستم به جنگ آمدید"
  },
  {
    "poem_id": 1597,
    "vorder": 8,
    "position": 1,
    "text": "خرامان به چنگ نهنگ آمدید"
  },
  {
    "poem_id": 1597,
    "vorder": 9,
    "position": 0,
    "text": "همی دست رستم نخواهید بست"
  },
  {
    "poem_id": 1597,
    "vorder": 10,
    "position": 1,
    "text": "برین رزمگه بر نشاید نشست"
  },
  {
    "poem_id": 1597,
    "vorder": 11,
    "position": 0,
    "text": "زواره به دشنام لب برگشاد"
  },
  {
    "poem_id": 1597,
    "vorder": 12,
    "position": 1,
    "text": "همی کرد گفتار ناخوب یاد"
  },
  {
    "poem_id": 1597,
    "vorder": 13,
    "position": 0,
    "text": "برآشفت ازان پور اسفندیار"
  },
  {
    "poem_id": 1597,
    "vorder": 14,
    "position": 1,
    "text": "سواری بد اسپ‌افگن و نامدار"
  },
  {
    "poem_id": 1597,
    "vorder": 15,
    "position": 0,
    "text": "جوانی که نوش آذرش بود نام"
  },
  {
    "poem_id": 1597,
    "vorder": 16,
    "position": 1,
    "text": "سرافراز و جنگاور و شادکام"
  },
  {
    "poem_id": 1597,
    "vorder": 17,
    "position": 0,
    "text": "برآشفت با سگزی آن نامدار"
  },
  {
    "poem_id": 1597,
    "vorder": 18,
    "position": 1,
    "text": "زبان را به دشنام بگشاد خوار"
  },
  {
    "poem_id": 1597,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت کآری گو برمنش"
  },
  {
    "poem_id": 1597,
    "vorder": 20,
    "position": 1,
    "text": "به فرمان شاهان کند بدکنش"
  },
  {
    "poem_id": 1597,
    "vorder": 21,
    "position": 0,
    "text": "نفرمود ما را یل اسفندیار"
  },
  {
    "poem_id": 1597,
    "vorder": 22,
    "position": 1,
    "text": "چنین با سگان ساختن کارزار"
  },
  {
    "poem_id": 1597,
    "vorder": 23,
    "position": 0,
    "text": "که پیچد سر از رای و فرمان او"
  },
  {
    "poem_id": 1597,
    "vorder": 24,
    "position": 1,
    "text": "که یارد گذشتن ز پیمان او"
  },
  {
    "poem_id": 1597,
    "vorder": 25,
    "position": 0,
    "text": "اگر جنگ بر نادرستی کنید"
  },
  {
    "poem_id": 1597,
    "vorder": 26,
    "position": 1,
    "text": "به کار اندرون پیش دستی کنید"
  },
  {
    "poem_id": 1597,
    "vorder": 27,
    "position": 0,
    "text": "ببینید پیکار جنگاوران"
  },
  {
    "poem_id": 1597,
    "vorder": 28,
    "position": 1,
    "text": "به تیغ و سنان و به گرز گران"
  },
  {
    "poem_id": 1597,
    "vorder": 29,
    "position": 0,
    "text": "زواره بفرمود کاندر نهید"
  },
  {
    "poem_id": 1597,
    "vorder": 30,
    "position": 1,
    "text": "سران را ز خون بر سر افسر نهید"
  },
  {
    "poem_id": 1597,
    "vorder": 31,
    "position": 0,
    "text": "زواره بیامد به پیش سپاه"
  },
  {
    "poem_id": 1597,
    "vorder": 32,
    "position": 1,
    "text": "دهاده برآمد ز آوردگاه"
  },
  {
    "poem_id": 1597,
    "vorder": 33,
    "position": 0,
    "text": "بکشتند ز ایرانیان بی‌شمار"
  },
  {
    "poem_id": 1597,
    "vorder": 34,
    "position": 1,
    "text": "چو نوش‌آذر آن دید بر ساخت کار"
  },
  {
    "poem_id": 1597,
    "vorder": 35,
    "position": 0,
    "text": "سمند سرافراز را بر نشست"
  },
  {
    "poem_id": 1597,
    "vorder": 36,
    "position": 1,
    "text": "بیامد یکی تیغ هندی به دست"
  },
  {
    "poem_id": 1597,
    "vorder": 37,
    "position": 0,
    "text": "یکی نامور بود الوای نام"
  },
  {
    "poem_id": 1597,
    "vorder": 38,
    "position": 1,
    "text": "سرافراز و اسپ‌افگن و شادکام"
  },
  {
    "poem_id": 1597,
    "vorder": 39,
    "position": 0,
    "text": "کجا نیزهٔ رستم او داشتی"
  },
  {
    "poem_id": 1597,
    "vorder": 40,
    "position": 1,
    "text": "پس پشت او هیچ نگذاشتی"
  },
  {
    "poem_id": 1597,
    "vorder": 41,
    "position": 0,
    "text": "چو از دور نوش‌آذر او را بدید"
  },
  {
    "poem_id": 1597,
    "vorder": 42,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 1597,
    "vorder": 43,
    "position": 0,
    "text": "یکی تیغ زد بر سر و گردنش"
  },
  {
    "poem_id": 1597,
    "vorder": 44,
    "position": 1,
    "text": "بدو نیمه شد پیل‌پیکر تنش"
  },
  {
    "poem_id": 1597,
    "vorder": 45,
    "position": 0,
    "text": "زواره برانگیخت اسپ نبرد"
  },
  {
    "poem_id": 1597,
    "vorder": 46,
    "position": 1,
    "text": "به تندی به نوش‌آذر آواز کرد"
  },
  {
    "poem_id": 1597,
    "vorder": 47,
    "position": 0,
    "text": "که او را فگندی کنون پای دار"
  },
  {
    "poem_id": 1597,
    "vorder": 48,
    "position": 1,
    "text": "چو الوای را من نخوانم سوار"
  },
  {
    "poem_id": 1597,
    "vorder": 49,
    "position": 0,
    "text": "زواره یکی نیزه زد بر برش"
  },
  {
    "poem_id": 1597,
    "vorder": 50,
    "position": 1,
    "text": "به خاک اندر آمد همانگه سرش"
  },
  {
    "poem_id": 1597,
    "vorder": 51,
    "position": 0,
    "text": "چو نوش‌آذر نامور کشته شد"
  },
  {
    "poem_id": 1597,
    "vorder": 52,
    "position": 1,
    "text": "سپه را همه روز برگشته شد"
  },
  {
    "poem_id": 1597,
    "vorder": 53,
    "position": 0,
    "text": "برادرش گریان و دل پر ز جوش"
  },
  {
    "poem_id": 1597,
    "vorder": 54,
    "position": 1,
    "text": "جوانی که بد نام او مهرنوش"
  },
  {
    "poem_id": 1597,
    "vorder": 55,
    "position": 0,
    "text": "غمی شد دل مرد شمشیرزن"
  },
  {
    "poem_id": 1597,
    "vorder": 56,
    "position": 1,
    "text": "برانگیخت آن بارهٔ پیلتن"
  },
  {
    "poem_id": 1597,
    "vorder": 57,
    "position": 0,
    "text": "برفت از میان سپه پیش صف"
  },
  {
    "poem_id": 1597,
    "vorder": 58,
    "position": 1,
    "text": "ز درد جگر بر لب آورده کف"
  },
  {
    "poem_id": 1597,
    "vorder": 59,
    "position": 0,
    "text": "وزان سو فرامرز چون پیل مست"
  },
  {
    "poem_id": 1597,
    "vorder": 60,
    "position": 1,
    "text": "بیامد یکی تیغ هندی به دست"
  },
  {
    "poem_id": 1597,
    "vorder": 61,
    "position": 0,
    "text": "برآویخت با او همی مهرنوش"
  },
  {
    "poem_id": 1597,
    "vorder": 62,
    "position": 1,
    "text": "دو رویه ز لشکر برآمد خروش"
  },
  {
    "poem_id": 1597,
    "vorder": 63,
    "position": 0,
    "text": "گرامی دو پرخاشجوی جوان"
  },
  {
    "poem_id": 1597,
    "vorder": 64,
    "position": 1,
    "text": "یکی شاهزاده دگر پهلوان"
  },
  {
    "poem_id": 1597,
    "vorder": 65,
    "position": 0,
    "text": "چو شیران جنگی برآشوفتند"
  },
  {
    "poem_id": 1597,
    "vorder": 66,
    "position": 1,
    "text": "همی بر سر یکدگر کوفتند"
  },
  {
    "poem_id": 1597,
    "vorder": 67,
    "position": 0,
    "text": "در آوردگه تیز شد مهرنوش"
  },
  {
    "poem_id": 1597,
    "vorder": 68,
    "position": 1,
    "text": "نبودش همی با فرامرز توش"
  },
  {
    "poem_id": 1597,
    "vorder": 69,
    "position": 0,
    "text": "بزد تیغ بر گردن اسپ خویش"
  },
  {
    "poem_id": 1597,
    "vorder": 70,
    "position": 1,
    "text": "سر بادپای اندرافگند پیش"
  },
  {
    "poem_id": 1597,
    "vorder": 71,
    "position": 0,
    "text": "فرامرز کردش پیاده تباه"
  },
  {
    "poem_id": 1597,
    "vorder": 72,
    "position": 1,
    "text": "ز خون لعل شد خاک آوردگاه"
  },
  {
    "poem_id": 1597,
    "vorder": 73,
    "position": 0,
    "text": "چو بهمن برادرش را کشته دید"
  },
  {
    "poem_id": 1597,
    "vorder": 74,
    "position": 1,
    "text": "زمین زیر او چون گل آغشته دید"
  },
  {
    "poem_id": 1597,
    "vorder": 75,
    "position": 0,
    "text": "بیامد دوان نزد اسفندیار"
  },
  {
    "poem_id": 1597,
    "vorder": 76,
    "position": 1,
    "text": "به جایی که بود آتش کارزار"
  },
  {
    "poem_id": 1597,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت کای نره شیر ژیان"
  },
  {
    "poem_id": 1597,
    "vorder": 78,
    "position": 1,
    "text": "سپاهی به جنگ آمد از سگزیان"
  },
  {
    "poem_id": 1597,
    "vorder": 79,
    "position": 0,
    "text": "دو پور تو نوش‌آذر و مهرنوش"
  },
  {
    "poem_id": 1597,
    "vorder": 80,
    "position": 1,
    "text": "به خواری به سگزی سپردند هوش"
  },
  {
    "poem_id": 1597,
    "vorder": 81,
    "position": 0,
    "text": "تو اندر نبردی و ما پر ز درد"
  },
  {
    "poem_id": 1597,
    "vorder": 82,
    "position": 1,
    "text": "جوانان و کی‌زادگان زیر گرد"
  },
  {
    "poem_id": 1597,
    "vorder": 83,
    "position": 0,
    "text": "برین تخمه این ننگ تا جاودان"
  },
  {
    "poem_id": 1597,
    "vorder": 84,
    "position": 1,
    "text": "بماند ز کردار نابخردان"
  },
  {
    "poem_id": 1597,
    "vorder": 85,
    "position": 0,
    "text": "دل مرد بیدارتر شد ز خشم"
  },
  {
    "poem_id": 1597,
    "vorder": 86,
    "position": 1,
    "text": "پر از تاب مغز و پر از آب چشم"
  },
  {
    "poem_id": 1597,
    "vorder": 87,
    "position": 0,
    "text": "به رستم چنین گفت کای بدنشان"
  },
  {
    "poem_id": 1597,
    "vorder": 88,
    "position": 1,
    "text": "چنین بود پیمان گردنکشان"
  },
  {
    "poem_id": 1597,
    "vorder": 89,
    "position": 0,
    "text": "تو گفتی که لشکر نیارم به جنگ"
  },
  {
    "poem_id": 1597,
    "vorder": 90,
    "position": 1,
    "text": "ترا نیست آرایش نام و ننگ"
  },
  {
    "poem_id": 1597,
    "vorder": 91,
    "position": 0,
    "text": "نداری ز من شرم وز کردگار"
  },
  {
    "poem_id": 1597,
    "vorder": 92,
    "position": 1,
    "text": "نترسی که پرسند روز شمار"
  },
  {
    "poem_id": 1597,
    "vorder": 93,
    "position": 0,
    "text": "ندانی که مردان پیمان‌شکن"
  },
  {
    "poem_id": 1597,
    "vorder": 94,
    "position": 1,
    "text": "ستوده نباشد بر انجمن"
  },
  {
    "poem_id": 1597,
    "vorder": 95,
    "position": 0,
    "text": "دو سگزی دو پور مرا کشته‌اند"
  },
  {
    "poem_id": 1597,
    "vorder": 96,
    "position": 1,
    "text": "بران خیرگی باز برگشته‌اند"
  },
  {
    "poem_id": 1597,
    "vorder": 97,
    "position": 0,
    "text": "چو بشنید رستم غمی گشت سخت"
  },
  {
    "poem_id": 1597,
    "vorder": 98,
    "position": 1,
    "text": "بلرزید برسان شاخ درخت"
  },
  {
    "poem_id": 1597,
    "vorder": 99,
    "position": 0,
    "text": "به جان و سر شاه سوگند خورد"
  },
  {
    "poem_id": 1597,
    "vorder": 100,
    "position": 1,
    "text": "به خورشید و شمشیر و دشت نبرد"
  },
  {
    "poem_id": 1597,
    "vorder": 101,
    "position": 0,
    "text": "که من جنگ هرگز نفرموده‌ام"
  },
  {
    "poem_id": 1597,
    "vorder": 102,
    "position": 1,
    "text": "کسی کین چنین کرد نستوده‌ام"
  },
  {
    "poem_id": 1597,
    "vorder": 103,
    "position": 0,
    "text": "ببندم دو دست برادر کنون"
  },
  {
    "poem_id": 1597,
    "vorder": 104,
    "position": 1,
    "text": "گر او بود اندر بدی رهنمون"
  },
  {
    "poem_id": 1597,
    "vorder": 105,
    "position": 0,
    "text": "فرامرز را نیز بسته دو دست"
  },
  {
    "poem_id": 1597,
    "vorder": 106,
    "position": 1,
    "text": "بیارم بر شاه یزدان‌پرست"
  },
  {
    "poem_id": 1597,
    "vorder": 107,
    "position": 0,
    "text": "به خون گرانمایگانشان بکش"
  },
  {
    "poem_id": 1597,
    "vorder": 108,
    "position": 1,
    "text": "مشوران ازین رای بیهوده هش"
  },
  {
    "poem_id": 1597,
    "vorder": 109,
    "position": 0,
    "text": "چنین گفت با رستم اسفندیار"
  },
  {
    "poem_id": 1597,
    "vorder": 110,
    "position": 1,
    "text": "که بر کین طاوس نر خون مار"
  },
  {
    "poem_id": 1597,
    "vorder": 111,
    "position": 0,
    "text": "بریزیم ناخوب و ناخوش بود"
  },
  {
    "poem_id": 1597,
    "vorder": 112,
    "position": 1,
    "text": "نه آیین شاهان سرکش بود"
  },
  {
    "poem_id": 1597,
    "vorder": 113,
    "position": 0,
    "text": "تو ای بدنشان چارهٔ خویش ساز"
  },
  {
    "poem_id": 1597,
    "vorder": 114,
    "position": 1,
    "text": "که آمد زمانت به تنگی فراز"
  },
  {
    "poem_id": 1597,
    "vorder": 115,
    "position": 0,
    "text": "بر رخش با هردو رانت به تیر"
  },
  {
    "poem_id": 1597,
    "vorder": 116,
    "position": 1,
    "text": "برآمیزم اکنون چو با آب شیر"
  },
  {
    "poem_id": 1597,
    "vorder": 117,
    "position": 0,
    "text": "بدان تا کس از بندگان زین سپس"
  },
  {
    "poem_id": 1597,
    "vorder": 118,
    "position": 1,
    "text": "نجویند کین خداوند کس"
  },
  {
    "poem_id": 1597,
    "vorder": 119,
    "position": 0,
    "text": "وگر زنده مانی ببندمت چنگ"
  },
  {
    "poem_id": 1597,
    "vorder": 120,
    "position": 1,
    "text": "به نزدیک شاهت برم بی‌درنگ"
  },
  {
    "poem_id": 1597,
    "vorder": 121,
    "position": 0,
    "text": "بدو گفت رستم کزین گفت و گوی"
  },
  {
    "poem_id": 1597,
    "vorder": 122,
    "position": 1,
    "text": "چه باشد مگر کم شود آبروی"
  },
  {
    "poem_id": 1597,
    "vorder": 123,
    "position": 0,
    "text": "به یزدان پناه و به یزدان گرای"
  },
  {
    "poem_id": 1597,
    "vorder": 124,
    "position": 1,
    "text": "که اویست بر نیک و بد رهنمای"
  }
]