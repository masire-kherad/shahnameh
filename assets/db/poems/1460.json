[
  {
    "poem_id": 1460,
    "vorder": 1,
    "position": 0,
    "text": "ز گفتار دهقان یکی داستان"
  },
  {
    "poem_id": 1460,
    "vorder": 2,
    "position": 1,
    "text": "بپیوندم از گفتهٔ باستان"
  },
  {
    "poem_id": 1460,
    "vorder": 3,
    "position": 0,
    "text": "ز موبد برین گونه بر داشت یاد"
  },
  {
    "poem_id": 1460,
    "vorder": 4,
    "position": 1,
    "text": "که رستم یکی روز از بامداد"
  },
  {
    "poem_id": 1460,
    "vorder": 5,
    "position": 0,
    "text": "غمی بد دلش ساز نخچیر کرد"
  },
  {
    "poem_id": 1460,
    "vorder": 6,
    "position": 1,
    "text": "کمر بست و ترکش پر از تیر کرد"
  },
  {
    "poem_id": 1460,
    "vorder": 7,
    "position": 0,
    "text": "سوی مرز توران چو بنهاد روی"
  },
  {
    "poem_id": 1460,
    "vorder": 8,
    "position": 1,
    "text": "چو شیر دژآگاه نخچیرجوی"
  },
  {
    "poem_id": 1460,
    "vorder": 9,
    "position": 0,
    "text": "چو نزدیکی مرز توران رسید"
  },
  {
    "poem_id": 1460,
    "vorder": 10,
    "position": 1,
    "text": "بیابان سراسر پر از گور دید"
  },
  {
    "poem_id": 1460,
    "vorder": 11,
    "position": 0,
    "text": "برافروخت چون گل رخ تاج‌بخش"
  },
  {
    "poem_id": 1460,
    "vorder": 12,
    "position": 1,
    "text": "بخندید وز جای برکند رخش"
  },
  {
    "poem_id": 1460,
    "vorder": 13,
    "position": 0,
    "text": "به تیر و کمان و به گرز و کمند"
  },
  {
    "poem_id": 1460,
    "vorder": 14,
    "position": 1,
    "text": "بیفگند بر دشت نخچیر چند"
  },
  {
    "poem_id": 1460,
    "vorder": 15,
    "position": 0,
    "text": "ز خاشاک وز خار و شاخ درخت"
  },
  {
    "poem_id": 1460,
    "vorder": 16,
    "position": 1,
    "text": "یکی آتشی برفروزید سخت"
  },
  {
    "poem_id": 1460,
    "vorder": 17,
    "position": 0,
    "text": "چو آتش پراگنده شد پیلتن"
  },
  {
    "poem_id": 1460,
    "vorder": 18,
    "position": 1,
    "text": "درختی بجست از در بابزن"
  },
  {
    "poem_id": 1460,
    "vorder": 19,
    "position": 0,
    "text": "یکی نره گوری بزد بر درخت"
  },
  {
    "poem_id": 1460,
    "vorder": 20,
    "position": 1,
    "text": "که در چنگ او پر مرغی نسخت"
  },
  {
    "poem_id": 1460,
    "vorder": 21,
    "position": 0,
    "text": "چو بریان شد از هم بکند و بخورد"
  },
  {
    "poem_id": 1460,
    "vorder": 22,
    "position": 1,
    "text": "ز مغز استخوانش برآورد گرد"
  },
  {
    "poem_id": 1460,
    "vorder": 23,
    "position": 0,
    "text": "بخفت و برآسود از روزگار"
  },
  {
    "poem_id": 1460,
    "vorder": 24,
    "position": 1,
    "text": "چمان و چران رخش در مرغزار"
  },
  {
    "poem_id": 1460,
    "vorder": 25,
    "position": 0,
    "text": "سواران ترکان تنی هفت و هشت"
  },
  {
    "poem_id": 1460,
    "vorder": 26,
    "position": 1,
    "text": "بران دشت نخچیرگه برگذشت"
  },
  {
    "poem_id": 1460,
    "vorder": 27,
    "position": 0,
    "text": "یکی اسپ دیدند در مرغزار"
  },
  {
    "poem_id": 1460,
    "vorder": 28,
    "position": 1,
    "text": "بگشتند گرد لب جویبار"
  },
  {
    "poem_id": 1460,
    "vorder": 29,
    "position": 0,
    "text": "چو بر دشت مر رخش را یافتند"
  },
  {
    "poem_id": 1460,
    "vorder": 30,
    "position": 1,
    "text": "سوی بند کردنش بشتافتند"
  },
  {
    "poem_id": 1460,
    "vorder": 31,
    "position": 0,
    "text": "گرفتند و بردند پویان به شهر"
  },
  {
    "poem_id": 1460,
    "vorder": 32,
    "position": 1,
    "text": "همی هر یک از رخش جستند بهر"
  },
  {
    "poem_id": 1460,
    "vorder": 33,
    "position": 0,
    "text": "چو بیدار شد رستم از خواب خوش"
  },
  {
    "poem_id": 1460,
    "vorder": 34,
    "position": 1,
    "text": "به کار امدش بارهٔ دستکش"
  },
  {
    "poem_id": 1460,
    "vorder": 35,
    "position": 0,
    "text": "بدان مرغزار اندرون بنگرید"
  },
  {
    "poem_id": 1460,
    "vorder": 36,
    "position": 1,
    "text": "ز هر سو همی بارگی را ندید"
  },
  {
    "poem_id": 1460,
    "vorder": 37,
    "position": 0,
    "text": "غمی گشت چون بارگی را نیافت"
  },
  {
    "poem_id": 1460,
    "vorder": 38,
    "position": 1,
    "text": "سراسیمه سوی سمنگان شتافت"
  },
  {
    "poem_id": 1460,
    "vorder": 39,
    "position": 0,
    "text": "همی گفت کاکنون پیاده دوان"
  },
  {
    "poem_id": 1460,
    "vorder": 40,
    "position": 1,
    "text": "کجا پویم از ننگ تیره‌روان"
  },
  {
    "poem_id": 1460,
    "vorder": 41,
    "position": 0,
    "text": "چه گویند گردان که اسپش که برد"
  },
  {
    "poem_id": 1460,
    "vorder": 42,
    "position": 1,
    "text": "تهمتن بدین سان بخفت و بمرد"
  },
  {
    "poem_id": 1460,
    "vorder": 43,
    "position": 0,
    "text": "کنون رفت باید به بیچارگی"
  },
  {
    "poem_id": 1460,
    "vorder": 44,
    "position": 1,
    "text": "سپردن به غم دل به یکبارگی"
  },
  {
    "poem_id": 1460,
    "vorder": 45,
    "position": 0,
    "text": "کنون بست باید سلیح و کمر"
  },
  {
    "poem_id": 1460,
    "vorder": 46,
    "position": 1,
    "text": "به جایی نشانش بیابم مگر"
  },
  {
    "poem_id": 1460,
    "vorder": 47,
    "position": 0,
    "text": "همی رفت زین سان پر اندوه و رنج"
  },
  {
    "poem_id": 1460,
    "vorder": 48,
    "position": 1,
    "text": "تن اندر عنا و دل اندر شکنج"
  }
]