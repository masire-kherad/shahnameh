[
  {
    "poem_id": 1429,
    "vorder": 1,
    "position": 0,
    "text": "وزانجا سوی پارس اندر کشید"
  },
  {
    "poem_id": 1429,
    "vorder": 2,
    "position": 1,
    "text": "که در پارس بد گنجها را کلید"
  },
  {
    "poem_id": 1429,
    "vorder": 3,
    "position": 0,
    "text": "نشستنگه آن گه به اسطخر بود"
  },
  {
    "poem_id": 1429,
    "vorder": 4,
    "position": 1,
    "text": "کیان را بدان جایگه فخر بود"
  },
  {
    "poem_id": 1429,
    "vorder": 5,
    "position": 0,
    "text": "جهانی سوی او نهادند روی"
  },
  {
    "poem_id": 1429,
    "vorder": 6,
    "position": 1,
    "text": "که او بود سالار دیهیم جوی"
  },
  {
    "poem_id": 1429,
    "vorder": 7,
    "position": 0,
    "text": "به تخت کیان اندر آورد پای"
  },
  {
    "poem_id": 1429,
    "vorder": 8,
    "position": 1,
    "text": "به داد و به آیین فرخنده‌رای"
  },
  {
    "poem_id": 1429,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت با نامور مهتران"
  },
  {
    "poem_id": 1429,
    "vorder": 10,
    "position": 1,
    "text": "که گیتی مرا از کران تا کران"
  },
  {
    "poem_id": 1429,
    "vorder": 11,
    "position": 0,
    "text": "اگر پیل با پشه کین آورد"
  },
  {
    "poem_id": 1429,
    "vorder": 12,
    "position": 1,
    "text": "همه رخنه در داد و دین آورد"
  },
  {
    "poem_id": 1429,
    "vorder": 13,
    "position": 0,
    "text": "نخواهم به گیتی جز از راستی"
  },
  {
    "poem_id": 1429,
    "vorder": 14,
    "position": 1,
    "text": "که خشم خدا آورد کاستی"
  },
  {
    "poem_id": 1429,
    "vorder": 15,
    "position": 0,
    "text": "تن آسانی از درد و رنج منست"
  },
  {
    "poem_id": 1429,
    "vorder": 16,
    "position": 1,
    "text": "کجا خاک و آبست گنج منست"
  },
  {
    "poem_id": 1429,
    "vorder": 17,
    "position": 0,
    "text": "سپاهی و شهری همه یکسرند"
  },
  {
    "poem_id": 1429,
    "vorder": 18,
    "position": 1,
    "text": "همه پادشاهی مرا لشکرند"
  },
  {
    "poem_id": 1429,
    "vorder": 19,
    "position": 0,
    "text": "همه در پناه جهاندار بید"
  },
  {
    "poem_id": 1429,
    "vorder": 20,
    "position": 1,
    "text": "خردمند بید و بی‌آزار بید"
  },
  {
    "poem_id": 1429,
    "vorder": 21,
    "position": 0,
    "text": "هر آنکس که دارد خورید و دهید"
  },
  {
    "poem_id": 1429,
    "vorder": 22,
    "position": 1,
    "text": "سپاسی ز خوردن به من برنهید"
  },
  {
    "poem_id": 1429,
    "vorder": 23,
    "position": 0,
    "text": "هرآنکس کجا بازماند ز خورد"
  },
  {
    "poem_id": 1429,
    "vorder": 24,
    "position": 1,
    "text": "ندارد همی توشهٔ کارکرد"
  },
  {
    "poem_id": 1429,
    "vorder": 25,
    "position": 0,
    "text": "چراگاهشان بارگاه منست"
  },
  {
    "poem_id": 1429,
    "vorder": 26,
    "position": 1,
    "text": "هرآنکس که اندر سپاه منست"
  },
  {
    "poem_id": 1429,
    "vorder": 27,
    "position": 0,
    "text": "وزان رفته نام‌آوران یاد کرد"
  },
  {
    "poem_id": 1429,
    "vorder": 28,
    "position": 1,
    "text": "به داد و دهش گیتی آباد کرد"
  },
  {
    "poem_id": 1429,
    "vorder": 29,
    "position": 0,
    "text": "برین گونه صدسال شادان بزیست"
  },
  {
    "poem_id": 1429,
    "vorder": 30,
    "position": 1,
    "text": "نگر تا چنین در جهان شاه کیست"
  },
  {
    "poem_id": 1429,
    "vorder": 31,
    "position": 0,
    "text": "پسر بد مر او را خردمند چار"
  },
  {
    "poem_id": 1429,
    "vorder": 32,
    "position": 1,
    "text": "که بودند زو در جهان یادگار"
  },
  {
    "poem_id": 1429,
    "vorder": 33,
    "position": 0,
    "text": "نخستین چو کاووس باآفرین"
  },
  {
    "poem_id": 1429,
    "vorder": 34,
    "position": 1,
    "text": "کی آرش دوم و دگر کی پشین"
  },
  {
    "poem_id": 1429,
    "vorder": 35,
    "position": 0,
    "text": "چهارم کجا آرشش بود نام"
  },
  {
    "poem_id": 1429,
    "vorder": 36,
    "position": 1,
    "text": "سپردند گیتی به آرام و کام"
  },
  {
    "poem_id": 1429,
    "vorder": 37,
    "position": 0,
    "text": "چو صد سال بگذشت با تاج و تخت"
  },
  {
    "poem_id": 1429,
    "vorder": 38,
    "position": 1,
    "text": "سرانجام تاب اندر آمد به بخت"
  },
  {
    "poem_id": 1429,
    "vorder": 39,
    "position": 0,
    "text": "چو دانست کامد به نزدیک مرگ"
  },
  {
    "poem_id": 1429,
    "vorder": 40,
    "position": 1,
    "text": "بپژمرد خواهد همی سبز برگ"
  },
  {
    "poem_id": 1429,
    "vorder": 41,
    "position": 0,
    "text": "سر ماه کاووس کی را بخواند"
  },
  {
    "poem_id": 1429,
    "vorder": 42,
    "position": 1,
    "text": "ز داد و دهش چند با او براند"
  },
  {
    "poem_id": 1429,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت ما بر نهادیم رخت"
  },
  {
    "poem_id": 1429,
    "vorder": 44,
    "position": 1,
    "text": "تو بسپار تابوت و بردار تخت"
  },
  {
    "poem_id": 1429,
    "vorder": 45,
    "position": 0,
    "text": "چنانم که گویی ز البرز کوه"
  },
  {
    "poem_id": 1429,
    "vorder": 46,
    "position": 1,
    "text": "کنون آمدم شادمان با گروه"
  },
  {
    "poem_id": 1429,
    "vorder": 47,
    "position": 0,
    "text": "چو بختی که بی‌آگهی بگذرد"
  },
  {
    "poem_id": 1429,
    "vorder": 48,
    "position": 1,
    "text": "پرستندهٔ او ندارد خرد"
  },
  {
    "poem_id": 1429,
    "vorder": 49,
    "position": 0,
    "text": "تو گر دادگر باشی و پاک دین"
  },
  {
    "poem_id": 1429,
    "vorder": 50,
    "position": 1,
    "text": "ز هر کس نیابی به جز آفرین"
  },
  {
    "poem_id": 1429,
    "vorder": 51,
    "position": 0,
    "text": "و گر آز گیرد سرت را به دام"
  },
  {
    "poem_id": 1429,
    "vorder": 52,
    "position": 1,
    "text": "برآری یکی تیغ تیز از نیام"
  },
  {
    "poem_id": 1429,
    "vorder": 53,
    "position": 0,
    "text": "بگفت این و شد زین جهان فراخ"
  },
  {
    "poem_id": 1429,
    "vorder": 54,
    "position": 1,
    "text": "گزین کرد صندوق بر جای کاخ"
  },
  {
    "poem_id": 1429,
    "vorder": 55,
    "position": 0,
    "text": "بسر شد کنون قصهٔ کیقباد"
  },
  {
    "poem_id": 1429,
    "vorder": 56,
    "position": 1,
    "text": "ز کاووس باید سخن کرد یاد"
  }
]