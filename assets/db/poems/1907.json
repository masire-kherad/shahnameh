[
  {
    "poem_id": 1907,
    "vorder": 1,
    "position": 0,
    "text": "کنون از بزرگی خسرو سخن"
  },
  {
    "poem_id": 1907,
    "vorder": 2,
    "position": 1,
    "text": "بگویم کنم تازه روز کهن"
  },
  {
    "poem_id": 1907,
    "vorder": 3,
    "position": 0,
    "text": "بران سان بزرگی کس اندر جهان"
  },
  {
    "poem_id": 1907,
    "vorder": 4,
    "position": 1,
    "text": "ندارد بیاد از کهان و مهان"
  },
  {
    "poem_id": 1907,
    "vorder": 5,
    "position": 0,
    "text": "هر آنکس که او دفتر شاه خواند"
  },
  {
    "poem_id": 1907,
    "vorder": 6,
    "position": 1,
    "text": "ز گیتیش دامن بباید فشاند"
  },
  {
    "poem_id": 1907,
    "vorder": 7,
    "position": 0,
    "text": "سزد گر بگویم یکی داستان"
  },
  {
    "poem_id": 1907,
    "vorder": 8,
    "position": 1,
    "text": "که باشد خردمند هم داستان"
  },
  {
    "poem_id": 1907,
    "vorder": 9,
    "position": 0,
    "text": "مبادا که گستاخ باشی به دهر"
  },
  {
    "poem_id": 1907,
    "vorder": 10,
    "position": 1,
    "text": "که از پای زهرش فزونست زهر"
  },
  {
    "poem_id": 1907,
    "vorder": 11,
    "position": 0,
    "text": "مساایچ با آز و با کینه دست"
  },
  {
    "poem_id": 1907,
    "vorder": 12,
    "position": 1,
    "text": "ز منزل مکن جایگاه نشست"
  },
  {
    "poem_id": 1907,
    "vorder": 13,
    "position": 0,
    "text": "سرای سپنجست با راه و رو"
  },
  {
    "poem_id": 1907,
    "vorder": 14,
    "position": 1,
    "text": "تو گردی کهن دیگر آرند نو"
  },
  {
    "poem_id": 1907,
    "vorder": 15,
    "position": 0,
    "text": "یکی اندر آید دگر بگذرد"
  },
  {
    "poem_id": 1907,
    "vorder": 16,
    "position": 1,
    "text": "زمانی به منزل چمد گر چرد"
  },
  {
    "poem_id": 1907,
    "vorder": 17,
    "position": 0,
    "text": "چو برخیزد آواز طبل رحیل"
  },
  {
    "poem_id": 1907,
    "vorder": 18,
    "position": 1,
    "text": "به خاک اندر آید سر مور وپیل"
  },
  {
    "poem_id": 1907,
    "vorder": 19,
    "position": 0,
    "text": "ز پرویز چون داستانی شگفت"
  },
  {
    "poem_id": 1907,
    "vorder": 20,
    "position": 1,
    "text": "ز من بشنوی یاد باید گرفت"
  },
  {
    "poem_id": 1907,
    "vorder": 21,
    "position": 0,
    "text": "که چندی سزاواری دستگاه"
  },
  {
    "poem_id": 1907,
    "vorder": 22,
    "position": 1,
    "text": "بزرگی و اورنگ و فر و سپاه"
  },
  {
    "poem_id": 1907,
    "vorder": 23,
    "position": 0,
    "text": "کزان بیشتر نشنوی در جهان"
  },
  {
    "poem_id": 1907,
    "vorder": 24,
    "position": 1,
    "text": "اگر چند پرسی ز دانا مهان"
  },
  {
    "poem_id": 1907,
    "vorder": 25,
    "position": 0,
    "text": "ز توران وز هند وز چین و روم"
  },
  {
    "poem_id": 1907,
    "vorder": 26,
    "position": 1,
    "text": "ز هرکشوری کان بد آباد بوم"
  },
  {
    "poem_id": 1907,
    "vorder": 27,
    "position": 0,
    "text": "همی باژ بردند نزدیک شاه"
  },
  {
    "poem_id": 1907,
    "vorder": 28,
    "position": 1,
    "text": "به رخشنده روز و شبان سیاه"
  },
  {
    "poem_id": 1907,
    "vorder": 29,
    "position": 0,
    "text": "غلام و پرستنده از هر دری"
  },
  {
    "poem_id": 1907,
    "vorder": 30,
    "position": 1,
    "text": "ز در و ز یاقوت و هر گوهری"
  },
  {
    "poem_id": 1907,
    "vorder": 31,
    "position": 0,
    "text": "ز دینار و گنجش کرانه نبود"
  },
  {
    "poem_id": 1907,
    "vorder": 32,
    "position": 1,
    "text": "چنو خسرو اندر زمانه نبود"
  },
  {
    "poem_id": 1907,
    "vorder": 33,
    "position": 0,
    "text": "ز شاهین وز باز و پران عقاب"
  },
  {
    "poem_id": 1907,
    "vorder": 34,
    "position": 1,
    "text": "ز شیر و پلنگ و نهنگ اندر آب"
  },
  {
    "poem_id": 1907,
    "vorder": 35,
    "position": 0,
    "text": "همه برگزیدند پیمان اوی"
  },
  {
    "poem_id": 1907,
    "vorder": 36,
    "position": 1,
    "text": "چو خورشید روشن بدی جان اوی"
  },
  {
    "poem_id": 1907,
    "vorder": 37,
    "position": 0,
    "text": "نخستین که بنهاد گنج عروس"
  },
  {
    "poem_id": 1907,
    "vorder": 38,
    "position": 1,
    "text": "ز چین و ز برطاس وز روم و روس"
  },
  {
    "poem_id": 1907,
    "vorder": 39,
    "position": 0,
    "text": "دگر گنج پر در خوشاب بود"
  },
  {
    "poem_id": 1907,
    "vorder": 40,
    "position": 1,
    "text": "که بالاش یک تیر پرتاب بود"
  },
  {
    "poem_id": 1907,
    "vorder": 41,
    "position": 0,
    "text": "که خضرا نهادند نامش ردان"
  },
  {
    "poem_id": 1907,
    "vorder": 42,
    "position": 1,
    "text": "همان تازیان نامور بخردان"
  },
  {
    "poem_id": 1907,
    "vorder": 43,
    "position": 0,
    "text": "دگر گنج باد آورش خواندند"
  },
  {
    "poem_id": 1907,
    "vorder": 44,
    "position": 1,
    "text": "شمارش بکردند و در ماندند"
  },
  {
    "poem_id": 1907,
    "vorder": 45,
    "position": 0,
    "text": "دگر آنک نامش همی‌بشنوی"
  },
  {
    "poem_id": 1907,
    "vorder": 46,
    "position": 1,
    "text": "تو گویی همه دیبهٔ خسروی"
  },
  {
    "poem_id": 1907,
    "vorder": 47,
    "position": 0,
    "text": "دگر نامور گنج افراسیاب"
  },
  {
    "poem_id": 1907,
    "vorder": 48,
    "position": 1,
    "text": "که کس را نبودی به خشکی و آب"
  },
  {
    "poem_id": 1907,
    "vorder": 49,
    "position": 0,
    "text": "دگر گنج کش خواندی سوخته"
  },
  {
    "poem_id": 1907,
    "vorder": 50,
    "position": 1,
    "text": "کزان گنج بد کشور افروخته"
  },
  {
    "poem_id": 1907,
    "vorder": 51,
    "position": 0,
    "text": "دگر آنک بد شادورد بزرگ"
  },
  {
    "poem_id": 1907,
    "vorder": 52,
    "position": 1,
    "text": "که گویند رامشگران سترگ"
  },
  {
    "poem_id": 1907,
    "vorder": 53,
    "position": 0,
    "text": "به زر سرخ گوهر برو بافته"
  },
  {
    "poem_id": 1907,
    "vorder": 54,
    "position": 1,
    "text": "به زر اندرون رشته‌ها تافته"
  },
  {
    "poem_id": 1907,
    "vorder": 55,
    "position": 0,
    "text": "ز رامشگران سرکش و باربد"
  },
  {
    "poem_id": 1907,
    "vorder": 56,
    "position": 1,
    "text": "که هرگز نگشتی به آواز بد"
  },
  {
    "poem_id": 1907,
    "vorder": 57,
    "position": 0,
    "text": "به مشکوی زرین ده و دوهزار"
  },
  {
    "poem_id": 1907,
    "vorder": 58,
    "position": 1,
    "text": "کنیزک به کردار خرم بهار"
  },
  {
    "poem_id": 1907,
    "vorder": 59,
    "position": 0,
    "text": "دگر پیل بد دو هزار و دویست"
  },
  {
    "poem_id": 1907,
    "vorder": 60,
    "position": 1,
    "text": "که گفتی ازان بر زمین جای نیست"
  },
  {
    "poem_id": 1907,
    "vorder": 61,
    "position": 0,
    "text": "فغستان چینی و پیل و سپاه"
  },
  {
    "poem_id": 1907,
    "vorder": 62,
    "position": 1,
    "text": "که بر زین زرین بدی سال و ماه"
  },
  {
    "poem_id": 1907,
    "vorder": 63,
    "position": 0,
    "text": "دگر اسب جنگی ده و شش هزار"
  },
  {
    "poem_id": 1907,
    "vorder": 64,
    "position": 1,
    "text": "دو صد بارگی کان نبد در شمار"
  },
  {
    "poem_id": 1907,
    "vorder": 65,
    "position": 0,
    "text": "ده و دو هزار اشتر بارکش"
  },
  {
    "poem_id": 1907,
    "vorder": 66,
    "position": 1,
    "text": "عماری کش وگام زن شست وشش"
  },
  {
    "poem_id": 1907,
    "vorder": 67,
    "position": 0,
    "text": "که هرگز کس اندر جهان آن ندید"
  },
  {
    "poem_id": 1907,
    "vorder": 68,
    "position": 1,
    "text": "نه از پیر سر کاردانان شنید"
  },
  {
    "poem_id": 1907,
    "vorder": 69,
    "position": 0,
    "text": "چنویی به دست یکی پیشکار"
  },
  {
    "poem_id": 1907,
    "vorder": 70,
    "position": 1,
    "text": "تبه شد تو تیمار و تنگی مدار"
  },
  {
    "poem_id": 1907,
    "vorder": 71,
    "position": 0,
    "text": "تو بی رنجی از کارها برگزین"
  },
  {
    "poem_id": 1907,
    "vorder": 72,
    "position": 1,
    "text": "چو خواهی که یابی بداد آفرین"
  },
  {
    "poem_id": 1907,
    "vorder": 73,
    "position": 0,
    "text": "که نیک و بد اندر جهان بگذرد"
  },
  {
    "poem_id": 1907,
    "vorder": 74,
    "position": 1,
    "text": "زمانه دم ما همی‌بشمرد"
  },
  {
    "poem_id": 1907,
    "vorder": 75,
    "position": 0,
    "text": "اگر تخت یابی اگر تاج و گنج"
  },
  {
    "poem_id": 1907,
    "vorder": 76,
    "position": 1,
    "text": "وگر چند پوینده باشی به رنج"
  },
  {
    "poem_id": 1907,
    "vorder": 77,
    "position": 0,
    "text": "سرانجام جای تو خاکست و خشت"
  },
  {
    "poem_id": 1907,
    "vorder": 78,
    "position": 1,
    "text": "جز از تخم نیکی نبایدت کشت"
  }
]