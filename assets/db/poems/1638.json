[
  {
    "poem_id": 1638,
    "vorder": 1,
    "position": 0,
    "text": "به نزدیک اسکندر آمد وزیر"
  },
  {
    "poem_id": 1638,
    "vorder": 2,
    "position": 1,
    "text": "که ای شاه پیروز و دانش‌پذیر"
  },
  {
    "poem_id": 1638,
    "vorder": 3,
    "position": 0,
    "text": "بکشتیم دشمنت را ناگهان"
  },
  {
    "poem_id": 1638,
    "vorder": 4,
    "position": 1,
    "text": "سرآمد برو تاج و تخت مهان"
  },
  {
    "poem_id": 1638,
    "vorder": 5,
    "position": 0,
    "text": "چو بشنید گفتار جانوشیار"
  },
  {
    "poem_id": 1638,
    "vorder": 6,
    "position": 1,
    "text": "سکندر چنین گفت با ماهیار"
  },
  {
    "poem_id": 1638,
    "vorder": 7,
    "position": 0,
    "text": "که دشمن که افگندی اکنون کجاست"
  },
  {
    "poem_id": 1638,
    "vorder": 8,
    "position": 1,
    "text": "بباید نمودن به من راه راست"
  },
  {
    "poem_id": 1638,
    "vorder": 9,
    "position": 0,
    "text": "برفتند هر دو به پیش اندرون"
  },
  {
    "poem_id": 1638,
    "vorder": 10,
    "position": 1,
    "text": "دل و جان رومی پر از خشم و خون"
  },
  {
    "poem_id": 1638,
    "vorder": 11,
    "position": 0,
    "text": "چو نزدیک شد روی دارا بدید"
  },
  {
    "poem_id": 1638,
    "vorder": 12,
    "position": 1,
    "text": "پر از خون بر و روی چون شنبلید"
  },
  {
    "poem_id": 1638,
    "vorder": 13,
    "position": 0,
    "text": "بفرمود تا راه نگذاشتند"
  },
  {
    "poem_id": 1638,
    "vorder": 14,
    "position": 1,
    "text": "دو دستور او را نگه داشتند"
  },
  {
    "poem_id": 1638,
    "vorder": 15,
    "position": 0,
    "text": "سکندر ز باره درآمد چو باد"
  },
  {
    "poem_id": 1638,
    "vorder": 16,
    "position": 1,
    "text": "سر مرد خسته به ران بر نهاد"
  },
  {
    "poem_id": 1638,
    "vorder": 17,
    "position": 0,
    "text": "نگه کرد تا خسته گوینده هست"
  },
  {
    "poem_id": 1638,
    "vorder": 18,
    "position": 1,
    "text": "بمالید بر چهر او هر دو دست"
  },
  {
    "poem_id": 1638,
    "vorder": 19,
    "position": 0,
    "text": "ز سر برگرفت افسر خسرویش"
  },
  {
    "poem_id": 1638,
    "vorder": 20,
    "position": 1,
    "text": "گشاد آن بر و جوشن پهلویش"
  },
  {
    "poem_id": 1638,
    "vorder": 21,
    "position": 0,
    "text": "ز دیده ببارید چندی سرشک"
  },
  {
    "poem_id": 1638,
    "vorder": 22,
    "position": 1,
    "text": "تن خسته را دور دید از پزشک"
  },
  {
    "poem_id": 1638,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت کین بر تو آسان شود"
  },
  {
    "poem_id": 1638,
    "vorder": 24,
    "position": 1,
    "text": "دل بدسگالت هراسان شود"
  },
  {
    "poem_id": 1638,
    "vorder": 25,
    "position": 0,
    "text": "تو برخیز و بر مهد زرین نشین"
  },
  {
    "poem_id": 1638,
    "vorder": 26,
    "position": 1,
    "text": "وگر هست نیروت بر زین نشین"
  },
  {
    "poem_id": 1638,
    "vorder": 27,
    "position": 0,
    "text": "ز هند و ز رومت پزشک آورم"
  },
  {
    "poem_id": 1638,
    "vorder": 28,
    "position": 1,
    "text": "ز درد تو خونین سرشک آورم"
  },
  {
    "poem_id": 1638,
    "vorder": 29,
    "position": 0,
    "text": "سپارم ترا پادشاهی و تخت"
  },
  {
    "poem_id": 1638,
    "vorder": 30,
    "position": 1,
    "text": "چو بهتر شوی ما ببندیم رخت"
  },
  {
    "poem_id": 1638,
    "vorder": 31,
    "position": 0,
    "text": "جفا پیشگان ترا هم کنون"
  },
  {
    "poem_id": 1638,
    "vorder": 32,
    "position": 1,
    "text": "بیاویزم از دارشان سرنگون"
  },
  {
    "poem_id": 1638,
    "vorder": 33,
    "position": 0,
    "text": "چنانچون ز پیران شنیدیم دوش"
  },
  {
    "poem_id": 1638,
    "vorder": 34,
    "position": 1,
    "text": "دلم گشت پر خون و جان پر ز جوش"
  },
  {
    "poem_id": 1638,
    "vorder": 35,
    "position": 0,
    "text": "ز یک شاخ و یک بیخ و پیراهنیم"
  },
  {
    "poem_id": 1638,
    "vorder": 36,
    "position": 1,
    "text": "به بیشی چرا تخمه را برکنیم"
  },
  {
    "poem_id": 1638,
    "vorder": 37,
    "position": 0,
    "text": "چو بشنید دارا به آواز گفت"
  },
  {
    "poem_id": 1638,
    "vorder": 38,
    "position": 1,
    "text": "که همواره با تو خرد باد جفت"
  },
  {
    "poem_id": 1638,
    "vorder": 39,
    "position": 0,
    "text": "برآنم که از پاک دادار خویش"
  },
  {
    "poem_id": 1638,
    "vorder": 40,
    "position": 1,
    "text": "بیابی تو پاداش گفتار خویش"
  },
  {
    "poem_id": 1638,
    "vorder": 41,
    "position": 0,
    "text": "یکی آنک گفتی که ایران تراست"
  },
  {
    "poem_id": 1638,
    "vorder": 42,
    "position": 1,
    "text": "سر تاج و تخت دلیران تراست"
  },
  {
    "poem_id": 1638,
    "vorder": 43,
    "position": 0,
    "text": "به من مرگ نزدیک‌تر زانک تخت"
  },
  {
    "poem_id": 1638,
    "vorder": 44,
    "position": 1,
    "text": "بپردخت تخت و نگون گشت بخت"
  },
  {
    "poem_id": 1638,
    "vorder": 45,
    "position": 0,
    "text": "برین است فرجام چرخ بلند"
  },
  {
    "poem_id": 1638,
    "vorder": 46,
    "position": 1,
    "text": "خرامش سوی رنج و سودش گزند"
  },
  {
    "poem_id": 1638,
    "vorder": 47,
    "position": 0,
    "text": "به من در نگر تا نگویی که من"
  },
  {
    "poem_id": 1638,
    "vorder": 48,
    "position": 1,
    "text": "فزونم ازین نامدار انجمن"
  },
  {
    "poem_id": 1638,
    "vorder": 49,
    "position": 0,
    "text": "بد و نیک هر دو ز یزدان شناس"
  },
  {
    "poem_id": 1638,
    "vorder": 50,
    "position": 1,
    "text": "وزو دار تا زنده باشی سپاس"
  },
  {
    "poem_id": 1638,
    "vorder": 51,
    "position": 0,
    "text": "نمودار گفتار من من بسم"
  },
  {
    "poem_id": 1638,
    "vorder": 52,
    "position": 1,
    "text": "بدین در نکوهیدهٔ هرکسم"
  },
  {
    "poem_id": 1638,
    "vorder": 53,
    "position": 0,
    "text": "که چندان بزرگی و شاهی و گنج"
  },
  {
    "poem_id": 1638,
    "vorder": 54,
    "position": 1,
    "text": "نبد در زمانه کس از من به رنج"
  },
  {
    "poem_id": 1638,
    "vorder": 55,
    "position": 0,
    "text": "همان نیز چندان سلیح و سپاه"
  },
  {
    "poem_id": 1638,
    "vorder": 56,
    "position": 1,
    "text": "گرانمایه اسپان و تخت و کلاه"
  },
  {
    "poem_id": 1638,
    "vorder": 57,
    "position": 0,
    "text": "همان نیز فرزند و پیوستگان"
  },
  {
    "poem_id": 1638,
    "vorder": 58,
    "position": 1,
    "text": "چه پیوستگان داغ دل خستگان"
  },
  {
    "poem_id": 1638,
    "vorder": 59,
    "position": 0,
    "text": "زمان و زمین بنده بد پیش من"
  },
  {
    "poem_id": 1638,
    "vorder": 60,
    "position": 1,
    "text": "چنین بود تا بخت بد خویش من"
  },
  {
    "poem_id": 1638,
    "vorder": 61,
    "position": 0,
    "text": "ز نیکی جدا مانده‌ام زین نشان"
  },
  {
    "poem_id": 1638,
    "vorder": 62,
    "position": 1,
    "text": "گرفتار در دست مردم‌کشان"
  },
  {
    "poem_id": 1638,
    "vorder": 63,
    "position": 0,
    "text": "ز فرزند و خویشان شده ناامید"
  },
  {
    "poem_id": 1638,
    "vorder": 64,
    "position": 1,
    "text": "سیه شد جهان و دو دیده سپید"
  },
  {
    "poem_id": 1638,
    "vorder": 65,
    "position": 0,
    "text": "ز خویشان کسی نیست فریادرس"
  },
  {
    "poem_id": 1638,
    "vorder": 66,
    "position": 1,
    "text": "امیدم به پروردگارست و بس"
  },
  {
    "poem_id": 1638,
    "vorder": 67,
    "position": 0,
    "text": "برین گونه خسته به خاک اندرم"
  },
  {
    "poem_id": 1638,
    "vorder": 68,
    "position": 1,
    "text": "ز گیتی به دام هلاک اندرم"
  },
  {
    "poem_id": 1638,
    "vorder": 69,
    "position": 0,
    "text": "چنین است آیین چرخ روان"
  },
  {
    "poem_id": 1638,
    "vorder": 70,
    "position": 1,
    "text": "اگر شهریارم و گر پهلوان"
  },
  {
    "poem_id": 1638,
    "vorder": 71,
    "position": 0,
    "text": "بزرگی به فرجام هم بگذرد"
  },
  {
    "poem_id": 1638,
    "vorder": 72,
    "position": 1,
    "text": "شکارست مرگش همی بشکرد"
  },
  {
    "poem_id": 1638,
    "vorder": 73,
    "position": 0,
    "text": "سکندر ز دیده ببارید خون"
  },
  {
    "poem_id": 1638,
    "vorder": 74,
    "position": 1,
    "text": "بران شاه خسته به خاک اندرون"
  },
  {
    "poem_id": 1638,
    "vorder": 75,
    "position": 0,
    "text": "چو دارا بدید آن ز دل درد او"
  },
  {
    "poem_id": 1638,
    "vorder": 76,
    "position": 1,
    "text": "روان اشک خونین رخ زرد او"
  },
  {
    "poem_id": 1638,
    "vorder": 77,
    "position": 0,
    "text": "بدو گفت مگری کزین سود نیست"
  },
  {
    "poem_id": 1638,
    "vorder": 78,
    "position": 1,
    "text": "از آتش مرا بهره جز دود نیست"
  },
  {
    "poem_id": 1638,
    "vorder": 79,
    "position": 0,
    "text": "چنین بود بخشش ز بخشنده‌ام"
  },
  {
    "poem_id": 1638,
    "vorder": 80,
    "position": 1,
    "text": "هم از روزگار درخشنده‌ام"
  },
  {
    "poem_id": 1638,
    "vorder": 81,
    "position": 0,
    "text": "به اندرز من سر به سر گوش دار"
  },
  {
    "poem_id": 1638,
    "vorder": 82,
    "position": 1,
    "text": "پذیرنده باش و بدل هوش دار"
  },
  {
    "poem_id": 1638,
    "vorder": 83,
    "position": 0,
    "text": "سکندر بدو گفت فرمان تراست"
  },
  {
    "poem_id": 1638,
    "vorder": 84,
    "position": 1,
    "text": "بگو آنچ خواهی که پیمان تراست"
  },
  {
    "poem_id": 1638,
    "vorder": 85,
    "position": 0,
    "text": "زبان تیز دارا بدو برگشاد"
  },
  {
    "poem_id": 1638,
    "vorder": 86,
    "position": 1,
    "text": "همی کرد سرتاسر اندرز یاد"
  },
  {
    "poem_id": 1638,
    "vorder": 87,
    "position": 0,
    "text": "نخستین چنین گفت کای نامدار"
  },
  {
    "poem_id": 1638,
    "vorder": 88,
    "position": 1,
    "text": "بترس از جهان داور کردگار"
  },
  {
    "poem_id": 1638,
    "vorder": 89,
    "position": 0,
    "text": "که چرخ و زمین و زمان آفرید"
  },
  {
    "poem_id": 1638,
    "vorder": 90,
    "position": 1,
    "text": "توانایی و ناتوان آفرید"
  },
  {
    "poem_id": 1638,
    "vorder": 91,
    "position": 0,
    "text": "نگه کن به فرزند و پیوند من"
  },
  {
    "poem_id": 1638,
    "vorder": 92,
    "position": 1,
    "text": "به پوشیدگان خردمند من"
  },
  {
    "poem_id": 1638,
    "vorder": 93,
    "position": 0,
    "text": "ز من پاک‌دل دختر من بخواه"
  },
  {
    "poem_id": 1638,
    "vorder": 94,
    "position": 1,
    "text": "بدارش به آرام بر پیشگاه"
  },
  {
    "poem_id": 1638,
    "vorder": 95,
    "position": 0,
    "text": "کجا مادرش روشنک نام کرد"
  },
  {
    "poem_id": 1638,
    "vorder": 96,
    "position": 1,
    "text": "جهان را بدو شاد و پدرام کرد"
  },
  {
    "poem_id": 1638,
    "vorder": 97,
    "position": 0,
    "text": "نیاری به فرزند من سرزنش"
  },
  {
    "poem_id": 1638,
    "vorder": 98,
    "position": 1,
    "text": "نه پیغاره از مردم بدکنش"
  },
  {
    "poem_id": 1638,
    "vorder": 99,
    "position": 0,
    "text": "چو پروردهٔ شهریاران بود"
  },
  {
    "poem_id": 1638,
    "vorder": 100,
    "position": 1,
    "text": "به بزم افسر نامداران بود"
  },
  {
    "poem_id": 1638,
    "vorder": 101,
    "position": 0,
    "text": "مگر زو ببینی یکی نامدار"
  },
  {
    "poem_id": 1638,
    "vorder": 102,
    "position": 1,
    "text": "کجا نو کند نام اسفندیار"
  },
  {
    "poem_id": 1638,
    "vorder": 103,
    "position": 0,
    "text": "بیاراید این آتش زردهشت"
  },
  {
    "poem_id": 1638,
    "vorder": 104,
    "position": 1,
    "text": "بگیرد همان زند و استا بمشت"
  },
  {
    "poem_id": 1638,
    "vorder": 105,
    "position": 0,
    "text": "نگه دارد این فال جشن سده"
  },
  {
    "poem_id": 1638,
    "vorder": 106,
    "position": 1,
    "text": "همان فر نوروز و آتشکده"
  },
  {
    "poem_id": 1638,
    "vorder": 107,
    "position": 0,
    "text": "همان اورمزد و مه و روز مهر"
  },
  {
    "poem_id": 1638,
    "vorder": 108,
    "position": 1,
    "text": "بشوید به آب خرد جان و چهر"
  },
  {
    "poem_id": 1638,
    "vorder": 109,
    "position": 0,
    "text": "کند تازه آیین لهراسپی"
  },
  {
    "poem_id": 1638,
    "vorder": 110,
    "position": 1,
    "text": "بماند کیی دین گشتاسپی"
  },
  {
    "poem_id": 1638,
    "vorder": 111,
    "position": 0,
    "text": "مهان را به مه دارد و که به که"
  },
  {
    "poem_id": 1638,
    "vorder": 112,
    "position": 1,
    "text": "بود دین فروزنده و روزبه"
  },
  {
    "poem_id": 1638,
    "vorder": 113,
    "position": 0,
    "text": "سکندر چنین داد پاسخ بدوی"
  },
  {
    "poem_id": 1638,
    "vorder": 114,
    "position": 1,
    "text": "که ای نیکدل خسرو راست‌گوی"
  },
  {
    "poem_id": 1638,
    "vorder": 115,
    "position": 0,
    "text": "پذیرفتم این پند و اندرز تو"
  },
  {
    "poem_id": 1638,
    "vorder": 116,
    "position": 1,
    "text": "فزون زین نباشم برین مرز تو"
  },
  {
    "poem_id": 1638,
    "vorder": 117,
    "position": 0,
    "text": "همه نیکویها به جای آورم"
  },
  {
    "poem_id": 1638,
    "vorder": 118,
    "position": 1,
    "text": "خرد را بدین رهنمای آورم"
  },
  {
    "poem_id": 1638,
    "vorder": 119,
    "position": 0,
    "text": "جهاندار دست سکندر گرفت"
  },
  {
    "poem_id": 1638,
    "vorder": 120,
    "position": 1,
    "text": "به زاری خروشیدن اندر گرفت"
  },
  {
    "poem_id": 1638,
    "vorder": 121,
    "position": 0,
    "text": "کف دست او بر دهان برنهاد"
  },
  {
    "poem_id": 1638,
    "vorder": 122,
    "position": 1,
    "text": "بدو گفت یزدان پناه تو باد"
  },
  {
    "poem_id": 1638,
    "vorder": 123,
    "position": 0,
    "text": "سپردم ترا جای و رفتم به خاک"
  },
  {
    "poem_id": 1638,
    "vorder": 124,
    "position": 1,
    "text": "سپردم روانرا به یزدان پاک"
  },
  {
    "poem_id": 1638,
    "vorder": 125,
    "position": 0,
    "text": "بگفت این و جانش برآمد ز تن"
  },
  {
    "poem_id": 1638,
    "vorder": 126,
    "position": 1,
    "text": "برو زار بگریستند انجمن"
  },
  {
    "poem_id": 1638,
    "vorder": 127,
    "position": 0,
    "text": "سکندر همه جامه‌ها کرد چاک"
  },
  {
    "poem_id": 1638,
    "vorder": 128,
    "position": 1,
    "text": "به تاج کیان بر پراگند خاک"
  },
  {
    "poem_id": 1638,
    "vorder": 129,
    "position": 0,
    "text": "یکی دخمه کردش بر آیین او"
  },
  {
    "poem_id": 1638,
    "vorder": 130,
    "position": 1,
    "text": "بدان سان که بد فره و دین او"
  },
  {
    "poem_id": 1638,
    "vorder": 131,
    "position": 0,
    "text": "بشستن ازان خون به روشن گلاب"
  },
  {
    "poem_id": 1638,
    "vorder": 132,
    "position": 1,
    "text": "چو آمدش هنگام جاوید خواب"
  },
  {
    "poem_id": 1638,
    "vorder": 133,
    "position": 0,
    "text": "بیاراستندش به دیبای روم"
  },
  {
    "poem_id": 1638,
    "vorder": 134,
    "position": 1,
    "text": "همه پیکرش گوهر و زر بوم"
  },
  {
    "poem_id": 1638,
    "vorder": 135,
    "position": 0,
    "text": "تنش زیر کافور شد ناپدید"
  },
  {
    "poem_id": 1638,
    "vorder": 136,
    "position": 1,
    "text": "ازان پس کسی روی دارا ندید"
  },
  {
    "poem_id": 1638,
    "vorder": 137,
    "position": 0,
    "text": "به دخمه درون تخت زرین نهاد"
  },
  {
    "poem_id": 1638,
    "vorder": 138,
    "position": 1,
    "text": "یکی بر سرش تاج مشکین نهاد"
  },
  {
    "poem_id": 1638,
    "vorder": 139,
    "position": 0,
    "text": "نهادش به تابوت زر اندرون"
  },
  {
    "poem_id": 1638,
    "vorder": 140,
    "position": 1,
    "text": "بروبر ز مژگان ببارید خون"
  },
  {
    "poem_id": 1638,
    "vorder": 141,
    "position": 0,
    "text": "چو تابوتش از جای برداشتند"
  },
  {
    "poem_id": 1638,
    "vorder": 142,
    "position": 1,
    "text": "همه دست بر دست بگذاشتند"
  },
  {
    "poem_id": 1638,
    "vorder": 143,
    "position": 0,
    "text": "سکندر پیاده به پیش اندرون"
  },
  {
    "poem_id": 1638,
    "vorder": 144,
    "position": 1,
    "text": "بزرگان همه دیدگان پر ز خون"
  },
  {
    "poem_id": 1638,
    "vorder": 145,
    "position": 0,
    "text": "چنین تا ستودان دارا برفت"
  },
  {
    "poem_id": 1638,
    "vorder": 146,
    "position": 1,
    "text": "همی پوست گفتی بروبر بکفت"
  },
  {
    "poem_id": 1638,
    "vorder": 147,
    "position": 0,
    "text": "چو بر تخت بنهاد تابوت شاه"
  },
  {
    "poem_id": 1638,
    "vorder": 148,
    "position": 1,
    "text": "بر آیین شاهان برآورد راه"
  },
  {
    "poem_id": 1638,
    "vorder": 149,
    "position": 0,
    "text": "چو پردخت از دخمهٔ ارجمند"
  },
  {
    "poem_id": 1638,
    "vorder": 150,
    "position": 1,
    "text": "ز بیرون بزد دارهای بلند"
  },
  {
    "poem_id": 1638,
    "vorder": 151,
    "position": 0,
    "text": "یکی دار بر نام جانوشیار"
  },
  {
    "poem_id": 1638,
    "vorder": 152,
    "position": 1,
    "text": "دگر همچنان از در ماهیار"
  },
  {
    "poem_id": 1638,
    "vorder": 153,
    "position": 0,
    "text": "دو بدخواه را زنده بردار کرد"
  },
  {
    "poem_id": 1638,
    "vorder": 154,
    "position": 1,
    "text": "سر شاه‌کش مرد بیدار کرد"
  },
  {
    "poem_id": 1638,
    "vorder": 155,
    "position": 0,
    "text": "ز لشکر برفتند مردان جنگ"
  },
  {
    "poem_id": 1638,
    "vorder": 156,
    "position": 1,
    "text": "گرفته یکی سنگ هر یک به چنگ"
  },
  {
    "poem_id": 1638,
    "vorder": 157,
    "position": 0,
    "text": "بکردند بر دارشان سنگسار"
  },
  {
    "poem_id": 1638,
    "vorder": 158,
    "position": 1,
    "text": "مبادا کسی کو کشد شهریار"
  },
  {
    "poem_id": 1638,
    "vorder": 159,
    "position": 0,
    "text": "چو دیدند ایرانیان کو چه کرد"
  },
  {
    "poem_id": 1638,
    "vorder": 160,
    "position": 1,
    "text": "بزاری بران شاه آزادمرد"
  },
  {
    "poem_id": 1638,
    "vorder": 161,
    "position": 0,
    "text": "گرفتند یکسر برو آفرین"
  },
  {
    "poem_id": 1638,
    "vorder": 162,
    "position": 1,
    "text": "بدان سرور شهریار زمین"
  }
]