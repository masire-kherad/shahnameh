[
  {
    "poem_id": 1815,
    "vorder": 1,
    "position": 0,
    "text": "برین سان همی خورد شست و سه سال"
  },
  {
    "poem_id": 1815,
    "vorder": 2,
    "position": 1,
    "text": "کس اندر زمانه نبودش همال"
  },
  {
    "poem_id": 1815,
    "vorder": 3,
    "position": 0,
    "text": "سر سال در پیش او شد دبیر"
  },
  {
    "poem_id": 1815,
    "vorder": 4,
    "position": 1,
    "text": "خردمند موبد که بودش وزیر"
  },
  {
    "poem_id": 1815,
    "vorder": 5,
    "position": 0,
    "text": "که شد گنج شاه بزرگان تهی"
  },
  {
    "poem_id": 1815,
    "vorder": 6,
    "position": 1,
    "text": "کنون آمدم تا چه فرمان دهی"
  },
  {
    "poem_id": 1815,
    "vorder": 7,
    "position": 0,
    "text": "هرانکس که دارد روانش خرد"
  },
  {
    "poem_id": 1815,
    "vorder": 8,
    "position": 1,
    "text": "به مال کسان از بنه ننگرد"
  },
  {
    "poem_id": 1815,
    "vorder": 9,
    "position": 0,
    "text": "چنین پاسخ آورد این خود مساز"
  },
  {
    "poem_id": 1815,
    "vorder": 10,
    "position": 1,
    "text": "که هستیم زین ساختن بی‌نیاز"
  },
  {
    "poem_id": 1815,
    "vorder": 11,
    "position": 0,
    "text": "جهان را بدان باز هل کافرید"
  },
  {
    "poem_id": 1815,
    "vorder": 12,
    "position": 1,
    "text": "سر گردش آفرینش بدید"
  },
  {
    "poem_id": 1815,
    "vorder": 13,
    "position": 0,
    "text": "همی بگذرد چرخ و یزدان به جای"
  },
  {
    "poem_id": 1815,
    "vorder": 14,
    "position": 1,
    "text": "به نیکی ترا و مرا رهنمای"
  },
  {
    "poem_id": 1815,
    "vorder": 15,
    "position": 0,
    "text": "بخفت آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1815,
    "vorder": 16,
    "position": 1,
    "text": "بیامد به درگاه بی‌مر سپاه"
  },
  {
    "poem_id": 1815,
    "vorder": 17,
    "position": 0,
    "text": "گروهی که بایست کردند گرد"
  },
  {
    "poem_id": 1815,
    "vorder": 18,
    "position": 1,
    "text": "بر شاه شد پور او یزدگرد"
  },
  {
    "poem_id": 1815,
    "vorder": 19,
    "position": 0,
    "text": "به پیش بزرگان بدو داد تاج"
  },
  {
    "poem_id": 1815,
    "vorder": 20,
    "position": 1,
    "text": "همان طوق با افسر و تخت عاج"
  },
  {
    "poem_id": 1815,
    "vorder": 21,
    "position": 0,
    "text": "پرستیدن ایزد آمدش رای"
  },
  {
    "poem_id": 1815,
    "vorder": 22,
    "position": 1,
    "text": "بینداخت تاج و بپردخت جای"
  },
  {
    "poem_id": 1815,
    "vorder": 23,
    "position": 0,
    "text": "گرفتش ز کردار گیتی شتاب"
  },
  {
    "poem_id": 1815,
    "vorder": 24,
    "position": 1,
    "text": "چو شب تیره شد کرد آهنگ خواب"
  },
  {
    "poem_id": 1815,
    "vorder": 25,
    "position": 0,
    "text": "چو بنمود دست آفتاب از نشیب"
  },
  {
    "poem_id": 1815,
    "vorder": 26,
    "position": 1,
    "text": "دل موبد شاه شد پر نهیب"
  },
  {
    "poem_id": 1815,
    "vorder": 27,
    "position": 0,
    "text": "که شاه جهان برنخیرد همی"
  },
  {
    "poem_id": 1815,
    "vorder": 28,
    "position": 1,
    "text": "مگر از کرانی گریزد همی"
  },
  {
    "poem_id": 1815,
    "vorder": 29,
    "position": 0,
    "text": "بیامد به نزد پدر یزدگرد"
  },
  {
    "poem_id": 1815,
    "vorder": 30,
    "position": 1,
    "text": "چو دیدش کف اندر دهانش فسرد"
  },
  {
    "poem_id": 1815,
    "vorder": 31,
    "position": 0,
    "text": "ورا دید پژمرده رنگ رخان"
  },
  {
    "poem_id": 1815,
    "vorder": 32,
    "position": 1,
    "text": "به دیبای زربفت بر داده جان"
  },
  {
    "poem_id": 1815,
    "vorder": 33,
    "position": 0,
    "text": "چنین بود تا بود و این بود روز"
  },
  {
    "poem_id": 1815,
    "vorder": 34,
    "position": 1,
    "text": "تو دل را به آز و فزونی مسوز"
  },
  {
    "poem_id": 1815,
    "vorder": 35,
    "position": 0,
    "text": "بترسد دل سنگ و آهن ز مرگ"
  },
  {
    "poem_id": 1815,
    "vorder": 36,
    "position": 1,
    "text": "هم ایدر ترا ساختن نیست برگ"
  },
  {
    "poem_id": 1815,
    "vorder": 37,
    "position": 0,
    "text": "بی‌آزاری و مردمی بایدت"
  },
  {
    "poem_id": 1815,
    "vorder": 38,
    "position": 1,
    "text": "گذشته چو خواهی که نگزایدت"
  },
  {
    "poem_id": 1815,
    "vorder": 39,
    "position": 0,
    "text": "همی نو کنم بخشش و داد اوی"
  },
  {
    "poem_id": 1815,
    "vorder": 40,
    "position": 1,
    "text": "مبادا که گیرد به بد یاد اوی"
  },
  {
    "poem_id": 1815,
    "vorder": 41,
    "position": 0,
    "text": "ورا دخمه‌ای ساختند شاهوار"
  },
  {
    "poem_id": 1815,
    "vorder": 42,
    "position": 1,
    "text": "ابا مرگ او خلق شد سوکوار"
  },
  {
    "poem_id": 1815,
    "vorder": 43,
    "position": 0,
    "text": "کنون پرسخن مغزم اندیشه کرد"
  },
  {
    "poem_id": 1815,
    "vorder": 44,
    "position": 1,
    "text": "بگویم جهان جستن یزدگرد"
  }
]