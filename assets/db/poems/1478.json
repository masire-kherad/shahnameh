[
  {
    "poem_id": 1478,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود رستم که تا پیشکار"
  },
  {
    "poem_id": 1478,
    "vorder": 2,
    "position": 1,
    "text": "یکی جامه افگند بر جویبار"
  },
  {
    "poem_id": 1478,
    "vorder": 3,
    "position": 0,
    "text": "جوان را بران جامه آن جایگاه"
  },
  {
    "poem_id": 1478,
    "vorder": 4,
    "position": 1,
    "text": "بخوابید و آمد به نزدیک شاه"
  },
  {
    "poem_id": 1478,
    "vorder": 5,
    "position": 0,
    "text": "گو پیلتن سر سوی راه کرد"
  },
  {
    "poem_id": 1478,
    "vorder": 6,
    "position": 1,
    "text": "کس آمد پسش زود و آگاه کرد"
  },
  {
    "poem_id": 1478,
    "vorder": 7,
    "position": 0,
    "text": "که سهراب شد زین جهان فراخ"
  },
  {
    "poem_id": 1478,
    "vorder": 8,
    "position": 1,
    "text": "همی از تو تابوت خواهد نه کاخ"
  },
  {
    "poem_id": 1478,
    "vorder": 9,
    "position": 0,
    "text": "پدر جست و برزد یکی سرد باد"
  },
  {
    "poem_id": 1478,
    "vorder": 10,
    "position": 1,
    "text": "بنالید و مژگان به هم بر نهاد"
  },
  {
    "poem_id": 1478,
    "vorder": 11,
    "position": 0,
    "text": "همی گفت زار ای نبرده جوان"
  },
  {
    "poem_id": 1478,
    "vorder": 12,
    "position": 1,
    "text": "سرافراز و از تخمه پهلوان"
  },
  {
    "poem_id": 1478,
    "vorder": 13,
    "position": 0,
    "text": "نبیند چو تو نیز خورشید و ماه"
  },
  {
    "poem_id": 1478,
    "vorder": 14,
    "position": 1,
    "text": "نه جوشن نه تخت و نه تاج و کلاه"
  },
  {
    "poem_id": 1478,
    "vorder": 15,
    "position": 0,
    "text": "کرا آمد این پیش کامد مرا"
  },
  {
    "poem_id": 1478,
    "vorder": 16,
    "position": 1,
    "text": "بکشتم جوانی به پیران سرا"
  },
  {
    "poem_id": 1478,
    "vorder": 17,
    "position": 0,
    "text": "نبیره جهاندار سام سوار"
  },
  {
    "poem_id": 1478,
    "vorder": 18,
    "position": 1,
    "text": "سوی مادر از تخمهٔ نامدار"
  },
  {
    "poem_id": 1478,
    "vorder": 19,
    "position": 0,
    "text": "بریدن دو دستم سزاوار هست"
  },
  {
    "poem_id": 1478,
    "vorder": 20,
    "position": 1,
    "text": "جز از خاک تیره مبادم نشست"
  },
  {
    "poem_id": 1478,
    "vorder": 21,
    "position": 0,
    "text": "کدامین پدر هرگز این کار کرد"
  },
  {
    "poem_id": 1478,
    "vorder": 22,
    "position": 1,
    "text": "سزاوارم اکنون به گفتار سرد"
  },
  {
    "poem_id": 1478,
    "vorder": 23,
    "position": 0,
    "text": "به گیتی که کشتست فرزند را"
  },
  {
    "poem_id": 1478,
    "vorder": 24,
    "position": 1,
    "text": "دلیر و جوان و خردمند را"
  },
  {
    "poem_id": 1478,
    "vorder": 25,
    "position": 0,
    "text": "نکوهش فراوان کند زال زر"
  },
  {
    "poem_id": 1478,
    "vorder": 26,
    "position": 1,
    "text": "همان نیز رودابهٔ پرهنر"
  },
  {
    "poem_id": 1478,
    "vorder": 27,
    "position": 0,
    "text": "بدین کار پوزش چه پیش آورم"
  },
  {
    "poem_id": 1478,
    "vorder": 28,
    "position": 1,
    "text": "که دل‌شان به گفتار خویش آورم"
  },
  {
    "poem_id": 1478,
    "vorder": 29,
    "position": 0,
    "text": "چه گویند گردان و گردنکشان"
  },
  {
    "poem_id": 1478,
    "vorder": 30,
    "position": 1,
    "text": "چو زین سان شود نزد ایشان نشان"
  },
  {
    "poem_id": 1478,
    "vorder": 31,
    "position": 0,
    "text": "چه گویم چو آگه شود مادرش"
  },
  {
    "poem_id": 1478,
    "vorder": 32,
    "position": 1,
    "text": "چه گونه فرستم کسی را برش"
  },
  {
    "poem_id": 1478,
    "vorder": 33,
    "position": 0,
    "text": "چه گویم چرا کشتمش بی‌گناه"
  },
  {
    "poem_id": 1478,
    "vorder": 34,
    "position": 1,
    "text": "چرا روز کردم برو بر سیاه"
  },
  {
    "poem_id": 1478,
    "vorder": 35,
    "position": 0,
    "text": "پدرش آن گرانمایهٔ پهلوان"
  },
  {
    "poem_id": 1478,
    "vorder": 36,
    "position": 1,
    "text": "چه گوید بدان پاک‌دخت جوان"
  },
  {
    "poem_id": 1478,
    "vorder": 37,
    "position": 0,
    "text": "برین تخمهٔ سام نفرین کنند"
  },
  {
    "poem_id": 1478,
    "vorder": 38,
    "position": 1,
    "text": "همه نام من نیز بی‌دین کنند"
  },
  {
    "poem_id": 1478,
    "vorder": 39,
    "position": 0,
    "text": "که دانست کاین کودک ارجمند"
  },
  {
    "poem_id": 1478,
    "vorder": 40,
    "position": 1,
    "text": "بدین سال گردد چو سرو بلند"
  },
  {
    "poem_id": 1478,
    "vorder": 41,
    "position": 0,
    "text": "به جنگ آیدش رای و سازد سپاه"
  },
  {
    "poem_id": 1478,
    "vorder": 42,
    "position": 1,
    "text": "به من برکند روز روشن سیاه"
  },
  {
    "poem_id": 1478,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود تا دیبهٔ خسروان"
  },
  {
    "poem_id": 1478,
    "vorder": 44,
    "position": 1,
    "text": "کشیدند بر روی پور جوان"
  },
  {
    "poem_id": 1478,
    "vorder": 45,
    "position": 0,
    "text": "همی آرزوگاه و شهر آمدش"
  },
  {
    "poem_id": 1478,
    "vorder": 46,
    "position": 1,
    "text": "یکی تنگ تابوت بهر آمدش"
  },
  {
    "poem_id": 1478,
    "vorder": 47,
    "position": 0,
    "text": "ازان دشت بردند تابوت اوی"
  },
  {
    "poem_id": 1478,
    "vorder": 48,
    "position": 1,
    "text": "سوی خیمهٔ خویش بنهاد روی"
  },
  {
    "poem_id": 1478,
    "vorder": 49,
    "position": 0,
    "text": "به پرده سرای آتش اندر زدند"
  },
  {
    "poem_id": 1478,
    "vorder": 50,
    "position": 1,
    "text": "همه لشکرش خاک بر سر زدند"
  },
  {
    "poem_id": 1478,
    "vorder": 51,
    "position": 0,
    "text": "همان خیمه و دیبهٔ هفت رنگ"
  },
  {
    "poem_id": 1478,
    "vorder": 52,
    "position": 1,
    "text": "همه تخت پرمایه زرین پلنگ"
  },
  {
    "poem_id": 1478,
    "vorder": 53,
    "position": 0,
    "text": "برآتش نهادند و برخاست غو"
  },
  {
    "poem_id": 1478,
    "vorder": 54,
    "position": 1,
    "text": "همی گفت زار ای جهاندار نو"
  },
  {
    "poem_id": 1478,
    "vorder": 55,
    "position": 0,
    "text": "دریغ آن رخ و برز و بالای تو"
  },
  {
    "poem_id": 1478,
    "vorder": 56,
    "position": 1,
    "text": "دریغ آن همه مردی و رای تو"
  },
  {
    "poem_id": 1478,
    "vorder": 57,
    "position": 0,
    "text": "دریغ این غم و حسرت جان گسل"
  },
  {
    "poem_id": 1478,
    "vorder": 58,
    "position": 1,
    "text": "ز مادر جدا وز پدر داغدل"
  },
  {
    "poem_id": 1478,
    "vorder": 59,
    "position": 0,
    "text": "همی ریخت خون و همی کند خاک"
  },
  {
    "poem_id": 1478,
    "vorder": 60,
    "position": 1,
    "text": "همه جامهٔ خسروی کرد چاک"
  },
  {
    "poem_id": 1478,
    "vorder": 61,
    "position": 0,
    "text": "همه پهلوانان کاووس شاه"
  },
  {
    "poem_id": 1478,
    "vorder": 62,
    "position": 1,
    "text": "نشستند بر خاک با او به راه"
  },
  {
    "poem_id": 1478,
    "vorder": 63,
    "position": 0,
    "text": "زبان بزرگان پر از پند بود"
  },
  {
    "poem_id": 1478,
    "vorder": 64,
    "position": 1,
    "text": "تهمتن به درد از جگربند بود"
  },
  {
    "poem_id": 1478,
    "vorder": 65,
    "position": 0,
    "text": "چنینست کردار چرخ بلند"
  },
  {
    "poem_id": 1478,
    "vorder": 66,
    "position": 1,
    "text": "به دستی کلاه و به دیگر کمند"
  },
  {
    "poem_id": 1478,
    "vorder": 67,
    "position": 0,
    "text": "چو شادان نشیند کسی با کلاه"
  },
  {
    "poem_id": 1478,
    "vorder": 68,
    "position": 1,
    "text": "بخم کمندش رباید ز گاه"
  },
  {
    "poem_id": 1478,
    "vorder": 69,
    "position": 0,
    "text": "چرا مهر باید همی بر جهان"
  },
  {
    "poem_id": 1478,
    "vorder": 70,
    "position": 1,
    "text": "چو باید خرامید با همرهان"
  },
  {
    "poem_id": 1478,
    "vorder": 71,
    "position": 0,
    "text": "چو اندیشهٔ گنج گردد دراز"
  },
  {
    "poem_id": 1478,
    "vorder": 72,
    "position": 1,
    "text": "همی گشت باید سوی خاک باز"
  },
  {
    "poem_id": 1478,
    "vorder": 73,
    "position": 0,
    "text": "اگر چرخ را هست ازین آگهی"
  },
  {
    "poem_id": 1478,
    "vorder": 74,
    "position": 1,
    "text": "همانا که گشتست مغزش تهی"
  },
  {
    "poem_id": 1478,
    "vorder": 75,
    "position": 0,
    "text": "چنان دان کزین گردش آگاه نیست"
  },
  {
    "poem_id": 1478,
    "vorder": 76,
    "position": 1,
    "text": "که چون و چرا سوی او راه نیست"
  },
  {
    "poem_id": 1478,
    "vorder": 77,
    "position": 0,
    "text": "بدین رفتن اکنون نباید گریست"
  },
  {
    "poem_id": 1478,
    "vorder": 78,
    "position": 1,
    "text": "ندانم که کارش به فرجام چیست"
  },
  {
    "poem_id": 1478,
    "vorder": 79,
    "position": 0,
    "text": "به رستم چنین گفت کاووس کی"
  },
  {
    "poem_id": 1478,
    "vorder": 80,
    "position": 1,
    "text": "که از کوه البرز تا برگ نی"
  },
  {
    "poem_id": 1478,
    "vorder": 81,
    "position": 0,
    "text": "همی برد خواهد به گردش سپهر"
  },
  {
    "poem_id": 1478,
    "vorder": 82,
    "position": 1,
    "text": "نباید فگندن بدین خاک مهر"
  },
  {
    "poem_id": 1478,
    "vorder": 83,
    "position": 0,
    "text": "یکی زود سازد یکی دیرتر"
  },
  {
    "poem_id": 1478,
    "vorder": 84,
    "position": 1,
    "text": "سرانجام بر مرگ باشد گذر"
  },
  {
    "poem_id": 1478,
    "vorder": 85,
    "position": 0,
    "text": "تو دل را بدین رفته خرسند کن"
  },
  {
    "poem_id": 1478,
    "vorder": 86,
    "position": 1,
    "text": "همه گوش سوی خردمند کن"
  },
  {
    "poem_id": 1478,
    "vorder": 87,
    "position": 0,
    "text": "اگر آسمان بر زمین بر زنی"
  },
  {
    "poem_id": 1478,
    "vorder": 88,
    "position": 1,
    "text": "وگر آتش اندر جهان در زنی"
  },
  {
    "poem_id": 1478,
    "vorder": 89,
    "position": 0,
    "text": "نیابی همان رفته را باز جای"
  },
  {
    "poem_id": 1478,
    "vorder": 90,
    "position": 1,
    "text": "روانش کهن شد به دیگر سرای"
  },
  {
    "poem_id": 1478,
    "vorder": 91,
    "position": 0,
    "text": "من از دور دیدم بر و یال اوی"
  },
  {
    "poem_id": 1478,
    "vorder": 92,
    "position": 1,
    "text": "چنان برز و بالا و گوپال اوی"
  },
  {
    "poem_id": 1478,
    "vorder": 93,
    "position": 0,
    "text": "زمانه برانگیختش با سپاه"
  },
  {
    "poem_id": 1478,
    "vorder": 94,
    "position": 1,
    "text": "که ایدر به دست تو گردد تباه"
  },
  {
    "poem_id": 1478,
    "vorder": 95,
    "position": 0,
    "text": "چه سازی و درمان این کار چیست"
  },
  {
    "poem_id": 1478,
    "vorder": 96,
    "position": 1,
    "text": "برین رفته تا چند خواهی گریست"
  },
  {
    "poem_id": 1478,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت رستم که او خود گذشت"
  },
  {
    "poem_id": 1478,
    "vorder": 98,
    "position": 1,
    "text": "نشستست هومان درین پهن دشت"
  },
  {
    "poem_id": 1478,
    "vorder": 99,
    "position": 0,
    "text": "ز توران سرانند و چندی ز چین"
  },
  {
    "poem_id": 1478,
    "vorder": 100,
    "position": 1,
    "text": "ازیشان بدل در مدار ایچ کین"
  },
  {
    "poem_id": 1478,
    "vorder": 101,
    "position": 0,
    "text": "زواره سپه را گذارد به راه"
  },
  {
    "poem_id": 1478,
    "vorder": 102,
    "position": 1,
    "text": "به نیروی یزدان و فرمان شاه"
  },
  {
    "poem_id": 1478,
    "vorder": 103,
    "position": 0,
    "text": "بدو گفت شاه ای گو نامجوی"
  },
  {
    "poem_id": 1478,
    "vorder": 104,
    "position": 1,
    "text": "ازین رزم اندوهت آید به روی"
  },
  {
    "poem_id": 1478,
    "vorder": 105,
    "position": 0,
    "text": "گر ایشان به من چند بد کرده‌اند"
  },
  {
    "poem_id": 1478,
    "vorder": 106,
    "position": 1,
    "text": "و گر دود از ایران برآورده‌اند"
  },
  {
    "poem_id": 1478,
    "vorder": 107,
    "position": 0,
    "text": "دل من ز درد تو شد پر ز درد"
  },
  {
    "poem_id": 1478,
    "vorder": 108,
    "position": 1,
    "text": "نخواهم از ایشان همی یاد کرد"
  }
]