[
  {
    "poem_id": 88008,
    "vorder": 1,
    "position": 0,
    "text": "چو بنمود خورشید تابان درفش"
  },
  {
    "poem_id": 88008,
    "vorder": 2,
    "position": 1,
    "text": "معصفر شد آن پرنیان بنفش"
  },
  {
    "poem_id": 88008,
    "vorder": 3,
    "position": 0,
    "text": "تبیره برآمد ز درگاه شاه"
  },
  {
    "poem_id": 88008,
    "vorder": 4,
    "position": 1,
    "text": "بابر اندر آمد خروش سپاه"
  },
  {
    "poem_id": 88008,
    "vorder": 5,
    "position": 0,
    "text": "بپیش سپه بود پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 6,
    "position": 1,
    "text": "بتن زورمند و ببازو کمند"
  },
  {
    "poem_id": 88008,
    "vorder": 7,
    "position": 0,
    "text": "چو صف برکشیدند هر دو سپاه"
  },
  {
    "poem_id": 88008,
    "vorder": 8,
    "position": 1,
    "text": "هوا شد بنفش و زمین شد سیاه"
  },
  {
    "poem_id": 88008,
    "vorder": 9,
    "position": 0,
    "text": "تهمتن بپوشید ببر بیان"
  },
  {
    "poem_id": 88008,
    "vorder": 10,
    "position": 1,
    "text": "نشست از بر ژنده پیل ژیان"
  },
  {
    "poem_id": 88008,
    "vorder": 11,
    "position": 0,
    "text": "برآشفت و بر میمنه حمله برد"
  },
  {
    "poem_id": 88008,
    "vorder": 12,
    "position": 1,
    "text": "ز ترکان بیفگند بسیار گرد"
  },
  {
    "poem_id": 88008,
    "vorder": 13,
    "position": 0,
    "text": "ازان پس غمی گشت پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 14,
    "position": 1,
    "text": "ز فتراک بگشاد پیچان کمند"
  },
  {
    "poem_id": 88008,
    "vorder": 15,
    "position": 0,
    "text": "برآویخت با طوس چون پیل مست"
  },
  {
    "poem_id": 88008,
    "vorder": 16,
    "position": 1,
    "text": "کمندی به بازوی گُرزی به دست"
  },
  {
    "poem_id": 88008,
    "vorder": 17,
    "position": 0,
    "text": "کمربند بگرفت و او را ز زین"
  },
  {
    "poem_id": 88008,
    "vorder": 18,
    "position": 1,
    "text": "برآورد و آسان بزد بر زمین"
  },
  {
    "poem_id": 88008,
    "vorder": 19,
    "position": 0,
    "text": "به پیگار او گیو چون بنگرید"
  },
  {
    "poem_id": 88008,
    "vorder": 20,
    "position": 1,
    "text": "سر طوس نوذر نگونسار دید"
  },
  {
    "poem_id": 88008,
    "vorder": 21,
    "position": 0,
    "text": "برانگیخت از جای شبدیز را"
  },
  {
    "poem_id": 88008,
    "vorder": 22,
    "position": 1,
    "text": "تن و جان بیاراست آویز را"
  },
  {
    "poem_id": 88008,
    "vorder": 23,
    "position": 0,
    "text": "برآویخت با دیو چون شیر نر"
  },
  {
    "poem_id": 88008,
    "vorder": 24,
    "position": 1,
    "text": "زره‌دار با گرزهٔ گاوسر"
  },
  {
    "poem_id": 88008,
    "vorder": 25,
    "position": 0,
    "text": "کمندی بینداخت پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 26,
    "position": 1,
    "text": "سر گیو گرد اندر آمد ببند"
  },
  {
    "poem_id": 88008,
    "vorder": 27,
    "position": 0,
    "text": "نگه کرد رهام و بیژن ز راه"
  },
  {
    "poem_id": 88008,
    "vorder": 28,
    "position": 1,
    "text": "بدان زور و بالا و آن دستگاه"
  },
  {
    "poem_id": 88008,
    "vorder": 29,
    "position": 0,
    "text": "برفتند تا دست پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 30,
    "position": 1,
    "text": "ببندند هر دو بخم کمند"
  },
  {
    "poem_id": 88008,
    "vorder": 31,
    "position": 0,
    "text": "بزد دست پولاد بسیار هوش"
  },
  {
    "poem_id": 88008,
    "vorder": 32,
    "position": 1,
    "text": "برانگیخت اسپ و برآمد خروش"
  },
  {
    "poem_id": 88008,
    "vorder": 33,
    "position": 0,
    "text": "دو گرد از دلیران پر مایه را"
  },
  {
    "poem_id": 88008,
    "vorder": 34,
    "position": 1,
    "text": "سرافراز و گرد و گرانمایه را"
  },
  {
    "poem_id": 88008,
    "vorder": 35,
    "position": 0,
    "text": "بخاک اندر افگند و بسپرد خوار"
  },
  {
    "poem_id": 88008,
    "vorder": 36,
    "position": 1,
    "text": "نظاره بران دشت چندان سوار"
  },
  {
    "poem_id": 88008,
    "vorder": 37,
    "position": 0,
    "text": "بیامد بر اختر کاویان"
  },
  {
    "poem_id": 88008,
    "vorder": 38,
    "position": 1,
    "text": "بخنجر بدو نیم کردش میان"
  },
  {
    "poem_id": 88008,
    "vorder": 39,
    "position": 0,
    "text": "خروشی برآمد ز ایران سپاه"
  },
  {
    "poem_id": 88008,
    "vorder": 40,
    "position": 1,
    "text": "نماند ایچ گرد اندر آوردگاه"
  },
  {
    "poem_id": 88008,
    "vorder": 41,
    "position": 0,
    "text": "فریبرز و گودرز و گردنکشان"
  },
  {
    "poem_id": 88008,
    "vorder": 42,
    "position": 1,
    "text": "گرفتند از آن دیو جنگی نشان"
  },
  {
    "poem_id": 88008,
    "vorder": 43,
    "position": 0,
    "text": "بگفتند با رستم کینه‌خواه"
  },
  {
    "poem_id": 88008,
    "vorder": 44,
    "position": 1,
    "text": "که پولادوند اندرین رزمگاه"
  },
  {
    "poem_id": 88008,
    "vorder": 45,
    "position": 0,
    "text": "بزین بر یکی نامداری نماند"
  },
  {
    "poem_id": 88008,
    "vorder": 46,
    "position": 1,
    "text": "ز گردان لشکر سواری نماند"
  },
  {
    "poem_id": 88008,
    "vorder": 47,
    "position": 0,
    "text": "که نفگند بر خاک پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 48,
    "position": 1,
    "text": "بگرز و بخنجر بتیر و کمند"
  },
  {
    "poem_id": 88008,
    "vorder": 49,
    "position": 0,
    "text": "همه رزمگه سربسر ماتمست"
  },
  {
    "poem_id": 88008,
    "vorder": 50,
    "position": 1,
    "text": "بدین کار فریادرس رستمست"
  },
  {
    "poem_id": 88008,
    "vorder": 51,
    "position": 0,
    "text": "ازان پس خروشیدن ناله خاست"
  },
  {
    "poem_id": 88008,
    "vorder": 52,
    "position": 1,
    "text": "ز قلب و چپ لشکر و دست راست"
  },
  {
    "poem_id": 88008,
    "vorder": 53,
    "position": 0,
    "text": "چو کم شد ز گودرز هر دو پسر"
  },
  {
    "poem_id": 88008,
    "vorder": 54,
    "position": 1,
    "text": "بنالید با داور دادگر"
  },
  {
    "poem_id": 88008,
    "vorder": 55,
    "position": 0,
    "text": "که چندین نبیره پسر داشتم"
  },
  {
    "poem_id": 88008,
    "vorder": 56,
    "position": 1,
    "text": "همی سر ز خورشید بگذاشتم"
  },
  {
    "poem_id": 88008,
    "vorder": 57,
    "position": 0,
    "text": "برزم اندرون پیش من کشته شد"
  },
  {
    "poem_id": 88008,
    "vorder": 58,
    "position": 1,
    "text": "چنین اختر و روز من گشته شد"
  },
  {
    "poem_id": 88008,
    "vorder": 59,
    "position": 0,
    "text": "جوانان و من زنده با پیر سر"
  },
  {
    "poem_id": 88008,
    "vorder": 60,
    "position": 1,
    "text": "مرا شرم باد از کلاه و کمر"
  },
  {
    "poem_id": 88008,
    "vorder": 61,
    "position": 0,
    "text": "کمر برگشاد و کله برگرفت"
  },
  {
    "poem_id": 88008,
    "vorder": 62,
    "position": 1,
    "text": "خروشیدن و ناله اندر گرفت"
  },
  {
    "poem_id": 88008,
    "vorder": 63,
    "position": 0,
    "text": "چو بشنید رستم دژم گشت سخت"
  },
  {
    "poem_id": 88008,
    "vorder": 64,
    "position": 1,
    "text": "بلرزید برسان برگ درخت"
  },
  {
    "poem_id": 88008,
    "vorder": 65,
    "position": 0,
    "text": "بیامد بنزدیک پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 66,
    "position": 1,
    "text": "ورا دید برسان کوه بلند"
  },
  {
    "poem_id": 88008,
    "vorder": 67,
    "position": 0,
    "text": "سپه را همه بیشتر خسته دید"
  },
  {
    "poem_id": 88008,
    "vorder": 68,
    "position": 1,
    "text": "وزان روی پرخاش پیوسته دید"
  },
  {
    "poem_id": 88008,
    "vorder": 69,
    "position": 0,
    "text": "بدل گفت کین روز ما تیره گشت"
  },
  {
    "poem_id": 88008,
    "vorder": 70,
    "position": 1,
    "text": "سرنامداران ما خیره گشت"
  },
  {
    "poem_id": 88008,
    "vorder": 71,
    "position": 0,
    "text": "همانا که برگشت پرگار ما"
  },
  {
    "poem_id": 88008,
    "vorder": 72,
    "position": 1,
    "text": "غنوده شد آن بخت بیدار ما"
  },
  {
    "poem_id": 88008,
    "vorder": 73,
    "position": 0,
    "text": "بیفشارد ران رخش را تیز کرد"
  },
  {
    "poem_id": 88008,
    "vorder": 74,
    "position": 1,
    "text": "برآشفت و آهنگ آویز کرد"
  },
  {
    "poem_id": 88008,
    "vorder": 75,
    "position": 0,
    "text": "بدو گفت کای دیو ناسازگار"
  },
  {
    "poem_id": 88008,
    "vorder": 76,
    "position": 1,
    "text": "ببینی کنون گردش روزگار"
  },
  {
    "poem_id": 88008,
    "vorder": 77,
    "position": 0,
    "text": "چو آواز رستم بگردان رسید"
  },
  {
    "poem_id": 88008,
    "vorder": 78,
    "position": 1,
    "text": "تهمتن یلان را پیاده بدید"
  },
  {
    "poem_id": 88008,
    "vorder": 79,
    "position": 0,
    "text": "دژم گشته زو چار گرد دلیر"
  },
  {
    "poem_id": 88008,
    "vorder": 80,
    "position": 1,
    "text": "چو گوران و دشمن بکردار شیر"
  },
  {
    "poem_id": 88008,
    "vorder": 81,
    "position": 0,
    "text": "چنین گفت با کردگار جهان"
  },
  {
    "poem_id": 88008,
    "vorder": 82,
    "position": 1,
    "text": "که ای برتر از آشکار و نهان"
  },
  {
    "poem_id": 88008,
    "vorder": 83,
    "position": 0,
    "text": "مرا چشم اگر تیره گشتی بجنگ"
  },
  {
    "poem_id": 88008,
    "vorder": 84,
    "position": 1,
    "text": "بهستی ز دیدار این روز تنگ"
  },
  {
    "poem_id": 88008,
    "vorder": 85,
    "position": 0,
    "text": "کزین سان برآمد ز ایران غریو"
  },
  {
    "poem_id": 88008,
    "vorder": 86,
    "position": 1,
    "text": "ز پیران و هومان وز نره دیو"
  },
  {
    "poem_id": 88008,
    "vorder": 87,
    "position": 0,
    "text": "پیاده شده گیو و رهام و طوس"
  },
  {
    "poem_id": 88008,
    "vorder": 88,
    "position": 1,
    "text": "چو بیژن که بر شیر کردی فسوس"
  },
  {
    "poem_id": 88008,
    "vorder": 89,
    "position": 0,
    "text": "تبه گشته اسپ بزرگان بتیر"
  },
  {
    "poem_id": 88008,
    "vorder": 90,
    "position": 1,
    "text": "بدین سان برآویخته خیره خیر"
  },
  {
    "poem_id": 88008,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت پولادوند ای دلیر"
  },
  {
    "poem_id": 88008,
    "vorder": 92,
    "position": 1,
    "text": "جهاندیده و نامبردار و شیر"
  },
  {
    "poem_id": 88008,
    "vorder": 93,
    "position": 0,
    "text": "که بگریزد از پیش تو ژنده پیل"
  },
  {
    "poem_id": 88008,
    "vorder": 94,
    "position": 1,
    "text": "ببینی کنون موج دریای نیل"
  },
  {
    "poem_id": 88008,
    "vorder": 95,
    "position": 0,
    "text": "نگه کن کنون آتش جنگ من"
  },
  {
    "poem_id": 88008,
    "vorder": 96,
    "position": 1,
    "text": "کمند و دل و زور و آهنگ من"
  },
  {
    "poem_id": 88008,
    "vorder": 97,
    "position": 0,
    "text": "کزین پس نیابی ز شاهت نشان"
  },
  {
    "poem_id": 88008,
    "vorder": 98,
    "position": 1,
    "text": "نه از نامداران و گردنکشان"
  },
  {
    "poem_id": 88008,
    "vorder": 99,
    "position": 0,
    "text": "نبینی زمین زین سپس جز بخواب"
  },
  {
    "poem_id": 88008,
    "vorder": 100,
    "position": 1,
    "text": "سپارم سپاهت بافراسیاب"
  },
  {
    "poem_id": 88008,
    "vorder": 101,
    "position": 0,
    "text": "چنین گفت رستم بپولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 102,
    "position": 1,
    "text": "که تا چند ازین بیم و نیرنگ و بند"
  },
  {
    "poem_id": 88008,
    "vorder": 103,
    "position": 0,
    "text": "ز جنگ آوران تیز گویا مباد"
  },
  {
    "poem_id": 88008,
    "vorder": 104,
    "position": 1,
    "text": "چو باشد دهد بی‌گمان سر بباد"
  },
  {
    "poem_id": 88008,
    "vorder": 105,
    "position": 0,
    "text": "چو بشنید پولادوند این سخن"
  },
  {
    "poem_id": 88008,
    "vorder": 106,
    "position": 1,
    "text": "بیاد آمدش گفته‌های کهن"
  },
  {
    "poem_id": 88008,
    "vorder": 107,
    "position": 0,
    "text": "که هر کو ببیداد جوید نبرد"
  },
  {
    "poem_id": 88008,
    "vorder": 108,
    "position": 1,
    "text": "جگر خسته باز آید و روی زرد"
  },
  {
    "poem_id": 88008,
    "vorder": 109,
    "position": 0,
    "text": "گر از دشمنت بد رسد گر ز دوست"
  },
  {
    "poem_id": 88008,
    "vorder": 110,
    "position": 1,
    "text": "بد و نیک را داد دادن نکوست"
  },
  {
    "poem_id": 88008,
    "vorder": 111,
    "position": 0,
    "text": "همان رستمست این که مازندران"
  },
  {
    "poem_id": 88008,
    "vorder": 112,
    "position": 1,
    "text": "شب تیره بستد بگرز گران"
  },
  {
    "poem_id": 88008,
    "vorder": 113,
    "position": 0,
    "text": "بدو گفت کای مرد رزم آزمای"
  },
  {
    "poem_id": 88008,
    "vorder": 114,
    "position": 1,
    "text": "چه باشیم برخیره چندین بپای"
  },
  {
    "poem_id": 88008,
    "vorder": 115,
    "position": 0,
    "text": "بگشتند وز دشت برخاست گرد"
  },
  {
    "poem_id": 88008,
    "vorder": 116,
    "position": 1,
    "text": "دو پیل ژیان و دو شیر نبرد"
  },
  {
    "poem_id": 88008,
    "vorder": 117,
    "position": 0,
    "text": "برانگیخت آن باره پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 118,
    "position": 1,
    "text": "بینداخت پس تاب داده کمند"
  },
  {
    "poem_id": 88008,
    "vorder": 119,
    "position": 0,
    "text": "بدزدید یال آن نبرده سوار"
  },
  {
    "poem_id": 88008,
    "vorder": 120,
    "position": 1,
    "text": "چو زین گونه پیوسته شد کارزار"
  },
  {
    "poem_id": 88008,
    "vorder": 121,
    "position": 0,
    "text": "بزد تیغ و بند کمندش برید"
  },
  {
    "poem_id": 88008,
    "vorder": 122,
    "position": 1,
    "text": "بجای آمد آن بند بد را کلید"
  },
  {
    "poem_id": 88008,
    "vorder": 123,
    "position": 0,
    "text": "بپیچید زان پس سوی دست راست"
  },
  {
    "poem_id": 88008,
    "vorder": 124,
    "position": 1,
    "text": "بدانست کان روز روز بلاست"
  },
  {
    "poem_id": 88008,
    "vorder": 125,
    "position": 0,
    "text": "عمودی بزد بر سرش پیلتن"
  },
  {
    "poem_id": 88008,
    "vorder": 126,
    "position": 1,
    "text": "که بشنید آواز او انجمن"
  },
  {
    "poem_id": 88008,
    "vorder": 127,
    "position": 0,
    "text": "چنان تیره شد چشم پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 128,
    "position": 1,
    "text": "که دستش عنان را نبد کار بند"
  },
  {
    "poem_id": 88008,
    "vorder": 129,
    "position": 0,
    "text": "تهمتن بران بد که مغز سرش"
  },
  {
    "poem_id": 88008,
    "vorder": 130,
    "position": 1,
    "text": "ببیند پر از رنگ تیره برش"
  },
  {
    "poem_id": 88008,
    "vorder": 131,
    "position": 0,
    "text": "چو پولادوند از بر زین بماند"
  },
  {
    "poem_id": 88008,
    "vorder": 132,
    "position": 1,
    "text": "تهمتن جهان آفرین را بخواند"
  },
  {
    "poem_id": 88008,
    "vorder": 133,
    "position": 0,
    "text": "که ای برتر از گردش روزگار"
  },
  {
    "poem_id": 88008,
    "vorder": 134,
    "position": 1,
    "text": "جهاندار و بینا و پروردگار"
  },
  {
    "poem_id": 88008,
    "vorder": 135,
    "position": 0,
    "text": "گرین گردش جنگ من داد نیست"
  },
  {
    "poem_id": 88008,
    "vorder": 136,
    "position": 1,
    "text": "روانم بدان گیتی آباد نیست"
  },
  {
    "poem_id": 88008,
    "vorder": 137,
    "position": 0,
    "text": "روا دارم از دست پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 138,
    "position": 1,
    "text": "روان مرا برگشاید ز بند"
  },
  {
    "poem_id": 88008,
    "vorder": 139,
    "position": 0,
    "text": "ور افراسیابست بیدادگر"
  },
  {
    "poem_id": 88008,
    "vorder": 140,
    "position": 1,
    "text": "تو مستان ز من دست و زور و هنر"
  },
  {
    "poem_id": 88008,
    "vorder": 141,
    "position": 0,
    "text": "که گر من شوم کشته بر دست اوی"
  },
  {
    "poem_id": 88008,
    "vorder": 142,
    "position": 1,
    "text": "بایران نماند یکی جنگجوی"
  },
  {
    "poem_id": 88008,
    "vorder": 143,
    "position": 0,
    "text": "نه مرد کشاورز و نه پیشه‌ور"
  },
  {
    "poem_id": 88008,
    "vorder": 144,
    "position": 1,
    "text": "نه خاک و نه کشور نه بوم و نه بر"
  },
  {
    "poem_id": 88008,
    "vorder": 145,
    "position": 0,
    "text": "بکشتی گرفتن نهادند روی"
  },
  {
    "poem_id": 88008,
    "vorder": 146,
    "position": 1,
    "text": "دو گرد سرافراز و دو جنگجوی"
  },
  {
    "poem_id": 88008,
    "vorder": 147,
    "position": 0,
    "text": "بپیمان که از هر دو روی سپاه"
  },
  {
    "poem_id": 88008,
    "vorder": 148,
    "position": 1,
    "text": "بیاری نیاید کسی کینه‌خواه"
  },
  {
    "poem_id": 88008,
    "vorder": 149,
    "position": 0,
    "text": "میان سپه نیم فرسنگ بود"
  },
  {
    "poem_id": 88008,
    "vorder": 150,
    "position": 1,
    "text": "ستاره نظاره بران جنگ بود"
  },
  {
    "poem_id": 88008,
    "vorder": 151,
    "position": 0,
    "text": "چو پولادوند و تهمتن بهم"
  },
  {
    "poem_id": 88008,
    "vorder": 152,
    "position": 1,
    "text": "برآویختند آن دو شیر دژم"
  },
  {
    "poem_id": 88008,
    "vorder": 153,
    "position": 0,
    "text": "همی دست سودند یک با دگر"
  },
  {
    "poem_id": 88008,
    "vorder": 154,
    "position": 1,
    "text": "گرفته دو جنگی دوال کمر"
  },
  {
    "poem_id": 88008,
    "vorder": 155,
    "position": 0,
    "text": "چو شیده بر و یال رستم بدید"
  },
  {
    "poem_id": 88008,
    "vorder": 156,
    "position": 1,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 88008,
    "vorder": 157,
    "position": 0,
    "text": "پدر را چنین گفت کین زورمند"
  },
  {
    "poem_id": 88008,
    "vorder": 158,
    "position": 1,
    "text": "که خوانی ورا رستم دیوبند"
  },
  {
    "poem_id": 88008,
    "vorder": 159,
    "position": 0,
    "text": "بدین برز بالا و این دست برد"
  },
  {
    "poem_id": 88008,
    "vorder": 160,
    "position": 1,
    "text": "بخاک اندر آرد سر دیو گرد"
  },
  {
    "poem_id": 88008,
    "vorder": 161,
    "position": 0,
    "text": "نبینی ز گردان ما جز گریز"
  },
  {
    "poem_id": 88008,
    "vorder": 162,
    "position": 1,
    "text": "مکن خیره با چرخ گردان ستیز"
  },
  {
    "poem_id": 88008,
    "vorder": 163,
    "position": 0,
    "text": "چنین گفت با شیده افراسیاب"
  },
  {
    "poem_id": 88008,
    "vorder": 164,
    "position": 1,
    "text": "که شد مغز من زین سخن پرشتاب"
  },
  {
    "poem_id": 88008,
    "vorder": 165,
    "position": 0,
    "text": "برو تا ببینی که پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 166,
    "position": 1,
    "text": "بکشتی همی چون کند دست بند"
  },
  {
    "poem_id": 88008,
    "vorder": 167,
    "position": 0,
    "text": "چنین گفت شیده که پیمان شاه"
  },
  {
    "poem_id": 88008,
    "vorder": 168,
    "position": 1,
    "text": "نه این بود با او بپیش سپاه"
  },
  {
    "poem_id": 88008,
    "vorder": 169,
    "position": 0,
    "text": "چو پیمان شکن باشی و تیره مغز"
  },
  {
    "poem_id": 88008,
    "vorder": 170,
    "position": 1,
    "text": "نیاید ز دست تو پیگار نغز"
  },
  {
    "poem_id": 88008,
    "vorder": 171,
    "position": 0,
    "text": "تو این آب روشن مگردان سیاه"
  },
  {
    "poem_id": 88008,
    "vorder": 172,
    "position": 1,
    "text": "که عیب آورد بر تو بر عیب‌خواه"
  },
  {
    "poem_id": 88008,
    "vorder": 173,
    "position": 0,
    "text": "بدشنام بگشاد خسرو زبان"
  },
  {
    "poem_id": 88008,
    "vorder": 174,
    "position": 1,
    "text": "برآشفت و شد با پسر بدگمان"
  },
  {
    "poem_id": 88008,
    "vorder": 175,
    "position": 0,
    "text": "بدو گفت اگر دیو پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 176,
    "position": 1,
    "text": "ازین مرد بدخواه یابد گزند"
  },
  {
    "poem_id": 88008,
    "vorder": 177,
    "position": 0,
    "text": "نماند بدین رزمگه زنده کس"
  },
  {
    "poem_id": 88008,
    "vorder": 178,
    "position": 1,
    "text": "ترا از هنرها زیانست و بس"
  },
  {
    "poem_id": 88008,
    "vorder": 179,
    "position": 0,
    "text": "عنان برگرایید و آمد چو شیر"
  },
  {
    "poem_id": 88008,
    "vorder": 180,
    "position": 1,
    "text": "به آوردگاه دو مرد دلیر"
  },
  {
    "poem_id": 88008,
    "vorder": 181,
    "position": 0,
    "text": "نگه کرد پیکار دو پیل مست"
  },
  {
    "poem_id": 88008,
    "vorder": 182,
    "position": 1,
    "text": "درآورده بر یکدگر هر دو دست"
  },
  {
    "poem_id": 88008,
    "vorder": 183,
    "position": 0,
    "text": "بپولاد گفت ای سرافراز شیر"
  },
  {
    "poem_id": 88008,
    "vorder": 184,
    "position": 1,
    "text": "بکشتی گر آری مر او را بزیر"
  },
  {
    "poem_id": 88008,
    "vorder": 185,
    "position": 0,
    "text": "بخنجر جگرگاه او را بکاف"
  },
  {
    "poem_id": 88008,
    "vorder": 186,
    "position": 1,
    "text": "هنر باید از کار کردن نه لاف"
  },
  {
    "poem_id": 88008,
    "vorder": 187,
    "position": 0,
    "text": "نگه کرد گیو اندر افراسیاب"
  },
  {
    "poem_id": 88008,
    "vorder": 188,
    "position": 1,
    "text": "بدان خیره گفتار و چندان شتاب"
  },
  {
    "poem_id": 88008,
    "vorder": 189,
    "position": 0,
    "text": "برانگیخت اسپ و برآمد دمان"
  },
  {
    "poem_id": 88008,
    "vorder": 190,
    "position": 1,
    "text": "چو بشکست پیمان همی بدگمان"
  },
  {
    "poem_id": 88008,
    "vorder": 191,
    "position": 0,
    "text": "برستم چنین گفت کای جنگجوی"
  },
  {
    "poem_id": 88008,
    "vorder": 192,
    "position": 1,
    "text": "چه فرمان دهی کهتران را بگوی"
  },
  {
    "poem_id": 88008,
    "vorder": 193,
    "position": 0,
    "text": "نگه کن به پیمان افراسیاب"
  },
  {
    "poem_id": 88008,
    "vorder": 194,
    "position": 1,
    "text": "چو جای بلا دید و جای شتاب"
  },
  {
    "poem_id": 88008,
    "vorder": 195,
    "position": 0,
    "text": "بیآمد همی دل بیافروزدش"
  },
  {
    "poem_id": 88008,
    "vorder": 196,
    "position": 1,
    "text": "بکشتی درون خنجر آموزدش"
  },
  {
    "poem_id": 88008,
    "vorder": 197,
    "position": 0,
    "text": "بدو گفت رستم که جنگی منم"
  },
  {
    "poem_id": 88008,
    "vorder": 198,
    "position": 1,
    "text": "بکشتی گرفتن درنگی منم"
  },
  {
    "poem_id": 88008,
    "vorder": 199,
    "position": 0,
    "text": "شما را چرا بیم آید همی"
  },
  {
    "poem_id": 88008,
    "vorder": 200,
    "position": 1,
    "text": "چرا دل به دو نیم آید همی"
  },
  {
    "poem_id": 88008,
    "vorder": 201,
    "position": 0,
    "text": "اگر نیستتان جنگ را زور و دست"
  },
  {
    "poem_id": 88008,
    "vorder": 202,
    "position": 1,
    "text": "دل من بخیره نباید شکست"
  },
  {
    "poem_id": 88008,
    "vorder": 203,
    "position": 0,
    "text": "گر ایدونک این جادوی بی‌خرد"
  },
  {
    "poem_id": 88008,
    "vorder": 204,
    "position": 1,
    "text": "ز پیمان یزدان همی بگذرد"
  },
  {
    "poem_id": 88008,
    "vorder": 205,
    "position": 0,
    "text": "شما را ز پیمان شکستن چه باک"
  },
  {
    "poem_id": 88008,
    "vorder": 206,
    "position": 1,
    "text": "گر او ریخت بر تارک خویش خاک"
  },
  {
    "poem_id": 88008,
    "vorder": 207,
    "position": 0,
    "text": "من آکنون سر دیو پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 208,
    "position": 1,
    "text": "بخاک اندر آرم ز چرخ بلند"
  },
  {
    "poem_id": 88008,
    "vorder": 209,
    "position": 0,
    "text": "وزان پس بیازید چون شیر چنگ"
  },
  {
    "poem_id": 88008,
    "vorder": 210,
    "position": 1,
    "text": "گرفت آن بر و یال جنگی نهنگ"
  },
  {
    "poem_id": 88008,
    "vorder": 211,
    "position": 0,
    "text": "بگردن برآورد و زد بر زمین"
  },
  {
    "poem_id": 88008,
    "vorder": 212,
    "position": 1,
    "text": "همی خواند بر کردگار افرین"
  },
  {
    "poem_id": 88008,
    "vorder": 213,
    "position": 0,
    "text": "خروشی بر آمد ز ایران سپاه"
  },
  {
    "poem_id": 88008,
    "vorder": 214,
    "position": 1,
    "text": "تبیره زنان برگرفتند راه"
  },
  {
    "poem_id": 88008,
    "vorder": 215,
    "position": 0,
    "text": "بابر اندر آمد دم کرنای"
  },
  {
    "poem_id": 88008,
    "vorder": 216,
    "position": 1,
    "text": "خروشیدن نای و صنج و درای"
  },
  {
    "poem_id": 88008,
    "vorder": 217,
    "position": 0,
    "text": "که پولادوندست بیجان شده"
  },
  {
    "poem_id": 88008,
    "vorder": 218,
    "position": 1,
    "text": "بران خاک چون مار پیچان شده"
  },
  {
    "poem_id": 88008,
    "vorder": 219,
    "position": 0,
    "text": "گمان برد رستم که پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 220,
    "position": 1,
    "text": "ندارد بتن در درست ایچ بند"
  },
  {
    "poem_id": 88008,
    "vorder": 221,
    "position": 0,
    "text": "برخش دلیر اندر آورد پای"
  },
  {
    "poem_id": 88008,
    "vorder": 222,
    "position": 1,
    "text": "بماند آن تن اژدها را بجای"
  },
  {
    "poem_id": 88008,
    "vorder": 223,
    "position": 0,
    "text": "چو پیش صف آمد یل شیرگیر"
  },
  {
    "poem_id": 88008,
    "vorder": 224,
    "position": 1,
    "text": "نگه کرد پولاد برسان تیر"
  },
  {
    "poem_id": 88008,
    "vorder": 225,
    "position": 0,
    "text": "گریزان بشد پیش افراسیاب"
  },
  {
    "poem_id": 88008,
    "vorder": 226,
    "position": 1,
    "text": "دلش پر ز خون و رخش پر ز آب"
  },
  {
    "poem_id": 88008,
    "vorder": 227,
    "position": 0,
    "text": "بخفت از بر خاک تیره دراز"
  },
  {
    "poem_id": 88008,
    "vorder": 228,
    "position": 1,
    "text": "زمانی بشد هوش زان رزمساز"
  },
  {
    "poem_id": 88008,
    "vorder": 229,
    "position": 0,
    "text": "تهمتن چو پولاد را زنده دید"
  },
  {
    "poem_id": 88008,
    "vorder": 230,
    "position": 1,
    "text": "همه دشت لشکر پراگنده دید"
  },
  {
    "poem_id": 88008,
    "vorder": 231,
    "position": 0,
    "text": "دلش تنگ‌تر گشت و لشکر براند"
  },
  {
    "poem_id": 88008,
    "vorder": 232,
    "position": 1,
    "text": "جهاندیده گودرز را پیش خواند"
  },
  {
    "poem_id": 88008,
    "vorder": 233,
    "position": 0,
    "text": "بفرمود تا تیرباران کنند"
  },
  {
    "poem_id": 88008,
    "vorder": 234,
    "position": 1,
    "text": "هوا را چو ابر بهاران کنند"
  },
  {
    "poem_id": 88008,
    "vorder": 235,
    "position": 0,
    "text": "ز یک دست بیژن ز یک دست گیو"
  },
  {
    "poem_id": 88008,
    "vorder": 236,
    "position": 1,
    "text": "جهانجوی رهام و گرگین نیو"
  },
  {
    "poem_id": 88008,
    "vorder": 237,
    "position": 0,
    "text": "تو گفتی که آتش برافروختند"
  },
  {
    "poem_id": 88008,
    "vorder": 238,
    "position": 1,
    "text": "جهان را بخنجر همی سوختند"
  },
  {
    "poem_id": 88008,
    "vorder": 239,
    "position": 0,
    "text": "بلشکر چنین گفت پولادوند"
  },
  {
    "poem_id": 88008,
    "vorder": 240,
    "position": 1,
    "text": "که بی‌تخت و بی‌گنج و نام بلند"
  },
  {
    "poem_id": 88008,
    "vorder": 241,
    "position": 0,
    "text": "چرا سر همی داد باید بباد"
  },
  {
    "poem_id": 88008,
    "vorder": 242,
    "position": 1,
    "text": "چرا کرد باید همی رزم یاد"
  },
  {
    "poem_id": 88008,
    "vorder": 243,
    "position": 0,
    "text": "سپه را بپیش اندر افگند و رفت"
  },
  {
    "poem_id": 88008,
    "vorder": 244,
    "position": 1,
    "text": "ز رستم همی بند جانش بکفت"
  },
  {
    "poem_id": 88008,
    "vorder": 245,
    "position": 0,
    "text": "چنین گفت پیران بافراسیاب"
  },
  {
    "poem_id": 88008,
    "vorder": 246,
    "position": 1,
    "text": "که شد روی گیتی چو دریای آب"
  },
  {
    "poem_id": 88008,
    "vorder": 247,
    "position": 0,
    "text": "نگفتم که با رستم شوم دست"
  },
  {
    "poem_id": 88008,
    "vorder": 248,
    "position": 1,
    "text": "نشاید درین کشور ایمن نشست"
  },
  {
    "poem_id": 88008,
    "vorder": 249,
    "position": 0,
    "text": "ز خون جوانی که بد ناگریز"
  },
  {
    "poem_id": 88008,
    "vorder": 250,
    "position": 1,
    "text": "بخستی دل ما بپیکار تیز"
  },
  {
    "poem_id": 88008,
    "vorder": 251,
    "position": 0,
    "text": "چه باشی که با تو کس اندر نماند"
  },
  {
    "poem_id": 88008,
    "vorder": 252,
    "position": 1,
    "text": "بشد دیو پولاد و لشکر براند"
  },
  {
    "poem_id": 88008,
    "vorder": 253,
    "position": 0,
    "text": "همانا ز ایرانیان صد هزار"
  },
  {
    "poem_id": 88008,
    "vorder": 254,
    "position": 1,
    "text": "فزونست برگستوان‌ور سوار"
  },
  {
    "poem_id": 88008,
    "vorder": 255,
    "position": 0,
    "text": "بپیش اندرون رستم شیر گیر"
  },
  {
    "poem_id": 88008,
    "vorder": 256,
    "position": 1,
    "text": "زمین پر ز خون و هوا پر ز تیر"
  },
  {
    "poem_id": 88008,
    "vorder": 257,
    "position": 0,
    "text": "ز دریا و دشت و ز هامون و کوه"
  },
  {
    "poem_id": 88008,
    "vorder": 258,
    "position": 1,
    "text": "سپاه اندر آمد همه همگروه"
  },
  {
    "poem_id": 88008,
    "vorder": 259,
    "position": 0,
    "text": "چو مردم نماند آزمودیم دیو"
  },
  {
    "poem_id": 88008,
    "vorder": 260,
    "position": 1,
    "text": "چنین جنگ و پیکار و چندین غریو"
  },
  {
    "poem_id": 88008,
    "vorder": 261,
    "position": 0,
    "text": "سپه را چنین صف کشیده بمان"
  },
  {
    "poem_id": 88008,
    "vorder": 262,
    "position": 1,
    "text": "تو با ویژگان سوی دریا بران"
