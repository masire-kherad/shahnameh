[
  {
    "poem_id": 1865,
    "vorder": 1,
    "position": 0,
    "text": "بیامد به نزدیک چوبینه مرد"
  },
  {
    "poem_id": 1865,
    "vorder": 2,
    "position": 1,
    "text": "شنیده سخنها همه یادکرد"
  },
  {
    "poem_id": 1865,
    "vorder": 3,
    "position": 0,
    "text": "چو مرد جهانجوی نامه بخواند"
  },
  {
    "poem_id": 1865,
    "vorder": 4,
    "position": 1,
    "text": "هوارا بخواند وخرد را براند"
  },
  {
    "poem_id": 1865,
    "vorder": 5,
    "position": 0,
    "text": "ازان نامه‌ها ساز رفتن گرفت"
  },
  {
    "poem_id": 1865,
    "vorder": 6,
    "position": 1,
    "text": "بماندند ایرانیان درشگفت"
  },
  {
    "poem_id": 1865,
    "vorder": 7,
    "position": 0,
    "text": "برفتند پیران به نزدیک اوی"
  },
  {
    "poem_id": 1865,
    "vorder": 8,
    "position": 1,
    "text": "چودیدند کردار تاریک اوی"
  },
  {
    "poem_id": 1865,
    "vorder": 9,
    "position": 0,
    "text": "همی‌گفت هرکس کز ایدر مرو"
  },
  {
    "poem_id": 1865,
    "vorder": 10,
    "position": 1,
    "text": "زرفتن کهن گردد این روز نو"
  },
  {
    "poem_id": 1865,
    "vorder": 11,
    "position": 0,
    "text": "اگر خسرو آید به ایران زمین"
  },
  {
    "poem_id": 1865,
    "vorder": 12,
    "position": 1,
    "text": "نبینی مگر گرز و شمشیر کین"
  },
  {
    "poem_id": 1865,
    "vorder": 13,
    "position": 0,
    "text": "برین تخت شاهی مخور زینهار"
  },
  {
    "poem_id": 1865,
    "vorder": 14,
    "position": 1,
    "text": "همی‌خیره بفریبدت روزگار"
  },
  {
    "poem_id": 1865,
    "vorder": 15,
    "position": 0,
    "text": "نیامد سخنها برو کارگر"
  },
  {
    "poem_id": 1865,
    "vorder": 16,
    "position": 1,
    "text": "بفرمود تا رفت لشکر بدر"
  },
  {
    "poem_id": 1865,
    "vorder": 17,
    "position": 0,
    "text": "همی‌تاخت تا آذر آبادگان"
  },
  {
    "poem_id": 1865,
    "vorder": 18,
    "position": 1,
    "text": "سپاهی دلاور ز آزادگان"
  },
  {
    "poem_id": 1865,
    "vorder": 19,
    "position": 0,
    "text": "سپاه اندر آمد بتنگ سپاه"
  },
  {
    "poem_id": 1865,
    "vorder": 20,
    "position": 1,
    "text": "ببستند بر مور و بر پشه راه"
  },
  {
    "poem_id": 1865,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت پس مهتر کینه خواه"
  },
  {
    "poem_id": 1865,
    "vorder": 22,
    "position": 1,
    "text": "که من کرد خواهم به لشکر نگاه"
  },
  {
    "poem_id": 1865,
    "vorder": 23,
    "position": 0,
    "text": "ببینم که رومی سواران کیند"
  },
  {
    "poem_id": 1865,
    "vorder": 24,
    "position": 1,
    "text": "سپاهی کدامند و گردان کیند"
  },
  {
    "poem_id": 1865,
    "vorder": 25,
    "position": 0,
    "text": "همه برنشستند گردان براسپ"
  },
  {
    "poem_id": 1865,
    "vorder": 26,
    "position": 1,
    "text": "یلان سینه و مهتر ایزد گشسپ"
  },
  {
    "poem_id": 1865,
    "vorder": 27,
    "position": 0,
    "text": "بدیدار آن لشکر کینه خواه"
  },
  {
    "poem_id": 1865,
    "vorder": 28,
    "position": 1,
    "text": "گرانمایگان برگرفتند راه"
  },
  {
    "poem_id": 1865,
    "vorder": 29,
    "position": 0,
    "text": "چولشکر بدیدند باز آمدند"
  },
  {
    "poem_id": 1865,
    "vorder": 30,
    "position": 1,
    "text": "به نزدیک مهتر فراز آمدند"
  },
  {
    "poem_id": 1865,
    "vorder": 31,
    "position": 0,
    "text": "که این بی کرانه یکی لشکرند"
  },
  {
    "poem_id": 1865,
    "vorder": 32,
    "position": 1,
    "text": "ز اندیشه ما همی‌بگذرند"
  },
  {
    "poem_id": 1865,
    "vorder": 33,
    "position": 0,
    "text": "وزان روی رومی سواران شاه"
  },
  {
    "poem_id": 1865,
    "vorder": 34,
    "position": 1,
    "text": "برفتند پویان بدان بارگاه"
  },
  {
    "poem_id": 1865,
    "vorder": 35,
    "position": 0,
    "text": "ببستند بر پیش خسرو میان"
  },
  {
    "poem_id": 1865,
    "vorder": 36,
    "position": 1,
    "text": "که ما جنگ جوییم زایرانیان"
  },
  {
    "poem_id": 1865,
    "vorder": 37,
    "position": 0,
    "text": "بدان کار همداستان گشت شاه"
  },
  {
    "poem_id": 1865,
    "vorder": 38,
    "position": 1,
    "text": "کزو آرزو خواست رومی سپاه"
  }
]