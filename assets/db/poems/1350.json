[
  {
    "poem_id": 1350,
    "vorder": 1,
    "position": 0,
    "text": "نشد سیر ضحاک از آن جست جوی"
  },
  {
    "poem_id": 1350,
    "vorder": 2,
    "position": 1,
    "text": "شد از گاو گیتی پر از گفت‌گوی"
  },
  {
    "poem_id": 1350,
    "vorder": 3,
    "position": 0,
    "text": "دوان مادر آمد سوی مرغزار"
  },
  {
    "poem_id": 1350,
    "vorder": 4,
    "position": 1,
    "text": "چنین گفت با مرد زنهاردار"
  },
  {
    "poem_id": 1350,
    "vorder": 5,
    "position": 0,
    "text": "که اندیشه‌ای در دلم ایزدی"
  },
  {
    "poem_id": 1350,
    "vorder": 6,
    "position": 1,
    "text": "فراز آمده‌ست از ره بخردی"
  },
  {
    "poem_id": 1350,
    "vorder": 7,
    "position": 0,
    "text": "همی کرد باید کزین چاره نیست"
  },
  {
    "poem_id": 1350,
    "vorder": 8,
    "position": 1,
    "text": "که فرزند و شیرین روانم یکیست"
  },
  {
    "poem_id": 1350,
    "vorder": 9,
    "position": 0,
    "text": "ببرّم پی از خاک جادوستان"
  },
  {
    "poem_id": 1350,
    "vorder": 10,
    "position": 1,
    "text": "شوم تا سر مرز هندوستان"
  },
  {
    "poem_id": 1350,
    "vorder": 11,
    "position": 0,
    "text": "شوم ناپدید از میان گروه"
  },
  {
    "poem_id": 1350,
    "vorder": 12,
    "position": 1,
    "text": "برم خوب‌رخ را به البرز کوه"
  },
  {
    "poem_id": 1350,
    "vorder": 13,
    "position": 0,
    "text": "بیاورد فرزند را چون نوند"
  },
  {
    "poem_id": 1350,
    "vorder": 14,
    "position": 1,
    "text": "چو مرغان بر آن تیغ کوه بلند"
  },
  {
    "poem_id": 1350,
    "vorder": 15,
    "position": 0,
    "text": "یکی مرد دینی بر آن کوه بود"
  },
  {
    "poem_id": 1350,
    "vorder": 16,
    "position": 1,
    "text": "که از کار گیتی بی‌اندوه بود"
  },
  {
    "poem_id": 1350,
    "vorder": 17,
    "position": 0,
    "text": "فرانک بدو گفت کای پاکدین"
  },
  {
    "poem_id": 1350,
    "vorder": 18,
    "position": 1,
    "text": "منم سوگواری ز ایران زمین"
  },
  {
    "poem_id": 1350,
    "vorder": 19,
    "position": 0,
    "text": "بدان کاین گرانمایه فرزند من"
  },
  {
    "poem_id": 1350,
    "vorder": 20,
    "position": 1,
    "text": "همی بود خواهد سر انجمن"
  },
  {
    "poem_id": 1350,
    "vorder": 21,
    "position": 0,
    "text": "تو را بود باید نگهبان او"
  },
  {
    "poem_id": 1350,
    "vorder": 22,
    "position": 1,
    "text": "پدروار لرزنده بر جان او"
  },
  {
    "poem_id": 1350,
    "vorder": 23,
    "position": 0,
    "text": "پذیرفت فرزند او نیکمرد"
  },
  {
    "poem_id": 1350,
    "vorder": 24,
    "position": 1,
    "text": "نیاورد هرگز بدو باد سرد"
  },
  {
    "poem_id": 1350,
    "vorder": 25,
    "position": 0,
    "text": "خبر شد به ضحاک بدروزگار"
  },
  {
    "poem_id": 1350,
    "vorder": 26,
    "position": 1,
    "text": "از آن گاو برمایه و مرغزار"
  },
  {
    "poem_id": 1350,
    "vorder": 27,
    "position": 0,
    "text": "بیامد از آن کینه چون پیل مست"
  },
  {
    "poem_id": 1350,
    "vorder": 28,
    "position": 1,
    "text": "مر آن گاو برمایه را کرد پست"
  },
  {
    "poem_id": 1350,
    "vorder": 29,
    "position": 0,
    "text": "همه هر چه دید اندر او چارپای"
  },
  {
    "poem_id": 1350,
    "vorder": 30,
    "position": 1,
    "text": "بیفگند و زیشان بپرداخت جای"
  },
  {
    "poem_id": 1350,
    "vorder": 31,
    "position": 0,
    "text": "سبک سوی خان فریدون شتافت"
  },
  {
    "poem_id": 1350,
    "vorder": 32,
    "position": 1,
    "text": "فراوان پژوهید و کس را نیافت"
  },
  {
    "poem_id": 1350,
    "vorder": 33,
    "position": 0,
    "text": "به ایوان او آتش اندر فگند"
  },
  {
    "poem_id": 1350,
    "vorder": 34,
    "position": 1,
    "text": "ز پای اندر آورد کاخ بلند"
  }
]