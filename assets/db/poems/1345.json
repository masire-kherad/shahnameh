[
  {
    "poem_id": 1345,
    "vorder": 1,
    "position": 0,
    "text": "از آن پس برآمد ز ایران خروش"
  },
  {
    "poem_id": 1345,
    "vorder": 2,
    "position": 1,
    "text": "پدید آمد از هر سویی جنگ و جوش"
  },
  {
    "poem_id": 1345,
    "vorder": 3,
    "position": 0,
    "text": "سیه گشت رخشنده روز سپید"
  },
  {
    "poem_id": 1345,
    "vorder": 4,
    "position": 1,
    "text": "گسستند پیوند از جمّشید"
  },
  {
    "poem_id": 1345,
    "vorder": 5,
    "position": 0,
    "text": "بر او تیره شد فرّهٔ ایزدی"
  },
  {
    "poem_id": 1345,
    "vorder": 6,
    "position": 1,
    "text": "به کژی گرایید و نابخردی"
  },
  {
    "poem_id": 1345,
    "vorder": 7,
    "position": 0,
    "text": "پدید آمد از هر سویی خسروی"
  },
  {
    "poem_id": 1345,
    "vorder": 8,
    "position": 1,
    "text": "یکی نامجویی ز هر پهلُوی"
  },
  {
    "poem_id": 1345,
    "vorder": 9,
    "position": 0,
    "text": "سپه کرده و جنگ را ساخته"
  },
  {
    "poem_id": 1345,
    "vorder": 10,
    "position": 1,
    "text": "دل از مهر جمشید پرداخته"
  },
  {
    "poem_id": 1345,
    "vorder": 11,
    "position": 0,
    "text": "یکایک ز ایران برآمد سپاه"
  },
  {
    "poem_id": 1345,
    "vorder": 12,
    "position": 1,
    "text": "سوی تازیان برگرفتند راه"
  },
  {
    "poem_id": 1345,
    "vorder": 13,
    "position": 0,
    "text": "شنودند کان‌جا یکی مهتر است"
  },
  {
    "poem_id": 1345,
    "vorder": 14,
    "position": 1,
    "text": "پر از هول شاه اژدها پیکر است"
  },
  {
    "poem_id": 1345,
    "vorder": 15,
    "position": 0,
    "text": "سواران ایران همه شاه‌جوی"
  },
  {
    "poem_id": 1345,
    "vorder": 16,
    "position": 1,
    "text": "نهادند یک‌سر به ضحاک روی"
  },
  {
    "poem_id": 1345,
    "vorder": 17,
    "position": 0,
    "text": "به شاهی بر او آفرین خواندند"
  },
  {
    "poem_id": 1345,
    "vorder": 18,
    "position": 1,
    "text": "ورا شاه ایران زمین خواندند"
  },
  {
    "poem_id": 1345,
    "vorder": 19,
    "position": 0,
    "text": "کی اژدهافش بیامد چو باد"
  },
  {
    "poem_id": 1345,
    "vorder": 20,
    "position": 1,
    "text": "به ایران زمین تاج بر سر نهاد"
  },
  {
    "poem_id": 1345,
    "vorder": 21,
    "position": 0,
    "text": "از ایران و از تازیان لشکری"
  },
  {
    "poem_id": 1345,
    "vorder": 22,
    "position": 1,
    "text": "گزین کرد گرد از همه کشوری"
  },
  {
    "poem_id": 1345,
    "vorder": 23,
    "position": 0,
    "text": "سوی تخت جمشید بنهاد روی"
  },
  {
    "poem_id": 1345,
    "vorder": 24,
    "position": 1,
    "text": "چو انگشتری کرد گیتی بروی"
  },
  {
    "poem_id": 1345,
    "vorder": 25,
    "position": 0,
    "text": "چو جمشید را بخت شد کندرو"
  },
  {
    "poem_id": 1345,
    "vorder": 26,
    "position": 1,
    "text": "به تنگ اندر آمد جهاندار نو"
  },
  {
    "poem_id": 1345,
    "vorder": 27,
    "position": 0,
    "text": "برفت و بدو داد تخت و کلاه"
  },
  {
    "poem_id": 1345,
    "vorder": 28,
    "position": 1,
    "text": "بزرگی و دیهیم و گنج و سپاه"
  },
  {
    "poem_id": 1345,
    "vorder": 29,
    "position": 0,
    "text": "چو صد سالش اندر جهان کس ندید"
  },
  {
    "poem_id": 1345,
    "vorder": 30,
    "position": 1,
    "text": "بر او نام شاهی و او ناپدید"
  },
  {
    "poem_id": 1345,
    "vorder": 31,
    "position": 0,
    "text": "صدم سال روزی به دریای چین"
  },
  {
    "poem_id": 1345,
    "vorder": 32,
    "position": 1,
    "text": "پدید آمد آن شاه ناپاک دین"
  },
  {
    "poem_id": 1345,
    "vorder": 33,
    "position": 0,
    "text": "نهان گشته بود از بد اژدها"
  },
  {
    "poem_id": 1345,
    "vorder": 34,
    "position": 1,
    "text": "نیامد به فرجام هم ز او رها"
  },
  {
    "poem_id": 1345,
    "vorder": 35,
    "position": 0,
    "text": "چو ضحاکش آورد ناگه به چنگ"
  },
  {
    "poem_id": 1345,
    "vorder": 36,
    "position": 1,
    "text": "یکایک ندادش زمانی درنگ"
  },
  {
    "poem_id": 1345,
    "vorder": 37,
    "position": 0,
    "text": "به ارّه‌ش سراسر به دو نیم کرد"
  },
  {
    "poem_id": 1345,
    "vorder": 38,
    "position": 1,
    "text": "جهان را از او پاک بی‌بیم کرد"
  },
  {
    "poem_id": 1345,
    "vorder": 39,
    "position": 0,
    "text": "شد آن تخت شاهی و آن دستگاه"
  },
  {
    "poem_id": 1345,
    "vorder": 40,
    "position": 1,
    "text": "زمانه ربودش چو بیجاده کاه"
  },
  {
    "poem_id": 1345,
    "vorder": 41,
    "position": 0,
    "text": "از او بیش بر تخت شاهی که بود"
  },
  {
    "poem_id": 1345,
    "vorder": 42,
    "position": 1,
    "text": "بر آن رنج بردن چه آمدش سود"
  },
  {
    "poem_id": 1345,
    "vorder": 43,
    "position": 0,
    "text": "گذشته بر او سالیان هفتصد"
  },
  {
    "poem_id": 1345,
    "vorder": 44,
    "position": 1,
    "text": "پدید آوریده همه نیک و بد"
  },
  {
    "poem_id": 1345,
    "vorder": 45,
    "position": 0,
    "text": "چه باید همه زندگانی دراز"
  },
  {
    "poem_id": 1345,
    "vorder": 46,
    "position": 1,
    "text": "چو گیتی نخواهد گشادنت راز"
  },
  {
    "poem_id": 1345,
    "vorder": 47,
    "position": 0,
    "text": "همی پروراندت با شهد و نوش"
  },
  {
    "poem_id": 1345,
    "vorder": 48,
    "position": 1,
    "text": "جز آواز نرمت نیاید به گوش"
  },
  {
    "poem_id": 1345,
    "vorder": 49,
    "position": 0,
    "text": "یکایک چو گوئی که گسترد مهر"
  },
  {
    "poem_id": 1345,
    "vorder": 50,
    "position": 1,
    "text": "نخواهد نمودن به بد نیز چهر"
  },
  {
    "poem_id": 1345,
    "vorder": 51,
    "position": 0,
    "text": "بدو شاد باشی و نازی بدوی"
  },
  {
    "poem_id": 1345,
    "vorder": 52,
    "position": 1,
    "text": "همان راز دل را گشایی بدوی"
  },
  {
    "poem_id": 1345,
    "vorder": 53,
    "position": 0,
    "text": "یکی نغز بازی برون آورد"
  },
  {
    "poem_id": 1345,
    "vorder": 54,
    "position": 1,
    "text": "به دلت اندرون درد و خون آورد"
  },
  {
    "poem_id": 1345,
    "vorder": 55,
    "position": 0,
    "text": "دلم سیر شد زین سرای سپنج"
  },
  {
    "poem_id": 1345,
    "vorder": 56,
    "position": 1,
    "text": "خدایا مرا زود بِرْهان ز رنج"
  }
]