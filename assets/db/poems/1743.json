[
  {
    "poem_id": 1743,
    "vorder": 1,
    "position": 0,
    "text": "چو شب دامن روز اندر کشید"
  },
  {
    "poem_id": 1743,
    "vorder": 2,
    "position": 1,
    "text": "درفش خور آمد ز بالا پدید"
  },
  {
    "poem_id": 1743,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود شاپور تا شد دبیر"
  },
  {
    "poem_id": 1743,
    "vorder": 4,
    "position": 1,
    "text": "قلم خواست و انقاس و مشک و حریر"
  },
  {
    "poem_id": 1743,
    "vorder": 5,
    "position": 0,
    "text": "نوشتند نامه به هر مهتری"
  },
  {
    "poem_id": 1743,
    "vorder": 6,
    "position": 1,
    "text": "به هر پادشاهی و هر کشوری"
  },
  {
    "poem_id": 1743,
    "vorder": 7,
    "position": 0,
    "text": "سرنامه کرد آفرین مهان"
  },
  {
    "poem_id": 1743,
    "vorder": 8,
    "position": 1,
    "text": "ز ما بنده بر کردگار جهان"
  },
  {
    "poem_id": 1743,
    "vorder": 9,
    "position": 0,
    "text": "که اوراست بر نیکویی دست‌رس"
  },
  {
    "poem_id": 1743,
    "vorder": 10,
    "position": 1,
    "text": "به نیرو نیازش نیاید به کس"
  },
  {
    "poem_id": 1743,
    "vorder": 11,
    "position": 0,
    "text": "همو آفرینندهٔ روزگار"
  },
  {
    "poem_id": 1743,
    "vorder": 12,
    "position": 1,
    "text": "به نیکی همو باشد آموزگار"
  },
  {
    "poem_id": 1743,
    "vorder": 13,
    "position": 0,
    "text": "چو قیصر که فرمان یزدان بهشت"
  },
  {
    "poem_id": 1743,
    "vorder": 14,
    "position": 1,
    "text": "به ایران به جز تخم زشتی نکشت"
  },
  {
    "poem_id": 1743,
    "vorder": 15,
    "position": 0,
    "text": "به زاری همی بند ساید کنون"
  },
  {
    "poem_id": 1743,
    "vorder": 16,
    "position": 1,
    "text": "چو جان را نبودش خرد رهنمون"
  },
  {
    "poem_id": 1743,
    "vorder": 17,
    "position": 0,
    "text": "همان تاج ایران بدو در سپرد"
  },
  {
    "poem_id": 1743,
    "vorder": 18,
    "position": 1,
    "text": "ز گیتی به جز نام زشتی نبرد"
  },
  {
    "poem_id": 1743,
    "vorder": 19,
    "position": 0,
    "text": "گسسته شد آن لشکر و بارگاه"
  },
  {
    "poem_id": 1743,
    "vorder": 20,
    "position": 1,
    "text": "به نیروی یزدان که بنمود راه"
  },
  {
    "poem_id": 1743,
    "vorder": 21,
    "position": 0,
    "text": "هرانکس که باشد ز رومی به شهر"
  },
  {
    "poem_id": 1743,
    "vorder": 22,
    "position": 1,
    "text": "ز شمشیر باید که یابند بهر"
  },
  {
    "poem_id": 1743,
    "vorder": 23,
    "position": 0,
    "text": "همه داد جویید و فرمان کنید"
  },
  {
    "poem_id": 1743,
    "vorder": 24,
    "position": 1,
    "text": "به خوبی ز سر باز پیمان کنید"
  },
  {
    "poem_id": 1743,
    "vorder": 25,
    "position": 0,
    "text": "هیونی بر آمد ز هر سو دمان"
  },
  {
    "poem_id": 1743,
    "vorder": 26,
    "position": 1,
    "text": "ابا نامهٔ شاه روشن روان"
  },
  {
    "poem_id": 1743,
    "vorder": 27,
    "position": 0,
    "text": "ز لشکرگه آمد سوی طیسفون"
  },
  {
    "poem_id": 1743,
    "vorder": 28,
    "position": 1,
    "text": "بی‌آزار بنشست با رهنمون"
  },
  {
    "poem_id": 1743,
    "vorder": 29,
    "position": 0,
    "text": "چو تاج نیاکانش بر سر نهاد"
  },
  {
    "poem_id": 1743,
    "vorder": 30,
    "position": 1,
    "text": "ز دادار نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1743,
    "vorder": 31,
    "position": 0,
    "text": "بفرمود تا شد به زندان دبیر"
  },
  {
    "poem_id": 1743,
    "vorder": 32,
    "position": 1,
    "text": "به انقاس بنوشت نام اسیر"
  },
  {
    "poem_id": 1743,
    "vorder": 33,
    "position": 0,
    "text": "هزار و صد و ده برآمد شمار"
  },
  {
    "poem_id": 1743,
    "vorder": 34,
    "position": 1,
    "text": "بزرگان روم آنک بد نامدار"
  },
  {
    "poem_id": 1743,
    "vorder": 35,
    "position": 0,
    "text": "همه خویش و پیوند قیصر بدند"
  },
  {
    "poem_id": 1743,
    "vorder": 36,
    "position": 1,
    "text": "به روم اندرون ویژه مهتر بدند"
  },
  {
    "poem_id": 1743,
    "vorder": 37,
    "position": 0,
    "text": "جهاندار ببریدشان دست و پای"
  },
  {
    "poem_id": 1743,
    "vorder": 38,
    "position": 1,
    "text": "هرانکس که بد بر بدی رهنمای"
  },
  {
    "poem_id": 1743,
    "vorder": 39,
    "position": 0,
    "text": "بفرمود تا قیصر روم را"
  },
  {
    "poem_id": 1743,
    "vorder": 40,
    "position": 1,
    "text": "بیارند سالار آن بوم را"
  },
  {
    "poem_id": 1743,
    "vorder": 41,
    "position": 0,
    "text": "بشد روزبان دست قیصرکشان"
  },
  {
    "poem_id": 1743,
    "vorder": 42,
    "position": 1,
    "text": "ز زندان بیاورد چون بیهشان"
  },
  {
    "poem_id": 1743,
    "vorder": 43,
    "position": 0,
    "text": "جفادیده چون روی شاپور دید"
  },
  {
    "poem_id": 1743,
    "vorder": 44,
    "position": 1,
    "text": "سرشکش ز دیده به رخ بر چکید"
  },
  {
    "poem_id": 1743,
    "vorder": 45,
    "position": 0,
    "text": "بمالید رنگین رخش بر زمین"
  },
  {
    "poem_id": 1743,
    "vorder": 46,
    "position": 1,
    "text": "همی کرد بر تاج و تخت آفرین"
  },
  {
    "poem_id": 1743,
    "vorder": 47,
    "position": 0,
    "text": "زمین را سراسر به مژگان برفت"
  },
  {
    "poem_id": 1743,
    "vorder": 48,
    "position": 1,
    "text": "به موی و به روی گشت با خاک جفت"
  },
  {
    "poem_id": 1743,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت شاه ای سراسر بدی"
  },
  {
    "poem_id": 1743,
    "vorder": 50,
    "position": 1,
    "text": "که ترسایی و دشمن ایزدی"
  },
  {
    "poem_id": 1743,
    "vorder": 51,
    "position": 0,
    "text": "پسر گویی آنرا کش انباز نیست"
  },
  {
    "poem_id": 1743,
    "vorder": 52,
    "position": 1,
    "text": "ز گیتیش فرجام و آغاز نیست"
  },
  {
    "poem_id": 1743,
    "vorder": 53,
    "position": 0,
    "text": "ندانی تو گفتن سخن جز دروغ"
  },
  {
    "poem_id": 1743,
    "vorder": 54,
    "position": 1,
    "text": "دروغ آتشی بد بود بی‌فروغ"
  },
  {
    "poem_id": 1743,
    "vorder": 55,
    "position": 0,
    "text": "اگر قیصری شرم و رایت کجاست"
  },
  {
    "poem_id": 1743,
    "vorder": 56,
    "position": 1,
    "text": "به خوبی دل رهنمایت کجاست"
  },
  {
    "poem_id": 1743,
    "vorder": 57,
    "position": 0,
    "text": "چرا بندم از چرم خر ساختی"
  },
  {
    "poem_id": 1743,
    "vorder": 58,
    "position": 1,
    "text": "بزرگی به خاک اندر انداختی"
  },
  {
    "poem_id": 1743,
    "vorder": 59,
    "position": 0,
    "text": "چو بازارگانان به بزم آمدم"
  },
  {
    "poem_id": 1743,
    "vorder": 60,
    "position": 1,
    "text": "نه با کوس و لشکر به رزم آمدم"
  },
  {
    "poem_id": 1743,
    "vorder": 61,
    "position": 0,
    "text": "تو مهمان به چرم خر اندر کنی"
  },
  {
    "poem_id": 1743,
    "vorder": 62,
    "position": 1,
    "text": "به ایران گرایی و لشکر کنی"
  },
  {
    "poem_id": 1743,
    "vorder": 63,
    "position": 0,
    "text": "ببینی کنون جنگ مردان مرد"
  },
  {
    "poem_id": 1743,
    "vorder": 64,
    "position": 1,
    "text": "کزان پس نجویی به ایران نبرد"
  },
  {
    "poem_id": 1743,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت قیصر که ای شهریار"
  },
  {
    "poem_id": 1743,
    "vorder": 66,
    "position": 1,
    "text": "ز فرمان یزدان که یابد گذار"
  },
  {
    "poem_id": 1743,
    "vorder": 67,
    "position": 0,
    "text": "ز من بخت شاها خرد دور کرد"
  },
  {
    "poem_id": 1743,
    "vorder": 68,
    "position": 1,
    "text": "روانم بر دیو مزدور کرد"
  },
  {
    "poem_id": 1743,
    "vorder": 69,
    "position": 0,
    "text": "مکافات بد گر کنی نیکوی"
  },
  {
    "poem_id": 1743,
    "vorder": 70,
    "position": 1,
    "text": "به گیتی درون داستانی شوی"
  },
  {
    "poem_id": 1743,
    "vorder": 71,
    "position": 0,
    "text": "که هرگز نگردد کهن نام تو"
  },
  {
    "poem_id": 1743,
    "vorder": 72,
    "position": 1,
    "text": "برآید به مردی همه کام تو"
  },
  {
    "poem_id": 1743,
    "vorder": 73,
    "position": 0,
    "text": "اگر یابم از تو به جان زینهار"
  },
  {
    "poem_id": 1743,
    "vorder": 74,
    "position": 1,
    "text": "به چشمم شود گنج و دینار خوار"
  },
  {
    "poem_id": 1743,
    "vorder": 75,
    "position": 0,
    "text": "یکی بنده باشم به درگاه تو"
  },
  {
    "poem_id": 1743,
    "vorder": 76,
    "position": 1,
    "text": "نجویم جز آرایش گاه تو"
  },
  {
    "poem_id": 1743,
    "vorder": 77,
    "position": 0,
    "text": "بدو شاه گفت ای بد بی‌هنر"
  },
  {
    "poem_id": 1743,
    "vorder": 78,
    "position": 1,
    "text": "چرا کردی این بوم زیر و زبر"
  },
  {
    "poem_id": 1743,
    "vorder": 79,
    "position": 0,
    "text": "کنون هرک بردی ز ایران اسیر"
  },
  {
    "poem_id": 1743,
    "vorder": 80,
    "position": 1,
    "text": "همه باز خواهم ز تو ناگزیر"
  },
  {
    "poem_id": 1743,
    "vorder": 81,
    "position": 0,
    "text": "دگر خواسته هرچ بردی به روم"
  },
  {
    "poem_id": 1743,
    "vorder": 82,
    "position": 1,
    "text": "مبادا که بینی تو آن بوم شوم"
  },
  {
    "poem_id": 1743,
    "vorder": 83,
    "position": 0,
    "text": "همه یکسر از خانه بازآوری"
  },
  {
    "poem_id": 1743,
    "vorder": 84,
    "position": 1,
    "text": "بدین لشکر سرفراز آوری"
  },
  {
    "poem_id": 1743,
    "vorder": 85,
    "position": 0,
    "text": "از ایران هرانجا که ویران شدست"
  },
  {
    "poem_id": 1743,
    "vorder": 86,
    "position": 1,
    "text": "کنام پلنگان و شیران شدست"
  },
  {
    "poem_id": 1743,
    "vorder": 87,
    "position": 0,
    "text": "سراسر برآری به دینار خویش"
  },
  {
    "poem_id": 1743,
    "vorder": 88,
    "position": 1,
    "text": "بیابی مکافات کردار خویش"
  },
  {
    "poem_id": 1743,
    "vorder": 89,
    "position": 0,
    "text": "دگر هرک کشتی ز ایرانیان"
  },
  {
    "poem_id": 1743,
    "vorder": 90,
    "position": 1,
    "text": "بجویی ز روم از نژاد کیان"
  },
  {
    "poem_id": 1743,
    "vorder": 91,
    "position": 0,
    "text": "به یک تن ده از روم تاوان دهی"
  },
  {
    "poem_id": 1743,
    "vorder": 92,
    "position": 1,
    "text": "روان را به پیمان گروگان دهی"
  },
  {
    "poem_id": 1743,
    "vorder": 93,
    "position": 0,
    "text": "نخواهم به جز مرد قیصرنژاد"
  },
  {
    "poem_id": 1743,
    "vorder": 94,
    "position": 1,
    "text": "که باشند با ما بدین بوم شاد"
  },
  {
    "poem_id": 1743,
    "vorder": 95,
    "position": 0,
    "text": "دگر هرچ ز ایران بریدی درخت"
  },
  {
    "poem_id": 1743,
    "vorder": 96,
    "position": 1,
    "text": "نبرد درخت گشن نیک‌بخت"
  },
  {
    "poem_id": 1743,
    "vorder": 97,
    "position": 0,
    "text": "بکاری و دیوارها برکنی"
  },
  {
    "poem_id": 1743,
    "vorder": 98,
    "position": 1,
    "text": "ز دلها مگر خشم کمتر کنی"
  },
  {
    "poem_id": 1743,
    "vorder": 99,
    "position": 0,
    "text": "کنون من به بندی ببندم ترا"
  },
  {
    "poem_id": 1743,
    "vorder": 100,
    "position": 1,
    "text": "ز چرم خران کی پسندم ترا"
  },
  {
    "poem_id": 1743,
    "vorder": 101,
    "position": 0,
    "text": "گرین هرچ گفتم نیاری به جای"
  },
  {
    "poem_id": 1743,
    "vorder": 102,
    "position": 1,
    "text": "بدرند چرمت ز سر تا به پای"
  },
  {
    "poem_id": 1743,
    "vorder": 103,
    "position": 0,
    "text": "دو گوشش به خنجر بدو شاخ کرد"
  },
  {
    "poem_id": 1743,
    "vorder": 104,
    "position": 1,
    "text": "به یک جای بینیش سوراخ کرد"
  },
  {
    "poem_id": 1743,
    "vorder": 105,
    "position": 0,
    "text": "مهاری به بینی او برنهاد"
  },
  {
    "poem_id": 1743,
    "vorder": 106,
    "position": 1,
    "text": "چو شاپور زان چرم خر کرد یاد"
  },
  {
    "poem_id": 1743,
    "vorder": 107,
    "position": 0,
    "text": "دو بند گران برنهادش به پای"
  },
  {
    "poem_id": 1743,
    "vorder": 108,
    "position": 1,
    "text": "ببردش همان روزبان باز جای"
  }
]