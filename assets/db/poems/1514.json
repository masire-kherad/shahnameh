[
  {
    "poem_id": 1514,
    "vorder": 1,
    "position": 0,
    "text": "چو گشتاسپ نزدیک دریا رسید"
  },
  {
    "poem_id": 1514,
    "vorder": 2,
    "position": 1,
    "text": "پیاده شد و باژ خواهش بدید"
  },
  {
    "poem_id": 1514,
    "vorder": 3,
    "position": 0,
    "text": "یکی پیرسر بود هیشوی نام"
  },
  {
    "poem_id": 1514,
    "vorder": 4,
    "position": 1,
    "text": "جوانمرد و بیدار و با رای و کام"
  },
  {
    "poem_id": 1514,
    "vorder": 5,
    "position": 0,
    "text": "برو آفرین کرد گشتاسپ و گفت"
  },
  {
    "poem_id": 1514,
    "vorder": 6,
    "position": 1,
    "text": "که با جان پاکت خرد باد جفت"
  },
  {
    "poem_id": 1514,
    "vorder": 7,
    "position": 0,
    "text": "ازایران یکی نامدارم دبیر"
  },
  {
    "poem_id": 1514,
    "vorder": 8,
    "position": 1,
    "text": "خردمند و روشن‌دل و یادگیر"
  },
  {
    "poem_id": 1514,
    "vorder": 9,
    "position": 0,
    "text": "به کشتی برین آب اگر بگذرم"
  },
  {
    "poem_id": 1514,
    "vorder": 10,
    "position": 1,
    "text": "سپاسی نهی جاودان بر سرم"
  },
  {
    "poem_id": 1514,
    "vorder": 11,
    "position": 0,
    "text": "چنین گفت شایسته‌ای تاج را"
  },
  {
    "poem_id": 1514,
    "vorder": 12,
    "position": 1,
    "text": "و یا جوشن و تیغ و تاراج را"
  },
  {
    "poem_id": 1514,
    "vorder": 13,
    "position": 0,
    "text": "کنون راز بگشای و با من بگوی"
  },
  {
    "poem_id": 1514,
    "vorder": 14,
    "position": 1,
    "text": "ازین سان به دریا گذشتن مجوی"
  },
  {
    "poem_id": 1514,
    "vorder": 15,
    "position": 0,
    "text": "مرا هدیه باید اگر گفت راست"
  },
  {
    "poem_id": 1514,
    "vorder": 16,
    "position": 1,
    "text": "ترا رای و راه دبیری کجاست"
  },
  {
    "poem_id": 1514,
    "vorder": 17,
    "position": 0,
    "text": "ز هیشوی بشنید گشتاسپ گفت"
  },
  {
    "poem_id": 1514,
    "vorder": 18,
    "position": 1,
    "text": "که از تو مرا نیست چیزی نهفت"
  },
  {
    "poem_id": 1514,
    "vorder": 19,
    "position": 0,
    "text": "ز من هرچ خواهی ندارم دریغ"
  },
  {
    "poem_id": 1514,
    "vorder": 20,
    "position": 1,
    "text": "ازین افسر و مهر و دینار و تیغ"
  },
  {
    "poem_id": 1514,
    "vorder": 21,
    "position": 0,
    "text": "ز دینار لختی به هیشوی داد"
  },
  {
    "poem_id": 1514,
    "vorder": 22,
    "position": 1,
    "text": "ازان هدیه شد مرد گیرنده شاد"
  },
  {
    "poem_id": 1514,
    "vorder": 23,
    "position": 0,
    "text": "ز کشتی سبک بادبان برکشید"
  },
  {
    "poem_id": 1514,
    "vorder": 24,
    "position": 1,
    "text": "جهانجوی را سوی قیصر کشید"
  },
  {
    "poem_id": 1514,
    "vorder": 25,
    "position": 0,
    "text": "یکی شارستان بد به روم اندرون"
  },
  {
    "poem_id": 1514,
    "vorder": 26,
    "position": 1,
    "text": "سه فرسنگ پهنای شهرش فزون"
  },
  {
    "poem_id": 1514,
    "vorder": 27,
    "position": 0,
    "text": "برآوردهٔ سلم جای بزرگ"
  },
  {
    "poem_id": 1514,
    "vorder": 28,
    "position": 1,
    "text": "نشستنگه قیصران سترگ"
  },
  {
    "poem_id": 1514,
    "vorder": 29,
    "position": 0,
    "text": "چو گشتاسپ آمد بدان شارستان"
  },
  {
    "poem_id": 1514,
    "vorder": 30,
    "position": 1,
    "text": "همی جست جای یکی کارستان"
  },
  {
    "poem_id": 1514,
    "vorder": 31,
    "position": 0,
    "text": "همی گشت یک هفته بر گرد روم"
  },
  {
    "poem_id": 1514,
    "vorder": 32,
    "position": 1,
    "text": "همی کار جست اندر آباد بوم"
  },
  {
    "poem_id": 1514,
    "vorder": 33,
    "position": 0,
    "text": "چو چیزی که بودش بخورد و بداد"
  },
  {
    "poem_id": 1514,
    "vorder": 34,
    "position": 1,
    "text": "همی رفت ناشاد و دل پر ز باد"
  },
  {
    "poem_id": 1514,
    "vorder": 35,
    "position": 0,
    "text": "چو در شهر آباد چندی بگشت"
  },
  {
    "poem_id": 1514,
    "vorder": 36,
    "position": 1,
    "text": "ز ایوان به دیوان قیصر گذشت"
  },
  {
    "poem_id": 1514,
    "vorder": 37,
    "position": 0,
    "text": "به اسقف چنین گفت کای دستگیر"
  },
  {
    "poem_id": 1514,
    "vorder": 38,
    "position": 1,
    "text": "ز ایران یکی نامجویم دبیر"
  },
  {
    "poem_id": 1514,
    "vorder": 39,
    "position": 0,
    "text": "بدین کار باشم ترا یارمند"
  },
  {
    "poem_id": 1514,
    "vorder": 40,
    "position": 1,
    "text": "ز دیوان کنم هرچ آید پسند"
  },
  {
    "poem_id": 1514,
    "vorder": 41,
    "position": 0,
    "text": "دبیران که بودند در بارگاه"
  },
  {
    "poem_id": 1514,
    "vorder": 42,
    "position": 1,
    "text": "همی کرد هریک به دیگر نگاه"
  },
  {
    "poem_id": 1514,
    "vorder": 43,
    "position": 0,
    "text": "کزین کلک پولاد گریان شود"
  },
  {
    "poem_id": 1514,
    "vorder": 44,
    "position": 1,
    "text": "همان روی قرطاس بریان شود"
  },
  {
    "poem_id": 1514,
    "vorder": 45,
    "position": 0,
    "text": "یکی باره باید به زیرش بلند"
  },
  {
    "poem_id": 1514,
    "vorder": 46,
    "position": 1,
    "text": "به بازو کمان و به زین بر کمند"
  },
  {
    "poem_id": 1514,
    "vorder": 47,
    "position": 0,
    "text": "به آواز گفتند ما را دبیر"
  },
  {
    "poem_id": 1514,
    "vorder": 48,
    "position": 1,
    "text": "زیانست پیش آمدن ناگزیر"
  },
  {
    "poem_id": 1514,
    "vorder": 49,
    "position": 0,
    "text": "چو بشنید گشتاسپ دل پر ز درد"
  },
  {
    "poem_id": 1514,
    "vorder": 50,
    "position": 1,
    "text": "ز دیوان بیامد دو رخساره زرد"
  },
  {
    "poem_id": 1514,
    "vorder": 51,
    "position": 0,
    "text": "یکی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1514,
    "vorder": 52,
    "position": 1,
    "text": "به نزدیک چوپان قیصر رسید"
  },
  {
    "poem_id": 1514,
    "vorder": 53,
    "position": 0,
    "text": "جوانمرد را نام نستاو بود"
  },
  {
    "poem_id": 1514,
    "vorder": 54,
    "position": 1,
    "text": "دلیر و هشیوار و با تاو بود"
  },
  {
    "poem_id": 1514,
    "vorder": 55,
    "position": 0,
    "text": "به نزدیک نستاو چون شد فراز"
  },
  {
    "poem_id": 1514,
    "vorder": 56,
    "position": 1,
    "text": "برو آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1514,
    "vorder": 57,
    "position": 0,
    "text": "نگه کرد چوپان و بنواختش"
  },
  {
    "poem_id": 1514,
    "vorder": 58,
    "position": 1,
    "text": "به نزدیکی خویش بنشاختش"
  },
  {
    "poem_id": 1514,
    "vorder": 59,
    "position": 0,
    "text": "چه مردی بدو گفت با من بگوی"
  },
  {
    "poem_id": 1514,
    "vorder": 60,
    "position": 1,
    "text": "که هم شاه شاخی و هم نامجوی"
  },
  {
    "poem_id": 1514,
    "vorder": 61,
    "position": 0,
    "text": "چنین داد پاسخ که ای نامدار"
  },
  {
    "poem_id": 1514,
    "vorder": 62,
    "position": 1,
    "text": "یکی کره تازم دلیر و سوار"
  },
  {
    "poem_id": 1514,
    "vorder": 63,
    "position": 0,
    "text": "مرا گر نوازی به کار آیمت"
  },
  {
    "poem_id": 1514,
    "vorder": 64,
    "position": 1,
    "text": "به رنج و به بد نیز یار آیمت"
  },
  {
    "poem_id": 1514,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت نستاو زین در بگرد"
  },
  {
    "poem_id": 1514,
    "vorder": 66,
    "position": 1,
    "text": "تو ایدر غریبی وبی‌پای مرد"
  },
  {
    "poem_id": 1514,
    "vorder": 67,
    "position": 0,
    "text": "بیابان و دریا و اسپان یله"
  },
  {
    "poem_id": 1514,
    "vorder": 68,
    "position": 1,
    "text": "به ناآشنا چون سپارم گله"
  },
  {
    "poem_id": 1514,
    "vorder": 69,
    "position": 0,
    "text": "چو بشنید گشتاسپ غمگین برفت"
  },
  {
    "poem_id": 1514,
    "vorder": 70,
    "position": 1,
    "text": "ره ساربانان قیصر گرفت"
  },
  {
    "poem_id": 1514,
    "vorder": 71,
    "position": 0,
    "text": "یکی آفرین کرد بر ساربان"
  },
  {
    "poem_id": 1514,
    "vorder": 72,
    "position": 1,
    "text": "که پیروز بادی و روشن روان"
  },
  {
    "poem_id": 1514,
    "vorder": 73,
    "position": 0,
    "text": "خردمند چون روی گشتاسپ دید"
  },
  {
    "poem_id": 1514,
    "vorder": 74,
    "position": 1,
    "text": "پذیره شد و جایگاهش گزید"
  },
  {
    "poem_id": 1514,
    "vorder": 75,
    "position": 0,
    "text": "سبک باز گسترد گستردنی"
  },
  {
    "poem_id": 1514,
    "vorder": 76,
    "position": 1,
    "text": "بیاورد چیزی که بد خوردنی"
  },
  {
    "poem_id": 1514,
    "vorder": 77,
    "position": 0,
    "text": "چنین گفت گشتاسپ با ساروان"
  },
  {
    "poem_id": 1514,
    "vorder": 78,
    "position": 1,
    "text": "که این مرد بیدار و روشن روان"
  },
  {
    "poem_id": 1514,
    "vorder": 79,
    "position": 0,
    "text": "مرا ده یکی کاروانی شتر"
  },
  {
    "poem_id": 1514,
    "vorder": 80,
    "position": 1,
    "text": "چو رای آیدت مزد ما هم ببر"
  },
  {
    "poem_id": 1514,
    "vorder": 81,
    "position": 0,
    "text": "بدو ساربان گفت کای شیرمرد"
  },
  {
    "poem_id": 1514,
    "vorder": 82,
    "position": 1,
    "text": "نزیبد ترا هرگز این کارکرد"
  },
  {
    "poem_id": 1514,
    "vorder": 83,
    "position": 0,
    "text": "به چیزی که ما راست چون سر کنی"
  },
  {
    "poem_id": 1514,
    "vorder": 84,
    "position": 1,
    "text": "به آید گر آهنگ قیصر کنی"
  },
  {
    "poem_id": 1514,
    "vorder": 85,
    "position": 0,
    "text": "ترا بی‌نیازی دهد زین سخن"
  },
  {
    "poem_id": 1514,
    "vorder": 86,
    "position": 1,
    "text": "جز آهنگ درگاه قیصر مکن"
  },
  {
    "poem_id": 1514,
    "vorder": 87,
    "position": 0,
    "text": "و گر گم شدت راه دارم هیون"
  },
  {
    "poem_id": 1514,
    "vorder": 88,
    "position": 1,
    "text": "پسندیده و مردم رهنمون"
  },
  {
    "poem_id": 1514,
    "vorder": 89,
    "position": 0,
    "text": "برو آفرین کرد و برگشت زوی"
  },
  {
    "poem_id": 1514,
    "vorder": 90,
    "position": 1,
    "text": "پر از غم سوی شهر بنهاد روی"
  },
  {
    "poem_id": 1514,
    "vorder": 91,
    "position": 0,
    "text": "شد آن دردها بر دلش بر گران"
  },
  {
    "poem_id": 1514,
    "vorder": 92,
    "position": 1,
    "text": "بیامد به بازار آهنگران"
  },
  {
    "poem_id": 1514,
    "vorder": 93,
    "position": 0,
    "text": "یکی نامور بود بوراب نام"
  },
  {
    "poem_id": 1514,
    "vorder": 94,
    "position": 1,
    "text": "پسندیده آهنگری شادکام"
  },
  {
    "poem_id": 1514,
    "vorder": 95,
    "position": 0,
    "text": "همی ساختی نعل اسپان شاه"
  },
  {
    "poem_id": 1514,
    "vorder": 96,
    "position": 1,
    "text": "بر قیصر او را بدی پایگاه"
  },
  {
    "poem_id": 1514,
    "vorder": 97,
    "position": 0,
    "text": "ورا یار و شاگرد بد سی و پنج"
  },
  {
    "poem_id": 1514,
    "vorder": 98,
    "position": 1,
    "text": "ز پتک و ز آهن رسیده به رنج"
  },
  {
    "poem_id": 1514,
    "vorder": 99,
    "position": 0,
    "text": "به دکانش بنشست گشتاسپ دیر"
  },
  {
    "poem_id": 1514,
    "vorder": 100,
    "position": 1,
    "text": "شد آن پیشه‌کار از نشستنش سیر"
  },
  {
    "poem_id": 1514,
    "vorder": 101,
    "position": 0,
    "text": "بدو گفت آهنگر ای نیکخوی"
  },
  {
    "poem_id": 1514,
    "vorder": 102,
    "position": 1,
    "text": "چه داری به دکان ما آرزوی"
  },
  {
    "poem_id": 1514,
    "vorder": 103,
    "position": 0,
    "text": "چنین داد پاسخ که ای نیک‌بخت"
  },
  {
    "poem_id": 1514,
    "vorder": 104,
    "position": 1,
    "text": "نپیچم سر از پتک وز کار سخت"
  },
  {
    "poem_id": 1514,
    "vorder": 105,
    "position": 0,
    "text": "مرا گر بداری تو یاری کنم"
  },
  {
    "poem_id": 1514,
    "vorder": 106,
    "position": 1,
    "text": "برین پتک و سندان سواری کنم"
  },
  {
    "poem_id": 1514,
    "vorder": 107,
    "position": 0,
    "text": "چو بشنید بوراب زو داستان"
  },
  {
    "poem_id": 1514,
    "vorder": 108,
    "position": 1,
    "text": "به یاری او گشت همداستان"
  },
  {
    "poem_id": 1514,
    "vorder": 109,
    "position": 0,
    "text": "گرانمایه گویی به آتش بتافت"
  },
  {
    "poem_id": 1514,
    "vorder": 110,
    "position": 1,
    "text": "چو شد تافته سوی سندان شتافت"
  },
  {
    "poem_id": 1514,
    "vorder": 111,
    "position": 0,
    "text": "به گشتاسپ دادند پتکی گران"
  },
  {
    "poem_id": 1514,
    "vorder": 112,
    "position": 1,
    "text": "برو انجمن گشته آهنگران"
  },
  {
    "poem_id": 1514,
    "vorder": 113,
    "position": 0,
    "text": "بزد پتک و بشکست سندان و گوی"
  },
  {
    "poem_id": 1514,
    "vorder": 114,
    "position": 1,
    "text": "ازو گشت بازار پر گفت‌وگوی"
  },
  {
    "poem_id": 1514,
    "vorder": 115,
    "position": 0,
    "text": "بترسید بوراب و گفت ای جوان"
  },
  {
    "poem_id": 1514,
    "vorder": 116,
    "position": 1,
    "text": "به زخم تو آهن ندارد توان"
  },
  {
    "poem_id": 1514,
    "vorder": 117,
    "position": 0,
    "text": "نه پتک و نه آتش نه سندان نه دم"
  },
  {
    "poem_id": 1514,
    "vorder": 118,
    "position": 1,
    "text": "چو بشنید گشتاسپ زان شد دژم"
  },
  {
    "poem_id": 1514,
    "vorder": 119,
    "position": 0,
    "text": "بینداخت پتک و بشد گرسنه"
  },
  {
    "poem_id": 1514,
    "vorder": 120,
    "position": 1,
    "text": "نه روی خورش بد نه جای بنه"
  },
  {
    "poem_id": 1514,
    "vorder": 121,
    "position": 0,
    "text": "نماند به کس روز سختی نه رنج"
  },
  {
    "poem_id": 1514,
    "vorder": 122,
    "position": 1,
    "text": "نه آسانی و شادمانی نه گنج"
  },
  {
    "poem_id": 1514,
    "vorder": 123,
    "position": 0,
    "text": "بد و نیک بر ما همی بگذرد"
  },
  {
    "poem_id": 1514,
    "vorder": 124,
    "position": 1,
    "text": "نباشد دژم هرکه دارد خرد"
  }
]