[
  {
    "poem_id": 1810,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد به ایران که شاه"
  },
  {
    "poem_id": 1810,
    "vorder": 2,
    "position": 1,
    "text": "بیامد ز قنوج خود با سپاه"
  },
  {
    "poem_id": 1810,
    "vorder": 3,
    "position": 0,
    "text": "ببستند آذین به راه و به شهر"
  },
  {
    "poem_id": 1810,
    "vorder": 4,
    "position": 1,
    "text": "همی هرکس از کار برداشت بهر"
  },
  {
    "poem_id": 1810,
    "vorder": 5,
    "position": 0,
    "text": "درم ریختند از کران تا کران"
  },
  {
    "poem_id": 1810,
    "vorder": 6,
    "position": 1,
    "text": "هم از مشک و دینار و هم زعفران"
  },
  {
    "poem_id": 1810,
    "vorder": 7,
    "position": 0,
    "text": "چو آگاه شد پور او یزدگرد"
  },
  {
    "poem_id": 1810,
    "vorder": 8,
    "position": 1,
    "text": "سپاه پراگنده را کرد گرد"
  },
  {
    "poem_id": 1810,
    "vorder": 9,
    "position": 0,
    "text": "چو نرسی و چون موبد موبدان"
  },
  {
    "poem_id": 1810,
    "vorder": 10,
    "position": 1,
    "text": "پذیره شدندش همه بخردان"
  },
  {
    "poem_id": 1810,
    "vorder": 11,
    "position": 0,
    "text": "چو بهرام را دید فرزند اوی"
  },
  {
    "poem_id": 1810,
    "vorder": 12,
    "position": 1,
    "text": "بیامد بمالید بر خاک روی"
  },
  {
    "poem_id": 1810,
    "vorder": 13,
    "position": 0,
    "text": "برادرش نرسی و موبد همان"
  },
  {
    "poem_id": 1810,
    "vorder": 14,
    "position": 1,
    "text": "پر از گرد رخسار و دل شادمان"
  },
  {
    "poem_id": 1810,
    "vorder": 15,
    "position": 0,
    "text": "چنان هم بیامد به ایوان خویش"
  },
  {
    "poem_id": 1810,
    "vorder": 16,
    "position": 1,
    "text": "به یزدان سپرده تن و جان خویش"
  },
  {
    "poem_id": 1810,
    "vorder": 17,
    "position": 0,
    "text": "بیاسود چون گشت گیتی سیاه"
  },
  {
    "poem_id": 1810,
    "vorder": 18,
    "position": 1,
    "text": "به کردار سیمین سپر گشت ماه"
  },
  {
    "poem_id": 1810,
    "vorder": 19,
    "position": 0,
    "text": "چو پیراهن شب بدرید روز"
  },
  {
    "poem_id": 1810,
    "vorder": 20,
    "position": 1,
    "text": "پدید آمد آن شمع گیتی فروز"
  },
  {
    "poem_id": 1810,
    "vorder": 21,
    "position": 0,
    "text": "شهنشاه بر تخت زرین نشست"
  },
  {
    "poem_id": 1810,
    "vorder": 22,
    "position": 1,
    "text": "در بار بگشاد و لب را ببست"
  },
  {
    "poem_id": 1810,
    "vorder": 23,
    "position": 0,
    "text": "برفتند هر کس که بد مهتری"
  },
  {
    "poem_id": 1810,
    "vorder": 24,
    "position": 1,
    "text": "خردمند و در پادشاهی سری"
  },
  {
    "poem_id": 1810,
    "vorder": 25,
    "position": 0,
    "text": "جهاندار بر تخت بر پای خاست"
  },
  {
    "poem_id": 1810,
    "vorder": 26,
    "position": 1,
    "text": "بیاراست پاکیزه گفتار راست"
  },
  {
    "poem_id": 1810,
    "vorder": 27,
    "position": 0,
    "text": "نخست از جهان‌آفرین یاد کرد"
  },
  {
    "poem_id": 1810,
    "vorder": 28,
    "position": 1,
    "text": "ز وام خرد گردن آزاد کرد"
  },
  {
    "poem_id": 1810,
    "vorder": 29,
    "position": 0,
    "text": "چنین گفت کز کردگار جهان"
  },
  {
    "poem_id": 1810,
    "vorder": 30,
    "position": 1,
    "text": "شناسندهٔ آشکار و نهان"
  },
  {
    "poem_id": 1810,
    "vorder": 31,
    "position": 0,
    "text": "بترسید و او را ستایش کنید"
  },
  {
    "poem_id": 1810,
    "vorder": 32,
    "position": 1,
    "text": "شب تیره پیشش نیایش کنید"
  },
  {
    "poem_id": 1810,
    "vorder": 33,
    "position": 0,
    "text": "که او داد پیروزی و دستگاه"
  },
  {
    "poem_id": 1810,
    "vorder": 34,
    "position": 1,
    "text": "خداوند تابنده خورشید و ماه"
  },
  {
    "poem_id": 1810,
    "vorder": 35,
    "position": 0,
    "text": "هرانکس که خواهد که یابد بهشت"
  },
  {
    "poem_id": 1810,
    "vorder": 36,
    "position": 1,
    "text": "نگردد به گرد بد و کار زشت"
  },
  {
    "poem_id": 1810,
    "vorder": 37,
    "position": 0,
    "text": "چو داد و دهش باشد و راستی"
  },
  {
    "poem_id": 1810,
    "vorder": 38,
    "position": 1,
    "text": "بپیچد دل از کژی و کاستی"
  },
  {
    "poem_id": 1810,
    "vorder": 39,
    "position": 0,
    "text": "ز ما کس مباشید زین پس به بیم"
  },
  {
    "poem_id": 1810,
    "vorder": 40,
    "position": 1,
    "text": "اگر کوه زر دارد و گنج سیم"
  },
  {
    "poem_id": 1810,
    "vorder": 41,
    "position": 0,
    "text": "ز دلها همه بیم بیرون کنید"
  },
  {
    "poem_id": 1810,
    "vorder": 42,
    "position": 1,
    "text": "نیایش به دارای بیچون کنید"
  },
  {
    "poem_id": 1810,
    "vorder": 43,
    "position": 0,
    "text": "کشاورز گر مرد دهقان‌نژاد"
  },
  {
    "poem_id": 1810,
    "vorder": 44,
    "position": 1,
    "text": "بکوشید با ما به هنگام داد"
  },
  {
    "poem_id": 1810,
    "vorder": 45,
    "position": 0,
    "text": "هران را که ما تاج دادیم و تخت"
  },
  {
    "poem_id": 1810,
    "vorder": 46,
    "position": 1,
    "text": "ز یزدان شناسید وز داد و بخت"
  },
  {
    "poem_id": 1810,
    "vorder": 47,
    "position": 0,
    "text": "نکوشم به آگندن گنج من"
  },
  {
    "poem_id": 1810,
    "vorder": 48,
    "position": 1,
    "text": "نخواهم پراگنده کرد انجمن"
  },
  {
    "poem_id": 1810,
    "vorder": 49,
    "position": 0,
    "text": "یکی گنج خواهم نهادن ز داد"
  },
  {
    "poem_id": 1810,
    "vorder": 50,
    "position": 1,
    "text": "که باشد روانم پس از مرگ شاد"
  },
  {
    "poem_id": 1810,
    "vorder": 51,
    "position": 0,
    "text": "برین نیز گر خواست یزدان بود"
  },
  {
    "poem_id": 1810,
    "vorder": 52,
    "position": 1,
    "text": "دل روشن از بخت خندان بود"
  },
  {
    "poem_id": 1810,
    "vorder": 53,
    "position": 0,
    "text": "برین نیکویها فزایش کنیم"
  },
  {
    "poem_id": 1810,
    "vorder": 54,
    "position": 1,
    "text": "سوی نیک‌بختی نمایش کنیم"
  },
  {
    "poem_id": 1810,
    "vorder": 55,
    "position": 0,
    "text": "گر از لشکر و کارداران من"
  },
  {
    "poem_id": 1810,
    "vorder": 56,
    "position": 1,
    "text": "ز خویشان و جنگی سواران من"
  },
  {
    "poem_id": 1810,
    "vorder": 57,
    "position": 0,
    "text": "کسی رنج بگزید و با من نگفت"
  },
  {
    "poem_id": 1810,
    "vorder": 58,
    "position": 1,
    "text": "همی دارد آن کژی اندر نهفت"
  },
  {
    "poem_id": 1810,
    "vorder": 59,
    "position": 0,
    "text": "ورا از تن خویش باشد بزه"
  },
  {
    "poem_id": 1810,
    "vorder": 60,
    "position": 1,
    "text": "بزه کی گزیند کسی بی‌مزه(؟)"
  },
  {
    "poem_id": 1810,
    "vorder": 61,
    "position": 0,
    "text": "منم پیش یزدان ازو دادخواه"
  },
  {
    "poem_id": 1810,
    "vorder": 62,
    "position": 1,
    "text": "که در چادر ابر بنهفت ماه"
  },
  {
    "poem_id": 1810,
    "vorder": 63,
    "position": 0,
    "text": "شما را مگر دیگرست آرزوی"
  },
  {
    "poem_id": 1810,
    "vorder": 64,
    "position": 1,
    "text": "که هرکس دگرگونه باشد به خوی"
  },
  {
    "poem_id": 1810,
    "vorder": 65,
    "position": 0,
    "text": "بگویید گستاخ با من سخن"
  },
  {
    "poem_id": 1810,
    "vorder": 66,
    "position": 1,
    "text": "مگر نو کنم آرزوی کهن"
  },
  {
    "poem_id": 1810,
    "vorder": 67,
    "position": 0,
    "text": "همه گوش دارید و فرمان کنید"
  },
  {
    "poem_id": 1810,
    "vorder": 68,
    "position": 1,
    "text": "ازین پند آرایش جان کنید"
  },
  {
    "poem_id": 1810,
    "vorder": 69,
    "position": 0,
    "text": "بگفت این و بنشست بر تخت داد"
  },
  {
    "poem_id": 1810,
    "vorder": 70,
    "position": 1,
    "text": "کلاه کیانی به سر بر نهاد"
  },
  {
    "poem_id": 1810,
    "vorder": 71,
    "position": 0,
    "text": "بزرگان برو خواندند آفرین"
  },
  {
    "poem_id": 1810,
    "vorder": 72,
    "position": 1,
    "text": "که بی‌تو مبادا کلاه و نگین"
  },
  {
    "poem_id": 1810,
    "vorder": 73,
    "position": 0,
    "text": "چو دانا بود شاه پیروز بخت"
  },
  {
    "poem_id": 1810,
    "vorder": 74,
    "position": 1,
    "text": "بنازد بدو کشور و تاج و تخت"
  },
  {
    "poem_id": 1810,
    "vorder": 75,
    "position": 0,
    "text": "ترا مردی و دانش و فرهی"
  },
  {
    "poem_id": 1810,
    "vorder": 76,
    "position": 1,
    "text": "فزون آمد از تخت شاهنشهی"
  },
  {
    "poem_id": 1810,
    "vorder": 77,
    "position": 0,
    "text": "بزرگی و هم دانش و هم نژاد"
  },
  {
    "poem_id": 1810,
    "vorder": 78,
    "position": 1,
    "text": "چو تو شاه گیتی ندارد به یاد"
  },
  {
    "poem_id": 1810,
    "vorder": 79,
    "position": 0,
    "text": "کنون آفرین بر تو شد ناگزیر"
  },
  {
    "poem_id": 1810,
    "vorder": 80,
    "position": 1,
    "text": "ز ما هر که هستیم برنا و پیر"
  },
  {
    "poem_id": 1810,
    "vorder": 81,
    "position": 0,
    "text": "هم آزادی تو به یزدان کنیم"
  },
  {
    "poem_id": 1810,
    "vorder": 82,
    "position": 1,
    "text": "دگر پیش آزادمردان کنیم"
  },
  {
    "poem_id": 1810,
    "vorder": 83,
    "position": 0,
    "text": "برین تخت ارزانیانست شاه"
  },
  {
    "poem_id": 1810,
    "vorder": 84,
    "position": 1,
    "text": "به داد و به پیروزی و دستگاه"
  },
  {
    "poem_id": 1810,
    "vorder": 85,
    "position": 0,
    "text": "همه مردگان را برآری ز خاک"
  },
  {
    "poem_id": 1810,
    "vorder": 86,
    "position": 1,
    "text": "به داد و به بخشش به گفتار پاک"
  },
  {
    "poem_id": 1810,
    "vorder": 87,
    "position": 0,
    "text": "خداوند دارنده یار تو باد"
  },
  {
    "poem_id": 1810,
    "vorder": 88,
    "position": 1,
    "text": "سر اختر اندر کنار تو باد"
  },
  {
    "poem_id": 1810,
    "vorder": 89,
    "position": 0,
    "text": "برفتند با رامش از پیش تخت"
  },
  {
    "poem_id": 1810,
    "vorder": 90,
    "position": 1,
    "text": "بزرگان و فرزانهٔ نیک‌بخت"
  },
  {
    "poem_id": 1810,
    "vorder": 91,
    "position": 0,
    "text": "نشست آن زمان شاه و لشکر بر اسپ"
  },
  {
    "poem_id": 1810,
    "vorder": 92,
    "position": 1,
    "text": "بیامد سوی خان آذر گشسپ"
  },
  {
    "poem_id": 1810,
    "vorder": 93,
    "position": 0,
    "text": "بسی زر و گوهر به درویش داد"
  },
  {
    "poem_id": 1810,
    "vorder": 94,
    "position": 1,
    "text": "نیاز آنک بنهفت ازو بیش داد"
  },
  {
    "poem_id": 1810,
    "vorder": 95,
    "position": 0,
    "text": "پرستندهٔ آتش زردهشت"
  },
  {
    "poem_id": 1810,
    "vorder": 96,
    "position": 1,
    "text": "همی رفت با باژ و برسم به مشت"
  },
  {
    "poem_id": 1810,
    "vorder": 97,
    "position": 0,
    "text": "سپینود را پیش او برد شاه"
  },
  {
    "poem_id": 1810,
    "vorder": 98,
    "position": 1,
    "text": "بیاموختش دین و آیین و راه"
  },
  {
    "poem_id": 1810,
    "vorder": 99,
    "position": 0,
    "text": "بشستش به دین به و آب پاک"
  },
  {
    "poem_id": 1810,
    "vorder": 100,
    "position": 1,
    "text": "ازو دور شد گرد و زنگار و خاک"
  },
  {
    "poem_id": 1810,
    "vorder": 101,
    "position": 0,
    "text": "در تنگ زندانها باز کرد"
  },
  {
    "poem_id": 1810,
    "vorder": 102,
    "position": 1,
    "text": "به هرسو درم دادن آغاز کرد"
  }
]