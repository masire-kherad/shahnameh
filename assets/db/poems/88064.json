[
  {
    "poem_id": 88064,
    "vorder": 1,
    "position": 0,
    "text": "بدو گفت شاه ای سرفراز مرد"
  },
  {
    "poem_id": 88064,
    "vorder": 2,
    "position": 1,
    "text": "نه گرم آزموده ز گیتی نه سرد"
  },
  {
    "poem_id": 88064,
    "vorder": 3,
    "position": 0,
    "text": "از ایدر برو تا میان سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 4,
    "position": 1,
    "text": "از ایشان یکی مرد دانا بخواه"
  },
  {
    "poem_id": 88064,
    "vorder": 5,
    "position": 0,
    "text": "به کیخسرو از من پیامی رسان"
  },
  {
    "poem_id": 88064,
    "vorder": 6,
    "position": 1,
    "text": "که گیتی جز این دارد آیین و سان"
  },
  {
    "poem_id": 88064,
    "vorder": 7,
    "position": 0,
    "text": "نبیره که رزم آورد با نیا"
  },
  {
    "poem_id": 88064,
    "vorder": 8,
    "position": 1,
    "text": "دلش بر بدی باشد و کیمیا"
  },
  {
    "poem_id": 88064,
    "vorder": 9,
    "position": 0,
    "text": "چنین بود رای جهان آفرین"
  },
  {
    "poem_id": 88064,
    "vorder": 10,
    "position": 1,
    "text": "که گردد جهان پر ز پرخاش و کین"
  },
  {
    "poem_id": 88064,
    "vorder": 11,
    "position": 0,
    "text": "سیاوش نه بر بیگنه کشته شد"
  },
  {
    "poem_id": 88064,
    "vorder": 12,
    "position": 1,
    "text": "شد از آموزگاران سرش گشته شد"
  },
  {
    "poem_id": 88064,
    "vorder": 13,
    "position": 0,
    "text": "گنه گر مرا بود پیران چه کرد"
  },
  {
    "poem_id": 88064,
    "vorder": 14,
    "position": 1,
    "text": "چو رویین و لهاک و فرشیدورد"
  },
  {
    "poem_id": 88064,
    "vorder": 15,
    "position": 0,
    "text": "که بر پشت زینشان ببایست بست"
  },
  {
    "poem_id": 88064,
    "vorder": 16,
    "position": 1,
    "text": "پر از خون به کردار پیلان مست"
  },
  {
    "poem_id": 88064,
    "vorder": 17,
    "position": 0,
    "text": "گر ایدونک گویم که تو بدتنی"
  },
  {
    "poem_id": 88064,
    "vorder": 18,
    "position": 1,
    "text": "بد اندیش وز تخم آهرمنی"
  },
  {
    "poem_id": 88064,
    "vorder": 19,
    "position": 0,
    "text": "به گوهر نگه کن به تخمه منم"
  },
  {
    "poem_id": 88064,
    "vorder": 20,
    "position": 1,
    "text": "نکوهش همی خویشتن را کنم"
  },
  {
    "poem_id": 88064,
    "vorder": 21,
    "position": 0,
    "text": "تو این کین به گودرز و کاووس مان"
  },
  {
    "poem_id": 88064,
    "vorder": 22,
    "position": 1,
    "text": "که پیش من آرند لشکر دمان"
  },
  {
    "poem_id": 88064,
    "vorder": 23,
    "position": 0,
    "text": "نه زان گفتم این کز تو ترسان شدم"
  },
  {
    "poem_id": 88064,
    "vorder": 24,
    "position": 1,
    "text": "وگر پیر گشتم دگر سان شدم"
  },
  {
    "poem_id": 88064,
    "vorder": 25,
    "position": 0,
    "text": "همه ریگ و دریا مرا لشکرند"
  },
  {
    "poem_id": 88064,
    "vorder": 26,
    "position": 1,
    "text": "همه نره شیرند و کنداورند"
  },
  {
    "poem_id": 88064,
    "vorder": 27,
    "position": 0,
    "text": "هر آنگه که فرمان دهم کوه گنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 28,
    "position": 1,
    "text": "چو دریا کنند ای پسر روز جنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 29,
    "position": 0,
    "text": "ولیکن همی ترسم از کردگار"
  },
  {
    "poem_id": 88064,
    "vorder": 30,
    "position": 1,
    "text": "ز خون ریختن وز بد روزگار"
  },
  {
    "poem_id": 88064,
    "vorder": 31,
    "position": 0,
    "text": "که چندین سر نامور بی‌گناه"
  },
  {
    "poem_id": 88064,
    "vorder": 32,
    "position": 1,
    "text": "جدا گردد از تن بدین رزمگاه"
  },
  {
    "poem_id": 88064,
    "vorder": 33,
    "position": 0,
    "text": "گر از پیش من بر نگردی ز جنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 34,
    "position": 1,
    "text": "نگردی همانا که آیدت ننگ"
  },
  {
    "poem_id": 88064,
    "vorder": 35,
    "position": 0,
    "text": "چو با من به سوگند پیمان کنی"
  },
  {
    "poem_id": 88064,
    "vorder": 36,
    "position": 1,
    "text": "بکوشی که پیمان من نشکنی"
  },
  {
    "poem_id": 88064,
    "vorder": 37,
    "position": 0,
    "text": "بدین کار باشم ترا رهنمای"
  },
  {
    "poem_id": 88064,
    "vorder": 38,
    "position": 1,
    "text": "که گنج و سپاهت بماند به جای"
  },
  {
    "poem_id": 88064,
    "vorder": 39,
    "position": 0,
    "text": "چو کار سیاوش فرامش کنی"
  },
  {
    "poem_id": 88064,
    "vorder": 40,
    "position": 1,
    "text": "نیارا به توران به رامش کنی"
  },
  {
    "poem_id": 88064,
    "vorder": 41,
    "position": 0,
    "text": "برادر بود جهن و جنگی پشنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 42,
    "position": 1,
    "text": "که در جنگ دریا کند کوه سنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 43,
    "position": 0,
    "text": "هر آن بوم و بر کآن ز ایران نهی"
  },
  {
    "poem_id": 88064,
    "vorder": 44,
    "position": 1,
    "text": "به فرمان کنم آن ز ترکان تهی"
  },
  {
    "poem_id": 88064,
    "vorder": 45,
    "position": 0,
    "text": "ز گنج نیاکان ما هرچه هست"
  },
  {
    "poem_id": 88064,
    "vorder": 46,
    "position": 1,
    "text": "ز دینار وز تاج و تخت و نشست"
  },
  {
    "poem_id": 88064,
    "vorder": 47,
    "position": 0,
    "text": "ز اسب و سلیح و ز بیش و ز کم"
  },
  {
    "poem_id": 88064,
    "vorder": 48,
    "position": 1,
    "text": "که میراث ماند از نیا زادشم"
  },
  {
    "poem_id": 88064,
    "vorder": 49,
    "position": 0,
    "text": "ز گنج بزرگان و تخت و کلاه"
  },
  {
    "poem_id": 88064,
    "vorder": 50,
    "position": 1,
    "text": "ز چیزی که باید ز بهر سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 51,
    "position": 0,
    "text": "فرستم همه همچنین پیش تو"
  },
  {
    "poem_id": 88064,
    "vorder": 52,
    "position": 1,
    "text": "پسر پهلوان و پدر خویش تو"
  },
  {
    "poem_id": 88064,
    "vorder": 53,
    "position": 0,
    "text": "دو لشکر برآساید از رنج رزم"
  },
  {
    "poem_id": 88064,
    "vorder": 54,
    "position": 1,
    "text": "همه روز ما بازگردد به بزم"
  },
  {
    "poem_id": 88064,
    "vorder": 55,
    "position": 0,
    "text": "ور ایدون که جان ترا اهرمن"
  },
  {
    "poem_id": 88064,
    "vorder": 56,
    "position": 1,
    "text": "بپیچد همی تا بپوشی کفن"
  },
  {
    "poem_id": 88064,
    "vorder": 57,
    "position": 0,
    "text": "جز از رزم و خون کردنت رای نیست"
  },
  {
    "poem_id": 88064,
    "vorder": 58,
    "position": 1,
    "text": "به مغز تو پند مرا جای نیست"
  },
  {
    "poem_id": 88064,
    "vorder": 59,
    "position": 0,
    "text": "تو از لشکر خویش بیرون خرام"
  },
  {
    "poem_id": 88064,
    "vorder": 60,
    "position": 1,
    "text": "مگر خود برآیدت از این کار کام"
  },
  {
    "poem_id": 88064,
    "vorder": 61,
    "position": 0,
    "text": "بگردیم هر دو به آوردگاه"
  },
  {
    "poem_id": 88064,
    "vorder": 62,
    "position": 1,
    "text": "بر آساید از جنگ چندین سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 63,
    "position": 0,
    "text": "چو من کشته آیم جهان پیش تست"
  },
  {
    "poem_id": 88064,
    "vorder": 64,
    "position": 1,
    "text": "سپه بندگان و پسر خویش تست"
  },
  {
    "poem_id": 88064,
    "vorder": 65,
    "position": 0,
    "text": "و گر تو شوی کشته بر دست من"
  },
  {
    "poem_id": 88064,
    "vorder": 66,
    "position": 1,
    "text": "کسی را نیازارم از انجمن"
  },
  {
    "poem_id": 88064,
    "vorder": 67,
    "position": 0,
    "text": "سپاه تو در زینهار منند"
  },
  {
    "poem_id": 88064,
    "vorder": 68,
    "position": 1,
    "text": "همه مهترانند و یار منند"
  },
  {
    "poem_id": 88064,
    "vorder": 69,
    "position": 0,
    "text": "وگر زان که با من نیایی به جنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 70,
    "position": 1,
    "text": "نتابی تو با کار دیده نهنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 71,
    "position": 0,
    "text": "کمر بسته پیش تو آید پشنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 72,
    "position": 1,
    "text": "چو جنگ آوری او نسازد درنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 73,
    "position": 0,
    "text": "پدر پیر شد پایمردش جوان"
  },
  {
    "poem_id": 88064,
    "vorder": 74,
    "position": 1,
    "text": "جوانی خردمند و روشن‌روان"
  },
  {
    "poem_id": 88064,
    "vorder": 75,
    "position": 0,
    "text": "به آوردگه با تو جنگ آورد"
  },
  {
    "poem_id": 88064,
    "vorder": 76,
    "position": 1,
    "text": "دلیرست و جنگ پلنگ آورد"
  },
  {
    "poem_id": 88064,
    "vorder": 77,
    "position": 0,
    "text": "ببینیم تا بر که گردد سپهر"
  },
  {
    "poem_id": 88064,
    "vorder": 78,
    "position": 1,
    "text": "که را بر نهد بر سر از تاج مهر"
  },
  {
    "poem_id": 88064,
    "vorder": 79,
    "position": 0,
    "text": "ور ایدون که با او نجویی نبرد"
  },
  {
    "poem_id": 88064,
    "vorder": 80,
    "position": 1,
    "text": "دگرگونه خواهی همی کار کرد"
  },
  {
    "poem_id": 88064,
    "vorder": 81,
    "position": 0,
    "text": "بمان تا بیاساید امشب سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 82,
    "position": 1,
    "text": "چو بر سر نهد کوه زرین کلاه"
  },
  {
    "poem_id": 88064,
    "vorder": 83,
    "position": 0,
    "text": "ز لشکر گزینیم جنگاوران"
  },
  {
    "poem_id": 88064,
    "vorder": 84,
    "position": 1,
    "text": "سرافراز با گرزهای گران"
  },
  {
    "poem_id": 88064,
    "vorder": 85,
    "position": 0,
    "text": "زمین را ز خون رود دریا کنیم"
  },
  {
    "poem_id": 88064,
    "vorder": 86,
    "position": 1,
    "text": "ز بالای بدخواه پهنا کنیم"
  },
  {
    "poem_id": 88064,
    "vorder": 87,
    "position": 0,
    "text": "دوم روز هنگام بانگ خروس"
  },
  {
    "poem_id": 88064,
    "vorder": 88,
    "position": 1,
    "text": "ببندیم بر کوههٔ پیل کوس"
  },
  {
    "poem_id": 88064,
    "vorder": 89,
    "position": 0,
    "text": "سران را به یاری برون آوریم"
  },
  {
    "poem_id": 88064,
    "vorder": 90,
    "position": 1,
    "text": "به جوی اندرون آب و خون آوریم"
  },
  {
    "poem_id": 88064,
    "vorder": 91,
    "position": 0,
    "text": "چو بدخواه پیغام تو نشنود"
  },
  {
    "poem_id": 88064,
    "vorder": 92,
    "position": 1,
    "text": "بپیچد بدین گفتها نگرود"
  },
  {
    "poem_id": 88064,
    "vorder": 93,
    "position": 0,
    "text": "به تنها تن خویش از او رزم خواه"
  },
  {
    "poem_id": 88064,
    "vorder": 94,
    "position": 1,
    "text": "به دیدار دوراز میان سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 95,
    "position": 0,
    "text": "پسر آفرین کرد و آمد برون"
  },
  {
    "poem_id": 88064,
    "vorder": 96,
    "position": 1,
    "text": "پدر دیده پر آب و دل پر ز خون"
  },
  {
    "poem_id": 88064,
    "vorder": 97,
    "position": 0,
    "text": "گزین کرد از موبدان چار مرد"
  },
  {
    "poem_id": 88064,
    "vorder": 98,
    "position": 1,
    "text": "چشیده بسی از جهان گرم و سرد"
  },
  {
    "poem_id": 88064,
    "vorder": 99,
    "position": 0,
    "text": "وز آن نامداران لشکر هزار"
  },
  {
    "poem_id": 88064,
    "vorder": 100,
    "position": 1,
    "text": "خردمند و شایستهٔ کارزار"
  },
  {
    "poem_id": 88064,
    "vorder": 101,
    "position": 0,
    "text": "به ره چون طلایه بدیدش ز دور"
  },
  {
    "poem_id": 88064,
    "vorder": 102,
    "position": 1,
    "text": "درفش و سنان سواران تور"
  },
  {
    "poem_id": 88064,
    "vorder": 103,
    "position": 0,
    "text": "ز ترکان هر آن کس که بد پیشرو"
  },
  {
    "poem_id": 88064,
    "vorder": 104,
    "position": 1,
    "text": "ز ناکاردیده جوانان نو"
  },
  {
    "poem_id": 88064,
    "vorder": 105,
    "position": 0,
    "text": "به ره با طلایه بر آویختند"
  },
  {
    "poem_id": 88064,
    "vorder": 106,
    "position": 1,
    "text": "به نام از پی شیده خون ریختند"
  },
  {
    "poem_id": 88064,
    "vorder": 107,
    "position": 0,
    "text": "تنی چند از ایرانیان خسته شد"
  },
  {
    "poem_id": 88064,
    "vorder": 108,
    "position": 1,
    "text": "وز آن روی پیکار پیوسته شد"
  },
  {
    "poem_id": 88064,
    "vorder": 109,
    "position": 0,
    "text": "هم اندر زمان شیده آنجا رسید"
  },
  {
    "poem_id": 88064,
    "vorder": 110,
    "position": 1,
    "text": "نگهبان ایرانیان را بدید"
  },
  {
    "poem_id": 88064,
    "vorder": 111,
    "position": 0,
    "text": "دل شیده گشت اندر آن کار تنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 112,
    "position": 1,
    "text": "همی باز خواند آن یلان را ز جنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 113,
    "position": 0,
    "text": "به ایرانیان گفت نزدیک شاه"
  },
  {
    "poem_id": 88064,
    "vorder": 114,
    "position": 1,
    "text": "سواری فرستید با رسم و راه"
  },
  {
    "poem_id": 88064,
    "vorder": 115,
    "position": 0,
    "text": "بگوید که روشن دلی شیده نام"
  },
  {
    "poem_id": 88064,
    "vorder": 116,
    "position": 1,
    "text": "به شاه آوریدست چندی پیام"
  },
  {
    "poem_id": 88064,
    "vorder": 117,
    "position": 0,
    "text": "از افراسیاب آن سپهدار چین"
  },
  {
    "poem_id": 88064,
    "vorder": 118,
    "position": 1,
    "text": "پدر مادر شاه ایران زمین"
  },
  {
    "poem_id": 88064,
    "vorder": 119,
    "position": 0,
    "text": "سواری دمان از طلایه برفت"
  },
  {
    "poem_id": 88064,
    "vorder": 120,
    "position": 1,
    "text": "بر شاه ایران خرامید تفت"
  },
  {
    "poem_id": 88064,
    "vorder": 121,
    "position": 0,
    "text": "که پیغمبر شاه توران سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 122,
    "position": 1,
    "text": "گوی بر منش با درفشی سیاه"
  },
  {
    "poem_id": 88064,
    "vorder": 123,
    "position": 0,
    "text": "همی شیده گوید که هستم به نام"
  },
  {
    "poem_id": 88064,
    "vorder": 124,
    "position": 1,
    "text": "کسی بایدم تا گزارم پیام"
  },
  {
    "poem_id": 88064,
    "vorder": 125,
    "position": 0,
    "text": "دل شاه شد زان سخن پر ز شرم"
  },
  {
    "poem_id": 88064,
    "vorder": 126,
    "position": 1,
    "text": "فرو ریخت از دیدگان آب گرم"
  },
  {
    "poem_id": 88064,
    "vorder": 127,
    "position": 0,
    "text": "چنین گفت کین شیده خال منست"
  },
  {
    "poem_id": 88064,
    "vorder": 128,
    "position": 1,
    "text": "به بالا و مردی همال منست"
  },
  {
    "poem_id": 88064,
    "vorder": 129,
    "position": 0,
    "text": "نگه کرد گردنکشی زان میان"
  },
  {
    "poem_id": 88064,
    "vorder": 130,
    "position": 1,
    "text": "نبد پیش جز قارن کاویان"
  },
  {
    "poem_id": 88064,
    "vorder": 131,
    "position": 0,
    "text": "بدو گفت رو پیش او شادکام"
  },
  {
    "poem_id": 88064,
    "vorder": 132,
    "position": 1,
    "text": "درودش ده از ما و بشنو پیام"
  },
  {
    "poem_id": 88064,
    "vorder": 133,
    "position": 0,
    "text": "چو قارن بیامد ز پیش سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 134,
    "position": 1,
    "text": "بدید آن درفشان درفش سیاه"
  },
  {
    "poem_id": 88064,
    "vorder": 135,
    "position": 0,
    "text": "چو آمد بر شیده دادش درود"
  },
  {
    "poem_id": 88064,
    "vorder": 136,
    "position": 1,
    "text": "ز شاه و ز ایرانیان برفزود"
  },
  {
    "poem_id": 88064,
    "vorder": 137,
    "position": 0,
    "text": "جوان نیز بگشاد شیرین زبان"
  },
  {
    "poem_id": 88064,
    "vorder": 138,
    "position": 1,
    "text": "که بیدار دل بود و روشن روان"
  },
  {
    "poem_id": 88064,
    "vorder": 139,
    "position": 0,
    "text": "بگفت آنچه بشنید ز افراسیاب"
  },
  {
    "poem_id": 88064,
    "vorder": 140,
    "position": 1,
    "text": "ز آرام وز بزم و رزم و شتاب"
  },
  {
    "poem_id": 88064,
    "vorder": 141,
    "position": 0,
    "text": "چو بشنید قارن سخنهای نغز"
  },
  {
    "poem_id": 88064,
    "vorder": 142,
    "position": 1,
    "text": "از آن نامور بخرد پاک مغز"
  },
  {
    "poem_id": 88064,
    "vorder": 143,
    "position": 0,
    "text": "بیامد بر شاه ایران بگفت"
  },
  {
    "poem_id": 88064,
    "vorder": 144,
    "position": 1,
    "text": "که پیغامها با خرد بود جفت"
  },
  {
    "poem_id": 88064,
    "vorder": 145,
    "position": 0,
    "text": "چو بشنید خسرو ز قارن سخن"
  },
  {
    "poem_id": 88064,
    "vorder": 146,
    "position": 1,
    "text": "به یاد آمدش گفتهای کهن"
  },
  {
    "poem_id": 88064,
    "vorder": 147,
    "position": 0,
    "text": "بخندید خسرو ز کار نیا"
  },
  {
    "poem_id": 88064,
    "vorder": 148,
    "position": 1,
    "text": "از آن جستن چاره و کیمیا"
  },
  {
    "poem_id": 88064,
    "vorder": 149,
    "position": 0,
    "text": "از آن پس چنین گفت کافراسیاب"
  },
  {
    "poem_id": 88064,
    "vorder": 150,
    "position": 1,
    "text": "پشیمان شدست از گذشتن ز آب"
  },
  {
    "poem_id": 88064,
    "vorder": 151,
    "position": 0,
    "text": "ورا چشم بی آب و لب پر سخن"
  },
  {
    "poem_id": 88064,
    "vorder": 152,
    "position": 1,
    "text": "مرا دل پر از دردهای کهن"
  },
  {
    "poem_id": 88064,
    "vorder": 153,
    "position": 0,
    "text": "بکوشد که تا دل بپیچاندم"
  },
  {
    "poem_id": 88064,
    "vorder": 154,
    "position": 1,
    "text": "به بیشی لشکر بترساندم"
  },
  {
    "poem_id": 88064,
    "vorder": 155,
    "position": 0,
    "text": "بدان گه که گردنده چرخ بلند"
  },
  {
    "poem_id": 88064,
    "vorder": 156,
    "position": 1,
    "text": "نگردد ببایست روز گزند"
  },
  {
    "poem_id": 88064,
    "vorder": 157,
    "position": 0,
    "text": "کنون چارهٔ ما جز این نیست روی"
  },
  {
    "poem_id": 88064,
    "vorder": 158,
    "position": 1,
    "text": "که من دل پر از کین شوم پیش اوی"
  },
  {
    "poem_id": 88064,
    "vorder": 159,
    "position": 0,
    "text": "بگردم به آورد با او به جنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 160,
    "position": 1,
    "text": "به هنگام کوشش نسازم درنگ"
  },
  {
    "poem_id": 88064,
    "vorder": 161,
    "position": 0,
    "text": "همه بخردان و ردان سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 162,
    "position": 1,
    "text": "به آواز گفتند کاین نیست راه"
  },
  {
    "poem_id": 88064,
    "vorder": 163,
    "position": 0,
    "text": "جهاندیده پردانش افراسیاب"
  },
  {
    "poem_id": 88064,
    "vorder": 164,
    "position": 1,
    "text": "جز از چاره جستن نبیند به خواب"
  },
  {
    "poem_id": 88064,
    "vorder": 165,
    "position": 0,
    "text": "نداند جز از تنبل و جادویی"
  },
  {
    "poem_id": 88064,
    "vorder": 166,
    "position": 1,
    "text": "فریب و بداندیشی و بدخویی"
  },
  {
    "poem_id": 88064,
    "vorder": 167,
    "position": 0,
    "text": "ز لشکر کنون شیده را برگزید"
  },
  {
    "poem_id": 88064,
    "vorder": 168,
    "position": 1,
    "text": "که این دید بند بدی را کلید"
  },
  {
    "poem_id": 88064,
    "vorder": 169,
    "position": 0,
    "text": "همی خواهد از شاه ایران نبرد"
  },
  {
    "poem_id": 88064,
    "vorder": 170,
    "position": 1,
    "text": "بدان تا کند روز ما را به درد"
  },
  {
    "poem_id": 88064,
    "vorder": 171,
    "position": 0,
    "text": "تو بر تیزی او دلیری مکن"
  },
  {
    "poem_id": 88064,
    "vorder": 172,
    "position": 1,
    "text": "از ایران وز تاج سیری مکن"
  },
  {
    "poem_id": 88064,
    "vorder": 173,
    "position": 0,
    "text": "وگر شیده از شاه جوید نبرد"
  },
  {
    "poem_id": 88064,
    "vorder": 174,
    "position": 1,
    "text": "به آورد گستاخ با او مگرد"
  },
  {
    "poem_id": 88064,
    "vorder": 175,
    "position": 0,
    "text": "به  دست تو گر شیده گردد تباه"
  },
  {
    "poem_id": 88064,
    "vorder": 176,
    "position": 1,
    "text": "یکی نامور کم شود زان سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 177,
    "position": 0,
    "text": "وگر دور از ایدر تو گردی هلاک"
  },
  {
    "poem_id": 88064,
    "vorder": 178,
    "position": 1,
    "text": "ز ایران برآید یکی تیره خاک"
  },
  {
    "poem_id": 88064,
    "vorder": 179,
    "position": 0,
    "text": "یکی زنده از ما نماند به جای"
  },
  {
    "poem_id": 88064,
    "vorder": 180,
    "position": 1,
    "text": "نه شهر و بر و بوم ایران به پای"
  },
  {
    "poem_id": 88064,
    "vorder": 181,
    "position": 0,
    "text": "کسی نیست ما را ز تخم کیان"
  },
  {
    "poem_id": 88064,
    "vorder": 182,
    "position": 1,
    "text": "که کین را ببندد کمر بر میان"
  },
  {
    "poem_id": 88064,
    "vorder": 183,
    "position": 0,
    "text": "نیای تو پیری جهاندیده است"
  },
  {
    "poem_id": 88064,
    "vorder": 184,
    "position": 1,
    "text": "به توران و چین در پسندیده است"
  },
  {
    "poem_id": 88064,
    "vorder": 185,
    "position": 0,
    "text": "همی پوزش آرد بدین بد که کرد"
  },
  {
    "poem_id": 88064,
    "vorder": 186,
    "position": 1,
    "text": "ز بیچارگی جست خواهد نبرد"
  },
  {
    "poem_id": 88064,
    "vorder": 187,
    "position": 0,
    "text": "همی گوید اسبان و گنج درم"
  },
  {
    "poem_id": 88064,
    "vorder": 188,
    "position": 1,
    "text": "که بنهاد تور از پی زادشم"
  },
  {
    "poem_id": 88064,
    "vorder": 189,
    "position": 0,
    "text": "همان تخت شاهی و تاج سران"
  },
  {
    "poem_id": 88064,
    "vorder": 190,
    "position": 1,
    "text": "کمرهای زرین و گرز گران"
  },
  {
    "poem_id": 88064,
    "vorder": 191,
    "position": 0,
    "text": "سپارد به گنج تو از گنج خویش"
  },
  {
    "poem_id": 88064,
    "vorder": 192,
    "position": 1,
    "text": "همی باز خرد بدین رنج خویش"
  },
  {
    "poem_id": 88064,
    "vorder": 193,
    "position": 0,
    "text": "هر آن شهر کز مرز ایران نهی"
  },
  {
    "poem_id": 88064,
    "vorder": 194,
    "position": 1,
    "text": "همی کرد خواهد ز ترکان تهی"
  },
  {
    "poem_id": 88064,
    "vorder": 195,
    "position": 0,
    "text": "به ایران خرامیم پیروز و شاد"
  },
  {
    "poem_id": 88064,
    "vorder": 196,
    "position": 1,
    "text": "ز کار گذشته نگیریم یاد"
  },
  {
    "poem_id": 88064,
    "vorder": 197,
    "position": 0,
    "text": "بر این گفته بودند پیر و جوان"
  },
  {
    "poem_id": 88064,
    "vorder": 198,
    "position": 1,
    "text": "جز از نامور رستم پهلوان"
  },
  {
    "poem_id": 88064,
    "vorder": 199,
    "position": 0,
    "text": "که رستم همی ز آشتی سر بگاشت"
  },
  {
    "poem_id": 88064,
    "vorder": 200,
    "position": 1,
    "text": "ز درد سیاوش به دل کینه داشت"
  },
  {
    "poem_id": 88064,
    "vorder": 201,
    "position": 0,
    "text": "همی لب به دندان بخایید شاه"
  },
  {
    "poem_id": 88064,
    "vorder": 202,
    "position": 1,
    "text": "همی کرد خیره بدیشان نگاه"
  },
  {
    "poem_id": 88064,
    "vorder": 203,
    "position": 0,
    "text": "وز آن پس چنین گفت کاین نیست راه"
  },
  {
    "poem_id": 88064,
    "vorder": 204,
    "position": 1,
    "text": "به ایران خرامیم ز این رزمگاه"
  },
  {
    "poem_id": 88064,
    "vorder": 205,
    "position": 0,
    "text": "کجا آن همه رسم و سوگند ما"
  },
  {
    "poem_id": 88064,
    "vorder": 206,
    "position": 1,
    "text": "همان بدره و گفته و پند ما"
  },
  {
    "poem_id": 88064,
    "vorder": 207,
    "position": 0,
    "text": "جو بر تخت بر زنده افراسیاب"
  },
  {
    "poem_id": 88064,
    "vorder": 208,
    "position": 1,
    "text": "بماند جهان گردد از وی خراب"
  },
  {
    "poem_id": 88064,
    "vorder": 209,
    "position": 0,
    "text": "به کاووس یکسر چه پوزش بریم"
  },
  {
    "poem_id": 88064,
    "vorder": 210,
    "position": 1,
    "text": "بدین دیدگان چون بدو بنگریم"
  },
  {
    "poem_id": 88064,
    "vorder": 211,
    "position": 0,
    "text": "شنیدی که بر ایرج نیکبخت"
  },
  {
    "poem_id": 88064,
    "vorder": 212,
    "position": 1,
    "text": "چه آمد به تور از پی تاج و تخت"
  },
  {
    "poem_id": 88064,
    "vorder": 213,
    "position": 0,
    "text": "سیاووش را نیز بر بیگناه"
  },
  {
    "poem_id": 88064,
    "vorder": 214,
    "position": 1,
    "text": "بکشت از پی گنج و تخت و کلاه"
  },
  {
    "poem_id": 88064,
    "vorder": 215,
    "position": 0,
    "text": "فریبنده ترکی از آن انجمن"
  },
  {
    "poem_id": 88064,
    "vorder": 216,
    "position": 1,
    "text": "بیامد خرامان به نزدیک من"
  },
  {
    "poem_id": 88064,
    "vorder": 217,
    "position": 0,
    "text": "گر از من همی جست خواهد نبرد"
  },
  {
    "poem_id": 88064,
    "vorder": 218,
    "position": 1,
    "text": "شما را چرا شد چنین روی زرد"
  },
  {
    "poem_id": 88064,
    "vorder": 219,
    "position": 0,
    "text": "همی از شما این شگفت آیدم"
  },
  {
    "poem_id": 88064,
    "vorder": 220,
    "position": 1,
    "text": "همان کین پیشین بیفزایدم"
  },
  {
    "poem_id": 88064,
    "vorder": 221,
    "position": 0,
    "text": "گمانی نبردم که ایرانیان"
  },
  {
    "poem_id": 88064,
    "vorder": 222,
    "position": 1,
    "text": "گشایند جاوید ز این کین میان"
  },
  {
    "poem_id": 88064,
    "vorder": 223,
    "position": 0,
    "text": "کسی را ندیدم ز ایران سپاه"
  },
  {
    "poem_id": 88064,
    "vorder": 224,
    "position": 1,
    "text": "که افگنده بود اندر این رزمگاه"
  },
  {
    "poem_id": 88064,
    "vorder": 225,
    "position": 0,
    "text": "که از جنگ ایشان گرفتی شتاب"
  },
  {
    "poem_id": 88064,
    "vorder": 226,
    "position": 1,
    "text": "به گفت فریبنده افراسیاب"
  },
  {
    "poem_id": 88064,
    "vorder": 227,
    "position": 0,
    "text": "چو ایرانیان این سخنها ز شاه"
  },
  {
    "poem_id": 88064,
    "vorder": 228,
    "position": 1,
    "text": "شنیدند و پیچان شدند از گناه"
  },
  {
    "poem_id": 88064,
    "vorder": 229,
    "position": 0,
    "text": "گرفتند پوزش که ما بنده‌ایم"
  },
  {
    "poem_id": 88064,
    "vorder": 230,
    "position": 1,
    "text": "هم از مهربانی سرافگنده‌ایم"
  },
  {
    "poem_id": 88064,
    "vorder": 231,
    "position": 0,
    "text": "نخواهد شهنشاه جز نام نیک"
  },
  {
    "poem_id": 88064,
    "vorder": 232,
    "position": 1,
    "text": "وگر کارها را سرانجام نیک"
  },
  {
    "poem_id": 88064,
    "vorder": 233,
    "position": 0,
    "text": "ستوده جهاندار برتر منش"
  },
  {
    "poem_id": 88064,
    "vorder": 234,
    "position": 1,
    "text": "نخواهد که بر ما بود سرزنش"
  },
  {
    "poem_id": 88064,
    "vorder": 235,
    "position": 0,
    "text": "که گویند از ایران سواری نبود"
  },
  {
    "poem_id": 88064,
    "vorder": 236,
    "position": 1,
    "text": "که یارست با شیده رزم آزمود"
  },
  {
    "poem_id": 88064,
    "vorder": 237,
    "position": 0,
    "text": "که آمد سواری به دشت نبرد"
  },
  {
    "poem_id": 88064,
    "vorder": 238,
    "position": 1,
    "text": "جز از شاهشان این دلیری نکرد"
  },
  {
    "poem_id": 88064,
    "vorder": 239,
    "position": 0,
    "text": "نخواهد مگر خسرو موبدان"
  },
  {
    "poem_id": 88064,
    "vorder": 240,
    "position": 1,
    "text": "که بر ما بود ننگ تا جاودان"
  },
  {
    "poem_id": 88064,
    "vorder": 241,
    "position": 0,
    "text": "بدیشان چنین پاسخ آورد شاه"
  },
  {
    "poem_id": 88064,
    "vorder": 242,
    "position": 1,
    "text": "که ای موبدان نماینده راه"
  },
  {
    "poem_id": 88064,
    "vorder": 243,
    "position": 0,
    "text": "بدانید کاین شیده روز نبرد"
  },
  {
    "poem_id": 88064,
    "vorder": 244,
    "position": 1,
    "text": "پدر را ندارد به هامون به مرد"
  },
  {
    "poem_id": 88064,
    "vorder": 245,
    "position": 0,
    "text": "سلیحش پدر کرده از جادویی"
  },
  {
    "poem_id": 88064,
    "vorder": 246,
    "position": 1,
    "text": "ز کژی و بی راهی و بدخویی"
  },
  {
    "poem_id": 88064,
    "vorder": 247,
    "position": 0,
    "text": "نباشد سلیح شما کارگر"
  },
  {
    "poem_id": 88064,
    "vorder": 248,
    "position": 1,
    "text": "بدان جوشن و خود پولادبر"
  },
  {
    "poem_id": 88064,
    "vorder": 249,
    "position": 0,
    "text": "همان اسبش از باد دارد نژاد"
  },
  {
