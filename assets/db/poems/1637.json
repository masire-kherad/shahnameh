[
  {
    "poem_id": 1637,
    "vorder": 1,
    "position": 0,
    "text": "چو آن پاسخ نامه دارا بخواند"
  },
  {
    "poem_id": 1637,
    "vorder": 2,
    "position": 1,
    "text": "ز کار جهان در شگفتی بماند"
  },
  {
    "poem_id": 1637,
    "vorder": 3,
    "position": 0,
    "text": "سرانجام گفت این ز کشتن بتر"
  },
  {
    "poem_id": 1637,
    "vorder": 4,
    "position": 1,
    "text": "که من پیش رومی ببندم کمر"
  },
  {
    "poem_id": 1637,
    "vorder": 5,
    "position": 0,
    "text": "ستودان مرا بهتر آید ز ننگ"
  },
  {
    "poem_id": 1637,
    "vorder": 6,
    "position": 1,
    "text": "یکی داستان زد برین مرد سنگ"
  },
  {
    "poem_id": 1637,
    "vorder": 7,
    "position": 0,
    "text": "که گر آب دریا بخواهد رسید"
  },
  {
    "poem_id": 1637,
    "vorder": 8,
    "position": 1,
    "text": "درو قطره باران نیاید پدید"
  },
  {
    "poem_id": 1637,
    "vorder": 9,
    "position": 0,
    "text": "همی بودمی یار هرکس به جنگ"
  },
  {
    "poem_id": 1637,
    "vorder": 10,
    "position": 1,
    "text": "چو شد مر مرا زین نشان کار تنگ"
  },
  {
    "poem_id": 1637,
    "vorder": 11,
    "position": 0,
    "text": "نبینم همی در جهان یار کس"
  },
  {
    "poem_id": 1637,
    "vorder": 12,
    "position": 1,
    "text": "بجز ایزدم نیست فریادرس"
  },
  {
    "poem_id": 1637,
    "vorder": 13,
    "position": 0,
    "text": "چو یاور نبودش ز نزدیک و دور"
  },
  {
    "poem_id": 1637,
    "vorder": 14,
    "position": 1,
    "text": "یکی نامه بنوشت نزدیک فور"
  },
  {
    "poem_id": 1637,
    "vorder": 15,
    "position": 0,
    "text": "پر از لابه و زیردستی و درد"
  },
  {
    "poem_id": 1637,
    "vorder": 16,
    "position": 1,
    "text": "نخست آفرین بر جهاندار کرد"
  },
  {
    "poem_id": 1637,
    "vorder": 17,
    "position": 0,
    "text": "دگر گفت کای مهتر هندوان"
  },
  {
    "poem_id": 1637,
    "vorder": 18,
    "position": 1,
    "text": "خردمند و دانا و روشن‌روان"
  },
  {
    "poem_id": 1637,
    "vorder": 19,
    "position": 0,
    "text": "همانا که نزد تو آمد خبر"
  },
  {
    "poem_id": 1637,
    "vorder": 20,
    "position": 1,
    "text": "که ما را چه آمد ز اختر به سر"
  },
  {
    "poem_id": 1637,
    "vorder": 21,
    "position": 0,
    "text": "سکندر بیاورد لشکر ز روم"
  },
  {
    "poem_id": 1637,
    "vorder": 22,
    "position": 1,
    "text": "نه برماند ما را نه آباد بوم"
  },
  {
    "poem_id": 1637,
    "vorder": 23,
    "position": 0,
    "text": "نه پیوند و فرزند و تخت و کلاه"
  },
  {
    "poem_id": 1637,
    "vorder": 24,
    "position": 1,
    "text": "نه دیهیم شاهی نه گنج و سپاه"
  },
  {
    "poem_id": 1637,
    "vorder": 25,
    "position": 0,
    "text": "ار ایدونک باشی مرا یارمند"
  },
  {
    "poem_id": 1637,
    "vorder": 26,
    "position": 1,
    "text": "که از خویشتن بازدارم گزند"
  },
  {
    "poem_id": 1637,
    "vorder": 27,
    "position": 0,
    "text": "فرستمت چندان گهرها ز گنج"
  },
  {
    "poem_id": 1637,
    "vorder": 28,
    "position": 1,
    "text": "کزان پس نبینی تو از گنج رنج"
  },
  {
    "poem_id": 1637,
    "vorder": 29,
    "position": 0,
    "text": "همان در جهان نیز نامی شوی"
  },
  {
    "poem_id": 1637,
    "vorder": 30,
    "position": 1,
    "text": "به نزد بزرگان گرامی شوی"
  },
  {
    "poem_id": 1637,
    "vorder": 31,
    "position": 0,
    "text": "هیونی برافگند بر سان باد"
  },
  {
    "poem_id": 1637,
    "vorder": 32,
    "position": 1,
    "text": "بیامد بر فور فوران نژاد"
  },
  {
    "poem_id": 1637,
    "vorder": 33,
    "position": 0,
    "text": "چو اسکندر آگاه شد زین سخن"
  },
  {
    "poem_id": 1637,
    "vorder": 34,
    "position": 1,
    "text": "که دارای دارا چه افگند بن"
  },
  {
    "poem_id": 1637,
    "vorder": 35,
    "position": 0,
    "text": "بفرمود تا برکشیدند نای"
  },
  {
    "poem_id": 1637,
    "vorder": 36,
    "position": 1,
    "text": "غو کوس برخاست و هندی درای"
  },
  {
    "poem_id": 1637,
    "vorder": 37,
    "position": 0,
    "text": "بیامد ز اصطخر چندان سپاه"
  },
  {
    "poem_id": 1637,
    "vorder": 38,
    "position": 1,
    "text": "که خورشید بر چرخ گم کرد راه"
  },
  {
    "poem_id": 1637,
    "vorder": 39,
    "position": 0,
    "text": "برآمد خروش سپاه از دو روی"
  },
  {
    "poem_id": 1637,
    "vorder": 40,
    "position": 1,
    "text": "بی‌آرام شد مردم جنگجوی"
  },
  {
    "poem_id": 1637,
    "vorder": 41,
    "position": 0,
    "text": "سکندر به آیین صفی برکشید"
  },
  {
    "poem_id": 1637,
    "vorder": 42,
    "position": 1,
    "text": "هوا نیلگون شد زمین ناپدید"
  },
  {
    "poem_id": 1637,
    "vorder": 43,
    "position": 0,
    "text": "چو دارا بیاورد لشکر به راه"
  },
  {
    "poem_id": 1637,
    "vorder": 44,
    "position": 1,
    "text": "سپاهی نه بر آرزو رزمخواه"
  },
  {
    "poem_id": 1637,
    "vorder": 45,
    "position": 0,
    "text": "شکسته دل و گشته از رزم سیر"
  },
  {
    "poem_id": 1637,
    "vorder": 46,
    "position": 1,
    "text": "سر بخت ایرانیان گشته زیر"
  },
  {
    "poem_id": 1637,
    "vorder": 47,
    "position": 0,
    "text": "نیاویختند ایچ با رومیان"
  },
  {
    "poem_id": 1637,
    "vorder": 48,
    "position": 1,
    "text": "چو روبه شد آن دشت شیر ژیان"
  },
  {
    "poem_id": 1637,
    "vorder": 49,
    "position": 0,
    "text": "گرانمایگان زینهاری شدند"
  },
  {
    "poem_id": 1637,
    "vorder": 50,
    "position": 1,
    "text": "ز اوج بزرگی به خواری شدند"
  },
  {
    "poem_id": 1637,
    "vorder": 51,
    "position": 0,
    "text": "چو دارا چنان دید برگاشت روی"
  },
  {
    "poem_id": 1637,
    "vorder": 52,
    "position": 1,
    "text": "گریزان همی رفت با های هوی"
  },
  {
    "poem_id": 1637,
    "vorder": 53,
    "position": 0,
    "text": "برفتند با شاه سیصد سوار"
  },
  {
    "poem_id": 1637,
    "vorder": 54,
    "position": 1,
    "text": "از ایران هرانکس که بد نامدار"
  },
  {
    "poem_id": 1637,
    "vorder": 55,
    "position": 0,
    "text": "دو دستور بودش گرامی دو مرد"
  },
  {
    "poem_id": 1637,
    "vorder": 56,
    "position": 1,
    "text": "که با او بدندی به دشت نبرد"
  },
  {
    "poem_id": 1637,
    "vorder": 57,
    "position": 0,
    "text": "یکی موبدی نام او ماهیار"
  },
  {
    "poem_id": 1637,
    "vorder": 58,
    "position": 1,
    "text": "دگر مرد را نام جانوشیار"
  },
  {
    "poem_id": 1637,
    "vorder": 59,
    "position": 0,
    "text": "چو دیدند کان کار بی‌سود گشت"
  },
  {
    "poem_id": 1637,
    "vorder": 60,
    "position": 1,
    "text": "بلند اختر و نام دارا گذشت"
  },
  {
    "poem_id": 1637,
    "vorder": 61,
    "position": 0,
    "text": "یکی با دگر گفت کین شوربخت"
  },
  {
    "poem_id": 1637,
    "vorder": 62,
    "position": 1,
    "text": "ازو دور شد افسر و تاج و تخت"
  },
  {
    "poem_id": 1637,
    "vorder": 63,
    "position": 0,
    "text": "بباید زدن دشنه‌ای بر برش"
  },
  {
    "poem_id": 1637,
    "vorder": 64,
    "position": 1,
    "text": "وگر تیغ هندی یکی بر سرش"
  },
  {
    "poem_id": 1637,
    "vorder": 65,
    "position": 0,
    "text": "سکندر سپارد به ما کشوری"
  },
  {
    "poem_id": 1637,
    "vorder": 66,
    "position": 1,
    "text": "بدین پادشاهی شویم افسری"
  },
  {
    "poem_id": 1637,
    "vorder": 67,
    "position": 0,
    "text": "همی رفت با او دو دستور اوی"
  },
  {
    "poem_id": 1637,
    "vorder": 68,
    "position": 1,
    "text": "که دستور بودند و گنجور اوی"
  },
  {
    "poem_id": 1637,
    "vorder": 69,
    "position": 0,
    "text": "مهین بر چپ و ماهیارش به راست"
  },
  {
    "poem_id": 1637,
    "vorder": 70,
    "position": 1,
    "text": "چو شب تیره شد از هوا باد خاست"
  },
  {
    "poem_id": 1637,
    "vorder": 71,
    "position": 0,
    "text": "یکی دشنه بگرفت جانوشیار"
  },
  {
    "poem_id": 1637,
    "vorder": 72,
    "position": 1,
    "text": "بزد بر بر و سینهٔ شهریار"
  },
  {
    "poem_id": 1637,
    "vorder": 73,
    "position": 0,
    "text": "نگون شد سر نامبردار شاه"
  },
  {
    "poem_id": 1637,
    "vorder": 74,
    "position": 1,
    "text": "ازو بازگشتند یکسر سپاه"
  }
]