[
  {
    "poem_id": 1560,
    "vorder": 1,
    "position": 0,
    "text": "کنون ز این سپس هفتخوان آورم"
  },
  {
    "poem_id": 1560,
    "vorder": 2,
    "position": 1,
    "text": "سخنهای نغز و جوان آورم"
  },
  {
    "poem_id": 1560,
    "vorder": 3,
    "position": 0,
    "text": "اگر بخت یکباره یاری کند"
  },
  {
    "poem_id": 1560,
    "vorder": 4,
    "position": 1,
    "text": "بر او طبع من کامگاری کند"
  },
  {
    "poem_id": 1560,
    "vorder": 5,
    "position": 0,
    "text": "بگویم به تأیید محمود شاه"
  },
  {
    "poem_id": 1560,
    "vorder": 6,
    "position": 1,
    "text": "بدان فر و آن خسروانی کلاه"
  },
  {
    "poem_id": 1560,
    "vorder": 7,
    "position": 0,
    "text": "که شاه جهان جاودان زنده باد"
  },
  {
    "poem_id": 1560,
    "vorder": 8,
    "position": 1,
    "text": "بزرگان گیتی ورا بنده باد"
  },
  {
    "poem_id": 1560,
    "vorder": 9,
    "position": 0,
    "text": "چو خورشید بر چرخ بنمود چهر"
  },
  {
    "poem_id": 1560,
    "vorder": 10,
    "position": 1,
    "text": "بیاراست روی زمین را به مهر"
  },
  {
    "poem_id": 1560,
    "vorder": 11,
    "position": 0,
    "text": "به برج حمل تاج بر سر نهاد"
  },
  {
    "poem_id": 1560,
    "vorder": 12,
    "position": 1,
    "text": "از او خاور و باختر گشت شاد"
  },
  {
    "poem_id": 1560,
    "vorder": 13,
    "position": 0,
    "text": "پر از غلغل و رعد شد کوهسار"
  },
  {
    "poem_id": 1560,
    "vorder": 14,
    "position": 1,
    "text": "پر از نرگس و لاله شد جویبار"
  },
  {
    "poem_id": 1560,
    "vorder": 15,
    "position": 0,
    "text": "ز لاله فریب و ز نرگس نهیب"
  },
  {
    "poem_id": 1560,
    "vorder": 16,
    "position": 1,
    "text": "ز سنبل عتیب و ز گلنار زیب"
  },
  {
    "poem_id": 1560,
    "vorder": 17,
    "position": 0,
    "text": "پر آتش دل ابر و پر آب چشم"
  },
  {
    "poem_id": 1560,
    "vorder": 18,
    "position": 1,
    "text": "خروش مغانی و پر تاب خشم"
  },
  {
    "poem_id": 1560,
    "vorder": 19,
    "position": 0,
    "text": "چو آتش نماید بپالاید آب"
  },
  {
    "poem_id": 1560,
    "vorder": 20,
    "position": 1,
    "text": "ز آواز او سر برآید ز خواب"
  },
  {
    "poem_id": 1560,
    "vorder": 21,
    "position": 0,
    "text": "چو بیدار گردی جهان را ببین"
  },
  {
    "poem_id": 1560,
    "vorder": 22,
    "position": 1,
    "text": "که دیباست گر نقش مانی به چین"
  },
  {
    "poem_id": 1560,
    "vorder": 23,
    "position": 0,
    "text": "چو رخشنده گردد جهان ز آفتاب"
  },
  {
    "poem_id": 1560,
    "vorder": 24,
    "position": 1,
    "text": "رخ نرگس و لاله بینی پر آب"
  },
  {
    "poem_id": 1560,
    "vorder": 25,
    "position": 0,
    "text": "به خنده بدو گوید ای شوخ چشم"
  },
  {
    "poem_id": 1560,
    "vorder": 26,
    "position": 1,
    "text": "به عشق تو گریان نه از درد و خشم"
  },
  {
    "poem_id": 1560,
    "vorder": 27,
    "position": 0,
    "text": "نخندد زمین تا نگرید هوا"
  },
  {
    "poem_id": 1560,
    "vorder": 28,
    "position": 1,
    "text": "هوا را نخوانم کف پادشا"
  },
  {
    "poem_id": 1560,
    "vorder": 29,
    "position": 0,
    "text": "که باران او در بهاران بود"
  },
  {
    "poem_id": 1560,
    "vorder": 30,
    "position": 1,
    "text": "نه چون همت شهریاران بود"
  },
  {
    "poem_id": 1560,
    "vorder": 31,
    "position": 0,
    "text": "به خورشید ماند همی دست شاه"
  },
  {
    "poem_id": 1560,
    "vorder": 32,
    "position": 1,
    "text": "چو اندر حمل برفرازد کلاه"
  },
  {
    "poem_id": 1560,
    "vorder": 33,
    "position": 0,
    "text": "اگر گنج پیش آید از خاک خشک"
  },
  {
    "poem_id": 1560,
    "vorder": 34,
    "position": 1,
    "text": "وگر آب دریا و گر در و مشک"
  },
  {
    "poem_id": 1560,
    "vorder": 35,
    "position": 0,
    "text": "ندارد همی روشناییش باز"
  },
  {
    "poem_id": 1560,
    "vorder": 36,
    "position": 1,
    "text": "ز درویش وز شاه گردن فراز"
  },
  {
    "poem_id": 1560,
    "vorder": 37,
    "position": 0,
    "text": "کف شاه ابوالقاسم آن پادشا"
  },
  {
    "poem_id": 1560,
    "vorder": 38,
    "position": 1,
    "text": "چنین است با پاک و ناپارسا"
  },
  {
    "poem_id": 1560,
    "vorder": 39,
    "position": 0,
    "text": "دریغش نیاید ز بخشیدن ایچ"
  },
  {
    "poem_id": 1560,
    "vorder": 40,
    "position": 1,
    "text": "نه آرام گیرد به روز بسیچ"
  },
  {
    "poem_id": 1560,
    "vorder": 41,
    "position": 0,
    "text": "چو جنگ آیدش پیش جنگ آورد"
  },
  {
    "poem_id": 1560,
    "vorder": 42,
    "position": 1,
    "text": "سر شهریاران به چنگ آورد"
  },
  {
    "poem_id": 1560,
    "vorder": 43,
    "position": 0,
    "text": "بدان کس که گردن نهد گنج خویش"
  },
  {
    "poem_id": 1560,
    "vorder": 44,
    "position": 1,
    "text": "ببخشد نیندیشد از رنج خویش"
  },
  {
    "poem_id": 1560,
    "vorder": 45,
    "position": 0,
    "text": "جهان را جهاندار محمود باد"
  },
  {
    "poem_id": 1560,
    "vorder": 46,
    "position": 1,
    "text": "از او بخشش و داد موجود باد"
  },
  {
    "poem_id": 1560,
    "vorder": 47,
    "position": 0,
    "text": "ز رویین دژ اکنون جهاندیده پیر"
  },
  {
    "poem_id": 1560,
    "vorder": 48,
    "position": 1,
    "text": "نگر تا چه گوید از او یاد گیر"
  }
]