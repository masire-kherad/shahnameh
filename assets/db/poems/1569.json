[
  {
    "poem_id": 1569,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تابان ز گنبد بگشت"
  },
  {
    "poem_id": 1569,
    "vorder": 2,
    "position": 1,
    "text": "خریدار بازار او در گذشت"
  },
  {
    "poem_id": 1569,
    "vorder": 3,
    "position": 0,
    "text": "دو خواهرش رفتند ز ایوان به کوی"
  },
  {
    "poem_id": 1569,
    "vorder": 4,
    "position": 1,
    "text": "غریوان و بر کفتها بر سبوی"
  },
  {
    "poem_id": 1569,
    "vorder": 5,
    "position": 0,
    "text": "به نزدیک اسفندیار آمدند"
  },
  {
    "poem_id": 1569,
    "vorder": 6,
    "position": 1,
    "text": "دو دیده‌تر و خاکسار آمدند"
  },
  {
    "poem_id": 1569,
    "vorder": 7,
    "position": 0,
    "text": "چو اسفندیار آن شگفتی بدید"
  },
  {
    "poem_id": 1569,
    "vorder": 8,
    "position": 1,
    "text": "دو رخ کرد از خواهران ناپدید"
  },
  {
    "poem_id": 1569,
    "vorder": 9,
    "position": 0,
    "text": "شد از کار ایشان دلش پر ز بیم"
  },
  {
    "poem_id": 1569,
    "vorder": 10,
    "position": 1,
    "text": "بپوشید رخ را به زیر گلیم"
  },
  {
    "poem_id": 1569,
    "vorder": 11,
    "position": 0,
    "text": "برفتند هر دو به نزدیک اوی"
  },
  {
    "poem_id": 1569,
    "vorder": 12,
    "position": 1,
    "text": "ز خون برنهاده به رخ‌بر دو جوی"
  },
  {
    "poem_id": 1569,
    "vorder": 13,
    "position": 0,
    "text": "به خواهش گرفتند بیچارگان"
  },
  {
    "poem_id": 1569,
    "vorder": 14,
    "position": 1,
    "text": "بران نامور مرد بازارگان"
  },
  {
    "poem_id": 1569,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت خواهر که ای ساروان"
  },
  {
    "poem_id": 1569,
    "vorder": 16,
    "position": 1,
    "text": "نخست از کجا راندی کاروان"
  },
  {
    "poem_id": 1569,
    "vorder": 17,
    "position": 0,
    "text": "که روز و شبان بر تو فرخنده باد"
  },
  {
    "poem_id": 1569,
    "vorder": 18,
    "position": 1,
    "text": "همه مهتران پیش تو بنده باد"
  },
  {
    "poem_id": 1569,
    "vorder": 19,
    "position": 0,
    "text": "ز ایران و گشتاسپ و اسفندیار"
  },
  {
    "poem_id": 1569,
    "vorder": 20,
    "position": 1,
    "text": "چه آگاهی است ای گو نامدار"
  },
  {
    "poem_id": 1569,
    "vorder": 21,
    "position": 0,
    "text": "بدین سان دو دخت یکی پادشا"
  },
  {
    "poem_id": 1569,
    "vorder": 22,
    "position": 1,
    "text": "اسیریم در دست ناپارسا"
  },
  {
    "poem_id": 1569,
    "vorder": 23,
    "position": 0,
    "text": "برهنه سر و پای و دوش آبکش"
  },
  {
    "poem_id": 1569,
    "vorder": 24,
    "position": 1,
    "text": "پدر شادمان روز و شب خفته خوش"
  },
  {
    "poem_id": 1569,
    "vorder": 25,
    "position": 0,
    "text": "برهنه دوان بر سر انجمن"
  },
  {
    "poem_id": 1569,
    "vorder": 26,
    "position": 1,
    "text": "خنک آنک پوشد تنش را کفن"
  },
  {
    "poem_id": 1569,
    "vorder": 27,
    "position": 0,
    "text": "بگرییم چندی به خونین سرشک"
  },
  {
    "poem_id": 1569,
    "vorder": 28,
    "position": 1,
    "text": "تو باشی بدین درد ما را پزشک"
  },
  {
    "poem_id": 1569,
    "vorder": 29,
    "position": 0,
    "text": "گر آگاهیت هست از شهر ما"
  },
  {
    "poem_id": 1569,
    "vorder": 30,
    "position": 1,
    "text": "برین بوم تریاک شد زهر ما"
  },
  {
    "poem_id": 1569,
    "vorder": 31,
    "position": 0,
    "text": "یکی بانگ برزد به زیر گلیم"
  },
  {
    "poem_id": 1569,
    "vorder": 32,
    "position": 1,
    "text": "که لرزان شدند آن دو دختر ز بیم"
  },
  {
    "poem_id": 1569,
    "vorder": 33,
    "position": 0,
    "text": "که اسفندیار از بنه خود مباد"
  },
  {
    "poem_id": 1569,
    "vorder": 34,
    "position": 1,
    "text": "نه آن کس به گیتی کزو کرد یاد"
  },
  {
    "poem_id": 1569,
    "vorder": 35,
    "position": 0,
    "text": "ز گشتاسپ آن مرد بیدادگر"
  },
  {
    "poem_id": 1569,
    "vorder": 36,
    "position": 1,
    "text": "مبیناد چون او کلاه و کمر"
  },
  {
    "poem_id": 1569,
    "vorder": 37,
    "position": 0,
    "text": "نبینید کاید فروشنده‌ام"
  },
  {
    "poem_id": 1569,
    "vorder": 38,
    "position": 1,
    "text": "ز بهر خور خویش کوشنده‌ام"
  },
  {
    "poem_id": 1569,
    "vorder": 39,
    "position": 0,
    "text": "چو آواز بشنید فرخ همای"
  },
  {
    "poem_id": 1569,
    "vorder": 40,
    "position": 1,
    "text": "بدانست و آمد دلش باز جای"
  },
  {
    "poem_id": 1569,
    "vorder": 41,
    "position": 0,
    "text": "چو خواهر بدانست آواز اوی"
  },
  {
    "poem_id": 1569,
    "vorder": 42,
    "position": 1,
    "text": "بپوشید بر خویشتن راز اوی"
  },
  {
    "poem_id": 1569,
    "vorder": 43,
    "position": 0,
    "text": "چنان داغ دل پیش او در بماند"
  },
  {
    "poem_id": 1569,
    "vorder": 44,
    "position": 1,
    "text": "سرشک از دو دیده به رخ برفشاند"
  },
  {
    "poem_id": 1569,
    "vorder": 45,
    "position": 0,
    "text": "همه جامه چاک و دو پایش به خاک"
  },
  {
    "poem_id": 1569,
    "vorder": 46,
    "position": 1,
    "text": "از ارجاسپ جانش پر از بیم و باک"
  },
  {
    "poem_id": 1569,
    "vorder": 47,
    "position": 0,
    "text": "بدانست جنگاور پاک‌رای"
  },
  {
    "poem_id": 1569,
    "vorder": 48,
    "position": 1,
    "text": "که او را همی بازداند همای"
  },
  {
    "poem_id": 1569,
    "vorder": 49,
    "position": 0,
    "text": "سبک روی بگشاد و دیده پرآب"
  },
  {
    "poem_id": 1569,
    "vorder": 50,
    "position": 1,
    "text": "پر از خون دل و چهره چون آفتاب"
  },
  {
    "poem_id": 1569,
    "vorder": 51,
    "position": 0,
    "text": "ز کار جهان ماند اندر شگفت"
  },
  {
    "poem_id": 1569,
    "vorder": 52,
    "position": 1,
    "text": "دژم گشت و لب را به دندان گرفت"
  },
  {
    "poem_id": 1569,
    "vorder": 53,
    "position": 0,
    "text": "بدیشان چنین گفت کاین روز چند"
  },
  {
    "poem_id": 1569,
    "vorder": 54,
    "position": 1,
    "text": "بدارید هر دو لبان را به بند"
  },
  {
    "poem_id": 1569,
    "vorder": 55,
    "position": 0,
    "text": "من ایدر نه از بهر جنگ آمدم"
  },
  {
    "poem_id": 1569,
    "vorder": 56,
    "position": 1,
    "text": "به رنج از پی نام و ننگ آمدم"
  },
  {
    "poem_id": 1569,
    "vorder": 57,
    "position": 0,
    "text": "کسی را که دختر بود آبکش"
  },
  {
    "poem_id": 1569,
    "vorder": 58,
    "position": 1,
    "text": "پسر در غم و باب در خواب خوش"
  },
  {
    "poem_id": 1569,
    "vorder": 59,
    "position": 0,
    "text": "پدر آسمان باد و مادر زمین"
  },
  {
    "poem_id": 1569,
    "vorder": 60,
    "position": 1,
    "text": "نخوانم برین روزگار آفرین"
  },
  {
    "poem_id": 1569,
    "vorder": 61,
    "position": 0,
    "text": "پس از کلبه برخاست مرد جوان"
  },
  {
    "poem_id": 1569,
    "vorder": 62,
    "position": 1,
    "text": "به نزدیک ارجاسپ آمد دوان"
  },
  {
    "poem_id": 1569,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت کای شاه فرخنده باش"
  },
  {
    "poem_id": 1569,
    "vorder": 64,
    "position": 1,
    "text": "جهاندار تا جاودان زنده باش"
  },
  {
    "poem_id": 1569,
    "vorder": 65,
    "position": 0,
    "text": "یکی ژرف دریا درین راه بود"
  },
  {
    "poem_id": 1569,
    "vorder": 66,
    "position": 1,
    "text": "که بازارگان زان نه آگاه بود"
  },
  {
    "poem_id": 1569,
    "vorder": 67,
    "position": 0,
    "text": "ز دریا برآمد یکی کژ باد"
  },
  {
    "poem_id": 1569,
    "vorder": 68,
    "position": 1,
    "text": "که ملاح گفت آن ندارم به یاد"
  },
  {
    "poem_id": 1569,
    "vorder": 69,
    "position": 0,
    "text": "به کشتی همه زار و گریان شدیم"
  },
  {
    "poem_id": 1569,
    "vorder": 70,
    "position": 1,
    "text": "ز جان و تن خویش بریان شدیم"
  },
  {
    "poem_id": 1569,
    "vorder": 71,
    "position": 0,
    "text": "پذیرفتم از دادگر یک خدای"
  },
  {
    "poem_id": 1569,
    "vorder": 72,
    "position": 1,
    "text": "که گر یابم از بیم دریا رهای"
  },
  {
    "poem_id": 1569,
    "vorder": 73,
    "position": 0,
    "text": "یکی بزم سازم به هر کشوری"
  },
  {
    "poem_id": 1569,
    "vorder": 74,
    "position": 1,
    "text": "که باشد بران کشور اندر سری"
  },
  {
    "poem_id": 1569,
    "vorder": 75,
    "position": 0,
    "text": "بخواهنده بخشم کم و بیش را"
  },
  {
    "poem_id": 1569,
    "vorder": 76,
    "position": 1,
    "text": "گرامی کنم مرد درویش را"
  },
  {
    "poem_id": 1569,
    "vorder": 77,
    "position": 0,
    "text": "کنون شاه ما را گرامی کند"
  },
  {
    "poem_id": 1569,
    "vorder": 78,
    "position": 1,
    "text": "بدین خواهش امروز نامی کند"
  },
  {
    "poem_id": 1569,
    "vorder": 79,
    "position": 0,
    "text": "ز لشکر سرافراز گردان که‌اند"
  },
  {
    "poem_id": 1569,
    "vorder": 80,
    "position": 1,
    "text": "به نزدیک شاه جهان ارجمند"
  },
  {
    "poem_id": 1569,
    "vorder": 81,
    "position": 0,
    "text": "چنین ساختستم که مهمان کنم"
  },
  {
    "poem_id": 1569,
    "vorder": 82,
    "position": 1,
    "text": "وزین خواهش آرایش جان کنم"
  },
  {
    "poem_id": 1569,
    "vorder": 83,
    "position": 0,
    "text": "چو ارجاسپ بشنید زان شاد شد"
  },
  {
    "poem_id": 1569,
    "vorder": 84,
    "position": 1,
    "text": "سر مرد نادان پر از باد شد"
  },
  {
    "poem_id": 1569,
    "vorder": 85,
    "position": 0,
    "text": "بفرمود کانکو گرامی‌ترست"
  },
  {
    "poem_id": 1569,
    "vorder": 86,
    "position": 1,
    "text": "وزین لشکر امروز نامی‌ترست"
  },
  {
    "poem_id": 1569,
    "vorder": 87,
    "position": 0,
    "text": "به ایوان خراد مهمان شوند"
  },
  {
    "poem_id": 1569,
    "vorder": 88,
    "position": 1,
    "text": "وگر می بود پاک مستان شوند"
  },
  {
    "poem_id": 1569,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت شاها ردا بخردا"
  },
  {
    "poem_id": 1569,
    "vorder": 90,
    "position": 1,
    "text": "جهاندار و بر موبدان موبدا"
  },
  {
    "poem_id": 1569,
    "vorder": 91,
    "position": 0,
    "text": "مرا خانه تنگست و کاخ بلند"
  },
  {
    "poem_id": 1569,
    "vorder": 92,
    "position": 1,
    "text": "برین بارهٔ دژ شویم ارجمند"
  },
  {
    "poem_id": 1569,
    "vorder": 93,
    "position": 0,
    "text": "در مهر ماه آمد آتش کنم"
  },
  {
    "poem_id": 1569,
    "vorder": 94,
    "position": 1,
    "text": "دل نامداران به می خوش کنم"
  },
  {
    "poem_id": 1569,
    "vorder": 95,
    "position": 0,
    "text": "بدو گفت زان راه روکت هواست"
  },
  {
    "poem_id": 1569,
    "vorder": 96,
    "position": 1,
    "text": "به کاخ اندرون میزبان پادشاست"
  },
  {
    "poem_id": 1569,
    "vorder": 97,
    "position": 0,
    "text": "بیامد دمان پهلوان شادکام"
  },
  {
    "poem_id": 1569,
    "vorder": 98,
    "position": 1,
    "text": "فراوان برآورد هیزم به بام"
  },
  {
    "poem_id": 1569,
    "vorder": 99,
    "position": 0,
    "text": "بکشتند اسپان و چندی بره"
  },
  {
    "poem_id": 1569,
    "vorder": 100,
    "position": 1,
    "text": "کشیدند بر بام دژ یکسره"
  },
  {
    "poem_id": 1569,
    "vorder": 101,
    "position": 0,
    "text": "ز هیزم که بر بارهٔ دژ کشید"
  },
  {
    "poem_id": 1569,
    "vorder": 102,
    "position": 1,
    "text": "شد از دود روی هوا ناپدید"
  },
  {
    "poem_id": 1569,
    "vorder": 103,
    "position": 0,
    "text": "می آورد چون هرچ بد خورده شد"
  },
  {
    "poem_id": 1569,
    "vorder": 104,
    "position": 1,
    "text": "گسارندهٔ می ورا برده شد"
  },
  {
    "poem_id": 1569,
    "vorder": 105,
    "position": 0,
    "text": "همه نامدارن رفتند مست"
  },
  {
    "poem_id": 1569,
    "vorder": 106,
    "position": 1,
    "text": "ز مستی یکی شاخ نرگس به دست"
  }
]