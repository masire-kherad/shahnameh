[
  {
    "poem_id": 1612,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت رودابه روزی به زال"
  },
  {
    "poem_id": 1612,
    "vorder": 2,
    "position": 1,
    "text": "که از داغ و سوگ تهمتن بنال"
  },
  {
    "poem_id": 1612,
    "vorder": 3,
    "position": 0,
    "text": "همانا که تا هست گیتی فروز"
  },
  {
    "poem_id": 1612,
    "vorder": 4,
    "position": 1,
    "text": "ازین تیره‌تر کس ندیدست روز"
  },
  {
    "poem_id": 1612,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت زال ای زن کم خرد"
  },
  {
    "poem_id": 1612,
    "vorder": 6,
    "position": 1,
    "text": "غم ناچریدن بدین بگذرد"
  },
  {
    "poem_id": 1612,
    "vorder": 7,
    "position": 0,
    "text": "برآشفت رودابه سوگند خورد"
  },
  {
    "poem_id": 1612,
    "vorder": 8,
    "position": 1,
    "text": "که هرگز نیابد تنم خواب و خورد"
  },
  {
    "poem_id": 1612,
    "vorder": 9,
    "position": 0,
    "text": "روانم روان گو پیلتن"
  },
  {
    "poem_id": 1612,
    "vorder": 10,
    "position": 1,
    "text": "مگر باز بیند بران انجمن"
  },
  {
    "poem_id": 1612,
    "vorder": 11,
    "position": 0,
    "text": "ز خوردن یکی هفته تن باز داشت"
  },
  {
    "poem_id": 1612,
    "vorder": 12,
    "position": 1,
    "text": "که با جان رستم به دل راز داشت"
  },
  {
    "poem_id": 1612,
    "vorder": 13,
    "position": 0,
    "text": "ز ناخوردنش چشم تاریک شد"
  },
  {
    "poem_id": 1612,
    "vorder": 14,
    "position": 1,
    "text": "تن نازکش نیز باریک شد"
  },
  {
    "poem_id": 1612,
    "vorder": 15,
    "position": 0,
    "text": "ز هر سو که رفتی پرستنده چند"
  },
  {
    "poem_id": 1612,
    "vorder": 16,
    "position": 1,
    "text": "همی رفت با او ز بیم گزند"
  },
  {
    "poem_id": 1612,
    "vorder": 17,
    "position": 0,
    "text": "سر هفته را زو خرد دور شد"
  },
  {
    "poem_id": 1612,
    "vorder": 18,
    "position": 1,
    "text": "ز بیچارگی ماتمش سور شد"
  },
  {
    "poem_id": 1612,
    "vorder": 19,
    "position": 0,
    "text": "بیامد به بستان به هنگام خواب"
  },
  {
    "poem_id": 1612,
    "vorder": 20,
    "position": 1,
    "text": "یکی مرده ماری بدید اندر آب"
  },
  {
    "poem_id": 1612,
    "vorder": 21,
    "position": 0,
    "text": "بزد دست و بگرفت پیچان سرش"
  },
  {
    "poem_id": 1612,
    "vorder": 22,
    "position": 1,
    "text": "همی خواست کز مار سازد خورش"
  },
  {
    "poem_id": 1612,
    "vorder": 23,
    "position": 0,
    "text": "پرستنده از دست رودابه مار"
  },
  {
    "poem_id": 1612,
    "vorder": 24,
    "position": 1,
    "text": "ربود و گرفتندش اندر کنار"
  },
  {
    "poem_id": 1612,
    "vorder": 25,
    "position": 0,
    "text": "کشیدند از جای ناپاک دست"
  },
  {
    "poem_id": 1612,
    "vorder": 26,
    "position": 1,
    "text": "به ایوانش بردند و جای نشست"
  },
  {
    "poem_id": 1612,
    "vorder": 27,
    "position": 0,
    "text": "به جایی که بودیش بنشاختند"
  },
  {
    "poem_id": 1612,
    "vorder": 28,
    "position": 1,
    "text": "ببردند خوان و خورش ساختند"
  },
  {
    "poem_id": 1612,
    "vorder": 29,
    "position": 0,
    "text": "همی خورد هرچیز تا گشت سیر"
  },
  {
    "poem_id": 1612,
    "vorder": 30,
    "position": 1,
    "text": "فگندند پس جامهٔ نرم زیر"
  },
  {
    "poem_id": 1612,
    "vorder": 31,
    "position": 0,
    "text": "چو باز آمدش هوش با زال گفت"
  },
  {
    "poem_id": 1612,
    "vorder": 32,
    "position": 1,
    "text": "که گفتار تو با خرد بود جفت"
  },
  {
    "poem_id": 1612,
    "vorder": 33,
    "position": 0,
    "text": "هرانکس که او را خور و خواب نیست"
  },
  {
    "poem_id": 1612,
    "vorder": 34,
    "position": 1,
    "text": "غم مرگ با جشن و سورش یکیست"
  },
  {
    "poem_id": 1612,
    "vorder": 35,
    "position": 0,
    "text": "برفت او و ما از پس او رویم"
  },
  {
    "poem_id": 1612,
    "vorder": 36,
    "position": 1,
    "text": "به داد جهان‌آفرین بگرویم"
  },
  {
    "poem_id": 1612,
    "vorder": 37,
    "position": 0,
    "text": "به درویش داد آنچ بودش نهان"
  },
  {
    "poem_id": 1612,
    "vorder": 38,
    "position": 1,
    "text": "همی گفت با کردگار جهان"
  },
  {
    "poem_id": 1612,
    "vorder": 39,
    "position": 0,
    "text": "که ای برتر از نام وز جایگاه"
  },
  {
    "poem_id": 1612,
    "vorder": 40,
    "position": 1,
    "text": "روان تهمتن بشوی از گناه"
  },
  {
    "poem_id": 1612,
    "vorder": 41,
    "position": 0,
    "text": "بدان گیتیش جای ده در بهشت"
  },
  {
    "poem_id": 1612,
    "vorder": 42,
    "position": 1,
    "text": "برش ده ز تخمی که ایدر بکشت"
  }
]