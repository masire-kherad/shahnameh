[
  {
    "poem_id": 1898,
    "vorder": 1,
    "position": 0,
    "text": "به قیصر یکی نامه فرمود شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 2,
    "position": 1,
    "text": "که برنه سزاوار شاهی کلاه"
  },
  {
    "poem_id": 1898,
    "vorder": 3,
    "position": 0,
    "text": "که مریم پسر زاد زیبا یکی"
  },
  {
    "poem_id": 1898,
    "vorder": 4,
    "position": 1,
    "text": "که هرگز ندیدی چنو کودکی"
  },
  {
    "poem_id": 1898,
    "vorder": 5,
    "position": 0,
    "text": "نشاید مگر دانش و تخت را"
  },
  {
    "poem_id": 1898,
    "vorder": 6,
    "position": 1,
    "text": "وگر در هنر بخشش و بخت را"
  },
  {
    "poem_id": 1898,
    "vorder": 7,
    "position": 0,
    "text": "چو من شادمانم تو شادان بزی"
  },
  {
    "poem_id": 1898,
    "vorder": 8,
    "position": 1,
    "text": "که شاهی و گردنکشی را سزی"
  },
  {
    "poem_id": 1898,
    "vorder": 9,
    "position": 0,
    "text": "چو آن نامه نزدیک قیصر رسید"
  },
  {
    "poem_id": 1898,
    "vorder": 10,
    "position": 1,
    "text": "نگه کرد و توقیع پرویز دید"
  },
  {
    "poem_id": 1898,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود تا گاو دم بر درش"
  },
  {
    "poem_id": 1898,
    "vorder": 12,
    "position": 1,
    "text": "دمیدند و پر بانگ شد کشورش"
  },
  {
    "poem_id": 1898,
    "vorder": 13,
    "position": 0,
    "text": "ببستند آیین به بی‌راه و راه"
  },
  {
    "poem_id": 1898,
    "vorder": 14,
    "position": 1,
    "text": "پر آواز شیروی پرویز شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 15,
    "position": 0,
    "text": "برآمد هم آواز رامشگران"
  },
  {
    "poem_id": 1898,
    "vorder": 16,
    "position": 1,
    "text": "همه شهر روم از کران تا کران"
  },
  {
    "poem_id": 1898,
    "vorder": 17,
    "position": 0,
    "text": "بدرگاه بردند چندی صلیب"
  },
  {
    "poem_id": 1898,
    "vorder": 18,
    "position": 1,
    "text": "نسیم گلان آمد و بوی طیب"
  },
  {
    "poem_id": 1898,
    "vorder": 19,
    "position": 0,
    "text": "بیک هفته زین گونه با رود و می"
  },
  {
    "poem_id": 1898,
    "vorder": 20,
    "position": 1,
    "text": "ببودند شادان ز شیروی کی"
  },
  {
    "poem_id": 1898,
    "vorder": 21,
    "position": 0,
    "text": "بهشتم بفرمود تا کاروان"
  },
  {
    "poem_id": 1898,
    "vorder": 22,
    "position": 1,
    "text": "بیامد بدرگاه با ساروان"
  },
  {
    "poem_id": 1898,
    "vorder": 23,
    "position": 0,
    "text": "صد اشتر ز گنج درم بار کرد"
  },
  {
    "poem_id": 1898,
    "vorder": 24,
    "position": 1,
    "text": "چو پنجه شتر بار دینار کرد"
  },
  {
    "poem_id": 1898,
    "vorder": 25,
    "position": 0,
    "text": "ز دیبای زربفت رومی دویست"
  },
  {
    "poem_id": 1898,
    "vorder": 26,
    "position": 1,
    "text": "که گفتی ز زر جامه با رز یکیست"
  },
  {
    "poem_id": 1898,
    "vorder": 27,
    "position": 0,
    "text": "چهل خوان زرین پایه بسد"
  },
  {
    "poem_id": 1898,
    "vorder": 28,
    "position": 1,
    "text": "چنان کز در شهر یاران سزد"
  },
  {
    "poem_id": 1898,
    "vorder": 29,
    "position": 0,
    "text": "همان چند زرین و سیمین دده"
  },
  {
    "poem_id": 1898,
    "vorder": 30,
    "position": 1,
    "text": "بگوهر بر و چشمشان آژده"
  },
  {
    "poem_id": 1898,
    "vorder": 31,
    "position": 0,
    "text": "بمریم فرستاد چندی گهر"
  },
  {
    "poem_id": 1898,
    "vorder": 32,
    "position": 1,
    "text": "یکی نره طاوس کرده بزر"
  },
  {
    "poem_id": 1898,
    "vorder": 33,
    "position": 0,
    "text": "چه از جامهٔ نرم رومی حریر"
  },
  {
    "poem_id": 1898,
    "vorder": 34,
    "position": 1,
    "text": "ز در و زبرجد یکی آبگیر"
  },
  {
    "poem_id": 1898,
    "vorder": 35,
    "position": 0,
    "text": "همان باژ کشور که تا چار بار"
  },
  {
    "poem_id": 1898,
    "vorder": 36,
    "position": 1,
    "text": "ز دینار رومی هزاران هزار"
  },
  {
    "poem_id": 1898,
    "vorder": 37,
    "position": 0,
    "text": "فرستاد چون مرد رومی چهل"
  },
  {
    "poem_id": 1898,
    "vorder": 38,
    "position": 1,
    "text": "کجا هر چهل بود بیدار دل"
  },
  {
    "poem_id": 1898,
    "vorder": 39,
    "position": 0,
    "text": "گوی پیش رو نام او خانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 40,
    "position": 1,
    "text": "که همتا نبودش به فرزانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 41,
    "position": 0,
    "text": "همی‌شد برین گونه با ساروان"
  },
  {
    "poem_id": 1898,
    "vorder": 42,
    "position": 1,
    "text": "شتربار دینار ده کاروان"
  },
  {
    "poem_id": 1898,
    "vorder": 43,
    "position": 0,
    "text": "چوآگاهی آمد به پرویز شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 44,
    "position": 1,
    "text": "که پیغمبر قیصر آمد ز راه"
  },
  {
    "poem_id": 1898,
    "vorder": 45,
    "position": 0,
    "text": "به فرخ بفرمود تا برنشست"
  },
  {
    "poem_id": 1898,
    "vorder": 46,
    "position": 1,
    "text": "یکی مرزبان بود خسروپرست"
  },
  {
    "poem_id": 1898,
    "vorder": 47,
    "position": 0,
    "text": "که سالار او بود بر نیمروز"
  },
  {
    "poem_id": 1898,
    "vorder": 48,
    "position": 1,
    "text": "گرانمایه گردی و گیتی فروز"
  },
  {
    "poem_id": 1898,
    "vorder": 49,
    "position": 0,
    "text": "برفتند با او سواران شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 50,
    "position": 1,
    "text": "به سر برنهادند زرین کلاه"
  },
  {
    "poem_id": 1898,
    "vorder": 51,
    "position": 0,
    "text": "چو از دور دید آن سپه خانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 52,
    "position": 1,
    "text": "به پیش اندر آمد به بیگانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 53,
    "position": 0,
    "text": "چنین تا به نزدیک شاه آمدند"
  },
  {
    "poem_id": 1898,
    "vorder": 54,
    "position": 1,
    "text": "بران نامور پیشگاه آمدند"
  },
  {
    "poem_id": 1898,
    "vorder": 55,
    "position": 0,
    "text": "چو دیدند زیبا رخ شاه را"
  },
  {
    "poem_id": 1898,
    "vorder": 56,
    "position": 1,
    "text": "بران گونه آراسته‌گاه را"
  },
  {
    "poem_id": 1898,
    "vorder": 57,
    "position": 0,
    "text": "نهادند همواره سر بر زمین"
  },
  {
    "poem_id": 1898,
    "vorder": 58,
    "position": 1,
    "text": "برو بر همی‌خواندند آفرین"
  },
  {
    "poem_id": 1898,
    "vorder": 59,
    "position": 0,
    "text": "بمالید پس خانگی رخ بخاک"
  },
  {
    "poem_id": 1898,
    "vorder": 60,
    "position": 1,
    "text": "همی‌گفت کای داور داد وپاک"
  },
  {
    "poem_id": 1898,
    "vorder": 61,
    "position": 0,
    "text": "ز پیروزگر آفرین بر تو باد"
  },
  {
    "poem_id": 1898,
    "vorder": 62,
    "position": 1,
    "text": "مبادی همیشه مگر شاه و راد"
  },
  {
    "poem_id": 1898,
    "vorder": 63,
    "position": 0,
    "text": "بزرگانش از جای برخاستند"
  },
  {
    "poem_id": 1898,
    "vorder": 64,
    "position": 1,
    "text": "به نزدیک شه جایش آراستند"
  },
  {
    "poem_id": 1898,
    "vorder": 65,
    "position": 0,
    "text": "چنین گفت پس شاه را خانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 66,
    "position": 1,
    "text": "که چون تو که باشد به فرزانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 67,
    "position": 0,
    "text": "ز خورشید بر چرخ تابنده‌تر"
  },
  {
    "poem_id": 1898,
    "vorder": 68,
    "position": 1,
    "text": "ز جان سخنگوی پاینده‌تر"
  },
  {
    "poem_id": 1898,
    "vorder": 69,
    "position": 0,
    "text": "مبادا جهان بی‌چنین شهریار"
  },
  {
    "poem_id": 1898,
    "vorder": 70,
    "position": 1,
    "text": "برومند بادا برو روزگار"
  },
  {
    "poem_id": 1898,
    "vorder": 71,
    "position": 0,
    "text": "مبیناد کس روز بی‌کام تو"
  },
  {
    "poem_id": 1898,
    "vorder": 72,
    "position": 1,
    "text": "نوشته بخورشید بر نام تو"
  },
  {
    "poem_id": 1898,
    "vorder": 73,
    "position": 0,
    "text": "جهان بی سر و افسر تو مباد"
  },
  {
    "poem_id": 1898,
    "vorder": 74,
    "position": 1,
    "text": "بر و بوم بی لشکر تو مباد"
  },
  {
    "poem_id": 1898,
    "vorder": 75,
    "position": 0,
    "text": "ز قیصر درود و ز ما آفرین"
  },
  {
    "poem_id": 1898,
    "vorder": 76,
    "position": 1,
    "text": "برین نامور شهریار زمین"
  },
  {
    "poem_id": 1898,
    "vorder": 77,
    "position": 0,
    "text": "کسی کو درین سایهٔ شاه شاد"
  },
  {
    "poem_id": 1898,
    "vorder": 78,
    "position": 1,
    "text": "نباشد ورا روشنایی مباد"
  },
  {
    "poem_id": 1898,
    "vorder": 79,
    "position": 0,
    "text": "ابا هدیه و باژ روم آمدم"
  },
  {
    "poem_id": 1898,
    "vorder": 80,
    "position": 1,
    "text": "برین نامبردار بوم آمدم"
  },
  {
    "poem_id": 1898,
    "vorder": 81,
    "position": 0,
    "text": "برفتیم با فیلسوفان بهم"
  },
  {
    "poem_id": 1898,
    "vorder": 82,
    "position": 1,
    "text": "بران تا نباشد کس از ما دژم"
  },
  {
    "poem_id": 1898,
    "vorder": 83,
    "position": 0,
    "text": "ز قیصر پذیرد مگر باژ و چیز"
  },
  {
    "poem_id": 1898,
    "vorder": 84,
    "position": 1,
    "text": "که با باژ و چیز آفرینست نیز"
  },
  {
    "poem_id": 1898,
    "vorder": 85,
    "position": 0,
    "text": "بخندید از آن پر هنر مرد شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 86,
    "position": 1,
    "text": "نهادند زرین یکی پیشگاه"
  },
  {
    "poem_id": 1898,
    "vorder": 87,
    "position": 0,
    "text": "فرستاد پس چیزها سوی گنج"
  },
  {
    "poem_id": 1898,
    "vorder": 88,
    "position": 1,
    "text": "بدو گفت چندین نبایست رنج"
  },
  {
    "poem_id": 1898,
    "vorder": 89,
    "position": 0,
    "text": "بخراد برزین چنین گفت شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 90,
    "position": 1,
    "text": "که این نامه برخوان به پیش سپاه"
  },
  {
    "poem_id": 1898,
    "vorder": 91,
    "position": 0,
    "text": "به عنوان نگه کرد مرد دبیر"
  },
  {
    "poem_id": 1898,
    "vorder": 92,
    "position": 1,
    "text": "که گوینده‌ای بود و هم یادگیر"
  },
  {
    "poem_id": 1898,
    "vorder": 93,
    "position": 0,
    "text": "چنین گفت کاین نامه سوی مهست"
  },
  {
    "poem_id": 1898,
    "vorder": 94,
    "position": 1,
    "text": "جهاندار پرویز یزدان پرست"
  },
  {
    "poem_id": 1898,
    "vorder": 95,
    "position": 0,
    "text": "جهاندار و بیدار و پدرام شهر"
  },
  {
    "poem_id": 1898,
    "vorder": 96,
    "position": 1,
    "text": "که یزدانش تاج و خرد داد بهر"
  },
  {
    "poem_id": 1898,
    "vorder": 97,
    "position": 0,
    "text": "جهاندار فرزند هرمزد شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 98,
    "position": 1,
    "text": "که زیبای تاج است و زیبای گاه"
  },
  {
    "poem_id": 1898,
    "vorder": 99,
    "position": 0,
    "text": "ز قیصر پدر مادر شیر نام"
  },
  {
    "poem_id": 1898,
    "vorder": 100,
    "position": 1,
    "text": "که پاینده بادا بدو نام و کام"
  },
  {
    "poem_id": 1898,
    "vorder": 101,
    "position": 0,
    "text": "ابا فر و با برز و پیروز باد"
  },
  {
    "poem_id": 1898,
    "vorder": 102,
    "position": 1,
    "text": "همه روزگارانش نوروز باد"
  },
  {
    "poem_id": 1898,
    "vorder": 103,
    "position": 0,
    "text": "به ایران و تورانش بر دست رس"
  },
  {
    "poem_id": 1898,
    "vorder": 104,
    "position": 1,
    "text": "به شاهی مباداش انباز کس"
  },
  {
    "poem_id": 1898,
    "vorder": 105,
    "position": 0,
    "text": "همیشه به دل شاد و روشن روان"
  },
  {
    "poem_id": 1898,
    "vorder": 106,
    "position": 1,
    "text": "همیشه خرد پیر و دولت جوان"
  },
  {
    "poem_id": 1898,
    "vorder": 107,
    "position": 0,
    "text": "گران مایه شاهی کیومرثی"
  },
  {
    "poem_id": 1898,
    "vorder": 108,
    "position": 1,
    "text": "همان پور هوشنگ طهمورثی"
  },
  {
    "poem_id": 1898,
    "vorder": 109,
    "position": 0,
    "text": "پدر بر پدر و پسر بر پسر"
  },
  {
    "poem_id": 1898,
    "vorder": 110,
    "position": 1,
    "text": "مبادا که این گوهر آید به سر"
  },
  {
    "poem_id": 1898,
    "vorder": 111,
    "position": 0,
    "text": "برین پاک یزدان کند آفرین"
  },
  {
    "poem_id": 1898,
    "vorder": 112,
    "position": 1,
    "text": "بزرگان ملک و بزرگان دین"
  },
  {
    "poem_id": 1898,
    "vorder": 113,
    "position": 0,
    "text": "نه چون تو خزان و نه چون تو بهار"
  },
  {
    "poem_id": 1898,
    "vorder": 114,
    "position": 1,
    "text": "نه چون تو بایوان چین بر نگار"
  },
  {
    "poem_id": 1898,
    "vorder": 115,
    "position": 0,
    "text": "همه مردمی و همه راستی"
  },
  {
    "poem_id": 1898,
    "vorder": 116,
    "position": 1,
    "text": "مبیناد جانت بد کاستی"
  },
  {
    "poem_id": 1898,
    "vorder": 117,
    "position": 0,
    "text": "به ایران و توران و هندوستان"
  },
  {
    "poem_id": 1898,
    "vorder": 118,
    "position": 1,
    "text": "همان ترک تا روم و جادوستان"
  },
  {
    "poem_id": 1898,
    "vorder": 119,
    "position": 0,
    "text": "تو را داد یزدان به پاکی نژاد"
  },
  {
    "poem_id": 1898,
    "vorder": 120,
    "position": 1,
    "text": "کسی چون تو از پاک مادر نزاد"
  },
  {
    "poem_id": 1898,
    "vorder": 121,
    "position": 0,
    "text": "فریدون چو ایران بایرج سپرد"
  },
  {
    "poem_id": 1898,
    "vorder": 122,
    "position": 1,
    "text": "ز روم و ز چین نام مردی ببرد"
  },
  {
    "poem_id": 1898,
    "vorder": 123,
    "position": 0,
    "text": "برو آفرین کرد روز نخست"
  },
  {
    "poem_id": 1898,
    "vorder": 124,
    "position": 1,
    "text": "دلش را ز کژی و تاری بشست"
  },
  {
    "poem_id": 1898,
    "vorder": 125,
    "position": 0,
    "text": "همه بی نیازی و نیک اختری"
  },
  {
    "poem_id": 1898,
    "vorder": 126,
    "position": 1,
    "text": "بزرگی و مردی و افسونگری"
  },
  {
    "poem_id": 1898,
    "vorder": 127,
    "position": 0,
    "text": "تو گویی که یزدان شما را سپرد"
  },
  {
    "poem_id": 1898,
    "vorder": 128,
    "position": 1,
    "text": "وزان دیگران نام مردی ببرد"
  },
  {
    "poem_id": 1898,
    "vorder": 129,
    "position": 0,
    "text": "هنر پرور و راد و بخشنده گنج"
  },
  {
    "poem_id": 1898,
    "vorder": 130,
    "position": 1,
    "text": "ازین تخمهٔ هرگز نبد کس به رنج"
  },
  {
    "poem_id": 1898,
    "vorder": 131,
    "position": 0,
    "text": "نهادند بر دشمنان باژ و ساو"
  },
  {
    "poem_id": 1898,
    "vorder": 132,
    "position": 1,
    "text": "بد اندیشتان بارکش همچو گاو"
  },
  {
    "poem_id": 1898,
    "vorder": 133,
    "position": 0,
    "text": "ز هنگام کسری نوشین روان"
  },
  {
    "poem_id": 1898,
    "vorder": 134,
    "position": 1,
    "text": "که بادا همیشه روانش جوان"
  },
  {
    "poem_id": 1898,
    "vorder": 135,
    "position": 0,
    "text": "که از ژرف دریا برآورد پی"
  },
  {
    "poem_id": 1898,
    "vorder": 136,
    "position": 1,
    "text": "بران گونه دیوار بیدار کی"
  },
  {
    "poem_id": 1898,
    "vorder": 137,
    "position": 0,
    "text": "ز ترکان همه بیشهٔ نارون"
  },
  {
    "poem_id": 1898,
    "vorder": 138,
    "position": 1,
    "text": "بشستند وبی رنج گشت انجمن"
  },
  {
    "poem_id": 1898,
    "vorder": 139,
    "position": 0,
    "text": "ز دشمن برستند چندی جهان"
  },
  {
    "poem_id": 1898,
    "vorder": 140,
    "position": 1,
    "text": "برو آفرین از کهان و مهان"
  },
  {
    "poem_id": 1898,
    "vorder": 141,
    "position": 0,
    "text": "ز تازی و هندی و ایرانیان"
  },
  {
    "poem_id": 1898,
    "vorder": 142,
    "position": 1,
    "text": "ببستند پیشش کمر بر میان"
  },
  {
    "poem_id": 1898,
    "vorder": 143,
    "position": 0,
    "text": "روارو چنین تا به مرز خزر"
  },
  {
    "poem_id": 1898,
    "vorder": 144,
    "position": 1,
    "text": "ز ارمینیه تا در باختر"
  },
  {
    "poem_id": 1898,
    "vorder": 145,
    "position": 0,
    "text": "ز هیتال و ترک و سمرقند و چاچ"
  },
  {
    "poem_id": 1898,
    "vorder": 146,
    "position": 1,
    "text": "بزرگان با فر و اورند وتاج"
  },
  {
    "poem_id": 1898,
    "vorder": 147,
    "position": 0,
    "text": "همه کهتران شما بوده‌اند"
  },
  {
    "poem_id": 1898,
    "vorder": 148,
    "position": 1,
    "text": "برین بندگی بر گوا بوده‌اند"
  },
  {
    "poem_id": 1898,
    "vorder": 149,
    "position": 0,
    "text": "که شاهان ز تخم فریدون بدند"
  },
  {
    "poem_id": 1898,
    "vorder": 150,
    "position": 1,
    "text": "دگر یکسر از داد بیرون بدند"
  },
  {
    "poem_id": 1898,
    "vorder": 151,
    "position": 0,
    "text": "بدین خویشی اکنون که من کرده‌ام"
  },
  {
    "poem_id": 1898,
    "vorder": 152,
    "position": 1,
    "text": "بزرگی به دانش برآورده‌ام"
  },
  {
    "poem_id": 1898,
    "vorder": 153,
    "position": 0,
    "text": "بدان گونه شادم که تشنه بر آب"
  },
  {
    "poem_id": 1898,
    "vorder": 154,
    "position": 1,
    "text": "وگر سبزهٔ تیره بر آفتاب"
  },
  {
    "poem_id": 1898,
    "vorder": 155,
    "position": 0,
    "text": "جهاندار بیدار فرخ کناد"
  },
  {
    "poem_id": 1898,
    "vorder": 156,
    "position": 1,
    "text": "مرا اندرین روز پاسخ کناد"
  },
  {
    "poem_id": 1898,
    "vorder": 157,
    "position": 0,
    "text": "یکی آرزو خواهم از شهریار"
  },
  {
    "poem_id": 1898,
    "vorder": 158,
    "position": 1,
    "text": "کجا آن سخن نزد او هست خوار"
  },
  {
    "poem_id": 1898,
    "vorder": 159,
    "position": 0,
    "text": "که دار مسیحا به گنج شماست"
  },
  {
    "poem_id": 1898,
    "vorder": 160,
    "position": 1,
    "text": "چو بینید دانید گفتار راست"
  },
  {
    "poem_id": 1898,
    "vorder": 161,
    "position": 0,
    "text": "برآمد برین سالیان دراز"
  },
  {
    "poem_id": 1898,
    "vorder": 162,
    "position": 1,
    "text": "سزد گر فرستد بما شاه باز"
  },
  {
    "poem_id": 1898,
    "vorder": 163,
    "position": 0,
    "text": "بدین آرزو شهریار جهان"
  },
  {
    "poem_id": 1898,
    "vorder": 164,
    "position": 1,
    "text": "ببخشاید از ما کهان و مهان"
  },
  {
    "poem_id": 1898,
    "vorder": 165,
    "position": 0,
    "text": "ز گیتی برو بر کنند آفرین"
  },
  {
    "poem_id": 1898,
    "vorder": 166,
    "position": 1,
    "text": "که بی تو مبادا زمان و زمین"
  },
  {
    "poem_id": 1898,
    "vorder": 167,
    "position": 0,
    "text": "بدان من ز خسرو پذیرم سپاس"
  },
  {
    "poem_id": 1898,
    "vorder": 168,
    "position": 1,
    "text": "نیایش کنم روز و شب در سه پاس"
  },
  {
    "poem_id": 1898,
    "vorder": 169,
    "position": 0,
    "text": "همان هدیه و باژ و ساوی که من"
  },
  {
    "poem_id": 1898,
    "vorder": 170,
    "position": 1,
    "text": "فرستم به نزدیک آن انجمن"
  },
  {
    "poem_id": 1898,
    "vorder": 171,
    "position": 0,
    "text": "پذیرد پذیرم سپاسی بدان"
  },
  {
    "poem_id": 1898,
    "vorder": 172,
    "position": 1,
    "text": "مبیناد چشم تو روی بدان"
  },
  {
    "poem_id": 1898,
    "vorder": 173,
    "position": 0,
    "text": "شود فرخ این جشن و آیین ما"
  },
  {
    "poem_id": 1898,
    "vorder": 174,
    "position": 1,
    "text": "درخشان شود در جهان دین ما"
  },
  {
    "poem_id": 1898,
    "vorder": 175,
    "position": 0,
    "text": "همان روزهٔ پاک یکشنبدی"
  },
  {
    "poem_id": 1898,
    "vorder": 176,
    "position": 1,
    "text": "ز هر در پرستندهٔ ایزدی"
  },
  {
    "poem_id": 1898,
    "vorder": 177,
    "position": 0,
    "text": "برو سوکواران بمالند روی"
  },
  {
    "poem_id": 1898,
    "vorder": 178,
    "position": 1,
    "text": "بروبر فراوان بسایند موی"
  },
  {
    "poem_id": 1898,
    "vorder": 179,
    "position": 0,
    "text": "شود آن زمان بر دل ما درست"
  },
  {
    "poem_id": 1898,
    "vorder": 180,
    "position": 1,
    "text": "که از کینه دلها بخواهیم شست"
  },
  {
    "poem_id": 1898,
    "vorder": 181,
    "position": 0,
    "text": "که بود از گه آفریدون فراز"
  },
  {
    "poem_id": 1898,
    "vorder": 182,
    "position": 1,
    "text": "که با تور و سلم اندر آمد براز"
  },
  {
    "poem_id": 1898,
    "vorder": 183,
    "position": 0,
    "text": "شود کشور آسوده از تاختن"
  },
  {
    "poem_id": 1898,
    "vorder": 184,
    "position": 1,
    "text": "به هر گوشه‌ای کینه ها ساختن"
  },
  {
    "poem_id": 1898,
    "vorder": 185,
    "position": 0,
    "text": "زن و کودک رومیان برده‌اند"
  },
  {
    "poem_id": 1898,
    "vorder": 186,
    "position": 1,
    "text": "دل ما ز هر گونه آزرده‌اند"
  },
  {
    "poem_id": 1898,
    "vorder": 187,
    "position": 0,
    "text": "برین خویشی ما جهان رام گشت"
  },
  {
    "poem_id": 1898,
    "vorder": 188,
    "position": 1,
    "text": "همه کار بیهوده پدرام گشت"
  },
  {
    "poem_id": 1898,
    "vorder": 189,
    "position": 0,
    "text": "درود جهان آفرین بر تو باد"
  },
  {
    "poem_id": 1898,
    "vorder": 190,
    "position": 1,
    "text": "همان آفرین زمین بر تو باد"
  },
  {
    "poem_id": 1898,
    "vorder": 191,
    "position": 0,
    "text": "چو آن نامهٔ قیصر آمد ببن"
  },
  {
    "poem_id": 1898,
    "vorder": 192,
    "position": 1,
    "text": "جهاندار بشنید چندان سخن"
  },
  {
    "poem_id": 1898,
    "vorder": 193,
    "position": 0,
    "text": "ازان نامه شد شاه خرم نهان"
  },
  {
    "poem_id": 1898,
    "vorder": 194,
    "position": 1,
    "text": "برو تازه شد روزگار مهان"
  },
  {
    "poem_id": 1898,
    "vorder": 195,
    "position": 0,
    "text": "بسی آفرین کرد برخانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 196,
    "position": 1,
    "text": "بدو گفت بس کن ز بیگانگی"
  },
  {
    "poem_id": 1898,
    "vorder": 197,
    "position": 0,
    "text": "گرانمایه را جایگه ساختند"
  },
  {
    "poem_id": 1898,
    "vorder": 198,
    "position": 1,
    "text": "دو ایوان فرخ بپرداختند"
  },
  {
    "poem_id": 1898,
    "vorder": 199,
    "position": 0,
    "text": "ببردند چیزی که بایست برد"
  },
  {
    "poem_id": 1898,
    "vorder": 200,
    "position": 1,
    "text": "به نزدیک آن مرد بیدار گرد"
  },
  {
    "poem_id": 1898,
    "vorder": 201,
    "position": 0,
    "text": "بیامد بدید آن گزین جایگاه"
  },
  {
    "poem_id": 1898,
    "vorder": 202,
    "position": 1,
    "text": "وزان پس همی‌بود نزدیک شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 203,
    "position": 0,
    "text": "بخوان و نبید و شکار و نشست"
  },
  {
    "poem_id": 1898,
    "vorder": 204,
    "position": 1,
    "text": "همی‌بود با شاه مهتر پرست"
  },
  {
    "poem_id": 1898,
    "vorder": 205,
    "position": 0,
    "text": "برین گونه یک ماه نزدیک شاه"
  },
  {
    "poem_id": 1898,
    "vorder": 206,
    "position": 1,
    "text": "همی‌بود شادان دل و نیک خواه"
  }
]