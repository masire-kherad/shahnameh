[
  {
    "poem_id": 1400,
    "vorder": 1,
    "position": 0,
    "text": "همی راند دستان گرفته شتاب"
  },
  {
    "poem_id": 1400,
    "vorder": 2,
    "position": 1,
    "text": "چو پرنده مرغ و چو کشتی برآب"
  },
  {
    "poem_id": 1400,
    "vorder": 3,
    "position": 0,
    "text": "کسی را نبد ز آمدنش آگهی"
  },
  {
    "poem_id": 1400,
    "vorder": 4,
    "position": 1,
    "text": "پذیره نرفتند با فرهی"
  },
  {
    "poem_id": 1400,
    "vorder": 5,
    "position": 0,
    "text": "خروشی برآمد ز پرده سرای"
  },
  {
    "poem_id": 1400,
    "vorder": 6,
    "position": 1,
    "text": "که آمد ز ره زال فرخنده‌رای"
  },
  {
    "poem_id": 1400,
    "vorder": 7,
    "position": 0,
    "text": "پذیره شدش سام یل شادمان"
  },
  {
    "poem_id": 1400,
    "vorder": 8,
    "position": 1,
    "text": "همی داشت اندر برش یک زمان"
  },
  {
    "poem_id": 1400,
    "vorder": 9,
    "position": 0,
    "text": "فرود آمد از باره بوسید خاک"
  },
  {
    "poem_id": 1400,
    "vorder": 10,
    "position": 1,
    "text": "بگفت آن کجا دید و بشنید پاک"
  },
  {
    "poem_id": 1400,
    "vorder": 11,
    "position": 0,
    "text": "نشست از بر تخت پرمایه سام"
  },
  {
    "poem_id": 1400,
    "vorder": 12,
    "position": 1,
    "text": "ابا زال خرم دل و شادکام"
  },
  {
    "poem_id": 1400,
    "vorder": 13,
    "position": 0,
    "text": "سخنهای سیندخت گفتن گرفت"
  },
  {
    "poem_id": 1400,
    "vorder": 14,
    "position": 1,
    "text": "لبش گشت خندان نهفتن گرفت"
  },
  {
    "poem_id": 1400,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت کامد ز کابل پیام"
  },
  {
    "poem_id": 1400,
    "vorder": 16,
    "position": 1,
    "text": "پیمبر زنی بود سیندخت نام"
  },
  {
    "poem_id": 1400,
    "vorder": 17,
    "position": 0,
    "text": "ز من خواست پیمان و دادم زمان"
  },
  {
    "poem_id": 1400,
    "vorder": 18,
    "position": 1,
    "text": "که هرگز نباشم بدو بدگمان"
  },
  {
    "poem_id": 1400,
    "vorder": 19,
    "position": 0,
    "text": "ز هر چیز کز من به خوبی بخواست"
  },
  {
    "poem_id": 1400,
    "vorder": 20,
    "position": 1,
    "text": "سخنها بران برنهادیم راست"
  },
  {
    "poem_id": 1400,
    "vorder": 21,
    "position": 0,
    "text": "نخست آنکه با ماه کابلستان"
  },
  {
    "poem_id": 1400,
    "vorder": 22,
    "position": 1,
    "text": "شود جفت خورشید زابلستان"
  },
  {
    "poem_id": 1400,
    "vorder": 23,
    "position": 0,
    "text": "دگر آنکه زی او به مهمان شویم"
  },
  {
    "poem_id": 1400,
    "vorder": 24,
    "position": 1,
    "text": "بران دردها پاک درمان شویم"
  },
  {
    "poem_id": 1400,
    "vorder": 25,
    "position": 0,
    "text": "فرستاده‌ای آمد از نزد اوی"
  },
  {
    "poem_id": 1400,
    "vorder": 26,
    "position": 1,
    "text": "که پردخته شد کار بنمای روی"
  },
  {
    "poem_id": 1400,
    "vorder": 27,
    "position": 0,
    "text": "کنون چیست پاسخ فرستاده را"
  },
  {
    "poem_id": 1400,
    "vorder": 28,
    "position": 1,
    "text": "چه گوییم مهراب آزاده را"
  },
  {
    "poem_id": 1400,
    "vorder": 29,
    "position": 0,
    "text": "ز شادی چنان شد دل زال سام"
  },
  {
    "poem_id": 1400,
    "vorder": 30,
    "position": 1,
    "text": "که رنگش سراپای شد لعل فام"
  },
  {
    "poem_id": 1400,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد پاسخ که ای پهلوان"
  },
  {
    "poem_id": 1400,
    "vorder": 32,
    "position": 1,
    "text": "گر ایدون که بینی به روشن روان"
  },
  {
    "poem_id": 1400,
    "vorder": 33,
    "position": 0,
    "text": "سپه رانی و ما به کابل شویم"
  },
  {
    "poem_id": 1400,
    "vorder": 34,
    "position": 1,
    "text": "بگوییم زین در سخن بشنویم"
  },
  {
    "poem_id": 1400,
    "vorder": 35,
    "position": 0,
    "text": "به دستان نگه کرد فرخنده سام"
  },
  {
    "poem_id": 1400,
    "vorder": 36,
    "position": 1,
    "text": "بدانست کورا ازین چیست کام"
  },
  {
    "poem_id": 1400,
    "vorder": 37,
    "position": 0,
    "text": "سخن هر چه از دخت مهراب نیست"
  },
  {
    "poem_id": 1400,
    "vorder": 38,
    "position": 1,
    "text": "به نزدیک زال آن جز از خواب نیست"
  },
  {
    "poem_id": 1400,
    "vorder": 39,
    "position": 0,
    "text": "بفرمود تا زنگ و هندی درای"
  },
  {
    "poem_id": 1400,
    "vorder": 40,
    "position": 1,
    "text": "زدند و گشادند پرده سرای"
  },
  {
    "poem_id": 1400,
    "vorder": 41,
    "position": 0,
    "text": "هیونی برافگند مرد دلیر"
  },
  {
    "poem_id": 1400,
    "vorder": 42,
    "position": 1,
    "text": "بدان تا شود نزد مهراب شیر"
  },
  {
    "poem_id": 1400,
    "vorder": 43,
    "position": 0,
    "text": "بگوید که آمد سپهبد ز راه"
  },
  {
    "poem_id": 1400,
    "vorder": 44,
    "position": 1,
    "text": "ابا زال با پیل و چندی سپاه"
  },
  {
    "poem_id": 1400,
    "vorder": 45,
    "position": 0,
    "text": "فرستاده تازان به کابل رسید"
  },
  {
    "poem_id": 1400,
    "vorder": 46,
    "position": 1,
    "text": "خروشی برآمد چنان چون سزید"
  },
  {
    "poem_id": 1400,
    "vorder": 47,
    "position": 0,
    "text": "چنان شاد شد شاه کابلستان"
  },
  {
    "poem_id": 1400,
    "vorder": 48,
    "position": 1,
    "text": "ز پیوند خورشید زابلستان"
  },
  {
    "poem_id": 1400,
    "vorder": 49,
    "position": 0,
    "text": "که گفتی همی جان برافشاندند"
  },
  {
    "poem_id": 1400,
    "vorder": 50,
    "position": 1,
    "text": "ز هر جای رامشگران خواندند"
  }
]