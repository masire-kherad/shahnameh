[
  {
    "poem_id": 1722,
    "vorder": 1,
    "position": 0,
    "text": "چو شاپور بنشست بر تخت داد"
  },
  {
    "poem_id": 1722,
    "vorder": 2,
    "position": 1,
    "text": "کلاه دلفروز بر سر نهاد"
  },
  {
    "poem_id": 1722,
    "vorder": 3,
    "position": 0,
    "text": "شدند انجمن پیش او بخردان"
  },
  {
    "poem_id": 1722,
    "vorder": 4,
    "position": 1,
    "text": "بزرگان فرزانه و موبدان"
  },
  {
    "poem_id": 1722,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کای نامدار انجمن"
  },
  {
    "poem_id": 1722,
    "vorder": 6,
    "position": 1,
    "text": "بزرگان پردانش و رای‌زن"
  },
  {
    "poem_id": 1722,
    "vorder": 7,
    "position": 0,
    "text": "منم پاک فرزند شاه اردشیر"
  },
  {
    "poem_id": 1722,
    "vorder": 8,
    "position": 1,
    "text": "سرایندهٔ دانش و یادگیر"
  },
  {
    "poem_id": 1722,
    "vorder": 9,
    "position": 0,
    "text": "همه گوش دارید فرمان من"
  },
  {
    "poem_id": 1722,
    "vorder": 10,
    "position": 1,
    "text": "مگردید یکسر ز پیمان من"
  },
  {
    "poem_id": 1722,
    "vorder": 11,
    "position": 0,
    "text": "وزین هرچ گویم پژوهش کنید"
  },
  {
    "poem_id": 1722,
    "vorder": 12,
    "position": 1,
    "text": "وگر خام گویم نکوهش کنید"
  },
  {
    "poem_id": 1722,
    "vorder": 13,
    "position": 0,
    "text": "چو من دیدم اکنون به سود و زیان"
  },
  {
    "poem_id": 1722,
    "vorder": 14,
    "position": 1,
    "text": "دو بخشش نهاده شد اندر میان"
  },
  {
    "poem_id": 1722,
    "vorder": 15,
    "position": 0,
    "text": "یکی پادشا پاسبان جهان"
  },
  {
    "poem_id": 1722,
    "vorder": 16,
    "position": 1,
    "text": "نگهبان گنج کهان و مهان"
  },
  {
    "poem_id": 1722,
    "vorder": 17,
    "position": 0,
    "text": "وگر شاه با داد و فرخ پیست"
  },
  {
    "poem_id": 1722,
    "vorder": 18,
    "position": 1,
    "text": "خرد بی‌گمان پاسبان ویست"
  },
  {
    "poem_id": 1722,
    "vorder": 19,
    "position": 0,
    "text": "خرد پاسبان باشد و نیک‌خواه"
  },
  {
    "poem_id": 1722,
    "vorder": 20,
    "position": 1,
    "text": "سرش برگذارد ز ابر سیاه"
  },
  {
    "poem_id": 1722,
    "vorder": 21,
    "position": 0,
    "text": "همه جستنش داد و دانش بود"
  },
  {
    "poem_id": 1722,
    "vorder": 22,
    "position": 1,
    "text": "ز دانش روانش به رامش بود"
  },
  {
    "poem_id": 1722,
    "vorder": 23,
    "position": 0,
    "text": "دگر آنک او بآزمون خرد"
  },
  {
    "poem_id": 1722,
    "vorder": 24,
    "position": 1,
    "text": "بکوشد بمردی و گرد آورد"
  },
  {
    "poem_id": 1722,
    "vorder": 25,
    "position": 0,
    "text": "به دانش ز یزدان شناسد سپاس"
  },
  {
    "poem_id": 1722,
    "vorder": 26,
    "position": 1,
    "text": "خنک مرد دانا و یزدان‌شناس"
  },
  {
    "poem_id": 1722,
    "vorder": 27,
    "position": 0,
    "text": "به شاهی خردمند باشد سزا"
  },
  {
    "poem_id": 1722,
    "vorder": 28,
    "position": 1,
    "text": "به جای خرد زر شود بی‌بها"
  },
  {
    "poem_id": 1722,
    "vorder": 29,
    "position": 0,
    "text": "توانگر شود هرک خشنود گشت"
  },
  {
    "poem_id": 1722,
    "vorder": 30,
    "position": 1,
    "text": "دل آرزو خانهٔ دود گشت"
  },
  {
    "poem_id": 1722,
    "vorder": 31,
    "position": 0,
    "text": "کرا آرزو بیش تیمار بیش"
  },
  {
    "poem_id": 1722,
    "vorder": 32,
    "position": 1,
    "text": "بکوش ونیوش و منه آز پیش"
  },
  {
    "poem_id": 1722,
    "vorder": 33,
    "position": 0,
    "text": "به آسایش و نیک‌نامی گرای"
  },
  {
    "poem_id": 1722,
    "vorder": 34,
    "position": 1,
    "text": "گریزان شو از مرد ناپاک رای"
  },
  {
    "poem_id": 1722,
    "vorder": 35,
    "position": 0,
    "text": "به چیز کسان دست یازد کسی"
  },
  {
    "poem_id": 1722,
    "vorder": 36,
    "position": 1,
    "text": "که فرهنگ بهرش نباشد بسی"
  },
  {
    "poem_id": 1722,
    "vorder": 37,
    "position": 0,
    "text": "مرا بر شما زان فزونست مهر"
  },
  {
    "poem_id": 1722,
    "vorder": 38,
    "position": 1,
    "text": "که اختر نماید همی بر سپهر"
  },
  {
    "poem_id": 1722,
    "vorder": 39,
    "position": 0,
    "text": "همان رسم شاه بلند اردشیر"
  },
  {
    "poem_id": 1722,
    "vorder": 40,
    "position": 1,
    "text": "بجای آورم با شما ناگزیر"
  },
  {
    "poem_id": 1722,
    "vorder": 41,
    "position": 0,
    "text": "ز دهقان نخواهم جز از سی یکی"
  },
  {
    "poem_id": 1722,
    "vorder": 42,
    "position": 1,
    "text": "درم تا به لشکر دهم اندکی"
  },
  {
    "poem_id": 1722,
    "vorder": 43,
    "position": 0,
    "text": "مرا خوبی و گنج آباد هست"
  },
  {
    "poem_id": 1722,
    "vorder": 44,
    "position": 1,
    "text": "دلیری و مردی و بنیاد هست"
  },
  {
    "poem_id": 1722,
    "vorder": 45,
    "position": 0,
    "text": "ز چیز کسان بی‌نیازیم نیز"
  },
  {
    "poem_id": 1722,
    "vorder": 46,
    "position": 1,
    "text": "که دشمن شود مردم از بهر چیز"
  },
  {
    "poem_id": 1722,
    "vorder": 47,
    "position": 0,
    "text": "بر ما شما را گشتاده‌ست راه"
  },
  {
    "poem_id": 1722,
    "vorder": 48,
    "position": 1,
    "text": "به مهریم با مردم نیک‌خواه"
  },
  {
    "poem_id": 1722,
    "vorder": 49,
    "position": 0,
    "text": "بهر سو فرستیم کارآگهان"
  },
  {
    "poem_id": 1722,
    "vorder": 50,
    "position": 1,
    "text": "بجوییم بیدار کار جهان"
  },
  {
    "poem_id": 1722,
    "vorder": 51,
    "position": 0,
    "text": "نخواهیم هرگز به جز آفرین"
  },
  {
    "poem_id": 1722,
    "vorder": 52,
    "position": 1,
    "text": "که بر ما کنند از جهان‌آفرین"
  },
  {
    "poem_id": 1722,
    "vorder": 53,
    "position": 0,
    "text": "مهان و کهان پاک برخاستند"
  },
  {
    "poem_id": 1722,
    "vorder": 54,
    "position": 1,
    "text": "زبان را به خوبی بیاراستند"
  },
  {
    "poem_id": 1722,
    "vorder": 55,
    "position": 0,
    "text": "به شاپور بر آفرین خواندند"
  },
  {
    "poem_id": 1722,
    "vorder": 56,
    "position": 1,
    "text": "زبرجد به تاجش برافشاندند"
  },
  {
    "poem_id": 1722,
    "vorder": 57,
    "position": 0,
    "text": "همی تازه شد رسم شاه اردشیر"
  },
  {
    "poem_id": 1722,
    "vorder": 58,
    "position": 1,
    "text": "بدو شاد گشتند برنا و پیر"
  }
]