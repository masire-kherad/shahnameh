[
  {
    "poem_id": 1580,
    "vorder": 1,
    "position": 0,
    "text": "به شبگیر هنگام بانگ خروس"
  },
  {
    "poem_id": 1580,
    "vorder": 2,
    "position": 1,
    "text": "ز درگاه برخاست آوای کوس"
  },
  {
    "poem_id": 1580,
    "vorder": 3,
    "position": 0,
    "text": "چو پیلی به اسپ اندر آورد پای"
  },
  {
    "poem_id": 1580,
    "vorder": 4,
    "position": 1,
    "text": "بیاورد چون باد لشکر ز جای"
  },
  {
    "poem_id": 1580,
    "vorder": 5,
    "position": 0,
    "text": "همی رفت تا پیشش آمد دو راه"
  },
  {
    "poem_id": 1580,
    "vorder": 6,
    "position": 1,
    "text": "فرو ماند بر جای پیل و سپاه"
  },
  {
    "poem_id": 1580,
    "vorder": 7,
    "position": 0,
    "text": "دژ گنبدان بود راهش یکی"
  },
  {
    "poem_id": 1580,
    "vorder": 8,
    "position": 1,
    "text": "دگر سوی زاول کشید اندکی"
  },
  {
    "poem_id": 1580,
    "vorder": 9,
    "position": 0,
    "text": "شتر انک در پیش بودش بخفت"
  },
  {
    "poem_id": 1580,
    "vorder": 10,
    "position": 1,
    "text": "تو گفتی که گشتست با خاک جفت"
  },
  {
    "poem_id": 1580,
    "vorder": 11,
    "position": 0,
    "text": "همی چوب زد بر سرش ساروان"
  },
  {
    "poem_id": 1580,
    "vorder": 12,
    "position": 1,
    "text": "ز رفتن بماند آن زمان کاروان"
  },
  {
    "poem_id": 1580,
    "vorder": 13,
    "position": 0,
    "text": "جهان‌جوی را آن بد آمد به فال"
  },
  {
    "poem_id": 1580,
    "vorder": 14,
    "position": 1,
    "text": "بفرمود کش سر ببرند و یال"
  },
  {
    "poem_id": 1580,
    "vorder": 15,
    "position": 0,
    "text": "بدان تا بدو بازگردد بدی"
  },
  {
    "poem_id": 1580,
    "vorder": 16,
    "position": 1,
    "text": "نباشد به جز فره ایزدی"
  },
  {
    "poem_id": 1580,
    "vorder": 17,
    "position": 0,
    "text": "بریدند پرخاشجویان سرش"
  },
  {
    "poem_id": 1580,
    "vorder": 18,
    "position": 1,
    "text": "بدو بازگشت آن زمان اخترش"
  },
  {
    "poem_id": 1580,
    "vorder": 19,
    "position": 0,
    "text": "غمی گشت زان اشتر اسفندیار"
  },
  {
    "poem_id": 1580,
    "vorder": 20,
    "position": 1,
    "text": "گرفت آن زمان اختر شوم خوار"
  },
  {
    "poem_id": 1580,
    "vorder": 21,
    "position": 0,
    "text": "چنین گفت کآن کس که پیروز گشت"
  },
  {
    "poem_id": 1580,
    "vorder": 22,
    "position": 1,
    "text": "سر بخت او گیتی افروز گشت"
  },
  {
    "poem_id": 1580,
    "vorder": 23,
    "position": 0,
    "text": "بد و نیک هر دو ز یزدان بود"
  },
  {
    "poem_id": 1580,
    "vorder": 24,
    "position": 1,
    "text": "لب مرد باید که خندان بود"
  },
  {
    "poem_id": 1580,
    "vorder": 25,
    "position": 0,
    "text": "وزانجا بیامد سوی هیرمند"
  },
  {
    "poem_id": 1580,
    "vorder": 26,
    "position": 1,
    "text": "همی بود ترسان ز بیم گزند"
  },
  {
    "poem_id": 1580,
    "vorder": 27,
    "position": 0,
    "text": "بر آیین ببستند پرده‌سرای"
  },
  {
    "poem_id": 1580,
    "vorder": 28,
    "position": 1,
    "text": "بزرگان لشگر گزیدند جای"
  },
  {
    "poem_id": 1580,
    "vorder": 29,
    "position": 0,
    "text": "شراعی بزد زود و بنهاد تخت"
  },
  {
    "poem_id": 1580,
    "vorder": 30,
    "position": 1,
    "text": "بر آن تخت بر شد گو نیک‌بخت"
  },
  {
    "poem_id": 1580,
    "vorder": 31,
    "position": 0,
    "text": "می آورد و رامشگران را بخواند"
  },
  {
    "poem_id": 1580,
    "vorder": 32,
    "position": 1,
    "text": "بسی زر و گوهر بر ایشان فشاند"
  },
  {
    "poem_id": 1580,
    "vorder": 33,
    "position": 0,
    "text": "به رامش دل خویشتن شاد کرد"
  },
  {
    "poem_id": 1580,
    "vorder": 34,
    "position": 1,
    "text": "دل راد مردان پر از یاد کرد"
  },
  {
    "poem_id": 1580,
    "vorder": 35,
    "position": 0,
    "text": "چو گل بشکفید از می سالخورد"
  },
  {
    "poem_id": 1580,
    "vorder": 36,
    "position": 1,
    "text": "رخ نامداران و شاه نبرد"
  },
  {
    "poem_id": 1580,
    "vorder": 37,
    "position": 0,
    "text": "به یاران چنین گفت کز رای شاه"
  },
  {
    "poem_id": 1580,
    "vorder": 38,
    "position": 1,
    "text": "نپیچیدم و دور گشتم ز راه"
  },
  {
    "poem_id": 1580,
    "vorder": 39,
    "position": 0,
    "text": "مرا گفت بر کار رستم بسیچ"
  },
  {
    "poem_id": 1580,
    "vorder": 40,
    "position": 1,
    "text": "ز بند و ز خواری میاسای هیچ"
  },
  {
    "poem_id": 1580,
    "vorder": 41,
    "position": 0,
    "text": "به کردن برفتم برای پدر"
  },
  {
    "poem_id": 1580,
    "vorder": 42,
    "position": 1,
    "text": "کنون این گزین پیر پرخاشخر"
  },
  {
    "poem_id": 1580,
    "vorder": 43,
    "position": 0,
    "text": "بسی رنج دارد به جای سران"
  },
  {
    "poem_id": 1580,
    "vorder": 44,
    "position": 1,
    "text": "جهان راست کرده به گرز گران"
  },
  {
    "poem_id": 1580,
    "vorder": 45,
    "position": 0,
    "text": "همه شهر ایران بدو زنده‌اند"
  },
  {
    "poem_id": 1580,
    "vorder": 46,
    "position": 1,
    "text": "اگر شهریارند و گر بنده‌اند"
  },
  {
    "poem_id": 1580,
    "vorder": 47,
    "position": 0,
    "text": "فرستاده باید یکی تیزویر"
  },
  {
    "poem_id": 1580,
    "vorder": 48,
    "position": 1,
    "text": "سخن‌گوی و داننده و یادگیر"
  },
  {
    "poem_id": 1580,
    "vorder": 49,
    "position": 0,
    "text": "سواری که باشد ورا فر و زیب"
  },
  {
    "poem_id": 1580,
    "vorder": 50,
    "position": 1,
    "text": "نگیرد ورا رستم اندر فریب"
  },
  {
    "poem_id": 1580,
    "vorder": 51,
    "position": 0,
    "text": "گر ایدون که آید به نزدیک ما"
  },
  {
    "poem_id": 1580,
    "vorder": 52,
    "position": 1,
    "text": "درفشان کند رای تاریک ما"
  },
  {
    "poem_id": 1580,
    "vorder": 53,
    "position": 0,
    "text": "به خوبی دهد دست بند مرا"
  },
  {
    "poem_id": 1580,
    "vorder": 54,
    "position": 1,
    "text": "به دانش ببندد گزند مرا"
  },
  {
    "poem_id": 1580,
    "vorder": 55,
    "position": 0,
    "text": "نخواهم من او را به جز نیکویی"
  },
  {
    "poem_id": 1580,
    "vorder": 56,
    "position": 1,
    "text": "اگر دور دارد سر از بدخویی"
  },
  {
    "poem_id": 1580,
    "vorder": 57,
    "position": 0,
    "text": "پشوتن بدو گفت اینست راه"
  },
  {
    "poem_id": 1580,
    "vorder": 58,
    "position": 1,
    "text": "بر این باش و آزرم مردان بخواه"
  }
]