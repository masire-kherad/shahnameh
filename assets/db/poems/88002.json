[
  {
    "poem_id": 88002,
    "vorder": 1,
    "position": 0,
    "text": "نگه کرد خاقان ازان پشت پیل"
  },
  {
    "poem_id": 88002,
    "vorder": 2,
    "position": 1,
    "text": "زمین دید برسان دریای نیل"
  },
  {
    "poem_id": 88002,
    "vorder": 3,
    "position": 0,
    "text": "یکی پیل بر پشت کوه بلند"
  },
  {
    "poem_id": 88002,
    "vorder": 4,
    "position": 1,
    "text": "ورا نام بد رستم دیو بند"
  },
  {
    "poem_id": 88002,
    "vorder": 5,
    "position": 0,
    "text": "همی کرگس آورد ز ابر سیاه"
  },
  {
    "poem_id": 88002,
    "vorder": 6,
    "position": 1,
    "text": "نظاره بران اختر و چرخ ماه"
  },
  {
    "poem_id": 88002,
    "vorder": 7,
    "position": 0,
    "text": "یکی نامداری ز لشکر بجست"
  },
  {
    "poem_id": 88002,
    "vorder": 8,
    "position": 1,
    "text": "که گفتار ایران بداند درست"
  },
  {
    "poem_id": 88002,
    "vorder": 9,
    "position": 0,
    "text": "بدو گفت رو پیش آن شیر مرد"
  },
  {
    "poem_id": 88002,
    "vorder": 10,
    "position": 1,
    "text": "بگویش که تندی مکن در نبرد"
  },
  {
    "poem_id": 88002,
    "vorder": 11,
    "position": 0,
    "text": "چغانی و شگنی و چینی و وهر"
  },
  {
    "poem_id": 88002,
    "vorder": 12,
    "position": 1,
    "text": "کزین کینه هرگز ندارند بهر"
  },
  {
    "poem_id": 88002,
    "vorder": 13,
    "position": 0,
    "text": "یکی شاه ختلان یکی شاه چین"
  },
  {
    "poem_id": 88002,
    "vorder": 14,
    "position": 1,
    "text": "ز بیگانه مردم ترا نیست کین"
  },
  {
    "poem_id": 88002,
    "vorder": 15,
    "position": 0,
    "text": "یکی شهریارست افراسیاب"
  },
  {
    "poem_id": 88002,
    "vorder": 16,
    "position": 1,
    "text": "که آتش همی بد شناسد ز آب"
  },
  {
    "poem_id": 88002,
    "vorder": 17,
    "position": 0,
    "text": "جهانی بدین گونه کرد انجمن"
  },
  {
    "poem_id": 88002,
    "vorder": 18,
    "position": 1,
    "text": "بد آورد ازین رزم بر خویشتن"
  },
  {
    "poem_id": 88002,
    "vorder": 19,
    "position": 0,
    "text": "کسی نیست بی‌آز و بی نام و ننگ"
  },
  {
    "poem_id": 88002,
    "vorder": 20,
    "position": 1,
    "text": "همان آشتی بهتر آید ز جنگ"
  },
  {
    "poem_id": 88002,
    "vorder": 21,
    "position": 0,
    "text": "فرستاده آمد بر پیلتن"
  },
  {
    "poem_id": 88002,
    "vorder": 22,
    "position": 1,
    "text": "زبان پر ز گفتار و دل پر شکن"
  },
  {
    "poem_id": 88002,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت کای مهتر رزمجوی"
  },
  {
    "poem_id": 88002,
    "vorder": 24,
    "position": 1,
    "text": "چو رزمت سرآمد کنون بزم جوی"
  },
  {
    "poem_id": 88002,
    "vorder": 25,
    "position": 0,
    "text": "نداری همانا ز خاقان چین"
  },
  {
    "poem_id": 88002,
    "vorder": 26,
    "position": 1,
    "text": "ز کار گذشته بدل هیچ کین"
  },
  {
    "poem_id": 88002,
    "vorder": 27,
    "position": 0,
    "text": "چنو باز گردد تو زو باز گرد"
  },
  {
    "poem_id": 88002,
    "vorder": 28,
    "position": 1,
    "text": "که اکنون سپه را سرآمد نبرد"
  },
  {
    "poem_id": 88002,
    "vorder": 29,
    "position": 0,
    "text": "چو کاموس بر دست تو کشته شد"
  },
  {
    "poem_id": 88002,
    "vorder": 30,
    "position": 1,
    "text": "سر رزمجویان همه گشته شد"
  },
  {
    "poem_id": 88002,
    "vorder": 31,
    "position": 0,
    "text": "چنین داد پاسخ که پیلان و تاج"
  },
  {
    "poem_id": 88002,
    "vorder": 32,
    "position": 1,
    "text": "بنزدیک من باید و تخت عاج"
  },
  {
    "poem_id": 88002,
    "vorder": 33,
    "position": 0,
    "text": "بتاراج ایران نهادست روی"
  },
  {
    "poem_id": 88002,
    "vorder": 34,
    "position": 1,
    "text": "چه باید کنون لابه و گفت و گوی"
  },
  {
    "poem_id": 88002,
    "vorder": 35,
    "position": 0,
    "text": "چو داند که لشکر بجنگ آمدست"
  },
  {
    "poem_id": 88002,
    "vorder": 36,
    "position": 1,
    "text": "شتاب سپاه از درنگ آمدست"
  },
  {
    "poem_id": 88002,
    "vorder": 37,
    "position": 0,
    "text": "فرستاده گفت ای خداوند رخش"
  },
  {
    "poem_id": 88002,
    "vorder": 38,
    "position": 1,
    "text": "بدشت آهوی ناگرفته مبخش"
  },
  {
    "poem_id": 88002,
    "vorder": 39,
    "position": 0,
    "text": "که داند که خود چون بود روزگار"
  },
  {
    "poem_id": 88002,
    "vorder": 40,
    "position": 1,
    "text": "که پیروز برگردد از کارزار"
  },
  {
    "poem_id": 88002,
    "vorder": 41,
    "position": 0,
    "text": "چو بشنید رستم برانگیخت رخش"
  },
  {
    "poem_id": 88002,
    "vorder": 42,
    "position": 1,
    "text": "منم گفت شیراوژن تاج‌بخش"
  },
  {
    "poem_id": 88002,
    "vorder": 43,
    "position": 0,
    "text": "تنی زورمند و ببازو کمند"
  },
  {
    "poem_id": 88002,
    "vorder": 44,
    "position": 1,
    "text": "چه روز فریبست و هنگام بند"
  },
  {
    "poem_id": 88002,
    "vorder": 45,
    "position": 0,
    "text": "چه خاقان چینی کمند مرا"
  },
  {
    "poem_id": 88002,
    "vorder": 46,
    "position": 1,
    "text": "چه شیر ژیان دست بند مرا"
  }
]