[
  {
    "poem_id": 1657,
    "vorder": 1,
    "position": 0,
    "text": "چو اسکندر آمد به نزدیک فور"
  },
  {
    "poem_id": 1657,
    "vorder": 2,
    "position": 1,
    "text": "بدید آن سپه این سپه را ز دور"
  },
  {
    "poem_id": 1657,
    "vorder": 3,
    "position": 0,
    "text": "خروش آمد و گرد رزم از دو روی"
  },
  {
    "poem_id": 1657,
    "vorder": 4,
    "position": 1,
    "text": "برفتند گردان پرخاشجوی"
  },
  {
    "poem_id": 1657,
    "vorder": 5,
    "position": 0,
    "text": "به اسپ و به نفط آتش اندر زدند"
  },
  {
    "poem_id": 1657,
    "vorder": 6,
    "position": 1,
    "text": "همه لشکر فور برهم زدند"
  },
  {
    "poem_id": 1657,
    "vorder": 7,
    "position": 0,
    "text": "از آتش برافروخت نفط سیاه"
  },
  {
    "poem_id": 1657,
    "vorder": 8,
    "position": 1,
    "text": "بجنبید ازان کاهنین بد سپاه"
  },
  {
    "poem_id": 1657,
    "vorder": 9,
    "position": 0,
    "text": "چو پیلان بدیدند ز آتش گریز"
  },
  {
    "poem_id": 1657,
    "vorder": 10,
    "position": 1,
    "text": "برفتند با لشکر از جای تیز"
  },
  {
    "poem_id": 1657,
    "vorder": 11,
    "position": 0,
    "text": "ز لشکر برآمد سراسر خروش"
  },
  {
    "poem_id": 1657,
    "vorder": 12,
    "position": 1,
    "text": "به زخم آوریدند پیلان به جوش"
  },
  {
    "poem_id": 1657,
    "vorder": 13,
    "position": 0,
    "text": "چو خرطومهاشان بر آتش گرفت"
  },
  {
    "poem_id": 1657,
    "vorder": 14,
    "position": 1,
    "text": "بماندند زان پیلبانان شگفت"
  },
  {
    "poem_id": 1657,
    "vorder": 15,
    "position": 0,
    "text": "همه لشکر هند گشتند باز"
  },
  {
    "poem_id": 1657,
    "vorder": 16,
    "position": 1,
    "text": "همان ژنده پیلان گردن فراز"
  },
  {
    "poem_id": 1657,
    "vorder": 17,
    "position": 0,
    "text": "سکندر پس لشکر بدگمان"
  },
  {
    "poem_id": 1657,
    "vorder": 18,
    "position": 1,
    "text": "همی تاخت بر سان باددمان"
  },
  {
    "poem_id": 1657,
    "vorder": 19,
    "position": 0,
    "text": "چنین تا هوا نیلگون شد به رنگ"
  },
  {
    "poem_id": 1657,
    "vorder": 20,
    "position": 1,
    "text": "سپه را نماند آن زمان جای جنگ"
  },
  {
    "poem_id": 1657,
    "vorder": 21,
    "position": 0,
    "text": "جهانجوی با رومیان همگروه"
  },
  {
    "poem_id": 1657,
    "vorder": 22,
    "position": 1,
    "text": "فرود آمد اندر میان دو کوه"
  },
  {
    "poem_id": 1657,
    "vorder": 23,
    "position": 0,
    "text": "طلایه فرستاد هر سو به راه"
  },
  {
    "poem_id": 1657,
    "vorder": 24,
    "position": 1,
    "text": "همی داشت لشکر ز دشمن نگاه"
  },
  {
    "poem_id": 1657,
    "vorder": 25,
    "position": 0,
    "text": "چو پیدا شد آن شوشهٔ تاج شید"
  },
  {
    "poem_id": 1657,
    "vorder": 26,
    "position": 1,
    "text": "جهان شد بسان بلور سپید"
  },
  {
    "poem_id": 1657,
    "vorder": 27,
    "position": 0,
    "text": "برآمد خروش از بر گاودم"
  },
  {
    "poem_id": 1657,
    "vorder": 28,
    "position": 1,
    "text": "دم نای سرغین و رویینه خم"
  },
  {
    "poem_id": 1657,
    "vorder": 29,
    "position": 0,
    "text": "سپه با سپه جنگ برساختند"
  },
  {
    "poem_id": 1657,
    "vorder": 30,
    "position": 1,
    "text": "سنانها به ابر اندر افراختند"
  },
  {
    "poem_id": 1657,
    "vorder": 31,
    "position": 0,
    "text": "سکندر بیامد میان دو صف"
  },
  {
    "poem_id": 1657,
    "vorder": 32,
    "position": 1,
    "text": "یکی تیغ رومی گرفته به کف"
  },
  {
    "poem_id": 1657,
    "vorder": 33,
    "position": 0,
    "text": "سواری فرستاد نزدیک فور"
  },
  {
    "poem_id": 1657,
    "vorder": 34,
    "position": 1,
    "text": "که او را بخواند بگوید ز دور"
  },
  {
    "poem_id": 1657,
    "vorder": 35,
    "position": 0,
    "text": "که آمد سکندر به پیش سپاه"
  },
  {
    "poem_id": 1657,
    "vorder": 36,
    "position": 1,
    "text": "به دیدار جوید همی با تو راه"
  },
  {
    "poem_id": 1657,
    "vorder": 37,
    "position": 0,
    "text": "سخن گوید و گفت تو بشنود"
  },
  {
    "poem_id": 1657,
    "vorder": 38,
    "position": 1,
    "text": "اگر دادگویی بدان بگرود"
  },
  {
    "poem_id": 1657,
    "vorder": 39,
    "position": 0,
    "text": "چو بشنید زو فور هندی برفت"
  },
  {
    "poem_id": 1657,
    "vorder": 40,
    "position": 1,
    "text": "به پیش سپاه آمد از قلب تفت"
  },
  {
    "poem_id": 1657,
    "vorder": 41,
    "position": 0,
    "text": "سکندر بدو گفت کای نامدار"
  },
  {
    "poem_id": 1657,
    "vorder": 42,
    "position": 1,
    "text": "دو لشکر شکسته شد از کارزار"
  },
  {
    "poem_id": 1657,
    "vorder": 43,
    "position": 0,
    "text": "همی دام و دد مغز مردم خورد"
  },
  {
    "poem_id": 1657,
    "vorder": 44,
    "position": 1,
    "text": "همی نعل اسپ استخوان بسپرد"
  },
  {
    "poem_id": 1657,
    "vorder": 45,
    "position": 0,
    "text": "دو مردیم هر دو دلیر و جوان"
  },
  {
    "poem_id": 1657,
    "vorder": 46,
    "position": 1,
    "text": "سخن گوی و با مغز دو پهلوان"
  },
  {
    "poem_id": 1657,
    "vorder": 47,
    "position": 0,
    "text": "دلیران لشکر همه کشته‌اند"
  },
  {
    "poem_id": 1657,
    "vorder": 48,
    "position": 1,
    "text": "وگر زنده از رزم برگشته‌اند"
  },
  {
    "poem_id": 1657,
    "vorder": 49,
    "position": 0,
    "text": "چرا بهر لشکر همه کشتن است"
  },
  {
    "poem_id": 1657,
    "vorder": 50,
    "position": 1,
    "text": "وگر زنده از رزم برگشتن است"
  },
  {
    "poem_id": 1657,
    "vorder": 51,
    "position": 0,
    "text": "میان را ببندیم و جنگ آوریم"
  },
  {
    "poem_id": 1657,
    "vorder": 52,
    "position": 1,
    "text": "چو باید که کشور به چنگ آوریم"
  },
  {
    "poem_id": 1657,
    "vorder": 53,
    "position": 0,
    "text": "ز ما هرک او گشت پیروز بخت"
  },
  {
    "poem_id": 1657,
    "vorder": 54,
    "position": 1,
    "text": "بدو ماند این لشکر و تاج و تخت"
  },
  {
    "poem_id": 1657,
    "vorder": 55,
    "position": 0,
    "text": "ز رومی سخنها چو بشنید فور"
  },
  {
    "poem_id": 1657,
    "vorder": 56,
    "position": 1,
    "text": "خریدار شد رزم او را به سور"
  },
  {
    "poem_id": 1657,
    "vorder": 57,
    "position": 0,
    "text": "تن خویش را دید با زور شیر"
  },
  {
    "poem_id": 1657,
    "vorder": 58,
    "position": 1,
    "text": "یکی باره چون اژدهای دلیر"
  },
  {
    "poem_id": 1657,
    "vorder": 59,
    "position": 0,
    "text": "سکندر سواری بسان قلم"
  },
  {
    "poem_id": 1657,
    "vorder": 60,
    "position": 1,
    "text": "سلیحی سبک بادپایی دژم"
  },
  {
    "poem_id": 1657,
    "vorder": 61,
    "position": 0,
    "text": "بدوگفت کاینست آیین و راه"
  },
  {
    "poem_id": 1657,
    "vorder": 62,
    "position": 1,
    "text": "بگردیم یک با دگر بی‌سپاه"
  },
  {
    "poem_id": 1657,
    "vorder": 63,
    "position": 0,
    "text": "دو خنجر گرفتند هر دو به کف"
  },
  {
    "poem_id": 1657,
    "vorder": 64,
    "position": 1,
    "text": "بگشتند چندان میان دو صف"
  },
  {
    "poem_id": 1657,
    "vorder": 65,
    "position": 0,
    "text": "سکندر چو دید آن تن پیل مست"
  },
  {
    "poem_id": 1657,
    "vorder": 66,
    "position": 1,
    "text": "یکی کوه زیر اژدهایی به دست"
  },
  {
    "poem_id": 1657,
    "vorder": 67,
    "position": 0,
    "text": "بآورد ازو ماند اندر شگفت"
  },
  {
    "poem_id": 1657,
    "vorder": 68,
    "position": 1,
    "text": "غمی شد دل از جان خود برگرفت"
  },
  {
    "poem_id": 1657,
    "vorder": 69,
    "position": 0,
    "text": "همی گشت با او به آوردگاه"
  },
  {
    "poem_id": 1657,
    "vorder": 70,
    "position": 1,
    "text": "خروشی برآمد ز پشت سپاه"
  },
  {
    "poem_id": 1657,
    "vorder": 71,
    "position": 0,
    "text": "دل فور پر درد شد زان خروش"
  },
  {
    "poem_id": 1657,
    "vorder": 72,
    "position": 1,
    "text": "بران سو کشیدش دل و چشم و گوش"
  },
  {
    "poem_id": 1657,
    "vorder": 73,
    "position": 0,
    "text": "سکندر چو باد اندر آمد ز گرد"
  },
  {
    "poem_id": 1657,
    "vorder": 74,
    "position": 1,
    "text": "بزد تیغ تیزی بران شیر مرد"
  },
  {
    "poem_id": 1657,
    "vorder": 75,
    "position": 0,
    "text": "ببرید پی بر بر و گردنش"
  },
  {
    "poem_id": 1657,
    "vorder": 76,
    "position": 1,
    "text": "ز بالا به خاک اندر آمد تنش"
  },
  {
    "poem_id": 1657,
    "vorder": 77,
    "position": 0,
    "text": "سر لشکر روم شد به آسمان"
  },
  {
    "poem_id": 1657,
    "vorder": 78,
    "position": 1,
    "text": "برفتند گردان لشکر دمان"
  },
  {
    "poem_id": 1657,
    "vorder": 79,
    "position": 0,
    "text": "یکی کوس بودش ز چرم هژبر"
  },
  {
    "poem_id": 1657,
    "vorder": 80,
    "position": 1,
    "text": "که آواز او برگذشتی ز ابر"
  },
  {
    "poem_id": 1657,
    "vorder": 81,
    "position": 0,
    "text": "برآمد دم بوق و آواس کوس"
  },
  {
    "poem_id": 1657,
    "vorder": 82,
    "position": 1,
    "text": "زمین آهنین شد هوا آبنوس"
  },
  {
    "poem_id": 1657,
    "vorder": 83,
    "position": 0,
    "text": "بران هم نشان هندوان رزمجوی"
  },
  {
    "poem_id": 1657,
    "vorder": 84,
    "position": 1,
    "text": "به تنگی به روی اندر آورده روی"
  },
  {
    "poem_id": 1657,
    "vorder": 85,
    "position": 0,
    "text": "خروش آمد از روم کای دوستان"
  },
  {
    "poem_id": 1657,
    "vorder": 86,
    "position": 1,
    "text": "سر مایهٔ مرز هندوستان"
  },
  {
    "poem_id": 1657,
    "vorder": 87,
    "position": 0,
    "text": "سر فور هندی به خاک اندرست"
  },
  {
    "poem_id": 1657,
    "vorder": 88,
    "position": 1,
    "text": "تن پیلوارش به چاک اندرست"
  },
  {
    "poem_id": 1657,
    "vorder": 89,
    "position": 0,
    "text": "شما را کنون از پی کیست جنگ"
  },
  {
    "poem_id": 1657,
    "vorder": 90,
    "position": 1,
    "text": "چنین زخم شمشیر و چندین درنگ"
  },
  {
    "poem_id": 1657,
    "vorder": 91,
    "position": 0,
    "text": "سکندر شما را چنان شد که فور"
  },
  {
    "poem_id": 1657,
    "vorder": 92,
    "position": 1,
    "text": "ازو جست باید همی رزم و سور"
  },
  {
    "poem_id": 1657,
    "vorder": 93,
    "position": 0,
    "text": "برفتند گردان هندوستان"
  },
  {
    "poem_id": 1657,
    "vorder": 94,
    "position": 1,
    "text": "به آواز گشتند همداستان"
  },
  {
    "poem_id": 1657,
    "vorder": 95,
    "position": 0,
    "text": "تن فور دیدند پر خون و خاک"
  },
  {
    "poem_id": 1657,
    "vorder": 96,
    "position": 1,
    "text": "بر و تنش کرده به شمشیر چاک"
  },
  {
    "poem_id": 1657,
    "vorder": 97,
    "position": 0,
    "text": "خروشی برآمد ز لشکر به زار"
  },
  {
    "poem_id": 1657,
    "vorder": 98,
    "position": 1,
    "text": "فرو ریختند آلت کارزار"
  },
  {
    "poem_id": 1657,
    "vorder": 99,
    "position": 0,
    "text": "پر از درد نزدیک قیصر شدند"
  },
  {
    "poem_id": 1657,
    "vorder": 100,
    "position": 1,
    "text": "پر از ناله و خاک بر سر شدند"
  },
  {
    "poem_id": 1657,
    "vorder": 101,
    "position": 0,
    "text": "سکندر سلیح گوان بازداد"
  },
  {
    "poem_id": 1657,
    "vorder": 102,
    "position": 1,
    "text": "به خوبی ز هرگونه آواز داد"
  },
  {
    "poem_id": 1657,
    "vorder": 103,
    "position": 0,
    "text": "چنین گفت کز هند مردی بمرد"
  },
  {
    "poem_id": 1657,
    "vorder": 104,
    "position": 1,
    "text": "شما را به غم دل نباید سپرد"
  },
  {
    "poem_id": 1657,
    "vorder": 105,
    "position": 0,
    "text": "نوزاش کنون من به افزون کنم"
  },
  {
    "poem_id": 1657,
    "vorder": 106,
    "position": 1,
    "text": "بکوشم که غم نیز بیرون کنم"
  },
  {
    "poem_id": 1657,
    "vorder": 107,
    "position": 0,
    "text": "ببخشم شما را همه گنج اوی"
  },
  {
    "poem_id": 1657,
    "vorder": 108,
    "position": 1,
    "text": "حرامست بر لشکرم رنج اوی"
  },
  {
    "poem_id": 1657,
    "vorder": 109,
    "position": 0,
    "text": "همه هندوان را توانگر کنم"
  },
  {
    "poem_id": 1657,
    "vorder": 110,
    "position": 1,
    "text": "بکوشم که با تخت و افسر کنم"
  },
  {
    "poem_id": 1657,
    "vorder": 111,
    "position": 0,
    "text": "وزان جایگه شد بر تخت فور"
  },
  {
    "poem_id": 1657,
    "vorder": 112,
    "position": 1,
    "text": "بران جشن ماتم برین جشن سور"
  },
  {
    "poem_id": 1657,
    "vorder": 113,
    "position": 0,
    "text": "چنین است رسم سرای سپنج"
  },
  {
    "poem_id": 1657,
    "vorder": 114,
    "position": 1,
    "text": "بخواهد که مانی بدو در به رنج"
  },
  {
    "poem_id": 1657,
    "vorder": 115,
    "position": 0,
    "text": "بخور هرچ داری منه بازپس"
  },
  {
    "poem_id": 1657,
    "vorder": 116,
    "position": 1,
    "text": "تو رنجی چرا ماند باید به کس"
  },
  {
    "poem_id": 1657,
    "vorder": 117,
    "position": 0,
    "text": "همی بود بر تخت قیصر دو ماه"
  },
  {
    "poem_id": 1657,
    "vorder": 118,
    "position": 1,
    "text": "ببخشید گنجش همه بر سپاه"
  },
  {
    "poem_id": 1657,
    "vorder": 119,
    "position": 0,
    "text": "یکی با گهر بود نامش سورگ"
  },
  {
    "poem_id": 1657,
    "vorder": 120,
    "position": 1,
    "text": "ز هندوستان پهلوانی سترگ"
  },
  {
    "poem_id": 1657,
    "vorder": 121,
    "position": 0,
    "text": "سر تخت شاهی بدو داد و گفت"
  },
  {
    "poem_id": 1657,
    "vorder": 122,
    "position": 1,
    "text": "که دینار هرگز مکن در نهفت"
  },
  {
    "poem_id": 1657,
    "vorder": 123,
    "position": 0,
    "text": "ببخش و بخور هرچ آید فراز"
  },
  {
    "poem_id": 1657,
    "vorder": 124,
    "position": 1,
    "text": "بدین تاج و تخت سپنجی مناز"
  },
  {
    "poem_id": 1657,
    "vorder": 125,
    "position": 0,
    "text": "که گاهی سکندر بود گاه فور"
  },
  {
    "poem_id": 1657,
    "vorder": 126,
    "position": 1,
    "text": "گهی درد و خشمست و گه کام و سور"
  },
  {
    "poem_id": 1657,
    "vorder": 127,
    "position": 0,
    "text": "درم داد و دینار لشکرش را"
