[
  {
    "poem_id": 1371,
    "vorder": 1,
    "position": 0,
    "text": "سپه چون به نزدیک ایران کشید"
  },
  {
    "poem_id": 1371,
    "vorder": 2,
    "position": 1,
    "text": "همانگه خبر با فریدون رسید"
  },
  {
    "poem_id": 1371,
    "vorder": 3,
    "position": 0,
    "text": "بفرمود پس تا منوچهر شاه"
  },
  {
    "poem_id": 1371,
    "vorder": 4,
    "position": 1,
    "text": "ز پهلو به هامون گذارد سپاه"
  },
  {
    "poem_id": 1371,
    "vorder": 5,
    "position": 0,
    "text": "یکی داستان زد جهاندیده کی"
  },
  {
    "poem_id": 1371,
    "vorder": 6,
    "position": 1,
    "text": "که مرد جوان چون بود نیک‌پی"
  },
  {
    "poem_id": 1371,
    "vorder": 7,
    "position": 0,
    "text": "بدام آیدش ناسگالیده میش"
  },
  {
    "poem_id": 1371,
    "vorder": 8,
    "position": 1,
    "text": "پلنگ از پس پشت و صیاد پیش"
  },
  {
    "poem_id": 1371,
    "vorder": 9,
    "position": 0,
    "text": "شکیبایی و هوش و رای و خرد"
  },
  {
    "poem_id": 1371,
    "vorder": 10,
    "position": 1,
    "text": "هژبر از بیابان به دام آورد"
  },
  {
    "poem_id": 1371,
    "vorder": 11,
    "position": 0,
    "text": "و دیگر ز بد مردم بد کنش"
  },
  {
    "poem_id": 1371,
    "vorder": 12,
    "position": 1,
    "text": "به فرجام روزی بپیچد تنش"
  },
  {
    "poem_id": 1371,
    "vorder": 13,
    "position": 0,
    "text": "ببادافره آنگه شتابیدمی"
  },
  {
    "poem_id": 1371,
    "vorder": 14,
    "position": 1,
    "text": "که تفسیده آهن بتابیدمی"
  },
  {
    "poem_id": 1371,
    "vorder": 15,
    "position": 0,
    "text": "چو لشکر منوچهر بر ساده دشت"
  },
  {
    "poem_id": 1371,
    "vorder": 16,
    "position": 1,
    "text": "برون برد آنجا ببد روز هشت"
  },
  {
    "poem_id": 1371,
    "vorder": 17,
    "position": 0,
    "text": "فریدونش هنگام رفتن بدید"
  },
  {
    "poem_id": 1371,
    "vorder": 18,
    "position": 1,
    "text": "سخنها به دانش بدو گسترید"
  },
  {
    "poem_id": 1371,
    "vorder": 19,
    "position": 0,
    "text": "منوچهر گفت ای سرافراز شاه"
  },
  {
    "poem_id": 1371,
    "vorder": 20,
    "position": 1,
    "text": "کی آید کسی پیش تو کینه خواه"
  },
  {
    "poem_id": 1371,
    "vorder": 21,
    "position": 0,
    "text": "مگر بد سگالد بدو روزگار"
  },
  {
    "poem_id": 1371,
    "vorder": 22,
    "position": 1,
    "text": "به جان و تن خود خورد زینهار"
  },
  {
    "poem_id": 1371,
    "vorder": 23,
    "position": 0,
    "text": "من اینک میان را به رومی زره"
  },
  {
    "poem_id": 1371,
    "vorder": 24,
    "position": 1,
    "text": "ببندم که نگشایم از تن گره"
  },
  {
    "poem_id": 1371,
    "vorder": 25,
    "position": 0,
    "text": "به کین جستن از دشت آوردگاه"
  },
  {
    "poem_id": 1371,
    "vorder": 26,
    "position": 1,
    "text": "برآرم به خورشید گرد سپاه"
  },
  {
    "poem_id": 1371,
    "vorder": 27,
    "position": 0,
    "text": "ازان انجمن کس ندارم به مرد"
  },
  {
    "poem_id": 1371,
    "vorder": 28,
    "position": 1,
    "text": "کجا جست یارند با من نبرد"
  },
  {
    "poem_id": 1371,
    "vorder": 29,
    "position": 0,
    "text": "بفرمود تا قارن رزم جوی"
  },
  {
    "poem_id": 1371,
    "vorder": 30,
    "position": 1,
    "text": "ز پهلو به دشت اندر آورد روی"
  },
  {
    "poem_id": 1371,
    "vorder": 31,
    "position": 0,
    "text": "سراپردهٔ شاه بیرون کشید"
  },
  {
    "poem_id": 1371,
    "vorder": 32,
    "position": 1,
    "text": "درفش همایون به هامون کشید"
  },
  {
    "poem_id": 1371,
    "vorder": 33,
    "position": 0,
    "text": "همی رفت لشکر گروها گروه"
  },
  {
    "poem_id": 1371,
    "vorder": 34,
    "position": 1,
    "text": "چو دریا بجوشید هامون و کوه"
  },
  {
    "poem_id": 1371,
    "vorder": 35,
    "position": 0,
    "text": "چنان تیره شد روز روشن ز گرد"
  },
  {
    "poem_id": 1371,
    "vorder": 36,
    "position": 1,
    "text": "تو گفتی که خورشید شد لاجورد"
  },
  {
    "poem_id": 1371,
    "vorder": 37,
    "position": 0,
    "text": "ز کشور برآمد سراسر خروش"
  },
  {
    "poem_id": 1371,
    "vorder": 38,
    "position": 1,
    "text": "همی کرشدی مردم تیزگوش"
  },
  {
    "poem_id": 1371,
    "vorder": 39,
    "position": 0,
    "text": "خروشیدن تازی اسپان ز دشت"
  },
  {
    "poem_id": 1371,
    "vorder": 40,
    "position": 1,
    "text": "ز بانگ تبیره همی برگذشت"
  },
  {
    "poem_id": 1371,
    "vorder": 41,
    "position": 0,
    "text": "ز لشگر گه پهلوان تا دو میل"
  },
  {
    "poem_id": 1371,
    "vorder": 42,
    "position": 1,
    "text": "کشیده دو رویه رده ژنده‌پیل"
  },
  {
    "poem_id": 1371,
    "vorder": 43,
    "position": 0,
    "text": "ازان شصت بر پشتشان تخت زر"
  },
  {
    "poem_id": 1371,
    "vorder": 44,
    "position": 1,
    "text": "به زر اندرون چند گونه گهر"
  },
  {
    "poem_id": 1371,
    "vorder": 45,
    "position": 0,
    "text": "چو سیصد بنه برنهادند بار"
  },
  {
    "poem_id": 1371,
    "vorder": 46,
    "position": 1,
    "text": "چو سیصد همان از در کارزار"
  },
  {
    "poem_id": 1371,
    "vorder": 47,
    "position": 0,
    "text": "همه زیر برگستوان اندرون"
  },
  {
    "poem_id": 1371,
    "vorder": 48,
    "position": 1,
    "text": "نبدشان جز از چشم ز آهن برون"
  },
  {
    "poem_id": 1371,
    "vorder": 49,
    "position": 0,
    "text": "سراپردهٔ شاه بیرون زدند"
  },
  {
    "poem_id": 1371,
    "vorder": 50,
    "position": 1,
    "text": "ز تمیشه لشکر بهامون زدند"
  },
  {
    "poem_id": 1371,
    "vorder": 51,
    "position": 0,
    "text": "سپهدار چون قارن کینه‌دار"
  },
  {
    "poem_id": 1371,
    "vorder": 52,
    "position": 1,
    "text": "سواران جنگی چو سیصدهزار"
  },
  {
    "poem_id": 1371,
    "vorder": 53,
    "position": 0,
    "text": "همه نامداران جوشن‌وران"
  },
  {
    "poem_id": 1371,
    "vorder": 54,
    "position": 1,
    "text": "برفتند با گرزهای گران"
  },
  {
    "poem_id": 1371,
    "vorder": 55,
    "position": 0,
    "text": "دلیران یکایک چو شیر ژیان"
  },
  {
    "poem_id": 1371,
    "vorder": 56,
    "position": 1,
    "text": "همه بسته بر کین ایرج میان"
  },
  {
    "poem_id": 1371,
    "vorder": 57,
    "position": 0,
    "text": "به پیش اندرون کاویانی درفش"
  },
  {
    "poem_id": 1371,
    "vorder": 58,
    "position": 1,
    "text": "به چنگ اندرون تیغهای بنفش"
  },
  {
    "poem_id": 1371,
    "vorder": 59,
    "position": 0,
    "text": "منوچهر با قارن پیلتن"
  },
  {
    "poem_id": 1371,
    "vorder": 60,
    "position": 1,
    "text": "برون آمد از بیشهٔ نارون"
  },
  {
    "poem_id": 1371,
    "vorder": 61,
    "position": 0,
    "text": "بیامد به پیش سپه برگذشت"
  },
  {
    "poem_id": 1371,
    "vorder": 62,
    "position": 1,
    "text": "بیاراست لشکر بران پهن‌دشت"
  },
  {
    "poem_id": 1371,
    "vorder": 63,
    "position": 0,
    "text": "چپ لشکرش را بگرشاسپ داد"
  },
  {
    "poem_id": 1371,
    "vorder": 64,
    "position": 1,
    "text": "ابر میمنه سام یل با قباد"
  },
  {
    "poem_id": 1371,
    "vorder": 65,
    "position": 0,
    "text": "رده بر کشیده ز هر سو سپاه"
  },
  {
    "poem_id": 1371,
    "vorder": 66,
    "position": 1,
    "text": "منوچهر با سرو در قلب‌گاه"
  },
  {
    "poem_id": 1371,
    "vorder": 67,
    "position": 0,
    "text": "همی تافت چون مه میان گروه"
  },
  {
    "poem_id": 1371,
    "vorder": 68,
    "position": 1,
    "text": "نبود ایچ پیدا ز افراز کوه"
  },
  {
    "poem_id": 1371,
    "vorder": 69,
    "position": 0,
    "text": "سپه کش چو قارن مبارز چو سام"
  },
  {
    "poem_id": 1371,
    "vorder": 70,
    "position": 1,
    "text": "سپه برکشیده حسام از نیام"
  },
  {
    "poem_id": 1371,
    "vorder": 71,
    "position": 0,
    "text": "طلایه به پیش اندرون چون قباد"
  },
  {
    "poem_id": 1371,
    "vorder": 72,
    "position": 1,
    "text": "کمین ور چو گرد تلیمان نژاد"
  },
  {
    "poem_id": 1371,
    "vorder": 73,
    "position": 0,
    "text": "یکی لشکر آراسته چون عروس"
  },
  {
    "poem_id": 1371,
    "vorder": 74,
    "position": 1,
    "text": "به شیران جنگی و آوای کوس"
  },
  {
    "poem_id": 1371,
    "vorder": 75,
    "position": 0,
    "text": "به تور و به سلم آگهی تاختند"
  },
  {
    "poem_id": 1371,
    "vorder": 76,
    "position": 1,
    "text": "که ایرانیان جنگ را ساختند"
  },
  {
    "poem_id": 1371,
    "vorder": 77,
    "position": 0,
    "text": "ز بیشه بهامون کشیدند صف"
  },
  {
    "poem_id": 1371,
    "vorder": 78,
    "position": 1,
    "text": "ز خون جگر بر لب آورده کف"
  },
  {
    "poem_id": 1371,
    "vorder": 79,
    "position": 0,
    "text": "دو خونی همان با سپاهی گران"
  },
  {
    "poem_id": 1371,
    "vorder": 80,
    "position": 1,
    "text": "برفتند آگنده از کین سران"
  },
  {
    "poem_id": 1371,
    "vorder": 81,
    "position": 0,
    "text": "کشیدند لشکر به دشت نبرد"
  },
  {
    "poem_id": 1371,
    "vorder": 82,
    "position": 1,
    "text": "الانان دژ را پس پشت کرد"
  },
  {
    "poem_id": 1371,
    "vorder": 83,
    "position": 0,
    "text": "یکایک طلایه بیامد قباد"
  },
  {
    "poem_id": 1371,
    "vorder": 84,
    "position": 1,
    "text": "چو تور آگهی یافت آمد چو باد"
  },
  {
    "poem_id": 1371,
    "vorder": 85,
    "position": 0,
    "text": "بدو گفت نزد منوچهر شو"
  },
  {
    "poem_id": 1371,
    "vorder": 86,
    "position": 1,
    "text": "بگویش که ای بی‌پدر شاه نو"
  },
  {
    "poem_id": 1371,
    "vorder": 87,
    "position": 0,
    "text": "اگر دختر آمد ز ایرج نژاد"
  },
  {
    "poem_id": 1371,
    "vorder": 88,
    "position": 1,
    "text": "ترا تیغ و کوپال و جوشن که داد"
  },
  {
    "poem_id": 1371,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت آری گزارم پیام"
  },
  {
    "poem_id": 1371,
    "vorder": 90,
    "position": 1,
    "text": "بدین سان که گفتی و بردی تو نام"
  },
  {
    "poem_id": 1371,
    "vorder": 91,
    "position": 0,
    "text": "ولیکن گر اندیشه گردد دراز"
  },
  {
    "poem_id": 1371,
    "vorder": 92,
    "position": 1,
    "text": "خرد با دل تو نشیند براز"
  },
  {
    "poem_id": 1371,
    "vorder": 93,
    "position": 0,
    "text": "بدانی که کاریت هولست پیش"
  },
  {
    "poem_id": 1371,
    "vorder": 94,
    "position": 1,
    "text": "بترسی ازین خام گفتار خویش"
  },
  {
    "poem_id": 1371,
    "vorder": 95,
    "position": 0,
    "text": "اگر بر شما دام و دد روز و شب"
  },
  {
    "poem_id": 1371,
    "vorder": 96,
    "position": 1,
    "text": "همی گریدی نیستی بس عجب"
  },
  {
    "poem_id": 1371,
    "vorder": 97,
    "position": 0,
    "text": "که از بیشهٔ نارون تا بچین"
  },
  {
    "poem_id": 1371,
    "vorder": 98,
    "position": 1,
    "text": "سواران جنگند و مردان کین"
  },
  {
    "poem_id": 1371,
    "vorder": 99,
    "position": 0,
    "text": "درفشیدن تیغهای بنفش"
  },
  {
    "poem_id": 1371,
    "vorder": 100,
    "position": 1,
    "text": "چو بینید باکاویانی درفش"
  },
  {
    "poem_id": 1371,
    "vorder": 101,
    "position": 0,
    "text": "بدرد دل و مغزتان از نهیب"
  },
  {
    "poem_id": 1371,
    "vorder": 102,
    "position": 1,
    "text": "بلندی ندانید باز از نشیب"
  },
  {
    "poem_id": 1371,
    "vorder": 103,
    "position": 0,
    "text": "قباد آمد آنگه به نزدیک شاه"
  },
  {
    "poem_id": 1371,
    "vorder": 104,
    "position": 1,
    "text": "بگفت آنچه بشنید ازان رزم خواه"
  },
  {
    "poem_id": 1371,
    "vorder": 105,
    "position": 0,
    "text": "منوچهر خندید و گفت آنگهی"
  },
  {
    "poem_id": 1371,
    "vorder": 106,
    "position": 1,
    "text": "که چونین نگوید مگر ابلهی"
  },
  {
    "poem_id": 1371,
    "vorder": 107,
    "position": 0,
    "text": "سپاس از جهاندار هر دو جهان"
  },
  {
    "poem_id": 1371,
    "vorder": 108,
    "position": 1,
    "text": "شناسندهٔ آشکار و نهان"
  },
  {
    "poem_id": 1371,
    "vorder": 109,
    "position": 0,
    "text": "که داند که ایرج نیای منست"
  },
  {
    "poem_id": 1371,
    "vorder": 110,
    "position": 1,
    "text": "فریدون فرخ گوای منست"
  },
  {
    "poem_id": 1371,
    "vorder": 111,
    "position": 0,
    "text": "کنون گر بجنگ اندر آریم سر"
  },
  {
    "poem_id": 1371,
    "vorder": 112,
    "position": 1,
    "text": "شود آشکارا نژاد و گهر"
  },
  {
    "poem_id": 1371,
    "vorder": 113,
    "position": 0,
    "text": "به زور خداوند خورشید و ماه"
  },
  {
    "poem_id": 1371,
    "vorder": 114,
    "position": 1,
    "text": "که چندان نمانم ورا دستگاه"
  },
  {
    "poem_id": 1371,
    "vorder": 115,
    "position": 0,
    "text": "که بر هم زند چشم زیر و زبر"
  },
  {
    "poem_id": 1371,
    "vorder": 116,
    "position": 1,
    "text": "بریده به لشکر نمایمش سر"
  },
  {
    "poem_id": 1371,
    "vorder": 117,
    "position": 0,
    "text": "بفرمود تا خوان بیاراستند"
  },
  {
    "poem_id": 1371,
    "vorder": 118,
    "position": 1,
    "text": "نشستنگه رود و می‌خواستند"
  }
]