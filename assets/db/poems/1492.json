[
  {
    "poem_id": 1492,
    "vorder": 1,
    "position": 0,
    "text": "شبی قیرگون ماه پنهان شده"
  },
  {
    "poem_id": 1492,
    "vorder": 2,
    "position": 1,
    "text": "به خواب اندرون مرغ و دام و دده"
  },
  {
    "poem_id": 1492,
    "vorder": 3,
    "position": 0,
    "text": "چنان دید سالار پیران به خواب"
  },
  {
    "poem_id": 1492,
    "vorder": 4,
    "position": 1,
    "text": "که شمعی برافروختی ز آفتاب"
  },
  {
    "poem_id": 1492,
    "vorder": 5,
    "position": 0,
    "text": "سیاوش بر شمع تیغی به دست"
  },
  {
    "poem_id": 1492,
    "vorder": 6,
    "position": 1,
    "text": "به آواز گفتی نشاید نشست"
  },
  {
    "poem_id": 1492,
    "vorder": 7,
    "position": 0,
    "text": "کزین خواب نوشین سر آزاد کن"
  },
  {
    "poem_id": 1492,
    "vorder": 8,
    "position": 1,
    "text": "ز فرجام گیتی یکی یاد کن"
  },
  {
    "poem_id": 1492,
    "vorder": 9,
    "position": 0,
    "text": "که روز نوآیین و جشنی نوست"
  },
  {
    "poem_id": 1492,
    "vorder": 10,
    "position": 1,
    "text": "شب سور آزاده کیخسروست"
  },
  {
    "poem_id": 1492,
    "vorder": 11,
    "position": 0,
    "text": "سپهبد بلرزید در خواب خوش"
  },
  {
    "poem_id": 1492,
    "vorder": 12,
    "position": 1,
    "text": "بجنبید گلشهر خورشید فش"
  },
  {
    "poem_id": 1492,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت پیران که برخیز و رو"
  },
  {
    "poem_id": 1492,
    "vorder": 14,
    "position": 1,
    "text": "خرامنده پیش فرنگیس شو"
  },
  {
    "poem_id": 1492,
    "vorder": 15,
    "position": 0,
    "text": "سیاووش را دیدم اکنون به خواب"
  },
  {
    "poem_id": 1492,
    "vorder": 16,
    "position": 1,
    "text": "درخشان‌تر از بر سپهر آفتاب"
  },
  {
    "poem_id": 1492,
    "vorder": 17,
    "position": 0,
    "text": "که گفتی مرا چند خسپی مپای"
  },
  {
    "poem_id": 1492,
    "vorder": 18,
    "position": 1,
    "text": "به جشن جهانجوی کیخسرو آی"
  },
  {
    "poem_id": 1492,
    "vorder": 19,
    "position": 0,
    "text": "همی رفت گلشهر تا پیش ماه"
  },
  {
    "poem_id": 1492,
    "vorder": 20,
    "position": 1,
    "text": "جدا گشته بود از بر ماه شاه"
  },
  {
    "poem_id": 1492,
    "vorder": 21,
    "position": 0,
    "text": "بدید و به شادی سبک بازگشت"
  },
  {
    "poem_id": 1492,
    "vorder": 22,
    "position": 1,
    "text": "همانگاه گیتی پرآواز گشت"
  },
  {
    "poem_id": 1492,
    "vorder": 23,
    "position": 0,
    "text": "بیامد به شادی به پیران بگفت"
  },
  {
    "poem_id": 1492,
    "vorder": 24,
    "position": 1,
    "text": "که اینت به آیین خور و ماه جفت"
  },
  {
    "poem_id": 1492,
    "vorder": 25,
    "position": 0,
    "text": "یکی اندر آی و شگفتی ببین"
  },
  {
    "poem_id": 1492,
    "vorder": 26,
    "position": 1,
    "text": "بزرگی و رای جهان آفرین"
  },
  {
    "poem_id": 1492,
    "vorder": 27,
    "position": 0,
    "text": "تو گویی نشاید مگر تاج را"
  },
  {
    "poem_id": 1492,
    "vorder": 28,
    "position": 1,
    "text": "و گر جوشن و ترگ و تاراج را"
  },
  {
    "poem_id": 1492,
    "vorder": 29,
    "position": 0,
    "text": "سپهبد بیامد بر شهریار"
  },
  {
    "poem_id": 1492,
    "vorder": 30,
    "position": 1,
    "text": "بسی آفرین کرد و بردش نثار"
  },
  {
    "poem_id": 1492,
    "vorder": 31,
    "position": 0,
    "text": "بران برز و بالا و آن شاخ و یال"
  },
  {
    "poem_id": 1492,
    "vorder": 32,
    "position": 1,
    "text": "تو گویی برو برگذشتست سال"
  },
  {
    "poem_id": 1492,
    "vorder": 33,
    "position": 0,
    "text": "ز بهر سیاوش دو دیده پر آب"
  },
  {
    "poem_id": 1492,
    "vorder": 34,
    "position": 1,
    "text": "همی کرد نفرین بر افراسیاب"
  },
  {
    "poem_id": 1492,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت با نامدار انجمن"
  },
  {
    "poem_id": 1492,
    "vorder": 36,
    "position": 1,
    "text": "که گر بگسلد زین سخن جان من"
  },
  {
    "poem_id": 1492,
    "vorder": 37,
    "position": 0,
    "text": "نمانم که یازد بدین شاه چنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 38,
    "position": 1,
    "text": "مرا گر سپارد به چنگ نهنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 39,
    "position": 0,
    "text": "بدانگه که بنمود خورشید چهر"
  },
  {
    "poem_id": 1492,
    "vorder": 40,
    "position": 1,
    "text": "به خواب اندر آمد سر تیره مهر"
  },
  {
    "poem_id": 1492,
    "vorder": 41,
    "position": 0,
    "text": "چو بیدار شد پهلوان سپاه"
  },
  {
    "poem_id": 1492,
    "vorder": 42,
    "position": 1,
    "text": "دمان اندر آمد به نزدیک شاه"
  },
  {
    "poem_id": 1492,
    "vorder": 43,
    "position": 0,
    "text": "همی ماند تا جای پردخت شد"
  },
  {
    "poem_id": 1492,
    "vorder": 44,
    "position": 1,
    "text": "به نزدیک آن نامور تخت شد"
  },
  {
    "poem_id": 1492,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت خورشید فش مهترا"
  },
  {
    "poem_id": 1492,
    "vorder": 46,
    "position": 1,
    "text": "جهاندار و بیدار و افسونگرا"
  },
  {
    "poem_id": 1492,
    "vorder": 47,
    "position": 0,
    "text": "به در بر یکی بنده بفزود دوش"
  },
  {
    "poem_id": 1492,
    "vorder": 48,
    "position": 1,
    "text": "تو گفتی ورا مایه دادست هوش"
  },
  {
    "poem_id": 1492,
    "vorder": 49,
    "position": 0,
    "text": "نماند ز خوبی جز از تو به کس"
  },
  {
    "poem_id": 1492,
    "vorder": 50,
    "position": 1,
    "text": "تو گویی که برگاه شاهست و بس"
  },
  {
    "poem_id": 1492,
    "vorder": 51,
    "position": 0,
    "text": "اگر تور را روز باز آمدی"
  },
  {
    "poem_id": 1492,
    "vorder": 52,
    "position": 1,
    "text": "به دیدار چهرش نیاز آمدی"
  },
  {
    "poem_id": 1492,
    "vorder": 53,
    "position": 0,
    "text": "فریدون گردست گویی بجای"
  },
  {
    "poem_id": 1492,
    "vorder": 54,
    "position": 1,
    "text": "به فر و به چهر و به دست و به پای"
  },
  {
    "poem_id": 1492,
    "vorder": 55,
    "position": 0,
    "text": "بر ایوان چنو کس نبیند نگار"
  },
  {
    "poem_id": 1492,
    "vorder": 56,
    "position": 1,
    "text": "بدو تازه شد فرهٔ شهریار"
  },
  {
    "poem_id": 1492,
    "vorder": 57,
    "position": 0,
    "text": "از اندیشهٔ بد بپرداز دل"
  },
  {
    "poem_id": 1492,
    "vorder": 58,
    "position": 1,
    "text": "برافراز تاج و برفراز دل"
  },
  {
    "poem_id": 1492,
    "vorder": 59,
    "position": 0,
    "text": "چنان کرد روشن جهان آفرین"
  },
  {
    "poem_id": 1492,
    "vorder": 60,
    "position": 1,
    "text": "کزو دور شد جنگ و بیداد و کین"
  },
  {
    "poem_id": 1492,
    "vorder": 61,
    "position": 0,
    "text": "روانش ز خون سیاوش به درد"
  },
  {
    "poem_id": 1492,
    "vorder": 62,
    "position": 1,
    "text": "برآورد بر لب یکی باد سرد"
  },
  {
    "poem_id": 1492,
    "vorder": 63,
    "position": 0,
    "text": "پشیمان بشد زان کجا کرده بود"
  },
  {
    "poem_id": 1492,
    "vorder": 64,
    "position": 1,
    "text": "به گفتار بیهوده آزرده بود"
  },
  {
    "poem_id": 1492,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت من زین نوآمد بسی"
  },
  {
    "poem_id": 1492,
    "vorder": 66,
    "position": 1,
    "text": "سخنها شنیدستم از هر کسی"
  },
  {
    "poem_id": 1492,
    "vorder": 67,
    "position": 0,
    "text": "پرآشوب جنگست زو روزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 68,
    "position": 1,
    "text": "همه یاد دارم ز آموزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 69,
    "position": 0,
    "text": "که از تخمهٔ تور وز کیقباد"
  },
  {
    "poem_id": 1492,
    "vorder": 70,
    "position": 1,
    "text": "یکی شاه سر برزند با نژاد"
  },
  {
    "poem_id": 1492,
    "vorder": 71,
    "position": 0,
    "text": "جهان را به مهر وی آید نیاز"
  },
  {
    "poem_id": 1492,
    "vorder": 72,
    "position": 1,
    "text": "همه شهر توران برندش نماز"
  },
  {
    "poem_id": 1492,
    "vorder": 73,
    "position": 0,
    "text": "کنون بودنی هرچ بایست بود"
  },
  {
    "poem_id": 1492,
    "vorder": 74,
    "position": 1,
    "text": "ندارد غم و رنج و اندیشه سود"
  },
  {
    "poem_id": 1492,
    "vorder": 75,
    "position": 0,
    "text": "مداریدش اندرمیان گروه"
  },
  {
    "poem_id": 1492,
    "vorder": 76,
    "position": 1,
    "text": "به نزد شبانان فرستش به کوه"
  },
  {
    "poem_id": 1492,
    "vorder": 77,
    "position": 0,
    "text": "بدان تا نداند که من خود کیم"
  },
  {
    "poem_id": 1492,
    "vorder": 78,
    "position": 1,
    "text": "بدیشان سپرده ز بهر چیم"
  },
  {
    "poem_id": 1492,
    "vorder": 79,
    "position": 0,
    "text": "نیاموزد از کس خرد گر نژاد"
  },
  {
    "poem_id": 1492,
    "vorder": 80,
    "position": 1,
    "text": "ز کار گذشته نیایدش یاد"
  },
  {
    "poem_id": 1492,
    "vorder": 81,
    "position": 0,
    "text": "بگفت آنچ یاد آمدش زین سخن"
  },
  {
    "poem_id": 1492,
    "vorder": 82,
    "position": 1,
    "text": "همه نو شمرد این سرای کهن"
  },
  {
    "poem_id": 1492,
    "vorder": 83,
    "position": 0,
    "text": "چه سازی که چاره بدست تو نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 84,
    "position": 1,
    "text": "درازست در کام و شست تو نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 85,
    "position": 0,
    "text": "گر ایدونک بد بینی از روزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 86,
    "position": 1,
    "text": "به نیکی همو باشد آموزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 87,
    "position": 0,
    "text": "بیامد به در پهلوان شادمان"
  },
  {
    "poem_id": 1492,
    "vorder": 88,
    "position": 1,
    "text": "بدل بر همه نیک بودش گمان"
  },
  {
    "poem_id": 1492,
    "vorder": 89,
    "position": 0,
    "text": "جهان آفرین را نیایش گرفت"
  },
  {
    "poem_id": 1492,
    "vorder": 90,
    "position": 1,
    "text": "به شاه جهان بر ستایش گرفت"
  },
  {
    "poem_id": 1492,
    "vorder": 91,
    "position": 0,
    "text": "پراندیشه بد تا به ایوان رسید"
  },
  {
    "poem_id": 1492,
    "vorder": 92,
    "position": 1,
    "text": "کزان رنج و مهرش چه آید پدید"
  },
  {
    "poem_id": 1492,
    "vorder": 93,
    "position": 0,
    "text": "شبانان کوه قلا را بخواند"
  },
  {
    "poem_id": 1492,
    "vorder": 94,
    "position": 1,
    "text": "وزان خرد چندی سخنها براند"
  },
  {
    "poem_id": 1492,
    "vorder": 95,
    "position": 0,
    "text": "که این را بدارید چون جان پاک"
  },
  {
    "poem_id": 1492,
    "vorder": 96,
    "position": 1,
    "text": "نباید که بیند ورا باد و خاک"
  },
  {
    "poem_id": 1492,
    "vorder": 97,
    "position": 0,
    "text": "نباید که تنگ آیدش روزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 98,
    "position": 1,
    "text": "اگر دیده و دل کند خواستار"
  },
  {
    "poem_id": 1492,
    "vorder": 99,
    "position": 0,
    "text": "شبان را ببخشید بسیار چیز"
  },
  {
    "poem_id": 1492,
    "vorder": 100,
    "position": 1,
    "text": "یکی دایه با او فرستاد نیز"
  },
  {
    "poem_id": 1492,
    "vorder": 101,
    "position": 0,
    "text": "بریشان سپرد آن دل و دیده را"
  },
  {
    "poem_id": 1492,
    "vorder": 102,
    "position": 1,
    "text": "جهانجوی گرد پسندیده را"
  },
  {
    "poem_id": 1492,
    "vorder": 103,
    "position": 0,
    "text": "بدین نیز بگذشت گردان سپهر"
  },
  {
    "poem_id": 1492,
    "vorder": 104,
    "position": 1,
    "text": "به خسرو بر از مهر بخشود چهر"
  },
  {
    "poem_id": 1492,
    "vorder": 105,
    "position": 0,
    "text": "چو شد هفت ساله گو سرفراز"
  },
  {
    "poem_id": 1492,
    "vorder": 106,
    "position": 1,
    "text": "هنر با نژادش همی گفت راز"
  },
  {
    "poem_id": 1492,
    "vorder": 107,
    "position": 0,
    "text": "ز چوبی کمان کرد وز روده زه"
  },
  {
    "poem_id": 1492,
    "vorder": 108,
    "position": 1,
    "text": "ز هر سو برافگند زه را گره"
  },
  {
    "poem_id": 1492,
    "vorder": 109,
    "position": 0,
    "text": "ابی پر و پیکان یکی تیر کرد"
  },
  {
    "poem_id": 1492,
    "vorder": 110,
    "position": 1,
    "text": "به دشت اندر آهنگ نخچیر کرد"
  },
  {
    "poem_id": 1492,
    "vorder": 111,
    "position": 0,
    "text": "چو ده‌ساله شد گشت گردی سترگ"
  },
  {
    "poem_id": 1492,
    "vorder": 112,
    "position": 1,
    "text": "به زخم گراز آمد و خرس و گرگ"
  },
  {
    "poem_id": 1492,
    "vorder": 113,
    "position": 0,
    "text": "وزان جایگه شد به شیر و پلنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 114,
    "position": 1,
    "text": "هم آن چوب خمیده بد ساز جنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 115,
    "position": 0,
    "text": "چنین تا برآمد برین روزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 116,
    "position": 1,
    "text": "بیامد به فرمان آموزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 117,
    "position": 0,
    "text": "شبان اندر آمد ز کوه و ز دشت"
  },
  {
    "poem_id": 1492,
    "vorder": 118,
    "position": 1,
    "text": "بنالید و نزدیک پیران گذشت"
  },
  {
    "poem_id": 1492,
    "vorder": 119,
    "position": 0,
    "text": "که من زین سرافراز شیر یله"
  },
  {
    "poem_id": 1492,
    "vorder": 120,
    "position": 1,
    "text": "سوی پهلوان آمدم با گله"
  },
  {
    "poem_id": 1492,
    "vorder": 121,
    "position": 0,
    "text": "همی کرد نخچیر آهو نخست"
  },
  {
    "poem_id": 1492,
    "vorder": 122,
    "position": 1,
    "text": "بر شیر و جنگ پلنگان نجست"
  },
  {
    "poem_id": 1492,
    "vorder": 123,
    "position": 0,
    "text": "کنون نزد او جنگ شیر دمان"
  },
  {
    "poem_id": 1492,
    "vorder": 124,
    "position": 1,
    "text": "همانست و نخچیر آهو همان"
  },
  {
    "poem_id": 1492,
    "vorder": 125,
    "position": 0,
    "text": "نباید که آید برو برگزند"
  },
  {
    "poem_id": 1492,
    "vorder": 126,
    "position": 1,
    "text": "بیاویزدم پهلوان بلند"
  },
  {
    "poem_id": 1492,
    "vorder": 127,
    "position": 0,
    "text": "چو بشنید پیران بخندید و گفت"
  },
  {
    "poem_id": 1492,
    "vorder": 128,
    "position": 1,
    "text": "نماند نژاد و هنر در نهفت"
  },
  {
    "poem_id": 1492,
    "vorder": 129,
    "position": 0,
    "text": "نشست از بر باره دست کش"
  },
  {
    "poem_id": 1492,
    "vorder": 130,
    "position": 1,
    "text": "بیامد بر خسرو شیرفش"
  },
  {
    "poem_id": 1492,
    "vorder": 131,
    "position": 0,
    "text": "بفرمود تا پیش او شد به مهر"
  },
  {
    "poem_id": 1492,
    "vorder": 132,
    "position": 1,
    "text": "نگه کرد پیران بران فر و چهر"
  },
  {
    "poem_id": 1492,
    "vorder": 133,
    "position": 0,
    "text": "به بر در گرفتش زمانی دراز"
  },
  {
    "poem_id": 1492,
    "vorder": 134,
    "position": 1,
    "text": "همی گفت با داور پاک راز"
  },
  {
    "poem_id": 1492,
    "vorder": 135,
    "position": 0,
    "text": "بدو گفت کیخسرو پاک دین"
  },
  {
    "poem_id": 1492,
    "vorder": 136,
    "position": 1,
    "text": "به تو باد رخشنده توران زمین"
  },
  {
    "poem_id": 1492,
    "vorder": 137,
    "position": 0,
    "text": "ازیرا کسی کت نداند همی"
  },
  {
    "poem_id": 1492,
    "vorder": 138,
    "position": 1,
    "text": "جز از مهربانت نخواند همی"
  },
  {
    "poem_id": 1492,
    "vorder": 139,
    "position": 0,
    "text": "شبان‌زاده‌ای را چنین در کنار"
  },
  {
    "poem_id": 1492,
    "vorder": 140,
    "position": 1,
    "text": "بگیری و از کس نیایدت عار"
  },
  {
    "poem_id": 1492,
    "vorder": 141,
    "position": 0,
    "text": "خردمند را دل برو بر بسوخت"
  },
  {
    "poem_id": 1492,
    "vorder": 142,
    "position": 1,
    "text": "به کردار آتش رخش برفروخت"
  },
  {
    "poem_id": 1492,
    "vorder": 143,
    "position": 0,
    "text": "بدو گفت کای یادگار مهان"
  },
  {
    "poem_id": 1492,
    "vorder": 144,
    "position": 1,
    "text": "پسندیده و ناسپرده جهان"
  },
  {
    "poem_id": 1492,
    "vorder": 145,
    "position": 0,
    "text": "که تاج سر شهریاران توی"
  },
  {
    "poem_id": 1492,
    "vorder": 146,
    "position": 1,
    "text": "که گوید که پور شبانان توی"
  },
  {
    "poem_id": 1492,
    "vorder": 147,
    "position": 0,
    "text": "شبان نیست از گوهر تو کسی"
  },
  {
    "poem_id": 1492,
    "vorder": 148,
    "position": 1,
    "text": "و زین داستان هست با من بسی"
  },
  {
    "poem_id": 1492,
    "vorder": 149,
    "position": 0,
    "text": "ز بهر جوان اسپ و بالای خواست"
  },
  {
    "poem_id": 1492,
    "vorder": 150,
    "position": 1,
    "text": "همان جامهٔ خسروآرای خواست"
  },
  {
    "poem_id": 1492,
    "vorder": 151,
    "position": 0,
    "text": "به ایوان خرامید با او به هم"
  },
  {
    "poem_id": 1492,
    "vorder": 152,
    "position": 1,
    "text": "روانش ز بهر سیاوش دژم"
  },
  {
    "poem_id": 1492,
    "vorder": 153,
    "position": 0,
    "text": "همی پرورانیدش اندر کنار"
  },
  {
    "poem_id": 1492,
    "vorder": 154,
    "position": 1,
    "text": "بدو شادمان گردش روزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 155,
    "position": 0,
    "text": "بدین نیز بگذشت چندی سپهر"
  },
  {
    "poem_id": 1492,
    "vorder": 156,
    "position": 1,
    "text": "به مغز اندرون داشت با شاه مهر"
  },
  {
    "poem_id": 1492,
    "vorder": 157,
    "position": 0,
    "text": "شب تیره هنگام آرام و خواب"
  },
  {
    "poem_id": 1492,
    "vorder": 158,
    "position": 1,
    "text": "کس آمد ز نزدیک افراسیاب"
  },
  {
    "poem_id": 1492,
    "vorder": 159,
    "position": 0,
    "text": "بران تیرگی پهلوان را بخواند"
  },
  {
    "poem_id": 1492,
    "vorder": 160,
    "position": 1,
    "text": "گذشته سخنها فراوان براند"
  },
  {
    "poem_id": 1492,
    "vorder": 161,
    "position": 0,
    "text": "کز اندیشهٔ بد همه شب دلم"
  },
  {
    "poem_id": 1492,
    "vorder": 162,
    "position": 1,
    "text": "بپیچید وز غم همی بگسلم"
  },
  {
    "poem_id": 1492,
    "vorder": 163,
    "position": 0,
    "text": "ازین کودکی کز سیاوش رسید"
  },
  {
    "poem_id": 1492,
    "vorder": 164,
    "position": 1,
    "text": "تو گفتی مرا روز شد ناپدید"
  },
  {
    "poem_id": 1492,
    "vorder": 165,
    "position": 0,
    "text": "نبیره فریدون شبان پرورد"
  },
  {
    "poem_id": 1492,
    "vorder": 166,
    "position": 1,
    "text": "ز رای و خرد این کی اندر خورد"
  },
  {
    "poem_id": 1492,
    "vorder": 167,
    "position": 0,
    "text": "ازو گر نوشته به من بر بدیست"
  },
  {
    "poem_id": 1492,
    "vorder": 168,
    "position": 1,
    "text": "نشاید گذشتن که آن ایزدیست"
  },
  {
    "poem_id": 1492,
    "vorder": 169,
    "position": 0,
    "text": "چو کار گذشته نیارد به یاد"
  },
  {
    "poem_id": 1492,
    "vorder": 170,
    "position": 1,
    "text": "زید شاد و ما نیز باشیم شاد"
  },
  {
    "poem_id": 1492,
    "vorder": 171,
    "position": 0,
    "text": "وگر هیچ خوی بد آرد پدید"
  },
  {
    "poem_id": 1492,
    "vorder": 172,
    "position": 1,
    "text": "بسان پدر سر بباید برید"
  },
  {
    "poem_id": 1492,
    "vorder": 173,
    "position": 0,
    "text": "بدو گفت پیران که ای شهریار"
  },
  {
    "poem_id": 1492,
    "vorder": 174,
    "position": 1,
    "text": "ترا خود نباید کس آموزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 175,
    "position": 0,
    "text": "یکی کودکی خرد چون بیهشان"
  },
  {
    "poem_id": 1492,
    "vorder": 176,
    "position": 1,
    "text": "ز کار گذشته چه دارد نشان"
  },
  {
    "poem_id": 1492,
    "vorder": 177,
    "position": 0,
    "text": "تو خود این میندیش و بد را مکوش"
  },
  {
    "poem_id": 1492,
    "vorder": 178,
    "position": 1,
    "text": "چه گفت آن خردمند بسیارهوش"
  },
  {
    "poem_id": 1492,
    "vorder": 179,
    "position": 0,
    "text": "که پروردگار از پدر برترست"
  },
  {
    "poem_id": 1492,
    "vorder": 180,
    "position": 1,
    "text": "اگر زاده را مهر با مادرست"
  },
  {
    "poem_id": 1492,
    "vorder": 181,
    "position": 0,
    "text": "نخستین به پیمان مرا شاد کن"
  },
  {
    "poem_id": 1492,
    "vorder": 182,
    "position": 1,
    "text": "ز سوگند شاهان یکی یاد کن"
  },
  {
    "poem_id": 1492,
    "vorder": 183,
    "position": 0,
    "text": "فریدون به داد و به تخت و کلاه"
  },
  {
    "poem_id": 1492,
    "vorder": 184,
    "position": 1,
    "text": "همی داشتی راستی را نگاه"
  },
  {
    "poem_id": 1492,
    "vorder": 185,
    "position": 0,
    "text": "ز پیران چو بشینید افراسیاب"
  },
  {
    "poem_id": 1492,
    "vorder": 186,
    "position": 1,
    "text": "سر مرد جنگی درآمد ز خواب"
  },
  {
    "poem_id": 1492,
    "vorder": 187,
    "position": 0,
    "text": "یکی سخت سوگند شاهانه خورد"
  },
  {
    "poem_id": 1492,
    "vorder": 188,
    "position": 1,
    "text": "به روز سپید و شب لاژورد"
  },
  {
    "poem_id": 1492,
    "vorder": 189,
    "position": 0,
    "text": "به دادار کاو این جهان آفرید"
  },
  {
    "poem_id": 1492,
    "vorder": 190,
    "position": 1,
    "text": "سپهر و دد و دام و جان آفرید"
  },
  {
    "poem_id": 1492,
    "vorder": 191,
    "position": 0,
    "text": "که ناید بدین کودک از من ستم"
  },
  {
    "poem_id": 1492,
    "vorder": 192,
    "position": 1,
    "text": "نه هرگز برو بر زنم تیزدم"
  },
  {
    "poem_id": 1492,
    "vorder": 193,
    "position": 0,
    "text": "زمین را ببوسید پیران و گفت"
  },
  {
    "poem_id": 1492,
    "vorder": 194,
    "position": 1,
    "text": "که ای دادگر شاه بی‌یار و جفت"
  },
  {
    "poem_id": 1492,
    "vorder": 195,
    "position": 0,
    "text": "برین بند و سوگند تو ایمنم"
  },
  {
    "poem_id": 1492,
    "vorder": 196,
    "position": 1,
    "text": "کنون یافت آرام جان و تنم"
  },
  {
    "poem_id": 1492,
    "vorder": 197,
    "position": 0,
    "text": "وزانجا بر خسرو آمد دمان"
  },
  {
    "poem_id": 1492,
    "vorder": 198,
    "position": 1,
    "text": "رخی ارغوان و دلی شادمان"
  },
  {
    "poem_id": 1492,
    "vorder": 199,
    "position": 0,
    "text": "بدو گفت کز دل خرد دور کن"
  },
  {
    "poem_id": 1492,
    "vorder": 200,
    "position": 1,
    "text": "چو رزم آورد پاسخش سور کن"
  },
  {
    "poem_id": 1492,
    "vorder": 201,
    "position": 0,
    "text": "مرو پیش او جز به دیوانگی"
  },
  {
    "poem_id": 1492,
    "vorder": 202,
    "position": 1,
    "text": "مگردان زبان جز به بیگانگی"
  },
  {
    "poem_id": 1492,
    "vorder": 203,
    "position": 0,
    "text": "مگرد ایچ گونه به گرد خرد"
  },
  {
    "poem_id": 1492,
    "vorder": 204,
    "position": 1,
    "text": "یک امروز بر تو مگر بگذرد"
  },
  {
    "poem_id": 1492,
    "vorder": 205,
    "position": 0,
    "text": "به سر بر نهادش کلاه کیان"
  },
  {
    "poem_id": 1492,
    "vorder": 206,
    "position": 1,
    "text": "ببستش کیانی کمر بر میان"
  },
  {
    "poem_id": 1492,
    "vorder": 207,
    "position": 0,
    "text": "یکی بارهٔ‌گام زن خواست نغز"
  },
  {
    "poem_id": 1492,
    "vorder": 208,
    "position": 1,
    "text": "برو بر نشست آن گو پاک مغز"
  },
  {
    "poem_id": 1492,
    "vorder": 209,
    "position": 0,
    "text": "بیامد به درگاه افراسیاب"
  },
  {
    "poem_id": 1492,
    "vorder": 210,
    "position": 1,
    "text": "جهانی برو دیده کرده پرآب"
  },
  {
    "poem_id": 1492,
    "vorder": 211,
    "position": 0,
    "text": "روارو برآمد که بگشای راه"
  },
  {
    "poem_id": 1492,
    "vorder": 212,
    "position": 1,
    "text": "که آمد نوآیین یکی پیشگاه"
  },
  {
    "poem_id": 1492,
    "vorder": 213,
    "position": 0,
    "text": "همی رفت پیش اندرون شاه گرد"
  },
  {
    "poem_id": 1492,
    "vorder": 214,
    "position": 1,
    "text": "سپهدار پیران ورا پیش برد"
  },
  {
    "poem_id": 1492,
    "vorder": 215,
    "position": 0,
    "text": "بیامد به نزدیک افراسیاب"
  },
  {
    "poem_id": 1492,
    "vorder": 216,
    "position": 1,
    "text": "نیا را رخ از شرم او شد پرآب"
  },
  {
    "poem_id": 1492,
    "vorder": 217,
    "position": 0,
    "text": "بران خسروی یال و آن چنگ او"
  },
  {
    "poem_id": 1492,
    "vorder": 218,
    "position": 1,
    "text": "بدان شاخ و آن فر و اورنگ او"
  },
  {
    "poem_id": 1492,
    "vorder": 219,
    "position": 0,
    "text": "زمانی نگه کرد و نیکو بدید"
  },
  {
    "poem_id": 1492,
    "vorder": 220,
    "position": 1,
    "text": "همی گشت رنگ رخش ناپدید"
  },
  {
    "poem_id": 1492,
    "vorder": 221,
    "position": 0,
    "text": "تن پهلوان گشت لرزان چو بید"
  },
  {
    "poem_id": 1492,
    "vorder": 222,
    "position": 1,
    "text": "ز جان جوان پاک بگسست امید"
  },
  {
    "poem_id": 1492,
    "vorder": 223,
    "position": 0,
    "text": "زمانی چنان بود بگشاد چهر"
  },
  {
    "poem_id": 1492,
    "vorder": 224,
    "position": 1,
    "text": "زمانه به دلش اندر آورد مهر"
  },
  {
    "poem_id": 1492,
    "vorder": 225,
    "position": 0,
    "text": "بپرسید کای نورسیده جوان"
  },
  {
    "poem_id": 1492,
    "vorder": 226,
    "position": 1,
    "text": "چه آگاه داری ز کار جهان"
  },
  {
    "poem_id": 1492,
    "vorder": 227,
    "position": 0,
    "text": "بر گوسفندان چه گردی همی"
  },
  {
    "poem_id": 1492,
    "vorder": 228,
    "position": 1,
    "text": "زمین را چه گونه سپردی همی"
  },
  {
    "poem_id": 1492,
    "vorder": 229,
    "position": 0,
    "text": "چنین داد پاسخ که نخچیر نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 230,
    "position": 1,
    "text": "مرا خود کمان و پر تیر نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 231,
    "position": 0,
    "text": "بپرسید بازش ز آموزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 232,
    "position": 1,
    "text": "ز نیک و بد و گردش روزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 233,
    "position": 0,
    "text": "بدو گفت جایی که باشد پلنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 234,
    "position": 1,
    "text": "بدرد دل مردم تیزچنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 235,
    "position": 0,
    "text": "سه دیگر بپرسیدش از مام و باب"
  },
  {
    "poem_id": 1492,
    "vorder": 236,
    "position": 1,
    "text": "ز ایوان و از شهر وز خورد و خواب"
  },
  {
    "poem_id": 1492,
    "vorder": 237,
    "position": 0,
    "text": "چنین داد پاسخ که درنده شیر"
  },
  {
    "poem_id": 1492,
    "vorder": 238,
    "position": 1,
    "text": "نیارد سگ کارزاری به زیر"
  },
  {
    "poem_id": 1492,
    "vorder": 239,
    "position": 0,
    "text": "بخندید خسرو ز گفتار اوی"
  },
  {
    "poem_id": 1492,
    "vorder": 240,
    "position": 1,
    "text": "سوی پهلوان سپه کرد روی"
  },
  {
    "poem_id": 1492,
    "vorder": 241,
    "position": 0,
    "text": "بدو گفت کاین دل ندارد بجای"
  },
  {
    "poem_id": 1492,
    "vorder": 242,
    "position": 1,
    "text": "ز سر پرسمش پاسخ آرد ز پای"
  },
  {
    "poem_id": 1492,
    "vorder": 243,
    "position": 0,
    "text": "نیاید همانا بد و نیک ازوی"
  },
  {
    "poem_id": 1492,
    "vorder": 244,
    "position": 1,
    "text": "نه زینسان بود مردم کینه جوی"
  },
  {
    "poem_id": 1492,
    "vorder": 245,
    "position": 0,
    "text": "رو این را به خوبی به مادر سپار"
  },
  {
    "poem_id": 1492,
    "vorder": 246,
    "position": 1,
    "text": "به دست یکی مرد پرهیزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 247,
    "position": 0,
    "text": "گسی کن به سوی سیاووش گرد"
  },
  {
    "poem_id": 1492,
    "vorder": 248,
    "position": 1,
    "text": "مگردان بدآموز را هیچ گرد"
  },
  {
    "poem_id": 1492,
    "vorder": 249,
    "position": 0,
    "text": "ز اسپ و پرستنده و بیش و کم"
  },
  {
    "poem_id": 1492,
    "vorder": 250,
    "position": 1,
    "text": "بده هرچ باید ز گنج و درم"
  },
  {
    "poem_id": 1492,
    "vorder": 251,
    "position": 0,
    "text": "سپهبد برو کرد لختی شتاب"
  },
  {
    "poem_id": 1492,
    "vorder": 252,
    "position": 1,
    "text": "برون بردش از پیش افراسیاب"
  },
  {
    "poem_id": 1492,
    "vorder": 253,
    "position": 0,
    "text": "به ایوان خویش آمد افروخته"
  },
  {
    "poem_id": 1492,
    "vorder": 254,
    "position": 1,
    "text": "خرامان و چشم بدی دوخته"
  },
  {
    "poem_id": 1492,
    "vorder": 255,
    "position": 0,
    "text": "همی گفت کز دادگر کردگار"
  },
  {
    "poem_id": 1492,
    "vorder": 256,
    "position": 1,
    "text": "درخت نو آمد جهان را به بار"
  },
  {
    "poem_id": 1492,
    "vorder": 257,
    "position": 0,
    "text": "در گنجهای کهن کرد باز"
  },
  {
    "poem_id": 1492,
    "vorder": 258,
    "position": 1,
    "text": "ز هر گونه‌ای شاه را کرد ساز"
  },
  {
    "poem_id": 1492,
    "vorder": 259,
    "position": 0,
    "text": "ز دینار و دیبا و تیغ و گهر"
  },
  {
    "poem_id": 1492,
    "vorder": 260,
    "position": 1,
    "text": "ز اسب و سلیح و کلاه و کمر"
  },
  {
    "poem_id": 1492,
    "vorder": 261,
    "position": 0,
    "text": "هم از تخت وز بدرهای درم"
  },
  {
    "poem_id": 1492,
    "vorder": 262,
    "position": 1,
    "text": "ز گستردنیها و از بیش و کم"
  },
  {
    "poem_id": 1492,
    "vorder": 263,
    "position": 0,
    "text": "گسی کردشان سوی آن شارستان"
  },
  {
    "poem_id": 1492,
    "vorder": 264,
    "position": 1,
    "text": "کجا جملگی گشته بد خارستان"
  },
  {
    "poem_id": 1492,
    "vorder": 265,
    "position": 0,
    "text": "فرنگیس و کیخسرو آنجا رسید"
  },
  {
    "poem_id": 1492,
    "vorder": 266,
    "position": 1,
    "text": "بسی مردم آمد ز هر سو پدید"
  },
  {
    "poem_id": 1492,
    "vorder": 267,
    "position": 0,
    "text": "بدیده سپردند یک یک زمین"
  },
  {
    "poem_id": 1492,
    "vorder": 268,
    "position": 1,
    "text": "زبان دد و دام پرآفرین"
  },
  {
    "poem_id": 1492,
    "vorder": 269,
    "position": 0,
    "text": "همی گفت هرکس که بودش هنر"
  },
  {
    "poem_id": 1492,
    "vorder": 270,
    "position": 1,
    "text": "سپاس از جهان داور دادگر"
  },
  {
    "poem_id": 1492,
    "vorder": 271,
    "position": 0,
    "text": "کزان بیخ برکنده فرخ درخت"
  },
  {
    "poem_id": 1492,
    "vorder": 272,
    "position": 1,
    "text": "ازین‌گونه شاخی برآورد سخت"
  },
  {
    "poem_id": 1492,
    "vorder": 273,
    "position": 0,
    "text": "ز شاه کیان چشم بد دور باد"
  },
  {
    "poem_id": 1492,
    "vorder": 274,
    "position": 1,
    "text": "روان سیاوش پر از نور باد"
  },
  {
    "poem_id": 1492,
    "vorder": 275,
    "position": 0,
    "text": "همه خاک آن شارستان شاد شد"
  },
  {
    "poem_id": 1492,
    "vorder": 276,
    "position": 1,
    "text": "گیا بر چمن سرو آزاد شد"
  },
  {
    "poem_id": 1492,
    "vorder": 277,
    "position": 0,
    "text": "ز خاکی که خون سیاوش بخورد"
  },
  {
    "poem_id": 1492,
    "vorder": 278,
    "position": 1,
    "text": "به ابر اندر آمد درختی ز گرد"
  },
  {
    "poem_id": 1492,
    "vorder": 279,
    "position": 0,
    "text": "نگاریده بر برگها چهر او"
  },
  {
    "poem_id": 1492,
    "vorder": 280,
    "position": 1,
    "text": "همه بوی مشک آمد از مهر او"
  },
  {
    "poem_id": 1492,
    "vorder": 281,
    "position": 0,
    "text": "بدی مه نشان بهاران بدی"
  },
  {
    "poem_id": 1492,
    "vorder": 282,
    "position": 1,
    "text": "پرستشگه سوگواران بدی"
  },
  {
    "poem_id": 1492,
    "vorder": 283,
    "position": 0,
    "text": "چنین است کردار این گنده پیر"
  },
  {
    "poem_id": 1492,
    "vorder": 284,
    "position": 1,
    "text": "ستاند ز فرزند پستان شیر"
  },
  {
    "poem_id": 1492,
    "vorder": 285,
    "position": 0,
    "text": "چو پیوسته شد مهر دل بر جهان"
  },
  {
    "poem_id": 1492,
    "vorder": 286,
    "position": 1,
    "text": "به خاک اندر آرد سرش ناگهان"
  },
  {
    "poem_id": 1492,
    "vorder": 287,
    "position": 0,
    "text": "تو از وی به جز شادمانی مجوی"
  },
  {
    "poem_id": 1492,
    "vorder": 288,
    "position": 1,
    "text": "به باغ جهان برگ انده مبوی"
  },
  {
    "poem_id": 1492,
    "vorder": 289,
    "position": 0,
    "text": "اگر تاج داری و گر دست تنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 290,
    "position": 1,
    "text": "نبینی همی روزگار درنگ"
  },
  {
    "poem_id": 1492,
    "vorder": 291,
    "position": 0,
    "text": "مرنجان روان کاین سرای تو نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 292,
    "position": 1,
    "text": "بجز تنگ تابوت جای تو نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 293,
    "position": 0,
    "text": "نهادن چه باید بخوردن نشین"
  },
  {
    "poem_id": 1492,
    "vorder": 294,
    "position": 1,
    "text": "بر امید گنج جهان‌آفرین"
  },
  {
    "poem_id": 1492,
    "vorder": 295,
    "position": 0,
    "text": "چو آمد به نزدیک سر تیغ شست"
  },
  {
    "poem_id": 1492,
    "vorder": 296,
    "position": 1,
    "text": "مده می که از سال شد مرد مست"
  },
  {
    "poem_id": 1492,
    "vorder": 297,
    "position": 0,
    "text": "بجای عنانم عصا داد سال"
  },
  {
    "poem_id": 1492,
    "vorder": 298,
    "position": 1,
    "text": "پراگنده شد مال و برگشت حال"
  },
  {
    "poem_id": 1492,
    "vorder": 299,
    "position": 0,
    "text": "همان دیده‌بان بر سر کوهسار"
  },
  {
    "poem_id": 1492,
    "vorder": 300,
    "position": 1,
    "text": "نبیند همی لشکر شهریار"
  },
  {
    "poem_id": 1492,
    "vorder": 301,
    "position": 0,
    "text": "کشیدن ز دشمن نداند عنان"
  },
  {
    "poem_id": 1492,
    "vorder": 302,
    "position": 1,
    "text": "مگر پیش مژگانش آید سنان"
  },
  {
    "poem_id": 1492,
    "vorder": 303,
    "position": 0,
    "text": "گرایندهٔ تیزپای نوند"
  },
  {
    "poem_id": 1492,
    "vorder": 304,
    "position": 1,
    "text": "همان شست بدخواه کردش به بند"
  },
  {
    "poem_id": 1492,
    "vorder": 305,
    "position": 0,
    "text": "همان گوش از آوای او گشت سیر"
  },
  {
    "poem_id": 1492,
    "vorder": 306,
    "position": 1,
    "text": "همش لحن بلبل هم آوای شیر"
  },
  {
    "poem_id": 1492,
    "vorder": 307,
    "position": 0,
    "text": "چو برداشتم جام پنجاه و هشت"
  },
  {
    "poem_id": 1492,
    "vorder": 308,
    "position": 1,
    "text": "نگیرم به جز یاد تابوت و تشت"
  },
  {
    "poem_id": 1492,
    "vorder": 309,
    "position": 0,
    "text": "دریغ آن گل و مشک و خوشاب سی"
  },
  {
    "poem_id": 1492,
    "vorder": 310,
    "position": 1,
    "text": "همان تیغ برندهٔ پارسی"
  },
  {
    "poem_id": 1492,
    "vorder": 311,
    "position": 0,
    "text": "نگردد همی گرد نسرین تذرو"
  },
  {
    "poem_id": 1492,
    "vorder": 312,
    "position": 1,
    "text": "گل نارون خواهد و شاخ سرو"
  },
  {
    "poem_id": 1492,
    "vorder": 313,
    "position": 0,
    "text": "همی خواهم از روشن کردگار"
  },
  {
    "poem_id": 1492,
    "vorder": 314,
    "position": 1,
    "text": "که چندان زمان یابم از روزگار"
  },
  {
    "poem_id": 1492,
    "vorder": 315,
    "position": 0,
    "text": "کزین نامور نامهٔ باستان"
  },
  {
    "poem_id": 1492,
    "vorder": 316,
    "position": 1,
    "text": "بمانم به گیتی یکی داستان"
  },
  {
    "poem_id": 1492,
    "vorder": 317,
    "position": 0,
    "text": "که هر کس که اندر سخن داد داد"
  },
  {
    "poem_id": 1492,
    "vorder": 318,
    "position": 1,
    "text": "ز من جز به نیکی نگیرند یاد"
  },
  {
    "poem_id": 1492,
    "vorder": 319,
    "position": 0,
    "text": "بدان گیتیم نیز خواهشگرست"
  },
  {
    "poem_id": 1492,
    "vorder": 320,
    "position": 1,
    "text": "که با تیغ تیزست و با افسرست"
  },
  {
    "poem_id": 1492,
    "vorder": 321,
    "position": 0,
    "text": "منم بندهٔ اهل بیت نبی"
  },
  {
    "poem_id": 1492,
    "vorder": 322,
    "position": 1,
    "text": "سرایندهٔ خاک پای وصی"
  },
  {
    "poem_id": 1492,
    "vorder": 323,
    "position": 0,
    "text": "برین زادم و هم برین بگذرم"
  },
  {
    "poem_id": 1492,
    "vorder": 324,
    "position": 1,
    "text": "چنان دان که خاک پی حیدرم"
  },
  {
    "poem_id": 1492,
    "vorder": 325,
    "position": 0,
    "text": "ابا دیگران مر مرا کار نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 326,
    "position": 1,
    "text": "بدین اندرون هیچ گفتار نیست"
  },
  {
    "poem_id": 1492,
    "vorder": 327,
    "position": 0,
    "text": "به گفتار دهقان کنون بازگرد"
  },
  {
    "poem_id": 1492,
    "vorder": 328,
    "position": 1,
    "text": "نگر تا چه گوید سراینده مرد"
  }
]