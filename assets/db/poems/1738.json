[
  {
    "poem_id": 1738,
    "vorder": 1,
    "position": 0,
    "text": "چنین تا برآمد برین چندگاه"
  },
  {
    "poem_id": 1738,
    "vorder": 2,
    "position": 1,
    "text": "به ایران پراگنده گشته سپاه"
  },
  {
    "poem_id": 1738,
    "vorder": 3,
    "position": 0,
    "text": "به روم آنک شاپور را داشتی"
  },
  {
    "poem_id": 1738,
    "vorder": 4,
    "position": 1,
    "text": "شب و روز تنهاش نگذاشتی"
  },
  {
    "poem_id": 1738,
    "vorder": 5,
    "position": 0,
    "text": "کنیزک نبودی ز شاپور شاد"
  },
  {
    "poem_id": 1738,
    "vorder": 6,
    "position": 1,
    "text": "ازان کش ز ایرانیان بد نژاد"
  },
  {
    "poem_id": 1738,
    "vorder": 7,
    "position": 0,
    "text": "شب و روز زان چرم گریان بدی"
  },
  {
    "poem_id": 1738,
    "vorder": 8,
    "position": 1,
    "text": "دل او ز شاپور بریان بدی"
  },
  {
    "poem_id": 1738,
    "vorder": 9,
    "position": 0,
    "text": "بدو گفت روزی که ای خوب روی"
  },
  {
    "poem_id": 1738,
    "vorder": 10,
    "position": 1,
    "text": "چه مردی مترس ایچ با من بگوی"
  },
  {
    "poem_id": 1738,
    "vorder": 11,
    "position": 0,
    "text": "که در چرم چو نازک اندام تو"
  },
  {
    "poem_id": 1738,
    "vorder": 12,
    "position": 1,
    "text": "همی بگسلد خواب و آرام تو"
  },
  {
    "poem_id": 1738,
    "vorder": 13,
    "position": 0,
    "text": "چو سروی بدی بر سرش گردماه"
  },
  {
    "poem_id": 1738,
    "vorder": 14,
    "position": 1,
    "text": "بران ماه کرسی ز مشک سیاه"
  },
  {
    "poem_id": 1738,
    "vorder": 15,
    "position": 0,
    "text": "کنون چنبری گشت بالای سرو"
  },
  {
    "poem_id": 1738,
    "vorder": 16,
    "position": 1,
    "text": "تن پیل وارت به کردار غرو"
  },
  {
    "poem_id": 1738,
    "vorder": 17,
    "position": 0,
    "text": "دل من همی بر تو بریان شود"
  },
  {
    "poem_id": 1738,
    "vorder": 18,
    "position": 1,
    "text": "دو چشمم شب و روز گریان شود"
  },
  {
    "poem_id": 1738,
    "vorder": 19,
    "position": 0,
    "text": "بدین سختی اندر چه جویی همی"
  },
  {
    "poem_id": 1738,
    "vorder": 20,
    "position": 1,
    "text": "که راز تو با من نگویی همی"
  },
  {
    "poem_id": 1738,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت شاپور کای خوب‌چهر"
  },
  {
    "poem_id": 1738,
    "vorder": 22,
    "position": 1,
    "text": "گرت هیچ بر من بجنبید مهر"
  },
  {
    "poem_id": 1738,
    "vorder": 23,
    "position": 0,
    "text": "به سوگند پیمانت خواهم یکی"
  },
  {
    "poem_id": 1738,
    "vorder": 24,
    "position": 1,
    "text": "کزان نگذری جاودان اندکی"
  },
  {
    "poem_id": 1738,
    "vorder": 25,
    "position": 0,
    "text": "نگویی به بدخواه راز مرا"
  },
  {
    "poem_id": 1738,
    "vorder": 26,
    "position": 1,
    "text": "کنی یاد درد و گداز مرا"
  },
  {
    "poem_id": 1738,
    "vorder": 27,
    "position": 0,
    "text": "بگویم ترا آنچ درخواستی"
  },
  {
    "poem_id": 1738,
    "vorder": 28,
    "position": 1,
    "text": "به گفتار پیدا کنم راستی"
  },
  {
    "poem_id": 1738,
    "vorder": 29,
    "position": 0,
    "text": "کنیزک به دادار سوگند خورد"
  },
  {
    "poem_id": 1738,
    "vorder": 30,
    "position": 1,
    "text": "به زنار شماس هفتاد گرد"
  },
  {
    "poem_id": 1738,
    "vorder": 31,
    "position": 0,
    "text": "به جان مسیحا و سوک صلیب"
  },
  {
    "poem_id": 1738,
    "vorder": 32,
    "position": 1,
    "text": "به دارای ایران گشته مصیب"
  },
  {
    "poem_id": 1738,
    "vorder": 33,
    "position": 0,
    "text": "که راز تو با کس نگویم ز بن"
  },
  {
    "poem_id": 1738,
    "vorder": 34,
    "position": 1,
    "text": "نجویم همی بتری زین سخن"
  },
  {
    "poem_id": 1738,
    "vorder": 35,
    "position": 0,
    "text": "همه راز شاپور با او بگفت"
  },
  {
    "poem_id": 1738,
    "vorder": 36,
    "position": 1,
    "text": "بماند آن سخن نیک و بد در نهفت"
  },
  {
    "poem_id": 1738,
    "vorder": 37,
    "position": 0,
    "text": "بدو گفت اکنون چو فرمان دهی"
  },
  {
    "poem_id": 1738,
    "vorder": 38,
    "position": 1,
    "text": "بدین راز من دل گروگان دهی"
  },
  {
    "poem_id": 1738,
    "vorder": 39,
    "position": 0,
    "text": "سر از بانوان برتر آید ترا"
  },
  {
    "poem_id": 1738,
    "vorder": 40,
    "position": 1,
    "text": "جهان زیر پای اندر آید ترا"
  },
  {
    "poem_id": 1738,
    "vorder": 41,
    "position": 0,
    "text": "به هنگام نان شیرگرم آوری"
  },
  {
    "poem_id": 1738,
    "vorder": 42,
    "position": 1,
    "text": "بپوشی سخن نرم نرم‌آوری"
  },
  {
    "poem_id": 1738,
    "vorder": 43,
    "position": 0,
    "text": "به شیر اندر آغارم این چرم خر"
  },
  {
    "poem_id": 1738,
    "vorder": 44,
    "position": 1,
    "text": "که این چرم گردد به گیتی سمر"
  },
  {
    "poem_id": 1738,
    "vorder": 45,
    "position": 0,
    "text": "پس از من بسی سالیان بگذرد"
  },
  {
    "poem_id": 1738,
    "vorder": 46,
    "position": 1,
    "text": "بگوید همی هرک دارد خرد"
  },
  {
    "poem_id": 1738,
    "vorder": 47,
    "position": 0,
    "text": "کنیزک همی خواستی شیر گرم"
  },
  {
    "poem_id": 1738,
    "vorder": 48,
    "position": 1,
    "text": "نهانی ز هرکس به آواز نرم"
  },
  {
    "poem_id": 1738,
    "vorder": 49,
    "position": 0,
    "text": "چو کشتی یکی جام برداشتی"
  },
  {
    "poem_id": 1738,
    "vorder": 50,
    "position": 1,
    "text": "بر آتش همی تیز بگذاشتی"
  },
  {
    "poem_id": 1738,
    "vorder": 51,
    "position": 0,
    "text": "به نزدیک شاپور بردی نهان"
  },
  {
    "poem_id": 1738,
    "vorder": 52,
    "position": 1,
    "text": "نگفتی نهان با کس اندر جهان"
  },
  {
    "poem_id": 1738,
    "vorder": 53,
    "position": 0,
    "text": "دو هفته سپهر اندرین گشته شد"
  },
  {
    "poem_id": 1738,
    "vorder": 54,
    "position": 1,
    "text": "به فرجام چرم خر آغشته شد"
  },
  {
    "poem_id": 1738,
    "vorder": 55,
    "position": 0,
    "text": "چو شاپور زان پوست آمد برون"
  },
  {
    "poem_id": 1738,
    "vorder": 56,
    "position": 1,
    "text": "همه دل پر از درد و تن پر ز خون"
  },
  {
    "poem_id": 1738,
    "vorder": 57,
    "position": 0,
    "text": "چنین گفت پس با کنیزک به راز"
  },
  {
    "poem_id": 1738,
    "vorder": 58,
    "position": 1,
    "text": "که ای پاک بینادل و نیک‌ساز"
  },
  {
    "poem_id": 1738,
    "vorder": 59,
    "position": 0,
    "text": "یکی چاره باید کنون ساختن"
  },
  {
    "poem_id": 1738,
    "vorder": 60,
    "position": 1,
    "text": "ز هر گونه اندیشه انداختن"
  },
  {
    "poem_id": 1738,
    "vorder": 61,
    "position": 0,
    "text": "که ما را گذر باشد از شهر روم"
  },
  {
    "poem_id": 1738,
    "vorder": 62,
    "position": 1,
    "text": "مباد آفرین بر چنین مرز و بوم"
  },
  {
    "poem_id": 1738,
    "vorder": 63,
    "position": 0,
    "text": "کنیزک بدو گفت فردا پگاه"
  },
  {
    "poem_id": 1738,
    "vorder": 64,
    "position": 1,
    "text": "شوند این بزرگان سوی جشنگاه"
  },
  {
    "poem_id": 1738,
    "vorder": 65,
    "position": 0,
    "text": "یکی جشن باشد به روم اندرون"
  },
  {
    "poem_id": 1738,
    "vorder": 66,
    "position": 1,
    "text": "که مرد و زن و کودک آید برون"
  },
  {
    "poem_id": 1738,
    "vorder": 67,
    "position": 0,
    "text": "چو کدبانو از شهر بیرون شود"
  },
  {
    "poem_id": 1738,
    "vorder": 68,
    "position": 1,
    "text": "بدان جشن خرم به هامون شود"
  },
  {
    "poem_id": 1738,
    "vorder": 69,
    "position": 0,
    "text": "شود جای خالی و من چاره‌جوی"
  },
  {
    "poem_id": 1738,
    "vorder": 70,
    "position": 1,
    "text": "بسازم نترسم ز پتیاره گوی"
  },
  {
    "poem_id": 1738,
    "vorder": 71,
    "position": 0,
    "text": "دو اسپ و دو گوپال و تیر و کمان"
  },
  {
    "poem_id": 1738,
    "vorder": 72,
    "position": 1,
    "text": "به پیش تو آرم به روشن روان"
  },
  {
    "poem_id": 1738,
    "vorder": 73,
    "position": 0,
    "text": "ببست اندر اندیشه دل را نخست"
  },
  {
    "poem_id": 1738,
    "vorder": 74,
    "position": 1,
    "text": "از آخور دو اسپ گرانمایه جست"
  },
  {
    "poem_id": 1738,
    "vorder": 75,
    "position": 0,
    "text": "همان تیغ و گوپال و برگستوان"
  },
  {
    "poem_id": 1738,
    "vorder": 76,
    "position": 1,
    "text": "همان جوشن و مغفر هندوان"
  },
  {
    "poem_id": 1738,
    "vorder": 77,
    "position": 0,
    "text": "به اندیشه دل را به جای آورید"
  },
  {
    "poem_id": 1738,
    "vorder": 78,
    "position": 1,
    "text": "خرد را بران رهنمای آورید"
  },
  {
    "poem_id": 1738,
    "vorder": 79,
    "position": 0,
    "text": "چو از باختر چشمه اندر کشید"
  },
  {
    "poem_id": 1738,
    "vorder": 80,
    "position": 1,
    "text": "شب آن چادر قار بر سر کشید"
  },
  {
    "poem_id": 1738,
    "vorder": 81,
    "position": 0,
    "text": "پراندیشه شد جان شاپور شاه"
  },
  {
    "poem_id": 1738,
    "vorder": 82,
    "position": 1,
    "text": "که فردا چه سازد کنیزک پگاه"
  }
]