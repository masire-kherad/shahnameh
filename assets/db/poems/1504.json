[
  {
    "poem_id": 1504,
    "vorder": 1,
    "position": 0,
    "text": "به نام خداوند خورشید و ماه"
  },
  {
    "poem_id": 1504,
    "vorder": 2,
    "position": 1,
    "text": "که دل را به نامش خرد داد راه"
  },
  {
    "poem_id": 1504,
    "vorder": 3,
    "position": 0,
    "text": "خداوند هستی و هم راستی"
  },
  {
    "poem_id": 1504,
    "vorder": 4,
    "position": 1,
    "text": "نخواهد ز تو کژی و کاستی"
  },
  {
    "poem_id": 1504,
    "vorder": 5,
    "position": 0,
    "text": "خداوند بهرام و کیوان و شید"
  },
  {
    "poem_id": 1504,
    "vorder": 6,
    "position": 1,
    "text": "از اویم نوید و بدویم امید"
  },
  {
    "poem_id": 1504,
    "vorder": 7,
    "position": 0,
    "text": "ستودن مر او را ندانم همی"
  },
  {
    "poem_id": 1504,
    "vorder": 8,
    "position": 1,
    "text": "از اندیشه جان برفشانم همی"
  },
  {
    "poem_id": 1504,
    "vorder": 9,
    "position": 0,
    "text": "از او گشت پیدا مکان و زمان"
  },
  {
    "poem_id": 1504,
    "vorder": 10,
    "position": 1,
    "text": "پی مور بر هستی او نشان"
  },
  {
    "poem_id": 1504,
    "vorder": 11,
    "position": 0,
    "text": "ز گردنده خورشید تا تیره خاک"
  },
  {
    "poem_id": 1504,
    "vorder": 12,
    "position": 1,
    "text": "دگر باد و آتش همان آب پاک"
  },
  {
    "poem_id": 1504,
    "vorder": 13,
    "position": 0,
    "text": "به هستی یزدان گواهی دهند"
  },
  {
    "poem_id": 1504,
    "vorder": 14,
    "position": 1,
    "text": "روان ترا آشنایی دهند"
  },
  {
    "poem_id": 1504,
    "vorder": 15,
    "position": 0,
    "text": "ز هرچ آفریدست او بی‌نیاز"
  },
  {
    "poem_id": 1504,
    "vorder": 16,
    "position": 1,
    "text": "تو در پادشاهیش گردن فراز"
  },
  {
    "poem_id": 1504,
    "vorder": 17,
    "position": 0,
    "text": "ز دستور و گنجور و از تاج و تخت"
  },
  {
    "poem_id": 1504,
    "vorder": 18,
    "position": 1,
    "text": "ز کمی و بیشی و از ناز و بخت"
  },
  {
    "poem_id": 1504,
    "vorder": 19,
    "position": 0,
    "text": "همه بی‌نیازست و ما بنده‌ایم"
  },
  {
    "poem_id": 1504,
    "vorder": 20,
    "position": 1,
    "text": "به فرمان و رایش سرافگنده‌ایم"
  },
  {
    "poem_id": 1504,
    "vorder": 21,
    "position": 0,
    "text": "شب و روز و گردان سپهر آفرید"
  },
  {
    "poem_id": 1504,
    "vorder": 22,
    "position": 1,
    "text": "خور و خواب و تندی و مهر آفرید"
  },
  {
    "poem_id": 1504,
    "vorder": 23,
    "position": 0,
    "text": "جز او را مدان کردگار بلند"
  },
  {
    "poem_id": 1504,
    "vorder": 24,
    "position": 1,
    "text": "کز او شادمانی و ز او مستمند"
  },
  {
    "poem_id": 1504,
    "vorder": 25,
    "position": 0,
    "text": "شگفتی به گیتی ز رستم بس است"
  },
  {
    "poem_id": 1504,
    "vorder": 26,
    "position": 1,
    "text": "کزو داستان بر دل هرکس است"
  },
  {
    "poem_id": 1504,
    "vorder": 27,
    "position": 0,
    "text": "سر مایهٔ مردی و جنگ از اوست"
  },
  {
    "poem_id": 1504,
    "vorder": 28,
    "position": 1,
    "text": "خردمندی و دانش و سنگ از اوست"
  },
  {
    "poem_id": 1504,
    "vorder": 29,
    "position": 0,
    "text": "به خشکی چو پیل و به دریا نهنگ"
  },
  {
    "poem_id": 1504,
    "vorder": 30,
    "position": 1,
    "text": "خردمند و بینادل و مرد سنگ"
  },
  {
    "poem_id": 1504,
    "vorder": 31,
    "position": 0,
    "text": "کنون رزم کاموس پیش آوریم"
  },
  {
    "poem_id": 1504,
    "vorder": 32,
    "position": 1,
    "text": "ز دفتر به گفتار خویش آوریم"
  }
]