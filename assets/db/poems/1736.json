[
  {
    "poem_id": 1736,
    "vorder": 1,
    "position": 0,
    "text": "ز خاور چو خورشید بنمود تاج"
  },
  {
    "poem_id": 1736,
    "vorder": 2,
    "position": 1,
    "text": "گل زرد شد بر زمین رنگ ساج"
  },
  {
    "poem_id": 1736,
    "vorder": 3,
    "position": 0,
    "text": "ز گنجور دستور بستد کلید"
  },
  {
    "poem_id": 1736,
    "vorder": 4,
    "position": 1,
    "text": "خورش خانه و خمهای نبید"
  },
  {
    "poem_id": 1736,
    "vorder": 5,
    "position": 0,
    "text": "بدژدر هرانکس که بد مهتری"
  },
  {
    "poem_id": 1736,
    "vorder": 6,
    "position": 1,
    "text": "وزان جنگیان رنج دیده سری"
  },
  {
    "poem_id": 1736,
    "vorder": 7,
    "position": 0,
    "text": "خورشها فرستاد و چندی نبید"
  },
  {
    "poem_id": 1736,
    "vorder": 8,
    "position": 1,
    "text": "هم از بویها نرگس و شنبلید"
  },
  {
    "poem_id": 1736,
    "vorder": 9,
    "position": 0,
    "text": "پرستندهٔ باده را پیش خواند"
  },
  {
    "poem_id": 1736,
    "vorder": 10,
    "position": 1,
    "text": "به خوبی سخنها فراوان براند"
  },
  {
    "poem_id": 1736,
    "vorder": 11,
    "position": 0,
    "text": "بدو گفت کامشب تویی باده‌ده"
  },
  {
    "poem_id": 1736,
    "vorder": 12,
    "position": 1,
    "text": "به طایر همه بادهٔ ساده ده"
  },
  {
    "poem_id": 1736,
    "vorder": 13,
    "position": 0,
    "text": "همان تا بدارند باده به دست"
  },
  {
    "poem_id": 1736,
    "vorder": 14,
    "position": 1,
    "text": "بدان تا بخسپند و گردند مست"
  },
  {
    "poem_id": 1736,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت ساقی که من بنده‌ام"
  },
  {
    "poem_id": 1736,
    "vorder": 16,
    "position": 1,
    "text": "به فرمان تو در جهان زنده‌ام"
  },
  {
    "poem_id": 1736,
    "vorder": 17,
    "position": 0,
    "text": "چو خورشید بر باختر گشت زرد"
  },
  {
    "poem_id": 1736,
    "vorder": 18,
    "position": 1,
    "text": "شب تیره گفتش که از راه برد"
  },
  {
    "poem_id": 1736,
    "vorder": 19,
    "position": 0,
    "text": "می خسروی خواست طایر به جام"
  },
  {
    "poem_id": 1736,
    "vorder": 20,
    "position": 1,
    "text": "نخستین ز غسانیان برد نام"
  },
  {
    "poem_id": 1736,
    "vorder": 21,
    "position": 0,
    "text": "چو بگذشت یک پاس از تیره شب"
  },
  {
    "poem_id": 1736,
    "vorder": 22,
    "position": 1,
    "text": "بیاسود طایر ز بانگ جلب"
  },
  {
    "poem_id": 1736,
    "vorder": 23,
    "position": 0,
    "text": "برفتند یکسر سوی خوابگاه"
  },
  {
    "poem_id": 1736,
    "vorder": 24,
    "position": 1,
    "text": "پرستندگان را بفرمود شاه"
  },
  {
    "poem_id": 1736,
    "vorder": 25,
    "position": 0,
    "text": "که با کس نگوید سخن جز براز"
  },
  {
    "poem_id": 1736,
    "vorder": 26,
    "position": 1,
    "text": "نهانی در دژ گشادند باز"
  },
  {
    "poem_id": 1736,
    "vorder": 27,
    "position": 0,
    "text": "بدان شاه شاپور خود چشم داشت"
  },
  {
    "poem_id": 1736,
    "vorder": 28,
    "position": 1,
    "text": "از آواز مستان به دل خشم داشت"
  },
  {
    "poem_id": 1736,
    "vorder": 29,
    "position": 0,
    "text": "چو شمع از در دژ بیفروخت گفت"
  },
  {
    "poem_id": 1736,
    "vorder": 30,
    "position": 1,
    "text": "که گشتیم با بخت بیدار جفت"
  },
  {
    "poem_id": 1736,
    "vorder": 31,
    "position": 0,
    "text": "مر آن ماه‌رخ را به پرده‌سرای"
  },
  {
    "poem_id": 1736,
    "vorder": 32,
    "position": 1,
    "text": "بفرمود تا خوب کردند جای"
  },
  {
    "poem_id": 1736,
    "vorder": 33,
    "position": 0,
    "text": "سپه را همه سر به سر گرد کرد"
  },
  {
    "poem_id": 1736,
    "vorder": 34,
    "position": 1,
    "text": "گزین کرد مردان ننگ و نبرد"
  },
  {
    "poem_id": 1736,
    "vorder": 35,
    "position": 0,
    "text": "به باره برآورد چندی سوار"
  },
  {
    "poem_id": 1736,
    "vorder": 36,
    "position": 1,
    "text": "هرانکس که بود از در کارزار"
  },
  {
    "poem_id": 1736,
    "vorder": 37,
    "position": 0,
    "text": "به دژ در شد و کشتن اندرگرفت"
  },
  {
    "poem_id": 1736,
    "vorder": 38,
    "position": 1,
    "text": "همه گنجهای کهن برگرفت"
  },
  {
    "poem_id": 1736,
    "vorder": 39,
    "position": 0,
    "text": "سپه بود با طایر اندر حصار"
  },
  {
    "poem_id": 1736,
    "vorder": 40,
    "position": 1,
    "text": "همه مست خفته فزون از هزار"
  },
  {
    "poem_id": 1736,
    "vorder": 41,
    "position": 0,
    "text": "دگر خفته آسیمه برخاستند"
  },
  {
    "poem_id": 1736,
    "vorder": 42,
    "position": 1,
    "text": "به هر جای جنگی بیاراستند"
  },
  {
    "poem_id": 1736,
    "vorder": 43,
    "position": 0,
    "text": "ازیشان کس از بیم ننمود پشت"
  },
  {
    "poem_id": 1736,
    "vorder": 44,
    "position": 1,
    "text": "بسی نامور شاه ایران بکشت"
  },
  {
    "poem_id": 1736,
    "vorder": 45,
    "position": 0,
    "text": "چو شد طایر اندر کف او اسیر"
  },
  {
    "poem_id": 1736,
    "vorder": 46,
    "position": 1,
    "text": "بیامد برهنه دوان ناگزیر"
  },
  {
    "poem_id": 1736,
    "vorder": 47,
    "position": 0,
    "text": "به چنگ وی آمد حصار و بنه"
  },
  {
    "poem_id": 1736,
    "vorder": 48,
    "position": 1,
    "text": "گرفتار شد مردم بدتنه"
  },
  {
    "poem_id": 1736,
    "vorder": 49,
    "position": 0,
    "text": "ببود آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1736,
    "vorder": 50,
    "position": 1,
    "text": "چو خورشید بنمود زرین کلاه"
  },
  {
    "poem_id": 1736,
    "vorder": 51,
    "position": 0,
    "text": "یکی تخت پیروزه اندر حصار"
  },
  {
    "poem_id": 1736,
    "vorder": 52,
    "position": 1,
    "text": "به آیین نهادند و دادند بار"
  },
  {
    "poem_id": 1736,
    "vorder": 53,
    "position": 0,
    "text": "چو از بارپردخته شد شهریار"
  },
  {
    "poem_id": 1736,
    "vorder": 54,
    "position": 1,
    "text": "به نزدیک او شد گل نوبهار"
  },
  {
    "poem_id": 1736,
    "vorder": 55,
    "position": 0,
    "text": "ز یاقوت سرخ افسری بر سرش"
  },
  {
    "poem_id": 1736,
    "vorder": 56,
    "position": 1,
    "text": "درفشان ز زربفت چینی برش"
  },
  {
    "poem_id": 1736,
    "vorder": 57,
    "position": 0,
    "text": "بدانست کای جادوی کار اوست"
  },
  {
    "poem_id": 1736,
    "vorder": 58,
    "position": 1,
    "text": "بدو بد رسیدن ز کردار اوست"
  },
  {
    "poem_id": 1736,
    "vorder": 59,
    "position": 0,
    "text": "چنین گفت کای شاه آزاد مرد"
  },
  {
    "poem_id": 1736,
    "vorder": 60,
    "position": 1,
    "text": "نگه کن که که فرزند با من چه کرد"
  },
  {
    "poem_id": 1736,
    "vorder": 61,
    "position": 0,
    "text": "چنین گفت شاپور بدنام را"
  },
  {
    "poem_id": 1736,
    "vorder": 62,
    "position": 1,
    "text": "که از پرده چون دخت بهرام را"
  },
  {
    "poem_id": 1736,
    "vorder": 63,
    "position": 0,
    "text": "بیاری و رسوا کنی دوده را"
  },
  {
    "poem_id": 1736,
    "vorder": 64,
    "position": 1,
    "text": "برانگیزی آن کین آسوده را"
  },
  {
    "poem_id": 1736,
    "vorder": 65,
    "position": 0,
    "text": "به دژخیم فرمود تا گردنش"
  },
  {
    "poem_id": 1736,
    "vorder": 66,
    "position": 1,
    "text": "زند به آتش اندر بسوزد تنش"
  },
  {
    "poem_id": 1736,
    "vorder": 67,
    "position": 0,
    "text": "سر طایر از ننگ در خون کشید"
  },
  {
    "poem_id": 1736,
    "vorder": 68,
    "position": 1,
    "text": "دو کتف وی از پشت بیرون کشید"
  },
  {
    "poem_id": 1736,
    "vorder": 69,
    "position": 0,
    "text": "هرانکس کجا یافتی از عرب"
  },
  {
    "poem_id": 1736,
    "vorder": 70,
    "position": 1,
    "text": "نماندی که با کس گشادی دو لب"
  },
  {
    "poem_id": 1736,
    "vorder": 71,
    "position": 0,
    "text": "ز دو دست او دور کردی دو کفت"
  },
  {
    "poem_id": 1736,
    "vorder": 72,
    "position": 1,
    "text": "جهان ماند از کار او در شگفت"
  },
  {
    "poem_id": 1736,
    "vorder": 73,
    "position": 0,
    "text": "عرابی ذوالاکتاف کردش لقب"
  },
  {
    "poem_id": 1736,
    "vorder": 74,
    "position": 1,
    "text": "چو از مهره بگشاد کفت عرب"
  },
  {
    "poem_id": 1736,
    "vorder": 75,
    "position": 0,
    "text": "وزانجا یگه شد سوی پارس باز"
  },
  {
    "poem_id": 1736,
    "vorder": 76,
    "position": 1,
    "text": "جهانی همه برد پیشش نماز"
  },
  {
    "poem_id": 1736,
    "vorder": 77,
    "position": 0,
    "text": "برین نیز بگذشت چندی سپهر"
  },
  {
    "poem_id": 1736,
    "vorder": 78,
    "position": 1,
    "text": "وزان پس دگرگونه بنمود چهر"
  }
]