[
  {
    "poem_id": 88018,
    "vorder": 1,
    "position": 0,
    "text": "چو سالار نوبت بیامد بدر"
  },
  {
    "poem_id": 88018,
    "vorder": 2,
    "position": 1,
    "text": "بشبگیر بستند گردان کمر"
  },
  {
    "poem_id": 88018,
    "vorder": 3,
    "position": 0,
    "text": "همه نیزه داران جنگ آوران"
  },
  {
    "poem_id": 88018,
    "vorder": 4,
    "position": 1,
    "text": "همه مرزبانان ناماوران"
  },
  {
    "poem_id": 88018,
    "vorder": 5,
    "position": 0,
    "text": "همه نیزه و تیر بار هیون"
  },
  {
    "poem_id": 88018,
    "vorder": 6,
    "position": 1,
    "text": "همه جنگ را دست شسته بخون"
  },
  {
    "poem_id": 88018,
    "vorder": 7,
    "position": 0,
    "text": "سپیده دمان گاه بانگ خروس"
  },
  {
    "poem_id": 88018,
    "vorder": 8,
    "position": 1,
    "text": "ببستند بر کوههٔ پیل کوس"
  },
  {
    "poem_id": 88018,
    "vorder": 9,
    "position": 0,
    "text": "تهمتن بیامد چو سرو بلند"
  },
  {
    "poem_id": 88018,
    "vorder": 10,
    "position": 1,
    "text": "بچنگ اندرون گرز و بر زین کمند"
  },
  {
    "poem_id": 88018,
    "vorder": 11,
    "position": 0,
    "text": "سپاه از پس پشت و گردان ز پیش"
  },
  {
    "poem_id": 88018,
    "vorder": 12,
    "position": 1,
    "text": "نهاده بکف بر همه جان خویش"
  },
  {
    "poem_id": 88018,
    "vorder": 13,
    "position": 0,
    "text": "برفت از در شاه با لشکرش"
  },
  {
    "poem_id": 88018,
    "vorder": 14,
    "position": 1,
    "text": "بسی آفرین خواند برکشورش"
  },
  {
    "poem_id": 88018,
    "vorder": 15,
    "position": 0,
    "text": "چو نزدیکی مرز توران رسید"
  },
  {
    "poem_id": 88018,
    "vorder": 16,
    "position": 1,
    "text": "سران را ز لشکر همه برگزید"
  },
  {
    "poem_id": 88018,
    "vorder": 17,
    "position": 0,
    "text": "بلشکر چنین گفت پس پهلوان"
  },
  {
    "poem_id": 88018,
    "vorder": 18,
    "position": 1,
    "text": "که ایدر بباشید روشن روان"
  },
  {
    "poem_id": 88018,
    "vorder": 19,
    "position": 0,
    "text": "مجنبید از ایدر مگر جان من"
  },
  {
    "poem_id": 88018,
    "vorder": 20,
    "position": 1,
    "text": "ز تن بگسلد پاک یزدان من"
  },
  {
    "poem_id": 88018,
    "vorder": 21,
    "position": 0,
    "text": "بسیچیده باشید مر جنگ را"
  },
  {
    "poem_id": 88018,
    "vorder": 22,
    "position": 1,
    "text": "همه تیز کرده بخون چنگ را"
  },
  {
    "poem_id": 88018,
    "vorder": 23,
    "position": 0,
    "text": "سپه بر سر مرز ایران بماند"
  },
  {
    "poem_id": 88018,
    "vorder": 24,
    "position": 1,
    "text": "خود و سرکشان سوی توران براند"
  },
  {
    "poem_id": 88018,
    "vorder": 25,
    "position": 0,
    "text": "همه جامه برسان بازارگان"
  },
  {
    "poem_id": 88018,
    "vorder": 26,
    "position": 1,
    "text": "بپوشید و بگشاد بند از میان"
  },
  {
    "poem_id": 88018,
    "vorder": 27,
    "position": 0,
    "text": "گشادند گردان کمرهای سیم"
  },
  {
    "poem_id": 88018,
    "vorder": 28,
    "position": 1,
    "text": "بپوشیدشان جامه های گلیم"
  },
  {
    "poem_id": 88018,
    "vorder": 29,
    "position": 0,
    "text": "سوی شهر توران نهادند روی"
  },
  {
    "poem_id": 88018,
    "vorder": 30,
    "position": 1,
    "text": "یکی کاروانی پر از رنگ و بوی"
  },
  {
    "poem_id": 88018,
    "vorder": 31,
    "position": 0,
    "text": "گرانمایه هفت اسب با کاروان"
  },
  {
    "poem_id": 88018,
    "vorder": 32,
    "position": 1,
    "text": "یکی رخش و دیگر نشست گوان"
  },
  {
    "poem_id": 88018,
    "vorder": 33,
    "position": 0,
    "text": "صد اشتر همه بار او گوهرا"
  },
  {
    "poem_id": 88018,
    "vorder": 34,
    "position": 1,
    "text": "صد اشتر همه جامهٔ لشکرا"
  },
  {
    "poem_id": 88018,
    "vorder": 35,
    "position": 0,
    "text": "ز بس‌های و هوی و درنگ درای"
  },
  {
    "poem_id": 88018,
    "vorder": 36,
    "position": 1,
    "text": "بکردار تهمورثی کرنای"
  },
  {
    "poem_id": 88018,
    "vorder": 37,
    "position": 0,
    "text": "همی شهر بر شهر هودج کشید"
  },
  {
    "poem_id": 88018,
    "vorder": 38,
    "position": 1,
    "text": "همی رفت تا شهر توران رسید"
  },
  {
    "poem_id": 88018,
    "vorder": 39,
    "position": 0,
    "text": "چو آمد بنزدیک شهر ختن"
  },
  {
    "poem_id": 88018,
    "vorder": 40,
    "position": 1,
    "text": "نظاره بیامد برش مرد و زن"
  },
  {
    "poem_id": 88018,
    "vorder": 41,
    "position": 0,
    "text": "همه پهلوانان توران بجای"
  },
  {
    "poem_id": 88018,
    "vorder": 42,
    "position": 1,
    "text": "شده پیش پیران ویسه بپای"
  },
  {
    "poem_id": 88018,
    "vorder": 43,
    "position": 0,
    "text": "چو پیران ویسه ز نخچیر گاه"
  },
  {
    "poem_id": 88018,
    "vorder": 44,
    "position": 1,
    "text": "بیامد تهمتن بدیدش براه"
  },
  {
    "poem_id": 88018,
    "vorder": 45,
    "position": 0,
    "text": "یکی جام زرین پر از گوهرا"
  },
  {
    "poem_id": 88018,
    "vorder": 46,
    "position": 1,
    "text": "بدیبا بپوشید رستم سرا"
  },
  {
    "poem_id": 88018,
    "vorder": 47,
    "position": 0,
    "text": "ده اسب گرانمایه با زیورش"
  },
  {
    "poem_id": 88018,
    "vorder": 48,
    "position": 1,
    "text": "بدیبا بیاراست اندر خورش"
  },
  {
    "poem_id": 88018,
    "vorder": 49,
    "position": 0,
    "text": "بفرمانبران داد و خود پیش رفت"
  },
  {
    "poem_id": 88018,
    "vorder": 50,
    "position": 1,
    "text": "بدرگاه پیران خرامید تفت"
  },
  {
    "poem_id": 88018,
    "vorder": 51,
    "position": 0,
    "text": "برو آفرین کرد کای نامور"
  },
  {
    "poem_id": 88018,
    "vorder": 52,
    "position": 1,
    "text": "بایران و توران ببخت و هنر"
  },
  {
    "poem_id": 88018,
    "vorder": 53,
    "position": 0,
    "text": "چنان کرد رویش جهاندار ساز"
  },
  {
    "poem_id": 88018,
    "vorder": 54,
    "position": 1,
    "text": "که پیران مر او را ندانست باز"
  },
  {
    "poem_id": 88018,
    "vorder": 55,
    "position": 0,
    "text": "بپرسید و گفت از کجایی بگوی"
  },
  {
    "poem_id": 88018,
    "vorder": 56,
    "position": 1,
    "text": "چه مردی و چون آمدی پوی پوی"
  },
  {
    "poem_id": 88018,
    "vorder": 57,
    "position": 0,
    "text": "بدو گفت رستم ترا کهترم"
  },
  {
    "poem_id": 88018,
    "vorder": 58,
    "position": 1,
    "text": "بشهر تو کرد ایزد آبشخورم"
  },
  {
    "poem_id": 88018,
    "vorder": 59,
    "position": 0,
    "text": "ببازارگانی ز ایران بتور"
  },
  {
    "poem_id": 88018,
    "vorder": 60,
    "position": 1,
    "text": "بپیمودم این راه دشوار و دور"
  },
  {
    "poem_id": 88018,
    "vorder": 61,
    "position": 0,
    "text": "فروشنده‌ام هم خریدار نیز"
  },
  {
    "poem_id": 88018,
    "vorder": 62,
    "position": 1,
    "text": "فروشم بخرم ز هر گونه چیز"
  },
  {
    "poem_id": 88018,
    "vorder": 63,
    "position": 0,
    "text": "بمهر تو دارم روان را نوید"
  },
  {
    "poem_id": 88018,
    "vorder": 64,
    "position": 1,
    "text": "چنین چیره شد بر دلم بر امید"
  },
  {
    "poem_id": 88018,
    "vorder": 65,
    "position": 0,
    "text": "اگر پهلوان گیردم زیر بر"
  },
  {
    "poem_id": 88018,
    "vorder": 66,
    "position": 1,
    "text": "خرم چارپای و فروشم گهر"
  },
  {
    "poem_id": 88018,
    "vorder": 67,
    "position": 0,
    "text": "هم از داد تو کس نیازاردم"
  },
  {
    "poem_id": 88018,
    "vorder": 68,
    "position": 1,
    "text": "هم از ابر مهرت گهر باردم"
  },
  {
    "poem_id": 88018,
    "vorder": 69,
    "position": 0,
    "text": "پس آن جام پر گوهر شاهوار"
  },
  {
    "poem_id": 88018,
    "vorder": 70,
    "position": 1,
    "text": "میان کیان کرد پیشش نثار"
  },
  {
    "poem_id": 88018,
    "vorder": 71,
    "position": 0,
    "text": "گرانمایه اسبان تازی‌نژاد"
  },
  {
    "poem_id": 88018,
    "vorder": 72,
    "position": 1,
    "text": "که بر مویشان گرد نفشاند باد"
  },
  {
    "poem_id": 88018,
    "vorder": 73,
    "position": 0,
    "text": "بسی آفرین کرد و آن خواسته"
  },
  {
    "poem_id": 88018,
    "vorder": 74,
    "position": 1,
    "text": "بدو داد و شد کار آراسته"
  },
  {
    "poem_id": 88018,
    "vorder": 75,
    "position": 0,
    "text": "چو پیران بدان گوهران بنگرید"
  },
  {
    "poem_id": 88018,
    "vorder": 76,
    "position": 1,
    "text": "کزان جام رخشنده آمد پدید"
  },
  {
    "poem_id": 88018,
    "vorder": 77,
    "position": 0,
    "text": "برو آفرین کرد وبنواختش"
  },
  {
    "poem_id": 88018,
    "vorder": 78,
    "position": 1,
    "text": "بران تخت پیروزه بنشاختش"
  },
  {
    "poem_id": 88018,
    "vorder": 79,
    "position": 0,
    "text": "که رو شاد و ایمن بشهر اندرا"
  },
  {
    "poem_id": 88018,
    "vorder": 80,
    "position": 1,
    "text": "کنون نزد خویشت بسازیم جا"
  },
  {
    "poem_id": 88018,
    "vorder": 81,
    "position": 0,
    "text": "کزین خواسته بر تو تیمار نیست"
  },
  {
    "poem_id": 88018,
    "vorder": 82,
    "position": 1,
    "text": "کسی را بدین با تو پیکار نیست"
  },
  {
    "poem_id": 88018,
    "vorder": 83,
    "position": 0,
    "text": "برو هرچ داری بهایی بیار"
  },
  {
    "poem_id": 88018,
    "vorder": 84,
    "position": 1,
    "text": "خریدار کن هر سوی خواستار"
  },
  {
    "poem_id": 88018,
    "vorder": 85,
    "position": 0,
    "text": "فرود آی در خان فرزند من"
  },
  {
    "poem_id": 88018,
    "vorder": 86,
    "position": 1,
    "text": "چنان باش با من که پیوند من"
  },
  {
    "poem_id": 88018,
    "vorder": 87,
    "position": 0,
    "text": "بدو گفت رستم که ای پهلوان"
  },
  {
    "poem_id": 88018,
    "vorder": 88,
    "position": 1,
    "text": "هم ایدر بباشیم با کاروان"
  },
  {
    "poem_id": 88018,
    "vorder": 89,
    "position": 0,
    "text": "که با ما ز هر گونه مردم بود"
  },
  {
    "poem_id": 88018,
    "vorder": 90,
    "position": 1,
    "text": "نباید که زان گوهری گم بود"
  },
  {
    "poem_id": 88018,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت رو برزو گیر جای"
  },
  {
    "poem_id": 88018,
    "vorder": 92,
    "position": 1,
    "text": "کنم رهنمایی بپیشت بپای"
  },
  {
    "poem_id": 88018,
    "vorder": 93,
    "position": 0,
    "text": "یکی خانه بگزید و بر ساخت کار"
  },
  {
    "poem_id": 88018,
    "vorder": 94,
    "position": 1,
    "text": "بکلبه درون رخت بنهاد و بار"
  },
  {
    "poem_id": 88018,
    "vorder": 95,
    "position": 0,
    "text": "خبر شد کز ایران یکی کاروان"
  },
  {
    "poem_id": 88018,
    "vorder": 96,
    "position": 1,
    "text": "بیامد بر نامور پهلوان"
  },
  {
    "poem_id": 88018,
    "vorder": 97,
    "position": 0,
    "text": "ز هر سو خریدار بنهاد گوش"
  },
  {
    "poem_id": 88018,
    "vorder": 98,
    "position": 1,
    "text": "چو آگاهی آمد ز گوهر فروش"
  },
  {
    "poem_id": 88018,
    "vorder": 99,
    "position": 0,
    "text": "خریدار دیبا و فرش و گهر"
  },
  {
    "poem_id": 88018,
    "vorder": 100,
    "position": 1,
    "text": "بدرگاه پیران نهادند سر"
  },
  {
    "poem_id": 88018,
    "vorder": 101,
    "position": 0,
    "text": "چو خورشید گیتی بیاراستی"
  },
  {
    "poem_id": 88018,
    "vorder": 102,
    "position": 1,
    "text": "بدان کلبه بازار برخاستی"
  }
]