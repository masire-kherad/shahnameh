[
  {
    "poem_id": 1629,
    "vorder": 1,
    "position": 0,
    "text": "شبی خفته بد ماه با شهریار"
  },
  {
    "poem_id": 1629,
    "vorder": 2,
    "position": 1,
    "text": "پر از گوهر و بوی و رنگ و نگار"
  },
  {
    "poem_id": 1629,
    "vorder": 3,
    "position": 0,
    "text": "همانا که برزد یکی تیز دم"
  },
  {
    "poem_id": 1629,
    "vorder": 4,
    "position": 1,
    "text": "شهنشاه زان تیز دم شد دژم"
  },
  {
    "poem_id": 1629,
    "vorder": 5,
    "position": 0,
    "text": "بپیچید در جامه و سر بتافت"
  },
  {
    "poem_id": 1629,
    "vorder": 6,
    "position": 1,
    "text": "که از نکهتش بوی ناخوش بیافت"
  },
  {
    "poem_id": 1629,
    "vorder": 7,
    "position": 0,
    "text": "ازان بوی شد شاه ایران دژم"
  },
  {
    "poem_id": 1629,
    "vorder": 8,
    "position": 1,
    "text": "پراندیشه جان ابروان پر ز خم"
  },
  {
    "poem_id": 1629,
    "vorder": 9,
    "position": 0,
    "text": "پزشکان داننده را خواندند"
  },
  {
    "poem_id": 1629,
    "vorder": 10,
    "position": 1,
    "text": "به نزدیک ناهید بنشاندند"
  },
  {
    "poem_id": 1629,
    "vorder": 11,
    "position": 0,
    "text": "یکی مرد بینادل و نیک‌رای"
  },
  {
    "poem_id": 1629,
    "vorder": 12,
    "position": 1,
    "text": "پژوهید تا دارو آمد به جای"
  },
  {
    "poem_id": 1629,
    "vorder": 13,
    "position": 0,
    "text": "گیاهی که سوزندهٔ کام بود"
  },
  {
    "poem_id": 1629,
    "vorder": 14,
    "position": 1,
    "text": "به روم اندر اسکندرش نام بود"
  },
  {
    "poem_id": 1629,
    "vorder": 15,
    "position": 0,
    "text": "بمالید بر کام او بر پزشک"
  },
  {
    "poem_id": 1629,
    "vorder": 16,
    "position": 1,
    "text": "ببارید چندی ز مژگان سرشک"
  },
  {
    "poem_id": 1629,
    "vorder": 17,
    "position": 0,
    "text": "بشد ناخوشی بوی و کامش بسوخت"
  },
  {
    "poem_id": 1629,
    "vorder": 18,
    "position": 1,
    "text": "به کردار دیبا رخش برفروخت"
  },
  {
    "poem_id": 1629,
    "vorder": 19,
    "position": 0,
    "text": "اگر چند مشکین شد آن خوب‌چهر"
  },
  {
    "poem_id": 1629,
    "vorder": 20,
    "position": 1,
    "text": "دژم شد دلارای را جای مهر"
  },
  {
    "poem_id": 1629,
    "vorder": 21,
    "position": 0,
    "text": "دل پادشا سرد گشت از عروس"
  },
  {
    "poem_id": 1629,
    "vorder": 22,
    "position": 1,
    "text": "فرستاد بازش بر فیلقوس"
  },
  {
    "poem_id": 1629,
    "vorder": 23,
    "position": 0,
    "text": "غمی دختر و کودک اندر نهان"
  },
  {
    "poem_id": 1629,
    "vorder": 24,
    "position": 1,
    "text": "نگفت آن سخن با کسی در جهان"
  },
  {
    "poem_id": 1629,
    "vorder": 25,
    "position": 0,
    "text": "چو نه ماه بگذشت بر خوب‌چهر"
  },
  {
    "poem_id": 1629,
    "vorder": 26,
    "position": 1,
    "text": "یکی کودک آمد چو تابنده مهر"
  },
  {
    "poem_id": 1629,
    "vorder": 27,
    "position": 0,
    "text": "ز بالا و اروند و بویا برش"
  },
  {
    "poem_id": 1629,
    "vorder": 28,
    "position": 1,
    "text": "سکندر همی خواندی مادرش"
  },
  {
    "poem_id": 1629,
    "vorder": 29,
    "position": 0,
    "text": "بفرخ همی داشت آن نام را"
  },
  {
    "poem_id": 1629,
    "vorder": 30,
    "position": 1,
    "text": "کزو یافت از ناخوشی کام را"
  },
  {
    "poem_id": 1629,
    "vorder": 31,
    "position": 0,
    "text": "همی گفت قیصر به هر مهتری"
  },
  {
    "poem_id": 1629,
    "vorder": 32,
    "position": 1,
    "text": "که پیدا شد از تخم من قیصری"
  },
  {
    "poem_id": 1629,
    "vorder": 33,
    "position": 0,
    "text": "نیاورد کس نام دارا به بر"
  },
  {
    "poem_id": 1629,
    "vorder": 34,
    "position": 1,
    "text": "سکندر پسر بود و قیصر پدر"
  },
  {
    "poem_id": 1629,
    "vorder": 35,
    "position": 0,
    "text": "همی ننگش آمد که گفتی به کس"
  },
  {
    "poem_id": 1629,
    "vorder": 36,
    "position": 1,
    "text": "که دارا ز فرزند من کرد بس"
  },
  {
    "poem_id": 1629,
    "vorder": 37,
    "position": 0,
    "text": "بر آخر یکی مادیان بد بلند"
  },
  {
    "poem_id": 1629,
    "vorder": 38,
    "position": 1,
    "text": "که کارزاری و زیبا سمند"
  },
  {
    "poem_id": 1629,
    "vorder": 39,
    "position": 0,
    "text": "همان شب یکی کره‌ای زاد خنگ"
  },
  {
    "poem_id": 1629,
    "vorder": 40,
    "position": 1,
    "text": "برش چون بر شیر و کوتاه لنگ"
  },
  {
    "poem_id": 1629,
    "vorder": 41,
    "position": 0,
    "text": "ز زاینده قیصر برافراخت یال"
  },
  {
    "poem_id": 1629,
    "vorder": 42,
    "position": 1,
    "text": "که آن زادنش فرخ آمد به فال"
  },
  {
    "poem_id": 1629,
    "vorder": 43,
    "position": 0,
    "text": "به شبگیر فرزند را خواستی"
  },
  {
    "poem_id": 1629,
    "vorder": 44,
    "position": 1,
    "text": "همان مادیان را بیاراستی"
  },
  {
    "poem_id": 1629,
    "vorder": 45,
    "position": 0,
    "text": "بسودی همان کره را چشم و یال"
  },
  {
    "poem_id": 1629,
    "vorder": 46,
    "position": 1,
    "text": "که همتای اسکندر او بد به سال"
  },
  {
    "poem_id": 1629,
    "vorder": 47,
    "position": 0,
    "text": "سپهر اندرین نیز چندی بگشت"
  },
  {
    "poem_id": 1629,
    "vorder": 48,
    "position": 1,
    "text": "ز هرگونه‌ای سالیان برگذشت"
  },
  {
    "poem_id": 1629,
    "vorder": 49,
    "position": 0,
    "text": "سکندر دل خسروانی گرفت"
  },
  {
    "poem_id": 1629,
    "vorder": 50,
    "position": 1,
    "text": "سخن گفتن پهلوانی گرفت"
  },
  {
    "poem_id": 1629,
    "vorder": 51,
    "position": 0,
    "text": "فزون از پسر داشتی قیصرش"
  },
  {
    "poem_id": 1629,
    "vorder": 52,
    "position": 1,
    "text": "بیاراستی پهلوانی برش"
  },
  {
    "poem_id": 1629,
    "vorder": 53,
    "position": 0,
    "text": "خرد یافت لختی و شد کاردان"
  },
  {
    "poem_id": 1629,
    "vorder": 54,
    "position": 1,
    "text": "هشیوار و با سنگ و بسیاردان"
  },
  {
    "poem_id": 1629,
    "vorder": 55,
    "position": 0,
    "text": "ولی عهد گشت از پس فیلقوس"
  },
  {
    "poem_id": 1629,
    "vorder": 56,
    "position": 1,
    "text": "بدیدار او داشتی نعم و بوس"
  },
  {
    "poem_id": 1629,
    "vorder": 57,
    "position": 0,
    "text": "هنرها که باشد کیان را به کار"
  },
  {
    "poem_id": 1629,
    "vorder": 58,
    "position": 1,
    "text": "سکندر بیاموخت ز آموزگار"
  },
  {
    "poem_id": 1629,
    "vorder": 59,
    "position": 0,
    "text": "تو گفتی نشاید مگر داد را"
  },
  {
    "poem_id": 1629,
    "vorder": 60,
    "position": 1,
    "text": "وگر تخت شاهی و بنیاد را"
  },
  {
    "poem_id": 1629,
    "vorder": 61,
    "position": 0,
    "text": "وزان پس که ناهید نزد پدر"
  },
  {
    "poem_id": 1629,
    "vorder": 62,
    "position": 1,
    "text": "بیامد زنی خواست دارا دگر"
  },
  {
    "poem_id": 1629,
    "vorder": 63,
    "position": 0,
    "text": "یکی کودک آمدش با فر و یال"
  },
  {
    "poem_id": 1629,
    "vorder": 64,
    "position": 1,
    "text": "ز فرزند ناهید کهتر به سال"
  },
  {
    "poem_id": 1629,
    "vorder": 65,
    "position": 0,
    "text": "همان روز داراش کردند نام"
  },
  {
    "poem_id": 1629,
    "vorder": 66,
    "position": 1,
    "text": "که تا از پدر بیش باشد به کام"
  },
  {
    "poem_id": 1629,
    "vorder": 67,
    "position": 0,
    "text": "چو ده سال بگذشت زین با دو سال"
  },
  {
    "poem_id": 1629,
    "vorder": 68,
    "position": 1,
    "text": "شکست اندر آمد به سال و به مال"
  },
  {
    "poem_id": 1629,
    "vorder": 69,
    "position": 0,
    "text": "بپژمرد داراب پور همای"
  },
  {
    "poem_id": 1629,
    "vorder": 70,
    "position": 1,
    "text": "همی خواندندش به دیگر سرای"
  },
  {
    "poem_id": 1629,
    "vorder": 71,
    "position": 0,
    "text": "بزرگان و فرزانگان را بخواند"
  },
  {
    "poem_id": 1629,
    "vorder": 72,
    "position": 1,
    "text": "ز تخت بزرگی فراوان براند"
  },
  {
    "poem_id": 1629,
    "vorder": 73,
    "position": 0,
    "text": "بگفت این که دارای داراکنون"
  },
  {
    "poem_id": 1629,
    "vorder": 74,
    "position": 1,
    "text": "شما را به نیکی بود رهنمون"
  },
  {
    "poem_id": 1629,
    "vorder": 75,
    "position": 0,
    "text": "همه گوش دارید و فرمان کنید"
  },
  {
    "poem_id": 1629,
    "vorder": 76,
    "position": 1,
    "text": "ز فرمان او رامش جان کنید"
  },
  {
    "poem_id": 1629,
    "vorder": 77,
    "position": 0,
    "text": "که این تخت شاهی نماند دراز"
  },
  {
    "poem_id": 1629,
    "vorder": 78,
    "position": 1,
    "text": "به خوشی رود زود خوانند باز"
  },
  {
    "poem_id": 1629,
    "vorder": 79,
    "position": 0,
    "text": "بکوشید تا مهر و داد آورید"
  },
  {
    "poem_id": 1629,
    "vorder": 80,
    "position": 1,
    "text": "به شادی مرا نیز یاد آورید"
  },
  {
    "poem_id": 1629,
    "vorder": 81,
    "position": 0,
    "text": "بگفت این و باد از جگر برکشید"
  },
  {
    "poem_id": 1629,
    "vorder": 82,
    "position": 1,
    "text": "شد آن برگ گلنار چون شنبلید"
  }
]