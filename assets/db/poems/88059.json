[
  {
    "poem_id": 88059,
    "vorder": 1,
    "position": 0,
    "text": "فرستاده آمد به نزدیک شاه"
  },
  {
    "poem_id": 88059,
    "vorder": 2,
    "position": 1,
    "text": "خردمند مردی ز توران سپاه"
  },
  {
    "poem_id": 88059,
    "vorder": 3,
    "position": 0,
    "text": "که ما شاه را بنده و چاکریم"
  },
  {
    "poem_id": 88059,
    "vorder": 4,
    "position": 1,
    "text": "زمین جز به فرمان او نسپریم"
  },
  {
    "poem_id": 88059,
    "vorder": 5,
    "position": 0,
    "text": "کس از خواست یزدان نیابد رها"
  },
  {
    "poem_id": 88059,
    "vorder": 6,
    "position": 1,
    "text": "اگر چه شود در دم اژدها"
  },
  {
    "poem_id": 88059,
    "vorder": 7,
    "position": 0,
    "text": "جهاندار داند که ما خود کییم"
  },
  {
    "poem_id": 88059,
    "vorder": 8,
    "position": 1,
    "text": "میان تنگ بسته ز بهر چییم"
  },
  {
    "poem_id": 88059,
    "vorder": 9,
    "position": 0,
    "text": "نبدمان به کار سیاوش گناه"
  },
  {
    "poem_id": 88059,
    "vorder": 10,
    "position": 1,
    "text": "ببرد اهرمن شاه را دل ز راه"
  },
  {
    "poem_id": 88059,
    "vorder": 11,
    "position": 0,
    "text": "که توران ز ایران همه پر غم است"
  },
  {
    "poem_id": 88059,
    "vorder": 12,
    "position": 1,
    "text": "زن و کودک خرد در ماتم است"
  },
  {
    "poem_id": 88059,
    "vorder": 13,
    "position": 0,
    "text": "نه بر آرزو کینه خواه آمدیم"
  },
  {
    "poem_id": 88059,
    "vorder": 14,
    "position": 1,
    "text": "ز بهر بر و بوم و گاه آمدیم"
  },
  {
    "poem_id": 88059,
    "vorder": 15,
    "position": 0,
    "text": "از این جنگ ما را بد آمد به سر"
  },
  {
    "poem_id": 88059,
    "vorder": 16,
    "position": 1,
    "text": "پسر بی پدر شد پدر بی پسر"
  },
  {
    "poem_id": 88059,
    "vorder": 17,
    "position": 0,
    "text": "به جان گر دهد شاهمان زینهار"
  },
  {
    "poem_id": 88059,
    "vorder": 18,
    "position": 1,
    "text": "ببندیم پیشش میان بنده‌وار"
  },
  {
    "poem_id": 88059,
    "vorder": 19,
    "position": 0,
    "text": "بدین لشکر اندر بسی مهتر است"
  },
  {
    "poem_id": 88059,
    "vorder": 20,
    "position": 1,
    "text": "کجا بندگی شاه را در خور است"
  },
  {
    "poem_id": 88059,
    "vorder": 21,
    "position": 0,
    "text": "گنهکار اوییم و او پادشاست"
  },
  {
    "poem_id": 88059,
    "vorder": 22,
    "position": 1,
    "text": "از او هرچ آید به ما بر رواست"
  },
  {
    "poem_id": 88059,
    "vorder": 23,
    "position": 0,
    "text": "سران سر به سر نزد شاه آوریم"
  },
  {
    "poem_id": 88059,
    "vorder": 24,
    "position": 1,
    "text": "بسی پوزش اندر گناه آوریم"
  },
  {
    "poem_id": 88059,
    "vorder": 25,
    "position": 0,
    "text": "گر از ما به دلش اندرون کین بود"
  },
  {
    "poem_id": 88059,
    "vorder": 26,
    "position": 1,
    "text": "بریدن سر دشمن آیین بود"
  },
  {
    "poem_id": 88059,
    "vorder": 27,
    "position": 0,
    "text": "ور ایدونک بخشایش آرد رواست"
  },
  {
    "poem_id": 88059,
    "vorder": 28,
    "position": 1,
    "text": "همان کرد باید که او را هواست"
  },
  {
    "poem_id": 88059,
    "vorder": 29,
    "position": 0,
    "text": "چو بشنید گفتار ایشان به درد"
  },
  {
    "poem_id": 88059,
    "vorder": 30,
    "position": 1,
    "text": "ببخشودشان شاه آزاد مرد"
  },
  {
    "poem_id": 88059,
    "vorder": 31,
    "position": 0,
    "text": "بفرمود تا پیش او آمدند"
  },
  {
    "poem_id": 88059,
    "vorder": 32,
    "position": 1,
    "text": "بر آن آرزو چاره‌جو آمدند"
  },
  {
    "poem_id": 88059,
    "vorder": 33,
    "position": 0,
    "text": "همه بر نهادند سر بر زمین"
  },
  {
    "poem_id": 88059,
    "vorder": 34,
    "position": 1,
    "text": "پر از خون دل و دیده پر آب کین"
  },
  {
    "poem_id": 88059,
    "vorder": 35,
    "position": 0,
    "text": "سپهبد سوی آسمان کرد سر"
  },
  {
    "poem_id": 88059,
    "vorder": 36,
    "position": 1,
    "text": "که ای دادگر داور چاره‌گر"
  },
  {
    "poem_id": 88059,
    "vorder": 37,
    "position": 0,
    "text": "همان لشکرست این که سر پر ز کین"
  },
  {
    "poem_id": 88059,
    "vorder": 38,
    "position": 1,
    "text": "همی خاک جستند ز ایران زمین"
  },
  {
    "poem_id": 88059,
    "vorder": 39,
    "position": 0,
    "text": "چنین کردشان ایزد دادگر"
  },
  {
    "poem_id": 88059,
    "vorder": 40,
    "position": 1,
    "text": "نه رای و نه دانش نه پای و نه پر"
  },
  {
    "poem_id": 88059,
    "vorder": 41,
    "position": 0,
    "text": "بدو دست یازم که او یار بس"
  },
  {
    "poem_id": 88059,
    "vorder": 42,
    "position": 1,
    "text": "ز گیتی نخواهیم فریادرس"
  },
  {
    "poem_id": 88059,
    "vorder": 43,
    "position": 0,
    "text": "بدین داستان زد یکی نیک رای"
  },
  {
    "poem_id": 88059,
    "vorder": 44,
    "position": 1,
    "text": "که از کین به زین اندر آورد پای"
  },
  {
    "poem_id": 88059,
    "vorder": 45,
    "position": 0,
    "text": "که این باره رخشنده تخت من است"
  },
  {
    "poem_id": 88059,
    "vorder": 46,
    "position": 1,
    "text": "کنون کار بیدار بخت من است"
  },
  {
    "poem_id": 88059,
    "vorder": 47,
    "position": 0,
    "text": "بدین کینه گر تخت و تاج آوریم"
  },
  {
    "poem_id": 88059,
    "vorder": 48,
    "position": 1,
    "text": "و گر رسم تابوت ساج آوریم"
  },
  {
    "poem_id": 88059,
    "vorder": 49,
    "position": 0,
    "text": "وگرنه به چنگ پلنگ اندرم"
  },
  {
    "poem_id": 88059,
    "vorder": 50,
    "position": 1,
    "text": "خور کرگسان است مغز سرم"
  },
  {
    "poem_id": 88059,
    "vorder": 51,
    "position": 0,
    "text": "کنون بر شما گشت کردار بد"
  },
  {
    "poem_id": 88059,
    "vorder": 52,
    "position": 1,
    "text": "شناسد هر آن کس که دارد خرد"
  },
  {
    "poem_id": 88059,
    "vorder": 53,
    "position": 0,
    "text": "نیم من به خون شما شسته چنگ"
  },
  {
    "poem_id": 88059,
    "vorder": 54,
    "position": 1,
    "text": "که گیرم چنین کار دشوار تنگ"
  },
  {
    "poem_id": 88059,
    "vorder": 55,
    "position": 0,
    "text": "همه یکسره در پناه منید"
  },
  {
    "poem_id": 88059,
    "vorder": 56,
    "position": 1,
    "text": "و گر چند بدخواه گاه منید"
  },
  {
    "poem_id": 88059,
    "vorder": 57,
    "position": 0,
    "text": "هر آن کس که خواهد نباشد رواست"
  },
  {
    "poem_id": 88059,
    "vorder": 58,
    "position": 1,
    "text": "بدین گفته افزایش آمد نه کاست"
  },
  {
    "poem_id": 88059,
    "vorder": 59,
    "position": 0,
    "text": "هر آن کس که خواهد سوی شاه خویش"
  },
  {
    "poem_id": 88059,
    "vorder": 60,
    "position": 1,
    "text": "گذارد نگیرم بر او راه پیش"
  },
  {
    "poem_id": 88059,
    "vorder": 61,
    "position": 0,
    "text": "ز کمی و بیشی و از رنج و آز"
  },
  {
    "poem_id": 88059,
    "vorder": 62,
    "position": 1,
    "text": "به نیروی یزدان شدم بی نیاز"
  },
  {
    "poem_id": 88059,
    "vorder": 63,
    "position": 0,
    "text": "چو ترکان شنیدند گفتار شاه"
  },
  {
    "poem_id": 88059,
    "vorder": 64,
    "position": 1,
    "text": "ز سر بر گرفتند یکسر کلاه"
  },
  {
    "poem_id": 88059,
    "vorder": 65,
    "position": 0,
    "text": "به پیروزی شاه خستو شدند"
  },
  {
    "poem_id": 88059,
    "vorder": 66,
    "position": 1,
    "text": "پلنگان جنگی چو آهو شدند"
  },
  {
    "poem_id": 88059,
    "vorder": 67,
    "position": 0,
    "text": "بفرمود شاه جهان تا سلیح"
  },
  {
    "poem_id": 88059,
    "vorder": 68,
    "position": 1,
    "text": "بیارند تیغ و سنان و رمیح"
  },
  {
    "poem_id": 88059,
    "vorder": 69,
    "position": 0,
    "text": "ز برگستوان و ز رومی کلاه"
  },
  {
    "poem_id": 88059,
    "vorder": 70,
    "position": 1,
    "text": "یکی توده کردند نزدیک شاه"
  },
  {
    "poem_id": 88059,
    "vorder": 71,
    "position": 0,
    "text": "به گرد اندرش سرخ و زرد و بنفش"
  },
  {
    "poem_id": 88059,
    "vorder": 72,
    "position": 1,
    "text": "زدند آن سرافراز ترکان درفش"
  },
  {
    "poem_id": 88059,
    "vorder": 73,
    "position": 0,
    "text": "بخوردند سوگندهای گران"
  },
  {
    "poem_id": 88059,
    "vorder": 74,
    "position": 1,
    "text": "که تا زنده‌ایم از کران تا کران"
  },
  {
    "poem_id": 88059,
    "vorder": 75,
    "position": 0,
    "text": "همه شاه را چاکر و بنده‌ایم"
  },
  {
    "poem_id": 88059,
    "vorder": 76,
    "position": 1,
    "text": "همه دل به مهر وی آگنده‌ایم"
  },
  {
    "poem_id": 88059,
    "vorder": 77,
    "position": 0,
    "text": "چو این کرده بودند بیدار شاه"
  },
  {
    "poem_id": 88059,
    "vorder": 78,
    "position": 1,
    "text": "ببخشید یکسر همه بر سپاه"
  },
  {
    "poem_id": 88059,
    "vorder": 79,
    "position": 0,
    "text": "ز همشان پس آنگه پراگنده کرد"
  },
  {
    "poem_id": 88059,
    "vorder": 80,
    "position": 1,
    "text": "همه بومش از مردم آگنده کرد"
  }
]