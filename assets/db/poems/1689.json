[
  {
    "poem_id": 1689,
    "vorder": 1,
    "position": 0,
    "text": "چو دارا به رزم اندرون کشته شد"
  },
  {
    "poem_id": 1689,
    "vorder": 2,
    "position": 1,
    "text": "همه دوده را روز برگشته شد"
  },
  {
    "poem_id": 1689,
    "vorder": 3,
    "position": 0,
    "text": "پسر بد مر او را یکی شادکام"
  },
  {
    "poem_id": 1689,
    "vorder": 4,
    "position": 1,
    "text": "خردمند و جنگی و ساسان به نام"
  },
  {
    "poem_id": 1689,
    "vorder": 5,
    "position": 0,
    "text": "پدر را بران گونه چون کشته دید"
  },
  {
    "poem_id": 1689,
    "vorder": 6,
    "position": 1,
    "text": "سر بخت ایرانیان گشته دید"
  },
  {
    "poem_id": 1689,
    "vorder": 7,
    "position": 0,
    "text": "ازان لشکر روم بگریخت اوی"
  },
  {
    "poem_id": 1689,
    "vorder": 8,
    "position": 1,
    "text": "به دام بلا در نیاویخت اوی"
  },
  {
    "poem_id": 1689,
    "vorder": 9,
    "position": 0,
    "text": "به هندوستان در به زاری بمرد"
  },
  {
    "poem_id": 1689,
    "vorder": 10,
    "position": 1,
    "text": "ز ساسان یکی کودکی ماند خرد"
  },
  {
    "poem_id": 1689,
    "vorder": 11,
    "position": 0,
    "text": "بدین هم‌نشان تا چهارم پسر"
  },
  {
    "poem_id": 1689,
    "vorder": 12,
    "position": 1,
    "text": "همی نام ساسانش کردی پدر"
  },
  {
    "poem_id": 1689,
    "vorder": 13,
    "position": 0,
    "text": "شبانان بدندی و گر ساربان"
  },
  {
    "poem_id": 1689,
    "vorder": 14,
    "position": 1,
    "text": "همه ساله با رنج و کار گران"
  },
  {
    "poem_id": 1689,
    "vorder": 15,
    "position": 0,
    "text": "چو کهتر پسر سوی بابک رسید"
  },
  {
    "poem_id": 1689,
    "vorder": 16,
    "position": 1,
    "text": "به دشت اندرون سر شبان را بدید"
  },
  {
    "poem_id": 1689,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت مزدورت آید به کار"
  },
  {
    "poem_id": 1689,
    "vorder": 18,
    "position": 1,
    "text": "که ایدر گذارد به بد روزگار"
  },
  {
    "poem_id": 1689,
    "vorder": 19,
    "position": 0,
    "text": "بپذرفت بدبخت را سرشبان"
  },
  {
    "poem_id": 1689,
    "vorder": 20,
    "position": 1,
    "text": "همی داشت با رنج روز و شبان"
  },
  {
    "poem_id": 1689,
    "vorder": 21,
    "position": 0,
    "text": "چو شد کارگر مرد و آمد پسند"
  },
  {
    "poem_id": 1689,
    "vorder": 22,
    "position": 1,
    "text": "شبان سرشبان گشت بر گوسفند"
  },
  {
    "poem_id": 1689,
    "vorder": 23,
    "position": 0,
    "text": "دران روزگاری همی بود مرد"
  },
  {
    "poem_id": 1689,
    "vorder": 24,
    "position": 1,
    "text": "پر از غم دل و تن پر از رنج و درد"
  },
  {
    "poem_id": 1689,
    "vorder": 25,
    "position": 0,
    "text": "شبی خفته بد بابک رود یاب (؟)"
  },
  {
    "poem_id": 1689,
    "vorder": 26,
    "position": 1,
    "text": "چنان دید روشن روانش به خاب"
  },
  {
    "poem_id": 1689,
    "vorder": 27,
    "position": 0,
    "text": "که ساسان به پیل ژیان برنشست"
  },
  {
    "poem_id": 1689,
    "vorder": 28,
    "position": 1,
    "text": "یکی تیغ هندی گرفته به دست"
  },
  {
    "poem_id": 1689,
    "vorder": 29,
    "position": 0,
    "text": "هرانکس که آمد بر او فراز"
  },
  {
    "poem_id": 1689,
    "vorder": 30,
    "position": 1,
    "text": "برو آفرین کرد و بردش نماز"
  },
  {
    "poem_id": 1689,
    "vorder": 31,
    "position": 0,
    "text": "زمین را به خوبی بیاراستی"
  },
  {
    "poem_id": 1689,
    "vorder": 32,
    "position": 1,
    "text": "دل تیره از غم بپیراستی"
  },
  {
    "poem_id": 1689,
    "vorder": 33,
    "position": 0,
    "text": "به دیگر شب‌اندر چو بابک بخفت"
  },
  {
    "poem_id": 1689,
    "vorder": 34,
    "position": 1,
    "text": "همی بود با مغزش اندیشه جفت"
  },
  {
    "poem_id": 1689,
    "vorder": 35,
    "position": 0,
    "text": "چنان دید در خواب کاتش‌پرست"
  },
  {
    "poem_id": 1689,
    "vorder": 36,
    "position": 1,
    "text": "سه آتش ببردی فروزان به دست"
  },
  {
    "poem_id": 1689,
    "vorder": 37,
    "position": 0,
    "text": "چو آذر گشسپ و چو خراد و مهر"
  },
  {
    "poem_id": 1689,
    "vorder": 38,
    "position": 1,
    "text": "فروزان به کردار گردان سپهر"
  },
  {
    "poem_id": 1689,
    "vorder": 39,
    "position": 0,
    "text": "همه پیش ساسان فروزان بدی"
  },
  {
    "poem_id": 1689,
    "vorder": 40,
    "position": 1,
    "text": "به هر آتشی عود سوزان بدی"
  },
  {
    "poem_id": 1689,
    "vorder": 41,
    "position": 0,
    "text": "سر بابک از خواب بیدار شد"
  },
  {
    "poem_id": 1689,
    "vorder": 42,
    "position": 1,
    "text": "روان و دلش پر ز تیمار شد"
  },
  {
    "poem_id": 1689,
    "vorder": 43,
    "position": 0,
    "text": "هرانکس که در خواب دانا بدند"
  },
  {
    "poem_id": 1689,
    "vorder": 44,
    "position": 1,
    "text": "به هر دانشی بر توانا بدند"
  },
  {
    "poem_id": 1689,
    "vorder": 45,
    "position": 0,
    "text": "به ایوان بابک شدند انجمن"
  },
  {
    "poem_id": 1689,
    "vorder": 46,
    "position": 1,
    "text": "بزرگان فرزانه و رای زن"
  },
  {
    "poem_id": 1689,
    "vorder": 47,
    "position": 0,
    "text": "چو بابک سخن برگشاد از نهفت"
  },
  {
    "poem_id": 1689,
    "vorder": 48,
    "position": 1,
    "text": "همه خواب یکسر بدیشان بگفت"
  },
  {
    "poem_id": 1689,
    "vorder": 49,
    "position": 0,
    "text": "پراندیشه شد زان سخن رهنمای"
  },
  {
    "poem_id": 1689,
    "vorder": 50,
    "position": 1,
    "text": "نهاده برو گوش پاسخ‌سرای"
  },
  {
    "poem_id": 1689,
    "vorder": 51,
    "position": 0,
    "text": "سرانجام گفت ای سرافراز شاه"
  },
  {
    "poem_id": 1689,
    "vorder": 52,
    "position": 1,
    "text": "به تأویل این کرد باید نگاه"
  },
  {
    "poem_id": 1689,
    "vorder": 53,
    "position": 0,
    "text": "کسی را که بینند زین سان به خواب"
  },
  {
    "poem_id": 1689,
    "vorder": 54,
    "position": 1,
    "text": "به شاهی برآرد سر از آفتاب"
  },
  {
    "poem_id": 1689,
    "vorder": 55,
    "position": 0,
    "text": "ور ایدونک این خواب زو بگذرد"
  },
  {
    "poem_id": 1689,
    "vorder": 56,
    "position": 1,
    "text": "پسر باشدش کز جهان بر خورد"
  },
  {
    "poem_id": 1689,
    "vorder": 57,
    "position": 0,
    "text": "چو بابک شنید این سخن گشت شاد"
  },
  {
    "poem_id": 1689,
    "vorder": 58,
    "position": 1,
    "text": "براندازه‌شان یک به یک هدیه داد"
  },
  {
    "poem_id": 1689,
    "vorder": 59,
    "position": 0,
    "text": "بفرمود تا سرشبان از رمه"
  },
  {
    "poem_id": 1689,
    "vorder": 60,
    "position": 1,
    "text": "بر بابک آید به روز دمه"
  },
  {
    "poem_id": 1689,
    "vorder": 61,
    "position": 0,
    "text": "بیامد شبان پیش او با گلیم"
  },
  {
    "poem_id": 1689,
    "vorder": 62,
    "position": 1,
    "text": "پر از برف پشمینه دل بدو نیم"
  },
  {
    "poem_id": 1689,
    "vorder": 63,
    "position": 0,
    "text": "بپردخت بابک ز بیگانه جای"
  },
  {
    "poem_id": 1689,
    "vorder": 64,
    "position": 1,
    "text": "بدر شد پرستنده و رهنمای"
  },
  {
    "poem_id": 1689,
    "vorder": 65,
    "position": 0,
    "text": "ز ساسان بپرسید و بنواختش"
  },
  {
    "poem_id": 1689,
    "vorder": 66,
    "position": 1,
    "text": "بر خویش نزدیک بنشاختش"
  },
  {
    "poem_id": 1689,
    "vorder": 67,
    "position": 0,
    "text": "بپرسیدش از گوهر و از نژاد"
  },
  {
    "poem_id": 1689,
    "vorder": 68,
    "position": 1,
    "text": "شبان زو بترسید و پاسخ نداد"
  },
  {
    "poem_id": 1689,
    "vorder": 69,
    "position": 0,
    "text": "ازان پس بدو گفت کای شهریار"
  },
  {
    "poem_id": 1689,
    "vorder": 70,
    "position": 1,
    "text": "شبان را به جان گر دهی زینهار"
  },
  {
    "poem_id": 1689,
    "vorder": 71,
    "position": 0,
    "text": "بگوید ز گوهر همه هرچ هست"
  },
  {
    "poem_id": 1689,
    "vorder": 72,
    "position": 1,
    "text": "چو دستم بگیری به پیمان به دست"
  },
  {
    "poem_id": 1689,
    "vorder": 73,
    "position": 0,
    "text": "که با من نسازی بدی در جهان"
  },
  {
    "poem_id": 1689,
    "vorder": 74,
    "position": 1,
    "text": "نه بر آشکار و نه اندر نهان"
  },
  {
    "poem_id": 1689,
    "vorder": 75,
    "position": 0,
    "text": "چو بشنید بابک زبان برگشاد"
  },
  {
    "poem_id": 1689,
    "vorder": 76,
    "position": 1,
    "text": "ز یزدان نیکی دهش کرد یاد"
  },
  {
    "poem_id": 1689,
    "vorder": 77,
    "position": 0,
    "text": "که بر تو نسازم به چیزی گزند"
  },
  {
    "poem_id": 1689,
    "vorder": 78,
    "position": 1,
    "text": "بدارمت شادان‌دل و ارجمند"
  },
  {
    "poem_id": 1689,
    "vorder": 79,
    "position": 0,
    "text": "به بابک چنین گفت زان پس جوان"
  },
  {
    "poem_id": 1689,
    "vorder": 80,
    "position": 1,
    "text": "که من پور ساسانم ای پهلوان"
  },
  {
    "poem_id": 1689,
    "vorder": 81,
    "position": 0,
    "text": "نبیرهٔ جهاندار شاه اردشیر"
  },
  {
    "poem_id": 1689,
    "vorder": 82,
    "position": 1,
    "text": "که بهمنش خواندی همی یادگیر"
  },
  {
    "poem_id": 1689,
    "vorder": 83,
    "position": 0,
    "text": "سرافراز پور یل اسفندیار"
  },
  {
    "poem_id": 1689,
    "vorder": 84,
    "position": 1,
    "text": "ز گشتاسپ یل در جهان یادگار"
  },
  {
    "poem_id": 1689,
    "vorder": 85,
    "position": 0,
    "text": "چو بشنید بابک فرو ریخت آب"
  },
  {
    "poem_id": 1689,
    "vorder": 86,
    "position": 1,
    "text": "ازان چشم روشن که او دید خواب"
  },
  {
    "poem_id": 1689,
    "vorder": 87,
    "position": 0,
    "text": "بیاورد پس جامهٔ پهلوی"
  },
  {
    "poem_id": 1689,
    "vorder": 88,
    "position": 1,
    "text": "یکی باره با آلت خسروی"
  },
  {
    "poem_id": 1689,
    "vorder": 89,
    "position": 0,
    "text": "بدو گفت بابک به گرمابه شو"
  },
  {
    "poem_id": 1689,
    "vorder": 90,
    "position": 1,
    "text": "همی باش تا خلعت آرند نو"
  },
  {
    "poem_id": 1689,
    "vorder": 91,
    "position": 0,
    "text": "یکی کاخ پرمایه او را بساخت"
  },
  {
    "poem_id": 1689,
    "vorder": 92,
    "position": 1,
    "text": "ازان سرشبانان سرش برافراخت"
  },
  {
    "poem_id": 1689,
    "vorder": 93,
    "position": 0,
    "text": "چو او را بران کاخ بر جای کرد"
  },
  {
    "poem_id": 1689,
    "vorder": 94,
    "position": 1,
    "text": "غلام و پرستنده بر پای کرد"
  },
  {
    "poem_id": 1689,
    "vorder": 95,
    "position": 0,
    "text": "به هر آلتی سرفرازیش داد"
  },
  {
    "poem_id": 1689,
    "vorder": 96,
    "position": 1,
    "text": "هم از خواسته بی‌نیازیش داد"
  },
  {
    "poem_id": 1689,
    "vorder": 97,
    "position": 0,
    "text": "بدو داد پس دختر خویش را"
  },
  {
    "poem_id": 1689,
    "vorder": 98,
    "position": 1,
    "text": "پسندیده و افسر خویش را"
  }
]