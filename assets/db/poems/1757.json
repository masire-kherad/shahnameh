[
  {
    "poem_id": 1757,
    "vorder": 1,
    "position": 0,
    "text": "دگر هفته با لشکری سرفراز"
  },
  {
    "poem_id": 1757,
    "vorder": 2,
    "position": 1,
    "text": "به نخچیرگه رفت با یوز و باز"
  },
  {
    "poem_id": 1757,
    "vorder": 3,
    "position": 0,
    "text": "برابر ز کوهی یکی شیر دید"
  },
  {
    "poem_id": 1757,
    "vorder": 4,
    "position": 1,
    "text": "کجا پشت گوری همی بر درید"
  },
  {
    "poem_id": 1757,
    "vorder": 5,
    "position": 0,
    "text": "برآورد زاغ سیه را بزه"
  },
  {
    "poem_id": 1757,
    "vorder": 6,
    "position": 1,
    "text": "به تندی به شست سه‌پر زد گره"
  },
  {
    "poem_id": 1757,
    "vorder": 7,
    "position": 0,
    "text": "دل گور بردوخت با پشت شیر"
  },
  {
    "poem_id": 1757,
    "vorder": 8,
    "position": 1,
    "text": "پر از خون هژبر از بر و گور زیر"
  },
  {
    "poem_id": 1757,
    "vorder": 9,
    "position": 0,
    "text": "چو او گور و شیر دلاور بکشت"
  },
  {
    "poem_id": 1757,
    "vorder": 10,
    "position": 1,
    "text": "به ایوان خرامید تیغی به مشت"
  },
  {
    "poem_id": 1757,
    "vorder": 11,
    "position": 0,
    "text": "دگر هفته نعمان و منذر به راه"
  },
  {
    "poem_id": 1757,
    "vorder": 12,
    "position": 1,
    "text": "همی رفت با او به نخچیرگاه"
  },
  {
    "poem_id": 1757,
    "vorder": 13,
    "position": 0,
    "text": "بسی نامور برده از تازیان"
  },
  {
    "poem_id": 1757,
    "vorder": 14,
    "position": 1,
    "text": "کزیشان بدی راه سود و زیان"
  },
  {
    "poem_id": 1757,
    "vorder": 15,
    "position": 0,
    "text": "همی خواست منذر که بهرام گور"
  },
  {
    "poem_id": 1757,
    "vorder": 16,
    "position": 1,
    "text": "بدیشان نماید سواری و زور"
  },
  {
    "poem_id": 1757,
    "vorder": 17,
    "position": 0,
    "text": "شترمرغ دیدند جایی گله"
  },
  {
    "poem_id": 1757,
    "vorder": 18,
    "position": 1,
    "text": "دوان هر یکی چون هیونی یله"
  },
  {
    "poem_id": 1757,
    "vorder": 19,
    "position": 0,
    "text": "چو بهرام‌گور آن شترمرغ دید"
  },
  {
    "poem_id": 1757,
    "vorder": 20,
    "position": 1,
    "text": "به کردار باد هوا بردمید"
  },
  {
    "poem_id": 1757,
    "vorder": 21,
    "position": 0,
    "text": "کمان را بمالید خندان به چنگ"
  },
  {
    "poem_id": 1757,
    "vorder": 22,
    "position": 1,
    "text": "بزد بر کمر چار تیر خدنگ"
  },
  {
    "poem_id": 1757,
    "vorder": 23,
    "position": 0,
    "text": "یکایک همی راند اندر کمان"
  },
  {
    "poem_id": 1757,
    "vorder": 24,
    "position": 1,
    "text": "بدان تا سرآرد بریشان زمان"
  },
  {
    "poem_id": 1757,
    "vorder": 25,
    "position": 0,
    "text": "همی برشکافید پرشان به تیر"
  },
  {
    "poem_id": 1757,
    "vorder": 26,
    "position": 1,
    "text": "بدین سان زند مرد نخچیرگیر"
  },
  {
    "poem_id": 1757,
    "vorder": 27,
    "position": 0,
    "text": "به یک سوزن این زان فزون‌تر نبود"
  },
  {
    "poem_id": 1757,
    "vorder": 28,
    "position": 1,
    "text": "همان تیر زین تیر برتر نبود"
  },
  {
    "poem_id": 1757,
    "vorder": 29,
    "position": 0,
    "text": "برفت و بدید آنک بد نامدار"
  },
  {
    "poem_id": 1757,
    "vorder": 30,
    "position": 1,
    "text": "به یک موی‌بر بود زخم سوار"
  },
  {
    "poem_id": 1757,
    "vorder": 31,
    "position": 0,
    "text": "همی آفرین خواند منذر بدوی"
  },
  {
    "poem_id": 1757,
    "vorder": 32,
    "position": 1,
    "text": "همان نیزه‌داران پرخاشجوی"
  },
  {
    "poem_id": 1757,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت منذر که ای شهریار"
  },
  {
    "poem_id": 1757,
    "vorder": 34,
    "position": 1,
    "text": "بتو شادمانم چو گلبن به بار"
  },
  {
    "poem_id": 1757,
    "vorder": 35,
    "position": 0,
    "text": "مبادا که خم آورد ماه تو"
  },
  {
    "poem_id": 1757,
    "vorder": 36,
    "position": 1,
    "text": "وگر سست گردد کمرگاه تو"
  },
  {
    "poem_id": 1757,
    "vorder": 37,
    "position": 0,
    "text": "هم‌انگه چون منذر به ایوان رسید"
  },
  {
    "poem_id": 1757,
    "vorder": 38,
    "position": 1,
    "text": "ز بهرام رایش به کیوان رسید"
  },
  {
    "poem_id": 1757,
    "vorder": 39,
    "position": 0,
    "text": "فراوان مصور بجست از یمن"
  },
  {
    "poem_id": 1757,
    "vorder": 40,
    "position": 1,
    "text": "شدند این سران بر درش انجمن"
  },
  {
    "poem_id": 1757,
    "vorder": 41,
    "position": 0,
    "text": "بفرمود تا زخم او را به تیر"
  },
  {
    "poem_id": 1757,
    "vorder": 42,
    "position": 1,
    "text": "مصور نگاری کند بر حریر"
  },
  {
    "poem_id": 1757,
    "vorder": 43,
    "position": 0,
    "text": "سواری چو بهرام با یال و کفت"
  },
  {
    "poem_id": 1757,
    "vorder": 44,
    "position": 1,
    "text": "بلند اشتری زیر و زخمی شگفت"
  },
  {
    "poem_id": 1757,
    "vorder": 45,
    "position": 0,
    "text": "کمان مهره و شیر و آهو و گور"
  },
  {
    "poem_id": 1757,
    "vorder": 46,
    "position": 1,
    "text": "گشاده بر و چربه دستی به زور"
  },
  {
    "poem_id": 1757,
    "vorder": 47,
    "position": 0,
    "text": "شترمرغ و هامون و آن زخم تیر"
  },
  {
    "poem_id": 1757,
    "vorder": 48,
    "position": 1,
    "text": "ز قیر سیه تازه شد بر حریر"
  },
  {
    "poem_id": 1757,
    "vorder": 49,
    "position": 0,
    "text": "سواری برافگند زی شهریار"
  },
  {
    "poem_id": 1757,
    "vorder": 50,
    "position": 1,
    "text": "فرستاد نزدیک او آن نگار"
  },
  {
    "poem_id": 1757,
    "vorder": 51,
    "position": 0,
    "text": "فرستاده چون شد بر یزدگرد"
  },
  {
    "poem_id": 1757,
    "vorder": 52,
    "position": 1,
    "text": "همه لشکر آمد بران نامه گرد"
  },
  {
    "poem_id": 1757,
    "vorder": 53,
    "position": 0,
    "text": "همه نامداران فروماندند"
  },
  {
    "poem_id": 1757,
    "vorder": 54,
    "position": 1,
    "text": "به بهرام بر آفرین خواندند"
  },
  {
    "poem_id": 1757,
    "vorder": 55,
    "position": 0,
    "text": "وزان پس هنرها چو کردی به کار"
  },
  {
    "poem_id": 1757,
    "vorder": 56,
    "position": 1,
    "text": "همی تاختندی بر شهریار"
  }
]