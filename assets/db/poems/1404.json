[
  {
    "poem_id": 1404,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاهی آمد به سام دلیر"
  },
  {
    "poem_id": 1404,
    "vorder": 2,
    "position": 1,
    "text": "که شد پور دستان همانند شیر"
  },
  {
    "poem_id": 1404,
    "vorder": 3,
    "position": 0,
    "text": "کس اندر جهان کودک نارسید"
  },
  {
    "poem_id": 1404,
    "vorder": 4,
    "position": 1,
    "text": "بدین شیر مردی و گردی ندید"
  },
  {
    "poem_id": 1404,
    "vorder": 5,
    "position": 0,
    "text": "بجنبید مرسام را دل ز جای"
  },
  {
    "poem_id": 1404,
    "vorder": 6,
    "position": 1,
    "text": "به دیدار آن کودک آمدش رای"
  },
  {
    "poem_id": 1404,
    "vorder": 7,
    "position": 0,
    "text": "سپه را به سالار لشکر سپرد"
  },
  {
    "poem_id": 1404,
    "vorder": 8,
    "position": 1,
    "text": "برفت و جهاندیدگان را ببرد"
  },
  {
    "poem_id": 1404,
    "vorder": 9,
    "position": 0,
    "text": "چو مهرش سوی پور دستان کشید"
  },
  {
    "poem_id": 1404,
    "vorder": 10,
    "position": 1,
    "text": "سپه را سوی زاولستان کشید"
  },
  {
    "poem_id": 1404,
    "vorder": 11,
    "position": 0,
    "text": "چو زال آگهی یافت بر بست کوس"
  },
  {
    "poem_id": 1404,
    "vorder": 12,
    "position": 1,
    "text": "ز لشکر زمین گشت چون آبنوس"
  },
  {
    "poem_id": 1404,
    "vorder": 13,
    "position": 0,
    "text": "خود و گرد مهراب کابل خدای"
  },
  {
    "poem_id": 1404,
    "vorder": 14,
    "position": 1,
    "text": "پذیره شدن را نهادند رای"
  },
  {
    "poem_id": 1404,
    "vorder": 15,
    "position": 0,
    "text": "بزد مهره در جام و برخاست غو"
  },
  {
    "poem_id": 1404,
    "vorder": 16,
    "position": 1,
    "text": "برآمد ز هر دو سپه دار و رو"
  },
  {
    "poem_id": 1404,
    "vorder": 17,
    "position": 0,
    "text": "یکی لشکر از کوه تا کوه مرد"
  },
  {
    "poem_id": 1404,
    "vorder": 18,
    "position": 1,
    "text": "زمین قیرگون و هوا لاژورد"
  },
  {
    "poem_id": 1404,
    "vorder": 19,
    "position": 0,
    "text": "خروشیدن تازی اسپان و پیل"
  },
  {
    "poem_id": 1404,
    "vorder": 20,
    "position": 1,
    "text": "همی رفت آواز تا چند میل"
  },
  {
    "poem_id": 1404,
    "vorder": 21,
    "position": 0,
    "text": "یکی ژنده پیلی بیاراستند"
  },
  {
    "poem_id": 1404,
    "vorder": 22,
    "position": 1,
    "text": "برو تخت زرین بپیراستند"
  },
  {
    "poem_id": 1404,
    "vorder": 23,
    "position": 0,
    "text": "نشست از بر تخت زر پور زال"
  },
  {
    "poem_id": 1404,
    "vorder": 24,
    "position": 1,
    "text": "ابا بازوی شیر و با کتف و یال"
  },
  {
    "poem_id": 1404,
    "vorder": 25,
    "position": 0,
    "text": "به سر برش تاج و کمر بر میان"
  },
  {
    "poem_id": 1404,
    "vorder": 26,
    "position": 1,
    "text": "سپر پیش و در دست گرز گران"
  },
  {
    "poem_id": 1404,
    "vorder": 27,
    "position": 0,
    "text": "چو از دور سام یل آمد پدید"
  },
  {
    "poem_id": 1404,
    "vorder": 28,
    "position": 1,
    "text": "سپه بر دو رویه رده برکشید"
  },
  {
    "poem_id": 1404,
    "vorder": 29,
    "position": 0,
    "text": "فرود آمد از باره مهراب و زال"
  },
  {
    "poem_id": 1404,
    "vorder": 30,
    "position": 1,
    "text": "بزرگان که بودند بسیار سال"
  },
  {
    "poem_id": 1404,
    "vorder": 31,
    "position": 0,
    "text": "یکایک نهادند سر بر زمین"
  },
  {
    "poem_id": 1404,
    "vorder": 32,
    "position": 1,
    "text": "ابر سام یل خواندند آفرین"
  },
  {
    "poem_id": 1404,
    "vorder": 33,
    "position": 0,
    "text": "چو گل چهرهٔ سام یل بشکفید"
  },
  {
    "poem_id": 1404,
    "vorder": 34,
    "position": 1,
    "text": "چو بر پیل بر بچهٔ شیر دید"
  },
  {
    "poem_id": 1404,
    "vorder": 35,
    "position": 0,
    "text": "چنان همش بر پیل پیش آورید"
  },
  {
    "poem_id": 1404,
    "vorder": 36,
    "position": 1,
    "text": "نگه کرد و با تاج و تختش بدید"
  },
  {
    "poem_id": 1404,
    "vorder": 37,
    "position": 0,
    "text": "یکی آفرین کرد سام دلیر"
  },
  {
    "poem_id": 1404,
    "vorder": 38,
    "position": 1,
    "text": "که تهما هژبرا بزی شاد دیر"
  },
  {
    "poem_id": 1404,
    "vorder": 39,
    "position": 0,
    "text": "ببوسید رستمش تخت ای شگفت"
  },
  {
    "poem_id": 1404,
    "vorder": 40,
    "position": 1,
    "text": "نیا را یکی نو ستایش گرفت"
  },
  {
    "poem_id": 1404,
    "vorder": 41,
    "position": 0,
    "text": "که ای پهلوان جهان شاد باش"
  },
  {
    "poem_id": 1404,
    "vorder": 42,
    "position": 1,
    "text": "ز شاخ توام من تو بنیاد باش"
  },
  {
    "poem_id": 1404,
    "vorder": 43,
    "position": 0,
    "text": "یکی بنده‌ام نامور سام را"
  },
  {
    "poem_id": 1404,
    "vorder": 44,
    "position": 1,
    "text": "نشایم خور و خواب و آرام را"
  },
  {
    "poem_id": 1404,
    "vorder": 45,
    "position": 0,
    "text": "همی پشت زین خواهم و درع و خود"
  },
  {
    "poem_id": 1404,
    "vorder": 46,
    "position": 1,
    "text": "همی تیر ناوک فرستم درود"
  },
  {
    "poem_id": 1404,
    "vorder": 47,
    "position": 0,
    "text": "به چهر تو ماند همی چهره‌ام"
  },
  {
    "poem_id": 1404,
    "vorder": 48,
    "position": 1,
    "text": "چو آن تو باشد مگر زهره‌ام"
  },
  {
    "poem_id": 1404,
    "vorder": 49,
    "position": 0,
    "text": "وزان پس فرود آمد از پیل مست"
  },
  {
    "poem_id": 1404,
    "vorder": 50,
    "position": 1,
    "text": "سپهدار بگرفت دستش بدست"
  },
  {
    "poem_id": 1404,
    "vorder": 51,
    "position": 0,
    "text": "همی بر سر و چشم او داد بوس"
  },
  {
    "poem_id": 1404,
    "vorder": 52,
    "position": 1,
    "text": "فروماند پیلان و آوای کوس"
  },
  {
    "poem_id": 1404,
    "vorder": 53,
    "position": 0,
    "text": "سوی کاخ ازان پس نهادند روی"
  },
  {
    "poem_id": 1404,
    "vorder": 54,
    "position": 1,
    "text": "همه راه شادان و با گفت‌وگوی"
  },
  {
    "poem_id": 1404,
    "vorder": 55,
    "position": 0,
    "text": "همه کاخها تخت زرین نهاد"
  },
  {
    "poem_id": 1404,
    "vorder": 56,
    "position": 1,
    "text": "نشستند و خوردند و بودند شاد"
  },
  {
    "poem_id": 1404,
    "vorder": 57,
    "position": 0,
    "text": "برآمد برین بر یکی ماهیان"
  },
  {
    "poem_id": 1404,
    "vorder": 58,
    "position": 1,
    "text": "به رنجی نبستند هرگز میان"
  },
  {
    "poem_id": 1404,
    "vorder": 59,
    "position": 0,
    "text": "بخوردند باده به آوای رود"
  },
  {
    "poem_id": 1404,
    "vorder": 60,
    "position": 1,
    "text": "همی گفت هر یک به نوبت سرود"
  },
  {
    "poem_id": 1404,
    "vorder": 61,
    "position": 0,
    "text": "به یک گوشهٔ تخت، دستان نشست"
  },
  {
    "poem_id": 1404,
    "vorder": 62,
    "position": 1,
    "text": "دگر گوشه رستمش گرزی به دست"
  },
  {
    "poem_id": 1404,
    "vorder": 63,
    "position": 0,
    "text": "به پیش اندرون سام گیهان گشای"
  },
  {
    "poem_id": 1404,
    "vorder": 64,
    "position": 1,
    "text": "فرو هشته از تاج پر همای"
  },
  {
    "poem_id": 1404,
    "vorder": 65,
    "position": 0,
    "text": "ز رستم همی در شگفتی بماند"
  },
  {
    "poem_id": 1404,
    "vorder": 66,
    "position": 1,
    "text": "برو هر زمان نام یزدان بخواند"
  },
  {
    "poem_id": 1404,
    "vorder": 67,
    "position": 0,
    "text": "بدان بازوی و یال و آن پشت و شاخ"
  },
  {
    "poem_id": 1404,
    "vorder": 68,
    "position": 1,
    "text": "میان چون قلم، سینه و بَر فراخ"
  },
  {
    "poem_id": 1404,
    "vorder": 69,
    "position": 0,
    "text": "دو رانش چو ران هیونان ستبر"
  },
  {
    "poem_id": 1404,
    "vorder": 70,
    "position": 1,
    "text": "دل شیر نر دارد و زور ببر"
  },
  {
    "poem_id": 1404,
    "vorder": 71,
    "position": 0,
    "text": "بدین خوب رویی و این فر و یال"
  },
  {
    "poem_id": 1404,
    "vorder": 72,
    "position": 1,
    "text": "ندارد کس از پهلوانان همال"
  },
  {
    "poem_id": 1404,
    "vorder": 73,
    "position": 0,
    "text": "بدین شادمانی کنون می خوریم"
  },
  {
    "poem_id": 1404,
    "vorder": 74,
    "position": 1,
    "text": "به می جان اندوه را بشکریم"
  },
  {
    "poem_id": 1404,
    "vorder": 75,
    "position": 0,
    "text": "به زال آنگهی گفت تا صد نژاد"
  },
  {
    "poem_id": 1404,
    "vorder": 76,
    "position": 1,
    "text": "بپرسی کس این را ندارد بیاد"
  },
  {
    "poem_id": 1404,
    "vorder": 77,
    "position": 0,
    "text": "که کودک ز پهلو برون آورند"
  },
  {
    "poem_id": 1404,
    "vorder": 78,
    "position": 1,
    "text": "بدین نیکویی چاره چون آورند"
  },
  {
    "poem_id": 1404,
    "vorder": 79,
    "position": 0,
    "text": "بسیمرغ بادا هزار آفرین"
  },
  {
    "poem_id": 1404,
    "vorder": 80,
    "position": 1,
    "text": "که ایزد ورا ره نمود اندرین"
  },
  {
    "poem_id": 1404,
    "vorder": 81,
    "position": 0,
    "text": "که گیتی سپنجست پر آی و رو"
  },
  {
    "poem_id": 1404,
    "vorder": 82,
    "position": 1,
    "text": "کهن شد یکی دیگر آرند نو"
  },
  {
    "poem_id": 1404,
    "vorder": 83,
    "position": 0,
    "text": "به می دست بردند و مستان شدند"
  },
  {
    "poem_id": 1404,
    "vorder": 84,
    "position": 1,
    "text": "ز رستم سوی یاد دستان شدند"
  },
  {
    "poem_id": 1404,
    "vorder": 85,
    "position": 0,
    "text": "همی خورد مهراب چندان نبید"
  },
  {
    "poem_id": 1404,
    "vorder": 86,
    "position": 1,
    "text": "که چون خویشتن کس به گیتی ندید"
  },
  {
    "poem_id": 1404,
    "vorder": 87,
    "position": 0,
    "text": "همی گفت نندیشم از زال زر"
  },
  {
    "poem_id": 1404,
    "vorder": 88,
    "position": 1,
    "text": "نه از سام و نز شاه با تاج و فر"
  },
  {
    "poem_id": 1404,
    "vorder": 89,
    "position": 0,
    "text": "من و رستم و اسب شبدیز و تیغ"
  },
  {
    "poem_id": 1404,
    "vorder": 90,
    "position": 1,
    "text": "نیارد برو سایه گسترد میغ"
  },
  {
    "poem_id": 1404,
    "vorder": 91,
    "position": 0,
    "text": "کنم زنده آیین ضحاک را"
  },
  {
    "poem_id": 1404,
    "vorder": 92,
    "position": 1,
    "text": "به پی مشک سارا کنم خاک را"
  },
  {
    "poem_id": 1404,
    "vorder": 93,
    "position": 0,
    "text": "پر از خنده گشته لب زال و سام"
  },
  {
    "poem_id": 1404,
    "vorder": 94,
    "position": 1,
    "text": "ز گفتار مهراب دل شادکام"
  },
  {
    "poem_id": 1404,
    "vorder": 95,
    "position": 0,
    "text": "سر ماه نو هرمز مهرماه"
  },
  {
    "poem_id": 1404,
    "vorder": 96,
    "position": 1,
    "text": "بران تخت فرخنده بگزید راه"
  },
  {
    "poem_id": 1404,
    "vorder": 97,
    "position": 0,
    "text": "بسازید سام و برون شد به در"
  },
  {
    "poem_id": 1404,
    "vorder": 98,
    "position": 1,
    "text": "یکی منزلی زال شد با پدر"
  },
  {
    "poem_id": 1404,
    "vorder": 99,
    "position": 0,
    "text": "همی رفت بر پیل دستم دژم"
  },
  {
    "poem_id": 1404,
    "vorder": 100,
    "position": 1,
    "text": "به پدرود کردن نیا را به هم"
  },
  {
    "poem_id": 1404,
    "vorder": 101,
    "position": 0,
    "text": "چنین گفت مر زال را کای پسر"
  },
  {
    "poem_id": 1404,
    "vorder": 102,
    "position": 1,
    "text": "نگر تا نباشی جز از دادگر"
  },
  {
    "poem_id": 1404,
    "vorder": 103,
    "position": 0,
    "text": "به فرمان شاهان دل آراسته"
  },
  {
    "poem_id": 1404,
    "vorder": 104,
    "position": 1,
    "text": "خرد را گزین کرده بر خواسته"
  },
  {
    "poem_id": 1404,
    "vorder": 105,
    "position": 0,
    "text": "همه ساله بر بسته دست از بدی"
  },
  {
    "poem_id": 1404,
    "vorder": 106,
    "position": 1,
    "text": "همه روز جسته ره ایزدی"
  },
  {
    "poem_id": 1404,
    "vorder": 107,
    "position": 0,
    "text": "چنان دان که بر کس نماند جهان"
  },
  {
    "poem_id": 1404,
    "vorder": 108,
    "position": 1,
    "text": "یکی بایدت آشکار و نهان"
  },
  {
    "poem_id": 1404,
    "vorder": 109,
    "position": 0,
    "text": "برین پند من باش و مگذر ازین"
  },
  {
    "poem_id": 1404,
    "vorder": 110,
    "position": 1,
    "text": "بجز بر ره راست مسپر زمین"
  },
  {
    "poem_id": 1404,
    "vorder": 111,
    "position": 0,
    "text": "که من در دل ایدون گمانم همی"
  },
  {
    "poem_id": 1404,
    "vorder": 112,
    "position": 1,
    "text": "که آمد به تنگی زمانم همی"
  },
  {
    "poem_id": 1404,
    "vorder": 113,
    "position": 0,
    "text": "دو فرزند را کرد پدرود و گفت"
  },
  {
    "poem_id": 1404,
    "vorder": 114,
    "position": 1,
    "text": "که این پندها را نباید نهفت"
  },
  {
    "poem_id": 1404,
    "vorder": 115,
    "position": 0,
    "text": "برآمد ز درگاه زخم درای"
  },
  {
    "poem_id": 1404,
    "vorder": 116,
    "position": 1,
    "text": "ز پیلان خروشیدن کرنای"
  },
  {
    "poem_id": 1404,
    "vorder": 117,
    "position": 0,
    "text": "سپهبد سوی باختر کرد روی"
  },
  {
    "poem_id": 1404,
    "vorder": 118,
    "position": 1,
    "text": "زبان گرم‌گوی و دل آزرم‌جوی"
  },
  {
    "poem_id": 1404,
    "vorder": 119,
    "position": 0,
    "text": "برفتند با او دو فرزند او"
  },
  {
    "poem_id": 1404,
    "vorder": 120,
    "position": 1,
    "text": "پر از آبْ رخ، دل پر از پند او"
  },
  {
    "poem_id": 1404,
    "vorder": 121,
    "position": 0,
    "text": "دو منزل برفتند و گشتند باز"
  },
  {
    "poem_id": 1404,
    "vorder": 122,
    "position": 1,
    "text": "کشید آن سپهبد براه دراز"
  },
  {
    "poem_id": 1404,
    "vorder": 123,
    "position": 0,
    "text": "وزان روی زال سپهبد به راه"
  },
  {
    "poem_id": 1404,
    "vorder": 124,
    "position": 1,
    "text": "سوی سیستان باز برد آن سپاه"
  },
  {
    "poem_id": 1404,
    "vorder": 125,
    "position": 0,
    "text": "شب و روز با رستم شیرمرد"
  },
  {
    "poem_id": 1404,
    "vorder": 126,
    "position": 1,
    "text": "همی کرد شادی و هم باده خورد"
  }
]