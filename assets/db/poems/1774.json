[
  {
    "poem_id": 1774,
    "vorder": 1,
    "position": 0,
    "text": "برفت و بیامد به ایوان خویش"
  },
  {
    "poem_id": 1774,
    "vorder": 2,
    "position": 1,
    "text": "همه شب همی ساخت درمان خویش"
  },
  {
    "poem_id": 1774,
    "vorder": 3,
    "position": 0,
    "text": "پراندیشه آن شب به ایوان بخفت"
  },
  {
    "poem_id": 1774,
    "vorder": 4,
    "position": 1,
    "text": "بخندید و آن راز با کس نگفت"
  },
  {
    "poem_id": 1774,
    "vorder": 5,
    "position": 0,
    "text": "به شبگیر چون تاج بر سر نهاد"
  },
  {
    "poem_id": 1774,
    "vorder": 6,
    "position": 1,
    "text": "سپه را سراسر همه بار داد"
  },
  {
    "poem_id": 1774,
    "vorder": 7,
    "position": 0,
    "text": "بفرمود تا لنبک آبکش"
  },
  {
    "poem_id": 1774,
    "vorder": 8,
    "position": 1,
    "text": "بشد پیش او دست کرده به کش"
  },
  {
    "poem_id": 1774,
    "vorder": 9,
    "position": 0,
    "text": "ببردند ز ایوان به راهام را"
  },
  {
    "poem_id": 1774,
    "vorder": 10,
    "position": 1,
    "text": "جهود بداندیش و بدکام را"
  },
  {
    "poem_id": 1774,
    "vorder": 11,
    "position": 0,
    "text": "چو در بارگه رفت بنشاندند"
  },
  {
    "poem_id": 1774,
    "vorder": 12,
    "position": 1,
    "text": "یکی پاک‌دل مرد را خواندند"
  },
  {
    "poem_id": 1774,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت رو بارگیها ببر"
  },
  {
    "poem_id": 1774,
    "vorder": 14,
    "position": 1,
    "text": "نگر تا نباشی به جز دادگر"
  },
  {
    "poem_id": 1774,
    "vorder": 15,
    "position": 0,
    "text": "به خان به راهام شو بر گذار"
  },
  {
    "poem_id": 1774,
    "vorder": 16,
    "position": 1,
    "text": "نگر تا چه بینی نهاده بیار"
  },
  {
    "poem_id": 1774,
    "vorder": 17,
    "position": 0,
    "text": "بشد پاک‌دل تا به خان جهود"
  },
  {
    "poem_id": 1774,
    "vorder": 18,
    "position": 1,
    "text": "همه خانه دیبا و دینار بود"
  },
  {
    "poem_id": 1774,
    "vorder": 19,
    "position": 0,
    "text": "ز پوشیدنی هم ز گستردنی"
  },
  {
    "poem_id": 1774,
    "vorder": 20,
    "position": 1,
    "text": "ز افگندنی و پراگندنی"
  },
  {
    "poem_id": 1774,
    "vorder": 21,
    "position": 0,
    "text": "یکی کاروان‌خانه بود و سرای"
  },
  {
    "poem_id": 1774,
    "vorder": 22,
    "position": 1,
    "text": "کزان خانه بیرون نبودیش جای"
  },
  {
    "poem_id": 1774,
    "vorder": 23,
    "position": 0,
    "text": "ز در و ز یاقوت و هر گوهری"
  },
  {
    "poem_id": 1774,
    "vorder": 24,
    "position": 1,
    "text": "ز هر بدره‌ای بر سرش افسری"
  },
  {
    "poem_id": 1774,
    "vorder": 25,
    "position": 0,
    "text": "که دانند موبد مر آن را شمار"
  },
  {
    "poem_id": 1774,
    "vorder": 26,
    "position": 1,
    "text": "ندانست کردن بس روزگار"
  },
  {
    "poem_id": 1774,
    "vorder": 27,
    "position": 0,
    "text": "فرستاد موبد بدانجا سوار"
  },
  {
    "poem_id": 1774,
    "vorder": 28,
    "position": 1,
    "text": "شتر خواست از دشت جهرم هزار"
  },
  {
    "poem_id": 1774,
    "vorder": 29,
    "position": 0,
    "text": "همه بار کردند و دیگر نماند"
  },
  {
    "poem_id": 1774,
    "vorder": 30,
    "position": 1,
    "text": "همی شاددل کاروان را براند"
  },
  {
    "poem_id": 1774,
    "vorder": 31,
    "position": 0,
    "text": "چو بانگ درای آمد از بارگاه"
  },
  {
    "poem_id": 1774,
    "vorder": 32,
    "position": 1,
    "text": "بشد مرد بینا بگفت آن به شاه"
  },
  {
    "poem_id": 1774,
    "vorder": 33,
    "position": 0,
    "text": "که گوهر فزون زین به گنج تو نیست"
  },
  {
    "poem_id": 1774,
    "vorder": 34,
    "position": 1,
    "text": "همان مانده خروار باشد دویست"
  },
  {
    "poem_id": 1774,
    "vorder": 35,
    "position": 0,
    "text": "بماند اندران شاه ایران شگفت"
  },
  {
    "poem_id": 1774,
    "vorder": 36,
    "position": 1,
    "text": "ز راز دل اندیشه‌ها برگرفت"
  },
  {
    "poem_id": 1774,
    "vorder": 37,
    "position": 0,
    "text": "که چندین بورزید مرد جهود"
  },
  {
    "poem_id": 1774,
    "vorder": 38,
    "position": 1,
    "text": "چو روزی نبودش ز ورزش چه سود"
  },
  {
    "poem_id": 1774,
    "vorder": 39,
    "position": 0,
    "text": "ازان صد شتروار زر و درم"
  },
  {
    "poem_id": 1774,
    "vorder": 40,
    "position": 1,
    "text": "ز گستردنیها و از بیش و کم"
  },
  {
    "poem_id": 1774,
    "vorder": 41,
    "position": 0,
    "text": "جهاندار شاه آبکش را سپرد"
  },
  {
    "poem_id": 1774,
    "vorder": 42,
    "position": 1,
    "text": "بشد لنبک از راه گنجی ببرد"
  },
  {
    "poem_id": 1774,
    "vorder": 43,
    "position": 0,
    "text": "ازان پس براهام را خواند و گفت"
  },
  {
    "poem_id": 1774,
    "vorder": 44,
    "position": 1,
    "text": "که ای در کمی گشته با خاک جفت"
  },
  {
    "poem_id": 1774,
    "vorder": 45,
    "position": 0,
    "text": "چه گویی که پیغمبرت چند زیست"
  },
  {
    "poem_id": 1774,
    "vorder": 46,
    "position": 1,
    "text": "چه بایست چندی به زشتی گریست"
  },
  {
    "poem_id": 1774,
    "vorder": 47,
    "position": 0,
    "text": "سوار آمد و گفت با من سخن"
  },
  {
    "poem_id": 1774,
    "vorder": 48,
    "position": 1,
    "text": "ازان داستانهای گشته کهن"
  },
  {
    "poem_id": 1774,
    "vorder": 49,
    "position": 0,
    "text": "که هرکس که دارد فزونی خورد"
  },
  {
    "poem_id": 1774,
    "vorder": 50,
    "position": 1,
    "text": "کسی کو ندارد همی پژمرد"
  },
  {
    "poem_id": 1774,
    "vorder": 51,
    "position": 0,
    "text": "کنون دست یازان ز خوردن بکش"
  },
  {
    "poem_id": 1774,
    "vorder": 52,
    "position": 1,
    "text": "ببین زین سپس خوردن آبکش"
  },
  {
    "poem_id": 1774,
    "vorder": 53,
    "position": 0,
    "text": "ز سرگین و زربفت و دستار و خشت"
  },
  {
    "poem_id": 1774,
    "vorder": 54,
    "position": 1,
    "text": "بسی گفت با سفله مرد کنشت"
  },
  {
    "poem_id": 1774,
    "vorder": 55,
    "position": 0,
    "text": "درم داد ناپاک دل را چهار"
  },
  {
    "poem_id": 1774,
    "vorder": 56,
    "position": 1,
    "text": "بدو گفت کاین را تو سرمایه‌دار"
  },
  {
    "poem_id": 1774,
    "vorder": 57,
    "position": 0,
    "text": "سزا نیست زین بیشتر مر ترا"
  },
  {
    "poem_id": 1774,
    "vorder": 58,
    "position": 1,
    "text": "درم مرد درویش را سر ترا"
  },
  {
    "poem_id": 1774,
    "vorder": 59,
    "position": 0,
    "text": "به ارزانیان داد چیزی که بود"
  },
  {
    "poem_id": 1774,
    "vorder": 60,
    "position": 1,
    "text": "خروشان همی رفت مرد جهود"
  }
]