[
  {
    "poem_id": 1891,
    "vorder": 1,
    "position": 0,
    "text": "چنین تا برآمد برین چندگاه"
  },
  {
    "poem_id": 1891,
    "vorder": 2,
    "position": 1,
    "text": "ز گستهم پر درد شد جان شاه"
  },
  {
    "poem_id": 1891,
    "vorder": 3,
    "position": 0,
    "text": "برآشفت روزی به گردوی گفت"
  },
  {
    "poem_id": 1891,
    "vorder": 4,
    "position": 1,
    "text": "که گستهم با گردیه گشت جفت"
  },
  {
    "poem_id": 1891,
    "vorder": 5,
    "position": 0,
    "text": "سوی او شدند آن بزرگ انجمن"
  },
  {
    "poem_id": 1891,
    "vorder": 6,
    "position": 1,
    "text": "برانم که او بودشان رای زن"
  },
  {
    "poem_id": 1891,
    "vorder": 7,
    "position": 0,
    "text": "از آمل کس آمد ز کارآگهان"
  },
  {
    "poem_id": 1891,
    "vorder": 8,
    "position": 1,
    "text": "همه فاش کرد آنچ بودی نهان"
  },
  {
    "poem_id": 1891,
    "vorder": 9,
    "position": 0,
    "text": "همی‌گفت زین گونه تا تیره گشت"
  },
  {
    "poem_id": 1891,
    "vorder": 10,
    "position": 1,
    "text": "ز گفتار چشم یلان خیره گشت"
  },
  {
    "poem_id": 1891,
    "vorder": 11,
    "position": 0,
    "text": "چو سازدندگان شمع ومی‌خواستند"
  },
  {
    "poem_id": 1891,
    "vorder": 12,
    "position": 1,
    "text": "همه کاخ ا ورا بیاراستند"
  },
  {
    "poem_id": 1891,
    "vorder": 13,
    "position": 0,
    "text": "ز بیگانه مردم بپردخت جای"
  },
  {
    "poem_id": 1891,
    "vorder": 14,
    "position": 1,
    "text": "نشست از بر تخت با رهنمای"
  },
  {
    "poem_id": 1891,
    "vorder": 15,
    "position": 0,
    "text": "همان نیز گردوی و خسرو بهم"
  },
  {
    "poem_id": 1891,
    "vorder": 16,
    "position": 1,
    "text": "همی‌رفت از گردیه بیش و کم"
  },
  {
    "poem_id": 1891,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت ز ایدر فراوان سپاه"
  },
  {
    "poem_id": 1891,
    "vorder": 18,
    "position": 1,
    "text": "به آمل فرستاده‌ام کینه خواه"
  },
  {
    "poem_id": 1891,
    "vorder": 19,
    "position": 0,
    "text": "همه خسته وکشته بازآمدند"
  },
  {
    "poem_id": 1891,
    "vorder": 20,
    "position": 1,
    "text": "پرازناله وبا گداز آمدند"
  },
  {
    "poem_id": 1891,
    "vorder": 21,
    "position": 0,
    "text": "کنون اندرین رای ما را یکیست"
  },
  {
    "poem_id": 1891,
    "vorder": 22,
    "position": 1,
    "text": "که از رای ما تاج و تخت اندکیست"
  },
  {
    "poem_id": 1891,
    "vorder": 23,
    "position": 0,
    "text": "چو بهرام چوبینه گم کرد راه"
  },
  {
    "poem_id": 1891,
    "vorder": 24,
    "position": 1,
    "text": "همیشه بدی گردیه نیک خواه"
  },
  {
    "poem_id": 1891,
    "vorder": 25,
    "position": 0,
    "text": "کنون چاره‌ای هست نزدیک من"
  },
  {
    "poem_id": 1891,
    "vorder": 26,
    "position": 1,
    "text": "مگو این سخن بر سر انجمن"
  },
  {
    "poem_id": 1891,
    "vorder": 27,
    "position": 0,
    "text": "سوی گردیه نامه باید نوشت"
  },
  {
    "poem_id": 1891,
    "vorder": 28,
    "position": 1,
    "text": "چو جویی پر از می بباغ بهشت"
  },
  {
    "poem_id": 1891,
    "vorder": 29,
    "position": 0,
    "text": "که با تو همی دوستداری کنم"
  },
  {
    "poem_id": 1891,
    "vorder": 30,
    "position": 1,
    "text": "بهر جای و هر کار یاری کنم"
  },
  {
    "poem_id": 1891,
    "vorder": 31,
    "position": 0,
    "text": "برآمد برین روزگاری دراز"
  },
  {
    "poem_id": 1891,
    "vorder": 32,
    "position": 1,
    "text": "زبان بر دلم هیچ نگشاد راز"
  },
  {
    "poem_id": 1891,
    "vorder": 33,
    "position": 0,
    "text": "کنون روزگار سخن گفتن است"
  },
  {
    "poem_id": 1891,
    "vorder": 34,
    "position": 1,
    "text": "که گردوی ما رابجای تنست"
  },
  {
    "poem_id": 1891,
    "vorder": 35,
    "position": 0,
    "text": "نگر تا چگونه کنی چاره‌ای"
  },
  {
    "poem_id": 1891,
    "vorder": 36,
    "position": 1,
    "text": "کزان گم شود زشت پتیاره‌ای"
  },
  {
    "poem_id": 1891,
    "vorder": 37,
    "position": 0,
    "text": "که گستهم را زیر سنگ‌آوری"
  },
  {
    "poem_id": 1891,
    "vorder": 38,
    "position": 1,
    "text": "دل وخانهٔ ما به چنگ آوری"
  },
  {
    "poem_id": 1891,
    "vorder": 39,
    "position": 0,
    "text": "چو این کرده باشی سپاه تو را"
  },
  {
    "poem_id": 1891,
    "vorder": 40,
    "position": 1,
    "text": "همان در جهان نیک خواه تو را"
  },
  {
    "poem_id": 1891,
    "vorder": 41,
    "position": 0,
    "text": "مر آن را که خواهی دهم کشوری"
  },
  {
    "poem_id": 1891,
    "vorder": 42,
    "position": 1,
    "text": "بگردد بر آن کشور اندر سری"
  },
  {
    "poem_id": 1891,
    "vorder": 43,
    "position": 0,
    "text": "توآیی به مشکوی زرین من"
  },
  {
    "poem_id": 1891,
    "vorder": 44,
    "position": 1,
    "text": "سرآورده باشی همه کین من"
  },
  {
    "poem_id": 1891,
    "vorder": 45,
    "position": 0,
    "text": "برین برخورم سخت سوگند نیز"
  },
  {
    "poem_id": 1891,
    "vorder": 46,
    "position": 1,
    "text": "فزایم برین بندها بند نیز"
  },
  {
    "poem_id": 1891,
    "vorder": 47,
    "position": 0,
    "text": "اگر پیچم این دل ز سوگند من"
  },
  {
    "poem_id": 1891,
    "vorder": 48,
    "position": 1,
    "text": "مبادا ز من شاد پیوند من"
  },
  {
    "poem_id": 1891,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت گردوی نوشه بدی"
  },
  {
    "poem_id": 1891,
    "vorder": 50,
    "position": 1,
    "text": "چو ناهید در برج خوشه بدی"
  },
  {
    "poem_id": 1891,
    "vorder": 51,
    "position": 0,
    "text": "تو دانی که من جان و فرزند خویش"
  },
  {
    "poem_id": 1891,
    "vorder": 52,
    "position": 1,
    "text": "برو بوم آباد و پیوند خویش"
  },
  {
    "poem_id": 1891,
    "vorder": 53,
    "position": 0,
    "text": "بجای سر تو ندارم به چیز"
  },
  {
    "poem_id": 1891,
    "vorder": 54,
    "position": 1,
    "text": "گرین چیزها ارجمندست نیز"
  },
  {
    "poem_id": 1891,
    "vorder": 55,
    "position": 0,
    "text": "بدین کس فرستم به نزدیک اوی"
  },
  {
    "poem_id": 1891,
    "vorder": 56,
    "position": 1,
    "text": "درفشان کنم جان تاریک اوی"
  },
  {
    "poem_id": 1891,
    "vorder": 57,
    "position": 0,
    "text": "یکی رقعه خواهم برو مهر شاه"
  },
  {
    "poem_id": 1891,
    "vorder": 58,
    "position": 1,
    "text": "همان خط او چون درخشنده ماه"
  },
  {
    "poem_id": 1891,
    "vorder": 59,
    "position": 0,
    "text": "به خوارهر فرستم زن خویش را"
  },
  {
    "poem_id": 1891,
    "vorder": 60,
    "position": 1,
    "text": "کنم دور زین در بد اندیش را"
  },
  {
    "poem_id": 1891,
    "vorder": 61,
    "position": 0,
    "text": "که چونین سخن نیست جز کار زن"
  },
  {
    "poem_id": 1891,
    "vorder": 62,
    "position": 1,
    "text": "به ویژه زنی کو بود رای زن"
  },
  {
    "poem_id": 1891,
    "vorder": 63,
    "position": 0,
    "text": "برین نیز هر چون همی‌بنگرم"
  },
  {
    "poem_id": 1891,
    "vorder": 64,
    "position": 1,
    "text": "پیام تو باید بر خواهرم"
  },
  {
    "poem_id": 1891,
    "vorder": 65,
    "position": 0,
    "text": "بر آید بکام تو این کار زود"
  },
  {
    "poem_id": 1891,
    "vorder": 66,
    "position": 1,
    "text": "برین بیش و کم بر نباید فزود"
  },
  {
    "poem_id": 1891,
    "vorder": 67,
    "position": 0,
    "text": "چو بشنید خسرو بران شاد شد"
  },
  {
    "poem_id": 1891,
    "vorder": 68,
    "position": 1,
    "text": "همه رنجها بر دلش باد شد"
  },
  {
    "poem_id": 1891,
    "vorder": 69,
    "position": 0,
    "text": "هم آنگه ز گنجور قرطاس خواست"
  },
  {
    "poem_id": 1891,
    "vorder": 70,
    "position": 1,
    "text": "ز مشک سیه سوده انقاس خواست"
  },
  {
    "poem_id": 1891,
    "vorder": 71,
    "position": 0,
    "text": "یکی نامه بنوشت چون بوستان"
  },
  {
    "poem_id": 1891,
    "vorder": 72,
    "position": 1,
    "text": "گل بوستان چون رخ دوستان"
  },
  {
    "poem_id": 1891,
    "vorder": 73,
    "position": 0,
    "text": "پر از عهد و پیوند و سوگندها"
  },
  {
    "poem_id": 1891,
    "vorder": 74,
    "position": 1,
    "text": "ز هر گونه‌ای لابه و پندها"
  },
  {
    "poem_id": 1891,
    "vorder": 75,
    "position": 0,
    "text": "چو برگشت عنوان آن نامه خشک"
  },
  {
    "poem_id": 1891,
    "vorder": 76,
    "position": 1,
    "text": "نهادند مهری برو بر ز مشک"
  },
  {
    "poem_id": 1891,
    "vorder": 77,
    "position": 0,
    "text": "نگینی برو نام پرویز شاه"
  },
  {
    "poem_id": 1891,
    "vorder": 78,
    "position": 1,
    "text": "نهادند بر مهر مشک سیاه"
  },
  {
    "poem_id": 1891,
    "vorder": 79,
    "position": 0,
    "text": "یکی نامه بنوشت گردوی نیز"
  },
  {
    "poem_id": 1891,
    "vorder": 80,
    "position": 1,
    "text": "بگفت اندرو پند و بسیار چیز"
  },
  {
    "poem_id": 1891,
    "vorder": 81,
    "position": 0,
    "text": "سرنامه گفت آنک بهرام کرد"
  },
  {
    "poem_id": 1891,
    "vorder": 82,
    "position": 1,
    "text": "همه دوده و بوم بدنام کرد"
  },
  {
    "poem_id": 1891,
    "vorder": 83,
    "position": 0,
    "text": "که بخشایش آراد یزدان بروی"
  },
  {
    "poem_id": 1891,
    "vorder": 84,
    "position": 1,
    "text": "مبادا پشیمان ازان گفت وگوی"
  },
  {
    "poem_id": 1891,
    "vorder": 85,
    "position": 0,
    "text": "هرآنکس که جانش ندارد خرد"
  },
  {
    "poem_id": 1891,
    "vorder": 86,
    "position": 1,
    "text": "کم و بیشی کارها ننگرد"
  },
  {
    "poem_id": 1891,
    "vorder": 87,
    "position": 0,
    "text": "گر او رفت ما از پس اورویم"
  },
  {
    "poem_id": 1891,
    "vorder": 88,
    "position": 1,
    "text": "بداد خدای جهان بگرویم"
  },
  {
    "poem_id": 1891,
    "vorder": 89,
    "position": 0,
    "text": "چو جفت من آید به نزدیک تو"
  },
  {
    "poem_id": 1891,
    "vorder": 90,
    "position": 1,
    "text": "درخشان کند جان تاریک تو"
  },
  {
    "poem_id": 1891,
    "vorder": 91,
    "position": 0,
    "text": "ز گفتار او هیچ گونه مگرد"
  },
  {
    "poem_id": 1891,
    "vorder": 92,
    "position": 1,
    "text": "چو گردی شود بخت را روی زرد"
  },
  {
    "poem_id": 1891,
    "vorder": 93,
    "position": 0,
    "text": "نهاد آن خط خسرو اندر میان"
  },
  {
    "poem_id": 1891,
    "vorder": 94,
    "position": 1,
    "text": "بپیچید برنامه بر پرنیان"
  },
  {
    "poem_id": 1891,
    "vorder": 95,
    "position": 0,
    "text": "زن چاره گر بستد آن نامه را"
  },
  {
    "poem_id": 1891,
    "vorder": 96,
    "position": 1,
    "text": "شنید آن سخنهای خود کامه را"
  },
  {
    "poem_id": 1891,
    "vorder": 97,
    "position": 0,
    "text": "همی‌تاخت تا بیشهٔ نارون"
  },
  {
    "poem_id": 1891,
    "vorder": 98,
    "position": 1,
    "text": "فرستادهٔ زن به نزدیک زن"
  },
  {
    "poem_id": 1891,
    "vorder": 99,
    "position": 0,
    "text": "ازو گردیه شد چو خرم بهار"
  },
  {
    "poem_id": 1891,
    "vorder": 100,
    "position": 1,
    "text": "همان رخ پر از بوی و رنگ و نگار"
  },
  {
    "poem_id": 1891,
    "vorder": 101,
    "position": 0,
    "text": "زبهرام چندی سخن راندند"
  },
  {
    "poem_id": 1891,
    "vorder": 102,
    "position": 1,
    "text": "همی آب مژگان بر افشاندند"
  },
  {
    "poem_id": 1891,
    "vorder": 103,
    "position": 0,
    "text": "پس آن نامهٔ شوی با خط شاه"
  },
  {
    "poem_id": 1891,
    "vorder": 104,
    "position": 1,
    "text": "نهانی بدو داد و بنمود راه"
  },
  {
    "poem_id": 1891,
    "vorder": 105,
    "position": 0,
    "text": "چو آن شیر زن نامهٔ شاه دید"
  },
  {
    "poem_id": 1891,
    "vorder": 106,
    "position": 1,
    "text": "تو گفتی بروی زمین ماه دید"
  },
  {
    "poem_id": 1891,
    "vorder": 107,
    "position": 0,
    "text": "بخندید و گفت این سخن رابه رنج"
  },
  {
    "poem_id": 1891,
    "vorder": 108,
    "position": 1,
    "text": "ندارد کسی کش بود یار پنج"
  },
  {
    "poem_id": 1891,
    "vorder": 109,
    "position": 0,
    "text": "بخواند آن خط شاه بر پنج تن"
  },
  {
    "poem_id": 1891,
    "vorder": 110,
    "position": 1,
    "text": "نهان داشت زان نامدار انجمن"
  },
  {
    "poem_id": 1891,
    "vorder": 111,
    "position": 0,
    "text": "چو بگشاد لب زود پیمان ببست"
  },
  {
    "poem_id": 1891,
    "vorder": 112,
    "position": 1,
    "text": "گرفت آن زمان دست او را بدست"
  },
  {
    "poem_id": 1891,
    "vorder": 113,
    "position": 0,
    "text": "همان پنج تن را بر خویش خواند"
  },
  {
    "poem_id": 1891,
    "vorder": 114,
    "position": 1,
    "text": "به نزدیکی خوابگه برنشاند"
  },
  {
    "poem_id": 1891,
    "vorder": 115,
    "position": 0,
    "text": "چو شب تیره شد روشنایی بکشت"
  },
  {
    "poem_id": 1891,
    "vorder": 116,
    "position": 1,
    "text": "لب شوی بگرفت ناگه بمشت"
  },
  {
    "poem_id": 1891,
    "vorder": 117,
    "position": 0,
    "text": "ازان مردمان نیز یار آمدند"
  },
  {
    "poem_id": 1891,
    "vorder": 118,
    "position": 1,
    "text": "به بالین آن نامدار آمدند"
  },
  {
    "poem_id": 1891,
    "vorder": 119,
    "position": 0,
    "text": "بکوشید بسیار با مرد مست"
  },
  {
    "poem_id": 1891,
    "vorder": 120,
    "position": 1,
    "text": "سر انجام گویا زبانش ببست"
  },
  {
    "poem_id": 1891,
    "vorder": 121,
    "position": 0,
    "text": "سپهبد به تاریکی اندر بمرد"
  },
  {
    "poem_id": 1891,
    "vorder": 122,
    "position": 1,
    "text": "شب و روز روشن به خسرو سپرد"
  },
  {
    "poem_id": 1891,
    "vorder": 123,
    "position": 0,
    "text": "بشهر اندرون بانگ و فریاد خاست"
  },
  {
    "poem_id": 1891,
    "vorder": 124,
    "position": 1,
    "text": "بهر بر زنی آتش وباد خاست"
  },
  {
    "poem_id": 1891,
    "vorder": 125,
    "position": 0,
    "text": "چو آواز بشنید ناباک زن"
  },
  {
    "poem_id": 1891,
    "vorder": 126,
    "position": 1,
    "text": "بخفتان رومی بپوشید تن"
  },
  {
    "poem_id": 1891,
    "vorder": 127,
    "position": 0,
    "text": "شب تیره ایرانیان رابخواند"
  },
  {
    "poem_id": 1891,
    "vorder": 128,
    "position": 1,
    "text": "سخنهای آن کشته چندی براند"
  },
  {
    "poem_id": 1891,
    "vorder": 129,
    "position": 0,
