[
  {
    "poem_id": 1509,
    "vorder": 1,
    "position": 0,
    "text": "ز یزدان بر آن شاه باد آفرین"
  },
  {
    "poem_id": 1509,
    "vorder": 2,
    "position": 1,
    "text": "که نازد بدو تاج و تخت و نگین"
  },
  {
    "poem_id": 1509,
    "vorder": 3,
    "position": 0,
    "text": "که گنجش ز بخشش بنالد همی"
  },
  {
    "poem_id": 1509,
    "vorder": 4,
    "position": 1,
    "text": "بزرگی ز نامش ببالد همی"
  },
  {
    "poem_id": 1509,
    "vorder": 5,
    "position": 0,
    "text": "ز دریا به دریا سپاه وی است"
  },
  {
    "poem_id": 1509,
    "vorder": 6,
    "position": 1,
    "text": "جهان زیر فر کلاه وی است"
  },
  {
    "poem_id": 1509,
    "vorder": 7,
    "position": 0,
    "text": "خداوند نام و خداوند گنج"
  },
  {
    "poem_id": 1509,
    "vorder": 8,
    "position": 1,
    "text": "خداوند شمشیر و خفتان و رنج"
  },
  {
    "poem_id": 1509,
    "vorder": 9,
    "position": 0,
    "text": "ز گیتی به کان اندرون زر نماند"
  },
  {
    "poem_id": 1509,
    "vorder": 10,
    "position": 1,
    "text": "که منشور جود ورا بر نخواند"
  },
  {
    "poem_id": 1509,
    "vorder": 11,
    "position": 0,
    "text": "به بزم اندرون گنج پیدا کند"
  },
  {
    "poem_id": 1509,
    "vorder": 12,
    "position": 1,
    "text": "چو رزم آیدش رنج بینا کند"
  },
  {
    "poem_id": 1509,
    "vorder": 13,
    "position": 0,
    "text": "به بار آورد شاخ دین و خرد"
  },
  {
    "poem_id": 1509,
    "vorder": 14,
    "position": 1,
    "text": "گمانش به دانش خرد پرورد"
  },
  {
    "poem_id": 1509,
    "vorder": 15,
    "position": 0,
    "text": "به اندیشه از بی گزندان بود"
  },
  {
    "poem_id": 1509,
    "vorder": 16,
    "position": 1,
    "text": "همیشه پناهش به یزدان بود"
  },
  {
    "poem_id": 1509,
    "vorder": 17,
    "position": 0,
    "text": "چو او مرز گیرد به شمشیر تیز"
  },
  {
    "poem_id": 1509,
    "vorder": 18,
    "position": 1,
    "text": "بر انگیزد اندر جهان رستخیز"
  },
  {
    "poem_id": 1509,
    "vorder": 19,
    "position": 0,
    "text": "ز دشمن ستاند ببخشد به دوست"
  },
  {
    "poem_id": 1509,
    "vorder": 20,
    "position": 1,
    "text": "خداوند پیروزگر یار اوست"
  },
  {
    "poem_id": 1509,
    "vorder": 21,
    "position": 0,
    "text": "بدان تیغزن دست گوهرفشان"
  },
  {
    "poem_id": 1509,
    "vorder": 22,
    "position": 1,
    "text": "ز گیتی نجوید همی جز نشان"
  },
  {
    "poem_id": 1509,
    "vorder": 23,
    "position": 0,
    "text": "که در بزم دریاش خواند سپهر"
  },
  {
    "poem_id": 1509,
    "vorder": 24,
    "position": 1,
    "text": "به رزم اندرون شیر خورشید چهر"
  },
  {
    "poem_id": 1509,
    "vorder": 25,
    "position": 0,
    "text": "گواهی دهد بر زمین خاک و آب"
  },
  {
    "poem_id": 1509,
    "vorder": 26,
    "position": 1,
    "text": "همان بر فلک چشمه آفتاب"
  },
  {
    "poem_id": 1509,
    "vorder": 27,
    "position": 0,
    "text": "که چون او ندیدست شاهی به جنگ"
  },
  {
    "poem_id": 1509,
    "vorder": 28,
    "position": 1,
    "text": "نه در بخشش و کوشش و نام و ننگ"
  },
  {
    "poem_id": 1509,
    "vorder": 29,
    "position": 0,
    "text": "اگر مهر با کین برآمیزدی"
  },
  {
    "poem_id": 1509,
    "vorder": 30,
    "position": 1,
    "text": "ستاره ز خشمش بپرهیزدی"
  },
  {
    "poem_id": 1509,
    "vorder": 31,
    "position": 0,
    "text": "تنش زورمندست و چندان سپاه"
  },
  {
    "poem_id": 1509,
    "vorder": 32,
    "position": 1,
    "text": "که اندر میان باد را نیست راه"
  },
  {
    "poem_id": 1509,
    "vorder": 33,
    "position": 0,
    "text": "پس لشکرش هفتصد ژنده پیل"
  },
  {
    "poem_id": 1509,
    "vorder": 34,
    "position": 1,
    "text": "خدای جهان یارش و جبرییل"
  },
  {
    "poem_id": 1509,
    "vorder": 35,
    "position": 0,
    "text": "همی باژ خواهد ز هر مهتری"
  },
  {
    "poem_id": 1509,
    "vorder": 36,
    "position": 1,
    "text": "ز هر نامداری و هر کشوری"
  },
  {
    "poem_id": 1509,
    "vorder": 37,
    "position": 0,
    "text": "اگر باژ ندهند کشور دهند"
  },
  {
    "poem_id": 1509,
    "vorder": 38,
    "position": 1,
    "text": "همان گنج و هم تخت و افسر دهند"
  },
  {
    "poem_id": 1509,
    "vorder": 39,
    "position": 0,
    "text": "که یارد گذشتن ز پیمان اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 40,
    "position": 1,
    "text": "و گر سر کشیدن ز فرمان اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 41,
    "position": 0,
    "text": "که در بزم گیتی بدو روشن است"
  },
  {
    "poem_id": 1509,
    "vorder": 42,
    "position": 1,
    "text": "به رزم اندرون کوه در جوشن است"
  },
  {
    "poem_id": 1509,
    "vorder": 43,
    "position": 0,
    "text": "ابوالقاسم آن شهریار دلیر"
  },
  {
    "poem_id": 1509,
    "vorder": 44,
    "position": 1,
    "text": "کجا گور بستاند از چنگ شیر"
  },
  {
    "poem_id": 1509,
    "vorder": 45,
    "position": 0,
    "text": "جهاندار محمود کاندر نبرد"
  },
  {
    "poem_id": 1509,
    "vorder": 46,
    "position": 1,
    "text": "سر سرکشان اندر آرد به گرد"
  },
  {
    "poem_id": 1509,
    "vorder": 47,
    "position": 0,
    "text": "جهان تا جهان باشد او شاه باد"
  },
  {
    "poem_id": 1509,
    "vorder": 48,
    "position": 1,
    "text": "بلند اخترش افسر ماه باد"
  },
  {
    "poem_id": 1509,
    "vorder": 49,
    "position": 0,
    "text": "که آرایش چرخ گردنده اوست"
  },
  {
    "poem_id": 1509,
    "vorder": 50,
    "position": 1,
    "text": "به بزم اندرون ابر بخشنده اوست"
  },
  {
    "poem_id": 1509,
    "vorder": 51,
    "position": 0,
    "text": "خرد هستش و نیکنامی و داد"
  },
  {
    "poem_id": 1509,
    "vorder": 52,
    "position": 1,
    "text": "جهان بی سر و افسر او مباد"
  },
  {
    "poem_id": 1509,
    "vorder": 53,
    "position": 0,
    "text": "سپاه و دل و گنج و دستور هست"
  },
  {
    "poem_id": 1509,
    "vorder": 54,
    "position": 1,
    "text": "همان رزم و بزم و می و سور هست"
  },
  {
    "poem_id": 1509,
    "vorder": 55,
    "position": 0,
    "text": "یکی فرش گسترده شد در جهان"
  },
  {
    "poem_id": 1509,
    "vorder": 56,
    "position": 1,
    "text": "که هرگز نشانش نگردد نهان"
  },
  {
    "poem_id": 1509,
    "vorder": 57,
    "position": 0,
    "text": "کجا فرش را مسند و مرقد است"
  },
  {
    "poem_id": 1509,
    "vorder": 58,
    "position": 1,
    "text": "نشستنگه نصر بن احمد است"
  },
  {
    "poem_id": 1509,
    "vorder": 59,
    "position": 0,
    "text": "که این گونه آرام شاهی بدوست"
  },
  {
    "poem_id": 1509,
    "vorder": 60,
    "position": 1,
    "text": "خرد در سر نامداران نکوست"
  },
  {
    "poem_id": 1509,
    "vorder": 61,
    "position": 0,
    "text": "نبد خسروان را چنو کدخدای"
  },
  {
    "poem_id": 1509,
    "vorder": 62,
    "position": 1,
    "text": "بپرهیز دین و به رادی و رای"
  },
  {
    "poem_id": 1509,
    "vorder": 63,
    "position": 0,
    "text": "گشاده زبان و دل و پاک دست"
  },
  {
    "poem_id": 1509,
    "vorder": 64,
    "position": 1,
    "text": "پرستندهٔ شاه یزدان پرست"
  },
  {
    "poem_id": 1509,
    "vorder": 65,
    "position": 0,
    "text": "ز دستور فرزانه و دادگر"
  },
  {
    "poem_id": 1509,
    "vorder": 66,
    "position": 1,
    "text": "پراگنده رنج من آمد به بر"
  },
  {
    "poem_id": 1509,
    "vorder": 67,
    "position": 0,
    "text": "بپیوستم این نامهٔ باستان"
  },
  {
    "poem_id": 1509,
    "vorder": 68,
    "position": 1,
    "text": "پسندیده از دفتر راستان"
  },
  {
    "poem_id": 1509,
    "vorder": 69,
    "position": 0,
    "text": "که تا روز پیری مرا بر دهد"
  },
  {
    "poem_id": 1509,
    "vorder": 70,
    "position": 1,
    "text": "بزرگی و دینار و افسر دهد"
  },
  {
    "poem_id": 1509,
    "vorder": 71,
    "position": 0,
    "text": "ندیدم جهاندار بخشنده‌ای"
  },
  {
    "poem_id": 1509,
    "vorder": 72,
    "position": 1,
    "text": "به تخت کیان بر درخشنده‌ای"
  },
  {
    "poem_id": 1509,
    "vorder": 73,
    "position": 0,
    "text": "همی داشتم تا کی آید پدید"
  },
  {
    "poem_id": 1509,
    "vorder": 74,
    "position": 1,
    "text": "جوادی که جودش نخواهد کلید"
  },
  {
    "poem_id": 1509,
    "vorder": 75,
    "position": 0,
    "text": "نگهبان دین و نگهبان تاج"
  },
  {
    "poem_id": 1509,
    "vorder": 76,
    "position": 1,
    "text": "فروزندهٔ افسر و تخت عاج"
  },
  {
    "poem_id": 1509,
    "vorder": 77,
    "position": 0,
    "text": "به رزم دلیران توانا بود"
  },
  {
    "poem_id": 1509,
    "vorder": 78,
    "position": 1,
    "text": "به چون و چرا نیز دانا بود"
  },
  {
    "poem_id": 1509,
    "vorder": 79,
    "position": 0,
    "text": "چنین سال بگذاشتم شست و پنج"
  },
  {
    "poem_id": 1509,
    "vorder": 80,
    "position": 1,
    "text": "به درویشی و زندگانی به رنج"
  },
  {
    "poem_id": 1509,
    "vorder": 81,
    "position": 0,
    "text": "چو پنج از سر سال شستم نشست"
  },
  {
    "poem_id": 1509,
    "vorder": 82,
    "position": 1,
    "text": "من اندر نشیب و سرم سوی پست"
  },
  {
    "poem_id": 1509,
    "vorder": 83,
    "position": 0,
    "text": "رخ لاله گون گشت بر سان کاه"
  },
  {
    "poem_id": 1509,
    "vorder": 84,
    "position": 1,
    "text": "چو کافور شد رنگ مشک سیاه"
  },
  {
    "poem_id": 1509,
    "vorder": 85,
    "position": 0,
    "text": "بدان گه که بد سال پنجاه و هفت"
  },
  {
    "poem_id": 1509,
    "vorder": 86,
    "position": 1,
    "text": "نوانتر شدم چون جوانی برفت"
  },
  {
    "poem_id": 1509,
    "vorder": 87,
    "position": 0,
    "text": "فریدون بیدار دل زنده شد"
  },
  {
    "poem_id": 1509,
    "vorder": 88,
    "position": 1,
    "text": "زمان و زمین پیش او بنده شد"
  },
  {
    "poem_id": 1509,
    "vorder": 89,
    "position": 0,
    "text": "بداد و به بخشش گرفت این جهان"
  },
  {
    "poem_id": 1509,
    "vorder": 90,
    "position": 1,
    "text": "سرش برتر آمد ز شاهنشهان"
  },
  {
    "poem_id": 1509,
    "vorder": 91,
    "position": 0,
    "text": "فروزان شد آثار تاریخ اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 92,
    "position": 1,
    "text": "که جاوید بادا بن و بیخ اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 93,
    "position": 0,
    "text": "از آن پس که گوشم شنید آن خروش"
  },
  {
    "poem_id": 1509,
    "vorder": 94,
    "position": 1,
    "text": "نهادم بر آن تیز آواز گوش"
  },
  {
    "poem_id": 1509,
    "vorder": 95,
    "position": 0,
    "text": "بپیوستم این نامه بر نام اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 96,
    "position": 1,
    "text": "همه مهتری باد فرجام اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 97,
    "position": 0,
    "text": "از آن پس تن جانور خاک راست"
  },
  {
    "poem_id": 1509,
    "vorder": 98,
    "position": 1,
    "text": "روان روان معدن پاک راست"
  },
  {
    "poem_id": 1509,
    "vorder": 99,
    "position": 0,
    "text": "همان نیزه بخشندهٔ دادگر"
  },
  {
    "poem_id": 1509,
    "vorder": 100,
    "position": 1,
    "text": "کز اوی است پیدا به گیتی هنر"
  },
  {
    "poem_id": 1509,
    "vorder": 101,
    "position": 0,
    "text": "که باشد به پیری مرا دستگیر"
  },
  {
    "poem_id": 1509,
    "vorder": 102,
    "position": 1,
    "text": "خداوند شمشیر و تاج و سریر"
  },
  {
    "poem_id": 1509,
    "vorder": 103,
    "position": 0,
    "text": "خداوند هند و خداوند چین"
  },
  {
    "poem_id": 1509,
    "vorder": 104,
    "position": 1,
    "text": "خداوند ایران و توران زمین"
  },
  {
    "poem_id": 1509,
    "vorder": 105,
    "position": 0,
    "text": "خداوند زیبای برترمنش"
  },
  {
    "poem_id": 1509,
    "vorder": 106,
    "position": 1,
    "text": "از او دور پیغاره و سرزنش"
  },
  {
    "poem_id": 1509,
    "vorder": 107,
    "position": 0,
    "text": "بدرد ز آواز او کوه سنگ"
  },
  {
    "poem_id": 1509,
    "vorder": 108,
    "position": 1,
    "text": "به دریا نهنگ و به خشکی پلنگ"
  },
  {
    "poem_id": 1509,
    "vorder": 109,
    "position": 0,
    "text": "چه دینار در پیش بزمش چه خاک"
  },
  {
    "poem_id": 1509,
    "vorder": 110,
    "position": 1,
    "text": "ز بخشش ندارد دلش هیچ باک"
  },
  {
    "poem_id": 1509,
    "vorder": 111,
    "position": 0,
    "text": "جهاندار محمود خورشیدفش"
  },
  {
    "poem_id": 1509,
    "vorder": 112,
    "position": 1,
    "text": "به رزم اندرون شیر شمشیرکش"
  },
  {
    "poem_id": 1509,
    "vorder": 113,
    "position": 0,
    "text": "مرا از جهان بی‌نیازی دهد"
  },
  {
    "poem_id": 1509,
    "vorder": 114,
    "position": 1,
    "text": "میان گوان سرفرازی دهد"
  },
  {
    "poem_id": 1509,
    "vorder": 115,
    "position": 0,
    "text": "که جاوید بادا سر و تخت اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 116,
    "position": 1,
    "text": "به کام دلش گردش بخت اوی"
  },
  {
    "poem_id": 1509,
    "vorder": 117,
    "position": 0,
    "text": "که داند ورا در جهان خود ستود"
  },
  {
    "poem_id": 1509,
    "vorder": 118,
    "position": 1,
    "text": "کسی کش ستاید که یارد شنود"
  },
  {
    "poem_id": 1509,
    "vorder": 119,
    "position": 0,
    "text": "که شاه از گمان و توان برتر است"
  },
  {
    "poem_id": 1509,
    "vorder": 120,
    "position": 1,
    "text": "چو بر تارک مشتری افسر است"
  },
  {
    "poem_id": 1509,
    "vorder": 121,
    "position": 0,
    "text": "یکی بندگی کردم ای شهریار"
  },
  {
    "poem_id": 1509,
    "vorder": 122,
    "position": 1,
    "text": "که ماند ز من در جهان یادگار"
  },
  {
    "poem_id": 1509,
    "vorder": 123,
    "position": 0,
    "text": "بناهای آباد گردد خراب"
  },
  {
    "poem_id": 1509,
    "vorder": 124,
    "position": 1,
    "text": "ز باران وز تابش آفتاب"
  },
  {
    "poem_id": 1509,
    "vorder": 125,
    "position": 0,
    "text": "پی افگندم از نظم کاخی بلند"
  },
  {
    "poem_id": 1509,
    "vorder": 126,
    "position": 1,
    "text": "که از باد و بارانش نآید گزند"
  },
  {
    "poem_id": 1509,
    "vorder": 127,
    "position": 0,
    "text": "بر این نامه بر سالها بگذرد"
  },
  {
    "poem_id": 1509,
    "vorder": 128,
    "position": 1,
    "text": "همی خواند آن کس که دارد خرد"
  },
  {
    "poem_id": 1509,
    "vorder": 129,
    "position": 0,
    "text": "کند آفرین بر جهاندار شاه"
  },
  {
    "poem_id": 1509,
    "vorder": 130,
    "position": 1,
    "text": "که بی او مبیناد کس پیشگاه"
  },
  {
    "poem_id": 1509,
    "vorder": 131,
    "position": 0,
    "text": "مر او را ستاینده کردار اوست"
  },
  {
    "poem_id": 1509,
    "vorder": 132,
    "position": 1,
    "text": "جهان سر به سر زیر آثار اوست"
  },
  {
    "poem_id": 1509,
    "vorder": 133,
    "position": 0,
    "text": "چو مایه ندارم ثنای ورا"
  },
  {
    "poem_id": 1509,
    "vorder": 134,
    "position": 1,
    "text": "نیایش کنم خاک پای ورا"
  },
  {
    "poem_id": 1509,
    "vorder": 135,
    "position": 0,
    "text": "زمانه سراسر بدو زنده باد"
  },
  {
    "poem_id": 1509,
    "vorder": 136,
    "position": 1,
    "text": "خرد تخت او را فروزنده باد"
  },
  {
    "poem_id": 1509,
    "vorder": 137,
    "position": 0,
    "text": "دلش شادمانه چو خرم بهار"
  },
  {
    "poem_id": 1509,
    "vorder": 138,
    "position": 1,
    "text": "همیشه بر این گردش روزگار"
  },
  {
    "poem_id": 1509,
    "vorder": 139,
    "position": 0,
    "text": "از او شادمانه دل انجمن"
  },
  {
    "poem_id": 1509,
    "vorder": 140,
    "position": 1,
    "text": "به هر کار پیروز و چیره سخن"
  },
  {
    "poem_id": 1509,
    "vorder": 141,
    "position": 0,
    "text": "همی تا بگردد فلک چرخ‌وار"
  },
  {
    "poem_id": 1509,
    "vorder": 142,
    "position": 1,
    "text": "بود اندر او مشتری را گذار"
  },
  {
    "poem_id": 1509,
    "vorder": 143,
    "position": 0,
    "text": "شهنشاه ما باد با جاه و ناز"
  },
  {
    "poem_id": 1509,
    "vorder": 144,
    "position": 1,
    "text": "از او دور چشم بد و بی نیاز"
  },
  {
    "poem_id": 1509,
    "vorder": 145,
    "position": 0,
    "text": "کنون ز این سپس نامه باستان"
  },
  {
    "poem_id": 1509,
    "vorder": 146,
    "position": 1,
    "text": "بپیوندم از گفتهٔ راستان"
  },
  {
    "poem_id": 1509,
    "vorder": 147,
    "position": 0,
    "text": "چو پیش آورم گردش روزگار"
  },
  {
    "poem_id": 1509,
    "vorder": 148,
    "position": 1,
    "text": "نباید مرا پند آموزگار"
  },
  {
    "poem_id": 1509,
    "vorder": 149,
    "position": 0,
    "text": "چو پیکار کیخسرو آمد پدید"
  },
  {
    "poem_id": 1509,
    "vorder": 150,
    "position": 1,
    "text": "ز من جادویها بباید شنید"
  },
  {
    "poem_id": 1509,
    "vorder": 151,
    "position": 0,
    "text": "بدین داستان در ببارم همی"
  },
  {
    "poem_id": 1509,
    "vorder": 152,
    "position": 1,
    "text": "به سنگ اندرون لاله کارم همی"
  },
  {
    "poem_id": 1509,
    "vorder": 153,
    "position": 0,
    "text": "کنون خامه‌ای یافتم بیش از آن"
  },
  {
    "poem_id": 1509,
    "vorder": 154,
    "position": 1,
    "text": "که مغز سخن بافتم پیش از آن"
  },
  {
    "poem_id": 1509,
    "vorder": 155,
    "position": 0,
    "text": "ایا آزمون را نهاده دو چشم"
  },
  {
    "poem_id": 1509,
    "vorder": 156,
    "position": 1,
    "text": "گهی شادمانی گهی درد و خشم"
  },
  {
    "poem_id": 1509,
    "vorder": 157,
    "position": 0,
    "text": "شگفت اندر این گنبد لاژورد"
  },
  {
    "poem_id": 1509,
    "vorder": 158,
    "position": 1,
    "text": "بماند چنین دل پر از داغ و درد"
  },
  {
    "poem_id": 1509,
    "vorder": 159,
    "position": 0,
    "text": "چنین بود تا بود دور زمان"
  },
  {
    "poem_id": 1509,
    "vorder": 160,
    "position": 1,
    "text": "به نوی تو اندر شگفتی ممان"
  },
  {
    "poem_id": 1509,
    "vorder": 161,
    "position": 0,
    "text": "یکی را همه بهره شهد است و قند"
  },
  {
    "poem_id": 1509,
    "vorder": 162,
    "position": 1,
    "text": "تن آسانی و ناز و بخت بلند"
  },
  {
    "poem_id": 1509,
    "vorder": 163,
    "position": 0,
    "text": "یکی ز او همه ساله با درد و رنج"
  },
  {
    "poem_id": 1509,
    "vorder": 164,
    "position": 1,
    "text": "شده تنگدل در سرای سپنج"
  },
  {
    "poem_id": 1509,
    "vorder": 165,
    "position": 0,
    "text": "یکی را همه رفتن اندر نهیب"
  },
  {
    "poem_id": 1509,
    "vorder": 166,
    "position": 1,
    "text": "گهی در فراز و گهی در نشیب"
  },
  {
    "poem_id": 1509,
    "vorder": 167,
    "position": 0,
    "text": "چنین پروراند همی روزگار"
  },
  {
    "poem_id": 1509,
    "vorder": 168,
    "position": 1,
    "text": "فزون آمد از رنگ گل رنج خار"
  },
  {
    "poem_id": 1509,
    "vorder": 169,
    "position": 0,
    "text": "هر آنگه که سال اندر آمد به شست"
  },
  {
    "poem_id": 1509,
    "vorder": 170,
    "position": 1,
    "text": "بباید کشیدن ز بیشیت دست"
  },
  {
    "poem_id": 1509,
    "vorder": 171,
    "position": 0,
    "text": "ز هفتاد برنگذرد بس کسی"
  },
  {
    "poem_id": 1509,
    "vorder": 172,
    "position": 1,
    "text": "ز دوران چرخ آزمودم بسی"
  },
  {
    "poem_id": 1509,
    "vorder": 173,
    "position": 0,
    "text": "وگر بگذرد آن همه بتریست"
  },
  {
    "poem_id": 1509,
    "vorder": 174,
    "position": 1,
    "text": "بر آن زندگانی بباید گریست"
  },
  {
    "poem_id": 1509,
    "vorder": 175,
    "position": 0,
    "text": "اگر دام ماهی بدی سال شست"
  },
  {
    "poem_id": 1509,
    "vorder": 176,
    "position": 1,
    "text": "خردمند از او یافتی راه جست"
  },
  {
    "poem_id": 1509,
    "vorder": 177,
    "position": 0,
    "text": "نیابیم بر چرخ گردنده راه"
  },
  {
    "poem_id": 1509,
    "vorder": 178,
    "position": 1,
    "text": "نه بر کار دادار خورشید و ماه"
  },
  {
    "poem_id": 1509,
    "vorder": 179,
    "position": 0,
    "text": "جهاندار اگر چند کوشد به رنج"
  },
  {
    "poem_id": 1509,
    "vorder": 180,
    "position": 1,
    "text": "بتازد به کین و بنازد به گنج"
  },
  {
    "poem_id": 1509,
    "vorder": 181,
    "position": 0,
    "text": "همش رفت باید به دیگر سرای"
  },
  {
    "poem_id": 1509,
    "vorder": 182,
    "position": 1,
    "text": "بماند همه کوشش ایدر به جای"
  },
  {
    "poem_id": 1509,
    "vorder": 183,
    "position": 0,
    "text": "تو از کار کیخسرو اندازه گیر"
  },
  {
    "poem_id": 1509,
    "vorder": 184,
    "position": 1,
    "text": "کهن گشته کار جهان تازه گیر"
  },
  {
    "poem_id": 1509,
    "vorder": 185,
    "position": 0,
    "text": "که کین پدر باز جست از نیا"
  },
  {
    "poem_id": 1509,
    "vorder": 186,
    "position": 1,
    "text": "به شمشیر و هم چاره و کیمیا"
  },
  {
    "poem_id": 1509,
    "vorder": 187,
    "position": 0,
    "text": "نیا را بکشت و خود ایدر نماند"
  },
  {
    "poem_id": 1509,
    "vorder": 188,
    "position": 1,
    "text": "جهان نیز منشور او را نخواند"
  },
  {
    "poem_id": 1509,
    "vorder": 189,
    "position": 0,
    "text": "چنین است رسم سرای سپنج"
  },
  {
    "poem_id": 1509,
    "vorder": 190,
    "position": 1,
    "text": "بدان کوش تا دور مانی ز رنج"
  }
]