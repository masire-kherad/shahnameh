[
  {
    "poem_id": 1422,
    "vorder": 1,
    "position": 0,
    "text": "بزد مهره در جام بر پشت پیل"
  },
  {
    "poem_id": 1422,
    "vorder": 2,
    "position": 1,
    "text": "ازو برشد آواز تا چند میل"
  },
  {
    "poem_id": 1422,
    "vorder": 3,
    "position": 0,
    "text": "خروشیدن کوس با کرنای"
  },
  {
    "poem_id": 1422,
    "vorder": 4,
    "position": 1,
    "text": "همان ژنده پیلان و هندی درای"
  },
  {
    "poem_id": 1422,
    "vorder": 5,
    "position": 0,
    "text": "برآمد ز زاولستان رستخیز"
  },
  {
    "poem_id": 1422,
    "vorder": 6,
    "position": 1,
    "text": "زمین خفته را بانگ برزد که خیز"
  },
  {
    "poem_id": 1422,
    "vorder": 7,
    "position": 0,
    "text": "به پیش اندرون رستم پهلوان"
  },
  {
    "poem_id": 1422,
    "vorder": 8,
    "position": 1,
    "text": "پس پشت او سالخورده گوان"
  },
  {
    "poem_id": 1422,
    "vorder": 9,
    "position": 0,
    "text": "چنان شد ز لشکر در و دشت و راغ"
  },
  {
    "poem_id": 1422,
    "vorder": 10,
    "position": 1,
    "text": "که بر سر نیارست پرید زاغ"
  },
  {
    "poem_id": 1422,
    "vorder": 11,
    "position": 0,
    "text": "تبیره زدندی همی شست جای"
  },
  {
    "poem_id": 1422,
    "vorder": 12,
    "position": 1,
    "text": "جهان را نه سر بود پیدا نه پای"
  },
  {
    "poem_id": 1422,
    "vorder": 13,
    "position": 0,
    "text": "به هنگام بشکوفهٔ گلستان"
  },
  {
    "poem_id": 1422,
    "vorder": 14,
    "position": 1,
    "text": "بیاورد لشکر ز زابلستان"
  },
  {
    "poem_id": 1422,
    "vorder": 15,
    "position": 0,
    "text": "ز زال آگهی یافت افراسیاب"
  },
  {
    "poem_id": 1422,
    "vorder": 16,
    "position": 1,
    "text": "برآمد ز آرام و از خورد و خواب"
  },
  {
    "poem_id": 1422,
    "vorder": 17,
    "position": 0,
    "text": "بیاورد لشکر سوی خوار ری"
  },
  {
    "poem_id": 1422,
    "vorder": 18,
    "position": 1,
    "text": "بران مرغزاری که بد آب و نی"
  },
  {
    "poem_id": 1422,
    "vorder": 19,
    "position": 0,
    "text": "ز ایران بیامد دمادم سپاه"
  },
  {
    "poem_id": 1422,
    "vorder": 20,
    "position": 1,
    "text": "ز راه بیابان سوی رزمگاه"
  },
  {
    "poem_id": 1422,
    "vorder": 21,
    "position": 0,
    "text": "ز لشکر به لشکر دو فرسنگ ماند"
  },
  {
    "poem_id": 1422,
    "vorder": 22,
    "position": 1,
    "text": "سپهبد جهاندیدگان را بخواند"
  },
  {
    "poem_id": 1422,
    "vorder": 23,
    "position": 0,
    "text": "بدیشان چنین گفت کای بخردان"
  },
  {
    "poem_id": 1422,
    "vorder": 24,
    "position": 1,
    "text": "جهاندیده و کارکرده ردان"
  },
  {
    "poem_id": 1422,
    "vorder": 25,
    "position": 0,
    "text": "هم ایدر من این لشکر آراستم"
  },
  {
    "poem_id": 1422,
    "vorder": 26,
    "position": 1,
    "text": "بسی سروری و مهی خواستم"
  },
  {
    "poem_id": 1422,
    "vorder": 27,
    "position": 0,
    "text": "پراگنده شد رای بی تخت شاه"
  },
  {
    "poem_id": 1422,
    "vorder": 28,
    "position": 1,
    "text": "همه کار بی‌روی و بی‌سر سپاه"
  },
  {
    "poem_id": 1422,
    "vorder": 29,
    "position": 0,
    "text": "چو بر تخت بنشست فرخنده زو"
  },
  {
    "poem_id": 1422,
    "vorder": 30,
    "position": 1,
    "text": "ز گیتی یکی آفرین خاست نو"
  },
  {
    "poem_id": 1422,
    "vorder": 31,
    "position": 0,
    "text": "شهی باید اکنون ز تخم کیان"
  },
  {
    "poem_id": 1422,
    "vorder": 32,
    "position": 1,
    "text": "به تخت کیی بر کمر بر میان"
  },
  {
    "poem_id": 1422,
    "vorder": 33,
    "position": 0,
    "text": "شهی کاو باورنگ دارد ز می"
  },
  {
    "poem_id": 1422,
    "vorder": 34,
    "position": 1,
    "text": "که بی‌سر نباشد تن آدمی"
  },
  {
    "poem_id": 1422,
    "vorder": 35,
    "position": 0,
    "text": "نشان داد موبد مرا در زمان"
  },
  {
    "poem_id": 1422,
    "vorder": 36,
    "position": 1,
    "text": "یکی شاه با فر و بخت جوان"
  },
  {
    "poem_id": 1422,
    "vorder": 37,
    "position": 0,
    "text": "ز تخم فریدون یل کیقباد"
  },
  {
    "poem_id": 1422,
    "vorder": 38,
    "position": 1,
    "text": "که با فر و برزست و با رای و داد"
  }
]