[
  {
    "poem_id": 1337,
    "vorder": 1,
    "position": 0,
    "text": "جهاندار هوشنگ با رای و داد"
  },
  {
    "poem_id": 1337,
    "vorder": 2,
    "position": 1,
    "text": "به جای نیا تاج بر سر نهاد"
  },
  {
    "poem_id": 1337,
    "vorder": 3,
    "position": 0,
    "text": "بگشت از برش چرخ سالی چهل"
  },
  {
    "poem_id": 1337,
    "vorder": 4,
    "position": 1,
    "text": "پر از هوش مغز و پر از رای دل"
  },
  {
    "poem_id": 1337,
    "vorder": 5,
    "position": 0,
    "text": "چو بنشست بر جایگاه مهی"
  },
  {
    "poem_id": 1337,
    "vorder": 6,
    "position": 1,
    "text": "چنین گفت بر تخت شاهنشهی"
  },
  {
    "poem_id": 1337,
    "vorder": 7,
    "position": 0,
    "text": "که بر هفت کشور منم پادشا"
  },
  {
    "poem_id": 1337,
    "vorder": 8,
    "position": 1,
    "text": "جهاندار پیروز و فرمانروا"
  },
  {
    "poem_id": 1337,
    "vorder": 9,
    "position": 0,
    "text": "به فرمان یزدان پیروزگر"
  },
  {
    "poem_id": 1337,
    "vorder": 10,
    "position": 1,
    "text": "به داد و دهش تنگ بستم کمر"
  },
  {
    "poem_id": 1337,
    "vorder": 11,
    "position": 0,
    "text": "و زان پس جهان یک‌سر آباد کرد"
  },
  {
    "poem_id": 1337,
    "vorder": 12,
    "position": 1,
    "text": "همه روی گیتی پر از داد کرد"
  },
  {
    "poem_id": 1337,
    "vorder": 13,
    "position": 0,
    "text": "نخستین یکی گوهر آمد به چنگ"
  },
  {
    "poem_id": 1337,
    "vorder": 14,
    "position": 1,
    "text": "به آتش ز آهن جدا کرد سنگ"
  },
  {
    "poem_id": 1337,
    "vorder": 15,
    "position": 0,
    "text": "سر مایه کرد آهن آبگون"
  },
  {
    "poem_id": 1337,
    "vorder": 16,
    "position": 1,
    "text": "کز آن سنگ خارا کشیدش برون"
  }
]