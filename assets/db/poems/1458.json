[
  {
    "poem_id": 1458,
    "vorder": 1,
    "position": 0,
    "text": "تهمتن برانگیخت رخش از شتاب"
  },
  {
    "poem_id": 1458,
    "vorder": 2,
    "position": 1,
    "text": "پس پشت جنگ آور افراسیاب"
  },
  {
    "poem_id": 1458,
    "vorder": 3,
    "position": 0,
    "text": "چنین گفت با رخش کای نیک یار"
  },
  {
    "poem_id": 1458,
    "vorder": 4,
    "position": 1,
    "text": "مکن سستی اندر گه کارزار"
  },
  {
    "poem_id": 1458,
    "vorder": 5,
    "position": 0,
    "text": "که من شاه را بر تو بی‌جان کنم"
  },
  {
    "poem_id": 1458,
    "vorder": 6,
    "position": 1,
    "text": "به خون سنگ را رنگ مرجان کنم"
  },
  {
    "poem_id": 1458,
    "vorder": 7,
    "position": 0,
    "text": "چنان گرم شد رخش آتش گهر"
  },
  {
    "poem_id": 1458,
    "vorder": 8,
    "position": 1,
    "text": "که گفتی برآمد ز پهلوش پر"
  },
  {
    "poem_id": 1458,
    "vorder": 9,
    "position": 0,
    "text": "ز فتراک بگشاد رستم کمند"
  },
  {
    "poem_id": 1458,
    "vorder": 10,
    "position": 1,
    "text": "همی خواست آورد او را ببند"
  },
  {
    "poem_id": 1458,
    "vorder": 11,
    "position": 0,
    "text": "به ترک اندر افتاد خم دوال"
  },
  {
    "poem_id": 1458,
    "vorder": 12,
    "position": 1,
    "text": "سپهدار ترکان بدزدید یال"
  },
  {
    "poem_id": 1458,
    "vorder": 13,
    "position": 0,
    "text": "و دیگر که زیر اندرش بادپای"
  },
  {
    "poem_id": 1458,
    "vorder": 14,
    "position": 1,
    "text": "به کردار آتش برآمد ز جای"
  },
  {
    "poem_id": 1458,
    "vorder": 15,
    "position": 0,
    "text": "بجست از کمند گو پیلتن"
  },
  {
    "poem_id": 1458,
    "vorder": 16,
    "position": 1,
    "text": "دهن خشک وز رنج پر آب تن"
  },
  {
    "poem_id": 1458,
    "vorder": 17,
    "position": 0,
    "text": "ز لشکر هرانکس که بد جنگ‌ساز"
  },
  {
    "poem_id": 1458,
    "vorder": 18,
    "position": 1,
    "text": "دو بهره نیامد به خرگاه باز"
  },
  {
    "poem_id": 1458,
    "vorder": 19,
    "position": 0,
    "text": "اگر کشته بودند اگر خسته تن"
  },
  {
    "poem_id": 1458,
    "vorder": 20,
    "position": 1,
    "text": "گرفتار در دست آن انجمن"
  },
  {
    "poem_id": 1458,
    "vorder": 21,
    "position": 0,
    "text": "ز پرمایه اسپان زرین ستام"
  },
  {
    "poem_id": 1458,
    "vorder": 22,
    "position": 1,
    "text": "ز ترگ و ز شمشیر زرین نیام"
  },
  {
    "poem_id": 1458,
    "vorder": 23,
    "position": 0,
    "text": "جزین هرچه پرمایه‌تر بود نیز"
  },
  {
    "poem_id": 1458,
    "vorder": 24,
    "position": 1,
    "text": "به ایرانیان ماند بسیار چیز"
  },
  {
    "poem_id": 1458,
    "vorder": 25,
    "position": 0,
    "text": "میان بازنگشاد کس کشته را"
  },
  {
    "poem_id": 1458,
    "vorder": 26,
    "position": 1,
    "text": "نجستند مردان برگشته را"
  },
  {
    "poem_id": 1458,
    "vorder": 27,
    "position": 0,
    "text": "بدان دشت نخچیر باز آمدند"
  },
  {
    "poem_id": 1458,
    "vorder": 28,
    "position": 1,
    "text": "ز هر نیکویی بی‌نیاز آمدند"
  },
  {
    "poem_id": 1458,
    "vorder": 29,
    "position": 0,
    "text": "نوشتند نامه به کاووس شاه"
  },
  {
    "poem_id": 1458,
    "vorder": 30,
    "position": 1,
    "text": "ز ترکان وز دشت نخچیرگاه"
  },
  {
    "poem_id": 1458,
    "vorder": 31,
    "position": 0,
    "text": "وزان کز دلیران نشد کشته کس"
  },
  {
    "poem_id": 1458,
    "vorder": 32,
    "position": 1,
    "text": "زواره ز اسپ اندر افتاد و بس"
  },
  {
    "poem_id": 1458,
    "vorder": 33,
    "position": 0,
    "text": "بران دشت فرخنده بر پهلوان"
  },
  {
    "poem_id": 1458,
    "vorder": 34,
    "position": 1,
    "text": "دو هفته همی بود روشن‌روان"
  },
  {
    "poem_id": 1458,
    "vorder": 35,
    "position": 0,
    "text": "سیم را به درگاه شاه آمدند"
  },
  {
    "poem_id": 1458,
    "vorder": 36,
    "position": 1,
    "text": "به دیدار فرخ کلاه آمدند"
  },
  {
    "poem_id": 1458,
    "vorder": 37,
    "position": 0,
    "text": "چنین است رسم سرای سپنج"
  },
  {
    "poem_id": 1458,
    "vorder": 38,
    "position": 1,
    "text": "یکی زو تن آسان و دیگر به رنج"
  },
  {
    "poem_id": 1458,
    "vorder": 39,
    "position": 0,
    "text": "برین و بران روز هم بگذرد"
  },
  {
    "poem_id": 1458,
    "vorder": 40,
    "position": 1,
    "text": "خردمند مردم چرا غم خورد"
  },
  {
    "poem_id": 1458,
    "vorder": 41,
    "position": 0,
    "text": "سخنهای این داستان شد به بن"
  },
  {
    "poem_id": 1458,
    "vorder": 42,
    "position": 1,
    "text": "ز سهراب و رستم سرایم سخن"
  }
]