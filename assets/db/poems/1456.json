[
  {
    "poem_id": 1456,
    "vorder": 1,
    "position": 0,
    "text": "چه گفت آن سراینده مرد دلیر"
  },
  {
    "poem_id": 1456,
    "vorder": 2,
    "position": 1,
    "text": "که ناگه برآویخت با نره شیر"
  },
  {
    "poem_id": 1456,
    "vorder": 3,
    "position": 0,
    "text": "که گر نام مردی بجویی همی"
  },
  {
    "poem_id": 1456,
    "vorder": 4,
    "position": 1,
    "text": "رخ تیغ هندی بشویی همی"
  },
  {
    "poem_id": 1456,
    "vorder": 5,
    "position": 0,
    "text": "ز بدها نبایدت پرهیز کرد"
  },
  {
    "poem_id": 1456,
    "vorder": 6,
    "position": 1,
    "text": "که پیش آیدت روز ننگ و نبرد"
  },
  {
    "poem_id": 1456,
    "vorder": 7,
    "position": 0,
    "text": "زمانه چو آمد بتنگی فراز"
  },
  {
    "poem_id": 1456,
    "vorder": 8,
    "position": 1,
    "text": "هم از تو نگردد به پرهیز باز"
  },
  {
    "poem_id": 1456,
    "vorder": 9,
    "position": 0,
    "text": "چو همره کنی جنگ را با خرد"
  },
  {
    "poem_id": 1456,
    "vorder": 10,
    "position": 1,
    "text": "دلیرت ز جنگ‌آوران نشمرد"
  },
  {
    "poem_id": 1456,
    "vorder": 11,
    "position": 0,
    "text": "خرد را و دین را رهی دیگرست"
  },
  {
    "poem_id": 1456,
    "vorder": 12,
    "position": 1,
    "text": "سخنهای نیکو به بند اندرست"
  },
  {
    "poem_id": 1456,
    "vorder": 13,
    "position": 0,
    "text": "کنون از ره رستم جنگجوی"
  },
  {
    "poem_id": 1456,
    "vorder": 14,
    "position": 1,
    "text": "یکی داستانست با رنگ و بوی"
  },
  {
    "poem_id": 1456,
    "vorder": 15,
    "position": 0,
    "text": "شنیدم که روزی گو پیلتن"
  },
  {
    "poem_id": 1456,
    "vorder": 16,
    "position": 1,
    "text": "یکی سور کرد از در انجمن"
  },
  {
    "poem_id": 1456,
    "vorder": 17,
    "position": 0,
    "text": "به جایی کجا نام او بد نوند"
  },
  {
    "poem_id": 1456,
    "vorder": 18,
    "position": 1,
    "text": "بدو اندرون کاخهای بلند"
  },
  {
    "poem_id": 1456,
    "vorder": 19,
    "position": 0,
    "text": "کجا آذر تیز برزین کنون"
  },
  {
    "poem_id": 1456,
    "vorder": 20,
    "position": 1,
    "text": "بدانجا فروزد همی رهنمون"
  },
  {
    "poem_id": 1456,
    "vorder": 21,
    "position": 0,
    "text": "بزرگان ایران بدان بزمگاه"
  },
  {
    "poem_id": 1456,
    "vorder": 22,
    "position": 1,
    "text": "شدند انجمن نامور یک سپاه"
  },
  {
    "poem_id": 1456,
    "vorder": 23,
    "position": 0,
    "text": "چو طوس و چو گودرز کشوادگان"
  },
  {
    "poem_id": 1456,
    "vorder": 24,
    "position": 1,
    "text": "چو بهرام و چون گیو آزادگان"
  },
  {
    "poem_id": 1456,
    "vorder": 25,
    "position": 0,
    "text": "چو گرگین و چون زنگهٔ شاوران"
  },
  {
    "poem_id": 1456,
    "vorder": 26,
    "position": 1,
    "text": "چو گستهم و خراد جنگ‌آوران"
  },
  {
    "poem_id": 1456,
    "vorder": 27,
    "position": 0,
    "text": "چو برزین گردنکش تیغ زن"
  },
  {
    "poem_id": 1456,
    "vorder": 28,
    "position": 1,
    "text": "گرازه کجا بد سر انجمن"
  },
  {
    "poem_id": 1456,
    "vorder": 29,
    "position": 0,
    "text": "ابا هر یک از مهتران مرد چند"
  },
  {
    "poem_id": 1456,
    "vorder": 30,
    "position": 1,
    "text": "یکی لشکری نامدار ارجمند"
  },
  {
    "poem_id": 1456,
    "vorder": 31,
    "position": 0,
    "text": "نیاسود لشکر زمانی ز کار"
  },
  {
    "poem_id": 1456,
    "vorder": 32,
    "position": 1,
    "text": "ز چوگان و تیر و نبید و شکار"
  },
  {
    "poem_id": 1456,
    "vorder": 33,
    "position": 0,
    "text": "به مستی چنین گفت یک روز گیو"
  },
  {
    "poem_id": 1456,
    "vorder": 34,
    "position": 1,
    "text": "به رستم که ای نامبردار نیو"
  },
  {
    "poem_id": 1456,
    "vorder": 35,
    "position": 0,
    "text": "گر ایدون که رای شکار آیدت"
  },
  {
    "poem_id": 1456,
    "vorder": 36,
    "position": 1,
    "text": "چو یوز دونده به کار آیدت"
  },
  {
    "poem_id": 1456,
    "vorder": 37,
    "position": 0,
    "text": "به نخچیرگاه رد افراسیاب"
  },
  {
    "poem_id": 1456,
    "vorder": 38,
    "position": 1,
    "text": "بپوشیم تابان رخ آفتاب"
  },
  {
    "poem_id": 1456,
    "vorder": 39,
    "position": 0,
    "text": "ز گرد سواران و از یوز و باز"
  },
  {
    "poem_id": 1456,
    "vorder": 40,
    "position": 1,
    "text": "بگیریم آرام روز دراز"
  },
  {
    "poem_id": 1456,
    "vorder": 41,
    "position": 0,
    "text": "به گور تگاور کمند افگنیم"
  },
  {
    "poem_id": 1456,
    "vorder": 42,
    "position": 1,
    "text": "به شمشیر بر شیر بند افگنیم"
  },
  {
    "poem_id": 1456,
    "vorder": 43,
    "position": 0,
    "text": "بدان دشت توران شکاری کنیم"
  },
  {
    "poem_id": 1456,
    "vorder": 44,
    "position": 1,
    "text": "که اندر جهان یادگاری کنیم"
  },
  {
    "poem_id": 1456,
    "vorder": 45,
    "position": 0,
    "text": "بدو گفت رستم که بی‌کام تو"
  },
  {
    "poem_id": 1456,
    "vorder": 46,
    "position": 1,
    "text": "مبادا گذر تا سرانجام تو"
  },
  {
    "poem_id": 1456,
    "vorder": 47,
    "position": 0,
    "text": "سحرگه بدان دشت توران شویم"
  },
  {
    "poem_id": 1456,
    "vorder": 48,
    "position": 1,
    "text": "ز نخچیر و از تاختن نغنویم"
  },
  {
    "poem_id": 1456,
    "vorder": 49,
    "position": 0,
    "text": "ببودند یکسر برین هم سخن"
  },
  {
    "poem_id": 1456,
    "vorder": 50,
    "position": 1,
    "text": "کسی رای دیگر نیفگند بن"
  },
  {
    "poem_id": 1456,
    "vorder": 51,
    "position": 0,
    "text": "سحرگه چو از خواب برخاستند"
  },
  {
    "poem_id": 1456,
    "vorder": 52,
    "position": 1,
    "text": "بران آرزو رفتن آراستند"
  },
  {
    "poem_id": 1456,
    "vorder": 53,
    "position": 0,
    "text": "برفتند با باز و شاهین و مهد"
  },
  {
    "poem_id": 1456,
    "vorder": 54,
    "position": 1,
    "text": "گرازنده و شاد تا رود شهد"
  },
  {
    "poem_id": 1456,
    "vorder": 55,
    "position": 0,
    "text": "به نخچیرگاه رد افراسیاب"
  },
  {
    "poem_id": 1456,
    "vorder": 56,
    "position": 1,
    "text": "ز یک دست ریگ و ز یک دست آب"
  },
  {
    "poem_id": 1456,
    "vorder": 57,
    "position": 0,
    "text": "دگر سو سرخس و بیابانش پیش"
  },
  {
    "poem_id": 1456,
    "vorder": 58,
    "position": 1,
    "text": "گله گشته بر دشت آهو و میش"
  },
  {
    "poem_id": 1456,
    "vorder": 59,
    "position": 0,
    "text": "همه دشت پر خرگه و خیمه گشت"
  },
  {
    "poem_id": 1456,
    "vorder": 60,
    "position": 1,
    "text": "از انبوه آهو سراسیمه گشت"
  },
  {
    "poem_id": 1456,
    "vorder": 61,
    "position": 0,
    "text": "ز درنده شیران زمین شد تهی"
  },
  {
    "poem_id": 1456,
    "vorder": 62,
    "position": 1,
    "text": "به پرنده مرغان رسید آگهی"
  },
  {
    "poem_id": 1456,
    "vorder": 63,
    "position": 0,
    "text": "تلی هر سویی مرغ و نخجیر بود"
  },
  {
    "poem_id": 1456,
    "vorder": 64,
    "position": 1,
    "text": "اگر کشته گر خستهٔ تیر بود"
  },
  {
    "poem_id": 1456,
    "vorder": 65,
    "position": 0,
    "text": "ز خنده نیاسود لب یک زمان"
  },
  {
    "poem_id": 1456,
    "vorder": 66,
    "position": 1,
    "text": "ببودند روشن دل و شادمان"
  },
  {
    "poem_id": 1456,
    "vorder": 67,
    "position": 0,
    "text": "به یک هفته زین‌گونه با می بدست"
  },
  {
    "poem_id": 1456,
    "vorder": 68,
    "position": 1,
    "text": "گهی تاختن گه نشاط نشست"
  },
  {
    "poem_id": 1456,
    "vorder": 69,
    "position": 0,
    "text": "بهشتم تهمتن بیامد پگاه"
  },
  {
    "poem_id": 1456,
    "vorder": 70,
    "position": 1,
    "text": "یکی رای شایسته زد با سپاه"
  },
  {
    "poem_id": 1456,
    "vorder": 71,
    "position": 0,
    "text": "چنین گفت رستم بدان سرکشان"
  },
  {
    "poem_id": 1456,
    "vorder": 72,
    "position": 1,
    "text": "بدان گرزداران مردم‌کشان"
  },
  {
    "poem_id": 1456,
    "vorder": 73,
    "position": 0,
    "text": "که از ما به افراسیاب این زمان"
  },
  {
    "poem_id": 1456,
    "vorder": 74,
    "position": 1,
    "text": "همانا رسید آگهی بی‌گمان"
  },
  {
    "poem_id": 1456,
    "vorder": 75,
    "position": 0,
    "text": "یکی چاره سازد بیاید بجنگ"
  },
  {
    "poem_id": 1456,
    "vorder": 76,
    "position": 1,
    "text": "کند دشت نخچیر بر یوز تنگ"
  },
  {
    "poem_id": 1456,
    "vorder": 77,
    "position": 0,
    "text": "بباید طلایه به ره بر یکی"
  },
  {
    "poem_id": 1456,
    "vorder": 78,
    "position": 1,
    "text": "که چون آگهی یابد او اندکی"
  },
  {
    "poem_id": 1456,
    "vorder": 79,
    "position": 0,
    "text": "بیاید دهد آگهی از سپاه"
  },
  {
    "poem_id": 1456,
    "vorder": 80,
    "position": 1,
    "text": "نباید که گیرد بداندیش راه"
  },
  {
    "poem_id": 1456,
    "vorder": 81,
    "position": 0,
    "text": "گرازه به زه بر نهاده کمان"
  },
  {
    "poem_id": 1456,
    "vorder": 82,
    "position": 1,
    "text": "بیامد بران کار بسته میان"
  },
  {
    "poem_id": 1456,
    "vorder": 83,
    "position": 0,
    "text": "سپه را که چون او نگهدار بود"
  },
  {
    "poem_id": 1456,
    "vorder": 84,
    "position": 1,
    "text": "همه چارهٔ دشمنان خوار بود"
  },
  {
    "poem_id": 1456,
    "vorder": 85,
    "position": 0,
    "text": "به نخچیر و خوردن نهادند روی"
  },
  {
    "poem_id": 1456,
    "vorder": 86,
    "position": 1,
    "text": "نکردند کس یاد پرخاشجوی"
  },
  {
    "poem_id": 1456,
    "vorder": 87,
    "position": 0,
    "text": "پس آگاهی آمد به افراسیاب"
  },
  {
    "poem_id": 1456,
    "vorder": 88,
    "position": 1,
    "text": "ازیشان شب تیره هنگام خواب"
  },
  {
    "poem_id": 1456,
    "vorder": 89,
    "position": 0,
    "text": "ز لشکر جهان‌دیدگان را بخواند"
  },
  {
    "poem_id": 1456,
    "vorder": 90,
    "position": 1,
    "text": "ز رستم بسی داستانها براند"
  },
  {
    "poem_id": 1456,
    "vorder": 91,
    "position": 0,
    "text": "وزان هفت گرد سوار دلیر"
  },
  {
    "poem_id": 1456,
    "vorder": 92,
    "position": 1,
    "text": "که بودند هر یک به کردار شیر"
  },
  {
    "poem_id": 1456,
    "vorder": 93,
    "position": 0,
    "text": "که ما را بباید کنون ساختن"
  },
  {
    "poem_id": 1456,
    "vorder": 94,
    "position": 1,
    "text": "بناگاه بردن یکی تاختن"
  },
  {
    "poem_id": 1456,
    "vorder": 95,
    "position": 0,
    "text": "گراین هفت یل را بچنگ آوریم"
  },
  {
    "poem_id": 1456,
    "vorder": 96,
    "position": 1,
    "text": "جهان پیش کاووس تنگ آوریم"
  },
  {
    "poem_id": 1456,
    "vorder": 97,
    "position": 0,
    "text": "بکردار نخچیر باید شدن"
  },
  {
    "poem_id": 1456,
    "vorder": 98,
    "position": 1,
    "text": "بناگاه لشکر برایشان زدن"
  },
  {
    "poem_id": 1456,
    "vorder": 99,
    "position": 0,
    "text": "گزین کرد شمشیر زن سی‌هزار"
  },
  {
    "poem_id": 1456,
    "vorder": 100,
    "position": 1,
    "text": "همه رزمجو از در کارزار"
  },
  {
    "poem_id": 1456,
    "vorder": 101,
    "position": 0,
    "text": "چنین گفت با نامداران جنگ"
  },
  {
    "poem_id": 1456,
    "vorder": 102,
    "position": 1,
    "text": "که ما را کنون نیست جای درنگ"
  },
  {
    "poem_id": 1456,
    "vorder": 103,
    "position": 0,
    "text": "به راه بیابان برون تاختند"
  },
  {
    "poem_id": 1456,
    "vorder": 104,
    "position": 1,
    "text": "همه جنگ را گردن افراختند"
  },
  {
    "poem_id": 1456,
    "vorder": 105,
    "position": 0,
    "text": "ز هر سو فرستاد بی‌مر سپاه"
  },
  {
    "poem_id": 1456,
    "vorder": 106,
    "position": 1,
    "text": "بدان سرکشان تا بگیرند راه"
  },
  {
    "poem_id": 1456,
    "vorder": 107,
    "position": 0,
    "text": "گرازه چو گرد سپه را بدید"
  },
  {
    "poem_id": 1456,
    "vorder": 108,
    "position": 1,
    "text": "بیامد سپه را همه بنگرید"
  },
  {
    "poem_id": 1456,
    "vorder": 109,
    "position": 0,
    "text": "بدید آنک شد روی گیتی سیاه"
  },
  {
    "poem_id": 1456,
    "vorder": 110,
    "position": 1,
    "text": "درفش سپهدار توران سپاه"
  },
  {
    "poem_id": 1456,
    "vorder": 111,
    "position": 0,
    "text": "ازانجا چو باد دمان گشت باز"
  },
  {
    "poem_id": 1456,
    "vorder": 112,
    "position": 1,
    "text": "تو گفتی به زخم اندر آمد گراز"
  },
  {
    "poem_id": 1456,
    "vorder": 113,
    "position": 0,
    "text": "بیامد دمان تا به نخچیرگاه"
  },
  {
    "poem_id": 1456,
    "vorder": 114,
    "position": 1,
    "text": "تهمتن همی خورد می با سپاه"
  },
  {
    "poem_id": 1456,
    "vorder": 115,
    "position": 0,
    "text": "چنین گفت با رستم شیرمرد"
  },
  {
    "poem_id": 1456,
    "vorder": 116,
    "position": 1,
    "text": "که برخیز و از خرمی بازگرد"
  },
  {
    "poem_id": 1456,
    "vorder": 117,
    "position": 0,
    "text": "که چندان سپاهست کاندازه نیست"
  },
  {
    "poem_id": 1456,
    "vorder": 118,
    "position": 1,
    "text": "ز لشکر بلندی و پستی یکیست"
  },
  {
    "poem_id": 1456,
    "vorder": 119,
    "position": 0,
    "text": "درفش جفاپیشه افراسیاب"
  },
  {
    "poem_id": 1456,
    "vorder": 120,
    "position": 1,
    "text": "همی تابد از گرد چون آفتاب"
  },
  {
    "poem_id": 1456,
    "vorder": 121,
    "position": 0,
    "text": "چو بشنید رستم بخندید سخت"
  },
  {
    "poem_id": 1456,
    "vorder": 122,
    "position": 1,
    "text": "بدو گفت با ماست پیروز بخت"
  },
  {
    "poem_id": 1456,
    "vorder": 123,
    "position": 0,
    "text": "تو از شاه ترکان چه ترسی چنین"
  },
  {
    "poem_id": 1456,
    "vorder": 124,
    "position": 1,
    "text": "ز گرد سواران توران زمین"
  },
  {
    "poem_id": 1456,
    "vorder": 125,
    "position": 0,
    "text": "سپاهش فزون نیست از صدهزار"
  },
  {
    "poem_id": 1456,
    "vorder": 126,
    "position": 1,
    "text": "عنان پیچ و برگستوان‌ور سوار"
  },
  {
    "poem_id": 1456,
    "vorder": 127,
    "position": 0,
    "text": "بدین دشت کین بر گر از ما یکی‌ست"
  },
  {
    "poem_id": 1456,
    "vorder": 128,
    "position": 1,
    "text": "همی جنگ ترکان بچشم اندکی‌ست"
  },
  {
    "poem_id": 1456,
    "vorder": 129,
    "position": 0,
    "text": "شده هفت گرد سوار انجمن"
  },
  {
    "poem_id": 1456,
    "vorder": 130,
    "position": 1,
    "text": "چنین نامبردار و شمشیرزن"
  },
  {
    "poem_id": 1456,
    "vorder": 131,
    "position": 0,
    "text": "یکی باشد از ما وزیشان هزار"
  },
  {
    "poem_id": 1456,
    "vorder": 132,
    "position": 1,
    "text": "سپه چند باید ز ترکان شمار"
  },
  {
    "poem_id": 1456,
    "vorder": 133,
    "position": 0,
    "text": "برین دشت اگر ویژه تنها منم"
  },
  {
    "poem_id": 1456,
    "vorder": 134,
    "position": 1,
    "text": "که بر پشت گلرنگ در جوشنم"
  },
  {
    "poem_id": 1456,
    "vorder": 135,
    "position": 0,
    "text": "چنو کینه خواهی بیاید مرا"
  },
  {
    "poem_id": 1456,
    "vorder": 136,
    "position": 1,
    "text": "از ایران سپاهی نباید مرا"
  },
  {
    "poem_id": 1456,
    "vorder": 137,
    "position": 0,
    "text": "تو ای می‌گسار از می بابلی"
  },
  {
    "poem_id": 1456,
    "vorder": 138,
    "position": 1,
    "text": "بپیمای تا سر یکی بلبلی"
  },
  {
    "poem_id": 1456,
    "vorder": 139,
    "position": 0,
    "text": "بپیمود می ساقی و داد زود"
  },
  {
    "poem_id": 1456,
    "vorder": 140,
    "position": 1,
    "text": "تهمتن شد از دادنش شاد زود"
  },
  {
    "poem_id": 1456,
    "vorder": 141,
    "position": 0,
    "text": "به کف بر نهاد آن درخشنده جام"
  },
  {
    "poem_id": 1456,
    "vorder": 142,
    "position": 1,
    "text": "نخستین ز کاووس کی برد نام"
  },
  {
    "poem_id": 1456,
    "vorder": 143,
    "position": 0,
    "text": "که شاه زمانه مرا یاد باد"
  },
  {
    "poem_id": 1456,
    "vorder": 144,
    "position": 1,
    "text": "همیشه بروبومش آباد باد"
  },
  {
    "poem_id": 1456,
    "vorder": 145,
    "position": 0,
    "text": "ازان پس تهمتن زمین داد بوس"
  },
  {
    "poem_id": 1456,
    "vorder": 146,
    "position": 1,
    "text": "چنین گفت کاین باده بر یاد طوس"
  },
  {
    "poem_id": 1456,
    "vorder": 147,
    "position": 0,
    "text": "سران جهاندار برخاستند"
  },
  {
    "poem_id": 1456,
    "vorder": 148,
    "position": 1,
    "text": "ابا پهلوان خواهش آراستند"
  },
  {
    "poem_id": 1456,
    "vorder": 149,
    "position": 0,
    "text": "که ما را بدین جام می جای نیست"
  },
  {
    "poem_id": 1456,
    "vorder": 150,
    "position": 1,
    "text": "به می با تو ابلیس را پای نیست"
  },
  {
    "poem_id": 1456,
    "vorder": 151,
    "position": 0,
    "text": "می و گرز یک زخم و میدان جنگ"
  },
  {
    "poem_id": 1456,
    "vorder": 152,
    "position": 1,
    "text": "جز از تو کسی را نیامد به چنگ"
  },
  {
    "poem_id": 1456,
    "vorder": 153,
    "position": 0,
    "text": "می بابلی سرخ در جام زرد"
  },
  {
    "poem_id": 1456,
    "vorder": 154,
    "position": 1,
    "text": "تهمتن بروی زواره بخورد"
  },
  {
    "poem_id": 1456,
    "vorder": 155,
    "position": 0,
    "text": "زواره چو بلبل به کف برنهاد"
  },
  {
    "poem_id": 1456,
    "vorder": 156,
    "position": 1,
    "text": "هم از شاه کاووس کی کرد یاد"
  },
  {
    "poem_id": 1456,
    "vorder": 157,
    "position": 0,
    "text": "بخورد و ببوسید روی زمین"
  },
  {
    "poem_id": 1456,
    "vorder": 158,
    "position": 1,
    "text": "تهمتن برو برگرفت آفرین"
  },
  {
    "poem_id": 1456,
    "vorder": 159,
    "position": 0,
    "text": "که جام برادر برادر خورد"
  },
  {
    "poem_id": 1456,
    "vorder": 160,
    "position": 1,
    "text": "هژبر آنک او جام می بشکرد"
  }
]