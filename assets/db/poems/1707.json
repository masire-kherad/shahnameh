[
  {
    "poem_id": 1707,
    "vorder": 1,
    "position": 0,
    "text": "چو آگاه شد زان سخن هفتواد"
  },
  {
    "poem_id": 1707,
    "vorder": 2,
    "position": 1,
    "text": "دلش گشت پردرد و سر پر ز باد"
  },
  {
    "poem_id": 1707,
    "vorder": 3,
    "position": 0,
    "text": "بیامد که دژ را کند خواستار"
  },
  {
    "poem_id": 1707,
    "vorder": 4,
    "position": 1,
    "text": "بران باره بر شد دمان شهریار"
  },
  {
    "poem_id": 1707,
    "vorder": 5,
    "position": 0,
    "text": "بکوشید چندی نیامدش سود"
  },
  {
    "poem_id": 1707,
    "vorder": 6,
    "position": 1,
    "text": "که بر بارهٔ دژ پی شیر بود"
  },
  {
    "poem_id": 1707,
    "vorder": 7,
    "position": 0,
    "text": "وزان روی لشکر بیامد چو کوه"
  },
  {
    "poem_id": 1707,
    "vorder": 8,
    "position": 1,
    "text": "بماندند با داغ و درد آن گروه"
  },
  {
    "poem_id": 1707,
    "vorder": 9,
    "position": 0,
    "text": "چنین گفت زان باره شاه اردشیر"
  },
  {
    "poem_id": 1707,
    "vorder": 10,
    "position": 1,
    "text": "که نزدیک جنگ آی ای شهرگیر"
  },
  {
    "poem_id": 1707,
    "vorder": 11,
    "position": 0,
    "text": "اگر گم شود از میان هفتواد"
  },
  {
    "poem_id": 1707,
    "vorder": 12,
    "position": 1,
    "text": "نماند به چنگ تو جز رنج و باد"
  },
  {
    "poem_id": 1707,
    "vorder": 13,
    "position": 0,
    "text": "که من کرم را دادم ارزیز گرم"
  },
  {
    "poem_id": 1707,
    "vorder": 14,
    "position": 1,
    "text": "شد آن دولت و رفتن تیز نرم"
  },
  {
    "poem_id": 1707,
    "vorder": 15,
    "position": 0,
    "text": "شنید آن همه لشکر آواز شاه"
  },
  {
    "poem_id": 1707,
    "vorder": 16,
    "position": 1,
    "text": "به سر بر نهادند ز آهن کلاه"
  },
  {
    "poem_id": 1707,
    "vorder": 17,
    "position": 0,
    "text": "ازان دل گرفتند ایرانیان"
  },
  {
    "poem_id": 1707,
    "vorder": 18,
    "position": 1,
    "text": "ببستند با درد کین را میان"
  },
  {
    "poem_id": 1707,
    "vorder": 19,
    "position": 0,
    "text": "سوی لشکر کرم برگشت باد"
  },
  {
    "poem_id": 1707,
    "vorder": 20,
    "position": 1,
    "text": "گرفتار شد در میان هفتواد"
  },
  {
    "poem_id": 1707,
    "vorder": 21,
    "position": 0,
    "text": "همان نیز شاهوی عیار اوی"
  },
  {
    "poem_id": 1707,
    "vorder": 22,
    "position": 1,
    "text": "که مهتر پسر بود و سالار اوی"
  },
  {
    "poem_id": 1707,
    "vorder": 23,
    "position": 0,
    "text": "فرود آمد از باره شاه اردشیر"
  },
  {
    "poem_id": 1707,
    "vorder": 24,
    "position": 1,
    "text": "پیاده ببد پیش او شهرگیر"
  },
  {
    "poem_id": 1707,
    "vorder": 25,
    "position": 0,
    "text": "ببردند بالای زرین لگام"
  },
  {
    "poem_id": 1707,
    "vorder": 26,
    "position": 1,
    "text": "نشست از برش مهتر شادکام"
  },
  {
    "poem_id": 1707,
    "vorder": 27,
    "position": 0,
    "text": "بفرمود پس شهریار بلند"
  },
  {
    "poem_id": 1707,
    "vorder": 28,
    "position": 1,
    "text": "زدن پیش دریا دو دار بلند"
  },
  {
    "poem_id": 1707,
    "vorder": 29,
    "position": 0,
    "text": "دو بدخواه را زنده بر دار کرد"
  },
  {
    "poem_id": 1707,
    "vorder": 30,
    "position": 1,
    "text": "دل دشمن از خواب بیدار کرد"
  },
  {
    "poem_id": 1707,
    "vorder": 31,
    "position": 0,
    "text": "بیامد ز قلب سپه شهرگیر"
  },
  {
    "poem_id": 1707,
    "vorder": 32,
    "position": 1,
    "text": "بکشت آن دو تن را به باران تیر"
  },
  {
    "poem_id": 1707,
    "vorder": 33,
    "position": 0,
    "text": "به تاراج داد آن همه خواسته"
  },
  {
    "poem_id": 1707,
    "vorder": 34,
    "position": 1,
    "text": "شد از خواسته لشکر آراسته"
  },
  {
    "poem_id": 1707,
    "vorder": 35,
    "position": 0,
    "text": "به دژ هرچ بود از کران تا کران"
  },
  {
    "poem_id": 1707,
    "vorder": 36,
    "position": 1,
    "text": "فرود آوریدند فرمانبران"
  },
  {
    "poem_id": 1707,
    "vorder": 37,
    "position": 0,
    "text": "ز پرمایه چیزی که بد دلپذیر"
  },
  {
    "poem_id": 1707,
    "vorder": 38,
    "position": 1,
    "text": "همی تاخت تا خره اردشیر"
  },
  {
    "poem_id": 1707,
    "vorder": 39,
    "position": 0,
    "text": "بکرد اندران کشور آتشکده"
  },
  {
    "poem_id": 1707,
    "vorder": 40,
    "position": 1,
    "text": "بدو تازه شد مهرگان و سده"
  },
  {
    "poem_id": 1707,
    "vorder": 41,
    "position": 0,
    "text": "سپرد آن زمان کشور و تاج و تخت"
  },
  {
    "poem_id": 1707,
    "vorder": 42,
    "position": 1,
    "text": "بدان میزبانان بیدار بخت"
  },
  {
    "poem_id": 1707,
    "vorder": 43,
    "position": 0,
    "text": "وزان جایگه رفت پیروز و شاد"
  },
  {
    "poem_id": 1707,
    "vorder": 44,
    "position": 1,
    "text": "بگسترد بر کشور پارس داد"
  },
  {
    "poem_id": 1707,
    "vorder": 45,
    "position": 0,
    "text": "چو آسوده‌تر گشت مرد و ستور"
  },
  {
    "poem_id": 1707,
    "vorder": 46,
    "position": 1,
    "text": "بیاورد لشکر سوی شهر گور"
  },
  {
    "poem_id": 1707,
    "vorder": 47,
    "position": 0,
    "text": "به کرمان فرستاد چندی سپاه"
  },
  {
    "poem_id": 1707,
    "vorder": 48,
    "position": 1,
    "text": "یکی مرد شایستهٔ تاج و گاه"
  },
  {
    "poem_id": 1707,
    "vorder": 49,
    "position": 0,
    "text": "وزان جایگه شد سوی طیسفون"
  },
  {
    "poem_id": 1707,
    "vorder": 50,
    "position": 1,
    "text": "سر بخت بدخواه کرده نگون"
  },
  {
    "poem_id": 1707,
    "vorder": 51,
    "position": 0,
    "text": "چنین است رسم جهان جهان"
  },
  {
    "poem_id": 1707,
    "vorder": 52,
    "position": 1,
    "text": "همی راز خویش از تو دارد نهان"
  },
  {
    "poem_id": 1707,
    "vorder": 53,
    "position": 0,
    "text": "نسازد تو ناچار با او بساز"
  },
  {
    "poem_id": 1707,
    "vorder": 54,
    "position": 1,
    "text": "که روزی نشیب است و روزی فراز"
  },
  {
    "poem_id": 1707,
    "vorder": 55,
    "position": 0,
    "text": "چو از گفتهٔ کرم پرداختم"
  },
  {
    "poem_id": 1707,
    "vorder": 56,
    "position": 1,
    "text": "دری دیگر از اردشیر آختم"
  }
]