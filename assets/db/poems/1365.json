[
  {
    "poem_id": 1365,
    "vorder": 1,
    "position": 0,
    "text": "یکی نامه بنوشت شاه زمین"
  },
  {
    "poem_id": 1365,
    "vorder": 2,
    "position": 1,
    "text": "به خاور خدای و به سالار چین"
  },
  {
    "poem_id": 1365,
    "vorder": 3,
    "position": 0,
    "text": "سر نامه کرد آفرین خدای"
  },
  {
    "poem_id": 1365,
    "vorder": 4,
    "position": 1,
    "text": "کجا هست و باشد همیشه به جای"
  },
  {
    "poem_id": 1365,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کاین نامهٔ پندمند"
  },
  {
    "poem_id": 1365,
    "vorder": 6,
    "position": 1,
    "text": "به نزد دو خورشید گشته بلند"
  },
  {
    "poem_id": 1365,
    "vorder": 7,
    "position": 0,
    "text": "دو سنگی دو جنگی دو شاه زمین"
  },
  {
    "poem_id": 1365,
    "vorder": 8,
    "position": 1,
    "text": "میان کیان چون درخشان نگین"
  },
  {
    "poem_id": 1365,
    "vorder": 9,
    "position": 0,
    "text": "از آنکو ز هر گونه دیده جهان"
  },
  {
    "poem_id": 1365,
    "vorder": 10,
    "position": 1,
    "text": "شده آشکارا برو بر نهان"
  },
  {
    "poem_id": 1365,
    "vorder": 11,
    "position": 0,
    "text": "گرایندهٔ تیغ و گرز گران"
  },
  {
    "poem_id": 1365,
    "vorder": 12,
    "position": 1,
    "text": "فروزندهٔ نامدار افسران"
  },
  {
    "poem_id": 1365,
    "vorder": 13,
    "position": 0,
    "text": "نمایندهٔ شب به روز سپید"
  },
  {
    "poem_id": 1365,
    "vorder": 14,
    "position": 1,
    "text": "گشایندهٔ گنج پیش امید"
  },
  {
    "poem_id": 1365,
    "vorder": 15,
    "position": 0,
    "text": "همه رنجها گشته آسان بدوی"
  },
  {
    "poem_id": 1365,
    "vorder": 16,
    "position": 1,
    "text": "برو روشنی اندر آورده روی"
  },
  {
    "poem_id": 1365,
    "vorder": 17,
    "position": 0,
    "text": "نخواهم همی خویشتن را کلاه"
  },
  {
    "poem_id": 1365,
    "vorder": 18,
    "position": 1,
    "text": "نه آگنده گنج و نه تاج و نه گاه"
  },
  {
    "poem_id": 1365,
    "vorder": 19,
    "position": 0,
    "text": "سه فرزند را خواهم آرام و ناز"
  },
  {
    "poem_id": 1365,
    "vorder": 20,
    "position": 1,
    "text": "از آن پس که دیدیم رنج دراز"
  },
  {
    "poem_id": 1365,
    "vorder": 21,
    "position": 0,
    "text": "برادر کزو بود دلتان به درد"
  },
  {
    "poem_id": 1365,
    "vorder": 22,
    "position": 1,
    "text": "وگر چند هرگز نزد باد سرد"
  },
  {
    "poem_id": 1365,
    "vorder": 23,
    "position": 0,
    "text": "دوان آمد از بهر آزارتان"
  },
  {
    "poem_id": 1365,
    "vorder": 24,
    "position": 1,
    "text": "که بود آرزومند دیدارتان"
  },
  {
    "poem_id": 1365,
    "vorder": 25,
    "position": 0,
    "text": "بیفگند شاهی شما را گزید"
  },
  {
    "poem_id": 1365,
    "vorder": 26,
    "position": 1,
    "text": "چنان کز ره نامداران سزید"
  },
  {
    "poem_id": 1365,
    "vorder": 27,
    "position": 0,
    "text": "ز تخت اندر آمد به زین برنشست"
  },
  {
    "poem_id": 1365,
    "vorder": 28,
    "position": 1,
    "text": "برفت و میان بندگی را ببست"
  },
  {
    "poem_id": 1365,
    "vorder": 29,
    "position": 0,
    "text": "بدان کو به سال از شما کهترست"
  },
  {
    "poem_id": 1365,
    "vorder": 30,
    "position": 1,
    "text": "نوازیدن کهتر اندر خورست"
  },
  {
    "poem_id": 1365,
    "vorder": 31,
    "position": 0,
    "text": "گرامیش دارید و نوشه خورید"
  },
  {
    "poem_id": 1365,
    "vorder": 32,
    "position": 1,
    "text": "چو پرورده شد تن روان پرورید"
  },
  {
    "poem_id": 1365,
    "vorder": 33,
    "position": 0,
    "text": "چو از بودنش بگذرد روز چند"
  },
  {
    "poem_id": 1365,
    "vorder": 34,
    "position": 1,
    "text": "فرستید با زی منش ارجمند"
  },
  {
    "poem_id": 1365,
    "vorder": 35,
    "position": 0,
    "text": "نهادند بر نامه بر مهر شاه"
  },
  {
    "poem_id": 1365,
    "vorder": 36,
    "position": 1,
    "text": "ز ایوان بر ایرج گزین کرد راه"
  },
  {
    "poem_id": 1365,
    "vorder": 37,
    "position": 0,
    "text": "بشد با تنی چند برنا و پیر"
  },
  {
    "poem_id": 1365,
    "vorder": 38,
    "position": 1,
    "text": "چنان چون بود راه را ناگزیر"
  }
]