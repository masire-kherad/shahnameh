[
  {
    "poem_id": 1917,
    "vorder": 1,
    "position": 0,
    "text": "چو آوردم این روز خسرو ببن"
  },
  {
    "poem_id": 1917,
    "vorder": 2,
    "position": 1,
    "text": "ز شیروی و شیرین گشایم سخن"
  },
  {
    "poem_id": 1917,
    "vorder": 3,
    "position": 0,
    "text": "چو پنجاه و سه روز بگذشت زین"
  },
  {
    "poem_id": 1917,
    "vorder": 4,
    "position": 1,
    "text": "که شد کشته آن شاه با آفرین"
  },
  {
    "poem_id": 1917,
    "vorder": 5,
    "position": 0,
    "text": "به شیرین فرستاد شیروی کس"
  },
  {
    "poem_id": 1917,
    "vorder": 6,
    "position": 1,
    "text": "که ای نره جادوی بی‌دست رس"
  },
  {
    "poem_id": 1917,
    "vorder": 7,
    "position": 0,
    "text": "همه جادویی دانی و بدخویی"
  },
  {
    "poem_id": 1917,
    "vorder": 8,
    "position": 1,
    "text": "به ایران گنکار ترکس تویی"
  },
  {
    "poem_id": 1917,
    "vorder": 9,
    "position": 0,
    "text": "به تنبل همی‌داشتی شاه را"
  },
  {
    "poem_id": 1917,
    "vorder": 10,
    "position": 1,
    "text": "به چاره فرود آوری ماه را"
  },
  {
    "poem_id": 1917,
    "vorder": 11,
    "position": 0,
    "text": "بترس ای گنهکار و نزد من آی"
  },
  {
    "poem_id": 1917,
    "vorder": 12,
    "position": 1,
    "text": "به ایوان چنین شاد و ایمن مپای"
  },
  {
    "poem_id": 1917,
    "vorder": 13,
    "position": 0,
    "text": "برآشفت شیرین ز پیغام او"
  },
  {
    "poem_id": 1917,
    "vorder": 14,
    "position": 1,
    "text": "وزان پرگنه زشت دشنام او"
  },
  {
    "poem_id": 1917,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت کنکس که خون پدر"
  },
  {
    "poem_id": 1917,
    "vorder": 16,
    "position": 1,
    "text": "بریزد مباداش بالا وبر"
  },
  {
    "poem_id": 1917,
    "vorder": 17,
    "position": 0,
    "text": "نبینم من آن بدکنش را ز دور"
  },
  {
    "poem_id": 1917,
    "vorder": 18,
    "position": 1,
    "text": "نه هنگام ماتم نه هنگام سور"
  },
  {
    "poem_id": 1917,
    "vorder": 19,
    "position": 0,
    "text": "دبیری بیاورد انده بری"
  },
  {
    "poem_id": 1917,
    "vorder": 20,
    "position": 1,
    "text": "همان ساخته پهلوی دفتری"
  },
  {
    "poem_id": 1917,
    "vorder": 21,
    "position": 0,
    "text": "بدان مرد داننده اندرز کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 22,
    "position": 1,
    "text": "همه خواسته پیش او ارز کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 23,
    "position": 0,
    "text": "همی‌داشت لختی به صندوق زهر"
  },
  {
    "poem_id": 1917,
    "vorder": 24,
    "position": 1,
    "text": "که زهرش نبایست جستن به شهر"
  },
  {
    "poem_id": 1917,
    "vorder": 25,
    "position": 0,
    "text": "همی‌داشت آن زهر با خویشتن"
  },
  {
    "poem_id": 1917,
    "vorder": 26,
    "position": 1,
    "text": "همی‌دوخت سرو چمن را کفن"
  },
  {
    "poem_id": 1917,
    "vorder": 27,
    "position": 0,
    "text": "فرستاد پاسخ به شیروی باز"
  },
  {
    "poem_id": 1917,
    "vorder": 28,
    "position": 1,
    "text": "که ای تاجور شاه گردن فراز"
  },
  {
    "poem_id": 1917,
    "vorder": 29,
    "position": 0,
    "text": "سخنها که گفتی تو برگست و باد"
  },
  {
    "poem_id": 1917,
    "vorder": 30,
    "position": 1,
    "text": "دل و جان آن بدکنش پست باد"
  },
  {
    "poem_id": 1917,
    "vorder": 31,
    "position": 0,
    "text": "کجا در جهان جادویی جز بنام"
  },
  {
    "poem_id": 1917,
    "vorder": 32,
    "position": 1,
    "text": "شنودست و بودست زان شادکام"
  },
  {
    "poem_id": 1917,
    "vorder": 33,
    "position": 0,
    "text": "وگر شاه ازین رسم و اندازه بود"
  },
  {
    "poem_id": 1917,
    "vorder": 34,
    "position": 1,
    "text": "که رای وی از جادوی تازه بود"
  },
  {
    "poem_id": 1917,
    "vorder": 35,
    "position": 0,
    "text": "که جادو بدی کس به مشکوی شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 36,
    "position": 1,
    "text": "به دیده به دیدی همان روی شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 37,
    "position": 0,
    "text": "مرا از پی فرخی داشتی"
  },
  {
    "poem_id": 1917,
    "vorder": 38,
    "position": 1,
    "text": "که شبگیر چون چشم بگماشتی"
  },
  {
    "poem_id": 1917,
    "vorder": 39,
    "position": 0,
    "text": "ز مشکوی زرین مرا خواستی"
  },
  {
    "poem_id": 1917,
    "vorder": 40,
    "position": 1,
    "text": "به دیدار من جان بیاراستی"
  },
  {
    "poem_id": 1917,
    "vorder": 41,
    "position": 0,
    "text": "ز گفتار چونین سخن شرم دار"
  },
  {
    "poem_id": 1917,
    "vorder": 42,
    "position": 1,
    "text": "چه بندی سخن کژ بر شهریار"
  },
  {
    "poem_id": 1917,
    "vorder": 43,
    "position": 0,
    "text": "ز دادار نیکی دهش یاد کن"
  },
  {
    "poem_id": 1917,
    "vorder": 44,
    "position": 1,
    "text": "به پیش کس اندر مگو این سخن"
  },
  {
    "poem_id": 1917,
    "vorder": 45,
    "position": 0,
    "text": "ببردند پاسخ به نزدیک شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 46,
    "position": 1,
    "text": "بر آشفت شیروی زان بیگناه"
  },
  {
    "poem_id": 1917,
    "vorder": 47,
    "position": 0,
    "text": "چنین گفت کز آمدن چاره نیست"
  },
  {
    "poem_id": 1917,
    "vorder": 48,
    "position": 1,
    "text": "چو تو در زمانه سخن خواره نیست"
  },
  {
    "poem_id": 1917,
    "vorder": 49,
    "position": 0,
    "text": "چو بشنید شیرین پراز درد شد"
  },
  {
    "poem_id": 1917,
    "vorder": 50,
    "position": 1,
    "text": "بپیچید و رنگ رخش زرد شد"
  },
  {
    "poem_id": 1917,
    "vorder": 51,
    "position": 0,
    "text": "چنین داد پاسخ که نزد تو من"
  },
  {
    "poem_id": 1917,
    "vorder": 52,
    "position": 1,
    "text": "نیایم مگر با یکی انجمن"
  },
  {
    "poem_id": 1917,
    "vorder": 53,
    "position": 0,
    "text": "که باشند پیش تو دانندگان"
  },
  {
    "poem_id": 1917,
    "vorder": 54,
    "position": 1,
    "text": "جهاندیده و چیز خوانندگان"
  },
  {
    "poem_id": 1917,
    "vorder": 55,
    "position": 0,
    "text": "فرستاد شیروی پنجاه مرد"
  },
  {
    "poem_id": 1917,
    "vorder": 56,
    "position": 1,
    "text": "بیاورد داننده و سالخورد"
  },
  {
    "poem_id": 1917,
    "vorder": 57,
    "position": 0,
    "text": "وزان پس بشیرین فرستاد کس"
  },
  {
    "poem_id": 1917,
    "vorder": 58,
    "position": 1,
    "text": "که برخیز و پیش آی و گفتار بس"
  },
  {
    "poem_id": 1917,
    "vorder": 59,
    "position": 0,
    "text": "چو شیرین شنید آن کبود و سیاه"
  },
  {
    "poem_id": 1917,
    "vorder": 60,
    "position": 1,
    "text": "بپوشید و آمد به نزدیک شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 61,
    "position": 0,
    "text": "بشد تیز تا گلشن شادگان"
  },
  {
    "poem_id": 1917,
    "vorder": 62,
    "position": 1,
    "text": "که با جای گوینده آزادگان"
  },
  {
    "poem_id": 1917,
    "vorder": 63,
    "position": 0,
    "text": "نشست از پس پرده‌ای پادشا"
  },
  {
    "poem_id": 1917,
    "vorder": 64,
    "position": 1,
    "text": "چناچون بود مردم پارسا"
  },
  {
    "poem_id": 1917,
    "vorder": 65,
    "position": 0,
    "text": "به نزدیک او کس فرستاد شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 66,
    "position": 1,
    "text": "که از سوک خسرو برآمد دو ماه"
  },
  {
    "poem_id": 1917,
    "vorder": 67,
    "position": 0,
    "text": "کنون جفت من باش تا برخوری"
  },
  {
    "poem_id": 1917,
    "vorder": 68,
    "position": 1,
    "text": "بدان تا سوی کهتری ننگری"
  },
  {
    "poem_id": 1917,
    "vorder": 69,
    "position": 0,
    "text": "بدارم تو را هم بسان پدر"
  },
  {
    "poem_id": 1917,
    "vorder": 70,
    "position": 1,
    "text": "وزان نیز نامی‌تر و خوب‌تر"
  },
  {
    "poem_id": 1917,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت شیرین که دادم نخست"
  },
  {
    "poem_id": 1917,
    "vorder": 72,
    "position": 1,
    "text": "بده وانگهی جان من پیش تست"
  },
  {
    "poem_id": 1917,
    "vorder": 73,
    "position": 0,
    "text": "وزان پس نیاسایم از پاسخت"
  },
  {
    "poem_id": 1917,
    "vorder": 74,
    "position": 1,
    "text": "ز فرمان و رای و دل فرخت"
  },
  {
    "poem_id": 1917,
    "vorder": 75,
    "position": 0,
    "text": "بدان گشت شیروی همداستان"
  },
  {
    "poem_id": 1917,
    "vorder": 76,
    "position": 1,
    "text": "که برگوید آن خوب رخ داستان"
  },
  {
    "poem_id": 1917,
    "vorder": 77,
    "position": 0,
    "text": "زن مهتر از پرده آواز داد"
  },
  {
    "poem_id": 1917,
    "vorder": 78,
    "position": 1,
    "text": "که ای شاه پیروز بادی و شاد"
  },
  {
    "poem_id": 1917,
    "vorder": 79,
    "position": 0,
    "text": "تو گفتی که من بد تن و جادوام"
  },
  {
    "poem_id": 1917,
    "vorder": 80,
    "position": 1,
    "text": "ز پاکی و از راستی یک سوام"
  },
  {
    "poem_id": 1917,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت که شیرویه بود این چنین"
  },
  {
    "poem_id": 1917,
    "vorder": 82,
    "position": 1,
    "text": "ز تیزی جوانان نگیرند کین"
  },
  {
    "poem_id": 1917,
    "vorder": 83,
    "position": 0,
    "text": "چنین گفت شیرین به آزادگان"
  },
  {
    "poem_id": 1917,
    "vorder": 84,
    "position": 1,
    "text": "که بودند در گلشن شادگان"
  },
  {
    "poem_id": 1917,
    "vorder": 85,
    "position": 0,
    "text": "چه دیدید ازمن شما از بدی"
  },
  {
    "poem_id": 1917,
    "vorder": 86,
    "position": 1,
    "text": "ز تاری و کژی و نابخردی"
  },
  {
    "poem_id": 1917,
    "vorder": 87,
    "position": 0,
    "text": "بسی سال بانوی ایران بدم"
  },
  {
    "poem_id": 1917,
    "vorder": 88,
    "position": 1,
    "text": "بهر کار پشت دلیران بدم"
  },
  {
    "poem_id": 1917,
    "vorder": 89,
    "position": 0,
    "text": "نجستم همیشه جز از راستی"
  },
  {
    "poem_id": 1917,
    "vorder": 90,
    "position": 1,
    "text": "ز من دور بد کژی وکاستی"
  },
  {
    "poem_id": 1917,
    "vorder": 91,
    "position": 0,
    "text": "بسی کس به گفتار من شهر یافت"
  },
  {
    "poem_id": 1917,
    "vorder": 92,
    "position": 1,
    "text": "ز هر گونه‌ای از جهان بهر یافت"
  },
  {
    "poem_id": 1917,
    "vorder": 93,
    "position": 0,
    "text": "به ایران که دید از بنه سایه‌ام"
  },
  {
    "poem_id": 1917,
    "vorder": 94,
    "position": 1,
    "text": "وگر سایهٔ تاج و پیرایه‌ام"
  },
  {
    "poem_id": 1917,
    "vorder": 95,
    "position": 0,
    "text": "بگوید هر آنکس که دید و شنید"
  },
  {
    "poem_id": 1917,
    "vorder": 96,
    "position": 1,
    "text": "همه کار ازین پاسخ آمد پدید"
  },
  {
    "poem_id": 1917,
    "vorder": 97,
    "position": 0,
    "text": "بزرگان که بودند در پیش شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 98,
    "position": 1,
    "text": "ز شیرین به خوبی نمودند راه"
  },
  {
    "poem_id": 1917,
    "vorder": 99,
    "position": 0,
    "text": "که چون او زنی نیست اندر جهان"
  },
  {
    "poem_id": 1917,
    "vorder": 100,
    "position": 1,
    "text": "چه در آشکار و چه اندر نهان"
  },
  {
    "poem_id": 1917,
    "vorder": 101,
    "position": 0,
    "text": "چنین گفت شیرین که ای مهتران"
  },
  {
    "poem_id": 1917,
    "vorder": 102,
    "position": 1,
    "text": "جهان گشته و کار دیده سران"
  },
  {
    "poem_id": 1917,
    "vorder": 103,
    "position": 0,
    "text": "بسه چیز باشد زنان رابهی"
  },
  {
    "poem_id": 1917,
    "vorder": 104,
    "position": 1,
    "text": "که باشند زیبای گاه مهی"
  },
  {
    "poem_id": 1917,
    "vorder": 105,
    "position": 0,
    "text": "یکی آنک باشرم و باخواستست"
  },
  {
    "poem_id": 1917,
    "vorder": 106,
    "position": 1,
    "text": "که جفتش بدو خانه آراستست"
  },
  {
    "poem_id": 1917,
    "vorder": 107,
    "position": 0,
    "text": "دگرآنک فرخ پسر زاید او"
  },
  {
    "poem_id": 1917,
    "vorder": 108,
    "position": 1,
    "text": "ز شوی خجسته بیفزاید او"
  },
  {
    "poem_id": 1917,
    "vorder": 109,
    "position": 0,
    "text": "سه دیگر که بالا و رویش بود"
  },
  {
    "poem_id": 1917,
    "vorder": 110,
    "position": 1,
    "text": "به پوشیدگی نیز مویش بود"
  },
  {
    "poem_id": 1917,
    "vorder": 111,
    "position": 0,
    "text": "بدان گه که من جفت خسرو بدم"
  },
  {
    "poem_id": 1917,
    "vorder": 112,
    "position": 1,
    "text": "به پیوستگی در جهان نو بدم"
  },
  {
    "poem_id": 1917,
    "vorder": 113,
    "position": 0,
    "text": "چو بی‌کام و بی‌دل بیامد ز روم"
  },
  {
    "poem_id": 1917,
    "vorder": 114,
    "position": 1,
    "text": "نشستن نبود اندرین مرز و بوم"
  },
  {
    "poem_id": 1917,
    "vorder": 115,
    "position": 0,
    "text": "از آن پس بران کامگاری رسید"
  },
  {
    "poem_id": 1917,
    "vorder": 116,
    "position": 1,
    "text": "که کس در جهان آن ندید و شنید"
  },
  {
    "poem_id": 1917,
    "vorder": 117,
    "position": 0,
    "text": "وزو نیز فرزند بودم چهار"
  },
  {
    "poem_id": 1917,
    "vorder": 118,
    "position": 1,
    "text": "بدیشان چنان شاد بد شهریار"
  },
  {
    "poem_id": 1917,
    "vorder": 119,
    "position": 0,
    "text": "چو نستود و چون شهریار و فرود"
  },
  {
    "poem_id": 1917,
    "vorder": 120,
    "position": 1,
    "text": "چو مردان شه آن تاج چرخ کبود"
  },
  {
    "poem_id": 1917,
    "vorder": 121,
    "position": 0,
    "text": "ز جم و فریدون چو ایشان نزاد"
  },
  {
    "poem_id": 1917,
    "vorder": 122,
    "position": 1,
    "text": "زبانم مباد ار بپیچم ز داد"
  },
  {
    "poem_id": 1917,
    "vorder": 123,
    "position": 0,
    "text": "بگفت این و بگشاد چادر ز روی"
  },
  {
    "poem_id": 1917,
    "vorder": 124,
    "position": 1,
    "text": "همه روی ماه و همه پشت موی"
  },
  {
    "poem_id": 1917,
    "vorder": 125,
    "position": 0,
    "text": "سه دیگر چنین است رویم که هست"
  },
  {
    "poem_id": 1917,
    "vorder": 126,
    "position": 1,
    "text": "یکی گر دروغست بنمای دست"
  },
  {
    "poem_id": 1917,
    "vorder": 127,
    "position": 0,
    "text": "مرا از هنر موی بد در نهان"
  },
  {
    "poem_id": 1917,
    "vorder": 128,
    "position": 1,
    "text": "که آن راندیدی کس اندر جهان"
  },
  {
    "poem_id": 1917,
    "vorder": 129,
    "position": 0,
    "text": "نمودم همه پیشت این جادویی"
  },
  {
    "poem_id": 1917,
    "vorder": 130,
    "position": 1,
    "text": "نه از تنبل و مکر وز بدخویی"
  },
  {
    "poem_id": 1917,
    "vorder": 131,
    "position": 0,
    "text": "نه کس موی من پیش ازین دیده بود"
  },
  {
    "poem_id": 1917,
    "vorder": 132,
    "position": 1,
    "text": "نه از مهتران نیز بشنیده بود"
  },
  {
    "poem_id": 1917,
    "vorder": 133,
    "position": 0,
    "text": "ز دیدار پیران فرو ماندند"
  },
  {
    "poem_id": 1917,
    "vorder": 134,
    "position": 1,
    "text": "خیو زیر لبها برافشاندند"
  },
  {
    "poem_id": 1917,
    "vorder": 135,
    "position": 0,
    "text": "چو شیروی رخسار شیرین بدید"
  },
  {
    "poem_id": 1917,
    "vorder": 136,
    "position": 1,
    "text": "روان نهانش ز تن برپرید"
  },
  {
    "poem_id": 1917,
    "vorder": 137,
    "position": 0,
    "text": "ورا گفت جز تو نباید کسم"
  },
  {
    "poem_id": 1917,
    "vorder": 138,
    "position": 1,
    "text": "چو تو جفت یابم به ایران بسم"
  },
  {
    "poem_id": 1917,
    "vorder": 139,
    "position": 0,
    "text": "زن خوب رخ پاسخش داد باز"
  },
  {
    "poem_id": 1917,
    "vorder": 140,
    "position": 1,
    "text": "که از شاه ایران نیم بی‌نیاز"
  },
  {
    "poem_id": 1917,
    "vorder": 141,
    "position": 0,
    "text": "سه حاجت بخواهم چو فرمان دهی"
  },
  {
    "poem_id": 1917,
    "vorder": 142,
    "position": 1,
    "text": "که بر تو بماناد شاهنشهی"
  },
  {
    "poem_id": 1917,
    "vorder": 143,
    "position": 0,
    "text": "بدو گفت شیروی جانم توراست"
  },
  {
    "poem_id": 1917,
    "vorder": 144,
    "position": 1,
    "text": "دگر آرزو هرچ خواهی رواست"
  },
  {
    "poem_id": 1917,
    "vorder": 145,
    "position": 0,
    "text": "بدو گفت شیرین که هر خواسته"
  },
  {
    "poem_id": 1917,
    "vorder": 146,
    "position": 1,
    "text": "که بودم بدین کشور آراسته"
  },
  {
    "poem_id": 1917,
    "vorder": 147,
    "position": 0,
    "text": "ازین پس یکایک سپاری به من"
  },
  {
    "poem_id": 1917,
    "vorder": 148,
    "position": 1,
    "text": "همه پیش این نامور انجمن"
  },
  {
    "poem_id": 1917,
    "vorder": 149,
    "position": 0,
    "text": "بدین نامه اندر نهی خط خویش"
  },
  {
    "poem_id": 1917,
    "vorder": 150,
    "position": 1,
    "text": "که بیزارم از چیز او کم و بیش"
  },
  {
    "poem_id": 1917,
    "vorder": 151,
    "position": 0,
    "text": "بکرد آنچ فرمود شیروی زود"
  },
  {
    "poem_id": 1917,
    "vorder": 152,
    "position": 1,
    "text": "زن از آرزوها چو پاسخ شنود"
  },
  {
    "poem_id": 1917,
    "vorder": 153,
    "position": 0,
    "text": "به راه آمد از گلشن شادگان"
  },
  {
    "poem_id": 1917,
    "vorder": 154,
    "position": 1,
    "text": "ز پیش بزرگان و آزادگان"
  },
  {
    "poem_id": 1917,
    "vorder": 155,
    "position": 0,
    "text": "به خانه شد و بنده آزاد کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 156,
    "position": 1,
    "text": "بدان خواسته بنده را شاد کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 157,
    "position": 0,
    "text": "دگر هرچ بودش به درویش داد"
  },
  {
    "poem_id": 1917,
    "vorder": 158,
    "position": 1,
    "text": "بدان کو ورا خویش بد بیش داد"
  },
  {
    "poem_id": 1917,
    "vorder": 159,
    "position": 0,
    "text": "ببخشید چندی به آتشکده"
  },
  {
    "poem_id": 1917,
    "vorder": 160,
    "position": 1,
    "text": "چه برجای و روز و جشن سده"
  },
  {
    "poem_id": 1917,
    "vorder": 161,
    "position": 0,
    "text": "دگر بر کنامی که ویران شدست"
  },
  {
    "poem_id": 1917,
    "vorder": 162,
    "position": 1,
    "text": "رباطی که آرام شیران بدست"
  },
  {
    "poem_id": 1917,
    "vorder": 163,
    "position": 0,
    "text": "به مزد جهاندار خسرو بداد"
  },
  {
    "poem_id": 1917,
    "vorder": 164,
    "position": 1,
    "text": "به نیکی روان ورا کرد شاد"
  },
  {
    "poem_id": 1917,
    "vorder": 165,
    "position": 0,
    "text": "بیامد بدان باغ و بگشاد روی"
  },
  {
    "poem_id": 1917,
    "vorder": 166,
    "position": 1,
    "text": "نشست از بر خاک بی‌رنگ و بوی"
  },
  {
    "poem_id": 1917,
    "vorder": 167,
    "position": 0,
    "text": "همه بندگان را بر خویش خواند"
  },
  {
    "poem_id": 1917,
    "vorder": 168,
    "position": 1,
    "text": "مران هر یکی رابه خوبی نشاند"
  },
  {
    "poem_id": 1917,
    "vorder": 169,
    "position": 0,
    "text": "چنین گفت زان پس به بانگ بلند"
  },
  {
    "poem_id": 1917,
    "vorder": 170,
    "position": 1,
    "text": "که هرکس که هست از شما ارجمند"
  },
  {
    "poem_id": 1917,
    "vorder": 171,
    "position": 0,
    "text": "همه گوش دارید گفتار من"
  },
  {
    "poem_id": 1917,
    "vorder": 172,
    "position": 1,
    "text": "نبیند کسی نیز دیدار من"
  },
  {
    "poem_id": 1917,
    "vorder": 173,
    "position": 0,
    "text": "مگویید یک سر جز از راستی"
  },
  {
    "poem_id": 1917,
    "vorder": 174,
    "position": 1,
    "text": "نیاید ز دانندگان کاستی"
  },
  {
    "poem_id": 1917,
    "vorder": 175,
    "position": 0,
    "text": "که زان پس که من نزد خسرو شدم"
  },
  {
    "poem_id": 1917,
    "vorder": 176,
    "position": 1,
    "text": "به مشکوی زرین او نوشدم"
  },
  {
    "poem_id": 1917,
    "vorder": 177,
    "position": 0,
    "text": "سر بانوان بودم و فر شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 178,
    "position": 1,
    "text": "از آن پس چو پیدا شد از من گناه"
  },
  {
    "poem_id": 1917,
    "vorder": 179,
    "position": 0,
    "text": "نباید سخن هیچ گفتن بروی"
  },
  {
    "poem_id": 1917,
    "vorder": 180,
    "position": 1,
    "text": "چه روی آید اندر زنی چاره جوی"
  },
  {
    "poem_id": 1917,
    "vorder": 181,
    "position": 0,
    "text": "همه یکسر از جای برخاستند"
  },
  {
    "poem_id": 1917,
    "vorder": 182,
    "position": 1,
    "text": "زبانها به پاسخ بیاراستند"
  },
  {
    "poem_id": 1917,
    "vorder": 183,
    "position": 0,
    "text": "که ای نامور بانوی بانوان"
  },
  {
    "poem_id": 1917,
    "vorder": 184,
    "position": 1,
    "text": "سخن‌گوی و دانا و روشن روان"
  },
  {
    "poem_id": 1917,
    "vorder": 185,
    "position": 0,
    "text": "به یزدان که هرگز تو راکس ندید"
  },
  {
    "poem_id": 1917,
    "vorder": 186,
    "position": 1,
    "text": "نه نیز از پس پرده آوا شنید"
  },
  {
    "poem_id": 1917,
    "vorder": 187,
    "position": 0,
    "text": "همانا ز هنگام هوشنگ باز"
  },
  {
    "poem_id": 1917,
    "vorder": 188,
    "position": 1,
    "text": "چو تو نیز ننشست بر تخت ناز"
  },
  {
    "poem_id": 1917,
    "vorder": 189,
    "position": 0,
    "text": "همه خادمان و پرستندگان"
  },
  {
    "poem_id": 1917,
    "vorder": 190,
    "position": 1,
    "text": "جهانجوی و بیدار دل بندگان"
  },
  {
    "poem_id": 1917,
    "vorder": 191,
    "position": 0,
    "text": "به آواز گفتند کای سرفراز"
  },
  {
    "poem_id": 1917,
    "vorder": 192,
    "position": 1,
    "text": "ستوده به چین و به روم و طراز"
  },
  {
    "poem_id": 1917,
    "vorder": 193,
    "position": 0,
    "text": "که یارد سخن گفتن از تو به بد"
  },
  {
    "poem_id": 1917,
    "vorder": 194,
    "position": 1,
    "text": "بدی کردن از روی تو کی سزد"
  },
  {
    "poem_id": 1917,
    "vorder": 195,
    "position": 0,
    "text": "چنین گفت شیرین که این بدکنش"
  },
  {
    "poem_id": 1917,
    "vorder": 196,
    "position": 1,
    "text": "که چرخ بلندش کند سرزنش"
  },
  {
    "poem_id": 1917,
    "vorder": 197,
    "position": 0,
    "text": "پدر را بکشت از پی تاج و تخت"
  },
  {
    "poem_id": 1917,
    "vorder": 198,
    "position": 1,
    "text": "کزین پس مبیناد شادی و بخت"
  },
  {
    "poem_id": 1917,
    "vorder": 199,
    "position": 0,
    "text": "مگر مرگ را پیش دیوار کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 200,
    "position": 1,
    "text": "که جان پدر را به تن خوار کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 201,
    "position": 0,
    "text": "پیامی فرستاد نزدیک من"
  },
  {
    "poem_id": 1917,
    "vorder": 202,
    "position": 1,
    "text": "که تاریک شد جان باریک من"
  },
  {
    "poem_id": 1917,
    "vorder": 203,
    "position": 0,
    "text": "بدان گفتم این بد که من زنده‌ام"
  },
  {
    "poem_id": 1917,
    "vorder": 204,
    "position": 1,
    "text": "جهان آفرین را پرستنده‌ام"
  },
  {
    "poem_id": 1917,
    "vorder": 205,
    "position": 0,
    "text": "پدیدار کردم همه راه خویش"
  },
  {
    "poem_id": 1917,
    "vorder": 206,
    "position": 1,
    "text": "پراز درد بودم ز بدخواه خویش"
  },
  {
    "poem_id": 1917,
    "vorder": 207,
    "position": 0,
    "text": "پس از مرگ من بر سر انجمن"
  },
  {
    "poem_id": 1917,
    "vorder": 208,
    "position": 1,
    "text": "زبانش مگر بد سراید ز من"
  },
  {
    "poem_id": 1917,
    "vorder": 209,
    "position": 0,
    "text": "ز گفتار او ویژه گریان شدند"
  },
  {
    "poem_id": 1917,
    "vorder": 210,
    "position": 1,
    "text": "هم از درد پرویز بریان شدند"
  },
  {
    "poem_id": 1917,
    "vorder": 211,
    "position": 0,
    "text": "برفتند گویندگان نزد شاه"
  },
  {
    "poem_id": 1917,
    "vorder": 212,
    "position": 1,
    "text": "شنیده به گفتند زان بی‌گناه"
  },
  {
    "poem_id": 1917,
    "vorder": 213,
    "position": 0,
    "text": "بپرسید شیروی کای نیک خوی"
  },
  {
    "poem_id": 1917,
    "vorder": 214,
    "position": 1,
    "text": "سه دیگر چه چیز آمدت آرزوی"
  },
  {
    "poem_id": 1917,
    "vorder": 215,
    "position": 0,
    "text": "فرستاد شیرین به شیروی کس"
  },
  {
    "poem_id": 1917,
    "vorder": 216,
    "position": 1,
    "text": "که اکنون یکی آرزو ماند و بس"
  },
  {
    "poem_id": 1917,
    "vorder": 217,
    "position": 0,
    "text": "گشایم در دخمهٔ شاه باز"
  },
  {
    "poem_id": 1917,
    "vorder": 218,
    "position": 1,
    "text": "به دیدار او آمدستم نیاز"
  },
  {
    "poem_id": 1917,
    "vorder": 219,
    "position": 0,
    "text": "چنین گفت شیروی کاین هم رواست"
  },
  {
    "poem_id": 1917,
    "vorder": 220,
    "position": 1,
    "text": "بدیدار آن مهتر او پادشاست"
  },
  {
    "poem_id": 1917,
    "vorder": 221,
    "position": 0,
    "text": "نگهبان در دخمه را باز کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 222,
    "position": 1,
    "text": "زن پارسا مویه آغاز کرد"
  },
  {
    "poem_id": 1917,
    "vorder": 223,
    "position": 0,
    "text": "بشد چهر بر چهر خسرو نهاد"
  },
  {
    "poem_id": 1917,
    "vorder": 224,
    "position": 1,
    "text": "گذشته سخنها برو کرد یاد"
  },
  {
    "poem_id": 1917,
    "vorder": 225,
    "position": 0,
    "text": "هم آنگه زهر هلاهل بخورد"
  },
  {
    "poem_id": 1917,
    "vorder": 226,
    "position": 1,
    "text": "ز شیرین روانش برآورد گرد"
  },
  {
    "poem_id": 1917,
    "vorder": 227,
    "position": 0,
    "text": "نشسته بر شاه پوشیده روی"
  },
  {
    "poem_id": 1917,
    "vorder": 228,
    "position": 1,
    "text": "به تن بریکی جامه کافور بوی"
  },
  {
    "poem_id": 1917,
    "vorder": 229,
    "position": 0,
    "text": "به دیوار پشتش نهاد و بمرد"
  },
  {
    "poem_id": 1917,
    "vorder": 230,
    "position": 1,
    "text": "بمرد و ز گیتی نشانش ببرد"
  },
  {
    "poem_id": 1917,
    "vorder": 231,
    "position": 0,
    "text": "چو بشنید شیروی بیمار گشت"
  },
  {
    "poem_id": 1917,
    "vorder": 232,
    "position": 1,
    "text": "ز دیدار او پر ز تیمار گشت"
  },
  {
    "poem_id": 1917,
    "vorder": 233,
    "position": 0,
    "text": "بفرمود تا دخمه دیگر کنند"
  },
  {
    "poem_id": 1917,
    "vorder": 234,
    "position": 1,
    "text": "ز مشک وز کافورش افسر کنند"
  },
  {
    "poem_id": 1917,
    "vorder": 235,
    "position": 0,
    "text": "در دخمهٔ شاه کرد استوار"
  },
  {
    "poem_id": 1917,
    "vorder": 236,
    "position": 1,
    "text": "برین بر نیامد بسی روزگار"
  },
  {
    "poem_id": 1917,
    "vorder": 237,
    "position": 0,
    "text": "که شیروی را زهر دادند نیز"
  },
  {
    "poem_id": 1917,
    "vorder": 238,
    "position": 1,
    "text": "جهان را ز شاهان پرآمد قفیز"
  },
  {
    "poem_id": 1917,
    "vorder": 239,
    "position": 0,
    "text": "به شومی بزاد و به شومی بمرد"
  },
  {
    "poem_id": 1917,
    "vorder": 240,
    "position": 1,
    "text": "همان تخت شاهی پسر را سپرد"
  },
  {
    "poem_id": 1917,
    "vorder": 241,
    "position": 0,
    "text": "کسی پادشاهی کند هفت ماه"
  },
  {
    "poem_id": 1917,
    "vorder": 242,
    "position": 1,
    "text": "بهشتم ز کافور یابد کلاه"
  },
  {
    "poem_id": 1917,
    "vorder": 243,
    "position": 0,
    "text": "به گیتی بهی بهتر از گاه نیست"
  },
  {
    "poem_id": 1917,
    "vorder": 244,
    "position": 1,
    "text": "بدی بتر از عمر کوتاه نیست"
  },
  {
    "poem_id": 1917,
    "vorder": 245,
    "position": 0,
    "text": "کنون پادشاهی شاه اردشیر"
  },
  {
    "poem_id": 1917,
    "vorder": 246,
    "position": 1,
    "text": "بگویم که پیش آمدم ناگزیر"
  }
]