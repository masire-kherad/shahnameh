[
  {
    "poem_id": 1599,
    "vorder": 1,
    "position": 0,
    "text": "وزان روی رستم به ایوان رسید"
  },
  {
    "poem_id": 1599,
    "vorder": 2,
    "position": 1,
    "text": "مر او را بران گونه دستان بدید"
  },
  {
    "poem_id": 1599,
    "vorder": 3,
    "position": 0,
    "text": "زواره فرامرز گریان شدند"
  },
  {
    "poem_id": 1599,
    "vorder": 4,
    "position": 1,
    "text": "ازان خستگیهاش بریان شدند"
  },
  {
    "poem_id": 1599,
    "vorder": 5,
    "position": 0,
    "text": "ز سربر همی کند رودابه موی"
  },
  {
    "poem_id": 1599,
    "vorder": 6,
    "position": 1,
    "text": "بر آواز ایشان همی خست روی"
  },
  {
    "poem_id": 1599,
    "vorder": 7,
    "position": 0,
    "text": "زواره به زودی گشادش میان"
  },
  {
    "poem_id": 1599,
    "vorder": 8,
    "position": 1,
    "text": "ازو برکشیدند ببر بیان"
  },
  {
    "poem_id": 1599,
    "vorder": 9,
    "position": 0,
    "text": "هرانکس که دانا بد از کشورش"
  },
  {
    "poem_id": 1599,
    "vorder": 10,
    "position": 1,
    "text": "نشستند یکسر همه بر درش"
  },
  {
    "poem_id": 1599,
    "vorder": 11,
    "position": 0,
    "text": "بفرمود تا رخش را پیش اوی"
  },
  {
    "poem_id": 1599,
    "vorder": 12,
    "position": 1,
    "text": "ببردند و هرکس که بد چاره‌جوی"
  },
  {
    "poem_id": 1599,
    "vorder": 13,
    "position": 0,
    "text": "گرانمایه دستان همی کند موی"
  },
  {
    "poem_id": 1599,
    "vorder": 14,
    "position": 1,
    "text": "بران خستگیها بمالید روی"
  },
  {
    "poem_id": 1599,
    "vorder": 15,
    "position": 0,
    "text": "همی گفت من زنده با پیر سر"
  },
  {
    "poem_id": 1599,
    "vorder": 16,
    "position": 1,
    "text": "بدیدم بدین سان گرامی پسر"
  },
  {
    "poem_id": 1599,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت رستم کزین غم چه سود"
  },
  {
    "poem_id": 1599,
    "vorder": 18,
    "position": 1,
    "text": "که این ز آسمان بودنی کار بود"
  },
  {
    "poem_id": 1599,
    "vorder": 19,
    "position": 0,
    "text": "به پیش است کاری که دشوارتر"
  },
  {
    "poem_id": 1599,
    "vorder": 20,
    "position": 1,
    "text": "وزو جان من پر ز تیمارتر"
  },
  {
    "poem_id": 1599,
    "vorder": 21,
    "position": 0,
    "text": "که هرچند من بیش پوزش کنم"
  },
  {
    "poem_id": 1599,
    "vorder": 22,
    "position": 1,
    "text": "که این شیردل را فروزش کنم"
  },
  {
    "poem_id": 1599,
    "vorder": 23,
    "position": 0,
    "text": "نجوید همی جز همه ناخوشی"
  },
  {
    "poem_id": 1599,
    "vorder": 24,
    "position": 1,
    "text": "به گفتار و کردار و گردنکشی"
  },
  {
    "poem_id": 1599,
    "vorder": 25,
    "position": 0,
    "text": "رسیدم ز هر سو به گرد جهان"
  },
  {
    "poem_id": 1599,
    "vorder": 26,
    "position": 1,
    "text": "خبر یافتم ز آشکار و نهان"
  },
  {
    "poem_id": 1599,
    "vorder": 27,
    "position": 0,
    "text": "گرفتم کمربند دیو سپید"
  },
  {
    "poem_id": 1599,
    "vorder": 28,
    "position": 1,
    "text": "زدم بر زمین همچو یک شاخ بید"
  },
  {
    "poem_id": 1599,
    "vorder": 29,
    "position": 0,
    "text": "نتابم همی سر ز اسفندیار"
  },
  {
    "poem_id": 1599,
    "vorder": 30,
    "position": 1,
    "text": "ازان زور و آن بخشش کارزار"
  },
  {
    "poem_id": 1599,
    "vorder": 31,
    "position": 0,
    "text": "خدنگم ز سندان گذر یافتی"
  },
  {
    "poem_id": 1599,
    "vorder": 32,
    "position": 1,
    "text": "زبون داشتی گر سپر یافتی"
  },
  {
    "poem_id": 1599,
    "vorder": 33,
    "position": 0,
    "text": "زدم چند بر گبر اسفندیار"
  },
  {
    "poem_id": 1599,
    "vorder": 34,
    "position": 1,
    "text": "گراینده دست مرا داشت خوار"
  },
  {
    "poem_id": 1599,
    "vorder": 35,
    "position": 0,
    "text": "همان تیغ من گر بدیدی پلنگ"
  },
  {
    "poem_id": 1599,
    "vorder": 36,
    "position": 1,
    "text": "نهان داشتی خویشتن زیر سنگ"
  },
  {
    "poem_id": 1599,
    "vorder": 37,
    "position": 0,
    "text": "نبرد همی جوشن اندر برش"
  },
  {
    "poem_id": 1599,
    "vorder": 38,
    "position": 1,
    "text": "نه آن پارهٔ پرنیان بر سرش"
  },
  {
    "poem_id": 1599,
    "vorder": 39,
    "position": 0,
    "text": "سپاسم ز یزدان که شب تیره شد"
  },
  {
    "poem_id": 1599,
    "vorder": 40,
    "position": 1,
    "text": "دران تیرگی چشم او خیره شد"
  },
  {
    "poem_id": 1599,
    "vorder": 41,
    "position": 0,
    "text": "برستم من از چنگ آن اژدها"
  },
  {
    "poem_id": 1599,
    "vorder": 42,
    "position": 1,
    "text": "ندانم کزین خسته آیم رها"
  },
  {
    "poem_id": 1599,
    "vorder": 43,
    "position": 0,
    "text": "چه اندیشم اکنون جزین نیست رای"
  },
  {
    "poem_id": 1599,
    "vorder": 44,
    "position": 1,
    "text": "که فردا بگردانم از رخش پای"
  },
  {
    "poem_id": 1599,
    "vorder": 45,
    "position": 0,
    "text": "به جایی شوم کو نیاید نشان"
  },
  {
    "poem_id": 1599,
    "vorder": 46,
    "position": 1,
    "text": "به زابلستان گر کند سرفشان"
  },
  {
    "poem_id": 1599,
    "vorder": 47,
    "position": 0,
    "text": "سرانجام ازان کار سیر آید او"
  },
  {
    "poem_id": 1599,
    "vorder": 48,
    "position": 1,
    "text": "اگرچه ز بد سیر دیر آید او"
  },
  {
    "poem_id": 1599,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت زال ای پسر گوش دار"
  },
  {
    "poem_id": 1599,
    "vorder": 50,
    "position": 1,
    "text": "سخن چون به یاد آوری هوش دار"
  },
  {
    "poem_id": 1599,
    "vorder": 51,
    "position": 0,
    "text": "همه کارهای جهان را در است"
  },
  {
    "poem_id": 1599,
    "vorder": 52,
    "position": 1,
    "text": "مگر مرگ کانرا دری دیگر است"
  },
  {
    "poem_id": 1599,
    "vorder": 53,
    "position": 0,
    "text": "یکی چاره دانم من این را گزین"
  },
  {
    "poem_id": 1599,
    "vorder": 54,
    "position": 1,
    "text": "که سیمرغ را یار خوانم برین"
  },
  {
    "poem_id": 1599,
    "vorder": 55,
    "position": 0,
    "text": "گر او باشدم زین سخن رهنمای"
  },
  {
    "poem_id": 1599,
    "vorder": 56,
    "position": 1,
    "text": "بماند به ما کشور و بوم و جای"
  }
]