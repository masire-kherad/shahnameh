[
  {
    "poem_id": 1412,
    "vorder": 1,
    "position": 0,
    "text": "چو بشنید نوذر که قارن برفت"
  },
  {
    "poem_id": 1412,
    "vorder": 2,
    "position": 1,
    "text": "دمان از پسش روی بنهاد و تفت"
  },
  {
    "poem_id": 1412,
    "vorder": 3,
    "position": 0,
    "text": "همی تاخت کز روز بد بگذرد"
  },
  {
    "poem_id": 1412,
    "vorder": 4,
    "position": 1,
    "text": "سپهرش مگر زیر پی نسپرد"
  },
  {
    "poem_id": 1412,
    "vorder": 5,
    "position": 0,
    "text": "چو افراسیاب آگهی یافت زوی"
  },
  {
    "poem_id": 1412,
    "vorder": 6,
    "position": 1,
    "text": "که سوی بیابان نهادست روی"
  },
  {
    "poem_id": 1412,
    "vorder": 7,
    "position": 0,
    "text": "سپاه انجمن کرد و پویان برفت"
  },
  {
    "poem_id": 1412,
    "vorder": 8,
    "position": 1,
    "text": "چو شیر از پسش روی بنهاد و تفت"
  },
  {
    "poem_id": 1412,
    "vorder": 9,
    "position": 0,
    "text": "چو تنگ اندر آمد بر شهریار"
  },
  {
    "poem_id": 1412,
    "vorder": 10,
    "position": 1,
    "text": "همش تاختن دید و هم کارزار"
  },
  {
    "poem_id": 1412,
    "vorder": 11,
    "position": 0,
    "text": "بدان سان که آمد همی جست راه"
  },
  {
    "poem_id": 1412,
    "vorder": 12,
    "position": 1,
    "text": "که تا بر سر آرد سری بی‌کلاه"
  },
  {
    "poem_id": 1412,
    "vorder": 13,
    "position": 0,
    "text": "شب تیره تا شد بلند آفتاب"
  },
  {
    "poem_id": 1412,
    "vorder": 14,
    "position": 1,
    "text": "همی گشت با نوذر افراسیاب"
  },
  {
    "poem_id": 1412,
    "vorder": 15,
    "position": 0,
    "text": "ز گرد سواران جهان تار شد"
  },
  {
    "poem_id": 1412,
    "vorder": 16,
    "position": 1,
    "text": "سرانجام نوذر گرفتار شد"
  },
  {
    "poem_id": 1412,
    "vorder": 17,
    "position": 0,
    "text": "خود و نامداران هزار و دویست"
  },
  {
    "poem_id": 1412,
    "vorder": 18,
    "position": 1,
    "text": "تو گفتی کشان بر زمین جای نیست"
  },
  {
    "poem_id": 1412,
    "vorder": 19,
    "position": 0,
    "text": "بسی راه جستند و بگریختند"
  },
  {
    "poem_id": 1412,
    "vorder": 20,
    "position": 1,
    "text": "به دام بلا هم برآویختند"
  },
  {
    "poem_id": 1412,
    "vorder": 21,
    "position": 0,
    "text": "چنان لشکری را گرفته به بند"
  },
  {
    "poem_id": 1412,
    "vorder": 22,
    "position": 1,
    "text": "بیاورد با شهریار بلند"
  },
  {
    "poem_id": 1412,
    "vorder": 23,
    "position": 0,
    "text": "اگر با تو گردون نشیند به راز"
  },
  {
    "poem_id": 1412,
    "vorder": 24,
    "position": 1,
    "text": "هم از گردش او نیابی جواز"
  },
  {
    "poem_id": 1412,
    "vorder": 25,
    "position": 0,
    "text": "همو تاج و تخت بلندی دهد"
  },
  {
    "poem_id": 1412,
    "vorder": 26,
    "position": 1,
    "text": "همو تیرگی و نژندی دهد"
  },
  {
    "poem_id": 1412,
    "vorder": 27,
    "position": 0,
    "text": "به دشمن همی ماند و هم به دوست"
  },
  {
    "poem_id": 1412,
    "vorder": 28,
    "position": 1,
    "text": "گهی مغز یابی ازو گاه پوست"
  },
  {
    "poem_id": 1412,
    "vorder": 29,
    "position": 0,
    "text": "سرت گر بساید به ابر سیاه"
  },
  {
    "poem_id": 1412,
    "vorder": 30,
    "position": 1,
    "text": "سرانجام خاک است ازو جایگاه"
  },
  {
    "poem_id": 1412,
    "vorder": 31,
    "position": 0,
    "text": "وزان پس بفرمود افراسیاب"
  },
  {
    "poem_id": 1412,
    "vorder": 32,
    "position": 1,
    "text": "که از غار و کوه و بیابان و آب"
  },
  {
    "poem_id": 1412,
    "vorder": 33,
    "position": 0,
    "text": "بجویید تا قارن رزم زن"
  },
  {
    "poem_id": 1412,
    "vorder": 34,
    "position": 1,
    "text": "رهایی نیابد ازین انجمن"
  },
  {
    "poem_id": 1412,
    "vorder": 35,
    "position": 0,
    "text": "چو بشنید کاو پیش ازان رفته بود"
  },
  {
    "poem_id": 1412,
    "vorder": 36,
    "position": 1,
    "text": "ز کار شبستان برآشفته بود"
  },
  {
    "poem_id": 1412,
    "vorder": 37,
    "position": 0,
    "text": "غمی گشت ازان کار افراسیاب"
  },
  {
    "poem_id": 1412,
    "vorder": 38,
    "position": 1,
    "text": "ازو دور شد خورد و آرام و خواب"
  },
  {
    "poem_id": 1412,
    "vorder": 39,
    "position": 0,
    "text": "که قارن رها یافت از وی به جان"
  },
  {
    "poem_id": 1412,
    "vorder": 40,
    "position": 1,
    "text": "بران درد پیچید و شد بدگمان"
  },
  {
    "poem_id": 1412,
    "vorder": 41,
    "position": 0,
    "text": "چنین گفت با ویسهٔ نامور"
  },
  {
    "poem_id": 1412,
    "vorder": 42,
    "position": 1,
    "text": "که دل سخت گردان به مرگ پسر"
  },
  {
    "poem_id": 1412,
    "vorder": 43,
    "position": 0,
    "text": "که چون قارن کاوه جنگ آورد"
  },
  {
    "poem_id": 1412,
    "vorder": 44,
    "position": 1,
    "text": "پلنگ از شتابش درنگ آورد"
  },
  {
    "poem_id": 1412,
    "vorder": 45,
    "position": 0,
    "text": "ترا رفت باید ببسته کمر"
  },
  {
    "poem_id": 1412,
    "vorder": 46,
    "position": 1,
    "text": "یکی لشکری ساخته پرهنر"
  }
]