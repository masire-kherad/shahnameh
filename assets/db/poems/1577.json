[
  {
    "poem_id": 1577,
    "vorder": 1,
    "position": 0,
    "text": "چو بگذشت شب گرد کرده عنان"
  },
  {
    "poem_id": 1577,
    "vorder": 2,
    "position": 1,
    "text": "برآورد خورشید رخشان سنان"
  },
  {
    "poem_id": 1577,
    "vorder": 3,
    "position": 0,
    "text": "نشست از بر تخت زر شهریار"
  },
  {
    "poem_id": 1577,
    "vorder": 4,
    "position": 1,
    "text": "بشد پیش او فرخ اسفندیار"
  },
  {
    "poem_id": 1577,
    "vorder": 5,
    "position": 0,
    "text": "همی بود پیشش پرستارفش"
  },
  {
    "poem_id": 1577,
    "vorder": 6,
    "position": 1,
    "text": "پراندیشه و دست کرده به کش"
  },
  {
    "poem_id": 1577,
    "vorder": 7,
    "position": 0,
    "text": "چو در پیش او انجمن شد سپاه"
  },
  {
    "poem_id": 1577,
    "vorder": 8,
    "position": 1,
    "text": "ز نام‌آوران و ز گردان شاه"
  },
  {
    "poem_id": 1577,
    "vorder": 9,
    "position": 0,
    "text": "همه موبدان پیش او بر رده"
  },
  {
    "poem_id": 1577,
    "vorder": 10,
    "position": 1,
    "text": "ز اسپهبدان پیش او صف زده"
  },
  {
    "poem_id": 1577,
    "vorder": 11,
    "position": 0,
    "text": "پس اسفندیار آن یل پیلتن"
  },
  {
    "poem_id": 1577,
    "vorder": 12,
    "position": 1,
    "text": "برآورد از درد آنگه سخن"
  },
  {
    "poem_id": 1577,
    "vorder": 13,
    "position": 0,
    "text": "بدو گفت شاها انوشه بدی"
  },
  {
    "poem_id": 1577,
    "vorder": 14,
    "position": 1,
    "text": "توی بر زمین فره ایزدی"
  },
  {
    "poem_id": 1577,
    "vorder": 15,
    "position": 0,
    "text": "سر داد و مهر از تو پیدا شدست"
  },
  {
    "poem_id": 1577,
    "vorder": 16,
    "position": 1,
    "text": "همان تاج و تخت از تو زیبا شدست"
  },
  {
    "poem_id": 1577,
    "vorder": 17,
    "position": 0,
    "text": "تو شاهی پدر من ترا بنده‌ام"
  },
  {
    "poem_id": 1577,
    "vorder": 18,
    "position": 1,
    "text": "همیشه به رای تو پوینده‌ام"
  },
  {
    "poem_id": 1577,
    "vorder": 19,
    "position": 0,
    "text": "تو دانی که ارجاسپ از بهر دین"
  },
  {
    "poem_id": 1577,
    "vorder": 20,
    "position": 1,
    "text": "بیامد چنان با سواران چین"
  },
  {
    "poem_id": 1577,
    "vorder": 21,
    "position": 0,
    "text": "بخوردم من آن سخت سوگندها"
  },
  {
    "poem_id": 1577,
    "vorder": 22,
    "position": 1,
    "text": "بپذرفتم آن ایزدی پندها"
  },
  {
    "poem_id": 1577,
    "vorder": 23,
    "position": 0,
    "text": "که هرکس که آرد به دین در شکست"
  },
  {
    "poem_id": 1577,
    "vorder": 24,
    "position": 1,
    "text": "دلش تاب گیرد شود بت‌پرست"
  },
  {
    "poem_id": 1577,
    "vorder": 25,
    "position": 0,
    "text": "میانش به خنجر کنم به دو نیم"
  },
  {
    "poem_id": 1577,
    "vorder": 26,
    "position": 1,
    "text": "نباشد مرا از کسی ترس و بیم"
  },
  {
    "poem_id": 1577,
    "vorder": 27,
    "position": 0,
    "text": "وزان پس که ارجاسپ آمد به جنگ"
  },
  {
    "poem_id": 1577,
    "vorder": 28,
    "position": 1,
    "text": "نبرگشتم از جنگ دشتی پلنگ"
  },
  {
    "poem_id": 1577,
    "vorder": 29,
    "position": 0,
    "text": "مرا خوار کردی به گفت گُرَزم"
  },
  {
    "poem_id": 1577,
    "vorder": 30,
    "position": 1,
    "text": "که جام خورش خواستی روز بزم"
  },
  {
    "poem_id": 1577,
    "vorder": 31,
    "position": 0,
    "text": "ببستی تن من به بند گران"
  },
  {
    "poem_id": 1577,
    "vorder": 32,
    "position": 1,
    "text": "ستونها و مسمار آهنگران"
  },
  {
    "poem_id": 1577,
    "vorder": 33,
    "position": 0,
    "text": "سوی گنبدان دژ فرستادیم"
  },
  {
    "poem_id": 1577,
    "vorder": 34,
    "position": 1,
    "text": "ز خواری به بدکارگان دادیم"
  },
  {
    "poem_id": 1577,
    "vorder": 35,
    "position": 0,
    "text": "به زاول شدی بلخ بگذاشتی"
  },
  {
    "poem_id": 1577,
    "vorder": 36,
    "position": 1,
    "text": "همه رزم را بزم پنداشتی"
  },
  {
    "poem_id": 1577,
    "vorder": 37,
    "position": 0,
    "text": "بدیدی همی تیغ ارجاسپ را"
  },
  {
    "poem_id": 1577,
    "vorder": 38,
    "position": 1,
    "text": "فگندی به خون پیر لهراسپ را"
  },
  {
    "poem_id": 1577,
    "vorder": 39,
    "position": 0,
    "text": "چو جاماسپ آمد مرا بسته دید"
  },
  {
    "poem_id": 1577,
    "vorder": 40,
    "position": 1,
    "text": "وزان بستگیها تنم خسته دید"
  },
  {
    "poem_id": 1577,
    "vorder": 41,
    "position": 0,
    "text": "مرا پادشاهی پذیرفت و تخت"
  },
  {
    "poem_id": 1577,
    "vorder": 42,
    "position": 1,
    "text": "بران نیز چندی بکوشید سخت"
  },
  {
    "poem_id": 1577,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفتم این بندهای گران"
  },
  {
    "poem_id": 1577,
    "vorder": 44,
    "position": 1,
    "text": "به زنجیر و مسمار آهنگران"
  },
  {
    "poem_id": 1577,
    "vorder": 45,
    "position": 0,
    "text": "بمانم چنین هم به فرمان شاه"
  },
  {
    "poem_id": 1577,
    "vorder": 46,
    "position": 1,
    "text": "نخواهم سپاه و نخواهم کلاه"
  },
  {
    "poem_id": 1577,
    "vorder": 47,
    "position": 0,
    "text": "به یزدان نمایم به روز شمار"
  },
  {
    "poem_id": 1577,
    "vorder": 48,
    "position": 1,
    "text": "بنالم ز بدگوی با کردگار"
  },
  {
    "poem_id": 1577,
    "vorder": 49,
    "position": 0,
    "text": "مرا گفت گر پند من نشنوی"
  },
  {
    "poem_id": 1577,
    "vorder": 50,
    "position": 1,
    "text": "بسازی ابر تخت بر بدخوی"
  },
  {
    "poem_id": 1577,
    "vorder": 51,
    "position": 0,
    "text": "دگر گفت کز خون چندان سران"
  },
  {
    "poem_id": 1577,
    "vorder": 52,
    "position": 1,
    "text": "سرافراز با گُرزهای گران"
  },
  {
    "poem_id": 1577,
    "vorder": 53,
    "position": 0,
    "text": "بران رزمگه خسته تنها به تیر"
  },
  {
    "poem_id": 1577,
    "vorder": 54,
    "position": 1,
    "text": "همان خواهرانت ببرده اسیر"
  },
  {
    "poem_id": 1577,
    "vorder": 55,
    "position": 0,
    "text": "دگر گرد آزاده فرشیدورد"
  },
  {
    "poem_id": 1577,
    "vorder": 56,
    "position": 1,
    "text": "فگندست خسته به دشت نبرد"
  },
  {
    "poem_id": 1577,
    "vorder": 57,
    "position": 0,
    "text": "ز ترکان گریزان شده شهریار"
  },
  {
    "poem_id": 1577,
    "vorder": 58,
    "position": 1,
    "text": "همی پیچد از بند اسفندیار"
  },
  {
    "poem_id": 1577,
    "vorder": 59,
    "position": 0,
    "text": "نسوزد دلت بر چنین کارها"
  },
  {
    "poem_id": 1577,
    "vorder": 60,
    "position": 1,
    "text": "بدین درد و تیمار و آزارها"
  },
  {
    "poem_id": 1577,
    "vorder": 61,
    "position": 0,
    "text": "سخنها جز این نیز بسیار گفت"
  },
  {
    "poem_id": 1577,
    "vorder": 62,
    "position": 1,
    "text": "که گفتار با درد و غم بود جفت"
  },
  {
    "poem_id": 1577,
    "vorder": 63,
    "position": 0,
    "text": "غل و بند بر هم شکستم همه"
  },
  {
    "poem_id": 1577,
    "vorder": 64,
    "position": 1,
    "text": "دوان آمدم نزد شاه رمه"
  },
  {
    "poem_id": 1577,
    "vorder": 65,
    "position": 0,
    "text": "از ایشان بکشتم فزون از شمار"
  },
  {
    "poem_id": 1577,
    "vorder": 66,
    "position": 1,
    "text": "ز کردار من شاد شد شهریار"
  },
  {
    "poem_id": 1577,
    "vorder": 67,
    "position": 0,
    "text": "گر از هفتخوان برشمارم سخن"
  },
  {
    "poem_id": 1577,
    "vorder": 68,
    "position": 1,
    "text": "همانا که هرگز نیاید به بن"
  },
  {
    "poem_id": 1577,
    "vorder": 69,
    "position": 0,
    "text": "ز تن باز کردم سر ارجاسپ را"
  },
  {
    "poem_id": 1577,
    "vorder": 70,
    "position": 1,
    "text": "برافراختم نام گشتاسپ را"
  },
  {
    "poem_id": 1577,
    "vorder": 71,
    "position": 0,
    "text": "زن و کودکانش بدین بارگاه"
  },
  {
    "poem_id": 1577,
    "vorder": 72,
    "position": 1,
    "text": "بیاوردم آن گنج و تخت و کلاه"
  },
  {
    "poem_id": 1577,
    "vorder": 73,
    "position": 0,
    "text": "همه نیکویها بکردی به گنج"
  },
  {
    "poem_id": 1577,
    "vorder": 74,
    "position": 1,
    "text": "مرا مایه خون آمد و درد و رنج"
  },
  {
    "poem_id": 1577,
    "vorder": 75,
    "position": 0,
    "text": "ز بس بند و سوگند و پیمان تو"
  },
  {
    "poem_id": 1577,
    "vorder": 76,
    "position": 1,
    "text": "همی نگذرم من ز فرمان تو"
  },
  {
    "poem_id": 1577,
    "vorder": 77,
    "position": 0,
    "text": "همی گفتی ار باز بینم ترا"
  },
  {
    "poem_id": 1577,
    "vorder": 78,
    "position": 1,
    "text": "ز روشن روان برگزینم ترا"
  },
  {
    "poem_id": 1577,
    "vorder": 79,
    "position": 0,
    "text": "سپارم ترا افسر و تخت عاج"
  },
  {
    "poem_id": 1577,
    "vorder": 80,
    "position": 1,
    "text": "که هستی به مردی سزاوار تاج"
  },
  {
    "poem_id": 1577,
    "vorder": 81,
    "position": 0,
    "text": "مرا از بزرگان بر این شرم خاست"
  },
  {
    "poem_id": 1577,
    "vorder": 82,
    "position": 1,
    "text": "که گویند گنج و سپاهت کجاست"
  },
  {
    "poem_id": 1577,
    "vorder": 83,
    "position": 0,
    "text": "بهانه کنون چیست من بر چیم"
  },
  {
    "poem_id": 1577,
    "vorder": 84,
    "position": 1,
    "text": "پس از رنج پویان ز بهر کیم"
  }
]