[
  {
    "poem_id": 1800,
    "vorder": 1,
    "position": 0,
    "text": "چو بنهاد بر نامه‌بر مهر شاه"
  },
  {
    "poem_id": 1800,
    "vorder": 2,
    "position": 1,
    "text": "برآراست بر ساز نخچیرگاه"
  },
  {
    "poem_id": 1800,
    "vorder": 3,
    "position": 0,
    "text": "به لشکر ز کارش کس آگه نبود"
  },
  {
    "poem_id": 1800,
    "vorder": 4,
    "position": 1,
    "text": "جز از نامدارانش همره نبود"
  },
  {
    "poem_id": 1800,
    "vorder": 5,
    "position": 0,
    "text": "بیامد بدین‌سان به هندوستان"
  },
  {
    "poem_id": 1800,
    "vorder": 6,
    "position": 1,
    "text": "گذشت از بر آب جادوستان"
  },
  {
    "poem_id": 1800,
    "vorder": 7,
    "position": 0,
    "text": "چو نزدیک ایوان شنگل رسید"
  },
  {
    "poem_id": 1800,
    "vorder": 8,
    "position": 1,
    "text": "در پرده و بارگاهش بدید"
  },
  {
    "poem_id": 1800,
    "vorder": 9,
    "position": 0,
    "text": "برآورده‌ای بود سر در هوا"
  },
  {
    "poem_id": 1800,
    "vorder": 10,
    "position": 1,
    "text": "بدربر فراوان سلیح و نوا"
  },
  {
    "poem_id": 1800,
    "vorder": 11,
    "position": 0,
    "text": "سواران و پیلان بدربر به پای"
  },
  {
    "poem_id": 1800,
    "vorder": 12,
    "position": 1,
    "text": "خروشیدن زنگ با کرنای"
  },
  {
    "poem_id": 1800,
    "vorder": 13,
    "position": 0,
    "text": "شگفتی بان بارگه بر بماند"
  },
  {
    "poem_id": 1800,
    "vorder": 14,
    "position": 1,
    "text": "دلش را به اندیشه اندر نشاند"
  },
  {
    "poem_id": 1800,
    "vorder": 15,
    "position": 0,
    "text": "چنین گفت با پرده‌داران اوی"
  },
  {
    "poem_id": 1800,
    "vorder": 16,
    "position": 1,
    "text": "پرستنده و پای‌کاران اوی"
  },
  {
    "poem_id": 1800,
    "vorder": 17,
    "position": 0,
    "text": "که از نزد پیروز بهرامشاه"
  },
  {
    "poem_id": 1800,
    "vorder": 18,
    "position": 1,
    "text": "فرستاده آمد بدین بارگاه"
  },
  {
    "poem_id": 1800,
    "vorder": 19,
    "position": 0,
    "text": "هم اندر زمان رفت سالار بار"
  },
  {
    "poem_id": 1800,
    "vorder": 20,
    "position": 1,
    "text": "ز پرده درون تا بر شهریار"
  },
  {
    "poem_id": 1800,
    "vorder": 21,
    "position": 0,
    "text": "بفرمود تا پرده برداشتند"
  },
  {
    "poem_id": 1800,
    "vorder": 22,
    "position": 1,
    "text": "به ارجش ز درگاه بگذاشتند"
  },
  {
    "poem_id": 1800,
    "vorder": 23,
    "position": 0,
    "text": "خرامان همی رفت بهرام گور"
  },
  {
    "poem_id": 1800,
    "vorder": 24,
    "position": 1,
    "text": "یکی خانه دید آسمانش بلور"
  },
  {
    "poem_id": 1800,
    "vorder": 25,
    "position": 0,
    "text": "ازارش همه سیم و پیکرش زر"
  },
  {
    "poem_id": 1800,
    "vorder": 26,
    "position": 1,
    "text": "نشانده به هر جای چندی گهر"
  },
  {
    "poem_id": 1800,
    "vorder": 27,
    "position": 0,
    "text": "نشسته به نزدیک او رهنمای"
  },
  {
    "poem_id": 1800,
    "vorder": 28,
    "position": 1,
    "text": "پس پشت او ایستاده به پای"
  },
  {
    "poem_id": 1800,
    "vorder": 29,
    "position": 0,
    "text": "برادرش را دید بر زیرگاه"
  },
  {
    "poem_id": 1800,
    "vorder": 30,
    "position": 1,
    "text": "نهاده به سر بر ز گوهر کلاه"
  },
  {
    "poem_id": 1800,
    "vorder": 31,
    "position": 0,
    "text": "چو آمد به نزدیک شنگل فراز"
  },
  {
    "poem_id": 1800,
    "vorder": 32,
    "position": 1,
    "text": "ورا دید با تاج بر تخت ناز"
  },
  {
    "poem_id": 1800,
    "vorder": 33,
    "position": 0,
    "text": "همه پایهٔ تخت زر و بلور"
  },
  {
    "poem_id": 1800,
    "vorder": 34,
    "position": 1,
    "text": "نشسته برو شاه با فر و زور"
  },
  {
    "poem_id": 1800,
    "vorder": 35,
    "position": 0,
    "text": "بر تخت شد شاه و بردش نماز"
  },
  {
    "poem_id": 1800,
    "vorder": 36,
    "position": 1,
    "text": "همی بود پیشش زمانی دراز"
  },
  {
    "poem_id": 1800,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت زان کو ز شاهان مهست"
  },
  {
    "poem_id": 1800,
    "vorder": 38,
    "position": 1,
    "text": "جهاندار بهرام یزدان‌پرست"
  },
  {
    "poem_id": 1800,
    "vorder": 39,
    "position": 0,
    "text": "یکی نامه دارم بر شاه هند"
  },
  {
    "poem_id": 1800,
    "vorder": 40,
    "position": 1,
    "text": "نوشته خطی پهلوی بر پرند"
  },
  {
    "poem_id": 1800,
    "vorder": 41,
    "position": 0,
    "text": "چو آواز بهرام بشنید شاه"
  },
  {
    "poem_id": 1800,
    "vorder": 42,
    "position": 1,
    "text": "بفرمود زرین یکی زیرگاه"
  },
  {
    "poem_id": 1800,
    "vorder": 43,
    "position": 0,
    "text": "بران کرسی زرش بنشاندند"
  },
  {
    "poem_id": 1800,
    "vorder": 44,
    "position": 1,
    "text": "ز درگاه یارانش را خواندند"
  },
  {
    "poem_id": 1800,
    "vorder": 45,
    "position": 0,
    "text": "چو بنشست بگشاد لب را ز بند"
  },
  {
    "poem_id": 1800,
    "vorder": 46,
    "position": 1,
    "text": "چنین گفت کای شهریار بلند"
  },
  {
    "poem_id": 1800,
    "vorder": 47,
    "position": 0,
    "text": "زبان برگشایم چو فرمان دهی"
  },
  {
    "poem_id": 1800,
    "vorder": 48,
    "position": 1,
    "text": "که بی‌تو مبادا بهی و مهی"
  },
  {
    "poem_id": 1800,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت شنگل که بر گوی هین"
  },
  {
    "poem_id": 1800,
    "vorder": 50,
    "position": 1,
    "text": "که گوینده یابد ز چرخ آفرین"
  },
  {
    "poem_id": 1800,
    "vorder": 51,
    "position": 0,
    "text": "چنین گفت کز شاه خسرونژاد"
  },
  {
    "poem_id": 1800,
    "vorder": 52,
    "position": 1,
    "text": "که چون او به گیتی ز مادر نزاد"
  },
  {
    "poem_id": 1800,
    "vorder": 53,
    "position": 0,
    "text": "مهست آن سرافراز بر روی دهر"
  },
  {
    "poem_id": 1800,
    "vorder": 54,
    "position": 1,
    "text": "که با داد او زهر شد پای زهر"
  },
  {
    "poem_id": 1800,
    "vorder": 55,
    "position": 0,
    "text": "بزرگان همه باژ دار وی‌اند"
  },
  {
    "poem_id": 1800,
    "vorder": 56,
    "position": 1,
    "text": "به نخچیر شیران شکار وی‌اند"
  },
  {
    "poem_id": 1800,
    "vorder": 57,
    "position": 0,
    "text": "چو شمشیر خواهد به رزم اندرون"
  },
  {
    "poem_id": 1800,
    "vorder": 58,
    "position": 1,
    "text": "بیابان شود همچو دریای خون"
  },
  {
    "poem_id": 1800,
    "vorder": 59,
    "position": 0,
    "text": "به بخشش چو ابری بود دربار"
  },
  {
    "poem_id": 1800,
    "vorder": 60,
    "position": 1,
    "text": "بود پیش او گنج دینار خوار"
  },
  {
    "poem_id": 1800,
    "vorder": 61,
    "position": 0,
    "text": "پیامی رسانم سوی شاه هند"
  },
  {
    "poem_id": 1800,
    "vorder": 62,
    "position": 1,
    "text": "همان پهلوی نامه‌ای برپرند"
  }
]