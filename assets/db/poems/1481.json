[
  {
    "poem_id": 1481,
    "vorder": 1,
    "position": 0,
    "text": "چنین گفت موبد که یک‌روز طوس"
  },
  {
    "poem_id": 1481,
    "vorder": 2,
    "position": 1,
    "text": "بدانگه که برخاست بانگ خروس"
  },
  {
    "poem_id": 1481,
    "vorder": 3,
    "position": 0,
    "text": "خود و گیو گودرز و چندی سوار"
  },
  {
    "poem_id": 1481,
    "vorder": 4,
    "position": 1,
    "text": "برفتند شاد از در شهریار"
  },
  {
    "poem_id": 1481,
    "vorder": 5,
    "position": 0,
    "text": "به نخچیر گوران به دشت دغوی"
  },
  {
    "poem_id": 1481,
    "vorder": 6,
    "position": 1,
    "text": "ابا باز و یوزانِ نخچیرجوی"
  },
  {
    "poem_id": 1481,
    "vorder": 7,
    "position": 0,
    "text": "فراوان گرفتند و انداختند"
  },
  {
    "poem_id": 1481,
    "vorder": 8,
    "position": 1,
    "text": "علوفه چهل روزه را ساختند"
  },
  {
    "poem_id": 1481,
    "vorder": 9,
    "position": 0,
    "text": "بدان جایگه ترک نزدیک بود"
  },
  {
    "poem_id": 1481,
    "vorder": 10,
    "position": 1,
    "text": "زمینش ز خرگاه تاریک بود"
  },
  {
    "poem_id": 1481,
    "vorder": 11,
    "position": 0,
    "text": "یکی بیشه پیش اندر آمد ز دور"
  },
  {
    "poem_id": 1481,
    "vorder": 12,
    "position": 1,
    "text": "به نزدیک مرز سواران تور"
  },
  {
    "poem_id": 1481,
    "vorder": 13,
    "position": 0,
    "text": "همی‌راند در پیش با طوس، گیو"
  },
  {
    "poem_id": 1481,
    "vorder": 14,
    "position": 1,
    "text": "پس اندر پرستنده‌ای چند نیو"
  },
  {
    "poem_id": 1481,
    "vorder": 15,
    "position": 0,
    "text": "بران بیشه رفتند هر دو سوار"
  },
  {
    "poem_id": 1481,
    "vorder": 16,
    "position": 1,
    "text": "بگشتند بر گِرد آن مرغزار"
  },
  {
    "poem_id": 1481,
    "vorder": 17,
    "position": 0,
    "text": "به بیشه یکی خوب رخ یافتند"
  },
  {
    "poem_id": 1481,
    "vorder": 18,
    "position": 1,
    "text": "پر از خنده لب، هردو بشتافتند"
  },
  {
    "poem_id": 1481,
    "vorder": 19,
    "position": 0,
    "text": "به دیدار او در زمانه نبود"
  },
  {
    "poem_id": 1481,
    "vorder": 20,
    "position": 1,
    "text": "برو بر ز خوبی بهانه نبود"
  },
  {
    "poem_id": 1481,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت گیو: ای فریبنده ماه"
  },
  {
    "poem_id": 1481,
    "vorder": 22,
    "position": 1,
    "text": "ترا سوی این بیشه چون بود راه؟"
  },
  {
    "poem_id": 1481,
    "vorder": 23,
    "position": 0,
    "text": "چنین داد پاسخ که: ما را پدر"
  },
  {
    "poem_id": 1481,
    "vorder": 24,
    "position": 1,
    "text": "بزد دوش، بگذاشتم بوم و بر"
  },
  {
    "poem_id": 1481,
    "vorder": 25,
    "position": 0,
    "text": "شب تیره مست آمد از دشتِ سور"
  },
  {
    "poem_id": 1481,
    "vorder": 26,
    "position": 1,
    "text": "همان چون مرا دید جوشان ز دور،"
  },
  {
    "poem_id": 1481,
    "vorder": 27,
    "position": 0,
    "text": "یکی خنجری آبگون برکشید"
  },
  {
    "poem_id": 1481,
    "vorder": 28,
    "position": 1,
    "text": "همان خواست از تن سرم را برید"
  },
  {
    "poem_id": 1481,
    "vorder": 29,
    "position": 0,
    "text": "بپرسید زو پهلوان از نژاد"
  },
  {
    "poem_id": 1481,
    "vorder": 30,
    "position": 1,
    "text": "برو سروبن یک به یک کرد یاد"
  },
  {
    "poem_id": 1481,
    "vorder": 31,
    "position": 0,
    "text": "بدو گفت: من خویش گرسیوزم"
  },
  {
    "poem_id": 1481,
    "vorder": 32,
    "position": 1,
    "text": "به شاه آفریدون کشد پروزم"
  },
  {
    "poem_id": 1481,
    "vorder": 33,
    "position": 0,
    "text": "پیاده ـ بدو گفت ـ چون آمدی"
  },
  {
    "poem_id": 1481,
    "vorder": 34,
    "position": 1,
    "text": "که بی‌باره و رهنمون آمدی؟"
  },
  {
    "poem_id": 1481,
    "vorder": 35,
    "position": 0,
    "text": "چنین داد پاسخ که: اسپم بماند"
  },
  {
    "poem_id": 1481,
    "vorder": 36,
    "position": 1,
    "text": "ز سستی مرا بر زمین برنشاند"
  },
  {
    "poem_id": 1481,
    "vorder": 37,
    "position": 0,
    "text": "بی‌اندازه زرّ و گهر داشتم"
  },
  {
    "poem_id": 1481,
    "vorder": 38,
    "position": 1,
    "text": "به سر بر یکی تاج زر داشتم"
  },
  {
    "poem_id": 1481,
    "vorder": 39,
    "position": 0,
    "text": "بران رویِ بالا ز من بستدند"
  },
  {
    "poem_id": 1481,
    "vorder": 40,
    "position": 1,
    "text": "نیام یکی تیغ بر من زدند"
  },
  {
    "poem_id": 1481,
    "vorder": 41,
    "position": 0,
    "text": "چو هشیار گردد پدر بی‌گمان"
  },
  {
    "poem_id": 1481,
    "vorder": 42,
    "position": 1,
    "text": "سواری فرستد پس من دمان"
  },
  {
    "poem_id": 1481,
    "vorder": 43,
    "position": 0,
    "text": "بیاید همی تازیان مادرم"
  },
  {
    "poem_id": 1481,
    "vorder": 44,
    "position": 1,
    "text": "نخواهد کزین بوم و بر بگذرم"
  },
  {
    "poem_id": 1481,
    "vorder": 45,
    "position": 0,
    "text": "دل پهلوانان بدو نرم گشت"
  },
  {
    "poem_id": 1481,
    "vorder": 46,
    "position": 1,
    "text": "سر طوس نوذر بی‌آزرم گشت"
  },
  {
    "poem_id": 1481,
    "vorder": 47,
    "position": 0,
    "text": "شه نوذری گفت: من یافتم"
  },
  {
    "poem_id": 1481,
    "vorder": 48,
    "position": 1,
    "text": "از ایرا چنین تیز بشتافتم"
  },
  {
    "poem_id": 1481,
    "vorder": 49,
    "position": 0,
    "text": "بدو گفت گیو: ای سپهدار شاه"
  },
  {
    "poem_id": 1481,
    "vorder": 50,
    "position": 1,
    "text": "نه با من برابر بدی بی‌سپاه؟"
  },
  {
    "poem_id": 1481,
    "vorder": 51,
    "position": 0,
    "text": "همان طوس نوذر بدان بستهید"
  },
  {
    "poem_id": 1481,
    "vorder": 52,
    "position": 1,
    "text": "کجا: پیش اسپ من اینجا رسید"
  },
  {
    "poem_id": 1481,
    "vorder": 53,
    "position": 0,
    "text": "بدو گیو گفت: این سخن خود مگوی"
  },
  {
    "poem_id": 1481,
    "vorder": 54,
    "position": 1,
    "text": "که «من تاختم پیش نخچیرجوی»"
  },
  {
    "poem_id": 1481,
    "vorder": 55,
    "position": 0,
    "text": "ز بهر پرستنده‌ای گرمگوی"
  },
  {
    "poem_id": 1481,
    "vorder": 56,
    "position": 1,
    "text": "نگردد جوانمرد پرخاشجوی"
  },
  {
    "poem_id": 1481,
    "vorder": 57,
    "position": 0,
    "text": "سخن‌شان به تندی بجایی رسید"
  },
  {
    "poem_id": 1481,
    "vorder": 58,
    "position": 1,
    "text": "که این ماه را سر بباید برید"
  },
  {
    "poem_id": 1481,
    "vorder": 59,
    "position": 0,
    "text": "میانشان چو آن داوری شد دراز"
  },
  {
    "poem_id": 1481,
    "vorder": 60,
    "position": 1,
    "text": "میانجی برآمد یکی سرفراز"
  },
  {
    "poem_id": 1481,
    "vorder": 61,
    "position": 0,
    "text": "که این را بر شاه ایران برید"
  },
  {
    "poem_id": 1481,
    "vorder": 62,
    "position": 1,
    "text": "بدان کاو دهد، هردو فرمان برید"
  },
  {
    "poem_id": 1481,
    "vorder": 63,
    "position": 0,
    "text": "نگشتند هردو ز گفتار اوی"
  },
  {
    "poem_id": 1481,
    "vorder": 64,
    "position": 1,
    "text": "بر شاه ایران نهادند روی"
  },
  {
    "poem_id": 1481,
    "vorder": 65,
    "position": 0,
    "text": "چو کاووس روی کنیزک بدید"
  },
  {
    "poem_id": 1481,
    "vorder": 66,
    "position": 1,
    "text": "بخندید و لب را به دندان گزید"
  },
  {
    "poem_id": 1481,
    "vorder": 67,
    "position": 0,
    "text": "بهردو سپهبد چنین گفت شاه"
  },
  {
    "poem_id": 1481,
    "vorder": 68,
    "position": 1,
    "text": "که: کوتاه شد بر شما رنج راه"
  },
  {
    "poem_id": 1481,
    "vorder": 69,
    "position": 0,
    "text": "برین داستان بگذرانیم روز"
  },
  {
    "poem_id": 1481,
    "vorder": 70,
    "position": 1,
    "text": "که خورشید گیرند گردان بِیوز"
  },
  {
    "poem_id": 1481,
    "vorder": 71,
    "position": 0,
    "text": "گوزنست اگر آهوی دلبرست؟!"
  },
  {
    "poem_id": 1481,
    "vorder": 72,
    "position": 1,
    "text": "شکاری چنین ازدر مهترست"
  },
  {
    "poem_id": 1481,
    "vorder": 73,
    "position": 0,
    "text": "بدو گفت خسرو: نژاد تو چیست"
  },
  {
    "poem_id": 1481,
    "vorder": 74,
    "position": 1,
    "text": "که چهرت همانند چهر پریست؟"
  },
  {
    "poem_id": 1481,
    "vorder": 75,
    "position": 0,
    "text": "ورا گفت: از مام خاتونیم"
  },
  {
    "poem_id": 1481,
    "vorder": 76,
    "position": 1,
    "text": "ز سوی پدر آفریدونیم"
  },
  {
    "poem_id": 1481,
    "vorder": 77,
    "position": 0,
    "text": "نیایم سپهدار گرسیوزست"
  },
  {
    "poem_id": 1481,
    "vorder": 78,
    "position": 1,
    "text": "بران مرز خرگاه او مرکزست"
  },
  {
    "poem_id": 1481,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت کاین روی و موی و نژاد"
  },
  {
    "poem_id": 1481,
    "vorder": 80,
    "position": 1,
    "text": "همی‌خواستی داد هرسه به باد"
  },
  {
    "poem_id": 1481,
    "vorder": 81,
    "position": 0,
    "text": "به مشکوی زرین کنم شایدت"
  },
  {
    "poem_id": 1481,
    "vorder": 82,
    "position": 1,
    "text": "سر ماه‌رویان کنم بایدت"
  },
  {
    "poem_id": 1481,
    "vorder": 83,
    "position": 0,
    "text": "چنین داد پاسخ که: دیدم ترا"
  },
  {
    "poem_id": 1481,
    "vorder": 84,
    "position": 1,
    "text": "ز گردنکشان برگزیدم ترا"
  },
  {
    "poem_id": 1481,
    "vorder": 85,
    "position": 0,
    "text": "بت اندر شبستان فرستاد شاه"
  },
  {
    "poem_id": 1481,
    "vorder": 86,
    "position": 1,
    "text": "بفرمود تا برنشیند به گاه"
  },
  {
    "poem_id": 1481,
    "vorder": 87,
    "position": 0,
    "text": "بیاراستندش به دیبای زرد"
  },
  {
    "poem_id": 1481,
    "vorder": 88,
    "position": 1,
    "text": "به یاقوت و پیروزه و لاجورد"
  },
  {
    "poem_id": 1481,
    "vorder": 89,
    "position": 0,
    "text": "دگر ایزدی هرچه بایست، بود"
  },
  {
    "poem_id": 1481,
    "vorder": 90,
    "position": 1,
    "text": "یکی سرخ یاقوت بُد نابسود"
  }
]