[
  {
    "poem_id": 87968,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید تابنده شد ناپدید"
  },
  {
    "poem_id": 87968,
    "vorder": 2,
    "position": 1,
    "text": "شب تیره بر چرخ لشکر کشید"
  },
  {
    "poem_id": 87968,
    "vorder": 3,
    "position": 0,
    "text": "دلیران دژدار مردی هزار"
  },
  {
    "poem_id": 87968,
    "vorder": 4,
    "position": 1,
    "text": "ز سوی کلات اندر آمد سوار"
  },
  {
    "poem_id": 87968,
    "vorder": 5,
    "position": 0,
    "text": "در دژ ببستند زین روی تنگ"
  },
  {
    "poem_id": 87968,
    "vorder": 6,
    "position": 1,
    "text": "خروش جرس خاست و آوای زنگ"
  },
  {
    "poem_id": 87968,
    "vorder": 7,
    "position": 0,
    "text": "جریره بتخت گرامی بخفت"
  },
  {
    "poem_id": 87968,
    "vorder": 8,
    "position": 1,
    "text": "شب تیره با درد و غم بود جفت"
  },
  {
    "poem_id": 87968,
    "vorder": 9,
    "position": 0,
    "text": "بخواب آتشی دید کز دژ بلند"
  },
  {
    "poem_id": 87968,
    "vorder": 10,
    "position": 1,
    "text": "برافروختی پیش آن ارجمند"
  },
  {
    "poem_id": 87968,
    "vorder": 11,
    "position": 0,
    "text": "سراسر سپد کوه بفروختی"
  },
  {
    "poem_id": 87968,
    "vorder": 12,
    "position": 1,
    "text": "پرستنده و دژ همی سوختی"
  },
  {
    "poem_id": 87968,
    "vorder": 13,
    "position": 0,
    "text": "دلش گشت پر درد و بیدار گشت"
  },
  {
    "poem_id": 87968,
    "vorder": 14,
    "position": 1,
    "text": "روانش پر از درد و تیمار گشت"
  },
  {
    "poem_id": 87968,
    "vorder": 15,
    "position": 0,
    "text": "بباره برآمد جهان بنگرید"
  },
  {
    "poem_id": 87968,
    "vorder": 16,
    "position": 1,
    "text": "همه کوه پرجوشن و نیزه دید"
  },
  {
    "poem_id": 87968,
    "vorder": 17,
    "position": 0,
    "text": "رخش گشت پرخون و دل پر ز دود"
  },
  {
    "poem_id": 87968,
    "vorder": 18,
    "position": 1,
    "text": "بیامد به بالین فرخ فرود"
  },
  {
    "poem_id": 87968,
    "vorder": 19,
    "position": 0,
    "text": "بدو گفت بیدار گرد ای پسر"
  },
  {
    "poem_id": 87968,
    "vorder": 20,
    "position": 1,
    "text": "که ما را بد آمد ز اختر بسر"
  },
  {
    "poem_id": 87968,
    "vorder": 21,
    "position": 0,
    "text": "سراسر همه کوه پر دشمنست"
  },
  {
    "poem_id": 87968,
    "vorder": 22,
    "position": 1,
    "text": "در دژ پر از نیزه و جوشنست"
  },
  {
    "poem_id": 87968,
    "vorder": 23,
    "position": 0,
    "text": "بمادر چنین گفت جنگی فرود"
  },
  {
    "poem_id": 87968,
    "vorder": 24,
    "position": 1,
    "text": "که از غم چه داری دلت پر ز دود"
  },
  {
    "poem_id": 87968,
    "vorder": 25,
    "position": 0,
    "text": "مرا گر زمانه شدست اسپری"
  },
  {
    "poem_id": 87968,
    "vorder": 26,
    "position": 1,
    "text": "زمانه ز بخشش فزون نشمری"
  },
  {
    "poem_id": 87968,
    "vorder": 27,
    "position": 0,
    "text": "بروز جوانی پدر کشته شد"
  },
  {
    "poem_id": 87968,
    "vorder": 28,
    "position": 1,
    "text": "مرا روز چون روز او گشته شد"
  },
  {
    "poem_id": 87968,
    "vorder": 29,
    "position": 0,
    "text": "بدست گروی آمد او را زمان"
  },
  {
    "poem_id": 87968,
    "vorder": 30,
    "position": 1,
    "text": "سوی جان من بیژن آمد دمان"
  },
  {
    "poem_id": 87968,
    "vorder": 31,
    "position": 0,
    "text": "بکوشم نمیرم مگر غرم‌وار"
  },
  {
    "poem_id": 87968,
    "vorder": 32,
    "position": 1,
    "text": "نخواهم ز ایرانیان زینهار"
  },
  {
    "poem_id": 87968,
    "vorder": 33,
    "position": 0,
    "text": "سپه را همه ترگ و جوشن بداد"
  },
  {
    "poem_id": 87968,
    "vorder": 34,
    "position": 1,
    "text": "یکی ترگ رومی بسر برنهاد"
  },
  {
    "poem_id": 87968,
    "vorder": 35,
    "position": 0,
    "text": "میانرا بخفتان رومی ببست"
  },
  {
    "poem_id": 87968,
    "vorder": 36,
    "position": 1,
    "text": "بیامد کمان کیانی بدست"
  }
]