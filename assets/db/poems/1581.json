[
  {
    "poem_id": 1581,
    "vorder": 1,
    "position": 0,
    "text": "بفرمود تا بهمن آمدش پیش"
  },
  {
    "poem_id": 1581,
    "vorder": 2,
    "position": 1,
    "text": "ورا پندها داد ز اندازه بیش"
  },
  {
    "poem_id": 1581,
    "vorder": 3,
    "position": 0,
    "text": "بدو گفت اسپ سیه بر نشین"
  },
  {
    "poem_id": 1581,
    "vorder": 4,
    "position": 1,
    "text": "بیارای تن را به دیبای چین"
  },
  {
    "poem_id": 1581,
    "vorder": 5,
    "position": 0,
    "text": "بنه بر سرت افسر خسروی"
  },
  {
    "poem_id": 1581,
    "vorder": 6,
    "position": 1,
    "text": "نگارش همه گوهر پهلوی"
  },
  {
    "poem_id": 1581,
    "vorder": 7,
    "position": 0,
    "text": "بر آن سان که هرکس که بیند ترا"
  },
  {
    "poem_id": 1581,
    "vorder": 8,
    "position": 1,
    "text": "ز گردنکشان برگزیند ترا"
  },
  {
    "poem_id": 1581,
    "vorder": 9,
    "position": 0,
    "text": "بداند که هستی تو خسرونژاد"
  },
  {
    "poem_id": 1581,
    "vorder": 10,
    "position": 1,
    "text": "کند آفریننده را بر تو یاد"
  },
  {
    "poem_id": 1581,
    "vorder": 11,
    "position": 0,
    "text": "ببر پنج بالای زرین ستام"
  },
  {
    "poem_id": 1581,
    "vorder": 12,
    "position": 1,
    "text": "سرافراز ده موبد نیک‌نام"
  },
  {
    "poem_id": 1581,
    "vorder": 13,
    "position": 0,
    "text": "هم از راه تا خان رستم بران"
  },
  {
    "poem_id": 1581,
    "vorder": 14,
    "position": 1,
    "text": "مکن کار بر خویشتن بر گران"
  },
  {
    "poem_id": 1581,
    "vorder": 15,
    "position": 0,
    "text": "درودش ده از ما و خوبی نمای"
  },
  {
    "poem_id": 1581,
    "vorder": 16,
    "position": 1,
    "text": "بیارای گفتار و چربی فزای"
  },
  {
    "poem_id": 1581,
    "vorder": 17,
    "position": 0,
    "text": "بگویش که هرکس که گردد بلند"
  },
  {
    "poem_id": 1581,
    "vorder": 18,
    "position": 1,
    "text": "جهاندار وز هر بدی بی‌گزند"
  },
  {
    "poem_id": 1581,
    "vorder": 19,
    "position": 0,
    "text": "ز دادار باید که دارد سپاس"
  },
  {
    "poem_id": 1581,
    "vorder": 20,
    "position": 1,
    "text": "که اویست جاوید نیکی شناس"
  },
  {
    "poem_id": 1581,
    "vorder": 21,
    "position": 0,
    "text": "چو باشد فزایندهٔ نیکویی"
  },
  {
    "poem_id": 1581,
    "vorder": 22,
    "position": 1,
    "text": "به پرهیز دارد سر از بدخویی"
  },
  {
    "poem_id": 1581,
    "vorder": 23,
    "position": 0,
    "text": "بیفزایدش کامگاری و گنج"
  },
  {
    "poem_id": 1581,
    "vorder": 24,
    "position": 1,
    "text": "بود شادمان در سرای سپنج"
  },
  {
    "poem_id": 1581,
    "vorder": 25,
    "position": 0,
    "text": "چو دوری گزیند ز کردار زشت"
  },
  {
    "poem_id": 1581,
    "vorder": 26,
    "position": 1,
    "text": "بیابد بدان گیتی اندر بهشت"
  },
  {
    "poem_id": 1581,
    "vorder": 27,
    "position": 0,
    "text": "بد و نیک بر ما همی بگذرد"
  },
  {
    "poem_id": 1581,
    "vorder": 28,
    "position": 1,
    "text": "چنین داند آن کس که دارد خرد"
  },
  {
    "poem_id": 1581,
    "vorder": 29,
    "position": 0,
    "text": "سرانجام بستر بود تیره‌خاک"
  },
  {
    "poem_id": 1581,
    "vorder": 30,
    "position": 1,
    "text": "بپرد روان سوی یزدان پاک"
  },
  {
    "poem_id": 1581,
    "vorder": 31,
    "position": 0,
    "text": "به گیتی هرانکس که نیکی شناخت"
  },
  {
    "poem_id": 1581,
    "vorder": 32,
    "position": 1,
    "text": "بکوشید و با شهریاران بساخت"
  },
  {
    "poem_id": 1581,
    "vorder": 33,
    "position": 0,
    "text": "همان بر که کاری همان بدروی"
  },
  {
    "poem_id": 1581,
    "vorder": 34,
    "position": 1,
    "text": "سخن هرچه گویی همان بشنوی"
  },
  {
    "poem_id": 1581,
    "vorder": 35,
    "position": 0,
    "text": "کنون از تو اندازه گیریم راست"
  },
  {
    "poem_id": 1581,
    "vorder": 36,
    "position": 1,
    "text": "نباید بر این بر فزون و نه کاست"
  },
  {
    "poem_id": 1581,
    "vorder": 37,
    "position": 0,
    "text": "که بگذاشتی سالیان بی‌شمار"
  },
  {
    "poem_id": 1581,
    "vorder": 38,
    "position": 1,
    "text": "به گیتی بدیدی بسی شهریار"
  },
  {
    "poem_id": 1581,
    "vorder": 39,
    "position": 0,
    "text": "اگر بازجویی ز راه خرد"
  },
  {
    "poem_id": 1581,
    "vorder": 40,
    "position": 1,
    "text": "بدانی که چونین نه اندر خورد"
  },
  {
    "poem_id": 1581,
    "vorder": 41,
    "position": 0,
    "text": "که چندین بزرگی و گنج و سپاه"
  },
  {
    "poem_id": 1581,
    "vorder": 42,
    "position": 1,
    "text": "گرانمایه اسپان و تخت و کلاه"
  },
  {
    "poem_id": 1581,
    "vorder": 43,
    "position": 0,
    "text": "ز پیش نیاکان ما یافتی"
  },
  {
    "poem_id": 1581,
    "vorder": 44,
    "position": 1,
    "text": "چو در بندگی تیز بشتافتی"
  },
  {
    "poem_id": 1581,
    "vorder": 45,
    "position": 0,
    "text": "چه مایه جهان داشت لهراسپ شاه"
  },
  {
    "poem_id": 1581,
    "vorder": 46,
    "position": 1,
    "text": "نکردی گذر سوی آن بارگاه"
  },
  {
    "poem_id": 1581,
    "vorder": 47,
    "position": 0,
    "text": "چو او شهر ایران به گشتاسپ داد"
  },
  {
    "poem_id": 1581,
    "vorder": 48,
    "position": 1,
    "text": "نیامد ترا هیچ زان تخت یاد"
  },
  {
    "poem_id": 1581,
    "vorder": 49,
    "position": 0,
    "text": "سوی او یکی نامه ننوشته‌ای"
  },
  {
    "poem_id": 1581,
    "vorder": 50,
    "position": 1,
    "text": "از آرایش بندگی گشته‌ای"
  },
  {
    "poem_id": 1581,
    "vorder": 51,
    "position": 0,
    "text": "نرفتی به درگاه او بنده‌وار"
  },
  {
    "poem_id": 1581,
    "vorder": 52,
    "position": 1,
    "text": "نخواهی به گیتی کسی شهریار"
  },
  {
    "poem_id": 1581,
    "vorder": 53,
    "position": 0,
    "text": "ز هوشنگ و جم و فریدون گرد"
  },
  {
    "poem_id": 1581,
    "vorder": 54,
    "position": 1,
    "text": "که از تخم ضحاک شاهی ببرد"
  },
  {
    "poem_id": 1581,
    "vorder": 55,
    "position": 0,
    "text": "همی رو چنین تا سر کیقباد"
  },
  {
    "poem_id": 1581,
    "vorder": 56,
    "position": 1,
    "text": "که تاج فریدون به سر بر نهاد"
  },
  {
    "poem_id": 1581,
    "vorder": 57,
    "position": 0,
    "text": "چو گشتاسپ شه نیست یک نامدار"
  },
  {
    "poem_id": 1581,
    "vorder": 58,
    "position": 1,
    "text": "به رزم و به بزم و به رای و شکار"
  },
  {
    "poem_id": 1581,
    "vorder": 59,
    "position": 0,
    "text": "پذیرفت پاکیزه دین بهی"
  },
  {
    "poem_id": 1581,
    "vorder": 60,
    "position": 1,
    "text": "نهان گشت گمراهی و بی‌رهی"
  },
  {
    "poem_id": 1581,
    "vorder": 61,
    "position": 0,
    "text": "چو خورشید شد راه گیهان خدیو"
  },
  {
    "poem_id": 1581,
    "vorder": 62,
    "position": 1,
    "text": "نهان شد بدآموزی و راه دیو"
  },
  {
    "poem_id": 1581,
    "vorder": 63,
    "position": 0,
    "text": "ازان پس که ارجاسپ آمد به جنگ"
  },
  {
    "poem_id": 1581,
    "vorder": 64,
    "position": 1,
    "text": "سپه چون پلنگان و مهتر نهنگ"
  },
  {
    "poem_id": 1581,
    "vorder": 65,
    "position": 0,
    "text": "ندانست کس لشکرش را شمار"
  },
  {
    "poem_id": 1581,
    "vorder": 66,
    "position": 1,
    "text": "پذیره شدش نامور شهریار"
  },
  {
    "poem_id": 1581,
    "vorder": 67,
    "position": 0,
    "text": "یکی گورستان کرد بر دشت کین"
  },
  {
    "poem_id": 1581,
    "vorder": 68,
    "position": 1,
    "text": "که پیدا نبد پهن روی زمین"
  },
  {
    "poem_id": 1581,
    "vorder": 69,
    "position": 0,
    "text": "همانا که تا رستخیز این سخن"
  },
  {
    "poem_id": 1581,
    "vorder": 70,
    "position": 1,
    "text": "میان بزرگان نگردد کهن"
  },
  {
    "poem_id": 1581,
    "vorder": 71,
    "position": 0,
    "text": "کنون خاور او راست تا باختر"
  },
  {
    "poem_id": 1581,
    "vorder": 72,
    "position": 1,
    "text": "همی بشکند پشت شیران نر"
  },
  {
    "poem_id": 1581,
    "vorder": 73,
    "position": 0,
    "text": "ز توران زمین تا در هند و روم"
  },
  {
    "poem_id": 1581,
    "vorder": 74,
    "position": 1,
    "text": "جهان شد مر او را چو یک مهره موم"
  },
  {
    "poem_id": 1581,
    "vorder": 75,
    "position": 0,
    "text": "ز دشت سواران نیزه گزار"
  },
  {
    "poem_id": 1581,
    "vorder": 76,
    "position": 1,
    "text": "به درگاه اویند چندی سوار"
  },
  {
    "poem_id": 1581,
    "vorder": 77,
    "position": 0,
    "text": "فرستندش از مرزها باژ و ساو"
  },
  {
    "poem_id": 1581,
    "vorder": 78,
    "position": 1,
    "text": "که با جنگ او نیستشان زور و تاو"
  },
  {
    "poem_id": 1581,
    "vorder": 79,
    "position": 0,
    "text": "ازان گفتم این با توای پهلوان"
  },
  {
    "poem_id": 1581,
    "vorder": 80,
    "position": 1,
    "text": "که او از تو آزرده دارد روان"
  },
  {
    "poem_id": 1581,
    "vorder": 81,
    "position": 0,
    "text": "نرفتی بدان نامور بارگاه"
  },
  {
    "poem_id": 1581,
    "vorder": 82,
    "position": 1,
    "text": "نکردی بدان نامداران نگاه"
  },
  {
    "poem_id": 1581,
    "vorder": 83,
    "position": 0,
    "text": "کرانی گرفتستی اندر جهان"
  },
  {
    "poem_id": 1581,
    "vorder": 84,
    "position": 1,
    "text": "که داری همی خویشتن را نهان"
  },
  {
    "poem_id": 1581,
    "vorder": 85,
    "position": 0,
    "text": "فرامش ترا مهتران چون کنند"
  },
  {
    "poem_id": 1581,
    "vorder": 86,
    "position": 1,
    "text": "مگر مغز و دل پاک بیرون کنند"
  },
  {
    "poem_id": 1581,
    "vorder": 87,
    "position": 0,
    "text": "همیشه همه نیکویی خواستی"
  },
  {
    "poem_id": 1581,
    "vorder": 88,
    "position": 1,
    "text": "به فرمان شاهان بیاراستی"
  },
  {
    "poem_id": 1581,
    "vorder": 89,
    "position": 0,
    "text": "اگر بر شمارد کسی رنج تو"
  },
  {
    "poem_id": 1581,
    "vorder": 90,
    "position": 1,
    "text": "به گیتی فزون آید از گنج تو"
  },
  {
    "poem_id": 1581,
    "vorder": 91,
    "position": 0,
    "text": "ز شاهان کسی بر چنین داستان"
  },
  {
    "poem_id": 1581,
    "vorder": 92,
    "position": 1,
    "text": "ز بنده نبودند همداستان"
  },
  {
    "poem_id": 1581,
    "vorder": 93,
    "position": 0,
    "text": "مرا گفت رستم ز بس خواسته"
  },
  {
    "poem_id": 1581,
    "vorder": 94,
    "position": 1,
    "text": "هم از کشور و گنج آراسته"
  },
  {
    "poem_id": 1581,
    "vorder": 95,
    "position": 0,
    "text": "به زاول نشستست و گشتست مست"
  },
  {
    "poem_id": 1581,
    "vorder": 96,
    "position": 1,
    "text": "نگیرد کس از مست چیزی به دست"
  },
  {
    "poem_id": 1581,
    "vorder": 97,
    "position": 0,
    "text": "برآشفت یک روز و سوگند خورد"
  },
  {
    "poem_id": 1581,
    "vorder": 98,
    "position": 1,
    "text": "به روز سپید و شب لاژورد"
  },
  {
    "poem_id": 1581,
    "vorder": 99,
    "position": 0,
    "text": "که او را به جز بسته در بارگاه"
  },
  {
    "poem_id": 1581,
    "vorder": 100,
    "position": 1,
    "text": "نبیند ازین پس جهاندار شاه"
  },
  {
    "poem_id": 1581,
    "vorder": 101,
    "position": 0,
    "text": "کنون من ز ایران بدین آمدم"
  },
  {
    "poem_id": 1581,
    "vorder": 102,
    "position": 1,
    "text": "نبد شاه دستور تا دم زدم"
  },
  {
    "poem_id": 1581,
    "vorder": 103,
    "position": 0,
    "text": "بپرهیز و پیچان شو از خشم اوی"
  },
  {
    "poem_id": 1581,
    "vorder": 104,
    "position": 1,
    "text": "ندیدی که خشم آورد چشم اوی"
  },
  {
    "poem_id": 1581,
    "vorder": 105,
    "position": 0,
    "text": "چو اینجا بیایی و فرمان کنی"
  },
  {
    "poem_id": 1581,
    "vorder": 106,
    "position": 1,
    "text": "روان را به پوزش گروگان کنی"
  },
  {
    "poem_id": 1581,
    "vorder": 107,
    "position": 0,
    "text": "به خورشید رخشان و جان زریر"
  },
  {
    "poem_id": 1581,
    "vorder": 108,
    "position": 1,
    "text": "به جان پدرم آن جهاندار شیر"
  },
  {
    "poem_id": 1581,
    "vorder": 109,
    "position": 0,
    "text": "که من زین پشیمان کنم شاه را"
  },
  {
    "poem_id": 1581,
    "vorder": 110,
    "position": 1,
    "text": "برافرزوم این اختر و ماه را"
  },
  {
    "poem_id": 1581,
    "vorder": 111,
    "position": 0,
    "text": "که من زین که گفتم نجویم فروغ"
  },
  {
    "poem_id": 1581,
    "vorder": 112,
    "position": 1,
    "text": "نگردم به هر کار گرد دروغ"
  },
  {
    "poem_id": 1581,
    "vorder": 113,
    "position": 0,
    "text": "پشوتن برین بر گوای منست"
  },
  {
    "poem_id": 1581,
    "vorder": 114,
    "position": 1,
    "text": "روان و خرد رهنمای منست"
  },
  {
    "poem_id": 1581,
    "vorder": 115,
    "position": 0,
    "text": "همی جستم از تو من آرام شاه"
  },
  {
    "poem_id": 1581,
    "vorder": 116,
    "position": 1,
    "text": "ولیکن همی از تو دیدم گناه"
  },
  {
    "poem_id": 1581,
    "vorder": 117,
    "position": 0,
    "text": "پدر شهریارست و من کهترم"
  },
  {
    "poem_id": 1581,
    "vorder": 118,
    "position": 1,
    "text": "ز فرمان او یک زمان نگذرم"
  },
  {
    "poem_id": 1581,
    "vorder": 119,
    "position": 0,
    "text": "همه دوده اکنون بباید نشست"
  },
  {
    "poem_id": 1581,
    "vorder": 120,
    "position": 1,
    "text": "زدن رای و سودن بدین کار دست"
  },
  {
    "poem_id": 1581,
    "vorder": 121,
    "position": 0,
    "text": "زواره فرامرز و دستان سام"
  },
  {
    "poem_id": 1581,
    "vorder": 122,
    "position": 1,
    "text": "جهاندیده رودابهٔ نیک نام"
  },
  {
    "poem_id": 1581,
    "vorder": 123,
    "position": 0,
    "text": "همه پند من یک به یک بشنوید"
  },
  {
    "poem_id": 1581,
    "vorder": 124,
    "position": 1,
    "text": "بدین خوب گفتار من بگروید"
  },
  {
    "poem_id": 1581,
    "vorder": 125,
    "position": 0,
    "text": "نباید که این خانه ویران شود"
  },
  {
    "poem_id": 1581,
    "vorder": 126,
    "position": 1,
    "text": "به کام دلیران ایران شود"
  },
  {
    "poem_id": 1581,
    "vorder": 127,
    "position": 0,
    "text": "چو بسته ترا نزد شاه آورم"
  },
  {
    "poem_id": 1581,
    "vorder": 128,
