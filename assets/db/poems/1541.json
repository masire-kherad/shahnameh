[
  {
    "poem_id": 1541,
    "vorder": 1,
    "position": 0,
    "text": "پس آگاهی آمد به اسفندیار"
  },
  {
    "poem_id": 1541,
    "vorder": 2,
    "position": 1,
    "text": "که کشته شد آن شاه نیزه گزار"
  },
  {
    "poem_id": 1541,
    "vorder": 3,
    "position": 0,
    "text": "پدرت از غم او بکاهد همی"
  },
  {
    "poem_id": 1541,
    "vorder": 4,
    "position": 1,
    "text": "کنون کین او خواست خواهد همی"
  },
  {
    "poem_id": 1541,
    "vorder": 5,
    "position": 0,
    "text": "همی گوید آنکس کجاکین اوی"
  },
  {
    "poem_id": 1541,
    "vorder": 6,
    "position": 1,
    "text": "بخواهد نهد پیش دشمنش روی"
  },
  {
    "poem_id": 1541,
    "vorder": 7,
    "position": 0,
    "text": "مر او را دهم دخترم را همای"
  },
  {
    "poem_id": 1541,
    "vorder": 8,
    "position": 1,
    "text": "وکرد ایزدش را برین بر گوای"
  },
  {
    "poem_id": 1541,
    "vorder": 9,
    "position": 0,
    "text": "کی نامور دست بر دست زد"
  },
  {
    "poem_id": 1541,
    "vorder": 10,
    "position": 1,
    "text": "بنالید ازان روزگاران بد"
  },
  {
    "poem_id": 1541,
    "vorder": 11,
    "position": 0,
    "text": "همه ساله زین روز ترسیدمی"
  },
  {
    "poem_id": 1541,
    "vorder": 12,
    "position": 1,
    "text": "چو او را به رزم اندرون دیدمی"
  },
  {
    "poem_id": 1541,
    "vorder": 13,
    "position": 0,
    "text": "دریغا سوارا گوا مهترا"
  },
  {
    "poem_id": 1541,
    "vorder": 14,
    "position": 1,
    "text": "که بختش جدا کرد تاج از سرا"
  },
  {
    "poem_id": 1541,
    "vorder": 15,
    "position": 0,
    "text": "که کشت آن سیه پیل نستوه را"
  },
  {
    "poem_id": 1541,
    "vorder": 16,
    "position": 1,
    "text": "که کند از زمین آهنین کوه را"
  },
  {
    "poem_id": 1541,
    "vorder": 17,
    "position": 0,
    "text": "درفش و سرلشکر و جای خویش"
  },
  {
    "poem_id": 1541,
    "vorder": 18,
    "position": 1,
    "text": "برادرش را داد و خود رفت پیش"
  },
  {
    "poem_id": 1541,
    "vorder": 19,
    "position": 0,
    "text": "به قلب اندر آمد به جای زریر"
  },
  {
    "poem_id": 1541,
    "vorder": 20,
    "position": 1,
    "text": "به صف اندر استاد چون نره شیر"
  },
  {
    "poem_id": 1541,
    "vorder": 21,
    "position": 0,
    "text": "به پیش اندر آمد میان را ببست"
  },
  {
    "poem_id": 1541,
    "vorder": 22,
    "position": 1,
    "text": "گرفت آن درفش همایون به دست"
  },
  {
    "poem_id": 1541,
    "vorder": 23,
    "position": 0,
    "text": "برادرش بد پنج دانسته راه"
  },
  {
    "poem_id": 1541,
    "vorder": 24,
    "position": 1,
    "text": "همه از در تاج و همتای شاه"
  },
  {
    "poem_id": 1541,
    "vorder": 25,
    "position": 0,
    "text": "همه ایستادند در پیش اوی"
  },
  {
    "poem_id": 1541,
    "vorder": 26,
    "position": 1,
    "text": "که لشکر شکستن بدی کیش اوی"
  },
  {
    "poem_id": 1541,
    "vorder": 27,
    "position": 0,
    "text": "به آزادگان گفت پیش سپاه"
  },
  {
    "poem_id": 1541,
    "vorder": 28,
    "position": 1,
    "text": "که ای نامداران و گردان شاه"
  },
  {
    "poem_id": 1541,
    "vorder": 29,
    "position": 0,
    "text": "نگر تا چه گویم یکی بشنوید"
  },
  {
    "poem_id": 1541,
    "vorder": 30,
    "position": 1,
    "text": "به دین خدای جهان بگروید"
  },
  {
    "poem_id": 1541,
    "vorder": 31,
    "position": 0,
    "text": "نگر تا نترسید از مرگ و چیز"
  },
  {
    "poem_id": 1541,
    "vorder": 32,
    "position": 1,
    "text": "که کس بی‌زمانه نمردست نیز"
  },
  {
    "poem_id": 1541,
    "vorder": 33,
    "position": 0,
    "text": "کرا کشت خواهد همی روزگار"
  },
  {
    "poem_id": 1541,
    "vorder": 34,
    "position": 1,
    "text": "چه نیکوتر از مرگ در کارزار"
  },
  {
    "poem_id": 1541,
    "vorder": 35,
    "position": 0,
    "text": "بدانید یکسر که روزیست این"
  },
  {
    "poem_id": 1541,
    "vorder": 36,
    "position": 1,
    "text": "که کافر پدید آید از پاک دین"
  },
  {
    "poem_id": 1541,
    "vorder": 37,
    "position": 0,
    "text": "شما از پس پشتها منگرید"
  },
  {
    "poem_id": 1541,
    "vorder": 38,
    "position": 1,
    "text": "مجویید فریاد و سر مشمرید"
  },
  {
    "poem_id": 1541,
    "vorder": 39,
    "position": 0,
    "text": "نگر تا نبینید بگریختن"
  },
  {
    "poem_id": 1541,
    "vorder": 40,
    "position": 1,
    "text": "نگر تا نترسید ز آویختن"
  },
  {
    "poem_id": 1541,
    "vorder": 41,
    "position": 0,
    "text": "سر نیزه‌ها را به رزم افگنید"
  },
  {
    "poem_id": 1541,
    "vorder": 42,
    "position": 1,
    "text": "زمانی بکوشید و مردی کنید"
  },
  {
    "poem_id": 1541,
    "vorder": 43,
    "position": 0,
    "text": "بدین اندرون بود اسفندیار"
  },
  {
    "poem_id": 1541,
    "vorder": 44,
    "position": 1,
    "text": "که بانگ پدرش آمد از کوهسار"
  },
  {
    "poem_id": 1541,
    "vorder": 45,
    "position": 0,
    "text": "که ای نامداران و گردان من"
  },
  {
    "poem_id": 1541,
    "vorder": 46,
    "position": 1,
    "text": "همه مر مرا چون تن و جان من"
  },
  {
    "poem_id": 1541,
    "vorder": 47,
    "position": 0,
    "text": "مترسید از نیزه و گرز و تیغ"
  },
  {
    "poem_id": 1541,
    "vorder": 48,
    "position": 1,
    "text": "که از بخش‌مان نیست روی گریغ"
  },
  {
    "poem_id": 1541,
    "vorder": 49,
    "position": 0,
    "text": "به دین خدا ای گو اسفندیار"
  },
  {
    "poem_id": 1541,
    "vorder": 50,
    "position": 1,
    "text": "به جان زریر آن نبرده سوار"
  },
  {
    "poem_id": 1541,
    "vorder": 51,
    "position": 0,
    "text": "که آید فرود او کنون در بهشت"
  },
  {
    "poem_id": 1541,
    "vorder": 52,
    "position": 1,
    "text": "که من سوی لهراسپ نامه نوشت"
  },
  {
    "poem_id": 1541,
    "vorder": 53,
    "position": 0,
    "text": "پذیرفتم اندرز آن شاه پیر"
  },
  {
    "poem_id": 1541,
    "vorder": 54,
    "position": 1,
    "text": "که گر بخت نیکم بود دستگیر"
  },
  {
    "poem_id": 1541,
    "vorder": 55,
    "position": 0,
    "text": "که چون بازگردم ازین رزمگاه"
  },
  {
    "poem_id": 1541,
    "vorder": 56,
    "position": 1,
    "text": "به اسفندیارم دهم تاج و گاه"
  },
  {
    "poem_id": 1541,
    "vorder": 57,
    "position": 0,
    "text": "سپه را همه پیش رفتن دهم"
  },
  {
    "poem_id": 1541,
    "vorder": 58,
    "position": 1,
    "text": "ورا خسروی تاج بر سر نهم"
  },
  {
    "poem_id": 1541,
    "vorder": 59,
    "position": 0,
    "text": "چنانچون پدر داد شاهی مرا"
  },
  {
    "poem_id": 1541,
    "vorder": 60,
    "position": 1,
    "text": "دهم همچنان پادشاهی ورا"
  }
]