[
  {
    "poem_id": 1619,
    "vorder": 1,
    "position": 0,
    "text": "به بیماری اندر بمرد اردشیر"
  },
  {
    "poem_id": 1619,
    "vorder": 2,
    "position": 1,
    "text": "همی بود بی‌کار تاج و سریر"
  },
  {
    "poem_id": 1619,
    "vorder": 3,
    "position": 0,
    "text": "همای آمد و تاج بر سر نهاد"
  },
  {
    "poem_id": 1619,
    "vorder": 4,
    "position": 1,
    "text": "یکی راه و آیین دیگر نهاد"
  },
  {
    "poem_id": 1619,
    "vorder": 5,
    "position": 0,
    "text": "سپه را همه سربسر بار داد"
  },
  {
    "poem_id": 1619,
    "vorder": 6,
    "position": 1,
    "text": "در گنج بگشاد و دینار داد"
  },
  {
    "poem_id": 1619,
    "vorder": 7,
    "position": 0,
    "text": "به رای و به داد از پدر برگذشت"
  },
  {
    "poem_id": 1619,
    "vorder": 8,
    "position": 1,
    "text": "همی گیتی از دادش آباد گشت"
  },
  {
    "poem_id": 1619,
    "vorder": 9,
    "position": 0,
    "text": "نخستین که دیهیم بر سر نهاد"
  },
  {
    "poem_id": 1619,
    "vorder": 10,
    "position": 1,
    "text": "جهان را به داد و دهش مژده داد"
  },
  {
    "poem_id": 1619,
    "vorder": 11,
    "position": 0,
    "text": "که این تاج و این تخت فرخنده باد"
  },
  {
    "poem_id": 1619,
    "vorder": 12,
    "position": 1,
    "text": "دل بدسگالان ما کنده باد"
  },
  {
    "poem_id": 1619,
    "vorder": 13,
    "position": 0,
    "text": "همه نیکویی باد کردار ما"
  },
  {
    "poem_id": 1619,
    "vorder": 14,
    "position": 1,
    "text": "مبیناد کس رنج و تیمار ما"
  },
  {
    "poem_id": 1619,
    "vorder": 15,
    "position": 0,
    "text": "توانگر کنیم آنک درویش بود"
  },
  {
    "poem_id": 1619,
    "vorder": 16,
    "position": 1,
    "text": "نیازش به رنج تن خویش بود"
  },
  {
    "poem_id": 1619,
    "vorder": 17,
    "position": 0,
    "text": "مهان جهان را که دارند گنج"
  },
  {
    "poem_id": 1619,
    "vorder": 18,
    "position": 1,
    "text": "نداریم زان نیکویها به رنج"
  },
  {
    "poem_id": 1619,
    "vorder": 19,
    "position": 0,
    "text": "چو هنگام زادنش آمد فراز"
  },
  {
    "poem_id": 1619,
    "vorder": 20,
    "position": 1,
    "text": "ز شهر و ز لشکر همی داشت راز"
  },
  {
    "poem_id": 1619,
    "vorder": 21,
    "position": 0,
    "text": "همی تخت شاهی پسند آمدش"
  },
  {
    "poem_id": 1619,
    "vorder": 22,
    "position": 1,
    "text": "جهان داشتن سودمند آمدش"
  },
  {
    "poem_id": 1619,
    "vorder": 23,
    "position": 0,
    "text": "نهانی پسر زاد و با کس نگفت"
  },
  {
    "poem_id": 1619,
    "vorder": 24,
    "position": 1,
    "text": "همی داشت آن نیکویی در نهفت"
  },
  {
    "poem_id": 1619,
    "vorder": 25,
    "position": 0,
    "text": "بیاورد آزاده‌تن دایه را"
  },
  {
    "poem_id": 1619,
    "vorder": 26,
    "position": 1,
    "text": "یکی پاک پرشرم و بامایه را"
  },
  {
    "poem_id": 1619,
    "vorder": 27,
    "position": 0,
    "text": "نهانی بدو داد فرزند را"
  },
  {
    "poem_id": 1619,
    "vorder": 28,
    "position": 1,
    "text": "چنان شاه شاخ برومند را"
  },
  {
    "poem_id": 1619,
    "vorder": 29,
    "position": 0,
    "text": "کسی کو ز فرزند او نام برد"
  },
  {
    "poem_id": 1619,
    "vorder": 30,
    "position": 1,
    "text": "چنین گفت کان پاک‌زاده بمرد"
  },
  {
    "poem_id": 1619,
    "vorder": 31,
    "position": 0,
    "text": "همان تاج شاهی به سر بر نهاد"
  },
  {
    "poem_id": 1619,
    "vorder": 32,
    "position": 1,
    "text": "همی بود بر تخت پیروز و شاد"
  },
  {
    "poem_id": 1619,
    "vorder": 33,
    "position": 0,
    "text": "ز دشمن بهر سو که بد مهتری"
  },
  {
    "poem_id": 1619,
    "vorder": 34,
    "position": 1,
    "text": "فرستاد بر هر سوی لشکری"
  },
  {
    "poem_id": 1619,
    "vorder": 35,
    "position": 0,
    "text": "ز چیزی که رفتی به گرد جهان"
  },
  {
    "poem_id": 1619,
    "vorder": 36,
    "position": 1,
    "text": "نبودی بد و نیک ازو در نهان"
  },
  {
    "poem_id": 1619,
    "vorder": 37,
    "position": 0,
    "text": "به گیتی به جز داد و نیکی نخواست"
  },
  {
    "poem_id": 1619,
    "vorder": 38,
    "position": 1,
    "text": "جهان را سراسر همی داشت راست"
  },
  {
    "poem_id": 1619,
    "vorder": 39,
    "position": 0,
    "text": "جهانی شده ایمن از داد او"
  },
  {
    "poem_id": 1619,
    "vorder": 40,
    "position": 1,
    "text": "به کشور نبودی به جز یاد او"
  },
  {
    "poem_id": 1619,
    "vorder": 41,
    "position": 0,
    "text": "بدین سان همی بود تا هشت ماه"
  },
  {
    "poem_id": 1619,
    "vorder": 42,
    "position": 1,
    "text": "پسر گشت مانندهٔ رفته شاه"
  },
  {
    "poem_id": 1619,
    "vorder": 43,
    "position": 0,
    "text": "بفرمود تا درگری پاک‌مغز"
  },
  {
    "poem_id": 1619,
    "vorder": 44,
    "position": 1,
    "text": "یکی تخته جست از در کار نغز"
  },
  {
    "poem_id": 1619,
    "vorder": 45,
    "position": 0,
    "text": "یکی خرد صندوق از چوب خشک"
  },
  {
    "poem_id": 1619,
    "vorder": 46,
    "position": 1,
    "text": "بکردند و برزد برو قیر و مشک"
  },
  {
    "poem_id": 1619,
    "vorder": 47,
    "position": 0,
    "text": "درون نرم کرده به دیبای روم"
  },
  {
    "poem_id": 1619,
    "vorder": 48,
    "position": 1,
    "text": "براندوده بیرون او مشک و موم"
  },
  {
    "poem_id": 1619,
    "vorder": 49,
    "position": 0,
    "text": "به زیر اندرش بستر خواب کرد"
  },
  {
    "poem_id": 1619,
    "vorder": 50,
    "position": 1,
    "text": "میانش پر از در خوشاب کرد"
  },
  {
    "poem_id": 1619,
    "vorder": 51,
    "position": 0,
    "text": "بسی زر سرخ اندرو ریخته"
  },
  {
    "poem_id": 1619,
    "vorder": 52,
    "position": 1,
    "text": "عقیق و زبرجد برآمیخته"
  },
  {
    "poem_id": 1619,
    "vorder": 53,
    "position": 0,
    "text": "ببستند بس گوهر شاهوار"
  },
  {
    "poem_id": 1619,
    "vorder": 54,
    "position": 1,
    "text": "به بازوی آن کودک شیرخوار"
  },
  {
    "poem_id": 1619,
    "vorder": 55,
    "position": 0,
    "text": "بدانگه که شد کودک از خواب مست"
  },
  {
    "poem_id": 1619,
    "vorder": 56,
    "position": 1,
    "text": "خروشان بشد دایهٔ چرب دست"
  },
  {
    "poem_id": 1619,
    "vorder": 57,
    "position": 0,
    "text": "نهادش به صندوق در نرم نرم"
  },
  {
    "poem_id": 1619,
    "vorder": 58,
    "position": 1,
    "text": "به چینی پرندش بپوشید گرم"
  },
  {
    "poem_id": 1619,
    "vorder": 59,
    "position": 0,
    "text": "سر تنگ تابوت کردند خشک"
  },
  {
    "poem_id": 1619,
    "vorder": 60,
    "position": 1,
    "text": "به دبق و به عنبر به قیر و به مشک"
  },
  {
    "poem_id": 1619,
    "vorder": 61,
    "position": 0,
    "text": "ببردند صندوق را نیم شب"
  },
  {
    "poem_id": 1619,
    "vorder": 62,
    "position": 1,
    "text": "یکی بر دگر نیز نگشاد لب"
  },
  {
    "poem_id": 1619,
    "vorder": 63,
    "position": 0,
    "text": "ز پیش همایش برون تاختند"
  },
  {
    "poem_id": 1619,
    "vorder": 64,
    "position": 1,
    "text": "به آب فرات اندر انداختند"
  },
  {
    "poem_id": 1619,
    "vorder": 65,
    "position": 0,
    "text": "پس‌اندر همی رفت پویان دو مرد"
  },
  {
    "poem_id": 1619,
    "vorder": 66,
    "position": 1,
    "text": "که تا آب با شیرخواره چه کرد"
  },
  {
    "poem_id": 1619,
    "vorder": 67,
    "position": 0,
    "text": "چو کشتی همی رفت چوب اندر آب"
  },
  {
    "poem_id": 1619,
    "vorder": 68,
    "position": 1,
    "text": "نگهبان آنرا گرفته شتاب"
  },
  {
    "poem_id": 1619,
    "vorder": 69,
    "position": 0,
    "text": "سپیده چو برزد سر از کوهسار"
  },
  {
    "poem_id": 1619,
    "vorder": 70,
    "position": 1,
    "text": "بگردید صندوق بر رودبار"
  },
  {
    "poem_id": 1619,
    "vorder": 71,
    "position": 0,
    "text": "به گازرگهی کاندرو بود سنگ"
  },
  {
    "poem_id": 1619,
    "vorder": 72,
    "position": 1,
    "text": "سر جوی را کارگه کرده تنگ"
  },
  {
    "poem_id": 1619,
    "vorder": 73,
    "position": 0,
    "text": "یکی گازر آن خرد صندوق دید"
  },
  {
    "poem_id": 1619,
    "vorder": 74,
    "position": 1,
    "text": "بپویید وز کارگه برکشید"
  },
  {
    "poem_id": 1619,
    "vorder": 75,
    "position": 0,
    "text": "چو بگشاد گسترده‌ها برگرفت"
  },
  {
    "poem_id": 1619,
    "vorder": 76,
    "position": 1,
    "text": "بماند اندران کار گازر شگفت"
  },
  {
    "poem_id": 1619,
    "vorder": 77,
    "position": 0,
    "text": "به جامه بپوشید و آمد دمان"
  },
  {
    "poem_id": 1619,
    "vorder": 78,
    "position": 1,
    "text": "پرامید و شادان و روشن‌روان"
  },
  {
    "poem_id": 1619,
    "vorder": 79,
    "position": 0,
    "text": "سبک دیده‌بان پیش مامش دوید"
  },
  {
    "poem_id": 1619,
    "vorder": 80,
    "position": 1,
    "text": "ز صندوق و گازر بگفت آنچ دید"
  },
  {
    "poem_id": 1619,
    "vorder": 81,
    "position": 0,
    "text": "جهاندار پیروز با دیده گفت"
  },
  {
    "poem_id": 1619,
    "vorder": 82,
    "position": 1,
    "text": "که چیزی که دیدی بباید نهفت"
  }
]