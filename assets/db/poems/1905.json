[
  {
    "poem_id": 1905,
    "vorder": 1,
    "position": 0,
    "text": "همی هر زمان شاه برتر گذشت"
  },
  {
    "poem_id": 1905,
    "vorder": 2,
    "position": 1,
    "text": "چوشد سال شاهیش بر بیست و هشت"
  },
  {
    "poem_id": 1905,
    "vorder": 3,
    "position": 0,
    "text": "کسی را نشد بر درش کار بد"
  },
  {
    "poem_id": 1905,
    "vorder": 4,
    "position": 1,
    "text": "ز درگاه آگاه شد باربد"
  },
  {
    "poem_id": 1905,
    "vorder": 5,
    "position": 0,
    "text": "بدو گفت هر کس که شاه جهان"
  },
  {
    "poem_id": 1905,
    "vorder": 6,
    "position": 1,
    "text": "گزیدست رامشگری در نهان"
  },
  {
    "poem_id": 1905,
    "vorder": 7,
    "position": 0,
    "text": "اگر با تو او را برابر کند"
  },
  {
    "poem_id": 1905,
    "vorder": 8,
    "position": 1,
    "text": "تو را بر سر سرکش افسر کند"
  },
  {
    "poem_id": 1905,
    "vorder": 9,
    "position": 0,
    "text": "چو بشنید مرد آن بجوشیدش آز"
  },
  {
    "poem_id": 1905,
    "vorder": 10,
    "position": 1,
    "text": "وگرچه نبودش به چیزی نیاز"
  },
  {
    "poem_id": 1905,
    "vorder": 11,
    "position": 0,
    "text": "ز کشور بشد تا به درگاه شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 12,
    "position": 1,
    "text": "همی‌کرد رامشگران را نگاه"
  },
  {
    "poem_id": 1905,
    "vorder": 13,
    "position": 0,
    "text": "چوبشنید سرکش دلش تیره شد"
  },
  {
    "poem_id": 1905,
    "vorder": 14,
    "position": 1,
    "text": "به زخم سرود اندرو خیره شد"
  },
  {
    "poem_id": 1905,
    "vorder": 15,
    "position": 0,
    "text": "بیامد به درگاه سالار بار"
  },
  {
    "poem_id": 1905,
    "vorder": 16,
    "position": 1,
    "text": "درم کرد و دینار چندی نثار"
  },
  {
    "poem_id": 1905,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت رامشگری بر درست"
  },
  {
    "poem_id": 1905,
    "vorder": 18,
    "position": 1,
    "text": "که از من به سال و هنربرترست"
  },
  {
    "poem_id": 1905,
    "vorder": 19,
    "position": 0,
    "text": "نباید که در پیش خسرو شود"
  },
  {
    "poem_id": 1905,
    "vorder": 20,
    "position": 1,
    "text": "که ما کهنه گشتیم و او نو شود"
  },
  {
    "poem_id": 1905,
    "vorder": 21,
    "position": 0,
    "text": "ز سرکش چو بشنید دربان شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 22,
    "position": 1,
    "text": "ز رامشگر ساده بربست راه"
  },
  {
    "poem_id": 1905,
    "vorder": 23,
    "position": 0,
    "text": "چو رفتی به نزدیک او باربد"
  },
  {
    "poem_id": 1905,
    "vorder": 24,
    "position": 1,
    "text": "همش کار بد بود و هم بار بد"
  },
  {
    "poem_id": 1905,
    "vorder": 25,
    "position": 0,
    "text": "ندادی ورا بار سالار بار"
  },
  {
    "poem_id": 1905,
    "vorder": 26,
    "position": 1,
    "text": "نه نیزش بدی مردمی خواستار"
  },
  {
    "poem_id": 1905,
    "vorder": 27,
    "position": 0,
    "text": "چو نومید برگشت زان بارگاه"
  },
  {
    "poem_id": 1905,
    "vorder": 28,
    "position": 1,
    "text": "ابا بربط آمد سوی باغ شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 29,
    "position": 0,
    "text": "کجا باغبان بود مردوی نام"
  },
  {
    "poem_id": 1905,
    "vorder": 30,
    "position": 1,
    "text": "شد از دیدنش باربد شادکام"
  },
  {
    "poem_id": 1905,
    "vorder": 31,
    "position": 0,
    "text": "بدان باغ رفتی به نوروز شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 32,
    "position": 1,
    "text": "دو هفته ببودی بدان جشنگاه"
  },
  {
    "poem_id": 1905,
    "vorder": 33,
    "position": 0,
    "text": "سبک باربد نزد مردوی شد"
  },
  {
    "poem_id": 1905,
    "vorder": 34,
    "position": 1,
    "text": "هم آن روز با مرد همبوی شد"
  },
  {
    "poem_id": 1905,
    "vorder": 35,
    "position": 0,
    "text": "چنین گفت با باغبان باربد"
  },
  {
    "poem_id": 1905,
    "vorder": 36,
    "position": 1,
    "text": "که گویی تو جانی و من کالبد"
  },
  {
    "poem_id": 1905,
    "vorder": 37,
    "position": 0,
    "text": "کنون آرزو خواهم از تو یکی"
  },
  {
    "poem_id": 1905,
    "vorder": 38,
    "position": 1,
    "text": "کجاهست نزدیک تو اندکی"
  },
  {
    "poem_id": 1905,
    "vorder": 39,
    "position": 0,
    "text": "چو آید بدین باغ شاه جهان"
  },
  {
    "poem_id": 1905,
    "vorder": 40,
    "position": 1,
    "text": "مرا راه ده تاببینم نهان"
  },
  {
    "poem_id": 1905,
    "vorder": 41,
    "position": 0,
    "text": "که تاچون بود شاه را جشنگاه"
  },
  {
    "poem_id": 1905,
    "vorder": 42,
    "position": 1,
    "text": "ببینم نهفته یکی روی شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 43,
    "position": 0,
    "text": "بدو گفت مردوی کایدون کنم"
  },
  {
    "poem_id": 1905,
    "vorder": 44,
    "position": 1,
    "text": "ز مغز تو اندیشه بیرون کنم"
  },
  {
    "poem_id": 1905,
    "vorder": 45,
    "position": 0,
    "text": "چو خسرو همی‌خواست کاید بباغ"
  },
  {
    "poem_id": 1905,
    "vorder": 46,
    "position": 1,
    "text": "دل میزبان شد چو روشن چراغ"
  },
  {
    "poem_id": 1905,
    "vorder": 47,
    "position": 0,
    "text": "بر باربد شد بگفت آنک شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 48,
    "position": 1,
    "text": "همی‌رفت خواهد بران جشنگاه"
  },
  {
    "poem_id": 1905,
    "vorder": 49,
    "position": 0,
    "text": "همه جامه را باربد سبز کرد"
  },
  {
    "poem_id": 1905,
    "vorder": 50,
    "position": 1,
    "text": "همان بربط و رود ننگ و نبرد"
  },
  {
    "poem_id": 1905,
    "vorder": 51,
    "position": 0,
    "text": "بشد تابجایی که خسرو شدی"
  },
  {
    "poem_id": 1905,
    "vorder": 52,
    "position": 1,
    "text": "بهاران نشستن گهی نو شدی"
  },
  {
    "poem_id": 1905,
    "vorder": 53,
    "position": 0,
    "text": "یکی سرو بد سبز و برگش گشن"
  },
  {
    "poem_id": 1905,
    "vorder": 54,
    "position": 1,
    "text": "ورا شاخ چون رزمگاه پشن"
  },
  {
    "poem_id": 1905,
    "vorder": 55,
    "position": 0,
    "text": "بران سرو شد بربط اندر کنار"
  },
  {
    "poem_id": 1905,
    "vorder": 56,
    "position": 1,
    "text": "زمانی همی‌بود تا شهریار"
  },
  {
    "poem_id": 1905,
    "vorder": 57,
    "position": 0,
    "text": "ز ایوان بیامد بدان جشنگاه"
  },
  {
    "poem_id": 1905,
    "vorder": 58,
    "position": 1,
    "text": "بیاراست پیروزگر جای شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 59,
    "position": 0,
    "text": "بیامد پری چهرهٔ میگسار"
  },
  {
    "poem_id": 1905,
    "vorder": 60,
    "position": 1,
    "text": "یکی جام بر کف بر شهریار"
  },
  {
    "poem_id": 1905,
    "vorder": 61,
    "position": 0,
    "text": "جهاندار بستد ز کودک نبید"
  },
  {
    "poem_id": 1905,
    "vorder": 62,
    "position": 1,
    "text": "بلور از می سرخ شد ناپدید"
  },
  {
    "poem_id": 1905,
    "vorder": 63,
    "position": 0,
    "text": "بدانگه که خورشید برگشت زرد"
  },
  {
    "poem_id": 1905,
    "vorder": 64,
    "position": 1,
    "text": "همی‌بود تاگشت شب لاژورد"
  },
  {
    "poem_id": 1905,
    "vorder": 65,
    "position": 0,
    "text": "زننده بران سرو برداشت رود"
  },
  {
    "poem_id": 1905,
    "vorder": 66,
    "position": 1,
    "text": "همان ساخته پهلوانی سرود"
  },
  {
    "poem_id": 1905,
    "vorder": 67,
    "position": 0,
    "text": "یکی نغز دستان بزد بر درخت"
  },
  {
    "poem_id": 1905,
    "vorder": 68,
    "position": 1,
    "text": "کزان خیره شد مرد بیداربخت"
  },
  {
    "poem_id": 1905,
    "vorder": 69,
    "position": 0,
    "text": "سرودی به آواز خوش برکشید"
  },
  {
    "poem_id": 1905,
    "vorder": 70,
    "position": 1,
    "text": "که اکنون تو خوانیش داد آفرید"
  },
  {
    "poem_id": 1905,
    "vorder": 71,
    "position": 0,
    "text": "بماندند یک مجلس اندر شگفت"
  },
  {
    "poem_id": 1905,
    "vorder": 72,
    "position": 1,
    "text": "همی هرکسی رای دیگر گرفت"
  },
  {
    "poem_id": 1905,
    "vorder": 73,
    "position": 0,
    "text": "بدان نامداران بفرمود شاه"
  },
  {
    "poem_id": 1905,
    "vorder": 74,
    "position": 1,
    "text": "که جویند سرتاسر آن جشنگاه"
  },
  {
    "poem_id": 1905,
    "vorder": 75,
    "position": 0,
    "text": "فراوان بجستند و باز آمدند"
  },
  {
    "poem_id": 1905,
    "vorder": 76,
    "position": 1,
    "text": "به نزدیک خسرو فراز آمدند"
  },
  {
    "poem_id": 1905,
    "vorder": 77,
    "position": 0,
    "text": "جهاندیده آنگه ره اندر گرفت"
  },
  {
    "poem_id": 1905,
    "vorder": 78,
    "position": 1,
    "text": "که از بخت شاه این نباشد شگفت"
  },
  {
    "poem_id": 1905,
    "vorder": 79,
    "position": 0,
    "text": "که گردد گل سبز رامشگرش"
  },
  {
    "poem_id": 1905,
    "vorder": 80,
    "position": 1,
    "text": "که جاوید بادا سر و افسرش"
  },
  {
    "poem_id": 1905,
    "vorder": 81,
    "position": 0,
    "text": "بیاورد جامی دگر میگسار"
  },
  {
    "poem_id": 1905,
    "vorder": 82,
    "position": 1,
    "text": "چو از خوب رخ بستد آن شهریار"
  },
  {
    "poem_id": 1905,
    "vorder": 83,
    "position": 0,
    "text": "زننده دگرگون بیاراست رود"
  },
  {
    "poem_id": 1905,
    "vorder": 84,
    "position": 1,
    "text": "برآورد ناگاه دیگر سرود"
  },
  {
    "poem_id": 1905,
    "vorder": 85,
    "position": 0,
    "text": "که پیکار گردش همی‌خواندند"
  },
  {
    "poem_id": 1905,
    "vorder": 86,
    "position": 1,
    "text": "چنین نام ز آواز او راندند"
  },
  {
    "poem_id": 1905,
    "vorder": 87,
    "position": 0,
    "text": "چو آن دانشی گفت و خسرو شنید"
  },
  {
    "poem_id": 1905,
    "vorder": 88,
    "position": 1,
    "text": "به آواز او جام می در کشید"
  },
  {
    "poem_id": 1905,
    "vorder": 89,
    "position": 0,
    "text": "بفرمود کاین رابجای آورید"
  },
  {
    "poem_id": 1905,
    "vorder": 90,
    "position": 1,
    "text": "همه باغ یک سر به پای آورید"
  },
  {
    "poem_id": 1905,
    "vorder": 91,
    "position": 0,
    "text": "بجستند بسیار هر سوی باغ"
  },
  {
    "poem_id": 1905,
    "vorder": 92,
    "position": 1,
    "text": "ببردند زیر درختان چراغ"
  },
  {
    "poem_id": 1905,
    "vorder": 93,
    "position": 0,
    "text": "ندیدند چیزی جز از بید و سرو"
  },
  {
    "poem_id": 1905,
    "vorder": 94,
    "position": 1,
    "text": "خرامان به زیر گل اندر تذرو"
  },
  {
    "poem_id": 1905,
    "vorder": 95,
    "position": 0,
    "text": "شهنشاه پس جام دیگر بخواست"
  },
  {
    "poem_id": 1905,
    "vorder": 96,
    "position": 1,
    "text": "بر آواز سربرآورد راست"
  },
  {
    "poem_id": 1905,
    "vorder": 97,
    "position": 0,
    "text": "برآمد دگر باره بانگ سرود"
  },
  {
    "poem_id": 1905,
    "vorder": 98,
    "position": 1,
    "text": "همان ساخته کرده آواز رود"
  },
  {
    "poem_id": 1905,
    "vorder": 99,
    "position": 0,
    "text": "همی سبز در سبز خوانی کنون"
  },
  {
    "poem_id": 1905,
    "vorder": 100,
    "position": 1,
    "text": "برین گونه سازند مکر و فسون"
  },
  {
    "poem_id": 1905,
    "vorder": 101,
    "position": 0,
    "text": "چوبشنید پرویز برپای خاست"
  },
  {
    "poem_id": 1905,
    "vorder": 102,
    "position": 1,
    "text": "به آواز او بر یکی جام خواست"
  },
  {
    "poem_id": 1905,
    "vorder": 103,
    "position": 0,
    "text": "که بود اندر آن جام یک من نبید"
  },
  {
    "poem_id": 1905,
    "vorder": 104,
    "position": 1,
    "text": "به یکدم می روشن اندر کشید"
  },
  {
    "poem_id": 1905,
    "vorder": 105,
    "position": 0,
    "text": "چنین گفت کاین گر فرشته بدی"
  },
  {
    "poem_id": 1905,
    "vorder": 106,
    "position": 1,
    "text": "ز مشک و زعنبر سرشته بدی"
  },
  {
    "poem_id": 1905,
    "vorder": 107,
    "position": 0,
    "text": "وگر دیو بودی نگفتی سرود"
  },
  {
    "poem_id": 1905,
    "vorder": 108,
    "position": 1,
    "text": "همان نیز نشناختی زخم رود"
  },
  {
    "poem_id": 1905,
    "vorder": 109,
    "position": 0,
    "text": "بجویید درباغ تا این کجاست"
  },
  {
    "poem_id": 1905,
    "vorder": 110,
    "position": 1,
    "text": "همه باغ و گلشن چپ و دست راست"
  },
  {
    "poem_id": 1905,
    "vorder": 111,
    "position": 0,
    "text": "دهان و برش پر ز گوهر کنم"
  },
  {
    "poem_id": 1905,
    "vorder": 112,
    "position": 1,
    "text": "برین رود سازانش مهتر کنم"
  },
  {
    "poem_id": 1905,
    "vorder": 113,
    "position": 0,
    "text": "چو بشنید رامشگر آواز اوی"
  },
  {
    "poem_id": 1905,
    "vorder": 114,
    "position": 1,
    "text": "همان خوب گفتار دمساز اوی"
  },
  {
    "poem_id": 1905,
    "vorder": 115,
    "position": 0,
    "text": "فرود آمد از شاخ سرو سهی"
  },
  {
    "poem_id": 1905,
    "vorder": 116,
    "position": 1,
    "text": "همی‌رفت با رامش و فرهی"
  },
  {
    "poem_id": 1905,
    "vorder": 117,
    "position": 0,
    "text": "بیامد بمالید برخاک روی"
  },
  {
    "poem_id": 1905,
    "vorder": 118,
    "position": 1,
    "text": "بدو گفت خسرو چه مردی بگوی"
  },
  {
    "poem_id": 1905,
    "vorder": 119,
    "position": 0,
    "text": "بدو گفت شاهایکی بنده‌ام"
  },
  {
    "poem_id": 1905,
    "vorder": 120,
    "position": 1,
    "text": "به آواز تو در جهان زنده‌ام"
  },
  {
    "poem_id": 1905,
    "vorder": 121,
    "position": 0,
    "text": "سراسر بگفت آنچ بود از بنه"
  },
  {
    "poem_id": 1905,
    "vorder": 122,
    "position": 1,
    "text": "که رفت اندر آن یک دل و یک تنه"
  },
  {
    "poem_id": 1905,
    "vorder": 123,
    "position": 0,
    "text": "بدیدار او شاد شد شهریار"
  },
  {
    "poem_id": 1905,
    "vorder": 124,
    "position": 1,
    "text": "بسان گلستان به ماه بهار"
  },
  {
    "poem_id": 1905,
    "vorder": 125,
    "position": 0,
    "text": "به سرکش چنین گفت کای بد هنر"
  },
  {
    "poem_id": 1905,
    "vorder": 126,
    "position": 1,
    "text": "تو چون حنظلی باربد چون شکر"
  },
  {
    "poem_id": 1905,
    "vorder": 127,
    "position": 0,
    "text": "چرا دور کردی تو او را ز من"
  },
  {
    "poem_id": 1905,
    "vorder": 128,
    "position": 1,
    "text": "دریغ آمدت او درین انجمن"
  },
  {
    "poem_id": 1905,
    "vorder": 129,
    "position": 0,
    "text": "به آواز او شاد می درکشید"
  },
  {
    "poem_id": 1905,
    "vorder": 130,
