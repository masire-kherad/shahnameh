[
  {
    "poem_id": 88083,
    "vorder": 1,
    "position": 0,
    "text": "از آن پس چنان بد که افراسیاب"
  },
  {
    "poem_id": 88083,
    "vorder": 2,
    "position": 1,
    "text": "همی بود هر جای بی‌خورد و خواب"
  },
  {
    "poem_id": 88083,
    "vorder": 3,
    "position": 0,
    "text": "نه ایمن به جان و نه تن سودمند"
  },
  {
    "poem_id": 88083,
    "vorder": 4,
    "position": 1,
    "text": "هراسان همیشه ز بیم گزند"
  },
  {
    "poem_id": 88083,
    "vorder": 5,
    "position": 0,
    "text": "همی از جهان جایگاهی بجست"
  },
  {
    "poem_id": 88083,
    "vorder": 6,
    "position": 1,
    "text": "که باشد به جان ایمن و تن‌درست"
  },
  {
    "poem_id": 88083,
    "vorder": 7,
    "position": 0,
    "text": "به نزدیک بردع یکی غار بود"
  },
  {
    "poem_id": 88083,
    "vorder": 8,
    "position": 1,
    "text": "سر کوه غار از جهان نابسود"
  },
  {
    "poem_id": 88083,
    "vorder": 9,
    "position": 0,
    "text": "ندید از برش جای پرواز باز"
  },
  {
    "poem_id": 88083,
    "vorder": 10,
    "position": 1,
    "text": "نه زیرش پی شیر و آن گراز"
  },
  {
    "poem_id": 88083,
    "vorder": 11,
    "position": 0,
    "text": "خورش برد وز بیم جان جای ساخت"
  },
  {
    "poem_id": 88083,
    "vorder": 12,
    "position": 1,
    "text": "به غار اندرون جای بالای ساخت"
  },
  {
    "poem_id": 88083,
    "vorder": 13,
    "position": 0,
    "text": "ز هر شهر دور و به نزدیک آب"
  },
  {
    "poem_id": 88083,
    "vorder": 14,
    "position": 1,
    "text": "که خوانی ورا هنگ افراسیاب"
  },
  {
    "poem_id": 88083,
    "vorder": 15,
    "position": 0,
    "text": "همی بود چندی به هنگ اندرون"
  },
  {
    "poem_id": 88083,
    "vorder": 16,
    "position": 1,
    "text": "ز کرده پشیمان و دل پر ز خون"
  },
  {
    "poem_id": 88083,
    "vorder": 17,
    "position": 0,
    "text": "چو خونریز گردد سر سرفراز"
  },
  {
    "poem_id": 88083,
    "vorder": 18,
    "position": 1,
    "text": "به تخت کیان برنماند دراز"
  },
  {
    "poem_id": 88083,
    "vorder": 19,
    "position": 0,
    "text": "یکی مرد نیک اندر آن روزگار"
  },
  {
    "poem_id": 88083,
    "vorder": 20,
    "position": 1,
    "text": "ز تخم فریدون آموزگار"
  },
  {
    "poem_id": 88083,
    "vorder": 21,
    "position": 0,
    "text": "پرستار با فر و برز کیان"
  },
  {
    "poem_id": 88083,
    "vorder": 22,
    "position": 1,
    "text": "به هر کار با شاه‌ بسته میان"
  },
  {
    "poem_id": 88083,
    "vorder": 23,
    "position": 0,
    "text": "پرستشگهش کوه بودی همه"
  },
  {
    "poem_id": 88083,
    "vorder": 24,
    "position": 1,
    "text": "ز شادی شده دور و دور از رمه"
  },
  {
    "poem_id": 88083,
    "vorder": 25,
    "position": 0,
    "text": "کجا نام این نامور هوم بود"
  },
  {
    "poem_id": 88083,
    "vorder": 26,
    "position": 1,
    "text": "پرستنده دور از بر و بوم بود"
  },
  {
    "poem_id": 88083,
    "vorder": 27,
    "position": 0,
    "text": "یکی کاخ بود اندر آن برز کوه"
  },
  {
    "poem_id": 88083,
    "vorder": 28,
    "position": 1,
    "text": "بدو سخت نزدیک و دور از گروه"
  },
  {
    "poem_id": 88083,
    "vorder": 29,
    "position": 0,
    "text": "پرستشگهی کرده پشمینه پوش"
  },
  {
    "poem_id": 88083,
    "vorder": 30,
    "position": 1,
    "text": "ز کافش یکی ناله آمد به گوش"
  },
  {
    "poem_id": 88083,
    "vorder": 31,
    "position": 0,
    "text": "که شاها سرا نامور مهترا"
  },
  {
    "poem_id": 88083,
    "vorder": 32,
    "position": 1,
    "text": "بزرگان و بر داوران داورا"
  },
  {
    "poem_id": 88083,
    "vorder": 33,
    "position": 0,
    "text": "همه ترک و چین زیر فرمان تو"
  },
  {
    "poem_id": 88083,
    "vorder": 34,
    "position": 1,
    "text": "رسیده به هر جای پیمان تو"
  },
  {
    "poem_id": 88083,
    "vorder": 35,
    "position": 0,
    "text": "یکی غار داری به بهره به چنگ"
  },
  {
    "poem_id": 88083,
    "vorder": 36,
    "position": 1,
    "text": "کجات آن سر تاج و مردان جنگ"
  },
  {
    "poem_id": 88083,
    "vorder": 37,
    "position": 0,
    "text": "کجات آن همه زور و مردانگی"
  },
  {
    "poem_id": 88083,
    "vorder": 38,
    "position": 1,
    "text": "دلیری و نیروی و فرزانگی"
  },
  {
    "poem_id": 88083,
    "vorder": 39,
    "position": 0,
    "text": "کجات آن بزرگی و تخت و کلاه"
  },
  {
    "poem_id": 88083,
    "vorder": 40,
    "position": 1,
    "text": "کجات آن بر و بوم و چندان سپاه"
  },
  {
    "poem_id": 88083,
    "vorder": 41,
    "position": 0,
    "text": "که اکنون بدین تنگ غار اندری"
  },
  {
    "poem_id": 88083,
    "vorder": 42,
    "position": 1,
    "text": "گریزان به سنگین حصار اندری"
  },
  {
    "poem_id": 88083,
    "vorder": 43,
    "position": 0,
    "text": "به ترکی چو این ناله بشنید هوم"
  },
  {
    "poem_id": 88083,
    "vorder": 44,
    "position": 1,
    "text": "پرستش رها کرد و بگذاشت بوم"
  },
  {
    "poem_id": 88083,
    "vorder": 45,
    "position": 0,
    "text": "چنین گفت کاین ناله هنگام خواب"
  },
  {
    "poem_id": 88083,
    "vorder": 46,
    "position": 1,
    "text": "نباشد مگر آن افراسیاب"
  },
  {
    "poem_id": 88083,
    "vorder": 47,
    "position": 0,
    "text": "چو اندیشه شد بر دلش بر درست"
  },
  {
    "poem_id": 88083,
    "vorder": 48,
    "position": 1,
    "text": "در غار تاریک چندی بجست"
  },
  {
    "poem_id": 88083,
    "vorder": 49,
    "position": 0,
    "text": "ز کوه اندر آمد به هنگام خواب"
  },
  {
    "poem_id": 88083,
    "vorder": 50,
    "position": 1,
    "text": "بدید آن در هنگ افراسیاب"
  },
  {
    "poem_id": 88083,
    "vorder": 51,
    "position": 0,
    "text": "بیامد به کردار شیر ژیان"
  },
  {
    "poem_id": 88083,
    "vorder": 52,
    "position": 1,
    "text": "ز پشمینه بگشاد گردی میان"
  },
  {
    "poem_id": 88083,
    "vorder": 53,
    "position": 0,
    "text": "کمندی که بر جای زنار داشت"
  },
  {
    "poem_id": 88083,
    "vorder": 54,
    "position": 1,
    "text": "کجا در پناه جهاندار داشت"
  },
  {
    "poem_id": 88083,
    "vorder": 55,
    "position": 0,
    "text": "به هنگ اندرون شد گرفت آن به دست"
  },
  {
    "poem_id": 88083,
    "vorder": 56,
    "position": 1,
    "text": "چو نزدیک شد بازوی او ببست"
  },
  {
    "poem_id": 88083,
    "vorder": 57,
    "position": 0,
    "text": "همی رفت و او را پس اندر کشان"
  },
  {
    "poem_id": 88083,
    "vorder": 58,
    "position": 1,
    "text": "همی تاخت با رنج چون بیهشان"
  },
  {
    "poem_id": 88083,
    "vorder": 59,
    "position": 0,
    "text": "شگفت ار بمانی بدین در رواست"
  },
  {
    "poem_id": 88083,
    "vorder": 60,
    "position": 1,
    "text": "هر آن کس که او بر جهان پادشاست"
  },
  {
    "poem_id": 88083,
    "vorder": 61,
    "position": 0,
    "text": "جز از نیک‌نامی نباید گزید"
  },
  {
    "poem_id": 88083,
    "vorder": 62,
    "position": 1,
    "text": "بباید چمید و بباید چرید"
  },
  {
    "poem_id": 88083,
    "vorder": 63,
    "position": 0,
    "text": "ز گیتی یک غار بگزید راست"
  },
  {
    "poem_id": 88083,
    "vorder": 64,
    "position": 1,
    "text": "چه دانست کان غار هنگ بلاست"
  },
  {
    "poem_id": 88083,
    "vorder": 65,
    "position": 0,
    "text": "چو آن شاه را هوم بازو ببست"
  },
  {
    "poem_id": 88083,
    "vorder": 66,
    "position": 1,
    "text": "همی بردش از جایگاه نشست"
  },
  {
    "poem_id": 88083,
    "vorder": 67,
    "position": 0,
    "text": "بدو گفت کای مرد باهوش و باک"
  },
  {
    "poem_id": 88083,
    "vorder": 68,
    "position": 1,
    "text": "پرستار دارنده یزدان پاک"
  },
  {
    "poem_id": 88083,
    "vorder": 69,
    "position": 0,
    "text": "چه خواهی ز من من کییم در جهان"
  },
  {
    "poem_id": 88083,
    "vorder": 70,
    "position": 1,
    "text": "نشسته بدین غار با اندهان"
  },
  {
    "poem_id": 88083,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت هوم این نه آرام تست"
  },
  {
    "poem_id": 88083,
    "vorder": 72,
    "position": 1,
    "text": "جهانی سراسر پر از نام تست"
  },
  {
    "poem_id": 88083,
    "vorder": 73,
    "position": 0,
    "text": "ز شاهان گیتی برادر که کشت"
  },
  {
    "poem_id": 88083,
    "vorder": 74,
    "position": 1,
    "text": "که شد نیز با پاک یزدان درشت"
  },
  {
    "poem_id": 88083,
    "vorder": 75,
    "position": 0,
    "text": "چو اغریرث و نوذر نامدار"
  },
  {
    "poem_id": 88083,
    "vorder": 76,
    "position": 1,
    "text": "سیاوش که بد در جهان یادگار"
  },
  {
    "poem_id": 88083,
    "vorder": 77,
    "position": 0,
    "text": "تو خون سر بیگناهان مریز"
  },
  {
    "poem_id": 88083,
    "vorder": 78,
    "position": 1,
    "text": "نه اندر بن غار بی‌بن گریز"
  },
  {
    "poem_id": 88083,
    "vorder": 79,
    "position": 0,
    "text": "بدو گفت کاندر جهان بیگناه"
  },
  {
    "poem_id": 88083,
    "vorder": 80,
    "position": 1,
    "text": "که را دانی ای مرد با دستگاه"
  },
  {
    "poem_id": 88083,
    "vorder": 81,
    "position": 0,
    "text": "چنین راند بر سر سپهر بلند"
  },
  {
    "poem_id": 88083,
    "vorder": 82,
    "position": 1,
    "text": "که آید ز من درد و رنج و گزند"
  },
  {
    "poem_id": 88083,
    "vorder": 83,
    "position": 0,
    "text": "ز فرمان یزدان کسی نگذرد"
  },
  {
    "poem_id": 88083,
    "vorder": 84,
    "position": 1,
    "text": "وگر دیده اژدها بسپرد"
  },
  {
    "poem_id": 88083,
    "vorder": 85,
    "position": 0,
    "text": "ببخشای بر من که بیچاره‌ام"
  },
  {
    "poem_id": 88083,
    "vorder": 86,
    "position": 1,
    "text": "وگر چند بر خود ستمکاره‌ام"
  },
  {
    "poem_id": 88083,
    "vorder": 87,
    "position": 0,
    "text": "نبیره فریدون فرخ منم"
  },
  {
    "poem_id": 88083,
    "vorder": 88,
    "position": 1,
    "text": "ز بند کمندت همی بگسلم"
  },
  {
    "poem_id": 88083,
    "vorder": 89,
    "position": 0,
    "text": "کجا برد خواهی مرا بسته خوار"
  },
  {
    "poem_id": 88083,
    "vorder": 90,
    "position": 1,
    "text": "نترسی ز یزدان به روز شمار"
  },
  {
    "poem_id": 88083,
    "vorder": 91,
    "position": 0,
    "text": "بدو گفت هوم ای بد بدگمان"
  },
  {
    "poem_id": 88083,
    "vorder": 92,
    "position": 1,
    "text": "همانا فراوان نماندت زمان"
  },
  {
    "poem_id": 88083,
    "vorder": 93,
    "position": 0,
    "text": "سخنهات چون گلستان نوست"
  },
  {
    "poem_id": 88083,
    "vorder": 94,
    "position": 1,
    "text": "ترا هوش بر دست کیخسروست"
  },
  {
    "poem_id": 88083,
    "vorder": 95,
    "position": 0,
    "text": "بپیچید دل هوم را زآن گزند"
  },
  {
    "poem_id": 88083,
    "vorder": 96,
    "position": 1,
    "text": "بر او سست کرد آن کیانی کمند"
  },
  {
    "poem_id": 88083,
    "vorder": 97,
    "position": 0,
    "text": "بدانست کان مرد پرهیزگار"
  },
  {
    "poem_id": 88083,
    "vorder": 98,
    "position": 1,
    "text": "ببخشود بر ناله شهریار"
  },
  {
    "poem_id": 88083,
    "vorder": 99,
    "position": 0,
    "text": "بپیچید و ز او خویشتن درکشید"
  },
  {
    "poem_id": 88083,
    "vorder": 100,
    "position": 1,
    "text": "به دریا درون جست و شد ناپدید"
  }
]