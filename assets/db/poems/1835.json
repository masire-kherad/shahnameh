    "vorder": 406,
    "position": 1,
    "text": "بخواهی ربودن ز من سر همی"
  },
  {
    "poem_id": 1835,
    "vorder": 407,
    "position": 0,
    "text": "بدو گفت بهرام کای ترک زاد"
  },
  {
    "poem_id": 1835,
    "vorder": 408,
    "position": 1,
    "text": "به خون ریختن تا نباشی تو شاد"
  },
  {
    "poem_id": 1835,
    "vorder": 409,
    "position": 0,
    "text": "توخاقان نژادی نه از کیقباد"
  },
  {
    "poem_id": 1835,
    "vorder": 410,
    "position": 1,
    "text": "که کسری تو را تاج بر سر نهاد"
  }
