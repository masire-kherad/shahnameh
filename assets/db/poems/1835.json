[
  {
    "poem_id": 1835,
    "vorder": 1,
    "position": 0,
    "text": "یکی پیر بد مرزبان هری"
  },
  {
    "poem_id": 1835,
    "vorder": 2,
    "position": 1,
    "text": "پسندیده و دیده ازهر دری"
  },
  {
    "poem_id": 1835,
    "vorder": 3,
    "position": 0,
    "text": "جهاندیده‌ای نام او بود ماخ"
  },
  {
    "poem_id": 1835,
    "vorder": 4,
    "position": 1,
    "text": "سخن‌دان و با فر و با یال و شاخ"
  },
  {
    "poem_id": 1835,
    "vorder": 5,
    "position": 0,
    "text": "بپرسیدمش تا چه داری بیاد"
  },
  {
    "poem_id": 1835,
    "vorder": 6,
    "position": 1,
    "text": "ز هرمز که بنشست بر تخت داد"
  },
  {
    "poem_id": 1835,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت پیرخراسان که شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 8,
    "position": 1,
    "text": "چو بنشست بر نامور پیشگاه"
  },
  {
    "poem_id": 1835,
    "vorder": 9,
    "position": 0,
    "text": "نخست آفرین کرد بر کردگار"
  },
  {
    "poem_id": 1835,
    "vorder": 10,
    "position": 1,
    "text": "توانا و داننده روزگار"
  },
  {
    "poem_id": 1835,
    "vorder": 11,
    "position": 0,
    "text": "دگر گفت ما تخت نامی کنیم"
  },
  {
    "poem_id": 1835,
    "vorder": 12,
    "position": 1,
    "text": "گرانمایگان را گرامی کنیم"
  },
  {
    "poem_id": 1835,
    "vorder": 13,
    "position": 0,
    "text": "جهان را بداریم در زیر پر"
  },
  {
    "poem_id": 1835,
    "vorder": 14,
    "position": 1,
    "text": "چنان چون پدر داشت با داد و فر"
  },
  {
    "poem_id": 1835,
    "vorder": 15,
    "position": 0,
    "text": "گنه کردگانرا هراسان کنیم"
  },
  {
    "poem_id": 1835,
    "vorder": 16,
    "position": 1,
    "text": "ستم دیدگان را تن آسان کنیم"
  },
  {
    "poem_id": 1835,
    "vorder": 17,
    "position": 0,
    "text": "ستون بزرگیست آهستگی"
  },
  {
    "poem_id": 1835,
    "vorder": 18,
    "position": 1,
    "text": "همان بخشش و داد و شایستگی"
  },
  {
    "poem_id": 1835,
    "vorder": 19,
    "position": 0,
    "text": "بدانید کز کردگار جهان"
  },
  {
    "poem_id": 1835,
    "vorder": 20,
    "position": 1,
    "text": "بد و نیک هرگز نماند نهان"
  },
  {
    "poem_id": 1835,
    "vorder": 21,
    "position": 0,
    "text": "نیاگان ما تاجداران دهر"
  },
  {
    "poem_id": 1835,
    "vorder": 22,
    "position": 1,
    "text": "که از دادشان آفرین بود بهر"
  },
  {
    "poem_id": 1835,
    "vorder": 23,
    "position": 0,
    "text": "نجستند جز داد و بایستگی"
  },
  {
    "poem_id": 1835,
    "vorder": 24,
    "position": 1,
    "text": "بزرگی و گردی و شایستگی"
  },
  {
    "poem_id": 1835,
    "vorder": 25,
    "position": 0,
    "text": "ز کهتر پرستش ز مهتر نواز"
  },
  {
    "poem_id": 1835,
    "vorder": 26,
    "position": 1,
    "text": "بداندیش را داشتن در گداز"
  },
  {
    "poem_id": 1835,
    "vorder": 27,
    "position": 0,
    "text": "بهرکشوری دست و فرمان مراست"
  },
  {
    "poem_id": 1835,
    "vorder": 28,
    "position": 1,
    "text": "توانایی و داد و پیمان مراست"
  },
  {
    "poem_id": 1835,
    "vorder": 29,
    "position": 0,
    "text": "کسی را که یزدان کند پادشا"
  },
  {
    "poem_id": 1835,
    "vorder": 30,
    "position": 1,
    "text": "بنازد بدو مردم پارسا"
  },
  {
    "poem_id": 1835,
    "vorder": 31,
    "position": 0,
    "text": "که سرمایه شاه بخشایشست"
  },
  {
    "poem_id": 1835,
    "vorder": 32,
    "position": 1,
    "text": "زمانه ز بخشش به آسایشست"
  },
  {
    "poem_id": 1835,
    "vorder": 33,
    "position": 0,
    "text": "به درویش برمهربانی کنیم"
  },
  {
    "poem_id": 1835,
    "vorder": 34,
    "position": 1,
    "text": "بپرمایه بر پاسبانی کنیم"
  },
  {
    "poem_id": 1835,
    "vorder": 35,
    "position": 0,
    "text": "هرآنکس که ایمن شد از کار خویش"
  },
  {
    "poem_id": 1835,
    "vorder": 36,
    "position": 1,
    "text": "برما چنان کرد بازار خویش"
  },
  {
    "poem_id": 1835,
    "vorder": 37,
    "position": 0,
    "text": "شما را بمن هرچ هست آرزوی"
  },
  {
    "poem_id": 1835,
    "vorder": 38,
    "position": 1,
    "text": "مدارید راز از دل نیکخوی"
  },
  {
    "poem_id": 1835,
    "vorder": 39,
    "position": 0,
    "text": "ز چیزی که دلتان هراسان بود"
  },
  {
    "poem_id": 1835,
    "vorder": 40,
    "position": 1,
    "text": "مرا داد آن دادن آسان بود"
  },
  {
    "poem_id": 1835,
    "vorder": 41,
    "position": 0,
    "text": "هرآنکس که هست از شما نیکبخت"
  },
  {
    "poem_id": 1835,
    "vorder": 42,
    "position": 1,
    "text": "همه شاد باشید زین تاج وتخت"
  },
  {
    "poem_id": 1835,
    "vorder": 43,
    "position": 0,
    "text": "میان بزرگان درخشش مراست"
  },
  {
    "poem_id": 1835,
    "vorder": 44,
    "position": 1,
    "text": "چوبخشایش داد و بخشش مراست"
  },
  {
    "poem_id": 1835,
    "vorder": 45,
    "position": 0,
    "text": "شما مهربانی بافزون کنید"
  },
  {
    "poem_id": 1835,
    "vorder": 46,
    "position": 1,
    "text": "ز دل کینه و آز بیرون کنید"
  },
  {
    "poem_id": 1835,
    "vorder": 47,
    "position": 0,
    "text": "هر آنکس که پرهیز کرد از دو کار"
  },
  {
    "poem_id": 1835,
    "vorder": 48,
    "position": 1,
    "text": "نبیند دو چشمش بد روزگار"
  },
  {
    "poem_id": 1835,
    "vorder": 49,
    "position": 0,
    "text": "بخشنودی کردگار جهان"
  },
  {
    "poem_id": 1835,
    "vorder": 50,
    "position": 1,
    "text": "بکوشید یکسر کهان و مهان"
  },
  {
    "poem_id": 1835,
    "vorder": 51,
    "position": 0,
    "text": "دگر آنک مغزش بود پرخرد"
  },
  {
    "poem_id": 1835,
    "vorder": 52,
    "position": 1,
    "text": "سوی ناسپاسی دلش ننگرد"
  },
  {
    "poem_id": 1835,
    "vorder": 53,
    "position": 0,
    "text": "چو نیکی فزایی بروی کسان"
  },
  {
    "poem_id": 1835,
    "vorder": 54,
    "position": 1,
    "text": "بود مزد آن سوی تو نارسان"
  },
  {
    "poem_id": 1835,
    "vorder": 55,
    "position": 0,
    "text": "میامیز با مردم کژ گوی"
  },
  {
    "poem_id": 1835,
    "vorder": 56,
    "position": 1,
    "text": "که او را نباشد سخن جز بروی"
  },
  {
    "poem_id": 1835,
    "vorder": 57,
    "position": 0,
    "text": "وگر شهریارت بود دادگر"
  },
  {
    "poem_id": 1835,
    "vorder": 58,
    "position": 1,
    "text": "تو بر وی بسستی گمانی مبر"
  },
  {
    "poem_id": 1835,
    "vorder": 59,
    "position": 0,
    "text": "گر ای دون که گویی نداند همی"
  },
  {
    "poem_id": 1835,
    "vorder": 60,
    "position": 1,
    "text": "سخنهای شاهان بخواند همی"
  },
  {
    "poem_id": 1835,
    "vorder": 61,
    "position": 0,
    "text": "چو بخشایش از دل کند شهریار"
  },
  {
    "poem_id": 1835,
    "vorder": 62,
    "position": 1,
    "text": "تو اندر زمین تخم کژی مکار"
  },
  {
    "poem_id": 1835,
    "vorder": 63,
    "position": 0,
    "text": "هرآنکس که او پند ما داشت خوار"
  },
  {
    "poem_id": 1835,
    "vorder": 64,
    "position": 1,
    "text": "بشوید دل از خوبی روزگار"
  },
  {
    "poem_id": 1835,
    "vorder": 65,
    "position": 0,
    "text": "چوشاه از تو خشنود شد راستیست"
  },
  {
    "poem_id": 1835,
    "vorder": 66,
    "position": 1,
    "text": "وزو سر بپیچی درکاستیست"
  },
  {
    "poem_id": 1835,
    "vorder": 67,
    "position": 0,
    "text": "درشتیش نرمیست در پند تو"
  },
  {
    "poem_id": 1835,
    "vorder": 68,
    "position": 1,
    "text": "بجوید که شد گرم پیوند تو"
  },
  {
    "poem_id": 1835,
    "vorder": 69,
    "position": 0,
    "text": "ز نیکی مپرهیز هرگز به رنج"
  },
  {
    "poem_id": 1835,
    "vorder": 70,
    "position": 1,
    "text": "مکن شادمان دل به بیداد گنج"
  },
  {
    "poem_id": 1835,
    "vorder": 71,
    "position": 0,
    "text": "چو اندر جهان کام دل یافتی"
  },
  {
    "poem_id": 1835,
    "vorder": 72,
    "position": 1,
    "text": "رسیدی بجایی که بشتافتی"
  },
  {
    "poem_id": 1835,
    "vorder": 73,
    "position": 0,
    "text": "چو دیهیم هفتاد بر سرنهی"
  },
  {
    "poem_id": 1835,
    "vorder": 74,
    "position": 1,
    "text": "همه گرد کرده به دشمن دهی"
  },
  {
    "poem_id": 1835,
    "vorder": 75,
    "position": 0,
    "text": "بهر کار درویش دارد دلم"
  },
  {
    "poem_id": 1835,
    "vorder": 76,
    "position": 1,
    "text": "نخواهم که اندیشه زو بگسلم"
  },
  {
    "poem_id": 1835,
    "vorder": 77,
    "position": 0,
    "text": "همی‌خواهم از پاک پروردگار"
  },
  {
    "poem_id": 1835,
    "vorder": 78,
    "position": 1,
    "text": "که چندان مرا بر دهد روزگار"
  },
  {
    "poem_id": 1835,
    "vorder": 79,
    "position": 0,
    "text": "که درویش را شاد دارم به گنج"
  },
  {
    "poem_id": 1835,
    "vorder": 80,
    "position": 1,
    "text": "نیارم دل پارسا را به رنج"
  },
  {
    "poem_id": 1835,
    "vorder": 81,
    "position": 0,
    "text": "هرآنکس که شد در جهان شاه فش"
  },
  {
    "poem_id": 1835,
    "vorder": 82,
    "position": 1,
    "text": "سرش گردد از گنج دینار کش"
  },
  {
    "poem_id": 1835,
    "vorder": 83,
    "position": 0,
    "text": "سرش را بپیچم ز کنداوری"
  },
  {
    "poem_id": 1835,
    "vorder": 84,
    "position": 1,
    "text": "نباید که جوید کسی مهتری"
  },
  {
    "poem_id": 1835,
    "vorder": 85,
    "position": 0,
    "text": "چنین است انجام و آغاز ما"
  },
  {
    "poem_id": 1835,
    "vorder": 86,
    "position": 1,
    "text": "سخن گفتن فاش و هم راز ما"
  },
  {
    "poem_id": 1835,
    "vorder": 87,
    "position": 0,
    "text": "درود جهان آفرین برشماست"
  },
  {
    "poem_id": 1835,
    "vorder": 88,
    "position": 1,
    "text": "خم چرخ گردان زمین شماست"
  },
  {
    "poem_id": 1835,
    "vorder": 89,
    "position": 0,
    "text": "چو بشنید گفتار او انجمن"
  },
  {
    "poem_id": 1835,
    "vorder": 90,
    "position": 1,
    "text": "پر اندیشه گشتند زان تن بتن"
  },
  {
    "poem_id": 1835,
    "vorder": 91,
    "position": 0,
    "text": "سرگنج داران پر از بیم گشت"
  },
  {
    "poem_id": 1835,
    "vorder": 92,
    "position": 1,
    "text": "ستمکاره را دل به دو نیم گشت"
  },
  {
    "poem_id": 1835,
    "vorder": 93,
    "position": 0,
    "text": "خردمند ودرویش زان هرک بود"
  },
  {
    "poem_id": 1835,
    "vorder": 94,
    "position": 1,
    "text": "به دل‌ش اندرون شادمانی فزود"
  },
  {
    "poem_id": 1835,
    "vorder": 95,
    "position": 0,
    "text": "چنین بود تا شد بزرگیش راست"
  },
  {
    "poem_id": 1835,
    "vorder": 96,
    "position": 1,
    "text": "هرآن چیز درپادشاهی که خواست"
  },
  {
    "poem_id": 1835,
    "vorder": 97,
    "position": 0,
    "text": "برآشفت وخوی بد آورد پیش"
  },
  {
    "poem_id": 1835,
    "vorder": 98,
    "position": 1,
    "text": "به یکسو شد از راه آیین وکیش"
  },
  {
    "poem_id": 1835,
    "vorder": 99,
    "position": 0,
    "text": "هرآنکس که نزد پدرش ارجمند"
  },
  {
    "poem_id": 1835,
    "vorder": 100,
    "position": 1,
    "text": "بدی شاد و ایمن زبیم گزند"
  },
  {
    "poem_id": 1835,
    "vorder": 101,
    "position": 0,
    "text": "یکایک تبه کردشان بی‌گناه"
  },
  {
    "poem_id": 1835,
    "vorder": 102,
    "position": 1,
    "text": "بدین گونه بد رای و آیین شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 103,
    "position": 0,
    "text": "سه مرد از دبیران نوشین روان"
  },
  {
    "poem_id": 1835,
    "vorder": 104,
    "position": 1,
    "text": "یکی پیر ودانا و دیگر جوان"
  },
  {
    "poem_id": 1835,
    "vorder": 105,
    "position": 0,
    "text": "چو ایزد گشسب و دگر برزمهر"
  },
  {
    "poem_id": 1835,
    "vorder": 106,
    "position": 1,
    "text": "دبیر خردمند با فر وچهر"
  },
  {
    "poem_id": 1835,
    "vorder": 107,
    "position": 0,
    "text": "سه دیگر که ماه آذرش بود نام"
  },
  {
    "poem_id": 1835,
    "vorder": 108,
    "position": 1,
    "text": "خردمند و روشن دل و شادکام"
  },
  {
    "poem_id": 1835,
    "vorder": 109,
    "position": 0,
    "text": "برتخت نوشین روان این سه پیر"
  },
  {
    "poem_id": 1835,
    "vorder": 110,
    "position": 1,
    "text": "چو دستور بودند وهمچون وزیر"
  },
  {
    "poem_id": 1835,
    "vorder": 111,
    "position": 0,
    "text": "همی‌خواست هرمز کزین هرسه مرد"
  },
  {
    "poem_id": 1835,
    "vorder": 112,
    "position": 1,
    "text": "یکایک برآرد بناگاه گرد"
  },
  {
    "poem_id": 1835,
    "vorder": 113,
    "position": 0,
    "text": "همی‌بود ز ایشان دلش پرهراس"
  },
  {
    "poem_id": 1835,
    "vorder": 114,
    "position": 1,
    "text": "که روزی شوند اندرو ناسپاس"
  },
  {
    "poem_id": 1835,
    "vorder": 115,
    "position": 0,
    "text": "بایزد گشسب آن زمان دست آخت"
  },
  {
    "poem_id": 1835,
    "vorder": 116,
    "position": 1,
    "text": "به بیهوده بربند و زندانش ساخت"
  },
  {
    "poem_id": 1835,
    "vorder": 117,
    "position": 0,
    "text": "دل موبد موبدان تنگ شد"
  },
  {
    "poem_id": 1835,
    "vorder": 118,
    "position": 1,
    "text": "رخانش ز اندیشه بی‌رنگ شد"
  },
  {
    "poem_id": 1835,
    "vorder": 119,
    "position": 0,
    "text": "که موبد بد وپاک بودش سرشت"
  },
  {
    "poem_id": 1835,
    "vorder": 120,
    "position": 1,
    "text": "بمردی ورا نام بد زردهشت"
  },
  {
    "poem_id": 1835,
    "vorder": 121,
    "position": 0,
    "text": "ازان بند ایزدگشسب دبیر"
  },
  {
    "poem_id": 1835,
    "vorder": 122,
    "position": 1,
    "text": "چنان شد که دل خسته گردد به تیر"
  },
  {
    "poem_id": 1835,
    "vorder": 123,
    "position": 0,
    "text": "چو روزی برآمد نبودش زوار"
  },
  {
    "poem_id": 1835,
    "vorder": 124,
    "position": 1,
    "text": "نه خورد ونه پوشش نه انده گسار"
  },
  {
    "poem_id": 1835,
    "vorder": 125,
    "position": 0,
    "text": "ز زندان پیامی فرستاد دوست"
  },
  {
    "poem_id": 1835,
    "vorder": 126,
    "position": 1,
    "text": "به موبد که ای بنده را مغز و پوست"
  },
  {
    "poem_id": 1835,
    "vorder": 127,
    "position": 0,
    "text": "منم بی‌زواری به زندان شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 128,
    "position": 1,
    "text": "کسی را به نزدیک من نیست راه"
  },
  {
    "poem_id": 1835,
    "vorder": 129,
    "position": 0,
    "text": "همی خوردنی آرزوی آیدم"
  },
  {
    "poem_id": 1835,
    "vorder": 130,
    "position": 1,
    "text": "شکم گرسنه رنج بفزایدم"
  },
  {
    "poem_id": 1835,
    "vorder": 131,
    "position": 0,
    "text": "یکی خوردنی پاک پیشم فرست"
  },
  {
    "poem_id": 1835,
    "vorder": 132,
    "position": 1,
    "text": "دوایی بدین درد ریشم فرست"
  },
  {
    "poem_id": 1835,
    "vorder": 133,
    "position": 0,
    "text": "دل موبد از درد پیغام اوی"
  },
  {
    "poem_id": 1835,
    "vorder": 134,
    "position": 1,
    "text": "غمی گشت زان جای و آرام اوی"
  },
  {
    "poem_id": 1835,
    "vorder": 135,
    "position": 0,
    "text": "چنان داد پاسخ که از کار بند"
  },
  {
    "poem_id": 1835,
    "vorder": 136,
    "position": 1,
    "text": "منال ار نیاید به جانت گزند"
  },
  {
    "poem_id": 1835,
    "vorder": 137,
    "position": 0,
    "text": "ز پیغام اوشد دلش پرشکن"
  },
  {
    "poem_id": 1835,
    "vorder": 138,
    "position": 1,
    "text": "پراندیشه شد مغزش از خویشتن"
  },
  {
    "poem_id": 1835,
    "vorder": 139,
    "position": 0,
    "text": "به زندان فرستاد لختی خورش"
  },
  {
    "poem_id": 1835,
    "vorder": 140,
    "position": 1,
    "text": "بلرزید زان کار دل در برش"
  },
  {
    "poem_id": 1835,
    "vorder": 141,
    "position": 0,
    "text": "همی‌گفت کاکنون شود آگهی"
  },
  {
    "poem_id": 1835,
    "vorder": 142,
    "position": 1,
    "text": "بدین ناجوانمرد بی‌فرهی"
  },
  {
    "poem_id": 1835,
    "vorder": 143,
    "position": 0,
    "text": "که موبد به زندان فرستاد چیز"
  },
  {
    "poem_id": 1835,
    "vorder": 144,
    "position": 1,
    "text": "نیرزد تن ما برش یک پشیز"
  },
  {
    "poem_id": 1835,
    "vorder": 145,
    "position": 0,
    "text": "گزند آیدم زین جهاندار مرد"
  },
  {
    "poem_id": 1835,
    "vorder": 146,
    "position": 1,
    "text": "کند برمن از خشم رخساره زرد"
  },
  {
    "poem_id": 1835,
    "vorder": 147,
    "position": 0,
    "text": "هم از بهر ایزد گشسب دبیر"
  },
  {
    "poem_id": 1835,
    "vorder": 148,
    "position": 1,
    "text": "دلش بود پیچان و رخ چون زریر"
  },
  {
    "poem_id": 1835,
    "vorder": 149,
    "position": 0,
    "text": "بفرمود تا پاک خوالیگرش"
  },
  {
    "poem_id": 1835,
    "vorder": 150,
    "position": 1,
    "text": "به زندان کشد خوردنیها برش"
  },
  {
    "poem_id": 1835,
    "vorder": 151,
    "position": 0,
    "text": "ازان پس نشست از بر تازی اسب"
  },
  {
    "poem_id": 1835,
    "vorder": 152,
    "position": 1,
    "text": "بیامد به نزدیک ایزد گشسب"
  },
  {
    "poem_id": 1835,
    "vorder": 153,
    "position": 0,
    "text": "گرفتند مر یکدگر را کنار"
  },
  {
    "poem_id": 1835,
    "vorder": 154,
    "position": 1,
    "text": "پر از درد ومژگان چو ابر بهار"
  },
  {
    "poem_id": 1835,
    "vorder": 155,
    "position": 0,
    "text": "ز خوی بد شاه چندی سخن"
  },
  {
    "poem_id": 1835,
    "vorder": 156,
    "position": 1,
    "text": "همی‌رفت تا شد سخنها کهن"
  },
  {
    "poem_id": 1835,
    "vorder": 157,
    "position": 0,
    "text": "نهادند خوان پیش ایزدگشسب"
  },
  {
    "poem_id": 1835,
    "vorder": 158,
    "position": 1,
    "text": "گرفتند پس واژ و برسم بدست"
  },
  {
    "poem_id": 1835,
    "vorder": 159,
    "position": 0,
    "text": "پس ایزد گشسب آنچ اندرز بود"
  },
  {
    "poem_id": 1835,
    "vorder": 160,
    "position": 1,
    "text": "به زمزم همی‌گفت و موبد شنود"
  },
  {
    "poem_id": 1835,
    "vorder": 161,
    "position": 0,
    "text": "ز دینار وز گنج وز خواسته"
  },
  {
    "poem_id": 1835,
    "vorder": 162,
    "position": 1,
    "text": "هم از کاخ و ایوان آراسته"
  },
  {
    "poem_id": 1835,
    "vorder": 163,
    "position": 0,
    "text": "به موبد چنین گفت کای نامجوی"
  },
  {
    "poem_id": 1835,
    "vorder": 164,
    "position": 1,
    "text": "چو رفتی از ایدر به هرمزد گوی"
  },
  {
    "poem_id": 1835,
    "vorder": 165,
    "position": 0,
    "text": "که گر سرنپیچی ز گفتار من"
  },
  {
    "poem_id": 1835,
    "vorder": 166,
    "position": 1,
    "text": "براندیشی از رنج و تیمار من"
  },
  {
    "poem_id": 1835,
    "vorder": 167,
    "position": 0,
    "text": "که از شهریاران توخورده‌ام"
  },
  {
    "poem_id": 1835,
    "vorder": 168,
    "position": 1,
    "text": "تو را نیز در بر بپرورده‌ام"
  },
  {
    "poem_id": 1835,
    "vorder": 169,
    "position": 0,
    "text": "بدان رنج پاداش بند آمدست"
  },
  {
    "poem_id": 1835,
    "vorder": 170,
    "position": 1,
    "text": "پس از رنج بیم گزند آمدست"
  },
  {
    "poem_id": 1835,
    "vorder": 171,
    "position": 0,
    "text": "دلی بیگنه پرغم ای شهریار"
  },
  {
    "poem_id": 1835,
    "vorder": 172,
    "position": 1,
    "text": "به یزدان نمایم به روز شمار"
  },
  {
    "poem_id": 1835,
    "vorder": 173,
    "position": 0,
    "text": "چوموبد سوی خانه شد در زمان"
  },
  {
    "poem_id": 1835,
    "vorder": 174,
    "position": 1,
    "text": "ز کارآگهان رفت مردی‌دمان"
  },
  {
    "poem_id": 1835,
    "vorder": 175,
    "position": 0,
    "text": "شنیده یکایک بهرمزد گفت"
  },
  {
    "poem_id": 1835,
    "vorder": 176,
    "position": 1,
    "text": "دل شاه با رای بد گشت جفت"
  },
  {
    "poem_id": 1835,
    "vorder": 177,
    "position": 0,
    "text": "ز ایزد گشسب آنگهی شد درشت"
  },
  {
    "poem_id": 1835,
    "vorder": 178,
    "position": 1,
    "text": "به زندان فرستاد و او را بکشت"
  },
  {
    "poem_id": 1835,
    "vorder": 179,
    "position": 0,
    "text": "سخنهای موبد فراوان شنید"
  },
  {
    "poem_id": 1835,
    "vorder": 180,
    "position": 1,
    "text": "بروبر نکرد ایچ گونه پدید"
  },
  {
    "poem_id": 1835,
    "vorder": 181,
    "position": 0,
    "text": "همی‌راند اندیشه بر خوب و زشت"
  },
  {
    "poem_id": 1835,
    "vorder": 182,
    "position": 1,
    "text": "سوی چاره کشتن زردهشت"
  },
  {
    "poem_id": 1835,
    "vorder": 183,
    "position": 0,
    "text": "بفرمود تا زهر خوالیگرش"
  },
  {
    "poem_id": 1835,
    "vorder": 184,
    "position": 1,
    "text": "نهانی برد پیش دریک خورش"
  },
  {
    "poem_id": 1835,
    "vorder": 185,
    "position": 0,
    "text": "چو موبد بیامد بهنگام بار"
  },
  {
    "poem_id": 1835,
    "vorder": 186,
    "position": 1,
    "text": "به نزدیکی نامور شهریار"
  },
  {
    "poem_id": 1835,
    "vorder": 187,
    "position": 0,
    "text": "بدو گفت کامروز ز ایدر مرو"
  },
  {
    "poem_id": 1835,
    "vorder": 188,
    "position": 1,
    "text": "که خوالیگری یافتستیم نو"
  },
  {
    "poem_id": 1835,
    "vorder": 189,
    "position": 0,
    "text": "چو بنشست موبد نهادند خوان"
  },
  {
    "poem_id": 1835,
    "vorder": 190,
    "position": 1,
    "text": "ز موبد بپالود رنگ رخان"
  },
  {
    "poem_id": 1835,
    "vorder": 191,
    "position": 0,
    "text": "بدانست کان خوان زمان ویست"
  },
  {
    "poem_id": 1835,
    "vorder": 192,
    "position": 1,
    "text": "همان راستی در گمان ویست"
  },
  {
    "poem_id": 1835,
    "vorder": 193,
    "position": 0,
    "text": "خورشها ببردند خوالیگران"
  },
  {
    "poem_id": 1835,
    "vorder": 194,
    "position": 1,
    "text": "همی‌خورد شاه از کران تا کران"
  },
  {
    "poem_id": 1835,
    "vorder": 195,
    "position": 0,
    "text": "چو آن کاسه زهر پیش آورید"
  },
  {
    "poem_id": 1835,
    "vorder": 196,
    "position": 1,
    "text": "نگه کرد موبد بدان بنگرید"
  },
  {
    "poem_id": 1835,
    "vorder": 197,
    "position": 0,
    "text": "بران بدگمان شد دل پاک اوی"
  },
  {
    "poem_id": 1835,
    "vorder": 198,
    "position": 1,
    "text": "که زهرست بر خوان تریاک اوی"
  },
  {
    "poem_id": 1835,
    "vorder": 199,
    "position": 0,
    "text": "چوهرمز نگه کرد لب را ببست"
  },
  {
    "poem_id": 1835,
    "vorder": 200,
    "position": 1,
    "text": "بران کاسه زهر یازید دست"
  },
  {
    "poem_id": 1835,
    "vorder": 201,
    "position": 0,
    "text": "بران سان که شاهان نوازش کنند"
  },
  {
    "poem_id": 1835,
    "vorder": 202,
    "position": 1,
    "text": "بران بندگان نیز نازش کنند"
  },
  {
    "poem_id": 1835,
    "vorder": 203,
    "position": 0,
    "text": "ازان کاسه برداشت مغز استخوان"
  },
  {
    "poem_id": 1835,
    "vorder": 204,
    "position": 1,
    "text": "بیازید دست گرامی بخوان"
  },
  {
    "poem_id": 1835,
    "vorder": 205,
    "position": 0,
    "text": "به موبد چنین گفت کای پاک مغز"
  },
  {
    "poem_id": 1835,
    "vorder": 206,
    "position": 1,
    "text": "تو راکردم این لقمهٔ پاک ونغز"
  },
  {
    "poem_id": 1835,
    "vorder": 207,
    "position": 0,
    "text": "دهن بازکن تا خوری زین خورش"
  },
  {
    "poem_id": 1835,
    "vorder": 208,
    "position": 1,
    "text": "کزین پس چنین باشدت پرورش"
  },
  {
    "poem_id": 1835,
    "vorder": 209,
    "position": 0,
    "text": "بدو گفت موبد به جان و سرت"
  },
  {
    "poem_id": 1835,
    "vorder": 210,
    "position": 1,
    "text": "که جاوید بادا سر وافسرت"
  },
  {
    "poem_id": 1835,
    "vorder": 211,
    "position": 0,
    "text": "کزین نوشه خوردن نفرماییم"
  },
  {
    "poem_id": 1835,
    "vorder": 212,
    "position": 1,
    "text": "به سیری رسیدم نیفزاییم"
  },
  {
    "poem_id": 1835,
    "vorder": 213,
    "position": 0,
    "text": "بدو گفت هرمز به خورشید وماه"
  },
  {
    "poem_id": 1835,
    "vorder": 214,
    "position": 1,
    "text": "به پاکی روان جهاندار شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 215,
    "position": 0,
    "text": "که بستانی این نوشه ز انگشت من"
  },
  {
    "poem_id": 1835,
    "vorder": 216,
    "position": 1,
    "text": "برین آرزو نشکنی پشت من"
  },
  {
    "poem_id": 1835,
    "vorder": 217,
    "position": 0,
    "text": "بدو گفت موبد که فرمان شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 218,
    "position": 1,
    "text": "بیامد نماند مرا رای و راه"
  },
  {
    "poem_id": 1835,
    "vorder": 219,
    "position": 0,
    "text": "بخورد و ز خوان زار و پیچان برفت"
  },
  {
    "poem_id": 1835,
    "vorder": 220,
    "position": 1,
    "text": "همی‌راند تا خانهٔ خویش تفت"
  },
  {
    "poem_id": 1835,
    "vorder": 221,
    "position": 0,
    "text": "ازان خوردن ز هر باکس نگفت"
  },
  {
    "poem_id": 1835,
    "vorder": 222,
    "position": 1,
    "text": "یکی جامه افگند ونالان بخفت"
  },
  {
    "poem_id": 1835,
    "vorder": 223,
    "position": 0,
    "text": "بفرمود تا پای زهر آورند"
  },
  {
    "poem_id": 1835,
    "vorder": 224,
    "position": 1,
    "text": "ازان گنجها گر ز شهر آورند"
  },
  {
    "poem_id": 1835,
    "vorder": 225,
    "position": 0,
    "text": "فرو خورد تریاک و نامد به کار"
  },
  {
    "poem_id": 1835,
    "vorder": 226,
    "position": 1,
    "text": "ز هرمز به یزدان بنالید زار"
  },
  {
    "poem_id": 1835,
    "vorder": 227,
    "position": 0,
    "text": "یکی استواری فرستاد شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 228,
    "position": 1,
    "text": "بدان تا کند کار موبد نگاه"
  },
  {
    "poem_id": 1835,
    "vorder": 229,
    "position": 0,
    "text": "که آن زهرشد بر تنش کارگر"
  },
  {
    "poem_id": 1835,
    "vorder": 230,
    "position": 1,
    "text": "گر اندیشهٔ ما نیامد ببر"
  },
  {
    "poem_id": 1835,
    "vorder": 231,
    "position": 0,
    "text": "فرستاده را چشم موبد بدید"
  },
  {
    "poem_id": 1835,
    "vorder": 232,
    "position": 1,
    "text": "سرشکش ز مژگان به رخ برچکید"
  },
  {
    "poem_id": 1835,
    "vorder": 233,
    "position": 0,
    "text": "بدو گفت رو پیش هرمزد گوی"
  },
  {
    "poem_id": 1835,
    "vorder": 234,
    "position": 1,
    "text": "که بختت ببر گشتن آورد روی"
  },
  {
    "poem_id": 1835,
    "vorder": 235,
    "position": 0,
    "text": "بدین داوری نزد داور شویم"
  },
  {
    "poem_id": 1835,
    "vorder": 236,
    "position": 1,
    "text": "بجایی که هر دو برابر شویم"
  },
  {
    "poem_id": 1835,
    "vorder": 237,
    "position": 0,
    "text": "ازین پس تو ایمن مشو از بدی"
  },
  {
    "poem_id": 1835,
    "vorder": 238,
    "position": 1,
    "text": "که پاداش پیش آیدت ایزدی"
  },
  {
    "poem_id": 1835,
    "vorder": 239,
    "position": 0,
    "text": "تو پدرود باش ای بداندیش مرد"
  },
  {
    "poem_id": 1835,
    "vorder": 240,
    "position": 1,
    "text": "بد آید برویت ز بد کارکرد"
  },
  {
    "poem_id": 1835,
    "vorder": 241,
    "position": 0,
    "text": "چو بشنید گریان بشد استوار"
  },
  {
    "poem_id": 1835,
    "vorder": 242,
    "position": 1,
    "text": "بیاورد پاسخ بر شهریار"
  },
  {
    "poem_id": 1835,
    "vorder": 243,
    "position": 0,
    "text": "سپهبد پشیمان شد از کار اوی"
  },
  {
    "poem_id": 1835,
    "vorder": 244,
    "position": 1,
    "text": "بپیچید ازان راست گفتار اوی"
  },
  {
    "poem_id": 1835,
    "vorder": 245,
    "position": 0,
    "text": "مر آن درد را راه چاره ندید"
  },
  {
    "poem_id": 1835,
    "vorder": 246,
    "position": 1,
    "text": "بسی باد سرد از جگر برکشید"
  },
  {
    "poem_id": 1835,
    "vorder": 247,
    "position": 0,
    "text": "بمرد آن زمان موبد موبدان"
  },
  {
    "poem_id": 1835,
    "vorder": 248,
    "position": 1,
    "text": "برو زار وگریان شده بخردان"
  },
  {
    "poem_id": 1835,
    "vorder": 249,
    "position": 0,
    "text": "چنینست کیهان همه درد و رنج"
  },
  {
    "poem_id": 1835,
    "vorder": 250,
    "position": 1,
    "text": "چه یازد بتاج وچه نازی به گنج"
  },
  {
    "poem_id": 1835,
    "vorder": 251,
    "position": 0,
    "text": "که این روزگار خوشی بگذرد"
  },
  {
    "poem_id": 1835,
    "vorder": 252,
    "position": 1,
    "text": "زمانه نفس را همی‌بشمرد"
  },
  {
    "poem_id": 1835,
    "vorder": 253,
    "position": 0,
    "text": "چوشد کار دانا بزاری به سر"
  },
  {
    "poem_id": 1835,
    "vorder": 254,
    "position": 1,
    "text": "همه کشور از درد زیر و زبر"
  },
  {
    "poem_id": 1835,
    "vorder": 255,
    "position": 0,
    "text": "جهاندار خونریز و ناسازگار"
  },
  {
    "poem_id": 1835,
    "vorder": 256,
    "position": 1,
    "text": "نکرد ایچ یاد از بد روزگار"
  },
  {
    "poem_id": 1835,
    "vorder": 257,
    "position": 0,
    "text": "میان تنگ خون ریختن را ببست"
  },
  {
    "poem_id": 1835,
    "vorder": 258,
    "position": 1,
    "text": "به بهرام آذرمهان آخت دست"
  },
  {
    "poem_id": 1835,
    "vorder": 259,
    "position": 0,
    "text": "چوشب تیره‌تر شد مر او را بخواند"
  },
  {
    "poem_id": 1835,
    "vorder": 260,
    "position": 1,
    "text": "به پیش خود اندر به زانو نشاند"
  },
  {
    "poem_id": 1835,
    "vorder": 261,
    "position": 0,
    "text": "بدو گفت خواهی که ایمن شوی"
  },
  {
    "poem_id": 1835,
    "vorder": 262,
    "position": 1,
    "text": "نبینی ز من تیزی و بدخوی"
  },
  {
    "poem_id": 1835,
    "vorder": 263,
    "position": 0,
    "text": "چو خورشید بر برج روشن شود"
  },
  {
    "poem_id": 1835,
    "vorder": 264,
    "position": 1,
    "text": "سرکوه چون پشت جوشن شود"
  },
  {
    "poem_id": 1835,
    "vorder": 265,
    "position": 0,
    "text": "تو با نامداران ایران بیای"
  },
  {
    "poem_id": 1835,
    "vorder": 266,
    "position": 1,
    "text": "همی‌باش در پیش تختم بپای"
  },
  {
    "poem_id": 1835,
    "vorder": 267,
    "position": 0,
    "text": "ز سیمای برزینت پرسم سخن"
  },
  {
    "poem_id": 1835,
    "vorder": 268,
    "position": 1,
    "text": "چو پاسخ گزاری دلت نرم کن"
  },
  {
    "poem_id": 1835,
    "vorder": 269,
    "position": 0,
    "text": "بپرسم که این دوستار توکیست"
  },
  {
    "poem_id": 1835,
    "vorder": 270,
    "position": 1,
    "text": "بدست ار پرستنده ایزدیست"
  },
  {
    "poem_id": 1835,
    "vorder": 271,
    "position": 0,
    "text": "تو پاسخ چنین ده که این بدتنست"
  },
  {
    "poem_id": 1835,
    "vorder": 272,
    "position": 1,
    "text": "بداندیش وز تخم آهرمنست"
  },
  {
    "poem_id": 1835,
    "vorder": 273,
    "position": 0,
    "text": "وزان پس ز من هرچ خواهی بخواه"
  },
  {
    "poem_id": 1835,
    "vorder": 274,
    "position": 1,
    "text": "پرستنده و تخت و مهر و کلاه"
  },
  {
    "poem_id": 1835,
    "vorder": 275,
    "position": 0,
    "text": "بدو گفت بهرام کایدون کنم"
  },
  {
    "poem_id": 1835,
    "vorder": 276,
    "position": 1,
    "text": "ازین بد که گفتی صدافزون کنم"
  },
  {
    "poem_id": 1835,
    "vorder": 277,
    "position": 0,
    "text": "بسیمای برزین که بود از مهان"
  },
  {
    "poem_id": 1835,
    "vorder": 278,
    "position": 1,
    "text": "گزین پدرش آن چراغ جهان"
  },
  {
    "poem_id": 1835,
    "vorder": 279,
    "position": 0,
    "text": "همی‌ساخت تا چاره‌ای چون کند"
  },
  {
    "poem_id": 1835,
    "vorder": 280,
    "position": 1,
    "text": "که پیراهن مهر بیرون کند"
  },
  {
    "poem_id": 1835,
    "vorder": 281,
    "position": 0,
    "text": "چو پیدا شد آن چادر عاج گون"
  },
  {
    "poem_id": 1835,
    "vorder": 282,
    "position": 1,
    "text": "خور از بخش دوپیکر آمد برون"
  },
  {
    "poem_id": 1835,
    "vorder": 283,
    "position": 0,
    "text": "جهاندار بنشست بر تخت عاج"
  },
  {
    "poem_id": 1835,
    "vorder": 284,
    "position": 1,
    "text": "بیاویختند آن بهاگیر تاج"
  },
  {
    "poem_id": 1835,
    "vorder": 285,
    "position": 0,
    "text": "بزرگان ایران بران بارگاه"
  },
  {
    "poem_id": 1835,
    "vorder": 286,
    "position": 1,
    "text": "شدند انجمن تا بیامد سپاه"
  },
  {
    "poem_id": 1835,
    "vorder": 287,
    "position": 0,
    "text": "ز در پرده برداشت سالار بار"
  },
  {
    "poem_id": 1835,
    "vorder": 288,
    "position": 1,
    "text": "برفتند یکسر بر شهریار"
  },
  {
    "poem_id": 1835,
    "vorder": 289,
    "position": 0,
    "text": "چو بهرام آذرمهان پیشرو"
  },
  {
    "poem_id": 1835,
    "vorder": 290,
    "position": 1,
    "text": "چو سیمان برزین و گردان نو"
  },
  {
    "poem_id": 1835,
    "vorder": 291,
    "position": 0,
    "text": "نشستند هریک به آیین خویش"
  },
  {
    "poem_id": 1835,
    "vorder": 292,
    "position": 1,
    "text": "گروهی ببودند بر پای پیش"
  },
  {
    "poem_id": 1835,
    "vorder": 293,
    "position": 0,
    "text": "به بهرام آذرمهان گفت شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 294,
    "position": 1,
    "text": "که سیمای برزین بدین بارگاه"
  },
  {
    "poem_id": 1835,
    "vorder": 295,
    "position": 0,
    "text": "سزاوار گنجست اگر مرد رنج"
  },
  {
    "poem_id": 1835,
    "vorder": 296,
    "position": 1,
    "text": "که بدخواه زیبا نباشد به گنج"
  },
  {
    "poem_id": 1835,
    "vorder": 297,
    "position": 0,
    "text": "بدانست بهرام آذرمهان"
  },
  {
    "poem_id": 1835,
    "vorder": 298,
    "position": 1,
    "text": "که آن پرسش شهریار جهان"
  },
  {
    "poem_id": 1835,
    "vorder": 299,
    "position": 0,
    "text": "چگونست وآن راپی و بیخ چیست"
  },
  {
    "poem_id": 1835,
    "vorder": 300,
    "position": 1,
    "text": "کزان بیخ اورا بباید گریست"
  },
  {
    "poem_id": 1835,
    "vorder": 301,
    "position": 0,
    "text": "سرانجام جز دخمهٔ بی‌کفن"
  },
  {
    "poem_id": 1835,
    "vorder": 302,
    "position": 1,
    "text": "نیابد ازین مهتر انجمن"
  },
  {
    "poem_id": 1835,
    "vorder": 303,
    "position": 0,
    "text": "چنین داد پاسخ که ای شاه راد"
  },
  {
    "poem_id": 1835,
    "vorder": 304,
    "position": 1,
    "text": "زسیمای بر زین مکن ایچ یاد"
  },
  {
    "poem_id": 1835,
    "vorder": 305,
    "position": 0,
    "text": "که ویرانی شهر ایران ازوست"
  },
  {
    "poem_id": 1835,
    "vorder": 306,
    "position": 1,
    "text": "که مه مغز بادش بتن بر مه پوست"
  },
  {
    "poem_id": 1835,
    "vorder": 307,
    "position": 0,
    "text": "نگوید سخن جز همه بتری"
  },
  {
    "poem_id": 1835,
    "vorder": 308,
    "position": 1,
    "text": "بر آن بتری بر کند داوری"
  },
  {
    "poem_id": 1835,
    "vorder": 309,
    "position": 0,
    "text": "چو سیمای برزین شنید این سخن"
  },
  {
    "poem_id": 1835,
    "vorder": 310,
    "position": 1,
    "text": "بدو گفت کای نیک یار کهن"
  },
  {
    "poem_id": 1835,
    "vorder": 311,
    "position": 0,
    "text": "ببد برتن من گوایی مده"
  },
  {
    "poem_id": 1835,
    "vorder": 312,
    "position": 1,
    "text": "چنین دیو را آشنایی مده"
  },
  {
    "poem_id": 1835,
    "vorder": 313,
    "position": 0,
    "text": "چه دیدی ز من تا تو یار منی"
  },
  {
    "poem_id": 1835,
    "vorder": 314,
    "position": 1,
    "text": "ز کردار و گفتار آهرمنی"
  },
  {
    "poem_id": 1835,
    "vorder": 315,
    "position": 0,
    "text": "بدو گفت بهرام آذرمهان"
  },
  {
    "poem_id": 1835,
    "vorder": 316,
    "position": 1,
    "text": "که تخمی پراگنده‌ای در جهان"
  },
  {
    "poem_id": 1835,
    "vorder": 317,
    "position": 0,
    "text": "کزان بر نخستین توخواهی درود"
  },
  {
    "poem_id": 1835,
    "vorder": 318,
    "position": 1,
    "text": "از آتش نیابی مگر تیره دود"
  },
  {
    "poem_id": 1835,
    "vorder": 319,
    "position": 0,
    "text": "چو کسری مرا و تو را پیش خواند"
  },
  {
    "poem_id": 1835,
    "vorder": 320,
    "position": 1,
    "text": "بر تخت شاهنشهی برنشاند"
  },
  {
    "poem_id": 1835,
    "vorder": 321,
    "position": 0,
    "text": "ابا موبد موبدان برزمهر"
  },
  {
    "poem_id": 1835,
    "vorder": 322,
    "position": 1,
    "text": "چوایزدگشسب آن مه خوب چهر"
  },
  {
    "poem_id": 1835,
    "vorder": 323,
    "position": 0,
    "text": "بپرسید کین تخت شاهنشهی"
  },
  {
    "poem_id": 1835,
    "vorder": 324,
    "position": 1,
    "text": "کرا زیبد و کیست با فرهی"
  },
  {
    "poem_id": 1835,
    "vorder": 325,
    "position": 0,
    "text": "بکهتر دهم گر به مهتر پسر"
  },
  {
    "poem_id": 1835,
    "vorder": 326,
    "position": 1,
    "text": "که باشد بشاهی سزاوارتر"
  },
  {
    "poem_id": 1835,
    "vorder": 327,
    "position": 0,
    "text": "همه یکسر از جای برخاستیم"
  },
  {
    "poem_id": 1835,
    "vorder": 328,
    "position": 1,
    "text": "زبان پاسخش را بیاراستیم"
  },
  {
    "poem_id": 1835,
    "vorder": 329,
    "position": 0,
    "text": "که این ترکزاده سزاوارنیست"
  },
  {
    "poem_id": 1835,
    "vorder": 330,
    "position": 1,
    "text": "بشاهی کس او را خریدار نیست"
  },
  {
    "poem_id": 1835,
    "vorder": 331,
    "position": 0,
    "text": "که خاقان نژادست و بد گوهرست"
  },
  {
    "poem_id": 1835,
    "vorder": 332,
    "position": 1,
    "text": "ببالا و دیدار چون مادرست"
  },
  {
    "poem_id": 1835,
    "vorder": 333,
    "position": 0,
    "text": "تو گفتی که هرمز بشاهی سزاست"
  },
  {
    "poem_id": 1835,
    "vorder": 334,
    "position": 1,
    "text": "کنون زین سزا مر تو را این جزاست"
  },
  {
    "poem_id": 1835,
    "vorder": 335,
    "position": 0,
    "text": "گوایی من از بهر این دادمت"
  },
  {
    "poem_id": 1835,
    "vorder": 336,
    "position": 1,
    "text": "چنین لب به دشنام بگشادمت"
  },
  {
    "poem_id": 1835,
    "vorder": 337,
    "position": 0,
    "text": "ز تشویر هرمز فروپژمرید"
  },
  {
    "poem_id": 1835,
    "vorder": 338,
    "position": 1,
    "text": "چو آن راست گفتار او را شنید"
  },
  {
    "poem_id": 1835,
    "vorder": 339,
    "position": 0,
    "text": "به زندان فرستادشان تیره شب"
  },
  {
    "poem_id": 1835,
    "vorder": 340,
    "position": 1,
    "text": "وز ایشان ببد تیز بگشاد لب"
  },
  {
    "poem_id": 1835,
    "vorder": 341,
    "position": 0,
    "text": "سیم شب چو برزد سر از کوه ماه"
  },
  {
    "poem_id": 1835,
    "vorder": 342,
    "position": 1,
    "text": "ز سیمای برزین بپردخت شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 343,
    "position": 0,
    "text": "به زندان دزدان مر او را بکشت"
  },
  {
    "poem_id": 1835,
    "vorder": 344,
    "position": 1,
    "text": "ندارد جز از رنج و نفرین بمشت"
  },
  {
    "poem_id": 1835,
    "vorder": 345,
    "position": 0,
    "text": "چو بهرام آذرمهان آن شنید"
  },
  {
    "poem_id": 1835,
    "vorder": 346,
    "position": 1,
    "text": "که آن پاکدل مرد شد ناپدید"
  },
  {
    "poem_id": 1835,
    "vorder": 347,
    "position": 0,
    "text": "پیامی فرستاد نزدیک شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 348,
    "position": 1,
    "text": "که ای تاج تو برتر از چرخ ماه"
  },
  {
    "poem_id": 1835,
    "vorder": 349,
    "position": 0,
    "text": "تو دانی که من چند کوشیده‌ام"
  },
  {
    "poem_id": 1835,
    "vorder": 350,
    "position": 1,
    "text": "که تا رازهای تو پوشیده‌ام"
  },
  {
    "poem_id": 1835,
    "vorder": 351,
    "position": 0,
    "text": "به پیش پدرت آن سزاوار شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 352,
    "position": 1,
    "text": "نبودم تو را جز همه نیکخواه"
  },
  {
    "poem_id": 1835,
    "vorder": 353,
    "position": 0,
    "text": "یکی پند گویم چوخوانی مرا"
  },
  {
    "poem_id": 1835,
    "vorder": 354,
    "position": 1,
    "text": "بر تخت شاهی نشانی مرا"
  },
  {
    "poem_id": 1835,
    "vorder": 355,
    "position": 0,
    "text": "تو را سودمندیست از پند من"
  },
  {
    "poem_id": 1835,
    "vorder": 356,
    "position": 1,
    "text": "به زندان بمان یک زمان بند من"
  },
  {
    "poem_id": 1835,
    "vorder": 357,
    "position": 0,
    "text": "به ایران تو راسودمندی بود"
  },
  {
    "poem_id": 1835,
    "vorder": 358,
    "position": 1,
    "text": "خردمند را بی‌گزندی بود"
  },
  {
    "poem_id": 1835,
    "vorder": 359,
    "position": 0,
    "text": "پیامش چو نزدیک هرمز رسید"
  },
  {
    "poem_id": 1835,
    "vorder": 360,
    "position": 1,
    "text": "یکی رازدار از میان برگزید"
  },
  {
    "poem_id": 1835,
    "vorder": 361,
    "position": 0,
    "text": "که بهرام را پیش شاه آورد"
  },
  {
    "poem_id": 1835,
    "vorder": 362,
    "position": 1,
    "text": "بدان نامور بارگاه آورد"
  },
  {
    "poem_id": 1835,
    "vorder": 363,
    "position": 0,
    "text": "شب تیره بهرام را پیش خواند"
  },
  {
    "poem_id": 1835,
    "vorder": 364,
    "position": 1,
    "text": "به چربی سخن چند با او براند"
  },
  {
    "poem_id": 1835,
    "vorder": 365,
    "position": 0,
    "text": "بدو گفت برگوی کان پند چیست"
  },
  {
    "poem_id": 1835,
    "vorder": 366,
    "position": 1,
    "text": "که ما را بدان روزگار بهیست"
  },
  {
    "poem_id": 1835,
    "vorder": 367,
    "position": 0,
    "text": "چنین داد پاسخ که در گنج شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 368,
    "position": 1,
    "text": "یکی ساده صندوق دیدم سیاه"
  },
  {
    "poem_id": 1835,
    "vorder": 369,
    "position": 0,
    "text": "نهاده به صندوق در حقه‌ای"
  },
  {
    "poem_id": 1835,
    "vorder": 370,
    "position": 1,
    "text": "بحقه درون پارسی رقعه‌ای"
  },
  {
    "poem_id": 1835,
    "vorder": 371,
    "position": 0,
    "text": "نبشتست بر پرنیان سپید"
  },
  {
    "poem_id": 1835,
    "vorder": 372,
    "position": 1,
    "text": "بدان باشد ایرانیان را امید"
  },
  {
    "poem_id": 1835,
    "vorder": 373,
    "position": 0,
    "text": "به خط پدرت آن جهاندار شاه"
  },
  {
    "poem_id": 1835,
    "vorder": 374,
    "position": 1,
    "text": "تو را اندران کرد باید نگاه"
  },
  {
    "poem_id": 1835,
    "vorder": 375,
    "position": 0,
    "text": "چوهرمز شنید آن فرستاد کس"
  },
  {
    "poem_id": 1835,
    "vorder": 376,
    "position": 1,
    "text": "به نزدیک گنجور فریادرس"
  },
  {
    "poem_id": 1835,
    "vorder": 377,
    "position": 0,
    "text": "که در گنجهای پدر بازجوی"
  },
  {
    "poem_id": 1835,
    "vorder": 378,
    "position": 1,
    "text": "یکی ساده صندوق و مهری بروی"
  },
  {
    "poem_id": 1835,
    "vorder": 379,
    "position": 0,
    "text": "بران مهر بر نام نوشین‌روان"
  },
  {
    "poem_id": 1835,
    "vorder": 380,
    "position": 1,
    "text": "که جاوید بادا روانش جوان"
  },
  {
    "poem_id": 1835,
    "vorder": 381,
    "position": 0,
    "text": "هم اکنون شب تیره پیش من آر"
  },
  {
    "poem_id": 1835,
    "vorder": 382,
    "position": 1,
    "text": "فراوان بجستن مبر روزگار"
  },
  {
    "poem_id": 1835,
    "vorder": 383,
    "position": 0,
    "text": "شتابید گنجور و صندوق جست"
  },
  {
    "poem_id": 1835,
    "vorder": 384,
    "position": 1,
    "text": "بیاورد پویان به مهر درست"
  },
  {
    "poem_id": 1835,
    "vorder": 385,
    "position": 0,
    "text": "جهاندار صندوق را برگشاد"
  },
  {
    "poem_id": 1835,
    "vorder": 386,
    "position": 1,
    "text": "فراوان ز نوشین‌روان کرد یاد"
  },
  {
    "poem_id": 1835,
    "vorder": 387,
    "position": 0,
    "text": "به صندوق در حقه با مهر دید"
  },
  {
    "poem_id": 1835,
    "vorder": 388,
    "position": 1,
    "text": "شتابید وزو پرنیان برکشید"
  },
  {
    "poem_id": 1835,
    "vorder": 389,
    "position": 0,
    "text": "نگه کرد پس خط نوشین‌روان"
  },
  {
    "poem_id": 1835,
    "vorder": 390,
    "position": 1,
    "text": "نبشته بران رقعهٔ پرنیان"
  },
  {
    "poem_id": 1835,
    "vorder": 391,
    "position": 0,
    "text": "که هرمز بده سال و بر سر دوسال"
  },
  {
    "poem_id": 1835,
    "vorder": 392,
    "position": 1,
    "text": "یکی شهریاری بود بی‌همال"
  },
  {
    "poem_id": 1835,
    "vorder": 393,
    "position": 0,
    "text": "ازان پس پرآشوب گردد جهان"
  },
  {
    "poem_id": 1835,
    "vorder": 394,
    "position": 1,
    "text": "شود نام و آواز او درنهان"
  },
  {
    "poem_id": 1835,
    "vorder": 395,
    "position": 0,
    "text": "پدید آید ازهرسویی دشمنی"
  },
  {
    "poem_id": 1835,
    "vorder": 396,
    "position": 1,
    "text": "یکی بدنژادی وآهرمنی"
  },
  {
    "poem_id": 1835,
    "vorder": 397,
    "position": 0,
    "text": "پراگنده گردد ز هر سو سپاه"
  },
  {
    "poem_id": 1835,
    "vorder": 398,
    "position": 1,
    "text": "فروافگند دشمن او را ز گاه"
  },
  {
    "poem_id": 1835,
    "vorder": 399,
    "position": 0,
    "text": "دو چشمش کند کور خویش زنش"
  },
  {
    "poem_id": 1835,
    "vorder": 400,
    "position": 1,
    "text": "ازان پس برآرند هوش از تنش"
  },
  {
    "poem_id": 1835,
    "vorder": 401,
    "position": 0,
    "text": "به خط پدر هرمز آن رقعه دید"
  },
  {
    "poem_id": 1835,
    "vorder": 402,
    "position": 1,
    "text": "هراسان شد و پرنیان برکشید"
  },
  {
    "poem_id": 1835,
    "vorder": 403,
    "position": 0,
    "text": "دوچشمش پر از خون شد و روی زرد"
  },
  {
    "poem_id": 1835,
    "vorder": 404,
    "position": 1,
    "text": "ببهرام گفت ای جفاپیشه مرد"
  },
  {
    "poem_id": 1835,
    "vorder": 405,
    "position": 0,
    "text": "چه جستی ازین رقعه اندرهمی"
  },
  {
