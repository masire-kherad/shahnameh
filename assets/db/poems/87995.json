[
  {
    "poem_id": 87995,
    "vorder": 1,
    "position": 0,
    "text": "ازان دشت چنگش برانگیخت اسپ"
  },
  {
    "poem_id": 87995,
    "vorder": 2,
    "position": 1,
    "text": "همی رفت برسان آذرگشسپ"
  },
  {
    "poem_id": 87995,
    "vorder": 3,
    "position": 0,
    "text": "چو نزدیک ایرانیان شد بجنگ"
  },
  {
    "poem_id": 87995,
    "vorder": 4,
    "position": 1,
    "text": "ز ترکش برآورد تیر خدنگ"
  },
  {
    "poem_id": 87995,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کین جای جنگ منست"
  },
  {
    "poem_id": 87995,
    "vorder": 6,
    "position": 1,
    "text": "سر نامداران بچنگ منست"
  },
  {
    "poem_id": 87995,
    "vorder": 7,
    "position": 0,
    "text": "کجا رفت آن مرد کاموس گیر"
  },
  {
    "poem_id": 87995,
    "vorder": 8,
    "position": 1,
    "text": "که گاهی کمند افگند گاه تیر"
  },
  {
    "poem_id": 87995,
    "vorder": 9,
    "position": 0,
    "text": "کنون گر بیاید به آوردگاه"
  },
  {
    "poem_id": 87995,
    "vorder": 10,
    "position": 1,
    "text": "نمانم که ماند بنزد سپاه"
  },
  {
    "poem_id": 87995,
    "vorder": 11,
    "position": 0,
    "text": "بجنبید با گرز رستم ز جای"
  },
  {
    "poem_id": 87995,
    "vorder": 12,
    "position": 1,
    "text": "همانگه برخش اندر آورد پای"
  },
  {
    "poem_id": 87995,
    "vorder": 13,
    "position": 0,
    "text": "منم گفت شیراوژن و گردگیر"
  },
  {
    "poem_id": 87995,
    "vorder": 14,
    "position": 1,
    "text": "که گاهی کمند افگنم گاه تیر"
  },
  {
    "poem_id": 87995,
    "vorder": 15,
    "position": 0,
    "text": "هم اکنون ترا همچو کاموس گرد"
  },
  {
    "poem_id": 87995,
    "vorder": 16,
    "position": 1,
    "text": "بدیده همی خاک باید سپرد"
  },
  {
    "poem_id": 87995,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت چنگش که نام تو چیست"
  },
  {
    "poem_id": 87995,
    "vorder": 18,
    "position": 1,
    "text": "نژادت کدامست و کام تو چیست"
  },
  {
    "poem_id": 87995,
    "vorder": 19,
    "position": 0,
    "text": "بدان تا بدانم که روز نبرد"
  },
  {
    "poem_id": 87995,
    "vorder": 20,
    "position": 1,
    "text": "کرا ریختم خون چو برخاست گرد"
  },
  {
    "poem_id": 87995,
    "vorder": 21,
    "position": 0,
    "text": "بدو گفت رستم که ای شوربخت"
  },
  {
    "poem_id": 87995,
    "vorder": 22,
    "position": 1,
    "text": "که هرگز مبادا گل آن درخت"
  },
  {
    "poem_id": 87995,
    "vorder": 23,
    "position": 0,
    "text": "کجا چون تو در باغ بار آورد"
  },
  {
    "poem_id": 87995,
    "vorder": 24,
    "position": 1,
    "text": "چو تو میوه اندر شمار آورد"
  },
  {
    "poem_id": 87995,
    "vorder": 25,
    "position": 0,
    "text": "سر نیزه و نام من مرگ تست"
  },
  {
    "poem_id": 87995,
    "vorder": 26,
    "position": 1,
    "text": "سرت را بباید ز تن دست شست"
  },
  {
    "poem_id": 87995,
    "vorder": 27,
    "position": 0,
    "text": "بیامد همانگاه چنگش چو باد"
  },
  {
    "poem_id": 87995,
    "vorder": 28,
    "position": 1,
    "text": "دو زاغ کمان را بزه بر نهاد"
  },
  {
    "poem_id": 87995,
    "vorder": 29,
    "position": 0,
    "text": "کمان جفا پیشه چون ابر بود"
  },
  {
    "poem_id": 87995,
    "vorder": 30,
    "position": 1,
    "text": "هم آورد با جوشن و گبر بود"
  },
  {
    "poem_id": 87995,
    "vorder": 31,
    "position": 0,
    "text": "سپر بر سرآورد رستم چو دید"
  },
  {
    "poem_id": 87995,
    "vorder": 32,
    "position": 1,
    "text": "که تیرش زره را بخواهد برید"
  },
  {
    "poem_id": 87995,
    "vorder": 33,
    "position": 0,
    "text": "بدو گفت باش ای سوار دلیر"
  },
  {
    "poem_id": 87995,
    "vorder": 34,
    "position": 1,
    "text": "که اکنون سرت گردد از رزم سیر"
  },
  {
    "poem_id": 87995,
    "vorder": 35,
    "position": 0,
    "text": "نگه کرد چنگش بران پیلتن"
  },
  {
    "poem_id": 87995,
    "vorder": 36,
    "position": 1,
    "text": "ببالای سرو سهی بر چمن"
  },
  {
    "poem_id": 87995,
    "vorder": 37,
    "position": 0,
    "text": "بد آن اسپ در زیر یک لخت کوه"
  },
  {
    "poem_id": 87995,
    "vorder": 38,
    "position": 1,
    "text": "نیامد همی از کشیدن ستوه"
  },
  {
    "poem_id": 87995,
    "vorder": 39,
    "position": 0,
    "text": "بدل گفت چنگش که اکنون گریز"
  },
  {
    "poem_id": 87995,
    "vorder": 40,
    "position": 1,
    "text": "به از با تن خویش کردن ستیز"
  },
  {
    "poem_id": 87995,
    "vorder": 41,
    "position": 0,
    "text": "برانگیخت آن بارکش را ز جای"
  },
  {
    "poem_id": 87995,
    "vorder": 42,
    "position": 1,
    "text": "سوی لشکر خویشتن کرد رای"
  },
  {
    "poem_id": 87995,
    "vorder": 43,
    "position": 0,
    "text": "بکردار آتش دلاور سوار"
  },
  {
    "poem_id": 87995,
    "vorder": 44,
    "position": 1,
    "text": "برانگیخت رخش از پس نامدار"
  },
  {
    "poem_id": 87995,
    "vorder": 45,
    "position": 0,
    "text": "همانگاه رستم رسید اندروی"
  },
  {
    "poem_id": 87995,
    "vorder": 46,
    "position": 1,
    "text": "همه دشت زیشان پر از گفت و گوی"
  },
  {
    "poem_id": 87995,
    "vorder": 47,
    "position": 0,
    "text": "دم اسپ ناپاک چنگش گرفت"
  },
  {
    "poem_id": 87995,
    "vorder": 48,
    "position": 1,
    "text": "دو لشکر بدو مانده اندر شگفت"
  },
  {
    "poem_id": 87995,
    "vorder": 49,
    "position": 0,
    "text": "زمانی همی داشت تا شد غمی"
  },
  {
    "poem_id": 87995,
    "vorder": 50,
    "position": 1,
    "text": "ز بالا بزد خویشتن بر زمی"
  },
  {
    "poem_id": 87995,
    "vorder": 51,
    "position": 0,
    "text": "بیفتاد زو ترگ و زنهار خواست"
  },
  {
    "poem_id": 87995,
    "vorder": 52,
    "position": 1,
    "text": "تهمتن ورا کرد با خاک راست"
  },
  {
    "poem_id": 87995,
    "vorder": 53,
    "position": 0,
    "text": "همانگاه کردش سر از تن جدا"
  },
  {
    "poem_id": 87995,
    "vorder": 54,
    "position": 1,
    "text": "همه کام و اندیشه شد بی‌نوا"
  },
  {
    "poem_id": 87995,
    "vorder": 55,
    "position": 0,
    "text": "همه نامداران ایران زمین"
  },
  {
    "poem_id": 87995,
    "vorder": 56,
    "position": 1,
    "text": "گرفتند بر پهلوان آفرین"
  },
  {
    "poem_id": 87995,
    "vorder": 57,
    "position": 0,
    "text": "همی بود رستم میان دو صف"
  },
  {
    "poem_id": 87995,
    "vorder": 58,
    "position": 1,
    "text": "گرفته یکی خشت رخشان بکف"
  },
  {
    "poem_id": 87995,
    "vorder": 59,
    "position": 0,
    "text": "وزان روی خاقان غمی گشت سخت"
  },
  {
    "poem_id": 87995,
    "vorder": 60,
    "position": 1,
    "text": "برآشفت با گردش چرخ و بخت"
  },
  {
    "poem_id": 87995,
    "vorder": 61,
    "position": 0,
    "text": "بهومان چنین گفت خاقان چین"
  },
  {
    "poem_id": 87995,
    "vorder": 62,
    "position": 1,
    "text": "که تنگست بر ما زمان و زمین"
  },
  {
    "poem_id": 87995,
    "vorder": 63,
    "position": 0,
    "text": "مران نامور پهلوان را تو نام"
  },
  {
    "poem_id": 87995,
    "vorder": 64,
    "position": 1,
    "text": "شوی بازجویی فرستی پیام"
  },
  {
    "poem_id": 87995,
    "vorder": 65,
    "position": 0,
    "text": "بدو گفت هومان که سندان نیم"
  },
  {
    "poem_id": 87995,
    "vorder": 66,
    "position": 1,
    "text": "برزم اندرون پیل دندان نیم"
  },
  {
    "poem_id": 87995,
    "vorder": 67,
    "position": 0,
    "text": "بگیتی چو کاموس جنگی نبود"
  },
  {
    "poem_id": 87995,
    "vorder": 68,
    "position": 1,
    "text": "چنو رزم‌خواه و درنگی نبود"
  },
  {
    "poem_id": 87995,
    "vorder": 69,
    "position": 0,
    "text": "بخم کمندش گرفت این سوار"
  },
  {
    "poem_id": 87995,
    "vorder": 70,
    "position": 1,
    "text": "تو این گرد را خوار مایه مدار"
  },
  {
    "poem_id": 87995,
    "vorder": 71,
    "position": 0,
    "text": "شوم تا چه خواهد جهان آفرین"
  },
  {
    "poem_id": 87995,
    "vorder": 72,
    "position": 1,
    "text": "که پیروز گردد بدین دشت کین"
  }
]