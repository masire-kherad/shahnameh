[
  {
    "poem_id": 1485,
    "vorder": 1,
    "position": 0,
    "text": "چو یک پاس بگذشت از تیره شب"
  },
  {
    "poem_id": 1485,
    "vorder": 2,
    "position": 1,
    "text": "چنان چون کسی راز گوید به تب"
  },
  {
    "poem_id": 1485,
    "vorder": 3,
    "position": 0,
    "text": "خروشی برآمد ز افراسیاب"
  },
  {
    "poem_id": 1485,
    "vorder": 4,
    "position": 1,
    "text": "بلرزید بر جای آرام و خواب"
  },
  {
    "poem_id": 1485,
    "vorder": 5,
    "position": 0,
    "text": "پرستندگان تیز برخاستند"
  },
  {
    "poem_id": 1485,
    "vorder": 6,
    "position": 1,
    "text": "خروشیدن و غلغل آراستند"
  },
  {
    "poem_id": 1485,
    "vorder": 7,
    "position": 0,
    "text": "چو آمد به گرسیوز آن آگهی"
  },
  {
    "poem_id": 1485,
    "vorder": 8,
    "position": 1,
    "text": "که شد تیره دیهیم شاهنشهی"
  },
  {
    "poem_id": 1485,
    "vorder": 9,
    "position": 0,
    "text": "به تیزی بیامد به نزدیک شاه"
  },
  {
    "poem_id": 1485,
    "vorder": 10,
    "position": 1,
    "text": "ورا دید بر خاک خفته به راه"
  },
  {
    "poem_id": 1485,
    "vorder": 11,
    "position": 0,
    "text": "به بر در گرفتش بپرسید زوی"
  },
  {
    "poem_id": 1485,
    "vorder": 12,
    "position": 1,
    "text": "که این داستان با برادر بگوی"
  },
  {
    "poem_id": 1485,
    "vorder": 13,
    "position": 0,
    "text": "چنین داد پاسخ که پرسش مکن"
  },
  {
    "poem_id": 1485,
    "vorder": 14,
    "position": 1,
    "text": "مگو این زمان ایچ با من سخن"
  },
  {
    "poem_id": 1485,
    "vorder": 15,
    "position": 0,
    "text": "بمان تا خرد بازیابم یکی"
  },
  {
    "poem_id": 1485,
    "vorder": 16,
    "position": 1,
    "text": "به بر گیر و سختم بدار اندکی"
  },
  {
    "poem_id": 1485,
    "vorder": 17,
    "position": 0,
    "text": "زمانی برآمد چو آمد به هوش"
  },
  {
    "poem_id": 1485,
    "vorder": 18,
    "position": 1,
    "text": "جهان دیده با ناله و با خروش"
  },
  {
    "poem_id": 1485,
    "vorder": 19,
    "position": 0,
    "text": "نهادند شمع و برآمد به تخت"
  },
  {
    "poem_id": 1485,
    "vorder": 20,
    "position": 1,
    "text": "همی بود لرزان بسان درخت"
  },
  {
    "poem_id": 1485,
    "vorder": 21,
    "position": 0,
    "text": "بپرسید گرسیوز نامجوی"
  },
  {
    "poem_id": 1485,
    "vorder": 22,
    "position": 1,
    "text": "که بگشای لب زین شگفتی بگوی"
  },
  {
    "poem_id": 1485,
    "vorder": 23,
    "position": 0,
    "text": "چنین گفت پرمایه افراسیاب"
  },
  {
    "poem_id": 1485,
    "vorder": 24,
    "position": 1,
    "text": "که هرگز کسی این نبیند به خواب"
  },
  {
    "poem_id": 1485,
    "vorder": 25,
    "position": 0,
    "text": "کجا چون شب تیره من دیده‌ام"
  },
  {
    "poem_id": 1485,
    "vorder": 26,
    "position": 1,
    "text": "ز پیر و جوان نیز نشنیده‌ام"
  },
  {
    "poem_id": 1485,
    "vorder": 27,
    "position": 0,
    "text": "بیابان پر از مار دیدم به خواب"
  },
  {
    "poem_id": 1485,
    "vorder": 28,
    "position": 1,
    "text": "جهان پر ز گرد آسمان پر عقاب"
  },
  {
    "poem_id": 1485,
    "vorder": 29,
    "position": 0,
    "text": "زمین خشک شخی که گفتی سپهر"
  },
  {
    "poem_id": 1485,
    "vorder": 30,
    "position": 1,
    "text": "بدو تا جهان بود ننمود چهر"
  },
  {
    "poem_id": 1485,
    "vorder": 31,
    "position": 0,
    "text": "سراپردهٔ من زده بر کران"
  },
  {
    "poem_id": 1485,
    "vorder": 32,
    "position": 1,
    "text": "به گردش سپاهی ز کندآوران"
  },
  {
    "poem_id": 1485,
    "vorder": 33,
    "position": 0,
    "text": "یکی باد برخاستی پر ز گرد"
  },
  {
    "poem_id": 1485,
    "vorder": 34,
    "position": 1,
    "text": "درفش مرا سر نگونسار کرد"
  },
  {
    "poem_id": 1485,
    "vorder": 35,
    "position": 0,
    "text": "برفتی ز هر سو یکی جوی خون"
  },
  {
    "poem_id": 1485,
    "vorder": 36,
    "position": 1,
    "text": "سراپرده و خیمه گشتی نگون"
  },
  {
    "poem_id": 1485,
    "vorder": 37,
    "position": 0,
    "text": "وزان لشکر من فزون از هزار"
  },
  {
    "poem_id": 1485,
    "vorder": 38,
    "position": 1,
    "text": "بریده سران و تن افگنده خوار"
  },
  {
    "poem_id": 1485,
    "vorder": 39,
    "position": 0,
    "text": "سپاهی ز ایران چو باد دمان"
  },
  {
    "poem_id": 1485,
    "vorder": 40,
    "position": 1,
    "text": "چه نیزه به دست و چه تیر و کمان"
  },
  {
    "poem_id": 1485,
    "vorder": 41,
    "position": 0,
    "text": "همه نیزهاشان سر آورده بار"
  },
  {
    "poem_id": 1485,
    "vorder": 42,
    "position": 1,
    "text": "وزان هر سواری سری در کنار"
  },
  {
    "poem_id": 1485,
    "vorder": 43,
    "position": 0,
    "text": "بر تخت من تاختندی سوار"
  },
  {
    "poem_id": 1485,
    "vorder": 44,
    "position": 1,
    "text": "سیه پوش و نیزه‌وران صد هزار"
  },
  {
    "poem_id": 1485,
    "vorder": 45,
    "position": 0,
    "text": "برانگیختندی ز جای نشست"
  },
  {
    "poem_id": 1485,
    "vorder": 46,
    "position": 1,
    "text": "مرا تاختندی همی بسته دست"
  },
  {
    "poem_id": 1485,
    "vorder": 47,
    "position": 0,
    "text": "نگه کردمی نیک هر سو بسی"
  },
  {
    "poem_id": 1485,
    "vorder": 48,
    "position": 1,
    "text": "ز پیوسته پیشم نبودی کسی"
  },
  {
    "poem_id": 1485,
    "vorder": 49,
    "position": 0,
    "text": "مرا پیش کاووس بردی دوان"
  },
  {
    "poem_id": 1485,
    "vorder": 50,
    "position": 1,
    "text": "یکی بادسر نامور پهلوان"
  },
  {
    "poem_id": 1485,
    "vorder": 51,
    "position": 0,
    "text": "یکی تخت بودی چو تابنده ماه"
  },
  {
    "poem_id": 1485,
    "vorder": 52,
    "position": 1,
    "text": "نشسته برو پور کاووس شاه"
  },
  {
    "poem_id": 1485,
    "vorder": 53,
    "position": 0,
    "text": "دو هفته نبودی ورا سال بیش"
  },
  {
    "poem_id": 1485,
    "vorder": 54,
    "position": 1,
    "text": "چو دیدی مرا بسته در پیش خویش"
  },
  {
    "poem_id": 1485,
    "vorder": 55,
    "position": 0,
    "text": "دمیدی به کردار غرنده میغ"
  },
  {
    "poem_id": 1485,
    "vorder": 56,
    "position": 1,
    "text": "میانم بدو نیم کردی به تیغ"
  },
  {
    "poem_id": 1485,
    "vorder": 57,
    "position": 0,
    "text": "خروشیدمی من فراوان ز درد"
  },
  {
    "poem_id": 1485,
    "vorder": 58,
    "position": 1,
    "text": "مرا ناله و درد بیدار کرد"
  },
  {
    "poem_id": 1485,
    "vorder": 59,
    "position": 0,
    "text": "بدو گفت گرسیوز این خواب شاه"
  },
  {
    "poem_id": 1485,
    "vorder": 60,
    "position": 1,
    "text": "نباشد جز از کامهٔ نیک خواه"
  },
  {
    "poem_id": 1485,
    "vorder": 61,
    "position": 0,
    "text": "همه کام دل باشد و تاج و تخت"
  },
  {
    "poem_id": 1485,
    "vorder": 62,
    "position": 1,
    "text": "نگون گشته بر بدسگال تو بخت"
  },
  {
    "poem_id": 1485,
    "vorder": 63,
    "position": 0,
    "text": "گزارندهٔ خواب باید کسی"
  },
  {
    "poem_id": 1485,
    "vorder": 64,
    "position": 1,
    "text": "که از دانش اندازه دارد بسی"
  },
  {
    "poem_id": 1485,
    "vorder": 65,
    "position": 0,
    "text": "بخوانیم بیدار دل موبدان"
  },
  {
    "poem_id": 1485,
    "vorder": 66,
    "position": 1,
    "text": "از اخترشناسان و از بخردان"
  },
  {
    "poem_id": 1485,
    "vorder": 67,
    "position": 0,
    "text": "هر آنکس کزین دانش آگه بود"
  },
  {
    "poem_id": 1485,
    "vorder": 68,
    "position": 1,
    "text": "پراگنده گر بر در شه بود"
  },
  {
    "poem_id": 1485,
    "vorder": 69,
    "position": 0,
    "text": "شدند انجمن بر در شهریار"
  },
  {
    "poem_id": 1485,
    "vorder": 70,
    "position": 1,
    "text": "بدان تا چرا کردشان خواستار"
  },
  {
    "poem_id": 1485,
    "vorder": 71,
    "position": 0,
    "text": "بخواند و سزاوار بنشاند پیش"
  },
  {
    "poem_id": 1485,
    "vorder": 72,
    "position": 1,
    "text": "سخن راند با هر یک از کم و بیش"
  },
  {
    "poem_id": 1485,
    "vorder": 73,
    "position": 0,
    "text": "چنین گفت با نامور موبدان"
  },
  {
    "poem_id": 1485,
    "vorder": 74,
    "position": 1,
    "text": "که‌ای پاک‌دل نیک‌پی بخردان"
  },
  {
    "poem_id": 1485,
    "vorder": 75,
    "position": 0,
    "text": "گر این خواب و گفتار من در جهان"
  },
  {
    "poem_id": 1485,
    "vorder": 76,
    "position": 1,
    "text": "ز کس بشنوم آشکار و نهان"
  },
  {
    "poem_id": 1485,
    "vorder": 77,
    "position": 0,
    "text": "یکی را نمانم سر و تن به هم"
  },
  {
    "poem_id": 1485,
    "vorder": 78,
    "position": 1,
    "text": "اگر زین سخن بر لب آرند دم"
  },
  {
    "poem_id": 1485,
    "vorder": 79,
    "position": 0,
    "text": "ببخشیدشان بیکران زر و سیم"
  },
  {
    "poem_id": 1485,
    "vorder": 80,
    "position": 1,
    "text": "بدان تا نباشد کسی زو ببیم"
  },
  {
    "poem_id": 1485,
    "vorder": 81,
    "position": 0,
    "text": "ازان پس بگفت آنچ در خواب دید"
  },
  {
    "poem_id": 1485,
    "vorder": 82,
    "position": 1,
    "text": "چو موبد ز شاه آن سخنها شنید"
  },
  {
    "poem_id": 1485,
    "vorder": 83,
    "position": 0,
    "text": "بترسید و ز شاه زنهار خواست"
  },
  {
    "poem_id": 1485,
    "vorder": 84,
    "position": 1,
    "text": "که این خواب را کی توان گفت راست"
  },
  {
    "poem_id": 1485,
    "vorder": 85,
    "position": 0,
    "text": "مگر شاه با بنده پیمان کند"
  },
  {
    "poem_id": 1485,
    "vorder": 86,
    "position": 1,
    "text": "زبان را به پاسخ گروگان کند"
  },
  {
    "poem_id": 1485,
    "vorder": 87,
    "position": 0,
    "text": "کزین در سخن هرچ داریم یاد"
  },
  {
    "poem_id": 1485,
    "vorder": 88,
    "position": 1,
    "text": "گشاییم بر شاه و یابیم داد"
  },
  {
    "poem_id": 1485,
    "vorder": 89,
    "position": 0,
    "text": "به زنهار دادن زبان داد شاه"
  },
  {
    "poem_id": 1485,
    "vorder": 90,
    "position": 1,
    "text": "کزان بد ازیشان نبیند گناه"
  },
  {
    "poem_id": 1485,
    "vorder": 91,
    "position": 0,
    "text": "زبان آوری بود بسیار مغز"
  },
  {
    "poem_id": 1485,
    "vorder": 92,
    "position": 1,
    "text": "کجا برگشادی سخنهای نغز"
  },
  {
    "poem_id": 1485,
    "vorder": 93,
    "position": 0,
    "text": "چنین گفت کز خواب شاه جهان"
  },
  {
    "poem_id": 1485,
    "vorder": 94,
    "position": 1,
    "text": "به بیدرای آمد سپاهی گران"
  },
  {
    "poem_id": 1485,
    "vorder": 95,
    "position": 0,
    "text": "یکی شاهزاده به پیش اندرون"
  },
  {
    "poem_id": 1485,
    "vorder": 96,
    "position": 1,
    "text": "جهان دیده با وی بسی رهنمون"
  },
  {
    "poem_id": 1485,
    "vorder": 97,
    "position": 0,
    "text": "بران طالع او را گسی کرد شاه"
  },
  {
    "poem_id": 1485,
    "vorder": 98,
    "position": 1,
    "text": "که این بوم گردد بما بر تباه"
  },
  {
    "poem_id": 1485,
    "vorder": 99,
    "position": 0,
    "text": "اگر با سیاوش کند شاه جنگ"
  },
  {
    "poem_id": 1485,
    "vorder": 100,
    "position": 1,
    "text": "چو دیبه شود روی گیتی به رنگ"
  },
  {
    "poem_id": 1485,
    "vorder": 101,
    "position": 0,
    "text": "ز ترکان نماند کسی پارسا"
  },
  {
    "poem_id": 1485,
    "vorder": 102,
    "position": 1,
    "text": "غمی گردد از جنگ او پادشا"
  },
  {
    "poem_id": 1485,
    "vorder": 103,
    "position": 0,
    "text": "وگر او شود کشته بر دست شاه"
  },
  {
    "poem_id": 1485,
    "vorder": 104,
    "position": 1,
    "text": "به توران نماند سر و تاج و گاه"
  },
  {
    "poem_id": 1485,
    "vorder": 105,
    "position": 0,
    "text": "سراسر پر آشوب گردد زمین"
  },
  {
    "poem_id": 1485,
    "vorder": 106,
    "position": 1,
    "text": "ز بهر سیاوش بجنگ و به کین"
  },
  {
    "poem_id": 1485,
    "vorder": 107,
    "position": 0,
    "text": "بدانگاه یاد آیدت راستی"
  },
  {
    "poem_id": 1485,
    "vorder": 108,
    "position": 1,
    "text": "که ویران شود کشور از کاستی"
  },
  {
    "poem_id": 1485,
    "vorder": 109,
    "position": 0,
    "text": "جهاندار گر مرغ گردد بپر"
  },
  {
    "poem_id": 1485,
    "vorder": 110,
    "position": 1,
    "text": "برین چرخ گردان نیابد گذر"
  },
  {
    "poem_id": 1485,
    "vorder": 111,
    "position": 0,
    "text": "برین سان گذر کرد خواهد سپهر"
  },
  {
    "poem_id": 1485,
    "vorder": 112,
    "position": 1,
    "text": "گهی پر ز خشم و گهی پر ز مهر"
  },
  {
    "poem_id": 1485,
    "vorder": 113,
    "position": 0,
    "text": "غمی شد چو بشنید افراسیاب"
  },
  {
    "poem_id": 1485,
    "vorder": 114,
    "position": 1,
    "text": "نکرد ایچ بر جنگ جستن شتاب"
  },
  {
    "poem_id": 1485,
    "vorder": 115,
    "position": 0,
    "text": "به گرسیوز آن رازها برگشاد"
  },
  {
    "poem_id": 1485,
    "vorder": 116,
    "position": 1,
    "text": "نهفته سخنها بسی کرد یاد"
  },
  {
    "poem_id": 1485,
    "vorder": 117,
    "position": 0,
    "text": "که گر من به جنگ سیاوش سپاه"
  },
  {
    "poem_id": 1485,
    "vorder": 118,
    "position": 1,
    "text": "نرانم نیاید کسی کینه خواه"
  },
  {
    "poem_id": 1485,
    "vorder": 119,
    "position": 0,
    "text": "نه او کشته آید به جنگ و نه من"
  },
  {
    "poem_id": 1485,
    "vorder": 120,
    "position": 1,
    "text": "برآساید از گفت و گوی انجمن"
  },
  {
    "poem_id": 1485,
    "vorder": 121,
    "position": 0,
    "text": "نه کاووس خواهد ز من نیز کین"
  },
  {
    "poem_id": 1485,
    "vorder": 122,
    "position": 1,
    "text": "نه آشوب گیرد سراسر زمین"
  },
  {
    "poem_id": 1485,
    "vorder": 123,
    "position": 0,
    "text": "بجای جهان جستن و کارزار"
  },
  {
    "poem_id": 1485,
    "vorder": 124,
    "position": 1,
    "text": "مبادم به جز آشتی هیچ کار"
  },
  {
    "poem_id": 1485,
    "vorder": 125,
    "position": 0,
    "text": "فرستم به نزدیک او سیم و زر"
  },
  {
    "poem_id": 1485,
    "vorder": 126,
    "position": 1,
    "text": "همان تاج و تخت و فراوان گهر"
  },
  {
    "poem_id": 1485,
    "vorder": 127,
    "position": 0,
    "text": "مگر کاین بلاها ز من بگذرد"
  },
  {
    "poem_id": 1485,
    "vorder": 128,
    "position": 1,
    "text": "که ترسم روانم فرو پژمرد"
  },
  {
    "poem_id": 1485,
    "vorder": 129,
    "position": 0,
    "text": "چو چشم زمانه بدوزم به گنج"
  },
  {
    "poem_id": 1485,
    "vorder": 130,
    "position": 1,
    "text": "سزد گر سپهرم نخواهد به رنج"
  },
  {
    "poem_id": 1485,
    "vorder": 131,
    "position": 0,
    "text": "نخواهم زمانه جز آن کاو نوشت"
  },
  {
    "poem_id": 1485,
    "vorder": 132,
    "position": 1,
    "text": "چنان زیست باید که یزدان سرشت"
  },
  {
    "poem_id": 1485,
    "vorder": 133,
    "position": 0,
    "text": "چو بگذشت نیمی ز گردان سپهر"
  },
  {
    "poem_id": 1485,
    "vorder": 134,
    "position": 1,
    "text": "درخشنده خورشید بنمود چهر"
  },
  {
    "poem_id": 1485,
    "vorder": 135,
    "position": 0,
    "text": "بزرگان بدرگاه شاه آمدند"
  },
  {
    "poem_id": 1485,
    "vorder": 136,
    "position": 1,
    "text": "پرستنده و با کلاه آمدند"
  },
  {
    "poem_id": 1485,
    "vorder": 137,
    "position": 0,
    "text": "یکی انجمن ساخت با بخردان"
  },
  {
    "poem_id": 1485,
    "vorder": 138,
    "position": 1,
    "text": "هشیوار و کارآزموده ردان"
  },
  {
    "poem_id": 1485,
    "vorder": 139,
    "position": 0,
    "text": "بدیشان چنین گفت کز روزگار"
  },
  {
    "poem_id": 1485,
    "vorder": 140,
    "position": 1,
    "text": "نبینم همی بهره جز کارزار"
  },
  {
    "poem_id": 1485,
    "vorder": 141,
    "position": 0,
    "text": "بسا نامداران که بر دست من"
  },
  {
    "poem_id": 1485,
    "vorder": 142,
    "position": 1,
    "text": "تبه شد به جنگ اندرین انجمن"
  },
  {
    "poem_id": 1485,
    "vorder": 143,
    "position": 0,
    "text": "بسی شارستان گشت بیمارستان"
  },
  {
    "poem_id": 1485,
    "vorder": 144,
    "position": 1,
    "text": "بسی بوستان نیز شد خارستان"
  },
  {
    "poem_id": 1485,
    "vorder": 145,
    "position": 0,
    "text": "بسا باغ کان رزمگاه منست"
  },
  {
    "poem_id": 1485,
    "vorder": 146,
    "position": 1,
    "text": "به هر سو نشان سپاه منست"
  },
  {
    "poem_id": 1485,
    "vorder": 147,
    "position": 0,
    "text": "ز بیدادی شهریار جهان"
  },
  {
    "poem_id": 1485,
    "vorder": 148,
    "position": 1,
    "text": "همه نیکوی باشد اندر نهان"
  },
  {
    "poem_id": 1485,
    "vorder": 149,
    "position": 0,
    "text": "نزاید به هنگام در دشت گور"
  },
  {
    "poem_id": 1485,
    "vorder": 150,
    "position": 1,
    "text": "شود بچهٔ باز را دیده کور"
  },
  {
    "poem_id": 1485,
    "vorder": 151,
    "position": 0,
    "text": "نپرد ز پستان نخچیر شیر"
  },
  {
    "poem_id": 1485,
    "vorder": 152,
    "position": 1,
    "text": "شود آب در چشمهٔ خویش قیر"
  },
  {
    "poem_id": 1485,
    "vorder": 153,
    "position": 0,
    "text": "شود در جهان چشمهٔ آب خشک"
  },
  {
    "poem_id": 1485,
    "vorder": 154,
    "position": 1,
    "text": "نگیرد به نافه درون بوی مشک"
  },
  {
    "poem_id": 1485,
    "vorder": 155,
    "position": 0,
    "text": "ز کژی گریزان شود راستی"
  },
  {
    "poem_id": 1485,
    "vorder": 156,
    "position": 1,
    "text": "پدید آید از هر سوی کاستی"
  },
  {
    "poem_id": 1485,
    "vorder": 157,
    "position": 0,
    "text": "کنون دانش و داد یاد آوریم"
  },
  {
    "poem_id": 1485,
    "vorder": 158,
    "position": 1,
    "text": "بجای غم و رنج داد آوریم"
  },
  {
    "poem_id": 1485,
    "vorder": 159,
    "position": 0,
    "text": "برآساید از ما زمانی جهان"
  },
  {
    "poem_id": 1485,
    "vorder": 160,
    "position": 1,
    "text": "نباید که مرگ آید از ناگهان"
  },
  {
    "poem_id": 1485,
    "vorder": 161,
    "position": 0,
    "text": "دو بهر از جهان زیر پای منست"
  },
  {
    "poem_id": 1485,
    "vorder": 162,
    "position": 1,
    "text": "به ایران و توران سرای منست"
  },
  {
    "poem_id": 1485,
    "vorder": 163,
    "position": 0,
    "text": "نگه کن که چندین ز کندآوران"
  },
  {
    "poem_id": 1485,
    "vorder": 164,
    "position": 1,
    "text": "بیارند هر سال باژ گران"
  },
  {
    "poem_id": 1485,
    "vorder": 165,
    "position": 0,
    "text": "گر ایدونک باشید همداستان"
  },
  {
    "poem_id": 1485,
    "vorder": 166,
    "position": 1,
    "text": "به رستم فرستم یکی داستان"
  },
  {
    "poem_id": 1485,
    "vorder": 167,
    "position": 0,
    "text": "در آشتی با سیاووش نیز"
  },
  {
    "poem_id": 1485,
    "vorder": 168,
    "position": 1,
    "text": "بجویم فرستم بی‌اندازه چیز"
  },
  {
    "poem_id": 1485,
    "vorder": 169,
    "position": 0,
    "text": "سران یک به یک پاسخ آراستند"
  },
  {
    "poem_id": 1485,
    "vorder": 170,
    "position": 1,
    "text": "همی خوبی و راستی خواستند"
  },
  {
    "poem_id": 1485,
    "vorder": 171,
    "position": 0,
    "text": "که تو شهریاری و ما چون رهی"
  },
  {
    "poem_id": 1485,
    "vorder": 172,
    "position": 1,
    "text": "بران دل نهاده که فرمان دهی"
  },
  {
    "poem_id": 1485,
    "vorder": 173,
    "position": 0,
    "text": "همه بازگشتند سر پر ز داد"
  },
  {
    "poem_id": 1485,
    "vorder": 174,
    "position": 1,
    "text": "نیامد کسی را غم و رنج یاد"
  },
  {
    "poem_id": 1485,
    "vorder": 175,
    "position": 0,
    "text": "به گرسیوز آنگه چنین گفت شاه"
  },
  {
    "poem_id": 1485,
    "vorder": 176,
    "position": 1,
    "text": "که ببسیج کار و بپیمای راه"
  },
  {
    "poem_id": 1485,
    "vorder": 177,
    "position": 0,
    "text": "به زودی بساز و سخن را مه‌ایست"
  },
  {
    "poem_id": 1485,
    "vorder": 178,
    "position": 1,
    "text": "ز لشگر گزین کن سواری دویست"
  },
  {
    "poem_id": 1485,
    "vorder": 179,
    "position": 0,
    "text": "به نزد سیاووش برخواسته"
  },
  {
    "poem_id": 1485,
    "vorder": 180,
    "position": 1,
    "text": "ز هر چیز گنجی بیاراسته"
  },
  {
    "poem_id": 1485,
    "vorder": 181,
    "position": 0,
    "text": "از اسپان تازی به زرین ستام"
  },
  {
    "poem_id": 1485,
    "vorder": 182,
    "position": 1,
    "text": "ز شمشیر هندی به زرین نیام"
  },
  {
    "poem_id": 1485,
    "vorder": 183,
    "position": 0,
    "text": "یکی تاج پرگوهر شاهوار"
  },
  {
    "poem_id": 1485,
    "vorder": 184,
    "position": 1,
    "text": "ز گستردنی صد شتروار بار"
  },
  {
    "poem_id": 1485,
    "vorder": 185,
    "position": 0,
    "text": "غلام و کنیزک به بر هم دویست"
  },
  {
    "poem_id": 1485,
    "vorder": 186,
    "position": 1,
    "text": "بگویش که با تو مرا جنگ نیست"
  },
  {
    "poem_id": 1485,
    "vorder": 187,
    "position": 0,
    "text": "بپرسش فراوان و او را بگوی"
  },
  {
    "poem_id": 1485,
    "vorder": 188,
    "position": 1,
    "text": "که ما سوی ایران نکردیم روی"
  },
  {
    "poem_id": 1485,
    "vorder": 189,
    "position": 0,
    "text": "زمین تا لب رود جیحون مراست"
  },
  {
    "poem_id": 1485,
    "vorder": 190,
    "position": 1,
    "text": "به سغدیم و این پادشاهی جداست"
  },
  {
    "poem_id": 1485,
    "vorder": 191,
    "position": 0,
    "text": "همانست کز تور و سلم دلیر"
  },
  {
    "poem_id": 1485,
    "vorder": 192,
    "position": 1,
    "text": "زبر شد جهان آن کجا بود زیر"
  },
  {
    "poem_id": 1485,
    "vorder": 193,
    "position": 0,
    "text": "از ایرج که بر بیگنه کشته شد"
  },
  {
    "poem_id": 1485,
    "vorder": 194,
    "position": 1,
    "text": "ز مغز بزرگان خرد گشته شد"
  },
  {
    "poem_id": 1485,
    "vorder": 195,
    "position": 0,
    "text": "ز توران به ایران جدایی نبود"
  },
  {
    "poem_id": 1485,
    "vorder": 196,
    "position": 1,
    "text": "که باکین و جنگ آشنایی نبود"
  },
  {
    "poem_id": 1485,
    "vorder": 197,
    "position": 0,
    "text": "ز یزدان بران گونه دارم امید"
  },
  {
    "poem_id": 1485,
    "vorder": 198,
    "position": 1,
    "text": "که آید درود و خرام و نوید"
  },
  {
    "poem_id": 1485,
    "vorder": 199,
    "position": 0,
    "text": "برانگیخت از شهر ایران ترا"
  },
  {
    "poem_id": 1485,
    "vorder": 200,
    "position": 1,
    "text": "که بر مهر دید از دلیران ترا"
  },
  {
    "poem_id": 1485,
    "vorder": 201,
    "position": 0,
    "text": "به بخت تو آرام گیرد جهان"
  },
  {
    "poem_id": 1485,
    "vorder": 202,
    "position": 1,
    "text": "شود جنگ و ناخوبی اندر نهان"
  },
  {
    "poem_id": 1485,
    "vorder": 203,
    "position": 0,
    "text": "چو گرسیوز آید به نزدیک تو"
  },
  {
    "poem_id": 1485,
    "vorder": 204,
    "position": 1,
    "text": "به بار آید آن رای تاریک تو"
  },
  {
    "poem_id": 1485,
    "vorder": 205,
    "position": 0,
    "text": "چنان چون به گاه فریدون گرد"
  },
  {
    "poem_id": 1485,
    "vorder": 206,
    "position": 1,
    "text": "که گیتی ببخشش به گردان سپرد"
  },
  {
    "poem_id": 1485,
    "vorder": 207,
    "position": 0,
    "text": "ببخشیم و آن رای بازآوریم"
  },
  {
    "poem_id": 1485,
    "vorder": 208,
    "position": 1,
    "text": "ز جنگ و ز کین پای بازآوریم"
  },
  {
    "poem_id": 1485,
    "vorder": 209,
    "position": 0,
    "text": "تو شاهی و با شاه ایران بگوی"
  },
  {
    "poem_id": 1485,
    "vorder": 210,
    "position": 1,
    "text": "مگر نرم گردد سر جنگجوی"
  },
  {
    "poem_id": 1485,
    "vorder": 211,
    "position": 0,
    "text": "سخنها همی گوی با پیلتن"
  },
  {
    "poem_id": 1485,
    "vorder": 212,
    "position": 1,
    "text": "به چربی بسی داستانها بزن"
  },
  {
    "poem_id": 1485,
    "vorder": 213,
    "position": 0,
    "text": "برین هم نشان نزد رستم پیام"
  },
  {
    "poem_id": 1485,
    "vorder": 214,
    "position": 1,
    "text": "پرستنده و اسپ و زرین ستام"
  },
  {
    "poem_id": 1485,
    "vorder": 215,
    "position": 0,
    "text": "به نزدیک او هم چنین خواسته"
  },
  {
    "poem_id": 1485,
    "vorder": 216,
    "position": 1,
    "text": "ببر تا شود کار پیراسته"
  },
  {
    "poem_id": 1485,
    "vorder": 217,
    "position": 0,
    "text": "جز از تخت زرین که او شاه نیست"
  },
  {
    "poem_id": 1485,
    "vorder": 218,
    "position": 1,
    "text": "تن پهلوان از در گاه نیست"
  }
]