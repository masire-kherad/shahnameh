[
  {
    "poem_id": 88050,
    "vorder": 1,
    "position": 0,
    "text": "به هشتم ز گردان ناماوران"
  },
  {
    "poem_id": 88050,
    "vorder": 2,
    "position": 1,
    "text": "بشد ساخته زنگهٔ شاوران"
  },
  {
    "poem_id": 88050,
    "vorder": 3,
    "position": 0,
    "text": "که همرزمش از تخم اوخواست بود"
  },
  {
    "poem_id": 88050,
    "vorder": 4,
    "position": 1,
    "text": "که از جنگ هرگز نه بر کاست بود"
  },
  {
    "poem_id": 88050,
    "vorder": 5,
    "position": 0,
    "text": "گرفتند هر دو عمود گران"
  },
  {
    "poem_id": 88050,
    "vorder": 6,
    "position": 1,
    "text": "چو او خواست با زنگهٔ شاوران"
  },
  {
    "poem_id": 88050,
    "vorder": 7,
    "position": 0,
    "text": "بگشتند ز اندازه بیرون به جنگ"
  },
  {
    "poem_id": 88050,
    "vorder": 8,
    "position": 1,
    "text": "ز بس کوفتن گشت پیکار تنگ"
  },
  {
    "poem_id": 88050,
    "vorder": 9,
    "position": 0,
    "text": "فروماند اسبان جنگی ز تگ"
  },
  {
    "poem_id": 88050,
    "vorder": 10,
    "position": 1,
    "text": "که گفتی به تنشان نجنبید رگ"
  },
  {
    "poem_id": 88050,
    "vorder": 11,
    "position": 0,
    "text": "چو خورشید تابان ز گنبد بگشت"
  },
  {
    "poem_id": 88050,
    "vorder": 12,
    "position": 1,
    "text": "به کردار آهن بتفسید دشت"
  },
  {
    "poem_id": 88050,
    "vorder": 13,
    "position": 0,
    "text": "چنان تشنه گشتند کز جای خویش"
  },
  {
    "poem_id": 88050,
    "vorder": 14,
    "position": 1,
    "text": "نجنبید و ننهاد کس پای پیش"
  },
  {
    "poem_id": 88050,
    "vorder": 15,
    "position": 0,
    "text": "زبان برگشادند یک‌ با دگر"
  },
  {
    "poem_id": 88050,
    "vorder": 16,
    "position": 1,
    "text": "که اکنون ز گرمی بسوزد جگر"
  },
  {
    "poem_id": 88050,
    "vorder": 17,
    "position": 0,
    "text": "بباید برآسود و دم برزدن"
  },
  {
    "poem_id": 88050,
    "vorder": 18,
    "position": 1,
    "text": "پس آنگه سوی جنگ بازآمدن"
  },
  {
    "poem_id": 88050,
    "vorder": 19,
    "position": 0,
    "text": "برفتند و اسبان جنگی به جای"
  },
  {
    "poem_id": 88050,
    "vorder": 20,
    "position": 1,
    "text": "فراز آوریدند و بستند پای"
  },
  {
    "poem_id": 88050,
    "vorder": 21,
    "position": 0,
    "text": "به آسودگی باز برخاستند"
  },
  {
    "poem_id": 88050,
    "vorder": 22,
    "position": 1,
    "text": "به پیکار کینه بیاراستند"
  },
  {
    "poem_id": 88050,
    "vorder": 23,
    "position": 0,
    "text": "به کردار آتش ز نیزه سوار"
  },
  {
    "poem_id": 88050,
    "vorder": 24,
    "position": 1,
    "text": "همی گشت بر مرکز کارزار"
  },
  {
    "poem_id": 88050,
    "vorder": 25,
    "position": 0,
    "text": "بدآنگه که زنگه بر او دست یافت"
  },
  {
    "poem_id": 88050,
    "vorder": 26,
    "position": 1,
    "text": "سنان سوی او کرد و اندر شتافت"
  },
  {
    "poem_id": 88050,
    "vorder": 27,
    "position": 0,
    "text": "یکی نیزه زد بر کمرگاه اوی"
  },
  {
    "poem_id": 88050,
    "vorder": 28,
    "position": 1,
    "text": "کز اسبش نگون کرد و برزد به روی"
  },
  {
    "poem_id": 88050,
    "vorder": 29,
    "position": 0,
    "text": "چو رعد خروشان یکی ویله کرد"
  },
  {
    "poem_id": 88050,
    "vorder": 30,
    "position": 1,
    "text": "که گفتی بدرید دشت نبرد"
  },
  {
    "poem_id": 88050,
    "vorder": 31,
    "position": 0,
    "text": "فرود آمد از باره شد نزد اوی"
  },
  {
    "poem_id": 88050,
    "vorder": 32,
    "position": 1,
    "text": "بر آن خاک تفته کشیدش به روی"
  },
  {
    "poem_id": 88050,
    "vorder": 33,
    "position": 0,
    "text": "مر او را به چاره ز روی زمین"
  },
  {
    "poem_id": 88050,
    "vorder": 34,
    "position": 1,
    "text": "نگون اندر افگند بر پشت زین"
  },
  {
    "poem_id": 88050,
    "vorder": 35,
    "position": 0,
    "text": "نشست از بر اسب و بالا گرفت"
  },
  {
    "poem_id": 88050,
    "vorder": 36,
    "position": 1,
    "text": "به ترکان چه آمد ز بخت ای شگفت"
  },
  {
    "poem_id": 88050,
    "vorder": 37,
    "position": 0,
    "text": "بر آن کوه فرخ برآمد ز پست"
  },
  {
    "poem_id": 88050,
    "vorder": 38,
    "position": 1,
    "text": "یکی گرگ پیکر درفشی به دست"
  },
  {
    "poem_id": 88050,
    "vorder": 39,
    "position": 0,
    "text": "بشد پیش یاران و کرد آفرین"
  },
  {
    "poem_id": 88050,
    "vorder": 40,
    "position": 1,
    "text": "ابر شاه و بر پهلوان زمین"
  }
]