[
  {
    "poem_id": 88030,
    "vorder": 1,
    "position": 0,
    "text": "نشست از بر زین سپیده‌دمان"
  },
  {
    "poem_id": 88030,
    "vorder": 2,
    "position": 1,
    "text": "چو شیر ژیان با یکی ترجمان"
  },
  {
    "poem_id": 88030,
    "vorder": 3,
    "position": 0,
    "text": "بیامد به نزدیک ایران سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 4,
    "position": 1,
    "text": "پر از جنگ دل سر پر از کین شاه"
  },
  {
    "poem_id": 88030,
    "vorder": 5,
    "position": 0,
    "text": "چو پیران بدانست کو شد بجنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 6,
    "position": 1,
    "text": "بر او بر جهان گشت ز اندوه تنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 7,
    "position": 0,
    "text": "بجوشیدش از درد هومان جگر"
  },
  {
    "poem_id": 88030,
    "vorder": 8,
    "position": 1,
    "text": "یکی داستان یاد کرد از پدر"
  },
  {
    "poem_id": 88030,
    "vorder": 9,
    "position": 0,
    "text": "که دانا به هر کار سازد درنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 10,
    "position": 1,
    "text": "سر اندر نیارد به پیکار و ننگ"
  },
  {
    "poem_id": 88030,
    "vorder": 11,
    "position": 0,
    "text": "سبکسار تندی نماید نخست"
  },
  {
    "poem_id": 88030,
    "vorder": 12,
    "position": 1,
    "text": "به فرجام کار انده آرد درست"
  },
  {
    "poem_id": 88030,
    "vorder": 13,
    "position": 0,
    "text": "زبانی که اندر سرش مغز نیست"
  },
  {
    "poem_id": 88030,
    "vorder": 14,
    "position": 1,
    "text": "اگر در بارد همان نغز نیست"
  },
  {
    "poem_id": 88030,
    "vorder": 15,
    "position": 0,
    "text": "چو هومان بدین رزم تندی نمود"
  },
  {
    "poem_id": 88030,
    "vorder": 16,
    "position": 1,
    "text": "ندانم چه آرد به فرجام سود"
  },
  {
    "poem_id": 88030,
    "vorder": 17,
    "position": 0,
    "text": "جهان داورش باد فریادرس"
  },
  {
    "poem_id": 88030,
    "vorder": 18,
    "position": 1,
    "text": "جز اویش نبینم همی یار کس"
  },
  {
    "poem_id": 88030,
    "vorder": 19,
    "position": 0,
    "text": "چو هومان ویسه بدان رزمگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 20,
    "position": 1,
    "text": "که گودرز کشواد بد با سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 21,
    "position": 0,
    "text": "بیامد که جوید ز گردان نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 22,
    "position": 1,
    "text": "نگهبان لشکر بدو بازخورد"
  },
  {
    "poem_id": 88030,
    "vorder": 23,
    "position": 0,
    "text": "طلایه بیامد بر ترجمان"
  },
  {
    "poem_id": 88030,
    "vorder": 24,
    "position": 1,
    "text": "سواران ایران همه بدگمان"
  },
  {
    "poem_id": 88030,
    "vorder": 25,
    "position": 0,
    "text": "بپرسید کین مرد پرخاشجوی"
  },
  {
    "poem_id": 88030,
    "vorder": 26,
    "position": 1,
    "text": "به خیره به دشت اندر آورده روی"
  },
  {
    "poem_id": 88030,
    "vorder": 27,
    "position": 0,
    "text": "کجا رفت خواهد همی چون نوند"
  },
  {
    "poem_id": 88030,
    "vorder": 28,
    "position": 1,
    "text": "به چنگ اندرون گرز و بر زین کمند"
  },
  {
    "poem_id": 88030,
    "vorder": 29,
    "position": 0,
    "text": "به ایرانیان گفت پس ترجمان"
  },
  {
    "poem_id": 88030,
    "vorder": 30,
    "position": 1,
    "text": "که آمد گه گرز و تیر و کمان"
  },
  {
    "poem_id": 88030,
    "vorder": 31,
    "position": 0,
    "text": "که این شیردل نامبردار مرد"
  },
  {
    "poem_id": 88030,
    "vorder": 32,
    "position": 1,
    "text": "همی با شما کرد خواهد نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 33,
    "position": 0,
    "text": "سر ویسگان است هومان به نام"
  },
  {
    "poem_id": 88030,
    "vorder": 34,
    "position": 1,
    "text": "که تیغش دل شیر دارد نیام"
  },
  {
    "poem_id": 88030,
    "vorder": 35,
    "position": 0,
    "text": "چو دیدند ایرانیان گرز اوی"
  },
  {
    "poem_id": 88030,
    "vorder": 36,
    "position": 1,
    "text": "کمر بستن خسروی برز اوی"
  },
  {
    "poem_id": 88030,
    "vorder": 37,
    "position": 0,
    "text": "همه دست نیزه گزاران ز کار"
  },
  {
    "poem_id": 88030,
    "vorder": 38,
    "position": 1,
    "text": "فروماند از فر آن نامدار"
  },
  {
    "poem_id": 88030,
    "vorder": 39,
    "position": 0,
    "text": "همه یکسره بازگشتند از اوی"
  },
  {
    "poem_id": 88030,
    "vorder": 40,
    "position": 1,
    "text": "سوی ترجمانش نهادند روی"
  },
  {
    "poem_id": 88030,
    "vorder": 41,
    "position": 0,
    "text": "که رو پیش هومان به ترکی زبان"
  },
  {
    "poem_id": 88030,
    "vorder": 42,
    "position": 1,
    "text": "همه گفتهٔ ما بر او بر بخوان"
  },
  {
    "poem_id": 88030,
    "vorder": 43,
    "position": 0,
    "text": "که ما را به جنگ تو آهنگ نیست"
  },
  {
    "poem_id": 88030,
    "vorder": 44,
    "position": 1,
    "text": "ز گودرز دستوری جنگ نیست"
  },
  {
    "poem_id": 88030,
    "vorder": 45,
    "position": 0,
    "text": "اگر جنگ جوید گشاده است راه"
  },
  {
    "poem_id": 88030,
    "vorder": 46,
    "position": 1,
    "text": "سوی نامور پهلوان سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 47,
    "position": 0,
    "text": "ز سالار گردان و گردنکشان"
  },
  {
    "poem_id": 88030,
    "vorder": 48,
    "position": 1,
    "text": "به هومان بدادند یک یک نشان"
  },
  {
    "poem_id": 88030,
    "vorder": 49,
    "position": 0,
    "text": "که گردان کجایند و مهتر کجاست"
  },
  {
    "poem_id": 88030,
    "vorder": 50,
    "position": 1,
    "text": "که دارد چپ لشکر و دست راست"
  },
  {
    "poem_id": 88030,
    "vorder": 51,
    "position": 0,
    "text": "وز آن پس هیونی تگاور دمان"
  },
  {
    "poem_id": 88030,
    "vorder": 52,
    "position": 1,
    "text": "طلایه برافگند زی پهلوان"
  },
  {
    "poem_id": 88030,
    "vorder": 53,
    "position": 0,
    "text": "که هومان از آن رزمگه چون پلنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 54,
    "position": 1,
    "text": "سوی پهلوان آمد ایدر بجنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 55,
    "position": 0,
    "text": "چو هومان ز نزد سواران برفت"
  },
  {
    "poem_id": 88030,
    "vorder": 56,
    "position": 1,
    "text": "بیامد به نزدیک رهام تفت"
  },
  {
    "poem_id": 88030,
    "vorder": 57,
    "position": 0,
    "text": "وز آنجا خروشی برآورد سخت"
  },
  {
    "poem_id": 88030,
    "vorder": 58,
    "position": 1,
    "text": "که ای پور سالار بیدار بخت"
  },
  {
    "poem_id": 88030,
    "vorder": 59,
    "position": 0,
    "text": "چپ لشکر و چنگ شیران توی"
  },
  {
    "poem_id": 88030,
    "vorder": 60,
    "position": 1,
    "text": "نگهبان سالار ایران توی"
  },
  {
    "poem_id": 88030,
    "vorder": 61,
    "position": 0,
    "text": "بجنبان عنان اندر این رزمگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 62,
    "position": 1,
    "text": "میان دو صف برکشیده سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 63,
    "position": 0,
    "text": "به آورد با من ببایدت گشت"
  },
  {
    "poem_id": 88030,
    "vorder": 64,
    "position": 1,
    "text": "سوی رود خواهی وگر سوی دشت"
  },
  {
    "poem_id": 88030,
    "vorder": 65,
    "position": 0,
    "text": "وگر تو نیابی مگر گستهم"
  },
  {
    "poem_id": 88030,
    "vorder": 66,
    "position": 1,
    "text": "بیاید دمان با فروهل به هم"
  },
  {
    "poem_id": 88030,
    "vorder": 67,
    "position": 0,
    "text": "که جوید نبردم ز جنگاوران"
  },
  {
    "poem_id": 88030,
    "vorder": 68,
    "position": 1,
    "text": "به تیغ و سنان و به گرز گران"
  },
  {
    "poem_id": 88030,
    "vorder": 69,
    "position": 0,
    "text": "هر آن کس که پیش من آید به کین"
  },
  {
    "poem_id": 88030,
    "vorder": 70,
    "position": 1,
    "text": "زمانه بر او بر نوردد زمین"
  },
  {
    "poem_id": 88030,
    "vorder": 71,
    "position": 0,
    "text": "وگر تیغ ما را ببیند به جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 72,
    "position": 1,
    "text": "بدرد دل شیر و چرم پلنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 73,
    "position": 0,
    "text": "چنین داد رهام پاسخ بدوی"
  },
  {
    "poem_id": 88030,
    "vorder": 74,
    "position": 1,
    "text": "که ای نامور گرد پرخاشجوی"
  },
  {
    "poem_id": 88030,
    "vorder": 75,
    "position": 0,
    "text": "ز ترکان ترا بخرد انگاشتم"
  },
  {
    "poem_id": 88030,
    "vorder": 76,
    "position": 1,
    "text": "از این سان که هستی نپنداشتم"
  },
  {
    "poem_id": 88030,
    "vorder": 77,
    "position": 0,
    "text": "که تنها بدین رزمگاه آمدی"
  },
  {
    "poem_id": 88030,
    "vorder": 78,
    "position": 1,
    "text": "دلاور به پیش سپاه آمدی"
  },
  {
    "poem_id": 88030,
    "vorder": 79,
    "position": 0,
    "text": "بر آنی که اندر جهان تیغ‌دار"
  },
  {
    "poem_id": 88030,
    "vorder": 80,
    "position": 1,
    "text": "نبندد کمر چون تو دیگر سوار"
  },
  {
    "poem_id": 88030,
    "vorder": 81,
    "position": 0,
    "text": "یکی داستان از کیان یاد کن"
  },
  {
    "poem_id": 88030,
    "vorder": 82,
    "position": 1,
    "text": "ز فام خرد گردن آزاد کن"
  },
  {
    "poem_id": 88030,
    "vorder": 83,
    "position": 0,
    "text": "که هر کو به جنگ اندر آید نخست"
  },
  {
    "poem_id": 88030,
    "vorder": 84,
    "position": 1,
    "text": "ره بازگشتن ببایدش جست"
  },
  {
    "poem_id": 88030,
    "vorder": 85,
    "position": 0,
    "text": "از اینها که تو نام بردی بجنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 86,
    "position": 1,
    "text": "همه جنگ را تیز دارند چنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 87,
    "position": 0,
    "text": "ولیکن چو فرمان سالار شاه"
  },
  {
    "poem_id": 88030,
    "vorder": 88,
    "position": 1,
    "text": "نباشد نسازد کسی رزمگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 89,
    "position": 0,
    "text": "اگر جنگ گردان بجویی همی"
  },
  {
    "poem_id": 88030,
    "vorder": 90,
    "position": 1,
    "text": "سوی پهلوان چون بپویی همی"
  },
  {
    "poem_id": 88030,
    "vorder": 91,
    "position": 0,
    "text": "ز گودرز دستوری جنگ خواه"
  },
  {
    "poem_id": 88030,
    "vorder": 92,
    "position": 1,
    "text": "پس از ما به جنگ اندر آهنگ خواه"
  },
  {
    "poem_id": 88030,
    "vorder": 93,
    "position": 0,
    "text": "بدو گفت هومان که خیره مگوی"
  },
  {
    "poem_id": 88030,
    "vorder": 94,
    "position": 1,
    "text": "بدین روی با من بهانه مجوی"
  },
  {
    "poem_id": 88030,
    "vorder": 95,
    "position": 0,
    "text": "تو این رزم را جای مردان گزین"
  },
  {
    "poem_id": 88030,
    "vorder": 96,
    "position": 1,
    "text": "نه مرد سوارانی و دشت کین"
  },
  {
    "poem_id": 88030,
    "vorder": 97,
    "position": 0,
    "text": "وز آنجا به قلب سپه برگذشت"
  },
  {
    "poem_id": 88030,
    "vorder": 98,
    "position": 1,
    "text": "دمان تا بدان روی لشکر گذشت"
  },
  {
    "poem_id": 88030,
    "vorder": 99,
    "position": 0,
    "text": "به نزد فریبرز با ترجمان"
  },
  {
    "poem_id": 88030,
    "vorder": 100,
    "position": 1,
    "text": "بیامد به کردار باد دمان"
  },
  {
    "poem_id": 88030,
    "vorder": 101,
    "position": 0,
    "text": "یکی برخروشید کای بدنشان"
  },
  {
    "poem_id": 88030,
    "vorder": 102,
    "position": 1,
    "text": "فروبرده گردن ز گردنکشان"
  },
  {
    "poem_id": 88030,
    "vorder": 103,
    "position": 0,
    "text": "سواران و پیلان و زرینه کفش"
  },
  {
    "poem_id": 88030,
    "vorder": 104,
    "position": 1,
    "text": "ترا بود با کاویانی درفش"
  },
  {
    "poem_id": 88030,
    "vorder": 105,
    "position": 0,
    "text": "به ترکان سپردی به روز نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 106,
    "position": 1,
    "text": "یلانت به ایران نخوانند مرد"
  },
  {
    "poem_id": 88030,
    "vorder": 107,
    "position": 0,
    "text": "چو سالار باشی شوی زیردست"
  },
  {
    "poem_id": 88030,
    "vorder": 108,
    "position": 1,
    "text": "کمر بندگی را ببایدت بست"
  },
  {
    "poem_id": 88030,
    "vorder": 109,
    "position": 0,
    "text": "سیاووش رد را برادر توی"
  },
  {
    "poem_id": 88030,
    "vorder": 110,
    "position": 1,
    "text": "به گوهر ز سالار برتر توی"
  },
  {
    "poem_id": 88030,
    "vorder": 111,
    "position": 0,
    "text": "تو باشی سزاوار کین خواستن"
  },
  {
    "poem_id": 88030,
    "vorder": 112,
    "position": 1,
    "text": "به کینه ترا باید آراستن"
  },
  {
    "poem_id": 88030,
    "vorder": 113,
    "position": 0,
    "text": "یکی با من اکنون به آوردگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 114,
    "position": 1,
    "text": "ببایدت گشتن به پیش سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 115,
    "position": 0,
    "text": "به خورشید تابان برآیدت نام"
  },
  {
    "poem_id": 88030,
    "vorder": 116,
    "position": 1,
    "text": "که پیش من اندر گذاری تو گام"
  },
  {
    "poem_id": 88030,
    "vorder": 117,
    "position": 0,
    "text": "وگر تو نیایی به جنگم رواست"
  },
  {
    "poem_id": 88030,
    "vorder": 118,
    "position": 1,
    "text": "زواره گرازه نگر تا کجاست"
  },
  {
    "poem_id": 88030,
    "vorder": 119,
    "position": 0,
    "text": "کسی را ز گردان به پیش من آر"
  },
  {
    "poem_id": 88030,
    "vorder": 120,
    "position": 1,
    "text": "که باشد ز ایرانیان نامدار"
  },
  {
    "poem_id": 88030,
    "vorder": 121,
    "position": 0,
    "text": "چنین داد پاسخ فریبرز باز"
  },
  {
    "poem_id": 88030,
    "vorder": 122,
    "position": 1,
    "text": "که با شیر درنده کینه مساز"
  },
  {
    "poem_id": 88030,
    "vorder": 123,
    "position": 0,
    "text": "چنینست فرجام روز نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 124,
    "position": 1,
    "text": "یکی شاد و پیروز و دیگر به درد"
  },
  {
    "poem_id": 88030,
    "vorder": 125,
    "position": 0,
    "text": "به پیروزی اندر بترس از گزند"
  },
  {
    "poem_id": 88030,
    "vorder": 126,
    "position": 1,
    "text": "که یکسان نگردد سپهر بلند"
  },
  {
    "poem_id": 88030,
    "vorder": 127,
    "position": 0,
    "text": "درفش ار ز من شاه بستد رواست"
  },
  {
    "poem_id": 88030,
    "vorder": 128,
    "position": 1,
    "text": "بدان داد پیلان و لشکر که خواست"
  },
  {
    "poem_id": 88030,
    "vorder": 129,
    "position": 0,
    "text": "به کین سیاوش پس از کیقباد"
  },
  {
    "poem_id": 88030,
    "vorder": 130,
    "position": 1,
    "text": "کسی کو کلاه مهی برنهاد"
  },
  {
    "poem_id": 88030,
    "vorder": 131,
    "position": 0,
    "text": "کمر بست تا گیتی آباد کرد"
  },
  {
    "poem_id": 88030,
    "vorder": 132,
    "position": 1,
    "text": "سپهدار گودرز کشواد کرد"
  },
  {
    "poem_id": 88030,
    "vorder": 133,
    "position": 0,
    "text": "همیشه به پیش کیان کینه‌خواه"
  },
  {
    "poem_id": 88030,
    "vorder": 134,
    "position": 1,
    "text": "پدر بر پدر نیو و سالار شاه"
  },
  {
    "poem_id": 88030,
    "vorder": 135,
    "position": 0,
    "text": "و دیگر که از گرز او بی‌گمان"
  },
  {
    "poem_id": 88030,
    "vorder": 136,
    "position": 1,
    "text": "سرآید به سالارتان بر زمان"
  },
  {
    "poem_id": 88030,
    "vorder": 137,
    "position": 0,
    "text": "سپه را به ویسه است فرمان جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 138,
    "position": 1,
    "text": "بدو بازگردد همه نام و ننگ"
  },
  {
    "poem_id": 88030,
    "vorder": 139,
    "position": 0,
    "text": "اگر با توام جنگ فرمان دهد"
  },
  {
    "poem_id": 88030,
    "vorder": 140,
    "position": 1,
    "text": "دلم پر ز دردست درمان دهد"
  },
  {
    "poem_id": 88030,
    "vorder": 141,
    "position": 0,
    "text": "ببینی که من سر چگونه ز ننگ"
  },
  {
    "poem_id": 88030,
    "vorder": 142,
    "position": 1,
    "text": "برآرم چو پای اندر آرم بجنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 143,
    "position": 0,
    "text": "چنین پاسخش داد هومان که بس"
  },
  {
    "poem_id": 88030,
    "vorder": 144,
    "position": 1,
    "text": "به گفتار بینم ترا دسترس"
  },
  {
    "poem_id": 88030,
    "vorder": 145,
    "position": 0,
    "text": "بدین تیغ کاندر میان بسته‌ای"
  },
  {
    "poem_id": 88030,
    "vorder": 146,
    "position": 1,
    "text": "گیا بر که از جنگ خود رسته‌ای"
  },
  {
    "poem_id": 88030,
    "vorder": 147,
    "position": 0,
    "text": "بدین گرز جویی همی کارزار"
  },
  {
    "poem_id": 88030,
    "vorder": 148,
    "position": 1,
    "text": "که بر ترگ و جوشن نیاید به کار"
  },
  {
    "poem_id": 88030,
    "vorder": 149,
    "position": 0,
    "text": "وز آنجا بدان خیرگی بازگشت"
  },
  {
    "poem_id": 88030,
    "vorder": 150,
    "position": 1,
    "text": "تو گفتی مگر شیر بدساز گشت"
  },
  {
    "poem_id": 88030,
    "vorder": 151,
    "position": 0,
    "text": "کمربستهٔ کین آزادگان"
  },
  {
    "poem_id": 88030,
    "vorder": 152,
    "position": 1,
    "text": "به نزدیک گودرز کشوادگان"
  },
  {
    "poem_id": 88030,
    "vorder": 153,
    "position": 0,
    "text": "بیامد یکی بانگ برزد بلند"
  },
  {
    "poem_id": 88030,
    "vorder": 154,
    "position": 1,
    "text": "که ای برمنش مهتر دیوبند"
  },
  {
    "poem_id": 88030,
    "vorder": 155,
    "position": 0,
    "text": "شنیدم همه هرچ گفتی به شاه"
  },
  {
    "poem_id": 88030,
    "vorder": 156,
    "position": 1,
    "text": "وز آن پس کشیدی سپه را به راه"
  },
  {
    "poem_id": 88030,
    "vorder": 157,
    "position": 0,
    "text": "چنین بود با شاه پیمان تو"
  },
  {
    "poem_id": 88030,
    "vorder": 158,
    "position": 1,
    "text": "به پیران سالار فرمان تو"
  },
  {
    "poem_id": 88030,
    "vorder": 159,
    "position": 0,
    "text": "فرستاده کامد به توران سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 160,
    "position": 1,
    "text": "گزین پور تو گیو لشکرپناه"
  },
  {
    "poem_id": 88030,
    "vorder": 161,
    "position": 0,
    "text": "از آن پس که سوگند خوردی به گاه"
  },
  {
    "poem_id": 88030,
    "vorder": 162,
    "position": 1,
    "text": "به خورشید و ماه و به تخت و کلاه"
  },
  {
    "poem_id": 88030,
    "vorder": 163,
    "position": 0,
    "text": "که گر چشم من در گه کارزار"
  },
  {
    "poem_id": 88030,
    "vorder": 164,
    "position": 1,
    "text": "به پیران برافتد برآرم دمار"
  },
  {
    "poem_id": 88030,
    "vorder": 165,
    "position": 0,
    "text": "چو شیر ژیان لشکر آراستی"
  },
  {
    "poem_id": 88030,
    "vorder": 166,
    "position": 1,
    "text": "همی بآرزو جنگ ما خواستی"
  },
  {
    "poem_id": 88030,
    "vorder": 167,
    "position": 0,
    "text": "کنون از پس کوه چون مستمند"
  },
  {
    "poem_id": 88030,
    "vorder": 168,
    "position": 1,
    "text": "نشستی به کردار غرم نژند"
  },
  {
    "poem_id": 88030,
    "vorder": 169,
    "position": 0,
    "text": "به کردار نخچیر کز شرزه شیر"
  },
  {
    "poem_id": 88030,
    "vorder": 170,
    "position": 1,
    "text": "گریزان و شیر از پس اندر دلیر"
  },
  {
    "poem_id": 88030,
    "vorder": 171,
    "position": 0,
    "text": "گزیند به بیشه درون جای تنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 172,
    "position": 1,
    "text": "نجوید ز تیمار جان نام و ننگ"
  },
  {
    "poem_id": 88030,
    "vorder": 173,
    "position": 0,
    "text": "یکی لشکرت را به هامون گذار"
  },
  {
    "poem_id": 88030,
    "vorder": 174,
    "position": 1,
    "text": "چه داری سپاه از پس کوهسار"
  },
  {
    "poem_id": 88030,
    "vorder": 175,
    "position": 0,
    "text": "چنین بود پیمانت با شهریار"
  },
  {
    "poem_id": 88030,
    "vorder": 176,
    "position": 1,
    "text": "که بر کینه گه کوه گیری حصار"
  },
  {
    "poem_id": 88030,
    "vorder": 177,
    "position": 0,
    "text": "بدو گفت گودرز کاندیشه کن"
  },
  {
    "poem_id": 88030,
    "vorder": 178,
    "position": 1,
    "text": "که باشد سزا با تو گفتن سخن"
  },
  {
    "poem_id": 88030,
    "vorder": 179,
    "position": 0,
    "text": "چو پاسخ بیابی کنون ز انجمن"
  },
  {
    "poem_id": 88030,
    "vorder": 180,
    "position": 1,
    "text": "به بی دانشی بر نهی این سخن"
  },
  {
    "poem_id": 88030,
    "vorder": 181,
    "position": 0,
    "text": "تو بشناس کز شاه فرمان من"
  },
  {
    "poem_id": 88030,
    "vorder": 182,
    "position": 1,
    "text": "همین بود سوگند و پیمان من"
  },
  {
    "poem_id": 88030,
    "vorder": 183,
    "position": 0,
    "text": "کنون آمدم با سپاهی گران"
  },
  {
    "poem_id": 88030,
    "vorder": 184,
    "position": 1,
    "text": "از ایران گزیده دلاور سران"
  },
  {
    "poem_id": 88030,
    "vorder": 185,
    "position": 0,
    "text": "شما هم به کردار روباه پیر"
  },
  {
    "poem_id": 88030,
    "vorder": 186,
    "position": 1,
    "text": "به بیشه در از بیم نخچیرگیر"
  },
  {
    "poem_id": 88030,
    "vorder": 187,
    "position": 0,
    "text": "همی چاره سازید و دستان و بند"
  },
  {
    "poem_id": 88030,
    "vorder": 188,
    "position": 1,
    "text": "گریزان ز گرز و سنان و کمند"
  },
  {
    "poem_id": 88030,
    "vorder": 189,
    "position": 0,
    "text": "دلیری مکن جنگ ما را مخواه"
  },
  {
    "poem_id": 88030,
    "vorder": 190,
    "position": 1,
    "text": "که روباه با شیر ناید به راه"
  },
  {
    "poem_id": 88030,
    "vorder": 191,
    "position": 0,
    "text": "چو هومان ز گودرز پاسخ شنید"
  },
  {
    "poem_id": 88030,
    "vorder": 192,
    "position": 1,
    "text": "چو شیر اندر آن رزمگه بردمید"
  },
  {
    "poem_id": 88030,
    "vorder": 193,
    "position": 0,
    "text": "به گودرز گفت ار نیایی بجنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 194,
    "position": 1,
    "text": "تو با من نه زانست کایدت ننگ"
  },
  {
    "poem_id": 88030,
    "vorder": 195,
    "position": 0,
    "text": "از آن پس که جنگ پشن دیده‌ای"
  },
  {
    "poem_id": 88030,
    "vorder": 196,
    "position": 1,
    "text": "سر از رزم ترکان بپیچیده‌ای"
  },
  {
    "poem_id": 88030,
    "vorder": 197,
    "position": 0,
    "text": "به لاون به جنگ آزمودی مرا"
  },
  {
    "poem_id": 88030,
    "vorder": 198,
    "position": 1,
    "text": "به آوردگه بر ستودی مرا"
  },
  {
    "poem_id": 88030,
    "vorder": 199,
    "position": 0,
    "text": "ار ایدونک هست اینک گویی همی"
  },
  {
    "poem_id": 88030,
    "vorder": 200,
    "position": 1,
    "text": "وز این کینه کردار جویی همی"
  },
  {
    "poem_id": 88030,
    "vorder": 201,
    "position": 0,
    "text": "یکی برگزین از میان سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 202,
    "position": 1,
    "text": "که با من بگردد به آوردگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 203,
    "position": 0,
    "text": "که من از فریبرز و رهام جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 204,
    "position": 1,
    "text": "بجستم به سان دلاور پلنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 205,
    "position": 0,
    "text": "بگشتم سراسر همه انجمن"
  },
  {
    "poem_id": 88030,
    "vorder": 206,
    "position": 1,
    "text": "نیاید ز گردان کسی پیش من"
  },
  {
    "poem_id": 88030,
    "vorder": 207,
    "position": 0,
    "text": "به گودرز بد بند پیکارشان"
  },
  {
    "poem_id": 88030,
    "vorder": 208,
    "position": 1,
    "text": "شنیدن نه ارزید گفتارشان"
  },
  {
    "poem_id": 88030,
    "vorder": 209,
    "position": 0,
    "text": "تو آنی که گویی به روز نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 210,
    "position": 1,
    "text": "به خنجر کنم لاله بر کوه زرد"
  },
  {
    "poem_id": 88030,
    "vorder": 211,
    "position": 0,
    "text": "یکی با من اکنون بدین رزمگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 212,
    "position": 1,
    "text": "بگرد و به گرز گران کینه‌خواه"
  },
  {
    "poem_id": 88030,
    "vorder": 213,
    "position": 0,
    "text": "فراوان پسر داری ای نامور"
  },
  {
    "poem_id": 88030,
    "vorder": 214,
    "position": 1,
    "text": "همه بسته بر جنگ ما بر کمر"
  },
  {
    "poem_id": 88030,
    "vorder": 215,
    "position": 0,
    "text": "یکی را فرستی بر من به جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 216,
    "position": 1,
    "text": "اگر جنگ‌جویی چه جویی درنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 217,
    "position": 0,
    "text": "پس اندیشه کرد اندران پهلوان"
  },
  {
    "poem_id": 88030,
    "vorder": 218,
    "position": 1,
    "text": "که پیشش که آید به جنگ از گوان"
  },
  {
    "poem_id": 88030,
    "vorder": 219,
    "position": 0,
    "text": "گر از نامداران هژبری دمان"
  },
  {
    "poem_id": 88030,
    "vorder": 220,
    "position": 1,
    "text": "فرستم به نزدیک این بدگمان"
  },
  {
    "poem_id": 88030,
    "vorder": 221,
    "position": 0,
    "text": "شود کشته هومان بر این رزمگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 222,
    "position": 1,
    "text": "ز ترکان نیاید کسی کینه‌خواه"
  },
  {
    "poem_id": 88030,
    "vorder": 223,
    "position": 0,
    "text": "دل پهلوانش بپیچد به درد"
  },
  {
    "poem_id": 88030,
    "vorder": 224,
    "position": 1,
    "text": "از آن پس به تندی نجوید نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 225,
    "position": 0,
    "text": "سپاهش به کوه کنابد شود"
  },
  {
    "poem_id": 88030,
    "vorder": 226,
    "position": 1,
    "text": "به جنگ اندرون دست ما بد شود"
  },
  {
    "poem_id": 88030,
    "vorder": 227,
    "position": 0,
    "text": "ور از نامداران این انجمن"
  },
  {
    "poem_id": 88030,
    "vorder": 228,
    "position": 1,
    "text": "یکی کم شود گم شود نام من"
  },
  {
    "poem_id": 88030,
    "vorder": 229,
    "position": 0,
    "text": "شکسته شود دل گوان را به جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 230,
    "position": 1,
    "text": "نسازند زان پس به جایی درنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 231,
    "position": 0,
    "text": "همان به که با او نسازیم کین"
  },
  {
    "poem_id": 88030,
    "vorder": 232,
    "position": 1,
    "text": "بر او بر ببندیم راه کمین"
  },
  {
    "poem_id": 88030,
    "vorder": 233,
    "position": 0,
    "text": "مگر خیره گردند و جویند جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 234,
    "position": 1,
    "text": "سپاه اندر آرند زان جای تنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 235,
    "position": 0,
    "text": "چنین داد پاسخ به هومان که رو"
  },
  {
    "poem_id": 88030,
    "vorder": 236,
    "position": 1,
    "text": "به گفتار تندی و در کار نو"
  },
  {
    "poem_id": 88030,
    "vorder": 237,
    "position": 0,
    "text": "چو در پیش من برگشادی زبان"
  },
  {
    "poem_id": 88030,
    "vorder": 238,
    "position": 1,
    "text": "بدانستم از آشکارت نهان"
  },
  {
    "poem_id": 88030,
    "vorder": 239,
    "position": 0,
    "text": "که کس را ز ترکان نباشد خرد"
  },
  {
    "poem_id": 88030,
    "vorder": 240,
    "position": 1,
    "text": "کز اندیشهٔ خویش رامش برد"
  },
  {
    "poem_id": 88030,
    "vorder": 241,
    "position": 0,
    "text": "ندانی که شیر ژیان روز جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 242,
    "position": 1,
    "text": "نیالاید از بن به روباه چنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 243,
    "position": 0,
    "text": "و دیگر دو لشکر چنین ساخته"
  },
  {
    "poem_id": 88030,
    "vorder": 244,
    "position": 1,
    "text": "همه بادپایان سر افراخته"
  },
  {
    "poem_id": 88030,
    "vorder": 245,
    "position": 0,
    "text": "به کینه دو تن پیش سازند جنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 246,
    "position": 1,
    "text": "همه نامداران بخایند چنگ"
  },
  {
    "poem_id": 88030,
    "vorder": 247,
    "position": 0,
    "text": "سپه را همه پیش باید شدن"
  },
  {
    "poem_id": 88030,
    "vorder": 248,
    "position": 1,
    "text": "به انبوه زخمی بباید زدن"
  },
  {
    "poem_id": 88030,
    "vorder": 249,
    "position": 0,
    "text": "تو اکنون سوی لشکرت باز شو"
  },
  {
    "poem_id": 88030,
    "vorder": 250,
    "position": 1,
    "text": "برافراز گردن به سالار نو"
  },
  {
    "poem_id": 88030,
    "vorder": 251,
    "position": 0,
    "text": "کز ایرانیان چند جستم نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 252,
    "position": 1,
    "text": "نزد پیش من کس جز از باد سرد"
  },
  {
    "poem_id": 88030,
    "vorder": 253,
    "position": 0,
    "text": "بدان رزمگه بر شود نام تو"
  },
  {
    "poem_id": 88030,
    "vorder": 254,
    "position": 1,
    "text": "ز پیران برآید همه کام تو"
  },
  {
    "poem_id": 88030,
    "vorder": 255,
    "position": 0,
    "text": "بدو گفت هومان به بانگ بلند"
  },
  {
    "poem_id": 88030,
    "vorder": 256,
    "position": 1,
    "text": "که بی کردن کار گفتار چند"
  },
  {
    "poem_id": 88030,
    "vorder": 257,
    "position": 0,
    "text": "یکی داستان زد جهاندار شاه"
  },
  {
    "poem_id": 88030,
    "vorder": 258,
    "position": 1,
    "text": "به یاد آورم اندرین کینه‌گاه"
  },
  {
    "poem_id": 88030,
    "vorder": 259,
    "position": 0,
    "text": "که تخت کیان جست خواهی مجوی"
  },
  {
    "poem_id": 88030,
    "vorder": 260,
    "position": 1,
    "text": "چو جویی از آتش مبرتاب روی"
  },
  {
    "poem_id": 88030,
    "vorder": 261,
    "position": 0,
    "text": "ترا آرزو جنگ و پیکار نیست"
  },
  {
    "poem_id": 88030,
    "vorder": 262,
    "position": 1,
    "text": "وگر گل چنی راه بی‌خار نیست"
  },
  {
    "poem_id": 88030,
    "vorder": 263,
    "position": 0,
    "text": "نداری ز ایران یکی شیرمرد"
  },
  {
    "poem_id": 88030,
    "vorder": 264,
    "position": 1,
    "text": "که با من کند پیش لشکر نبرد"
  },
  {
    "poem_id": 88030,
    "vorder": 265,
    "position": 0,
    "text": "به چاره همی بازگردانیم"
  },
  {
    "poem_id": 88030,
    "vorder": 266,
    "position": 1,
    "text": "نگیرم فریبت اگر دانیم"
  },
  {
    "poem_id": 88030,
    "vorder": 267,
    "position": 0,
    "text": "همه نامداران پرخاشجوی"
  },
  {
    "poem_id": 88030,
    "vorder": 268,
    "position": 1,
    "text": "به گودرز گفتند کاینست روی"
  },
  {
    "poem_id": 88030,
    "vorder": 269,
    "position": 0,
    "text": "که از ما یکی را به آوردگاه"
  },
  {
    "poem_id": 88030,
    "vorder": 270,
    "position": 1,
    "text": "فرستی به نزدیک او کینه‌خواه"
  },
  {
    "poem_id": 88030,
    "vorder": 271,
    "position": 0,
    "text": "چنین داد پاسخ که امروز روی"
  },
  {
    "poem_id": 88030,
    "vorder": 272,
    "position": 1,
    "text": "ندارد شدن جنگ را پیش اوی"
  },
  {
    "poem_id": 88030,
    "vorder": 273,
    "position": 0,
    "text": "چو هومان ز گودرز برگشت چیر"
  },
  {
    "poem_id": 88030,
    "vorder": 274,
    "position": 1,
    "text": "برآشفت بر سان شیر دلیر"
  },
  {
    "poem_id": 88030,
    "vorder": 275,
    "position": 0,
    "text": "بخندید و روی از سپهبد بتافت"
  },
  {
    "poem_id": 88030,
    "vorder": 276,
    "position": 1,
    "text": "سوی روزبانان لشکر شتافت"
  },
  {
    "poem_id": 88030,
    "vorder": 277,
    "position": 0,
    "text": "کمان را به زه کرد و ز ایشان چهار"
  },
  {
    "poem_id": 88030,
    "vorder": 278,
    "position": 1,
    "text": "بیفگند ز اسب اندر آن مرغزار"
  },
  {
    "poem_id": 88030,
    "vorder": 279,
    "position": 0,
    "text": "چو آن روزبانان لشکر ز دور"
  },
  {
    "poem_id": 88030,
    "vorder": 280,
    "position": 1,
    "text": "بدیدند زخم سرافراز تور"
  },
  {
    "poem_id": 88030,
    "vorder": 281,
    "position": 0,
    "text": "رهش بازدادند و بگریختند"
  },
  {
    "poem_id": 88030,
    "vorder": 282,
    "position": 1,
    "text": "به آورد با او نیاویختند"
  },
  {
    "poem_id": 88030,
    "vorder": 283,
    "position": 0,
    "text": "به بالا برآمد به کردار مست"
  },
  {
    "poem_id": 88030,
    "vorder": 284,
    "position": 1,
    "text": "خروشش همی کوه را کرد پست"
  },
  {
    "poem_id": 88030,
    "vorder": 285,
    "position": 0,
    "text": "همی نیزه برگاشت بر گرد سر"
  },
  {
    "poem_id": 88030,
    "vorder": 286,
    "position": 1,
    "text": "که هومان ویسه است پیروزگر"
  },
  {
    "poem_id": 88030,
    "vorder": 287,
    "position": 0,
    "text": "خروشیدن نای رویین ز دشت"
  },
  {
    "poem_id": 88030,
    "vorder": 288,
    "position": 1,
    "text": "برآمد چو نیزه ز بالا بگشت"
  },
  {
    "poem_id": 88030,
    "vorder": 289,
    "position": 0,
    "text": "ز شادی دلیران توران سپاه"
  },
  {
    "poem_id": 88030,
    "vorder": 290,
    "position": 1,
    "text": "همی ترگ سودند بر چرخ ماه"
  },
  {
    "poem_id": 88030,
    "vorder": 291,
    "position": 0,
    "text": "چو هومان بیامد بدان چیرگی"
  },
  {
    "poem_id": 88030,
    "vorder": 292,
    "position": 1,
    "text": "بپیچید گودرز زان خیرگی"
  },
  {
    "poem_id": 88030,
    "vorder": 293,
    "position": 0,
    "text": "سپهبد پر از شرم گشته دژم"
  },
  {
    "poem_id": 88030,
    "vorder": 294,
    "position": 1,
    "text": "گرفته بر او خشم و تندی ستم"
  },
  {
    "poem_id": 88030,
    "vorder": 295,
    "position": 0,
    "text": "به ننگ از دلیران بپالود خوی"
  },
  {
    "poem_id": 88030,
    "vorder": 296,
    "position": 1,
    "text": "سپهبد یکی اختر افگند پی"
  },
  {
    "poem_id": 88030,
    "vorder": 297,
    "position": 0,
    "text": "کز ایشان بد این پیشدستی به خون"
  },
  {
    "poem_id": 88030,
    "vorder": 298,
    "position": 1,
    "text": "بدانند و هم بر بدی رهنمون"
  },
  {
    "poem_id": 88030,
    "vorder": 299,
    "position": 0,
    "text": "از آن پس به گردنکشان بنگرید"
  },
  {
    "poem_id": 88030,
    "vorder": 300,
    "position": 1,
    "text": "که تا جنگ او را که آید پدید"
  }
]