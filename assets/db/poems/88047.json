[
  {
    "poem_id": 88047,
    "vorder": 1,
    "position": 0,
    "text": "به پنجم چو رهام گودرز بود"
  },
  {
    "poem_id": 88047,
    "vorder": 2,
    "position": 1,
    "text": "که با بارمان او نبرد آزمود"
  },
  {
    "poem_id": 88047,
    "vorder": 3,
    "position": 0,
    "text": "کمان برگرفتند و تیر خدنگ"
  },
  {
    "poem_id": 88047,
    "vorder": 4,
    "position": 1,
    "text": "برآمد خروش سواران جنگ"
  },
  {
    "poem_id": 88047,
    "vorder": 5,
    "position": 0,
    "text": "کمانها همه پاک بر هم شکست"
  },
  {
    "poem_id": 88047,
    "vorder": 6,
    "position": 1,
    "text": "سوی نیزه بردند چون باد دست"
  },
  {
    "poem_id": 88047,
    "vorder": 7,
    "position": 0,
    "text": "دو جنگی و هر دو دلیر و سوار"
  },
  {
    "poem_id": 88047,
    "vorder": 8,
    "position": 1,
    "text": "هشیوار و دیده بسی کارزار"
  },
  {
    "poem_id": 88047,
    "vorder": 9,
    "position": 0,
    "text": "بگشتند بسیار یک با دگر"
  },
  {
    "poem_id": 88047,
    "vorder": 10,
    "position": 1,
    "text": "بپیچید رهام پرخاشخر"
  },
  {
    "poem_id": 88047,
    "vorder": 11,
    "position": 0,
    "text": "یکی نیزه انداخت بر ران اوی"
  },
  {
    "poem_id": 88047,
    "vorder": 12,
    "position": 1,
    "text": "کز اسب اندر آمد به فرمان اوی"
  },
  {
    "poem_id": 88047,
    "vorder": 13,
    "position": 0,
    "text": "جدا شد ز باره هم آنگاه ترک"
  },
  {
    "poem_id": 88047,
    "vorder": 14,
    "position": 1,
    "text": "ز اسب اندر افتاد ترک سترگ"
  },
  {
    "poem_id": 88047,
    "vorder": 15,
    "position": 0,
    "text": "به پشت اندرش نیزه‌ای زد دگر"
  },
  {
    "poem_id": 88047,
    "vorder": 16,
    "position": 1,
    "text": "سنان اندر آمد میان جگر"
  },
  {
    "poem_id": 88047,
    "vorder": 17,
    "position": 0,
    "text": "فرود آمد از باره کرد آفرین"
  },
  {
    "poem_id": 88047,
    "vorder": 18,
    "position": 1,
    "text": "ز دادار بر بخت شاه زمین"
  },
  {
    "poem_id": 88047,
    "vorder": 19,
    "position": 0,
    "text": "به کین سیاوش کشیدش نگون"
  },
  {
    "poem_id": 88047,
    "vorder": 20,
    "position": 1,
    "text": "ز کینه بمالید بر روی خون"
  },
  {
    "poem_id": 88047,
    "vorder": 21,
    "position": 0,
    "text": "به زین اندر آهخت و بستش چو سنگ"
  },
  {
    "poem_id": 88047,
    "vorder": 22,
    "position": 1,
    "text": "سر آویخته پایها زیر تنگ"
  },
  {
    "poem_id": 88047,
    "vorder": 23,
    "position": 0,
    "text": "نشست از بر زین و اسبش کشان"
  },
  {
    "poem_id": 88047,
    "vorder": 24,
    "position": 1,
    "text": "بیامد دوان تا به جای نشان"
  },
  {
    "poem_id": 88047,
    "vorder": 25,
    "position": 0,
    "text": "به بالا برآمد شده شاد دل"
  },
  {
    "poem_id": 88047,
    "vorder": 26,
    "position": 1,
    "text": "ز درد و غمان گشته آزاددل"
  },
  {
    "poem_id": 88047,
    "vorder": 27,
    "position": 0,
    "text": "به پیروزی شاه و تخت بلند"
  },
  {
    "poem_id": 88047,
    "vorder": 28,
    "position": 1,
    "text": "به کام آمده زیر بخت بلند"
  },
  {
    "poem_id": 88047,
    "vorder": 29,
    "position": 0,
    "text": "همی آفرین خواند سالار شاه"
  },
  {
    "poem_id": 88047,
    "vorder": 30,
    "position": 1,
    "text": "ابر شاه کیخسرو و تاج و گاه"
  },
  {
    "poem_id": 88047,
    "vorder": 31,
    "position": 0,
    "text": "که پیروزگر شاه پیروز باد"
  },
  {
    "poem_id": 88047,
    "vorder": 32,
    "position": 1,
    "text": "همه روزگارانش نوروز باد"
  }
]