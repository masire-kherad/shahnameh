[
  {
    "poem_id": 87977,
    "vorder": 1,
    "position": 0,
    "text": "دوان رفت بهرام پیش پدر"
  },
  {
    "poem_id": 87977,
    "vorder": 2,
    "position": 1,
    "text": "که ای پهلوان یلان سر به سر"
  },
  {
    "poem_id": 87977,
    "vorder": 3,
    "position": 0,
    "text": "بدانگه که آن تاج برداشتم"
  },
  {
    "poem_id": 87977,
    "vorder": 4,
    "position": 1,
    "text": "به نیزه بابراندر افراشتم"
  },
  {
    "poem_id": 87977,
    "vorder": 5,
    "position": 0,
    "text": "یکی تازیانه ز من گم شده‌ست"
  },
  {
    "poem_id": 87977,
    "vorder": 6,
    "position": 1,
    "text": "چو گیرند بی‌مایه ترکان به دست"
  },
  {
    "poem_id": 87977,
    "vorder": 7,
    "position": 0,
    "text": "به بهرام بر چند باشد فسوس"
  },
  {
    "poem_id": 87977,
    "vorder": 8,
    "position": 1,
    "text": "جهان پیش چشمم شود آبنوس"
  },
  {
    "poem_id": 87977,
    "vorder": 9,
    "position": 0,
    "text": "نبشته بران چرم نام منست"
  },
  {
    "poem_id": 87977,
    "vorder": 10,
    "position": 1,
    "text": "سپهدار پیران بگیرد به دست"
  },
  {
    "poem_id": 87977,
    "vorder": 11,
    "position": 0,
    "text": "شوم تیز و تازانه بازآورم"
  },
  {
    "poem_id": 87977,
    "vorder": 12,
    "position": 1,
    "text": "اگر چند رنج دراز آورم"
  },
  {
    "poem_id": 87977,
    "vorder": 13,
    "position": 0,
    "text": "مرا این ز اختر بد آید همی"
  },
  {
    "poem_id": 87977,
    "vorder": 14,
    "position": 1,
    "text": "که نامم به خاک اندر آید همی"
  },
  {
    "poem_id": 87977,
    "vorder": 15,
    "position": 0,
    "text": "بدو گفت گودرز پیر ای پسر"
  },
  {
    "poem_id": 87977,
    "vorder": 16,
    "position": 1,
    "text": "همی بخت خویش اندر آری به‌سر"
  },
  {
    "poem_id": 87977,
    "vorder": 17,
    "position": 0,
    "text": "ز بهر یکی چوب‌ِ بسته‌دوال"
  },
  {
    "poem_id": 87977,
    "vorder": 18,
    "position": 1,
    "text": "شوی در دَم ِ اختر‌ِ شوم‌فال"
  },
  {
    "poem_id": 87977,
    "vorder": 19,
    "position": 0,
    "text": "چنین گفت بهرام جنگی که من"
  },
  {
    "poem_id": 87977,
    "vorder": 20,
    "position": 1,
    "text": "نیم بهتر از دوده و انجمن"
  },
  {
    "poem_id": 87977,
    "vorder": 21,
    "position": 0,
    "text": "به جایی توان مرد کاید زمان"
  },
  {
    "poem_id": 87977,
    "vorder": 22,
    "position": 1,
    "text": "به کژی چرا برد باید گمان‌؟"
  },
  {
    "poem_id": 87977,
    "vorder": 23,
    "position": 0,
    "text": "بدو گفت گیو ای برادر مشو"
  },
  {
    "poem_id": 87977,
    "vorder": 24,
    "position": 1,
    "text": "فراوان مرا تازیانه‌ست نو"
  },
  {
    "poem_id": 87977,
    "vorder": 25,
    "position": 0,
    "text": "یکی شوشهٔ زر به سیم اندر است"
  },
  {
    "poem_id": 87977,
    "vorder": 26,
    "position": 1,
    "text": "دو شیبش ز خوشاب وز گوهر‌ست"
  },
  {
    "poem_id": 87977,
    "vorder": 27,
    "position": 0,
    "text": "فرنگیس چون گنج بگشاد سر"
  },
  {
    "poem_id": 87977,
    "vorder": 28,
    "position": 1,
    "text": "مرا داد چندان سلیح و کمر"
  },
  {
    "poem_id": 87977,
    "vorder": 29,
    "position": 0,
    "text": "من آن درع و تازانه برداشتم"
  },
  {
    "poem_id": 87977,
    "vorder": 30,
    "position": 1,
    "text": "به توران دگر خوار بگذاشتم"
  },
  {
    "poem_id": 87977,
    "vorder": 31,
    "position": 0,
    "text": "یکی نیز بخشید کاوس شاه"
  },
  {
    "poem_id": 87977,
    "vorder": 32,
    "position": 1,
    "text": "ز زر وز گوهر چو تابنده ماه"
  },
  {
    "poem_id": 87977,
    "vorder": 33,
    "position": 0,
    "text": "دگر پنج دارم همه زرنگار"
  },
  {
    "poem_id": 87977,
    "vorder": 34,
    "position": 1,
    "text": "برو بافته گوهر شاهوار"
  },
  {
    "poem_id": 87977,
    "vorder": 35,
    "position": 0,
    "text": "ترا بخشم این هفت ز ایدر مرو"
  },
  {
    "poem_id": 87977,
    "vorder": 36,
    "position": 1,
    "text": "یکی جنگ خیره میارای نو"
  },
  {
    "poem_id": 87977,
    "vorder": 37,
    "position": 0,
    "text": "چنین گفت با گیو بهرام گرد"
  },
  {
    "poem_id": 87977,
    "vorder": 38,
    "position": 1,
    "text": "که این ننگ را خرد نتوان شمرد"
  },
  {
    "poem_id": 87977,
    "vorder": 39,
    "position": 0,
    "text": "شما را ز رنگ و نگار‌ست گفت"
  },
  {
    "poem_id": 87977,
    "vorder": 40,
    "position": 1,
    "text": "مرا آنک شد نام با ننگ جفت"
  },
  {
    "poem_id": 87977,
    "vorder": 41,
    "position": 0,
    "text": "گر ایدونک تازانه بازآورم"
  },
  {
    "poem_id": 87977,
    "vorder": 42,
    "position": 1,
    "text": "وگر سر ز کوشش بگاز آورم"
  },
  {
    "poem_id": 87977,
    "vorder": 43,
    "position": 0,
    "text": "بر او رای یزدان دگرگونه بود"
  },
  {
    "poem_id": 87977,
    "vorder": 44,
    "position": 1,
    "text": "همان گردش بخت وارونه بود"
  },
  {
    "poem_id": 87977,
    "vorder": 45,
    "position": 0,
    "text": "هرانگه که بخت اندر آید به خواب"
  },
  {
    "poem_id": 87977,
    "vorder": 46,
    "position": 1,
    "text": "ترا گفت دانا نیاید صواب"
  },
  {
    "poem_id": 87977,
    "vorder": 47,
    "position": 0,
    "text": "بزد اسپ و آمد بران رزمگاه"
  },
  {
    "poem_id": 87977,
    "vorder": 48,
    "position": 1,
    "text": "درخشان شده روی گیتی ز ماه"
  },
  {
    "poem_id": 87977,
    "vorder": 49,
    "position": 0,
    "text": "همی زار بگریست بر کشتگان"
  },
  {
    "poem_id": 87977,
    "vorder": 50,
    "position": 1,
    "text": "بران داغ دل بخت‌برگشتگان"
  },
  {
    "poem_id": 87977,
    "vorder": 51,
    "position": 0,
    "text": "تن ریونیز اندران خون و خاک"
  },
  {
    "poem_id": 87977,
    "vorder": 52,
    "position": 1,
    "text": "شده غرق و خفتان برو چاک چاک"
  },
  {
    "poem_id": 87977,
    "vorder": 53,
    "position": 0,
    "text": "همی زار بگریست بهرام شیر"
  },
  {
    "poem_id": 87977,
    "vorder": 54,
    "position": 1,
    "text": "که زار ای جوان سوار دلیر"
  },
  {
    "poem_id": 87977,
    "vorder": 55,
    "position": 0,
    "text": "چو تو کشته اکنون چه یک مشت خاک"
  },
  {
    "poem_id": 87977,
    "vorder": 56,
    "position": 1,
    "text": "بزرگان به ایوان‌، تو اندر مغاک"
  },
  {
    "poem_id": 87977,
    "vorder": 57,
    "position": 0,
    "text": "بران کشتگان بر یکایک بگشت"
  },
  {
    "poem_id": 87977,
    "vorder": 58,
    "position": 1,
    "text": "که بودند افگنده بر پهن‌دشت"
  },
  {
    "poem_id": 87977,
    "vorder": 59,
    "position": 0,
    "text": "ازان نامداران یکی خسته بود"
  },
  {
    "poem_id": 87977,
    "vorder": 60,
    "position": 1,
    "text": "به شمشیر ازیشان به جان رسته بود"
  },
  {
    "poem_id": 87977,
    "vorder": 61,
    "position": 0,
    "text": "همی بازدانست بهرام را"
  },
  {
    "poem_id": 87977,
    "vorder": 62,
    "position": 1,
    "text": "بنالید و پرسید زو نام را"
  },
  {
    "poem_id": 87977,
    "vorder": 63,
    "position": 0,
    "text": "بدو گفت کای شیر من زنده‌ام"
  },
  {
    "poem_id": 87977,
    "vorder": 64,
    "position": 1,
    "text": "بر کشتگان خوار افگنده‌ام"
  },
  {
    "poem_id": 87977,
    "vorder": 65,
    "position": 0,
    "text": "سه روزست تا نان و آب آرزوست"
  },
  {
    "poem_id": 87977,
    "vorder": 66,
    "position": 1,
    "text": "مرا بر یکی جامه خواب آرزوست"
  },
  {
    "poem_id": 87977,
    "vorder": 67,
    "position": 0,
    "text": "بشد تیز بهرام تا پیش اوی"
  },
  {
    "poem_id": 87977,
    "vorder": 68,
    "position": 1,
    "text": "به دل مهربان و به تن خویش اوی"
  },
  {
    "poem_id": 87977,
    "vorder": 69,
    "position": 0,
    "text": "برو گشت گریان و رخ را بخست"
  },
  {
    "poem_id": 87977,
    "vorder": 70,
    "position": 1,
    "text": "بدرید پیراهن او را ببست"
  },
  {
    "poem_id": 87977,
    "vorder": 71,
    "position": 0,
    "text": "بدو گفت مندیش کز خستگی‌ست"
  },
  {
    "poem_id": 87977,
    "vorder": 72,
    "position": 1,
    "text": "تبه بودن این ز نابستگی‌ست"
  },
  {
    "poem_id": 87977,
    "vorder": 73,
    "position": 0,
    "text": "چو بستم کنون سوی لشکر شوی"
  },
  {
    "poem_id": 87977,
    "vorder": 74,
    "position": 1,
    "text": "وزین خستگی زود بهتر شوی"
  },
  {
    "poem_id": 87977,
    "vorder": 75,
    "position": 0,
    "text": "یکی تازیانه بدین رزمگاه"
  },
  {
    "poem_id": 87977,
    "vorder": 76,
    "position": 1,
    "text": "ز من گم شده‌ست از پی تاج شاه"
  },
  {
    "poem_id": 87977,
    "vorder": 77,
    "position": 0,
    "text": "چو آن بازیابم بیایم برت"
  },
  {
    "poem_id": 87977,
    "vorder": 78,
    "position": 1,
    "text": "رسانم به زودی سوی لشکرت"
  },
  {
    "poem_id": 87977,
    "vorder": 79,
    "position": 0,
    "text": "وزانجا سوی قلب لشکر شتافت"
  },
  {
    "poem_id": 87977,
    "vorder": 80,
    "position": 1,
    "text": "همی جست تا تازیانه بیافت"
  },
  {
    "poem_id": 87977,
    "vorder": 81,
    "position": 0,
    "text": "میان تل کشتگان اندرون"
  },
  {
    "poem_id": 87977,
    "vorder": 82,
    "position": 1,
    "text": "برآمیخته خاک بسیار و خون"
  },
  {
    "poem_id": 87977,
    "vorder": 83,
    "position": 0,
    "text": "فرود آمد از باره آن برگرفت"
  },
  {
    "poem_id": 87977,
    "vorder": 84,
    "position": 1,
    "text": "وزانجا خروشیدن اندر گرفت"
  },
  {
    "poem_id": 87977,
    "vorder": 85,
    "position": 0,
    "text": "خروش دم مادیان یافت اسپ"
  },
  {
    "poem_id": 87977,
    "vorder": 86,
    "position": 1,
    "text": "بجوشید برسان آذرگشسپ"
  },
  {
    "poem_id": 87977,
    "vorder": 87,
    "position": 0,
    "text": "سوی مادیان روی بنهاد تفت"
  },
  {
    "poem_id": 87977,
    "vorder": 88,
    "position": 1,
    "text": "غمی گشت بهرام و از پس برفت"
  },
  {
    "poem_id": 87977,
    "vorder": 89,
    "position": 0,
    "text": "همی شد دمان تا رسید اندروی"
  },
  {
    "poem_id": 87977,
    "vorder": 90,
    "position": 1,
    "text": "ز ترگ و ز خفتان پر از آب روی"
  },
  {
    "poem_id": 87977,
    "vorder": 91,
    "position": 0,
    "text": "چو بگرفت هم در زمان برنشست"
  },
  {
    "poem_id": 87977,
    "vorder": 92,
    "position": 1,
    "text": "یکی تیغ هندی گرفته به دست"
  },
  {
    "poem_id": 87977,
    "vorder": 93,
    "position": 0,
    "text": "چو بفشارد ران هیچ نگذارد پی"
  },
  {
    "poem_id": 87977,
    "vorder": 94,
    "position": 1,
    "text": "سوار و تن باره پرخاک و خوی"
  },
  {
    "poem_id": 87977,
    "vorder": 95,
    "position": 0,
    "text": "چنان تنگدل شد به یکبارگی"
  },
  {
    "poem_id": 87977,
    "vorder": 96,
    "position": 1,
    "text": "که شمشیر زد بر پی بارگی"
  },
  {
    "poem_id": 87977,
    "vorder": 97,
    "position": 0,
    "text": "وزان جایگه تا بدین رزمگاه"
  },
  {
    "poem_id": 87977,
    "vorder": 98,
    "position": 1,
    "text": "پیاده بپیمود چون باد راه"
  },
  {
    "poem_id": 87977,
    "vorder": 99,
    "position": 0,
    "text": "سراسر همه دشت پرکشته دید"
  },
  {
    "poem_id": 87977,
    "vorder": 100,
    "position": 1,
    "text": "زمین چون گل و ارغوان کشته دید"
  },
  {
    "poem_id": 87977,
    "vorder": 101,
    "position": 0,
    "text": "همی گفت کاکنون چه سازیم روی"
  },
  {
    "poem_id": 87977,
    "vorder": 102,
    "position": 1,
    "text": "بر این دشت بی‌بارگی راه‌جوی"
  },
  {
    "poem_id": 87977,
    "vorder": 103,
    "position": 0,
    "text": "ازو سرکشان آگهی یافتند"
  },
  {
    "poem_id": 87977,
    "vorder": 104,
    "position": 1,
    "text": "سواری صد از قلب بشتافتند"
  },
  {
    "poem_id": 87977,
    "vorder": 105,
    "position": 0,
    "text": "که او را بگیرند زان رزمگاه"
  },
  {
    "poem_id": 87977,
    "vorder": 106,
    "position": 1,
    "text": "برندش بر پهلوان سپاه"
  },
  {
    "poem_id": 87977,
    "vorder": 107,
    "position": 0,
    "text": "کمان را به زه کرد بهرام شیر"
  },
  {
    "poem_id": 87977,
    "vorder": 108,
    "position": 1,
    "text": "ببارید تیر از کمان دلیر"
  },
  {
    "poem_id": 87977,
    "vorder": 109,
    "position": 0,
    "text": "چو تیری یکی در کمان راندی"
  },
  {
    "poem_id": 87977,
    "vorder": 110,
    "position": 1,
    "text": "به پیرامنش کس کجا ماندی"
  },
  {
    "poem_id": 87977,
    "vorder": 111,
    "position": 0,
    "text": "ازیشان فراوان بخست و بکشت"
  },
  {
    "poem_id": 87977,
    "vorder": 112,
    "position": 1,
    "text": "پیاده نپیچید و ننمود پشت"
  },
  {
    "poem_id": 87977,
    "vorder": 113,
    "position": 0,
    "text": "سواران همه بازگشتند ازوی"
  },
  {
    "poem_id": 87977,
    "vorder": 114,
    "position": 1,
    "text": "بنزدیک پیران نهادند روی"
  },
  {
    "poem_id": 87977,
    "vorder": 115,
    "position": 0,
    "text": "چو لشکر ز بهرام شد ناپدید"
  },
  {
    "poem_id": 87977,
    "vorder": 116,
    "position": 1,
    "text": "ز هر سو بسی تیر گرد آورید"
  },
  {
    "poem_id": 87977,
    "vorder": 117,
    "position": 0,
    "text": "چو لشکر بیامد بر پهلوان"
  },
  {
    "poem_id": 87977,
    "vorder": 118,
    "position": 1,
    "text": "بگفتند با او سراسر گوان"
  },
  {
    "poem_id": 87977,
    "vorder": 119,
    "position": 0,
    "text": "فراوان سخن رفت زان رزمساز"
  },
  {
    "poem_id": 87977,
    "vorder": 120,
    "position": 1,
    "text": "ز پیکار او آشکارا و راز"
  },
  {
    "poem_id": 87977,
    "vorder": 121,
    "position": 0,
    "text": "بگفتند کاینت هژبر دلیر"
  },
  {
    "poem_id": 87977,
    "vorder": 122,
    "position": 1,
    "text": "پیاده نگردد خود از جنگ سیر"
  },
  {
    "poem_id": 87977,
    "vorder": 123,
    "position": 0,
    "text": "بپرسید پیران که این مرد کیست"
  },
  {
    "poem_id": 87977,
    "vorder": 124,
    "position": 1,
    "text": "ازان نامداران ورا نام چیست"
  },
  {
    "poem_id": 87977,
    "vorder": 125,
    "position": 0,
    "text": "یکی گفت بهرام شیراوژن است"
  },
  {
    "poem_id": 87977,
    "vorder": 126,
    "position": 1,
    "text": "که لشکر سراسر بدو روشن است"
  },
  {
    "poem_id": 87977,
    "vorder": 127,
    "position": 0,
    "text": "به رویین چنین گفت پیران که خیز"
  },
  {
    "poem_id": 87977,
    "vorder": 128,
    "position": 1,
    "text": "که بهرام را نیست جای گریز"
  },
  {
    "poem_id": 87977,
    "vorder": 129,
    "position": 0,
    "text": "مگر زنده او را به چنگ آوری"
  },
  {
    "poem_id": 87977,
    "vorder": 130,
    "position": 1,
    "text": "زمانه براساید از داوری"
  },
  {
    "poem_id": 87977,
    "vorder": 131,
    "position": 0,
    "text": "ز لشکر کسی را که باید ببر"
  },
  {
    "poem_id": 87977,
    "vorder": 132,
    "position": 1,
    "text": "کجا نامدار‌ست و پرخاشخر"
  },
  {
    "poem_id": 87977,
    "vorder": 133,
    "position": 0,
    "text": "چو بشنید رویین بیامد دمان"
  },
  {
    "poem_id": 87977,
    "vorder": 134,
    "position": 1,
    "text": "نبودش بس اندیشهٔ بدگمان"
  },
  {
    "poem_id": 87977,
    "vorder": 135,
    "position": 0,
    "text": "بر تیر بنشست بهرام شیر"
  },
  {
    "poem_id": 87977,
    "vorder": 136,
    "position": 1,
    "text": "نهاده سپر بر سر و چرخ زیر"
  },
  {
    "poem_id": 87977,
    "vorder": 137,
    "position": 0,
    "text": "یکی تیرباران به رویین بکرد"
  },
  {
    "poem_id": 87977,
    "vorder": 138,
    "position": 1,
    "text": "که شد ماه تابنده چون لاژورد"
  },
  {
    "poem_id": 87977,
    "vorder": 139,
    "position": 0,
    "text": "چو رویین پیران ز تیرش بخست"
  },
  {
    "poem_id": 87977,
    "vorder": 140,
    "position": 1,
    "text": "یلان را همه کند شد پای و دست"
  },
  {
    "poem_id": 87977,
    "vorder": 141,
    "position": 0,
    "text": "به سستی بر پهلوان آمدند"
  },
  {
    "poem_id": 87977,
    "vorder": 142,
    "position": 1,
    "text": "پر از درد و تیره‌روان آمدند"
  },
  {
    "poem_id": 87977,
    "vorder": 143,
    "position": 0,
    "text": "که هرگز چنین یک پیاده به جنگ"
  },
  {
    "poem_id": 87977,
    "vorder": 144,
    "position": 1,
    "text": "ز دریا ندیدیم جنگی نهنگ"
  },
  {
    "poem_id": 87977,
    "vorder": 145,
    "position": 0,
    "text": "چو بشنید پیران غمی گشت سخت"
  },
  {
    "poem_id": 87977,
    "vorder": 146,
    "position": 1,
    "text": "بلرزید برسان برگ درخت"
  },
  {
    "poem_id": 87977,
    "vorder": 147,
    "position": 0,
    "text": "نشست از بر بارهٔ تند تاز"
  },
  {
    "poem_id": 87977,
    "vorder": 148,
    "position": 1,
    "text": "همی‌رفت با او بسی رزمساز"
  },
  {
    "poem_id": 87977,
    "vorder": 149,
    "position": 0,
    "text": "بیامد بدو گفت کای نامدار"
  },
  {
    "poem_id": 87977,
    "vorder": 150,
    "position": 1,
    "text": "پیاده چرا ساختی کارزار"
  },
  {
    "poem_id": 87977,
    "vorder": 151,
    "position": 0,
    "text": "نه تو با سیاوش به توران بدی"
  },
  {
    "poem_id": 87977,
    "vorder": 152,
    "position": 1,
    "text": "همانا به پرخاش و سوران بدی"
  },
  {
    "poem_id": 87977,
    "vorder": 153,
    "position": 0,
    "text": "مرا با تو نان و نمک خوردن است"
  },
  {
    "poem_id": 87977,
    "vorder": 154,
    "position": 1,
    "text": "نشستن همان مهر پروردن است"
  },
  {
    "poem_id": 87977,
    "vorder": 155,
    "position": 0,
    "text": "نباید که با این نژاد و گهر"
  },
  {
    "poem_id": 87977,
    "vorder": 156,
    "position": 1,
    "text": "بدین شیرمردی و چندین هنر"
  },
  {
    "poem_id": 87977,
    "vorder": 157,
    "position": 0,
    "text": "ز بالا به خاک اندر آید سرت"
  },
  {
    "poem_id": 87977,
    "vorder": 158,
    "position": 1,
    "text": "بسوزد دل مهربان مادرت"
  },
  {
    "poem_id": 87977,
    "vorder": 159,
    "position": 0,
    "text": "بیا تا بسازیم سوگند و بند"
  },
  {
    "poem_id": 87977,
    "vorder": 160,
    "position": 1,
    "text": "براهی که آید دلت را پسند"
  },
  {
    "poem_id": 87977,
    "vorder": 161,
    "position": 0,
    "text": "ازان پس یکی با تو خویشی کنیم"
  },
  {
    "poem_id": 87977,
    "vorder": 162,
    "position": 1,
    "text": "چو خویشی بود رای بیشی کنیم"
  },
  {
    "poem_id": 87977,
    "vorder": 163,
    "position": 0,
    "text": "پیاده تو با لشکری نامدار"
  },
  {
    "poem_id": 87977,
    "vorder": 164,
    "position": 1,
    "text": "نتابی مخور باتنت زینهار"
  },
  {
    "poem_id": 87977,
    "vorder": 165,
    "position": 0,
    "text": "بدو گفت بهرام کای پهلوان"
  },
  {
    "poem_id": 87977,
    "vorder": 166,
    "position": 1,
    "text": "خردمند و بینا و روشن‌روان"
  },
  {
    "poem_id": 87977,
    "vorder": 167,
    "position": 0,
    "text": "مرا حاجت از تو یکی بارگی‌ست"
  },
  {
    "poem_id": 87977,
    "vorder": 168,
    "position": 1,
    "text": "وگر نه مرا جنگ یکبارگی‌ست"
  },
  {
    "poem_id": 87977,
    "vorder": 169,
    "position": 0,
    "text": "بدو گفت پیران که ای نامجوی"
  },
  {
    "poem_id": 87977,
    "vorder": 170,
    "position": 1,
    "text": "ندانی که این رای را نیست روی"
  },
  {
    "poem_id": 87977,
    "vorder": 171,
    "position": 0,
    "text": "ترا این به آید که گفتم سخن"
  },
  {
    "poem_id": 87977,
    "vorder": 172,
    "position": 1,
    "text": "دلیری و بر خیره تندی مکن"
  },
  {
    "poem_id": 87977,
    "vorder": 173,
    "position": 0,
    "text": "ببین تا سواران آن انجمن"
  },
  {
    "poem_id": 87977,
    "vorder": 174,
    "position": 1,
    "text": "نهند این چنین ننگ بر خویشتن"
  },
  {
    "poem_id": 87977,
    "vorder": 175,
    "position": 0,
    "text": "که چندین تن از تخمهٔ مهتران"
  },
  {
    "poem_id": 87977,
    "vorder": 176,
    "position": 1,
    "text": "ز دیهیم داران و کنداوران"
  },
  {
    "poem_id": 87977,
    "vorder": 177,
    "position": 0,
    "text": "ز پیکار تو کشته و خسته شد"
  },
  {
    "poem_id": 87977,
    "vorder": 178,
    "position": 1,
    "text": "چنین رزم ناگاه پیوسته شد"
  },
  {
    "poem_id": 87977,
    "vorder": 179,
    "position": 0,
    "text": "که جوید گذر سوی ایران کنون"
  },
  {
    "poem_id": 87977,
    "vorder": 180,
    "position": 1,
    "text": "مگر آنک جوشد ورا مغز و خون"
  },
  {
    "poem_id": 87977,
    "vorder": 181,
    "position": 0,
    "text": "اگر نیستی رنج افراسیاب"
  },
  {
    "poem_id": 87977,
    "vorder": 182,
    "position": 1,
    "text": "که گردد سرش زین سخن پرشتاب"
  },
  {
    "poem_id": 87977,
    "vorder": 183,
    "position": 0,
    "text": "ترا بارگی دادمی ای جوان"
  },
  {
    "poem_id": 87977,
    "vorder": 184,
    "position": 1,
    "text": "بدان تات بردی بر پهلوان"
  },
  {
    "poem_id": 87977,
    "vorder": 185,
    "position": 0,
    "text": "بگفت این و برگشت و شد باز جای"
  },
  {
    "poem_id": 87977,
    "vorder": 186,
    "position": 1,
    "text": "دلش پر ز کین و سرش پر ز رای"
  },
  {
    "poem_id": 87977,
    "vorder": 187,
    "position": 0,
    "text": "برفت او و آمد ز لشکر تژاو"
  },
  {
    "poem_id": 87977,
    "vorder": 188,
    "position": 1,
    "text": "سواری که بودیش با شیر تاو"
  },
  {
    "poem_id": 87977,
    "vorder": 189,
    "position": 0,
    "text": "ز پیران بپرسید و پیران بگفت"
  },
  {
    "poem_id": 87977,
    "vorder": 190,
    "position": 1,
    "text": "که بهرام را از یلان نیست جفت"
  },
  {
    "poem_id": 87977,
    "vorder": 191,
    "position": 0,
    "text": "به مهر‌ش بدادم بسی پند خوب"
  },
  {
    "poem_id": 87977,
    "vorder": 192,
    "position": 1,
    "text": "نمودم بدو راه و پیوند خوب"
  },
  {
    "poem_id": 87977,
    "vorder": 193,
    "position": 0,
    "text": "سخن را نبد بر دلش هیچ راه"
  },
  {
    "poem_id": 87977,
    "vorder": 194,
    "position": 1,
    "text": "همی راه جوید به ایران سپاه"
  },
  {
    "poem_id": 87977,
    "vorder": 195,
    "position": 0,
    "text": "به پیران چنین گفت جنگی تژاو"
  },
  {
    "poem_id": 87977,
    "vorder": 196,
    "position": 1,
    "text": "که با مهر جان ترا نیست تاو"
  },
  {
    "poem_id": 87977,
    "vorder": 197,
    "position": 0,
    "text": "شوم گر پیاده به چنگ آرمش"
  },
  {
    "poem_id": 87977,
    "vorder": 198,
    "position": 1,
    "text": "سر اندر زمان زیر سنگ آرمش"
  },
  {
    "poem_id": 87977,
    "vorder": 199,
    "position": 0,
    "text": "بیامد شتابان بدان رزمگاه"
  },
  {
    "poem_id": 87977,
    "vorder": 200,
    "position": 1,
    "text": "کجا بود بهرام یل بی‌سپاه"
  },
  {
    "poem_id": 87977,
    "vorder": 201,
    "position": 0,
    "text": "چو بهرام را دید نیزه به دست"
  },
  {
    "poem_id": 87977,
    "vorder": 202,
    "position": 1,
    "text": "یکی برخروشید چون پیل مست"
  },
  {
    "poem_id": 87977,
    "vorder": 203,
    "position": 0,
    "text": "بدو گفت ازین لشکر نامدار"
  },
  {
    "poem_id": 87977,
    "vorder": 204,
    "position": 1,
    "text": "پیاده یکی مرد و چندین سوار"
  },
  {
    "poem_id": 87977,
    "vorder": 205,
    "position": 0,
    "text": "به ایران گرازید خواهی همی"
  },
  {
    "poem_id": 87977,
    "vorder": 206,
    "position": 1,
    "text": "سرت برفرازید خواهی همی"
  },
  {
    "poem_id": 87977,
    "vorder": 207,
    "position": 0,
    "text": "سران را سپردی سر اندر زمان"
  },
  {
    "poem_id": 87977,
    "vorder": 208,
    "position": 1,
    "text": "گه آمد که بر تو سرآید زمان"
  },
  {
    "poem_id": 87977,
    "vorder": 209,
    "position": 0,
    "text": "پس آنگه بفرمود کاندر نهید"
  },
  {
    "poem_id": 87977,
    "vorder": 210,
    "position": 1,
    "text": "به تیر و به گرز و به ژوپین دهید"
  },
  {
    "poem_id": 87977,
    "vorder": 211,
    "position": 0,
    "text": "برو انجمن شد یکی لشکری"
  },
  {
    "poem_id": 87977,
    "vorder": 212,
    "position": 1,
    "text": "هرانکس که بد از دلیران سری"
  },
  {
    "poem_id": 87977,
    "vorder": 213,
    "position": 0,
    "text": "کمان را به زه کرد بهرام گرد"
  },
  {
    "poem_id": 87977,
    "vorder": 214,
    "position": 1,
    "text": "به تیر از هوا روشنایی ببرد"
  },
  {
    "poem_id": 87977,
    "vorder": 215,
    "position": 0,
    "text": "چو تیر اسپری شد سوی نیزه گشت"
  },
  {
    "poem_id": 87977,
    "vorder": 216,
    "position": 1,
    "text": "چو دریای خون شد همه کوه و دشت"
  },
  {
    "poem_id": 87977,
    "vorder": 217,
    "position": 0,
    "text": "چو نیزه قلم شد به گرز و به تیغ"
  },
  {
    "poem_id": 87977,
    "vorder": 218,
    "position": 1,
    "text": "همی خون چکانید بر تیره میغ"
  },
  {
    "poem_id": 87977,
    "vorder": 219,
    "position": 0,
    "text": "چو رزمش برین گونه پیوسته شد"
  },
  {
    "poem_id": 87977,
    "vorder": 220,
    "position": 1,
    "text": "به تیر‌ش دلاور بسی خسته شد"
  },
  {
    "poem_id": 87977,
    "vorder": 221,
    "position": 0,
    "text": "چو بهرام یل گشت بی‌توش و تاو"
  },
  {
    "poem_id": 87977,
    "vorder": 222,
    "position": 1,
    "text": "پس پشت او اندر آمد تژاو"
  },
  {
    "poem_id": 87977,
    "vorder": 223,
    "position": 0,
    "text": "یکی تیغ زد بر سر کتف اوی"
  },
  {
    "poem_id": 87977,
    "vorder": 224,
    "position": 1,
    "text": "که شیر اندر آمد ز بالا به روی"
  },
  {
    "poem_id": 87977,
    "vorder": 225,
    "position": 0,
    "text": "جدا شد ز تن دست خنجر‌گزار"
  },
  {
    "poem_id": 87977,
    "vorder": 226,
    "position": 1,
    "text": "فروماند از رزم و برگشت کار"
  },
  {
    "poem_id": 87977,
    "vorder": 227,
    "position": 0,
    "text": "تژاو ستمگاره را دل بسوخت"
  },
  {
    "poem_id": 87977,
    "vorder": 228,
    "position": 1,
    "text": "به کردار آتش رخش برفروخت"
  },
  {
    "poem_id": 87977,
    "vorder": 229,
    "position": 0,
    "text": "بپیچید ازو روی پر درد و شرم"
  },
  {
    "poem_id": 87977,
    "vorder": 230,
    "position": 1,
    "text": "بجوش آمدش در جگر خون گرم"
  }
]