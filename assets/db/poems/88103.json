[
  {
    "poem_id": 88103,
    "vorder": 1,
    "position": 0,
    "text": "به ایرانیان گفت پیروز شاه"
  },
  {
    "poem_id": 88103,
    "vorder": 2,
    "position": 1,
    "text": "که بدرود باد این دل افروز گاه"
  },
  {
    "poem_id": 88103,
    "vorder": 3,
    "position": 0,
    "text": "چو من بگذرم ز این فرومایه خاک"
  },
  {
    "poem_id": 88103,
    "vorder": 4,
    "position": 1,
    "text": "شما را بخواهم ز یزدان پاک"
  },
  {
    "poem_id": 88103,
    "vorder": 5,
    "position": 0,
    "text": "به پدرود کردن رخ هر کسی"
  },
  {
    "poem_id": 88103,
    "vorder": 6,
    "position": 1,
    "text": "ببوسید با آب مژگان بسی"
  },
  {
    "poem_id": 88103,
    "vorder": 7,
    "position": 0,
    "text": "یلان را همه پاک در بر گرفت"
  },
  {
    "poem_id": 88103,
    "vorder": 8,
    "position": 1,
    "text": "به زاری خروشیدن اندر گرفت"
  },
  {
    "poem_id": 88103,
    "vorder": 9,
    "position": 0,
    "text": "همی گفت کاجی من این انجمن"
  },
  {
    "poem_id": 88103,
    "vorder": 10,
    "position": 1,
    "text": "توانستمی برد با خویشتن"
  },
  {
    "poem_id": 88103,
    "vorder": 11,
    "position": 0,
    "text": "خروشی برآمد ز ایران سپاه"
  },
  {
    "poem_id": 88103,
    "vorder": 12,
    "position": 1,
    "text": "که خورشید بر چرخ گم کرد راه"
  },
  {
    "poem_id": 88103,
    "vorder": 13,
    "position": 0,
    "text": "پس پرده‌ها کودک خرد و زن"
  },
  {
    "poem_id": 88103,
    "vorder": 14,
    "position": 1,
    "text": "به کوی و به بازار شد انجمن"
  },
  {
    "poem_id": 88103,
    "vorder": 15,
    "position": 0,
    "text": "خروشیدن ناله و آه خاست"
  },
  {
    "poem_id": 88103,
    "vorder": 16,
    "position": 1,
    "text": "به هر برزنی ماتم شاه خاست"
  },
  {
    "poem_id": 88103,
    "vorder": 17,
    "position": 0,
    "text": "به ایرانیان آن زمان گفت شاه"
  },
  {
    "poem_id": 88103,
    "vorder": 18,
    "position": 1,
    "text": "که فردا شما را همین است راه"
  },
  {
    "poem_id": 88103,
    "vorder": 19,
    "position": 0,
    "text": "هر آن کس که دارید نام و نژاد"
  },
  {
    "poem_id": 88103,
    "vorder": 20,
    "position": 1,
    "text": "به دادار خورشید باشید شاد"
  },
  {
    "poem_id": 88103,
    "vorder": 21,
    "position": 0,
    "text": "من اکنون روان را همی پرورم"
  },
  {
    "poem_id": 88103,
    "vorder": 22,
    "position": 1,
    "text": "که بر نیک نامی مگر بگذرم"
  },
  {
    "poem_id": 88103,
    "vorder": 23,
    "position": 0,
    "text": "نبستم دل اندر سپنجی سرای"
  },
  {
    "poem_id": 88103,
    "vorder": 24,
    "position": 1,
    "text": "بدان تا سروش آمدم رهنمای"
  },
  {
    "poem_id": 88103,
    "vorder": 25,
    "position": 0,
    "text": "بگفت این و از پایگه اسب خواست"
  },
  {
    "poem_id": 88103,
    "vorder": 26,
    "position": 1,
    "text": "ز لشکرگه آواز فریاد خاست"
  },
  {
    "poem_id": 88103,
    "vorder": 27,
    "position": 0,
    "text": "بیامد به ایوان شاهی دژم"
  },
  {
    "poem_id": 88103,
    "vorder": 28,
    "position": 1,
    "text": "به آزاد سرو اندر آورده خم"
  },
  {
    "poem_id": 88103,
    "vorder": 29,
    "position": 0,
    "text": "کنیزک بدش چار چون آفتاب"
  },
  {
    "poem_id": 88103,
    "vorder": 30,
    "position": 1,
    "text": "ندیدی کسی چهر ایشان به خواب"
  },
  {
    "poem_id": 88103,
    "vorder": 31,
    "position": 0,
    "text": "ز پرده بتان را بر خویش خواند"
  },
  {
    "poem_id": 88103,
    "vorder": 32,
    "position": 1,
    "text": "همه راز دل پیش ایشان براند"
  },
  {
    "poem_id": 88103,
    "vorder": 33,
    "position": 0,
    "text": "که رفتیم اینک ز جای سپنج"
  },
  {
    "poem_id": 88103,
    "vorder": 34,
    "position": 1,
    "text": "شما دل مدارید با درد و رنج"
  },
  {
    "poem_id": 88103,
    "vorder": 35,
    "position": 0,
    "text": "نبینید جاوید ز این پس مرا"
  },
  {
    "poem_id": 88103,
    "vorder": 36,
    "position": 1,
    "text": "کز این خاک بیدادگر بس مرا"
  },
  {
    "poem_id": 88103,
    "vorder": 37,
    "position": 0,
    "text": "سوی داور پاک خواهم شدن"
  },
  {
    "poem_id": 88103,
    "vorder": 38,
    "position": 1,
    "text": "نبینم همی راه بازآمدن"
  },
  {
    "poem_id": 88103,
    "vorder": 39,
    "position": 0,
    "text": "بشد هوش زان چار خورشید چهر"
  },
  {
    "poem_id": 88103,
    "vorder": 40,
    "position": 1,
    "text": "خروشان شدند از غم و درد و مهر"
  },
  {
    "poem_id": 88103,
    "vorder": 41,
    "position": 0,
    "text": "شخودند روی و بکندند موی"
  },
  {
    "poem_id": 88103,
    "vorder": 42,
    "position": 1,
    "text": "گسستند پیرایه و رنگ و بوی"
  },
  {
    "poem_id": 88103,
    "vorder": 43,
    "position": 0,
    "text": "از آن پس هر آن کس که آمد به هوش"
  },
  {
    "poem_id": 88103,
    "vorder": 44,
    "position": 1,
    "text": "چنین گفت با ناله و با خروش"
  },
  {
    "poem_id": 88103,
    "vorder": 45,
    "position": 0,
    "text": "که ما را ببر ز این سرای سپنج"
  },
  {
    "poem_id": 88103,
    "vorder": 46,
    "position": 1,
    "text": "رها کن تو ما را از این درد و رنج"
  },
  {
    "poem_id": 88103,
    "vorder": 47,
    "position": 0,
    "text": "بدیشان چنین گفت پر مایه شاه"
  },
  {
    "poem_id": 88103,
    "vorder": 48,
    "position": 1,
    "text": "کز این پس شما را همین است راه"
  },
  {
    "poem_id": 88103,
    "vorder": 49,
    "position": 0,
    "text": "کجا خواهران جهاندار جم"
  },
  {
    "poem_id": 88103,
    "vorder": 50,
    "position": 1,
    "text": "کجا تاجداران با باد و دم"
  },
  {
    "poem_id": 88103,
    "vorder": 51,
    "position": 0,
    "text": "کجا مادرم دخت افراسیاب"
  },
  {
    "poem_id": 88103,
    "vorder": 52,
    "position": 1,
    "text": "که بگذشت زآن سان بدریای آب"
  },
  {
    "poem_id": 88103,
    "vorder": 53,
    "position": 0,
    "text": "کجا دختر تور ماه آفرید"
  },
  {
    "poem_id": 88103,
    "vorder": 54,
    "position": 1,
    "text": "که چون او کس اندر زمانه ندید"
  },
  {
    "poem_id": 88103,
    "vorder": 55,
    "position": 0,
    "text": "همه خاک دارند بالین و خشت"
  },
  {
    "poem_id": 88103,
    "vorder": 56,
    "position": 1,
    "text": "ندانم به دوزخ درند ار بهشت"
  },
  {
    "poem_id": 88103,
    "vorder": 57,
    "position": 0,
    "text": "مجویید از این رفتن آزار من"
  },
  {
    "poem_id": 88103,
    "vorder": 58,
    "position": 1,
    "text": "که آسان شود راه دشوار من"
  },
  {
    "poem_id": 88103,
    "vorder": 59,
    "position": 0,
    "text": "خروشید و لهراسب را پیش خواند"
  },
  {
    "poem_id": 88103,
    "vorder": 60,
    "position": 1,
    "text": "از ایشان فراوان سخنها براند"
  },
  {
    "poem_id": 88103,
    "vorder": 61,
    "position": 0,
    "text": "به لهراسب گفت این بتان منند"
  },
  {
    "poem_id": 88103,
    "vorder": 62,
    "position": 1,
    "text": "فروزندهٔ پاک جان منند"
  },
  {
    "poem_id": 88103,
    "vorder": 63,
    "position": 0,
    "text": "بر این هم نشست اندر این هم سرای"
  },
  {
    "poem_id": 88103,
    "vorder": 64,
    "position": 1,
    "text": "همی دارشان تا تو باشی به جای"
  },
  {
    "poem_id": 88103,
    "vorder": 65,
    "position": 0,
    "text": "نباید که یزدان چو خواندت پیش"
  },
  {
    "poem_id": 88103,
    "vorder": 66,
    "position": 1,
    "text": "روان شرم دارد ز کردار خویش"
  },
  {
    "poem_id": 88103,
    "vorder": 67,
    "position": 0,
    "text": "چو بینی مرا با سیاوش به هم"
  },
  {
    "poem_id": 88103,
    "vorder": 68,
    "position": 1,
    "text": "ز شرم دو خسرو بمانی دژم"
  },
  {
    "poem_id": 88103,
    "vorder": 69,
    "position": 0,
    "text": "پذیرفت لهراسب زو هرچه گفت"
  },
  {
    "poem_id": 88103,
    "vorder": 70,
    "position": 1,
    "text": "که با دیده‌شان دارم اندر نهفت"
  },
  {
    "poem_id": 88103,
    "vorder": 71,
    "position": 0,
    "text": "وز آن جایگه تنگ بسته میان"
  },
  {
    "poem_id": 88103,
    "vorder": 72,
    "position": 1,
    "text": "بگردید بر گرد ایرانیان"
  },
  {
    "poem_id": 88103,
    "vorder": 73,
    "position": 0,
    "text": "کز ایدر به ایوان خرامید زود"
  },
  {
    "poem_id": 88103,
    "vorder": 74,
    "position": 1,
    "text": "مدارید در دل مرا جز درود"
  },
  {
    "poem_id": 88103,
    "vorder": 75,
    "position": 0,
    "text": "مباشید گستاخ با این جهان"
  },
  {
    "poem_id": 88103,
    "vorder": 76,
    "position": 1,
    "text": "که او بدتری دارد اندر نهان"
  },
  {
    "poem_id": 88103,
    "vorder": 77,
    "position": 0,
    "text": "مباشید جاوید جز راد و شاد"
  },
  {
    "poem_id": 88103,
    "vorder": 78,
    "position": 1,
    "text": "ز من جز به نیکی مگیرید یاد"
  },
  {
    "poem_id": 88103,
    "vorder": 79,
    "position": 0,
    "text": "همه شاد و خرم به ایوان شوید"
  },
  {
    "poem_id": 88103,
    "vorder": 80,
    "position": 1,
    "text": "چو رفتن بود شاد و خندان شوید"
  },
  {
    "poem_id": 88103,
    "vorder": 81,
    "position": 0,
    "text": "همه نامداران ایران سپاه"
  },
  {
    "poem_id": 88103,
    "vorder": 82,
    "position": 1,
    "text": "نهادند سر بر زمین پیش شاه"
  },
  {
    "poem_id": 88103,
    "vorder": 83,
    "position": 0,
    "text": "که ما پند او را به کردار جان"
  },
  {
    "poem_id": 88103,
    "vorder": 84,
    "position": 1,
    "text": "بداریم تا جان بود جاودان"
  },
  {
    "poem_id": 88103,
    "vorder": 85,
    "position": 0,
    "text": "به لهراسب فرمود تا بازگشت"
  },
  {
    "poem_id": 88103,
    "vorder": 86,
    "position": 1,
    "text": "بدو گفت روز من اندر گذشت"
  },
  {
    "poem_id": 88103,
    "vorder": 87,
    "position": 0,
    "text": "تو رو تخت شاهی به‌آیین بدار"
  },
  {
    "poem_id": 88103,
    "vorder": 88,
    "position": 1,
    "text": "به گیتی جز از تخم نیکی مکار"
  },
  {
    "poem_id": 88103,
    "vorder": 89,
    "position": 0,
    "text": "هر آن گه که باشی تن آسان ز رنج"
  },
  {
    "poem_id": 88103,
    "vorder": 90,
    "position": 1,
    "text": "ننازی به تاج و ننازی به گنج"
  },
  {
    "poem_id": 88103,
    "vorder": 91,
    "position": 0,
    "text": "چنان دان که رفتنت نزدیک شد"
  },
  {
    "poem_id": 88103,
    "vorder": 92,
    "position": 1,
    "text": "به یزدان ترا راه باریک شد"
  },
  {
    "poem_id": 88103,
    "vorder": 93,
    "position": 0,
    "text": "همه داد جوی و همه داد کن"
  },
  {
    "poem_id": 88103,
    "vorder": 94,
    "position": 1,
    "text": "ز گیتی تن مهتر آزاد کن"
  },
  {
    "poem_id": 88103,
    "vorder": 95,
    "position": 0,
    "text": "فرود آمد از باره لهراسب زود"
  },
  {
    "poem_id": 88103,
    "vorder": 96,
    "position": 1,
    "text": "زمین را ببوسید و شادی نمود"
  },
  {
    "poem_id": 88103,
    "vorder": 97,
    "position": 0,
    "text": "بدو گفت خسرو که پدرود باش"
  },
  {
    "poem_id": 88103,
    "vorder": 98,
    "position": 1,
    "text": "به داد اندرون تار گر پود باش"
  },
  {
    "poem_id": 88103,
    "vorder": 99,
    "position": 0,
    "text": "برفتند با او ز ایران سران"
  },
  {
    "poem_id": 88103,
    "vorder": 100,
    "position": 1,
    "text": "بزرگان بیدار و کنداوران"
  },
  {
    "poem_id": 88103,
    "vorder": 101,
    "position": 0,
    "text": "چو دستان و رستم چو گودرز و گیو"
  },
  {
    "poem_id": 88103,
    "vorder": 102,
    "position": 1,
    "text": "دگر بیژن گیو و گستهم نیو"
  },
  {
    "poem_id": 88103,
    "vorder": 103,
    "position": 0,
    "text": "به هفتم فریبرز کاووس بود"
  },
  {
    "poem_id": 88103,
    "vorder": 104,
    "position": 1,
    "text": "به هشتم کجا نامور طوس بود"
  },
  {
    "poem_id": 88103,
    "vorder": 105,
    "position": 0,
    "text": "همی رفت لشکر گروهاگروه"
  },
  {
    "poem_id": 88103,
    "vorder": 106,
    "position": 1,
    "text": "ز هامون بشد تا سر تیغ کوه"
  },
  {
    "poem_id": 88103,
    "vorder": 107,
    "position": 0,
    "text": "ببودند یک هفته دم بر زدند"
  },
  {
    "poem_id": 88103,
    "vorder": 108,
    "position": 1,
    "text": "یکی بر لب خشک نم بر زدند"
  },
  {
    "poem_id": 88103,
    "vorder": 109,
    "position": 0,
    "text": "خروشان و جوشان ز کردار شاه"
  },
  {
    "poem_id": 88103,
    "vorder": 110,
    "position": 1,
    "text": "کسی را نبود اندر آن رنج راه"
  },
  {
    "poem_id": 88103,
    "vorder": 111,
    "position": 0,
    "text": "همی گفت هر موبدی در نهفت"
  },
  {
    "poem_id": 88103,
    "vorder": 112,
    "position": 1,
    "text": "کز این سان همی در جهان کس نگفت"
  },
  {
    "poem_id": 88103,
    "vorder": 113,
    "position": 0,
    "text": "چو خورشید بر زد سر از تیره کوه"
  },
  {
    "poem_id": 88103,
    "vorder": 114,
    "position": 1,
    "text": "بیامد به پیشش ز هر سو گروه"
  },
  {
    "poem_id": 88103,
    "vorder": 115,
    "position": 0,
    "text": "زن و مرد ایرانیان صدهزار"
  },
  {
    "poem_id": 88103,
    "vorder": 116,
    "position": 1,
    "text": "خروشان برفتند با شهریار"
  },
  {
    "poem_id": 88103,
    "vorder": 117,
    "position": 0,
    "text": "همه کوه پر ناله و با خروش"
  },
  {
    "poem_id": 88103,
    "vorder": 118,
    "position": 1,
    "text": "همی سنگ خارا برآمد به جوش"
  },
  {
    "poem_id": 88103,
    "vorder": 119,
    "position": 0,
    "text": "همی گفت هر کس که شاها چه بود"
  },
  {
    "poem_id": 88103,
    "vorder": 120,
    "position": 1,
    "text": "که روشن دلت شد پر از داغ و دود"
  },
  {
    "poem_id": 88103,
    "vorder": 121,
    "position": 0,
    "text": "گر از لشکر آزار داری همی"
  },
  {
    "poem_id": 88103,
    "vorder": 122,
    "position": 1,
    "text": "مر این تاج را خوار داری همی"
  },
  {
    "poem_id": 88103,
    "vorder": 123,
    "position": 0,
    "text": "بگوی و تو از گاه ایران مرو"
  },
  {
    "poem_id": 88103,
    "vorder": 124,
    "position": 1,
    "text": "جهان کهن را مکن شاه نو"
  },
  {
    "poem_id": 88103,
    "vorder": 125,
    "position": 0,
    "text": "همه خاک باشیم اسب ترا"
  },
  {
    "poem_id": 88103,
    "vorder": 126,
    "position": 1,
    "text": "پرستنده آذرگشسب ترا"
  },
  {
    "poem_id": 88103,
    "vorder": 127,
    "position": 0,
    "text": "کجا شد ترا دانش و رای و هوش"
  },
  {
    "poem_id": 88103,
    "vorder": 128,
    "position": 1,
    "text": "که نزد فریدون نیامد سروش"
  },
  {
    "poem_id": 88103,
    "vorder": 129,
    "position": 0,
    "text": "همه پیش یزدان ستایش کنیم"
  },
  {
    "poem_id": 88103,
    "vorder": 130,
    "position": 1,
    "text": "به آتشکده در نیایش کنیم"
  },
  {
    "poem_id": 88103,
    "vorder": 131,
    "position": 0,
    "text": "مگر پاک یزدانت بخشد به ما"
  },
  {
    "poem_id": 88103,
    "vorder": 132,
    "position": 1,
    "text": "دل موبدان بردرخشد به ما"
  },
  {
    "poem_id": 88103,
    "vorder": 133,
    "position": 0,
    "text": "شهنشاه زآن کار خیره بماند"
  },
  {
    "poem_id": 88103,
    "vorder": 134,
    "position": 1,
    "text": "از آن انجمن موبدان را بخواند"
  },
  {
    "poem_id": 88103,
    "vorder": 135,
    "position": 0,
    "text": "چنین گفت ایدر همه نیکویست"
  },
  {
    "poem_id": 88103,
    "vorder": 136,
    "position": 1,
    "text": "بر این نیکویها نباید گریست"
  },
  {
    "poem_id": 88103,
    "vorder": 137,
    "position": 0,
    "text": "ز یزدان شناسید یکسر سپاس"
  },
  {
    "poem_id": 88103,
    "vorder": 138,
    "position": 1,
    "text": "مباشید جز پاک یزدان‌شناس"
  },
  {
    "poem_id": 88103,
    "vorder": 139,
    "position": 0,
    "text": "که گرد آمدن زود باشد به هم"
  },
  {
    "poem_id": 88103,
    "vorder": 140,
    "position": 1,
    "text": "مباشید ز این رفتن من دژم"
  },
  {
    "poem_id": 88103,
    "vorder": 141,
    "position": 0,
    "text": "بدان مهتران گفت ز این کوهسار"
  },
  {
    "poem_id": 88103,
    "vorder": 142,
    "position": 1,
    "text": "همه بازگردید بی‌شهریار"
  },
  {
    "poem_id": 88103,
    "vorder": 143,
    "position": 0,
    "text": "که راهی دراز است و بی‌آب و سخت"
  },
  {
    "poem_id": 88103,
    "vorder": 144,
    "position": 1,
    "text": "نباشد گیاه و نه برگ درخت"
  },
  {
    "poem_id": 88103,
    "vorder": 145,
    "position": 0,
    "text": "ز با من شدن راه کوته کنید"
  },
  {
    "poem_id": 88103,
    "vorder": 146,
    "position": 1,
    "text": "روان را سوی روشنی ره کنید"
  },
  {
    "poem_id": 88103,
    "vorder": 147,
    "position": 0,
    "text": "بر این ریگ برنگذرد هر کسی"
  },
  {
    "poem_id": 88103,
    "vorder": 148,
    "position": 1,
    "text": "مگر فره و برز دارد بسی"
  },
  {
    "poem_id": 88103,
    "vorder": 149,
    "position": 0,
    "text": "سه مرد گرانمایه و سرفراز"
  },
  {
    "poem_id": 88103,
    "vorder": 150,
    "position": 1,
    "text": "شنیدند گفتار و گشتند باز"
  },
  {
    "poem_id": 88103,
    "vorder": 151,
    "position": 0,
    "text": "چو دستان و رستم چو گودرز پیر"
  },
  {
    "poem_id": 88103,
    "vorder": 152,
    "position": 1,
    "text": "جهانجوی و بیننده و یادگیر"
  },
  {
    "poem_id": 88103,
    "vorder": 153,
    "position": 0,
    "text": "نگشتند ز او باز چون طوس و گیو"
  },
  {
    "poem_id": 88103,
    "vorder": 154,
    "position": 1,
    "text": "همان بیژن و هم فریبرز نیو"
  },
  {
    "poem_id": 88103,
    "vorder": 155,
    "position": 0,
    "text": "برفتند یک روز و یک شب به هم"
  },
  {
    "poem_id": 88103,
    "vorder": 156,
    "position": 1,
    "text": "شدند از بیابان و خشکی دژم"
  },
  {
    "poem_id": 88103,
    "vorder": 157,
    "position": 0,
    "text": "به ره بر یکی چشمه آمد پدید"
  },
  {
    "poem_id": 88103,
    "vorder": 158,
    "position": 1,
    "text": "جهانجوی کیخسرو آنجا رسید"
  },
  {
    "poem_id": 88103,
    "vorder": 159,
    "position": 0,
    "text": "بدان آب روشن فرود آمدند"
  },
  {
    "poem_id": 88103,
    "vorder": 160,
    "position": 1,
    "text": "بخوردند چیزی و دم بر زدند"
  },
  {
    "poem_id": 88103,
    "vorder": 161,
    "position": 0,
    "text": "بدان مرزبانان چنین گفت شاه"
  },
  {
    "poem_id": 88103,
    "vorder": 162,
    "position": 1,
    "text": "که امشب نرانیم ز این جایگاه"
  },
  {
    "poem_id": 88103,
    "vorder": 163,
    "position": 0,
    "text": "بجوییم کار گذشته بسی"
  },
  {
    "poem_id": 88103,
    "vorder": 164,
    "position": 1,
    "text": "کز این پس نبینند ما را کسی"
  },
  {
    "poem_id": 88103,
    "vorder": 165,
    "position": 0,
    "text": "چو خورشید تابان برآرد درفش"
  },
  {
    "poem_id": 88103,
    "vorder": 166,
    "position": 1,
    "text": "چو زر آب گردد زمین بنفش"
  },
  {
    "poem_id": 88103,
    "vorder": 167,
    "position": 0,
    "text": "مرا روزگار جدایی بود"
  },
  {
    "poem_id": 88103,
    "vorder": 168,
    "position": 1,
    "text": "مگر با سروش آشنایی بود"
  },
  {
    "poem_id": 88103,
    "vorder": 169,
    "position": 0,
    "text": "از این رای گر تاب گیرد دلم"
  },
  {
    "poem_id": 88103,
    "vorder": 170,
    "position": 1,
    "text": "دل تیره گشته ز تن بگسلم"
  }
]