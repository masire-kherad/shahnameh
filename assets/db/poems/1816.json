[
  {
    "poem_id": 1816,
    "vorder": 1,
    "position": 0,
    "text": "چو شد پادشا بر جهان یزدگرد"
  },
  {
    "poem_id": 1816,
    "vorder": 2,
    "position": 1,
    "text": "سپاه پراگنده را کرد گرد"
  },
  {
    "poem_id": 1816,
    "vorder": 3,
    "position": 0,
    "text": "نشستند با موبدان و ردان"
  },
  {
    "poem_id": 1816,
    "vorder": 4,
    "position": 1,
    "text": "بزرگان و سالاروَش بخردان"
  },
  {
    "poem_id": 1816,
    "vorder": 5,
    "position": 0,
    "text": "جهانجوی بر تخت زرین نشست"
  },
  {
    "poem_id": 1816,
    "vorder": 6,
    "position": 1,
    "text": "در رنج و دست بدی را ببست"
  },
  {
    "poem_id": 1816,
    "vorder": 7,
    "position": 0,
    "text": "نخستین چنین گفت کن کز گناه"
  },
  {
    "poem_id": 1816,
    "vorder": 8,
    "position": 1,
    "text": "برآسود شد ایمن از کینه‌خواه"
  },
  {
    "poem_id": 1816,
    "vorder": 9,
    "position": 0,
    "text": "هر آنکس که دل تیره دارد ز رشک"
  },
  {
    "poem_id": 1816,
    "vorder": 10,
    "position": 1,
    "text": "مر آن درد را دور باشد پزشک"
  },
  {
    "poem_id": 1816,
    "vorder": 11,
    "position": 0,
    "text": "که رشک آورد آز و گرم و گداز"
  },
  {
    "poem_id": 1816,
    "vorder": 12,
    "position": 1,
    "text": "دُژآگاه دیوی بود دیرساز"
  },
  {
    "poem_id": 1816,
    "vorder": 13,
    "position": 0,
    "text": "هرآن چیز کآنت نیاید پسند"
  },
  {
    "poem_id": 1816,
    "vorder": 14,
    "position": 1,
    "text": "دل دوست و دشمن بر آن برمبند"
  },
  {
    "poem_id": 1816,
    "vorder": 15,
    "position": 0,
    "text": "مدارا خرد را برابر بود"
  },
  {
    "poem_id": 1816,
    "vorder": 16,
    "position": 1,
    "text": "خرد بر سر دانش افسر بود"
  },
  {
    "poem_id": 1816,
    "vorder": 17,
    "position": 0,
    "text": "به جای کسی گر تو نیکی کنی"
  },
  {
    "poem_id": 1816,
    "vorder": 18,
    "position": 1,
    "text": "مزن بر سرش تا دلش نشکنی"
  },
  {
    "poem_id": 1816,
    "vorder": 19,
    "position": 0,
    "text": "چو نیکی‌کنِش باشی و بردبار"
  },
  {
    "poem_id": 1816,
    "vorder": 20,
    "position": 1,
    "text": "نباشی به چشم خردمند خوار"
  },
  {
    "poem_id": 1816,
    "vorder": 21,
    "position": 0,
    "text": "اگر بخت پیروز یاری دهد"
  },
  {
    "poem_id": 1816,
    "vorder": 22,
    "position": 1,
    "text": "مرا بر جهان کامگاری دهد"
  },
  {
    "poem_id": 1816,
    "vorder": 23,
    "position": 0,
    "text": "یکی دفتری سازم از راستی"
  },
  {
    "poem_id": 1816,
    "vorder": 24,
    "position": 1,
    "text": "که بندد در کژی و کاستی"
  },
  {
    "poem_id": 1816,
    "vorder": 25,
    "position": 0,
    "text": "همی‌داشت یک چند گیتی به داد"
  },
  {
    "poem_id": 1816,
    "vorder": 26,
    "position": 1,
    "text": "زمانه بدو شاد و او نیز شاد"
  },
  {
    "poem_id": 1816,
    "vorder": 27,
    "position": 0,
    "text": "به هر سو فرستاد بی‌مر سپاه"
  },
  {
    "poem_id": 1816,
    "vorder": 28,
    "position": 1,
    "text": "همی‌داشت گیتی ز دشمن نگاه"
  },
  {
    "poem_id": 1816,
    "vorder": 29,
    "position": 0,
    "text": "ده و هشت بگذشت سال از برش"
  },
  {
    "poem_id": 1816,
    "vorder": 30,
    "position": 1,
    "text": "به پاییز چون تیره گشت افسرش"
  },
  {
    "poem_id": 1816,
    "vorder": 31,
    "position": 0,
    "text": "بزرگان و دانندگان را بخواند"
  },
  {
    "poem_id": 1816,
    "vorder": 32,
    "position": 1,
    "text": "بر تخت زرین به زانو نشاند"
  },
  {
    "poem_id": 1816,
    "vorder": 33,
    "position": 0,
    "text": "چنین گفت کین چرخ ناپایدار"
  },
  {
    "poem_id": 1816,
    "vorder": 34,
    "position": 1,
    "text": "نه پرورده داند نه پرودگار"
  },
  {
    "poem_id": 1816,
    "vorder": 35,
    "position": 0,
    "text": "به تاج گرانمایگان ننگرد"
  },
  {
    "poem_id": 1816,
    "vorder": 36,
    "position": 1,
    "text": "شکاری که یابد همی بشکرد"
  },
  {
    "poem_id": 1816,
    "vorder": 37,
    "position": 0,
    "text": "کنون روز من بر سر آید همی"
  },
  {
    "poem_id": 1816,
    "vorder": 38,
    "position": 1,
    "text": "به نیرو شکست اندر آید همی"
  },
  {
    "poem_id": 1816,
    "vorder": 39,
    "position": 0,
    "text": "سپردم به هرمز کلاه و نگین"
  },
  {
    "poem_id": 1816,
    "vorder": 40,
    "position": 1,
    "text": "همه لشکر و گنج ایران زمین"
  },
  {
    "poem_id": 1816,
    "vorder": 41,
    "position": 0,
    "text": "همه گوش دارید و فرمان کنید"
  },
  {
    "poem_id": 1816,
    "vorder": 42,
    "position": 1,
    "text": "ز پیمان او رامش جان کنید"
  },
  {
    "poem_id": 1816,
    "vorder": 43,
    "position": 0,
    "text": "اگر چند پیروز با فر و یال"
  },
  {
    "poem_id": 1816,
    "vorder": 44,
    "position": 1,
    "text": "ز هرمز فزونست چندی به سال"
  },
  {
    "poem_id": 1816,
    "vorder": 45,
    "position": 0,
    "text": "ز هرمز همی‌بینم آهستگی"
  },
  {
    "poem_id": 1816,
    "vorder": 46,
    "position": 1,
    "text": "خردمندی و داد و شایستگی"
  },
  {
    "poem_id": 1816,
    "vorder": 47,
    "position": 0,
    "text": "بگفت این و یک هفته زان پس بزیست"
  },
  {
    "poem_id": 1816,
    "vorder": 48,
    "position": 1,
    "text": "برفت و بر او تخت چندی گریست"
  },
  {
    "poem_id": 1816,
    "vorder": 49,
    "position": 0,
    "text": "اگر صد بمانی و گر بیست‌وپنج"
  },
  {
    "poem_id": 1816,
    "vorder": 50,
    "position": 1,
    "text": "ببایدت رفتن ز جای سپنج"
  },
  {
    "poem_id": 1816,
    "vorder": 51,
    "position": 0,
    "text": "هر آن چیز کآید همی در شمار"
  },
  {
    "poem_id": 1816,
    "vorder": 52,
    "position": 1,
    "text": "سزد گر نخوانی ورا پایدار"
  }
]