[
  {
    "poem_id": 1376,
    "vorder": 1,
    "position": 0,
    "text": "به سلم آگهی رفت ازین رزمگاه"
  },
  {
    "poem_id": 1376,
    "vorder": 2,
    "position": 1,
    "text": "وزان تیرگی کاندر آمد به ماه"
  },
  {
    "poem_id": 1376,
    "vorder": 3,
    "position": 0,
    "text": "پس پشتش اندر یکی حصن بود"
  },
  {
    "poem_id": 1376,
    "vorder": 4,
    "position": 1,
    "text": "برآورده سر تا به چرخ کبود"
  },
  {
    "poem_id": 1376,
    "vorder": 5,
    "position": 0,
    "text": "چنان ساخت کاید بدان حصن باز"
  },
  {
    "poem_id": 1376,
    "vorder": 6,
    "position": 1,
    "text": "که دارد زمانه نشیب و فراز"
  },
  {
    "poem_id": 1376,
    "vorder": 7,
    "position": 0,
    "text": "هم این یک سخن قارن اندیشه کرد"
  },
  {
    "poem_id": 1376,
    "vorder": 8,
    "position": 1,
    "text": "که برگاشتش سلم روی از نبرد"
  },
  {
    "poem_id": 1376,
    "vorder": 9,
    "position": 0,
    "text": "کلانی دژش باشد آرامگاه"
  },
  {
    "poem_id": 1376,
    "vorder": 10,
    "position": 1,
    "text": "سزد گر برو بربگیریم راه"
  },
  {
    "poem_id": 1376,
    "vorder": 11,
    "position": 0,
    "text": "که گر حصن دریا شود جای اوی"
  },
  {
    "poem_id": 1376,
    "vorder": 12,
    "position": 1,
    "text": "کسی نگسلاند ز بن پای اوی"
  },
  {
    "poem_id": 1376,
    "vorder": 13,
    "position": 0,
    "text": "یکی جای دارد سر اندر سحاب"
  },
  {
    "poem_id": 1376,
    "vorder": 14,
    "position": 1,
    "text": "به چاره برآورده از قعر آب"
  },
  {
    "poem_id": 1376,
    "vorder": 15,
    "position": 0,
    "text": "نهاده ز هر چیز گنجی به جای"
  },
  {
    "poem_id": 1376,
    "vorder": 16,
    "position": 1,
    "text": "فگنده برو سایه پر همای"
  },
  {
    "poem_id": 1376,
    "vorder": 17,
    "position": 0,
    "text": "مرا رفت باید بدین چاره زود"
  },
  {
    "poem_id": 1376,
    "vorder": 18,
    "position": 1,
    "text": "رکاب و عنان را بباید بسود"
  },
  {
    "poem_id": 1376,
    "vorder": 19,
    "position": 0,
    "text": "اگر شاه بیند ز جنگ‌آوران"
  },
  {
    "poem_id": 1376,
    "vorder": 20,
    "position": 1,
    "text": "به کهتر سپارد سپاهی گران"
  },
  {
    "poem_id": 1376,
    "vorder": 21,
    "position": 0,
    "text": "همان با درفش همایون شاه"
  },
  {
    "poem_id": 1376,
    "vorder": 22,
    "position": 1,
    "text": "هم انگشتر تور با من به راه"
  },
  {
    "poem_id": 1376,
    "vorder": 23,
    "position": 0,
    "text": "بباید کنون چاره‌ای ساختن"
  },
  {
    "poem_id": 1376,
    "vorder": 24,
    "position": 1,
    "text": "سپه را به حصن اندر انداختن"
  },
  {
    "poem_id": 1376,
    "vorder": 25,
    "position": 0,
    "text": "من و گرد گرشاسپ وین تیره شب"
  },
  {
    "poem_id": 1376,
    "vorder": 26,
    "position": 1,
    "text": "برین راز بر باد مگشای لب"
  },
  {
    "poem_id": 1376,
    "vorder": 27,
    "position": 0,
    "text": "چو روی هوا گشت چون آبنوس"
  },
  {
    "poem_id": 1376,
    "vorder": 28,
    "position": 1,
    "text": "نهادند بر کوههٔ پیل کوس"
  },
  {
    "poem_id": 1376,
    "vorder": 29,
    "position": 0,
    "text": "همه نامداران پرخاشجوی"
  },
  {
    "poem_id": 1376,
    "vorder": 30,
    "position": 1,
    "text": "ز خشکی به دریا نهادند روی"
  },
  {
    "poem_id": 1376,
    "vorder": 31,
    "position": 0,
    "text": "سپه را به شیروی بسپرد و گفت"
  },
  {
    "poem_id": 1376,
    "vorder": 32,
    "position": 1,
    "text": "که من خویشتن را بخواهم نهفت"
  },
  {
    "poem_id": 1376,
    "vorder": 33,
    "position": 0,
    "text": "شوم سوی دژبان به پیغمبری"
  },
  {
    "poem_id": 1376,
    "vorder": 34,
    "position": 1,
    "text": "نمایم بدو مهر انگشتری"
  },
  {
    "poem_id": 1376,
    "vorder": 35,
    "position": 0,
    "text": "چو در دژ شوم برفرازم درفش"
  },
  {
    "poem_id": 1376,
    "vorder": 36,
    "position": 1,
    "text": "درفشان کنم تیغ های بنفش"
  },
  {
    "poem_id": 1376,
    "vorder": 37,
    "position": 0,
    "text": "شما روی یکسر سوی دژ نهید"
  },
  {
    "poem_id": 1376,
    "vorder": 38,
    "position": 1,
    "text": "چنانک اندر آید دمید و دهید"
  },
  {
    "poem_id": 1376,
    "vorder": 39,
    "position": 0,
    "text": "سپه را به نزدیک دریا بماند"
  },
  {
    "poem_id": 1376,
    "vorder": 40,
    "position": 1,
    "text": "به شیروی شیراوژن و خود براند"
  },
  {
    "poem_id": 1376,
    "vorder": 41,
    "position": 0,
    "text": "بیامد چو نزدیکی دژ رسید"
  },
  {
    "poem_id": 1376,
    "vorder": 42,
    "position": 1,
    "text": "سخن گفت و دژدار مهرش بدید"
  },
  {
    "poem_id": 1376,
    "vorder": 43,
    "position": 0,
    "text": "چنین گفت کز نزد تور آمدم"
  },
  {
    "poem_id": 1376,
    "vorder": 44,
    "position": 1,
    "text": "بفرمود تا یک زمان دم زدم"
  },
  {
    "poem_id": 1376,
    "vorder": 45,
    "position": 0,
    "text": "مرا گفت شو پیش دژبان بگوی"
  },
  {
    "poem_id": 1376,
    "vorder": 46,
    "position": 1,
    "text": "که روز و شب آرام و خوردن مجوی"
  },
  {
    "poem_id": 1376,
    "vorder": 47,
    "position": 0,
    "text": "کز ایدر درفش منوچهر شاه"
  },
  {
    "poem_id": 1376,
    "vorder": 48,
    "position": 1,
    "text": "سوی دژ فرستد همی با سپاه"
  },
  {
    "poem_id": 1376,
    "vorder": 49,
    "position": 0,
    "text": "تو با او به نیک و به بد یار باش"
  },
  {
    "poem_id": 1376,
    "vorder": 50,
    "position": 1,
    "text": "نگهبان دژ باش و بیدار باش"
  },
  {
    "poem_id": 1376,
    "vorder": 51,
    "position": 0,
    "text": "چو دژبان چنین گفتها را شنید"
  },
  {
    "poem_id": 1376,
    "vorder": 52,
    "position": 1,
    "text": "همان مهر انگشتری را بدید"
  },
  {
    "poem_id": 1376,
    "vorder": 53,
    "position": 0,
    "text": "همان گه در دژ گشادند باز"
  },
  {
    "poem_id": 1376,
    "vorder": 54,
    "position": 1,
    "text": "بدید آشکارا ندانست راز"
  },
  {
    "poem_id": 1376,
    "vorder": 55,
    "position": 0,
    "text": "نگر تا سخنگوی دهقان چه گفت"
  },
  {
    "poem_id": 1376,
    "vorder": 56,
    "position": 1,
    "text": "که راز دل آن دید کو دل نهفت"
  },
  {
    "poem_id": 1376,
    "vorder": 57,
    "position": 0,
    "text": "مرا و تو را بندگی پیشه باد"
  },
  {
    "poem_id": 1376,
    "vorder": 58,
    "position": 1,
    "text": "ابا پیشه‌مان نیز اندیشه باد"
  },
  {
    "poem_id": 1376,
    "vorder": 59,
    "position": 0,
    "text": "به نیک و به بد هر چه شاید بدن"
  },
  {
    "poem_id": 1376,
    "vorder": 60,
    "position": 1,
    "text": "بباید همی داستان ها زدن"
  },
  {
    "poem_id": 1376,
    "vorder": 61,
    "position": 0,
    "text": "چو دژدار و چون قارن رزمجوی"
  },
  {
    "poem_id": 1376,
    "vorder": 62,
    "position": 1,
    "text": "یکایک به روی اندر آورده روی"
  },
  {
    "poem_id": 1376,
    "vorder": 63,
    "position": 0,
    "text": "یکی بدسگال و یکی ساده دل"
  },
  {
    "poem_id": 1376,
    "vorder": 64,
    "position": 1,
    "text": "سپهبد به هر چاره آماده دل"
  },
  {
    "poem_id": 1376,
    "vorder": 65,
    "position": 0,
    "text": "همی جست آن روز تا شب زمان"
  },
  {
    "poem_id": 1376,
    "vorder": 66,
    "position": 1,
    "text": "نه آگاه دژدار از آن بدگمان"
  },
  {
    "poem_id": 1376,
    "vorder": 67,
    "position": 0,
    "text": "به بیگانه بر مهر خویشی نهاد"
  },
  {
    "poem_id": 1376,
    "vorder": 68,
    "position": 1,
    "text": "بداد از گزافه سر و دژ به باد"
  },
  {
    "poem_id": 1376,
    "vorder": 69,
    "position": 0,
    "text": "چو شب روز شد قارن رزمخواه"
  },
  {
    "poem_id": 1376,
    "vorder": 70,
    "position": 1,
    "text": "درفشی برافراخت چون گرد ماه"
  },
  {
    "poem_id": 1376,
    "vorder": 71,
    "position": 0,
    "text": "خروشید و بنمود یک یک نشان"
  },
  {
    "poem_id": 1376,
    "vorder": 72,
    "position": 1,
    "text": "به شیروی و گردان گردن کشان"
  },
  {
    "poem_id": 1376,
    "vorder": 73,
    "position": 0,
    "text": "چو شیروی دید آن درفش یلی"
  },
  {
    "poem_id": 1376,
    "vorder": 74,
    "position": 1,
    "text": "به کین روی بنهاد با پردلی"
  },
  {
    "poem_id": 1376,
    "vorder": 75,
    "position": 0,
    "text": "در حصن بگرفت و اندر نهاد"
  },
  {
    "poem_id": 1376,
    "vorder": 76,
    "position": 1,
    "text": "سران را ز خون بر سر افسر نهاد"
  },
  {
    "poem_id": 1376,
    "vorder": 77,
    "position": 0,
    "text": "به یک دست قارن به یک دست شیر"
  },
  {
    "poem_id": 1376,
    "vorder": 78,
    "position": 1,
    "text": "به سر گرز و تیغ آتش و آب زیر"
  },
  {
    "poem_id": 1376,
    "vorder": 79,
    "position": 0,
    "text": "چو خورشید بر تیغ گنبد رسید"
  },
  {
    "poem_id": 1376,
    "vorder": 80,
    "position": 1,
    "text": "نه آیین دژ بد نه دژبان پدید"
  },
  {
    "poem_id": 1376,
    "vorder": 81,
    "position": 0,
    "text": "نه دژ بود گفتی نه کشتی بر آب"
  },
  {
    "poem_id": 1376,
    "vorder": 82,
    "position": 1,
    "text": "یکی دود دیدی سراندر سحاب"
  },
  {
    "poem_id": 1376,
    "vorder": 83,
    "position": 0,
    "text": "درخشیدن آتش و باد خاست"
  },
  {
    "poem_id": 1376,
    "vorder": 84,
    "position": 1,
    "text": "خروش سواران و فریاد خاست"
  },
  {
    "poem_id": 1376,
    "vorder": 85,
    "position": 0,
    "text": "چو خورشید تابان ز بالا بگشت"
  },
  {
    "poem_id": 1376,
    "vorder": 86,
    "position": 1,
    "text": "چه آن دژ نمود و چه آن پهن دشت"
  },
  {
    "poem_id": 1376,
    "vorder": 87,
    "position": 0,
    "text": "بکشتند از ایشان فزون از شمار"
  },
  {
    "poem_id": 1376,
    "vorder": 88,
    "position": 1,
    "text": "همی دود از آتش برآمد چو قار"
  },
  {
    "poem_id": 1376,
    "vorder": 89,
    "position": 0,
    "text": "همه روی دریا شده قیرگون"
  },
  {
    "poem_id": 1376,
    "vorder": 90,
    "position": 1,
    "text": "همه روی صحرا شده جوی خون"
  }
]