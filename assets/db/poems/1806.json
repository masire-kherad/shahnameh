[
  {
    "poem_id": 1806,
    "vorder": 1,
    "position": 0,
    "text": "همان شاه شنگل دلی پر ز درد"
  },
  {
    "poem_id": 1806,
    "vorder": 2,
    "position": 1,
    "text": "همی داشت از کار او روی زرد"
  },
  {
    "poem_id": 1806,
    "vorder": 3,
    "position": 0,
    "text": "شب آمد بیاورد فرزانه را"
  },
  {
    "poem_id": 1806,
    "vorder": 4,
    "position": 1,
    "text": "همان مردم خویش و بیگانه را"
  },
  {
    "poem_id": 1806,
    "vorder": 5,
    "position": 0,
    "text": "چنین گفت کاین مرد بهرامشاه"
  },
  {
    "poem_id": 1806,
    "vorder": 6,
    "position": 1,
    "text": "بدین زور و این شاخ و این دستگاه"
  },
  {
    "poem_id": 1806,
    "vorder": 7,
    "position": 0,
    "text": "نباشد همی ایدر از هیچ روی"
  },
  {
    "poem_id": 1806,
    "vorder": 8,
    "position": 1,
    "text": "ز هرگونه آمیختم رنگ و بوی"
  },
  {
    "poem_id": 1806,
    "vorder": 9,
    "position": 0,
    "text": "گر از نزد ما او به ایران شود"
  },
  {
    "poem_id": 1806,
    "vorder": 10,
    "position": 1,
    "text": "به نزدیک شاه دلیران شود"
  },
  {
    "poem_id": 1806,
    "vorder": 11,
    "position": 0,
    "text": "سپاه مرا سست خواند به کار"
  },
  {
    "poem_id": 1806,
    "vorder": 12,
    "position": 1,
    "text": "به هندوستان نیست گوید سوار"
  },
  {
    "poem_id": 1806,
    "vorder": 13,
    "position": 0,
    "text": "سرافراز گردد مگر دشمنم"
  },
  {
    "poem_id": 1806,
    "vorder": 14,
    "position": 1,
    "text": "فرستاده را سر ز تن برکنم"
  },
  {
    "poem_id": 1806,
    "vorder": 15,
    "position": 0,
    "text": "نهانش همی کرد خواهم تباه"
  },
  {
    "poem_id": 1806,
    "vorder": 16,
    "position": 1,
    "text": "چه بینید این را چه دانید راه"
  },
  {
    "poem_id": 1806,
    "vorder": 17,
    "position": 0,
    "text": "بدو گفت فرزانه کای شهریار"
  },
  {
    "poem_id": 1806,
    "vorder": 18,
    "position": 1,
    "text": "دلت را بدین‌گونه رنجه مدار"
  },
  {
    "poem_id": 1806,
    "vorder": 19,
    "position": 0,
    "text": "فرستادهٔ شهریاران کشی"
  },
  {
    "poem_id": 1806,
    "vorder": 20,
    "position": 1,
    "text": "به غمری برد راه و بیدانشی"
  },
  {
    "poem_id": 1806,
    "vorder": 21,
    "position": 0,
    "text": "کس اندیشه زین‌گونه هرگز نکرد"
  },
  {
    "poem_id": 1806,
    "vorder": 22,
    "position": 1,
    "text": "به راه چنین رای هرگز مگرد"
  },
  {
    "poem_id": 1806,
    "vorder": 23,
    "position": 0,
    "text": "بر مهتران زشت‌نامی بود"
  },
  {
    "poem_id": 1806,
    "vorder": 24,
    "position": 1,
    "text": "سپهبد به مردم گرامی بود"
  },
  {
    "poem_id": 1806,
    "vorder": 25,
    "position": 0,
    "text": "پس‌انگه بیاید از ایران سپاه"
  },
  {
    "poem_id": 1806,
    "vorder": 26,
    "position": 1,
    "text": "یکی تاجداری چو بهرامشاه"
  },
  {
    "poem_id": 1806,
    "vorder": 27,
    "position": 0,
    "text": "نماند ز ما کس بدینجا درست"
  },
  {
    "poem_id": 1806,
    "vorder": 28,
    "position": 1,
    "text": "ز نیکی نباید ترا دست شست"
  },
  {
    "poem_id": 1806,
    "vorder": 29,
    "position": 0,
    "text": "رهانیدهٔ ماست از اژدها"
  },
  {
    "poem_id": 1806,
    "vorder": 30,
    "position": 1,
    "text": "نه کشتن بود رنج او را بها"
  },
  {
    "poem_id": 1806,
    "vorder": 31,
    "position": 0,
    "text": "بدین بوم ما اژدها کشت و کرگ"
  },
  {
    "poem_id": 1806,
    "vorder": 32,
    "position": 1,
    "text": "به تن زندگانی فزایش نه مرگ"
  },
  {
    "poem_id": 1806,
    "vorder": 33,
    "position": 0,
    "text": "چو بشنید شنگل سخن تیره شد"
  },
  {
    "poem_id": 1806,
    "vorder": 34,
    "position": 1,
    "text": "ز گفتار فرزانگان خیره شد"
  },
  {
    "poem_id": 1806,
    "vorder": 35,
    "position": 0,
    "text": "ببود آن شب و بامداد پگاه"
  },
  {
    "poem_id": 1806,
    "vorder": 36,
    "position": 1,
    "text": "فرستاد کس نزد بهرامشاه"
  },
  {
    "poem_id": 1806,
    "vorder": 37,
    "position": 0,
    "text": "به تنها تن خویش بی‌انجمن"
  },
  {
    "poem_id": 1806,
    "vorder": 38,
    "position": 1,
    "text": "نه دستور بد پیش و نه رای زن"
  },
  {
    "poem_id": 1806,
    "vorder": 39,
    "position": 0,
    "text": "به بهرام گفت ای دلارای مرد"
  },
  {
    "poem_id": 1806,
    "vorder": 40,
    "position": 1,
    "text": "توانگر شدی گرد بیشی مگرد"
  },
  {
    "poem_id": 1806,
    "vorder": 41,
    "position": 0,
    "text": "بتو داد خواهم همی دخترم"
  },
  {
    "poem_id": 1806,
    "vorder": 42,
    "position": 1,
    "text": "ز گفتار و کردار باشد برم"
  },
  {
    "poem_id": 1806,
    "vorder": 43,
    "position": 0,
    "text": "چو این کرده باشم بر من بایست"
  },
  {
    "poem_id": 1806,
    "vorder": 44,
    "position": 1,
    "text": "کز ایدر گذشتن ترا روی نیست"
  },
  {
    "poem_id": 1806,
    "vorder": 45,
    "position": 0,
    "text": "ترا بر سپه کامگاری دهم"
  },
  {
    "poem_id": 1806,
    "vorder": 46,
    "position": 1,
    "text": "به هندوستان شهریاری دهم"
  },
  {
    "poem_id": 1806,
    "vorder": 47,
    "position": 0,
    "text": "فروماند بهرام و اندیشه کرد"
  },
  {
    "poem_id": 1806,
    "vorder": 48,
    "position": 1,
    "text": "ز تخت و نژاد و ز ننگ و نبرد"
  },
  {
    "poem_id": 1806,
    "vorder": 49,
    "position": 0,
    "text": "ابا خویشتن گفت کاین جنگ نیست"
  },
  {
    "poem_id": 1806,
    "vorder": 50,
    "position": 1,
    "text": "ز پیوند شنگل مرا ننگ نیست"
  },
  {
    "poem_id": 1806,
    "vorder": 51,
    "position": 0,
    "text": "و دیگر که جان بر سر آرم بدین"
  },
  {
    "poem_id": 1806,
    "vorder": 52,
    "position": 1,
    "text": "ببینم مگر خاک ایران زمین"
  },
  {
    "poem_id": 1806,
    "vorder": 53,
    "position": 0,
    "text": "که ایدر بدین‌سان بماندیم دیر"
  },
  {
    "poem_id": 1806,
    "vorder": 54,
    "position": 1,
    "text": "برآویخت با دام روباه شیر"
  },
  {
    "poem_id": 1806,
    "vorder": 55,
    "position": 0,
    "text": "چنین داد پاسخ که فرمان کنم"
  },
  {
    "poem_id": 1806,
    "vorder": 56,
    "position": 1,
    "text": "ز گفتارت آرایش جان کنم"
  },
  {
    "poem_id": 1806,
    "vorder": 57,
    "position": 0,
    "text": "تو از هر سه دختر یکی برگزین"
  },
  {
    "poem_id": 1806,
    "vorder": 58,
    "position": 1,
    "text": "که چون بینمش خوانمش آفرین"
  },
  {
    "poem_id": 1806,
    "vorder": 59,
    "position": 0,
    "text": "ز گفتار او شاد شد شاه هند"
  },
  {
    "poem_id": 1806,
    "vorder": 60,
    "position": 1,
    "text": "بیاراست ایوان به چینی پرند"
  },
  {
    "poem_id": 1806,
    "vorder": 61,
    "position": 0,
    "text": "سه دختر بیامد چو خرم بهار"
  },
  {
    "poem_id": 1806,
    "vorder": 62,
    "position": 1,
    "text": "به آرایش و بوی و رنگ و نگار"
  },
  {
    "poem_id": 1806,
    "vorder": 63,
    "position": 0,
    "text": "به بهرام گور آن زمان گفت رو"
  },
  {
    "poem_id": 1806,
    "vorder": 64,
    "position": 1,
    "text": "بیارای دل را به دیدار نو"
  },
  {
    "poem_id": 1806,
    "vorder": 65,
    "position": 0,
    "text": "بشد تیز بهرام و او را بدید"
  },
  {
    "poem_id": 1806,
    "vorder": 66,
    "position": 1,
    "text": "ازان ماه‌رویان یکی برگزید"
  },
  {
    "poem_id": 1806,
    "vorder": 67,
    "position": 0,
    "text": "چو خرم بهاری سپینود نام"
  },
  {
    "poem_id": 1806,
    "vorder": 68,
    "position": 1,
    "text": "همه شرم و ناز و همه رای و کام"
  },
  {
    "poem_id": 1806,
    "vorder": 69,
    "position": 0,
    "text": "بدو داد شنگل سپینود را"
  },
  {
    "poem_id": 1806,
    "vorder": 70,
    "position": 1,
    "text": "چو سرو سهی شمع بی‌دود را"
  },
  {
    "poem_id": 1806,
    "vorder": 71,
    "position": 0,
    "text": "یکی گنج پرمایه‌تر برگزید"
  },
  {
    "poem_id": 1806,
    "vorder": 72,
    "position": 1,
    "text": "بدان ماه‌رخ داد شنگل کلید"
  },
  {
    "poem_id": 1806,
    "vorder": 73,
    "position": 0,
    "text": "بیاورد یاران بهرام را"
  },
  {
    "poem_id": 1806,
    "vorder": 74,
    "position": 1,
    "text": "سواران بازیب و با نام را"
  },
  {
    "poem_id": 1806,
    "vorder": 75,
    "position": 0,
    "text": "درم داد ودینار و هرگونه چیز"
  },
  {
    "poem_id": 1806,
    "vorder": 76,
    "position": 1,
    "text": "همان عنبر و عود و کافورنیز"
  },
  {
    "poem_id": 1806,
    "vorder": 77,
    "position": 0,
    "text": "بیاراست ایوان گوهرنگار"
  },
  {
    "poem_id": 1806,
    "vorder": 78,
    "position": 1,
    "text": "ز قنوج هرکس که بد نامدار"
  },
  {
    "poem_id": 1806,
    "vorder": 79,
    "position": 0,
    "text": "خرامان بران بزمگاه آمدند"
  },
  {
    "poem_id": 1806,
    "vorder": 80,
    "position": 1,
    "text": "به شادی همه نزد شاه آمدند"
  },
  {
    "poem_id": 1806,
    "vorder": 81,
    "position": 0,
    "text": "ببودند یک هفته با می به دست"
  },
  {
    "poem_id": 1806,
    "vorder": 82,
    "position": 1,
    "text": "همه شاد و خرم به جای نشست"
  },
  {
    "poem_id": 1806,
    "vorder": 83,
    "position": 0,
    "text": "سپینود با شاه بهرام گور"
  },
  {
    "poem_id": 1806,
    "vorder": 84,
    "position": 1,
    "text": "چو می بود روشن به جام بلور"
  }
]