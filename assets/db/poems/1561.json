    "text": "بر آن خارستان پاک جایی بجست"
  },
  {
    "poem_id": 1561,
    "vorder": 133,
    "position": 0,
    "text": "پر آژنگ رخ سوی خورشید کرد"
  },
  {
    "poem_id": 1561,
    "vorder": 134,
    "position": 1,
    "text": "دلی پر ز درد و سری پر ز گرد"
