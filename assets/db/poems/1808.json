[
  {
    "poem_id": 1808,
    "vorder": 1,
    "position": 0,
    "text": "چو بهرام با دخت شنگل بساخت"
  },
  {
    "poem_id": 1808,
    "vorder": 2,
    "position": 1,
    "text": "زن او همی شاه گیتی شناخت"
  },
  {
    "poem_id": 1808,
    "vorder": 3,
    "position": 0,
    "text": "شب و روز گریان بد از مهر اوی"
  },
  {
    "poem_id": 1808,
    "vorder": 4,
    "position": 1,
    "text": "نهاده دو چشم اندران چهر اوی"
  },
  {
    "poem_id": 1808,
    "vorder": 5,
    "position": 0,
    "text": "چو از مهرشان شنگل آگاه شد"
  },
  {
    "poem_id": 1808,
    "vorder": 6,
    "position": 1,
    "text": "ز بدها گمانیش کوتاه شد"
  },
  {
    "poem_id": 1808,
    "vorder": 7,
    "position": 0,
    "text": "نشستند یک روز شادان بهم"
  },
  {
    "poem_id": 1808,
    "vorder": 8,
    "position": 1,
    "text": "همی رفت هرگونه از بیش و کم"
  },
  {
    "poem_id": 1808,
    "vorder": 9,
    "position": 0,
    "text": "سپینود را گفت بهرامشاه"
  },
  {
    "poem_id": 1808,
    "vorder": 10,
    "position": 1,
    "text": "که دانم که هستی مرا نیک‌خواه"
  },
  {
    "poem_id": 1808,
    "vorder": 11,
    "position": 0,
    "text": "یکی راز خواهم همی با تو گفت"
  },
  {
    "poem_id": 1808,
    "vorder": 12,
    "position": 1,
    "text": "چنان کن که ماند سخن در نهفت"
  },
  {
    "poem_id": 1808,
    "vorder": 13,
    "position": 0,
    "text": "همی رفت خواهم ز هندوستان"
  },
  {
    "poem_id": 1808,
    "vorder": 14,
    "position": 1,
    "text": "تو باشی بدین کار همداستان"
  },
  {
    "poem_id": 1808,
    "vorder": 15,
    "position": 0,
    "text": "به تنها بگویم ترا یک سخن"
  },
  {
    "poem_id": 1808,
    "vorder": 16,
    "position": 1,
    "text": "نباید که داند کس از انجمن"
  },
  {
    "poem_id": 1808,
    "vorder": 17,
    "position": 0,
    "text": "به ایران مرا کار زین بهترست"
  },
  {
    "poem_id": 1808,
    "vorder": 18,
    "position": 1,
    "text": "همم کردگار جهان یاورست"
  },
  {
    "poem_id": 1808,
    "vorder": 19,
    "position": 0,
    "text": "به رفتن گر ایدونک رای آیدت"
  },
  {
    "poem_id": 1808,
    "vorder": 20,
    "position": 1,
    "text": "به خوبی خرد رهنمای آیدت"
  },
  {
    "poem_id": 1808,
    "vorder": 21,
    "position": 0,
    "text": "به هر جای نام تو بانو بود"
  },
  {
    "poem_id": 1808,
    "vorder": 22,
    "position": 1,
    "text": "پدر پیش تختت به زانو بود"
  },
  {
    "poem_id": 1808,
    "vorder": 23,
    "position": 0,
    "text": "سپینود گفت ای سرافراز مرد"
  },
  {
    "poem_id": 1808,
    "vorder": 24,
    "position": 1,
    "text": "تو بر خیره از راه دانش مگرد"
  },
  {
    "poem_id": 1808,
    "vorder": 25,
    "position": 0,
    "text": "بهین زنان جهان آن بود"
  },
  {
    "poem_id": 1808,
    "vorder": 26,
    "position": 1,
    "text": "کزو شوی همواره خندان بود"
  },
  {
    "poem_id": 1808,
    "vorder": 27,
    "position": 0,
    "text": "اگر پاک جانم ز پیمان تو"
  },
  {
    "poem_id": 1808,
    "vorder": 28,
    "position": 1,
    "text": "بپیچد به بیزارم از جان تو"
  },
  {
    "poem_id": 1808,
    "vorder": 29,
    "position": 0,
    "text": "بدو گفت بهرام پس چاره کن"
  },
  {
    "poem_id": 1808,
    "vorder": 30,
    "position": 1,
    "text": "وزین راز مگشای بر کس سخن"
  },
  {
    "poem_id": 1808,
    "vorder": 31,
    "position": 0,
    "text": "سپینود گفت ای سزاوار تخت"
  },
  {
    "poem_id": 1808,
    "vorder": 32,
    "position": 1,
    "text": "بسازم اگر باشدم یار بخت"
  },
  {
    "poem_id": 1808,
    "vorder": 33,
    "position": 0,
    "text": "یکی جشنگاهست ز ایدر نه دور"
  },
  {
    "poem_id": 1808,
    "vorder": 34,
    "position": 1,
    "text": "که سازد پدرم اندران بیشه سور"
  },
  {
    "poem_id": 1808,
    "vorder": 35,
    "position": 0,
    "text": "که دارند فرخ مران جای را"
  },
  {
    "poem_id": 1808,
    "vorder": 36,
    "position": 1,
    "text": "ستایند جای بت‌آرای را"
  },
  {
    "poem_id": 1808,
    "vorder": 37,
    "position": 0,
    "text": "بود تا بران بیشه فرسنگ بیست"
  },
  {
    "poem_id": 1808,
    "vorder": 38,
    "position": 1,
    "text": "که پیش بت اندر بباید گریست"
  },
  {
    "poem_id": 1808,
    "vorder": 39,
    "position": 0,
    "text": "بدان جای نخچیر گوران بود"
  },
  {
    "poem_id": 1808,
    "vorder": 40,
    "position": 1,
    "text": "به قنوج در عود سوزان بود"
  },
  {
    "poem_id": 1808,
    "vorder": 41,
    "position": 0,
    "text": "شود شاه و لشکر بدان جایگاه"
  },
  {
    "poem_id": 1808,
    "vorder": 42,
    "position": 1,
    "text": "که بی‌ره نماید بران بیشه راه"
  },
  {
    "poem_id": 1808,
    "vorder": 43,
    "position": 0,
    "text": "اگر رفت خواهی بدانجای رو"
  },
  {
    "poem_id": 1808,
    "vorder": 44,
    "position": 1,
    "text": "همیشه کهن باش و سال تو نو"
  },
  {
    "poem_id": 1808,
    "vorder": 45,
    "position": 0,
    "text": "ز امروز بشکیب تا نیم روز"
  },
  {
    "poem_id": 1808,
    "vorder": 46,
    "position": 1,
    "text": "چو پیدا شود تاج گیتی فروز"
  },
  {
    "poem_id": 1808,
    "vorder": 47,
    "position": 0,
    "text": "چو از شهر بیرون رود شهریار"
  },
  {
    "poem_id": 1808,
    "vorder": 48,
    "position": 1,
    "text": "به رفتن بیارای و بر ساز کار"
  },
  {
    "poem_id": 1808,
    "vorder": 49,
    "position": 0,
    "text": "ز گفتار او گشت بهرام شاد"
  },
  {
    "poem_id": 1808,
    "vorder": 50,
    "position": 1,
    "text": "نخفت اندر اندیشه تا بامداد"
  },
  {
    "poem_id": 1808,
    "vorder": 51,
    "position": 0,
    "text": "چو بنمود خورشید بر چرخ دست"
  },
  {
    "poem_id": 1808,
    "vorder": 52,
    "position": 1,
    "text": "شب تیره بار غریبان ببست"
  },
  {
    "poem_id": 1808,
    "vorder": 53,
    "position": 0,
    "text": "نشست از بر باره بهرام گور"
  },
  {
    "poem_id": 1808,
    "vorder": 54,
    "position": 1,
    "text": "همی راند با ساز نخچیر گور"
  },
  {
    "poem_id": 1808,
    "vorder": 55,
    "position": 0,
    "text": "به زن گفت بر ساز و با کس مگوی"
  },
  {
    "poem_id": 1808,
    "vorder": 56,
    "position": 1,
    "text": "نهادیم هر دو سوی راه روی"
  },
  {
    "poem_id": 1808,
    "vorder": 57,
    "position": 0,
    "text": "هرانکس که بودند ایرانیان"
  },
  {
    "poem_id": 1808,
    "vorder": 58,
    "position": 1,
    "text": "به رفتن ببستند با او میان"
  },
  {
    "poem_id": 1808,
    "vorder": 59,
    "position": 0,
    "text": "بیامد چو نزدیک دریا رسید"
  },
  {
    "poem_id": 1808,
    "vorder": 60,
    "position": 1,
    "text": "به ره بار بازارگانان بدید"
  },
  {
    "poem_id": 1808,
    "vorder": 61,
    "position": 0,
    "text": "که بازارگانان ایران بدند"
  },
  {
    "poem_id": 1808,
    "vorder": 62,
    "position": 1,
    "text": "به آب و به خشکی دلیران بدند"
  },
  {
    "poem_id": 1808,
    "vorder": 63,
    "position": 0,
    "text": "چو بازارگان روی بهرام دید"
  },
  {
    "poem_id": 1808,
    "vorder": 64,
    "position": 1,
    "text": "شهنشاه لب را به دندان گزید"
  },
  {
    "poem_id": 1808,
    "vorder": 65,
    "position": 0,
    "text": "نفرمود بردن به پیشش نماز"
  },
  {
    "poem_id": 1808,
    "vorder": 66,
    "position": 1,
    "text": "ز نادان سخن را همی داشت راز"
  },
  {
    "poem_id": 1808,
    "vorder": 67,
    "position": 0,
    "text": "به بازارگان گفت لب را ببند"
  },
  {
    "poem_id": 1808,
    "vorder": 68,
    "position": 1,
    "text": "کزین سودمندی و هم با گزند"
  },
  {
    "poem_id": 1808,
    "vorder": 69,
    "position": 0,
    "text": "گرین راز در هند پیدا شود"
  },
  {
    "poem_id": 1808,
    "vorder": 70,
    "position": 1,
    "text": "ز خون خاک ایران چو دریا شود"
  },
  {
    "poem_id": 1808,
    "vorder": 71,
    "position": 0,
    "text": "گشاده بران کار کو لب ببست"
  },
  {
    "poem_id": 1808,
    "vorder": 72,
    "position": 1,
    "text": "زبان بسته باید گشاده دو دست"
  },
  {
    "poem_id": 1808,
    "vorder": 73,
    "position": 0,
    "text": "زبان شما را به سوگند سخت"
  },
  {
    "poem_id": 1808,
    "vorder": 74,
    "position": 1,
    "text": "ببندیم تا بازیابیم بخت"
  },
  {
    "poem_id": 1808,
    "vorder": 75,
    "position": 0,
    "text": "بگویید کز پاک یزدان خدای"
  },
  {
    "poem_id": 1808,
    "vorder": 76,
    "position": 1,
    "text": "بریدیم و بستیم با دیو رای"
  },
  {
    "poem_id": 1808,
    "vorder": 77,
    "position": 0,
    "text": "اگر هرگز از رای بهرامشاه"
  },
  {
    "poem_id": 1808,
    "vorder": 78,
    "position": 1,
    "text": "بپیچیم و داریم بد را نگاه"
  },
  {
    "poem_id": 1808,
    "vorder": 79,
    "position": 0,
    "text": "چو سوگند شد خورده و ساخته"
  },
  {
    "poem_id": 1808,
    "vorder": 80,
    "position": 1,
    "text": "دل شاه زان رنج پرداخته"
  },
  {
    "poem_id": 1808,
    "vorder": 81,
    "position": 0,
    "text": "بدیشان چنین گفت پس شهریار"
  },
  {
    "poem_id": 1808,
    "vorder": 82,
    "position": 1,
    "text": "که نزد شما از من این زنهار"
  },
  {
    "poem_id": 1808,
    "vorder": 83,
    "position": 0,
    "text": "بدارید و با جان برابر کنید"
  },
  {
    "poem_id": 1808,
    "vorder": 84,
    "position": 1,
    "text": "چو خواهید کز پندم افسر کنید"
  },
  {
    "poem_id": 1808,
    "vorder": 85,
    "position": 0,
    "text": "گر از من شود تخت پرداخته"
  },
  {
    "poem_id": 1808,
    "vorder": 86,
    "position": 1,
    "text": "سپاه آید از هر سوی ساخته"
  },
  {
    "poem_id": 1808,
    "vorder": 87,
    "position": 0,
    "text": "نه بازارگان ماند ایدر نه شاه"
  },
  {
    "poem_id": 1808,
    "vorder": 88,
    "position": 1,
    "text": "نه دهقان نه لشکر نه تخت و کلاه"
  },
  {
    "poem_id": 1808,
    "vorder": 89,
    "position": 0,
    "text": "چو زان‌گونه دیدند گفتار اوی"
  },
  {
    "poem_id": 1808,
    "vorder": 90,
    "position": 1,
    "text": "برفتند یکسر پر از آب روی"
  },
  {
    "poem_id": 1808,
    "vorder": 91,
    "position": 0,
    "text": "که جان بزرگان فدای تو باد"
  },
  {
    "poem_id": 1808,
    "vorder": 92,
    "position": 1,
    "text": "جوانی و شاهی روای تو باد"
  },
  {
    "poem_id": 1808,
    "vorder": 93,
    "position": 0,
    "text": "اگر هیچ راز تو پیدا شود"
  },
  {
    "poem_id": 1808,
    "vorder": 94,
    "position": 1,
    "text": "ز خون کشور ما چو دریا شود"
  },
  {
    "poem_id": 1808,
    "vorder": 95,
    "position": 0,
    "text": "که یارد بدین گونه اندیشه کرد"
  },
  {
    "poem_id": 1808,
    "vorder": 96,
    "position": 1,
    "text": "مگر بخت را گوید از ره بگرد"
  },
  {
    "poem_id": 1808,
    "vorder": 97,
    "position": 0,
    "text": "چو بشنید شاه آن گرفت آفرین"
  },
  {
    "poem_id": 1808,
    "vorder": 98,
    "position": 1,
    "text": "بران نامداران با فر و دین"
  },
  {
    "poem_id": 1808,
    "vorder": 99,
    "position": 0,
    "text": "همی رفت پیچان به ایوان خویش"
  },
  {
    "poem_id": 1808,
    "vorder": 100,
    "position": 1,
    "text": "به یزدان سپرده تن و جان خویش"
  },
  {
    "poem_id": 1808,
    "vorder": 101,
    "position": 0,
    "text": "بدانگه که بهرام شد سوی راه"
  },
  {
    "poem_id": 1808,
    "vorder": 102,
    "position": 1,
    "text": "چنین گفت با زن که ای نیک‌خواه"
  },
  {
    "poem_id": 1808,
    "vorder": 103,
    "position": 0,
    "text": "ابا مادر خویشتن چاره ساز"
  },
  {
    "poem_id": 1808,
    "vorder": 104,
    "position": 1,
    "text": "چنان کو درستی نداندت راز"
  },
  {
    "poem_id": 1808,
    "vorder": 105,
    "position": 0,
    "text": "که چون شاه شنگل سوی جشنگاه"
  },
  {
    "poem_id": 1808,
    "vorder": 106,
    "position": 1,
    "text": "شود خواستار آید از نزد شاه"
  },
  {
    "poem_id": 1808,
    "vorder": 107,
    "position": 0,
    "text": "بگوید که برزوی شد دردمند"
  },
  {
    "poem_id": 1808,
    "vorder": 108,
    "position": 1,
    "text": "پذیردش پوزش شه هوشمند"
  },
  {
    "poem_id": 1808,
    "vorder": 109,
    "position": 0,
    "text": "زن این بند بنهاد با مادرش"
  },
  {
    "poem_id": 1808,
    "vorder": 110,
    "position": 1,
    "text": "چو بشنید پس مادر از دخترش"
  },
  {
    "poem_id": 1808,
    "vorder": 111,
    "position": 0,
    "text": "همی بود تا تازه شد جشنگاه"
  },
  {
    "poem_id": 1808,
    "vorder": 112,
    "position": 1,
    "text": "گرانمایگان برگرفتند راه"
  },
  {
    "poem_id": 1808,
    "vorder": 113,
    "position": 0,
    "text": "چو برساخت شنگل که آید به دشت"
  },
  {
    "poem_id": 1808,
    "vorder": 114,
    "position": 1,
    "text": "زنش گفت برزوی بیمار گشت"
  },
  {
    "poem_id": 1808,
    "vorder": 115,
    "position": 0,
    "text": "به پوزش همی گوید ای شهریار"
  },
  {
    "poem_id": 1808,
    "vorder": 116,
    "position": 1,
    "text": "تو دل را بمن هیچ رنجه مدار"
  },
  {
    "poem_id": 1808,
    "vorder": 117,
    "position": 0,
    "text": "چو ناتندرستی بود جشنگاه"
  },
  {
    "poem_id": 1808,
    "vorder": 118,
    "position": 1,
    "text": "دژم باشد و داند این مایه شاه"
  },
  {
    "poem_id": 1808,
    "vorder": 119,
    "position": 0,
    "text": "به زن گفت شنگل که این خود مباد"
  },
  {
    "poem_id": 1808,
    "vorder": 120,
    "position": 1,
    "text": "که بیمار باشد کند جشن یاد"
  },
  {
    "poem_id": 1808,
    "vorder": 121,
    "position": 0,
    "text": "ز قنوج شبگیر شنگل برفت"
  },
  {
    "poem_id": 1808,
    "vorder": 122,
    "position": 1,
    "text": "ابا هندوان روی بنهاد تفت"
  },
  {
    "poem_id": 1808,
    "vorder": 123,
    "position": 0,
    "text": "چو شب تیره شد شاه بهرام گفت"
  },
  {
    "poem_id": 1808,
    "vorder": 124,
    "position": 1,
    "text": "که آمد گه رفتن ای نیک جفت"
  },
  {
    "poem_id": 1808,
    "vorder": 125,
    "position": 0,
    "text": "بیامد سپینود را برنشاند"
  },
  {
    "poem_id": 1808,
    "vorder": 126,
    "position": 1,
    "text": "همی پهلوی نام یزدان بخواند"
  },
  {
    "poem_id": 1808,
    "vorder": 127,
    "position": 0,
    "text": "بپوشید خفتان و خود برنشست"
  },
  {
    "poem_id": 1808,
    "vorder": 128,
