[
  {
    "poem_id": 1848,
    "vorder": 1,
    "position": 0,
    "text": "چو خورشید خنجر کشید از نیام"
  },
  {
    "poem_id": 1848,
    "vorder": 2,
    "position": 1,
    "text": "پدید آمد آن مطرف زردفام"
  },
  {
    "poem_id": 1848,
    "vorder": 3,
    "position": 0,
    "text": "فرستاد و گردنکشان را بخواند"
  },
  {
    "poem_id": 1848,
    "vorder": 4,
    "position": 1,
    "text": "برتخت شاهی به زانو نشاند"
  },
  {
    "poem_id": 1848,
    "vorder": 5,
    "position": 0,
    "text": "بهرجای کرسی زرین نهاد"
  },
  {
    "poem_id": 1848,
    "vorder": 6,
    "position": 1,
    "text": "چوشاهان پیروز بنشست شاد"
  },
  {
    "poem_id": 1848,
    "vorder": 7,
    "position": 0,
    "text": "چنین گفت زان پس به بانگ بلند"
  },
  {
    "poem_id": 1848,
    "vorder": 8,
    "position": 1,
    "text": "که هرکس که هست ازشما ارجمند"
  },
  {
    "poem_id": 1848,
    "vorder": 9,
    "position": 0,
    "text": "ز شاهان ز ضحاک بتر کسی"
  },
  {
    "poem_id": 1848,
    "vorder": 10,
    "position": 1,
    "text": "نیامد پدیدار بجویی بسی"
  },
  {
    "poem_id": 1848,
    "vorder": 11,
    "position": 0,
    "text": "که از بهر شاهی پدر را بکشت"
  },
  {
    "poem_id": 1848,
    "vorder": 12,
    "position": 1,
    "text": "وزان کشتن ایرانش آمد بمشت"
  },
  {
    "poem_id": 1848,
    "vorder": 13,
    "position": 0,
    "text": "دگر خسرو آن مرد بیداد و شوم"
  },
  {
    "poem_id": 1848,
    "vorder": 14,
    "position": 1,
    "text": "پدر را بکشت آنگهی شد بروم"
  },
  {
    "poem_id": 1848,
    "vorder": 15,
    "position": 0,
    "text": "کنون ناپدیدست اندر جهان"
  },
  {
    "poem_id": 1848,
    "vorder": 16,
    "position": 1,
    "text": "یکی نامداری ز تخت مهان"
  },
  {
    "poem_id": 1848,
    "vorder": 17,
    "position": 0,
    "text": "که زیبا بود بخشش و بخت را"
  },
  {
    "poem_id": 1848,
    "vorder": 18,
    "position": 1,
    "text": "کلاه و کمر بستن وتخت را"
  },
  {
    "poem_id": 1848,
    "vorder": 19,
    "position": 0,
    "text": "که دارید که اکنون ببندد میان"
  },
  {
    "poem_id": 1848,
    "vorder": 20,
    "position": 1,
    "text": "بجا آورد رسم و راه کیان"
  },
  {
    "poem_id": 1848,
    "vorder": 21,
    "position": 0,
    "text": "بدارندهٔ آفتاب بلند"
  },
  {
    "poem_id": 1848,
    "vorder": 22,
    "position": 1,
    "text": "که باشم شما را بدین یارمند"
  },
  {
    "poem_id": 1848,
    "vorder": 23,
    "position": 0,
    "text": "شنیدند گردنکشان این سخن"
  },
  {
    "poem_id": 1848,
    "vorder": 24,
    "position": 1,
    "text": "که آن نامور مهتر افکند بن"
  },
  {
    "poem_id": 1848,
    "vorder": 25,
    "position": 0,
    "text": "نپیچید کس دل ز گفتار راست"
  },
  {
    "poem_id": 1848,
    "vorder": 26,
    "position": 1,
    "text": "یکی پیرتر بود بر پای خاست"
  },
  {
    "poem_id": 1848,
    "vorder": 27,
    "position": 0,
    "text": "کجا نام او بود شهران گراز"
  },
  {
    "poem_id": 1848,
    "vorder": 28,
    "position": 1,
    "text": "گوی پیرسر مهتری دیریاز"
  },
  {
    "poem_id": 1848,
    "vorder": 29,
    "position": 0,
    "text": "چنین گفت کای نامدار بلند"
  },
  {
    "poem_id": 1848,
    "vorder": 30,
    "position": 1,
    "text": "توی در جهان تابوی سودمند"
  },
  {
    "poem_id": 1848,
    "vorder": 31,
    "position": 0,
    "text": "بدی گر نبودی جز از ساوه شاه"
  },
  {
    "poem_id": 1848,
    "vorder": 32,
    "position": 1,
    "text": "که آمد بدین مرز ما با سپاه"
  },
  {
    "poem_id": 1848,
    "vorder": 33,
    "position": 0,
    "text": "ز آزادگان بندگان خواست کرد"
  },
  {
    "poem_id": 1848,
    "vorder": 34,
    "position": 1,
    "text": "کجا در جهانش نبد هم نبرد"
  },
  {
    "poem_id": 1848,
    "vorder": 35,
    "position": 0,
    "text": "ز گیتی بمردی تو بستی میان"
  },
  {
    "poem_id": 1848,
    "vorder": 36,
    "position": 1,
    "text": "که آن رنج بگذشت ز ایرانیان"
  },
  {
    "poem_id": 1848,
    "vorder": 37,
    "position": 0,
    "text": "سپه چاربار از یلان صدهزار"
  },
  {
    "poem_id": 1848,
    "vorder": 38,
    "position": 1,
    "text": "همه گرد و شایستهٔ کارزار"
  },
  {
    "poem_id": 1848,
    "vorder": 39,
    "position": 0,
    "text": "بیک چوبه تیر تو گشتند باز"
  },
  {
    "poem_id": 1848,
    "vorder": 40,
    "position": 1,
    "text": "برآسود ایران ز گرم و گداز"
  },
  {
    "poem_id": 1848,
    "vorder": 41,
    "position": 0,
    "text": "کنون تخت ایران سزاوار تست"
  },
  {
    "poem_id": 1848,
    "vorder": 42,
    "position": 1,
    "text": "برین برگوا بخت بیدارتست"
  },
  {
    "poem_id": 1848,
    "vorder": 43,
    "position": 0,
    "text": "کسی کو بپیچد ز فرمان ما"
  },
  {
    "poem_id": 1848,
    "vorder": 44,
    "position": 1,
    "text": "وگر دور ماند ز پیمان ما"
  },
  {
    "poem_id": 1848,
    "vorder": 45,
    "position": 0,
    "text": "بفرمانش آریم اگر چه گوست"
  },
  {
    "poem_id": 1848,
    "vorder": 46,
    "position": 1,
    "text": "و گر داستان را همه خسروست"
  },
  {
    "poem_id": 1848,
    "vorder": 47,
    "position": 0,
    "text": "بگفت این و بنشست بر جای خویش"
  },
  {
    "poem_id": 1848,
    "vorder": 48,
    "position": 1,
    "text": "خراسان سپهبد بیامد به پیش"
  },
  {
    "poem_id": 1848,
    "vorder": 49,
    "position": 0,
    "text": "چنین گفت کاین پیر دانش پژوه"
  },
  {
    "poem_id": 1848,
    "vorder": 50,
    "position": 1,
    "text": "که چندین سخن گفت پیش گروه"
  },
  {
    "poem_id": 1848,
    "vorder": 51,
    "position": 0,
    "text": "بگویم که او از چه گفت این سخن"
  },
  {
    "poem_id": 1848,
    "vorder": 52,
    "position": 1,
    "text": "جهانجوی و داننده مرد کهن"
  },
  {
    "poem_id": 1848,
    "vorder": 53,
    "position": 0,
    "text": "که این نیکویها ز تو یاد کرد"
  },
  {
    "poem_id": 1848,
    "vorder": 54,
    "position": 1,
    "text": "دل انجمن زین سخن شاد کرد"
  },
  {
    "poem_id": 1848,
    "vorder": 55,
    "position": 0,
    "text": "ولیکن یکی داستانست نغز"
  },
  {
    "poem_id": 1848,
    "vorder": 56,
    "position": 1,
    "text": "اگر بشنود مردم پاک مغز"
  },
  {
    "poem_id": 1848,
    "vorder": 57,
    "position": 0,
    "text": "که زر دشت گوید باستا و زند"
  },
  {
    "poem_id": 1848,
    "vorder": 58,
    "position": 1,
    "text": "که هرکس که از کردگاربلند"
  },
  {
    "poem_id": 1848,
    "vorder": 59,
    "position": 0,
    "text": "بپیچد بیک سال پندش دهید"
  },
  {
    "poem_id": 1848,
    "vorder": 60,
    "position": 1,
    "text": "همان مایهٔ سودمندش دهید"
  },
  {
    "poem_id": 1848,
    "vorder": 61,
    "position": 0,
    "text": "سرسال اگر بازناید به راه"
  },
  {
    "poem_id": 1848,
    "vorder": 62,
    "position": 1,
    "text": "ببایدش کشتن بفرمان شاه"
  },
  {
    "poem_id": 1848,
    "vorder": 63,
    "position": 0,
    "text": "چو بر دادگر شاه دشمن شود"
  },
  {
    "poem_id": 1848,
    "vorder": 64,
    "position": 1,
    "text": "سرش زود باید که بی‌تن شود"
  },
  {
    "poem_id": 1848,
    "vorder": 65,
    "position": 0,
    "text": "خراسان بگفت این و لب راببست"
  },
  {
    "poem_id": 1848,
    "vorder": 66,
    "position": 1,
    "text": "بیامد بجایی که بودش نشست"
  },
  {
    "poem_id": 1848,
    "vorder": 67,
    "position": 0,
    "text": "ازان پس فرخ زاد برپای خاست"
  },
  {
    "poem_id": 1848,
    "vorder": 68,
    "position": 1,
    "text": "ازان انجمن سر برآورد راست"
  },
  {
    "poem_id": 1848,
    "vorder": 69,
    "position": 0,
    "text": "چنین گفت کای مهتر سودمند"
  },
  {
    "poem_id": 1848,
    "vorder": 70,
    "position": 1,
    "text": "سخن گفتن داد به گر پسند"
  },
  {
    "poem_id": 1848,
    "vorder": 71,
    "position": 0,
    "text": "اگر داد بهتر بود کس مباد"
  },
  {
    "poem_id": 1848,
    "vorder": 72,
    "position": 1,
    "text": "که باشد به گفتار بی‌داد شاد"
  },
  {
    "poem_id": 1848,
    "vorder": 73,
    "position": 0,
    "text": "ببهرام گوید که نوشه بدی"
  },
  {
    "poem_id": 1848,
    "vorder": 74,
    "position": 1,
    "text": "جهان را بدیدار توشه بدی"
  },
  {
    "poem_id": 1848,
    "vorder": 75,
    "position": 0,
    "text": "اگر ناپسندست گفتار ما"
  },
  {
    "poem_id": 1848,
    "vorder": 76,
    "position": 1,
    "text": "بدین نیست پیروزگر یارما"
  },
  {
    "poem_id": 1848,
    "vorder": 77,
    "position": 0,
    "text": "انوشه بدی شاد تاجاودان"
  },
  {
    "poem_id": 1848,
    "vorder": 78,
    "position": 1,
    "text": "زتو دور دست و زبان بدان"
  },
  {
    "poem_id": 1848,
    "vorder": 79,
    "position": 0,
    "text": "بگفت این و بنشست مرد دلیر"
  },
  {
    "poem_id": 1848,
    "vorder": 80,
    "position": 1,
    "text": "خزروان خسرو بیامد چو شیر"
  },
  {
    "poem_id": 1848,
    "vorder": 81,
    "position": 0,
    "text": "بدو گفت اکنون که چندین سخن"
  },
  {
    "poem_id": 1848,
    "vorder": 82,
    "position": 1,
    "text": "سراینده برنا و مرد کهن"
  },
  {
    "poem_id": 1848,
    "vorder": 83,
    "position": 0,
    "text": "سرانجام اگر راه جویی بداد"
  },
  {
    "poem_id": 1848,
    "vorder": 84,
    "position": 1,
    "text": "هیونی برافگن بکردار باد"
  },
  {
    "poem_id": 1848,
    "vorder": 85,
    "position": 0,
    "text": "ممان دیر تا خسرو سرفراز"
  },
  {
    "poem_id": 1848,
    "vorder": 86,
    "position": 1,
    "text": "بکوبد بنزد تو راه دراز"
  },
  {
    "poem_id": 1848,
    "vorder": 87,
    "position": 0,
    "text": "ز کار گذشته به پوزش گرای"
  },
  {
    "poem_id": 1848,
    "vorder": 88,
    "position": 1,
    "text": "سوی تخت گستاخ مگذار پای"
  },
  {
    "poem_id": 1848,
    "vorder": 89,
    "position": 0,
    "text": "که تا زنده باشد جهاندار شاه"
  },
  {
    "poem_id": 1848,
    "vorder": 90,
    "position": 1,
    "text": "نباشد سپهبد سزاوار گاه"
  },
  {
    "poem_id": 1848,
    "vorder": 91,
    "position": 0,
    "text": "وگر بیم داری ز خسرو به دل"
  },
  {
    "poem_id": 1848,
    "vorder": 92,
    "position": 1,
    "text": "پی از پارس وز طیسفون برگسل"
  },
  {
    "poem_id": 1848,
    "vorder": 93,
    "position": 0,
    "text": "بشهر خراسان تن آسان بزی"
  },
  {
    "poem_id": 1848,
    "vorder": 94,
    "position": 1,
    "text": "که آسانی و مهتری را سزی"
  },
  {
    "poem_id": 1848,
    "vorder": 95,
    "position": 0,
    "text": "به پوزش یک اندر دگر نامه ساز"
  },
  {
    "poem_id": 1848,
    "vorder": 96,
    "position": 1,
    "text": "مگر خسرو آید برای تو باز"
  },
  {
    "poem_id": 1848,
    "vorder": 97,
    "position": 0,
    "text": "نه برداشت خسرو پی از جای خویش"
  },
  {
    "poem_id": 1848,
    "vorder": 98,
    "position": 1,
    "text": "کجا زاد فرخ نهد پای پیش"
  },
  {
    "poem_id": 1848,
    "vorder": 99,
    "position": 0,
    "text": "سخن گفت پس زاد فرخ بداد"
  },
  {
    "poem_id": 1848,
    "vorder": 100,
    "position": 1,
    "text": "که‌ای نامداران فرخ نژاد"
  },
  {
    "poem_id": 1848,
    "vorder": 101,
    "position": 0,
    "text": "شنیدم سخن گفتن مهتران"
  },
  {
    "poem_id": 1848,
    "vorder": 102,
    "position": 1,
    "text": "که هستند ز ایران گزیده سران"
  },
  {
    "poem_id": 1848,
    "vorder": 103,
    "position": 0,
    "text": "نخستین سخن گفتن بنده وار"
  },
  {
    "poem_id": 1848,
    "vorder": 104,
    "position": 1,
    "text": "که تا پهلوانی شود شهریار"
  },
  {
    "poem_id": 1848,
    "vorder": 105,
    "position": 0,
    "text": "خردمند نپسندد این گفت وگوی"
  },
  {
    "poem_id": 1848,
    "vorder": 106,
    "position": 1,
    "text": "کزان کم شود مرد راآب روی"
  },
  {
    "poem_id": 1848,
    "vorder": 107,
    "position": 0,
    "text": "خراسان سخن برمنش وار گفت"
  },
  {
    "poem_id": 1848,
    "vorder": 108,
    "position": 1,
    "text": "نگویم که آن با خرد بود جفت"
  },
  {
    "poem_id": 1848,
    "vorder": 109,
    "position": 0,
    "text": "فرخ زاد بفزود گفتار تند"
  },
  {
    "poem_id": 1848,
    "vorder": 110,
    "position": 1,
    "text": "دل مردم پرخرد کرد کند"
  },
  {
    "poem_id": 1848,
    "vorder": 111,
    "position": 0,
    "text": "چهارم خزروان سالاربود"
  },
  {
    "poem_id": 1848,
    "vorder": 112,
    "position": 1,
    "text": "که گفتار او با خرد یاربود"
  },
  {
    "poem_id": 1848,
    "vorder": 113,
    "position": 0,
    "text": "که تا آفرید این جهان کردگار"
  },
  {
    "poem_id": 1848,
    "vorder": 114,
    "position": 1,
    "text": "پدید آمد این گردش روزگار"
  },
  {
    "poem_id": 1848,
    "vorder": 115,
    "position": 0,
    "text": "ز ضحاک تازی نخست اندرآی"
  },
  {
    "poem_id": 1848,
    "vorder": 116,
    "position": 1,
    "text": "که بیدادگر بود و ناپاک رای"
  },
  {
    "poem_id": 1848,
    "vorder": 117,
    "position": 0,
    "text": "که جمشید برتر منش را بکشت"
  },
  {
    "poem_id": 1848,
    "vorder": 118,
    "position": 1,
    "text": "به بیداد بگرفت گیتی بمشت"
  },
  {
    "poem_id": 1848,
    "vorder": 119,
    "position": 0,
    "text": "پر از درد دیدم دل پارسا"
  },
  {
    "poem_id": 1848,
    "vorder": 120,
    "position": 1,
    "text": "که اندر جهان دیو بد پادشا"
  },
  {
    "poem_id": 1848,
    "vorder": 121,
    "position": 0,
    "text": "دگر آنک بد گوهر افراسیاب"
  },
  {
    "poem_id": 1848,
    "vorder": 122,
    "position": 1,
    "text": "ز توران بدانگونه بگذاشت آب"
  },
  {
    "poem_id": 1848,
    "vorder": 123,
    "position": 0,
    "text": "بزاری سر نوذر نامدار"
  },
  {
    "poem_id": 1848,
    "vorder": 124,
    "position": 1,
    "text": "بشمشیر ببرید و برگشت کار"
  },
  {
    "poem_id": 1848,
    "vorder": 125,
    "position": 0,
    "text": "سدیگر سکندر که آمد ز روم"
  },
  {
    "poem_id": 1848,
    "vorder": 126,
    "position": 1,
    "text": "به ایران و ویران شد این مرز وبوم"
  },
  {
    "poem_id": 1848,
    "vorder": 127,
    "position": 0,
    "text": "چو دارای شمشیر زن را بکشت"
  },
  {
    "poem_id": 1848,
    "vorder": 128,
    "position": 1,
    "text": "خور و خواب ایرانیان شد درشت"
  },
  {
    "poem_id": 1848,
    "vorder": 129,
    "position": 0,
    "text": "چهارم چو ناپاک دل خوشنواز"
  },
  {
    "poem_id": 1848,
    "vorder": 130,
    "position": 1,
    "text": "که گم کرد زین بوم و بر نام و ناز"
  },
  {
    "poem_id": 1848,
    "vorder": 131,
    "position": 0,
    "text": "چو پیروز شاهی بلند اختری"
  },
  {
    "poem_id": 1848,
    "vorder": 132,
    "position": 1,
    "text": "جهاندار وز نامداران سری"
  },
  {
    "poem_id": 1848,
    "vorder": 133,
    "position": 0,
    "text": "بکشتند هیتالیان ناگهان"
  },
  {
    "poem_id": 1848,
    "vorder": 134,
    "position": 1,
    "text": "نگون شد سرتخت شاه جهان"
  },
  {
    "poem_id": 1848,
    "vorder": 135,
    "position": 0,
    "text": "کس اندر جهان این شگفتی ندید"
  },
  {
    "poem_id": 1848,
    "vorder": 136,
    "position": 1,
    "text": "که اکنون بنوی به ایران رسید"
  },
  {
    "poem_id": 1848,
    "vorder": 137,
    "position": 0,
    "text": "که بگریخت شاهی چوخسرو زگاه"
  },
  {
    "poem_id": 1848,
    "vorder": 138,
    "position": 1,
    "text": "سوی دشمنان شد ز دست سپاه"
  },
  {
    "poem_id": 1848,
    "vorder": 139,
    "position": 0,
    "text": "بگفت این و بنشست گریان بدرد"
  },
  {
    "poem_id": 1848,
    "vorder": 140,
    "position": 1,
    "text": "ز گفتار او گشت بهرام زرد"
  },
  {
    "poem_id": 1848,
    "vorder": 141,
    "position": 0,
    "text": "جهاندیده سنباد برپای جست"
  },
  {
    "poem_id": 1848,
    "vorder": 142,
    "position": 1,
    "text": "میان بسته وتیغ هندی بدست"
  },
  {
    "poem_id": 1848,
    "vorder": 143,
    "position": 0,
    "text": "چنین گفت کاین نامور پهلوان"
  },
  {
    "poem_id": 1848,
    "vorder": 144,
    "position": 1,
    "text": "بزرگست و با داد و روشن روان"
  },
  {
    "poem_id": 1848,
    "vorder": 145,
    "position": 0,
    "text": "کنون تاکسی از نژادکیان"
  },
  {
    "poem_id": 1848,
    "vorder": 146,
    "position": 1,
    "text": "بیاید ببندد کمر بر میان"
  },
  {
    "poem_id": 1848,
    "vorder": 147,
    "position": 0,
    "text": "هم آن به که این برنشیند بتخت"
  },
  {
    "poem_id": 1848,
    "vorder": 148,
    "position": 1,
    "text": "که گردست و جنگاور و نیک بخت"
  },
  {
    "poem_id": 1848,
    "vorder": 149,
    "position": 0,
    "text": "سرجنگیان کاین سخنها شنید"
  },
  {
    "poem_id": 1848,
    "vorder": 150,
    "position": 1,
    "text": "بزد دست و تیغ از میان برکشید"
  },
  {
    "poem_id": 1848,
    "vorder": 151,
    "position": 0,
    "text": "چنین گفت کز تخم شاهان زنی"
  },
  {
    "poem_id": 1848,
    "vorder": 152,
    "position": 1,
    "text": "اگر باز یابیم در بر زنی"
  },
  {
    "poem_id": 1848,
    "vorder": 153,
    "position": 0,
    "text": "ببرم سرش را بشمشیر تیز"
  },
  {
    "poem_id": 1848,
    "vorder": 154,
    "position": 1,
    "text": "زجانش برآرم دم رستخیز"
  },
  {
    "poem_id": 1848,
    "vorder": 155,
    "position": 0,
    "text": "نمانم که کس تاجداری کند"
  },
  {
    "poem_id": 1848,
    "vorder": 156,
    "position": 1,
    "text": "میان سواران سورای کند"
  },
  {
    "poem_id": 1848,
    "vorder": 157,
    "position": 0,
    "text": "چوبشنید بابوی گرد ارمنی"
  },
  {
    "poem_id": 1848,
    "vorder": 158,
    "position": 1,
    "text": "که سالار ناپاک کرد آن منی"
  },
  {
    "poem_id": 1848,
    "vorder": 159,
    "position": 0,
    "text": "کشیدند شمشیر و برخاستند"
  },
  {
    "poem_id": 1848,
    "vorder": 160,
    "position": 1,
    "text": "یکی نو سخن دیگر آراستند"
  },
  {
    "poem_id": 1848,
    "vorder": 161,
    "position": 0,
    "text": "که بهرام شاهست و ماکهتریم"
  },
  {
    "poem_id": 1848,
    "vorder": 162,
    "position": 1,
    "text": "سر دشمنان را بپی بسپریم"
  },
  {
    "poem_id": 1848,
    "vorder": 163,
    "position": 0,
    "text": "کشیده چو بهرام شمشیر دید"
  },
  {
    "poem_id": 1848,
    "vorder": 164,
    "position": 1,
    "text": "خردمندی و راستی برگزید"
  },
  {
    "poem_id": 1848,
    "vorder": 165,
    "position": 0,
    "text": "چنین گفت کانکو ز جای نشست"
  },
  {
    "poem_id": 1848,
    "vorder": 166,
    "position": 1,
    "text": "برآید بیازد به شمشیر دست"
  },
  {
    "poem_id": 1848,
    "vorder": 167,
    "position": 0,
    "text": "ببرم هم اندر زمان دست اوی"
  },
  {
    "poem_id": 1848,
    "vorder": 168,
    "position": 1,
    "text": "هشیوار گردد سر مست اوی"
  },
  {
    "poem_id": 1848,
    "vorder": 169,
    "position": 0,
    "text": "بگفت این و از پیش آزادگان"
  },
  {
    "poem_id": 1848,
    "vorder": 170,
    "position": 1,
    "text": "بیامد سوی گلشن شادگان"
  },
  {
    "poem_id": 1848,
    "vorder": 171,
    "position": 0,
    "text": "پراگنده گشت آن بزرگ انجمن"
  },
  {
    "poem_id": 1848,
    "vorder": 172,
    "position": 1,
    "text": "همه رخ پر آژنگ و دل پرشکن"
  }
]