[
  {
    "poem_id": 1684,
    "vorder": 1,
    "position": 0,
    "text": "چو آمد سکندر به اسکندری"
  },
  {
    "poem_id": 1684,
    "vorder": 2,
    "position": 1,
    "text": "جهان را دگرگونه شد داوری"
  },
  {
    "poem_id": 1684,
    "vorder": 3,
    "position": 0,
    "text": "به هامون نهادند صندوق اوی"
  },
  {
    "poem_id": 1684,
    "vorder": 4,
    "position": 1,
    "text": "زمین شد سراسر پر از گفت‌وگوی"
  },
  {
    "poem_id": 1684,
    "vorder": 5,
    "position": 0,
    "text": "به اسکندری کودک و مرد و زن"
  },
  {
    "poem_id": 1684,
    "vorder": 6,
    "position": 1,
    "text": "به تابوت او بر شدند انجمن"
  },
  {
    "poem_id": 1684,
    "vorder": 7,
    "position": 0,
    "text": "اگر برگرفتی ز مردم شمار"
  },
  {
    "poem_id": 1684,
    "vorder": 8,
    "position": 1,
    "text": "مهندس فزون آمدی صد هزار"
  },
  {
    "poem_id": 1684,
    "vorder": 9,
    "position": 0,
    "text": "حکیم ارسطالیس پیش اندرون"
  },
  {
    "poem_id": 1684,
    "vorder": 10,
    "position": 1,
    "text": "جهانی برو دیدگان پر ز خون"
  },
  {
    "poem_id": 1684,
    "vorder": 11,
    "position": 0,
    "text": "برآن تنگ صندوق بنهاد دست"
  },
  {
    "poem_id": 1684,
    "vorder": 12,
    "position": 1,
    "text": "چنین گفت کای شاه یزدان پرست"
  },
  {
    "poem_id": 1684,
    "vorder": 13,
    "position": 0,
    "text": "کجا آن هش و دانش و رای تو"
  },
  {
    "poem_id": 1684,
    "vorder": 14,
    "position": 1,
    "text": "که این تنگ تابوت شد جای تو"
  },
  {
    "poem_id": 1684,
    "vorder": 15,
    "position": 0,
    "text": "به روز جوانی برین مایه سال"
  },
  {
    "poem_id": 1684,
    "vorder": 16,
    "position": 1,
    "text": "چرا خاک را برگزیدی نهال"
  },
  {
    "poem_id": 1684,
    "vorder": 17,
    "position": 0,
    "text": "حکیمان رومی شدند انجمن"
  },
  {
    "poem_id": 1684,
    "vorder": 18,
    "position": 1,
    "text": "یکی گفت کای پیل رویینه تن"
  },
  {
    "poem_id": 1684,
    "vorder": 19,
    "position": 0,
    "text": "ز پایت که افگند و جانت که خست"
  },
  {
    "poem_id": 1684,
    "vorder": 20,
    "position": 1,
    "text": "کجا آن همه حزم و رای و نشست"
  },
  {
    "poem_id": 1684,
    "vorder": 21,
    "position": 0,
    "text": "دگر گفت چندین نهفتی تو زر"
  },
  {
    "poem_id": 1684,
    "vorder": 22,
    "position": 1,
    "text": "کنون زر دارد تنت را به بر"
  },
  {
    "poem_id": 1684,
    "vorder": 23,
    "position": 0,
    "text": "دگر گفت کز دست تو کس نرست"
  },
  {
    "poem_id": 1684,
    "vorder": 24,
    "position": 1,
    "text": "چرا سودی ای شاه با مرگ دست"
  },
  {
    "poem_id": 1684,
    "vorder": 25,
    "position": 0,
    "text": "دگر گفت کسودی از درد و رنج"
  },
  {
    "poem_id": 1684,
    "vorder": 26,
    "position": 1,
    "text": "هم از جستن پادشاهی و گنج"
  },
  {
    "poem_id": 1684,
    "vorder": 27,
    "position": 0,
    "text": "دگر گفت چون پیش داور شوی"
  },
  {
    "poem_id": 1684,
    "vorder": 28,
    "position": 1,
    "text": "همان بر که کشتی همان بدروی"
  },
  {
    "poem_id": 1684,
    "vorder": 29,
    "position": 0,
    "text": "دگر گفت بی‌دستگاه آن بود"
  },
  {
    "poem_id": 1684,
    "vorder": 30,
    "position": 1,
    "text": "که ریزندهٔ خون شاهان بود"
  },
  {
    "poem_id": 1684,
    "vorder": 31,
    "position": 0,
    "text": "دگر گفت ما چون تو باشیم زود"
  },
  {
    "poem_id": 1684,
    "vorder": 32,
    "position": 1,
    "text": "که بودی تو چون گوهر نابسود"
  },
  {
    "poem_id": 1684,
    "vorder": 33,
    "position": 0,
    "text": "دگر گفت چون بیندت اوستاد"
  },
  {
    "poem_id": 1684,
    "vorder": 34,
    "position": 1,
    "text": "بیاموزد آن چیز کت نیست یاد"
  },
  {
    "poem_id": 1684,
    "vorder": 35,
    "position": 0,
    "text": "دگر گفت کز مرگ چون تو نرست"
  },
  {
    "poem_id": 1684,
    "vorder": 36,
    "position": 1,
    "text": "به بیشی سزد گر نیازیم دست"
  },
  {
    "poem_id": 1684,
    "vorder": 37,
    "position": 0,
    "text": "دگر گفت کای برتر از ماه و مهر"
  },
  {
    "poem_id": 1684,
    "vorder": 38,
    "position": 1,
    "text": "چه پوشی همی ز انجمن خوب چهر"
  },
  {
    "poem_id": 1684,
    "vorder": 39,
    "position": 0,
    "text": "دگر گفت مرد فراوان هنر"
  },
  {
    "poem_id": 1684,
    "vorder": 40,
    "position": 1,
    "text": "بکوشد که چهره بپوشد به زر"
  },
  {
    "poem_id": 1684,
    "vorder": 41,
    "position": 0,
    "text": "کنون ای هنرمند مرد دلیر"
  },
  {
    "poem_id": 1684,
    "vorder": 42,
    "position": 1,
    "text": "ترا زر زرد آوریدست زیر"
  },
  {
    "poem_id": 1684,
    "vorder": 43,
    "position": 0,
    "text": "دگرگفت دیبا بپوشیده‌ای"
  },
  {
    "poem_id": 1684,
    "vorder": 44,
    "position": 1,
    "text": "نپوشیده را نیز رخ دیده‌ای"
  },
  {
    "poem_id": 1684,
    "vorder": 45,
    "position": 0,
    "text": "کنون سر ز دیبا برآور که تاج"
  },
  {
    "poem_id": 1684,
    "vorder": 46,
    "position": 1,
    "text": "همی جویدت یاره و تخت عاج"
  },
  {
    "poem_id": 1684,
    "vorder": 47,
    "position": 0,
    "text": "دگر گفت کز ماه‌رخ بندگان"
  },
  {
    "poem_id": 1684,
    "vorder": 48,
    "position": 1,
    "text": "ز چینی و رومی پرستندگان"
  },
  {
    "poem_id": 1684,
    "vorder": 49,
    "position": 0,
    "text": "بریدی و زر داری اندر کنار"
  },
  {
    "poem_id": 1684,
    "vorder": 50,
    "position": 1,
    "text": "به رسم کیان زر و دیبا مدار"
  },
  {
    "poem_id": 1684,
    "vorder": 51,
    "position": 0,
    "text": "دگر گفت پرسنده پرسد کنون"
  },
  {
    "poem_id": 1684,
    "vorder": 52,
    "position": 1,
    "text": "چه یاد آیدت پاسخ رهنمون"
  },
  {
    "poem_id": 1684,
    "vorder": 53,
    "position": 0,
    "text": "که خون بزرگان چرا ریختی"
  },
  {
    "poem_id": 1684,
    "vorder": 54,
    "position": 1,
    "text": "به سختی به گنج اندر آویختی"
  },
  {
    "poem_id": 1684,
    "vorder": 55,
    "position": 0,
    "text": "خنک آنکسی کز بزرگان بمرد"
  },
  {
    "poem_id": 1684,
    "vorder": 56,
    "position": 1,
    "text": "ز گیتی جز از نیک‌نامی نبرد"
  },
  {
    "poem_id": 1684,
    "vorder": 57,
    "position": 0,
    "text": "دگر گفت روز تو اندرگذشت"
  },
  {
    "poem_id": 1684,
    "vorder": 58,
    "position": 1,
    "text": "زبانت ز گفتار بیکار گشت"
  },
  {
    "poem_id": 1684,
    "vorder": 59,
    "position": 0,
    "text": "هرانکس که او تاج و تخت تو دید"
  },
  {
    "poem_id": 1684,
    "vorder": 60,
    "position": 1,
    "text": "عنان از بزرگی بباید کشید"
  },
  {
    "poem_id": 1684,
    "vorder": 61,
    "position": 0,
    "text": "که بر کس نماند چو بر تو نماند"
  },
  {
    "poem_id": 1684,
    "vorder": 62,
    "position": 1,
    "text": "درخت بزرگی چه باید نشاید"
  },
  {
    "poem_id": 1684,
    "vorder": 63,
    "position": 0,
    "text": "دگر گفت کردار تو بادگشت"
  },
  {
    "poem_id": 1684,
    "vorder": 64,
    "position": 1,
    "text": "سر سرکشان از تو آزاد گشت"
  },
  {
    "poem_id": 1684,
    "vorder": 65,
    "position": 0,
    "text": "ببینی کنون بارگاه بزرگ"
  },
  {
    "poem_id": 1684,
    "vorder": 66,
    "position": 1,
    "text": "جهانی جدا کرده از میش گرگ"
  },
  {
    "poem_id": 1684,
    "vorder": 67,
    "position": 0,
    "text": "دگر گفت کاندر سرای سپنج"
  },
  {
    "poem_id": 1684,
    "vorder": 68,
    "position": 1,
    "text": "چرا داشتی خویشتن را به رنج"
  },
  {
    "poem_id": 1684,
    "vorder": 69,
    "position": 0,
    "text": "که بهر تو این آمد از رنج تو"
  },
  {
    "poem_id": 1684,
    "vorder": 70,
    "position": 1,
    "text": "یکی تنگ تابوت شد گنج تو"
  },
  {
    "poem_id": 1684,
    "vorder": 71,
    "position": 0,
    "text": "نجویی همی نالهٔ بوق را"
  },
  {
    "poem_id": 1684,
    "vorder": 72,
    "position": 1,
    "text": "به سند آمدت بند صندوق را"
  },
  {
    "poem_id": 1684,
    "vorder": 73,
    "position": 0,
    "text": "دگر گفت چون لشکرت بازگشت"
  },
  {
    "poem_id": 1684,
    "vorder": 74,
    "position": 1,
    "text": "تو تنها نمانی برین پهن دشت"
  },
  {
    "poem_id": 1684,
    "vorder": 75,
    "position": 0,
    "text": "همانا پس هرکسی بنگری"
  },
  {
    "poem_id": 1684,
    "vorder": 76,
    "position": 1,
    "text": "فراوان غم زندگانی خوری"
  }
]